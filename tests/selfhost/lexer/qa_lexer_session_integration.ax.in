@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic fn wrapping_add_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn rotate_left_u64(x: u64, n: u32) -> u64 { 0 }

fn test_bytes_eq(a: *const u8, b: *const u8, len: usize) -> bool {
    let mut i: usize = 0;
    while i < len {
        let ba: u8 = unsafe { *(a + i) };
        let bb: u8 = unsafe { *(b + i) };
        if ba != bb { return false; }
        i = i + 1;
    }
    true
}

const SESS_BLOB_DATA: [214]u8 = [109u8, 111u8, 100u8, 95u8, 97u8, 46u8, 97u8, 120u8, 47u8, 47u8, 32u8, 102u8, 105u8, 108u8, 101u8, 32u8, 65u8, 10u8, 112u8, 117u8, 98u8, 32u8, 102u8, 110u8, 32u8, 97u8, 108u8, 112u8, 104u8, 97u8, 40u8, 115u8, 104u8, 97u8, 114u8, 101u8, 100u8, 95u8, 110u8, 97u8, 109u8, 101u8, 58u8, 32u8, 117u8, 54u8, 52u8, 41u8, 32u8, 45u8, 62u8, 32u8, 117u8, 54u8, 52u8, 32u8, 123u8, 10u8, 32u8, 32u8, 32u8, 32u8, 115u8, 104u8, 97u8, 114u8, 101u8, 100u8, 95u8, 110u8, 97u8, 109u8, 101u8, 32u8, 43u8, 32u8, 48u8, 120u8, 50u8, 95u8, 65u8, 117u8, 54u8, 52u8, 10u8, 125u8, 10u8, 109u8, 111u8, 100u8, 95u8, 98u8, 46u8, 97u8, 120u8, 47u8, 47u8, 47u8, 32u8, 100u8, 111u8, 99u8, 32u8, 66u8, 10u8, 112u8, 117u8, 98u8, 32u8, 102u8, 110u8, 32u8, 98u8, 101u8, 116u8, 97u8, 40u8, 115u8, 104u8, 97u8, 114u8, 101u8, 100u8, 95u8, 110u8, 97u8, 109u8, 101u8, 58u8, 32u8, 117u8, 54u8, 52u8, 41u8, 32u8, 45u8, 62u8, 32u8, 117u8, 54u8, 52u8, 32u8, 123u8, 10u8, 32u8, 32u8, 32u8, 32u8, 115u8, 104u8, 97u8, 114u8, 101u8, 100u8, 95u8, 110u8, 97u8, 109u8, 101u8, 32u8, 42u8, 32u8, 49u8, 48u8, 117u8, 54u8, 52u8, 10u8, 125u8, 10u8, 98u8, 97u8, 100u8, 46u8, 97u8, 120u8, 108u8, 101u8, 116u8, 32u8, 120u8, 32u8, 61u8, 32u8, 97u8, 58u8, 58u8, 98u8, 59u8, 10u8, 108u8, 101u8, 116u8, 32u8, 121u8, 32u8, 58u8, 61u8, 32u8, 49u8, 48u8, 59u8, 10u8, 115u8, 104u8, 97u8, 114u8, 101u8, 100u8, 95u8, 110u8, 97u8, 109u8, 101u8];
const SESS_BLOB_OFF: [8]u16 = [0u16, 8u16, 87u16, 95u16, 170u16, 176u16, 203u16, 214u16];

fn get_sess_sv(a: mut_view<Arena>, idx: usize) -> StrView {
    let start = SESS_BLOB_OFF[idx] as usize;
    let end = SESS_BLOB_OFF[idx + 1] as usize;
    let n = end - start;
    let dst = arena_alloc_raw(a, n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = SESS_BLOB_DATA[start + i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn qa_sv_eq(a: StrView, b: StrView) -> bool {
    if a.len != b.len { return false; }
    test_bytes_eq(a.ptr, b.ptr, a.len)
}

pub fn main() -> i32 {
    let mut scratch = arena_new();
    let mut sess = session_new();
    session_init(mut_view(sess));

    let mut res_a = LexResult {
        arena: arena_new(),
        tokens: 0 as *mut Token,
        token_count: 0,
        token_cap: 0,
        comments: 0 as *mut Comment,
        comment_count: 0,
        comment_cap: 0,
    };
    let mut res_b = LexResult {
        arena: arena_new(),
        tokens: 0 as *mut Token,
        token_count: 0,
        token_cap: 0,
        comments: 0 as *mut Comment,
        comment_count: 0,
        comment_cap: 0,
    };

    let fid_a = session_lex_virtual_file(mut_view(sess), get_sess_sv(mut_view(scratch), 0), get_sess_sv(mut_view(scratch), 1), mut_view(res_a));
    let fid_b = session_lex_virtual_file(mut_view(sess), get_sess_sv(mut_view(scratch), 2), get_sess_sv(mut_view(scratch), 3), mut_view(res_b));

    if fid_a.v != 1u32 || fid_b.v != 2u32 { return 1; }
    if session_error_count(view(sess)) != 0 { return 2; }
    if res_a.comment_count != 1 || lex_comment_get(view(res_a), 0).kind != COMMENT_LINE { return 3; }
    if res_b.comment_count != 1 || lex_comment_get(view(res_b), 0).kind != COMMENT_DOC { return 4; }

    // Token index 4 in both files is 'shared_name' parameter identifier; verify interned StrId is identical across files!
    let tok_a_param = lex_token_get(view(res_a), 4);
    let tok_b_param = lex_token_get(view(res_b), 4);
    if tok_a_param.kind != TOK_IDENT || tok_b_param.kind != TOK_IDENT { return 5; }
    if tok_a_param.ident_val.v != tok_b_param.ident_val.v { return 6; }
    let param_sid = StrId { v: tok_a_param.ident_val.v };
    let actual_name = session_get_str(view(sess), param_sid);
    let expected_name = get_sess_sv(mut_view(scratch), 6);
    if !qa_sv_eq(actual_name, expected_name) { return 7; }

    // Verify line/col resolution on token spans via CompilerSession
    let param_sp = Span { file: FileId { v: tok_a_param.span.file.v }, start: tok_a_param.span.start, end: tok_a_param.span.end };
    let lc_a = session_line_col(view(sess), param_sp);
    if lc_a.line != 2u32 || lc_a.col_chars != 14u32 { return 8; }

    let mut tok_buf_a = session_render_tokens(view(sess), view(res_a));
    if tok_buf_a.len == 0 { return 9; }
    diag_buf_free(mut_view(tok_buf_a));

    ax_lex_result_free(mut_view(res_a));
    ax_lex_result_free(mut_view(res_b));

    // Verify JSON diagnostic rendering for lexer errors with MachineApplicable fixes (:: and :=)
    let mut sess_err = session_new();
    session_init(mut_view(sess_err));
    let mut bad_toks = diag_buf_new();
    let mut bad_json = diag_buf_new();
    let err_cnt = session_lex_and_render_json(mut_view(sess_err), get_sess_sv(mut_view(scratch), 4), get_sess_sv(mut_view(scratch), 5), mut_view(bad_toks), mut_view(bad_json));
    if err_cnt != 2 { return 10; }
    if bad_json.len == 0 || bad_toks.len == 0 { return 11; }

    diag_buf_free(mut_view(bad_toks));
    diag_buf_free(mut_view(bad_json));
    session_free(mut_view(sess_err));
    session_free(mut_view(sess));
    arena_destroy(mut_view(scratch));

    print("OK Lexer Session Integration\n");
    0
}
