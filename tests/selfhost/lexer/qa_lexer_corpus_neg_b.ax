use compiler.source.manager.source_db_file_count
use compiler.source.manager.source_db_text
use compiler.source.manager.source_db_path
use compiler.source.manager.source_db_hash
use compiler.source.manager.source_db_has_invalid_utf8
use compiler.source.manager.source_db_span_text
use compiler.source.manager.source_db_line_col
use compiler.source.manager.source_db_line_range
use compiler.diag.code.DiagCode
use compiler.diag.emitter.Diagnostic
