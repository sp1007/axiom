fn copy_fid(fid: view<FileId>) -> FileId { FileId { v: fid.v } }
fn copy_span(s: view<Span>) -> Span { Span { file: copy_fid(view(s.file)), start: s.start, end: s.end } }
fn copy_sv(sv: view<StrView>) -> StrView { StrView { ptr: sv.ptr, len: sv.len } }

fn hex_digit(v: u8) -> u8 {
    if v < 10u8 {
        v + 48u8
    } else {
        v - 10u8 + 97u8
    }
}

