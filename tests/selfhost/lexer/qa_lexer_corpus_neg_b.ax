, 88u8, 95u8, 76u8, 69u8, 88u8, 95u8, 85u8, 78u8, 84u8, 69u8, 82u8, 77u8, 73u8, 78u8, 65u8, 84u8, 69u8, 68u8, 95u8, 67u8, 72u8, 65u8, 82u8, 10u8, 32u8, 32u8, 124u8, 32u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 94u8, 10u8, 32u8, 32u8, 124u8, 32u8, 10u8, 10u8, 49u8, 32u8, 101u8, 114u8, 114u8, 111u8, 114u8, 44u8, 32u8, 48u8, 32u8, 119u8, 97u8, 114u8, 110u8, 105u8, 110u8, 103u8, 115u8, 10u8];
const CORPUS_OFF: [45]u32 = [0u32, 36u32, 92u32, 207u32, 388u32, 423u32, 485u32, 625u32, 844u32, 877u32, 930u32, 1011u32, 1194u32, 1222u32, 1289u32, 1370u32, 1578u32, 1616u32, 1668u32, 1749u32, 2100u32, 2131u32, 2190u32, 2273u32, 2459u32, 2496u32, 2587u32, 2689u32, 3044u32, 3078u32, 3139u32, 3222u32, 3413u32, 3446u32, 3507u32, 3595u32, 3768u32, 3802u32, 3855u32, 3935u32, 4114u32, 4151u32, 4206u32, 4262u32, 4511u32];

fn get_corpus_sv(a: mut_view<Arena>, c_data: view<[4511]u8>, c_off: view<[45]u32>, blob_idx: usize) -> StrView {
    let start = (*c_off)[blob_idx] as usize;
    let end = (*c_off)[blob_idx + 1] as usize;
    let n = end - start;
    let dst = arena_alloc_raw(a, n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = (*c_data)[start + i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn qa_sv_eq(a: StrView, b: StrView) -> bool {
    if a.len != b.len { return false; }
    test_bytes_eq(a.ptr, b.ptr, a.len)
}

fn verify_corpus_case(scratch: mut_view<Arena>, c_data: view<[4511]u8>, c_off: view<[45]u32>, case_idx: usize, expect_err: bool) -> bool {
    let base = case_idx * 4;
    let path_sv = get_corpus_sv(mut_view(*scratch), c_data, c_off, base);
    let src_sv = get_corpus_sv(mut_view(*scratch), c_data, c_off, base + 1);
    let exp_tok_sv = get_corpus_sv(mut_view(*scratch), c_data, c_off, base + 2);
    let exp_err_sv = get_corpus_sv(mut_view(*scratch), c_data, c_off, base + 3);

    let mut sess = session_new();
    session_init(mut_view(sess));
    let mut tok_buf = diag_buf_new();
    let mut diag_buf = diag_buf_new();
    let errs = session_lex_and_render_human(mut_view(sess), path_sv, src_sv, mut_view(tok_buf), mut_view(diag_buf));

    let mut ok = true;
    if expect_err {
        if errs == 0 { ok = false; }
        if !qa_sv_eq(diag_buf_as_str_view(view(diag_buf)), exp_err_sv) { ok = false; }
    } else {
        if errs != 0 { ok = false; }
    }
    if !qa_sv_eq(diag_buf_as_str_view(view(tok_buf)), exp_tok_sv) {
        ok = false;
    }

    diag_buf_free(mut_view(tok_buf));
    diag_buf_free(mut_view(diag_buf));
    session_free(mut_view(sess));
    ok
}

pub fn main() -> i32 {
    let mut scratch = arena_new();
    let c_data = CORPUS_DATA;
    let c_off = CORPUS_OFF;
    if !verify_corpus_case(mut_view(scratch), view(c_data), view(c_off), 0, true) { return 10; }
    if !verify_corpus_case(mut_view(scratch), view(c_data), view(c_off), 1, true) { return 11; }
    if !verify_corpus_case(mut_view(scratch), view(c_data), view(c_off), 2, true) { return 12; }
    if !verify_corpus_case(mut_view(scratch), view(c_data), view(c_off), 3, true) { return 13; }
    if !verify_corpus_case(mut_view(scratch), view(c_data), view(c_off), 4, true) { return 14; }
    if !verify_corpus_case(mut_view(scratch), view(c_data), view(c_off), 5, true) { return 15; }
    if !verify_corpus_case(mut_view(scratch), view(c_data), view(c_off), 6, true) { return 16; }
    if !verify_corpus_case(mut_view(scratch), view(c_data), view(c_off), 7, true) { return 17; }
    if !verify_corpus_case(mut_view(scratch), view(c_data), view(c_off), 8, true) { return 18; }
    if !verify_corpus_case(mut_view(scratch), view(c_data), view(c_off), 9, true) { return 19; }
    if !verify_corpus_case(mut_view(scratch), view(c_data), view(c_off), 10, true) { return 20; }
    arena_destroy(mut_view(scratch));
    print("OK Lexer Corpus Neg B (11 files)\n");
    0
}
