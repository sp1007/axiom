const CORPUS_OFF: [33]u32 = [0u32, 22u32, 52u32, 181u32, 181u32, 209u32, 230u32, 339u32, 339u32, 361u32, 385u32, 440u32, 440u32, 460u32, 484u32, 599u32, 599u32, 624u32, 653u32, 783u32, 783u32, 810u32, 835u32, 924u32, 924u32, 946u32, 974u32, 1062u32, 1062u32, 1091u32, 1111u32, 1176u32, 1176u32];

fn get_corpus_sv(a: mut_view<Arena>, c_data: view<[1176]u8>, c_off: view<[33]u32>, blob_idx: usize) -> StrView {
    let start = (*c_off)[blob_idx] as usize;
    let end = (*c_off)[blob_idx + 1] as usize;
    let n = end - start;
    let dst = arena_alloc_raw(a, n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = (*c_data)[start + i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn qa_sv_eq(a: StrView, b: StrView) -> bool {
    if a.len != b.len { return false; }
    test_bytes_eq(a.ptr, b.ptr, a.len)
}

fn verify_corpus_case(scratch: mut_view<Arena>, c_data: view<[1176]u8>, c_off: view<[33]u32>, case_idx: usize, expect_err: bool) -> bool {
    let base = case_idx * 4;
    let path_sv = get_corpus_sv(mut_view(*scratch), c_data, c_off, base);
    let src_sv = get_corpus_sv(mut_view(*scratch), c_data, c_off, base + 1);
    let exp_tok_sv = get_corpus_sv(mut_view(*scratch), c_data, c_off, base + 2);
    let exp_err_sv = get_corpus_sv(mut_view(*scratch), c_data, c_off, base + 3);

    let mut sess = session_new();
    session_init(mut_view(sess));
    let mut tok_buf = diag_buf_new();
    let mut diag_buf = diag_buf_new();
    let errs = session_lex_and_render_human(mut_view(sess), path_sv, src_sv, mut_view(tok_buf), mut_view(diag_buf));

    let mut ok = true;
    if expect_err {
        if errs == 0 { ok = false; }
        if !qa_sv_eq(diag_buf_as_str_view(view(diag_buf)), exp_err_sv) { ok = false; }
    } else {
        if errs != 0 { ok = false; }
    }
    if !qa_sv_eq(diag_buf_as_str_view(view(tok_buf)), exp_tok_sv) {
        ok = false;
    }

    diag_buf_free(mut_view(tok_buf));
    diag_buf_free(mut_view(diag_buf));
    session_free(mut_view(sess));
    ok
}

pub fn main() -> i32 {
    let mut scratch = arena_new();
    let c_data = CORPUS_DATA;
    let c_off = CORPUS_OFF;
    if !verify_corpus_case(mut_view(scratch), view(c_data), view(c_off), 0, false) { return 10; }
    if !verify_corpus_case(mut_view(scratch), view(c_data), view(c_off), 1, false) { return 11; }
    if !verify_corpus_case(mut_view(scratch), view(c_data), view(c_off), 2, false) { return 12; }
    if !verify_corpus_case(mut_view(scratch), view(c_data), view(c_off), 3, false) { return 13; }
    if !verify_corpus_case(mut_view(scratch), view(c_data), view(c_off), 4, false) { return 14; }
    if !verify_corpus_case(mut_view(scratch), view(c_data), view(c_off), 5, false) { return 15; }
    if !verify_corpus_case(mut_view(scratch), view(c_data), view(c_off), 6, false) { return 16; }
    if !verify_corpus_case(mut_view(scratch), view(c_data), view(c_off), 7, false) { return 17; }
    arena_destroy(mut_view(scratch));
    print("OK Lexer Corpus Pos A (8 files)\n");
    0
}
