// test: run
// stdout: OK Kernel Interner\n

module main

use host_intrinsics.heap_alloc
use host_intrinsics.heap_free
use host_intrinsics.exit
use compiler.kernel.interner.StrInterner
use compiler.kernel.interner.StrView
use compiler.kernel.interner.U32Interner
use compiler.kernel.arena.arena_alloc_raw
use compiler.kernel.arena.arena_destroy
use compiler.kernel.arena.arena_new
use compiler.kernel.interner.interner_free
use compiler.kernel.interner.interner_get
use compiler.kernel.interner.interner_init
use compiler.kernel.interner.interner_intern_bytes
use compiler.kernel.interner.interner_is_empty
use compiler.kernel.interner.interner_len
use compiler.kernel.interner.interner_lookup_bytes
use compiler.kernel.interner.u32_intern
use compiler.kernel.interner.u32_interner_free
use compiler.kernel.interner.u32_interner_get
use compiler.kernel.interner.u32_interner_lookup
use compiler.kernel.interner.u32_interner_new

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic fn wrapping_add_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn rotate_left_u64(x: u64, n: u32) -> u64 { 0 }

fn test_bytes_eq(a: *const u8, b: *const u8, len: usize) -> bool {
    let mut i: usize = 0;
    while i < len {
        let ba: u8 = unsafe { *(a + i) };
        let bb: u8 = unsafe { *(b + i) };
        if ba != bb { return false; }
        i = i + 1;
    }
    true
}

fn main() -> i32 {
    let mut in_ = StrInterner {
        bytes: arena_new(),
        strings: 0 as *mut StrView,
        len: 0,
        cap: 0,
        map_hashes: 0 as *mut u64,
        map_ids: 0 as *mut u32,
        map_cap: 0,
    };
    interner_init(mut_view(in_));
    if !interner_is_empty(view(in_)) { return 1; }
    if interner_len(view(in_)) != 0 { return 2; }

    let mut scratch = arena_new();
    let p_foo = arena_alloc_raw(mut_view(scratch), 8, 1);
    let p_bar = arena_alloc_raw(mut_view(scratch), 8, 1);
    let p_baz = arena_alloc_raw(mut_view(scratch), 8, 1);
    unsafe {
        *p_foo = 102u8; *(p_foo + 1) = 111u8; *(p_foo + 2) = 111u8; // "foo"
        *p_bar = 98u8;  *(p_bar + 1) = 97u8;  *(p_bar + 2) = 114u8; // "bar"
        *p_baz = 98u8;  *(p_baz + 1) = 97u8;  *(p_baz + 2) = 122u8; // "baz"
    }

    let id_foo = interner_intern_bytes(mut_view(in_), p_foo as *const u8, 3);
    let id_bar = interner_intern_bytes(mut_view(in_), p_bar as *const u8, 3);

    if id_foo.v != 1 { return 3; }
    if id_bar.v != 2 { return 4; }
    if interner_len(view(in_)) != 2 { return 5; }

    // Deduplication check
    let id_foo2 = interner_intern_bytes(mut_view(in_), p_foo as *const u8, 3);
    if !id_foo2.eq(view(id_foo)) { return 6; }
    if interner_len(view(in_)) != 2 { return 7; }

    // Lookup
    let l_foo = interner_lookup_bytes(view(in_), p_foo as *const u8, 3);
    if !l_foo.eq(view(id_foo)) { return 8; }

    let l_baz = interner_lookup_bytes(view(in_), p_baz as *const u8, 3);
    if !l_baz.is_none() { return 9; }

    // Get
    let sv_foo = interner_get(view(in_), id_foo);
    if sv_foo.len != 3 { return 10; }
    if !test_bytes_eq(sv_foo.ptr, p_foo as *const u8, 3) { return 11; }

    // Test U32Interner
    let mut u32_in = u32_interner_new();
    let u_id1 = u32_intern(mut_view(u32_in), 12345u32);
    let u_id2 = u32_intern(mut_view(u32_in), 67890u32);
    let u_id1_dup = u32_intern(mut_view(u32_in), 12345u32);

    if u_id1 != 1 { return 12; }
    if u_id2 != 2 { return 13; }
    if u_id1_dup != u_id1 { return 14; }
    if u32_interner_lookup(view(u32_in), 12345u32) != 1 { return 15; }
    if u32_interner_lookup(view(u32_in), 99999u32) != 0 { return 16; }
    if u32_interner_get(view(u32_in), u_id1) != 12345u32 { return 17; }
    if u32_interner_get(view(u32_in), u_id2) != 67890u32 { return 18; }

    u32_interner_free(mut_view(u32_in));
    interner_free(mut_view(in_));
    arena_destroy(mut_view(scratch));

    print("OK Kernel Interner\n");
    0
}
