// test: run
// timeout: 120
// modes: native
// stdout: OK Kernel Interner\n

module main

use host_intrinsics.heap_alloc
use host_intrinsics.heap_free
use host_intrinsics.exit
use compiler.kernel.interner.StrInterner
use compiler.kernel.interner.StrView
use compiler.kernel.interner.U32Interner
use compiler.kernel.arena.arena_alloc_raw
use compiler.kernel.arena.arena_destroy
use compiler.kernel.arena.arena_new
use compiler.kernel.interner.interner_free
use compiler.kernel.interner.interner_get
use compiler.kernel.interner.interner_init
use compiler.kernel.interner.interner_intern_bytes
use compiler.kernel.interner.interner_is_empty
use compiler.kernel.interner.interner_len
use compiler.kernel.interner.interner_lookup_bytes
use compiler.kernel.interner.u32_intern
use compiler.kernel.interner.u32_interner_free
use compiler.kernel.interner.u32_interner_get
use compiler.kernel.interner.u32_interner_lookup
use compiler.kernel.interner.u32_interner_new

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic fn wrapping_add_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn rotate_left_u64(x: u64, n: u32) -> u64 { 0 }

fn test_bytes_eq(a: *const u8, b: *const u8, len: usize) -> bool {
    let mut i: usize = 0;
    while i < len {
        let ba: u8 = unsafe { *(a + i) };
        let bb: u8 = unsafe { *(b + i) };
        if ba != bb { return false; }
        i = i + 1;
    }
    true
}

// Writes `n` as 8 zero-padded decimal digits into `buf`.
fn fill_digits(buf: *mut u8, n: usize) {
    let mut v: usize = n;
    let mut k: usize = 8;
    while k > 0 {
        k = k - 1;
        unsafe {
            *(buf + k) = (48 + (v % 10)) as u8;
        }
        v = v / 10;
    }
}

// T544 regression: growing the string table past 65,536 strings (the old shim allocated a fixed
// 1 MiB block whatever the capacity) and several doublings of the hash map, with a second pass that
// finds every string again by bytes and by id. Returns 0 on success, a distinct code otherwise.
fn test_many_strings() -> i32 {
    let count: usize = 70000;
    let mut big = StrInterner {
        bytes: arena_new(),
        strings: 0 as *mut StrView,
        len: 0,
        cap: 0,
        map_hashes: 0 as *mut u64,
        map_ids: 0 as *mut u32,
        map_cap: 0,
    };
    interner_init(mut_view(big));
    let buf: *mut u8 = unsafe { heap_alloc(8, 1) };

    let mut i: usize = 0;
    while i < count {
        fill_digits(buf, i);
        let id = interner_intern_bytes(mut_view(big), buf as *const u8, 8);
        if (id.v as usize) != i + 1 { return 30; }
        i = i + 1;
    }
    if interner_len(view(big)) != count { return 31; }

    i = 0;
    while i < count {
        fill_digits(buf, i);
        let found = interner_lookup_bytes(view(big), buf as *const u8, 8);
        if (found.v as usize) != i + 1 { return 32; }
        let again = interner_intern_bytes(mut_view(big), buf as *const u8, 8);
        if again.v != found.v { return 33; }
        let sv = interner_get(view(big), found);
        if sv.len != 8 { return 34; }
        if !test_bytes_eq(sv.ptr, buf as *const u8, 8) { return 35; }
        i = i + 1;
    }
    if interner_len(view(big)) != count { return 36; }

    // A string that was never interned is still absent.
    unsafe {
        *buf = 120u8;
    }
    let missing = interner_lookup_bytes(view(big), buf as *const u8, 8);
    if !missing.is_none() { return 37; }

    unsafe {
        heap_free(buf, 8, 1);
    }
    interner_free(mut_view(big));
    0
}

// T544 regression: U32Interner growth past several doublings of both the items table and the map.
fn test_many_u32() -> i32 {
    let count: usize = 100000;
    let mut u = u32_interner_new();
    let mut i: usize = 0;
    while i < count {
        let val: u32 = ((i * 7) + 3) as u32;
        let id = u32_intern(mut_view(u), val);
        if (id as usize) != i + 1 { return 40; }
        i = i + 1;
    }
    i = 0;
    while i < count {
        let val: u32 = ((i * 7) + 3) as u32;
        if (u32_interner_lookup(view(u), val) as usize) != i + 1 { return 41; }
        if u32_intern(mut_view(u), val) != ((i + 1) as u32) { return 42; }
        if u32_interner_get(view(u), ((i + 1) as u32)) != val { return 43; }
        i = i + 1;
    }
    if u32_interner_lookup(view(u), 4u32) != 0u32 { return 44; }
    u32_interner_free(mut_view(u));
    0
}

// QA adversarial (T544): variable-length strings (8..20 bytes) plus the empty string, interned
// across the 65,536 -> 131,072 capacity boundary (90,000 strings), then verified by id, by bytes and by content.
fn fill_varlen(buf: *mut u8, n: usize) -> usize {
    fill_digits(buf, n);
    let extra: usize = n % 13;
    let mut k: usize = 0;
    while k < extra {
        unsafe {
            *(buf + (8 + k)) = (97 + ((n + k) % 26)) as u8;
        }
        k = k + 1;
    }
    8 + extra
}

fn test_varlen_boundary() -> i32 {
    let count: usize = 90000;
    let mut vi = StrInterner {
        bytes: arena_new(),
        strings: 0 as *mut StrView,
        len: 0,
        cap: 0,
        map_hashes: 0 as *mut u64,
        map_ids: 0 as *mut u32,
        map_cap: 0,
    };
    interner_init(mut_view(vi));
    let buf: *mut u8 = unsafe { heap_alloc(32, 1) };

    // The empty string takes the first slot; every other string is shifted by one.
    let empty_id = interner_intern_bytes(mut_view(vi), buf as *const u8, 0);
    if (empty_id.v as usize) != 1 { return 50; }

    let mut i: usize = 0;
    while i < count {
        let n = fill_varlen(buf, i);
        let id = interner_intern_bytes(mut_view(vi), buf as *const u8, n);
        if (id.v as usize) != i + 2 { return 51; }
        i = i + 1;
    }
    if interner_len(view(vi)) != count + 1 { return 52; }

    i = 0;
    while i < count {
        let n = fill_varlen(buf, i);
        let found = interner_lookup_bytes(view(vi), buf as *const u8, n);
        if (found.v as usize) != i + 2 { return 53; }
        let sv = interner_get(view(vi), found);
        if sv.len != n { return 54; }
        if !test_bytes_eq(sv.ptr, buf as *const u8, n) { return 55; }
        i = i + 1;
    }
    let e = interner_lookup_bytes(view(vi), buf as *const u8, 0);
    if (e.v as usize) != 1 { return 56; }
    let esv = interner_get(view(vi), e);
    if esv.len != 0 { return 57; }

    unsafe {
        heap_free(buf, 32, 1);
    }
    interner_free(mut_view(vi));
    0
}

fn main() -> i32 {
    let mut in_ = StrInterner {
        bytes: arena_new(),
        strings: 0 as *mut StrView,
        len: 0,
        cap: 0,
        map_hashes: 0 as *mut u64,
        map_ids: 0 as *mut u32,
        map_cap: 0,
    };
    interner_init(mut_view(in_));
    if !interner_is_empty(view(in_)) { return 1; }
    if interner_len(view(in_)) != 0 { return 2; }

    let mut scratch = arena_new();
    let p_foo = arena_alloc_raw(mut_view(scratch), 8, 1);
    let p_bar = arena_alloc_raw(mut_view(scratch), 8, 1);
    let p_baz = arena_alloc_raw(mut_view(scratch), 8, 1);
    unsafe {
        *p_foo = 102u8; *(p_foo + 1) = 111u8; *(p_foo + 2) = 111u8; // "foo"
        *p_bar = 98u8;  *(p_bar + 1) = 97u8;  *(p_bar + 2) = 114u8; // "bar"
        *p_baz = 98u8;  *(p_baz + 1) = 97u8;  *(p_baz + 2) = 122u8; // "baz"
    }

    let id_foo = interner_intern_bytes(mut_view(in_), p_foo as *const u8, 3);
    let id_bar = interner_intern_bytes(mut_view(in_), p_bar as *const u8, 3);

    if id_foo.v != 1 { return 3; }
    if id_bar.v != 2 { return 4; }
    if interner_len(view(in_)) != 2 { return 5; }

    // Deduplication check
    let id_foo2 = interner_intern_bytes(mut_view(in_), p_foo as *const u8, 3);
    if !id_foo2.eq(view(id_foo)) { return 6; }
    if interner_len(view(in_)) != 2 { return 7; }

    // Lookup
    let l_foo = interner_lookup_bytes(view(in_), p_foo as *const u8, 3);
    if !l_foo.eq(view(id_foo)) { return 8; }

    let l_baz = interner_lookup_bytes(view(in_), p_baz as *const u8, 3);
    if !l_baz.is_none() { return 9; }

    // Get
    let sv_foo = interner_get(view(in_), id_foo);
    if sv_foo.len != 3 { return 10; }
    if !test_bytes_eq(sv_foo.ptr, p_foo as *const u8, 3) { return 11; }

    // Test U32Interner
    let mut u32_in = u32_interner_new();
    let u_id1 = u32_intern(mut_view(u32_in), 12345u32);
    let u_id2 = u32_intern(mut_view(u32_in), 67890u32);
    let u_id1_dup = u32_intern(mut_view(u32_in), 12345u32);

    if u_id1 != 1 { return 12; }
    if u_id2 != 2 { return 13; }
    if u_id1_dup != u_id1 { return 14; }
    if u32_interner_lookup(view(u32_in), 12345u32) != 1 { return 15; }
    if u32_interner_lookup(view(u32_in), 99999u32) != 0 { return 16; }
    if u32_interner_get(view(u32_in), u_id1) != 12345u32 { return 17; }
    if u32_interner_get(view(u32_in), u_id2) != 67890u32 { return 18; }

    u32_interner_free(mut_view(u32_in));
    interner_free(mut_view(in_));
    arena_destroy(mut_view(scratch));

    let rc_many = test_many_strings();
    if rc_many != 0 { return rc_many; }
    let rc_u32 = test_many_u32();
    if rc_u32 != 0 { return rc_u32; }
    let rc_var = test_varlen_boundary();
    if rc_var != 0 { return rc_var; }

    print("OK Kernel Interner\n");
    0
}
