}

fn axh_avalanche(mut h: u64) -> u64 {
    h = wrapping_mul_u64(axh_fold(h), AXH_M);
    h = wrapping_mul_u64(axh_fold(h), AXH_K2);
    axh_fold(h)
}

pub struct AxHasher {
    pub h: u64,
    pub total_len: u64,
    pub buf: [8]u8,
    pub buf_len: usize,
}

pub fn ax_hasher_new() -> AxHasher {
