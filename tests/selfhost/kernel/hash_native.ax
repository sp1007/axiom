    0x2a8fbd34ba79cee7u64, 0x2c28603821afc185u64, 0x19bf41d245cdc11fu64, 0x6652d639d2991029u64,
    0x057bbd81aec67a56u64, 0x52ba651b7cbf139cu64, 0x3f205fb31c065ba4u64, 0x97091c4287d17ae1u64,
    0x16eba03f96175a8du64, 0x0efde65d160f7192u64, 0x237abc3c351231e8u64, 0xc659e366791042acu64,
    0x5824b52ecea5b7e7u64, 0xd25ee43a12416513u64, 0x506faa2b66e3f56du64, 0xc8c1b1ddd4146c83u64,
    0x19b354231011b408u64, 0xfbf281c58ca5b263u64, 0x2519c233ce4695bau64, 0x797d67ca4ded94f6u64,
    0x8764e0154edd5486u64, 0xcc5248d20581985eu64, 0x3f902646bc6f0aa5u64, 0x9df0ced747195339u64,
    0x411f38841b94d098u64, 0xee7e7166abb49686u64, 0x5c4db8a51519ed84u64, 0x5cec5e0323f53e92u64,
    0xbcb689d910bf6d0au64, 0x1c7cf9248ed9c79du64, 0xca51dd4ea6620644u64,
];

fn main() -> i32 {
    // view() of a const table is rejected by the capability check, so the keys are copied to a local array
    let keys: [3184]u8 = KEYS;
    let mut i: usize = 0;
    while i < 47 {
        let off = OFFS[i];
        let n = LENS[i];
        let p = unsafe { address_of(keys[off]) };
        // one call over the whole key
        if ax_hash_bytes(p, n) != HASHES[i] { return (i + 1) as i32; }
        // the same key written in two parts, split at every position (short keys only)
        let mut k: usize = 0;
        while n <= 40 && k <= n {
            let mut s = ax_hasher_new();
            ax_hasher_write(mut_view(s), p, k);
            ax_hasher_write(mut_view(s), unsafe { p + k }, n - k);
            if ax_hasher_finish(view(s)) != HASHES[i] { return (100 + i) as i32; }
            k = k + 1;
        }
        i = i + 1;
    }
    // typed writers and combine against the Python reference (little-endian bytes)
    if ax_hash_u32(0x04030201u32) != 0xd548b0df69d394f3u64 { return 201; }
    if ax_hash_u64(0x0807060504030201u64) != 0x56a08fc1e2b70901u64 { return 202; }
    if ax_hash_u64(0u64) != 0x27d47dffbbeb41a6u64 { return 203; }
    if ax_hash_combine(100u64, 200u64) != 0xb85ce36686bc8b34u64 { return 204; }
    print("AXH64 KERNEL HASH PASS\n");
    0
}
