// test: run
// stdout: OK Kernel Hash\n

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

use std.core.host.heap_alloc
use std.core.host.heap_free

@intrinsic fn wrapping_add_u64(a: u64, b: u64) -> u64 { a + b }
@intrinsic fn wrapping_mul_u64(a: u64, b: u64) -> u64 { a * b }
@intrinsic fn rotate_left_u64(x: u64, n: u32) -> u64 {
    let s = n & 63u32;
    if s == 0u32 {
        x
    } else {
        (x << s) | (x >> (64u32 - s))
    }
}

const AXH_K1: u64 = 0x9E3779B97F4A7C15;
const AXH_K2: u64 = 0xC2B2AE3D27D4EB4F;
const AXH_K3: u64 = 0x165667B19E3779F9;
const AXH_SEED: u64 = 0x27D4EB2F165667C5;
const AXH_M: u64 = 0x9FB21C651E98DF25;

fn ax_rotl64(x: u64, n: u32) -> u64 {
    rotate_left_u64(x, n)
}

fn axh_round(h: u64, w: u64) -> u64 {
    let m = wrapping_mul_u64(ax_rotl64(wrapping_mul_u64(w, AXH_K2), 31u32), AXH_K1);
    wrapping_add_u64(wrapping_mul_u64(ax_rotl64(h ^ m, 27u32), AXH_K1), AXH_K3)
}

fn axh_fold(h: u64) -> u64 {
    h ^ ax_rotl64(h, 15u32) ^ ax_rotl64(h, 40u32)
}

fn axh_avalanche(mut h: u64) -> u64 {
    h = wrapping_mul_u64(axh_fold(h), AXH_M);
    h = wrapping_mul_u64(axh_fold(h), AXH_K2);
    axh_fold(h)
}

struct AxHasher {
    h: u64,
    total_len: u64,
    buf: [8]u8,
    buf_len: usize,
}

fn ax_hasher_new() -> AxHasher {
    AxHasher {
        h: AXH_SEED,
        total_len: 0u64,
        buf: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8],
        buf_len: 0,
    }
}

fn ax_hasher_init(s: mut_view<AxHasher>) {
    s.h = AXH_SEED;
    s.total_len = 0u64;
    s.buf[0] = 0u8;
    s.buf[1] = 0u8;
    s.buf[2] = 0u8;
    s.buf[3] = 0u8;
    s.buf[4] = 0u8;
    s.buf[5] = 0u8;
    s.buf[6] = 0u8;
    s.buf[7] = 0u8;
    s.buf_len = 0;
}

fn ax_hasher_write(s: mut_view<AxHasher>, bytes: *const u8, mut byte_len: usize) {
    let mut p = bytes;
    s.total_len = wrapping_add_u64(s.total_len, byte_len as u64);
    while byte_len > 0 {
        if s.buf_len == 0 && byte_len >= 8 {
            let mut w: u64 = 0;
            let mut j: usize = 0;
            while j < 8 {
                let b = unsafe { *(p + j) } as u64;
                w = w | (b << (8 * j as u32));
                j = j + 1;
            }
            s.h = axh_round(s.h, w);
            p = unsafe { p + 8 };
            byte_len = byte_len - 8;
            continue;
        }
        s.buf[s.buf_len] = unsafe { *p };
        s.buf_len = s.buf_len + 1;
        p = unsafe { p + 1 };
        byte_len = byte_len - 1;
        if s.buf_len == 8 {
            let mut w: u64 = 0;
            let mut j: usize = 0;
            while j < 8 {
                let b = s.buf[j] as u64;
                w = w | (b << (8 * j as u32));
                j = j + 1;
            }
            s.h = axh_round(s.h, w);
            s.buf_len = 0;
        }
    }
}

fn ax_hasher_write_u32(s: mut_view<AxHasher>, mut v: u32) {
    let mut i: usize = 0;
    while i < 4 {
        s.total_len = wrapping_add_u64(s.total_len, 1u64);
        s.buf[s.buf_len] = (v & 0xFFu32) as u8;
        s.buf_len = s.buf_len + 1;
        if s.buf_len == 8 {
            let mut w: u64 = 0;
            let mut j: usize = 0;
            while j < 8 {
                let b = s.buf[j] as u64;
                w = w | (b << (8 * j as u32));
                j = j + 1;
            }
            s.h = axh_round(s.h, w);
            s.buf_len = 0;
        }
        v = v >> 8u32;
        i = i + 1;
    }
}

fn ax_hasher_write_u64(s: mut_view<AxHasher>, mut v: u64) {
    let mut i: usize = 0;
    while i < 8 {
        s.total_len = wrapping_add_u64(s.total_len, 1u64);
        s.buf[s.buf_len] = (v & 0xFFu64) as u8;
        s.buf_len = s.buf_len + 1;
        if s.buf_len == 8 {
            let mut w: u64 = 0;
            let mut j: usize = 0;
            while j < 8 {
                let b = s.buf[j] as u64;
                w = w | (b << (8 * j as u32));
                j = j + 1;
            }
            s.h = axh_round(s.h, w);
            s.buf_len = 0;
        }
        v = v >> 8u32;
        i = i + 1;
    }
}

fn ax_hasher_finish(s: view<AxHasher>) -> u64 {
    let mut h = s.h;
    if s.buf_len > 0 {
        let mut w: u64 = 0;
        let mut j: usize = 0;
        while j < s.buf_len {
            let b = s.buf[j] as u64;
            w = w | (b << (8 * j as u32));
            j = j + 1;
        }
        h = axh_round(h, w);
    }
    h = h ^ wrapping_mul_u64(s.total_len, AXH_K3);
    axh_avalanche(h)
}

fn ax_hash_bytes(bytes: *const u8, byte_len: usize) -> u64 {
    let mut s = ax_hasher_new();
    ax_hasher_write(mut_view(s), bytes, byte_len);
    ax_hasher_finish(view(s))
}

fn ax_hash_u32(v: u32) -> u64 {
    let mut s = ax_hasher_new();
    ax_hasher_write_u32(mut_view(s), v);
    ax_hasher_finish(view(s))
}

fn ax_hash_u64(v: u64) -> u64 {
    let mut s = ax_hasher_new();
    ax_hasher_write_u64(mut_view(s), v);
    ax_hasher_finish(view(s))
}

fn ax_hash_combine(a: u64, b: u64) -> u64 {
    let mut s = ax_hasher_new();
    ax_hasher_write_u64(mut_view(s), a);
    ax_hasher_write_u64(mut_view(s), b);
    ax_hasher_finish(view(s))
}

fn main() -> i32 {
    let heap_buf = unsafe { heap_alloc(64, 1) };
    if heap_buf as usize == 0 { return 100; }

    // Vector 1: empty key (0 bytes) -> 0xd8e728ed68f180e9
    let h1 = ax_hash_bytes(heap_buf as *const u8, 0);
    if h1 != 0xd8e728ed68f180e9 {
        unsafe { heap_free(heap_buf, 64, 1); }
        return 1;
    }

    // Vector 2: 'a' (0x61) -> 0xda2e93eede955e3f
    unsafe { *heap_buf = 0x61u8; }
    let h2 = ax_hash_bytes(heap_buf as *const u8, 1);
    if h2 != 0xda2e93eede955e3f {
        unsafe { heap_free(heap_buf, 64, 1); }
        return 2;
    }

    // Vector 3: "abc" -> 0x050282dd1361d4b1
    unsafe {
        *(heap_buf + 1) = 0x62u8;
        *(heap_buf + 2) = 0x63u8;
    }
    let h3 = ax_hash_bytes(heap_buf as *const u8, 3);
    if h3 != 0x050282dd1361d4b1 {
        unsafe { heap_free(heap_buf, 64, 1); }
        return 3;
    }

    // Vector 4: "abcdefgh" -> 0x6652d639d2991029
    unsafe {
        *(heap_buf + 3) = 0x64u8;
        *(heap_buf + 4) = 0x65u8;
        *(heap_buf + 5) = 0x66u8;
        *(heap_buf + 6) = 0x67u8;
        *(heap_buf + 7) = 0x68u8;
    }
    let h4 = ax_hash_bytes(heap_buf as *const u8, 8);
    if h4 != 0x6652d639d2991029 {
        unsafe { heap_free(heap_buf, 64, 1); }
        return 4;
    }

    // Vector 5: "abcdefghi" -> 0x057bbd81aec67a56
    unsafe {
        *(heap_buf + 8) = 0x69u8;
    }
    let h5 = ax_hash_bytes(heap_buf as *const u8, 9);
    if h5 != 0x057bbd81aec67a56 {
        unsafe { heap_free(heap_buf, 64, 1); }
        return 5;
    }

    // Incremental split test: "ab" then "c" == "abc"
    let mut inc = ax_hasher_new();
    ax_hasher_write(mut_view(inc), heap_buf as *const u8, 2);
    ax_hasher_write(mut_view(inc), unsafe { heap_buf + 2 } as *const u8, 1);
    let h_inc = ax_hasher_finish(view(inc));
    if h_inc != 0x050282dd1361d4b1 {
        unsafe { heap_free(heap_buf, 64, 1); }
        return 6;
    }

    // ax_hash_u32 equivalence with 4 bytes
    let u32_val: u32 = 0x04030201u32;
    let mut s_u32 = ax_hasher_new();
    ax_hasher_write_u32(mut_view(s_u32), u32_val);
    let h_u32 = ax_hasher_finish(view(s_u32));
    if ax_hash_u32(u32_val) != h_u32 {
        unsafe { heap_free(heap_buf, 64, 1); }
        return 7;
    }

    // ax_hash_u64 equivalence with 8 bytes
    let u64_val: u64 = 0x0807060504030201u64;
    let mut s_u64 = ax_hasher_new();
    ax_hasher_write_u64(mut_view(s_u64), u64_val);
    let h_u64 = ax_hasher_finish(view(s_u64));
    if ax_hash_u64(u64_val) != h_u64 {
        unsafe { heap_free(heap_buf, 64, 1); }
        return 8;
    }

    // ax_hash_combine deterministic check
    let comb1 = ax_hash_combine(100u64, 200u64);
    let comb2 = ax_hash_combine(100u64, 200u64);
    if comb1 != comb2 {
        unsafe { heap_free(heap_buf, 64, 1); }
        return 9;
    }
    if comb1 == ax_hash_combine(200u64, 100u64) {
        unsafe { heap_free(heap_buf, 64, 1); }
        return 10;
    }

    unsafe { heap_free(heap_buf, 64, 1); }
    print("OK Kernel Hash\n");
    0
}
