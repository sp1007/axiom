// test: run
// stdout: OK Kernel ID\n

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

use std.core.host.heap_alloc
use std.core.host.heap_free

@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

struct StrId { pub v: u32, }
impl StrId {
    pub fn none() -> StrId { StrId { v: 0 } }
    pub fn is_none(self: view<StrId>) -> bool { self.v == 0 }
    pub fn is_some(self: view<StrId>) -> bool { self.v != 0 }
    pub fn from_index(index: usize) -> StrId { StrId { v: (index + 1) as u32 } }
    pub fn index(self: view<StrId>) -> usize { (self.v - 1) as usize }
    pub fn eq(self: view<StrId>, other: view<StrId>) -> bool { self.v == other.v }
    pub fn to_raw(self: view<StrId>) -> u32 { self.v }
    pub fn from_raw(v: u32) -> StrId { StrId { v: v } }
}

struct FileId { pub v: u32, }
impl FileId {
    pub fn none() -> FileId { FileId { v: 0 } }
    pub fn is_none(self: view<FileId>) -> bool { self.v == 0 }
    pub fn is_some(self: view<FileId>) -> bool { self.v != 0 }
    pub fn from_index(index: usize) -> FileId { FileId { v: (index + 1) as u32 } }
    pub fn index(self: view<FileId>) -> usize { (self.v - 1) as usize }
    pub fn eq(self: view<FileId>, other: view<FileId>) -> bool { self.v == other.v }
    pub fn to_raw(self: view<FileId>) -> u32 { self.v }
    pub fn from_raw(v: u32) -> FileId { FileId { v: v } }
}

struct RawIdTable {
    pub items: *mut u8,
    pub elem_size: usize,
    pub elem_align: usize,
    pub len: usize,
    pub cap: usize,
}

fn raw_idtable_new(elem_size: usize, elem_align: usize) -> RawIdTable {
    raw_idtable_with_capacity(0, elem_size, elem_align)
}

fn raw_idtable_with_capacity(capacity: usize, elem_size: usize, elem_align: usize) -> RawIdTable {
    let esz = if elem_size == 0 { 1 } else { elem_size };
    let eal = if elem_align == 0 { 1 } else { elem_align };
    if capacity == 0 {
        return RawIdTable {
            items: 0 as *mut u8,
            elem_size: esz,
            elem_align: eal,
            len: 0,
            cap: 0,
        };
    }
    let raw = unsafe { heap_alloc(capacity * esz, eal) };
    RawIdTable {
        items: raw,
        elem_size: esz,
        elem_align: eal,
        len: 0,
        cap: capacity,
    }
}

fn raw_idtable_free(t: mut_view<RawIdTable>) {
    if t.cap > 0 && t.items as usize != 0 {
        unsafe {
            heap_free(t.items, t.cap * t.elem_size, t.elem_align);
        }
    }
    t.items = 0 as *mut u8;
    t.len = 0;
    t.cap = 0;
}

fn raw_idtable_clear(t: mut_view<RawIdTable>) {
    t.len = 0;
}

fn raw_idtable_len(t: view<RawIdTable>) -> usize {
    t.len
}

fn raw_idtable_is_empty(t: view<RawIdTable>) -> bool {
    t.len == 0
}

fn raw_idtable_contains(t: view<RawIdTable>, id_val: u32) -> bool {
    id_val != 0 && (id_val as usize) <= t.len
}

fn raw_idtable_push(t: mut_view<RawIdTable>, src: *const u8) -> u32 {
    if t.len == t.cap {
        let new_cap = if t.cap == 0 { 4 } else { t.cap + t.cap };
        let new_items = unsafe { heap_alloc(new_cap * t.elem_size, t.elem_align) };
        if t.len > 0 && t.items as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(t.items as *const u8, new_items, t.len * t.elem_size);
                heap_free(t.items, t.cap * t.elem_size, t.elem_align);
            }
        }
        t.items = new_items;
        t.cap = new_cap;
    }
    let dst = (t.items as usize + t.len * t.elem_size) as *mut u8;
    if src as usize != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(src, dst, t.elem_size);
        }
    }
    t.len = t.len + 1;
    t.len as u32
}

unsafe fn raw_idtable_get_ptr(t: view<RawIdTable>, id_val: u32) -> *const u8 {
    (t.items as usize + ((id_val - 1) as usize) * t.elem_size) as *const u8
}

unsafe fn raw_idtable_get_mut_ptr(t: mut_view<RawIdTable>, id_val: u32) -> *mut u8 {
    (t.items as usize + ((id_val - 1) as usize) * t.elem_size) as *mut u8
}

fn raw_idtable_first(t: view<RawIdTable>) -> u32 {
    if t.len == 0 { 0u32 } else { 1u32 }
}

fn raw_idtable_after(t: view<RawIdTable>, id_val: u32) -> u32 {
    if (id_val as usize) < t.len { id_val + 1u32 } else { 0u32 }
}

struct U32IdTable {
    pub raw: RawIdTable,
}

fn u32_idtable_new() -> U32IdTable {
    U32IdTable {
        raw: raw_idtable_new(4, 4),
    }
}

fn u32_idtable_free(t: mut_view<U32IdTable>) {
    raw_idtable_free(mut_view(t.raw));
}

fn u32_idtable_len(t: view<U32IdTable>) -> usize {
    t.raw.len
}

fn u32_idtable_is_empty(t: view<U32IdTable>) -> bool {
    t.raw.len == 0
}

fn u32_idtable_contains(t: view<U32IdTable>, id_val: u32) -> bool {
    raw_idtable_contains(view(t.raw), id_val)
}

fn u32_idtable_push(t: mut_view<U32IdTable>, val: u32) -> u32 {
    unsafe {
        raw_idtable_push(mut_view(t.raw), address_of(val) as *const u8)
    }
}

fn u32_idtable_get(t: view<U32IdTable>, id_val: u32) -> u32 {
    if !raw_idtable_contains(view(t.raw), id_val) {
        return 0u32;
    }
    unsafe {
        let p = raw_idtable_get_ptr(view(t.raw), id_val) as *const u32;
        *p
    }
}

fn u32_idtable_set(t: mut_view<U32IdTable>, id_val: u32, val: u32) -> bool {
    if !raw_idtable_contains(view(t.raw), id_val) {
        return false;
    }
    unsafe {
        let p = raw_idtable_get_mut_ptr(mut_view(t.raw), id_val) as *mut u32;
        *p = val;
    }
    true
}

fn u32_idtable_first(t: view<U32IdTable>) -> u32 {
    raw_idtable_first(view(t.raw))
}

fn u32_idtable_after(t: view<U32IdTable>, id_val: u32) -> u32 {
    raw_idtable_after(view(t.raw), id_val)
}

fn main() -> i32 {
    // Test Typed ID basics
    let s_none = StrId.none();
    if !s_none.is_none() { return 1; }
    if s_none.is_some() { return 2; }
    if s_none.to_raw() != 0 { return 3; }

    let s1 = StrId.from_index(0);
    if s1.is_none() { return 4; }
    if !s1.is_some() { return 5; }
    if s1.to_raw() != 1 { return 6; }
    if s1.index() != 0 { return 7; }

    let s2 = StrId.from_index(41);
    if s2.to_raw() != 42 { return 8; }
    if s2.index() != 41 { return 9; }

    let s_raw = StrId.from_raw(42);
    if !s2.eq(view(s_raw)) { return 10; }

    // Test FileId
    let f1 = FileId.from_index(5);
    if f1.to_raw() != 6 { return 11; }
    if f1.index() != 5 { return 12; }

    // Test U32IdTable
    let mut tbl = u32_idtable_new();
    if !u32_idtable_is_empty(view(tbl)) { return 13; }
    if u32_idtable_len(view(tbl)) != 0 { return 14; }

    let id_a = u32_idtable_push(mut_view(tbl), 100u32);
    let id_b = u32_idtable_push(mut_view(tbl), 200u32);
    let id_c = u32_idtable_push(mut_view(tbl), 300u32);

    if id_a != 1 { return 15; }
    if id_b != 2 { return 16; }
    if id_c != 3 { return 17; }
    if u32_idtable_len(view(tbl)) != 3 { return 18; }
    if u32_idtable_is_empty(view(tbl)) { return 19; }

    if !u32_idtable_contains(view(tbl), id_a) { return 20; }
    if !u32_idtable_contains(view(tbl), id_c) { return 21; }
    if u32_idtable_contains(view(tbl), 0) { return 22; }
    if u32_idtable_contains(view(tbl), 4) { return 23; }

    if u32_idtable_get(view(tbl), id_a) != 100u32 { return 24; }
    if u32_idtable_get(view(tbl), id_b) != 200u32 { return 25; }
    if u32_idtable_get(view(tbl), id_c) != 300u32 { return 26; }

    // Mutation
    if !u32_idtable_set(mut_view(tbl), id_b, 999u32) { return 27; }
    if u32_idtable_get(view(tbl), id_b) != 999u32 { return 28; }

    // Iteration: first, after
    let mut it = u32_idtable_first(view(tbl));
    let mut sum: u32 = 0;
    while it != 0 {
        sum = sum + u32_idtable_get(view(tbl), it);
        it = u32_idtable_after(view(tbl), it);
    }
    // sum = 100 + 999 + 300 = 1399
    if sum != 1399u32 { return 29; }

    u32_idtable_free(mut_view(tbl));
    print("OK Kernel ID\n");
    0
}
