// test: run
// stdout: OK Kernel Arena\n

module main

use host_intrinsics.heap_alloc
use host_intrinsics.heap_free
use host_intrinsics.exit
use compiler.kernel.arena.Arena
use compiler.kernel.arena.arena_alloc_raw
use compiler.kernel.arena.arena_destroy
use compiler.kernel.arena.arena_dup
use compiler.kernel.arena.arena_reset
use compiler.kernel.arena.arena_with_chunk_size

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic fn wrapping_add_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn rotate_left_u64(x: u64, n: u32) -> u64 { 0 }

fn main() -> i32 {
    let mut a = arena_with_chunk_size(1024);

    // Initial state
    if a.chunk_count != 0 { return 1; }
    if a.bytes_requested != 0 { return 2; }

    // Alloc 64 bytes with align 8
    let p1 = arena_alloc_raw(mut_view(a), 64, 8);
    if p1 as usize == 0 { return 3; }
    if (p1 as usize) & 7 != 0 { return 4; }
    if a.chunk_count != 1 { return 5; }
    if a.bytes_requested != 64 { return 6; }

    // Alloc 128 bytes with align 16
    let p2 = arena_alloc_raw(mut_view(a), 128, 16);
    if p2 as usize == 0 { return 7; }
    if (p2 as usize) & 15 != 0 { return 8; }
    if a.chunk_count != 1 { return 9; }
    if a.bytes_requested != 192 { return 10; }

    // Write patterns to p1 and p2
    unsafe {
        *p1 = 0xAAu8;
        *(p1 + 63) = 0xBBu8;
        *p2 = 0xCCu8;
        *(p2 + 127) = 0xDDu8;
    }
    if unsafe { *p1 != 0xAAu8 || *(p1 + 63) != 0xBBu8 } { return 11; }
    if unsafe { *p2 != 0xCCu8 || *(p2 + 127) != 0xDDu8 } { return 12; }

    // Large allocation forcing a dedicated chunk (> chunk_size 1024)
    let p3 = arena_alloc_raw(mut_view(a), 2048, 64);
    if p3 as usize == 0 { return 13; }
    if (p3 as usize) & 63 != 0 { return 14; }
    if a.chunk_count <= 1 { return 15; }

    // Dup bytes
    let p_dup = arena_dup(mut_view(a), p1 as *const u8, 64);
    if p_dup as usize == 0 { return 16; }
    if unsafe { *p_dup != 0xAAu8 || *(p_dup + 63) != 0xBBu8 } { return 17; }

    // Test arena_reset: retains head chunk, drops others
    arena_reset(mut_view(a));
    if a.chunk_count != 1 { return 18; }
    if a.bytes_requested != 0 { return 19; }

    // Re-alloc after reset into retained chunk
    let p_after_reset = arena_alloc_raw(mut_view(a), 32, 8);
    if p_after_reset as usize == 0 { return 20; }
    if a.bytes_requested != 32 { return 21; }

    // Destroy
    arena_destroy(mut_view(a));
    if a.chunk_count != 0 { return 22; }
    if a.head as usize != 0 { return 23; }

    print("OK Kernel Arena\n");
    0
}
