// test: run
// stdout: OK Kernel Dynarray\n

module main

use host_intrinsics.heap_alloc
use host_intrinsics.heap_free
use host_intrinsics.exit
use compiler.kernel.dynarray.u32_dynarray_clear
use compiler.kernel.dynarray.u32_dynarray_free
use compiler.kernel.dynarray.u32_dynarray_get
use compiler.kernel.dynarray.u32_dynarray_is_empty
use compiler.kernel.dynarray.u32_dynarray_len
use compiler.kernel.dynarray.u32_dynarray_new
use compiler.kernel.dynarray.u32_dynarray_pop
use compiler.kernel.dynarray.u32_dynarray_push
use compiler.kernel.dynarray.u32_dynarray_set

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic fn wrapping_add_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn rotate_left_u64(x: u64, n: u32) -> u64 { 0 }

fn main() -> i32 {
    let mut da = u32_dynarray_new();
    if !u32_dynarray_is_empty(view(da)) { return 1; }
    if u32_dynarray_len(view(da)) != 0 { return 2; }

    u32_dynarray_push(mut_view(da), 100u32);
    u32_dynarray_push(mut_view(da), 200u32);
    u32_dynarray_push(mut_view(da), 300u32);
    u32_dynarray_push(mut_view(da), 400u32);

    if u32_dynarray_is_empty(view(da)) { return 3; }
    if u32_dynarray_len(view(da)) != 4 { return 4; }

    if u32_dynarray_get(view(da), 0) != 100u32 { return 5; }
    if u32_dynarray_get(view(da), 1) != 200u32 { return 6; }
    if u32_dynarray_get(view(da), 2) != 300u32 { return 7; }
    if u32_dynarray_get(view(da), 3) != 400u32 { return 8; }

    if !u32_dynarray_set(mut_view(da), 1, 250u32) { return 9; }
    if u32_dynarray_get(view(da), 1) != 250u32 { return 10; }

    let v4 = u32_dynarray_pop(mut_view(da));
    if v4 != 400u32 { return 11; }
    if u32_dynarray_len(view(da)) != 3 { return 12; }

    let v3 = u32_dynarray_pop(mut_view(da));
    if v3 != 300u32 { return 13; }
    if u32_dynarray_len(view(da)) != 2 { return 14; }

    u32_dynarray_clear(mut_view(da));
    if !u32_dynarray_is_empty(view(da)) { return 15; }
    if u32_dynarray_len(view(da)) != 0 { return 16; }

    u32_dynarray_free(mut_view(da));

    print("OK Kernel Dynarray\n");
    0
}
