// test: run
// timeout: 600
// stdout: OK Win64 ABI Boundary Seam QA\n

module main

use compiler.kernel.arena.Arena
use compiler.kernel.arena.arena_with_chunk_size
use compiler.kernel.arena.arena_reset
use compiler.kernel.arena.arena_destroy
use compiler.kernel.arena.arena_alloc_raw
use compiler.kernel.id.StrId
use compiler.kernel.id.TypeId
use compiler.types.types.AxType
use compiler.types.types.TypeInterner
use compiler.types.types.TY_CLOSURE
use compiler.types.types.TY_FN
use compiler.types.types.ax_type_reset
use compiler.types.types.intern_array_ty
use compiler.types.types.intern_fn_ty
use compiler.types.types.intern_type
use compiler.types.types.type_get
use compiler.types.types.type_interner_init
use compiler.types.types.type_interner_free
use compiler.lir.lir.LIR_VREG_NONE
use compiler.lir.lir.LIR_INST_ABI_ARG
use compiler.lir.lir.LIR_INST_ABI_RESULT
use compiler.lir.lir.LIR_INST_CALL
use compiler.lir.lir.LIR_TERM_JMP
use compiler.lir.lir.LIR_TERM_RETURN
use compiler.lir.lir.LirBb
use compiler.lir.lir.LirInst
use compiler.lir.lir.lir_bb_at
use compiler.lir.lir.lir_bb_reset
use compiler.lir.lir.lir_body_new
use compiler.lir.lir.lir_inst_at
use compiler.lir.lir.lir_inst_reset
use compiler.lir.lir.lir_term_reset
