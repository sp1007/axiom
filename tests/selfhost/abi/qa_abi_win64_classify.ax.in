@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }

unsafe fn set_param(base: *mut TypeId, idx: usize, ty_v: u32) {
    let off = ((idx as isize) * (size_of<TypeId>() as isize)) as usize;
    let p = ((base as usize) + off) as *mut TypeId;
    (*p).v = ty_v;
}

unsafe fn mk_arr(ti_ptr: *mut TypeInterner, elem_v: u32, count: u64) -> u32 {
    let id = intern_array_ty(mut_view(*ti_ptr), TypeId { v: elem_v }, count);
    id.v
}

unsafe fn mk_fn(ti_ptr: *mut TypeInterner, params: *mut TypeId, count: usize, ret_v: u32) -> u32 {
    let id = intern_fn_ty(mut_view(*ti_ptr), false, StrId { v: 0u32 }, params, count, TypeId { v: ret_v });
    id.v
}

unsafe fn get_ty(ti_ptr: *mut TypeInterner, id_v: u32) -> *const AxType {
    type_get(view(*ti_ptr), TypeId { v: id_v }) as *const AxType
}

fn test_register_and_alignment_rules() -> i32 {
    if ABI_LOC_REG != AX_ABI_LOC_REG || ABI_LOC_STACK != AX_ABI_LOC_STACK || ABI_LOC_INDIRECT != AX_ABI_LOC_INDIRECT {
        return 10;
    }
    if WIN64_SHADOW_SPACE != 32u32 || WIN64_STACK_ALIGN != 16u32 || WIN64_STACK_SLOT_SIZE != 8u32 {
        return 11;
    }
    if WIN64_MAX_REG_ARGS != 4u32 || WIN64_RET_REG != WIN64_REG_RAX {
        return 12;
    }
    if WIN64_CALLEE_SAVED_COUNT != 7u32 || WIN64_CALLEE_SAVED_BYTES != 56u32 {
        return 13;
    }
    if WIN64_ARG_REGS[0] != WIN64_REG_RCX || WIN64_ARG_REGS[1] != WIN64_REG_RDX ||
       WIN64_ARG_REGS[2] != WIN64_REG_R8 || WIN64_ARG_REGS[3] != WIN64_REG_R9 {
        return 14;
    }
    if win64_arg_reg(0u32) != 1u32 || win64_arg_reg(1u32) != 2u32 ||
       win64_arg_reg(2u32) != 8u32 || win64_arg_reg(3u32) != 9u32 ||
       win64_arg_reg(4u32) != WIN64_REG_NONE {
        return 15;
    }

    // Caller-saved registers: RAX (0), RCX (1), RDX (2), R8 (8), R9 (9), R10 (10), R11 (11)
    let mut c_idx: usize = 0;
    while c_idx < 7 {
        let r = WIN64_CALLER_SAVED_REGS[c_idx];
        if !win64_is_caller_saved(r) || win64_is_callee_saved(r) {
            return 16;
        }
        c_idx = c_idx + 1;
    }

    // Callee-saved GP registers: RBX (3), RSI (6), RDI (7), R12 (12), R13 (13), R14 (14), R15 (15) + RBP (5)
    let mut nv_idx: usize = 0;
    while nv_idx < 7 {
        let r = WIN64_CALLEE_SAVED_REGS[nv_idx];
        if !win64_is_nonvolatile_gp(r) || !win64_is_callee_saved(r) || win64_is_caller_saved(r) {
            return 17;
        }
        nv_idx = nv_idx + 1;
    }
    if !win64_is_callee_saved(WIN64_REG_RBP) || win64_is_nonvolatile_gp(WIN64_REG_RBP) {
        return 18;
    }
    if win64_is_caller_saved(WIN64_REG_RSP) || win64_is_callee_saved(WIN64_REG_RSP) {
        return 19;
    }

    // Indirect size rules: 0, 1, 2, 4, 8 -> direct; 3, 5, 6, 7, >8 -> indirect
    if win64_needs_indirect(0u32) || win64_needs_indirect(1u32) ||
       win64_needs_indirect(2u32) || win64_needs_indirect(4u32) ||
       win64_needs_indirect(8u32) {
        return 20;
    }
    if !win64_needs_indirect(3u32) || !win64_needs_indirect(5u32) ||
       !win64_needs_indirect(6u32) || !win64_needs_indirect(7u32) ||
       !win64_needs_indirect(9u32) || !win64_needs_indirect(16u32) ||
       !win64_needs_indirect(24u32) {
        return 21;
    }

    // 16-byte stack alignment helper
    if win64_align_stack(0u32) != 0u32 ||
       win64_align_stack(1u32) != 16u32 ||
       win64_align_stack(15u32) != 16u32 ||
       win64_align_stack(16u32) != 16u32 ||
       win64_align_stack(17u32) != 32u32 ||
       win64_align_stack(32u32) != 32u32 ||
       win64_align_stack(40u32) != 48u32 {
        return 22;
    }

    0
}

// Port of tests/mc/isel/cdriver_abi.c
fn test_cdriver_abi(a: mut_view<Arena>, ti_ptr: *mut TypeInterner) -> i32 {
    let i32_v = unsafe { (*ti_ptr).t_i32.v };
    let unit_v = unsafe { (*ti_ptr).t_unit.v };

    // Case 1: 6 integer arguments -> RCX, RDX, R8, R9, stack(32), stack(40)
    let params1 = arena_alloc_raw(mut_view(*a), 6 * size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
    unsafe {
        set_param(params1, 0, i32_v);
        set_param(params1, 1, i32_v);
        set_param(params1, 2, i32_v);
        set_param(params1, 3, i32_v);
        set_param(params1, 4, i32_v);
        set_param(params1, 5, i32_v);
    }
    let fn1_v = unsafe { mk_fn(ti_ptr, params1, 6, unit_v) };
    let fn1_ptr = unsafe { get_ty(ti_ptr, fn1_v) };
    let sig1 = win64_classify(fn1_ptr, ti_ptr, mut_view(*a));
    if sig1.arg_count != 6 || sig1.shadow_space != 32u32 || sig1.stack_args_size != 16u32 {
        return 30;
    }
    if win64_outgoing_args_size(view(sig1)) != 48u32 {
        return 31;
    }
    let s1_a0 = unsafe { abi_arg_at(sig1.args, 0) };
    let s1_a1 = unsafe { abi_arg_at(sig1.args, 1) };
    let s1_a2 = unsafe { abi_arg_at(sig1.args, 2) };
    let s1_a3 = unsafe { abi_arg_at(sig1.args, 3) };
    let s1_a4 = unsafe { abi_arg_at(sig1.args, 4) };
    let s1_a5 = unsafe { abi_arg_at(sig1.args, 5) };
    if (unsafe { (*s1_a0).loc.kind }) != ABI_LOC_REG || (unsafe { (*s1_a0).loc.reg }) != 1u32 {
        return 32;
    }
    if (unsafe { (*s1_a1).loc.kind }) != ABI_LOC_REG || (unsafe { (*s1_a1).loc.reg }) != 2u32 {
        return 33;
    }
    if (unsafe { (*s1_a2).loc.kind }) != ABI_LOC_REG || (unsafe { (*s1_a2).loc.reg }) != 8u32 {
        return 34;
    }
    if (unsafe { (*s1_a3).loc.kind }) != ABI_LOC_REG || (unsafe { (*s1_a3).loc.reg }) != 9u32 {
        return 35;
    }
    if (unsafe { (*s1_a4).loc.kind }) != ABI_LOC_STACK || (unsafe { (*s1_a4).loc.offset }) != 32u32 {
        return 36;
    }
    if (unsafe { (*s1_a5).loc.kind }) != ABI_LOC_STACK || (unsafe { (*s1_a5).loc.offset }) != 40u32 {
        return 37;
    }

    // Case 2: 8-byte aggregate ([2]i32, passed by value) and 16-byte aggregate ([4]i32, passed by indirect ref)
    let arr8_v = unsafe { mk_arr(ti_ptr, i32_v, 2u64) };
    let arr16_v = unsafe { mk_arr(ti_ptr, i32_v, 4u64) };
    let params2 = arena_alloc_raw(mut_view(*a), 2 * size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
    unsafe {
        set_param(params2, 0, arr8_v);
        set_param(params2, 1, arr16_v);
    }
    let fn2_v = unsafe { mk_fn(ti_ptr, params2, 2, unit_v) };
    let fn2_ptr = unsafe { get_ty(ti_ptr, fn2_v) };
    let sig2 = win64_classify(fn2_ptr, ti_ptr, mut_view(*a));
    if sig2.arg_count != 2 || sig2.shadow_space != 32u32 || sig2.stack_args_size != 0u32 {
        return 38;
    }
    let s2_a0 = unsafe { abi_arg_at(sig2.args, 0) };
    let s2_a1 = unsafe { abi_arg_at(sig2.args, 1) };
    if (unsafe { (*s2_a0).loc.kind }) != ABI_LOC_REG || (unsafe { (*s2_a0).loc.reg }) != 1u32 {
        return 39;
    }
    if (unsafe { (*s2_a1).loc.kind }) != ABI_LOC_INDIRECT || (unsafe { (*s2_a1).loc.reg }) != 2u32 {
        return 40;
    }

    // Case 3: Aggregate return through hidden pointer in RCX shifting first actual arg to RDX
    let params3 = arena_alloc_raw(mut_view(*a), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
    unsafe {
        set_param(params3, 0, i32_v);
    }
    let fn3_v = unsafe { mk_fn(ti_ptr, params3, 1, arr16_v) };
    let fn3_ptr = unsafe { get_ty(ti_ptr, fn3_v) };
    let sig3 = win64_classify(fn3_ptr, ti_ptr, mut_view(*a));
    if sig3.ret.loc.kind != ABI_LOC_INDIRECT || sig3.ret.loc.reg != 1u32 {
        return 41;
    }
    if sig3.arg_count != 1 {
        return 42;
    }
    let s3_a0 = unsafe { abi_arg_at(sig3.args, 0) };
    if (unsafe { (*s3_a0).loc.kind }) != ABI_LOC_REG || (unsafe { (*s3_a0).loc.reg }) != 2u32 {
        return 43;
    }

    arena_reset(mut_view(*a));
    0
}

// Port of tests/mc/isel/cdriver_abi_edge.c, cdriver_abi_qa.c, and cdriver_abi_qa2.c
fn test_cdriver_abi_edge_and_qa(a: mut_view<Arena>, ti_ptr: *mut TypeInterner) -> i32 {
    let i8_v = unsafe { (*ti_ptr).t_i8.v };
    let unit_v = unsafe { (*ti_ptr).t_unit.v };

    let arr3_v = unsafe { mk_arr(ti_ptr, i8_v, 3u64) };
    let arr4_v = unsafe { mk_arr(ti_ptr, i8_v, 4u64) };
    let arr5_v = unsafe { mk_arr(ti_ptr, i8_v, 5u64) };
    let arr8_v = unsafe { mk_arr(ti_ptr, i8_v, 8u64) };
    let arr9_v = unsafe { mk_arr(ti_ptr, i8_v, 9u64) };
    let arr16_v = unsafe { mk_arr(ti_ptr, i8_v, 16u64) };

    // Edge 1: Size 3 passed by indirect reference in RCX
    let p_arr3 = arena_alloc_raw(mut_view(*a), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
    unsafe { set_param(p_arr3, 0, arr3_v); }
    let fn_arr3_v = unsafe { mk_fn(ti_ptr, p_arr3, 1, unit_v) };
    let fn_arr3_ptr = unsafe { get_ty(ti_ptr, fn_arr3_v) };
    let sig_arr3 = win64_classify(fn_arr3_ptr, ti_ptr, mut_view(*a));
    let a0_3 = unsafe { abi_arg_at(sig_arr3.args, 0) };
    if sig_arr3.arg_count != 1 || (unsafe { (*a0_3).loc.kind }) != ABI_LOC_INDIRECT || (unsafe { (*a0_3).loc.reg }) != 1u32 {
        return 50;
    }

    // Edge 2: Size 4 passed by value in RCX
    let p_arr4 = arena_alloc_raw(mut_view(*a), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
    unsafe { set_param(p_arr4, 0, arr4_v); }
    let fn_arr4_v = unsafe { mk_fn(ti_ptr, p_arr4, 1, unit_v) };
    let fn_arr4_ptr = unsafe { get_ty(ti_ptr, fn_arr4_v) };
    let sig_arr4 = win64_classify(fn_arr4_ptr, ti_ptr, mut_view(*a));
    let a0_4 = unsafe { abi_arg_at(sig_arr4.args, 0) };
    if sig_arr4.arg_count != 1 || (unsafe { (*a0_4).loc.kind }) != ABI_LOC_REG || (unsafe { (*a0_4).loc.reg }) != 1u32 {
        return 51;
    }

    // Edge 3: Aggregate return of size 3 / size 5 via hidden pointer in RCX
    let fn_ret5_v = unsafe { mk_fn(ti_ptr, 0 as *mut TypeId, 0, arr5_v) };
    let fn_ret5_ptr = unsafe { get_ty(ti_ptr, fn_ret5_v) };
    let sig_ret5 = win64_classify(fn_ret5_ptr, ti_ptr, mut_view(*a));
    if sig_ret5.ret.loc.kind != ABI_LOC_INDIRECT || sig_ret5.ret.loc.reg != 1u32 {
        return 52;
    }

    // QA1: Size 8 (passed by value in RCX) followed by Size 9 (passed by indirect ref in RDX)
    let p_qa1 = arena_alloc_raw(mut_view(*a), 2 * size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
    unsafe {
        set_param(p_qa1, 0, arr8_v);
        set_param(p_qa1, 1, arr9_v);
    }
    let fn_qa1_v = unsafe { mk_fn(ti_ptr, p_qa1, 2, unit_v) };
    let fn_qa1_ptr = unsafe { get_ty(ti_ptr, fn_qa1_v) };
    let sig_qa1 = win64_classify(fn_qa1_ptr, ti_ptr, mut_view(*a));
    let qa1_a0 = unsafe { abi_arg_at(sig_qa1.args, 0) };
    let qa1_a1 = unsafe { abi_arg_at(sig_qa1.args, 1) };
    if (unsafe { (*qa1_a0).loc.kind }) != ABI_LOC_REG || (unsafe { (*qa1_a0).loc.reg }) != 1u32 {
        return 53;
    }
    if (unsafe { (*qa1_a1).loc.kind }) != ABI_LOC_INDIRECT || (unsafe { (*qa1_a1).loc.reg }) != 2u32 {
        return 54;
    }

    // QA2: Hidden return pointer (size 16) + 5 size-8 args -> RDX, R8, R9, stack(32), stack(40)
    let p_qa2 = arena_alloc_raw(mut_view(*a), 5 * size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
    unsafe {
        set_param(p_qa2, 0, arr8_v);
        set_param(p_qa2, 1, arr8_v);
        set_param(p_qa2, 2, arr8_v);
        set_param(p_qa2, 3, arr8_v);
        set_param(p_qa2, 4, arr8_v);
    }
    let fn_qa2_v = unsafe { mk_fn(ti_ptr, p_qa2, 5, arr16_v) };
    let fn_qa2_ptr = unsafe { get_ty(ti_ptr, fn_qa2_v) };
    let sig_qa2 = win64_classify(fn_qa2_ptr, ti_ptr, mut_view(*a));
    if sig_qa2.arg_count != 5 || sig_qa2.ret.loc.kind != ABI_LOC_INDIRECT || sig_qa2.ret.loc.reg != 1u32 {
        return 55;
    }
    let qa2_a0 = unsafe { abi_arg_at(sig_qa2.args, 0) };
    let qa2_a1 = unsafe { abi_arg_at(sig_qa2.args, 1) };
    let qa2_a2 = unsafe { abi_arg_at(sig_qa2.args, 2) };
    let qa2_a3 = unsafe { abi_arg_at(sig_qa2.args, 3) };
    let qa2_a4 = unsafe { abi_arg_at(sig_qa2.args, 4) };
    if (unsafe { (*qa2_a0).loc.kind }) != ABI_LOC_REG || (unsafe { (*qa2_a0).loc.reg }) != 2u32 {
        return 56;
    }
    if (unsafe { (*qa2_a1).loc.kind }) != ABI_LOC_REG || (unsafe { (*qa2_a1).loc.reg }) != 8u32 {
        return 57;
    }
    if (unsafe { (*qa2_a2).loc.kind }) != ABI_LOC_REG || (unsafe { (*qa2_a2).loc.reg }) != 9u32 {
        return 58;
    }
    if (unsafe { (*qa2_a3).loc.kind }) != ABI_LOC_STACK || (unsafe { (*qa2_a3).loc.offset }) != 32u32 {
        return 59;
    }
    if (unsafe { (*qa2_a4).loc.kind }) != ABI_LOC_STACK || (unsafe { (*qa2_a4).loc.offset }) != 40u32 {
        return 60;
    }

    // Indirect aggregate on stack (5th argument is size 16):
    // loc.kind == ABI_LOC_INDIRECT, loc.offset == 32, loc.reg == 32 (matching C union for isel)
    let p_ind_stk = arena_alloc_raw(mut_view(*a), 5 * size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
    unsafe {
        set_param(p_ind_stk, 0, arr16_v);
        set_param(p_ind_stk, 1, arr8_v);
        set_param(p_ind_stk, 2, arr8_v);
        set_param(p_ind_stk, 3, arr8_v);
        set_param(p_ind_stk, 4, arr16_v);
    }
    let fn_ind_v = unsafe { mk_fn(ti_ptr, p_ind_stk, 5, unit_v) };
    let fn_ind_ptr = unsafe { get_ty(ti_ptr, fn_ind_v) };
    let sig_ind = win64_classify(fn_ind_ptr, ti_ptr, mut_view(*a));
    let ind_a0 = unsafe { abi_arg_at(sig_ind.args, 0) };
    let ind_a4 = unsafe { abi_arg_at(sig_ind.args, 4) };
    if !(unsafe { abi_loc_is_indirect_in_reg(view((*ind_a0).loc)) }) || (unsafe { abi_loc_is_indirect_on_stack(view((*ind_a0).loc)) }) {
        return 61;
    }
    if !(unsafe { abi_loc_is_indirect_on_stack(view((*ind_a4).loc)) }) || (unsafe { abi_loc_is_indirect_in_reg(view((*ind_a4).loc)) }) {
        return 62;
    }
    if (unsafe { (*ind_a4).loc.offset }) != 32u32 || (unsafe { abi_loc_reg_or_offset(view((*ind_a4).loc)) }) != 32u32 {
        return 63;
    }

    arena_reset(mut_view(*a));
    0
}

fn test_builtins_closures_and_guards(a: mut_view<Arena>, ti_ptr: *mut TypeInterner) -> i32 {
    let abi = abi_win64();

    // Null & non-fn guards
    let sig_null1 = abi_classify(view(abi), 0 as *const AxType, ti_ptr, mut_view(*a));
    if sig_null1.arg_count != 0 || sig_null1.shadow_space != 0u32 {
        return 70;
    }
    let i32_v = unsafe { (*ti_ptr).t_i32.v };
    let i32_ptr = unsafe { get_ty(ti_ptr, i32_v) };
    let sig_null2 = abi_classify(view(abi), i32_ptr, 0 as *mut TypeInterner, mut_view(*a));
    if sig_null2.arg_count != 0 || sig_null2.shadow_space != 0u32 {
        return 71;
    }
    let sig_non_fn = abi_classify(view(abi), i32_ptr, ti_ptr, mut_view(*a));
    if sig_non_fn.arg_count != 0 || sig_non_fn.shadow_space != 0u32 {
        return 72;
    }

    // TY_BUILTIN_PRINT -> 1 param of type str (16 bytes -> ABI_LOC_INDIRECT in RCX)
    let print_id = unsafe { intern_singleton(mut_view(*ti_ptr), TY_BUILTIN_PRINT) };
    let print_ptr = unsafe { get_ty(ti_ptr, print_id.v) };
    let sig_print = abi_classify(view(abi), print_ptr, ti_ptr, mut_view(*a));
    if sig_print.arg_count != 1 || sig_print.shadow_space != 32u32 || sig_print.stack_args_size != 0u32 {
        return 73;
    }
    let pr_a0 = unsafe { abi_arg_at(sig_print.args, 0) };
    if (unsafe { (*pr_a0).loc.kind }) != ABI_LOC_INDIRECT || (unsafe { (*pr_a0).loc.reg }) != 1u32 {
        return 74;
    }

    // TY_BUILTIN_PRINT_INT -> 1 param of type i64 (8 bytes -> ABI_LOC_REG in RCX)
    let print_int_id = unsafe { intern_singleton(mut_view(*ti_ptr), TY_BUILTIN_PRINT_INT) };
    let print_int_ptr = unsafe { get_ty(ti_ptr, print_int_id.v) };
    let sig_print_int = abi_classify(view(abi), print_int_ptr, ti_ptr, mut_view(*a));
    if sig_print_int.arg_count != 1 || sig_print_int.shadow_space != 32u32 || sig_print_int.stack_args_size != 0u32 {
        return 75;
    }
    let pri_a0 = unsafe { abi_arg_at(sig_print_int.args, 0) };
    if (unsafe { (*pri_a0).loc.kind }) != ABI_LOC_REG || (unsafe { (*pri_a0).loc.reg }) != 1u32 {
        return 76;
    }

    // TY_CLOSURE unwrapping to its underlying fn_type
    let i64_v = unsafe { (*ti_ptr).t_i64.v };
    let p_clos = arena_alloc_raw(mut_view(*a), 2 * size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
    unsafe {
        set_param(p_clos, 0, i64_v);
        set_param(p_clos, 1, i32_v);
    }
    let fn_clos_v = unsafe { mk_fn(ti_ptr, p_clos, 2, i32_v) };
    let clos_scratch = arena_alloc_raw(mut_view(*a), size_of<AxType>(), align_of<AxType>()) as *mut AxType;
    unsafe {
        ax_type_reset(mut_view(*clos_scratch), TY_CLOSURE);
        (*clos_scratch).closure_id = 1u32;
        (*clos_scratch).fn_type.v = fn_clos_v;
    }
    let clos_id = unsafe { intern_type(mut_view(*ti_ptr), view(*clos_scratch)) };
    let clos_ptr = unsafe { get_ty(ti_ptr, clos_id.v) };
    let sig_clos = abi_classify(view(abi), clos_ptr, ti_ptr, mut_view(*a));
    if sig_clos.arg_count != 2 || sig_clos.ret.loc.kind != ABI_LOC_REG || sig_clos.ret.loc.reg != 0u32 {
        return 77;
    }
    let cl_a0 = unsafe { abi_arg_at(sig_clos.args, 0) };
    let cl_a1 = unsafe { abi_arg_at(sig_clos.args, 1) };
    if (unsafe { (*cl_a0).loc.reg }) != 1u32 || (unsafe { (*cl_a1).loc.reg }) != 2u32 {
        return 78;
    }

    arena_reset(mut_view(*a));
    0
}

pub fn main() -> i32 {
    let rc1 = test_register_and_alignment_rules();
    if rc1 != 0 {
        return rc1;
    }

    let mut perm = arena_with_chunk_size(65536);
    let _ = arena_alloc_raw(mut_view(perm), 16, 8);
    let mut a = arena_with_chunk_size(65536);
    let _ = arena_alloc_raw(mut_view(a), 16, 8);

    let ti_ptr = arena_alloc_raw(mut_view(perm), size_of<TypeInterner>(), align_of<TypeInterner>()) as *mut TypeInterner;
    unsafe { type_interner_init(mut_view(*ti_ptr)); }

    let rc2 = test_cdriver_abi(mut_view(a), ti_ptr);
    if rc2 != 0 {
        return rc2;
    }

    let rc3 = test_cdriver_abi_edge_and_qa(mut_view(a), ti_ptr);
    if rc3 != 0 {
        return rc3;
    }

    let rc4 = test_builtins_closures_and_guards(mut_view(a), ti_ptr);
    if rc4 != 0 {
        return rc4;
    }

    unsafe { type_interner_free(mut_view(*ti_ptr)); }
    arena_destroy(mut_view(a));
    arena_destroy(mut_view(perm));
    print("OK Win64 ABI Classification & Register Rules\n");
    0
}
