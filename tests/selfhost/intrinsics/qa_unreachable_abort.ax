// test: run
// modes: interp native
// exit: 101
// stdout: before_unreachable\n
// QA boundary cross-check (T134): `unreachable()` lowers to `assert const false -> ...`
// and aborts with exit code 101 in both interpreter and native modes without
// executing subsequent statements.

@intrinsic fn unreachable() {}

fn main() -> i32 {
    print("before_unreachable\n");
    unreachable();
    print("after_unreachable\n");
    0
}
