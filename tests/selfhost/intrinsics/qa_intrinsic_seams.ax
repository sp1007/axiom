// test: run
// modes: interp native
// exit: 42
//
// QA boundary cross-check (T134):
// 1. Const-evaluation of lowered MIR-op intrinsics (`const` items initialized by
//    `wrapping_*`, `rotate_*`, `count_ones_*`, `leading_zeros_*`, `trailing_zeros_*`).
// 2. Projected struct/array field operands passed directly to intrinsics and
//    projected call destinations (`(*pkt).out = step_mix(...)`), exercising
//    `intr_materialize`, `eval_operand_ty`, and LIR projected `dst_ty`.
// 3. Generic functions calling `@intrinsic` operations across monomorphized
//    instantiations (`stage_mono_shielded` + `try_build_intrinsic_call`).
// 4. Untaken `unreachable()` and `panic(...)` branches alongside live `assert`.

@intrinsic fn wrapping_add_u32(a: u32, b: u32) -> u32 { 0 }
@intrinsic fn wrapping_sub_u32(a: u32, b: u32) -> u32 { 0 }
@intrinsic fn wrapping_mul_u32(a: u32, b: u32) -> u32 { 0 }
@intrinsic fn wrapping_neg_i32(a: i32) -> i32 { 0 }
@intrinsic fn rotate_left_u32(a: u32, n: u32) -> u32 { 0 }
@intrinsic fn rotate_right_u32(a: u32, n: u32) -> u32 { 0 }
@intrinsic fn count_ones_u32(a: u32) -> u32 { 0 }
@intrinsic fn leading_zeros_u32(a: u32) -> u32 { 0 }
@intrinsic fn trailing_zeros_u32(a: u32) -> u32 { 0 }
@intrinsic fn assert(cond: bool) {}
@intrinsic fn panic(msg: Str) {}
@intrinsic fn unreachable() {}

const C_WADD: u32 = wrapping_add_u32(4294967295, 2);
const C_WSUB: u32 = wrapping_sub_u32(0, 3);
const C_WMUL: u32 = wrapping_mul_u32(2147483648, 2);
const C_WNEG: i32 = wrapping_neg_i32(-42);
const C_ROTL: u32 = rotate_left_u32(2147483649, 33);
const C_ROTR: u32 = rotate_right_u32(3, 33);
const C_POP: u32 = count_ones_u32(305419896);
const C_CLZ: u32 = leading_zeros_u32(0);
const C_CTZ: u32 = trailing_zeros_u32(0);

struct Packet {
    lanes: [4]u32,
    out: u32,
    ok: bool,
}

fn step_mix(x: u32, y: u32) -> u32 {
    let a: u32 = wrapping_add_u32(x, y);
    let r: u32 = rotate_left_u32(a, 39);
    wrapping_sub_u32(r, count_ones_u32(r))
}

fn guard_and_mix<T>(tag: T, pkt: mut_view<Packet>, idx: usize) -> u32 {
    let _keep: T = tag;
    assert((*pkt).ok);
    let v0: u32 = (*pkt).lanes[idx];
    let v1: u32 = (*pkt).lanes[idx + 1];
    let rot: u32 = rotate_right_u32(v0, v1);
    let pop: u32 = count_ones_u32(rot);
    let lz: u32 = leading_zeros_u32((*pkt).lanes[0]);
    let tz: u32 = trailing_zeros_u32((*pkt).lanes[3]);
    (*pkt).out = step_mix(wrapping_add_u32(rot, pop), wrapping_add_u32(lz, tz));
    (*pkt).out
}

fn main() -> i32 {
    // 1. Verify const-evaluated intrinsic results.
    assert(C_WADD == 1);
    assert(C_WSUB == 4294967293);
    assert(C_WMUL == 0);
    assert(C_WNEG == 42);
    assert(C_ROTL == 3);
    assert(C_ROTR == 2147483649);
    assert(C_POP == 13);
    assert(C_CLZ == 32);
    assert(C_CTZ == 32);
    let rt_wneg: i32 = wrapping_neg_i32(-2147483647 - 1);
    assert(rt_wneg == -2147483647 - 1);

    // 2. Projected operands + generic caller + projected call destination.
    let mut pkt: Packet = Packet {
        lanes: [16, 4294967295, 36, 24],
        out: 0,
        ok: true,
    };
    let r1: u32 = guard_and_mix<i32>(7, mut_view(pkt), 1);
    let r2: u32 = guard_and_mix<bool>(true, mut_view(pkt), 1);
    assert(r1 == r2);
    assert(pkt.out == r1);
    assert(r1 == 7803);

    // 3. Untaken diverging intrinsics in control flow.
    if r1 == 0 {
        panic("unreachable branch");
    }
    if !pkt.ok {
        unreachable();
    }

    42
}
