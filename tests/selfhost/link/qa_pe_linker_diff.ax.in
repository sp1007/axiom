fn u64_words_to_coff_buf(words: view<[u64]>, byte_len: usize) -> CoffBuf {
    let n_words = len(words) as usize;
    let mut buf = coff_buf_with_capacity(n_words * 8);
    let dst64 = buf.ptr as *mut u64;
    let mut i: usize = 0;
    while i < n_words {
        unsafe {
            *(dst64 + i) = words[i];
        }
        i = i + 1;
    }
    buf.len = byte_len;
    buf
}

fn buf_matches_u64_words(buf: view<CoffBuf>, words: view<[u64]>, byte_len: usize) -> bool {
    if buf.len != byte_len {
        return false;
    }
    let n_words = len(words) as usize;
    let src64 = buf.ptr as *const u64;
    let mut i: usize = 0;
    while i < n_words {
        let actual = unsafe { *(src64 + i) };
        if actual != words[i] {
            return false;
        }
        i = i + 1;
    }
    true
}

fn read_file_to_coff_buf(path: Str) -> CoffBuf {
    let mut path_buf = pe_str_to_cstr_buf(path);
    let plen = path_buf.len - 1;
    let h = unsafe { open(path_buf.ptr as *const u8, plen, 0u32) };
    coff_buf_free(mut_view(path_buf));
    if h < 0 {
        return coff_buf_with_capacity(0);
    }
    let sz = file_size(h);
    if sz <= 0 {
        let _ = close(h);
        return coff_buf_with_capacity(0);
    }
    let usize_sz = sz as usize;
    let mut buf = coff_buf_with_capacity(usize_sz);
    let mut total_read: usize = 0;
    while total_read < usize_sz {
        let dst = unsafe { buf.ptr + total_read };
        let rem = usize_sz - total_read;
        let rd = unsafe { read(h, dst, rem) };
        if rd <= 0 {
            break;
        }
        total_read = total_read + (rd as usize);
    }
    buf.len = total_read;
    let _ = close(h);
    buf
}

fn delete_file_str(path: Str) {
    let mut path_buf = pe_str_to_cstr_buf(path);
    let plen = path_buf.len - 1;
    let _ = unsafe { remove(path_buf.ptr as *const u8, plen) };
    coff_buf_free(mut_view(path_buf));
}

// Spawns the linked .exe in native/native-O1 mode via mode=99u32 in __ax_host_open;
// in interpreter mode, host open returns -4 so we skip process execution cleanly.
fn run_linked_exe_str(path: Str) -> i64 {
    let mut path_buf = pe_str_to_cstr_buf(path);
    let plen = path_buf.len - 1;
    let rc = unsafe { open(path_buf.ptr as *const u8, plen, 99u32) };
    coff_buf_free(mut_view(path_buf));
    rc
}

// 1. Differential test against `tests/link/cdriver_pe.c` (`main42.exe` and `main42_bigstack.exe`)
fn test_cdriver_main42_and_bigstack_diff() -> i32 {
    let mut model = objmodel_new();
    let text_id = objmodel_add_section_str(mut_view(model), { ".text" }, AX_SEC_CODE, AX_SEC_FLAG_EXEC | AX_SEC_FLAG_READ, 16u32);
    let code: [6]u8 = [0xB8u8, 0x2Au8, 0x00u8, 0x00u8, 0x00u8, 0xC3u8];
    objmodel_section_append_slice(mut_view(model), SectionId { v: text_id.v }, view(code));
    let _ = objmodel_add_symbol_str(mut_view(model), { "main" }, SectionId { v: text_id.v }, 0u64, 6u64, AX_SYM_GLOBAL);

    let mut sink = DiagSink {
        arena: arena_new(),
        diags: 0 as *mut Diagnostic,
        len: 0, cap: 0, errors: 0, warnings: 0,
    };

    // 1a. main42.exe (stack_reserve = 0 -> defaults to PE_DEFAULT_STACK_RESERVE = 0x100000)
    let mut exe_buf1 = coff_buf_new();
    if !pe_link_objmodel_to_buf(view(model), 0u32, mut_view(exe_buf1), sink_ptr(mut_view(sink))) {
        coff_buf_free(mut_view(exe_buf1));
        diag_sink_free(mut_view(sink));
        objmodel_free(mut_view(model));
        return 10;
    }
    let exp_main42 = EXPECTED_MAIN42_EXE_WORDS;
    if !buf_matches_u64_words(view(exe_buf1), view(exp_main42), EXPECTED_MAIN42_EXE_LEN) {
        coff_buf_free(mut_view(exe_buf1));
        diag_sink_free(mut_view(sink));
        objmodel_free(mut_view(model));
        return 11;
    }
    coff_buf_free(mut_view(exe_buf1));

    // 1b. main42_bigstack.exe (stack_reserve = 67108864)
    let mut exe_buf2 = coff_buf_new();
    if !pe_link_objmodel_to_buf(view(model), 67108864u32, mut_view(exe_buf2), sink_ptr(mut_view(sink))) {
        coff_buf_free(mut_view(exe_buf2));
        diag_sink_free(mut_view(sink));
        objmodel_free(mut_view(model));
        return 12;
    }
    let exp_bigstack = EXPECTED_MAIN42_BIGSTACK_EXE_WORDS;
    if !buf_matches_u64_words(view(exe_buf2), view(exp_bigstack), EXPECTED_MAIN42_BIGSTACK_EXE_LEN) {
        coff_buf_free(mut_view(exe_buf2));
        diag_sink_free(mut_view(sink));
        objmodel_free(mut_view(model));
        return 13;
    }
    coff_buf_free(mut_view(exe_buf2));

    diag_sink_free(mut_view(sink));
    objmodel_free(mut_view(model));
    0
}

// 2. Differential test against `axiom0` linked executables for `ret42.obj` and `calls.obj`
fn test_axiom0_ret42_and_calls_exe_diff() -> i32 {
    let mut sink = DiagSink {
        arena: arena_new(),
        diags: 0 as *mut Diagnostic,
        len: 0, cap: 0, errors: 0, warnings: 0,
    };

    // 2a. ret42.obj -> ret42.exe
    let ret42_obj_words = EXPECTED_RET42_OBJ_WORDS;
    let mut ret42_obj = u64_words_to_coff_buf(view(ret42_obj_words), EXPECTED_RET42_OBJ_LEN);
    let mut ret42_exe = coff_buf_new();
    let ok_ret42 = pe_link_single_coff_to_buf(ret42_obj.ptr as *const u8, ret42_obj.len, 0x100000u32, mut_view(ret42_exe), sink_ptr(mut_view(sink)));
    coff_buf_free(mut_view(ret42_obj));
    if !ok_ret42 {
        coff_buf_free(mut_view(ret42_exe));
        diag_sink_free(mut_view(sink));
        return 20;
    }
    let exp_ret42_exe = EXPECTED_RET42_EXE_WORDS;
    if !buf_matches_u64_words(view(ret42_exe), view(exp_ret42_exe), EXPECTED_RET42_EXE_LEN) {
        coff_buf_free(mut_view(ret42_exe));
        diag_sink_free(mut_view(sink));
        return 21;
    }
    coff_buf_free(mut_view(ret42_exe));

    // 2b. calls.obj -> calls.exe
    let calls_obj_words = EXPECTED_CALLS_OBJ_WORDS;
    let mut calls_obj = u64_words_to_coff_buf(view(calls_obj_words), EXPECTED_CALLS_OBJ_LEN);
    let mut calls_exe = coff_buf_new();
    let ok_calls = pe_link_single_coff_to_buf(calls_obj.ptr as *const u8, calls_obj.len, 0x100000u32, mut_view(calls_exe), sink_ptr(mut_view(sink)));
    coff_buf_free(mut_view(calls_obj));
    if !ok_calls {
        coff_buf_free(mut_view(calls_exe));
        diag_sink_free(mut_view(sink));
        return 22;
    }
    let exp_calls_exe = EXPECTED_CALLS_EXE_WORDS;
    if !buf_matches_u64_words(view(calls_exe), view(exp_calls_exe), EXPECTED_CALLS_EXE_LEN) {
        coff_buf_free(mut_view(calls_exe));
        diag_sink_free(mut_view(sink));
        return 23;
    }
    coff_buf_free(mut_view(calls_exe));

    diag_sink_free(mut_view(sink));
    0
}

// 3. Multi-object linking with .text, .data, .rdata, .bss and Windows execution
fn test_multi_object_link_and_exec() -> i32 {
    let mut obj_a = objmodel_new();
    let a_text = objmodel_add_section_str(mut_view(obj_a), { ".text" }, AX_SEC_CODE, AX_SEC_FLAG_EXEC | AX_SEC_FLAG_READ, 16u32);
    let a_data = objmodel_add_section_str(mut_view(obj_a), { ".data" }, AX_SEC_DATA, AX_SEC_FLAG_READ | AX_SEC_FLAG_WRITE, 4u32);
    let a_rdata = objmodel_add_section_str(mut_view(obj_a), { ".rdata" }, AX_SEC_RODATA, AX_SEC_FLAG_READ, 4u32);
    let a_bss = objmodel_add_section_str(mut_view(obj_a), { ".bss" }, AX_SEC_BSS, AX_SEC_FLAG_READ | AX_SEC_FLAG_WRITE, 8u32);

    let data_35: [4]u8 = [35u8, 0u8, 0u8, 0u8];
    objmodel_section_append_slice(mut_view(obj_a), SectionId { v: a_data.v }, view(data_35));
    let _ = objmodel_add_symbol_str(mut_view(obj_a), { "global_base" }, SectionId { v: a_data.v }, 0u64, 4u64, AX_SYM_GLOBAL);

    let rdata_7: [4]u8 = [7u8, 0u8, 0u8, 0u8];
    objmodel_section_append_slice(mut_view(obj_a), SectionId { v: a_rdata.v }, view(rdata_7));
    let a_local = objmodel_add_symbol_str(mut_view(obj_a), { "local_const" }, SectionId { v: a_rdata.v }, 0u64, 4u64, AX_SYM_LOCAL);
    let _ = objmodel_add_symbol_str(mut_view(obj_a), { "bss_slot" }, SectionId { v: a_bss.v }, 0u64, 8u64, AX_SYM_GLOBAL);

    // sub rsp, 40 ; call compute_val ; add eax, [rip + local_const] ; add rsp, 40 ; ret
    let a_code: [20]u8 = [
        0x48u8, 0x83u8, 0xECu8, 0x28u8,
        0xE8u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
        0x03u8, 0x05u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
        0x48u8, 0x83u8, 0xC4u8, 0x28u8,
        0xC3u8,
    ];
    objmodel_section_append_slice(mut_view(obj_a), SectionId { v: a_text.v }, view(a_code));
    let sym_compute_ext = objmodel_add_symbol_str(mut_view(obj_a), { "compute_val" }, SectionId.none(), 0u64, 0u64, AX_SYM_EXTERNAL);
    objmodel_section_add_reloc(mut_view(obj_a), SectionId { v: a_text.v }, 5u32, AX_RELOC_X86_64_PC32, SymbolId { v: sym_compute_ext.v }, -4i64);
    objmodel_section_add_reloc(mut_view(obj_a), SectionId { v: a_text.v }, 11u32, AX_RELOC_X86_64_PC32, SymbolId { v: a_local.v }, -4i64);
    let _ = objmodel_add_symbol_str(mut_view(obj_a), { "main" }, SectionId { v: a_text.v }, 0u64, 20u64, AX_SYM_GLOBAL);

    let mut obj_b = objmodel_new();
    let b_text = objmodel_add_section_str(mut_view(obj_b), { ".text" }, AX_SEC_CODE, AX_SEC_FLAG_EXEC | AX_SEC_FLAG_READ, 16u32);
    let b_rdata = objmodel_add_section_str(mut_view(obj_b), { ".rdata" }, AX_SEC_RODATA, AX_SEC_FLAG_READ, 4u32);
    let rdata_100: [4]u8 = [100u8, 0u8, 0u8, 0u8];
    objmodel_section_append_slice(mut_view(obj_b), SectionId { v: b_rdata.v }, view(rdata_100));
    let _ = objmodel_add_symbol_str(mut_view(obj_b), { "local_const" }, SectionId { v: b_rdata.v }, 0u64, 4u64, AX_SYM_LOCAL);

    // mov eax, [rip + global_base] ; ret
    let b_code: [7]u8 = [
        0x8Bu8, 0x05u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
        0xC3u8,
    ];
    objmodel_section_append_slice(mut_view(obj_b), SectionId { v: b_text.v }, view(b_code));
    let sym_global_base_ext = objmodel_add_symbol_str(mut_view(obj_b), { "global_base" }, SectionId.none(), 0u64, 0u64, AX_SYM_EXTERNAL);
    objmodel_section_add_reloc(mut_view(obj_b), SectionId { v: b_text.v }, 2u32, AX_RELOC_X86_64_PC32, SymbolId { v: sym_global_base_ext.v }, -4i64);
    let _ = objmodel_add_symbol_str(mut_view(obj_b), { "compute_val" }, SectionId { v: b_text.v }, 0u64, 7u64, AX_SYM_GLOBAL);

    let mut coff_a = coff_encode_bytes(view(obj_a));
    let mut coff_b = coff_encode_bytes(view(obj_b));
    objmodel_free(mut_view(obj_a));
    objmodel_free(mut_view(obj_b));

    let ptrs: [2]*const u8 = [coff_a.ptr as *const u8, coff_b.ptr as *const u8];
    let lens: [2]usize = [coff_a.len, coff_b.len];
    let pptrs = unsafe { address_of(ptrs[0]) };
    let plens = unsafe { address_of(lens[0]) };

    let mut sink = DiagSink {
        arena: arena_new(),
        diags: 0 as *mut Diagnostic,
        len: 0, cap: 0, errors: 0, warnings: 0,
    };
    let mut multi_exe = coff_buf_new();
    let ok = pe_link_coff_buffers_to_buf(pptrs, plens, 2, 0x100000u32, mut_view(multi_exe), sink_ptr(mut_view(sink)));
    coff_buf_free(mut_view(coff_a));
    coff_buf_free(mut_view(coff_b));

    if !ok || diag_sink_has_errors(view(sink)) {
        coff_buf_free(mut_view(multi_exe));
        diag_sink_free(mut_view(sink));
        return 30;
    }

    // Verify PE32+ headers of multi_exe (.text, .data, .rdata, .bss, .idata = 5 sections)
    let p = multi_exe.ptr as *const u8;
    let mut lfanew: u32 = 0u32;
    if !pe_decode_dos_header(p, multi_exe.len, mut_view(lfanew)) || lfanew != 64u32 || !pe_check_signature(p, 64, multi_exe.len) {
        coff_buf_free(mut_view(multi_exe));
        diag_sink_free(mut_view(sink));
        return 31;
    }
    let fhdr = coff_decode_file_header(p, 68);
    if fhdr.number_of_sections != 5u16 {
        coff_buf_free(mut_view(multi_exe));
        diag_sink_free(mut_view(sink));
        return 32;
    }

    // Write multi_exe to disk and execute on Windows (in native/native-O1 mode)
    delete_file_str({ "tmp_t085b_multi.exe" });
    if !pe_write_buf_to_file_str(view(multi_exe), { "tmp_t085b_multi.exe" }) {
        coff_buf_free(mut_view(multi_exe));
        diag_sink_free(mut_view(sink));
        return 33;
    }
    let rc_exec = run_linked_exe_str({ "tmp_t085b_multi.exe" });
    delete_file_str({ "tmp_t085b_multi.exe" });
    if rc_exec != -4 && rc_exec != 42 {
        coff_buf_free(mut_view(multi_exe));
        diag_sink_free(mut_view(sink));
        return 34;
    }

    coff_buf_free(mut_view(multi_exe));
    diag_sink_free(mut_view(sink));
    0
}

// 4. On-disk roundtrip via `pe_link_one_file_str` and Windows execution of linked executables
fn test_disk_roundtrip_and_windows_exec() -> i32 {
    let main42_obj_words = EXPECTED_MAIN42_OBJ_WORDS;
    let mut obj_buf = u64_words_to_coff_buf(view(main42_obj_words), EXPECTED_MAIN42_OBJ_LEN);

    delete_file_str({ "tmp_t085b_main42.obj" });
    delete_file_str({ "tmp_t085b_main42.exe" });
    if !pe_write_buf_to_file_str(view(obj_buf), { "tmp_t085b_main42.obj" }) {
        coff_buf_free(mut_view(obj_buf));
        return 40;
    }
    coff_buf_free(mut_view(obj_buf));

    let mut sink = DiagSink {
        arena: arena_new(),
        diags: 0 as *mut Diagnostic,
        len: 0, cap: 0, errors: 0, warnings: 0,
    };
    if !pe_link_one_file_str({ "tmp_t085b_main42.obj" }, { "tmp_t085b_main42.exe" }, 0x100000u32, sink_ptr(mut_view(sink))) {
        diag_sink_free(mut_view(sink));
        delete_file_str({ "tmp_t085b_main42.obj" });
        return 41;
    }
    diag_sink_free(mut_view(sink));

    let mut disk_exe = read_file_to_coff_buf({ "tmp_t085b_main42.exe" });
    let exp_main42 = EXPECTED_MAIN42_EXE_WORDS;
    let matches = buf_matches_u64_words(view(disk_exe), view(exp_main42), EXPECTED_MAIN42_EXE_LEN);
    coff_buf_free(mut_view(disk_exe));
    if !matches {
        delete_file_str({ "tmp_t085b_main42.obj" });
        delete_file_str({ "tmp_t085b_main42.exe" });
        return 42;
    }

    let rc_main42 = run_linked_exe_str({ "tmp_t085b_main42.exe" });
    delete_file_str({ "tmp_t085b_main42.obj" });
    delete_file_str({ "tmp_t085b_main42.exe" });
    if rc_main42 != -4 && rc_main42 != 42 {
        return 43;
    }

    0
}

pub fn main() -> i32 {
    let rc1 = test_cdriver_main42_and_bigstack_diff();
    if rc1 != 0 { return rc1; }

    let rc2 = test_axiom0_ret42_and_calls_exe_diff();
    if rc2 != 0 { return rc2; }

    let rc3 = test_multi_object_link_and_exec();
    if rc3 != 0 { return rc3; }

    let rc4 = test_disk_roundtrip_and_windows_exec();
    if rc4 != 0 { return rc4; }

    print("OK PE Linker Differential & Execution\n");
    0
}
