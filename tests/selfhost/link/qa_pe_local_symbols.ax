module host_sys_heap
@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapReAlloc(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}
pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if (h as usize) == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}
pub unsafe fn __ax_host_heap_realloc(p: *mut u8, old_size: usize, new_size: usize, align: usize) -> *mut u8 {
    if (p as usize) == 0 { return __ax_host_heap_alloc(new_size, align); }
    let h = GetProcessHeap();
    if (h as usize) == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if new_size < 16 { 16 } else { new_size };
    HeapReAlloc(h, 8u32, p, alloc_bytes)
}
pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if (p as usize) != 0 {
        let h = GetProcessHeap();
        if (h as usize) != 0 { HeapFree(h, 0u32, p); }
    }
}

module host_sys_io

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
    fn GetStdHandle(nStdHandle: u32) -> *mut u8;
    fn GetConsoleMode(hConsoleHandle: *mut u8, lpMode: *mut u32) -> i32;
    fn WriteConsoleW(hConsoleOutput: *mut u8, lpBuffer: *const u16, nNumberOfCharsToWrite: u32, lpNumberOfCharsWritten: *mut u32, lpReserved: *mut u8) -> i32;
    fn WriteFile(hFile: *mut u8, lpBuffer: *const u8, nNumberOfBytesToWrite: u32, lpNumberOfBytesWritten: *mut u32, lpOverlapped: *mut u8) -> i32;
    fn ReadFile(hFile: *mut u8, lpBuffer: *mut u8, nNumberOfBytesToRead: u32, lpNumberOfBytesRead: *mut u32, lpOverlapped: *mut u8) -> i32;
    fn CreateFileW(lpFileName: *const u16, dwDesiredAccess: u32, dwShareMode: u32, lpSecurityAttributes: *mut u8, dwCreationDisposition: u32, dwFlagsAndAttributes: u32, hTemplateFile: *mut u8) -> *mut u8;
    fn CloseHandle(hObject: *mut u8) -> i32;
    fn GetFileSizeEx(hFile: *mut u8, lpFileSize: *mut i64) -> i32;
    fn SetFilePointer(hFile: *mut u8, lDistanceToMove: i32, lpDistanceToMoveHigh: *mut i32, dwMoveMethod: u32) -> u32;
    fn GetEnvironmentVariableW(lpName: *const u16, lpBuffer: *mut u16, nSize: u32) -> u32;
    fn SetEnvironmentVariableW(lpName: *const u16, lpValue: *const u16) -> i32;
    fn GetLastError() -> u32;
}

@intrinsic pub unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

unsafe fn get_file_table() -> *mut u8 {
    let mut vname: [6]u16 = [65u16, 88u16, 95u16, 70u16, 84u16, 0u16];
    let pvname = address_of_mut(vname[0]);
    let mut val: [32]u16 = [0u16; 32];
    let pval = address_of_mut(val[0]);
    let vlen = GetEnvironmentVariableW(pvname, pval, 32);
    if vlen > 0 {
        let mut ptr_val: usize = 0;
        let mut idx: usize = 0;
        while idx < vlen as usize {
            let ch = val[idx];
            let mut digit: usize = 0;
            if ch >= 48u16 && ch <= 57u16 {
                digit = (ch - 48u16) as usize;
            } else if ch >= 97u16 && ch <= 102u16 {
                digit = (ch - 97u16 + 10u16) as usize;
            } else if ch >= 65u16 && ch <= 70u16 {
                digit = (ch - 65u16 + 10u16) as usize;
            }
            ptr_val = (ptr_val << 4) | digit;
            idx = idx + 1;
        }
        return ptr_val as *mut u8;
    }

    let tbl = HeapAlloc(GetProcessHeap(), 8u32, 4096);
    if tbl as usize == 0 {
        return 0 as *mut u8;
    }

    let mut sval: [17]u16 = [0u16; 17];
    let mut cur: usize = tbl as usize;
    let mut pos: usize = 16;
    sval[pos] = 0u16;
    while pos > 0 {
        pos = pos - 1;
        let nibble = (cur & 0x0F) as u16;
        if nibble < 10u16 {
            sval[pos] = 48u16 + nibble;
        } else {
            sval[pos] = 97u16 + (nibble - 10u16);
        }
        cur = cur >> 4;
    }
    SetEnvironmentVariableW(pvname, address_of_mut(sval[0]));
    tbl
}

pub fn __ax_host_stdio(which: u32) -> i64 {
    if which <= 2u32 {
        which as i64
    } else {
        -4i64
    }
}

pub unsafe fn __ax_host_open(path: *const u8, path_len: usize, mode: u32) -> i64 {
    let mut wpath_buf: [1024]u16 = [0u16; 1024];
    let mut in_pos: usize = 0;
    let mut out_pos: usize = 0;
    while in_pos < path_len && out_pos + 2 < 1024 {
        let b0 = *(path + in_pos) as u32;
        let mut cp: u32 = 0;
        let mut step: usize = 1;
        if b0 < 0x80 {
            cp = b0;
            step = 1;
        } else if (b0 & 0xE0) == 0xC0 && in_pos + 1 < path_len {
            let b1 = *(path + in_pos + 1) as u32;
            cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F);
            step = 2;
        } else if (b0 & 0xF0) == 0xE0 && in_pos + 2 < path_len {
            let b1 = *(path + in_pos + 1) as u32;
            let b2 = *(path + in_pos + 2) as u32;
            cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F);
            step = 3;
        } else if (b0 & 0xF8) == 0xF0 && in_pos + 3 < path_len {
            let b1 = *(path + in_pos + 1) as u32;
            let b2 = *(path + in_pos + 2) as u32;
            let b3 = *(path + in_pos + 3) as u32;
            cp = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F);
            step = 4;
        } else {
            cp = 0xFFFD;
            step = 1;
        }
        in_pos = in_pos + step;

        if cp <= 0xFFFF {
            wpath_buf[out_pos] = cp as u16;
            out_pos = out_pos + 1;
        } else {
            wpath_buf[out_pos] = (0xD800 + ((cp - 0x10000) >> 10)) as u16;
            wpath_buf[out_pos + 1] = (0xDC00 + ((cp - 0x10000) & 0x3FF)) as u16;
            out_pos = out_pos + 2;
        }
    }
    wpath_buf[out_pos] = 0u16;

    let mut desired_access: u32 = 0;
    let mut creation_disposition: u32 = 0;
    if mode == 0u32 {
        desired_access = 0x80000000u32; // GENERIC_READ
        creation_disposition = 3u32;     // OPEN_EXISTING
    } else if mode == 1u32 {
        desired_access = 0x40000000u32 | 0x80000000u32; // GENERIC_WRITE | GENERIC_READ
        creation_disposition = 2u32;     // CREATE_ALWAYS
    } else if mode == 2u32 {
        desired_access = 4u32 | 0x80000000u32;          // FILE_APPEND_DATA | GENERIC_READ
        creation_disposition = 4u32;     // OPEN_ALWAYS
    } else {
        return -4;
    }

    let share_mode = 1u32 | 2u32 | 4u32; // FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE
    let flags_attr = 0x80u32;            // FILE_ATTRIBUTE_NORMAL
    let pwpath = address_of_mut(wpath_buf[0]);
    let h = CreateFileW(pwpath, desired_access, share_mode, 0 as *mut u8, creation_disposition, flags_attr, 0 as *mut u8);

    if h as usize == 0xFFFFFFFFFFFFFFFF {
        let err = GetLastError();
        if err == 2u32 || err == 3u32 { return -1; }
        if err == 5u32 { return -2; }
        if err == 80u32 || err == 183u32 { return -3; }
        return -9;
    }

    let tbl = get_file_table();
    if tbl as usize == 0 {
        CloseHandle(h);
        return -9;
    }

    let mut slot: usize = 3;
    let mut found_slot: usize = 0;
    while slot < 256 {
        let is_open_ptr = (tbl as usize + slot * 16 + 8) as *mut u32;
        if *is_open_ptr == 0u32 {
            found_slot = slot;
            break;
        }
        slot = slot + 1;
    }

    if found_slot == 0 {
        CloseHandle(h);
        return -9;
    }

    let h_ptr = (tbl as usize + found_slot * 16) as *mut *mut u8;
    let is_open_ptr = (tbl as usize + found_slot * 16 + 8) as *mut u32;
    *h_ptr = h;
    *is_open_ptr = 1u32;

    if mode == 2u32 {
        SetFilePointer(h, 0, 0 as *mut i32, 2u32); // FILE_END
    }

    found_slot as i64
}

pub unsafe fn __ax_host_read(h: i64, buf: *mut u8, cap: usize) -> i64 {
    if cap == 0 {
        return 0;
    }

    let mut win_h: *mut u8 = 0 as *mut u8;
    if h == 0 {
        win_h = GetStdHandle(0xFFFFFFF6u32); // STD_INPUT_HANDLE
    } else if h >= 3 && h < 256 {
        let tbl = get_file_table();
        if tbl as usize == 0 { return -4; }
        let is_open = *((tbl as usize + (h as usize) * 16 + 8) as *mut u32);
        if is_open == 0u32 { return -4; }
        win_h = *((tbl as usize + (h as usize) * 16) as *mut *mut u8);
    } else {
        return -4;
    }

    let mut read_bytes: [1]u32 = [0u32];
    let ok = ReadFile(win_h, buf, cap as u32, address_of_mut(read_bytes[0]), 0 as *mut u8);
    if ok == 0 {
        let err = GetLastError();
        if err == 38u32 || err == 109u32 {
            return 0;
        }
        return -9;
    }

    read_bytes[0] as i64
}

pub unsafe fn __ax_host_write(h: i64, p: *const u8, count: usize) -> i64 {
    if count == 0 {
        return 0;
    }

    let mut win_h: *mut u8 = 0 as *mut u8;
    let mut is_stdio: bool = false;
    if h == 1 {
        win_h = GetStdHandle(0xFFFFFFF5u32); // STD_OUTPUT_HANDLE
        is_stdio = true;
    } else if h == 2 {
        win_h = GetStdHandle(0xFFFFFFF4u32); // STD_ERROR_HANDLE
        is_stdio = true;
    } else if h == 0 {
        win_h = GetStdHandle(0xFFFFFFF6u32); // STD_INPUT_HANDLE
        is_stdio = true;
    } else if h >= 3 && h < 256 {
        let tbl = get_file_table();
        if tbl as usize == 0 { return -4; }
        let is_open = *((tbl as usize + (h as usize) * 16 + 8) as *mut u32);
        if is_open == 0u32 { return -4; }
        win_h = *((tbl as usize + (h as usize) * 16) as *mut *mut u8);
    } else {
        return -4;
    }

    if is_stdio {
        let mut mode: [1]u32 = [0u32];
        if GetConsoleMode(win_h, address_of_mut(mode[0])) != 0 {
            let mut wbuf: [512]u16 = [0u16; 512];
            let mut in_pos: usize = 0;
            let mut out_pos: usize = 0;
            while in_pos < count {
                let b0 = *(p + in_pos) as u32;
                let mut cp: u32 = 0;
                let mut step: usize = 1;
                if b0 < 0x80 {
                    cp = b0;
                    step = 1;
                } else if (b0 & 0xE0) == 0xC0 && in_pos + 1 < count {
                    let b1 = *(p + in_pos + 1) as u32;
                    cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F);
                    step = 2;
                } else if (b0 & 0xF0) == 0xE0 && in_pos + 2 < count {
                    let b1 = *(p + in_pos + 1) as u32;
                    let b2 = *(p + in_pos + 2) as u32;
                    cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F);
                    step = 3;
                } else if (b0 & 0xF8) == 0xF0 && in_pos + 3 < count {
                    let b1 = *(p + in_pos + 1) as u32;
                    let b2 = *(p + in_pos + 2) as u32;
                    let b3 = *(p + in_pos + 3) as u32;
                    cp = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F);
                    step = 4;
                } else {
                    cp = 0xFFFD;
                    step = 1;
                }
                in_pos = in_pos + step;

                if cp <= 0xFFFF {
                    wbuf[out_pos] = cp as u16;
                    out_pos = out_pos + 1;
                } else {
                    wbuf[out_pos] = (0xD800 + ((cp - 0x10000) >> 10)) as u16;
                    wbuf[out_pos + 1] = (0xDC00 + ((cp - 0x10000) & 0x3FF)) as u16;
                    out_pos = out_pos + 2;
                }
            }
            let mut wwritten: [1]u32 = [0u32];
            WriteConsoleW(win_h, address_of_mut(wbuf[0]) as *const u16, out_pos as u32, address_of_mut(wwritten[0]), 0 as *mut u8);
            return count as i64;
        }
    }

    let mut written: [1]u32 = [0u32];
    let ok = WriteFile(win_h, p, count as u32, address_of_mut(written[0]), 0 as *mut u8);
    if ok == 0 {
        return -9;
    }
    written[0] as i64
}

pub fn __ax_host_close(h: i64) -> i64 {
    if h >= 0 && h <= 2 {
        return 0;
    }
    if h >= 3 && h < 256 {
        let tbl = unsafe { get_file_table() };
        if tbl as usize == 0 { return -4; }
        let is_open_ptr = (tbl as usize + (h as usize) * 16 + 8) as *mut u32;
        let is_open = unsafe { *is_open_ptr };
        if is_open == 0u32 { return -4; }
        let h_ptr = (tbl as usize + (h as usize) * 16) as *mut *mut u8;
        let win_h = unsafe { *h_ptr };
        unsafe {
            CloseHandle(win_h);
            *is_open_ptr = 0u32;
            *h_ptr = 0 as *mut u8;
        }
        return 0;
    }
    -4
}

pub fn __ax_host_file_size(h: i64) -> i64 {
    if h < 3 || h >= 256 {
        return -4;
    }
    let tbl = unsafe { get_file_table() };
    if tbl as usize == 0 { return -4; }
    let is_open = unsafe { *((tbl as usize + (h as usize) * 16 + 8) as *mut u32) };
    if is_open == 0u32 { return -4; }
    let win_h = unsafe { *((tbl as usize + (h as usize) * 16) as *mut *mut u8) };

    let mut sz: [1]i64 = [0i64];
    let ok = unsafe { GetFileSizeEx(win_h, address_of_mut(sz[0])) };
    if ok == 0 {
        return -9;
    }
    sz[0]
}

module host_sys_fs

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
    fn CreateDirectoryW(lpPathName: *const u16, lpSecurityAttributes: *mut u8) -> i32;
    fn DeleteFileW(lpFileName: *const u16) -> i32;
    fn RemoveDirectoryW(lpPathName: *const u16) -> i32;
    fn GetFileAttributesExW(lpFileName: *const u16, fInfoLevelId: u32, lpFileInformation: *mut u8) -> i32;
    fn FindFirstFileW(lpFileName: *const u16, lpFindFileData: *mut u8) -> *mut u8;
    fn FindNextFileW(hFindFile: *mut u8, lpFindFileData: *mut u8) -> i32;
    fn FindClose(hFindFile: *mut u8) -> i32;
    fn GetEnvironmentVariableW(lpName: *const u16, lpBuffer: *mut u16, nSize: u32) -> u32;
    fn SetEnvironmentVariableW(lpName: *const u16, lpValue: *const u16) -> i32;
    fn GetLastError() -> u32;
}

@intrinsic pub unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

unsafe fn utf8_to_wpath(path: *const u8, path_len: usize, wpath: *mut u16, cap: usize) -> usize {
    let mut in_pos: usize = 0;
    let mut out_pos: usize = 0;
    while in_pos < path_len && out_pos + 2 < cap {
        let b0 = *(path + in_pos) as u32;
        let mut cp: u32 = 0;
        let mut step: usize = 1;
        if b0 < 0x80 {
            cp = b0;
            step = 1;
        } else if (b0 & 0xE0) == 0xC0 && in_pos + 1 < path_len {
            let b1 = *(path + in_pos + 1) as u32;
            cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F);
            step = 2;
        } else if (b0 & 0xF0) == 0xE0 && in_pos + 2 < path_len {
            let b1 = *(path + in_pos + 1) as u32;
            let b2 = *(path + in_pos + 2) as u32;
            cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F);
            step = 3;
        } else if (b0 & 0xF8) == 0xF0 && in_pos + 3 < path_len {
            let b1 = *(path + in_pos + 1) as u32;
            let b2 = *(path + in_pos + 2) as u32;
            let b3 = *(path + in_pos + 3) as u32;
            cp = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F);
            step = 4;
        } else {
            cp = 0xFFFD;
            step = 1;
        }
        in_pos = in_pos + step;

        if cp <= 0xFFFF {
            *(wpath + out_pos) = cp as u16;
            out_pos = out_pos + 1;
        } else {
            *(wpath + out_pos) = (0xD800 + ((cp - 0x10000) >> 10)) as u16;
            *(wpath + out_pos + 1) = (0xDC00 + ((cp - 0x10000) & 0x3FF)) as u16;
            out_pos = out_pos + 2;
        }
    }
    *(wpath + out_pos) = 0u16;
    out_pos
}

unsafe fn utf16_null_len(ptr: *const u16) -> usize {
    let mut count: usize = 0;
    while *(ptr + count) != 0u16 {
        count = count + 1;
    }
    count
}

unsafe fn wchars_to_utf8(wchars: *const u16, wlen: usize, buf: *mut u8, cap: usize) -> usize {
    let mut u8_len: usize = 0;
    let mut w_idx: usize = 0;
    while w_idx < wlen {
        let u0 = *(wchars + w_idx) as u32;
        let mut cp: u32 = 0;
        if u0 >= 0xD800 && u0 <= 0xDBFF && w_idx + 1 < wlen {
            let u1 = *(wchars + w_idx + 1) as u32;
            if u1 >= 0xDC00 && u1 <= 0xDFFF {
                cp = 0x10000 + (((u0 - 0xD800) << 10) | (u1 - 0xDC00));
                w_idx = w_idx + 2;
            } else {
                cp = 0xFFFD;
                w_idx = w_idx + 1;
            }
        } else if u0 >= 0xD800 && u0 <= 0xDFFF {
            cp = 0xFFFD;
            w_idx = w_idx + 1;
        } else {
            cp = u0;
            w_idx = w_idx + 1;
        }

        if cp <= 0x7F {
            if u8_len < cap { *(buf + u8_len) = cp as u8; }
            u8_len = u8_len + 1;
        } else if cp <= 0x7FF {
            if u8_len < cap { *(buf + u8_len) = (0xC0 | (cp >> 6)) as u8; }
            if u8_len + 1 < cap { *(buf + u8_len + 1) = (0x80 | (cp & 0x3F)) as u8; }
            u8_len = u8_len + 2;
        } else if cp <= 0xFFFF {
            if u8_len < cap { *(buf + u8_len) = (0xE0 | (cp >> 12)) as u8; }
            if u8_len + 1 < cap { *(buf + u8_len + 1) = (0x80 | ((cp >> 6) & 0x3F)) as u8; }
            if u8_len + 2 < cap { *(buf + u8_len + 2) = (0x80 | (cp & 0x3F)) as u8; }
            u8_len = u8_len + 3;
        } else {
            if u8_len < cap { *(buf + u8_len) = (0xF0 | (cp >> 18)) as u8; }
            if u8_len + 1 < cap { *(buf + u8_len + 1) = (0x80 | ((cp >> 12) & 0x3F)) as u8; }
            if u8_len + 2 < cap { *(buf + u8_len + 2) = (0x80 | ((cp >> 6) & 0x3F)) as u8; }
            if u8_len + 3 < cap { *(buf + u8_len + 3) = (0x80 | (cp & 0x3F)) as u8; }
            u8_len = u8_len + 4;
        }
    }
    u8_len
}

unsafe fn get_dir_table() -> *mut u8 {
    let mut vname: [6]u16 = [65u16, 88u16, 95u16, 68u16, 84u16, 0u16]; // "AX_DT\0"
    let pvname = address_of_mut(vname[0]);
    let mut val: [32]u16 = [0u16; 32];
    let pval = address_of_mut(val[0]);
    let vlen = GetEnvironmentVariableW(pvname, pval, 32);
    if vlen > 0 {
        let mut ptr_val: usize = 0;
        let mut idx: usize = 0;
        while idx < vlen as usize {
            let ch = val[idx];
            let mut digit: usize = 0;
            if ch >= 48u16 && ch <= 57u16 {
                digit = (ch - 48u16) as usize;
            } else if ch >= 97u16 && ch <= 102u16 {
                digit = (ch - 97u16 + 10u16) as usize;
            } else if ch >= 65u16 && ch <= 70u16 {
                digit = (ch - 65u16 + 10u16) as usize;
            }
            ptr_val = (ptr_val << 4) | digit;
            idx = idx + 1;
        }
        return ptr_val as *mut u8;
    }

    let tbl = HeapAlloc(GetProcessHeap(), 8u32, 40000);
    if tbl as usize == 0 {
        return 0 as *mut u8;
    }

    let mut sval: [17]u16 = [0u16; 17];
    let mut cur: usize = tbl as usize;
    let mut pos: usize = 16;
    sval[pos] = 0u16;
    while pos > 0 {
        pos = pos - 1;
        let nibble = (cur & 0x0F) as u16;
        if nibble < 10u16 {
            sval[pos] = 48u16 + nibble;
        } else {
            sval[pos] = 97u16 + (nibble - 10u16);
        }
        cur = cur >> 4;
    }
    SetEnvironmentVariableW(pvname, address_of_mut(sval[0]));
    tbl
}

pub unsafe fn __ax_host_remove(path: *const u8, path_len: usize) -> i64 {
    let mut wpath_buf: [1024]u16 = [0u16; 1024];
    let pwpath = address_of_mut(wpath_buf[0]);
    utf8_to_wpath(path, path_len, pwpath, 1024);
    if DeleteFileW(pwpath) != 0 {
        return 0;
    }
    let mut err = GetLastError();
    if err == 5u32 {
        if RemoveDirectoryW(pwpath) != 0 {
            return 0;
        }
        err = GetLastError();
    }
    if err == 2u32 || err == 3u32 { return -1; }
    if err == 5u32 { return -2; }
    -9
}

pub unsafe fn __ax_host_mkdir(path: *const u8, path_len: usize) -> i64 {
    let mut wpath_buf: [1024]u16 = [0u16; 1024];
    let pwpath = address_of_mut(wpath_buf[0]);
    utf8_to_wpath(path, path_len, pwpath, 1024);
    if CreateDirectoryW(pwpath, 0 as *mut u8) != 0 {
        return 0;
    }
    let err = GetLastError();
    if err == 183u32 { return -3; }
    if err == 3u32 { return -1; }
    if err == 5u32 { return -2; }
    -9
}

pub unsafe fn __ax_host_metadata(path: *const u8, path_len: usize, out: *mut u64) -> i64 {
    let mut wpath_buf: [1024]u16 = [0u16; 1024];
    let pwpath = address_of_mut(wpath_buf[0]);
    utf8_to_wpath(path, path_len, pwpath, 1024);

    let mut data: [10]u32 = [0u32; 10];
    let pdata = address_of_mut(data[0]) as *mut u8;
    if GetFileAttributesExW(pwpath, 0u32, pdata) == 0 {
        let err = GetLastError();
        if err == 2u32 || err == 3u32 { return -1; }
        if err == 5u32 { return -2; }
        return -9;
    }
    let attrs = data[0];
    let mut kind: u64 = 1;
    if (attrs & 0x10u32) != 0 {
        kind = 2;
    } else if (attrs & (0x40u32 | 0x400u32)) != 0 {
        kind = 3;
    }
    let size_high = data[7] as u64;
    let size_low = data[8] as u64;
    let size: u64 = (size_high << 32) | size_low;

    *out = kind;
    *(out + 1) = size;
    0
}

pub unsafe fn __ax_host_dir_open(path: *const u8, path_len: usize) -> i64 {
    let mut wpath_buf: [1024]u16 = [0u16; 1024];
    let pwpath = address_of_mut(wpath_buf[0]);
    let wlen = utf8_to_wpath(path, path_len, pwpath, 1020);
    if wlen == 0 {
        return -4;
    }
    if *(pwpath + (wlen - 1)) == 47u16 || *(pwpath + (wlen - 1)) == 92u16 {
        *(pwpath + wlen) = 42u16; // '*'
        *(pwpath + wlen + 1) = 0u16;
    } else {
        *(pwpath + wlen) = 92u16; // '\\'
        *(pwpath + wlen + 1) = 42u16; // '*'
        *(pwpath + wlen + 2) = 0u16;
    }

    let tbl = get_dir_table();
    if tbl as usize == 0 {
        return -9;
    }

    let mut slot_idx: usize = 0;
    let mut i: usize = 1;
    while i <= 64 {
        let is_open_ptr = (tbl as usize + (i - 1) * 608 + 12) as *mut u32;
        if *is_open_ptr == 0u32 {
            slot_idx = i;
            break;
        }
        i = i + 1;
    }
    if slot_idx == 0 {
        return -9;
    }

    let slot_addr = tbl as usize + (slot_idx - 1) * 608;
    let pffd = (slot_addr + 16) as *mut u8;
    let hFind = FindFirstFileW(pwpath, pffd);
    if hFind as usize == 0xFFFFFFFFFFFFFFFF {
        let err = GetLastError();
        if err == 2u32 || err == 3u32 { return -1; }
        if err == 5u32 { return -2; }
        return -9;
    }

    let phFind = slot_addr as *mut *mut u8;
    let phas_entry = (slot_addr + 8) as *mut u32;
    let pis_open = (slot_addr + 12) as *mut u32;

    *phFind = hFind;
    *phas_entry = 1u32;
    *pis_open = 1u32;

    (1000 + slot_idx) as i64
}

pub unsafe fn __ax_host_dir_next(h: i64, buf: *mut u8, cap: usize) -> i64 {
    if h < 1001 || h > 1064 {
        return -4;
    }
    let tbl = get_dir_table();
    if tbl as usize == 0 {
        return -4;
    }

    let slot_idx = (h - 1000) as usize;
    let slot_addr = tbl as usize + (slot_idx - 1) * 608;
    let pis_open = (slot_addr + 12) as *mut u32;
    if *pis_open == 0u32 {
        return -4;
    }

    let phFind = slot_addr as *mut *mut u8;
    let phas_entry = (slot_addr + 8) as *mut u32;
    let pffd = (slot_addr + 16) as *mut u8;
    let hFind = *phFind;

    while *phas_entry != 0u32 {
        let pwname = (slot_addr + 16 + 44) as *const u16;
        let ch0 = *pwname;
        let ch1 = *(pwname + 1);
        let is_dot = (ch0 == 46u16 && ch1 == 0u16);
        let is_dotdot = (ch0 == 46u16 && ch1 == 46u16 && *(pwname + 2) == 0u16);
        if !is_dot && !is_dotdot {
            break;
        }
        let ok = FindNextFileW(hFind, pffd);
        if ok == 0 {
            *phas_entry = 0u32;
            break;
        }
    }

    if *phas_entry == 0u32 {
        return 0;
    }

    let pwname = (slot_addr + 16 + 44) as *const u16;
    let wlen = utf16_null_len(pwname);
    let u8_len = wchars_to_utf8(pwname, wlen, 0 as *mut u8, 0);

    if u8_len > cap {
        return u8_len as i64;
    }

    wchars_to_utf8(pwname, wlen, buf, cap);

    let ok = FindNextFileW(hFind, pffd);
    if ok == 0 {
        *phas_entry = 0u32;
    }

    u8_len as i64
}

pub fn __ax_host_dir_close(h: i64) -> i64 {
    if h < 1001 || h > 1064 {
        return -4;
    }
    let tbl = unsafe { get_dir_table() };
    if tbl as usize == 0 {
        return -4;
    }

    let slot_idx = (h - 1000) as usize;
    let slot_addr = tbl as usize + (slot_idx - 1) * 608;
    let pis_open = (slot_addr + 12) as *mut u32;
    if unsafe { *pis_open } == 0u32 {
        return -4;
    }

    let phFind = slot_addr as *mut *mut u8;
    let phas_entry = (slot_addr + 8) as *mut u32;
    let hFind = unsafe { *phFind };

    unsafe {
        FindClose(hFind);
        *pis_open = 0u32;
        *phas_entry = 0u32;
        *phFind = 0 as *mut u8;
    }

    0
}

module host_sys_process

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
    fn GetCommandLineW() -> *const u16;
    fn LocalFree(hMem: *mut u8) -> *mut u8;
    fn GetEnvironmentVariableW(lpName: *const u16, lpBuffer: *mut u16, nSize: u32) -> u32;
    fn GetModuleFileNameW(hModule: *mut u8, lpFilename: *mut u16, nSize: u32) -> u32;
    fn ExitProcess(uExitCode: u32);
    fn GetLastError() -> u32;
}

@link("shell32")
extern "system" {
    fn CommandLineToArgvW(lpCmdLine: *const u16, pNumArgs: *mut i32) -> *mut *mut u16;
}

@intrinsic pub unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

pub fn __ax_host_args_count() -> usize {
    let mut num: [1]i32 = [0i32];
    let cmd = unsafe { GetCommandLineW() };
    let argv = unsafe { CommandLineToArgvW(cmd, address_of_mut(num[0])) };
    if argv as usize == 0 {
        return 0;
    }
    let count = num[0] as usize;
    unsafe {
        LocalFree(argv as *mut u8);
    }
    count
}

pub unsafe fn __ax_host_arg(i: usize, buf: *mut u8, cap: usize) -> i64 {
    let mut num: [1]i32 = [0i32];
    let cmd = GetCommandLineW();
    let argv = CommandLineToArgvW(cmd, address_of_mut(num[0]));
    if argv as usize == 0 {
        return -4;
    }
    let count = num[0] as usize;
    if i >= count {
        LocalFree(argv as *mut u8);
        return -4;
    }
    let warg = *(argv + i);
    let mut wlen: usize = 0;
    while *(warg + wlen) != 0u16 {
        wlen = wlen + 1;
    }

    let mut u8_len: usize = 0;
    let mut w_idx: usize = 0;
    while w_idx < wlen {
        let u0 = *(warg + w_idx) as u32;
        let mut cp: u32 = 0;
        if u0 >= 0xD800 && u0 <= 0xDBFF && w_idx + 1 < wlen {
            let u1 = *(warg + w_idx + 1) as u32;
            if u1 >= 0xDC00 && u1 <= 0xDFFF {
                cp = 0x10000 + (((u0 - 0xD800) << 10) | (u1 - 0xDC00));
                w_idx = w_idx + 2;
            } else {
                cp = 0xFFFD;
                w_idx = w_idx + 1;
            }
        } else if u0 >= 0xD800 && u0 <= 0xDFFF {
            cp = 0xFFFD;
            w_idx = w_idx + 1;
        } else {
            cp = u0;
            w_idx = w_idx + 1;
        }

        if cp <= 0x7F {
            if u8_len < cap { *(buf + u8_len) = cp as u8; }
            u8_len = u8_len + 1;
        } else if cp <= 0x7FF {
            if u8_len < cap { *(buf + u8_len) = (0xC0 | (cp >> 6)) as u8; }
            if u8_len + 1 < cap { *(buf + u8_len + 1) = (0x80 | (cp & 0x3F)) as u8; }
            u8_len = u8_len + 2;
        } else if cp <= 0xFFFF {
            if u8_len < cap { *(buf + u8_len) = (0xE0 | (cp >> 12)) as u8; }
            if u8_len + 1 < cap { *(buf + u8_len + 1) = (0x80 | ((cp >> 6) & 0x3F)) as u8; }
            if u8_len + 2 < cap { *(buf + u8_len + 2) = (0x80 | (cp & 0x3F)) as u8; }
            u8_len = u8_len + 3;
        } else {
            if u8_len < cap { *(buf + u8_len) = (0xF0 | (cp >> 18)) as u8; }
            if u8_len + 1 < cap { *(buf + u8_len + 1) = (0x80 | ((cp >> 12) & 0x3F)) as u8; }
            if u8_len + 2 < cap { *(buf + u8_len + 2) = (0x80 | ((cp >> 6) & 0x3F)) as u8; }
            if u8_len + 3 < cap { *(buf + u8_len + 3) = (0x80 | (cp & 0x3F)) as u8; }
            u8_len = u8_len + 4;
        }
    }

    LocalFree(argv as *mut u8);
    u8_len as i64
}

pub unsafe fn __ax_host_env_get(name: *const u8, name_len: usize, buf: *mut u8, cap: usize) -> i64 {
    let mut wname: [256]u16 = [0u16; 256];
    let mut in_pos: usize = 0;
    let mut out_pos: usize = 0;
    while in_pos < name_len && out_pos + 2 < 256 {
        let b0 = *(name + in_pos) as u32;
        let mut cp: u32 = 0;
        let mut step: usize = 1;
        if b0 < 0x80 {
            cp = b0;
            step = 1;
        } else if (b0 & 0xE0) == 0xC0 && in_pos + 1 < name_len {
            let b1 = *(name + in_pos + 1) as u32;
            cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F);
            step = 2;
        } else if (b0 & 0xF0) == 0xE0 && in_pos + 2 < name_len {
            let b1 = *(name + in_pos + 1) as u32;
            let b2 = *(name + in_pos + 2) as u32;
            cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F);
            step = 3;
        } else {
            cp = 0xFFFD;
            step = 1;
        }
        in_pos = in_pos + step;
        if cp <= 0xFFFF {
            wname[out_pos] = cp as u16;
            out_pos = out_pos + 1;
        } else {
            wname[out_pos] = (0xD800 + ((cp - 0x10000) >> 10)) as u16;
            wname[out_pos + 1] = (0xDC00 + ((cp - 0x10000) & 0x3FF)) as u16;
            out_pos = out_pos + 2;
        }
    }
    wname[out_pos] = 0u16;

    let pwname = address_of_mut(wname[0]);
    let needed = GetEnvironmentVariableW(pwname, 0 as *mut u16, 0);
    if needed == 0 {
        let err = GetLastError();
        if err == 203u32 {
            return -1;
        }
        return -9;
    }

    let wval = HeapAlloc(GetProcessHeap(), 8u32, (needed as usize + 1) * 2) as *mut u16;
    if wval as usize == 0 {
        return -9;
    }
    GetEnvironmentVariableW(pwname, wval, needed);

    let mut u8_len: usize = 0;
    let mut w_idx: usize = 0;
    let wval_len = (needed - 1) as usize;
    while w_idx < wval_len {
        let u0 = *(wval + w_idx) as u32;
        let mut cp: u32 = 0;
        if u0 >= 0xD800 && u0 <= 0xDBFF && w_idx + 1 < wval_len {
            let u1 = *(wval + w_idx + 1) as u32;
            if u1 >= 0xDC00 && u1 <= 0xDFFF {
                cp = 0x10000 + (((u0 - 0xD800) << 10) | (u1 - 0xDC00));
                w_idx = w_idx + 2;
            } else {
                cp = 0xFFFD;
                w_idx = w_idx + 1;
            }
        } else if u0 >= 0xD800 && u0 <= 0xDFFF {
            cp = 0xFFFD;
            w_idx = w_idx + 1;
        } else {
            cp = u0;
            w_idx = w_idx + 1;
        }

        if cp <= 0x7F {
            if u8_len < cap { *(buf + u8_len) = cp as u8; }
            u8_len = u8_len + 1;
        } else if cp <= 0x7FF {
            if u8_len < cap { *(buf + u8_len) = (0xC0 | (cp >> 6)) as u8; }
            if u8_len + 1 < cap { *(buf + u8_len + 1) = (0x80 | (cp & 0x3F)) as u8; }
            u8_len = u8_len + 2;
        } else if cp <= 0xFFFF {
            if u8_len < cap { *(buf + u8_len) = (0xE0 | (cp >> 12)) as u8; }
            if u8_len + 1 < cap { *(buf + u8_len + 1) = (0x80 | ((cp >> 6) & 0x3F)) as u8; }
            if u8_len + 2 < cap { *(buf + u8_len + 2) = (0x80 | (cp & 0x3F)) as u8; }
            u8_len = u8_len + 3;
        } else {
            if u8_len < cap { *(buf + u8_len) = (0xF0 | (cp >> 18)) as u8; }
            if u8_len + 1 < cap { *(buf + u8_len + 1) = (0x80 | ((cp >> 12) & 0x3F)) as u8; }
            if u8_len + 2 < cap { *(buf + u8_len + 2) = (0x80 | ((cp >> 6) & 0x3F)) as u8; }
            if u8_len + 3 < cap { *(buf + u8_len + 3) = (0x80 | (cp & 0x3F)) as u8; }
            u8_len = u8_len + 4;
        }
    }

    HeapFree(GetProcessHeap(), 0u32, wval as *mut u8);
    u8_len as i64
}

pub unsafe fn __ax_host_exe_path(buf: *mut u8, cap: usize) -> i64 {
    let wbuf = HeapAlloc(GetProcessHeap(), 8u32, 4096) as *mut u16;
    if wbuf as usize == 0 {
        return -9;
    }
    let wlen = GetModuleFileNameW(0 as *mut u8, wbuf, 2048);
    if wlen == 0 {
        HeapFree(GetProcessHeap(), 0u32, wbuf as *mut u8);
        return -9;
    }

    let mut u8_len: usize = 0;
    let mut w_idx: usize = 0;
    while w_idx < wlen as usize {
        let u0 = *(wbuf + w_idx) as u32;
        let mut cp: u32 = 0;
        if u0 >= 0xD800 && u0 <= 0xDBFF && w_idx + 1 < wlen as usize {
            let u1 = *(wbuf + w_idx + 1) as u32;
            if u1 >= 0xDC00 && u1 <= 0xDFFF {
                cp = 0x10000 + (((u0 - 0xD800) << 10) | (u1 - 0xDC00));
                w_idx = w_idx + 2;
            } else {
                cp = 0xFFFD;
                w_idx = w_idx + 1;
            }
        } else if u0 >= 0xD800 && u0 <= 0xDFFF {
            cp = 0xFFFD;
            w_idx = w_idx + 1;
        } else {
            cp = u0;
            w_idx = w_idx + 1;
        }

        let ch_to_write: u32 = if cp == 92 { 47 } else { cp }; // replace '\' with '/'

        if ch_to_write <= 0x7F {
            if u8_len < cap { *(buf + u8_len) = ch_to_write as u8; }
            u8_len = u8_len + 1;
        } else if ch_to_write <= 0x7FF {
            if u8_len < cap { *(buf + u8_len) = (0xC0 | (ch_to_write >> 6)) as u8; }
            if u8_len + 1 < cap { *(buf + u8_len + 1) = (0x80 | (ch_to_write & 0x3F)) as u8; }
            u8_len = u8_len + 2;
        } else if ch_to_write <= 0xFFFF {
            if u8_len < cap { *(buf + u8_len) = (0xE0 | (ch_to_write >> 12)) as u8; }
            if u8_len + 1 < cap { *(buf + u8_len + 1) = (0x80 | ((ch_to_write >> 6) & 0x3F)) as u8; }
            if u8_len + 2 < cap { *(buf + u8_len + 2) = (0x80 | (ch_to_write & 0x3F)) as u8; }
            u8_len = u8_len + 3;
        } else {
            if u8_len < cap { *(buf + u8_len) = (0xF0 | (ch_to_write >> 18)) as u8; }
            if u8_len + 1 < cap { *(buf + u8_len + 1) = (0x80 | ((ch_to_write >> 12) & 0x3F)) as u8; }
            if u8_len + 2 < cap { *(buf + u8_len + 2) = (0x80 | ((ch_to_write >> 6) & 0x3F)) as u8; }
            if u8_len + 3 < cap { *(buf + u8_len + 3) = (0x80 | (ch_to_write & 0x3F)) as u8; }
            u8_len = u8_len + 4;
        }
    }

    HeapFree(GetProcessHeap(), 0u32, wbuf as *mut u8);
    u8_len as i64
}

pub fn __ax_host_exit(code: i32) {
    unsafe {
        ExitProcess(code as u32);
    }
}

module host_sys_time

@link("kernel32")
extern "system" {
    fn QueryPerformanceCounter(lpPerformanceCount: *mut i64) -> i32;
    fn QueryPerformanceFrequency(lpFrequency: *mut i64) -> i32;
}

@intrinsic pub unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

pub fn __ax_host_monotonic_ns() -> u64 {
    let mut count: [1]i64 = [0i64];
    let mut freq: [1]i64 = [0i64];
    let ok1 = unsafe { QueryPerformanceCounter(address_of_mut(count[0])) };
    let ok2 = unsafe { QueryPerformanceFrequency(address_of_mut(freq[0])) };
    if ok1 == 0 || ok2 == 0 {
        return 0u64;
    }
    let f = freq[0] as u64;
    let c = count[0] as u64;
    if f == 0u64 {
        return 0u64;
    }
    let s = c / f;
    let rem = c % f;
    s * 1_000_000_000u64 + (rem * 1_000_000_000u64) / f
}

module compiler.kernel.id

use host_intrinsics.heap_alloc
use host_intrinsics.heap_free

@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

// Typed ID Newtypes (INV-KERN-001, 0171 AKERNEL-24, 0153 ACKERNEL-20)
// Convention: v == 0 is none / invalid; v = table_index + 1.

pub struct StrId {
    pub v: u32,
}

impl StrId {
    pub fn none() -> StrId { StrId { v: 0 } }
    pub fn is_none(self: view<StrId>) -> bool { self.v == 0 }
    pub fn is_some(self: view<StrId>) -> bool { self.v != 0 }
    pub fn from_index(index: usize) -> StrId { StrId { v: (index + 1) as u32 } }
    pub fn index(self: view<StrId>) -> usize { (self.v - 1) as usize }
    pub fn eq(self: view<StrId>, other: view<StrId>) -> bool { self.v == other.v }
    pub fn to_raw(self: view<StrId>) -> u32 { self.v }
    pub fn from_raw(v: u32) -> StrId { StrId { v: v } }
}

