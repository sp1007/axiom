pub const AX_LINK_DUPLICATE_SYMBOL: u32 = 113u32; pub const AX_LINK_RELOC_OUT_OF_RANGE: u32 = 114u32; pub const AX_LINK_BAD_OBJECT: u32 = 115u32; pub const AX_LINK_IMAGE_TOO_LARGE: u32 = 116u32;
pub const AX_IO_FILE_NOT_FOUND: u32 = 117u32; pub const AX_IO_READ_FAILED: u32 = 118u32; pub const AX_IO_WRITE_FAILED: u32 = 119u32; pub const AX_IO_FILE_TOO_LARGE: u32 = 120u32;
pub const AX_DRIVER_USAGE: u32 = 121u32; pub const AX_DRIVER_UNKNOWN_OPTION: u32 = 122u32; pub const AX_DRIVER_NO_INPUT: u32 = 123u32; pub const AX_DRIVER_UNKNOWN_TARGET: u32 = 124u32;
pub const AX_DRIVER_STAGE_NOT_AVAILABLE: u32 = 125u32; pub const AX_DRIVER_INTERP_STEP_LIMIT: u32 = 126u32; pub const AX_DRIVER_INTERP_STACK_LIMIT: u32 = 127u32; pub const AX_DRIVER_NO_STD: u32 = 128u32;
pub const AX_DRIVER_BAD_MANIFEST: u32 = 129u32; pub const AX_ICE_INTERNAL: u32 = 130u32; pub const AX_ICE_MIR_VERIFY: u32 = 131u32; pub const AX_ICE_OUT_OF_MEMORY: u32 = 132u32;
pub const AX_DIAG_CODE_COUNT: u32 = 133u32;

pub fn diag_code_name(c: DiagCode) -> Str {
    match c.v {
        0u32 => "AX_LEX_INVALID_UTF8", 1u32 => "AX_LEX_INVALID_CHAR", 2u32 => "AX_LEX_NON_ASCII_IDENT", 3u32 => "AX_LEX_UNTERMINATED_COMMENT",
        4u32 => "AX_LEX_UNTERMINATED_STRING", 5u32 => "AX_LEX_UNTERMINATED_CHAR", 6u32 => "AX_LEX_BAD_CHAR_LITERAL", 7u32 => "AX_LEX_INVALID_ESCAPE",
        8u32 => "AX_LEX_INVALID_UNICODE_ESCAPE", 9u32 => "AX_LEX_NON_ASCII_IN_BYTE_LITERAL", 10u32 => "AX_LEX_MISSING_DIGITS", 11u32 => "AX_LEX_BAD_BASE_PREFIX",
        12u32 => "AX_LEX_INVALID_DIGIT", 13u32 => "AX_LEX_BAD_DIGIT_SEPARATOR", 14u32 => "AX_LEX_INVALID_SUFFIX", 15u32 => "AX_LEX_INT_OVERFLOW",
        16u32 => "AX_LEX_INVALID_OPERATOR", 17u32 => "AX_LEX_COLON_COLON", 18u32 => "AX_LEX_COLON_EQ", 19u32 => "AX_PARSE_EXPECTED_TOKEN",
        20u32 => "AX_PARSE_EXPECTED_EXPR", 21u32 => "AX_PARSE_EXPECTED_TYPE", 22u32 => "AX_PARSE_EXPECTED_PATTERN", 23u32 => "AX_PARSE_EXPECTED_ITEM",
        24u32 => "AX_PARSE_EXPECTED_TERMINATOR", 25u32 => "AX_PARSE_EXPECTED_LOOP", 26u32 => "AX_PARSE_UNCLOSED_DELIMITER", 27u32 => "AX_PARSE_LEADING_OPERATOR",
        28u32 => "AX_PARSE_CHAINED_COMPARISON", 29u32 => "AX_PARSE_ASSIGN_IN_EXPR", 30u32 => "AX_PARSE_REFERENCE_OPERATOR", 31u32 => "AX_PARSE_VAR",
        32u32 => "AX_PARSE_IMPORT", 33u32 => "AX_PARSE_MOD", 34u32 => "AX_PARSE_MODULE_NOT_FIRST", 35u32 => "AX_PARSE_ITEM_IN_BLOCK",
        36u32 => "AX_PARSE_LET_NEEDS_TYPE_OR_INIT", 37u32 => "AX_PARSE_SELF_NEEDS_TYPE", 38u32 => "AX_PARSE_FN_BODY_REQUIRED", 39u32 => "AX_PARSE_FN_BODY_NOT_ALLOWED",
        40u32 => "AX_PARSE_VIS_NOT_ALLOWED", 41u32 => "AX_PARSE_ARRAY_TYPE_ORDER", 42u32 => "AX_PARSE_RESERVED_KEYWORD", 43u32 => "AX_PARSE_UNSUPPORTED_IN_BOOTSTRAP",
        44u32 => "AX_NAME_UNRESOLVED", 45u32 => "AX_NAME_DUPLICATE", 46u32 => "AX_NAME_NOT_A_VALUE", 47u32 => "AX_NAME_NOT_A_TYPE",
        48u32 => "AX_NAME_UNRESOLVED_IMPORT", 49u32 => "AX_NAME_SHADOW_MODULE", 50u32 => "AX_NAME_UNDEFINED_LABEL", 51u32 => "AX_NAME_BREAK_OUTSIDE_LOOP",
        52u32 => "AX_NAME_NOT_YET_SUPPORTED", 53u32 => "AX_NAME_DUPLICATE_BINDING", 54u32 => "AX_NAME_OR_PATTERN_MISMATCH", 55u32 => "AX_NAME_PRIVATE",
        56u32 => "AX_NAME_IMPORT_CYCLE", 57u32 => "AX_TYPE_MISMATCH", 58u32 => "AX_TYPE_UNKNOWN", 59u32 => "AX_TYPE_NOT_CALLABLE",
        60u32 => "AX_TYPE_ARG_COUNT", 61u32 => "AX_TYPE_RETURN", 62u32 => "AX_TYPE_OPERATOR", 63u32 => "AX_TYPE_LITERAL_OUT_OF_RANGE",
        64u32 => "AX_TYPE_NEG_UNSIGNED", 65u32 => "AX_TYPE_INVALID_CAST", 66u32 => "AX_TYPE_NEVER_RETURNS", 67u32 => "AX_TYPE_MAIN_MISSING",
        68u32 => "AX_TYPE_MAIN_SIGNATURE", 69u32 => "AX_TYPE_UNSUPPORTED_IN_BOOTSTRAP", 70u32 => "AX_TYPE_ASSIGN_IMMUTABLE", 71u32 => "AX_TYPE_UNINIT_USE",
        72u32 => "AX_TYPE_UNREACHABLE", 73u32 => "AX_TYPE_UNKNOWN_FIELD", 74u32 => "AX_TYPE_MISSING_FIELD", 75u32 => "AX_TYPE_DUPLICATE_FIELD",
        76u32 => "AX_TYPE_ARRAY_SIZE", 77u32 => "AX_TYPE_CANNOT_INDEX", 78u32 => "AX_TYPE_TRY_OPERAND", 79u32 => "AX_TYPE_TRY_RETURN_MISMATCH",
        80u32 => "AX_TYPE_STORED_VIEW_ESCAPE", 81u32 => "AX_TYPE_STORED_VIEW_SELF_REF", 82u32 => "AX_TRAIT_OVERLAP", 83u32 => "AX_TRAIT_AMBIGUOUS_METHOD",
        84u32 => "AX_TRAIT_UNSATISFIED_BOUND", 85u32 => "AX_TRAIT_UNKNOWN_DERIVE", 86u32 => "AX_PAT_NON_EXHAUSTIVE", 87u32 => "AX_PAT_REFUTABLE",
        88u32 => "AX_PAT_UNREACHABLE", 89u32 => "AX_MOVE_USE_AFTER_MOVE", 90u32 => "AX_INIT_USE_UNINIT", 91u32 => "AX_CAP_CONFLICT_MUT",
        92u32 => "AX_CAP_CONFLICT_READ", 93u32 => "AX_CAP_OUTLIVES_OWNER", 94u32 => "AX_UNSAFE_REQUIRED", 95u32 => "AX_UNSAFE_INTERP_UB",
        96u32 => "AX_CONST_OVERFLOW", 97u32 => "AX_CONST_DIV_ZERO", 98u32 => "AX_CONST_CYCLE", 99u32 => "AX_CONST_EVAL_LIMIT",
        100u32 => "AX_VERIFY_MIR_SYNTAX", 101u32 => "AX_VERIFY_UNKNOWN_LOCAL", 102u32 => "AX_VERIFY_UNTERMINATED_BLOCK", 103u32 => "AX_VERIFY_BAD_TARGET",
        104u32 => "AX_VERIFY_TYPE_MISMATCH", 105u32 => "AX_VERIFY_UNINIT_USE", 106u32 => "AX_VERIFY_CALL_SIGNATURE", 107u32 => "AX_VERIFY_RETURN_TYPE",
        108u32 => "AX_VERIFY_USE_AFTER_MOVE", 109u32 => "AX_VERIFY_MISSING_DROP", 110u32 => "AX_VERIFY_DOUBLE_DROP", 111u32 => "AX_FFI_NOT_IN_ORACLE",
        112u32 => "AX_LINK_UNDEFINED_SYMBOL", 113u32 => "AX_LINK_DUPLICATE_SYMBOL", 114u32 => "AX_LINK_RELOC_OUT_OF_RANGE", 115u32 => "AX_LINK_BAD_OBJECT",
        116u32 => "AX_LINK_IMAGE_TOO_LARGE", 117u32 => "AX_IO_FILE_NOT_FOUND", 118u32 => "AX_IO_READ_FAILED", 119u32 => "AX_IO_WRITE_FAILED",
        120u32 => "AX_IO_FILE_TOO_LARGE", 121u32 => "AX_DRIVER_USAGE", 122u32 => "AX_DRIVER_UNKNOWN_OPTION", 123u32 => "AX_DRIVER_NO_INPUT",
        124u32 => "AX_DRIVER_UNKNOWN_TARGET", 125u32 => "AX_DRIVER_STAGE_NOT_AVAILABLE", 126u32 => "AX_DRIVER_INTERP_STEP_LIMIT", 127u32 => "AX_DRIVER_INTERP_STACK_LIMIT",
        128u32 => "AX_DRIVER_NO_STD", 129u32 => "AX_DRIVER_BAD_MANIFEST", 130u32 => "AX_ICE_INTERNAL", 131u32 => "AX_ICE_MIR_VERIFY",
        132u32 => "AX_ICE_OUT_OF_MEMORY",
        _ => "<unknown>",
    }
}

pub fn diag_code_default_message(c: DiagCode) -> Str {
    match c.v {
        0u32 => "invalid UTF-8 byte sequence", 1u32 => "character that cannot start a token",
        2u32 => "non-ASCII character outside literals and comments", 3u32 => "block comment open at end of file",
        4u32 => "line break or end of file inside a string", 5u32 => "character literal without closing quote on the line",
        6u32 => "empty or multi-character char/byte literal", 7u32 => "unknown escape or bad \\\\x",
        8u32 => "malformed or non-scalar \\\\u{...}", 9u32 => "non-ASCII character in a byte literal",
        10u32 => "base prefix without digits", 11u32 => "upper-case base prefix",
        12u32 => "digit not valid for the base", 13u32 => "misplaced _ in a number",
        14u32 => "unknown or mismatched literal suffix", 15u32 => "integer literal above 2^64 - 1",
        16u32 => "three or more dots", 17u32 => ":: is not a token; paths use .",
        18u32 => ":= is not a token; bind with =", 19u32 => "expected a specific token",
        20u32 => "expected expression", 21u32 => "expected type",
        22u32 => "expected pattern", 23u32 => "expected item",
        24u32 => "expected a line break or ;", 25u32 => "expected loop",
        26u32 => "unclosed delimiter", 27u32 => "a line continues only when the previous line ends with an operator or this line starts with .; move the operator to the end of the previous line",
        28u32 => "comparison operators cannot be chained; use parentheses or &&", 29u32 => "assignment inside an expression; use == to compare",
        30u32 => "Axiom has no & reference operator; pass the value, or write view(x) / mut_view(x)", 31u32 => "replace var by let mut",
        32u32 => "import is not a keyword", 33u32 => "write module a.b at the top of the file; there are no inline modules",
        34u32 => "module declaration not at the start of the file", 35u32 => "item inside a block",
        36u32 => "let needs type or initializer", 37u32 => "self parameter needs a type",
        38u32 => "function body required", 39u32 => "function body not allowed here",
        40u32 => "visibility not allowed here", 41u32 => "array type must be written [N]T",
        42u32 => "reserved keyword", 43u32 => "unsupported in bootstrap",
        44u32 => "name not found in scope", 45u32 => "name defined twice in one scope",
        46u32 => "a module or type used where a value is expected", 47u32 => "a value or module used where a type is expected",
        48u32 => "use path does not name an existing item or module", 49u32 => "a local binding shadows a module name (lookup order still picks the local)",
        50u32 => "break / continue names an unknown label", 51u32 => "break or continue outside a loop",
        52u32 => "construct parsed but not lowered by this build yet (AXD-014)", 53u32 => "duplicate binding in pattern",
        54u32 => "inconsistent or-pattern bindings", 55u32 => "item or member is private",
        56u32 => "cyclic import detected", 57u32 => "expression type differs from the expected type",
        58u32 => "the type cannot be inferred; add an annotation", 59u32 => "callee is not a function",
        60u32 => "wrong number of arguments", 61u32 => "body can reach its end without producing the declared non-unit value",
        62u32 => "operator not defined for these operand types", 63u32 => "integer literal does not fit its type",
        64u32 => "unary minus applied to an unsigned type", 65u32 => "as cast between types SPEC-03 does not allow",
        66u32 => "a function declared to return never can return normally", 67u32 => "the root file has no fn main (build/run)",
        68u32 => "main signature not allowed by SPEC-03", 69u32 => "valid Axiom outside the axiom0 subset (AXD-013)",
        70u32 => "cannot assign twice to immutable variable", 71u32 => "use of possibly-uninitialized variable",
        72u32 => "unreachable statement", 73u32 => "struct has no such field",
        74u32 => "missing field in struct literal", 75u32 => "duplicate field in struct literal",
        76u32 => "array size must be a non-negative constant integer", 77u32 => "cannot index into a value of this type",
        78u32 => "the `?` operator can only be applied to values that implement Try (Option or Result)", 79u32 => "cannot use `?` operator on Option in a function that returns Result (or vice versa)",
        80u32 => "stored view might outlive the owner of the referenced data", 81u32 => "self-referencing stored views within the same struct are forbidden",
        82u32 => "overlapping implementations for trait", 83u32 => "method call is ambiguous",
        84u32 => "the trait bound is not satisfied", 85u32 => "unknown trait in derive",
        86u32 => "non-exhaustive patterns: match must cover all cases", 87u32 => "refutable pattern in local binding",
        88u32 => "unreachable pattern", 89u32 => "use of moved value",
        90u32 => "use of possibly uninitialized value", 91u32 => "cannot create a mutable view because it conflicts with an existing view",
        92u32 => "cannot create a read view because the place is mutably viewed", 93u32 => "active view outlives its originating owner place",
        94u32 => "operation requires an unsafe block or function", 95u32 => "undefined behaviour detected by interpreter oracle",
        96u32 => "arithmetic overflow during constant evaluation", 97u32 => "division by zero during constant evaluation",
        98u32 => "cyclic dependency in constant evaluation", 99u32 => "evaluation limit exceeded during constant evaluation",
        100u32 => "MIR text cannot be parsed (C-only test input, T018)", 101u32 => "a local or block id is not declared in the body",
        102u32 => "a basic block has no terminator", 103u32 => "a terminator targets a block that does not exist",
        104u32 => "operand or rvalue type differs from the place type", 105u32 => "local read before it is definitely assigned",
        106u32 => "call arguments or destination do not match the callee signature", 107u32 => "the return place type differs from the function's return type",
        108u32 => "use of a local after it was moved", 109u32 => "a value requiring a drop goes out of scope without being dropped",
        110u32 => "a value is dropped more than once", 111u32 => "direct extern call cannot run in interpreter oracle",
        112u32 => "a referenced symbol is defined in no input object or import", 113u32 => "a global symbol is defined twice",
        114u32 => "a relocation value does not fit its field", 115u32 => "input object file is malformed or of an unsupported kind",
        116u32 => "image exceeds the PE32+ size limit", 117u32 => "input file does not exist",
        118u32 => "input file exists but cannot be read", 119u32 => "output cannot be written",
        120u32 => "source file exceeds the source-database limit (T008)", 121u32 => "malformed command line (exit 2)",
        122u32 => "unknown option (exit 2)", 123u32 => "command needs an input file (exit 2)",
        124u32 => "target triple not supported (exit 2)", 125u32 => "the requested stage or emitter is not implemented in this build (AXD-014)",
        126u32 => "the MIR interpreter exceeded its step limit (SPEC-03 default, --step-limit N)", 127u32 => "the MIR interpreter exceeded its call-depth limit (SPEC-03)",
        128u32 => "no std root found (ADR-0006 Â§8)", 129u32 => "malformed or invalid package manifest axiom.toml",
        130u32 => "an internal invariant failed; data.stage, data.detail", 131u32 => "compiler-built MIR was rejected by the verifier (AXD-042)",
        132u32 => "the compiler could not allocate memory",
        _ => "",
    }
}

pub fn diag_code_severity(c: DiagCode) -> DiagSeverity {
    if c.v == AX_NAME_SHADOW_MODULE || c.v == AX_PAT_UNREACHABLE || c.v == AX_TYPE_UNREACHABLE {
        DiagSeverity.Warning
    } else {
        DiagSeverity.Error
    }
}

module compiler.diag.emitter

use host_intrinsics.heap_alloc
use host_intrinsics.heap_free

use compiler.kernel.arena.Arena
use compiler.kernel.arena.arena_new
use compiler.kernel.arena.arena_alloc_raw
use compiler.kernel.arena.arena_destroy
use compiler.kernel.interner.StrView
use compiler.source.span.Span
use compiler.source.span.span_none
use compiler.source.span.span_is_none
use compiler.diag.code.DiagSeverity
use compiler.diag.code.FixApplicability
use compiler.diag.code.DiagDataKind
use compiler.diag.code.DiagCode
use compiler.diag.code.diag_code
use compiler.diag.code.diag_code_severity

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub struct DiagLabel {
    pub span: Span,
    pub message: StrView,
}

pub struct DiagEdit {
    pub span: Span,
    pub replacement: StrView,
}

pub struct DiagFix {
    pub message: StrView,
    pub applicability: FixApplicability,
    pub edits: *mut DiagEdit,
    pub edit_count: usize,
}

pub struct DiagDataValue {
    pub kind: DiagDataKind,
    pub str_val: StrView,
    pub int_val: i64,
    pub bool_val: bool,
    pub list_items: *mut StrView,
    pub list_count: usize,
}

pub struct DiagDataEntry {
    pub key: StrView,
    pub value: DiagDataValue,
}

pub struct Diagnostic {
    pub code: DiagCode,
    pub severity: DiagSeverity,
    pub message: StrView,
    pub primary: Span,

    pub labels: *mut DiagLabel,
    pub label_count: usize,

    pub notes: *mut StrView,
    pub note_count: usize,

    pub helps: *mut StrView,
    pub help_count: usize,

    pub fixes: *mut DiagFix,
    pub fix_count: usize,

    pub data: *mut DiagDataEntry,
    pub data_count: usize,
}

pub struct DiagSink {
    pub arena: Arena,
    pub diags: *mut Diagnostic,
    pub len: usize,
    pub cap: usize,
    pub errors: usize,
    pub warnings: usize,
}

pub fn diag_new(c: DiagCode, primary: Span, msg: StrView) -> Diagnostic {
    Diagnostic {
        code: c,
        severity: diag_code_severity(c),
        message: msg,
        primary: primary,
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    }
}

pub fn diag_sink_new() -> DiagSink {
    DiagSink {
        arena: arena_new(),
        diags: 0 as *mut Diagnostic,
        len: 0,
        cap: 0,
        errors: 0,
        warnings: 0,
    }
}

pub fn diag_sink_init(sink: mut_view<DiagSink>) {
    sink.arena = arena_new();
    sink.diags = 0 as *mut Diagnostic;
    sink.len = 0;
    sink.cap = 0;
    sink.errors = 0;
    sink.warnings = 0;
}

pub fn diag_sink_free(sink: mut_view<DiagSink>) {
    if sink.cap > 0 && sink.diags as usize != 0 {
        unsafe {
            heap_free(sink.diags as *mut u8, (((sink.cap as isize) * (size_of<Diagnostic>() as isize)) as usize), align_of<Diagnostic>());
        }
    }
    sink.diags = 0 as *mut Diagnostic;
    sink.len = 0;
    sink.cap = 0;
    sink.errors = 0;
    sink.warnings = 0;
    arena_destroy(mut_view(sink.arena));
}

fn copy_str_view(arena: mut_view<Arena>, sv: StrView) -> StrView {
    if sv.len == 0 || sv.ptr as usize == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let dst = arena_alloc_raw(arena, sv.len + 1, 1);
    unsafe {
        ptr_copy_nonoverlapping<u8>(sv.ptr, dst, sv.len);
        *(dst + sv.len) = 0u8;
    }
    StrView { ptr: dst as *const u8, len: sv.len }
}

unsafe fn diag_ptr(diags: *mut Diagnostic, idx: usize) -> *mut Diagnostic {
    ((diags as usize) + (((idx as isize) * (size_of<Diagnostic>() as isize)) as usize)) as *mut Diagnostic
}

pub fn diag_sink_report(sink: mut_view<DiagSink>, diag: view<Diagnostic>) {
    if sink.len == sink.cap {
        let new_cap = if sink.cap == 0 { 8 } else { sink.cap + sink.cap };
        let new_diags = unsafe { heap_alloc((((new_cap as isize) * (size_of<Diagnostic>() as isize)) as usize), align_of<Diagnostic>()) as *mut Diagnostic };
        if sink.len > 0 && sink.diags as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(sink.diags as *const u8, new_diags as *mut u8, (((sink.len as isize) * (size_of<Diagnostic>() as isize)) as usize));
                heap_free(sink.diags as *mut u8, (((sink.cap as isize) * (size_of<Diagnostic>() as isize)) as usize), align_of<Diagnostic>());
            }
        }
        sink.diags = new_diags;
        sink.cap = new_cap;
    }

    let mut d = Diagnostic {
        code: diag.code,
        severity: diag.severity,
        message: copy_str_view(mut_view(sink.arena), diag.message),
        primary: diag.primary,
        labels: 0 as *mut DiagLabel,
        label_count: diag.label_count,
        notes: 0 as *mut StrView,
        note_count: diag.note_count,
        helps: 0 as *mut StrView,
        help_count: diag.help_count,
        fixes: 0 as *mut DiagFix,
        fix_count: diag.fix_count,
        data: 0 as *mut DiagDataEntry,
        data_count: diag.data_count,
    };

    // Deep copy labels
    if diag.label_count > 0 && diag.labels as usize != 0 {
        let labels_mem = arena_alloc_raw(mut_view(sink.arena), (((diag.label_count as isize) * (size_of<DiagLabel>() as isize)) as usize), align_of<DiagLabel>()) as *mut DiagLabel;
        let mut i: usize = 0;
        while i < diag.label_count {
            let src_l = unsafe { *((diag.labels as usize + (((i as isize) * (size_of<DiagLabel>() as isize)) as usize)) as *const DiagLabel) };
            let dst_l_ptr = ((labels_mem as usize) + (((i as isize) * (size_of<DiagLabel>() as isize)) as usize)) as *mut DiagLabel;
            unsafe {
                *dst_l_ptr = DiagLabel {
                    span: src_l.span,
                    message: copy_str_view(mut_view(sink.arena), src_l.message),
                };
            }
            i = i + 1;
        }
        d.labels = labels_mem;
    }

    // Deep copy notes
    if diag.note_count > 0 && diag.notes as usize != 0 {
        let notes_mem = arena_alloc_raw(mut_view(sink.arena), (((diag.note_count as isize) * (size_of<StrView>() as isize)) as usize), align_of<StrView>()) as *mut StrView;
        let mut i: usize = 0;
        while i < diag.note_count {
            let src_n = unsafe { *((diag.notes as usize + (((i as isize) * (size_of<StrView>() as isize)) as usize)) as *const StrView) };
            let dst_n_ptr = ((notes_mem as usize) + (((i as isize) * (size_of<StrView>() as isize)) as usize)) as *mut StrView;
            unsafe {
                *dst_n_ptr = copy_str_view(mut_view(sink.arena), src_n);
            }
            i = i + 1;
        }
        d.notes = notes_mem;
    }

    // Deep copy helps
    if diag.help_count > 0 && diag.helps as usize != 0 {
        let helps_mem = arena_alloc_raw(mut_view(sink.arena), (((diag.help_count as isize) * (size_of<StrView>() as isize)) as usize), align_of<StrView>()) as *mut StrView;
        let mut i: usize = 0;
        while i < diag.help_count {
            let src_h = unsafe { *((diag.helps as usize + (((i as isize) * (size_of<StrView>() as isize)) as usize)) as *const StrView) };
            let dst_h_ptr = ((helps_mem as usize) + (((i as isize) * (size_of<StrView>() as isize)) as usize)) as *mut StrView;
            unsafe {
                *dst_h_ptr = copy_str_view(mut_view(sink.arena), src_h);
            }
            i = i + 1;
        }
        d.helps = helps_mem;
    }

    // Deep copy fixes
    if diag.fix_count > 0 && diag.fixes as usize != 0 {
        let fixes_mem = arena_alloc_raw(mut_view(sink.arena), (((diag.fix_count as isize) * (size_of<DiagFix>() as isize)) as usize), align_of<DiagFix>()) as *mut DiagFix;
        let mut i: usize = 0;
        while i < diag.fix_count {
            let src_f = unsafe { *((diag.fixes as usize + (((i as isize) * (size_of<DiagFix>() as isize)) as usize)) as *const DiagFix) };
            let dst_f_ptr = ((fixes_mem as usize) + (((i as isize) * (size_of<DiagFix>() as isize)) as usize)) as *mut DiagFix;
            let mut edits_mem = 0 as *mut DiagEdit;
            if src_f.edit_count > 0 && src_f.edits as usize != 0 {
                edits_mem = arena_alloc_raw(mut_view(sink.arena), (((src_f.edit_count as isize) * (size_of<DiagEdit>() as isize)) as usize), align_of<DiagEdit>()) as *mut DiagEdit;
                let mut j: usize = 0;
                while j < src_f.edit_count {
                    let src_e = unsafe { *((src_f.edits as usize + (((j as isize) * (size_of<DiagEdit>() as isize)) as usize)) as *const DiagEdit) };
                    let dst_e_ptr = ((edits_mem as usize) + (((j as isize) * (size_of<DiagEdit>() as isize)) as usize)) as *mut DiagEdit;
                    unsafe {
                        *dst_e_ptr = DiagEdit {
                            span: src_e.span,
                            replacement: copy_str_view(mut_view(sink.arena), src_e.replacement),
                        };
                    }
                    j = j + 1;
                }
            }
            unsafe {
                *dst_f_ptr = DiagFix {
                    message: copy_str_view(mut_view(sink.arena), src_f.message),
                    applicability: src_f.applicability,
                    edits: edits_mem,
                    edit_count: src_f.edit_count,
                };
            }
            i = i + 1;
        }
        d.fixes = fixes_mem;
    }

    // Deep copy data
    if diag.data_count > 0 && diag.data as usize != 0 {
        let data_mem = arena_alloc_raw(mut_view(sink.arena), (((diag.data_count as isize) * (size_of<DiagDataEntry>() as isize)) as usize), align_of<DiagDataEntry>()) as *mut DiagDataEntry;
        let mut i: usize = 0;
        while i < diag.data_count {
            let src_entry = unsafe { *((diag.data as usize + (((i as isize) * (size_of<DiagDataEntry>() as isize)) as usize)) as *const DiagDataEntry) };
            let dst_entry_ptr = ((data_mem as usize) + (((i as isize) * (size_of<DiagDataEntry>() as isize)) as usize)) as *mut DiagDataEntry;
            let mut val = DiagDataValue {
                kind: src_entry.value.kind,
                str_val: StrView { ptr: 0 as *const u8, len: 0 },
                int_val: src_entry.value.int_val,
                bool_val: src_entry.value.bool_val,
                list_items: 0 as *mut StrView,
                list_count: src_entry.value.list_count,
            };
            match src_entry.value.kind {
                DiagDataKind.String => {
                    val.str_val = copy_str_view(mut_view(sink.arena), src_entry.value.str_val);
                },
                DiagDataKind.StringList => {
                    if src_entry.value.list_count > 0 && src_entry.value.list_items as usize != 0 {
                        let items_mem = arena_alloc_raw(mut_view(sink.arena), (((src_entry.value.list_count as isize) * (size_of<StrView>() as isize)) as usize), align_of<StrView>()) as *mut StrView;
                        let mut k: usize = 0;
                        while k < src_entry.value.list_count {
                            let item = unsafe { *((src_entry.value.list_items as usize + (((k as isize) * (size_of<StrView>() as isize)) as usize)) as *const StrView) };
                            let dst_item_ptr = ((items_mem as usize) + (((k as isize) * (size_of<StrView>() as isize)) as usize)) as *mut StrView;
                            unsafe {
                                *dst_item_ptr = copy_str_view(mut_view(sink.arena), item);
                            }
                            k = k + 1;
                        }
                        val.list_items = items_mem;
                    }
                },
                _ => {},
            }
            unsafe {
                *dst_entry_ptr = DiagDataEntry {
                    key: copy_str_view(mut_view(sink.arena), src_entry.key),
                    value: val,
                };
            }
            i = i + 1;
        }
        d.data = data_mem;
    }

    let sev = d.severity;
    unsafe {
        *(diag_ptr(sink.diags, sink.len)) = d;
    }
    sink.len = sink.len + 1;

    match sev {
        DiagSeverity.Error => { sink.errors = sink.errors + 1; },
        DiagSeverity.Warning => { sink.warnings = sink.warnings + 1; },
        _ => {},
    }
}

fn diag_less(da: view<Diagnostic>, db: view<Diagnostic>) -> bool {
    let da_none = da.primary.file.v == 0u32;
    let db_none = db.primary.file.v == 0u32;
    if da_none != db_none {
        return da_none;
    }
    if !da_none {
        let fa: u32 = da.primary.file.v;
        let fb: u32 = db.primary.file.v;
        if fa < fb { return true; }
        if fa > fb { return false; }

        let sa: u32 = da.primary.start;
        let sb: u32 = db.primary.start;
        if sa < sb { return true; }
        if sa > sb { return false; }
    }
    let ca = da.code.v;
    let cb = db.code.v;
    if ca < cb { return true; }
    false
}

pub fn diag_sink_sort(sink: mut_view<DiagSink>) {
    if sink.len <= 1 {
        return;
    }
    // Stable insertion sort
    let mut i: usize = 1;
    while i < sink.len {
        let current = unsafe { *(diag_ptr(sink.diags, i)) };
        let mut j: usize = i;
        while j > 0 {
            let prev = unsafe { *(diag_ptr(sink.diags, j - 1)) };
            if diag_less(view(current), view(prev)) {
                unsafe {
                    *(diag_ptr(sink.diags, j)) = prev;
                }
                j = j - 1;
            } else {
                break;
            }
        }
        unsafe {
            *(diag_ptr(sink.diags, j)) = current;
        }
        i = i + 1;
    }
}

pub fn diag_sink_has_errors(sink: view<DiagSink>) -> bool {
    sink.errors > 0
}

pub fn diag_sink_error_count(sink: view<DiagSink>) -> usize {
    sink.errors
}

pub fn diag_sink_warning_count(sink: view<DiagSink>) -> usize {
    sink.warnings
}

pub fn diag_sink_count(sink: view<DiagSink>) -> usize {
    sink.len
}

pub fn diag_sink_get(sink: view<DiagSink>, idx: usize) -> Diagnostic {
    if idx >= sink.len {
        return diag_new(diag_code(0u32), span_none(), StrView { ptr: 0 as *const u8, len: 0 });
    }
    unsafe { *(diag_ptr(sink.diags, idx)) }
}

// Axiom Compiler — Target-Neutral Object Model & COFF Definitions (compiler/obj/coff.ax)
// Port of bootstrap/axiom0/src/objmodel/objmodel.h, bootstrap/axiom0/src/objmodel/objmodel.c,
// and COFF structures/constants from bootstrap/axiom0/src/obj/coff/writer.c and pe_defs.h.
module compiler.obj.coff

use host_intrinsics.heap_alloc
use host_intrinsics.heap_free

use compiler.kernel.arena.Arena
use compiler.kernel.arena.arena_new
use compiler.kernel.arena.arena_alloc_raw
use compiler.kernel.arena.arena_destroy
pub use compiler.kernel.id.SymbolId

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub fn coff_mul_usize(a: usize, b: usize) -> usize {
    ((a as isize) * (b as isize)) as usize
}

pub fn coff_mul_u32(a: u32, b: u32) -> u32 {
    ((a as i32) * (b as i32)) as u32
}

// --- Growable Binary Byte Buffer for Object Emission (CoffBuf) ---

pub struct CoffBuf {
    pub ptr: *mut u8,
    pub len: usize,
    pub cap: usize,
}

pub fn coff_buf_new() -> CoffBuf {
    CoffBuf {
        ptr: 0 as *mut u8,
        len: 0,
        cap: 0,
    }
}

pub fn coff_buf_with_capacity(capacity: usize) -> CoffBuf {
    if capacity == 0 {
        return coff_buf_new();
    }
    let raw = unsafe { heap_alloc(capacity, 8) };
    CoffBuf {
        ptr: raw,
        len: 0,
        cap: capacity,
    }
}

pub fn coff_buf_free(b: mut_view<CoffBuf>) {
    if b.cap > 0 && (b.ptr as usize) != 0 {
        unsafe {
            heap_free(b.ptr, b.cap, 8);
        }
    }
    b.ptr = 0 as *mut u8;
    b.len = 0;
    b.cap = 0;
}

impl Drop for CoffBuf {
    fn drop(self: mut_view<CoffBuf>) {
        coff_buf_free(self);
    }
}

pub fn coff_buf_clear(b: mut_view<CoffBuf>) {
    b.len = 0;
}

pub fn coff_buf_reserve(b: mut_view<CoffBuf>, additional: usize) {
    let needed = b.len + additional;
    if needed <= b.cap {
        return;
    }
    let mut new_cap = if b.cap == 0 { 64 } else { b.cap + b.cap };
    while new_cap < needed {
        new_cap = new_cap + new_cap;
    }
    let new_ptr = unsafe { heap_alloc(new_cap, 8) };
    if b.len > 0 && (b.ptr as usize) != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(b.ptr as *const u8, new_ptr, b.len);
            heap_free(b.ptr, b.cap, 8);
        }
    } else if b.cap > 0 && (b.ptr as usize) != 0 {
        unsafe {
            heap_free(b.ptr, b.cap, 8);
        }
    }
    b.ptr = new_ptr;
    b.cap = new_cap;
}

pub fn coff_buf_put_u8(b: mut_view<CoffBuf>, val: u8) {
    if b.len == b.cap {
        coff_buf_reserve(mut_view(*b), 1);
    }
    unsafe {
        *(b.ptr + b.len) = val;
    }
    b.len = b.len + 1;
}

pub fn coff_buf_put_u16(b: mut_view<CoffBuf>, val: u16) {
    if b.len + 2 > b.cap {
        coff_buf_reserve(mut_view(*b), 2);
    }
    unsafe {
        let p = b.ptr + b.len;
        *p = (val & 0xFFu16) as u8;
        *(p + 1) = ((val >> 8) & 0xFFu16) as u8;
    }
    b.len = b.len + 2;
}

pub fn coff_buf_put_i16(b: mut_view<CoffBuf>, val: i16) {
    coff_buf_put_u16(b, val as u16);
}

pub fn coff_buf_put_u32(b: mut_view<CoffBuf>, val: u32) {
    if b.len + 4 > b.cap {
        coff_buf_reserve(mut_view(*b), 4);
    }
    unsafe {
        let p = b.ptr + b.len;
        *p = (val & 0xFFu32) as u8;
        *(p + 1) = ((val >> 8) & 0xFFu32) as u8;
        *(p + 2) = ((val >> 16) & 0xFFu32) as u8;
        *(p + 3) = ((val >> 24) & 0xFFu32) as u8;
    }
    b.len = b.len + 4;
}

pub fn coff_buf_put_u64(b: mut_view<CoffBuf>, val: u64) {
    coff_buf_put_u32(mut_view(*b), (val & 0xFFFFFFFFu64) as u32);
    coff_buf_put_u32(mut_view(*b), ((val >> 32) & 0xFFFFFFFFu64) as u32);
}

pub fn coff_buf_put_bytes(b: mut_view<CoffBuf>, src: *const u8, count: usize) {
    if count == 0 || (src as usize) == 0 {
        return;
    }
    coff_buf_reserve(mut_view(*b), count);
    unsafe {
        ptr_copy_nonoverlapping<u8>(src, b.ptr + b.len, count);
    }
    b.len = b.len + count;
}

// --- Typed Section & Symbol IDs (1-based; v == 0 is none) ---

pub struct SectionId {
    pub v: u32,
}

impl SectionId {
    pub fn none() -> SectionId { SectionId { v: 0u32 } }
    pub fn is_none(self: view<SectionId>) -> bool { self.v == 0u32 }
    pub fn is_some(self: view<SectionId>) -> bool { self.v != 0u32 }
    pub fn from_index(index: usize) -> SectionId { SectionId { v: (index + 1) as u32 } }
    pub fn index(self: view<SectionId>) -> usize { (self.v - 1u32) as usize }
    pub fn eq(self: view<SectionId>, other: view<SectionId>) -> bool { self.v == other.v }
    pub fn to_raw(self: view<SectionId>) -> u32 { self.v }
    pub fn from_raw(v: u32) -> SectionId { SectionId { v: v } }
}

pub fn ax_section_id_none() -> SectionId {
    SectionId { v: 0u32 }
}

pub fn ax_symbol_id_none() -> SymbolId {
    SymbolId { v: 0u32 }
}

pub fn ax_section_id_is_none(id: SectionId) -> bool {
    id.v == 0u32
}

pub fn ax_symbol_id_is_none(id: SymbolId) -> bool {
    id.v == 0u32
}

pub fn ax_section_id_eq(a: SectionId, b: SectionId) -> bool {
    a.v == b.v
}

pub fn ax_symbol_id_eq(a: SymbolId, b: SymbolId) -> bool {
    a.v == b.v
}

// --- Section Kinds (ax_section_kind_t) ---

pub const SEC_CODE: u32 = 0u32;
pub const SEC_DATA: u32 = 1u32;
pub const SEC_RODATA: u32 = 2u32;
pub const SEC_BSS: u32 = 3u32;

pub const AX_SEC_CODE: u32 = 0u32;
pub const AX_SEC_DATA: u32 = 1u32;
pub const AX_SEC_RODATA: u32 = 2u32;
pub const AX_SEC_BSS: u32 = 3u32;

// --- Section Flags (ax_section_flags_t) ---

pub const SEC_FLAG_NONE: u32 = 0u32;
pub const SEC_FLAG_EXEC: u32 = 1u32;
pub const SEC_FLAG_WRITE: u32 = 2u32;
pub const SEC_FLAG_READ: u32 = 4u32;

pub const AX_SEC_FLAG_NONE: u32 = 0u32;
pub const AX_SEC_FLAG_EXEC: u32 = 1u32;
pub const AX_SEC_FLAG_WRITE: u32 = 2u32;
pub const AX_SEC_FLAG_READ: u32 = 4u32;

// --- Relocation Kinds (ax_reloc_kind_t) ---

pub const RELOC_NONE: u32 = 0u32;
pub const RELOC_X86_64_PC32: u32 = 1u32;
pub const RELOC_X86_64_32: u32 = 2u32;
pub const RELOC_X86_64_64: u32 = 3u32;
pub const RELOC_X86_64_GOT32: u32 = 4u32;
pub const RELOC_X86_64_PLT32: u32 = 5u32;

pub const AX_RELOC_NONE: u32 = 0u32;
pub const AX_RELOC_X86_64_PC32: u32 = 1u32;
pub const AX_RELOC_X86_64_32: u32 = 2u32;
pub const AX_RELOC_X86_64_64: u32 = 3u32;
pub const AX_RELOC_X86_64_GOT32: u32 = 4u32;
pub const AX_RELOC_X86_64_PLT32: u32 = 5u32;

// --- Symbol Linkage (ax_symbol_linkage_t) ---

pub const SYM_LOCAL: u32 = 0u32;
pub const SYM_GLOBAL: u32 = 1u32;
pub const SYM_EXTERNAL: u32 = 2u32;

pub const AX_SYM_LOCAL: u32 = 0u32;
pub const AX_SYM_GLOBAL: u32 = 1u32;
pub const AX_SYM_EXTERNAL: u32 = 2u32;

// --- COFF Binary Format Constants ---

pub const COFF_FILE_HEADER_SIZE: usize = 20;
pub const COFF_SECTION_HEADER_SIZE: usize = 40;
pub const COFF_RELOC_SIZE: usize = 10;
pub const COFF_SYMBOL_SIZE: usize = 18;

pub const IMAGE_FILE_MACHINE_AMD64: u16 = 0x8664u16;

pub const IMAGE_SCN_CNT_CODE: u32 = 0x00000020u32;
pub const IMAGE_SCN_CNT_INITIALIZED_DATA: u32 = 0x00000040u32;
pub const IMAGE_SCN_CNT_UNINITIALIZED_DATA: u32 = 0x00000080u32;

pub const IMAGE_SCN_ALIGN_1BYTES: u32 = 0x00100000u32;
pub const IMAGE_SCN_ALIGN_2BYTES: u32 = 0x00200000u32;
pub const IMAGE_SCN_ALIGN_4BYTES: u32 = 0x00300000u32;
pub const IMAGE_SCN_ALIGN_8BYTES: u32 = 0x00400000u32;
pub const IMAGE_SCN_ALIGN_16BYTES: u32 = 0x00500000u32;
pub const IMAGE_SCN_ALIGN_32BYTES: u32 = 0x00600000u32;
pub const IMAGE_SCN_ALIGN_64BYTES: u32 = 0x00700000u32;
pub const IMAGE_SCN_ALIGN_MASK: u32 = 0x00F00000u32;

pub const IMAGE_SCN_MEM_EXECUTE: u32 = 0x20000000u32;
pub const IMAGE_SCN_MEM_READ: u32 = 0x40000000u32;
pub const IMAGE_SCN_MEM_WRITE: u32 = 0x80000000u32;

pub const IMAGE_SYM_CLASS_EXTERNAL: u8 = 2u8;
pub const IMAGE_SYM_CLASS_STATIC: u8 = 3u8;

pub const IMAGE_REL_AMD64_ABSOLUTE: u16 = 0x0000u16;
pub const IMAGE_REL_AMD64_ADDR64: u16 = 0x0001u16;
pub const IMAGE_REL_AMD64_ADDR32: u16 = 0x0002u16;
pub const IMAGE_REL_AMD64_ADDR32NB: u16 = 0x0003u16;
pub const IMAGE_REL_AMD64_REL32: u16 = 0x0004u16;

// --- COFF Binary Header & Record Structures ---

pub struct CoffFileHeader {
    pub machine: u16,
    pub number_of_sections: u16,
    pub time_date_stamp: u32,
    pub pointer_to_symbol_table: u32,
    pub number_of_symbols: u32,
    pub size_of_optional_header: u16,
    pub characteristics: u16,
}

pub struct CoffSectionHeader {
    pub name: [8]u8,
    pub virtual_size: u32,
    pub virtual_address: u32,
    pub size_of_raw_data: u32,
    pub pointer_to_raw_data: u32,
    pub pointer_to_relocations: u32,
    pub pointer_to_linenumbers: u32,
    pub number_of_relocations: u16,
    pub number_of_linenumbers: u16,
    pub characteristics: u32,
}

pub struct CoffRelocation {
    pub virtual_address: u32,
    pub symbol_table_index: u32,
    pub reloc_type: u16,
}

pub struct CoffSymbolRecord {
    pub name_bytes: [8]u8,
    pub zeroes: u32,
    pub offset: u32,
    pub value: u32,
    pub section_number: i16,
    pub sym_type: u16,
    pub storage_class: u8,
    pub number_of_aux_symbols: u8,
}

// --- COFF Mapping & Little-Endian Binary Helpers ---

pub fn coff_align_flag(align: u32) -> u32 {
    match align {
        1u32 => IMAGE_SCN_ALIGN_1BYTES,
        2u32 => IMAGE_SCN_ALIGN_2BYTES,
        4u32 => IMAGE_SCN_ALIGN_4BYTES,
        8u32 => IMAGE_SCN_ALIGN_8BYTES,
        16u32 => IMAGE_SCN_ALIGN_16BYTES,
        32u32 => IMAGE_SCN_ALIGN_32BYTES,
        64u32 => IMAGE_SCN_ALIGN_64BYTES,
        _ => 0u32,
    }
}

pub fn coff_section_characteristics(kind: u32, flags: u32, align: u32) -> u32 {
    let mut chars: u32 = coff_align_flag(align);
    if kind == AX_SEC_CODE {
        chars = chars | IMAGE_SCN_CNT_CODE;
    } else if kind == AX_SEC_DATA || kind == AX_SEC_RODATA {
        chars = chars | IMAGE_SCN_CNT_INITIALIZED_DATA;
    } else if kind == AX_SEC_BSS {
        chars = chars | IMAGE_SCN_CNT_UNINITIALIZED_DATA;
    }
    if (flags & AX_SEC_FLAG_EXEC) != 0u32 {
        chars = chars | IMAGE_SCN_MEM_EXECUTE;
    }
    if (flags & AX_SEC_FLAG_READ) != 0u32 {
        chars = chars | IMAGE_SCN_MEM_READ;
    }
    if (flags & AX_SEC_FLAG_WRITE) != 0u32 {
        chars = chars | IMAGE_SCN_MEM_WRITE;
    }
    chars
}

pub fn coff_reloc_type(kind: u32) -> u16 {
    if kind == AX_RELOC_X86_64_PC32 || kind == AX_RELOC_X86_64_PLT32 {
        IMAGE_REL_AMD64_REL32
    } else if kind == AX_RELOC_X86_64_64 {
        IMAGE_REL_AMD64_ADDR64
    } else if kind == AX_RELOC_X86_64_32 {
        IMAGE_REL_AMD64_ADDR32NB
    } else {
        IMAGE_REL_AMD64_ABSOLUTE
    }
}

pub fn coff_storage_class(linkage: u32) -> u8 {
    if linkage == AX_SYM_EXTERNAL || linkage == AX_SYM_GLOBAL {
        IMAGE_SYM_CLASS_EXTERNAL
    } else {
        IMAGE_SYM_CLASS_STATIC
    }
}

pub fn coff_read_u16_le(buf: *const u8, off: usize) -> u16 {
    let b0 = (unsafe { *(buf + off) }) as u16;
    let b1 = (unsafe { *(buf + off + 1) }) as u16;
    b0 | (b1 << 8)
}

pub fn coff_read_u32_le(buf: *const u8, off: usize) -> u32 {
    let b0 = (unsafe { *(buf + off) }) as u32;
    let b1 = (unsafe { *(buf + off + 1) }) as u32;
    let b2 = (unsafe { *(buf + off + 2) }) as u32;
    let b3 = (unsafe { *(buf + off + 3) }) as u32;
    b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

pub fn coff_read_i32_le(buf: *const u8, off: usize) -> i32 {
    coff_read_u32_le(buf, off) as i32
}

pub fn coff_read_u64_le(buf: *const u8, off: usize) -> u64 {
    let lo = coff_read_u32_le(buf, off) as u64;
    let hi = coff_read_u32_le(buf, off + 4) as u64;
    lo | (hi << 32)
}

pub fn coff_write_u16_le(buf: *mut u8, off: usize, val: u16) {
    unsafe {
        *(buf + off) = (val & 0xFFu16) as u8;
        *(buf + off + 1) = ((val >> 8) & 0xFFu16) as u8;
    }
}

pub fn coff_write_u32_le(buf: *mut u8, off: usize, val: u32) {
    unsafe {
        *(buf + off) = (val & 0xFFu32) as u8;
        *(buf + off + 1) = ((val >> 8) & 0xFFu32) as u8;
        *(buf + off + 2) = ((val >> 16) & 0xFFu32) as u8;
        *(buf + off + 3) = ((val >> 24) & 0xFFu32) as u8;
    }
}

pub fn coff_write_u64_le(buf: *mut u8, off: usize, val: u64) {
    coff_write_u32_le(buf, off, (val & 0xFFFFFFFFu64) as u32);
    coff_write_u32_le(buf, off + 4, ((val >> 32) & 0xFFFFFFFFu64) as u32);
}

pub fn coff_decode_file_header(buf: *const u8, off: usize) -> CoffFileHeader {
    CoffFileHeader {
        machine: coff_read_u16_le(buf, off),
        number_of_sections: coff_read_u16_le(buf, off + 2),
        time_date_stamp: coff_read_u32_le(buf, off + 4),
        pointer_to_symbol_table: coff_read_u32_le(buf, off + 8),
        number_of_symbols: coff_read_u32_le(buf, off + 12),
        size_of_optional_header: coff_read_u16_le(buf, off + 16),
        characteristics: coff_read_u16_le(buf, off + 18),
    }
}

pub fn coff_decode_section_header(buf: *const u8, off: usize) -> CoffSectionHeader {
    let mut name: [8]u8 = [0u8; 8];
    let mut i: usize = 0;
    while i < 8 {
        name[i] = unsafe { *(buf + off + i) };
        i = i + 1;
    }
    CoffSectionHeader {
        name: name,
        virtual_size: coff_read_u32_le(buf, off + 8),
        virtual_address: coff_read_u32_le(buf, off + 12),
        size_of_raw_data: coff_read_u32_le(buf, off + 16),
        pointer_to_raw_data: coff_read_u32_le(buf, off + 20),
        pointer_to_relocations: coff_read_u32_le(buf, off + 24),
        pointer_to_linenumbers: coff_read_u32_le(buf, off + 28),
        number_of_relocations: coff_read_u16_le(buf, off + 32),
        number_of_linenumbers: coff_read_u16_le(buf, off + 34),
        characteristics: coff_read_u32_le(buf, off + 36),
    }
}

pub fn coff_decode_relocation(buf: *const u8, off: usize) -> CoffRelocation {
    CoffRelocation {
        virtual_address: coff_read_u32_le(buf, off),
        symbol_table_index: coff_read_u32_le(buf, off + 4),
        reloc_type: coff_read_u16_le(buf, off + 8),
    }
}

pub fn coff_decode_symbol_record(buf: *const u8, off: usize) -> CoffSymbolRecord {
    let mut name_bytes: [8]u8 = [0u8; 8];
    let mut i: usize = 0;
    while i < 8 {
        name_bytes[i] = unsafe { *(buf + off + i) };
        i = i + 1;
    }
    CoffSymbolRecord {
        name_bytes: name_bytes,
        zeroes: coff_read_u32_le(buf, off),
        offset: coff_read_u32_le(buf, off + 4),
        value: coff_read_u32_le(buf, off + 8),
        section_number: coff_read_u16_le(buf, off + 12) as i16,
        sym_type: coff_read_u16_le(buf, off + 14),
        storage_class: unsafe { *(buf + off + 16) },
        number_of_aux_symbols: unsafe { *(buf + off + 17) },
    }
}

// --- String Helpers ---

pub fn cstr_len(s: *const u8) -> usize {
    if s as usize == 0 {
        return 0;
    }
    let mut n: usize = 0;
    while unsafe { *(s + n) } != 0u8 {
        n = n + 1;
    }
    n
}

pub fn bytes_eq(a: *const u8, a_len: usize, b: *const u8, b_len: usize) -> bool {
    if a_len != b_len {
        return false;
    }
    if a_len == 0 {
        return true;
    }
    if a as usize == 0 || b as usize == 0 {
        return (a as usize) == (b as usize);
    }
    let mut i: usize = 0;
    while i < a_len {
        if unsafe { *(a + i) } != unsafe { *(b + i) } {
            return false;
        }
        i = i + 1;
    }
    true
}

pub fn cstr_eq(a: *const u8, b: *const u8) -> bool {
    bytes_eq(a, cstr_len(a), b, cstr_len(b))
}

fn dup_cstr_in_arena(a: mut_view<Arena>, src: *const u8, n: usize) -> *const u8 {
    let dst = arena_alloc_raw(a, n + 1, 1);
    if n > 0 && src as usize != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(src, dst, n);
        }
    }
    unsafe {
        *(dst + n) = 0u8;
    }
    dst as *const u8
}

// --- Object Model Data Structures (Reloc, Section, ObjSymbol, ObjModel) ---
// Field names match bootstrap/axiom0/src/objmodel/objmodel.h exactly.

pub struct Reloc {
    pub offset: u32,
    pub kind: u32,
    pub symbol_id: SymbolId,
    pub addend: i64,
}

pub struct Section {
    pub id: SectionId,
    pub name: *const u8,
    pub name_len: usize,
    pub kind: u32,
    pub flags: u32,
    pub align: u32,
    pub bytes: *mut u8,
    pub bytes_len: usize,
    pub bytes_cap: usize,
    pub relocs: *mut Reloc,
    pub relocs_len: usize,
    pub relocs_cap: usize,
}

pub struct ObjSymbol {
    pub id: SymbolId,
    pub name: *const u8,
    pub name_len: usize,
    pub section_id: SectionId,
    pub value: u64,
    pub size: u64,
    pub linkage: u32,
}

pub struct ObjModel {
    pub sections: *mut Section,
    pub sections_len: usize,
    pub sections_cap: usize,
    pub symbols: *mut ObjSymbol,
    pub symbols_len: usize,
    pub symbols_cap: usize,
    pub str_arena: *mut Arena,
}

// --- Object Model Lifecycle ---

fn alloc_str_arena() -> *mut Arena {
    let a = unsafe { heap_alloc(size_of<Arena>(), align_of<Arena>()) as *mut Arena };
    unsafe {
        *a = arena_new();
    }
    a
}

fn ensure_str_arena(model: mut_view<ObjModel>) -> *mut Arena {
    if (model.str_arena as usize) == 0 {
        model.str_arena = alloc_str_arena();
    }
    model.str_arena
}

pub fn objmodel_new() -> ObjModel {
    ObjModel {
        sections: 0 as *mut Section,
        sections_len: 0,
        sections_cap: 0,
        symbols: 0 as *mut ObjSymbol,
        symbols_len: 0,
        symbols_cap: 0,
        str_arena: alloc_str_arena(),
    }
}

pub fn objmodel_init(model: mut_view<ObjModel>) {
    model.sections = 0 as *mut Section;
    model.sections_len = 0;
    model.sections_cap = 0;
    model.symbols = 0 as *mut ObjSymbol;
    model.symbols_len = 0;
    model.symbols_cap = 0;
    model.str_arena = alloc_str_arena();
}

pub fn ax_objmodel_init(model: mut_view<ObjModel>) {
    objmodel_init(model);
}

unsafe fn section_slot_ptr(base: *mut Section, idx0: usize) -> *mut Section {
    ((base as usize) + coff_mul_usize(idx0, size_of<Section>())) as *mut Section
}

unsafe fn symbol_slot_ptr(base: *mut ObjSymbol, idx0: usize) -> *mut ObjSymbol {
    ((base as usize) + coff_mul_usize(idx0, size_of<ObjSymbol>())) as *mut ObjSymbol
}

pub fn objmodel_free(model: mut_view<ObjModel>) {
    let mut i: usize = 0;
    while i < model.sections_len {
        let sec = unsafe { section_slot_ptr(model.sections, i) };
        unsafe {
            if (*sec).bytes_cap > 0 && ((*sec).bytes as usize) != 0 {
                heap_free((*sec).bytes, (*sec).bytes_cap, 1);
            }
            (*sec).bytes = 0 as *mut u8;
            (*sec).bytes_len = 0;
            (*sec).bytes_cap = 0;

            if (*sec).relocs_cap > 0 && ((*sec).relocs as usize) != 0 {
                heap_free(
                    (*sec).relocs as *mut u8,
                    coff_mul_usize((*sec).relocs_cap, size_of<Reloc>()),
                    align_of<Reloc>()
                );
            }
            (*sec).relocs = 0 as *mut Reloc;
            (*sec).relocs_len = 0;
            (*sec).relocs_cap = 0;
        }
        i = i + 1;
    }
    if model.sections_cap > 0 && (model.sections as usize) != 0 {
        unsafe {
            heap_free(
                model.sections as *mut u8,
                coff_mul_usize(model.sections_cap, size_of<Section>()),
                align_of<Section>()
            );
        }
    }
    model.sections = 0 as *mut Section;
    model.sections_len = 0;
    model.sections_cap = 0;

    if model.symbols_cap > 0 && (model.symbols as usize) != 0 {
        unsafe {
            heap_free(
                model.symbols as *mut u8,
                coff_mul_usize(model.symbols_cap, size_of<ObjSymbol>()),
                align_of<ObjSymbol>()
            );
        }
    }
    model.symbols = 0 as *mut ObjSymbol;
    model.symbols_len = 0;
    model.symbols_cap = 0;

    if (model.str_arena as usize) != 0 {
        unsafe {
            arena_destroy(mut_view(*model.str_arena));
            heap_free(model.str_arena as *mut u8, size_of<Arena>(), align_of<Arena>());
        }
        model.str_arena = 0 as *mut Arena;
    }
}

pub fn ax_objmodel_free(model: mut_view<ObjModel>) {
    objmodel_free(model);
}

impl Drop for ObjModel {
    fn drop(self: mut_view<ObjModel>) {
        objmodel_free(self);
    }
}

pub fn objmodel_section_count(model: view<ObjModel>) -> usize {
    model.sections_len
}

pub fn objmodel_symbol_count(model: view<ObjModel>) -> usize {
    model.symbols_len
}

// --- Section Operations ---

fn objmodel_reserve_sections(model: mut_view<ObjModel>, min_cap: usize) {
    if min_cap <= model.sections_cap {
        return;
    }
    let mut new_cap = if model.sections_cap == 0 { 4 } else { model.sections_cap + model.sections_cap };
    while new_cap < min_cap {
        new_cap = new_cap + new_cap;
    }
    let s_sz = size_of<Section>();
    let s_al = align_of<Section>();
    let new_buf = unsafe { heap_alloc(coff_mul_usize(new_cap, s_sz), s_al) as *mut Section };
    if model.sections_len > 0 && (model.sections as usize) != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(
                model.sections as *const u8,
                new_buf as *mut u8,
                coff_mul_usize(model.sections_len, s_sz)
            );
            heap_free(model.sections as *mut u8, coff_mul_usize(model.sections_cap, s_sz), s_al);
        }
    } else if model.sections_cap > 0 && (model.sections as usize) != 0 {
        unsafe {
            heap_free(model.sections as *mut u8, coff_mul_usize(model.sections_cap, s_sz), s_al);
        }
    }
    model.sections = new_buf;
    model.sections_cap = new_cap;
}

pub fn objmodel_add_section_bytes(
    model: mut_view<ObjModel>,
    name: *const u8,
    name_len: usize,
    kind: u32,
    flags: u32,
    align: u32
) -> SectionId {
    let arena_ptr = ensure_str_arena(mut_view(*model));
    let owned_name = unsafe { dup_cstr_in_arena(mut_view(*arena_ptr), name, name_len) };
    if model.sections_len == model.sections_cap {
        objmodel_reserve_sections(mut_view(*model), model.sections_len + 1);
    }
    let idx0 = model.sections_len;
    let raw_id = (idx0 + 1) as u32;
    let sec_ptr = unsafe { section_slot_ptr(model.sections, idx0) };
    unsafe {
        (*sec_ptr).id = SectionId { v: raw_id };
        (*sec_ptr).name = owned_name;
        (*sec_ptr).name_len = name_len;
        (*sec_ptr).kind = kind;
        (*sec_ptr).flags = flags;
        (*sec_ptr).align = align;
        (*sec_ptr).bytes = 0 as *mut u8;
        (*sec_ptr).bytes_len = 0;
        (*sec_ptr).bytes_cap = 0;
        (*sec_ptr).relocs = 0 as *mut Reloc;
        (*sec_ptr).relocs_len = 0;
        (*sec_ptr).relocs_cap = 0;
    }
    model.sections_len = idx0 + 1;
    SectionId { v: raw_id }
}

pub fn objmodel_add_section(
    model: mut_view<ObjModel>,
    name: *const u8,
    kind: u32,
    flags: u32,
    align: u32
) -> SectionId {
    objmodel_add_section_bytes(model, name, cstr_len(name), kind, flags, align)
}

pub fn ax_objmodel_add_section(
    model: mut_view<ObjModel>,
    name: *const u8,
    kind: u32,
    flags: u32,
    align: u32
) -> SectionId {
    objmodel_add_section(model, name, kind, flags, align)
}

pub fn objmodel_add_section_str(
    model: mut_view<ObjModel>,
    name: Str,
    kind: u32,
    flags: u32,
    align: u32
) -> SectionId {
    let bytes: view<[u8]> = unsafe { *(address_of(name) as *const view<[u8]>) };
    let nlen = len(bytes);
    let arena_ptr = ensure_str_arena(mut_view(*model));
    let dst = unsafe { arena_alloc_raw(mut_view(*arena_ptr), nlen + 1, 1) };
    let mut i: usize = 0;
    while i < nlen {
        unsafe {
            *(dst + i) = bytes[i];
        }
        i = i + 1;
    }
    unsafe {
        *(dst + nlen) = 0u8;
    }
    if model.sections_len == model.sections_cap {
        objmodel_reserve_sections(mut_view(*model), model.sections_len + 1);
    }
    let idx0 = model.sections_len;
    let raw_id = (idx0 + 1) as u32;
    let sec_ptr = unsafe { section_slot_ptr(model.sections, idx0) };
    unsafe {
        (*sec_ptr).id = SectionId { v: raw_id };
        (*sec_ptr).name = dst as *const u8;
        (*sec_ptr).name_len = nlen;
        (*sec_ptr).kind = kind;
        (*sec_ptr).flags = flags;
        (*sec_ptr).align = align;
        (*sec_ptr).bytes = 0 as *mut u8;
        (*sec_ptr).bytes_len = 0;
        (*sec_ptr).bytes_cap = 0;
        (*sec_ptr).relocs = 0 as *mut Reloc;
        (*sec_ptr).relocs_len = 0;
        (*sec_ptr).relocs_cap = 0;
    }
    model.sections_len = idx0 + 1;
    SectionId { v: raw_id }
}

pub fn objmodel_get_section(model: view<ObjModel>, id: SectionId) -> *const Section {
    if id.v == 0u32 || (id.v as usize) > model.sections_len {
        return 0 as *const Section;
    }
    unsafe { section_slot_ptr(model.sections, (id.v - 1u32) as usize) as *const Section }
}

pub fn ax_objmodel_get_section_const(model: view<ObjModel>, id: SectionId) -> *const Section {
    objmodel_get_section(model, id)
}

pub fn objmodel_get_section_mut(model: mut_view<ObjModel>, id: SectionId) -> *mut Section {
    if id.v == 0u32 || (id.v as usize) > model.sections_len {
        return 0 as *mut Section;
    }
    unsafe { section_slot_ptr(model.sections, (id.v - 1u32) as usize) }
}

pub fn ax_objmodel_get_section(model: mut_view<ObjModel>, id: SectionId) -> *mut Section {
    objmodel_get_section_mut(model, id)
}

pub fn objmodel_find_section_bytes(model: view<ObjModel>, name: *const u8, name_len: usize) -> SectionId {
    let count = model.sections_len;
    let mut i: usize = 0;
    while i < count {
        let sec = unsafe { section_slot_ptr(model.sections, i) as *const Section };
        let sec_name = unsafe { (*sec).name };
        let sec_len = cstr_len(sec_name);
        if bytes_eq(sec_name, sec_len, name, name_len) {
            return SectionId { v: (i + 1) as u32 };
        }
        i = i + 1;
    }
    SectionId.none()
}

pub fn objmodel_find_section(model: view<ObjModel>, name: *const u8) -> SectionId {
    objmodel_find_section_bytes(model, name, cstr_len(name))
}

pub fn ax_objmodel_find_section(model: view<ObjModel>, name: *const u8) -> SectionId {
    objmodel_find_section(model, name)
}

pub fn objmodel_find_section_str(model: view<ObjModel>, name: Str) -> SectionId {
    let bytes: view<[u8]> = unsafe { *(address_of(name) as *const view<[u8]>) };
    let nlen = len(bytes);
    let count = model.sections_len;
    let mut i: usize = 0;
    while i < count {
        let sec = unsafe { section_slot_ptr(model.sections, i) as *const Section };
        let sec_name = unsafe { (*sec).name };
        let sec_len = cstr_len(sec_name);
        if sec_len == nlen {
            let mut matched: bool = true;
            let mut k: usize = 0;
            while k < nlen {
                if (unsafe { *(sec_name + k) }) != bytes[k] {
                    matched = false;
                    break;
                }
                k = k + 1;
            }
            if matched {
                return SectionId { v: (i + 1) as u32 };
            }
        }
        i = i + 1;
    }
    SectionId.none()
}

// --- Symbol Operations (matching C signature: name, section_id, value, size, linkage) ---

fn objmodel_reserve_symbols(model: mut_view<ObjModel>, min_cap: usize) {
    if min_cap <= model.symbols_cap {
        return;
    }
    let mut new_cap = if model.symbols_cap == 0 { 8 } else { model.symbols_cap + model.symbols_cap };
    while new_cap < min_cap {
        new_cap = new_cap + new_cap;
    }
    let sym_sz = size_of<ObjSymbol>();
    let sym_al = align_of<ObjSymbol>();
    let new_buf = unsafe { heap_alloc(coff_mul_usize(new_cap, sym_sz), sym_al) as *mut ObjSymbol };
    if model.symbols_len > 0 && (model.symbols as usize) != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(
                model.symbols as *const u8,
                new_buf as *mut u8,
                coff_mul_usize(model.symbols_len, sym_sz)
            );
            heap_free(model.symbols as *mut u8, coff_mul_usize(model.symbols_cap, sym_sz), sym_al);
        }
    } else if model.symbols_cap > 0 && (model.symbols as usize) != 0 {
        unsafe {
            heap_free(model.symbols as *mut u8, coff_mul_usize(model.symbols_cap, sym_sz), sym_al);
        }
    }
    model.symbols = new_buf;
    model.symbols_cap = new_cap;
}

pub fn objmodel_add_symbol_bytes(
    model: mut_view<ObjModel>,
    name: *const u8,
    name_len: usize,
    section_id: SectionId,
    value: u64,
    size: u64,
    linkage: u32
) -> SymbolId {
    let arena_ptr = ensure_str_arena(mut_view(*model));
    let owned_name = unsafe { dup_cstr_in_arena(mut_view(*arena_ptr), name, name_len) };
    if model.symbols_len == model.symbols_cap {
        objmodel_reserve_symbols(mut_view(*model), model.symbols_len + 1);
    }
    let idx0 = model.symbols_len;
    let raw_id = (idx0 + 1) as u32;
    let sym_ptr = unsafe { symbol_slot_ptr(model.symbols, idx0) };
    unsafe {
        (*sym_ptr).id = SymbolId { v: raw_id };
        (*sym_ptr).name = owned_name;
        (*sym_ptr).name_len = name_len;
        (*sym_ptr).section_id = section_id;
        (*sym_ptr).value = value;
        (*sym_ptr).size = size;
        (*sym_ptr).linkage = linkage;
    }
    model.symbols_len = idx0 + 1;
    SymbolId { v: raw_id }
}

pub fn objmodel_add_symbol(
    model: mut_view<ObjModel>,
    name: *const u8,
    section_id: SectionId,
    value: u64,
    size: u64,
    linkage: u32
) -> SymbolId {
    objmodel_add_symbol_bytes(model, name, cstr_len(name), section_id, value, size, linkage)
}

pub fn ax_objmodel_add_symbol(
    model: mut_view<ObjModel>,
    name: *const u8,
    section_id: SectionId,
    value: u64,
    size: u64,
    linkage: u32
) -> SymbolId {
    objmodel_add_symbol(model, name, section_id, value, size, linkage)
}

pub fn objmodel_add_symbol_str(
    model: mut_view<ObjModel>,
    name: Str,
    section_id: SectionId,
    value: u64,
    size: u64,
    linkage: u32
) -> SymbolId {
    let bytes: view<[u8]> = unsafe { *(address_of(name) as *const view<[u8]>) };
    let nlen = len(bytes);
    let arena_ptr = ensure_str_arena(mut_view(*model));
    let dst = unsafe { arena_alloc_raw(mut_view(*arena_ptr), nlen + 1, 1) };
    let mut i: usize = 0;
    while i < nlen {
        unsafe {
            *(dst + i) = bytes[i];
        }
        i = i + 1;
    }
    unsafe {
        *(dst + nlen) = 0u8;
    }
    if model.symbols_len == model.symbols_cap {
        objmodel_reserve_symbols(mut_view(*model), model.symbols_len + 1);
    }
    let idx0 = model.symbols_len;
    let raw_id = (idx0 + 1) as u32;
    let sym_ptr = unsafe { symbol_slot_ptr(model.symbols, idx0) };
    unsafe {
        (*sym_ptr).id = SymbolId { v: raw_id };
        (*sym_ptr).name = dst as *const u8;
        (*sym_ptr).name_len = nlen;
        (*sym_ptr).section_id = section_id;
        (*sym_ptr).value = value;
        (*sym_ptr).size = size;
        (*sym_ptr).linkage = linkage;
    }
    model.symbols_len = idx0 + 1;
    SymbolId { v: raw_id }
}

pub fn objmodel_get_symbol(model: view<ObjModel>, id: SymbolId) -> *const ObjSymbol {
    if id.v == 0u32 || (id.v as usize) > model.symbols_len {
        return 0 as *const ObjSymbol;
    }
    unsafe { symbol_slot_ptr(model.symbols, (id.v - 1u32) as usize) as *const ObjSymbol }
}

pub fn ax_objmodel_get_symbol_const(model: view<ObjModel>, id: SymbolId) -> *const ObjSymbol {
    objmodel_get_symbol(model, id)
}

pub fn objmodel_get_symbol_mut(model: mut_view<ObjModel>, id: SymbolId) -> *mut ObjSymbol {
    if id.v == 0u32 || (id.v as usize) > model.symbols_len {
        return 0 as *mut ObjSymbol;
    }
    unsafe { symbol_slot_ptr(model.symbols, (id.v - 1u32) as usize) }
}

pub fn ax_objmodel_get_symbol(model: mut_view<ObjModel>, id: SymbolId) -> *mut ObjSymbol {
    objmodel_get_symbol_mut(model, id)
}

pub fn objmodel_find_symbol_bytes(model: view<ObjModel>, name: *const u8, name_len: usize) -> SymbolId {
    let count = model.symbols_len;
    let mut i: usize = 0;
    while i < count {
        let sym = unsafe { symbol_slot_ptr(model.symbols, i) as *const ObjSymbol };
        let sym_name = unsafe { (*sym).name };
        let sym_len = cstr_len(sym_name);
        if bytes_eq(sym_name, sym_len, name, name_len) {
            return SymbolId { v: (i + 1) as u32 };
        }
        i = i + 1;
    }
    SymbolId.none()
}

pub fn objmodel_find_symbol(model: view<ObjModel>, name: *const u8) -> SymbolId {
    objmodel_find_symbol_bytes(model, name, cstr_len(name))
}

pub fn ax_objmodel_find_symbol(model: view<ObjModel>, name: *const u8) -> SymbolId {
    objmodel_find_symbol(model, name)
}

pub fn objmodel_find_symbol_str(model: view<ObjModel>, name: Str) -> SymbolId {
    let bytes: view<[u8]> = unsafe { *(address_of(name) as *const view<[u8]>) };
    let nlen = len(bytes);
    let count = model.symbols_len;
    let mut i: usize = 0;
    while i < count {
        let sym = unsafe { symbol_slot_ptr(model.symbols, i) as *const ObjSymbol };
        let sym_name = unsafe { (*sym).name };
        let sym_len = cstr_len(sym_name);
        if sym_len == nlen {
            let mut matched: bool = true;
            let mut k: usize = 0;
            while k < nlen {
                if (unsafe { *(sym_name + k) }) != bytes[k] {
                    matched = false;
                    break;
                }
                k = k + 1;
            }
            if matched {
                return SymbolId { v: (i + 1) as u32 };
            }
        }
        i = i + 1;
    }
    SymbolId.none()
}

// --- Section Data & Relocation Helpers ---

fn section_reserve_bytes(sec: mut_view<Section>, min_cap: usize) {
    if min_cap <= sec.bytes_cap {
        return;
    }
    let mut new_cap = if sec.bytes_cap == 0 { 16 } else { sec.bytes_cap + sec.bytes_cap };
    while new_cap < min_cap {
        new_cap = new_cap + new_cap;
    }
    let new_buf = unsafe { heap_alloc(new_cap, 1) };
    if sec.bytes_len > 0 && (sec.bytes as usize) != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(sec.bytes as *const u8, new_buf, sec.bytes_len);
            heap_free(sec.bytes, sec.bytes_cap, 1);
        }
    } else if sec.bytes_cap > 0 && (sec.bytes as usize) != 0 {
        unsafe {
            heap_free(sec.bytes, sec.bytes_cap, 1);
        }
    }
    sec.bytes = new_buf;
    sec.bytes_cap = new_cap;
}

fn section_reserve_relocs(sec: mut_view<Section>, min_cap: usize) {
    if min_cap <= sec.relocs_cap {
        return;
    }
    let mut new_cap = if sec.relocs_cap == 0 { 8 } else { sec.relocs_cap + sec.relocs_cap };
    while new_cap < min_cap {
        new_cap = new_cap + new_cap;
    }
    let r_sz = size_of<Reloc>();
    let r_al = align_of<Reloc>();
    let new_buf = unsafe { heap_alloc(coff_mul_usize(new_cap, r_sz), r_al) as *mut Reloc };
    if sec.relocs_len > 0 && (sec.relocs as usize) != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(
                sec.relocs as *const u8,
                new_buf as *mut u8,
                coff_mul_usize(sec.relocs_len, r_sz)
            );
            heap_free(sec.relocs as *mut u8, coff_mul_usize(sec.relocs_cap, r_sz), r_al);
        }
    } else if sec.relocs_cap > 0 && (sec.relocs as usize) != 0 {
        unsafe {
            heap_free(sec.relocs as *mut u8, coff_mul_usize(sec.relocs_cap, r_sz), r_al);
        }
    }
    sec.relocs = new_buf;
    sec.relocs_cap = new_cap;
}

pub fn section_add_byte(sec: mut_view<Section>, byte: u8) {
    if sec.bytes_len == sec.bytes_cap {
        section_reserve_bytes(mut_view(*sec), sec.bytes_len + 1);
    }
    unsafe {
        *(sec.bytes + sec.bytes_len) = byte;
    }
    sec.bytes_len = sec.bytes_len + 1;
}

pub fn ax_section_add_byte(sec: mut_view<Section>, byte: u8) {
    section_add_byte(sec, byte);
}

pub fn section_append_byte(sec: mut_view<Section>, byte: u8) {
    section_add_byte(sec, byte);
}

pub fn section_add_bytes(sec: mut_view<Section>, bytes: *const u8, count: usize) {
    if count == 0 {
        return;
    }
    if sec.bytes_len + count > sec.bytes_cap {
        section_reserve_bytes(mut_view(*sec), sec.bytes_len + count);
    }
    let dst = unsafe { sec.bytes + sec.bytes_len };
    if (bytes as usize) != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(bytes, dst, count);
        }
    } else {
        let mut i: usize = 0;
        while i < count {
            unsafe {
                *(dst + i) = 0u8;
            }
            i = i + 1;
        }
    }
    sec.bytes_len = sec.bytes_len + count;
}

pub fn ax_section_add_bytes(sec: mut_view<Section>, bytes: *const u8, count: usize) {
    section_add_bytes(sec, bytes, count);
}

pub fn section_append_bytes(sec: mut_view<Section>, bytes: *const u8, count: usize) {
    section_add_bytes(sec, bytes, count);
}

pub fn ax_section_append_bytes(sec: mut_view<Section>, bytes: *const u8, count: usize) {
    section_add_bytes(sec, bytes, count);
}

pub fn section_append_zeroes(sec: mut_view<Section>, count: usize) {
    section_add_bytes(sec, 0 as *const u8, count);
}

pub fn section_append_slice(sec: mut_view<Section>, data: view<[u8]>) {
    let n = len(data);
    if n == 0 {
        return;
    }
    if sec.bytes_len + n > sec.bytes_cap {
        section_reserve_bytes(mut_view(*sec), sec.bytes_len + n);
    }
    let dst = unsafe { sec.bytes + sec.bytes_len };
    let mut i: usize = 0;
    while i < n {
        unsafe {
            *(dst + i) = data[i];
        }
        i = i + 1;
    }
    sec.bytes_len = sec.bytes_len + n;
}

// Matches C `ax_section_add_reloc(sec, offset, kind, symbol_id, addend)` in objmodel.h
pub fn section_add_reloc(
    sec: mut_view<Section>,
    offset: u32,
    kind: u32,
    symbol_id: SymbolId,
    addend: i64
) {
    if sec.relocs_len == sec.relocs_cap {
        section_reserve_relocs(mut_view(*sec), sec.relocs_len + 1);
    }
    let r_ptr = unsafe {
        ((sec.relocs as usize) + coff_mul_usize(sec.relocs_len, size_of<Reloc>())) as *mut Reloc
    };
    unsafe {
        (*r_ptr).offset = offset;
        (*r_ptr).kind = kind;
        (*r_ptr).symbol_id = symbol_id;
        (*r_ptr).addend = addend;
    }
    sec.relocs_len = sec.relocs_len + 1;
}

pub fn ax_section_add_reloc(
    sec: mut_view<Section>,
    offset: u32,
    kind: u32,
    symbol_id: SymbolId,
    addend: i64
) {
    section_add_reloc(sec, offset, kind, symbol_id, addend);
}

pub fn objmodel_section_add_byte(model: mut_view<ObjModel>, sec_id: SectionId, b: u8) {
    let sec = objmodel_get_section_mut(model, sec_id);
    if (sec as usize) != 0 {
        unsafe {
            section_add_byte(mut_view(*sec), b);
        }
    }
}

pub fn objmodel_section_add_bytes(
    model: mut_view<ObjModel>,
    sec_id: SectionId,
    data: *const u8,
    count: usize
) {
    let sec = objmodel_get_section_mut(model, sec_id);
    if (sec as usize) != 0 {
        unsafe {
            section_add_bytes(mut_view(*sec), data, count);
        }
    }
}

pub fn objmodel_section_append_slice(model: mut_view<ObjModel>, sec_id: SectionId, data: view<[u8]>) {
    let sec = objmodel_get_section_mut(model, sec_id);
    if (sec as usize) != 0 {
        unsafe {
            section_append_slice(mut_view(*sec), data);
        }
    }
}

pub fn objmodel_section_add_reloc(
    model: mut_view<ObjModel>,
    sec_id: SectionId,
    offset: u32,
    kind: u32,
    symbol_id: SymbolId,
    addend: i64
) {
    let sec = objmodel_get_section_mut(model, sec_id);
    if (sec as usize) != 0 {
        unsafe {
            section_add_reloc(mut_view(*sec), offset, kind, symbol_id, addend);
        }
    }
}

pub fn section_bytes_ptr(sec: view<Section>) -> *const u8 {
    sec.bytes as *const u8
}

pub fn section_bytes_len(sec: view<Section>) -> usize {
    sec.bytes_len
}

pub fn section_byte_at(sec: view<Section>, index: usize) -> u8 {
    if index >= sec.bytes_len {
        return 0u8;
    }
    unsafe { *(sec.bytes + index) }
}

pub fn section_relocs_len(sec: view<Section>) -> usize {
    sec.relocs_len
}

pub fn section_reloc_at(sec: view<Section>, index: usize) -> *const Reloc {
    if index >= sec.relocs_len {
        return 0 as *const Reloc;
    }
    unsafe { ((sec.relocs as usize) + coff_mul_usize(index, size_of<Reloc>())) as *const Reloc }
}

pub fn section_reloc_at_mut(sec: mut_view<Section>, index: usize) -> *mut Reloc {
    if index >= sec.relocs_len {
        return 0 as *mut Reloc;
    }
    unsafe { ((sec.relocs as usize) + coff_mul_usize(index, size_of<Reloc>())) as *mut Reloc }
}

// Axiom Compiler — Deterministic COFF Relocatable Object Writer (compiler/obj/writer.ax)
// Port of bootstrap/axiom0/src/obj/coff/writer.h and bootstrap/axiom0/src/obj/coff/writer.c.
module compiler.obj.writer

use host_intrinsics.open
use host_intrinsics.write
use host_intrinsics.close

use compiler.obj.coff.CoffBuf
use compiler.obj.coff.coff_buf_with_capacity
use compiler.obj.coff.coff_buf_free
use compiler.obj.coff.coff_buf_reserve
use compiler.obj.coff.coff_buf_put_u8
use compiler.obj.coff.coff_buf_put_u16
use compiler.obj.coff.coff_buf_put_i16
use compiler.obj.coff.coff_buf_put_u32
use compiler.obj.coff.SectionId
use compiler.obj.coff.SymbolId
use compiler.obj.coff.Reloc
use compiler.obj.coff.Section
use compiler.obj.coff.ObjSymbol
use compiler.obj.coff.ObjModel
use compiler.obj.coff.AX_SEC_BSS
use compiler.obj.coff.AX_RELOC_X86_64_PC32
use compiler.obj.coff.AX_RELOC_X86_64_32
use compiler.obj.coff.AX_RELOC_X86_64_64
use compiler.obj.coff.AX_RELOC_X86_64_GOT32
use compiler.obj.coff.AX_RELOC_X86_64_PLT32
use compiler.obj.coff.COFF_FILE_HEADER_SIZE
use compiler.obj.coff.COFF_SECTION_HEADER_SIZE
use compiler.obj.coff.COFF_RELOC_SIZE
use compiler.obj.coff.COFF_SYMBOL_SIZE
use compiler.obj.coff.IMAGE_FILE_MACHINE_AMD64
use compiler.obj.coff.coff_section_characteristics
use compiler.obj.coff.coff_reloc_type
use compiler.obj.coff.coff_storage_class
use compiler.obj.coff.coff_write_u32_le
use compiler.obj.coff.coff_write_u64_le
use compiler.obj.coff.cstr_len
use compiler.obj.coff.objmodel_get_section
use compiler.obj.coff.objmodel_get_symbol
use compiler.obj.coff.section_reloc_at
use compiler.obj.coff.coff_mul_usize
use compiler.obj.coff.coff_mul_u32

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

fn compute_bss_raw_size(model: view<ObjModel>, sec_id: SectionId, sec: view<Section>) -> u32 {
    let mut bss_size: u32 = sec.bytes_len as u32;
    let num_symbols: u32 = model.symbols_len as u32;
    let mut s: u32 = 1u32;
    while s <= num_symbols {
        let sym = objmodel_get_symbol(model, SymbolId { v: s });
        if sym as usize != 0 {
            let sym_sec_v = unsafe { (*sym).section_id.v };
            if sym_sec_v == sec_id.v {
                let sym_val = unsafe { (*sym).value };
                let sym_sz = unsafe { (*sym).size };
                let end: u32 = (sym_val + sym_sz) as u32;
                if end > bss_size {
                    bss_size = end;
                }
            }
        }
        s = s + 1u32;
    }
    bss_size
}

fn compute_strtab_size(model: view<ObjModel>) -> u32 {
    let mut strtab_size: u32 = 4u32;
    let num_symbols: u32 = model.symbols_len as u32;
    let mut i: u32 = 1u32;
    while i <= num_symbols {
        let sym = objmodel_get_symbol(model, SymbolId { v: i });
        if sym as usize != 0 {
            let name_ptr = unsafe { (*sym).name };
            let name_len = cstr_len(name_ptr);
            if name_len > 8 {
                strtab_size = strtab_size + (name_len as u32) + 1u32;
            }
        }
        i = i + 1u32;
    }
    strtab_size
}

// Appends the complete deterministic Windows x64 COFF relocatable object (.obj)
// binary image for `model` into `out`.
pub fn coff_write_to_buf(model: view<ObjModel>, out: mut_view<CoffBuf>) -> bool {
    let num_sections: u32 = model.sections_len as u32;
    let num_symbols: u32 = model.symbols_len as u32;

    let size_of_headers: u32 = (COFF_FILE_HEADER_SIZE as u32) + coff_mul_u32(COFF_SECTION_HEADER_SIZE as u32, num_sections);
    let mut current_offset: u32 = size_of_headers;

    let mut i: u32 = 1u32;
    while i <= num_sections {
        let sec = objmodel_get_section(model, SectionId { v: i });
        if sec as usize != 0 {
            let blen = unsafe { (*sec).bytes_len };
            let rlen = unsafe { (*sec).relocs_len };
            if blen > 0 {
                current_offset = current_offset + (blen as u32);
            }
            if rlen > 0 {
                current_offset = current_offset + coff_mul_u32(rlen as u32, COFF_RELOC_SIZE as u32);
            }
        }
        i = i + 1u32;
    }

    let symbol_table_offset: u32 = current_offset;
    let strtab_size: u32 = compute_strtab_size(model);
    let total_size: usize = (symbol_table_offset as usize) + coff_mul_usize(num_symbols as usize, COFF_SYMBOL_SIZE) + (strtab_size as usize);
    coff_buf_reserve(mut_view(*out), total_size);

    // 1. IMAGE_FILE_HEADER (20 bytes)
    coff_buf_put_u16(mut_view(*out), IMAGE_FILE_MACHINE_AMD64);
    coff_buf_put_u16(mut_view(*out), num_sections as u16);
    coff_buf_put_u32(mut_view(*out), 0u32); // TimeDateStamp = 0 (deterministic)
    coff_buf_put_u32(mut_view(*out), symbol_table_offset);
    coff_buf_put_u32(mut_view(*out), num_symbols);
    coff_buf_put_u16(mut_view(*out), 0u16); // SizeOfOptionalHeader = 0
    coff_buf_put_u16(mut_view(*out), 0u16); // Characteristics = 0

    // 2. IMAGE_SECTION_HEADER table (40 bytes per section)
    let mut running_offset: u32 = size_of_headers;
    i = 1u32;
    while i <= num_sections {
        let sec = objmodel_get_section(model, SectionId { v: i });
        let sec_name = unsafe { (*sec).name };
        let name_len = cstr_len(sec_name);
        let mut k: usize = 0;
        while k < 8 {
            if k < name_len {
                coff_buf_put_u8(mut_view(*out), unsafe { *(sec_name + k) });
            } else {
                coff_buf_put_u8(mut_view(*out), 0u8);
            }
            k = k + 1;
        }

        let sec_kind = unsafe { (*sec).kind };
        let sec_flags = unsafe { (*sec).flags };
        let sec_align = unsafe { (*sec).align };
        let blen = unsafe { (*sec).bytes_len };
        let rlen = unsafe { (*sec).relocs_len };

        let size_of_raw_data: u32 = if sec_kind == AX_SEC_BSS {
            compute_bss_raw_size(model, SectionId { v: i }, unsafe { view(*sec) })
        } else {
            blen as u32
        };

        let ptr_to_raw_data: u32 = if blen > 0 {
            let off = running_offset;
            running_offset = running_offset + (blen as u32);
            off
        } else {
            0u32
        };

        let ptr_to_relocs: u32 = if rlen > 0 {
            let off = running_offset;
            running_offset = running_offset + coff_mul_u32(rlen as u32, COFF_RELOC_SIZE as u32);
            off
        } else {
            0u32
        };

        let chars = coff_section_characteristics(sec_kind, sec_flags, sec_align);

        coff_buf_put_u32(mut_view(*out), 0u32); // VirtualSize
        coff_buf_put_u32(mut_view(*out), 0u32); // VirtualAddress
        coff_buf_put_u32(mut_view(*out), size_of_raw_data);
        coff_buf_put_u32(mut_view(*out), ptr_to_raw_data);
        coff_buf_put_u32(mut_view(*out), ptr_to_relocs);
        coff_buf_put_u32(mut_view(*out), 0u32); // PointerToLinenumbers
        coff_buf_put_u16(mut_view(*out), rlen as u16); // NumberOfRelocations
        coff_buf_put_u16(mut_view(*out), 0u16); // NumberOfLinenumbers
        coff_buf_put_u32(mut_view(*out), chars);

        i = i + 1u32;
    }

    // 3. Section Raw Data (with inline addend patching) and Section Relocations
    i = 1u32;
    while i <= num_sections {
        let sec = objmodel_get_section(model, SectionId { v: i });
        let blen = unsafe { (*sec).bytes_len };
        let rlen = unsafe { (*sec).relocs_len };

        if blen > 0 {
            let sec_data_start: usize = out.len;
            let raw_bytes = unsafe { (*sec).bytes as *const u8 };
            let mut b_idx: usize = 0;
            while b_idx < blen {
                coff_buf_put_u8(mut_view(*out), unsafe { *(raw_bytes + b_idx) });
                b_idx = b_idx + 1;
            }

            // Patch inline relocation addends into the emitted section data copy
            let mut r: usize = 0;
            while r < rlen {
                let rel = section_reloc_at(unsafe { view(*sec) }, r);
                let rel_off = (unsafe { (*rel).offset }) as usize;
                let rel_kind = unsafe { (*rel).kind };
                let rel_addend = unsafe { (*rel).addend };

                if rel_kind == AX_RELOC_X86_64_PC32 || rel_kind == AX_RELOC_X86_64_PLT32 {
                    if rel_off + 4 <= blen {
                        let val: u32 = ((rel_addend as i32) + 4i32) as u32;
                        coff_write_u32_le(out.ptr, sec_data_start + rel_off, val);
                    }
                } else if rel_kind == AX_RELOC_X86_64_32 || rel_kind == AX_RELOC_X86_64_GOT32 {
                    if rel_off + 4 <= blen {
                        let val: u32 = (rel_addend as i32) as u32;
                        coff_write_u32_le(out.ptr, sec_data_start + rel_off, val);
                    }
                } else if rel_kind == AX_RELOC_X86_64_64 {
                    if rel_off + 8 <= blen {
                        let val: u64 = rel_addend as u64;
                        coff_write_u64_le(out.ptr, sec_data_start + rel_off, val);
                    }
                }
                r = r + 1;
            }
        }

        if rlen > 0 {
            let mut r: usize = 0;
            while r < rlen {
                let rel = section_reloc_at(unsafe { view(*sec) }, r);
                let rel_off = unsafe { (*rel).offset };
                let rel_sym_v = unsafe { (*rel).symbol_id.v };
                let rel_kind = unsafe { (*rel).kind };

                coff_buf_put_u32(mut_view(*out), rel_off);
                coff_buf_put_u32(mut_view(*out), rel_sym_v - 1u32);
                coff_buf_put_u16(mut_view(*out), coff_reloc_type(rel_kind));
                r = r + 1;
            }
        }

        i = i + 1u32;
    }

    // 4. Symbol Table (18 bytes per symbol)
    let mut current_strtab_offset: u32 = 4u32;
    i = 1u32;
    while i <= num_symbols {
        let sym = objmodel_get_symbol(model, SymbolId { v: i });
        let sym_name = unsafe { (*sym).name };
        let name_len = cstr_len(sym_name);

        if name_len <= 8 {
            let mut k: usize = 0;
            while k < 8 {
                if k < name_len {
                    coff_buf_put_u8(mut_view(*out), unsafe { *(sym_name + k) });
                } else {
                    coff_buf_put_u8(mut_view(*out), 0u8);
                }
                k = k + 1;
            }
        } else {
            coff_buf_put_u32(mut_view(*out), 0u32); // Zeroes = 0
            coff_buf_put_u32(mut_view(*out), current_strtab_offset); // Offset
            current_strtab_offset = current_strtab_offset + (name_len as u32) + 1u32;
        }

        let sym_val = (unsafe { (*sym).value }) as u32;
        let sym_sec_v = unsafe { (*sym).section_id.v };
        let sec_num: i16 = if sym_sec_v == 0u32 { 0i16 } else { sym_sec_v as i16 };
        let sym_linkage = unsafe { (*sym).linkage };

        coff_buf_put_u32(mut_view(*out), sym_val);
        coff_buf_put_i16(mut_view(*out), sec_num);
        coff_buf_put_u16(mut_view(*out), 0u16); // Type = 0
        coff_buf_put_u8(mut_view(*out), coff_storage_class(sym_linkage));
        coff_buf_put_u8(mut_view(*out), 0u8); // NumberOfAuxSymbols = 0

        i = i + 1u32;
    }

    // 5. String Table (4-byte size prefix + null-terminated long symbol names)
    coff_buf_put_u32(mut_view(*out), strtab_size);
    i = 1u32;
    while i <= num_symbols {
        let sym = objmodel_get_symbol(model, SymbolId { v: i });
        let sym_name = unsafe { (*sym).name };
        let name_len = cstr_len(sym_name);
        if name_len > 8 {
            let mut k: usize = 0;
            while k < name_len {
                coff_buf_put_u8(mut_view(*out), unsafe { *(sym_name + k) });
                k = k + 1;
            }
            coff_buf_put_u8(mut_view(*out), 0u8);
        }
        i = i + 1u32;
    }

    true
}

pub fn coff_encode_bytes(model: view<ObjModel>) -> CoffBuf {
    let mut buf = coff_buf_with_capacity(256);
    let _ = coff_write_to_buf(model, mut_view(buf));
    buf
}

pub fn coff_write_path_bytes(model: view<ObjModel>, path_ptr: *const u8, path_len: usize) -> bool {
    if path_ptr as usize == 0 || path_len == 0 {
        return false;
    }
    let mut buf = coff_encode_bytes(model);
    let h = unsafe { open(path_ptr, path_len, 1u32) };
    if h < 0 {
        coff_buf_free(mut_view(buf));
        return false;
    }
    let n = buf.len;
    if n > 0 && buf.ptr as usize != 0 {
        let mut total_written: usize = 0;
        while total_written < n {
            let src = unsafe { (buf.ptr as *const u8) + total_written };
            let remaining = n - total_written;
            let wr = unsafe { write(h, src, remaining) };
            if wr <= 0 {
                let _ = close(h);
                coff_buf_free(mut_view(buf));
                return false;
            }
            total_written = total_written + (wr as usize);
        }
    }
    let cl = close(h);
    coff_buf_free(mut_view(buf));
    cl >= 0
}

pub fn coff_write(model: view<ObjModel>, output_path: *const u8) -> bool {
    if output_path as usize == 0 {
        return false;
    }
    coff_write_path_bytes(model, output_path, cstr_len(output_path))
}

pub fn ax_coff_write(model: view<ObjModel>, output_path: *const u8) -> bool {
    coff_write(model, output_path)
}

pub fn coff_write_str(model: view<ObjModel>, output_path: Str) -> bool {
    let bytes: view<[u8]> = unsafe { *(address_of(output_path) as *const view<[u8]>) };
    let plen = len(bytes);
    if plen == 0 {
        return false;
    }
    let mut path_buf = coff_buf_with_capacity(plen + 1);
    let mut i: usize = 0;
    while i < plen {
        coff_buf_put_u8(mut_view(path_buf), bytes[i]);
        i = i + 1;
    }
    coff_buf_put_u8(mut_view(path_buf), 0u8);
    let ok = coff_write_path_bytes(model, path_buf.ptr as *const u8, plen);
    coff_buf_free(mut_view(path_buf));
    ok
}

