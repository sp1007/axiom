@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

fn sink_ptr(s: mut_view<DiagSink>) -> *mut DiagSink {
    unsafe { address_of(*s) as *mut DiagSink }
}

fn str_to_cstr_buf(s: Str) -> CoffBuf {
    pe_str_to_cstr_buf(s)
}

// 1. Test PE constants, alignment helpers, ASCII case-insensitive helpers, and decimal parser
fn test_pe_constants_and_helpers() -> i32 {
    if PE_DOS_HEADER_SIZE != 64 || PE_SIGNATURE_SIZE != 4 || PE_OPTIONAL_HEADER64_TOTAL_SIZE != 240 || PE_IMPORT_DESCRIPTOR_SIZE != 20 {
        return 10;
    }
    if pe_align_up_u32(0u32, 0x1000u32) != 0u32 { return 11; }
    if pe_align_up_u32(1u32, 0x1000u32) != 0x1000u32 { return 12; }
    if pe_align_up_u32(0x1000u32, 0x1000u32) != 0x1000u32 { return 13; }
    if pe_align_up_u32(0x1001u32, 0x1000u32) != 0x2000u32 { return 14; }
    if pe_align_up_usize(328, 512) != 512 { return 15; }
    if pe_compute_headers_size(2, PE_DEFAULT_FILE_ALIGN) != 0x200u32 { return 16; }

    if pe_section_align_from_chars(0u32) != 1u32 { return 17; }
    if pe_section_align_from_chars(IMAGE_SCN_ALIGN_4BYTES) != 4u32 { return 18; }
    if pe_section_align_from_chars(IMAGE_SCN_ALIGN_16BYTES) != 16u32 { return 19; }

    if pe_ascii_tolower(65u8) != 97u8 || pe_ascii_tolower(90u8) != 122u8 || pe_ascii_tolower(48u8) != 48u8 {
        return 20;
    }

    let mut s1 = str_to_cstr_buf({ "Kernel32.DLL" });
    let mut s2 = str_to_cstr_buf({ "kernel32.dll" });
    let mut s3 = str_to_cstr_buf({ "__IAT_ExitProcess" });
    let mut s4 = str_to_cstr_buf({ "__IAT_" });
    let mut s5 = str_to_cstr_buf({ "8388608" });
    if !pe_cstr_ieq(s1.ptr as *const u8, s2.ptr as *const u8) {
        coff_buf_free(mut_view(s1)); coff_buf_free(mut_view(s2)); coff_buf_free(mut_view(s3)); coff_buf_free(mut_view(s4)); coff_buf_free(mut_view(s5));
        return 21;
    }
    if !pe_cstr_starts_with(s3.ptr as *const u8, s4.ptr as *const u8) {
        coff_buf_free(mut_view(s1)); coff_buf_free(mut_view(s2)); coff_buf_free(mut_view(s3)); coff_buf_free(mut_view(s4)); coff_buf_free(mut_view(s5));
        return 22;
    }
    let stack_val = pe_parse_u32_decimal(s5.ptr as *const u8, 7);
    if stack_val != 8388608u32 {
        coff_buf_free(mut_view(s1)); coff_buf_free(mut_view(s2)); coff_buf_free(mut_view(s3)); coff_buf_free(mut_view(s4)); coff_buf_free(mut_view(s5));
        return 23;
    }
    let dot_idx = pe_cstr_find_char(s1.ptr as *const u8, 46u8);
    if dot_idx != 8isize {
        coff_buf_free(mut_view(s1)); coff_buf_free(mut_view(s2)); coff_buf_free(mut_view(s3)); coff_buf_free(mut_view(s4)); coff_buf_free(mut_view(s5));
        return 24;
    }
    coff_buf_free(mut_view(s1));
    coff_buf_free(mut_view(s2));
    coff_buf_free(mut_view(s3));
    coff_buf_free(mut_view(s4));
    coff_buf_free(mut_view(s5));
    0
}

// 2. Test PE32+ binary header encoders and decoders
fn test_pe_header_encoders_and_decoders() -> i32 {
    let mut buf = coff_buf_with_capacity(512);
    pe_emit_dos_header(mut_view(buf));
    pe_emit_pe_signature(mut_view(buf));

    let fhdr_in = CoffFileHeader {
        machine: IMAGE_FILE_MACHINE_AMD64,
        number_of_sections: 2u16,
        time_date_stamp: 0u32,
        pointer_to_symbol_table: 0u32,
        number_of_symbols: 0u32,
        size_of_optional_header: PE_OPTIONAL_HEADER64_TOTAL_SIZE as u16,
        characteristics: IMAGE_FILE_EXECUTABLE_IMAGE | IMAGE_FILE_LARGE_ADDRESS_AWARE | IMAGE_FILE_DEBUG_STRIPPED,
    };
    pe_emit_file_header(mut_view(buf), view(fhdr_in));

    let mut opt = PeOptionalHeader64 {
        magic: 0u16, major_linker_version: 0u8, minor_linker_version: 0u8,
        size_of_code: 0u32, size_of_initialized_data: 0u32, size_of_uninitialized_data: 0u32,
        address_of_entry_point: 0u32, base_of_code: 0u32, image_base: 0u64,
        section_alignment: 0u32, file_alignment: 0u32,
        major_operating_system_version: 0u16, minor_operating_system_version: 0u16,
        major_image_version: 0u16, minor_image_version: 0u16,
        major_subsystem_version: 0u16, minor_subsystem_version: 0u16,
        win32_version_value: 0u32, size_of_image: 0u32, size_of_headers: 0u32,
        check_sum: 0u32, subsystem: 0u16, dll_characteristics: 0u16,
        size_of_stack_reserve: 0u64, size_of_stack_commit: 0u64,
        size_of_heap_reserve: 0u64, size_of_heap_commit: 0u64,
        loader_flags: 0u32, number_of_rva_and_sizes: 0u32,
    };
    pe_optional_header64_init(mut_view(opt));
    opt.size_of_code = 0x200u32;
    opt.size_of_initialized_data = 0x200u32;
    opt.address_of_entry_point = 0x1000u32;
    opt.base_of_code = 0x1000u32;
    opt.size_of_image = 0x3000u32;
    opt.size_of_headers = 0x200u32;
    opt.size_of_stack_reserve = 0x400000u64;
    pe_emit_optional_header64(mut_view(buf), view(opt));

    let mut d_idx: usize = 0;
    while d_idx < PE_DATA_DIRECTORY_COUNT {
        let dir = if d_idx == PE_DIR_IMPORT {
            PeDataDirectory { virtual_address: 0x2000u32, size: 40u32 }
        } else if d_idx == PE_DIR_IAT {
            PeDataDirectory { virtual_address: 0x2048u32, size: 32u32 }
        } else {
            PeDataDirectory { virtual_address: 0u32, size: 0u32 }
        };
        pe_emit_data_directory(mut_view(buf), view(dir));
        d_idx = d_idx + 1;
    }

    let sh_text_in = CoffSectionHeader {
        name: [46u8, 116u8, 101u8, 120u8, 116u8, 0u8, 0u8, 0u8],
        virtual_size: 352u32,
        virtual_address: 0x1000u32,
        size_of_raw_data: 0x200u32,
        pointer_to_raw_data: 0x200u32,
        pointer_to_relocations: 0u32,
        pointer_to_linenumbers: 0u32,
        number_of_relocations: 0u16,
        number_of_linenumbers: 0u16,
        characteristics: IMAGE_SCN_CNT_CODE | IMAGE_SCN_MEM_EXECUTE | IMAGE_SCN_MEM_READ,
    };
    let sh_idata_in = CoffSectionHeader {
        name: [46u8, 105u8, 100u8, 97u8, 116u8, 97u8, 0u8, 0u8],
        virtual_size: 134u32,
        virtual_address: 0x2000u32,
        size_of_raw_data: 0x200u32,
        pointer_to_raw_data: 0x400u32,
        pointer_to_relocations: 0u32,
        pointer_to_linenumbers: 0u32,
        number_of_relocations: 0u16,
        number_of_linenumbers: 0u16,
        characteristics: IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_READ | IMAGE_SCN_MEM_WRITE,
    };
    pe_emit_section_header(mut_view(buf), view(sh_text_in));
    pe_emit_section_header(mut_view(buf), view(sh_idata_in));

    let p = buf.ptr as *const u8;
    let mut lfanew: u32 = 0u32;
    if !pe_decode_dos_header(p, buf.len, mut_view(lfanew)) || lfanew != 64u32 {
        coff_buf_free(mut_view(buf));
        return 30;
    }
    if !pe_check_signature(p, lfanew as usize, buf.len) {
        coff_buf_free(mut_view(buf));
        return 31;
    }

    let fhdr = coff_decode_file_header(p, 68);
    if fhdr.machine != IMAGE_FILE_MACHINE_AMD64 || fhdr.number_of_sections != 2u16 {
        coff_buf_free(mut_view(buf));
        return 32;
    }
    if fhdr.size_of_optional_header != 240u16 {
        coff_buf_free(mut_view(buf));
        return 33;
    }

    let mut dec_opt = PeOptionalHeader64 {
        magic: 0u16, major_linker_version: 0u8, minor_linker_version: 0u8,
        size_of_code: 0u32, size_of_initialized_data: 0u32, size_of_uninitialized_data: 0u32,
        address_of_entry_point: 0u32, base_of_code: 0u32, image_base: 0u64,
        section_alignment: 0u32, file_alignment: 0u32,
        major_operating_system_version: 0u16, minor_operating_system_version: 0u16,
        major_image_version: 0u16, minor_image_version: 0u16,
        major_subsystem_version: 0u16, minor_subsystem_version: 0u16,
        win32_version_value: 0u32, size_of_image: 0u32, size_of_headers: 0u32,
        check_sum: 0u32, subsystem: 0u16, dll_characteristics: 0u16,
        size_of_stack_reserve: 0u64, size_of_stack_commit: 0u64,
        size_of_heap_reserve: 0u64, size_of_heap_commit: 0u64,
        loader_flags: 0u32, number_of_rva_and_sizes: 0u32,
    };
    pe_decode_optional_header64(p, 88, mut_view(dec_opt));
    let dec_magic: u16 = dec_opt.magic;
    let dec_img_base: u64 = dec_opt.image_base;
    if dec_magic != PE_MAGIC_PE32_PLUS || dec_img_base != pe_default_image_base() {
        coff_buf_free(mut_view(buf));
        return 34;
    }
    if dec_opt.section_alignment != PE_DEFAULT_SECTION_ALIGN || dec_opt.file_alignment != PE_DEFAULT_FILE_ALIGN {
        coff_buf_free(mut_view(buf));
        return 35;
    }
    let dec_stack_res: u64 = dec_opt.size_of_stack_reserve;
    if dec_opt.subsystem != IMAGE_SUBSYSTEM_WINDOWS_CUI || dec_stack_res != 0x400000u64 {
        coff_buf_free(mut_view(buf));
        return 36;
    }
    let imp_dir = pe_decode_data_directory(p, 200 + (PE_DIR_IMPORT * 8));
    let iat_dir = pe_decode_data_directory(p, 200 + (PE_DIR_IAT * 8));
    if imp_dir.virtual_address != 0x2000u32 || imp_dir.size != 40u32 {
        coff_buf_free(mut_view(buf));
        return 37;
    }
    if iat_dir.virtual_address != 0x2048u32 || iat_dir.size != 32u32 {
        coff_buf_free(mut_view(buf));
        return 38;
    }

    let sh0 = coff_decode_section_header(p, 328);
    let sh1 = coff_decode_section_header(p, 368);
    if sh0.virtual_size != 352u32 || sh0.virtual_address != 0x1000u32 || sh0.pointer_to_raw_data != 0x200u32 {
        coff_buf_free(mut_view(buf));
        return 39;
    }
    if sh1.virtual_size != 134u32 || sh1.virtual_address != 0x2000u32 || sh1.pointer_to_raw_data != 0x400u32 {
        coff_buf_free(mut_view(buf));
        return 40;
    }

    coff_buf_free(mut_view(buf));
    0
}

// 3. Test runtime stubs, ImportTable synthesis, DLL normalization, and .idata RVA patching
fn test_runtime_stubs_and_import_synthesis() -> i32 {
    let mut ctx = LinkerContext {
        sections: 0 as *mut *mut compiler.link.MergedSection,
        num_sections: 0,
        cap_sections: 0,
        globals: 0 as *mut compiler.link.GlobalSymbol,
        num_globals: 0,
        cap_globals: 0,
        relocs: 0 as *mut compiler.link.PeReloc,
        num_relocs: 0,
        cap_relocs: 0,
        str_arena: 0 as *mut Arena,
    };
    linker_context_init(mut_view(ctx));

    let start_off = linker_emit_runtime_stubs(mut_view(ctx));
    if start_off != 0u32 {
        linker_context_free(mut_view(ctx));
        return 50;
    }
    let text_sec = linker_find_section_str(view(ctx), { ".text" });
    if (text_sec as usize) == 0 {
        linker_context_free(mut_view(ctx));
        return 51;
    }
    // 86 (0..86), pad to 96 + 64 = 160, 160 + 59 = 219, pad to 224 + 119 = 343 bytes
    if unsafe { (*text_sec).size } != 343u32 {
        linker_context_free(mut_view(ctx));
        return 52;
    }
    if (linker_find_global_str(view(ctx), { "axiom_panic" }) as usize) == 0 ||
        (linker_find_global_str(view(ctx), { "__ax_host_print" }) as usize) == 0 ||
        (linker_find_global_str(view(ctx), { "__ax_host_print_int" }) as usize) == 0 {
        linker_context_free(mut_view(ctx));
        return 53;
    }
    if ctx.num_relocs != 14 {
        linker_context_free(mut_view(ctx));
        return 54;
    }

    // Add a custom USER32$MessageBoxA relocation and test import discovery + normalization
    linker_add_reloc_str(mut_view(ctx), text_sec, 300u32, IMAGE_REL_AMD64_REL32, { "USER32$MessageBoxA" }, 0i64);
    let mut imports = import_table_new();
    import_add_base_kernel32(mut_view(imports), mut_view(ctx));
    // Verify case-insensitive DLL deduplication ("kernel32" -> "KERNEL32.dll")
    let k32_dup = import_find_or_add_dll_str(mut_view(imports), mut_view(ctx), { "kernel32" });
    let k32_first = import_dll_at(view(imports), 0);
    if (k32_dup as usize) != (k32_first as usize) {
        import_table_free(mut_view(imports));
        linker_context_free(mut_view(ctx));
        return 55;
    }

    import_discover_from_relocs(mut_view(imports), mut_view(ctx));
    if imports.num_dlls != 2 {
        import_table_free(mut_view(imports));
        linker_context_free(mut_view(ctx));
        return 56;
    }

    // Check normalized DLL name ("USER32" -> "USER32.dll")
    let dll1 = import_dll_at(view(imports), 1);
    let mut exp_dll1 = str_to_cstr_buf({ "USER32.dll" });
    if !cstr_eq(unsafe { (*dll1).dll_name }, exp_dll1.ptr as *const u8) {
        coff_buf_free(mut_view(exp_dll1));
        import_table_free(mut_view(imports));
        linker_context_free(mut_view(ctx));
        return 57;
    }
    coff_buf_free(mut_view(exp_dll1));

    import_emit_thunks(view(imports), mut_view(ctx), text_sec);
    if (linker_find_global_str(view(ctx), { "MessageBoxA" }) as usize) == 0 ||
        (linker_find_global_str(view(ctx), { "USER32$MessageBoxA" }) as usize) == 0 {
        import_table_free(mut_view(imports));
        linker_context_free(mut_view(ctx));
        return 58;
    }

    let idata_sec = import_build_idata_section(mut_view(imports), mut_view(ctx));
    if (idata_sec as usize) == 0 {
        import_table_free(mut_view(imports));
        linker_context_free(mut_view(ctx));
        return 59;
    }
    let _ = linker_assign_rvas(mut_view(ctx), PE_DEFAULT_FILE_ALIGN, PE_DEFAULT_SECTION_ALIGN);
    import_patch_idata_rvas(view(imports), idata_sec);

    let idata_ptr = unsafe { (*idata_sec).data as *const u8 };
    let desc0 = pe_decode_import_descriptor(idata_ptr, 0);
    let desc1 = pe_decode_import_descriptor(idata_ptr, 20);
    let desc_null = pe_decode_import_descriptor(idata_ptr, 40);
    if desc0.original_first_thunk == 0u32 || desc0.name == 0u32 || desc0.first_thunk == 0u32 {
        import_table_free(mut_view(imports));
        linker_context_free(mut_view(ctx));
        return 60;
    }
    if desc1.original_first_thunk == 0u32 || desc1.name == 0u32 || desc1.first_thunk == 0u32 {
        import_table_free(mut_view(imports));
        linker_context_free(mut_view(ctx));
        return 61;
    }
    if desc_null.original_first_thunk != 0u32 || desc_null.name != 0u32 || desc_null.first_thunk != 0u32 {
        import_table_free(mut_view(imports));
        linker_context_free(mut_view(ctx));
        return 62;
    }

    import_table_free(mut_view(imports));
    linker_context_free(mut_view(ctx));
    0
}

// 4. Test all AMD64 relocation kinds (ABSOLUTE, ADDR64, ADDR32, ADDR32NB, REL32, REL32_1..5)
fn test_all_amd64_relocation_types() -> i32 {
    let mut ctx = LinkerContext {
        sections: 0 as *mut *mut compiler.link.MergedSection,
        num_sections: 0,
        cap_sections: 0,
        globals: 0 as *mut compiler.link.GlobalSymbol,
        num_globals: 0,
        cap_globals: 0,
        relocs: 0 as *mut compiler.link.PeReloc,
        num_relocs: 0,
        cap_relocs: 0,
        str_arena: 0 as *mut Arena,
    };
    linker_context_init(mut_view(ctx));

    let text_sec = linker_get_or_create_section_str(
        mut_view(ctx),
        { ".text" },
        IMAGE_SCN_CNT_CODE | IMAGE_SCN_MEM_EXECUTE | IMAGE_SCN_MEM_READ
    );
    let z64: [64]u8 = [0u8; 64];
    let _ = linker_append_section_slice(text_sec, view(z64), 16u32);

    // Target symbol at offset 48 in .text (RVA = 0x1000 + 48 = 0x1030)
    let g_target = linker_add_global_str(mut_view(ctx), { "target_sym" });
    unsafe {
        (*g_target).defined = true;
        (*g_target).sec = text_sec;
        (*g_target).offset = 48u32;
    }

    let p_mut = unsafe { (*text_sec).data };

    // Off 0: ABSOLUTE (initial 0x11223344 -> unchanged)
    coff_write_u32_le(p_mut, 0, 0x11223344u32);
    linker_add_reloc_str(mut_view(ctx), text_sec, 0u32, IMAGE_REL_AMD64_ABSOLUTE, { "target_sym" }, 0i64);

    // Off 8: ADDR64 (addend = 0x10 -> 0x140000000 + 0x1030 + 0x10 = 0x140001040)
    linker_add_reloc_str(mut_view(ctx), text_sec, 8u32, IMAGE_REL_AMD64_ADDR64, { "target_sym" }, 0x10i64);

    // Off 16: ADDR32 (addend = 4 -> (0x140000000 + 0x1030 + 4) as u32 = 0x40001034)
    linker_add_reloc_str(mut_view(ctx), text_sec, 16u32, IMAGE_REL_AMD64_ADDR32, { "target_sym" }, 4i64);

    // Off 20: ADDR32NB (addend = 8 -> 0x1030 + 8 = 0x1038)
    linker_add_reloc_str(mut_view(ctx), text_sec, 20u32, IMAGE_REL_AMD64_ADDR32NB, { "target_sym" }, 8i64);

    // Off 24: REL32 (addend = 0 -> 48 - 24 - 4 = 20)
    linker_add_reloc_str(mut_view(ctx), text_sec, 24u32, IMAGE_REL_AMD64_REL32, { "target_sym" }, 0i64);

    // Off 28: REL32_1 (addend = -1 -> 48 - 28 - 4 - 1 = 15)
    linker_add_reloc_str(mut_view(ctx), text_sec, 28u32, IMAGE_REL_AMD64_REL32_1, { "target_sym" }, -1i64);

    // Off 32: REL32_2 (addend = -2 -> 48 - 32 - 4 - 2 = 10)
    linker_add_reloc_str(mut_view(ctx), text_sec, 32u32, IMAGE_REL_AMD64_REL32_2, { "target_sym" }, -2i64);

    // Off 36: REL32_3 (addend = -3 -> 48 - 36 - 4 - 3 = 5)
    linker_add_reloc_str(mut_view(ctx), text_sec, 36u32, IMAGE_REL_AMD64_REL32_3, { "target_sym" }, -3i64);

    // Off 40: REL32_4 (addend = -4 -> 48 - 40 - 4 - 4 = 0)
    linker_add_reloc_str(mut_view(ctx), text_sec, 40u32, IMAGE_REL_AMD64_REL32_4, { "target_sym" }, -4i64);

    // Off 44: REL32_5 (addend = -5 -> 48 - 44 - 4 - 5 = -5)
    linker_add_reloc_str(mut_view(ctx), text_sec, 44u32, IMAGE_REL_AMD64_REL32_5, { "target_sym" }, -5i64);

    let _ = linker_assign_rvas(mut_view(ctx), PE_DEFAULT_FILE_ALIGN, PE_DEFAULT_SECTION_ALIGN);
    let mut sink = DiagSink {
        arena: arena_new(),
        diags: 0 as *mut Diagnostic,
        len: 0, cap: 0, errors: 0, warnings: 0,
    };

    if !linker_apply_relocations(mut_view(ctx), pe_default_image_base(), sink_ptr(mut_view(sink))) {
        diag_sink_free(mut_view(sink));
        linker_context_free(mut_view(ctx));
        return 70;
    }

    let p = unsafe { (*text_sec).data as *const u8 };
    let exp_addr64: u64 = pe_default_image_base() + 0x1040u64;
    if coff_read_u32_le(p, 0) != 0x11223344u32 { diag_sink_free(mut_view(sink)); linker_context_free(mut_view(ctx)); return 71; }
    if coff_read_u64_le(p, 8) != exp_addr64 { diag_sink_free(mut_view(sink)); linker_context_free(mut_view(ctx)); return 72; }
    if coff_read_u32_le(p, 16) != 0x40001034u32 { diag_sink_free(mut_view(sink)); linker_context_free(mut_view(ctx)); return 73; }
    if coff_read_u32_le(p, 20) != 0x1038u32 { diag_sink_free(mut_view(sink)); linker_context_free(mut_view(ctx)); return 74; }
    if coff_read_i32_le(p, 24) != 20i32 { diag_sink_free(mut_view(sink)); linker_context_free(mut_view(ctx)); return 75; }
    if coff_read_i32_le(p, 28) != 15i32 { diag_sink_free(mut_view(sink)); linker_context_free(mut_view(ctx)); return 76; }
    if coff_read_i32_le(p, 32) != 10i32 { diag_sink_free(mut_view(sink)); linker_context_free(mut_view(ctx)); return 77; }
    if coff_read_i32_le(p, 36) != 5i32 { diag_sink_free(mut_view(sink)); linker_context_free(mut_view(ctx)); return 78; }
    if coff_read_i32_le(p, 40) != 0i32 { diag_sink_free(mut_view(sink)); linker_context_free(mut_view(ctx)); return 79; }
    if coff_read_i32_le(p, 44) != -5i32 { diag_sink_free(mut_view(sink)); linker_context_free(mut_view(ctx)); return 80; }

    diag_sink_free(mut_view(sink));
    linker_context_free(mut_view(ctx));
    0
}

// 5. Test negative diagnostics: undefined symbol, duplicate symbol, malformed COFF
fn test_linker_diagnostics_and_error_cases() -> i32 {
    let code: [6]u8 = [0xB8u8, 0x2Au8, 0x00u8, 0x00u8, 0x00u8, 0xC3u8];

    // 5a. Undefined symbol ("undefined_func")
    let mut m_undef = objmodel_new();
    let t1 = objmodel_add_section_str(mut_view(m_undef), { ".text" }, AX_SEC_CODE, AX_SEC_FLAG_EXEC | AX_SEC_FLAG_READ, 16u32);
    objmodel_section_append_slice(mut_view(m_undef), SectionId { v: t1.v }, view(code));
    let _ = objmodel_add_symbol_str(mut_view(m_undef), { "main" }, SectionId { v: t1.v }, 0u64, 6u64, AX_SYM_GLOBAL);
    let undef_sym = objmodel_add_symbol_str(mut_view(m_undef), { "undefined_func" }, SectionId.none(), 0u64, 0u64, AX_SYM_EXTERNAL);
    objmodel_section_add_reloc(mut_view(m_undef), SectionId { v: t1.v }, 1u32, AX_RELOC_X86_64_PC32, SymbolId { v: undef_sym.v }, 0i64);
    let mut coff_undef = coff_encode_bytes(view(m_undef));
    objmodel_free(mut_view(m_undef));

    let mut sink1 = DiagSink {
        arena: arena_new(),
        diags: 0 as *mut Diagnostic,
        len: 0, cap: 0, errors: 0, warnings: 0,
    };
    let mut out1 = coff_buf_new();
    let ok1 = pe_link_single_coff_to_buf(coff_undef.ptr as *const u8, coff_undef.len, 0x100000u32, mut_view(out1), sink_ptr(mut_view(sink1)));
    coff_buf_free(mut_view(coff_undef));
    coff_buf_free(mut_view(out1));
    if ok1 || !diag_sink_has_errors(view(sink1)) || linker_diag_code_at(view(sink1), 0) != AX_LINK_UNDEFINED_SYMBOL {
        diag_sink_free(mut_view(sink1));
        return 90;
    }
    let msg1 = linker_diag_message_at(view(sink1), 0);
    let mut exp_msg1 = str_to_cstr_buf({ "undefined_func" });
    if msg1.len != 14 || !cstr_eq(msg1.ptr, exp_msg1.ptr as *const u8) {
        coff_buf_free(mut_view(exp_msg1));
        diag_sink_free(mut_view(sink1));
        return 91;
    }
    coff_buf_free(mut_view(exp_msg1));
    diag_sink_free(mut_view(sink1));

    // 5b. Duplicate symbol ("duplicate symbol: main")
    let mut m_dup = objmodel_new();
    let t2 = objmodel_add_section_str(mut_view(m_dup), { ".text" }, AX_SEC_CODE, AX_SEC_FLAG_EXEC | AX_SEC_FLAG_READ, 16u32);
    objmodel_section_append_slice(mut_view(m_dup), SectionId { v: t2.v }, view(code));
    let _ = objmodel_add_symbol_str(mut_view(m_dup), { "main" }, SectionId { v: t2.v }, 0u64, 6u64, AX_SYM_GLOBAL);
    let _ = objmodel_add_symbol_str(mut_view(m_dup), { "main" }, SectionId { v: t2.v }, 0u64, 6u64, AX_SYM_GLOBAL);
    let mut coff_dup = coff_encode_bytes(view(m_dup));
    objmodel_free(mut_view(m_dup));

    let mut sink2 = DiagSink {
        arena: arena_new(),
        diags: 0 as *mut Diagnostic,
        len: 0, cap: 0, errors: 0, warnings: 0,
    };
    let mut out2 = coff_buf_new();
    let ok2 = pe_link_single_coff_to_buf(coff_dup.ptr as *const u8, coff_dup.len, 0x100000u32, mut_view(out2), sink_ptr(mut_view(sink2)));
    coff_buf_free(mut_view(coff_dup));
    coff_buf_free(mut_view(out2));
    if ok2 || !diag_sink_has_errors(view(sink2)) || linker_diag_code_at(view(sink2), 0) != AX_LINK_DUPLICATE_SYMBOL {
        diag_sink_free(mut_view(sink2));
        return 92;
    }
    let msg2 = linker_diag_message_at(view(sink2), 0);
    let mut exp_msg2 = str_to_cstr_buf({ "duplicate symbol: main" });
    if msg2.len != 22 || !cstr_eq(msg2.ptr, exp_msg2.ptr as *const u8) {
        coff_buf_free(mut_view(exp_msg2));
        diag_sink_free(mut_view(sink2));
        return 93;
    }
    coff_buf_free(mut_view(exp_msg2));
    diag_sink_free(mut_view(sink2));

    // 5c. Malformed COFF object (truncated < 20 bytes)
    let bad_bytes: [12]u8 = [1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8, 9u8, 10u8, 11u8, 12u8];
    let mut sink3 = DiagSink {
        arena: arena_new(),
        diags: 0 as *mut Diagnostic,
        len: 0, cap: 0, errors: 0, warnings: 0,
    };
    let mut out3 = coff_buf_new();
    let p_bad = unsafe { address_of(bad_bytes[0]) };
    let ok3 = pe_link_single_coff_to_buf(p_bad, 12, 0x100000u32, mut_view(out3), sink_ptr(mut_view(sink3)));
    coff_buf_free(mut_view(out3));
    if ok3 || linker_diag_code_at(view(sink3), 0) != AX_LINK_BAD_OBJECT {
        diag_sink_free(mut_view(sink3));
        return 94;
    }
    diag_sink_free(mut_view(sink3));

    0
}

// 6. QA boundary & edge cases:
//    - COFF long section name via `/<strtab_offset>` (`/4` -> `.text_long` -> `.text_lo`)
//    - COFF symbol record with `NumberOfAuxSymbols = 1` followed by a symbol referenced by a relocation
//    - Exact 8-byte `ShortName` symbol without a NUL terminator (`"eightchr"`)
//    - Direct `__IAT_<func>` relocation discovery (without `DLL$` prefix)
//    - Additional malformed COFF checks (wrong Machine field, out-of-bounds section header table)
fn test_qa_coff_edge_cases_and_seams() -> i32 {
    let mut coff = coff_buf_with_capacity(256);

    // 1. IMAGE_FILE_HEADER (20 bytes): 1 section, 3 symbols at offset 78 (sym0 + 1 aux + sym2)
    coff_buf_put_u16(mut_view(coff), IMAGE_FILE_MACHINE_AMD64);
    coff_buf_put_u16(mut_view(coff), 1u16);
    coff_buf_put_u32(mut_view(coff), 0u32);
    coff_buf_put_u32(mut_view(coff), 78u32); // PointerToSymbolTable
    coff_buf_put_u32(mut_view(coff), 3u32);  // NumberOfSymbols (sym0 + 1 aux + sym2)
    coff_buf_put_u16(mut_view(coff), 0u16);
    coff_buf_put_u16(mut_view(coff), 0u16);

    // 2. IMAGE_SECTION_HEADER (40 bytes): Name = "/4\0\0\0\0\0\0"
    let slash4: [8]u8 = [47u8, 52u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    let p_slash4 = unsafe { address_of(slash4[0]) };
    coff_buf_put_bytes(mut_view(coff), p_slash4, 8);
    coff_buf_put_u32(mut_view(coff), 0u32);  // VirtualSize
    coff_buf_put_u32(mut_view(coff), 0u32);  // VirtualAddress
    coff_buf_put_u32(mut_view(coff), 8u32);  // SizeOfRawData = 8
    coff_buf_put_u32(mut_view(coff), 60u32); // PointerToRawData = 60
    coff_buf_put_u32(mut_view(coff), 68u32); // PointerToRelocations = 68
    coff_buf_put_u32(mut_view(coff), 0u32);  // PointerToLinenumbers
    coff_buf_put_u16(mut_view(coff), 1u16);  // NumberOfRelocations = 1
    coff_buf_put_u16(mut_view(coff), 0u16);  // NumberOfLinenumbers
    coff_buf_put_u32(mut_view(coff), IMAGE_SCN_CNT_CODE | IMAGE_SCN_MEM_EXECUTE | IMAGE_SCN_MEM_READ | IMAGE_SCN_ALIGN_16BYTES);

    // 3. Raw Data (8 bytes at offset 60): inline addend -4i32 (0xFFFFFFFC) + 4 NOP/RET bytes
    coff_buf_put_u32(mut_view(coff), 0xFFFFFFFCu32);
    coff_buf_put_u8(mut_view(coff), 0x90u8);
    coff_buf_put_u8(mut_view(coff), 0x90u8);
    coff_buf_put_u8(mut_view(coff), 0x90u8);
    coff_buf_put_u8(mut_view(coff), 0xC3u8);

    // 4. Relocation (10 bytes at offset 68): VirtualAddress = 0, SymbolTableIndex = 2, Type = REL32
    coff_buf_put_u32(mut_view(coff), 0u32);
    coff_buf_put_u32(mut_view(coff), 2u32);
    coff_buf_put_u16(mut_view(coff), IMAGE_REL_AMD64_REL32);

    // 5. Symbol Table (3 * 18 = 54 bytes at offset 78..132)
    // Symbol 0: static section symbol with NumberOfAuxSymbols = 1
    let s0_name: [8]u8 = [46u8, 116u8, 101u8, 120u8, 116u8, 0u8, 0u8, 0u8];
    let p_s0 = unsafe { address_of(s0_name[0]) };
    coff_buf_put_bytes(mut_view(coff), p_s0, 8);
    coff_buf_put_u32(mut_view(coff), 0u32);
    coff_buf_put_i16(mut_view(coff), 1i16);
    coff_buf_put_u16(mut_view(coff), 0u16);
    coff_buf_put_u8(mut_view(coff), IMAGE_SYM_CLASS_STATIC);
    coff_buf_put_u8(mut_view(coff), 1u8); // NumberOfAuxSymbols = 1

    // Symbol 1: 18-byte auxiliary symbol record
    pe_buf_put_zeroes(mut_view(coff), 18);

    // Symbol 2: exact 8-byte ShortName "eightchr" (no NUL byte) at Value = 4 in section 1
    let s2_name: [8]u8 = [101u8, 105u8, 103u8, 104u8, 116u8, 99u8, 104u8, 114u8];
    let p_s2 = unsafe { address_of(s2_name[0]) };
    coff_buf_put_bytes(mut_view(coff), p_s2, 8);
    coff_buf_put_u32(mut_view(coff), 4u32);
    coff_buf_put_i16(mut_view(coff), 1i16);
    coff_buf_put_u16(mut_view(coff), 0u16);
    coff_buf_put_u8(mut_view(coff), IMAGE_SYM_CLASS_EXTERNAL);
    coff_buf_put_u8(mut_view(coff), 0u8);

    // 6. String Table (offset 132..147, 15 bytes): size = 15, offset 4 = ".text_long\0"
    coff_buf_put_u32(mut_view(coff), 15u32);
    let long_sec_str: [11]u8 = [46u8, 116u8, 101u8, 120u8, 116u8, 95u8, 108u8, 111u8, 110u8, 103u8, 0u8];
    let p_long_sec = unsafe { address_of(long_sec_str[0]) };
    coff_buf_put_bytes(mut_view(coff), p_long_sec, 11);

    let mut ctx = LinkerContext {
        sections: 0 as *mut *mut compiler.link.MergedSection,
        num_sections: 0, cap_sections: 0,
        globals: 0 as *mut compiler.link.GlobalSymbol,
        num_globals: 0, cap_globals: 0,
        relocs: 0 as *mut compiler.link.PeReloc,
        num_relocs: 0, cap_relocs: 0,
        str_arena: 0 as *mut Arena,
    };
    linker_context_init(mut_view(ctx));
    let mut sink = DiagSink {
        arena: arena_new(),
        diags: 0 as *mut Diagnostic,
        len: 0, cap: 0, errors: 0, warnings: 0,
    };

    let ok_load = linker_load_coff_object(mut_view(ctx), coff.ptr as *const u8, coff.len, sink_ptr(mut_view(sink)));
    coff_buf_free(mut_view(coff));
    if !ok_load || diag_sink_has_errors(view(sink)) {
        diag_sink_free(mut_view(sink));
        linker_context_free(mut_view(ctx));
        return 100;
    }

    // Long section name "/4" -> ".text_long" truncated to 8 chars ".text_lo"
    let sec_lo = linker_find_section_str(view(ctx), { ".text_lo" });
    if (sec_lo as usize) == 0 || unsafe { (*sec_lo).size } != 8u32 {
        diag_sink_free(mut_view(sink));
        linker_context_free(mut_view(ctx));
        return 101;
    }

    // 8-byte ShortName symbol "eightchr" after 1 aux symbol record
    let g_eight = linker_find_global_str(view(ctx), { "eightchr" });
    if (g_eight as usize) == 0 || !(unsafe { (*g_eight).defined }) || unsafe { (*g_eight).offset } != 4u32 {
        diag_sink_free(mut_view(sink));
        linker_context_free(mut_view(ctx));
        return 102;
    }

    // Relocation referencing SymbolTableIndex = 2 ("eightchr") with signed addend -4
    if ctx.num_relocs != 1 {
        diag_sink_free(mut_view(sink));
        linker_context_free(mut_view(ctx));
        return 103;
    }
    let r0 = linker_reloc_at(view(ctx), 0);
    // ADR-0035 section 2: "eightchr" is defined in this object, so the relocation is bound by symbol
    // index: `dsec` = the merged `.text_lo` section, `doffset` = 4, no name lookup (`sym_name` null).
    let r0_bound = (unsafe { (*r0).dsec } as usize) == (sec_lo as usize) && unsafe { (*r0).doffset } == 4u32 && (unsafe { (*r0).sym_name } as usize) == 0;
    if unsafe { (*r0).addend } != -4i64 || !r0_bound {
        diag_sink_free(mut_view(sink));
        linker_context_free(mut_view(ctx));
        return 104;
    }

    // Direct `__IAT_GetLastError` relocation discovery into KERNEL32.dll (6 base + 1 discovered = 7)
    linker_add_reloc_str(mut_view(ctx), sec_lo, 0u32, IMAGE_REL_AMD64_REL32, { "__IAT_GetLastError" }, 0i64);
    let mut imports = import_table_new();
    import_add_base_kernel32(mut_view(imports), mut_view(ctx));
    import_discover_from_relocs(mut_view(imports), mut_view(ctx));
    let k32 = import_dll_at(view(imports), 0);
    if imports.num_dlls != 1 || unsafe { (*k32).num_funcs } != 7 {
        import_table_free(mut_view(imports));
        diag_sink_free(mut_view(sink));
        linker_context_free(mut_view(ctx));
        return 105;
    }
    import_table_free(mut_view(imports));
    linker_context_free(mut_view(ctx));

    // Malformed COFF 1: wrong Machine field (0x014C i386 instead of 0x8664 AMD64)
    let mut bad_mach = coff_buf_with_capacity(32);
    coff_buf_put_u16(mut_view(bad_mach), 0x014Cu16);
    pe_buf_put_zeroes(mut_view(bad_mach), 18);
    let mut ctx_bad1 = LinkerContext {
        sections: 0 as *mut *mut compiler.link.MergedSection,
        num_sections: 0, cap_sections: 0,
        globals: 0 as *mut compiler.link.GlobalSymbol,
        num_globals: 0, cap_globals: 0,
        relocs: 0 as *mut compiler.link.PeReloc,
        num_relocs: 0, cap_relocs: 0,
        str_arena: 0 as *mut Arena,
    };
    linker_context_init(mut_view(ctx_bad1));
    let ok_bad1 = linker_load_coff_object(mut_view(ctx_bad1), bad_mach.ptr as *const u8, bad_mach.len, sink_ptr(mut_view(sink)));
    coff_buf_free(mut_view(bad_mach));
    linker_context_free(mut_view(ctx_bad1));
    if ok_bad1 || linker_diag_code_at(view(sink), 0) != AX_LINK_BAD_OBJECT {
        diag_sink_free(mut_view(sink));
        return 106;
    }

    // Malformed COFF 2: NumberOfSections = 4 in a 20-byte buffer (shdr_table_end > obj_len)
    let mut bad_shdr = coff_buf_with_capacity(32);
    coff_buf_put_u16(mut_view(bad_shdr), IMAGE_FILE_MACHINE_AMD64);
    coff_buf_put_u16(mut_view(bad_shdr), 4u16);
    pe_buf_put_zeroes(mut_view(bad_shdr), 16);
    let mut ctx_bad2 = LinkerContext {
        sections: 0 as *mut *mut compiler.link.MergedSection,
        num_sections: 0, cap_sections: 0,
        globals: 0 as *mut compiler.link.GlobalSymbol,
        num_globals: 0, cap_globals: 0,
        relocs: 0 as *mut compiler.link.PeReloc,
        num_relocs: 0, cap_relocs: 0,
        str_arena: 0 as *mut Arena,
    };
    linker_context_init(mut_view(ctx_bad2));
    let ok_bad2 = linker_load_coff_object(mut_view(ctx_bad2), bad_shdr.ptr as *const u8, bad_shdr.len, sink_ptr(mut_view(sink)));
    coff_buf_free(mut_view(bad_shdr));
    linker_context_free(mut_view(ctx_bad2));
    if ok_bad2 || (sink.len) < 2 || linker_diag_code_at(view(sink), 1) != AX_LINK_BAD_OBJECT {
        diag_sink_free(mut_view(sink));
        return 107;
    }

    diag_sink_free(mut_view(sink));
    0
}

pub fn main() -> i32 {
    let rc1 = test_pe_constants_and_helpers();
    if rc1 != 0 { return rc1; }

    let rc2 = test_pe_header_encoders_and_decoders();
    if rc2 != 0 { return rc2; }

    let rc3 = test_runtime_stubs_and_import_synthesis();
    if rc3 != 0 { return rc3; }

    let rc4 = test_all_amd64_relocation_types();
    if rc4 != 0 { return rc4; }

    let rc5 = test_linker_diagnostics_and_error_cases();
    if rc5 != 0 { return rc5; }

    let rc6 = test_qa_coff_edge_cases_and_seams();
    if rc6 != 0 { return rc6; }

    print("OK PE Headers, Imports & Relocations\n");
    0
}
