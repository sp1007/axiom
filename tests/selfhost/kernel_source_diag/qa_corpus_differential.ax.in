        *(p_m2 + 10) = 116u8;
        *(p_m2 + 11) = 101u8;
        *(p_m2 + 12) = 109u8;
    }
    let m2_sv = make_sv(p_m2, 13);
    session_report_code(mut_view(sess), diag_code(23u32), span_new(FileId { v: fid.v }, 16u32, 17u32), m2_sv);

    let mut json_buf = diag_buf_new();
    ax_diag_render_json(view(sess.diag_sink), view(sess.source_db), mut_view(json_buf));
    if json_buf.len != 788 { return 201; }
    let mut i: usize = 0;
    while i < 788 {
        let b_out = unsafe { *(json_buf.ptr + i) };
        let b_exp = E01_JSON[i];
        if b_out != b_exp { return 202; }
        i = i + 1;
    }

    let mut hum_buf = diag_buf_new();
    ax_diag_render_human(view(sess.diag_sink), view(sess.source_db), mut_view(hum_buf));
    if hum_buf.len != 271 { return 203; }
    let mut j: usize = 0;
    while j < 271 {
        let b_out = unsafe { *(hum_buf.ptr + j) };
        let b_exp = E01_HUMAN[j];
        if b_out != b_exp { return 204; }
        j = j + 1;
    }

    diag_buf_free(mut_view(json_buf));
    diag_buf_free(mut_view(hum_buf));
    session_free(mut_view(sess));
    arena_destroy(mut_view(scratch));
    0
}

