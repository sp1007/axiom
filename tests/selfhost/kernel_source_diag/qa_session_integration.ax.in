@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic fn wrapping_add_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn rotate_left_u64(x: u64, n: u32) -> u64 { 0 }

fn sv_contains(haystack: StrView, needle: StrView) -> bool {
    let hlen: usize = haystack.len;
    let nlen: usize = needle.len;
    if nlen == 0 { return true; }
    if hlen < nlen { return false; }
    let max_start = hlen - nlen;
    let mut i: usize = 0;
    while i <= max_start {
        let mut match_all = true;
        let mut j: usize = 0;
        while j < nlen {
            let h = unsafe { *(haystack.ptr + i + j) };
            let n = unsafe { *(needle.ptr + j) };
            if h != n { match_all = false; break; }
            j = j + 1;
        }
        if match_all { return true; }
        i = i + 1;
    }
    false
}

fn alloc_mem(scratch: mut_view<Arena>, byte_count: usize) -> *mut u8 {
    arena_alloc_raw(scratch, byte_count, 1)
}
fn make_sv(ptr: *const u8, byte_count: usize) -> StrView {
    StrView { ptr: ptr, len: byte_count }
}

