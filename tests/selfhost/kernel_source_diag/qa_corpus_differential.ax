        *(p_path + 27) = 110u8;
        *(p_path + 28) = 46u8;
        *(p_path + 29) = 97u8;
        *(p_path + 30) = 120u8;
    }
    let path_sv = make_sv(p_path, 31);
    let p_src = alloc_mem(mut_view(scratch), 21);
    unsafe {
        *p_src = 47u8;
