    }
    let dot_sv = make_sv(p_dot, 1);
    let edits_arr = arena_alloc_raw(mut_view(scratch), size_of<DiagEdit>(), align_of<DiagEdit>()) as *mut DiagEdit;
    unsafe {
        *edits_arr = DiagEdit {
            span: span_new(FileId { v: fid.v }, 17u32, 19u32),
            replacement: dot_sv,
        };
    }
    let fixes_arr = arena_alloc_raw(mut_view(scratch), size_of<DiagFix>(), align_of<DiagFix>()) as *mut DiagFix;
    unsafe {
        *fixes_arr = DiagFix {
            message: dot_sv,
            applicability: FixApplicability.MachineApplicable,
            edits: edits_arr,
            edit_count: 1,
        };
    }
    let d1 = Diagnostic {
        code: diag_code(17u32),
        severity: DiagSeverity.Error,
        primary: span_new(FileId { v: fid.v }, 17u32, 19u32),
        message: m1_sv,
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
