        *(p_src + 20) = 10u8;
    }
    let src_sv = make_sv(p_src, 21);
    let fid = session_add_virtual_file(mut_view(sess), path_sv, src_sv);

    let p_m1 = alloc_mem(mut_view(scratch), 30);
    unsafe {
        *p_m1 = 58u8;
        *(p_m1 + 1) = 58u8;
