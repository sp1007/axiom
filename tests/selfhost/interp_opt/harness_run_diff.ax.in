use host_intrinsics.stdio
use host_intrinsics.write

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

const CASE_COUNT: usize = @CASE_COUNT@;

@DATA_TABLE@
@OFFSET_TABLE@
@PRELUDE_TABLE@
@UI_ERR_TABLE@
@EXP_EXIT_TABLE@
@EXP_DIAG0_TABLE@
@EXP_DIAG1_TABLE@
@STEP_LIMIT_TABLE@
@DEPTH_LIMIT_TABLE@

fn blob_sv(a: mut_view<Arena>, idx: usize) -> StrView {
    let start = CASE_OFF[idx] as usize;
    let end = CASE_OFF[idx + 1] as usize;
    let n = end - start;
    let dst = arena_alloc_raw(mut_view(*a), n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe {
            *(dst + i) = CASE_DATA[start + i];
        }
        i = i + 1;
    }
    unsafe {
        *(dst + n) = 0u8;
    }
    StrView { ptr: dst as *const u8, len: n }
}

fn dump_sv(sv: StrView) {
    if sv.len > 0 && (sv.ptr as usize) != 0 {
        unsafe {
            let _ = write(stdio(1u32), sv.ptr, sv.len);
        }
    }
}

fn bytes_equal(a: *const u8, a_len: usize, b: *const u8, b_len: usize) -> bool {
    if a_len != b_len {
        return false;
    }
    let mut i: usize = 0;
    while i < a_len {
        if (unsafe { *(a + i) }) != (unsafe { *(b + i) }) {
            return false;
        }
        i = i + 1;
    }
    true
}

fn empty_node_map() -> NodeMap {
    NodeMap { keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0 }
}

fn sink_has_diag_code(sess: view<CompilerSession>, target_code: u32) -> bool {
    let mut i: usize = 0;
    while i < sess.diag_sink.len {
        let d_ptr = ((sess.diag_sink.diags as usize) + interp_mul_usize(i, size_of<Diagnostic>())) as *const Diagnostic;
        if (unsafe { (*d_ptr).code.v }) == target_code {
            return true;
        }
        i = i + 1;
    }
    false
}

fn run_interp_for_mode(
    sess: mut_view<CompilerSession>,
    mir_arena: mut_view<Arena>,
    ast: view<Ast>,
    rmap: view<ResolveMap>,
    hir: view<HirFile>,
    thir_ptr: *mut Thir,
    fid_v: u32,
    out_ptr: *mut DiagBuffer,
    diag_buf: mut_view<DiagBuffer>,
    path_sv: StrView,
    exp_stdout: StrView,
    exp_panic: StrView,
    exp_diag0: u32,
    case_idx: usize,
    opt_O1: bool
) -> i32 {
    let mode_off: i32 = if opt_O1 { 1000 } else { 0 };
    sess.diag_sink.len = 0;
    sess.diag_sink.errors = 0;
    sess.diag_sink.warnings = 0;
    unsafe {
        (*out_ptr).len = 0;
    }
    diag_buf.len = 0;
    arena_reset(mut_view(*mir_arena));

    let panic_ptr = arena_alloc_raw(mut_view(*mir_arena), size_of<StrView>(), align_of<StrView>()) as *mut StrView;
    unsafe {
        (*panic_ptr).ptr = 0 as *const u8;
        (*panic_ptr).len = 0;
    }
    let run_rc = session_run_interp(
        mut_view(*sess),
        mut_view(*mir_arena),
        ast,
        rmap,
        hir,
        unsafe { mut_view(*thir_ptr) },
        FileId { v: fid_v },
        0 as *mut MonoEngine,
        opt_O1,
        true,
        CASE_STEP_LIMIT[case_idx],
        CASE_DEPTH_LIMIT[case_idx],
        out_ptr,
        true,
        panic_ptr
    );
    let exp_exit = CASE_EXP_EXIT[case_idx];
    let actual_out_ptr = unsafe { (*out_ptr).ptr as *const u8 };
    let actual_out_len = unsafe { (*out_ptr).len };
    let actual_panic_ptr = unsafe { (*panic_ptr).ptr };
    let actual_panic_len = unsafe { (*panic_ptr).len };
    let mut rc: i32 = 0;
    if run_rc != exp_exit {
        dump_sv(path_sv);
        if opt_O1 {
            print("\n--- MISMATCH EXIT CODE (-O1) ---\n");
        } else {
            print("\n--- MISMATCH EXIT CODE (-O0) ---\n");
        }
        diag_buf.len = 0;
        diag_buf_push_u32(mut_view(*diag_buf), run_rc as u32);
        dump_sv(StrView { ptr: diag_buf.ptr as *const u8, len: diag_buf.len });
        print("\n");
        diag_buf.len = 0;
        if actual_panic_len > 0 {
            print("PANIC: ");
            dump_sv(StrView { ptr: actual_panic_ptr, len: actual_panic_len });
            print("\n");
        }
        if sess.diag_sink.len > 0 {
            ax_diag_render_human(view(sess.diag_sink), view(sess.source_db), mut_view(*diag_buf));
            dump_sv(StrView { ptr: diag_buf.ptr as *const u8, len: diag_buf.len });
        }
        rc = mode_off + 300 + (case_idx as i32);
    } else if !bytes_equal(actual_out_ptr, actual_out_len, exp_stdout.ptr, exp_stdout.len) {
        dump_sv(path_sv);
        print("\n--- MISMATCH STDOUT ACTUAL ---\n");
        dump_sv(StrView { ptr: actual_out_ptr, len: actual_out_len });
        print("--- EXPECTED ---\n");
        dump_sv(exp_stdout);
        rc = mode_off + 400 + (case_idx as i32);
    } else if exp_panic.len > 0 && !bytes_equal(actual_panic_ptr, actual_panic_len, exp_panic.ptr, exp_panic.len) {
        dump_sv(path_sv);
        print("\n--- MISMATCH PANIC MSG ACTUAL ---\n");
        dump_sv(StrView { ptr: actual_panic_ptr, len: actual_panic_len });
        print("\n--- EXPECTED ---\n");
        dump_sv(exp_panic);
        rc = mode_off + 500 + (case_idx as i32);
    } else if exp_diag0 != 0u32 && !sink_has_diag_code(view(*sess), exp_diag0) {
        ax_diag_render_human(view(sess.diag_sink), view(sess.source_db), mut_view(*diag_buf));
        dump_sv(path_sv);
        print("\n--- MISSING EXPECTED RUNTIME DIAG ---\n");
        dump_sv(StrView { ptr: diag_buf.ptr as *const u8, len: diag_buf.len });
        rc = mode_off + 600 + (case_idx as i32);
    }
    rc
}

fn run_case_both_modes(
    sess: mut_view<CompilerSession>,
    parse_arena: mut_view<Arena>,
    resolve_arena: mut_view<Arena>,
    hir_arena: mut_view<Arena>,
    mir_arena: mut_view<Arena>,
    scratch: mut_view<Arena>,
    rmap: mut_view<ResolveMap>,
    thir_ptr: *mut Thir,
    out_buf: mut_view<DiagBuffer>,
    diag_buf: mut_view<DiagBuffer>,
    case_idx: usize
) -> i32 {
    session_init(mut_view(*sess));
    let int_arena = arena_with_chunk_size(65536);
    unsafe {
        (*thir_ptr).interner.arena = int_arena;
        thir_init(mut_view(*thir_ptr));
    }
    out_buf.len = 0;
    diag_buf.len = 0;

    let base = case_idx << 2;
    let path_sv = blob_sv(mut_view(*scratch), base);
    let src_sv = blob_sv(mut_view(*scratch), base + 1);
    let exp_stdout = blob_sv(mut_view(*scratch), base + 2);
    let exp_panic = blob_sv(mut_view(*scratch), base + 3);

    let mut fid = FileId { v: 0u32 };
    let mut parse_res = session_parse_virtual_file(
        mut_view(*sess),
        mut_view(*parse_arena),
        StrView { ptr: path_sv.ptr, len: path_sv.len },
        StrView { ptr: src_sv.ptr, len: src_sv.len },
        mut_view(fid)
    );
    if CASE_PRELUDE[case_idx] != 0u32 {
        session_append_std_prelude(
            mut_view(*sess),
            mut_view(*parse_arena),
            mut_view(parse_res.ast),
            StrView { ptr: src_sv.ptr, len: src_sv.len }
        );
    }
    session_resolve_ast_into(mut_view(*sess), mut_view(*resolve_arena), view(parse_res.ast), mut_view(*rmap));
    let hir = session_lower_hir(mut_view(*sess), mut_view(*hir_arena), view(parse_res.ast), view(*rmap));

    unsafe {
        session_typeck_into(mut_view(*sess), view(hir), mut_view(*thir_ptr));
    }
    let _ = session_comptime_check_and_eval(
        mut_view(*sess),
        view(parse_res.ast),
        view(*rmap),
        view(hir),
        unsafe { mut_view(*thir_ptr) }
    );

    let is_ui_err = CASE_UI_ERR[case_idx] != 0u32;
    let exp_diag0 = CASE_EXP_DIAG0[case_idx];
    let exp_diag1 = CASE_EXP_DIAG1[case_idx];
    let mut rc: i32 = 0;

    if is_ui_err {
        if session_error_count(view(*sess)) == 0 {
            dump_sv(path_sv);
            print("\n--- EXPECTED UI/COMPTIME ERROR BUT GOT 0 ERRORS ---\n");
            rc = 100 + (case_idx as i32);
        } else if exp_diag0 != 0u32 && !sink_has_diag_code(view(*sess), exp_diag0) {
            ax_diag_render_human(view(sess.diag_sink), view(sess.source_db), mut_view(*diag_buf));
            dump_sv(path_sv);
            print("\n--- MISSING EXPECTED DIAG0 ---\n");
            dump_sv(StrView { ptr: diag_buf.ptr as *const u8, len: diag_buf.len });
            rc = 120 + (case_idx as i32);
        } else if exp_diag1 != 0u32 && !sink_has_diag_code(view(*sess), exp_diag1) {
            ax_diag_render_human(view(sess.diag_sink), view(sess.source_db), mut_view(*diag_buf));
            dump_sv(path_sv);
            print("\n--- MISSING EXPECTED DIAG1 ---\n");
            dump_sv(StrView { ptr: diag_buf.ptr as *const u8, len: diag_buf.len });
            rc = 140 + (case_idx as i32);
        }
    } else {
        if session_error_count(view(*sess)) != 0 {
            ax_diag_render_human(view(sess.diag_sink), view(sess.source_db), mut_view(*diag_buf));
            dump_sv(path_sv);
            print("\n--- UNEXPECTED FRONTEND/TYPECK/COMPTIME DIAG ---\n");
            dump_sv(StrView { ptr: diag_buf.ptr as *const u8, len: diag_buf.len });
            rc = 200 + (case_idx as i32);
        } else {
            let out_ptr = unsafe { address_of_mut(out_buf.ptr) as *mut DiagBuffer };
            rc = run_interp_for_mode(
                mut_view(*sess),
                mut_view(*mir_arena),
                view(parse_res.ast),
                view(*rmap),
                view(hir),
                thir_ptr,
                fid.v,
                out_ptr,
                mut_view(*diag_buf),
                StrView { ptr: path_sv.ptr, len: path_sv.len },
                StrView { ptr: exp_stdout.ptr, len: exp_stdout.len },
                StrView { ptr: exp_panic.ptr, len: exp_panic.len },
                exp_diag0,
                case_idx,
                false
            );
            if rc == 0 {
                rc = run_interp_for_mode(
                    mut_view(*sess),
                    mut_view(*mir_arena),
                    view(parse_res.ast),
                    view(*rmap),
                    view(hir),
                    thir_ptr,
                    fid.v,
                    out_ptr,
                    mut_view(*diag_buf),
                    StrView { ptr: path_sv.ptr, len: path_sv.len },
                    StrView { ptr: exp_stdout.ptr, len: exp_stdout.len },
                    StrView { ptr: exp_panic.ptr, len: exp_panic.len },
                    exp_diag0,
                    case_idx,
                    true
                );
            }
        }
    }

    resolve_map_free(mut_view(*rmap));
    unsafe {
        thir_free(mut_view(*thir_ptr));
    }
    arena_reset(mut_view(*mir_arena));
    arena_reset(mut_view(*hir_arena));
    arena_reset(mut_view(*resolve_arena));
    arena_reset(mut_view(*parse_arena));
    arena_reset(mut_view(*scratch));
    session_free(mut_view(*sess));
    rc
}

fn new_arena(chunk: usize) -> Arena {
    let mut a = arena_with_chunk_size(chunk);
    let _ = arena_alloc_raw(mut_view(a), 16, 8);
    a
}

fn new_buf(perm: mut_view<Arena>) -> DiagBuffer {
    let mut b = diag_buf_new();
    let p = arena_alloc_raw(perm, 65536, 1);
    b.ptr = p;
    b.cap = 65536;
    b
}

pub fn main() -> i32 {
    let mut sess = session_new();
    let mut perm_arena = new_arena(262144);
    let mut parse_arena = new_arena(262144);
    let mut resolve_arena = new_arena(262144);
    let mut hir_arena = new_arena(262144);
    let mut mir_arena = new_arena(262144);
    let mut scratch = new_arena(65536);
    let thir_ptr = arena_alloc_raw(mut_view(perm_arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;

    let mut rmap = ResolveMap {
        node_map: empty_node_map(),
        module_access_nodes: empty_node_map(),
        extern_nodes: empty_node_map(),
        next_symbol_v: 1u32,
        next_std_symbol_v: 10000u32,
        naming_ctx: 0 as *mut NamingCtx,
    };

    let mut out_buf = new_buf(mut_view(perm_arena));
    let mut diag_buf = new_buf(mut_view(perm_arena));

    let mut i: usize = 0;
    while i < CASE_COUNT {
        let rc = run_case_both_modes(
            mut_view(sess),
            mut_view(parse_arena),
            mut_view(resolve_arena),
            mut_view(hir_arena),
            mut_view(mir_arena),
            mut_view(scratch),
            mut_view(rmap),
            thir_ptr,
            mut_view(out_buf),
            mut_view(diag_buf),
            i
        );
        if rc != 0 {
            return rc;
        }
        i = i + 1;
    }

    arena_destroy(mut_view(scratch));
    arena_destroy(mut_view(mir_arena));
    arena_destroy(mut_view(hir_arena));
    arena_destroy(mut_view(resolve_arena));
    arena_destroy(mut_view(parse_arena));
    arena_destroy(mut_view(perm_arena));

    print("OK interp_opt @GROUP@ (@CASE_COUNT@ cases)\n");
    0
}
