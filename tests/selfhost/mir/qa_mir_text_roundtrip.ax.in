fn assert_eq_u8(actual: u8, expected: u8, code: i32) {
    if actual != expected {
        unsafe { exit(code); }
    }
}

fn assert_true(cond: bool, code: i32) {
    if !cond {
        unsafe { exit(code); }
    }
}

fn qa_tbl_to_sv(a: mut_view<Arena>, off: usize, slen: usize) -> StrView {
    let dst = arena_alloc_raw(a, slen + 1, 1);
    let mut i: usize = 0;
    while i < slen {
        unsafe { *(dst + i) = QA_MIR_STR_DATA[off + i]; }
        i = i + 1;
    }
    unsafe { *(dst + slen) = 0u8; }
    StrView { ptr: dst as *const u8, len: slen }
}

fn dump_sv(sv: StrView) {
    let _ = sv.len;
}

fn sv_eq_buf(sv_in: StrView, buf: view<DiagBuffer>) -> bool {
    let sv = diag_buf_as_str_view(view(*buf));
    if sv_in.len != sv.len {
        dump_sv(sv);
        return false;
    }
    let mut i: usize = 0;
    while i < sv_in.len {
        let ca = unsafe { *(sv_in.ptr + i) };
        let cb = unsafe { *(sv.ptr + i) };
        if ca != cb {
            dump_sv(sv);
            return false;
        }
        i = i + 1;
    }
    true
}

fn buf_eq_buf(a: view<DiagBuffer>, b: view<DiagBuffer>) -> bool {
    let sva = diag_buf_as_str_view(view(*a));
    let svb = diag_buf_as_str_view(view(*b));
    if sva.len != svb.len {
        return false;
    }
    let mut i: usize = 0;
    while i < sva.len {
        if (unsafe { *(sva.ptr + i) }) != (unsafe { *(svb.ptr + i) }) {
            return false;
        }
        i = i + 1;
    }
    true
}

fn make_place_1(a: mut_view<Arena>, loc: u32, p0: MirProjection) -> MirPlace {
    let projs = arena_alloc_raw(mut_view(*a), size_of<MirProjection>(), align_of<MirProjection>()) as *mut MirProjection;
    unsafe { mir_copy_proj(mut_view(*projs), view(p0)); }
    let mut pl = mir_local_place(loc);
    pl.projs = projs;
    pl.proj_count = 1;
    pl
}

fn make_place_2(a: mut_view<Arena>, loc: u32, p0: MirProjection, p1: MirProjection) -> MirPlace {
    let projs = arena_alloc_raw(mut_view(*a), 2 * size_of<MirProjection>(), align_of<MirProjection>()) as *mut MirProjection;
    let p0_ptr = unsafe { mir_proj_at(projs, 0) };
    let p1_ptr = unsafe { mir_proj_at(projs, 1) };
    unsafe {
        mir_copy_proj(mut_view(*p0_ptr), view(p0));
        mir_copy_proj(mut_view(*p1_ptr), view(p1));
    }
    let mut pl = mir_local_place(loc);
    pl.projs = projs;
    pl.proj_count = 2;
    pl
}

fn proj_deref() -> MirProjection {
    MirProjection {
        kind: MIR_PROJ_DEREF,
        field_idx: 0u32,
        index_local: MirLocalId { v: 0u32 },
        from_local: MirLocalId { v: 0u32 },
        to_local: MirLocalId { v: 0u32 },
        has_from: false,
        has_to: false,
        variant_idx: 0u32,
    }
}

fn proj_field(idx: u32) -> MirProjection {
    MirProjection {
        kind: MIR_PROJ_FIELD,
        field_idx: idx,
        index_local: MirLocalId { v: 0u32 },
        from_local: MirLocalId { v: 0u32 },
        to_local: MirLocalId { v: 0u32 },
        has_from: false,
        has_to: false,
        variant_idx: 0u32,
    }
}

fn proj_downcast(v: u32) -> MirProjection {
    MirProjection {
        kind: MIR_PROJ_DOWNCAST,
        field_idx: 0u32,
        index_local: MirLocalId { v: 0u32 },
        from_local: MirLocalId { v: 0u32 },
        to_local: MirLocalId { v: 0u32 },
        has_from: false,
        has_to: false,
        variant_idx: v,
    }
}

fn proj_index(loc: u32) -> MirProjection {
    MirProjection {
        kind: MIR_PROJ_INDEX,
        field_idx: 0u32,
        index_local: MirLocalId { v: loc },
        from_local: MirLocalId { v: 0u32 },
        to_local: MirLocalId { v: 0u32 },
        has_from: false,
        has_to: false,
        variant_idx: 0u32,
    }
}

fn proj_subslice(has_f: bool, from_loc: u32, has_t: bool, to_loc: u32) -> MirProjection {
    MirProjection {
        kind: MIR_PROJ_SUB_SLICE,
        field_idx: 0u32,
        index_local: MirLocalId { v: 0u32 },
        from_local: MirLocalId { v: from_loc },
        to_local: MirLocalId { v: to_loc },
        has_from: has_f,
        has_to: has_t,
        variant_idx: 0u32,
    }
}

fn test_region_relate(a: mut_view<Arena>) {
    let p1 = mir_place_local(MirLocalId { v: 1u32 });
    let p2 = mir_place_local(MirLocalId { v: 2u32 });
    assert_eq_u8(mir_region_relate(view(p1), view(p2)), MIR_REGION_DISJOINT, 101);
    assert_eq_u8(mir_region_relate(view(p1), view(p1)), MIR_REGION_SAME, 102);

    let p1_f0 = make_place_1(mut_view(*a), 1u32, proj_field(0u32));
    let p1_f1 = make_place_1(mut_view(*a), 1u32, proj_field(1u32));
    let p1_f0_f2 = make_place_2(mut_view(*a), 1u32, proj_field(0u32), proj_field(2u32));
    assert_eq_u8(mir_region_relate(view(p1_f0), view(p1_f1)), MIR_REGION_DISJOINT, 103);
    assert_eq_u8(mir_region_relate(view(p1_f0), view(p1_f0)), MIR_REGION_SAME, 104);
    assert_eq_u8(mir_region_relate(view(p1_f0), view(p1_f0_f2)), MIR_REGION_CONTAINS, 105);
    assert_eq_u8(mir_region_relate(view(p1_f0_f2), view(p1_f0)), MIR_REGION_OVERLAPS, 106);
    assert_eq_u8(mir_region_relate(view(p1), view(p1_f0)), MIR_REGION_CONTAINS, 107);

    let p1_v0_f0 = make_place_2(mut_view(*a), 1u32, proj_downcast(0u32), proj_field(0u32));
    let p1_v1_f0 = make_place_2(mut_view(*a), 1u32, proj_downcast(1u32), proj_field(0u32));
    let p1_v0_f1 = make_place_2(mut_view(*a), 1u32, proj_downcast(0u32), proj_field(1u32));
    assert_eq_u8(mir_region_relate(view(p1_v0_f0), view(p1_v1_f0)), MIR_REGION_DISJOINT, 108);
    assert_eq_u8(mir_region_relate(view(p1_v0_f0), view(p1_v0_f1)), MIR_REGION_DISJOINT, 109);
    assert_eq_u8(mir_region_relate(view(p1_v0_f0), view(p1_v0_f0)), MIR_REGION_SAME, 110);

    let s_0_2 = make_place_1(mut_view(*a), 1u32, proj_subslice(true, 0u32, true, 2u32));
    let s_2_4 = make_place_1(mut_view(*a), 1u32, proj_subslice(true, 2u32, true, 4u32));
    let s_1_3 = make_place_1(mut_view(*a), 1u32, proj_subslice(true, 1u32, true, 3u32));
    let s_0_2_f0 = make_place_2(mut_view(*a), 1u32, proj_subslice(true, 0u32, true, 2u32), proj_field(0u32));
    assert_eq_u8(mir_region_relate(view(s_0_2), view(s_2_4)), MIR_REGION_DISJOINT, 111);
    assert_eq_u8(mir_region_relate(view(s_2_4), view(s_0_2)), MIR_REGION_DISJOINT, 112);
    assert_eq_u8(mir_region_relate(view(s_0_2), view(s_1_3)), MIR_REGION_UNKNOWN, 113);
    assert_eq_u8(mir_region_relate(view(s_0_2), view(s_0_2_f0)), MIR_REGION_CONTAINS, 114);
    assert_eq_u8(mir_region_relate(view(s_0_2_f0), view(s_0_2)), MIR_REGION_OVERLAPS, 115);
    assert_eq_u8(mir_region_relate(view(s_1_3), view(s_1_3)), MIR_REGION_SAME, 116);

    let s_open = make_place_1(mut_view(*a), 1u32, proj_subslice(true, 2u32, false, 0u32));
    assert_eq_u8(mir_region_relate(view(s_open), view(s_1_3)), MIR_REGION_UNKNOWN, 117);

    let p_idx2 = make_place_1(mut_view(*a), 1u32, proj_index(2u32));
    let p_idx3 = make_place_1(mut_view(*a), 1u32, proj_index(3u32));
    assert_eq_u8(mir_region_relate(view(p_idx2), view(p_idx3)), MIR_REGION_UNKNOWN, 118);

    let p_deref = make_place_1(mut_view(*a), 1u32, proj_deref());
    let p_deref_f0 = make_place_2(mut_view(*a), 1u32, proj_deref(), proj_field(0u32));
    let p_deref_f1 = make_place_2(mut_view(*a), 1u32, proj_deref(), proj_field(1u32));
    assert_eq_u8(mir_region_relate(view(p_deref_f0), view(p_deref_f0)), MIR_REGION_SAME, 119);
    assert_eq_u8(mir_region_relate(view(p_deref_f0), view(p_deref_f1)), MIR_REGION_DISJOINT, 120);
    assert_eq_u8(mir_region_relate(view(p1_f0), view(p_deref)), MIR_REGION_UNKNOWN, 121);
}

fn check_roundtrip(
    a: mut_view<Arena>,
    ti_ptr: *mut TypeInterner,
    buf1: mut_view<DiagBuffer>,
    buf2: mut_view<DiagBuffer>,
    off: usize,
    slen: usize,
    check_exact_first: bool,
    code_base: i32
) {
    let sv1 = qa_tbl_to_sv(mut_view(*a), off, slen);
    let sptr = sv1.ptr;

    let body1 = mir_parse(sv1, unsafe { mut_view(*ti_ptr) }, mut_view(*a));
    assert_true((body1 as usize) != 0, code_base + 1);

    buf1.len = 0;
    mir_print(mut_view(*buf1), unsafe { view(*body1) });

    if check_exact_first {
        let eq1 = sv_eq_buf(StrView { ptr: sptr, len: slen }, view(*buf1));
        assert_true(eq1, code_base + 2);
    }

    let sv2 = diag_buf_as_str_view(view(*buf1));
    let body2 = mir_parse(sv2, unsafe { mut_view(*ti_ptr) }, mut_view(*a));
    assert_true((body2 as usize) != 0, code_base + 3);

    buf2.len = 0;
    mir_print(mut_view(*buf2), unsafe { view(*body2) });
    let eq2 = buf_eq_buf(view(*buf1), view(*buf2));
    assert_true(eq2, code_base + 4);

    arena_reset(mut_view(*a));
}

pub fn main() -> i32 {
    let mut perm = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(perm), 16, 8);
    let mut a = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(a), 16, 8);
    test_region_relate(mut_view(a));
    arena_reset(mut_view(a));

    let ti_ptr = arena_alloc_raw(mut_view(perm), size_of<TypeInterner>(), align_of<TypeInterner>()) as *mut TypeInterner;
    unsafe { type_interner_init(mut_view(*ti_ptr)); }
    let mut buf1 = diag_buf_new();
    buf1.ptr = arena_alloc_raw(mut_view(perm), 32768, 1);
    buf1.cap = 32768;
    let mut buf2 = diag_buf_new();
    buf2.ptr = arena_alloc_raw(mut_view(perm), 32768, 1);
    buf2.cap = 32768;

    check_roundtrip(mut_view(a), ti_ptr, mut_view(buf1), mut_view(buf2), 0, 198, true, 200); // basic
    check_roundtrip(mut_view(a), ti_ptr, mut_view(buf1), mut_view(buf2), 198, 211, true, 210); // complex
    check_roundtrip(mut_view(a), ti_ptr, mut_view(buf1), mut_view(buf2), 409, 224, true, 220); // exhaustive
    check_roundtrip(mut_view(a), ti_ptr, mut_view(buf1), mut_view(buf2), 633, 297, false, 230); // extra_qa
    check_roundtrip(mut_view(a), ti_ptr, mut_view(buf1), mut_view(buf2), 930, 1177, true, 240); // full_feature

    unsafe { type_interner_free(mut_view(*ti_ptr)); }
    arena_destroy(mut_view(a));
    arena_destroy(mut_view(perm));
    print("OK MIR Text Roundtrip and Region Relate\n");
    0
}
