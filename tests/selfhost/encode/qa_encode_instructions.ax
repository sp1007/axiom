    x64_add_mr(sec, sz, dst, src);
}

pub fn x64_add_rm(sec: mut_view<Section>, sz: u8, dst: i32, src: X64Mem) {
    x64_emit_op_mem(sec, sz, 0x02u8, 0x03u8, dst, src);
}

pub fn ax_x64_add_rm(sec: mut_view<Section>, sz: u8, dst: i32, src: X64Mem) {
    x64_add_rm(sec, sz, dst, src);
}

pub fn x64_add_ri(sec: mut_view<Section>, sz: u8, dst: i32, imm: i32) {
    emit_alu_ri(sec, sz, 0x04u8, 0u8, dst, imm);
