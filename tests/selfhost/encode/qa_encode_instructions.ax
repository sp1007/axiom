@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

fn str_eq(a: Str, b: Str) -> bool {
    let ab: view<[u8]> = unsafe { *(address_of(a) as *const view<[u8]>) };
    let bb: view<[u8]> = unsafe { *(address_of(b) as *const view<[u8]>) };
    let n = len(ab);
    if n != len(bb) {
        return false;
    }
    let mut i: usize = 0;
    while i < n {
        if ab[i] != bb[i] {
            return false;
        }
        i = i + 1;
    }
    true
}

fn check_sec_bytes(sec: view<Section>, exp: view<[u8]>) -> bool {
    let n = len(exp);
    if section_bytes_len(sec) != n {
        return false;
    }
    let mut i: usize = 0;
    while i < n {
        if section_byte_at(sec, i) != exp[i] {
            return false;
        }
        i = i + 1;
    }
    true
}

fn check1(sec: mut_view<Section>, b0: u8) -> bool {
    let exp: [1]u8 = [b0];
    let ok = check_sec_bytes(view(*sec), view(exp));
    sec.bytes_len = 0;
    ok
}

fn check2(sec: mut_view<Section>, b0: u8, b1: u8) -> bool {
    let exp: [2]u8 = [b0, b1];
    let ok = check_sec_bytes(view(*sec), view(exp));
    sec.bytes_len = 0;
    ok
}

fn check3(sec: mut_view<Section>, b0: u8, b1: u8, b2: u8) -> bool {
    let exp: [3]u8 = [b0, b1, b2];
    let ok = check_sec_bytes(view(*sec), view(exp));
    sec.bytes_len = 0;
    ok
}

