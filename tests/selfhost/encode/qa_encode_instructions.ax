// --- OR (op_rm=0x0A, op_mr=0x08, op_imm=0x0C, ext=1) ---

pub fn x64_or_rr(sec: mut_view<Section>, sz: u8, dst: i32, src: i32) {
    x64_emit_op_rm(sec, sz, 0x08u8, 0x09u8, src, dst);
}

pub fn ax_x64_or_rr(sec: mut_view<Section>, sz: u8, dst: i32, src: i32) {
    x64_or_rr(sec, sz, dst, src);
}

pub fn x64_or_mr(sec: mut_view<Section>, sz: u8, dst: X64Mem, src: i32) {
    x64_emit_op_mem(sec, sz, 0x08u8, 0x09u8, src, dst);
}

pub fn ax_x64_or_mr(sec: mut_view<Section>, sz: u8, dst: X64Mem, src: i32) {
