fn sec_matches_slice(sec: view<Section>, expected: view<[u8]>) -> bool {
    let n = len(expected);
    if sec.bytes_len != n {
        return false;
    }
    let mut i: usize = 0;
    while i < n {
        let b = unsafe { *(sec.bytes + i) };
        if b != expected[i] {
            return false;
        }
        i = i + 1;
    }
    true
}

fn buf_matches_slice(buf: view<CoffBuf>, expected: view<[u8]>) -> bool {
    let n = len(expected);
    if buf.len != n {
        return false;
    }
    let mut i: usize = 0;
    while i < n {
        let b = unsafe { *(buf.ptr + i) };
        if b != expected[i] {
            return false;
        }
        i = i + 1;
    }
    true
}

// 1. Test all RIP-relative and PC-relative symbol relocation instruction emitters
fn test_relocation_emitters() -> i32 {
    let mut m = objmodel_new();
    let text_id = objmodel_add_section_str(mut_view(m), { ".text" }, AX_SEC_CODE, AX_SEC_FLAG_EXEC | AX_SEC_FLAG_READ, 16u32);
    let data_id = objmodel_add_section_str(mut_view(m), { ".data" }, AX_SEC_DATA, AX_SEC_FLAG_READ | AX_SEC_FLAG_WRITE, 8u32);
    let sym_fn = objmodel_add_symbol_str(mut_view(m), { "target_fn" }, SectionId.none(), 0u64, 0u64, AX_SYM_EXTERNAL);
    let sym_var = objmodel_add_symbol_str(mut_view(m), { "global_var" }, SectionId { v: data_id.v }, 0u64, 8u64, AX_SYM_GLOBAL);

    let sec = objmodel_get_section_mut(mut_view(m), SectionId { v: text_id.v });

    // (a) call_sym at offset 0 -> E8 00 00 00 00 (5 bytes), reloc at offset 1, addend -4
    unsafe { x64_call_sym(mut_view(*sec), SymbolId { v: sym_fn.v }); }
    // (b) lea_sym rax, [rip + global_var] at offset 5 -> 48 8D 05 00 00 00 00 (7 bytes), reloc at offset 8, addend -4
    unsafe { x64_lea_sym(mut_view(*sec), REG_RAX, SymbolId { v: sym_var.v }); }
    // (c) lea_sym_disp r8, [rip + global_var + 16] at offset 12 -> 4C 8D 05 00 00 00 00 (7 bytes), reloc at offset 15, addend 12
    unsafe { x64_lea_sym_disp(mut_view(*sec), REG_R8, SymbolId { v: sym_var.v }, 16i64); }
    // (d) mov_rm_sym 64-bit rcx, [rip + global_var + 8] at offset 19 -> 48 8B 0D 00 00 00 00 (7 bytes), reloc at offset 22, addend 4
    unsafe { x64_mov_rm_sym_disp(mut_view(*sec), 8u8, REG_RCX, SymbolId { v: sym_var.v }, 8i64); }
    // (e) mov_rm_sym 32-bit r9d, [rip + global_var] at offset 26 -> 44 8B 0D 00 00 00 00 (7 bytes), reloc at offset 29, addend -4
    unsafe { x64_mov_rm_sym(mut_view(*sec), 4u8, REG_R9, SymbolId { v: sym_var.v }); }
    // (f) mov_rm_sym 16-bit ax, [rip + global_var] at offset 33 -> 66 8B 05 00 00 00 00 (7 bytes), reloc at offset 36, addend -4
    unsafe { x64_mov_rm_sym(mut_view(*sec), 2u8, REG_RAX, SymbolId { v: sym_var.v }); }
    // (g) mov_rm_sym 8-bit sil, [rip + global_var] at offset 40 -> 40 8A 35 00 00 00 00 (7 bytes), reloc at offset 43, addend -4
    unsafe { x64_mov_rm_sym(mut_view(*sec), 1u8, REG_RSI, SymbolId { v: sym_var.v }); }
    // (h) mov_mr_sym 64-bit [rip + global_var + 24], rdx at offset 47 -> 48 89 15 00 00 00 00 (7 bytes), reloc at offset 50, addend 20
    unsafe { x64_mov_mr_sym_disp(mut_view(*sec), 8u8, SymbolId { v: sym_var.v }, 24i64, REG_RDX); }
    // (i) mov_mr_sym 8-bit [rip + global_var], dil at offset 54 -> 40 88 3D 00 00 00 00 (7 bytes), reloc at offset 57, addend -4
    unsafe { x64_mov_mr_sym(mut_view(*sec), 1u8, SymbolId { v: sym_var.v }, REG_RDI); }
    // (j) jcc_sym CC_E, sym_fn at offset 61 -> 0F 84 00 00 00 00 (6 bytes), reloc at offset 63, addend -4
    unsafe { x64_jcc_sym(mut_view(*sec), CC_E, SymbolId { v: sym_fn.v }); }
    // (k) jmp_sym sym_fn at offset 67 -> E9 00 00 00 00 (5 bytes), reloc at offset 68, addend -4
    unsafe { x64_jmp_sym(mut_view(*sec), SymbolId { v: sym_fn.v }); }

    let blen = unsafe { (*sec).bytes_len };
    let rlen = unsafe { (*sec).relocs_len };
    if blen != 72 || rlen != 11 {
        objmodel_free(mut_view(m));
        return 10;
    }

    let r0 = section_reloc_at(unsafe { view(*sec) }, 0);
    let r1 = section_reloc_at(unsafe { view(*sec) }, 1);
    let r2 = section_reloc_at(unsafe { view(*sec) }, 2);
    let r3 = section_reloc_at(unsafe { view(*sec) }, 3);
    let r7 = section_reloc_at(unsafe { view(*sec) }, 7);
    let r9 = section_reloc_at(unsafe { view(*sec) }, 9);
    let r10 = section_reloc_at(unsafe { view(*sec) }, 10);

    if (unsafe { (*r0).offset }) != 1u32 || (unsafe { (*r0).addend }) != -4i64 || (unsafe { (*r0).symbol_id.v }) != sym_fn.v {
        objmodel_free(mut_view(m));
        return 11;
    }
    if (unsafe { (*r1).offset }) != 8u32 || (unsafe { (*r1).addend }) != -4i64 || (unsafe { (*r1).symbol_id.v }) != sym_var.v {
        objmodel_free(mut_view(m));
        return 12;
    }
    if (unsafe { (*r2).offset }) != 15u32 || (unsafe { (*r2).addend }) != 12i64 {
        objmodel_free(mut_view(m));
        return 13;
    }
    if (unsafe { (*r3).offset }) != 22u32 || (unsafe { (*r3).addend }) != 4i64 {
        objmodel_free(mut_view(m));
        return 14;
    }
    if (unsafe { (*r7).offset }) != 50u32 || (unsafe { (*r7).addend }) != 20i64 {
        objmodel_free(mut_view(m));
        return 15;
    }
    if (unsafe { (*r9).offset }) != 63u32 || (unsafe { (*r9).addend }) != -4i64 || (unsafe { (*r9).kind }) != AX_RELOC_X86_64_PC32 {
        objmodel_free(mut_view(m));
        return 16;
    }
    if (unsafe { (*r10).offset }) != 68u32 || (unsafe { (*r10).addend }) != -4i64 || (unsafe { (*r10).kind }) != AX_RELOC_X86_64_PC32 {
        objmodel_free(mut_view(m));
        return 17;
    }

    // Test external symbol deduplication helpers & panic sequence emission
    let rdata_id = objmodel_add_section_str(mut_view(m), { ".rdata" }, AX_SEC_RODATA, AX_SEC_FLAG_READ, 16u32);
    let rdata_sec = objmodel_get_section_mut(mut_view(m), SectionId { v: rdata_id.v });
    let panic_msg: [27]u8 = [
        112u8, 97u8, 110u8, 105u8, 99u8, 58u8, 32u8, 97u8, 114u8, 105u8, 116u8, 104u8, 109u8, 101u8, 116u8, 105u8,
        99u8, 32u8, 111u8, 118u8, 101u8, 114u8, 102u8, 108u8, 111u8, 119u8, 10u8,
    ];
    let panic_str_sym = unsafe {
        x64_emit_rodata_slice(
            mut_view(*rdata_sec),
            mut_view(m),
            SectionId { v: rdata_id.v },
            { ".Lpanic_0" },
            view(panic_msg),
            false,
            AX_SYM_GLOBAL
        )
    };
    let panic_fn_sym = x64_find_or_add_extern_sym_str(mut_view(m), { "axiom_panic" });
    let sec2 = objmodel_get_section_mut(mut_view(m), SectionId { v: text_id.v });
    unsafe {
        x64_emit_panic_sequence(mut_view(*sec2), SymbolId { v: panic_str_sym.v }, 27u32, SymbolId { v: panic_fn_sym.v });
    }

    // x64_find_or_add_extern_sym_str("axiom_panic") and x64_lea_extern_str("target_fn") must reuse existing SymbolIds
    let sym_count_before = objmodel_symbol_count(view(m));
    let reused_panic_sym = x64_find_or_add_extern_sym_str(mut_view(m), { "axiom_panic" });
    let lea_ext_sym = unsafe { x64_lea_extern_str(mut_view(*sec2), mut_view(m), REG_RAX, { "target_fn" }) };
    let sym_count_after = objmodel_symbol_count(view(m));
    if sym_count_before != sym_count_after || reused_panic_sym.v != panic_fn_sym.v || lea_ext_sym.v != sym_fn.v {
        objmodel_free(mut_view(m));
        return 18;
    }

    objmodel_free(mut_view(m));
    0
}

// 2. Test branch fixups (forward and backward jumps across basic blocks) and rel8 computation
fn test_branch_fixups_and_patching() -> i32 {
    let mut m = objmodel_new();
    let text_id = objmodel_add_section_str(mut_view(m), { ".text" }, AX_SEC_CODE, AX_SEC_FLAG_EXEC | AX_SEC_FLAG_READ, 16u32);
    let sec = objmodel_get_section_mut(mut_view(m), SectionId { v: text_id.v });

    let mut block_offsets: [3]u32 = [0u32; 3];
    let mut fixups: [3]X64BranchFixup = [
        X64BranchFixup { fixup_offset: 0u32, target_bb: 0u32 },
        X64BranchFixup { fixup_offset: 0u32, target_bb: 0u32 },
        X64BranchFixup { fixup_offset: 0u32, target_bb: 0u32 },
    ];

    // Block 0 (offset 0):
    //   cmp rax, 0       (4 bytes: 48 83 F8 00)
    //   je block_2       (6 bytes: 0F 84 <patch0 at offset 6>)
    //   jmp block_1      (5 bytes: E9 <patch1 at offset 11>)
    block_offsets[0] = (unsafe { (*sec).bytes_len }) as u32;
    unsafe { x64_cmp_ri(mut_view(*sec), 8u8, REG_RCX, 0); }
    fixups[0] = unsafe { x64_emit_jcc_placeholder(mut_view(*sec), CC_E, 2u32) };
    fixups[1] = unsafe { x64_emit_jmp_placeholder(mut_view(*sec), 1u32) };

    // Block 1 (offset 15):
    //   add rax, 1       (4 bytes: 48 83 C0 01)
    //   jmp block_0      (5 bytes: E9 <patch2 at offset 20>)
    block_offsets[1] = (unsafe { (*sec).bytes_len }) as u32;
    unsafe { x64_add_ri(mut_view(*sec), 8u8, REG_RCX, 1); }
    fixups[2] = unsafe { x64_emit_jmp_placeholder(mut_view(*sec), 0u32) };

    // Block 2 (offset 24):
    //   ret              (1 byte: C3)
    block_offsets[2] = (unsafe { (*sec).bytes_len }) as u32;
    unsafe { x64_ret(mut_view(*sec)); }

    unsafe { x64_patch_branch_fixups(mut_view(*sec), view(fixups), 3, view(block_offsets)); }

    let raw = unsafe { (*sec).bytes as *const u8 };
    // patch0 at offset 6: target block_2 (24) - (6 + 4) = 14
    if coff_read_i32_le(raw, 6) != 14i32 {
        objmodel_free(mut_view(m));
        return 21;
    }
    // patch1 at offset 11: target block_1 (15) - (11 + 4) = 0
    if coff_read_i32_le(raw, 11) != 0i32 {
        objmodel_free(mut_view(m));
        return 22;
    }
    // patch2 at offset 20: target block_0 (0) - (20 + 4) = -24
    if coff_read_i32_le(raw, 20) != -24i32 {
        objmodel_free(mut_view(m));
        return 23;
    }

    // Verify x64_compute_rel8 helper
    if x64_compute_rel8(10u32, 2u32, 20u32) != 8i8 {
        objmodel_free(mut_view(m));
        return 24;
    }
    if x64_compute_rel8(20u32, 2u32, 10u32) != -12i8 {
        objmodel_free(mut_view(m));
        return 25;
    }

    objmodel_free(mut_view(m));
    0
}

// 3. Test frame prologue/epilogue against main_42.mc (74 bytes) and stack probe loop boundaries
fn test_frame_prologue_epilogue_and_stack_probe() -> i32 {
    let mut m = objmodel_new();
    let s_mc = objmodel_add_section_str(mut_view(m), { ".mc" }, AX_SEC_CODE, AX_SEC_FLAG_EXEC | AX_SEC_FLAG_READ, 16u32);
    let sec_mc = objmodel_get_section_mut(mut_view(m), SectionId { v: s_mc.v });

    unsafe {
        x64_emit_prologue_size(mut_view(*sec_mc), 72u32);
        x64_mov_ri(mut_view(*sec_mc), 8u8, REG_RAX, 42);
        x64_mov_mr(mut_view(*sec_mc), 8u8, x64_mem_frame_rbp(-72), REG_RAX);
        x64_lea(mut_view(*sec_mc), 8u8, REG_RAX, x64_mem_frame_rbp(-64));
        x64_mov_mr(mut_view(*sec_mc), 8u8, x64_mem_frame_rbp(-80), REG_RAX);
        x64_mov_rm(mut_view(*sec_mc), 8u8, REG_RAX, x64_mem_frame_rbp(-80));
        x64_mov_rm(mut_view(*sec_mc), 8u8, REG_RCX, x64_mem_frame_rbp(-72));
        x64_mov_mr(mut_view(*sec_mc), 8u8, x64_mem_base(REG_RAX), REG_RCX);
        let fix = x64_emit_jmp_placeholder(mut_view(*sec_mc), 0u32);
        let target = (*sec_mc).bytes_len as u32;
        x64_patch_rel32(mut_view(*sec_mc), fix.fixup_offset, target);
        x64_mov_rm(mut_view(*sec_mc), 8u8, REG_RAX, x64_mem_frame_rbp(-64));
        x64_emit_epilogue_size(mut_view(*sec_mc), 72u32);
        x64_ret(mut_view(*sec_mc));
    }

    let exp_mc = EXPECTED_MAIN_42_MC;
    if !sec_matches_slice(unsafe { view(*sec_mc) }, view(exp_mc)) {
        objmodel_free(mut_view(m));
        return 30;
    }

    // Test stack probe boundary from tests/mc/frame/cdriver_probe_edge.c:
    // (a) 4088 bytes (<= 4096): no probe loop, emits 15-byte register save + 7-byte `sub rsp, 4088` (48 81 EC F8 0F 00 00) = 22 bytes
    let s_noprobe = objmodel_add_section_str(mut_view(m), { ".noprobe" }, AX_SEC_CODE, AX_SEC_FLAG_EXEC | AX_SEC_FLAG_READ, 16u32);
    let sec_np = objmodel_get_section_mut(mut_view(m), SectionId { v: s_noprobe.v });
    unsafe { x64_emit_prologue_size(mut_view(*sec_np), 4088u32); }
    let exp_noprobe: [22]u8 = [
        0x55u8, 0x48u8, 0x89u8, 0xE5u8, 0x53u8, 0x56u8, 0x57u8,
        0x41u8, 0x54u8, 0x41u8, 0x55u8, 0x41u8, 0x56u8, 0x41u8, 0x57u8,
        0x48u8, 0x81u8, 0xECu8, 0xF8u8, 0x0Fu8, 0x00u8, 0x00u8,
    ];
    if !sec_matches_slice(unsafe { view(*sec_np) }, view(exp_noprobe)) {
        objmodel_free(mut_view(m));
        return 31;
    }

    // (b) 4104 bytes (> 4096): emits inline 4KB page probe loop matching frame.c:
    //     15-byte push/mov rbp +
    //     movabs rax, 4104 (48 B8 08 10 00 00 00 00 00 00) +
    //     sub rsp, 4096 (48 81 EC 00 10 00 00) +
    //     test [rsp], eax (85 04 24) +
    //     sub rax, 4096 (48 2D 00 10 00 00) +
    //     cmp rax, 4096 (48 3D 00 10 00 00) +
    //     ja -24 (77 E8) +
    //     sub rsp, rax (48 29 C4)
    let s_probe = objmodel_add_section_str(mut_view(m), { ".probe" }, AX_SEC_CODE, AX_SEC_FLAG_EXEC | AX_SEC_FLAG_READ, 16u32);
    let sec_pr = objmodel_get_section_mut(mut_view(m), SectionId { v: s_probe.v });
    unsafe { x64_emit_prologue_size(mut_view(*sec_pr), 4104u32); }
    let exp_probe: [52]u8 = [
        0x55u8, 0x48u8, 0x89u8, 0xE5u8, 0x53u8, 0x56u8, 0x57u8,
        0x41u8, 0x54u8, 0x41u8, 0x55u8, 0x41u8, 0x56u8, 0x41u8, 0x57u8,
        0x48u8, 0xB8u8, 0x08u8, 0x10u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
        0x48u8, 0x81u8, 0xECu8, 0x00u8, 0x10u8, 0x00u8, 0x00u8,
        0x85u8, 0x04u8, 0x24u8,
        0x48u8, 0x2Du8, 0x00u8, 0x10u8, 0x00u8, 0x00u8,
        0x48u8, 0x3Du8, 0x00u8, 0x10u8, 0x00u8, 0x00u8,
        0x77u8, 0xE8u8,
        0x48u8, 0x29u8, 0xC4u8,
    ];
    if !sec_matches_slice(unsafe { view(*sec_pr) }, view(exp_probe)) {
        objmodel_free(mut_view(m));
        return 32;
    }

    objmodel_free(mut_view(m));
    0
}

// 4. End-to-end differential COFF .obj emission using encoder instructions (relocs.obj & ret42.obj)
fn test_encoder_to_coff_differential() -> i32 {
    // 4a. Emit relocs.obj .text using x64_sub_ri, x64_mov_rm_sym, x64_call_sym, x64_add_ri, x64_ret
    let mut m_rel = objmodel_new();
    let text_id = objmodel_add_section_str(mut_view(m_rel), { ".text" }, AX_SEC_CODE, AX_SEC_FLAG_EXEC | AX_SEC_FLAG_READ, 16u32);
    let data_id = objmodel_add_section_str(mut_view(m_rel), { ".data" }, AX_SEC_DATA, AX_SEC_FLAG_READ | AX_SEC_FLAG_WRITE, 8u32);
    let rdata_id = objmodel_add_section_str(mut_view(m_rel), { ".rdata" }, AX_SEC_RODATA, AX_SEC_FLAG_READ, 8u32);

    let msg_bytes: [23]u8 = [
        88u8, 105u8, 110u8, 32u8, 99u8, 104u8, 195u8, 160u8,
        111u8, 32u8, 116u8, 104u8, 225u8, 186u8, 191u8, 32u8,
        103u8, 105u8, 225u8, 187u8, 155u8, 105u8, 0u8,
    ];
    objmodel_section_append_slice(mut_view(m_rel), SectionId { v: rdata_id.v }, view(msg_bytes));
    let msg_sym = objmodel_add_symbol_str(mut_view(m_rel), { "msg" }, SectionId { v: rdata_id.v }, 0u64, 23u64, AX_SYM_LOCAL);

    let data_bytes: [16]u8 = [
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0x0Du8, 0xF0u8, 0xDEu8, 0xC0u8, 0xEFu8, 0xBEu8, 0xADu8, 0xDEu8,
    ];
    objmodel_section_append_slice(mut_view(m_rel), SectionId { v: data_id.v }, view(data_bytes));
    objmodel_section_add_reloc(mut_view(m_rel), SectionId { v: data_id.v }, 0u32, AX_RELOC_X86_64_64, SymbolId { v: msg_sym.v }, 0i64);
    let _ = objmodel_add_symbol_str(mut_view(m_rel), { "my_data_word" }, SectionId { v: data_id.v }, 8u64, 8u64, AX_SYM_GLOBAL);
    let ptr_sym = objmodel_add_symbol_str(mut_view(m_rel), { "ptr_to_msg" }, SectionId { v: data_id.v }, 0u64, 8u64, AX_SYM_LOCAL);
    let check_data_sym = objmodel_add_symbol_str(mut_view(m_rel), { "check_data" }, SectionId.none(), 0u64, 0u64, AX_SYM_EXTERNAL);

    let text_sec = objmodel_get_section_mut(mut_view(m_rel), SectionId { v: text_id.v });
    unsafe {
        x64_sub_ri(mut_view(*text_sec), 8u8, REG_RSP, 40);
        x64_mov_rm_sym(mut_view(*text_sec), 8u8, REG_RCX, SymbolId { v: ptr_sym.v });
        x64_call_sym(mut_view(*text_sec), SymbolId { v: check_data_sym.v });
        x64_add_ri(mut_view(*text_sec), 8u8, REG_RSP, 40);
        x64_ret(mut_view(*text_sec));
    }
    let _ = objmodel_add_symbol_str(mut_view(m_rel), { "main" }, SectionId { v: text_id.v }, 0u64, 21u64, AX_SYM_GLOBAL);

    let mut buf_rel = coff_encode_bytes(view(m_rel));
    let exp_rel = EXPECTED_RELOCS_OBJ;
    if !buf_matches_slice(view(buf_rel), view(exp_rel)) {
        coff_buf_free(mut_view(buf_rel));
        objmodel_free(mut_view(m_rel));
        return 40;
    }
    coff_buf_free(mut_view(buf_rel));
    objmodel_free(mut_view(m_rel));

    // 4b. Emit ret42.ax .text using encoder instructions and verify both .text and full .obj bytes
    let mut m_ret42 = objmodel_new();
    let rdata1 = objmodel_add_section_str(mut_view(m_ret42), { ".rdata" }, AX_SEC_RODATA, AX_SEC_FLAG_READ, 16u32);
    let text1 = objmodel_add_section_str(mut_view(m_ret42), { ".text" }, AX_SEC_CODE, AX_SEC_FLAG_EXEC | AX_SEC_FLAG_READ, 16u32);
    let z1: [1]u8 = [0u8];
    objmodel_section_append_slice(mut_view(m_ret42), SectionId { v: rdata1.v }, view(z1));

    let sec_ret42 = objmodel_get_section_mut(mut_view(m_ret42), SectionId { v: text1.v });
    unsafe {
        // Function 1: prelude_loaded() -> bool (returns true = 1u8)
        x64_emit_prologue_size(mut_view(*sec_ret42), 56u32);
        x64_mov_ri(mut_view(*sec_ret42), 8u8, REG_RAX, 1);
        x64_mov_mr(mut_view(*sec_ret42), 8u8, x64_mem_frame_rbp(-72), REG_RAX);
        x64_lea(mut_view(*sec_ret42), 8u8, REG_RAX, x64_mem_frame_rbp(-64));
        x64_mov_mr(mut_view(*sec_ret42), 8u8, x64_mem_frame_rbp(-80), REG_RAX);
        x64_mov_rm(mut_view(*sec_ret42), 8u8, REG_RAX, x64_mem_frame_rbp(-80));
        x64_mov_rm(mut_view(*sec_ret42), 8u8, REG_RCX, x64_mem_frame_rbp(-72));
        x64_mov_mr(mut_view(*sec_ret42), 1u8, x64_mem_base(REG_RAX), REG_RCX);
        x64_mov_rm(mut_view(*sec_ret42), 8u8, REG_RAX, x64_mem_frame_rbp(-64));
        x64_emit_epilogue_size(mut_view(*sec_ret42), 56u32);
        x64_ret(mut_view(*sec_ret42));

        // 16-byte function alignment padding (8 NOPs from offset 72 to 80)
        x64_align_code(mut_view(*sec_ret42), 16);

        // Function 2: main() -> i32 (returns 42)
        x64_emit_prologue_size(mut_view(*sec_ret42), 56u32);
        x64_mov_ri(mut_view(*sec_ret42), 8u8, REG_RAX, 42);
        x64_mov_mr(mut_view(*sec_ret42), 8u8, x64_mem_frame_rbp(-72), REG_RAX);
        x64_lea(mut_view(*sec_ret42), 8u8, REG_RAX, x64_mem_frame_rbp(-64));
        x64_mov_mr(mut_view(*sec_ret42), 8u8, x64_mem_frame_rbp(-80), REG_RAX);
        x64_mov_rm(mut_view(*sec_ret42), 8u8, REG_RAX, x64_mem_frame_rbp(-80));
        x64_mov_rm(mut_view(*sec_ret42), 8u8, REG_RCX, x64_mem_frame_rbp(-72));
        x64_mov_mr(mut_view(*sec_ret42), 4u8, x64_mem_base(REG_RAX), REG_RCX);
        x64_mov_rm(mut_view(*sec_ret42), 8u8, REG_RAX, x64_mem_frame_rbp(-64));
        x64_emit_epilogue_size(mut_view(*sec_ret42), 56u32);
        x64_ret(mut_view(*sec_ret42));
    }

    let exp_ret42_text = RET42_TEXT_BYTES;
    if !sec_matches_slice(unsafe { view(*sec_ret42) }, view(exp_ret42_text)) {
        objmodel_free(mut_view(m_ret42));
        return 41;
    }

    let _ = objmodel_add_symbol_str(mut_view(m_ret42), { "prelude_loaded" }, SectionId { v: text1.v }, 0u64, 72u64, AX_SYM_GLOBAL);
    let _ = objmodel_add_symbol_str(mut_view(m_ret42), { "main" }, SectionId { v: text1.v }, 80u64, 72u64, AX_SYM_GLOBAL);
    let _ = objmodel_add_symbol_str(mut_view(m_ret42), { "ax_main" }, SectionId { v: text1.v }, 80u64, 72u64, AX_SYM_GLOBAL);

    let mut buf_ret42 = coff_encode_bytes(view(m_ret42));
    let exp_ret42_obj = EXPECTED_RET42_OBJ;
    if !buf_matches_slice(view(buf_ret42), view(exp_ret42_obj)) {
        coff_buf_free(mut_view(buf_ret42));
        objmodel_free(mut_view(m_ret42));
        return 42;
    }
    coff_buf_free(mut_view(buf_ret42));
    objmodel_free(mut_view(m_ret42));
    0
}

pub fn main() -> i32 {
    let rc1 = test_relocation_emitters();
    if rc1 != 0 { return rc1; }

    let rc2 = test_branch_fixups_and_patching();
    if rc2 != 0 { return rc2; }

    let rc3 = test_frame_prologue_epilogue_and_stack_probe();
    if rc3 != 0 { return rc3; }

    let rc4 = test_encoder_to_coff_differential();
    if rc4 != 0 { return rc4; }

    print("OK x64 Encoder Relocations, Branch Fixups, Frames & Differential COFF\n");
    0
}
