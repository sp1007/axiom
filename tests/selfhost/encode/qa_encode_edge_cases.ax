    pub fn is_some(self: view<NodeId>) -> bool { self.v != 0 }
    pub fn from_index(index: usize) -> NodeId { NodeId { v: (index + 1) as u32 } }
    pub fn index(self: view<NodeId>) -> usize { (self.v - 1) as usize }
    pub fn eq(self: view<NodeId>, other: view<NodeId>) -> bool { self.v == other.v }
    pub fn to_raw(self: view<NodeId>) -> u32 { self.v }
