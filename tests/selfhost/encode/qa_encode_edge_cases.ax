fn check_sec_bytes(sec: view<Section>, exp: view<[u8]>) -> bool {
    let n = len(exp);
    if section_bytes_len(sec) != n {
        return false;
    }
    let mut i: usize = 0;
    while i < n {
        if section_byte_at(sec, i) != exp[i] {
            return false;
        }
        i = i + 1;
    }
    true
}

fn check_slice(sec: mut_view<Section>, exp: view<[u8]>) -> bool {
    let ok = check_sec_bytes(view(*sec), exp);
    sec.bytes_len = 0;
    ok
}

// 1. Test disp8 / disp32 exact boundary transitions (-129, -128, 0, 127, 128) and RBP/R13/RSP/R12 + SIB edge cases
fn test_disp_and_sib_boundaries(sec: mut_view<Section>) -> i32 {
    sec.bytes_len = 0;

    // disp = -128 -> mod=01 (disp8 = 0x80)
    x64_mov_rm(mut_view(*sec), 8u8, REG_RAX, x64_mem_base_disp(REG_RCX, -128));
    let e1: [4]u8 = [0x48u8, 0x8Bu8, 0x41u8, 0x80u8];
    if !check_slice(mut_view(*sec), view(e1)) { return 101; }

    // disp = -129 -> mod=10 (disp32 = 0xFFFFFF7F -> 7F FF FF FF)
    x64_mov_rm(mut_view(*sec), 8u8, REG_RAX, x64_mem_base_disp(REG_RCX, -129));
    let e2: [7]u8 = [0x48u8, 0x8Bu8, 0x81u8, 0x7Fu8, 0xFFu8, 0xFFu8, 0xFFu8];
    if !check_slice(mut_view(*sec), view(e2)) { return 102; }

    // disp = 127 -> mod=01 (disp8 = 0x7F)
    x64_mov_rm(mut_view(*sec), 8u8, REG_RAX, x64_mem_base_disp(REG_RCX, 127));
    let e3: [4]u8 = [0x48u8, 0x8Bu8, 0x41u8, 0x7Fu8];
    if !check_slice(mut_view(*sec), view(e3)) { return 103; }

    // disp = 128 -> mod=10 (disp32 = 0x00000080 -> 80 00 00 00)
    x64_mov_rm(mut_view(*sec), 8u8, REG_RAX, x64_mem_base_disp(REG_RCX, 128));
    let e4: [7]u8 = [0x48u8, 0x8Bu8, 0x81u8, 0x80u8, 0x00u8, 0x00u8, 0x00u8];
    if !check_slice(mut_view(*sec), view(e4)) { return 104; }

    // RBP (base_low3 == 5) with SIB index and disp == 0 MUST force mod=01 + disp8=0x00
    x64_mov_rm(mut_view(*sec), 8u8, REG_RAX, x64_mem_index(REG_RBP, REG_RCX, 2u8));
    let e5: [5]u8 = [0x48u8, 0x8Bu8, 0x44u8, 0x4Du8, 0x00u8];
    if !check_slice(mut_view(*sec), view(e5)) { return 105; }

    // R13 (base_low3 == 5, extended) with extended SIB index R14, scale 8, disp == 0 -> REX.WXB (0x4B), mod=01, SIB=0xF5, disp8=0x00
    x64_mov_rm(mut_view(*sec), 8u8, REG_RAX, x64_mem_index(REG_R13, REG_R14, 8u8));
    let e6: [5]u8 = [0x4Bu8, 0x8Bu8, 0x44u8, 0xF5u8, 0x00u8];
    if !check_slice(mut_view(*sec), view(e6)) { return 106; }

    // Negative RIP-relative displacement (-4 -> FC FF FF FF)
    x64_mov_rm(mut_view(*sec), 8u8, REG_R15, x64_mem_rip(-4));
    let e7: [7]u8 = [0x4Cu8, 0x8Bu8, 0x3Du8, 0xFCu8, 0xFFu8, 0xFFu8, 0xFFu8];
    if !check_slice(mut_view(*sec), view(e7)) { return 107; }

    0
}

// 2. Test RAX accumulator short-form vs R8 (low3 == 0) non-accumulator encoding & imm8/imm32 boundaries
fn test_alu_and_test_r8_vs_rax_boundaries(sec: mut_view<Section>) -> i32 {
    sec.bytes_len = 0;

    // RAX vs R8 with imm8 (5):
    //   add rax, 5 -> 48 05 05 00 00 00 (RAX uses 0x05 + imm32 in Stage-0 encoder)
    //   add r8,  5 -> 49 83 C0 05       (R8 must NOT match dst == REG_RAX; uses 0x83 /0 imm8!)
    x64_add_ri(mut_view(*sec), 8u8, REG_RAX, 5);
    let e1: [6]u8 = [0x48u8, 0x05u8, 0x05u8, 0x00u8, 0x00u8, 0x00u8];
    if !check_slice(mut_view(*sec), view(e1)) { return 201; }

    x64_add_ri(mut_view(*sec), 8u8, REG_R8, 5);
    let e2: [4]u8 = [0x49u8, 0x83u8, 0xC0u8, 0x05u8];
    if !check_slice(mut_view(*sec), view(e2)) { return 202; }

    // R8 with imm = -128 (fits in imm8 -> 0x83), imm = -129 (requires imm32 -> 0x81), imm = 127 (0x83), imm = 128 (0x81)
    x64_sub_ri(mut_view(*sec), 8u8, REG_R8, -128);
    let e3: [4]u8 = [0x49u8, 0x83u8, 0xE8u8, 0x80u8];
    if !check_slice(mut_view(*sec), view(e3)) { return 203; }

    x64_sub_ri(mut_view(*sec), 8u8, REG_R8, -129);
    let e4: [7]u8 = [0x49u8, 0x81u8, 0xE8u8, 0x7Fu8, 0xFFu8, 0xFFu8, 0xFFu8];
    if !check_slice(mut_view(*sec), view(e4)) { return 204; }

    x64_cmp_ri(mut_view(*sec), 8u8, REG_R8, 127);
    let e5: [4]u8 = [0x49u8, 0x83u8, 0xF8u8, 0x7Fu8];
    if !check_slice(mut_view(*sec), view(e5)) { return 205; }

    x64_cmp_ri(mut_view(*sec), 8u8, REG_R8, 128);
    let e6: [7]u8 = [0x49u8, 0x81u8, 0xF8u8, 0x80u8, 0x00u8, 0x00u8, 0x00u8];
    if !check_slice(mut_view(*sec), view(e6)) { return 206; }

    // 8-bit R8B vs AL for ALU and TEST:
    //   or al,  0x12 -> 0C 12
    //   or r8b, 0x12 -> 41 80 C8 12
    x64_or_ri(mut_view(*sec), 1u8, REG_RAX, 0x12);
    let e7: [2]u8 = [0x0Cu8, 0x12u8];
    if !check_slice(mut_view(*sec), view(e7)) { return 207; }

    x64_or_ri(mut_view(*sec), 1u8, REG_R8, 0x12);
    let e8: [4]u8 = [0x41u8, 0x80u8, 0xC8u8, 0x12u8];
    if !check_slice(mut_view(*sec), view(e8)) { return 208; }

    // test r8b, 1 -> 41 F6 C0 01 (NOT A8 01)
    x64_test_ri(mut_view(*sec), 1u8, REG_R8, 1);
    let e9: [4]u8 = [0x41u8, 0xF6u8, 0xC0u8, 0x01u8];
    if !check_slice(mut_view(*sec), view(e9)) { return 209; }

    // test r8, 1 -> 49 F7 C0 01 00 00 00 (NOT 49 A9 ...)
    x64_test_ri(mut_view(*sec), 8u8, REG_R8, 1);
    let e10: [7]u8 = [0x49u8, 0xF7u8, 0xC0u8, 0x01u8, 0x00u8, 0x00u8, 0x00u8];
    if !check_slice(mut_view(*sec), view(e10)) { return 210; }

    // 16-bit ALU with RAX vs RCX:
    //   xor ax, 0x1234 -> 66 35 34 12
    //   and cx, 0x1234 -> 66 81 E1 34 12
    x64_xor_ri(mut_view(*sec), 2u8, REG_RAX, 0x1234);
    let e11: [4]u8 = [0x66u8, 0x35u8, 0x34u8, 0x12u8];
    if !check_slice(mut_view(*sec), view(e11)) { return 211; }

    x64_and_ri(mut_view(*sec), 2u8, REG_RCX, 0x1234);
    let e12: [5]u8 = [0x66u8, 0x81u8, 0xE1u8, 0x34u8, 0x12u8];
    if !check_slice(mut_view(*sec), view(e12)) { return 212; }

    0
}

// 3. Test 8/16-bit widths, extended registers, push_m/pop_m REX.XB, and C's AX_REG_NONE (-1) compatibility
fn test_width_and_reg_predicates(sec: mut_view<Section>) -> i32 {
    sec.bytes_len = 0;

    // Verify both -1 (C AX_REG_NONE) and 255 (Axiom REG_NONE) are treated as none/invalid and not extended
    if !x64_reg_is_none(-1) || !x64_reg_is_none(REG_NONE) || !x64_reg_is_none(16) {
        return 301;
    }
    if x64_reg_is_valid(-1) || x64_reg_is_extended(-1) || x64_reg_needs_byte_rex(-1) || x64_reg_low3(-1) != 0u8 {
        return 302;
    }

    // 8-bit unary & shifts on SPL/BPL/SIL/DIL and R8B..R15B
    x64_neg_r(mut_view(*sec), 1u8, REG_RSI);
    let e1: [3]u8 = [0x40u8, 0xF6u8, 0xDEu8];
    if !check_slice(mut_view(*sec), view(e1)) { return 303; }

    x64_not_r(mut_view(*sec), 2u8, REG_R15);
    let e2: [4]u8 = [0x66u8, 0x41u8, 0xF7u8, 0xD7u8];
    if !check_slice(mut_view(*sec), view(e2)) { return 304; }

    x64_mul_r(mut_view(*sec), 1u8, REG_R9);
    let e3: [3]u8 = [0x41u8, 0xF6u8, 0xE1u8];
    if !check_slice(mut_view(*sec), view(e3)) { return 305; }

    x64_idiv_r(mut_view(*sec), 2u8, REG_RCX);
    let e4: [3]u8 = [0x66u8, 0xF7u8, 0xF9u8];
    if !check_slice(mut_view(*sec), view(e4)) { return 306; }

    x64_div_r(mut_view(*sec), 1u8, REG_RDI);
    let e5: [3]u8 = [0x40u8, 0xF6u8, 0xF7u8];
    if !check_slice(mut_view(*sec), view(e5)) { return 307; }

    x64_shl_ri(mut_view(*sec), 1u8, REG_RSP, 1u8);
    let e6: [3]u8 = [0x40u8, 0xD0u8, 0xE4u8];
    if !check_slice(mut_view(*sec), view(e6)) { return 308; }

    x64_shr_ri(mut_view(*sec), 2u8, REG_R10, 4u8);
    let e7: [5]u8 = [0x66u8, 0x41u8, 0xC1u8, 0xEAu8, 0x04u8];
    if !check_slice(mut_view(*sec), view(e7)) { return 309; }

    x64_sar_ri(mut_view(*sec), 1u8, REG_R11, 1u8);
    let e8: [3]u8 = [0x41u8, 0xD0u8, 0xFBu8];
    if !check_slice(mut_view(*sec), view(e8)) { return 310; }

    // 16-bit movzx / movsx from 8-bit register
    x64_movzx_rr(mut_view(*sec), 2u8, 1u8, REG_RAX, REG_RCX);
    let e9: [4]u8 = [0x66u8, 0x0Fu8, 0xB6u8, 0xC1u8];
    if !check_slice(mut_view(*sec), view(e9)) { return 311; }

    x64_movsx_rr(mut_view(*sec), 2u8, 1u8, REG_R8, REG_R9);
    let e10: [5]u8 = [0x66u8, 0x45u8, 0x0Fu8, 0xBEu8, 0xC1u8];
    if !check_slice(mut_view(*sec), view(e10)) { return 312; }

    // push_m and pop_m with both extended base (R12) and extended index (R13) -> REX.XB (0x43)
    x64_push_m(mut_view(*sec), x64_mem_index_disp(REG_R12, REG_R13, 8u8, -16));
    let e11: [5]u8 = [0x43u8, 0xFFu8, 0x74u8, 0xECu8, 0xF0u8];
    if !check_slice(mut_view(*sec), view(e11)) { return 313; }

    x64_pop_m(mut_view(*sec), x64_mem_index_disp(REG_R12, REG_R13, 8u8, -16));
    let e12: [5]u8 = [0x43u8, 0x8Fu8, 0x44u8, 0xECu8, 0xF0u8];
    if !check_slice(mut_view(*sec), view(e12)) { return 314; }

    0
}

// 4. Test frame prologue/epilogue exact thresholds: frame_size = 0, 127, 128, 4096, 4097
fn test_frame_exact_thresholds(sec: mut_view<Section>) -> i32 {
    // frame_size == 0 -> 15 bytes prologue (no sub rsp), 12 bytes epilogue (no add rsp)
    sec.bytes_len = 0;
    x64_emit_prologue_size(mut_view(*sec), 0u32);
    let exp_pro0: [15]u8 = [
        0x55u8, 0x48u8, 0x89u8, 0xE5u8, 0x53u8, 0x56u8, 0x57u8,
        0x41u8, 0x54u8, 0x41u8, 0x55u8, 0x41u8, 0x56u8, 0x41u8, 0x57u8,
    ];
    if !check_slice(mut_view(*sec), view(exp_pro0)) { return 401; }

    x64_emit_epilogue_size(mut_view(*sec), 0u32);
    let exp_epi0: [12]u8 = [
        0x41u8, 0x5Fu8, 0x41u8, 0x5Eu8, 0x41u8, 0x5Du8, 0x41u8, 0x5Cu8,
        0x5Fu8, 0x5Eu8, 0x5Bu8, 0x5Du8,
    ];
    if !check_slice(mut_view(*sec), view(exp_epi0)) { return 402; }

    // frame_size == 127 -> 15 + 4 (sub rsp, 127 uses 0x83) = 19 bytes
    x64_emit_prologue_size(mut_view(*sec), 127u32);
    if section_bytes_len(view(*sec)) != 19 || section_byte_at(view(*sec), 16) != 0x83u8 || section_byte_at(view(*sec), 18) != 0x7Fu8 {
        return 403;
    }
    sec.bytes_len = 0;

    // frame_size == 128 -> 15 + 7 (sub rsp, 128 uses 0x81) = 22 bytes
    x64_emit_prologue_size(mut_view(*sec), 128u32);
    if section_bytes_len(view(*sec)) != 22 || section_byte_at(view(*sec), 16) != 0x81u8 || section_byte_at(view(*sec), 18) != 0x80u8 {
        return 404;
    }
    sec.bytes_len = 0;

    // frame_size == 4096 -> exact upper bound before probe loop: 15 + 7 = 22 bytes (no probe loop)
    x64_emit_prologue_size(mut_view(*sec), 4096u32);
    if section_bytes_len(view(*sec)) != 22 || section_byte_at(view(*sec), 16) != 0x81u8 || section_byte_at(view(*sec), 19) != 0x10u8 {
        return 405;
    }
    sec.bytes_len = 0;

    // frame_size == 4097 -> triggers 52-byte inline page probe loop
    x64_emit_prologue_size(mut_view(*sec), 4097u32);
    if section_bytes_len(view(*sec)) != 52 || section_byte_at(view(*sec), 17) != 0x01u8 || section_byte_at(view(*sec), 18) != 0x10u8 {
        return 406;
    }
    sec.bytes_len = 0;

    0
}

// 5. Test negative symbol displacement addends, rodata 8-byte alignment, and out-of-bounds fixup safety
fn test_seam_reloc_and_fixup_safety() -> i32 {
    let mut m = objmodel_new();
    let text_id = objmodel_add_section_str(mut_view(m), { ".text" }, AX_SEC_CODE, AX_SEC_FLAG_EXEC | AX_SEC_FLAG_READ, 16u32);
    let rdata_id = objmodel_add_section_str(mut_view(m), { ".rdata" }, AX_SEC_RODATA, AX_SEC_FLAG_READ, 8u32);
    let sym = objmodel_add_symbol_str(mut_view(m), { "ext_arr" }, SectionId.none(), 0u64, 0u64, AX_SYM_EXTERNAL);

    let sec = objmodel_get_section_mut(mut_view(m), SectionId { v: text_id.v });
    unsafe {
        // Negative disp = -8 -> addend must be -8 - 4 = -12
        x64_lea_sym_disp(mut_view(*sec), REG_RAX, SymbolId { v: sym.v }, -8i64);
        x64_mov_rm_sym_disp(mut_view(*sec), 8u8, REG_RCX, SymbolId { v: sym.v }, -16i64);
        x64_mov_mr_sym_disp(mut_view(*sec), 4u8, SymbolId { v: sym.v }, -4i64, REG_RDX);
    }
    let r0 = section_reloc_at(unsafe { view(*sec) }, 0);
    let r1 = section_reloc_at(unsafe { view(*sec) }, 1);
    let r2 = section_reloc_at(unsafe { view(*sec) }, 2);
    if (unsafe { (*r0).addend }) != -12i64 || (unsafe { (*r1).addend }) != -20i64 || (unsafe { (*r2).addend }) != -8i64 {
        objmodel_free(mut_view(m));
        return 501;
    }

    // Out-of-bounds patch_rel32 and out-of-bounds target_bb in patch_branch_fixups must be safe no-ops
    unsafe {
        (*sec).bytes_len = 0;
        let fx_valid = x64_emit_jmp_placeholder(mut_view(*sec), 0u32);
        x64_nop(mut_view(*sec));
        let fx_oob_bb = X64BranchFixup { fixup_offset: fx_valid.fixup_offset, target_bb: 99u32 };
        let bb_offs: [1]u32 = [6u32];
        let fixups: [2]X64BranchFixup = [fx_valid, fx_oob_bb];
        x64_patch_branch_fixups(mut_view(*sec), view(fixups), 2, view(bb_offs));
        // fx_valid patched rel32 to 6 - 5 = 1; fx_oob_bb was ignored and did not overwrite it
        if coff_read_i32_le((*sec).bytes as *const u8, 1) != 1i32 {
            objmodel_free(mut_view(m));
            return 502;
        }
        // Out-of-bounds fixup_offset (beyond bytes_len) must not write out of bounds
        x64_patch_rel32(mut_view(*sec), 100u32, 0u32);
        if coff_read_i32_le((*sec).bytes as *const u8, 1) != 1i32 {
            objmodel_free(mut_view(m));
            return 503;
        }
    }

    // Test x64_emit_rodata_slice with align8 = true across 1-byte, 7-byte, and 8-byte strings
    let rdata_sec = objmodel_get_section_mut(mut_view(m), SectionId { v: rdata_id.v });
    let s1: [1]u8 = [120u8]; // 1 char + NUL = 2 bytes -> padded to 8 bytes
    let s7: [7]u8 = [97u8, 98u8, 99u8, 100u8, 101u8, 102u8, 103u8]; // 7 chars + NUL = 8 bytes (no extra padding)
    let s8: [8]u8 = [49u8, 50u8, 51u8, 52u8, 53u8, 54u8, 55u8, 56u8]; // 8 chars + NUL = 9 bytes -> padded to 16 bytes
    let sym1 = unsafe { x64_emit_rodata_slice(mut_view(*rdata_sec), mut_view(m), SectionId { v: rdata_id.v }, { ".Ls1" }, view(s1), true, AX_SYM_LOCAL) };
    if (unsafe { (*rdata_sec).bytes_len }) != 8 {
        objmodel_free(mut_view(m));
        return 504;
    }
    let sym7 = unsafe { x64_emit_rodata_slice(mut_view(*rdata_sec), mut_view(m), SectionId { v: rdata_id.v }, { ".Ls7" }, view(s7), true, AX_SYM_LOCAL) };
    if (unsafe { (*rdata_sec).bytes_len }) != 16 {
        objmodel_free(mut_view(m));
        return 505;
    }
    let sym8 = unsafe { x64_emit_rodata_slice(mut_view(*rdata_sec), mut_view(m), SectionId { v: rdata_id.v }, { ".Ls8" }, view(s8), true, AX_SYM_GLOBAL) };
    if (unsafe { (*rdata_sec).bytes_len }) != 32 {
        objmodel_free(mut_view(m));
        return 506;
    }
    let p1 = objmodel_get_symbol(view(m), SymbolId { v: sym1.v });
    let p7 = objmodel_get_symbol(view(m), SymbolId { v: sym7.v });
    let p8 = objmodel_get_symbol(view(m), SymbolId { v: sym8.v });
    if (unsafe { (*p1).value }) != 0u64 || (unsafe { (*p1).size }) != 1u64 ||
       (unsafe { (*p7).value }) != 8u64 || (unsafe { (*p7).size }) != 7u64 ||
       (unsafe { (*p8).value }) != 16u64 || (unsafe { (*p8).size }) != 8u64 {
        objmodel_free(mut_view(m));
        return 507;
    }

    objmodel_free(mut_view(m));
    0
}

pub fn main() -> i32 {
    let mut model = objmodel_new();
    let text_id = objmodel_add_section_str(
        mut_view(model),
        { ".text" },
        AX_SEC_CODE,
        AX_SEC_FLAG_EXEC | AX_SEC_FLAG_READ,
        16u32
    );
    let text_sec = objmodel_get_section_mut(mut_view(model), text_id);
    if (text_sec as usize) == 0 {
        return 1000;
    }

    let rc1 = unsafe { test_disp_and_sib_boundaries(mut_view(*text_sec)) };
    if rc1 != 0 {
        objmodel_free(mut_view(model));
        return rc1;
    }

    let rc2 = unsafe { test_alu_and_test_r8_vs_rax_boundaries(mut_view(*text_sec)) };
    if rc2 != 0 {
        objmodel_free(mut_view(model));
        return rc2;
    }

    let rc3 = unsafe { test_width_and_reg_predicates(mut_view(*text_sec)) };
    if rc3 != 0 {
        objmodel_free(mut_view(model));
        return rc3;
    }

    let rc4 = unsafe { test_frame_exact_thresholds(mut_view(*text_sec)) };
    if rc4 != 0 {
        objmodel_free(mut_view(model));
        return rc4;
    }

    objmodel_free(mut_view(model));

    let rc5 = test_seam_reloc_and_fixup_safety();
    if rc5 != 0 {
        return rc5;
    }

    print("OK x64 Encoder Boundary and Seam Edge Cases\n");
    0
}
