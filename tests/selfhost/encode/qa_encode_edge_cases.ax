pub const AX_X64_MI_ADD: u32 = 1u32;
pub const AX_X64_MI_SUB: u32 = 2u32;
pub const AX_X64_MI_IMUL: u32 = 3u32;
pub const AX_X64_MI_MUL: u32 = 4u32;
pub const AX_X64_MI_IDIV: u32 = 5u32;
pub const AX_X64_MI_AND: u32 = 6u32;
pub const AX_X64_MI_OR: u32 = 7u32;
