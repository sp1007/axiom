    let exp: [10]u8 = [b0, b1, b2, b3, b4, b5, b6, b7, b8, b9];
    let ok = check_sec_bytes(view(*sec), view(exp));
    sec.bytes_len = 0;
    ok
}

// Exact port of all 135 GNU `as` reference tests from `tests/encode/encode_tests.inc`
fn test_gnu_as_reference_fixtures(sec: mut_view<Section>) -> i32 {
    sec.bytes_len = 0;

    // 0..31: 8-bit mov_rr and add_rr across %al, %spl, %bpl, %r12b
    ax_x64_mov_rr(mut_view(*sec), 1u8, AX_REG_RAX, AX_REG_RAX);
    if !check2(mut_view(*sec), 0x88u8, 0xc0u8) { return 1; }
    ax_x64_add_rr(mut_view(*sec), 1u8, AX_REG_RAX, AX_REG_RAX);
    if !check2(mut_view(*sec), 0x00u8, 0xc0u8) { return 2; }
    ax_x64_mov_rr(mut_view(*sec), 1u8, AX_REG_RAX, AX_REG_RSP);
    if !check3(mut_view(*sec), 0x40u8, 0x88u8, 0xe0u8) { return 3; }
    ax_x64_add_rr(mut_view(*sec), 1u8, AX_REG_RAX, AX_REG_RSP);
    if !check3(mut_view(*sec), 0x40u8, 0x00u8, 0xe0u8) { return 4; }
    ax_x64_mov_rr(mut_view(*sec), 1u8, AX_REG_RAX, AX_REG_RBP);
    if !check3(mut_view(*sec), 0x40u8, 0x88u8, 0xe8u8) { return 5; }
    ax_x64_add_rr(mut_view(*sec), 1u8, AX_REG_RAX, AX_REG_RBP);
    if !check3(mut_view(*sec), 0x40u8, 0x00u8, 0xe8u8) { return 6; }
    ax_x64_mov_rr(mut_view(*sec), 1u8, AX_REG_RAX, AX_REG_R12);
    if !check3(mut_view(*sec), 0x44u8, 0x88u8, 0xe0u8) { return 7; }
    ax_x64_add_rr(mut_view(*sec), 1u8, AX_REG_RAX, AX_REG_R12);
    if !check3(mut_view(*sec), 0x44u8, 0x00u8, 0xe0u8) { return 8; }

    ax_x64_mov_rr(mut_view(*sec), 1u8, AX_REG_RSP, AX_REG_RAX);
    if !check3(mut_view(*sec), 0x40u8, 0x88u8, 0xc4u8) { return 9; }
    ax_x64_add_rr(mut_view(*sec), 1u8, AX_REG_RSP, AX_REG_RAX);
    if !check3(mut_view(*sec), 0x40u8, 0x00u8, 0xc4u8) { return 10; }
    ax_x64_mov_rr(mut_view(*sec), 1u8, AX_REG_RSP, AX_REG_RSP);
    if !check3(mut_view(*sec), 0x40u8, 0x88u8, 0xe4u8) { return 11; }
    ax_x64_add_rr(mut_view(*sec), 1u8, AX_REG_RSP, AX_REG_RSP);
    if !check3(mut_view(*sec), 0x40u8, 0x00u8, 0xe4u8) { return 12; }
    ax_x64_mov_rr(mut_view(*sec), 1u8, AX_REG_RSP, AX_REG_RBP);
    if !check3(mut_view(*sec), 0x40u8, 0x88u8, 0xecu8) { return 13; }
    ax_x64_add_rr(mut_view(*sec), 1u8, AX_REG_RSP, AX_REG_RBP);
    if !check3(mut_view(*sec), 0x40u8, 0x00u8, 0xecu8) { return 14; }
    ax_x64_mov_rr(mut_view(*sec), 1u8, AX_REG_RSP, AX_REG_R12);
    if !check3(mut_view(*sec), 0x44u8, 0x88u8, 0xe4u8) { return 15; }
    ax_x64_add_rr(mut_view(*sec), 1u8, AX_REG_RSP, AX_REG_R12);
    if !check3(mut_view(*sec), 0x44u8, 0x00u8, 0xe4u8) { return 16; }

    ax_x64_mov_rr(mut_view(*sec), 1u8, AX_REG_RBP, AX_REG_RAX);
    if !check3(mut_view(*sec), 0x40u8, 0x88u8, 0xc5u8) { return 17; }
    ax_x64_add_rr(mut_view(*sec), 1u8, AX_REG_RBP, AX_REG_RAX);
    if !check3(mut_view(*sec), 0x40u8, 0x00u8, 0xc5u8) { return 18; }
    ax_x64_mov_rr(mut_view(*sec), 1u8, AX_REG_RBP, AX_REG_RSP);
    if !check3(mut_view(*sec), 0x40u8, 0x88u8, 0xe5u8) { return 19; }
    ax_x64_add_rr(mut_view(*sec), 1u8, AX_REG_RBP, AX_REG_RSP);
    if !check3(mut_view(*sec), 0x40u8, 0x00u8, 0xe5u8) { return 20; }
    ax_x64_mov_rr(mut_view(*sec), 1u8, AX_REG_RBP, AX_REG_RBP);
    if !check3(mut_view(*sec), 0x40u8, 0x88u8, 0xedu8) { return 21; }
    ax_x64_add_rr(mut_view(*sec), 1u8, AX_REG_RBP, AX_REG_RBP);
    if !check3(mut_view(*sec), 0x40u8, 0x00u8, 0xedu8) { return 22; }
    ax_x64_mov_rr(mut_view(*sec), 1u8, AX_REG_RBP, AX_REG_R12);
    if !check3(mut_view(*sec), 0x44u8, 0x88u8, 0xe5u8) { return 23; }
    ax_x64_add_rr(mut_view(*sec), 1u8, AX_REG_RBP, AX_REG_R12);
    if !check3(mut_view(*sec), 0x44u8, 0x00u8, 0xe5u8) { return 24; }

    ax_x64_mov_rr(mut_view(*sec), 1u8, AX_REG_R12, AX_REG_RAX);
    if !check3(mut_view(*sec), 0x41u8, 0x88u8, 0xc4u8) { return 25; }
    ax_x64_add_rr(mut_view(*sec), 1u8, AX_REG_R12, AX_REG_RAX);
    if !check3(mut_view(*sec), 0x41u8, 0x00u8, 0xc4u8) { return 26; }
    ax_x64_mov_rr(mut_view(*sec), 1u8, AX_REG_R12, AX_REG_RSP);
    if !check3(mut_view(*sec), 0x41u8, 0x88u8, 0xe4u8) { return 27; }
    ax_x64_add_rr(mut_view(*sec), 1u8, AX_REG_R12, AX_REG_RSP);
    if !check3(mut_view(*sec), 0x41u8, 0x00u8, 0xe4u8) { return 28; }
    ax_x64_mov_rr(mut_view(*sec), 1u8, AX_REG_R12, AX_REG_RBP);
    if !check3(mut_view(*sec), 0x41u8, 0x88u8, 0xecu8) { return 29; }
    ax_x64_add_rr(mut_view(*sec), 1u8, AX_REG_R12, AX_REG_RBP);
    if !check3(mut_view(*sec), 0x41u8, 0x00u8, 0xecu8) { return 30; }
    ax_x64_mov_rr(mut_view(*sec), 1u8, AX_REG_R12, AX_REG_R12);
    if !check3(mut_view(*sec), 0x45u8, 0x88u8, 0xe4u8) { return 31; }
    ax_x64_add_rr(mut_view(*sec), 1u8, AX_REG_R12, AX_REG_R12);
    if !check3(mut_view(*sec), 0x45u8, 0x00u8, 0xe4u8) { return 32; }

    // 32..63: 32-bit mov_rr and add_rr across %eax, %esp, %ebp, %r12d
    ax_x64_mov_rr(mut_view(*sec), 4u8, AX_REG_RAX, AX_REG_RAX);
    if !check2(mut_view(*sec), 0x89u8, 0xc0u8) { return 33; }
    ax_x64_add_rr(mut_view(*sec), 4u8, AX_REG_RAX, AX_REG_RAX);
    if !check2(mut_view(*sec), 0x01u8, 0xc0u8) { return 34; }
    ax_x64_mov_rr(mut_view(*sec), 4u8, AX_REG_RAX, AX_REG_RSP);
    if !check2(mut_view(*sec), 0x89u8, 0xe0u8) { return 35; }
    ax_x64_add_rr(mut_view(*sec), 4u8, AX_REG_RAX, AX_REG_RSP);
    if !check2(mut_view(*sec), 0x01u8, 0xe0u8) { return 36; }
    ax_x64_mov_rr(mut_view(*sec), 4u8, AX_REG_RAX, AX_REG_RBP);
    if !check2(mut_view(*sec), 0x89u8, 0xe8u8) { return 37; }
    ax_x64_add_rr(mut_view(*sec), 4u8, AX_REG_RAX, AX_REG_RBP);
    if !check2(mut_view(*sec), 0x01u8, 0xe8u8) { return 38; }
    ax_x64_mov_rr(mut_view(*sec), 4u8, AX_REG_RAX, AX_REG_R12);
    if !check3(mut_view(*sec), 0x44u8, 0x89u8, 0xe0u8) { return 39; }
    ax_x64_add_rr(mut_view(*sec), 4u8, AX_REG_RAX, AX_REG_R12);
    if !check3(mut_view(*sec), 0x44u8, 0x01u8, 0xe0u8) { return 40; }

    ax_x64_mov_rr(mut_view(*sec), 4u8, AX_REG_RSP, AX_REG_RAX);
    if !check2(mut_view(*sec), 0x89u8, 0xc4u8) { return 41; }
    ax_x64_add_rr(mut_view(*sec), 4u8, AX_REG_RSP, AX_REG_RAX);
    if !check2(mut_view(*sec), 0x01u8, 0xc4u8) { return 42; }
    ax_x64_mov_rr(mut_view(*sec), 4u8, AX_REG_RSP, AX_REG_RSP);
    if !check2(mut_view(*sec), 0x89u8, 0xe4u8) { return 43; }
    ax_x64_add_rr(mut_view(*sec), 4u8, AX_REG_RSP, AX_REG_RSP);
    if !check2(mut_view(*sec), 0x01u8, 0xe4u8) { return 44; }
    ax_x64_mov_rr(mut_view(*sec), 4u8, AX_REG_RSP, AX_REG_RBP);
    if !check2(mut_view(*sec), 0x89u8, 0xecu8) { return 45; }
    ax_x64_add_rr(mut_view(*sec), 4u8, AX_REG_RSP, AX_REG_RBP);
    if !check2(mut_view(*sec), 0x01u8, 0xecu8) { return 46; }
    ax_x64_mov_rr(mut_view(*sec), 4u8, AX_REG_RSP, AX_REG_R12);
    if !check3(mut_view(*sec), 0x44u8, 0x89u8, 0xe4u8) { return 47; }
    ax_x64_add_rr(mut_view(*sec), 4u8, AX_REG_RSP, AX_REG_R12);
    if !check3(mut_view(*sec), 0x44u8, 0x01u8, 0xe4u8) { return 48; }

    ax_x64_mov_rr(mut_view(*sec), 4u8, AX_REG_RBP, AX_REG_RAX);
    if !check2(mut_view(*sec), 0x89u8, 0xc5u8) { return 49; }
    ax_x64_add_rr(mut_view(*sec), 4u8, AX_REG_RBP, AX_REG_RAX);
    if !check2(mut_view(*sec), 0x01u8, 0xc5u8) { return 50; }
    ax_x64_mov_rr(mut_view(*sec), 4u8, AX_REG_RBP, AX_REG_RSP);
    if !check2(mut_view(*sec), 0x89u8, 0xe5u8) { return 51; }
    ax_x64_add_rr(mut_view(*sec), 4u8, AX_REG_RBP, AX_REG_RSP);
    if !check2(mut_view(*sec), 0x01u8, 0xe5u8) { return 52; }
    ax_x64_mov_rr(mut_view(*sec), 4u8, AX_REG_RBP, AX_REG_RBP);
    if !check2(mut_view(*sec), 0x89u8, 0xedu8) { return 53; }
    ax_x64_add_rr(mut_view(*sec), 4u8, AX_REG_RBP, AX_REG_RBP);
    if !check2(mut_view(*sec), 0x01u8, 0xedu8) { return 54; }
    ax_x64_mov_rr(mut_view(*sec), 4u8, AX_REG_RBP, AX_REG_R12);
    if !check3(mut_view(*sec), 0x44u8, 0x89u8, 0xe5u8) { return 55; }
    ax_x64_add_rr(mut_view(*sec), 4u8, AX_REG_RBP, AX_REG_R12);
    if !check3(mut_view(*sec), 0x44u8, 0x01u8, 0xe5u8) { return 56; }

    ax_x64_mov_rr(mut_view(*sec), 4u8, AX_REG_R12, AX_REG_RAX);
    if !check3(mut_view(*sec), 0x41u8, 0x89u8, 0xc4u8) { return 57; }
    ax_x64_add_rr(mut_view(*sec), 4u8, AX_REG_R12, AX_REG_RAX);
    if !check3(mut_view(*sec), 0x41u8, 0x01u8, 0xc4u8) { return 58; }
    ax_x64_mov_rr(mut_view(*sec), 4u8, AX_REG_R12, AX_REG_RSP);
    if !check3(mut_view(*sec), 0x41u8, 0x89u8, 0xe4u8) { return 59; }
    ax_x64_add_rr(mut_view(*sec), 4u8, AX_REG_R12, AX_REG_RSP);
    if !check3(mut_view(*sec), 0x41u8, 0x01u8, 0xe4u8) { return 60; }
    ax_x64_mov_rr(mut_view(*sec), 4u8, AX_REG_R12, AX_REG_RBP);
    if !check3(mut_view(*sec), 0x41u8, 0x89u8, 0xecu8) { return 61; }
    ax_x64_add_rr(mut_view(*sec), 4u8, AX_REG_R12, AX_REG_RBP);
    if !check3(mut_view(*sec), 0x41u8, 0x01u8, 0xecu8) { return 62; }
    ax_x64_mov_rr(mut_view(*sec), 4u8, AX_REG_R12, AX_REG_R12);
    if !check3(mut_view(*sec), 0x45u8, 0x89u8, 0xe4u8) { return 63; }
    ax_x64_add_rr(mut_view(*sec), 4u8, AX_REG_R12, AX_REG_R12);
    if !check3(mut_view(*sec), 0x45u8, 0x01u8, 0xe4u8) { return 64; }

    // 64..95: 64-bit mov_rr and add_rr across %rax, %rsp, %rbp, %r12
    ax_x64_mov_rr(mut_view(*sec), 8u8, AX_REG_RAX, AX_REG_RAX);
    if !check3(mut_view(*sec), 0x48u8, 0x89u8, 0xc0u8) { return 65; }
    ax_x64_add_rr(mut_view(*sec), 8u8, AX_REG_RAX, AX_REG_RAX);
    if !check3(mut_view(*sec), 0x48u8, 0x01u8, 0xc0u8) { return 66; }
    ax_x64_mov_rr(mut_view(*sec), 8u8, AX_REG_RAX, AX_REG_RSP);
    if !check3(mut_view(*sec), 0x48u8, 0x89u8, 0xe0u8) { return 67; }
    ax_x64_add_rr(mut_view(*sec), 8u8, AX_REG_RAX, AX_REG_RSP);
    if !check3(mut_view(*sec), 0x48u8, 0x01u8, 0xe0u8) { return 68; }
    ax_x64_mov_rr(mut_view(*sec), 8u8, AX_REG_RAX, AX_REG_RBP);
    if !check3(mut_view(*sec), 0x48u8, 0x89u8, 0xe8u8) { return 69; }
    ax_x64_add_rr(mut_view(*sec), 8u8, AX_REG_RAX, AX_REG_RBP);
    if !check3(mut_view(*sec), 0x48u8, 0x01u8, 0xe8u8) { return 70; }
    ax_x64_mov_rr(mut_view(*sec), 8u8, AX_REG_RAX, AX_REG_R12);
    if !check3(mut_view(*sec), 0x4cu8, 0x89u8, 0xe0u8) { return 71; }
    ax_x64_add_rr(mut_view(*sec), 8u8, AX_REG_RAX, AX_REG_R12);
    if !check3(mut_view(*sec), 0x4cu8, 0x01u8, 0xe0u8) { return 72; }

    ax_x64_mov_rr(mut_view(*sec), 8u8, AX_REG_RSP, AX_REG_RAX);
    if !check3(mut_view(*sec), 0x48u8, 0x89u8, 0xc4u8) { return 73; }
    ax_x64_add_rr(mut_view(*sec), 8u8, AX_REG_RSP, AX_REG_RAX);
    if !check3(mut_view(*sec), 0x48u8, 0x01u8, 0xc4u8) { return 74; }
    ax_x64_mov_rr(mut_view(*sec), 8u8, AX_REG_RSP, AX_REG_RSP);
    if !check3(mut_view(*sec), 0x48u8, 0x89u8, 0xe4u8) { return 75; }
    ax_x64_add_rr(mut_view(*sec), 8u8, AX_REG_RSP, AX_REG_RSP);
    if !check3(mut_view(*sec), 0x48u8, 0x01u8, 0xe4u8) { return 76; }
    ax_x64_mov_rr(mut_view(*sec), 8u8, AX_REG_RSP, AX_REG_RBP);
    if !check3(mut_view(*sec), 0x48u8, 0x89u8, 0xecu8) { return 77; }
    ax_x64_add_rr(mut_view(*sec), 8u8, AX_REG_RSP, AX_REG_RBP);
    if !check3(mut_view(*sec), 0x48u8, 0x01u8, 0xecu8) { return 78; }
    ax_x64_mov_rr(mut_view(*sec), 8u8, AX_REG_RSP, AX_REG_R12);
    if !check3(mut_view(*sec), 0x4cu8, 0x89u8, 0xe4u8) { return 79; }
    ax_x64_add_rr(mut_view(*sec), 8u8, AX_REG_RSP, AX_REG_R12);
    if !check3(mut_view(*sec), 0x4cu8, 0x01u8, 0xe4u8) { return 80; }

    ax_x64_mov_rr(mut_view(*sec), 8u8, AX_REG_RBP, AX_REG_RAX);
    if !check3(mut_view(*sec), 0x48u8, 0x89u8, 0xc5u8) { return 81; }
    ax_x64_add_rr(mut_view(*sec), 8u8, AX_REG_RBP, AX_REG_RAX);
    if !check3(mut_view(*sec), 0x48u8, 0x01u8, 0xc5u8) { return 82; }
    ax_x64_mov_rr(mut_view(*sec), 8u8, AX_REG_RBP, AX_REG_RSP);
    if !check3(mut_view(*sec), 0x48u8, 0x89u8, 0xe5u8) { return 83; }
    ax_x64_add_rr(mut_view(*sec), 8u8, AX_REG_RBP, AX_REG_RSP);
    if !check3(mut_view(*sec), 0x48u8, 0x01u8, 0xe5u8) { return 84; }
    ax_x64_mov_rr(mut_view(*sec), 8u8, AX_REG_RBP, AX_REG_RBP);
    if !check3(mut_view(*sec), 0x48u8, 0x89u8, 0xedu8) { return 85; }
    ax_x64_add_rr(mut_view(*sec), 8u8, AX_REG_RBP, AX_REG_RBP);
    if !check3(mut_view(*sec), 0x48u8, 0x01u8, 0xedu8) { return 86; }
    ax_x64_mov_rr(mut_view(*sec), 8u8, AX_REG_RBP, AX_REG_R12);
    if !check3(mut_view(*sec), 0x4cu8, 0x89u8, 0xe5u8) { return 87; }
    ax_x64_add_rr(mut_view(*sec), 8u8, AX_REG_RBP, AX_REG_R12);
    if !check3(mut_view(*sec), 0x4cu8, 0x01u8, 0xe5u8) { return 88; }

    ax_x64_mov_rr(mut_view(*sec), 8u8, AX_REG_R12, AX_REG_RAX);
    if !check3(mut_view(*sec), 0x49u8, 0x89u8, 0xc4u8) { return 89; }
    ax_x64_add_rr(mut_view(*sec), 8u8, AX_REG_R12, AX_REG_RAX);
    if !check3(mut_view(*sec), 0x49u8, 0x01u8, 0xc4u8) { return 90; }
    ax_x64_mov_rr(mut_view(*sec), 8u8, AX_REG_R12, AX_REG_RSP);
    if !check3(mut_view(*sec), 0x49u8, 0x89u8, 0xe4u8) { return 91; }
    ax_x64_add_rr(mut_view(*sec), 8u8, AX_REG_R12, AX_REG_RSP);
    if !check3(mut_view(*sec), 0x49u8, 0x01u8, 0xe4u8) { return 92; }
    ax_x64_mov_rr(mut_view(*sec), 8u8, AX_REG_R12, AX_REG_RBP);
    if !check3(mut_view(*sec), 0x49u8, 0x89u8, 0xecu8) { return 93; }
    ax_x64_add_rr(mut_view(*sec), 8u8, AX_REG_R12, AX_REG_RBP);
    if !check3(mut_view(*sec), 0x49u8, 0x01u8, 0xecu8) { return 94; }
    ax_x64_mov_rr(mut_view(*sec), 8u8, AX_REG_R12, AX_REG_R12);
    if !check3(mut_view(*sec), 0x4du8, 0x89u8, 0xe4u8) { return 95; }
    ax_x64_add_rr(mut_view(*sec), 8u8, AX_REG_R12, AX_REG_R12);
    if !check3(mut_view(*sec), 0x4du8, 0x01u8, 0xe4u8) { return 96; }

    // 96..110: Memory addressing modes (base, disp8, disp32 across rax, rsp, rbp, r12, r13)
    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_base(AX_REG_RAX));
    if !check3(mut_view(*sec), 0x48u8, 0x8bu8, 0x00u8) { return 97; }
    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_base(AX_REG_RSP));
    if !check4(mut_view(*sec), 0x48u8, 0x8bu8, 0x04u8, 0x24u8) { return 98; }
    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_base(AX_REG_RBP));
    if !check4(mut_view(*sec), 0x48u8, 0x8bu8, 0x45u8, 0x00u8) { return 99; }
    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_base(AX_REG_R12));
    if !check4(mut_view(*sec), 0x49u8, 0x8bu8, 0x04u8, 0x24u8) { return 100; }
    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_base(AX_REG_R13));
    if !check4(mut_view(*sec), 0x49u8, 0x8bu8, 0x45u8, 0x00u8) { return 101; }

    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_base_disp(AX_REG_RAX, 8));
    if !check4(mut_view(*sec), 0x48u8, 0x8bu8, 0x40u8, 0x08u8) { return 102; }
    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_base_disp(AX_REG_RSP, 8));
    if !check5(mut_view(*sec), 0x48u8, 0x8bu8, 0x44u8, 0x24u8, 0x08u8) { return 103; }
    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_base_disp(AX_REG_RBP, 8));
    if !check4(mut_view(*sec), 0x48u8, 0x8bu8, 0x45u8, 0x08u8) { return 104; }
    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_base_disp(AX_REG_R12, 8));
    if !check5(mut_view(*sec), 0x49u8, 0x8bu8, 0x44u8, 0x24u8, 0x08u8) { return 105; }
    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_base_disp(AX_REG_R13, 8));
    if !check4(mut_view(*sec), 0x49u8, 0x8bu8, 0x45u8, 0x08u8) { return 106; }

    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_base_disp(AX_REG_RAX, 1000));
    if !check7(mut_view(*sec), 0x48u8, 0x8bu8, 0x80u8, 0xe8u8, 0x03u8, 0x00u8, 0x00u8) { return 107; }
    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_base_disp(AX_REG_RSP, 1000));
    if !check8(mut_view(*sec), 0x48u8, 0x8bu8, 0x84u8, 0x24u8, 0xe8u8, 0x03u8, 0x00u8, 0x00u8) { return 108; }
    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_base_disp(AX_REG_RBP, 1000));
    if !check7(mut_view(*sec), 0x48u8, 0x8bu8, 0x85u8, 0xe8u8, 0x03u8, 0x00u8, 0x00u8) { return 109; }
    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_base_disp(AX_REG_R12, 1000));
    if !check8(mut_view(*sec), 0x49u8, 0x8bu8, 0x84u8, 0x24u8, 0xe8u8, 0x03u8, 0x00u8, 0x00u8) { return 110; }
    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_base_disp(AX_REG_R13, 1000));
    if !check7(mut_view(*sec), 0x49u8, 0x8bu8, 0x85u8, 0xe8u8, 0x03u8, 0x00u8, 0x00u8) { return 111; }

    // 111..128: SIB index * scale combinations
    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_index(AX_REG_RAX, AX_REG_RCX, 1u8));
    if !check4(mut_view(*sec), 0x48u8, 0x8bu8, 0x04u8, 0x08u8) { return 112; }
    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_index(AX_REG_RAX, AX_REG_RCX, 4u8));
    if !check4(mut_view(*sec), 0x48u8, 0x8bu8, 0x04u8, 0x88u8) { return 113; }
    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_index(AX_REG_RAX, AX_REG_RBP, 1u8));
    if !check4(mut_view(*sec), 0x48u8, 0x8bu8, 0x04u8, 0x28u8) { return 114; }
    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_index(AX_REG_RAX, AX_REG_RBP, 4u8));
    if !check4(mut_view(*sec), 0x48u8, 0x8bu8, 0x04u8, 0xa8u8) { return 115; }
    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_index(AX_REG_RAX, AX_REG_R13, 1u8));
    if !check4(mut_view(*sec), 0x4au8, 0x8bu8, 0x04u8, 0x28u8) { return 116; }
    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_index(AX_REG_RAX, AX_REG_R13, 4u8));
    if !check4(mut_view(*sec), 0x4au8, 0x8bu8, 0x04u8, 0xa8u8) { return 117; }

    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_index(AX_REG_RSP, AX_REG_RCX, 1u8));
    if !check4(mut_view(*sec), 0x48u8, 0x8bu8, 0x04u8, 0x0cu8) { return 118; }
    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_index(AX_REG_RSP, AX_REG_RCX, 4u8));
    if !check4(mut_view(*sec), 0x48u8, 0x8bu8, 0x04u8, 0x8cu8) { return 119; }
    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_index(AX_REG_RSP, AX_REG_RBP, 1u8));
    if !check4(mut_view(*sec), 0x48u8, 0x8bu8, 0x04u8, 0x2cu8) { return 120; }
    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_index(AX_REG_RSP, AX_REG_RBP, 4u8));
    if !check4(mut_view(*sec), 0x48u8, 0x8bu8, 0x04u8, 0xacu8) { return 121; }
    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_index(AX_REG_RSP, AX_REG_R13, 1u8));
    if !check4(mut_view(*sec), 0x4au8, 0x8bu8, 0x04u8, 0x2cu8) { return 122; }
    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_index(AX_REG_RSP, AX_REG_R13, 4u8));
    if !check4(mut_view(*sec), 0x4au8, 0x8bu8, 0x04u8, 0xacu8) { return 123; }

    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_index(AX_REG_R12, AX_REG_RCX, 1u8));
    if !check4(mut_view(*sec), 0x49u8, 0x8bu8, 0x04u8, 0x0cu8) { return 124; }
    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_index(AX_REG_R12, AX_REG_RCX, 4u8));
    if !check4(mut_view(*sec), 0x49u8, 0x8bu8, 0x04u8, 0x8cu8) { return 125; }
    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_index(AX_REG_R12, AX_REG_RBP, 1u8));
    if !check4(mut_view(*sec), 0x49u8, 0x8bu8, 0x04u8, 0x2cu8) { return 126; }
    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_index(AX_REG_R12, AX_REG_RBP, 4u8));
    if !check4(mut_view(*sec), 0x49u8, 0x8bu8, 0x04u8, 0xacu8) { return 127; }
    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_index(AX_REG_R12, AX_REG_R13, 1u8));
    if !check4(mut_view(*sec), 0x4bu8, 0x8bu8, 0x04u8, 0x2cu8) { return 128; }
    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_index(AX_REG_R12, AX_REG_R13, 4u8));
    if !check4(mut_view(*sec), 0x4bu8, 0x8bu8, 0x04u8, 0xacu8) { return 129; }

    // 129..134: RIP-relative, cqo, cdq, ret, int3, jmp8
    ax_x64_mov_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_rip(10));
    if !check7(mut_view(*sec), 0x48u8, 0x8bu8, 0x05u8, 0x0au8, 0x00u8, 0x00u8, 0x00u8) { return 130; }
    ax_x64_cqo(mut_view(*sec));
    if !check2(mut_view(*sec), 0x48u8, 0x99u8) { return 131; }
    ax_x64_cdq(mut_view(*sec));
    if !check1(mut_view(*sec), 0x99u8) { return 132; }
    ax_x64_ret(mut_view(*sec));
    if !check1(mut_view(*sec), 0xc3u8) { return 133; }
    ax_x64_int3(mut_view(*sec));
    if !check1(mut_view(*sec), 0xccu8) { return 134; }
    ax_x64_jmp8(mut_view(*sec), 0x10i8);
    if !check2(mut_view(*sec), 0xebu8, 0x10u8) { return 135; }

    0
}

// Test all remaining instruction forms across widths, registers, and addressing modes
fn test_all_instruction_forms(sec: mut_view<Section>) -> i32 {
    sec.bytes_len = 0;

    // 1. mov_mr, mov_ri (sz = 1, 2, 4, 8), mov_mi (sz = 1, 2, 4, 8)
    ax_x64_mov_mr(mut_view(*sec), 8u8, ax_x64_mem_base_disp(AX_REG_RBP, -8), AX_REG_RCX);
    if !check4(mut_view(*sec), 0x48u8, 0x89u8, 0x4du8, 0xf8u8) { return 201; }
    ax_x64_mov_mr(mut_view(*sec), 1u8, ax_x64_mem_base(AX_REG_RAX), AX_REG_RSI);
    if !check3(mut_view(*sec), 0x40u8, 0x88u8, 0x30u8) { return 202; }

    ax_x64_mov_ri(mut_view(*sec), 1u8, AX_REG_RCX, 0x7Fi64);
    if !check2(mut_view(*sec), 0xb1u8, 0x7fu8) { return 203; }
    ax_x64_mov_ri(mut_view(*sec), 1u8, AX_REG_RDI, 0x55i64);
    if !check3(mut_view(*sec), 0x40u8, 0xb7u8, 0x55u8) { return 204; }
    ax_x64_mov_ri(mut_view(*sec), 2u8, AX_REG_RDX, 0x1234i64);
    if !check4(mut_view(*sec), 0x66u8, 0xbau8, 0x34u8, 0x12u8) { return 205; }
    ax_x64_mov_ri(mut_view(*sec), 4u8, AX_REG_R9, 42i64);
    if !check6(mut_view(*sec), 0x41u8, 0xb9u8, 0x2au8, 0x00u8, 0x00u8, 0x00u8) { return 206; }
    ax_x64_mov_ri(mut_view(*sec), 8u8, AX_REG_RAX, 0x0102030405060708i64);
    if !check10(mut_view(*sec), 0x48u8, 0xb8u8, 0x08u8, 0x07u8, 0x06u8, 0x05u8, 0x04u8, 0x03u8, 0x02u8, 0x01u8) { return 207; }

    ax_x64_mov_mi(mut_view(*sec), 1u8, ax_x64_mem_base_disp(AX_REG_RBP, -1), 0x33);
    if !check4(mut_view(*sec), 0xc6u8, 0x45u8, 0xffu8, 0x33u8) { return 208; }
    ax_x64_mov_mi(mut_view(*sec), 2u8, ax_x64_mem_base_disp(AX_REG_RBP, -2), 0x1122);
    if !check6(mut_view(*sec), 0x66u8, 0xc7u8, 0x45u8, 0xfeu8, 0x22u8, 0x11u8) { return 209; }
    ax_x64_mov_mi(mut_view(*sec), 8u8, ax_x64_mem_base_disp(AX_REG_RBP, -8), -1);
    if !check8(mut_view(*sec), 0x48u8, 0xc7u8, 0x45u8, 0xf8u8, 0xffu8, 0xffu8, 0xffu8, 0xffu8) { return 210; }

    // 2. movzx_rr, movzx_rm, movsx_rr, movsx_rm
    ax_x64_movzx_rr(mut_view(*sec), 8u8, 1u8, AX_REG_RAX, AX_REG_RCX);
    if !check4(mut_view(*sec), 0x48u8, 0x0fu8, 0xb6u8, 0xc1u8) { return 211; }
    ax_x64_movzx_rr(mut_view(*sec), 4u8, 2u8, AX_REG_R8, AX_REG_R9);
    if !check4(mut_view(*sec), 0x45u8, 0x0fu8, 0xb7u8, 0xc1u8) { return 212; }
    ax_x64_movzx_rm(mut_view(*sec), 8u8, 1u8, AX_REG_RAX, ax_x64_mem_base_disp(AX_REG_RBP, -16));
    if !check5(mut_view(*sec), 0x48u8, 0x0fu8, 0xb6u8, 0x45u8, 0xf0u8) { return 213; }
    ax_x64_movsx_rr(mut_view(*sec), 8u8, 1u8, AX_REG_RDX, AX_REG_RAX);
    if !check4(mut_view(*sec), 0x48u8, 0x0fu8, 0xbeu8, 0xd0u8) { return 214; }
    ax_x64_movsx_rm(mut_view(*sec), 8u8, 2u8, AX_REG_R10, ax_x64_mem_base(AX_REG_RCX));
    if !check4(mut_view(*sec), 0x4cu8, 0x0fu8, 0xbfu8, 0x11u8) { return 215; }

    // 3. lea (including index + disp)
    ax_x64_lea(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_base_disp(AX_REG_RBP, -64));
    if !check4(mut_view(*sec), 0x48u8, 0x8du8, 0x45u8, 0xc0u8) { return 216; }
    ax_x64_lea(mut_view(*sec), 8u8, AX_REG_RCX, ax_x64_mem_index_disp(AX_REG_RAX, AX_REG_RDX, 8u8, 16));
    if !check5(mut_view(*sec), 0x48u8, 0x8du8, 0x4cu8, 0xd0u8, 0x10u8) { return 217; }

    // 4. ALU: add, or, and, sub, xor, cmp (rr, rm, mr, ri with RAX short form, imm8, imm32)
    ax_x64_add_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_base_disp(AX_REG_RBP, -8));
    if !check4(mut_view(*sec), 0x48u8, 0x03u8, 0x45u8, 0xf8u8) { return 218; }
    ax_x64_add_mr(mut_view(*sec), 8u8, ax_x64_mem_base_disp(AX_REG_RBP, -8), AX_REG_RAX);
    if !check4(mut_view(*sec), 0x48u8, 0x01u8, 0x45u8, 0xf8u8) { return 219; }
    ax_x64_add_ri(mut_view(*sec), 8u8, AX_REG_RSP, 56);
    if !check4(mut_view(*sec), 0x48u8, 0x83u8, 0xc4u8, 0x38u8) { return 220; }
    ax_x64_add_ri(mut_view(*sec), 8u8, AX_REG_RSP, 4096);
    if !check7(mut_view(*sec), 0x48u8, 0x81u8, 0xc4u8, 0x00u8, 0x10u8, 0x00u8, 0x00u8) { return 221; }
    ax_x64_add_ri(mut_view(*sec), 1u8, AX_REG_RAX, 5);
    if !check2(mut_view(*sec), 0x04u8, 0x05u8) { return 222; }
    ax_x64_add_ri(mut_view(*sec), 1u8, AX_REG_RCX, 5);
    if !check3(mut_view(*sec), 0x80u8, 0xc1u8, 0x05u8) { return 223; }
    ax_x64_add_ri(mut_view(*sec), 8u8, AX_REG_RAX, 4096);
    if !check6(mut_view(*sec), 0x48u8, 0x05u8, 0x00u8, 0x10u8, 0x00u8, 0x00u8) { return 224; }

    ax_x64_or_rr(mut_view(*sec), 8u8, AX_REG_RAX, AX_REG_RCX);
    if !check3(mut_view(*sec), 0x48u8, 0x09u8, 0xc8u8) { return 225; }
    ax_x64_or_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_base(AX_REG_RCX));
    if !check3(mut_view(*sec), 0x48u8, 0x0bu8, 0x01u8) { return 226; }
    ax_x64_or_mr(mut_view(*sec), 8u8, ax_x64_mem_base(AX_REG_RCX), AX_REG_RAX);
    if !check3(mut_view(*sec), 0x48u8, 0x09u8, 0x01u8) { return 227; }
    ax_x64_or_ri(mut_view(*sec), 8u8, AX_REG_RCX, 3);
    if !check4(mut_view(*sec), 0x48u8, 0x83u8, 0xc9u8, 0x03u8) { return 228; }

    ax_x64_and_rr(mut_view(*sec), 8u8, AX_REG_RAX, AX_REG_RDX);
    if !check3(mut_view(*sec), 0x48u8, 0x21u8, 0xd0u8) { return 229; }
    ax_x64_and_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_base(AX_REG_RDX));
    if !check3(mut_view(*sec), 0x48u8, 0x23u8, 0x02u8) { return 230; }
    ax_x64_and_mr(mut_view(*sec), 8u8, ax_x64_mem_base(AX_REG_RDX), AX_REG_RAX);
    if !check3(mut_view(*sec), 0x48u8, 0x21u8, 0x02u8) { return 231; }
    ax_x64_and_ri(mut_view(*sec), 8u8, AX_REG_RCX, 1);
    if !check4(mut_view(*sec), 0x48u8, 0x83u8, 0xe1u8, 0x01u8) { return 232; }
    ax_x64_and_ri(mut_view(*sec), 8u8, AX_REG_RAX, 0xFF);
    if !check6(mut_view(*sec), 0x48u8, 0x25u8, 0xffu8, 0x00u8, 0x00u8, 0x00u8) { return 233; }

    ax_x64_sub_rr(mut_view(*sec), 8u8, AX_REG_RSP, AX_REG_RAX);
    if !check3(mut_view(*sec), 0x48u8, 0x29u8, 0xc4u8) { return 234; }
    ax_x64_sub_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_base_disp(AX_REG_RBP, -16));
    if !check4(mut_view(*sec), 0x48u8, 0x2bu8, 0x45u8, 0xf0u8) { return 235; }
    ax_x64_sub_mr(mut_view(*sec), 8u8, ax_x64_mem_base_disp(AX_REG_RBP, -16), AX_REG_RAX);
    if !check4(mut_view(*sec), 0x48u8, 0x29u8, 0x45u8, 0xf0u8) { return 236; }
    ax_x64_sub_ri(mut_view(*sec), 8u8, AX_REG_RSP, 56);
    if !check4(mut_view(*sec), 0x48u8, 0x83u8, 0xecu8, 0x38u8) { return 237; }
    ax_x64_sub_ri(mut_view(*sec), 8u8, AX_REG_RSP, 4096);
    if !check7(mut_view(*sec), 0x48u8, 0x81u8, 0xecu8, 0x00u8, 0x10u8, 0x00u8, 0x00u8) { return 238; }

    ax_x64_xor_rr(mut_view(*sec), 8u8, AX_REG_RAX, AX_REG_RAX);
    if !check3(mut_view(*sec), 0x48u8, 0x31u8, 0xc0u8) { return 239; }
    ax_x64_xor_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_base(AX_REG_RCX));
    if !check3(mut_view(*sec), 0x48u8, 0x33u8, 0x01u8) { return 240; }
    ax_x64_xor_mr(mut_view(*sec), 8u8, ax_x64_mem_base(AX_REG_RCX), AX_REG_RAX);
    if !check3(mut_view(*sec), 0x48u8, 0x31u8, 0x01u8) { return 241; }
    ax_x64_xor_ri(mut_view(*sec), 8u8, AX_REG_RCX, 1);
    if !check4(mut_view(*sec), 0x48u8, 0x83u8, 0xf1u8, 0x01u8) { return 242; }

    ax_x64_cmp_rr(mut_view(*sec), 8u8, AX_REG_RAX, AX_REG_RDX);
    if !check3(mut_view(*sec), 0x48u8, 0x39u8, 0xd0u8) { return 243; }
    ax_x64_cmp_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_base_disp(AX_REG_RBP, -8));
    if !check4(mut_view(*sec), 0x48u8, 0x3bu8, 0x45u8, 0xf8u8) { return 244; }
    ax_x64_cmp_mr(mut_view(*sec), 8u8, ax_x64_mem_base_disp(AX_REG_RBP, -8), AX_REG_RAX);
    if !check4(mut_view(*sec), 0x48u8, 0x39u8, 0x45u8, 0xf8u8) { return 245; }
    ax_x64_cmp_ri(mut_view(*sec), 8u8, AX_REG_RDX, -1);
    if !check4(mut_view(*sec), 0x48u8, 0x83u8, 0xfau8, 0xffu8) { return 246; }
    ax_x64_cmp_ri(mut_view(*sec), 8u8, AX_REG_RAX, 4096);
    if !check6(mut_view(*sec), 0x48u8, 0x3du8, 0x00u8, 0x10u8, 0x00u8, 0x00u8) { return 247; }

    // 5. test_rr, test_rm, test_ri
    ax_x64_test_rr(mut_view(*sec), 8u8, AX_REG_RAX, AX_REG_RAX);
    if !check3(mut_view(*sec), 0x48u8, 0x85u8, 0xc0u8) { return 248; }
    ax_x64_test_rm(mut_view(*sec), 4u8, AX_REG_RAX, ax_x64_mem_base(AX_REG_RSP));
    if !check3(mut_view(*sec), 0x85u8, 0x04u8, 0x24u8) { return 249; }
    ax_x64_test_ri(mut_view(*sec), 1u8, AX_REG_RAX, 1);
    if !check2(mut_view(*sec), 0xa8u8, 0x01u8) { return 250; }
    ax_x64_test_ri(mut_view(*sec), 1u8, AX_REG_RCX, 1);
    if !check3(mut_view(*sec), 0xf6u8, 0xc1u8, 0x01u8) { return 251; }
    ax_x64_test_ri(mut_view(*sec), 8u8, AX_REG_RAX, 0xFF);
    if !check6(mut_view(*sec), 0x48u8, 0xa9u8, 0xffu8, 0x00u8, 0x00u8, 0x00u8) { return 252; }
    ax_x64_test_ri(mut_view(*sec), 8u8, AX_REG_RCX, 0xFF);
    if !check7(mut_view(*sec), 0x48u8, 0xf7u8, 0xc1u8, 0xffu8, 0x00u8, 0x00u8, 0x00u8) { return 253; }

    // 6. imul, mul, idiv, div, neg, not
    ax_x64_imul_rr(mut_view(*sec), 8u8, AX_REG_RAX, AX_REG_RCX);
    if !check4(mut_view(*sec), 0x48u8, 0x0fu8, 0xafu8, 0xc1u8) { return 254; }
    ax_x64_imul_rm(mut_view(*sec), 8u8, AX_REG_RAX, ax_x64_mem_base_disp(AX_REG_RBP, -8));
    if !check5(mut_view(*sec), 0x48u8, 0x0fu8, 0xafu8, 0x45u8, 0xf8u8) { return 255; }
    ax_x64_mul_r(mut_view(*sec), 8u8, AX_REG_RDX);
    if !check3(mut_view(*sec), 0x48u8, 0xf7u8, 0xe2u8) { return 256; }
    ax_x64_mul_m(mut_view(*sec), 8u8, ax_x64_mem_base_disp(AX_REG_RBP, -8));
    if !check4(mut_view(*sec), 0x48u8, 0xf7u8, 0x65u8, 0xf8u8) { return 257; }
    ax_x64_idiv_r(mut_view(*sec), 8u8, AX_REG_RCX);
    if !check3(mut_view(*sec), 0x48u8, 0xf7u8, 0xf9u8) { return 258; }
    ax_x64_idiv_m(mut_view(*sec), 8u8, ax_x64_mem_base_disp(AX_REG_RBP, -16));
    if !check4(mut_view(*sec), 0x48u8, 0xf7u8, 0x7du8, 0xf0u8) { return 259; }
    ax_x64_div_r(mut_view(*sec), 8u8, AX_REG_RCX);
    if !check3(mut_view(*sec), 0x48u8, 0xf7u8, 0xf1u8) { return 260; }
    ax_x64_div_m(mut_view(*sec), 8u8, ax_x64_mem_base_disp(AX_REG_RBP, -16));
    if !check4(mut_view(*sec), 0x48u8, 0xf7u8, 0x75u8, 0xf0u8) { return 261; }
    ax_x64_neg_r(mut_view(*sec), 8u8, AX_REG_RAX);
    if !check3(mut_view(*sec), 0x48u8, 0xf7u8, 0xd8u8) { return 262; }
    ax_x64_neg_m(mut_view(*sec), 8u8, ax_x64_mem_base(AX_REG_RCX));
    if !check3(mut_view(*sec), 0x48u8, 0xf7u8, 0x19u8) { return 263; }
    ax_x64_not_r(mut_view(*sec), 8u8, AX_REG_RAX);
    if !check3(mut_view(*sec), 0x48u8, 0xf7u8, 0xd0u8) { return 264; }
    ax_x64_not_m(mut_view(*sec), 8u8, ax_x64_mem_base(AX_REG_RCX));
    if !check3(mut_view(*sec), 0x48u8, 0xf7u8, 0x11u8) { return 265; }

    // 7. Shifts: shl, shr, sar (by %cl, by 1, by imm8)
    ax_x64_shl_rcl(mut_view(*sec), 8u8, AX_REG_RAX);
    if !check3(mut_view(*sec), 0x48u8, 0xd3u8, 0xe0u8) { return 266; }
    ax_x64_shl_ri(mut_view(*sec), 8u8, AX_REG_RAX, 1u8);
    if !check3(mut_view(*sec), 0x48u8, 0xd1u8, 0xe0u8) { return 267; }
    ax_x64_shl_ri(mut_view(*sec), 8u8, AX_REG_RAX, 32u8);
    if !check4(mut_view(*sec), 0x48u8, 0xc1u8, 0xe0u8, 0x20u8) { return 268; }
    ax_x64_shr_rcl(mut_view(*sec), 8u8, AX_REG_RAX);
    if !check3(mut_view(*sec), 0x48u8, 0xd3u8, 0xe8u8) { return 269; }
    ax_x64_shr_ri(mut_view(*sec), 8u8, AX_REG_RAX, 1u8);
    if !check3(mut_view(*sec), 0x48u8, 0xd1u8, 0xe8u8) { return 270; }
    ax_x64_shr_ri(mut_view(*sec), 8u8, AX_REG_RAX, 32u8);
    if !check4(mut_view(*sec), 0x48u8, 0xc1u8, 0xe8u8, 0x20u8) { return 271; }
    ax_x64_sar_rcl(mut_view(*sec), 8u8, AX_REG_RAX);
    if !check3(mut_view(*sec), 0x48u8, 0xd3u8, 0xf8u8) { return 272; }
    ax_x64_sar_ri(mut_view(*sec), 8u8, AX_REG_RAX, 1u8);
    if !check3(mut_view(*sec), 0x48u8, 0xd1u8, 0xf8u8) { return 273; }
    ax_x64_sar_ri(mut_view(*sec), 8u8, AX_REG_RDX, 63u8);
    if !check4(mut_view(*sec), 0x48u8, 0xc1u8, 0xfau8, 0x3fu8) { return 274; }

    // 8. setcc_r, setcc_m, jcc, jmp, jcc8, call, call_r, call_m, push, pop, nop, align_code
    ax_x64_setcc_r(mut_view(*sec), CC_E, AX_REG_RAX);
    if !check3(mut_view(*sec), 0x0fu8, 0x94u8, 0xc0u8) { return 275; }
    ax_x64_setcc_r(mut_view(*sec), CC_L, AX_REG_RSI);
    if !check4(mut_view(*sec), 0x40u8, 0x0fu8, 0x9cu8, 0xc6u8) { return 276; }
    ax_x64_setcc_r(mut_view(*sec), CC_G, AX_REG_R8);
    if !check4(mut_view(*sec), 0x41u8, 0x0fu8, 0x9fu8, 0xc0u8) { return 277; }
    ax_x64_setcc_m(mut_view(*sec), CC_NE, ax_x64_mem_base_disp(AX_REG_RBP, -1));
    if !check4(mut_view(*sec), 0x0fu8, 0x95u8, 0x45u8, 0xffu8) { return 278; }

    ax_x64_jcc(mut_view(*sec), CC_E, 0x20);
    if !check6(mut_view(*sec), 0x0fu8, 0x84u8, 0x20u8, 0x00u8, 0x00u8, 0x00u8) { return 279; }
    ax_x64_jmp(mut_view(*sec), -5);
    if !check5(mut_view(*sec), 0xe9u8, 0xfbu8, 0xffu8, 0xffu8, 0xffu8) { return 280; }
    ax_x64_jcc8(mut_view(*sec), CC_A, -19i8);
    if !check2(mut_view(*sec), 0x77u8, 0xedu8) { return 281; }

    ax_x64_call(mut_view(*sec), 0x100);
    if !check5(mut_view(*sec), 0xe8u8, 0x00u8, 0x01u8, 0x00u8, 0x00u8) { return 282; }
    ax_x64_call_r(mut_view(*sec), AX_REG_RAX);
    if !check3(mut_view(*sec), 0x48u8, 0xffu8, 0xd0u8) { return 283; }
    ax_x64_call_r(mut_view(*sec), AX_REG_R10);
    if !check3(mut_view(*sec), 0x49u8, 0xffu8, 0xd2u8) { return 284; }
    ax_x64_call_m(mut_view(*sec), ax_x64_mem_rip(0x1234));
    if !check7(mut_view(*sec), 0x48u8, 0xffu8, 0x15u8, 0x34u8, 0x12u8, 0x00u8, 0x00u8) { return 285; }

    ax_x64_push_r(mut_view(*sec), AX_REG_RBP);
    if !check1(mut_view(*sec), 0x55u8) { return 286; }
    ax_x64_push_r(mut_view(*sec), AX_REG_R12);
    if !check2(mut_view(*sec), 0x41u8, 0x54u8) { return 287; }
    ax_x64_push_m(mut_view(*sec), ax_x64_mem_base_disp(AX_REG_R12, 8));
    if !check5(mut_view(*sec), 0x41u8, 0xffu8, 0x74u8, 0x24u8, 0x08u8) { return 288; }
    ax_x64_pop_r(mut_view(*sec), AX_REG_RBP);
    if !check1(mut_view(*sec), 0x5du8) { return 289; }
    ax_x64_pop_r(mut_view(*sec), AX_REG_R15);
    if !check2(mut_view(*sec), 0x41u8, 0x5fu8) { return 290; }
    ax_x64_pop_m(mut_view(*sec), ax_x64_mem_base(AX_REG_RAX));
    if !check2(mut_view(*sec), 0x8fu8, 0x00u8) { return 291; }

    ax_x64_nop(mut_view(*sec));
    if !check1(mut_view(*sec), 0x90u8) { return 292; }

    ax_x64_ret(mut_view(*sec));
    x64_align_code(mut_view(*sec), 8);
    if section_bytes_len(view(*sec)) != 8 { return 293; }
    if section_byte_at(view(*sec), 0) != 0xc3u8 || section_byte_at(view(*sec), 7) != 0x90u8 { return 294; }
    sec.bytes_len = 0;

    0
}

fn test_metadata_and_encoding_helpers() -> i32 {
    if !x64_reg_is_valid(AX_REG_RAX) || !x64_reg_is_valid(AX_REG_R15) || x64_reg_is_valid(AX_REG_NONE) {
        return 301;
    }
    if x64_reg_is_extended(AX_REG_RDI) || !x64_reg_is_extended(AX_REG_R8) || x64_reg_is_extended(AX_REG_NONE) {
        return 302;
    }
    if x64_reg_needs_byte_rex(AX_REG_RBX) || !x64_reg_needs_byte_rex(AX_REG_RSP) || x64_reg_needs_byte_rex(AX_REG_NONE) {
        return 303;
    }
    if x64_reg_low3(AX_REG_R12) != 4u8 || x64_reg_low3(AX_REG_NONE) != 0u8 {
        return 304;
    }
    if !str_eq(x64_reg_name(AX_REG_RAX), { "rax" }) || !str_eq(x64_reg_name(AX_REG_R15), { "r15" }) {
        return 305;
    }
    if !str_eq(x64_reg_name_sz(AX_REG_RSP, 1u8), { "spl" }) ||
       !str_eq(x64_reg_name_sz(AX_REG_R12, 2u8), { "r12w" }) ||
       !str_eq(x64_reg_name_sz(AX_REG_R12, 4u8), { "r12d" }) ||
       !str_eq(x64_reg_name_sz(AX_REG_R12, 8u8), { "r12" }) {
        return 306;
    }
    if x64_cc_invert(CC_E) != CC_NE || x64_cc_invert(CC_L) != CC_GE || x64_cc_invert(CC_B) != CC_AE {
        return 307;
    }
    if !str_eq(x64_cc_name(CC_E), { "e" }) || !str_eq(x64_cc_name(CC_LE), { "le" }) {
        return 308;
    }
    if !str_eq(x64_mi_opcode_name(X64_MI_MOV), { "mov" }) ||
       !str_eq(x64_mi_opcode_name(X64_MI_ADD), { "add" }) ||
       !str_eq(x64_mi_opcode_name(X64_MI_RET), { "ret" }) {
        return 309;
    }
    if x64_rex_rr_byte(4u8, AX_REG_RAX, AX_REG_RCX) != 0u8 {
        return 310;
    }
    if x64_rex_rr_byte(1u8, AX_REG_RAX, AX_REG_RSP) != 0x40u8 {
        return 311;
    }
    if x64_rex_rr_byte(8u8, AX_REG_R12, AX_REG_R13) != 0x4Du8 {
        return 312;
    }
    if x64_rex_rm_byte(8u8, AX_REG_R8, ax_x64_mem_index(AX_REG_R12, AX_REG_R13, 4u8)) != 0x4Fu8 {
        return 313;
    }
    if x64_modrm_byte(3u8, 0u8, 4u8) != 0xC4u8 || x64_sib_byte(4u8, AX_REG_RCX, AX_REG_RAX) != 0x88u8 {
        return 314;
    }
    0
}

pub fn main() -> i32 {
    let mut model = objmodel_new();
    let text_id = objmodel_add_section_str(
        mut_view(model),
        { ".text" },
        AX_SEC_CODE,
        AX_SEC_FLAG_EXEC | AX_SEC_FLAG_READ,
        16u32
    );
    let text_sec = objmodel_get_section_mut(mut_view(model), text_id);
    if (text_sec as usize) == 0 {
        return 1000;
    }

    let rc1 = unsafe { test_gnu_as_reference_fixtures(mut_view(*text_sec)) };
    if rc1 != 0 {
        objmodel_free(mut_view(model));
        return rc1;
    }

    let rc2 = unsafe { test_all_instruction_forms(mut_view(*text_sec)) };
    if rc2 != 0 {
        objmodel_free(mut_view(model));
        return rc2;
    }

    let rc3 = test_metadata_and_encoding_helpers();
    if rc3 != 0 {
        objmodel_free(mut_view(model));
        return rc3;
    }

    objmodel_free(mut_view(model));
    print("OK x64 Instruction Encoder & GNU as Fixtures\n");
    0
}
