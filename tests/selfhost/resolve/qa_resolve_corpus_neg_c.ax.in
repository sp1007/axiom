    sess: mut_view<CompilerSession>,
    parse_arena: mut_view<Arena>,
    scratch: mut_view<Arena>,
    rmap: mut_view<ResolveMap>,
    out: mut_view<DiagBuffer>,
    diags: mut_view<DiagBuffer>,
    c_data: view<[5494]u8>,
    c_off: view<[27]u32>,
    case_idx: usize,
    need_std: bool
) -> i32 {
    session_init(mut_view(*sess));
    let case_off = ((case_idx as isize) * (BLOBS_PER_CASE as isize)) as usize;
    let base = FIRST_CASE_BLOB + case_off;
    let path_sv = get_sv(mut_view(*scratch), c_data, c_off, base);
    let src_sv = get_sv(mut_view(*scratch), c_data, c_off, base + 1);
    let exp_out = get_sv(mut_view(*scratch), c_data, c_off, base + 2);
    let exp_diag = get_sv(mut_view(*scratch), c_data, c_off, base + 3);
    let mut fid = FileId { v: 0u32 };
    let pr = session_parse_virtual_file(mut_view(*sess), mut_view(*parse_arena), path_sv, src_sv, mut_view(fid));
    if need_std {
        let mut s: usize = 0;
        while s < STD_FILE_COUNT {
            let sp = get_sv(mut_view(*scratch), c_data, c_off, s + s);
            let st = get_sv(mut_view(*scratch), c_data, c_off, s + s + 1);
            let mut sfid = FileId { v: 0u32 };
            let spr = session_parse_virtual_file(mut_view(*sess), mut_view(*parse_arena), sp, st, mut_view(sfid));
            append_items(pr.ast.items, spr.ast.items);
            s = s + 1;
        }
    }
    resolve_file_into(view(pr.ast), mut_view(*parse_arena), mut_view(sess.diag_sink), mut_view(sess.interner),
        mut_view(*rmap));
    emit_resolved(mut_view(*out), view(pr.ast), view(*rmap), view(sess.interner), FileId { v: fid.v });
    ax_diag_render_human(view(sess.diag_sink), view(sess.source_db), mut_view(*diags));
    let mut rc: i32 = 0;
    if exp_out.len > 0 && !bytes_equal(out.ptr as *const u8, out.len, exp_out.ptr, exp_out.len) {
        rc = OUTPUT_MISMATCH_RC;
    }
    let got_diag_len = trimmed_len(diags.ptr as *const u8, diags.len);
    if !bytes_equal(diags.ptr as *const u8, got_diag_len, exp_diag.ptr, exp_diag.len) {
        rc = DIAG_MISMATCH_RC;
    }
    diag_buf_free(mut_view(*diags));
    diag_buf_free(mut_view(*out));
    resolve_map_free(mut_view(*rmap));
    arena_destroy(mut_view(*parse_arena));
    session_free(mut_view(*sess));
    rc
}

pub fn main() -> i32 {
    let mut sess = session_new();
    let mut parse_arena = arena_new();
    let mut scratch = arena_new();
    let mut out = diag_buf_new();
    let mut diags = diag_buf_new();
    let mut rmap = ResolveMap {
        node_map: NodeMap { keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0 },
        module_access_nodes: NodeMap {
            keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0
        },
        extern_nodes: NodeMap {
            keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0
        },
        next_symbol_v: 1u32,
        next_std_symbol_v: 10000u32,
        naming_ctx: 0 as *mut NamingCtx,
    };
    let c_data = CORPUS_DATA;
    let c_off = CORPUS_OFF;
    let rc0 = verify_case(mut_view(sess), mut_view(parse_arena), mut_view(scratch),
        mut_view(rmap), mut_view(out), mut_view(diags), view(c_data), view(c_off), 0, false);
    if rc0 != 0 {
        return rc0 + 0;
    }
    let rc1 = verify_case(mut_view(sess), mut_view(parse_arena), mut_view(scratch),
        mut_view(rmap), mut_view(out), mut_view(diags), view(c_data), view(c_off), 1, true);
    if rc1 != 0 {
        return rc1 + 1;
    }
    let rc2 = verify_case(mut_view(sess), mut_view(parse_arena), mut_view(scratch),
        mut_view(rmap), mut_view(out), mut_view(diags), view(c_data), view(c_off), 2, false);
    if rc2 != 0 {
        return rc2 + 2;
    }
    let rc3 = verify_case(mut_view(sess), mut_view(parse_arena), mut_view(scratch),
        mut_view(rmap), mut_view(out), mut_view(diags), view(c_data), view(c_off), 3, false);
    if rc3 != 0 {
        return rc3 + 3;
    }
    let rc4 = verify_case(mut_view(sess), mut_view(parse_arena), mut_view(scratch),
        mut_view(rmap), mut_view(out), mut_view(diags), view(c_data), view(c_off), 4, false);
    if rc4 != 0 {
        return rc4 + 4;
    }
    arena_destroy(mut_view(scratch));
    print("OK Resolve Corpus Neg C (5 files)\n");
    0
}
