const CORPUS_OFF: [27]u32 = [
    0u32, 20u32, 90u32, 110u32, 183u32, 204u32, 339u32, 376u32, 444u32, 792u32, 987u32, 1016u32,
    1105u32, 1605u32, 1838u32, 1866u32, 2310u32, 3609u32, 4561u32, 4593u32, 4629u32, 4811u32, 4980u32, 5014u32,
    5065u32, 5302u32, 5494u32,
];

fn get_sv(a: mut_view<Arena>, c_data: view<[5494]u8>, c_off: view<[27]u32>, blob_idx: usize) -> StrView {
    let start = (*c_off)[blob_idx] as usize;
    let end = (*c_off)[blob_idx + 1] as usize;
    let n = end - start;
    let dst = arena_alloc_raw(a, n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = (*c_data)[start + i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn trimmed_len(p: *const u8, n: usize) -> usize {
    let mut end = n;
    while end > 0 {
        let c = unsafe { *(p + (end - 1)) };
        if c != 10u8 && c != 13u8 && c != 32u8 {
            return end;
        }
        end = end - 1;
    }
    0
}

fn bytes_equal(a: *const u8, a_len: usize, b: *const u8, b_len: usize) -> bool {
    if a_len != b_len {
        return false;
    }
    let mut i: usize = 0;
    while i < a_len {
        if (unsafe { *(a + i) }) != (unsafe { *(b + i) }) {
            return false;
        }
        i = i + 1;
    }
    true
}

fn append_items(head: *mut AstItem, more: *mut AstItem) {
    if (head as usize) == 0 || (more as usize) == 0 {
        return;
    }
    let mut cur: *mut AstItem = head;
    while (unsafe { (*cur).next as usize }) != 0 {
        cur = unsafe { (*cur).next };
    }
    unsafe { (*cur).next = more; }
}

