const QA_BLOB_OFF: [5]u32 = [
    0u32, 310u32, 574u32, 958u32, 1608u32
];

fn get_qa_sv(a: mut_view<Arena>, idx: usize) -> StrView {
    let start = QA_BLOB_OFF[idx] as usize;
    let end = QA_BLOB_OFF[idx + 1] as usize;
    let n = end - start;
    let dst = arena_alloc_raw(a, n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe {
            *(dst + i) = QA_BLOB_DATA[start + i];
        }
        i = i + 1;
    }
    unsafe {
        *(dst + n) = 0u8;
    }
    StrView { ptr: dst as *const u8, len: n }
}

fn bytes_equal(a: *const u8, a_len: usize, b: *const u8, b_len: usize) -> bool {
    if a_len != b_len {
        return false;
    }
    let mut i: usize = 0;
    while i < a_len {
        if (unsafe { *(a + i) }) != (unsafe { *(b + i) }) {
            return false;
        }
        i = i + 1;
    }
    true
}

fn test_null_guards(a: mut_view<Arena>, ti_ptr: *mut TypeInterner) -> i32 {
