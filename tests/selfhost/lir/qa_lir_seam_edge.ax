@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub struct LirBuilder {
    pub arena: *mut Arena,
    pub interner: *mut TypeInterner,
    pub mir: *const MirBody,
    pub hir: *const HirFile,
    pub str_in: *const StrInterner,
    pub const_table: *const LirConstTable,
    pub slots: *mut LirStackSlot,
    pub slot_count: usize,
    pub vregs: *mut LirVReg,
    pub vreg_count: usize,
    pub vreg_cap: usize,
    pub bbs: *mut LirBb,
    pub bb_count: usize,
    pub bb_cap: usize,
    pub cur_insts: *mut LirInst,
    pub cur_inst_count: usize,
    pub cur_inst_cap: usize,
}

unsafe fn vreg_id_at(base: *mut LirVRegId, idx: usize) -> *mut LirVRegId {
    let off = lir_mul_usize(idx, size_of<LirVRegId>());
    ((base as usize) + off) as *mut LirVRegId
}

// --- String & Symbol Lookup Helpers ---

const LIR_BUILDER_STRS: [242]u8 = [
    // 0..10: "heap_alloc"
    104u8, 101u8, 97u8, 112u8, 95u8, 97u8, 108u8, 108u8, 111u8, 99u8,
    // 10..22: "heap_realloc"
    104u8, 101u8, 97u8, 112u8, 95u8, 114u8, 101u8, 97u8, 108u8, 108u8, 111u8, 99u8,
    // 22..31: "heap_free"
    104u8, 101u8, 97u8, 112u8, 95u8, 102u8, 114u8, 101u8, 101u8,
    // 31..36: "stdio"
    115u8, 116u8, 100u8, 105u8, 111u8,
    // 36..40: "open"
    111u8, 112u8, 101u8, 110u8,
    // 40..44: "read"
    114u8, 101u8, 97u8, 100u8,
    // 44..49: "write"
    119u8, 114u8, 105u8, 116u8, 101u8,
    // 49..54: "close"
    99u8, 108u8, 111u8, 115u8, 101u8,
    // 54..63: "file_size"
    102u8, 105u8, 108u8, 101u8, 95u8, 115u8, 105u8, 122u8, 101u8,
    // 63..73: "args_count"
    97u8, 114u8, 103u8, 115u8, 95u8, 99u8, 111u8, 117u8, 110u8, 116u8,
    // 73..76: "arg"
    97u8, 114u8, 103u8,
    // 76..83: "env_get"
    101u8, 110u8, 118u8, 95u8, 103u8, 101u8, 116u8,
    // 83..91: "exe_path"
    101u8, 120u8, 101u8, 95u8, 112u8, 97u8, 116u8, 104u8,
    // 91..95: "exit"
    101u8, 120u8, 105u8, 116u8,
    // 95..101: "remove"
    114u8, 101u8, 109u8, 111u8, 118u8, 101u8,
    // 101..106: "mkdir"
    109u8, 107u8, 100u8, 105u8, 114u8,
    // 106..114: "metadata"
    109u8, 101u8, 116u8, 97u8, 100u8, 97u8, 116u8, 97u8,
    // 114..122: "dir_open"
    100u8, 105u8, 114u8, 95u8, 111u8, 112u8, 101u8, 110u8,
    // 122..130: "dir_next"
    100u8, 105u8, 114u8, 95u8, 110u8, 101u8, 120u8, 116u8,
    // 130..139: "dir_close"
    100u8, 105u8, 114u8, 95u8, 99u8, 108u8, 111u8, 115u8, 101u8,
    // 139..151: "monotonic_ns"
    109u8, 111u8, 110u8, 111u8, 116u8, 111u8, 110u8, 105u8, 99u8, 95u8, 110u8, 115u8,
    // 151..160: "intrinsic"
    105u8, 110u8, 116u8, 114u8, 105u8, 110u8, 115u8, 105u8, 99u8,
    // 160..164: "link"
    108u8, 105u8, 110u8, 107u8,
    // 164..174: "__ax_host_"
    95u8, 95u8, 97u8, 120u8, 95u8, 104u8, 111u8, 115u8, 116u8, 95u8,
    // 174..187: "KERNEL32.dll$"
    75u8, 69u8, 82u8, 78u8, 69u8, 76u8, 51u8, 50u8, 46u8, 100u8, 108u8, 108u8, 36u8,
    // 187..195: "__ax_fn_"
    95u8, 95u8, 97u8, 120u8, 95u8, 102u8, 110u8, 95u8,
    // 195..203: ".Lconst_"
    46u8, 76u8, 99u8, 111u8, 110u8, 115u8, 116u8, 95u8,
    // 203..207: "Drop"
    68u8, 114u8, 111u8, 112u8,
    // 207..222: "__ax_host_print" (null-terminated 16 bytes -> 207..223)
    95u8, 95u8, 97u8, 120u8, 95u8, 104u8, 111u8, 115u8, 116u8, 95u8, 112u8, 114u8, 105u8, 110u8, 116u8, 0u8,
    // 223..242: "__ax_host_print_int" (null-terminated 20 bytes -> 223..243? Wait: 19 + 1 = 20 -> 243)
    95u8, 95u8, 97u8, 120u8, 95u8, 104u8, 111u8, 115u8, 116u8, 95u8, 112u8, 114u8, 105u8, 110u8, 116u8, 95u8, 105u8, 110u8, 116u8,
];

fn lb_sv_eq_tbl(sv: view<StrView>, off: usize, count: usize) -> bool {
    if sv.len != count {
        return false;
    }
    let mut i: usize = 0;
    while i < count {
        if (unsafe { *(sv.ptr + i) }) != LIR_BUILDER_STRS[off + i] {
            return false;
        }
        i = i + 1;
    }
    true
}

fn lb_sv_eq(a: view<StrView>, b: view<StrView>) -> bool {
    if a.len != b.len {
        return false;
    }
    let mut i: usize = 0;
    while i < a.len {
        if (unsafe { *(a.ptr + i) }) != (unsafe { *(b.ptr + i) }) {
            return false;
        }
        i = i + 1;
    }
    true
}

fn is_host_intrinsic_name(name: view<StrView>) -> bool {
    intrinsic_is_host(StrView { ptr: name.ptr, len: name.len })
}

fn lb_alloc_cstr(arena: *mut Arena, ptr: *const u8, slen: usize) -> StrView {
    let dst = unsafe { arena_alloc_raw(mut_view(*arena), slen + 1, 1) };
    let mut i: usize = 0;
    while i < slen {
        unsafe {
            *(dst + i) = *(ptr + i);
        }
        i = i + 1;
    }
    unsafe {
        *(dst + slen) = 0u8;
    }
    StrView { ptr: dst as *const u8, len: slen }
}

fn lb_alloc_tbl_cstr(arena: *mut Arena, off: usize, slen: usize) -> StrView {
    let dst = unsafe { arena_alloc_raw(mut_view(*arena), slen + 1, 1) };
    let mut i: usize = 0;
    while i < slen {
        unsafe {
            *(dst + i) = LIR_BUILDER_STRS[off + i];
        }
        i = i + 1;
    }
    unsafe {
        *(dst + slen) = 0u8;
    }
    StrView { ptr: dst as *const u8, len: slen }
}

fn lb_alloc_prefixed_cstr(
    arena: *mut Arena,
    pref_off: usize,
    pref_len: usize,
    sv: StrView
) -> StrView {
    let total = pref_len + sv.len;
    let dst = unsafe { arena_alloc_raw(mut_view(*arena), total + 1, 1) };
    let mut i: usize = 0;
    while i < pref_len {
        unsafe {
            *(dst + i) = LIR_BUILDER_STRS[pref_off + i];
        }
        i = i + 1;
    }
    let mut j: usize = 0;
    while j < sv.len {
        unsafe {
            *(dst + pref_len + j) = *(sv.ptr + j);
        }
        j = j + 1;
    }
    unsafe {
        *(dst + total) = 0u8;
    }
    StrView { ptr: dst as *const u8, len: total }
}

fn lb_write_u32_digits(dst: *mut u8, val: u32) -> usize {
    if val == 0u32 {
        unsafe {
            *dst = 48u8;
        }
        return 1;
    }
    let mut digits: [10]u8 = [0u8; 10];
    let mut count: usize = 0;
    let mut n: u32 = val;
    while n > 0u32 {
        digits[count] = ((n % 10u32) as u8) + 48u8;
        n = n / 10u32;
        count = count + 1;
    }
    let mut i: usize = 0;
    while i < count {
        unsafe {
            *(dst + i) = digits[count - 1 - i];
        }
        i = i + 1;
    }
    count
}

fn lb_alloc_sym_u32_cstr(
    arena: *mut Arena,
    pref_off: usize,
    pref_len: usize,
    sym_v: u32,
    has_suffix: bool,
    suffix: StrView
) -> StrView {
    let cap = pref_len + 12 + (if has_suffix { 1 + suffix.len } else { 0 });
    let dst = unsafe { arena_alloc_raw(mut_view(*arena), cap + 1, 1) };
    let mut pos: usize = 0;
    while pos < pref_len {
        unsafe {
            *(dst + pos) = LIR_BUILDER_STRS[pref_off + pos];
        }
        pos = pos + 1;
    }
    let dlen = lb_write_u32_digits(unsafe { dst + pos }, sym_v);
    pos = pos + dlen;
    if has_suffix {
        unsafe {
            *(dst + pos) = 95u8;
        }
        pos = pos + 1;
        let mut j: usize = 0;
        while j < suffix.len {
            unsafe {
                *(dst + pos + j) = *(suffix.ptr + j);
            }
            j = j + 1;
        }
        pos = pos + suffix.len;
    }
    unsafe {
        *(dst + pos) = 0u8;
    }
    StrView { ptr: dst as *const u8, len: pos }
}

fn has_intrinsic_attr(attrs: *mut HirAttr, str_in: *const StrInterner) -> bool {
    let mut attr = attrs;
    while (attr as usize) != 0 {
        let an = unsafe { interner_get(view(*str_in), (*attr).name) };
        if lb_sv_eq_tbl(view(an), 151, 9) {
            return true;
        }
        attr = unsafe { (*attr).next };
    }
    false
}

fn get_fn_sym_name(
    b: view<LirBuilder>,
    sym_v: u32
) -> StrView {
    if sym_v != 0u32 && (b.hir as usize) != 0 && (b.str_in as usize) != 0 {
        let mut it: *mut HirItem = unsafe { (*b.hir).items };
        while (it as usize) != 0 {
            let ik = unsafe { (*it).kind };
            if ik == HIR_ITEM_FN && (unsafe { (*it).symbol.v }) == sym_v {
                let name_id = unsafe { (*it).name };
                if name_id.v != 0u32 {
                    let sv = unsafe { interner_get(view(*b.str_in), name_id) };
                    if has_intrinsic_attr(unsafe { (*it).attrs }, b.str_in) && is_host_intrinsic_name(view(sv)) {
                        return lb_alloc_prefixed_cstr(b.arena, 164, 10, sv);
                    }
                    if (unsafe { (*it).abi.v }) != 0u32 {
                        let mut attr: *mut HirAttr = unsafe { (*it).attrs };
                        while (attr as usize) != 0 {
                            let an = unsafe { interner_get(view(*b.str_in), (*attr).name) };
                            let args: *mut HirAttrArg = unsafe { (*attr).args };
                            if lb_sv_eq_tbl(view(an), 160, 4) && (args as usize) != 0 {
                                let expr: *mut HirExpr = unsafe { (*args).expr };
                                if (expr as usize) != 0 && (unsafe { (*expr).kind }) == HIR_EXPR_LITERAL {
                                    let lptr = unsafe { (*expr).literal.str_ptr };
                                    let llen = unsafe { (*expr).literal.str_len };
                                    if llen > 0 && (lptr as usize) != 0 {
                                        let total = llen + 1 + sv.len;
                                        let dst = unsafe { arena_alloc_raw(mut_view(*b.arena), total + 1, 1) };
                                        let mut i: usize = 0;
                                        while i < llen {
                                            unsafe { *(dst + i) = *(lptr + i); }
                                            i = i + 1;
                                        }
                                        unsafe { *(dst + llen) = 36u8; }
                                        let mut j: usize = 0;
                                        while j < sv.len {
                                            unsafe { *(dst + llen + 1 + j) = *(sv.ptr + j); }
                                            j = j + 1;
                                        }
                                        unsafe { *(dst + total) = 0u8; }
                                        return StrView { ptr: dst as *const u8, len: total };
                                    }
                                }
                            }
                            attr = unsafe { (*attr).next };
                        }
                        return lb_alloc_prefixed_cstr(b.arena, 174, 13, sv);
                    }
                    return lb_alloc_cstr(b.arena, sv.ptr, sv.len);
                }
                break;
            }
            if ik == HIR_ITEM_IMPL || ik == HIR_ITEM_TRAIT {
                let mut m: *mut HirItem = unsafe { (*it).members };
                while (m as usize) != 0 {
                    if (unsafe { (*m).kind }) == HIR_ITEM_FN && (unsafe { (*m).symbol.v }) == sym_v {
                        let mname_id = unsafe { (*m).name };
                        if mname_id.v != 0u32 {
                            let sv = unsafe { interner_get(view(*b.str_in), mname_id) };
                            if has_intrinsic_attr(unsafe { (*m).attrs }, b.str_in) && is_host_intrinsic_name(view(sv)) {
                                return lb_alloc_prefixed_cstr(b.arena, 164, 10, sv);
                            }
                            return lb_alloc_cstr(b.arena, sv.ptr, sv.len);
                        }
                        break;
                    }
                    m = unsafe { (*m).next };
                }
            }
            it = unsafe { (*it).next };
        }
    }
    lb_alloc_sym_u32_cstr(b.arena, 187, 8, sym_v, false, StrView { ptr: 0 as *const u8, len: 0 })
}

fn get_const_table_sym_name(
    b: view<LirBuilder>,
    sym_v: u32
) -> StrView {
    if (b.const_table as usize) != 0 && sym_v != 0u32 {
        let cnt = unsafe { (*b.const_table).count };
        let entries = unsafe { (*b.const_table).entries };
        let mut idx: usize = 0;
        while idx < cnt {
            let entry = unsafe { lir_const_entry_at(entries, idx) };
            if (unsafe { (*entry).sym_v }) == sym_v {
                return StrView {
                    ptr: unsafe { (*entry).sym_name },
                    len: unsafe { (*entry).sym_len },
                };
            }
            idx = idx + 1;
        }
    }
    if sym_v != 0u32 && (b.hir as usize) != 0 && (b.str_in as usize) != 0 {
        let mut it: *mut HirItem = unsafe { (*b.hir).items };
        while (it as usize) != 0 {
            let ik = unsafe { (*it).kind };
            if ik == HIR_ITEM_CONST && (unsafe { (*it).symbol.v }) == sym_v {
                let cname = unsafe { (*it).name };
                if cname.v != 0u32 {
                    let sv = unsafe { interner_get(view(*b.str_in), cname) };
                    return lb_alloc_sym_u32_cstr(b.arena, 195, 8, sym_v, true, sv);
                }
                break;
            }
            if ik == HIR_ITEM_IMPL || ik == HIR_ITEM_TRAIT {
                let mut m: *mut HirItem = unsafe { (*it).members };
                while (m as usize) != 0 {
                    if (unsafe { (*m).kind }) == HIR_ITEM_CONST && (unsafe { (*m).symbol.v }) == sym_v {
                        let mname = unsafe { (*m).name };
                        if mname.v != 0u32 {
                            let sv = unsafe { interner_get(view(*b.str_in), mname) };
                            return lb_alloc_sym_u32_cstr(b.arena, 195, 8, sym_v, true, sv);
                        }
                        break;
                    }
                    m = unsafe { (*m).next };
                }
            }
            it = unsafe { (*it).next };
        }
    }
    lb_alloc_sym_u32_cstr(b.arena, 195, 8, sym_v, false, StrView { ptr: 0 as *const u8, len: 0 })
}

fn find_drop_fn_sym_name(
    b: view<LirBuilder>,
    ty_v: u32
) -> StrView {
    if ty_v == 0u32 || (b.interner as usize) == 0 || (b.hir as usize) == 0 || (b.str_in as usize) == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let ty = unsafe { type_get(view(*b.interner), TypeId { v: ty_v }) };
    if (ty as usize) == 0 || (unsafe { (*ty).kind }) != TY_STRUCT {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let def = unsafe { (*ty).def };
    let m = unsafe {
        mir_find_drop_impl_fn(view(*b.hir), def, 0 as *const SourceDatabase, view(*b.str_in))
    };
    if (m as usize) != 0 {
        let mname = unsafe { (*m).name };
        if mname.v != 0u32 {
            let sv = unsafe { interner_get(view(*b.str_in), mname) };
            return lb_alloc_cstr(b.arena, sv.ptr, sv.len);
        }
        return get_fn_sym_name(b, unsafe { (*m).symbol.v });
    }
    StrView { ptr: 0 as *const u8, len: 0 }
}

// --- Instruction & Basic Block Emission Helpers ---

fn make_vreg(b: mut_view<LirBuilder>, ty_v: u32) -> u32 {
    if b.vreg_count == b.vreg_cap {
        let new_cap: usize = if b.vreg_cap == 0 { 16 } else { b.vreg_cap * 2 };
        let new_bytes = lir_mul_usize(new_cap, size_of<LirVReg>());
        let new_buf = unsafe { arena_alloc_raw(mut_view(*b.arena), new_bytes, align_of<LirVReg>()) as *mut LirVReg };
        if b.vreg_count > 0 && (b.vregs as usize) != 0 {
            let old_bytes = lir_mul_usize(b.vreg_count, size_of<LirVReg>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(b.vregs as *const u8, new_buf as *mut u8, old_bytes);
            }
        }
        b.vregs = new_buf;
        b.vreg_cap = new_cap;
    }
    let id_v = b.vreg_count as u32;
    let vp = unsafe { lir_vreg_at(b.vregs, b.vreg_count) };
    unsafe {
        (*vp).ty.v = ty_v;
    }
    b.vreg_count = b.vreg_count + 1;
    id_v
}

fn push_new_inst(b: mut_view<LirBuilder>, kind: u8) -> *mut LirInst {
    if b.cur_inst_count == b.cur_inst_cap {
        let new_cap: usize = if b.cur_inst_cap == 0 { 16 } else { b.cur_inst_cap * 2 };
        let new_bytes = lir_mul_usize(new_cap, size_of<LirInst>());
        let new_buf = unsafe { arena_alloc_raw(mut_view(*b.arena), new_bytes, align_of<LirInst>()) as *mut LirInst };
        if b.cur_inst_count > 0 && (b.cur_insts as usize) != 0 {
            let old_bytes = lir_mul_usize(b.cur_inst_count, size_of<LirInst>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(b.cur_insts as *const u8, new_buf as *mut u8, old_bytes);
            }
        }
        b.cur_insts = new_buf;
        b.cur_inst_cap = new_cap;
    }
    let dst = unsafe { lir_inst_at(b.cur_insts, b.cur_inst_count) };
    unsafe {
        lir_inst_reset(mut_view(*dst), kind);
    }
    b.cur_inst_count = b.cur_inst_count + 1;
    dst
}

fn add_lir_bb(b: mut_view<LirBuilder>) -> usize {
    if b.bb_count == b.bb_cap {
        let new_cap: usize = if b.bb_cap == 0 { 16 } else { b.bb_cap * 2 };
        let new_bytes = lir_mul_usize(new_cap, size_of<LirBb>());
        let new_buf = unsafe { arena_alloc_raw(mut_view(*b.arena), new_bytes, align_of<LirBb>()) as *mut LirBb };
        if b.bb_count > 0 && (b.bbs as usize) != 0 {
            let old_bytes = lir_mul_usize(b.bb_count, size_of<LirBb>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(b.bbs as *const u8, new_buf as *mut u8, old_bytes);
            }
        }
        b.bbs = new_buf;
        b.bb_cap = new_cap;
    }
    let new_idx = b.bb_count;
    b.bb_count = b.bb_count + 1;
    let bb_ptr = unsafe { lir_bb_at(b.bbs, new_idx) };
    unsafe {
        lir_bb_reset(mut_view(*bb_ptr), new_idx as u32);
    }
    new_idx
}

fn finish_bb_insts(b: mut_view<LirBuilder>, bb_idx: usize) -> *mut LirBb {
    let bb_ptr = unsafe { lir_bb_at(b.bbs, bb_idx) };
    unsafe {
        (*bb_ptr).id.v = bb_idx as u32;
        (*bb_ptr).inst_count = b.cur_inst_count;
    }
    if b.cur_inst_count > 0 {
        let bytes = lir_mul_usize(b.cur_inst_count, size_of<LirInst>());
        let dst_insts = unsafe { arena_alloc_raw(mut_view(*b.arena), bytes, align_of<LirInst>()) as *mut LirInst };
        unsafe {
            ptr_copy_nonoverlapping<u8>(b.cur_insts as *const u8, dst_insts as *mut u8, bytes);
            (*bb_ptr).insts = dst_insts;
        }
    } else {
        unsafe {
            (*bb_ptr).insts = 0 as *mut LirInst;
        }
    }
    b.cur_inst_count = 0;
    bb_ptr
}

fn emit_stack_addr(b: mut_view<LirBuilder>, slot_v: u32) -> u32 {
    let usize_ty = unsafe { (*b.interner).t_usize.v };
    let dest = make_vreg(mut_view(*b), usize_ty);
    let inst = push_new_inst(mut_view(*b), LIR_INST_STACK_ADDR);
    unsafe {
        (*inst).dest.v = dest;
        (*inst).slot.v = slot_v;
    }
    dest
}

fn emit_const(b: mut_view<LirBuilder>, val: u64, ty_v: u32) -> u32 {
    let dest = make_vreg(mut_view(*b), ty_v);
    let inst = push_new_inst(mut_view(*b), LIR_INST_CONST);
    unsafe {
        (*inst).dest.v = dest;
        (*inst).const_val = val;
        (*inst).ty.v = ty_v;
    }
    dest
}

fn emit_load(b: mut_view<LirBuilder>, ptr_v: u32, ty_v: u32) -> u32 {
    let dest = make_vreg(mut_view(*b), ty_v);
    let inst = push_new_inst(mut_view(*b), LIR_INST_LOAD);
    unsafe {
        (*inst).dest.v = dest;
        (*inst).ptr.v = ptr_v;
        (*inst).ty.v = ty_v;
    }
    dest
}

fn emit_store(b: mut_view<LirBuilder>, ptr_v: u32, val_v: u32) {
    let inst = push_new_inst(mut_view(*b), LIR_INST_STORE);
    unsafe {
        (*inst).ptr.v = ptr_v;
        (*inst).val.v = val_v;
    }
}

fn emit_offset(b: mut_view<LirBuilder>, ptr_v: u32, off_v: u32) -> u32 {
    let usize_ty = unsafe { (*b.interner).t_usize.v };
    let dest = make_vreg(mut_view(*b), usize_ty);
    let inst = push_new_inst(mut_view(*b), LIR_INST_ADD);
    unsafe {
        (*inst).dest.v = dest;
        (*inst).lhs.v = ptr_v;
        (*inst).rhs.v = off_v;
    }
    dest
}

fn emit_bin_inst(b: mut_view<LirBuilder>, kind: u8, dest_v: u32, lhs_v: u32, rhs_v: u32) {
    let inst = push_new_inst(mut_view(*b), kind);
    unsafe {
        (*inst).dest.v = dest_v;
        (*inst).lhs.v = lhs_v;
        (*inst).rhs.v = rhs_v;
    }
}

fn emit_fn_addr_inst(b: mut_view<LirBuilder>, dest_v: u32, sym_name: *const u8, sym_len: usize) {
    let inst = push_new_inst(mut_view(*b), LIR_INST_FN_ADDR);
    unsafe {
        (*inst).dest.v = dest_v;
        (*inst).sym_name = sym_name;
        (*inst).sym_len = sym_len;
    }
}

// --- Place, Operand, and Rvalue Lowering ---

fn get_place_type(b: mut_view<LirBuilder>, place: view<MirPlace>) -> u32 {
    let local_decl = unsafe { mir_local_at((*b.mir).locals, place.local.v as usize) };
    let mut ty_v: u32 = unsafe { (*local_decl).ty.v };
    let mut current_variant: u32 = 0xFFFFFFFFu32;
    let mut i: usize = 0;
    while i < place.proj_count {
        let proj = unsafe { mir_proj_at(place.projs, i) };
        let pk = unsafe { (*proj).kind };
        if pk == MIR_PROJ_DEREF {
            let t = unsafe { type_get(view(*b.interner), TypeId { v: ty_v }) };
            if (t as usize) != 0 {
                let tk = unsafe { (*t).kind };
                if tk == TY_PTR || tk == TY_VIEW || tk == TY_MUT_VIEW {
                    ty_v = unsafe { (*t).pointee.v };
                } else if tk == TY_STR {
                    ty_v = unsafe { (*b.interner).t_u8.v };
                }
            }
        } else if pk == MIR_PROJ_FIELD {
            let t = unsafe { type_get(view(*b.interner), TypeId { v: ty_v }) };
            let idx = unsafe { (*proj).field_idx };
            if (t as usize) != 0 {
                let tk = unsafe { (*t).kind };
                if tk == TY_ENUM && current_variant != 0xFFFFFFFFu32 {
                    let vfc = unsafe { *usize_at((*t).variant_field_counts, current_variant as usize) };
                    if (idx as usize) < vfc {
                        let vf = unsafe { *typeid_ptr_at((*t).variant_fields, current_variant as usize) };
                        ty_v = unsafe { (*typeid_at(vf, idx as usize)).v };
                    }
                    current_variant = 0xFFFFFFFFu32;
                } else if tk == TY_STRUCT || tk == TY_TUPLE {
                    if (idx as usize) < (unsafe { (*t).field_count }) {
                        ty_v = unsafe { (*typeid_at((*t).fields, idx as usize)).v };
                    }
                } else if tk == TY_CLOSURE {
                    if idx == 0u32 {
                        ty_v = unsafe { (*b.interner).t_usize.v };
                    } else if (((idx - 1u32) as usize) < (unsafe { (*t).capture_count })) {
                        let cap = unsafe { capture_at((*t).captures, (idx - 1u32) as usize) };
                        ty_v = unsafe { (*cap).ty.v };
                    }
                }
            }
        } else if pk == MIR_PROJ_INDEX {
            let t = unsafe { type_get(view(*b.interner), TypeId { v: ty_v }) };
            if (t as usize) != 0 {
                let tk = unsafe { (*t).kind };
                if tk == TY_ARRAY || tk == TY_SLICE {
                    ty_v = unsafe { (*t).elem.v };
                } else if tk == TY_STR {
                    ty_v = unsafe { (*b.interner).t_u8.v };
                }
            }
        } else if pk == MIR_PROJ_SUB_SLICE {
            let t = unsafe { type_get(view(*b.interner), TypeId { v: ty_v }) };
            let mut elem_ty_v: u32 = 0u32;
            if (t as usize) != 0 {
                let tk = unsafe { (*t).kind };
                if tk == TY_ARRAY || tk == TY_SLICE {
                    elem_ty_v = unsafe { (*t).elem.v };
                } else if tk == TY_STR {
                    elem_ty_v = unsafe { (*b.interner).t_u8.v };
                }
            }
            let slice_ty = unsafe { intern_slice_ty(mut_view(*b.interner), TypeId { v: elem_ty_v }) };
            ty_v = slice_ty.v;
        } else if pk == MIR_PROJ_DOWNCAST {
            current_variant = unsafe { (*proj).variant_idx };
        }
        i = i + 1;
    }
    ty_v
}

fn lower_place_addr(
    b: mut_view<LirBuilder>,
    place: view<MirPlace>,
    out_ty: *mut u32
) -> u32 {
    let usize_ty: u32 = unsafe { (*b.interner).t_usize.v };
    let local_decl = unsafe { mir_local_at((*b.mir).locals, place.local.v as usize) };
    let mut addr: u32 = 0u32;
    if (unsafe { (*local_decl).kind }) == MIR_LOCAL_CONST {
        let sym_v = unsafe { (*local_decl).const_sym.v };
        let sym = get_const_table_sym_name(view(*b), sym_v);
        addr = make_vreg(mut_view(*b), usize_ty);
        emit_fn_addr_inst(mut_view(*b), addr, sym.ptr, sym.len);
    } else {
        addr = emit_stack_addr(mut_view(*b), place.local.v);
    }
    let mut ty_v: u32 = unsafe { (*local_decl).ty.v };
    let mut current_variant: u32 = 0xFFFFFFFFu32;

    let mut i: usize = 0;
    while i < place.proj_count {
        let proj = unsafe { mir_proj_at(place.projs, i) };
        let pk = unsafe { (*proj).kind };
        if pk == MIR_PROJ_DEREF {
            addr = emit_load(mut_view(*b), addr, usize_ty);
            let t = unsafe { type_get(view(*b.interner), TypeId { v: ty_v }) };
            if (t as usize) != 0 {
                let tk = unsafe { (*t).kind };
                if tk == TY_PTR || tk == TY_VIEW || tk == TY_MUT_VIEW {
                    ty_v = unsafe { (*t).pointee.v };
                } else if tk == TY_STR {
                    ty_v = unsafe { (*b.interner).t_u8.v };
                }
            }
        } else if pk == MIR_PROJ_FIELD {
            let t = unsafe { type_get(view(*b.interner), TypeId { v: ty_v }) };
            let idx = unsafe { (*proj).field_idx };
            let mut offset: u32 = 0u32;
            let mut next_ty_v: u32 = 0u32;
            if (t as usize) != 0 {
                let tk = unsafe { (*t).kind };
                if tk == TY_ENUM && current_variant != 0xFFFFFFFFu32 {
                    offset = unsafe { type_enum_field_offset(TypeId { v: ty_v }, current_variant, idx as usize, view(*b.interner)) };
                    let vfc = unsafe { *usize_at((*t).variant_field_counts, current_variant as usize) };
                    if (idx as usize) < vfc {
                        let vf = unsafe { *typeid_ptr_at((*t).variant_fields, current_variant as usize) };
                        next_ty_v = unsafe { (*typeid_at(vf, idx as usize)).v };
                    }
                    current_variant = 0xFFFFFFFFu32;
                } else if tk == TY_STRUCT || tk == TY_TUPLE {
                    offset = unsafe { type_field_offset(TypeId { v: ty_v }, idx as usize, view(*b.interner)) };
                    if (idx as usize) < (unsafe { (*t).field_count }) {
                        next_ty_v = unsafe { (*typeid_at((*t).fields, idx as usize)).v };
                    }
                } else if tk == TY_CLOSURE {
                    offset = unsafe { type_field_offset(TypeId { v: ty_v }, idx as usize, view(*b.interner)) };
                    if idx == 0u32 {
                        next_ty_v = unsafe { (*b.interner).t_usize.v };
                    } else if (((idx - 1u32) as usize) < (unsafe { (*t).capture_count })) {
                        let cap = unsafe { capture_at((*t).captures, (idx - 1u32) as usize) };
                        next_ty_v = unsafe { (*cap).ty.v };
                    }
                }
            }
            ty_v = next_ty_v;
            if offset != 0u32 {
                let dummy_off = emit_const(mut_view(*b), offset as u64, usize_ty);
                addr = emit_offset(mut_view(*b), addr, dummy_off);
            }
        } else if pk == MIR_PROJ_SUB_SLICE {
            let t = unsafe { type_get(view(*b.interner), TypeId { v: ty_v }) };
            let mut elem_ty_v: u32 = 0u32;
            let mut is_array: bool = false;
            if (t as usize) != 0 {
                let tk = unsafe { (*t).kind };
                if tk == TY_ARRAY {
                    elem_ty_v = unsafe { (*t).elem.v };
                    is_array = true;
                } else if tk == TY_SLICE {
                    elem_ty_v = unsafe { (*t).elem.v };
                } else if tk == TY_STR {
                    elem_ty_v = unsafe { (*b.interner).t_u8.v };
                }
            }
            if unsafe { (*proj).has_from } {
                let from_loc = unsafe { (*proj).from_local.v };
                let idx_addr = emit_stack_addr(mut_view(*b), from_loc);
                let idx_val = emit_load(mut_view(*b), idx_addr, usize_ty);
                let fs = unsafe { type_size(TypeId { v: elem_ty_v }, view(*b.interner)) };
                if fs == 1u32 {
                    addr = emit_offset(mut_view(*b), addr, idx_val);
                } else {
                    let dummy_size = emit_const(mut_view(*b), fs as u64, usize_ty);
                    let off = make_vreg(mut_view(*b), usize_ty);
                    emit_bin_inst(mut_view(*b), LIR_INST_MUL, off, idx_val, dummy_size);
                    addr = emit_offset(mut_view(*b), addr, off);
                }
            }
            if is_array {
                let slice_ty = unsafe { intern_slice_ty(mut_view(*b.interner), TypeId { v: elem_ty_v }) };
                ty_v = slice_ty.v;
            }
        } else if pk == MIR_PROJ_INDEX {
            let t = unsafe { type_get(view(*b.interner), TypeId { v: ty_v }) };
            let mut elem_ty_v: u32 = 0u32;
            if (t as usize) != 0 {
                let tk = unsafe { (*t).kind };
                if tk == TY_ARRAY || tk == TY_SLICE {
                    elem_ty_v = unsafe { (*t).elem.v };
                } else if tk == TY_STR {
                    elem_ty_v = unsafe { (*b.interner).t_u8.v };
                }
            }
            let idx_loc = unsafe { (*proj).index_local.v };
            let idx_addr = emit_stack_addr(mut_view(*b), idx_loc);
            let idx_val = emit_load(mut_view(*b), idx_addr, usize_ty);
            let fs = unsafe { type_size(TypeId { v: elem_ty_v }, view(*b.interner)) };
            if fs == 1u32 {
                addr = emit_offset(mut_view(*b), addr, idx_val);
            } else {
                let dummy_size = emit_const(mut_view(*b), fs as u64, usize_ty);
                let off = make_vreg(mut_view(*b), usize_ty);
                emit_bin_inst(mut_view(*b), LIR_INST_MUL, off, idx_val, dummy_size);
                addr = emit_offset(mut_view(*b), addr, off);
            }
            ty_v = elem_ty_v;
        } else if pk == MIR_PROJ_DOWNCAST {
            current_variant = unsafe { (*proj).variant_idx };
        }
        i = i + 1;
    }

    if (out_ty as usize) != 0 {
        unsafe {
            *out_ty = ty_v;
        }
    }
    addr
}

fn emit_const_str(b: mut_view<LirBuilder>, bytes: *const u8, slen: usize, ty_v: u32) -> u32 {
    let dest = make_vreg(mut_view(*b), ty_v);
    let inst = push_new_inst(mut_view(*b), LIR_INST_CONST_STR);
    unsafe {
        (*inst).dest.v = dest;
        (*inst).str_bytes = bytes;
        (*inst).str_len = slen;
    }
    dest
}

fn const_sym_v(op: view<MirOperand>) -> u32 {
    if op.constant.val != 0u64 {
        op.constant.val as u32
    } else {
        op.constant.sym.v
    }
}

fn lower_operand(b: mut_view<LirBuilder>, op: view<MirOperand>) -> u32 {
    if op.kind == MIR_OP_COPY || op.kind == MIR_OP_MOVE {
        let mut place_ty_v: u32 = 0u32;
        let ty_ptr = unsafe { address_of_mut(place_ty_v) };
        let addr = lower_place_addr(mut_view(*b), view(op.place), ty_ptr);
        return emit_load(mut_view(*b), addr, place_ty_v);
    }
    if op.kind == MIR_OP_CONST {
        if op.constant.kind == MIR_CONST_STR {
            return emit_const_str(mut_view(*b), op.constant.str_bytes, op.constant.str_len, op.constant.ty.v);
        }
        let ct = if op.constant.ty.v != 0u32 {
            unsafe { type_get(view(*b.interner), TypeId { v: op.constant.ty.v }) }
        } else {
            0 as *mut AxType
        };
        if (ct as usize) != 0 {
            let ctk = unsafe { (*ct).kind };
            if ctk == TY_FN || ctk == TY_CLOSURE {
                let sym_v = const_sym_v(op);
                let fn_sym = get_fn_sym_name(view(*b), sym_v);
                let dest = make_vreg(mut_view(*b), op.constant.ty.v);
                emit_fn_addr_inst(mut_view(*b), dest, fn_sym.ptr, fn_sym.len);
                return dest;
            }
        }
        return emit_const(mut_view(*b), op.constant.val, op.constant.ty.v);
    }
    0u32
}

fn lower_binop(op: u8, is_signed: bool) -> u8 {
    if op == MIR_BINOP_ADD { return LIR_INST_ADD; }
    if op == MIR_BINOP_SUB { return LIR_INST_SUB; }
    if op == MIR_BINOP_MUL { return LIR_INST_MUL; }
    if op == MIR_BINOP_DIV { return if is_signed { LIR_INST_DIV } else { LIR_INST_UDIV }; }
    if op == MIR_BINOP_REM { return if is_signed { LIR_INST_REM } else { LIR_INST_UREM }; }
    if op == MIR_BINOP_BIT_XOR { return LIR_INST_BIT_XOR; }
    if op == MIR_BINOP_BIT_AND { return LIR_INST_BIT_AND; }
    if op == MIR_BINOP_BIT_OR { return LIR_INST_BIT_OR; }
    if op == MIR_BINOP_SHL { return LIR_INST_SHL; }
    if op == MIR_BINOP_SHR { return if is_signed { LIR_INST_SAR } else { LIR_INST_SHR }; }
    if op == MIR_BINOP_EQ { return LIR_INST_ICMP_EQ; }
    if op == MIR_BINOP_NE { return LIR_INST_ICMP_NE; }
    if op == MIR_BINOP_LT { return if is_signed { LIR_INST_ICMP_SLT } else { LIR_INST_ICMP_ULT }; }
    if op == MIR_BINOP_LE { return if is_signed { LIR_INST_ICMP_SLE } else { LIR_INST_ICMP_ULE }; }
    if op == MIR_BINOP_GT { return if is_signed { LIR_INST_ICMP_SGT } else { LIR_INST_ICMP_UGT }; }
    if op == MIR_BINOP_GE { return if is_signed { LIR_INST_ICMP_SGE } else { LIR_INST_ICMP_UGE }; }
    if op == MIR_BINOP_OFFSET { return LIR_INST_ADD; }
    if op == MIR_BINOP_WRAPPING_ADD { return LIR_INST_ADD; }
    if op == MIR_BINOP_WRAPPING_SUB { return LIR_INST_SUB; }
    if op == MIR_BINOP_WRAPPING_MUL { return LIR_INST_MUL; }
    LIR_INST_ADD
}

fn operand_is_signed(b: mut_view<LirBuilder>, op: view<MirOperand>, out_ty: *mut u32) -> bool {
    let mut op_ty_v: u32 = unsafe { (*b.interner).t_i32.v };
    if op.kind == MIR_OP_COPY || op.kind == MIR_OP_MOVE {
        if op.place.proj_count > 0 {
            op_ty_v = get_place_type(mut_view(*b), view(op.place));
        } else {
            let ldecl = unsafe { mir_local_at((*b.mir).locals, op.place.local.v as usize) };
            op_ty_v = unsafe { (*ldecl).ty.v };
        }
    } else if op.kind == MIR_OP_CONST {
        op_ty_v = op.constant.ty.v;
    }
    if (out_ty as usize) != 0 {
        unsafe { *out_ty = op_ty_v; }
    }
    let t = unsafe { type_get(view(*b.interner), TypeId { v: op_ty_v }) };
    let mut is_signed: bool = true;
    if (t as usize) != 0 {
        let tk = unsafe { (*t).kind };
        if (tk >= TY_U8 && tk <= TY_USIZE) || tk == TY_BOOL || tk == TY_PTR || tk == TY_VIEW || tk == TY_MUT_VIEW {
            is_signed = false;
        }
    }
    is_signed
}

fn lower_rvalue(b: mut_view<LirBuilder>, rv: view<MirRvalue>, dest_ty_v: u32) -> u32 {
    let rvk = rv.kind;
    if rvk == MIR_RVALUE_USE {
        return lower_operand(mut_view(*b), view(rv.use_op));
    }
    if rvk == MIR_RVALUE_REF {
        return lower_place_addr(mut_view(*b), view(rv.place), 0 as *mut u32);
    }
    if rvk == MIR_RVALUE_OVERFLOWS_BINARY_OP {
        let lhs = lower_operand(mut_view(*b), view(rv.lhs));
        let rhs = lower_operand(mut_view(*b), view(rv.rhs));
        let mut op_ty_v: u32 = 0u32;
        let op_ty_ptr = unsafe { address_of_mut(op_ty_v) };
        let is_signed = operand_is_signed(mut_view(*b), view(rv.lhs), op_ty_ptr);
        let bop = rv.bin_op;
        let mut kind: u8 = LIR_INST_SADD_OVERFLOW;
        if bop == MIR_BINOP_ADD {
            kind = if is_signed { LIR_INST_SADD_OVERFLOW } else { LIR_INST_UADD_OVERFLOW };
        } else if bop == MIR_BINOP_SUB {
            kind = if is_signed { LIR_INST_SSUB_OVERFLOW } else { LIR_INST_USUB_OVERFLOW };
        } else if bop == MIR_BINOP_MUL {
            kind = if is_signed { LIR_INST_SMUL_OVERFLOW } else { LIR_INST_UMUL_OVERFLOW };
        } else if bop == MIR_BINOP_DIV {
            kind = if is_signed { LIR_INST_SDIV_OVERFLOW } else { LIR_INST_UDIV_OVERFLOW };
        } else if bop == MIR_BINOP_REM {
            kind = if is_signed { LIR_INST_SREM_OVERFLOW } else { LIR_INST_UREM_OVERFLOW };
        }
        let dest = make_vreg(mut_view(*b), dest_ty_v);
        let bw = (unsafe { type_size(TypeId { v: op_ty_v }, view(*b.interner)) }) * 8u32;
        let inst = push_new_inst(mut_view(*b), kind);
        unsafe {
            (*inst).dest.v = dest;
            (*inst).lhs.v = lhs;
            (*inst).rhs.v = rhs;
            (*inst).bit_width = bw;
        }
        return dest;
    }
    if rvk == MIR_RVALUE_BINARY_OP {
        let lhs = lower_operand(mut_view(*b), view(rv.lhs));
        let rhs = lower_operand(mut_view(*b), view(rv.rhs));
        let is_signed = operand_is_signed(mut_view(*b), view(rv.lhs), 0 as *mut u32);
        let kind = lower_binop(rv.bin_op, is_signed);
        let dest = make_vreg(mut_view(*b), dest_ty_v);
        emit_bin_inst(mut_view(*b), kind, dest, lhs, rhs);
        return dest;
    }
    if rvk == MIR_RVALUE_UNARY_OP {
        let op = lower_operand(mut_view(*b), view(rv.use_op));
        let mut kind: u8 = LIR_INST_NEG;
        if rv.un_op == MIR_UNOP_NOT {
            kind = LIR_INST_NOT;
        } else if rv.un_op == MIR_UNOP_BITNOT {
            kind = LIR_INST_BITNOT;
        }
        let dest = make_vreg(mut_view(*b), dest_ty_v);
        let inst = push_new_inst(mut_view(*b), kind);
        unsafe {
            (*inst).dest.v = dest;
            (*inst).operand.v = op;
        }
        return dest;
    }
    if rvk == MIR_RVALUE_CAST {
        return lower_operand(mut_view(*b), view(rv.use_op));
    }
    if rvk == MIR_RVALUE_DISCRIMINANT {
        let mut src_ty_v: u32 = 0u32;
        let src_ty_ptr = unsafe { address_of_mut(src_ty_v) };
        let addr = lower_place_addr(mut_view(*b), view(rv.place), src_ty_ptr);
        let u32_ty = unsafe { (*b.interner).t_u32.v };
        return emit_load(mut_view(*b), addr, u32_ty);
    }
    if rvk == MIR_RVALUE_LEN {
        let ldecl = unsafe { mir_local_at((*b.mir).locals, rv.place.local.v as usize) };
        let mut place_ty_v: u32 = unsafe { (*ldecl).ty.v };
        let mut i: usize = 0;
        while i < rv.place.proj_count {
            let t = unsafe { type_get(view(*b.interner), TypeId { v: place_ty_v }) };
            let proj = unsafe { mir_proj_at(rv.place.projs, i) };
            let pk = unsafe { (*proj).kind };
            if (t as usize) != 0 {
                let tk = unsafe { (*t).kind };
                if pk == MIR_PROJ_DEREF {
                    if tk == TY_PTR || tk == TY_VIEW || tk == TY_MUT_VIEW {
                        place_ty_v = unsafe { (*t).pointee.v };
                    } else if tk == TY_STR {
                        place_ty_v = unsafe { (*b.interner).t_u8.v };
                    }
                } else if pk == MIR_PROJ_FIELD {
                    let fidx = (unsafe { (*proj).field_idx }) as usize;
                    if tk == TY_TUPLE || tk == TY_STRUCT {
                        place_ty_v = unsafe { (*typeid_at((*t).fields, fidx)).v };
                    }
                } else if pk == MIR_PROJ_INDEX {
                    if tk == TY_ARRAY || tk == TY_SLICE {
                        place_ty_v = unsafe { (*t).elem.v };
                    } else if tk == TY_STR {
                        place_ty_v = unsafe { (*b.interner).t_u8.v };
                    }
                }
            }
            i = i + 1;
        }
        let usize_ty = unsafe { (*b.interner).t_usize.v };
        let t = unsafe { type_get(view(*b.interner), TypeId { v: place_ty_v }) };
        if (t as usize) != 0 {
            let tk = unsafe { (*t).kind };
            if tk == TY_ARRAY {
                return emit_const(mut_view(*b), unsafe { (*t).array_len }, usize_ty);
            }
            if tk == TY_VIEW || tk == TY_MUT_VIEW || tk == TY_STR {
                let mut src_ty_v: u32 = 0u32;
                let src_ty_ptr = unsafe { address_of_mut(src_ty_v) };
                let addr = lower_place_addr(mut_view(*b), view(rv.place), src_ty_ptr);
                let offset = emit_const(mut_view(*b), 8u64, usize_ty);
                let len_addr = emit_offset(mut_view(*b), addr, offset);
                return emit_load(mut_view(*b), len_addr, usize_ty);
            }
            if tk == TY_SLICE {
                return emit_const(mut_view(*b), 0u64, usize_ty);
            }
        }
        return emit_const(mut_view(*b), 0u64, usize_ty);
    }
    if rvk == MIR_RVALUE_AGGREGATE {
        return emit_const(mut_view(*b), 0u64, dest_ty_v);
    }
    let isize_ty = unsafe { (*b.interner).t_isize.v };
    emit_const(mut_view(*b), 0u64, isize_ty)
}

// --- Statement Lowering ---

fn lower_assign_stmt(b: mut_view<LirBuilder>, stmt: view<MirStmt>) {
    let ldecl = unsafe { mir_local_at((*b.mir).locals, stmt.place.local.v as usize) };
    if (unsafe { (*ldecl).kind }) == MIR_LOCAL_CONST {
        return;
    }
    let usize_ty: u32 = unsafe { (*b.interner).t_usize.v };
    let mut dest_ty_v: u32 = unsafe { (*ldecl).ty.v };
    let rvk = stmt.rvalue.kind;

    if rvk == MIR_RVALUE_AGGREGATE {
        let dest_ty_ptr = unsafe { address_of_mut(dest_ty_v) };
        let addr = lower_place_addr(mut_view(*b), view(stmt.place), dest_ty_ptr);
        let ty = unsafe { type_get(view(*b.interner), TypeId { v: dest_ty_v }) };
        let ty_k = if (ty as usize) != 0 { unsafe { (*ty).kind } } else { 0u8 };
        let vidx = stmt.rvalue.variant_idx;
        if (ty as usize) != 0 && ty_k == TY_ENUM {
            let u32_ty = unsafe { (*b.interner).t_u32.v };
            let discr_val = emit_const(mut_view(*b), vidx as u64, u32_ty);
            emit_store(mut_view(*b), addr, discr_val);
        }
        let op_cnt = stmt.rvalue.operand_count;
        let ops = stmt.rvalue.operands;
        let mut k: usize = 0;
        while k < op_cnt {
            let mut offset: u32 = 0u32;
            let mut field_ty_v: u32 = 0u32;
            if (ty as usize) != 0 && ty_k == TY_ENUM {
                offset = unsafe { type_enum_field_offset(TypeId { v: dest_ty_v }, vidx, k, view(*b.interner)) };
                let vfc = unsafe { *usize_at((*ty).variant_field_counts, vidx as usize) };
                if k < vfc {
                    let vf = unsafe { *typeid_ptr_at((*ty).variant_fields, vidx as usize) };
                    field_ty_v = unsafe { (*typeid_at(vf, k)).v };
                }
            } else if (ty as usize) != 0 && (ty_k == TY_STRUCT || ty_k == TY_TUPLE || ty_k == TY_CLOSURE) {
                offset = unsafe { type_field_offset(TypeId { v: dest_ty_v }, k, view(*b.interner)) };
                if (ty_k == TY_STRUCT || ty_k == TY_TUPLE) && k < (unsafe { (*ty).field_count }) {
                    field_ty_v = unsafe { (*typeid_at((*ty).fields, k)).v };
                } else if ty_k == TY_CLOSURE {
                    if k == 0 {
                        field_ty_v = usize_ty;
                    } else if (k - 1) < (unsafe { (*ty).capture_count }) {
                        let cap = unsafe { capture_at((*ty).captures, k - 1) };
                        field_ty_v = unsafe { (*cap).ty.v };
                    }
                }
            } else if (ty as usize) != 0 && ty_k == TY_ARRAY {
                field_ty_v = unsafe { (*ty).elem.v };
                let fa = unsafe { type_align(TypeId { v: field_ty_v }, view(*b.interner)) };
                let fs = unsafe { type_size(TypeId { v: field_ty_v }, view(*b.interner)) };
                let mask = fa - 1u32;
                let stride = (fs + mask) & (0xFFFFFFFFu32 ^ mask);
                offset = ((k as u32) * stride);
            }
            let off_reg = emit_const(mut_view(*b), offset as u64, usize_ty);
            let field_addr = emit_offset(mut_view(*b), addr, off_reg);

            let op_ptr = unsafe { mir_op_at(ops, k) };
            let mut field_val: u32 = 0u32;
            if (ty as usize) != 0 && ty_k == TY_CLOSURE && k == 0 && (unsafe { (*op_ptr).kind }) == MIR_OP_CONST {
                let sym_v = unsafe { const_sym_v(view(*op_ptr)) };
                let fn_sym = get_fn_sym_name(view(*b), sym_v);
                field_val = make_vreg(mut_view(*b), usize_ty);
                emit_fn_addr_inst(mut_view(*b), field_val, fn_sym.ptr, fn_sym.len);
            } else {
                field_val = unsafe { lower_operand(mut_view(*b), view(*op_ptr)) };
            }
            if field_ty_v != 0u32 {
                let vp = unsafe { lir_vreg_at(b.vregs, field_val as usize) };
                unsafe { (*vp).ty.v = field_ty_v; }
            }
            emit_store(mut_view(*b), field_addr, field_val);
            k = k + 1;
        }
        return;
    }

    if rvk == MIR_RVALUE_REPEAT {
        let dest_ty_ptr = unsafe { address_of_mut(dest_ty_v) };
        let addr = lower_place_addr(mut_view(*b), view(stmt.place), dest_ty_ptr);
        let ty = unsafe { type_get(view(*b.interner), TypeId { v: dest_ty_v }) };
        if (ty as usize) != 0 && (unsafe { (*ty).kind }) == TY_ARRAY {
            let elem_ty_v: u32 = unsafe { (*ty).elem.v };
            let fa = unsafe { type_align(TypeId { v: elem_ty_v }, view(*b.interner)) };
            let fs = unsafe { type_size(TypeId { v: elem_ty_v }, view(*b.interner)) };
            let mask = fa - 1u32;
            let stride = (fs + mask) & (0xFFFFFFFFu32 ^ mask);
            let count = unsafe { (*ty).array_len };
            let elem_val = lower_operand(mut_view(*b), view(stmt.rvalue.use_op));
            if elem_ty_v != 0u32 {
                let vp = unsafe { lir_vreg_at(b.vregs, elem_val as usize) };
                unsafe { (*vp).ty.v = elem_ty_v; }
            }
            let off_reg = make_vreg(mut_view(*b), usize_ty);
            let elem_addr = make_vreg(mut_view(*b), usize_ty);
            let mut k: u64 = 0u64;
            while k < count {
                let offset: u32 = (k as u32) * stride;
                let cinst = push_new_inst(mut_view(*b), LIR_INST_CONST);
                unsafe {
                    (*cinst).dest.v = off_reg;
                    (*cinst).const_val = offset as u64;
                    (*cinst).ty.v = usize_ty;
                }
                emit_bin_inst(mut_view(*b), LIR_INST_ADD, elem_addr, addr, off_reg);
                emit_store(mut_view(*b), elem_addr, elem_val);
                k = k + 1u64;
            }
        }
        return;
    }

    if rvk == MIR_RVALUE_REF {
        let ty = unsafe { type_get(view(*b.interner), TypeId { v: dest_ty_v }) };
        if (ty as usize) != 0 {
            let tk = unsafe { (*ty).kind };
            if tk == TY_VIEW || tk == TY_MUT_VIEW {
                let pointee = unsafe { type_get(view(*b.interner), TypeId { v: (*ty).pointee.v }) };
                if (pointee as usize) != 0 {
                    let ptk = unsafe { (*pointee).kind };
                    if ptk == TY_SLICE || ptk == TY_STR {
                        let addr = lower_place_addr(mut_view(*b), view(stmt.place), 0 as *mut u32);
                        let mut src_ty_v: u32 = 0u32;
                        let src_ty_ptr = unsafe { address_of_mut(src_ty_v) };
                        let ptr_val = lower_place_addr(mut_view(*b), view(stmt.rvalue.place), src_ty_ptr);
                        emit_store(mut_view(*b), addr, ptr_val);

                        let mut len_reg: u32 = 0u32;
                        let src_t = unsafe { type_get(view(*b.interner), TypeId { v: src_ty_v }) };
                        let rplace_pcnt = stmt.rvalue.place.proj_count;
                        let rplace_projs = stmt.rvalue.place.projs;
                        let is_last_subslice: bool = if rplace_pcnt > 0 {
                            (unsafe { (*mir_proj_at(rplace_projs, rplace_pcnt - 1)).kind }) == MIR_PROJ_SUB_SLICE
                        } else {
                            false
                        };
                        if is_last_subslice {
                            let sub_slice = unsafe { mir_proj_at(rplace_projs, rplace_pcnt - 1) };
                            let mut from_val = emit_const(mut_view(*b), 0u64, usize_ty);
                            if unsafe { (*sub_slice).has_from } {
                                let idx_addr = emit_stack_addr(mut_view(*b), unsafe { (*sub_slice).from_local.v });
                                from_val = emit_load(mut_view(*b), idx_addr, usize_ty);
                            }
                            let mut to_val = emit_const(mut_view(*b), 0u64, usize_ty);
                            if unsafe { (*sub_slice).has_to } {
                                let idx_addr = emit_stack_addr(mut_view(*b), unsafe { (*sub_slice).to_local.v });
                                to_val = emit_load(mut_view(*b), idx_addr, usize_ty);
                            } else {
                                let mut base_place = MirPlace {
                                    local: MirLocalId { v: 0u32 },
                                    region: 0u8,
                                    view_kind: 0u8,
                                    projs: 0 as *mut MirProjection,
                                    proj_count: 0,
                                    drop_flag: 0u32,
                                };
                                mir_copy_place(mut_view(base_place), view(stmt.rvalue.place));
                                base_place.proj_count = base_place.proj_count - 1;
                                if base_place.proj_count > 0 {
                                    let prev_p = unsafe { mir_proj_at(base_place.projs, base_place.proj_count - 1) };
                                    if (unsafe { (*prev_p).kind }) == MIR_PROJ_DEREF {
                                        base_place.proj_count = base_place.proj_count - 1;
                                    }
                                }
                                let mut base_ty_v: u32 = 0u32;
                                let base_ty_ptr = unsafe { address_of_mut(base_ty_v) };
                                let base_addr = lower_place_addr(mut_view(*b), view(base_place), base_ty_ptr);
                                let base_t = unsafe { type_get(view(*b.interner), TypeId { v: base_ty_v }) };
                                if (base_t as usize) != 0 && (unsafe { (*base_t).kind }) == TY_ARRAY {
                                    to_val = emit_const(mut_view(*b), unsafe { (*base_t).array_len }, usize_ty);
                                } else {
                                    let off8 = emit_const(mut_view(*b), 8u64, usize_ty);
                                    let len_addr = emit_offset(mut_view(*b), base_addr, off8);
                                    to_val = emit_load(mut_view(*b), len_addr, usize_ty);
                                }
                            }
                            len_reg = make_vreg(mut_view(*b), usize_ty);
                            emit_bin_inst(mut_view(*b), LIR_INST_SUB, len_reg, to_val, from_val);
                        } else if (src_t as usize) != 0 && (unsafe { (*src_t).kind }) == TY_ARRAY {
                            len_reg = emit_const(mut_view(*b), unsafe { (*src_t).array_len }, usize_ty);
                        } else if (src_t as usize) != 0 && ((unsafe { (*src_t).kind }) == TY_VIEW || (unsafe { (*src_t).kind }) == TY_MUT_VIEW || (unsafe { (*src_t).kind }) == TY_STR || (unsafe { (*src_t).kind }) == TY_SLICE) {
                            let src_addr = lower_place_addr(mut_view(*b), view(stmt.rvalue.place), 0 as *mut u32);
                            let off8 = emit_const(mut_view(*b), 8u64, usize_ty);
                            let len_addr = emit_offset(mut_view(*b), src_addr, off8);
                            len_reg = emit_load(mut_view(*b), len_addr, usize_ty);
                        } else {
                            len_reg = emit_const(mut_view(*b), 0u64, usize_ty);
                        }
                        let off8 = emit_const(mut_view(*b), 8u64, usize_ty);
                        let len_dest = emit_offset(mut_view(*b), addr, off8);
                        emit_store(mut_view(*b), len_dest, len_reg);
                        return;
                    }
                }
            }
        }
    }

    let target_ty_v: u32 = if stmt.place.proj_count > 0 {
        get_place_type(mut_view(*b), view(stmt.place))
    } else {
        dest_ty_v
    };
    let val = lower_rvalue(mut_view(*b), view(stmt.rvalue), target_ty_v);
    if target_ty_v != 0u32 {
        let vp = unsafe { lir_vreg_at(b.vregs, val as usize) };
        unsafe { (*vp).ty.v = target_ty_v; }
    }
    let addr = lower_place_addr(mut_view(*b), view(stmt.place), 0 as *mut u32);
    emit_store(mut_view(*b), addr, val);
}

// --- Call Terminator Lowering ---

fn finish_jmp_bb(b: mut_view<LirBuilder>, bb_idx: usize, target_v: u32) {
    let bb_ptr = finish_bb_insts(mut_view(*b), bb_idx);
    unsafe {
        lir_term_reset(mut_view((*bb_ptr).term), LIR_TERM_JMP);
        (*bb_ptr).term.jmp_target.v = target_v;
    }
}

fn finish_switch1_bb(b: mut_view<LirBuilder>, bb_idx: usize, cond_v: u32, val: u64, tgt_v: u32, otherwise_v: u32) {
    let sw = unsafe { arena_alloc_raw(mut_view(*b.arena), size_of<LirSwitchTarget>(), align_of<LirSwitchTarget>()) as *mut LirSwitchTarget };
    unsafe {
        (*sw).val = val;
        (*sw).target.v = tgt_v;
    }
    let bb_ptr = finish_bb_insts(mut_view(*b), bb_idx);
    unsafe {
        lir_term_reset(mut_view((*bb_ptr).term), LIR_TERM_SWITCH);
        (*bb_ptr).term.cond.v = cond_v;
        (*bb_ptr).term.targets = sw;
        (*bb_ptr).term.count = 1;
        (*bb_ptr).term.otherwise.v = otherwise_v;
    }
}

fn lower_arg_at(b: mut_view<LirBuilder>, args: *mut MirOperand, idx: usize) -> u32 {
    let op_ptr = unsafe { mir_op_at(args, idx) };
    unsafe { lower_operand(mut_view(*b), view(*op_ptr)) }
}

fn lower_call_terminator(b: mut_view<LirBuilder>, mbb: *const MirBb, bb_idx: usize) {
    let usize_ty: u32 = unsafe { (*b.interner).t_usize.v };
    let bool_ty: u32 = unsafe { (*b.interner).t_bool.v };
    let u8_ty: u32 = unsafe { (*b.interner).t_u8.v };
    let unit_ty: u32 = unsafe { (*b.interner).t_unit.v };

    let func_op = unsafe { view((*mbb).terminator.func) };
    let args = unsafe { (*mbb).terminator.args };
    let arg_count = unsafe { (*mbb).terminator.arg_count };
    let dest_place = unsafe { view((*mbb).terminator.destination) };
    let call_target_v = unsafe { (*mbb).terminator.call_target.v };

    let mut callee_ty_v: u32 = 0u32;
    if func_op.kind == MIR_OP_CONST {
        callee_ty_v = func_op.constant.ty.v;
    } else {
        let ldecl = unsafe { mir_local_at((*b.mir).locals, func_op.place.local.v as usize) };
        callee_ty_v = unsafe { (*ldecl).ty.v };
    }
    let cty = if callee_ty_v != 0u32 {
        unsafe { type_get(view(*b.interner), TypeId { v: callee_ty_v }) }
    } else {
        0 as *mut AxType
    };
    let cty_k = if (cty as usize) != 0 { unsafe { (*cty).kind } } else { 0u8 };

    if (cty as usize) != 0 && (cty_k == TY_BUILTIN_PTR_ADD || cty_k == TY_BUILTIN_PTR_SUB) {
        let p = lower_arg_at(mut_view(*b), args, 0);
        let count = lower_arg_at(mut_view(*b), args, 1);
        let elem_ty_v = const_sym_v(func_op);
        let mut elem_sz = unsafe { type_size(TypeId { v: elem_ty_v }, view(*b.interner)) };
        if elem_sz == 0u32 { elem_sz = 1u32; }
        let mut offset = count;
        if elem_sz != 1u32 {
            let sz_reg = emit_const(mut_view(*b), elem_sz as u64, usize_ty);
            offset = make_vreg(mut_view(*b), usize_ty);
            emit_bin_inst(mut_view(*b), LIR_INST_MUL, offset, count, sz_reg);
        }
        let res = make_vreg(mut_view(*b), usize_ty);
        let op_k = if cty_k == TY_BUILTIN_PTR_ADD { LIR_INST_ADD } else { LIR_INST_SUB };
        emit_bin_inst(mut_view(*b), op_k, res, p, offset);
        let dst_addr = lower_place_addr(mut_view(*b), dest_place, 0 as *mut u32);
        emit_store(mut_view(*b), dst_addr, res);
        finish_jmp_bb(mut_view(*b), bb_idx, call_target_v);
        return;
    }

    if (cty as usize) != 0 && cty_k == TY_BUILTIN_NEEDS_DROP {
        let elem_ty_v = const_sym_v(func_op);
        let mut nd = false;
        if (b.interner as usize) != 0 {
            let tmp_thir = unsafe { arena_alloc_raw(mut_view(*b.arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir };
            unsafe {
                ptr_copy_nonoverlapping<u8>(b.interner as *const u8, tmp_thir as *mut u8, size_of<TypeInterner>());
                (*tmp_thir).expr_methods.cap = 0;
            }
            nd = unsafe {
                mir_type_needs_drop(TypeId { v: elem_ty_v }, view(*tmp_thir), view(*b.hir), view(*b.str_in))
            };
        }
        let val = emit_const(mut_view(*b), if nd { 1u64 } else { 0u64 }, bool_ty);
        let dst_addr = lower_place_addr(mut_view(*b), dest_place, 0 as *mut u32);
        emit_store(mut_view(*b), dst_addr, val);
        finish_jmp_bb(mut_view(*b), bb_idx, call_target_v);
        return;
    }

    if (cty as usize) != 0 && cty_k == TY_BUILTIN_DROP_IN_PLACE {
        let elem_ty_v = const_sym_v(func_op);
        let drop_sym = find_drop_fn_sym_name(view(*b), elem_ty_v);
        if (drop_sym.ptr as usize) != 0 {
            let p = lower_arg_at(mut_view(*b), args, 0);
            let arg_inst = push_new_inst(mut_view(*b), LIR_INST_ABI_ARG);
            unsafe {
                (*arg_inst).dest.v = LIR_VREG_NONE;
                (*arg_inst).index = 0u32;
                (*arg_inst).val.v = p;
            }

            let mut param_ty = TypeId { v: usize_ty };
            let param_ty_ptr = unsafe { address_of_mut(param_ty.v) as *mut TypeId };
            let callee_drop_ty = unsafe {
                intern_fn_ty(mut_view(*b.interner), false, StrId { v: 0u32 }, param_ty_ptr, 1, TypeId { v: unit_ty })
            };
            let call_inst = push_new_inst(mut_view(*b), LIR_INST_CALL);
            unsafe {
                (*call_inst).sym_name = drop_sym.ptr;
                (*call_inst).sym_len = drop_sym.len;
                (*call_inst).callee_ty.v = callee_drop_ty.v;
                (*call_inst).dst_addr.v = LIR_VREG_NONE;
                (*call_inst).callee_vreg.v = LIR_VREG_NONE;
            }
        }
        finish_jmp_bb(mut_view(*b), bb_idx, call_target_v);
        return;
    }

    if (cty as usize) != 0 && cty_k == TY_BUILTIN_PTR_WRITE_BYTES {
        let dst = lower_arg_at(mut_view(*b), args, 0);
        let val = lower_arg_at(mut_view(*b), args, 1);
        let val_vp = unsafe { lir_vreg_at(b.vregs, val as usize) };
        unsafe { (*val_vp).ty.v = u8_ty; }
        let count = lower_arg_at(mut_view(*b), args, 2);
        let elem_ty_v = const_sym_v(func_op);
        let mut elem_sz = unsafe { type_size(TypeId { v: elem_ty_v }, view(*b.interner)) };
        if elem_sz == 0u32 { elem_sz = 1u32; }
        let mut total_bytes = count;
        if elem_sz != 1u32 {
            let sz_reg = emit_const(mut_view(*b), elem_sz as u64, usize_ty);
            total_bytes = make_vreg(mut_view(*b), usize_ty);
            emit_bin_inst(mut_view(*b), LIR_INST_MUL, total_bytes, count, sz_reg);
        }
        let idx = make_vreg(mut_view(*b), usize_ty);
        let zero = emit_const(mut_view(*b), 0u64, usize_ty);
        emit_bin_inst(mut_view(*b), LIR_INST_ADD, idx, zero, zero);

        let head_bb = add_lir_bb(mut_view(*b));
        let body_bb = add_lir_bb(mut_view(*b));
        finish_jmp_bb(mut_view(*b), bb_idx, head_bb as u32);

        let cmp = make_vreg(mut_view(*b), bool_ty);
        emit_bin_inst(mut_view(*b), LIR_INST_ICMP_ULT, cmp, idx, total_bytes);
        finish_switch1_bb(mut_view(*b), head_bb, cmp, 1u64, body_bb as u32, call_target_v);

        let curr_addr = make_vreg(mut_view(*b), usize_ty);
        emit_bin_inst(mut_view(*b), LIR_INST_ADD, curr_addr, dst, idx);
        emit_store(mut_view(*b), curr_addr, val);
        let one = emit_const(mut_view(*b), 1u64, usize_ty);
        emit_bin_inst(mut_view(*b), LIR_INST_ADD, idx, idx, one);
        finish_jmp_bb(mut_view(*b), body_bb, head_bb as u32);
        return;
    }

    if (cty as usize) != 0 && cty_k == TY_BUILTIN_PTR_COPY_NONOVERLAPPING {
        let src = lower_arg_at(mut_view(*b), args, 0);
        let dst = lower_arg_at(mut_view(*b), args, 1);
        let count = lower_arg_at(mut_view(*b), args, 2);
        let elem_ty_v = const_sym_v(func_op);
        let mut elem_sz = unsafe { type_size(TypeId { v: elem_ty_v }, view(*b.interner)) };
        if elem_sz == 0u32 { elem_sz = 1u32; }
        let mut total_bytes = count;
        if elem_sz != 1u32 {
            let sz_reg = emit_const(mut_view(*b), elem_sz as u64, usize_ty);
            total_bytes = make_vreg(mut_view(*b), usize_ty);
            emit_bin_inst(mut_view(*b), LIR_INST_MUL, total_bytes, count, sz_reg);
        }
        let idx = make_vreg(mut_view(*b), usize_ty);
        let zero = emit_const(mut_view(*b), 0u64, usize_ty);
        emit_bin_inst(mut_view(*b), LIR_INST_ADD, idx, zero, zero);

        let head_bb = add_lir_bb(mut_view(*b));
        let body_bb = add_lir_bb(mut_view(*b));
        finish_jmp_bb(mut_view(*b), bb_idx, head_bb as u32);

        let cmp = make_vreg(mut_view(*b), bool_ty);
        emit_bin_inst(mut_view(*b), LIR_INST_ICMP_ULT, cmp, idx, total_bytes);
        finish_switch1_bb(mut_view(*b), head_bb, cmp, 1u64, body_bb as u32, call_target_v);

        let src_curr = make_vreg(mut_view(*b), usize_ty);
        emit_bin_inst(mut_view(*b), LIR_INST_ADD, src_curr, src, idx);
        let byte_val = emit_load(mut_view(*b), src_curr, u8_ty);
        let dst_curr = make_vreg(mut_view(*b), usize_ty);
        emit_bin_inst(mut_view(*b), LIR_INST_ADD, dst_curr, dst, idx);
        emit_store(mut_view(*b), dst_curr, byte_val);
        let one = emit_const(mut_view(*b), 1u64, usize_ty);
        emit_bin_inst(mut_view(*b), LIR_INST_ADD, idx, idx, one);
        finish_jmp_bb(mut_view(*b), body_bb, head_bb as u32);
        return;
    }

    if (cty as usize) != 0 && cty_k == TY_BUILTIN_PTR_COPY {
        let src = lower_arg_at(mut_view(*b), args, 0);
        let dst = lower_arg_at(mut_view(*b), args, 1);
        let count = lower_arg_at(mut_view(*b), args, 2);
        let elem_ty_v = const_sym_v(func_op);
        let mut elem_sz = unsafe { type_size(TypeId { v: elem_ty_v }, view(*b.interner)) };
        if elem_sz == 0u32 { elem_sz = 1u32; }
        let mut total_bytes = count;
        if elem_sz != 1u32 {
            let sz_reg = emit_const(mut_view(*b), elem_sz as u64, usize_ty);
            total_bytes = make_vreg(mut_view(*b), usize_ty);
            emit_bin_inst(mut_view(*b), LIR_INST_MUL, total_bytes, count, sz_reg);
        }
        let is_bwd = make_vreg(mut_view(*b), bool_ty);
        emit_bin_inst(mut_view(*b), LIR_INST_ICMP_ULT, is_bwd, src, dst);

        let bwd_setup_bb = add_lir_bb(mut_view(*b));
        let bwd_head_bb = add_lir_bb(mut_view(*b));
        let bwd_body_bb = add_lir_bb(mut_view(*b));
        let fwd_setup_bb = add_lir_bb(mut_view(*b));
        let fwd_head_bb = add_lir_bb(mut_view(*b));
        let fwd_body_bb = add_lir_bb(mut_view(*b));

        finish_switch1_bb(mut_view(*b), bb_idx, is_bwd, 1u64, bwd_setup_bb as u32, fwd_setup_bb as u32);

        let bwd_idx = make_vreg(mut_view(*b), usize_ty);
        let zero_b = emit_const(mut_view(*b), 0u64, usize_ty);
        emit_bin_inst(mut_view(*b), LIR_INST_ADD, bwd_idx, total_bytes, zero_b);
        finish_jmp_bb(mut_view(*b), bwd_setup_bb, bwd_head_bb as u32);

        let cmp_zero = emit_const(mut_view(*b), 0u64, usize_ty);
        let bwd_cmp = make_vreg(mut_view(*b), bool_ty);
        emit_bin_inst(mut_view(*b), LIR_INST_ICMP_UGT, bwd_cmp, bwd_idx, cmp_zero);
        finish_switch1_bb(mut_view(*b), bwd_head_bb, bwd_cmp, 1u64, bwd_body_bb as u32, call_target_v);

        let one_b = emit_const(mut_view(*b), 1u64, usize_ty);
        emit_bin_inst(mut_view(*b), LIR_INST_SUB, bwd_idx, bwd_idx, one_b);
        let s_addr_b = make_vreg(mut_view(*b), usize_ty);
        emit_bin_inst(mut_view(*b), LIR_INST_ADD, s_addr_b, src, bwd_idx);
        let b_val_b = emit_load(mut_view(*b), s_addr_b, u8_ty);
        let d_addr_b = make_vreg(mut_view(*b), usize_ty);
        emit_bin_inst(mut_view(*b), LIR_INST_ADD, d_addr_b, dst, bwd_idx);
        emit_store(mut_view(*b), d_addr_b, b_val_b);
        finish_jmp_bb(mut_view(*b), bwd_body_bb, bwd_head_bb as u32);

        let fwd_idx = make_vreg(mut_view(*b), usize_ty);
        let zero_f = emit_const(mut_view(*b), 0u64, usize_ty);
        emit_bin_inst(mut_view(*b), LIR_INST_ADD, fwd_idx, zero_f, zero_f);
        finish_jmp_bb(mut_view(*b), fwd_setup_bb, fwd_head_bb as u32);

        let fwd_cmp = make_vreg(mut_view(*b), bool_ty);
        emit_bin_inst(mut_view(*b), LIR_INST_ICMP_ULT, fwd_cmp, fwd_idx, total_bytes);
        finish_switch1_bb(mut_view(*b), fwd_head_bb, fwd_cmp, 1u64, fwd_body_bb as u32, call_target_v);

        let s_addr_f = make_vreg(mut_view(*b), usize_ty);
        emit_bin_inst(mut_view(*b), LIR_INST_ADD, s_addr_f, src, fwd_idx);
        let b_val_f = emit_load(mut_view(*b), s_addr_f, u8_ty);
        let d_addr_f = make_vreg(mut_view(*b), usize_ty);
        emit_bin_inst(mut_view(*b), LIR_INST_ADD, d_addr_f, dst, fwd_idx);
        emit_store(mut_view(*b), d_addr_f, b_val_f);
        let one_f = emit_const(mut_view(*b), 1u64, usize_ty);
        emit_bin_inst(mut_view(*b), LIR_INST_ADD, fwd_idx, fwd_idx, one_f);
        finish_jmp_bb(mut_view(*b), fwd_body_bb, fwd_head_bb as u32);
        return;
    }

    if (cty as usize) != 0 && cty_k == TY_BUILTIN_SIZE_OF {
        let elem_ty_v = const_sym_v(func_op);
        let sz = unsafe { type_size(TypeId { v: elem_ty_v }, view(*b.interner)) };
        let val = emit_const(mut_view(*b), sz as u64, usize_ty);
        let dst_addr = lower_place_addr(mut_view(*b), dest_place, 0 as *mut u32);
        emit_store(mut_view(*b), dst_addr, val);
        finish_jmp_bb(mut_view(*b), bb_idx, call_target_v);
        return;
    }

    if (cty as usize) != 0 && cty_k == TY_BUILTIN_ALIGN_OF {
        let elem_ty_v = const_sym_v(func_op);
        let al = unsafe { type_align(TypeId { v: elem_ty_v }, view(*b.interner)) };
        let val = emit_const(mut_view(*b), al as u64, usize_ty);
        let dst_addr = lower_place_addr(mut_view(*b), dest_place, 0 as *mut u32);
        emit_store(mut_view(*b), dst_addr, val);
        finish_jmp_bb(mut_view(*b), bb_idx, call_target_v);
        return;
    }

    if (cty as usize) != 0 && (cty_k == TY_BUILTIN_NULL || cty_k == TY_BUILTIN_NULL_MUT) {
        let val = emit_const(mut_view(*b), 0u64, usize_ty);
        let dst_addr = lower_place_addr(mut_view(*b), dest_place, 0 as *mut u32);
        emit_store(mut_view(*b), dst_addr, val);
        finish_jmp_bb(mut_view(*b), bb_idx, call_target_v);
        return;
    }

    if (cty as usize) != 0 && cty_k == TY_BUILTIN_IS_NULL {
        let p = lower_arg_at(mut_view(*b), args, 0);
        let zero = emit_const(mut_view(*b), 0u64, usize_ty);
        let cmp = make_vreg(mut_view(*b), bool_ty);
        emit_bin_inst(mut_view(*b), LIR_INST_ICMP_EQ, cmp, p, zero);
        let dst_addr = lower_place_addr(mut_view(*b), dest_place, 0 as *mut u32);
        emit_store(mut_view(*b), dst_addr, cmp);
        finish_jmp_bb(mut_view(*b), bb_idx, call_target_v);
        return;
    }

    if (cty as usize) != 0 && cty_k == TY_BUILTIN_FORGET {
        finish_jmp_bb(mut_view(*b), bb_idx, call_target_v);
        return;
    }

    let mut cap_count: usize = 0;
    if (cty as usize) != 0 && cty_k == TY_CLOSURE {
        cap_count = unsafe { (*cty).capture_count };
    }

    let mut cap_vals: *mut LirVRegId = 0 as *mut LirVRegId;
    if cap_count > 0 && func_op.kind != MIR_OP_CONST {
        let max_caps = if cap_count < 64 { cap_count } else { 64 };
        cap_vals = unsafe { arena_alloc_raw(mut_view(*b.arena), lir_mul_usize(max_caps, size_of<LirVRegId>()), align_of<LirVRegId>()) as *mut LirVRegId };
        let closure_base = lower_place_addr(mut_view(*b), view(func_op.place), 0 as *mut u32);
        let mut c: usize = 0;
        while c < max_caps {
            let offset = unsafe { type_field_offset(TypeId { v: callee_ty_v }, c + 1, view(*b.interner)) };
            let cap_off = emit_const(mut_view(*b), offset as u64, usize_ty);
            let cap_addr = emit_offset(mut_view(*b), closure_base, cap_off);
            let cap_ptr = unsafe { capture_at((*cty).captures, c) };
            let cap_ty_v = unsafe { (*cap_ptr).ty.v };
            let cv = emit_load(mut_view(*b), cap_addr, cap_ty_v);
            let cv_dst = unsafe { vreg_id_at(cap_vals, c) };
            unsafe { (*cv_dst).v = cv; }
            c = c + 1;
        }
    }

    if (cty as usize) != 0 && cty_k == TY_CLOSURE && (unsafe { (*cty).fn_type.v }) != 0u32 {
        callee_ty_v = unsafe { (*cty).fn_type.v };
    }

    let mut arg_vals: *mut LirVRegId = 0 as *mut LirVRegId;
    if arg_count > 0 {
        arg_vals = unsafe { arena_alloc_raw(mut_view(*b.arena), lir_mul_usize(arg_count, size_of<LirVRegId>()), align_of<LirVRegId>()) as *mut LirVRegId };
        let mut k: usize = 0;
        while k < arg_count {
            let av = lower_arg_at(mut_view(*b), args, k);
            let av_dst = unsafe { vreg_id_at(arg_vals, k) };
            unsafe { (*av_dst).v = av; }
            k = k + 1;
        }
    }

    let mut sym_name: *const u8 = 0 as *const u8;
    let mut sym_len: usize = 0;
    let mut callee_vreg: u32 = LIR_VREG_NONE;

    if func_op.kind == MIR_OP_CONST {
        let sym_v = const_sym_v(func_op);
        let sym_sv = if (cty as usize) != 0 && cty_k == TY_BUILTIN_PRINT {
            lb_alloc_tbl_cstr(b.arena, 207, 15)
        } else if (cty as usize) != 0 && cty_k == TY_BUILTIN_PRINT_INT {
            lb_alloc_tbl_cstr(b.arena, 223, 19)
        } else {
            get_fn_sym_name(view(*b), sym_v)
        };
        sym_name = sym_sv.ptr;
        sym_len = sym_sv.len;
    } else if (cty as usize) != 0 && cty_k == TY_CLOSURE {
        let closure_base = lower_place_addr(mut_view(*b), view(func_op.place), 0 as *mut u32);
        callee_vreg = emit_load(mut_view(*b), closure_base, usize_ty);
    } else {
        callee_vreg = lower_operand(mut_view(*b), func_op);
    }

    let mut dst_ty_v: u32 = 0u32;
    let dst_addr = lower_place_addr(mut_view(*b), dest_place, unsafe { address_of_mut(dst_ty_v) });
    if dst_ty_v == 0u32 {
        let dest_ldecl = unsafe { mir_local_at((*b.mir).locals, dest_place.local.v as usize) };
        dst_ty_v = unsafe { (*dest_ldecl).ty.v };
    }

    let max_caps = if cap_count < 64 { cap_count } else { 64 };
    let total_args = max_caps + arg_count;
    let need_synth_callee_ty = if callee_ty_v == 0u32 {
        true
    } else if (cty as usize) != 0 && cty_k == TY_FN {
        let pcnt = unsafe { (*cty).param_count };
        pcnt == 0 && total_args > 0
    } else {
        false
    };
    if need_synth_callee_ty {
        let mut param_types: *mut TypeId = 0 as *mut TypeId;
        if total_args > 0 {
            let p_bytes = lir_mul_usize(total_args, size_of<TypeId>());
            param_types = unsafe { arena_alloc_raw(mut_view(*b.arena), p_bytes, align_of<TypeId>()) as *mut TypeId };
            let mut c0: usize = 0;
            while c0 < max_caps {
                let cv = unsafe { (*vreg_id_at(cap_vals, c0)).v };
                let vp = unsafe { lir_vreg_at(b.vregs, cv as usize) };
                let dst = unsafe { typeid_at(param_types, c0) };
                unsafe { (*dst).v = (*vp).ty.v; }
                c0 = c0 + 1;
            }
            let mut k2: usize = 0;
            while k2 < arg_count {
                let av = unsafe { (*vreg_id_at(arg_vals, k2)).v };
                let vp = unsafe { lir_vreg_at(b.vregs, av as usize) };
                let dst = unsafe { typeid_at(param_types, max_caps + k2) };
                unsafe { (*dst).v = (*vp).ty.v; }
                k2 = k2 + 1;
            }
        }
        let synth_tid = unsafe {
            intern_fn_ty(
                mut_view(*b.interner),
                false,
                StrId { v: 0u32 },
                param_types,
                total_args,
                TypeId { v: dst_ty_v }
            )
        };
        callee_ty_v = synth_tid.v;
    }

    if (cap_vals as usize) != 0 {
        let mut c: usize = 0;
        while c < max_caps {
            let cv = unsafe { (*vreg_id_at(cap_vals, c)).v };
            let ainst = push_new_inst(mut_view(*b), LIR_INST_ABI_ARG);
            unsafe {
                (*ainst).dest.v = LIR_VREG_NONE;
                (*ainst).index = c as u32;
                (*ainst).val.v = cv;
            }
            c = c + 1;
        }
    }
    let mut k: usize = 0;
    while k < arg_count {
        let av = unsafe { (*vreg_id_at(arg_vals, k)).v };
        let ainst = push_new_inst(mut_view(*b), LIR_INST_ABI_ARG);
        unsafe {
            (*ainst).dest.v = LIR_VREG_NONE;
            (*ainst).index = (cap_count + k) as u32;
            (*ainst).val.v = av;
        }
        k = k + 1;
    }

    let call_inst = push_new_inst(mut_view(*b), LIR_INST_CALL);
    unsafe {
        (*call_inst).sym_name = sym_name;
        (*call_inst).sym_len = sym_len;
        (*call_inst).callee_ty.v = callee_ty_v;
        (*call_inst).dst_addr.v = dst_addr;
        (*call_inst).callee_vreg.v = callee_vreg;
    }

    let res = make_vreg(mut_view(*b), dst_ty_v);
    let rinst = push_new_inst(mut_view(*b), LIR_INST_ABI_RESULT);
    unsafe {
        (*rinst).dest.v = res;
        (*rinst).index = 0u32;
    }
    emit_store(mut_view(*b), dst_addr, res);

    finish_jmp_bb(mut_view(*b), bb_idx, call_target_v);
}

// --- Top-Level MIR-to-LIR Lowering Entrypoints ---

pub fn lir_lower_ext(
    arena: mut_view<Arena>,
    mir: *const MirBody,
    hir: *const HirFile,
    interner: *mut TypeInterner,
    str_in: *const StrInterner,
    const_table: *const LirConstTable,
    fn_ty: *const AxType
) -> *mut LirBody {
    if (mir as usize) == 0 || (interner as usize) == 0 {
        return 0 as *mut LirBody;
    }
    let lir = lir_body_new(mut_view(*arena));
    let arena_ptr = unsafe { (*lir).arena };

    let local_count = unsafe { (*mir).local_count };
    let locals = unsafe { (*mir).locals };
    let mut slots: *mut LirStackSlot = 0 as *mut LirStackSlot;
    if local_count > 0 {
        let slot_bytes = lir_mul_usize(local_count, size_of<LirStackSlot>());
        slots = unsafe { arena_alloc_raw(mut_view(*arena_ptr), slot_bytes, align_of<LirStackSlot>()) as *mut LirStackSlot };
        let mut i: usize = 0;
        while i < local_count {
            let ldecl = unsafe { mir_local_at(locals, i) };
            let sp = unsafe { lir_slot_at(slots, i) };
            unsafe {
                (*sp).ty.v = (*ldecl).ty.v;
                (*sp).is_const = ((*ldecl).kind == MIR_LOCAL_CONST);
            }
            i = i + 1;
        }
    }

    let mir_bb_count = unsafe { (*mir).bb_count };
    let init_bb_cap = mir_bb_count + 64;
    let init_bb_bytes = lir_mul_usize(init_bb_cap, size_of<LirBb>());
    let bbs_buf = arena_alloc_raw(mut_view(*arena), init_bb_bytes, align_of<LirBb>()) as *mut LirBb;
    let mut bi: usize = 0;
    while bi < init_bb_cap {
        let bbp = unsafe { lir_bb_at(bbs_buf, bi) };
        unsafe { lir_bb_reset(mut_view(*bbp), bi as u32); }
        bi = bi + 1;
    }

    let mut b = LirBuilder {
        arena: arena_ptr,
        interner: interner,
        mir: mir,
        hir: hir,
        str_in: str_in,
        const_table: const_table,
        slots: slots,
        slot_count: local_count,
        vregs: 0 as *mut LirVReg,
        vreg_count: 0,
        vreg_cap: 0,
        bbs: bbs_buf,
        bb_count: mir_bb_count,
        bb_cap: init_bb_cap,
        cur_insts: 0 as *mut LirInst,
        cur_inst_count: 0,
        cur_inst_cap: 0,
    };

    let mut i: usize = 0;
    while i < mir_bb_count {
        let mbb = unsafe { mir_bb_at((*mir).bbs, i) };
        b.cur_inst_count = 0;

        if i == 0 && (fn_ty as usize) != 0 {
            let mut fty = fn_ty;
            if (unsafe { (*fty).kind }) == TY_CLOSURE && (unsafe { (*fty).fn_type.v }) != 0u32 {
                fty = unsafe { type_get(view(*b.interner), TypeId { v: (*fty).fn_type.v }) as *const AxType };
            }
            if (fty as usize) != 0 && (unsafe { (*fty).kind }) == TY_FN {
                let pcnt = unsafe { (*fty).param_count };
                let ptypes = unsafe { (*fty).param_types };
                let mut p: usize = 0;
                while p < pcnt {
                    let pty_v = unsafe { (*typeid_at(ptypes, p)).v };
                    let dest = make_vreg(mut_view(b), pty_v);
                    let ainst = push_new_inst(mut_view(b), LIR_INST_ABI_ARG);
                    unsafe {
                        (*ainst).dest.v = dest;
                        (*ainst).index = p as u32;
                    }
                    let addr = emit_stack_addr(mut_view(b), (p + 1) as u32);
                    emit_store(mut_view(b), addr, dest);
                    p = p + 1;
                }
            }
        }

        let stmt_cnt = unsafe { (*mbb).stmt_count };
        let stmts = unsafe { (*mbb).stmts };
        let mut j: usize = 0;
        while j < stmt_cnt {
            let stmt = unsafe { mir_stmt_at(stmts, j) };
            if (unsafe { (*stmt).kind }) == MIR_STMT_ASSIGN {
                unsafe {
                    lower_assign_stmt(mut_view(b), view(*stmt));
                }
            }
            j = j + 1;
        }

        let tk = unsafe { (*mbb).terminator.kind };
        if tk == MIR_TERM_CALL {
            lower_call_terminator(mut_view(b), mbb as *const MirBb, i);
            i = i + 1;
            continue;
        }

        if tk == MIR_TERM_GOTO {
            let bb_ptr = finish_bb_insts(mut_view(b), i);
            unsafe {
                lir_term_reset(mut_view((*bb_ptr).term), LIR_TERM_JMP);
                (*bb_ptr).term.jmp_target.v = (*mbb).terminator.goto_target.v;
            }
        } else if tk == MIR_TERM_SWITCH_INT {
            let cond = unsafe { lower_operand(mut_view(b), view((*mbb).terminator.discr)) };
            let scnt = unsafe { (*mbb).terminator.switch_count };
            let mut sw_tgts: *mut LirSwitchTarget = 0 as *mut LirSwitchTarget;
            if scnt > 0 {
                let sw_bytes = lir_mul_usize(scnt, size_of<LirSwitchTarget>());
                sw_tgts = unsafe { arena_alloc_raw(mut_view(*b.arena), sw_bytes, align_of<LirSwitchTarget>()) as *mut LirSwitchTarget };
                let mvals = unsafe { (*mbb).terminator.values };
                let mtgts = unsafe { (*mbb).terminator.targets };
                let mut k: usize = 0;
                while k < scnt {
                    let st = unsafe { lir_switch_target_at(sw_tgts, k) };
                    unsafe {
                        (*st).val = *mir_u64_at(mvals, k);
                        (*st).target.v = (*mir_bb_id_at(mtgts, k)).v;
                    }
                    k = k + 1;
                }
            }
            let bb_ptr = finish_bb_insts(mut_view(b), i);
            unsafe {
                lir_term_reset(mut_view((*bb_ptr).term), LIR_TERM_SWITCH);
                (*bb_ptr).term.cond.v = cond;
                (*bb_ptr).term.count = scnt;
                (*bb_ptr).term.targets = sw_tgts;
                (*bb_ptr).term.otherwise.v = (*mbb).terminator.otherwise.v;
            }
        } else if tk == MIR_TERM_RETURN {
            let bb_ptr = finish_bb_insts(mut_view(b), i);
            unsafe {
                lir_term_reset(mut_view((*bb_ptr).term), LIR_TERM_RETURN);
            }
        } else if tk == MIR_TERM_ASSERT {
            let mut cond_vreg = unsafe { lower_operand(mut_view(b), view((*mbb).terminator.cond)) };
            if !(unsafe { (*mbb).terminator.expected }) {
                let bool_ty = unsafe { (*b.interner).t_bool.v };
                let one = emit_const(mut_view(b), 1u64, bool_ty);
                let xor_res = make_vreg(mut_view(b), bool_ty);
                emit_bin_inst(mut_view(b), LIR_INST_BIT_XOR, xor_res, cond_vreg, one);
                cond_vreg = xor_res;
            }
            let bb_ptr = finish_bb_insts(mut_view(b), i);
            unsafe {
                lir_term_reset(mut_view((*bb_ptr).term), LIR_TERM_ASSERT);
                (*bb_ptr).term.cond.v = cond_vreg;
                (*bb_ptr).term.assert_target.v = (*mbb).terminator.assert_target.v;
                (*bb_ptr).term.msg_ptr = (*mbb).terminator.msg_ptr;
                (*bb_ptr).term.msg_len = (*mbb).terminator.msg_len;
            }
        } else {
            let bb_ptr = finish_bb_insts(mut_view(b), i);
            unsafe {
                lir_term_reset(mut_view((*bb_ptr).term), LIR_TERM_UNREACHABLE);
            }
        }

        i = i + 1;
    }

    unsafe {
        (*lir).slots = b.slots;
        (*lir).slot_count = b.slot_count;
        (*lir).vregs = if b.vreg_count > 0 { b.vregs } else { 0 as *mut LirVReg };
        (*lir).vreg_count = b.vreg_count;
        (*lir).bbs = if b.bb_count > 0 { b.bbs } else { 0 as *mut LirBb };
        (*lir).bb_count = b.bb_count;
    }

    lir
}

pub fn lir_lower(
    arena: mut_view<Arena>,
    mir: *const MirBody,
    hir: *const HirFile,
    interner: *mut TypeInterner,
    str_in: *const StrInterner,
    fn_ty: *const AxType
) -> *mut LirBody {
    lir_lower_ext(arena, mir, hir, interner, str_in, 0 as *const LirConstTable, fn_ty)
}

