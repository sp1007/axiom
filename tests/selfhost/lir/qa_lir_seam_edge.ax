fn lir_push_str(out: mut_view<DiagBuffer>, off: usize, count: usize) {
    let mut i: usize = 0;
    while i < count {
        diag_buf_push_byte(mut_view(*out), LIR_STR_TABLE[off + i]);
        i = i + 1;
    }
}

fn lir_push_spaces(out: mut_view<DiagBuffer>, count: usize) {
    let mut i: usize = 0;
    while i < count {
        diag_buf_push_byte(mut_view(*out), 32u8);
        i = i + 1;
    }
}

fn lir_push_cstr_or_bytes(out: mut_view<DiagBuffer>, ptr: *const u8, slen: usize) {
    if (ptr as usize) == 0 {
        return;
    }
    if slen > 0 {
        diag_buf_push_bytes(mut_view(*out), ptr, slen);
        return;
    }
    let mut i: usize = 0;
    while true {
        let ch = unsafe { *(ptr + i) };
        if ch == 0u8 {
            break;
        }
        diag_buf_push_byte(mut_view(*out), ch);
        i = i + 1;
    }
}

pub fn lir_buf_push_u64(buf: mut_view<DiagBuffer>, val: u64) {
    if val == 0u64 {
        diag_buf_push_byte(mut_view(*buf), 48u8);
        return;
    }
    let mut digits: [20]u8 = [0u8; 20];
    let mut dlen: usize = 0;
    let mut n: u64 = val;
    while n > 0u64 {
        digits[dlen] = (48u64 + (n % 10u64)) as u8;
        n = n / 10u64;
        dlen = dlen + 1;
    }
    while dlen > 0 {
        dlen = dlen - 1;
        diag_buf_push_byte(mut_view(*buf), digits[dlen]);
    }
}

fn lir_print_bin_operands(out: mut_view<DiagBuffer>, lhs_v: u32, rhs_v: u32) {
    diag_buf_push_byte(mut_view(*out), 118u8);
    diag_buf_push_u32(mut_view(*out), lhs_v);
    lir_push_str(mut_view(*out), 33, 3);
    diag_buf_push_u32(mut_view(*out), rhs_v);
    lir_push_str(mut_view(*out), 22, 2);
}

fn lir_print_overflow_inst(out: mut_view<DiagBuffer>, op_off: usize, lhs_v: u32, rhs_v: u32) {
    lir_push_str(mut_view(*out), op_off, 4);
    lir_push_str(mut_view(*out), 75, 10);
    lir_print_bin_operands(mut_view(*out), lhs_v, rhs_v);
}

fn lir_print_inst(out: mut_view<DiagBuffer>, inst: view<LirInst>) {
    lir_push_spaces(mut_view(*out), 8);
    let k = inst.kind;
    if k != LIR_INST_STORE && k != LIR_INST_CALL && k != LIR_INST_ABI_ARG {
        diag_buf_push_byte(mut_view(*out), 118u8);
        diag_buf_push_u32(mut_view(*out), inst.dest.v);
        lir_push_str(mut_view(*out), 30, 3);
    }
    if k == LIR_INST_ADD {
        lir_push_str(mut_view(*out), 36, 4);
        lir_print_bin_operands(mut_view(*out), inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_SUB {
        lir_push_str(mut_view(*out), 40, 4);
        lir_print_bin_operands(mut_view(*out), inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_MUL {
        lir_push_str(mut_view(*out), 44, 4);
        lir_print_bin_operands(mut_view(*out), inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_DIV {
        lir_push_str(mut_view(*out), 48, 4);
        lir_print_bin_operands(mut_view(*out), inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_REM {
        lir_push_str(mut_view(*out), 52, 4);
        lir_print_bin_operands(mut_view(*out), inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_UDIV {
        lir_push_str(mut_view(*out), 113, 4);
        diag_buf_push_byte(mut_view(*out), 32u8);
        lir_print_bin_operands(mut_view(*out), inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_UREM {
        lir_push_str(mut_view(*out), 121, 4);
        diag_buf_push_byte(mut_view(*out), 32u8);
        lir_print_bin_operands(mut_view(*out), inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_BIT_XOR {
        lir_push_str(mut_view(*out), 56, 4);
        lir_print_bin_operands(mut_view(*out), inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_BIT_AND {
        lir_push_str(mut_view(*out), 60, 4);
        lir_print_bin_operands(mut_view(*out), inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_BIT_OR {
        lir_push_str(mut_view(*out), 64, 3);
        lir_print_bin_operands(mut_view(*out), inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_SHL {
        lir_push_str(mut_view(*out), 67, 4);
        lir_print_bin_operands(mut_view(*out), inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_SHR || k == LIR_INST_SAR {
        lir_push_str(mut_view(*out), 71, 4);
        lir_print_bin_operands(mut_view(*out), inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_SADD_OVERFLOW {
        lir_print_overflow_inst(mut_view(*out), 85, inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_UADD_OVERFLOW {
        lir_print_overflow_inst(mut_view(*out), 89, inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_SSUB_OVERFLOW {
        lir_print_overflow_inst(mut_view(*out), 93, inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_USUB_OVERFLOW {
        lir_print_overflow_inst(mut_view(*out), 97, inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_SMUL_OVERFLOW {
        lir_print_overflow_inst(mut_view(*out), 101, inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_UMUL_OVERFLOW {
        lir_print_overflow_inst(mut_view(*out), 105, inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_SDIV_OVERFLOW {
        lir_print_overflow_inst(mut_view(*out), 109, inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_UDIV_OVERFLOW {
        lir_print_overflow_inst(mut_view(*out), 113, inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_SREM_OVERFLOW {
        lir_print_overflow_inst(mut_view(*out), 117, inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_UREM_OVERFLOW {
        lir_print_overflow_inst(mut_view(*out), 121, inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_NEG {
        lir_push_str(mut_view(*out), 125, 4);
        diag_buf_push_byte(mut_view(*out), 118u8);
        diag_buf_push_u32(mut_view(*out), inst.operand.v);
        lir_push_str(mut_view(*out), 22, 2);
    } else if k == LIR_INST_NOT {
        lir_push_str(mut_view(*out), 129, 4);
        diag_buf_push_byte(mut_view(*out), 118u8);
        diag_buf_push_u32(mut_view(*out), inst.operand.v);
        lir_push_str(mut_view(*out), 22, 2);
    } else if k == LIR_INST_BITNOT {
        lir_push_str(mut_view(*out), 133, 7);
        diag_buf_push_byte(mut_view(*out), 118u8);
        diag_buf_push_u32(mut_view(*out), inst.operand.v);
        lir_push_str(mut_view(*out), 22, 2);
    } else if k == LIR_INST_ICMP_EQ {
        lir_push_str(mut_view(*out), 140, 8);
        lir_print_bin_operands(mut_view(*out), inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_ICMP_NE {
        lir_push_str(mut_view(*out), 148, 8);
        lir_print_bin_operands(mut_view(*out), inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_ICMP_SLT {
        lir_push_str(mut_view(*out), 156, 9);
        lir_print_bin_operands(mut_view(*out), inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_ICMP_SLE {
        lir_push_str(mut_view(*out), 165, 9);
        lir_print_bin_operands(mut_view(*out), inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_ICMP_SGT {
        lir_push_str(mut_view(*out), 174, 9);
        lir_print_bin_operands(mut_view(*out), inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_ICMP_SGE {
        lir_push_str(mut_view(*out), 183, 9);
        lir_print_bin_operands(mut_view(*out), inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_ICMP_ULT {
        lir_push_str(mut_view(*out), 192, 9);
        lir_print_bin_operands(mut_view(*out), inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_ICMP_ULE {
        lir_push_str(mut_view(*out), 201, 9);
        lir_print_bin_operands(mut_view(*out), inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_ICMP_UGT {
        lir_push_str(mut_view(*out), 210, 9);
        lir_print_bin_operands(mut_view(*out), inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_ICMP_UGE {
        lir_push_str(mut_view(*out), 219, 9);
        lir_print_bin_operands(mut_view(*out), inst.lhs.v, inst.rhs.v);
    } else if k == LIR_INST_LOAD {
        lir_push_str(mut_view(*out), 228, 6);
        diag_buf_push_u32(mut_view(*out), inst.ptr.v);
        lir_push_str(mut_view(*out), 22, 2);
    } else if k == LIR_INST_STORE {
        lir_push_str(mut_view(*out), 234, 7);
        diag_buf_push_u32(mut_view(*out), inst.ptr.v);
        lir_push_str(mut_view(*out), 33, 3);
        diag_buf_push_u32(mut_view(*out), inst.val.v);
        lir_push_str(mut_view(*out), 22, 2);
    } else if k == LIR_INST_STACK_ADDR {
        lir_push_str(mut_view(*out), 241, 15);
        diag_buf_push_u32(mut_view(*out), inst.slot.v);
        lir_push_str(mut_view(*out), 22, 2);
    } else if k == LIR_INST_OFFSET {
        lir_push_str(mut_view(*out), 256, 8);
        let lhs_v = if inst.lhs.v != 0u32 || inst.ptr.v == 0u32 { inst.lhs.v } else { inst.ptr.v };
        let rhs_v = if inst.rhs.v != 0u32 || inst.offset.v == 0u32 { inst.rhs.v } else { inst.offset.v };
        diag_buf_push_u32(mut_view(*out), lhs_v);
        lir_push_str(mut_view(*out), 33, 3);
        diag_buf_push_u32(mut_view(*out), rhs_v);
        lir_push_str(mut_view(*out), 22, 2);
    } else if k == LIR_INST_CONST {
        lir_push_str(mut_view(*out), 264, 6);
        lir_buf_push_u64(mut_view(*out), inst.const_val);
        lir_push_str(mut_view(*out), 22, 2);
    } else if k == LIR_INST_CONST_STR {
        lir_push_str(mut_view(*out), 270, 21);
        lir_buf_push_u64(mut_view(*out), inst.str_len as u64);
        lir_push_str(mut_view(*out), 291, 3);
    } else if k == LIR_INST_FN_ADDR {
        lir_push_str(mut_view(*out), 294, 8);
        lir_push_cstr_or_bytes(mut_view(*out), inst.sym_name, inst.sym_len);
        lir_push_str(mut_view(*out), 22, 2);
    } else if k == LIR_INST_CALL {
        if (inst.sym_name as usize) != 0 {
            lir_push_str(mut_view(*out), 302, 5);
            lir_push_cstr_or_bytes(mut_view(*out), inst.sym_name, inst.sym_len);
            lir_push_str(mut_view(*out), 22, 2);
        } else {
            lir_push_str(mut_view(*out), 307, 15);
            diag_buf_push_u32(mut_view(*out), inst.callee_vreg.v);
            lir_push_str(mut_view(*out), 22, 2);
        }
    } else if k == LIR_INST_ABI_ARG {
        lir_push_str(mut_view(*out), 322, 8);
        diag_buf_push_u32(mut_view(*out), inst.index);
        lir_push_str(mut_view(*out), 33, 3);
        diag_buf_push_u32(mut_view(*out), inst.val.v);
        lir_push_str(mut_view(*out), 22, 2);
    } else if k == LIR_INST_ABI_RESULT {
        lir_push_str(mut_view(*out), 330, 11);
        diag_buf_push_u32(mut_view(*out), inst.index);
        lir_push_str(mut_view(*out), 22, 2);
    }
}

fn lir_print_term(out: mut_view<DiagBuffer>, term: view<LirTerminator>) {
    lir_push_spaces(mut_view(*out), 8);
    let tk = term.kind;
    if tk == LIR_TERM_JMP {
        lir_push_str(mut_view(*out), 341, 6);
        diag_buf_push_u32(mut_view(*out), term.jmp_target.v);
        lir_push_str(mut_view(*out), 22, 2);
    } else if tk == LIR_TERM_JCC {
        lir_push_str(mut_view(*out), 347, 5);
        diag_buf_push_u32(mut_view(*out), term.cond.v);
        lir_push_str(mut_view(*out), 352, 4);
        diag_buf_push_u32(mut_view(*out), term.then_target.v);
        lir_push_str(mut_view(*out), 352, 4);
        diag_buf_push_u32(mut_view(*out), term.else_target.v);
        lir_push_str(mut_view(*out), 22, 2);
    } else if tk == LIR_TERM_SWITCH {
        lir_push_str(mut_view(*out), 356, 8);
        diag_buf_push_u32(mut_view(*out), term.cond.v);
        lir_push_str(mut_view(*out), 364, 3);
        let mut k: usize = 0;
        while k < term.count {
            let tgt = unsafe { lir_switch_target_at(term.targets, k) };
            let tval = unsafe { (*tgt).val };
            let tbb = unsafe { (*tgt).target.v };
            lir_push_spaces(mut_view(*out), 12);
            lir_buf_push_u64(mut_view(*out), tval);
            lir_push_str(mut_view(*out), 367, 4);
            diag_buf_push_u32(mut_view(*out), tbb);
            lir_push_str(mut_view(*out), 371, 2);
            k = k + 1;
        }
        lir_push_spaces(mut_view(*out), 12);
        lir_push_str(mut_view(*out), 373, 13);
        diag_buf_push_u32(mut_view(*out), term.otherwise.v);
        lir_push_str(mut_view(*out), 386, 12);
    } else if tk == LIR_TERM_RETURN {
        lir_push_str(mut_view(*out), 398, 8);
    } else if tk == LIR_TERM_UNREACHABLE {
        lir_push_str(mut_view(*out), 406, 13);
    } else if tk == LIR_TERM_ASSERT {
        lir_push_str(mut_view(*out), 419, 8);
        diag_buf_push_u32(mut_view(*out), term.cond.v);
        lir_push_str(mut_view(*out), 352, 4);
        diag_buf_push_u32(mut_view(*out), term.assert_target.v);
        lir_push_str(mut_view(*out), 427, 3);
        lir_push_cstr_or_bytes(mut_view(*out), term.msg_ptr, term.msg_len);
        lir_push_str(mut_view(*out), 430, 3);
    }
}

pub fn lir_print(out: mut_view<DiagBuffer>, body: view<LirBody>) {
    lir_push_str(mut_view(*out), 0, 11);
    let mut i: usize = 0;
    while i < body.slot_count {
        let slot_ptr = unsafe { lir_slot_at(body.slots, i) };
        let ty_v = unsafe { (*slot_ptr).ty.v };
        lir_push_spaces(mut_view(*out), 4);
        lir_push_str(mut_view(*out), 11, 4);
        diag_buf_push_u32(mut_view(*out), i as u32);
        lir_push_str(mut_view(*out), 15, 7);
        diag_buf_push_u32(mut_view(*out), ty_v);
        lir_push_str(mut_view(*out), 22, 2);
        i = i + 1;
    }
    i = 0;
    while i < body.bb_count {
        let bb_ptr = unsafe { lir_bb_at(body.bbs, i) };
        let inst_count = unsafe { (*bb_ptr).inst_count };
        let insts = unsafe { (*bb_ptr).insts };
        lir_push_spaces(mut_view(*out), 4);
        lir_push_str(mut_view(*out), 24, 2);
        diag_buf_push_u32(mut_view(*out), i as u32);
        lir_push_str(mut_view(*out), 26, 4);
        let mut j: usize = 0;
        while j < inst_count {
            let inst_ptr = unsafe { lir_inst_at(insts, j) };
            unsafe {
                lir_print_inst(mut_view(*out), view(*inst_ptr));
            }
            j = j + 1;
        }
        unsafe {
            lir_print_term(mut_view(*out), view((*bb_ptr).term));
        }
        lir_push_spaces(mut_view(*out), 4);
        lir_push_str(mut_view(*out), 433, 2);
        i = i + 1;
    }
    lir_push_str(mut_view(*out), 433, 2);
}

