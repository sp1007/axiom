    if (dummy_mir as usize) == 0 {
        return 12;
    }
    let r2 = lir_lower_ext(
        mut_view(*a),
        dummy_mir,
        0 as *const HirFile,
        0 as *mut TypeInterner,
        0 as *const StrInterner,
        0 as *const LirConstTable,
        0 as *const AxType
    );
    if (r2 as usize) != 0 {
        return 13;
    }
    let r3 = lir_lower(
        mut_view(*a),
        0 as *const MirBody,
        0 as *const HirFile,
        ti_ptr,
        0 as *const StrInterner,
        0 as *const AxType
    );
    if (r3 as usize) != 0 {
        return 14;
    }
    arena_reset(mut_view(*a));
    0
}

fn test_manual_lir_model_and_printer(a: mut_view<Arena>, out: mut_view<DiagBuffer>) -> i32 {
    let body = lir_body_new(mut_view(*a));
    let slots = arena_alloc_raw(mut_view(*a), size_of<LirStackSlot>(), align_of<LirStackSlot>()) as *mut LirStackSlot;
    unsafe {
        let s0 = lir_slot_at(slots, 0);
        (*s0).ty.v = 7u32;
        (*s0).is_const = false;
    }
    let bbs = arena_alloc_raw(mut_view(*a), 2 * size_of<LirBb>(), align_of<LirBb>()) as *mut LirBb;
    let bb0 = unsafe { lir_bb_at(bbs, 0) };
    let bb1 = unsafe { lir_bb_at(bbs, 1) };
    unsafe {
        lir_bb_reset(mut_view(*bb0), 0u32);
        lir_bb_reset(mut_view(*bb1), 1u32);
    }

    let insts0 = arena_alloc_raw(mut_view(*a), 6 * size_of<LirInst>(), align_of<LirInst>()) as *mut LirInst;
    let scratch_inst = arena_alloc_raw(mut_view(*a), size_of<LirInst>(), align_of<LirInst>()) as *mut LirInst;

    // v0 = const 0;
    unsafe {
        lir_inst_reset(mut_view(*scratch_inst), LIR_INST_CONST);
        (*scratch_inst).dest.v = 0u32;
        (*scratch_inst).const_val = 0u64;
        let dst0 = lir_inst_at(insts0, 0);
        lir_copy_inst(mut_view(*dst0), view(*scratch_inst));
    }

    // v1 = const 9223372036854775807; (i64::MAX, 19 digits)
    unsafe {
        lir_inst_reset(mut_view(*scratch_inst), LIR_INST_CONST);
        (*scratch_inst).dest.v = 1u32;
        (*scratch_inst).const_val = 0x7FFFFFFFFFFFFFFFu64;
        let dst1 = lir_inst_at(insts0, 1);
        lir_copy_inst(mut_view(*dst1), view(*scratch_inst));
    }

    // v2 = const_str "..." (len 5);
    unsafe {
        lir_inst_reset(mut_view(*scratch_inst), LIR_INST_CONST_STR);
        (*scratch_inst).dest.v = 2u32;
        (*scratch_inst).str_bytes = address_of(QA_ASSERT_MSG[0]);
        (*scratch_inst).str_len = 5;
        let dst2 = lir_inst_at(insts0, 2);
        lir_copy_inst(mut_view(*dst2), view(*scratch_inst));
    }

    // v3 = offset v0, v1; (via lhs/rhs)
    unsafe {
        lir_inst_reset(mut_view(*scratch_inst), LIR_INST_OFFSET);
        (*scratch_inst).dest.v = 3u32;
        (*scratch_inst).lhs.v = 0u32;
        (*scratch_inst).rhs.v = 1u32;
        let dst3 = lir_inst_at(insts0, 3);
        lir_copy_inst(mut_view(*dst3), view(*scratch_inst));
    }

    // v4 = offset v2, v3; (via ptr/offset fallback in lir_print_inst)
    unsafe {
        lir_inst_reset(mut_view(*scratch_inst), LIR_INST_OFFSET);
        (*scratch_inst).dest.v = 4u32;
        (*scratch_inst).ptr.v = 2u32;
        (*scratch_inst).offset.v = 3u32;
        let dst4 = lir_inst_at(insts0, 4);
        lir_copy_inst(mut_view(*dst4), view(*scratch_inst));
    }

    // call_indirect v4; (LIR_INST_CALL with sym_name == 0)
    unsafe {
        lir_inst_reset(mut_view(*scratch_inst), LIR_INST_CALL);
        (*scratch_inst).callee_vreg.v = 4u32;
        let dst5 = lir_inst_at(insts0, 5);
        lir_copy_inst(mut_view(*dst5), view(*scratch_inst));
    }

    unsafe {
        (*bb0).insts = insts0;
        (*bb0).inst_count = 6;
        lir_term_reset(mut_view((*bb0).term), LIR_TERM_JCC);
        (*bb0).term.cond.v = 0u32;
        (*bb0).term.then_target.v = 1u32;
        (*bb0).term.else_target.v = 2u32;

        (*bb1).insts = 0 as *mut LirInst;
        (*bb1).inst_count = 0;
        lir_term_reset(mut_view((*bb1).term), LIR_TERM_ASSERT);
        (*bb1).term.cond.v = 1u32;
        (*bb1).term.assert_target.v = 0u32;
        (*bb1).term.msg_ptr = address_of(QA_ASSERT_MSG[0]);
        (*bb1).term.msg_len = 8;
        let scratch_bb = arena_alloc_raw(mut_view(*a), size_of<LirBb>(), align_of<LirBb>()) as *mut LirBb;
        lir_copy_term(mut_view((*scratch_bb).term), view((*bb1).term));
        lir_copy_term(mut_view((*bb1).term), view((*scratch_bb).term));

        (*body).slots = slots;
        (*body).slot_count = 1;
        (*body).bbs = bbs;
        (*body).bb_count = 2;
    }

    out.len = 0;
    lir_print(mut_view(*out), unsafe { view(*body) });
    let exp_sv = get_qa_sv(mut_view(*a), 0);
    if !bytes_equal(out.ptr as *const u8, out.len, exp_sv.ptr, exp_sv.len) {
        return 21;
    }

    arena_reset(mut_view(*a));
    0
}

fn test_assert_false_and_zero_switch(a: mut_view<Arena>, ti_ptr: *mut TypeInterner, out: mut_view<DiagBuffer>) -> i32 {
    let src_sv = get_qa_sv(mut_view(*a), 1);
    let exp_sv = get_qa_sv(mut_view(*a), 2);
    let mir = mir_parse(src_sv, unsafe { mut_view(*ti_ptr) }, mut_view(*a));
    if (mir as usize) == 0 {
        return 31;
    }
    let lir = lir_lower(
        mut_view(*a),
        mir,
        0 as *const HirFile,
        ti_ptr,
        0 as *const StrInterner,
        0 as *const AxType
    );
    if (lir as usize) == 0 {
        return 32;
    }
    out.len = 0;
    lir_print(mut_view(*out), unsafe { view(*lir) });
    if !bytes_equal(out.ptr as *const u8, out.len, exp_sv.ptr, exp_sv.len) {
        return 33;
    }
    arena_reset(mut_view(*a));
    0
}

fn test_builtin_calls_seam(a: mut_view<Arena>, ti_ptr: *mut TypeInterner) -> i32 {
    let src_sv = get_qa_sv(mut_view(*a), 3);
    let mir = mir_parse(src_sv, unsafe { mut_view(*ti_ptr) }, mut_view(*a));
    if (mir as usize) == 0 {
        return 41;
    }
    let ty_sizeof = unsafe { intern_singleton(mut_view(*ti_ptr), TY_BUILTIN_SIZE_OF) };
    let ty_alignof = unsafe { intern_singleton(mut_view(*ti_ptr), TY_BUILTIN_ALIGN_OF) };
    let ty_null = unsafe { intern_singleton(mut_view(*ti_ptr), TY_BUILTIN_NULL) };
    let ty_isnull = unsafe { intern_singleton(mut_view(*ti_ptr), TY_BUILTIN_IS_NULL) };
    let ty_ptradd = unsafe { intern_singleton(mut_view(*ti_ptr), TY_BUILTIN_PTR_ADD) };
    let ty_ptrsub = unsafe { intern_singleton(mut_view(*ti_ptr), TY_BUILTIN_PTR_SUB) };
    let ty_forget = unsafe { intern_singleton(mut_view(*ti_ptr), TY_BUILTIN_FORGET) };
    let i32_ty_v = unsafe { (*ti_ptr).t_i32.v as u64 };

    // Patch bb0..bb6 call callee types to the builtin singleton TypeIds
    unsafe {
        let bb0 = mir_bb_at((*mir).bbs, 0);
        (*bb0).terminator.func.constant.ty.v = ty_sizeof.v;
        (*bb0).terminator.func.constant.val = i32_ty_v;
        let bb1 = mir_bb_at((*mir).bbs, 1);
        (*bb1).terminator.func.constant.ty.v = ty_alignof.v;
        (*bb1).terminator.func.constant.val = i32_ty_v;
        let bb2 = mir_bb_at((*mir).bbs, 2);
        (*bb2).terminator.func.constant.ty.v = ty_null.v;
        (*bb2).terminator.func.constant.val = i32_ty_v;
        let bb3 = mir_bb_at((*mir).bbs, 3);
        (*bb3).terminator.func.constant.ty.v = ty_isnull.v;
        (*bb3).terminator.func.constant.val = i32_ty_v;
        let bb4 = mir_bb_at((*mir).bbs, 4);
        (*bb4).terminator.func.constant.ty.v = ty_ptradd.v;
        (*bb4).terminator.func.constant.val = i32_ty_v;
        let bb5 = mir_bb_at((*mir).bbs, 5);
        (*bb5).terminator.func.constant.ty.v = ty_ptrsub.v;
        (*bb5).terminator.func.constant.val = i32_ty_v;
        let bb6 = mir_bb_at((*mir).bbs, 6);
        (*bb6).terminator.func.constant.ty.v = ty_forget.v;
        (*bb6).terminator.func.constant.val = i32_ty_v;
    }

    let lir = lir_lower(
        mut_view(*a),
        mir,
        0 as *const HirFile,
        ti_ptr,
        0 as *const StrInterner,
        0 as *const AxType
    );
    if (lir as usize) == 0 {
        return 42;
    }
    // Check bb0 (size_of::<i32>() == 4)
    let lbb0 = unsafe { lir_bb_at((*lir).bbs, 0) };
    let b0_i0 = unsafe { lir_inst_at((*lbb0).insts, 0) };
    if (unsafe { (*b0_i0).kind }) != LIR_INST_CONST || (unsafe { (*b0_i0).const_val }) != 4u64 {
        return 43;
    }
    // Check bb1 (align_of::<i32>() == 4)
    let lbb1 = unsafe { lir_bb_at((*lir).bbs, 1) };
    let b1_i0 = unsafe { lir_inst_at((*lbb1).insts, 0) };
    if (unsafe { (*b1_i0).kind }) != LIR_INST_CONST || (unsafe { (*b1_i0).const_val }) != 4u64 {
        return 44;
    }
    // Check bb2 (null::<i32>() == 0)
    let lbb2 = unsafe { lir_bb_at((*lir).bbs, 2) };
    let b2_i0 = unsafe { lir_inst_at((*lbb2).insts, 0) };
    if (unsafe { (*b2_i0).kind }) != LIR_INST_CONST || (unsafe { (*b2_i0).const_val }) != 0u64 {
        return 45;
    }
    // Check bb3 (is_null emits icmp.eq with 0)
    let lbb3 = unsafe { lir_bb_at((*lir).bbs, 3) };
    let b3_i3 = unsafe { lir_inst_at((*lbb3).insts, 3) };
    if (unsafe { (*b3_i3).kind }) != LIR_INST_ICMP_EQ {
        return 46;
    }
    // Check bb4 (ptr_add::<i32> scales by 4 via LIR_INST_MUL then LIR_INST_ADD)
    let lbb4 = unsafe { lir_bb_at((*lir).bbs, 4) };
    let b4_mul = unsafe { lir_inst_at((*lbb4).insts, 4) };
    let b4_add = unsafe { lir_inst_at((*lbb4).insts, 5) };
    if (unsafe { (*b4_mul).kind }) != LIR_INST_MUL || (unsafe { (*b4_add).kind }) != LIR_INST_ADD {
        return 47;
    }
    // Check bb5 (ptr_sub::<i32> scales by 4 via LIR_INST_MUL then LIR_INST_SUB)
    let lbb5 = unsafe { lir_bb_at((*lir).bbs, 5) };
    let b5_mul = unsafe { lir_inst_at((*lbb5).insts, 4) };
    let b5_sub = unsafe { lir_inst_at((*lbb5).insts, 5) };
    if (unsafe { (*b5_mul).kind }) != LIR_INST_MUL || (unsafe { (*b5_sub).kind }) != LIR_INST_SUB {
        return 48;
    }
    // Check bb6 (forget emits 0 instructions and jumps to bb7)
    let lbb6 = unsafe { lir_bb_at((*lir).bbs, 6) };
    if (unsafe { (*lbb6).inst_count }) != 0 || (unsafe { (*lbb6).term.kind }) != LIR_TERM_JMP || (unsafe { (*lbb6).term.jmp_target.v }) != 7u32 {
        return 49;
    }

    arena_reset(mut_view(*a));
    0
}

pub fn main() -> i32 {
    let mut perm = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(perm), 16, 8);
    let mut a = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(a), 16, 8);

    let ti_ptr = arena_alloc_raw(mut_view(perm), size_of<TypeInterner>(), align_of<TypeInterner>()) as *mut TypeInterner;
    unsafe { type_interner_init(mut_view(*ti_ptr)); }

    let mut out = diag_buf_new();
    out.ptr = arena_alloc_raw(mut_view(perm), 16384, 1);
    out.cap = 16384;

    let rc1 = test_null_guards(mut_view(a), ti_ptr);
    if rc1 != 0 {
        return rc1;
    }

    let rc2 = test_manual_lir_model_and_printer(mut_view(a), mut_view(out));
    if rc2 != 0 {
        return rc2;
    }

    let rc3 = test_assert_false_and_zero_switch(mut_view(a), ti_ptr, mut_view(out));
    if rc3 != 0 {
        return rc3;
    }

    let rc4 = test_builtin_calls_seam(mut_view(a), ti_ptr);
    if rc4 != 0 {
        return rc4;
    }

    unsafe { type_interner_free(mut_view(*ti_ptr)); }
    arena_destroy(mut_view(a));
    arena_destroy(mut_view(perm));
    print("OK QA LIR Seam & Edge Cases\n");
    0
}
