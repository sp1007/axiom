const LIR_TEST_OFF: [112]u32 = [
    0u32, 21u32, 247u32, 611u32, 635u32, 861u32, 1225u32, 1242u32, 1380u32, 1667u32, 1688u32, 1826u32,
    2113u32, 2133u32, 2271u32, 2557u32, 2578u32, 2716u32, 3003u32, 3023u32, 3152u32, 3385u32, 3403u32, 3629u32,
    3993u32, 4012u32, 4141u32, 4320u32, 4337u32, 4475u32, 4762u32, 4783u32, 4922u32, 5213u32, 5234u32, 5373u32,
    5664u32, 5686u32, 5825u32, 6117u32, 6139u32, 6277u32, 6569u32, 6591u32, 6730u32, 7022u32, 7044u32, 7182u32,
    7474u32, 7496u32, 7635u32, 7927u32, 7949u32, 8087u32, 8379u32, 8401u32, 8540u32, 8832u32, 8854u32, 8992u32,
    9284u32, 9302u32, 9433u32, 9664u32, 9681u32, 9819u32, 10106u32, 10123u32, 10252u32, 10482u32, 10499u32, 10628u32,
    10858u32, 10878u32, 11023u32, 11310u32, 11339u32, 11651u32, 12160u32, 12189u32, 12656u32, 13430u32, 13447u32, 13585u32,
    13872u32, 13889u32, 14028u32, 14315u32, 14332u32, 14471u32, 14758u32, 14782u32, 14906u32, 15093u32, 15112u32, 15243u32,
    15474u32, 15491u32, 15629u32, 15916u32, 15935u32, 16133u32, 16433u32, 16454u32, 16665u32, 17090u32, 17114u32, 17338u32,
    17684u32, 17706u32, 18003u32, 18734u32,
];

fn get_test_sv(a: mut_view<Arena>, blob_idx: usize) -> StrView {
    let start = LIR_TEST_OFF[blob_idx] as usize;
    let end = LIR_TEST_OFF[blob_idx + 1] as usize;
    let n = end - start;
    let dst = arena_alloc_raw(a, n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe {
            *(dst + i) = LIR_TEST_DATA[start + i];
        }
        i = i + 1;
    }
    unsafe {
        *(dst + n) = 0u8;
    }
    StrView { ptr: dst as *const u8, len: n }
}

fn dump_sv(sv: StrView) {
    let s: str = unsafe { *(address_of(sv) as *const str) };
    print(s);
}

fn bytes_equal(a: *const u8, a_len: usize, b: *const u8, b_len: usize) -> bool {
    if a_len != b_len {
        return false;
    }
    let mut i: usize = 0;
    while i < a_len {
        if (unsafe { *(a + i) }) != (unsafe { *(b + i) }) {
            return false;
        }
        i = i + 1;
    }
    true
}

const CONST_SYM_NAME: [12]u8 = [
    46u8, 76u8, 99u8, 111u8, 110u8, 115u8, 116u8, 95u8, 55u8, 55u8, 95u8, 0u8,
];

fn test_fn_ty_and_const_table(a: mut_view<Arena>, ti_ptr: *mut TypeInterner) -> i32 {
    let base_blob: usize = 33 * 3;
    let src_sv = get_test_sv(mut_view(*a), base_blob + 1);
    let mir_body = mir_parse(src_sv, unsafe { mut_view(*ti_ptr) }, mut_view(*a));
    if (mir_body as usize) == 0 {
        return 501;
    }
    let ptypes = arena_alloc_raw(mut_view(*a), 2 * size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
    unsafe {
        (*ptypes).v = (*ti_ptr).t_i32.v;
        (*(((ptypes as usize) + size_of<TypeId>()) as *mut TypeId)).v = (*ti_ptr).t_i64.v;
    }
    let ret_ty = TypeId { v: unsafe { (*ti_ptr).t_i32.v } };
    let fn_ty_id = unsafe {
        intern_fn_ty(mut_view(*ti_ptr), false, StrId { v: 0u32 }, ptypes, 2, ret_ty)
    };
    let fn_ty_ptr = unsafe { type_get(view(*ti_ptr), fn_ty_id) as *const AxType };

    // Also mark local _1 as MIR_LOCAL_CONST with const_sym = 77 and provide a LirConstTable
    let l1 = unsafe { mir_local_at((*mir_body).locals, 1) };
    unsafe {
        (*l1).kind = MIR_LOCAL_CONST;
        (*l1).const_sym.v = 77u32;
    }
    let centry_ptr = arena_alloc_raw(mut_view(*a), size_of<LirConstEntry>(), align_of<LirConstEntry>()) as *mut LirConstEntry;
    unsafe {
        (*centry_ptr).sym_v = 77u32;
        (*centry_ptr).sym_name = address_of(CONST_SYM_NAME[0]);
        (*centry_ptr).sym_len = 11;
    }
    let ctable_ptr = arena_alloc_raw(mut_view(*a), size_of<LirConstTable>(), align_of<LirConstTable>()) as *mut LirConstTable;
    unsafe {
        (*ctable_ptr).entries = centry_ptr;
        (*ctable_ptr).count = 1;
    }

    let lir = lir_lower_ext(
        mut_view(*a),
        mir_body,
        0 as *const HirFile,
        ti_ptr,
        0 as *const StrInterner,
        ctable_ptr as *const LirConstTable,
        fn_ty_ptr
    );
    if (lir as usize) == 0 {
        return 502;
    }
    let s1 = unsafe { lir_slot_at((*lir).slots, 1) };
    if !(unsafe { (*s1).is_const }) {
        return 503;
    }
    let bb0 = unsafe { lir_bb_at((*lir).bbs, 0) };
    if (unsafe { (*bb0).inst_count }) < 6 {
        return 504;
    }
    let i0 = unsafe { lir_inst_at((*bb0).insts, 0) };
    let i1 = unsafe { lir_inst_at((*bb0).insts, 1) };
    let i2 = unsafe { lir_inst_at((*bb0).insts, 2) };
    let i3 = unsafe { lir_inst_at((*bb0).insts, 3) };
    if (unsafe { (*i0).kind }) != LIR_INST_ABI_ARG || (unsafe { (*i0).index }) != 0u32 {
        return 505;
    }
    if (unsafe { (*i1).kind }) != LIR_INST_STACK_ADDR || (unsafe { (*i1).slot.v }) != 1u32 {
        return 506;
    }
    if (unsafe { (*i2).kind }) != LIR_INST_STORE {
        return 507;
    }
    if (unsafe { (*i3).kind }) != LIR_INST_ABI_ARG || (unsafe { (*i3).index }) != 1u32 {
        return 508;
    }
    arena_reset(mut_view(*a));
    0
}

pub fn main() -> i32 {
    let mut perm = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(perm), 16, 8);
    let mut a = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(a), 16, 8);

    let ti_ptr = arena_alloc_raw(mut_view(perm), size_of<TypeInterner>(), align_of<TypeInterner>()) as *mut TypeInterner;
    unsafe { type_interner_init(mut_view(*ti_ptr)); }

    let mut out = diag_buf_new();
    out.ptr = arena_alloc_raw(mut_view(perm), 65536, 1);
    out.cap = 65536;

    let mut idx: usize = 0;
    while idx < 37 {
        let base_blob = idx * 3;
        let path_sv = get_test_sv(mut_view(a), base_blob);
        let src_sv = get_test_sv(mut_view(a), base_blob + 1);
        let exp_sv = get_test_sv(mut_view(a), base_blob + 2);

        let mir_body = mir_parse(src_sv, unsafe { mut_view(*ti_ptr) }, mut_view(a));
        if (mir_body as usize) == 0 {
            dump_sv(path_sv);
            print("\nMIR parse failed\n");
            return 100 + (idx as i32);
        }

        let lir_body = lir_lower(
            mut_view(a),
            mir_body,
            0 as *const HirFile,
            ti_ptr,
            0 as *const StrInterner,
            0 as *const AxType
        );
        if (lir_body as usize) == 0 {
            dump_sv(path_sv);
            print("\nLIR lower failed\n");
            return 200 + (idx as i32);
        }

        out.len = 0;
        lir_print(mut_view(out), unsafe { view(*lir_body) });

        if !bytes_equal(out.ptr as *const u8, out.len, exp_sv.ptr, exp_sv.len) {
            dump_sv(path_sv);
            print("\n--- ACTUAL ---\n");
            dump_sv(StrView { ptr: out.ptr as *const u8, len: out.len });
            print("--- EXPECTED ---\n");
            dump_sv(exp_sv);
            return 300 + (idx as i32);
        }

        arena_reset(mut_view(a));
        idx = idx + 1;
    }

    let ext_rc = test_fn_ty_and_const_table(mut_view(a), ti_ptr);
    if ext_rc != 0 {
        return ext_rc;
    }

    unsafe { type_interner_free(mut_view(*ti_ptr)); }
    arena_destroy(mut_view(a));
    arena_destroy(mut_view(perm));
    print("OK LIR From MIR (37 cases + ext)\n");
    0
}
