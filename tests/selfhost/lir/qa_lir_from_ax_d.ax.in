    }
    unsafe {
        *(dst + n) = 0u8;
    }
    StrView { ptr: dst as *const u8, len: n }
}

fn dump_sv(sv: StrView) {
    let _ = sv;
}

fn bytes_equal(a: *const u8, a_len: usize, b: *const u8, b_len: usize) -> bool {
    if a_len != b_len {
        return false;
    }
    let mut i: usize = 0;
    while i < a_len {
        if (unsafe { *(a + i) }) != (unsafe { *(b + i) }) {
            return false;
        }
        i = i + 1;
    }
    true
}

fn emit_lir_for_virtual_file(
    sess: mut_view<CompilerSession>,
    parse_arena: mut_view<Arena>,
    resolve_arena: mut_view<Arena>,
    hir_arena: mut_view<Arena>,
    mir_arena: mut_view<Arena>,
    lir_arena: mut_view<Arena>,
    rmap: mut_view<ResolveMap>,
    thir_ptr: *mut Thir,
    path_sv: StrView,
    src_sv: StrView,
    out: mut_view<DiagBuffer>
) -> i32 {
    let mut fid = FileId { v: 0u32 };
    let mut parse_res = session_parse_virtual_file(
        mut_view(*sess),
        mut_view(*parse_arena),
        StrView { ptr: path_sv.ptr, len: path_sv.len },
        StrView { ptr: src_sv.ptr, len: src_sv.len },
        mut_view(fid)
    );
    let mut dummy_fid = FileId { v: 0u32 };
    let stub_sv = get_stub_sv(mut_view(*parse_arena));
    let pres2 = session_parse_virtual_file(
        mut_view(*sess),
        mut_view(*parse_arena),
        StrView { ptr: stub_sv.ptr, len: 5 },
        StrView { ptr: stub_sv.ptr, len: stub_sv.len },
        mut_view(dummy_fid)
    );
    parse_res.ast.items = append_ast_items(parse_res.ast.items, pres2.ast.items);
    session_resolve_ast_into(mut_view(*sess), mut_view(*resolve_arena), view(parse_res.ast), mut_view(*rmap));
    let hir = session_lower_hir(mut_view(*sess), mut_view(*hir_arena), view(parse_res.ast), view(*rmap));

    if session_error_count(view(*sess)) != 0 {
        resolve_map_free(mut_view(*rmap));
        return 100;
    }
    unsafe {
        session_typeck_into(mut_view(*sess), view(hir), mut_view(*thir_ptr));
    }
    if session_error_count(view(*sess)) != 0 {
        ax_diag_render_human(view(sess.diag_sink), view(sess.source_db), mut_view(*out));
        dump_sv(path_sv);
        print("\n--- TYPECK DIAG ---\n");
        dump_sv(StrView { ptr: out.ptr as *const u8, len: out.len });
        resolve_map_free(mut_view(*rmap));
        return 200;
    }

    let hir_ptr = unsafe { address_of(hir.items) as *const HirFile };
    let str_in_ptr = unsafe { address_of_mut(sess.interner.bytes.head) as *mut StrInterner };
    let db_ptr = unsafe { address_of(sess.source_db.arena.head) as *const SourceDatabase };
    let ti_ptr = thir_ptr as *mut TypeInterner;
    let mut bodies: [32]*mut MirBody = [0 as *mut MirBody; 32];
    let mut bcnt: usize = 0;
    let mut it: *mut HirItem = hir.items;
    while (it as usize) != 0 {
        let it_file = unsafe { (*it).span.file.v };
        if (fid.v == 0u32 || it_file == 0u32 || it_file == fid.v) && (unsafe { (*it).kind }) == HIR_ITEM_FN {
            let body = mir_build_fn(
                mut_view(*mir_arena),
                it,
                thir_ptr,
                hir_ptr,
                str_in_ptr,
                db_ptr,
                0 as *mut MonoEngine
            );
            if (body as usize) != 0 && bcnt < 32 {
                bodies[bcnt] = body;
                bcnt = bcnt + 1;
            }
        }
        it = unsafe { (*it).next };
    }
    let mut bi: usize = 0;
    while bi < bcnt {
        let body = bodies[bi];
        let lir_body = lir_lower(
            mut_view(*lir_arena),
            body,
            hir_ptr,
            ti_ptr,
            str_in_ptr,
            0 as *const AxType
        );
        if (lir_body as usize) != 0 {
            lir_print(mut_view(*out), unsafe { view(*lir_body) });
        }
        bi = bi + 1;
    }
    resolve_map_free(mut_view(*rmap));
    0
}

fn run_lir_golden_case(
    sess: mut_view<CompilerSession>,
    parse_arena: mut_view<Arena>,
    resolve_arena: mut_view<Arena>,
    hir_arena: mut_view<Arena>,
    mir_arena: mut_view<Arena>,
    lir_arena: mut_view<Arena>,
    scratch: mut_view<Arena>,
    rmap: mut_view<ResolveMap>,
    thir_ptr: *mut Thir,
    out: mut_view<DiagBuffer>,
    case_idx: usize
) -> i32 {
    session_init(mut_view(*sess));
    unsafe {
        thir_init(mut_view(*thir_ptr));
    }
    out.len = 0;

    let base_blob = case_idx * 3;
    let path_sv = get_mb_sv(mut_view(*scratch), base_blob);
    let src_sv = get_mb_sv(mut_view(*scratch), base_blob + 1);
    let exp_lir = get_mb_sv(mut_view(*scratch), base_blob + 2);

    let step_rc = emit_lir_for_virtual_file(
        mut_view(*sess),
        mut_view(*parse_arena),
        mut_view(*resolve_arena),
        mut_view(*hir_arena),
        mut_view(*mir_arena),
        mut_view(*lir_arena),
        mut_view(*rmap),
        thir_ptr,
        StrView { ptr: path_sv.ptr, len: path_sv.len },
        StrView { ptr: src_sv.ptr, len: src_sv.len },
        mut_view(*out)
    );

    let mut rc: i32 = 0;
    if step_rc != 0 {
        rc = step_rc + (case_idx as i32);
    } else if !bytes_equal(out.ptr as *const u8, out.len, exp_lir.ptr, exp_lir.len) {
        dump_sv(path_sv);
        print("\n--- ACTUAL ---\n");
        dump_sv(StrView { ptr: out.ptr as *const u8, len: out.len });
        print("--- EXPECTED ---\n");
        dump_sv(exp_lir);
        rc = 300 + (case_idx as i32);
    }

    unsafe {
        thir_free(mut_view(*thir_ptr));
    }
    arena_reset(mut_view(*lir_arena));
    arena_reset(mut_view(*mir_arena));
    arena_reset(mut_view(*hir_arena));
    arena_reset(mut_view(*resolve_arena));
    arena_reset(mut_view(*parse_arena));
    arena_reset(mut_view(*scratch));
    session_free(mut_view(*sess));
    rc
}

pub fn main() -> i32 {
    let mut perm_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(perm_arena), 16, 8);
    let sess_ptr = arena_alloc_raw(mut_view(perm_arena), size_of<CompilerSession>(), align_of<CompilerSession>()) as *mut CompilerSession;
    let mut parse_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(parse_arena), 16, 8);
    let mut resolve_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(resolve_arena), 16, 8);
    let mut hir_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(hir_arena), 16, 8);
    let mut mir_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(mir_arena), 16, 8);
    let mut lir_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(lir_arena), 16, 8);
    let mut scratch = arena_with_chunk_size(65536);
    let _ = arena_alloc_raw(mut_view(scratch), 16, 8);
    let thir_ptr = arena_alloc_raw(mut_view(perm_arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    let mut out = diag_buf_new();
    out.ptr = arena_alloc_raw(mut_view(perm_arena), 65536, 1);
    out.cap = 65536;
    let mut rmap = ResolveMap {
        node_map: NodeMap { keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0 },
        module_access_nodes: NodeMap { keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0 },
        extern_nodes: NodeMap { keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0 },
        next_symbol_v: 1u32,
        next_std_symbol_v: 10000u32,
        naming_ctx: 0 as *mut NamingCtx,
    };

    let mut idx: usize = 0;
    while idx < 2 {
        let rc = run_lir_golden_case(
            unsafe { mut_view(*sess_ptr) },
            mut_view(parse_arena),
            mut_view(resolve_arena),
            mut_view(hir_arena),
            mut_view(mir_arena),
            mut_view(lir_arena),
            mut_view(scratch),
            mut_view(rmap),
            thir_ptr,
            mut_view(out),
            idx
        );
        if rc != 0 {
            return rc;
        }
        idx = idx + 1;
    }

    arena_destroy(mut_view(scratch));
    arena_destroy(mut_view(lir_arena));
    arena_destroy(mut_view(mir_arena));
    arena_destroy(mut_view(hir_arena));
    arena_destroy(mut_view(resolve_arena));
    arena_destroy(mut_view(parse_arena));
    arena_destroy(mut_view(perm_arena));
    print("OK LIR From AX D (2 cases)\n");
    0
}
