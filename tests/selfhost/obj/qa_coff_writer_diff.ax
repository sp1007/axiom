impl FileId {
    pub fn none() -> FileId { FileId { v: 0 } }
    pub fn is_none(self: view<FileId>) -> bool { self.v == 0 }
    pub fn is_some(self: view<FileId>) -> bool { self.v != 0 }
    pub fn from_index(index: usize) -> FileId { FileId { v: (index + 1) as u32 } }
    pub fn index(self: view<FileId>) -> usize { (self.v - 1) as usize }
    pub fn eq(self: view<FileId>, other: view<FileId>) -> bool { self.v == other.v }
    pub fn to_raw(self: view<FileId>) -> u32 { self.v }
    pub fn from_raw(v: u32) -> FileId { FileId { v: v } }
}

