fn buf_matches_slice(buf: view<CoffBuf>, expected: view<[u8]>) -> bool {
    let n = len(expected);
    if buf.len != n {
        return false;
    }
    let mut i: usize = 0;
    while i < n {
        let b = unsafe { *(buf.ptr + i) };
        if b != expected[i] {
            return false;
        }
        i = i + 1;
    }
    true
}

// 1. Differential test against `tests/obj/cdriver_coff.c` `test_basic_obj()` (`basic.obj`)
fn test_cdriver_basic_obj_diff() -> i32 {
    let mut model = objmodel_new();
    let text_id = objmodel_add_section_str(mut_view(model), { ".text" }, AX_SEC_CODE, AX_SEC_FLAG_EXEC | AX_SEC_FLAG_READ, 16u32);
    let code: [6]u8 = [0xB8u8, 0x2Au8, 0x00u8, 0x00u8, 0x00u8, 0xC3u8];
    objmodel_section_append_slice(mut_view(model), SectionId { v: text_id.v }, view(code));
    let _ = objmodel_add_symbol_str(mut_view(model), { "main" }, SectionId { v: text_id.v }, 0u64, 6u64, AX_SYM_GLOBAL);

    let bss_id = objmodel_add_section_str(mut_view(model), { ".bss" }, AX_SEC_BSS, AX_SEC_FLAG_READ | AX_SEC_FLAG_WRITE, 16u32);
    let _ = objmodel_add_symbol_str(mut_view(model), { "my_bss" }, SectionId { v: bss_id.v }, 0u64, 8u64, AX_SYM_GLOBAL);

    let mut buf = coff_encode_bytes(view(model));
    let exp_basic = EXPECTED_BASIC_OBJ;
    if !buf_matches_slice(view(buf), view(exp_basic)) {
        coff_buf_free(mut_view(buf));
        objmodel_free(mut_view(model));
        return 10;
    }

    // Decode and verify header & BSS section sizing
    let hdr = coff_decode_file_header(buf.ptr as *const u8, 0);
    if hdr.machine != IMAGE_FILE_MACHINE_AMD64 || hdr.number_of_sections != 2u16 || hdr.number_of_symbols != 2u32 {
        coff_buf_free(mut_view(buf));
        objmodel_free(mut_view(model));
        return 11;
    }
    let sh_bss = coff_decode_section_header(buf.ptr as *const u8, 20 + 40);
    if sh_bss.size_of_raw_data != 8u32 || sh_bss.pointer_to_raw_data != 0u32 {
        coff_buf_free(mut_view(buf));
        objmodel_free(mut_view(model));
        return 12;
    }

    coff_buf_free(mut_view(buf));
    objmodel_free(mut_view(model));
    0
}

// 2. Differential test against `tests/obj/cdriver_coff.c` `test_relocs_obj()` (`relocs.obj`)
fn test_cdriver_relocs_obj_diff() -> i32 {
    let mut model = objmodel_new();
    let text_id = objmodel_add_section_str(mut_view(model), { ".text" }, AX_SEC_CODE, AX_SEC_FLAG_EXEC | AX_SEC_FLAG_READ, 16u32);
    let data_id = objmodel_add_section_str(mut_view(model), { ".data" }, AX_SEC_DATA, AX_SEC_FLAG_READ | AX_SEC_FLAG_WRITE, 8u32);
    let rdata_id = objmodel_add_section_str(mut_view(model), { ".rdata" }, AX_SEC_RODATA, AX_SEC_FLAG_READ, 8u32);

    // UTF-8 bytes of "Xin chào thế giới\0" (23 bytes)
    let msg_bytes: [23]u8 = [
        88u8, 105u8, 110u8, 32u8, 99u8, 104u8, 195u8, 160u8,
        111u8, 32u8, 116u8, 104u8, 225u8, 186u8, 191u8, 32u8,
        103u8, 105u8, 225u8, 187u8, 155u8, 105u8, 0u8,
    ];
    objmodel_section_append_slice(mut_view(model), SectionId { v: rdata_id.v }, view(msg_bytes));
    let msg_sym = objmodel_add_symbol_str(mut_view(model), { "msg" }, SectionId { v: rdata_id.v }, 0u64, 23u64, AX_SYM_LOCAL);

    let data_bytes: [16]u8 = [
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0x0Du8, 0xF0u8, 0xDEu8, 0xC0u8, 0xEFu8, 0xBEu8, 0xADu8, 0xDEu8,
    ];
    objmodel_section_append_slice(mut_view(model), SectionId { v: data_id.v }, view(data_bytes));
    objmodel_section_add_reloc(mut_view(model), SectionId { v: data_id.v }, 0u32, AX_RELOC_X86_64_64, SymbolId { v: msg_sym.v }, 0i64);
    let _ = objmodel_add_symbol_str(mut_view(model), { "my_data_word" }, SectionId { v: data_id.v }, 8u64, 8u64, AX_SYM_GLOBAL);
    let ptr_sym = objmodel_add_symbol_str(mut_view(model), { "ptr_to_msg" }, SectionId { v: data_id.v }, 0u64, 8u64, AX_SYM_LOCAL);

    let text_bytes: [21]u8 = [
        0x48u8, 0x83u8, 0xECu8, 0x28u8,
        0x48u8, 0x8Bu8, 0x0Du8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
        0xE8u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
        0x48u8, 0x83u8, 0xC4u8, 0x28u8, 0xC3u8,
    ];
    objmodel_section_append_slice(mut_view(model), SectionId { v: text_id.v }, view(text_bytes));
    let check_data_sym = objmodel_add_symbol_str(mut_view(model), { "check_data" }, SectionId.none(), 0u64, 0u64, AX_SYM_EXTERNAL);
    objmodel_section_add_reloc(mut_view(model), SectionId { v: text_id.v }, 7u32, AX_RELOC_X86_64_PC32, SymbolId { v: ptr_sym.v }, -4i64);
    objmodel_section_add_reloc(mut_view(model), SectionId { v: text_id.v }, 12u32, AX_RELOC_X86_64_PC32, SymbolId { v: check_data_sym.v }, -4i64);
    let _ = objmodel_add_symbol_str(mut_view(model), { "main" }, SectionId { v: text_id.v }, 0u64, 21u64, AX_SYM_GLOBAL);

    let mut buf = coff_encode_bytes(view(model));
    let exp_relocs = EXPECTED_RELOCS_OBJ;
    if !buf_matches_slice(view(buf), view(exp_relocs)) {
        coff_buf_free(mut_view(buf));
        objmodel_free(mut_view(model));
        return 20;
    }

    // Verify decoded relocation and symbol records
    let sh_text = coff_decode_section_header(buf.ptr as *const u8, 20);
    if sh_text.number_of_relocations != 2u16 {
        coff_buf_free(mut_view(buf));
        objmodel_free(mut_view(model));
        return 21;
    }
    let r0 = coff_decode_relocation(buf.ptr as *const u8, sh_text.pointer_to_relocations as usize);
    let r1 = coff_decode_relocation(buf.ptr as *const u8, (sh_text.pointer_to_relocations as usize) + 10);
    if r0.virtual_address != 7u32 || r0.symbol_table_index != 2u32 || r0.reloc_type != IMAGE_REL_AMD64_REL32 {
        coff_buf_free(mut_view(buf));
        objmodel_free(mut_view(model));
        return 22;
    }
    if r1.virtual_address != 12u32 || r1.symbol_table_index != 3u32 || r1.reloc_type != IMAGE_REL_AMD64_REL32 {
        coff_buf_free(mut_view(buf));
        objmodel_free(mut_view(model));
        return 23;
    }

    let hdr = coff_decode_file_header(buf.ptr as *const u8, 0);
    let sym0 = coff_decode_symbol_record(buf.ptr as *const u8, hdr.pointer_to_symbol_table as usize);
    let sym1 = coff_decode_symbol_record(buf.ptr as *const u8, (hdr.pointer_to_symbol_table as usize) + 18);
    if sym0.zeroes == 0u32 || sym0.section_number != 3i16 || sym0.storage_class != IMAGE_SYM_CLASS_STATIC {
        coff_buf_free(mut_view(buf));
        objmodel_free(mut_view(model));
        return 24;
    }
    if sym1.zeroes != 0u32 || sym1.offset != 4u32 || sym1.section_number != 2i16 || sym1.storage_class != IMAGE_SYM_CLASS_EXTERNAL {
        coff_buf_free(mut_view(buf));
        objmodel_free(mut_view(model));
        return 25;
    }

    coff_buf_free(mut_view(buf));
    objmodel_free(mut_view(model));
    0
}

// 3. Differential test against `tests/obj/cdriver_coff.c` `addr32nb.obj`
fn test_cdriver_addr32nb_obj_diff() -> i32 {
    let mut model = objmodel_new();
    let pdata_id = objmodel_add_section_str(mut_view(model), { ".pdata" }, AX_SEC_RODATA, AX_SEC_FLAG_READ, 4u32);
    let z4: [4]u8 = [0u8, 0u8, 0u8, 0u8];
    objmodel_section_append_slice(mut_view(model), SectionId { v: pdata_id.v }, view(z4));
    let dummy_sym = objmodel_add_symbol_str(mut_view(model), { "dummy_func" }, SectionId.none(), 0u64, 0u64, AX_SYM_EXTERNAL);
    objmodel_section_add_reloc(mut_view(model), SectionId { v: pdata_id.v }, 0u32, AX_RELOC_X86_64_32, SymbolId { v: dummy_sym.v }, 0i64);

    let mut buf = coff_encode_bytes(view(model));
    let exp_addr32nb = EXPECTED_ADDR32NB_OBJ;
    if !buf_matches_slice(view(buf), view(exp_addr32nb)) {
        coff_buf_free(mut_view(buf));
        objmodel_free(mut_view(model));
        return 30;
    }
    let sh_pdata = coff_decode_section_header(buf.ptr as *const u8, 20);
    let r0 = coff_decode_relocation(buf.ptr as *const u8, sh_pdata.pointer_to_relocations as usize);
    if r0.reloc_type != IMAGE_REL_AMD64_ADDR32NB {
        coff_buf_free(mut_view(buf));
        objmodel_free(mut_view(model));
        return 31;
    }

    coff_buf_free(mut_view(buf));
    objmodel_free(mut_view(model));
    0
}

// 4. Inline relocation addend patching test across PC32, PLT32, 32, GOT32, and 64
fn test_inline_addend_patching() -> i32 {
    let mut model = objmodel_new();
    let sec_id = objmodel_add_section_str(mut_view(model), { ".text" }, AX_SEC_CODE, AX_SEC_FLAG_EXEC | AX_SEC_FLAG_READ, 16u32);
    let z24: [24]u8 = [0u8; 24];
    objmodel_section_append_slice(mut_view(model), SectionId { v: sec_id.v }, view(z24));
    let sym = objmodel_add_symbol_str(mut_view(model), { "ext_sym" }, SectionId.none(), 0u64, 0u64, AX_SYM_EXTERNAL);

    // PC32 at offset 0 with addend 0 -> inline patched value = 0 + 4 = 4
    objmodel_section_add_reloc(mut_view(model), SectionId { v: sec_id.v }, 0u32, AX_RELOC_X86_64_PC32, SymbolId { v: sym.v }, 0i64);
    // PLT32 at offset 4 with addend -8 -> inline patched value = -8 + 4 = -4
    objmodel_section_add_reloc(mut_view(model), SectionId { v: sec_id.v }, 4u32, AX_RELOC_X86_64_PLT32, SymbolId { v: sym.v }, -8i64);
    // 32 (ADDR32NB) at offset 8 with addend 0x12345678 -> inline patched value = 0x12345678
    objmodel_section_add_reloc(mut_view(model), SectionId { v: sec_id.v }, 8u32, AX_RELOC_X86_64_32, SymbolId { v: sym.v }, 0x12345678i64);
    // GOT32 at offset 12 with addend -16 -> inline patched value = -16
    objmodel_section_add_reloc(mut_view(model), SectionId { v: sec_id.v }, 12u32, AX_RELOC_X86_64_GOT32, SymbolId { v: sym.v }, -16i64);
    // 64 (ADDR64) at offset 16 with addend 0x0102030405060708 -> inline patched 64-bit value
    objmodel_section_add_reloc(mut_view(model), SectionId { v: sec_id.v }, 16u32, AX_RELOC_X86_64_64, SymbolId { v: sym.v }, 0x0102030405060708i64);

    let mut buf = coff_encode_bytes(view(model));
    let sh = coff_decode_section_header(buf.ptr as *const u8, 20);
    let raw_off = sh.pointer_to_raw_data as usize;
    let p = buf.ptr as *const u8;

    if coff_read_i32_le(p, raw_off + 0) != 4i32 {
        coff_buf_free(mut_view(buf));
        objmodel_free(mut_view(model));
        return 40;
    }
    if coff_read_i32_le(p, raw_off + 4) != -4i32 {
        coff_buf_free(mut_view(buf));
        objmodel_free(mut_view(model));
        return 41;
    }
    if coff_read_i32_le(p, raw_off + 8) != 0x12345678i32 {
        coff_buf_free(mut_view(buf));
        objmodel_free(mut_view(model));
        return 42;
    }
    if coff_read_i32_le(p, raw_off + 12) != -16i32 {
        coff_buf_free(mut_view(buf));
        objmodel_free(mut_view(model));
        return 43;
    }
    if coff_read_u64_le(p, raw_off + 16) != 0x0102030405060708u64 {
        coff_buf_free(mut_view(buf));
        objmodel_free(mut_view(model));
        return 44;
    }

    coff_buf_free(mut_view(buf));
    objmodel_free(mut_view(model));
    0
}

fn read_file_to_coff_buf(path: Str) -> CoffBuf {
    let pbytes: view<[u8]> = unsafe { *(address_of(path) as *const view<[u8]>) };
    let plen = len(pbytes);
    let mut path_buf = coff_buf_with_capacity(plen + 1);
    let mut i: usize = 0;
    while i < plen {
        coff_buf_put_u8(mut_view(path_buf), pbytes[i]);
        i = i + 1;
    }
    coff_buf_put_u8(mut_view(path_buf), 0u8);
    let h = unsafe { open(path_buf.ptr as *const u8, plen, 0u32) };
    coff_buf_free(mut_view(path_buf));
    if h < 0 {
        return coff_buf_with_capacity(0);
    }
    let sz = file_size(h);
    if sz <= 0 {
        let _ = close(h);
        return coff_buf_with_capacity(0);
    }
    let usize_sz = sz as usize;
    let mut buf = coff_buf_with_capacity(usize_sz);
    let mut total_read: usize = 0;
    while total_read < usize_sz {
        let dst = unsafe { buf.ptr + total_read };
        let rem = usize_sz - total_read;
        let rd = unsafe { read(h, dst, rem) };
        if rd <= 0 {
            break;
        }
        total_read = total_read + (rd as usize);
    }
    buf.len = total_read;
    let _ = close(h);
    buf
}

fn delete_file_str(path: Str) {
    let pbytes: view<[u8]> = unsafe { *(address_of(path) as *const view<[u8]>) };
    let plen = len(pbytes);
    let mut path_buf = coff_buf_with_capacity(plen + 1);
    let mut i: usize = 0;
    while i < plen {
        coff_buf_put_u8(mut_view(path_buf), pbytes[i]);
        i = i + 1;
    }
    coff_buf_put_u8(mut_view(path_buf), 0u8);
    let _ = unsafe { remove(path_buf.ptr as *const u8, plen) };
    coff_buf_free(mut_view(path_buf));
}

// 5. Differential test against `axiom0 build --emit=obj` on `ret42.ax` and `calls.ax`,
//    plus on-disk file I/O roundtrip via `coff_write_str`.
fn test_axiom0_emit_obj_diff_and_file_roundtrip() -> i32 {
    // 5a. ret42.ax
    let mut m_ret42 = objmodel_new();
    let rdata1 = objmodel_add_section_str(mut_view(m_ret42), { ".rdata" }, AX_SEC_RODATA, AX_SEC_FLAG_READ, 16u32);
    let text1 = objmodel_add_section_str(mut_view(m_ret42), { ".text" }, AX_SEC_CODE, AX_SEC_FLAG_EXEC | AX_SEC_FLAG_READ, 16u32);
    let z1: [1]u8 = [0u8];
    let ret42_text = RET42_TEXT_BYTES;
    objmodel_section_append_slice(mut_view(m_ret42), SectionId { v: rdata1.v }, view(z1));
    objmodel_section_append_slice(mut_view(m_ret42), SectionId { v: text1.v }, view(ret42_text));
    let _ = objmodel_add_symbol_str(mut_view(m_ret42), { "prelude_loaded" }, SectionId { v: text1.v }, 0u64, 72u64, AX_SYM_GLOBAL);
    let _ = objmodel_add_symbol_str(mut_view(m_ret42), { "main" }, SectionId { v: text1.v }, 80u64, 72u64, AX_SYM_GLOBAL);
    let _ = objmodel_add_symbol_str(mut_view(m_ret42), { "ax_main" }, SectionId { v: text1.v }, 80u64, 72u64, AX_SYM_GLOBAL);

    let mut buf_ret42 = coff_encode_bytes(view(m_ret42));
    let exp_ret42 = EXPECTED_RET42_OBJ;
    if !buf_matches_slice(view(buf_ret42), view(exp_ret42)) {
        coff_buf_free(mut_view(buf_ret42));
        objmodel_free(mut_view(m_ret42));
        return 50;
    }
    coff_buf_free(mut_view(buf_ret42));
    objmodel_free(mut_view(m_ret42));

    // 5b. calls.ax
    let mut m_calls = objmodel_new();
    let rdata2 = objmodel_add_section_str(mut_view(m_calls), { ".rdata" }, AX_SEC_RODATA, AX_SEC_FLAG_READ, 16u32);
    let text2 = objmodel_add_section_str(mut_view(m_calls), { ".text" }, AX_SEC_CODE, AX_SEC_FLAG_EXEC | AX_SEC_FLAG_READ, 16u32);
    let calls_rdata = CALLS_RDATA_BYTES;
    let calls_text = CALLS_TEXT_BYTES;
    objmodel_section_append_slice(mut_view(m_calls), SectionId { v: rdata2.v }, view(calls_rdata));
    objmodel_section_append_slice(mut_view(m_calls), SectionId { v: text2.v }, view(calls_text));

    let _ = objmodel_add_symbol_str(mut_view(m_calls), { "prelude_loaded" }, SectionId { v: text2.v }, 0u64, 72u64, AX_SYM_GLOBAL);
    let sym_add_ten_ext = objmodel_add_symbol_str(mut_view(m_calls), { "add_ten" }, SectionId.none(), 0u64, 0u64, AX_SYM_EXTERNAL);
    let _ = objmodel_add_symbol_str(mut_view(m_calls), { "main" }, SectionId { v: text2.v }, 80u64, 90u64, AX_SYM_GLOBAL);
    let _ = objmodel_add_symbol_str(mut_view(m_calls), { "ax_main" }, SectionId { v: text2.v }, 80u64, 90u64, AX_SYM_GLOBAL);
    let sym_panic_str = objmodel_add_symbol_str(mut_view(m_calls), { ".Lpanic_0" }, SectionId { v: rdata2.v }, 0u64, 28u64, AX_SYM_GLOBAL);
    let sym_axiom_panic = objmodel_add_symbol_str(mut_view(m_calls), { "axiom_panic" }, SectionId.none(), 0u64, 0u64, AX_SYM_EXTERNAL);
    let _ = objmodel_add_symbol_str(mut_view(m_calls), { "add_ten" }, SectionId { v: text2.v }, 176u64, 502u64, AX_SYM_GLOBAL);

    objmodel_section_add_reloc(mut_view(m_calls), SectionId { v: text2.v }, 126u32, AX_RELOC_X86_64_PC32, SymbolId { v: sym_add_ten_ext.v }, -4i64);
    objmodel_section_add_reloc(mut_view(m_calls), SectionId { v: text2.v }, 520u32, AX_RELOC_X86_64_PC32, SymbolId { v: sym_panic_str.v }, -4i64);
    objmodel_section_add_reloc(mut_view(m_calls), SectionId { v: text2.v }, 532u32, AX_RELOC_X86_64_PC32, SymbolId { v: sym_axiom_panic.v }, -4i64);

    let mut buf_calls = coff_encode_bytes(view(m_calls));
    let exp_calls = EXPECTED_CALLS_OBJ;
    if !buf_matches_slice(view(buf_calls), view(exp_calls)) {
        coff_buf_free(mut_view(buf_calls));
        objmodel_free(mut_view(m_calls));
        return 51;
    }
    coff_buf_free(mut_view(buf_calls));

    // 5c. On-disk file I/O roundtrip via `coff_write_str`
    delete_file_str({ "tmp_t085a_coff_roundtrip.obj" });
    if !coff_write_str(view(m_calls), { "tmp_t085a_coff_roundtrip.obj" }) {
        objmodel_free(mut_view(m_calls));
        return 52;
    }
    let mut disk_buf = read_file_to_coff_buf({ "tmp_t085a_coff_roundtrip.obj" });
    let ok_disk = buf_matches_slice(view(disk_buf), view(exp_calls));
    coff_buf_free(mut_view(disk_buf));
    delete_file_str({ "tmp_t085a_coff_roundtrip.obj" });
    if !ok_disk {
        objmodel_free(mut_view(m_calls));
        return 53;
    }

    objmodel_free(mut_view(m_calls));
    0
}

pub fn main() -> i32 {
    let rc1 = test_cdriver_basic_obj_diff();
    if rc1 != 0 { return rc1; }

    let rc2 = test_cdriver_relocs_obj_diff();
    if rc2 != 0 { return rc2; }

    let rc3 = test_cdriver_addr32nb_obj_diff();
    if rc3 != 0 { return rc3; }

    let rc4 = test_inline_addend_patching();
    if rc4 != 0 { return rc4; }

    let rc5 = test_axiom0_emit_obj_diff_and_file_roundtrip();
    if rc5 != 0 { return rc5; }

    print("OK COFF Writer Differential & Roundtrip\n");
    0
}
