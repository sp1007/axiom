@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

fn test_ids_and_coff_helpers() -> i32 {
    let s_none = SectionId.none();
    if !s_none.is_none() || s_none.is_some() || !ax_section_id_is_none(s_none) {
        return 1;
    }
    let s0 = SectionId.from_index(0);
    let s1 = SectionId.from_index(1);
    if s0.to_raw() != 1u32 || s0.index() != 0 || !s0.is_some() {
        return 2;
    }
    if s0.eq(view(s1)) || !s0.eq(view(s0)) || !ax_section_id_eq(s0, SectionId.from_raw(1u32)) {
        return 3;
    }

    let sym_none = ax_symbol_id_none();
    if !sym_none.is_none() || !ax_symbol_id_is_none(sym_none) {
        return 4;
    }
    let sym0 = SymbolId.from_index(3);
    if sym0.to_raw() != 4u32 || sym0.index() != 3 || !ax_symbol_id_eq(sym0, SymbolId.from_raw(4u32)) {
        return 5;
    }

    // Alignment flags
    if coff_align_flag(1u32) != IMAGE_SCN_ALIGN_1BYTES { return 6; }
    if coff_align_flag(2u32) != IMAGE_SCN_ALIGN_2BYTES { return 7; }
    if coff_align_flag(4u32) != IMAGE_SCN_ALIGN_4BYTES { return 8; }
    if coff_align_flag(8u32) != IMAGE_SCN_ALIGN_8BYTES { return 9; }
    if coff_align_flag(16u32) != IMAGE_SCN_ALIGN_16BYTES { return 10; }
    if coff_align_flag(32u32) != IMAGE_SCN_ALIGN_32BYTES { return 11; }
    if coff_align_flag(64u32) != IMAGE_SCN_ALIGN_64BYTES { return 12; }
    if coff_align_flag(0u32) != 0u32 || coff_align_flag(128u32) != 0u32 { return 13; }

    // Section characteristics
    let text_chars = coff_section_characteristics(AX_SEC_CODE, AX_SEC_FLAG_EXEC | AX_SEC_FLAG_READ, 16u32);
    if text_chars != (IMAGE_SCN_ALIGN_16BYTES | IMAGE_SCN_CNT_CODE | IMAGE_SCN_MEM_EXECUTE | IMAGE_SCN_MEM_READ) {
        return 14;
    }
    let rdata_chars = coff_section_characteristics(AX_SEC_RODATA, AX_SEC_FLAG_READ, 16u32);
    if rdata_chars != (IMAGE_SCN_ALIGN_16BYTES | IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_READ) {
        return 15;
    }
    let data_chars = coff_section_characteristics(AX_SEC_DATA, AX_SEC_FLAG_READ | AX_SEC_FLAG_WRITE, 8u32);
    if data_chars != (IMAGE_SCN_ALIGN_8BYTES | IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_READ | IMAGE_SCN_MEM_WRITE) {
        return 16;
    }
    let bss_chars = coff_section_characteristics(AX_SEC_BSS, AX_SEC_FLAG_READ | AX_SEC_FLAG_WRITE, 16u32);
    if bss_chars != (IMAGE_SCN_ALIGN_16BYTES | IMAGE_SCN_CNT_UNINITIALIZED_DATA | IMAGE_SCN_MEM_READ | IMAGE_SCN_MEM_WRITE) {
        return 17;
    }

    // Relocation type and storage class mapping
    if coff_reloc_type(AX_RELOC_X86_64_PC32) != IMAGE_REL_AMD64_REL32 { return 18; }
    if coff_reloc_type(AX_RELOC_X86_64_PLT32) != IMAGE_REL_AMD64_REL32 { return 19; }
    if coff_reloc_type(AX_RELOC_X86_64_64) != IMAGE_REL_AMD64_ADDR64 { return 20; }
    if coff_reloc_type(AX_RELOC_X86_64_32) != IMAGE_REL_AMD64_ADDR32NB { return 21; }
    if coff_reloc_type(AX_RELOC_NONE) != IMAGE_REL_AMD64_ABSOLUTE { return 22; }

    if coff_storage_class(AX_SYM_LOCAL) != IMAGE_SYM_CLASS_STATIC { return 23; }
    if coff_storage_class(AX_SYM_GLOBAL) != IMAGE_SYM_CLASS_EXTERNAL { return 24; }
    if coff_storage_class(AX_SYM_EXTERNAL) != IMAGE_SYM_CLASS_EXTERNAL { return 25; }

    // Little-endian read/write helpers
    let mut scratch: [16]u8 = [0u8; 16];
    let p_mut = unsafe { address_of_mut(scratch[0]) };
    let p_const = p_mut as *const u8;
    coff_write_u16_le(p_mut, 0, 0x8664u16);
    coff_write_u32_le(p_mut, 2, 0xDEADBEEFu32);
    coff_write_u64_le(p_mut, 6, 0x0123456789ABCDEFu64);
    if coff_read_u16_le(p_const, 0) != IMAGE_FILE_MACHINE_AMD64 { return 26; }
    if coff_read_u32_le(p_const, 2) != 0xDEADBEEFu32 { return 27; }
    if coff_read_u64_le(p_const, 6) != 0x0123456789ABCDEFu64 { return 28; }
    coff_write_u32_le(p_mut, 2, (-4i32) as u32);
    if coff_read_i32_le(p_const, 2) != -4i32 { return 29; }

    0
}

fn test_objmodel_sections_symbols_and_relocs() -> i32 {
    let mut model = objmodel_new();
    if objmodel_section_count(view(model)) != 0 || objmodel_symbol_count(view(model)) != 0 {
        return 30;
    }

    // Verify stack C-string ownership in str_arena (mutating stack buffer after add must not affect section/symbol name)
    let mut stack_sec_name: [7]u8 = [46u8, 116u8, 101u8, 120u8, 116u8, 0u8, 0u8]; // ".text\0"
    let text_id = objmodel_add_section(
        mut_view(model),
        unsafe { address_of(stack_sec_name[0]) },
        AX_SEC_CODE,
        AX_SEC_FLAG_EXEC | AX_SEC_FLAG_READ,
        16u32
    );
    stack_sec_name[1] = 88u8; // mutate caller stack buffer to ".Xext"

    let rdata_id = objmodel_add_section_str(mut_view(model), { ".rdata" }, AX_SEC_RODATA, AX_SEC_FLAG_READ, 16u32);
    let data_id = objmodel_add_section_str(mut_view(model), { ".data" }, AX_SEC_DATA, AX_SEC_FLAG_READ | AX_SEC_FLAG_WRITE, 8u32);
    let bss_id = objmodel_add_section_str(mut_view(model), { ".bss" }, AX_SEC_BSS, AX_SEC_FLAG_READ | AX_SEC_FLAG_WRITE, 16u32);

    if text_id.v != 1u32 || rdata_id.v != 2u32 || data_id.v != 3u32 || bss_id.v != 4u32 {
        return 31;
    }
    if objmodel_section_count(view(model)) != 4 {
        return 32;
    }

    // Verify section lookup by name and out-of-bounds guards
    if objmodel_find_section_str(view(model), { ".text" }).v != 1u32 { return 33; }
    if objmodel_find_section_str(view(model), { ".rdata" }).v != 2u32 { return 34; }
    if objmodel_find_section_str(view(model), { ".data" }).v != 3u32 { return 35; }
    if objmodel_find_section_str(view(model), { ".bss" }).v != 4u32 { return 36; }
    if !objmodel_find_section_str(view(model), { ".nonexistent" }).is_none() { return 37; }
    if (objmodel_get_section(view(model), SectionId.none()) as usize) != 0 { return 38; }
    if (objmodel_get_section(view(model), SectionId { v: 99u32 }) as usize) != 0 { return 39; }

    let text_sec = objmodel_get_section_mut(mut_view(model), SectionId { v: text_id.v });
    if (text_sec as usize) == 0 { return 40; }
    if (unsafe { (*text_sec).id.v }) != 1u32 || (unsafe { cstr_len((*text_sec).name) }) != 5 {
        return 41;
    }

    // Grow section bytes across multiple capacity doublings (> 64 bytes)
    let mut b_i: usize = 0;
    while b_i < 70 {
        unsafe { section_add_byte(mut_view(*text_sec), (b_i & 0xFF) as u8); }
        b_i = b_i + 1;
    }
    let tail_slice: [4]u8 = [0xAAu8, 0xBBu8, 0xCCu8, 0xDDu8];
    objmodel_section_append_slice(mut_view(model), SectionId { v: text_id.v }, view(tail_slice));
    unsafe { section_append_zeroes(mut_view(*text_sec), 6); }

    if (unsafe { section_bytes_len(view(*text_sec)) }) != 80 {
        return 42;
    }
    if (unsafe { section_byte_at(view(*text_sec), 0) }) != 0u8 ||
       (unsafe { section_byte_at(view(*text_sec), 69) }) != 69u8 ||
       (unsafe { section_byte_at(view(*text_sec), 70) }) != 0xAAu8 ||
       (unsafe { section_byte_at(view(*text_sec), 73) }) != 0xDDu8 ||
       (unsafe { section_byte_at(view(*text_sec), 79) }) != 0u8 {
        return 43;
    }

    // Add symbols (short <= 8, exact 8, long > 8)
    let sym_short = objmodel_add_symbol_str(mut_view(model), { "main" }, SectionId { v: text_id.v }, 0u64, 80u64, AX_SYM_GLOBAL);
    let sym_exact8 = objmodel_add_symbol_str(mut_view(model), { "12345678" }, SectionId { v: data_id.v }, 8u64, 8u64, AX_SYM_LOCAL);
    let sym_long9 = objmodel_add_symbol_str(mut_view(model), { "123456789" }, SectionId { v: rdata_id.v }, 0u64, 16u64, AX_SYM_LOCAL);
    let sym_ext = objmodel_add_symbol_str(mut_view(model), { "external_helper_fn" }, SectionId.none(), 0u64, 0u64, AX_SYM_EXTERNAL);

    if sym_short.v != 1u32 || sym_exact8.v != 2u32 || sym_long9.v != 3u32 || sym_ext.v != 4u32 {
        return 44;
    }
    if objmodel_symbol_count(view(model)) != 4 {
        return 45;
    }
    if objmodel_find_symbol_str(view(model), { "main" }).v != 1u32 { return 46; }
    if objmodel_find_symbol_str(view(model), { "12345678" }).v != 2u32 { return 47; }
    if objmodel_find_symbol_str(view(model), { "123456789" }).v != 3u32 { return 48; }
    if objmodel_find_symbol_str(view(model), { "external_helper_fn" }).v != 4u32 { return 49; }
    if !objmodel_find_symbol_str(view(model), { "missing_sym" }).is_none() { return 50; }
    if (objmodel_get_symbol(view(model), SymbolId.none()) as usize) != 0 { return 51; }

    let sym3 = objmodel_get_symbol(view(model), SymbolId { v: sym_long9.v });
    if (sym3 as usize) == 0 || (unsafe { (*sym3).id.v }) != 3u32 || (unsafe { (*sym3).size }) != 16u64 {
        return 52;
    }

    // Grow section relocations across multiple capacity doublings (> 16 relocs)
    let mut r_i: u32 = 0u32;
    while r_i < 20u32 {
        objmodel_section_add_reloc(
            mut_view(model),
            SectionId { v: text_id.v },
            r_i << 2u32,
            AX_RELOC_X86_64_PC32,
            SymbolId { v: sym_ext.v },
            -4i64
        );
        r_i = r_i + 1u32;
    }
    let text_sec_after = objmodel_get_section(view(model), SectionId { v: text_id.v });
    if (unsafe { section_relocs_len(view(*text_sec_after)) }) != 20 {
        return 53;
    }
    let rel19 = unsafe { section_reloc_at(view(*text_sec_after), 19) };
    if (rel19 as usize) == 0 ||
       (unsafe { (*rel19).offset }) != 76u32 ||
       (unsafe { (*rel19).kind }) != AX_RELOC_X86_64_PC32 ||
       (unsafe { (*rel19).symbol_id.v }) != sym_ext.v ||
       (unsafe { (*rel19).addend }) != -4i64 {
        return 54;
    }

    objmodel_free(mut_view(model));
    0
}

pub fn main() -> i32 {
    let rc1 = test_ids_and_coff_helpers();
    if rc1 != 0 {
        return rc1;
    }
    let rc2 = test_objmodel_sections_symbols_and_relocs();
    if rc2 != 0 {
        return rc2;
    }
    print("OK Object Model & COFF Helpers\n");
    0
}
