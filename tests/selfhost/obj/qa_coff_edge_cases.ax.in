// test: run
// timeout: 600
// stdout: OK COFF Edge Cases & Seam Checks\n

module main

use compiler.obj.CoffBuf
use compiler.obj.coff_buf_new
use compiler.obj.coff_buf_free
use compiler.obj.SectionId
use compiler.obj.SymbolId
use compiler.obj.AX_SEC_CODE
use compiler.obj.AX_SEC_DATA
use compiler.obj.AX_SEC_RODATA
use compiler.obj.AX_SEC_BSS
use compiler.obj.AX_SEC_FLAG_EXEC
use compiler.obj.AX_SEC_FLAG_READ
use compiler.obj.AX_SEC_FLAG_WRITE
use compiler.obj.AX_RELOC_X86_64_PC32
use compiler.obj.AX_RELOC_X86_64_PLT32
use compiler.obj.AX_RELOC_X86_64_32
use compiler.obj.AX_RELOC_X86_64_GOT32
use compiler.obj.AX_RELOC_X86_64_64
use compiler.obj.AX_SYM_LOCAL
use compiler.obj.AX_SYM_GLOBAL
use compiler.obj.AX_SYM_EXTERNAL
use compiler.obj.IMAGE_FILE_MACHINE_AMD64
use compiler.obj.coff_decode_file_header
use compiler.obj.coff_decode_section_header
use compiler.obj.coff_decode_symbol_record
use compiler.obj.coff_read_u32_le
use compiler.obj.coff_read_i32_le
use compiler.obj.coff_read_u64_le
use compiler.obj.ObjModel
use compiler.obj.objmodel_new
use compiler.obj.objmodel_free
use compiler.obj.objmodel_add_section_str
use compiler.obj.objmodel_add_symbol_str
use compiler.obj.objmodel_get_section
use compiler.obj.objmodel_get_symbol
use compiler.obj.objmodel_section_append_slice
use compiler.obj.objmodel_section_add_reloc
use compiler.obj.section_byte_at
use compiler.obj.section_reloc_at
use compiler.obj.coff_encode_bytes
use compiler.obj.coff_write
use compiler.obj.coff_write_path_bytes
use compiler.obj.coff_write_str

// 1. Empty ObjModel (0 sections, 0 symbols) -> 24-byte COFF object
fn test_empty_objmodel_encoding() -> i32 {
    let mut model = objmodel_new();
    let mut buf = coff_encode_bytes(view(model));
    if buf.len != 24 {
        coff_buf_free(mut_view(buf));
        objmodel_free(mut_view(model));
        return 1;
    }
    let hdr = coff_decode_file_header(buf.ptr as *const u8, 0);
    if hdr.machine != IMAGE_FILE_MACHINE_AMD64 ||
       hdr.number_of_sections != 0u16 ||
       hdr.time_date_stamp != 0u32 ||
       hdr.pointer_to_symbol_table != 20u32 ||
       hdr.number_of_symbols != 0u32 ||
       hdr.size_of_optional_header != 0u16 ||
       hdr.characteristics != 0u16 {
        coff_buf_free(mut_view(buf));
        objmodel_free(mut_view(model));
        return 2;
    }
    let strtab_sz = coff_read_u32_le(buf.ptr as *const u8, 20);
    if strtab_sz != 4u32 {
        coff_buf_free(mut_view(buf));
        objmodel_free(mut_view(model));
        return 3;
    }
    // Idempotent double-free checks on CoffBuf and ObjModel
    coff_buf_free(mut_view(buf));
    coff_buf_free(mut_view(buf));
    objmodel_free(mut_view(model));
    objmodel_free(mut_view(model));
    0
}

// 2. Section & symbol name boundary lengths (7, 8, 9 bytes)
fn test_name_length_boundaries() -> i32 {
    let mut model = objmodel_new();
    let s7 = objmodel_add_section_str(mut_view(model), { ".abcdef" }, AX_SEC_RODATA, AX_SEC_FLAG_READ, 4u32);
    let s8 = objmodel_add_section_str(mut_view(model), { ".abcdefg" }, AX_SEC_RODATA, AX_SEC_FLAG_READ, 4u32);
    let s9 = objmodel_add_section_str(mut_view(model), { ".abcdefgh" }, AX_SEC_RODATA, AX_SEC_FLAG_READ, 4u32);

    let _ = objmodel_add_symbol_str(mut_view(model), { "sym_len" }, SectionId { v: s7.v }, 0u64, 1u64, AX_SYM_LOCAL);
    let _ = objmodel_add_symbol_str(mut_view(model), { "sym_len8" }, SectionId { v: s8.v }, 0u64, 1u64, AX_SYM_GLOBAL);
    let _ = objmodel_add_symbol_str(mut_view(model), { "sym_len_9" }, SectionId { v: s9.v }, 0u64, 1u64, AX_SYM_GLOBAL);
    let _ = objmodel_add_symbol_str(mut_view(model), { "second_long_sym" }, SectionId.none(), 0u64, 0u64, AX_SYM_EXTERNAL);

    let mut buf = coff_encode_bytes(view(model));
    let p = buf.ptr as *const u8;

    let sh0 = coff_decode_section_header(p, 20);
    let sh1 = coff_decode_section_header(p, 60);
    let sh2 = coff_decode_section_header(p, 100);
    if sh0.name[6] != 102u8 || sh0.name[7] != 0u8 {
        coff_buf_free(mut_view(buf));
        objmodel_free(mut_view(model));
        return 10;
    }
    if sh1.name[6] != 102u8 || sh1.name[7] != 103u8 {
        coff_buf_free(mut_view(buf));
        objmodel_free(mut_view(model));
        return 11;
    }
    // 9-byte section name truncated to 8 inline bytes
    if sh2.name[0] != 46u8 || sh2.name[7] != 103u8 {
        coff_buf_free(mut_view(buf));
        objmodel_free(mut_view(model));
        return 12;
    }

    let hdr = coff_decode_file_header(p, 0);
    let sym_base = hdr.pointer_to_symbol_table as usize;
    let rec0 = coff_decode_symbol_record(p, sym_base);
    let rec1 = coff_decode_symbol_record(p, sym_base + 18);
    let rec2 = coff_decode_symbol_record(p, sym_base + 36);
    let rec3 = coff_decode_symbol_record(p, sym_base + 54);

    // 7-byte and 8-byte names are inline (zeroes != 0)
    if rec0.zeroes == 0u32 || rec0.name_bytes[6] != 110u8 || rec0.name_bytes[7] != 0u8 {
        coff_buf_free(mut_view(buf));
        objmodel_free(mut_view(model));
        return 13;
    }
    if rec1.zeroes == 0u32 || rec1.name_bytes[7] != 56u8 {
        coff_buf_free(mut_view(buf));
        objmodel_free(mut_view(model));
        return 14;
    }
    // 9-byte name is in string table at offset 4; next long symbol at offset 4 + 10 = 14
    if rec2.zeroes != 0u32 || rec2.offset != 4u32 {
        coff_buf_free(mut_view(buf));
        objmodel_free(mut_view(model));
        return 15;
    }
    if rec3.zeroes != 0u32 || rec3.offset != 14u32 {
        coff_buf_free(mut_view(buf));
        objmodel_free(mut_view(model));
        return 16;
    }
    // String table size = 4 + (9 + 1) + (15 + 1) = 30
    let strtab_off = sym_base + 72;
    if coff_read_u32_le(p, strtab_off) != 30u32 {
        coff_buf_free(mut_view(buf));
        objmodel_free(mut_view(model));
        return 17;
    }

    coff_buf_free(mut_view(buf));
    objmodel_free(mut_view(model));
    0
}

// 3. BSS section with multiple out-of-order symbols followed by initialized section
fn test_bss_layout_and_following_section_offsets() -> i32 {
    let mut model = objmodel_new();
    let bss_id = objmodel_add_section_str(mut_view(model), { ".bss" }, AX_SEC_BSS, AX_SEC_FLAG_READ | AX_SEC_FLAG_WRITE, 16u32);
    let data_id = objmodel_add_section_str(mut_view(model), { ".data" }, AX_SEC_DATA, AX_SEC_FLAG_READ | AX_SEC_FLAG_WRITE, 8u32);
    let text_id = objmodel_add_section_str(mut_view(model), { ".text" }, AX_SEC_CODE, AX_SEC_FLAG_EXEC | AX_SEC_FLAG_READ, 16u32);

    // Out-of-order BSS symbols: (val=32, size=16 -> 48), (val=0, size=8 -> 8), (val=16, size=8 -> 24)
    let _ = objmodel_add_symbol_str(mut_view(model), { "bss_high" }, SectionId { v: bss_id.v }, 32u64, 16u64, AX_SYM_GLOBAL);
    let _ = objmodel_add_symbol_str(mut_view(model), { "bss_low" }, SectionId { v: bss_id.v }, 0u64, 8u64, AX_SYM_LOCAL);
    let _ = objmodel_add_symbol_str(mut_view(model), { "bss_mid" }, SectionId { v: bss_id.v }, 16u64, 8u64, AX_SYM_LOCAL);
    // Symbol in .data with larger value+size must not affect .bss SizeOfRawData
    let _ = objmodel_add_symbol_str(mut_view(model), { "data_sym" }, SectionId { v: data_id.v }, 0u64, 4u64, AX_SYM_GLOBAL);

    let dbytes: [4]u8 = [1u8, 2u8, 3u8, 4u8];
    let tbytes: [2]u8 = [0x90u8, 0xC3u8];
    objmodel_section_append_slice(mut_view(model), SectionId { v: data_id.v }, view(dbytes));
    objmodel_section_append_slice(mut_view(model), SectionId { v: text_id.v }, view(tbytes));

    let mut buf = coff_encode_bytes(view(model));
    let p = buf.ptr as *const u8;

    // 3 sections -> headers end at 20 + 3*40 = 140
    let sh_bss = coff_decode_section_header(p, 20);
    let sh_data = coff_decode_section_header(p, 60);
    let sh_text = coff_decode_section_header(p, 100);

    if sh_bss.size_of_raw_data != 48u32 || sh_bss.pointer_to_raw_data != 0u32 {
        coff_buf_free(mut_view(buf));
        objmodel_free(mut_view(model));
        return 20;
    }
    if sh_data.size_of_raw_data != 4u32 || sh_data.pointer_to_raw_data != 140u32 {
        coff_buf_free(mut_view(buf));
        objmodel_free(mut_view(model));
        return 21;
    }
    if sh_text.size_of_raw_data != 2u32 || sh_text.pointer_to_raw_data != 144u32 {
        coff_buf_free(mut_view(buf));
        objmodel_free(mut_view(model));
        return 22;
    }

    coff_buf_free(mut_view(buf));
    objmodel_free(mut_view(model));
    0
}

// 4. Non-destructive repeated emission with inline relocation patching
fn test_non_destructive_repeated_emission() -> i32 {
    let mut model = objmodel_new();
    let text_id = objmodel_add_section_str(mut_view(model), { ".text" }, AX_SEC_CODE, AX_SEC_FLAG_EXEC | AX_SEC_FLAG_READ, 16u32);
    let orig: [16]u8 = [0xAAu8; 16];
    objmodel_section_append_slice(mut_view(model), SectionId { v: text_id.v }, view(orig));
    let ext = objmodel_add_symbol_str(mut_view(model), { "target" }, SectionId.none(), 0u64, 0u64, AX_SYM_EXTERNAL);
    objmodel_section_add_reloc(mut_view(model), SectionId { v: text_id.v }, 0u32, AX_RELOC_X86_64_PC32, SymbolId { v: ext.v }, -4i64);
    objmodel_section_add_reloc(mut_view(model), SectionId { v: text_id.v }, 8u32, AX_RELOC_X86_64_64, SymbolId { v: ext.v }, 0x1122334455667788i64);

    let mut buf1 = coff_encode_bytes(view(model));
    let mut buf2 = coff_encode_bytes(view(model));

    // Underlying section bytes in model must still be 0xAA (not mutated by inline addend patching)
    let sec_ptr = objmodel_get_section(view(model), SectionId { v: text_id.v });
    let mut i: usize = 0;
    while i < 16 {
        if (unsafe { section_byte_at(view(*sec_ptr), i) }) != 0xAAu8 {
            coff_buf_free(mut_view(buf1));
            coff_buf_free(mut_view(buf2));
            objmodel_free(mut_view(model));
            return 30;
        }
        i = i + 1;
    }

    // Both emitted buffers must be byte-for-byte identical
    if buf1.len != buf2.len || buf1.len == 0 {
        coff_buf_free(mut_view(buf1));
        coff_buf_free(mut_view(buf2));
        objmodel_free(mut_view(model));
        return 31;
    }
    i = 0;
    while i < buf1.len {
        let b1 = unsafe { *(buf1.ptr + i) };
        let b2 = unsafe { *(buf2.ptr + i) };
        if b1 != b2 {
            coff_buf_free(mut_view(buf1));
            coff_buf_free(mut_view(buf2));
            objmodel_free(mut_view(model));
            return 32;
        }
        i = i + 1;
    }

    coff_buf_free(mut_view(buf1));
    coff_buf_free(mut_view(buf2));
    objmodel_free(mut_view(model));
    0
}

// 5. Negative / boundary guard checks
fn test_negative_and_boundary_guards() -> i32 {
    let mut model = objmodel_new();
    let sec_id = objmodel_add_section_str(mut_view(model), { ".text" }, AX_SEC_CODE, AX_SEC_FLAG_EXEC | AX_SEC_FLAG_READ, 16u32);
    let sec_ptr = objmodel_get_section(view(model), SectionId { v: sec_id.v });

    if (unsafe { section_byte_at(view(*sec_ptr), 0) }) != 0u8 {
        objmodel_free(mut_view(model));
        return 40;
    }
    if (unsafe { section_reloc_at(view(*sec_ptr), 0) } as usize) != 0 {
        objmodel_free(mut_view(model));
        return 41;
    }
    if (objmodel_get_symbol(view(model), SymbolId { v: 1u32 }) as usize) != 0 {
        objmodel_free(mut_view(model));
        return 42;
    }
    if coff_write(view(model), 0 as *const u8) {
        objmodel_free(mut_view(model));
        return 43;
    }
    if coff_write_path_bytes(view(model), 0 as *const u8, 10) {
        objmodel_free(mut_view(model));
        return 44;
    }
    if coff_write_str(view(model), { "" }) {
        objmodel_free(mut_view(model));
        return 45;
    }

    objmodel_free(mut_view(model));
    0
}

pub fn main() -> i32 {
    let rc1 = test_empty_objmodel_encoding();
    if rc1 != 0 { return rc1; }

    let rc2 = test_name_length_boundaries();
    if rc2 != 0 { return rc2; }

    let rc3 = test_bss_layout_and_following_section_offsets();
    if rc3 != 0 { return rc3; }

    let rc4 = test_non_destructive_repeated_emission();
    if rc4 != 0 { return rc4; }

    let rc5 = test_negative_and_boundary_guards();
    if rc5 != 0 { return rc5; }

    print("OK COFF Edge Cases & Seam Checks\n");
    0
}
