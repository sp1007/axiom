pub fn diag_code_default_message(c: DiagCode) -> Str {
    match c.v {
        0u32 => "invalid UTF-8 byte sequence", 1u32 => "character that cannot start a token",
        2u32 => "non-ASCII character outside literals and comments", 3u32 => "block comment open at end of file",
        4u32 => "line break or end of file inside a string", 5u32 => "character literal without closing quote on the line",
        6u32 => "empty or multi-character char/byte literal", 7u32 => "unknown escape or bad \\\\x",
        8u32 => "malformed or non-scalar \\\\u{...}", 9u32 => "non-ASCII character in a byte literal",
        10u32 => "base prefix without digits", 11u32 => "upper-case base prefix",
        12u32 => "digit not valid for the base", 13u32 => "misplaced _ in a number",
        14u32 => "unknown or mismatched literal suffix", 15u32 => "integer literal above 2^64 - 1",
        16u32 => "three or more dots", 17u32 => ":: is not a token; paths use .",
        18u32 => ":= is not a token; bind with =", 19u32 => "expected a specific token",
        20u32 => "expected expression", 21u32 => "expected type",
        22u32 => "expected pattern", 23u32 => "expected item",
        24u32 => "expected a line break or ;", 25u32 => "expected loop",
        26u32 => "unclosed delimiter", 27u32 => "a line continues only when the previous line ends with an operator or this line starts with .; move the operator to the end of the previous line",
        28u32 => "comparison operators cannot be chained; use parentheses or &&", 29u32 => "assignment inside an expression; use == to compare",
        30u32 => "Axiom has no & reference operator; pass the value, or write view(x) / mut_view(x)", 31u32 => "replace var by let mut",
        32u32 => "import is not a keyword", 33u32 => "write module a.b at the top of the file; there are no inline modules",
        34u32 => "module declaration not at the start of the file", 35u32 => "item inside a block",
        36u32 => "let needs type or initializer", 37u32 => "self parameter needs a type",
        38u32 => "function body required", 39u32 => "function body not allowed here",
        40u32 => "visibility not allowed here", 41u32 => "array type must be written [N]T",
        42u32 => "reserved keyword", 43u32 => "unsupported in bootstrap",
        44u32 => "name not found in scope", 45u32 => "name defined twice in one scope",
        46u32 => "a module or type used where a value is expected", 47u32 => "a value or module used where a type is expected",
        48u32 => "use path does not name an existing item or module", 49u32 => "a local binding shadows a module name (lookup order still picks the local)",
        50u32 => "break / continue names an unknown label", 51u32 => "break or continue outside a loop",
        52u32 => "construct parsed but not lowered by this build yet (AXD-014)", 53u32 => "duplicate binding in pattern",
        54u32 => "inconsistent or-pattern bindings", 55u32 => "item or member is private",
        56u32 => "cyclic import detected", 57u32 => "expression type differs from the expected type",
        58u32 => "the type cannot be inferred; add an annotation", 59u32 => "callee is not a function",
        60u32 => "wrong number of arguments", 61u32 => "body can reach its end without producing the declared non-unit value",
        62u32 => "operator not defined for these operand types", 63u32 => "integer literal does not fit its type",
        64u32 => "unary minus applied to an unsigned type", 65u32 => "as cast between types SPEC-03 does not allow",
        66u32 => "a function declared to return never can return normally", 67u32 => "the root file has no fn main (build/run)",
        68u32 => "main signature not allowed by SPEC-03", 69u32 => "valid Axiom outside the axiom0 subset (AXD-013)",
        70u32 => "cannot assign twice to immutable variable", 71u32 => "use of possibly-uninitialized variable",
        72u32 => "unreachable statement", 73u32 => "struct has no such field",
        74u32 => "missing field in struct literal", 75u32 => "duplicate field in struct literal",
        76u32 => "array size must be a non-negative constant integer", 77u32 => "cannot index into a value of this type",
        78u32 => "the `?` operator can only be applied to values that implement Try (Option or Result)", 79u32 => "cannot use `?` operator on Option in a function that returns Result (or vice versa)",
        80u32 => "stored view might outlive the owner of the referenced data", 81u32 => "self-referencing stored views within the same struct are forbidden",
        82u32 => "overlapping implementations for trait", 83u32 => "method call is ambiguous",
        84u32 => "the trait bound is not satisfied", 85u32 => "unknown trait in derive",
        86u32 => "non-exhaustive patterns: match must cover all cases", 87u32 => "refutable pattern in local binding",
        88u32 => "unreachable pattern", 89u32 => "use of moved value",
        90u32 => "use of possibly uninitialized value", 91u32 => "cannot create a mutable view because it conflicts with an existing view",
        92u32 => "cannot create a read view because the place is mutably viewed", 93u32 => "active view outlives its originating owner place",
        94u32 => "operation requires an unsafe block or function", 95u32 => "undefined behaviour detected by interpreter oracle",
        96u32 => "arithmetic overflow during constant evaluation", 97u32 => "division by zero during constant evaluation",
        98u32 => "cyclic dependency in constant evaluation", 99u32 => "evaluation limit exceeded during constant evaluation",
        100u32 => "MIR text cannot be parsed (C-only test input, T018)", 101u32 => "a local or block id is not declared in the body",
        102u32 => "a basic block has no terminator", 103u32 => "a terminator targets a block that does not exist",
        104u32 => "operand or rvalue type differs from the place type", 105u32 => "local read before it is definitely assigned",
        106u32 => "call arguments or destination do not match the callee signature", 107u32 => "the return place type differs from the function's return type",
        108u32 => "use of a local after it was moved", 109u32 => "a value requiring a drop goes out of scope without being dropped",
        110u32 => "a value is dropped more than once", 111u32 => "direct extern call cannot run in interpreter oracle",
        112u32 => "a referenced symbol is defined in no input object or import", 113u32 => "a global symbol is defined twice",
        114u32 => "a relocation value does not fit its field", 115u32 => "input object file is malformed or of an unsupported kind",
        116u32 => "image exceeds the PE32+ size limit", 117u32 => "input file does not exist",
        118u32 => "input file exists but cannot be read", 119u32 => "output cannot be written",
        120u32 => "source file exceeds the source-database limit (T008)", 121u32 => "malformed command line (exit 2)",
        122u32 => "unknown option (exit 2)", 123u32 => "command needs an input file (exit 2)",
        124u32 => "target triple not supported (exit 2)", 125u32 => "the requested stage or emitter is not implemented in this build (AXD-014)",
        126u32 => "the MIR interpreter exceeded its step limit (SPEC-03 default, --step-limit N)", 127u32 => "the MIR interpreter exceeded its call-depth limit (SPEC-03)",
        128u32 => "no std root found (ADR-0006 Â§8)", 129u32 => "malformed or invalid package manifest axiom.toml",
        130u32 => "an internal invariant failed; data.stage, data.detail", 131u32 => "compiler-built MIR was rejected by the verifier (AXD-042)",
        132u32 => "the compiler could not allocate memory",
        _ => "",
    }
}

pub fn diag_code_severity(c: DiagCode) -> DiagSeverity {
    if c.v == AX_NAME_SHADOW_MODULE || c.v == AX_PAT_UNREACHABLE || c.v == AX_TYPE_UNREACHABLE {
        DiagSeverity.Warning
    } else {
        DiagSeverity.Error
    }
}


module main

use host_intrinsics.heap_alloc
use host_intrinsics.heap_free
use host_intrinsics.exit
use compiler.diag.code.AX_DIAG_CODE_COUNT
use compiler.diag.code.AX_ICE_INTERNAL
use compiler.diag.code.AX_ICE_OUT_OF_MEMORY
use compiler.diag.code.AX_LEX_INVALID_UTF8
use compiler.diag.code.AX_NAME_SHADOW_MODULE
use compiler.diag.code.AX_NAME_UNRESOLVED
use compiler.diag.code.AX_PARSE_EXPECTED_TOKEN
use compiler.diag.code.AX_PAT_UNREACHABLE
use compiler.diag.code.AX_TYPE_MISMATCH
use compiler.diag.code.AX_TYPE_UNREACHABLE
use compiler.diag.code.DiagDataKind
use compiler.diag.code.DiagSeverity
use compiler.diag.code.FixApplicability
use compiler.diag.code.diag_code
use compiler.diag.code.diag_code_default_message
use compiler.diag.code.diag_code_eq
use compiler.diag.code.diag_code_name
use compiler.diag.code.diag_code_severity

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic fn wrapping_add_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn rotate_left_u64(x: u64, n: u32) -> u64 { 0 }

pub fn severity_eq(a: DiagSeverity, b: DiagSeverity) -> bool {
    match a {
        DiagSeverity.Error => match b { DiagSeverity.Error => true, _ => false },
        DiagSeverity.Warning => match b { DiagSeverity.Warning => true, _ => false },
        DiagSeverity.Info => match b { DiagSeverity.Info => true, _ => false },
        DiagSeverity.Hint => match b { DiagSeverity.Hint => true, _ => false },
    }
}
pub fn fix_app_eq(a: FixApplicability, b: FixApplicability) -> bool {
    match a {
        FixApplicability.MachineApplicable => match b { FixApplicability.MachineApplicable => true, _ => false },
        FixApplicability.MaybeApplicable => match b { FixApplicability.MaybeApplicable => true, _ => false },
        FixApplicability.ManualReview => match b { FixApplicability.ManualReview => true, _ => false },
    }
}
pub fn data_kind_eq(a: DiagDataKind, b: DiagDataKind) -> bool {
    match a {
        DiagDataKind.String => match b { DiagDataKind.String => true, _ => false },
        DiagDataKind.Integer => match b { DiagDataKind.Integer => true, _ => false },
        DiagDataKind.Boolean => match b { DiagDataKind.Boolean => true, _ => false },
        DiagDataKind.StringList => match b { DiagDataKind.StringList => true, _ => false },
    }
}

fn main() -> i32 {
    if AX_DIAG_CODE_COUNT != 133u32 { return 1; }

    let c0 = diag_code(AX_LEX_INVALID_UTF8);
    let c0_dup = diag_code(0u32);
    let c1 = diag_code(AX_PARSE_EXPECTED_TOKEN);

    if !diag_code_eq(c0, c0_dup) { return 2; }
    if diag_code_eq(c0, c1) { return 3; }

    if !severity_eq(diag_code_severity(c0), DiagSeverity.Error) { return 4; }
    if !severity_eq(diag_code_severity(c1), DiagSeverity.Error) { return 5; }
    if !severity_eq(diag_code_severity(diag_code(AX_NAME_SHADOW_MODULE)), DiagSeverity.Warning) { return 6; }
    if !severity_eq(diag_code_severity(diag_code(AX_PAT_UNREACHABLE)), DiagSeverity.Warning) { return 7; }
    if !severity_eq(diag_code_severity(diag_code(AX_TYPE_UNREACHABLE)), DiagSeverity.Warning) { return 8; }
    if !severity_eq(diag_code_severity(diag_code(AX_TYPE_MISMATCH)), DiagSeverity.Error) { return 9; }

    let n_lex = diag_code_name(c0);
    if len(n_lex) != 19 { return 10; }

    let n_parse = diag_code_name(c1);
    if len(n_parse) != 23 { return 11; }

    let n_name = diag_code_name(diag_code(AX_NAME_UNRESOLVED));
    if len(n_name) != 18 { return 12; }

    let n_type = diag_code_name(diag_code(AX_TYPE_MISMATCH));
    if len(n_type) != 16 { return 13; }

    let n_ice = diag_code_name(diag_code(AX_ICE_OUT_OF_MEMORY));
    if len(n_ice) != 20 { return 14; }

    let n_unk = diag_code_name(diag_code(999u32));
    if len(n_unk) != 9 { return 15; }

    let m_lex = diag_code_default_message(c0);
    if len(m_lex) == 0 { return 16; }

    let m_parse = diag_code_default_message(c1);
    if len(m_parse) == 0 { return 17; }

    let m_ice = diag_code_default_message(diag_code(AX_ICE_INTERNAL));
    if len(m_ice) == 0 { return 18; }

    let m_unk = diag_code_default_message(diag_code(999u32));
    if len(m_unk) != 0 { return 19; }

    let s_err = DiagSeverity.Error;
    let s_warn = DiagSeverity.Warning;
    let s_info = DiagSeverity.Info;
    let s_hint = DiagSeverity.Hint;
    if severity_eq(s_err, s_warn) { return 20; }
    if severity_eq(s_info, s_hint) { return 21; }

    let a_mach = FixApplicability.MachineApplicable;
    let a_maybe = FixApplicability.MaybeApplicable;
    let a_man = FixApplicability.ManualReview;
    if fix_app_eq(a_mach, a_maybe) { return 22; }
    if fix_app_eq(a_maybe, a_man) { return 23; }

    let k_str = DiagDataKind.String;
    let k_int = DiagDataKind.Integer;
    let k_bool = DiagDataKind.Boolean;
    let k_list = DiagDataKind.StringList;
    if data_kind_eq(k_str, k_int) { return 24; }
    if data_kind_eq(k_bool, k_list) { return 25; }

    print("OK Diag Codes\n");
    0
}
