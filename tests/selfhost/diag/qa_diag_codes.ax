pub const AX_DRIVER_UNKNOWN_TARGET: u32 = 124u32; pub const AX_DRIVER_STAGE_NOT_AVAILABLE: u32 = 125u32; pub const AX_DRIVER_INTERP_STEP_LIMIT: u32 = 126u32; pub const AX_DRIVER_INTERP_STACK_LIMIT: u32 = 127u32;
pub const AX_DRIVER_NO_STD: u32 = 128u32; pub const AX_DRIVER_BAD_MANIFEST: u32 = 129u32; pub const AX_ICE_INTERNAL: u32 = 130u32; pub const AX_ICE_MIR_VERIFY: u32 = 131u32;
pub const AX_ICE_OUT_OF_MEMORY: u32 = 132u32; pub const AX_DIAG_CODE_COUNT: u32 = 133u32;

pub fn diag_code_name(c: DiagCode) -> Str {
    match c.v {
        0u32 => "AX_LEX_INVALID_UTF8",
        19u32 => "AX_PARSE_EXPECTED_TOKEN",
        44u32 => "AX_NAME_UNRESOLVED",
        57u32 => "AX_TYPE_MISMATCH",
        132u32 => "AX_ICE_OUT_OF_MEMORY",
        _ => "<unknown>",
    }
}

pub fn diag_code_default_message(c: DiagCode) -> Str {
    match c.v {
        0u32 => "invalid UTF-8 byte sequence",
        19u32 => "expected a specific token",
        130u32 => "an internal invariant failed; data.stage, data.detail",
        _ => "",
    }
}

pub fn diag_code_severity(c: DiagCode) -> DiagSeverity {
    if c.v == AX_NAME_SHADOW_MODULE || c.v == AX_PAT_UNREACHABLE || c.v == AX_TYPE_UNREACHABLE {
        DiagSeverity.Warning
    } else {
        DiagSeverity.Error
    }
}

fn main() -> i32 {
    if AX_DIAG_CODE_COUNT != 133u32 { return 1; }

    let c0 = diag_code(AX_LEX_INVALID_UTF8);
    let c0_dup = diag_code(0u32);
    let c1 = diag_code(AX_PARSE_EXPECTED_TOKEN);

    if !diag_code_eq(c0, c0_dup) { return 2; }
    if diag_code_eq(c0, c1) { return 3; }

    if !severity_eq(diag_code_severity(c0), DiagSeverity.Error) { return 4; }
    if !severity_eq(diag_code_severity(c1), DiagSeverity.Error) { return 5; }
    if !severity_eq(diag_code_severity(diag_code(AX_NAME_SHADOW_MODULE)), DiagSeverity.Warning) { return 6; }
    if !severity_eq(diag_code_severity(diag_code(AX_PAT_UNREACHABLE)), DiagSeverity.Warning) { return 7; }
    if !severity_eq(diag_code_severity(diag_code(AX_TYPE_UNREACHABLE)), DiagSeverity.Warning) { return 8; }
    if !severity_eq(diag_code_severity(diag_code(AX_TYPE_MISMATCH)), DiagSeverity.Error) { return 9; }

    let n_lex = diag_code_name(c0);
    if len(n_lex) != 19 { return 10; }

    let n_parse = diag_code_name(c1);
    if len(n_parse) != 23 { return 11; }

    let n_name = diag_code_name(diag_code(AX_NAME_UNRESOLVED));
    if len(n_name) != 18 { return 12; }

    let n_type = diag_code_name(diag_code(AX_TYPE_MISMATCH));
    if len(n_type) != 16 { return 13; }

    let n_ice = diag_code_name(diag_code(AX_ICE_OUT_OF_MEMORY));
    if len(n_ice) != 20 { return 14; }

    let n_unk = diag_code_name(diag_code(999u32));
    if len(n_unk) != 9 { return 15; }

    let m_lex = diag_code_default_message(c0);
    if len(m_lex) == 0 { return 16; }

    let m_parse = diag_code_default_message(c1);
    if len(m_parse) == 0 { return 17; }

    let m_ice = diag_code_default_message(diag_code(AX_ICE_INTERNAL));
    if len(m_ice) == 0 { return 18; }

    let m_unk = diag_code_default_message(diag_code(999u32));
    if len(m_unk) != 0 { return 19; }

    let s_err = DiagSeverity.Error;
    let s_warn = DiagSeverity.Warning;
    let s_info = DiagSeverity.Info;
    let s_hint = DiagSeverity.Hint;
    if severity_eq(s_err, s_warn) { return 20; }
    if severity_eq(s_info, s_hint) { return 21; }

    let a_mach = FixApplicability.MachineApplicable;
    let a_maybe = FixApplicability.MaybeApplicable;
    let a_man = FixApplicability.ManualReview;
    if fix_app_eq(a_mach, a_maybe) { return 22; }
    if fix_app_eq(a_maybe, a_man) { return 23; }

    let k_str = DiagDataKind.String;
    let k_int = DiagDataKind.Integer;
    let k_bool = DiagDataKind.Boolean;
    let k_list = DiagDataKind.StringList;
    if data_kind_eq(k_str, k_int) { return 24; }
    if data_kind_eq(k_bool, k_list) { return 25; }

    print("OK Diag Codes\n");
    0
}
