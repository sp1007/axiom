// test: run
// stdout: OK Diag Format JSON\n

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

use std.core.host.heap_alloc
use std.core.host.heap_free

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

// Arena Chunk & Arena
struct ArenaChunk {
    next: *mut ArenaChunk,
    cap: usize,
    used: usize,
}

pub struct Arena {
    head: *mut ArenaChunk,
}

pub fn arena_new() -> Arena {
    Arena { head: 0 as *mut ArenaChunk }
}

pub fn arena_alloc_raw(a: mut_view<Arena>, size: usize, align: usize) -> *mut u8 {
    if size == 0 { return 0 as *mut u8; }
    let effective_align = if align < 8 { 8 } else { align };
    let mut cur = a.head;

    if cur as usize != 0 {
        let raw = unsafe { (*cur).used };
        let mask = effective_align - 1;
        let offset = (raw + mask) & ~mask;
        if offset + size <= unsafe { (*cur).cap } {
            unsafe { (*cur).used = offset + size; }
            let data_ptr = ((cur as usize) + 32) as *mut u8;
            return ((data_ptr as usize) + offset) as *mut u8;
        }
    }

    let default_chunk: usize = 4096;
    let header_size: usize = 32;
    let chunk_cap = if size > default_chunk { size + effective_align } else { default_chunk };
    let total_alloc = header_size + chunk_cap;

    let p = unsafe { heap_alloc(total_alloc, 16) as *mut ArenaChunk };
    if p as usize == 0 { return 0 as *mut u8; }

    unsafe {
        (*p).next = a.head;
        (*p).cap = chunk_cap;
        (*p).used = 0;
    }
    a.head = p;

    let raw = 0;
    let mask = effective_align - 1;
    let offset = (raw + mask) & ~mask;
    unsafe { (*p).used = offset + size; }
    let data_ptr = ((p as usize) + header_size) as *mut u8;
    ((data_ptr as usize) + offset) as *mut u8
}

pub fn arena_destroy(a: mut_view<Arena>) {
    let mut cur = a.head;
    while cur as usize != 0 {
        let next = unsafe { (*cur).next };
        let total_alloc = 32 + unsafe { (*cur).cap };
        unsafe {
            heap_free(cur as *mut u8, total_alloc, 16);
        }
        cur = next;
    }
    a.head = 0 as *mut ArenaChunk;
}

// StrView
@derive(Copy)
pub struct StrView {
    pub ptr: *const u8,
    pub len: usize,
}

fn copy_sv(sv: view<StrView>) -> StrView {
    StrView { ptr: sv.ptr, len: sv.len }
}

fn sv_eq(a: StrView, b: StrView) -> bool {
    if a.len != b.len { return false; }
    let mut i: usize = 0;
    while i < a.len {
        if unsafe { *(a.ptr + i) != *(b.ptr + i) } { return false; }
        i = i + 1;
    }
    true
}

fn sv_contains(haystack: StrView, needle: StrView) -> bool {
    let n_len: usize = needle.len;
    if n_len == 0 { return true; }
    let h_len: usize = haystack.len;
    if h_len < n_len { return false; }
    let mut i: usize = 0;
    let limit = h_len - n_len;
    while i <= limit {
        let mut match_ok = true;
        let mut j: usize = 0;
        while j < n_len {
            if unsafe { *(haystack.ptr + i + j) != *(needle.ptr + j) } {
                match_ok = false;
                break;
            }
            j = j + 1;
        }
        if match_ok { return true; }
        i = i + 1;
    }
    false
}

// Spans
@derive(Copy)
pub struct FileId {
    pub v: u32,
}

@derive(Copy)
pub struct Span {
    pub file: FileId,
    pub start: u32,
    pub end: u32,
}

pub fn span_new(file: FileId, start: u32, end: u32) -> Span {
    Span { file: file, start: start, end: end }
}

pub fn span_none() -> Span {
    Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }
}

pub fn span_is_none(s: view<Span>) -> bool {
    s.file.v == 0u32
}

@derive(Copy)
pub struct LineCol {
    pub line: u32,
    pub col_bytes: u32,
    pub col_chars: u32,
}

impl LineCol {
    pub fn zero() -> LineCol {
        LineCol { line: 0u32, col_bytes: 0u32, col_chars: 0u32 }
    }
}

fn copy_fid(fid: view<FileId>) -> FileId { FileId { v: fid.v } }
fn copy_span(s: view<Span>) -> Span { Span { file: copy_fid(view(s.file)), start: s.start, end: s.end } }

// Minimal SourceDatabase for formatting tests
struct SourceFile {
    id: FileId,
    canonical_path: StrView,
    text: StrView,
    line_offsets: *mut u32,
    line_count: usize,
}

pub struct SourceDatabase {
    arena: Arena,
    files: *mut SourceFile,
    file_count: usize,
    file_cap: usize,
}

pub fn source_db_init(db: mut_view<SourceDatabase>) {
    db.arena = arena_new();
    db.files = 0 as *mut SourceFile;
    db.file_count = 0;
    db.file_cap = 0;
}

pub fn source_db_free(db: mut_view<SourceDatabase>) {
    let mut i: usize = 0;
    while i < db.file_count {
        let sf = unsafe { *(file_ptr(db.files, i)) };
        if sf.line_count > 0 && sf.line_offsets as usize != 0 {
            unsafe { heap_free(sf.line_offsets as *mut u8, (((sf.line_count as isize) * 4isize) as usize), 4); }
        }
        i = i + 1;
    }
    if db.file_cap > 0 && db.files as usize != 0 {
        unsafe { heap_free(db.files as *mut u8, (((db.file_cap as isize) * (size_of<SourceFile>() as isize)) as usize), align_of<SourceFile>()); }
    }
    db.files = 0 as *mut SourceFile;
    db.file_count = 0;
    db.file_cap = 0;
    arena_destroy(mut_view(db.arena));
}

fn file_ptr(p: *mut SourceFile, i: usize) -> *mut SourceFile {
    ((p as usize) + (((i as isize) * (size_of<SourceFile>() as isize)) as usize)) as *mut SourceFile
}

fn offset_ptr(p: *mut u32, i: usize) -> *mut u32 {
    ((p as usize) + (((i as isize) * 4isize) as usize)) as *mut u32
}

fn utf8_count_scalars(ptr: *const u8, byte_count: usize) -> usize {
    let mut count: usize = 0;
    let mut i: usize = 0;
    while i < byte_count {
        let b = unsafe { *(ptr + i) };
        if (b & 0xC0u8) != 0x80u8 {
            count = count + 1;
        }
        i = i + 1;
    }
    count
}

pub fn source_db_add_virtual(db: mut_view<SourceDatabase>, path_ptr: *const u8, path_len: usize, text_ptr: *const u8, text_len: usize) -> FileId {
    let path_copy = arena_alloc_raw(mut_view(db.arena), path_len + 1, 1);
    if path_len > 0 && path_ptr as usize != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(path_ptr, path_copy, path_len);
            *(path_copy + path_len) = 0u8;
        }
    }

    let text_copy = arena_alloc_raw(mut_view(db.arena), text_len + 1, 1);
    if text_len > 0 && text_ptr as usize != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(text_ptr, text_copy, text_len);
            *(text_copy + text_len) = 0u8;
        }
    }

    let mut count: usize = 1;
    let mut i: usize = 0;
    while i < text_len {
        let b = unsafe { *(text_copy + i) };
        if b == 13u8 && i + 1 < text_len && unsafe { *(text_copy + i + 1) } == 10u8 {
            count = count + 1;
            i = i + 2;
        } else if b == 10u8 {
            count = count + 1;
            i = i + 1;
        } else {
            i = i + 1;
        }
    }

    let offsets = unsafe { heap_alloc((((count as isize) * 4isize) as usize), 4) as *mut u32 };
    unsafe { *(offset_ptr(offsets, 0)) = 0u32; }
    let mut line_idx: usize = 1;
    i = 0;
    while i < text_len {
        let b = unsafe { *(text_copy + i) };
        if b == 13u8 && i + 1 < text_len && unsafe { *(text_copy + i + 1) } == 10u8 {
            unsafe { *(offset_ptr(offsets, line_idx)) = (i + 2) as u32; }
            line_idx = line_idx + 1;
            i = i + 2;
        } else if b == 10u8 {
            unsafe { *(offset_ptr(offsets, line_idx)) = (i + 1) as u32; }
            line_idx = line_idx + 1;
            i = i + 1;
        } else {
            i = i + 1;
        }
    }

    let new_id = FileId { v: (db.file_count + 1) as u32 };
    if db.file_count == db.file_cap {
        let new_cap = if db.file_cap == 0 { 4 } else { db.file_cap + db.file_cap };
        let new_files = unsafe { heap_alloc((((new_cap as isize) * (size_of<SourceFile>() as isize)) as usize), align_of<SourceFile>()) as *mut SourceFile };
        if db.file_count > 0 && db.files as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(db.files as *const u8, new_files as *mut u8, (((db.file_count as isize) * (size_of<SourceFile>() as isize)) as usize));
                heap_free(db.files as *mut u8, (((db.file_cap as isize) * (size_of<SourceFile>() as isize)) as usize), align_of<SourceFile>());
            }
        }
        db.files = new_files;
        db.file_cap = new_cap;
    }

    let sf = SourceFile {
        id: new_id,
        canonical_path: StrView { ptr: path_copy as *const u8, len: path_len },
        text: StrView { ptr: text_copy as *const u8, len: text_len },
        line_offsets: offsets,
        line_count: count,
    };
    unsafe { *(file_ptr(db.files, db.file_count)) = sf; }
    db.file_count = db.file_count + 1;
    new_id
}

pub fn source_db_path(db: view<SourceDatabase>, file: FileId) -> StrView {
    if file.v == 0 || (file.v as usize) > db.file_count {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let sf = unsafe { *(file_ptr(db.files, (file.v - 1) as usize)) };
    sf.canonical_path
}

pub fn source_db_span_text(db: view<SourceDatabase>, span: Span) -> StrView {
    if span.file.v == 0 || (span.file.v as usize) > db.file_count {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let sf = unsafe { *(file_ptr(db.files, (span.file.v - 1) as usize)) };
    if span.start > span.end || (span.end as usize) > sf.text.len {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    StrView {
        ptr: ((sf.text.ptr as usize) + (span.start as usize)) as *const u8,
        len: (span.end - span.start) as usize,
    }
}

pub fn source_db_line_col(db: view<SourceDatabase>, span: Span) -> LineCol {
    if span.file.v == 0 || (span.file.v as usize) > db.file_count {
        return LineCol.zero();
    }
    let sf = unsafe { *(file_ptr(db.files, (span.file.v - 1) as usize)) };

    let mut offset = span.start;
    if (offset as usize) > sf.text.len {
        offset = sf.text.len as u32;
    }

    let mut line_idx: usize = 0;
    let mut i: usize = 0;
    while i < sf.line_count {
        let off = unsafe { *(offset_ptr(sf.line_offsets, i)) };
        if off <= offset {
            line_idx = i;
        } else {
            break;
        }
        i = i + 1;
    }

    let line_start = unsafe { *(offset_ptr(sf.line_offsets, line_idx)) };
    let col_bytes = offset - line_start + 1u32;
    let byte_diff = (offset - line_start) as usize;
    let p = ((sf.text.ptr as usize) + line_start as usize) as *const u8;
    let col_chars = (utf8_count_scalars(p, byte_diff) + 1) as u32;

    LineCol {
        line: (line_idx + 1) as u32,
        col_bytes: col_bytes,
        col_chars: col_chars,
    }
}

pub fn source_db_line_range(db: view<SourceDatabase>, file: FileId, line: u32) -> Span {
    if file.v == 0 || (file.v as usize) > db.file_count {
        return span_none();
    }
    let sf = unsafe { *(file_ptr(db.files, (file.v - 1) as usize)) };
    if line == 0u32 || (line as usize) > sf.line_count {
        return span_none();
    }

    let start = unsafe { *(offset_ptr(sf.line_offsets, (line - 1u32) as usize)) };
    let mut end: u32 = 0u32;
    if (line as usize) < sf.line_count {
        end = unsafe { *(offset_ptr(sf.line_offsets, line as usize)) };
        if end > start && unsafe { *(sf.text.ptr + (end - 1u32) as usize) } == 10u8 {
            end = end - 1u32;
            if end > start && unsafe { *(sf.text.ptr + (end - 1u32) as usize) } == 13u8 {
                end = end - 1u32;
            }
        }
    } else {
        end = sf.text.len as u32;
    }
    span_new(file, start, end)
}

// Diag Codes & Severities
@derive(Copy)
pub enum DiagSeverity {
    Error,
    Warning,
    Info,
    Hint,
}

@derive(Copy)
pub enum FixApplicability {
    MachineApplicable,
    MaybeApplicable,
    ManualReview,
}

@derive(Copy)
pub enum DiagDataKind {
    String,
    Integer,
    Boolean,
    StringList,
}

@derive(Copy)
pub struct DiagCode {
    pub v: u32,
}

pub fn diag_code(v: u32) -> DiagCode {
    DiagCode { v: v }
}

// Diag Models
pub struct DiagLabel {
    pub span: Span,
    pub message: StrView,
}

pub struct DiagEdit {
    pub span: Span,
    pub replacement: StrView,
}

pub struct DiagFix {
    pub message: StrView,
    pub applicability: FixApplicability,
    pub edits: *mut DiagEdit,
    pub edit_count: usize,
}

pub struct DiagDataValue {
    pub kind: DiagDataKind,
    pub str_val: StrView,
    pub int_val: i64,
    pub bool_val: bool,
    pub list_items: *mut StrView,
    pub list_count: usize,
}

pub struct DiagDataEntry {
    pub key: StrView,
    pub value: DiagDataValue,
}

pub struct Diagnostic {
    pub code: DiagCode,
    pub severity: DiagSeverity,
    pub message: StrView,
    pub primary: Span,
    pub labels: *mut DiagLabel,
    pub label_count: usize,
    pub notes: *mut StrView,
    pub note_count: usize,
    pub helps: *mut StrView,
    pub help_count: usize,
    pub fixes: *mut DiagFix,
    pub fix_count: usize,
    pub data: *mut DiagDataEntry,
    pub data_count: usize,
}

pub struct DiagSink {
    pub arena: Arena,
    pub diags: *mut Diagnostic,
    pub len: usize,
    pub cap: usize,
    pub errors: usize,
    pub warnings: usize,
}

pub fn diag_sink_new() -> DiagSink {
    DiagSink {
        arena: arena_new(),
        diags: 0 as *mut Diagnostic,
        len: 0,
        cap: 0,
        errors: 0,
        warnings: 0,
    }
}

pub fn diag_sink_free(sink: mut_view<DiagSink>) {
    if sink.cap > 0 && sink.diags as usize != 0 {
        unsafe {
            heap_free(sink.diags as *mut u8, (((sink.cap as isize) * (size_of<Diagnostic>() as isize)) as usize), align_of<Diagnostic>());
        }
    }
    sink.diags = 0 as *mut Diagnostic;
    sink.len = 0;
    sink.cap = 0;
    sink.errors = 0;
    sink.warnings = 0;
    arena_destroy(mut_view(sink.arena));
}

fn copy_str_view(arena: mut_view<Arena>, sv: StrView) -> StrView {
    if sv.len == 0 || sv.ptr as usize == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let dst = arena_alloc_raw(arena, sv.len + 1, 1);
    unsafe {
        ptr_copy_nonoverlapping<u8>(sv.ptr, dst, sv.len);
        *(dst + sv.len) = 0u8;
    }
    StrView { ptr: dst as *const u8, len: sv.len }
}

fn diag_ptr(p: *mut Diagnostic, i: usize) -> *mut Diagnostic {
    ((p as usize) + (((i as isize) * (size_of<Diagnostic>() as isize)) as usize)) as *mut Diagnostic
}

pub fn diag_sink_report(sink: mut_view<DiagSink>, diag: view<Diagnostic>) {
    if sink.len == sink.cap {
        let new_cap = if sink.cap == 0 { 8 } else { sink.cap + sink.cap };
        let new_diags = unsafe { heap_alloc((((new_cap as isize) * (size_of<Diagnostic>() as isize)) as usize), align_of<Diagnostic>()) as *mut Diagnostic };
        if sink.len > 0 && sink.diags as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(sink.diags as *const u8, new_diags as *mut u8, (((sink.len as isize) * (size_of<Diagnostic>() as isize)) as usize));
                heap_free(sink.diags as *mut u8, (((sink.cap as isize) * (size_of<Diagnostic>() as isize)) as usize), align_of<Diagnostic>());
            }
        }
        sink.diags = new_diags;
        sink.cap = new_cap;
    }

    let mut d = Diagnostic {
        code: diag.code,
        severity: diag.severity,
        message: copy_str_view(mut_view(sink.arena), copy_sv(view(diag.message))),
        primary: diag.primary,
        labels: 0 as *mut DiagLabel,
        label_count: diag.label_count,
        notes: 0 as *mut StrView,
        note_count: diag.note_count,
        helps: 0 as *mut StrView,
        help_count: diag.help_count,
        fixes: 0 as *mut DiagFix,
        fix_count: diag.fix_count,
        data: 0 as *mut DiagDataEntry,
        data_count: diag.data_count,
    };

    if diag.label_count > 0 && diag.labels as usize != 0 {
        let labels_mem = arena_alloc_raw(mut_view(sink.arena), (((diag.label_count as isize) * (size_of<DiagLabel>() as isize)) as usize), align_of<DiagLabel>()) as *mut DiagLabel;
        let mut i: usize = 0;
        while i < diag.label_count {
            let src_l = unsafe { *((diag.labels as usize + (((i as isize) * (size_of<DiagLabel>() as isize)) as usize)) as *const DiagLabel) };
            let dst_l_ptr = ((labels_mem as usize) + (((i as isize) * (size_of<DiagLabel>() as isize)) as usize)) as *mut DiagLabel;
            unsafe {
                *dst_l_ptr = DiagLabel {
                    span: src_l.span,
                    message: copy_str_view(mut_view(sink.arena), copy_sv(view(src_l.message))),
                };
            }
            i = i + 1;
        }
        d.labels = labels_mem;
    }

    if diag.note_count > 0 && diag.notes as usize != 0 {
        let notes_mem = arena_alloc_raw(mut_view(sink.arena), (((diag.note_count as isize) * (size_of<StrView>() as isize)) as usize), align_of<StrView>()) as *mut StrView;
        let mut i: usize = 0;
        while i < diag.note_count {
            let src_n = unsafe { *((diag.notes as usize + (((i as isize) * (size_of<StrView>() as isize)) as usize)) as *const StrView) };
            let dst_n_ptr = ((notes_mem as usize) + (((i as isize) * (size_of<StrView>() as isize)) as usize)) as *mut StrView;
            unsafe {
                *dst_n_ptr = copy_str_view(mut_view(sink.arena), copy_sv(view(src_n)));
            }
            i = i + 1;
        }
        d.notes = notes_mem;
    }

    if diag.help_count > 0 && diag.helps as usize != 0 {
        let helps_mem = arena_alloc_raw(mut_view(sink.arena), (((diag.help_count as isize) * (size_of<StrView>() as isize)) as usize), align_of<StrView>()) as *mut StrView;
        let mut i: usize = 0;
        while i < diag.help_count {
            let src_h = unsafe { *((diag.helps as usize + (((i as isize) * (size_of<StrView>() as isize)) as usize)) as *const StrView) };
            let dst_h_ptr = ((helps_mem as usize) + (((i as isize) * (size_of<StrView>() as isize)) as usize)) as *mut StrView;
            unsafe {
                *dst_h_ptr = copy_str_view(mut_view(sink.arena), copy_sv(view(src_h)));
            }
            i = i + 1;
        }
        d.helps = helps_mem;
    }

    if diag.fix_count > 0 && diag.fixes as usize != 0 {
        let fixes_mem = arena_alloc_raw(mut_view(sink.arena), (((diag.fix_count as isize) * (size_of<DiagFix>() as isize)) as usize), align_of<DiagFix>()) as *mut DiagFix;
        let mut i: usize = 0;
        while i < diag.fix_count {
            let src_f = unsafe { *((diag.fixes as usize + (((i as isize) * (size_of<DiagFix>() as isize)) as usize)) as *const DiagFix) };
            let dst_f_ptr = ((fixes_mem as usize) + (((i as isize) * (size_of<DiagFix>() as isize)) as usize)) as *mut DiagFix;
            let mut edits_mem = 0 as *mut DiagEdit;
            if src_f.edit_count > 0 && src_f.edits as usize != 0 {
                edits_mem = arena_alloc_raw(mut_view(sink.arena), (((src_f.edit_count as isize) * (size_of<DiagEdit>() as isize)) as usize), align_of<DiagEdit>()) as *mut DiagEdit;
                let mut j: usize = 0;
                while j < src_f.edit_count {
                    let src_e = unsafe { *((src_f.edits as usize + (((j as isize) * (size_of<DiagEdit>() as isize)) as usize)) as *const DiagEdit) };
                    let dst_e_ptr = ((edits_mem as usize) + (((j as isize) * (size_of<DiagEdit>() as isize)) as usize)) as *mut DiagEdit;
                    unsafe {
                        *dst_e_ptr = DiagEdit {
                            span: src_e.span,
                            replacement: copy_str_view(mut_view(sink.arena), copy_sv(view(src_e.replacement))),
                        };
                    }
                    j = j + 1;
                }
            }
            unsafe {
                *dst_f_ptr = DiagFix {
                    message: copy_str_view(mut_view(sink.arena), copy_sv(view(src_f.message))),
                    applicability: src_f.applicability,
                    edits: edits_mem,
                    edit_count: src_f.edit_count,
                };
            }
            i = i + 1;
        }
        d.fixes = fixes_mem;
    }

    if diag.data_count > 0 && diag.data as usize != 0 {
        let data_mem = arena_alloc_raw(mut_view(sink.arena), (((diag.data_count as isize) * (size_of<DiagDataEntry>() as isize)) as usize), align_of<DiagDataEntry>()) as *mut DiagDataEntry;
        let mut i: usize = 0;
        while i < diag.data_count {
            let src_entry = unsafe { *((diag.data as usize + (((i as isize) * (size_of<DiagDataEntry>() as isize)) as usize)) as *const DiagDataEntry) };
            let dst_entry_ptr = ((data_mem as usize) + (((i as isize) * (size_of<DiagDataEntry>() as isize)) as usize)) as *mut DiagDataEntry;
            let mut val = DiagDataValue {
                kind: src_entry.value.kind,
                str_val: StrView { ptr: 0 as *const u8, len: 0 },
                int_val: src_entry.value.int_val,
                bool_val: src_entry.value.bool_val,
                list_items: 0 as *mut StrView,
                list_count: src_entry.value.list_count,
            };
            match src_entry.value.kind {
                DiagDataKind.String => {
                    val.str_val = copy_str_view(mut_view(sink.arena), copy_sv(view(src_entry.value.str_val)));
                },
                DiagDataKind.StringList => {
                    if src_entry.value.list_count > 0 && src_entry.value.list_items as usize != 0 {
                        let items_mem = arena_alloc_raw(mut_view(sink.arena), (((src_entry.value.list_count as isize) * (size_of<StrView>() as isize)) as usize), align_of<StrView>()) as *mut StrView;
                        let mut k: usize = 0;
                        while k < src_entry.value.list_count {
                            let item = unsafe { *((src_entry.value.list_items as usize + (((k as isize) * (size_of<StrView>() as isize)) as usize)) as *const StrView) };
                            let dst_item_ptr = ((items_mem as usize) + (((k as isize) * (size_of<StrView>() as isize)) as usize)) as *mut StrView;
                            unsafe {
                                *dst_item_ptr = copy_str_view(mut_view(sink.arena), copy_sv(view(item)));
                            }
                            k = k + 1;
                        }
                        val.list_items = items_mem;
                    }
                },
                _ => {},
            }
            unsafe {
                *dst_entry_ptr = DiagDataEntry {
                    key: copy_str_view(mut_view(sink.arena), copy_sv(view(src_entry.key))),
                    value: val,
                };
            }
            i = i + 1;
        }
        d.data = data_mem;
    }

    let sev = diag.severity;
    unsafe {
        *(diag_ptr(sink.diags, sink.len)) = d;
    }
    sink.len = sink.len + 1;

    match sev {
        DiagSeverity.Error => {
            sink.errors = sink.errors + 1;
        },
        DiagSeverity.Warning => {
            sink.warnings = sink.warnings + 1;
        },
        _ => {},
    }
}

// DiagBuffer & formatters
pub struct DiagBuffer {
    pub ptr: *mut u8,
    pub len: usize,
    pub cap: usize,
}

pub fn diag_buf_new() -> DiagBuffer {
    DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
}

pub fn diag_buf_init(b: mut_view<DiagBuffer>) {
    b.ptr = 0 as *mut u8;
    b.len = 0;
    b.cap = 0;
}

pub fn diag_buf_free(b: mut_view<DiagBuffer>) {
    if b.cap > 0 && b.ptr as usize != 0 {
        unsafe {
            heap_free(b.ptr, b.cap, 1);
        }
    }
    b.ptr = 0 as *mut u8;
    b.len = 0;
    b.cap = 0;
}

pub fn diag_buf_push_byte(b: mut_view<DiagBuffer>, byte: u8) {
    if b.len == b.cap {
        let new_cap = if b.cap == 0 { 128 } else { b.cap + b.cap };
        let new_ptr = unsafe { heap_alloc(new_cap, 1) };
        if b.len > 0 && b.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(b.ptr as *const u8, new_ptr, b.len);
                heap_free(b.ptr, b.cap, 1);
            }
        }
        b.ptr = new_ptr;
        b.cap = new_cap;
    }
    unsafe {
        *(b.ptr + b.len) = byte;
    }
    b.len = b.len + 1;
}

pub fn diag_buf_push_bytes(b: mut_view<DiagBuffer>, p: *const u8, count: usize) {
    if count == 0 || p as usize == 0 {
        return;
    }
    let mut i: usize = 0;
    while i < count {
        diag_buf_push_byte(mut_view(*b), unsafe { *(p + i) });
        i = i + 1;
    }
}

pub fn diag_buf_push_sv(b: mut_view<DiagBuffer>, sv: StrView) {
    diag_buf_push_bytes(b, sv.ptr, sv.len);
}

pub fn diag_buf_push_u32(b: mut_view<DiagBuffer>, mut n: u32) {
    if n == 0u32 {
        diag_buf_push_byte(b, 48u8);
        return;
    }
    let mut digits: [10]u8 = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    let mut count: usize = 0;
    while n > 0u32 {
        digits[count] = ((n % 10u32) as u8) + 48u8;
        n = n / 10u32;
        count = count + 1;
    }
    while count > 0 {
        count = count - 1;
        diag_buf_push_byte(mut_view(*b), digits[count]);
    }
}

pub fn diag_buf_as_str_view(b: view<DiagBuffer>) -> StrView {
    StrView { ptr: b.ptr as *const u8, len: b.len }
}

const FMT_STRS: [97]u8 = [
    60u8, 117u8, 110u8, 107u8, 110u8, 111u8, 119u8, 110u8, 62u8, 32u8, 124u8, 32u8, 101u8, 114u8, 114u8, 111u8,
    114u8, 91u8, 119u8, 97u8, 114u8, 110u8, 105u8, 110u8, 103u8, 91u8, 105u8, 110u8, 102u8, 111u8, 91u8, 104u8,
    105u8, 110u8, 116u8, 91u8, 93u8, 58u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 45u8, 45u8, 62u8, 32u8,
    46u8, 46u8, 46u8, 10u8, 32u8, 32u8, 61u8, 32u8, 110u8, 111u8, 116u8, 101u8, 58u8, 32u8, 32u8, 32u8,
    61u8, 32u8, 104u8, 101u8, 108u8, 112u8, 58u8, 32u8, 32u8, 32u8, 61u8, 32u8, 102u8, 105u8, 120u8, 58u8,
    32u8, 32u8, 101u8, 114u8, 114u8, 111u8, 114u8, 44u8, 32u8, 32u8, 119u8, 97u8, 114u8, 110u8, 105u8, 110u8,
    103u8,
];

pub fn diag_buf_push_fmt_str(b: mut_view<DiagBuffer>, start: usize, byte_count: usize) {
    let mut i: usize = 0;
    while i < byte_count {
        diag_buf_push_byte(mut_view(*b), FMT_STRS[start + i]);
        i = i + 1;
    }
}

