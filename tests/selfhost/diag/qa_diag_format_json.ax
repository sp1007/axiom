        let c = unsafe { *(line_text.ptr + i) };
        if c == 9u8 {
            diag_buf_push_fmt_str(mut_view(*b), 39, 4);
        } else if c != 13u8 && c != 10u8 {
            diag_buf_push_byte(mut_view(*b), c);
        }
        i = i + 1;
    }
    diag_buf_push_byte(b, 10u8);
}

fn render_carets(b: mut_view<DiagBuffer>, line_text: StrView, start_col: u32, end_col: u32, caret_byte: u8, msg: StrView) {
    let mut display_start: usize = 0;
    let mut char_idx: usize = 1;
    let mut i: usize = 0;

    while i < line_text.len && char_idx < (start_col as usize) {
        let c = unsafe { *(line_text.ptr + i) };
        let mut w: usize = 1;
        let mut bytes: usize = 1;
        if c == 9u8 {
            w = 4;
        } else if (c & 0xE0u8) == 0xC0u8 {
            bytes = 2;
        } else if (c & 0xF0u8) == 0xE0u8 {
            bytes = 3;
        } else if (c & 0xF8u8) == 0xF0u8 {
            bytes = 4;
        }
        display_start = display_start + w;
        char_idx = char_idx + 1;
        i = i + bytes;
    }

    let mut display_end: usize = display_start;
    if start_col == end_col {
        display_end = display_end + 1;
    } else {
        while i < line_text.len && char_idx < (end_col as usize) {
            let c = unsafe { *(line_text.ptr + i) };
            let mut w: usize = 1;
            let mut bytes: usize = 1;
            if c == 9u8 {
                w = 4;
            } else if (c & 0xE0u8) == 0xC0u8 {
                bytes = 2;
            } else if (c & 0xF0u8) == 0xE0u8 {
                bytes = 3;
            } else if (c & 0xF8u8) == 0xF0u8 {
                bytes = 4;
            }
            display_end = display_end + w;
            char_idx = char_idx + 1;
            i = i + bytes;
        }
    }

    let mut j: usize = 0;
    while j < display_start {
        diag_buf_push_byte(mut_view(*b), 32u8);
        j = j + 1;
    }
    while j < display_end {
        diag_buf_push_byte(mut_view(*b), caret_byte);
        j = j + 1;
    }
    if msg.len > 0 {
        diag_buf_push_byte(mut_view(*b), 32u8);
        diag_buf_push_sv(mut_view(*b), msg);
    }
    diag_buf_push_byte(b, 10u8);
}

fn print_gutter_line_num(b: mut_view<DiagBuffer>, line: u32, width: u32) {
    let lw = get_gutter_width(line);
    let mut pad = width - lw;
    while pad > 0u32 {
        diag_buf_push_byte(mut_view(*b), 32u8);
        pad = pad - 1u32;
    }
    diag_buf_push_u32(mut_view(*b), line);
    diag_buf_push_fmt_str(b, 9, 3);
}

fn print_span_snippet(b: mut_view<DiagBuffer>, db: view<SourceDatabase>, span: Span, caret_byte: u8, msg: StrView, gutter_width: u32) {
    let s_start: u32 = span.start;
    let s_end: u32 = span.end;
    let lc_start = source_db_line_col(db, span_new(copy_fid(view(span.file)), s_start, s_start));
    let lc_end = source_db_line_col(db, span_new(copy_fid(view(span.file)), s_end, s_end));

    if lc_start.line == lc_end.line {
        let line_span = source_db_line_range(db, copy_fid(view(span.file)), lc_start.line);
        let line_text = source_db_span_text(db, line_span);
        print_gutter_line_num(mut_view(*b), lc_start.line, gutter_width);
        render_line(mut_view(*b), copy_sv(view(line_text)));
        print_gutter_space(mut_view(*b), gutter_width);
        render_carets(mut_view(*b), copy_sv(view(line_text)), lc_start.col_chars, lc_end.col_chars, caret_byte, copy_sv(view(msg)));
    } else {
        let start_line_span = source_db_line_range(db, copy_fid(view(span.file)), lc_start.line);
        let start_line_text = source_db_span_text(db, start_line_span);
        print_gutter_line_num(mut_view(*b), lc_start.line, gutter_width);
        render_line(mut_view(*b), copy_sv(view(start_line_text)));
        print_gutter_space(mut_view(*b), gutter_width);
        render_carets(mut_view(*b), copy_sv(view(start_line_text)), lc_start.col_chars, 999999u32, caret_byte, StrView { ptr: 0 as *const u8, len: 0 });

        if lc_end.line > lc_start.line + 1u32 {
            let mut sp = gutter_width + 2u32;
            while sp > 0u32 {
                diag_buf_push_byte(mut_view(*b), 32u8);
                sp = sp - 1u32;
            }
            diag_buf_push_fmt_str(mut_view(*b), 48, 4);
        }

        let end_line_span = source_db_line_range(db, copy_fid(view(span.file)), lc_end.line);
        let end_line_text = source_db_span_text(db, end_line_span);
        print_gutter_line_num(mut_view(*b), lc_end.line, gutter_width);
        render_line(mut_view(*b), copy_sv(view(end_line_text)));

        let mut first_non_blank: u32 = 1u32;
        let mut k: usize = 0;
        while k < end_line_text.len {
            let eb = unsafe { *(end_line_text.ptr + k) };
            if eb != 32u8 && eb != 9u8 && eb != 13u8 {
                break;
            }
            first_non_blank = first_non_blank + 1u32;
            k = k + 1;
        }

        print_gutter_space(mut_view(*b), gutter_width);
        render_carets(mut_view(*b), copy_sv(view(end_line_text)), first_non_blank, lc_end.col_chars, caret_byte, copy_sv(view(msg)));
    }
}

pub fn ax_diag_render_human(sink: view<DiagSink>, db: view<SourceDatabase>, out: mut_view<DiagBuffer>) {
    let mut i: usize = 0;
    while i < sink.len {
        if i > 0 {
            diag_buf_push_byte(mut_view(*out), 10u8);
        }
        let d = unsafe { *((sink.diags as usize + (((i as isize) * (size_of<Diagnostic>() as isize)) as usize)) as *const Diagnostic) };

        let d_prim = copy_span(view(d.primary));
        let d_msg = copy_sv(view(d.message));

        print_severity_prefix(mut_view(*out), d.severity, d.code);
        diag_buf_push_sv(mut_view(*out), d_msg);
        diag_buf_push_byte(mut_view(*out), 10u8);

        if !span_is_none(view(d_prim)) {
            let p_start: u32 = d_prim.start;
            let lc = source_db_line_col(db, span_new(copy_fid(view(d_prim.file)), p_start, p_start));
            let path = source_db_path(db, copy_fid(view(d_prim.file)));

            diag_buf_push_fmt_str(mut_view(*out), 43, 5);

            let mut pi: usize = 0;
            while pi < path.len {
                let pb = unsafe { *(path.ptr + pi) };
                if pb == 92u8 {
                    diag_buf_push_byte(mut_view(*out), 47u8);
                } else {
                    diag_buf_push_byte(mut_view(*out), pb);
                }
                pi = pi + 1;
            }

            diag_buf_push_byte(mut_view(*out), 58u8);
            diag_buf_push_u32(mut_view(*out), lc.line);
            diag_buf_push_byte(mut_view(*out), 58u8);
            diag_buf_push_u32(mut_view(*out), lc.col_chars);
            diag_buf_push_byte(mut_view(*out), 10u8);

            let mut gutter_width = get_gutter_width(lc.line);
            let mut l: usize = 0;
            while l < d.label_count {
                let lbl = unsafe { *((d.labels as usize + (((l as isize) * (size_of<DiagLabel>() as isize)) as usize)) as *const DiagLabel) };
                let l_span = copy_span(view(lbl.span));
                if !span_is_none(view(l_span)) && l_span.file.v == d_prim.file.v {
                    let l_start: u32 = l_span.start;
                    let llc = source_db_line_col(db, span_new(copy_fid(view(l_span.file)), l_start, l_start));
                    let lw = get_gutter_width(llc.line);
                    if lw > gutter_width {
                        gutter_width = lw;
                    }
                }
                l = l + 1;
            }

            print_gutter_space(mut_view(*out), gutter_width);
            diag_buf_push_byte(mut_view(*out), 10u8);

            print_span_snippet(mut_view(*out), db, copy_span(view(d_prim)), 94u8, StrView { ptr: 0 as *const u8, len: 0 }, gutter_width);

            let mut l2: usize = 0;
            while l2 < d.label_count {
                let lbl = unsafe { *((d.labels as usize + (((l2 as isize) * (size_of<DiagLabel>() as isize)) as usize)) as *const DiagLabel) };
                let l_span = copy_span(view(lbl.span));
                let l_msg = copy_sv(view(lbl.message));
                if !span_is_none(view(l_span)) && l_span.file.v == d_prim.file.v {
                    print_span_snippet(mut_view(*out), db, copy_span(view(l_span)), 45u8, l_msg, gutter_width);
                }
                l2 = l2 + 1;
            }

            print_gutter_space(mut_view(*out), gutter_width);
            diag_buf_push_byte(mut_view(*out), 10u8);
        }

        // Notes
        let mut ni: usize = 0;
        while ni < d.note_count {
            let note = unsafe { *((d.notes as usize + (((ni as isize) * (size_of<StrView>() as isize)) as usize)) as *const StrView) };
            diag_buf_push_fmt_str(mut_view(*out), 52, 10);
            diag_buf_push_sv(mut_view(*out), note);
            diag_buf_push_byte(mut_view(*out), 10u8);
            ni = ni + 1;
        }

        // Helps
        let mut hi: usize = 0;
        while hi < d.help_count {
            let help = unsafe { *((d.helps as usize + (((hi as isize) * (size_of<StrView>() as isize)) as usize)) as *const StrView) };
            diag_buf_push_fmt_str(mut_view(*out), 62, 10);
            diag_buf_push_sv(mut_view(*out), help);
            diag_buf_push_byte(mut_view(*out), 10u8);
            hi = hi + 1;
        }

        // Fixes
        let mut fi: usize = 0;
        while fi < d.fix_count {
            let fix = unsafe { *((d.fixes as usize + (((fi as isize) * (size_of<DiagFix>() as isize)) as usize)) as *const DiagFix) };
            diag_buf_push_fmt_str(mut_view(*out), 72, 9);
            diag_buf_push_sv(mut_view(*out), fix.message);
            diag_buf_push_byte(mut_view(*out), 10u8);
            fi = fi + 1;
        }

        i = i + 1;
    }

    if sink.len > 0 {
        diag_buf_push_byte(mut_view(*out), 10u8);
        diag_buf_push_u32(mut_view(*out), sink.errors as u32);
        diag_buf_push_fmt_str(mut_view(*out), 81, 6);
        if sink.errors != 1 {
            diag_buf_push_byte(mut_view(*out), 115u8);
        }
        diag_buf_push_fmt_str(mut_view(*out), 87, 2);
        diag_buf_push_u32(mut_view(*out), sink.warnings as u32);
        diag_buf_push_fmt_str(mut_view(*out), 89, 8);
        if sink.warnings != 1 {
            diag_buf_push_byte(mut_view(*out), 115u8);
        }
        diag_buf_push_byte(out, 10u8);
    }
}
fn hex_digit(v: u8) -> u8 {
    if v < 10u8 {
        v + 48u8
    } else {
        v - 10u8 + 97u8
    }
}

const JSON_STRS: [389]u8 = [
    92u8, 34u8, 92u8, 92u8, 92u8, 98u8, 92u8, 102u8, 92u8, 110u8, 92u8, 114u8, 92u8, 116u8, 34u8, 101u8, 114u8, 114u8, 111u8, 114u8, 34u8, 34u8, 119u8, 97u8, 114u8, 110u8, 105u8, 110u8, 103u8, 34u8, 34u8, 105u8,
    110u8, 102u8, 111u8, 34u8, 34u8, 104u8, 105u8, 110u8, 116u8, 34u8, 110u8, 117u8, 108u8, 108u8, 123u8, 34u8, 102u8, 105u8, 108u8, 101u8, 34u8, 58u8, 44u8, 34u8, 115u8, 116u8, 97u8, 114u8, 116u8, 34u8, 58u8, 44u8,
    34u8, 101u8, 110u8, 100u8, 34u8, 58u8, 44u8, 34u8, 108u8, 105u8, 110u8, 101u8, 34u8, 58u8, 44u8, 34u8, 99u8, 111u8, 108u8, 34u8, 58u8, 44u8, 34u8, 101u8, 110u8, 100u8, 95u8, 108u8, 105u8, 110u8, 101u8, 34u8,
    58u8, 44u8, 34u8, 101u8, 110u8, 100u8, 95u8, 99u8, 111u8, 108u8, 34u8, 58u8, 123u8, 34u8, 115u8, 112u8, 97u8, 110u8, 34u8, 58u8, 44u8, 34u8, 109u8, 101u8, 115u8, 115u8, 97u8, 103u8, 101u8, 34u8, 58u8, 44u8,
    34u8, 97u8, 112u8, 112u8, 108u8, 105u8, 99u8, 97u8, 98u8, 105u8, 108u8, 105u8, 116u8, 121u8, 34u8, 58u8, 34u8, 109u8, 97u8, 99u8, 104u8, 105u8, 110u8, 101u8, 45u8, 97u8, 112u8, 112u8, 108u8, 105u8, 99u8, 97u8,
    98u8, 108u8, 101u8, 34u8, 34u8, 109u8, 97u8, 121u8, 98u8, 101u8, 45u8, 97u8, 112u8, 112u8, 108u8, 105u8, 99u8, 97u8, 98u8, 108u8, 101u8, 34u8, 34u8, 109u8, 97u8, 110u8, 117u8, 97u8, 108u8, 45u8, 114u8, 101u8,
    118u8, 105u8, 101u8, 119u8, 34u8, 44u8, 34u8, 101u8, 100u8, 105u8, 116u8, 115u8, 34u8, 58u8, 91u8, 44u8, 34u8, 114u8, 101u8, 112u8, 108u8, 97u8, 99u8, 101u8, 109u8, 101u8, 110u8, 116u8, 34u8, 58u8, 116u8, 114u8,
    117u8, 101u8, 102u8, 97u8, 108u8, 115u8, 101u8, 123u8, 34u8, 115u8, 99u8, 104u8, 101u8, 109u8, 97u8, 34u8, 58u8, 49u8, 44u8, 34u8, 116u8, 111u8, 111u8, 108u8, 34u8, 58u8, 34u8, 97u8, 120u8, 105u8, 111u8, 109u8,
    48u8, 34u8, 44u8, 34u8, 100u8, 105u8, 97u8, 103u8, 110u8, 111u8, 115u8, 116u8, 105u8, 99u8, 115u8, 34u8, 58u8, 91u8, 123u8, 34u8, 105u8, 100u8, 34u8, 58u8, 44u8, 34u8, 99u8, 111u8, 100u8, 101u8, 34u8, 58u8,
    44u8, 34u8, 115u8, 101u8, 118u8, 101u8, 114u8, 105u8, 116u8, 121u8, 34u8, 58u8, 44u8, 34u8, 112u8, 114u8, 105u8, 109u8, 97u8, 114u8, 121u8, 34u8, 58u8, 44u8, 34u8, 108u8, 97u8, 98u8, 101u8, 108u8, 115u8, 34u8,
    58u8, 44u8, 34u8, 110u8, 111u8, 116u8, 101u8, 115u8, 34u8, 58u8, 44u8, 34u8, 104u8, 101u8, 108u8, 112u8, 115u8, 34u8, 58u8, 44u8, 34u8, 102u8, 105u8, 120u8, 101u8, 115u8, 34u8, 58u8, 44u8, 34u8, 100u8, 97u8,
    116u8, 97u8, 34u8, 58u8, 44u8, 34u8, 101u8, 114u8, 114u8, 111u8, 114u8, 115u8, 34u8, 58u8, 44u8, 34u8, 119u8, 97u8, 114u8, 110u8, 105u8, 110u8, 103u8, 115u8, 34u8, 58u8, 123u8, 34u8, 109u8, 101u8, 115u8, 115u8,
    97u8, 103u8, 101u8, 34u8, 58u8,
];

fn diag_buf_push_json_str(b: mut_view<DiagBuffer>, start: usize, byte_count: usize) {
    let mut i: usize = 0;
    while i < byte_count {
        diag_buf_push_byte(mut_view(*b), JSON_STRS[start + i]);
        i = i + 1;
    }
}

pub fn write_json_string(b: mut_view<DiagBuffer>, sv: StrView) {
    diag_buf_push_byte(mut_view(*b), 34u8);
    let mut i: usize = 0;
    while i < sv.len {
        let c = unsafe { *(sv.ptr + i) };
        if c == 34u8 {
            diag_buf_push_json_str(mut_view(*b), 0, 2);
        } else if c == 92u8 {
            diag_buf_push_json_str(mut_view(*b), 2, 2);
        } else if c == 8u8 {
            diag_buf_push_json_str(mut_view(*b), 4, 2);
        } else if c == 12u8 {
            diag_buf_push_json_str(mut_view(*b), 6, 2);
        } else if c == 10u8 {
            diag_buf_push_json_str(mut_view(*b), 8, 2);
        } else if c == 13u8 {
            diag_buf_push_json_str(mut_view(*b), 10, 2);
        } else if c == 9u8 {
            diag_buf_push_json_str(mut_view(*b), 12, 2);
        } else if c < 32u8 {
            diag_buf_push_byte(mut_view(*b), 92u8);
            diag_buf_push_byte(mut_view(*b), 117u8);
            diag_buf_push_byte(mut_view(*b), 48u8);
            diag_buf_push_byte(mut_view(*b), 48u8);
            diag_buf_push_byte(mut_view(*b), hex_digit(c / 16u8));
            diag_buf_push_byte(mut_view(*b), hex_digit(c % 16u8));
        } else {
            diag_buf_push_byte(mut_view(*b), c);
        }
        i = i + 1;
    }
    diag_buf_push_byte(b, 34u8);
}

fn write_severity(b: mut_view<DiagBuffer>, sev: DiagSeverity) {
    match sev {
        DiagSeverity.Error => {
            diag_buf_push_json_str(b, 14, 7);
        },
        DiagSeverity.Warning => {
            diag_buf_push_json_str(b, 21, 9);
        },
        DiagSeverity.Info => {
            diag_buf_push_json_str(b, 30, 6);
        },
        DiagSeverity.Hint => {
            diag_buf_push_json_str(b, 36, 6);
        },
    }
}

fn write_span(b: mut_view<DiagBuffer>, db: view<SourceDatabase>, span: Span) {
    if span_is_none(view(span)) {
        diag_buf_push_json_str(b, 42, 4);
        return;
    }

    let s_start: u32 = span.start;
    let s_end: u32 = span.end;
    let path = source_db_path(db, copy_fid(view(span.file)));
    let lc_start = source_db_line_col(db, span_new(copy_fid(view(span.file)), s_start, s_start));
    let lc_end = source_db_line_col(db, span_new(copy_fid(view(span.file)), s_end, s_end));

    diag_buf_push_json_str(mut_view(*b), 46, 8);

    diag_buf_push_byte(mut_view(*b), 34u8);
    let mut i: usize = 0;
    while i < path.len {
        let c = unsafe { *(path.ptr + i) };
        if c == 92u8 {
            diag_buf_push_byte(mut_view(*b), 47u8);
        } else if c == 34u8 {
            diag_buf_push_byte(mut_view(*b), 92u8);
            diag_buf_push_byte(mut_view(*b), 34u8);
        } else {
            diag_buf_push_byte(mut_view(*b), c);
        }
        i = i + 1;
    }
    diag_buf_push_byte(mut_view(*b), 34u8);

    diag_buf_push_json_str(mut_view(*b), 54, 9);
    diag_buf_push_u32(mut_view(*b), span.start);

    diag_buf_push_json_str(mut_view(*b), 63, 7);
    diag_buf_push_u32(mut_view(*b), span.end);

    diag_buf_push_json_str(mut_view(*b), 70, 8);
    diag_buf_push_u32(mut_view(*b), lc_start.line);

    diag_buf_push_json_str(mut_view(*b), 78, 7);
    diag_buf_push_u32(mut_view(*b), lc_start.col_chars);

    diag_buf_push_json_str(mut_view(*b), 85, 12);
    diag_buf_push_u32(mut_view(*b), lc_end.line);

    diag_buf_push_json_str(mut_view(*b), 97, 11);
    diag_buf_push_u32(mut_view(*b), lc_end.col_chars);

    diag_buf_push_byte(b, 125u8);
}

fn write_labels(b: mut_view<DiagBuffer>, db: view<SourceDatabase>, d: view<Diagnostic>) {
    diag_buf_push_byte(mut_view(*b), 91u8);
    let mut i: usize = 0;
    while i < d.label_count {
        if i > 0 {
            diag_buf_push_byte(mut_view(*b), 44u8);
        }
        let lbl = unsafe { *((d.labels as usize + (((i as isize) * (size_of<DiagLabel>() as isize)) as usize)) as *const DiagLabel) };
        diag_buf_push_json_str(mut_view(*b), 108, 8);
        write_span(mut_view(*b), db, lbl.span);

        diag_buf_push_json_str(mut_view(*b), 116, 11);
        write_json_string(mut_view(*b), lbl.message);

        diag_buf_push_byte(mut_view(*b), 125u8);
        i = i + 1;
    }
    diag_buf_push_byte(b, 93u8);
}

fn write_string_array(b: mut_view<DiagBuffer>, arr: *mut StrView, count: usize) {
    diag_buf_push_byte(mut_view(*b), 91u8);
    let mut i: usize = 0;
    while i < count {
        if i > 0 {
            diag_buf_push_byte(mut_view(*b), 44u8);
        }
        let sv = unsafe { *((arr as usize + (((i as isize) * (size_of<StrView>() as isize)) as usize)) as *const StrView) };
        write_json_string(mut_view(*b), sv);
        i = i + 1;
    }
    diag_buf_push_byte(b, 93u8);
}

fn write_fixes(b: mut_view<DiagBuffer>, db: view<SourceDatabase>, d: view<Diagnostic>) {
    diag_buf_push_byte(mut_view(*b), 91u8);
    let mut i: usize = 0;
    while i < d.fix_count {
        if i > 0 {
            diag_buf_push_byte(mut_view(*b), 44u8);
        }
        let fix = unsafe { *((d.fixes as usize + (((i as isize) * (size_of<DiagFix>() as isize)) as usize)) as *const DiagFix) };

        diag_buf_push_json_str(mut_view(*b), 378, 11);
        write_json_string(mut_view(*b), fix.message);

        diag_buf_push_json_str(mut_view(*b), 127, 17);
        match fix.applicability {
            FixApplicability.MachineApplicable => {
                diag_buf_push_json_str(mut_view(*b), 144, 20);
            },
            FixApplicability.MaybeApplicable => {
                diag_buf_push_json_str(mut_view(*b), 164, 18);
            },
            FixApplicability.ManualReview => {
                diag_buf_push_json_str(mut_view(*b), 182, 15);
            },
        }

        diag_buf_push_json_str(mut_view(*b), 197, 10);
        let mut j: usize = 0;
        while j < fix.edit_count {
            if j > 0 {
                diag_buf_push_byte(mut_view(*b), 44u8);
            }
            let edit = unsafe { *((fix.edits as usize + (((j as isize) * (size_of<DiagEdit>() as isize)) as usize)) as *const DiagEdit) };
            diag_buf_push_json_str(mut_view(*b), 108, 8);
            write_span(mut_view(*b), db, edit.span);

            diag_buf_push_json_str(mut_view(*b), 207, 15);
            write_json_string(mut_view(*b), edit.replacement);

            diag_buf_push_byte(mut_view(*b), 125u8);
            j = j + 1;
        }
        diag_buf_push_byte(mut_view(*b), 93u8);
        diag_buf_push_byte(mut_view(*b), 125u8);
        i = i + 1;
    }
    diag_buf_push_byte(b, 93u8);
}

fn write_data(b: mut_view<DiagBuffer>, d: view<Diagnostic>) {
    diag_buf_push_byte(mut_view(*b), 123u8);
    let mut i: usize = 0;
    while i < d.data_count {
        if i > 0 {
            diag_buf_push_byte(mut_view(*b), 44u8);
        }
        let entry = unsafe { *((d.data as usize + (((i as isize) * (size_of<DiagDataEntry>() as isize)) as usize)) as *const DiagDataEntry) };
        write_json_string(mut_view(*b), entry.key);
        diag_buf_push_byte(mut_view(*b), 58u8);

        match entry.value.kind {
            DiagDataKind.String => {
                write_json_string(mut_view(*b), entry.value.str_val);
            },
            DiagDataKind.Integer => {
                let mut val = entry.value.int_val;
                if val < 0 {
                    diag_buf_push_byte(mut_view(*b), 45u8);
                    val = 0 - val;
                }
                diag_buf_push_u32(mut_view(*b), val as u32);
            },
            DiagDataKind.Boolean => {
                if entry.value.bool_val {
                    diag_buf_push_json_str(mut_view(*b), 222, 4);
                } else {
                    diag_buf_push_json_str(mut_view(*b), 226, 5);
                }
            },
            DiagDataKind.StringList => {
                write_string_array(mut_view(*b), entry.value.list_items, entry.value.list_count);
            },
        }
        i = i + 1;
    }
    diag_buf_push_byte(b, 125u8);
}

pub fn ax_diag_render_json(sink: view<DiagSink>, db: view<SourceDatabase>, out: mut_view<DiagBuffer>) {
    diag_buf_push_json_str(mut_view(*out), 231, 43);

    let mut i: usize = 0;
    while i < sink.len {
        if i > 0 {
            diag_buf_push_byte(mut_view(*out), 44u8);
        }
        let d = unsafe { *((sink.diags as usize + (((i as isize) * (size_of<Diagnostic>() as isize)) as usize)) as *const Diagnostic) };

        diag_buf_push_json_str(mut_view(*out), 274, 6);
        diag_buf_push_u32(mut_view(*out), i as u32);

        diag_buf_push_json_str(mut_view(*out), 280, 8);
        diag_buf_push_byte(mut_view(*out), 34u8);
        diag_buf_push_code_name(mut_view(*out), d.code);
        diag_buf_push_byte(mut_view(*out), 34u8);

        diag_buf_push_json_str(mut_view(*out), 288, 12);
        write_severity(mut_view(*out), d.severity);

        diag_buf_push_json_str(mut_view(*out), 116, 11);
        write_json_string(mut_view(*out), copy_sv(view(d.message)));

        diag_buf_push_json_str(mut_view(*out), 300, 11);
        write_span(mut_view(*out), db, copy_span(view(d.primary)));

        diag_buf_push_json_str(mut_view(*out), 311, 10);
        write_labels(mut_view(*out), db, view(d));

        diag_buf_push_json_str(mut_view(*out), 321, 9);
        write_string_array(mut_view(*out), d.notes, d.note_count);

        diag_buf_push_json_str(mut_view(*out), 330, 9);
        write_string_array(mut_view(*out), d.helps, d.help_count);

        diag_buf_push_json_str(mut_view(*out), 339, 9);
        write_fixes(mut_view(*out), db, view(d));

        diag_buf_push_json_str(mut_view(*out), 348, 8);
        write_data(mut_view(*out), view(d));

        diag_buf_push_byte(mut_view(*out), 125u8);
        i = i + 1;
    }
    diag_buf_push_byte(mut_view(*out), 93u8);

    diag_buf_push_json_str(mut_view(*out), 356, 10);
    diag_buf_push_u32(mut_view(*out), sink.errors as u32);

    diag_buf_push_json_str(mut_view(*out), 366, 12);
    diag_buf_push_u32(mut_view(*out), sink.warnings as u32);

    diag_buf_push_byte(mut_view(*out), 125u8);
    diag_buf_push_byte(out, 10u8);
}

fn alloc_mem(scratch: mut_view<Arena>, byte_count: usize) -> *mut u8 {
    arena_alloc_raw(scratch, byte_count, 1)
}

fn make_sv(ptr: *const u8, byte_count: usize) -> StrView {
    StrView { ptr: ptr, len: byte_count }
}

// TEST 1: Buffer Operations
fn test_buffer_operations() -> i32 {
    let mut scratch = arena_new();
    let mut b = diag_buf_new();
    if b.len != 0 || b.cap != 0 { return 101; }

    diag_buf_push_byte(mut_view(b), 65u8);
    diag_buf_push_byte(mut_view(b), 66u8);
    if b.len != 2 { return 102; }

    diag_buf_push_byte(mut_view(b), 32u8);
    diag_buf_push_u32(mut_view(b), 0u32);
    diag_buf_push_byte(mut_view(b), 32u8);
    diag_buf_push_u32(mut_view(b), 42u32);
    diag_buf_push_byte(mut_view(b), 32u8);
    diag_buf_push_u32(mut_view(b), 987654u32);

    let sv = diag_buf_as_str_view(view(b));
    let p_needle = alloc_mem(mut_view(scratch), 14);
    unsafe {
        *p_needle = 65u8;
        *(p_needle + 1) = 66u8;
        *(p_needle + 2) = 32u8;
        *(p_needle + 3) = 48u8;
        *(p_needle + 4) = 32u8;
        *(p_needle + 5) = 52u8;
        *(p_needle + 6) = 50u8;
        *(p_needle + 7) = 32u8;
        *(p_needle + 8) = 57u8;
        *(p_needle + 9) = 56u8;
        *(p_needle + 10) = 55u8;
        *(p_needle + 11) = 54u8;
        *(p_needle + 12) = 53u8;
        *(p_needle + 13) = 52u8;
    }
    let needle = make_sv(p_needle, 14);
    let eq = sv_eq(sv, needle);
    if !eq { return 103; }

    let mut b2 = diag_buf_new();
    diag_buf_push_code_name(mut_view(b2), diag_code(0u32));
    let sv2 = diag_buf_as_str_view(view(b2));
    if sv2.len != 19 { return 104; }

    let mut b3 = diag_buf_new();
    diag_buf_push_code_name(mut_view(b3), diag_code(200u32));
    let sv3 = diag_buf_as_str_view(view(b3));
    if sv3.len != 9 { return (1000 + sv3.len) as i32; }

    diag_buf_free(mut_view(b));
    diag_buf_free(mut_view(b2));
    diag_buf_free(mut_view(b3));
    arena_destroy(mut_view(scratch));
    0
}

// TEST 2: JSON String Escaping
fn test_json_escaping() -> i32 {
    let mut scratch = arena_new();
    let mut b = diag_buf_new();
    let p_raw = alloc_mem(mut_view(scratch), 6);
    unsafe {
        *p_raw = 34u8;
        *(p_raw + 1) = 92u8;
        *(p_raw + 2) = 9u8;
        *(p_raw + 3) = 10u8;
        *(p_raw + 4) = 13u8;
        *(p_raw + 5) = 1u8;
    }
    let sv = make_sv(p_raw, 6);
    write_json_string(mut_view(b), sv);

    let res = diag_buf_as_str_view(view(b));
    if res.len != 18 { return 201; }
    if unsafe { *(res.ptr) } != 34u8 { return 202; }
    if unsafe { *(res.ptr + 17) } != 34u8 { return 203; }

    diag_buf_free(mut_view(b));
    arena_destroy(mut_view(scratch));
    0
}

