// TEST 5: Differential verification against byte-exact fixture from C axiom0
const EXPECTED_JSON_FIXTURE: [238]u8 = [
    123u8, 34u8, 115u8, 99u8, 104u8, 101u8, 109u8, 97u8, 34u8, 58u8, 49u8, 44u8, 34u8, 116u8, 111u8, 111u8, 108u8, 34u8, 58u8, 34u8,
