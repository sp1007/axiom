// test: run
// stdout: OK Diag Emitter\n

module main

use host_intrinsics.heap_alloc
use host_intrinsics.heap_free
use host_intrinsics.exit
use compiler.kernel.arena.Arena
use compiler.diag.emitter.DiagDataEntry
use compiler.diag.code.DiagDataKind
use compiler.diag.emitter.DiagDataValue
use compiler.diag.emitter.DiagEdit
use compiler.diag.emitter.DiagFix
use compiler.diag.emitter.DiagLabel
use compiler.diag.code.DiagSeverity
use compiler.diag.emitter.Diagnostic
use compiler.kernel.id.FileId
use compiler.diag.code.FixApplicability
use compiler.kernel.interner.StrView
use compiler.kernel.arena.arena_alloc_raw
use compiler.kernel.arena.arena_destroy
use compiler.kernel.arena.arena_new
use compiler.diag.code.diag_code
use compiler.diag.emitter.diag_sink_free
use compiler.diag.emitter.diag_sink_new
use compiler.diag.emitter.diag_sink_report
use compiler.diag.emitter.diag_sink_sort
use compiler.source.span.span_new
use compiler.source.span.span_none

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic fn wrapping_add_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn rotate_left_u64(x: u64, n: u32) -> u64 { 0 }

fn qa_sv_eq(a: StrView, b: StrView) -> bool {
    if a.len != b.len { return false; }
    let mut i: usize = 0;
    while i < a.len {
        let ba: u8 = unsafe { *(a.ptr + i) };
        let bb: u8 = unsafe { *(b.ptr + i) };
        if ba != bb { return false; }
        i = i + 1;
    }
    true
}

unsafe fn test_diag_ptr(diags: *mut Diagnostic, idx: usize) -> *mut Diagnostic {
    diags + idx
}

// Helpers for test strings
fn alloc_sv_msg(a: mut_view<Arena>, id: u32) -> StrView {
    let p = arena_alloc_raw(a, 4, 1);
    unsafe {
        *p = 109u8; // 'm'
        *(p + 1) = 115u8; // 's'
        *(p + 2) = 103u8; // 'g'
        *(p + 3) = (id as u8) + 48u8;
    }
    StrView { ptr: p as *const u8, len: 4 }
}

fn alloc_sv_label(a: mut_view<Arena>) -> StrView {
    let p = arena_alloc_raw(a, 5, 1);
    unsafe { *p = 108u8; *(p+1) = 97u8; *(p+2) = 98u8; *(p+3) = 101u8; *(p+4) = 108u8; }
    StrView { ptr: p as *const u8, len: 5 }
}

fn alloc_sv_note(a: mut_view<Arena>) -> StrView {
    let p = arena_alloc_raw(a, 4, 1);
    unsafe { *p = 110u8; *(p+1) = 111u8; *(p+2) = 116u8; *(p+3) = 101u8; }
    StrView { ptr: p as *const u8, len: 4 }
}

fn alloc_sv_help(a: mut_view<Arena>) -> StrView {
    let p = arena_alloc_raw(a, 4, 1);
    unsafe { *p = 104u8; *(p+1) = 101u8; *(p+2) = 108u8; *(p+3) = 112u8; }
    StrView { ptr: p as *const u8, len: 4 }
}

fn alloc_sv_fix(a: mut_view<Arena>) -> StrView {
    let p = arena_alloc_raw(a, 3, 1);
    unsafe { *p = 102u8; *(p+1) = 105u8; *(p+2) = 120u8; }
    StrView { ptr: p as *const u8, len: 3 }
}

fn alloc_sv_repl(a: mut_view<Arena>) -> StrView {
    let p = arena_alloc_raw(a, 4, 1);
    unsafe { *p = 114u8; *(p+1) = 101u8; *(p+2) = 112u8; *(p+3) = 108u8; }
    StrView { ptr: p as *const u8, len: 4 }
}

fn alloc_sv_key(a: mut_view<Arena>) -> StrView {
    let p = arena_alloc_raw(a, 3, 1);
    unsafe { *p = 107u8; *(p+1) = 101u8; *(p+2) = 121u8; }
    StrView { ptr: p as *const u8, len: 3 }
}

fn alloc_sv_val(a: mut_view<Arena>) -> StrView {
    let p = arena_alloc_raw(a, 3, 1);
    unsafe { *p = 118u8; *(p+1) = 97u8; *(p+2) = 108u8; }
    StrView { ptr: p as *const u8, len: 3 }
}

fn main() -> i32 {
    let mut scratch = arena_new();
    let mut sink = diag_sink_new();
    if sink.len != 0 { return 1; }
    if sink.errors != 0 { return 2; }
    if sink.warnings != 0 { return 3; }

    let msg1 = alloc_sv_msg(mut_view(scratch), 1u32);
    let d1 = Diagnostic {
        code: diag_code(20u32),
        severity: DiagSeverity.Error,
        message: msg1,
        primary: span_new(FileId { v: 2u32 }, 50u32, 60u32),
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    diag_sink_report(mut_view(sink), view(d1));

    if sink.len != 1 { return 4; }
    if sink.errors != 1 { return 5; }
    if sink.warnings != 0 { return 6; }

    // Diag 2 with labels, notes, helps, fixes, data
    let msg2 = alloc_sv_msg(mut_view(scratch), 2u32);
    let mut d2 = Diagnostic {
        code: diag_code(49u32),
        severity: DiagSeverity.Warning,
        message: msg2,
        primary: span_new(FileId { v: 1u32 }, 100u32, 105u32),
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };

    let l_msg = alloc_sv_label(mut_view(scratch));
    let label_mem = arena_alloc_raw(mut_view(scratch), size_of<DiagLabel>(), align_of<DiagLabel>()) as *mut DiagLabel;
    unsafe {
        *label_mem = DiagLabel { span: span_new(FileId { v: 1u32 }, 80u32, 85u32), message: l_msg };
    }
    d2.labels = label_mem;
    d2.label_count = 1;

    let note_sv = alloc_sv_note(mut_view(scratch));
    let note_mem = arena_alloc_raw(mut_view(scratch), size_of<StrView>(), align_of<StrView>()) as *mut StrView;
    unsafe {
        *note_mem = note_sv;
    }
    d2.notes = note_mem;
    d2.note_count = 1;

    let help_sv = alloc_sv_help(mut_view(scratch));
    let help_mem = arena_alloc_raw(mut_view(scratch), size_of<StrView>(), align_of<StrView>()) as *mut StrView;
    unsafe {
        *help_mem = help_sv;
    }
    d2.helps = help_mem;
    d2.help_count = 1;

    let fix_msg = alloc_sv_fix(mut_view(scratch));
    let repl_sv = alloc_sv_repl(mut_view(scratch));
    let edit_mem = arena_alloc_raw(mut_view(scratch), size_of<DiagEdit>(), align_of<DiagEdit>()) as *mut DiagEdit;
    unsafe {
        *edit_mem = DiagEdit { span: span_new(FileId { v: 1u32 }, 100u32, 101u32), replacement: repl_sv };
    }
    let fix_mem = arena_alloc_raw(mut_view(scratch), size_of<DiagFix>(), align_of<DiagFix>()) as *mut DiagFix;
    unsafe {
        *fix_mem = DiagFix { message: fix_msg, applicability: FixApplicability.MachineApplicable, edits: edit_mem, edit_count: 1 };
    }
    d2.fixes = fix_mem;
    d2.fix_count = 1;

    let key_sv = alloc_sv_key(mut_view(scratch));
    let val_sv = alloc_sv_val(mut_view(scratch));
    let data_mem = arena_alloc_raw(mut_view(scratch), size_of<DiagDataEntry>(), align_of<DiagDataEntry>()) as *mut DiagDataEntry;
    unsafe {
        *data_mem = DiagDataEntry {
            key: key_sv,
            value: DiagDataValue {
                kind: DiagDataKind.String,
                str_val: val_sv,
                int_val: 42,
                bool_val: true,
                list_items: 0 as *mut StrView,
                list_count: 0,
            },
        };
    }
    d2.data = data_mem;
    d2.data_count = 1;

    diag_sink_report(mut_view(sink), view(d2));

    if sink.len != 2 { return 7; }
    if sink.errors != 1 { return 8; }
    if sink.warnings != 1 { return 9; }

    // Diag 3: file 1, start 10
    let msg3 = alloc_sv_msg(mut_view(scratch), 3u32);
    let d3 = Diagnostic {
        code: diag_code(57u32),
        severity: DiagSeverity.Error,
        message: msg3,
        primary: span_new(FileId { v: 1u32 }, 10u32, 20u32),
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    diag_sink_report(mut_view(sink), view(d3));

    // Diag 4: span_none
    let msg4 = alloc_sv_msg(mut_view(scratch), 4u32);
    let d4 = Diagnostic {
        code: diag_code(130u32),
        severity: DiagSeverity.Error,
        message: msg4,
        primary: span_none(),
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    diag_sink_report(mut_view(sink), view(d4));

    // Diag 5: file 1, start 10 (same span, different code 58)
    let msg5 = alloc_sv_msg(mut_view(scratch), 5u32);
    let d5 = Diagnostic {
        code: diag_code(58u32),
        severity: DiagSeverity.Error,
        message: msg5,
        primary: span_new(FileId { v: 1u32 }, 10u32, 20u32),
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    diag_sink_report(mut_view(sink), view(d5));

    if sink.len != 5 { return 10; }
    if sink.errors != 4 { return 11; }
    if sink.warnings != 1 { return 12; }

    // Sort sink
    diag_sink_sort(mut_view(sink));

    // Expected order matching sink.c:
    // 0: span none, code 130 (da_none comes first)
    // 1: file 1, start 10, code 57
    // 2: file 1, start 10, code 58
    // 3: file 1, start 100, code 49
    // 4: file 2, start 50, code 20
    let r0 = unsafe { *(test_diag_ptr(sink.diags, 0)) };
    let r1 = unsafe { *(test_diag_ptr(sink.diags, 1)) };
    let r2 = unsafe { *(test_diag_ptr(sink.diags, 2)) };
    let r3 = unsafe { *(test_diag_ptr(sink.diags, 3)) };
    let r4 = unsafe { *(test_diag_ptr(sink.diags, 4)) };

    if r0.primary.file.v != 0u32 || r0.code.v != 130u32 { return 13; }
    if r1.primary.file.v != 1u32 || r1.primary.start != 10u32 || r1.code.v != 57u32 { return 14; }
    if r2.primary.file.v != 1u32 || r2.primary.start != 10u32 || r2.code.v != 58u32 { return 15; }
    if r3.primary.file.v != 1u32 || r3.primary.start != 100u32 || r3.code.v != 49u32 { return 16; }
    if r4.primary.file.v != 2u32 || r4.primary.start != 50u32 || r4.code.v != 20u32 { return 17; }

    // Verify deep copy of labels, notes, fixes, data on r3 (was d2)
    if r3.label_count != 1 { return 18; }
    let r3_lbl = unsafe { *(r3.labels) };
    if r3_lbl.span.file.v != 1u32 || r3_lbl.span.start != 80u32 { return 19; }
    if !qa_sv_eq(r3_lbl.message, alloc_sv_label(mut_view(scratch))) { return 20; }

    if r3.note_count != 1 { return 21; }
    let r3_note = unsafe { *(r3.notes) };
    if !qa_sv_eq(r3_note, alloc_sv_note(mut_view(scratch))) { return 22; }

    if r3.help_count != 1 { return 23; }
    let r3_help = unsafe { *(r3.helps) };
    if !qa_sv_eq(r3_help, alloc_sv_help(mut_view(scratch))) { return 24; }

    if r3.fix_count != 1 { return 25; }
    let r3_fix = unsafe { *(r3.fixes) };
    if !qa_sv_eq(r3_fix.message, alloc_sv_fix(mut_view(scratch))) || r3_fix.edit_count != 1 { return 26; }
    let r3_edit = unsafe { *(r3_fix.edits) };
    if r3_edit.span.start != 100u32 || !qa_sv_eq(r3_edit.replacement, alloc_sv_repl(mut_view(scratch))) { return 27; }

    if r3.data_count != 1 { return 28; }
    let r3_data = unsafe { *(r3.data) };
    if !qa_sv_eq(r3_data.key, alloc_sv_key(mut_view(scratch))) || r3_data.value.int_val != 42 || !r3_data.value.bool_val { return 29; }
    if !qa_sv_eq(r3_data.value.str_val, alloc_sv_val(mut_view(scratch))) { return 30; }

    diag_sink_free(mut_view(sink));
    arena_destroy(mut_view(scratch));

    print("OK Diag Emitter\n");
    0
}
