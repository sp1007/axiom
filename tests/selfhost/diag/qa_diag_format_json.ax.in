            key: sv_k3,
            value: DiagDataValue {
                kind: DiagDataKind.Boolean,
                str_val: StrView { ptr: 0 as *const u8, len: 0 },
                int_val: 0,
                bool_val: true,
                list_items: 0 as *mut StrView,
                list_count: 0,
