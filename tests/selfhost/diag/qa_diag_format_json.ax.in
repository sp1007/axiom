    115u8, 115u8, 97u8, 103u8, 101u8, 34u8, 58u8, 34u8, 110u8, 111u8, 32u8, 115u8, 116u8, 100u8, 32u8, 114u8, 111u8, 111u8, 116u8,
    32u8, 102u8, 111u8, 117u8, 110u8, 100u8, 32u8, 40u8, 65u8, 68u8, 82u8, 45u8, 48u8, 48u8, 48u8, 54u8, 32u8, 194u8, 167u8, 56u8,
    41u8, 34u8, 44u8, 34u8, 112u8, 114u8, 105u8, 109u8, 97u8, 114u8, 121u8, 34u8, 58u8, 110u8, 117u8, 108u8, 108u8, 44u8, 34u8,
    108u8, 97u8, 98u8, 101u8, 108u8, 115u8, 34u8, 58u8, 91u8, 93u8, 44u8, 34u8, 110u8, 111u8, 116u8, 101u8, 115u8, 34u8, 58u8,
    91u8, 93u8, 44u8, 34u8, 104u8, 101u8, 108u8, 112u8, 115u8, 34u8, 58u8, 91u8, 93u8, 44u8, 34u8, 102u8, 105u8, 120u8, 101u8,
    115u8, 34u8, 58u8, 91u8, 93u8, 44u8, 34u8, 100u8, 97u8, 116u8, 97u8, 34u8, 58u8, 123u8, 125u8, 125u8, 93u8, 44u8, 34u8,
    101u8, 114u8, 114u8, 111u8, 114u8, 115u8, 34u8, 58u8, 49u8, 44u8, 34u8, 119u8, 97u8, 114u8, 110u8, 105u8, 110u8, 103u8,
    115u8, 34u8, 58u8, 48u8, 125u8, 10u8
];

fn test_differential_fixture() -> i32 {
    let mut scratch = arena_new();
    let mut db: SourceDatabase = SourceDatabase {
        arena: arena_new(),
        files: 0 as *mut SourceFile,
        files_count: 0,
        files_cap: 0,
    };
    source_db_init(mut_view(db));

    let mut sink = diag_sink_new();

    let p_msg = alloc_mem(mut_view(scratch), 32);
    unsafe {
        *p_msg = 110u8;
        *(p_msg + 1) = 111u8;
        *(p_msg + 2) = 32u8;
        *(p_msg + 3) = 115u8;
        *(p_msg + 4) = 116u8;
        *(p_msg + 5) = 100u8;
        *(p_msg + 6) = 32u8;
        *(p_msg + 7) = 114u8;
        *(p_msg + 8) = 111u8;
        *(p_msg + 9) = 111u8;
        *(p_msg + 10) = 116u8;
        *(p_msg + 11) = 32u8;
        *(p_msg + 12) = 102u8;
        *(p_msg + 13) = 111u8;
        *(p_msg + 14) = 117u8;
        *(p_msg + 15) = 110u8;
        *(p_msg + 16) = 100u8;
        *(p_msg + 17) = 32u8;
        *(p_msg + 18) = 40u8;
        *(p_msg + 19) = 65u8;
        *(p_msg + 20) = 68u8;
        *(p_msg + 21) = 82u8;
        *(p_msg + 22) = 45u8;
        *(p_msg + 23) = 48u8;
        *(p_msg + 24) = 48u8;
        *(p_msg + 25) = 48u8;
        *(p_msg + 26) = 54u8;
        *(p_msg + 27) = 32u8;
        *(p_msg + 28) = 194u8;
        *(p_msg + 29) = 167u8;
        *(p_msg + 30) = 56u8;
        *(p_msg + 31) = 41u8;
    }
    let sv_msg = make_sv(p_msg, 32);

    let diag = Diagnostic {
        code: diag_code(128u32),
        severity: DiagSeverity.Error,
        message: sv_msg,
        primary: span_none(),
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    diag_sink_report(mut_view(sink), view(diag));

    let mut out = diag_buf_new();
    ax_diag_render_json(view(sink), view(db), mut_view(out));

    if out.len != 238 {
        return 501;
    }

    let mut i: usize = 0;
    while i < 238 {
        let b_out = unsafe { *(out.ptr + i) };
        let b_exp = EXPECTED_JSON_FIXTURE[i];
        if b_out != b_exp {
            return (1000 + i) as i32;
        }
        i = i + 1;
    }

    diag_buf_free(mut_view(out));
    diag_sink_free(mut_view(sink));
    source_db_free(mut_view(db));
    arena_destroy(mut_view(scratch));
    0
}

fn main() -> i32 {
    let r1 = test_buffer_operations();
    if r1 != 0 { return r1; }

    let r2 = test_json_escaping();
    if r2 != 0 { return r2; }

    let r3 = test_human_rendering();
    if r3 != 0 { return r3; }

    let r4 = test_json_rendering();
    if r4 != 0 { return r4; }

    let r5 = test_differential_fixture();
    if r5 != 0 { return r5; }

    print("OK Diag Format JSON\n");
    0
}
