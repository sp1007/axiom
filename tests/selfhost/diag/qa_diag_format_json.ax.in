    let edits_arr = arena_alloc_raw(mut_view(scratch), size_of<DiagEdit>(), align_of<DiagEdit>()) as *mut DiagEdit;
    unsafe {
        *edits_arr = DiagEdit {
            span: span_new(FileId { v: fid.v }, 1u32, 3u32),
            replacement: sv_dot,
        };
    }

    let fixes_arr = arena_alloc_raw(mut_view(scratch), size_of<DiagFix>(), align_of<DiagFix>()) as *mut DiagFix;
    unsafe {
        *fixes_arr = DiagFix {
            message: sv_fix,
            applicability: FixApplicability.MachineApplicable,
            edits: edits_arr,
            edit_count: 1,
        };
    }

    let p_k1 = alloc_mem(mut_view(scratch), 2);
    unsafe {
        *p_k1 = 107u8;
        *(p_k1 + 1) = 49u8;
    }
    let sv_k1 = make_sv(p_k1, 2);
    let p_v1 = alloc_mem(mut_view(scratch), 2);
    unsafe {
        *p_v1 = 118u8;
        *(p_v1 + 1) = 49u8;
