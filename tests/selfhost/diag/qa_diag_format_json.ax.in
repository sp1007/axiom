        *(p_k3 + 1) = 51u8;
    }
    let sv_k3 = make_sv(p_k3, 2);

    let data_arr = arena_alloc_raw(mut_view(scratch), (((3 as isize) * (size_of<DiagDataEntry>() as isize)) as usize), align_of<DiagDataEntry>()) as *mut DiagDataEntry;
    unsafe {
        *(data_arr) = DiagDataEntry {
            key: sv_k1,
