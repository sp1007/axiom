    diag_sink_report(mut_view(sink), view(diag));

    let mut out = diag_buf_new();
    ax_diag_render_json(view(sink), view(db), mut_view(out));

    let rendered = diag_buf_as_str_view(view(out));

    let p_n1 = alloc_mem(mut_view(scratch), 10);
    unsafe {
        *p_n1 = 34u8;
        *(p_n1 + 1) = 115u8;
        *(p_n1 + 2) = 99u8;
        *(p_n1 + 3) = 104u8;
        *(p_n1 + 4) = 101u8;
        *(p_n1 + 5) = 109u8;
        *(p_n1 + 6) = 97u8;
        *(p_n1 + 7) = 34u8;
        *(p_n1 + 8) = 58u8;
        *(p_n1 + 9) = 49u8;
    }
    let n1 = make_sv(p_n1, 10);
    let has1 = sv_contains(rendered, n1);
    if !has1 { return 401; }

    let p_n2 = alloc_mem(mut_view(scratch), 8);
    unsafe {
        *p_n2 = 65u8;
        *(p_n2 + 1) = 88u8;
