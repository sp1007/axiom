@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic fn wrapping_add_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn rotate_left_u64(x: u64, n: u32) -> u64 { 0 }

fn qa_sv_eq(a: StrView, b: StrView) -> bool {
    if a.len != b.len { return false; }
    let mut i: usize = 0;
    while i < a.len {
        let ba: u8 = unsafe { *(a.ptr + i) };
        let bb: u8 = unsafe { *(b.ptr + i) };
        if ba != bb { return false; }
        i = i + 1;
    }
    true
}

fn sv_contains(haystack: StrView, needle: StrView) -> bool {
    let hlen: usize = haystack.len;
    let nlen: usize = needle.len;
    if nlen == 0 { return true; }
    if hlen < nlen { return false; }
    let max_start = hlen - nlen;
    let mut i: usize = 0;
    while i <= max_start {
        let mut match_all = true;
        let mut j: usize = 0;
        while j < nlen {
            let h = unsafe { *(haystack.ptr + i + j) };
            let n = unsafe { *(needle.ptr + j) };
            if h != n { match_all = false; break; }
            j = j + 1;
        }
        if match_all { return true; }
        i = i + 1;
    }
    false
}

fn alloc_mem(scratch: mut_view<Arena>, byte_count: usize) -> *mut u8 {
    arena_alloc_raw(scratch, byte_count, 1)
}

fn make_sv(ptr: *const u8, byte_count: usize) -> StrView {
    StrView { ptr: ptr, len: byte_count }
}

// TEST 1: Buffer Operations
fn test_buffer_operations() -> i32 {
    let mut scratch = arena_new();
    let mut b = diag_buf_new();
    if b.len != 0 || b.cap != 0 { return 101; }

    diag_buf_push_byte(mut_view(b), 65u8);
    diag_buf_push_byte(mut_view(b), 66u8);
    if b.len != 2 { return 102; }

    diag_buf_push_byte(mut_view(b), 32u8);
    diag_buf_push_u32(mut_view(b), 0u32);
    diag_buf_push_byte(mut_view(b), 32u8);
    diag_buf_push_u32(mut_view(b), 42u32);
    diag_buf_push_byte(mut_view(b), 32u8);
    diag_buf_push_u32(mut_view(b), 987654u32);

    let sv = diag_buf_as_str_view(view(b));
    let p_needle = alloc_mem(mut_view(scratch), 14);
    unsafe {
        *p_needle = 65u8;
        *(p_needle + 1) = 66u8;
        *(p_needle + 2) = 32u8;
        *(p_needle + 3) = 48u8;
        *(p_needle + 4) = 32u8;
        *(p_needle + 5) = 52u8;
        *(p_needle + 6) = 50u8;
        *(p_needle + 7) = 32u8;
        *(p_needle + 8) = 57u8;
        *(p_needle + 9) = 56u8;
        *(p_needle + 10) = 55u8;
        *(p_needle + 11) = 54u8;
        *(p_needle + 12) = 53u8;
        *(p_needle + 13) = 52u8;
    }
    let needle = make_sv(p_needle, 14);
    let eq = qa_sv_eq(sv, needle);
    if !eq { return 103; }

    let mut b2 = diag_buf_new();
    diag_buf_push_code_name(mut_view(b2), diag_code(0u32));
    let sv2 = diag_buf_as_str_view(view(b2));
    if sv2.len != 19 { return 104; }

    let mut b3 = diag_buf_new();
    diag_buf_push_code_name(mut_view(b3), diag_code(200u32));
    let sv3 = diag_buf_as_str_view(view(b3));
    if sv3.len != 9 { return (1000 + sv3.len) as i32; }

    diag_buf_free(mut_view(b));
    diag_buf_free(mut_view(b2));
    diag_buf_free(mut_view(b3));
    arena_destroy(mut_view(scratch));
    0
}

// TEST 2: JSON String Escaping
fn test_json_escaping() -> i32 {
    let mut scratch = arena_new();
    let mut b = diag_buf_new();
    let p_raw = alloc_mem(mut_view(scratch), 6);
    unsafe {
        *p_raw = 34u8;
        *(p_raw + 1) = 92u8;
        *(p_raw + 2) = 9u8;
        *(p_raw + 3) = 10u8;
        *(p_raw + 4) = 13u8;
        *(p_raw + 5) = 1u8;
    }
    let sv = make_sv(p_raw, 6);
    write_json_string(mut_view(b), sv);

    let res = diag_buf_as_str_view(view(b));
    if res.len != 18 { return 201; }
    if unsafe { *(res.ptr) } != 34u8 { return 202; }
    if unsafe { *(res.ptr + 17) } != 34u8 { return 203; }

    diag_buf_free(mut_view(b));
    arena_destroy(mut_view(scratch));
    0
}

