// =============================================================================
// 10. Conditional Set, Branches, Calls, Stack & System Instructions
// =============================================================================

pub fn x64_setcc_r(sec: mut_view<Section>, cc: u8, dst: i32) {
    x64_emit_rex_rr(mut_view(*sec), 1u8, REG_NONE, dst);
    x64_emit8(mut_view(*sec), 0x0Fu8);
    x64_emit8(mut_view(*sec), 0x90u8 + (cc & 0xFu8));
    x64_emit8(mut_view(*sec), 0xC0u8 | x64_reg_low3(dst));
}

pub fn ax_x64_setcc_r(sec: mut_view<Section>, cc: u8, dst: i32) {
    x64_setcc_r(sec, cc, dst);
}

pub fn x64_setcc_m(sec: mut_view<Section>, cc: u8, dst: X64Mem) {
    x64_emit_rex_rm(mut_view(*sec), 1u8, REG_NONE, dst);
    x64_emit8(mut_view(*sec), 0x0Fu8);
    x64_emit8(mut_view(*sec), 0x90u8 + (cc & 0xFu8));
    x64_emit_modrm_sib_disp(mut_view(*sec), 0, dst);
}

pub fn ax_x64_setcc_m(sec: mut_view<Section>, cc: u8, dst: X64Mem) {
    x64_setcc_m(sec, cc, dst);
}

pub fn x64_jcc(sec: mut_view<Section>, cc: u8, rel32: i32) {
    x64_emit8(mut_view(*sec), 0x0Fu8);
    x64_emit8(mut_view(*sec), 0x80u8 + (cc & 0xFu8));
    x64_emit_i32(mut_view(*sec), rel32);
}

pub fn ax_x64_jcc(sec: mut_view<Section>, cc: u8, rel32: i32) {
    x64_jcc(sec, cc, rel32);
}

pub fn x64_jcc_sym(sec: mut_view<Section>, cc: u8, sym: SymbolId) {
    x64_emit8(mut_view(*sec), 0x0Fu8);
    x64_emit8(mut_view(*sec), 0x80u8 + (cc & 0xFu8));
    let reloc_off = sec.bytes_len as u32;
    section_add_reloc(mut_view(*sec), reloc_off, AX_RELOC_X86_64_PC32, sym, -4i64);
    x64_emit32(mut_view(*sec), 0u32);
}

pub fn ax_x64_jcc_sym(sec: mut_view<Section>, cc: u8, sym: SymbolId) {
    x64_jcc_sym(sec, cc, sym);
}

pub fn x64_jmp(sec: mut_view<Section>, rel32: i32) {
    x64_emit8(mut_view(*sec), 0xE9u8);
    x64_emit_i32(mut_view(*sec), rel32);
}

pub fn ax_x64_jmp(sec: mut_view<Section>, rel32: i32) {
    x64_jmp(sec, rel32);
}

pub fn x64_jmp_sym(sec: mut_view<Section>, sym: SymbolId) {
