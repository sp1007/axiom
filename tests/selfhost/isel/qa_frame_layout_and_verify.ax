// =============================================================================

pub const CC_O: u8 = 0x0u8;
pub const CC_NO: u8 = 0x1u8;
pub const CC_B: u8 = 0x2u8;
pub const CC_AE: u8 = 0x3u8;
pub const CC_E: u8 = 0x4u8;
pub const CC_NE: u8 = 0x5u8;
pub const CC_BE: u8 = 0x6u8;
pub const CC_A: u8 = 0x7u8;
pub const CC_S: u8 = 0x8u8;
pub const CC_NS: u8 = 0x9u8;
pub const CC_P: u8 = 0xAu8;
pub const CC_NP: u8 = 0xBu8;
pub const CC_L: u8 = 0xCu8;
pub const CC_GE: u8 = 0xDu8;
pub const CC_LE: u8 = 0xEu8;
pub const CC_G: u8 = 0xFu8;

// Standard mnemonic aliases
pub const CC_C: u8 = 0x2u8;
pub const CC_NAE: u8 = 0x2u8;
pub const CC_NC: u8 = 0x3u8;
pub const CC_NB: u8 = 0x3u8;
pub const CC_Z: u8 = 0x4u8;
pub const CC_NZ: u8 = 0x5u8;
pub const CC_NA: u8 = 0x6u8;
pub const CC_NBE: u8 = 0x7u8;
pub const CC_PE: u8 = 0xAu8;
pub const CC_PO: u8 = 0xBu8;
pub const CC_NGE: u8 = 0xCu8;
pub const CC_NL: u8 = 0xDu8;
pub const CC_NG: u8 = 0xEu8;
pub const CC_NLE: u8 = 0xFu8;

pub const AX_CC_O: u8 = 0x0u8;
pub const AX_CC_NO: u8 = 0x1u8;
pub const AX_CC_B: u8 = 0x2u8;
pub const AX_CC_AE: u8 = 0x3u8;
pub const AX_CC_E: u8 = 0x4u8;
pub const AX_CC_NE: u8 = 0x5u8;
pub const AX_CC_BE: u8 = 0x6u8;
pub const AX_CC_A: u8 = 0x7u8;
pub const AX_CC_S: u8 = 0x8u8;
pub const AX_CC_NS: u8 = 0x9u8;
pub const AX_CC_P: u8 = 0xAu8;
pub const AX_CC_NP: u8 = 0xBu8;
pub const AX_CC_L: u8 = 0xCu8;
pub const AX_CC_GE: u8 = 0xDu8;
pub const AX_CC_LE: u8 = 0xEu8;
pub const AX_CC_G: u8 = 0xFu8;

pub fn x64_cc_invert(cc: u8) -> u8 {
    (cc ^ 1u8) & 0xFu8
}

pub fn x64_cc_name(cc: u8) -> Str {
    let c = cc & 0xFu8;
    if c == CC_O { return "o"; }
    if c == CC_NO { return "no"; }
    if c == CC_B { return "b"; }
    if c == CC_AE { return "ae"; }
    if c == CC_E { return "e"; }
    if c == CC_NE { return "ne"; }
    if c == CC_BE { return "be"; }
    if c == CC_A { return "a"; }
    if c == CC_S { return "s"; }
    if c == CC_NS { return "ns"; }
    if c == CC_P { return "p"; }
    if c == CC_NP { return "np"; }
    if c == CC_L { return "l"; }
    if c == CC_GE { return "ge"; }
    if c == CC_LE { return "le"; }
    "g"
}

