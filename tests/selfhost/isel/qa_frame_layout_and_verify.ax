@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

// =============================================================================
// 1. x86-64 General-Purpose Registers (ax_x64_reg_t)
// =============================================================================

pub const REG_RAX: i32 = 0;
pub const REG_RCX: i32 = 1;
pub const REG_RDX: i32 = 2;
pub const REG_RBX: i32 = 3;
pub const REG_RSP: i32 = 4;
pub const REG_RBP: i32 = 5;
pub const REG_RSI: i32 = 6;
pub const REG_RDI: i32 = 7;
pub const REG_R8: i32 = 8;
pub const REG_R9: i32 = 9;
pub const REG_R10: i32 = 10;
pub const REG_R11: i32 = 11;
pub const REG_R12: i32 = 12;
pub const REG_R13: i32 = 13;
pub const REG_R14: i32 = 14;
pub const REG_R15: i32 = 15;
pub const REG_NONE: i32 = 255;

pub const AX_REG_RAX: i32 = 0;
pub const AX_REG_RCX: i32 = 1;
pub const AX_REG_RDX: i32 = 2;
pub const AX_REG_RBX: i32 = 3;
pub const AX_REG_RSP: i32 = 4;
pub const AX_REG_RBP: i32 = 5;
pub const AX_REG_RSI: i32 = 6;
pub const AX_REG_RDI: i32 = 7;
pub const AX_REG_R8: i32 = 8;
pub const AX_REG_R9: i32 = 9;
pub const AX_REG_R10: i32 = 10;
pub const AX_REG_R11: i32 = 11;
pub const AX_REG_R12: i32 = 12;
pub const AX_REG_R13: i32 = 13;
pub const AX_REG_R14: i32 = 14;
pub const AX_REG_R15: i32 = 15;
pub const AX_REG_NONE: i32 = 255;

pub fn x64_reg_is_none(reg: i32) -> bool {
    reg < 0 || reg > 15
}

pub fn x64_reg_is_valid(reg: i32) -> bool {
    reg >= 0 && reg <= 15
}

pub fn x64_reg_is_extended(reg: i32) -> bool {
    reg >= 8 && reg <= 15
}

pub fn x64_reg_needs_byte_rex(reg: i32) -> bool {
    reg >= 4 && reg <= 15
}

pub fn x64_reg_low3(reg: i32) -> u8 {
    if x64_reg_is_none(reg) {
        0u8
    } else {
        ((reg as u32) & 7u32) as u8
    }
}

pub fn x64_reg_name(reg: i32) -> Str {
    if reg == REG_RAX { return "rax"; }
    if reg == REG_RCX { return "rcx"; }
    if reg == REG_RDX { return "rdx"; }
    if reg == REG_RBX { return "rbx"; }
    if reg == REG_RSP { return "rsp"; }
    if reg == REG_RBP { return "rbp"; }
    if reg == REG_RSI { return "rsi"; }
    if reg == REG_RDI { return "rdi"; }
    if reg == REG_R8 { return "r8"; }
    if reg == REG_R9 { return "r9"; }
    if reg == REG_R10 { return "r10"; }
    if reg == REG_R11 { return "r11"; }
    if reg == REG_R12 { return "r12"; }
    if reg == REG_R13 { return "r13"; }
    if reg == REG_R14 { return "r14"; }
    if reg == REG_R15 { return "r15"; }
    "none"
}

pub fn x64_reg_name_sz(reg: i32, sz: u8) -> Str {
    if sz == 1u8 {
        if reg == REG_RAX { return "al"; }
        if reg == REG_RCX { return "cl"; }
        if reg == REG_RDX { return "dl"; }
        if reg == REG_RBX { return "bl"; }
        if reg == REG_RSP { return "spl"; }
        if reg == REG_RBP { return "bpl"; }
        if reg == REG_RSI { return "sil"; }
        if reg == REG_RDI { return "dil"; }
        if reg == REG_R8 { return "r8b"; }
        if reg == REG_R9 { return "r9b"; }
        if reg == REG_R10 { return "r10b"; }
        if reg == REG_R11 { return "r11b"; }
        if reg == REG_R12 { return "r12b"; }
        if reg == REG_R13 { return "r13b"; }
        if reg == REG_R14 { return "r14b"; }
        if reg == REG_R15 { return "r15b"; }
        return "none";
    }
    if sz == 2u8 {
        if reg == REG_RAX { return "ax"; }
        if reg == REG_RCX { return "cx"; }
        if reg == REG_RDX { return "dx"; }
        if reg == REG_RBX { return "bx"; }
        if reg == REG_RSP { return "sp"; }
        if reg == REG_RBP { return "bp"; }
        if reg == REG_RSI { return "si"; }
        if reg == REG_RDI { return "di"; }
        if reg == REG_R8 { return "r8w"; }
        if reg == REG_R9 { return "r9w"; }
        if reg == REG_R10 { return "r10w"; }
        if reg == REG_R11 { return "r11w"; }
        if reg == REG_R12 { return "r12w"; }
        if reg == REG_R13 { return "r13w"; }
        if reg == REG_R14 { return "r14w"; }
        if reg == REG_R15 { return "r15w"; }
        return "none";
    }
    if sz == 4u8 {
        if reg == REG_RAX { return "eax"; }
        if reg == REG_RCX { return "ecx"; }
        if reg == REG_RDX { return "edx"; }
        if reg == REG_RBX { return "ebx"; }
        if reg == REG_RSP { return "esp"; }
        if reg == REG_RBP { return "ebp"; }
        if reg == REG_RSI { return "esi"; }
        if reg == REG_RDI { return "edi"; }
        if reg == REG_R8 { return "r8d"; }
        if reg == REG_R9 { return "r9d"; }
        if reg == REG_R10 { return "r10d"; }
        if reg == REG_R11 { return "r11d"; }
        if reg == REG_R12 { return "r12d"; }
        if reg == REG_R13 { return "r13d"; }
        if reg == REG_R14 { return "r14d"; }
        if reg == REG_R15 { return "r15d"; }
        return "none";
    }
    x64_reg_name(reg)
}

