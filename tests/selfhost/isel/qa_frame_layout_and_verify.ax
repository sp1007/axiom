    // 356..364: "switch v"
    115u8, 119u8, 105u8, 116u8, 99u8, 104u8, 32u8, 118u8,
    // 364..367: " [\n"
    32u8, 91u8, 10u8,
    // 367..371: ": bb"
    58u8, 32u8, 98u8, 98u8,
    // 371..373: ",\n"
    44u8, 10u8,
    // 373..386: "otherwise: bb"
    111u8, 116u8, 104u8, 101u8, 114u8, 119u8, 105u8, 115u8, 101u8, 58u8, 32u8, 98u8, 98u8,
    // 386..398: "\n        ];\n"
    10u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 93u8, 59u8, 10u8,
    // 398..406: "return;\n"
    114u8, 101u8, 116u8, 117u8, 114u8, 110u8, 59u8, 10u8,
    // 406..419: "unreachable;\n"
    117u8, 110u8, 114u8, 101u8, 97u8, 99u8, 104u8, 97u8, 98u8, 108u8, 101u8, 59u8, 10u8,
    // 419..427: "assert v"
    97u8, 115u8, 115u8, 101u8, 114u8, 116u8, 32u8, 118u8,
