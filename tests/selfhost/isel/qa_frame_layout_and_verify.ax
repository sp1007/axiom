fn types_zero_bytes(ptr: *mut u8, n: usize) {
    let mut i: usize = 0;
    while (i < n) {
        unsafe {
            *(ptr + i) = 0u8;
        }
        i = i + 1;
    }
}

fn hash_u64(v: u64) -> u64 {
    let mut h: u64 = v ^ (v >> 16u64);
    h = h ^ (h << 7u64);
    h ^ (h >> 11u64)
}

fn hash_u32(v: u32) -> u64 {
    hash_u64((v as u64) ^ 0x9e3779b9u64)
}

fn hash_combine(a: u64, b: u64) -> u64 {
    let h: u64 = a ^ b ^ 0x9e3779b9u64 ^ (a << 6u64) ^ (a >> 2u64);
    h ^ (h >> 13u64)
}

pub fn mul_usize(a: usize, b: usize) -> usize {
    ((a as isize) * (b as isize)) as usize
}

pub unsafe fn typeid_at(base: *mut TypeId, idx: usize) -> *mut TypeId {
    let off = ((idx as isize) * (size_of<TypeId>() as isize)) as usize;
    ((base as usize) + off) as *mut TypeId
}

pub unsafe fn typeid_ptr_at(base: *mut *mut TypeId, idx: usize) -> *mut *mut TypeId {
    let off = ((idx as isize) * (size_of<*mut TypeId>() as isize)) as usize;
    ((base as usize) + off) as *mut *mut TypeId
}

pub unsafe fn usize_at(base: *mut usize, idx: usize) -> *mut usize {
    let off = ((idx as isize) * (size_of<usize>() as isize)) as usize;
    ((base as usize) + off) as *mut usize
}

pub unsafe fn u32_at(base: *mut u32, idx: usize) -> *mut u32 {
    let off = ((idx as isize) * (size_of<u32>() as isize)) as usize;
    ((base as usize) + off) as *mut u32
}

pub unsafe fn capture_at(base: *mut ClosureCapture, idx: usize) -> *mut ClosureCapture {
    let off = ((idx as isize) * (size_of<ClosureCapture>() as isize)) as usize;
    ((base as usize) + off) as *mut ClosureCapture
}

unsafe fn axtype_ptr_at(base: *mut *mut AxType, idx: usize) -> *mut *mut AxType {
    let off = ((idx as isize) * (size_of<*mut AxType>() as isize)) as usize;
    ((base as usize) + off) as *mut *mut AxType
}

unsafe fn item_ptr_at(base: *mut *const HirItem, idx: usize) -> *mut *const HirItem {
    let off = ((idx as isize) * (size_of<*const HirItem>() as isize)) as usize;
    ((base as usize) + off) as *mut *const HirItem
}

unsafe fn constval_at(base: *mut ConstValue, idx: usize) -> *mut ConstValue {
    let off = ((idx as isize) * (size_of<ConstValue>() as isize)) as usize;
    ((base as usize) + off) as *mut ConstValue
}

unsafe fn subst_at(base: *mut GenericArgsSlice, idx: usize) -> *mut GenericArgsSlice {
    let off = ((idx as isize) * (size_of<GenericArgsSlice>() as isize)) as usize;
    ((base as usize) + off) as *mut GenericArgsSlice
}

unsafe fn tryinfo_at(base: *mut TryExprInfo, idx: usize) -> *mut TryExprInfo {
    let off = ((idx as isize) * (size_of<TryExprInfo>() as isize)) as usize;
    ((base as usize) + off) as *mut TryExprInfo
}

pub fn ax_type_reset(t: mut_view<AxType>, kind: u8) {
    t.kind = kind;
    t.is_unsafe = false;
    t.is_mut = false;
    t.is_repr_c = false;
    t.abi.v = 0u32;
    t.name.v = 0u32;
    t.param_index = 0u32;
    t.var_id = 0u32;
    t.closure_id = 0u32;
    t.fn_sym = 0u32;
    t.pointee.v = 0u32;
    t.elem.v = 0u32;
    t.ret_type.v = 0u32;
    t.fn_type.v = 0u32;
    t.array_len = 0u64;
    t.param_types = 0 as *mut TypeId;
    t.param_count = 0;
    t.fields = 0 as *mut TypeId;
    t.field_count = 0;
    t.def = 0 as *const HirItem;
    t.args = 0 as *mut TypeId;
    t.arg_count = 0;
    t.variant_fields = 0 as *mut *mut TypeId;
    t.variant_field_counts = 0 as *mut usize;
    t.variant_count = 0;
    t.captures = 0 as *mut ClosureCapture;
    t.capture_count = 0;
}

pub fn copy_ax_type_into(dst: mut_view<AxType>, src: view<AxType>) {
    dst.kind = src.kind;
    dst.is_unsafe = src.is_unsafe;
    dst.is_mut = src.is_mut;
    dst.is_repr_c = src.is_repr_c;
    dst.abi.v = src.abi.v;
    dst.name.v = src.name.v;
    dst.param_index = src.param_index;
    dst.var_id = src.var_id;
    dst.closure_id = src.closure_id;
    dst.fn_sym = src.fn_sym;
    dst.pointee.v = src.pointee.v;
    dst.elem.v = src.elem.v;
    dst.ret_type.v = src.ret_type.v;
    dst.fn_type.v = src.fn_type.v;
    dst.array_len = src.array_len;
    dst.param_types = src.param_types;
    dst.param_count = src.param_count;
    dst.fields = src.fields;
    dst.field_count = src.field_count;
    dst.def = src.def;
    dst.args = src.args;
    dst.arg_count = src.arg_count;
    dst.variant_fields = src.variant_fields;
    dst.variant_field_counts = src.variant_field_counts;
    dst.variant_count = src.variant_count;
    dst.captures = src.captures;
    dst.capture_count = src.capture_count;
}

pub fn copy_const_value_into(dst: mut_view<ConstValue>, src: view<ConstValue>) {
    dst.kind = src.kind;
    dst.ty.v = src.ty.v;
    dst.int_val = src.int_val;
    dst.str_bytes = src.str_bytes;
    dst.str_len = src.str_len;
    dst.agg_data = src.agg_data;
    dst.agg_size = src.agg_size;
    dst.agg_align = src.agg_align;
    dst.alloc_id = src.alloc_id;
}

pub fn key_hash_type(k: view<AxType>) -> u64 {
    let mut h: u64 = hash_u32(k.kind as u32);
    if k.kind == TY_FN {
        let u_flag: u32 = if k.is_unsafe { 1u32 } else { 0u32 };
        h = hash_combine(h, hash_u32(u_flag));
        h = hash_combine(h, hash_u32(k.abi.v));
        h = hash_combine(h, hash_u32(k.ret_type.v));
        h = hash_combine(h, hash_u64(k.param_count as u64));
        let mut i: usize = 0;
        while (i < k.param_count) {
            let pv = unsafe { (*typeid_at(k.param_types, i)).v };
            h = hash_combine(h, hash_u32(pv));
            i = i + 1;
        }
    } else if k.kind == TY_INT_VAR || k.kind == TY_VAR {
        h = hash_combine(h, hash_u32(k.var_id));
    } else if k.kind == TY_PARAM {
        h = hash_combine(h, hash_u32(k.param_index));
    } else if k.kind == TY_PTR {
        let m_flag: u32 = if k.is_mut { 1u32 } else { 0u32 };
        h = hash_combine(h, hash_u32(k.pointee.v));
        h = hash_combine(h, hash_u32(m_flag));
    } else if k.kind == TY_VIEW || k.kind == TY_MUT_VIEW {
        h = hash_combine(h, hash_u32(k.pointee.v));
    } else if k.kind == TY_SLICE {
        h = hash_combine(h, hash_u32(k.elem.v));
    } else if k.kind == TY_ARRAY {
        h = hash_combine(h, hash_u32(k.elem.v));
        h = hash_combine(h, hash_u64(k.array_len));
    } else if k.kind == TY_TUPLE {
        h = hash_combine(h, hash_u64(k.field_count as u64));
        let mut i: usize = 0;
        while (i < k.field_count) {
            let fv = unsafe { (*typeid_at(k.fields, i)).v };
            h = hash_combine(h, hash_u32(fv));
            i = i + 1;
        }
    } else if k.kind == TY_STRUCT || k.kind == TY_ENUM {
        h = hash_combine(h, hash_u64((k.def as usize) as u64));
        let mut i: usize = 0;
        while (i < k.arg_count) {
            let av = unsafe { (*typeid_at(k.args, i)).v };
            h = hash_combine(h, hash_u32(av));
            i = i + 1;
        }
    } else if k.kind == TY_CLOSURE {
        h = hash_combine(h, hash_u32(k.closure_id));
    }
    h
}

pub fn key_eq_type(a: view<AxType>, b: view<AxType>) -> bool {
    if a.kind != b.kind {
        return false;
    }
    if a.kind == TY_FN {
        if a.is_unsafe != b.is_unsafe || a.abi.v != b.abi.v {
            return false;
        }
        if a.ret_type.v != b.ret_type.v || a.param_count != b.param_count {
            return false;
        }
        let mut i: usize = 0;
        while (i < a.param_count) {
            let pa = unsafe { (*typeid_at(a.param_types, i)).v };
            let pb = unsafe { (*typeid_at(b.param_types, i)).v };
            if pa != pb {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    if a.kind == TY_INT_VAR || a.kind == TY_VAR {
        return a.var_id == b.var_id;
    }
    if a.kind == TY_PARAM {
        return a.param_index == b.param_index;
    }
    if a.kind == TY_PTR {
        return a.pointee.v == b.pointee.v && a.is_mut == b.is_mut;
    }
    if a.kind == TY_VIEW || a.kind == TY_MUT_VIEW {
        return a.pointee.v == b.pointee.v;
    }
    if a.kind == TY_SLICE {
        return a.elem.v == b.elem.v;
    }
    if a.kind == TY_ARRAY {
        return a.elem.v == b.elem.v && a.array_len == b.array_len;
    }
    if a.kind == TY_TUPLE {
        if a.field_count != b.field_count {
            return false;
        }
        let mut i: usize = 0;
        while (i < a.field_count) {
            let fa = unsafe { (*typeid_at(a.fields, i)).v };
            let fb = unsafe { (*typeid_at(b.fields, i)).v };
            if fa != fb {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    if a.kind == TY_STRUCT || a.kind == TY_ENUM {
        if (a.def as usize) != (b.def as usize) {
            return false;
        }
        if a.arg_count != b.arg_count {
            return false;
        }
        let mut i: usize = 0;
        while (i < a.arg_count) {
            let aa = unsafe { (*typeid_at(a.args, i)).v };
            let ab = unsafe { (*typeid_at(b.args, i)).v };
            if aa != ab {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    if a.kind == TY_CLOSURE {
        return a.closure_id == b.closure_id;
    }
    true
}

pub fn typemap_init(m: mut_view<TypeMap>) {
    m.keys = 0 as *mut *mut AxType;
    m.vals = 0 as *mut TypeId;
    m.states = 0 as *mut u8;
    m.len = 0;
    m.cap = 0;
}

pub fn typemap_free(m: mut_view<TypeMap>) {
    if m.cap > 0 {
        unsafe {
            heap_free(m.keys as *mut u8, mul_usize(m.cap, size_of<*mut AxType>()), align_of<*mut AxType>());
            heap_free(m.vals as *mut u8, mul_usize(m.cap, size_of<TypeId>()), align_of<TypeId>());
            heap_free(m.states, m.cap, 1);
        }
    }
    typemap_init(m);
}

fn typemap_grow(m: mut_view<TypeMap>) {
    let new_cap: usize = if m.cap == 0 { MAP_INIT_CAP } else { mul_usize(m.cap, 2) };
    let new_keys = unsafe {
        heap_alloc(mul_usize(new_cap, size_of<*mut AxType>()), align_of<*mut AxType>()) as *mut *mut AxType
    };
    let new_vals = unsafe {
        heap_alloc(mul_usize(new_cap, size_of<TypeId>()), align_of<TypeId>()) as *mut TypeId
    };
    let new_states = unsafe { heap_alloc(new_cap, 1) };
    types_zero_bytes(new_states, new_cap);

    let old_keys = m.keys;
    let old_vals = m.vals;
    let old_states = m.states;
    let old_cap = m.cap;

    m.keys = new_keys;
    m.vals = new_vals;
    m.states = new_states;
    m.len = 0;
    m.cap = new_cap;

    let mut i: usize = 0;
    while (i < old_cap) {
        let st = unsafe { *(old_states + i) };
        if st == SLOT_OCCUPIED {
            let k = unsafe { *axtype_ptr_at(old_keys, i) };
            let v = unsafe { (*typeid_at(old_vals, i)).v };
            typemap_insert(mut_view(*m), k, TypeId { v: v });
        }
        i = i + 1;
    }

    if old_cap > 0 {
        unsafe {
            heap_free(old_keys as *mut u8, mul_usize(old_cap, size_of<*mut AxType>()), align_of<*mut AxType>());
            heap_free(old_vals as *mut u8, mul_usize(old_cap, size_of<TypeId>()), align_of<TypeId>());
            heap_free(old_states, old_cap, 1);
        }
    }
}

pub fn typemap_insert(m: mut_view<TypeMap>, key: *mut AxType, val: TypeId) {
    if m.cap == 0 || mul_usize(m.len + 1, MAP_LOAD_DEN) >= mul_usize(m.cap, MAP_LOAD_NUM) {
        typemap_grow(mut_view(*m));
    }
    let mask = m.cap - 1;
    let h = unsafe { key_hash_type(view(*key)) };
    let mut idx = (h as usize) & mask;
    loop {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            unsafe {
                *axtype_ptr_at(m.keys, idx) = key;
                (*typeid_at(m.vals, idx)).v = val.v;
                *(m.states + idx) = SLOT_OCCUPIED;
            }
            m.len = m.len + 1;
            return;
        }
        let k = unsafe { *axtype_ptr_at(m.keys, idx) };
        let eq = unsafe { key_eq_type(view(*k), view(*key)) };
        if eq {
            unsafe {
                (*typeid_at(m.vals, idx)).v = val.v;
            }
            return;
        }
        idx = (idx + 1) & mask;
    }
}

pub fn typemap_get(m: view<TypeMap>, key: view<AxType>) -> *mut TypeId {
    if m.cap == 0 {
        return 0 as *mut TypeId;
    }
    let mask = m.cap - 1;
    let h = key_hash_type(key);
    let mut idx = (h as usize) & mask;
    let mut probes: usize = 0;
    while (probes < m.cap) {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            return 0 as *mut TypeId;
        }
        if st == SLOT_OCCUPIED {
            let k = unsafe { *axtype_ptr_at(m.keys, idx) };
            let eq = unsafe { key_eq_type(view(*k), key) };
            if eq {
                return unsafe { typeid_at(m.vals, idx) };
            }
        }
        idx = (idx + 1) & mask;
        probes = probes + 1;
    }
    0 as *mut TypeId
}

fn interner_push_ptr(ti: mut_view<TypeInterner>, ptr: *mut AxType) -> usize {
    if ti.len == ti.cap {
        let new_cap: usize = if ti.cap == 0 { INTERNER_INIT_CAP } else { mul_usize(ti.cap, 2) };
        let new_arr = unsafe {
            heap_alloc(mul_usize(new_cap, size_of<*mut AxType>()), align_of<*mut AxType>()) as *mut *mut AxType
        };
        if ti.len > 0 && (ti.types as usize) != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(
                    ti.types as *const u8,
                    new_arr as *mut u8,
                    mul_usize(ti.len, size_of<*mut AxType>())
                );
                heap_free(
                    ti.types as *mut u8,
                    mul_usize(ti.cap, size_of<*mut AxType>()),
                    align_of<*mut AxType>()
                );
            }
        }
        ti.types = new_arr;
        ti.cap = new_cap;
    }
    let idx = ti.len;
    unsafe {
        *axtype_ptr_at(ti.types, idx) = ptr;
    }
    ti.len = idx + 1;
    idx
}

fn arena_dup_typeids(arena: mut_view<Arena>, src: *mut TypeId, count: usize) -> *mut TypeId {
    if count == 0 || (src as usize) == 0 {
        return 0 as *mut TypeId;
    }
    let bytes = mul_usize(count, size_of<TypeId>());
    let dst = arena_alloc_raw(mut_view(*arena), bytes, align_of<TypeId>()) as *mut TypeId;
    unsafe {
        ptr_copy_nonoverlapping<u8>(src as *const u8, dst as *mut u8, bytes);
    }
    dst
}

pub fn intern_type(ti: mut_view<TypeInterner>, ty: view<AxType>) -> TypeId {
    let existing = typemap_get(view(ti.map), ty);
    if (existing as usize) != 0 {
        let ex_v = unsafe { (*existing).v };
        return TypeId { v: ex_v };
    }
    let new_type = unsafe {
        arena_alloc_raw(mut_view(ti.arena), size_of<AxType>(), align_of<AxType>()) as *mut AxType
    };
    unsafe {
        copy_ax_type_into(mut_view(*new_type), ty);
    }
    if ty.kind == TY_FN && ty.param_count > 0 {
        unsafe {
            let dup_param_types = arena_dup_typeids(mut_view(ti.arena), ty.param_types, ty.param_count);

            (*new_type).param_types = dup_param_types;
        }
    }
    if ty.kind == TY_TUPLE && ty.field_count > 0 {
        unsafe {
            let dup_fields = arena_dup_typeids(mut_view(ti.arena), ty.fields, ty.field_count);

            (*new_type).fields = dup_fields;
        }
    }
    if ty.kind == TY_STRUCT {
        if ty.field_count > 0 {
            unsafe {
                let dup_fields = arena_dup_typeids(mut_view(ti.arena), ty.fields, ty.field_count);

                (*new_type).fields = dup_fields;
            }
        }
        if ty.arg_count > 0 {
            unsafe {
                let dup_args = arena_dup_typeids(mut_view(ti.arena), ty.args, ty.arg_count);

                (*new_type).args = dup_args;
            }
        }
    }
    if ty.kind == TY_ENUM {
        if ty.arg_count > 0 {
            unsafe {
                let dup_args = arena_dup_typeids(mut_view(ti.arena), ty.args, ty.arg_count);

                (*new_type).args = dup_args;
            }
        }
        if (ty.variant_field_counts as usize) != 0 && ty.variant_count > 0 {
            let counts_bytes = mul_usize(ty.variant_count, size_of<usize>());
            let new_counts = unsafe {
                arena_alloc_raw(mut_view(ti.arena), counts_bytes, align_of<usize>()) as *mut usize
            };
            unsafe {
                ptr_copy_nonoverlapping<u8>(
                    ty.variant_field_counts as *const u8,
                    new_counts as *mut u8,
                    counts_bytes
                );
                (*new_type).variant_field_counts = new_counts;
            }
        }
        if (ty.variant_fields as usize) != 0 && ty.variant_count > 0 {
            let vbytes = mul_usize(ty.variant_count, size_of<*mut TypeId>());
            let new_vfields = unsafe {
                arena_alloc_raw(mut_view(ti.arena), vbytes, align_of<*mut TypeId>()) as *mut *mut TypeId
            };
            let mut v: usize = 0;
            while (v < ty.variant_count) {
                let fc = unsafe { *usize_at(ty.variant_field_counts, v) };
                if fc > 0 {
                    let src_vf = unsafe { *typeid_ptr_at(ty.variant_fields, v) };
                    let dst_vf = arena_dup_typeids(mut_view(ti.arena), src_vf, fc);
                    unsafe {
                        *typeid_ptr_at(new_vfields, v) = dst_vf;
                    }
                } else {
                    unsafe {
                        *typeid_ptr_at(new_vfields, v) = 0 as *mut TypeId;
                    }
                }
                v = v + 1;
            }
            unsafe {
                (*new_type).variant_fields = new_vfields;
            }
        }
    }
    if ty.kind == TY_CLOSURE {
        if ty.param_count > 0 {
            unsafe {
                let dup_param_types = arena_dup_typeids(mut_view(ti.arena), ty.param_types, ty.param_count);

                (*new_type).param_types = dup_param_types;
            }
        }
        if ty.capture_count > 0 && (ty.captures as usize) != 0 {
            let cbytes = mul_usize(ty.capture_count, size_of<ClosureCapture>());
            let new_caps = unsafe {
                arena_alloc_raw(
                    mut_view(ti.arena),
                    cbytes,
                    align_of<ClosureCapture>()
                ) as *mut ClosureCapture
            };
            unsafe {
                ptr_copy_nonoverlapping<u8>(ty.captures as *const u8, new_caps as *mut u8, cbytes);
                (*new_type).captures = new_caps;
            }
        }
    }
    let idx = interner_push_ptr(mut_view(*ti), new_type);
    let id_v = (idx + 1) as u32;
    typemap_insert(mut_view(ti.map), new_type, TypeId { v: id_v });
    TypeId { v: id_v }
}

pub fn intern_singleton(ti: mut_view<TypeInterner>, kind: u8) -> TypeId {
    let sp = ti.scratch;
    unsafe {
        ax_type_reset(mut_view(*sp), kind);
    }
    intern_type(mut_view(*ti), unsafe { view(*sp) })
}

pub fn intern_ptr_ty(ti: mut_view<TypeInterner>, pointee: TypeId, is_mut: bool) -> TypeId {
    let sp = ti.scratch;
    unsafe {
        ax_type_reset(mut_view(*sp), TY_PTR);
        (*sp).pointee.v = pointee.v;
        (*sp).is_mut = is_mut;
    }
    intern_type(mut_view(*ti), unsafe { view(*sp) })
}

pub fn intern_view_ty(ti: mut_view<TypeInterner>, pointee: TypeId, is_mut: bool) -> TypeId {
    let k: u8 = if is_mut { TY_MUT_VIEW } else { TY_VIEW };
    let sp = ti.scratch;
    unsafe {
        ax_type_reset(mut_view(*sp), k);
        (*sp).pointee.v = pointee.v;
    }
    intern_type(mut_view(*ti), unsafe { view(*sp) })
}

pub fn intern_slice_ty(ti: mut_view<TypeInterner>, elem: TypeId) -> TypeId {
    let sp = ti.scratch;
    unsafe {
        ax_type_reset(mut_view(*sp), TY_SLICE);
        (*sp).elem.v = elem.v;
    }
    intern_type(mut_view(*ti), unsafe { view(*sp) })
}

pub fn intern_array_ty(ti: mut_view<TypeInterner>, elem: TypeId, arr_len: u64) -> TypeId {
    let sp = ti.scratch;
    unsafe {
        ax_type_reset(mut_view(*sp), TY_ARRAY);
        (*sp).elem.v = elem.v;
        (*sp).array_len = arr_len;
    }
    intern_type(mut_view(*ti), unsafe { view(*sp) })
}

pub fn intern_tuple_ty(ti: mut_view<TypeInterner>, fields: *mut TypeId, count: usize) -> TypeId {
    let sp = ti.scratch;
    unsafe {
        ax_type_reset(mut_view(*sp), TY_TUPLE);
        (*sp).fields = fields;
        (*sp).field_count = count;
    }
    intern_type(mut_view(*ti), unsafe { view(*sp) })
}

pub fn intern_fn_ty(
    ti: mut_view<TypeInterner>,
    is_unsafe: bool,
    abi: StrId,
    param_types: *mut TypeId,
    param_count: usize,
    ret_type: TypeId
) -> TypeId {
    let sp = ti.scratch;
    unsafe {
        ax_type_reset(mut_view(*sp), TY_FN);
        (*sp).is_unsafe = is_unsafe;
        (*sp).abi.v = abi.v;
        (*sp).param_types = param_types;
        (*sp).param_count = param_count;
        (*sp).ret_type.v = ret_type.v;
    }
    intern_type(mut_view(*ti), unsafe { view(*sp) })
}

pub fn intern_param_ty(ti: mut_view<TypeInterner>, name: StrId, index: u32) -> TypeId {
    let sp = ti.scratch;
    unsafe {
        ax_type_reset(mut_view(*sp), TY_PARAM);
        (*sp).name.v = name.v;
        (*sp).param_index = index;
    }
    intern_type(mut_view(*ti), unsafe { view(*sp) })
}

pub fn intern_var_ty(ti: mut_view<TypeInterner>, kind: u8, var_id: u32) -> TypeId {
    let sp = ti.scratch;
    unsafe {
        ax_type_reset(mut_view(*sp), kind);
        (*sp).var_id = var_id;
    }
    intern_type(mut_view(*ti), unsafe { view(*sp) })
}

pub fn type_interner_init(ti: mut_view<TypeInterner>) {
    ti.arena.head = 0 as *mut ArenaChunk;
    typemap_init(mut_view(ti.map));
    ti.types = 0 as *mut *mut AxType;
    ti.len = 0;
    ti.cap = 0;
    ti.next_int_var = 1u32;
    let scratch_ptr = arena_alloc_raw(mut_view(ti.arena), size_of<AxType>(), align_of<AxType>()) as *mut AxType;

    ti.scratch = scratch_ptr;

    let id_t_error = intern_singleton(mut_view(*ti), TY_ERROR);


    ti.t_error.v = id_t_error.v;
    let id_t_unit = intern_singleton(mut_view(*ti), TY_UNIT);

    ti.t_unit.v = id_t_unit.v;
    let id_t_never = intern_singleton(mut_view(*ti), TY_NEVER);

    ti.t_never.v = id_t_never.v;
    let id_t_bool = intern_singleton(mut_view(*ti), TY_BOOL);

    ti.t_bool.v = id_t_bool.v;
    let id_t_char = intern_singleton(mut_view(*ti), TY_CHAR);

    ti.t_char.v = id_t_char.v;
    let id_t_i8 = intern_singleton(mut_view(*ti), TY_I8);

    ti.t_i8.v = id_t_i8.v;
    let id_t_i16 = intern_singleton(mut_view(*ti), TY_I16);

    ti.t_i16.v = id_t_i16.v;
    let id_t_i32 = intern_singleton(mut_view(*ti), TY_I32);

    ti.t_i32.v = id_t_i32.v;
    let id_t_i64 = intern_singleton(mut_view(*ti), TY_I64);

    ti.t_i64.v = id_t_i64.v;
    let id_t_isize = intern_singleton(mut_view(*ti), TY_ISIZE);

    ti.t_isize.v = id_t_isize.v;
    let id_t_u8 = intern_singleton(mut_view(*ti), TY_U8);

    ti.t_u8.v = id_t_u8.v;
    let id_t_u16 = intern_singleton(mut_view(*ti), TY_U16);

    ti.t_u16.v = id_t_u16.v;
    let id_t_u32 = intern_singleton(mut_view(*ti), TY_U32);

    ti.t_u32.v = id_t_u32.v;
    let id_t_u64 = intern_singleton(mut_view(*ti), TY_U64);

    ti.t_u64.v = id_t_u64.v;
    let id_t_usize = intern_singleton(mut_view(*ti), TY_USIZE);

    ti.t_usize.v = id_t_usize.v;
    let id_t_str = intern_singleton(mut_view(*ti), TY_STR);

    ti.t_str.v = id_t_str.v;
}

pub fn type_interner_free(ti: mut_view<TypeInterner>) {
    if ti.cap > 0 && (ti.types as usize) != 0 {
        unsafe {
            heap_free(
                ti.types as *mut u8,
                mul_usize(ti.cap, size_of<*mut AxType>()),
                align_of<*mut AxType>()
            );
        }
    }
    ti.types = 0 as *mut *mut AxType;
    ti.len = 0;
    ti.cap = 0;
    typemap_free(mut_view(ti.map));
    arena_destroy(mut_view(ti.arena));
}

pub fn type_get(ti: view<TypeInterner>, id: TypeId) -> *mut AxType {
    if id.v == 0 {
        return unsafe { *axtype_ptr_at(ti.types, 0) };
    }
    let idx = (id.v - 1) as usize;
    if idx >= ti.len {
        return unsafe { *axtype_ptr_at(ti.types, 0) };
    }
    unsafe { *axtype_ptr_at(ti.types, idx) }
}

pub fn type_is_int(id: TypeId, ti: view<TypeInterner>) -> bool {
    let t = type_get(ti, id);
    let k = unsafe { (*t).kind };
    k >= TY_I8 && k <= TY_USIZE
}

pub fn type_is_signed(id: TypeId, ti: view<TypeInterner>) -> bool {
    let t = type_get(ti, id);
    let k = unsafe { (*t).kind };
    k >= TY_I8 && k <= TY_ISIZE
}

pub fn type_is_unsigned(id: TypeId, ti: view<TypeInterner>) -> bool {
    let t = type_get(ti, id);
    let k = unsafe { (*t).kind };
    k >= TY_U8 && k <= TY_USIZE
}

// Target memory layout calculation: size, alignment, and field offsets.
// Port of bootstrap/axiom0/src/types/layout/layout.h and layout.c.
module compiler.types.layout

use std.core.host.heap_alloc
use std.core.host.heap_free
use compiler.kernel.id.TypeId
use compiler.types.types.TY_BOOL
use compiler.types.types.TY_CHAR
use compiler.types.types.TY_I8
use compiler.types.types.TY_I16
use compiler.types.types.TY_I32
use compiler.types.types.TY_I64
use compiler.types.types.TY_ISIZE
use compiler.types.types.TY_U8
use compiler.types.types.TY_U16
use compiler.types.types.TY_U32
use compiler.types.types.TY_U64
use compiler.types.types.TY_USIZE
use compiler.types.types.TY_FN
use compiler.types.types.TY_STR
use compiler.types.types.TY_SLICE
use compiler.types.types.TY_INT_VAR
use compiler.types.types.TY_PTR
use compiler.types.types.TY_ARRAY
use compiler.types.types.TY_TUPLE
use compiler.types.types.TY_STRUCT
use compiler.types.types.TY_ENUM
use compiler.types.types.TY_VIEW
use compiler.types.types.TY_MUT_VIEW
use compiler.types.types.TY_PARAM
use compiler.types.types.TY_CLOSURE
use compiler.types.types.AxType
use compiler.types.types.TypeInterner
use compiler.types.types.type_get
use compiler.types.types.mul_usize
use compiler.types.types.typeid_at
use compiler.types.types.typeid_ptr_at
use compiler.types.types.usize_at
use compiler.types.types.capture_at

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }

const ALIGN_1: u32 = 1u32;
const ALIGN_2: u32 = 2u32;
const ALIGN_4: u32 = 4u32;
const ALIGN_8: u32 = 8u32;
const SIZE_0: u32 = 0u32;
const SIZE_1: u32 = 1u32;
const SIZE_2: u32 = 2u32;
const SIZE_4: u32 = 4u32;
const SIZE_8: u32 = 8u32;
const SIZE_16: u32 = 16u32;

pub struct Layout {
    pub size: u32,
    pub align: u32,
}

struct FieldLayout {
    pub index: u32,
    pub size: u32,
    pub align: u32,
}

unsafe fn field_layout_at(base: *mut FieldLayout, idx: usize) -> *mut FieldLayout {
    let off = ((idx as isize) * (size_of<FieldLayout>() as isize)) as usize;
    ((base as usize) + off) as *mut FieldLayout
}

fn align_up_u32(offset: u32, align: u32) -> u32 {
    if (align <= 1u32) {
        return offset;
    }
    let mask = align - 1u32;
    (offset + mask) & (0xFFFFFFFFu32 ^ mask)
}

fn field_comes_before(a: view<FieldLayout>, b: view<FieldLayout>) -> bool {
    if a.align != b.align {
        return a.align > b.align;
    }
    if a.size != b.size {
        return a.size > b.size;
    }
    let ai = a.index;
    let bi = b.index;
    ai < bi
}

fn sort_fields(fl: *mut FieldLayout, count: usize) {
    let mut i: usize = 1;
    while (i < count) {
        let cur_p = unsafe { field_layout_at(fl, i) };
        let cur_index = unsafe { (*cur_p).index };
        let cur_size = unsafe { (*cur_p).size };
        let cur_align = unsafe { (*cur_p).align };
        let cur = FieldLayout {
            index: cur_index,
            size: cur_size,
            align: cur_align,
        };
        let mut j: usize = i;
        while (j > 0) {
            let prev_p = unsafe { field_layout_at(fl, j - 1) };
            let move_right = unsafe { field_comes_before(view(cur), view(*prev_p)) };
            if !move_right {
                break;
            }
            let dst_p = unsafe { field_layout_at(fl, j) };
            unsafe {
                (*dst_p).index = (*prev_p).index;
                (*dst_p).size = (*prev_p).size;
                (*dst_p).align = (*prev_p).align;
            }
            j = j - 1;
        }
        let target_p = unsafe { field_layout_at(fl, j) };
        unsafe {
            (*target_p).index = cur.index;
            (*target_p).size = cur.size;
            (*target_p).align = cur.align;
        }
        i = i + 1;
    }
}

pub fn type_align(id: TypeId, ti: view<TypeInterner>) -> u32 {
    if id.v == 0u32 {
        return ALIGN_1;
    }
    if id.v == ti.t_unit.v || id.v == ti.t_never.v {
        return ALIGN_1;
    }
    if id.v == ti.t_bool.v || id.v == ti.t_i8.v || id.v == ti.t_u8.v {
        return ALIGN_1;
    }
    if id.v == ti.t_i16.v || id.v == ti.t_u16.v {
        return ALIGN_2;
    }
    if id.v == ti.t_i32.v || id.v == ti.t_u32.v || id.v == ti.t_char.v {
        return ALIGN_4;
    }
    if id.v == ti.t_i64.v || id.v == ti.t_u64.v || id.v == ti.t_isize.v ||
        id.v == ti.t_usize.v || id.v == ti.t_str.v {
        return ALIGN_8;
    }

    let ty = type_get(ti, id);
    if (ty as usize) == 0 {
        return ALIGN_1;
    }
    let k = unsafe { (*ty).kind };
    if k == TY_BOOL || k == TY_I8 || k == TY_U8 {
        return ALIGN_1;
    }
    if k == TY_I16 || k == TY_U16 {
        return ALIGN_2;
    }
    if k == TY_I32 || k == TY_U32 || k == TY_CHAR || k == TY_INT_VAR {
        return ALIGN_4;
    }
    if k == TY_I64 || k == TY_U64 || k == TY_ISIZE || k == TY_USIZE {
        return ALIGN_8;
    }
    if k == TY_PTR || k == TY_FN || k == TY_VIEW || k == TY_MUT_VIEW || k == TY_PARAM {
        return ALIGN_8;
    }
    if k == TY_SLICE || k == TY_ARRAY {
        let elem_v = unsafe { (*ty).elem.v };
        return type_align(TypeId { v: elem_v }, ti);
    }
    if k == TY_ENUM {
        let mut max_align: u32 = ALIGN_4;
        let vcount = unsafe { (*ty).variant_count };
        let vcounts = unsafe { (*ty).variant_field_counts };
        let vfields = unsafe { (*ty).variant_fields };
        if (vcounts as usize) != 0 && (vfields as usize) != 0 {
            let mut i: usize = 0;
            while (i < vcount) {
                let count = unsafe { *usize_at(vcounts, i) };
                let vf = unsafe { *typeid_ptr_at(vfields, i) };
                let mut j: usize = 0;
                while (j < count) {
                    let fty_v = unsafe { (*typeid_at(vf, j)).v };
                    let a = type_align(TypeId { v: fty_v }, ti);
                    if a > max_align {
                        max_align = a;
                    }
                    j = j + 1;
                }
                i = i + 1;
            }
        }
        return max_align;
    }
    if k == TY_TUPLE || k == TY_STRUCT {
        let mut align: u32 = ALIGN_1;
        let count = unsafe { (*ty).field_count };
        let fields = unsafe { (*ty).fields };
        let mut i: usize = 0;
        while (i < count) {
            let fty_v = unsafe { (*typeid_at(fields, i)).v };
            let fa = type_align(TypeId { v: fty_v }, ti);
            if fa > align {
                align = fa;
            }
            i = i + 1;
        }
        return align;
    }
    if k == TY_CLOSURE {
        let mut align: u32 = ALIGN_8;
        let count = unsafe { (*ty).capture_count };
        let caps = unsafe { (*ty).captures };
        let mut i: usize = 0;
        while (i < count) {
            let cap = unsafe { capture_at(caps, i) };
            let cty_v = unsafe { (*cap).ty.v };
            let fa = type_align(TypeId { v: cty_v }, ti);
            if fa > align {
                align = fa;
            }
            i = i + 1;
        }
        return align;
    }
    ALIGN_1
}

pub fn type_size(id: TypeId, ti: view<TypeInterner>) -> u32 {
    if id.v == 0u32 {
        return SIZE_0;
    }
    if id.v == ti.t_unit.v || id.v == ti.t_never.v {
        return SIZE_0;
    }
    if id.v == ti.t_bool.v || id.v == ti.t_i8.v || id.v == ti.t_u8.v {
        return SIZE_1;
    }
    if id.v == ti.t_i16.v || id.v == ti.t_u16.v {
        return SIZE_2;
    }
    if id.v == ti.t_i32.v || id.v == ti.t_u32.v || id.v == ti.t_char.v {
        return SIZE_4;
    }
    if id.v == ti.t_i64.v || id.v == ti.t_u64.v || id.v == ti.t_isize.v || id.v == ti.t_usize.v {
        return SIZE_8;
    }
    if id.v == ti.t_str.v {
        return SIZE_16;
    }

    let ty = type_get(ti, id);
    if (ty as usize) == 0 {
        return SIZE_0;
    }
    let k = unsafe { (*ty).kind };
    if k == TY_BOOL || k == TY_I8 || k == TY_U8 {
        return SIZE_1;
    }
    if k == TY_I16 || k == TY_U16 {
        return SIZE_2;
    }
    if k == TY_I32 || k == TY_U32 || k == TY_CHAR || k == TY_INT_VAR {
        return SIZE_4;
    }
    if k == TY_I64 || k == TY_U64 || k == TY_ISIZE || k == TY_USIZE {
        return SIZE_8;
    }
    if k == TY_PTR || k == TY_FN || k == TY_PARAM {
        return SIZE_8;
    }
    if k == TY_VIEW || k == TY_MUT_VIEW {
        let pt_v = unsafe { (*ty).pointee.v };
        let pty = type_get(ti, TypeId { v: pt_v });
        let pk = unsafe { (*pty).kind };
        if pk == TY_SLICE {
            return SIZE_16;
        }
        return SIZE_8;
    }
    if k == TY_SLICE {
        return SIZE_0;
    }
    if k == TY_ARRAY {
        let elem_v = unsafe { (*ty).elem.v };
        let arr_len = unsafe { (*ty).array_len };
        let esz = type_size(TypeId { v: elem_v }, ti) as isize;
        return (esz * (arr_len as isize)) as u32;
    }
    if k == TY_ENUM {
        let mut max_align: u32 = ALIGN_4;
        let mut max_payload_size: u32 = SIZE_0;
        let vcount = unsafe { (*ty).variant_count };
        let vcounts = unsafe { (*ty).variant_field_counts };
        let vfields = unsafe { (*ty).variant_fields };
        if (vcounts as usize) != 0 && (vfields as usize) != 0 {
            let mut i: usize = 0;
            while (i < vcount) {
                let count = unsafe { *usize_at(vcounts, i) };
                if count > 0 {
                    let vf = unsafe { *typeid_ptr_at(vfields, i) };
                    let fl = unsafe {
                        let fbytes = mul_usize(count, size_of<FieldLayout>());
                        heap_alloc(fbytes, align_of<FieldLayout>()) as *mut FieldLayout
                    };
                    let mut j: usize = 0;
                    while (j < count) {
                        let fty_v = unsafe { (*typeid_at(vf, j)).v };
                        let fa = type_align(TypeId { v: fty_v }, ti);
                        let fs = type_size(TypeId { v: fty_v }, ti);
                        if fa > max_align {
                            max_align = fa;
                        }
                        let fp = unsafe { field_layout_at(fl, j) };
                        unsafe {
                            (*fp).index = j as u32;
                            (*fp).align = fa;
                            (*fp).size = fs;
                        }
                        j = j + 1;
                    }
                    sort_fields(fl, count);
                    let mut offset: u32 = 0u32;
                    let mut k_idx: usize = 0;
                    while (k_idx < count) {
                        let fp = unsafe { field_layout_at(fl, k_idx) };
                        let fa = unsafe { (*fp).align };
                        let fs = unsafe { (*fp).size };
                        offset = align_up_u32(offset, fa);
                        offset = offset + fs;
                        k_idx = k_idx + 1;
                    }
                    unsafe {
                        heap_free(
                            fl as *mut u8,
                            mul_usize(count, size_of<FieldLayout>()),
                            align_of<FieldLayout>()
                        );
                    }
                    if offset > max_payload_size {
                        max_payload_size = offset;
                    }
                }
                i = i + 1;
            }
        }
        let total_size = SIZE_4 + max_payload_size;
        return align_up_u32(total_size, max_align);
    }
    if k == TY_TUPLE || k == TY_STRUCT {
        let count = unsafe { (*ty).field_count };
        if count == 0 {
            return SIZE_0;
        }
        let fields = unsafe { (*ty).fields };
        let is_repr_c = unsafe { (*ty).is_repr_c };
        let fl = unsafe {
            heap_alloc(mul_usize(count, size_of<FieldLayout>()), align_of<FieldLayout>()) as *mut FieldLayout
        };
        let mut max_align: u32 = ALIGN_1;
        let mut i: usize = 0;
        while (i < count) {
            let fty_v = unsafe { (*typeid_at(fields, i)).v };
            let fa = type_align(TypeId { v: fty_v }, ti);
            let fs = type_size(TypeId { v: fty_v }, ti);
            if fa > max_align {
                max_align = fa;
            }
            let fp = unsafe { field_layout_at(fl, i) };
            unsafe {
                (*fp).index = i as u32;
                (*fp).align = fa;
                (*fp).size = fs;
            }
            i = i + 1;
        }
        if k == TY_TUPLE || !is_repr_c {
            sort_fields(fl, count);
        }
        let mut offset: u32 = 0u32;
        let mut j: usize = 0;
        while (j < count) {
            let fp = unsafe { field_layout_at(fl, j) };
            let fa = unsafe { (*fp).align };
            let fs = unsafe { (*fp).size };
            offset = align_up_u32(offset, fa);
            offset = offset + fs;
            j = j + 1;
        }
        unsafe {
            heap_free(fl as *mut u8, mul_usize(count, size_of<FieldLayout>()), align_of<FieldLayout>());
        }
        return align_up_u32(offset, max_align);
    }
    if k == TY_CLOSURE {
        let mut offset: u32 = SIZE_8;
        let mut max_align: u32 = ALIGN_8;
        let count = unsafe { (*ty).capture_count };
        let caps = unsafe { (*ty).captures };
        let mut i: usize = 0;
        while (i < count) {
            let cap = unsafe { capture_at(caps, i) };
            let cty_v = unsafe { (*cap).ty.v };
            let a = type_align(TypeId { v: cty_v }, ti);
            let s = type_size(TypeId { v: cty_v }, ti);
            if a > max_align {
                max_align = a;
            }
            offset = align_up_u32(offset, a);
            offset = offset + s;
            i = i + 1;
        }
        return align_up_u32(offset, max_align);
    }
    SIZE_0
}

pub fn type_layout(id: TypeId, ti: view<TypeInterner>) -> Layout {
    let id_v = id.v;
    Layout {
        size: type_size(TypeId { v: id_v }, ti),
        align: type_align(TypeId { v: id_v }, ti),
    }
}

pub fn type_field_offset(id: TypeId, field_idx: usize, ti: view<TypeInterner>) -> u32 {
    let ty = type_get(ti, id);
    if (ty as usize) == 0 {
        return 0u32;
    }
    let k = unsafe { (*ty).kind };
    if k == TY_TUPLE || k == TY_STRUCT {
        let count = unsafe { (*ty).field_count };
        if field_idx >= count {
            return 0u32;
        }
        let fields = unsafe { (*ty).fields };
        let is_repr_c = unsafe { (*ty).is_repr_c };
        let fl = unsafe {
            heap_alloc(mul_usize(count, size_of<FieldLayout>()), align_of<FieldLayout>()) as *mut FieldLayout
        };
        let mut i: usize = 0;
        while (i < count) {
            let fty_v = unsafe { (*typeid_at(fields, i)).v };
            let fa = type_align(TypeId { v: fty_v }, ti);
            let fs = type_size(TypeId { v: fty_v }, ti);
            let fp = unsafe { field_layout_at(fl, i) };
            unsafe {
                (*fp).index = i as u32;
                (*fp).align = fa;
                (*fp).size = fs;
            }
            i = i + 1;
        }
        if k == TY_TUPLE || !is_repr_c {
            sort_fields(fl, count);
        }
        let mut offset: u32 = 0u32;
        let mut target_offset: u32 = 0u32;
        let mut j: usize = 0;
        while (j < count) {
            let fp = unsafe { field_layout_at(fl, j) };
            let f_index = unsafe { (*fp).index };
            let fa = unsafe { (*fp).align };
            let fs = unsafe { (*fp).size };
            offset = align_up_u32(offset, fa);
            if (f_index as usize) == field_idx {
                target_offset = offset;
                break;
            }
            offset = offset + fs;
            j = j + 1;
        }
        unsafe {
            heap_free(fl as *mut u8, mul_usize(count, size_of<FieldLayout>()), align_of<FieldLayout>());
        }
        return target_offset;
    }
    if k == TY_CLOSURE {
        if field_idx == 0 {
            return 0u32;
        }
        let count = unsafe { (*ty).capture_count };
        if field_idx > count {
            return 0u32;
        }
        let caps = unsafe { (*ty).captures };
        let mut offset: u32 = SIZE_8;
        let mut i: usize = 0;
        while (i < count) {
            let cap = unsafe { capture_at(caps, i) };
            let cty_v = unsafe { (*cap).ty.v };
            let a = type_align(TypeId { v: cty_v }, ti);
            let s = type_size(TypeId { v: cty_v }, ti);
            offset = align_up_u32(offset, a);
            if field_idx == i + 1 {
                return offset;
            }
            offset = offset + s;
            i = i + 1;
        }
        return offset;
    }
    0u32
}

pub fn type_enum_field_offset(
    id: TypeId,
    variant_idx: u32,
    field_idx: usize,
    ti: view<TypeInterner>
) -> u32 {
    let ty = type_get(ti, id);
    if (ty as usize) == 0 {
        return 0u32;
    }
    let k = unsafe { (*ty).kind };
    if k != TY_ENUM {
        return 0u32;
    }
    let vcount = unsafe { (*ty).variant_count };
    if (variant_idx as usize) >= vcount {
        return 0u32;
    }
    let vcounts = unsafe { (*ty).variant_field_counts };
    let vfields = unsafe { (*ty).variant_fields };
    if (vcounts as usize) == 0 || (vfields as usize) == 0 {
        return 0u32;
    }
    let count = unsafe { *usize_at(vcounts, variant_idx as usize) };
    if field_idx >= count {
        return 0u32;
    }
    let vf = unsafe { *typeid_ptr_at(vfields, variant_idx as usize) };
    let fl = unsafe {
        heap_alloc(mul_usize(count, size_of<FieldLayout>()), align_of<FieldLayout>()) as *mut FieldLayout
    };
    let mut i: usize = 0;
    while (i < count) {
        let fty_v = unsafe { (*typeid_at(vf, i)).v };
        let fa = type_align(TypeId { v: fty_v }, ti);
        let fs = type_size(TypeId { v: fty_v }, ti);
        let fp = unsafe { field_layout_at(fl, i) };
        unsafe {
            (*fp).index = i as u32;
            (*fp).align = fa;
            (*fp).size = fs;
        }
        i = i + 1;
    }
    sort_fields(fl, count);
    let mut offset: u32 = SIZE_4;
    let mut target_offset: u32 = 0u32;
    let mut j: usize = 0;
    while (j < count) {
        let fp = unsafe { field_layout_at(fl, j) };
        let f_index = unsafe { (*fp).index };
        let fa = unsafe { (*fp).align };
        let fs = unsafe { (*fp).size };
        offset = align_up_u32(offset, fa);
        if (f_index as usize) == field_idx {
            target_offset = offset;
            break;
        }
        offset = offset + fs;
        j = j + 1;
    }
    unsafe {
        heap_free(fl as *mut u8, mul_usize(count, size_of<FieldLayout>()), align_of<FieldLayout>());
    }
    target_offset
}

// Axiom Compiler — LIR Data Model & Text Printer (compiler/lir/lir.ax)
// Port of bootstrap/axiom0/src/lir/lir.h and bootstrap/axiom0/src/lir/print.c.
module compiler.lir.lir

use compiler.kernel.arena.Arena
use compiler.kernel.arena.arena_alloc_raw
use compiler.kernel.id.TypeId
use compiler.diag.format.DiagBuffer
use compiler.diag.format.diag_buf_push_byte
use compiler.diag.format.diag_buf_push_bytes
use compiler.diag.format.diag_buf_push_u32

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub fn lir_mul_usize(a: usize, b: usize) -> usize {
    ((a as isize) * (b as isize)) as usize
}

pub const LIR_VREG_NONE: u32 = 0xFFFFFFFFu32;
pub const LIR_SLOT_NONE: u32 = 0xFFFFFFFFu32;
pub const LIR_BB_NONE: u32 = 0xFFFFFFFFu32;

pub struct LirVRegId {
    pub v: u32,
}

pub struct LirStackSlotId {
    pub v: u32,
}

pub struct LirBbId {
    pub v: u32,
}

pub struct LirStackSlot {
    pub ty: TypeId,
    pub is_const: bool,
}

pub struct LirVReg {
    pub ty: TypeId,
}

pub const LIR_INST_ADD: u8 = 0u8;
pub const LIR_INST_SUB: u8 = 1u8;
pub const LIR_INST_MUL: u8 = 2u8;
pub const LIR_INST_DIV: u8 = 3u8;
pub const LIR_INST_REM: u8 = 4u8;
pub const LIR_INST_BIT_XOR: u8 = 5u8;
pub const LIR_INST_BIT_AND: u8 = 6u8;
pub const LIR_INST_BIT_OR: u8 = 7u8;
pub const LIR_INST_SHL: u8 = 8u8;
pub const LIR_INST_SHR: u8 = 9u8;
pub const LIR_INST_SAR: u8 = 10u8;
pub const LIR_INST_NEG: u8 = 11u8;
pub const LIR_INST_NOT: u8 = 12u8;
pub const LIR_INST_BITNOT: u8 = 13u8;
pub const LIR_INST_ICMP_EQ: u8 = 14u8;
pub const LIR_INST_ICMP_NE: u8 = 15u8;
pub const LIR_INST_ICMP_SLT: u8 = 16u8;
pub const LIR_INST_ICMP_SLE: u8 = 17u8;
pub const LIR_INST_ICMP_SGT: u8 = 18u8;
pub const LIR_INST_ICMP_SGE: u8 = 19u8;
pub const LIR_INST_ICMP_ULT: u8 = 20u8;
pub const LIR_INST_ICMP_ULE: u8 = 21u8;
pub const LIR_INST_ICMP_UGT: u8 = 22u8;
pub const LIR_INST_ICMP_UGE: u8 = 23u8;
pub const LIR_INST_LOAD: u8 = 24u8;
pub const LIR_INST_STORE: u8 = 25u8;
pub const LIR_INST_STACK_ADDR: u8 = 26u8;
pub const LIR_INST_OFFSET: u8 = 27u8;
pub const LIR_INST_CONST: u8 = 28u8;
pub const LIR_INST_CONST_STR: u8 = 29u8;
pub const LIR_INST_FN_ADDR: u8 = 30u8;
pub const LIR_INST_SADD_OVERFLOW: u8 = 31u8;
pub const LIR_INST_UADD_OVERFLOW: u8 = 32u8;
pub const LIR_INST_SSUB_OVERFLOW: u8 = 33u8;
pub const LIR_INST_USUB_OVERFLOW: u8 = 34u8;
pub const LIR_INST_SMUL_OVERFLOW: u8 = 35u8;
pub const LIR_INST_UMUL_OVERFLOW: u8 = 36u8;
pub const LIR_INST_SDIV_OVERFLOW: u8 = 37u8;
pub const LIR_INST_UDIV_OVERFLOW: u8 = 38u8;
pub const LIR_INST_SREM_OVERFLOW: u8 = 39u8;
pub const LIR_INST_UREM_OVERFLOW: u8 = 40u8;
pub const LIR_INST_CALL: u8 = 41u8;
pub const LIR_INST_ABI_ARG: u8 = 42u8;
pub const LIR_INST_ABI_RESULT: u8 = 43u8;

pub struct LirInst {
    pub kind: u8,
    pub dest: LirVRegId,
    pub lhs: LirVRegId,
    pub rhs: LirVRegId,
    pub operand: LirVRegId,
    pub ptr: LirVRegId,
    pub val: LirVRegId,
    pub offset: LirVRegId,
    pub ty: TypeId,
    pub bit_width: u32,
    pub slot: LirStackSlotId,
    pub const_val: u64,
    pub str_bytes: *const u8,
    pub str_len: usize,
    pub sym_name: *const u8,
    pub sym_len: usize,
    pub callee_ty: TypeId,
    pub dst_addr: LirVRegId,
    pub callee_vreg: LirVRegId,
    pub index: u32,
    pub loc_kind: u32,
    pub loc_reg_or_offset: u32,
}

pub const LIR_TERM_JMP: u8 = 0u8;
pub const LIR_TERM_JCC: u8 = 1u8;
pub const LIR_TERM_SWITCH: u8 = 2u8;
pub const LIR_TERM_RETURN: u8 = 3u8;
pub const LIR_TERM_UNREACHABLE: u8 = 4u8;
pub const LIR_TERM_ASSERT: u8 = 5u8;

pub struct LirSwitchTarget {
    pub val: u64,
    pub target: LirBbId,
}

pub struct LirTerminator {
    pub kind: u8,
    pub jmp_target: LirBbId,
    pub cond: LirVRegId,
    pub then_target: LirBbId,
    pub else_target: LirBbId,
    pub assert_target: LirBbId,
    pub msg_ptr: *const u8,
    pub msg_len: usize,
    pub targets: *mut LirSwitchTarget,
    pub count: usize,
    pub otherwise: LirBbId,
}

pub struct LirBb {
    pub id: LirBbId,
    pub insts: *mut LirInst,
    pub inst_count: usize,
    pub term: LirTerminator,
}

pub struct LirFrameReq {
    pub max_outgoing_args_bytes: u32,
    pub requires_16_byte_alignment: bool,
}

pub struct LirBody {
    pub arena: *mut Arena,
    pub slots: *mut LirStackSlot,
    pub slot_count: usize,
    pub vregs: *mut LirVReg,
    pub vreg_count: usize,
    pub bbs: *mut LirBb,
    pub bb_count: usize,
    pub frame_req: LirFrameReq,
}

pub struct LirConstEntry {
    pub sym_v: u32,
    pub sym_name: *const u8,
    pub sym_len: usize,
}

pub struct LirConstTable {
    pub entries: *const LirConstEntry,
    pub count: usize,
}

// --- Pointer Indexing & Reset Helpers ---

pub unsafe fn lir_slot_at(base: *mut LirStackSlot, idx: usize) -> *mut LirStackSlot {
    let off = lir_mul_usize(idx, size_of<LirStackSlot>());
    ((base as usize) + off) as *mut LirStackSlot
}

pub unsafe fn lir_vreg_at(base: *mut LirVReg, idx: usize) -> *mut LirVReg {
    let off = lir_mul_usize(idx, size_of<LirVReg>());
    ((base as usize) + off) as *mut LirVReg
}

pub unsafe fn lir_bb_at(base: *mut LirBb, idx: usize) -> *mut LirBb {
    let off = lir_mul_usize(idx, size_of<LirBb>());
    ((base as usize) + off) as *mut LirBb
}

pub unsafe fn lir_inst_at(base: *mut LirInst, idx: usize) -> *mut LirInst {
    let off = lir_mul_usize(idx, size_of<LirInst>());
    ((base as usize) + off) as *mut LirInst
}

pub unsafe fn lir_switch_target_at(base: *mut LirSwitchTarget, idx: usize) -> *mut LirSwitchTarget {
    let off = lir_mul_usize(idx, size_of<LirSwitchTarget>());
    ((base as usize) + off) as *mut LirSwitchTarget
}

pub unsafe fn lir_const_entry_at(base: *const LirConstEntry, idx: usize) -> *const LirConstEntry {
    let off = lir_mul_usize(idx, size_of<LirConstEntry>());
    ((base as usize) + off) as *const LirConstEntry
}

pub fn lir_inst_reset(inst: mut_view<LirInst>, kind: u8) {
    inst.kind = kind;
    inst.dest.v = 0u32;
    inst.lhs.v = 0u32;
    inst.rhs.v = 0u32;
    inst.operand.v = 0u32;
    inst.ptr.v = 0u32;
    inst.val.v = 0u32;
    inst.offset.v = 0u32;
    inst.ty.v = 0u32;
    inst.bit_width = 0u32;
    inst.slot.v = 0u32;
    inst.const_val = 0u64;
    inst.str_bytes = 0 as *const u8;
    inst.str_len = 0;
    inst.sym_name = 0 as *const u8;
    inst.sym_len = 0;
    inst.callee_ty.v = 0u32;
    inst.dst_addr.v = LIR_VREG_NONE;
    inst.callee_vreg.v = LIR_VREG_NONE;
    inst.index = 0u32;
    inst.loc_kind = 0u32;
    inst.loc_reg_or_offset = 0u32;
}

pub fn lir_copy_inst(dst: mut_view<LirInst>, src: view<LirInst>) {
    dst.kind = src.kind;
    dst.dest.v = src.dest.v;
    dst.lhs.v = src.lhs.v;
    dst.rhs.v = src.rhs.v;
    dst.operand.v = src.operand.v;
    dst.ptr.v = src.ptr.v;
    dst.val.v = src.val.v;
    dst.offset.v = src.offset.v;
    dst.ty.v = src.ty.v;
    dst.bit_width = src.bit_width;
    dst.slot.v = src.slot.v;
    dst.const_val = src.const_val;
    dst.str_bytes = src.str_bytes;
    dst.str_len = src.str_len;
    dst.sym_name = src.sym_name;
    dst.sym_len = src.sym_len;
    dst.callee_ty.v = src.callee_ty.v;
    dst.dst_addr.v = src.dst_addr.v;
    dst.callee_vreg.v = src.callee_vreg.v;
    dst.index = src.index;
    dst.loc_kind = src.loc_kind;
    dst.loc_reg_or_offset = src.loc_reg_or_offset;
}

pub fn lir_term_reset(term: mut_view<LirTerminator>, kind: u8) {
    term.kind = kind;
    term.jmp_target.v = 0u32;
    term.cond.v = 0u32;
    term.then_target.v = 0u32;
    term.else_target.v = 0u32;
    term.assert_target.v = 0u32;
    term.msg_ptr = 0 as *const u8;
    term.msg_len = 0;
    term.targets = 0 as *mut LirSwitchTarget;
    term.count = 0;
    term.otherwise.v = 0u32;
}

pub fn lir_copy_term(dst: mut_view<LirTerminator>, src: view<LirTerminator>) {
    dst.kind = src.kind;
    dst.jmp_target.v = src.jmp_target.v;
    dst.cond.v = src.cond.v;
    dst.then_target.v = src.then_target.v;
    dst.else_target.v = src.else_target.v;
    dst.assert_target.v = src.assert_target.v;
    dst.msg_ptr = src.msg_ptr;
    dst.msg_len = src.msg_len;
    dst.targets = src.targets;
    dst.count = src.count;
    dst.otherwise.v = src.otherwise.v;
}

pub fn lir_bb_reset(bb: mut_view<LirBb>, id_v: u32) {
    bb.id.v = id_v;
    bb.insts = 0 as *mut LirInst;
    bb.inst_count = 0;
    lir_term_reset(mut_view(bb.term), LIR_TERM_UNREACHABLE);
}

pub fn lir_body_reset(body: mut_view<LirBody>, arena_ptr: *mut Arena) {
    body.arena = arena_ptr;
    body.slots = 0 as *mut LirStackSlot;
    body.slot_count = 0;
    body.vregs = 0 as *mut LirVReg;
    body.vreg_count = 0;
    body.bbs = 0 as *mut LirBb;
    body.bb_count = 0;
    body.frame_req.max_outgoing_args_bytes = 0u32;
    body.frame_req.requires_16_byte_alignment = false;
}

pub fn lir_body_new(arena: mut_view<Arena>) -> *mut LirBody {
    let body = arena_alloc_raw(mut_view(*arena), size_of<LirBody>(), align_of<LirBody>()) as *mut LirBody;
    let arena_ptr = unsafe { address_of_mut(arena.head) as *mut Arena };
    unsafe {
        lir_body_reset(mut_view(*body), arena_ptr);
    }
    body
}

// --- LIR Text Printer (port of bootstrap/axiom0/src/lir/print.c) ---

const LIR_STR_TABLE: [435]u8 = [
