// test: run
// timeout: 600
// stdout: OK x64 Frame Lowering, Prologue/Epilogue & Verifier\n

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

const HEAP_ZERO_MEMORY: u32 = 8u32;
const MIN_HEAP_ALLOC: usize = 16;

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if (h as usize) == 0 {
        return 0 as *mut u8;
    }
    let alloc_bytes: usize = if size < MIN_HEAP_ALLOC { MIN_HEAP_ALLOC } else { size };
    HeapAlloc(h, HEAP_ZERO_MEMORY, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if (p as usize) != 0 {
        let h = GetProcessHeap();
        if (h as usize) != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

module compiler.kernel.id

use std.core.host.heap_alloc
use std.core.host.heap_free

@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

// Typed ID Newtypes (INV-KERN-001, 0171 AKERNEL-24, 0153 ACKERNEL-20)
// Convention: v == 0 is none / invalid; v = table_index + 1.

pub struct StrId {
    pub v: u32,
}

impl StrId {
    pub fn none() -> StrId { StrId { v: 0 } }
    pub fn is_none(self: view<StrId>) -> bool { self.v == 0 }
    pub fn is_some(self: view<StrId>) -> bool { self.v != 0 }
    pub fn from_index(index: usize) -> StrId { StrId { v: (index + 1) as u32 } }
    pub fn index(self: view<StrId>) -> usize { (self.v - 1) as usize }
    pub fn eq(self: view<StrId>, other: view<StrId>) -> bool { self.v == other.v }
    pub fn to_raw(self: view<StrId>) -> u32 { self.v }
    pub fn from_raw(v: u32) -> StrId { StrId { v: v } }
}

