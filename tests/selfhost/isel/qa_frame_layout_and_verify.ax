// RawIdTable — Untyped contiguous ID table backing typed ID tables
pub struct RawIdTable {
    pub items: *mut u8,
    pub elem_size: usize,
    pub elem_align: usize,
    pub len: usize,
    pub cap: usize,
}

pub fn raw_idtable_new(elem_size: usize, elem_align: usize) -> RawIdTable {
    raw_idtable_with_capacity(0, elem_size, elem_align)
}

pub fn raw_idtable_with_capacity(capacity: usize, elem_size: usize, elem_align: usize) -> RawIdTable {
    let esz = if elem_size == 0 { 1 } else { elem_size };
    let eal = if elem_align == 0 { 1 } else { elem_align };
    if capacity == 0 {
        return RawIdTable {
            items: 0 as *mut u8,
            elem_size: esz,
            elem_align: eal,
            len: 0,
            cap: 0,
        };
    }
    let raw = unsafe { heap_alloc(capacity * esz, eal) };
    RawIdTable {
        items: raw,
        elem_size: esz,
        elem_align: eal,
        len: 0,
        cap: capacity,
    }
}

pub fn raw_idtable_free(t: mut_view<RawIdTable>) {
    if t.cap > 0 && t.items as usize != 0 {
        unsafe {
            heap_free(t.items, t.cap * t.elem_size, t.elem_align);
        }
    }
    t.items = 0 as *mut u8;
    t.len = 0;
    t.cap = 0;
}

pub fn raw_idtable_clear(t: mut_view<RawIdTable>) {
    t.len = 0;
}

pub fn raw_idtable_len(t: view<RawIdTable>) -> usize {
    t.len
}

pub fn raw_idtable_is_empty(t: view<RawIdTable>) -> bool {
    t.len == 0
}

pub fn raw_idtable_contains(t: view<RawIdTable>, id_val: u32) -> bool {
    id_val != 0 && (id_val as usize) <= t.len
}

pub fn raw_idtable_push(t: mut_view<RawIdTable>, src: *const u8) -> u32 {
    if t.len == t.cap {
        let new_cap = if t.cap == 0 { 4 } else { t.cap + t.cap };
        let new_items = unsafe { heap_alloc(new_cap * t.elem_size, t.elem_align) };
        if t.len > 0 && t.items as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(t.items as *const u8, new_items, t.len * t.elem_size);
                heap_free(t.items, t.cap * t.elem_size, t.elem_align);
            }
        }
        t.items = new_items;
        t.cap = new_cap;
    }
    let dst = (t.items as usize + t.len * t.elem_size) as *mut u8;
    if src as usize != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(src, dst, t.elem_size);
        }
    }
    t.len = t.len + 1;
    t.len as u32
}

pub unsafe fn raw_idtable_get_ptr(t: view<RawIdTable>, id_val: u32) -> *const u8 {
    (t.items as usize + ((id_val - 1) as usize) * t.elem_size) as *const u8
}

pub unsafe fn raw_idtable_get_mut_ptr(t: mut_view<RawIdTable>, id_val: u32) -> *mut u8 {
    (t.items as usize + ((id_val - 1) as usize) * t.elem_size) as *mut u8
}

pub fn raw_idtable_first(t: view<RawIdTable>) -> u32 {
    if t.len == 0 { 0u32 } else { 1u32 }
}

pub fn raw_idtable_after(t: view<RawIdTable>, id_val: u32) -> u32 {
    if (id_val as usize) < t.len { id_val + 1u32 } else { 0u32 }
}

// U32IdTable — Convenient typed ID table storing 32-bit values
pub struct U32IdTable {
    pub raw: RawIdTable,
}

pub fn u32_idtable_new() -> U32IdTable {
    U32IdTable {
        raw: raw_idtable_new(4, 4),
    }
}

pub fn u32_idtable_with_capacity(capacity: usize) -> U32IdTable {
    U32IdTable {
        raw: raw_idtable_with_capacity(capacity, 4, 4),
    }
}

pub fn u32_idtable_free(t: mut_view<U32IdTable>) {
    raw_idtable_free(mut_view(t.raw));
}

pub fn u32_idtable_len(t: view<U32IdTable>) -> usize {
    t.raw.len
}

pub fn u32_idtable_is_empty(t: view<U32IdTable>) -> bool {
    t.raw.len == 0
}

pub fn u32_idtable_contains(t: view<U32IdTable>, id_val: u32) -> bool {
    raw_idtable_contains(view(t.raw), id_val)
}

pub fn u32_idtable_push(t: mut_view<U32IdTable>, val: u32) -> u32 {
    unsafe {
        raw_idtable_push(mut_view(t.raw), address_of(val) as *const u8)
    }
}

pub fn u32_idtable_get(t: view<U32IdTable>, id_val: u32) -> u32 {
    if !raw_idtable_contains(view(t.raw), id_val) {
        return 0u32;
    }
    unsafe {
        let p = raw_idtable_get_ptr(view(t.raw), id_val) as *const u32;
        *p
    }
}

pub fn u32_idtable_set(t: mut_view<U32IdTable>, id_val: u32, val: u32) -> bool {
    if !raw_idtable_contains(view(t.raw), id_val) {
        return false;
    }
    unsafe {
        let p = raw_idtable_get_mut_ptr(mut_view(t.raw), id_val) as *mut u32;
        *p = val;
    }
    true
}

pub fn u32_idtable_first(t: view<U32IdTable>) -> u32 {
    raw_idtable_first(view(t.raw))
}

pub fn u32_idtable_after(t: view<U32IdTable>, id_val: u32) -> u32 {
    raw_idtable_after(view(t.raw), id_val)
}

module compiler.kernel.hash

@intrinsic fn wrapping_add_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn rotate_left_u64(x: u64, n: u32) -> u64 { 0 }

// AXH64 v1 constants (matching bootstrap/axiom0/src/kernel/hash.c and ADR-0004 §4)
pub const AXH_K1: u64 = 0x9E3779B97F4A7C15;
pub const AXH_K2: u64 = 0xC2B2AE3D27D4EB4F;
pub const AXH_K3: u64 = 0x165667B19E3779F9;
pub const AXH_SEED: u64 = 0x27D4EB2F165667C5;
pub const AXH_M: u64 = 0x9FB21C651E98DF25;

pub fn ax_rotl64(x: u64, n: u32) -> u64 {
    rotate_left_u64(x, n)
}

fn axh_round(h: u64, w: u64) -> u64 {
    let m = wrapping_mul_u64(ax_rotl64(wrapping_mul_u64(w, AXH_K2), 31u32), AXH_K1);
    wrapping_add_u64(wrapping_mul_u64(ax_rotl64(h ^ m, 27u32), AXH_K1), AXH_K3)
}

fn axh_fold(h: u64) -> u64 {
    h ^ ax_rotl64(h, 15u32) ^ ax_rotl64(h, 40u32)
}

fn axh_avalanche(mut h: u64) -> u64 {
    h = wrapping_mul_u64(axh_fold(h), AXH_M);
    h = wrapping_mul_u64(axh_fold(h), AXH_K2);
    axh_fold(h)
}

pub struct AxHasher {
    pub h: u64,
    pub total_len: u64,
    pub buf: [8]u8,
    pub buf_len: usize,
}

pub fn ax_hasher_new() -> AxHasher {
    AxHasher {
        h: AXH_SEED,
        total_len: 0u64,
        buf: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8],
        buf_len: 0,
    }
}

pub fn ax_hasher_init(s: mut_view<AxHasher>) {
    s.h = AXH_SEED;
    s.total_len = 0u64;
    s.buf[0] = 0u8;
    s.buf[1] = 0u8;
    s.buf[2] = 0u8;
    s.buf[3] = 0u8;
    s.buf[4] = 0u8;
    s.buf[5] = 0u8;
    s.buf[6] = 0u8;
    s.buf[7] = 0u8;
    s.buf_len = 0;
}

pub fn ax_hasher_write(s: mut_view<AxHasher>, bytes: *const u8, mut byte_len: usize) {
    let mut p = bytes;
    s.total_len = wrapping_add_u64(s.total_len, byte_len as u64);
    while byte_len > 0 {
        if s.buf_len == 0 && byte_len >= 8 {
            let mut w: u64 = 0;
            let mut j: usize = 0;
            while j < 8 {
                let b = unsafe { *(p + j) } as u64;
                w = w | (b << (8 * j as u32));
                j = j + 1;
            }
            s.h = axh_round(s.h, w);
            p = unsafe { p + 8 };
            byte_len = byte_len - 8;
            continue;
        }
        s.buf[s.buf_len] = unsafe { *p };
        s.buf_len = s.buf_len + 1;
        p = unsafe { p + 1 };
        byte_len = byte_len - 1;
        if s.buf_len == 8 {
            let mut w: u64 = 0;
            let mut j: usize = 0;
            while j < 8 {
                let b = s.buf[j] as u64;
                w = w | (b << (8 * j as u32));
                j = j + 1;
            }
            s.h = axh_round(s.h, w);
            s.buf_len = 0;
        }
    }
}

pub fn ax_hasher_write_u32(s: mut_view<AxHasher>, mut v: u32) {
    let mut i: usize = 0;
    while i < 4 {
        s.total_len = wrapping_add_u64(s.total_len, 1u64);
        s.buf[s.buf_len] = (v & 0xFFu32) as u8;
        s.buf_len = s.buf_len + 1;
        if s.buf_len == 8 {
            let mut w: u64 = 0;
            let mut j: usize = 0;
            while j < 8 {
                let b = s.buf[j] as u64;
                w = w | (b << (8 * j as u32));
                j = j + 1;
            }
            s.h = axh_round(s.h, w);
            s.buf_len = 0;
        }
        v = v >> 8u32;
        i = i + 1;
    }
}

pub fn ax_hasher_write_u64(s: mut_view<AxHasher>, mut v: u64) {
    let mut i: usize = 0;
    while i < 8 {
        s.total_len = wrapping_add_u64(s.total_len, 1u64);
        s.buf[s.buf_len] = (v & 0xFFu64) as u8;
        s.buf_len = s.buf_len + 1;
        if s.buf_len == 8 {
            let mut w: u64 = 0;
            let mut j: usize = 0;
            while j < 8 {
                let b = s.buf[j] as u64;
                w = w | (b << (8 * j as u32));
                j = j + 1;
            }
            s.h = axh_round(s.h, w);
            s.buf_len = 0;
        }
        v = v >> 8u32;
        i = i + 1;
    }
}

pub fn ax_hasher_finish(s: view<AxHasher>) -> u64 {
    let mut h = s.h;
    if s.buf_len > 0 {
        let mut w: u64 = 0;
        let mut j: usize = 0;
        while j < s.buf_len {
            let b = s.buf[j] as u64;
            w = w | (b << (8 * j as u32));
            j = j + 1;
        }
        h = axh_round(h, w);
    }
    h = h ^ wrapping_mul_u64(s.total_len, AXH_K3);
    axh_avalanche(h)
}

pub fn ax_hash_bytes(bytes: *const u8, byte_len: usize) -> u64 {
    let mut s = ax_hasher_new();
    ax_hasher_write(mut_view(s), bytes, byte_len);
    ax_hasher_finish(view(s))
}

pub fn ax_hash_u32(v: u32) -> u64 {
    let mut s = ax_hasher_new();
    ax_hasher_write_u32(mut_view(s), v);
    ax_hasher_finish(view(s))
}

pub fn ax_hash_u64(v: u64) -> u64 {
    let mut s = ax_hasher_new();
    ax_hasher_write_u64(mut_view(s), v);
    ax_hasher_finish(view(s))
}

pub fn ax_hash_combine(a: u64, b: u64) -> u64 {
    let mut s = ax_hasher_new();
    ax_hasher_write_u64(mut_view(s), a);
    ax_hasher_write_u64(mut_view(s), b);
    ax_hasher_finish(view(s))
}

module compiler.kernel.arena

use std.core.host.heap_alloc
use std.core.host.heap_free

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub const AX_ARENA_DEFAULT_CHUNK: usize = 65536;
pub const AX_ARENA_MAX_ALIGN: usize = 4096;

pub struct ArenaChunk {
    pub next: *mut ArenaChunk,
    pub cap: usize,
    pub used: usize,
    pub data: *mut u8,
}

pub struct Arena {
    pub head: *mut ArenaChunk,
    pub current: *mut ArenaChunk,
    pub chunk_size: usize,
    pub bytes_requested: usize,
    pub chunk_count: usize,
    pub chunks_allocated: usize,
    pub chunks_freed: usize,
}

pub fn arena_new() -> Arena {
    arena_with_chunk_size(AX_ARENA_DEFAULT_CHUNK)
}

pub fn arena_with_chunk_size(chunk_size: usize) -> Arena {
    let sz = if chunk_size == 0 { AX_ARENA_DEFAULT_CHUNK } else { chunk_size };
    Arena {
        head: null_mut<ArenaChunk>(),
        current: null_mut<ArenaChunk>(),
        chunk_size: sz,
        bytes_requested: 0,
        chunk_count: 0,
        chunks_allocated: 0,
        chunks_freed: 0,
    }
}

pub fn arena_alloc_raw(a: mut_view<Arena>, size: usize, align: usize) -> *mut u8 {
    let mut al = align;
    if al == 0 { al = 1; }
    if al > AX_ARENA_MAX_ALIGN { al = AX_ARENA_MAX_ALIGN; }
    let mask: usize = al - 1;
    a.bytes_requested = a.bytes_requested + size;

    if a.current as usize != 0 {
        let cur: *mut ArenaChunk = a.current;
        let c_addr: usize = unsafe { (*cur).data as usize };
        let u: usize = unsafe { (*cur).used };
        let cur_addr: usize = c_addr + u;
        let al_addr: usize = (cur_addr + mask) & ~mask;
        let off: usize = al_addr - c_addr;
        let cap: usize = unsafe { (*cur).cap };
        if cap >= off {
            let rem_cap: usize = cap - off;
            if rem_cap >= size {
                unsafe {
                    (*cur).used = off + size;
                }
                let ptr: *mut u8 = unsafe { (*cur).data + off };
                return ptr;
            }
        }
    }

    let need: usize = size + (al - 1);
    let payload: usize = if need > a.chunk_size { need } else { a.chunk_size };
    let raw: *mut u8 = unsafe { heap_alloc(payload, 16) };
    let hdr: *mut ArenaChunk = unsafe { heap_alloc(size_of<ArenaChunk>(), align_of<ArenaChunk>()) as *mut ArenaChunk };
    unsafe {
        (*hdr).next = null_mut<ArenaChunk>();
        (*hdr).cap = payload;
        (*hdr).used = 0;
        (*hdr).data = raw;
    }

    if a.head as usize == 0 {
        a.head = hdr;
    } else {
        unsafe {
            (*a.current).next = hdr;
        }
    }
    a.current = hdr;
    a.chunk_count = a.chunk_count + 1;
    a.chunks_allocated = a.chunks_allocated + 1;

    let c_addr: usize = raw as usize;
    let al_addr: usize = (c_addr + mask) & ~mask;
    let off: usize = al_addr - c_addr;
    unsafe {
        (*hdr).used = off + size;
    }
    let ptr: *mut u8 = unsafe { raw + off };
    ptr
}

pub fn arena_alloc<T>(a: mut_view<Arena>, val: T) -> *mut T {
    let sz = size_of<T>();
    let al = align_of<T>();
    let ptr = arena_alloc_raw(a, sz, al) as *mut T;
    unsafe {
        *ptr = val;
    }
    ptr
}

pub fn arena_alloc_array<T>(a: mut_view<Arena>, count: usize) -> *mut T {
    let sz = size_of<T>();
    let al = align_of<T>();
    arena_alloc_raw(a, count * sz, al) as *mut T
}

pub fn arena_dup(a: mut_view<Arena>, src: *const u8, size: usize) -> *mut u8 {
    let ptr = arena_alloc_raw(a, size, 1);
    if size > 0 && src as usize != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(src, ptr, size);
        }
    }
    ptr
}

pub fn arena_reset(a: mut_view<Arena>) {
    if a.head as usize == 0 {
        a.bytes_requested = 0;
        return;
    }
    let mut c: *mut ArenaChunk = unsafe { (*a.head).next };
    while c as usize != 0 {
        let next: *mut ArenaChunk = unsafe { (*c).next };
        unsafe {
            heap_free((*c).data, (*c).cap, 16);
            heap_free(c as *mut u8, size_of<ArenaChunk>(), align_of<ArenaChunk>());
        }
        a.chunks_freed = a.chunks_freed + 1;
        c = next;
    }
    unsafe {
        (*a.head).next = null_mut<ArenaChunk>();
        (*a.head).used = 0;
    }
    a.current = a.head;
    a.chunk_count = 1;
    a.bytes_requested = 0;
}

pub fn arena_destroy(a: mut_view<Arena>) {
    let mut c: *mut ArenaChunk = a.head;
    while c as usize != 0 {
        let next: *mut ArenaChunk = unsafe { (*c).next };
        unsafe {
            heap_free((*c).data, (*c).cap, 16);
            heap_free(c as *mut u8, size_of<ArenaChunk>(), align_of<ArenaChunk>());
        }
        a.chunks_freed = a.chunks_freed + 1;
        c = next;
    }
    a.head = null_mut<ArenaChunk>();
    a.current = null_mut<ArenaChunk>();
    a.chunk_count = 0;
    a.bytes_requested = 0;
}

pub fn arena_bytes_requested(a: view<Arena>) -> usize {
    a.bytes_requested
}

pub fn arena_chunk_count(a: view<Arena>) -> usize {
    a.chunk_count
}

pub fn arena_chunks_allocated(a: view<Arena>) -> usize {
    a.chunks_allocated
}

pub fn arena_chunks_freed(a: view<Arena>) -> usize {
    a.chunks_freed
}

pub fn arena_chunks_in_use(a: view<Arena>) -> usize {
    a.chunks_allocated - a.chunks_freed
}

impl Drop for Arena {
    fn drop(self: mut_view<Arena>) {
        arena_destroy(self);
    }
}

module compiler.kernel.interner

use std.core.host.heap_alloc
use std.core.host.heap_free
use compiler.kernel.hash.ax_hash_bytes
use compiler.kernel.hash.ax_hash_u32
use compiler.kernel.arena.Arena
use compiler.kernel.arena.arena_new
use compiler.kernel.arena.arena_destroy
use compiler.kernel.arena.arena_alloc_raw
use compiler.kernel.id.StrId

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub struct StrView {
    pub ptr: *const u8,
    pub len: usize,
}

pub struct StrInterner {
    pub bytes: Arena,
    pub strings: *mut StrView,
    pub len: usize,
    pub cap: usize,
    pub map_hashes: *mut u64,
    pub map_ids: *mut u32,
    pub map_cap: usize,
}

fn bytes_eq(a: *const u8, b: *const u8, n: usize) -> bool {
    let mut i: usize = 0;
    while i < n {
        if unsafe { *(a + i) } != unsafe { *(b + i) } {
            return false;
        }
        i = i + 1;
    }
    true
}

pub fn interner_init(in_: mut_view<StrInterner>) {
    in_.bytes = arena_new();
    in_.strings = 0 as *mut StrView;
    in_.len = 0;
    in_.cap = 0;
    in_.map_hashes = 0 as *mut u64;
    in_.map_ids = 0 as *mut u32;
    in_.map_cap = 0;
}

pub fn interner_new() -> StrInterner {
    let a = arena_new();
    StrInterner {
        bytes: a,
        strings: 0 as *mut StrView,
        len: 0,
        cap: 0,
        map_hashes: 0 as *mut u64,
        map_ids: 0 as *mut u32,
        map_cap: 0,
    }
}

pub fn interner_free(in_: mut_view<StrInterner>) {
    arena_destroy(mut_view(in_.bytes));
    let cap: usize = in_.cap;
    let strings_ptr: *mut StrView = in_.strings;
    if cap > 0 && (strings_ptr as usize) != 0 {
        unsafe {
            heap_free(strings_ptr as *mut u8, (((cap as isize) * (size_of<StrView>() as isize)) as usize), align_of<StrView>());
        }
    }
    let mcap: usize = in_.map_cap;
    let mhashes: *mut u64 = in_.map_hashes;
    let mids: *mut u32 = in_.map_ids;
    if mcap > 0 && (mhashes as usize) != 0 {
        unsafe {
            heap_free(mhashes as *mut u8, (mcap << 3), 8);
            heap_free(mids as *mut u8, (mcap << 2), 4);
        }
    }
    in_.strings = 0 as *mut StrView;
    in_.len = 0;
    in_.cap = 0;
    in_.map_hashes = 0 as *mut u64;
    in_.map_ids = 0 as *mut u32;
    in_.map_cap = 0;
}

fn interner_grow_map(in_: mut_view<StrInterner>) {
    let old_mcap: usize = in_.map_cap;
    let new_cap: usize = if old_mcap == 0 { 16 } else { old_mcap + old_mcap };
    let new_hashes: *mut u64 = unsafe { heap_alloc((new_cap << 3), 8) as *mut u64 };
    let new_ids: *mut u32 = unsafe { heap_alloc((new_cap << 2), 4) as *mut u32 };
    let mut j: usize = 0;
    while j < new_cap {
        unsafe {
            *(new_ids + j) = 0u32;
        }
        j = j + 1;
    }

    let mask = new_cap - 1;
    let cur_len: usize = in_.len;
    let strings_ptr: *mut StrView = in_.strings;
    let mut i: usize = 0;
    while i < cur_len {
        let sv_p: *mut StrView = unsafe { strings_ptr + i };
        let sv_ptr: *const u8 = unsafe { (*sv_p).ptr };
        let sv_len: usize = unsafe { (*sv_p).len };
        let h = ax_hash_bytes(sv_ptr, sv_len);
        let mut slot = (h as usize) & mask;
        while unsafe { *(new_ids + slot) } != 0u32 {
            slot = (slot + 1) & mask;
        }
        unsafe {
            *(new_hashes + slot) = h;
            *(new_ids + slot) = (i + 1) as u32;
        }
        i = i + 1;
    }

    let old_hashes: *mut u64 = in_.map_hashes;
    let old_ids: *mut u32 = in_.map_ids;
    if old_mcap > 0 && (old_hashes as usize) != 0 {
        unsafe {
            heap_free(old_hashes as *mut u8, (old_mcap << 3), 8);
            heap_free(old_ids as *mut u8, (old_mcap << 2), 4);
        }
    }
    in_.map_hashes = new_hashes;
    in_.map_ids = new_ids;
    in_.map_cap = new_cap;
}

pub fn interner_intern_bytes(in_: mut_view<StrInterner>, p_s: *const u8, n: usize) -> StrId {
    let h = ax_hash_bytes(p_s, n);

    let mcap0: usize = in_.map_cap;
    if mcap0 > 0 {
        let mask = mcap0 - 1;
        let mids0: *mut u32 = in_.map_ids;
        let mhashes0: *mut u64 = in_.map_hashes;
        let strings0: *mut StrView = in_.strings;
        let mut slot = (h as usize) & mask;
        while true {
            let id_v = unsafe { *(mids0 + slot) };
            if id_v == 0u32 {
                break;
            }
            if unsafe { *(mhashes0 + slot) } == h {
                let sv_p: *mut StrView = unsafe { strings0 + ((id_v - 1) as usize) };
                let sv_len: usize = unsafe { (*sv_p).len };
                let sv_ptr: *const u8 = unsafe { (*sv_p).ptr };
                if sv_len == n && bytes_eq(sv_ptr, p_s, n) {
                    return StrId { v: id_v };
                }
            }
            slot = (slot + 1) & mask;
        }
    }

    let copy = arena_alloc_raw(mut_view(in_.bytes), n + 1, 1);
    if n > 0 && p_s as usize != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(p_s, copy, n);
            *(copy + n) = 0u8;
        }
    }

    let cur_len: usize = in_.len;
    let cur_cap: usize = in_.cap;
    if cur_len == cur_cap {
        let new_cap: usize = if cur_cap == 0 { 8 } else { cur_cap + cur_cap };
        let new_strings: *mut StrView = unsafe {
            heap_alloc((((new_cap as isize) * (size_of<StrView>() as isize)) as usize), align_of<StrView>()) as *mut StrView
        };
        let old_strings: *mut StrView = in_.strings;
        if cur_len > 0 && (old_strings as usize) != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(
                    old_strings as *const u8,
                    new_strings as *mut u8,
                    cur_len * size_of<StrView>()
                );
                heap_free(old_strings as *mut u8, (((cur_cap as isize) * (size_of<StrView>() as isize)) as usize), align_of<StrView>());
            }
        }
        in_.strings = new_strings;
        in_.cap = new_cap;
    }

    let strings_cur: *mut StrView = in_.strings;
    unsafe {
        let dst_sv: *mut StrView = strings_cur + cur_len;
        (*dst_sv).ptr = copy as *const u8;
        (*dst_sv).len = n;
    }
    let next_len: usize = cur_len + 1;
    let new_id = StrId { v: next_len as u32 };
    in_.len = next_len;

    let mcap1: usize = in_.map_cap;
    if mcap1 == 0 || ((next_len as isize) * 4isize) > ((mcap1 as isize) * 3isize) {
        interner_grow_map(in_);
    } else {
        let mask = mcap1 - 1;
        let mids1: *mut u32 = in_.map_ids;
        let mhashes1: *mut u64 = in_.map_hashes;
        let mut slot = (h as usize) & mask;
        while unsafe { *(mids1 + slot) } != 0u32 {
            slot = (slot + 1) & mask;
        }
        unsafe {
            *(mhashes1 + slot) = h;
            *(mids1 + slot) = new_id.v;
        }
    }

    new_id
}

pub fn interner_intern_str(in_: mut_view<StrInterner>, s: view<Str>) -> StrId {
    let p_s = unsafe { *(address_of(*s) as *const *const u8) };
    let n = len(*s);
    interner_intern_bytes(in_, p_s, n)
}

pub fn interner_lookup_bytes(in_: view<StrInterner>, p_s: *const u8, n: usize) -> StrId {
    let mcap: usize = in_.map_cap;
    let cur_len: usize = in_.len;
    if mcap == 0 || cur_len == 0 {
        return StrId.none();
    }
    let h = ax_hash_bytes(p_s, n);
    let mask = mcap - 1;
    let mids: *mut u32 = in_.map_ids;
    let mhashes: *mut u64 = in_.map_hashes;
    let strings_ptr: *mut StrView = in_.strings;
    let mut slot = (h as usize) & mask;
    while true {
        let id_v = unsafe { *(mids + slot) };
        if id_v == 0u32 {
            return StrId.none();
        }
        if unsafe { *(mhashes + slot) } == h {
            let sv_p: *mut StrView = unsafe { strings_ptr + ((id_v - 1) as usize) };
            let sv_len: usize = unsafe { (*sv_p).len };
            let sv_ptr: *const u8 = unsafe { (*sv_p).ptr };
            if sv_len == n && bytes_eq(sv_ptr, p_s, n) {
                return StrId { v: id_v };
            }
        }
        slot = (slot + 1) & mask;
    }
    StrId.none()
}

pub fn interner_lookup_str(in_: view<StrInterner>, s: view<Str>) -> StrId {
    let p_s = unsafe { *(address_of(*s) as *const *const u8) };
    let n = len(*s);
    interner_lookup_bytes(in_, p_s, n)
}

pub fn interner_get(in_: view<StrInterner>, id: StrId) -> StrView {
    let cur_len: usize = in_.len;
    if id.v == 0 || (id.v as usize) > cur_len {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let strings_ptr: *mut StrView = in_.strings;
    let sv_p: *mut StrView = unsafe { strings_ptr + ((id.v - 1) as usize) };
    let sv_ptr: *const u8 = unsafe { (*sv_p).ptr };
    let sv_len: usize = unsafe { (*sv_p).len };
    StrView { ptr: sv_ptr, len: sv_len }
}

pub fn interner_len(in_: view<StrInterner>) -> usize {
    in_.len
}

pub fn interner_is_empty(in_: view<StrInterner>) -> bool {
    let cur_len: usize = in_.len;
    cur_len == 0
}

// U32Interner — Deterministic hash-consing for 32-bit values
pub struct U32Interner {
    pub items: *mut u32,
    pub len: usize,
    pub cap: usize,
    pub map_hashes: *mut u64,
    pub map_ids: *mut u32,
    pub map_cap: usize,
}

pub fn u32_interner_new() -> U32Interner {
    U32Interner {
        items: 0 as *mut u32,
        len: 0,
        cap: 0,
        map_hashes: 0 as *mut u64,
        map_ids: 0 as *mut u32,
        map_cap: 0,
    }
}

pub fn u32_interner_free(in_: mut_view<U32Interner>) {
    let cap: usize = in_.cap;
    let items_ptr: *mut u32 = in_.items;
    if cap > 0 && (items_ptr as usize) != 0 {
        unsafe {
            heap_free(items_ptr as *mut u8, (cap << 2), 4);
        }
    }
    let mcap: usize = in_.map_cap;
    let mhashes: *mut u64 = in_.map_hashes;
    let mids: *mut u32 = in_.map_ids;
    if mcap > 0 && (mhashes as usize) != 0 {
        unsafe {
            heap_free(mhashes as *mut u8, (mcap << 3), 8);
            heap_free(mids as *mut u8, (mcap << 2), 4);
        }
    }
    in_.items = 0 as *mut u32;
    in_.len = 0;
    in_.cap = 0;
    in_.map_hashes = 0 as *mut u64;
    in_.map_ids = 0 as *mut u32;
    in_.map_cap = 0;
}

fn u32_interner_grow_map(in_: mut_view<U32Interner>) {
    let old_mcap: usize = in_.map_cap;
    let new_cap: usize = if old_mcap == 0 { 16 } else { old_mcap + old_mcap };
    let new_hashes: *mut u64 = unsafe { heap_alloc((new_cap << 3), 8) as *mut u64 };
    let new_ids: *mut u32 = unsafe { heap_alloc((new_cap << 2), 4) as *mut u32 };
    let mut j: usize = 0;
    while j < new_cap {
        unsafe {
            *(new_ids + j) = 0u32;
        }
        j = j + 1;
    }

    let mask = new_cap - 1;
    let cur_len: usize = in_.len;
    let items_ptr: *mut u32 = in_.items;
    let mut i: usize = 0;
    while i < cur_len {
        let val = unsafe { *(items_ptr + i) };
        let h = ax_hash_u32(val);
        let mut slot = (h as usize) & mask;
        while unsafe { *(new_ids + slot) } != 0u32 {
            slot = (slot + 1) & mask;
        }
        unsafe {
            *(new_hashes + slot) = h;
            *(new_ids + slot) = (i + 1) as u32;
        }
        i = i + 1;
    }

    let old_hashes: *mut u64 = in_.map_hashes;
    let old_ids: *mut u32 = in_.map_ids;
    if old_mcap > 0 && (old_hashes as usize) != 0 {
        unsafe {
            heap_free(old_hashes as *mut u8, (old_mcap << 3), 8);
            heap_free(old_ids as *mut u8, (old_mcap << 2), 4);
        }
    }
    in_.map_hashes = new_hashes;
    in_.map_ids = new_ids;
    in_.map_cap = new_cap;
}

pub fn u32_intern(in_: mut_view<U32Interner>, val: u32) -> u32 {
    let h = ax_hash_u32(val);
    let mcap0: usize = in_.map_cap;
    if mcap0 > 0 {
        let mask = mcap0 - 1;
        let mids0: *mut u32 = in_.map_ids;
        let mhashes0: *mut u64 = in_.map_hashes;
        let items0: *mut u32 = in_.items;
        let mut slot = (h as usize) & mask;
        while true {
            let id_v = unsafe { *(mids0 + slot) };
            if id_v == 0u32 {
                break;
            }
            if unsafe { *(mhashes0 + slot) } == h {
                let existing = unsafe { *(items0 + ((id_v - 1) as usize)) };
                if existing == val {
                    return id_v;
                }
            }
            slot = (slot + 1) & mask;
        }
    }

    let cur_len: usize = in_.len;
    let cur_cap: usize = in_.cap;
    if cur_len == cur_cap {
        let new_cap: usize = if cur_cap == 0 { 8 } else { cur_cap + cur_cap };
        let new_items: *mut u32 = unsafe { heap_alloc((new_cap << 2), 4) as *mut u32 };
        let old_items: *mut u32 = in_.items;
        if cur_len > 0 && (old_items as usize) != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u32>(old_items as *const u32, new_items, cur_len);
                heap_free(old_items as *mut u8, (cur_cap << 2), 4);
            }
        }
        in_.items = new_items;
        in_.cap = new_cap;
    }

    let items_cur: *mut u32 = in_.items;
    unsafe {
        *(items_cur + cur_len) = val;
    }
    let next_len: usize = cur_len + 1;
    let new_id = next_len as u32;
    in_.len = next_len;

    let mcap1: usize = in_.map_cap;
    if mcap1 == 0 || ((next_len as isize) * 4isize) > ((mcap1 as isize) * 3isize) {
        u32_interner_grow_map(in_);
    } else {
        let mask = mcap1 - 1;
        let mids1: *mut u32 = in_.map_ids;
        let mhashes1: *mut u64 = in_.map_hashes;
        let mut slot = (h as usize) & mask;
        while unsafe { *(mids1 + slot) } != 0u32 {
            slot = (slot + 1) & mask;
        }
        unsafe {
            *(mhashes1 + slot) = h;
            *(mids1 + slot) = new_id;
        }
    }

    new_id
}

pub fn u32_interner_lookup(in_: view<U32Interner>, val: u32) -> u32 {
    let mcap: usize = in_.map_cap;
    let cur_len: usize = in_.len;
    if mcap == 0 || cur_len == 0 {
        return 0u32;
    }
    let h = ax_hash_u32(val);
    let mask = mcap - 1;
    let mids: *mut u32 = in_.map_ids;
    let mhashes: *mut u64 = in_.map_hashes;
    let items_ptr: *mut u32 = in_.items;
    let mut slot = (h as usize) & mask;
    while true {
        let id_v = unsafe { *(mids + slot) };
        if id_v == 0u32 {
            return 0u32;
        }
        if unsafe { *(mhashes + slot) } == h {
            let existing = unsafe { *(items_ptr + ((id_v - 1) as usize)) };
            if existing == val {
                return id_v;
            }
        }
        slot = (slot + 1) & mask;
    }
    0u32
}

pub fn u32_interner_get(in_: view<U32Interner>, id: u32) -> u32 {
    let cur_len: usize = in_.len;
    if id == 0 || (id as usize) > cur_len {
        return 0u32;
    }
    let items_ptr: *mut u32 = in_.items;
    unsafe {
        *(items_ptr + ((id - 1) as usize))
    }
}

pub fn u32_interner_len(in_: view<U32Interner>) -> usize {
    in_.len
}

pub fn u32_interner_is_empty(in_: view<U32Interner>) -> bool {
    let cur_len: usize = in_.len;
    cur_len == 0
}

module compiler.source.span

use compiler.kernel.id.FileId

pub struct Span {
    pub file: FileId,
    pub start: u32,
    pub end: u32,
}

impl Span {
    pub fn new(file: FileId, start: u32, end: u32) -> Span {
        Span { file: file, start: start, end: end }
    }

    pub fn none() -> Span {
        Span { file: FileId.none(), start: 0u32, end: 0u32 }
    }

    pub fn is_none(self: view<Span>) -> bool {
        self.file.is_none()
    }

    pub fn is_some(self: view<Span>) -> bool {
        self.file.is_some()
    }

    pub fn len(self: view<Span>) -> u32 {
        if self.end >= self.start {
            self.end - self.start
        } else {
            0u32
        }
    }

    pub fn eq(self: view<Span>, other: view<Span>) -> bool {
        self.file.eq(view(other.file)) && self.start == other.start && self.end == other.end
    }
}

pub fn span_new(file: FileId, start: u32, end: u32) -> Span {
    Span.new(file, start, end)
}

pub fn span_none() -> Span {
    Span.none()
}

pub fn span_is_none(s: view<Span>) -> bool {
    s.is_none()
}

pub struct LineCol {
    pub line: u32,       // 1-based line number
    pub col_bytes: u32,  // 1-based column in bytes
    pub col_chars: u32,  // 1-based column in Unicode scalar values
}

impl LineCol {
    pub fn zero() -> LineCol {
        LineCol { line: 0u32, col_bytes: 0u32, col_chars: 0u32 }
    }

    pub fn eq(self: view<LineCol>, other: view<LineCol>) -> bool {
        self.line == other.line && self.col_bytes == other.col_bytes && self.col_chars == other.col_chars
    }
}


module compiler.diag.format

use std.core.host.heap_alloc
use std.core.host.heap_free

use compiler.kernel.id.FileId
use compiler.kernel.interner.StrView

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub struct DiagBuffer {
    pub ptr: *mut u8,
    pub len: usize,
    pub cap: usize,
}

pub fn diag_buf_new() -> DiagBuffer {
    DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
}

pub fn diag_buf_init(b: mut_view<DiagBuffer>) {
    b.ptr = 0 as *mut u8;
    b.len = 0;
    b.cap = 0;
}

pub fn diag_buf_free(b: mut_view<DiagBuffer>) {
    if b.cap > 0 && b.ptr as usize != 0 {
        unsafe {
            heap_free(b.ptr, b.cap, 1);
        }
    }
    b.ptr = 0 as *mut u8;
    b.len = 0;
    b.cap = 0;
}

pub fn diag_buf_push_byte(b: mut_view<DiagBuffer>, byte: u8) {
    if b.len == b.cap {
        let new_cap = if b.cap == 0 { 128 } else { b.cap + b.cap };
        let new_ptr = unsafe { heap_alloc(new_cap, 1) };
        if b.len > 0 && b.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(b.ptr as *const u8, new_ptr, b.len);
                heap_free(b.ptr, b.cap, 1);
            }
        }
        b.ptr = new_ptr;
        b.cap = new_cap;
    }
    unsafe {
        *(b.ptr + b.len) = byte;
    }
    b.len = b.len + 1;
}

pub fn diag_buf_push_bytes(b: mut_view<DiagBuffer>, p: *const u8, count: usize) {
    if count == 0 || p as usize == 0 {
        return;
    }
    let mut i: usize = 0;
    while i < count {
        diag_buf_push_byte(mut_view(*b), unsafe { *(p + i) });
        i = i + 1;
    }
}

pub fn diag_buf_push_sv(b: mut_view<DiagBuffer>, sv: StrView) {
    diag_buf_push_bytes(b, sv.ptr, sv.len);
}

pub fn diag_buf_push_u32(b: mut_view<DiagBuffer>, mut n: u32) {
    if n == 0u32 {
        diag_buf_push_byte(b, 48u8);
        return;
    }
    let mut digits: [10]u8 = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    let mut count: usize = 0;
    while n > 0u32 {
        digits[count] = ((n % 10u32) as u8) + 48u8;
        n = n / 10u32;
        count = count + 1;
    }
    while count > 0 {
        count = count - 1;
        diag_buf_push_byte(mut_view(*b), digits[count]);
    }
}

pub fn diag_buf_as_str_view(b: view<DiagBuffer>) -> StrView {
    StrView { ptr: b.ptr as *const u8, len: b.len }
}

module compiler.hir.hir
pub struct HirItem { pub id: u32 }

// Type system data model, type interning, constant evaluation model, and THIR maps.
// Port of bootstrap/axiom0/src/types/types.h, interner.c, and const/eval.h.
module compiler.types.types

use std.core.host.heap_alloc
use std.core.host.heap_free
use compiler.kernel.arena.Arena
use compiler.kernel.arena.ArenaChunk
use compiler.kernel.arena.arena_new
use compiler.kernel.arena.arena_alloc_raw
use compiler.kernel.arena.arena_destroy
use compiler.kernel.id.StrId
use compiler.kernel.id.SymbolId
use compiler.kernel.id.TypeId
use compiler.kernel.interner.StrInterner
use compiler.kernel.interner.StrView
use compiler.kernel.interner.interner_get
use compiler.source.span.Span

use compiler.hir.hir.HirItem

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn wrapping_add_u64(a: u64, b: u64) -> u64 {
    let a_lo = a & 0xFFFFFFFFu64;
    let b_lo = b & 0xFFFFFFFFu64;
    let sum_lo = a_lo + b_lo;
    let carry = sum_lo >> 32u64;
    let a_hi = a >> 32u64;
    let b_hi = b >> 32u64;
    let sum_hi = (a_hi + b_hi + carry) & 0xFFFFFFFFu64;
    (sum_hi << 32u64) | (sum_lo & 0xFFFFFFFFu64)
}
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

