pub const TY_UNIT: u8 = 1u8;
pub const TY_NEVER: u8 = 2u8;
pub const TY_BOOL: u8 = 3u8;
pub const TY_CHAR: u8 = 4u8;
pub const TY_I8: u8 = 5u8;
pub const TY_I16: u8 = 6u8;
pub const TY_I32: u8 = 7u8;
pub const TY_I64: u8 = 8u8;
pub const TY_ISIZE: u8 = 9u8;
pub const TY_U8: u8 = 10u8;
pub const TY_U16: u8 = 11u8;
pub const TY_U32: u8 = 12u8;
pub const TY_U64: u8 = 13u8;
pub const TY_USIZE: u8 = 14u8;
pub const TY_FN: u8 = 15u8;
pub const TY_STR: u8 = 16u8;
pub const TY_SLICE: u8 = 17u8;
pub const TY_INT_VAR: u8 = 18u8;
pub const TY_PTR: u8 = 19u8;
pub const TY_ARRAY: u8 = 20u8;
pub const TY_TUPLE: u8 = 21u8;
pub const TY_STRUCT: u8 = 22u8;
pub const TY_BUILTIN_LEN: u8 = 23u8;
pub const TY_ENUM: u8 = 24u8;
pub const TY_BUILTIN_PRINT: u8 = 25u8;
pub const TY_BUILTIN_PRINT_INT: u8 = 26u8;
pub const TY_BUILTIN_DROP: u8 = 27u8;
pub const TY_VIEW: u8 = 28u8;
pub const TY_MUT_VIEW: u8 = 29u8;
pub const TY_PARAM: u8 = 30u8;
pub const TY_VAR: u8 = 31u8;
pub const TY_CLOSURE: u8 = 32u8;
pub const TY_BUILTIN_ADDRESS_OF: u8 = 33u8;
pub const TY_BUILTIN_ADDRESS_OF_MUT: u8 = 34u8;
pub const TY_BUILTIN_IS_NULL: u8 = 35u8;
pub const TY_BUILTIN_PTR_ADD: u8 = 36u8;
pub const TY_BUILTIN_PTR_SUB: u8 = 37u8;
pub const TY_BUILTIN_SIZE_OF: u8 = 38u8;
pub const TY_BUILTIN_ALIGN_OF: u8 = 39u8;
pub const TY_BUILTIN_NEEDS_DROP: u8 = 40u8;
pub const TY_BUILTIN_DROP_IN_PLACE: u8 = 41u8;
pub const TY_BUILTIN_FORGET: u8 = 42u8;
pub const TY_BUILTIN_PTR_COPY: u8 = 43u8;
pub const TY_BUILTIN_PTR_COPY_NONOVERLAPPING: u8 = 44u8;
pub const TY_BUILTIN_PTR_WRITE_BYTES: u8 = 45u8;
pub const TY_BUILTIN_NULL: u8 = 46u8;
pub const TY_BUILTIN_NULL_MUT: u8 = 47u8;

pub const CAP_COPY: u8 = 0u8;
pub const CAP_VIEW: u8 = 1u8;
pub const CAP_MUT_VIEW: u8 = 2u8;
pub const CAP_MOVE: u8 = 3u8;

pub const CONST_INT: u8 = 0u8;
pub const CONST_STR: u8 = 1u8;
pub const CONST_AGGREGATE: u8 = 2u8;
pub const CONST_UNIT: u8 = 3u8;
pub const CONST_ERROR: u8 = 4u8;

const MAP_INIT_CAP: usize = 16;
const MAP_LOAD_NUM: usize = 7;
const MAP_LOAD_DEN: usize = 10;
const SLOT_EMPTY: u8 = 0u8;
const SLOT_OCCUPIED: u8 = 1u8;
const INTERNER_INIT_CAP: usize = 64;

pub struct ClosureCapture {
    pub sym: SymbolId,
    pub mode: u8,
    pub ty: TypeId,
}

pub struct AxType {
    pub kind: u8,
    pub is_unsafe: bool,
    pub is_mut: bool,
    pub is_repr_c: bool,
    pub abi: StrId,
    pub name: StrId,
    pub param_index: u32,
    pub var_id: u32,
    pub closure_id: u32,
    pub fn_sym: u32,
    pub pointee: TypeId,
    pub elem: TypeId,
    pub ret_type: TypeId,
    pub fn_type: TypeId,
    pub array_len: u64,
    pub param_types: *mut TypeId,
    pub param_count: usize,
    pub fields: *mut TypeId,
    pub field_count: usize,
    pub def: *const HirItem,
    pub args: *mut TypeId,
    pub arg_count: usize,
    pub variant_fields: *mut *mut TypeId,
    pub variant_field_counts: *mut usize,
    pub variant_count: usize,
    pub captures: *mut ClosureCapture,
    pub capture_count: usize,
}

