    x64_emit_sz_prefix(mut_view(*sec), sz);
    x64_emit_rex_rr(mut_view(*sec), sz, REG_NONE, src);
    x64_emit8(mut_view(*sec), if sz == 1u8 { 0xF6u8 } else { 0xF7u8 });
    x64_emit8(mut_view(*sec), 0xE0u8 | x64_reg_low3(src));
}

