    x64_emit8(mut_view(*sec), 0x0Fu8);
    x64_emit8(mut_view(*sec), 0xAFu8);
    x64_emit_modrm_sib_disp(mut_view(*sec), dst, src);
}

pub fn ax_x64_imul_rm(sec: mut_view<Section>, sz: u8, dst: i32, src: X64Mem) {
    x64_imul_rm(sec, sz, dst, src);
}

