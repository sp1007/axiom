pub fn x64_call_r(sec: mut_view<Section>, dst: i32) {
    x64_emit_rex_rr(mut_view(*sec), 8u8, REG_NONE, dst);
    x64_emit8(mut_view(*sec), 0xFFu8);
    x64_emit8(mut_view(*sec), 0xD0u8 | x64_reg_low3(dst));
