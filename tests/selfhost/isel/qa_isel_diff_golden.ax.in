const ISEL_GOLDEN_OFF: [9]u32 = [0u32, 225u32, 445u32, 1224u32, 1804u32, 8470u32, 13313u32, 13538u32, 13758u32];

const OV_MSG_BYTES: [20]u8 = [
    97u8, 114u8, 105u8, 116u8, 104u8, 109u8, 101u8, 116u8, 105u8, 99u8, 32u8,
    111u8, 118u8, 101u8, 114u8, 102u8, 108u8, 111u8, 119u8, 0u8,
];

fn get_golden_sv(a: mut_view<Arena>, blob_idx: usize) -> StrView {
    let start = ISEL_GOLDEN_OFF[blob_idx] as usize;
    let end = ISEL_GOLDEN_OFF[blob_idx + 1] as usize;
    let n = end - start;
    let dst = arena_alloc_raw(a, n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe {
            *(dst + i) = ISEL_GOLDEN_DATA[start + i];
        }
        i = i + 1;
    }
    unsafe {
        *(dst + n) = 0u8;
    }
    StrView { ptr: dst as *const u8, len: n }
}

fn bytes_equal(a: *const u8, a_len: usize, b: *const u8, b_len: usize) -> bool {
    if a_len != b_len {
        return false;
    }
    let mut i: usize = 0;
    while i < a_len {
        if (unsafe { *(a + i) }) != (unsafe { *(b + i) }) {
            return false;
        }
        i = i + 1;
    }
    true
}

unsafe fn alloc_lir_body(
    a: mut_view<Arena>,
    slot_count: usize,
    vreg_count: usize,
    bb_count: usize
) -> *mut LirBody {
    let body = lir_body_new(mut_view(*a));
    if slot_count > 0 {
        let slots = arena_alloc_raw(mut_view(*a), slot_count * size_of<LirStackSlot>(), align_of<LirStackSlot>()) as *mut LirStackSlot;
        let mut s: usize = 0;
        while s < slot_count {
            let sp = lir_slot_at(slots, s);
            (*sp).ty.v = 0u32;
            (*sp).is_const = false;
            s = s + 1;
        }
        (*body).slots = slots;
        (*body).slot_count = slot_count;
    }
    if vreg_count > 0 {
        let vregs = arena_alloc_raw(mut_view(*a), vreg_count * size_of<LirVReg>(), align_of<LirVReg>()) as *mut LirVReg;
        let mut v: usize = 0;
        while v < vreg_count {
            let vp = lir_vreg_at(vregs, v);
            (*vp).ty.v = 0u32;
            v = v + 1;
        }
        (*body).vregs = vregs;
        (*body).vreg_count = vreg_count;
    }
    if bb_count > 0 {
        let bbs = arena_alloc_raw(mut_view(*a), bb_count * size_of<LirBb>(), align_of<LirBb>()) as *mut LirBb;
        let mut b: usize = 0;
        while b < bb_count {
            let bp = lir_bb_at(bbs, b);
            lir_bb_reset(mut_view(*bp), b as u32);
            lir_term_reset(mut_view((*bp).term), LIR_TERM_UNREACHABLE);
            b = b + 1;
        }
        (*body).bbs = bbs;
        (*body).bb_count = bb_count;
    }
    (*body).frame_req.max_outgoing_args_bytes = 32u32;
    (*body).frame_req.requires_16_byte_alignment = true;
    body
}

unsafe fn alloc_bb_insts(a: mut_view<Arena>, body: *mut LirBody, bb_idx: usize, count: usize) -> *mut LirInst {
    let bp = lir_bb_at((*body).bbs, bb_idx);
    if count == 0 {
        (*bp).insts = 0 as *mut LirInst;
        (*bp).inst_count = 0;
        return 0 as *mut LirInst;
    }
    let insts = arena_alloc_raw(mut_view(*a), count * size_of<LirInst>(), align_of<LirInst>()) as *mut LirInst;
    (*bp).insts = insts;
    (*bp).inst_count = count;
    insts
}

unsafe fn set_const(insts: *mut LirInst, vregs: *mut LirVReg, idx: usize, dst: u32, ty: u32, val: u64) {
    (*lir_vreg_at(vregs, dst as usize)).ty.v = ty;
    let ip = lir_inst_at(insts, idx);
    lir_inst_reset(mut_view(*ip), LIR_INST_CONST);
    (*ip).dest.v = dst;
    (*ip).const_val = val;
}

unsafe fn set_stack_addr(insts: *mut LirInst, vregs: *mut LirVReg, idx: usize, dst: u32, ptr_ty: u32, slot: u32) {
    (*lir_vreg_at(vregs, dst as usize)).ty.v = ptr_ty;
    let ip = lir_inst_at(insts, idx);
    lir_inst_reset(mut_view(*ip), LIR_INST_STACK_ADDR);
    (*ip).dest.v = dst;
    (*ip).slot.v = slot;
}

unsafe fn set_load(insts: *mut LirInst, vregs: *mut LirVReg, idx: usize, dst: u32, ty: u32, ptr_v: u32) {
    (*lir_vreg_at(vregs, dst as usize)).ty.v = ty;
    let ip = lir_inst_at(insts, idx);
    lir_inst_reset(mut_view(*ip), LIR_INST_LOAD);
    (*ip).dest.v = dst;
    (*ip).ptr.v = ptr_v;
    (*ip).ty.v = ty;
}

unsafe fn set_store(insts: *mut LirInst, idx: usize, ptr_v: u32, val_v: u32) {
    let ip = lir_inst_at(insts, idx);
    lir_inst_reset(mut_view(*ip), LIR_INST_STORE);
    (*ip).ptr.v = ptr_v;
    (*ip).val.v = val_v;
}

unsafe fn set_bin(insts: *mut LirInst, vregs: *mut LirVReg, idx: usize, op: u8, dst: u32, ty: u32, a: u32, b: u32) {
    (*lir_vreg_at(vregs, dst as usize)).ty.v = ty;
    let ip = lir_inst_at(insts, idx);
    lir_inst_reset(mut_view(*ip), op);
    (*ip).dest.v = dst;
    (*ip).lhs.v = a;
    (*ip).rhs.v = b;
    (*ip).bit_width = 32u32;
}

unsafe fn set_un(insts: *mut LirInst, vregs: *mut LirVReg, idx: usize, op: u8, dst: u32, ty: u32, src: u32) {
    (*lir_vreg_at(vregs, dst as usize)).ty.v = ty;
    let ip = lir_inst_at(insts, idx);
    lir_inst_reset(mut_view(*ip), op);
    (*ip).dest.v = dst;
    (*ip).operand.v = src;
}

unsafe fn set_assert_term(body: *mut LirBody, bb_idx: usize, cond_v: u32, target_bb: u32) {
    let bp = lir_bb_at((*body).bbs, bb_idx);
    lir_term_reset(mut_view((*bp).term), LIR_TERM_ASSERT);
    (*bp).term.cond.v = cond_v;
    (*bp).term.assert_target.v = target_bb;
    (*bp).term.msg_ptr = address_of(OV_MSG_BYTES[0]);
    (*bp).term.msg_len = 19;
}

unsafe fn set_return_term(body: *mut LirBody, bb_idx: usize) {
    let bp = lir_bb_at((*body).bbs, bb_idx);
    lir_term_reset(mut_view((*bp).term), LIR_TERM_RETURN);
}

unsafe fn build_golden_lir_case(a: mut_view<Arena>, ti_ptr: *mut TypeInterner, case_idx: usize) -> *mut LirBody {
    let i32_v = (*ti_ptr).t_i32.v;
    let bool_v = (*ti_ptr).t_bool.v;
    let never_v = (*ti_ptr).t_never.v;
    let ptr_v = (*ti_ptr).t_u64.v;

    if case_idx == 0 {
        // vs1_return.ax: slot0=i32, slot1=never
        let body = alloc_lir_body(mut_view(*a), 2, 2, 1);
        (*lir_slot_at((*body).slots, 0)).ty.v = i32_v;
        (*lir_slot_at((*body).slots, 1)).ty.v = never_v;
        let insts = alloc_bb_insts(mut_view(*a), body, 0, 3);
        let vregs = (*body).vregs;
        set_const(insts, vregs, 0, 0u32, i32_v, 42u64);
        set_stack_addr(insts, vregs, 1, 1u32, ptr_v, 0u32);
        set_store(insts, 2, 1u32, 0u32);
        set_return_term(body, 0);
        return body;
    }

    if case_idx == 1 {
        // vs1_locals.ax: slot0..2=i32, slot3=never
        let body = alloc_lir_body(mut_view(*a), 4, 8, 1);
        (*lir_slot_at((*body).slots, 0)).ty.v = i32_v;
        (*lir_slot_at((*body).slots, 1)).ty.v = i32_v;
        (*lir_slot_at((*body).slots, 2)).ty.v = i32_v;
        (*lir_slot_at((*body).slots, 3)).ty.v = never_v;
        let insts = alloc_bb_insts(mut_view(*a), body, 0, 11);
        let vregs = (*body).vregs;
        set_const(insts, vregs, 0, 0u32, i32_v, 42u64);
        set_stack_addr(insts, vregs, 1, 1u32, ptr_v, 1u32);
        set_store(insts, 2, 1u32, 0u32);
        set_stack_addr(insts, vregs, 3, 2u32, ptr_v, 1u32);
        set_load(insts, vregs, 4, 3u32, i32_v, 2u32);
        set_stack_addr(insts, vregs, 5, 4u32, ptr_v, 2u32);
        set_store(insts, 6, 4u32, 3u32);
        set_stack_addr(insts, vregs, 7, 5u32, ptr_v, 2u32);
        set_load(insts, vregs, 8, 6u32, i32_v, 5u32);
        set_stack_addr(insts, vregs, 9, 7u32, ptr_v, 0u32);
        set_store(insts, 10, 7u32, 6u32);
        set_return_term(body, 0);
        return body;
    }

    if case_idx == 2 {
        // vs1_arith.ax: 17 slots, 69 vregs, 7 bbs
        let body = alloc_lir_body(mut_view(*a), 17, 69, 7);
        let mut s: usize = 0;
        while s <= 6 {
            (*lir_slot_at((*body).slots, s)).ty.v = i32_v;
            s = s + 1;
        }
        while s <= 10 {
            (*lir_slot_at((*body).slots, s)).ty.v = bool_v;
            s = s + 1;
        }
        (*lir_slot_at((*body).slots, 11)).ty.v = i32_v;
        (*lir_slot_at((*body).slots, 12)).ty.v = i32_v;
        (*lir_slot_at((*body).slots, 13)).ty.v = bool_v;
        (*lir_slot_at((*body).slots, 14)).ty.v = bool_v;
        (*lir_slot_at((*body).slots, 15)).ty.v = i32_v;
        (*lir_slot_at((*body).slots, 16)).ty.v = never_v;

        let vregs = (*body).vregs;

        // bb0 (27 insts)
        let i0 = alloc_bb_insts(mut_view(*a), body, 0, 27);
        set_const(i0, vregs, 0, 0u32, i32_v, 10u64);
        set_stack_addr(i0, vregs, 1, 1u32, ptr_v, 1u32);
        set_store(i0, 2, 1u32, 0u32);
        set_stack_addr(i0, vregs, 3, 2u32, ptr_v, 1u32);
        set_load(i0, vregs, 4, 3u32, i32_v, 2u32);
        set_stack_addr(i0, vregs, 5, 4u32, ptr_v, 2u32);
        set_store(i0, 6, 4u32, 3u32);
        set_const(i0, vregs, 7, 5u32, i32_v, 3u64);
        set_stack_addr(i0, vregs, 8, 6u32, ptr_v, 3u32);
        set_store(i0, 9, 6u32, 5u32);
        set_stack_addr(i0, vregs, 10, 7u32, ptr_v, 3u32);
        set_load(i0, vregs, 11, 8u32, i32_v, 7u32);
        set_stack_addr(i0, vregs, 12, 9u32, ptr_v, 4u32);
        set_store(i0, 13, 9u32, 8u32);
        set_stack_addr(i0, vregs, 14, 10u32, ptr_v, 4u32);
        set_load(i0, vregs, 15, 11u32, i32_v, 10u32);
        set_const(i0, vregs, 16, 12u32, i32_v, 2u64);
        set_bin(i0, vregs, 17, LIR_INST_SMUL_OVERFLOW, 13u32, bool_v, 11u32, 12u32);
        set_stack_addr(i0, vregs, 18, 14u32, ptr_v, 7u32);
        set_store(i0, 19, 14u32, 13u32);
        set_stack_addr(i0, vregs, 20, 15u32, ptr_v, 7u32);
        set_load(i0, vregs, 21, 16u32, bool_v, 15u32);
        set_un(i0, vregs, 22, LIR_INST_NOT, 17u32, bool_v, 16u32);
        set_stack_addr(i0, vregs, 23, 18u32, ptr_v, 8u32);
        set_store(i0, 24, 18u32, 17u32);
        set_stack_addr(i0, vregs, 25, 19u32, ptr_v, 8u32);
        set_load(i0, vregs, 26, 20u32, bool_v, 19u32);
        set_assert_term(body, 0, 20u32, 1u32);

        // bb1 (20 insts)
        let i1 = alloc_bb_insts(mut_view(*a), body, 1, 20);
        set_stack_addr(i1, vregs, 0, 21u32, ptr_v, 4u32);
        set_load(i1, vregs, 1, 22u32, i32_v, 21u32);
        set_const(i1, vregs, 2, 23u32, i32_v, 2u64);
        set_bin(i1, vregs, 3, LIR_INST_MUL, 24u32, i32_v, 22u32, 23u32);
        set_stack_addr(i1, vregs, 4, 25u32, ptr_v, 6u32);
        set_store(i1, 5, 25u32, 24u32);
        set_stack_addr(i1, vregs, 6, 26u32, ptr_v, 2u32);
        set_load(i1, vregs, 7, 27u32, i32_v, 26u32);
        set_stack_addr(i1, vregs, 8, 28u32, ptr_v, 6u32);
        set_load(i1, vregs, 9, 29u32, i32_v, 28u32);
        set_bin(i1, vregs, 10, LIR_INST_SADD_OVERFLOW, 30u32, bool_v, 27u32, 29u32);
        set_stack_addr(i1, vregs, 11, 31u32, ptr_v, 9u32);
        set_store(i1, 12, 31u32, 30u32);
        set_stack_addr(i1, vregs, 13, 32u32, ptr_v, 9u32);
        set_load(i1, vregs, 14, 33u32, bool_v, 32u32);
        set_un(i1, vregs, 15, LIR_INST_NOT, 34u32, bool_v, 33u32);
        set_stack_addr(i1, vregs, 16, 35u32, ptr_v, 10u32);
        set_store(i1, 17, 35u32, 34u32);
        set_stack_addr(i1, vregs, 18, 36u32, ptr_v, 10u32);
        set_load(i1, vregs, 19, 37u32, bool_v, 36u32);
        set_assert_term(body, 1, 37u32, 3u32);

        // bb3 (24 insts)
        let i3 = alloc_bb_insts(mut_view(*a), body, 3, 24);
        set_stack_addr(i3, vregs, 0, 38u32, ptr_v, 2u32);
        set_load(i3, vregs, 1, 39u32, i32_v, 38u32);
        set_stack_addr(i3, vregs, 2, 40u32, ptr_v, 6u32);
        set_load(i3, vregs, 3, 41u32, i32_v, 40u32);
        set_bin(i3, vregs, 4, LIR_INST_ADD, 42u32, i32_v, 39u32, 41u32);
        set_stack_addr(i3, vregs, 5, 43u32, ptr_v, 5u32);
        set_store(i3, 6, 43u32, 42u32);
        set_stack_addr(i3, vregs, 7, 44u32, ptr_v, 5u32);
        set_load(i3, vregs, 8, 45u32, i32_v, 44u32);
        set_stack_addr(i3, vregs, 9, 46u32, ptr_v, 11u32);
        set_store(i3, 10, 46u32, 45u32);
        set_stack_addr(i3, vregs, 11, 47u32, ptr_v, 11u32);
        set_load(i3, vregs, 12, 48u32, i32_v, 47u32);
        set_const(i3, vregs, 13, 49u32, i32_v, 4u64);
        set_bin(i3, vregs, 14, LIR_INST_SSUB_OVERFLOW, 50u32, bool_v, 48u32, 49u32);
        set_stack_addr(i3, vregs, 15, 51u32, ptr_v, 13u32);
        set_store(i3, 16, 51u32, 50u32);
        set_stack_addr(i3, vregs, 17, 52u32, ptr_v, 13u32);
        set_load(i3, vregs, 18, 53u32, bool_v, 52u32);
        set_un(i3, vregs, 19, LIR_INST_NOT, 54u32, bool_v, 53u32);
        set_stack_addr(i3, vregs, 20, 55u32, ptr_v, 14u32);
        set_store(i3, 21, 55u32, 54u32);
        set_stack_addr(i3, vregs, 22, 56u32, ptr_v, 14u32);
        set_load(i3, vregs, 23, 57u32, bool_v, 56u32);
        set_assert_term(body, 3, 57u32, 5u32);

        // bb5 (14 insts)
        let i5 = alloc_bb_insts(mut_view(*a), body, 5, 14);
        set_stack_addr(i5, vregs, 0, 58u32, ptr_v, 11u32);
        set_load(i5, vregs, 1, 59u32, i32_v, 58u32);
        set_const(i5, vregs, 2, 60u32, i32_v, 4u64);
        set_bin(i5, vregs, 3, LIR_INST_SUB, 61u32, i32_v, 59u32, 60u32);
        set_stack_addr(i5, vregs, 4, 62u32, ptr_v, 12u32);
        set_store(i5, 5, 62u32, 61u32);
        set_stack_addr(i5, vregs, 6, 63u32, ptr_v, 12u32);
        set_load(i5, vregs, 7, 64u32, i32_v, 63u32);
        set_stack_addr(i5, vregs, 8, 65u32, ptr_v, 15u32);
        set_store(i5, 9, 65u32, 64u32);
        set_stack_addr(i5, vregs, 10, 66u32, ptr_v, 15u32);
        set_load(i5, vregs, 11, 67u32, i32_v, 66u32);
        set_stack_addr(i5, vregs, 12, 68u32, ptr_v, 0u32);
        set_store(i5, 13, 68u32, 67u32);
        set_return_term(body, 5);

        return body;
    }

    // case_idx == 3: main_42.ax (slot0=i32)
    let body = alloc_lir_body(mut_view(*a), 1, 2, 1);
    (*lir_slot_at((*body).slots, 0)).ty.v = i32_v;
    let insts = alloc_bb_insts(mut_view(*a), body, 0, 3);
    let vregs = (*body).vregs;
    set_const(insts, vregs, 0, 0u32, i32_v, 42u64);
    set_stack_addr(insts, vregs, 1, 1u32, ptr_v, 0u32);
    set_store(insts, 2, 1u32, 0u32);
    set_return_term(body, 0);
    body
}

fn run_isel_golden_case(
    lir_arena: mut_view<Arena>,
    scratch: mut_view<Arena>,
    ti_ptr: *mut TypeInterner,
    fn_ty_ptr: *const AxType,
    mi_out: mut_view<DiagBuffer>,
    mc_out: mut_view<DiagBuffer>,
    case_idx: usize
) -> i32 {
    mi_out.len = 0;
    mc_out.len = 0;

    let base_blob = case_idx * 2;
    let exp_mi = get_golden_sv(mut_view(*scratch), base_blob);
    let exp_mc = get_golden_sv(mut_view(*scratch), base_blob + 1);

    let lir_body = unsafe { build_golden_lir_case(mut_view(*lir_arena), ti_ptr, case_idx) };
    lir_lower_win64_abi(lir_body, ti_ptr, fn_ty_ptr);

    let mi_body = x64_isel_in_arena(
        mut_view(*lir_arena),
        unsafe { view(*lir_body) },
        unsafe { view(*ti_ptr) }
    );
    x64_mi_print(unsafe { view(*mi_body) }, mut_view(*mi_out));

    let layout = x64_frame_lower_in_arena(
        mut_view(*lir_arena),
        unsafe { mut_view(*mi_body) },
        unsafe { view(*lir_body) },
        unsafe { view(*ti_ptr) }
    );
    if x64_verify_checked(unsafe { view(*mi_body) }, view(layout)) != X64_VERIFY_OK {
        arena_reset(mut_view(*lir_arena));
        arena_reset(mut_view(*scratch));
        return 250 + (case_idx as i32);
    }

    let mut obj = objmodel_new();
    let sid = objmodel_add_section_str(mut_view(obj), ".text", SEC_CODE, SEC_FLAG_EXEC | SEC_FLAG_READ, 16u32);
    let sec = objmodel_get_section_mut(mut_view(obj), sid);
    x64_emit_mi_body_mc(unsafe { mut_view(*sec) }, unsafe { view(*mi_body) }, view(layout));
    x64_dump_mc_hex(unsafe { view(*sec) }, mut_view(*mc_out));
    objmodel_free(mut_view(obj));

    let mut rc: i32 = 0;
    if !bytes_equal(mi_out.ptr as *const u8, mi_out.len, exp_mi.ptr, exp_mi.len) {
        rc = 300 + (case_idx as i32);
    } else if !bytes_equal(mc_out.ptr as *const u8, mc_out.len, exp_mc.ptr, exp_mc.len) {
        rc = 400 + (case_idx as i32);
    }

    arena_reset(mut_view(*lir_arena));
    arena_reset(mut_view(*scratch));
    rc
}

pub fn main() -> i32 {
    let mut perm_arena = arena_with_chunk_size(131072);
    let _ = arena_alloc_raw(mut_view(perm_arena), 16, 8);
    let mut lir_arena = arena_with_chunk_size(131072);
    let _ = arena_alloc_raw(mut_view(lir_arena), 16, 8);
    let mut scratch = arena_with_chunk_size(65536);
    let _ = arena_alloc_raw(mut_view(scratch), 16, 8);

    let ti_ptr = arena_alloc_raw(mut_view(perm_arena), size_of<TypeInterner>(), align_of<TypeInterner>()) as *mut TypeInterner;
    unsafe {
        type_interner_init(mut_view(*ti_ptr));
    }
    let i32_v = unsafe { (*ti_ptr).t_i32.v };
    let fn_tid = unsafe { intern_fn_ty(mut_view(*ti_ptr), false, StrId { v: 0u32 }, 0 as *mut TypeId, 0, TypeId { v: i32_v }) };
    let fn_ty_ptr = unsafe { type_get(view(*ti_ptr), fn_tid) as *const AxType };

    let mut mi_out = diag_buf_new();
    mi_out.ptr = arena_alloc_raw(mut_view(perm_arena), 65536, 1);
    mi_out.cap = 65536;
    let mut mc_out = diag_buf_new();
    mc_out.ptr = arena_alloc_raw(mut_view(perm_arena), 65536, 1);
    mc_out.cap = 65536;

    let mut idx: usize = 0;
    while idx < 4 {
        let rc = run_isel_golden_case(
            mut_view(lir_arena),
            mut_view(scratch),
            ti_ptr,
            fn_ty_ptr,
            mut_view(mi_out),
            mut_view(mc_out),
            idx
        );
        if rc != 0 {
            return rc;
        }
        idx = idx + 1;
    }

    unsafe {
        type_interner_free(mut_view(*ti_ptr));
    }
    arena_destroy(mut_view(scratch));
    arena_destroy(mut_view(lir_arena));
    arena_destroy(mut_view(perm_arena));
    print("OK x64 Isel & Frame Differential Golden (4 cases)\n");
    0
}
