pub use compiler.obj.coff.AX_RELOC_X86_64_PC32
pub use compiler.obj.coff.AX_RELOC_X86_64_32
pub use compiler.obj.coff.AX_RELOC_X86_64_64
pub use compiler.obj.coff.AX_RELOC_X86_64_GOT32
pub use compiler.obj.coff.AX_RELOC_X86_64_PLT32

pub use compiler.obj.coff.SYM_LOCAL
pub use compiler.obj.coff.SYM_GLOBAL
pub use compiler.obj.coff.SYM_EXTERNAL
pub use compiler.obj.coff.AX_SYM_LOCAL
pub use compiler.obj.coff.AX_SYM_GLOBAL
pub use compiler.obj.coff.AX_SYM_EXTERNAL

use compiler.obj.coff.section_add_byte
use compiler.obj.coff.section_add_bytes
