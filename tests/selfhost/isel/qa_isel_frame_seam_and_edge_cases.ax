pub fn x64_call_sym(sec: mut_view<Section>, sym: SymbolId) {
    x64_emit8(mut_view(*sec), 0xE8u8);
    let reloc_off = sec.bytes_len as u32;
    section_add_reloc(mut_view(*sec), reloc_off, AX_RELOC_X86_64_PC32, sym, -4i64);
    x64_emit32(mut_view(*sec), 0u32);
}

