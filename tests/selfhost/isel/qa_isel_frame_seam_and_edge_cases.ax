pub const TY_BUILTIN_ADDRESS_OF_MUT: u8 = 34u8;
pub const TY_BUILTIN_IS_NULL: u8 = 35u8;
pub const TY_BUILTIN_PTR_ADD: u8 = 36u8;
pub const TY_BUILTIN_PTR_SUB: u8 = 37u8;
