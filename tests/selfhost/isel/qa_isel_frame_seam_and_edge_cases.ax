use compiler.obj.coff.section_add_reloc
use compiler.obj.coff.objmodel_find_symbol
use compiler.obj.coff.objmodel_find_symbol_str
use compiler.obj.coff.objmodel_add_symbol
use compiler.obj.coff.objmodel_add_symbol_str
use compiler.obj.coff.coff_write_u32_le

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

// =============================================================================
// 1. x86-64 General-Purpose Registers (ax_x64_reg_t)
// =============================================================================

pub const REG_RAX: i32 = 0;
pub const REG_RCX: i32 = 1;
pub const REG_RDX: i32 = 2;
pub const REG_RBX: i32 = 3;
pub const REG_RSP: i32 = 4;
pub const REG_RBP: i32 = 5;
pub const REG_RSI: i32 = 6;
pub const REG_RDI: i32 = 7;
pub const REG_R8: i32 = 8;
pub const REG_R9: i32 = 9;
pub const REG_R10: i32 = 10;
pub const REG_R11: i32 = 11;
pub const REG_R12: i32 = 12;
pub const REG_R13: i32 = 13;
pub const REG_R14: i32 = 14;
pub const REG_R15: i32 = 15;
pub const REG_NONE: i32 = 255;

pub const AX_REG_RAX: i32 = 0;
pub const AX_REG_RCX: i32 = 1;
pub const AX_REG_RDX: i32 = 2;
pub const AX_REG_RBX: i32 = 3;
pub const AX_REG_RSP: i32 = 4;
pub const AX_REG_RBP: i32 = 5;
pub const AX_REG_RSI: i32 = 6;
pub const AX_REG_RDI: i32 = 7;
pub const AX_REG_R8: i32 = 8;
pub const AX_REG_R9: i32 = 9;
pub const AX_REG_R10: i32 = 10;
pub const AX_REG_R11: i32 = 11;
pub const AX_REG_R12: i32 = 12;
pub const AX_REG_R13: i32 = 13;
pub const AX_REG_R14: i32 = 14;
pub const AX_REG_R15: i32 = 15;
pub const AX_REG_NONE: i32 = 255;

pub fn x64_reg_is_none(reg: i32) -> bool {
    reg < 0 || reg > 15
}

pub fn x64_reg_is_valid(reg: i32) -> bool {
    reg >= 0 && reg <= 15
}

pub fn x64_reg_is_extended(reg: i32) -> bool {
    reg >= 8 && reg <= 15
}

pub fn x64_reg_needs_byte_rex(reg: i32) -> bool {
    reg >= 4 && reg <= 15
}

pub fn x64_reg_low3(reg: i32) -> u8 {
    if x64_reg_is_none(reg) {
        0u8
    } else {
        ((reg as u32) & 7u32) as u8
    }
}

pub fn x64_reg_name(reg: i32) -> Str {
    if reg == REG_RAX { return "rax"; }
    if reg == REG_RCX { return "rcx"; }
    if reg == REG_RDX { return "rdx"; }
    if reg == REG_RBX { return "rbx"; }
    if reg == REG_RSP { return "rsp"; }
    if reg == REG_RBP { return "rbp"; }
    if reg == REG_RSI { return "rsi"; }
    if reg == REG_RDI { return "rdi"; }
    if reg == REG_R8 { return "r8"; }
    if reg == REG_R9 { return "r9"; }
    if reg == REG_R10 { return "r10"; }
    if reg == REG_R11 { return "r11"; }
    if reg == REG_R12 { return "r12"; }
    if reg == REG_R13 { return "r13"; }
    if reg == REG_R14 { return "r14"; }
    if reg == REG_R15 { return "r15"; }
    "none"
}

pub fn x64_reg_name_sz(reg: i32, sz: u8) -> Str {
    if sz == 1u8 {
        if reg == REG_RAX { return "al"; }
        if reg == REG_RCX { return "cl"; }
        if reg == REG_RDX { return "dl"; }
        if reg == REG_RBX { return "bl"; }
        if reg == REG_RSP { return "spl"; }
        if reg == REG_RBP { return "bpl"; }
        if reg == REG_RSI { return "sil"; }
        if reg == REG_RDI { return "dil"; }
        if reg == REG_R8 { return "r8b"; }
        if reg == REG_R9 { return "r9b"; }
        if reg == REG_R10 { return "r10b"; }
        if reg == REG_R11 { return "r11b"; }
        if reg == REG_R12 { return "r12b"; }
        if reg == REG_R13 { return "r13b"; }
        if reg == REG_R14 { return "r14b"; }
        if reg == REG_R15 { return "r15b"; }
        return "none";
    }
    if sz == 2u8 {
        if reg == REG_RAX { return "ax"; }
        if reg == REG_RCX { return "cx"; }
        if reg == REG_RDX { return "dx"; }
        if reg == REG_RBX { return "bx"; }
        if reg == REG_RSP { return "sp"; }
        if reg == REG_RBP { return "bp"; }
        if reg == REG_RSI { return "si"; }
        if reg == REG_RDI { return "di"; }
        if reg == REG_R8 { return "r8w"; }
        if reg == REG_R9 { return "r9w"; }
        if reg == REG_R10 { return "r10w"; }
        if reg == REG_R11 { return "r11w"; }
        if reg == REG_R12 { return "r12w"; }
        if reg == REG_R13 { return "r13w"; }
        if reg == REG_R14 { return "r14w"; }
        if reg == REG_R15 { return "r15w"; }
        return "none";
    }
    if sz == 4u8 {
        if reg == REG_RAX { return "eax"; }
        if reg == REG_RCX { return "ecx"; }
        if reg == REG_RDX { return "edx"; }
        if reg == REG_RBX { return "ebx"; }
        if reg == REG_RSP { return "esp"; }
        if reg == REG_RBP { return "ebp"; }
        if reg == REG_RSI { return "esi"; }
        if reg == REG_RDI { return "edi"; }
        if reg == REG_R8 { return "r8d"; }
        if reg == REG_R9 { return "r9d"; }
        if reg == REG_R10 { return "r10d"; }
        if reg == REG_R11 { return "r11d"; }
        if reg == REG_R12 { return "r12d"; }
        if reg == REG_R13 { return "r13d"; }
        if reg == REG_R14 { return "r14d"; }
        if reg == REG_R15 { return "r15d"; }
        return "none";
    }
    x64_reg_name(reg)
}

// =============================================================================
// 2. x86-64 Condition Codes (ax_x64_cc_t)
// =============================================================================

pub const CC_O: u8 = 0x0u8;
pub const CC_NO: u8 = 0x1u8;
pub const CC_B: u8 = 0x2u8;
pub const CC_AE: u8 = 0x3u8;
pub const CC_E: u8 = 0x4u8;
pub const CC_NE: u8 = 0x5u8;
pub const CC_BE: u8 = 0x6u8;
pub const CC_A: u8 = 0x7u8;
pub const CC_S: u8 = 0x8u8;
pub const CC_NS: u8 = 0x9u8;
pub const CC_P: u8 = 0xAu8;
pub const CC_NP: u8 = 0xBu8;
pub const CC_L: u8 = 0xCu8;
pub const CC_GE: u8 = 0xDu8;
pub const CC_LE: u8 = 0xEu8;
pub const CC_G: u8 = 0xFu8;

// Standard mnemonic aliases
pub const CC_C: u8 = 0x2u8;
pub const CC_NAE: u8 = 0x2u8;
pub const CC_NC: u8 = 0x3u8;
pub const CC_NB: u8 = 0x3u8;
pub const CC_Z: u8 = 0x4u8;
pub const CC_NZ: u8 = 0x5u8;
pub const CC_NA: u8 = 0x6u8;
pub const CC_NBE: u8 = 0x7u8;
pub const CC_PE: u8 = 0xAu8;
pub const CC_PO: u8 = 0xBu8;
pub const CC_NGE: u8 = 0xCu8;
pub const CC_NL: u8 = 0xDu8;
pub const CC_NG: u8 = 0xEu8;
pub const CC_NLE: u8 = 0xFu8;

pub const AX_CC_O: u8 = 0x0u8;
pub const AX_CC_NO: u8 = 0x1u8;
pub const AX_CC_B: u8 = 0x2u8;
pub const AX_CC_AE: u8 = 0x3u8;
pub const AX_CC_E: u8 = 0x4u8;
pub const AX_CC_NE: u8 = 0x5u8;
pub const AX_CC_BE: u8 = 0x6u8;
pub const AX_CC_A: u8 = 0x7u8;
pub const AX_CC_S: u8 = 0x8u8;
pub const AX_CC_NS: u8 = 0x9u8;
pub const AX_CC_P: u8 = 0xAu8;
pub const AX_CC_NP: u8 = 0xBu8;
pub const AX_CC_L: u8 = 0xCu8;
pub const AX_CC_GE: u8 = 0xDu8;
pub const AX_CC_LE: u8 = 0xEu8;
pub const AX_CC_G: u8 = 0xFu8;

pub fn x64_cc_invert(cc: u8) -> u8 {
    (cc ^ 1u8) & 0xFu8
}

pub fn x64_cc_name(cc: u8) -> Str {
    let c = cc & 0xFu8;
    if c == CC_O { return "o"; }
    if c == CC_NO { return "no"; }
    if c == CC_B { return "b"; }
    if c == CC_AE { return "ae"; }
    if c == CC_E { return "e"; }
    if c == CC_NE { return "ne"; }
    if c == CC_BE { return "be"; }
    if c == CC_A { return "a"; }
    if c == CC_S { return "s"; }
    if c == CC_NS { return "ns"; }
    if c == CC_P { return "p"; }
    if c == CC_NP { return "np"; }
    if c == CC_L { return "l"; }
    if c == CC_GE { return "ge"; }
    if c == CC_LE { return "le"; }
    "g"
}

// =============================================================================
// 3. Machine IR Opcodes & Operand Kinds (matching target/x64/mir/mi.h)
// =============================================================================

pub const X64_OP_NONE: u32 = 0u32;
pub const X64_OP_REG: u32 = 1u32;
pub const X64_OP_IMM: u32 = 2u32;
pub const X64_OP_MEM: u32 = 3u32;
pub const X64_OP_FRAME: u32 = 4u32;
pub const X64_OP_SYM: u32 = 5u32;

pub const AX_X64_OP_NONE: u32 = 0u32;
pub const AX_X64_OP_REG: u32 = 1u32;
pub const AX_X64_OP_IMM: u32 = 2u32;
pub const AX_X64_OP_MEM: u32 = 3u32;
pub const AX_X64_OP_FRAME: u32 = 4u32;
pub const AX_X64_OP_SYM: u32 = 5u32;

pub const X64_MI_MOV: u32 = 0u32;
pub const X64_MI_ADD: u32 = 1u32;
pub const X64_MI_SUB: u32 = 2u32;
pub const X64_MI_IMUL: u32 = 3u32;
pub const X64_MI_MUL: u32 = 4u32;
pub const X64_MI_IDIV: u32 = 5u32;
pub const X64_MI_AND: u32 = 6u32;
pub const X64_MI_OR: u32 = 7u32;
pub const X64_MI_XOR: u32 = 8u32;
pub const X64_MI_SHL: u32 = 9u32;
pub const X64_MI_SAR: u32 = 10u32;
pub const X64_MI_SHR: u32 = 11u32;
pub const X64_MI_LEA: u32 = 12u32;
pub const X64_MI_CMP: u32 = 13u32;
pub const X64_MI_TEST: u32 = 14u32;
pub const X64_MI_JMP: u32 = 15u32;
pub const X64_MI_JCC: u32 = 16u32;
pub const X64_MI_CALL: u32 = 17u32;
pub const X64_MI_ASSERT: u32 = 18u32;
pub const X64_MI_PUSH: u32 = 19u32;
pub const X64_MI_POP: u32 = 20u32;
pub const X64_MI_SETCC: u32 = 21u32;
pub const X64_MI_RET: u32 = 22u32;

pub const AX_X64_MI_MOV: u32 = 0u32;
pub const AX_X64_MI_ADD: u32 = 1u32;
pub const AX_X64_MI_SUB: u32 = 2u32;
pub const AX_X64_MI_IMUL: u32 = 3u32;
pub const AX_X64_MI_MUL: u32 = 4u32;
pub const AX_X64_MI_IDIV: u32 = 5u32;
pub const AX_X64_MI_AND: u32 = 6u32;
pub const AX_X64_MI_OR: u32 = 7u32;
pub const AX_X64_MI_XOR: u32 = 8u32;
pub const AX_X64_MI_SHL: u32 = 9u32;
pub const AX_X64_MI_SAR: u32 = 10u32;
pub const AX_X64_MI_SHR: u32 = 11u32;
pub const AX_X64_MI_LEA: u32 = 12u32;
pub const AX_X64_MI_CMP: u32 = 13u32;
pub const AX_X64_MI_TEST: u32 = 14u32;
pub const AX_X64_MI_JMP: u32 = 15u32;
pub const AX_X64_MI_JCC: u32 = 16u32;
pub const AX_X64_MI_CALL: u32 = 17u32;
pub const AX_X64_MI_ASSERT: u32 = 18u32;
pub const AX_X64_MI_PUSH: u32 = 19u32;
pub const AX_X64_MI_POP: u32 = 20u32;
pub const AX_X64_MI_SETCC: u32 = 21u32;
pub const AX_X64_MI_RET: u32 = 22u32;

pub fn x64_mi_opcode_name(opc: u32) -> Str {
    if opc == X64_MI_MOV { return "mov"; }
    if opc == X64_MI_ADD { return "add"; }
    if opc == X64_MI_SUB { return "sub"; }
    if opc == X64_MI_IMUL { return "imul"; }
    if opc == X64_MI_MUL { return "mul"; }
    if opc == X64_MI_IDIV { return "idiv"; }
    if opc == X64_MI_AND { return "and"; }
    if opc == X64_MI_OR { return "or"; }
    if opc == X64_MI_XOR { return "xor"; }
    if opc == X64_MI_SHL { return "shl"; }
    if opc == X64_MI_SAR { return "sar"; }
    if opc == X64_MI_SHR { return "shr"; }
    if opc == X64_MI_LEA { return "lea"; }
    if opc == X64_MI_CMP { return "cmp"; }
    if opc == X64_MI_TEST { return "test"; }
    if opc == X64_MI_JMP { return "jmp"; }
    if opc == X64_MI_JCC { return "jcc"; }
    if opc == X64_MI_CALL { return "call"; }
    if opc == X64_MI_ASSERT { return "assert"; }
    if opc == X64_MI_PUSH { return "push"; }
    if opc == X64_MI_POP { return "pop"; }
    if opc == X64_MI_SETCC { return "setcc"; }
    if opc == X64_MI_RET { return "ret"; }
    "unknown"
}

// =============================================================================
// 4. Memory Addressing Model (X64Mem / ax_x64_mem_t)
// =============================================================================

@derive(Copy)
pub struct X64Mem {
    pub base: i32,
    pub index: i32,
    pub scale: u8,
    pub disp: i32,
    pub is_rip: bool,
}

pub fn x64_mem_base(base: i32) -> X64Mem {
    X64Mem {
        base: base,
        index: REG_NONE,
        scale: 1u8,
        disp: 0,
        is_rip: false,
    }
}

pub fn ax_x64_mem_base(base: i32) -> X64Mem {
    x64_mem_base(base)
}

pub fn x64_mem_base_disp(base: i32, disp: i32) -> X64Mem {
    X64Mem {
        base: base,
        index: REG_NONE,
        scale: 1u8,
        disp: disp,
        is_rip: false,
    }
}

pub fn ax_x64_mem_base_disp(base: i32, disp: i32) -> X64Mem {
    x64_mem_base_disp(base, disp)
}

pub fn x64_mem_index(base: i32, index: i32, scale: u8) -> X64Mem {
    X64Mem {
        base: base,
        index: index,
        scale: scale,
        disp: 0,
        is_rip: false,
    }
}

pub fn ax_x64_mem_index(base: i32, index: i32, scale: u8) -> X64Mem {
    x64_mem_index(base, index, scale)
}

pub fn x64_mem_index_disp(base: i32, index: i32, scale: u8, disp: i32) -> X64Mem {
    X64Mem {
        base: base,
        index: index,
        scale: scale,
        disp: disp,
        is_rip: false,
    }
}

pub fn ax_x64_mem_index_disp(base: i32, index: i32, scale: u8, disp: i32) -> X64Mem {
    x64_mem_index_disp(base, index, scale, disp)
}

pub fn x64_mem_rip(disp: i32) -> X64Mem {
    X64Mem {
        base: REG_NONE,
        index: REG_NONE,
        scale: 1u8,
        disp: disp,
        is_rip: true,
    }
}

pub fn ax_x64_mem_rip(disp: i32) -> X64Mem {
    x64_mem_rip(disp)
}

pub fn x64_mem_frame_rbp(disp: i32) -> X64Mem {
    x64_mem_base_disp(REG_RBP, disp)
}

pub fn x64_mem_stack_rsp(disp: i32) -> X64Mem {
    x64_mem_base_disp(REG_RSP, disp)
}

// =============================================================================
// 5. Binary Encoding Primitives: Prefixes, REX, ModR/M, SIB, Displacements
// =============================================================================

pub fn x64_emit8(sec: mut_view<Section>, b: u8) {
    section_add_byte(sec, b);
}

pub fn x64_emit16(sec: mut_view<Section>, w: u16) {
    x64_emit8(mut_view(*sec), (w & 0xFFu16) as u8);
    x64_emit8(mut_view(*sec), ((w >> 8) & 0xFFu16) as u8);
}

pub fn x64_emit_i16(sec: mut_view<Section>, w: i16) {
    x64_emit16(sec, w as u16);
}

pub fn x64_emit32(sec: mut_view<Section>, d: u32) {
    x64_emit8(mut_view(*sec), (d & 0xFFu32) as u8);
    x64_emit8(mut_view(*sec), ((d >> 8) & 0xFFu32) as u8);
    x64_emit8(mut_view(*sec), ((d >> 16) & 0xFFu32) as u8);
    x64_emit8(mut_view(*sec), ((d >> 24) & 0xFFu32) as u8);
}

pub fn x64_emit_i32(sec: mut_view<Section>, d: i32) {
    x64_emit32(sec, d as u32);
}

pub fn x64_emit64(sec: mut_view<Section>, q: u64) {
    x64_emit32(mut_view(*sec), (q & 0xFFFFFFFFu64) as u32);
    x64_emit32(mut_view(*sec), ((q >> 32) & 0xFFFFFFFFu64) as u32);
}

pub fn x64_emit_i64(sec: mut_view<Section>, q: i64) {
    x64_emit64(sec, q as u64);
}

pub fn x64_emit_sz_prefix(sec: mut_view<Section>, sz: u8) {
    if sz == 2u8 {
        x64_emit8(sec, 0x66u8);
    }
}

// Compute REX prefix byte for register-register / register-only instruction forms.
// Returns 0u8 when no REX prefix should be emitted.
pub fn x64_rex_rr_byte(sz: u8, reg: i32, rm: i32) -> u8 {
    let w = sz == 8u8;
    let r = x64_reg_is_extended(reg);
    let b = x64_reg_is_extended(rm);
    let force = sz == 1u8 && (x64_reg_needs_byte_rex(reg) || x64_reg_needs_byte_rex(rm));
    if w || r || b || force {
        let mut rex: u8 = 0x40u8;
        if w { rex = rex | 8u8; }
        if r { rex = rex | 4u8; }
        if b { rex = rex | 1u8; }
        rex
    } else {
        0u8
    }
}

// Compute REX prefix byte for register-memory instruction forms.
// Returns 0u8 when no REX prefix should be emitted.
pub fn x64_rex_rm_byte(sz: u8, reg: i32, m: X64Mem) -> u8 {
    let w = sz == 8u8;
    let r = x64_reg_is_extended(reg);
    let x = x64_reg_is_extended(m.index);
    let b = x64_reg_is_extended(m.base);
    let force = sz == 1u8 && x64_reg_needs_byte_rex(reg);
    if w || r || x || b || force {
        let mut rex: u8 = 0x40u8;
        if w { rex = rex | 8u8; }
        if r { rex = rex | 4u8; }
        if x { rex = rex | 2u8; }
        if b { rex = rex | 1u8; }
        rex
    } else {
        0u8
    }
}

pub fn x64_emit_rex_rr(sec: mut_view<Section>, sz: u8, reg: i32, rm: i32) {
    let rex = x64_rex_rr_byte(sz, reg, rm);
    if rex != 0u8 {
        x64_emit8(sec, rex);
    }
}

pub fn x64_emit_rex_rm(sec: mut_view<Section>, sz: u8, reg: i32, m: X64Mem) {
    let rex = x64_rex_rm_byte(sz, reg, m);
    if rex != 0u8 {
        x64_emit8(sec, rex);
    }
}

pub fn x64_modrm_byte(mod_bits: u8, reg_bits: u8, rm_bits: u8) -> u8 {
    ((mod_bits & 3u8) << 6) | ((reg_bits & 7u8) << 3) | (rm_bits & 7u8)
}

pub fn x64_sib_byte(scale: u8, index: i32, base: i32) -> u8 {
    let mut scale_bits: u8 = 0u8;
    if scale == 2u8 {
        scale_bits = 1u8;
    } else if scale == 4u8 {
        scale_bits = 2u8;
    } else if scale == 8u8 {
        scale_bits = 3u8;
    }
    let idx_bits: u8 = if x64_reg_is_none(index) { 4u8 } else { x64_reg_low3(index) };
    let base_bits: u8 = x64_reg_low3(base);
    (scale_bits << 6) | (idx_bits << 3) | base_bits
}

pub fn x64_emit_modrm_sib_disp(sec: mut_view<Section>, reg: i32, m: X64Mem) {
    let r_bits = x64_reg_low3(reg);

    if m.is_rip {
        x64_emit8(mut_view(*sec), (r_bits << 3) | 5u8);
        x64_emit_i32(mut_view(*sec), m.disp);
        return;
    }

    let base_low3 = x64_reg_low3(m.base);
    let has_sib = (!x64_reg_is_none(m.index)) || (base_low3 == 4u8);

    let mut mod_bits: u8 = 0u8;
    if m.disp == 0 && base_low3 != 5u8 {
        mod_bits = 0u8;
    } else if m.disp >= -128 && m.disp <= 127 {
        mod_bits = 1u8;
    } else {
        mod_bits = 2u8;
    }

    if has_sib {
        x64_emit8(mut_view(*sec), (mod_bits << 6) | (r_bits << 3) | 4u8);
        x64_emit8(mut_view(*sec), x64_sib_byte(m.scale, m.index, m.base));
    } else {
        x64_emit8(mut_view(*sec), (mod_bits << 6) | (r_bits << 3) | base_low3);
    }

    if mod_bits == 1u8 {
        x64_emit8(mut_view(*sec), ((m.disp as u32) & 0xFFu32) as u8);
    } else if mod_bits == 2u8 || (mod_bits == 0u8 && base_low3 == 5u8) {
        x64_emit_i32(mut_view(*sec), m.disp);
    }
}

pub fn x64_emit_op_rm(sec: mut_view<Section>, sz: u8, op8: u8, op: u8, reg: i32, rm: i32) {
    x64_emit_sz_prefix(mut_view(*sec), sz);
    x64_emit_rex_rr(mut_view(*sec), sz, reg, rm);
    x64_emit8(mut_view(*sec), if sz == 1u8 { op8 } else { op });
    x64_emit8(mut_view(*sec), 0xC0u8 | (x64_reg_low3(reg) << 3) | x64_reg_low3(rm));
}

pub fn x64_emit_op_mem(sec: mut_view<Section>, sz: u8, op8: u8, op: u8, reg: i32, m: X64Mem) {
    x64_emit_sz_prefix(mut_view(*sec), sz);
    x64_emit_rex_rm(mut_view(*sec), sz, reg, m);
    x64_emit8(mut_view(*sec), if sz == 1u8 { op8 } else { op });
    x64_emit_modrm_sib_disp(mut_view(*sec), reg, m);
}

// =============================================================================
// 6. Data Movement Instructions (MOV, MOVZX, MOVSX, LEA)
// =============================================================================

pub fn x64_mov_rr(sec: mut_view<Section>, sz: u8, dst: i32, src: i32) {
    x64_emit_op_rm(sec, sz, 0x88u8, 0x89u8, src, dst);
}

pub fn ax_x64_mov_rr(sec: mut_view<Section>, sz: u8, dst: i32, src: i32) {
    x64_mov_rr(sec, sz, dst, src);
}

pub fn x64_mov_rm(sec: mut_view<Section>, sz: u8, dst: i32, src: X64Mem) {
    x64_emit_op_mem(sec, sz, 0x8Au8, 0x8Bu8, dst, src);
}

pub fn ax_x64_mov_rm(sec: mut_view<Section>, sz: u8, dst: i32, src: X64Mem) {
    x64_mov_rm(sec, sz, dst, src);
}

pub fn x64_mov_mr(sec: mut_view<Section>, sz: u8, dst: X64Mem, src: i32) {
    x64_emit_op_mem(sec, sz, 0x88u8, 0x89u8, src, dst);
}

pub fn ax_x64_mov_mr(sec: mut_view<Section>, sz: u8, dst: X64Mem, src: i32) {
    x64_mov_mr(sec, sz, dst, src);
}

pub fn x64_mov_ri(sec: mut_view<Section>, sz: u8, dst: i32, imm: i64) {
    x64_emit_sz_prefix(mut_view(*sec), sz);
    x64_emit_rex_rr(mut_view(*sec), sz, REG_NONE, dst);
    let dst_bits = x64_reg_low3(dst);
    let uimm = imm as u64;
    if sz == 1u8 {
        x64_emit8(mut_view(*sec), 0xB0u8 + dst_bits);
        x64_emit8(mut_view(*sec), (uimm & 0xFFu64) as u8);
    } else if sz == 8u8 {
        x64_emit8(mut_view(*sec), 0xB8u8 + dst_bits);
        x64_emit64(mut_view(*sec), uimm);
    } else {
        x64_emit8(mut_view(*sec), 0xB8u8 + dst_bits);
        if sz == 2u8 {
            x64_emit16(mut_view(*sec), (uimm & 0xFFFFu64) as u16);
        } else {
            x64_emit32(mut_view(*sec), (uimm & 0xFFFFFFFFu64) as u32);
        }
    }
}

pub fn ax_x64_mov_ri(sec: mut_view<Section>, sz: u8, dst: i32, imm: i64) {
    x64_mov_ri(sec, sz, dst, imm);
}

pub fn x64_mov_mi(sec: mut_view<Section>, sz: u8, dst: X64Mem, imm: i32) {
    x64_emit_sz_prefix(mut_view(*sec), sz);
    x64_emit_rex_rm(mut_view(*sec), sz, REG_NONE, dst);
    x64_emit8(mut_view(*sec), if sz == 1u8 { 0xC6u8 } else { 0xC7u8 });
    x64_emit_modrm_sib_disp(mut_view(*sec), 0, dst);
    let uimm = imm as u32;
    if sz == 1u8 {
        x64_emit8(mut_view(*sec), (uimm & 0xFFu32) as u8);
    } else if sz == 2u8 {
        x64_emit16(mut_view(*sec), (uimm & 0xFFFFu32) as u16);
    } else {
        x64_emit32(mut_view(*sec), uimm);
    }
}

pub fn ax_x64_mov_mi(sec: mut_view<Section>, sz: u8, dst: X64Mem, imm: i32) {
    x64_mov_mi(sec, sz, dst, imm);
}

pub fn x64_movzx_rr(sec: mut_view<Section>, sz: u8, src_sz: u8, dst: i32, src: i32) {
    x64_emit_sz_prefix(mut_view(*sec), sz);
    x64_emit_rex_rr(mut_view(*sec), sz, dst, src);
    x64_emit8(mut_view(*sec), 0x0Fu8);
    x64_emit8(mut_view(*sec), if src_sz == 1u8 { 0xB6u8 } else { 0xB7u8 });
    x64_emit8(mut_view(*sec), 0xC0u8 | (x64_reg_low3(dst) << 3) | x64_reg_low3(src));
}

pub fn ax_x64_movzx_rr(sec: mut_view<Section>, sz: u8, src_sz: u8, dst: i32, src: i32) {
    x64_movzx_rr(sec, sz, src_sz, dst, src);
}

pub fn x64_movzx_rm(sec: mut_view<Section>, sz: u8, src_sz: u8, dst: i32, src: X64Mem) {
    x64_emit_sz_prefix(mut_view(*sec), sz);
    x64_emit_rex_rm(mut_view(*sec), sz, dst, src);
    x64_emit8(mut_view(*sec), 0x0Fu8);
    x64_emit8(mut_view(*sec), if src_sz == 1u8 { 0xB6u8 } else { 0xB7u8 });
    x64_emit_modrm_sib_disp(mut_view(*sec), dst, src);
}

pub fn ax_x64_movzx_rm(sec: mut_view<Section>, sz: u8, src_sz: u8, dst: i32, src: X64Mem) {
    x64_movzx_rm(sec, sz, src_sz, dst, src);
}

pub fn x64_movsx_rr(sec: mut_view<Section>, sz: u8, src_sz: u8, dst: i32, src: i32) {
    x64_emit_sz_prefix(mut_view(*sec), sz);
    x64_emit_rex_rr(mut_view(*sec), sz, dst, src);
    x64_emit8(mut_view(*sec), 0x0Fu8);
    x64_emit8(mut_view(*sec), if src_sz == 1u8 { 0xBEu8 } else { 0xBFu8 });
    x64_emit8(mut_view(*sec), 0xC0u8 | (x64_reg_low3(dst) << 3) | x64_reg_low3(src));
}

pub fn ax_x64_movsx_rr(sec: mut_view<Section>, sz: u8, src_sz: u8, dst: i32, src: i32) {
    x64_movsx_rr(sec, sz, src_sz, dst, src);
}

pub fn x64_movsx_rm(sec: mut_view<Section>, sz: u8, src_sz: u8, dst: i32, src: X64Mem) {
    x64_emit_sz_prefix(mut_view(*sec), sz);
    x64_emit_rex_rm(mut_view(*sec), sz, dst, src);
    x64_emit8(mut_view(*sec), 0x0Fu8);
    x64_emit8(mut_view(*sec), if src_sz == 1u8 { 0xBEu8 } else { 0xBFu8 });
    x64_emit_modrm_sib_disp(mut_view(*sec), dst, src);
}

pub fn ax_x64_movsx_rm(sec: mut_view<Section>, sz: u8, src_sz: u8, dst: i32, src: X64Mem) {
    x64_movsx_rm(sec, sz, src_sz, dst, src);
}

pub fn x64_lea(sec: mut_view<Section>, sz: u8, dst: i32, src: X64Mem) {
    x64_emit_op_mem(sec, sz, 0x8Du8, 0x8Du8, dst, src);
}

pub fn ax_x64_lea(sec: mut_view<Section>, sz: u8, dst: i32, src: X64Mem) {
    x64_lea(sec, sz, dst, src);
}

pub fn x64_lea_sym(sec: mut_view<Section>, dst: i32, sym: SymbolId) {
    x64_emit_rex_rr(mut_view(*sec), 8u8, REG_NONE, dst);
    x64_emit8(mut_view(*sec), 0x8Du8);
    x64_emit8(mut_view(*sec), 0x05u8 | (x64_reg_low3(dst) << 3));
    let reloc_off = sec.bytes_len as u32;
    section_add_reloc(mut_view(*sec), reloc_off, AX_RELOC_X86_64_PC32, sym, -4i64);
    x64_emit32(mut_view(*sec), 0u32);
}

pub fn ax_x64_lea_sym(sec: mut_view<Section>, dst: i32, sym: SymbolId) {
    x64_lea_sym(sec, dst, sym);
}

pub fn x64_lea_sym_disp(sec: mut_view<Section>, dst: i32, sym: SymbolId, disp: i64) {
    x64_emit_rex_rr(mut_view(*sec), 8u8, REG_NONE, dst);
    x64_emit8(mut_view(*sec), 0x8Du8);
    x64_emit8(mut_view(*sec), 0x05u8 | (x64_reg_low3(dst) << 3));
    let reloc_off = sec.bytes_len as u32;
    section_add_reloc(mut_view(*sec), reloc_off, AX_RELOC_X86_64_PC32, sym, disp - 4i64);
    x64_emit32(mut_view(*sec), 0u32);
}

pub fn ax_x64_lea_sym_disp(sec: mut_view<Section>, dst: i32, sym: SymbolId, disp: i64) {
    x64_lea_sym_disp(sec, dst, sym, disp);
}

// RIP-relative MOV load/store with PC32 symbol relocation
pub fn x64_mov_rm_sym(sec: mut_view<Section>, sz: u8, dst: i32, sym: SymbolId) {
    x64_emit_sz_prefix(mut_view(*sec), sz);
    x64_emit_rex_rr(mut_view(*sec), sz, dst, REG_NONE);
    x64_emit8(mut_view(*sec), if sz == 1u8 { 0x8Au8 } else { 0x8Bu8 });
    x64_emit8(mut_view(*sec), 0x05u8 | (x64_reg_low3(dst) << 3));
    let reloc_off = sec.bytes_len as u32;
    section_add_reloc(mut_view(*sec), reloc_off, AX_RELOC_X86_64_PC32, sym, -4i64);
    x64_emit32(mut_view(*sec), 0u32);
}

pub fn ax_x64_mov_rm_sym(sec: mut_view<Section>, sz: u8, dst: i32, sym: SymbolId) {
    x64_mov_rm_sym(sec, sz, dst, sym);
}

pub fn x64_mov_rm_sym_disp(sec: mut_view<Section>, sz: u8, dst: i32, sym: SymbolId, disp: i64) {
    x64_emit_sz_prefix(mut_view(*sec), sz);
    x64_emit_rex_rr(mut_view(*sec), sz, dst, REG_NONE);
    x64_emit8(mut_view(*sec), if sz == 1u8 { 0x8Au8 } else { 0x8Bu8 });
    x64_emit8(mut_view(*sec), 0x05u8 | (x64_reg_low3(dst) << 3));
    let reloc_off = sec.bytes_len as u32;
    section_add_reloc(mut_view(*sec), reloc_off, AX_RELOC_X86_64_PC32, sym, disp - 4i64);
    x64_emit32(mut_view(*sec), 0u32);
}

pub fn x64_mov_mr_sym(sec: mut_view<Section>, sz: u8, sym: SymbolId, src: i32) {
    x64_emit_sz_prefix(mut_view(*sec), sz);
    x64_emit_rex_rr(mut_view(*sec), sz, src, REG_NONE);
    x64_emit8(mut_view(*sec), if sz == 1u8 { 0x88u8 } else { 0x89u8 });
    x64_emit8(mut_view(*sec), 0x05u8 | (x64_reg_low3(src) << 3));
    let reloc_off = sec.bytes_len as u32;
    section_add_reloc(mut_view(*sec), reloc_off, AX_RELOC_X86_64_PC32, sym, -4i64);
    x64_emit32(mut_view(*sec), 0u32);
}

pub fn ax_x64_mov_mr_sym(sec: mut_view<Section>, sz: u8, sym: SymbolId, src: i32) {
    x64_mov_mr_sym(sec, sz, sym, src);
}

pub fn x64_mov_mr_sym_disp(sec: mut_view<Section>, sz: u8, sym: SymbolId, disp: i64, src: i32) {
    x64_emit_sz_prefix(mut_view(*sec), sz);
    x64_emit_rex_rr(mut_view(*sec), sz, src, REG_NONE);
    x64_emit8(mut_view(*sec), if sz == 1u8 { 0x88u8 } else { 0x89u8 });
    x64_emit8(mut_view(*sec), 0x05u8 | (x64_reg_low3(src) << 3));
    let reloc_off = sec.bytes_len as u32;
    section_add_reloc(mut_view(*sec), reloc_off, AX_RELOC_X86_64_PC32, sym, disp - 4i64);
    x64_emit32(mut_view(*sec), 0u32);
}

// =============================================================================
// 7. ALU Instructions (ADD, OR, AND, SUB, XOR, CMP, TEST)
// =============================================================================

fn emit_alu_ri(sec: mut_view<Section>, sz: u8, op_imm: u8, ext: u8, dst: i32, imm: i32) {
    x64_emit_sz_prefix(mut_view(*sec), sz);
    x64_emit_rex_rr(mut_view(*sec), sz, REG_NONE, dst);
    let dst_bits = x64_reg_low3(dst);
    let uimm = imm as u32;
    if sz == 1u8 {
        if dst == REG_RAX {
            x64_emit8(mut_view(*sec), op_imm);
            x64_emit8(mut_view(*sec), (uimm & 0xFFu32) as u8);
        } else {
            x64_emit8(mut_view(*sec), 0x80u8);
            x64_emit8(mut_view(*sec), 0xC0u8 | (ext << 3) | dst_bits);
            x64_emit8(mut_view(*sec), (uimm & 0xFFu32) as u8);
        }
    } else {
        if dst == REG_RAX {
            x64_emit8(mut_view(*sec), op_imm + 1u8);
        } else if imm >= -128 && imm <= 127 {
            x64_emit8(mut_view(*sec), 0x83u8);
            x64_emit8(mut_view(*sec), 0xC0u8 | (ext << 3) | dst_bits);
            x64_emit8(mut_view(*sec), (uimm & 0xFFu32) as u8);
            return;
        } else {
            x64_emit8(mut_view(*sec), 0x81u8);
            x64_emit8(mut_view(*sec), 0xC0u8 | (ext << 3) | dst_bits);
        }
        if sz == 2u8 {
            x64_emit16(mut_view(*sec), (uimm & 0xFFFFu32) as u16);
        } else {
            x64_emit32(mut_view(*sec), uimm);
        }
    }
}

