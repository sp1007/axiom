pub fn x64_test_rr(sec: mut_view<Section>, sz: u8, left: i32, right: i32) {
    x64_emit_op_rm(sec, sz, 0x84u8, 0x85u8, right, left);
}

pub fn ax_x64_test_rr(sec: mut_view<Section>, sz: u8, left: i32, right: i32) {
    x64_test_rr(sec, sz, left, right);
}

pub fn x64_test_rm(sec: mut_view<Section>, sz: u8, left: i32, right: X64Mem) {
    x64_emit_op_mem(sec, sz, 0x84u8, 0x85u8, left, right);
}

pub fn ax_x64_test_rm(sec: mut_view<Section>, sz: u8, left: i32, right: X64Mem) {
    x64_test_rm(sec, sz, left, right);
}

pub fn x64_test_ri(sec: mut_view<Section>, sz: u8, left: i32, imm: i32) {
    x64_emit_sz_prefix(mut_view(*sec), sz);
    x64_emit_rex_rr(mut_view(*sec), sz, REG_NONE, left);
    let left_bits = x64_reg_low3(left);
    let uimm = imm as u32;
    if sz == 1u8 {
        if left == REG_RAX {
            x64_emit8(mut_view(*sec), 0xA8u8);
            x64_emit8(mut_view(*sec), (uimm & 0xFFu32) as u8);
        } else {
            x64_emit8(mut_view(*sec), 0xF6u8);
            x64_emit8(mut_view(*sec), 0xC0u8 | left_bits);
            x64_emit8(mut_view(*sec), (uimm & 0xFFu32) as u8);
        }
    } else {
        if left == REG_RAX {
            x64_emit8(mut_view(*sec), 0xA9u8);
        } else {
            x64_emit8(mut_view(*sec), 0xF7u8);
            x64_emit8(mut_view(*sec), 0xC0u8 | left_bits);
        }
        if sz == 2u8 {
            x64_emit16(mut_view(*sec), (uimm & 0xFFFFu32) as u16);
        } else {
            x64_emit32(mut_view(*sec), uimm);
        }
    }
}

pub fn ax_x64_test_ri(sec: mut_view<Section>, sz: u8, left: i32, imm: i32) {
    x64_test_ri(sec, sz, left, imm);
}

