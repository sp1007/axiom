@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

unsafe fn bb_inst_at(mbb: *mut X64MIBb, idx: usize) -> *mut X64MI {
    let mut i: usize = 0;
    let mut cur = (*mbb).first_inst;
    while (cur as usize) != 0 && i < idx {
        cur = (*cur).next;
        i = i + 1;
    }
    cur
}

fn buf_matches_ascii(buf: view<DiagBuffer>, expected: view<[u8]>) -> bool {
    let n = len(expected);
    if buf.len != n {
        return false;
    }
    let mut i: usize = 0;
    while i < n {
        let a = unsafe { *(buf.ptr + i) };
        if a != expected[i] {
            return false;
        }
        i = i + 1;
    }
    true
}

// Test 1: `x64_mi_add_string` capacity growth across `0 -> 16 -> 32`
fn test_string_table_growth(a: mut_view<Arena>, ti_ptr: *mut TypeInterner) -> i32 {
    let i64_v = unsafe { (*ti_ptr).t_i64.v };
    let str_v = unsafe { (*ti_ptr).t_str.v };
    let mut sample: [8]u8 = [97u8, 98u8, 99u8, 100u8, 101u8, 102u8, 103u8, 0u8];
    let sample_ptr = unsafe { address_of_mut(sample[0]) as *const u8 };

    let lir = lir_body_new(mut_view(*a));
    let slots = arena_alloc_raw(mut_view(*a), size_of<LirStackSlot>(), align_of<LirStackSlot>()) as *mut LirStackSlot;
    let vregs = arena_alloc_raw(mut_view(*a), 20 * size_of<LirVReg>(), align_of<LirVReg>()) as *mut LirVReg;
    let bbs = arena_alloc_raw(mut_view(*a), size_of<LirBb>(), align_of<LirBb>()) as *mut LirBb;
    let insts = arena_alloc_raw(mut_view(*a), 20 * size_of<LirInst>(), align_of<LirInst>()) as *mut LirInst;

    unsafe {
        (*lir_slot_at(slots, 0)).ty.v = i64_v;
        (*lir_slot_at(slots, 0)).is_const = false;
        (*lir).slots = slots;
        (*lir).slot_count = 1;

        let mut k: usize = 0;
        while k < 20 {
            (*lir_vreg_at(vregs, k)).ty.v = str_v;
            let ip = lir_inst_at(insts, k);
            lir_inst_reset(mut_view(*ip), LIR_INST_CONST_STR);
            (*ip).dest.v = k as u32;
            (*ip).str_bytes = sample_ptr;
            (*ip).str_len = (k % 7) + 1;
            k = k + 1;
        }
        (*lir).vregs = vregs;
        (*lir).vreg_count = 20;

        let bb0 = lir_bb_at(bbs, 0);
        lir_bb_reset(mut_view(*bb0), 0u32);
        (*bb0).insts = insts;
        (*bb0).inst_count = 20;
        lir_term_reset(mut_view((*bb0).term), LIR_TERM_RETURN);
        (*lir).bbs = bbs;
        (*lir).bb_count = 1;
    }

    let mi = x64_isel(unsafe { view(*lir) }, unsafe { view(*ti_ptr) });
    if (unsafe { (*mi).string_count }) != 20 || (unsafe { (*mi).string_cap }) != 32 {
        return 101;
    }
    let mut j: usize = 0;
    while j < 20 {
        let sp = unsafe { x64_mi_str_at((*mi).strings, j) };
        if (unsafe { (*sp).sym_id }) != (100000 + j) as u32 ||
           (unsafe { (*sp).len }) != (j % 7) + 1 ||
           (unsafe { (*sp).bytes as usize }) != (sample_ptr as usize) {
            return 102;
        }
        j = j + 1;
    }

    arena_reset(mut_view(*a));
    0
}

// Test 2: Non-power-of-two small aggregate (`[6]u8`, size 6 <= 8) sret, load/store, ABI_RESULT, and TY_CLOSURE calls
fn test_non_pow2_small_aggregate_and_closure_call(a: mut_view<Arena>, ti_ptr: *mut TypeInterner) -> i32 {
    let u8_v = unsafe { (*ti_ptr).t_u8.v };
    let i64_v = unsafe { (*ti_ptr).t_i64.v };
    let arr6_id = unsafe { intern_array_ty(mut_view(*ti_ptr), TypeId { v: u8_v }, 6u64) };
    let arr6_v = arr6_id.v;

    // Create a closure type whose `ret_type` is 0 and `fn_type` is `fn() -> [6]u8`
    let fn6_id = unsafe { intern_fn_ty(mut_view(*ti_ptr), false, StrId { v: 0u32 }, 0 as *mut TypeId, 0, arr6_id) };
    let clos_raw = arena_alloc_raw(mut_view(*a), size_of<AxType>(), align_of<AxType>()) as *mut AxType;
    unsafe {
        (*clos_raw).kind = TY_CLOSURE;
        (*clos_raw).ret_type = TypeId { v: 0u32 };
        (*clos_raw).fn_type = fn6_id;
        (*clos_raw).captures = 0 as *mut ClosureCapture;
        (*clos_raw).capture_count = 0;
    }
    let clos_id = unsafe { intern_type(mut_view(*ti_ptr), view(*clos_raw)) };

    let lir = lir_body_new(mut_view(*a));
    let slots = arena_alloc_raw(mut_view(*a), size_of<LirStackSlot>(), align_of<LirStackSlot>()) as *mut LirStackSlot;
    let vregs = arena_alloc_raw(mut_view(*a), 4 * size_of<LirVReg>(), align_of<LirVReg>()) as *mut LirVReg;
    let bbs = arena_alloc_raw(mut_view(*a), size_of<LirBb>(), align_of<LirBb>()) as *mut LirBb;
    let insts = arena_alloc_raw(mut_view(*a), 5 * size_of<LirInst>(), align_of<LirInst>()) as *mut LirInst;

    unsafe {
        // Slot 0 is `[6]u8` (size 6 -> ret_in_mem = true even though size <= 8)
        (*lir_slot_at(slots, 0)).ty.v = arr6_v;
        (*lir_slot_at(slots, 0)).is_const = false;
        (*lir).slots = slots;
        (*lir).slot_count = 1;

        (*lir_vreg_at(vregs, 0)).ty.v = i64_v;  // ptr / dst_addr
        (*lir_vreg_at(vregs, 1)).ty.v = arr6_v; // 6-byte aggregate value
        (*lir_vreg_at(vregs, 2)).ty.v = i64_v;  // callee vreg
        (*lir_vreg_at(vregs, 3)).ty.v = arr6_v; // call result
        (*lir).vregs = vregs;
        (*lir).vreg_count = 4;

        // inst 0: STACK_ADDR slot 0 -> should emit MOV RAX, [frame#0 + 0] (not LEA) because size 6 is ret_in_mem
        let i0 = lir_inst_at(insts, 0);
        lir_inst_reset(mut_view(*i0), LIR_INST_STACK_ADDR);
        (*i0).dest.v = 0u32;
        (*i0).slot.v = 0u32;

        // inst 1: LOAD [6]u8 from ptr vreg 0 -> size 6 promoted to 8-byte MOV without shift truncation
        let i1 = lir_inst_at(insts, 1);
        lir_inst_reset(mut_view(*i1), LIR_INST_LOAD);
        (*i1).dest.v = 1u32;
        (*i1).ptr.v = 0u32;
        (*i1).ty.v = arr6_v;

        // inst 2: STORE [6]u8 from vreg 1 to ptr vreg 0 -> size 6 promoted to 8-byte MOV
        let i2 = lir_inst_at(insts, 2);
        lir_inst_reset(mut_view(*i2), LIR_INST_STORE);
        (*i2).ptr.v = 0u32;
        (*i2).val.v = 1u32;

        // inst 3: CALL indirect closure returning [6]u8 -> emits sret MOV RCX, [frame#1] then MOV R10, [frame#3]; CALL R10
        let i3 = lir_inst_at(insts, 3);
        lir_inst_reset(mut_view(*i3), LIR_INST_CALL);
        (*i3).callee_ty = clos_id;
        (*i3).dst_addr.v = 0u32;
        (*i3).callee_vreg.v = 2u32;

        // inst 4: ABI_RESULT INDIRECT for [6]u8 -> single 8-byte load/store pair
        let i4 = lir_inst_at(insts, 4);
        lir_inst_reset(mut_view(*i4), LIR_INST_ABI_RESULT);
        (*i4).dest.v = 3u32;
        (*i4).loc_kind = ABI_LOC_INDIRECT;
        (*i4).loc_reg_or_offset = REG_RAX as u32;

        let bb0 = lir_bb_at(bbs, 0);
        lir_bb_reset(mut_view(*bb0), 0u32);
        (*bb0).insts = insts;
        (*bb0).inst_count = 5;
        lir_term_reset(mut_view((*bb0).term), LIR_TERM_RETURN);
        (*lir).bbs = bbs;
        (*lir).bb_count = 1;
    }

    let mi = x64_isel(unsafe { view(*lir) }, unsafe { view(*ti_ptr) });
    let mbb0 = unsafe { x64_mi_bb_at((*mi).bbs, 0) };

    // Entry instruction 0 must save hidden sret pointer RCX to [frame#0 + 0]
    let m0 = unsafe { bb_inst_at(mbb0, 0) };
    if (unsafe { (*m0).opcode }) != X64_MI_MOV ||
       (unsafe { (*m0).ops[0].kind }) != X64_OP_FRAME ||
       (unsafe { (*m0).ops[1].reg }) != REG_RCX {
        return 201;
    }
    // Instruction 1 (from STACK_ADDR slot 0) must be MOV RAX, [frame#0 + 0] (not LEA)
    let m1 = unsafe { bb_inst_at(mbb0, 1) };
    if (unsafe { (*m1).opcode }) != X64_MI_MOV ||
       (unsafe { (*m1).ops[1].kind }) != X64_OP_FRAME ||
       (unsafe { (*m1).ops[1].frame.slot_id }) != 0u32 {
        return 202;
    }
    // LOAD [6]u8: insts 3..6 are MOV RAX, [frame#1]; MOV RCX, 0; MOV (sz=8) RCX, [RAX]; MOV [frame#2], RCX
    let m_load = unsafe { bb_inst_at(mbb0, 5) };
    let m_load_store = unsafe { bb_inst_at(mbb0, 6) };
    if (unsafe { (*m_load).opcode }) != X64_MI_MOV || (unsafe { (*m_load).size }) != 8u8 ||
       (unsafe { (*m_load_store).opcode }) != X64_MI_MOV {
        return 203;
    }
    // STORE [6]u8: insts 7..9 are MOV RAX, [frame#1]; MOV RCX, [frame#2]; MOV (sz=8) [RAX], RCX
    let m_store = unsafe { bb_inst_at(mbb0, 9) };
    if (unsafe { (*m_store).opcode }) != X64_MI_MOV || (unsafe { (*m_store).size }) != 8u8 {
        return 204;
    }
    // CALL closure: inst 10 is MOV RCX, [frame#1 + 0]; inst 11 is MOV R10, [frame#3 + 0]; inst 12 is CALL R10
    let m_sret = unsafe { bb_inst_at(mbb0, 10) };
    let m_call = unsafe { bb_inst_at(mbb0, 12) };
    if (unsafe { (*m_sret).opcode }) != X64_MI_MOV || (unsafe { (*m_sret).ops[0].reg }) != REG_RCX ||
       (unsafe { (*m_call).opcode }) != X64_MI_CALL || (unsafe { (*m_call).ops[0].reg }) != REG_R10 {
        return 205;
    }

    arena_reset(mut_view(*a));
    0
}

// Test 3: Signed vs unsigned sub-64-bit `LIR_INST_LOAD` sign/zero-extension (`i8`, `u8`, `i16`, `u16`, `i32`, `u32`)
fn test_sub64_load_extensions(a: mut_view<Arena>, ti_ptr: *mut TypeInterner) -> i32 {
    let i8_v = unsafe { (*ti_ptr).t_i8.v };
    let u8_v = unsafe { (*ti_ptr).t_u8.v };
    let i16_v = unsafe { (*ti_ptr).t_i16.v };
    let u16_v = unsafe { (*ti_ptr).t_u16.v };
    let i32_v = unsafe { (*ti_ptr).t_i32.v };
    let u32_v = unsafe { (*ti_ptr).t_u32.v };
    let i64_v = unsafe { (*ti_ptr).t_i64.v };

    let load_tys: [6]u32 = [i8_v, u8_v, i16_v, u16_v, i32_v, u32_v];
    let exp_sz: [6]u8 = [1u8, 1u8, 2u8, 2u8, 4u8, 4u8];
    let exp_sh: [6]i64 = [56i64, 56i64, 48i64, 48i64, 32i64, 32i64];
    let exp_opc: [6]u32 = [X64_MI_SAR, X64_MI_SHR, X64_MI_SAR, X64_MI_SHR, X64_MI_SAR, X64_MI_SHR];

    let lir = lir_body_new(mut_view(*a));
    let slots = arena_alloc_raw(mut_view(*a), size_of<LirStackSlot>(), align_of<LirStackSlot>()) as *mut LirStackSlot;
    let vregs = arena_alloc_raw(mut_view(*a), 7 * size_of<LirVReg>(), align_of<LirVReg>()) as *mut LirVReg;
    let bbs = arena_alloc_raw(mut_view(*a), size_of<LirBb>(), align_of<LirBb>()) as *mut LirBb;
    let insts = arena_alloc_raw(mut_view(*a), 6 * size_of<LirInst>(), align_of<LirInst>()) as *mut LirInst;

    unsafe {
        (*lir_slot_at(slots, 0)).ty.v = i64_v;
        (*lir_slot_at(slots, 0)).is_const = false;
        (*lir).slots = slots;
        (*lir).slot_count = 1;

        (*lir_vreg_at(vregs, 0)).ty.v = i64_v;
        let mut k: usize = 0;
        while k < 6 {
            (*lir_vreg_at(vregs, 1 + k)).ty.v = load_tys[k];
            let ip = lir_inst_at(insts, k);
            lir_inst_reset(mut_view(*ip), LIR_INST_LOAD);
            (*ip).dest.v = (1 + k) as u32;
            (*ip).ptr.v = 0u32;
            (*ip).ty.v = load_tys[k];
            k = k + 1;
        }
        (*lir).vregs = vregs;
        (*lir).vreg_count = 7;

        let bb0 = lir_bb_at(bbs, 0);
        lir_bb_reset(mut_view(*bb0), 0u32);
        (*bb0).insts = insts;
        (*bb0).inst_count = 6;
        lir_term_reset(mut_view((*bb0).term), LIR_TERM_RETURN);
        (*lir).bbs = bbs;
        (*lir).bb_count = 1;
    }

    let mi = x64_isel(unsafe { view(*lir) }, unsafe { view(*ti_ptr) });
    let mbb0 = unsafe { x64_mi_bb_at((*mi).bbs, 0) };

    // Each sub-64-bit LOAD emits 6 MI instructions:
    //   0: mov rax, [frame#1]
    //   1: mov rcx, 0
    //   2: mov (sz) rcx, [rax]
    //   3: shl rcx, <shift>
    //   4: sar/shr rcx, <shift>
    //   5: mov [frame#dst], rcx
    let mut c: usize = 0;
    while c < 6 {
        let base = c * 6;
        let m_ld = unsafe { bb_inst_at(mbb0, base + 2) };
        let m_shl = unsafe { bb_inst_at(mbb0, base + 3) };
        let m_shr = unsafe { bb_inst_at(mbb0, base + 4) };
        if (unsafe { (*m_ld).size }) != exp_sz[c] {
            return (300 + c) as i32;
        }
        if (unsafe { (*m_shl).opcode }) != X64_MI_SHL || (unsafe { (*m_shl).ops[1].imm }) != exp_sh[c] {
            return (310 + c) as i32;
        }
        if (unsafe { (*m_shr).opcode }) != exp_opc[c] || (unsafe { (*m_shr).ops[1].imm }) != exp_sh[c] {
            return (320 + c) as i32;
        }
        c = c + 1;
    }

    arena_reset(mut_view(*a));
    0
}

// Test 4: `x64_mi_print_op` edge cases (`INT64_MIN`, displacement-only `[0]`/`[-16]`, `[rip - 32]`, invalid reg `r?`)
// and `SDIV_OVERFLOW`/`SREM_OVERFLOW` sub-64-bit bounds (`bw = 8, 16, 32`)
fn test_printer_and_overflow_edges(a: mut_view<Arena>, ti_ptr: *mut TypeInterner, out: mut_view<DiagBuffer>) -> i32 {
    // 1. INT64_MIN immediate: -9223372036854775808
    let int64_min: i64 = (0x8000000000000000u64) as i64;
    out.len = 0;
    x64_mi_print_op(x64_op_imm(int64_min), mut_view(*out));
    let exp_min: [20]u8 = [
        45u8, 57u8, 50u8, 50u8, 51u8, 51u8, 55u8, 50u8, 48u8, 51u8,
        54u8, 56u8, 53u8, 52u8, 55u8, 55u8, 53u8, 56u8, 48u8, 56u8
    ];
    if !buf_matches_ascii(view(*out), view(exp_min)) {
        return 401;
    }

    // 2. Displacement-only memory operand `[0]` and `[-16]`
    out.len = 0;
    x64_mi_print_op(x64_op_mem(REG_NONE, REG_NONE, 1u8, 0, false), mut_view(*out));
    let exp_disp0: [3]u8 = [91u8, 48u8, 93u8]; // "[0]"
    if !buf_matches_ascii(view(*out), view(exp_disp0)) {
        return 402;
    }

    out.len = 0;
    x64_mi_print_op(x64_op_mem(REG_NONE, REG_NONE, 1u8, -16, false), mut_view(*out));
    let exp_disp_neg: [5]u8 = [91u8, 45u8, 49u8, 54u8, 93u8]; // "[-16]"
    if !buf_matches_ascii(view(*out), view(exp_disp_neg)) {
        return 403;
    }

    // 3. Negative RIP-relative displacement `[rip - 32]`
    out.len = 0;
    x64_mi_print_op(x64_op_mem(REG_NONE, REG_NONE, 1u8, -32, true), mut_view(*out));
    let exp_rip_neg: [10]u8 = [91u8, 114u8, 105u8, 112u8, 32u8, 45u8, 32u8, 51u8, 50u8, 93u8];
    if !buf_matches_ascii(view(*out), view(exp_rip_neg)) {
        return 404;
    }

    // 4. Out-of-range register id -> "r?"
    out.len = 0;
    x64_mi_print_op(x64_op_reg(99), mut_view(*out));
    let exp_r_unk: [2]u8 = [114u8, 63u8];
    if !buf_matches_ascii(view(*out), view(exp_r_unk)) {
        return 405;
    }

    // 5. SREM_OVERFLOW (bw=8, 16, 32), UREM_OVERFLOW (bw=16), SADD_OVERFLOW (bw=16)
    let i64_v = unsafe { (*ti_ptr).t_i64.v };
    let bool_v = unsafe { (*ti_ptr).t_bool.v };
    let lir = lir_body_new(mut_view(*a));
    let slots = arena_alloc_raw(mut_view(*a), size_of<LirStackSlot>(), align_of<LirStackSlot>()) as *mut LirStackSlot;
    let vregs = arena_alloc_raw(mut_view(*a), 7 * size_of<LirVReg>(), align_of<LirVReg>()) as *mut LirVReg;
    let bbs = arena_alloc_raw(mut_view(*a), size_of<LirBb>(), align_of<LirBb>()) as *mut LirBb;
    let insts = arena_alloc_raw(mut_view(*a), 5 * size_of<LirInst>(), align_of<LirInst>()) as *mut LirInst;

    unsafe {
        (*lir_slot_at(slots, 0)).ty.v = i64_v;
        (*lir_slot_at(slots, 0)).is_const = false;
        (*lir).slots = slots;
        (*lir).slot_count = 1;

        (*lir_vreg_at(vregs, 0)).ty.v = i64_v;
        (*lir_vreg_at(vregs, 1)).ty.v = i64_v;
        let mut v: usize = 2;
        while v < 7 {
            (*lir_vreg_at(vregs, v)).ty.v = bool_v;
            v = v + 1;
        }
        (*lir).vregs = vregs;
        (*lir).vreg_count = 7;

        let ops: [5]u8 = [
            LIR_INST_SREM_OVERFLOW,
            LIR_INST_SREM_OVERFLOW,
            LIR_INST_SDIV_OVERFLOW,
            LIR_INST_UREM_OVERFLOW,
            LIR_INST_SADD_OVERFLOW
        ];
        let bws: [5]u32 = [8u32, 16u32, 32u32, 16u32, 16u32];
        let mut k: usize = 0;
        while k < 5 {
            let ip = lir_inst_at(insts, k);
            lir_inst_reset(mut_view(*ip), ops[k]);
            (*ip).dest.v = (2 + k) as u32;
            (*ip).lhs.v = 0u32;
            (*ip).rhs.v = 1u32;
            (*ip).bit_width = bws[k];
            k = k + 1;
        }

        let bb0 = lir_bb_at(bbs, 0);
        lir_bb_reset(mut_view(*bb0), 0u32);
        (*bb0).insts = insts;
        (*bb0).inst_count = 5;
        lir_term_reset(mut_view((*bb0).term), LIR_TERM_RETURN);
        (*lir).bbs = bbs;
        (*lir).bb_count = 1;
    }

    let mi = x64_isel(unsafe { view(*lir) }, unsafe { view(*ti_ptr) });
    let mbb0 = unsafe { x64_mi_bb_at((*mi).bbs, 0) };

    // SREM_OVERFLOW emits 11 MI instructions; inst 5 is `MOV RDX, int_min`
    let m_min8 = unsafe { bb_inst_at(mbb0, 5) };
    let m_min16 = unsafe { bb_inst_at(mbb0, 16) };
    let m_min32 = unsafe { bb_inst_at(mbb0, 27) };
    if (unsafe { (*m_min8).ops[1].imm }) != -128i64 ||
       (unsafe { (*m_min16).ops[1].imm }) != -32768i64 ||
       (unsafe { (*m_min32).ops[1].imm }) != -2147483648i64 {
        return 406;
    }
    // UREM_OVERFLOW at index 33 emits `MOV RAX, 0; MOV [frame#5], RAX`
    let m_urem = unsafe { bb_inst_at(mbb0, 33) };
    if (unsafe { (*m_urem).opcode }) != X64_MI_MOV || (unsafe { (*m_urem).ops[1].imm }) != 0i64 {
        return 407;
    }
    // SADD_OVERFLOW (bw=16) starts at index 35; inst 37 is `MOV RDX, -32768`, inst 41 is `MOV RDX, 32767`
    let m_sadd_min = unsafe { bb_inst_at(mbb0, 37) };
    let m_sadd_max = unsafe { bb_inst_at(mbb0, 41) };
    if (unsafe { (*m_sadd_min).ops[1].imm }) != -32768i64 ||
       (unsafe { (*m_sadd_max).ops[1].imm }) != 32767i64 {
        return 408;
    }

    arena_reset(mut_view(*a));
    0
}

// Test 5: Verifier memory-destination shift rules, error messages, backward branch fixup, and Win64 ABI -> Isel -> Frame -> Obj seam
fn test_frame_verifier_and_abi_pipeline_seam(a: mut_view<Arena>, ti_ptr: *mut TypeInterner) -> i32 {
    // 1. Check all verifier error messages are non-empty
    let mut code: u32 = 0u32;
    while code <= 11u32 {
        let msg = x64_verify_error_msg(code);
        if len(msg) == 0 {
            return 501;
        }
        code = code + 1u32;
    }

    // 2. Check memory-operand shift forms in `x64_verify_checked`
    let b_sh = x64_mi_body_new(mut_view(*a), 1);
    let mbb_sh = unsafe { x64_mi_bb_at((*b_sh).bbs, 0) };
    unsafe {
        x64_mi_emit(mut_view(*b_sh), mut_view(*mbb_sh), X64_MI_SHL, x64_op_frame(0u32, 0), x64_op_imm(3i64));
        x64_mi_emit(mut_view(*b_sh), mut_view(*mbb_sh), X64_MI_SAR, x64_op_frame(0u32, 0), x64_op_reg(REG_RCX));
    }
    let lay_sh = x64_frame_lower_raw(mut_view(*a), unsafe { mut_view(*b_sh) }, 1u32);
    if x64_verify_checked(unsafe { view(*b_sh) }, view(lay_sh)) != X64_VERIFY_OK {
        return 502;
    }
    // Mutate second shift's count register from RCX to RDX -> must fail with X64_VERIFY_ERR_SHIFT_REG_CLASS
    let sh_inst1 = unsafe { bb_inst_at(mbb_sh, 1) };
    unsafe {
        (*sh_inst1).ops[1] = x64_op_reg(REG_RDX);
    }
    if x64_verify_checked(unsafe { view(*b_sh) }, view(lay_sh)) != X64_VERIFY_ERR_SHIFT_REG_CLASS {
        return 503;
    }

    // 3. Backward branch fixup in `x64_emit_mi_body_obj` + external symbol deduplication for `LEA reg, sym`
    let mut ext_sym: [12]u8 = [101u8, 120u8, 116u8, 95u8, 102u8, 110u8, 95u8, 49u8, 0u8, 0u8, 0u8, 0u8];
    let ext_sym_ptr = unsafe { address_of_mut(ext_sym[0]) as *const u8 };
    let b_loop = x64_mi_body_new(mut_view(*a), 3);
    let lbb0 = unsafe { x64_mi_bb_at((*b_loop).bbs, 0) };
    let lbb1 = unsafe { x64_mi_bb_at((*b_loop).bbs, 1) };
    let lbb2 = unsafe { x64_mi_bb_at((*b_loop).bbs, 2) };
    unsafe {
        x64_mi_emit(mut_view(*b_loop), mut_view(*lbb0), X64_MI_JMP, x64_op_imm(1i64), x64_op_none());

        let lea1 = x64_mi_emit(mut_view(*b_loop), mut_view(*lbb1), X64_MI_LEA, x64_op_reg(REG_RAX), x64_op_sym(0u32));
        (*lea1).msg = ext_sym_ptr;
        let lea2 = x64_mi_emit(mut_view(*b_loop), mut_view(*lbb1), X64_MI_LEA, x64_op_reg(REG_RDX), x64_op_sym(0u32));
        (*lea2).msg = ext_sym_ptr;
        x64_mi_emit(mut_view(*b_loop), mut_view(*lbb1), X64_MI_CMP, x64_op_reg(REG_RAX), x64_op_imm(0i64));
        // Backward conditional jump from end of bb1 to start of bb1!
        x64_mi_emit(mut_view(*b_loop), mut_view(*lbb1), X64_MI_JCC, x64_op_imm(CC_NE as i64), x64_op_imm(1i64));
        x64_mi_emit(mut_view(*b_loop), mut_view(*lbb1), X64_MI_JMP, x64_op_imm(2i64), x64_op_none());

        x64_mi_emit(mut_view(*b_loop), mut_view(*lbb2), X64_MI_RET, x64_op_none(), x64_op_none());
    }
    let lay_loop = x64_frame_lower_raw(mut_view(*a), unsafe { mut_view(*b_loop) }, 0u32);
    let mut obj = objmodel_new();
    let sid = objmodel_add_section_str(mut_view(obj), ".text", SEC_CODE, SEC_FLAG_EXEC | SEC_FLAG_READ, 16u32);
    let sec = objmodel_get_section_mut(mut_view(obj), sid);
    x64_emit_mi_body_obj(unsafe { mut_view(*sec) }, unsafe { view(*b_loop) }, view(lay_loop), mut_view(obj));

    // Verify 2 relocations emitted for the two LEAs, both referencing the same deduplicated symbol ID 1!
    if (unsafe { (*sec).relocs_len }) != 2 || obj.symbols_len != 1 {
        objmodel_free(mut_view(obj));
        return 504;
    }
    // Verify backward JCC displacement is negative (sign byte 0xFF at end of rel32)
    // Prologue: 19 bytes (push rbp..r15 = 15B, sub rsp, 40 = 4B)
    // bb0: jmp bb1 = 5B (offset 19..24), rel32 at 20..24 must be 0
    // bb1 starts at 24: lea1 (7B) + lea2 (7B) + cmp rax, 0 (6B: 48 3D 00 00 00 00) = 20B (offset 24..44)
    // jcc bb1: 6B (offset 44..50), rel32 at 46..50, next_rip = 50, target = 24 -> rel32 = -26 (0xFFFFFFE6)
    let jcc_rel_b0 = unsafe { *((( (*sec).bytes as usize ) + 46) as *const u8) };
    let jcc_rel_b3 = unsafe { *((( (*sec).bytes as usize ) + 49) as *const u8) };
    if jcc_rel_b0 != 0xE6u8 || jcc_rel_b3 != 0xFFu8 {
        objmodel_free(mut_view(obj));
        return 505;
    }
    objmodel_free(mut_view(obj));

    // 4. Cross-seam test: 6-parameter function returning `[6]u8` lowered through `lir_lower_win64_abi` -> `x64_isel` -> `x64_frame_lower` -> `x64_verify_checked`
    let u8_v = unsafe { (*ti_ptr).t_u8.v };
    let i64_v = unsafe { (*ti_ptr).t_i64.v };
    let arr6_id = unsafe { intern_array_ty(mut_view(*ti_ptr), TypeId { v: u8_v }, 6u64) };
    let arr6_v = arr6_id.v;
    let params = arena_alloc_raw(mut_view(*a), 6 * size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
    unsafe {
        let mut p: usize = 0;
        while p < 6 {
            (*((params as usize + p * size_of<TypeId>()) as *mut TypeId)).v = i64_v;
            p = p + 1;
        }
    }
    let fn_sig_id = unsafe { intern_fn_ty(mut_view(*ti_ptr), false, StrId { v: 0u32 }, params, 6, TypeId { v: arr6_v }) };
    let fn_sig_ptr = unsafe { type_get(view(*ti_ptr), fn_sig_id) as *const AxType };

    let lir6 = lir_body_new(mut_view(*a));
    let slots6 = arena_alloc_raw(mut_view(*a), 7 * size_of<LirStackSlot>(), align_of<LirStackSlot>()) as *mut LirStackSlot;
    let bbs6 = arena_alloc_raw(mut_view(*a), size_of<LirBb>(), align_of<LirBb>()) as *mut LirBb;
    unsafe {
        (*lir_slot_at(slots6, 0)).ty.v = arr6_v;
        (*lir_slot_at(slots6, 0)).is_const = false;
        let mut s: usize = 1;
        while s <= 6 {
            (*lir_slot_at(slots6, s)).ty.v = i64_v;
            (*lir_slot_at(slots6, s)).is_const = false;
            s = s + 1;
        }
        (*lir6).slots = slots6;
        (*lir6).slot_count = 7;

        let bb0 = lir_bb_at(bbs6, 0);
        lir_bb_reset(mut_view(*bb0), 0u32);
        lir_term_reset(mut_view((*bb0).term), LIR_TERM_RETURN);
        (*lir6).bbs = bbs6;
        (*lir6).bb_count = 1;
    }

    lir_lower_win64_abi(lir6, ti_ptr, fn_sig_ptr);
    let mi6 = x64_isel(unsafe { view(*lir6) }, unsafe { view(*ti_ptr) });
    let lay6 = x64_frame_lower(unsafe { mut_view(*mi6) }, unsafe { view(*lir6) }, unsafe { view(*ti_ptr) });
    if x64_verify_checked(unsafe { view(*mi6) }, view(lay6)) != X64_VERIFY_OK {
        return 506;
    }

    arena_reset(mut_view(*a));
    0
}

pub fn main() -> i32 {
    let mut perm = arena_with_chunk_size(131072);
    let _ = arena_alloc_raw(mut_view(perm), 16, 8);
    let mut a = arena_with_chunk_size(131072);
    let _ = arena_alloc_raw(mut_view(a), 16, 8);

    let ti_ptr = arena_alloc_raw(mut_view(perm), size_of<TypeInterner>(), align_of<TypeInterner>()) as *mut TypeInterner;
    unsafe { type_interner_init(mut_view(*ti_ptr)); }

    let mut out = diag_buf_new();
    out.ptr = arena_alloc_raw(mut_view(perm), 16384, 1);
    out.cap = 16384;

    let rc2 = test_non_pow2_small_aggregate_and_closure_call(mut_view(a), ti_ptr);
    if rc2 != 0 { return rc2; }

    let rc3 = test_sub64_load_extensions(mut_view(a), ti_ptr);
    if rc3 != 0 { return rc3; }

    let rc5 = test_frame_verifier_and_abi_pipeline_seam(mut_view(a), ti_ptr);
    if rc5 != 0 { return rc5; }

    let rc4 = test_printer_and_overflow_edges(mut_view(a), ti_ptr, mut_view(out));
    if rc4 != 0 { return rc4; }

    let rc1 = test_string_table_growth(mut_view(a), ti_ptr);
    if rc1 != 0 { return rc1; }

    unsafe { type_interner_free(mut_view(*ti_ptr)); }
    arena_destroy(mut_view(a));
    arena_destroy(mut_view(perm));
    print("OK x64 Isel & Frame Seam and Edge Cases\n");
    0
}
