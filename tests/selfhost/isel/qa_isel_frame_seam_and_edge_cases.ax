    let old_cap = m.cap;

    m.keys = new_keys;
    m.vals = new_vals;
    m.states = new_states;
    m.len = 0;
    m.cap = new_cap;

    let mut i: usize = 0;
    while (i < old_cap) {
        let st = unsafe { *(old_states + i) };
        if st == SLOT_OCCUPIED {
            let k = unsafe { *u32_at(old_keys, i) };
            let v = unsafe { (*typeid_at(old_vals, i)).v };
            sym_typemap_insert(mut_view(*m), SymbolId { v: k }, TypeId { v: v });
        }
        i = i + 1;
    }

    if old_cap > 0 {
        unsafe {
            heap_free(old_keys as *mut u8, mul_usize(old_cap, size_of<u32>()), align_of<u32>());
            heap_free(old_vals as *mut u8, mul_usize(old_cap, size_of<TypeId>()), align_of<TypeId>());
            heap_free(old_states, old_cap, 1);
        }
    }
}

pub fn sym_typemap_insert(m: mut_view<SymTypeMap>, key: SymbolId, val: TypeId) {
    if m.cap == 0 || mul_usize(m.len + 1, MAP_LOAD_DEN) >= mul_usize(m.cap, MAP_LOAD_NUM) {
        sym_typemap_grow(mut_view(*m));
    }
    let mask = m.cap - 1;
    let mut idx = (hash_u32(key.v) as usize) & mask;
    loop {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            unsafe {
                *u32_at(m.keys, idx) = key.v;
                (*typeid_at(m.vals, idx)).v = val.v;
                *(m.states + idx) = SLOT_OCCUPIED;
            }
            m.len = m.len + 1;
            return;
        }
        let k = unsafe { *u32_at(m.keys, idx) };
        if k == key.v {
            unsafe {
                (*typeid_at(m.vals, idx)).v = val.v;
            }
            return;
        }
        idx = (idx + 1) & mask;
    }
}

pub fn sym_typemap_get(m: view<SymTypeMap>, key: SymbolId) -> *mut TypeId {
    if m.cap == 0 {
        return 0 as *mut TypeId;
    }
    let mask = m.cap - 1;
    let mut idx = (hash_u32(key.v) as usize) & mask;
    let mut probes: usize = 0;
    while (probes < m.cap) {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            return 0 as *mut TypeId;
        }
        if st == SLOT_OCCUPIED {
            let k = unsafe { *u32_at(m.keys, idx) };
            if k == key.v {
                return unsafe { typeid_at(m.vals, idx) };
            }
        }
        idx = (idx + 1) & mask;
        probes = probes + 1;
    }
    0 as *mut TypeId
}

pub fn sym_constmap_init(m: mut_view<SymConstMap>) {
    m.keys = 0 as *mut u32;
    m.vals = 0 as *mut ConstValue;
    m.states = 0 as *mut u8;
    m.len = 0;
    m.cap = 0;
}

pub fn sym_constmap_free(m: mut_view<SymConstMap>) {
    if m.cap > 0 {
        unsafe {
            heap_free(m.keys as *mut u8, mul_usize(m.cap, size_of<u32>()), align_of<u32>());
            heap_free(m.vals as *mut u8, mul_usize(m.cap, size_of<ConstValue>()), align_of<ConstValue>());
            heap_free(m.states, m.cap, 1);
        }
    }
    sym_constmap_init(m);
}

fn sym_constmap_grow(m: mut_view<SymConstMap>) {
    let new_cap: usize = if m.cap == 0 { MAP_INIT_CAP } else { mul_usize(m.cap, 2) };
    let new_keys = unsafe { heap_alloc(mul_usize(new_cap, size_of<u32>()), align_of<u32>()) as *mut u32 };
    let new_vals = unsafe {
        heap_alloc(mul_usize(new_cap, size_of<ConstValue>()), align_of<ConstValue>()) as *mut ConstValue
    };
    let new_states = unsafe { heap_alloc(new_cap, 1) };
    types_zero_bytes(new_states, new_cap);

    let old_keys = m.keys;
    let old_vals = m.vals;
    let old_states = m.states;
    let old_cap = m.cap;

    m.keys = new_keys;
    m.vals = new_vals;
    m.states = new_states;
    m.len = 0;
    m.cap = new_cap;

    let mut i: usize = 0;
    while (i < old_cap) {
        let st = unsafe { *(old_states + i) };
        if st == SLOT_OCCUPIED {
            let k = unsafe { *u32_at(old_keys, i) };
            let vp = unsafe { constval_at(old_vals, i) };
            unsafe {
                sym_constmap_insert(mut_view(*m), SymbolId { v: k }, view(*vp));
            }
        }
        i = i + 1;
    }

    if old_cap > 0 {
        unsafe {
            heap_free(old_keys as *mut u8, mul_usize(old_cap, size_of<u32>()), align_of<u32>());
            heap_free(old_vals as *mut u8, mul_usize(old_cap, size_of<ConstValue>()), align_of<ConstValue>());
            heap_free(old_states, old_cap, 1);
        }
    }
}

pub fn sym_constmap_insert(m: mut_view<SymConstMap>, key: SymbolId, val: view<ConstValue>) {
    if m.cap == 0 || mul_usize(m.len + 1, MAP_LOAD_DEN) >= mul_usize(m.cap, MAP_LOAD_NUM) {
        sym_constmap_grow(mut_view(*m));
    }
    let mask = m.cap - 1;
    let mut idx = (hash_u32(key.v) as usize) & mask;
    loop {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            unsafe {
                *u32_at(m.keys, idx) = key.v;
                let dst = constval_at(m.vals, idx);
                copy_const_value_into(mut_view(*dst), val);
                *(m.states + idx) = SLOT_OCCUPIED;
            }
            m.len = m.len + 1;
            return;
        }
        let k = unsafe { *u32_at(m.keys, idx) };
        if k == key.v {
            unsafe {
                let dst = constval_at(m.vals, idx);
                copy_const_value_into(mut_view(*dst), val);
            }
            return;
        }
        idx = (idx + 1) & mask;
    }
}

pub fn sym_constmap_get(m: view<SymConstMap>, key: SymbolId) -> *mut ConstValue {
    if m.cap == 0 {
        return 0 as *mut ConstValue;
    }
    let mask = m.cap - 1;
    let mut idx = (hash_u32(key.v) as usize) & mask;
    let mut probes: usize = 0;
    while (probes < m.cap) {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            return 0 as *mut ConstValue;
        }
        if st == SLOT_OCCUPIED {
            let k = unsafe { *u32_at(m.keys, idx) };
            if k == key.v {
                return unsafe { constval_at(m.vals, idx) };
            }
        }
        idx = (idx + 1) & mask;
        probes = probes + 1;
    }
    0 as *mut ConstValue
}

pub fn ptr_substmap_init(m: mut_view<PtrSubstMap>) {
    m.keys = 0 as *mut usize;
    m.vals = 0 as *mut GenericArgsSlice;
    m.states = 0 as *mut u8;
    m.len = 0;
    m.cap = 0;
}

pub fn ptr_substmap_free(m: mut_view<PtrSubstMap>) {
    if m.cap > 0 {
        unsafe {
            heap_free(m.keys as *mut u8, mul_usize(m.cap, size_of<usize>()), align_of<usize>());
            heap_free(
                m.vals as *mut u8,
                mul_usize(m.cap, size_of<GenericArgsSlice>()),
                align_of<GenericArgsSlice>()
            );
            heap_free(m.states, m.cap, 1);
        }
    }
    ptr_substmap_init(m);
}

fn ptr_substmap_grow(m: mut_view<PtrSubstMap>) {
    let new_cap: usize = if m.cap == 0 { MAP_INIT_CAP } else { mul_usize(m.cap, 2) };
    let new_keys = unsafe { heap_alloc(mul_usize(new_cap, size_of<usize>()), align_of<usize>()) as *mut usize };
    let new_vals = unsafe {
        let vbytes = mul_usize(new_cap, size_of<GenericArgsSlice>());
        heap_alloc(vbytes, align_of<GenericArgsSlice>()) as *mut GenericArgsSlice
    };
    let new_states = unsafe { heap_alloc(new_cap, 1) };
    types_zero_bytes(new_states, new_cap);

    let old_keys = m.keys;
    let old_vals = m.vals;
    let old_states = m.states;
    let old_cap = m.cap;

    m.keys = new_keys;
    m.vals = new_vals;
    m.states = new_states;
    m.len = 0;
    m.cap = new_cap;

    let mut i: usize = 0;
    while (i < old_cap) {
        let st = unsafe { *(old_states + i) };
        if st == SLOT_OCCUPIED {
            let k = unsafe { *usize_at(old_keys, i) };
            let vp = unsafe { subst_at(old_vals, i) };
            let args_ptr = unsafe { (*vp).args };
            let cnt = unsafe { (*vp).count };
            ptr_substmap_insert(mut_view(*m), k, args_ptr, cnt);
        }
        i = i + 1;
    }

    if old_cap > 0 {
        unsafe {
            heap_free(old_keys as *mut u8, mul_usize(old_cap, size_of<usize>()), align_of<usize>());
            heap_free(
                old_vals as *mut u8,
                mul_usize(old_cap, size_of<GenericArgsSlice>()),
                align_of<GenericArgsSlice>()
            );
            heap_free(old_states, old_cap, 1);
        }
    }
}

pub fn ptr_substmap_insert(
    m: mut_view<PtrSubstMap>,
    key: usize,
    args: *mut TypeId,
    count: usize
) {
    if m.cap == 0 || mul_usize(m.len + 1, MAP_LOAD_DEN) >= mul_usize(m.cap, MAP_LOAD_NUM) {
        ptr_substmap_grow(mut_view(*m));
    }
    let mask = m.cap - 1;
    let mut idx = (hash_u64(key as u64) as usize) & mask;
    loop {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            unsafe {
                *usize_at(m.keys, idx) = key;
                let vp = subst_at(m.vals, idx);
                (*vp).args = args;
                (*vp).count = count;
                *(m.states + idx) = SLOT_OCCUPIED;
            }
            m.len = m.len + 1;
            return;
        }
        let k = unsafe { *usize_at(m.keys, idx) };
        if k == key {
            unsafe {
                let vp = subst_at(m.vals, idx);
                (*vp).args = args;
                (*vp).count = count;
            }
            return;
        }
        idx = (idx + 1) & mask;
    }
}

pub fn ptr_substmap_get(m: view<PtrSubstMap>, key: usize) -> *mut GenericArgsSlice {
    if m.cap == 0 {
        return 0 as *mut GenericArgsSlice;
    }
    let mask = m.cap - 1;
    let mut idx = (hash_u64(key as u64) as usize) & mask;
    let mut probes: usize = 0;
    while (probes < m.cap) {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            return 0 as *mut GenericArgsSlice;
        }
        if st == SLOT_OCCUPIED {
            let k = unsafe { *usize_at(m.keys, idx) };
            if k == key {
                return unsafe { subst_at(m.vals, idx) };
            }
        }
        idx = (idx + 1) & mask;
        probes = probes + 1;
    }
    0 as *mut GenericArgsSlice
}

pub fn ptr_trymap_init(m: mut_view<PtrTryMap>) {
    m.keys = 0 as *mut usize;
    m.vals = 0 as *mut TryExprInfo;
    m.states = 0 as *mut u8;
    m.len = 0;
    m.cap = 0;
}

pub fn ptr_trymap_free(m: mut_view<PtrTryMap>) {
    if m.cap > 0 {
        unsafe {
            heap_free(m.keys as *mut u8, mul_usize(m.cap, size_of<usize>()), align_of<usize>());
            heap_free(m.vals as *mut u8, mul_usize(m.cap, size_of<TryExprInfo>()), align_of<TryExprInfo>());
            heap_free(m.states, m.cap, 1);
        }
    }
    ptr_trymap_init(m);
}

fn ptr_trymap_grow(m: mut_view<PtrTryMap>) {
    let new_cap: usize = if m.cap == 0 { MAP_INIT_CAP } else { mul_usize(m.cap, 2) };
    let new_keys = unsafe { heap_alloc(mul_usize(new_cap, size_of<usize>()), align_of<usize>()) as *mut usize };
    let new_vals = unsafe {
        heap_alloc(mul_usize(new_cap, size_of<TryExprInfo>()), align_of<TryExprInfo>()) as *mut TryExprInfo
    };
    let new_states = unsafe { heap_alloc(new_cap, 1) };
    types_zero_bytes(new_states, new_cap);

    let old_keys = m.keys;
    let old_vals = m.vals;
    let old_states = m.states;
    let old_cap = m.cap;

    m.keys = new_keys;
    m.vals = new_vals;
    m.states = new_states;
    m.len = 0;
    m.cap = new_cap;

    let mut i: usize = 0;
    while (i < old_cap) {
        let st = unsafe { *(old_states + i) };
        if st == SLOT_OCCUPIED {
            let k = unsafe { *usize_at(old_keys, i) };
            let vp = unsafe { tryinfo_at(old_vals, i) };
            let is_opt = unsafe { (*vp).is_opt };
            let p_idx = unsafe { (*vp).payload_idx };
            let e_idx = unsafe { (*vp).err_idx };
            ptr_trymap_insert(mut_view(*m), k, is_opt, p_idx, e_idx);
        }
        i = i + 1;
    }

    if old_cap > 0 {
        unsafe {
            heap_free(old_keys as *mut u8, mul_usize(old_cap, size_of<usize>()), align_of<usize>());
            heap_free(old_vals as *mut u8, mul_usize(old_cap, size_of<TryExprInfo>()), align_of<TryExprInfo>());
            heap_free(old_states, old_cap, 1);
        }
    }
}

pub fn ptr_trymap_insert(
    m: mut_view<PtrTryMap>,
    key: usize,
    is_opt: bool,
    payload_idx: usize,
    err_idx: usize
) {
    if m.cap == 0 || mul_usize(m.len + 1, MAP_LOAD_DEN) >= mul_usize(m.cap, MAP_LOAD_NUM) {
        ptr_trymap_grow(mut_view(*m));
    }
    let mask = m.cap - 1;
    let mut idx = (hash_u64(key as u64) as usize) & mask;
    loop {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            unsafe {
                *usize_at(m.keys, idx) = key;
                let vp = tryinfo_at(m.vals, idx);
                (*vp).is_opt = is_opt;
                (*vp).payload_idx = payload_idx;
                (*vp).err_idx = err_idx;
                *(m.states + idx) = SLOT_OCCUPIED;
            }
            m.len = m.len + 1;
            return;
        }
        let k = unsafe { *usize_at(m.keys, idx) };
        if k == key {
            unsafe {
                let vp = tryinfo_at(m.vals, idx);
                (*vp).is_opt = is_opt;
                (*vp).payload_idx = payload_idx;
                (*vp).err_idx = err_idx;
            }
            return;
        }
        idx = (idx + 1) & mask;
    }
}

pub fn ptr_trymap_get(m: view<PtrTryMap>, key: usize) -> *mut TryExprInfo {
    if m.cap == 0 {
        return 0 as *mut TryExprInfo;
    }
    let mask = m.cap - 1;
    let mut idx = (hash_u64(key as u64) as usize) & mask;
    let mut probes: usize = 0;
    while (probes < m.cap) {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            return 0 as *mut TryExprInfo;
        }
        if st == SLOT_OCCUPIED {
            let k = unsafe { *usize_at(m.keys, idx) };
            if k == key {
                return unsafe { tryinfo_at(m.vals, idx) };
            }
        }
        idx = (idx + 1) & mask;
        probes = probes + 1;
    }
    0 as *mut TryExprInfo
}

pub fn thir_init(thir: mut_view<Thir>) {
    type_interner_init(mut_view(thir.interner));
    ptr_typemap_init(mut_view(thir.expr_types));
    ptr_typemap_init(mut_view(thir.pat_types));
    ptr_u32map_init(mut_view(thir.expr_variants));
    ptr_u32map_init(mut_view(thir.pat_variants));
    ptr_itemmap_init(mut_view(thir.expr_methods));
    ptr_typemap_init(mut_view(thir.item_types));
    ptr_typemap_init(mut_view(thir.param_types));
    sym_typemap_init(mut_view(thir.symbol_types));
    sym_constmap_init(mut_view(thir.symbol_consts));
    ptr_substmap_init(mut_view(thir.expr_substs));
    ptr_substmap_init(mut_view(thir.pat_substs));
    ptr_trymap_init(mut_view(thir.expr_try_info));
}

pub fn thir_free(thir: mut_view<Thir>) {
    ptr_trymap_free(mut_view(thir.expr_try_info));
    ptr_substmap_free(mut_view(thir.pat_substs));
    ptr_substmap_free(mut_view(thir.expr_substs));
    sym_constmap_free(mut_view(thir.symbol_consts));
    sym_typemap_free(mut_view(thir.symbol_types));
    ptr_typemap_free(mut_view(thir.param_types));
    ptr_typemap_free(mut_view(thir.item_types));
    ptr_itemmap_free(mut_view(thir.expr_methods));
    ptr_u32map_free(mut_view(thir.pat_variants));
    ptr_u32map_free(mut_view(thir.expr_variants));
    ptr_typemap_free(mut_view(thir.pat_types));
    ptr_typemap_free(mut_view(thir.expr_types));
    type_interner_free(mut_view(thir.interner));
}

pub fn thir_set_expr_type(thir: mut_view<Thir>, expr: *const HirExpr, ty: TypeId) {
    ptr_typemap_insert(mut_view(thir.expr_types), expr as usize, ty);
}

pub fn thir_get_expr_type(thir: view<Thir>, expr: *const HirExpr) -> *mut TypeId {
    ptr_typemap_get(view(thir.expr_types), expr as usize)
}

pub fn thir_set_pat_type(thir: mut_view<Thir>, pat: *const HirPat, ty: TypeId) {
    ptr_typemap_insert(mut_view(thir.pat_types), pat as usize, ty);
}

pub fn thir_get_pat_type(thir: view<Thir>, pat: *const HirPat) -> *mut TypeId {
    ptr_typemap_get(view(thir.pat_types), pat as usize)
}

pub fn thir_set_item_type(thir: mut_view<Thir>, item: *const HirItem, ty: TypeId) {
    ptr_typemap_insert(mut_view(thir.item_types), item as usize, ty);
}

pub fn thir_get_item_type(thir: view<Thir>, item: *const HirItem) -> *mut TypeId {
    ptr_typemap_get(view(thir.item_types), item as usize)
}

pub fn thir_set_param_type(thir: mut_view<Thir>, param: *const HirParam, ty: TypeId) {
    ptr_typemap_insert(mut_view(thir.param_types), param as usize, ty);
}

pub fn thir_get_param_type(thir: view<Thir>, param: *const HirParam) -> *mut TypeId {
    ptr_typemap_get(view(thir.param_types), param as usize)
}

pub fn thir_set_sym_type(thir: mut_view<Thir>, sym: SymbolId, ty: TypeId) {
    sym_typemap_insert(mut_view(thir.symbol_types), sym, ty);
}

pub fn thir_get_sym_type(thir: view<Thir>, sym: SymbolId) -> *mut TypeId {
    sym_typemap_get(view(thir.symbol_types), sym)
}

pub fn thir_set_expr_variant(thir: mut_view<Thir>, expr: *const HirExpr, variant_idx: u32) {
    ptr_u32map_insert(mut_view(thir.expr_variants), expr as usize, variant_idx);
}

pub fn thir_get_expr_variant(thir: view<Thir>, expr: *const HirExpr) -> *mut u32 {
    ptr_u32map_get(view(thir.expr_variants), expr as usize)
}

pub fn thir_set_pat_variant(thir: mut_view<Thir>, pat: *const HirPat, variant_idx: u32) {
    ptr_u32map_insert(mut_view(thir.pat_variants), pat as usize, variant_idx);
}

pub fn thir_get_pat_variant(thir: view<Thir>, pat: *const HirPat) -> *mut u32 {
    ptr_u32map_get(view(thir.pat_variants), pat as usize)
}

pub fn thir_set_expr_method(thir: mut_view<Thir>, expr: *const HirExpr, method: *const HirItem) {
    ptr_itemmap_insert(mut_view(thir.expr_methods), expr as usize, method);
}

pub fn thir_get_expr_method(thir: view<Thir>, expr: *const HirExpr) -> *mut *const HirItem {
    ptr_itemmap_get(view(thir.expr_methods), expr as usize)
}

pub struct TypeVarEntry {
    pub resolved_to: TypeId,
    pub is_generic: bool,
    pub span: Span,
}

pub struct TypeVarTable {
    pub items: *mut TypeVarEntry,
    pub len: usize,
    pub cap: usize,
    pub fn_var_start: usize,
}

pub unsafe fn typevar_at(base: *mut TypeVarEntry, idx: usize) -> *mut TypeVarEntry {
    let off = ((idx as isize) * (size_of<TypeVarEntry>() as isize)) as usize;
    ((base as usize) + off) as *mut TypeVarEntry
}

pub fn type_vars_init(tv: mut_view<TypeVarTable>) {
    tv.items = 0 as *mut TypeVarEntry;
    tv.len = 0;
    tv.cap = 0;
    tv.fn_var_start = 0;
}

pub fn type_vars_free(tv: mut_view<TypeVarTable>) {
    if tv.cap > 0 && (tv.items as usize) != 0 {
        unsafe {
            heap_free(
                tv.items as *mut u8,
                mul_usize(tv.cap, size_of<TypeVarEntry>()),
                align_of<TypeVarEntry>()
            );
        }
    }
    type_vars_init(tv);
}

fn type_vars_grow(tv: mut_view<TypeVarTable>) {
    let new_cap: usize = if tv.cap == 0 { MAP_INIT_CAP } else { mul_usize(tv.cap, 2) };
    let new_items = unsafe {
        heap_alloc(mul_usize(new_cap, size_of<TypeVarEntry>()), align_of<TypeVarEntry>()) as *mut TypeVarEntry
    };
    if tv.len > 0 && (tv.items as usize) != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(
                tv.items as *const u8,
                new_items as *mut u8,
                mul_usize(tv.len, size_of<TypeVarEntry>())
            );
            heap_free(
                tv.items as *mut u8,
                mul_usize(tv.cap, size_of<TypeVarEntry>()),
                align_of<TypeVarEntry>()
            );
        }
    }
    tv.items = new_items;
    tv.cap = new_cap;
}

pub fn type_vars_new_int_var(tv: mut_view<TypeVarTable>, ti: mut_view<TypeInterner>) -> TypeId {
    if tv.len == tv.cap {
        type_vars_grow(mut_view(*tv));
    }
    let var_id = tv.len as u32;
    let entry = unsafe { typevar_at(tv.items, tv.len) };
    unsafe {
        (*entry).resolved_to.v = 0u32;
        (*entry).is_generic = false;
        (*entry).span.file.v = 0u32;
        (*entry).span.start = 0u32;
        (*entry).span.end = 0u32;
    }
    tv.len = tv.len + 1;
    intern_var_ty(mut_view(*ti), TY_INT_VAR, var_id)
}

pub fn type_vars_new_ty_var(
    tv: mut_view<TypeVarTable>,
    ti: mut_view<TypeInterner>,
    span: view<Span>
) -> TypeId {
    if tv.len == tv.cap {
        type_vars_grow(mut_view(*tv));
    }
    let var_id = tv.len as u32;
    let entry = unsafe { typevar_at(tv.items, tv.len) };
    unsafe {
        (*entry).resolved_to.v = 0u32;
        (*entry).is_generic = true;
        (*entry).span.file.v = span.file.v;
        (*entry).span.start = span.start;
        (*entry).span.end = span.end;
    }
    tv.len = tv.len + 1;
    intern_var_ty(mut_view(*ti), TY_VAR, var_id)
}

pub fn type_vars_resolve(tv: mut_view<TypeVarTable>, ti: view<TypeInterner>, id: TypeId) -> TypeId {
    let id_v = id.v;
    if id_v == 0u32 {
        return TypeId { v: 0u32 };
    }
    let t = type_get(ti, TypeId { v: id_v });
    if (t as usize) == 0 {
        return TypeId { v: id_v };
    }
    let k = unsafe { (*t).kind };
    if k == TY_INT_VAR || k == TY_VAR {
        let vid = unsafe { (*t).var_id as usize };
        if vid < tv.len {
            let entry = unsafe { typevar_at(tv.items, vid) };
            let res_v = unsafe { (*entry).resolved_to.v };
            if res_v != 0u32 && res_v != id_v {
                let res_id = TypeId { v: res_v };
                let full = type_vars_resolve(mut_view(*tv), ti, res_id);
                let full_v = full.v;
                let entry_after = unsafe { typevar_at(tv.items, vid) };
                unsafe {
                    (*entry_after).resolved_to.v = full_v;
                }
                return TypeId { v: full_v };
            }
        }
    }
    TypeId { v: id_v }
}

pub fn type_vars_unify(
    tv: mut_view<TypeVarTable>,
    ti: view<TypeInterner>,
    a: TypeId,
    b: TypeId
) -> bool {
    let ra = type_vars_resolve(mut_view(*tv), ti, TypeId { v: a.v });
    let rb = type_vars_resolve(mut_view(*tv), ti, TypeId { v: b.v });
    let ra_v = ra.v;
    let rb_v = rb.v;
    if ra_v == rb_v {
        return true;
    }
    let ta = type_get(ti, TypeId { v: ra_v });
    let tb = type_get(ti, TypeId { v: rb_v });
    if (ta as usize) == 0 || (tb as usize) == 0 {
        return false;
    }
    let ka = unsafe { (*ta).kind };
    let kb = unsafe { (*tb).kind };
    if ka == TY_ERROR || kb == TY_ERROR {
        return true;
    }
    if ka == TY_NEVER || kb == TY_NEVER {
        return true;
    }
    if ka == TY_VAR {
        let va = unsafe { (*ta).var_id as usize };
        let vb = unsafe { (*tb).var_id as usize };
        if kb != TY_VAR || va != vb {
            if va < tv.len {
                let ea = unsafe { typevar_at(tv.items, va) };
                unsafe {
                    (*ea).resolved_to.v = rb_v;
                }
            }
        }
        return true;
    }
    if kb == TY_VAR {
        let vb = unsafe { (*tb).var_id as usize };
        if vb < tv.len {
            let eb = unsafe { typevar_at(tv.items, vb) };
            unsafe {
                (*eb).resolved_to.v = ra_v;
            }
        }
        return true;
    }
    if ka == TY_INT_VAR {
        let rb_ty = TypeId { v: rb_v };
        if kb == TY_INT_VAR || type_is_int(rb_ty, ti) {
            let va = unsafe { (*ta).var_id as usize };
            if va < tv.len {
                let ea = unsafe { typevar_at(tv.items, va) };
                unsafe {
                    (*ea).resolved_to.v = rb_v;
                }
            }
            return true;
        }
        return false;
    }
    if kb == TY_INT_VAR {
        let ra_ty = TypeId { v: ra_v };
        if type_is_int(ra_ty, ti) {
            let vb = unsafe { (*tb).var_id as usize };
            if vb < tv.len {
                let eb = unsafe { typevar_at(tv.items, vb) };
                unsafe {
                    (*eb).resolved_to.v = ra_v;
                }
            }
            return true;
        }
        return false;
    }
    if ka == TY_TUPLE && kb == TY_TUPLE {
        let fca = unsafe { (*ta).field_count };
        let fcb = unsafe { (*tb).field_count };
        if fca != fcb {
            return false;
        }
        let fa_ptr = unsafe { (*ta).fields };
        let fb_ptr = unsafe { (*tb).fields };
        let mut ok = true;
        let mut i: usize = 0;
        while (i < fca) {
            let fav = unsafe { (*typeid_at(fa_ptr, i)).v };
            let fbv = unsafe { (*typeid_at(fb_ptr, i)).v };
            let fa_ty = TypeId { v: fav };
            let fb_ty = TypeId { v: fbv };
            if !type_vars_unify(mut_view(*tv), ti, fa_ty, fb_ty) {
                ok = false;
            }
            i = i + 1;
        }
        return ok;
    }
    if ka == TY_ARRAY && kb == TY_ARRAY {
        let la = unsafe { (*ta).array_len };
        let lb = unsafe { (*tb).array_len };
        if la != lb {
            return false;
        }
        let ela = unsafe { (*ta).elem.v };
        let elb = unsafe { (*tb).elem.v };
        let ela_ty = TypeId { v: ela };
        let elb_ty = TypeId { v: elb };
        return type_vars_unify(mut_view(*tv), ti, ela_ty, elb_ty);
    }
    if ka == TY_VIEW && kb == TY_VIEW {
        let pta = unsafe { (*ta).pointee.v };
        let ptb = unsafe { (*tb).pointee.v };
        let pta_ty = TypeId { v: pta };
        let ptb_ty = TypeId { v: ptb };
        return type_vars_unify(mut_view(*tv), ti, pta_ty, ptb_ty);
    }
    if ka == TY_MUT_VIEW && kb == TY_MUT_VIEW {
        let pta = unsafe { (*ta).pointee.v };
        let ptb = unsafe { (*tb).pointee.v };
        let pta_ty = TypeId { v: pta };
        let ptb_ty = TypeId { v: ptb };
        return type_vars_unify(mut_view(*tv), ti, pta_ty, ptb_ty);
    }
    if ka == TY_PTR && kb == TY_PTR {
        let ma = unsafe { (*ta).is_mut };
        let mb = unsafe { (*tb).is_mut };
        if ma != mb {
            return false;
        }
        let pta = unsafe { (*ta).pointee.v };
        let ptb = unsafe { (*tb).pointee.v };
        let pta_ty = TypeId { v: pta };
        let ptb_ty = TypeId { v: ptb };
        return type_vars_unify(mut_view(*tv), ti, pta_ty, ptb_ty);
    }
    if ka == TY_STR && kb == TY_VIEW {
        let ptb_v = unsafe { (*tb).pointee.v };
        let p_tb = type_get(ti, TypeId { v: ptb_v });
        if (p_tb as usize) == 0 {
            return false;
        }
        let p_kb = unsafe { (*p_tb).kind };
        if p_kb != TY_SLICE {
            return false;
        }
        let elb = unsafe { (*p_tb).elem.v };
        let u8_ty = TypeId { v: ti.t_u8.v };
        let elb_ty = TypeId { v: elb };
        return type_vars_unify(mut_view(*tv), ti, u8_ty, elb_ty);
    }
    if kb == TY_STR && ka == TY_VIEW {
        let pta_v = unsafe { (*ta).pointee.v };
        let p_ta = type_get(ti, TypeId { v: pta_v });
        if (p_ta as usize) == 0 {
            return false;
        }
        let p_ka = unsafe { (*p_ta).kind };
        if p_ka != TY_SLICE {
            return false;
        }
        let ela = unsafe { (*p_ta).elem.v };
        let u8_ty = TypeId { v: ti.t_u8.v };
        let ela_ty = TypeId { v: ela };
        return type_vars_unify(mut_view(*tv), ti, u8_ty, ela_ty);
    }
    type_vars_unify_compound(mut_view(*tv), ti, ta, tb, ka, kb)
}

fn type_vars_unify_compound(
    tv: mut_view<TypeVarTable>,
    ti: view<TypeInterner>,
    ta: *const AxType,
    tb: *const AxType,
    ka: u8,
    kb: u8
) -> bool {
    if (ka == TY_ENUM && kb == TY_ENUM) || (ka == TY_STRUCT && kb == TY_STRUCT) {
        let defa = unsafe { (*ta).def as usize };
        let defb = unsafe { (*tb).def as usize };
        if defa != defb {
            return false;
        }
        let aca = unsafe { (*ta).arg_count };
        let acb = unsafe { (*tb).arg_count };
        if aca != acb {
            return false;
        }
        let args_a = unsafe { (*ta).args };
        let args_b = unsafe { (*tb).args };
        let mut ok = true;
        let mut i: usize = 0;
        while (i < aca) {
            let aav = unsafe { (*typeid_at(args_a, i)).v };
            let abv = unsafe { (*typeid_at(args_b, i)).v };
            let aa_ty = TypeId { v: aav };
            let ab_ty = TypeId { v: abv };
            if !type_vars_unify(mut_view(*tv), ti, aa_ty, ab_ty) {
                ok = false;
            }
            i = i + 1;
        }
        return ok;
    }
    if ka == TY_FN && kb == TY_FN {
        let pca = unsafe { (*ta).param_count };
        let pcb = unsafe { (*tb).param_count };
        if pca != pcb {
            return false;
        }
        let reta = unsafe { (*ta).ret_type.v };
        let retb = unsafe { (*tb).ret_type.v };
        let reta_ty = TypeId { v: reta };
        let retb_ty = TypeId { v: retb };
        if !type_vars_unify(mut_view(*tv), ti, reta_ty, retb_ty) {
            return false;
        }
        let pa_ptr = unsafe { (*ta).param_types };
        let pb_ptr = unsafe { (*tb).param_types };
        let mut i: usize = 0;
        while (i < pca) {
            let pav = unsafe { (*typeid_at(pa_ptr, i)).v };
            let pbv = unsafe { (*typeid_at(pb_ptr, i)).v };
            let pa_ty = TypeId { v: pav };
            let pb_ty = TypeId { v: pbv };
            if !type_vars_unify(mut_view(*tv), ti, pa_ty, pb_ty) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    if ka == TY_CLOSURE && kb == TY_CLOSURE {
        let cida = unsafe { (*ta).closure_id };
        let cidb = unsafe { (*tb).closure_id };
        return cida == cidb;
    }
    false
}

pub fn subst_type_with_vars(
    ty: TypeId,
    args: view<GenericArgsSlice>,
    tv: mut_view<TypeVarTable>,
    ti: mut_view<TypeInterner>
) -> TypeId {
    let ty_v = ty.v;
    if ty_v == 0u32 {
        return TypeId { v: 0u32 };
    }
    let resolved = type_vars_resolve(mut_view(*tv), view(*ti), TypeId { v: ty_v });
    let res_v = resolved.v;
    if args.count == 0 || (args.args as usize) == 0 {
        return TypeId { v: res_v };
    }
    let t = type_get(view(*ti), TypeId { v: res_v });
    if (t as usize) == 0 {
        return TypeId { v: res_v };
    }
    let kind = unsafe { (*t).kind };
    if kind == TY_PARAM {
        let idx = unsafe { (*t).param_index as usize };
        if idx < args.count {
            let sub_v = unsafe { (*typeid_at(args.args, idx)).v };
            if sub_v != 0u32 {
                return TypeId { v: sub_v };
            }
        }
        return TypeId { v: res_v };
    }
    if kind == TY_PTR || kind == TY_VIEW || kind == TY_MUT_VIEW {
        let orig_pt_v = unsafe { (*t).pointee.v };
        let orig_pt = TypeId { v: orig_pt_v };
        let new_pt = subst_type_with_vars(orig_pt, args, mut_view(*tv), mut_view(*ti));
        let new_pt_v = new_pt.v;
        if new_pt_v == orig_pt_v {
            return TypeId { v: res_v };
        }
        let t_cur = type_get(view(*ti), TypeId { v: res_v });
        let sp = ti.scratch;
        unsafe {
            copy_ax_type_into(mut_view(*sp), view(*t_cur));
            (*sp).pointee.v = new_pt_v;
        }
        return intern_type(mut_view(*ti), unsafe { view(*sp) });
    }
    if kind == TY_ARRAY || kind == TY_SLICE {
        let orig_el_v = unsafe { (*t).elem.v };
        let orig_el = TypeId { v: orig_el_v };
        let new_el = subst_type_with_vars(orig_el, args, mut_view(*tv), mut_view(*ti));
        let new_el_v = new_el.v;
        if new_el_v == orig_el_v {
            return TypeId { v: res_v };
        }
        let t_cur = type_get(view(*ti), TypeId { v: res_v });
        let sp = ti.scratch;
        unsafe {
            copy_ax_type_into(mut_view(*sp), view(*t_cur));
            (*sp).elem.v = new_el_v;
        }
        return intern_type(mut_view(*ti), unsafe { view(*sp) });
    }
    if kind == TY_TUPLE {
        let fcnt = unsafe { (*t).field_count };
        if fcnt == 0 {
            return TypeId { v: res_v };
        }
        let orig_fields = unsafe { (*t).fields };
        let new_fields = unsafe {
            let fbytes = mul_usize(fcnt, size_of<TypeId>());
            arena_alloc_raw(mut_view(ti.arena), fbytes, align_of<TypeId>()) as *mut TypeId
        };
        let mut changed = false;
        let mut i: usize = 0;
        while (i < fcnt) {
            let of_v = unsafe { (*typeid_at(orig_fields, i)).v };
            let of_ty = TypeId { v: of_v };
            let nf = subst_type_with_vars(of_ty, args, mut_view(*tv), mut_view(*ti));
            let nf_v = nf.v;
            if nf_v != of_v {
                changed = true;
            }
            unsafe {
                (*typeid_at(new_fields, i)).v = nf_v;
            }
            i = i + 1;
        }
        if !changed {
            return TypeId { v: res_v };
        }
        let t_cur = type_get(view(*ti), TypeId { v: res_v });
        let sp = ti.scratch;
        unsafe {
            copy_ax_type_into(mut_view(*sp), view(*t_cur));
            (*sp).fields = new_fields;
        }
        return intern_type(mut_view(*ti), unsafe { view(*sp) });
    }
    if kind == TY_FN {
        let orig_ret_v = unsafe { (*t).ret_type.v };
        let orig_ret = TypeId { v: orig_ret_v };
        let new_ret = subst_type_with_vars(orig_ret, args, mut_view(*tv), mut_view(*ti));
        let new_ret_v = new_ret.v;
        let mut changed: bool = new_ret_v != orig_ret_v;
        let pcnt = unsafe { (*t).param_count };
        let mut new_params: *mut TypeId = 0 as *mut TypeId;
        if pcnt > 0 {
            let orig_params = unsafe { (*t).param_types };
            new_params = unsafe {
                let pbytes = mul_usize(pcnt, size_of<TypeId>());
                arena_alloc_raw(mut_view(ti.arena), pbytes, align_of<TypeId>()) as *mut TypeId
            };
            let mut i: usize = 0;
            while (i < pcnt) {
                let op_v = unsafe { (*typeid_at(orig_params, i)).v };
                let op_ty = TypeId { v: op_v };
                let np = subst_type_with_vars(op_ty, args, mut_view(*tv), mut_view(*ti));
                let np_v = np.v;
                if np_v != op_v {
                    changed = true;
                }
                unsafe {
                    (*typeid_at(new_params, i)).v = np_v;
                }
                i = i + 1;
            }
        }
        if !changed {
            return TypeId { v: res_v };
        }
        let t_cur = type_get(view(*ti), TypeId { v: res_v });
        let sp = ti.scratch;
        unsafe {
            copy_ax_type_into(mut_view(*sp), view(*t_cur));
            (*sp).ret_type.v = new_ret_v;
            (*sp).param_types = new_params;
        }
        return intern_type(mut_view(*ti), unsafe { view(*sp) });
    }
    subst_adt_with_vars(res_v, t, kind, args, mut_view(*tv), mut_view(*ti))
}

fn subst_adt_with_vars(
    res_v: u32,
    t: *const AxType,
    kind: u8,
    args: view<GenericArgsSlice>,
    tv: mut_view<TypeVarTable>,
    ti: mut_view<TypeInterner>
) -> TypeId {
    if kind == TY_STRUCT {
        let mut changed = false;
        let acnt = unsafe { (*t).arg_count };
        let mut new_args: *mut TypeId = 0 as *mut TypeId;
        if acnt > 0 {
            let orig_args = unsafe { (*t).args };
            new_args = unsafe {
                let abytes = mul_usize(acnt, size_of<TypeId>());
                arena_alloc_raw(mut_view(ti.arena), abytes, align_of<TypeId>()) as *mut TypeId
            };
            let mut i: usize = 0;
            while (i < acnt) {
                let oa_v = unsafe { (*typeid_at(orig_args, i)).v };
                let oa_ty = TypeId { v: oa_v };
                let na = subst_type_with_vars(oa_ty, args, mut_view(*tv), mut_view(*ti));
                let na_v = na.v;
                if na_v != oa_v {
                    changed = true;
                }
                unsafe {
                    (*typeid_at(new_args, i)).v = na_v;
                }
                i = i + 1;
            }
        }
        let fcnt = unsafe { (*t).field_count };
        let mut new_fields: *mut TypeId = 0 as *mut TypeId;
        if fcnt > 0 {
            let orig_fields = unsafe { (*t).fields };
            new_fields = unsafe {
                let fbytes = mul_usize(fcnt, size_of<TypeId>());
                arena_alloc_raw(mut_view(ti.arena), fbytes, align_of<TypeId>()) as *mut TypeId
            };
            let mut i: usize = 0;
            while (i < fcnt) {
                let of_v = unsafe { (*typeid_at(orig_fields, i)).v };
                let of_ty = TypeId { v: of_v };
                let nf = subst_type_with_vars(of_ty, args, mut_view(*tv), mut_view(*ti));
                let nf_v = nf.v;
                if nf_v != of_v {
                    changed = true;
                }
                unsafe {
                    (*typeid_at(new_fields, i)).v = nf_v;
                }
                i = i + 1;
            }
        }
        if !changed {
            return TypeId { v: res_v };
        }
        let t_cur = type_get(view(*ti), TypeId { v: res_v });
        let sp = ti.scratch;
        unsafe {
            copy_ax_type_into(mut_view(*sp), view(*t_cur));
            if (new_args as usize) != 0 {
                (*sp).args = new_args;
            }
            if (new_fields as usize) != 0 {
                (*sp).fields = new_fields;
            }
        }
        return intern_type(mut_view(*ti), unsafe { view(*sp) });
    }
    if kind == TY_ENUM {
        let mut changed = false;
        let acnt = unsafe { (*t).arg_count };
        let mut new_args: *mut TypeId = 0 as *mut TypeId;
        if acnt > 0 {
            let orig_args = unsafe { (*t).args };
            new_args = unsafe {
                let abytes = mul_usize(acnt, size_of<TypeId>());
                arena_alloc_raw(mut_view(ti.arena), abytes, align_of<TypeId>()) as *mut TypeId
            };
            let mut i: usize = 0;
            while (i < acnt) {
                let oa_v = unsafe { (*typeid_at(orig_args, i)).v };
                let oa_ty = TypeId { v: oa_v };
                let na = subst_type_with_vars(oa_ty, args, mut_view(*tv), mut_view(*ti));
                let na_v = na.v;
                if na_v != oa_v {
                    changed = true;
                }
                unsafe {
                    (*typeid_at(new_args, i)).v = na_v;
                }
                i = i + 1;
            }
        }
        let vcnt = unsafe { (*t).variant_count };
        let vcounts = unsafe { (*t).variant_field_counts };
        let orig_vfields = unsafe { (*t).variant_fields };
        let mut new_vfields: *mut *mut TypeId = 0 as *mut *mut TypeId;
        if vcnt > 0 && (vcounts as usize) != 0 && (orig_vfields as usize) != 0 {
            new_vfields = unsafe {
                let vfbytes = mul_usize(vcnt, size_of<*mut TypeId>());
                arena_alloc_raw(mut_view(ti.arena), vfbytes, align_of<*mut TypeId>()) as *mut *mut TypeId
            };
            let mut v: usize = 0;
            while (v < vcnt) {
                let fc = unsafe { *usize_at(vcounts, v) };
                if fc > 0 {
                    let ovf = unsafe { *typeid_ptr_at(orig_vfields, v) };
                    let nvf = unsafe {
                        let fcbytes = mul_usize(fc, size_of<TypeId>());
                        arena_alloc_raw(mut_view(ti.arena), fcbytes, align_of<TypeId>()) as *mut TypeId
                    };
                    let mut i: usize = 0;
                    while (i < fc) {
                        let of_v = unsafe { (*typeid_at(ovf, i)).v };
                        let of_ty = TypeId { v: of_v };
                        let nf = subst_type_with_vars(of_ty, args, mut_view(*tv), mut_view(*ti));
                        let nf_v = nf.v;
                        if nf_v != of_v {
                            changed = true;
                        }
                        unsafe {
                            (*typeid_at(nvf, i)).v = nf_v;
                        }
                        i = i + 1;
                    }
                    unsafe {
                        *typeid_ptr_at(new_vfields, v) = nvf;
                    }
                } else {
                    unsafe {
                        *typeid_ptr_at(new_vfields, v) = 0 as *mut TypeId;
                    }
                }
                v = v + 1;
            }
        }
        if !changed {
            return TypeId { v: res_v };
        }
        let t_cur = type_get(view(*ti), TypeId { v: res_v });
        let sp = ti.scratch;
        unsafe {
            copy_ax_type_into(mut_view(*sp), view(*t_cur));
            if (new_args as usize) != 0 {
                (*sp).args = new_args;
            }
            if (new_vfields as usize) != 0 {
                (*sp).variant_fields = new_vfields;
            }
        }
        return intern_type(mut_view(*ti), unsafe { view(*sp) });
    }
    TypeId { v: res_v }
}

pub fn subst_type(
    ty: TypeId,
    args: view<GenericArgsSlice>,
    ti: mut_view<TypeInterner>
) -> TypeId {
    let mut empty_tv = TypeVarTable {
        items: 0 as *mut TypeVarEntry,
        len: 0,
        cap: 0,
        fn_var_start: 0,
    };
    subst_type_with_vars(TypeId { v: ty.v }, args, mut_view(empty_tv), mut_view(*ti))
}

// Target memory layout calculation: size, alignment, and field offsets.
// Port of bootstrap/axiom0/src/types/layout/layout.h and layout.c.
module compiler.types.layout

use host_intrinsics.heap_alloc
use host_intrinsics.heap_free
use compiler.kernel.id.TypeId
use compiler.types.types.TY_BOOL
use compiler.types.types.TY_CHAR
use compiler.types.types.TY_I8
use compiler.types.types.TY_I16
use compiler.types.types.TY_I32
use compiler.types.types.TY_I64
use compiler.types.types.TY_ISIZE
use compiler.types.types.TY_U8
use compiler.types.types.TY_U16
use compiler.types.types.TY_U32
use compiler.types.types.TY_U64
use compiler.types.types.TY_USIZE
use compiler.types.types.TY_FN
use compiler.types.types.TY_STR
use compiler.types.types.TY_SLICE
use compiler.types.types.TY_INT_VAR
use compiler.types.types.TY_PTR
use compiler.types.types.TY_ARRAY
use compiler.types.types.TY_TUPLE
use compiler.types.types.TY_STRUCT
use compiler.types.types.TY_ENUM
use compiler.types.types.TY_VIEW
use compiler.types.types.TY_MUT_VIEW
use compiler.types.types.TY_PARAM
use compiler.types.types.TY_CLOSURE
use compiler.types.types.AxType
use compiler.types.types.TypeInterner
use compiler.types.types.type_get
use compiler.types.types.mul_usize
use compiler.types.types.typeid_at
use compiler.types.types.typeid_ptr_at
use compiler.types.types.usize_at
use compiler.types.types.capture_at

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }

const ALIGN_1: u32 = 1u32;
const ALIGN_2: u32 = 2u32;
const ALIGN_4: u32 = 4u32;
const ALIGN_8: u32 = 8u32;
const SIZE_0: u32 = 0u32;
const SIZE_1: u32 = 1u32;
const SIZE_2: u32 = 2u32;
const SIZE_4: u32 = 4u32;
const SIZE_8: u32 = 8u32;
const SIZE_16: u32 = 16u32;

pub struct Layout {
    pub size: u32,
    pub align: u32,
}

struct FieldLayout {
    pub index: u32,
    pub size: u32,
    pub align: u32,
}

unsafe fn field_layout_at(base: *mut FieldLayout, idx: usize) -> *mut FieldLayout {
    let off = ((idx as isize) * (size_of<FieldLayout>() as isize)) as usize;
    ((base as usize) + off) as *mut FieldLayout
}

fn align_up_u32(offset: u32, align: u32) -> u32 {
    if (align <= 1u32) {
        return offset;
    }
    let mask = align - 1u32;
    (offset + mask) & (0xFFFFFFFFu32 ^ mask)
}

fn field_comes_before(a: view<FieldLayout>, b: view<FieldLayout>) -> bool {
    if a.align != b.align {
        return a.align > b.align;
    }
    if a.size != b.size {
        return a.size > b.size;
    }
    let ai = a.index;
    let bi = b.index;
    ai < bi
}

fn sort_fields(fl: *mut FieldLayout, count: usize) {
    let mut i: usize = 1;
    while (i < count) {
        let cur_p = unsafe { field_layout_at(fl, i) };
        let cur_index = unsafe { (*cur_p).index };
        let cur_size = unsafe { (*cur_p).size };
        let cur_align = unsafe { (*cur_p).align };
        let cur = FieldLayout {
            index: cur_index,
            size: cur_size,
            align: cur_align,
        };
        let mut j: usize = i;
        while (j > 0) {
            let prev_p = unsafe { field_layout_at(fl, j - 1) };
            let move_right = unsafe { field_comes_before(view(cur), view(*prev_p)) };
            if !move_right {
                break;
            }
            let dst_p = unsafe { field_layout_at(fl, j) };
            unsafe {
                (*dst_p).index = (*prev_p).index;
                (*dst_p).size = (*prev_p).size;
                (*dst_p).align = (*prev_p).align;
            }
            j = j - 1;
        }
        let target_p = unsafe { field_layout_at(fl, j) };
        unsafe {
            (*target_p).index = cur.index;
            (*target_p).size = cur.size;
            (*target_p).align = cur.align;
        }
        i = i + 1;
    }
}

pub fn type_align(id: TypeId, ti: view<TypeInterner>) -> u32 {
    if id.v == 0u32 {
        return ALIGN_1;
    }
    if id.v == ti.t_unit.v || id.v == ti.t_never.v {
        return ALIGN_1;
    }
    if id.v == ti.t_bool.v || id.v == ti.t_i8.v || id.v == ti.t_u8.v {
        return ALIGN_1;
    }
    if id.v == ti.t_i16.v || id.v == ti.t_u16.v {
        return ALIGN_2;
    }
    if id.v == ti.t_i32.v || id.v == ti.t_u32.v || id.v == ti.t_char.v {
        return ALIGN_4;
    }
    if id.v == ti.t_i64.v || id.v == ti.t_u64.v || id.v == ti.t_isize.v ||
        id.v == ti.t_usize.v || id.v == ti.t_str.v {
        return ALIGN_8;
    }

    let ty = type_get(ti, id);
    if (ty as usize) == 0 {
        return ALIGN_1;
    }
    let k = unsafe { (*ty).kind };
    if k == TY_BOOL || k == TY_I8 || k == TY_U8 {
        return ALIGN_1;
    }
    if k == TY_I16 || k == TY_U16 {
        return ALIGN_2;
    }
    if k == TY_I32 || k == TY_U32 || k == TY_CHAR || k == TY_INT_VAR {
        return ALIGN_4;
    }
    if k == TY_I64 || k == TY_U64 || k == TY_ISIZE || k == TY_USIZE {
        return ALIGN_8;
    }
    if k == TY_PTR || k == TY_FN || k == TY_VIEW || k == TY_MUT_VIEW || k == TY_PARAM {
        return ALIGN_8;
    }
    if k == TY_SLICE || k == TY_ARRAY {
        let elem_v = unsafe { (*ty).elem.v };
        return type_align(TypeId { v: elem_v }, ti);
    }
    if k == TY_ENUM {
        let mut max_align: u32 = ALIGN_4;
        let vcount = unsafe { (*ty).variant_count };
        let vcounts = unsafe { (*ty).variant_field_counts };
        let vfields = unsafe { (*ty).variant_fields };
        if (vcounts as usize) != 0 && (vfields as usize) != 0 {
            let mut i: usize = 0;
            while (i < vcount) {
                let count = unsafe { *usize_at(vcounts, i) };
                let vf = unsafe { *typeid_ptr_at(vfields, i) };
                let mut j: usize = 0;
                while (j < count) {
                    let fty_v = unsafe { (*typeid_at(vf, j)).v };
                    let a = type_align(TypeId { v: fty_v }, ti);
                    if a > max_align {
                        max_align = a;
                    }
                    j = j + 1;
                }
                i = i + 1;
            }
        }
        return max_align;
    }
    if k == TY_TUPLE || k == TY_STRUCT {
        let mut align: u32 = ALIGN_1;
        let count = unsafe { (*ty).field_count };
        let fields = unsafe { (*ty).fields };
        let mut i: usize = 0;
        while (i < count) {
            let fty_v = unsafe { (*typeid_at(fields, i)).v };
            let fa = type_align(TypeId { v: fty_v }, ti);
            if fa > align {
                align = fa;
            }
            i = i + 1;
        }
        return align;
    }
    if k == TY_CLOSURE {
        let mut align: u32 = ALIGN_8;
        let count = unsafe { (*ty).capture_count };
        let caps = unsafe { (*ty).captures };
        let mut i: usize = 0;
        while (i < count) {
            let cap = unsafe { capture_at(caps, i) };
            let cty_v = unsafe { (*cap).ty.v };
            let fa = type_align(TypeId { v: cty_v }, ti);
            if fa > align {
                align = fa;
            }
            i = i + 1;
        }
        return align;
    }
    ALIGN_1
}

pub fn type_size(id: TypeId, ti: view<TypeInterner>) -> u32 {
    if id.v == 0u32 {
        return SIZE_0;
    }
    if id.v == ti.t_unit.v || id.v == ti.t_never.v {
        return SIZE_0;
    }
    if id.v == ti.t_bool.v || id.v == ti.t_i8.v || id.v == ti.t_u8.v {
        return SIZE_1;
    }
    if id.v == ti.t_i16.v || id.v == ti.t_u16.v {
        return SIZE_2;
    }
    if id.v == ti.t_i32.v || id.v == ti.t_u32.v || id.v == ti.t_char.v {
        return SIZE_4;
    }
    if id.v == ti.t_i64.v || id.v == ti.t_u64.v || id.v == ti.t_isize.v || id.v == ti.t_usize.v {
        return SIZE_8;
    }
    if id.v == ti.t_str.v {
        return SIZE_16;
    }

    let ty = type_get(ti, id);
    if (ty as usize) == 0 {
        return SIZE_0;
    }
    let k = unsafe { (*ty).kind };
    if k == TY_BOOL || k == TY_I8 || k == TY_U8 {
        return SIZE_1;
    }
    if k == TY_I16 || k == TY_U16 {
        return SIZE_2;
    }
    if k == TY_I32 || k == TY_U32 || k == TY_CHAR || k == TY_INT_VAR {
        return SIZE_4;
    }
    if k == TY_I64 || k == TY_U64 || k == TY_ISIZE || k == TY_USIZE {
        return SIZE_8;
    }
    if k == TY_PTR || k == TY_FN || k == TY_PARAM {
        return SIZE_8;
    }
    if k == TY_VIEW || k == TY_MUT_VIEW {
        let pt_v = unsafe { (*ty).pointee.v };
        let pty = type_get(ti, TypeId { v: pt_v });
        let pk = unsafe { (*pty).kind };
        if pk == TY_SLICE {
            return SIZE_16;
        }
        return SIZE_8;
    }
    if k == TY_SLICE {
        return SIZE_0;
    }
    if k == TY_ARRAY {
        let elem_v = unsafe { (*ty).elem.v };
        let arr_len = unsafe { (*ty).array_len };
        let esz = type_size(TypeId { v: elem_v }, ti) as isize;
        return (esz * (arr_len as isize)) as u32;
    }
    if k == TY_ENUM {
        let mut max_align: u32 = ALIGN_4;
        let mut max_payload_size: u32 = SIZE_0;
        let vcount = unsafe { (*ty).variant_count };
        let vcounts = unsafe { (*ty).variant_field_counts };
        let vfields = unsafe { (*ty).variant_fields };
        if (vcounts as usize) != 0 && (vfields as usize) != 0 {
            let mut i: usize = 0;
            while (i < vcount) {
                let count = unsafe { *usize_at(vcounts, i) };
                if count > 0 {
                    let vf = unsafe { *typeid_ptr_at(vfields, i) };
                    let fl = unsafe {
                        let fbytes = mul_usize(count, size_of<FieldLayout>());
                        heap_alloc(fbytes, align_of<FieldLayout>()) as *mut FieldLayout
                    };
                    let mut j: usize = 0;
                    while (j < count) {
                        let fty_v = unsafe { (*typeid_at(vf, j)).v };
                        let fa = type_align(TypeId { v: fty_v }, ti);
                        let fs = type_size(TypeId { v: fty_v }, ti);
                        if fa > max_align {
                            max_align = fa;
                        }
                        let fp = unsafe { field_layout_at(fl, j) };
                        unsafe {
                            (*fp).index = j as u32;
                            (*fp).align = fa;
                            (*fp).size = fs;
                        }
                        j = j + 1;
                    }
                    sort_fields(fl, count);
                    let mut offset: u32 = 0u32;
                    let mut k_idx: usize = 0;
                    while (k_idx < count) {
                        let fp = unsafe { field_layout_at(fl, k_idx) };
                        let fa = unsafe { (*fp).align };
                        let fs = unsafe { (*fp).size };
                        offset = align_up_u32(offset, fa);
                        offset = offset + fs;
                        k_idx = k_idx + 1;
                    }
                    unsafe {
                        heap_free(
                            fl as *mut u8,
                            mul_usize(count, size_of<FieldLayout>()),
                            align_of<FieldLayout>()
                        );
                    }
                    if offset > max_payload_size {
                        max_payload_size = offset;
                    }
                }
                i = i + 1;
            }
        }
        let total_size = SIZE_4 + max_payload_size;
        return align_up_u32(total_size, max_align);
    }
    if k == TY_TUPLE || k == TY_STRUCT {
        let count = unsafe { (*ty).field_count };
        if count == 0 {
            return SIZE_0;
        }
        let fields = unsafe { (*ty).fields };
        let is_repr_c = unsafe { (*ty).is_repr_c };
        let fl = unsafe {
            heap_alloc(mul_usize(count, size_of<FieldLayout>()), align_of<FieldLayout>()) as *mut FieldLayout
        };
        let mut max_align: u32 = ALIGN_1;
        let mut i: usize = 0;
        while (i < count) {
            let fty_v = unsafe { (*typeid_at(fields, i)).v };
            let fa = type_align(TypeId { v: fty_v }, ti);
            let fs = type_size(TypeId { v: fty_v }, ti);
            if fa > max_align {
                max_align = fa;
            }
            let fp = unsafe { field_layout_at(fl, i) };
            unsafe {
                (*fp).index = i as u32;
                (*fp).align = fa;
                (*fp).size = fs;
            }
            i = i + 1;
        }
        if k == TY_TUPLE || !is_repr_c {
            sort_fields(fl, count);
        }
        let mut offset: u32 = 0u32;
        let mut j: usize = 0;
        while (j < count) {
            let fp = unsafe { field_layout_at(fl, j) };
            let fa = unsafe { (*fp).align };
            let fs = unsafe { (*fp).size };
            offset = align_up_u32(offset, fa);
            offset = offset + fs;
            j = j + 1;
        }
        unsafe {
            heap_free(fl as *mut u8, mul_usize(count, size_of<FieldLayout>()), align_of<FieldLayout>());
        }
        return align_up_u32(offset, max_align);
    }
    if k == TY_CLOSURE {
        let mut offset: u32 = SIZE_8;
        let mut max_align: u32 = ALIGN_8;
        let count = unsafe { (*ty).capture_count };
        let caps = unsafe { (*ty).captures };
        let mut i: usize = 0;
        while (i < count) {
            let cap = unsafe { capture_at(caps, i) };
            let cty_v = unsafe { (*cap).ty.v };
            let a = type_align(TypeId { v: cty_v }, ti);
            let s = type_size(TypeId { v: cty_v }, ti);
            if a > max_align {
                max_align = a;
            }
            offset = align_up_u32(offset, a);
            offset = offset + s;
            i = i + 1;
        }
        return align_up_u32(offset, max_align);
    }
    SIZE_0
}

pub fn type_layout(id: TypeId, ti: view<TypeInterner>) -> Layout {
    let id_v = id.v;
    Layout {
        size: type_size(TypeId { v: id_v }, ti),
        align: type_align(TypeId { v: id_v }, ti),
    }
}

pub fn type_field_offset(id: TypeId, field_idx: usize, ti: view<TypeInterner>) -> u32 {
    let ty = type_get(ti, id);
    if (ty as usize) == 0 {
        return 0u32;
    }
    let k = unsafe { (*ty).kind };
    if k == TY_TUPLE || k == TY_STRUCT {
        let count = unsafe { (*ty).field_count };
        if field_idx >= count {
            return 0u32;
        }
        let fields = unsafe { (*ty).fields };
        let is_repr_c = unsafe { (*ty).is_repr_c };
        let fl = unsafe {
            heap_alloc(mul_usize(count, size_of<FieldLayout>()), align_of<FieldLayout>()) as *mut FieldLayout
        };
        let mut i: usize = 0;
        while (i < count) {
            let fty_v = unsafe { (*typeid_at(fields, i)).v };
            let fa = type_align(TypeId { v: fty_v }, ti);
            let fs = type_size(TypeId { v: fty_v }, ti);
            let fp = unsafe { field_layout_at(fl, i) };
            unsafe {
                (*fp).index = i as u32;
                (*fp).align = fa;
                (*fp).size = fs;
            }
            i = i + 1;
        }
        if k == TY_TUPLE || !is_repr_c {
            sort_fields(fl, count);
        }
        let mut offset: u32 = 0u32;
        let mut target_offset: u32 = 0u32;
        let mut j: usize = 0;
        while (j < count) {
            let fp = unsafe { field_layout_at(fl, j) };
            let f_index = unsafe { (*fp).index };
            let fa = unsafe { (*fp).align };
            let fs = unsafe { (*fp).size };
            offset = align_up_u32(offset, fa);
            if (f_index as usize) == field_idx {
                target_offset = offset;
                break;
            }
            offset = offset + fs;
            j = j + 1;
        }
        unsafe {
            heap_free(fl as *mut u8, mul_usize(count, size_of<FieldLayout>()), align_of<FieldLayout>());
        }
        return target_offset;
    }
    if k == TY_CLOSURE {
        if field_idx == 0 {
            return 0u32;
        }
        let count = unsafe { (*ty).capture_count };
        if field_idx > count {
            return 0u32;
        }
        let caps = unsafe { (*ty).captures };
        let mut offset: u32 = SIZE_8;
        let mut i: usize = 0;
        while (i < count) {
            let cap = unsafe { capture_at(caps, i) };
            let cty_v = unsafe { (*cap).ty.v };
            let a = type_align(TypeId { v: cty_v }, ti);
            let s = type_size(TypeId { v: cty_v }, ti);
            offset = align_up_u32(offset, a);
            if field_idx == i + 1 {
                return offset;
            }
            offset = offset + s;
            i = i + 1;
        }
        return offset;
    }
    0u32
}

pub fn type_enum_field_offset(
    id: TypeId,
    variant_idx: u32,
    field_idx: usize,
    ti: view<TypeInterner>
) -> u32 {
    let ty = type_get(ti, id);
    if (ty as usize) == 0 {
        return 0u32;
    }
    let k = unsafe { (*ty).kind };
    if k != TY_ENUM {
        return 0u32;
    }
    let vcount = unsafe { (*ty).variant_count };
    if (variant_idx as usize) >= vcount {
        return 0u32;
    }
    let vcounts = unsafe { (*ty).variant_field_counts };
    let vfields = unsafe { (*ty).variant_fields };
    if (vcounts as usize) == 0 || (vfields as usize) == 0 {
        return 0u32;
    }
    let count = unsafe { *usize_at(vcounts, variant_idx as usize) };
    if field_idx >= count {
        return 0u32;
    }
    let vf = unsafe { *typeid_ptr_at(vfields, variant_idx as usize) };
    let fl = unsafe {
        heap_alloc(mul_usize(count, size_of<FieldLayout>()), align_of<FieldLayout>()) as *mut FieldLayout
    };
    let mut i: usize = 0;
    while (i < count) {
        let fty_v = unsafe { (*typeid_at(vf, i)).v };
        let fa = type_align(TypeId { v: fty_v }, ti);
        let fs = type_size(TypeId { v: fty_v }, ti);
        let fp = unsafe { field_layout_at(fl, i) };
        unsafe {
            (*fp).index = i as u32;
            (*fp).align = fa;
            (*fp).size = fs;
        }
        i = i + 1;
    }
    sort_fields(fl, count);
    let mut offset: u32 = SIZE_4;
    let mut target_offset: u32 = 0u32;
    let mut j: usize = 0;
    while (j < count) {
        let fp = unsafe { field_layout_at(fl, j) };
        let f_index = unsafe { (*fp).index };
        let fa = unsafe { (*fp).align };
        let fs = unsafe { (*fp).size };
        offset = align_up_u32(offset, fa);
        if (f_index as usize) == field_idx {
            target_offset = offset;
            break;
        }
        offset = offset + fs;
        j = j + 1;
    }
    unsafe {
        heap_free(fl as *mut u8, mul_usize(count, size_of<FieldLayout>()), align_of<FieldLayout>());
    }
    target_offset
}

