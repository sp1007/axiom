    52u8, 93u8, 10u8, 32u8, 32u8, 109u8, 111u8, 118u8, 32u8, 114u8, 57u8, 44u8, 32u8, 91u8, 114u8, 97u8,
    120u8, 32u8, 43u8, 32u8, 114u8, 99u8, 120u8, 42u8, 56u8, 32u8, 43u8, 32u8, 49u8, 54u8, 93u8, 10u8,
    32u8, 32u8, 108u8, 101u8, 97u8, 32u8, 114u8, 49u8, 48u8, 44u8, 32u8, 91u8, 114u8, 105u8, 112u8, 32u8,
    43u8, 32u8, 51u8, 50u8, 93u8, 10u8, 32u8, 32u8, 40u8, 110u8, 117u8, 108u8, 108u8, 41u8, 32u8, 114u8,
    100u8, 120u8, 10u8, 32u8, 32u8, 40u8, 110u8, 117u8, 108u8, 108u8, 41u8, 32u8, 114u8, 97u8, 120u8, 44u8,
    32u8, 114u8, 97u8, 120u8, 10u8, 32u8, 32u8, 40u8, 110u8, 117u8, 108u8, 108u8, 41u8, 32u8, 49u8, 10u8,
    98u8, 98u8, 49u8, 58u8, 10u8, 32u8, 32u8, 114u8, 101u8, 116u8, 10u8, 0u8,
];
const EXPECTED_MI_TEXT_LEN: usize = 251;

fn eq_expected_mi_text(buf: view<DiagBuffer>) -> bool {
    let mut i: usize = 0;
    while i < buf.len && i < EXPECTED_MI_TEXT_LEN {
        let a = unsafe { *(buf.ptr + i) };
        let b = EXPECTED_MI_TEXT[i];
        if a != b {
            print("diff at ");
            print_int(i as i64);
            print(": ");
            print_int(a as i64);
            print(" vs ");
            print_int(b as i64);
            print(" (len ");
            print_int(buf.len as i64);
            print(")\n");
            return false;
        }
        i = i + 1;
    }
    if buf.len != EXPECTED_MI_TEXT_LEN {
        print_int(buf.len as i64);
        print(" vs ");
        print_int(EXPECTED_MI_TEXT_LEN as i64);
        print("\n");
        return false;
    }
    true
}

unsafe fn count_bb_insts(mbb: *mut X64MIBb) -> usize {
    let mut n: usize = 0;
    let mut cur = (*mbb).first_inst;
    while (cur as usize) != 0 {
        n = n + 1;
        cur = (*cur).next;
    }
    n
}

unsafe fn bb_inst_at(mbb: *mut X64MIBb, idx: usize) -> *mut X64MI {
    let mut i: usize = 0;
    let mut cur = (*mbb).first_inst;
    while (cur as usize) != 0 && i < idx {
        cur = (*cur).next;
        i = i + 1;
    }
    cur
}

unsafe fn init_lir_1bb(
    a: mut_view<Arena>,
    slot_types: *const u32,
    slot_count: usize,
    vreg_types: *const u32,
    vreg_count: usize,
    inst_count: usize
) -> *mut LirBody {
    let body = lir_body_new(mut_view(*a));
    if slot_count > 0 {
        let slots = arena_alloc_raw(mut_view(*a), slot_count * size_of<LirStackSlot>(), align_of<LirStackSlot>()) as *mut LirStackSlot;
        let mut s: usize = 0;
        while s < slot_count {
            let sp = lir_slot_at(slots, s);
            let tv = *(slot_types + s);
            (*sp).ty.v = tv;
            (*sp).is_const = false;
            s = s + 1;
        }
        (*body).slots = slots;
        (*body).slot_count = slot_count;
    }
    if vreg_count > 0 {
        let vregs = arena_alloc_raw(mut_view(*a), vreg_count * size_of<LirVReg>(), align_of<LirVReg>()) as *mut LirVReg;
        let mut v: usize = 0;
        while v < vreg_count {
            let vp = lir_vreg_at(vregs, v);
            let tv = *(vreg_types + v);
            (*vp).ty.v = tv;
            v = v + 1;
        }
        (*body).vregs = vregs;
        (*body).vreg_count = vreg_count;
    }
    let bbs = arena_alloc_raw(mut_view(*a), size_of<LirBb>(), align_of<LirBb>()) as *mut LirBb;
    let bb0 = lir_bb_at(bbs, 0);
    lir_bb_reset(mut_view(*bb0), 0u32);
    if inst_count > 0 {
        let insts = arena_alloc_raw(mut_view(*a), inst_count * size_of<LirInst>(), align_of<LirInst>()) as *mut LirInst;
        (*bb0).insts = insts;
        (*bb0).inst_count = inst_count;
    }
    lir_term_reset(mut_view((*bb0).term), LIR_TERM_RETURN);
    (*body).bbs = bbs;
    (*body).bb_count = 1;
    (*body).frame_req.max_outgoing_args_bytes = 32u32;
    (*body).frame_req.requires_16_byte_alignment = true;
    body
}

// Test 1: Machine IR data model constructors and text printer (`x64_mi_print`)
fn test_mi_data_model_and_printer(a: mut_view<Arena>, out: mut_view<DiagBuffer>) -> i32 {
    let body = x64_mi_body_new(mut_view(*a), 2);
    unsafe {
        (*body).shadow_space = 32u32;
        (*body).stack_args_size = 16u32;
        let bb0 = x64_mi_bb_at((*body).bbs, 0);
        let bb1 = x64_mi_bb_at((*body).bbs, 1);

        x64_mi_emit(mut_view(*body), mut_view(*bb0), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_imm(-42i64));
        x64_mi_emit(mut_view(*body), mut_view(*bb0), X64_MI_MOV, x64_op_frame(3u32, 0), x64_op_reg(REG_RAX));
        x64_mi_emit(mut_view(*body), mut_view(*bb0), X64_MI_MOV, x64_op_frame(4u32, -8), x64_op_reg(REG_RCX));
        x64_mi_emit(mut_view(*body), mut_view(*bb0), X64_MI_LEA, x64_op_reg(REG_RDX), x64_op_sym(100000u32));
        x64_mi_emit(mut_view(*body), mut_view(*bb0), X64_MI_MOV, x64_op_reg(REG_R8), x64_op_mem(REG_RBP, REG_NONE, 1u8, -64, false));
        x64_mi_emit(mut_view(*body), mut_view(*bb0), X64_MI_MOV, x64_op_reg(REG_R9), x64_op_mem(REG_RAX, REG_RCX, 3u8, 16, false));
        x64_mi_emit(mut_view(*body), mut_view(*bb0), X64_MI_LEA, x64_op_reg(REG_R10), x64_op_mem(REG_NONE, REG_NONE, 1u8, 32, true));
        x64_mi_emit(mut_view(*body), mut_view(*bb0), X64_MI_MUL, x64_op_reg(REG_RDX), x64_op_none());
        x64_mi_emit(mut_view(*body), mut_view(*bb0), X64_MI_TEST, x64_op_reg(REG_RAX), x64_op_reg(REG_RAX));
        x64_mi_emit(mut_view(*body), mut_view(*bb0), X64_MI_ASSERT, x64_op_imm(1i64), x64_op_none());

        x64_mi_emit(mut_view(*body), mut_view(*bb1), X64_MI_RET, x64_op_none(), x64_op_none());
    }

    out.len = 0;
    x64_mi_print(unsafe { view(*body) }, mut_view(*out));

    if !eq_expected_mi_text(view(*out)) {
        return 11;
    }

    arena_reset(mut_view(*a));
    0
}

// Test 2: CONST, CONST_STR, and FN_ADDR instruction selection
fn test_isel_constants_strings_and_fn_addr(a: mut_view<Arena>, ti_ptr: *mut TypeInterner) -> i32 {
    let i64_v = unsafe { (*ti_ptr).t_i64.v };
    let str_v = unsafe { (*ti_ptr).t_str.v };
    let mut slot_tys: [1]u32 = [i64_v];
    let mut vreg_tys: [4]u32 = [i64_v, str_v, str_v, i64_v];
    let mut str_hello: [6]u8 = [104u8, 101u8, 108u8, 108u8, 111u8, 0u8];
    let mut str_world: [4]u8 = [97u8, 98u8, 99u8, 0u8];
    let mut sym_foo: [8]u8 = [102u8, 111u8, 111u8, 95u8, 115u8, 121u8, 109u8, 0u8];

    let lir = unsafe {
        init_lir_1bb(mut_view(*a), address_of_mut(slot_tys[0]) as *const u32, 1, address_of_mut(vreg_tys[0]) as *const u32, 4, 4)
    };
    let bb0 = unsafe { lir_bb_at((*lir).bbs, 0) };
    let sym_foo_ptr = unsafe { address_of_mut(sym_foo[0]) as *const u8 };
    unsafe {
        let i0 = lir_inst_at((*bb0).insts, 0);
        lir_inst_reset(mut_view(*i0), LIR_INST_CONST);
        (*i0).dest.v = 0u32;
        (*i0).const_val = 123456789u64;

        let i1 = lir_inst_at((*bb0).insts, 1);
        lir_inst_reset(mut_view(*i1), LIR_INST_CONST_STR);
        (*i1).dest.v = 1u32;
        (*i1).str_bytes = address_of_mut(str_hello[0]) as *const u8;
        (*i1).str_len = 5;

        let i2 = lir_inst_at((*bb0).insts, 2);
        lir_inst_reset(mut_view(*i2), LIR_INST_CONST_STR);
        (*i2).dest.v = 2u32;
        (*i2).str_bytes = address_of_mut(str_world[0]) as *const u8;
        (*i2).str_len = 3;

        let i3 = lir_inst_at((*bb0).insts, 3);
        lir_inst_reset(mut_view(*i3), LIR_INST_FN_ADDR);
        (*i3).dest.v = 3u32;
        (*i3).sym_name = sym_foo_ptr;
        (*i3).sym_len = 7;
    }

    let mi = x64_isel(unsafe { view(*lir) }, unsafe { view(*ti_ptr) });
    if (mi as usize) == 0 {
        return 201;
    }
    if (unsafe { (*mi).string_count }) != 2 {
        return 202;
    }
    let s0 = unsafe { x64_mi_str_at((*mi).strings, 0) };
    let s1 = unsafe { x64_mi_str_at((*mi).strings, 1) };
    if (unsafe { (*s0).sym_id }) != 100000u32 || (unsafe { (*s0).len }) != 5 {
        return 203;
    }
    if (unsafe { (*s1).sym_id }) != 100001u32 || (unsafe { (*s1).len }) != 3 {
        return 204;
    }

    let mbb0 = unsafe { x64_mi_bb_at((*mi).bbs, 0) };
    // 2 (const) + 4 (const_str 0) + 4 (const_str 1) + 2 (fn_addr) + 2 (return) = 14 instructions
    if (unsafe { count_bb_insts(mbb0) }) != 14 {
        return 205;
    }

    // Check const_str 0: lea rax, sym#100000; mov [frame#2 + 0], rax; mov rax, 5; mov [frame#2 + 8], rax
    let cs_lea = unsafe { bb_inst_at(mbb0, 2) };
    let cs_m0 = unsafe { bb_inst_at(mbb0, 3) };
    let cs_len = unsafe { bb_inst_at(mbb0, 4) };
    let cs_m8 = unsafe { bb_inst_at(mbb0, 5) };
    if (unsafe { (*cs_lea).opcode }) != X64_MI_LEA ||
       (unsafe { (*cs_lea).ops[1].kind }) != X64_OP_SYM ||
       (unsafe { (*cs_lea).ops[1].sym }) != 100000u32 {
        return 206;
    }
    if (unsafe { (*cs_m0).ops[0].frame.slot_id }) != 2u32 || (unsafe { (*cs_m0).ops[0].frame.offset }) != 0 {
        return 207;
    }
    if (unsafe { (*cs_len).ops[1].imm }) != 5i64 {
        return 208;
    }
    if (unsafe { (*cs_m8).ops[0].frame.slot_id }) != 2u32 || (unsafe { (*cs_m8).ops[0].frame.offset }) != 8 {
        return 209;
    }

    // Check fn_addr: lea rax, sym#0 with msg == sym_foo_ptr
    let fn_lea = unsafe { bb_inst_at(mbb0, 10) };
    if (unsafe { (*fn_lea).opcode }) != X64_MI_LEA ||
       (unsafe { (*fn_lea).ops[1].kind }) != X64_OP_SYM ||
       (unsafe { (*fn_lea).msg as usize }) != (sym_foo_ptr as usize) {
        return 210;
    }

    arena_reset(mut_view(*a));
    0
}

// Test 3: Binary ALU, shifts, and signed/unsigned sub-64-bit truncation (`emit_trunc`)
fn test_isel_alu_shifts_and_truncation(a: mut_view<Arena>, ti_ptr: *mut TypeInterner) -> i32 {
    let i8_v = unsafe { (*ti_ptr).t_i8.v };
    let u8_v = unsafe { (*ti_ptr).t_u8.v };
    let i16_v = unsafe { (*ti_ptr).t_i16.v };
    let u16_v = unsafe { (*ti_ptr).t_u16.v };
    let i32_v = unsafe { (*ti_ptr).t_i32.v };
    let u32_v = unsafe { (*ti_ptr).t_u32.v };
    let i64_v = unsafe { (*ti_ptr).t_i64.v };
    let bool_v = unsafe { (*ti_ptr).t_bool.v };

    let mut slot_tys: [1]u32 = [i64_v];
    let mut vreg_tys: [11]u32 = [i64_v, i64_v, i8_v, u8_v, i16_v, u16_v, i32_v, u32_v, i64_v, bool_v, i64_v];

    let lir = unsafe {
        init_lir_1bb(mut_view(*a), address_of_mut(slot_tys[0]) as *const u32, 1, address_of_mut(vreg_tys[0]) as *const u32, 11, 9)
    };
    let bb0 = unsafe { lir_bb_at((*lir).bbs, 0) };
    let kinds: [9]u8 = [
        LIR_INST_ADD, LIR_INST_SUB, LIR_INST_MUL, LIR_INST_BIT_AND,
        LIR_INST_SHL, LIR_INST_SHR, LIR_INST_SAR, LIR_INST_BIT_XOR, LIR_INST_BIT_OR
    ];
    let mut k: usize = 0;
    while k < 9 {
        let inst = unsafe { lir_inst_at((*bb0).insts, k) };
        unsafe {
            lir_inst_reset(mut_view(*inst), kinds[k]);
            (*inst).dest.v = (2 + k) as u32;
            (*inst).lhs.v = 0u32;
            (*inst).rhs.v = 1u32;
        }
        k = k + 1;
    }

    let mi = x64_isel(unsafe { view(*lir) }, unsafe { view(*ti_ptr) });
    let mbb0 = unsafe { x64_mi_bb_at((*mi).bbs, 0) };

    let i8_shl = unsafe { bb_inst_at(mbb0, 2) };
    let i8_sar = unsafe { bb_inst_at(mbb0, 3) };
    if (unsafe { (*i8_shl).opcode }) != X64_MI_SHL || (unsafe { (*i8_shl).ops[1].imm }) != 56i64 ||
       (unsafe { (*i8_sar).opcode }) != X64_MI_SAR || (unsafe { (*i8_sar).ops[1].imm }) != 56i64 {
        return 301;
    }

    let u8_and = unsafe { bb_inst_at(mbb0, 7) };
    if (unsafe { (*u8_and).opcode }) != X64_MI_AND || (unsafe { (*u8_and).ops[1].imm }) != 255i64 {
        return 302;
    }

    let i16_imul = unsafe { bb_inst_at(mbb0, 10) };
    let i16_shl = unsafe { bb_inst_at(mbb0, 11) };
    let i16_sar = unsafe { bb_inst_at(mbb0, 12) };
    if (unsafe { (*i16_imul).opcode }) != X64_MI_IMUL ||
       (unsafe { (*i16_shl).opcode }) != X64_MI_SHL || (unsafe { (*i16_shl).ops[1].imm }) != 48i64 ||
       (unsafe { (*i16_sar).opcode }) != X64_MI_SAR || (unsafe { (*i16_sar).ops[1].imm }) != 48i64 {
        return 303;
    }

    let u16_and = unsafe { bb_inst_at(mbb0, 16) };
    if (unsafe { (*u16_and).opcode }) != X64_MI_AND || (unsafe { (*u16_and).ops[1].imm }) != 65535i64 {
        return 304;
    }

    let shl_rcx = unsafe { bb_inst_at(mbb0, 20) };
    let i32_shl = unsafe { bb_inst_at(mbb0, 21) };
    let i32_sar = unsafe { bb_inst_at(mbb0, 22) };
    if (unsafe { (*shl_rcx).opcode }) != X64_MI_SHL || (unsafe { (*shl_rcx).ops[1].reg }) != REG_RCX ||
       (unsafe { (*i32_shl).opcode }) != X64_MI_SHL || (unsafe { (*i32_shl).ops[1].imm }) != 32i64 ||
       (unsafe { (*i32_sar).opcode }) != X64_MI_SAR || (unsafe { (*i32_sar).ops[1].imm }) != 32i64 {
        return 305;
    }

    let shr_rcx = unsafe { bb_inst_at(mbb0, 26) };
    let u32_shl = unsafe { bb_inst_at(mbb0, 27) };
    let u32_shr = unsafe { bb_inst_at(mbb0, 28) };
    if (unsafe { (*shr_rcx).opcode }) != X64_MI_SHR || (unsafe { (*shr_rcx).ops[1].reg }) != REG_RCX ||
       (unsafe { (*u32_shl).opcode }) != X64_MI_SHL || (unsafe { (*u32_shl).ops[1].imm }) != 32i64 ||
       (unsafe { (*u32_shr).opcode }) != X64_MI_SHR || (unsafe { (*u32_shr).ops[1].imm }) != 32i64 {
        return 306;
    }

    let sar_rcx = unsafe { bb_inst_at(mbb0, 32) };
    let sar_store = unsafe { bb_inst_at(mbb0, 33) };
    if (unsafe { (*sar_rcx).opcode }) != X64_MI_SAR || (unsafe { (*sar_store).opcode }) != X64_MI_MOV {
        return 307;
    }

    arena_reset(mut_view(*a));
    0
}

// Test 4: All 10 ICMP_* opcodes, DIV, REM, NEG, NOT, BITNOT, and checked overflow ops
fn test_isel_icmp_unary_div_and_overflow(a: mut_view<Arena>, ti_ptr: *mut TypeInterner) -> i32 {
    let i64_v = unsafe { (*ti_ptr).t_i64.v };
    let i32_v = unsafe { (*ti_ptr).t_i32.v };
    let bool_v = unsafe { (*ti_ptr).t_bool.v };

    let mut slot_tys: [1]u32 = [i64_v];
    let mut vreg_tys: [32]u32 = [0u32; 32];
    vreg_tys[0] = i64_v;
    vreg_tys[1] = i64_v;
    let mut vi: usize = 2;
    while vi < 12 {
        vreg_tys[vi] = bool_v;
        vi = vi + 1;
    }
    vreg_tys[12] = i64_v;
    vreg_tys[13] = i64_v;
    vreg_tys[14] = i64_v;
    vreg_tys[15] = bool_v;
    vreg_tys[16] = i32_v;
    let mut vo: usize = 17;
    while vo < 29 {
        vreg_tys[vo] = bool_v;
        vo = vo + 1;
    }

    let lir = unsafe {
        init_lir_1bb(mut_view(*a), address_of_mut(slot_tys[0]) as *const u32, 1, address_of_mut(vreg_tys[0]) as *const u32, 29, 25)
    };
    let bb0 = unsafe { lir_bb_at((*lir).bbs, 0) };

    let icmp_kinds: [10]u8 = [
        LIR_INST_ICMP_EQ, LIR_INST_ICMP_NE, LIR_INST_ICMP_SLT, LIR_INST_ICMP_SLE, LIR_INST_ICMP_SGT,
        LIR_INST_ICMP_SGE, LIR_INST_ICMP_ULT, LIR_INST_ICMP_ULE, LIR_INST_ICMP_UGT, LIR_INST_ICMP_UGE
    ];
    let exp_ccs: [10]u8 = [
        CC_E, CC_NE, CC_L, CC_LE, CC_G, CC_GE, CC_B, CC_BE, CC_A, CC_AE
    ];
    let mut c: usize = 0;
    while c < 10 {
        let inst = unsafe { lir_inst_at((*bb0).insts, c) };
        unsafe {
            lir_inst_reset(mut_view(*inst), icmp_kinds[c]);
            (*inst).dest.v = (2 + c) as u32;
            (*inst).lhs.v = 0u32;
            (*inst).rhs.v = 1u32;
        }
        c = c + 1;
    }

    unsafe {
        let idiv = lir_inst_at((*bb0).insts, 10);
        lir_inst_reset(mut_view(*idiv), LIR_INST_DIV);
        (*idiv).dest.v = 12u32;
        (*idiv).lhs.v = 0u32;
        (*idiv).rhs.v = 1u32;

        let irem = lir_inst_at((*bb0).insts, 11);
        lir_inst_reset(mut_view(*irem), LIR_INST_REM);
        (*irem).dest.v = 13u32;
        (*irem).lhs.v = 0u32;
        (*irem).rhs.v = 1u32;

        let ineg = lir_inst_at((*bb0).insts, 12);
        lir_inst_reset(mut_view(*ineg), LIR_INST_NEG);
        (*ineg).dest.v = 14u32;
        (*ineg).operand.v = 0u32;

        let inot = lir_inst_at((*bb0).insts, 13);
        lir_inst_reset(mut_view(*inot), LIR_INST_NOT);
        (*inot).dest.v = 15u32;
        (*inot).operand.v = 0u32;

        let ibnot = lir_inst_at((*bb0).insts, 14);
        lir_inst_reset(mut_view(*ibnot), LIR_INST_BITNOT);
        (*ibnot).dest.v = 16u32;
        (*ibnot).operand.v = 0u32;
    }

    let ovf_kinds: [10]u8 = [
        LIR_INST_UADD_OVERFLOW, LIR_INST_USUB_OVERFLOW, LIR_INST_UMUL_OVERFLOW,
        LIR_INST_UADD_OVERFLOW, LIR_INST_UMUL_OVERFLOW,
        LIR_INST_SADD_OVERFLOW, LIR_INST_SSUB_OVERFLOW, LIR_INST_SMUL_OVERFLOW,
        LIR_INST_UDIV_OVERFLOW, LIR_INST_SDIV_OVERFLOW
    ];
    let ovf_bws: [10]u32 = [8u32, 16u32, 32u32, 64u32, 64u32, 8u32, 32u32, 64u32, 64u32, 64u32];
    let mut ov: usize = 0;
    while ov < 10 {
        let inst = unsafe { lir_inst_at((*bb0).insts, 15 + ov) };
        unsafe {
            lir_inst_reset(mut_view(*inst), ovf_kinds[ov]);
            (*inst).dest.v = (17 + ov) as u32;
            (*inst).lhs.v = 0u32;
            (*inst).rhs.v = 1u32;
            (*inst).bit_width = ovf_bws[ov];
        }
        ov = ov + 1;
    }

    let mi = x64_isel(unsafe { view(*lir) }, unsafe { view(*ti_ptr) });
    let mbb0 = unsafe { x64_mi_bb_at((*mi).bbs, 0) };

    let mut ci: usize = 0;
    while ci < 10 {
        let setcc_inst = unsafe { bb_inst_at(mbb0, ci * 6 + 2) };
        if (unsafe { (*setcc_inst).opcode }) != X64_MI_SETCC ||
           (unsafe { (*setcc_inst).ops[0].imm as u8 }) != exp_ccs[ci] {
            return (400 + ci) as i32;
        }
        ci = ci + 1;
    }

    let div_idiv = unsafe { bb_inst_at(mbb0, 63) };
    let div_mov = unsafe { bb_inst_at(mbb0, 64) };
    if (unsafe { (*div_idiv).opcode }) != X64_MI_IDIV || (unsafe { (*div_mov).ops[1].reg }) != REG_RAX {
        return 420;
    }
    let rem_mov = unsafe { bb_inst_at(mbb0, 69) };
    if (unsafe { (*rem_mov).ops[1].reg }) != REG_RDX {
        return 421;
    }
    let neg_sub = unsafe { bb_inst_at(mbb0, 72) };
    if (unsafe { (*neg_sub).opcode }) != X64_MI_SUB || (unsafe { (*neg_sub).ops[0].reg }) != REG_RCX {
        return 422;
    }
    let not_xor = unsafe { bb_inst_at(mbb0, 75) };
    if (unsafe { (*not_xor).opcode }) != X64_MI_XOR || (unsafe { (*not_xor).ops[1].imm }) != 1i64 {
        return 423;
    }
    let bnot_sub = unsafe { bb_inst_at(mbb0, 78) };
    let bnot_shl = unsafe { bb_inst_at(mbb0, 79) };
    if (unsafe { (*bnot_sub).opcode }) != X64_MI_SUB || (unsafe { (*bnot_sub).ops[0].reg }) != REG_R10 ||
       (unsafe { (*bnot_shl).opcode }) != X64_MI_SHL || (unsafe { (*bnot_shl).ops[0].reg }) != REG_R10 {
        return 424;
    }

    arena_reset(mut_view(*a));
    0
}

// Test 5: ABI_ARG, CALL, ABI_RESULT, STACK_ADDR, LOAD/STORE, and Terminators
fn test_isel_abi_calls_loads_stores_and_terminators(a: mut_view<Arena>, ti_ptr: *mut TypeInterner) -> i32 {
    let i32_v = unsafe { (*ti_ptr).t_i32.v };
    let u8_v = unsafe { (*ti_ptr).t_u8.v };
    let i64_v = unsafe { (*ti_ptr).t_i64.v };
    let unit_v = unsafe { (*ti_ptr).t_unit.v };
    let arr16_id = unsafe { intern_array_ty(mut_view(*ti_ptr), TypeId { v: i32_v }, 4u64) };
    let arr15_id = unsafe { intern_array_ty(mut_view(*ti_ptr), TypeId { v: u8_v }, 15u64) };
    let arr16_v = arr16_id.v;
    let arr15_v = arr15_id.v;

    let fn16_id = unsafe { intern_fn_ty(mut_view(*ti_ptr), false, StrId { v: 0u32 }, 0 as *mut TypeId, 0, arr16_id) };
    let fn16_v = fn16_id.v;

    let slot_tys: [2]u32 = [arr16_v, arr15_v];
    let vreg_tys: [6]u32 = [i32_v, arr16_v, i64_v, arr15_v, i64_v, i32_v];
    let mut sym_foo: [8]u8 = [102u8, 111u8, 111u8, 95u8, 115u8, 121u8, 109u8, 0u8];
    let mut msg_assert: [12]u8 = [111u8, 118u8, 101u8, 114u8, 102u8, 108u8, 111u8, 119u8, 33u8, 0u8, 0u8, 0u8];
    let sym_foo_ptr = unsafe { address_of_mut(sym_foo[0]) as *const u8 };
    let msg_assert_ptr = unsafe { address_of_mut(msg_assert[0]) as *const u8 };

    let lir = lir_body_new(mut_view(*a));
    let slots = arena_alloc_raw(mut_view(*a), 2 * size_of<LirStackSlot>(), align_of<LirStackSlot>()) as *mut LirStackSlot;
    unsafe {
        (*lir_slot_at(slots, 0)).ty.v = slot_tys[0];
        (*lir_slot_at(slots, 0)).is_const = false;
        (*lir_slot_at(slots, 1)).ty.v = slot_tys[1];
        (*lir_slot_at(slots, 1)).is_const = false;
        (*lir).slots = slots;
        (*lir).slot_count = 2;
    }
    let vregs = arena_alloc_raw(mut_view(*a), 6 * size_of<LirVReg>(), align_of<LirVReg>()) as *mut LirVReg;
    let mut vi: usize = 0;
    while vi < 6 {
        unsafe { (*lir_vreg_at(vregs, vi)).ty.v = vreg_tys[vi]; }
        vi = vi + 1;
    }
    unsafe {
        (*lir).vregs = vregs;
        (*lir).vreg_count = 6;
    }

    let bbs = arena_alloc_raw(mut_view(*a), 4 * size_of<LirBb>(), align_of<LirBb>()) as *mut LirBb;
    let bb0 = unsafe { lir_bb_at(bbs, 0) };
    let bb1 = unsafe { lir_bb_at(bbs, 1) };
    let bb2 = unsafe { lir_bb_at(bbs, 2) };
    let bb3 = unsafe { lir_bb_at(bbs, 3) };
    unsafe {
        lir_bb_reset(mut_view(*bb0), 0u32);
        lir_bb_reset(mut_view(*bb1), 1u32);
        lir_bb_reset(mut_view(*bb2), 2u32);
        lir_bb_reset(mut_view(*bb3), 3u32);
    }

    let insts0 = arena_alloc_raw(mut_view(*a), 14 * size_of<LirInst>(), align_of<LirInst>()) as *mut LirInst;
    unsafe {
        let p0 = lir_inst_at(insts0, 0);
        lir_inst_reset(mut_view(*p0), LIR_INST_ABI_ARG);
        (*p0).dest.v = 0u32;
        (*p0).loc_kind = ABI_LOC_REG;
        (*p0).loc_reg_or_offset = REG_RDX as u32;

        let p1 = lir_inst_at(insts0, 1);
        lir_inst_reset(mut_view(*p1), LIR_INST_ABI_ARG);
        (*p1).dest.v = 0u32;
        (*p1).loc_kind = ABI_LOC_STACK;
        (*p1).loc_reg_or_offset = 32u32;

        let p2 = lir_inst_at(insts0, 2);
        lir_inst_reset(mut_view(*p2), LIR_INST_ABI_ARG);
        (*p2).dest.v = 1u32;
        (*p2).loc_kind = ABI_LOC_INDIRECT;
        (*p2).loc_reg_or_offset = REG_R8 as u32;

        let p3 = lir_inst_at(insts0, 3);
        lir_inst_reset(mut_view(*p3), LIR_INST_ABI_ARG);
        (*p3).dest.v = 1u32;
        (*p3).loc_kind = ABI_LOC_INDIRECT;
        (*p3).loc_reg_or_offset = 40u32;

        let p4 = lir_inst_at(insts0, 4);
        lir_inst_reset(mut_view(*p4), LIR_INST_ABI_ARG);
        (*p4).dest.v = LIR_VREG_NONE;
        (*p4).val.v = 0u32;
        (*p4).loc_kind = ABI_LOC_REG;
        (*p4).loc_reg_or_offset = REG_RCX as u32;

        let p5 = lir_inst_at(insts0, 5);
        lir_inst_reset(mut_view(*p5), LIR_INST_ABI_ARG);
        (*p5).dest.v = LIR_VREG_NONE;
        (*p5).val.v = 0u32;
        (*p5).loc_kind = ABI_LOC_STACK;
        (*p5).loc_reg_or_offset = 32u32;

        let p6 = lir_inst_at(insts0, 6);
        lir_inst_reset(mut_view(*p6), LIR_INST_ABI_ARG);
        (*p6).dest.v = LIR_VREG_NONE;
        (*p6).val.v = 1u32;
        (*p6).loc_kind = ABI_LOC_INDIRECT;
        (*p6).loc_reg_or_offset = REG_RDX as u32;

        let p7 = lir_inst_at(insts0, 7);
        lir_inst_reset(mut_view(*p7), LIR_INST_ABI_ARG);
        (*p7).dest.v = LIR_VREG_NONE;
        (*p7).val.v = 1u32;
        (*p7).loc_kind = ABI_LOC_INDIRECT;
        (*p7).loc_reg_or_offset = 40u32;

        let p8 = lir_inst_at(insts0, 8);
        lir_inst_reset(mut_view(*p8), LIR_INST_CALL);
        (*p8).callee_ty.v = fn16_v;
        (*p8).dst_addr.v = 2u32;
        (*p8).sym_name = sym_foo_ptr;
        (*p8).sym_len = 7;

        let p9 = lir_inst_at(insts0, 9);
        lir_inst_reset(mut_view(*p9), LIR_INST_CALL);
        (*p9).callee_ty.v = fn16_v;
        (*p9).dst_addr.v = 2u32;
        (*p9).callee_vreg.v = 4u32;

        let p10 = lir_inst_at(insts0, 10);
        lir_inst_reset(mut_view(*p10), LIR_INST_ABI_RESULT);
        (*p10).dest.v = 1u32;
        (*p10).loc_kind = ABI_LOC_INDIRECT;
        (*p10).loc_reg_or_offset = REG_RAX as u32;

        let p11 = lir_inst_at(insts0, 11);
        lir_inst_reset(mut_view(*p11), LIR_INST_STACK_ADDR);
        (*p11).dest.v = 2u32;
        (*p11).slot.v = 0u32;

        let p12 = lir_inst_at(insts0, 12);
        lir_inst_reset(mut_view(*p12), LIR_INST_LOAD);
        (*p12).dest.v = 3u32;
        (*p12).ptr.v = 2u32;
        (*p12).ty.v = arr15_v;

        let p13 = lir_inst_at(insts0, 13);
        lir_inst_reset(mut_view(*p13), LIR_INST_STORE);
        (*p13).ptr.v = 2u32;
        (*p13).val.v = 3u32;

        (*bb0).insts = insts0;
        (*bb0).inst_count = 14;

        let sw_targets = arena_alloc_raw(mut_view(*a), 2 * size_of<LirSwitchTarget>(), align_of<LirSwitchTarget>()) as *mut LirSwitchTarget;
        (*lir_switch_target_at(sw_targets, 0)).val = 10u64;
        (*lir_switch_target_at(sw_targets, 0)).target.v = 1u32;
        (*lir_switch_target_at(sw_targets, 1)).val = 20u64;
        (*lir_switch_target_at(sw_targets, 1)).target.v = 2u32;
        lir_term_reset(mut_view((*bb0).term), LIR_TERM_SWITCH);
        (*bb0).term.cond.v = 5u32;
        (*bb0).term.targets = sw_targets;
        (*bb0).term.count = 2;
        (*bb0).term.otherwise.v = 3u32;

        lir_term_reset(mut_view((*bb1).term), LIR_TERM_ASSERT);
        (*bb1).term.cond.v = 5u32;
        (*bb1).term.assert_target.v = 2u32;
        (*bb1).term.msg_ptr = msg_assert_ptr;
        (*bb1).term.msg_len = 9;

        lir_term_reset(mut_view((*bb2).term), LIR_TERM_JCC);
        (*bb2).term.cond.v = 5u32;
        (*bb2).term.then_target.v = 3u32;
        (*bb2).term.else_target.v = 1u32;

        lir_term_reset(mut_view((*bb3).term), LIR_TERM_RETURN);

        (*lir).bbs = bbs;
        (*lir).bb_count = 4;
    }

    let mi = x64_isel(unsafe { view(*lir) }, unsafe { view(*ti_ptr) });
    let mbb0 = unsafe { x64_mi_bb_at((*mi).bbs, 0) };
    let mbb1 = unsafe { x64_mi_bb_at((*mi).bbs, 1) };
    let mbb2 = unsafe { x64_mi_bb_at((*mi).bbs, 2) };

    let first0 = unsafe { bb_inst_at(mbb0, 0) };
    if (unsafe { (*first0).opcode }) != X64_MI_MOV ||
       (unsafe { (*first0).ops[0].kind }) != X64_OP_FRAME ||
       (unsafe { (*first0).ops[0].frame.slot_id }) != 0u32 ||
       (unsafe { (*first0).ops[1].reg }) != REG_RCX {
        return 501;
    }

    let in_stk = unsafe { bb_inst_at(mbb0, 2) };
    if (unsafe { (*in_stk).ops[1].kind }) != X64_OP_MEM ||
       (unsafe { (*in_stk).ops[1].mem.base }) != REG_RBP ||
       (unsafe { (*in_stk).ops[1].mem.disp }) != 48 {
        return 502;
    }

    let call_sret = unsafe { bb_inst_at(mbb0, 21) };
    let call_dir = unsafe { bb_inst_at(mbb0, 22) };
    if (unsafe { (*call_sret).opcode }) != X64_MI_MOV ||
       (unsafe { (*call_sret).ops[0].reg }) != REG_RCX ||
       (unsafe { (*call_dir).opcode }) != X64_MI_CALL ||
       (unsafe { (*call_dir).msg as usize }) != (sym_foo_ptr as usize) {
        return 507;
    }

    if (unsafe { count_bb_insts(mbb1) }) != 3 {
        return 503;
    }
    let as_inst = unsafe { bb_inst_at(mbb1, 2) };
    if (unsafe { (*as_inst).opcode }) != X64_MI_ASSERT ||
       (unsafe { (*as_inst).ops[0].imm }) != 2i64 ||
       (unsafe { (*as_inst).msg as usize }) != (msg_assert_ptr as usize) {
        return 504;
    }

    if (unsafe { count_bb_insts(mbb2) }) != 4 {
        return 505;
    }

    unsafe { (*lir_slot_at(slots, 0)).ty.v = unit_v; }
    let mi_unit = x64_isel(unsafe { view(*lir) }, unsafe { view(*ti_ptr) });
    let mbb3_u = unsafe { x64_mi_bb_at((*mi_unit).bbs, 3) };
    let u_mov = unsafe { bb_inst_at(mbb3_u, 0) };
    if (unsafe { (*u_mov).opcode }) != X64_MI_MOV ||
       (unsafe { (*u_mov).ops[1].kind }) != X64_OP_IMM ||
       (unsafe { (*u_mov).ops[1].imm }) != 0i64 {
        return 506;
    }

    arena_reset(mut_view(*a));
    0
}

pub fn main() -> i32 {
    let mut perm = arena_with_chunk_size(131072);
    let _ = arena_alloc_raw(mut_view(perm), 16, 8);
    let mut a = arena_with_chunk_size(131072);
    let _ = arena_alloc_raw(mut_view(a), 16, 8);

    let ti_ptr = arena_alloc_raw(mut_view(perm), size_of<TypeInterner>(), align_of<TypeInterner>()) as *mut TypeInterner;
    unsafe { type_interner_init(mut_view(*ti_ptr)); }

    let mut out = diag_buf_new();
    out.ptr = arena_alloc_raw(mut_view(perm), 16384, 1);
    out.cap = 16384;

    let rc1 = test_mi_data_model_and_printer(mut_view(a), mut_view(out));
    if rc1 != 0 { return rc1; }

    let rc2 = test_isel_constants_strings_and_fn_addr(mut_view(a), ti_ptr);
    if rc2 != 0 { return rc2; }

    let rc3 = test_isel_alu_shifts_and_truncation(mut_view(a), ti_ptr);
    if rc3 != 0 { return rc3; }

    let rc4 = test_isel_icmp_unary_div_and_overflow(mut_view(a), ti_ptr);
    if rc4 != 0 { return rc4; }

    let rc5 = test_isel_abi_calls_loads_stores_and_terminators(mut_view(a), ti_ptr);
    if rc5 != 0 { return rc5; }

    unsafe { type_interner_free(mut_view(*ti_ptr)); }
    arena_destroy(mut_view(a));
    arena_destroy(mut_view(perm));
    print("OK x64 Instruction Selection & ABI Lowering\n");
    0
}
