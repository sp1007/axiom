    53u8, 53u8, 32u8, 52u8, 56u8, 32u8, 56u8, 57u8, 32u8, 101u8, 53u8, 32u8, 53u8, 51u8, 32u8, 53u8,
    54u8, 32u8, 53u8, 55u8, 32u8, 52u8, 49u8, 32u8, 53u8, 52u8, 32u8, 52u8, 49u8, 32u8, 53u8, 53u8,
    32u8, 52u8, 49u8, 32u8, 53u8, 54u8, 32u8, 52u8, 49u8, 32u8, 53u8, 55u8, 32u8, 52u8, 56u8, 32u8,
    56u8, 51u8, 32u8, 101u8, 99u8, 32u8, 51u8, 56u8, 32u8, 52u8, 56u8, 32u8, 98u8, 56u8, 32u8, 50u8,
    97u8, 32u8, 48u8, 48u8, 32u8, 48u8, 48u8, 32u8, 48u8, 48u8, 32u8, 48u8, 48u8, 32u8, 48u8, 48u8,
    32u8, 48u8, 48u8, 32u8, 48u8, 48u8, 32u8, 52u8, 56u8, 32u8, 56u8, 57u8, 32u8, 52u8, 53u8, 32u8,
    98u8, 56u8, 32u8, 52u8, 56u8, 32u8, 56u8, 100u8, 32u8, 52u8, 53u8, 32u8, 99u8, 48u8, 32u8, 52u8,
    56u8, 32u8, 56u8, 57u8, 32u8, 52u8, 53u8, 32u8, 98u8, 48u8, 32u8, 52u8, 56u8, 32u8, 56u8, 98u8,
    32u8, 52u8, 53u8, 32u8, 98u8, 48u8, 32u8, 52u8, 56u8, 32u8, 56u8, 98u8, 32u8, 52u8, 100u8, 32u8,
    98u8, 56u8, 32u8, 52u8, 56u8, 32u8, 56u8, 57u8, 32u8, 48u8, 56u8, 32u8, 52u8, 56u8, 32u8, 56u8,
    98u8, 32u8, 52u8, 53u8, 32u8, 99u8, 48u8, 32u8, 52u8, 56u8, 32u8, 56u8, 51u8, 32u8, 99u8, 52u8,
    32u8, 51u8, 56u8, 32u8, 52u8, 49u8, 32u8, 53u8, 102u8, 32u8, 52u8, 49u8, 32u8, 53u8, 101u8, 32u8,
    52u8, 49u8, 32u8, 53u8, 100u8, 32u8, 52u8, 49u8, 32u8, 53u8, 99u8, 32u8, 53u8, 102u8, 32u8, 53u8,
    101u8, 32u8, 53u8, 98u8, 32u8, 53u8, 100u8, 32u8, 99u8, 51u8, 32u8, 10u8, 0u8,
];
const MAIN_42_MC_LEN: usize = 220;


fn bytes_eq_main_42_mc(buf: view<DiagBuffer>) -> bool {
    if buf.len != MAIN_42_MC_LEN {
        return false;
    }
    let mut i: usize = 0;
    while i < MAIN_42_MC_LEN {
        if (unsafe { *(buf.ptr + i) }) != MAIN_42_MC[i] {
            return false;
        }
        i = i + 1;
    }
    true
}

unsafe fn sec_byte(sec: *mut Section, idx: usize) -> u8 {
    *((( (*sec).bytes as usize ) + idx) as *const u8)
}

unsafe fn bb_inst_at(mbb: *mut X64MIBb, idx: usize) -> *mut X64MI {
    let mut i: usize = 0;
    let mut cur = (*mbb).first_inst;
    while (cur as usize) != 0 && i < idx {
        cur = (*cur).next;
        i = i + 1;
    }
    cur
}

fn test_frame_lower_layout_and_rewriting(a: mut_view<Arena>, ti_ptr: *mut TypeInterner) -> i32 {
    let i32_v = unsafe { (*ti_ptr).t_i32.v };
    let i64_v = unsafe { (*ti_ptr).t_i64.v };
    let arr16_id = unsafe { intern_array_ty(mut_view(*ti_ptr), TypeId { v: i64_v }, 2u64) };

    let lir = lir_body_new(mut_view(*a));
    let slots = arena_alloc_raw(mut_view(*a), 3 * size_of<LirStackSlot>(), align_of<LirStackSlot>()) as *mut LirStackSlot;
    unsafe {
        (*lir_slot_at(slots, 0)).ty.v = i32_v;
        (*lir_slot_at(slots, 0)).is_const = false;
        (*lir_slot_at(slots, 1)).ty.v = i32_v;
        (*lir_slot_at(slots, 1)).is_const = true;
        (*lir_slot_at(slots, 2)).ty.v = arr16_id.v;
        (*lir_slot_at(slots, 2)).is_const = false;
        (*lir).slots = slots;
        (*lir).slot_count = 3;
    }
    let vregs = arena_alloc_raw(mut_view(*a), 2 * size_of<LirVReg>(), align_of<LirVReg>()) as *mut LirVReg;
    unsafe {
        (*lir_vreg_at(vregs, 0)).ty.v = i32_v;
        (*lir_vreg_at(vregs, 1)).ty.v = i64_v;
        (*lir).vregs = vregs;
        (*lir).vreg_count = 2;
    }

    let mi = x64_mi_body_new(mut_view(*a), 1);
    let mbb0 = unsafe { x64_mi_bb_at((*mi).bbs, 0) };
    unsafe {
        (*mi).shadow_space = 16u32;
        x64_mi_emit(mut_view(*mi), mut_view(*mbb0), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(0u32, 0));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb0), X64_MI_MOV, x64_op_frame(2u32, 8), x64_op_reg(REG_RAX));
        x64_mi_emit(mut_view(*mi), mut_view(*mbb0), X64_MI_MOV, x64_op_frame(4u32, 0), x64_op_reg(REG_RCX));
    }

    let layout = x64_frame_lower(unsafe { mut_view(*mi) }, unsafe { view(*lir) }, unsafe { view(*ti_ptr) });

    if (unsafe { (*mi).shadow_space }) != 32u32 {
        return 11;
    }
    if layout.slot_count != 5u32 {
        return 12;
    }
    if x64_frame_slot_offset(view(layout), 0u32) != -64 ||
       x64_frame_slot_offset(view(layout), 1u32) != 0 ||
       x64_frame_slot_offset(view(layout), 2u32) != -80 ||
       x64_frame_slot_offset(view(layout), 3u32) != -88 ||
       x64_frame_slot_offset(view(layout), 4u32) != -96 {
        return 13;
    }
    if layout.frame_size != 72u32 || ((layout.frame_size + 56u32) % 16u32) != 0u32 {
        return 14;
    }

    let inst0 = unsafe { bb_inst_at(mbb0, 0) };
    let inst1 = unsafe { bb_inst_at(mbb0, 1) };
    let inst2 = unsafe { bb_inst_at(mbb0, 2) };
    if (unsafe { (*inst0).ops[1].kind }) != X64_OP_MEM ||
       (unsafe { (*inst0).ops[1].mem.base }) != REG_RBP ||
       (unsafe { (*inst0).ops[1].mem.disp }) != -64 {
        return 15;
    }
    if (unsafe { (*inst1).ops[0].kind }) != X64_OP_MEM ||
       (unsafe { (*inst1).ops[0].mem.base }) != REG_RBP ||
       (unsafe { (*inst1).ops[0].mem.disp }) != -72 {
        return 16;
    }
    if (unsafe { (*inst2).ops[0].kind }) != X64_OP_MEM ||
       (unsafe { (*inst2).ops[0].mem.base }) != REG_RBP ||
       (unsafe { (*inst2).ops[0].mem.disp }) != -96 {
        return 17;
    }

    let mut sc: u32 = 0u32;
    while sc <= 10u32 {
        let b2 = x64_mi_body_new(mut_view(*a), 1);
        unsafe { (*b2).shadow_space = 48u32; }
        let lay2 = x64_frame_lower_raw(mut_view(*a), unsafe { mut_view(*b2) }, sc);
        let fs2 = lay2.frame_size;
        if ((fs2 + 56u32) % 16u32) != 0u32 || fs2 < 48u32 {
            return 18;
        }
        sc = sc + 1u32;
    }

    arena_reset(mut_view(*a));
    0
}

fn test_prologue_epilogue_and_page_probe() -> i32 {
    let mut obj = objmodel_new();
    let sid = objmodel_add_section_str(mut_view(obj), ".text", SEC_CODE, SEC_FLAG_EXEC | SEC_FLAG_READ, 16u32);
    let sec = objmodel_get_section_mut(mut_view(obj), sid);

    let lay_4096 = X64FrameLayout { slot_offsets: 0 as *mut i32, slot_count: 0u32, frame_size: 4096u32 };
    unsafe {
        (*sec).bytes_len = 0;
        x64_frame_emit_prologue(mut_view(*sec), view(lay_4096));
        if (*sec).bytes_len != 22 {
            objmodel_free(mut_view(obj));
            return 201;
        }
        if sec_byte(sec, 15) != 0x48u8 || sec_byte(sec, 16) != 0x81u8 || sec_byte(sec, 17) != 0xECu8 ||
           sec_byte(sec, 18) != 0x00u8 || sec_byte(sec, 19) != 0x10u8 || sec_byte(sec, 20) != 0x00u8 || sec_byte(sec, 21) != 0x00u8 {
            objmodel_free(mut_view(obj));
            return 202;
        }
    }

    let lay_4104 = X64FrameLayout { slot_offsets: 0 as *mut i32, slot_count: 0u32, frame_size: 4104u32 };
    unsafe {
        (*sec).bytes_len = 0;
        x64_frame_emit_prologue(mut_view(*sec), view(lay_4104));
        if (*sec).bytes_len != 52 {
            objmodel_free(mut_view(obj));
            return 203;
        }
        if sec_byte(sec, 32) != 0x85u8 || sec_byte(sec, 33) != 0x04u8 || sec_byte(sec, 34) != 0x24u8 {
            objmodel_free(mut_view(obj));
            return 204;
        }
        if sec_byte(sec, 47) != 0x77u8 || sec_byte(sec, 48) != 0xE8u8 ||
           sec_byte(sec, 49) != 0x48u8 || sec_byte(sec, 50) != 0x29u8 || sec_byte(sec, 51) != 0xC4u8 {
            objmodel_free(mut_view(obj));
            return 205;
        }

        (*sec).bytes_len = 0;
        x64_frame_emit_epilogue(mut_view(*sec), view(lay_4104));
        if (*sec).bytes_len != 19 || sec_byte(sec, 0) != 0x48u8 || sec_byte(sec, 1) != 0x81u8 || sec_byte(sec, 2) != 0xC4u8 {
            objmodel_free(mut_view(obj));
            return 206;
        }
    }

    objmodel_free(mut_view(obj));
    0
}

fn test_verifier_positive_and_negative_cases(a: mut_view<Arena>) -> i32 {
    let b_ok = x64_mi_body_new(mut_view(*a), 1);
    let mbb_ok = unsafe { x64_mi_bb_at((*b_ok).bbs, 0) };
    unsafe {
        x64_mi_emit(mut_view(*b_ok), mut_view(*mbb_ok), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_frame(0u32, 0));
        x64_mi_emit(mut_view(*b_ok), mut_view(*mbb_ok), X64_MI_ADD, x64_op_reg(REG_RAX), x64_op_imm(10i64));
        x64_mi_emit(mut_view(*b_ok), mut_view(*mbb_ok), X64_MI_SHL, x64_op_reg(REG_RAX), x64_op_reg(REG_RCX));
        x64_mi_emit(mut_view(*b_ok), mut_view(*mbb_ok), X64_MI_SAR, x64_op_reg(REG_RAX), x64_op_imm(2i64));
        x64_mi_emit(mut_view(*b_ok), mut_view(*mbb_ok), X64_MI_IMUL, x64_op_reg(REG_RAX), x64_op_frame(0u32, 0));
        x64_mi_emit(mut_view(*b_ok), mut_view(*mbb_ok), X64_MI_LEA, x64_op_reg(REG_RDX), x64_op_frame(0u32, 0));
        x64_mi_emit(mut_view(*b_ok), mut_view(*mbb_ok), X64_MI_LEA, x64_op_reg(REG_R8), x64_op_sym(100000u32));
        x64_mi_emit(mut_view(*b_ok), mut_view(*mbb_ok), X64_MI_IDIV, x64_op_reg(REG_RCX), x64_op_none());
        x64_mi_emit(mut_view(*b_ok), mut_view(*mbb_ok), X64_MI_RET, x64_op_none(), x64_op_none());
    }
    let lay_ok = x64_frame_lower_raw(mut_view(*a), unsafe { mut_view(*b_ok) }, 1u32);
    if x64_verify_checked(unsafe { view(*b_ok) }, view(lay_ok)) != X64_VERIFY_OK {
        return 301;
    }
    x64_verify(unsafe { view(*b_ok) }, view(lay_ok));

    unsafe { (*b_ok).shadow_space = 16u32; }
    if x64_verify_checked(unsafe { view(*b_ok) }, view(lay_ok)) != X64_VERIFY_ERR_SHADOW_SPACE {
        return 302;
    }
    unsafe { (*b_ok).shadow_space = 32u32; }

    let lay_misaligned = X64FrameLayout { slot_offsets: lay_ok.slot_offsets, slot_count: 1u32, frame_size: 48u32 };
    if x64_verify_checked(unsafe { view(*b_ok) }, view(lay_misaligned)) != X64_VERIFY_ERR_ALIGNMENT {
        return 303;
    }

    unsafe { (*b_ok).shadow_space = 72u32; }
    let lay_small = X64FrameLayout { slot_offsets: lay_ok.slot_offsets, slot_count: 1u32, frame_size: 40u32 };
    if x64_verify_checked(unsafe { view(*b_ok) }, view(lay_small)) != X64_VERIFY_ERR_FRAME_SIZE {
        return 304;
    }

    let b_mm = x64_mi_body_new(mut_view(*a), 1);
    let mbb_mm = unsafe { x64_mi_bb_at((*b_mm).bbs, 0) };
    unsafe {
        x64_mi_emit(mut_view(*b_mm), mut_view(*mbb_mm), X64_MI_MOV, x64_op_frame(0u32, 0), x64_op_frame(1u32, 0));
    }
    let lay_mm = x64_frame_lower_raw(mut_view(*a), unsafe { mut_view(*b_mm) }, 2u32);
    if x64_verify_checked(unsafe { view(*b_mm) }, view(lay_mm)) != X64_VERIFY_ERR_MEM_MEM {
        return 305;
    }

    let b_of = x64_mi_body_new(mut_view(*a), 1);
    let mbb_of = unsafe { x64_mi_bb_at((*b_of).bbs, 0) };
    unsafe {
        x64_mi_emit(mut_view(*b_of), mut_view(*mbb_of), X64_MI_ADD, x64_op_imm(42i64), x64_op_reg(REG_RAX));
    }
    let lay_of = x64_frame_lower_raw(mut_view(*a), unsafe { mut_view(*b_of) }, 1u32);
    if x64_verify_checked(unsafe { view(*b_of) }, view(lay_of)) != X64_VERIFY_ERR_OPERAND_FORM {
        return 306;
    }

    let b_imul = x64_mi_body_new(mut_view(*a), 1);
    let mbb_imul = unsafe { x64_mi_bb_at((*b_imul).bbs, 0) };
    unsafe {
        x64_mi_emit(mut_view(*b_imul), mut_view(*mbb_imul), X64_MI_IMUL, x64_op_reg(REG_RAX), x64_op_imm(3i64));
    }
    let lay_imul = x64_frame_lower_raw(mut_view(*a), unsafe { mut_view(*b_imul) }, 1u32);
    if x64_verify_checked(unsafe { view(*b_imul) }, view(lay_imul)) != X64_VERIFY_ERR_IMUL_FORM {
        return 307;
    }

    let b_lea = x64_mi_body_new(mut_view(*a), 1);
    let mbb_lea = unsafe { x64_mi_bb_at((*b_lea).bbs, 0) };
    unsafe {
        x64_mi_emit(mut_view(*b_lea), mut_view(*mbb_lea), X64_MI_LEA, x64_op_reg(REG_RAX), x64_op_reg(REG_RCX));
    }
    let lay_lea = x64_frame_lower_raw(mut_view(*a), unsafe { mut_view(*b_lea) }, 1u32);
    if x64_verify_checked(unsafe { view(*b_lea) }, view(lay_lea)) != X64_VERIFY_ERR_LEA_FORM {
        return 308;
    }

    let b_shc = x64_mi_body_new(mut_view(*a), 1);
    let mbb_shc = unsafe { x64_mi_bb_at((*b_shc).bbs, 0) };
    unsafe {
        x64_mi_emit(mut_view(*b_shc), mut_view(*mbb_shc), X64_MI_SHL, x64_op_reg(REG_RAX), x64_op_reg(REG_RBX));
    }
    let lay_shc = x64_frame_lower_raw(mut_view(*a), unsafe { mut_view(*b_shc) }, 1u32);
    if x64_verify_checked(unsafe { view(*b_shc) }, view(lay_shc)) != X64_VERIFY_ERR_SHIFT_REG_CLASS {
        return 309;
    }

    let b_shf = x64_mi_body_new(mut_view(*a), 1);
    let mbb_shf = unsafe { x64_mi_bb_at((*b_shf).bbs, 0) };
    unsafe {
        x64_mi_emit(mut_view(*b_shf), mut_view(*mbb_shf), X64_MI_SHR, x64_op_imm(1i64), x64_op_reg(REG_RCX));
    }
    let lay_shf = x64_frame_lower_raw(mut_view(*a), unsafe { mut_view(*b_shf) }, 1u32);
    if x64_verify_checked(unsafe { view(*b_shf) }, view(lay_shf)) != X64_VERIFY_ERR_SHIFT_FORM {
        return 310;
    }

    let b_idiv = x64_mi_body_new(mut_view(*a), 1);
    let mbb_idiv = unsafe { x64_mi_bb_at((*b_idiv).bbs, 0) };
    unsafe {
        x64_mi_emit(mut_view(*b_idiv), mut_view(*mbb_idiv), X64_MI_IDIV, x64_op_imm(2i64), x64_op_none());
    }
    let lay_idiv = x64_frame_lower_raw(mut_view(*a), unsafe { mut_view(*b_idiv) }, 1u32);
    if x64_verify_checked(unsafe { view(*b_idiv) }, view(lay_idiv)) != X64_VERIFY_ERR_IDIV_FORM {
        return 311;
    }

    arena_reset(mut_view(*a));
    0
}

fn test_mc_and_obj_emission(a: mut_view<Arena>, ti_ptr: *mut TypeInterner, out: mut_view<DiagBuffer>) -> i32 {
    let i32_v = unsafe { (*ti_ptr).t_i32.v };

    let lir = lir_body_new(mut_view(*a));
    let slots = arena_alloc_raw(mut_view(*a), 2 * size_of<LirStackSlot>(), align_of<LirStackSlot>()) as *mut LirStackSlot;
    unsafe {
        (*lir_slot_at(slots, 0)).ty.v = i32_v;
        (*lir_slot_at(slots, 0)).is_const = false;
        (*lir_slot_at(slots, 1)).ty.v = i32_v;
        (*lir_slot_at(slots, 1)).is_const = true;
        (*lir).slots = slots;
        (*lir).slot_count = 2;
    }
    let vregs = arena_alloc_raw(mut_view(*a), 2 * size_of<LirVReg>(), align_of<LirVReg>()) as *mut LirVReg;
    unsafe {
        (*lir_vreg_at(vregs, 0)).ty.v = i32_v;
        (*lir_vreg_at(vregs, 1)).ty.v = (*ti_ptr).t_i64.v;
        (*lir).vregs = vregs;
        (*lir).vreg_count = 2;
    }
    let bbs = arena_alloc_raw(mut_view(*a), size_of<LirBb>(), align_of<LirBb>()) as *mut LirBb;
    let bb0 = unsafe { lir_bb_at(bbs, 0) };
    let insts = arena_alloc_raw(mut_view(*a), 3 * size_of<LirInst>(), align_of<LirInst>()) as *mut LirInst;
    unsafe {
        lir_bb_reset(mut_view(*bb0), 0u32);
        let i0 = lir_inst_at(insts, 0);
        lir_inst_reset(mut_view(*i0), LIR_INST_CONST);
        (*i0).dest.v = 0u32;
        (*i0).const_val = 42u64;

        let i1 = lir_inst_at(insts, 1);
        lir_inst_reset(mut_view(*i1), LIR_INST_STACK_ADDR);
        (*i1).dest.v = 1u32;
        (*i1).slot.v = 0u32;

        let i2 = lir_inst_at(insts, 2);
        lir_inst_reset(mut_view(*i2), LIR_INST_STORE);
        (*i2).ptr.v = 1u32;
        (*i2).val.v = 0u32;

        (*bb0).insts = insts;
        (*bb0).inst_count = 3;
        lir_term_reset(mut_view((*bb0).term), LIR_TERM_RETURN);
        (*lir).bbs = bbs;
        (*lir).bb_count = 1;
        (*lir).frame_req.max_outgoing_args_bytes = 32u32;
        (*lir).frame_req.requires_16_byte_alignment = true;
    }

    let mi = x64_isel(unsafe { view(*lir) }, unsafe { view(*ti_ptr) });
    let layout = x64_frame_lower(unsafe { mut_view(*mi) }, unsafe { view(*lir) }, unsafe { view(*ti_ptr) });
    x64_verify(unsafe { view(*mi) }, view(layout));

    let mut obj = objmodel_new();
    let sid = objmodel_add_section_str(mut_view(obj), ".text", SEC_CODE, SEC_FLAG_EXEC | SEC_FLAG_READ, 16u32);
    let sec = objmodel_get_section_mut(mut_view(obj), sid);

    x64_emit_mi_body_mc(unsafe { mut_view(*sec) }, unsafe { view(*mi) }, view(layout));
    out.len = 0;
    x64_dump_mc_hex(unsafe { view(*sec) }, mut_view(*out));

    if !bytes_eq_main_42_mc(view(*out)) {
        objmodel_free(mut_view(obj));
        return 401;
    }

    let mut ext_call_name: [12]u8 = [101u8, 120u8, 116u8, 95u8, 104u8, 101u8, 108u8, 112u8, 101u8, 114u8, 0u8, 0u8];
    let mi_br = x64_mi_body_new(mut_view(*a), 2);
    let mbb0 = unsafe { x64_mi_bb_at((*mi_br).bbs, 0) };
    let mbb1 = unsafe { x64_mi_bb_at((*mi_br).bbs, 1) };
    unsafe {
        x64_mi_emit(mut_view(*mi_br), mut_view(*mbb0), X64_MI_CMP, x64_op_reg(REG_RAX), x64_op_imm(0i64));
        x64_mi_emit(mut_view(*mi_br), mut_view(*mbb0), X64_MI_JCC, x64_op_imm(CC_E as i64), x64_op_imm(1i64));
        let call_mi = x64_mi_emit(mut_view(*mi_br), mut_view(*mbb0), X64_MI_CALL, x64_op_none(), x64_op_none());
        (*call_mi).msg = address_of_mut(ext_call_name[0]) as *const u8;
        x64_mi_emit(mut_view(*mi_br), mut_view(*mbb0), X64_MI_JMP, x64_op_imm(1i64), x64_op_none());

        x64_mi_emit(mut_view(*mi_br), mut_view(*mbb1), X64_MI_MOV, x64_op_reg(REG_RAX), x64_op_imm(7i64));
        x64_mi_emit(mut_view(*mi_br), mut_view(*mbb1), X64_MI_RET, x64_op_none(), x64_op_none());
    }
    let lay_br = x64_frame_lower_raw(mut_view(*a), unsafe { mut_view(*mi_br) }, 0u32);
    unsafe {
        (*sec).bytes_len = 0;
        (*sec).relocs_len = 0;
    }
    x64_emit_mi_body_obj(unsafe { mut_view(*sec) }, unsafe { view(*mi_br) }, view(lay_br), mut_view(obj));
    if (unsafe { (*sec).relocs_len }) != 1 {
        objmodel_free(mut_view(obj));
        return 402;
    }
    if (unsafe { sec_byte(sec, 27) }) != 10u8 {
        objmodel_free(mut_view(obj));
        return 403;
    }

    objmodel_free(mut_view(obj));
    arena_reset(mut_view(*a));
    0
}

pub fn main() -> i32 {
    let mut perm = arena_with_chunk_size(131072);
    let _ = arena_alloc_raw(mut_view(perm), 16, 8);
    let mut a = arena_with_chunk_size(131072);
    let _ = arena_alloc_raw(mut_view(a), 16, 8);

    let ti_ptr = arena_alloc_raw(mut_view(perm), size_of<TypeInterner>(), align_of<TypeInterner>()) as *mut TypeInterner;
    unsafe { type_interner_init(mut_view(*ti_ptr)); }

    let mut out = diag_buf_new();
    out.ptr = arena_alloc_raw(mut_view(perm), 16384, 1);
    out.cap = 16384;

    let rc1 = test_frame_lower_layout_and_rewriting(mut_view(a), ti_ptr);
    if rc1 != 0 { return rc1; }

    let rc2 = test_prologue_epilogue_and_page_probe();
    if rc2 != 0 { return rc2; }

    let rc3 = test_verifier_positive_and_negative_cases(mut_view(a));
    if rc3 != 0 { return rc3; }

    let rc4 = test_mc_and_obj_emission(mut_view(a), ti_ptr, mut_view(out));
    if rc4 != 0 { return rc4; }

    unsafe { type_interner_free(mut_view(*ti_ptr)); }
    arena_destroy(mut_view(a));
    arena_destroy(mut_view(perm));
    print("OK x64 Frame Lowering, Prologue/Epilogue & Verifier\n");
    0
}
