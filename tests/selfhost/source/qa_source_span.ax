// test: run
// stdout: OK Source Span\n

pub struct FileId {
    pub v: u32,
}

impl FileId {
    pub fn none() -> FileId { FileId { v: 0u32 } }
    pub fn is_none(self: view<FileId>) -> bool { self.v == 0u32 }
    pub fn is_some(self: view<FileId>) -> bool { self.v != 0u32 }
    pub fn eq(self: view<FileId>, other: view<FileId>) -> bool { self.v == other.v }
}

pub struct Span {
    pub file: FileId,
    pub start: u32,
    pub end: u32,
}

impl Span {
    pub fn new(file: FileId, start: u32, end: u32) -> Span {
        Span { file: file, start: start, end: end }
    }

    pub fn none() -> Span {
        Span { file: FileId.none(), start: 0u32, end: 0u32 }
    }

    pub fn is_none(self: view<Span>) -> bool {
        self.file.is_none()
    }

    pub fn is_some(self: view<Span>) -> bool {
        self.file.is_some()
    }

    pub fn len(self: view<Span>) -> u32 {
        if self.end >= self.start {
            self.end - self.start
        } else {
            0u32
        }
    }

    pub fn eq(self: view<Span>, other: view<Span>) -> bool {
        self.file.eq(view(other.file)) && self.start == other.start && self.end == other.end
    }
}

pub struct LineCol {
    pub line: u32,
    pub col_bytes: u32,
    pub col_chars: u32,
}

impl LineCol {
    pub fn zero() -> LineCol {
        LineCol { line: 0u32, col_bytes: 0u32, col_chars: 0u32 }
    }

    pub fn eq(self: view<LineCol>, other: view<LineCol>) -> bool {
        self.line == other.line && self.col_bytes == other.col_bytes && self.col_chars == other.col_chars
    }
}

fn main() -> i32 {
    let fid1 = FileId { v: 1u32 };
    let fid2 = FileId { v: 2u32 };
    let fid_none = FileId.none();

    if !fid_none.is_none() { return 1; }
    if fid1.is_none() { return 2; }
    if !fid1.is_some() { return 3; }
    if fid1.eq(view(fid2)) { return 4; }

    let s1 = Span.new(FileId { v: 1u32 }, 10u32, 25u32);
    if s1.is_none() { return 5; }
    if !s1.is_some() { return 6; }
    if s1.len() != 15u32 { return 7; }

    let s_none = Span.none();
    if !s_none.is_none() { return 8; }
    if s_none.is_some() { return 9; }
    if s_none.len() != 0u32 { return 10; }

    let s2 = Span.new(FileId { v: 1u32 }, 10u32, 25u32);
    if !s1.eq(view(s2)) { return 11; }

    let s3 = Span.new(FileId { v: 2u32 }, 10u32, 25u32);
    if s1.eq(view(s3)) { return 12; }

    let lc1 = LineCol { line: 5u32, col_bytes: 12u32, col_chars: 10u32 };
    let lc2 = LineCol { line: 5u32, col_bytes: 12u32, col_chars: 10u32 };
    let lc3 = LineCol { line: 5u32, col_bytes: 13u32, col_chars: 10u32 };

    if !lc1.eq(view(lc2)) { return 13; }
    if lc1.eq(view(lc3)) { return 14; }

    let lc_z = LineCol.zero();
    if lc_z.line != 0u32 || lc_z.col_bytes != 0u32 || lc_z.col_chars != 0u32 { return 15; }

    print("OK Source Span\n");
    0
}
