// test: run
// stdout: OK Source Manager\n

module main

use host_intrinsics.heap_alloc
use host_intrinsics.heap_free
use host_intrinsics.exit
use compiler.kernel.id.FileId
use compiler.source.manager.SourceDatabase
use compiler.source.manager.SourceFile
use compiler.source.span.Span
use compiler.kernel.interner.StrView
use compiler.kernel.arena.arena_alloc_raw
use compiler.kernel.arena.arena_destroy
use compiler.kernel.arena.arena_new
use compiler.source.manager.source_db_add_virtual
use compiler.source.manager.source_db_file_count
use compiler.source.manager.source_db_free
use compiler.source.manager.source_db_has_invalid_utf8
use compiler.source.manager.source_db_hash
use compiler.source.manager.source_db_init
use compiler.source.manager.source_db_line_col
use compiler.source.manager.source_db_line_range
use compiler.source.manager.source_db_path
use compiler.source.manager.source_db_span_text
use compiler.source.manager.source_db_text

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic fn wrapping_add_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn rotate_left_u64(x: u64, n: u32) -> u64 { 0 }

fn test_bytes_eq(a: *const u8, b: *const u8, len: usize) -> bool {
    let mut i: usize = 0;
    while i < len {
        let ba: u8 = unsafe { *(a + i) };
        let bb: u8 = unsafe { *(b + i) };
        if ba != bb { return false; }
        i = i + 1;
    }
    true
}

fn str_eq(sv: StrView, expected: *const u8, exp_len: usize) -> bool {
    if sv.len != exp_len { return false; }
    test_bytes_eq(sv.ptr, expected, exp_len)
}

fn file_id(v: u32) -> FileId {
    FileId { v: v }
}

fn make_span(file_v: u32, start: u32, end: u32) -> Span {
    Span { file: FileId { v: file_v }, start: start, end: end }
}

fn main() -> i32 {
    let mut db = SourceDatabase {
        arena: arena_new(),
        files: 0 as *mut SourceFile,
        files_count: 0,
        files_cap: 0,
    };
    source_db_init(mut_view(db));

    let mut scratch = arena_new();

    // 1. source_virtual_file
    let p_v1 = arena_alloc_raw(mut_view(scratch), 16, 1);
    unsafe {
        *p_v1 = 118u8;
        *(p_v1 + 1) = 49u8;
        *(p_v1 + 2) = 46u8;
        *(p_v1 + 3) = 97u8;
        *(p_v1 + 4) = 120u8;
    }
    let p_txt1 = arena_alloc_raw(mut_view(scratch), 16, 1);
    unsafe {
        *p_txt1 = 102u8;
        *(p_txt1 + 1) = 111u8;
        *(p_txt1 + 2) = 111u8;
        *(p_txt1 + 3) = 10u8;
        *(p_txt1 + 4) = 98u8;
        *(p_txt1 + 5) = 97u8;
        *(p_txt1 + 6) = 114u8;
    }

    let id1 = source_db_add_virtual(mut_view(db), p_v1 as *const u8, 5, p_txt1 as *const u8, 7);
    if id1.v != 1u32 { return 1; }
    if !str_eq(source_db_path(view(db), file_id(1u32)), p_v1 as *const u8, 5) { return 2; }
    if !str_eq(source_db_text(view(db), file_id(1u32)), p_txt1 as *const u8, 7) { return 3; }

    // Deduplication by path
    let id1_dup = source_db_add_virtual(mut_view(db), p_v1 as *const u8, 5, p_v1 as *const u8, 5);
    if id1_dup.v != 1u32 { return 4; }
    if source_db_file_count(view(db)) != 1 { return 5; }

    // 2. source_crlf_and_no_newline: "line1\r\nline2\r\nline3" (19 bytes)
    let p_v2 = arena_alloc_raw(mut_view(scratch), 16, 1);
    unsafe {
        *p_v2 = 118u8;
        *(p_v2 + 1) = 50u8;
        *(p_v2 + 2) = 46u8;
        *(p_v2 + 3) = 97u8;
        *(p_v2 + 4) = 120u8;
    }
    let p_crlf = arena_alloc_raw(mut_view(scratch), 32, 1);
    unsafe {
        *p_crlf = 108u8;
        *(p_crlf + 1) = 105u8;
        *(p_crlf + 2) = 110u8;
        *(p_crlf + 3) = 101u8;
        *(p_crlf + 4) = 49u8;
        *(p_crlf + 5) = 13u8;
        *(p_crlf + 6) = 10u8;
        *(p_crlf + 7) = 108u8;
        *(p_crlf + 8) = 105u8;
        *(p_crlf + 9) = 110u8;
        *(p_crlf + 10) = 101u8;
        *(p_crlf + 11) = 50u8;
        *(p_crlf + 12) = 13u8;
        *(p_crlf + 13) = 10u8;
        *(p_crlf + 14) = 108u8;
        *(p_crlf + 15) = 105u8;
        *(p_crlf + 16) = 110u8;
        *(p_crlf + 17) = 101u8;
        *(p_crlf + 18) = 51u8;
    }
    let id2 = source_db_add_virtual(mut_view(db), p_v2 as *const u8, 5, p_crlf as *const u8, 19);
    if id2.v != 2u32 { return 6; }

    let s1 = source_db_line_range(view(db), file_id(2u32), 1u32);
    if s1.start != 0u32 || s1.end != 5u32 { return 7; }
    let s2 = source_db_line_range(view(db), file_id(2u32), 2u32);
    if s2.start != 7u32 || s2.end != 12u32 { return 8; }
    let s3 = source_db_line_range(view(db), file_id(2u32), 3u32);
    if s3.start != 14u32 || s3.end != 19u32 { return 9; }

    // Line and col at offset 7 ('l' of line2): line 2, col 1
    let lc7 = source_db_line_col(view(db), make_span(2u32, 7u32, 7u32));
    if lc7.line != 2u32 || lc7.col_bytes != 1u32 || lc7.col_chars != 1u32 { return 10; }

    // Line and col at offset 8 ('i' of line2): line 2, col 2
    let lc8 = source_db_line_col(view(db), make_span(2u32, 8u32, 8u32));
    if lc8.line != 2u32 || lc8.col_bytes != 2u32 || lc8.col_chars != 2u32 { return 11; }

    // 3. source_bom_and_multibyte: UTF-8 BOM "\xEF\xBB\xBFchào"
    let p_v3 = arena_alloc_raw(mut_view(scratch), 16, 1);
    unsafe {
        *p_v3 = 118u8;
        *(p_v3 + 1) = 51u8;
        *(p_v3 + 2) = 46u8;
        *(p_v3 + 3) = 97u8;
        *(p_v3 + 4) = 120u8;
    }
    let p_bom = arena_alloc_raw(mut_view(scratch), 16, 1);
    unsafe {
        *p_bom = 0xEFu8;
        *(p_bom + 1) = 0xBBu8;
        *(p_bom + 2) = 0xBFu8;
        *(p_bom + 3) = 99u8;
        *(p_bom + 4) = 104u8;
        *(p_bom + 5) = 0xC3u8;
        *(p_bom + 6) = 0xA0u8;
        *(p_bom + 7) = 111u8;
    }
    let id3 = source_db_add_virtual(mut_view(db), p_v3 as *const u8, 5, p_bom as *const u8, 8);
    let txt3 = source_db_text(view(db), file_id(3u32));
    // Text should have 5 bytes ("chào") because BOM was stripped!
    if txt3.len != 5 { return 12; }
    if unsafe { *txt3.ptr } != 99u8 { return 13; } // 'c'

    // Offset 5 is after 'o' -> col_bytes 6, col_chars 5
    let lc_bom = source_db_line_col(view(db), make_span(3u32, 5u32, 5u32));
    if lc_bom.line != 1u32 || lc_bom.col_bytes != 6u32 || lc_bom.col_chars != 5u32 { return 14; }

    // 4. source_empty_file
    let p_v4 = arena_alloc_raw(mut_view(scratch), 16, 1);
    unsafe {
        *p_v4 = 118u8;
        *(p_v4 + 1) = 52u8;
        *(p_v4 + 2) = 46u8;
        *(p_v4 + 3) = 97u8;
        *(p_v4 + 4) = 120u8;
    }
    let id4 = source_db_add_virtual(mut_view(db), p_v4 as *const u8, 5, 0 as *const u8, 0);
    let s_empty = source_db_line_range(view(db), file_id(4u32), 1u32);
    if s_empty.start != 0u32 || s_empty.end != 0u32 { return 15; }
    let lc_empty = source_db_line_col(view(db), make_span(4u32, 0u32, 0u32));
    if lc_empty.line != 1u32 || lc_empty.col_bytes != 1u32 || lc_empty.col_chars != 1u32 { return 16; }

    // 5. source_out_of_bounds
    // Offset 100 on id1 (length 7) -> clamped to 7, line 2, col_bytes 4, col_chars 4
    let lc_oob = source_db_line_col(view(db), make_span(1u32, 100u32, 100u32));
    if lc_oob.line != 2u32 { return 17; }

    let s_oob = source_db_line_range(view(db), file_id(1u32), 100u32);
    if !s_oob.is_none() { return 18; }

    // 6. Span text slice check: "line2" from id2
    let st2 = source_db_span_text(view(db), s2);
    if st2.len != 5 { return 19; }
    if unsafe { *st2.ptr } != 108u8 || unsafe { *(st2.ptr + 4) } != 50u8 { return 20; }

    // 7. Hash check: content hash
    let h1 = source_db_hash(view(db), file_id(1u32));
    let _ = h1;

    // 8. UTF-8 validity
    if source_db_has_invalid_utf8(view(db), file_id(1u32)) { return 22; }
    if source_db_has_invalid_utf8(view(db), file_id(3u32)) { return 23; }

    source_db_free(mut_view(db));
    arena_destroy(mut_view(scratch));

    print("OK Source Manager\n");
    0
}
