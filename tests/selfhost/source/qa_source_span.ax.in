// test: run
// stdout: OK Source Span\n

module main

use host_intrinsics.heap_alloc
use host_intrinsics.heap_free
use host_intrinsics.exit
use compiler.kernel.id.FileId
use compiler.source.span.LineCol
use compiler.source.span.Span

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic fn wrapping_add_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn rotate_left_u64(x: u64, n: u32) -> u64 { 0 }

fn main() -> i32 {
    let fid1 = FileId { v: 1u32 };
    let fid2 = FileId { v: 2u32 };
    let fid_none = FileId.none();

    if !fid_none.is_none() { return 1; }
    if fid1.is_none() { return 2; }
    if !fid1.is_some() { return 3; }
    if fid1.eq(view(fid2)) { return 4; }

    let s1 = Span.new(FileId { v: 1u32 }, 10u32, 25u32);
    if s1.is_none() { return 5; }
    if !s1.is_some() { return 6; }
    if s1.len() != 15u32 { return 7; }

    let s_none = Span.none();
    if !s_none.is_none() { return 8; }
    if s_none.is_some() { return 9; }
    if s_none.len() != 0u32 { return 10; }

    let s2 = Span.new(FileId { v: 1u32 }, 10u32, 25u32);
    if !s1.eq(view(s2)) { return 11; }

    let s3 = Span.new(FileId { v: 2u32 }, 10u32, 25u32);
    if s1.eq(view(s3)) { return 12; }

    let lc1 = LineCol { line: 5u32, col_bytes: 12u32, col_chars: 10u32 };
    let lc2 = LineCol { line: 5u32, col_bytes: 12u32, col_chars: 10u32 };
    let lc3 = LineCol { line: 5u32, col_bytes: 13u32, col_chars: 10u32 };

    if !lc1.eq(view(lc2)) { return 13; }
    if lc1.eq(view(lc3)) { return 14; }

    let lc_z = LineCol.zero();
    if lc_z.line != 0u32 || lc_z.col_bytes != 0u32 || lc_z.col_chars != 0u32 { return 15; }

    print("OK Source Span\n");
    0
}
