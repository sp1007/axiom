const CORPUS_OFF: [21]u32 = [0u32, 13u32, 32u32, 141u32, 141u32, 154u32, 168u32, 240u32, 240u32, 253u32, 271u32, 380u32, 380u32, 393u32, 416u32, 544u32, 544u32, 557u32, 573u32, 679u32, 679u32];

fn qa_sv_eq(a: StrView, b: StrView) -> bool {
    if a.len != b.len { return false; }
    test_bytes_eq(a.ptr, b.ptr, a.len)
}

// Parses `src_sv`, renders the AST and the diagnostics and compares both with the expected text.
//
// Everything the parser and the AST dumper take raw addresses of (session, parse arena, output buffers) is owned
// by `main` and only reset here: the MIR interpreter maps views to raw pointers by scanning its allocation table
// for the first entry covering the host address, and entries of returned frames are not reliably retired.  Locals
// of `main` are registered first, so they are always found first and the mapping cannot hit a stale entry.
// (`session_new()` results are never used as is: the interpreter returns aggregates through a 64 byte buffer, so
// `session_init` rebuilds every field.)
fn run_and_verify_parse(
    sess: mut_view<CompilerSession>,
    parse_arena: mut_view<Arena>,
    out_ast: mut_view<DiagBuffer>,
    out_err: mut_view<DiagBuffer>,
    path_sv: StrView,
    src_sv: StrView,
    exp_ast_sv: StrView,
    exp_err_sv: StrView,
    expect_err: bool
) -> bool {
    session_init(mut_view(*sess));
    let mut lex_res = LexResult {
        arena: arena_new(),
        tokens: 0 as *mut Token,
        token_count: 0,
        token_cap: 0,
        comments: 0 as *mut Comment,
        comment_count: 0,
        comment_cap: 0,
    };
    let fid = session_lex_virtual_file(mut_view(*sess), path_sv, src_sv, mut_view(lex_res));
    let pres = ax_parse(
        mut_view(*parse_arena),
        lex_res.tokens,
        lex_res.token_count,
        mut_view(sess.diag_sink),
        mut_view(sess.interner)
    );
    ax_ast_render(view(pres.ast), view(sess.interner), FileId { v: fid.v }, mut_view(*out_ast));
    ax_diag_render_human(view(sess.diag_sink), view(sess.source_db), mut_view(*out_err));

    let mut ok = true;
    let errs = session_error_count(view(*sess));
    if expect_err {
        if errs == 0 {
            ok = false;
        }
    } else {
        if errs != 0 {
            ok = false;
        }
    }
    if !qa_sv_eq(diag_buf_as_str_view(view(*out_ast)), exp_ast_sv) {
        ok = false;
    }
    if !qa_sv_eq(diag_buf_as_str_view(view(*out_err)), exp_err_sv) {
        ok = false;
    }
    diag_buf_free(mut_view(*out_ast));
    diag_buf_free(mut_view(*out_err));
    arena_destroy(mut_view(*parse_arena));
    ax_lex_result_free(mut_view(lex_res));
    session_free(mut_view(*sess));
    ok
}


fn get_sv(a: mut_view<Arena>, c_data: view<[679]u8>, c_off: view<[21]u32>, blob_idx: usize) -> StrView {
    let start = (*c_off)[blob_idx] as usize;
    let end = (*c_off)[blob_idx + 1] as usize;
    let n = end - start;
    let dst = arena_alloc_raw(a, n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = (*c_data)[start + i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn verify_case(
    sess: mut_view<CompilerSession>,
    parse_arena: mut_view<Arena>,
    out_ast: mut_view<DiagBuffer>,
    out_err: mut_view<DiagBuffer>,
    scratch: mut_view<Arena>,
    c_data: view<[679]u8>,
    c_off: view<[21]u32>,
    case_idx: usize,
    expect_err: bool
) -> bool {
    let base = case_idx * 4;
    let path_sv = get_sv(mut_view(*scratch), c_data, c_off, base);
    let src_sv = get_sv(mut_view(*scratch), c_data, c_off, base + 1);
    let exp_ast_sv = get_sv(mut_view(*scratch), c_data, c_off, base + 2);
    let exp_err_sv = get_sv(mut_view(*scratch), c_data, c_off, base + 3);
    run_and_verify_parse(mut_view(*sess), mut_view(*parse_arena), mut_view(*out_ast), mut_view(*out_err), path_sv, src_sv, exp_ast_sv, exp_err_sv, expect_err)
}

pub fn main() -> i32 {
    let mut scratch = arena_new();
    let mut sess = session_new();
    let mut parse_arena = arena_new();
    let mut out_ast = diag_buf_new();
    let mut out_err = diag_buf_new();
    let c_data = CORPUS_DATA;
    let c_off = CORPUS_OFF;
    if !verify_case(mut_view(sess), mut_view(parse_arena), mut_view(out_ast), mut_view(out_err), mut_view(scratch), view(c_data), view(c_off), 0, false) { return 10; }
    if !verify_case(mut_view(sess), mut_view(parse_arena), mut_view(out_ast), mut_view(out_err), mut_view(scratch), view(c_data), view(c_off), 1, false) { return 11; }
    if !verify_case(mut_view(sess), mut_view(parse_arena), mut_view(out_ast), mut_view(out_err), mut_view(scratch), view(c_data), view(c_off), 2, false) { return 12; }
    if !verify_case(mut_view(sess), mut_view(parse_arena), mut_view(out_ast), mut_view(out_err), mut_view(scratch), view(c_data), view(c_off), 3, false) { return 13; }
    if !verify_case(mut_view(sess), mut_view(parse_arena), mut_view(out_ast), mut_view(out_err), mut_view(scratch), view(c_data), view(c_off), 4, false) { return 14; }
    arena_destroy(mut_view(parse_arena));
    diag_buf_free(mut_view(out_ast));
    diag_buf_free(mut_view(out_err));
    arena_destroy(mut_view(scratch));
    print("OK Parse Tuple Struct QA (5 files)\n");
    0
}
