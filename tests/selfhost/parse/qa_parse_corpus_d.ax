    pub fn is_some(self: view<SymbolId>) -> bool { self.v != 0 }
    pub fn from_index(index: usize) -> SymbolId { SymbolId { v: (index + 1) as u32 } }
    pub fn index(self: view<SymbolId>) -> usize { (self.v - 1) as usize }
    pub fn eq(self: view<SymbolId>, other: view<SymbolId>) -> bool { self.v == other.v }
    pub fn to_raw(self: view<SymbolId>) -> u32 { self.v }
    pub fn from_raw(v: u32) -> SymbolId { SymbolId { v: v } }
}

pub struct TypeId {
    pub v: u32,
}

impl TypeId {
    pub fn none() -> TypeId { TypeId { v: 0 } }
    pub fn is_none(self: view<TypeId>) -> bool { self.v == 0 }
    pub fn is_some(self: view<TypeId>) -> bool { self.v != 0 }
    pub fn from_index(index: usize) -> TypeId { TypeId { v: (index + 1) as u32 } }
    pub fn index(self: view<TypeId>) -> usize { (self.v - 1) as usize }
    pub fn eq(self: view<TypeId>, other: view<TypeId>) -> bool { self.v == other.v }
    pub fn to_raw(self: view<TypeId>) -> u32 { self.v }
    pub fn from_raw(v: u32) -> TypeId { TypeId { v: v } }
}

// RawIdTable — Untyped contiguous ID table backing typed ID tables
pub struct RawIdTable {
    pub items: *mut u8,
    pub elem_size: usize,
    pub elem_align: usize,
    pub len: usize,
    pub cap: usize,
}

pub fn raw_idtable_new(elem_size: usize, elem_align: usize) -> RawIdTable {
    raw_idtable_with_capacity(0, elem_size, elem_align)
}

pub fn raw_idtable_with_capacity(capacity: usize, elem_size: usize, elem_align: usize) -> RawIdTable {
    let esz = if elem_size == 0 { 1 } else { elem_size };
    let eal = if elem_align == 0 { 1 } else { elem_align };
    if capacity == 0 {
        return RawIdTable {
            items: 0 as *mut u8,
            elem_size: esz,
            elem_align: eal,
            len: 0,
            cap: 0,
        };
    }
    let raw = unsafe { heap_alloc(capacity * esz, eal) };
    RawIdTable {
        items: raw,
        elem_size: esz,
        elem_align: eal,
        len: 0,
        cap: capacity,
    }
}

pub fn raw_idtable_free(t: mut_view<RawIdTable>) {
    if t.cap > 0 && t.items as usize != 0 {
        unsafe {
            heap_free(t.items, t.cap * t.elem_size, t.elem_align);
        }
    }
    t.items = 0 as *mut u8;
    t.len = 0;
    t.cap = 0;
}

pub fn raw_idtable_clear(t: mut_view<RawIdTable>) {
    t.len = 0;
}

pub fn raw_idtable_len(t: view<RawIdTable>) -> usize {
    t.len
}

pub fn raw_idtable_is_empty(t: view<RawIdTable>) -> bool {
    t.len == 0
}

pub fn raw_idtable_contains(t: view<RawIdTable>, id_val: u32) -> bool {
    id_val != 0 && (id_val as usize) <= t.len
}

pub fn raw_idtable_push(t: mut_view<RawIdTable>, src: *const u8) -> u32 {
    if t.len == t.cap {
        let new_cap = if t.cap == 0 { 4 } else { t.cap + t.cap };
        let new_items = unsafe { heap_alloc(new_cap * t.elem_size, t.elem_align) };
        if t.len > 0 && t.items as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(t.items as *const u8, new_items, t.len * t.elem_size);
                heap_free(t.items, t.cap * t.elem_size, t.elem_align);
            }
        }
        t.items = new_items;
        t.cap = new_cap;
    }
    let dst = (t.items as usize + t.len * t.elem_size) as *mut u8;
    if src as usize != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(src, dst, t.elem_size);
        }
    }
    t.len = t.len + 1;
    t.len as u32
}

pub unsafe fn raw_idtable_get_ptr(t: view<RawIdTable>, id_val: u32) -> *const u8 {
    (t.items as usize + ((id_val - 1) as usize) * t.elem_size) as *const u8
}

pub unsafe fn raw_idtable_get_mut_ptr(t: mut_view<RawIdTable>, id_val: u32) -> *mut u8 {
    (t.items as usize + ((id_val - 1) as usize) * t.elem_size) as *mut u8
}

pub fn raw_idtable_first(t: view<RawIdTable>) -> u32 {
    if t.len == 0 { 0u32 } else { 1u32 }
}

pub fn raw_idtable_after(t: view<RawIdTable>, id_val: u32) -> u32 {
    if (id_val as usize) < t.len { id_val + 1u32 } else { 0u32 }
}

// U32IdTable — Convenient typed ID table storing 32-bit values
pub struct U32IdTable {
    pub raw: RawIdTable,
}

pub fn u32_idtable_new() -> U32IdTable {
    U32IdTable {
        raw: raw_idtable_new(4, 4),
    }
}

pub fn u32_idtable_with_capacity(capacity: usize) -> U32IdTable {
    U32IdTable {
        raw: raw_idtable_with_capacity(capacity, 4, 4),
    }
}

pub fn u32_idtable_free(t: mut_view<U32IdTable>) {
    raw_idtable_free(mut_view(t.raw));
}

pub fn u32_idtable_len(t: view<U32IdTable>) -> usize {
    t.raw.len
}

pub fn u32_idtable_is_empty(t: view<U32IdTable>) -> bool {
    t.raw.len == 0
}

pub fn u32_idtable_contains(t: view<U32IdTable>, id_val: u32) -> bool {
    raw_idtable_contains(view(t.raw), id_val)
}

pub fn u32_idtable_push(t: mut_view<U32IdTable>, val: u32) -> u32 {
    unsafe {
        raw_idtable_push(mut_view(t.raw), address_of(val) as *const u8)
    }
}

pub fn u32_idtable_get(t: view<U32IdTable>, id_val: u32) -> u32 {
    if !raw_idtable_contains(view(t.raw), id_val) {
        return 0u32;
    }
    unsafe {
        let p = raw_idtable_get_ptr(view(t.raw), id_val) as *const u32;
        *p
    }
}

pub fn u32_idtable_set(t: mut_view<U32IdTable>, id_val: u32, val: u32) -> bool {
    if !raw_idtable_contains(view(t.raw), id_val) {
        return false;
    }
    unsafe {
        let p = raw_idtable_get_mut_ptr(mut_view(t.raw), id_val) as *mut u32;
        *p = val;
    }
    true
}

pub fn u32_idtable_first(t: view<U32IdTable>) -> u32 {
    raw_idtable_first(view(t.raw))
}

pub fn u32_idtable_after(t: view<U32IdTable>, id_val: u32) -> u32 {
    raw_idtable_after(view(t.raw), id_val)
}


// AXH64 v1 constants (matching bootstrap/axiom0/src/kernel/hash.c and ADR-0004 §4)

pub fn ax_rotl64(x: u64, n: u32) -> u64 {
    rotate_left_u64(x, n)
}

fn axh_round(h: u64, w: u64) -> u64 {
    let m = wrapping_mul_u64(ax_rotl64(wrapping_mul_u64(w, AXH_K2), 31u32), AXH_K1);
    wrapping_add_u64(wrapping_mul_u64(ax_rotl64(h ^ m, 27u32), AXH_K1), AXH_K3)
}

fn axh_fold(h: u64) -> u64 {
    h ^ ax_rotl64(h, 15u32) ^ ax_rotl64(h, 40u32)
}

fn axh_avalanche(mut h: u64) -> u64 {
    h = wrapping_mul_u64(axh_fold(h), AXH_M);
    h = wrapping_mul_u64(axh_fold(h), AXH_K2);
    axh_fold(h)
}

pub struct AxHasher {
    pub h: u64,
    pub total_len: u64,
    pub buf: [8]u8,
    pub buf_len: usize,
}

pub fn ax_hasher_new() -> AxHasher {
    AxHasher {
        h: AXH_SEED,
        total_len: 0u64,
        buf: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8],
        buf_len: 0,
    }
}

pub fn ax_hasher_init(s: mut_view<AxHasher>) {
    s.h = AXH_SEED;
    s.total_len = 0u64;
    s.buf[0] = 0u8;
    s.buf[1] = 0u8;
    s.buf[2] = 0u8;
    s.buf[3] = 0u8;
    s.buf[4] = 0u8;
    s.buf[5] = 0u8;
    s.buf[6] = 0u8;
    s.buf[7] = 0u8;
    s.buf_len = 0;
}

pub fn ax_hasher_write(s: mut_view<AxHasher>, bytes: *const u8, mut byte_len: usize) {
    let mut p = bytes;
    s.total_len = wrapping_add_u64(s.total_len, byte_len as u64);
    while byte_len > 0 {
        if s.buf_len == 0 && byte_len >= 8 {
            let mut w: u64 = 0;
            let mut j: usize = 0;
            while j < 8 {
                let b = unsafe { *(p + j) } as u64;
                w = w | (b << (8 * j as u32));
                j = j + 1;
            }
            s.h = axh_round(s.h, w);
            p = unsafe { p + 8 };
            byte_len = byte_len - 8;
            continue;
        }
        s.buf[s.buf_len] = unsafe { *p };
        s.buf_len = s.buf_len + 1;
        p = unsafe { p + 1 };
        byte_len = byte_len - 1;
        if s.buf_len == 8 {
            let mut w: u64 = 0;
            let mut j: usize = 0;
            while j < 8 {
                let b = s.buf[j] as u64;
                w = w | (b << (8 * j as u32));
                j = j + 1;
            }
            s.h = axh_round(s.h, w);
            s.buf_len = 0;
        }
    }
}

pub fn ax_hasher_write_u32(s: mut_view<AxHasher>, mut v: u32) {
    let mut i: usize = 0;
    while i < 4 {
        s.total_len = wrapping_add_u64(s.total_len, 1u64);
        s.buf[s.buf_len] = (v & 0xFFu32) as u8;
        s.buf_len = s.buf_len + 1;
        if s.buf_len == 8 {
            let mut w: u64 = 0;
            let mut j: usize = 0;
            while j < 8 {
                let b = s.buf[j] as u64;
                w = w | (b << (8 * j as u32));
                j = j + 1;
            }
            s.h = axh_round(s.h, w);
            s.buf_len = 0;
        }
        v = v >> 8u32;
        i = i + 1;
    }
}

pub fn ax_hasher_write_u64(s: mut_view<AxHasher>, mut v: u64) {
    let mut i: usize = 0;
    while i < 8 {
        s.total_len = wrapping_add_u64(s.total_len, 1u64);
        s.buf[s.buf_len] = (v & 0xFFu64) as u8;
        s.buf_len = s.buf_len + 1;
        if s.buf_len == 8 {
            let mut w: u64 = 0;
            let mut j: usize = 0;
            while j < 8 {
                let b = s.buf[j] as u64;
                w = w | (b << (8 * j as u32));
                j = j + 1;
            }
            s.h = axh_round(s.h, w);
            s.buf_len = 0;
        }
        v = v >> 8u32;
        i = i + 1;
    }
}

pub fn ax_hasher_finish(s: view<AxHasher>) -> u64 {
    let mut h = s.h;
    if s.buf_len > 0 {
        let mut w: u64 = 0;
        let mut j: usize = 0;
        while j < s.buf_len {
            let b = s.buf[j] as u64;
            w = w | (b << (8 * j as u32));
            j = j + 1;
        }
        h = axh_round(h, w);
    }
    h = h ^ wrapping_mul_u64(s.total_len, AXH_K3);
    axh_avalanche(h)
}

pub fn ax_hash_bytes(bytes: *const u8, byte_len: usize) -> u64 {
    let mut s = ax_hasher_new();
    ax_hasher_write(mut_view(s), bytes, byte_len);
    ax_hasher_finish(view(s))
}

pub fn ax_hash_u32(v: u32) -> u64 {
    let mut s = ax_hasher_new();
    ax_hasher_write_u32(mut_view(s), v);
    ax_hasher_finish(view(s))
}

pub fn ax_hash_u64(v: u64) -> u64 {
    let mut s = ax_hasher_new();
    ax_hasher_write_u64(mut_view(s), v);
    ax_hasher_finish(view(s))
}

pub fn ax_hash_combine(a: u64, b: u64) -> u64 {
    let mut s = ax_hasher_new();
    ax_hasher_write_u64(mut_view(s), a);
    ax_hasher_write_u64(mut_view(s), b);
    ax_hasher_finish(view(s))
}



pub struct StrView {
    pub ptr: *const u8,
    pub len: usize,
}

pub struct StrInterner {
    pub bytes: Arena,
    pub strings: *mut StrView,
    pub len: usize,
    pub cap: usize,
    pub map_hashes: *mut u64,
    pub map_ids: *mut u32,
    pub map_cap: usize,
}

fn bytes_eq(a: *const u8, b: *const u8, n: usize) -> bool {
    let mut i: usize = 0;
    while i < n {
        if unsafe { *(a + i) } != unsafe { *(b + i) } {
            return false;
        }
        i = i + 1;
    }
    true
}

pub fn interner_init(in_: mut_view<StrInterner>) {
    in_.bytes = arena_new();
    in_.strings = 0 as *mut StrView;
    in_.len = 0;
    in_.cap = 0;
    in_.map_hashes = 0 as *mut u64;
    in_.map_ids = 0 as *mut u32;
    in_.map_cap = 0;
}

pub fn interner_new() -> StrInterner {
    let a = arena_new();
    StrInterner {
        bytes: a,
        strings: 0 as *mut StrView,
        len: 0,
        cap: 0,
        map_hashes: 0 as *mut u64,
        map_ids: 0 as *mut u32,
        map_cap: 0,
    }
}

pub fn interner_free(in_: mut_view<StrInterner>) {
    arena_destroy(mut_view(in_.bytes));
    if in_.cap > 0 && in_.strings as usize != 0 {
        unsafe {
            heap_free(in_.strings as *mut u8, in_.cap * size_of<StrView>(), align_of<StrView>());
        }
    }
    if in_.map_cap > 0 && in_.map_hashes as usize != 0 {
        unsafe {
            heap_free(in_.map_hashes as *mut u8, in_.map_cap * 8, 8);
            heap_free(in_.map_ids as *mut u8, in_.map_cap * 4, 4);
        }
    }
    in_.strings = 0 as *mut StrView;
    in_.len = 0;
    in_.cap = 0;
    in_.map_hashes = 0 as *mut u64;
    in_.map_ids = 0 as *mut u32;
    in_.map_cap = 0;
}

fn interner_grow_map(in_: mut_view<StrInterner>) {
    let new_cap: usize = if in_.map_cap == 0 { 16 } else { in_.map_cap + in_.map_cap };
    let new_hashes: *mut u64 = unsafe { heap_alloc(new_cap * 8, 8) as *mut u64 };
    let new_ids: *mut u32 = unsafe { heap_alloc(new_cap * 4, 4) as *mut u32 };
    let mut j: usize = 0;
    while j < new_cap {
        unsafe {
            *(new_ids + j) = 0u32;
        }
        j = j + 1;
    }

    let mask = new_cap - 1;
    let mut i: usize = 0;
    while i < in_.len {
        let sv = unsafe { *(in_.strings + i) };
        let h = ax_hash_bytes(sv.ptr, sv.len);
        let mut slot = (h as usize) & mask;
        while unsafe { *(new_ids + slot) } != 0u32 {
            slot = (slot + 1) & mask;
        }
        unsafe {
            *(new_hashes + slot) = h;
            *(new_ids + slot) = (i + 1) as u32;
        }
        i = i + 1;
    }

    if in_.map_cap > 0 && in_.map_hashes as usize != 0 {
        unsafe {
            heap_free(in_.map_hashes as *mut u8, in_.map_cap * 8, 8);
            heap_free(in_.map_ids as *mut u8, in_.map_cap * 4, 4);
        }
    }
    in_.map_hashes = new_hashes;
    in_.map_ids = new_ids;
    in_.map_cap = new_cap;
}

pub fn interner_intern_bytes(in_: mut_view<StrInterner>, p_s: *const u8, n: usize) -> StrId {
    let h = ax_hash_bytes(p_s, n);

    if in_.map_cap > 0 {
        let mask = in_.map_cap - 1;
        let mut slot = (h as usize) & mask;
        while true {
            let id_v = unsafe { *(in_.map_ids + slot) };
            if id_v == 0u32 {
                break;
            }
            if unsafe { *(in_.map_hashes + slot) } == h {
                let sv = unsafe { *(in_.strings + ((id_v - 1) as usize)) };
                if sv.len == n && bytes_eq(sv.ptr, p_s, n) {
                    return StrId { v: id_v };
                }
            }
            slot = (slot + 1) & mask;
        }
    }

    let copy = arena_alloc_raw(mut_view(in_.bytes), n + 1, 1);
    if n > 0 && p_s as usize != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(p_s, copy, n);
            *(copy + n) = 0u8;
        }
    }

    if in_.len == in_.cap {
        let new_cap: usize = if in_.cap == 0 { 8 } else { in_.cap + in_.cap };
        let new_strings: *mut StrView = unsafe { heap_alloc(new_cap * size_of<StrView>(), align_of<StrView>()) as *mut StrView };
        if in_.len > 0 && in_.strings as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<StrView>(in_.strings as *const StrView, new_strings, in_.len);
                heap_free(in_.strings as *mut u8, in_.cap * size_of<StrView>(), align_of<StrView>());
            }
        }
        in_.strings = new_strings;
        in_.cap = new_cap;
    }

    let sv = StrView { ptr: copy as *const u8, len: n };
    unsafe {
        *(in_.strings + in_.len) = sv;
    }
    let new_id = StrId { v: (in_.len + 1) as u32 };
    in_.len = in_.len + 1;

    if in_.map_cap == 0 || in_.len * 4 > in_.map_cap * 3 {
        interner_grow_map(in_);
    } else {
        let mask = in_.map_cap - 1;
        let mut slot = (h as usize) & mask;
        while unsafe { *(in_.map_ids + slot) } != 0u32 {
            slot = (slot + 1) & mask;
        }
        unsafe {
            *(in_.map_hashes + slot) = h;
            *(in_.map_ids + slot) = new_id.v;
        }
    }

    new_id
}

pub fn interner_intern_str(in_: mut_view<StrInterner>, s: view<Str>) -> StrId {
    let p_s = unsafe { *(address_of(*s) as *const *const u8) };
    let n = len(*s);
    interner_intern_bytes(in_, p_s, n)
}

pub fn interner_lookup_bytes(in_: view<StrInterner>, p_s: *const u8, n: usize) -> StrId {
    if in_.map_cap == 0 || in_.len == 0 {
        return StrId.none();
    }
    let h = ax_hash_bytes(p_s, n);
    let mask = in_.map_cap - 1;
    let mut slot = (h as usize) & mask;
    while true {
        let id_v = unsafe { *(in_.map_ids + slot) };
        if id_v == 0u32 {
            return StrId.none();
        }
        if unsafe { *(in_.map_hashes + slot) } == h {
            let sv = unsafe { *(in_.strings + ((id_v - 1) as usize)) };
            if sv.len == n && bytes_eq(sv.ptr, p_s, n) {
                return StrId { v: id_v };
            }
        }
        slot = (slot + 1) & mask;
    }
    StrId.none()
}

pub fn interner_lookup_str(in_: view<StrInterner>, s: view<Str>) -> StrId {
    let p_s = unsafe { *(address_of(*s) as *const *const u8) };
    let n = len(*s);
    interner_lookup_bytes(in_, p_s, n)
}

pub fn interner_get(in_: view<StrInterner>, id: StrId) -> StrView {
    if id.v == 0 || (id.v as usize) > in_.len {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    unsafe {
        *(in_.strings + ((id.v - 1) as usize))
    }
}

pub fn interner_len(in_: view<StrInterner>) -> usize {
    in_.len
}

pub fn interner_is_empty(in_: view<StrInterner>) -> bool {
    in_.len == 0
}

// U32Interner — Deterministic hash-consing for 32-bit values
pub struct U32Interner {
    pub items: *mut u32,
    pub len: usize,
    pub cap: usize,
    pub map_hashes: *mut u64,
    pub map_ids: *mut u32,
    pub map_cap: usize,
}

pub fn u32_interner_new() -> U32Interner {
    U32Interner {
        items: 0 as *mut u32,
        len: 0,
        cap: 0,
        map_hashes: 0 as *mut u64,
        map_ids: 0 as *mut u32,
        map_cap: 0,
    }
}

pub fn u32_interner_free(in_: mut_view<U32Interner>) {
    if in_.cap > 0 && in_.items as usize != 0 {
        unsafe {
            heap_free(in_.items as *mut u8, in_.cap * 4, 4);
        }
    }
    if in_.map_cap > 0 && in_.map_hashes as usize != 0 {
        unsafe {
            heap_free(in_.map_hashes as *mut u8, in_.map_cap * 8, 8);
            heap_free(in_.map_ids as *mut u8, in_.map_cap * 4, 4);
        }
    }
    in_.items = 0 as *mut u32;
    in_.len = 0;
    in_.cap = 0;
    in_.map_hashes = 0 as *mut u64;
    in_.map_ids = 0 as *mut u32;
    in_.map_cap = 0;
}

fn u32_interner_grow_map(in_: mut_view<U32Interner>) {
    let new_cap: usize = if in_.map_cap == 0 { 16 } else { in_.map_cap + in_.map_cap };
    let new_hashes: *mut u64 = unsafe { heap_alloc(new_cap * 8, 8) as *mut u64 };
    let new_ids: *mut u32 = unsafe { heap_alloc(new_cap * 4, 4) as *mut u32 };
    let mut j: usize = 0;
    while j < new_cap {
        unsafe {
            *(new_ids + j) = 0u32;
        }
        j = j + 1;
    }

    let mask = new_cap - 1;
    let mut i: usize = 0;
    while i < in_.len {
        let val = unsafe { *(in_.items + i) };
        let h = ax_hash_u32(val);
        let mut slot = (h as usize) & mask;
        while unsafe { *(new_ids + slot) } != 0u32 {
            slot = (slot + 1) & mask;
        }
        unsafe {
            *(new_hashes + slot) = h;
            *(new_ids + slot) = (i + 1) as u32;
        }
        i = i + 1;
    }

    if in_.map_cap > 0 && in_.map_hashes as usize != 0 {
        unsafe {
            heap_free(in_.map_hashes as *mut u8, in_.map_cap * 8, 8);
            heap_free(in_.map_ids as *mut u8, in_.map_cap * 4, 4);
        }
    }
    in_.map_hashes = new_hashes;
    in_.map_ids = new_ids;
    in_.map_cap = new_cap;
}

pub fn u32_intern(in_: mut_view<U32Interner>, val: u32) -> u32 {
    let h = ax_hash_u32(val);
    if in_.map_cap > 0 {
        let mask = in_.map_cap - 1;
        let mut slot = (h as usize) & mask;
        while true {
            let id_v = unsafe { *(in_.map_ids + slot) };
            if id_v == 0u32 {
                break;
            }
            if unsafe { *(in_.map_hashes + slot) } == h {
                let existing = unsafe { *(in_.items + ((id_v - 1) as usize)) };
                if existing == val {
                    return id_v;
                }
            }
            slot = (slot + 1) & mask;
        }
    }

    if in_.len == in_.cap {
        let new_cap: usize = if in_.cap == 0 { 8 } else { in_.cap + in_.cap };
        let new_items: *mut u32 = unsafe { heap_alloc(new_cap * 4, 4) as *mut u32 };
        if in_.len > 0 && in_.items as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u32>(in_.items as *const u32, new_items, in_.len);
                heap_free(in_.items as *mut u8, in_.cap * 4, 4);
            }
        }
        in_.items = new_items;
        in_.cap = new_cap;
    }

    unsafe {
        *(in_.items + in_.len) = val;
    }
    let new_id = (in_.len + 1) as u32;
    in_.len = in_.len + 1;

    if in_.map_cap == 0 || in_.len * 4 > in_.map_cap * 3 {
        u32_interner_grow_map(in_);
    } else {
        let mask = in_.map_cap - 1;
        let mut slot = (h as usize) & mask;
        while unsafe { *(in_.map_ids + slot) } != 0u32 {
            slot = (slot + 1) & mask;
        }
        unsafe {
            *(in_.map_hashes + slot) = h;
            *(in_.map_ids + slot) = new_id;
        }
    }

    new_id
}

pub fn u32_interner_lookup(in_: view<U32Interner>, val: u32) -> u32 {
    if in_.map_cap == 0 || in_.len == 0 {
        return 0u32;
    }
    let h = ax_hash_u32(val);
    let mask = in_.map_cap - 1;
    let mut slot = (h as usize) & mask;
    while true {
        let id_v = unsafe { *(in_.map_ids + slot) };
        if id_v == 0u32 {
            return 0u32;
        }
        if unsafe { *(in_.map_hashes + slot) } == h {
            let existing = unsafe { *(in_.items + ((id_v - 1) as usize)) };
            if existing == val {
                return id_v;
            }
        }
        slot = (slot + 1) & mask;
    }
    0u32
}

pub fn u32_interner_get(in_: view<U32Interner>, id: u32) -> u32 {
    if id == 0 || (id as usize) > in_.len {
        return 0u32;
    }
    unsafe {
        *(in_.items + ((id - 1) as usize))
    }
}

pub fn u32_interner_len(in_: view<U32Interner>) -> usize {
    in_.len
}

pub fn u32_interner_is_empty(in_: view<U32Interner>) -> bool {
    in_.len == 0
}


pub struct Span {
    pub file: FileId,
    pub start: u32,
    pub end: u32,
}

impl Span {
    pub fn new(file: FileId, start: u32, end: u32) -> Span {
        Span { file: file, start: start, end: end }
    }

    pub fn none() -> Span {
        Span { file: FileId.none(), start: 0u32, end: 0u32 }
    }

    pub fn is_none(self: view<Span>) -> bool {
        self.file.is_none()
    }

    pub fn is_some(self: view<Span>) -> bool {
        self.file.is_some()
    }

    pub fn len(self: view<Span>) -> u32 {
        if self.end >= self.start {
            self.end - self.start
        } else {
            0u32
        }
    }

    pub fn eq(self: view<Span>, other: view<Span>) -> bool {
        self.file.eq(view(other.file)) && self.start == other.start && self.end == other.end
    }
}

pub fn span_new(file: FileId, start: u32, end: u32) -> Span {
    Span.new(file, start, end)
}

pub fn span_none() -> Span {
    Span.none()
}

pub fn span_is_none(s: view<Span>) -> bool {
    s.is_none()
}

pub struct LineCol {
    pub line: u32,       // 1-based line number
    pub col_bytes: u32,  // 1-based column in bytes
    pub col_chars: u32,  // 1-based column in Unicode scalar values
}

impl LineCol {
    pub fn zero() -> LineCol {
        LineCol { line: 0u32, col_bytes: 0u32, col_chars: 0u32 }
    }

    pub fn eq(self: view<LineCol>, other: view<LineCol>) -> bool {
        self.line == other.line && self.col_bytes == other.col_bytes && self.col_chars == other.col_chars
    }
}





fn utf8_count_scalars(bytes: *const u8, byte_len: usize) -> usize {
    let mut count: usize = 0;
    let mut i: usize = 0;
    while i < byte_len {
        let b = unsafe { *(bytes + i) };
        if (b & 0xC0u8) != 0x80u8 {
            count = count + 1;
        }
        i = i + 1;
    }
    count
}

fn utf8_validate(bytes: *const u8, byte_len: usize) -> bool {
    let mut i: usize = 0;
    while i < byte_len {
        let b0 = unsafe { *(bytes + i) };
        if b0 < 0x80u8 {
            i = i + 1;
        } else if (b0 & 0xE0u8) == 0xC0u8 {
            if i + 1 >= byte_len { return false; }
            let b1 = unsafe { *(bytes + i + 1) };
            if (b1 & 0xC0u8) != 0x80u8 { return false; }
            if b0 < 0xC2u8 { return false; }
            i = i + 2;
        } else if (b0 & 0xF0u8) == 0xE0u8 {
            if i + 2 >= byte_len { return false; }
            let b1 = unsafe { *(bytes + i + 1) };
            let b2 = unsafe { *(bytes + i + 2) };
            if (b1 & 0xC0u8) != 0x80u8 || (b2 & 0xC0u8) != 0x80u8 { return false; }
            if b0 == 0xE0u8 && b1 < 0xA0u8 { return false; }
            if b0 == 0xEDu8 && b1 >= 0xA0u8 { return false; }
            i = i + 3;
        } else if (b0 & 0xF8u8) == 0xF0u8 {
            if i + 3 >= byte_len { return false; }
            let b1 = unsafe { *(bytes + i + 1) };
            let b2 = unsafe { *(bytes + i + 2) };
            let b3 = unsafe { *(bytes + i + 3) };
            if (b1 & 0xC0u8) != 0x80u8 || (b2 & 0xC0u8) != 0x80u8 || (b3 & 0xC0u8) != 0x80u8 { return false; }
            if b0 == 0xF0u8 && b1 < 0x90u8 { return false; }
            if b0 == 0xF4u8 && b1 > 0x8Fu8 { return false; }
            if b0 > 0xF4u8 { return false; }
            i = i + 4;
        } else {
            return false;
        }
    }
    true
}

pub struct SourceFile {
    pub id: FileId,
    pub canonical_path: StrView,
    pub text: StrView,
    pub content_hash: u64,
    pub line_offsets: *mut u32,
    pub line_count: usize,
    pub line_cap: usize,
    pub alloc_ptr: *mut u8,
    pub alloc_size: usize,
    pub has_invalid_utf8: bool,
}

unsafe fn file_ptr(files: *mut SourceFile, idx: usize) -> *mut SourceFile {
    ((files as usize) + idx * size_of<SourceFile>()) as *mut SourceFile
}

unsafe fn offset_ptr(offsets: *mut u32, idx: usize) -> *mut u32 {
    ((offsets as usize) + idx * 4) as *mut u32
}

pub struct SourceDatabase {
    pub arena: Arena,
    pub files: *mut SourceFile,
    pub files_count: usize,
    pub files_cap: usize,
}

pub fn source_db_init(db: mut_view<SourceDatabase>) {
    db.arena = arena_new();
    db.files = 0 as *mut SourceFile;
    db.files_count = 0;
    db.files_cap = 0;
}

pub fn source_db_free(db: mut_view<SourceDatabase>) {
    let mut i: usize = 0;
    while i < db.files_count {
        let sf = unsafe { *(file_ptr(db.files, i)) };
        if sf.line_cap > 0 && sf.line_offsets as usize != 0 {
            unsafe {
                heap_free(sf.line_offsets as *mut u8, sf.line_cap * 4, 4);
            }
        }
        if sf.alloc_ptr as usize != 0 && sf.alloc_size > 0 {
            unsafe {
                heap_free(sf.alloc_ptr, sf.alloc_size, 1);
            }
        }
        i = i + 1;
    }
    if db.files_cap > 0 && db.files as usize != 0 {
        unsafe {
            heap_free(db.files as *mut u8, db.files_cap * size_of<SourceFile>(), align_of<SourceFile>());
        }
    }
    db.files = 0 as *mut SourceFile;
    db.files_count = 0;
    db.files_cap = 0;
    arena_destroy(mut_view(db.arena));
}

pub struct LineMapResult {
    pub offsets: *mut u32,
    pub count: usize,
    pub cap: usize,
}

fn build_line_map(text_ptr: *const u8, text_len: usize) -> LineMapResult {
    let mut cap: usize = 512;
    let mut count: usize = 0;
    let mut offsets = unsafe { heap_alloc(cap * 4, 4) as *mut u32 };

    // Line 1 starts at byte offset 0
    unsafe {
        *(offset_ptr(offsets, 0)) = 0u32;
    }
    count = 1;

    let mut i: usize = 0;
    while i < text_len {
        let b = unsafe { *(text_ptr + i) };
        if b == 13u8 && i + 1 < text_len && unsafe { *(text_ptr + i + 1) } == 10u8 { // \r\n
            if count == cap {
                let new_cap = cap + cap;
                let new_offsets = unsafe { heap_alloc(new_cap * 4, 4) as *mut u32 };
                if count > 0 && offsets as usize != 0 {
                    unsafe {
                        ptr_copy_nonoverlapping<u8>(offsets as *const u8, new_offsets as *mut u8, count * 4);
                        heap_free(offsets as *mut u8, cap * 4, 4);
                    }
                }
                offsets = new_offsets;
                cap = new_cap;
            }
            unsafe {
                *(offset_ptr(offsets, count)) = (i + 2) as u32;
            }
            count = count + 1;
            i = i + 2;
        } else if b == 10u8 { // \n
            if count == cap {
                let new_cap = cap + cap;
                let new_offsets = unsafe { heap_alloc(new_cap * 4, 4) as *mut u32 };
                if count > 0 && offsets as usize != 0 {
                    unsafe {
                        ptr_copy_nonoverlapping<u8>(offsets as *const u8, new_offsets as *mut u8, count * 4);
                        heap_free(offsets as *mut u8, cap * 4, 4);
                    }
                }
                offsets = new_offsets;
                cap = new_cap;
            }
            unsafe {
                *(offset_ptr(offsets, count)) = (i + 1) as u32;
            }
            count = count + 1;
            i = i + 1;
        } else {
            i = i + 1;
        }
    }

    LineMapResult {
        offsets: offsets,
        count: count,
        cap: cap,
    }
}

pub fn source_db_add_virtual(db: mut_view<SourceDatabase>, identity_ptr: *const u8, identity_len: usize, text_ptr: *const u8, text_len: usize) -> FileId {
    // Check if file with same identity is already loaded
    let mut i: usize = 0;
    while i < db.files_count {
        let existing = unsafe { *(file_ptr(db.files, i)) };
        if existing.canonical_path.len == identity_len && bytes_eq(existing.canonical_path.ptr, identity_ptr, identity_len) {
            return FileId { v: existing.id.v };
        }
        i = i + 1;
    }

    // Allocate copy of path in db.arena
    let path_copy = arena_alloc_raw(mut_view(db.arena), identity_len + 1, 1);
    if identity_len > 0 && identity_ptr as usize != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(identity_ptr, path_copy, identity_len);
            *(path_copy + identity_len) = 0u8;
        }
    }

    // Handle UTF-8 BOM in text
    let mut p_text = text_ptr;
    let mut actual_len = text_len;
    if actual_len >= 3 && unsafe { *p_text } == 0xEFu8 && unsafe { *(p_text + 1) } == 0xBBu8 && unsafe { *(p_text + 2) } == 0xBFu8 {
        p_text = unsafe { p_text + 3 };
        actual_len = actual_len - 3;
    }

    // Allocate copy of text in db.arena
    let text_copy = arena_alloc_raw(mut_view(db.arena), actual_len + 1, 1);
    if actual_len > 0 && p_text as usize != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(p_text, text_copy, actual_len);
            *(text_copy + actual_len) = 0u8;
        }
    }

    let hash = ax_hash_bytes(text_copy as *const u8, actual_len);
    let is_valid = utf8_validate(text_copy as *const u8, actual_len);

    let lm = build_line_map(text_copy as *const u8, actual_len);

    let new_id = FileId { v: (db.files_count + 1) as u32 };

    if db.files_count == db.files_cap {
        let new_cap = if db.files_cap == 0 { 8 } else { db.files_cap + db.files_cap };
        let new_files = unsafe { heap_alloc(new_cap * size_of<SourceFile>(), align_of<SourceFile>()) as *mut SourceFile };
        if db.files_count > 0 && db.files as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(db.files as *const u8, new_files as *mut u8, db.files_count * size_of<SourceFile>());
                heap_free(db.files as *mut u8, db.files_cap * size_of<SourceFile>(), align_of<SourceFile>());
            }
        }
        db.files = new_files;
        db.files_cap = new_cap;
    }

    let sf = SourceFile {
        id: FileId { v: new_id.v },
        canonical_path: StrView { ptr: path_copy as *const u8, len: identity_len },
        text: StrView { ptr: text_copy as *const u8, len: actual_len },
        content_hash: hash,
        line_offsets: lm.offsets,
        line_count: lm.count,
        line_cap: lm.cap,
        alloc_ptr: 0 as *mut u8,
        alloc_size: 0,
        has_invalid_utf8: !is_valid,
    };

    unsafe {
        *(file_ptr(db.files, db.files_count)) = sf;
    }
    db.files_count = db.files_count + 1;

    new_id
}

pub fn source_db_file_count(db: view<SourceDatabase>) -> usize {
    db.files_count
}

pub fn source_db_text(db: view<SourceDatabase>, file: FileId) -> StrView {
    if file.v == 0 || (file.v as usize) > db.files_count {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let sf = unsafe { *(file_ptr(db.files, (file.v - 1) as usize)) };
    sf.text
}

pub fn source_db_path(db: view<SourceDatabase>, file: FileId) -> StrView {
    if file.v == 0 || (file.v as usize) > db.files_count {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let sf = unsafe { *(file_ptr(db.files, (file.v - 1) as usize)) };
    sf.canonical_path
}

pub fn source_db_hash(db: view<SourceDatabase>, file: FileId) -> u64 {
    if file.v == 0 || (file.v as usize) > db.files_count {
        return 0u64;
    }
    let sf = unsafe { *(file_ptr(db.files, (file.v - 1) as usize)) };
    sf.content_hash
}

pub fn source_db_has_invalid_utf8(db: view<SourceDatabase>, file: FileId) -> bool {
    if file.v == 0 || (file.v as usize) > db.files_count {
        return false;
    }
    let sf = unsafe { *(file_ptr(db.files, (file.v - 1) as usize)) };
    sf.has_invalid_utf8
}

pub fn source_db_span_text(db: view<SourceDatabase>, span: Span) -> StrView {
    if span.file.v == 0 || (span.file.v as usize) > db.files_count {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let sf = unsafe { *(file_ptr(db.files, (span.file.v - 1) as usize)) };
    if span.start > span.end || (span.end as usize) > sf.text.len {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    StrView {
        ptr: (sf.text.ptr as usize + (span.start as usize)) as *const u8,
        len: (span.end - span.start) as usize,
    }
}

pub fn source_db_line_col(db: view<SourceDatabase>, span: Span) -> LineCol {
    if span.file.v == 0 || (span.file.v as usize) > db.files_count {
        return LineCol.zero();
    }
    let sf = unsafe { *(file_ptr(db.files, (span.file.v - 1) as usize)) };

    let mut offset = span.start;
    if (offset as usize) > sf.text.len {
        offset = sf.text.len as u32;
    }

    let mut low: usize = 0;
    let mut high: usize = sf.line_count;
    let mut line_idx: usize = 0;
    while low < high {
        let mid = low + (high - low) / 2;
        let line_off = unsafe { *(offset_ptr(sf.line_offsets, mid)) };
        if line_off <= offset {
            line_idx = mid;
            low = mid + 1;
        } else {
            high = mid;
        }
    }

    let line_start = unsafe { *(offset_ptr(sf.line_offsets, line_idx)) };
    let col_bytes = offset - line_start + 1u32;
    let byte_diff = (offset - line_start) as usize;
    let p = (sf.text.ptr as usize + line_start as usize) as *const u8;
    let col_chars = (utf8_count_scalars(p, byte_diff) + 1) as u32;

    LineCol {
        line: (line_idx + 1) as u32,
        col_bytes: col_bytes,
        col_chars: col_chars,
    }
}

pub fn source_db_line_range(db: view<SourceDatabase>, file: FileId, line: u32) -> Span {
    if file.v == 0 || (file.v as usize) > db.files_count {
        return span_none();
    }
    let sf = unsafe { *(file_ptr(db.files, (file.v - 1) as usize)) };
    if line == 0u32 || (line as usize) > sf.line_count {
        return span_none();
    }

    let start = unsafe { *(offset_ptr(sf.line_offsets, (line - 1u32) as usize)) };
    let mut end: u32 = 0u32;
    if (line as usize) < sf.line_count {
        end = unsafe { *(offset_ptr(sf.line_offsets, line as usize)) };
        // Exclude trailing \n or \r\n
        if end > start && unsafe { *(sf.text.ptr + (end - 1u32) as usize) } == 10u8 { // \n
            end = end - 1u32;
            if end > start && unsafe { *(sf.text.ptr + (end - 1u32) as usize) } == 13u8 { // \r
                end = end - 1u32;
            }
        }
    } else {
        end = sf.text.len as u32;
    }
    span_new(file, start, end)
}

@derive(Copy)
pub enum DiagSeverity {
    Error,
    Warning,
    Info,
    Hint,
}

@derive(Copy)
pub enum FixApplicability {
    MachineApplicable,
    MaybeApplicable,
    ManualReview,
}

@derive(Copy)
pub enum DiagDataKind {
    String,
    Integer,
    Boolean,
    StringList,
}

@derive(Copy)
pub struct DiagCode {
    pub v: u32,
}

pub fn diag_code(v: u32) -> DiagCode {
    DiagCode { v: v }
}

pub fn diag_code_eq(a: DiagCode, b: DiagCode) -> bool {
    a.v == b.v
}


pub fn diag_code_name(c: DiagCode) -> Str {
    match c.v {
        0u32 => "AX_LEX_INVALID_UTF8", 1u32 => "AX_LEX_INVALID_CHAR", 2u32 => "AX_LEX_NON_ASCII_IDENT", 3u32 => "AX_LEX_UNTERMINATED_COMMENT",
        4u32 => "AX_LEX_UNTERMINATED_STRING", 5u32 => "AX_LEX_UNTERMINATED_CHAR", 6u32 => "AX_LEX_BAD_CHAR_LITERAL", 7u32 => "AX_LEX_INVALID_ESCAPE",
        8u32 => "AX_LEX_INVALID_UNICODE_ESCAPE", 9u32 => "AX_LEX_NON_ASCII_IN_BYTE_LITERAL", 10u32 => "AX_LEX_MISSING_DIGITS", 11u32 => "AX_LEX_BAD_BASE_PREFIX",
        12u32 => "AX_LEX_INVALID_DIGIT", 13u32 => "AX_LEX_BAD_DIGIT_SEPARATOR", 14u32 => "AX_LEX_INVALID_SUFFIX", 15u32 => "AX_LEX_INT_OVERFLOW",
        16u32 => "AX_LEX_INVALID_OPERATOR", 17u32 => "AX_LEX_COLON_COLON", 18u32 => "AX_LEX_COLON_EQ", 19u32 => "AX_PARSE_EXPECTED_TOKEN",
        20u32 => "AX_PARSE_EXPECTED_EXPR", 21u32 => "AX_PARSE_EXPECTED_TYPE", 22u32 => "AX_PARSE_EXPECTED_PATTERN", 23u32 => "AX_PARSE_EXPECTED_ITEM",
        24u32 => "AX_PARSE_EXPECTED_TERMINATOR", 25u32 => "AX_PARSE_EXPECTED_LOOP", 26u32 => "AX_PARSE_UNCLOSED_DELIMITER", 27u32 => "AX_PARSE_LEADING_OPERATOR",
        28u32 => "AX_PARSE_CHAINED_COMPARISON", 29u32 => "AX_PARSE_ASSIGN_IN_EXPR", 30u32 => "AX_PARSE_REFERENCE_OPERATOR", 31u32 => "AX_PARSE_VAR",
        32u32 => "AX_PARSE_IMPORT", 33u32 => "AX_PARSE_MOD", 34u32 => "AX_PARSE_MODULE_NOT_FIRST", 35u32 => "AX_PARSE_ITEM_IN_BLOCK",
        36u32 => "AX_PARSE_LET_NEEDS_TYPE_OR_INIT", 37u32 => "AX_PARSE_SELF_NEEDS_TYPE", 38u32 => "AX_PARSE_FN_BODY_REQUIRED", 39u32 => "AX_PARSE_FN_BODY_NOT_ALLOWED",
        40u32 => "AX_PARSE_VIS_NOT_ALLOWED", 41u32 => "AX_PARSE_ARRAY_TYPE_ORDER", 42u32 => "AX_PARSE_RESERVED_KEYWORD", 43u32 => "AX_PARSE_UNSUPPORTED_IN_BOOTSTRAP",
        44u32 => "AX_NAME_UNRESOLVED", 45u32 => "AX_NAME_DUPLICATE", 46u32 => "AX_NAME_NOT_A_VALUE", 47u32 => "AX_NAME_NOT_A_TYPE",
        48u32 => "AX_NAME_UNRESOLVED_IMPORT", 49u32 => "AX_NAME_SHADOW_MODULE", 50u32 => "AX_NAME_UNDEFINED_LABEL", 51u32 => "AX_NAME_BREAK_OUTSIDE_LOOP",
        52u32 => "AX_NAME_NOT_YET_SUPPORTED", 53u32 => "AX_NAME_DUPLICATE_BINDING", 54u32 => "AX_NAME_OR_PATTERN_MISMATCH", 55u32 => "AX_NAME_PRIVATE",
        56u32 => "AX_NAME_IMPORT_CYCLE", 57u32 => "AX_TYPE_MISMATCH", 58u32 => "AX_TYPE_UNKNOWN", 59u32 => "AX_TYPE_NOT_CALLABLE",
        60u32 => "AX_TYPE_ARG_COUNT", 61u32 => "AX_TYPE_RETURN", 62u32 => "AX_TYPE_OPERATOR", 63u32 => "AX_TYPE_LITERAL_OUT_OF_RANGE",
        64u32 => "AX_TYPE_NEG_UNSIGNED", 65u32 => "AX_TYPE_INVALID_CAST", 66u32 => "AX_TYPE_NEVER_RETURNS", 67u32 => "AX_TYPE_MAIN_MISSING",
        68u32 => "AX_TYPE_MAIN_SIGNATURE", 69u32 => "AX_TYPE_UNSUPPORTED_IN_BOOTSTRAP", 70u32 => "AX_TYPE_ASSIGN_IMMUTABLE", 71u32 => "AX_TYPE_UNINIT_USE",
        72u32 => "AX_TYPE_UNREACHABLE", 73u32 => "AX_TYPE_UNKNOWN_FIELD", 74u32 => "AX_TYPE_MISSING_FIELD", 75u32 => "AX_TYPE_DUPLICATE_FIELD",
        76u32 => "AX_TYPE_ARRAY_SIZE", 77u32 => "AX_TYPE_CANNOT_INDEX", 78u32 => "AX_TYPE_TRY_OPERAND", 79u32 => "AX_TYPE_TRY_RETURN_MISMATCH",
        80u32 => "AX_TYPE_STORED_VIEW_ESCAPE", 81u32 => "AX_TYPE_STORED_VIEW_SELF_REF", 82u32 => "AX_TRAIT_OVERLAP", 83u32 => "AX_TRAIT_AMBIGUOUS_METHOD",
        84u32 => "AX_TRAIT_UNSATISFIED_BOUND", 85u32 => "AX_TRAIT_UNKNOWN_DERIVE", 86u32 => "AX_PAT_NON_EXHAUSTIVE", 87u32 => "AX_PAT_REFUTABLE",
        88u32 => "AX_PAT_UNREACHABLE", 89u32 => "AX_MOVE_USE_AFTER_MOVE", 90u32 => "AX_INIT_USE_UNINIT", 91u32 => "AX_CAP_CONFLICT_MUT",
        92u32 => "AX_CAP_CONFLICT_READ", 93u32 => "AX_CAP_OUTLIVES_OWNER", 94u32 => "AX_UNSAFE_REQUIRED", 95u32 => "AX_UNSAFE_INTERP_UB",
        96u32 => "AX_CONST_OVERFLOW", 97u32 => "AX_CONST_DIV_ZERO", 98u32 => "AX_CONST_CYCLE", 99u32 => "AX_CONST_EVAL_LIMIT",
        100u32 => "AX_VERIFY_MIR_SYNTAX", 101u32 => "AX_VERIFY_UNKNOWN_LOCAL", 102u32 => "AX_VERIFY_UNTERMINATED_BLOCK", 103u32 => "AX_VERIFY_BAD_TARGET",
        104u32 => "AX_VERIFY_TYPE_MISMATCH", 105u32 => "AX_VERIFY_UNINIT_USE", 106u32 => "AX_VERIFY_CALL_SIGNATURE", 107u32 => "AX_VERIFY_RETURN_TYPE",
        108u32 => "AX_VERIFY_USE_AFTER_MOVE", 109u32 => "AX_VERIFY_MISSING_DROP", 110u32 => "AX_VERIFY_DOUBLE_DROP", 111u32 => "AX_FFI_NOT_IN_ORACLE",
        112u32 => "AX_LINK_UNDEFINED_SYMBOL", 113u32 => "AX_LINK_DUPLICATE_SYMBOL", 114u32 => "AX_LINK_RELOC_OUT_OF_RANGE", 115u32 => "AX_LINK_BAD_OBJECT",
        116u32 => "AX_LINK_IMAGE_TOO_LARGE", 117u32 => "AX_IO_FILE_NOT_FOUND", 118u32 => "AX_IO_READ_FAILED", 119u32 => "AX_IO_WRITE_FAILED",
        120u32 => "AX_IO_FILE_TOO_LARGE", 121u32 => "AX_DRIVER_USAGE", 122u32 => "AX_DRIVER_UNKNOWN_OPTION", 123u32 => "AX_DRIVER_NO_INPUT",
        124u32 => "AX_DRIVER_UNKNOWN_TARGET", 125u32 => "AX_DRIVER_STAGE_NOT_AVAILABLE", 126u32 => "AX_DRIVER_INTERP_STEP_LIMIT", 127u32 => "AX_DRIVER_INTERP_STACK_LIMIT",
        128u32 => "AX_DRIVER_NO_STD", 129u32 => "AX_DRIVER_BAD_MANIFEST", 130u32 => "AX_ICE_INTERNAL", 131u32 => "AX_ICE_MIR_VERIFY",
        132u32 => "AX_ICE_OUT_OF_MEMORY",
        _ => "<unknown>",
    }
}

pub fn diag_code_default_message(c: DiagCode) -> Str {
    match c.v {
        0u32 => "invalid UTF-8 byte sequence", 1u32 => "character that cannot start a token",
        2u32 => "non-ASCII character outside literals and comments", 3u32 => "block comment open at end of file",
        4u32 => "line break or end of file inside a string", 5u32 => "character literal without closing quote on the line",
        6u32 => "empty or multi-character char/byte literal", 7u32 => "unknown escape or bad \\\\x",
        8u32 => "malformed or non-scalar \\\\u{...}", 9u32 => "non-ASCII character in a byte literal",
        10u32 => "base prefix without digits", 11u32 => "upper-case base prefix",
        12u32 => "digit not valid for the base", 13u32 => "misplaced _ in a number",
        14u32 => "unknown or mismatched literal suffix", 15u32 => "integer literal above 2^64 - 1",
        16u32 => "three or more dots", 17u32 => ":: is not a token; paths use .",
        18u32 => ":= is not a token; bind with =", 19u32 => "expected a specific token",
        20u32 => "expected expression", 21u32 => "expected type",
        22u32 => "expected pattern", 23u32 => "expected item",
        24u32 => "expected a line break or ;", 25u32 => "expected loop",
        26u32 => "unclosed delimiter", 27u32 => "a line continues only when the previous line ends with an operator or this line starts with .; move the operator to the end of the previous line",
        28u32 => "comparison operators cannot be chained; use parentheses or &&", 29u32 => "assignment inside an expression; use == to compare",
        30u32 => "Axiom has no & reference operator; pass the value, or write view(x) / mut_view(x)", 31u32 => "replace var by let mut",
        32u32 => "import is not a keyword", 33u32 => "write module a.b at the top of the file; there are no inline modules",
        34u32 => "module declaration not at the start of the file", 35u32 => "item inside a block",
        36u32 => "let needs type or initializer", 37u32 => "self parameter needs a type",
        38u32 => "function body required", 39u32 => "function body not allowed here",
        40u32 => "visibility not allowed here", 41u32 => "array type must be written [N]T",
        42u32 => "reserved keyword", 43u32 => "unsupported in bootstrap",
        44u32 => "name not found in scope", 45u32 => "name defined twice in one scope",
        46u32 => "a module or type used where a value is expected", 47u32 => "a value or module used where a type is expected",
        48u32 => "use path does not name an existing item or module", 49u32 => "a local binding shadows a module name (lookup order still picks the local)",
        50u32 => "break / continue names an unknown label", 51u32 => "break or continue outside a loop",
        52u32 => "construct parsed but not lowered by this build yet (AXD-014)", 53u32 => "duplicate binding in pattern",
        54u32 => "inconsistent or-pattern bindings", 55u32 => "item or member is private",
        56u32 => "cyclic import detected", 57u32 => "expression type differs from the expected type",
        58u32 => "the type cannot be inferred; add an annotation", 59u32 => "callee is not a function",
        60u32 => "wrong number of arguments", 61u32 => "body can reach its end without producing the declared non-unit value",
        62u32 => "operator not defined for these operand types", 63u32 => "integer literal does not fit its type",
        64u32 => "unary minus applied to an unsigned type", 65u32 => "as cast between types SPEC-03 does not allow",
        66u32 => "a function declared to return never can return normally", 67u32 => "the root file has no fn main (build/run)",
        68u32 => "main signature not allowed by SPEC-03", 69u32 => "valid Axiom outside the axiom0 subset (AXD-013)",
        70u32 => "cannot assign twice to immutable variable", 71u32 => "use of possibly-uninitialized variable",
        72u32 => "unreachable statement", 73u32 => "struct has no such field",
        74u32 => "missing field in struct literal", 75u32 => "duplicate field in struct literal",
        76u32 => "array size must be a non-negative constant integer", 77u32 => "cannot index into a value of this type",
        78u32 => "the `?` operator can only be applied to values that implement Try (Option or Result)", 79u32 => "cannot use `?` operator on Option in a function that returns Result (or vice versa)",
        80u32 => "stored view might outlive the owner of the referenced data", 81u32 => "self-referencing stored views within the same struct are forbidden",
        82u32 => "overlapping implementations for trait", 83u32 => "method call is ambiguous",
        84u32 => "the trait bound is not satisfied", 85u32 => "unknown trait in derive",
        86u32 => "non-exhaustive patterns: match must cover all cases", 87u32 => "refutable pattern in local binding",
        88u32 => "unreachable pattern", 89u32 => "use of moved value",
        90u32 => "use of possibly uninitialized value", 91u32 => "cannot create a mutable view because it conflicts with an existing view",
        92u32 => "cannot create a read view because the place is mutably viewed", 93u32 => "active view outlives its originating owner place",
        94u32 => "operation requires an unsafe block or function", 95u32 => "undefined behaviour detected by interpreter oracle",
        96u32 => "arithmetic overflow during constant evaluation", 97u32 => "division by zero during constant evaluation",
        98u32 => "cyclic dependency in constant evaluation", 99u32 => "evaluation limit exceeded during constant evaluation",
        100u32 => "MIR text cannot be parsed (C-only test input, T018)", 101u32 => "a local or block id is not declared in the body",
        102u32 => "a basic block has no terminator", 103u32 => "a terminator targets a block that does not exist",
        104u32 => "operand or rvalue type differs from the place type", 105u32 => "local read before it is definitely assigned",
        106u32 => "call arguments or destination do not match the callee signature", 107u32 => "the return place type differs from the function's return type",
        108u32 => "use of a local after it was moved", 109u32 => "a value requiring a drop goes out of scope without being dropped",
        110u32 => "a value is dropped more than once", 111u32 => "direct extern call cannot run in interpreter oracle",
        112u32 => "a referenced symbol is defined in no input object or import", 113u32 => "a global symbol is defined twice",
        114u32 => "a relocation value does not fit its field", 115u32 => "input object file is malformed or of an unsupported kind",
        116u32 => "image exceeds the PE32+ size limit", 117u32 => "input file does not exist",
        118u32 => "input file exists but cannot be read", 119u32 => "output cannot be written",
        120u32 => "source file exceeds the source-database limit (T008)", 121u32 => "malformed command line (exit 2)",
        122u32 => "unknown option (exit 2)", 123u32 => "command needs an input file (exit 2)",
