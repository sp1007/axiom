        126u32 => "the MIR interpreter exceeded its step limit (SPEC-03 default, --step-limit N)", 127u32 => "the MIR interpreter exceeded its call-depth limit (SPEC-03)",
        128u32 => "no std root found (ADR-0006 Â§8)", 129u32 => "malformed or invalid package manifest axiom.toml",
        130u32 => "an internal invariant failed; data.stage, data.detail", 131u32 => "compiler-built MIR was rejected by the verifier (AXD-042)",
        132u32 => "the compiler could not allocate memory",
        _ => "",
    }
}

pub fn diag_code_severity(c: DiagCode) -> DiagSeverity {
    if c.v == AX_NAME_SHADOW_MODULE || c.v == AX_PAT_UNREACHABLE || c.v == AX_TYPE_UNREACHABLE {
        DiagSeverity.Warning
    } else {
        DiagSeverity.Error
    }
}




pub struct DiagLabel {
    pub span: Span,
    pub message: StrView,
}

pub struct DiagEdit {
    pub span: Span,
    pub replacement: StrView,
}

pub struct DiagFix {
    pub message: StrView,
    pub applicability: FixApplicability,
    pub edits: *mut DiagEdit,
    pub edit_count: usize,
}

pub struct DiagDataValue {
    pub kind: DiagDataKind,
    pub str_val: StrView,
    pub int_val: i64,
    pub bool_val: bool,
    pub list_items: *mut StrView,
    pub list_count: usize,
}

pub struct DiagDataEntry {
    pub key: StrView,
    pub value: DiagDataValue,
}

pub struct Diagnostic {
    pub code: DiagCode,
    pub severity: DiagSeverity,
    pub message: StrView,
    pub primary: Span,

    pub labels: *mut DiagLabel,
    pub label_count: usize,

    pub notes: *mut StrView,
    pub note_count: usize,

    pub helps: *mut StrView,
    pub help_count: usize,

    pub fixes: *mut DiagFix,
    pub fix_count: usize,

    pub data: *mut DiagDataEntry,
    pub data_count: usize,
}

pub struct DiagSink {
    pub arena: Arena,
    pub diags: *mut Diagnostic,
    pub len: usize,
    pub cap: usize,
    pub errors: usize,
    pub warnings: usize,
}

pub fn diag_new(c: DiagCode, primary: Span, msg: StrView) -> Diagnostic {
    Diagnostic {
        code: c,
        severity: diag_code_severity(c),
        message: msg,
        primary: primary,
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    }
}

pub fn diag_sink_new() -> DiagSink {
    DiagSink {
        arena: arena_new(),
        diags: 0 as *mut Diagnostic,
        len: 0,
        cap: 0,
        errors: 0,
        warnings: 0,
    }
}

pub fn diag_sink_init(sink: mut_view<DiagSink>) {
    sink.arena = arena_new();
    sink.diags = 0 as *mut Diagnostic;
    sink.len = 0;
    sink.cap = 0;
    sink.errors = 0;
    sink.warnings = 0;
}

pub fn diag_sink_free(sink: mut_view<DiagSink>) {
    if sink.cap > 0 && sink.diags as usize != 0 {
        unsafe {
            heap_free(sink.diags as *mut u8, (((sink.cap as isize) * (size_of<Diagnostic>() as isize)) as usize), align_of<Diagnostic>());
        }
    }
    sink.diags = 0 as *mut Diagnostic;
    sink.len = 0;
    sink.cap = 0;
    sink.errors = 0;
    sink.warnings = 0;
    arena_destroy(mut_view(sink.arena));
}

fn copy_str_view(arena: mut_view<Arena>, sv: StrView) -> StrView {
    if sv.len == 0 || sv.ptr as usize == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let dst = arena_alloc_raw(arena, sv.len + 1, 1);
    unsafe {
        ptr_copy_nonoverlapping<u8>(sv.ptr, dst, sv.len);
        *(dst + sv.len) = 0u8;
    }
    StrView { ptr: dst as *const u8, len: sv.len }
}

unsafe fn diag_ptr(diags: *mut Diagnostic, idx: usize) -> *mut Diagnostic {
    ((diags as usize) + (((idx as isize) * (size_of<Diagnostic>() as isize)) as usize)) as *mut Diagnostic
}

pub fn diag_sink_report(sink: mut_view<DiagSink>, diag: view<Diagnostic>) {
    if sink.len == sink.cap {
        let new_cap = if sink.cap == 0 { 8 } else { sink.cap + sink.cap };
        let new_diags = unsafe { heap_alloc((((new_cap as isize) * (size_of<Diagnostic>() as isize)) as usize), align_of<Diagnostic>()) as *mut Diagnostic };
        if sink.len > 0 && sink.diags as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(sink.diags as *const u8, new_diags as *mut u8, (((sink.len as isize) * (size_of<Diagnostic>() as isize)) as usize));
                heap_free(sink.diags as *mut u8, (((sink.cap as isize) * (size_of<Diagnostic>() as isize)) as usize), align_of<Diagnostic>());
            }
        }
        sink.diags = new_diags;
        sink.cap = new_cap;
    }

    let mut d = Diagnostic {
        code: diag.code,
        severity: diag.severity,
        message: copy_str_view(mut_view(sink.arena), copy_sv(view(diag.message))),
        primary: diag.primary,
        labels: 0 as *mut DiagLabel,
        label_count: diag.label_count,
        notes: 0 as *mut StrView,
        note_count: diag.note_count,
        helps: 0 as *mut StrView,
        help_count: diag.help_count,
        fixes: 0 as *mut DiagFix,
        fix_count: diag.fix_count,
        data: 0 as *mut DiagDataEntry,
        data_count: diag.data_count,
    };

    // Deep copy labels
    if diag.label_count > 0 && diag.labels as usize != 0 {
        let labels_mem = arena_alloc_raw(mut_view(sink.arena), (((diag.label_count as isize) * (size_of<DiagLabel>() as isize)) as usize), align_of<DiagLabel>()) as *mut DiagLabel;
        let mut i: usize = 0;
        while i < diag.label_count {
            let src_l = unsafe { *((diag.labels as usize + (((i as isize) * (size_of<DiagLabel>() as isize)) as usize)) as *const DiagLabel) };
            let dst_l_ptr = ((labels_mem as usize) + (((i as isize) * (size_of<DiagLabel>() as isize)) as usize)) as *mut DiagLabel;
            unsafe {
                *dst_l_ptr = DiagLabel {
                    span: src_l.span,
                    message: copy_str_view(mut_view(sink.arena), copy_sv(view(src_l.message))),
                };
            }
            i = i + 1;
        }
        d.labels = labels_mem;
    }

    // Deep copy notes
    if diag.note_count > 0 && diag.notes as usize != 0 {
        let notes_mem = arena_alloc_raw(mut_view(sink.arena), (((diag.note_count as isize) * (size_of<StrView>() as isize)) as usize), align_of<StrView>()) as *mut StrView;
        let mut i: usize = 0;
        while i < diag.note_count {
            let src_n = unsafe { *((diag.notes as usize + (((i as isize) * (size_of<StrView>() as isize)) as usize)) as *const StrView) };
            let dst_n_ptr = ((notes_mem as usize) + (((i as isize) * (size_of<StrView>() as isize)) as usize)) as *mut StrView;
            unsafe {
                *dst_n_ptr = copy_str_view(mut_view(sink.arena), copy_sv(view(src_n)));
            }
            i = i + 1;
        }
        d.notes = notes_mem;
    }

    // Deep copy helps
    if diag.help_count > 0 && diag.helps as usize != 0 {
        let helps_mem = arena_alloc_raw(mut_view(sink.arena), (((diag.help_count as isize) * (size_of<StrView>() as isize)) as usize), align_of<StrView>()) as *mut StrView;
        let mut i: usize = 0;
        while i < diag.help_count {
            let src_h = unsafe { *((diag.helps as usize + (((i as isize) * (size_of<StrView>() as isize)) as usize)) as *const StrView) };
            let dst_h_ptr = ((helps_mem as usize) + (((i as isize) * (size_of<StrView>() as isize)) as usize)) as *mut StrView;
            unsafe {
                *dst_h_ptr = copy_str_view(mut_view(sink.arena), copy_sv(view(src_h)));
            }
            i = i + 1;
        }
        d.helps = helps_mem;
    }

    // Deep copy fixes
    if diag.fix_count > 0 && diag.fixes as usize != 0 {
        let fixes_mem = arena_alloc_raw(mut_view(sink.arena), (((diag.fix_count as isize) * (size_of<DiagFix>() as isize)) as usize), align_of<DiagFix>()) as *mut DiagFix;
        let mut i: usize = 0;
        while i < diag.fix_count {
            let src_f = unsafe { *((diag.fixes as usize + (((i as isize) * (size_of<DiagFix>() as isize)) as usize)) as *const DiagFix) };
            let dst_f_ptr = ((fixes_mem as usize) + (((i as isize) * (size_of<DiagFix>() as isize)) as usize)) as *mut DiagFix;
            let mut edits_mem = 0 as *mut DiagEdit;
            if src_f.edit_count > 0 && src_f.edits as usize != 0 {
                edits_mem = arena_alloc_raw(mut_view(sink.arena), (((src_f.edit_count as isize) * (size_of<DiagEdit>() as isize)) as usize), align_of<DiagEdit>()) as *mut DiagEdit;
                let mut j: usize = 0;
                while j < src_f.edit_count {
                    let src_e = unsafe { *((src_f.edits as usize + (((j as isize) * (size_of<DiagEdit>() as isize)) as usize)) as *const DiagEdit) };
                    let dst_e_ptr = ((edits_mem as usize) + (((j as isize) * (size_of<DiagEdit>() as isize)) as usize)) as *mut DiagEdit;
                    unsafe {
                        *dst_e_ptr = DiagEdit {
                            span: src_e.span,
                            replacement: copy_str_view(mut_view(sink.arena), copy_sv(view(src_e.replacement))),
                        };
                    }
                    j = j + 1;
                }
            }
            unsafe {
                *dst_f_ptr = DiagFix {
                    message: copy_str_view(mut_view(sink.arena), copy_sv(view(src_f.message))),
                    applicability: src_f.applicability,
                    edits: edits_mem,
                    edit_count: src_f.edit_count,
                };
            }
            i = i + 1;
        }
        d.fixes = fixes_mem;
    }

    // Deep copy data
    if diag.data_count > 0 && diag.data as usize != 0 {
        let data_mem = arena_alloc_raw(mut_view(sink.arena), (((diag.data_count as isize) * (size_of<DiagDataEntry>() as isize)) as usize), align_of<DiagDataEntry>()) as *mut DiagDataEntry;
        let mut i: usize = 0;
        while i < diag.data_count {
            let src_entry = unsafe { *((diag.data as usize + (((i as isize) * (size_of<DiagDataEntry>() as isize)) as usize)) as *const DiagDataEntry) };
            let dst_entry_ptr = ((data_mem as usize) + (((i as isize) * (size_of<DiagDataEntry>() as isize)) as usize)) as *mut DiagDataEntry;
            let mut val = DiagDataValue {
                kind: src_entry.value.kind,
                str_val: StrView { ptr: 0 as *const u8, len: 0 },
                int_val: src_entry.value.int_val,
                bool_val: src_entry.value.bool_val,
                list_items: 0 as *mut StrView,
                list_count: src_entry.value.list_count,
            };
            match src_entry.value.kind {
                DiagDataKind.String => {
                    val.str_val = copy_str_view(mut_view(sink.arena), copy_sv(view(src_entry.value.str_val)));
                },
                DiagDataKind.StringList => {
                    if src_entry.value.list_count > 0 && src_entry.value.list_items as usize != 0 {
                        let items_mem = arena_alloc_raw(mut_view(sink.arena), (((src_entry.value.list_count as isize) * (size_of<StrView>() as isize)) as usize), align_of<StrView>()) as *mut StrView;
                        let mut k: usize = 0;
                        while k < src_entry.value.list_count {
                            let item = unsafe { *((src_entry.value.list_items as usize + (((k as isize) * (size_of<StrView>() as isize)) as usize)) as *const StrView) };
                            let dst_item_ptr = ((items_mem as usize) + (((k as isize) * (size_of<StrView>() as isize)) as usize)) as *mut StrView;
                            unsafe {
                                *dst_item_ptr = copy_str_view(mut_view(sink.arena), copy_sv(view(item)));
                            }
                            k = k + 1;
                        }
                        val.list_items = items_mem;
                    }
                },
                _ => {},
            }
            unsafe {
                *dst_entry_ptr = DiagDataEntry {
                    key: copy_str_view(mut_view(sink.arena), copy_sv(view(src_entry.key))),
                    value: val,
                };
            }
            i = i + 1;
        }
        d.data = data_mem;
    }

    let sev = d.severity;
    unsafe {
        *(diag_ptr(sink.diags, sink.len)) = d;
    }
    sink.len = sink.len + 1;

    match sev {
        DiagSeverity.Error => { sink.errors = sink.errors + 1; },
        DiagSeverity.Warning => { sink.warnings = sink.warnings + 1; },
        _ => {},
    }
}

fn diag_less(da: view<Diagnostic>, db: view<Diagnostic>) -> bool {
    let da_none = da.primary.file.v == 0u32;
    let db_none = db.primary.file.v == 0u32;
    if da_none != db_none {
        return da_none;
    }
    if !da_none {
        let fa: u32 = da.primary.file.v;
        let fb: u32 = db.primary.file.v;
        if fa < fb { return true; }
        if fa > fb { return false; }

        let sa: u32 = da.primary.start;
        let sb: u32 = db.primary.start;
        if sa < sb { return true; }
        if sa > sb { return false; }
    }
    let ca = da.code.v;
    let cb = db.code.v;
    if ca < cb { return true; }
    false
}

pub fn diag_sink_sort(sink: mut_view<DiagSink>) {
    if sink.len <= 1 {
        return;
    }
    // Stable insertion sort
    let mut i: usize = 1;
    while i < sink.len {
        let current = unsafe { *(diag_ptr(sink.diags, i)) };
        let mut j: usize = i;
        while j > 0 {
            let prev = unsafe { *(diag_ptr(sink.diags, j - 1)) };
            if diag_less(view(current), view(prev)) {
                unsafe {
                    *(diag_ptr(sink.diags, j)) = prev;
                }
                j = j - 1;
            } else {
                break;
            }
        }
        unsafe {
            *(diag_ptr(sink.diags, j)) = current;
        }
        i = i + 1;
    }
}

pub fn diag_sink_has_errors(sink: view<DiagSink>) -> bool {
    sink.errors > 0
}

pub fn diag_sink_error_count(sink: view<DiagSink>) -> usize {
    sink.errors
}

pub fn diag_sink_warning_count(sink: view<DiagSink>) -> usize {
    sink.warnings
}

pub fn diag_sink_count(sink: view<DiagSink>) -> usize {
    sink.len
}

pub fn diag_sink_get(sink: view<DiagSink>, idx: usize) -> Diagnostic {
    if idx >= sink.len {
        return diag_new(diag_code(0u32), span_none(), StrView { ptr: 0 as *const u8, len: 0 });
    }
    unsafe { *(diag_ptr(sink.diags, idx)) }
}





pub struct DiagBuffer {
    pub ptr: *mut u8,
    pub len: usize,
    pub cap: usize,
}

pub fn diag_buf_new() -> DiagBuffer {
    DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
}

pub fn diag_buf_init(b: mut_view<DiagBuffer>) {
    b.ptr = 0 as *mut u8;
    b.len = 0;
    b.cap = 0;
}

pub fn diag_buf_free(b: mut_view<DiagBuffer>) {
    if b.cap > 0 && b.ptr as usize != 0 {
        unsafe {
            heap_free(b.ptr, b.cap, 1);
        }
    }
    b.ptr = 0 as *mut u8;
    b.len = 0;
    b.cap = 0;
}

pub fn diag_buf_push_byte(b: mut_view<DiagBuffer>, byte: u8) {
    if b.len == b.cap {
        let new_cap = if b.cap == 0 { 128 } else { b.cap + b.cap };
        let new_ptr = unsafe { heap_alloc(new_cap, 1) };
        if b.len > 0 && b.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(b.ptr as *const u8, new_ptr, b.len);
                heap_free(b.ptr, b.cap, 1);
            }
        }
        b.ptr = new_ptr;
        b.cap = new_cap;
    }
    unsafe {
        *(b.ptr + b.len) = byte;
    }
    b.len = b.len + 1;
}

pub fn diag_buf_push_bytes(b: mut_view<DiagBuffer>, p: *const u8, count: usize) {
    if count == 0 || p as usize == 0 {
        return;
    }
    let mut i: usize = 0;
    while i < count {
        diag_buf_push_byte(mut_view(*b), unsafe { *(p + i) });
        i = i + 1;
    }
}

pub fn diag_buf_push_sv(b: mut_view<DiagBuffer>, sv: StrView) {
    diag_buf_push_bytes(b, sv.ptr, sv.len);
}

pub fn diag_buf_push_u32(b: mut_view<DiagBuffer>, mut n: u32) {
    if n == 0u32 {
        diag_buf_push_byte(b, 48u8);
        return;
    }
    let mut digits: [10]u8 = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    let mut count: usize = 0;
    while n > 0u32 {
        digits[count] = ((n % 10u32) as u8) + 48u8;
        n = n / 10u32;
        count = count + 1;
    }
    while count > 0 {
        count = count - 1;
        diag_buf_push_byte(mut_view(*b), digits[count]);
    }
}

pub fn diag_buf_as_str_view(b: view<DiagBuffer>) -> StrView {
    StrView { ptr: b.ptr as *const u8, len: b.len }
}


pub fn diag_buf_push_fmt_str(b: mut_view<DiagBuffer>, start: usize, byte_count: usize) {
    let mut i: usize = 0;
    while i < byte_count {
        diag_buf_push_byte(mut_view(*b), FMT_STRS[start + i]);
        i = i + 1;
    }
}



pub fn diag_buf_push_code_name(b: mut_view<DiagBuffer>, c: DiagCode) {
    if c.v >= 133u32 {
        diag_buf_push_fmt_str(b, 0, 9);
        return;
    }
    let start = CODE_NAMES_OFF[c.v as usize] as usize;
    let end = CODE_NAMES_OFF[(c.v + 1u32) as usize] as usize;
    let mut i = start;
    while i < end {
        diag_buf_push_byte(mut_view(*b), CODE_NAMES_DATA[i]);
        i = i + 1;
    }
}

fn get_gutter_width(mut line: u32) -> u32 {
    if line == 0u32 {
        return 1u32;
    }
    let mut w: u32 = 0u32;
    while line > 0u32 {
        w = w + 1u32;
        line = line / 10u32;
    }
    w
}

fn print_gutter_space(b: mut_view<DiagBuffer>, width: u32) {
    let mut i: u32 = 0u32;
    while i < width {
        diag_buf_push_byte(mut_view(*b), 32u8);
        i = i + 1u32;
    }
    diag_buf_push_fmt_str(b, 9, 3);
}

fn print_severity_prefix(b: mut_view<DiagBuffer>, sev: DiagSeverity, c: DiagCode) {
    match sev {
        DiagSeverity.Error => {
            diag_buf_push_fmt_str(mut_view(*b), 12, 6);
        },
        DiagSeverity.Warning => {
            diag_buf_push_fmt_str(mut_view(*b), 18, 8);
        },
        DiagSeverity.Info => {
            diag_buf_push_fmt_str(mut_view(*b), 26, 5);
        },
        DiagSeverity.Hint => {
            diag_buf_push_fmt_str(mut_view(*b), 31, 5);
        },
    }
    diag_buf_push_code_name(mut_view(*b), c);
    diag_buf_push_fmt_str(b, 36, 3);
}

fn render_line(b: mut_view<DiagBuffer>, line_text: StrView) {
    let mut i: usize = 0;
    while i < line_text.len {
        let c = unsafe { *(line_text.ptr + i) };
        if c == 9u8 {
            diag_buf_push_fmt_str(mut_view(*b), 39, 4);
        } else if c != 13u8 && c != 10u8 {
            diag_buf_push_byte(mut_view(*b), c);
        }
        i = i + 1;
    }
    diag_buf_push_byte(b, 10u8);
}

fn render_carets(b: mut_view<DiagBuffer>, line_text: StrView, start_col: u32, end_col: u32, caret_byte: u8, msg: StrView) {
    let mut display_start: usize = 0;
    let mut char_idx: usize = 1;
    let mut i: usize = 0;

    while i < line_text.len && char_idx < (start_col as usize) {
        let c = unsafe { *(line_text.ptr + i) };
        let mut w: usize = 1;
        let mut bytes: usize = 1;
        if c == 9u8 {
            w = 4;
        } else if (c & 0xE0u8) == 0xC0u8 {
            bytes = 2;
        } else if (c & 0xF0u8) == 0xE0u8 {
            bytes = 3;
        } else if (c & 0xF8u8) == 0xF0u8 {
            bytes = 4;
        }
        display_start = display_start + w;
        char_idx = char_idx + 1;
        i = i + bytes;
    }

    let mut display_end: usize = display_start;
    if start_col == end_col {
        display_end = display_end + 1;
    } else {
        while i < line_text.len && char_idx < (end_col as usize) {
            let c = unsafe { *(line_text.ptr + i) };
            let mut w: usize = 1;
            let mut bytes: usize = 1;
            if c == 9u8 {
                w = 4;
            } else if (c & 0xE0u8) == 0xC0u8 {
                bytes = 2;
            } else if (c & 0xF0u8) == 0xE0u8 {
                bytes = 3;
            } else if (c & 0xF8u8) == 0xF0u8 {
                bytes = 4;
            }
            display_end = display_end + w;
            char_idx = char_idx + 1;
            i = i + bytes;
        }
    }

    let mut j: usize = 0;
    while j < display_start {
        diag_buf_push_byte(mut_view(*b), 32u8);
        j = j + 1;
    }
    while j < display_end {
        diag_buf_push_byte(mut_view(*b), caret_byte);
        j = j + 1;
    }
    if msg.len > 0 {
        diag_buf_push_byte(mut_view(*b), 32u8);
        diag_buf_push_sv(mut_view(*b), msg);
    }
    diag_buf_push_byte(b, 10u8);
}

fn print_gutter_line_num(b: mut_view<DiagBuffer>, line: u32, width: u32) {
    let lw = get_gutter_width(line);
    let mut pad = width - lw;
    while pad > 0u32 {
        diag_buf_push_byte(mut_view(*b), 32u8);
        pad = pad - 1u32;
    }
    diag_buf_push_u32(mut_view(*b), line);
    diag_buf_push_fmt_str(b, 9, 3);
}

fn print_span_snippet(b: mut_view<DiagBuffer>, db: view<SourceDatabase>, span: Span, caret_byte: u8, msg: StrView, gutter_width: u32) {
    let s_start: u32 = span.start;
    let s_end: u32 = span.end;
    let lc_start = source_db_line_col(db, span_new(copy_fid(view(span.file)), s_start, s_start));
    let lc_end = source_db_line_col(db, span_new(copy_fid(view(span.file)), s_end, s_end));

    if lc_start.line == lc_end.line {
        let line_span = source_db_line_range(db, copy_fid(view(span.file)), lc_start.line);
        let line_text = source_db_span_text(db, line_span);
        print_gutter_line_num(mut_view(*b), lc_start.line, gutter_width);
        render_line(mut_view(*b), copy_sv(view(line_text)));
        print_gutter_space(mut_view(*b), gutter_width);
        render_carets(mut_view(*b), copy_sv(view(line_text)), lc_start.col_chars, lc_end.col_chars, caret_byte, copy_sv(view(msg)));
    } else {
        let start_line_span = source_db_line_range(db, copy_fid(view(span.file)), lc_start.line);
        let start_line_text = source_db_span_text(db, start_line_span);
        print_gutter_line_num(mut_view(*b), lc_start.line, gutter_width);
        render_line(mut_view(*b), copy_sv(view(start_line_text)));
        print_gutter_space(mut_view(*b), gutter_width);
        render_carets(mut_view(*b), copy_sv(view(start_line_text)), lc_start.col_chars, 999999u32, caret_byte, StrView { ptr: 0 as *const u8, len: 0 });

        if lc_end.line > lc_start.line + 1u32 {
            let mut sp = gutter_width + 2u32;
            while sp > 0u32 {
                diag_buf_push_byte(mut_view(*b), 32u8);
                sp = sp - 1u32;
            }
            diag_buf_push_fmt_str(mut_view(*b), 48, 4);
        }

        let end_line_span = source_db_line_range(db, copy_fid(view(span.file)), lc_end.line);
        let end_line_text = source_db_span_text(db, end_line_span);
        print_gutter_line_num(mut_view(*b), lc_end.line, gutter_width);
        render_line(mut_view(*b), copy_sv(view(end_line_text)));

        let mut first_non_blank: u32 = 1u32;
        let mut k: usize = 0;
        while k < end_line_text.len {
            let eb = unsafe { *(end_line_text.ptr + k) };
            if eb != 32u8 && eb != 9u8 && eb != 13u8 {
                break;
            }
            first_non_blank = first_non_blank + 1u32;
            k = k + 1;
        }

        print_gutter_space(mut_view(*b), gutter_width);
        render_carets(mut_view(*b), copy_sv(view(end_line_text)), first_non_blank, lc_end.col_chars, caret_byte, copy_sv(view(msg)));
    }
}

pub fn ax_diag_render_human(sink: view<DiagSink>, db: view<SourceDatabase>, out: mut_view<DiagBuffer>) {
    let mut i: usize = 0;
    while i < sink.len {
        if i > 0 {
            diag_buf_push_byte(mut_view(*out), 10u8);
        }
        let d = unsafe { *((sink.diags as usize + (((i as isize) * (size_of<Diagnostic>() as isize)) as usize)) as *const Diagnostic) };

        let d_prim = copy_span(view(d.primary));
        let d_msg = copy_sv(view(d.message));

        print_severity_prefix(mut_view(*out), d.severity, d.code);
        diag_buf_push_sv(mut_view(*out), d_msg);
        diag_buf_push_byte(mut_view(*out), 10u8);

        if !span_is_none(view(d_prim)) {
            let p_start: u32 = d_prim.start;
            let lc = source_db_line_col(db, span_new(copy_fid(view(d_prim.file)), p_start, p_start));
            let path = source_db_path(db, copy_fid(view(d_prim.file)));

            diag_buf_push_fmt_str(mut_view(*out), 43, 5);

            let mut pi: usize = 0;
            while pi < path.len {
                let pb = unsafe { *(path.ptr + pi) };
                if pb == 92u8 {
                    diag_buf_push_byte(mut_view(*out), 47u8);
                } else {
                    diag_buf_push_byte(mut_view(*out), pb);
                }
                pi = pi + 1;
            }

            diag_buf_push_byte(mut_view(*out), 58u8);
            diag_buf_push_u32(mut_view(*out), lc.line);
            diag_buf_push_byte(mut_view(*out), 58u8);
            diag_buf_push_u32(mut_view(*out), lc.col_chars);
            diag_buf_push_byte(mut_view(*out), 10u8);

            let mut gutter_width = get_gutter_width(lc.line);
            let mut l: usize = 0;
            while l < d.label_count {
                let lbl = unsafe { *((d.labels as usize + (((l as isize) * (size_of<DiagLabel>() as isize)) as usize)) as *const DiagLabel) };
                let l_span = copy_span(view(lbl.span));
                if !span_is_none(view(l_span)) && l_span.file.v == d_prim.file.v {
                    let l_start: u32 = l_span.start;
                    let llc = source_db_line_col(db, span_new(copy_fid(view(l_span.file)), l_start, l_start));
                    let lw = get_gutter_width(llc.line);
                    if lw > gutter_width {
                        gutter_width = lw;
                    }
                }
                l = l + 1;
            }

            print_gutter_space(mut_view(*out), gutter_width);
            diag_buf_push_byte(mut_view(*out), 10u8);

            print_span_snippet(mut_view(*out), db, copy_span(view(d_prim)), 94u8, StrView { ptr: 0 as *const u8, len: 0 }, gutter_width);

            let mut l2: usize = 0;
            while l2 < d.label_count {
                let lbl = unsafe { *((d.labels as usize + (((l2 as isize) * (size_of<DiagLabel>() as isize)) as usize)) as *const DiagLabel) };
                let l_span = copy_span(view(lbl.span));
                let l_msg = copy_sv(view(lbl.message));
                if !span_is_none(view(l_span)) && l_span.file.v == d_prim.file.v {
                    print_span_snippet(mut_view(*out), db, copy_span(view(l_span)), 45u8, l_msg, gutter_width);
                }
                l2 = l2 + 1;
            }

            print_gutter_space(mut_view(*out), gutter_width);
            diag_buf_push_byte(mut_view(*out), 10u8);
        }

        // Notes
        let mut ni: usize = 0;
        while ni < d.note_count {
            let note = unsafe { *((d.notes as usize + (((ni as isize) * (size_of<StrView>() as isize)) as usize)) as *const StrView) };
            diag_buf_push_fmt_str(mut_view(*out), 52, 10);
            diag_buf_push_sv(mut_view(*out), note);
            diag_buf_push_byte(mut_view(*out), 10u8);
            ni = ni + 1;
        }

        // Helps
        let mut hi: usize = 0;
        while hi < d.help_count {
            let help = unsafe { *((d.helps as usize + (((hi as isize) * (size_of<StrView>() as isize)) as usize)) as *const StrView) };
            diag_buf_push_fmt_str(mut_view(*out), 62, 10);
            diag_buf_push_sv(mut_view(*out), help);
            diag_buf_push_byte(mut_view(*out), 10u8);
            hi = hi + 1;
        }

        // Fixes
        let mut fi: usize = 0;
        while fi < d.fix_count {
            let fix = unsafe { *((d.fixes as usize + (((fi as isize) * (size_of<DiagFix>() as isize)) as usize)) as *const DiagFix) };
            diag_buf_push_fmt_str(mut_view(*out), 72, 9);
            diag_buf_push_sv(mut_view(*out), fix.message);
            diag_buf_push_byte(mut_view(*out), 10u8);
            fi = fi + 1;
        }

        i = i + 1;
    }

    if sink.len > 0 {
        diag_buf_push_byte(mut_view(*out), 10u8);
        diag_buf_push_u32(mut_view(*out), sink.errors as u32);
        diag_buf_push_fmt_str(mut_view(*out), 81, 6);
        if sink.errors != 1 {
            diag_buf_push_byte(mut_view(*out), 115u8);
        }
        diag_buf_push_fmt_str(mut_view(*out), 87, 2);
        diag_buf_push_u32(mut_view(*out), sink.warnings as u32);
        diag_buf_push_fmt_str(mut_view(*out), 89, 8);
        if sink.warnings != 1 {
            diag_buf_push_byte(mut_view(*out), 115u8);
        }
        diag_buf_push_byte(out, 10u8);
    }
}




fn hex_digit(v: u8) -> u8 {
    if v < 10u8 {
        v + 48u8
    } else {
        v - 10u8 + 97u8
    }
}


fn diag_buf_push_json_str(b: mut_view<DiagBuffer>, start: usize, byte_count: usize) {
    let mut i: usize = 0;
    while i < byte_count {
        diag_buf_push_byte(mut_view(*b), JSON_STRS[start + i]);
        i = i + 1;
    }
}

pub fn write_json_string(b: mut_view<DiagBuffer>, sv: StrView) {
    diag_buf_push_byte(mut_view(*b), 34u8);
    let mut i: usize = 0;
    while i < sv.len {
        let c = unsafe { *(sv.ptr + i) };
        if c == 34u8 {
            diag_buf_push_json_str(mut_view(*b), 0, 2);
        } else if c == 92u8 {
            diag_buf_push_json_str(mut_view(*b), 2, 2);
        } else if c == 8u8 {
            diag_buf_push_json_str(mut_view(*b), 4, 2);
        } else if c == 12u8 {
            diag_buf_push_json_str(mut_view(*b), 6, 2);
        } else if c == 10u8 {
            diag_buf_push_json_str(mut_view(*b), 8, 2);
        } else if c == 13u8 {
            diag_buf_push_json_str(mut_view(*b), 10, 2);
        } else if c == 9u8 {
            diag_buf_push_json_str(mut_view(*b), 12, 2);
        } else if c < 32u8 {
            diag_buf_push_byte(mut_view(*b), 92u8);
            diag_buf_push_byte(mut_view(*b), 117u8);
            diag_buf_push_byte(mut_view(*b), 48u8);
            diag_buf_push_byte(mut_view(*b), 48u8);
            diag_buf_push_byte(mut_view(*b), hex_digit(c / 16u8));
            diag_buf_push_byte(mut_view(*b), hex_digit(c % 16u8));
        } else {
            diag_buf_push_byte(mut_view(*b), c);
        }
        i = i + 1;
    }
    diag_buf_push_byte(b, 34u8);
}

fn write_severity(b: mut_view<DiagBuffer>, sev: DiagSeverity) {
    match sev {
        DiagSeverity.Error => {
            diag_buf_push_json_str(b, 14, 7);
        },
        DiagSeverity.Warning => {
            diag_buf_push_json_str(b, 21, 9);
        },
        DiagSeverity.Info => {
            diag_buf_push_json_str(b, 30, 6);
        },
        DiagSeverity.Hint => {
            diag_buf_push_json_str(b, 36, 6);
        },
    }
}

fn write_span(b: mut_view<DiagBuffer>, db: view<SourceDatabase>, span: Span) {
    if span_is_none(view(span)) {
        diag_buf_push_json_str(b, 42, 4);
        return;
    }

    let s_start: u32 = span.start;
    let s_end: u32 = span.end;
    let path = source_db_path(db, copy_fid(view(span.file)));
    let lc_start = source_db_line_col(db, span_new(copy_fid(view(span.file)), s_start, s_start));
    let lc_end = source_db_line_col(db, span_new(copy_fid(view(span.file)), s_end, s_end));

    diag_buf_push_json_str(mut_view(*b), 46, 8);

    diag_buf_push_byte(mut_view(*b), 34u8);
    let mut i: usize = 0;
    while i < path.len {
        let c = unsafe { *(path.ptr + i) };
        if c == 92u8 {
            diag_buf_push_byte(mut_view(*b), 47u8);
        } else if c == 34u8 {
            diag_buf_push_byte(mut_view(*b), 92u8);
            diag_buf_push_byte(mut_view(*b), 34u8);
        } else {
            diag_buf_push_byte(mut_view(*b), c);
        }
        i = i + 1;
    }
    diag_buf_push_byte(mut_view(*b), 34u8);

    diag_buf_push_json_str(mut_view(*b), 54, 9);
    diag_buf_push_u32(mut_view(*b), span.start);

    diag_buf_push_json_str(mut_view(*b), 63, 7);
    diag_buf_push_u32(mut_view(*b), span.end);

    diag_buf_push_json_str(mut_view(*b), 70, 8);
    diag_buf_push_u32(mut_view(*b), lc_start.line);

    diag_buf_push_json_str(mut_view(*b), 78, 7);
    diag_buf_push_u32(mut_view(*b), lc_start.col_chars);

    diag_buf_push_json_str(mut_view(*b), 85, 12);
    diag_buf_push_u32(mut_view(*b), lc_end.line);

    diag_buf_push_json_str(mut_view(*b), 97, 11);
    diag_buf_push_u32(mut_view(*b), lc_end.col_chars);

    diag_buf_push_byte(b, 125u8);
}

fn write_labels(b: mut_view<DiagBuffer>, db: view<SourceDatabase>, d: view<Diagnostic>) {
    diag_buf_push_byte(mut_view(*b), 91u8);
    let mut i: usize = 0;
    while i < d.label_count {
        if i > 0 {
            diag_buf_push_byte(mut_view(*b), 44u8);
        }
        let lbl = unsafe { *((d.labels as usize + (((i as isize) * (size_of<DiagLabel>() as isize)) as usize)) as *const DiagLabel) };
        diag_buf_push_json_str(mut_view(*b), 108, 8);
        write_span(mut_view(*b), db, lbl.span);

        diag_buf_push_json_str(mut_view(*b), 116, 11);
        write_json_string(mut_view(*b), lbl.message);

        diag_buf_push_byte(mut_view(*b), 125u8);
        i = i + 1;
    }
    diag_buf_push_byte(b, 93u8);
}

fn write_string_array(b: mut_view<DiagBuffer>, arr: *mut StrView, count: usize) {
    diag_buf_push_byte(mut_view(*b), 91u8);
    let mut i: usize = 0;
    while i < count {
        if i > 0 {
            diag_buf_push_byte(mut_view(*b), 44u8);
        }
        let sv = unsafe { *((arr as usize + (((i as isize) * (size_of<StrView>() as isize)) as usize)) as *const StrView) };
        write_json_string(mut_view(*b), sv);
        i = i + 1;
    }
    diag_buf_push_byte(b, 93u8);
}

fn write_fixes(b: mut_view<DiagBuffer>, db: view<SourceDatabase>, d: view<Diagnostic>) {
    diag_buf_push_byte(mut_view(*b), 91u8);
    let mut i: usize = 0;
    while i < d.fix_count {
        if i > 0 {
            diag_buf_push_byte(mut_view(*b), 44u8);
        }
        let fix = unsafe { *((d.fixes as usize + (((i as isize) * (size_of<DiagFix>() as isize)) as usize)) as *const DiagFix) };

        diag_buf_push_json_str(mut_view(*b), 378, 11);
        write_json_string(mut_view(*b), fix.message);

        diag_buf_push_json_str(mut_view(*b), 127, 17);
        match fix.applicability {
            FixApplicability.MachineApplicable => {
                diag_buf_push_json_str(mut_view(*b), 144, 20);
            },
            FixApplicability.MaybeApplicable => {
                diag_buf_push_json_str(mut_view(*b), 164, 18);
            },
            FixApplicability.ManualReview => {
                diag_buf_push_json_str(mut_view(*b), 182, 15);
            },
        }

        diag_buf_push_json_str(mut_view(*b), 197, 10);
        let mut j: usize = 0;
        while j < fix.edit_count {
            if j > 0 {
                diag_buf_push_byte(mut_view(*b), 44u8);
            }
            let edit = unsafe { *((fix.edits as usize + (((j as isize) * (size_of<DiagEdit>() as isize)) as usize)) as *const DiagEdit) };
            diag_buf_push_json_str(mut_view(*b), 108, 8);
            write_span(mut_view(*b), db, edit.span);

            diag_buf_push_json_str(mut_view(*b), 207, 15);
            write_json_string(mut_view(*b), edit.replacement);

            diag_buf_push_byte(mut_view(*b), 125u8);
            j = j + 1;
        }
        diag_buf_push_byte(mut_view(*b), 93u8);
        diag_buf_push_byte(mut_view(*b), 125u8);
        i = i + 1;
    }
    diag_buf_push_byte(b, 93u8);
}

fn write_data(b: mut_view<DiagBuffer>, d: view<Diagnostic>) {
    diag_buf_push_byte(mut_view(*b), 123u8);
    let mut i: usize = 0;
    while i < d.data_count {
        if i > 0 {
            diag_buf_push_byte(mut_view(*b), 44u8);
        }
        let entry = unsafe { *((d.data as usize + (((i as isize) * (size_of<DiagDataEntry>() as isize)) as usize)) as *const DiagDataEntry) };
        write_json_string(mut_view(*b), entry.key);
        diag_buf_push_byte(mut_view(*b), 58u8);

        match entry.value.kind {
            DiagDataKind.String => {
                write_json_string(mut_view(*b), entry.value.str_val);
            },
            DiagDataKind.Integer => {
                let mut val = entry.value.int_val;
                if val < 0 {
                    diag_buf_push_byte(mut_view(*b), 45u8);
                    val = 0 - val;
                }
                diag_buf_push_u32(mut_view(*b), val as u32);
            },
            DiagDataKind.Boolean => {
                if entry.value.bool_val {
                    diag_buf_push_json_str(mut_view(*b), 222, 4);
                } else {
                    diag_buf_push_json_str(mut_view(*b), 226, 5);
                }
            },
            DiagDataKind.StringList => {
                write_string_array(mut_view(*b), entry.value.list_items, entry.value.list_count);
            },
        }
        i = i + 1;
    }
    diag_buf_push_byte(b, 125u8);
}

pub fn ax_diag_render_json(sink: view<DiagSink>, db: view<SourceDatabase>, out: mut_view<DiagBuffer>) {
    diag_buf_push_json_str(mut_view(*out), 231, 43);

    let mut i: usize = 0;
    while i < sink.len {
        if i > 0 {
            diag_buf_push_byte(mut_view(*out), 44u8);
        }
        let d = unsafe { *((sink.diags as usize + (((i as isize) * (size_of<Diagnostic>() as isize)) as usize)) as *const Diagnostic) };

        diag_buf_push_json_str(mut_view(*out), 274, 6);
        diag_buf_push_u32(mut_view(*out), i as u32);

        diag_buf_push_json_str(mut_view(*out), 280, 8);
        diag_buf_push_byte(mut_view(*out), 34u8);
        diag_buf_push_code_name(mut_view(*out), d.code);
        diag_buf_push_byte(mut_view(*out), 34u8);

        diag_buf_push_json_str(mut_view(*out), 288, 12);
        write_severity(mut_view(*out), d.severity);

        diag_buf_push_json_str(mut_view(*out), 116, 11);
        write_json_string(mut_view(*out), copy_sv(view(d.message)));

        diag_buf_push_json_str(mut_view(*out), 300, 11);
        write_span(mut_view(*out), db, copy_span(view(d.primary)));

        diag_buf_push_json_str(mut_view(*out), 311, 10);
        write_labels(mut_view(*out), db, view(d));

        diag_buf_push_json_str(mut_view(*out), 321, 9);
        write_string_array(mut_view(*out), d.notes, d.note_count);

        diag_buf_push_json_str(mut_view(*out), 330, 9);
        write_string_array(mut_view(*out), d.helps, d.help_count);

        diag_buf_push_json_str(mut_view(*out), 339, 9);
        write_fixes(mut_view(*out), db, view(d));

        diag_buf_push_json_str(mut_view(*out), 348, 8);
        write_data(mut_view(*out), view(d));

        diag_buf_push_byte(mut_view(*out), 125u8);
        i = i + 1;
    }
    diag_buf_push_byte(mut_view(*out), 93u8);

    diag_buf_push_json_str(mut_view(*out), 356, 10);
    diag_buf_push_u32(mut_view(*out), sink.errors as u32);

    diag_buf_push_json_str(mut_view(*out), 366, 12);
    diag_buf_push_u32(mut_view(*out), sink.warnings as u32);

    diag_buf_push_byte(mut_view(*out), 125u8);
    diag_buf_push_byte(out, 10u8);
}


pub struct CompilerSession {
    pub arena: Arena,
    pub interner: StrInterner,
    pub u32_pool: U32Interner,
    pub source_db: SourceDatabase,
    pub diag_sink: DiagSink,
}

pub fn session_init(s: mut_view<CompilerSession>) {
    s.arena = arena_new();
    interner_init(mut_view(s.interner));
    s.u32_pool = u32_interner_new();
    source_db_init(mut_view(s.source_db));
    diag_sink_init(mut_view(s.diag_sink));
}

pub fn session_new() -> CompilerSession {
    CompilerSession {
        arena: arena_new(),
        interner: interner_new(),
        u32_pool: u32_interner_new(),
        source_db: SourceDatabase {
            arena: arena_new(),
            files: 0 as *mut SourceFile,
            files_count: 0,
            files_cap: 0,
        },
        diag_sink: diag_sink_new(),
    }
}

pub fn session_free(s: mut_view<CompilerSession>) {
    diag_sink_free(mut_view(s.diag_sink));
    source_db_free(mut_view(s.source_db));
    u32_interner_free(mut_view(s.u32_pool));
    interner_free(mut_view(s.interner));
    arena_destroy(mut_view(s.arena));
}

pub fn session_add_virtual_file(s: mut_view<CompilerSession>, path: StrView, text: StrView) -> FileId {
    source_db_add_virtual(mut_view(s.source_db), path.ptr, path.len, text.ptr, text.len)
}

pub fn session_file_count(s: view<CompilerSession>) -> usize {
    source_db_file_count(view(s.source_db))
}

pub fn session_file_text(s: view<CompilerSession>, file: FileId) -> StrView {
    source_db_text(view(s.source_db), file)
}

pub fn session_file_path(s: view<CompilerSession>, file: FileId) -> StrView {
    source_db_path(view(s.source_db), file)
}

pub fn session_file_hash(s: view<CompilerSession>, file: FileId) -> u64 {
    source_db_hash(view(s.source_db), file)
}

pub fn session_file_has_invalid_utf8(s: view<CompilerSession>, file: FileId) -> bool {
    source_db_has_invalid_utf8(view(s.source_db), file)
}

pub fn session_span_text(s: view<CompilerSession>, span: Span) -> StrView {
    source_db_span_text(view(s.source_db), span)
}

pub fn session_line_col(s: view<CompilerSession>, span: Span) -> LineCol {
    source_db_line_col(view(s.source_db), span)
}

pub fn session_line_range(s: view<CompilerSession>, file: FileId, line: u32) -> Span {
    source_db_line_range(view(s.source_db), file, line)
}

pub fn session_intern_str(s: mut_view<CompilerSession>, sv: StrView) -> StrId {
    interner_intern_bytes(mut_view(s.interner), sv.ptr, sv.len)
}

pub fn session_intern_span(s: mut_view<CompilerSession>, span: Span) -> StrId {
    let sv = source_db_span_text(view(s.source_db), span);
    interner_intern_bytes(mut_view(s.interner), sv.ptr, sv.len)
}

pub fn session_lookup_str(s: view<CompilerSession>, sv: StrView) -> StrId {
    interner_lookup_bytes(view(s.interner), sv.ptr, sv.len)
}

pub fn session_get_str(s: view<CompilerSession>, id: StrId) -> StrView {
    interner_get(view(s.interner), id)
}

pub fn session_interner_len(s: view<CompilerSession>) -> usize {
    interner_len(view(s.interner))
}

pub fn session_report(s: mut_view<CompilerSession>, diag: view<Diagnostic>) {
    diag_sink_report(mut_view(s.diag_sink), diag);
}

pub fn session_report_code(s: mut_view<CompilerSession>, code: DiagCode, primary: Span, message: StrView) {
    let d = Diagnostic {
        code: code,
        severity: diag_code_severity(code),
        message: message,
        primary: primary,
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    diag_sink_report(mut_view(s.diag_sink), view(d));
}

pub fn session_sort_diags(s: mut_view<CompilerSession>) {
    diag_sink_sort(mut_view(s.diag_sink));
}

pub fn session_has_errors(s: view<CompilerSession>) -> bool {
    diag_sink_has_errors(view(s.diag_sink))
}

pub fn session_error_count(s: view<CompilerSession>) -> usize {
    diag_sink_error_count(view(s.diag_sink))
}

pub fn session_warning_count(s: view<CompilerSession>) -> usize {
    diag_sink_warning_count(view(s.diag_sink))
}

pub fn session_diag_count(s: view<CompilerSession>) -> usize {
    diag_sink_count(view(s.diag_sink))
}

pub fn session_render_human(s: mut_view<CompilerSession>, out: mut_view<DiagBuffer>) {
    diag_sink_sort(mut_view(s.diag_sink));
    ax_diag_render_human(view(s.diag_sink), view(s.source_db), out);
}

pub fn session_render_json(s: mut_view<CompilerSession>, out: mut_view<DiagBuffer>) {
    diag_sink_sort(mut_view(s.diag_sink));
    ax_diag_render_json(view(s.diag_sink), view(s.source_db), out);
}







pub struct Token {
    pub kind: u8,
    pub suffix: u8,
    pub flags: u16,
    pub char_val: u32,
    pub span: Span,
    pub int_val: u64,
    pub str_ptr: *const u8,
    pub str_len: usize,
    pub ident_val: StrId,
}

pub struct Comment {
    pub kind: u8,
    pub span: Span,
}

pub struct LexResult {
    pub arena: Arena,
    pub tokens: *mut Token,
    pub token_count: usize,
    pub token_cap: usize,
    pub comments: *mut Comment,
    pub comment_count: usize,
    pub comment_cap: usize,
}


pub fn diag_buf_push_tok_name(b: mut_view<DiagBuffer>, kind: u8) {
    let idx = kind as usize;
    if idx >= 97 {
        diag_buf_push_byte(b, 63u8);
        return;
    }
    let start = TOK_NAMES_OFF[idx] as usize;
    let end = TOK_NAMES_OFF[idx + 1] as usize;
    let mut i = start;
    while i < end {
        diag_buf_push_byte(mut_view(*b), TOK_NAMES_DATA[i]);
        i = i + 1;
    }
}

pub fn diag_buf_push_suf_name(b: mut_view<DiagBuffer>, suf: u8) {
    let idx = suf as usize;
    if idx >= 13 {
        diag_buf_push_byte(b, 63u8);
        return;
    }
    let start = SUF_NAMES_OFF[idx] as usize;
    let end = SUF_NAMES_OFF[idx + 1] as usize;
    let mut i = start;
    while i < end {
        diag_buf_push_byte(mut_view(*b), SUF_NAMES_DATA[i]);
        i = i + 1;
    }
}

pub fn diag_buf_push_lex_msg(b: mut_view<DiagBuffer>, msg_idx: usize) {
    let start = LEX_MSG_OFF[msg_idx] as usize;
    let end = LEX_MSG_OFF[msg_idx + 1] as usize;
    let mut i = start;
    while i < end {
        diag_buf_push_byte(mut_view(*b), LEX_MSG_DATA[i]);
        i = i + 1;
    }
}

pub fn diag_buf_push_u64(b: mut_view<DiagBuffer>, val: u64) {
    if val == 0u64 {
        diag_buf_push_byte(b, 48u8);
        return;
    }
    let mut digits: [20]u8 = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    let mut count: usize = 0;
    let mut v = val;
    while v > 0u64 {
        let q = (v >> 1u32) / 5u64;
        let rem = (v - q * 10u64) as u8;
        digits[count] = 48u8 + rem;
        v = q;
        count = count + 1;
    }
    let mut i = count;
    while i > 0 {
        i = i - 1;
        diag_buf_push_byte(mut_view(*b), digits[i]);
    }
}

fn hex_nibble(v: u8) -> u8 {
    if v < 10u8 { 48u8 + v } else { 97u8 + (v - 10u8) }
}

pub unsafe fn lex_token_ptr(tokens: *mut Token, idx: usize) -> *mut Token {
    ((tokens as usize) + (((idx as isize) * (size_of<Token>() as isize)) as usize)) as *mut Token
}

pub unsafe fn lex_comment_ptr(comments: *mut Comment, idx: usize) -> *mut Comment {
    ((comments as usize) + (((idx as isize) * (size_of<Comment>() as isize)) as usize)) as *mut Comment
}

pub fn ax_lex_render_tokens(res: view<LexResult>, interner: view<StrInterner>, out: mut_view<DiagBuffer>) {
    let mut i: usize = 0;
    while i < res.token_count {
        let tok = unsafe { *(lex_token_ptr(res.tokens, i)) };
        diag_buf_push_tok_name(mut_view(*out), tok.kind);
        diag_buf_push_byte(mut_view(*out), 32u8);
        diag_buf_push_byte(mut_view(*out), 91u8);
        diag_buf_push_u32(mut_view(*out), tok.span.start);
        diag_buf_push_byte(mut_view(*out), 46u8);
        diag_buf_push_byte(mut_view(*out), 46u8);
        diag_buf_push_u32(mut_view(*out), tok.span.end);
        diag_buf_push_byte(mut_view(*out), 93u8);
        if (tok.flags & TOK_FLAG_NL_BEFORE) != 0u16 { diag_buf_push_lex_msg(mut_view(*out), 27); }
        if (tok.flags & TOK_FLAG_ERROR) != 0u16 { diag_buf_push_lex_msg(mut_view(*out), 28); }
        if (tok.flags & TOK_FLAG_RAW) != 0u16 { diag_buf_push_lex_msg(mut_view(*out), 29); }
        if (tok.flags & TOK_FLAG_BYTE_FORM) != 0u16 { diag_buf_push_lex_msg(mut_view(*out), 30); }
        if tok.kind == TOK_INT {
            diag_buf_push_byte(mut_view(*out), 32u8);
            diag_buf_push_u64(mut_view(*out), tok.int_val);
            if tok.suffix != SUFFIX_NONE {
                diag_buf_push_byte(mut_view(*out), 32u8);
                diag_buf_push_suf_name(mut_view(*out), tok.suffix);
            }
        } else if tok.kind == TOK_FLOAT {
            diag_buf_push_byte(mut_view(*out), 32u8);
            diag_buf_push_suf_name(mut_view(*out), tok.suffix);
        } else if tok.kind == TOK_IDENT || tok.kind == TOK_LABEL {
            let name = interner_get(interner, tok.ident_val);
            diag_buf_push_byte(mut_view(*out), 32u8);
            let mut k: usize = 0;
            while k < name.len {
                let b_ch = unsafe { *(name.ptr + k) };
                diag_buf_push_byte(mut_view(*out), b_ch);
                k = k + 1;
            }
        } else if tok.kind == TOK_CHAR {
            diag_buf_push_byte(mut_view(*out), 32u8);
            diag_buf_push_u32(mut_view(*out), tok.char_val);
        } else if tok.kind == TOK_STR || tok.kind == TOK_BYTE_STR {
            diag_buf_push_byte(mut_view(*out), 32u8);
            let mut k: usize = 0;
            while k < tok.str_len {
                let b_ch = unsafe { *(tok.str_ptr + k) };
                diag_buf_push_byte(mut_view(*out), hex_nibble(b_ch / 16u8));
                diag_buf_push_byte(mut_view(*out), hex_nibble(b_ch % 16u8));
                k = k + 1;
            }
        }
        diag_buf_push_byte(mut_view(*out), 10u8);
        i = i + 1;
    }
    let mut j: usize = 0;
    while j < res.comment_count {
        let c = unsafe { *(lex_comment_ptr(res.comments, j)) };
        let msg_idx: usize = if c.kind == COMMENT_DOC { 25 } else if c.kind == COMMENT_BLOCK { 26 } else { 24 };
        diag_buf_push_lex_msg(mut_view(*out), msg_idx);
        diag_buf_push_byte(mut_view(*out), 32u8);
        diag_buf_push_byte(mut_view(*out), 91u8);
        diag_buf_push_u32(mut_view(*out), c.span.start);
        diag_buf_push_byte(mut_view(*out), 46u8);
        diag_buf_push_byte(mut_view(*out), 46u8);
        diag_buf_push_u32(mut_view(*out), c.span.end);
        diag_buf_push_byte(mut_view(*out), 93u8);
        diag_buf_push_byte(mut_view(*out), 10u8);
        j = j + 1;
    }
}




pub struct Utf8Dec {
    pub cp: u32,
    pub byte_len: usize,
    pub ok: bool,
}

pub fn ax_utf8_decode(bytes: *const u8, max_len: usize) -> Utf8Dec {
    if max_len == 0 {
        return Utf8Dec { cp: 0xFFFDu32, byte_len: 0, ok: false };
    }
    let b0 = unsafe { *bytes };
    if b0 < 0x80u8 {
        return Utf8Dec { cp: b0 as u32, byte_len: 1, ok: true };
    }
    if (b0 & 0xE0u8) == 0xC0u8 {
        if b0 < 0xC2u8 || max_len < 2 {
            return Utf8Dec { cp: 0xFFFDu32, byte_len: 1, ok: false };
        }
        let b1 = unsafe { *(bytes + 1) };
        if (b1 & 0xC0u8) != 0x80u8 {
            return Utf8Dec { cp: 0xFFFDu32, byte_len: 1, ok: false };
        }
        let cp = (((b0 & 0x1Fu8) as u32) << 6u32) | ((b1 & 0x3Fu8) as u32);
        return Utf8Dec { cp: cp, byte_len: 2, ok: true };
    }
    if (b0 & 0xF0u8) == 0xE0u8 {
        if max_len < 2 {
            return Utf8Dec { cp: 0xFFFDu32, byte_len: 1, ok: false };
        }
        let b1 = unsafe { *(bytes + 1) };
        if (b1 & 0xC0u8) != 0x80u8 {
            return Utf8Dec { cp: 0xFFFDu32, byte_len: 1, ok: false };
        }
        if (b0 == 0xE0u8 && b1 < 0xA0u8) || (b0 == 0xEDu8 && b1 >= 0xA0u8) {
            return Utf8Dec { cp: 0xFFFDu32, byte_len: 1, ok: false };
        }
        if max_len < 3 {
            return Utf8Dec { cp: 0xFFFDu32, byte_len: 2, ok: false };
        }
        let b2 = unsafe { *(bytes + 2) };
        if (b2 & 0xC0u8) != 0x80u8 {
            return Utf8Dec { cp: 0xFFFDu32, byte_len: 2, ok: false };
        }
        let cp = (((b0 & 0x0Fu8) as u32) << 12u32) | (((b1 & 0x3Fu8) as u32) << 6u32) | ((b2 & 0x3Fu8) as u32);
        return Utf8Dec { cp: cp, byte_len: 3, ok: true };
    }
    if (b0 & 0xF8u8) == 0xF0u8 {
        if b0 > 0xF4u8 || max_len < 2 {
            return Utf8Dec { cp: 0xFFFDu32, byte_len: 1, ok: false };
        }
        let b1 = unsafe { *(bytes + 1) };
        if (b1 & 0xC0u8) != 0x80u8 {
            return Utf8Dec { cp: 0xFFFDu32, byte_len: 1, ok: false };
        }
        if (b0 == 0xF0u8 && b1 < 0x90u8) || (b0 == 0xF4u8 && b1 >= 0x90u8) {
            return Utf8Dec { cp: 0xFFFDu32, byte_len: 1, ok: false };
        }
        if max_len < 3 {
            return Utf8Dec { cp: 0xFFFDu32, byte_len: 2, ok: false };
        }
        let b2 = unsafe { *(bytes + 2) };
        if (b2 & 0xC0u8) != 0x80u8 {
            return Utf8Dec { cp: 0xFFFDu32, byte_len: 2, ok: false };
        }
        if max_len < 4 {
            return Utf8Dec { cp: 0xFFFDu32, byte_len: 3, ok: false };
        }
        let b3 = unsafe { *(bytes + 3) };
        if (b3 & 0xC0u8) != 0x80u8 {
            return Utf8Dec { cp: 0xFFFDu32, byte_len: 3, ok: false };
        }
        let cp = (((b0 & 0x07u8) as u32) << 18u32) | (((b1 & 0x3Fu8) as u32) << 12u32) | (((b2 & 0x3Fu8) as u32) << 6u32) | ((b3 & 0x3Fu8) as u32);
        return Utf8Dec { cp: cp, byte_len: 4, ok: true };
    }
    Utf8Dec { cp: 0xFFFDu32, byte_len: 1, ok: false }
}

pub fn ax_utf8_encode(cp: u32, out: *mut u8) -> usize {
    if cp <= 0x7Fu32 {
        unsafe { *out = cp as u8; }
        return 1;
    }
    if cp <= 0x7FFu32 {
        unsafe {
            *out = (0xC0u32 | (cp >> 6u32)) as u8;
            *(out + 1) = (0x80u32 | (cp & 0x3Fu32)) as u8;
        }
        return 2;
    }
    if cp <= 0xFFFFu32 {
        if cp >= 0xD800u32 && cp <= 0xDFFFu32 { return 0; }
        unsafe {
            *out = (0xE0u32 | (cp >> 12u32)) as u8;
            *(out + 1) = (0x80u32 | ((cp >> 6u32) & 0x3Fu32)) as u8;
            *(out + 2) = (0x80u32 | (cp & 0x3Fu32)) as u8;
        }
        return 3;
    }
    if cp <= 0x10FFFFu32 {
        unsafe {
            *out = (0xF0u32 | (cp >> 18u32)) as u8;
            *(out + 1) = (0x80u32 | ((cp >> 12u32) & 0x3Fu32)) as u8;
            *(out + 2) = (0x80u32 | ((cp >> 6u32) & 0x3Fu32)) as u8;
            *(out + 3) = (0x80u32 | (cp & 0x3Fu32)) as u8;
        }
        return 4;
    }
    0
}

pub fn lex_result_init(res: mut_view<LexResult>) {
    res.arena = arena_new();
    res.tokens = 0 as *mut Token;
    res.token_count = 0;
    res.token_cap = 0;
    res.comments = 0 as *mut Comment;
    res.comment_count = 0;
    res.comment_cap = 0;
}

pub fn ax_lex_result_free(res: mut_view<LexResult>) {
    if res.token_cap > 0 && res.tokens as usize != 0 {
        unsafe { heap_free(res.tokens as *mut u8, (((res.token_cap as isize) * (size_of<Token>() as isize)) as usize), align_of<Token>()); }
    }
    if res.comment_cap > 0 && res.comments as usize != 0 {
        unsafe { heap_free(res.comments as *mut u8, (((res.comment_cap as isize) * (size_of<Comment>() as isize)) as usize), align_of<Comment>()); }
    }
    arena_destroy(mut_view(res.arena));
    res.tokens = 0 as *mut Token;
    res.token_count = 0;
    res.token_cap = 0;
    res.comments = 0 as *mut Comment;
    res.comment_count = 0;
    res.comment_cap = 0;
}

pub fn lex_token_get(res: view<LexResult>, idx: usize) -> Token {
    unsafe {
        let p = lex_token_ptr(res.tokens, idx);
        Token { kind: (*p).kind, suffix: (*p).suffix, flags: (*p).flags, char_val: (*p).char_val, span: Span { file: FileId { v: (*p).span.file.v }, start: (*p).span.start, end: (*p).span.end }, int_val: (*p).int_val, str_ptr: (*p).str_ptr, str_len: (*p).str_len, ident_val: StrId { v: (*p).ident_val.v } }
    }
}
pub fn lex_comment_get(res: view<LexResult>, idx: usize) -> Comment {
    unsafe {
        let p = lex_comment_ptr(res.comments, idx);
        Comment { kind: (*p).kind, span: Span { file: FileId { v: (*p).span.file.v }, start: (*p).span.start, end: (*p).span.end } }
    }
}

fn push_token(res: mut_view<LexResult>, tok: view<Token>) {
    if res.token_count == res.token_cap {
        let new_cap = if res.token_cap == 0 { 64 } else { res.token_cap + res.token_cap };
        let new_mem = unsafe { heap_alloc((((new_cap as isize) * (size_of<Token>() as isize)) as usize), align_of<Token>()) as *mut Token };
        if res.token_count > 0 && res.tokens as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(res.tokens as *const u8, new_mem as *mut u8, (((res.token_count as isize) * (size_of<Token>() as isize)) as usize));
                heap_free(res.tokens as *mut u8, (((res.token_cap as isize) * (size_of<Token>() as isize)) as usize), align_of<Token>());
            }
        }
        res.tokens = new_mem;
        res.token_cap = new_cap;
    }
    unsafe {
        *(lex_token_ptr(res.tokens, res.token_count)) = Token { kind: tok.kind, suffix: tok.suffix, flags: tok.flags, char_val: tok.char_val, span: Span { file: FileId { v: tok.span.file.v }, start: tok.span.start, end: tok.span.end }, int_val: tok.int_val, str_ptr: tok.str_ptr, str_len: tok.str_len, ident_val: StrId { v: tok.ident_val.v } };
    }
    res.token_count = res.token_count + 1;
}

fn push_simple_token(res: mut_view<LexResult>, kind: u8, flags: u16, sp: Span) {
    let tok = Token { kind: kind, suffix: SUFFIX_NONE, flags: flags, char_val: 0u32, span: sp, int_val: 0u64, str_ptr: 0 as *const u8, str_len: 0, ident_val: StrId { v: 0u32 } };
    push_token(res, view(tok));
}

fn push_comment(res: mut_view<LexResult>, kind: u8, sp: Span) {
    if res.comment_count == res.comment_cap {
        let new_cap = if res.comment_cap == 0 { 16 } else { res.comment_cap + res.comment_cap };
        let new_mem = unsafe { heap_alloc((((new_cap as isize) * (size_of<Comment>() as isize)) as usize), align_of<Comment>()) as *mut Comment };
        if res.comment_count > 0 && res.comments as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(res.comments as *const u8, new_mem as *mut u8, (((res.comment_count as isize) * (size_of<Comment>() as isize)) as usize));
                heap_free(res.comments as *mut u8, (((res.comment_cap as isize) * (size_of<Comment>() as isize)) as usize), align_of<Comment>());
            }
        }
        res.comments = new_mem;
        res.comment_cap = new_cap;
    }
    unsafe { *(lex_comment_ptr(res.comments, res.comment_count)) = Comment { kind: kind, span: sp }; }
    res.comment_count = res.comment_count + 1;
}

fn lex_msg_sv(arena: mut_view<Arena>, msg_idx: usize) -> StrView {
    let start = LEX_MSG_OFF[msg_idx] as usize;
    let end = LEX_MSG_OFF[msg_idx + 1] as usize;
    let n = end - start;
    let dst = arena_alloc_raw(arena, n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = LEX_MSG_DATA[start + i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn emit_lex_diag(sink: mut_view<DiagSink>, code_v: u32, sp: Span) {
    let msg = lex_msg_sv(mut_view(sink.arena), code_v as usize);
    let d = Diagnostic { code: DiagCode { v: code_v }, severity: DiagSeverity.Error, message: msg, primary: sp, labels: 0 as *mut DiagLabel, label_count: 0, notes: 0 as *mut StrView, note_count: 0, helps: 0 as *mut StrView, help_count: 0, fixes: 0 as *mut DiagFix, fix_count: 0, data: 0 as *mut DiagDataEntry, data_count: 0 };
    diag_sink_report(sink, view(d));
}

fn emit_lex_diag_with_fix(sink: mut_view<DiagSink>, code_v: u32, sp: Span, rep_msg_idx: usize) {
    let msg = lex_msg_sv(mut_view(sink.arena), code_v as usize);
    let rep = lex_msg_sv(mut_view(sink.arena), rep_msg_idx);
    let edit_ptr = arena_alloc_raw(mut_view(sink.arena), size_of<DiagEdit>(), align_of<DiagEdit>()) as *mut DiagEdit;
    unsafe { *edit_ptr = DiagEdit { span: Span { file: FileId { v: sp.file.v }, start: sp.start, end: sp.end }, replacement: StrView { ptr: rep.ptr, len: rep.len } }; }
    let fix_ptr = arena_alloc_raw(mut_view(sink.arena), size_of<DiagFix>(), align_of<DiagFix>()) as *mut DiagFix;
    unsafe { *fix_ptr = DiagFix { message: StrView { ptr: rep.ptr, len: rep.len }, applicability: FixApplicability.MachineApplicable, edits: edit_ptr, edit_count: 1 }; }
    let d = Diagnostic { code: DiagCode { v: code_v }, severity: DiagSeverity.Error, message: msg, primary: Span { file: FileId { v: sp.file.v }, start: sp.start, end: sp.end }, labels: 0 as *mut DiagLabel, label_count: 0, notes: 0 as *mut StrView, note_count: 0, helps: 0 as *mut StrView, help_count: 0, fixes: fix_ptr, fix_count: 1, data: 0 as *mut DiagDataEntry, data_count: 0 };
    diag_sink_report(sink, view(d));
}

fn is_ident_start(c: u8) -> bool { (c >= 97u8 && c <= 122u8) || (c >= 65u8 && c <= 90u8) || c == 95u8 }
fn is_ident_continue(c: u8) -> bool { is_ident_start(c) || (c >= 48u8 && c <= 57u8) }
fn is_dec_digit(c: u8) -> bool { c >= 48u8 && c <= 57u8 }
fn is_hex_digit(c: u8) -> bool { is_dec_digit(c) || (c >= 97u8 && c <= 102u8) || (c >= 65u8 && c <= 70u8) }

fn hex_val(c: u8) -> u32 {
    if c >= 48u8 && c <= 57u8 { return (c - 48u8) as u32; }
    if c >= 97u8 && c <= 102u8 { return (c - 97u8 + 10u8) as u32; }
    if c >= 65u8 && c <= 70u8 { return (c - 65u8 + 10u8) as u32; }
    0u32
}

fn check_keyword(s: *const u8, s_len: usize) -> u8 {
    if s_len == 1 && (unsafe { *s }) == 95u8 { return TOK_UNDERSCORE; }
    if s_len < 2 || s_len > 8 { return TOK_IDENT; }
    let mut idx: usize = 0;
    while idx < 40 {
        let start = KW_OFF[idx] as usize;
        let end = KW_OFF[idx + 1] as usize;
        if end - start == s_len {
            let mut eq = true;
            let mut k: usize = 0;
            while k < s_len {
                if (unsafe { *(s + k) }) != KW_DATA[start + k] {
                    eq = false;
                    break;
                }
                k = k + 1;
            }
            if eq { return TOK_KW_AS + (idx as u8); }
        }
        idx = idx + 1;
    }
    TOK_IDENT
}

struct LexCursor {
    file_v: u32,
    p: *const u8,
    byte_len: usize,
    pos: usize,
    pending_nl: bool,
    had_err: bool,
}

fn scan_suffix(cur: mut_view<LexCursor>, sink: mut_view<DiagSink>) -> u8 {
    let p = cur.p;
    let byte_len = cur.byte_len;
    if cur.pos >= byte_len || !is_ident_start(unsafe { *(p + cur.pos) }) {
        return SUFFIX_NONE;
    }
    let start = cur.pos;
    while (cur.pos) < byte_len && is_ident_continue(unsafe { *(p + cur.pos) }) {
        cur.pos = cur.pos + 1;
    }
    let s_len = cur.pos - start;
    let s = unsafe { p + start };

    let mut idx: usize = 1;
    while idx < 13 {
        let off0 = SUF_NAMES_OFF[idx] as usize;
        let off1 = SUF_NAMES_OFF[idx + 1] as usize;
        if off1 - off0 == s_len {
            let mut eq = true;
            let mut k: usize = 0;
            while k < s_len {
                if (unsafe { *(s + k) }) != SUF_NAMES_DATA[off0 + k] {
                    eq = false;
                    break;
                }
                k = k + 1;
            }
            if eq { return idx as u8; }
        }
        idx = idx + 1;
    }
    emit_lex_diag(sink, AX_LEX_INVALID_SUFFIX, span_new(FileId { v: cur.file_v }, start as u32, cur.pos as u32));
    cur.had_err = true;
    SUFFIX_NONE
}

fn scan_whitespace_and_comments(cur: mut_view<LexCursor>, sink: mut_view<DiagSink>, res: mut_view<LexResult>) {
    let p = cur.p;
    let byte_len = cur.byte_len;
    while (cur.pos) < byte_len {
        let c = unsafe { *(p + cur.pos) };
        if c == 10u8 {
            cur.pending_nl = true;
            cur.pos = cur.pos + 1;
        } else if c == 32u8 || c == 9u8 || c == 13u8 {
            cur.pos = cur.pos + 1;
        } else if cur.pos + 1 < byte_len && c == 47u8 && (unsafe { *(p + cur.pos + 1) }) == 47u8 {
            let start = cur.pos as u32;
            cur.pos = cur.pos + 2;
            let mut is_doc = false;
            if (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) == 47u8 && (cur.pos + 1 == byte_len || (unsafe { *(p + cur.pos + 1) }) != 47u8) {
                is_doc = true;
            }
            while (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) != 10u8 {
                cur.pos = cur.pos + 1;
            }
            push_comment(mut_view(*res), if is_doc { COMMENT_DOC } else { COMMENT_LINE }, span_new(FileId { v: cur.file_v }, start, cur.pos as u32));
        } else if cur.pos + 1 < byte_len && c == 47u8 && (unsafe { *(p + cur.pos + 1) }) == 42u8 {
            let start = cur.pos as u32;
            cur.pos = cur.pos + 2;
            let mut depth: i32 = 1;
            while (cur.pos) < byte_len && depth > 0 {
                let ch = unsafe { *(p + cur.pos) };
                if ch == 10u8 { cur.pending_nl = true; }
                if cur.pos + 1 < byte_len && ch == 47u8 && (unsafe { *(p + cur.pos + 1) }) == 42u8 {
                    depth = depth + 1;
                    cur.pos = cur.pos + 2;
                } else if cur.pos + 1 < byte_len && ch == 42u8 && (unsafe { *(p + cur.pos + 1) }) == 47u8 {
                    depth = depth - 1;
                    cur.pos = cur.pos + 2;
                } else {
                    cur.pos = cur.pos + 1;
                }
            }
            if depth > 0 {
                emit_lex_diag(mut_view(*sink), AX_LEX_UNTERMINATED_COMMENT, span_new(FileId { v: cur.file_v }, start, byte_len as u32));
            }
            push_comment(mut_view(*res), COMMENT_BLOCK, span_new(FileId { v: cur.file_v }, start, cur.pos as u32));
        } else {
            break;
        }
    }
}

fn scan_string_like(cur: mut_view<LexCursor>, start: u32, is_byte_str: bool, is_raw: bool, flags: u16, sink: mut_view<DiagSink>, res: mut_view<LexResult>) {
    let p = cur.p;
    let byte_len = cur.byte_len;
    let mut buf = diag_buf_new();
    let mut terminated = false;
    let mut err = false;

    while (cur.pos) < byte_len {
        let c0 = unsafe { *(p + cur.pos) };
        if c0 == 34u8 {
            terminated = true;
            cur.pos = cur.pos + 1;
            break;
        }
        if c0 == 10u8 || c0 == 13u8 {
            break;
        }
        if !is_raw && c0 == 92u8 {
            let esc_start = cur.pos as u32;
            cur.pos = cur.pos + 1;
            if cur.pos >= byte_len || (unsafe { *(p + cur.pos) }) == 10u8 || (unsafe { *(p + cur.pos) }) == 13u8 {
                break;
            }
            let c = unsafe { *(p + cur.pos) };
            cur.pos = cur.pos + 1;
            if c == 110u8 { diag_buf_push_byte(mut_view(buf), 10u8); }
            else if c == 114u8 { diag_buf_push_byte(mut_view(buf), 13u8); }
            else if c == 116u8 { diag_buf_push_byte(mut_view(buf), 9u8); }
            else if c == 92u8 { diag_buf_push_byte(mut_view(buf), 92u8); }
            else if c == 48u8 { diag_buf_push_byte(mut_view(buf), 0u8); }
            else if c == 34u8 { diag_buf_push_byte(mut_view(buf), 34u8); }
            else if c == 39u8 { diag_buf_push_byte(mut_view(buf), 39u8); }
            else if c == 120u8 {
                if cur.pos + 1 < byte_len && is_hex_digit(unsafe { *(p + cur.pos) }) && is_hex_digit(unsafe { *(p + cur.pos + 1) }) {
                    let val = (hex_val(unsafe { *(p + cur.pos) }) << 4u32) | hex_val(unsafe { *(p + cur.pos + 1) });
                    cur.pos = cur.pos + 2;
                    if !is_byte_str && val > 0x7Fu32 {
                        emit_lex_diag(mut_view(*sink), AX_LEX_INVALID_ESCAPE, span_new(FileId { v: cur.file_v }, esc_start, cur.pos as u32));
                        err = true;
                    } else {
                        diag_buf_push_byte(mut_view(buf), val as u8);
                    }
                } else {
                    while (cur.pos) < byte_len && (cur.pos - (esc_start as usize)) < 4 && is_hex_digit(unsafe { *(p + cur.pos) }) {
                        cur.pos = cur.pos + 1;
                    }
                    emit_lex_diag(mut_view(*sink), AX_LEX_INVALID_ESCAPE, span_new(FileId { v: cur.file_v }, esc_start, cur.pos as u32));
                    err = true;
                }
            } else if c == 117u8 {
                if is_byte_str {
                    let mut u_end = cur.pos;
                    if (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) == 123u8 {
                        u_end = u_end + 1;
                        while u_end < byte_len && (unsafe { *(p + u_end) }) != 125u8 && (unsafe { *(p + u_end) }) != 34u8 && (unsafe { *(p + u_end) }) != 10u8 && (unsafe { *(p + u_end) }) != 13u8 {
                            u_end = u_end + 1;
                        }
                        if u_end < byte_len && (unsafe { *(p + u_end) }) == 125u8 { u_end = u_end + 1; }
                    }
                    cur.pos = u_end;
                    emit_lex_diag(mut_view(*sink), AX_LEX_INVALID_UNICODE_ESCAPE, span_new(FileId { v: cur.file_v }, esc_start, cur.pos as u32));
                    err = true;
                } else {
                    let mut valid = true;
                    if (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) == 123u8 {
                        cur.pos = cur.pos + 1;
                        let hex_start = cur.pos;
                        while (cur.pos) < byte_len && is_hex_digit(unsafe { *(p + cur.pos) }) { cur.pos = cur.pos + 1; }
                        let hex_len = cur.pos - hex_start;
                        if (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) == 125u8 {
                            cur.pos = cur.pos + 1;
                            if hex_len > 0 && hex_len <= 6 {
                                let mut val: u32 = 0u32;
                                let mut i = hex_start;
                                while i < hex_start + hex_len {
                                    val = (val << 4u32) | hex_val(unsafe { *(p + i) });
                                    i = i + 1;
                                }
                                if val > 0x10FFFFu32 || (val >= 0xD800u32 && val <= 0xDFFFu32) {
                                    valid = false;
                                } else if val <= 0x7Fu32 {
                                    diag_buf_push_byte(mut_view(buf), val as u8);
                                } else if val <= 0x7FFu32 {
                                    diag_buf_push_byte(mut_view(buf), (0xC0u32 | (val >> 6u32)) as u8);
                                    diag_buf_push_byte(mut_view(buf), (0x80u32 | (val & 0x3Fu32)) as u8);
                                } else if val <= 0xFFFFu32 {
                                    diag_buf_push_byte(mut_view(buf), (0xE0u32 | (val >> 12u32)) as u8);
                                    diag_buf_push_byte(mut_view(buf), (0x80u32 | ((val >> 6u32) & 0x3Fu32)) as u8);
                                    diag_buf_push_byte(mut_view(buf), (0x80u32 | (val & 0x3Fu32)) as u8);
                                } else {
                                    diag_buf_push_byte(mut_view(buf), (0xF0u32 | (val >> 18u32)) as u8);
                                    diag_buf_push_byte(mut_view(buf), (0x80u32 | ((val >> 12u32) & 0x3Fu32)) as u8);
                                    diag_buf_push_byte(mut_view(buf), (0x80u32 | ((val >> 6u32) & 0x3Fu32)) as u8);
                                    diag_buf_push_byte(mut_view(buf), (0x80u32 | (val & 0x3Fu32)) as u8);
                                }
                            } else {
                                valid = false;
                            }
                        } else {
                            while (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) != 125u8 && (unsafe { *(p + cur.pos) }) != 34u8 && (unsafe { *(p + cur.pos) }) != 10u8 && (unsafe { *(p + cur.pos) }) != 13u8 {
                                cur.pos = cur.pos + 1;
                            }
                            if (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) == 125u8 { cur.pos = cur.pos + 1; }
                            valid = false;
                        }
                    } else {
                        valid = false;
                    }
                    if !valid {
                        emit_lex_diag(mut_view(*sink), AX_LEX_INVALID_UNICODE_ESCAPE, span_new(FileId { v: cur.file_v }, esc_start, cur.pos as u32));
                        err = true;
                    }
                }
            } else {
                emit_lex_diag(mut_view(*sink), AX_LEX_INVALID_ESCAPE, span_new(FileId { v: cur.file_v }, esc_start, cur.pos as u32));
                err = true;
            }
        } else {
            if is_byte_str && c0 >= 0x80u8 {
                let dec = ax_utf8_decode(unsafe { p + cur.pos }, byte_len - cur.pos);
                emit_lex_diag(mut_view(*sink), AX_LEX_NON_ASCII_IN_BYTE_LITERAL, span_new(FileId { v: cur.file_v }, cur.pos as u32, (cur.pos + dec.byte_len) as u32));
                err = true;
                cur.pos = cur.pos + dec.byte_len;
            } else {
                diag_buf_push_byte(mut_view(buf), c0);
                cur.pos = cur.pos + 1;
            }
        }
    }

    if !terminated {
        emit_lex_diag(mut_view(*sink), AX_LEX_UNTERMINATED_STRING, span_new(FileId { v: cur.file_v }, start, cur.pos as u32));
        err = true;
    }

    let dst = arena_alloc_raw(mut_view(res.arena), buf.len + 1, 1);
    if buf.len > 0 {
        unsafe { ptr_copy_nonoverlapping<u8>(buf.ptr as *const u8, dst, buf.len); }
    }
    unsafe { *(dst + buf.len) = 0u8; }
    let b_len = buf.len;
    diag_buf_free(mut_view(buf));

    let mut tflags = flags;
    if is_raw { tflags = tflags | TOK_FLAG_RAW; }
    if err { tflags = tflags | TOK_FLAG_ERROR; }
    let tok = Token { kind: if is_byte_str { TOK_BYTE_STR } else { TOK_STR }, suffix: SUFFIX_NONE, flags: tflags, char_val: 0u32, span: span_new(FileId { v: cur.file_v }, start, cur.pos as u32), int_val: 0u64, str_ptr: dst as *const u8, str_len: b_len, ident_val: StrId { v: 0u32 } };
    push_token(res, view(tok));
}

fn scan_char_like(cur: mut_view<LexCursor>, start: u32, is_byte: bool, flags: u16, sink: mut_view<DiagSink>, res: mut_view<LexResult>) {
    let p = cur.p;
    let byte_len = cur.byte_len;
    let mut val: u32 = 0u32;
    let mut has_val = false;
    let mut multiple = false;
    let mut terminated = false;
    let mut err = false;

    while (cur.pos) < byte_len {
        let c0 = unsafe { *(p + cur.pos) };
        if c0 == 39u8 {
            terminated = true;
            cur.pos = cur.pos + 1;
            break;
        }
        if c0 == 10u8 || c0 == 13u8 { break; }

        let mut cur_val: u32 = 0u32;
        if c0 == 92u8 {
            let esc_start = cur.pos as u32;
            cur.pos = cur.pos + 1;
            if cur.pos >= byte_len || (unsafe { *(p + cur.pos) }) == 10u8 || (unsafe { *(p + cur.pos) }) == 13u8 { break; }
            let c = unsafe { *(p + cur.pos) };
            cur.pos = cur.pos + 1;
            if c == 110u8 { cur_val = 10u32; }
            else if c == 114u8 { cur_val = 13u32; }
            else if c == 116u8 { cur_val = 9u32; }
            else if c == 92u8 { cur_val = 92u32; }
            else if c == 48u8 { cur_val = 0u32; }
            else if c == 34u8 { cur_val = 34u32; }
            else if c == 39u8 { cur_val = 39u32; }
            else if c == 120u8 {
                if cur.pos + 1 < byte_len && is_hex_digit(unsafe { *(p + cur.pos) }) && is_hex_digit(unsafe { *(p + cur.pos + 1) }) {
                    cur_val = (hex_val(unsafe { *(p + cur.pos) }) << 4u32) | hex_val(unsafe { *(p + cur.pos + 1) });
                    cur.pos = cur.pos + 2;
                    if !is_byte && cur_val > 0x7Fu32 {
                        emit_lex_diag(mut_view(*sink), AX_LEX_INVALID_ESCAPE, span_new(FileId { v: cur.file_v }, esc_start, cur.pos as u32));
                        err = true;
                    }
                } else {
                    while (cur.pos) < byte_len && (cur.pos - (esc_start as usize)) < 4 && is_hex_digit(unsafe { *(p + cur.pos) }) { cur.pos = cur.pos + 1; }
                    emit_lex_diag(mut_view(*sink), AX_LEX_INVALID_ESCAPE, span_new(FileId { v: cur.file_v }, esc_start, cur.pos as u32));
                    err = true;
                }
            } else if c == 117u8 {
                if is_byte {
                    let mut u_end = cur.pos;
                    if (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) == 123u8 {
                        u_end = u_end + 1;
                        while u_end < byte_len && (unsafe { *(p + u_end) }) != 125u8 && (unsafe { *(p + u_end) }) != 39u8 && (unsafe { *(p + u_end) }) != 10u8 && (unsafe { *(p + u_end) }) != 13u8 { u_end = u_end + 1; }
                        if u_end < byte_len && (unsafe { *(p + u_end) }) == 125u8 { u_end = u_end + 1; }
                    }
                    cur.pos = u_end;
                    emit_lex_diag(mut_view(*sink), AX_LEX_INVALID_UNICODE_ESCAPE, span_new(FileId { v: cur.file_v }, esc_start, cur.pos as u32));
                    err = true;
                } else {
                    let mut valid = true;
                    if (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) == 123u8 {
                        cur.pos = cur.pos + 1;
                        let hex_start = cur.pos;
                        while (cur.pos) < byte_len && is_hex_digit(unsafe { *(p + cur.pos) }) { cur.pos = cur.pos + 1; }
                        let hex_len = cur.pos - hex_start;
                        if (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) == 125u8 {
                            cur.pos = cur.pos + 1;
                            if hex_len > 0 && hex_len <= 6 {
                                let mut v: u32 = 0u32;
                                let mut i = hex_start;
                                while i < hex_start + hex_len {
                                    v = (v << 4u32) | hex_val(unsafe { *(p + i) });
                                    i = i + 1;
                                }
                                if v > 0x10FFFFu32 || (v >= 0xD800u32 && v <= 0xDFFFu32) { valid = false; } else { cur_val = v; }
                            } else { valid = false; }
                        } else {
                            while (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) != 125u8 && (unsafe { *(p + cur.pos) }) != 39u8 && (unsafe { *(p + cur.pos) }) != 10u8 && (unsafe { *(p + cur.pos) }) != 13u8 { cur.pos = cur.pos + 1; }
                            if (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) == 125u8 { cur.pos = cur.pos + 1; }
                            valid = false;
                        }
                    } else { valid = false; }
                    if !valid {
                        emit_lex_diag(mut_view(*sink), AX_LEX_INVALID_UNICODE_ESCAPE, span_new(FileId { v: cur.file_v }, esc_start, cur.pos as u32));
                        err = true;
                    }
                }
            } else {
                emit_lex_diag(mut_view(*sink), AX_LEX_INVALID_ESCAPE, span_new(FileId { v: cur.file_v }, esc_start, cur.pos as u32));
                err = true;
            }
        } else if is_byte && c0 >= 0x80u8 {
            let dec = ax_utf8_decode(unsafe { p + cur.pos }, byte_len - cur.pos);
            emit_lex_diag(mut_view(*sink), AX_LEX_NON_ASCII_IN_BYTE_LITERAL, span_new(FileId { v: cur.file_v }, cur.pos as u32, (cur.pos + dec.byte_len) as u32));
            err = true;
            cur.pos = cur.pos + dec.byte_len;
        } else if is_byte {
            cur_val = c0 as u32;
            cur.pos = cur.pos + 1;
        } else {
            let dec = ax_utf8_decode(unsafe { p + cur.pos }, byte_len - cur.pos);
            cur_val = dec.cp;
            cur.pos = cur.pos + dec.byte_len;
        }

        if has_val {
            multiple = true;
        } else {
            val = cur_val;
            has_val = true;
        }
    }

    if !terminated {
        emit_lex_diag(mut_view(*sink), AX_LEX_UNTERMINATED_CHAR, span_new(FileId { v: cur.file_v }, start, cur.pos as u32));
    } else if !has_val || multiple {
        emit_lex_diag(mut_view(*sink), AX_LEX_BAD_CHAR_LITERAL, span_new(FileId { v: cur.file_v }, start, cur.pos as u32));
        err = true;
    }

    let mut tflags = flags;
    if err { tflags = tflags | TOK_FLAG_ERROR; }
    if is_byte {
        let tok = Token { kind: TOK_INT, suffix: SUFFIX_U8, flags: tflags | TOK_FLAG_BYTE_FORM, char_val: 0u32, span: span_new(FileId { v: cur.file_v }, start, cur.pos as u32), int_val: val as u64, str_ptr: 0 as *const u8, str_len: 0, ident_val: StrId { v: 0u32 } };
        push_token(res, view(tok));
    } else {
        let tok = Token { kind: TOK_CHAR, suffix: SUFFIX_NONE, flags: tflags, char_val: val, span: span_new(FileId { v: cur.file_v }, start, cur.pos as u32), int_val: 0u64, str_ptr: 0 as *const u8, str_len: 0, ident_val: StrId { v: 0u32 } };
        push_token(res, view(tok));
    }
}

fn scan_number(cur: mut_view<LexCursor>, start: u32, last_kind: u8, flags: u16, sink: mut_view<DiagSink>, res: mut_view<LexResult>) {
    let p = cur.p;
    let byte_len = cur.byte_len;
    let mut base: u64 = 10u64;
    let mut has_prefix = false;
    let mut digits_start = start as usize;
    let mut err_flags: u16 = 0u16;

    if (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) == 48u8 && cur.pos + 1 < byte_len {
        let c = unsafe { *(p + cur.pos + 1) };
        if c == 120u8 || c == 88u8 || c == 111u8 || c == 79u8 || c == 98u8 || c == 66u8 {
            has_prefix = true;
            if c == 88u8 || c == 79u8 || c == 66u8 {
                let rep_idx: usize = if c == 88u8 { 21 } else if c == 79u8 { 22 } else { 23 };
                emit_lex_diag_with_fix(mut_view(*sink), AX_LEX_BAD_BASE_PREFIX, span_new(FileId { v: cur.file_v }, cur.pos as u32, (cur.pos + 2) as u32), rep_idx);
                err_flags = TOK_FLAG_ERROR;
            }
            if c == 120u8 || c == 88u8 { base = 16u64; }
            else if c == 111u8 || c == 79u8 { base = 8u64; }
            else { base = 2u64; }
            cur.pos = cur.pos + 2;
            digits_start = cur.pos;
        }
    }

    let mut val: u64 = 0u64;
    let mut overflow = false;
    let mut missing_digits = true;
    let mut invalid_digit = false;
    let mut bad_sep = false;
    let mut is_float = false;

    while (cur.pos) < byte_len {
        let c = unsafe { *(p + cur.pos) };
        if c == 95u8 {
            let sep_start = cur.pos;
            while (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) == 95u8 { cur.pos = cur.pos + 1; }
            if !bad_sep && (sep_start == digits_start || cur.pos == byte_len || !is_hex_digit(unsafe { *(p + cur.pos) }) || (cur.pos - sep_start) > 1) {
                emit_lex_diag(mut_view(*sink), AX_LEX_BAD_DIGIT_SEPARATOR, span_new(FileId { v: cur.file_v }, sep_start as u32, cur.pos as u32));
                err_flags = TOK_FLAG_ERROR;
                bad_sep = true;
            }
            continue;
        }
        if !is_hex_digit(c) && c != 46u8 && c != 101u8 && c != 69u8 { break; }
        if c == 46u8 || c == 101u8 || c == 69u8 {
            if base != 10u64 {
                if !is_hex_digit(c) { break; }
            } else if c == 46u8 {
                if last_kind == TOK_DOT { break; }
                if cur.pos + 1 < byte_len && !is_dec_digit(unsafe { *(p + cur.pos + 1) }) { break; }
                if cur.pos + 1 == byte_len { break; }
                is_float = true;
            } else {
                if last_kind == TOK_DOT { break; }
                let mut look = cur.pos + 1;
                if look < byte_len && ((unsafe { *(p + look) }) == 43u8 || (unsafe { *(p + look) }) == 45u8) { look = look + 1; }
                if look < byte_len && is_dec_digit(unsafe { *(p + look) }) {
                    is_float = true;
                } else {
                    break;
                }
            }
        }

        if is_float {
            cur.pos = cur.pos + 1;
            while (cur.pos) < byte_len {
                let fc = unsafe { *(p + cur.pos) };
                if fc == 95u8 {
                    let sep_start = cur.pos;
                    while (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) == 95u8 { cur.pos = cur.pos + 1; }
                    if !bad_sep && (cur.pos == byte_len || !is_dec_digit(unsafe { *(p + cur.pos) }) || (cur.pos - sep_start) > 1) {
                        emit_lex_diag(mut_view(*sink), AX_LEX_BAD_DIGIT_SEPARATOR, span_new(FileId { v: cur.file_v }, sep_start as u32, cur.pos as u32));
                        err_flags = TOK_FLAG_ERROR;
                        bad_sep = true;
                    }
                    continue;
                }
                if fc == 101u8 || fc == 69u8 {
                    cur.pos = cur.pos + 1;
                    if (cur.pos) < byte_len && ((unsafe { *(p + cur.pos) }) == 43u8 || (unsafe { *(p + cur.pos) }) == 45u8) {
                        cur.pos = cur.pos + 1;
                    }
                    continue;
                }
                if !is_dec_digit(fc) { break; }
                cur.pos = cur.pos + 1;
            }
            break;
        }

        let mut valid = false;
        if base == 10u64 && is_dec_digit(c) { valid = true; }
        else if base == 16u64 && is_hex_digit(c) { valid = true; }
        else if base == 8u64 && (c >= 48u8 && c <= 55u8) { valid = true; }
        else if base == 2u64 && (c == 48u8 || c == 49u8) { valid = true; }

        if !valid {
            if (base == 2u64 || base == 8u64) && is_dec_digit(c) {
                if !invalid_digit {
                    emit_lex_diag(mut_view(*sink), AX_LEX_INVALID_DIGIT, span_new(FileId { v: cur.file_v }, cur.pos as u32, (cur.pos + 1) as u32));
                    err_flags = TOK_FLAG_ERROR;
                    invalid_digit = true;
                }
                cur.pos = cur.pos + 1;
                continue;
            }
            break;
        } else {
            missing_digits = false;
            let d = hex_val(c) as u64;
            let max_q: u64 = if base == 10u64 { 1844674407370955161u64 } else if base == 16u64 { 0x0FFFFFFFFFFFFFFFu64 } else if base == 8u64 { 0x1FFFFFFFFFFFFFFFu64 } else { 0x7FFFFFFFFFFFFFFFu64 };
            let max_r: u64 = if base == 10u64 { 5u64 } else if base == 16u64 { 15u64 } else if base == 8u64 { 7u64 } else { 1u64 };
            if val > max_q || (val == max_q && d > max_r) {
                overflow = true;
            } else {
                val = val * base + d;
            }
        }
        cur.pos = cur.pos + 1;
    }

    if !bad_sep && cur.pos > digits_start && (unsafe { *(p + cur.pos - 1) }) == 95u8 {
        let mut sep_start = cur.pos - 1;
        while sep_start > digits_start && (unsafe { *(p + sep_start - 1) }) == 95u8 {
            sep_start = sep_start - 1;
        }
        if sep_start > digits_start {
            emit_lex_diag(mut_view(*sink), AX_LEX_BAD_DIGIT_SEPARATOR, span_new(FileId { v: cur.file_v }, sep_start as u32, cur.pos as u32));
            err_flags = TOK_FLAG_ERROR;
        }
    }

    if has_prefix && missing_digits {
        emit_lex_diag(mut_view(*sink), AX_LEX_MISSING_DIGITS, span_new(FileId { v: cur.file_v }, start, cur.pos as u32));
        err_flags = TOK_FLAG_ERROR;
        val = 0u64;
    }

    cur.had_err = false;
    let mut suf: u8 = SUFFIX_NONE;
    if last_kind != TOK_DOT {
        suf = scan_suffix(mut_view(*cur), mut_view(*sink));
    }
    if cur.had_err { err_flags = TOK_FLAG_ERROR; }

    if !is_float {
        if err_flags == 0u16 && overflow {
            emit_lex_diag(mut_view(*sink), AX_LEX_INT_OVERFLOW, span_new(FileId { v: cur.file_v }, start, cur.pos as u32));
            err_flags = TOK_FLAG_ERROR;
            val = 0u64;
        } else if overflow {
            val = 0u64;
        }
    }

    let tok = Token { kind: if is_float { TOK_FLOAT } else { TOK_INT }, suffix: suf, flags: flags | err_flags, char_val: 0u32, span: span_new(FileId { v: cur.file_v }, start, cur.pos as u32), int_val: if is_float { 0u64 } else { val }, str_ptr: 0 as *const u8, str_len: 0, ident_val: StrId { v: 0u32 } };
    push_token(res, view(tok));
}

fn match_punct(c: u8, c2: u8, c3: u8) -> u16 {
    if c == 46u8 && c2 == 46u8 && c3 == 61u8 { return 0x0300u16 | (TOK_DOT_DOT_EQ as u16); }
    if c == 60u8 && c2 == 60u8 && c3 == 61u8 { return 0x0300u16 | (TOK_SHL_EQ as u16); }
    if c == 62u8 && c2 == 62u8 && c3 == 61u8 { return 0x0300u16 | (TOK_SHR_EQ as u16); }
    if c == 46u8 && c2 == 46u8 { return 0x0200u16 | (TOK_DOT_DOT as u16); }
    if c == 45u8 && c2 == 62u8 { return 0x0200u16 | (TOK_ARROW as u16); }
    if c == 61u8 && c2 == 62u8 { return 0x0200u16 | (TOK_FAT_ARROW as u16); }
    if c == 60u8 && c2 == 60u8 { return 0x0200u16 | (TOK_SHL as u16); }
    if c == 62u8 && c2 == 62u8 { return 0x0200u16 | (TOK_SHR as u16); }
    if c == 38u8 && c2 == 38u8 { return 0x0200u16 | (TOK_AMP_AMP as u16); }
    if c == 124u8 && c2 == 124u8 { return 0x0200u16 | (TOK_PIPE_PIPE as u16); }
    if c == 61u8 && c2 == 61u8 { return 0x0200u16 | (TOK_EQ_EQ as u16); }
    if c == 33u8 && c2 == 61u8 { return 0x0200u16 | (TOK_BANG_EQ as u16); }
    if c == 60u8 && c2 == 61u8 { return 0x0200u16 | (TOK_LT_EQ as u16); }
    if c == 62u8 && c2 == 61u8 { return 0x0200u16 | (TOK_GT_EQ as u16); }
    if c == 43u8 && c2 == 61u8 { return 0x0200u16 | (TOK_PLUS_EQ as u16); }
    if c == 45u8 && c2 == 61u8 { return 0x0200u16 | (TOK_MINUS_EQ as u16); }
    if c == 42u8 && c2 == 61u8 { return 0x0200u16 | (TOK_STAR_EQ as u16); }
    if c == 47u8 && c2 == 61u8 { return 0x0200u16 | (TOK_SLASH_EQ as u16); }
    if c == 37u8 && c2 == 61u8 { return 0x0200u16 | (TOK_PERCENT_EQ as u16); }
    if c == 38u8 && c2 == 61u8 { return 0x0200u16 | (TOK_AMP_EQ as u16); }
    if c == 124u8 && c2 == 61u8 { return 0x0200u16 | (TOK_PIPE_EQ as u16); }
    if c == 94u8 && c2 == 61u8 { return 0x0200u16 | (TOK_CARET_EQ as u16); }
    if c == 40u8 { return 0x0100u16 | (TOK_LPAREN as u16); }
    if c == 41u8 { return 0x0100u16 | (TOK_RPAREN as u16); }
    if c == 91u8 { return 0x0100u16 | (TOK_LBRACKET as u16); }
    if c == 93u8 { return 0x0100u16 | (TOK_RBRACKET as u16); }
    if c == 123u8 { return 0x0100u16 | (TOK_LBRACE as u16); }
    if c == 125u8 { return 0x0100u16 | (TOK_RBRACE as u16); }
    if c == 44u8 { return 0x0100u16 | (TOK_COMMA as u16); }
    if c == 59u8 { return 0x0100u16 | (TOK_SEMI as u16); }
    if c == 58u8 { return 0x0100u16 | (TOK_COLON as u16); }
    if c == 46u8 { return 0x0100u16 | (TOK_DOT as u16); }
    if c == 64u8 { return 0x0100u16 | (TOK_AT as u16); }
    if c == 63u8 { return 0x0100u16 | (TOK_QUESTION as u16); }
    if c == 43u8 { return 0x0100u16 | (TOK_PLUS as u16); }
    if c == 45u8 { return 0x0100u16 | (TOK_MINUS as u16); }
    if c == 42u8 { return 0x0100u16 | (TOK_STAR as u16); }
    if c == 47u8 { return 0x0100u16 | (TOK_SLASH as u16); }
    if c == 37u8 { return 0x0100u16 | (TOK_PERCENT as u16); }
    if c == 38u8 { return 0x0100u16 | (TOK_AMP as u16); }
    if c == 124u8 { return 0x0100u16 | (TOK_PIPE as u16); }
    if c == 94u8 { return 0x0100u16 | (TOK_CARET as u16); }
    if c == 126u8 { return 0x0100u16 | (TOK_TILDE as u16); }
    if c == 33u8 { return 0x0100u16 | (TOK_BANG as u16); }
    if c == 60u8 { return 0x0100u16 | (TOK_LT as u16); }
    if c == 62u8 { return 0x0100u16 | (TOK_GT as u16); }
    if c == 61u8 { return 0x0100u16 | (TOK_EQ as u16); }
    0u16
}

pub fn ax_lex_into(file: FileId, text: StrView, sink: mut_view<DiagSink>, interner: mut_view<StrInterner>, out: mut_view<LexResult>) {
    lex_result_init(mut_view(*out));
    let p = text.ptr;
    let byte_len = text.len;
    let mut init_pos: usize = 0;
    if byte_len >= 3 && (unsafe { *p }) == 0xEFu8 && (unsafe { *(p + 1) }) == 0xBBu8 && (unsafe { *(p + 2) }) == 0xBFu8 { init_pos = 3; }
    let mut cur = LexCursor { file_v: file.v, p: p, byte_len: byte_len, pos: init_pos, pending_nl: true, had_err: false };
    let mut last_kind: u8 = TOK_EOF;

    while (cur.pos) < byte_len {
        scan_whitespace_and_comments(mut_view(cur), mut_view(*sink), mut_view(*out));
        if cur.pos >= byte_len { break; }
        let flags: u16 = if cur.pending_nl { TOK_FLAG_NL_BEFORE } else { 0u16 };
        cur.pending_nl = false;
        let start = cur.pos as u32;
        let c = unsafe { *(p + cur.pos) };

        let dec = ax_utf8_decode(unsafe { p + cur.pos }, byte_len - cur.pos);
        if !dec.ok {
            emit_lex_diag(mut_view(*sink), AX_LEX_INVALID_UTF8, span_new(FileId { v: file.v }, start, start + (dec.byte_len as u32)));
            push_simple_token(mut_view(*out), TOK_ERROR, flags | TOK_FLAG_ERROR, span_new(FileId { v: file.v }, start, start + (dec.byte_len as u32)));
            last_kind = TOK_ERROR;
            cur.pos = cur.pos + dec.byte_len;
            continue;
        }

        if is_ident_start(c) {
            if c == 98u8 && cur.pos + 1 < byte_len && ((unsafe { *(p + cur.pos + 1) }) == 34u8 || (unsafe { *(p + cur.pos + 1) }) == 39u8) {
                cur.pos = cur.pos + 1;
                if (unsafe { *(p + cur.pos) }) == 34u8 {
                    cur.pos = cur.pos + 1;
                    scan_string_like(mut_view(cur), start, true, false, flags, mut_view(*sink), mut_view(*out));
                    last_kind = TOK_BYTE_STR;
                } else {
                    cur.pos = cur.pos + 1;
                    scan_char_like(mut_view(cur), start, true, flags, mut_view(*sink), mut_view(*out));
                    last_kind = TOK_INT;
                }
                continue;
            }
            if c == 114u8 && cur.pos + 1 < byte_len && (unsafe { *(p + cur.pos + 1) }) == 34u8 {
                cur.pos = cur.pos + 2;
                scan_string_like(mut_view(cur), start, false, true, flags, mut_view(*sink), mut_view(*out));
                last_kind = TOK_STR;
                continue;
            }
            while (cur.pos) < byte_len && is_ident_continue(unsafe { *(p + cur.pos) }) { cur.pos = cur.pos + 1; }
            let id_len = cur.pos - (start as usize);
            let kw = check_keyword(unsafe { p + (start as usize) }, id_len);
            let mut sid = StrId { v: 0u32 };
            if kw == TOK_IDENT { sid = interner_intern_bytes(mut_view(*interner), unsafe { p + (start as usize) }, id_len); }
            let tok = Token { kind: kw, suffix: SUFFIX_NONE, flags: flags, char_val: 0u32, span: span_new(FileId { v: file.v }, start, cur.pos as u32), int_val: 0u64, str_ptr: 0 as *const u8, str_len: 0, ident_val: sid };
            push_token(mut_view(*out), view(tok));
            last_kind = kw;
            continue;
        }

        if is_dec_digit(c) {
            scan_number(mut_view(cur), start, last_kind, flags, mut_view(*sink), mut_view(*out));
            last_kind = lex_token_get(view(*out), out.token_count - 1).kind;
            continue;
        }

        if c == 34u8 {
            cur.pos = cur.pos + 1;
            scan_string_like(mut_view(cur), start, false, false, flags, mut_view(*sink), mut_view(*out));
            last_kind = TOK_STR;
            continue;
        }

        if c == 39u8 {
            cur.pos = cur.pos + 1;
            if (cur.pos) < byte_len && is_ident_start(unsafe { *(p + cur.pos) }) {
                let word_start = cur.pos;
                while (cur.pos) < byte_len && is_ident_continue(unsafe { *(p + cur.pos) }) { cur.pos = cur.pos + 1; }
                if (cur.pos) < byte_len && (unsafe { *(p + cur.pos) }) == 39u8 {
                    cur.pos = (start as usize) + 1;
                    scan_char_like(mut_view(cur), start, false, flags, mut_view(*sink), mut_view(*out));
                    last_kind = TOK_CHAR;
                } else {
                    let sid = interner_intern_bytes(mut_view(*interner), unsafe { p + word_start }, cur.pos - word_start);
                    let tok = Token { kind: TOK_LABEL, suffix: SUFFIX_NONE, flags: flags, char_val: 0u32, span: span_new(FileId { v: file.v }, start, cur.pos as u32), int_val: 0u64, str_ptr: 0 as *const u8, str_len: 0, ident_val: sid };
                    push_token(mut_view(*out), view(tok));
                    last_kind = TOK_LABEL;
                }
            } else {
                scan_char_like(mut_view(cur), start, false, flags, mut_view(*sink), mut_view(*out));
                last_kind = TOK_CHAR;
            }
            continue;
        }

        if c == 58u8 && cur.pos + 1 < byte_len && (unsafe { *(p + cur.pos + 1) }) == 58u8 {
            emit_lex_diag_with_fix(mut_view(*sink), AX_LEX_COLON_COLON, span_new(FileId { v: file.v }, start, start + 2u32), 19);
            push_simple_token(mut_view(*out), TOK_DOT, flags | TOK_FLAG_ERROR, span_new(FileId { v: file.v }, start, start + 2u32));
            last_kind = TOK_DOT;
            cur.pos = cur.pos + 2;
            continue;
        }
        if c == 58u8 && cur.pos + 1 < byte_len && (unsafe { *(p + cur.pos + 1) }) == 61u8 {
            emit_lex_diag_with_fix(mut_view(*sink), AX_LEX_COLON_EQ, span_new(FileId { v: file.v }, start, start + 2u32), 20);
            push_simple_token(mut_view(*out), TOK_EQ, flags | TOK_FLAG_ERROR, span_new(FileId { v: file.v }, start, start + 2u32));
            last_kind = TOK_EQ;
            cur.pos = cur.pos + 2;
            continue;
        }

        let c2 = if cur.pos + 1 < byte_len { unsafe { *(p + cur.pos + 1) } } else { 0u8 };
        let c3 = if cur.pos + 2 < byte_len { unsafe { *(p + cur.pos + 2) } } else { 0u8 };

        if c == 46u8 && c2 == 46u8 && c3 == 46u8 {
            let mut dot_end = cur.pos + 3;
            while dot_end < byte_len && (unsafe { *(p + dot_end) }) == 46u8 { dot_end = dot_end + 1; }
            emit_lex_diag(mut_view(*sink), AX_LEX_INVALID_OPERATOR, span_new(FileId { v: file.v }, start, dot_end as u32));
            push_simple_token(mut_view(*out), TOK_ERROR, flags | TOK_FLAG_ERROR, span_new(FileId { v: file.v }, start, dot_end as u32));
            last_kind = TOK_ERROR;
            cur.pos = dot_end;
            continue;
        }

        let pm = match_punct(c, c2, c3);
        if pm != 0u16 {
            let pkind = (pm & 0xFFu16) as u8;
            let pstep = (pm >> 8u16) as usize;
            cur.pos = cur.pos + pstep;
            push_simple_token(mut_view(*out), pkind, flags, span_new(FileId { v: file.v }, start, cur.pos as u32));
            last_kind = pkind;
            continue;
        }

        if c >= 0x80u8 {
            let mut run_end = cur.pos + dec.byte_len;
            while run_end < byte_len {
                let next_dec = ax_utf8_decode(unsafe { p + run_end }, byte_len - run_end);
                if !next_dec.ok { break; }
                if next_dec.cp == 0xFEFFu32 || next_dec.cp == 0x2000u32 || next_dec.cp == 0x2001u32 || next_dec.cp == 0x2002u32 || next_dec.cp == 0x2003u32 || next_dec.cp == 0x3000u32 { break; }
                if next_dec.cp >= 0x80u32 || is_ident_continue(unsafe { *(p + run_end) }) { run_end = run_end + next_dec.byte_len; } else { break; }
            }
            if dec.cp == 0xFEFFu32 || dec.cp == 0xA0u32 || dec.cp == 0x2000u32 || dec.cp == 0x2001u32 || dec.cp == 0x2002u32 || dec.cp == 0x2003u32 || dec.cp == 0x3000u32 {
                cur.pos = cur.pos + dec.byte_len;
                emit_lex_diag(mut_view(*sink), AX_LEX_INVALID_CHAR, span_new(FileId { v: file.v }, start, cur.pos as u32));
            } else {
                cur.pos = run_end;
                emit_lex_diag(mut_view(*sink), AX_LEX_NON_ASCII_IDENT, span_new(FileId { v: file.v }, start, cur.pos as u32));
            }
            push_simple_token(mut_view(*out), TOK_ERROR, flags | TOK_FLAG_ERROR, span_new(FileId { v: file.v }, start, cur.pos as u32));
            last_kind = TOK_ERROR;
            continue;
        }

        cur.pos = cur.pos + 1;
        emit_lex_diag(mut_view(*sink), AX_LEX_INVALID_CHAR, span_new(FileId { v: file.v }, start, cur.pos as u32));
        push_simple_token(mut_view(*out), TOK_ERROR, flags | TOK_FLAG_ERROR, span_new(FileId { v: file.v }, start, cur.pos as u32));
        last_kind = TOK_ERROR;
    }

    let eof_flags: u16 = if cur.pending_nl { TOK_FLAG_NL_BEFORE } else { 0u16 };
    push_simple_token(mut_view(*out), TOK_EOF, eof_flags, span_new(FileId { v: file.v }, byte_len as u32, byte_len as u32));
}


pub fn session_lex_file(sess: mut_view<CompilerSession>, fid: FileId, out: mut_view<LexResult>) {
    let text = session_file_text(view(*sess), FileId { v: fid.v });
    ax_lex_into(FileId { v: fid.v }, text, mut_view(sess.diag_sink), mut_view(sess.interner), out);
}

pub fn session_lex_virtual_file(sess: mut_view<CompilerSession>, path: StrView, text: StrView, out: mut_view<LexResult>) -> FileId {
    let fid = session_add_virtual_file(mut_view(*sess), path, text);
    let stored_text = session_file_text(view(*sess), FileId { v: fid.v });
    ax_lex_into(FileId { v: fid.v }, stored_text, mut_view(sess.diag_sink), mut_view(sess.interner), out);
    FileId { v: fid.v }
}

pub fn session_render_tokens(sess: view<CompilerSession>, res: view<LexResult>) -> DiagBuffer {
    let mut buf = diag_buf_new();
    ax_lex_render_tokens(res, view(sess.interner), mut_view(buf));
    buf
}

pub fn session_render_tokens_into(sess: view<CompilerSession>, res: view<LexResult>, out: mut_view<DiagBuffer>) {
    ax_lex_render_tokens(res, view(sess.interner), out);
}

pub fn session_lex_and_render_human(
    sess: mut_view<CompilerSession>,
    path: StrView,
    text: StrView,
    out_tokens: mut_view<DiagBuffer>,
    out_diags: mut_view<DiagBuffer>
) -> usize {
    let mut res = LexResult {
        arena: arena_new(),
        tokens: 0 as *mut Token,
        token_count: 0,
        token_cap: 0,
        comments: 0 as *mut Comment,
        comment_count: 0,
        comment_cap: 0,
    };
    let _fid = session_lex_virtual_file(mut_view(*sess), path, text, mut_view(res));
    ax_lex_render_tokens(view(res), view(sess.interner), out_tokens);
    ax_lex_result_free(mut_view(res));
    ax_diag_render_human(view(sess.diag_sink), view(sess.source_db), out_diags);
    session_error_count(view(*sess))
}

pub fn session_lex_and_render_json(
    sess: mut_view<CompilerSession>,
    path: StrView,
    text: StrView,
    out_tokens: mut_view<DiagBuffer>,
    out_json: mut_view<DiagBuffer>
) -> usize {
    let mut res = LexResult {
        arena: arena_new(),
        tokens: 0 as *mut Token,
        token_count: 0,
        token_cap: 0,
        comments: 0 as *mut Comment,
        comment_count: 0,
        comment_cap: 0,
    };
    let _fid = session_lex_virtual_file(mut_view(*sess), path, text, mut_view(res));
    ax_lex_render_tokens(view(res), view(sess.interner), out_tokens);
    ax_lex_result_free(mut_view(res));
    ax_diag_render_json(view(sess.diag_sink), view(sess.source_db), out_json);
    session_error_count(view(*sess))
}


@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }












