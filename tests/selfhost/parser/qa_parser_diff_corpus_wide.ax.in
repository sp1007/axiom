fn qa_sv_eq(a: StrView, b: StrView) -> bool {
    if a.len != b.len {
        return false;
    }
    test_bytes_eq(a.ptr, b.ptr, a.len)
}

fn run_and_verify_session_parse(
    sess: mut_view<CompilerSession>,
    parse_arena: mut_view<Arena>,
    out_ast: mut_view<DiagBuffer>,
    out_err: mut_view<DiagBuffer>,
    path_sv: StrView,
    src_sv: StrView,
    exp_ast_sv: StrView,
    exp_err_sv: StrView,
    expect_err: bool
) -> bool {
    session_init(mut_view(*sess));
    let errs = session_parse_and_render_human(
        mut_view(*sess),
        mut_view(*parse_arena),
        path_sv,
        src_sv,
        mut_view(*out_ast),
        mut_view(*out_err)
    );
    let mut ok = true;
    if expect_err {
        if errs == 0 {
            ok = false;
        }
    } else {
        if errs != 0 {
            ok = false;
        }
    }
    if !qa_sv_eq(diag_buf_as_str_view(view(*out_ast)), exp_ast_sv) {
        ok = false;
    }
    if !qa_sv_eq(diag_buf_as_str_view(view(*out_err)), exp_err_sv) {
        ok = false;
    }
    diag_buf_free(mut_view(*out_ast));
    diag_buf_free(mut_view(*out_err));
    arena_destroy(mut_view(*parse_arena));
    session_free(mut_view(*sess));
    ok
}

fn get_sv(a: mut_view<Arena>, c_data: view<[21258]u8>, c_off: view<[101]u32>, blob_idx: usize) -> StrView {
    let start = (*c_off)[blob_idx] as usize;
    let end = (*c_off)[blob_idx + 1] as usize;
    let n = end - start;
    let dst = arena_alloc_raw(a, n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe {
            *(dst + i) = (*c_data)[start + i];
        }
        i = i + 1;
    }
    unsafe {
        *(dst + n) = 0u8;
    }
    StrView { ptr: dst as *const u8, len: n }
}

fn verify_case(
    sess: mut_view<CompilerSession>,
    parse_arena: mut_view<Arena>,
    out_ast: mut_view<DiagBuffer>,
    out_err: mut_view<DiagBuffer>,
    scratch: mut_view<Arena>,
    c_data: view<[21258]u8>,
    c_off: view<[101]u32>,
    case_idx: usize,
    expect_err: bool
) -> bool {
    let base = case_idx * 4;
    let path_sv = get_sv(mut_view(*scratch), c_data, c_off, base);
    let src_sv = get_sv(mut_view(*scratch), c_data, c_off, base + 1);
    let exp_ast_sv = get_sv(mut_view(*scratch), c_data, c_off, base + 2);
    let exp_err_sv = get_sv(mut_view(*scratch), c_data, c_off, base + 3);
    run_and_verify_session_parse(
        mut_view(*sess),
        mut_view(*parse_arena),
        mut_view(*out_ast),
        mut_view(*out_err),
        path_sv,
        src_sv,
        exp_ast_sv,
        exp_err_sv,
        expect_err
    )
}

pub fn main() -> i32 {
    let mut scratch = arena_new();
    let mut sess = session_new();
    let mut parse_arena = arena_new();
    let mut out_ast = diag_buf_new();
    let mut out_err = diag_buf_new();
    let c_data = CORPUS_DATA;
    let c_off = CORPUS_OFF;
    if !verify_case(mut_view(sess), mut_view(parse_arena), mut_view(out_ast), mut_view(out_err), mut_view(scratch), view(c_data), view(c_off), 0, false) { return 10; }
    if !verify_case(mut_view(sess), mut_view(parse_arena), mut_view(out_ast), mut_view(out_err), mut_view(scratch), view(c_data), view(c_off), 1, false) { return 11; }
    if !verify_case(mut_view(sess), mut_view(parse_arena), mut_view(out_ast), mut_view(out_err), mut_view(scratch), view(c_data), view(c_off), 2, false) { return 12; }
