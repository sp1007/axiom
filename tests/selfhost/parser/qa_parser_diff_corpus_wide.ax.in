    if !verify_case(mut_view(sess), mut_view(parse_arena), mut_view(out_ast), mut_view(out_err), mut_view(scratch), view(c_data), view(c_off), 6, false) { return 16; }
    if !verify_case(mut_view(sess), mut_view(parse_arena), mut_view(out_ast), mut_view(out_err), mut_view(scratch), view(c_data), view(c_off), 7, false) { return 17; }
    if !verify_case(mut_view(sess), mut_view(parse_arena), mut_view(out_ast), mut_view(out_err), mut_view(scratch), view(c_data), view(c_off), 8, false) { return 18; }
    if !verify_case(mut_view(sess), mut_view(parse_arena), mut_view(out_ast), mut_view(out_err), mut_view(scratch), view(c_data), view(c_off), 9, true) { return 19; }
    if !verify_case(mut_view(sess), mut_view(parse_arena), mut_view(out_ast), mut_view(out_err), mut_view(scratch), view(c_data), view(c_off), 10, true) { return 20; }
    if !verify_case(mut_view(sess), mut_view(parse_arena), mut_view(out_ast), mut_view(out_err), mut_view(scratch), view(c_data), view(c_off), 11, true) { return 21; }
    if !verify_case(mut_view(sess), mut_view(parse_arena), mut_view(out_ast), mut_view(out_err), mut_view(scratch), view(c_data), view(c_off), 12, true) { return 22; }
    if !verify_case(mut_view(sess), mut_view(parse_arena), mut_view(out_ast), mut_view(out_err), mut_view(scratch), view(c_data), view(c_off), 13, true) { return 23; }
    if !verify_case(mut_view(sess), mut_view(parse_arena), mut_view(out_ast), mut_view(out_err), mut_view(scratch), view(c_data), view(c_off), 14, true) { return 24; }
    if !verify_case(mut_view(sess), mut_view(parse_arena), mut_view(out_ast), mut_view(out_err), mut_view(scratch), view(c_data), view(c_off), 15, false) { return 25; }
    if !verify_case(mut_view(sess), mut_view(parse_arena), mut_view(out_ast), mut_view(out_err), mut_view(scratch), view(c_data), view(c_off), 16, false) { return 26; }
    if !verify_case(mut_view(sess), mut_view(parse_arena), mut_view(out_ast), mut_view(out_err), mut_view(scratch), view(c_data), view(c_off), 17, false) { return 27; }
    if !verify_case(mut_view(sess), mut_view(parse_arena), mut_view(out_ast), mut_view(out_err), mut_view(scratch), view(c_data), view(c_off), 18, false) { return 28; }
    if !verify_case(mut_view(sess), mut_view(parse_arena), mut_view(out_ast), mut_view(out_err), mut_view(scratch), view(c_data), view(c_off), 19, false) { return 29; }
    if !verify_case(mut_view(sess), mut_view(parse_arena), mut_view(out_ast), mut_view(out_err), mut_view(scratch), view(c_data), view(c_off), 20, false) { return 30; }
    if !verify_case(mut_view(sess), mut_view(parse_arena), mut_view(out_ast), mut_view(out_err), mut_view(scratch), view(c_data), view(c_off), 21, false) { return 31; }
    if !verify_case(mut_view(sess), mut_view(parse_arena), mut_view(out_ast), mut_view(out_err), mut_view(scratch), view(c_data), view(c_off), 22, false) { return 32; }
