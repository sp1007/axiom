const CORPUS_OFF: [8]u32 = [
    0u32, 8u32, 67u32, 259u32, 267u32, 351u32, 810u32, 821u32,
];

fn qa_sv_eq(a: StrView, b: StrView) -> bool {
    if a.len != b.len {
        return false;
    }
    test_bytes_eq(a.ptr, b.ptr, a.len)
}

fn get_sv(a: mut_view<Arena>, c_data: view<[821]u8>, c_off: view<[8]u32>, blob_idx: usize) -> StrView {
    let start = (*c_off)[blob_idx] as usize;
    let end = (*c_off)[blob_idx + 1] as usize;
    let n = end - start;
    let dst = arena_alloc_raw(a, n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe {
            *(dst + i) = (*c_data)[start + i];
        }
        i = i + 1;
    }
    unsafe {
        *(dst + n) = 0u8;
    }
    StrView { ptr: dst as *const u8, len: n }
}

fn run_integration(
    sess: mut_view<CompilerSession>,
    parse_arena: mut_view<Arena>,
    out_ast1: mut_view<DiagBuffer>,
    out_ast2: mut_view<DiagBuffer>,
    scratch: mut_view<Arena>,
    c_data: view<[821]u8>,
    c_off: view<[8]u32>
) -> i32 {
    session_init(mut_view(*sess));
    let f1_path = get_sv(mut_view(*scratch), c_data, c_off, 0);
    let f1_src = get_sv(mut_view(*scratch), c_data, c_off, 1);
    let f1_exp = get_sv(mut_view(*scratch), c_data, c_off, 2);
    let f2_path = get_sv(mut_view(*scratch), c_data, c_off, 3);
    let f2_src = get_sv(mut_view(*scratch), c_data, c_off, 4);
    let f2_exp = get_sv(mut_view(*scratch), c_data, c_off, 5);
    let sp_name = get_sv(mut_view(*scratch), c_data, c_off, 6);

    let fid1 = session_add_virtual_file(mut_view(*sess), test_copy_sv(view(f1_path)), test_copy_sv(view(f1_src)));
    let pres1 = session_parse_file(mut_view(*sess), mut_view(*parse_arena), FileId { v: fid1.v });

    let mut fid2 = FileId { v: 0u32 };
    let pres2 = session_parse_virtual_file(
        mut_view(*sess),
        mut_view(*parse_arena),
        f2_path,
        f2_src,
        mut_view(fid2)
    );

    if fid1.v != 1u32 || fid2.v != 2u32 {
        return 10;
    }
    if session_file_count(view(*sess)) != 2 {
        return 11;
    }
    if session_has_errors(view(*sess)) {
        return 12;
    }

    session_render_ast_into(view(*sess), view(pres1.ast), FileId { v: fid1.v }, mut_view(*out_ast1));
    session_render_ast_into(view(*sess), view(pres2.ast), FileId { v: fid2.v }, mut_view(*out_ast2));

    if !qa_sv_eq(diag_buf_as_str_view(view(*out_ast1)), test_copy_sv(view(f1_exp))) {
        return 13;
    }
    if !qa_sv_eq(diag_buf_as_str_view(view(*out_ast2)), f2_exp) {
        return 14;
    }

    // Verify SharedPoint was interned to the exact same StrId across both files
    let sp_id = session_lookup_str(view(*sess), sp_name);
    if sp_id.v == 0u32 {
        return 15;
    }
    let item1_name = unsafe { (*pres1.ast.items).name };
    if item1_name.v != sp_id.v {
        return 16;
    }

    // Verify filter_file excludes items from a different file
    diag_buf_free(mut_view(*out_ast1));
    session_render_ast_into(view(*sess), view(pres1.ast), FileId { v: fid2.v }, mut_view(*out_ast1));
    if diag_buf_as_str_view(view(*out_ast1)).len != 1 {
        return 17;
    }

    // Verify session_parse_tokens
    let mut lex_res = LexResult {
        arena: arena_new(),
        tokens: 0 as *mut Token,
        token_count: 0,
        token_cap: 0,
        comments: 0 as *mut Comment,
        comment_count: 0,
        comment_cap: 0,
    };
    session_lex_file(mut_view(*sess), FileId { v: fid1.v }, mut_view(lex_res));
    let pres_tok = session_parse_tokens(
        mut_view(*sess),
        mut_view(*parse_arena),
        lex_res.tokens,
        lex_res.token_count
    );
    ax_lex_result_free(mut_view(lex_res));
    diag_buf_free(mut_view(*out_ast1));
    session_render_ast_into(view(*sess), view(pres_tok.ast), FileId { v: fid1.v }, mut_view(*out_ast1));
    if !qa_sv_eq(diag_buf_as_str_view(view(*out_ast1)), test_copy_sv(view(f1_exp))) {
        return 19;
    }

    // Verify session_parse_and_render_json on clean file produces valid JSON envelope
    diag_buf_free(mut_view(*out_ast1));
    diag_buf_free(mut_view(*out_ast2));
    let json_errs = session_parse_and_render_json(
        mut_view(*sess),
        mut_view(*parse_arena),
        test_copy_sv(view(f1_path)),
        test_copy_sv(view(f1_src)),
        mut_view(*out_ast1),
        mut_view(*out_ast2)
    );
    if json_errs != 0 || diag_buf_as_str_view(view(*out_ast2)).len == 0 {
        return 20;
    }

    diag_buf_free(mut_view(*out_ast1));
    diag_buf_free(mut_view(*out_ast2));
    arena_destroy(mut_view(*parse_arena));
    session_free(mut_view(*sess));
    0
}

pub fn main() -> i32 {
    let mut scratch = arena_new();
    let mut sess = session_new();
    let mut parse_arena = arena_new();
    let mut out_ast1 = diag_buf_new();
    let mut out_ast2 = diag_buf_new();
    let c_data = CORPUS_DATA;
    let c_off = CORPUS_OFF;
    let rc = run_integration(
        mut_view(sess),
        mut_view(parse_arena),
        mut_view(out_ast1),
        mut_view(out_ast2),
        mut_view(scratch),
        view(c_data),
        view(c_off)
    );
    arena_destroy(mut_view(scratch));
    if rc != 0 {
        return rc;
    }
    print("OK Parser Session Integration\n");
    0
}
