// test: run
// timeout: 600
// stdout: OK Own Cap\n

module main

use host_intrinsics.heap_alloc
use host_intrinsics.heap_free
use host_intrinsics.exit
use compiler.diag.code.AX_CAP_CONFLICT_MUT
use compiler.diag.code.AX_CAP_CONFLICT_READ
use compiler.diag.code.AX_CAP_OUTLIVES_OWNER
use compiler.kernel.arena.Arena
use compiler.diag.emitter.DiagSink
use compiler.diag.emitter.Diagnostic
use compiler.kernel.id.FileId
use compiler.mir.mir.MIR_BORROW_MUT
use compiler.mir.mir.MIR_BORROW_SHARED
use compiler.mir.mir.MIR_LOCAL_USER
use compiler.mir.mir.MIR_OP_COPY
use compiler.mir.mir.MIR_PROJ_FIELD
use compiler.mir.mir.MIR_PROJ_SUB_SLICE
use compiler.mir.mir.MIR_REGION_CONTAINS
use compiler.mir.mir.MIR_REGION_DISJOINT
use compiler.mir.mir.MIR_REGION_OVERLAPS
use compiler.mir.mir.MIR_REGION_SAME
use compiler.mir.mir.MIR_RVALUE_REF
use compiler.mir.mir.MIR_RVALUE_USE
use compiler.mir.mir.MIR_STMT_ASSIGN
use compiler.mir.mir.MIR_TERM_RETURN
use compiler.mir.mir.MIR_VIEW_MUT
use compiler.mir.mir.MIR_VIEW_READ
use compiler.mir.mir.MirBb
use compiler.mir.mir.MirBbId
use compiler.mir.mir.MirBody
use compiler.mir.mir.MirLocalDecl
use compiler.mir.mir.MirLocalId
use compiler.mir.mir.MirPlace
use compiler.mir.mir.MirProjection
use compiler.mir.mir.MirStmt
use compiler.source.span.Span
use compiler.kernel.arena.arena_alloc_raw
use compiler.kernel.arena.arena_destroy
use compiler.kernel.arena.arena_new
