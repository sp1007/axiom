use compiler.mir.mir.mir_bb_reset
use compiler.own.cap.mir_cap_tracker_add
use compiler.own.cap.mir_cap_tracker_check_conflict
use compiler.own.cap.mir_cap_tracker_new
use compiler.own.cap.mir_cap_tracker_pop
