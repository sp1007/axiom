fn mir_push_str(out: mut_view<DiagBuffer>, off: usize, count: usize) {
    let mut i: usize = 0;
    while (i < count) {
        diag_buf_push_byte(mut_view(*out), MIR_STR_TABLE[off + i]);
        i = i + 1;
    }
}

pub fn mir_buf_push_u64(buf: mut_view<DiagBuffer>, val: u64) {
    if val == 0u64 {
        diag_buf_push_byte(mut_view(*buf), 48u8);
        return;
    }
    let mut digits: [20]u8 = [0u8; 20];
    let mut dlen: usize = 0;
    let mut n: u64 = val;
    while n > 0u64 {
        digits[dlen] = (48u64 + (n % 10u64)) as u8;
        n = n / 10u64;
        dlen = dlen + 1;
    }
    while dlen > 0 {
        dlen = dlen - 1;
        diag_buf_push_byte(mut_view(*buf), digits[dlen]);
    }
}

fn mir_hex_digit(v: u8) -> u8 {
    if v < 10u8 {
        48u8 + v
    } else {
        87u8 + v
    }
}

fn mir_push_spaces(out: mut_view<DiagBuffer>, count: usize) {
    let mut i: usize = 0;
    while (i < count) {
        diag_buf_push_byte(mut_view(*out), 32u8);
        i = i + 1;
    }
}

fn mir_print_place_inner(out: mut_view<DiagBuffer>, place: view<MirPlace>, proj_count: usize) {
    if proj_count == 0 {
        diag_buf_push_byte(mut_view(*out), 95u8);
        diag_buf_push_u32(mut_view(*out), place.local.v);
        return;
    }
    let last = unsafe {
        mir_proj_at(place.projs, proj_count - 1)
    };
    let k = unsafe {
        (*last).kind
    };
    if k == MIR_PROJ_DEREF {
        diag_buf_push_byte(mut_view(*out), 40u8);
        diag_buf_push_byte(mut_view(*out), 42u8);
        mir_print_place_inner(mut_view(*out), place, proj_count - 1);
        diag_buf_push_byte(mut_view(*out), 41u8);
    } else if k == MIR_PROJ_FIELD {
        let fidx = unsafe {
            (*last).field_idx
        };
        diag_buf_push_byte(mut_view(*out), 40u8);
        mir_print_place_inner(mut_view(*out), place, proj_count - 1);
        diag_buf_push_byte(mut_view(*out), 41u8);
        diag_buf_push_byte(mut_view(*out), 46u8);
        diag_buf_push_u32(mut_view(*out), fidx);
    } else if k == MIR_PROJ_INDEX {
        let iloc = unsafe {
            (*last).index_local.v
        };
        diag_buf_push_byte(mut_view(*out), 40u8);
        mir_print_place_inner(mut_view(*out), place, proj_count - 1);
        diag_buf_push_byte(mut_view(*out), 41u8);
        diag_buf_push_byte(mut_view(*out), 91u8);
        diag_buf_push_byte(mut_view(*out), 95u8);
        diag_buf_push_u32(mut_view(*out), iloc);
        diag_buf_push_byte(mut_view(*out), 93u8);
    } else if k == MIR_PROJ_SUB_SLICE {
        diag_buf_push_byte(mut_view(*out), 40u8);
        mir_print_place_inner(mut_view(*out), place, proj_count - 1);
        diag_buf_push_byte(mut_view(*out), 41u8);
        diag_buf_push_byte(mut_view(*out), 91u8);
        let hf = unsafe {
            (*last).has_from
        };
        if hf {
            let fl = unsafe {
                (*last).from_local.v
            };
            diag_buf_push_byte(mut_view(*out), 95u8);
            diag_buf_push_u32(mut_view(*out), fl);
        }
        diag_buf_push_byte(mut_view(*out), 46u8);
        diag_buf_push_byte(mut_view(*out), 46u8);
        let ht = unsafe {
            (*last).has_to
        };
        if ht {
            let tl = unsafe {
                (*last).to_local.v
            };
            diag_buf_push_byte(mut_view(*out), 95u8);
            diag_buf_push_u32(mut_view(*out), tl);
        }
        diag_buf_push_byte(mut_view(*out), 93u8);
    } else if k == MIR_PROJ_DOWNCAST {
        let vidx = unsafe {
            (*last).variant_idx
        };
        diag_buf_push_byte(mut_view(*out), 40u8);
        mir_print_place_inner(mut_view(*out), place, proj_count - 1);
        mir_push_str(mut_view(*out), 0, 12);
        diag_buf_push_u32(mut_view(*out), vidx);
        diag_buf_push_byte(mut_view(*out), 41u8);
    }
}

pub fn mir_print_place(out: mut_view<DiagBuffer>, place: view<MirPlace>) {
    mir_print_place_inner(mut_view(*out), place, place.proj_count);
    let df: u32 = place.drop_flag;
    if df != MIR_DROP_FLAG_NONE {
        mir_push_str(mut_view(*out), 12, 12);
        diag_buf_push_u32(mut_view(*out), df);
        diag_buf_push_byte(mut_view(*out), 41u8);
    }
}

pub fn mir_print_operand(out: mut_view<DiagBuffer>, op: view<MirOperand>) {
    if op.kind == MIR_OP_COPY {
        mir_push_str(mut_view(*out), 24, 5);
        mir_print_place(mut_view(*out), view(op.place));
    } else if op.kind == MIR_OP_MOVE {
        mir_push_str(mut_view(*out), 29, 5);
        mir_print_place(mut_view(*out), view(op.place));
    } else if op.kind == MIR_OP_CONST {
        if op.constant.kind == MIR_CONST_STR {
            mir_push_str(mut_view(*out), 34, 7);
            let mut i: usize = 0;
            while (i < op.constant.str_len) {
                let c = unsafe {
                    *(op.constant.str_bytes + i)
                };
                if c == 34u8 {
                    diag_buf_push_byte(mut_view(*out), 92u8);
                    diag_buf_push_byte(mut_view(*out), 34u8);
                } else if c == 92u8 {
                    diag_buf_push_byte(mut_view(*out), 92u8);
                    diag_buf_push_byte(mut_view(*out), 92u8);
                } else if c == 10u8 {
                    diag_buf_push_byte(mut_view(*out), 92u8);
                    diag_buf_push_byte(mut_view(*out), 110u8);
                } else if c == 13u8 {
                    diag_buf_push_byte(mut_view(*out), 92u8);
                    diag_buf_push_byte(mut_view(*out), 114u8);
                } else if c == 9u8 {
                    diag_buf_push_byte(mut_view(*out), 92u8);
                    diag_buf_push_byte(mut_view(*out), 116u8);
                } else if c >= 32u8 && c < 127u8 {
                    diag_buf_push_byte(mut_view(*out), c);
                } else {
                    diag_buf_push_byte(mut_view(*out), 92u8);
                    diag_buf_push_byte(mut_view(*out), 120u8);
                    diag_buf_push_byte(mut_view(*out), mir_hex_digit((c >> 4u8) & 15u8));
                    diag_buf_push_byte(mut_view(*out), mir_hex_digit(c & 15u8));
                }
                i = i + 1;
            }
            diag_buf_push_byte(mut_view(*out), 34u8);
        } else {
            mir_push_str(mut_view(*out), 41, 6);
            mir_buf_push_u64(mut_view(*out), op.constant.val);
        }
    }
}

pub fn mir_print_binop(out: mut_view<DiagBuffer>, op: u8) {
    if op == MIR_BINOP_ADD {
        diag_buf_push_byte(mut_view(*out), 43u8);
    } else if op == MIR_BINOP_SUB {
        diag_buf_push_byte(mut_view(*out), 45u8);
    } else if op == MIR_BINOP_MUL {
        diag_buf_push_byte(mut_view(*out), 42u8);
    } else if op == MIR_BINOP_DIV {
        diag_buf_push_byte(mut_view(*out), 47u8);
    } else if op == MIR_BINOP_REM {
        diag_buf_push_byte(mut_view(*out), 37u8);
    } else if op == MIR_BINOP_BIT_XOR {
        diag_buf_push_byte(mut_view(*out), 94u8);
    } else if op == MIR_BINOP_BIT_AND {
        diag_buf_push_byte(mut_view(*out), 38u8);
    } else if op == MIR_BINOP_BIT_OR {
        diag_buf_push_byte(mut_view(*out), 124u8);
    } else if op == MIR_BINOP_SHL {
        mir_push_str(mut_view(*out), 47, 2);
    } else if op == MIR_BINOP_SHR {
        mir_push_str(mut_view(*out), 49, 2);
    } else if op == MIR_BINOP_EQ {
        mir_push_str(mut_view(*out), 51, 2);
    } else if op == MIR_BINOP_LT {
        diag_buf_push_byte(mut_view(*out), 60u8);
    } else if op == MIR_BINOP_LE {
        mir_push_str(mut_view(*out), 53, 2);
    } else if op == MIR_BINOP_NE {
        mir_push_str(mut_view(*out), 55, 2);
    } else if op == MIR_BINOP_GE {
        mir_push_str(mut_view(*out), 57, 2);
    } else if op == MIR_BINOP_GT {
        diag_buf_push_byte(mut_view(*out), 62u8);
    } else if op == MIR_BINOP_OFFSET {
        mir_push_str(mut_view(*out), 59, 6);
    } else {
        diag_buf_push_byte(mut_view(*out), 63u8);
    }
}

pub fn mir_print_rvalue(out: mut_view<DiagBuffer>, rv: view<MirRvalue>) {
    if rv.kind == MIR_RVALUE_USE {
        mir_print_operand(mut_view(*out), view(rv.use_op));
    } else if rv.kind == MIR_RVALUE_REPEAT {
        diag_buf_push_byte(mut_view(*out), 91u8);
        mir_print_operand(mut_view(*out), view(rv.use_op));
        mir_push_str(mut_view(*out), 65, 2);
        if (rv.repeat_count_op as usize) != 0 {
            unsafe {
                mir_print_operand(mut_view(*out), view(*rv.repeat_count_op));
            }
        } else {
            mir_push_str(mut_view(*out), 41, 6);
            mir_buf_push_u64(mut_view(*out), rv.repeat_count);
        }
        diag_buf_push_byte(mut_view(*out), 93u8);
    } else if rv.kind == MIR_RVALUE_REF {
        if rv.borrow_kind == MIR_BORROW_SHARED {
            diag_buf_push_byte(mut_view(*out), 38u8);
        } else {
            mir_push_str(mut_view(*out), 67, 5);
        }
        mir_print_place(mut_view(*out), view(rv.place));
    } else if rv.kind == MIR_RVALUE_LEN {
        diag_buf_push_byte(mut_view(*out), 108u8);
        diag_buf_push_byte(mut_view(*out), 101u8);
        diag_buf_push_byte(mut_view(*out), 110u8);
        diag_buf_push_byte(mut_view(*out), 40u8);
        mir_print_place(mut_view(*out), view(rv.place));
        diag_buf_push_byte(mut_view(*out), 41u8);
    } else if rv.kind == MIR_RVALUE_CAST {
        mir_print_operand(mut_view(*out), view(rv.use_op));
        mir_push_str(mut_view(*out), 76, 9);
        diag_buf_push_u32(mut_view(*out), rv.target_ty.v);
    } else if rv.kind == MIR_RVALUE_BINARY_OP {
        if rv.bin_op == MIR_BINOP_OFFSET {
            mir_push_str(mut_view(*out), 59, 6);
            diag_buf_push_byte(mut_view(*out), 40u8);
            mir_print_operand(mut_view(*out), view(rv.lhs));
            mir_push_str(mut_view(*out), 133, 2);
            mir_print_operand(mut_view(*out), view(rv.rhs));
            diag_buf_push_byte(mut_view(*out), 41u8);
        } else {
            mir_print_operand(mut_view(*out), view(rv.lhs));
            diag_buf_push_byte(mut_view(*out), 32u8);
            mir_print_binop(mut_view(*out), rv.bin_op);
            diag_buf_push_byte(mut_view(*out), 32u8);
            mir_print_operand(mut_view(*out), view(rv.rhs));
        }
    } else if rv.kind == MIR_RVALUE_OVERFLOWS_BINARY_OP {
        diag_buf_push_byte(mut_view(*out), 111u8);
        mir_push_str(mut_view(*out), 136, 9);
        mir_print_operand(mut_view(*out), view(rv.lhs));
        diag_buf_push_byte(mut_view(*out), 32u8);
        mir_print_binop(mut_view(*out), rv.bin_op);
        diag_buf_push_byte(mut_view(*out), 32u8);
        mir_print_operand(mut_view(*out), view(rv.rhs));
        diag_buf_push_byte(mut_view(*out), 41u8);
    } else if rv.kind == MIR_RVALUE_UNARY_OP {
        if rv.un_op == MIR_UNOP_NOT {
            diag_buf_push_byte(mut_view(*out), 33u8);
        } else if rv.un_op == MIR_UNOP_NEG {
            diag_buf_push_byte(mut_view(*out), 45u8);
        } else if rv.un_op == MIR_UNOP_BITNOT {
            diag_buf_push_byte(mut_view(*out), 126u8);
        } else {
            diag_buf_push_byte(mut_view(*out), 63u8);
        }
        mir_print_operand(mut_view(*out), view(rv.use_op));
    } else if rv.kind == MIR_RVALUE_DISCRIMINANT {
        mir_push_str(mut_view(*out), 145, 13);
        mir_print_place(mut_view(*out), view(rv.place));
        diag_buf_push_byte(mut_view(*out), 41u8);
    } else if rv.kind == MIR_RVALUE_AGGREGATE {
        diag_buf_push_byte(mut_view(*out), 97u8);
        mir_push_str(mut_view(*out), 159, 17);
        diag_buf_push_u32(mut_view(*out), rv.variant_idx);
        mir_push_str(mut_view(*out), 133, 2);
        diag_buf_push_byte(mut_view(*out), 91u8);
        let mut i: usize = 0;
        while (i < rv.operand_count) {
            if i > 0 {
                mir_push_str(mut_view(*out), 133, 2);
            }
            let op = unsafe {
                mir_op_at(rv.operands, i)
            };
            unsafe {
                mir_print_operand(mut_view(*out), view(*op));
            }
            i = i + 1;
        }
        diag_buf_push_byte(mut_view(*out), 93u8);
        diag_buf_push_byte(mut_view(*out), 41u8);
    }
}

fn mir_push_return_unwind(out: mut_view<DiagBuffer>, ret_bb: u32, unw_bb: u32) {
    // " -> [return: bb"
    mir_push_str(mut_view(*out), 362, 5);
    mir_push_str(mut_view(*out), 206, 6);
    mir_push_str(mut_view(*out), 367, 4);
    diag_buf_push_u32(mut_view(*out), ret_bb);
    // ", unwind: bb"
    mir_push_str(mut_view(*out), 133, 2);
    diag_buf_push_byte(mut_view(*out), 117u8);
    diag_buf_push_byte(mut_view(*out), 110u8);
    diag_buf_push_byte(mut_view(*out), 119u8);
    diag_buf_push_byte(mut_view(*out), 105u8);
    diag_buf_push_byte(mut_view(*out), 110u8);
    diag_buf_push_byte(mut_view(*out), 100u8);
    mir_push_str(mut_view(*out), 367, 4);
    diag_buf_push_u32(mut_view(*out), unw_bb);
    mir_push_str(mut_view(*out), 384, 3);
}

pub fn mir_print_ext(out: mut_view<DiagBuffer>, body: view<MirBody>, interner: *const TypeInterner) {
    mir_push_str(mut_view(*out), 176, 11);
    if (interner as usize) != 0 {
        let mut ti_idx: usize = 0;
        while (ti_idx < body.local_count) {
            let decl_i = unsafe {
                mir_local_at(body.locals, ti_idx)
            };
            let tid_v = unsafe {
                (*decl_i).ty.v
            };
            let ty_ptr = unsafe {
                type_get(view(*interner), TypeId {
                    v: tid_v
                })
            };
            if (ty_ptr as usize) != 0 && (unsafe { (*ty_ptr).kind }) == TY_FN {
                let mut already: bool = false;
                let mut prev: usize = 0;
                while (prev < ti_idx) {
                    let decl_p = unsafe {
                        mir_local_at(body.locals, prev)
                    };
                    if (unsafe { (*decl_p).ty.v }) == tid_v {
                        already = true;
                        break;
                    }
                    prev = prev + 1;
                }
                if !already {
                    mir_push_spaces(mut_view(*out), 4);
                    mir_push_str(mut_view(*out), 423, 4);
                    diag_buf_push_byte(mut_view(*out), 32u8);
                    diag_buf_push_u32(mut_view(*out), tid_v);
                    mir_push_str(mut_view(*out), 264, 3);
                    diag_buf_push_byte(mut_view(*out), 102u8);
                    diag_buf_push_byte(mut_view(*out), 110u8);
                    diag_buf_push_byte(mut_view(*out), 40u8);
                    let pcnt = unsafe {
                        (*ty_ptr).param_count
                    };
                    let ptypes = unsafe {
                        (*ty_ptr).param_types
                    };
                    let mut p: usize = 0;
                    while (p < pcnt) {
                        if p > 0 {
                            mir_push_str(mut_view(*out), 133, 2);
                        }
                        mir_push_str(mut_view(*out), 423, 5);
                        let pv = unsafe {
                            (*typeid_at(ptypes, p)).v
                        };
                        diag_buf_push_u32(mut_view(*out), pv);
                        p = p + 1;
                    }
                    diag_buf_push_byte(mut_view(*out), 41u8);
                    mir_push_str(mut_view(*out), 307, 4);
                    mir_push_str(mut_view(*out), 423, 5);
                    let rv = unsafe {
                        (*ty_ptr).ret_type.v
                    };
                    diag_buf_push_u32(mut_view(*out), rv);
                    mir_push_str(mut_view(*out), 267, 2);
                }
            }
            ti_idx = ti_idx + 1;
        }
    }

    let mut i: usize = 0;
    while (i < body.local_count) {
        let decl = unsafe {
            mir_local_at(body.locals, i)
        };
        let mut_flag = unsafe {
            (*decl).mut_flag
        };
        let ty_v = unsafe {
            (*decl).ty.v
        };
        mir_push_spaces(mut_view(*out), 4);
        mir_push_str(mut_view(*out), 187, 4);
        if mut_flag {
            mir_push_str(mut_view(*out), 191, 4);
        }
        diag_buf_push_byte(mut_view(*out), 95u8);
        diag_buf_push_u32(mut_view(*out), i as u32);
        mir_push_str(mut_view(*out), 195, 7);
        diag_buf_push_u32(mut_view(*out), ty_v);
        mir_push_str(mut_view(*out), 267, 2);
        i = i + 1;
    }

    i = 0;
    while (i < body.bb_count) {
        let bb = unsafe {
            mir_bb_at(body.bbs, i)
        };
        let bb_id = unsafe {
            (*bb).id.v
        };
        let is_cleanup = unsafe {
            (*bb).is_cleanup
        };
        mir_push_spaces(mut_view(*out), 4);
        mir_push_str(mut_view(*out), 249, 2);
        diag_buf_push_u32(mut_view(*out), bb_id);
        if is_cleanup {
            mir_push_str(mut_view(*out), 251, 10);
        }
        diag_buf_push_byte(mut_view(*out), 58u8);
        mir_push_str(mut_view(*out), 261, 3);

        let stmt_count = unsafe {
            (*bb).stmt_count
        };
        let stmts = unsafe {
            (*bb).stmts
        };
        let mut j: usize = 0;
        while (j < stmt_count) {
            let stmt = unsafe {
                mir_stmt_at(stmts, j)
            };
            let sk = unsafe {
                (*stmt).kind
            };
            mir_push_spaces(mut_view(*out), 8);
            if sk == MIR_STMT_ASSIGN {
                unsafe {
                    mir_print_place(mut_view(*out), view((*stmt).place));
                }
                mir_push_str(mut_view(*out), 264, 3);
                unsafe {
                    mir_print_rvalue(mut_view(*out), view((*stmt).rvalue));
                }
                mir_push_str(mut_view(*out), 267, 2);
            } else if sk == MIR_STMT_STORAGE_LIVE {
                let sl = unsafe {
                    (*stmt).storage_local.v
                };
                mir_push_str(mut_view(*out), 269, 13);
                diag_buf_push_u32(mut_view(*out), sl);
                mir_push_str(mut_view(*out), 282, 3);
            } else if sk == MIR_STMT_STORAGE_DEAD {
                let sd = unsafe {
                    (*stmt).storage_local.v
                };
                mir_push_str(mut_view(*out), 285, 13);
                diag_buf_push_u32(mut_view(*out), sd);
                mir_push_str(mut_view(*out), 282, 3);
            } else if sk == MIR_STMT_DROP {
                mir_push_str(mut_view(*out), 298, 5);
                unsafe {
                    mir_print_place(mut_view(*out), view((*stmt).place));
                }
                mir_push_str(mut_view(*out), 282, 3);
            }
            j = j + 1;
        }

        let has_term = unsafe {
            (*bb).has_terminator
        };
        if has_term {
            let tk = unsafe {
                (*bb).terminator.kind
            };
            mir_push_spaces(mut_view(*out), 8);
            if tk == MIR_TERM_GOTO {
                let gt = unsafe {
                    (*bb).terminator.goto_target.v
                };
                mir_push_str(mut_view(*out), 303, 10);
                diag_buf_push_u32(mut_view(*out), gt);
                mir_push_str(mut_view(*out), 267, 2);
            } else if tk == MIR_TERM_RETURN {
                mir_push_str(mut_view(*out), 313, 8);
            } else if tk == MIR_TERM_UNREACHABLE {
                mir_push_str(mut_view(*out), 321, 13);
            } else if tk == MIR_TERM_DROP {
                let is_exp = unsafe {
                    (*bb).terminator.drop_is_explicit
                };
                if is_exp {
                    // "explicit "
                    diag_buf_push_byte(mut_view(*out), 101u8);
                    diag_buf_push_byte(mut_view(*out), 120u8);
                    diag_buf_push_byte(mut_view(*out), 112u8);
                    diag_buf_push_byte(mut_view(*out), 108u8);
                    diag_buf_push_byte(mut_view(*out), 105u8);
                    diag_buf_push_byte(mut_view(*out), 99u8);
                    diag_buf_push_byte(mut_view(*out), 105u8);
                    diag_buf_push_byte(mut_view(*out), 116u8);
                    diag_buf_push_byte(mut_view(*out), 32u8);
                }
                mir_push_str(mut_view(*out), 334, 5);
                unsafe {
                    mir_print_place(mut_view(*out), view((*bb).terminator.drop_place));
                }
                diag_buf_push_byte(mut_view(*out), 41u8);
                let dt = unsafe {
                    (*bb).terminator.drop_target.v
                };
                let du = unsafe {
                    (*bb).terminator.drop_unwind.v
                };
                mir_push_return_unwind(mut_view(*out), dt, du);
            } else if tk == MIR_TERM_CALL {
                let has_dest = unsafe {
                    (*bb).terminator.has_destination
                };
                if has_dest {
                    unsafe {
                        mir_print_place(mut_view(*out), view((*bb).terminator.destination));
                    }
                    mir_push_str(mut_view(*out), 264, 3);
                }
                unsafe {
                    mir_print_operand(mut_view(*out), view((*bb).terminator.func));
                }
                diag_buf_push_byte(mut_view(*out), 40u8);
                let argc = unsafe {
                    (*bb).terminator.arg_count
                };
                let args = unsafe {
                    (*bb).terminator.args
                };
                let mut a: usize = 0;
                while (a < argc) {
                    if a > 0 {
                        mir_push_str(mut_view(*out), 133, 2);
                    }
                    let arg_op = unsafe {
                        mir_op_at(args, a)
                    };
                    unsafe {
                        mir_print_operand(mut_view(*out), view(*arg_op));
                    }
                    a = a + 1;
                }
                diag_buf_push_byte(mut_view(*out), 41u8);
                let ct = unsafe {
                    (*bb).terminator.call_target.v
                };
                let cu = unsafe {
                    (*bb).terminator.call_unwind.v
                };
                mir_push_return_unwind(mut_view(*out), ct, cu);
            } else if tk == MIR_TERM_SWITCH_INT {
                mir_push_str(mut_view(*out), 351, 10);
                unsafe {
                    mir_print_operand(mut_view(*out), view((*bb).terminator.discr));
                }
                mir_push_str(mut_view(*out), 361, 6);
                let sc = unsafe {
                    (*bb).terminator.switch_count
                };
                let vals = unsafe {
                    (*bb).terminator.values
                };
                let tgts = unsafe {
                    (*bb).terminator.targets
                };
                let mut s: usize = 0;
                while (s < sc) {
                    let sv = unsafe {
                        *mir_u64_at(vals, s)
                    };
                    let st = unsafe {
                        (*mir_bb_id_at(tgts, s)).v
                    };
                    mir_buf_push_u64(mut_view(*out), sv);
                    mir_push_str(mut_view(*out), 367, 4);
                    diag_buf_push_u32(mut_view(*out), st);
                    mir_push_str(mut_view(*out), 133, 2);
                    s = s + 1;
                }
                let ow = unsafe {
                    (*bb).terminator.otherwise.v
                };
                mir_push_str(mut_view(*out), 371, 13);
                diag_buf_push_u32(mut_view(*out), ow);
                mir_push_str(mut_view(*out), 384, 3);
            } else if tk == MIR_TERM_ASSERT {
                mir_push_str(mut_view(*out), 387, 7);
                unsafe {
                    mir_print_operand(mut_view(*out), view((*bb).terminator.cond));
                }
                diag_buf_push_byte(mut_view(*out), 32u8);
                mir_push_str(mut_view(*out), 51, 2);
                diag_buf_push_byte(mut_view(*out), 32u8);
                let exp = unsafe {
                    (*bb).terminator.expected
                };
                if exp {
                    mir_push_str(mut_view(*out), 396, 4);
                } else {
                    mir_push_str(mut_view(*out), 405, 5);
                }
                let mptr = unsafe {
                    (*bb).terminator.msg_ptr
                };
                let mlen = unsafe {
                    (*bb).terminator.msg_len
                };
                if (mptr as usize) != 0 {
                    mir_push_str(mut_view(*out), 400, 3);
                    let mut m: usize = 0;
                    while (m < mlen) {
                        let ch = unsafe {
                            *(mptr + m)
                        };
                        diag_buf_push_byte(mut_view(*out), ch);
                        m = m + 1;
                    }
                    diag_buf_push_byte(mut_view(*out), 34u8);
                }
                diag_buf_push_byte(mut_view(*out), 41u8);
                let at = unsafe {
                    (*bb).terminator.assert_target.v
                };
                let au = unsafe {
                    (*bb).terminator.assert_unwind.v
                };
                mir_push_return_unwind(mut_view(*out), at, au);
            }
        }

        mir_push_spaces(mut_view(*out), 4);
        mir_push_str(mut_view(*out), 421, 2);
        i = i + 1;
    }
    mir_push_str(mut_view(*out), 421, 2);
}

pub fn mir_print(out: mut_view<DiagBuffer>, body: view<MirBody>) {
    mir_print_ext(mut_view(*out), body, 0 as *const TypeInterner);
}

// --- MIR Text Parser (port of bootstrap/axiom0/src/mir/parse.c) ---

struct MirParser {
    src: *const u8,
    len: usize,
    pos: usize,
}

fn mp_is_space(c: u8) -> bool {
    c == 32u8 || c == 9u8 || c == 10u8 || c == 13u8
}

fn mp_is_digit(c: u8) -> bool {
    c >= 48u8 && c <= 57u8
}

fn mp_is_alnum(c: u8) -> bool {
    (c >= 48u8 && c <= 57u8) || (c >= 65u8 && c <= 90u8) || (c >= 97u8 && c <= 122u8)
}

fn mp_skip_ws(p: mut_view<MirParser>) {
    while ((p.pos) < p.len) {
        let c = unsafe {
            *(p.src + p.pos)
        };
        if mp_is_space(c) {
            p.pos = p.pos + 1;
        } else if (p.pos + 1) < p.len && c == 47u8 && (unsafe { *(p.src + p.pos + 1) }) == 47u8 {
            p.pos = p.pos + 2;
            while ((p.pos) < p.len && (unsafe { *(p.src + p.pos) }) != 10u8) {
                p.pos = p.pos + 1;
            }
        } else {
            break;
        }
    }
}

fn mp_match_bytes(p: mut_view<MirParser>, kw_off: usize, kw_len: usize) -> bool {
    mp_skip_ws(mut_view(*p));
    if p.pos + kw_len > p.len {
        return false;
    }
    let mut i: usize = 0;
    while (i < kw_len) {
        let a = unsafe {
            *(p.src + p.pos + i)
        };
        if a != MIR_STR_TABLE[kw_off + i] {
            return false;
        }
        i = i + 1;
    }
    if kw_len > 0 && kw_off != 502 && kw_off != 249 {
        let last = MIR_STR_TABLE[kw_off + kw_len - 1];
        if mp_is_alnum(last) || last == 95u8 {
            if (p.pos + kw_len) < p.len {
                let next = unsafe {
                    *(p.src + p.pos + kw_len)
                };
                if mp_is_alnum(next) || next == 95u8 {
                    return false;
                }
            }
        }
    }
    p.pos = p.pos + kw_len;
    true
}

fn mp_match_kw_4(p: mut_view<MirParser>, b0: u8, b1: u8, b2: u8, b3: u8) -> bool {
    mp_skip_ws(mut_view(*p));
    if p.pos + 4 > p.len {
        return false;
    }
    let ok = unsafe {
        *(p.src + p.pos + 0) == b0 &&
        *(p.src + p.pos + 1) == b1 &&
        *(p.src + p.pos + 2) == b2 &&
        *(p.src + p.pos + 3) == b3
    };
    if !ok {
        return false;
    }
    if (p.pos + 4) < p.len {
        let next = unsafe {
            *(p.src + p.pos + 4)
        };
        if mp_is_alnum(next) || next == 95u8 {
            return false;
        }
    }
    p.pos = p.pos + 4;
    true
}

fn mp_match_kw_6(p: mut_view<MirParser>, b0: u8, b1: u8, b2: u8, b3: u8, b4: u8, b5: u8) -> bool {
    mp_skip_ws(mut_view(*p));
    if p.pos + 6 > p.len {
        return false;
    }
    let ok = unsafe {
        *(p.src + p.pos + 0) == b0 &&
        *(p.src + p.pos + 1) == b1 &&
        *(p.src + p.pos + 2) == b2 &&
        *(p.src + p.pos + 3) == b3 &&
        *(p.src + p.pos + 4) == b4 &&
        *(p.src + p.pos + 5) == b5
    };
    if !ok {
        return false;
    }
    if (p.pos + 6) < p.len {
        let next = unsafe {
            *(p.src + p.pos + 6)
        };
        if mp_is_alnum(next) || next == 95u8 {
            return false;
        }
    }
    p.pos = p.pos + 6;
    true
}

fn mp_match_kw_8(p: mut_view<MirParser>, b0: u8, b1: u8, b2: u8, b3: u8, b4: u8, b5: u8, b6: u8, b7: u8) -> bool {
    mp_skip_ws(mut_view(*p));
    if p.pos + 8 > p.len {
        return false;
    }
    let ok = unsafe {
        *(p.src + p.pos + 0) == b0 &&
        *(p.src + p.pos + 1) == b1 &&
        *(p.src + p.pos + 2) == b2 &&
        *(p.src + p.pos + 3) == b3 &&
        *(p.src + p.pos + 4) == b4 &&
        *(p.src + p.pos + 5) == b5 &&
        *(p.src + p.pos + 6) == b6 &&
        *(p.src + p.pos + 7) == b7
    };
    if !ok {
        return false;
    }
    if (p.pos + 8) < p.len {
        let next = unsafe {
            *(p.src + p.pos + 8)
        };
        if mp_is_alnum(next) || next == 95u8 {
            return false;
        }
    }
    p.pos = p.pos + 8;
    true
}

fn mp_parse_u64(p: mut_view<MirParser>) -> u64 {
    mp_skip_ws(mut_view(*p));
    let mut val: u64 = 0u64;
    while ((p.pos) < p.len) {
        let c = unsafe {
            *(p.src + p.pos)
        };
        if !mp_is_digit(c) {
            break;
        }
        val = mir_mul_u64(val, 10u64) + ((c - 48u8) as u64);
        p.pos = p.pos + 1;
    }
    val
}

fn mp_parse_u32(p: mut_view<MirParser>) -> u32 {
    mp_parse_u64(mut_view(*p)) as u32
}

fn mp_parse_type(
    p: mut_view<MirParser>,
    interner: mut_view<TypeInterner>,
    type_map: *const TypeId
) -> TypeId {
    mp_skip_ws(mut_view(*p));
    if mp_match_bytes(mut_view(*p), 423, 5) {
        let id = mp_parse_u32(mut_view(*p));
        if (type_map as usize) != 0 && id < 1024u32 {
            let mapped = unsafe {
                (*typeid_at(type_map as *mut TypeId, id as usize)).v
            };
            if mapped != 0u32 {
                return TypeId {
                    v: mapped
                };
            }
        }
        return TypeId {
            v: id
        };
    }
    if mp_match_bytes(mut_view(*p), 428, 3) {
        return TypeId {
            v: interner.t_i32.v
        };
    }
    if mp_match_bytes(mut_view(*p), 431, 3) {
        return TypeId {
            v: interner.t_i64.v
        };
    }
    if mp_match_bytes(mut_view(*p), 434, 3) {
        return TypeId {
            v: interner.t_u32.v
        };
    }
    if mp_match_bytes(mut_view(*p), 437, 3) {
        return TypeId {
            v: interner.t_u64.v
        };
    }
    if mp_match_bytes(mut_view(*p), 440, 5) {
        return TypeId {
            v: interner.t_usize.v
        };
    }
    if mp_match_bytes(mut_view(*p), 445, 5) {
        return TypeId {
            v: interner.t_isize.v
        };
    }
    if mp_match_bytes(mut_view(*p), 450, 4) {
        return TypeId {
            v: interner.t_bool.v
        };
    }
    if mp_match_bytes(mut_view(*p), 454, 4) || mp_match_bytes(mut_view(*p), 458, 2) {
        return TypeId {
            v: interner.t_unit.v
        };
    }
    if mp_match_bytes(mut_view(*p), 460, 5) || mp_match_bytes(mut_view(*p), 465, 1) {
        return TypeId {
            v: interner.t_never.v
        };
    }
    if mp_match_bytes(mut_view(*p), 466, 3) {
        return TypeId {
            v: interner.t_str.v
        };
    }
    if mp_match_bytes(mut_view(*p), 469, 4) {
        let inner = mp_parse_type(mut_view(*p), mut_view(*interner), type_map);
        return intern_ptr_ty(mut_view(*interner), inner, true);
    }
    if mp_match_bytes(mut_view(*p), 473, 6) {
        let inner = mp_parse_type(mut_view(*p), mut_view(*interner), type_map);
        return intern_ptr_ty(mut_view(*interner), inner, false);
    }
    if mp_match_bytes(mut_view(*p), 479, 4) {
        let inner = mp_parse_type(mut_view(*p), mut_view(*interner), type_map);
        return intern_view_ty(mut_view(*interner), inner, true);
    }
    if mp_match_bytes(mut_view(*p), 483, 8) {
        if mp_match_bytes(mut_view(*p), 491, 1) {
            let inner = mp_parse_type(mut_view(*p), mut_view(*interner), type_map);
            mp_match_bytes(mut_view(*p), 492, 1);
            return intern_view_ty(mut_view(*interner), inner, true);
        }
    }
    if mp_match_bytes(mut_view(*p), 493, 1) {
        let inner = mp_parse_type(mut_view(*p), mut_view(*interner), type_map);
        return intern_view_ty(mut_view(*interner), inner, false);
    }
    if mp_match_bytes(mut_view(*p), 494, 4) {
        if mp_match_bytes(mut_view(*p), 491, 1) {
            let inner = mp_parse_type(mut_view(*p), mut_view(*interner), type_map);
            mp_match_bytes(mut_view(*p), 492, 1);
            return intern_view_ty(mut_view(*interner), inner, false);
        }
    }
    if mp_match_bytes(mut_view(*p), 498, 1) {
        mp_skip_ws(mut_view(*p));
        if (p.pos) < p.len && mp_is_digit(unsafe { *(p.src + p.pos) }) {
            let arr_len = mp_parse_u64(mut_view(*p));
            mp_match_bytes(mut_view(*p), 499, 1);
            let inner = mp_parse_type(mut_view(*p), mut_view(*interner), type_map);
            return intern_array_ty(mut_view(*interner), inner, arr_len);
        }
        let inner = mp_parse_type(mut_view(*p), mut_view(*interner), type_map);
        mp_match_bytes(mut_view(*p), 499, 1);
        return intern_slice_ty(mut_view(*interner), inner);
    }
    TypeId { v: interner.t_error.v }
}

fn mp_push_proj(
    projs: *mut MirProjection,
    proj_count: mut_view<usize>,
    proj: view<MirProjection>
) {
    let idx = *proj_count;
    if idx < 16 {
        let dst = unsafe {
            mir_proj_at(projs, idx)
        };
        unsafe {
            (*dst).kind = proj.kind;
            (*dst).field_idx = proj.field_idx;
            (*dst).index_local.v = proj.index_local.v;
            (*dst).from_local.v = proj.from_local.v;
            (*dst).to_local.v = proj.to_local.v;
            (*dst).has_from = proj.has_from;
            (*dst).has_to = proj.has_to;
            (*dst).variant_idx = proj.variant_idx;
        }
        *proj_count = idx + 1;
    }
}

fn mp_parse_place_base(
    p: mut_view<MirParser>,
    local_v: mut_view<u32>,
    projs: *mut MirProjection,
    proj_count: mut_view<usize>
) {
    mp_skip_ws(mut_view(*p));
    if mp_match_bytes(mut_view(*p), 500, 1) {
        mp_skip_ws(mut_view(*p));
        if mp_match_bytes(mut_view(*p), 501, 1) {
            mp_parse_place_base(mut_view(*p), mut_view(*local_v), projs, mut_view(*proj_count));
            mp_match_bytes(mut_view(*p), 503, 1);
            let pr = MirProjection {
                kind: MIR_PROJ_DEREF,
                field_idx: 0u32,
                index_local: MirLocalId { v: 0u32 },
                from_local: MirLocalId { v: 0u32 },
                to_local: MirLocalId { v: 0u32 },
                has_from: false,
                has_to: false,
                variant_idx: 0u32,
            };
            mp_push_proj(projs, mut_view(*proj_count), view(pr));
        } else {
            mp_parse_place_base(mut_view(*p), mut_view(*local_v), projs, mut_view(*proj_count));
            if mp_match_bytes(mut_view(*p), 507, 2) {
                if mp_match_bytes(mut_view(*p), 509, 8) {
                    let vidx = mp_parse_u32(mut_view(*p));
                    let pr = MirProjection {
                        kind: MIR_PROJ_DOWNCAST,
                        field_idx: 0u32,
                        index_local: MirLocalId { v: 0u32 },
                        from_local: MirLocalId { v: 0u32 },
                        to_local: MirLocalId { v: 0u32 },
                        has_from: false,
                        has_to: false,
                        variant_idx: vidx,
                    };
                    mp_push_proj(projs, mut_view(*proj_count), view(pr));
                }
            }
            mp_match_bytes(mut_view(*p), 503, 1);
        }
    } else if mp_match_bytes(mut_view(*p), 502, 1) {
        let lv = mp_parse_u32(mut_view(*p));
        *local_v = lv;
    }

    loop {
        mp_skip_ws(mut_view(*p));
        if mp_match_bytes(mut_view(*p), 504, 1) {
            let fidx = mp_parse_u32(mut_view(*p));
            let pr = MirProjection {
                kind: MIR_PROJ_FIELD,
                field_idx: fidx,
                index_local: MirLocalId { v: 0u32 },
                from_local: MirLocalId { v: 0u32 },
                to_local: MirLocalId { v: 0u32 },
                has_from: false,
                has_to: false,
                variant_idx: 0u32,
            };
            mp_push_proj(projs, mut_view(*proj_count), view(pr));
        } else if mp_match_bytes(mut_view(*p), 498, 1) {
            let mut has_from: bool = false;
            let mut from_loc: u32 = 0u32;
            if mp_match_bytes(mut_view(*p), 502, 1) {
                has_from = true;
                from_loc = mp_parse_u32(mut_view(*p));
            }
            if mp_match_bytes(mut_view(*p), 505, 2) {
                let mut has_to: bool = false;
                let mut to_loc: u32 = 0u32;
                if mp_match_bytes(mut_view(*p), 502, 1) {
                    has_to = true;
                    to_loc = mp_parse_u32(mut_view(*p));
                }
                mp_match_bytes(mut_view(*p), 499, 1);
                let pr = MirProjection {
                    kind: MIR_PROJ_SUB_SLICE,
                    field_idx: 0u32,
                    index_local: MirLocalId { v: 0u32 },
                    from_local: MirLocalId { v: from_loc },
                    to_local: MirLocalId { v: to_loc },
                    has_from: has_from,
                    has_to: has_to,
                    variant_idx: 0u32,
                };
                mp_push_proj(projs, mut_view(*proj_count), view(pr));
            } else {
                mp_match_bytes(mut_view(*p), 499, 1);
                let pr = MirProjection {
                    kind: MIR_PROJ_INDEX,
                    field_idx: 0u32,
                    index_local: MirLocalId { v: from_loc },
                    from_local: MirLocalId { v: 0u32 },
                    to_local: MirLocalId { v: 0u32 },
                    has_from: false,
                    has_to: false,
                    variant_idx: 0u32,
                };
                mp_push_proj(projs, mut_view(*proj_count), view(pr));
            }
        } else {
            let saved = p.pos;
            if mp_match_bytes(mut_view(*p), 507, 2) {
                if mp_match_bytes(mut_view(*p), 509, 8) {
                    let vidx = mp_parse_u32(mut_view(*p));
                    let pr = MirProjection {
                        kind: MIR_PROJ_DOWNCAST,
                        field_idx: 0u32,
                        index_local: MirLocalId { v: 0u32 },
                        from_local: MirLocalId { v: 0u32 },
                        to_local: MirLocalId { v: 0u32 },
                        has_from: false,
                        has_to: false,
                        variant_idx: vidx,
                    };
                    mp_push_proj(projs, mut_view(*proj_count), view(pr));
                    continue;
                }
                p.pos = saved;
            }
            break;
        }
    }
}

fn mp_parse_place(p: mut_view<MirParser>, arena: mut_view<Arena>, out: mut_view<MirPlace>) {
    mir_place_reset_u32(mut_view(*out), 0u32);
    let tmp_bytes = mir_mul_usize(16, size_of<MirProjection>());
    let projs = arena_alloc_raw(mut_view(*arena), tmp_bytes, align_of<MirProjection>()) as *mut MirProjection;
    let mut proj_count: usize = 0;
    let mut loc_v: u32 = 0u32;
    mp_parse_place_base(mut_view(*p), mut_view(loc_v), projs, mut_view(proj_count));
    out.local.v = loc_v;

    if mp_match_bytes(mut_view(*p), 517, 11) {
        let df_v = mp_parse_u32(mut_view(*p));
        out.drop_flag = df_v;
        mp_match_bytes(mut_view(*p), 503, 1);
    }

    if proj_count > 0 {
        out.projs = projs;
        out.proj_count = proj_count;
    }
}

fn mp_hex_val(c: u8) -> u8 {
    if c >= 48u8 && c <= 57u8 {
        return c - 48u8;
    }
    if c >= 97u8 && c <= 102u8 {
        return c - 97u8 + 10u8;
    }
    if c >= 65u8 && c <= 70u8 {
        return c - 65u8 + 10u8;
    }
    0u8
}

fn mp_parse_operand(
    p: mut_view<MirParser>,
    interner: mut_view<TypeInterner>,
    arena: mut_view<Arena>,
    type_map: *const TypeId,
    out: mut_view<MirOperand>
) {
    mir_operand_zero(mut_view(*out), MIR_OP_COPY);
    if mp_match_bytes(mut_view(*p), 528, 4) {
        out.kind = MIR_OP_COPY;
        mp_parse_place(mut_view(*p), mut_view(*arena), mut_view(out.place));
    } else if mp_match_bytes(mut_view(*p), 532, 4) {
        out.kind = MIR_OP_MOVE;
        mp_parse_place(mut_view(*p), mut_view(*arena), mut_view(out.place));
    } else if mp_match_bytes(mut_view(*p), 536, 5) {
        out.kind = MIR_OP_CONST;
        mp_skip_ws(mut_view(*p));
        if (p.pos) < p.len && (unsafe { *(p.src + p.pos) }) == 34u8 {
            p.pos = p.pos + 1;
            let start = p.pos;
            let mut max_len: usize = 0;
            while ((p.pos) < p.len && (unsafe { *(p.src + p.pos) }) != 34u8) {
                if (unsafe { *(p.src + p.pos) }) == 92u8 && (p.pos + 1) < p.len {
                    p.pos = p.pos + 2;
                } else {
                    p.pos = p.pos + 1;
                }
                max_len = max_len + 1;
            }
            let buf = arena_alloc_raw(mut_view(*arena), max_len + 1, 1);
            let mut actual_len: usize = 0;
            let mut cur = start;
            while (cur < p.len && (unsafe { *(p.src + cur) }) != 34u8) {
                let ch = unsafe {
                    *(p.src + cur)
                };
                if ch == 92u8 && (cur + 1) < p.len {
                    cur = cur + 1;
                    let esc = unsafe {
                        *(p.src + cur)
                    };
                    if esc == 110u8 {
                        unsafe {
                            *(buf + actual_len) = 10u8;
                        }
                        actual_len = actual_len + 1;
                    } else if esc == 114u8 {
                        unsafe {
                            *(buf + actual_len) = 13u8;
                        }
                        actual_len = actual_len + 1;
                    } else if esc == 116u8 {
                        unsafe {
                            *(buf + actual_len) = 9u8;
                        }
                        actual_len = actual_len + 1;
                    } else if esc == 92u8 {
                        unsafe {
                            *(buf + actual_len) = 92u8;
                        }
                        actual_len = actual_len + 1;
                    } else if esc == 34u8 {
                        unsafe {
                            *(buf + actual_len) = 34u8;
                        }
                        actual_len = actual_len + 1;
                    } else if esc == 48u8 {
                        unsafe {
                            *(buf + actual_len) = 0u8;
                        }
                        actual_len = actual_len + 1;
                    } else if esc == 120u8 && (cur + 2) < p.len {
                        let h1 = mp_hex_val(unsafe {
                            *(p.src + cur + 1)
                        });
                        let h2 = mp_hex_val(unsafe {
                            *(p.src + cur + 2)
                        });
                        unsafe {
                            *(buf + actual_len) = (h1 << 4u8) | h2;
                        }
                        actual_len = actual_len + 1;
                        cur = cur + 2;
                    } else {
                        unsafe {
                            *(buf + actual_len) = esc;
                        }
                        actual_len = actual_len + 1;
                    }
                    cur = cur + 1;
                } else {
                    unsafe {
                        *(buf + actual_len) = ch;
                    }
                    actual_len = actual_len + 1;
                    cur = cur + 1;
                }
            }
            unsafe {
                *(buf + actual_len) = 0u8;
            }
            if (p.pos) < p.len && (unsafe { *(p.src + p.pos) }) == 34u8 {
                p.pos = p.pos + 1;
            }
            out.constant.kind = MIR_CONST_STR;
            out.constant.str_bytes = buf as *const u8;
            out.constant.str_len = actual_len;
            out.constant.ty.v = interner.t_str.v;
        } else {
            let cv = mp_parse_u64(mut_view(*p));
            out.constant.val = cv;
            out.constant.kind = MIR_CONST_INT;
            out.constant.ty.v = interner.t_i32.v;
        }
        if mp_match_bytes(mut_view(*p), 541, 1) {
            let cty = mp_parse_type(mut_view(*p), mut_view(*interner), type_map);
            out.constant.ty.v = cty.v;
        }
    }
}

fn mp_try_parse_binop(p: mut_view<MirParser>) -> u8 {
    mp_skip_ws(mut_view(*p));
    if (p.pos + 12) <= p.len &&
       (unsafe { *(p.src + p.pos + 0) }) == 119u8 &&
       (unsafe { *(p.src + p.pos + 1) }) == 114u8 &&
       (unsafe { *(p.src + p.pos + 2) }) == 97u8 &&
       (unsafe { *(p.src + p.pos + 3) }) == 112u8 &&
       (unsafe { *(p.src + p.pos + 4) }) == 112u8 &&
       (unsafe { *(p.src + p.pos + 5) }) == 105u8 &&
       (unsafe { *(p.src + p.pos + 6) }) == 110u8 &&
       (unsafe { *(p.src + p.pos + 7) }) == 103u8 &&
       (unsafe { *(p.src + p.pos + 8) }) == 95u8 {
        let b9 = unsafe { *(p.src + p.pos + 9) };
        let b10 = unsafe { *(p.src + p.pos + 10) };
        let b11 = unsafe { *(p.src + p.pos + 11) };
        if b9 == 97u8 && b10 == 100u8 && b11 == 100u8 {
            p.pos = p.pos + 12;
            return MIR_BINOP_ADD;
        }
        if b9 == 115u8 && b10 == 117u8 && b11 == 98u8 {
            p.pos = p.pos + 12;
            return MIR_BINOP_SUB;
        }
        if b9 == 109u8 && b10 == 117u8 && b11 == 108u8 {
            p.pos = p.pos + 12;
            return MIR_BINOP_MUL;
        }
    }
    if mp_match_bytes(mut_view(*p), 59, 6) { return MIR_BINOP_OFFSET; }
    else if mp_match_bytes(mut_view(*p), 47, 2) { return MIR_BINOP_SHL; }
    else if mp_match_bytes(mut_view(*p), 49, 2) { return MIR_BINOP_SHR; }
    else if mp_match_bytes(mut_view(*p), 51, 2) { return MIR_BINOP_EQ; }
    else if mp_match_bytes(mut_view(*p), 53, 2) { return MIR_BINOP_LE; }
    else if mp_match_bytes(mut_view(*p), 55, 2) { return MIR_BINOP_NE; }
    else if mp_match_bytes(mut_view(*p), 57, 2) { return MIR_BINOP_GE; }
    else if mp_match_bytes(mut_view(*p), 491, 1) { return MIR_BINOP_LT; }
    else if mp_match_bytes(mut_view(*p), 492, 1) { return MIR_BINOP_GT; }
    else if mp_match_bytes(mut_view(*p), 542, 1) { return MIR_BINOP_ADD; }
    else if mp_match_bytes(mut_view(*p), 543, 1) { return MIR_BINOP_SUB; }
    else if mp_match_bytes(mut_view(*p), 544, 1) { return MIR_BINOP_MUL; }
    else if mp_match_bytes(mut_view(*p), 545, 1) { return MIR_BINOP_DIV; }
    else if mp_match_bytes(mut_view(*p), 546, 1) { return MIR_BINOP_REM; }
    else if mp_match_bytes(mut_view(*p), 547, 1) { return MIR_BINOP_BIT_XOR; }
    else if mp_match_bytes(mut_view(*p), 493, 1) { return MIR_BINOP_BIT_AND; }
    else if mp_match_bytes(mut_view(*p), 548, 1) { return MIR_BINOP_BIT_OR; }
    255u8
}

fn mp_parse_rvalue(
    p: mut_view<MirParser>,
    interner: mut_view<TypeInterner>,
    arena: mut_view<Arena>,
    type_map: *const TypeId,
    out: mut_view<MirRvalue>
) {
    mir_rvalue_reset(mut_view(*out), MIR_RVALUE_USE);
    mp_skip_ws(mut_view(*p));

    if mp_match_bytes(mut_view(*p), 479, 4) {
        out.kind = MIR_RVALUE_REF;
        out.borrow_kind = MIR_BORROW_MUT;
        mp_parse_place(mut_view(*p), mut_view(*arena), mut_view(out.place));
        return;
    }
    if mp_match_bytes(mut_view(*p), 493, 1) {
        out.kind = MIR_RVALUE_REF;
        out.borrow_kind = MIR_BORROW_SHARED;
        mp_parse_place(mut_view(*p), mut_view(*arena), mut_view(out.place));
        return;
    }
    // "Len(" or "len("
    if mp_match_bytes(mut_view(*p), 72, 4) || (mp_match_kw_4(mut_view(*p), 108u8, 101u8, 110u8, 40u8)) {
        out.kind = MIR_RVALUE_LEN;
        mp_parse_place(mut_view(*p), mut_view(*arena), mut_view(out.place));
        mp_match_bytes(mut_view(*p), 503, 1);
        return;
    }
    mp_skip_ws(mut_view(*p));
    if (p.pos + 4) <= p.len &&
        (unsafe { *(p.src + p.pos + 0) }) == 108u8 &&
        (unsafe { *(p.src + p.pos + 1) }) == 101u8 &&
        (unsafe { *(p.src + p.pos + 2) }) == 110u8 &&
        (unsafe { *(p.src + p.pos + 3) }) == 40u8 {
        p.pos = p.pos + 4;
        out.kind = MIR_RVALUE_LEN;
        mp_parse_place(mut_view(*p), mut_view(*arena), mut_view(out.place));
        mp_match_bytes(mut_view(*p), 503, 1);
        return;
    }
    if mp_match_bytes(mut_view(*p), 145, 13) {
        out.kind = MIR_RVALUE_DISCRIMINANT;
        mp_parse_place(mut_view(*p), mut_view(*arena), mut_view(out.place));
        mp_match_bytes(mut_view(*p), 503, 1);
        return;
    }
    // "Aggregate(" or "aggregate("
    let mut is_agg: bool = mp_match_bytes(mut_view(*p), 550, 10);
    if !is_agg {
        mp_skip_ws(mut_view(*p));
        if (p.pos + 10) <= p.len &&
            (unsafe { *(p.src + p.pos + 0) }) == 97u8 &&
            (unsafe { *(p.src + p.pos + 1) }) == 103u8 &&
            (unsafe { *(p.src + p.pos + 2) }) == 103u8 &&
            (unsafe { *(p.src + p.pos + 3) }) == 114u8 &&
            (unsafe { *(p.src + p.pos + 4) }) == 101u8 &&
            (unsafe { *(p.src + p.pos + 5) }) == 103u8 &&
            (unsafe { *(p.src + p.pos + 6) }) == 97u8 &&
            (unsafe { *(p.src + p.pos + 7) }) == 116u8 &&
            (unsafe { *(p.src + p.pos + 8) }) == 101u8 &&
            (unsafe { *(p.src + p.pos + 9) }) == 40u8 {
            p.pos = p.pos + 10;
            is_agg = true;
        }
    }
    if is_agg {
        out.kind = MIR_RVALUE_AGGREGATE;
        let mut v_idx: u32 = 0u32;
        if mp_match_bytes(mut_view(*p), 509, 8) {
            v_idx = mp_parse_u32(mut_view(*p));
            mp_match_bytes(mut_view(*p), 549, 1);
            mp_match_bytes(mut_view(*p), 560, 1);
        }
        out.variant_idx = v_idx;
        let has_bracket = mp_match_bytes(mut_view(*p), 498, 1);
        let ops_bytes = mir_mul_usize(32, size_of<MirOperand>());
        let ops = arena_alloc_raw(mut_view(*arena), ops_bytes, align_of<MirOperand>()) as *mut MirOperand;
        let mut op_count: usize = 0;
        loop {
            mp_skip_ws(mut_view(*p));
            if has_bracket {
                if mp_match_bytes(mut_view(*p), 499, 1) {
                    mp_match_bytes(mut_view(*p), 503, 1);
                    break;
                }
            } else if mp_match_bytes(mut_view(*p), 503, 1) {
                break;
            }
            if (p.pos) >= p.len {
                break;
            }
            let mut tmp_op = mir_op_copy_local(0u32);
            mp_parse_operand(mut_view(*p), mut_view(*interner), mut_view(*arena), type_map, mut_view(tmp_op));
            if op_count < 32 {
                let dst = unsafe {
                    mir_op_at(ops, op_count)
                };
                unsafe {
                    mir_copy_operand(mut_view(*dst), view(tmp_op));
                }
                op_count = op_count + 1;
            }
            if !mp_match_bytes(mut_view(*p), 549, 1) {
                if has_bracket {
                    mp_match_bytes(mut_view(*p), 499, 1);
                }
                mp_match_bytes(mut_view(*p), 503, 1);
                break;
            }
        }
        if op_count > 0 {
            out.operands = ops;
            out.operand_count = op_count;
        }
        return;
    }

    // "Overflows(" or "overflows("
    let mut is_ovf: bool = mp_match_bytes(mut_view(*p), 135, 10);
    if !is_ovf {
        mp_skip_ws(mut_view(*p));
        if (p.pos + 10) <= p.len &&
            (unsafe { *(p.src + p.pos + 0) }) == 111u8 &&
            (unsafe { *(p.src + p.pos + 1) }) == 118u8 &&
            (unsafe { *(p.src + p.pos + 2) }) == 101u8 &&
            (unsafe { *(p.src + p.pos + 3) }) == 114u8 &&
            (unsafe { *(p.src + p.pos + 4) }) == 102u8 &&
            (unsafe { *(p.src + p.pos + 5) }) == 108u8 &&
            (unsafe { *(p.src + p.pos + 6) }) == 111u8 &&
            (unsafe { *(p.src + p.pos + 7) }) == 119u8 &&
            (unsafe { *(p.src + p.pos + 8) }) == 115u8 &&
            (unsafe { *(p.src + p.pos + 9) }) == 40u8 {
            p.pos = p.pos + 10;
            is_ovf = true;
        }
    }
    if is_ovf {
        out.kind = MIR_RVALUE_OVERFLOWS_BINARY_OP;
        let saved_ovf = p.pos;
        let bop = mp_try_parse_binop(mut_view(*p));
        if bop != 255u8 && mp_match_bytes(mut_view(*p), 549, 1) {
            out.bin_op = bop;
            mp_parse_operand(mut_view(*p), mut_view(*interner), mut_view(*arena), type_map, mut_view(out.lhs));
            mp_match_bytes(mut_view(*p), 549, 1);
            mp_parse_operand(mut_view(*p), mut_view(*interner), mut_view(*arena), type_map, mut_view(out.rhs));
            mp_match_bytes(mut_view(*p), 503, 1);
            return;
        }
        p.pos = saved_ovf;
        mp_parse_operand(mut_view(*p), mut_view(*interner), mut_view(*arena), type_map, mut_view(out.lhs));
        let infix_op = mp_try_parse_binop(mut_view(*p));
        out.bin_op = if infix_op == 255u8 { MIR_BINOP_ADD } else { infix_op };
        mp_parse_operand(mut_view(*p), mut_view(*interner), mut_view(*arena), type_map, mut_view(out.rhs));
        mp_match_bytes(mut_view(*p), 503, 1);
        return;
    }

    if mp_match_bytes(mut_view(*p), 498, 1) {
        out.kind = MIR_RVALUE_REPEAT;
        mp_parse_operand(mut_view(*p), mut_view(*interner), mut_view(*arena), type_map, mut_view(out.use_op));
        mp_match_bytes(mut_view(*p), 560, 1);
        mp_skip_ws(mut_view(*p));
        if (p.pos) < p.len && mp_is_digit(unsafe { *(p.src + p.pos) }) {
            let rc = mp_parse_u64(mut_view(*p));
            out.repeat_count = rc;
            let op_ptr = arena_alloc_raw(mut_view(*arena), size_of<MirOperand>(), align_of<MirOperand>()) as *mut MirOperand;
            let c_op = mir_op_const_int(interner.t_usize.v, rc);
            unsafe {
                mir_copy_operand(mut_view(*op_ptr), view(c_op));
            }
            out.repeat_count_op = op_ptr;
        } else {
            let op_ptr = arena_alloc_raw(mut_view(*arena), size_of<MirOperand>(), align_of<MirOperand>()) as *mut MirOperand;
            unsafe {
                mp_parse_operand(mut_view(*p), mut_view(*interner), mut_view(*arena), type_map, mut_view(*op_ptr));
                out.repeat_count = (*op_ptr).constant.val;
            }
            out.repeat_count_op = op_ptr;
        }
        mp_match_bytes(mut_view(*p), 499, 1);
        return;
    }

    // Unary ops: "!(op)", "~(op)", "-(op)" OR "!op", "~op", "-op"
    if mp_match_bytes(mut_view(*p), 561, 2) {
        out.kind = MIR_RVALUE_UNARY_OP;
        out.un_op = MIR_UNOP_NOT;
        mp_parse_operand(mut_view(*p), mut_view(*interner), mut_view(*arena), type_map, mut_view(out.use_op));
        mp_match_bytes(mut_view(*p), 503, 1);
        return;
    }
    if mp_match_bytes(mut_view(*p), 563, 2) {
        out.kind = MIR_RVALUE_UNARY_OP;
        out.un_op = MIR_UNOP_BITNOT;
        mp_parse_operand(mut_view(*p), mut_view(*interner), mut_view(*arena), type_map, mut_view(out.use_op));
        mp_match_bytes(mut_view(*p), 503, 1);
        return;
    }
    if mp_match_bytes(mut_view(*p), 565, 2) {
        out.kind = MIR_RVALUE_UNARY_OP;
        out.un_op = MIR_UNOP_NEG;
        mp_parse_operand(mut_view(*p), mut_view(*interner), mut_view(*arena), type_map, mut_view(out.use_op));
        mp_match_bytes(mut_view(*p), 503, 1);
        return;
    }
    mp_skip_ws(mut_view(*p));
    if (p.pos) < p.len {
        let ch = unsafe {
            *(p.src + p.pos)
        };
        if ch == 33u8 || ch == 126u8 || ch == 45u8 {
            // Check if followed by copy/move/const (not a prefix `-(lhs, rhs)`)
            let saved_un = p.pos;
            p.pos = p.pos + 1;
            mp_skip_ws(mut_view(*p));
            if (p.pos) < p.len && (unsafe { *(p.src + p.pos) }) != 40u8 {
                out.kind = MIR_RVALUE_UNARY_OP;
                if ch == 33u8 {
                    out.un_op = MIR_UNOP_NOT;
                } else if ch == 126u8 {
                    out.un_op = MIR_UNOP_BITNOT;
                } else {
                    out.un_op = MIR_UNOP_NEG;
                }
                mp_parse_operand(mut_view(*p), mut_view(*interner), mut_view(*arena), type_map, mut_view(out.use_op));
                return;
            }
            p.pos = saved_un;
        }
    }

    // Prefix binary op: `<op>(lhs, rhs)` (including `offset(lhs, rhs)`)
    let saved_pos = p.pos;
    let cand_op = mp_try_parse_binop(mut_view(*p));
    if cand_op != 255u8 {
        if mp_match_bytes(mut_view(*p), 567, 1) {
            out.kind = MIR_RVALUE_BINARY_OP;
            out.bin_op = cand_op;
            mp_parse_operand(mut_view(*p), mut_view(*interner), mut_view(*arena), type_map, mut_view(out.lhs));
            mp_match_bytes(mut_view(*p), 549, 1);
            mp_parse_operand(mut_view(*p), mut_view(*interner), mut_view(*arena), type_map, mut_view(out.rhs));
            mp_match_bytes(mut_view(*p), 503, 1);
            return;
        }
        p.pos = saved_pos;
    }

    // Otherwise parse first operand, then check for `as <type>` or infix `<binop> <rhs>`
    mp_parse_operand(mut_view(*p), mut_view(*interner), mut_view(*arena), type_map, mut_view(out.use_op));
    if mp_match_bytes(mut_view(*p), 507, 2) {
        out.kind = MIR_RVALUE_CAST;
        let tty = mp_parse_type(mut_view(*p), mut_view(*interner), type_map);
        out.target_ty.v = tty.v;
        out.cast_kind = MIR_CAST_INT_TO_INT;
        if mp_match_bytes(mut_view(*p), 567, 1) {
            if mp_match_bytes(mut_view(*p), 568, 8) {
                out.cast_kind = MIR_CAST_INT_TO_INT;
            } else if mp_match_bytes(mut_view(*p), 576, 8) {
                out.cast_kind = MIR_CAST_PTR_TO_PTR;
            } else if mp_match_bytes(mut_view(*p), 584, 8) {
                out.cast_kind = MIR_CAST_INT_TO_PTR;
            } else if mp_match_bytes(mut_view(*p), 592, 8) {
                out.cast_kind = MIR_CAST_PTR_TO_INT;
            }
            mp_match_bytes(mut_view(*p), 503, 1);
        }
        return;
    }
    let saved_after_op = p.pos;
    let infix_binop = mp_try_parse_binop(mut_view(*p));
    if infix_binop != 255u8 {
        out.kind = MIR_RVALUE_BINARY_OP;
        out.bin_op = infix_binop;
        mir_copy_operand(mut_view(out.lhs), view(out.use_op));
        mp_parse_operand(mut_view(*p), mut_view(*interner), mut_view(*arena), type_map, mut_view(out.rhs));
        return;
    }
    p.pos = saved_after_op;
}

fn mp_parse_return_unwind_targets(
    p: mut_view<MirParser>,
    out_ret: mut_view<u32>,
    out_unw: mut_view<u32>
) {
    mp_skip_ws(mut_view(*p));
    if mp_match_bytes(mut_view(*p), 498, 1) {
        // "[return: bbX, unwind: bbY]"
        mp_match_bytes(mut_view(*p), 615, 6);
        mp_match_bytes(mut_view(*p), 541, 1);
        mp_match_bytes(mut_view(*p), 249, 2);
        let r = mp_parse_u32(mut_view(*p));
        *out_ret = r;
        if mp_match_bytes(mut_view(*p), 549, 1) {
            mp_match_kw_6(mut_view(*p), 117u8, 110u8, 119u8, 105u8, 110u8, 100u8);
            mp_match_bytes(mut_view(*p), 541, 1);
            mp_match_bytes(mut_view(*p), 249, 2);
            let u = mp_parse_u32(mut_view(*p));
            *out_unw = u;
        }
        mp_match_bytes(mut_view(*p), 499, 1);
    } else if mp_match_bytes(mut_view(*p), 249, 2) {
        let r = mp_parse_u32(mut_view(*p));
        *out_ret = r;
        *out_unw = 0u32;
    }
}

pub fn mir_parse(text: StrView, interner: mut_view<TypeInterner>, arena: mut_view<Arena>) -> *mut MirBody {
    let mut p = MirParser {
        src: text.ptr,
        len: text.len,
        pos: 0,
    };
    if !mp_match_bytes(mut_view(p), 600, 8) {
        return 0 as *mut MirBody;
    }
    if !mp_match_bytes(mut_view(p), 608, 1) {
        return 0 as *mut MirBody;
    }

    let body = mir_body_new(mut_view(*arena));
    let dummy_span = Span {
        file: FileId { v: 0u32 },
        start: 0u32,
        end: 0u32,
    };

    let type_map_bytes = mir_mul_usize(1024, size_of<TypeId>());
    let type_map = arena_alloc_raw(mut_view(*arena), type_map_bytes, align_of<TypeId>()) as *mut TypeId;
    let mut tm_i: usize = 0;
    while (tm_i < 1024) {
        unsafe {
            (*typeid_at(type_map, tm_i)).v = 0u32;
        }
        tm_i = tm_i + 1;
    }

    // Optional `type <id> = fn(...) -> <type>;` declarations
    while (mp_match_kw_4(mut_view(p), 116u8, 121u8, 112u8, 101u8)) {
        let tid = mp_parse_u32(mut_view(p));
        mp_match_bytes(mut_view(p), 716, 1);
        mp_skip_ws(mut_view(p));
        if (p.pos + 2) <= p.len &&
            (unsafe { *(p.src + p.pos + 0) }) == 102u8 &&
            (unsafe { *(p.src + p.pos + 1) }) == 110u8 {
            p.pos = p.pos + 2;
        }
        mp_match_bytes(mut_view(p), 500, 1);
        let mut ptypes: [16]u32 = [0u32; 16];
        let mut pcount: usize = 0;
        if !mp_match_bytes(mut_view(p), 503, 1) {
            loop {
                let pt = mp_parse_type(mut_view(p), mut_view(*interner), type_map as *const TypeId);
                if pcount < 16 {
                    ptypes[pcount] = pt.v;
                    pcount = pcount + 1;
                }
                if !mp_match_bytes(mut_view(p), 549, 1) {
                    mp_match_bytes(mut_view(p), 503, 1);
                    break;
                }
            }
        }
        mp_match_bytes(mut_view(p), 672, 2);
        let ret_ty = mp_parse_type(mut_view(p), mut_view(*interner), type_map as *const TypeId);
        mp_match_bytes(mut_view(p), 560, 1);
        let mut p_arr: *mut TypeId = 0 as *mut TypeId;
        if pcount > 0 {
            let p_bytes = mir_mul_usize(pcount, size_of<TypeId>());
            p_arr = arena_alloc_raw(mut_view(*arena), p_bytes, align_of<TypeId>()) as *mut TypeId;
            let mut pi: usize = 0;
            while (pi < pcount) {
                unsafe {
                    (*typeid_at(p_arr, pi)).v = ptypes[pi];
                }
                pi = pi + 1;
            }
        }
        let fn_ty = intern_fn_ty(mut_view(*interner), false, StrId {
            v: 0u32
        }, p_arr, pcount, ret_ty);
        if tid < 1024u32 {
            unsafe {
                (*typeid_at(type_map, tid as usize)).v = fn_ty.v;
            }
        }
    }

    while (mp_match_bytes(mut_view(p), 609, 3)) {
        let is_mut = mp_match_bytes(mut_view(p), 612, 3);
        mp_match_bytes(mut_view(p), 502, 1);
        let _local_id = mp_parse_u32(mut_view(p));
        mp_match_bytes(mut_view(p), 541, 1);
        let ty = mp_parse_type(mut_view(p), mut_view(*interner), type_map as *const TypeId);
        mp_match_bytes(mut_view(p), 560, 1);

        let mut kind: u8 = if _local_id == 0u32 { MIR_LOCAL_RETURN } else { MIR_LOCAL_TEMP };
        while ((p.pos) < p.len && ((unsafe { *(p.src + p.pos) }) == 32u8 || (unsafe { *(p.src + p.pos) }) == 9u8)) {
            p.pos = p.pos + 1;
        }
        if (p.pos + 1) < p.len && (unsafe { *(p.src + p.pos) }) == 47u8 && (unsafe { *(p.src + p.pos + 1) }) == 47u8 {
            p.pos = p.pos + 2;
            while ((p.pos) < p.len && ((unsafe { *(p.src + p.pos) }) == 32u8 || (unsafe { *(p.src + p.pos) }) == 9u8)) {
                p.pos = p.pos + 1;
            }
            if mp_match_bytes(mut_view(p), 615, 6) {
                kind = MIR_LOCAL_RETURN;
            } else if mp_match_bytes(mut_view(p), 621, 3) {
                kind = MIR_LOCAL_ARG;
            } else if mp_match_bytes(mut_view(p), 624, 4) {
                kind = MIR_LOCAL_USER;
            } else if mp_match_bytes(mut_view(p), 628, 4) {
                kind = MIR_LOCAL_TEMP;
            }
            while ((p.pos) < p.len && (unsafe { *(p.src + p.pos) }) != 10u8) {
                p.pos = p.pos + 1;
            }
        }
        unsafe {
            mir_add_local(mut_view(*body), mut_view(*arena), ty, kind, is_mut, StrId {
                v: 0u32
            }, view(dummy_span));
        }
    }

    loop {
        mp_skip_ws(mut_view(p));
        if mp_match_bytes(mut_view(p), 632, 1) || (p.pos) >= p.len {
            break;
        }
        if !mp_match_bytes(mut_view(p), 249, 2) {
            break;
        }
        let _bb_idx = mp_parse_u32(mut_view(p));
        let mut is_cleanup = mp_match_bytes(mut_view(p), 633, 9);
        mp_match_bytes(mut_view(p), 541, 1);
        if !is_cleanup {
            is_cleanup = mp_match_bytes(mut_view(p), 633, 9);
        }
        mp_match_bytes(mut_view(p), 608, 1);

        let bb_id = unsafe {
            mir_add_bb(mut_view(*body), mut_view(*arena), is_cleanup)
        };

        loop {
            mp_skip_ws(mut_view(p));
            if mp_match_bytes(mut_view(p), 632, 1) || (p.pos) >= p.len {
                break;
            }

            if mp_match_bytes(mut_view(p), 642, 12) {
                mp_match_bytes(mut_view(p), 502, 1);
                let loc = mp_parse_u32(mut_view(p));
                mp_match_bytes(mut_view(p), 654, 2);
                let mut stmt = MirStmt {
                    kind: MIR_STMT_STORAGE_LIVE,
                    span: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                    location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                    place: mir_local_place(0u32),
                    rvalue: MirRvalue {
                        kind: MIR_RVALUE_USE,
                        use_op: mir_op_copy_local(0u32),
                        repeat_count: 0u64,
                        repeat_count_op: 0 as *mut MirOperand,
                        borrow_kind: MIR_BORROW_SHARED,
                        place: mir_local_place(0u32),
                        cast_kind: MIR_CAST_INT_TO_INT,
                        target_ty: TypeId { v: 0u32 },
                        bin_op: MIR_BINOP_ADD,
                        lhs: mir_op_copy_local(0u32),
                        rhs: mir_op_copy_local(0u32),
                        un_op: MIR_UNOP_NOT,
                        variant_idx: 0u32,
                        operands: 0 as *mut MirOperand,
                        operand_count: 0,
                    },
                    storage_local: MirLocalId { v: loc },
                };
                let bb_ptr = unsafe {
                    mir_bb_at((*body).bbs, bb_id.v as usize)
                };
                unsafe {
                    mir_bb_push_stmt(mut_view(*bb_ptr), mut_view(*arena), view(stmt));
                }
                continue;
            }

            if mp_match_bytes(mut_view(p), 656, 12) {
                mp_match_bytes(mut_view(p), 502, 1);
                let loc = mp_parse_u32(mut_view(p));
                mp_match_bytes(mut_view(p), 654, 2);
                let mut stmt = MirStmt {
                    kind: MIR_STMT_STORAGE_DEAD,
                    span: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                    location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                    place: mir_local_place(0u32),
                    rvalue: MirRvalue {
                        kind: MIR_RVALUE_USE,
                        use_op: mir_op_copy_local(0u32),
                        repeat_count: 0u64,
                        repeat_count_op: 0 as *mut MirOperand,
                        borrow_kind: MIR_BORROW_SHARED,
                        place: mir_local_place(0u32),
                        cast_kind: MIR_CAST_INT_TO_INT,
                        target_ty: TypeId { v: 0u32 },
                        bin_op: MIR_BINOP_ADD,
                        lhs: mir_op_copy_local(0u32),
                        rhs: mir_op_copy_local(0u32),
                        un_op: MIR_UNOP_NOT,
                        variant_idx: 0u32,
                        operands: 0 as *mut MirOperand,
                        operand_count: 0,
                    },
                    storage_local: MirLocalId { v: loc },
                };
                let bb_ptr = unsafe {
                    mir_bb_at((*body).bbs, bb_id.v as usize)
                };
                unsafe {
                    mir_bb_push_stmt(mut_view(*bb_ptr), mut_view(*arena), view(stmt));
                }
                continue;
            }

            if mp_match_bytes(mut_view(p), 298, 5) {
                let mut stmt = MirStmt {
                    kind: MIR_STMT_DROP,
                    span: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                    location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                    place: mir_local_place(0u32),
                    rvalue: MirRvalue {
                        kind: MIR_RVALUE_USE,
                        use_op: mir_op_copy_local(0u32),
                        repeat_count: 0u64,
                        repeat_count_op: 0 as *mut MirOperand,
                        borrow_kind: MIR_BORROW_SHARED,
                        place: mir_local_place(0u32),
                        cast_kind: MIR_CAST_INT_TO_INT,
                        target_ty: TypeId { v: 0u32 },
                        bin_op: MIR_BINOP_ADD,
                        lhs: mir_op_copy_local(0u32),
                        rhs: mir_op_copy_local(0u32),
                        un_op: MIR_UNOP_NOT,
                        variant_idx: 0u32,
                        operands: 0 as *mut MirOperand,
                        operand_count: 0,
                    },
                    storage_local: MirLocalId { v: 0u32 },
                };
                mp_parse_place(mut_view(p), mut_view(*arena), mut_view(stmt.place));
                mp_match_bytes(mut_view(p), 654, 2);
                let bb_ptr = unsafe {
                    mir_bb_at((*body).bbs, bb_id.v as usize)
                };
                unsafe {
                    mir_bb_push_stmt(mut_view(*bb_ptr), mut_view(*arena), view(stmt));
                }
                continue;
            }

            if mp_match_bytes(mut_view(p), 668, 4) {
                mp_match_bytes(mut_view(p), 672, 2);
                mp_match_bytes(mut_view(p), 249, 2);
                let tgt = mp_parse_u32(mut_view(p));
                mp_match_bytes(mut_view(p), 560, 1);
                let bb_ptr = unsafe {
                    mir_bb_at((*body).bbs, bb_id.v as usize)
                };
                unsafe {
                    mir_term_zero(mut_view((*bb_ptr).terminator), MIR_TERM_GOTO);
                    (*bb_ptr).terminator.goto_target.v = tgt;
                    (*bb_ptr).has_terminator = true;
                }
                continue;
            }

            if mp_match_bytes(mut_view(p), 674, 7) {
                let bb_ptr = unsafe {
                    mir_bb_at((*body).bbs, bb_id.v as usize)
                };
                unsafe {
                    mir_term_zero(mut_view((*bb_ptr).terminator), MIR_TERM_RETURN);
                    (*bb_ptr).has_terminator = true;
                }
                continue;
            }

            if mp_match_bytes(mut_view(p), 681, 12) {
                let bb_ptr = unsafe {
                    mir_bb_at((*body).bbs, bb_id.v as usize)
                };
                unsafe {
                    mir_term_zero(mut_view((*bb_ptr).terminator), MIR_TERM_UNREACHABLE);
                    (*bb_ptr).has_terminator = true;
                }
                continue;
            }

            // `[explicit ]drop(...)`
            let is_exp_drop = mp_match_kw_8(mut_view(p), 101u8, 120u8, 112u8, 108u8, 105u8, 99u8, 105u8, 116u8);
            if is_exp_drop || mp_match_bytes(mut_view(p), 334, 5) {
                if is_exp_drop {
                    mp_match_bytes(mut_view(p), 334, 5);
                }
                let mut dplace = mir_local_place(0u32);
                mp_parse_place(mut_view(p), mut_view(*arena), mut_view(dplace));
                mp_match_bytes(mut_view(p), 503, 1);
                if mp_match_bytes(mut_view(p), 560, 1) {
                    // Statement `drop(_1);`
                    let mut stmt = MirStmt {
                        kind: MIR_STMT_DROP,
                        span: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                        place: mir_local_place(0u32),
                        rvalue: MirRvalue {
                            kind: MIR_RVALUE_USE,
                            use_op: mir_op_copy_local(0u32),
                            repeat_count: 0u64,
                            repeat_count_op: 0 as *mut MirOperand,
                            borrow_kind: MIR_BORROW_SHARED,
                            place: mir_local_place(0u32),
                            cast_kind: MIR_CAST_INT_TO_INT,
                            target_ty: TypeId { v: 0u32 },
                            bin_op: MIR_BINOP_ADD,
                            lhs: mir_op_copy_local(0u32),
                            rhs: mir_op_copy_local(0u32),
                            un_op: MIR_UNOP_NOT,
                            variant_idx: 0u32,
                            operands: 0 as *mut MirOperand,
                            operand_count: 0,
                        },
                        storage_local: MirLocalId { v: 0u32 },
                    };
                    mir_copy_place(mut_view(stmt.place), view(dplace));
                    let bb_ptr = unsafe {
                        mir_bb_at((*body).bbs, bb_id.v as usize)
                    };
                    unsafe {
                        mir_bb_push_stmt(mut_view(*bb_ptr), mut_view(*arena), view(stmt));
                    }
                    continue;
                }
                mp_match_bytes(mut_view(p), 672, 2);
                let mut dt: u32 = 0u32;
                let mut du: u32 = 0u32;
                mp_parse_return_unwind_targets(mut_view(p), mut_view(dt), mut_view(du));
                mp_match_bytes(mut_view(p), 560, 1);
                let bb_ptr = unsafe {
                    mir_bb_at((*body).bbs, bb_id.v as usize)
                };
                unsafe {
                    mir_term_zero(mut_view((*bb_ptr).terminator), MIR_TERM_DROP);
                    mir_copy_place(mut_view((*bb_ptr).terminator.drop_place), view(dplace));
                    (*bb_ptr).terminator.drop_target.v = dt;
                    (*bb_ptr).terminator.drop_unwind.v = du;
                    (*bb_ptr).terminator.drop_is_explicit = is_exp_drop;
                    (*bb_ptr).has_terminator = true;
                }
                continue;
            }

            if mp_match_bytes(mut_view(p), 351, 10) {
                let mut discr_op = mir_op_copy_local(0u32);
                mp_parse_operand(mut_view(p), mut_view(*interner), mut_view(*arena), type_map as *const TypeId, mut_view(discr_op));
                mp_match_bytes(mut_view(p), 503, 1);
                mp_match_bytes(mut_view(p), 672, 2);
                mp_match_bytes(mut_view(p), 498, 1);
                let mut vals: [32]u64 = [0u64; 32];
                let mut tgts: [32]u32 = [0u32; 32];
                let mut scount: usize = 0;
                let mut otherwise_bb: u32 = 0u32;
                loop {
                    mp_skip_ws(mut_view(p));
                    if mp_match_bytes(mut_view(p), 499, 1) || (p.pos) >= p.len {
                        break;
                    }
                    if mp_match_bytes(mut_view(p), 693, 10) {
                        mp_match_bytes(mut_view(p), 249, 2);
                        otherwise_bb = mp_parse_u32(mut_view(p));
                        mp_match_bytes(mut_view(p), 549, 1);
                        mp_match_bytes(mut_view(p), 499, 1);
                        break;
                    }
                    let v = mp_parse_u64(mut_view(p));
                    mp_match_bytes(mut_view(p), 541, 1);
                    mp_match_bytes(mut_view(p), 249, 2);
                    let t = mp_parse_u32(mut_view(p));
                    if scount < 32 {
                        vals[scount] = v;
                        tgts[scount] = t;
                        scount = scount + 1;
                    }
                    mp_match_bytes(mut_view(p), 549, 1);
                }
                mp_match_bytes(mut_view(p), 560, 1);
                let mut val_arr: *mut u64 = 0 as *mut u64;
                let mut tgt_arr: *mut MirBbId = 0 as *mut MirBbId;
                if scount > 0 {
                    let vbytes = mir_mul_usize(scount, size_of<u64>());
                    let tbytes = mir_mul_usize(scount, size_of<MirBbId>());
                    val_arr = arena_alloc_raw(mut_view(*arena), vbytes, align_of<u64>()) as *mut u64;
                    tgt_arr = arena_alloc_raw(mut_view(*arena), tbytes, align_of<MirBbId>()) as *mut MirBbId;
                    let mut k: usize = 0;
                    while (k < scount) {
                        let vp = unsafe {
                            mir_u64_at(val_arr, k)
                        };
                        let tp = unsafe {
                            mir_bb_id_at(tgt_arr, k)
                        };
                        unsafe {
                            *vp = vals[k];
                            (*tp).v = tgts[k];
                        }
                        k = k + 1;
                    }
                }
                let bb_ptr = unsafe {
                    mir_bb_at((*body).bbs, bb_id.v as usize)
                };
                unsafe {
                    mir_term_zero(mut_view((*bb_ptr).terminator), MIR_TERM_SWITCH_INT);
                    mir_copy_operand(mut_view((*bb_ptr).terminator.discr), view(discr_op));
                    (*bb_ptr).terminator.values = val_arr;
                    (*bb_ptr).terminator.targets = tgt_arr;
                    (*bb_ptr).terminator.switch_count = scount;
                    (*bb_ptr).terminator.otherwise.v = otherwise_bb;
                    (*bb_ptr).has_terminator = true;
                }
                continue;
            }

            if mp_match_bytes(mut_view(p), 387, 7) {
                let mut cond_op = mir_op_copy_local(0u32);
                mp_parse_operand(mut_view(p), mut_view(*interner), mut_view(*arena), type_map as *const TypeId, mut_view(cond_op));
                if !mp_match_bytes(mut_view(p), 51, 2) {
                    mp_match_bytes(mut_view(p), 549, 1);
                }
                let mut exp = true;
                if mp_match_bytes(mut_view(p), 703, 4) {
                    exp = true;
                } else if mp_match_bytes(mut_view(p), 707, 5) {
                    exp = false;
                }
                mp_match_bytes(mut_view(p), 549, 1);
                mp_skip_ws(mut_view(p));
                let mut mptr: *const u8 = 0 as *const u8;
                let mut mlen: usize = 0;
                if (p.pos) < p.len && (unsafe { *(p.src + p.pos) }) == 34u8 {
                    p.pos = p.pos + 1;
                    let mstart = p.pos;
                    while ((p.pos) < p.len && (unsafe { *(p.src + p.pos) }) != 34u8) {
                        p.pos = p.pos + 1;
                    }
                    mlen = p.pos - mstart;
                    let mbuf = arena_alloc_raw(mut_view(*arena), mlen + 1, 1);
                    if mlen > 0 {
                        unsafe {
                            ptr_copy_nonoverlapping<u8>(p.src + mstart, mbuf, mlen);
                        }
                    }
                    unsafe {
                        *(mbuf + mlen) = 0u8;
                    }
                    mptr = mbuf as *const u8;
                    if (p.pos) < p.len && (unsafe { *(p.src + p.pos) }) == 34u8 {
                        p.pos = p.pos + 1;
                    }
                }
                mp_match_bytes(mut_view(p), 503, 1);
                mp_match_bytes(mut_view(p), 672, 2);
                let mut at: u32 = 0u32;
                let mut au: u32 = 0u32;
                mp_parse_return_unwind_targets(mut_view(p), mut_view(at), mut_view(au));
                mp_match_bytes(mut_view(p), 560, 1);
                let bb_ptr = unsafe {
                    mir_bb_at((*body).bbs, bb_id.v as usize)
                };
                unsafe {
                    mir_term_zero(mut_view((*bb_ptr).terminator), MIR_TERM_ASSERT);
                    mir_copy_operand(mut_view((*bb_ptr).terminator.cond), view(cond_op));
                    (*bb_ptr).terminator.expected = exp;
                    (*bb_ptr).terminator.msg_ptr = mptr;
                    (*bb_ptr).terminator.msg_len = mlen;
                    (*bb_ptr).terminator.assert_target.v = at;
                    (*bb_ptr).terminator.assert_unwind.v = au;
                    (*bb_ptr).has_terminator = true;
                }
                continue;
            }

            // Call without destination (`call func(args) -> ...` OR `func(args) -> ...`)
            let has_call_kw = mp_match_bytes(mut_view(p), 712, 4);
            let mut is_void_call: bool = has_call_kw;
            if !is_void_call {
                let saved_vc = p.pos;
                if mp_match_bytes(mut_view(p), 528, 4) || mp_match_bytes(mut_view(p), 532, 4) || mp_match_bytes(mut_view(p), 536, 5) {
                    is_void_call = true;
                }
                p.pos = saved_vc;
            }
            if is_void_call {
                let mut func_op = mir_op_copy_local(0u32);
                mp_parse_operand(mut_view(p), mut_view(*interner), mut_view(*arena), type_map as *const TypeId, mut_view(func_op));
                mp_match_bytes(mut_view(p), 500, 1);
                let args_bytes = mir_mul_usize(16, size_of<MirOperand>());
                let args = arena_alloc_raw(mut_view(*arena), args_bytes, align_of<MirOperand>()) as *mut MirOperand;
                let mut argc: usize = 0;
                loop {
                    mp_skip_ws(mut_view(p));
                    if mp_match_bytes(mut_view(p), 503, 1) || (p.pos) >= p.len {
                        break;
                    }
                    let mut aop = mir_op_copy_local(0u32);
                    mp_parse_operand(mut_view(p), mut_view(*interner), mut_view(*arena), type_map as *const TypeId, mut_view(aop));
                    if argc < 16 {
                        let dst = unsafe {
                            mir_op_at(args, argc)
                        };
                        unsafe {
                            mir_copy_operand(mut_view(*dst), view(aop));
                        }
                        argc = argc + 1;
                    }
                    if !mp_match_bytes(mut_view(p), 549, 1) {
                        mp_match_bytes(mut_view(p), 503, 1);
                        break;
                    }
                }
                mp_match_bytes(mut_view(p), 672, 2);
                let mut ct: u32 = 0u32;
                let mut cu: u32 = 0u32;
                mp_parse_return_unwind_targets(mut_view(p), mut_view(ct), mut_view(cu));
                mp_match_bytes(mut_view(p), 560, 1);
                let mut arg_arr: *mut MirOperand = 0 as *mut MirOperand;
                if argc > 0 {
                    arg_arr = args;
                }
                let bb_ptr = unsafe {
                    mir_bb_at((*body).bbs, bb_id.v as usize)
                };
                unsafe {
                    mir_term_zero(mut_view((*bb_ptr).terminator), MIR_TERM_CALL);
                    mir_copy_operand(mut_view((*bb_ptr).terminator.func), view(func_op));
                    (*bb_ptr).terminator.args = arg_arr;
                    (*bb_ptr).terminator.arg_count = argc;
                    (*bb_ptr).terminator.has_destination = false;
                    (*bb_ptr).terminator.call_target.v = ct;
                    (*bb_ptr).terminator.call_unwind.v = cu;
                    (*bb_ptr).has_terminator = true;
                }
                continue;
            }

            // Assignment statement OR Call with destination (`dest = call func(...)` OR `dest = func(...) -> [...]`)
            let mut lhs_place = mir_local_place(0u32);
            mp_parse_place(mut_view(p), mut_view(*arena), mut_view(lhs_place));
            mp_match_bytes(mut_view(p), 716, 1);

            let mut is_dest_call: bool = mp_match_bytes(mut_view(p), 712, 4);
            if !is_dest_call {
                // Peek ahead: if `operand(` followed by `... -> [`, it's a call terminator!
                let saved_rhs = p.pos;
                if mp_match_bytes(mut_view(p), 528, 4) || mp_match_bytes(mut_view(p), 532, 4) || mp_match_bytes(mut_view(p), 536, 5) {
                    p.pos = saved_rhs;
                    let mut dummy_op = mir_op_copy_local(0u32);
                    mp_parse_operand(mut_view(p), mut_view(*interner), mut_view(*arena), type_map as *const TypeId, mut_view(dummy_op));
                    if mp_match_bytes(mut_view(p), 500, 1) {
                        is_dest_call = true;
                    }
                }
                p.pos = saved_rhs;
            }

            if is_dest_call {
                let mut func_op = mir_op_copy_local(0u32);
                mp_parse_operand(mut_view(p), mut_view(*interner), mut_view(*arena), type_map as *const TypeId, mut_view(func_op));
                mp_match_bytes(mut_view(p), 500, 1);
                let args_bytes = mir_mul_usize(16, size_of<MirOperand>());
                let args = arena_alloc_raw(mut_view(*arena), args_bytes, align_of<MirOperand>()) as *mut MirOperand;
                let mut argc: usize = 0;
                loop {
                    mp_skip_ws(mut_view(p));
                    if mp_match_bytes(mut_view(p), 503, 1) || (p.pos) >= p.len {
                        break;
                    }
                    let mut aop = mir_op_copy_local(0u32);
                    mp_parse_operand(mut_view(p), mut_view(*interner), mut_view(*arena), type_map as *const TypeId, mut_view(aop));
                    if argc < 16 {
                        let dst = unsafe {
                            mir_op_at(args, argc)
                        };
                        unsafe {
                            mir_copy_operand(mut_view(*dst), view(aop));
                        }
                        argc = argc + 1;
                    }
                    if !mp_match_bytes(mut_view(p), 549, 1) {
                        mp_match_bytes(mut_view(p), 503, 1);
                        break;
                    }
                }
                mp_match_bytes(mut_view(p), 672, 2);
                let mut ct: u32 = 0u32;
                let mut cu: u32 = 0u32;
                mp_parse_return_unwind_targets(mut_view(p), mut_view(ct), mut_view(cu));
                mp_match_bytes(mut_view(p), 560, 1);
                let mut arg_arr: *mut MirOperand = 0 as *mut MirOperand;
                if argc > 0 {
                    arg_arr = args;
                }
                let bb_ptr = unsafe {
                    mir_bb_at((*body).bbs, bb_id.v as usize)
                };
                unsafe {
                    mir_term_zero(mut_view((*bb_ptr).terminator), MIR_TERM_CALL);
                    mir_copy_operand(mut_view((*bb_ptr).terminator.func), view(func_op));
                    (*bb_ptr).terminator.args = arg_arr;
                    (*bb_ptr).terminator.arg_count = argc;
                    mir_copy_place(mut_view((*bb_ptr).terminator.destination), view(lhs_place));
                    (*bb_ptr).terminator.has_destination = true;
                    (*bb_ptr).terminator.call_target.v = ct;
                    (*bb_ptr).terminator.call_unwind.v = cu;
                    (*bb_ptr).has_terminator = true;
                }
            } else {
                let mut stmt = MirStmt {
                    kind: MIR_STMT_ASSIGN,
                    span: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                    location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
                    place: mir_local_place(0u32),
                    rvalue: MirRvalue {
                        kind: MIR_RVALUE_USE,
                        use_op: mir_op_copy_local(0u32),
                        repeat_count: 0u64,
                        repeat_count_op: 0 as *mut MirOperand,
                        borrow_kind: MIR_BORROW_SHARED,
                        place: mir_local_place(0u32),
                        cast_kind: MIR_CAST_INT_TO_INT,
                        target_ty: TypeId { v: 0u32 },
                        bin_op: MIR_BINOP_ADD,
                        lhs: mir_op_copy_local(0u32),
                        rhs: mir_op_copy_local(0u32),
                        un_op: MIR_UNOP_NOT,
                        variant_idx: 0u32,
                        operands: 0 as *mut MirOperand,
                        operand_count: 0,
                    },
                    storage_local: MirLocalId { v: 0u32 },
                };
                mir_copy_place(mut_view(stmt.place), view(lhs_place));
                mp_parse_rvalue(mut_view(p), mut_view(*interner), mut_view(*arena), type_map as *const TypeId, mut_view(stmt.rvalue));
                mp_match_bytes(mut_view(p), 560, 1);
                let bb_ptr = unsafe {
                    mir_bb_at((*body).bbs, bb_id.v as usize)
                };
                unsafe {
                    mir_bb_push_stmt(mut_view(*bb_ptr), mut_view(*arena), view(stmt));
                }
            }
        }
    }
    body
}

module _own_mir_shim
use compiler.mir.mir.MirBb
use compiler.mir.mir.MirStmt
use compiler.mir.mir.MIR_TERM_DROP
use compiler.mir.mir.mir_bb_at as raw_mir_bb_at
use compiler.mir.mir.mir_stmt_at as raw_mir_stmt_at
pub unsafe fn _shim_mir_bb_at(base: *mut MirBb, idx: usize) -> *mut MirBb {
    let bb = raw_mir_bb_at(base, idx);
    if (*bb).terminator.location.file.v == 0u32 {
        (*bb).terminator.location = (*bb).terminator.span;
    }
    if (*bb).terminator.kind == MIR_TERM_DROP {
        (*bb).terminator.expected = (*bb).terminator.drop_is_explicit;
    }
    bb
}
pub unsafe fn _shim_mir_stmt_at(base: *mut MirStmt, idx: usize) -> *mut MirStmt {
    let st = raw_mir_stmt_at(base, idx);
    if (*st).location.file.v == 0u32 {
        (*st).location = (*st).span;
    }
    st
}

// Capability tracking (view / mut_view), region conflict checking, and borrow lifetime analysis.
// Port of bootstrap/axiom0/src/mir/cap/cap.h, cap.c, mir/regions/region.c, and own/cap/cap.c.
// T157 (SPEC-11 AXS-CAP-008/009, ADR-0036): the owner-outlives check on a drop or move of the owner
// only reports a holder that is still used afterwards (a view local is active until its last use),
// and a capability consumed by a cast (the `address_of` lowering `_t = &place; _p = copy _t as *T`)
// ends at that cast when the temporary is not used again (a raw pointer holds no capability).
// Same algorithm as axiom0 (ADR-0034 section 2): `cap_local_used_from` searches the normal
// (non-unwind) CFG edges forward from the current position.
module compiler.own.cap

use host_intrinsics.heap_alloc
