pub const MIR_BB_INVALID: u32 = 0xFFFFFFFFu32;
pub const MIR_DROP_FLAG_NONE: u32 = 0xFFFFFFFFu32;
pub const MIR_BB_NONE: u32 = 0xFFFFFFFFu32;

