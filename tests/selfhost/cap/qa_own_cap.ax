struct HirDumpState {
    indent: i32,
    filter_file: FileId,
}

fn hd_str(st: mut_view<HirDumpState>, buf: mut_view<DiagBuffer>, interner: view<StrInterner>, idx: usize) {
    let start = HIR_OFF[idx] as usize;
    let end = HIR_OFF[idx + 1] as usize;
    let mut i = start;
    while (i < end) {
        unsafe { diag_buf_push_byte(mut_view(*buf), HIR_DATA[i]); }
        i = i + 1;
    }
}

fn hd_nl(st: mut_view<HirDumpState>, buf: mut_view<DiagBuffer>, interner: view<StrInterner>) {
    unsafe { diag_buf_push_byte(mut_view(*buf), 10u8); }
    let mut i: i32 = 0;
    while (i < st.indent) {
        hd_str(mut_view(*st), mut_view(*buf), view(*interner), 0);
        i = i + 1;
    }
}

fn hd_begin(st: mut_view<HirDumpState>, buf: mut_view<DiagBuffer>, interner: view<StrInterner>, idx: usize) {
    unsafe { diag_buf_push_byte(mut_view(*buf), 40u8); }
    hd_str(mut_view(*st), mut_view(*buf), view(*interner), idx);
    st.indent = st.indent + 1;
}

fn hd_end(st: mut_view<HirDumpState>, buf: mut_view<DiagBuffer>, interner: view<StrInterner>) {
    st.indent = st.indent - 1;
    unsafe { diag_buf_push_byte(mut_view(*buf), 41u8); }
}

fn hd_strid(st: mut_view<HirDumpState>, buf: mut_view<DiagBuffer>, interner: view<StrInterner>, id: StrId) {
    if id.v == 0u32 {
        hd_str(mut_view(*st), mut_view(*buf), view(*interner), 2);
        return;
    }
    let sv = unsafe { interner_get(view(*interner), id) };
    hd_str(mut_view(*st), mut_view(*buf), view(*interner), 1);
    unsafe {
        diag_buf_push_bytes(mut_view(*buf), sv.ptr, sv.len);
        diag_buf_push_byte(mut_view(*buf), 34u8);
    }
}

fn hd_bool(st: mut_view<HirDumpState>, buf: mut_view<DiagBuffer>, interner: view<StrInterner>, b: bool) {
    if b {
        hd_str(mut_view(*st), mut_view(*buf), view(*interner), 3);
    } else {
        hd_str(mut_view(*st), mut_view(*buf), view(*interner), 4);
    }
}

fn hd_u32(st: mut_view<HirDumpState>, buf: mut_view<DiagBuffer>, interner: view<StrInterner>, v: u32) {
    unsafe {
        diag_buf_push_byte(mut_view(*buf), 32u8);
        diag_buf_push_u32(mut_view(*buf), v);
    }
}

fn hd_symbol(st: mut_view<HirDumpState>, buf: mut_view<DiagBuffer>, interner: view<StrInterner>, sym: SymbolId) {
    if sym.v != 0u32 {
        hd_str(mut_view(*st), mut_view(*buf), view(*interner), 5);
        unsafe { diag_buf_push_u32(mut_view(*buf), sym.v); }
    }
}

fn hd_dotted(st: mut_view<HirDumpState>, buf: mut_view<DiagBuffer>, interner: view<StrInterner>, n: view<AstDottedName>) {
    hd_nl(mut_view(*st), mut_view(*buf), view(*interner));
    hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 6);
    let mut i: usize = 0;
    while (i < n.count) {
        let off = ((i as isize) * (size_of<StrId>() as isize)) as usize;
        let seg_ptr = ((n.segments as usize) + off) as *const StrId;
        hd_strid(mut_view(*st), mut_view(*buf), view(*interner), unsafe { *seg_ptr });
        i = i + 1;
    }
    hd_end(mut_view(*st), mut_view(*buf), view(*interner));
}

fn hd_vis(st: mut_view<HirDumpState>, buf: mut_view<DiagBuffer>, interner: view<StrInterner>, n: view<HirVis>) {
    hd_nl(mut_view(*st), mut_view(*buf), view(*interner));
    hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 7);
    if n.kind == HIR_VIS_PRIVATE {
        hd_str(mut_view(*st), mut_view(*buf), view(*interner), 8);
    } else if n.kind == HIR_VIS_PUB {
        hd_str(mut_view(*st), mut_view(*buf), view(*interner), 9);
    } else if n.kind == HIR_VIS_PUB_PACKAGE {
        hd_str(mut_view(*st), mut_view(*buf), view(*interner), 10);
    } else if n.kind == HIR_VIS_PUB_MODULE {
        hd_str(mut_view(*st), mut_view(*buf), view(*interner), 11);
    }
    hd_end(mut_view(*st), mut_view(*buf), view(*interner));
}

fn hd_attr(st: mut_view<HirDumpState>, buf: mut_view<DiagBuffer>, interner: view<StrInterner>, n: *mut HirAttr) {
    let mut cur = n;
    while (cur as usize) != 0 {
        hd_nl(mut_view(*st), mut_view(*buf), view(*interner));
        hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 12);
        hd_strid(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).name });
        let mut a: *mut HirAttrArg = unsafe { (*cur).args };
        while (a as usize) != 0 {
            hd_nl(mut_view(*st), mut_view(*buf), view(*interner));
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 13);
            hd_strid(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*a).name });
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*a).expr });
            hd_end(mut_view(*st), mut_view(*buf), view(*interner));
            a = unsafe { (*a).next };
        }
        hd_end(mut_view(*st), mut_view(*buf), view(*interner));
        cur = unsafe { (*cur).next };
    }
}

fn hd_generic_args(st: mut_view<HirDumpState>, buf: mut_view<DiagBuffer>, interner: view<StrInterner>, n: *mut HirGenericArgs) {
    if (n as usize) == 0 {
        return;
    }
    let mut a: *mut HirGenericArg = unsafe { (*n).args };
    while (a as usize) != 0 {
        hd_nl(mut_view(*st), mut_view(*buf), view(*interner));
        hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 14);
        hd_strid(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*a).name });
        hd_type(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*a).ty });
        hd_end(mut_view(*st), mut_view(*buf), view(*interner));
        a = unsafe { (*a).next };
    }
}

fn hd_generic_params(st: mut_view<HirDumpState>, buf: mut_view<DiagBuffer>, interner: view<StrInterner>, n: *mut HirGenericParams) {
    if (n as usize) == 0 {
        return;
    }
    let mut a: *mut HirGenericParam = unsafe { (*n).params };
    while (a as usize) != 0 {
        hd_nl(mut_view(*st), mut_view(*buf), view(*interner));
        hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 15);
        hd_strid(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*a).name });
        hd_type(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*a).bounds });
        hd_end(mut_view(*st), mut_view(*buf), view(*interner));
        a = unsafe { (*a).next };
    }
}

fn hd_where_clause(st: mut_view<HirDumpState>, buf: mut_view<DiagBuffer>, interner: view<StrInterner>, n: *mut HirWhereClause) {
    if (n as usize) == 0 {
        return;
    }
    let mut a: *mut HirWherePred = unsafe { (*n).preds };
    while (a as usize) != 0 {
        hd_nl(mut_view(*st), mut_view(*buf), view(*interner));
        hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 16);
        hd_type(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*a).ty });
        hd_type(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*a).bounds });
        hd_end(mut_view(*st), mut_view(*buf), view(*interner));
        a = unsafe { (*a).next };
    }
}

fn hd_path(st: mut_view<HirDumpState>, buf: mut_view<DiagBuffer>, interner: view<StrInterner>, p: view<HirPath>) {
    hd_symbol(mut_view(*st), mut_view(*buf), view(*interner), p.symbol);
    hd_generic_args(mut_view(*st), mut_view(*buf), view(*interner), p.generic_args);
}

fn hd_block(st: mut_view<HirDumpState>, buf: mut_view<DiagBuffer>, interner: view<StrInterner>, n: *mut HirBlock) {
    hd_nl(mut_view(*st), mut_view(*buf), view(*interner));
    hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 17);
    if (n as usize) != 0 {
        hd_stmt(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*n).stmts });
    }
    hd_end(mut_view(*st), mut_view(*buf), view(*interner));
}

fn hd_type(st: mut_view<HirDumpState>, buf: mut_view<DiagBuffer>, interner: view<StrInterner>, n: *mut HirType) {
    let mut cur = n;
    while (cur as usize) != 0 {
        hd_nl(mut_view(*st), mut_view(*buf), view(*interner));
        let k = unsafe { (*cur).kind };
        if k == HIR_TYPE_ERROR {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 18);
        } else if k == HIR_TYPE_PATH {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 19);
            hd_path(mut_view(*st), mut_view(*buf), view(*interner), unsafe { view((*cur).path) });
        } else if k == HIR_TYPE_TUPLE {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 20);
            hd_type(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).elem_types });
        } else if k == HIR_TYPE_ARRAY {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 21);
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).count_expr });
            hd_type(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).elem });
        } else if k == HIR_TYPE_SLICE {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 22);
            hd_type(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).elem });
        } else if k == HIR_TYPE_VIEW {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 23);
            hd_bool(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).is_mut });
            hd_type(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).elem });
        } else if k == HIR_TYPE_PTR {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 24);
            hd_bool(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).is_mut });
            hd_type(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).elem });
        } else if k == HIR_TYPE_FN {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 25);
            hd_bool(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).is_unsafe });
            hd_strid(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).abi });
            hd_type(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).param_types });
            hd_type(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).ret_type });
        } else if k == HIR_TYPE_DYN {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 26);
            hd_type(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).bounds });
        }
        hd_end(mut_view(*st), mut_view(*buf), view(*interner));
        cur = unsafe { (*cur).next };
    }
}

fn hd_pat_field(st: mut_view<HirDumpState>, buf: mut_view<DiagBuffer>, interner: view<StrInterner>, n: *mut HirPatField) {
    let mut cur = n;
    while (cur as usize) != 0 {
        hd_nl(mut_view(*st), mut_view(*buf), view(*interner));
        hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 27);
        hd_strid(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).name });
        hd_pat(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).pat });
        hd_end(mut_view(*st), mut_view(*buf), view(*interner));
        cur = unsafe { (*cur).next };
    }
}

fn hd_pat(st: mut_view<HirDumpState>, buf: mut_view<DiagBuffer>, interner: view<StrInterner>, n: *mut HirPat) {
    let mut cur = n;
    while (cur as usize) != 0 {
        hd_nl(mut_view(*st), mut_view(*buf), view(*interner));
        let k = unsafe { (*cur).kind };
        if k == HIR_PAT_ERROR {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 28);
        } else if k == HIR_PAT_WILDCARD {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 29);
        } else if k == HIR_PAT_RANGE {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 30);
            hd_bool(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).is_inclusive });
            hd_pat(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).start_pat });
            hd_pat(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).end_pat });
        } else if k == HIR_PAT_LITERAL {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 31);
            hd_bool(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).is_negated });
        } else if k == HIR_PAT_BINDING {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 32);
            hd_bool(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).is_mut });
            hd_symbol(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).symbol });
        } else if k == HIR_PAT_PATH {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 33);
            hd_path(mut_view(*st), mut_view(*buf), view(*interner), unsafe { view((*cur).path) });
            hd_pat(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).payload });
        } else if k == HIR_PAT_TUPLE {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 34);
            hd_pat(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).elems });
        } else if k == HIR_PAT_OR {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 35);
            hd_pat(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).pats });
        } else if k == HIR_PAT_STRUCT {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 36);
            hd_path(mut_view(*st), mut_view(*buf), view(*interner), unsafe { view((*cur).path) });
            hd_pat_field(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).fields });
            hd_bool(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).has_rest });
        }
        hd_end(mut_view(*st), mut_view(*buf), view(*interner));
        cur = unsafe { (*cur).next };
    }
}

fn hd_expr(st: mut_view<HirDumpState>, buf: mut_view<DiagBuffer>, interner: view<StrInterner>, n: *mut HirExpr) {
    let mut cur = n;
    while (cur as usize) != 0 {
        hd_nl(mut_view(*st), mut_view(*buf), view(*interner));
        let k = unsafe { (*cur).kind };
        if k == HIR_EXPR_ERROR {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 37);
        } else if k == HIR_EXPR_LITERAL {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 38);
        } else if k == HIR_EXPR_PATH {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 39);
            hd_path(mut_view(*st), mut_view(*buf), view(*interner), unsafe { view((*cur).path) });
        } else if k == HIR_EXPR_ARRAY {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 40);
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).elems });
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).count_expr });
        } else if k == HIR_EXPR_TUPLE {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 41);
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).elems });
        } else if k == HIR_EXPR_STRUCT {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 42);
            hd_path(mut_view(*st), mut_view(*buf), view(*interner), unsafe { view((*cur).path) });
            let mut f: *mut HirFieldInit = unsafe { (*cur).fields };
            while (f as usize) != 0 {
                hd_nl(mut_view(*st), mut_view(*buf), view(*interner));
                hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 43);
                hd_strid(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*f).name });
                hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*f).expr });
                hd_end(mut_view(*st), mut_view(*buf), view(*interner));
                f = unsafe { (*f).next };
            }
        } else if k == HIR_EXPR_BLOCK {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 44);
            hd_block(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).block });
        } else if k == HIR_EXPR_IF {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 45);
            hd_pat(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).let_pat });
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).cond });
            hd_block(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).block });
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).else_branch });
        } else if k == HIR_EXPR_MATCH {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 46);
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).cond });
            let mut a: *mut HirMatchArm = unsafe { (*cur).arms };
            while (a as usize) != 0 {
                hd_nl(mut_view(*st), mut_view(*buf), view(*interner));
                hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 47);
                hd_pat(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*a).pat });
                hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*a).guard });
                hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*a).body });
                hd_end(mut_view(*st), mut_view(*buf), view(*interner));
                a = unsafe { (*a).next };
            }
        } else if k == HIR_EXPR_LOOP {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 48);
            hd_strid(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).label });
            hd_block(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).block });
        } else if k == HIR_EXPR_WHILE {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 49);
            hd_strid(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).label });
            hd_pat(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).let_pat });
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).cond });
            hd_block(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).block });
        } else if k == HIR_EXPR_FOR {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 50);
            hd_strid(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).label });
            hd_pat(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).pat });
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).iter });
            hd_block(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).block });
        } else if k == HIR_EXPR_UNSAFE {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 51);
            hd_block(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).block });
        } else if k == HIR_EXPR_VIEW {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 52);
            hd_bool(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).is_mut });
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).inner });
        } else if k == HIR_EXPR_COMPTIME {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 53);
            hd_block(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).block });
        } else if k == HIR_EXPR_JUMP {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 54);
            hd_u32(mut_view(*st), mut_view(*buf), view(*interner), (unsafe { (*cur).jump_kind }) as u32);
            hd_strid(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).label });
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).inner });
        } else if k == HIR_EXPR_CLOSURE {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 55);
            let mut p: *mut HirParam = unsafe { (*cur).params };
            while (p as usize) != 0 {
                hd_nl(mut_view(*st), mut_view(*buf), view(*interner));
                hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 56);
                hd_bool(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*p).is_mut });
                hd_symbol(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*p).symbol });
                hd_type(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*p).ty });
                hd_end(mut_view(*st), mut_view(*buf), view(*interner));
                p = unsafe { (*p).next };
            }
            hd_type(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).ret_type });
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).body });
        } else if k == HIR_EXPR_RANGE {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 57);
            hd_bool(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).is_inclusive });
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).start_expr });
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).end_expr });
        } else if k == HIR_EXPR_BINARY {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 58);
            hd_u32(mut_view(*st), mut_view(*buf), view(*interner), (unsafe { (*cur).op }) as u32);
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).left });
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).right });
        } else if k == HIR_EXPR_UNARY {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 59);
            hd_u32(mut_view(*st), mut_view(*buf), view(*interner), (unsafe { (*cur).op }) as u32);
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).inner });
        } else if k == HIR_EXPR_CAST {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 60);
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).inner });
            hd_type(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).cast_ty });
        } else if k == HIR_EXPR_FIELD {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 61);
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).base });
            hd_strid(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).name });
            hd_generic_args(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).generic_args });
        } else if k == HIR_EXPR_TUPLE_INDEX {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 62);
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).base });
            hd_u32(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).tuple_index });
        } else if k == HIR_EXPR_CALL {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 63);
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).callee });
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).args });
        } else if k == HIR_EXPR_METHOD_CALL {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 64);
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).receiver });
            hd_strid(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).method_name });
            hd_generic_args(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).generic_args });
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).args });
        } else if k == HIR_EXPR_INDEX {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 65);
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).base });
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).index_arg });
        } else if k == HIR_EXPR_TRY {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 66);
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).inner });
        } else if k == HIR_EXPR_AWAIT {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 67);
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).inner });
        }
        hd_end(mut_view(*st), mut_view(*buf), view(*interner));
        cur = unsafe { (*cur).next };
    }
}

fn hd_use_tree(st: mut_view<HirDumpState>, buf: mut_view<DiagBuffer>, interner: view<StrInterner>, n: *mut HirUseTree) {
    if (n as usize) == 0 {
        return;
    }
    hd_nl(mut_view(*st), mut_view(*buf), view(*interner));
    hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 68);
    hd_dotted(mut_view(*st), mut_view(*buf), view(*interner), unsafe { view((*n).path) });
    if (unsafe { (*n).alias.v }) != 0u32 {
        hd_strid(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*n).alias });
    }
    if (unsafe { (*n).subtrees as usize }) != 0 {
        hd_use_tree(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*n).subtrees });
    }
    hd_end(mut_view(*st), mut_view(*buf), view(*interner));
    if (unsafe { (*n).next as usize }) != 0 {
        hd_use_tree(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*n).next });
    }
}

fn hd_stmt(st: mut_view<HirDumpState>, buf: mut_view<DiagBuffer>, interner: view<StrInterner>, n: *mut HirStmt) {
    let mut cur = n;
    while (cur as usize) != 0 {
        hd_nl(mut_view(*st), mut_view(*buf), view(*interner));
        let k = unsafe { (*cur).kind };
        if k == HIR_STMT_ERROR {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 69);
        } else if k == HIR_STMT_LET {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 70);
            hd_pat(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).pat });
            hd_type(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).ty });
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).expr });
            if (unsafe { (*cur).else_block as usize }) != 0 {
                hd_block(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).else_block });
            }
        } else if k == HIR_STMT_ASSIGN {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 71);
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).left });
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).right });
        } else if k == HIR_STMT_EXPR {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 72);
            hd_bool(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).has_semi });
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).expr });
        }
        hd_end(mut_view(*st), mut_view(*buf), view(*interner));
        cur = unsafe { (*cur).next };
    }
}

fn hd_item(st: mut_view<HirDumpState>, buf: mut_view<DiagBuffer>, interner: view<StrInterner>, n: *mut HirItem) {
    let mut cur = n;
    while (cur as usize) != 0 {
        let next_cur: *mut HirItem = unsafe { (*cur).next };
        let skip = st.filter_file.v != 0u32 && (unsafe { (*cur).span.file.v }) != 0u32 && (unsafe { (*cur).span.file.v }) != st.filter_file.v;
        if !skip {
        hd_nl(mut_view(*st), mut_view(*buf), view(*interner));
        let k = unsafe { (*cur).kind };
        if k == HIR_ITEM_ERROR {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 73);
        } else if k == HIR_ITEM_MODULE {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 74);
            hd_attr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).attrs });
            hd_vis(mut_view(*st), mut_view(*buf), view(*interner), unsafe { view((*cur).vis) });
            hd_dotted(mut_view(*st), mut_view(*buf), view(*interner), unsafe { view((*cur).mod_path) });
        } else if k == HIR_ITEM_USE {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 75);
            hd_attr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).attrs });
            hd_vis(mut_view(*st), mut_view(*buf), view(*interner), unsafe { view((*cur).vis) });
            hd_use_tree(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).use_tree });
        } else if k == HIR_ITEM_FN {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 76);
            hd_attr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).attrs });
            hd_vis(mut_view(*st), mut_view(*buf), view(*interner), unsafe { view((*cur).vis) });
            hd_bool(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).is_async });
            hd_bool(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).is_comptime });
            hd_bool(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).is_unsafe });
            hd_strid(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).abi });
            hd_strid(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).name });
            hd_generic_params(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).generic_params });
            let mut p: *mut HirParam = unsafe { (*cur).params };
            while (p as usize) != 0 {
                hd_nl(mut_view(*st), mut_view(*buf), view(*interner));
                hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 56);
                hd_bool(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*p).is_mut });
                hd_symbol(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*p).symbol });
                hd_type(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*p).ty });
                hd_end(mut_view(*st), mut_view(*buf), view(*interner));
                p = unsafe { (*p).next };
            }
            hd_type(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).ret_type });
            hd_where_clause(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).where_clause });
            if (unsafe { (*cur).body as usize }) != 0 {
                hd_block(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).body });
            }
        } else if k == HIR_ITEM_STRUCT {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 77);
            hd_attr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).attrs });
            hd_vis(mut_view(*st), mut_view(*buf), view(*interner), unsafe { view((*cur).vis) });
            hd_strid(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).name });
            hd_generic_params(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).generic_params });
            hd_where_clause(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).where_clause });
            hd_bool(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).is_tuple });
            if unsafe { (*cur).is_tuple } {
                hd_type(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).tuple_types });
            } else {
                let mut f: *mut HirFieldDecl = unsafe { (*cur).struct_fields };
                while (f as usize) != 0 {
                    hd_nl(mut_view(*st), mut_view(*buf), view(*interner));
                    hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 78);
                    hd_attr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*f).attrs });
                    hd_vis(mut_view(*st), mut_view(*buf), view(*interner), unsafe { view((*f).vis) });
                    hd_strid(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*f).name });
                    hd_type(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*f).ty });
                    hd_end(mut_view(*st), mut_view(*buf), view(*interner));
                    f = unsafe { (*f).next };
                }
            }
        } else if k == HIR_ITEM_ENUM {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 79);
            hd_attr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).attrs });
            hd_vis(mut_view(*st), mut_view(*buf), view(*interner), unsafe { view((*cur).vis) });
            hd_strid(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).name });
            hd_generic_params(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).generic_params });
            hd_where_clause(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).where_clause });
            let mut v: *mut HirVariantDecl = unsafe { (*cur).variants };
            while (v as usize) != 0 {
                hd_nl(mut_view(*st), mut_view(*buf), view(*interner));
                hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 80);
                hd_attr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*v).attrs });
                hd_strid(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*v).name });
                hd_bool(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*v).is_struct });
                if unsafe { (*v).is_struct } {
                    let mut f: *mut HirFieldDecl = unsafe { (*v).struct_fields };
                    while (f as usize) != 0 {
                        hd_nl(mut_view(*st), mut_view(*buf), view(*interner));
                        hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 78);
                        hd_attr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*f).attrs });
                        hd_vis(mut_view(*st), mut_view(*buf), view(*interner), unsafe { view((*f).vis) });
                        hd_strid(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*f).name });
                        hd_type(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*f).ty });
                        hd_end(mut_view(*st), mut_view(*buf), view(*interner));
                        f = unsafe { (*f).next };
                    }
                } else {
                    hd_type(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*v).tuple_types });
                }
                hd_end(mut_view(*st), mut_view(*buf), view(*interner));
                v = unsafe { (*v).next };
            }
        } else if k == HIR_ITEM_TRAIT {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 81);
            hd_attr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).attrs });
            hd_vis(mut_view(*st), mut_view(*buf), view(*interner), unsafe { view((*cur).vis) });
            hd_strid(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).name });
            hd_generic_params(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).generic_params });
            hd_type(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).supertraits });
            hd_where_clause(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).where_clause });
            hd_item(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).members });
        } else if k == HIR_ITEM_IMPL {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 82);
            hd_attr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).attrs });
            hd_vis(mut_view(*st), mut_view(*buf), view(*interner), unsafe { view((*cur).vis) });
            hd_generic_params(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).generic_params });
            hd_type(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).trait_path });
            hd_type(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).self_type });
            hd_where_clause(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).where_clause });
            hd_item(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).members });
        } else if k == HIR_ITEM_TYPE_ALIAS {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 83);
            hd_attr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).attrs });
            hd_vis(mut_view(*st), mut_view(*buf), view(*interner), unsafe { view((*cur).vis) });
            hd_strid(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).name });
            hd_generic_params(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).generic_params });
            hd_type(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).ty });
        } else if k == HIR_ITEM_CONST {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 84);
            hd_attr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).attrs });
            hd_vis(mut_view(*st), mut_view(*buf), view(*interner), unsafe { view((*cur).vis) });
            hd_strid(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).name });
            hd_type(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).ty });
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).expr });
        } else if k == HIR_ITEM_STATIC {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 85);
            hd_attr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).attrs });
            hd_vis(mut_view(*st), mut_view(*buf), view(*interner), unsafe { view((*cur).vis) });
            hd_bool(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).is_unsafe });
            hd_bool(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).is_mut });
            hd_strid(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).name });
            hd_type(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).ty });
            hd_expr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).expr });
        } else if k == HIR_ITEM_EXTERN_BLOCK {
            hd_begin(mut_view(*st), mut_view(*buf), view(*interner), 86);
            hd_attr(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).attrs });
            hd_vis(mut_view(*st), mut_view(*buf), view(*interner), unsafe { view((*cur).vis) });
            hd_strid(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).abi });
            hd_item(mut_view(*st), mut_view(*buf), view(*interner), unsafe { (*cur).members });
        }
            hd_end(mut_view(*st), mut_view(*buf), view(*interner));
        }
        cur = next_cur;
    }
}

pub fn emit_hir(buf: mut_view<DiagBuffer>, hf: view<HirFile>, interner: view<StrInterner>, filter_file: FileId) {
    let mut st = HirDumpState {
        indent: 0,
        filter_file: FileId { v: filter_file.v },
    };
    hd_item(mut_view(st), mut_view(*buf), view(*interner), hf.items);
    unsafe { diag_buf_push_byte(buf, 10u8); }
}

// Type system data model, type interning, constant evaluation model, and THIR maps.
