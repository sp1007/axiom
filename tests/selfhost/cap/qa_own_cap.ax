@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

// "cannot create a mutable view because it conflicts with an existing view" (71 bytes)
const CAP_MSG_CONFLICT_MUT: [71]u8 = [
    99u8, 97u8, 110u8, 110u8, 111u8, 116u8, 32u8, 99u8, 114u8, 101u8, 97u8, 116u8, 101u8, 32u8, 97u8, 32u8,
    109u8, 117u8, 116u8, 97u8, 98u8, 108u8, 101u8, 32u8, 118u8, 105u8, 101u8, 119u8, 32u8, 98u8, 101u8, 99u8,
    97u8, 117u8, 115u8, 101u8, 32u8, 105u8, 116u8, 32u8, 99u8, 111u8, 110u8, 102u8, 108u8, 105u8, 99u8, 116u8,
    115u8, 32u8, 119u8, 105u8, 116u8, 104u8, 32u8, 97u8, 110u8, 32u8, 101u8, 120u8, 105u8, 115u8, 116u8, 105u8,
    110u8, 103u8, 32u8, 118u8, 105u8, 101u8, 119u8
];

// "cannot create a read view because the place is mutably viewed" (61 bytes)
const CAP_MSG_CONFLICT_READ: [61]u8 = [
    99u8, 97u8, 110u8, 110u8, 111u8, 116u8, 32u8, 99u8, 114u8, 101u8, 97u8, 116u8, 101u8, 32u8, 97u8, 32u8,
    114u8, 101u8, 97u8, 100u8, 32u8, 118u8, 105u8, 101u8, 119u8, 32u8, 98u8, 101u8, 99u8, 97u8, 117u8, 115u8,
    101u8, 32u8, 116u8, 104u8, 101u8, 32u8, 112u8, 108u8, 97u8, 99u8, 101u8, 32u8, 105u8, 115u8, 32u8, 109u8,
    117u8, 116u8, 97u8, 98u8, 108u8, 121u8, 32u8, 118u8, 105u8, 101u8, 119u8, 101u8, 100u8
];

// "active view outlives its originating owner place" (48 bytes)
const CAP_MSG_OUTLIVES_OWNER: [48]u8 = [
    97u8, 99u8, 116u8, 105u8, 118u8, 101u8, 32u8, 118u8, 105u8, 101u8, 119u8, 32u8, 111u8, 117u8, 116u8, 108u8,
    105u8, 118u8, 101u8, 115u8, 32u8, 105u8, 116u8, 115u8, 32u8, 111u8, 114u8, 105u8, 103u8, 105u8, 110u8, 97u8,
    116u8, 105u8, 110u8, 103u8, 32u8, 111u8, 119u8, 110u8, 101u8, 114u8, 32u8, 112u8, 108u8, 97u8, 99u8, 101u8
];

pub struct MirCap {
    pub place: MirPlace,
    pub view_kind: u8,
}

pub struct MirCapTracker {
    pub caps: *mut MirCap,
    pub count: usize,
    pub capacity: usize,
}

pub struct CapState {
    pub caps: *mut MirCap,
}

pub unsafe fn mir_cap_at(base: *const MirCap, idx: usize) -> *const MirCap {
    ((base as usize) + mul_usize(idx, size_of<MirCap>())) as *const MirCap
}

pub unsafe fn mir_cap_at_mut(base: *mut MirCap, idx: usize) -> *mut MirCap {
    ((base as usize) + mul_usize(idx, size_of<MirCap>())) as *mut MirCap
}

unsafe fn cap_state_at_mut(base: *mut CapState, idx: usize) -> *mut CapState {
    ((base as usize) + mul_usize(idx, size_of<CapState>())) as *mut CapState
}

pub fn own_region_relate(a: view<MirPlace>, b: view<MirPlace>) -> u8 {
    if a.local.v != b.local.v {
        return MIR_REGION_DISJOINT;
    }
    let min_len = if (a.proj_count) < b.proj_count { a.proj_count } else { b.proj_count };
    let mut i: usize = 0;
    while (i < min_len) {
        let pa = unsafe { mir_proj_at(a.projs, i) };
        let pb = unsafe { mir_proj_at(b.projs, i) };
        let ka = unsafe { (*pa).kind };
        let kb = unsafe { (*pb).kind };
        if ka != kb {
            return MIR_REGION_UNKNOWN;
        }
        if ka == MIR_PROJ_FIELD {
            let fa = unsafe { (*pa).field_idx };
            let fb = unsafe { (*pb).field_idx };
            if fa != fb {
                return MIR_REGION_DISJOINT;
            }
        } else if ka == MIR_PROJ_INDEX {
            let ia = unsafe { (*pa).index_local.v };
            let ib = unsafe { (*pb).index_local.v };
            if ia != ib {
                return MIR_REGION_UNKNOWN;
            }
        } else if ka == MIR_PROJ_DOWNCAST {
            let va = unsafe { (*pa).variant_idx };
            let vb = unsafe { (*pb).variant_idx };
            if va != vb {
                return MIR_REGION_DISJOINT;
            }
        } else if ka == MIR_PROJ_SUB_SLICE {
            let hfa = unsafe { (*pa).has_from };
            let hfb = unsafe { (*pb).has_from };
            let fa = unsafe { (*pa).from_local.v };
            let fb = unsafe { (*pb).from_local.v };
            let hta = unsafe { (*pa).has_to };
            let htb = unsafe { (*pb).has_to };
            let ta = unsafe { (*pa).to_local.v };
            let tb = unsafe { (*pb).to_local.v };
            if hfa && htb && fa == tb {
                return MIR_REGION_DISJOINT;
            }
            if hta && hfb && ta == fb {
                return MIR_REGION_DISJOINT;
            }
            if hfa && hfb && fa == fb && hta && htb && ta == tb {
                // same slice
            } else {
                return MIR_REGION_UNKNOWN;
            }
        } else if ka == MIR_PROJ_DEREF {
            // same deref
        } else {
            return MIR_REGION_UNKNOWN;
        }
        i = i + 1;
    }

    if a.proj_count == b.proj_count {
        return MIR_REGION_SAME;
    }
    if (a.proj_count) < b.proj_count {
        return MIR_REGION_CONTAINS;
    }
    MIR_REGION_OVERLAPS
}

pub fn mir_cap_reset(c: mut_view<MirCap>) {
    mir_place_reset(mut_view(c.place), MirLocalId { v: 0u32 });
    c.view_kind = MIR_VIEW_UNKNOWN;
}

pub fn mir_copy_cap(dst: mut_view<MirCap>, src: view<MirCap>) {
    mir_copy_place(mut_view(dst.place), view(src.place));
    dst.view_kind = src.view_kind;
}

pub fn mir_cap_tracker_init(tracker: mut_view<MirCapTracker>, arena: mut_view<Arena>) {
    let init_cap: usize = 16;
    let bytes = mul_usize(init_cap, size_of<MirCap>());
    let raw = arena_alloc_raw(arena, bytes, align_of<MirCap>());
    tracker.caps = raw as *mut MirCap;
    tracker.count = 0;
    tracker.capacity = init_cap;
    let mut i: usize = 0;
    while (i < init_cap) {
        let slot = unsafe { mir_cap_at_mut(tracker.caps, i) };
        unsafe {
            mir_cap_reset(mut_view(*slot));
        }
        i = i + 1;
    }
}

pub fn mir_cap_tracker_new(arena: mut_view<Arena>) -> *mut MirCapTracker {
    let raw = arena_alloc_raw(mut_view(*arena), size_of<MirCapTracker>(), align_of<MirCapTracker>());
    let tracker = raw as *mut MirCapTracker;
    unsafe {
        mir_cap_tracker_init(mut_view(*tracker), mut_view(*arena));
    }
    tracker
}

pub fn mir_cap_tracker_check_conflict(tracker: view<MirCapTracker>, place: view<MirPlace>, view_kind: u8) -> bool {
    let mut i: usize = 0;
    while (i < tracker.count) {
        let existing = unsafe { mir_cap_at(tracker.caps as *const MirCap, i) };
        let rel = unsafe { own_region_relate(view((*existing).place), place) };
        if rel != MIR_REGION_DISJOINT {
            let ex_view = unsafe { (*existing).view_kind };
            if view_kind == MIR_VIEW_MUT || ex_view == MIR_VIEW_MUT {
                return true;
            }
        }
        i = i + 1;
    }
    false
}

pub fn mir_cap_tracker_add(
    tracker: mut_view<MirCapTracker>,
    arena: mut_view<Arena>,
    place: view<MirPlace>,
    view_kind: u8
) {
    if tracker.count >= tracker.capacity {
        let new_cap: usize = if tracker.capacity == 0 { 16 } else { mul_usize(tracker.capacity, 2) };
        let new_bytes = mul_usize(new_cap, size_of<MirCap>());
        let new_raw = arena_alloc_raw(mut_view(*arena), new_bytes, align_of<MirCap>());
        let new_caps = new_raw as *mut MirCap;
        let mut i: usize = 0;
        while (i < tracker.count) {
            let src = unsafe { mir_cap_at(tracker.caps as *const MirCap, i) };
            let dst = unsafe { mir_cap_at_mut(new_caps, i) };
            unsafe {
                mir_copy_cap(mut_view(*dst), view(*src));
            }
            i = i + 1;
        }
        tracker.caps = new_caps;
        tracker.capacity = new_cap;
    }

    let slot = unsafe { mir_cap_at_mut(tracker.caps, tracker.count) };
    unsafe {
        mir_copy_place(mut_view((*slot).place), place);
    }
    if place.proj_count > 0 && (place.projs as usize) != 0 {
        let pbytes = mul_usize(place.proj_count, size_of<MirProjection>());
        let praw = arena_alloc_raw(mut_view(*arena), pbytes, align_of<MirProjection>());
        let new_projs = praw as *mut MirProjection;
        let mut pi: usize = 0;
        while (pi < place.proj_count) {
            let sp = unsafe { mir_proj_at(place.projs, pi) };
            let dp = unsafe { mir_proj_at(new_projs, pi) };
            unsafe {
                mir_copy_proj(mut_view(*dp), view(*sp));
            }
            pi = pi + 1;
        }
        unsafe {
            (*slot).place.projs = new_projs;
        }
    } else {
        unsafe {
            (*slot).place.projs = 0 as *mut MirProjection;
        }
    }
    unsafe {
        (*slot).view_kind = view_kind;
    }
    tracker.count = tracker.count + 1;
}

pub fn mir_cap_tracker_pop(tracker: mut_view<MirCapTracker>) {
    if tracker.count > 0 {
        tracker.count = tracker.count - 1;
    }
}

fn emit_cap_diag(sink: mut_view<DiagSink>, code_v: u32, loc: Span) {
    let mut msg_len: usize = 48;
    if code_v == AX_CAP_CONFLICT_MUT {
        msg_len = 71;
    } else if code_v == AX_CAP_CONFLICT_READ {
        msg_len = 61;
    }
    let buf = arena_alloc_raw(mut_view(sink.arena), msg_len + 1, 1);
    let mut i: usize = 0;
    if code_v == AX_CAP_CONFLICT_MUT {
        while (i < 71) {
            unsafe { *(buf + i) = CAP_MSG_CONFLICT_MUT[i]; }
            i = i + 1;
        }
    } else if code_v == AX_CAP_CONFLICT_READ {
        while (i < 61) {
            unsafe { *(buf + i) = CAP_MSG_CONFLICT_READ[i]; }
            i = i + 1;
        }
    } else {
        while (i < 48) {
            unsafe { *(buf + i) = CAP_MSG_OUTLIVES_OWNER[i]; }
            i = i + 1;
        }
    }
    unsafe { *(buf + msg_len) = 0u8; }

    let d = Diagnostic {
        code: DiagCode { v: code_v },
        severity: DiagSeverity.Error,
        message: StrView { ptr: buf as *const u8, len: msg_len },
        primary: Span { file: FileId { v: loc.file.v }, start: loc.start, end: loc.end },
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    diag_sink_report(sink, view(d));
}

fn merge_cap_states(dest: mut_view<CapState>, src: view<CapState>, local_count: usize) -> bool {
    let mut changed = false;
    let mut i: usize = 0;
    while (i < local_count) {
        let sc = unsafe { mir_cap_at(src.caps as *const MirCap, i) };
        let dc = unsafe { mir_cap_at_mut(dest.caps, i) };
        let sv = unsafe { (*sc).view_kind };
        let dv = unsafe { (*dc).view_kind };
        if sv != MIR_VIEW_UNKNOWN && dv == MIR_VIEW_UNKNOWN {
            unsafe {
                mir_copy_cap(mut_view(*dc), view(*sc));
            }
            changed = true;
        }
        i = i + 1;
    }
    changed
}

fn cap_check_conflict(
    state: view<CapState>,
    local_count: usize,
    place: view<MirPlace>,
    view_kind: u8,
    loc: Span,
    sink: mut_view<DiagSink>,
    report: bool
) {
    if !report {
        return;
    }
    let mut i: usize = 0;
    while (i < local_count) {
        let ci = unsafe { mir_cap_at(state.caps as *const MirCap, i) };
        let cv = unsafe { (*ci).view_kind };
        if cv != MIR_VIEW_UNKNOWN {
            let rel = unsafe { own_region_relate(view((*ci).place), place) };
            if rel != MIR_REGION_DISJOINT {
                if view_kind == MIR_VIEW_MUT || cv == MIR_VIEW_MUT {
                    if view_kind == MIR_VIEW_MUT {
                        emit_cap_diag(sink, AX_CAP_CONFLICT_MUT, loc);
                    } else {
                        emit_cap_diag(sink, AX_CAP_CONFLICT_READ, loc);
                    }
                    return;
                }
            }
        }
        i = i + 1;
    }
}

// True when the body drops the whole local `l` somewhere. Such a local has a type that needs drop,
// which is never Copy, so a `copy _l` of it is a move (the MIR builder writes `copy` for every use
// of a named local; init.ax decides moves by type, this checker has no types).
fn cap_local_is_dropped(body: view<MirBody>, l: u32) -> bool {
    let mut b: usize = 0;
    while (b < body.bb_count) {
        let bb = unsafe { mir_bb_at(body.bbs, b) };
        let sc = unsafe { (*bb).stmt_count };
        let mut i: usize = 0;
        while (i < sc) {
            let st = unsafe { mir_stmt_at((*bb).stmts, i) };
            let sk = unsafe { (*st).kind };
            let pc = unsafe { (*st).place.proj_count };
            let pl = unsafe { (*st).place.local.v };
            if sk == MIR_STMT_DROP && pc == 0 && pl == l {
                return true;
            }
            i = i + 1;
        }
        let has_term = unsafe { (*bb).has_terminator };
        let tk = unsafe { (*bb).terminator.kind };
        let tpc = unsafe { (*bb).terminator.drop_place.proj_count };
        let tpl = unsafe { (*bb).terminator.drop_place.local.v };
        if has_term && tk == MIR_TERM_DROP && tpc == 0 && tpl == l {
            return true;
        }
        b = b + 1;
    }
    false
}

// The owner `place` is moved or dropped at (`bb_idx`, `stmt_idx`). A holder declared before its
// owner (lower local index) was already reported when the capability was bound (cap_visit_stmt), so
// it is not reported a second time; any other holder is a violation only while it is still used
// (AXS-CAP-009). `by_copy`: the place is read by a whole-local `copy`, which is a move only when the
// local needs drop (cap_local_is_dropped).
fn cap_check_invalidate(
    state: view<CapState>,
    local_count: usize,
    place: view<MirPlace>,
    by_copy: bool,
    loc: Span,
    body: view<MirBody>,
    bb_idx: usize,
    stmt_idx: usize,
    sink: mut_view<DiagSink>,
    report: bool
) {
    if !report {
        return;
    }
    let mut i: usize = 0;
    while (i < local_count) {
        let ci = unsafe { mir_cap_at(state.caps as *const MirCap, i) };
        let cv = unsafe { (*ci).view_kind };
        if cv != MIR_VIEW_UNKNOWN {
            let rel = unsafe { own_region_relate(view((*ci).place), place) };
            if rel != MIR_REGION_DISJOINT {
                if by_copy && !cap_local_is_dropped(body, place.local.v) {
                    return;
                }
                let owner_v = unsafe { (*ci).place.local.v };
                let holder_v = i as u32;
                if holder_v >= owner_v {
                    if cap_local_used_from(body, bb_idx, stmt_idx, holder_v) {
                        emit_cap_diag(sink, AX_CAP_OUTLIVES_OWNER, loc);
                        return;
                    }
                }
            }
        }
        i = i + 1;
    }
}

fn cap_span_copy(s: view<Span>) -> Span {
    Span { file: FileId { v: s.file.v }, start: s.start, end: s.end }
}

// ---- "is local `l` used at or after a position" (T157) ----

const CAP_EFF_NONE: u8 = 0u8;
const CAP_EFF_USE: u8 = 1u8;
const CAP_EFF_KILL: u8 = 2u8;

fn cap_place_uses(p: view<MirPlace>, l: u32) -> bool {
    if p.local.v == l {
        return true;
    }
    let mut i: usize = 0;
    while (i < p.proj_count) {
        let pr = unsafe { mir_proj_at(p.projs, i) };
        let k = unsafe { (*pr).kind };
        if k == MIR_PROJ_INDEX {
            let il = unsafe { (*pr).index_local.v };
            if il == l {
                return true;
            }
        } else if k == MIR_PROJ_SUB_SLICE {
            let hf = unsafe { (*pr).has_from };
            let fl = unsafe { (*pr).from_local.v };
            let ht = unsafe { (*pr).has_to };
            let tl = unsafe { (*pr).to_local.v };
            if hf && fl == l {
                return true;
            }
            if ht && tl == l {
                return true;
            }
        }
        i = i + 1;
    }
    false
}

fn cap_operand_uses(op: view<MirOperand>, l: u32) -> bool {
    if op.kind != MIR_OP_COPY && op.kind != MIR_OP_MOVE {
        return false;
    }
    cap_place_uses(view(op.place), l)
}

fn cap_rvalue_uses(rv: view<MirRvalue>, l: u32) -> bool {
    let k = rv.kind;
    // REPEAT: only the element operand; the count is a usize, never a capability holder.
    if k == MIR_RVALUE_USE || k == MIR_RVALUE_CAST || k == MIR_RVALUE_UNARY_OP || k == MIR_RVALUE_REPEAT {
        return cap_operand_uses(view(rv.use_op), l);
    }
    if k == MIR_RVALUE_REF || k == MIR_RVALUE_LEN || k == MIR_RVALUE_DISCRIMINANT {
        return cap_place_uses(view(rv.place), l);
    }
    if k == MIR_RVALUE_BINARY_OP || k == MIR_RVALUE_OVERFLOWS_BINARY_OP {
        if cap_operand_uses(view(rv.lhs), l) {
            return true;
        }
        return cap_operand_uses(view(rv.rhs), l);
    }
    if k == MIR_RVALUE_AGGREGATE {
        let mut i: usize = 0;
        while (i < rv.operand_count) {
            let op = unsafe { mir_op_at(rv.operands, i) };
            let u = unsafe { cap_operand_uses(view(*op), l) };
            if u {
                return true;
            }
            i = i + 1;
        }
    }
    false
}

fn cap_stmt_effect(stmt: view<MirStmt>, l: u32) -> u8 {
    let sk = stmt.kind;
    if sk == MIR_STMT_ASSIGN {
        if cap_rvalue_uses(view(stmt.rvalue), l) {
            return CAP_EFF_USE;
        }
        if stmt.place.proj_count > 0 {
            if cap_place_uses(view(stmt.place), l) {
                return CAP_EFF_USE;
            }
            return CAP_EFF_NONE;
        }
        if stmt.place.local.v == l {
            return CAP_EFF_KILL;
        }
        return CAP_EFF_NONE;
    }
    if sk == MIR_STMT_STORAGE_LIVE || sk == MIR_STMT_STORAGE_DEAD {
        if stmt.storage_local.v == l {
            return CAP_EFF_KILL;
        }
        return CAP_EFF_NONE;
    }
    if sk == MIR_STMT_DROP {
        if cap_place_uses(view(stmt.place), l) {
            return CAP_EFF_USE;
        }
    }
    CAP_EFF_NONE
}

fn cap_term_uses(t: view<MirTerminator>, l: u32) -> bool {
    let tk = t.kind;
    if tk == MIR_TERM_SWITCH_INT {
        return cap_operand_uses(view(t.discr), l);
    }
    if tk == MIR_TERM_RETURN {
        return l == 0u32;
    }
    if tk == MIR_TERM_DROP {
        return cap_place_uses(view(t.drop_place), l);
    }
    if tk == MIR_TERM_CALL {
        if cap_operand_uses(view(t.func), l) {
            return true;
        }
        let mut a: usize = 0;
        while (a < t.arg_count) {
            let op = unsafe { mir_op_at(t.args, a) };
            let u = unsafe { cap_operand_uses(view(*op), l) };
            if u {
                return true;
            }
            a = a + 1;
        }
        if t.destination.proj_count > 0 {
            return cap_place_uses(view(t.destination), l);
        }
        return false;
    }
    if tk == MIR_TERM_ASSERT {
        return cap_operand_uses(view(t.cond), l);
    }
    false
}

// Normal successors only (unwind edges carry no uses of a view local).
fn cap_term_successors(t: view<MirTerminator>, out: mut_view<[16]u32>) -> usize {
    let tk = t.kind;
    let mut n: usize = 0;
    if tk == MIR_TERM_GOTO {
        (*out)[n] = t.goto_target.v;
        n = n + 1;
    } else if tk == MIR_TERM_SWITCH_INT {
        let mut j: usize = 0;
        while (j < t.switch_count && n < 15) {
            let tid = unsafe { (*mir_bb_id_at(t.targets, j)).v };
            (*out)[n] = tid;
            n = n + 1;
            j = j + 1;
        }
        (*out)[n] = t.otherwise.v;
        n = n + 1;
    } else if tk == MIR_TERM_DROP {
        (*out)[n] = t.drop_target.v;
        n = n + 1;
    } else if tk == MIR_TERM_CALL {
        (*out)[n] = t.call_target.v;
        n = n + 1;
    } else if tk == MIR_TERM_ASSERT {
        (*out)[n] = t.assert_target.v;
        n = n + 1;
    }
    n
}

unsafe fn cap_usize_at(base: *mut usize, idx: usize) -> *mut usize {
    ((base as usize) + mul_usize(idx, size_of<usize>())) as *mut usize
}

// True when some normal CFG path from statement `stmt_idx` of block `bb_idx` (inclusive; the
// terminator is `stmt_idx == stmt_count`) reaches a use of local `l` before `l` is reassigned or its
// storage ends.
fn cap_local_used_from(body: view<MirBody>, bb_idx: usize, stmt_idx: usize, l: u32) -> bool {
    let n = body.bb_count;
    let queued = unsafe { heap_alloc(n, 1) };
    let mut qi: usize = 0;
    while (qi < n) {
        unsafe { *(queued + qi) = 0u8; }
        qi = qi + 1;
    }
    let work_bytes = mul_usize(n + 1, size_of<usize>());
    let work_raw = unsafe { heap_alloc(work_bytes, align_of<usize>()) };
    let work = work_raw as *mut usize;
    let mut work_len: usize = 0;
    let mut succ: [16]u32 = [0u32; 16];
    let mut used = false;
    let mut cur_bb = bb_idx;
    let mut cur_stmt = stmt_idx;
    let mut searching = true;
    while searching {
        let bb = unsafe { mir_bb_at(body.bbs, cur_bb) };
        let sc_n = unsafe { (*bb).stmt_count };
        let mut killed = false;
        let mut i = cur_stmt;
        while (i < sc_n && !used && !killed) {
            let st = unsafe { mir_stmt_at((*bb).stmts, i) };
            let eff = unsafe { cap_stmt_effect(view(*st), l) };
            if eff == CAP_EFF_USE {
                used = true;
            } else if eff == CAP_EFF_KILL {
                killed = true;
            }
            i = i + 1;
        }
        let has_term = unsafe { (*bb).has_terminator };
        if !used && !killed && has_term {
            let tu = unsafe { cap_term_uses(view((*bb).terminator), l) };
            if tu {
                used = true;
            } else {
                let tk = unsafe { (*bb).terminator.kind };
                let dpc = unsafe { (*bb).terminator.destination.proj_count };
                let dl = unsafe { (*bb).terminator.destination.local.v };
                let dest_kill = tk == MIR_TERM_CALL && dpc == 0 && dl == l;
                if !dest_kill {
                    let sc = unsafe { cap_term_successors(view((*bb).terminator), mut_view(succ)) };
                    let mut j: usize = 0;
                    while (j < sc) {
                        let s = succ[j] as usize;
                        if s < n {
                            let q = unsafe { *(queued + s) };
                            if q == 0u8 {
                                unsafe {
                                    *(queued + s) = 1u8;
                                    *cap_usize_at(work, work_len) = s;
                                }
                                work_len = work_len + 1;
                            }
                        }
                        j = j + 1;
                    }
                }
            }
        }
        if used || work_len == 0 {
            searching = false;
        } else {
            work_len = work_len - 1;
            cur_bb = unsafe { *cap_usize_at(work, work_len) };
            cur_stmt = 0;
        }
    }
    unsafe {
        heap_free(queued, n, 1);
        heap_free(work as *mut u8, work_bytes, align_of<usize>());
    }
    used
}

fn cap_visit_operand(
    state: mut_view<CapState>,
    local_count: usize,
    op: view<MirOperand>,
    loc: Span,
    body: view<MirBody>,
    bb_idx: usize,
    stmt_idx: usize,
    sink: mut_view<DiagSink>,
    report: bool
) {
    if op.kind == MIR_OP_MOVE {
        cap_check_invalidate(view(*state), local_count, view(op.place), false, loc, body, bb_idx, stmt_idx, sink, report);
    } else if op.kind == MIR_OP_COPY && op.place.proj_count == 0 {
        cap_check_invalidate(view(*state), local_count, view(op.place), true, loc, body, bb_idx, stmt_idx, sink, report);
    }
}

fn cap_visit_rvalue(
    state: mut_view<CapState>,
    local_count: usize,
    rv: view<MirRvalue>,
    loc: Span,
    body: view<MirBody>,
    bb_idx: usize,
    stmt_idx: usize,
    sink: mut_view<DiagSink>,
    report: bool
) {
    let k = rv.kind;
    if k == MIR_RVALUE_USE {
        cap_visit_operand(state, local_count, view(rv.use_op), loc, body, bb_idx, stmt_idx, sink, report);
    } else if k == MIR_RVALUE_REPEAT {
        cap_visit_operand(state, local_count, view(rv.use_op), loc, body, bb_idx, stmt_idx, sink, report);
    } else if k == MIR_RVALUE_REF {
        let v = if rv.borrow_kind == MIR_BORROW_MUT { MIR_VIEW_MUT } else { MIR_VIEW_READ };
        cap_check_conflict(view(*state), local_count, view(rv.place), v, loc, sink, report);
    } else if k == MIR_RVALUE_LEN {
        // no move or borrow conflict
    } else if k == MIR_RVALUE_CAST {
        cap_visit_operand(state, local_count, view(rv.use_op), loc, body, bb_idx, stmt_idx, sink, report);
    } else if k == MIR_RVALUE_BINARY_OP || k == MIR_RVALUE_OVERFLOWS_BINARY_OP {
        cap_visit_operand(mut_view(*state), local_count, view(rv.lhs), cap_span_copy(view(loc)), view(*body), bb_idx, stmt_idx, mut_view(*sink), report);
        cap_visit_operand(state, local_count, view(rv.rhs), loc, body, bb_idx, stmt_idx, sink, report);
    } else if k == MIR_RVALUE_UNARY_OP {
        cap_visit_operand(state, local_count, view(rv.use_op), loc, body, bb_idx, stmt_idx, sink, report);
    } else if k == MIR_RVALUE_DISCRIMINANT {
        // no move
    } else if k == MIR_RVALUE_AGGREGATE {
        let mut i: usize = 0;
        while (i < rv.operand_count) {
            let op = unsafe { mir_op_at(rv.operands, i) };
            unsafe {
                cap_visit_operand(mut_view(*state), local_count, view(*op), cap_span_copy(view(loc)), view(*body), bb_idx, stmt_idx, mut_view(*sink), report);
            }
            i = i + 1;
        }
    }
}

fn cap_visit_stmt(
    state: mut_view<CapState>,
    local_count: usize,
    stmt: view<MirStmt>,
    body: view<MirBody>,
    bb_idx: usize,
    stmt_idx: usize,
    sink: mut_view<DiagSink>,
    report: bool
) {
    let sk = stmt.kind;
    let loc = Span { file: FileId { v: stmt.location.file.v }, start: stmt.location.start, end: stmt.location.end };
    if sk == MIR_STMT_ASSIGN {
        cap_visit_rvalue(mut_view(*state), local_count, view(stmt.rvalue), cap_span_copy(view(loc)), view(*body), bb_idx, stmt_idx, mut_view(*sink), report);
        let rvk = stmt.rvalue.kind;
        let dest_idx = stmt.place.local.v as usize;
        if rvk == MIR_RVALUE_REF {
            if stmt.place.proj_count == 0 && dest_idx < local_count {
                let v = if stmt.rvalue.borrow_kind == MIR_BORROW_MUT { MIR_VIEW_MUT } else { MIR_VIEW_READ };
                let dst_cap = unsafe { mir_cap_at_mut(state.caps, dest_idx) };
                unsafe {
                    mir_copy_place(mut_view((*dst_cap).place), view(stmt.rvalue.place));
                    (*dst_cap).view_kind = v;
                }
                if report {
                    let dest_v = stmt.place.local.v;
                    let src_v = stmt.rvalue.place.local.v;
                    if dest_v < src_v {
                        emit_cap_diag(mut_view(*sink), AX_CAP_OUTLIVES_OWNER, cap_span_copy(view(loc)));
                    }
                }
            }
        } else if rvk == MIR_RVALUE_USE && (stmt.rvalue.use_op.kind == MIR_OP_COPY || stmt.rvalue.use_op.kind == MIR_OP_MOVE) {
            let src_idx = stmt.rvalue.use_op.place.local.v as usize;
            if stmt.place.proj_count == 0 && stmt.rvalue.use_op.place.proj_count == 0 && dest_idx < local_count && src_idx < local_count {
                let src_cap = unsafe { mir_cap_at(state.caps as *const MirCap, src_idx) };
                let dst_cap = unsafe { mir_cap_at_mut(state.caps, dest_idx) };
                unsafe {
                    mir_copy_cap(mut_view(*dst_cap), view(*src_cap));
                }
                let dv = unsafe { (*dst_cap).view_kind };
                if report && dv != MIR_VIEW_UNKNOWN {
                    let dest_v = stmt.place.local.v;
                    let owner_v = unsafe { (*dst_cap).place.local.v };
                    if dest_v < owner_v {
                        emit_cap_diag(mut_view(*sink), AX_CAP_OUTLIVES_OWNER, cap_span_copy(view(loc)));
                    }
                }
            }
        } else if rvk == MIR_RVALUE_AGGREGATE {
            if stmt.place.proj_count == 0 && dest_idx < local_count {
                let mut i: usize = 0;
                while (i < stmt.rvalue.operand_count) {
                    let op = unsafe { mir_op_at(stmt.rvalue.operands, i) };
                    let opk = unsafe { (*op).kind };
                    if opk == MIR_OP_COPY || opk == MIR_OP_MOVE {
                        let op_pcount = unsafe { (*op).place.proj_count };
                        let op_lidx = (unsafe { (*op).place.local.v }) as usize;
                        if op_pcount == 0 && op_lidx < local_count {
                            let src_cap = unsafe { mir_cap_at(state.caps as *const MirCap, op_lidx) };
                            let sv = unsafe { (*src_cap).view_kind };
                            if sv != MIR_VIEW_UNKNOWN {
                                let dst_cap = unsafe { mir_cap_at_mut(state.caps, dest_idx) };
                                unsafe {
                                    mir_copy_cap(mut_view(*dst_cap), view(*src_cap));
                                }
                                if report {
                                    let dest_v = stmt.place.local.v;
                                    let owner_v = unsafe { (*dst_cap).place.local.v };
                                    if dest_v < owner_v {
                                        emit_cap_diag(mut_view(*sink), AX_CAP_OUTLIVES_OWNER, cap_span_copy(view(loc)));
                                    }
                                }
                            }
                        }
                    }
                    i = i + 1;
                }
            }
        } else if rvk == MIR_RVALUE_CAST {
            // AXS-CAP-008: `_p = copy _t as *T` turns the ephemeral capability of the `address_of`
            // temporary `_t` into a raw pointer that holds none; the capability ends here unless `_t`
            // itself is used again.
            let cop = stmt.rvalue.use_op.kind;
            let c_pcount = stmt.rvalue.use_op.place.proj_count;
            let c_lidx = stmt.rvalue.use_op.place.local.v as usize;
            if (cop == MIR_OP_COPY || cop == MIR_OP_MOVE) && c_pcount == 0 && c_lidx < local_count {
                let c_cap = unsafe { mir_cap_at_mut(state.caps, c_lidx) };
                let c_view = unsafe { (*c_cap).view_kind };
                if c_view != MIR_VIEW_UNKNOWN {
                    if !cap_local_used_from(view(*body), bb_idx, stmt_idx + 1, c_lidx as u32) {
                        unsafe {
                            (*c_cap).view_kind = MIR_VIEW_UNKNOWN;
                        }
                    }
                }
            }
        }

        if rvk == MIR_RVALUE_USE && stmt.rvalue.use_op.kind == MIR_OP_MOVE {
            let src_idx = stmt.rvalue.use_op.place.local.v as usize;
            if stmt.rvalue.use_op.place.proj_count == 0 && src_idx < local_count && src_idx != dest_idx {
                let src_cap = unsafe { mir_cap_at_mut(state.caps, src_idx) };
                unsafe {
                    (*src_cap).view_kind = MIR_VIEW_UNKNOWN;
                }
            }
        } else if rvk == MIR_RVALUE_AGGREGATE {
            let mut i: usize = 0;
            while (i < stmt.rvalue.operand_count) {
                let op = unsafe { mir_op_at(stmt.rvalue.operands, i) };
                let opk = unsafe { (*op).kind };
                let op_pcount = unsafe { (*op).place.proj_count };
                let op_lidx = (unsafe { (*op).place.local.v }) as usize;
                if opk == MIR_OP_MOVE && op_pcount == 0 && op_lidx < local_count && op_lidx != dest_idx {
                    let src_cap = unsafe { mir_cap_at_mut(state.caps, op_lidx) };
                    unsafe {
                        (*src_cap).view_kind = MIR_VIEW_UNKNOWN;
                    }
                }
                i = i + 1;
            }
        }
    } else if sk == MIR_STMT_STORAGE_LIVE || sk == MIR_STMT_STORAGE_DEAD {
        let lidx = stmt.storage_local.v as usize;
        if lidx < local_count {
            let c = unsafe { mir_cap_at_mut(state.caps, lidx) };
            unsafe {
                (*c).view_kind = MIR_VIEW_UNKNOWN;
            }
        }
    } else if sk == MIR_STMT_DROP {
        cap_check_invalidate(view(*state), local_count, view(stmt.place), false, loc, body, bb_idx, stmt_idx, sink, report);
    }
}

fn cap_visit_bb(
    state: mut_view<CapState>,
    local_count: usize,
    bb: view<MirBb>,
    body: view<MirBody>,
    bb_idx: usize,
    sink: mut_view<DiagSink>,
    report: bool
) {
    let mut i: usize = 0;
    while (i < bb.stmt_count) {
        let st = unsafe { mir_stmt_at(bb.stmts, i) };
        unsafe {
            cap_visit_stmt(mut_view(*state), local_count, view(*st), view(*body), bb_idx, i, mut_view(*sink), report);
        }
        i = i + 1;
    }
    if !bb.has_terminator {
        return;
    }
    let tk = bb.terminator.kind;
    let loc = Span {
        file: FileId { v: bb.terminator.location.file.v },
        start: bb.terminator.location.start,
        end: bb.terminator.location.end,
    };
    if tk == MIR_TERM_DROP {
        cap_check_invalidate(view(*state), local_count, view(bb.terminator.drop_place), false, loc, body, bb_idx, bb.stmt_count, sink, report);
    } else if tk == MIR_TERM_CALL {
        let mut a: usize = 0;
        while (a < bb.terminator.arg_count) {
            let op = unsafe { mir_op_at(bb.terminator.args, a) };
            unsafe {
                cap_visit_operand(mut_view(*state), local_count, view(*op), cap_span_copy(view(loc)), view(*body), bb_idx, bb.stmt_count, mut_view(*sink), report);
            }
            let opk = unsafe { (*op).kind };
            let op_pcount = unsafe { (*op).place.proj_count };
            let op_lidx = (unsafe { (*op).place.local.v }) as usize;
            if opk == MIR_OP_MOVE && op_pcount == 0 && op_lidx < local_count {
                let c = unsafe { mir_cap_at_mut(state.caps, op_lidx) };
                unsafe {
                    (*c).view_kind = MIR_VIEW_UNKNOWN;
                }
            }
            a = a + 1;
        }
    }
}

fn copy_cap_array(dst: *mut MirCap, src: *const MirCap, local_count: usize) {
    let mut i: usize = 0;
    while (i < local_count) {
        let d = unsafe { mir_cap_at_mut(dst, i) };
        let s = unsafe { mir_cap_at(src, i) };
        unsafe {
            mir_copy_cap(mut_view(*d), view(*s));
        }
        i = i + 1;
    }
}

pub fn own_cap_check(body: view<MirBody>, sink: mut_view<DiagSink>) {
    if body.bb_count == 0 || body.local_count == 0 {
        return;
    }
    let local_count = body.local_count;
    let bb_count = body.bb_count;

    let bb_in_bytes = mul_usize(bb_count, size_of<CapState>());
    let bb_in_raw = unsafe { heap_alloc(bb_in_bytes, align_of<CapState>()) };
    let bb_in = bb_in_raw as *mut CapState;
    let cap_arr_bytes = mul_usize(local_count, size_of<MirCap>());

    let mut i: usize = 0;
    while (i < bb_count) {
        let st_p = unsafe { cap_state_at_mut(bb_in, i) };
        let caps_raw = unsafe { heap_alloc(cap_arr_bytes, align_of<MirCap>()) };
        let caps_ptr = caps_raw as *mut MirCap;
        let mut j: usize = 0;
        while (j < local_count) {
            let c = unsafe { mir_cap_at_mut(caps_ptr, j) };
            unsafe {
                mir_cap_reset(mut_view(*c));
            }
            j = j + 1;
        }
        unsafe {
            (*st_p).caps = caps_ptr;
        }
        i = i + 1;
    }

    let vis_raw = unsafe { heap_alloc(bb_count, 1) };
    let visited = vis_raw;
    i = 0;
    while (i < bb_count) {
        unsafe { *(visited + i) = 0u8; }
        i = i + 1;
    }
    unsafe { *visited = 1u8; }

    let temp_raw = unsafe { heap_alloc(cap_arr_bytes, align_of<MirCap>()) };
    let mut temp = CapState { caps: temp_raw as *mut MirCap };

    let mut changed = true;
    while changed {
        changed = false;
        i = 0;
        while (i < bb_count) {
            if (unsafe { *(visited + i) }) != 0u8 {
                let in_st = unsafe { cap_state_at_mut(bb_in, i) };
                let in_caps = unsafe { (*in_st).caps };
                copy_cap_array(temp.caps, in_caps as *const MirCap, local_count);
                let bb_p = unsafe { mir_bb_at(body.bbs, i) };
                unsafe {
                    cap_visit_bb(mut_view(temp), local_count, view(*bb_p), view(*body), i, mut_view(*sink), false);
                }

                let has_term = unsafe { (*bb_p).has_terminator };
                if has_term {
                    let tk = unsafe { (*bb_p).terminator.kind };
                    let mut targets: [16]u32 = [0u32; 16];
                    let mut target_count: usize = 0;

                    if tk == MIR_TERM_GOTO {
                        targets[target_count] = unsafe { (*bb_p).terminator.goto_target.v };
                        target_count = target_count + 1;
                    } else if tk == MIR_TERM_SWITCH_INT {
                        let sc = unsafe { (*bb_p).terminator.switch_count };
                        let tgts = unsafe { (*bb_p).terminator.targets };
                        let mut sj: usize = 0;
                        while (sj < sc && target_count < 15) {
                            let tid = unsafe { (*mir_bb_id_at(tgts, sj)).v };
                            targets[target_count] = tid;
                            target_count = target_count + 1;
                            sj = sj + 1;
                        }
                        if target_count < 16 {
                            targets[target_count] = unsafe { (*bb_p).terminator.otherwise.v };
                            target_count = target_count + 1;
                        }
                    } else if tk == MIR_TERM_DROP {
                        targets[target_count] = unsafe { (*bb_p).terminator.drop_target.v };
                        target_count = target_count + 1;
                    } else if tk == MIR_TERM_CALL {
                        targets[target_count] = unsafe { (*bb_p).terminator.call_target.v };
                        target_count = target_count + 1;
                    } else if tk == MIR_TERM_ASSERT {
                        targets[target_count] = unsafe { (*bb_p).terminator.assert_target.v };
                        target_count = target_count + 1;
                    }

                    let mut tj: usize = 0;
                    while (tj < target_count) {
                        let tgt_v = targets[tj] as usize;
                        if tgt_v < bb_count {
                            let tgt_st = unsafe { cap_state_at_mut(bb_in, tgt_v) };
                            if (unsafe { *(visited + tgt_v) }) == 0u8 {
                                let tgt_caps = unsafe { (*tgt_st).caps };
                                copy_cap_array(tgt_caps, temp.caps as *const MirCap, local_count);
                                unsafe { *(visited + tgt_v) = 1u8; }
                                changed = true;
                            } else {
                                let merged = unsafe { merge_cap_states(mut_view(*tgt_st), view(temp), local_count) };
                                if merged {
                                    changed = true;
                                }
                            }
                        }
                        tj = tj + 1;
                    }
                }
            }
            i = i + 1;
        }
    }

    i = 0;
    while (i < bb_count) {
        if (unsafe { *(visited + i) }) != 0u8 {
            let in_st = unsafe { cap_state_at_mut(bb_in, i) };
            let in_caps = unsafe { (*in_st).caps };
            copy_cap_array(temp.caps, in_caps as *const MirCap, local_count);
            let bb_p = unsafe { mir_bb_at(body.bbs, i) };
            unsafe {
                cap_visit_bb(mut_view(temp), local_count, view(*bb_p), view(*body), i, mut_view(*sink), true);
            }
        }
        i = i + 1;
    }

    i = 0;
    while (i < bb_count) {
        let st_p = unsafe { cap_state_at_mut(bb_in, i) };
        let caps_p = unsafe { (*st_p).caps };
        unsafe {
            heap_free(caps_p as *mut u8, cap_arr_bytes, align_of<MirCap>());
        }
        i = i + 1;
    }
    unsafe {
        heap_free(bb_in as *mut u8, bb_in_bytes, align_of<CapState>());
        heap_free(temp.caps as *mut u8, cap_arr_bytes, align_of<MirCap>());
        heap_free(visited, bb_count, 1);
    }
}


module main

use host_intrinsics.heap_alloc
use host_intrinsics.heap_free
use host_intrinsics.exit
use compiler.diag.code.AX_CAP_CONFLICT_MUT
use compiler.diag.code.AX_CAP_CONFLICT_READ
use compiler.diag.code.AX_CAP_OUTLIVES_OWNER
use compiler.kernel.arena.Arena
use compiler.diag.emitter.DiagSink
use compiler.diag.emitter.Diagnostic
use compiler.kernel.id.FileId
use compiler.mir.mir.MIR_BORROW_MUT
use compiler.mir.mir.MIR_BORROW_SHARED
use compiler.mir.mir.MIR_LOCAL_USER
use compiler.mir.mir.MIR_OP_COPY
use compiler.mir.mir.MIR_PROJ_FIELD
use compiler.mir.mir.MIR_PROJ_SUB_SLICE
use compiler.mir.mir.MIR_REGION_CONTAINS
