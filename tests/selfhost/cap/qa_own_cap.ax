fn zero_fill(ptr: *mut u8, size: usize) {
    let word_count = size >> 3;
    let mut w: usize = 0;
    while w < word_count {
        let off = w << 3;
        unsafe { *(((ptr as usize) + off) as *mut u64) = 0u64; }
        w = w + 1;
    }
    let mut i: usize = word_count << 3;
    while i < size {
        unsafe { *(ptr + i) = 0u8; }
        i = i + 1;
    }
}

pub fn hir_set_span(dst: mut_view<Span>, sp: Span) {
    dst.file.v = sp.file.v;
    dst.start = sp.start;
    dst.end = sp.end;
}

pub fn hir_copy_dotted(dst: mut_view<AstDottedName>, src: view<AstDottedName>) {
    hir_set_span(mut_view(dst.span), src.span);
    dst.segments = src.segments;
    dst.count = src.count;
}

pub fn hir_copy_vis(dst: mut_view<HirVis>, kind: u8, sp: Span) {
    dst.kind = kind;
    hir_set_span(mut_view(dst.span), sp);
}

pub fn hir_copy_token(dst: mut_view<Token>, src: view<Token>) {
    dst.kind = src.kind;
    dst.suffix = src.suffix;
    dst.flags = src.flags;
    dst.char_val = src.char_val;
    hir_set_span(mut_view(dst.span), src.span);
    dst.int_val = src.int_val;
    dst.str_ptr = src.str_ptr;
    dst.str_len = src.str_len;
    dst.ident_val.v = src.ident_val.v;
}

pub fn hir_alloc_type(arena: mut_view<Arena>, kind: u8, sp: Span) -> *mut HirType {
    let raw = arena_alloc_raw(arena, size_of<HirType>(), align_of<HirType>());
    zero_fill(raw, size_of<HirType>());
    let n = raw as *mut HirType;
    unsafe {
        (*n).kind = kind;
        hir_set_span(mut_view((*n).span), sp);
    }
    n
}

