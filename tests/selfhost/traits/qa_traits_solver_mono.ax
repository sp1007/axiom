    // Build HIR items for traits, structs, and impls
    let dummy_block = hir_alloc_block(mut_view(*arena), (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));

    // trait Printable { fn fmt(self: view<Self>); }
    let tr_printable = hir_alloc_item(mut_view(*arena), HIR_ITEM_TRAIT, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
