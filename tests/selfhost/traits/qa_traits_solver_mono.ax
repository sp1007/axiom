pub fn ptr_substmap_init(m: mut_view<PtrSubstMap>) {
    m.keys = 0 as *mut usize;
    m.vals = 0 as *mut GenericArgsSlice;
    m.states = 0 as *mut u8;
    m.len = 0;
    m.cap = 0;
}

pub fn ptr_substmap_free(m: mut_view<PtrSubstMap>) {
    if m.cap > 0 {
        unsafe {
            heap_free(m.keys as *mut u8, mul_usize(m.cap, size_of<usize>()), align_of<usize>());
            heap_free(
                m.vals as *mut u8,
                mul_usize(m.cap, size_of<GenericArgsSlice>()),
                align_of<GenericArgsSlice>()
            );
            heap_free(m.states, m.cap, 1);
        }
    }
    ptr_substmap_init(m);
}

fn ptr_substmap_grow(m: mut_view<PtrSubstMap>) {
    let new_cap: usize = if m.cap == 0 { MAP_INIT_CAP } else { mul_usize(m.cap, 2) };
    let new_keys = unsafe { heap_alloc(mul_usize(new_cap, size_of<usize>()), align_of<usize>()) as *mut usize };
    let new_vals = unsafe {
        let vbytes = mul_usize(new_cap, size_of<GenericArgsSlice>());
        heap_alloc(vbytes, align_of<GenericArgsSlice>()) as *mut GenericArgsSlice
    };
    let new_states = unsafe { heap_alloc(new_cap, 1) };
    types_zero_bytes(new_states, new_cap);

    let old_keys = m.keys;
    let old_vals = m.vals;
    let old_states = m.states;
    let old_cap = m.cap;

    m.keys = new_keys;
    m.vals = new_vals;
    m.states = new_states;
    m.len = 0;
    m.cap = new_cap;

    let mut i: usize = 0;
    while (i < old_cap) {
        let st = unsafe { *(old_states + i) };
        if st == SLOT_OCCUPIED {
            let k = unsafe { *usize_at(old_keys, i) };
            let vp = unsafe { subst_at(old_vals, i) };
            let args_ptr = unsafe { (*vp).args };
            let cnt = unsafe { (*vp).count };
            ptr_substmap_insert(mut_view(*m), k, args_ptr, cnt);
        }
        i = i + 1;
    }

    if old_cap > 0 {
        unsafe {
            heap_free(old_keys as *mut u8, mul_usize(old_cap, size_of<usize>()), align_of<usize>());
            heap_free(
                old_vals as *mut u8,
                mul_usize(old_cap, size_of<GenericArgsSlice>()),
                align_of<GenericArgsSlice>()
            );
            heap_free(old_states, old_cap, 1);
        }
    }
}

pub fn ptr_substmap_insert(
    m: mut_view<PtrSubstMap>,
    key: usize,
    args: *mut TypeId,
    count: usize
) {
    if m.cap == 0 || mul_usize(m.len + 1, MAP_LOAD_DEN) >= mul_usize(m.cap, MAP_LOAD_NUM) {
        ptr_substmap_grow(mut_view(*m));
    }
    let mask = m.cap - 1;
    let mut idx = (hash_u64(key as u64) as usize) & mask;
    loop {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            unsafe {
                *usize_at(m.keys, idx) = key;
                let vp = subst_at(m.vals, idx);
                (*vp).args = args;
                (*vp).count = count;
                *(m.states + idx) = SLOT_OCCUPIED;
            }
            m.len = m.len + 1;
            return;
        }
        let k = unsafe { *usize_at(m.keys, idx) };
        if k == key {
            unsafe {
                let vp = subst_at(m.vals, idx);
                (*vp).args = args;
                (*vp).count = count;
            }
            return;
        }
        idx = (idx + 1) & mask;
    }
}

pub fn ptr_substmap_get(m: view<PtrSubstMap>, key: usize) -> *mut GenericArgsSlice {
    if m.cap == 0 {
        return 0 as *mut GenericArgsSlice;
    }
    let mask = m.cap - 1;
    let mut idx = (hash_u64(key as u64) as usize) & mask;
    let mut probes: usize = 0;
    while (probes < m.cap) {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            return 0 as *mut GenericArgsSlice;
        }
        if st == SLOT_OCCUPIED {
            let k = unsafe { *usize_at(m.keys, idx) };
            if k == key {
                return unsafe { subst_at(m.vals, idx) };
            }
        }
        idx = (idx + 1) & mask;
        probes = probes + 1;
    }
    0 as *mut GenericArgsSlice
}

pub fn ptr_trymap_init(m: mut_view<PtrTryMap>) {
    m.keys = 0 as *mut usize;
    m.vals = 0 as *mut TryExprInfo;
    m.states = 0 as *mut u8;
    m.len = 0;
    m.cap = 0;
}

pub fn ptr_trymap_free(m: mut_view<PtrTryMap>) {
    if m.cap > 0 {
        unsafe {
            heap_free(m.keys as *mut u8, mul_usize(m.cap, size_of<usize>()), align_of<usize>());
            heap_free(m.vals as *mut u8, mul_usize(m.cap, size_of<TryExprInfo>()), align_of<TryExprInfo>());
            heap_free(m.states, m.cap, 1);
        }
    }
    ptr_trymap_init(m);
}

fn ptr_trymap_grow(m: mut_view<PtrTryMap>) {
    let new_cap: usize = if m.cap == 0 { MAP_INIT_CAP } else { mul_usize(m.cap, 2) };
    let new_keys = unsafe { heap_alloc(mul_usize(new_cap, size_of<usize>()), align_of<usize>()) as *mut usize };
    let new_vals = unsafe {
        heap_alloc(mul_usize(new_cap, size_of<TryExprInfo>()), align_of<TryExprInfo>()) as *mut TryExprInfo
    };
    let new_states = unsafe { heap_alloc(new_cap, 1) };
    types_zero_bytes(new_states, new_cap);

    let old_keys = m.keys;
    let old_vals = m.vals;
    let old_states = m.states;
    let old_cap = m.cap;

    m.keys = new_keys;
    m.vals = new_vals;
    m.states = new_states;
    m.len = 0;
    m.cap = new_cap;

    let mut i: usize = 0;
    while (i < old_cap) {
        let st = unsafe { *(old_states + i) };
        if st == SLOT_OCCUPIED {
            let k = unsafe { *usize_at(old_keys, i) };
            let vp = unsafe { tryinfo_at(old_vals, i) };
            let is_opt = unsafe { (*vp).is_opt };
            let p_idx = unsafe { (*vp).payload_idx };
            let e_idx = unsafe { (*vp).err_idx };
            ptr_trymap_insert(mut_view(*m), k, is_opt, p_idx, e_idx);
        }
        i = i + 1;
    }

    if old_cap > 0 {
        unsafe {
            heap_free(old_keys as *mut u8, mul_usize(old_cap, size_of<usize>()), align_of<usize>());
            heap_free(old_vals as *mut u8, mul_usize(old_cap, size_of<TryExprInfo>()), align_of<TryExprInfo>());
            heap_free(old_states, old_cap, 1);
        }
    }
}

pub fn ptr_trymap_insert(
    m: mut_view<PtrTryMap>,
    key: usize,
    is_opt: bool,
    payload_idx: usize,
    err_idx: usize
) {
    if m.cap == 0 || mul_usize(m.len + 1, MAP_LOAD_DEN) >= mul_usize(m.cap, MAP_LOAD_NUM) {
        ptr_trymap_grow(mut_view(*m));
    }
    let mask = m.cap - 1;
    let mut idx = (hash_u64(key as u64) as usize) & mask;
    loop {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            unsafe {
                *usize_at(m.keys, idx) = key;
                let vp = tryinfo_at(m.vals, idx);
                (*vp).is_opt = is_opt;
                (*vp).payload_idx = payload_idx;
                (*vp).err_idx = err_idx;
                *(m.states + idx) = SLOT_OCCUPIED;
            }
            m.len = m.len + 1;
            return;
        }
        let k = unsafe { *usize_at(m.keys, idx) };
        if k == key {
            unsafe {
                let vp = tryinfo_at(m.vals, idx);
                (*vp).is_opt = is_opt;
                (*vp).payload_idx = payload_idx;
                (*vp).err_idx = err_idx;
            }
            return;
        }
        idx = (idx + 1) & mask;
    }
}

pub fn ptr_trymap_get(m: view<PtrTryMap>, key: usize) -> *mut TryExprInfo {
    if m.cap == 0 {
        return 0 as *mut TryExprInfo;
    }
    let mask = m.cap - 1;
    let mut idx = (hash_u64(key as u64) as usize) & mask;
    let mut probes: usize = 0;
    while (probes < m.cap) {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            return 0 as *mut TryExprInfo;
        }
        if st == SLOT_OCCUPIED {
            let k = unsafe { *usize_at(m.keys, idx) };
            if k == key {
                return unsafe { tryinfo_at(m.vals, idx) };
            }
        }
        idx = (idx + 1) & mask;
        probes = probes + 1;
    }
    0 as *mut TryExprInfo
}

pub fn thir_init(thir: mut_view<Thir>) {
    type_interner_init(mut_view(thir.interner));
    ptr_typemap_init(mut_view(thir.expr_types));
    ptr_typemap_init(mut_view(thir.pat_types));
    ptr_u32map_init(mut_view(thir.expr_variants));
    ptr_u32map_init(mut_view(thir.pat_variants));
    ptr_itemmap_init(mut_view(thir.expr_methods));
    ptr_typemap_init(mut_view(thir.item_types));
    ptr_typemap_init(mut_view(thir.param_types));
    sym_typemap_init(mut_view(thir.symbol_types));
    sym_constmap_init(mut_view(thir.symbol_consts));
    ptr_substmap_init(mut_view(thir.expr_substs));
    ptr_substmap_init(mut_view(thir.pat_substs));
    ptr_trymap_init(mut_view(thir.expr_try_info));
}

pub fn thir_free(thir: mut_view<Thir>) {
    ptr_trymap_free(mut_view(thir.expr_try_info));
    ptr_substmap_free(mut_view(thir.pat_substs));
    ptr_substmap_free(mut_view(thir.expr_substs));
    sym_constmap_free(mut_view(thir.symbol_consts));
    sym_typemap_free(mut_view(thir.symbol_types));
    ptr_typemap_free(mut_view(thir.param_types));
    ptr_typemap_free(mut_view(thir.item_types));
    ptr_itemmap_free(mut_view(thir.expr_methods));
    ptr_u32map_free(mut_view(thir.pat_variants));
    ptr_u32map_free(mut_view(thir.expr_variants));
    ptr_typemap_free(mut_view(thir.pat_types));
    ptr_typemap_free(mut_view(thir.expr_types));
    type_interner_free(mut_view(thir.interner));
}

pub fn thir_set_expr_type(thir: mut_view<Thir>, expr: *const HirExpr, ty: TypeId) {
    ptr_typemap_insert(mut_view(thir.expr_types), expr as usize, ty);
}

pub fn thir_get_expr_type(thir: view<Thir>, expr: *const HirExpr) -> *mut TypeId {
    ptr_typemap_get(view(thir.expr_types), expr as usize)
}

pub fn thir_set_pat_type(thir: mut_view<Thir>, pat: *const HirPat, ty: TypeId) {
    ptr_typemap_insert(mut_view(thir.pat_types), pat as usize, ty);
}

pub fn thir_get_pat_type(thir: view<Thir>, pat: *const HirPat) -> *mut TypeId {
    ptr_typemap_get(view(thir.pat_types), pat as usize)
}

pub fn thir_set_item_type(thir: mut_view<Thir>, item: *const HirItem, ty: TypeId) {
    ptr_typemap_insert(mut_view(thir.item_types), item as usize, ty);
}

pub fn thir_get_item_type(thir: view<Thir>, item: *const HirItem) -> *mut TypeId {
    ptr_typemap_get(view(thir.item_types), item as usize)
}

pub fn thir_set_param_type(thir: mut_view<Thir>, param: *const HirParam, ty: TypeId) {
    ptr_typemap_insert(mut_view(thir.param_types), param as usize, ty);
}

pub fn thir_get_param_type(thir: view<Thir>, param: *const HirParam) -> *mut TypeId {
    ptr_typemap_get(view(thir.param_types), param as usize)
}

pub fn thir_set_sym_type(thir: mut_view<Thir>, sym: SymbolId, ty: TypeId) {
    sym_typemap_insert(mut_view(thir.symbol_types), sym, ty);
}

pub fn thir_get_sym_type(thir: view<Thir>, sym: SymbolId) -> *mut TypeId {
    sym_typemap_get(view(thir.symbol_types), sym)
}

pub fn thir_set_expr_variant(thir: mut_view<Thir>, expr: *const HirExpr, variant_idx: u32) {
    ptr_u32map_insert(mut_view(thir.expr_variants), expr as usize, variant_idx);
}

pub fn thir_get_expr_variant(thir: view<Thir>, expr: *const HirExpr) -> *mut u32 {
    ptr_u32map_get(view(thir.expr_variants), expr as usize)
}

pub fn thir_set_pat_variant(thir: mut_view<Thir>, pat: *const HirPat, variant_idx: u32) {
    ptr_u32map_insert(mut_view(thir.pat_variants), pat as usize, variant_idx);
}

pub fn thir_get_pat_variant(thir: view<Thir>, pat: *const HirPat) -> *mut u32 {
    ptr_u32map_get(view(thir.pat_variants), pat as usize)
}

pub fn thir_set_expr_method(thir: mut_view<Thir>, expr: *const HirExpr, method: *const HirItem) {
    ptr_itemmap_insert(mut_view(thir.expr_methods), expr as usize, method);
}

pub fn thir_get_expr_method(thir: view<Thir>, expr: *const HirExpr) -> *mut *const HirItem {
    ptr_itemmap_get(view(thir.expr_methods), expr as usize)
}



const ALIGN_1: u32 = 1u32;
const ALIGN_2: u32 = 2u32;
const ALIGN_4: u32 = 4u32;
const ALIGN_8: u32 = 8u32;
const SIZE_0: u32 = 0u32;
const SIZE_1: u32 = 1u32;
const SIZE_2: u32 = 2u32;
const SIZE_4: u32 = 4u32;
const SIZE_8: u32 = 8u32;
const SIZE_16: u32 = 16u32;

pub struct Layout {
    pub size: u32,
    pub align: u32,
}

struct FieldLayout {
    pub index: u32,
    pub size: u32,
    pub align: u32,
}

unsafe fn field_layout_at(base: *mut FieldLayout, idx: usize) -> *mut FieldLayout {
    let off = ((idx as isize) * (size_of<FieldLayout>() as isize)) as usize;
    ((base as usize) + off) as *mut FieldLayout
}

fn align_up_u32(offset: u32, align: u32) -> u32 {
    if (align <= 1u32) {
        return offset;
    }
    let mask = align - 1u32;
    (offset + mask) & (0xFFFFFFFFu32 ^ mask)
}

fn field_comes_before(a: view<FieldLayout>, b: view<FieldLayout>) -> bool {
    if a.align != b.align {
        return a.align > b.align;
    }
    if a.size != b.size {
        return a.size > b.size;
    }
    let ai = a.index;
    let bi = b.index;
    ai < bi
}

fn sort_fields(fl: *mut FieldLayout, count: usize) {
    let mut i: usize = 1;
    while (i < count) {
        let cur_p = unsafe { field_layout_at(fl, i) };
        let cur_index = unsafe { (*cur_p).index };
        let cur_size = unsafe { (*cur_p).size };
        let cur_align = unsafe { (*cur_p).align };
        let cur = FieldLayout {
            index: cur_index,
            size: cur_size,
            align: cur_align,
        };
        let mut j: usize = i;
        while (j > 0) {
            let prev_p = unsafe { field_layout_at(fl, j - 1) };
            let move_right = unsafe { field_comes_before(view(cur), view(*prev_p)) };
            if !move_right {
                break;
            }
            let dst_p = unsafe { field_layout_at(fl, j) };
            unsafe {
                (*dst_p).index = (*prev_p).index;
                (*dst_p).size = (*prev_p).size;
                (*dst_p).align = (*prev_p).align;
            }
            j = j - 1;
        }
        let target_p = unsafe { field_layout_at(fl, j) };
        unsafe {
            (*target_p).index = cur.index;
            (*target_p).size = cur.size;
            (*target_p).align = cur.align;
        }
        i = i + 1;
    }
}

pub fn type_align(id: TypeId, ti: view<TypeInterner>) -> u32 {
    if id.v == 0u32 {
        return ALIGN_1;
    }
    if id.v == ti.t_unit.v || id.v == ti.t_never.v {
        return ALIGN_1;
    }
    if id.v == ti.t_bool.v || id.v == ti.t_i8.v || id.v == ti.t_u8.v {
        return ALIGN_1;
    }
    if id.v == ti.t_i16.v || id.v == ti.t_u16.v {
        return ALIGN_2;
    }
    if id.v == ti.t_i32.v || id.v == ti.t_u32.v || id.v == ti.t_char.v {
        return ALIGN_4;
    }
    if id.v == ti.t_i64.v || id.v == ti.t_u64.v || id.v == ti.t_isize.v ||
        id.v == ti.t_usize.v || id.v == ti.t_str.v {
        return ALIGN_8;
    }

    let ty = type_get(ti, id);
    if (ty as usize) == 0 {
        return ALIGN_1;
    }
    let k = unsafe { (*ty).kind };
    if k == TY_BOOL || k == TY_I8 || k == TY_U8 {
        return ALIGN_1;
    }
    if k == TY_I16 || k == TY_U16 {
        return ALIGN_2;
    }
    if k == TY_I32 || k == TY_U32 || k == TY_CHAR || k == TY_INT_VAR {
        return ALIGN_4;
    }
    if k == TY_I64 || k == TY_U64 || k == TY_ISIZE || k == TY_USIZE {
        return ALIGN_8;
    }
    if k == TY_PTR || k == TY_FN || k == TY_VIEW || k == TY_MUT_VIEW || k == TY_PARAM {
        return ALIGN_8;
    }
    if k == TY_SLICE || k == TY_ARRAY {
        let elem_v = unsafe { (*ty).elem.v };
        return type_align(TypeId { v: elem_v }, ti);
    }
    if k == TY_ENUM {
        let mut max_align: u32 = ALIGN_4;
        let vcount = unsafe { (*ty).variant_count };
        let vcounts = unsafe { (*ty).variant_field_counts };
        let vfields = unsafe { (*ty).variant_fields };
        if (vcounts as usize) != 0 && (vfields as usize) != 0 {
            let mut i: usize = 0;
            while (i < vcount) {
                let count = unsafe { *usize_at(vcounts, i) };
                let vf = unsafe { *typeid_ptr_at(vfields, i) };
                let mut j: usize = 0;
                while (j < count) {
                    let fty_v = unsafe { (*typeid_at(vf, j)).v };
                    let a = type_align(TypeId { v: fty_v }, ti);
                    if a > max_align {
                        max_align = a;
                    }
                    j = j + 1;
                }
                i = i + 1;
            }
        }
        return max_align;
    }
    if k == TY_TUPLE || k == TY_STRUCT {
        let mut align: u32 = ALIGN_1;
        let count = unsafe { (*ty).field_count };
        let fields = unsafe { (*ty).fields };
        let mut i: usize = 0;
        while (i < count) {
            let fty_v = unsafe { (*typeid_at(fields, i)).v };
            let fa = type_align(TypeId { v: fty_v }, ti);
            if fa > align {
                align = fa;
            }
            i = i + 1;
        }
        return align;
    }
    if k == TY_CLOSURE {
        let mut align: u32 = ALIGN_8;
        let count = unsafe { (*ty).capture_count };
        let caps = unsafe { (*ty).captures };
        let mut i: usize = 0;
        while (i < count) {
            let cap = unsafe { capture_at(caps, i) };
            let cty_v = unsafe { (*cap).ty.v };
            let fa = type_align(TypeId { v: cty_v }, ti);
            if fa > align {
                align = fa;
            }
            i = i + 1;
        }
        return align;
    }
    ALIGN_1
}

pub fn type_size(id: TypeId, ti: view<TypeInterner>) -> u32 {
    if id.v == 0u32 {
        return SIZE_0;
    }
    if id.v == ti.t_unit.v || id.v == ti.t_never.v {
        return SIZE_0;
    }
    if id.v == ti.t_bool.v || id.v == ti.t_i8.v || id.v == ti.t_u8.v {
        return SIZE_1;
    }
    if id.v == ti.t_i16.v || id.v == ti.t_u16.v {
        return SIZE_2;
    }
    if id.v == ti.t_i32.v || id.v == ti.t_u32.v || id.v == ti.t_char.v {
        return SIZE_4;
    }
    if id.v == ti.t_i64.v || id.v == ti.t_u64.v || id.v == ti.t_isize.v || id.v == ti.t_usize.v {
        return SIZE_8;
    }
    if id.v == ti.t_str.v {
        return SIZE_16;
    }

    let ty = type_get(ti, id);
    if (ty as usize) == 0 {
        return SIZE_0;
    }
    let k = unsafe { (*ty).kind };
    if k == TY_BOOL || k == TY_I8 || k == TY_U8 {
        return SIZE_1;
    }
    if k == TY_I16 || k == TY_U16 {
        return SIZE_2;
    }
    if k == TY_I32 || k == TY_U32 || k == TY_CHAR || k == TY_INT_VAR {
        return SIZE_4;
    }
    if k == TY_I64 || k == TY_U64 || k == TY_ISIZE || k == TY_USIZE {
        return SIZE_8;
    }
    if k == TY_PTR || k == TY_FN || k == TY_PARAM {
        return SIZE_8;
    }
    if k == TY_VIEW || k == TY_MUT_VIEW {
        let pt_v = unsafe { (*ty).pointee.v };
        let pty = type_get(ti, TypeId { v: pt_v });
        let pk = unsafe { (*pty).kind };
        if pk == TY_SLICE {
            return SIZE_16;
        }
        return SIZE_8;
    }
    if k == TY_SLICE {
        return SIZE_0;
    }
    if k == TY_ARRAY {
        let elem_v = unsafe { (*ty).elem.v };
        let arr_len = unsafe { (*ty).array_len };
        return type_size(TypeId { v: elem_v }, ti) * (arr_len as u32);
    }
    if k == TY_ENUM {
        let mut max_align: u32 = ALIGN_4;
        let mut max_payload_size: u32 = SIZE_0;
        let vcount = unsafe { (*ty).variant_count };
        let vcounts = unsafe { (*ty).variant_field_counts };
        let vfields = unsafe { (*ty).variant_fields };
        if (vcounts as usize) != 0 && (vfields as usize) != 0 {
            let mut i: usize = 0;
            while (i < vcount) {
                let count = unsafe { *usize_at(vcounts, i) };
                if count > 0 {
                    let vf = unsafe { *typeid_ptr_at(vfields, i) };
                    let fl = unsafe {
                        let fbytes = mul_usize(count, size_of<FieldLayout>());
                        heap_alloc(fbytes, align_of<FieldLayout>()) as *mut FieldLayout
                    };
                    let mut j: usize = 0;
                    while (j < count) {
                        let fty_v = unsafe { (*typeid_at(vf, j)).v };
                        let fa = type_align(TypeId { v: fty_v }, ti);
                        let fs = type_size(TypeId { v: fty_v }, ti);
                        if fa > max_align {
                            max_align = fa;
                        }
                        let fp = unsafe { field_layout_at(fl, j) };
                        unsafe {
                            (*fp).index = j as u32;
                            (*fp).align = fa;
                            (*fp).size = fs;
                        }
                        j = j + 1;
                    }
                    sort_fields(fl, count);
                    let mut offset: u32 = 0u32;
                    let mut k_idx: usize = 0;
                    while (k_idx < count) {
                        let fp = unsafe { field_layout_at(fl, k_idx) };
                        let fa = unsafe { (*fp).align };
                        let fs = unsafe { (*fp).size };
                        offset = align_up_u32(offset, fa);
                        offset = offset + fs;
                        k_idx = k_idx + 1;
                    }
                    unsafe {
                        heap_free(
                            fl as *mut u8,
                            mul_usize(count, size_of<FieldLayout>()),
                            align_of<FieldLayout>()
                        );
                    }
                    if offset > max_payload_size {
                        max_payload_size = offset;
                    }
                }
                i = i + 1;
            }
        }
        let total_size = SIZE_4 + max_payload_size;
        return align_up_u32(total_size, max_align);
    }
    if k == TY_TUPLE || k == TY_STRUCT {
        let count = unsafe { (*ty).field_count };
        if count == 0 {
            return SIZE_0;
        }
        let fields = unsafe { (*ty).fields };
        let is_repr_c = unsafe { (*ty).is_repr_c };
        let fl = unsafe {
            heap_alloc(mul_usize(count, size_of<FieldLayout>()), align_of<FieldLayout>()) as *mut FieldLayout
        };
        let mut max_align: u32 = ALIGN_1;
        let mut i: usize = 0;
        while (i < count) {
            let fty_v = unsafe { (*typeid_at(fields, i)).v };
            let fa = type_align(TypeId { v: fty_v }, ti);
            let fs = type_size(TypeId { v: fty_v }, ti);
            if fa > max_align {
                max_align = fa;
            }
            let fp = unsafe { field_layout_at(fl, i) };
            unsafe {
                (*fp).index = i as u32;
                (*fp).align = fa;
                (*fp).size = fs;
            }
            i = i + 1;
        }
        if k == TY_TUPLE || !is_repr_c {
            sort_fields(fl, count);
        }
        let mut offset: u32 = 0u32;
        let mut j: usize = 0;
        while (j < count) {
            let fp = unsafe { field_layout_at(fl, j) };
            let fa = unsafe { (*fp).align };
            let fs = unsafe { (*fp).size };
            offset = align_up_u32(offset, fa);
            offset = offset + fs;
            j = j + 1;
        }
        unsafe {
            heap_free(fl as *mut u8, mul_usize(count, size_of<FieldLayout>()), align_of<FieldLayout>());
        }
        return align_up_u32(offset, max_align);
    }
    if k == TY_CLOSURE {
        let mut offset: u32 = SIZE_8;
        let mut max_align: u32 = ALIGN_8;
        let count = unsafe { (*ty).capture_count };
        let caps = unsafe { (*ty).captures };
        let mut i: usize = 0;
        while (i < count) {
            let cap = unsafe { capture_at(caps, i) };
            let cty_v = unsafe { (*cap).ty.v };
            let a = type_align(TypeId { v: cty_v }, ti);
            let s = type_size(TypeId { v: cty_v }, ti);
            if a > max_align {
                max_align = a;
            }
            offset = align_up_u32(offset, a);
            offset = offset + s;
            i = i + 1;
        }
        return align_up_u32(offset, max_align);
    }
    SIZE_0
}

pub fn type_layout(id: TypeId, ti: view<TypeInterner>) -> Layout {
    let id_v = id.v;
    Layout {
        size: type_size(TypeId { v: id_v }, ti),
        align: type_align(TypeId { v: id_v }, ti),
    }
}

pub fn type_field_offset(id: TypeId, field_idx: usize, ti: view<TypeInterner>) -> u32 {
    let ty = type_get(ti, id);
    if (ty as usize) == 0 {
        return 0u32;
    }
    let k = unsafe { (*ty).kind };
    if k == TY_TUPLE || k == TY_STRUCT {
        let count = unsafe { (*ty).field_count };
        if field_idx >= count {
            return 0u32;
        }
        let fields = unsafe { (*ty).fields };
        let is_repr_c = unsafe { (*ty).is_repr_c };
        let fl = unsafe {
            heap_alloc(mul_usize(count, size_of<FieldLayout>()), align_of<FieldLayout>()) as *mut FieldLayout
        };
        let mut i: usize = 0;
        while (i < count) {
            let fty_v = unsafe { (*typeid_at(fields, i)).v };
            let fa = type_align(TypeId { v: fty_v }, ti);
            let fs = type_size(TypeId { v: fty_v }, ti);
            let fp = unsafe { field_layout_at(fl, i) };
            unsafe {
                (*fp).index = i as u32;
                (*fp).align = fa;
                (*fp).size = fs;
            }
            i = i + 1;
        }
        if k == TY_TUPLE || !is_repr_c {
            sort_fields(fl, count);
        }
        let mut offset: u32 = 0u32;
        let mut target_offset: u32 = 0u32;
        let mut j: usize = 0;
        while (j < count) {
            let fp = unsafe { field_layout_at(fl, j) };
            let f_index = unsafe { (*fp).index };
            let fa = unsafe { (*fp).align };
            let fs = unsafe { (*fp).size };
            offset = align_up_u32(offset, fa);
            if (f_index as usize) == field_idx {
                target_offset = offset;
                break;
            }
            offset = offset + fs;
            j = j + 1;
        }
        unsafe {
            heap_free(fl as *mut u8, mul_usize(count, size_of<FieldLayout>()), align_of<FieldLayout>());
        }
        return target_offset;
    }
    if k == TY_CLOSURE {
        if field_idx == 0 {
            return 0u32;
        }
        let count = unsafe { (*ty).capture_count };
        if field_idx > count {
            return 0u32;
        }
        let caps = unsafe { (*ty).captures };
        let mut offset: u32 = SIZE_8;
        let mut i: usize = 0;
        while (i < count) {
            let cap = unsafe { capture_at(caps, i) };
            let cty_v = unsafe { (*cap).ty.v };
            let a = type_align(TypeId { v: cty_v }, ti);
            let s = type_size(TypeId { v: cty_v }, ti);
            offset = align_up_u32(offset, a);
            if field_idx == i + 1 {
                return offset;
            }
            offset = offset + s;
            i = i + 1;
        }
        return offset;
    }
    0u32
}

pub fn type_enum_field_offset(
    id: TypeId,
    variant_idx: u32,
    field_idx: usize,
    ti: view<TypeInterner>
) -> u32 {
    let ty = type_get(ti, id);
    if (ty as usize) == 0 {
        return 0u32;
    }
    let k = unsafe { (*ty).kind };
    if k != TY_ENUM {
        return 0u32;
    }
    let vcount = unsafe { (*ty).variant_count };
    if (variant_idx as usize) >= vcount {
        return 0u32;
    }
    let vcounts = unsafe { (*ty).variant_field_counts };
    let vfields = unsafe { (*ty).variant_fields };
    if (vcounts as usize) == 0 || (vfields as usize) == 0 {
        return 0u32;
    }
    let count = unsafe { *usize_at(vcounts, variant_idx as usize) };
    if field_idx >= count {
        return 0u32;
    }
    let vf = unsafe { *typeid_ptr_at(vfields, variant_idx as usize) };
    let fl = unsafe {
        heap_alloc(mul_usize(count, size_of<FieldLayout>()), align_of<FieldLayout>()) as *mut FieldLayout
    };
    let mut i: usize = 0;
    while (i < count) {
        let fty_v = unsafe { (*typeid_at(vf, i)).v };
        let fa = type_align(TypeId { v: fty_v }, ti);
        let fs = type_size(TypeId { v: fty_v }, ti);
        let fp = unsafe { field_layout_at(fl, i) };
        unsafe {
            (*fp).index = i as u32;
            (*fp).align = fa;
            (*fp).size = fs;
        }
        i = i + 1;
    }
    sort_fields(fl, count);
    let mut offset: u32 = SIZE_4;
    let mut target_offset: u32 = 0u32;
    let mut j: usize = 0;
    while (j < count) {
        let fp = unsafe { field_layout_at(fl, j) };
        let f_index = unsafe { (*fp).index };
        let fa = unsafe { (*fp).align };
        let fs = unsafe { (*fp).size };
        offset = align_up_u32(offset, fa);
        if (f_index as usize) == field_idx {
            target_offset = offset;
            break;
        }
        offset = offset + fs;
        j = j + 1;
    }
    unsafe {
        heap_free(fl as *mut u8, mul_usize(count, size_of<FieldLayout>()), align_of<FieldLayout>());
    }
    target_offset
}


// =============================================================================
// 6b. Source Manager (compiler/source/manager.ax)
// =============================================================================




fn mgr_bytes_eq(a: *const u8, b: *const u8, n: usize) -> bool {
    let mut i: usize = 0;
    while i < n {
        if unsafe { *(a + i) } != unsafe { *(b + i) } {
            return false;
        }
        i = i + 1;
    }
    true
}

fn utf8_count_scalars(bytes: *const u8, byte_len: usize) -> usize {
    let mut count: usize = 0;
    let mut i: usize = 0;
    while i < byte_len {
        let b = unsafe { *(bytes + i) };
        if (b & 0xC0u8) != 0x80u8 {
            count = count + 1;
        }
        i = i + 1;
    }
    count
}

fn utf8_validate(bytes: *const u8, byte_len: usize) -> bool {
    let mut i: usize = 0;
    while i < byte_len {
        let b0 = unsafe { *(bytes + i) };
        if b0 < 0x80u8 {
            i = i + 1;
        } else if (b0 & 0xE0u8) == 0xC0u8 {
            if i + 1 >= byte_len { return false; }
            let b1 = unsafe { *(bytes + i + 1) };
            if (b1 & 0xC0u8) != 0x80u8 { return false; }
            if b0 < 0xC2u8 { return false; }
            i = i + 2;
        } else if (b0 & 0xF0u8) == 0xE0u8 {
            if i + 2 >= byte_len { return false; }
            let b1 = unsafe { *(bytes + i + 1) };
            let b2 = unsafe { *(bytes + i + 2) };
            if (b1 & 0xC0u8) != 0x80u8 || (b2 & 0xC0u8) != 0x80u8 { return false; }
            if b0 == 0xE0u8 && b1 < 0xA0u8 { return false; }
            if b0 == 0xEDu8 && b1 >= 0xA0u8 { return false; }
            i = i + 3;
        } else if (b0 & 0xF8u8) == 0xF0u8 {
            if i + 3 >= byte_len { return false; }
            let b1 = unsafe { *(bytes + i + 1) };
            let b2 = unsafe { *(bytes + i + 2) };
            let b3 = unsafe { *(bytes + i + 3) };
            if (b1 & 0xC0u8) != 0x80u8 || (b2 & 0xC0u8) != 0x80u8 || (b3 & 0xC0u8) != 0x80u8 { return false; }
            if b0 == 0xF0u8 && b1 < 0x90u8 { return false; }
            if b0 == 0xF4u8 && b1 > 0x8Fu8 { return false; }
            if b0 > 0xF4u8 { return false; }
            i = i + 4;
        } else {
            return false;
        }
    }
    true
}

pub struct SourceFile {
    pub id: FileId,
    pub canonical_path: StrView,
    pub text: StrView,
    pub content_hash: u64,
    pub line_offsets: *mut u32,
    pub line_count: usize,
    pub line_cap: usize,
    pub alloc_ptr: *mut u8,
    pub alloc_size: usize,
    pub has_invalid_utf8: bool,
}

unsafe fn file_ptr(files: *mut SourceFile, idx: usize) -> *mut SourceFile {
    ((files as usize) + ((( idx as isize) * (size_of<SourceFile>() as isize)) as usize)) as *mut SourceFile
}

unsafe fn offset_ptr(offsets: *mut u32, idx: usize) -> *mut u32 {
    ((offsets as usize) + idx * 4) as *mut u32
}

pub struct SourceDatabase {
    pub arena: Arena,
    pub files: *mut SourceFile,
    pub files_count: usize,
    pub files_cap: usize,
}

pub fn source_db_init(db: mut_view<SourceDatabase>) {
    db.arena.head = 0 as *mut ArenaChunk;
    db.files = 0 as *mut SourceFile;
    db.files_count = 0;
    db.files_cap = 0;
}

pub fn source_db_free(db: mut_view<SourceDatabase>) {
    let mut i: usize = 0;
    while i < db.files_count {
        let sf = unsafe { *(file_ptr(db.files, i)) };
        if sf.line_cap > 0 && sf.line_offsets as usize != 0 {
            unsafe {
                heap_free(sf.line_offsets as *mut u8, sf.line_cap * 4, 4);
            }
        }
        if sf.alloc_ptr as usize != 0 && sf.alloc_size > 0 {
            unsafe {
                heap_free(sf.alloc_ptr, sf.alloc_size, 1);
            }
        }
        i = i + 1;
    }
    if db.files_cap > 0 && db.files as usize != 0 {
        unsafe {
            heap_free(db.files as *mut u8, ((( db.files_cap as isize) * (size_of<SourceFile>() as isize)) as usize), align_of<SourceFile>());
        }
    }
    db.files = 0 as *mut SourceFile;
    db.files_count = 0;
    db.files_cap = 0;
    arena_destroy(mut_view(db.arena));
}

pub struct LineMapResult {
    pub offsets: *mut u32,
    pub count: usize,
    pub cap: usize,
}

fn build_line_map(text_ptr: *const u8, text_len: usize) -> LineMapResult {
    let mut cap: usize = 16;
    let mut count: usize = 0;
    let mut offsets = unsafe { heap_alloc(cap * 4, 4) as *mut u32 };

    // Line 1 starts at byte offset 0
    unsafe {
        *(offset_ptr(offsets, 0)) = 0u32;
    }
    count = 1;

    let mut i: usize = 0;
    while i < text_len {
        let b = unsafe { *(text_ptr + i) };
        if b == 13u8 && i + 1 < text_len && unsafe { *(text_ptr + i + 1) } == 10u8 { // \r\n
            if count == cap {
                let new_cap = cap + cap;
                let new_offsets = unsafe { heap_alloc((new_cap << 2), 4) as *mut u32 };
                if count > 0 && offsets as usize != 0 {
                    unsafe {
                        ptr_copy_nonoverlapping<u8>(offsets as *const u8, new_offsets as *mut u8, count * 4);
                        heap_free(offsets as *mut u8, cap * 4, 4);
                    }
                }
                offsets = new_offsets;
                cap = new_cap;
            }
            unsafe {
                *(offset_ptr(offsets, count)) = (i + 2) as u32;
            }
            count = count + 1;
            i = i + 2;
        } else if b == 10u8 { // \n
            if count == cap {
                let new_cap = cap + cap;
                let new_offsets = unsafe { heap_alloc((new_cap << 2), 4) as *mut u32 };
                if count > 0 && offsets as usize != 0 {
                    unsafe {
                        ptr_copy_nonoverlapping<u8>(offsets as *const u8, new_offsets as *mut u8, count * 4);
                        heap_free(offsets as *mut u8, cap * 4, 4);
                    }
                }
                offsets = new_offsets;
                cap = new_cap;
            }
            unsafe {
                *(offset_ptr(offsets, count)) = (i + 1) as u32;
            }
            count = count + 1;
            i = i + 1;
        } else {
            i = i + 1;
        }
    }

    LineMapResult {
        offsets: offsets,
        count: count,
        cap: cap,
    }
}

pub fn source_db_add_virtual(db: mut_view<SourceDatabase>, identity_ptr: *const u8, identity_len: usize, text_ptr: *const u8, text_len: usize) -> FileId {
    // Check if file with same identity is already loaded
    let mut i: usize = 0;
    while i < db.files_count {
        let existing = unsafe { *(file_ptr(db.files, i)) };
        if existing.canonical_path.len == identity_len && mgr_bytes_eq(existing.canonical_path.ptr, identity_ptr, identity_len) {
            return FileId { v: existing.id.v };
        }
        i = i + 1;
    }

    // Allocate copy of path in db.arena
    let path_copy = arena_alloc_raw(mut_view(db.arena), identity_len + 1, 1);
    if identity_len > 0 && identity_ptr as usize != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(identity_ptr, path_copy, identity_len);
            *(path_copy + identity_len) = 0u8;
        }
    }

    // Handle UTF-8 BOM in text
    let mut p_text = text_ptr;
    let mut actual_len = text_len;
    if actual_len >= 3 && unsafe { *p_text } == 0xEFu8 && unsafe { *(p_text + 1) } == 0xBBu8 && unsafe { *(p_text + 2) } == 0xBFu8 {
        p_text = unsafe { p_text + 3 };
        actual_len = actual_len - 3;
    }

    // Allocate copy of text in db.arena
    let text_copy = arena_alloc_raw(mut_view(db.arena), actual_len + 1, 1);
    if actual_len > 0 && p_text as usize != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(p_text, text_copy, actual_len);
            *(text_copy + actual_len) = 0u8;
        }
    }

    let hash = ax_hash_bytes(text_copy as *const u8, actual_len);
    let is_valid = utf8_validate(text_copy as *const u8, actual_len);

    let lm = build_line_map(text_copy as *const u8, actual_len);

    let new_id = FileId { v: (db.files_count + 1) as u32 };

    if db.files_count == db.files_cap {
        let new_cap = if db.files_cap == 0 { 8 } else { db.files_cap + db.files_cap };
        let new_files = unsafe { heap_alloc(((( new_cap as isize) * (size_of<SourceFile>() as isize)) as usize), align_of<SourceFile>()) as *mut SourceFile };
        if db.files_count > 0 && db.files as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(db.files as *const u8, new_files as *mut u8, ((( db.files_count as isize) * (size_of<SourceFile>() as isize)) as usize));
                heap_free(db.files as *mut u8, ((( db.files_cap as isize) * (size_of<SourceFile>() as isize)) as usize), align_of<SourceFile>());
            }
        }
        db.files = new_files;
        db.files_cap = new_cap;
    }

    let sf = SourceFile {
        id: FileId { v: new_id.v },
        canonical_path: StrView { ptr: path_copy as *const u8, len: identity_len },
        text: StrView { ptr: text_copy as *const u8, len: actual_len },
        content_hash: hash,
        line_offsets: lm.offsets,
        line_count: lm.count,
        line_cap: lm.cap,
        alloc_ptr: 0 as *mut u8,
        alloc_size: 0,
        has_invalid_utf8: !is_valid,
    };

    unsafe {
        *(file_ptr(db.files, db.files_count)) = sf;
    }
    db.files_count = db.files_count + 1;

    new_id
}

pub fn source_db_file_count(db: view<SourceDatabase>) -> usize {
    db.files_count
}

pub fn source_db_text(db: view<SourceDatabase>, file: FileId) -> StrView {
    if file.v == 0 || (file.v as usize) > db.files_count {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let sf = unsafe { *(file_ptr(db.files, (file.v - 1) as usize)) };
    sf.text
}

pub fn source_db_path(db: view<SourceDatabase>, file: FileId) -> StrView {
    if file.v == 0 || (file.v as usize) > db.files_count {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let sf = unsafe { *(file_ptr(db.files, (file.v - 1) as usize)) };
    sf.canonical_path
}

pub fn source_db_hash(db: view<SourceDatabase>, file: FileId) -> u64 {
    if file.v == 0 || (file.v as usize) > db.files_count {
        return 0u64;
    }
    let sf = unsafe { *(file_ptr(db.files, (file.v - 1) as usize)) };
    sf.content_hash
}

pub fn source_db_has_invalid_utf8(db: view<SourceDatabase>, file: FileId) -> bool {
    if file.v == 0 || (file.v as usize) > db.files_count {
        return false;
    }
    let sf = unsafe { *(file_ptr(db.files, (file.v - 1) as usize)) };
    sf.has_invalid_utf8
}

pub fn source_db_span_text(db: view<SourceDatabase>, span: Span) -> StrView {
    if span.file.v == 0 || (span.file.v as usize) > db.files_count {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let sf = unsafe { *(file_ptr(db.files, (span.file.v - 1) as usize)) };
    if span.start > span.end || (span.end as usize) > sf.text.len {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    StrView {
        ptr: (sf.text.ptr as usize + (span.start as usize)) as *const u8,
        len: (span.end - span.start) as usize,
    }
}

pub fn source_db_line_col(db: view<SourceDatabase>, span: Span) -> LineCol {
    if span.file.v == 0 || (span.file.v as usize) > db.files_count {
        return LineCol.zero();
    }
    let sf = unsafe { *(file_ptr(db.files, (span.file.v - 1) as usize)) };

    let mut offset = span.start;
    if (offset as usize) > sf.text.len {
        offset = sf.text.len as u32;
    }

    let mut low: usize = 0;
    let mut high: usize = sf.line_count;
    let mut line_idx: usize = 0;
    while low < high {
        let mid = low + (high - low) / 2;
        let line_off = unsafe { *(offset_ptr(sf.line_offsets, mid)) };
        if line_off <= offset {
            line_idx = mid;
            low = mid + 1;
        } else {
            high = mid;
        }
    }

    let line_start = unsafe { *(offset_ptr(sf.line_offsets, line_idx)) };
    let col_bytes = offset - line_start + 1u32;
    let byte_diff = (offset - line_start) as usize;
    let p = (sf.text.ptr as usize + line_start as usize) as *const u8;
    let col_chars = (utf8_count_scalars(p, byte_diff) + 1) as u32;

    LineCol {
        line: (line_idx + 1) as u32,
        col_bytes: col_bytes,
        col_chars: col_chars,
    }
}

pub fn source_db_line_range(db: view<SourceDatabase>, file: FileId, line: u32) -> Span {
    if file.v == 0 || (file.v as usize) > db.files_count {
        return span_none();
    }
    let sf = unsafe { *(file_ptr(db.files, (file.v - 1) as usize)) };
    if line == 0u32 || (line as usize) > sf.line_count {
        return span_none();
    }

    let start = unsafe { *(offset_ptr(sf.line_offsets, (line - 1u32) as usize)) };
    let mut end: u32 = 0u32;
    if (line as usize) < sf.line_count {
        end = unsafe { *(offset_ptr(sf.line_offsets, line as usize)) };
        // Exclude trailing \n or \r\n
        if end > start && unsafe { *(sf.text.ptr + (end - 1u32) as usize) } == 10u8 { // \n
            end = end - 1u32;
            if end > start && unsafe { *(sf.text.ptr + (end - 1u32) as usize) } == 13u8 { // \r
                end = end - 1u32;
            }
        }
    } else {
        end = sf.text.len as u32;
    }
    span_new(file, start, end)
}

// =============================================================================
// 7. Traits: Solver & Coherence (compiler/traits/solver.ax)
// =============================================================================
// Trait obligation solver, coherence/overlap checking, method dispatch resolution,
// associated type lookup, and trait bound verification.
// Port of bootstrap/axiom0/src/traits/solver.{h,c} and trait/method logic in
// bootstrap/axiom0/src/types/typeck.c and bootstrap/axiom0/src/driver/mono.c.


pub const TRAIT_PROVEN: u8 = 0u8;
pub const TRAIT_DISPROVEN: u8 = 1u8;
pub const TRAIT_AMBIGUOUS: u8 = 2u8;
pub const TRAIT_OVERFLOW: u8 = 3u8;

const MSG_OVERLAP: [38]u8 = [
    111u8, 118u8, 101u8, 114u8, 108u8, 97u8, 112u8, 112u8, 105u8, 110u8,
    103u8, 32u8, 105u8, 109u8, 112u8, 108u8, 101u8, 109u8, 101u8, 110u8,
    116u8, 97u8, 116u8, 105u8, 111u8, 110u8, 115u8, 32u8, 102u8, 111u8,
    114u8, 32u8, 116u8, 114u8, 97u8, 105u8, 116u8, 0u8,
];

const MSG_AMBIGUOUS: [24]u8 = [
    109u8, 101u8, 116u8, 104u8, 111u8, 100u8, 32u8, 99u8, 97u8, 108u8,
    108u8, 32u8, 105u8, 115u8, 32u8, 97u8, 109u8, 98u8, 105u8, 103u8,
    117u8, 111u8, 117u8, 115u8,
];

const MSG_UNSATISFIED: [28]u8 = [
    116u8, 114u8, 97u8, 105u8, 116u8, 32u8, 98u8, 111u8, 117u8, 110u8,
    100u8, 32u8, 105u8, 115u8, 32u8, 110u8, 111u8, 116u8, 32u8, 115u8,
    97u8, 116u8, 105u8, 115u8, 102u8, 105u8, 101u8, 100u8,
];

pub fn sv_eq(a: view<StrView>, b: view<StrView>) -> bool {
    let a_len: usize = a.len;
    let b_len: usize = b.len;
    if a_len != b_len {
        return false;
    }
    if a_len == 0 {
        return true;
    }
    let a_ptr: *const u8 = a.ptr;
    let b_ptr: *const u8 = b.ptr;
    if (a_ptr as usize) == 0 || (b_ptr as usize) == 0 {
        return false;
    }
    let mut i: usize = 0;
    while (i < a_len) {
        let ca = unsafe { *(a_ptr + i) };
        let cb = unsafe { *(b_ptr + i) };
        if ca != cb {
            return false;
        }
        i = i + 1;
    }
    true
}

fn sv_is_2(sv: view<StrView>, c0: u8, c1: u8) -> bool {
    let s_len: usize = sv.len;
    let s_ptr: *const u8 = sv.ptr;
    if s_len != 2 || (s_ptr as usize) == 0 {
        return false;
    }
    unsafe { *(s_ptr + 0) == c0 && *(s_ptr + 1) == c1 }
}

fn sv_is_3(sv: view<StrView>, c0: u8, c1: u8, c2: u8) -> bool {
    let s_len: usize = sv.len;
    let s_ptr: *const u8 = sv.ptr;
    if s_len != 3 || (s_ptr as usize) == 0 {
        return false;
    }
    unsafe { *(s_ptr + 0) == c0 && *(s_ptr + 1) == c1 && *(s_ptr + 2) == c2 }
}

fn sv_is_4(sv: view<StrView>, c0: u8, c1: u8, c2: u8, c3: u8) -> bool {
    let s_len: usize = sv.len;
    let s_ptr: *const u8 = sv.ptr;
    if s_len != 4 || (s_ptr as usize) == 0 {
        return false;
    }
    unsafe {
        *(s_ptr + 0) == c0 && *(s_ptr + 1) == c1 &&
            *(s_ptr + 2) == c2 && *(s_ptr + 3) == c3
    }
}

fn sv_is_5(sv: view<StrView>, c0: u8, c1: u8, c2: u8, c3: u8, c4: u8) -> bool {
    let s_len: usize = sv.len;
    let s_ptr: *const u8 = sv.ptr;
    if s_len != 5 || (s_ptr as usize) == 0 {
        return false;
    }
    unsafe {
        *(s_ptr + 0) == c0 && *(s_ptr + 1) == c1 &&
            *(s_ptr + 2) == c2 && *(s_ptr + 3) == c3 && *(s_ptr + 4) == c4
    }
}

fn sv_is_6(sv: view<StrView>, c0: u8, c1: u8, c2: u8, c3: u8, c4: u8, c5: u8) -> bool {
    let s_len: usize = sv.len;
    let s_ptr: *const u8 = sv.ptr;
    if s_len != 6 || (s_ptr as usize) == 0 {
        return false;
    }
    unsafe {
        *(s_ptr + 0) == c0 && *(s_ptr + 1) == c1 && *(s_ptr + 2) == c2 &&
            *(s_ptr + 3) == c3 && *(s_ptr + 4) == c4 && *(s_ptr + 5) == c5
    }
}

fn sv_is_8(
    sv: view<StrView>,
    c0: u8,
    c1: u8,
    c2: u8,
    c3: u8,
    c4: u8,
    c5: u8,
    c6: u8,
    c7: u8
) -> bool {
    let s_len: usize = sv.len;
    let s_ptr: *const u8 = sv.ptr;
    if s_len != 8 || (s_ptr as usize) == 0 {
        return false;
    }
    unsafe {
        *(s_ptr + 0) == c0 && *(s_ptr + 1) == c1 && *(s_ptr + 2) == c2 &&
            *(s_ptr + 3) == c3 && *(s_ptr + 4) == c4 && *(s_ptr + 5) == c5 &&
            *(s_ptr + 6) == c6 && *(s_ptr + 7) == c7
    }
}

pub fn hir_item_name_sv(
    it: *const HirItem,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>
) -> StrView {
    if (it as usize) == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let name_v = unsafe { (*it).name.v };
    if name_v != 0u32 {
        return interner_get(str_in, StrId { v: name_v });
    }
    let sp_f = unsafe { (*it).span.file.v };
    if sp_f != 0u32 {
        let sp_s = unsafe { (*it).span.start };
        let sp_e = unsafe { (*it).span.end };
        return source_db_span_text(db, Span { file: FileId { v: sp_f }, start: sp_s, end: sp_e });
    }
    StrView { ptr: 0 as *const u8, len: 0 }
}

pub fn hir_type_path_name_sv(
    ty: *const HirType,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>
) -> StrView {
    if (ty as usize) == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let tk = unsafe { (*ty).kind };
    if tk != HIR_TYPE_PATH {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let name_v = unsafe { (*ty).path.name.v };
    if name_v != 0u32 {
        return interner_get(str_in, StrId { v: name_v });
    }
    let sp_f = unsafe { (*ty).path.span.file.v };
    if sp_f != 0u32 {
        let sp_s = unsafe { (*ty).path.span.start };
        let sp_e = unsafe { (*ty).path.span.end };
        return source_db_span_text(db, Span { file: FileId { v: sp_f }, start: sp_s, end: sp_e });
    }
    StrView { ptr: 0 as *const u8, len: 0 }
}

pub fn hir_generic_param_name_sv(
    gp: *const HirGenericParam,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>
) -> StrView {
    if (gp as usize) == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let name_v = unsafe { (*gp).name.v };
    if name_v != 0u32 {
        return interner_get(str_in, StrId { v: name_v });
    }
    let sp_f = unsafe { (*gp).span.file.v };
    if sp_f != 0u32 {
        let sp_s = unsafe { (*gp).span.start };
        let sp_e = unsafe { (*gp).span.end };
        return source_db_span_text(db, Span { file: FileId { v: sp_f }, start: sp_s, end: sp_e });
    }
    StrView { ptr: 0 as *const u8, len: 0 }
}

pub fn emit_trait_overlap_diag(sink: mut_view<DiagSink>, sp: Span) {
    let buf = arena_alloc_raw(mut_view(sink.arena), 38, 1);
    let mut i: usize = 0;
    while (i < 37) {
        unsafe {
            *(buf + i) = MSG_OVERLAP[i];
        }
        i = i + 1;
    }
    unsafe {
        *(buf + 37) = 0u8;
    }
    let sev = diag_code_severity(DiagCode { v: AX_TRAIT_OVERLAP });
    let mut d = Diagnostic {
        code: DiagCode { v: AX_TRAIT_OVERLAP },
        severity: sev,
        message: StrView { ptr: 0 as *const u8, len: 0 },
        primary: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    d.message.ptr = buf as *const u8;
    d.message.len = 37;
    d.primary.file.v = sp.file.v;
    d.primary.start = sp.start;
    d.primary.end = sp.end;
    diag_sink_report(mut_view(*sink), view(d));
}

pub fn emit_trait_ambiguous_diag(sink: mut_view<DiagSink>, sp: Span) {
    let buf = arena_alloc_raw(mut_view(sink.arena), 25, 1);
    let mut i: usize = 0;
    while (i < 24) {
        unsafe {
            *(buf + i) = MSG_AMBIGUOUS[i];
        }
        i = i + 1;
    }
    unsafe {
        *(buf + 24) = 0u8;
    }
    let sev = diag_code_severity(DiagCode { v: AX_TRAIT_AMBIGUOUS_METHOD });
    let mut d = Diagnostic {
        code: DiagCode { v: AX_TRAIT_AMBIGUOUS_METHOD },
        severity: sev,
        message: StrView { ptr: 0 as *const u8, len: 0 },
        primary: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    d.message.ptr = buf as *const u8;
    d.message.len = 24;
    d.primary.file.v = sp.file.v;
    d.primary.start = sp.start;
    d.primary.end = sp.end;
    diag_sink_report(mut_view(*sink), view(d));
}

pub fn emit_trait_unsatisfied_bound_diag(sink: mut_view<DiagSink>, sp: Span) {
    let buf = arena_alloc_raw(mut_view(sink.arena), 29, 1);
    let mut i: usize = 0;
    while (i < 28) {
        unsafe {
            *(buf + i) = MSG_UNSATISFIED[i];
        }
        i = i + 1;
    }
