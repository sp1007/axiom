        *(buf + 28) = 0u8;
    }
    let sev = diag_code_severity(DiagCode { v: AX_TRAIT_UNSATISFIED_BOUND });
    let mut d = Diagnostic {
        code: DiagCode { v: AX_TRAIT_UNSATISFIED_BOUND },
        severity: sev,
        message: StrView { ptr: 0 as *const u8, len: 0 },
        primary: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
