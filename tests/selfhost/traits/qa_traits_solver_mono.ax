fn types_zero_bytes(ptr: *mut u8, n: usize) {
    let mut i: usize = 0;
    while (i < n) {
        unsafe {
            *(ptr + i) = 0u8;
        }
        i = i + 1;
    }
}

fn hash_u64(v: u64) -> u64 {
    let mut h: u64 = v ^ (v >> 16u64);
    h = h ^ (h << 7u64);
    h ^ (h >> 11u64)
}

fn hash_u32(v: u32) -> u64 {
    hash_u64((v as u64) ^ 0x9e3779b9u64)
}

fn hash_combine(a: u64, b: u64) -> u64 {
    let h: u64 = a ^ b ^ 0x9e3779b9u64 ^ (a << 6u64) ^ (a >> 2u64);
    h ^ (h >> 13u64)
}

pub fn mul_usize(a: usize, b: usize) -> usize {
    ((a as isize) * (b as isize)) as usize
}

pub unsafe fn typeid_at(base: *mut TypeId, idx: usize) -> *mut TypeId {
    let off = ((idx as isize) * (size_of<TypeId>() as isize)) as usize;
    ((base as usize) + off) as *mut TypeId
}

pub unsafe fn typeid_ptr_at(base: *mut *mut TypeId, idx: usize) -> *mut *mut TypeId {
    let off = ((idx as isize) * (size_of<*mut TypeId>() as isize)) as usize;
    ((base as usize) + off) as *mut *mut TypeId
}

pub unsafe fn usize_at(base: *mut usize, idx: usize) -> *mut usize {
    let off = ((idx as isize) * (size_of<usize>() as isize)) as usize;
    ((base as usize) + off) as *mut usize
}

pub unsafe fn u32_at(base: *mut u32, idx: usize) -> *mut u32 {
    let off = ((idx as isize) * (size_of<u32>() as isize)) as usize;
    ((base as usize) + off) as *mut u32
}

pub unsafe fn capture_at(base: *mut ClosureCapture, idx: usize) -> *mut ClosureCapture {
    let off = ((idx as isize) * (size_of<ClosureCapture>() as isize)) as usize;
    ((base as usize) + off) as *mut ClosureCapture
}

unsafe fn axtype_ptr_at(base: *mut *mut AxType, idx: usize) -> *mut *mut AxType {
    let off = ((idx as isize) * (size_of<*mut AxType>() as isize)) as usize;
    ((base as usize) + off) as *mut *mut AxType
}

unsafe fn item_ptr_at(base: *mut *const HirItem, idx: usize) -> *mut *const HirItem {
    let off = ((idx as isize) * (size_of<*const HirItem>() as isize)) as usize;
    ((base as usize) + off) as *mut *const HirItem
}

unsafe fn constval_at(base: *mut ConstValue, idx: usize) -> *mut ConstValue {
    let off = ((idx as isize) * (size_of<ConstValue>() as isize)) as usize;
    ((base as usize) + off) as *mut ConstValue
}

unsafe fn subst_at(base: *mut GenericArgsSlice, idx: usize) -> *mut GenericArgsSlice {
    let off = ((idx as isize) * (size_of<GenericArgsSlice>() as isize)) as usize;
    ((base as usize) + off) as *mut GenericArgsSlice
}

unsafe fn tryinfo_at(base: *mut TryExprInfo, idx: usize) -> *mut TryExprInfo {
    let off = ((idx as isize) * (size_of<TryExprInfo>() as isize)) as usize;
    ((base as usize) + off) as *mut TryExprInfo
}

pub fn ax_type_reset(t: mut_view<AxType>, kind: u8) {
    t.kind = kind;
    t.is_unsafe = false;
    t.is_mut = false;
    t.is_repr_c = false;
    t.abi.v = 0u32;
    t.name.v = 0u32;
    t.param_index = 0u32;
    t.var_id = 0u32;
    t.closure_id = 0u32;
    t.fn_sym = 0u32;
    t.pointee.v = 0u32;
    t.elem.v = 0u32;
    t.ret_type.v = 0u32;
    t.fn_type.v = 0u32;
    t.array_len = 0u64;
    t.param_types = 0 as *mut TypeId;
    t.param_count = 0;
    t.fields = 0 as *mut TypeId;
    t.field_count = 0;
    t.def = 0 as *const HirItem;
    t.args = 0 as *mut TypeId;
    t.arg_count = 0;
    t.variant_fields = 0 as *mut *mut TypeId;
    t.variant_field_counts = 0 as *mut usize;
    t.variant_count = 0;
    t.captures = 0 as *mut ClosureCapture;
    t.capture_count = 0;
}

pub fn copy_ax_type_into(dst: mut_view<AxType>, src: view<AxType>) {
    dst.kind = src.kind;
    dst.is_unsafe = src.is_unsafe;
    dst.is_mut = src.is_mut;
    dst.is_repr_c = src.is_repr_c;
    dst.abi.v = src.abi.v;
    dst.name.v = src.name.v;
    dst.param_index = src.param_index;
    dst.var_id = src.var_id;
    dst.closure_id = src.closure_id;
    dst.fn_sym = src.fn_sym;
    dst.pointee.v = src.pointee.v;
    dst.elem.v = src.elem.v;
    dst.ret_type.v = src.ret_type.v;
    dst.fn_type.v = src.fn_type.v;
    dst.array_len = src.array_len;
    dst.param_types = src.param_types;
    dst.param_count = src.param_count;
    dst.fields = src.fields;
    dst.field_count = src.field_count;
    dst.def = src.def;
    dst.args = src.args;
    dst.arg_count = src.arg_count;
    dst.variant_fields = src.variant_fields;
    dst.variant_field_counts = src.variant_field_counts;
    dst.variant_count = src.variant_count;
    dst.captures = src.captures;
    dst.capture_count = src.capture_count;
}

pub fn copy_const_value_into(dst: mut_view<ConstValue>, src: view<ConstValue>) {
    dst.kind = src.kind;
    dst.ty.v = src.ty.v;
    dst.int_val = src.int_val;
    dst.str_bytes = src.str_bytes;
    dst.str_len = src.str_len;
    dst.agg_data = src.agg_data;
    dst.agg_size = src.agg_size;
    dst.agg_align = src.agg_align;
    dst.alloc_id = src.alloc_id;
}

pub fn key_hash_type(k: view<AxType>) -> u64 {
    let mut h: u64 = hash_u32(k.kind as u32);
    if k.kind == TY_FN {
        let u_flag: u32 = if k.is_unsafe { 1u32 } else { 0u32 };
        h = hash_combine(h, hash_u32(u_flag));
        h = hash_combine(h, hash_u32(k.abi.v));
        h = hash_combine(h, hash_u32(k.ret_type.v));
        h = hash_combine(h, hash_u64(k.param_count as u64));
        let mut i: usize = 0;
        while (i < k.param_count) {
            let pv = unsafe { (*typeid_at(k.param_types, i)).v };
            h = hash_combine(h, hash_u32(pv));
            i = i + 1;
        }
    } else if k.kind == TY_INT_VAR || k.kind == TY_VAR {
        h = hash_combine(h, hash_u32(k.var_id));
    } else if k.kind == TY_PARAM {
        h = hash_combine(h, hash_u32(k.param_index));
    } else if k.kind == TY_PTR {
        let m_flag: u32 = if k.is_mut { 1u32 } else { 0u32 };
        h = hash_combine(h, hash_u32(k.pointee.v));
        h = hash_combine(h, hash_u32(m_flag));
    } else if k.kind == TY_VIEW || k.kind == TY_MUT_VIEW {
        h = hash_combine(h, hash_u32(k.pointee.v));
    } else if k.kind == TY_SLICE {
        h = hash_combine(h, hash_u32(k.elem.v));
    } else if k.kind == TY_ARRAY {
        h = hash_combine(h, hash_u32(k.elem.v));
        h = hash_combine(h, hash_u64(k.array_len));
    } else if k.kind == TY_TUPLE {
        h = hash_combine(h, hash_u64(k.field_count as u64));
        let mut i: usize = 0;
        while (i < k.field_count) {
            let fv = unsafe { (*typeid_at(k.fields, i)).v };
            h = hash_combine(h, hash_u32(fv));
            i = i + 1;
        }
    } else if k.kind == TY_STRUCT || k.kind == TY_ENUM {
        h = hash_combine(h, hash_u64((k.def as usize) as u64));
        let mut i: usize = 0;
        while (i < k.arg_count) {
            let av = unsafe { (*typeid_at(k.args, i)).v };
            h = hash_combine(h, hash_u32(av));
            i = i + 1;
        }
    } else if k.kind == TY_CLOSURE {
        h = hash_combine(h, hash_u32(k.closure_id));
    }
    h
}

pub fn key_eq_type(a: view<AxType>, b: view<AxType>) -> bool {
    if a.kind != b.kind {
        return false;
    }
    if a.kind == TY_FN {
        if a.is_unsafe != b.is_unsafe || a.abi.v != b.abi.v {
            return false;
        }
        if a.ret_type.v != b.ret_type.v || a.param_count != b.param_count {
            return false;
        }
        let mut i: usize = 0;
        while (i < a.param_count) {
            let pa = unsafe { (*typeid_at(a.param_types, i)).v };
            let pb = unsafe { (*typeid_at(b.param_types, i)).v };
            if pa != pb {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    if a.kind == TY_INT_VAR || a.kind == TY_VAR {
        return a.var_id == b.var_id;
    }
    if a.kind == TY_PARAM {
        return a.param_index == b.param_index;
    }
    if a.kind == TY_PTR {
        return a.pointee.v == b.pointee.v && a.is_mut == b.is_mut;
    }
    if a.kind == TY_VIEW || a.kind == TY_MUT_VIEW {
        return a.pointee.v == b.pointee.v;
    }
    if a.kind == TY_SLICE {
        return a.elem.v == b.elem.v;
    }
    if a.kind == TY_ARRAY {
        return a.elem.v == b.elem.v && a.array_len == b.array_len;
    }
    if a.kind == TY_TUPLE {
        if a.field_count != b.field_count {
            return false;
        }
        let mut i: usize = 0;
        while (i < a.field_count) {
            let fa = unsafe { (*typeid_at(a.fields, i)).v };
            let fb = unsafe { (*typeid_at(b.fields, i)).v };
            if fa != fb {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    if a.kind == TY_STRUCT || a.kind == TY_ENUM {
        if (a.def as usize) != (b.def as usize) {
            return false;
        }
        if a.arg_count != b.arg_count {
            return false;
        }
        let mut i: usize = 0;
        while (i < a.arg_count) {
            let aa = unsafe { (*typeid_at(a.args, i)).v };
            let ab = unsafe { (*typeid_at(b.args, i)).v };
            if aa != ab {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    if a.kind == TY_CLOSURE {
        return a.closure_id == b.closure_id;
    }
    true
}

pub fn typemap_init(m: mut_view<TypeMap>) {
    m.keys = 0 as *mut *mut AxType;
    m.vals = 0 as *mut TypeId;
    m.states = 0 as *mut u8;
    m.len = 0;
    m.cap = 0;
}

pub fn typemap_free(m: mut_view<TypeMap>) {
    if m.cap > 0 {
        unsafe {
            heap_free(m.keys as *mut u8, mul_usize(m.cap, size_of<*mut AxType>()), align_of<*mut AxType>());
            heap_free(m.vals as *mut u8, mul_usize(m.cap, size_of<TypeId>()), align_of<TypeId>());
            heap_free(m.states, m.cap, 1);
        }
    }
    typemap_init(m);
}

fn typemap_grow(m: mut_view<TypeMap>) {
    let new_cap: usize = if m.cap == 0 { MAP_INIT_CAP } else { mul_usize(m.cap, 2) };
    let new_keys = unsafe {
        heap_alloc(mul_usize(new_cap, size_of<*mut AxType>()), align_of<*mut AxType>()) as *mut *mut AxType
    };
    let new_vals = unsafe {
        heap_alloc(mul_usize(new_cap, size_of<TypeId>()), align_of<TypeId>()) as *mut TypeId
    };
    let new_states = unsafe { heap_alloc(new_cap, 1) };
    types_zero_bytes(new_states, new_cap);

    let old_keys = m.keys;
    let old_vals = m.vals;
    let old_states = m.states;
    let old_cap = m.cap;

    m.keys = new_keys;
    m.vals = new_vals;
    m.states = new_states;
    m.len = 0;
    m.cap = new_cap;

    let mut i: usize = 0;
    while (i < old_cap) {
        let st = unsafe { *(old_states + i) };
        if st == SLOT_OCCUPIED {
            let k = unsafe { *axtype_ptr_at(old_keys, i) };
            let v = unsafe { (*typeid_at(old_vals, i)).v };
            typemap_insert(mut_view(*m), k, TypeId { v: v });
        }
        i = i + 1;
    }

    if old_cap > 0 {
        unsafe {
            heap_free(old_keys as *mut u8, mul_usize(old_cap, size_of<*mut AxType>()), align_of<*mut AxType>());
            heap_free(old_vals as *mut u8, mul_usize(old_cap, size_of<TypeId>()), align_of<TypeId>());
            heap_free(old_states, old_cap, 1);
        }
    }
}

pub fn typemap_insert(m: mut_view<TypeMap>, key: *mut AxType, val: TypeId) {
    if m.cap == 0 || mul_usize(m.len + 1, MAP_LOAD_DEN) >= mul_usize(m.cap, MAP_LOAD_NUM) {
        typemap_grow(mut_view(*m));
    }
    let mask = m.cap - 1;
    let h = unsafe { key_hash_type(view(*key)) };
    let mut idx = (h as usize) & mask;
    loop {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            unsafe {
                *axtype_ptr_at(m.keys, idx) = key;
                (*typeid_at(m.vals, idx)).v = val.v;
                *(m.states + idx) = SLOT_OCCUPIED;
            }
            m.len = m.len + 1;
            return;
        }
        let k = unsafe { *axtype_ptr_at(m.keys, idx) };
        let eq = unsafe { key_eq_type(view(*k), view(*key)) };
        if eq {
            unsafe {
                (*typeid_at(m.vals, idx)).v = val.v;
            }
            return;
        }
        idx = (idx + 1) & mask;
    }
}

pub fn typemap_get(m: view<TypeMap>, key: view<AxType>) -> *mut TypeId {
    if m.cap == 0 {
        return 0 as *mut TypeId;
    }
    let mask = m.cap - 1;
    let h = key_hash_type(key);
    let mut idx = (h as usize) & mask;
    let mut probes: usize = 0;
    while (probes < m.cap) {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            return 0 as *mut TypeId;
        }
        if st == SLOT_OCCUPIED {
            let k = unsafe { *axtype_ptr_at(m.keys, idx) };
            let eq = unsafe { key_eq_type(view(*k), key) };
            if eq {
                return unsafe { typeid_at(m.vals, idx) };
            }
        }
        idx = (idx + 1) & mask;
        probes = probes + 1;
    }
    0 as *mut TypeId
}

fn interner_push_ptr(ti: mut_view<TypeInterner>, ptr: *mut AxType) -> usize {
    if ti.len == ti.cap {
        let new_cap: usize = if ti.cap == 0 { INTERNER_INIT_CAP } else { mul_usize(ti.cap, 2) };
        let new_arr = unsafe {
            heap_alloc(mul_usize(new_cap, size_of<*mut AxType>()), align_of<*mut AxType>()) as *mut *mut AxType
        };
        if ti.len > 0 && (ti.types as usize) != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(
                    ti.types as *const u8,
                    new_arr as *mut u8,
                    mul_usize(ti.len, size_of<*mut AxType>())
                );
                heap_free(
                    ti.types as *mut u8,
                    mul_usize(ti.cap, size_of<*mut AxType>()),
                    align_of<*mut AxType>()
                );
            }
        }
        ti.types = new_arr;
        ti.cap = new_cap;
    }
    let idx = ti.len;
    unsafe {
        *axtype_ptr_at(ti.types, idx) = ptr;
    }
    ti.len = idx + 1;
    idx
}

fn arena_dup_typeids(arena: mut_view<Arena>, src: *mut TypeId, count: usize) -> *mut TypeId {
    if count == 0 || (src as usize) == 0 {
        return 0 as *mut TypeId;
    }
    let bytes = mul_usize(count, size_of<TypeId>());
    let dst = arena_alloc_raw(mut_view(*arena), bytes, align_of<TypeId>()) as *mut TypeId;
    unsafe {
        ptr_copy_nonoverlapping<u8>(src as *const u8, dst as *mut u8, bytes);
    }
    dst
}

pub fn intern_type(ti: mut_view<TypeInterner>, ty: view<AxType>) -> TypeId {
    let existing = typemap_get(view(ti.map), ty);
    if (existing as usize) != 0 {
        let ex_v = unsafe { (*existing).v };
        return TypeId { v: ex_v };
    }
    let new_type = unsafe {
        arena_alloc_raw(mut_view(ti.arena), size_of<AxType>(), align_of<AxType>()) as *mut AxType
    };
    unsafe {
        copy_ax_type_into(mut_view(*new_type), ty);
    }
    if ty.kind == TY_FN && ty.param_count > 0 {
        unsafe {
            let dup_arr = arena_dup_typeids(mut_view(ti.arena), ty.param_types, ty.param_count);
            (*new_type).param_types = dup_arr;
        }
    }
    if ty.kind == TY_TUPLE && ty.field_count > 0 {
        unsafe {
            let dup_arr = arena_dup_typeids(mut_view(ti.arena), ty.fields, ty.field_count);
            (*new_type).fields = dup_arr;
        }
    }
    if ty.kind == TY_STRUCT {
        if ty.field_count > 0 {
            unsafe {
                let dup_arr = arena_dup_typeids(mut_view(ti.arena), ty.fields, ty.field_count);
            (*new_type).fields = dup_arr;
            }
        }
        if ty.arg_count > 0 {
            unsafe {
                let dup_arr = arena_dup_typeids(mut_view(ti.arena), ty.args, ty.arg_count);
            (*new_type).args = dup_arr;
            }
        }
    }
    if ty.kind == TY_ENUM {
        if ty.arg_count > 0 {
            unsafe {
                let dup_arr = arena_dup_typeids(mut_view(ti.arena), ty.args, ty.arg_count);
            (*new_type).args = dup_arr;
            }
        }
        if (ty.variant_field_counts as usize) != 0 && ty.variant_count > 0 {
            let counts_bytes = mul_usize(ty.variant_count, size_of<usize>());
            let new_counts = unsafe {
                arena_alloc_raw(mut_view(ti.arena), counts_bytes, align_of<usize>()) as *mut usize
            };
            unsafe {
                ptr_copy_nonoverlapping<u8>(
                    ty.variant_field_counts as *const u8,
                    new_counts as *mut u8,
                    counts_bytes
                );
                (*new_type).variant_field_counts = new_counts;
            }
        }
        if (ty.variant_fields as usize) != 0 && ty.variant_count > 0 {
            let vbytes = mul_usize(ty.variant_count, size_of<*mut TypeId>());
            let new_vfields = unsafe {
                arena_alloc_raw(mut_view(ti.arena), vbytes, align_of<*mut TypeId>()) as *mut *mut TypeId
            };
            let mut v: usize = 0;
            while (v < ty.variant_count) {
                let fc = unsafe { *usize_at(ty.variant_field_counts, v) };
                if fc > 0 {
                    let src_vf = unsafe { *typeid_ptr_at(ty.variant_fields, v) };
                    let dst_vf = arena_dup_typeids(mut_view(ti.arena), src_vf, fc);
                    unsafe {
                        *typeid_ptr_at(new_vfields, v) = dst_vf;
                    }
                } else {
                    unsafe {
                        *typeid_ptr_at(new_vfields, v) = 0 as *mut TypeId;
                    }
                }
                v = v + 1;
            }
            unsafe {
                (*new_type).variant_fields = new_vfields;
            }
        }
    }
    if ty.kind == TY_CLOSURE {
        if ty.param_count > 0 {
            unsafe {
                let dup_arr = arena_dup_typeids(mut_view(ti.arena), ty.param_types, ty.param_count);
            (*new_type).param_types = dup_arr;
            }
        }
        if ty.capture_count > 0 && (ty.captures as usize) != 0 {
            let cbytes = mul_usize(ty.capture_count, size_of<ClosureCapture>());
            let new_caps = unsafe {
                arena_alloc_raw(
                    mut_view(ti.arena),
                    cbytes,
                    align_of<ClosureCapture>()
                ) as *mut ClosureCapture
            };
            unsafe {
                ptr_copy_nonoverlapping<u8>(ty.captures as *const u8, new_caps as *mut u8, cbytes);
                (*new_type).captures = new_caps;
            }
        }
    }
    let idx = interner_push_ptr(mut_view(*ti), new_type);
    let id_v = (idx + 1) as u32;
    typemap_insert(mut_view(ti.map), new_type, TypeId { v: id_v });
    TypeId { v: id_v }
}

pub fn intern_singleton(ti: mut_view<TypeInterner>, kind: u8) -> TypeId {
    let sp = ti.scratch;
    unsafe {
        ax_type_reset(mut_view(*sp), kind);
    }
    intern_type(mut_view(*ti), unsafe { view(*sp) })
}

pub fn intern_ptr_ty(ti: mut_view<TypeInterner>, pointee: TypeId, is_mut: bool) -> TypeId {
    let sp = ti.scratch;
    unsafe {
        ax_type_reset(mut_view(*sp), TY_PTR);
        (*sp).pointee.v = pointee.v;
        (*sp).is_mut = is_mut;
    }
    intern_type(mut_view(*ti), unsafe { view(*sp) })
}

pub fn intern_view_ty(ti: mut_view<TypeInterner>, pointee: TypeId, is_mut: bool) -> TypeId {
    let k: u8 = if is_mut { TY_MUT_VIEW } else { TY_VIEW };
    let sp = ti.scratch;
    unsafe {
        ax_type_reset(mut_view(*sp), k);
        (*sp).pointee.v = pointee.v;
    }
    intern_type(mut_view(*ti), unsafe { view(*sp) })
}

pub fn intern_slice_ty(ti: mut_view<TypeInterner>, elem: TypeId) -> TypeId {
    let sp = ti.scratch;
    unsafe {
        ax_type_reset(mut_view(*sp), TY_SLICE);
        (*sp).elem.v = elem.v;
    }
    intern_type(mut_view(*ti), unsafe { view(*sp) })
}

pub fn intern_array_ty(ti: mut_view<TypeInterner>, elem: TypeId, arr_len: u64) -> TypeId {
    let sp = ti.scratch;
    unsafe {
        ax_type_reset(mut_view(*sp), TY_ARRAY);
        (*sp).elem.v = elem.v;
        (*sp).array_len = arr_len;
    }
    intern_type(mut_view(*ti), unsafe { view(*sp) })
}

pub fn intern_tuple_ty(ti: mut_view<TypeInterner>, fields: *mut TypeId, count: usize) -> TypeId {
    let sp = ti.scratch;
    unsafe {
        ax_type_reset(mut_view(*sp), TY_TUPLE);
        (*sp).fields = fields;
        (*sp).field_count = count;
    }
    intern_type(mut_view(*ti), unsafe { view(*sp) })
}

pub fn intern_fn_ty(
    ti: mut_view<TypeInterner>,
    is_unsafe: bool,
    abi: StrId,
    param_types: *mut TypeId,
    param_count: usize,
    ret_type: TypeId
) -> TypeId {
    let sp = ti.scratch;
    unsafe {
        ax_type_reset(mut_view(*sp), TY_FN);
        (*sp).is_unsafe = is_unsafe;
        (*sp).abi.v = abi.v;
        (*sp).param_types = param_types;
        (*sp).param_count = param_count;
        (*sp).ret_type.v = ret_type.v;
    }
    intern_type(mut_view(*ti), unsafe { view(*sp) })
}

pub fn intern_param_ty(ti: mut_view<TypeInterner>, name: StrId, index: u32) -> TypeId {
    let sp = ti.scratch;
    unsafe {
        ax_type_reset(mut_view(*sp), TY_PARAM);
        (*sp).name.v = name.v;
        (*sp).param_index = index;
    }
    intern_type(mut_view(*ti), unsafe { view(*sp) })
}

pub fn intern_var_ty(ti: mut_view<TypeInterner>, kind: u8, var_id: u32) -> TypeId {
    let sp = ti.scratch;
    unsafe {
        ax_type_reset(mut_view(*sp), kind);
        (*sp).var_id = var_id;
    }
    intern_type(mut_view(*ti), unsafe { view(*sp) })
}

pub fn type_interner_init(ti: mut_view<TypeInterner>) {
    ti.arena.head = 0 as *mut ArenaChunk;
    typemap_init(mut_view(ti.map));
    ti.types = 0 as *mut *mut AxType;
    ti.len = 0;
    ti.cap = 0;
    ti.next_int_var = 1u32;
    ti.scratch = arena_alloc_raw(mut_view(ti.arena), size_of<AxType>(), align_of<AxType>()) as *mut AxType;

    ti.t_error.v = intern_singleton(mut_view(*ti), TY_ERROR).v;
    ti.t_unit.v = intern_singleton(mut_view(*ti), TY_UNIT).v;
    ti.t_never.v = intern_singleton(mut_view(*ti), TY_NEVER).v;
    ti.t_bool.v = intern_singleton(mut_view(*ti), TY_BOOL).v;
    ti.t_char.v = intern_singleton(mut_view(*ti), TY_CHAR).v;
    ti.t_i8.v = intern_singleton(mut_view(*ti), TY_I8).v;
    ti.t_i16.v = intern_singleton(mut_view(*ti), TY_I16).v;
    ti.t_i32.v = intern_singleton(mut_view(*ti), TY_I32).v;
    ti.t_i64.v = intern_singleton(mut_view(*ti), TY_I64).v;
    ti.t_isize.v = intern_singleton(mut_view(*ti), TY_ISIZE).v;
    ti.t_u8.v = intern_singleton(mut_view(*ti), TY_U8).v;
    ti.t_u16.v = intern_singleton(mut_view(*ti), TY_U16).v;
    ti.t_u32.v = intern_singleton(mut_view(*ti), TY_U32).v;
    ti.t_u64.v = intern_singleton(mut_view(*ti), TY_U64).v;
    ti.t_usize.v = intern_singleton(mut_view(*ti), TY_USIZE).v;
    ti.t_str.v = intern_singleton(mut_view(*ti), TY_STR).v;
}

pub fn type_interner_free(ti: mut_view<TypeInterner>) {
    if ti.cap > 0 && (ti.types as usize) != 0 {
        unsafe {
            heap_free(
                ti.types as *mut u8,
                mul_usize(ti.cap, size_of<*mut AxType>()),
                align_of<*mut AxType>()
            );
        }
    }
    ti.types = 0 as *mut *mut AxType;
    ti.len = 0;
    ti.cap = 0;
    typemap_free(mut_view(ti.map));
    arena_destroy(mut_view(ti.arena));
}

pub fn type_get(ti: view<TypeInterner>, id: TypeId) -> *mut AxType {
    if id.v == 0 {
        return unsafe { *axtype_ptr_at(ti.types, 0) };
    }
    let idx = (id.v - 1) as usize;
    if idx >= ti.len {
        return unsafe { *axtype_ptr_at(ti.types, 0) };
    }
    unsafe { *axtype_ptr_at(ti.types, idx) }
}

pub fn type_is_int(id: TypeId, ti: view<TypeInterner>) -> bool {
    let t = type_get(ti, id);
    let k = unsafe { (*t).kind };
    k >= TY_I8 && k <= TY_USIZE
}

pub fn type_is_signed(id: TypeId, ti: view<TypeInterner>) -> bool {
    let t = type_get(ti, id);
    let k = unsafe { (*t).kind };
    k >= TY_I8 && k <= TY_ISIZE
}

pub fn type_is_unsigned(id: TypeId, ti: view<TypeInterner>) -> bool {
    let t = type_get(ti, id);
    let k = unsafe { (*t).kind };
    k >= TY_U8 && k <= TY_USIZE
}

fn sv_is_derive(sv: view<StrView>) -> bool {
    if sv.len != 6 {
        return false;
    }
    unsafe {
        *(sv.ptr + 0) == 100u8 && *(sv.ptr + 1) == 101u8 && *(sv.ptr + 2) == 114u8 &&
            *(sv.ptr + 3) == 105u8 && *(sv.ptr + 4) == 118u8 && *(sv.ptr + 5) == 101u8
    }
}

fn sv_is_copy(sv: view<StrView>) -> bool {
    if sv.len != 4 {
        return false;
    }
    unsafe {
        *(sv.ptr + 0) == 67u8 && *(sv.ptr + 1) == 111u8 &&
            *(sv.ptr + 2) == 112u8 && *(sv.ptr + 3) == 121u8
    }
}

pub fn type_is_copy(id: TypeId, thir: view<Thir>, str_in: view<StrInterner>) -> bool {
    if id.v == 0 {
        return false;
    }
    let ty = type_get(view(thir.interner), id);
    if (ty as usize) == 0 {
        return false;
    }
    let k = unsafe { (*ty).kind };
    if k == TY_ERROR || k == TY_STR {
        return false;
    }
    if (k >= TY_UNIT && k <= TY_FN) || k == TY_PTR || k == TY_INT_VAR || k == TY_VIEW {
        return true;
    }
    if k == TY_ARRAY {
        let elem_v = unsafe { (*ty).elem.v };
        let elem_ty = TypeId { v: elem_v };
        return type_is_copy(elem_ty, thir, str_in);
    }
    if k == TY_TUPLE {
        let count = unsafe { (*ty).field_count };
        let fields = unsafe { (*ty).fields };
        let mut i: usize = 0;
        while (i < count) {
            let f_v = unsafe { (*typeid_at(fields, i)).v };
            let f_ty = TypeId { v: f_v };
            if !type_is_copy(f_ty, thir, str_in) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    if k == TY_CLOSURE {
        let count = unsafe { (*ty).capture_count };
        let caps = unsafe { (*ty).captures };
        let mut i: usize = 0;
        while (i < count) {
            let cap = unsafe { capture_at(caps, i) };
            let mode = unsafe { (*cap).mode };
            if mode == CAP_MUT_VIEW || mode == CAP_MOVE {
                return false;
            }
            let cty_v = unsafe { (*cap).ty.v };
            let cty = TypeId { v: cty_v };
            if !type_is_copy(cty, thir, str_in) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    if k == TY_STRUCT || k == TY_ENUM {
        let def = unsafe { (*ty).def };
        if (def as usize) == 0 {
            return false;
        }
        let mut attr: *mut HirAttr = unsafe { (*def).attrs };
        while ((attr as usize) != 0) {
            let aname_v = unsafe { (*attr).name.v };
            if aname_v != 0u32 {
                let sv = interner_get(str_in, StrId { v: aname_v });
                if sv_is_derive(view(sv)) {
                    let mut arg: *mut HirAttrArg = unsafe { (*attr).args };
                    while ((arg as usize) != 0) {
                        let mut arg_name_v = unsafe { (*arg).name.v };
                        if arg_name_v == 0u32 {
                            let aexpr: *mut HirExpr = unsafe { (*arg).expr };
                            if (aexpr as usize) != 0 {
                                let ek = unsafe { (*aexpr).kind };
                                if ek == HIR_EXPR_PATH {
                                    arg_name_v = unsafe { (*aexpr).path.name.v };
                                }
                            }
                        }
                        if arg_name_v != 0u32 {
                            let asv = interner_get(str_in, StrId { v: arg_name_v });
                            if sv_is_copy(view(asv)) {
                                return true;
                            }
                        }
                        arg = unsafe { (*arg).next };
                    }
                }
            }
            attr = unsafe { (*attr).next };
        }
        return false;
    }
    false
}

pub fn ptr_typemap_init(m: mut_view<PtrTypeMap>) {
    m.keys = 0 as *mut usize;
    m.vals = 0 as *mut TypeId;
    m.states = 0 as *mut u8;
    m.len = 0;
    m.cap = 0;
}

pub fn ptr_typemap_free(m: mut_view<PtrTypeMap>) {
    if m.cap > 0 {
        unsafe {
            heap_free(m.keys as *mut u8, mul_usize(m.cap, size_of<usize>()), align_of<usize>());
            heap_free(m.vals as *mut u8, mul_usize(m.cap, size_of<TypeId>()), align_of<TypeId>());
            heap_free(m.states, m.cap, 1);
        }
    }
    ptr_typemap_init(m);
}

fn ptr_typemap_grow(m: mut_view<PtrTypeMap>) {
    let new_cap: usize = if m.cap == 0 { MAP_INIT_CAP } else { mul_usize(m.cap, 2) };
    let new_keys = unsafe { heap_alloc(mul_usize(new_cap, size_of<usize>()), align_of<usize>()) as *mut usize };
    let new_vals = unsafe { heap_alloc(mul_usize(new_cap, size_of<TypeId>()), align_of<TypeId>()) as *mut TypeId };
    let new_states = unsafe { heap_alloc(new_cap, 1) };
    types_zero_bytes(new_states, new_cap);

    let old_keys = m.keys;
    let old_vals = m.vals;
    let old_states = m.states;
    let old_cap = m.cap;

    m.keys = new_keys;
    m.vals = new_vals;
    m.states = new_states;
    m.len = 0;
    m.cap = new_cap;

    let mut i: usize = 0;
    while (i < old_cap) {
        let st = unsafe { *(old_states + i) };
        if st == SLOT_OCCUPIED {
            let k = unsafe { *usize_at(old_keys, i) };
