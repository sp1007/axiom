@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
    fn ExitProcess(uExitCode: u32);
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if (h as usize) == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if (size < 16) { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if (p as usize) != 0 {
        let h = GetProcessHeap();
        if (h as usize) != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

pub unsafe fn __ax_host_exit(code: i32) {
    ExitProcess(code as u32);
}

use std.core.host.heap_alloc
use std.core.host.heap_free
use std.core.host.exit

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn wrapping_add_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

struct ArenaChunk {
    next: *mut ArenaChunk,
    cap: usize,
    used: usize,
}

pub struct Arena {
    head: *mut ArenaChunk,
}

pub fn arena_new() -> Arena {
    Arena { head: 0 as *mut ArenaChunk }
}

pub fn arena_alloc_raw(a: mut_view<Arena>, size: usize, align: usize) -> *mut u8 {
    if size == 0 { return 0 as *mut u8; }
    let effective_align: usize = if (align < 8) { 8 } else { align };
    let mut cur = a.head;
    if (cur as usize) != 0 {
        let raw = unsafe { (*cur).used };
        let mask = effective_align - 1;
        let offset = (raw + mask) & (0xFFFFFFFFFFFFFFFFusize ^ mask);
        let cap = unsafe { (*cur).cap };
        if offset + size <= cap {
            unsafe { (*cur).used = offset + size; }
            let data_ptr = unsafe { (cur as *mut u8) + 32 };
            return unsafe { data_ptr + offset };
        }
    }
    let default_chunk: usize = 4096;
    let header_size: usize = 32;
    let chunk_cap = if size > default_chunk { size + effective_align } else { default_chunk };
    let total_alloc = header_size + chunk_cap;
    let raw_mem = unsafe { heap_alloc(total_alloc, 16) };
    if (raw_mem as usize) == 0 { return 0 as *mut u8; }
    let p = raw_mem as *mut ArenaChunk;
    unsafe {
        (*p).next = a.head;
        (*p).cap = chunk_cap;
        (*p).used = size;
    }
    a.head = p;
    unsafe { raw_mem + header_size }
}

pub fn arena_destroy(a: mut_view<Arena>) {
    let mut cur = a.head;
    while (cur as usize) != 0 {
        let next = unsafe { (*cur).next };
        let total_alloc = 32 + unsafe { (*cur).cap };
        unsafe { heap_free(cur as *mut u8, total_alloc, 16); }
        cur = next;
    }
    a.head = 0 as *mut ArenaChunk;
}



@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }


pub struct StrId {
    pub v: u32,
}

impl StrId {
    pub fn none() -> StrId { StrId { v: 0 } }
    pub fn is_none(self: view<StrId>) -> bool { self.v == 0 }
    pub fn is_some(self: view<StrId>) -> bool { self.v != 0 }
    pub fn from_index(index: usize) -> StrId { StrId { v: (index + 1) as u32 } }
    pub fn index(self: view<StrId>) -> usize { (self.v - 1) as usize }
    pub fn eq(self: view<StrId>, other: view<StrId>) -> bool { self.v == other.v }
    pub fn to_raw(self: view<StrId>) -> u32 { self.v }
    pub fn from_raw(v: u32) -> StrId { StrId { v: v } }
}

