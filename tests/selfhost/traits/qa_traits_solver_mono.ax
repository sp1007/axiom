        (*fn_base_def).symbol.v = 101u32;
        (*fn_base_def).body = dummy_block;
        (*fn_req).name.v = s_req;
        (*fn_req).symbol.v = 102u32;
        (*fn_req).body = 0 as *mut HirBlock;
        (*fn_base_def).next = fn_req;
        (*tr_base).members = fn_base_def;
    }

    // trait SubTrait: BaseTrait { type Meta = u64; fn sub_default() { ... } }
    let tr_sub = hir_alloc_item(mut_view(*arena), HIR_ITEM_TRAIT, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    let st_base_ref = make_path_hir_type(mut_view(*arena), s_base_tr, sym_base_tr, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    let fn_sub_def = hir_alloc_item(mut_view(*arena), HIR_ITEM_FN, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    let ta_meta = hir_alloc_item(mut_view(*arena), HIR_ITEM_TYPE_ALIAS, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    let ty_u64_hir = make_path_hir_type(mut_view(*arena), s_u64, 0u32, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    unsafe {
        (*tr_sub).name.v = s_sub_tr;
        (*tr_sub).symbol.v = sym_sub_tr;
        (*tr_sub).supertraits = st_base_ref;
        (*fn_sub_def).name.v = s_sub_def;
        (*fn_sub_def).symbol.v = 103u32;
        (*fn_sub_def).body = dummy_block;
        (*ta_meta).name.v = s_meta;
        (*ta_meta).ty = ty_u64_hir;
        (*fn_sub_def).next = ta_meta;
        (*tr_sub).members = fn_sub_def;
    }

    // struct Point (with @derive(Copy)) and struct Rect (without Copy)
    let it_point = hir_alloc_item(mut_view(*arena), HIR_ITEM_STRUCT, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    let attr_derive = hir_alloc_attr(mut_view(*arena), (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    let attr_arg_copy = hir_alloc_attr_arg(mut_view(*arena), (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    unsafe {
        (*attr_arg_copy).name.v = s_copy;
        (*attr_derive).name.v = s_derive;
        (*attr_derive).args = attr_arg_copy;
        (*it_point).name.v = s_point;
        (*it_point).symbol.v = sym_point;
        (*it_point).attrs = attr_derive;
    }

    let it_rect = hir_alloc_item(mut_view(*arena), HIR_ITEM_STRUCT, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    unsafe {
        (*it_rect).name.v = s_rect;
        (*it_rect).symbol.v = sym_rect;
    }

    // Intern Point and Rect in TypeInterner
    let p_fields = arena_alloc_raw(
        mut_view(*arena),
        ((( 2 as isize) * (size_of<TypeId>() as isize)) as usize),
        align_of<TypeId>()
    ) as *mut TypeId;
    let t_i32_v = thir.interner.t_i32.v;
    let t_u64_v = thir.interner.t_u64.v;
    unsafe {
        (*typeid_at(p_fields, 0)).v = t_i32_v;
        (*typeid_at(p_fields, 1)).v = t_i32_v;
        ax_type_reset(mut_view(*thir.interner.scratch), TY_STRUCT);
        (*thir.interner.scratch).def = it_point;
        (*thir.interner.scratch).fields = p_fields;
        (*thir.interner.scratch).field_count = 2;
    }
    let sp_pt = thir.interner.scratch;
    let ty_point_v = intern_type(mut_view(thir.interner), unsafe { view(*sp_pt) }).v;

    unsafe {
        ax_type_reset(mut_view(*thir.interner.scratch), TY_STRUCT);
        (*thir.interner.scratch).def = it_rect;
        (*thir.interner.scratch).fields = p_fields;
        (*thir.interner.scratch).field_count = 2;
    }
    let sp_rc = thir.interner.scratch;
    let ty_rect_v = intern_type(mut_view(thir.interner), unsafe { view(*sp_rc) }).v;

    // impl Point { fn norm() }
    let impl_point = hir_alloc_item(mut_view(*arena), HIR_ITEM_IMPL, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    let fn_norm = hir_alloc_item(mut_view(*arena), HIR_ITEM_FN, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    unsafe {
        let tmp_pht = make_path_hir_type(mut_view(*arena), s_point, sym_point, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
        (*impl_point).self_type = tmp_pht;
        (*fn_norm).name.v = s_norm;
        (*fn_norm).symbol.v = 110u32;
        (*fn_norm).body = dummy_block;
        (*impl_point).members = fn_norm;
    }
    thir_set_item_type(mut_view(*thir), impl_point, tid(ty_point_v));

    // impl Printable for Point { fn fmt() }
    let impl_printable_pt = hir_alloc_item(mut_view(*arena), HIR_ITEM_IMPL, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    let fn_fmt_pt = hir_alloc_item(mut_view(*arena), HIR_ITEM_FN, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    unsafe {
        let tmp_pht = make_path_hir_type(
            mut_view(*arena),
            s_printable,
            sym_printable,
            (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 })
        );
        (*impl_printable_pt).trait_path = tmp_pht;
        let tmp_pht = make_path_hir_type(mut_view(*arena), s_point, sym_point, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
        (*impl_printable_pt).self_type = tmp_pht;
        (*fn_fmt_pt).name.v = s_fmt;
        (*fn_fmt_pt).symbol.v = 111u32;
        (*fn_fmt_pt).body = dummy_block;
        (*impl_printable_pt).members = fn_fmt_pt;
    }
    thir_set_item_type(mut_view(*thir), impl_printable_pt, tid(ty_point_v));

    // impl BaseTrait for Point {} (uses base_default)
    let impl_base_pt = hir_alloc_item(mut_view(*arena), HIR_ITEM_IMPL, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    unsafe {
        let tmp_pht = make_path_hir_type(mut_view(*arena), s_base_tr, sym_base_tr, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
        (*impl_base_pt).trait_path = tmp_pht;
        let tmp_pht = make_path_hir_type(mut_view(*arena), s_point, sym_point, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
        (*impl_base_pt).self_type = tmp_pht;
    }
    thir_set_item_type(mut_view(*thir), impl_base_pt, tid(ty_point_v));

    // impl SubTrait for Point { type Output = i32; } (uses sub_default and base_default)
    let impl_sub_pt = hir_alloc_item(mut_view(*arena), HIR_ITEM_IMPL, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    let ta_output = hir_alloc_item(mut_view(*arena), HIR_ITEM_TYPE_ALIAS, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    let ty_i32_hir = make_path_hir_type(mut_view(*arena), s_i32, 0u32, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    unsafe {
        let tmp_pht = make_path_hir_type(mut_view(*arena), s_sub_tr, sym_sub_tr, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
        (*impl_sub_pt).trait_path = tmp_pht;
        let tmp_pht = make_path_hir_type(mut_view(*arena), s_point, sym_point, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
        (*impl_sub_pt).self_type = tmp_pht;
        (*ta_output).name.v = s_output;
        (*ta_output).ty = ty_i32_hir;
        (*impl_sub_pt).members = ta_output;
    }
    thir_set_item_type(mut_view(*thir), impl_sub_pt, tid(ty_point_v));

    // impl Printable for Rect { fn fmt() }
    let impl_printable_rc = hir_alloc_item(mut_view(*arena), HIR_ITEM_IMPL, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    let fn_fmt_rc = hir_alloc_item(mut_view(*arena), HIR_ITEM_FN, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    unsafe {
        let tmp_pht = make_path_hir_type(
            mut_view(*arena),
            s_printable,
            sym_printable,
            (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 })
        );
        (*impl_printable_rc).trait_path = tmp_pht;
        let tmp_pht = make_path_hir_type(mut_view(*arena), s_rect, sym_rect, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
        (*impl_printable_rc).self_type = tmp_pht;
        (*fn_fmt_rc).name.v = s_fmt;
        (*fn_fmt_rc).symbol.v = 112u32;
        (*fn_fmt_rc).body = dummy_block;
        (*impl_printable_rc).members = fn_fmt_rc;
    }
    thir_set_item_type(mut_view(*thir), impl_printable_rc, tid(ty_rect_v));

    // Link items into HirFile
    unsafe {
        (*tr_printable).next = tr_base;
        (*tr_base).next = tr_sub;
        (*tr_sub).next = it_point;
        (*it_point).next = it_rect;
        (*it_rect).next = impl_point;
        (*impl_point).next = impl_printable_pt;
        (*impl_printable_pt).next = impl_base_pt;
        (*impl_base_pt).next = impl_sub_pt;
        (*impl_sub_pt).next = impl_printable_rc;
        (*impl_printable_rc).next = 0 as *mut HirItem;
    }
    let hir = HirFile { items: tr_printable };

    // 1. Coherence check on non-overlapping impls -> 0 errors
    traits_check_overlap(view(hir), mut_view(*sink));
    let errs0: usize = sink.errors;
    assert_true(errs0 == 0, 1);

    // Add overlapping impl Printable for Point and verify AX_TRAIT_OVERLAP (82)
    let impl_dup = hir_alloc_item(mut_view(*arena), HIR_ITEM_IMPL, (Span { file: FileId { v: 1u32 }, start: 50u32, end: 60u32 }));
    unsafe {
        let tmp_pht = make_path_hir_type(
            mut_view(*arena),
            s_printable,
            sym_printable,
            (Span { file: FileId { v: 1u32 }, start: 50u32, end: 60u32 })
        );
        (*impl_dup).trait_path = tmp_pht;
        let tmp_pht = make_path_hir_type(mut_view(*arena), s_point, sym_point, (Span { file: FileId { v: 1u32 }, start: 50u32, end: 60u32 }));
        (*impl_dup).self_type = tmp_pht;
        (*impl_printable_rc).next = impl_dup;
    }
    traits_check_overlap(view(hir), mut_view(*sink));
    let errs1: usize = sink.errors;
    assert_true(errs1 == 1, 2);
    let d0_code = unsafe { (*(diag_ptr(sink.diags, 0))).code.v };
    assert_true(d0_code == AX_TRAIT_OVERLAP, 3);
    // Unlink impl_dup for remaining tests
    unsafe {
        (*impl_printable_rc).next = 0 as *mut HirItem;
    }

    // 2. Default method lookup (direct + supertrait)
    let sv_sub_def = interner_get(view(*str_in), mk_sid(s_sub_def));
    let sv_base_def = interner_get(view(*str_in), mk_sid(s_base_def));
    let sv_req = interner_get(view(*str_in), mk_sid(s_req));
    let got_sub_def = find_trait_default_method(
        view(hir),
        tr_sub,
        view(sv_sub_def),
        view(*str_in),
        view(*db)
    );
    assert_true((got_sub_def as usize) == (fn_sub_def as usize), 4);
    let got_base_def = find_trait_default_method(
        view(hir),
        tr_sub,
        view(sv_base_def),
        view(*str_in),
        view(*db)
    );
    assert_true((got_base_def as usize) == (fn_base_def as usize), 5);
    let got_req = find_trait_default_method(view(hir), tr_sub, view(sv_req), view(*str_in), view(*db));
    assert_true((got_req as usize) == 0, 6);

    // 3. Static method dispatch (inherent, trait impl, default trait method, view/mut_view receiver)
    let mut res_status: u8 = 99u8;
    let sv_norm = interner_get(view(*str_in), mk_sid(s_norm));
    let sv_fmt = interner_get(view(*str_in), mk_sid(s_fmt));
    let sv_missing = interner_get(view(*str_in), mk_sid(s_missing));

    let m_norm = find_method(
        view(hir),
        view(*thir),
        tid(ty_point_v),
        view(sv_norm),
        view(*str_in),
        view(*db),
        mut_view(res_status)
    );
    assert_true(res_status == TRAIT_PROVEN, 7);
    assert_true((m_norm as usize) == (fn_norm as usize), 8);

    let ty_view_point_v = intern_view_ty(mut_view(thir.interner), tid(ty_point_v), false).v;
    let m_fmt = find_method(
        view(hir),
        view(*thir),
        tid(ty_view_point_v),
        view(sv_fmt),
        view(*str_in),
        view(*db),
        mut_view(res_status)
    );
    assert_true(res_status == TRAIT_PROVEN, 9);
    assert_true((m_fmt as usize) == (fn_fmt_pt as usize), 10);

    let m_inh_def = find_method(
        view(hir),
        view(*thir),
        tid(ty_point_v),
        view(sv_base_def),
        view(*str_in),
        view(*db),
        mut_view(res_status)
    );
    assert_true(res_status == TRAIT_AMBIGUOUS, 11);
    assert_true((m_inh_def as usize) == 0, 12);

    let m_sub_only = find_method(
        view(hir),
        view(*thir),
        tid(ty_point_v),
        view(sv_sub_def),
        view(*str_in),
        view(*db),
        mut_view(res_status)
    );
    assert_true(res_status == TRAIT_PROVEN, 13);
    assert_true((m_sub_only as usize) == (fn_sub_def as usize), 14);

    let m_miss = find_method(
        view(hir),
        view(*thir),
        tid(ty_point_v),
        view(sv_missing),
        view(*str_in),
        view(*db),
        mut_view(res_status)
    );
    assert_true(res_status == TRAIT_DISPROVEN, 15);
    assert_true((m_miss as usize) == 0, 16);

    // Type parameter method lookup from trait
    let ty_param_t_v = intern_param_ty(mut_view(thir.interner), mk_sid(s_t), 0u32).v;
    let m_param_fmt = find_method(
        view(hir),
        view(*thir),
        tid(ty_param_t_v),
        view(sv_fmt),
        view(*str_in),
        view(*db),
        mut_view(res_status)
    );
    assert_true(res_status == TRAIT_PROVEN, 17);
    assert_true((m_param_fmt as usize) == (tr_fmt_fn as usize), 18);

    // 4. Associated type lookup (impl override + trait default fallback)
    let sv_output = interner_get(view(*str_in), mk_sid(s_output));
    let sv_meta = interner_get(view(*str_in), mk_sid(s_meta));
    let assoc_out = resolve_assoc_type(
        view(hir),
        view(*thir),
        tid(ty_point_v),
        view(sv_output),
        view(*str_in),
        view(*db)
    );
    assert_true((assoc_out as usize) == (ty_i32_hir as usize), 19);
    let assoc_meta = resolve_assoc_type(
        view(hir),
        view(*thir),
        tid(ty_point_v),
        view(sv_meta),
        view(*str_in),
        view(*db)
    );
    assert_true((assoc_meta as usize) == (ty_u64_hir as usize), 20);

    // 5. Trait bound & callable bound checking
    let bound_printable = make_path_hir_type(mut_view(*arena), s_printable, sym_printable, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    let bound_sub = make_path_hir_type(mut_view(*arena), s_sub_tr, sym_sub_tr, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    let bound_unimpl = make_path_hir_type(mut_view(*arena), s_unimpl_tr, sym_unimpl_tr, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    let bound_copy = make_path_hir_type(mut_view(*arena), s_copy, 0u32, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    let bound_fn = make_path_hir_type(mut_view(*arena), s_fn, 0u32, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    let bound_fn_mut = make_path_hir_type(mut_view(*arena), s_fn_mut, 0u32, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    let bound_fn_once = make_path_hir_type(mut_view(*arena), s_fn_once, 0u32, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));

    assert_true(
        satisfies_bound(view(hir), view(*thir), tid(ty_point_v), bound_printable, view(*str_in), view(*db)),
        21
    );
    assert_true(
        satisfies_bound(view(hir), view(*thir), tid(ty_point_v), bound_sub, view(*str_in), view(*db)),
        22
    );
    assert_true(
        !satisfies_bound(view(hir), view(*thir), tid(ty_point_v), bound_unimpl, view(*str_in), view(*db)),
        23
    );
    assert_true(
        !satisfies_bound(view(hir), view(*thir), tid(ty_rect_v), bound_sub, view(*str_in), view(*db)),
        24
    );
    assert_true(
        satisfies_bound(view(hir), view(*thir), tid(ty_point_v), bound_copy, view(*str_in), view(*db)),
        25
    );
    assert_true(
        !satisfies_bound(view(hir), view(*thir), tid(ty_rect_v), bound_copy, view(*str_in), view(*db)),
        26
    );

    // Closure capture mode bounds: CAP_VIEW vs CAP_MUT_VIEW vs CAP_MOVE
    let cap_mut = arena_alloc_raw(
        mut_view(*arena),
        size_of<ClosureCapture>(),
        align_of<ClosureCapture>()
    ) as *mut ClosureCapture;
    unsafe {
        (*cap_mut).sym.v = 1u32;
        (*cap_mut).mode = CAP_MUT_VIEW;
        (*cap_mut).ty.v = ty_param_t_v;
        ax_type_reset(mut_view(*thir.interner.scratch), TY_CLOSURE);
        (*thir.interner.scratch).closure_id = 500u32;
        (*thir.interner.scratch).captures = cap_mut;
        (*thir.interner.scratch).capture_count = 1;
        (*thir.interner.scratch).ret_type.v = ty_param_t_v;
    }
    let sp_cl = thir.interner.scratch;
    let ty_clos_mut_v = intern_type(mut_view(thir.interner), unsafe { view(*sp_cl) }).v;
    assert_true(
        !satisfies_bound(view(hir), view(*thir), tid(ty_clos_mut_v), bound_fn, view(*str_in), view(*db)),
        27
    );
    assert_true(
        satisfies_bound(view(hir), view(*thir), tid(ty_clos_mut_v), bound_fn_mut, view(*str_in), view(*db)),
        28
    );
    assert_true(
        satisfies_bound(view(hir), view(*thir), tid(ty_clos_mut_v), bound_fn_once, view(*str_in), view(*db)),
        29
    );

    // Check generic item bounds & where clauses
    let fn_constrained = hir_alloc_item(mut_view(*arena), HIR_ITEM_FN, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    let gps = hir_alloc_generic_params(mut_view(*arena), (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    let gp_t = hir_alloc_generic_param(mut_view(*arena), (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    let wc = hir_alloc_where_clause(mut_view(*arena), (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    let wp = hir_alloc_where_pred(mut_view(*arena), (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    unsafe {
        (*gp_t).name.v = s_t;
        (*gp_t).bounds = bound_printable;
        (*gps).params = gp_t;
        let tmp_pht = make_path_hir_type(mut_view(*arena), s_t, 0u32, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
        (*wp).ty = tmp_pht;
        (*wp).bounds = bound_sub;
        (*wc).preds = wp;
        (*fn_constrained).generic_params = gps;
        (*fn_constrained).where_clause = wc;
    }
    let arg_pt_slice = GenericArgsSlice {
        args: arena_alloc_raw(mut_view(*arena), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId,
        count: 1,
    };
    unsafe {
        (*typeid_at(arg_pt_slice.args, 0)).v = ty_point_v;
    }
    let ok_pt = check_item_bounds(
        view(hir),
        view(*thir),
        fn_constrained,
        view(arg_pt_slice),
        (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }),
        view(*str_in),
        view(*db),
        mut_view(*sink)
    );
    assert_true(ok_pt, 30);

    unsafe {
        (*typeid_at(arg_pt_slice.args, 0)).v = ty_rect_v;
    }
    let prev_errs: usize = sink.errors;
    let ok_rc = check_item_bounds(
        view(hir),
        view(*thir),
        fn_constrained,
        view(arg_pt_slice),
        (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }),
        view(*str_in),
        view(*db),
        mut_view(*sink)
    );
    assert_true(!ok_rc, 31);
    let errs2: usize = sink.errors;
    assert_true(errs2 == prev_errs + 1, 32);

    // Check supertrait satisfaction across all impls in HIR
    let super_ok = check_impl_supertraits(view(hir), view(*thir), view(*str_in), view(*db), mut_view(*sink));
    assert_true(super_ok, 33);

    // 6. Generic type substitution (subst_ty) & argument deduction (deduce_args)
    let ty_param_u_v = intern_param_ty(mut_view(thir.interner), mk_sid(s_u), 1u32).v;
    let sub_args_buf = arena_alloc_raw(
        mut_view(*arena),
        ((( 2 as isize) * (size_of<TypeId>() as isize)) as usize),
        align_of<TypeId>()
    ) as *mut TypeId;
    unsafe {
        (*typeid_at(sub_args_buf, 0)).v = t_i32_v;
        (*typeid_at(sub_args_buf, 1)).v = t_u64_v;
    }
    let sub_slice = GenericArgsSlice { args: sub_args_buf, count: 2 };

    // Substitute into array, slice, view, mut_view, ptr, tuple, fn, struct, enum, closure
    let gen_arr_v = intern_array_ty(mut_view(thir.interner), tid(ty_param_t_v), 4u64).v;
    let sub_arr_v = subst_ty(mut_view(thir.interner), tid(gen_arr_v), view(sub_slice)).v;
    let exp_arr_v = intern_array_ty(mut_view(thir.interner), tid(t_i32_v), 4u64).v;
    assert_true(sub_arr_v == exp_arr_v, 40);

    let gen_view_v = intern_view_ty(mut_view(thir.interner), tid(ty_param_t_v), false).v;
    let sub_view_v = subst_ty(mut_view(thir.interner), tid(gen_view_v), view(sub_slice)).v;
    let exp_view_v = intern_view_ty(mut_view(thir.interner), tid(t_i32_v), false).v;
    assert_true(sub_view_v == exp_view_v, 41);

    let tup_elems = arena_alloc_raw(
        mut_view(*arena),
        ((( 2 as isize) * (size_of<TypeId>() as isize)) as usize),
        align_of<TypeId>()
    ) as *mut TypeId;
    unsafe {
        (*typeid_at(tup_elems, 0)).v = gen_view_v;
        (*typeid_at(tup_elems, 1)).v = intern_array_ty(mut_view(thir.interner), tid(ty_param_u_v), 4u64).v;
    }
    let gen_tup_v = intern_tuple_ty(mut_view(thir.interner), tup_elems, 2).v;
    let sub_tup_v = subst_ty(mut_view(thir.interner), tid(gen_tup_v), view(sub_slice)).v;
    let sub_tup_ptr = type_get(view(thir.interner), tid(sub_tup_v));
    assert_true(unsafe { (*typeid_at((*sub_tup_ptr).fields, 0)).v } == exp_view_v, 42);

    // Closure substitution
    let sub_clos_v = subst_ty(mut_view(thir.interner), tid(ty_clos_mut_v), view(sub_slice)).v;
    assert_true(sub_clos_v != ty_clos_mut_v, 43);
    let sub_clos_ptr = type_get(view(thir.interner), tid(sub_clos_v));
    let sub_cap0_ty = unsafe { (*capture_at((*sub_clos_ptr).captures, 0)).ty.v };
    assert_true(sub_cap0_ty == t_i32_v, 44);
    assert_true(unsafe { (*sub_clos_ptr).ret_type.v } == t_i32_v, 45);

    // Deduce args from (view<T>, [4]U) against (i32, [4]u64) (auto-view + array elem deduction)
    let spec_tup_elems = arena_alloc_raw(
        mut_view(*arena),
        ((( 2 as isize) * (size_of<TypeId>() as isize)) as usize),
        align_of<TypeId>()
    ) as *mut TypeId;
    unsafe {
        (*typeid_at(spec_tup_elems, 0)).v = t_i32_v;
        (*typeid_at(spec_tup_elems, 1)).v = intern_array_ty(mut_view(thir.interner), tid(t_u64_v), 4u64).v;
    }
    let spec_tup_v = intern_tuple_ty(mut_view(thir.interner), spec_tup_elems, 2).v;
    let deduced = arena_alloc_raw(
        mut_view(*arena),
        ((( 2 as isize) * (size_of<TypeId>() as isize)) as usize),
        align_of<TypeId>()
    ) as *mut TypeId;
    unsafe {
        (*typeid_at(deduced, 0)).v = 0u32;
        (*typeid_at(deduced, 1)).v = 0u32;
    }
    deduce_args(tid(gen_tup_v), tid(spec_tup_v), view(thir.interner), deduced, 2);
    assert_true(unsafe { (*typeid_at(deduced, 0)).v } == t_i32_v, 46);
    assert_true(unsafe { (*typeid_at(deduced, 1)).v } == t_u64_v, 47);

    let deduced_slice = GenericArgsSlice { args: deduced, count: 2 };
    assert_true(mono_has_concrete_args(view(deduced_slice), view(thir.interner)), 48);

    // 7. Mangling & Monomorphization Cache / Worklist
    let mut eng = MonoEngine {
        arena: 0 as *mut Arena,
        instances_head: 0 as *mut MonoInstance,
        instances_tail: 0 as *mut MonoInstance,
        instance_count: 0,
        work_head: 0 as *mut MonoInstance,
        work_tail: 0 as *mut MonoInstance,
        next_counter: 0u32,
        next_sym_id: 0u32,
    };
    mono_engine_init(mut_view(eng), mono_arena_ptr);

    let fn_id_item = hir_alloc_item(mut_view(*arena), HIR_ITEM_FN, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    unsafe {
        (*fn_id_item).name.v = s_id;
        (*fn_id_item).symbol.v = 300u32;
        (*fn_id_item).generic_params = gps;
        (*fn_id_item).body = dummy_block;
    }

    let args_i32 = GenericArgsSlice { args: sub_args_buf, count: 1 };
    let inst1 = mono_find_or_create_inst(mut_view(eng), mut_view(*str_in), fn_id_item, view(args_i32));
    assert_true((inst1 as usize) != 0, 50);
    let ic1: usize = eng.instance_count;
    assert_true(ic1 == 1, 51);
    let inst1_repeat = mono_find_or_create_inst(mut_view(eng), mut_view(*str_in), fn_id_item, view(args_i32));
    assert_true((inst1_repeat as usize) == (inst1 as usize), 52);
    let ic2: usize = eng.instance_count;
    assert_true(ic2 == 1, 53);

    let args_u64_buf = arena_alloc_raw(mut_view(*arena), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
    unsafe {
        (*typeid_at(args_u64_buf, 0)).v = t_u64_v;
    }
    let args_u64 = GenericArgsSlice { args: args_u64_buf, count: 1 };
    let inst2 = mono_find_or_create_inst(mut_view(eng), mut_view(*str_in), fn_id_item, view(args_u64));
    assert_true((inst2 as usize) != (inst1 as usize), 54);
    let ic3: usize = eng.instance_count;
    assert_true(ic3 == 2, 55);
    let s_id_i1e = {
        let p = arena_alloc_raw(mut_view(str_in.bytes), 7, 1);
        unsafe { *(p + 0) = 105u8; }
        unsafe { *(p + 1) = 100u8; }
        unsafe { *(p + 2) = 95u8; }
        unsafe { *(p + 3) = 73u8; }
        unsafe { *(p + 4) = 49u8; }
        unsafe { *(p + 5) = 69u8; }
        unsafe { *(p + 6) = 0u8; }
        interner_intern_bytes(mut_view(*str_in), p as *const u8, 6).v
    };
    let s_id_i2e = {
        let p = arena_alloc_raw(mut_view(str_in.bytes), 7, 1);
        unsafe { *(p + 0) = 105u8; }
        unsafe { *(p + 1) = 100u8; }
        unsafe { *(p + 2) = 95u8; }
        unsafe { *(p + 3) = 73u8; }
        unsafe { *(p + 4) = 50u8; }
        unsafe { *(p + 5) = 69u8; }
        unsafe { *(p + 6) = 0u8; }
        interner_intern_bytes(mut_view(*str_in), p as *const u8, 6).v
    };
    assert_true(unsafe { (*inst1).mangled_name.v } == s_id_i1e, 56);
    assert_true(unsafe { (*inst2).mangled_name.v } == s_id_i2e, 57);

    let pop1 = mono_pop_worklist(mut_view(eng));
    let pop2 = mono_pop_worklist(mut_view(eng));
    let pop3 = mono_pop_worklist(mut_view(eng));
    assert_true((pop1 as usize) == (inst1 as usize), 58);
    assert_true((pop2 as usize) == (inst2 as usize), 59);
    assert_true((pop3 as usize) == 0, 60);
    assert_true(mono_worklist_is_empty(view(eng)), 61);

    // Colliding non-generic method name deduplication
    let fn_new1 = hir_alloc_item(mut_view(*arena), HIR_ITEM_FN, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    let fn_new2 = hir_alloc_item(mut_view(*arena), HIR_ITEM_FN, (Span { file: FileId { v: 1u32 }, start: 10u32, end: 20u32 }));
    unsafe {
        (*fn_new1).name.v = s_new;
        (*fn_new1).symbol.v = 201u32;
        (*fn_new2).name.v = s_new;
        (*fn_new2).symbol.v = 202u32;
    }
    let empty_args = GenericArgsSlice { args: 0 as *mut TypeId, count: 0 };
    let in_new1 = mono_find_or_create_inst(mut_view(eng), mut_view(*str_in), fn_new1, view(empty_args));
    let in_new2 = mono_find_or_create_inst(mut_view(eng), mut_view(*str_in), fn_new2, view(empty_args));
    mono_dedup_instance_names(mut_view(eng), mut_view(*str_in));
    let s_new_202 = {
        let p = arena_alloc_raw(mut_view(str_in.bytes), 8, 1);
        unsafe { *(p + 0) = 110u8; }
        unsafe { *(p + 1) = 101u8; }
        unsafe { *(p + 2) = 119u8; }
        unsafe { *(p + 3) = 95u8; }
        unsafe { *(p + 4) = 50u8; }
        unsafe { *(p + 5) = 48u8; }
        unsafe { *(p + 6) = 50u8; }
        unsafe { *(p + 7) = 0u8; }
        interner_intern_bytes(mut_view(*str_in), p as *const u8, 7).v
    };
    assert_true(unsafe { (*in_new1).mangled_name.v } == s_new, 62);
    assert_true(unsafe { (*in_new2).mangled_name.v } == s_new_202, 63);

    // Drop name mangling (with generic suffix stripping)
    let s_vec_gen = {
        let p = arena_alloc_raw(mut_view(str_in.bytes), 9, 1);
        unsafe { *(p + 0) = 86u8; }
        unsafe { *(p + 1) = 101u8; }
        unsafe { *(p + 2) = 99u8; }
        unsafe { *(p + 3) = 60u8; }
        unsafe { *(p + 4) = 105u8; }
        unsafe { *(p + 5) = 51u8; }
        unsafe { *(p + 6) = 50u8; }
        unsafe { *(p + 7) = 62u8; }
        unsafe { *(p + 8) = 0u8; }
        interner_intern_bytes(mut_view(*str_in), p as *const u8, 8).v
    };
    let sv_vec_gen = interner_get(view(*str_in), mk_sid(s_vec_gen));
    let drop_id = mangle_drop_name(mut_view(*str_in), view(sv_vec_gen));
    let s_vec_drop = {
        let p = arena_alloc_raw(mut_view(str_in.bytes), 9, 1);
        unsafe { *(p + 0) = 86u8; }
        unsafe { *(p + 1) = 101u8; }
        unsafe { *(p + 2) = 99u8; }
        unsafe { *(p + 3) = 95u8; }
        unsafe { *(p + 4) = 100u8; }
        unsafe { *(p + 5) = 114u8; }
        unsafe { *(p + 6) = 111u8; }
        unsafe { *(p + 7) = 112u8; }
        unsafe { *(p + 8) = 0u8; }
        interner_intern_bytes(mut_view(*str_in), p as *const u8, 8).v
    };
    assert_true(drop_id.v == s_vec_drop, 64);

    // Trait/impl method resolution for monomorphizer
    let mono_m = mono_resolve_trait_or_impl_method(
        view(hir),
        view(thir.interner),
        view(*str_in),
        view(*db),
        tid(ty_view_point_v),
        view(sv_fmt)
    );
    assert_true((mono_m as usize) == (fn_fmt_pt as usize), 65);

    let mono_def_m = mono_resolve_trait_or_impl_method(
        view(hir),
        view(thir.interner),
        view(*str_in),
        view(*db),
        tid(ty_point_v),
        view(sv_sub_def)
    );
    assert_true((mono_def_m as usize) == (fn_sub_def as usize), 66);

    thir_free(mut_view(*thir));
    diag_sink_free(mut_view(*sink));
    source_db_free(mut_view(*db));
}

pub fn main() -> i32 {
    let mut arena: Arena = arena_new();
    let mut str_in: StrInterner = interner_new();
    let db_ptr = arena_alloc_raw(
        mut_view(arena),
        size_of<SourceDatabase>(),
        align_of<SourceDatabase>()
    ) as *mut SourceDatabase;
    let sink_ptr = arena_alloc_raw(
        mut_view(arena),
        size_of<DiagSink>(),
        align_of<DiagSink>()
    ) as *mut DiagSink;
    let thir_ptr = arena_alloc_raw(
        mut_view(arena),
        size_of<Thir>(),
        align_of<Thir>()
    ) as *mut Thir;
    let mono_arena_ptr = arena_alloc_raw(
        mut_view(arena),
        size_of<Arena>(),
        align_of<Arena>()
    ) as *mut Arena;
    unsafe {
        (*mono_arena_ptr).head = 0 as *mut ArenaChunk;
        run_traits_tests(
            mut_view(arena),
            mono_arena_ptr,
            mut_view(str_in),
            mut_view(*db_ptr),
            mut_view(*sink_ptr),
            mut_view(*thir_ptr)
        );
        arena_destroy(mut_view(*mono_arena_ptr));
    }
    interner_free(mut_view(str_in));
    arena_destroy(mut_view(arena));
    print("OK Traits Solver Mono\n");
    0
}
