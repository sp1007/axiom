    let s_point = {
        let p = arena_alloc_raw(mut_view(str_in.bytes), 6, 1);
        unsafe { *(p + 0) = 80u8; }
        unsafe { *(p + 1) = 111u8; }
        unsafe { *(p + 2) = 105u8; }
        unsafe { *(p + 3) = 110u8; }
        unsafe { *(p + 4) = 116u8; }
        unsafe { *(p + 5) = 0u8; }
