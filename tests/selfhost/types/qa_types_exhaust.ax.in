use compiler.hir.hir.HIR_ITEM_ENUM
use compiler.hir.hir.HIR_PAT_BINDING
use compiler.hir.hir.HIR_PAT_LITERAL
use compiler.hir.hir.HIR_PAT_OR
use compiler.hir.hir.HIR_PAT_PATH
use compiler.hir.hir.HIR_PAT_RANGE
use compiler.hir.hir.HIR_PAT_STRUCT
use compiler.hir.hir.HIR_PAT_WILDCARD
use compiler.hir.hir.HirExpr
use compiler.hir.hir.HirItem
use compiler.hir.hir.HirMatchArm
use compiler.hir.hir.HirPat
use compiler.hir.hir.HirVariantDecl
use compiler.types.exhaust.PatInterval
use compiler.source.manager.SourceDatabase
use compiler.source.span.Span
use compiler.kernel.interner.StrInterner
use compiler.lex.token.TOK_CHAR
use compiler.lex.token.TOK_INT
use compiler.lex.token.TOK_KW_FALSE
use compiler.lex.token.TOK_KW_TRUE
use compiler.types.types.TY_ENUM
use compiler.types.types.Thir
use compiler.kernel.id.TypeId
use compiler.kernel.arena.arena_alloc_raw
use compiler.kernel.arena.arena_destroy
use compiler.kernel.arena.arena_new
use compiler.types.types.ax_type_reset
use compiler.diag.emitter.diag_sink_free
use compiler.diag.emitter.diag_sink_init
use compiler.types.exhaust.get_pat_interval
use compiler.hir.hir.hir_alloc_expr
use compiler.hir.hir.hir_alloc_item
use compiler.hir.hir.hir_alloc_match_arm
use compiler.hir.hir.hir_alloc_pat
use compiler.hir.hir.hir_alloc_variant_decl
use compiler.types.types.intern_type
use compiler.kernel.interner.interner_free
use compiler.kernel.interner.interner_intern_bytes
use compiler.kernel.interner.interner_new
