use compiler.types.types.thir_init

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic fn wrapping_add_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn rotate_left_u64(x: u64, n: u32) -> u64 { 0 }

const TEST_SRC_BYTES: [42]u8 = [67u8, 111u8, 108u8, 111u8, 114u8, 46u8, 82u8, 101u8, 100u8, 32u8, 67u8, 111u8, 108u8, 111u8, 114u8, 46u8, 71u8, 114u8, 101u8, 101u8, 110u8, 32u8, 67u8, 111u8, 108u8, 111u8, 114u8, 46u8, 66u8, 108u8, 117u8, 101u8, 32u8, 79u8, 116u8, 104u8, 101u8, 114u8, 46u8, 82u8, 101u8, 100u8];
const TEST_PATH_BYTES: [12]u8 = [116u8, 101u8, 115u8, 116u8, 95u8, 101u8, 110u8, 117u8, 109u8, 46u8, 97u8, 120u8];
const STR_COLOR: [5]u8 = [67u8, 111u8, 108u8, 111u8, 114u8];
const STR_RED: [3]u8 = [82u8, 101u8, 100u8];
const STR_GREEN: [5]u8 = [71u8, 114u8, 101u8, 101u8, 110u8];
const STR_BLUE: [4]u8 = [66u8, 108u8, 117u8, 101u8];

fn assert_true(cond: bool, code: i32) {
    if !cond {
        exit(code);
    }
}

fn make_int_pat(arena: mut_view<Arena>, val: u64, negated: bool, start_off: u32) -> *mut HirPat {
    let sp = Span { file: FileId { v: 1u32 }, start: start_off, end: start_off + 2u32 };
    let p = hir_alloc_pat(arena, HIR_PAT_LITERAL, sp);
    unsafe {
        (*p).tok.kind = TOK_INT;
        (*p).tok.int_val = val;
        (*p).is_negated = negated;
    }
    p
}

fn make_char_pat(arena: mut_view<Arena>, ch: u32, start_off: u32) -> *mut HirPat {
    let sp = Span { file: FileId { v: 1u32 }, start: start_off, end: start_off + 3u32 };
    let p = hir_alloc_pat(arena, HIR_PAT_LITERAL, sp);
    unsafe {
        (*p).tok.kind = TOK_CHAR;
        (*p).tok.char_val = ch;
        (*p).tok.int_val = 0u64;
    }
    p
}

fn make_bool_pat(arena: mut_view<Arena>, is_true: bool, start_off: u32) -> *mut HirPat {
    let sp = Span { file: FileId { v: 1u32 }, start: start_off, end: start_off + 4u32 };
    let p = hir_alloc_pat(arena, HIR_PAT_LITERAL, sp);
    unsafe {
        (*p).tok.kind = if is_true { TOK_KW_TRUE } else { TOK_KW_FALSE };
    }
    p
}

fn make_range_pat(arena: mut_view<Arena>, s: *mut HirPat, e: *mut HirPat, inclusive: bool, start_off: u32) -> *mut HirPat {
    let sp = Span { file: FileId { v: 1u32 }, start: start_off, end: start_off + 6u32 };
    let p = hir_alloc_pat(arena, HIR_PAT_RANGE, sp);
    unsafe {
        (*p).start_pat = s;
        (*p).end_pat = e;
        (*p).is_inclusive = inclusive;
    }
    p
}

fn make_wildcard_pat(arena: mut_view<Arena>, start_off: u32) -> *mut HirPat {
    let sp = Span { file: FileId { v: 1u32 }, start: start_off, end: start_off + 1u32 };
    hir_alloc_pat(arena, HIR_PAT_WILDCARD, sp)
}

fn make_binding_pat(arena: mut_view<Arena>, sym_v: u32, start_off: u32) -> *mut HirPat {
    let sp = Span { file: FileId { v: 1u32 }, start: start_off, end: start_off + 2u32 };
    let p = hir_alloc_pat(arena, HIR_PAT_BINDING, sp);
    unsafe {
        (*p).symbol.v = sym_v;
    }
    p
}

fn make_arm(arena: mut_view<Arena>, pat: *mut HirPat, guard: *mut HirExpr, start_off: u32) -> *mut HirMatchArm {
    let sp = Span { file: FileId { v: 1u32 }, start: start_off, end: start_off + 5u32 };
    let arm = hir_alloc_match_arm(arena, sp);
    unsafe {
        (*arm).pat = pat;
        (*arm).guard = guard;
    }
    arm
}

fn make_match_expr(arena: mut_view<Arena>, arms: *mut HirMatchArm, start_off: u32) -> *mut HirExpr {
    let sp = Span { file: FileId { v: 1u32 }, start: start_off, end: start_off + 20u32 };
    let e = hir_alloc_expr(arena, HIR_EXPR_MATCH, sp);
    unsafe {
        (*e).arms = arms;
    }
    e
}

unsafe fn diag_at_const(diags: *mut Diagnostic, idx: usize) -> *const Diagnostic {
    ((diags as usize) + mul_usize(idx, size_of<Diagnostic>())) as *const Diagnostic
}

pub fn run_exhaust_tests(
    arena: mut_view<Arena>,
    str_in: mut_view<StrInterner>,
    db: mut_view<SourceDatabase>,
    sink: mut_view<DiagSink>,
    thir: mut_view<Thir>
) {
    thir_init(mut_view(*thir));

    // 1. Test get_pat_interval on int literal, negated int literal, char literal, inclusive & exclusive ranges
    let p_pos = make_int_pat(mut_view(*arena), 42u64, false, 10u32);
    let p_neg = make_int_pat(mut_view(*arena), 15u64, true, 20u32);
    let p_chr = make_char_pat(mut_view(*arena), 65u32, 30u32);
    let mut iv = PatInterval { start: 0i64, end: 0i64 };

    assert_true(get_pat_interval(p_pos as *const HirPat, mut_view(iv)), 1);
    assert_true(iv.start == 42i64 && iv.end == 42i64, 2);

    assert_true(get_pat_interval(p_neg as *const HirPat, mut_view(iv)), 3);
    assert_true(iv.start == -15i64 && iv.end == -15i64, 4);

    assert_true(get_pat_interval(p_chr as *const HirPat, mut_view(iv)), 5);
    assert_true(iv.start == 65i64 && iv.end == 65i64, 6);

    let r_inc = make_range_pat(mut_view(*arena), p_neg, p_pos, true, 40u32);
    assert_true(get_pat_interval(r_inc as *const HirPat, mut_view(iv)), 7);
    assert_true(iv.start == -15i64 && iv.end == 42i64, 8);

    let r_exc = make_range_pat(mut_view(*arena), p_neg, p_pos, false, 50u32);
    assert_true(get_pat_interval(r_exc as *const HirPat, mut_view(iv)), 9);
    assert_true(iv.start == -15i64 && iv.end == 41i64, 10);

    // 2. Bool exhaustiveness:
    // 2a. Non-exhaustive bool match (only `true`) -> AX_PAT_NON_EXHAUSTIVE
    let b_true1 = make_bool_pat(mut_view(*arena), true, 100u32);
    let arm_b1 = make_arm(mut_view(*arena), b_true1, 0 as *mut HirExpr, 100u32);
    let m_bool_nonex = make_match_expr(mut_view(*arena), arm_b1, 100u32);
    let t_bool_v = thir.interner.t_bool.v;
    match_check_exhaustiveness(
        mut_view(*thir),
        view(*str_in),
        view(*db),
        mut_view(*sink),
        m_bool_nonex as *const HirExpr,
        TypeId { v: t_bool_v }
    );
    assert_true(sink.errors == 1, 20);
    assert_true(sink.warnings == 0, 21);
    let d0 = unsafe { diag_at_const(sink.diags, 0) };
    assert_true((unsafe { (*d0).code.v }) == AX_PAT_NON_EXHAUSTIVE, 22);

    // 2b. Exhaustive bool match (`true`, `false`) -> no errors or warnings
    let b_false1 = make_bool_pat(mut_view(*arena), false, 110u32);
    let arm_b2 = make_arm(mut_view(*arena), b_false1, 0 as *mut HirExpr, 110u32);
    unsafe { (*arm_b1).next = arm_b2; }
    match_check_exhaustiveness(
        mut_view(*thir),
        view(*str_in),
        view(*db),
        mut_view(*sink),
        m_bool_nonex as *const HirExpr,
        TypeId { v: t_bool_v }
    );
    assert_true(sink.errors == 1, 23);
    assert_true(sink.warnings == 0, 24);

    // 2c. Duplicate bool arm (`true`, `false`, `true`) -> AX_PAT_UNREACHABLE warning on 3rd arm
    let b_true_dup = make_bool_pat(mut_view(*arena), true, 120u32);
    let arm_b3 = make_arm(mut_view(*arena), b_true_dup, 0 as *mut HirExpr, 120u32);
    unsafe { (*arm_b2).next = arm_b3; }
    match_check_exhaustiveness(
        mut_view(*thir),
        view(*str_in),
        view(*db),
        mut_view(*sink),
        m_bool_nonex as *const HirExpr,
        TypeId { v: t_bool_v }
    );
    assert_true(sink.errors == 1, 25);
    assert_true(sink.warnings == 1, 26);
    let d1 = unsafe { diag_at_const(sink.diags, 1) };
    assert_true((unsafe { (*d1).code.v }) == AX_PAT_UNREACHABLE, 27);
    assert_true((unsafe { (*d1).primary.start }) == 120u32, 28);

    // 2d. Guarded bool arm (`true if guard`, `false`) -> non-exhaustive because guarded arm doesn't guarantee coverage
    let dummy_guard = hir_alloc_expr(mut_view(*arena), HIR_EXPR_MATCH, Span { file: FileId { v: 1u32 }, start: 130u32, end: 131u32 });
    let b_true_g = make_bool_pat(mut_view(*arena), true, 132u32);
    let b_false_g = make_bool_pat(mut_view(*arena), false, 136u32);
    let arm_bg1 = make_arm(mut_view(*arena), b_true_g, dummy_guard, 132u32);
    let arm_bg2 = make_arm(mut_view(*arena), b_false_g, 0 as *mut HirExpr, 136u32);
    unsafe { (*arm_bg1).next = arm_bg2; }
    let m_bool_guarded = make_match_expr(mut_view(*arena), arm_bg1, 130u32);
    match_check_exhaustiveness(
        mut_view(*thir),
        view(*str_in),
        view(*db),
        mut_view(*sink),
        m_bool_guarded as *const HirExpr,
        TypeId { v: t_bool_v }
    );
    assert_true(sink.errors == 2, 29);

    // 3. Wildcard & Binding unreachability:
    let w_pat = make_wildcard_pat(mut_view(*arena), 200u32);
    let i_pat1 = make_int_pat(mut_view(*arena), 1u64, false, 210u32);
    let arm_w1 = make_arm(mut_view(*arena), w_pat, 0 as *mut HirExpr, 200u32);
    let arm_w2 = make_arm(mut_view(*arena), i_pat1, 0 as *mut HirExpr, 210u32);
    unsafe { (*arm_w1).next = arm_w2; }
    let m_wild = make_match_expr(mut_view(*arena), arm_w1, 200u32);
    let t_i32_v = thir.interner.t_i32.v;
    let prev_warns = sink.warnings;
    let prev_errs = sink.errors;
    match_check_exhaustiveness(
        mut_view(*thir),
        view(*str_in),
        view(*db),
        mut_view(*sink),
        m_wild as *const HirExpr,
        TypeId { v: t_i32_v }
    );
    assert_true(sink.errors == prev_errs, 30);
    assert_true(sink.warnings == prev_warns + 1, 31);

    // 4. Integer intervals, Or-patterns, and u8 full 0..=255 range coverage:
    let u8_s1 = make_int_pat(mut_view(*arena), 0u64, false, 300u32);
    let u8_e1 = make_int_pat(mut_view(*arena), 100u64, false, 302u32);
    let u8_r1 = make_range_pat(mut_view(*arena), u8_s1, u8_e1, false, 300u32);

    let u8_s2 = make_int_pat(mut_view(*arena), 100u64, false, 310u32);
    let u8_e2 = make_int_pat(mut_view(*arena), 255u64, false, 314u32);
    let u8_r2 = make_range_pat(mut_view(*arena), u8_s2, u8_e2, true, 310u32);

    let or_sub1 = make_int_pat(mut_view(*arena), 50u64, false, 320u32);
    let or_sub2 = make_int_pat(mut_view(*arena), 256u64, false, 325u32);
    unsafe { (*or_sub1).next = or_sub2; }
    let or_pat = hir_alloc_pat(mut_view(*arena), HIR_PAT_OR, Span { file: FileId { v: 1u32 }, start: 320u32, end: 328u32 });
    unsafe { (*or_pat).pats = or_sub1; }

    let arm_u8_1 = make_arm(mut_view(*arena), u8_r1, 0 as *mut HirExpr, 300u32);
    let arm_u8_2 = make_arm(mut_view(*arena), u8_r2, 0 as *mut HirExpr, 310u32);
    let arm_u8_3 = make_arm(mut_view(*arena), or_pat, 0 as *mut HirExpr, 320u32);
    unsafe {
        (*arm_u8_1).next = arm_u8_2;
        (*arm_u8_2).next = arm_u8_3;
    }
    let m_u8_full = make_match_expr(mut_view(*arena), arm_u8_1, 300u32);
    let t_u8_v = thir.interner.t_u8.v;
    let errs_before_u8 = sink.errors;
    let warns_before_u8 = sink.warnings;
    match_check_exhaustiveness(
        mut_view(*thir),
        view(*str_in),
        view(*db),
        mut_view(*sink),
        m_u8_full as *const HirExpr,
        TypeId { v: t_u8_v }
    );
    assert_true(sink.errors == errs_before_u8, 40);
    assert_true(sink.warnings == warns_before_u8 + 1, 41);
    let d_or = unsafe { diag_at_const(sink.diags, sink.len - 1) };
    assert_true((unsafe { (*d_or).code.v }) == AX_PAT_UNREACHABLE, 42);
    assert_true((unsafe { (*d_or).primary.start }) == 320u32, 43);

    // 4b. u8 missing 255 (`0..255` exclusive) -> AX_PAT_NON_EXHAUSTIVE
    let u8_s3 = make_int_pat(mut_view(*arena), 0u64, false, 340u32);
    let u8_e3 = make_int_pat(mut_view(*arena), 255u64, false, 342u32);
    let u8_r3 = make_range_pat(mut_view(*arena), u8_s3, u8_e3, false, 340u32);
    let arm_u8_inc = make_arm(mut_view(*arena), u8_r3, 0 as *mut HirExpr, 340u32);
    let m_u8_inc = make_match_expr(mut_view(*arena), arm_u8_inc, 340u32);
    match_check_exhaustiveness(
        mut_view(*thir),
        view(*str_in),
        view(*db),
        mut_view(*sink),
        m_u8_inc as *const HirExpr,
        TypeId { v: t_u8_v }
    );
    assert_true(sink.errors == errs_before_u8 + 1, 44);

    // 5. Enum exhaustiveness & unreachability (both via SourceDatabase span text `Color.Red` and via `path.name` fallback):
    let src_buf = arena_alloc_raw(mut_view(*arena), 43, 1);
    let mut bi: usize = 0;
    while (bi < 42) {
        unsafe { *(src_buf + bi) = TEST_SRC_BYTES[bi]; }
        bi = bi + 1;
    }
    unsafe { *(src_buf + 42) = 0u8; }

    let path_buf = arena_alloc_raw(mut_view(*arena), 13, 1);
    bi = 0;
    while (bi < 12) {
        unsafe { *(path_buf + bi) = TEST_PATH_BYTES[bi]; }
        bi = bi + 1;
    }
    unsafe { *(path_buf + 12) = 0u8; }

    let fid = source_db_add_virtual(
        mut_view(*db),
        path_buf as *const u8,
        12,
        src_buf as *const u8,
        42
    );
    let fid_v = fid.v;

    let buf_color = arena_alloc_raw(mut_view(*arena), 6, 1);
    bi = 0;
    while (bi < 5) { unsafe { *(buf_color + bi) = STR_COLOR[bi]; };
        bi = bi + 1;
    }
    let buf_red = arena_alloc_raw(mut_view(*arena), 4, 1);
    bi = 0;
    while (bi < 3) { unsafe { *(buf_red + bi) = STR_RED[bi]; };
        bi = bi + 1;
    }
    let buf_green = arena_alloc_raw(mut_view(*arena), 6, 1);
    bi = 0;
    while (bi < 5) { unsafe { *(buf_green + bi) = STR_GREEN[bi]; };
        bi = bi + 1;
    }
    let buf_blue = arena_alloc_raw(mut_view(*arena), 5, 1);
    bi = 0;
    while (bi < 4) { unsafe { *(buf_blue + bi) = STR_BLUE[bi]; };
        bi = bi + 1;
    }

    let s_color = interner_intern_bytes(mut_view(*str_in), buf_color as *const u8, 5);
    let s_red = interner_intern_bytes(mut_view(*str_in), buf_red as *const u8, 3);
    let s_green = interner_intern_bytes(mut_view(*str_in), buf_green as *const u8, 5);
    let s_blue = interner_intern_bytes(mut_view(*str_in), buf_blue as *const u8, 4);
    let s_color_v = s_color.v;
    let s_red_v = s_red.v;
    let s_green_v = s_green.v;
    let s_blue_v = s_blue.v;

    let v_red = hir_alloc_variant_decl(mut_view(*arena), Span { file: FileId { v: fid_v }, start: 0u32, end: 9u32 });
    let v_green = hir_alloc_variant_decl(mut_view(*arena), Span { file: FileId { v: fid_v }, start: 10u32, end: 21u32 });
    let v_blue = hir_alloc_variant_decl(mut_view(*arena), Span { file: FileId { v: fid_v }, start: 22u32, end: 32u32 });
    unsafe {
        (*v_red).name.v = s_red_v;
        (*v_red).next = v_green;
        (*v_green).name.v = s_green_v;
        (*v_green).next = v_blue;
        (*v_blue).name.v = s_blue_v;
        (*v_blue).next = 0 as *mut HirVariantDecl;
    }
    let enum_item = hir_alloc_item(mut_view(*arena), HIR_ITEM_ENUM, Span { file: FileId { v: fid_v }, start: 0u32, end: 32u32 });
    unsafe {
        (*enum_item).name.v = s_color_v;
        (*enum_item).variants = v_red;
    }

    unsafe {
        ax_type_reset(mut_view(*thir.interner.scratch), TY_ENUM);
        (*thir.interner.scratch).def = enum_item as *const HirItem;
        (*thir.interner.scratch).variant_count = 3;
    }
    let sp_enum = thir.interner.scratch;
    let color_ty = intern_type(mut_view(thir.interner), unsafe { view(*sp_enum) });
    let color_ty_v = color_ty.v;

    // 5a. Partial enum match (`Color.Red`, `Color.Green`, and mismatched enum `Other.Red`) -> non-exhaustive
    let pat_red = hir_alloc_pat(mut_view(*arena), HIR_PAT_PATH, Span { file: FileId { v: fid_v }, start: 0u32, end: 9u32 });
    unsafe {
        (*pat_red).path.span.file.v = fid_v;
        (*pat_red).path.span.start = 0u32;
        (*pat_red).path.span.end = 9u32;
        (*pat_red).path.name.v = s_red_v;
    }
    let pat_green = hir_alloc_pat(mut_view(*arena), HIR_PAT_STRUCT, Span { file: FileId { v: fid_v }, start: 10u32, end: 21u32 });
    unsafe {
        (*pat_green).path.span.file.v = fid_v;
        (*pat_green).path.span.start = 10u32;
        (*pat_green).path.span.end = 21u32;
        (*pat_green).path.name.v = s_green_v;
    }
    let pat_other_red = hir_alloc_pat(mut_view(*arena), HIR_PAT_PATH, Span { file: FileId { v: fid_v }, start: 33u32, end: 42u32 });
    unsafe {
        (*pat_other_red).path.span.file.v = fid_v;
        (*pat_other_red).path.span.start = 33u32;
        (*pat_other_red).path.span.end = 42u32;
        (*pat_other_red).path.name.v = s_red_v;
    }

    let earm1 = make_arm(mut_view(*arena), pat_red, 0 as *mut HirExpr, 0u32);
    let earm2 = make_arm(mut_view(*arena), pat_green, 0 as *mut HirExpr, 10u32);
    let earm_other = make_arm(mut_view(*arena), pat_other_red, 0 as *mut HirExpr, 33u32);
    unsafe {
        (*earm1).next = earm2;
        (*earm2).next = earm_other;
    }
    let m_enum = make_match_expr(mut_view(*arena), earm1, 400u32);
    let errs_before_enum = sink.errors;
    let warns_before_enum = sink.warnings;
    match_check_exhaustiveness(
        mut_view(*thir),
        view(*str_in),
        view(*db),
        mut_view(*sink),
        m_enum as *const HirExpr,
        TypeId { v: color_ty_v }
    );
    assert_true(sink.errors == errs_before_enum + 1, 50);
    assert_true(sink.warnings == warns_before_enum, 51);

    // 5b. Add `Blue` (via `path.name` fallback with empty span) and duplicate `Color.Red` -> exhaustive (0 new errors) + 1 unreachable warning on duplicate `Color.Red`!
    let pat_blue_fallback = hir_alloc_pat(mut_view(*arena), HIR_PAT_PATH, Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 });
    unsafe {
        (*pat_blue_fallback).path.span.file.v = 0u32;
        (*pat_blue_fallback).path.name.v = s_blue_v;
    }
    let pat_red_dup = hir_alloc_pat(mut_view(*arena), HIR_PAT_PATH, Span { file: FileId { v: fid_v }, start: 0u32, end: 9u32 });
    unsafe {
        (*pat_red_dup).path.span.file.v = fid_v;
        (*pat_red_dup).path.span.start = 0u32;
        (*pat_red_dup).path.span.end = 9u32;
        (*pat_red_dup).path.name.v = s_red_v;
    }
    let earm3 = make_arm(mut_view(*arena), pat_blue_fallback, 0 as *mut HirExpr, 22u32);
    let earm4 = make_arm(mut_view(*arena), pat_red_dup, 0 as *mut HirExpr, 500u32);
    unsafe {
        (*earm_other).next = earm3;
        (*earm3).next = earm4;
    }
    match_check_exhaustiveness(
        mut_view(*thir),
        view(*str_in),
        view(*db),
        mut_view(*sink),
        m_enum as *const HirExpr,
        TypeId { v: color_ty_v }
    );
    assert_true(sink.errors == errs_before_enum + 1, 52);
    assert_true(sink.warnings == warns_before_enum + 1, 53);

    // 6. Other types (e.g., `str` or `struct`):
    // Without wildcard/binding -> AX_PAT_NON_EXHAUSTIVE; with binding -> exhaustive
    let t_str_v = thir.interner.t_str.v;
    let m_str_empty = make_match_expr(mut_view(*arena), 0 as *mut HirMatchArm, 600u32);
    let errs_before_str = sink.errors;
    match_check_exhaustiveness(
        mut_view(*thir),
        view(*str_in),
        view(*db),
        mut_view(*sink),
        m_str_empty as *const HirExpr,
        TypeId { v: t_str_v }
    );
    assert_true(sink.errors == errs_before_str + 1, 60);

    let bind_pat = make_binding_pat(mut_view(*arena), 99u32, 610u32);
    let arm_bind = make_arm(mut_view(*arena), bind_pat, 0 as *mut HirExpr, 610u32);
    let m_str_bind = make_match_expr(mut_view(*arena), arm_bind, 610u32);
    match_check_exhaustiveness(
        mut_view(*thir),
        view(*str_in),
        view(*db),
        mut_view(*sink),
        m_str_bind as *const HirExpr,
        TypeId { v: t_str_v }
    );
    assert_true(sink.errors == errs_before_str + 1, 61);

    thir_free(mut_view(*thir));
}

pub fn main() -> i32 {
    let mut arena: Arena = arena_new();
    let mut str_in: StrInterner = interner_new();
    let db_ptr = arena_alloc_raw(mut_view(arena), size_of<SourceDatabase>(), align_of<SourceDatabase>()) as *mut SourceDatabase;
    let sink_ptr = arena_alloc_raw(mut_view(arena), size_of<DiagSink>(), align_of<DiagSink>()) as *mut DiagSink;
    let thir_ptr = arena_alloc_raw(mut_view(arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    unsafe {
        source_db_init(mut_view(*db_ptr));
        diag_sink_init(mut_view(*sink_ptr));
        run_exhaust_tests(
            mut_view(arena),
            mut_view(str_in),
            mut_view(*db_ptr),
            mut_view(*sink_ptr),
            mut_view(*thir_ptr)
        );
        diag_sink_free(mut_view(*sink_ptr));
        source_db_free(mut_view(*db_ptr));
    }
    interner_free(mut_view(str_in));
    arena_destroy(mut_view(arena));
    print("OK Types Exhaust\n");
    0
}
