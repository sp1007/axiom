pub fn ptr_substmap_init(m: mut_view<PtrSubstMap>) {
    m.keys = 0 as *mut usize;
    m.vals = 0 as *mut GenericArgsSlice;
    m.states = 0 as *mut u8;
    m.len = 0;
    m.cap = 0;
}

pub fn ptr_substmap_free(m: mut_view<PtrSubstMap>) {
    if m.cap > 0 {
        unsafe {
            heap_free(m.keys as *mut u8, mul_usize(m.cap, size_of<usize>()), align_of<usize>());
            heap_free(
                m.vals as *mut u8,
                mul_usize(m.cap, size_of<GenericArgsSlice>()),
                align_of<GenericArgsSlice>()
            );
            heap_free(m.states, m.cap, 1);
        }
    }
    ptr_substmap_init(m);
}

fn ptr_substmap_grow(m: mut_view<PtrSubstMap>) {
    let new_cap: usize = if m.cap == 0 { MAP_INIT_CAP } else { mul_usize(m.cap, 2) };
    let new_keys = unsafe { heap_alloc(mul_usize(new_cap, size_of<usize>()), align_of<usize>()) as *mut usize };
    let new_vals = unsafe {
        let vbytes = mul_usize(new_cap, size_of<GenericArgsSlice>());
        heap_alloc(vbytes, align_of<GenericArgsSlice>()) as *mut GenericArgsSlice
    };
    let new_states = unsafe { heap_alloc(new_cap, 1) };
    types_zero_bytes(new_states, new_cap);

    let old_keys = m.keys;
    let old_vals = m.vals;
    let old_states = m.states;
    let old_cap = m.cap;

    m.keys = new_keys;
    m.vals = new_vals;
    m.states = new_states;
    m.len = 0;
    m.cap = new_cap;

    let mut i: usize = 0;
    while (i < old_cap) {
        let st = unsafe { *(old_states + i) };
        if st == SLOT_OCCUPIED {
            let k = unsafe { *usize_at(old_keys, i) };
            let vp = unsafe { subst_at(old_vals, i) };
            let args_ptr = unsafe { (*vp).args };
            let cnt = unsafe { (*vp).count };
            ptr_substmap_insert(mut_view(*m), k, args_ptr, cnt);
        }
        i = i + 1;
    }

    if old_cap > 0 {
        unsafe {
            heap_free(old_keys as *mut u8, mul_usize(old_cap, size_of<usize>()), align_of<usize>());
            heap_free(
                old_vals as *mut u8,
                mul_usize(old_cap, size_of<GenericArgsSlice>()),
                align_of<GenericArgsSlice>()
            );
            heap_free(old_states, old_cap, 1);
        }
    }
}

pub fn ptr_substmap_insert(
    m: mut_view<PtrSubstMap>,
    key: usize,
    args: *mut TypeId,
    count: usize
) {
    if m.cap == 0 || mul_usize(m.len + 1, MAP_LOAD_DEN) >= mul_usize(m.cap, MAP_LOAD_NUM) {
        ptr_substmap_grow(mut_view(*m));
    }
    let mask = m.cap - 1;
    let mut idx = (hash_u64(key as u64) as usize) & mask;
    loop {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            unsafe {
                *usize_at(m.keys, idx) = key;
                let vp = subst_at(m.vals, idx);
                (*vp).args = args;
                (*vp).count = count;
                *(m.states + idx) = SLOT_OCCUPIED;
            }
            m.len = m.len + 1;
            return;
        }
        let k = unsafe { *usize_at(m.keys, idx) };
        if k == key {
            unsafe {
                let vp = subst_at(m.vals, idx);
                (*vp).args = args;
                (*vp).count = count;
            }
            return;
        }
        idx = (idx + 1) & mask;
    }
}

pub fn ptr_substmap_get(m: view<PtrSubstMap>, key: usize) -> *mut GenericArgsSlice {
    if m.cap == 0 {
        return 0 as *mut GenericArgsSlice;
    }
    let mask = m.cap - 1;
    let mut idx = (hash_u64(key as u64) as usize) & mask;
    let mut probes: usize = 0;
    while (probes < m.cap) {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            return 0 as *mut GenericArgsSlice;
        }
        if st == SLOT_OCCUPIED {
            let k = unsafe { *usize_at(m.keys, idx) };
            if k == key {
                return unsafe { subst_at(m.vals, idx) };
            }
        }
        idx = (idx + 1) & mask;
        probes = probes + 1;
    }
    0 as *mut GenericArgsSlice
}

pub fn ptr_trymap_init(m: mut_view<PtrTryMap>) {
    m.keys = 0 as *mut usize;
    m.vals = 0 as *mut TryExprInfo;
    m.states = 0 as *mut u8;
    m.len = 0;
    m.cap = 0;
}

pub fn ptr_trymap_free(m: mut_view<PtrTryMap>) {
    if m.cap > 0 {
        unsafe {
            heap_free(m.keys as *mut u8, mul_usize(m.cap, size_of<usize>()), align_of<usize>());
            heap_free(m.vals as *mut u8, mul_usize(m.cap, size_of<TryExprInfo>()), align_of<TryExprInfo>());
            heap_free(m.states, m.cap, 1);
        }
    }
    ptr_trymap_init(m);
}

fn ptr_trymap_grow(m: mut_view<PtrTryMap>) {
    let new_cap: usize = if m.cap == 0 { MAP_INIT_CAP } else { mul_usize(m.cap, 2) };
    let new_keys = unsafe { heap_alloc(mul_usize(new_cap, size_of<usize>()), align_of<usize>()) as *mut usize };
    let new_vals = unsafe {
        heap_alloc(mul_usize(new_cap, size_of<TryExprInfo>()), align_of<TryExprInfo>()) as *mut TryExprInfo
    };
    let new_states = unsafe { heap_alloc(new_cap, 1) };
    types_zero_bytes(new_states, new_cap);

    let old_keys = m.keys;
    let old_vals = m.vals;
    let old_states = m.states;
    let old_cap = m.cap;

    m.keys = new_keys;
    m.vals = new_vals;
    m.states = new_states;
    m.len = 0;
    m.cap = new_cap;

    let mut i: usize = 0;
    while (i < old_cap) {
        let st = unsafe { *(old_states + i) };
        if st == SLOT_OCCUPIED {
            let k = unsafe { *usize_at(old_keys, i) };
            let vp = unsafe { tryinfo_at(old_vals, i) };
            let is_opt = unsafe { (*vp).is_opt };
            let p_idx = unsafe { (*vp).payload_idx };
            let e_idx = unsafe { (*vp).err_idx };
            ptr_trymap_insert(mut_view(*m), k, is_opt, p_idx, e_idx);
        }
        i = i + 1;
    }

    if old_cap > 0 {
        unsafe {
            heap_free(old_keys as *mut u8, mul_usize(old_cap, size_of<usize>()), align_of<usize>());
            heap_free(old_vals as *mut u8, mul_usize(old_cap, size_of<TryExprInfo>()), align_of<TryExprInfo>());
            heap_free(old_states, old_cap, 1);
        }
    }
}

pub fn ptr_trymap_insert(
    m: mut_view<PtrTryMap>,
    key: usize,
    is_opt: bool,
    payload_idx: usize,
    err_idx: usize
) {
    if m.cap == 0 || mul_usize(m.len + 1, MAP_LOAD_DEN) >= mul_usize(m.cap, MAP_LOAD_NUM) {
        ptr_trymap_grow(mut_view(*m));
    }
    let mask = m.cap - 1;
    let mut idx = (hash_u64(key as u64) as usize) & mask;
    loop {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            unsafe {
                *usize_at(m.keys, idx) = key;
                let vp = tryinfo_at(m.vals, idx);
                (*vp).is_opt = is_opt;
                (*vp).payload_idx = payload_idx;
                (*vp).err_idx = err_idx;
                *(m.states + idx) = SLOT_OCCUPIED;
            }
            m.len = m.len + 1;
            return;
        }
        let k = unsafe { *usize_at(m.keys, idx) };
        if k == key {
            unsafe {
                let vp = tryinfo_at(m.vals, idx);
                (*vp).is_opt = is_opt;
                (*vp).payload_idx = payload_idx;
                (*vp).err_idx = err_idx;
            }
            return;
        }
        idx = (idx + 1) & mask;
    }
}

pub fn ptr_trymap_get(m: view<PtrTryMap>, key: usize) -> *mut TryExprInfo {
    if m.cap == 0 {
        return 0 as *mut TryExprInfo;
    }
    let mask = m.cap - 1;
    let mut idx = (hash_u64(key as u64) as usize) & mask;
    let mut probes: usize = 0;
    while (probes < m.cap) {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            return 0 as *mut TryExprInfo;
        }
        if st == SLOT_OCCUPIED {
            let k = unsafe { *usize_at(m.keys, idx) };
            if k == key {
                return unsafe { tryinfo_at(m.vals, idx) };
            }
        }
        idx = (idx + 1) & mask;
        probes = probes + 1;
    }
    0 as *mut TryExprInfo
}

pub fn thir_init(thir: mut_view<Thir>) {
    type_interner_init(mut_view(thir.interner));
    ptr_typemap_init(mut_view(thir.expr_types));
    ptr_typemap_init(mut_view(thir.pat_types));
    ptr_u32map_init(mut_view(thir.expr_variants));
    ptr_u32map_init(mut_view(thir.pat_variants));
    ptr_itemmap_init(mut_view(thir.expr_methods));
    ptr_typemap_init(mut_view(thir.item_types));
    ptr_typemap_init(mut_view(thir.param_types));
    sym_typemap_init(mut_view(thir.symbol_types));
    sym_constmap_init(mut_view(thir.symbol_consts));
    ptr_substmap_init(mut_view(thir.expr_substs));
    ptr_substmap_init(mut_view(thir.pat_substs));
    ptr_trymap_init(mut_view(thir.expr_try_info));
}

pub fn thir_free(thir: mut_view<Thir>) {
    ptr_trymap_free(mut_view(thir.expr_try_info));
    ptr_substmap_free(mut_view(thir.pat_substs));
    ptr_substmap_free(mut_view(thir.expr_substs));
    sym_constmap_free(mut_view(thir.symbol_consts));
    sym_typemap_free(mut_view(thir.symbol_types));
    ptr_typemap_free(mut_view(thir.param_types));
    ptr_typemap_free(mut_view(thir.item_types));
    ptr_itemmap_free(mut_view(thir.expr_methods));
    ptr_u32map_free(mut_view(thir.pat_variants));
    ptr_u32map_free(mut_view(thir.expr_variants));
    ptr_typemap_free(mut_view(thir.pat_types));
    ptr_typemap_free(mut_view(thir.expr_types));
    type_interner_free(mut_view(thir.interner));
}

pub fn thir_set_expr_type(thir: mut_view<Thir>, expr: *const HirExpr, ty: TypeId) {
    ptr_typemap_insert(mut_view(thir.expr_types), expr as usize, ty);
}

pub fn thir_get_expr_type(thir: view<Thir>, expr: *const HirExpr) -> *mut TypeId {
    ptr_typemap_get(view(thir.expr_types), expr as usize)
}

pub fn thir_set_pat_type(thir: mut_view<Thir>, pat: *const HirPat, ty: TypeId) {
    ptr_typemap_insert(mut_view(thir.pat_types), pat as usize, ty);
}

pub fn thir_get_pat_type(thir: view<Thir>, pat: *const HirPat) -> *mut TypeId {
    ptr_typemap_get(view(thir.pat_types), pat as usize)
}

pub fn thir_set_item_type(thir: mut_view<Thir>, item: *const HirItem, ty: TypeId) {
    ptr_typemap_insert(mut_view(thir.item_types), item as usize, ty);
}

pub fn thir_get_item_type(thir: view<Thir>, item: *const HirItem) -> *mut TypeId {
    ptr_typemap_get(view(thir.item_types), item as usize)
}

pub fn thir_set_param_type(thir: mut_view<Thir>, param: *const HirParam, ty: TypeId) {
    ptr_typemap_insert(mut_view(thir.param_types), param as usize, ty);
}

pub fn thir_get_param_type(thir: view<Thir>, param: *const HirParam) -> *mut TypeId {
    ptr_typemap_get(view(thir.param_types), param as usize)
}

pub fn thir_set_sym_type(thir: mut_view<Thir>, sym: SymbolId, ty: TypeId) {
    sym_typemap_insert(mut_view(thir.symbol_types), sym, ty);
}

pub fn thir_get_sym_type(thir: view<Thir>, sym: SymbolId) -> *mut TypeId {
    sym_typemap_get(view(thir.symbol_types), sym)
}

pub fn thir_set_expr_variant(thir: mut_view<Thir>, expr: *const HirExpr, variant_idx: u32) {
    ptr_u32map_insert(mut_view(thir.expr_variants), expr as usize, variant_idx);
}

pub fn thir_get_expr_variant(thir: view<Thir>, expr: *const HirExpr) -> *mut u32 {
    ptr_u32map_get(view(thir.expr_variants), expr as usize)
}

pub fn thir_set_pat_variant(thir: mut_view<Thir>, pat: *const HirPat, variant_idx: u32) {
    ptr_u32map_insert(mut_view(thir.pat_variants), pat as usize, variant_idx);
}

pub fn thir_get_pat_variant(thir: view<Thir>, pat: *const HirPat) -> *mut u32 {
    ptr_u32map_get(view(thir.pat_variants), pat as usize)
}

pub fn thir_set_expr_method(thir: mut_view<Thir>, expr: *const HirExpr, method: *const HirItem) {
    ptr_itemmap_insert(mut_view(thir.expr_methods), expr as usize, method);
}

pub fn thir_get_expr_method(thir: view<Thir>, expr: *const HirExpr) -> *mut *const HirItem {
    ptr_itemmap_get(view(thir.expr_methods), expr as usize)
}

pub struct TypeVarEntry {
    pub resolved_to: TypeId,
    pub is_generic: bool,
    pub span: Span,
}

pub struct TypeVarTable {
    pub items: *mut TypeVarEntry,
    pub len: usize,
    pub cap: usize,
    pub fn_var_start: usize,
}

pub unsafe fn typevar_at(base: *mut TypeVarEntry, idx: usize) -> *mut TypeVarEntry {
    let off = ((idx as isize) * (size_of<TypeVarEntry>() as isize)) as usize;
    ((base as usize) + off) as *mut TypeVarEntry
}

pub fn type_vars_init(tv: mut_view<TypeVarTable>) {
    tv.items = 0 as *mut TypeVarEntry;
    tv.len = 0;
    tv.cap = 0;
    tv.fn_var_start = 0;
}

pub fn type_vars_free(tv: mut_view<TypeVarTable>) {
    if tv.cap > 0 && (tv.items as usize) != 0 {
        unsafe {
            heap_free(
                tv.items as *mut u8,
                mul_usize(tv.cap, size_of<TypeVarEntry>()),
                align_of<TypeVarEntry>()
            );
        }
    }
    type_vars_init(tv);
}

fn type_vars_grow(tv: mut_view<TypeVarTable>) {
    let new_cap: usize = if tv.cap == 0 { MAP_INIT_CAP } else { mul_usize(tv.cap, 2) };
    let new_items = unsafe {
        heap_alloc(mul_usize(new_cap, size_of<TypeVarEntry>()), align_of<TypeVarEntry>()) as *mut TypeVarEntry
    };
    if tv.len > 0 && (tv.items as usize) != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(
                tv.items as *const u8,
                new_items as *mut u8,
                mul_usize(tv.len, size_of<TypeVarEntry>())
            );
            heap_free(
                tv.items as *mut u8,
                mul_usize(tv.cap, size_of<TypeVarEntry>()),
                align_of<TypeVarEntry>()
            );
        }
    }
    tv.items = new_items;
    tv.cap = new_cap;
}

pub fn type_vars_new_int_var(tv: mut_view<TypeVarTable>, ti: mut_view<TypeInterner>) -> TypeId {
    if tv.len == tv.cap {
        type_vars_grow(mut_view(*tv));
    }
    let var_id = tv.len as u32;
    let entry = unsafe { typevar_at(tv.items, tv.len) };
    unsafe {
        (*entry).resolved_to.v = 0u32;
        (*entry).is_generic = false;
        (*entry).span.file.v = 0u32;
        (*entry).span.start = 0u32;
        (*entry).span.end = 0u32;
    }
    tv.len = tv.len + 1;
    intern_var_ty(mut_view(*ti), TY_INT_VAR, var_id)
}

pub fn type_vars_new_ty_var(
    tv: mut_view<TypeVarTable>,
    ti: mut_view<TypeInterner>,
    span: view<Span>
) -> TypeId {
    if tv.len == tv.cap {
        type_vars_grow(mut_view(*tv));
    }
    let var_id = tv.len as u32;
    let entry = unsafe { typevar_at(tv.items, tv.len) };
    unsafe {
        (*entry).resolved_to.v = 0u32;
        (*entry).is_generic = true;
        (*entry).span.file.v = span.file.v;
        (*entry).span.start = span.start;
        (*entry).span.end = span.end;
    }
    tv.len = tv.len + 1;
    intern_var_ty(mut_view(*ti), TY_VAR, var_id)
}

pub fn type_vars_resolve(tv: mut_view<TypeVarTable>, ti: view<TypeInterner>, id: TypeId) -> TypeId {
    let id_v = id.v;
    if id_v == 0u32 {
        return TypeId { v: 0u32 };
    }
    let t = type_get(ti, TypeId { v: id_v });
    if (t as usize) == 0 {
        return TypeId { v: id_v };
    }
    let k = unsafe { (*t).kind };
    if k == TY_INT_VAR || k == TY_VAR {
        let vid = unsafe { (*t).var_id as usize };
        if vid < tv.len {
            let entry = unsafe { typevar_at(tv.items, vid) };
            let res_v = unsafe { (*entry).resolved_to.v };
            if res_v != 0u32 && res_v != id_v {
                let res_id = TypeId { v: res_v };
                let full = type_vars_resolve(mut_view(*tv), ti, res_id);
                let full_v = full.v;
                let entry_after = unsafe { typevar_at(tv.items, vid) };
                unsafe {
                    (*entry_after).resolved_to.v = full_v;
                }
                return TypeId { v: full_v };
            }
        }
    }
    TypeId { v: id_v }
}

pub fn type_vars_unify(
    tv: mut_view<TypeVarTable>,
    ti: view<TypeInterner>,
    a: TypeId,
    b: TypeId
) -> bool {
    let ra = type_vars_resolve(mut_view(*tv), ti, TypeId { v: a.v });
    let rb = type_vars_resolve(mut_view(*tv), ti, TypeId { v: b.v });
    let ra_v = ra.v;
    let rb_v = rb.v;
    if ra_v == rb_v {
        return true;
    }
    let ta = type_get(ti, TypeId { v: ra_v });
    let tb = type_get(ti, TypeId { v: rb_v });
    if (ta as usize) == 0 || (tb as usize) == 0 {
        return false;
    }
    let ka = unsafe { (*ta).kind };
    let kb = unsafe { (*tb).kind };
    if ka == TY_ERROR || kb == TY_ERROR {
        return true;
    }
    if ka == TY_NEVER || kb == TY_NEVER {
        return true;
    }
    if ka == TY_VAR {
        let va = unsafe { (*ta).var_id as usize };
        let vb = unsafe { (*tb).var_id as usize };
        if kb != TY_VAR || va != vb {
            if va < tv.len {
                let ea = unsafe { typevar_at(tv.items, va) };
                unsafe {
                    (*ea).resolved_to.v = rb_v;
                }
            }
        }
        return true;
    }
    if kb == TY_VAR {
        let vb = unsafe { (*tb).var_id as usize };
        if vb < tv.len {
            let eb = unsafe { typevar_at(tv.items, vb) };
            unsafe {
                (*eb).resolved_to.v = ra_v;
            }
        }
        return true;
    }
    if ka == TY_INT_VAR {
        let rb_ty = TypeId { v: rb_v };
        if kb == TY_INT_VAR || type_is_int(rb_ty, ti) {
            let va = unsafe { (*ta).var_id as usize };
            if va < tv.len {
                let ea = unsafe { typevar_at(tv.items, va) };
                unsafe {
                    (*ea).resolved_to.v = rb_v;
                }
            }
            return true;
        }
        return false;
    }
    if kb == TY_INT_VAR {
        let ra_ty = TypeId { v: ra_v };
        if type_is_int(ra_ty, ti) {
            let vb = unsafe { (*tb).var_id as usize };
            if vb < tv.len {
                let eb = unsafe { typevar_at(tv.items, vb) };
                unsafe {
                    (*eb).resolved_to.v = ra_v;
                }
            }
            return true;
        }
        return false;
    }
    if ka == TY_TUPLE && kb == TY_TUPLE {
        let fca = unsafe { (*ta).field_count };
        let fcb = unsafe { (*tb).field_count };
        if fca != fcb {
            return false;
        }
        let fa_ptr = unsafe { (*ta).fields };
        let fb_ptr = unsafe { (*tb).fields };
        let mut ok = true;
        let mut i: usize = 0;
        while (i < fca) {
            let fav = unsafe { (*typeid_at(fa_ptr, i)).v };
            let fbv = unsafe { (*typeid_at(fb_ptr, i)).v };
            let fa_ty = TypeId { v: fav };
            let fb_ty = TypeId { v: fbv };
            if !type_vars_unify(mut_view(*tv), ti, fa_ty, fb_ty) {
                ok = false;
            }
            i = i + 1;
        }
        return ok;
    }
    if ka == TY_ARRAY && kb == TY_ARRAY {
        let la = unsafe { (*ta).array_len };
        let lb = unsafe { (*tb).array_len };
        if la != lb {
            return false;
        }
        let ela = unsafe { (*ta).elem.v };
        let elb = unsafe { (*tb).elem.v };
        let ela_ty = TypeId { v: ela };
        let elb_ty = TypeId { v: elb };
        return type_vars_unify(mut_view(*tv), ti, ela_ty, elb_ty);
    }
    if ka == TY_VIEW && kb == TY_VIEW {
        let pta = unsafe { (*ta).pointee.v };
        let ptb = unsafe { (*tb).pointee.v };
        let pta_ty = TypeId { v: pta };
        let ptb_ty = TypeId { v: ptb };
        return type_vars_unify(mut_view(*tv), ti, pta_ty, ptb_ty);
    }
    if ka == TY_MUT_VIEW && kb == TY_MUT_VIEW {
        let pta = unsafe { (*ta).pointee.v };
        let ptb = unsafe { (*tb).pointee.v };
        let pta_ty = TypeId { v: pta };
        let ptb_ty = TypeId { v: ptb };
        return type_vars_unify(mut_view(*tv), ti, pta_ty, ptb_ty);
    }
    if ka == TY_PTR && kb == TY_PTR {
        let ma = unsafe { (*ta).is_mut };
        let mb = unsafe { (*tb).is_mut };
        if ma != mb {
            return false;
        }
        let pta = unsafe { (*ta).pointee.v };
        let ptb = unsafe { (*tb).pointee.v };
        let pta_ty = TypeId { v: pta };
        let ptb_ty = TypeId { v: ptb };
        return type_vars_unify(mut_view(*tv), ti, pta_ty, ptb_ty);
    }
    if ka == TY_STR && kb == TY_VIEW {
        let ptb_v = unsafe { (*tb).pointee.v };
        let p_tb = type_get(ti, TypeId { v: ptb_v });
        if (p_tb as usize) == 0 {
            return false;
        }
        let p_kb = unsafe { (*p_tb).kind };
        if p_kb != TY_SLICE {
            return false;
        }
        let elb = unsafe { (*p_tb).elem.v };
        let u8_ty = TypeId { v: ti.t_u8.v };
        let elb_ty = TypeId { v: elb };
        return type_vars_unify(mut_view(*tv), ti, u8_ty, elb_ty);
    }
    if kb == TY_STR && ka == TY_VIEW {
        let pta_v = unsafe { (*ta).pointee.v };
        let p_ta = type_get(ti, TypeId { v: pta_v });
        if (p_ta as usize) == 0 {
            return false;
        }
        let p_ka = unsafe { (*p_ta).kind };
        if p_ka != TY_SLICE {
            return false;
        }
        let ela = unsafe { (*p_ta).elem.v };
        let u8_ty = TypeId { v: ti.t_u8.v };
        let ela_ty = TypeId { v: ela };
        return type_vars_unify(mut_view(*tv), ti, u8_ty, ela_ty);
    }
    if (ka == TY_ENUM && kb == TY_ENUM) || (ka == TY_STRUCT && kb == TY_STRUCT) {
        let defa = unsafe { (*ta).def as usize };
        let defb = unsafe { (*tb).def as usize };
        if defa != defb {
            return false;
        }
        let aca = unsafe { (*ta).arg_count };
        let acb = unsafe { (*tb).arg_count };
        if aca != acb {
            return false;
        }
        let args_a = unsafe { (*ta).args };
        let args_b = unsafe { (*tb).args };
        let mut ok = true;
        let mut i: usize = 0;
        while (i < aca) {
            let aav = unsafe { (*typeid_at(args_a, i)).v };
            let abv = unsafe { (*typeid_at(args_b, i)).v };
            let aa_ty = TypeId { v: aav };
            let ab_ty = TypeId { v: abv };
            if !type_vars_unify(mut_view(*tv), ti, aa_ty, ab_ty) {
                ok = false;
            }
            i = i + 1;
        }
        return ok;
    }
    if ka == TY_FN && kb == TY_FN {
        let pca = unsafe { (*ta).param_count };
        let pcb = unsafe { (*tb).param_count };
        if pca != pcb {
            return false;
        }
        let reta = unsafe { (*ta).ret_type.v };
        let retb = unsafe { (*tb).ret_type.v };
        let reta_ty = TypeId { v: reta };
        let retb_ty = TypeId { v: retb };
        if !type_vars_unify(mut_view(*tv), ti, reta_ty, retb_ty) {
            return false;
        }
        let pa_ptr = unsafe { (*ta).param_types };
        let pb_ptr = unsafe { (*tb).param_types };
        let mut i: usize = 0;
        while (i < pca) {
            let pav = unsafe { (*typeid_at(pa_ptr, i)).v };
            let pbv = unsafe { (*typeid_at(pb_ptr, i)).v };
            let pa_ty = TypeId { v: pav };
            let pb_ty = TypeId { v: pbv };
            if !type_vars_unify(mut_view(*tv), ti, pa_ty, pb_ty) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    if ka == TY_CLOSURE && kb == TY_CLOSURE {
        let cida = unsafe { (*ta).closure_id };
        let cidb = unsafe { (*tb).closure_id };
        return cida == cidb;
    }
    false
}

pub fn subst_type_with_vars(
    ty: TypeId,
    args: view<GenericArgsSlice>,
    tv: mut_view<TypeVarTable>,
    ti: mut_view<TypeInterner>
) -> TypeId {
    let ty_v = ty.v;
    if ty_v == 0u32 {
        return TypeId { v: 0u32 };
    }
    let resolved = type_vars_resolve(mut_view(*tv), view(*ti), TypeId { v: ty_v });
    let res_v = resolved.v;
    if args.count == 0 || (args.args as usize) == 0 {
        return TypeId { v: res_v };
    }
    let t = type_get(view(*ti), TypeId { v: res_v });
    if (t as usize) == 0 {
        return TypeId { v: res_v };
    }
    let kind = unsafe { (*t).kind };
    if kind == TY_PARAM {
        let idx = unsafe { (*t).param_index as usize };
        if idx < args.count {
            let sub_v = unsafe { (*typeid_at(args.args, idx)).v };
            if sub_v != 0u32 {
                return TypeId { v: sub_v };
            }
        }
        return TypeId { v: res_v };
    }
    if kind == TY_PTR || kind == TY_VIEW || kind == TY_MUT_VIEW {
        let orig_pt_v = unsafe { (*t).pointee.v };
        let orig_pt = TypeId { v: orig_pt_v };
        let new_pt = subst_type_with_vars(orig_pt, args, mut_view(*tv), mut_view(*ti));
        let new_pt_v = new_pt.v;
        if new_pt_v == orig_pt_v {
            return TypeId { v: res_v };
        }
        let t_cur = type_get(view(*ti), TypeId { v: res_v });
        let sp = ti.scratch;
        unsafe {
            copy_ax_type_into(mut_view(*sp), view(*t_cur));
            (*sp).pointee.v = new_pt_v;
        }
        return intern_type(mut_view(*ti), unsafe { view(*sp) });
    }
    if kind == TY_ARRAY || kind == TY_SLICE {
        let orig_el_v = unsafe { (*t).elem.v };
        let orig_el = TypeId { v: orig_el_v };
        let new_el = subst_type_with_vars(orig_el, args, mut_view(*tv), mut_view(*ti));
        let new_el_v = new_el.v;
        if new_el_v == orig_el_v {
            return TypeId { v: res_v };
        }
        let t_cur = type_get(view(*ti), TypeId { v: res_v });
        let sp = ti.scratch;
        unsafe {
            copy_ax_type_into(mut_view(*sp), view(*t_cur));
            (*sp).elem.v = new_el_v;
        }
        return intern_type(mut_view(*ti), unsafe { view(*sp) });
    }
    if kind == TY_TUPLE {
        let fcnt = unsafe { (*t).field_count };
        if fcnt == 0 {
            return TypeId { v: res_v };
        }
        let orig_fields = unsafe { (*t).fields };
        let new_fields = unsafe {
            let fbytes = mul_usize(fcnt, size_of<TypeId>());
            arena_alloc_raw(mut_view(ti.arena), fbytes, align_of<TypeId>()) as *mut TypeId
        };
        let mut changed = false;
        let mut i: usize = 0;
        while (i < fcnt) {
            let of_v = unsafe { (*typeid_at(orig_fields, i)).v };
            let of_ty = TypeId { v: of_v };
            let nf = subst_type_with_vars(of_ty, args, mut_view(*tv), mut_view(*ti));
            let nf_v = nf.v;
            if nf_v != of_v {
                changed = true;
            }
            unsafe {
                (*typeid_at(new_fields, i)).v = nf_v;
            }
            i = i + 1;
        }
        if !changed {
            return TypeId { v: res_v };
        }
        let t_cur = type_get(view(*ti), TypeId { v: res_v });
        let sp = ti.scratch;
        unsafe {
            copy_ax_type_into(mut_view(*sp), view(*t_cur));
            (*sp).fields = new_fields;
        }
        return intern_type(mut_view(*ti), unsafe { view(*sp) });
    }
    if kind == TY_FN {
        let orig_ret_v = unsafe { (*t).ret_type.v };
        let orig_ret = TypeId { v: orig_ret_v };
        let new_ret = subst_type_with_vars(orig_ret, args, mut_view(*tv), mut_view(*ti));
        let new_ret_v = new_ret.v;
        let mut changed: bool = new_ret_v != orig_ret_v;
        let pcnt = unsafe { (*t).param_count };
        let mut new_params: *mut TypeId = 0 as *mut TypeId;
        if pcnt > 0 {
            let orig_params = unsafe { (*t).param_types };
            new_params = unsafe {
                let pbytes = mul_usize(pcnt, size_of<TypeId>());
                arena_alloc_raw(mut_view(ti.arena), pbytes, align_of<TypeId>()) as *mut TypeId
            };
            let mut i: usize = 0;
            while (i < pcnt) {
                let op_v = unsafe { (*typeid_at(orig_params, i)).v };
                let op_ty = TypeId { v: op_v };
                let np = subst_type_with_vars(op_ty, args, mut_view(*tv), mut_view(*ti));
                let np_v = np.v;
                if np_v != op_v {
                    changed = true;
                }
                unsafe {
                    (*typeid_at(new_params, i)).v = np_v;
                }
                i = i + 1;
            }
        }
        if !changed {
            return TypeId { v: res_v };
        }
        let t_cur = type_get(view(*ti), TypeId { v: res_v });
        let sp = ti.scratch;
        unsafe {
            copy_ax_type_into(mut_view(*sp), view(*t_cur));
            (*sp).ret_type.v = new_ret_v;
            (*sp).param_types = new_params;
        }
        return intern_type(mut_view(*ti), unsafe { view(*sp) });
    }
    if kind == TY_STRUCT {
        let mut changed = false;
        let acnt = unsafe { (*t).arg_count };
        let mut new_args: *mut TypeId = 0 as *mut TypeId;
        if acnt > 0 {
            let orig_args = unsafe { (*t).args };
            new_args = unsafe {
                let abytes = mul_usize(acnt, size_of<TypeId>());
                arena_alloc_raw(mut_view(ti.arena), abytes, align_of<TypeId>()) as *mut TypeId
            };
            let mut i: usize = 0;
            while (i < acnt) {
                let oa_v = unsafe { (*typeid_at(orig_args, i)).v };
                let oa_ty = TypeId { v: oa_v };
                let na = subst_type_with_vars(oa_ty, args, mut_view(*tv), mut_view(*ti));
                let na_v = na.v;
                if na_v != oa_v {
                    changed = true;
                }
                unsafe {
                    (*typeid_at(new_args, i)).v = na_v;
                }
                i = i + 1;
            }
        }
        let fcnt = unsafe { (*t).field_count };
        let mut new_fields: *mut TypeId = 0 as *mut TypeId;
        if fcnt > 0 {
            let orig_fields = unsafe { (*t).fields };
            new_fields = unsafe {
                let fbytes = mul_usize(fcnt, size_of<TypeId>());
                arena_alloc_raw(mut_view(ti.arena), fbytes, align_of<TypeId>()) as *mut TypeId
            };
            let mut i: usize = 0;
            while (i < fcnt) {
                let of_v = unsafe { (*typeid_at(orig_fields, i)).v };
                let of_ty = TypeId { v: of_v };
                let nf = subst_type_with_vars(of_ty, args, mut_view(*tv), mut_view(*ti));
                let nf_v = nf.v;
                if nf_v != of_v {
                    changed = true;
                }
                unsafe {
                    (*typeid_at(new_fields, i)).v = nf_v;
                }
                i = i + 1;
            }
        }
        if !changed {
            return TypeId { v: res_v };
        }
        let t_cur = type_get(view(*ti), TypeId { v: res_v });
        let sp = ti.scratch;
        unsafe {
            copy_ax_type_into(mut_view(*sp), view(*t_cur));
            if (new_args as usize) != 0 {
                (*sp).args = new_args;
            }
            if (new_fields as usize) != 0 {
                (*sp).fields = new_fields;
            }
        }
        return intern_type(mut_view(*ti), unsafe { view(*sp) });
    }
    if kind == TY_ENUM {
        let mut changed = false;
        let acnt = unsafe { (*t).arg_count };
        let mut new_args: *mut TypeId = 0 as *mut TypeId;
        if acnt > 0 {
            let orig_args = unsafe { (*t).args };
            new_args = unsafe {
                let abytes = mul_usize(acnt, size_of<TypeId>());
                arena_alloc_raw(mut_view(ti.arena), abytes, align_of<TypeId>()) as *mut TypeId
            };
            let mut i: usize = 0;
            while (i < acnt) {
                let oa_v = unsafe { (*typeid_at(orig_args, i)).v };
                let oa_ty = TypeId { v: oa_v };
                let na = subst_type_with_vars(oa_ty, args, mut_view(*tv), mut_view(*ti));
                let na_v = na.v;
                if na_v != oa_v {
                    changed = true;
                }
                unsafe {
                    (*typeid_at(new_args, i)).v = na_v;
                }
                i = i + 1;
            }
        }
        let vcnt = unsafe { (*t).variant_count };
        let vcounts = unsafe { (*t).variant_field_counts };
        let orig_vfields = unsafe { (*t).variant_fields };
        let mut new_vfields: *mut *mut TypeId = 0 as *mut *mut TypeId;
        if vcnt > 0 && (vcounts as usize) != 0 && (orig_vfields as usize) != 0 {
            new_vfields = unsafe {
                let vfbytes = mul_usize(vcnt, size_of<*mut TypeId>());
                arena_alloc_raw(mut_view(ti.arena), vfbytes, align_of<*mut TypeId>()) as *mut *mut TypeId
            };
            let mut v: usize = 0;
            while (v < vcnt) {
                let fc = unsafe { *usize_at(vcounts, v) };
                if fc > 0 {
                    let ovf = unsafe { *typeid_ptr_at(orig_vfields, v) };
                    let nvf = unsafe {
                        let fcbytes = mul_usize(fc, size_of<TypeId>());
                        arena_alloc_raw(mut_view(ti.arena), fcbytes, align_of<TypeId>()) as *mut TypeId
                    };
                    let mut i: usize = 0;
                    while (i < fc) {
                        let of_v = unsafe { (*typeid_at(ovf, i)).v };
                        let of_ty = TypeId { v: of_v };
                        let nf = subst_type_with_vars(of_ty, args, mut_view(*tv), mut_view(*ti));
                        let nf_v = nf.v;
                        if nf_v != of_v {
                            changed = true;
                        }
                        unsafe {
                            (*typeid_at(nvf, i)).v = nf_v;
                        }
                        i = i + 1;
                    }
                    unsafe {
                        *typeid_ptr_at(new_vfields, v) = nvf;
                    }
                } else {
                    unsafe {
                        *typeid_ptr_at(new_vfields, v) = 0 as *mut TypeId;
                    }
                }
                v = v + 1;
            }
        }
        if !changed {
            return TypeId { v: res_v };
        }
        let t_cur = type_get(view(*ti), TypeId { v: res_v });
        let sp = ti.scratch;
        unsafe {
            copy_ax_type_into(mut_view(*sp), view(*t_cur));
            if (new_args as usize) != 0 {
                (*sp).args = new_args;
            }
            if (new_vfields as usize) != 0 {
                (*sp).variant_fields = new_vfields;
            }
        }
        return intern_type(mut_view(*ti), unsafe { view(*sp) });
    }
    TypeId { v: res_v }
}

pub fn subst_type(
    ty: TypeId,
    args: view<GenericArgsSlice>,
    ti: mut_view<TypeInterner>
) -> TypeId {
    let mut empty_tv = TypeVarTable {
        items: 0 as *mut TypeVarEntry,
        len: 0,
        cap: 0,
        fn_var_start: 0,
    };
    subst_type_with_vars(TypeId { v: ty.v }, args, mut_view(empty_tv), mut_view(*ti))
}


const ALIGN_1: u32 = 1u32;
const ALIGN_2: u32 = 2u32;
const ALIGN_4: u32 = 4u32;
const ALIGN_8: u32 = 8u32;
const SIZE_0: u32 = 0u32;
const SIZE_1: u32 = 1u32;
const SIZE_2: u32 = 2u32;
const SIZE_4: u32 = 4u32;
const SIZE_8: u32 = 8u32;
const SIZE_16: u32 = 16u32;

pub struct Layout {
    pub size: u32,
    pub align: u32,
}

struct FieldLayout {
    pub index: u32,
    pub size: u32,
    pub align: u32,
}

unsafe fn field_layout_at(base: *mut FieldLayout, idx: usize) -> *mut FieldLayout {
    let off = ((idx as isize) * (size_of<FieldLayout>() as isize)) as usize;
    ((base as usize) + off) as *mut FieldLayout
}

fn align_up_u32(offset: u32, align: u32) -> u32 {
    if (align <= 1u32) {
        return offset;
    }
    let mask = align - 1u32;
    (offset + mask) & (0xFFFFFFFFu32 ^ mask)
}

fn field_comes_before(a: view<FieldLayout>, b: view<FieldLayout>) -> bool {
    if a.align != b.align {
        return a.align > b.align;
    }
    if a.size != b.size {
        return a.size > b.size;
    }
    let ai = a.index;
    let bi = b.index;
    ai < bi
}

fn sort_fields(fl: *mut FieldLayout, count: usize) {
    let mut i: usize = 1;
    while (i < count) {
        let cur_p = unsafe { field_layout_at(fl, i) };
        let cur_index = unsafe { (*cur_p).index };
        let cur_size = unsafe { (*cur_p).size };
        let cur_align = unsafe { (*cur_p).align };
        let cur = FieldLayout {
            index: cur_index,
            size: cur_size,
            align: cur_align,
        };
        let mut j: usize = i;
        while (j > 0) {
            let prev_p = unsafe { field_layout_at(fl, j - 1) };
            let move_right = unsafe { field_comes_before(view(cur), view(*prev_p)) };
            if !move_right {
                break;
            }
            let dst_p = unsafe { field_layout_at(fl, j) };
            unsafe {
                (*dst_p).index = (*prev_p).index;
                (*dst_p).size = (*prev_p).size;
                (*dst_p).align = (*prev_p).align;
            }
            j = j - 1;
        }
        let target_p = unsafe { field_layout_at(fl, j) };
        unsafe {
            (*target_p).index = cur.index;
            (*target_p).size = cur.size;
            (*target_p).align = cur.align;
        }
        i = i + 1;
    }
}

pub fn type_align(id: TypeId, ti: view<TypeInterner>) -> u32 {
    if id.v == 0u32 {
        return ALIGN_1;
    }
    if id.v == ti.t_unit.v || id.v == ti.t_never.v {
        return ALIGN_1;
    }
    if id.v == ti.t_bool.v || id.v == ti.t_i8.v || id.v == ti.t_u8.v {
        return ALIGN_1;
    }
    if id.v == ti.t_i16.v || id.v == ti.t_u16.v {
        return ALIGN_2;
    }
    if id.v == ti.t_i32.v || id.v == ti.t_u32.v || id.v == ti.t_char.v {
        return ALIGN_4;
    }
    if id.v == ti.t_i64.v || id.v == ti.t_u64.v || id.v == ti.t_isize.v ||
        id.v == ti.t_usize.v || id.v == ti.t_str.v {
        return ALIGN_8;
    }

    let ty = type_get(ti, id);
    if (ty as usize) == 0 {
        return ALIGN_1;
    }
    let k = unsafe { (*ty).kind };
    if k == TY_BOOL || k == TY_I8 || k == TY_U8 {
        return ALIGN_1;
    }
    if k == TY_I16 || k == TY_U16 {
        return ALIGN_2;
    }
    if k == TY_I32 || k == TY_U32 || k == TY_CHAR || k == TY_INT_VAR {
        return ALIGN_4;
    }
    if k == TY_I64 || k == TY_U64 || k == TY_ISIZE || k == TY_USIZE {
        return ALIGN_8;
    }
    if k == TY_PTR || k == TY_FN || k == TY_VIEW || k == TY_MUT_VIEW || k == TY_PARAM {
        return ALIGN_8;
    }
    if k == TY_SLICE || k == TY_ARRAY {
        let elem_v = unsafe { (*ty).elem.v };
        return type_align(TypeId { v: elem_v }, ti);
    }
    if k == TY_ENUM {
        let mut max_align: u32 = ALIGN_4;
        let vcount = unsafe { (*ty).variant_count };
        let vcounts = unsafe { (*ty).variant_field_counts };
        let vfields = unsafe { (*ty).variant_fields };
        if (vcounts as usize) != 0 && (vfields as usize) != 0 {
            let mut i: usize = 0;
            while (i < vcount) {
                let count = unsafe { *usize_at(vcounts, i) };
                let vf = unsafe { *typeid_ptr_at(vfields, i) };
                let mut j: usize = 0;
                while (j < count) {
                    let fty_v = unsafe { (*typeid_at(vf, j)).v };
                    let a = type_align(TypeId { v: fty_v }, ti);
                    if a > max_align {
                        max_align = a;
                    }
                    j = j + 1;
                }
                i = i + 1;
            }
        }
        return max_align;
    }
    if k == TY_TUPLE || k == TY_STRUCT {
        let mut align: u32 = ALIGN_1;
        let count = unsafe { (*ty).field_count };
        let fields = unsafe { (*ty).fields };
        let mut i: usize = 0;
        while (i < count) {
            let fty_v = unsafe { (*typeid_at(fields, i)).v };
            let fa = type_align(TypeId { v: fty_v }, ti);
            if fa > align {
                align = fa;
            }
            i = i + 1;
        }
        return align;
    }
    if k == TY_CLOSURE {
        let mut align: u32 = ALIGN_8;
        let count = unsafe { (*ty).capture_count };
        let caps = unsafe { (*ty).captures };
        let mut i: usize = 0;
        while (i < count) {
            let cap = unsafe { capture_at(caps, i) };
            let cty_v = unsafe { (*cap).ty.v };
            let fa = type_align(TypeId { v: cty_v }, ti);
            if fa > align {
                align = fa;
            }
            i = i + 1;
        }
        return align;
    }
    ALIGN_1
}

pub fn type_size(id: TypeId, ti: view<TypeInterner>) -> u32 {
    if id.v == 0u32 {
        return SIZE_0;
    }
    if id.v == ti.t_unit.v || id.v == ti.t_never.v {
        return SIZE_0;
    }
    if id.v == ti.t_bool.v || id.v == ti.t_i8.v || id.v == ti.t_u8.v {
        return SIZE_1;
    }
    if id.v == ti.t_i16.v || id.v == ti.t_u16.v {
        return SIZE_2;
    }
    if id.v == ti.t_i32.v || id.v == ti.t_u32.v || id.v == ti.t_char.v {
        return SIZE_4;
    }
    if id.v == ti.t_i64.v || id.v == ti.t_u64.v || id.v == ti.t_isize.v || id.v == ti.t_usize.v {
        return SIZE_8;
    }
    if id.v == ti.t_str.v {
        return SIZE_16;
    }

    let ty = type_get(ti, id);
    if (ty as usize) == 0 {
        return SIZE_0;
    }
    let k = unsafe { (*ty).kind };
    if k == TY_BOOL || k == TY_I8 || k == TY_U8 {
        return SIZE_1;
    }
    if k == TY_I16 || k == TY_U16 {
        return SIZE_2;
    }
    if k == TY_I32 || k == TY_U32 || k == TY_CHAR || k == TY_INT_VAR {
        return SIZE_4;
    }
    if k == TY_I64 || k == TY_U64 || k == TY_ISIZE || k == TY_USIZE {
        return SIZE_8;
    }
    if k == TY_PTR || k == TY_FN || k == TY_PARAM {
        return SIZE_8;
    }
    if k == TY_VIEW || k == TY_MUT_VIEW {
        let pt_v = unsafe { (*ty).pointee.v };
        let pty = type_get(ti, TypeId { v: pt_v });
        let pk = unsafe { (*pty).kind };
        if pk == TY_SLICE {
            return SIZE_16;
        }
        return SIZE_8;
    }
    if k == TY_SLICE {
        return SIZE_0;
    }
    if k == TY_ARRAY {
        let elem_v = unsafe { (*ty).elem.v };
        let arr_len = unsafe { (*ty).array_len };
        let esz = type_size(TypeId { v: elem_v }, ti) as isize;
        return (esz * (arr_len as isize)) as u32;
    }
    if k == TY_ENUM {
        let mut max_align: u32 = ALIGN_4;
        let mut max_payload_size: u32 = SIZE_0;
        let vcount = unsafe { (*ty).variant_count };
        let vcounts = unsafe { (*ty).variant_field_counts };
        let vfields = unsafe { (*ty).variant_fields };
        if (vcounts as usize) != 0 && (vfields as usize) != 0 {
            let mut i: usize = 0;
            while (i < vcount) {
                let count = unsafe { *usize_at(vcounts, i) };
                if count > 0 {
                    let vf = unsafe { *typeid_ptr_at(vfields, i) };
                    let fl = unsafe {
                        let fbytes = mul_usize(count, size_of<FieldLayout>());
                        heap_alloc(fbytes, align_of<FieldLayout>()) as *mut FieldLayout
                    };
                    let mut j: usize = 0;
                    while (j < count) {
                        let fty_v = unsafe { (*typeid_at(vf, j)).v };
                        let fa = type_align(TypeId { v: fty_v }, ti);
                        let fs = type_size(TypeId { v: fty_v }, ti);
                        if fa > max_align {
                            max_align = fa;
                        }
                        let fp = unsafe { field_layout_at(fl, j) };
                        unsafe {
                            (*fp).index = j as u32;
                            (*fp).align = fa;
                            (*fp).size = fs;
                        }
                        j = j + 1;
                    }
                    sort_fields(fl, count);
                    let mut offset: u32 = 0u32;
                    let mut k_idx: usize = 0;
                    while (k_idx < count) {
                        let fp = unsafe { field_layout_at(fl, k_idx) };
                        let fa = unsafe { (*fp).align };
                        let fs = unsafe { (*fp).size };
                        offset = align_up_u32(offset, fa);
                        offset = offset + fs;
                        k_idx = k_idx + 1;
                    }
                    unsafe {
                        heap_free(
                            fl as *mut u8,
                            mul_usize(count, size_of<FieldLayout>()),
                            align_of<FieldLayout>()
                        );
                    }
                    if offset > max_payload_size {
                        max_payload_size = offset;
                    }
                }
                i = i + 1;
            }
        }
        let total_size = SIZE_4 + max_payload_size;
        return align_up_u32(total_size, max_align);
    }
    if k == TY_TUPLE || k == TY_STRUCT {
        let count = unsafe { (*ty).field_count };
        if count == 0 {
            return SIZE_0;
        }
        let fields = unsafe { (*ty).fields };
        let is_repr_c = unsafe { (*ty).is_repr_c };
        let fl = unsafe {
            heap_alloc(mul_usize(count, size_of<FieldLayout>()), align_of<FieldLayout>()) as *mut FieldLayout
        };
        let mut max_align: u32 = ALIGN_1;
        let mut i: usize = 0;
        while (i < count) {
            let fty_v = unsafe { (*typeid_at(fields, i)).v };
            let fa = type_align(TypeId { v: fty_v }, ti);
            let fs = type_size(TypeId { v: fty_v }, ti);
            if fa > max_align {
                max_align = fa;
            }
            let fp = unsafe { field_layout_at(fl, i) };
            unsafe {
                (*fp).index = i as u32;
                (*fp).align = fa;
                (*fp).size = fs;
            }
            i = i + 1;
        }
        if k == TY_TUPLE || !is_repr_c {
            sort_fields(fl, count);
        }
        let mut offset: u32 = 0u32;
        let mut j: usize = 0;
        while (j < count) {
            let fp = unsafe { field_layout_at(fl, j) };
            let fa = unsafe { (*fp).align };
            let fs = unsafe { (*fp).size };
            offset = align_up_u32(offset, fa);
            offset = offset + fs;
            j = j + 1;
        }
        unsafe {
            heap_free(fl as *mut u8, mul_usize(count, size_of<FieldLayout>()), align_of<FieldLayout>());
        }
        return align_up_u32(offset, max_align);
    }
    if k == TY_CLOSURE {
        let mut offset: u32 = SIZE_8;
        let mut max_align: u32 = ALIGN_8;
        let count = unsafe { (*ty).capture_count };
        let caps = unsafe { (*ty).captures };
        let mut i: usize = 0;
        while (i < count) {
            let cap = unsafe { capture_at(caps, i) };
            let cty_v = unsafe { (*cap).ty.v };
            let a = type_align(TypeId { v: cty_v }, ti);
            let s = type_size(TypeId { v: cty_v }, ti);
            if a > max_align {
                max_align = a;
            }
            offset = align_up_u32(offset, a);
            offset = offset + s;
            i = i + 1;
        }
        return align_up_u32(offset, max_align);
    }
    SIZE_0
}

pub fn type_layout(id: TypeId, ti: view<TypeInterner>) -> Layout {
    let id_v = id.v;
    Layout {
        size: type_size(TypeId { v: id_v }, ti),
        align: type_align(TypeId { v: id_v }, ti),
    }
}

pub fn type_field_offset(id: TypeId, field_idx: usize, ti: view<TypeInterner>) -> u32 {
    let ty = type_get(ti, id);
    if (ty as usize) == 0 {
        return 0u32;
    }
    let k = unsafe { (*ty).kind };
    if k == TY_TUPLE || k == TY_STRUCT {
        let count = unsafe { (*ty).field_count };
        if field_idx >= count {
            return 0u32;
        }
        let fields = unsafe { (*ty).fields };
        let is_repr_c = unsafe { (*ty).is_repr_c };
        let fl = unsafe {
            heap_alloc(mul_usize(count, size_of<FieldLayout>()), align_of<FieldLayout>()) as *mut FieldLayout
        };
        let mut i: usize = 0;
        while (i < count) {
            let fty_v = unsafe { (*typeid_at(fields, i)).v };
            let fa = type_align(TypeId { v: fty_v }, ti);
            let fs = type_size(TypeId { v: fty_v }, ti);
            let fp = unsafe { field_layout_at(fl, i) };
            unsafe {
                (*fp).index = i as u32;
                (*fp).align = fa;
                (*fp).size = fs;
            }
            i = i + 1;
        }
        if k == TY_TUPLE || !is_repr_c {
            sort_fields(fl, count);
        }
        let mut offset: u32 = 0u32;
        let mut target_offset: u32 = 0u32;
        let mut j: usize = 0;
        while (j < count) {
            let fp = unsafe { field_layout_at(fl, j) };
            let f_index = unsafe { (*fp).index };
            let fa = unsafe { (*fp).align };
            let fs = unsafe { (*fp).size };
            offset = align_up_u32(offset, fa);
            if (f_index as usize) == field_idx {
                target_offset = offset;
                break;
            }
            offset = offset + fs;
            j = j + 1;
        }
        unsafe {
            heap_free(fl as *mut u8, mul_usize(count, size_of<FieldLayout>()), align_of<FieldLayout>());
        }
        return target_offset;
    }
    if k == TY_CLOSURE {
        if field_idx == 0 {
            return 0u32;
        }
        let count = unsafe { (*ty).capture_count };
        if field_idx > count {
            return 0u32;
        }
        let caps = unsafe { (*ty).captures };
        let mut offset: u32 = SIZE_8;
        let mut i: usize = 0;
        while (i < count) {
            let cap = unsafe { capture_at(caps, i) };
            let cty_v = unsafe { (*cap).ty.v };
            let a = type_align(TypeId { v: cty_v }, ti);
            let s = type_size(TypeId { v: cty_v }, ti);
            offset = align_up_u32(offset, a);
            if field_idx == i + 1 {
                return offset;
            }
            offset = offset + s;
            i = i + 1;
        }
        return offset;
    }
    0u32
}

pub fn type_enum_field_offset(
    id: TypeId,
    variant_idx: u32,
    field_idx: usize,
    ti: view<TypeInterner>
) -> u32 {
    let ty = type_get(ti, id);
    if (ty as usize) == 0 {
        return 0u32;
    }
    let k = unsafe { (*ty).kind };
    if k != TY_ENUM {
        return 0u32;
    }
    let vcount = unsafe { (*ty).variant_count };
    if (variant_idx as usize) >= vcount {
        return 0u32;
    }
    let vcounts = unsafe { (*ty).variant_field_counts };
    let vfields = unsafe { (*ty).variant_fields };
    if (vcounts as usize) == 0 || (vfields as usize) == 0 {
        return 0u32;
    }
    let count = unsafe { *usize_at(vcounts, variant_idx as usize) };
    if field_idx >= count {
        return 0u32;
    }
    let vf = unsafe { *typeid_ptr_at(vfields, variant_idx as usize) };
    let fl = unsafe {
        heap_alloc(mul_usize(count, size_of<FieldLayout>()), align_of<FieldLayout>()) as *mut FieldLayout
    };
    let mut i: usize = 0;
    while (i < count) {
        let fty_v = unsafe { (*typeid_at(vf, i)).v };
        let fa = type_align(TypeId { v: fty_v }, ti);
        let fs = type_size(TypeId { v: fty_v }, ti);
        let fp = unsafe { field_layout_at(fl, i) };
        unsafe {
            (*fp).index = i as u32;
            (*fp).align = fa;
            (*fp).size = fs;
        }
        i = i + 1;
    }
    sort_fields(fl, count);
    let mut offset: u32 = SIZE_4;
    let mut target_offset: u32 = 0u32;
    let mut j: usize = 0;
    while (j < count) {
        let fp = unsafe { field_layout_at(fl, j) };
        let f_index = unsafe { (*fp).index };
        let fa = unsafe { (*fp).align };
        let fs = unsafe { (*fp).size };
        offset = align_up_u32(offset, fa);
        if (f_index as usize) == field_idx {
            target_offset = offset;
            break;
        }
        offset = offset + fs;
        j = j + 1;
    }
    unsafe {
        heap_free(fl as *mut u8, mul_usize(count, size_of<FieldLayout>()), align_of<FieldLayout>());
    }
    target_offset
}



// --- compiler.source.manager (subset for exhaustiveness) ---
pub struct SourceFile {
    pub id: FileId,
    pub canonical_path: StrView,
    pub text: StrView,
    pub content_hash: u64,
    pub line_offsets: *mut u32,
    pub line_count: usize,
    pub line_cap: usize,
    pub alloc_ptr: *mut u8,
    pub alloc_size: usize,
    pub has_invalid_utf8: bool,
}

unsafe fn source_file_at(files: *mut SourceFile, idx: usize) -> *mut SourceFile {
    ((files as usize) + mul_usize(idx, size_of<SourceFile>())) as *mut SourceFile
}

pub struct SourceDatabase {
    pub arena: Arena,
    pub files: *mut SourceFile,
    pub files_count: usize,
    pub files_cap: usize,
}

pub fn source_db_init(db: mut_view<SourceDatabase>) {
    db.arena.head = 0 as *mut ArenaChunk;
    db.files = 0 as *mut SourceFile;
    db.files_count = 0;
    db.files_cap = 0;
}

pub fn source_db_free(db: mut_view<SourceDatabase>) {
    if db.files_cap > 0 && (db.files as usize) != 0 {
        unsafe {
            heap_free(db.files as *mut u8, mul_usize(db.files_cap, size_of<SourceFile>()), align_of<SourceFile>());
        }
    }
    db.files = 0 as *mut SourceFile;
    db.files_count = 0;
    db.files_cap = 0;
    arena_destroy(mut_view(db.arena));
}

pub fn source_db_add_virtual(
    db: mut_view<SourceDatabase>,
    identity_ptr: *const u8,
    identity_len: usize,
    text_ptr: *const u8,
    text_len: usize
) -> FileId {
    let path_copy = arena_alloc_raw(mut_view(db.arena), identity_len + 1, 1);
    if identity_len > 0 && (identity_ptr as usize) != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(identity_ptr, path_copy, identity_len);
            *(path_copy + identity_len) = 0u8;
        }
    }
    let text_copy = arena_alloc_raw(mut_view(db.arena), text_len + 1, 1);
    if text_len > 0 && (text_ptr as usize) != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(text_ptr, text_copy, text_len);
            *(text_copy + text_len) = 0u8;
        }
    }
    let new_id_v = (db.files_count + 1) as u32;
    if db.files_count == db.files_cap {
        let new_cap = if db.files_cap == 0 { 8 } else { db.files_cap + db.files_cap };
        let new_files = unsafe {
            heap_alloc(mul_usize(new_cap, size_of<SourceFile>()), align_of<SourceFile>()) as *mut SourceFile
        };
        if db.files_count > 0 && (db.files as usize) != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(
                    db.files as *const u8,
                    new_files as *mut u8,
                    mul_usize(db.files_count, size_of<SourceFile>())
                );
                heap_free(db.files as *mut u8, mul_usize(db.files_cap, size_of<SourceFile>()), align_of<SourceFile>());
            }
        }
        db.files = new_files;
        db.files_cap = new_cap;
    }
    let dst_sf = unsafe { source_file_at(db.files, db.files_count) };
    unsafe {
        (*dst_sf).id.v = new_id_v;
        (*dst_sf).canonical_path.ptr = path_copy as *const u8;
        (*dst_sf).canonical_path.len = identity_len;
        (*dst_sf).text.ptr = text_copy as *const u8;
        (*dst_sf).text.len = text_len;
        (*dst_sf).content_hash = 0u64;
        (*dst_sf).line_offsets = 0 as *mut u32;
        (*dst_sf).line_count = 0;
        (*dst_sf).line_cap = 0;
        (*dst_sf).alloc_ptr = 0 as *mut u8;
        (*dst_sf).alloc_size = 0;
        (*dst_sf).has_invalid_utf8 = false;
    }
    db.files_count = db.files_count + 1;
    FileId { v: new_id_v }
}

pub fn source_db_text(db: view<SourceDatabase>, file: FileId) -> StrView {
    if file.v == 0u32 || (file.v as usize) > db.files_count {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let sf = unsafe { source_file_at(db.files, (file.v - 1u32) as usize) };
    let t_ptr = unsafe { (*sf).text.ptr };
    let t_len = unsafe { (*sf).text.len };
    StrView { ptr: t_ptr, len: t_len }
}

// --- compiler.types.exhaust ---
// Pattern Match Exhaustiveness and Unreachability Checker.
// Port of bootstrap/axiom0/src/types/match/exhaust.c.



const EXHAUST_UNREACHABLE_MSG: [19]u8 = [117u8, 110u8, 114u8, 101u8, 97u8, 99u8, 104u8, 97u8, 98u8, 108u8, 101u8, 32u8, 112u8, 97u8, 116u8, 116u8, 101u8, 114u8, 110u8];
const EXHAUST_NON_EXHAUSTIVE_MSG: [51]u8 = [110u8, 111u8, 110u8, 45u8, 101u8, 120u8, 104u8, 97u8, 117u8, 115u8, 116u8, 105u8, 118u8, 101u8, 32u8, 112u8, 97u8, 116u8, 116u8, 101u8, 114u8, 110u8, 115u8, 58u8, 32u8, 109u8, 97u8, 116u8, 99u8, 104u8, 32u8, 109u8, 117u8, 115u8, 116u8, 32u8, 99u8, 111u8, 118u8, 101u8, 114u8, 32u8, 97u8, 108u8, 108u8, 32u8, 99u8, 97u8, 115u8, 101u8, 115u8];

@derive(Copy)
pub struct PatInterval {
    pub start: i64,
    pub end: i64,
}

unsafe fn pat_interval_at(base: *const PatInterval, idx: usize) -> *const PatInterval {
    ((base as usize) + mul_usize(idx, size_of<PatInterval>())) as *const PatInterval
}

unsafe fn pat_interval_at_mut(base: *mut PatInterval, idx: usize) -> *mut PatInterval {
    ((base as usize) + mul_usize(idx, size_of<PatInterval>())) as *mut PatInterval
}

fn exhaust_bytes_eq(a: *const u8, b: *const u8, n: usize) -> bool {
    if (a as usize) == (b as usize) {
        return true;
    }
    if (a as usize) == 0 || (b as usize) == 0 {
        return false;
    }
    let mut i: usize = 0;
    while (i < n) {
        let ba = unsafe { *(a + i) };
        let bb = unsafe { *(b + i) };
        if ba != bb {
            return false;
        }
        i = i + 1;
    }
    true
}

fn emit_pat_unreachable(sink: mut_view<DiagSink>, file_v: u32, start: u32, end: u32) {
    let code = DiagCode { v: AX_PAT_UNREACHABLE };
    let buf = arena_alloc_raw(mut_view(sink.arena), 20, 1);
    let mut i: usize = 0;
    while (i < 19) {
        unsafe { *(buf + i) = EXHAUST_UNREACHABLE_MSG[i]; }
        i = i + 1;
    }
    unsafe { *(buf + 19) = 0u8; }
    let d = Diagnostic {
        code: code,
        severity: DiagSeverity.Warning,
        message: StrView { ptr: buf as *const u8, len: 19 },
        primary: Span { file: FileId { v: file_v }, start: start, end: end },
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    diag_sink_report(sink, view(d));
}

fn emit_pat_non_exhaustive(sink: mut_view<DiagSink>, file_v: u32, start: u32, end: u32) {
    let code = DiagCode { v: AX_PAT_NON_EXHAUSTIVE };
    let buf = arena_alloc_raw(mut_view(sink.arena), 52, 1);
    let mut i: usize = 0;
    while (i < 51) {
        unsafe { *(buf + i) = EXHAUST_NON_EXHAUSTIVE_MSG[i]; }
        i = i + 1;
    }
    unsafe { *(buf + 51) = 0u8; }
    let d = Diagnostic {
        code: code,
        severity: DiagSeverity.Error,
        message: StrView { ptr: buf as *const u8, len: 51 },
        primary: Span { file: FileId { v: file_v }, start: start, end: end },
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    diag_sink_report(sink, view(d));
}

pub fn get_pat_interval(pat: *const HirPat, out: mut_view<PatInterval>) -> bool {
    if (pat as usize) == 0 {
        return false;
    }
    let pk = unsafe { (*pat).kind };
    if pk == HIR_PAT_LITERAL {
        let tk = unsafe { (*pat).tok.kind };
        if tk == TOK_INT || tk == TOK_CHAR {
            let mut val: i64 = 0i64;
            if tk == TOK_CHAR {
                let cv = unsafe { (*pat).tok.char_val };
                let iv = unsafe { (*pat).tok.int_val };
                val = if cv != 0u32 { cv as i64 } else { iv as i64 };
            } else {
                val = (unsafe { (*pat).tok.int_val }) as i64;
            }
            if unsafe { (*pat).is_negated } {
                val = 0i64 - val;
            }
            out.start = val;
            out.end = val;
            return true;
        }
        return false;
    }
    if pk == HIR_PAT_RANGE {
        let mut s = PatInterval { start: 0i64, end: 0i64 };
        let mut e = PatInterval { start: 0i64, end: 0i64 };
        let sp = unsafe { (*pat).start_pat as *const HirPat };
        let ep = unsafe { (*pat).end_pat as *const HirPat };
        let ok_s = get_pat_interval(sp, mut_view(s));
        let ok_e = get_pat_interval(ep, mut_view(e));
        if ok_s && ok_e {
            out.start = s.start;
            out.end = if unsafe { (*pat).is_inclusive } { e.start } else { e.start - 1i64 };
            return true;
        }
        return false;
    }
    false
}

fn is_int_or_char_kind(tk: u8) -> bool {
    tk == TY_I8 || tk == TY_I16 || tk == TY_I32 || tk == TY_I64 || tk == TY_ISIZE ||
    tk == TY_U8 || tk == TY_U16 || tk == TY_U32 || tk == TY_U64 || tk == TY_USIZE ||
    tk == TY_CHAR
}

pub fn match_check_exhaustiveness(
    thir: mut_view<Thir>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    sink: mut_view<DiagSink>,
    expr: *const HirExpr,
    val_ty: TypeId
) {
    if (expr as usize) == 0 {
        return;
    }
    if (unsafe { (*expr).kind }) != HIR_EXPR_MATCH {
        return;
    }

    let expr_file_v = unsafe { (*expr).span.file.v };
    let expr_start = unsafe { (*expr).span.start };
    let expr_end = unsafe { (*expr).span.end };

    let mut has_unconditional_wildcard = false;
    let mut arm = unsafe { (*expr).arms as *const HirMatchArm };
    while ((arm as usize) != 0) {
        let has_guard = (unsafe { (*arm).guard as usize }) != 0;
        let ap = unsafe { (*arm).pat as *const HirPat };
        if !has_guard && (ap as usize) != 0 {
            let pk = unsafe { (*ap).kind };
            if pk == HIR_PAT_WILDCARD || pk == HIR_PAT_BINDING {
                has_unconditional_wildcard = true;
                let mut unreach = unsafe { (*arm).next as *const HirMatchArm };
                while ((unreach as usize) != 0) {
                    let up = unsafe { (*unreach).pat as *const HirPat };
                    if (up as usize) != 0 {
                        let u_fv = unsafe { (*up).span.file.v };
                        let u_st = unsafe { (*up).span.start };
                        let u_en = unsafe { (*up).span.end };
                        emit_pat_unreachable(mut_view(*sink), u_fv, u_st, u_en);
                    }
                    unreach = unsafe { (*unreach).next as *const HirMatchArm };
                }
                break;
            }
        }
        arm = unsafe { (*arm).next as *const HirMatchArm };
    }

    let val_ty_v = val_ty.v;
    let t = type_get(view(thir.interner), TypeId { v: val_ty_v });
    if (t as usize) == 0 {
        return;
    }
    let tk = unsafe { (*t).kind };

    if is_int_or_char_kind(tk) {
        let cov_bytes = mul_usize(256, size_of<PatInterval>());
        let cov_raw = arena_alloc_raw(mut_view(thir.interner.arena), cov_bytes, align_of<PatInterval>());
        let covered = cov_raw as *mut PatInterval;
        let mut cov_count: usize = 0;

        let mut iarm = unsafe { (*expr).arms as *const HirMatchArm };
        while ((iarm as usize) != 0) {
            let ap = unsafe { (*iarm).pat as *const HirPat };
            let has_guard = (unsafe { (*iarm).guard as usize }) != 0;
            if (ap as usize) != 0 {
                let mut iv = PatInterval { start: 0i64, end: 0i64 };
                let got_iv = get_pat_interval(ap, mut_view(iv));
                if got_iv {
                    let mut is_cov = false;
                    let mut i: usize = 0;
                    while (i < cov_count) {
                        let ci = unsafe { pat_interval_at(covered as *const PatInterval, i) };
                        if iv.start >= (unsafe { (*ci).start }) && iv.end <= (unsafe { (*ci).end }) {
                            is_cov = true;
                            break;
                        }
                        i = i + 1;
                    }
                    if is_cov {
                        let a_fv = unsafe { (*ap).span.file.v };
                        let a_st = unsafe { (*ap).span.start };
                        let a_en = unsafe { (*ap).span.end };
                        emit_pat_unreachable(mut_view(*sink), a_fv, a_st, a_en);
                    } else if !has_guard && cov_count < 256 {
                        let dst = unsafe { pat_interval_at_mut(covered, cov_count) };
                        unsafe {
                            (*dst).start = iv.start;
                            (*dst).end = iv.end;
                        }
                        cov_count = cov_count + 1;
                    }
                } else if (unsafe { (*ap).kind }) == HIR_PAT_OR {
                    let mut p = unsafe { (*ap).pats as *const HirPat };
                    while ((p as usize) != 0) {
                        let got_piv = get_pat_interval(p, mut_view(iv));
                        if got_piv {
                            let mut is_cov = false;
                            let mut i: usize = 0;
                            while (i < cov_count) {
                                let ci = unsafe { pat_interval_at(covered as *const PatInterval, i) };
                                if iv.start >= (unsafe { (*ci).start }) && iv.end <= (unsafe { (*ci).end }) {
                                    is_cov = true;
                                    break;
                                }
                                i = i + 1;
                            }
                            if is_cov {
                                let p_fv = unsafe { (*p).span.file.v };
                                let p_st = unsafe { (*p).span.start };
                                let p_en = unsafe { (*p).span.end };
                                emit_pat_unreachable(mut_view(*sink), p_fv, p_st, p_en);
                            } else if !has_guard && cov_count < 256 {
                                let dst = unsafe { pat_interval_at_mut(covered, cov_count) };
                                unsafe {
                                    (*dst).start = iv.start;
                                    (*dst).end = iv.end;
                                }
                                cov_count = cov_count + 1;
                            }
                        }
                        p = unsafe { (*p).next as *const HirPat };
                    }
                }
            }
            iarm = unsafe { (*iarm).next as *const HirMatchArm };
        }

        if has_unconditional_wildcard {
            return;
        }
        if tk == TY_U8 {
            let mut all_u8 = true;
            let mut v: i64 = 0i64;
            while (v <= 255i64) {
                let mut found = false;
                let mut i: usize = 0;
                while (i < cov_count) {
                    let ci = unsafe { pat_interval_at(covered as *const PatInterval, i) };
                    if v >= (unsafe { (*ci).start }) && v <= (unsafe { (*ci).end }) {
                        found = true;
                        break;
                    }
                    i = i + 1;
                }
                if !found {
                    all_u8 = false;
                    break;
                }
                v = v + 1i64;
            }
            if all_u8 {
                return;
            }
        }

        emit_pat_non_exhaustive(mut_view(*sink), expr_file_v, expr_start, expr_end);
        return;
    }

    if tk == TY_BOOL {
        let mut has_true = false;
        let mut has_false = false;
        let mut barm = unsafe { (*expr).arms as *const HirMatchArm };
        while ((barm as usize) != 0) {
            let ap = unsafe { (*barm).pat as *const HirPat };
            let has_guard = (unsafe { (*barm).guard as usize }) != 0;
            if (ap as usize) != 0 && (unsafe { (*ap).kind }) == HIR_PAT_LITERAL {
                let tok_k = unsafe { (*ap).tok.kind };
                if tok_k == TOK_KW_TRUE {
                    if has_true {
                        let a_fv = unsafe { (*ap).span.file.v };
                        let a_st = unsafe { (*ap).span.start };
                        let a_en = unsafe { (*ap).span.end };
                        emit_pat_unreachable(mut_view(*sink), a_fv, a_st, a_en);
                    } else if !has_guard {
                        has_true = true;
                    }
                } else if tok_k == TOK_KW_FALSE {
                    if has_false {
                        let a_fv = unsafe { (*ap).span.file.v };
                        let a_st = unsafe { (*ap).span.start };
                        let a_en = unsafe { (*ap).span.end };
                        emit_pat_unreachable(mut_view(*sink), a_fv, a_st, a_en);
                    } else if !has_guard {
                        has_false = true;
                    }
                }
            }
            barm = unsafe { (*barm).next as *const HirMatchArm };
        }
        if has_unconditional_wildcard || (has_true && has_false) {
            return;
        }
        emit_pat_non_exhaustive(mut_view(*sink), expr_file_v, expr_start, expr_end);
        return;
    }

    if tk == TY_ENUM {
        let def = unsafe { (*t).def as *const HirItem };
        let count = unsafe { (*t).variant_count };
        let alloc_cnt = if count > 0 { count } else { 1 };
        let seen = arena_alloc_raw(mut_view(thir.interner.arena), alloc_cnt, 1);
        let mut z: usize = 0;
        while (z < count) {
            unsafe { *(seen + z) = 0u8; }
            z = z + 1;
        }

        let mut earm = unsafe { (*expr).arms as *const HirMatchArm };
        while ((earm as usize) != 0) {
            let ap = unsafe { (*earm).pat as *const HirPat };
            let has_guard = (unsafe { (*earm).guard as usize }) != 0;
            if (ap as usize) != 0 && (def as usize) != 0 {
                let apk = unsafe { (*ap).kind };
                if apk == HIR_PAT_PATH || apk == HIR_PAT_STRUCT {
                    let p_file_v = unsafe { (*ap).path.span.file.v };
                    let p_start = unsafe { (*ap).path.span.start };
                    let p_end = unsafe { (*ap).path.span.end };
                    let p_name_v = unsafe { (*ap).path.name.v };

                    let mut ptext_ptr: *const u8 = 0 as *const u8;
                    let mut ptext_len: usize = 0;
                    if p_file_v != 0u32 && (db.files as usize) != 0 {
                        let ftext = source_db_text(db, FileId { v: p_file_v });
                        if (ftext.ptr as usize) != 0 && p_start <= p_end && (p_end as usize) <= ftext.len {
                            ptext_ptr = ((ftext.ptr as usize) + (p_start as usize)) as *const u8;
                            ptext_len = (p_end - p_start) as usize;
                        }
                    }

                    let mut vname_ptr: *const u8 = ptext_ptr;
                    let mut vname_len: usize = ptext_len;
                    let mut ename_ptr: *const u8 = 0 as *const u8;
                    let mut ename_len: usize = 0;

                    let mut bi: usize = 0;
                    while (bi < ptext_len) {
                        if (unsafe { *(ptext_ptr + bi) }) == 46u8 {
                            ename_ptr = ptext_ptr;
                            ename_len = bi;
                            vname_ptr = unsafe { ptext_ptr + (bi + 1) };
                            vname_len = ptext_len - bi - 1;
                        }
                        bi = bi + 1;
                    }

                    if vname_len == 0 && p_name_v != 0u32 {
                        let nv = interner_get(str_in, StrId { v: p_name_v });
                        vname_ptr = nv.ptr;
                        vname_len = nv.len;
                    }

                    let def_name_v = unsafe { (*def).name.v };
                    let mut v = unsafe { (*def).variants as *const HirVariantDecl };
                    let mut vidx: usize = 0;
                    while ((v as usize) != 0 && vidx < count) {
                        let v_name_v = unsafe { (*v).name.v };
                        let var_name = interner_get(str_in, StrId { v: v_name_v });
                        let mut enum_matches = true;
                        if ename_len > 0 && def_name_v != 0u32 {
                            let def_name = interner_get(str_in, StrId { v: def_name_v });
                            if def_name.len != ename_len || !exhaust_bytes_eq(def_name.ptr, ename_ptr, ename_len) {
                                enum_matches = false;
                            }
                        }
                        if enum_matches && var_name.len == vname_len && exhaust_bytes_eq(var_name.ptr, vname_ptr, vname_len) {
                            if (unsafe { *(seen + vidx) }) != 0u8 {
                                let a_fv = unsafe { (*ap).span.file.v };
                                let a_st = unsafe { (*ap).span.start };
                                let a_en = unsafe { (*ap).span.end };
                                emit_pat_unreachable(mut_view(*sink), a_fv, a_st, a_en);
                            } else if !has_guard {
                                unsafe { *(seen + vidx) = 1u8; }
                            }
                            break;
                        }
                        v = unsafe { (*v).next as *const HirVariantDecl };
                        vidx = vidx + 1;
                    }
                }
            }
            earm = unsafe { (*earm).next as *const HirMatchArm };
        }

        if has_unconditional_wildcard {
            return;
        }
        let mut all_seen = true;
        let mut si: usize = 0;
        while (si < count) {
            if (unsafe { *(seen + si) }) == 0u8 {
                all_seen = false;
                break;
            }
            si = si + 1;
        }
        if !all_seen {
            emit_pat_non_exhaustive(mut_view(*sink), expr_file_v, expr_start, expr_end);
        }
        return;
    }

    if has_unconditional_wildcard {
        return;
    }
    emit_pat_non_exhaustive(mut_view(*sink), expr_file_v, expr_start, expr_end);
}

const TEST_SRC_BYTES: [42]u8 = [67u8, 111u8, 108u8, 111u8, 114u8, 46u8, 82u8, 101u8, 100u8, 32u8, 67u8, 111u8, 108u8, 111u8, 114u8, 46u8, 71u8, 114u8, 101u8, 101u8, 110u8, 32u8, 67u8, 111u8, 108u8, 111u8, 114u8, 46u8, 66u8, 108u8, 117u8, 101u8, 32u8, 79u8, 116u8, 104u8, 101u8, 114u8, 46u8, 82u8, 101u8, 100u8];
const TEST_PATH_BYTES: [12]u8 = [116u8, 101u8, 115u8, 116u8, 95u8, 101u8, 110u8, 117u8, 109u8, 46u8, 97u8, 120u8];
const STR_COLOR: [5]u8 = [67u8, 111u8, 108u8, 111u8, 114u8];
const STR_RED: [3]u8 = [82u8, 101u8, 100u8];
const STR_GREEN: [5]u8 = [71u8, 114u8, 101u8, 101u8, 110u8];
const STR_BLUE: [4]u8 = [66u8, 108u8, 117u8, 101u8];

fn assert_true(cond: bool, code: i32) {
    if !cond {
        exit(code);
    }
}

fn make_int_pat(arena: mut_view<Arena>, val: u64, negated: bool, start_off: u32) -> *mut HirPat {
    let sp = Span { file: FileId { v: 1u32 }, start: start_off, end: start_off + 2u32 };
    let p = hir_alloc_pat(arena, HIR_PAT_LITERAL, sp);
    unsafe {
        (*p).tok.kind = TOK_INT;
        (*p).tok.int_val = val;
        (*p).is_negated = negated;
    }
    p
}

fn make_char_pat(arena: mut_view<Arena>, ch: u32, start_off: u32) -> *mut HirPat {
    let sp = Span { file: FileId { v: 1u32 }, start: start_off, end: start_off + 3u32 };
    let p = hir_alloc_pat(arena, HIR_PAT_LITERAL, sp);
    unsafe {
        (*p).tok.kind = TOK_CHAR;
        (*p).tok.char_val = ch;
        (*p).tok.int_val = 0u64;
    }
    p
}

fn make_bool_pat(arena: mut_view<Arena>, is_true: bool, start_off: u32) -> *mut HirPat {
    let sp = Span { file: FileId { v: 1u32 }, start: start_off, end: start_off + 4u32 };
    let p = hir_alloc_pat(arena, HIR_PAT_LITERAL, sp);
    unsafe {
        (*p).tok.kind = if is_true { TOK_KW_TRUE } else { TOK_KW_FALSE };
    }
    p
}

fn make_range_pat(arena: mut_view<Arena>, s: *mut HirPat, e: *mut HirPat, inclusive: bool, start_off: u32) -> *mut HirPat {
    let sp = Span { file: FileId { v: 1u32 }, start: start_off, end: start_off + 6u32 };
    let p = hir_alloc_pat(arena, HIR_PAT_RANGE, sp);
    unsafe {
        (*p).start_pat = s;
        (*p).end_pat = e;
        (*p).is_inclusive = inclusive;
    }
    p
}

fn make_wildcard_pat(arena: mut_view<Arena>, start_off: u32) -> *mut HirPat {
    let sp = Span { file: FileId { v: 1u32 }, start: start_off, end: start_off + 1u32 };
    hir_alloc_pat(arena, HIR_PAT_WILDCARD, sp)
}

fn make_binding_pat(arena: mut_view<Arena>, sym_v: u32, start_off: u32) -> *mut HirPat {
    let sp = Span { file: FileId { v: 1u32 }, start: start_off, end: start_off + 2u32 };
    let p = hir_alloc_pat(arena, HIR_PAT_BINDING, sp);
    unsafe {
        (*p).symbol.v = sym_v;
    }
    p
}

fn make_arm(arena: mut_view<Arena>, pat: *mut HirPat, guard: *mut HirExpr, start_off: u32) -> *mut HirMatchArm {
    let sp = Span { file: FileId { v: 1u32 }, start: start_off, end: start_off + 5u32 };
    let arm = hir_alloc_match_arm(arena, sp);
    unsafe {
        (*arm).pat = pat;
        (*arm).guard = guard;
    }
    arm
}

fn make_match_expr(arena: mut_view<Arena>, arms: *mut HirMatchArm, start_off: u32) -> *mut HirExpr {
    let sp = Span { file: FileId { v: 1u32 }, start: start_off, end: start_off + 20u32 };
    let e = hir_alloc_expr(arena, HIR_EXPR_MATCH, sp);
    unsafe {
        (*e).arms = arms;
    }
    e
}

unsafe fn diag_at_const(diags: *mut Diagnostic, idx: usize) -> *const Diagnostic {
    ((diags as usize) + mul_usize(idx, size_of<Diagnostic>())) as *const Diagnostic
}

pub fn run_exhaust_tests(
    arena: mut_view<Arena>,
    str_in: mut_view<StrInterner>,
    db: mut_view<SourceDatabase>,
    sink: mut_view<DiagSink>,
    thir: mut_view<Thir>
) {
    thir_init(mut_view(*thir));

    // 1. Test get_pat_interval on int literal, negated int literal, char literal, inclusive & exclusive ranges
    let p_pos = make_int_pat(mut_view(*arena), 42u64, false, 10u32);
    let p_neg = make_int_pat(mut_view(*arena), 15u64, true, 20u32);
    let p_chr = make_char_pat(mut_view(*arena), 65u32, 30u32);
    let mut iv = PatInterval { start: 0i64, end: 0i64 };

    assert_true(get_pat_interval(p_pos as *const HirPat, mut_view(iv)), 1);
    assert_true(iv.start == 42i64 && iv.end == 42i64, 2);

    assert_true(get_pat_interval(p_neg as *const HirPat, mut_view(iv)), 3);
    assert_true(iv.start == -15i64 && iv.end == -15i64, 4);

    assert_true(get_pat_interval(p_chr as *const HirPat, mut_view(iv)), 5);
    assert_true(iv.start == 65i64 && iv.end == 65i64, 6);

    let r_inc = make_range_pat(mut_view(*arena), p_neg, p_pos, true, 40u32);
    assert_true(get_pat_interval(r_inc as *const HirPat, mut_view(iv)), 7);
    assert_true(iv.start == -15i64 && iv.end == 42i64, 8);

    let r_exc = make_range_pat(mut_view(*arena), p_neg, p_pos, false, 50u32);
    assert_true(get_pat_interval(r_exc as *const HirPat, mut_view(iv)), 9);
    assert_true(iv.start == -15i64 && iv.end == 41i64, 10);

    // 2. Bool exhaustiveness:
    // 2a. Non-exhaustive bool match (only `true`) -> AX_PAT_NON_EXHAUSTIVE
    let b_true1 = make_bool_pat(mut_view(*arena), true, 100u32);
    let arm_b1 = make_arm(mut_view(*arena), b_true1, 0 as *mut HirExpr, 100u32);
    let m_bool_nonex = make_match_expr(mut_view(*arena), arm_b1, 100u32);
    let t_bool_v = thir.interner.t_bool.v;
    match_check_exhaustiveness(
        mut_view(*thir),
        view(*str_in),
        view(*db),
        mut_view(*sink),
        m_bool_nonex as *const HirExpr,
        TypeId { v: t_bool_v }
    );
    assert_true(sink.errors == 1, 20);
    assert_true(sink.warnings == 0, 21);
    let d0 = unsafe { diag_at_const(sink.diags, 0) };
    assert_true((unsafe { (*d0).code.v }) == AX_PAT_NON_EXHAUSTIVE, 22);

    // 2b. Exhaustive bool match (`true`, `false`) -> no errors or warnings
    let b_false1 = make_bool_pat(mut_view(*arena), false, 110u32);
    let arm_b2 = make_arm(mut_view(*arena), b_false1, 0 as *mut HirExpr, 110u32);
    unsafe { (*arm_b1).next = arm_b2; }
    match_check_exhaustiveness(
        mut_view(*thir),
        view(*str_in),
        view(*db),
        mut_view(*sink),
        m_bool_nonex as *const HirExpr,
        TypeId { v: t_bool_v }
    );
    assert_true(sink.errors == 1, 23);
    assert_true(sink.warnings == 0, 24);

    // 2c. Duplicate bool arm (`true`, `false`, `true`) -> AX_PAT_UNREACHABLE warning on 3rd arm
    let b_true_dup = make_bool_pat(mut_view(*arena), true, 120u32);
    let arm_b3 = make_arm(mut_view(*arena), b_true_dup, 0 as *mut HirExpr, 120u32);
    unsafe { (*arm_b2).next = arm_b3; }
    match_check_exhaustiveness(
        mut_view(*thir),
        view(*str_in),
        view(*db),
        mut_view(*sink),
        m_bool_nonex as *const HirExpr,
        TypeId { v: t_bool_v }
    );
    assert_true(sink.errors == 1, 25);
    assert_true(sink.warnings == 1, 26);
    let d1 = unsafe { diag_at_const(sink.diags, 1) };
    assert_true((unsafe { (*d1).code.v }) == AX_PAT_UNREACHABLE, 27);
    assert_true((unsafe { (*d1).primary.start }) == 120u32, 28);

    // 2d. Guarded bool arm (`true if guard`, `false`) -> non-exhaustive because guarded arm doesn't guarantee coverage
    let dummy_guard = hir_alloc_expr(mut_view(*arena), HIR_EXPR_MATCH, Span { file: FileId { v: 1u32 }, start: 130u32, end: 131u32 });
    let b_true_g = make_bool_pat(mut_view(*arena), true, 132u32);
    let b_false_g = make_bool_pat(mut_view(*arena), false, 136u32);
    let arm_bg1 = make_arm(mut_view(*arena), b_true_g, dummy_guard, 132u32);
    let arm_bg2 = make_arm(mut_view(*arena), b_false_g, 0 as *mut HirExpr, 136u32);
    unsafe { (*arm_bg1).next = arm_bg2; }
    let m_bool_guarded = make_match_expr(mut_view(*arena), arm_bg1, 130u32);
    match_check_exhaustiveness(
        mut_view(*thir),
        view(*str_in),
        view(*db),
        mut_view(*sink),
        m_bool_guarded as *const HirExpr,
        TypeId { v: t_bool_v }
    );
    assert_true(sink.errors == 2, 29);

    // 3. Wildcard & Binding unreachability:
    let w_pat = make_wildcard_pat(mut_view(*arena), 200u32);
    let i_pat1 = make_int_pat(mut_view(*arena), 1u64, false, 210u32);
    let arm_w1 = make_arm(mut_view(*arena), w_pat, 0 as *mut HirExpr, 200u32);
    let arm_w2 = make_arm(mut_view(*arena), i_pat1, 0 as *mut HirExpr, 210u32);
    unsafe { (*arm_w1).next = arm_w2; }
    let m_wild = make_match_expr(mut_view(*arena), arm_w1, 200u32);
    let t_i32_v = thir.interner.t_i32.v;
    let prev_warns = sink.warnings;
    let prev_errs = sink.errors;
    match_check_exhaustiveness(
        mut_view(*thir),
        view(*str_in),
        view(*db),
        mut_view(*sink),
        m_wild as *const HirExpr,
        TypeId { v: t_i32_v }
    );
    assert_true(sink.errors == prev_errs, 30);
    assert_true(sink.warnings == prev_warns + 1, 31);

    // 4. Integer intervals, Or-patterns, and u8 full 0..=255 range coverage:
    let u8_s1 = make_int_pat(mut_view(*arena), 0u64, false, 300u32);
    let u8_e1 = make_int_pat(mut_view(*arena), 100u64, false, 302u32);
    let u8_r1 = make_range_pat(mut_view(*arena), u8_s1, u8_e1, false, 300u32);

    let u8_s2 = make_int_pat(mut_view(*arena), 100u64, false, 310u32);
    let u8_e2 = make_int_pat(mut_view(*arena), 255u64, false, 314u32);
    let u8_r2 = make_range_pat(mut_view(*arena), u8_s2, u8_e2, true, 310u32);

    let or_sub1 = make_int_pat(mut_view(*arena), 50u64, false, 320u32);
    let or_sub2 = make_int_pat(mut_view(*arena), 256u64, false, 325u32);
    unsafe { (*or_sub1).next = or_sub2; }
    let or_pat = hir_alloc_pat(mut_view(*arena), HIR_PAT_OR, Span { file: FileId { v: 1u32 }, start: 320u32, end: 328u32 });
    unsafe { (*or_pat).pats = or_sub1; }

    let arm_u8_1 = make_arm(mut_view(*arena), u8_r1, 0 as *mut HirExpr, 300u32);
    let arm_u8_2 = make_arm(mut_view(*arena), u8_r2, 0 as *mut HirExpr, 310u32);
    let arm_u8_3 = make_arm(mut_view(*arena), or_pat, 0 as *mut HirExpr, 320u32);
    unsafe {
        (*arm_u8_1).next = arm_u8_2;
        (*arm_u8_2).next = arm_u8_3;
    }
    let m_u8_full = make_match_expr(mut_view(*arena), arm_u8_1, 300u32);
    let t_u8_v = thir.interner.t_u8.v;
    let errs_before_u8 = sink.errors;
    let warns_before_u8 = sink.warnings;
    match_check_exhaustiveness(
        mut_view(*thir),
        view(*str_in),
        view(*db),
        mut_view(*sink),
        m_u8_full as *const HirExpr,
        TypeId { v: t_u8_v }
    );
    assert_true(sink.errors == errs_before_u8, 40);
    assert_true(sink.warnings == warns_before_u8 + 1, 41);
    let d_or = unsafe { diag_at_const(sink.diags, sink.len - 1) };
    assert_true((unsafe { (*d_or).code.v }) == AX_PAT_UNREACHABLE, 42);
    assert_true((unsafe { (*d_or).primary.start }) == 320u32, 43);

    // 4b. u8 missing 255 (`0..255` exclusive) -> AX_PAT_NON_EXHAUSTIVE
    let u8_s3 = make_int_pat(mut_view(*arena), 0u64, false, 340u32);
    let u8_e3 = make_int_pat(mut_view(*arena), 255u64, false, 342u32);
    let u8_r3 = make_range_pat(mut_view(*arena), u8_s3, u8_e3, false, 340u32);
    let arm_u8_inc = make_arm(mut_view(*arena), u8_r3, 0 as *mut HirExpr, 340u32);
    let m_u8_inc = make_match_expr(mut_view(*arena), arm_u8_inc, 340u32);
    match_check_exhaustiveness(
        mut_view(*thir),
        view(*str_in),
        view(*db),
        mut_view(*sink),
        m_u8_inc as *const HirExpr,
        TypeId { v: t_u8_v }
    );
    assert_true(sink.errors == errs_before_u8 + 1, 44);

    // 5. Enum exhaustiveness & unreachability (both via SourceDatabase span text `Color.Red` and via `path.name` fallback):
    let src_buf = arena_alloc_raw(mut_view(*arena), 43, 1);
    let mut bi: usize = 0;
    while (bi < 42) {
        unsafe { *(src_buf + bi) = TEST_SRC_BYTES[bi]; }
        bi = bi + 1;
    }
    unsafe { *(src_buf + 42) = 0u8; }

    let path_buf = arena_alloc_raw(mut_view(*arena), 13, 1);
    bi = 0;
    while (bi < 12) {
        unsafe { *(path_buf + bi) = TEST_PATH_BYTES[bi]; }
        bi = bi + 1;
    }
    unsafe { *(path_buf + 12) = 0u8; }

    let fid = source_db_add_virtual(
        mut_view(*db),
        path_buf as *const u8,
        12,
        src_buf as *const u8,
        42
    );
    let fid_v = fid.v;

    let buf_color = arena_alloc_raw(mut_view(*arena), 6, 1);
    bi = 0;
    while (bi < 5) { unsafe { *(buf_color + bi) = STR_COLOR[bi]; };
        bi = bi + 1;
    }
    let buf_red = arena_alloc_raw(mut_view(*arena), 4, 1);
    bi = 0;
    while (bi < 3) { unsafe { *(buf_red + bi) = STR_RED[bi]; };
        bi = bi + 1;
    }
    let buf_green = arena_alloc_raw(mut_view(*arena), 6, 1);
    bi = 0;
    while (bi < 5) { unsafe { *(buf_green + bi) = STR_GREEN[bi]; };
        bi = bi + 1;
    }
    let buf_blue = arena_alloc_raw(mut_view(*arena), 5, 1);
    bi = 0;
    while (bi < 4) { unsafe { *(buf_blue + bi) = STR_BLUE[bi]; };
        bi = bi + 1;
    }

    let s_color = interner_intern_bytes(mut_view(*str_in), buf_color as *const u8, 5);
    let s_red = interner_intern_bytes(mut_view(*str_in), buf_red as *const u8, 3);
    let s_green = interner_intern_bytes(mut_view(*str_in), buf_green as *const u8, 5);
    let s_blue = interner_intern_bytes(mut_view(*str_in), buf_blue as *const u8, 4);
    let s_color_v = s_color.v;
    let s_red_v = s_red.v;
    let s_green_v = s_green.v;
    let s_blue_v = s_blue.v;

    let v_red = hir_alloc_variant_decl(mut_view(*arena), Span { file: FileId { v: fid_v }, start: 0u32, end: 9u32 });
    let v_green = hir_alloc_variant_decl(mut_view(*arena), Span { file: FileId { v: fid_v }, start: 10u32, end: 21u32 });
    let v_blue = hir_alloc_variant_decl(mut_view(*arena), Span { file: FileId { v: fid_v }, start: 22u32, end: 32u32 });
    unsafe {
        (*v_red).name.v = s_red_v;
        (*v_red).next = v_green;
        (*v_green).name.v = s_green_v;
        (*v_green).next = v_blue;
        (*v_blue).name.v = s_blue_v;
        (*v_blue).next = 0 as *mut HirVariantDecl;
    }
    let enum_item = hir_alloc_item(mut_view(*arena), HIR_ITEM_ENUM, Span { file: FileId { v: fid_v }, start: 0u32, end: 32u32 });
    unsafe {
        (*enum_item).name.v = s_color_v;
        (*enum_item).variants = v_red;
    }

    unsafe {
        ax_type_reset(mut_view(*thir.interner.scratch), TY_ENUM);
        (*thir.interner.scratch).def = enum_item as *const HirItem;
        (*thir.interner.scratch).variant_count = 3;
    }
    let sp_enum = thir.interner.scratch;
    let color_ty = intern_type(mut_view(thir.interner), unsafe { view(*sp_enum) });
    let color_ty_v = color_ty.v;

    // 5a. Partial enum match (`Color.Red`, `Color.Green`, and mismatched enum `Other.Red`) -> non-exhaustive
    let pat_red = hir_alloc_pat(mut_view(*arena), HIR_PAT_PATH, Span { file: FileId { v: fid_v }, start: 0u32, end: 9u32 });
    unsafe {
        (*pat_red).path.span.file.v = fid_v;
        (*pat_red).path.span.start = 0u32;
        (*pat_red).path.span.end = 9u32;
        (*pat_red).path.name.v = s_red_v;
    }
    let pat_green = hir_alloc_pat(mut_view(*arena), HIR_PAT_STRUCT, Span { file: FileId { v: fid_v }, start: 10u32, end: 21u32 });
    unsafe {
        (*pat_green).path.span.file.v = fid_v;
        (*pat_green).path.span.start = 10u32;
        (*pat_green).path.span.end = 21u32;
        (*pat_green).path.name.v = s_green_v;
    }
    let pat_other_red = hir_alloc_pat(mut_view(*arena), HIR_PAT_PATH, Span { file: FileId { v: fid_v }, start: 33u32, end: 42u32 });
    unsafe {
        (*pat_other_red).path.span.file.v = fid_v;
        (*pat_other_red).path.span.start = 33u32;
        (*pat_other_red).path.span.end = 42u32;
        (*pat_other_red).path.name.v = s_red_v;
    }

    let earm1 = make_arm(mut_view(*arena), pat_red, 0 as *mut HirExpr, 0u32);
    let earm2 = make_arm(mut_view(*arena), pat_green, 0 as *mut HirExpr, 10u32);
    let earm_other = make_arm(mut_view(*arena), pat_other_red, 0 as *mut HirExpr, 33u32);
    unsafe {
        (*earm1).next = earm2;
        (*earm2).next = earm_other;
    }
    let m_enum = make_match_expr(mut_view(*arena), earm1, 400u32);
    let errs_before_enum = sink.errors;
    let warns_before_enum = sink.warnings;
    match_check_exhaustiveness(
        mut_view(*thir),
        view(*str_in),
        view(*db),
        mut_view(*sink),
        m_enum as *const HirExpr,
        TypeId { v: color_ty_v }
    );
    assert_true(sink.errors == errs_before_enum + 1, 50);
    assert_true(sink.warnings == warns_before_enum, 51);

    // 5b. Add `Blue` (via `path.name` fallback with empty span) and duplicate `Color.Red` -> exhaustive (0 new errors) + 1 unreachable warning on duplicate `Color.Red`!
    let pat_blue_fallback = hir_alloc_pat(mut_view(*arena), HIR_PAT_PATH, Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 });
    unsafe {
        (*pat_blue_fallback).path.span.file.v = 0u32;
        (*pat_blue_fallback).path.name.v = s_blue_v;
    }
    let pat_red_dup = hir_alloc_pat(mut_view(*arena), HIR_PAT_PATH, Span { file: FileId { v: fid_v }, start: 0u32, end: 9u32 });
    unsafe {
        (*pat_red_dup).path.span.file.v = fid_v;
        (*pat_red_dup).path.span.start = 0u32;
        (*pat_red_dup).path.span.end = 9u32;
        (*pat_red_dup).path.name.v = s_red_v;
    }
    let earm3 = make_arm(mut_view(*arena), pat_blue_fallback, 0 as *mut HirExpr, 22u32);
    let earm4 = make_arm(mut_view(*arena), pat_red_dup, 0 as *mut HirExpr, 500u32);
    unsafe {
        (*earm_other).next = earm3;
        (*earm3).next = earm4;
    }
    match_check_exhaustiveness(
        mut_view(*thir),
        view(*str_in),
        view(*db),
        mut_view(*sink),
        m_enum as *const HirExpr,
        TypeId { v: color_ty_v }
    );
    assert_true(sink.errors == errs_before_enum + 1, 52);
    assert_true(sink.warnings == warns_before_enum + 1, 53);

    // 6. Other types (e.g., `str` or `struct`):
    // Without wildcard/binding -> AX_PAT_NON_EXHAUSTIVE; with binding -> exhaustive
    let t_str_v = thir.interner.t_str.v;
    let m_str_empty = make_match_expr(mut_view(*arena), 0 as *mut HirMatchArm, 600u32);
    let errs_before_str = sink.errors;
    match_check_exhaustiveness(
        mut_view(*thir),
        view(*str_in),
        view(*db),
        mut_view(*sink),
        m_str_empty as *const HirExpr,
        TypeId { v: t_str_v }
    );
    assert_true(sink.errors == errs_before_str + 1, 60);

    let bind_pat = make_binding_pat(mut_view(*arena), 99u32, 610u32);
    let arm_bind = make_arm(mut_view(*arena), bind_pat, 0 as *mut HirExpr, 610u32);
    let m_str_bind = make_match_expr(mut_view(*arena), arm_bind, 610u32);
    match_check_exhaustiveness(
        mut_view(*thir),
        view(*str_in),
        view(*db),
        mut_view(*sink),
        m_str_bind as *const HirExpr,
        TypeId { v: t_str_v }
    );
    assert_true(sink.errors == errs_before_str + 1, 61);

    thir_free(mut_view(*thir));
}

pub fn main() -> i32 {
    let mut arena: Arena = arena_new();
    let mut str_in: StrInterner = interner_new();
    let db_ptr = arena_alloc_raw(mut_view(arena), size_of<SourceDatabase>(), align_of<SourceDatabase>()) as *mut SourceDatabase;
    let sink_ptr = arena_alloc_raw(mut_view(arena), size_of<DiagSink>(), align_of<DiagSink>()) as *mut DiagSink;
    let thir_ptr = arena_alloc_raw(mut_view(arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    unsafe {
        source_db_init(mut_view(*db_ptr));
        diag_sink_init(mut_view(*sink_ptr));
        run_exhaust_tests(
            mut_view(arena),
            mut_view(str_in),
            mut_view(*db_ptr),
            mut_view(*sink_ptr),
            mut_view(*thir_ptr)
        );
        diag_sink_free(mut_view(*sink_ptr));
        source_db_free(mut_view(*db_ptr));
    }
    interner_free(mut_view(str_in));
    arena_destroy(mut_view(arena));
    print("OK Types Exhaust\n");
    0
}
