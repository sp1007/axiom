    let new_cap: usize = if m.cap == 0 { MAP_INIT_CAP } else { mul_usize(m.cap, 2) };
    let new_keys = unsafe { heap_alloc(mul_usize(new_cap, size_of<u32>()), align_of<u32>()) as *mut u32 };
    let new_vals = unsafe {
