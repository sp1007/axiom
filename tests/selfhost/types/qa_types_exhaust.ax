struct HirDumpState {
    buf: *mut DiagBuffer,
    interner: *const StrInterner,
    indent: i32,
    filter_file: FileId,
}

fn hd_str(st: mut_view<HirDumpState>, idx: usize) {
    let start = HIR_OFF[idx] as usize;
    let end = HIR_OFF[idx + 1] as usize;
    let mut i = start;
    while (i < end) {
        unsafe { diag_buf_push_byte(mut_view(*st.buf), HIR_DATA[i]); }
        i = i + 1;
    }
}

fn hd_nl(st: mut_view<HirDumpState>) {
    unsafe { diag_buf_push_byte(mut_view(*st.buf), 10u8); }
    let mut i: i32 = 0;
    while (i < st.indent) {
        hd_str(mut_view(*st), 0);
        i = i + 1;
    }
}

fn hd_begin(st: mut_view<HirDumpState>, idx: usize) {
    unsafe { diag_buf_push_byte(mut_view(*st.buf), 40u8); }
    hd_str(mut_view(*st), idx);
    st.indent = st.indent + 1;
}

fn hd_end(st: mut_view<HirDumpState>) {
    st.indent = st.indent - 1;
    unsafe { diag_buf_push_byte(mut_view(*st.buf), 41u8); }
}

fn hd_strid(st: mut_view<HirDumpState>, id: StrId) {
    if id.v == 0u32 {
        hd_str(mut_view(*st), 2);
        return;
    }
    let sv = unsafe { interner_get(view(*st.interner), id) };
    hd_str(mut_view(*st), 1);
    unsafe {
        diag_buf_push_bytes(mut_view(*st.buf), sv.ptr, sv.len);
        diag_buf_push_byte(mut_view(*st.buf), 34u8);
    }
}

fn hd_bool(st: mut_view<HirDumpState>, b: bool) {
    if b {
        hd_str(mut_view(*st), 3);
    } else {
        hd_str(mut_view(*st), 4);
    }
}

fn hd_u32(st: mut_view<HirDumpState>, v: u32) {
    unsafe {
        diag_buf_push_byte(mut_view(*st.buf), 32u8);
        diag_buf_push_u32(mut_view(*st.buf), v);
    }
}

fn hd_symbol(st: mut_view<HirDumpState>, sym: SymbolId) {
    if sym.v != 0u32 {
        hd_str(mut_view(*st), 5);
        unsafe { diag_buf_push_u32(mut_view(*st.buf), sym.v); }
    }
}

fn hd_dotted(st: mut_view<HirDumpState>, n: view<AstDottedName>) {
    hd_nl(mut_view(*st));
    hd_begin(mut_view(*st), 6);
    let mut i: usize = 0;
    while (i < n.count) {
        let off = ((i as isize) * (size_of<StrId>() as isize)) as usize;
        let seg_ptr = ((n.segments as usize) + off) as *const StrId;
        hd_strid(mut_view(*st), unsafe { *seg_ptr });
        i = i + 1;
    }
    hd_end(mut_view(*st));
}

fn hd_vis(st: mut_view<HirDumpState>, n: view<HirVis>) {
    hd_nl(mut_view(*st));
    hd_begin(mut_view(*st), 7);
    if n.kind == HIR_VIS_PRIVATE {
        hd_str(mut_view(*st), 8);
    } else if n.kind == HIR_VIS_PUB {
        hd_str(mut_view(*st), 9);
    } else if n.kind == HIR_VIS_PUB_PACKAGE {
        hd_str(mut_view(*st), 10);
    } else if n.kind == HIR_VIS_PUB_MODULE {
        hd_str(mut_view(*st), 11);
    }
    hd_end(mut_view(*st));
}

fn hd_attr(st: mut_view<HirDumpState>, n: *mut HirAttr) {
    let mut cur = n;
    while (cur as usize) != 0 {
        hd_nl(mut_view(*st));
        hd_begin(mut_view(*st), 12);
        hd_strid(mut_view(*st), unsafe { (*cur).name });
        let mut a: *mut HirAttrArg = unsafe { (*cur).args };
        while (a as usize) != 0 {
            hd_nl(mut_view(*st));
            hd_begin(mut_view(*st), 13);
            hd_strid(mut_view(*st), unsafe { (*a).name });
            hd_expr(mut_view(*st), unsafe { (*a).expr });
            hd_end(mut_view(*st));
            a = unsafe { (*a).next };
        }
        hd_end(mut_view(*st));
        cur = unsafe { (*cur).next };
    }
}

fn hd_generic_args(st: mut_view<HirDumpState>, n: *mut HirGenericArgs) {
    if (n as usize) == 0 {
        return;
    }
    let mut a: *mut HirGenericArg = unsafe { (*n).args };
    while (a as usize) != 0 {
        hd_nl(mut_view(*st));
        hd_begin(mut_view(*st), 14);
        hd_strid(mut_view(*st), unsafe { (*a).name });
        hd_type(mut_view(*st), unsafe { (*a).ty });
        hd_end(mut_view(*st));
        a = unsafe { (*a).next };
    }
}

fn hd_generic_params(st: mut_view<HirDumpState>, n: *mut HirGenericParams) {
    if (n as usize) == 0 {
        return;
    }
    let mut a: *mut HirGenericParam = unsafe { (*n).params };
    while (a as usize) != 0 {
        hd_nl(mut_view(*st));
        hd_begin(mut_view(*st), 15);
        hd_strid(mut_view(*st), unsafe { (*a).name });
        hd_type(mut_view(*st), unsafe { (*a).bounds });
        hd_end(mut_view(*st));
        a = unsafe { (*a).next };
    }
}

fn hd_where_clause(st: mut_view<HirDumpState>, n: *mut HirWhereClause) {
    if (n as usize) == 0 {
        return;
    }
    let mut a: *mut HirWherePred = unsafe { (*n).preds };
    while (a as usize) != 0 {
        hd_nl(mut_view(*st));
        hd_begin(mut_view(*st), 16);
        hd_type(mut_view(*st), unsafe { (*a).ty });
        hd_type(mut_view(*st), unsafe { (*a).bounds });
        hd_end(mut_view(*st));
        a = unsafe { (*a).next };
    }
}

fn hd_path(st: mut_view<HirDumpState>, p: view<HirPath>) {
    hd_symbol(mut_view(*st), p.symbol);
    hd_generic_args(mut_view(*st), p.generic_args);
}

fn hd_block(st: mut_view<HirDumpState>, n: *mut HirBlock) {
    hd_nl(mut_view(*st));
    hd_begin(mut_view(*st), 17);
    if (n as usize) != 0 {
        hd_stmt(mut_view(*st), unsafe { (*n).stmts });
    }
    hd_end(mut_view(*st));
}

fn hd_type(st: mut_view<HirDumpState>, n: *mut HirType) {
    let mut cur = n;
    while (cur as usize) != 0 {
        hd_nl(mut_view(*st));
        let k = unsafe { (*cur).kind };
        if k == HIR_TYPE_ERROR {
            hd_begin(mut_view(*st), 18);
        } else if k == HIR_TYPE_PATH {
            hd_begin(mut_view(*st), 19);
            hd_path(mut_view(*st), unsafe { view((*cur).path) });
        } else if k == HIR_TYPE_TUPLE {
            hd_begin(mut_view(*st), 20);
            hd_type(mut_view(*st), unsafe { (*cur).elem_types });
        } else if k == HIR_TYPE_ARRAY {
            hd_begin(mut_view(*st), 21);
            hd_expr(mut_view(*st), unsafe { (*cur).count_expr });
            hd_type(mut_view(*st), unsafe { (*cur).elem });
        } else if k == HIR_TYPE_SLICE {
            hd_begin(mut_view(*st), 22);
            hd_type(mut_view(*st), unsafe { (*cur).elem });
        } else if k == HIR_TYPE_VIEW {
            hd_begin(mut_view(*st), 23);
            hd_bool(mut_view(*st), unsafe { (*cur).is_mut });
            hd_type(mut_view(*st), unsafe { (*cur).elem });
        } else if k == HIR_TYPE_PTR {
            hd_begin(mut_view(*st), 24);
            hd_bool(mut_view(*st), unsafe { (*cur).is_mut });
            hd_type(mut_view(*st), unsafe { (*cur).elem });
        } else if k == HIR_TYPE_FN {
            hd_begin(mut_view(*st), 25);
            hd_bool(mut_view(*st), unsafe { (*cur).is_unsafe });
            hd_strid(mut_view(*st), unsafe { (*cur).abi });
            hd_type(mut_view(*st), unsafe { (*cur).param_types });
            hd_type(mut_view(*st), unsafe { (*cur).ret_type });
        } else if k == HIR_TYPE_DYN {
            hd_begin(mut_view(*st), 26);
            hd_type(mut_view(*st), unsafe { (*cur).bounds });
        }
        hd_end(mut_view(*st));
        cur = unsafe { (*cur).next };
    }
}

fn hd_pat_field(st: mut_view<HirDumpState>, n: *mut HirPatField) {
    let mut cur = n;
    while (cur as usize) != 0 {
        hd_nl(mut_view(*st));
        hd_begin(mut_view(*st), 27);
        hd_strid(mut_view(*st), unsafe { (*cur).name });
        hd_pat(mut_view(*st), unsafe { (*cur).pat });
        hd_end(mut_view(*st));
        cur = unsafe { (*cur).next };
    }
}

fn hd_pat(st: mut_view<HirDumpState>, n: *mut HirPat) {
    let mut cur = n;
    while (cur as usize) != 0 {
        hd_nl(mut_view(*st));
        let k = unsafe { (*cur).kind };
        if k == HIR_PAT_ERROR {
            hd_begin(mut_view(*st), 28);
        } else if k == HIR_PAT_WILDCARD {
            hd_begin(mut_view(*st), 29);
        } else if k == HIR_PAT_RANGE {
            hd_begin(mut_view(*st), 30);
            hd_bool(mut_view(*st), unsafe { (*cur).is_inclusive });
            hd_pat(mut_view(*st), unsafe { (*cur).start_pat });
            hd_pat(mut_view(*st), unsafe { (*cur).end_pat });
        } else if k == HIR_PAT_LITERAL {
            hd_begin(mut_view(*st), 31);
            hd_bool(mut_view(*st), unsafe { (*cur).is_negated });
        } else if k == HIR_PAT_BINDING {
            hd_begin(mut_view(*st), 32);
            hd_bool(mut_view(*st), unsafe { (*cur).is_mut });
            hd_symbol(mut_view(*st), unsafe { (*cur).symbol });
        } else if k == HIR_PAT_PATH {
            hd_begin(mut_view(*st), 33);
            hd_path(mut_view(*st), unsafe { view((*cur).path) });
            hd_pat(mut_view(*st), unsafe { (*cur).payload });
        } else if k == HIR_PAT_TUPLE {
            hd_begin(mut_view(*st), 34);
            hd_pat(mut_view(*st), unsafe { (*cur).elems });
        } else if k == HIR_PAT_OR {
            hd_begin(mut_view(*st), 35);
            hd_pat(mut_view(*st), unsafe { (*cur).pats });
        } else if k == HIR_PAT_STRUCT {
            hd_begin(mut_view(*st), 36);
            hd_path(mut_view(*st), unsafe { view((*cur).path) });
            hd_pat_field(mut_view(*st), unsafe { (*cur).fields });
            hd_bool(mut_view(*st), unsafe { (*cur).has_rest });
        }
        hd_end(mut_view(*st));
        cur = unsafe { (*cur).next };
    }
}

fn hd_expr(st: mut_view<HirDumpState>, n: *mut HirExpr) {
    let mut cur = n;
    while (cur as usize) != 0 {
        hd_nl(mut_view(*st));
        let k = unsafe { (*cur).kind };
        if k == HIR_EXPR_ERROR {
            hd_begin(mut_view(*st), 37);
        } else if k == HIR_EXPR_LITERAL {
            hd_begin(mut_view(*st), 38);
        } else if k == HIR_EXPR_PATH {
            hd_begin(mut_view(*st), 39);
            hd_path(mut_view(*st), unsafe { view((*cur).path) });
        } else if k == HIR_EXPR_ARRAY {
            hd_begin(mut_view(*st), 40);
            hd_expr(mut_view(*st), unsafe { (*cur).elems });
            hd_expr(mut_view(*st), unsafe { (*cur).count_expr });
        } else if k == HIR_EXPR_TUPLE {
            hd_begin(mut_view(*st), 41);
            hd_expr(mut_view(*st), unsafe { (*cur).elems });
        } else if k == HIR_EXPR_STRUCT {
            hd_begin(mut_view(*st), 42);
            hd_path(mut_view(*st), unsafe { view((*cur).path) });
            let mut f: *mut HirFieldInit = unsafe { (*cur).fields };
            while (f as usize) != 0 {
                hd_nl(mut_view(*st));
                hd_begin(mut_view(*st), 43);
                hd_strid(mut_view(*st), unsafe { (*f).name });
                hd_expr(mut_view(*st), unsafe { (*f).expr });
                hd_end(mut_view(*st));
                f = unsafe { (*f).next };
            }
        } else if k == HIR_EXPR_BLOCK {
            hd_begin(mut_view(*st), 44);
            hd_block(mut_view(*st), unsafe { (*cur).block });
        } else if k == HIR_EXPR_IF {
            hd_begin(mut_view(*st), 45);
            hd_pat(mut_view(*st), unsafe { (*cur).let_pat });
            hd_expr(mut_view(*st), unsafe { (*cur).cond });
            hd_block(mut_view(*st), unsafe { (*cur).block });
            hd_expr(mut_view(*st), unsafe { (*cur).else_branch });
        } else if k == HIR_EXPR_MATCH {
            hd_begin(mut_view(*st), 46);
            hd_expr(mut_view(*st), unsafe { (*cur).cond });
            let mut a: *mut HirMatchArm = unsafe { (*cur).arms };
            while (a as usize) != 0 {
                hd_nl(mut_view(*st));
                hd_begin(mut_view(*st), 47);
                hd_pat(mut_view(*st), unsafe { (*a).pat });
                hd_expr(mut_view(*st), unsafe { (*a).guard });
                hd_expr(mut_view(*st), unsafe { (*a).body });
                hd_end(mut_view(*st));
                a = unsafe { (*a).next };
            }
        } else if k == HIR_EXPR_LOOP {
            hd_begin(mut_view(*st), 48);
            hd_strid(mut_view(*st), unsafe { (*cur).label });
            hd_block(mut_view(*st), unsafe { (*cur).block });
        } else if k == HIR_EXPR_WHILE {
            hd_begin(mut_view(*st), 49);
            hd_strid(mut_view(*st), unsafe { (*cur).label });
            hd_pat(mut_view(*st), unsafe { (*cur).let_pat });
            hd_expr(mut_view(*st), unsafe { (*cur).cond });
            hd_block(mut_view(*st), unsafe { (*cur).block });
        } else if k == HIR_EXPR_FOR {
            hd_begin(mut_view(*st), 50);
            hd_strid(mut_view(*st), unsafe { (*cur).label });
            hd_pat(mut_view(*st), unsafe { (*cur).pat });
            hd_expr(mut_view(*st), unsafe { (*cur).iter });
            hd_block(mut_view(*st), unsafe { (*cur).block });
        } else if k == HIR_EXPR_UNSAFE {
            hd_begin(mut_view(*st), 51);
            hd_block(mut_view(*st), unsafe { (*cur).block });
        } else if k == HIR_EXPR_VIEW {
            hd_begin(mut_view(*st), 52);
            hd_bool(mut_view(*st), unsafe { (*cur).is_mut });
            hd_expr(mut_view(*st), unsafe { (*cur).inner });
        } else if k == HIR_EXPR_COMPTIME {
            hd_begin(mut_view(*st), 53);
            hd_block(mut_view(*st), unsafe { (*cur).block });
        } else if k == HIR_EXPR_JUMP {
            hd_begin(mut_view(*st), 54);
            hd_u32(mut_view(*st), (unsafe { (*cur).jump_kind }) as u32);
            hd_strid(mut_view(*st), unsafe { (*cur).label });
            hd_expr(mut_view(*st), unsafe { (*cur).inner });
        } else if k == HIR_EXPR_CLOSURE {
            hd_begin(mut_view(*st), 55);
            let mut p: *mut HirParam = unsafe { (*cur).params };
            while (p as usize) != 0 {
                hd_nl(mut_view(*st));
                hd_begin(mut_view(*st), 56);
                hd_bool(mut_view(*st), unsafe { (*p).is_mut });
                hd_symbol(mut_view(*st), unsafe { (*p).symbol });
                hd_type(mut_view(*st), unsafe { (*p).ty });
                hd_end(mut_view(*st));
                p = unsafe { (*p).next };
            }
            hd_type(mut_view(*st), unsafe { (*cur).ret_type });
            hd_expr(mut_view(*st), unsafe { (*cur).body });
        } else if k == HIR_EXPR_RANGE {
            hd_begin(mut_view(*st), 57);
            hd_bool(mut_view(*st), unsafe { (*cur).is_inclusive });
            hd_expr(mut_view(*st), unsafe { (*cur).start_expr });
            hd_expr(mut_view(*st), unsafe { (*cur).end_expr });
        } else if k == HIR_EXPR_BINARY {
            hd_begin(mut_view(*st), 58);
            hd_u32(mut_view(*st), (unsafe { (*cur).op }) as u32);
            hd_expr(mut_view(*st), unsafe { (*cur).left });
            hd_expr(mut_view(*st), unsafe { (*cur).right });
        } else if k == HIR_EXPR_UNARY {
            hd_begin(mut_view(*st), 59);
            hd_u32(mut_view(*st), (unsafe { (*cur).op }) as u32);
            hd_expr(mut_view(*st), unsafe { (*cur).inner });
        } else if k == HIR_EXPR_CAST {
            hd_begin(mut_view(*st), 60);
            hd_expr(mut_view(*st), unsafe { (*cur).inner });
            hd_type(mut_view(*st), unsafe { (*cur).cast_ty });
        } else if k == HIR_EXPR_FIELD {
            hd_begin(mut_view(*st), 61);
            hd_expr(mut_view(*st), unsafe { (*cur).base });
            hd_strid(mut_view(*st), unsafe { (*cur).name });
            hd_generic_args(mut_view(*st), unsafe { (*cur).generic_args });
        } else if k == HIR_EXPR_TUPLE_INDEX {
            hd_begin(mut_view(*st), 62);
            hd_expr(mut_view(*st), unsafe { (*cur).base });
            hd_u32(mut_view(*st), unsafe { (*cur).tuple_index });
        } else if k == HIR_EXPR_CALL {
            hd_begin(mut_view(*st), 63);
            hd_expr(mut_view(*st), unsafe { (*cur).callee });
            hd_expr(mut_view(*st), unsafe { (*cur).args });
        } else if k == HIR_EXPR_METHOD_CALL {
            hd_begin(mut_view(*st), 64);
            hd_expr(mut_view(*st), unsafe { (*cur).receiver });
            hd_strid(mut_view(*st), unsafe { (*cur).method_name });
            hd_generic_args(mut_view(*st), unsafe { (*cur).generic_args });
            hd_expr(mut_view(*st), unsafe { (*cur).args });
        } else if k == HIR_EXPR_INDEX {
            hd_begin(mut_view(*st), 65);
            hd_expr(mut_view(*st), unsafe { (*cur).base });
            hd_expr(mut_view(*st), unsafe { (*cur).index_arg });
        } else if k == HIR_EXPR_TRY {
            hd_begin(mut_view(*st), 66);
            hd_expr(mut_view(*st), unsafe { (*cur).inner });
        } else if k == HIR_EXPR_AWAIT {
            hd_begin(mut_view(*st), 67);
            hd_expr(mut_view(*st), unsafe { (*cur).inner });
        }
        hd_end(mut_view(*st));
        cur = unsafe { (*cur).next };
    }
}

fn hd_use_tree(st: mut_view<HirDumpState>, n: *mut HirUseTree) {
    if (n as usize) == 0 {
        return;
    }
    hd_nl(mut_view(*st));
    hd_begin(mut_view(*st), 68);
    hd_dotted(mut_view(*st), unsafe { view((*n).path) });
    if (unsafe { (*n).alias.v }) != 0u32 {
        hd_strid(mut_view(*st), unsafe { (*n).alias });
    }
    if (unsafe { (*n).subtrees as usize }) != 0 {
        hd_use_tree(mut_view(*st), unsafe { (*n).subtrees });
    }
    hd_end(mut_view(*st));
    if (unsafe { (*n).next as usize }) != 0 {
        hd_use_tree(mut_view(*st), unsafe { (*n).next });
    }
}

fn hd_stmt(st: mut_view<HirDumpState>, n: *mut HirStmt) {
    let mut cur = n;
    while (cur as usize) != 0 {
        hd_nl(mut_view(*st));
        let k = unsafe { (*cur).kind };
        if k == HIR_STMT_ERROR {
            hd_begin(mut_view(*st), 69);
        } else if k == HIR_STMT_LET {
            hd_begin(mut_view(*st), 70);
            hd_pat(mut_view(*st), unsafe { (*cur).pat });
            hd_type(mut_view(*st), unsafe { (*cur).ty });
            hd_expr(mut_view(*st), unsafe { (*cur).expr });
            if (unsafe { (*cur).else_block as usize }) != 0 {
                hd_block(mut_view(*st), unsafe { (*cur).else_block });
            }
        } else if k == HIR_STMT_ASSIGN {
            hd_begin(mut_view(*st), 71);
            hd_expr(mut_view(*st), unsafe { (*cur).left });
            hd_expr(mut_view(*st), unsafe { (*cur).right });
        } else if k == HIR_STMT_EXPR {
            hd_begin(mut_view(*st), 72);
            hd_bool(mut_view(*st), unsafe { (*cur).has_semi });
            hd_expr(mut_view(*st), unsafe { (*cur).expr });
        }
        hd_end(mut_view(*st));
        cur = unsafe { (*cur).next };
    }
}

fn hd_item(st: mut_view<HirDumpState>, n: *mut HirItem) {
    let mut cur = n;
    while (cur as usize) != 0 {
        if st.filter_file.v != 0u32 && (unsafe { (*cur).span.file.v }) != 0u32 && (unsafe { (*cur).span.file.v }) != st.filter_file.v {
            cur = unsafe { (*cur).next };
            continue;
        }
        hd_nl(mut_view(*st));
        let k = unsafe { (*cur).kind };
        if k == HIR_ITEM_ERROR {
            hd_begin(mut_view(*st), 73);
        } else if k == HIR_ITEM_MODULE {
            hd_begin(mut_view(*st), 74);
            hd_attr(mut_view(*st), unsafe { (*cur).attrs });
            hd_vis(mut_view(*st), unsafe { view((*cur).vis) });
            hd_dotted(mut_view(*st), unsafe { view((*cur).mod_path) });
        } else if k == HIR_ITEM_USE {
            hd_begin(mut_view(*st), 75);
            hd_attr(mut_view(*st), unsafe { (*cur).attrs });
            hd_vis(mut_view(*st), unsafe { view((*cur).vis) });
            hd_use_tree(mut_view(*st), unsafe { (*cur).use_tree });
        } else if k == HIR_ITEM_FN {
            hd_begin(mut_view(*st), 76);
            hd_attr(mut_view(*st), unsafe { (*cur).attrs });
            hd_vis(mut_view(*st), unsafe { view((*cur).vis) });
            hd_bool(mut_view(*st), unsafe { (*cur).is_async });
            hd_bool(mut_view(*st), unsafe { (*cur).is_comptime });
            hd_bool(mut_view(*st), unsafe { (*cur).is_unsafe });
            hd_strid(mut_view(*st), unsafe { (*cur).abi });
            hd_strid(mut_view(*st), unsafe { (*cur).name });
            hd_generic_params(mut_view(*st), unsafe { (*cur).generic_params });
            let mut p: *mut HirParam = unsafe { (*cur).params };
            while (p as usize) != 0 {
                hd_nl(mut_view(*st));
                hd_begin(mut_view(*st), 56);
                hd_bool(mut_view(*st), unsafe { (*p).is_mut });
                hd_symbol(mut_view(*st), unsafe { (*p).symbol });
                hd_type(mut_view(*st), unsafe { (*p).ty });
                hd_end(mut_view(*st));
                p = unsafe { (*p).next };
            }
            hd_type(mut_view(*st), unsafe { (*cur).ret_type });
            hd_where_clause(mut_view(*st), unsafe { (*cur).where_clause });
            if (unsafe { (*cur).body as usize }) != 0 {
                hd_block(mut_view(*st), unsafe { (*cur).body });
            }
        } else if k == HIR_ITEM_STRUCT {
            hd_begin(mut_view(*st), 77);
            hd_attr(mut_view(*st), unsafe { (*cur).attrs });
            hd_vis(mut_view(*st), unsafe { view((*cur).vis) });
            hd_strid(mut_view(*st), unsafe { (*cur).name });
            hd_generic_params(mut_view(*st), unsafe { (*cur).generic_params });
            hd_where_clause(mut_view(*st), unsafe { (*cur).where_clause });
            hd_bool(mut_view(*st), unsafe { (*cur).is_tuple });
            if unsafe { (*cur).is_tuple } {
                hd_type(mut_view(*st), unsafe { (*cur).tuple_types });
            } else {
                let mut f: *mut HirFieldDecl = unsafe { (*cur).struct_fields };
                while (f as usize) != 0 {
                    hd_nl(mut_view(*st));
                    hd_begin(mut_view(*st), 78);
                    hd_attr(mut_view(*st), unsafe { (*f).attrs });
                    hd_vis(mut_view(*st), unsafe { view((*f).vis) });
                    hd_strid(mut_view(*st), unsafe { (*f).name });
                    hd_type(mut_view(*st), unsafe { (*f).ty });
                    hd_end(mut_view(*st));
                    f = unsafe { (*f).next };
                }
            }
        } else if k == HIR_ITEM_ENUM {
            hd_begin(mut_view(*st), 79);
            hd_attr(mut_view(*st), unsafe { (*cur).attrs });
            hd_vis(mut_view(*st), unsafe { view((*cur).vis) });
            hd_strid(mut_view(*st), unsafe { (*cur).name });
            hd_generic_params(mut_view(*st), unsafe { (*cur).generic_params });
            hd_where_clause(mut_view(*st), unsafe { (*cur).where_clause });
            let mut v: *mut HirVariantDecl = unsafe { (*cur).variants };
            while (v as usize) != 0 {
                hd_nl(mut_view(*st));
                hd_begin(mut_view(*st), 80);
                hd_attr(mut_view(*st), unsafe { (*v).attrs });
                hd_strid(mut_view(*st), unsafe { (*v).name });
                hd_bool(mut_view(*st), unsafe { (*v).is_struct });
                if unsafe { (*v).is_struct } {
                    let mut f: *mut HirFieldDecl = unsafe { (*v).struct_fields };
                    while (f as usize) != 0 {
                        hd_nl(mut_view(*st));
                        hd_begin(mut_view(*st), 78);
                        hd_attr(mut_view(*st), unsafe { (*f).attrs });
                        hd_vis(mut_view(*st), unsafe { view((*f).vis) });
                        hd_strid(mut_view(*st), unsafe { (*f).name });
                        hd_type(mut_view(*st), unsafe { (*f).ty });
                        hd_end(mut_view(*st));
                        f = unsafe { (*f).next };
                    }
                } else {
                    hd_type(mut_view(*st), unsafe { (*v).tuple_types });
                }
                hd_end(mut_view(*st));
                v = unsafe { (*v).next };
            }
        } else if k == HIR_ITEM_TRAIT {
            hd_begin(mut_view(*st), 81);
            hd_attr(mut_view(*st), unsafe { (*cur).attrs });
            hd_vis(mut_view(*st), unsafe { view((*cur).vis) });
            hd_strid(mut_view(*st), unsafe { (*cur).name });
            hd_generic_params(mut_view(*st), unsafe { (*cur).generic_params });
            hd_type(mut_view(*st), unsafe { (*cur).supertraits });
            hd_where_clause(mut_view(*st), unsafe { (*cur).where_clause });
            hd_item(mut_view(*st), unsafe { (*cur).members });
        } else if k == HIR_ITEM_IMPL {
            hd_begin(mut_view(*st), 82);
            hd_attr(mut_view(*st), unsafe { (*cur).attrs });
            hd_vis(mut_view(*st), unsafe { view((*cur).vis) });
            hd_generic_params(mut_view(*st), unsafe { (*cur).generic_params });
            hd_type(mut_view(*st), unsafe { (*cur).trait_path });
            hd_type(mut_view(*st), unsafe { (*cur).self_type });
            hd_where_clause(mut_view(*st), unsafe { (*cur).where_clause });
            hd_item(mut_view(*st), unsafe { (*cur).members });
        } else if k == HIR_ITEM_TYPE_ALIAS {
            hd_begin(mut_view(*st), 83);
            hd_attr(mut_view(*st), unsafe { (*cur).attrs });
            hd_vis(mut_view(*st), unsafe { view((*cur).vis) });
            hd_strid(mut_view(*st), unsafe { (*cur).name });
            hd_generic_params(mut_view(*st), unsafe { (*cur).generic_params });
            hd_type(mut_view(*st), unsafe { (*cur).ty });
        } else if k == HIR_ITEM_CONST {
            hd_begin(mut_view(*st), 84);
            hd_attr(mut_view(*st), unsafe { (*cur).attrs });
            hd_vis(mut_view(*st), unsafe { view((*cur).vis) });
            hd_strid(mut_view(*st), unsafe { (*cur).name });
            hd_type(mut_view(*st), unsafe { (*cur).ty });
            hd_expr(mut_view(*st), unsafe { (*cur).expr });
        } else if k == HIR_ITEM_STATIC {
            hd_begin(mut_view(*st), 85);
            hd_attr(mut_view(*st), unsafe { (*cur).attrs });
            hd_vis(mut_view(*st), unsafe { view((*cur).vis) });
            hd_bool(mut_view(*st), unsafe { (*cur).is_unsafe });
            hd_bool(mut_view(*st), unsafe { (*cur).is_mut });
            hd_strid(mut_view(*st), unsafe { (*cur).name });
            hd_type(mut_view(*st), unsafe { (*cur).ty });
            hd_expr(mut_view(*st), unsafe { (*cur).expr });
        } else if k == HIR_ITEM_EXTERN_BLOCK {
            hd_begin(mut_view(*st), 86);
            hd_attr(mut_view(*st), unsafe { (*cur).attrs });
            hd_vis(mut_view(*st), unsafe { view((*cur).vis) });
            hd_strid(mut_view(*st), unsafe { (*cur).abi });
            hd_item(mut_view(*st), unsafe { (*cur).members });
        }
        hd_end(mut_view(*st));
        cur = unsafe { (*cur).next };
    }
}

pub fn emit_hir(buf: mut_view<DiagBuffer>, hir: view<HirFile>, interner: view<StrInterner>, filter_file: FileId) {
    let mut st = HirDumpState {
        buf: unsafe { address_of_mut(*buf) },
        interner: unsafe { address_of(*interner) },
        indent: 0,
        filter_file: FileId { v: filter_file.v },
    };
    hd_item(mut_view(st), hir.items);
    unsafe { diag_buf_push_byte(buf, 10u8); }
}



