pub fn ast_copy_span(sp: Span) -> Span {
    Span { file: FileId { v: sp.file.v }, start: sp.start, end: sp.end }
}

pub fn ast_set_span(dst: mut_view<Span>, sp: Span) {
    dst.file.v = sp.file.v;
    dst.start = sp.start;
    dst.end = sp.end;
}

pub fn ast_alloc_zeroed(a: *mut Arena, size: usize, align: usize) -> *mut u8 {
    let ptr = arena_alloc_raw(unsafe { mut_view(*a) }, size, align);
    let mut i: usize = 0;
    while i < size {
        unsafe {
            *(ptr + i) = 0u8;
        }
        i = i + 1;
    }
    ptr
}

pub unsafe fn str_id_ptr(base: *mut StrId, idx: usize) -> *mut StrId {
    ((base as usize) + (((idx as isize) * (size_of<StrId>() as isize)) as usize)) as *mut StrId
}

pub fn alloc_attr(a: *mut Arena, sp: Span) -> *mut AstAttr {
    let p = ast_alloc_zeroed(a, size_of<AstAttr>(), align_of<AstAttr>()) as *mut AstAttr;
    unsafe {
        ast_set_span(mut_view((*p).span), sp);
    }
    p
}

