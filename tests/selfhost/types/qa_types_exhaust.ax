pub struct RawIdTable {
    pub items: *mut u8,
    pub elem_size: usize,
    pub elem_align: usize,
    pub len: usize,
    pub cap: usize,
}

pub fn raw_idtable_new(elem_size: usize, elem_align: usize) -> RawIdTable {
    raw_idtable_with_capacity(0, elem_size, elem_align)
}

pub fn raw_idtable_with_capacity(capacity: usize, elem_size: usize, elem_align: usize) -> RawIdTable {
    let esz = if elem_size == 0 { 1 } else { elem_size };
    let eal = if elem_align == 0 { 1 } else { elem_align };
    if capacity == 0 {
        return RawIdTable {
            items: 0 as *mut u8,
            elem_size: esz,
            elem_align: eal,
            len: 0,
            cap: 0,
        };
    }
    let raw = unsafe { heap_alloc((((capacity as isize) * (esz as isize)) as usize), eal) };
    RawIdTable {
        items: raw,
        elem_size: esz,
        elem_align: eal,
        len: 0,
        cap: capacity,
    }
}

pub fn raw_idtable_free(t: mut_view<RawIdTable>) {
    if t.cap > 0 && t.items as usize != 0 {
        unsafe {
            heap_free(t.items, (((t.cap as isize) * (t.elem_size as isize)) as usize), t.elem_align);
        }
    }
    t.items = 0 as *mut u8;
    t.len = 0;
    t.cap = 0;
}

pub fn raw_idtable_clear(t: mut_view<RawIdTable>) {
    t.len = 0;
}

pub fn raw_idtable_len(t: view<RawIdTable>) -> usize {
    t.len
}

pub fn raw_idtable_is_empty(t: view<RawIdTable>) -> bool {
    t.len == 0
}

pub fn raw_idtable_contains(t: view<RawIdTable>, id_val: u32) -> bool {
    id_val != 0 && (id_val as usize) <= t.len
}

pub fn raw_idtable_push(t: mut_view<RawIdTable>, src: *const u8) -> u32 {
    if t.len == t.cap {
        let new_cap = if t.cap == 0 { 4 } else { t.cap + t.cap };
        let new_items = unsafe { heap_alloc((((new_cap as isize) * (t.elem_size as isize)) as usize), t.elem_align) };
        if t.len > 0 && t.items as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(t.items as *const u8, new_items, (((t.len as isize) * (t.elem_size as isize)) as usize));
                heap_free(t.items, (((t.cap as isize) * (t.elem_size as isize)) as usize), t.elem_align);
            }
        }
        t.items = new_items;
        t.cap = new_cap;
    }
    let dst = (t.items as usize + (((t.len as isize) * (t.elem_size as isize)) as usize)) as *mut u8;
    if src as usize != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(src, dst, t.elem_size);
        }
    }
    t.len = t.len + 1;
    t.len as u32
}

pub unsafe fn raw_idtable_get_ptr(t: view<RawIdTable>, id_val: u32) -> *const u8 {
    (t.items as usize + ((((id_val - 1) as isize) * (t.elem_size as isize)) as usize)) as *const u8
}

pub unsafe fn raw_idtable_get_mut_ptr(t: mut_view<RawIdTable>, id_val: u32) -> *mut u8 {
    (t.items as usize + ((((id_val - 1) as isize) * (t.elem_size as isize)) as usize)) as *mut u8
}

pub fn raw_idtable_first(t: view<RawIdTable>) -> u32 {
    if t.len == 0 { 0u32 } else { 1u32 }
}

pub fn raw_idtable_after(t: view<RawIdTable>, id_val: u32) -> u32 {
    if (id_val as usize) < t.len { id_val + 1u32 } else { 0u32 }
}

pub struct U32IdTable {
    pub raw: RawIdTable,
}

pub fn u32_idtable_new() -> U32IdTable {
    U32IdTable {
        raw: raw_idtable_new(4, 4),
    }
}

pub fn u32_idtable_with_capacity(capacity: usize) -> U32IdTable {
    U32IdTable {
        raw: raw_idtable_with_capacity(capacity, 4, 4),
    }
}

pub fn u32_idtable_free(t: mut_view<U32IdTable>) {
    raw_idtable_free(mut_view(t.raw));
}

pub fn u32_idtable_len(t: view<U32IdTable>) -> usize {
    t.raw.len
}

pub fn u32_idtable_is_empty(t: view<U32IdTable>) -> bool {
    t.raw.len == 0
}

pub fn u32_idtable_contains(t: view<U32IdTable>, id_val: u32) -> bool {
    raw_idtable_contains(view(t.raw), id_val)
}

pub fn u32_idtable_push(t: mut_view<U32IdTable>, val: u32) -> u32 {
    unsafe {
        raw_idtable_push(mut_view(t.raw), address_of(val) as *const u8)
    }
}

pub fn u32_idtable_get(t: view<U32IdTable>, id_val: u32) -> u32 {
    if !raw_idtable_contains(view(t.raw), id_val) {
        return 0u32;
    }
    unsafe {
        let p = raw_idtable_get_ptr(view(t.raw), id_val) as *const u32;
        *p
    }
}

pub fn u32_idtable_set(t: mut_view<U32IdTable>, id_val: u32, val: u32) -> bool {
    if !raw_idtable_contains(view(t.raw), id_val) {
        return false;
    }
    unsafe {
        let p = raw_idtable_get_mut_ptr(mut_view(t.raw), id_val) as *mut u32;
        *p = val;
    }
    true
}

pub fn u32_idtable_first(t: view<U32IdTable>) -> u32 {
    raw_idtable_first(view(t.raw))
}

pub fn u32_idtable_after(t: view<U32IdTable>, id_val: u32) -> u32 {
    raw_idtable_after(view(t.raw), id_val)
}

@intrinsic fn rotate_left_u64(x: u64, n: u32) -> u64 { 0 }

pub const AXH_K1: u64 = 0x9E3779B97F4A7C15;
pub const AXH_K2: u64 = 0xC2B2AE3D27D4EB4F;
pub const AXH_K3: u64 = 0x165667B19E3779F9;
pub const AXH_SEED: u64 = 0x27D4EB2F165667C5;
pub const AXH_M: u64 = 0x9FB21C651E98DF25;

pub fn ax_rotl64(x: u64, n: u32) -> u64 {
    rotate_left_u64(x, n)
}

fn axh_round(h: u64, w: u64) -> u64 {
    let m = wrapping_mul_u64(ax_rotl64(wrapping_mul_u64(w, AXH_K2), 31u32), AXH_K1);
    wrapping_add_u64(wrapping_mul_u64(ax_rotl64(h ^ m, 27u32), AXH_K1), AXH_K3)
}

fn axh_fold(h: u64) -> u64 {
    h ^ ax_rotl64(h, 15u32) ^ ax_rotl64(h, 40u32)
}

fn axh_avalanche(mut h: u64) -> u64 {
    h = wrapping_mul_u64(axh_fold(h), AXH_M);
    h = wrapping_mul_u64(axh_fold(h), AXH_K2);
    axh_fold(h)
}

pub struct AxHasher {
    pub h: u64,
    pub total_len: u64,
    pub buf: [8]u8,
    pub buf_len: usize,
}

pub fn ax_hasher_init(s: mut_view<AxHasher>) {
    s.h = AXH_SEED;
    s.total_len = 0u64;
    s.buf[0] = 0u8;
    s.buf[1] = 0u8;
    s.buf[2] = 0u8;
    s.buf[3] = 0u8;
    s.buf[4] = 0u8;
    s.buf[5] = 0u8;
    s.buf[6] = 0u8;
    s.buf[7] = 0u8;
    s.buf_len = 0;
}

pub fn ax_hasher_write(s: mut_view<AxHasher>, bytes: *const u8, mut byte_len: usize) {
    let mut p = bytes;
    let new_tlen = wrapping_add_u64(s.total_len, byte_len as u64);
    s.total_len = new_tlen;
    while byte_len > 0 {
        if s.buf_len == 0 && byte_len >= 8 {
            let mut w: u64 = 0u64;
            let mut j: usize = 0;
            while j < 8 {
                let b = (unsafe { *(p + j) }) as u64;
                let sh = ((j as u32) << 3u32);
                w = w | (b << (sh as u64));
                j = j + 1;
            }
            let nh = axh_round(s.h, w);
            s.h = nh;
            p = unsafe { p + 8 };
            byte_len = byte_len - 8;
            continue;
        }
        s.buf[s.buf_len] = unsafe { *p };
        s.buf_len = s.buf_len + 1;
        p = unsafe { p + 1 };
        byte_len = byte_len - 1;
        if s.buf_len == 8 {
            let mut w: u64 = 0u64;
            let mut j: usize = 0;
            while j < 8 {
                let b = s.buf[j] as u64;
                let sh = ((j as u32) << 3u32);
                w = w | (b << (sh as u64));
                j = j + 1;
            }
            let nh = axh_round(s.h, w);
            s.h = nh;
            s.buf_len = 0;
        }
    }
}

pub fn ax_hasher_write_u32(s: mut_view<AxHasher>, mut v: u32) {
    let mut i: usize = 0;
    while i < 4 {
        let nt = wrapping_add_u64(s.total_len, 1u64);
        s.total_len = nt;
        s.buf[s.buf_len] = (v & 0xFFu32) as u8;
        s.buf_len = s.buf_len + 1;
        if s.buf_len == 8 {
            let mut w: u64 = 0u64;
            let mut j: usize = 0;
            while j < 8 {
                let b = s.buf[j] as u64;
                let sh = ((j as u32) << 3u32);
                w = w | (b << (sh as u64));
                j = j + 1;
            }
            let nh = axh_round(s.h, w);
            s.h = nh;
            s.buf_len = 0;
        }
        v = v >> 8u32;
        i = i + 1;
    }
}

pub fn ax_hasher_write_u64(s: mut_view<AxHasher>, mut v: u64) {
    let mut i: usize = 0;
    while i < 8 {
        let nt = wrapping_add_u64(s.total_len, 1u64);
        s.total_len = nt;
        s.buf[s.buf_len] = (v & 0xFFu64) as u8;
        s.buf_len = s.buf_len + 1;
        if s.buf_len == 8 {
            let mut w: u64 = 0u64;
            let mut j: usize = 0;
            while j < 8 {
                let b = s.buf[j] as u64;
                let sh = ((j as u32) << 3u32);
                w = w | (b << (sh as u64));
                j = j + 1;
            }
            let nh = axh_round(s.h, w);
            s.h = nh;
            s.buf_len = 0;
        }
        v = v >> 8u64;
        i = i + 1;
    }
}

pub fn ax_hasher_finish(s: view<AxHasher>) -> u64 {
    let mut h = s.h;
    if s.buf_len > 0 {
        let mut w: u64 = 0u64;
        let mut j: usize = 0;
        while j < s.buf_len {
            let b = s.buf[j] as u64;
            let sh = ((j as u32) << 3u32);
            w = w | (b << (sh as u64));
            j = j + 1;
        }
        h = axh_round(h, w);
    }
    let m = wrapping_mul_u64(s.total_len, AXH_K3);
    h = h ^ m;
    axh_avalanche(h)
}

pub fn ax_hash_bytes(bytes: *const u8, byte_len: usize) -> u64 {
    let mut s = AxHasher {
        h: AXH_SEED,
        total_len: 0u64,
        buf: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8],
        buf_len: 0,
    };
    ax_hasher_write(mut_view(s), bytes, byte_len);
    ax_hasher_finish(view(s))
}

pub fn ax_hash_u64(v: u64) -> u64 {
    let mut s = AxHasher {
        h: AXH_SEED,
        total_len: 0u64,
        buf: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8],
        buf_len: 0,
    };
    ax_hasher_write_u64(mut_view(s), v);
    ax_hasher_finish(view(s))
}

pub fn ax_hash_u32(v: u32) -> u64 {
    let mut s = AxHasher {
        h: AXH_SEED,
        total_len: 0u64,
        buf: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8],
        buf_len: 0,
    };
    ax_hasher_write_u32(mut_view(s), v);
    ax_hasher_finish(view(s))
}

pub struct StrView {
    pub ptr: *const u8,
    pub len: usize,
}

fn bytes_eq(a: *const u8, b: *const u8, n: usize) -> bool {
    let mut i: usize = 0;
    while i < n {
        if (unsafe { *(a + i) }) != (unsafe { *(b + i) }) {
            return false;
        }
        i = i + 1;
    }
    true
}

pub struct StrInterner {
    pub bytes: Arena,
    pub strings: *mut StrView,
    pub len: usize,
    pub cap: usize,
    pub map_hashes: *mut u64,
    pub map_ids: *mut u32,
    pub map_cap: usize,
}

unsafe fn intern_sv_at(base: *mut StrView, idx: usize) -> *mut StrView {
    ((base as usize) + (((idx as isize) * (size_of<StrView>() as isize)) as usize)) as *mut StrView
}

unsafe fn intern_u64_at(base: *mut u64, idx: usize) -> *mut u64 {
    ((base as usize) + (idx << 3usize)) as *mut u64
}

unsafe fn intern_u32_at(base: *mut u32, idx: usize) -> *mut u32 {
    ((base as usize) + (idx << 2usize)) as *mut u32
}

pub fn interner_init(in_: mut_view<StrInterner>) {
    in_.bytes.head = 0 as *mut ArenaChunk;
    in_.strings = 0 as *mut StrView;
    in_.len = 0;
    in_.cap = 0;
    in_.map_hashes = 0 as *mut u64;
    in_.map_ids = 0 as *mut u32;
    in_.map_cap = 0;
}

pub fn interner_new() -> StrInterner {
    StrInterner {
        bytes: Arena { head: 0 as *mut ArenaChunk },
        strings: 0 as *mut StrView,
        len: 0,
        cap: 0,
        map_hashes: 0 as *mut u64,
        map_ids: 0 as *mut u32,
        map_cap: 0,
    }
}

pub fn interner_free(in_: mut_view<StrInterner>) {
    arena_destroy(mut_view(in_.bytes));
    if in_.cap > 0 && (in_.strings as usize) != 0 {
        unsafe {
            heap_free(in_.strings as *mut u8, (((in_.cap as isize) * (size_of<StrView>() as isize)) as usize), align_of<StrView>());
        }
    }
    if in_.map_cap > 0 && (in_.map_hashes as usize) != 0 {
        unsafe {
            heap_free(in_.map_hashes as *mut u8, in_.map_cap << 3usize, 8);
            heap_free(in_.map_ids as *mut u8, in_.map_cap << 2usize, 4);
        }
    }
    in_.strings = 0 as *mut StrView;
    in_.len = 0;
    in_.cap = 0;
    in_.map_hashes = 0 as *mut u64;
    in_.map_ids = 0 as *mut u32;
    in_.map_cap = 0;
}

fn interner_grow_map(in_: mut_view<StrInterner>) {
    let new_cap: usize = if in_.map_cap == 0 { 16 } else { in_.map_cap + in_.map_cap };
    let new_hashes: *mut u64 = unsafe { heap_alloc(new_cap << 3usize, 8) as *mut u64 };
    let new_ids: *mut u32 = unsafe { heap_alloc(new_cap << 2usize, 4) as *mut u32 };
    let mut j: usize = 0;
    while j < new_cap {
        let p_id = unsafe { intern_u32_at(new_ids, j) };
        unsafe {
            *p_id = 0u32;
        }
        j = j + 1;
    }

    let mask = new_cap - 1;
    let mut i: usize = 0;
    while i < in_.len {
        let sv_p = unsafe { intern_sv_at(in_.strings, i) };
        let sv_ptr = unsafe { (*sv_p).ptr };
        let sv_len = unsafe { (*sv_p).len };
        let h = ax_hash_bytes(sv_ptr, sv_len);
        let mut slot = (h as usize) & mask;
        while (unsafe { *intern_u32_at(new_ids, slot) }) != 0u32 {
            slot = (slot + 1) & mask;
        }
        let p_h = unsafe { intern_u64_at(new_hashes, slot) };
        let p_id = unsafe { intern_u32_at(new_ids, slot) };
        unsafe {
            *p_h = h;
            *p_id = (i + 1) as u32;
        }
        i = i + 1;
    }

    if in_.map_cap > 0 && (in_.map_hashes as usize) != 0 {
        unsafe {
            heap_free(in_.map_hashes as *mut u8, in_.map_cap << 3usize, 8);
            heap_free(in_.map_ids as *mut u8, in_.map_cap << 2usize, 4);
        }
    }
    in_.map_hashes = new_hashes;
    in_.map_ids = new_ids;
    in_.map_cap = new_cap;
}

pub fn interner_intern_bytes(in_: mut_view<StrInterner>, p_s: *const u8, n: usize) -> StrId {
    let h = ax_hash_bytes(p_s, n);

    if in_.map_cap > 0 {
        let mask = in_.map_cap - 1;
        let mut slot = (h as usize) & mask;
        while true {
            let id_v = unsafe { *intern_u32_at(in_.map_ids, slot) };
            if id_v == 0u32 {
                break;
            }
            if (unsafe { *intern_u64_at(in_.map_hashes, slot) }) == h {
                let sv_p = unsafe { intern_sv_at(in_.strings, (id_v - 1u32) as usize) };
                let sv_ptr = unsafe { (*sv_p).ptr };
                let sv_len = unsafe { (*sv_p).len };
                if sv_len == n && bytes_eq(sv_ptr, p_s, n) {
                    return StrId { v: id_v };
                }
            }
            slot = (slot + 1) & mask;
        }
    }

    let copy = arena_alloc_raw(mut_view(in_.bytes), n + 1, 1);
    if n > 0 && (p_s as usize) != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(p_s, copy, n);
            *(copy + n) = 0u8;
        }
    }

    if in_.len == in_.cap {
        let new_cap: usize = if in_.cap == 0 { 8 } else { in_.cap + in_.cap };
        let new_bytes = (((new_cap as isize) * (size_of<StrView>() as isize)) as usize);
        let new_strings: *mut StrView = unsafe { heap_alloc(new_bytes, align_of<StrView>()) as *mut StrView };
        if in_.len > 0 && (in_.strings as usize) != 0 {
            let old_bytes = (((in_.len as isize) * (size_of<StrView>() as isize)) as usize);
            let cap_bytes = (((in_.cap as isize) * (size_of<StrView>() as isize)) as usize);
            unsafe {
                ptr_copy_nonoverlapping<u8>(in_.strings as *const u8, new_strings as *mut u8, old_bytes);
                heap_free(in_.strings as *mut u8, cap_bytes, align_of<StrView>());
            }
        }
        in_.strings = new_strings;
        in_.cap = new_cap;
    }

    let dst_sv = unsafe { intern_sv_at(in_.strings, in_.len) };
    unsafe {
        (*dst_sv).ptr = copy as *const u8;
        (*dst_sv).len = n;
    }
    let new_id_v = (in_.len + 1) as u32;
    in_.len = in_.len + 1;

    if in_.map_cap == 0 || (in_.len << 2usize) > (in_.map_cap + in_.map_cap + in_.map_cap) {
        interner_grow_map(in_);
    } else {
        let mask = in_.map_cap - 1;
        let mut slot = (h as usize) & mask;
        while (unsafe { *intern_u32_at(in_.map_ids, slot) }) != 0u32 {
            slot = (slot + 1) & mask;
        }
        let p_h = unsafe { intern_u64_at(in_.map_hashes, slot) };
        let p_id = unsafe { intern_u32_at(in_.map_ids, slot) };
        unsafe {
            *p_h = h;
            *p_id = new_id_v;
        }
    }

    StrId { v: new_id_v }
}

pub fn interner_intern_str(in_: mut_view<StrInterner>, s: view<Str>) -> StrId {
    let p_s = unsafe { *(address_of(*s) as *const *const u8) };
    let n = len(*s);
    interner_intern_bytes(in_, p_s, n)
}

pub fn interner_get(in_: view<StrInterner>, id: StrId) -> StrView {
    if id.v == 0u32 || (id.v as usize) > in_.len {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let sv_p = unsafe { intern_sv_at(in_.strings, (id.v - 1u32) as usize) };
    let p = unsafe { (*sv_p).ptr };
    let l = unsafe { (*sv_p).len };
    StrView { ptr: p, len: l }
}

pub fn interner_len(in_: view<StrInterner>) -> usize {
    in_.len
}

pub fn interner_is_empty(in_: view<StrInterner>) -> bool {
    in_.len == 0
}

pub struct U32Interner {
    pub items: *mut u32,
    pub len: usize,
    pub cap: usize,
    pub map_hashes: *mut u64,
    pub map_ids: *mut u32,
    pub map_cap: usize,
}

pub fn u32_interner_new() -> U32Interner {
    U32Interner {
        items: 0 as *mut u32,
        len: 0,
        cap: 0,
        map_hashes: 0 as *mut u64,
        map_ids: 0 as *mut u32,
        map_cap: 0,
    }
}

pub fn u32_interner_free(in_: mut_view<U32Interner>) {
    if in_.cap > 0 && in_.items as usize != 0 {
        unsafe {
            heap_free(in_.items as *mut u8, (in_.cap << 2), 4);
        }
    }
    if in_.map_cap > 0 && in_.map_hashes as usize != 0 {
        unsafe {
            heap_free(in_.map_hashes as *mut u8, (in_.map_cap << 3), 8);
            heap_free(in_.map_ids as *mut u8, (in_.map_cap << 2), 4);
        }
    }
    in_.items = 0 as *mut u32;
    in_.len = 0;
    in_.cap = 0;
    in_.map_hashes = 0 as *mut u64;
    in_.map_ids = 0 as *mut u32;
    in_.map_cap = 0;
}

fn u32_interner_grow_map(in_: mut_view<U32Interner>) {
    let new_cap: usize = if in_.map_cap == 0 { 16 } else { in_.map_cap + in_.map_cap };
    let new_hashes: *mut u64 = unsafe { heap_alloc((new_cap << 3), 8) as *mut u64 };
    let new_ids: *mut u32 = unsafe { heap_alloc((new_cap << 2), 4) as *mut u32 };
    let mut j: usize = 0;
    while j < new_cap {
        unsafe {
            *(new_ids + j) = 0u32;
        }
        j = j + 1;
    }

    let mask = new_cap - 1;
    let mut i: usize = 0;
    while i < in_.len {
        let val = unsafe { *(in_.items + i) };
        let h = ax_hash_u32(val);
        let mut slot = (h as usize) & mask;
        while unsafe { *(new_ids + slot) } != 0u32 {
            slot = (slot + 1) & mask;
        }
        unsafe {
            *(new_hashes + slot) = h;
            *(new_ids + slot) = (i + 1) as u32;
        }
        i = i + 1;
    }

    if in_.map_cap > 0 && in_.map_hashes as usize != 0 {
        unsafe {
            heap_free(in_.map_hashes as *mut u8, (in_.map_cap << 3), 8);
            heap_free(in_.map_ids as *mut u8, (in_.map_cap << 2), 4);
        }
    }
    in_.map_hashes = new_hashes;
    in_.map_ids = new_ids;
    in_.map_cap = new_cap;
}

pub fn u32_intern(in_: mut_view<U32Interner>, val: u32) -> u32 {
    let h = ax_hash_u32(val);
    if in_.map_cap > 0 {
        let mask = in_.map_cap - 1;
        let mut slot = (h as usize) & mask;
        while true {
            let id_v = unsafe { *(in_.map_ids + slot) };
            if id_v == 0u32 {
                break;
            }
            if unsafe { *(in_.map_hashes + slot) } == h {
                let existing = unsafe { *(in_.items + ((id_v - 1) as usize)) };
                if existing == val {
                    return id_v;
                }
            }
            slot = (slot + 1) & mask;
        }
    }

    if in_.len == in_.cap {
        let new_cap: usize = if in_.cap == 0 { 8 } else { in_.cap + in_.cap };
        let new_items: *mut u32 = unsafe { heap_alloc((new_cap << 2), 4) as *mut u32 };
        if in_.len > 0 && in_.items as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u32>(in_.items as *const u32, new_items, in_.len);
                heap_free(in_.items as *mut u8, (in_.cap << 2), 4);
            }
        }
        in_.items = new_items;
        in_.cap = new_cap;
    }

    unsafe {
        *(in_.items + in_.len) = val;
    }
    let new_id = (in_.len + 1) as u32;
    in_.len = in_.len + 1;

    if in_.map_cap == 0 || ((in_.len as isize) * 4isize) > ((in_.map_cap as isize) * 3isize) {
        u32_interner_grow_map(in_);
    } else {
        let mask = in_.map_cap - 1;
        let mut slot = (h as usize) & mask;
        while unsafe { *(in_.map_ids + slot) } != 0u32 {
            slot = (slot + 1) & mask;
        }
        unsafe {
            *(in_.map_hashes + slot) = h;
            *(in_.map_ids + slot) = new_id;
        }
    }

    new_id
}

pub fn u32_interner_lookup(in_: view<U32Interner>, val: u32) -> u32 {
    if in_.map_cap == 0 || in_.len == 0 {
        return 0u32;
    }
    let h = ax_hash_u32(val);
    let mask = in_.map_cap - 1;
    let mut slot = (h as usize) & mask;
    while true {
        let id_v = unsafe { *(in_.map_ids + slot) };
        if id_v == 0u32 {
            return 0u32;
        }
        if unsafe { *(in_.map_hashes + slot) } == h {
            let existing = unsafe { *(in_.items + ((id_v - 1) as usize)) };
            if existing == val {
                return id_v;
            }
        }
        slot = (slot + 1) & mask;
    }
    0u32
}

pub fn u32_interner_get(in_: view<U32Interner>, id: u32) -> u32 {
    if id == 0 || (id as usize) > in_.len {
        return 0u32;
    }
    unsafe {
        *(in_.items + ((id - 1) as usize))
    }
}

pub fn u32_interner_len(in_: view<U32Interner>) -> usize {
    in_.len
}

pub fn u32_interner_is_empty(in_: view<U32Interner>) -> bool {
    in_.len == 0
}


pub struct Span {
    pub file: FileId,
    pub start: u32,
    pub end: u32,
}

impl Span {
    pub fn new(file: FileId, start: u32, end: u32) -> Span {
        Span { file: file, start: start, end: end }
    }

    pub fn none() -> Span {
        Span { file: FileId.none(), start: 0u32, end: 0u32 }
    }

    pub fn is_none(self: view<Span>) -> bool {
        self.file.is_none()
    }

    pub fn is_some(self: view<Span>) -> bool {
        self.file.is_some()
    }

    pub fn len(self: view<Span>) -> u32 {
        if self.end >= self.start {
            self.end - self.start
        } else {
            0u32
        }
    }

    pub fn eq(self: view<Span>, other: view<Span>) -> bool {
        self.file.eq(view(other.file)) && self.start == other.start && self.end == other.end
    }
}

pub fn span_new(file: FileId, start: u32, end: u32) -> Span {
    Span.new(file, start, end)
}

pub fn span_none() -> Span {
    Span.none()
}

pub fn span_is_none(s: view<Span>) -> bool {
    s.is_none()
}

pub struct LineCol {
    pub line: u32,       // 1-based line number
    pub col_bytes: u32,  // 1-based column in bytes
    pub col_chars: u32,  // 1-based column in Unicode scalar values
}

impl LineCol {
    pub fn zero() -> LineCol {
        LineCol { line: 0u32, col_bytes: 0u32, col_chars: 0u32 }
    }

    pub fn eq(self: view<LineCol>, other: view<LineCol>) -> bool {
        self.line == other.line && self.col_bytes == other.col_bytes && self.col_chars == other.col_chars
    }
}

@derive(Copy)
pub enum DiagSeverity {
    Error,
    Warning,
    Info,
    Hint,
}

@derive(Copy)
pub enum FixApplicability {
    MachineApplicable,
    MaybeApplicable,
    ManualReview,
}

@derive(Copy)
pub enum DiagDataKind {
    String,
    Integer,
    Boolean,
    StringList,
}

@derive(Copy)
pub struct DiagCode {
    pub v: u32,
}

pub fn diag_code(v: u32) -> DiagCode {
    DiagCode { v: v }
}

pub fn diag_code_eq(a: DiagCode, b: DiagCode) -> bool {
    a.v == b.v
}

