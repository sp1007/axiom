fn ast_buf_tag(b: mut_view<DiagBuffer>, tag_idx: usize) {
    let start = AST_TAG_OFF[tag_idx] as usize;
    let end = AST_TAG_OFF[tag_idx + 1] as usize;
    let mut i = start;
    while i < end {
        diag_buf_push_byte(mut_view(*b), AST_TAG_DATA[i]);
        i = i + 1;
    }
}

fn ast_buf_id(b: mut_view<DiagBuffer>, interner: view<StrInterner>, id_v: u32) {
    if id_v == 0u32 { return; }
    let sv = interner_get(interner, StrId { v: id_v });
    diag_buf_push_bytes(b, sv.ptr, sv.len);
}

fn ast_id_eq_tag(interner: view<StrInterner>, id_v: u32, tag_idx: usize) -> bool {
    if id_v == 0u32 { return false; }
    let sv = interner_get(interner, StrId { v: id_v });
    let start = AST_TAG_OFF[tag_idx] as usize;
    let end = AST_TAG_OFF[tag_idx + 1] as usize;
    if sv.len != end - start {
        return false;
    }
    let mut i: usize = 0;
    while i < sv.len {
        if (unsafe { *(sv.ptr + i) }) != AST_TAG_DATA[start + i] {
            return false;
        }
        i = i + 1;
    }
    true
}

pub fn ast_format_derive(interner: view<StrInterner>, item: *const AstItem, tname: StrId, buf: mut_view<DiagBuffer>) -> bool {
    let sname = unsafe { (*item).name };
    let sfields = unsafe { (*item).struct_fields as *const AstFieldDecl };
    let is_tup = unsafe { (*item).is_tuple };
    if ast_id_eq_tag(interner, tname.v, 81) {
        ast_buf_tag(mut_view(*buf), 87);
        ast_buf_id(mut_view(*buf), interner, sname.v);
        ast_buf_tag(mut_view(*buf), 88);
        return true;
    }
    if ast_id_eq_tag(interner, tname.v, 82) {
        ast_buf_tag(mut_view(*buf), 89);
        ast_buf_id(mut_view(*buf), interner, sname.v);
        ast_buf_tag(mut_view(*buf), 90);
        ast_buf_id(mut_view(*buf), interner, sname.v);
        ast_buf_tag(mut_view(*buf), 91);
        ast_buf_id(mut_view(*buf), interner, sname.v);
        ast_buf_tag(mut_view(*buf), 92);
        if !is_tup {
            ast_buf_id(mut_view(*buf), interner, sname.v);
            ast_buf_tag(mut_view(*buf), 92);
            let mut f = sfields;
            while f as usize != 0 {
                let fnm = unsafe { (*f).name };
                ast_buf_id(mut_view(*buf), interner, fnm.v);
                ast_buf_tag(mut_view(*buf), 93);
                ast_buf_id(mut_view(*buf), interner, fnm.v);
                ast_buf_tag(mut_view(*buf), 94);
                f = unsafe { (*f).next as *const AstFieldDecl };
            }
            ast_buf_tag(mut_view(*buf), 95);
        } else {
            ast_buf_tag(mut_view(*buf), 96);
        }
        return true;
    }
    if ast_id_eq_tag(interner, tname.v, 83) {
        ast_buf_tag(mut_view(*buf), 97);
        ast_buf_id(mut_view(*buf), interner, sname.v);
        ast_buf_tag(mut_view(*buf), 88);
        return true;
    }
    if ast_id_eq_tag(interner, tname.v, 84) {
        ast_buf_tag(mut_view(*buf), 98);
        ast_buf_id(mut_view(*buf), interner, sname.v);
        ast_buf_tag(mut_view(*buf), 99);
        ast_buf_id(mut_view(*buf), interner, sname.v);
        ast_buf_tag(mut_view(*buf), 100);
        ast_buf_id(mut_view(*buf), interner, sname.v);
        ast_buf_tag(mut_view(*buf), 101);
        if sfields as usize == 0 {
            ast_buf_tag(mut_view(*buf), 102);
        } else {
            let mut f = sfields;
            while f as usize != 0 {
                let fnm = unsafe { (*f).name };
                ast_buf_tag(mut_view(*buf), 103);
                ast_buf_id(mut_view(*buf), interner, fnm.v);
                ast_buf_tag(mut_view(*buf), 104);
                ast_buf_id(mut_view(*buf), interner, fnm.v);
                if (unsafe { (*f).next }) as usize != 0 {
                    ast_buf_tag(mut_view(*buf), 105);
                }
                f = unsafe { (*f).next as *const AstFieldDecl };
            }
        }
        ast_buf_tag(mut_view(*buf), 106);
        ast_buf_tag(mut_view(*buf), 96);
        return true;
    }
    if ast_id_eq_tag(interner, tname.v, 85) {
        ast_buf_tag(mut_view(*buf), 107);
        ast_buf_id(mut_view(*buf), interner, sname.v);
        ast_buf_tag(mut_view(*buf), 108);
        ast_buf_id(mut_view(*buf), interner, sname.v);
        ast_buf_tag(mut_view(*buf), 109);
        let mut f = sfields;
        while f as usize != 0 {
            let fnm = unsafe { (*f).name };
            ast_buf_tag(mut_view(*buf), 103);
            ast_buf_id(mut_view(*buf), interner, fnm.v);
            ast_buf_tag(mut_view(*buf), 110);
            f = unsafe { (*f).next as *const AstFieldDecl };
        }
        ast_buf_tag(mut_view(*buf), 95);
        return true;
    }
    if ast_id_eq_tag(interner, tname.v, 86) {
        ast_buf_tag(mut_view(*buf), 111);
        ast_buf_id(mut_view(*buf), interner, sname.v);
        ast_buf_tag(mut_view(*buf), 112);
        ast_buf_id(mut_view(*buf), interner, sname.v);
        ast_buf_tag(mut_view(*buf), 100);
        ast_buf_id(mut_view(*buf), interner, sname.v);
        ast_buf_tag(mut_view(*buf), 113);
        let mut f = sfields;
        while f as usize != 0 {
            let fnm = unsafe { (*f).name };
            ast_buf_tag(mut_view(*buf), 115);
            ast_buf_id(mut_view(*buf), interner, fnm.v);
            ast_buf_tag(mut_view(*buf), 116);
            ast_buf_id(mut_view(*buf), interner, fnm.v);
            ast_buf_tag(mut_view(*buf), 117);
            f = unsafe { (*f).next as *const AstFieldDecl };
        }
        ast_buf_tag(mut_view(*buf), 114);
        ast_buf_tag(mut_view(*buf), 118);
        return true;
    }
    false
}

struct DumpState {
    out: *mut DiagBuffer,
    interner: *const StrInterner,
    indent: usize,
    filter_file: FileId,
}

fn d_tag(st: mut_view<DumpState>, tag_idx: usize) {
    ast_buf_tag(unsafe { mut_view(*st.out) }, tag_idx);
}

fn d_nl(st: mut_view<DumpState>) {
    diag_buf_push_byte(unsafe { mut_view(*st.out) }, 10u8);
    let mut i: usize = 0;
    while i < st.indent {
        diag_buf_push_byte(unsafe { mut_view(*st.out) }, 32u8);
        diag_buf_push_byte(unsafe { mut_view(*st.out) }, 32u8);
        i = i + 1;
    }
}

fn d_list_begin(st: mut_view<DumpState>, tag_idx: usize) {
    diag_buf_push_byte(unsafe { mut_view(*st.out) }, 40u8);
    d_tag(mut_view(*st), tag_idx);
    st.indent = st.indent + 1;
}

fn d_list_end(st: mut_view<DumpState>) {
    st.indent = st.indent - 1;
    diag_buf_push_byte(unsafe { mut_view(*st.out) }, 41u8);
}

fn d_strid(st: mut_view<DumpState>, id: StrId) {
    if id.v == 0u32 {
        d_tag(mut_view(*st), 80);
        return;
    }
    let sv = interner_get(unsafe { view(*st.interner) }, id);
    diag_buf_push_byte(unsafe { mut_view(*st.out) }, 32u8);
    diag_buf_push_byte(unsafe { mut_view(*st.out) }, 34u8);
    diag_buf_push_bytes(unsafe { mut_view(*st.out) }, sv.ptr, sv.len);
    diag_buf_push_byte(unsafe { mut_view(*st.out) }, 34u8);
}

fn d_bool(st: mut_view<DumpState>, b: bool) {
    if b {
        d_tag(mut_view(*st), 78);
    } else {
        d_tag(mut_view(*st), 79);
    }
}

fn d_int(st: mut_view<DumpState>, val: u32) {
    diag_buf_push_byte(unsafe { mut_view(*st.out) }, 32u8);
    diag_buf_push_u32(unsafe { mut_view(*st.out) }, val);
}

fn d_dotted_name(st: mut_view<DumpState>, n: view<AstDottedName>) {
    d_nl(mut_view(*st));
    d_list_begin(mut_view(*st), 0);
    let mut i: usize = 0;
    while i < n.count {
        let sid = unsafe { *(str_id_ptr(n.segments, i)) };
        d_strid(mut_view(*st), sid);
        i = i + 1;
    }
    d_list_end(mut_view(*st));
}

fn d_vis(st: mut_view<DumpState>, n: view<AstVis>) {
    d_nl(mut_view(*st));
    d_list_begin(mut_view(*st), 1);
    d_tag(mut_view(*st), (2u8 + n.kind) as usize);
    d_list_end(mut_view(*st));
}

fn d_attr(st: mut_view<DumpState>, head: *const AstAttr) {
    let mut cur = head;
    while cur as usize != 0 {
        d_nl(mut_view(*st));
        d_list_begin(mut_view(*st), 6);
        d_strid(mut_view(*st), unsafe { (*cur).name });
        let mut a = unsafe { (*cur).args as *const AstAttrArg };
        while a as usize != 0 {
            d_nl(mut_view(*st));
            d_list_begin(mut_view(*st), 7);
            d_strid(mut_view(*st), unsafe { (*a).name });
            d_expr(mut_view(*st), unsafe { (*a).expr as *const AstExpr });
            d_list_end(mut_view(*st));
            a = unsafe { (*a).next as *const AstAttrArg };
        }
        d_list_end(mut_view(*st));
        cur = unsafe { (*cur).next as *const AstAttr };
    }
}

fn d_generic_args(st: mut_view<DumpState>, n: *const AstGenericArgs) {
    if n as usize == 0 {
        return;
    }
    let mut a = unsafe { (*n).args as *const AstGenericArg };
    while a as usize != 0 {
        d_nl(mut_view(*st));
        d_list_begin(mut_view(*st), 8);
        d_strid(mut_view(*st), unsafe { (*a).name });
        d_type(mut_view(*st), unsafe { (*a).ty as *const AstType });
        d_list_end(mut_view(*st));
        a = unsafe { (*a).next as *const AstGenericArg };
    }
}

fn d_generic_params(st: mut_view<DumpState>, n: *const AstGenericParams) {
    if n as usize == 0 {
        return;
    }
    let mut a = unsafe { (*n).params as *const AstGenericParam };
    while a as usize != 0 {
        d_nl(mut_view(*st));
        d_list_begin(mut_view(*st), 9);
        d_strid(mut_view(*st), unsafe { (*a).name });
        d_type(mut_view(*st), unsafe { (*a).bounds as *const AstType });
        d_list_end(mut_view(*st));
        a = unsafe { (*a).next as *const AstGenericParam };
    }
}

fn d_where_clause(st: mut_view<DumpState>, n: *const AstWhereClause) {
    if n as usize == 0 {
        return;
    }
    let mut a = unsafe { (*n).preds as *const AstWherePred };
    while a as usize != 0 {
        d_nl(mut_view(*st));
        d_list_begin(mut_view(*st), 10);
        d_type(mut_view(*st), unsafe { (*a).ty as *const AstType });
        d_type(mut_view(*st), unsafe { (*a).bounds as *const AstType });
        d_list_end(mut_view(*st));
        a = unsafe { (*a).next as *const AstWherePred };
    }
}

fn d_path_seg(st: mut_view<DumpState>, head: *const AstTypePathSegment) {
    let mut cur = head;
    while cur as usize != 0 {
        d_nl(mut_view(*st));
        d_list_begin(mut_view(*st), 11);
        d_strid(mut_view(*st), unsafe { (*cur).name });
        d_generic_args(mut_view(*st), unsafe { (*cur).generic_args as *const AstGenericArgs });
        d_list_end(mut_view(*st));
        cur = unsafe { (*cur).next as *const AstTypePathSegment };
    }
}

fn d_block(st: mut_view<DumpState>, n: *const AstBlock) {
    if n as usize == 0 {
        return;
    }
    d_nl(mut_view(*st));
    d_list_begin(mut_view(*st), 12);
    d_stmt(mut_view(*st), unsafe { (*n).stmts as *const AstStmt });
    d_list_end(mut_view(*st));
}

fn d_params(st: mut_view<DumpState>, head: *const AstParam) {
    let mut p = head;
    while p as usize != 0 {
        d_nl(mut_view(*st));
        d_list_begin(mut_view(*st), 57);
        d_bool(mut_view(*st), unsafe { (*p).is_mut });
        d_strid(mut_view(*st), unsafe { (*p).name });
        d_type(mut_view(*st), unsafe { (*p).ty as *const AstType });
        d_list_end(mut_view(*st));
        p = unsafe { (*p).next as *const AstParam };
    }
}

fn d_field_decls(st: mut_view<DumpState>, head: *const AstFieldDecl) {
    let mut f = head;
    while f as usize != 0 {
        d_nl(mut_view(*st));
        d_list_begin(mut_view(*st), 76);
        d_attr(mut_view(*st), unsafe { (*f).attrs as *const AstAttr });
        d_vis(mut_view(*st), unsafe { view((*f).vis) });
        d_strid(mut_view(*st), unsafe { (*f).name });
        d_type(mut_view(*st), unsafe { (*f).ty as *const AstType });
        d_list_end(mut_view(*st));
        f = unsafe { (*f).next as *const AstFieldDecl };
    }
}

fn d_type(st: mut_view<DumpState>, head: *const AstType) {
    let mut n = head;
    while n as usize != 0 {
        d_nl(mut_view(*st));
        let k = unsafe { (*n).kind };
        d_list_begin(mut_view(*st), (13u8 + k) as usize);
        if k == TYPE_PATH {
            d_path_seg(mut_view(*st), unsafe { (*n).segments as *const AstTypePathSegment });
        } else if k == TYPE_TUPLE {
            d_type(mut_view(*st), unsafe { (*n).elem_types as *const AstType });
        } else if k == TYPE_ARRAY {
            d_expr(mut_view(*st), unsafe { (*n).count_expr as *const AstExpr });
            d_type(mut_view(*st), unsafe { (*n).elem as *const AstType });
        } else if k == TYPE_SLICE {
            d_type(mut_view(*st), unsafe { (*n).elem as *const AstType });
        } else if k == TYPE_VIEW || k == TYPE_PTR {
            d_bool(mut_view(*st), unsafe { (*n).is_mut });
            d_type(mut_view(*st), unsafe { (*n).elem as *const AstType });
        } else if k == TYPE_FN {
            d_bool(mut_view(*st), unsafe { (*n).is_unsafe });
            d_strid(mut_view(*st), unsafe { (*n).abi });
            d_type(mut_view(*st), unsafe { (*n).param_types as *const AstType });
            d_type(mut_view(*st), unsafe { (*n).ret_type as *const AstType });
        } else if k == TYPE_DYN {
            d_type(mut_view(*st), unsafe { (*n).bounds as *const AstType });
        }
        d_list_end(mut_view(*st));
        n = unsafe { (*n).next as *const AstType };
    }
}

fn d_pat(st: mut_view<DumpState>, head: *const AstPat) {
    let mut n = head;
    while n as usize != 0 {
        d_nl(mut_view(*st));
        let k = unsafe { (*n).kind };
        d_list_begin(mut_view(*st), (23u8 + k) as usize);
        if k == PAT_RANGE {
            d_bool(mut_view(*st), unsafe { (*n).is_inclusive });
            d_pat(mut_view(*st), unsafe { (*n).start_pat as *const AstPat });
            d_pat(mut_view(*st), unsafe { (*n).end_pat as *const AstPat });
        } else if k == PAT_LITERAL {
            d_bool(mut_view(*st), unsafe { (*n).is_negated });
        } else if k == PAT_BINDING {
            d_bool(mut_view(*st), unsafe { (*n).is_mut });
            d_strid(mut_view(*st), unsafe { (*n).name });
        } else if k == PAT_PATH {
            d_path_seg(mut_view(*st), unsafe { (*n).segments as *const AstTypePathSegment });
            d_pat(mut_view(*st), unsafe { (*n).payload as *const AstPat });
        } else if k == PAT_TUPLE {
            d_pat(mut_view(*st), unsafe { (*n).elems as *const AstPat });
        } else if k == PAT_OR {
            d_pat(mut_view(*st), unsafe { (*n).pats as *const AstPat });
        } else if k == PAT_STRUCT {
            d_path_seg(mut_view(*st), unsafe { (*n).segments as *const AstTypePathSegment });
            let mut f = unsafe { (*n).fields as *const AstPatField };
            while f as usize != 0 {
                d_nl(mut_view(*st));
                d_list_begin(mut_view(*st), 22);
                d_strid(mut_view(*st), unsafe { (*f).name });
                d_pat(mut_view(*st), unsafe { (*f).pat as *const AstPat });
                d_list_end(mut_view(*st));
                f = unsafe { (*f).next as *const AstPatField };
            }
            d_bool(mut_view(*st), unsafe { (*n).has_rest });
        }
        d_list_end(mut_view(*st));
        n = unsafe { (*n).next as *const AstPat };
    }
}

fn d_expr(st: mut_view<DumpState>, head: *const AstExpr) {
    let mut n = head;
    while n as usize != 0 {
        d_nl(mut_view(*st));
        let k = unsafe { (*n).kind };
        d_list_begin(mut_view(*st), (32u8 + k) as usize);
        if k == EXPR_PATH {
            d_path_seg(mut_view(*st), unsafe { (*n).segments as *const AstTypePathSegment });
        } else if k == EXPR_PAREN {
            d_expr(mut_view(*st), unsafe { (*n).inner as *const AstExpr });
        } else if k == EXPR_ARRAY {
            d_expr(mut_view(*st), unsafe { (*n).elems as *const AstExpr });
            d_expr(mut_view(*st), unsafe { (*n).count_expr as *const AstExpr });
        } else if k == EXPR_TUPLE {
            d_expr(mut_view(*st), unsafe { (*n).elems as *const AstExpr });
        } else if k == EXPR_STRUCT {
            d_path_seg(mut_view(*st), unsafe { (*n).segments as *const AstTypePathSegment });
            let mut f = unsafe { (*n).fields as *const AstFieldInit };
            while f as usize != 0 {
                d_nl(mut_view(*st));
                d_list_begin(mut_view(*st), 55);
                d_strid(mut_view(*st), unsafe { (*f).name });
                d_expr(mut_view(*st), unsafe { (*f).expr as *const AstExpr });
                d_list_end(mut_view(*st));
                f = unsafe { (*f).next as *const AstFieldInit };
            }
        } else if k == EXPR_BLOCK || k == EXPR_UNSAFE || k == EXPR_COMPTIME {
            d_block(mut_view(*st), unsafe { (*n).block as *const AstBlock });
        } else if k == EXPR_IF {
            d_pat(mut_view(*st), unsafe { (*n).let_pat as *const AstPat });
            d_expr(mut_view(*st), unsafe { (*n).cond as *const AstExpr });
            d_block(mut_view(*st), unsafe { (*n).block as *const AstBlock });
            d_expr(mut_view(*st), unsafe { (*n).else_branch as *const AstExpr });
        } else if k == EXPR_MATCH {
            d_expr(mut_view(*st), unsafe { (*n).cond as *const AstExpr });
            let mut a = unsafe { (*n).arms as *const AstMatchArm };
            while a as usize != 0 {
                d_nl(mut_view(*st));
                d_list_begin(mut_view(*st), 56);
                d_pat(mut_view(*st), unsafe { (*a).pat as *const AstPat });
                d_expr(mut_view(*st), unsafe { (*a).guard as *const AstExpr });
                d_expr(mut_view(*st), unsafe { (*a).body as *const AstExpr });
                d_list_end(mut_view(*st));
                a = unsafe { (*a).next as *const AstMatchArm };
            }
        } else if k == EXPR_LOOP {
            d_strid(mut_view(*st), unsafe { (*n).label });
            d_block(mut_view(*st), unsafe { (*n).block as *const AstBlock });
        } else if k == EXPR_WHILE {
            d_strid(mut_view(*st), unsafe { (*n).label });
            d_pat(mut_view(*st), unsafe { (*n).let_pat as *const AstPat });
            d_expr(mut_view(*st), unsafe { (*n).cond as *const AstExpr });
            d_block(mut_view(*st), unsafe { (*n).block as *const AstBlock });
        } else if k == EXPR_FOR {
            d_strid(mut_view(*st), unsafe { (*n).label });
            d_pat(mut_view(*st), unsafe { (*n).pat as *const AstPat });
            d_expr(mut_view(*st), unsafe { (*n).iter as *const AstExpr });
            d_block(mut_view(*st), unsafe { (*n).block as *const AstBlock });
        } else if k == EXPR_VIEW {
            d_bool(mut_view(*st), unsafe { (*n).is_mut });
            d_expr(mut_view(*st), unsafe { (*n).inner as *const AstExpr });
        } else if k == EXPR_JUMP {
            d_int(mut_view(*st), (unsafe { (*n).jump_kind }) as u32);
            d_strid(mut_view(*st), unsafe { (*n).label });
            d_expr(mut_view(*st), unsafe { (*n).inner as *const AstExpr });
        } else if k == EXPR_CLOSURE {
            d_params(mut_view(*st), unsafe { (*n).params as *const AstParam });
            d_type(mut_view(*st), unsafe { (*n).ret_type as *const AstType });
            d_expr(mut_view(*st), unsafe { (*n).body as *const AstExpr });
        } else if k == EXPR_RANGE {
            d_bool(mut_view(*st), unsafe { (*n).is_inclusive });
            d_expr(mut_view(*st), unsafe { (*n).start_expr as *const AstExpr });
            d_expr(mut_view(*st), unsafe { (*n).end_expr as *const AstExpr });
        } else if k == EXPR_BINARY {
            d_int(mut_view(*st), (unsafe { (*n).op }) as u32);
            d_expr(mut_view(*st), unsafe { (*n).left as *const AstExpr });
            d_expr(mut_view(*st), unsafe { (*n).right as *const AstExpr });
        } else if k == EXPR_UNARY {
            d_int(mut_view(*st), (unsafe { (*n).op }) as u32);
            d_expr(mut_view(*st), unsafe { (*n).inner as *const AstExpr });
        } else if k == EXPR_CAST {
            d_expr(mut_view(*st), unsafe { (*n).inner as *const AstExpr });
            d_type(mut_view(*st), unsafe { (*n).cast_ty as *const AstType });
        } else if k == EXPR_POSTFIX {
            d_expr(mut_view(*st), unsafe { (*n).head as *const AstExpr });
            let mut s = unsafe { (*n).postfix_segs as *const AstPostfixSeg };
            while s as usize != 0 {
                d_nl(mut_view(*st));
                let sk = unsafe { (*s).kind };
                d_list_begin(mut_view(*st), 58);
                d_int(mut_view(*st), sk as u32);
                if sk == POSTFIX_FIELD {
                    d_strid(mut_view(*st), unsafe { (*s).name });
                    d_generic_args(mut_view(*st), unsafe { (*s).generic_args as *const AstGenericArgs });
                } else if sk == POSTFIX_TUPLE_INDEX {
                    d_int(mut_view(*st), unsafe { (*s).tuple_index });
                } else if sk == POSTFIX_CALL {
                    d_expr(mut_view(*st), unsafe { (*s).args as *const AstExpr });
                } else if sk == POSTFIX_INDEX {
                    d_expr(mut_view(*st), unsafe { (*s).index_arg as *const AstExpr });
                } else if sk == POSTFIX_ARROW {
                    d_strid(mut_view(*st), unsafe { (*s).name });
                }
                d_list_end(mut_view(*st));
                s = unsafe { (*s).next as *const AstPostfixSeg };
            }
        }
        d_list_end(mut_view(*st));
        n = unsafe { (*n).next as *const AstExpr };
    }
}

fn d_use_tree(st: mut_view<DumpState>, n: *const AstUseTree) {
    if n as usize == 0 {
        return;
    }
    d_nl(mut_view(*st));
    d_list_begin(mut_view(*st), 59);
    d_dotted_name(mut_view(*st), unsafe { view((*n).path) });
    let al = unsafe { (*n).alias };
    if al.v != 0u32 {
        d_strid(mut_view(*st), al);
    }
    let sub = unsafe { (*n).subtrees as *const AstUseTree };
    if sub as usize != 0 {
        d_use_tree(mut_view(*st), sub);
    }
    d_list_end(mut_view(*st));
    let nx = unsafe { (*n).next as *const AstUseTree };
    if nx as usize != 0 {
        d_use_tree(mut_view(*st), nx);
    }
}

fn d_stmt(st: mut_view<DumpState>, head: *const AstStmt) {
    let mut n = head;
    while n as usize != 0 {
        d_nl(mut_view(*st));
        let k = unsafe { (*n).kind };
        d_list_begin(mut_view(*st), (60u8 + k) as usize);
        if k == STMT_LET {
            d_pat(mut_view(*st), unsafe { (*n).pat as *const AstPat });
            d_type(mut_view(*st), unsafe { (*n).ty as *const AstType });
            d_expr(mut_view(*st), unsafe { (*n).expr as *const AstExpr });
            d_block(mut_view(*st), unsafe { (*n).else_block as *const AstBlock });
        } else if k == STMT_ASSIGN {
            d_int(mut_view(*st), (unsafe { (*n).op }) as u32);
            d_expr(mut_view(*st), unsafe { (*n).left as *const AstExpr });
            d_expr(mut_view(*st), unsafe { (*n).right as *const AstExpr });
        } else if k == STMT_EXPR {
            d_bool(mut_view(*st), unsafe { (*n).has_semi });
            d_expr(mut_view(*st), unsafe { (*n).expr as *const AstExpr });
        }
        d_list_end(mut_view(*st));
        n = unsafe { (*n).next as *const AstStmt };
    }
}

fn d_item(st: mut_view<DumpState>, head: *const AstItem) {
    let mut n = head;
    while n as usize != 0 {
        let f_id = unsafe { (*n).span.file.v };
        if st.filter_file.v != 0u32 && f_id != 0u32 && f_id != st.filter_file.v {
            n = unsafe { (*n).next as *const AstItem };
            continue;
        }
        d_nl(mut_view(*st));
        let k = unsafe { (*n).kind };
        d_list_begin(mut_view(*st), (64u8 + k) as usize);
        if k != ITEM_ERROR {
            d_attr(mut_view(*st), unsafe { (*n).attrs as *const AstAttr });
            d_vis(mut_view(*st), unsafe { view((*n).vis) });
        }
        if k == ITEM_MODULE {
            d_dotted_name(mut_view(*st), unsafe { view((*n).mod_path) });
        } else if k == ITEM_USE {
            d_use_tree(mut_view(*st), unsafe { (*n).use_tree as *const AstUseTree });
        } else if k == ITEM_FN {
            d_bool(mut_view(*st), unsafe { (*n).is_async });
            d_bool(mut_view(*st), unsafe { (*n).is_comptime });
            d_bool(mut_view(*st), unsafe { (*n).is_unsafe });
            d_strid(mut_view(*st), unsafe { (*n).abi });
            d_strid(mut_view(*st), unsafe { (*n).name });
            d_generic_params(mut_view(*st), unsafe { (*n).generic_params as *const AstGenericParams });
            d_params(mut_view(*st), unsafe { (*n).params as *const AstParam });
            d_type(mut_view(*st), unsafe { (*n).ret_type as *const AstType });
            d_where_clause(mut_view(*st), unsafe { (*n).where_clause as *const AstWhereClause });
            d_block(mut_view(*st), unsafe { (*n).body as *const AstBlock });
        } else if k == ITEM_STRUCT {
            d_strid(mut_view(*st), unsafe { (*n).name });
            d_generic_params(mut_view(*st), unsafe { (*n).generic_params as *const AstGenericParams });
            d_where_clause(mut_view(*st), unsafe { (*n).where_clause as *const AstWhereClause });
            let is_tup = unsafe { (*n).is_tuple };
            d_bool(mut_view(*st), is_tup);
            if is_tup {
                d_type(mut_view(*st), unsafe { (*n).tuple_types as *const AstType });
            } else {
                d_field_decls(mut_view(*st), unsafe { (*n).struct_fields as *const AstFieldDecl });
            }
        } else if k == ITEM_ENUM {
            d_strid(mut_view(*st), unsafe { (*n).name });
            d_generic_params(mut_view(*st), unsafe { (*n).generic_params as *const AstGenericParams });
            d_where_clause(mut_view(*st), unsafe { (*n).where_clause as *const AstWhereClause });
            let mut v = unsafe { (*n).variants as *const AstVariantDecl };
            while v as usize != 0 {
                d_nl(mut_view(*st));
                d_list_begin(mut_view(*st), 77);
                d_attr(mut_view(*st), unsafe { (*v).attrs as *const AstAttr });
                d_strid(mut_view(*st), unsafe { (*v).name });
                let vs = unsafe { (*v).is_struct };
                d_bool(mut_view(*st), vs);
                if vs {
                    d_field_decls(mut_view(*st), unsafe { (*v).struct_fields as *const AstFieldDecl });
                } else {
                    d_type(mut_view(*st), unsafe { (*v).tuple_types as *const AstType });
                }
                d_list_end(mut_view(*st));
                v = unsafe { (*v).next as *const AstVariantDecl };
            }
        } else if k == ITEM_TRAIT {
            d_strid(mut_view(*st), unsafe { (*n).name });
            d_generic_params(mut_view(*st), unsafe { (*n).generic_params as *const AstGenericParams });
            d_type(mut_view(*st), unsafe { (*n).supertraits as *const AstType });
            d_where_clause(mut_view(*st), unsafe { (*n).where_clause as *const AstWhereClause });
            d_item(mut_view(*st), unsafe { (*n).members as *const AstItem });
        } else if k == ITEM_IMPL {
            d_generic_params(mut_view(*st), unsafe { (*n).generic_params as *const AstGenericParams });
            d_type(mut_view(*st), unsafe { (*n).trait_path as *const AstType });
            d_type(mut_view(*st), unsafe { (*n).self_type as *const AstType });
            d_where_clause(mut_view(*st), unsafe { (*n).where_clause as *const AstWhereClause });
            d_item(mut_view(*st), unsafe { (*n).members as *const AstItem });
        } else if k == ITEM_TYPE_ALIAS {
            d_strid(mut_view(*st), unsafe { (*n).name });
            d_generic_params(mut_view(*st), unsafe { (*n).generic_params as *const AstGenericParams });
            d_type(mut_view(*st), unsafe { (*n).ty as *const AstType });
        } else if k == ITEM_CONST {
            d_strid(mut_view(*st), unsafe { (*n).name });
            d_type(mut_view(*st), unsafe { (*n).ty as *const AstType });
            d_expr(mut_view(*st), unsafe { (*n).expr as *const AstExpr });
        } else if k == ITEM_STATIC {
            d_bool(mut_view(*st), unsafe { (*n).is_unsafe });
            d_bool(mut_view(*st), unsafe { (*n).is_mut });
            d_strid(mut_view(*st), unsafe { (*n).name });
            d_type(mut_view(*st), unsafe { (*n).ty as *const AstType });
            d_expr(mut_view(*st), unsafe { (*n).expr as *const AstExpr });
        } else if k == ITEM_EXTERN_BLOCK {
            d_strid(mut_view(*st), unsafe { (*n).abi });
            d_item(mut_view(*st), unsafe { (*n).members as *const AstItem });
        }
        d_list_end(mut_view(*st));
        n = unsafe { (*n).next as *const AstItem };
    }
}

pub fn ax_ast_render(ast: view<Ast>, interner: view<StrInterner>, filter_file: FileId, out: mut_view<DiagBuffer>) {
    let mut st = DumpState {
        out: unsafe { address_of_mut(*out) },
        interner: unsafe { address_of(*interner) },
        indent: 0,
        filter_file: FileId { v: filter_file.v },
    };
    d_item(mut_view(st), ast.items as *const AstItem);
    diag_buf_push_byte(out, 10u8);
}

pub fn ast_walk_items(head: *const AstItem, stats: mut_view<AstStats>) {
    let mut cur = head;
    while cur as usize != 0 {
        stats.item_count = stats.item_count + 1;
        let k = unsafe { (*cur).kind };
        if k == ITEM_FN {
            let b = unsafe { (*cur).body as *const AstBlock };
            if b as usize != 0 {
                let mut s = unsafe { (*b).stmts as *const AstStmt };
                while s as usize != 0 {
                    stats.stmt_count = stats.stmt_count + 1;
                    s = unsafe { (*s).next as *const AstStmt };
                }
            }
        } else if k == ITEM_TRAIT || k == ITEM_IMPL || k == ITEM_EXTERN_BLOCK {
            ast_walk_items(unsafe { (*cur).members as *const AstItem }, mut_view(*stats));
        }
        cur = unsafe { (*cur).next as *const AstItem };
    }
}

