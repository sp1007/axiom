    pub fn_sym: u32,
    pub pointee: TypeId,
    pub elem: TypeId,
    pub ret_type: TypeId,
    pub fn_type: TypeId,
    pub array_len: u64,
    pub param_types: *mut TypeId,
    pub param_count: usize,
    pub fields: *mut TypeId,
    pub field_count: usize,
    pub def: *const HirItem,
    pub args: *mut TypeId,
    pub arg_count: usize,
