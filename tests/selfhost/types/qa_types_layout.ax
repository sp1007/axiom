pub fn link_attr(head: *mut AstAttr, node: *mut AstAttr) -> *mut AstAttr {
    if head as usize == 0 { return node; }
    let mut cur = head;
    while (unsafe { (*cur).next }) as usize != 0 {
        cur = unsafe { (*cur).next as *mut AstAttr };
    }
    unsafe { (*cur).next = node; }
    head
}

pub fn link_attr_arg(head: *mut AstAttrArg, node: *mut AstAttrArg) -> *mut AstAttrArg {
    if head as usize == 0 { return node; }
    let mut cur = head;
    while (unsafe { (*cur).next }) as usize != 0 {
        cur = unsafe { (*cur).next as *mut AstAttrArg };
    }
    unsafe { (*cur).next = node; }
    head
}

pub fn link_generic_param(head: *mut AstGenericParam, node: *mut AstGenericParam) -> *mut AstGenericParam {
    if head as usize == 0 { return node; }
    let mut cur = head;
    while (unsafe { (*cur).next }) as usize != 0 {
        cur = unsafe { (*cur).next as *mut AstGenericParam };
    }
    unsafe { (*cur).next = node; }
    head
}

