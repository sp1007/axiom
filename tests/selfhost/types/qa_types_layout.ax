const INTR_SUFFIX_WIDTH: [10]u8 = [
    INTR_WIDTH_I8, INTR_WIDTH_I16, INTR_WIDTH_I32, INTR_WIDTH_I64, INTR_WIDTH_ISIZE,
    INTR_WIDTH_U8, INTR_WIDTH_U16, INTR_WIDTH_U32, INTR_WIDTH_U64, INTR_WIDTH_USIZE,
];

fn intrinsic_desc_empty() -> IntrinsicDesc {
    IntrinsicDesc {
        index: 0u8,
        cls: 0u8,
        generics: 0u8,
        builtin_ty: 0u8,
        op: 0u8,
        term: 0u8,
        width_suffixed: false,
    }
}

fn intrinsic_desc_at(idx: usize) -> IntrinsicDesc {
    IntrinsicDesc {
        index: idx as u8,
        cls: INTR_CLS_TABLE[idx],
        generics: INTR_GENERICS_TABLE[idx],
        builtin_ty: INTR_BUILTIN_TY_TABLE[idx],
        op: INTR_OP_TABLE[idx],
        term: INTR_TERM_TABLE[idx],
        width_suffixed: INTR_WIDTH_SUFFIXED_TABLE[idx] != 0u8,
    }
}

fn intrinsic_name_eq(ptr: *const u8, n_len: usize, idx: usize) -> bool {
    let off = INTR_NAMES_OFF[idx] as usize;
    let nlen = (INTR_NAMES_OFF[idx + 1] as usize) - off;
    if n_len != nlen {
        return false;
    }
    let mut i: usize = 0;
    while i < n_len {
        if unsafe { *(ptr + i) } != INTR_NAMES_DATA[off + i] {
            return false;
        }
        i = i + 1;
    }
    true
}

fn intrinsic_suffix_eq(ptr: *const u8, sidx: usize) -> bool {
    let off = INTR_SUFFIX_OFF[sidx] as usize;
    let slen = (INTR_SUFFIX_OFF[sidx + 1] as usize) - off;
    let mut i: usize = 0;
    while i < slen {
        if unsafe { *(ptr + i) } != INTR_SUFFIX_DATA[off + i] {
            return false;
        }
        i = i + 1;
    }
    true
}

pub fn intrinsic_lookup(name: StrView) -> IntrinsicRef {
    let empty = IntrinsicRef {
        desc: intrinsic_desc_empty(),
        has_desc: false,
        width: INTR_WIDTH_NONE,
    };
    if (name.ptr as usize) == 0 || name.len == 0 {
        return empty;
    }
    let mut i: usize = 0;
    while i < INTR_TABLE_COUNT {
        if INTR_WIDTH_SUFFIXED_TABLE[i] == 0u8 {
            if intrinsic_name_eq(name.ptr, name.len, i) {
                return IntrinsicRef {
                    desc: intrinsic_desc_at(i),
                    has_desc: true,
                    width: INTR_WIDTH_NONE,
                };
            }
        }
        i = i + 1;
    }
    let mut s: usize = 0;
    while s < 10 {
        let soff = INTR_SUFFIX_OFF[s] as usize;
        let slen = (INTR_SUFFIX_OFF[s + 1] as usize) - soff;
        if name.len > slen {
            let tail_ptr = unsafe { name.ptr + (name.len - slen) };
            if intrinsic_suffix_eq(tail_ptr, s) {
                let stem_len = name.len - slen;
                let mut j: usize = 0;
                while j < INTR_TABLE_COUNT {
                    if INTR_WIDTH_SUFFIXED_TABLE[j] != 0u8 {
                        if intrinsic_name_eq(name.ptr, stem_len, j) {
                            return IntrinsicRef {
                                desc: intrinsic_desc_at(j),
                                has_desc: true,
                                width: INTR_SUFFIX_WIDTH[s],
                            };
                        }
                    }
                    j = j + 1;
                }
                break;
            }
        }
        s = s + 1;
    }
    empty
}

pub fn intrinsic_is_host(name: StrView) -> bool {
    let r = intrinsic_lookup(name);
    r.has_desc && r.desc.cls == INTR_HOST
}

pub fn intrinsic_encode(r: view<IntrinsicRef>) -> u32 {
    if !r.has_desc {
        return 0u32;
    }
    let idx = (r.desc.index as u32) + 1u32;
    (idx << 8u32) | (r.width as u32)
}

pub fn intrinsic_decode(code: u32) -> IntrinsicRef {
    let empty = IntrinsicRef {
        desc: intrinsic_desc_empty(),
        has_desc: false,
        width: INTR_WIDTH_NONE,
    };
    if code == 0u32 {
        return empty;
    }
    let idx = (code >> 8u32) as usize;
    let w = (code & 0xFFu32) as u8;
    if idx == 0 || idx > INTR_TABLE_COUNT || w > INTR_WIDTH_USIZE {
        return empty;
    }
    IntrinsicRef {
        desc: intrinsic_desc_at(idx - 1),
        has_desc: true,
        width: w,
    }
}

pub fn intrinsic_width_type(w: u8, interner: view<TypeInterner>) -> TypeId {
    if w == INTR_WIDTH_I8 { return TypeId { v: interner.t_i8.v }; }
    if w == INTR_WIDTH_I16 { return TypeId { v: interner.t_i16.v }; }
    if w == INTR_WIDTH_I32 { return TypeId { v: interner.t_i32.v }; }
    if w == INTR_WIDTH_I64 { return TypeId { v: interner.t_i64.v }; }
    if w == INTR_WIDTH_ISIZE { return TypeId { v: interner.t_isize.v }; }
    if w == INTR_WIDTH_U8 { return TypeId { v: interner.t_u8.v }; }
    if w == INTR_WIDTH_U16 { return TypeId { v: interner.t_u16.v }; }
    if w == INTR_WIDTH_U32 { return TypeId { v: interner.t_u32.v }; }
    if w == INTR_WIDTH_U64 { return TypeId { v: interner.t_u64.v }; }
    if w == INTR_WIDTH_USIZE { return TypeId { v: interner.t_usize.v }; }
    TypeId { v: interner.t_error.v }
}

pub fn intrinsic_width_unsigned_type(w: u8, interner: view<TypeInterner>) -> TypeId {
    if w == INTR_WIDTH_I8 || w == INTR_WIDTH_U8 { return TypeId { v: interner.t_u8.v }; }
    if w == INTR_WIDTH_I16 || w == INTR_WIDTH_U16 { return TypeId { v: interner.t_u16.v }; }
    if w == INTR_WIDTH_I32 || w == INTR_WIDTH_U32 { return TypeId { v: interner.t_u32.v }; }
    if w == INTR_WIDTH_I64 || w == INTR_WIDTH_U64 { return TypeId { v: interner.t_u64.v }; }
    if w == INTR_WIDTH_ISIZE || w == INTR_WIDTH_USIZE { return TypeId { v: interner.t_usize.v }; }
    TypeId { v: interner.t_error.v }
}

pub fn intrinsic_width_bits(w: u8) -> u32 {
    if w == INTR_WIDTH_I8 || w == INTR_WIDTH_U8 { return 8u32; }
    if w == INTR_WIDTH_I16 || w == INTR_WIDTH_U16 { return 16u32; }
    if w == INTR_WIDTH_I32 || w == INTR_WIDTH_U32 { return 32u32; }
    64u32
}

pub fn intrinsic_width_signed(w: u8) -> bool {
    w >= INTR_WIDTH_I8 && w <= INTR_WIDTH_ISIZE
}

fn intrinsic_count_type_generics(fn_item: *const HirItem) -> usize {
    if (fn_item as usize) == 0 {
        return 0;
    }
    let gps = unsafe { (*fn_item).generic_params };
    if (gps as usize) == 0 {
        return 0;
    }
    let mut n: usize = 0;
    let mut gp: *mut HirGenericParam = unsafe { (*gps).params };
    while (gp as usize) != 0 {
        n = n + 1;
        gp = unsafe { (*gp).next };
    }
    n
}

fn intrinsic_tok_eq(start: usize, t_len: usize, lit: [5]u8, lit_len: usize) -> bool {
    if t_len != lit_len {
        return false;
    }
    let mut i: usize = 0;
    while i < t_len {
        if INTR_SIGS_DATA[start + i] != lit[i] {
            return false;
        }
        i = i + 1;
    }
    true
}

fn intrinsic_type_matches(start: usize, t_len: usize, ty: TypeId, width_ty_v: u32, interner: view<TypeInterner>) -> bool {
    if intrinsic_tok_eq(start, t_len, [42u8, 0u8, 0u8, 0u8, 0u8], 1) { return true; }
    if intrinsic_tok_eq(start, t_len, [87u8, 0u8, 0u8, 0u8, 0u8], 1) { return ty.v == width_ty_v; }
    if intrinsic_tok_eq(start, t_len, [105u8, 51u8, 50u8, 0u8, 0u8], 3) { return ty.v == interner.t_i32.v; }
    if intrinsic_tok_eq(start, t_len, [117u8, 51u8, 50u8, 0u8, 0u8], 3) { return ty.v == interner.t_u32.v; }
    if intrinsic_tok_eq(start, t_len, [105u8, 54u8, 52u8, 0u8, 0u8], 3) { return ty.v == interner.t_i64.v; }
    if intrinsic_tok_eq(start, t_len, [117u8, 54u8, 52u8, 0u8, 0u8], 3) { return ty.v == interner.t_u64.v; }
    if intrinsic_tok_eq(start, t_len, [117u8, 56u8, 0u8, 0u8, 0u8], 2) { return ty.v == interner.t_u8.v; }
    if intrinsic_tok_eq(start, t_len, [117u8, 115u8, 105u8, 122u8, 101u8], 5) { return ty.v == interner.t_usize.v; }
    if intrinsic_tok_eq(start, t_len, [98u8, 111u8, 111u8, 108u8, 0u8], 4) { return ty.v == interner.t_bool.v; }
    if intrinsic_tok_eq(start, t_len, [117u8, 110u8, 105u8, 116u8, 0u8], 4) { return ty.v == interner.t_unit.v; }
    if intrinsic_tok_eq(start, t_len, [110u8, 101u8, 118u8, 101u8, 114u8], 5) { return ty.v == interner.t_never.v; }
    let t = type_get(interner, ty);
    if intrinsic_tok_eq(start, t_len, [99u8, 112u8, 56u8, 0u8, 0u8], 3) {
        return (t as usize) != 0 && unsafe { (*t).kind } == TY_PTR && !unsafe { (*t).is_mut } &&
            unsafe { (*t).pointee.v } == interner.t_u8.v;
    }
    if intrinsic_tok_eq(start, t_len, [109u8, 112u8, 56u8, 0u8, 0u8], 3) {
        return (t as usize) != 0 && unsafe { (*t).kind } == TY_PTR && unsafe { (*t).is_mut } &&
            unsafe { (*t).pointee.v } == interner.t_u8.v;
    }
    if intrinsic_tok_eq(start, t_len, [109u8, 112u8, 54u8, 52u8, 0u8], 4) {
        return (t as usize) != 0 && unsafe { (*t).kind } == TY_PTR && unsafe { (*t).is_mut } &&
            unsafe { (*t).pointee.v } == interner.t_u64.v;
    }
    false
}

fn intrinsic_alt_matches(
    alt_start: usize,
    alt_len: usize,
    fn_ty: *const AxType,
    width_ty_v: u32,
    interner: view<TypeInterner>
) -> bool {
    let mut arrow_off: usize = alt_len;
    let mut k: usize = 0;
    while k < alt_len {
        if INTR_SIGS_DATA[alt_start + k] == 62u8 {
            arrow_off = k;
            break;
        }
        k = k + 1;
    }
    if arrow_off == alt_len {
        return false;
    }
    let ret_start = alt_start + arrow_off + 1;
    let ret_len = alt_len - arrow_off - 1;
    let ret_ty = TypeId { v: unsafe { (*fn_ty).ret_type.v } };
    if !intrinsic_type_matches(ret_start, ret_len, ret_ty, width_ty_v, interner) {
        return false;
    }
    let pcount = unsafe { (*fn_ty).param_count };
    if arrow_off == 0 {
        return pcount == 0;
    }
    let params = unsafe { (*fn_ty).param_types };
    let params_end = alt_start + arrow_off;
    let mut p_pos: usize = alt_start;
    let mut idx: usize = 0;
    loop {
        let mut comma: usize = p_pos;
        while comma < params_end && INTR_SIGS_DATA[comma] != 44u8 {
            comma = comma + 1;
        }
        if idx >= pcount {
            return false;
        }
        let param_ty = unsafe { *typeid_at(params, idx) };
        if !intrinsic_type_matches(p_pos, comma - p_pos, param_ty, width_ty_v, interner) {
            return false;
        }
        idx = idx + 1;
        if comma == params_end {
            break;
        }
        p_pos = comma + 1;
    }
    idx == pcount
}

pub fn intrinsic_signature_ok(r: view<IntrinsicRef>, fn_item: *const HirItem, thir: view<Thir>) -> bool {
    if !r.has_desc || (fn_item as usize) == 0 {
        return false;
    }
    if unsafe { (*fn_item).kind } != HIR_ITEM_FN {
        return false;
    }
    let fn_ty_ptr = thir_get_item_type(thir, fn_item);
    if (fn_ty_ptr as usize) == 0 {
        return false;
    }
    let fn_ty_id = TypeId { v: unsafe { (*fn_ty_ptr).v } };
    if fn_ty_id.v == 0u32 {
        return false;
    }
    let fn_ty = type_get(view(thir.interner), fn_ty_id);
    if (fn_ty as usize) == 0 || unsafe { (*fn_ty).kind } != TY_FN {
        return false;
    }
    let gcount = intrinsic_count_type_generics(fn_item);
    if gcount != (r.desc.generics as usize) {
        return false;
    }
    let width_ty = intrinsic_width_type(r.width, view(thir.interner));
    let width_ty_v = width_ty.v;
    let idx = r.desc.index as usize;
    let sig_start = INTR_SIGS_OFF[idx] as usize;
    let sig_end = INTR_SIGS_OFF[idx + 1] as usize;
    let mut pos: usize = sig_start;
    loop {
        let mut bar: usize = pos;
        while bar < sig_end && INTR_SIGS_DATA[bar] != 124u8 {
            bar = bar + 1;
        }
        if intrinsic_alt_matches(pos, bar - pos, fn_ty, width_ty_v, view(thir.interner)) {
            return true;
        }
        if bar == sig_end {
            break;
        }
        pos = bar + 1;
    }
    false
}

// Target memory layout calculation: size, alignment, and field offsets.
// Port of bootstrap/axiom0/src/types/layout/layout.h and layout.c.
module compiler.types.layout

use host_intrinsics.heap_alloc
use host_intrinsics.heap_free
use compiler.kernel.id.TypeId
use compiler.types.types.TY_BOOL
use compiler.types.types.TY_CHAR
use compiler.types.types.TY_I8
use compiler.types.types.TY_I16
use compiler.types.types.TY_I32
use compiler.types.types.TY_I64
use compiler.types.types.TY_ISIZE
use compiler.types.types.TY_U8
use compiler.types.types.TY_U16
use compiler.types.types.TY_U32
use compiler.types.types.TY_U64
use compiler.types.types.TY_USIZE
use compiler.types.types.TY_FN
use compiler.types.types.TY_STR
use compiler.types.types.TY_SLICE
use compiler.types.types.TY_INT_VAR
use compiler.types.types.TY_PTR
use compiler.types.types.TY_ARRAY
use compiler.types.types.TY_TUPLE
use compiler.types.types.TY_STRUCT
use compiler.types.types.TY_ENUM
use compiler.types.types.TY_VIEW
use compiler.types.types.TY_MUT_VIEW
use compiler.types.types.TY_PARAM
use compiler.types.types.TY_CLOSURE
use compiler.types.types.AxType
use compiler.types.types.TypeInterner
use compiler.types.types.type_get
use compiler.types.types.mul_usize
use compiler.types.types.typeid_at
use compiler.types.types.typeid_ptr_at
use compiler.types.types.usize_at
use compiler.types.types.capture_at

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }

const ALIGN_1: u32 = 1u32;
const ALIGN_2: u32 = 2u32;
const ALIGN_4: u32 = 4u32;
const ALIGN_8: u32 = 8u32;
const SIZE_0: u32 = 0u32;
const SIZE_1: u32 = 1u32;
const SIZE_2: u32 = 2u32;
const SIZE_4: u32 = 4u32;
const SIZE_8: u32 = 8u32;
const SIZE_16: u32 = 16u32;

pub struct Layout {
    pub size: u32,
    pub align: u32,
}

struct FieldLayout {
    pub index: u32,
    pub size: u32,
    pub align: u32,
}

unsafe fn field_layout_at(base: *mut FieldLayout, idx: usize) -> *mut FieldLayout {
    let off = ((idx as isize) * (size_of<FieldLayout>() as isize)) as usize;
    ((base as usize) + off) as *mut FieldLayout
}

fn align_up_u32(offset: u32, align: u32) -> u32 {
    if (align <= 1u32) {
        return offset;
    }
    let mask = align - 1u32;
    (offset + mask) & (0xFFFFFFFFu32 ^ mask)
}

fn field_comes_before(a: view<FieldLayout>, b: view<FieldLayout>) -> bool {
    if a.align != b.align {
        return a.align > b.align;
    }
    if a.size != b.size {
        return a.size > b.size;
    }
    let ai = a.index;
    let bi = b.index;
    ai < bi
}

fn sort_fields(fl: *mut FieldLayout, count: usize) {
    let mut i: usize = 1;
    while (i < count) {
        let cur_p = unsafe { field_layout_at(fl, i) };
        let cur_index = unsafe { (*cur_p).index };
        let cur_size = unsafe { (*cur_p).size };
        let cur_align = unsafe { (*cur_p).align };
        let cur = FieldLayout {
            index: cur_index,
            size: cur_size,
            align: cur_align,
        };
        let mut j: usize = i;
        while (j > 0) {
            let prev_p = unsafe { field_layout_at(fl, j - 1) };
            let move_right = unsafe { field_comes_before(view(cur), view(*prev_p)) };
            if !move_right {
                break;
            }
            let dst_p = unsafe { field_layout_at(fl, j) };
            unsafe {
                (*dst_p).index = (*prev_p).index;
                (*dst_p).size = (*prev_p).size;
                (*dst_p).align = (*prev_p).align;
            }
            j = j - 1;
        }
        let target_p = unsafe { field_layout_at(fl, j) };
        unsafe {
            (*target_p).index = cur.index;
            (*target_p).size = cur.size;
            (*target_p).align = cur.align;
        }
        i = i + 1;
    }
}

pub fn type_align(id: TypeId, ti: view<TypeInterner>) -> u32 {
    if id.v == 0u32 {
        return ALIGN_1;
    }
    if id.v == ti.t_unit.v || id.v == ti.t_never.v {
        return ALIGN_1;
    }
    if id.v == ti.t_bool.v || id.v == ti.t_i8.v || id.v == ti.t_u8.v {
        return ALIGN_1;
    }
    if id.v == ti.t_i16.v || id.v == ti.t_u16.v {
        return ALIGN_2;
    }
    if id.v == ti.t_i32.v || id.v == ti.t_u32.v || id.v == ti.t_char.v {
        return ALIGN_4;
    }
    if id.v == ti.t_i64.v || id.v == ti.t_u64.v || id.v == ti.t_isize.v ||
        id.v == ti.t_usize.v || id.v == ti.t_str.v {
        return ALIGN_8;
    }

    let ty = type_get(ti, id);
    if (ty as usize) == 0 {
        return ALIGN_1;
    }
    let k = unsafe { (*ty).kind };
    if k == TY_BOOL || k == TY_I8 || k == TY_U8 {
        return ALIGN_1;
    }
    if k == TY_I16 || k == TY_U16 {
        return ALIGN_2;
    }
    if k == TY_I32 || k == TY_U32 || k == TY_CHAR || k == TY_INT_VAR {
        return ALIGN_4;
    }
    if k == TY_I64 || k == TY_U64 || k == TY_ISIZE || k == TY_USIZE {
        return ALIGN_8;
    }
    if k == TY_PTR || k == TY_FN || k == TY_VIEW || k == TY_MUT_VIEW || k == TY_PARAM {
        return ALIGN_8;
    }
    if k == TY_SLICE || k == TY_ARRAY {
        let elem_v = unsafe { (*ty).elem.v };
        return type_align(TypeId { v: elem_v }, ti);
    }
    if k == TY_ENUM {
        let mut max_align: u32 = ALIGN_4;
        let vcount = unsafe { (*ty).variant_count };
        let vcounts = unsafe { (*ty).variant_field_counts };
        let vfields = unsafe { (*ty).variant_fields };
        if (vcounts as usize) != 0 && (vfields as usize) != 0 {
            let mut i: usize = 0;
            while (i < vcount) {
                let count = unsafe { *usize_at(vcounts, i) };
                let vf = unsafe { *typeid_ptr_at(vfields, i) };
                let mut j: usize = 0;
                while (j < count) {
                    let fty_v = unsafe { (*typeid_at(vf, j)).v };
                    let a = type_align(TypeId { v: fty_v }, ti);
                    if a > max_align {
                        max_align = a;
                    }
                    j = j + 1;
                }
                i = i + 1;
            }
        }
        return max_align;
    }
    if k == TY_TUPLE || k == TY_STRUCT {
        let mut align: u32 = ALIGN_1;
        let count = unsafe { (*ty).field_count };
        let fields = unsafe { (*ty).fields };
        let mut i: usize = 0;
        while (i < count) {
            let fty_v = unsafe { (*typeid_at(fields, i)).v };
            let fa = type_align(TypeId { v: fty_v }, ti);
            if fa > align {
                align = fa;
            }
            i = i + 1;
        }
        return align;
    }
    if k == TY_CLOSURE {
        let mut align: u32 = ALIGN_8;
        let count = unsafe { (*ty).capture_count };
        let caps = unsafe { (*ty).captures };
        let mut i: usize = 0;
        while (i < count) {
            let cap = unsafe { capture_at(caps, i) };
            let cty_v = unsafe { (*cap).ty.v };
            let fa = type_align(TypeId { v: cty_v }, ti);
            if fa > align {
                align = fa;
            }
            i = i + 1;
        }
        return align;
    }
    ALIGN_1
}

pub fn type_size(id: TypeId, ti: view<TypeInterner>) -> u32 {
    if id.v == 0u32 {
        return SIZE_0;
    }
    if id.v == ti.t_unit.v || id.v == ti.t_never.v {
        return SIZE_0;
    }
    if id.v == ti.t_bool.v || id.v == ti.t_i8.v || id.v == ti.t_u8.v {
        return SIZE_1;
    }
    if id.v == ti.t_i16.v || id.v == ti.t_u16.v {
        return SIZE_2;
    }
    if id.v == ti.t_i32.v || id.v == ti.t_u32.v || id.v == ti.t_char.v {
        return SIZE_4;
    }
    if id.v == ti.t_i64.v || id.v == ti.t_u64.v || id.v == ti.t_isize.v || id.v == ti.t_usize.v {
        return SIZE_8;
    }
    if id.v == ti.t_str.v {
        return SIZE_16;
    }

    let ty = type_get(ti, id);
    if (ty as usize) == 0 {
        return SIZE_0;
    }
    let k = unsafe { (*ty).kind };
    if k == TY_BOOL || k == TY_I8 || k == TY_U8 {
        return SIZE_1;
    }
    if k == TY_I16 || k == TY_U16 {
        return SIZE_2;
    }
    if k == TY_I32 || k == TY_U32 || k == TY_CHAR || k == TY_INT_VAR {
        return SIZE_4;
    }
    if k == TY_I64 || k == TY_U64 || k == TY_ISIZE || k == TY_USIZE {
        return SIZE_8;
    }
    if k == TY_PTR || k == TY_FN || k == TY_PARAM {
        return SIZE_8;
    }
    if k == TY_VIEW || k == TY_MUT_VIEW {
        let pt_v = unsafe { (*ty).pointee.v };
        let pty = type_get(ti, TypeId { v: pt_v });
        let pk = unsafe { (*pty).kind };
        if pk == TY_SLICE {
            return SIZE_16;
        }
        return SIZE_8;
    }
    if k == TY_SLICE {
        return SIZE_0;
    }
    if k == TY_ARRAY {
        let elem_v = unsafe { (*ty).elem.v };
        let arr_len = unsafe { (*ty).array_len };
        let esz = type_size(TypeId { v: elem_v }, ti) as isize;
        return (esz * (arr_len as isize)) as u32;
    }
    if k == TY_ENUM {
        let mut max_align: u32 = ALIGN_4;
        let mut max_payload_size: u32 = SIZE_0;
        let vcount = unsafe { (*ty).variant_count };
        let vcounts = unsafe { (*ty).variant_field_counts };
        let vfields = unsafe { (*ty).variant_fields };
        if (vcounts as usize) != 0 && (vfields as usize) != 0 {
            let mut i: usize = 0;
            while (i < vcount) {
                let count = unsafe { *usize_at(vcounts, i) };
                if count > 0 {
                    let vf = unsafe { *typeid_ptr_at(vfields, i) };
                    let fl = unsafe {
                        let fbytes = mul_usize(count, size_of<FieldLayout>());
                        heap_alloc(fbytes, align_of<FieldLayout>()) as *mut FieldLayout
                    };
                    let mut j: usize = 0;
                    while (j < count) {
                        let fty_v = unsafe { (*typeid_at(vf, j)).v };
                        let fa = type_align(TypeId { v: fty_v }, ti);
                        let fs = type_size(TypeId { v: fty_v }, ti);
                        if fa > max_align {
                            max_align = fa;
                        }
                        let fp = unsafe { field_layout_at(fl, j) };
                        unsafe {
                            (*fp).index = j as u32;
                            (*fp).align = fa;
                            (*fp).size = fs;
                        }
                        j = j + 1;
                    }
                    sort_fields(fl, count);
                    let mut offset: u32 = 0u32;
                    let mut k_idx: usize = 0;
                    while (k_idx < count) {
                        let fp = unsafe { field_layout_at(fl, k_idx) };
                        let fa = unsafe { (*fp).align };
                        let fs = unsafe { (*fp).size };
                        offset = align_up_u32(offset, fa);
                        offset = offset + fs;
                        k_idx = k_idx + 1;
                    }
                    unsafe {
                        heap_free(
                            fl as *mut u8,
                            mul_usize(count, size_of<FieldLayout>()),
                            align_of<FieldLayout>()
                        );
                    }
                    if offset > max_payload_size {
                        max_payload_size = offset;
                    }
                }
                i = i + 1;
            }
        }
        let total_size = SIZE_4 + max_payload_size;
        return align_up_u32(total_size, max_align);
    }
    if k == TY_TUPLE || k == TY_STRUCT {
        let count = unsafe { (*ty).field_count };
        if count == 0 {
            return SIZE_0;
        }
        let fields = unsafe { (*ty).fields };
        let is_repr_c = unsafe { (*ty).is_repr_c };
        let fl = unsafe {
            heap_alloc(mul_usize(count, size_of<FieldLayout>()), align_of<FieldLayout>()) as *mut FieldLayout
        };
        let mut max_align: u32 = ALIGN_1;
        let mut i: usize = 0;
        while (i < count) {
            let fty_v = unsafe { (*typeid_at(fields, i)).v };
            let fa = type_align(TypeId { v: fty_v }, ti);
            let fs = type_size(TypeId { v: fty_v }, ti);
            if fa > max_align {
                max_align = fa;
            }
            let fp = unsafe { field_layout_at(fl, i) };
            unsafe {
                (*fp).index = i as u32;
                (*fp).align = fa;
                (*fp).size = fs;
            }
            i = i + 1;
        }
        if k == TY_TUPLE || !is_repr_c {
            sort_fields(fl, count);
        }
        let mut offset: u32 = 0u32;
        let mut j: usize = 0;
        while (j < count) {
            let fp = unsafe { field_layout_at(fl, j) };
            let fa = unsafe { (*fp).align };
            let fs = unsafe { (*fp).size };
            offset = align_up_u32(offset, fa);
            offset = offset + fs;
            j = j + 1;
        }
        unsafe {
            heap_free(fl as *mut u8, mul_usize(count, size_of<FieldLayout>()), align_of<FieldLayout>());
        }
        return align_up_u32(offset, max_align);
    }
    if k == TY_CLOSURE {
        let mut offset: u32 = SIZE_8;
        let mut max_align: u32 = ALIGN_8;
        let count = unsafe { (*ty).capture_count };
        let caps = unsafe { (*ty).captures };
        let mut i: usize = 0;
        while (i < count) {
            let cap = unsafe { capture_at(caps, i) };
            let cty_v = unsafe { (*cap).ty.v };
            let a = type_align(TypeId { v: cty_v }, ti);
            let s = type_size(TypeId { v: cty_v }, ti);
            if a > max_align {
                max_align = a;
            }
            offset = align_up_u32(offset, a);
            offset = offset + s;
            i = i + 1;
        }
        return align_up_u32(offset, max_align);
    }
    SIZE_0
}

pub fn type_layout(id: TypeId, ti: view<TypeInterner>) -> Layout {
    let id_v = id.v;
    Layout {
        size: type_size(TypeId { v: id_v }, ti),
        align: type_align(TypeId { v: id_v }, ti),
    }
}

pub fn type_field_offset(id: TypeId, field_idx: usize, ti: view<TypeInterner>) -> u32 {
    let ty = type_get(ti, id);
    if (ty as usize) == 0 {
        return 0u32;
    }
    let k = unsafe { (*ty).kind };
    if k == TY_TUPLE || k == TY_STRUCT {
        let count = unsafe { (*ty).field_count };
        if field_idx >= count {
            return 0u32;
        }
        let fields = unsafe { (*ty).fields };
        let is_repr_c = unsafe { (*ty).is_repr_c };
        let fl = unsafe {
            heap_alloc(mul_usize(count, size_of<FieldLayout>()), align_of<FieldLayout>()) as *mut FieldLayout
        };
        let mut i: usize = 0;
        while (i < count) {
            let fty_v = unsafe { (*typeid_at(fields, i)).v };
            let fa = type_align(TypeId { v: fty_v }, ti);
            let fs = type_size(TypeId { v: fty_v }, ti);
            let fp = unsafe { field_layout_at(fl, i) };
            unsafe {
                (*fp).index = i as u32;
                (*fp).align = fa;
                (*fp).size = fs;
            }
            i = i + 1;
        }
        if k == TY_TUPLE || !is_repr_c {
            sort_fields(fl, count);
        }
        let mut offset: u32 = 0u32;
        let mut target_offset: u32 = 0u32;
        let mut j: usize = 0;
        while (j < count) {
            let fp = unsafe { field_layout_at(fl, j) };
            let f_index = unsafe { (*fp).index };
            let fa = unsafe { (*fp).align };
            let fs = unsafe { (*fp).size };
            offset = align_up_u32(offset, fa);
            if (f_index as usize) == field_idx {
                target_offset = offset;
                break;
            }
            offset = offset + fs;
            j = j + 1;
        }
        unsafe {
            heap_free(fl as *mut u8, mul_usize(count, size_of<FieldLayout>()), align_of<FieldLayout>());
        }
        return target_offset;
    }
    if k == TY_CLOSURE {
        if field_idx == 0 {
            return 0u32;
        }
        let count = unsafe { (*ty).capture_count };
        if field_idx > count {
            return 0u32;
        }
        let caps = unsafe { (*ty).captures };
        let mut offset: u32 = SIZE_8;
        let mut i: usize = 0;
        while (i < count) {
            let cap = unsafe { capture_at(caps, i) };
            let cty_v = unsafe { (*cap).ty.v };
            let a = type_align(TypeId { v: cty_v }, ti);
            let s = type_size(TypeId { v: cty_v }, ti);
            offset = align_up_u32(offset, a);
            if field_idx == i + 1 {
                return offset;
            }
            offset = offset + s;
            i = i + 1;
        }
        return offset;
    }
    0u32
}

pub fn type_enum_field_offset(
    id: TypeId,
    variant_idx: u32,
    field_idx: usize,
    ti: view<TypeInterner>
) -> u32 {
    let ty = type_get(ti, id);
    if (ty as usize) == 0 {
        return 0u32;
    }
    let k = unsafe { (*ty).kind };
    if k != TY_ENUM {
        return 0u32;
    }
    let vcount = unsafe { (*ty).variant_count };
    if (variant_idx as usize) >= vcount {
        return 0u32;
    }
    let vcounts = unsafe { (*ty).variant_field_counts };
    let vfields = unsafe { (*ty).variant_fields };
    if (vcounts as usize) == 0 || (vfields as usize) == 0 {
        return 0u32;
    }
    let count = unsafe { *usize_at(vcounts, variant_idx as usize) };
    if field_idx >= count {
        return 0u32;
    }
    let vf = unsafe { *typeid_ptr_at(vfields, variant_idx as usize) };
    let fl = unsafe {
        heap_alloc(mul_usize(count, size_of<FieldLayout>()), align_of<FieldLayout>()) as *mut FieldLayout
    };
    let mut i: usize = 0;
    while (i < count) {
        let fty_v = unsafe { (*typeid_at(vf, i)).v };
        let fa = type_align(TypeId { v: fty_v }, ti);
        let fs = type_size(TypeId { v: fty_v }, ti);
        let fp = unsafe { field_layout_at(fl, i) };
        unsafe {
            (*fp).index = i as u32;
            (*fp).align = fa;
            (*fp).size = fs;
        }
        i = i + 1;
    }
    sort_fields(fl, count);
    let mut offset: u32 = SIZE_4;
    let mut target_offset: u32 = 0u32;
    let mut j: usize = 0;
    while (j < count) {
        let fp = unsafe { field_layout_at(fl, j) };
        let f_index = unsafe { (*fp).index };
        let fa = unsafe { (*fp).align };
        let fs = unsafe { (*fp).size };
        offset = align_up_u32(offset, fa);
        if (f_index as usize) == field_idx {
            target_offset = offset;
            break;
        }
        offset = offset + fs;
        j = j + 1;
    }
    unsafe {
        heap_free(fl as *mut u8, mul_usize(count, size_of<FieldLayout>()), align_of<FieldLayout>());
    }
    target_offset
}


module main

use host_intrinsics.heap_alloc
use host_intrinsics.heap_free
use host_intrinsics.exit
use compiler.kernel.arena.Arena
use compiler.types.types.CONST_INT
use compiler.types.types.ConstValue
use compiler.kernel.id.FileId
use compiler.types.types.GenericArgsSlice
use compiler.hir.hir.HirExpr
