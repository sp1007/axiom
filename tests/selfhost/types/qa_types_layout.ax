use compiler.types.layout.type_enum_field_offset
use compiler.types.layout.type_field_offset
use compiler.types.types.type_is_copy
use compiler.types.types.type_is_int
use compiler.types.types.type_is_signed
use compiler.types.types.type_is_unsigned
use compiler.types.layout.type_size
use compiler.types.types.type_vars_free
use compiler.types.types.type_vars_init
use compiler.types.types.type_vars_new_int_var
use compiler.types.types.type_vars_new_ty_var
