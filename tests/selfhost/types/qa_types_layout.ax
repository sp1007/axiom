use compiler.types.types.intern_slice_ty
use compiler.types.types.intern_tuple_ty
use compiler.types.types.intern_type
use compiler.types.types.intern_view_ty
use compiler.kernel.interner.interner_free
use compiler.kernel.interner.interner_new
use compiler.types.types.mul_usize
use compiler.types.types.subst_type
use compiler.types.types.sym_constmap_get
use compiler.types.types.sym_constmap_insert
use compiler.types.types.thir_free
use compiler.types.types.thir_get_expr_type
use compiler.types.types.thir_get_sym_type
