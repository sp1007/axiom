use compiler.types.types.typeid_ptr_at
use compiler.types.types.usize_at

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic fn wrapping_add_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn rotate_left_u64(x: u64, n: u32) -> u64 { 0 }

fn assert_true(cond: bool, code: i32) {
    if !cond {
        exit(code);
    }
}

pub fn run_types_tests(
    arena: mut_view<Arena>,
    str_in: mut_view<StrInterner>,
    thir: mut_view<Thir>
) {
    thir_init(mut_view(*thir));

    assert_true(thir.interner.t_error.v == 1u32, 1);
    assert_true(thir.interner.t_unit.v == 2u32, 2);
    assert_true(thir.interner.t_str.v == 16u32, 3);
    assert_true(type_is_int(TypeId { v: thir.interner.t_i32.v }, view(thir.interner)), 4);
    assert_true(type_is_signed(TypeId { v: thir.interner.t_i32.v }, view(thir.interner)), 5);
    assert_true(!type_is_unsigned(TypeId { v: thir.interner.t_i32.v }, view(thir.interner)), 6);
    assert_true(type_is_unsigned(TypeId { v: thir.interner.t_u64.v }, view(thir.interner)), 7);
    assert_true(!type_is_int(TypeId { v: thir.interner.t_bool.v }, view(thir.interner)), 8);

    let ptr1 = intern_ptr_ty(mut_view(thir.interner), TypeId { v: thir.interner.t_i32.v }, false);
    let ptr2 = intern_ptr_ty(mut_view(thir.interner), TypeId { v: thir.interner.t_i32.v }, false);
    let ptr_mut = intern_ptr_ty(mut_view(thir.interner), TypeId { v: thir.interner.t_i32.v }, true);
    let ptr1_v = ptr1.v;
    assert_true(ptr1_v == ptr2.v, 10);
    assert_true(ptr1_v != ptr_mut.v, 11);

    let arr1 = intern_array_ty(mut_view(thir.interner), TypeId { v: thir.interner.t_u16.v }, 5u64);
    let arr2 = intern_array_ty(mut_view(thir.interner), TypeId { v: thir.interner.t_u16.v }, 5u64);
    let arr1_v = arr1.v;
    assert_true(arr1_v == arr2.v, 12);
    assert_true(type_size(TypeId { v: arr1_v }, view(thir.interner)) == 10u32, 13);
    assert_true(type_align(TypeId { v: arr1_v }, view(thir.interner)) == 2u32, 14);

    let sl_u8 = intern_slice_ty(mut_view(thir.interner), TypeId { v: thir.interner.t_u8.v });
    let v_slice = intern_view_ty(mut_view(thir.interner), TypeId { v: sl_u8.v }, false);
    let v_i32 = intern_view_ty(mut_view(thir.interner), TypeId { v: thir.interner.t_i32.v }, false);
    assert_true(type_size(TypeId { v: v_slice.v }, view(thir.interner)) == 16u32, 15);
    assert_true(type_size(TypeId { v: v_i32.v }, view(thir.interner)) == 8u32, 16);
    assert_true(type_size(TypeId { v: thir.interner.t_str.v }, view(thir.interner)) == 16u32, 17);

    let sfields = unsafe {
        arena_alloc_raw(mut_view(*arena), mul_usize(3, size_of<TypeId>()), align_of<TypeId>()) as *mut TypeId
    };
    unsafe {
        (*typeid_at(sfields, 0)).v = thir.interner.t_u8.v;
        (*typeid_at(sfields, 1)).v = thir.interner.t_u64.v;
        (*typeid_at(sfields, 2)).v = thir.interner.t_u16.v;
    }
    let dummy_def1 = unsafe {
        arena_alloc_raw(mut_view(*arena), size_of<HirItem>(), align_of<HirItem>()) as *const HirItem
    };
    let dummy_def2 = unsafe {
        arena_alloc_raw(mut_view(*arena), size_of<HirItem>(), align_of<HirItem>()) as *const HirItem
    };
    unsafe {
        ax_type_reset(mut_view(*thir.interner.scratch), TY_STRUCT);
        (*thir.interner.scratch).def = dummy_def1;
        (*thir.interner.scratch).fields = sfields;
        (*thir.interner.scratch).field_count = 3;
        (*thir.interner.scratch).is_repr_c = false;
    }
    let sp1 = thir.interner.scratch;
    let st_default = intern_type(mut_view(thir.interner), unsafe { view(*sp1) });
    let st_default_v = st_default.v;
    assert_true(type_size(TypeId { v: st_default_v }, view(thir.interner)) == 16u32, 20);
    assert_true(type_align(TypeId { v: st_default_v }, view(thir.interner)) == 8u32, 21);
    assert_true(type_field_offset(TypeId { v: st_default_v }, 0, view(thir.interner)) == 10u32, 22);
    assert_true(type_field_offset(TypeId { v: st_default_v }, 1, view(thir.interner)) == 0u32, 23);
    assert_true(type_field_offset(TypeId { v: st_default_v }, 2, view(thir.interner)) == 8u32, 24);

    unsafe {
        ax_type_reset(mut_view(*thir.interner.scratch), TY_STRUCT);
        (*thir.interner.scratch).def = dummy_def2;
        (*thir.interner.scratch).fields = sfields;
        (*thir.interner.scratch).field_count = 3;
        (*thir.interner.scratch).is_repr_c = true;
    }
    let sp2 = thir.interner.scratch;
    let st_repr_c = intern_type(mut_view(thir.interner), unsafe { view(*sp2) });
    let st_repr_c_v = st_repr_c.v;
    assert_true(type_size(TypeId { v: st_repr_c_v }, view(thir.interner)) == 24u32, 25);
    assert_true(type_field_offset(TypeId { v: st_repr_c_v }, 0, view(thir.interner)) == 0u32, 26);
    assert_true(type_field_offset(TypeId { v: st_repr_c_v }, 1, view(thir.interner)) == 8u32, 27);
    assert_true(type_field_offset(TypeId { v: st_repr_c_v }, 2, view(thir.interner)) == 16u32, 28);

    let vcounts = unsafe {
        arena_alloc_raw(mut_view(*arena), mul_usize(2, size_of<usize>()), align_of<usize>()) as *mut usize
    };
    let vfields = unsafe {
        arena_alloc_raw(mut_view(*arena), mul_usize(2, size_of<*mut TypeId>()), align_of<*mut TypeId>()) as *mut *mut TypeId
    };
    let v1_fields = unsafe {
        arena_alloc_raw(mut_view(*arena), mul_usize(2, size_of<TypeId>()), align_of<TypeId>()) as *mut TypeId
    };
    unsafe {
        (*typeid_at(v1_fields, 0)).v = thir.interner.t_u8.v;
        (*typeid_at(v1_fields, 1)).v = thir.interner.t_u64.v;
        *usize_at(vcounts, 0) = 0;
        *usize_at(vcounts, 1) = 2;
        *typeid_ptr_at(vfields, 0) = 0 as *mut TypeId;
        *typeid_ptr_at(vfields, 1) = v1_fields;
        ax_type_reset(mut_view(*thir.interner.scratch), TY_ENUM);
        (*thir.interner.scratch).def = dummy_def1;
        (*thir.interner.scratch).variant_count = 2;
        (*thir.interner.scratch).variant_field_counts = vcounts;
        (*thir.interner.scratch).variant_fields = vfields;
    }
    let sp3 = thir.interner.scratch;
    let enm_ty = intern_type(mut_view(thir.interner), unsafe { view(*sp3) });
    let enm_ty_v = enm_ty.v;
    assert_true(type_align(TypeId { v: enm_ty_v }, view(thir.interner)) == 8u32, 30);
    assert_true(type_size(TypeId { v: enm_ty_v }, view(thir.interner)) == 16u32, 31);
    assert_true(type_enum_field_offset(TypeId { v: enm_ty_v }, 1u32, 1, view(thir.interner)) == 8u32, 32);
    assert_true(type_enum_field_offset(TypeId { v: enm_ty_v }, 1u32, 0, view(thir.interner)) == 16u32, 33);

    let tup_ty = intern_tuple_ty(mut_view(thir.interner), v1_fields, 2);
    let tup_ty_v = tup_ty.v;
    assert_true(type_is_copy(TypeId { v: tup_ty_v }, view(*thir), view(*str_in)), 40);
    assert_true(!type_is_copy(TypeId { v: thir.interner.t_str.v }, view(*thir), view(*str_in)), 41);

    let fake_expr = dummy_def1 as *const HirExpr;
    thir_set_expr_type(mut_view(*thir), fake_expr, TypeId { v: tup_ty_v });
    let got_expr_ty = thir_get_expr_type(view(*thir), fake_expr);
    assert_true((got_expr_ty as usize) != 0, 42);
    assert_true(unsafe { (*got_expr_ty).v } == tup_ty_v, 43);

    thir_set_sym_type(mut_view(*thir), SymbolId { v: 77u32 }, TypeId { v: arr1_v });
    let got_sym_ty = thir_get_sym_type(view(*thir), SymbolId { v: 77u32 });
    assert_true((got_sym_ty as usize) != 0, 44);
    assert_true(unsafe { (*got_sym_ty).v } == arr1_v, 45);

    let cv = ConstValue {
        kind: CONST_INT,
        ty: TypeId { v: thir.interner.t_u64.v },
        int_val: 42u64,
        str_bytes: 0 as *const u8,
        str_len: 0,
        agg_data: 0 as *mut u8,
        agg_size: 0,
        agg_align: 0,
        alloc_id: 0u32,
    };
    sym_constmap_insert(mut_view(thir.symbol_consts), SymbolId { v: 88u32 }, view(cv));
    let got_cv = sym_constmap_get(view(thir.symbol_consts), SymbolId { v: 88u32 });
    assert_true((got_cv as usize) != 0, 46);
    assert_true(unsafe { (*got_cv).int_val } == 42u64, 47);

    // Unification & TypeVarTable tests
    let mut tv = TypeVarTable {
        items: 0 as *mut TypeVarEntry,
        len: 0,
        cap: 0,
        fn_var_start: 0,
    };
    type_vars_init(mut_view(tv));
    let iv0 = type_vars_new_int_var(mut_view(tv), mut_view(thir.interner));
    let iv1 = type_vars_new_int_var(mut_view(tv), mut_view(thir.interner));
    let iv0_v = iv0.v;
    let iv1_v = iv1.v;
    let t_bool_ty = TypeId { v: thir.interner.t_bool.v };
    let t_i64_ty = TypeId { v: thir.interner.t_i64.v };
    let iv0_a = TypeId { v: iv0_v };
    assert_true(!type_vars_unify(mut_view(tv), view(thir.interner), iv0_a, t_bool_ty), 50);
    let iv0_b = TypeId { v: iv0_v };
    let iv1_a = TypeId { v: iv1_v };
    assert_true(type_vars_unify(mut_view(tv), view(thir.interner), iv0_b, iv1_a), 51);
    let iv1_b = TypeId { v: iv1_v };
    assert_true(type_vars_unify(mut_view(tv), view(thir.interner), iv1_b, t_i64_ty), 52);
    let iv0_c = TypeId { v: iv0_v };
    let r_iv0 = type_vars_resolve(mut_view(tv), view(thir.interner), iv0_c);
    assert_true(r_iv0.v == thir.interner.t_i64.v, 53);

    let dummy_span = Span { file: FileId { v: 1u32 }, start: 0u32, end: 1u32 };
    let gv0 = type_vars_new_ty_var(mut_view(tv), mut_view(thir.interner), view(dummy_span));
    let gv0_v = gv0.v;
    let ptr_gv0 = intern_ptr_ty(mut_view(thir.interner), TypeId { v: gv0_v }, false);
    let ptr_gv0_ty = TypeId { v: ptr_gv0.v };
    let ptr1_ty = TypeId { v: ptr1_v };
    assert_true(type_vars_unify(mut_view(tv), view(thir.interner), ptr_gv0_ty, ptr1_ty), 54);
    let r_gv0 = type_vars_resolve(mut_view(tv), view(thir.interner), TypeId { v: gv0_v });
    assert_true(r_gv0.v == thir.interner.t_i32.v, 55);

    // Generic parameter substitution tests
    let p0 = intern_param_ty(mut_view(thir.interner), StrId { v: 1u32 }, 0u32);
    let ptr_p0 = intern_ptr_ty(mut_view(thir.interner), TypeId { v: p0.v }, false);
    let sub_buf = unsafe {
        arena_alloc_raw(mut_view(*arena), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId
    };
    unsafe {
        (*typeid_at(sub_buf, 0)).v = thir.interner.t_i32.v;
    }
    let gslice = GenericArgsSlice { args: sub_buf, count: 1 };
    let subbed_ptr = subst_type(TypeId { v: ptr_p0.v }, view(gslice), mut_view(thir.interner));
    assert_true(subbed_ptr.v == ptr1_v, 56);

    type_vars_free(mut_view(tv));
    thir_free(mut_view(*thir));
}

pub fn main() -> i32 {
    let mut arena: Arena = arena_new();
    let mut str_in: StrInterner = interner_new();
    let thir_ptr = arena_alloc_raw(mut_view(arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    unsafe {
        run_types_tests(mut_view(arena), mut_view(str_in), mut_view(*thir_ptr));
    }
    interner_free(mut_view(str_in));
    arena_destroy(mut_view(arena));
    print("OK Types Layout\n");
    0
}
