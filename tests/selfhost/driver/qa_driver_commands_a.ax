    let raw = arena_alloc_raw(arena, size_of<HirParam>(), align_of<HirParam>());
    zero_fill(raw, size_of<HirParam>());
    let n = raw as *mut HirParam;
    unsafe { hir_set_span(mut_view((*n).span), sp); }
    n
}

