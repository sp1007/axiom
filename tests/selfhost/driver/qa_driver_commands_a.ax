// =============================================================================
// 10. Conditional Set, Branches, Calls, Stack & System Instructions
// =============================================================================

pub fn x64_setcc_r(sec: mut_view<Section>, cc: u8, dst: i32) {
    x64_emit_rex_rr(mut_view(*sec), 1u8, REG_NONE, dst);
    x64_emit8(mut_view(*sec), 0x0Fu8);
    x64_emit8(mut_view(*sec), 0x90u8 + (cc & 0xFu8));
    x64_emit8(mut_view(*sec), 0xC0u8 | x64_reg_low3(dst));
}

pub fn ax_x64_setcc_r(sec: mut_view<Section>, cc: u8, dst: i32) {
    x64_setcc_r(sec, cc, dst);
}

pub fn x64_setcc_m(sec: mut_view<Section>, cc: u8, dst: X64Mem) {
    x64_emit_rex_rm(mut_view(*sec), 1u8, REG_NONE, dst);
    x64_emit8(mut_view(*sec), 0x0Fu8);
    x64_emit8(mut_view(*sec), 0x90u8 + (cc & 0xFu8));
    x64_emit_modrm_sib_disp(mut_view(*sec), 0, dst);
}

pub fn ax_x64_setcc_m(sec: mut_view<Section>, cc: u8, dst: X64Mem) {
    x64_setcc_m(sec, cc, dst);
}

pub fn x64_cmovcc_rr(sec: mut_view<Section>, sz: u8, cc: u8, dst: i32, src: i32) {
    let eff_sz = if sz == 2u8 || sz == 4u8 || sz == 8u8 { sz } else { 8u8 };
    x64_emit_sz_prefix(mut_view(*sec), eff_sz);
    x64_emit_rex_rr(mut_view(*sec), eff_sz, dst, src);
    x64_emit8(mut_view(*sec), 0x0Fu8);
    x64_emit8(mut_view(*sec), 0x40u8 + (cc & 0xFu8));
    x64_emit8(mut_view(*sec), 0xC0u8 | (x64_reg_low3(dst) << 3) | x64_reg_low3(src));
}

pub fn ax_x64_cmovcc_rr(sec: mut_view<Section>, sz: u8, cc: u8, dst: i32, src: i32) {
    x64_cmovcc_rr(sec, sz, cc, dst, src);
}

pub fn x64_cmovcc_rm(sec: mut_view<Section>, sz: u8, cc: u8, dst: i32, src: X64Mem) {
    let eff_sz = if sz == 2u8 || sz == 4u8 || sz == 8u8 { sz } else { 8u8 };
    x64_emit_sz_prefix(mut_view(*sec), eff_sz);
    x64_emit_rex_rm(mut_view(*sec), eff_sz, dst, src);
    x64_emit8(mut_view(*sec), 0x0Fu8);
    x64_emit8(mut_view(*sec), 0x40u8 + (cc & 0xFu8));
    x64_emit_modrm_sib_disp(mut_view(*sec), dst, src);
}

pub fn ax_x64_cmovcc_rm(sec: mut_view<Section>, sz: u8, cc: u8, dst: i32, src: X64Mem) {
    x64_cmovcc_rm(sec, sz, cc, dst, src);
}

pub fn x64_jcc(sec: mut_view<Section>, cc: u8, rel32: i32) {
    x64_emit8(mut_view(*sec), 0x0Fu8);
    x64_emit8(mut_view(*sec), 0x80u8 + (cc & 0xFu8));
    x64_emit_i32(mut_view(*sec), rel32);
}

pub fn ax_x64_jcc(sec: mut_view<Section>, cc: u8, rel32: i32) {
    x64_jcc(sec, cc, rel32);
}

pub fn x64_jcc_sym(sec: mut_view<Section>, cc: u8, sym: SymbolId) {
    x64_emit8(mut_view(*sec), 0x0Fu8);
    x64_emit8(mut_view(*sec), 0x80u8 + (cc & 0xFu8));
    let reloc_off = sec.bytes_len as u32;
    section_add_reloc(mut_view(*sec), reloc_off, AX_RELOC_X86_64_PC32, sym, -4i64);
    x64_emit32(mut_view(*sec), 0u32);
}

pub fn ax_x64_jcc_sym(sec: mut_view<Section>, cc: u8, sym: SymbolId) {
    x64_jcc_sym(sec, cc, sym);
}

pub fn x64_jmp(sec: mut_view<Section>, rel32: i32) {
    x64_emit8(mut_view(*sec), 0xE9u8);
    x64_emit_i32(mut_view(*sec), rel32);
}

pub fn ax_x64_jmp(sec: mut_view<Section>, rel32: i32) {
    x64_jmp(sec, rel32);
}

pub fn x64_jmp_sym(sec: mut_view<Section>, sym: SymbolId) {
    x64_emit8(mut_view(*sec), 0xE9u8);
    let reloc_off = sec.bytes_len as u32;
    section_add_reloc(mut_view(*sec), reloc_off, AX_RELOC_X86_64_PC32, sym, -4i64);
    x64_emit32(mut_view(*sec), 0u32);
}

pub fn ax_x64_jmp_sym(sec: mut_view<Section>, sym: SymbolId) {
    x64_jmp_sym(sec, sym);
}

pub fn x64_jcc8(sec: mut_view<Section>, cc: u8, rel8: i8) {
    x64_emit8(mut_view(*sec), 0x70u8 + (cc & 0xFu8));
    x64_emit8(mut_view(*sec), rel8 as u8);
}

pub fn ax_x64_jcc8(sec: mut_view<Section>, cc: u8, rel8: i8) {
    x64_jcc8(sec, cc, rel8);
}

pub fn x64_jmp8(sec: mut_view<Section>, rel8: i8) {
    x64_emit8(mut_view(*sec), 0xEBu8);
    x64_emit8(mut_view(*sec), rel8 as u8);
}

pub fn ax_x64_jmp8(sec: mut_view<Section>, rel8: i8) {
    x64_jmp8(sec, rel8);
}

pub fn x64_call(sec: mut_view<Section>, rel32: i32) {
    x64_emit8(mut_view(*sec), 0xE8u8);
    x64_emit_i32(mut_view(*sec), rel32);
}

pub fn ax_x64_call(sec: mut_view<Section>, rel32: i32) {
    x64_call(sec, rel32);
}

pub fn x64_call_sym(sec: mut_view<Section>, sym: SymbolId) {
    x64_emit8(mut_view(*sec), 0xE8u8);
    let reloc_off = sec.bytes_len as u32;
    section_add_reloc(mut_view(*sec), reloc_off, AX_RELOC_X86_64_PC32, sym, -4i64);
    x64_emit32(mut_view(*sec), 0u32);
}

pub fn ax_x64_call_sym(sec: mut_view<Section>, sym: SymbolId) {
    x64_call_sym(sec, sym);
}

pub fn x64_call_r(sec: mut_view<Section>, dst: i32) {
    x64_emit_rex_rr(mut_view(*sec), 8u8, REG_NONE, dst);
    x64_emit8(mut_view(*sec), 0xFFu8);
    x64_emit8(mut_view(*sec), 0xD0u8 | x64_reg_low3(dst));
}

pub fn ax_x64_call_r(sec: mut_view<Section>, dst: i32) {
    x64_call_r(sec, dst);
}

pub fn x64_call_m(sec: mut_view<Section>, dst: X64Mem) {
    x64_emit_rex_rm(mut_view(*sec), 8u8, REG_NONE, dst);
    x64_emit8(mut_view(*sec), 0xFFu8);
    x64_emit_modrm_sib_disp(mut_view(*sec), 2, dst);
}

pub fn ax_x64_call_m(sec: mut_view<Section>, dst: X64Mem) {
    x64_call_m(sec, dst);
}

pub fn x64_ret(sec: mut_view<Section>) {
    x64_emit8(sec, 0xC3u8);
}

pub fn ax_x64_ret(sec: mut_view<Section>) {
    x64_ret(sec);
}

pub fn x64_push_r(sec: mut_view<Section>, src: i32) {
    if x64_reg_is_extended(src) {
        x64_emit8(mut_view(*sec), 0x41u8);
    }
    x64_emit8(mut_view(*sec), 0x50u8 + x64_reg_low3(src));
}

pub fn ax_x64_push_r(sec: mut_view<Section>, src: i32) {
    x64_push_r(sec, src);
}

pub fn x64_push_m(sec: mut_view<Section>, src: X64Mem) {
    let x = x64_reg_is_extended(src.index);
    let b = x64_reg_is_extended(src.base);
    if x || b {
        let mut rex: u8 = 0x40u8;
        if x { rex = rex | 2u8; }
        if b { rex = rex | 1u8; }
        x64_emit8(mut_view(*sec), rex);
    }
    x64_emit8(mut_view(*sec), 0xFFu8);
    x64_emit_modrm_sib_disp(mut_view(*sec), 6, src);
}

pub fn ax_x64_push_m(sec: mut_view<Section>, src: X64Mem) {
    x64_push_m(sec, src);
}

pub fn x64_pop_r(sec: mut_view<Section>, dst: i32) {
    if x64_reg_is_extended(dst) {
        x64_emit8(mut_view(*sec), 0x41u8);
    }
    x64_emit8(mut_view(*sec), 0x58u8 + x64_reg_low3(dst));
}

pub fn ax_x64_pop_r(sec: mut_view<Section>, dst: i32) {
    x64_pop_r(sec, dst);
}

pub fn x64_pop_m(sec: mut_view<Section>, dst: X64Mem) {
    let x = x64_reg_is_extended(dst.index);
    let b = x64_reg_is_extended(dst.base);
    if x || b {
        let mut rex: u8 = 0x40u8;
        if x { rex = rex | 2u8; }
        if b { rex = rex | 1u8; }
        x64_emit8(mut_view(*sec), rex);
    }
    x64_emit8(mut_view(*sec), 0x8Fu8);
    x64_emit_modrm_sib_disp(mut_view(*sec), 0, dst);
}

pub fn ax_x64_pop_m(sec: mut_view<Section>, dst: X64Mem) {
    x64_pop_m(sec, dst);
}

pub fn x64_int3(sec: mut_view<Section>) {
    x64_emit8(sec, 0xCCu8);
}

pub fn ax_x64_int3(sec: mut_view<Section>) {
    x64_int3(sec);
}

pub fn x64_nop(sec: mut_view<Section>) {
    x64_emit8(sec, 0x90u8);
}

pub fn ax_x64_nop(sec: mut_view<Section>) {
    x64_nop(sec);
}

pub fn x64_align_code(sec: mut_view<Section>, align: usize) {
    if align <= 1 {
        return;
    }
    while (sec.bytes_len % align) != 0 {
        x64_emit8(mut_view(*sec), 0x90u8);
    }
}

// =============================================================================
// 11. Relocation Generation, Branch Fixups, Rodata Labels & Frame Helpers
// =============================================================================

@derive(Copy)
pub struct X64BranchFixup {
    pub fixup_offset: u32,
    pub target_bb: u32,
}

// Emit a 5-byte `jmp rel32` placeholder (0xE9 00 00 00 00) and record the 4-byte displacement offset.
pub fn x64_emit_jmp_placeholder(sec: mut_view<Section>, target_bb: u32) -> X64BranchFixup {
    let fixup_off = (sec.bytes_len + 1) as u32;
    x64_jmp(sec, 0);
    X64BranchFixup {
        fixup_offset: fixup_off,
        target_bb: target_bb,
    }
}

// Emit a 6-byte `jcc rel32` placeholder (0x0F 0x80+cc 00 00 00 00) and record the 4-byte displacement offset.
pub fn x64_emit_jcc_placeholder(sec: mut_view<Section>, cc: u8, target_bb: u32) -> X64BranchFixup {
    let fixup_off = (sec.bytes_len + 2) as u32;
    x64_jcc(sec, cc, 0);
    X64BranchFixup {
        fixup_offset: fixup_off,
        target_bb: target_bb,
    }
}

// Patch a 32-bit PC-relative displacement in-place at `fixup_offset` (where `next_rip = fixup_offset + 4`).
pub fn x64_patch_rel32(sec: mut_view<Section>, fixup_offset: u32, target_byte_offset: u32) {
    let off = fixup_offset as usize;
    if off + 4 > sec.bytes_len || (sec.bytes as usize) == 0 {
        return;
    }
    let next_rip = fixup_offset + 4u32;
    let rel32 = (target_byte_offset as i32) - (next_rip as i32);
    coff_write_u32_le(sec.bytes, off, rel32 as u32);
}

// Patch all recorded basic-block branch fixups using `bb_offsets`.
pub fn x64_patch_branch_fixups(
    sec: mut_view<Section>,
    fixups: view<[X64BranchFixup]>,
    fixup_count: usize,
    bb_offsets: view<[u32]>
) {
    let bb_len = len(bb_offsets);
    let max_fixups = if fixup_count < len(fixups) { fixup_count } else { len(fixups) };
    let mut i: usize = 0;
    while i < max_fixups {
        let fx = fixups[i];
        let tgt_idx = fx.target_bb as usize;
        if tgt_idx < bb_len {
            x64_patch_rel32(mut_view(*sec), fx.fixup_offset, bb_offsets[tgt_idx]);
        }
        i = i + 1;
    }
}

// Compute 8-bit signed relative displacement for short branches (jmp8 / jcc8) where
// `next_rip = branch_start_offset + branch_len` (branch_len == 2 for jmp8 and jcc8).
pub fn x64_compute_rel8(branch_start_offset: u32, branch_len: u32, target_byte_offset: u32) -> i8 {
    let next_rip = (branch_start_offset + branch_len) as i32;
    let rel = (target_byte_offset as i32) - next_rip;
    rel as i8
}

// Lookup an existing symbol by C-string name, or create a new external symbol if absent.
pub fn x64_find_or_add_extern_sym(obj: mut_view<ObjModel>, name: *const u8) -> SymbolId {
    let existing = objmodel_find_symbol(view(*obj), name);
    if existing.is_some() {
        return existing;
    }
    objmodel_add_symbol(obj, name, SectionId.none(), 0u64, 0u64, AX_SYM_EXTERNAL)
}

// Lookup an existing symbol by `Str` name, or create a new external symbol if absent.
pub fn x64_find_or_add_extern_sym_str(obj: mut_view<ObjModel>, name: Str) -> SymbolId {
    let p = unsafe { address_of(name) as *const Str };
    let existing = objmodel_find_symbol_str(view(*obj), unsafe { *p });
    if existing.is_some() {
        return existing;
    }
    objmodel_add_symbol_str(obj, unsafe { *p }, SectionId.none(), 0u64, 0u64, AX_SYM_EXTERNAL)
}

// Emit `call sym` (0xE8 + PC32 reloc with addend -4) for a named symbol (reusing or adding external symbol).
pub fn x64_call_extern(sec: mut_view<Section>, obj: mut_view<ObjModel>, name: *const u8) -> SymbolId {
    let sym = objmodel_add_symbol(obj, name, SectionId.none(), 0u64, 0u64, AX_SYM_EXTERNAL);
    x64_call_sym(sec, SymbolId { v: sym.v });
    sym
}

pub fn x64_call_extern_str(sec: mut_view<Section>, obj: mut_view<ObjModel>, name: Str) -> SymbolId {
    let sym = objmodel_add_symbol_str(obj, name, SectionId.none(), 0u64, 0u64, AX_SYM_EXTERNAL);
    x64_call_sym(sec, SymbolId { v: sym.v });
    sym
}

// Emit `lea dst, [rip + sym]` for a named function/rodata symbol (finding existing symbol first, as in emit_obj.c / build.c).
pub fn x64_lea_extern(sec: mut_view<Section>, obj: mut_view<ObjModel>, dst: i32, name: *const u8) -> SymbolId {
    let sym = x64_find_or_add_extern_sym(obj, name);
    x64_lea_sym(sec, dst, SymbolId { v: sym.v });
    sym
}

pub fn x64_lea_extern_str(sec: mut_view<Section>, obj: mut_view<ObjModel>, dst: i32, name: Str) -> SymbolId {
    let sym = x64_find_or_add_extern_sym_str(obj, name);
    x64_lea_sym(sec, dst, SymbolId { v: sym.v });
    sym
}

// Emit a NUL-terminated string literal into `.rdata` (with optional 8-byte padding) and register its symbol.
pub fn x64_emit_rodata_bytes(
    rdata_sec: mut_view<Section>,
    obj: mut_view<ObjModel>,
    rdata_sec_id: SectionId,
    sym_name: *const u8,
    bytes: *const u8,
    str_len: usize,
    align8: bool,
    linkage: u32
) -> SymbolId {
    let offset = rdata_sec.bytes_len as u64;
    if str_len > 0 && (bytes as usize) != 0 {
        section_add_bytes(mut_view(*rdata_sec), bytes, str_len);
    }
    section_add_byte(mut_view(*rdata_sec), 0u8);
    if align8 {
        while (rdata_sec.bytes_len % 8) != 0 {
            section_add_byte(mut_view(*rdata_sec), 0u8);
        }
    }
    objmodel_add_symbol(obj, sym_name, rdata_sec_id, offset, str_len as u64, linkage)
}

pub fn x64_emit_rodata_slice(
    rdata_sec: mut_view<Section>,
    obj: mut_view<ObjModel>,
    rdata_sec_id: SectionId,
    sym_name: Str,
    data: view<[u8]>,
    align8: bool,
    linkage: u32
) -> SymbolId {
    let offset = rdata_sec.bytes_len as u64;
    let str_len = len(data);
    if str_len > 0 {
        section_append_slice(mut_view(*rdata_sec), data);
    }
    section_add_byte(mut_view(*rdata_sec), 0u8);
    if align8 {
        while (rdata_sec.bytes_len % 8) != 0 {
            section_add_byte(mut_view(*rdata_sec), 0u8);
        }
    }
    objmodel_add_symbol_str(obj, sym_name, rdata_sec_id, offset, str_len as u64, linkage)
}

// Emit the inline `AX_X64_MI_ASSERT` panic call sequence from `bootstrap/axiom0/src/driver/build_native/build.c`:
//   48 83 EC 20                sub rsp, 32
//   48 8D 0D 00 00 00 00       lea rcx, [rip + str_sym]   (RELOC_X86_64_PC32, addend -4)
//   48 C7 C2 <msg_len:u32>     mov rdx, msg_len
//   E8 00 00 00 00             call axiom_panic           (RELOC_X86_64_PC32, addend -4)
pub fn x64_emit_panic_sequence(
    sec: mut_view<Section>,
    str_sym: SymbolId,
    msg_len: u32,
    panic_fn_sym: SymbolId
) {
    x64_sub_ri(mut_view(*sec), 8u8, REG_RSP, 32);
    x64_lea_sym(mut_view(*sec), REG_RCX, str_sym);
    x64_emit8(mut_view(*sec), 0x48u8);
    x64_emit8(mut_view(*sec), 0xC7u8);
    x64_emit8(mut_view(*sec), 0xC2u8);
    x64_emit32(mut_view(*sec), msg_len);
    x64_call_sym(mut_view(*sec), panic_fn_sym);
}

// Emit standard Windows x64 function prologue (matching bootstrap/axiom0/src/target/x64/frame/frame.c):
//   push rbp; mov rbp, rsp; push rbx, rsi, rdi, r12, r13, r14, r15
//   if frame_size > 4096: inline 4096-byte page probe loop (`test [rsp], eax`; `ja probe_start`)
//   else if frame_size > 0: `sub rsp, frame_size`
pub fn x64_emit_prologue_size(sec: mut_view<Section>, frame_size: u32) {
    x64_push_r(mut_view(*sec), REG_RBP);
    x64_mov_rr(mut_view(*sec), 8u8, REG_RBP, REG_RSP);
    x64_push_r(mut_view(*sec), REG_RBX);
    x64_push_r(mut_view(*sec), REG_RSI);
    x64_push_r(mut_view(*sec), REG_RDI);
    x64_push_r(mut_view(*sec), REG_R12);
    x64_push_r(mut_view(*sec), REG_R13);
    x64_push_r(mut_view(*sec), REG_R14);
    x64_push_r(mut_view(*sec), REG_R15);

    if frame_size > 0u32 {
        if frame_size > 4096u32 {
            x64_mov_ri(mut_view(*sec), 8u8, REG_RAX, frame_size as i64);
            let probe_start = sec.bytes_len as u32;
            x64_sub_ri(mut_view(*sec), 8u8, REG_RSP, 4096);
            let rsp_mem = x64_mem_base(REG_RSP);
            x64_test_rm(mut_view(*sec), 4u8, REG_RAX, rsp_mem);
            x64_sub_ri(mut_view(*sec), 8u8, REG_RAX, 4096);
            x64_cmp_ri(mut_view(*sec), 8u8, REG_RAX, 4096);
            let rel8 = x64_compute_rel8(sec.bytes_len as u32, 2u32, probe_start);
            x64_jcc8(mut_view(*sec), CC_A, rel8);
            x64_sub_rr(mut_view(*sec), 8u8, REG_RSP, REG_RAX);
        } else {
            x64_sub_ri(mut_view(*sec), 8u8, REG_RSP, frame_size as i32);
        }
    }
}

pub fn ax_x64_emit_prologue_size(sec: mut_view<Section>, frame_size: u32) {
    x64_emit_prologue_size(sec, frame_size);
}

// Emit standard Windows x64 function epilogue (matching bootstrap/axiom0/src/target/x64/frame/frame.c):
//   if frame_size > 0: `add rsp, frame_size`
//   pop r15, r14, r13, r12, rdi, rsi, rbx, rbp
pub fn x64_emit_epilogue_size(sec: mut_view<Section>, frame_size: u32) {
    if frame_size > 0u32 {
        x64_add_ri(mut_view(*sec), 8u8, REG_RSP, frame_size as i32);
    }
    x64_pop_r(mut_view(*sec), REG_R15);
    x64_pop_r(mut_view(*sec), REG_R14);
    x64_pop_r(mut_view(*sec), REG_R13);
    x64_pop_r(mut_view(*sec), REG_R12);
    x64_pop_r(mut_view(*sec), REG_RDI);
    x64_pop_r(mut_view(*sec), REG_RSI);
    x64_pop_r(mut_view(*sec), REG_RBX);
    x64_pop_r(mut_view(*sec), REG_RBP);
}

pub fn ax_x64_emit_epilogue_size(sec: mut_view<Section>, frame_size: u32) {
    x64_emit_epilogue_size(sec, frame_size);
}

// Emit Windows x64 function prologue with dynamic callee-saved GPR and XMM masks (`SPEC-77 AXS-RA-026`).
// `callee_mask`: bits 0..15 for GPRs (`RBX`=3, `RSI`=6, `RDI`=7, `R12`..`R15`=12..15),
//                bits 16..31 for XMMs (`XMM6`..`XMM15` = bits 22..31).
// `xmm_save_offset`: base offset relative to `RBP` where used callee-saved XMM registers are saved.
pub fn x64_emit_prologue_masked(
    sec: mut_view<Section>,
    frame_size: u32,
    callee_mask: u32,
    xmm_save_offset: i32
) {
    x64_push_r(mut_view(*sec), REG_RBP);
    x64_mov_rr(mut_view(*sec), 8u8, REG_RBP, REG_RSP);
    if (callee_mask & (1u32 << (REG_RBX as u32))) != 0u32 { x64_push_r(mut_view(*sec), REG_RBX); }
    if (callee_mask & (1u32 << (REG_RSI as u32))) != 0u32 { x64_push_r(mut_view(*sec), REG_RSI); }
    if (callee_mask & (1u32 << (REG_RDI as u32))) != 0u32 { x64_push_r(mut_view(*sec), REG_RDI); }
    if (callee_mask & (1u32 << (REG_R12 as u32))) != 0u32 { x64_push_r(mut_view(*sec), REG_R12); }
    if (callee_mask & (1u32 << (REG_R13 as u32))) != 0u32 { x64_push_r(mut_view(*sec), REG_R13); }
    if (callee_mask & (1u32 << (REG_R14 as u32))) != 0u32 { x64_push_r(mut_view(*sec), REG_R14); }
    if (callee_mask & (1u32 << (REG_R15 as u32))) != 0u32 { x64_push_r(mut_view(*sec), REG_R15); }

    if frame_size > 0u32 {
        if frame_size > 4096u32 {
            x64_mov_ri(mut_view(*sec), 8u8, REG_RAX, frame_size as i64);
            let probe_start = sec.bytes_len as u32;
            x64_sub_ri(mut_view(*sec), 8u8, REG_RSP, 4096);
            let rsp_mem = x64_mem_base(REG_RSP);
            x64_test_rm(mut_view(*sec), 4u8, REG_RAX, rsp_mem);
            x64_sub_ri(mut_view(*sec), 8u8, REG_RAX, 4096);
            x64_cmp_ri(mut_view(*sec), 8u8, REG_RAX, 4096);
            let rel8 = x64_compute_rel8(sec.bytes_len as u32, 2u32, probe_start);
            x64_jcc8(mut_view(*sec), CC_A, rel8);
            x64_sub_rr(mut_view(*sec), 8u8, REG_RSP, REG_RAX);
        } else {
            x64_sub_ri(mut_view(*sec), 8u8, REG_RSP, frame_size as i32);
        }
    }

    if (callee_mask & 0xFFC00000u32) != 0u32 && xmm_save_offset != 0 {
        let mut cur_off: i32 = xmm_save_offset;
        let mut r: i32 = REG_XMM6;
        while r <= REG_XMM15 {
            if (callee_mask & (1u32 << (r as u32))) != 0u32 {
                x64_movaps_mr(mut_view(*sec), x64_mem_frame_rbp(cur_off), r);
                cur_off = cur_off - 16;
            }
            r = r + 1;
        }
    }
}

pub fn ax_x64_emit_prologue_masked(
    sec: mut_view<Section>,
    frame_size: u32,
    callee_mask: u32,
    xmm_save_offset: i32
) {
    x64_emit_prologue_masked(sec, frame_size, callee_mask, xmm_save_offset);
}

// Emit Windows x64 function epilogue with dynamic callee-saved GPR and XMM masks (`SPEC-77 AXS-RA-026`).
pub fn x64_emit_epilogue_masked(
    sec: mut_view<Section>,
    frame_size: u32,
    callee_mask: u32,
    xmm_save_offset: i32
) {
    if (callee_mask & 0xFFC00000u32) != 0u32 && xmm_save_offset != 0 {
        let mut cur_off: i32 = xmm_save_offset;
        let mut r: i32 = REG_XMM6;
        while r <= REG_XMM15 {
            if (callee_mask & (1u32 << (r as u32))) != 0u32 {
                x64_movaps_rm(mut_view(*sec), r, x64_mem_frame_rbp(cur_off));
                cur_off = cur_off - 16;
            }
            r = r + 1;
        }
    }

    if frame_size > 0u32 {
        x64_add_ri(mut_view(*sec), 8u8, REG_RSP, frame_size as i32);
    }
    if (callee_mask & (1u32 << (REG_R15 as u32))) != 0u32 { x64_pop_r(mut_view(*sec), REG_R15); }
    if (callee_mask & (1u32 << (REG_R14 as u32))) != 0u32 { x64_pop_r(mut_view(*sec), REG_R14); }
    if (callee_mask & (1u32 << (REG_R13 as u32))) != 0u32 { x64_pop_r(mut_view(*sec), REG_R13); }
    if (callee_mask & (1u32 << (REG_R12 as u32))) != 0u32 { x64_pop_r(mut_view(*sec), REG_R12); }
    if (callee_mask & (1u32 << (REG_RDI as u32))) != 0u32 { x64_pop_r(mut_view(*sec), REG_RDI); }
    if (callee_mask & (1u32 << (REG_RSI as u32))) != 0u32 { x64_pop_r(mut_view(*sec), REG_RSI); }
    if (callee_mask & (1u32 << (REG_RBX as u32))) != 0u32 { x64_pop_r(mut_view(*sec), REG_RBX); }
    x64_pop_r(mut_view(*sec), REG_RBP);
}

pub fn ax_x64_emit_epilogue_masked(
    sec: mut_view<Section>,
    frame_size: u32,
    callee_mask: u32,
    xmm_save_offset: i32
) {
    x64_emit_epilogue_masked(sec, frame_size, callee_mask, xmm_save_offset);
}

// =============================================================================
// 14. Atomic & Synchronization Instructions (SPEC-31 AXS-ATM-042..047)
// =============================================================================

pub fn x64_xchg_rr(sec: mut_view<Section>, sz: u8, dst: i32, src: i32) {
    x64_emit_op_rm(sec, sz, 0x86u8, 0x87u8, src, dst);
}

pub fn ax_x64_xchg_rr(sec: mut_view<Section>, sz: u8, dst: i32, src: i32) {
    x64_xchg_rr(sec, sz, dst, src);
}

pub fn x64_xchg_mr(sec: mut_view<Section>, sz: u8, dst: X64Mem, src: i32) {
    x64_emit_op_mem(sec, sz, 0x86u8, 0x87u8, src, dst);
}

pub fn ax_x64_xchg_mr(sec: mut_view<Section>, sz: u8, dst: X64Mem, src: i32) {
    x64_xchg_mr(sec, sz, dst, src);
}

pub fn x64_lock_xadd_mr(sec: mut_view<Section>, sz: u8, dst: X64Mem, src: i32) {
    x64_emit8(mut_view(*sec), 0xF0u8);
    x64_emit_sz_prefix(mut_view(*sec), sz);
    x64_emit_rex_rm(mut_view(*sec), sz, src, dst);
    x64_emit8(mut_view(*sec), 0x0Fu8);
    x64_emit8(mut_view(*sec), if sz == 1u8 { 0xC0u8 } else { 0xC1u8 });
    x64_emit_modrm_sib_disp(mut_view(*sec), src, dst);
}

pub fn ax_x64_lock_xadd_mr(sec: mut_view<Section>, sz: u8, dst: X64Mem, src: i32) {
    x64_lock_xadd_mr(sec, sz, dst, src);
}

pub fn x64_lock_cmpxchg_mr(sec: mut_view<Section>, sz: u8, dst: X64Mem, src: i32) {
    x64_emit8(mut_view(*sec), 0xF0u8);
    x64_emit_sz_prefix(mut_view(*sec), sz);
    x64_emit_rex_rm(mut_view(*sec), sz, src, dst);
    x64_emit8(mut_view(*sec), 0x0Fu8);
    x64_emit8(mut_view(*sec), if sz == 1u8 { 0xB0u8 } else { 0xB1u8 });
    x64_emit_modrm_sib_disp(mut_view(*sec), src, dst);
}

pub fn ax_x64_lock_cmpxchg_mr(sec: mut_view<Section>, sz: u8, dst: X64Mem, src: i32) {
    x64_lock_cmpxchg_mr(sec, sz, dst, src);
}

pub fn x64_lock_add_mr(sec: mut_view<Section>, sz: u8, dst: X64Mem, src: i32) {
    x64_emit8(mut_view(*sec), 0xF0u8);
    x64_emit_op_mem(mut_view(*sec), sz, 0x00u8, 0x01u8, src, dst);
}

pub fn ax_x64_lock_add_mr(sec: mut_view<Section>, sz: u8, dst: X64Mem, src: i32) {
    x64_lock_add_mr(sec, sz, dst, src);
}

pub fn x64_lock_sub_mr(sec: mut_view<Section>, sz: u8, dst: X64Mem, src: i32) {
    x64_emit8(mut_view(*sec), 0xF0u8);
    x64_emit_op_mem(mut_view(*sec), sz, 0x28u8, 0x29u8, src, dst);
}

pub fn ax_x64_lock_sub_mr(sec: mut_view<Section>, sz: u8, dst: X64Mem, src: i32) {
    x64_lock_sub_mr(sec, sz, dst, src);
}

pub fn x64_lock_and_mr(sec: mut_view<Section>, sz: u8, dst: X64Mem, src: i32) {
    x64_emit8(mut_view(*sec), 0xF0u8);
    x64_emit_op_mem(mut_view(*sec), sz, 0x20u8, 0x21u8, src, dst);
}

pub fn ax_x64_lock_and_mr(sec: mut_view<Section>, sz: u8, dst: X64Mem, src: i32) {
    x64_lock_and_mr(sec, sz, dst, src);
}

pub fn x64_lock_or_mr(sec: mut_view<Section>, sz: u8, dst: X64Mem, src: i32) {
    x64_emit8(mut_view(*sec), 0xF0u8);
    x64_emit_op_mem(mut_view(*sec), sz, 0x08u8, 0x09u8, src, dst);
}

pub fn ax_x64_lock_or_mr(sec: mut_view<Section>, sz: u8, dst: X64Mem, src: i32) {
    x64_lock_or_mr(sec, sz, dst, src);
}

pub fn x64_lock_xor_mr(sec: mut_view<Section>, sz: u8, dst: X64Mem, src: i32) {
    x64_emit8(mut_view(*sec), 0xF0u8);
    x64_emit_op_mem(mut_view(*sec), sz, 0x30u8, 0x31u8, src, dst);
}

pub fn ax_x64_lock_xor_mr(sec: mut_view<Section>, sz: u8, dst: X64Mem, src: i32) {
    x64_lock_xor_mr(sec, sz, dst, src);
}

pub fn x64_mfence(sec: mut_view<Section>) {
    x64_emit8(mut_view(*sec), 0x0Fu8);
    x64_emit8(mut_view(*sec), 0xAEu8);
    x64_emit8(mut_view(*sec), 0xF0u8);
}

pub fn ax_x64_mfence(sec: mut_view<Section>) {
    x64_mfence(sec);
}

pub fn x64_pause(sec: mut_view<Section>) {
    x64_emit8(mut_view(*sec), 0xF3u8);
    x64_emit8(mut_view(*sec), 0x90u8);
}

pub fn ax_x64_pause(sec: mut_view<Section>) {
    x64_pause(sec);
}

