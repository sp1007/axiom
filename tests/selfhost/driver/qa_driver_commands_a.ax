pub fn hir_alloc_field_init(arena: mut_view<Arena>, sp: Span) -> *mut HirFieldInit {
    let raw = arena_alloc_raw(arena, size_of<HirFieldInit>(), align_of<HirFieldInit>());
    zero_fill(raw, size_of<HirFieldInit>());
    let n = raw as *mut HirFieldInit;
    unsafe { hir_set_span(mut_view((*n).span), sp); }
    n
}

pub fn hir_alloc_match_arm(arena: mut_view<Arena>, sp: Span) -> *mut HirMatchArm {
    let raw = arena_alloc_raw(arena, size_of<HirMatchArm>(), align_of<HirMatchArm>());
    zero_fill(raw, size_of<HirMatchArm>());
    let n = raw as *mut HirMatchArm;
    unsafe { hir_set_span(mut_view((*n).span), sp); }
    n
}

