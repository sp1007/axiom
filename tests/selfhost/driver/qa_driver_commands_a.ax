    let su = x64_reg_unit(src);
    x64_emit_rex_rr(mut_view(*sec), 4u8, du, su);
    x64_emit8(mut_view(*sec), 0x0Fu8);
    x64_emit8(mut_view(*sec), 0x28u8);
    x64_emit8(mut_view(*sec), 0xC0u8 | (x64_reg_low3(du) << 3) | x64_reg_low3(su));
