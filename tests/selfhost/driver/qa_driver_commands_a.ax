pub struct Token {
    pub kind: u8,
    pub suffix: u8,
    pub flags: u16,
    pub char_val: u32,
    pub span: Span,
    pub int_val: u64,
    pub str_ptr: *const u8,
    pub str_len: usize,
    pub ident_val: StrId,
}

pub fn token_int_hi(tok: view<Token>) -> u64 {
    (tok.char_val as u64) | (((tok.str_len as u64) & 0xFFFFFFFFu64) << 32u64)
}

pub fn token_set_int_hi(tok: mut_view<Token>, hi: u64) {
    tok.char_val = (hi & 0xFFFFFFFFu64) as u32;
    tok.str_len = ((hi >> 32u64) & 0xFFFFFFFFu64) as usize;
}

pub struct Comment {
    pub kind: u8,
    pub span: Span,
}

pub struct LexResult {
    pub arena: Arena,
    pub tokens: *mut Token,
    pub token_count: usize,
    pub token_cap: usize,
    pub comments: *mut Comment,
    pub comment_count: usize,
    pub comment_cap: usize,
}

