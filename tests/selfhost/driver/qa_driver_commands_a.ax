4u8, 32u8, 98u8, 97u8, 100u8, 32u8, 92u8, 120u8, 109u8, 97u8, 108u8, 102u8, 111u8, 114u8, 109u8, 101u8, 100u8, 32u8, 111u8, 114u8, 32u8, 110u8, 111u8, 110u8, 45u8, 115u8, 99u8, 97u8, 108u8, 97u8, 114u8, 32u8, 92u8, 117u8, 123u8, 46u8, 46u8, 46u8, 125u8, 110u8, 111u8, 110u8, 45u8, 65u8, 83u8, 67u8, 73u8, 73u8, 32u8, 99u8, 104u8, 97u8, 114u8, 97u8, 99u8, 116u8, 101u8, 114u8, 32u8, 105u8, 110u8, 32u8, 97u8, 32u8, 98u8, 121u8, 116u8, 101u8, 32u8, 108u8, 105u8, 116u8, 101u8, 114u8, 97u8, 108u8, 98u8, 97u8, 115u8, 101u8, 32u8, 112u8, 114u8, 101u8, 102u8, 105u8, 120u8, 32u8, 119u8, 105u8, 116u8, 104u8, 111u8, 117u8, 116u8, 32u8, 100u8, 105u8, 103u8, 105u8, 116u8, 115u8, 117u8, 112u8, 112u8, 101u8, 114u8, 45u8, 99u8, 97u8, 115u8, 101u8, 32u8, 98u8, 97u8, 115u8, 101u8, 32u8, 112u8, 114u8, 101u8, 102u8, 105u8, 120u8, 100u8, 105u8, 103u8, 105u8, 116u8, 32u8, 110u8, 111u8, 116u8, 32u8, 118u8, 97u8, 108u8, 105u8, 100u8, 32u8, 102u8, 111u8, 114u8, 32u8, 116u8, 104u8, 101u8, 32u8, 98u8, 97u8, 115u8, 101u8, 109u8, 105u8, 115u8, 112u8, 108u8, 97u8, 99u8, 101u8, 100u8, 32u8, 95u8, 32u8, 105u8, 110u8, 32u8, 97u8, 32u8, 110u8, 117u8, 109u8, 98u8, 101u8, 114u8, 117u8, 110u8, 107u8, 110u8, 111u8, 119u8, 110u8, 32u8, 111u8, 114u8, 32u8, 109u8, 105u8, 115u8, 109u8, 97u8, 116u8, 99u8, 104u8, 101u8, 100u8, 32u8, 108u8, 105u8, 116u8, 101u8, 114u8, 97u8, 108u8, 32u8, 115u8, 117u8, 102u8, 102u8, 105u8, 120u8, 105u8, 110u8, 116u8, 101u8, 103u8, 101u8, 114u8, 32u8, 108u8, 105u8, 116u8, 101u8, 114u8, 97u8, 108u8, 32u8, 97u8, 98u8, 111u8, 118u8, 101u8, 32u8, 50u8, 94u8, 49u8, 50u8, 56u8, 32u8, 45u8, 32u8, 49u8, 116u8, 104u8, 114u8, 101u8, 101u8, 32u8, 111u8, 114u8, 32u8, 109u8, 111u8, 114u8, 101u8, 32u8, 100u8, 111u8, 116u8, 115u8, 58u8, 58u8, 32u8, 105u8, 115u8, 32u8, 110u8, 111u8, 116u8, 32u8, 97u8, 32u8, 116u8, 111u8, 107u8, 101u8, 110u8, 59u8, 32u8, 112u8, 97u8, 116u8, 104u8, 115u8, 32u8, 117u8, 115u8, 101u8, 32u8, 46u8, 58u8, 61u8, 32u8, 105u8, 115u8, 32u8, 110u8, 111u8, 116u8, 32u8, 97u8, 32u8, 116u8, 111u8, 107u8, 101u8, 110u8, 59u8, 32u8, 98u8, 105u8, 110u8, 100u8, 32u8, 119u8, 105u8, 116u8, 104u8, 32u8, 61u8, 46u8, 61u8, 48u8, 120u8, 48u8, 111u8, 48u8, 98u8, 76u8, 105u8, 110u8, 101u8, 67u8, 111u8, 109u8, 109u8, 101u8, 110u8, 116u8, 68u8, 111u8, 99u8, 67u8, 111u8, 109u8, 109u8, 101u8, 110u8, 116u8, 66u8, 108u8, 111u8, 99u8, 107u8, 67u8, 111u8, 109u8, 109u8, 101u8, 110u8, 116u8, 32u8, 78u8, 76u8, 32u8, 69u8, 82u8, 82u8, 79u8, 82u8, 32u8, 82u8, 65u8, 87u8, 32u8, 66u8, 89u8, 84u8, 69u8, 95u8, 70u8, 79u8, 82u8, 77u8];
pub const LEX_MSG_OFF: [32]u16 = [0u16, 27u16, 62u16, 111u16, 144u16, 185u16, 236u16, 278u16, 302u16, 333u16, 370u16, 396u16, 418u16, 446u16, 469u16, 505u16, 536u16, 554u16, 584u16, 614u16, 615u16, 616u16, 618u16, 620u16, 622u16, 633u16, 643u16, 655u16, 658u16, 664u16, 668u16, 678u16];

pub fn diag_buf_push_tok_name(b: mut_view<DiagBuffer>, kind: u8) {
    let idx = kind as usize;
    if idx >= 97 {
        diag_buf_push_byte(b, 63u8);
        return;
    }
    let start = TOK_NAMES_OFF[idx] as usize;
    let end = TOK_NAMES_OFF[idx + 1] as usize;
    let mut i = start;
    while i < end {
        diag_buf_push_byte(mut_view(*b), TOK_NAMES_DATA[i]);
        i = i + 1;
    }
}

pub fn diag_buf_push_suf_name(b: mut_view<DiagBuffer>, suf: u8) {
    let idx = suf as usize;
    if idx >= 15 {
        diag_buf_push_byte(b, 63u8);
        return;
    }
    let start = SUF_NAMES_OFF[idx] as usize;
    let end = SUF_NAMES_OFF[idx + 1] as usize;
    let mut i = start;
    while i < end {
        diag_buf_push_byte(mut_view(*b), SUF_NAMES_DATA[i]);
        i = i + 1;
    }
}

pub fn diag_buf_push_lex_msg(b: mut_view<DiagBuffer>, msg_idx: usize) {
    let start = LEX_MSG_OFF[msg_idx] as usize;
    let end = LEX_MSG_OFF[msg_idx + 1] as usize;
    let mut i = start;
    while i < end {
        diag_buf_push_byte(mut_view(*b), LEX_MSG_DATA[i]);
        i = i + 1;
    }
}

pub fn diag_buf_push_u64(b: mut_view<DiagBuffer>, val: u64) {
    if val == 0u64 {
        diag_buf_push_byte(b, 48u8);
        return;
    }
    let mut digits: [20]u8 = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    let mut count: usize = 0;
    let mut v = val;
    while v > 0u64 {
        let q = (v >> 1u32) / 5u64;
        let rem = (v - q * 10u64) as u8;
        digits[count] = 48u8 + rem;
        v = q;
        count = count + 1;
    }
    let mut i = count;
    while i > 0 {
        i = i - 1;
        diag_buf_push_byte(mut_view(*b), digits[i]);
    }
}

pub fn diag_buf_push_u128(b: mut_view<DiagBuffer>, lo: u64, hi: u64) {
    if hi == 0u64 {
        diag_buf_push_u64(b, lo);
        return;
    }
    let mut digits: [40]u8 = [
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8
    ];
    let mut count: usize = 0;
    let mut cur_lo = lo;
    let mut cur_hi = hi;
    while cur_lo != 0u64 || cur_hi != 0u64 {
        let mut q_lo: u64 = 0u64;
        let mut q_hi: u64 = 0u64;
        let mut rem: u64 = 0u64;
        let mut bit: u32 = 128u32;
        while bit > 0u32 {
            bit = bit - 1u32;
            let b_val: u64 = if bit >= 64u32 {
                (cur_hi >> (bit - 64u32)) & 1u64
            } else {
                (cur_lo >> bit) & 1u64
            };
            rem = (rem << 1u32) | b_val;
            if rem >= 10u64 {
                rem = rem - 10u64;
                if bit >= 64u32 {
                    q_hi = q_hi | (1u64 << (bit - 64u32));
                } else {
                    q_lo = q_lo | (1u64 << bit);
                }
            }
        }
        digits[count] = 48u8 + (rem as u8);
        cur_lo = q_lo;
        cur_hi = q_hi;
        count = count + 1;
    }
    let mut i = count;
    while i > 0 {
        i = i - 1;
        diag_buf_push_byte(mut_view(*b), digits[i]);
    }
}

fn hex_nibble(v: u8) -> u8 {
    if v < 10u8 { 48u8 + v } else { 97u8 + (v - 10u8) }
}

pub unsafe fn lex_token_ptr(tokens: *mut Token, idx: usize) -> *mut Token {
    ((tokens as usize) + (((idx as isize) * (size_of<Token>() as isize)) as usize)) as *mut Token
}

pub unsafe fn lex_comment_ptr(comments: *mut Comment, idx: usize) -> *mut Comment {
    ((comments as usize) + (((idx as isize) * (size_of<Comment>() as isize)) as usize)) as *mut Comment
}

pub fn ax_lex_render_tokens(res: view<LexResult>, interner: view<StrInterner>, out: mut_view<DiagBuffer>) {
    let mut i: usize = 0;
    while i < res.token_count {
        let tok = unsafe { *(lex_token_ptr(res.tokens, i)) };
        diag_buf_push_tok_name(mut_view(*out), tok.kind);
        diag_buf_push_byte(mut_view(*out), 32u8);
        diag_buf_push_byte(mut_view(*out), 91u8);
        diag_buf_push_u32(mut_view(*out), tok.span.start);
        diag_buf_push_byte(mut_view(*out), 46u8);
        diag_buf_push_byte(mut_view(*out), 46u8);
        diag_buf_push_u32(mut_view(*out), tok.span.end);
        diag_buf_push_byte(mut_view(*out), 93u8);
        if (tok.flags & TOK_FLAG_NL_BEFORE) != 0u16 { diag_buf_push_lex_msg(mut_view(*out), 27); }
        if (tok.flags & TOK_FLAG_ERROR) != 0u16 { diag_buf_push_lex_msg(mut_view(*out), 28); }
        if (tok.flags & TOK_FLAG_RAW) != 0u16 { diag_buf_push_lex_msg(mut_view(*out), 29); }
        if (tok.flags & TOK_FLAG_BYTE_FORM) != 0u16 { diag_buf_push_lex_msg(mut_view(*out), 30); }
        if tok.kind == TOK_INT {
            diag_buf_push_byte(mut_view(*out), 32u8);
            diag_buf_push_u128(mut_view(*out), tok.int_val, token_int_hi(view(tok)));
            if tok.suffix != SUFFIX_NONE {
                diag_buf_push_byte(mut_view(*out), 32u8);
                diag_buf_push_suf_name(mut_view(*out), tok.suffix);
            }
        } else if tok.kind == TOK_FLOAT {
            diag_buf_push_byte(mut_view(*out), 32u8);
            diag_buf_push_suf_name(mut_view(*out), tok.suffix);
        } else if tok.kind == TOK_IDENT || tok.kind == TOK_LABEL {
            let name = interner_get(interner, tok.ident_val);
            diag_buf_push_byte(mut_view(*out), 32u8);
            let mut k: usize = 0;
            while k < name.len {
                let b_ch = unsafe { *(name.ptr + k) };
                diag_buf_push_byte(mut_view(*out), b_ch);
                k = k + 1;
            }
        } else if tok.kind == TOK_CHAR {
            diag_buf_push_byte(mut_view(*out), 32u8);
            diag_buf_push_u32(mut_view(*out), tok.char_val);
        } else if tok.kind == TOK_STR || tok.kind == TOK_BYTE_STR {
            diag_buf_push_byte(mut_view(*out), 32u8);
            let mut k: usize = 0;
            while k < tok.str_len {
                let b_ch = unsafe { *(tok.str_ptr + k) };
                diag_buf_push_byte(mut_view(*out), hex_nibble(b_ch / 16u8));
                diag_buf_push_byte(mut_view(*out), hex_nibble(b_ch % 16u8));
                k = k + 1;
            }
        }
        diag_buf_push_byte(mut_view(*out), 10u8);
        i = i + 1;
    }
    let mut j: usize = 0;
    while j < res.comment_count {
        let c = unsafe { *(lex_comment_ptr(res.comments, j)) };
        let msg_idx: usize = if c.kind == COMMENT_DOC { 25 } else if c.kind == COMMENT_BLOCK { 26 } else { 24 };
        diag_buf_push_lex_msg(mut_view(*out), msg_idx);
        diag_buf_push_byte(mut_view(*out), 32u8);
        diag_buf_push_byte(mut_view(*out), 91u8);
        diag_buf_push_u32(mut_view(*out), c.span.start);
        diag_buf_push_byte(mut_view(*out), 46u8);
        diag_buf_push_byte(mut_view(*out), 46u8);
        diag_buf_push_u32(mut_view(*out), c.span.end);
        diag_buf_push_byte(mut_view(*out), 93u8);
        diag_buf_push_byte(mut_view(*out), 10u8);
        j = j + 1;
    }
}

