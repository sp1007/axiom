pub fn mir_mul_usize(a: usize, b: usize) -> usize {
    ((a as isize) * (b as isize)) as usize
}

pub fn mir_mul_u64(a: u64, b: u64) -> u64 {
    ((a as i64) * (b as i64)) as u64
}

