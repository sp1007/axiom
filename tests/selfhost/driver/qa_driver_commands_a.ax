@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic unsafe fn ptr_write_bytes<T>(dst: *mut T, val: u8, count: usize) {}

pub const INTERP_SYNTH_BASE_RUNTIME: u64 = 0x4000000000000000u64;
pub const INTERP_SYNTH_BASE_COMPTIME: u64 = 0x5000000000000000u64;

pub const INTERP_MSG_UB_NULL_DEREF: u8 = 1u8;
pub const INTERP_MSG_UB_MISALIGNED: u8 = 2u8;
pub const INTERP_MSG_UB_UNMAPPED: u8 = 3u8;
pub const INTERP_MSG_UB_DANGLING: u8 = 4u8;
pub const INTERP_MSG_UB_USE_AFTER_FREE: u8 = 4u8;
pub const INTERP_MSG_UB_OOB: u8 = 5u8;
pub const INTERP_MSG_UB_OUT_OF_BOUNDS: u8 = 5u8;
pub const INTERP_MSG_UB_PTR_ARITH_UNMAPPED: u8 = 6u8;
pub const INTERP_MSG_UB_PTR_ARITH_OUTSIDE: u8 = 6u8;
pub const INTERP_MSG_UB_PTR_ARITH_OOB: u8 = 7u8;
pub const INTERP_MSG_UB_FREE_NON_HEAP: u8 = 8u8;
pub const INTERP_MSG_UB_USIZE_AS_PTR: u8 = 9u8;
pub const INTERP_MSG_UB_OVERLAPPING_COPY: u8 = 10u8;
pub const INTERP_MSG_UB_OVERLAP: u8 = 10u8;

pub const INTERP_MSG_PANIC_SUBSLICE_NON_ARR: u8 = 20u8;
pub const INTERP_MSG_PANIC_SUBSLICE_OOB: u8 = 21u8;
pub const INTERP_MSG_PANIC_INDEX_NON_ARR: u8 = 22u8;
pub const INTERP_MSG_PANIC_INDEX_OOB: u8 = 23u8;
pub const INTERP_MSG_PANIC_ASSERT_FAILED: u8 = 24u8;
pub const INTERP_MSG_PANIC_ASSERT: u8 = 24u8;
pub const INTERP_MSG_PANIC_UNREACHABLE: u8 = 25u8;
pub const INTERP_MSG_PANIC_PANIC: u8 = 26u8;
pub const INTERP_MSG_PANIC_COMPTIME_CALL: u8 = 27u8;
pub const INTERP_MSG_PANIC_DIV_ZERO: u8 = 28u8;
pub const INTERP_MSG_PANIC_SHIFT_RANGE: u8 = 29u8;
pub const INTERP_MSG_PANIC_ARITH_OV: u8 = 30u8;
pub const INTERP_MSG_PANIC_UNRESOLVED_CALL: u8 = 31u8;
pub const INTERP_MSG_PANIC_UNSUPPORTED_TERM: u8 = 32u8;

pub const INTERP_MSG_LIMIT_COMPTIME_STEP: u8 = 40u8;
pub const INTERP_MSG_LIMIT_STEP: u8 = 41u8;
pub const INTERP_MSG_LIMIT_STACK: u8 = 42u8;
pub const INTERP_MSG_FFI_NOT_IN_ORACLE: u8 = 43u8;

// Concatenated message bytes indexed by offset/length table below.
const INTERP_MSG_BYTES: [769]u8 = [
    // 0..24: "null pointer dereference"
    110u8, 117u8, 108u8, 108u8, 32u8, 112u8, 111u8, 105u8, 110u8, 116u8, 101u8, 114u8,
    32u8, 100u8, 101u8, 114u8, 101u8, 102u8, 101u8, 114u8, 101u8, 110u8, 99u8, 101u8,
    // 24..49: "misaligned pointer access"
    109u8, 105u8, 115u8, 97u8, 108u8, 105u8, 103u8, 110u8, 101u8, 100u8, 32u8, 112u8,
