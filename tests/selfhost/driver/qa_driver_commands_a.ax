        let sv = interner_get(unsafe { view(*ctx.interner) }, unsafe { (*seg).name });
        let is_i128 = sv_eq_cstr4(sv, 105u8, 49u8, 50u8, 56u8);
        let is_u128 = sv_eq_cstr4(sv, 117u8, 49u8, 50u8, 56u8);
        if is_i128 || is_u128 {
            dst.symbol.v = if is_i128 { 0x3FFF0128u32 } else { 0x3FFF0129u32 };
            suppress_unresolved_at_span(mut_view(*sink), unsafe { (*seg).span });
        }
    }
    let _t1 = lower_generic_args(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), unsafe { (*last).generic_args });
    dst.generic_args = _t1;
}

fn lower_generic_args(ctx: mut_view<LowerCtx>, arena: mut_view<Arena>, rmap: view<ResolveMap>, sink: mut_view<DiagSink>, g: *mut AstGenericArgs) -> *mut HirGenericArgs {
