pub struct PtrItemMap {
    pub keys: *mut usize,
    pub vals: *mut *const HirItem,
    pub states: *mut u8,
    pub len: usize,
    pub cap: usize,
}

pub struct SymTypeMap {
    pub keys: *mut u32,
    pub vals: *mut TypeId,
    pub states: *mut u8,
    pub len: usize,
    pub cap: usize,
}

pub struct SymConstMap {
    pub keys: *mut u32,
    pub vals: *mut ConstValue,
    pub states: *mut u8,
    pub len: usize,
    pub cap: usize,
}

pub struct PtrSubstMap {
    pub keys: *mut usize,
    pub vals: *mut GenericArgsSlice,
    pub states: *mut u8,
    pub len: usize,
    pub cap: usize,
}

pub struct PtrTryMap {
    pub keys: *mut usize,
    pub vals: *mut TryExprInfo,
    pub states: *mut u8,
    pub len: usize,
    pub cap: usize,
}

pub struct Thir {
    pub interner: TypeInterner,
    pub expr_types: PtrTypeMap,
    pub pat_types: PtrTypeMap,
    pub expr_variants: PtrU32Map,
    pub pat_variants: PtrU32Map,
    pub expr_methods: PtrItemMap,
    pub item_types: PtrTypeMap,
    pub param_types: PtrTypeMap,
    pub symbol_types: SymTypeMap,
    pub symbol_consts: SymConstMap,
    pub expr_substs: PtrSubstMap,
    pub pat_substs: PtrSubstMap,
    pub expr_try_info: PtrTryMap,
}

fn types_zero_bytes(ptr: *mut u8, n: usize) {
    let mut i: usize = 0;
    while (i < n) {
        unsafe {
            *(ptr + i) = 0u8;
        }
        i = i + 1;
    }
}

fn hash_u64(v: u64) -> u64 {
    let mut h: u64 = v ^ (v >> 16u64);
    h = h ^ (h << 7u64);
    h ^ (h >> 11u64)
}

fn hash_u32(v: u32) -> u64 {
    hash_u64((v as u64) ^ 0x9e3779b9u64)
}

fn hash_combine(a: u64, b: u64) -> u64 {
    let h: u64 = a ^ b ^ 0x9e3779b9u64 ^ (a << 6u64) ^ (a >> 2u64);
    h ^ (h >> 13u64)
}

pub fn mul_usize(a: usize, b: usize) -> usize {
    ((a as isize) * (b as isize)) as usize
}

pub unsafe fn typeid_at(base: *mut TypeId, idx: usize) -> *mut TypeId {
    let off = ((idx as isize) * (size_of<TypeId>() as isize)) as usize;
    ((base as usize) + off) as *mut TypeId
}

pub unsafe fn typeid_ptr_at(base: *mut *mut TypeId, idx: usize) -> *mut *mut TypeId {
    let off = ((idx as isize) * (size_of<*mut TypeId>() as isize)) as usize;
    ((base as usize) + off) as *mut *mut TypeId
}

pub unsafe fn usize_at(base: *mut usize, idx: usize) -> *mut usize {
    let off = ((idx as isize) * (size_of<usize>() as isize)) as usize;
    ((base as usize) + off) as *mut usize
}

pub unsafe fn u32_at(base: *mut u32, idx: usize) -> *mut u32 {
    let off = ((idx as isize) * (size_of<u32>() as isize)) as usize;
    ((base as usize) + off) as *mut u32
}

pub unsafe fn capture_at(base: *mut ClosureCapture, idx: usize) -> *mut ClosureCapture {
    let off = ((idx as isize) * (size_of<ClosureCapture>() as isize)) as usize;
    ((base as usize) + off) as *mut ClosureCapture
}

unsafe fn axtype_at(base: *mut AxType, idx: usize) -> *mut AxType {
    let off = ((idx as isize) * (size_of<AxType>() as isize)) as usize;
    ((base as usize) + off) as *mut AxType
}

unsafe fn axtype_ptr_at(base: *mut *mut AxType, idx: usize) -> *mut *mut AxType {
    let off = ((idx as isize) * (size_of<*mut AxType>() as isize)) as usize;
    ((base as usize) + off) as *mut *mut AxType
}

unsafe fn item_ptr_at(base: *mut *const HirItem, idx: usize) -> *mut *const HirItem {
    let off = ((idx as isize) * (size_of<*const HirItem>() as isize)) as usize;
    ((base as usize) + off) as *mut *const HirItem
}

unsafe fn constval_at(base: *mut ConstValue, idx: usize) -> *mut ConstValue {
    let off = ((idx as isize) * (size_of<ConstValue>() as isize)) as usize;
    ((base as usize) + off) as *mut ConstValue
}

unsafe fn subst_at(base: *mut GenericArgsSlice, idx: usize) -> *mut GenericArgsSlice {
    let off = ((idx as isize) * (size_of<GenericArgsSlice>() as isize)) as usize;
    ((base as usize) + off) as *mut GenericArgsSlice
}

unsafe fn tryinfo_at(base: *mut TryExprInfo, idx: usize) -> *mut TryExprInfo {
    let off = ((idx as isize) * (size_of<TryExprInfo>() as isize)) as usize;
    ((base as usize) + off) as *mut TryExprInfo
}

pub fn ax_type_reset(t: mut_view<AxType>, kind: u8) {
    t.kind = kind;
    t.is_unsafe = false;
    t.is_mut = false;
    t.is_repr_c = false;
    t.abi.v = 0u32;
    t.name.v = 0u32;
    t.param_index = 0u32;
    t.var_id = 0u32;
    t.closure_id = 0u32;
    t.fn_sym = 0u32;
    t.pointee.v = 0u32;
    t.elem.v = 0u32;
    t.ret_type.v = 0u32;
    t.fn_type.v = 0u32;
    t.array_len = 0u64;
    t.param_types = 0 as *mut TypeId;
    t.param_count = 0;
    t.fields = 0 as *mut TypeId;
    t.field_count = 0;
    t.def = 0 as *const HirItem;
    t.args = 0 as *mut TypeId;
    t.arg_count = 0;
    t.variant_fields = 0 as *mut *mut TypeId;
    t.variant_field_counts = 0 as *mut usize;
    t.variant_count = 0;
    t.captures = 0 as *mut ClosureCapture;
    t.capture_count = 0;
}

pub fn copy_ax_type_into(dst: mut_view<AxType>, src: view<AxType>) {
    dst.kind = src.kind;
    dst.is_unsafe = src.is_unsafe;
    dst.is_mut = src.is_mut;
    dst.is_repr_c = src.is_repr_c;
    dst.abi.v = src.abi.v;
    dst.name.v = src.name.v;
    dst.param_index = src.param_index;
    dst.var_id = src.var_id;
    dst.closure_id = src.closure_id;
    dst.fn_sym = src.fn_sym;
    dst.pointee.v = src.pointee.v;
    dst.elem.v = src.elem.v;
    dst.ret_type.v = src.ret_type.v;
    dst.fn_type.v = src.fn_type.v;
    dst.array_len = src.array_len;
    dst.param_types = src.param_types;
    dst.param_count = src.param_count;
    dst.fields = src.fields;
    dst.field_count = src.field_count;
    dst.def = src.def;
    dst.args = src.args;
    dst.arg_count = src.arg_count;
    dst.variant_fields = src.variant_fields;
    dst.variant_field_counts = src.variant_field_counts;
    dst.variant_count = src.variant_count;
    dst.captures = src.captures;
    dst.capture_count = src.capture_count;
}

pub fn copy_const_value_into(dst: mut_view<ConstValue>, src: view<ConstValue>) {
    dst.kind = src.kind;
    dst.ty.v = src.ty.v;
    dst.int_val = src.int_val;
    dst.str_bytes = src.str_bytes;
    dst.str_len = src.str_len;
    dst.agg_data = src.agg_data;
    dst.agg_size = src.agg_size;
    dst.agg_align = src.agg_align;
    dst.alloc_id = src.alloc_id;
}

pub fn const_val_int_hi(cv: view<ConstValue>) -> u64 {
    cv.str_len as u64
}

pub fn const_val_set_int_hi(cv: mut_view<ConstValue>, hi: u64) {
    cv.str_len = hi as usize;
}

pub fn key_hash_type(k: view<AxType>) -> u64 {
    let mut h: u64 = hash_u32(k.kind as u32);
    if k.kind == TY_FN {
        let u_flag: u32 = if k.is_unsafe { 1u32 } else { 0u32 };
        h = hash_combine(h, hash_u32(u_flag));
        h = hash_combine(h, hash_u32(k.abi.v));
        h = hash_combine(h, hash_u32(k.ret_type.v));
        h = hash_combine(h, hash_u64(k.param_count as u64));
        let mut i: usize = 0;
        while (i < k.param_count) {
            let pv = unsafe { (*typeid_at(k.param_types, i)).v };
            h = hash_combine(h, hash_u32(pv));
            i = i + 1;
        }
    } else if k.kind == TY_INT_VAR || k.kind == TY_VAR {
        h = hash_combine(h, hash_u32(k.var_id));
    } else if k.kind == TY_PARAM {
        h = hash_combine(h, hash_u32(k.param_index));
    } else if k.kind == TY_PTR {
        let m_flag: u32 = if k.is_mut { 1u32 } else { 0u32 };
        h = hash_combine(h, hash_u32(k.pointee.v));
        h = hash_combine(h, hash_u32(m_flag));
    } else if k.kind == TY_VIEW || k.kind == TY_MUT_VIEW {
        h = hash_combine(h, hash_u32(k.pointee.v));
    } else if k.kind == TY_SLICE {
        h = hash_combine(h, hash_u32(k.elem.v));
    } else if k.kind == TY_ARRAY {
        h = hash_combine(h, hash_u32(k.elem.v));
        h = hash_combine(h, hash_u64(k.array_len));
    } else if k.kind == TY_TUPLE {
        h = hash_combine(h, hash_u64(k.field_count as u64));
        let mut i: usize = 0;
        while (i < k.field_count) {
            let fv = unsafe { (*typeid_at(k.fields, i)).v };
            h = hash_combine(h, hash_u32(fv));
            i = i + 1;
        }
    } else if k.kind == TY_STRUCT || k.kind == TY_ENUM {
        h = hash_combine(h, hash_u64((k.def as usize) as u64));
        let mut i: usize = 0;
        while (i < k.arg_count) {
            let av = unsafe { (*typeid_at(k.args, i)).v };
            h = hash_combine(h, hash_u32(av));
            i = i + 1;
        }
    } else if k.kind == TY_CLOSURE {
        h = hash_combine(h, hash_u32(k.closure_id));
    }
    h
}

pub fn key_eq_type(a: view<AxType>, b: view<AxType>) -> bool {
    if a.kind != b.kind {
        return false;
    }
    if a.kind == TY_FN {
        if a.is_unsafe != b.is_unsafe || a.abi.v != b.abi.v {
            return false;
        }
        if a.ret_type.v != b.ret_type.v || a.param_count != b.param_count {
            return false;
        }
        let mut i: usize = 0;
        while (i < a.param_count) {
            let pa = unsafe { (*typeid_at(a.param_types, i)).v };
            let pb = unsafe { (*typeid_at(b.param_types, i)).v };
            if pa != pb {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    if a.kind == TY_INT_VAR || a.kind == TY_VAR {
        return a.var_id == b.var_id;
    }
    if a.kind == TY_PARAM {
        return a.param_index == b.param_index;
    }
    if a.kind == TY_PTR {
        return a.pointee.v == b.pointee.v && a.is_mut == b.is_mut;
    }
    if a.kind == TY_VIEW || a.kind == TY_MUT_VIEW {
        return a.pointee.v == b.pointee.v;
    }
    if a.kind == TY_SLICE {
        return a.elem.v == b.elem.v;
    }
    if a.kind == TY_ARRAY {
        return a.elem.v == b.elem.v && a.array_len == b.array_len;
    }
    if a.kind == TY_TUPLE {
        if a.field_count != b.field_count {
            return false;
        }
        let mut i: usize = 0;
        while (i < a.field_count) {
            let fa = unsafe { (*typeid_at(a.fields, i)).v };
            let fb = unsafe { (*typeid_at(b.fields, i)).v };
            if fa != fb {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    if a.kind == TY_STRUCT || a.kind == TY_ENUM {
        if (a.def as usize) != (b.def as usize) {
            return false;
        }
        if a.arg_count != b.arg_count {
            return false;
        }
        let mut i: usize = 0;
        while (i < a.arg_count) {
            let aa = unsafe { (*typeid_at(a.args, i)).v };
            let ab = unsafe { (*typeid_at(b.args, i)).v };
            if aa != ab {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    if a.kind == TY_CLOSURE {
        return a.closure_id == b.closure_id;
    }
    true
}

pub fn typemap_init(m: mut_view<TypeMap>) {
    m.keys = 0 as *mut *mut AxType;
    m.vals = 0 as *mut TypeId;
    m.states = 0 as *mut u8;
    m.len = 0;
    m.cap = 0;
}

pub fn typemap_free(m: mut_view<TypeMap>) {
    if m.cap > 0 {
        unsafe {
            heap_free(m.keys as *mut u8, mul_usize(m.cap, size_of<*mut AxType>()), align_of<*mut AxType>());
            heap_free(m.vals as *mut u8, mul_usize(m.cap, size_of<TypeId>()), align_of<TypeId>());
            heap_free(m.states, m.cap, 1);
        }
    }
    typemap_init(m);
}

fn typemap_grow(m: mut_view<TypeMap>) {
    let new_cap: usize = if m.cap == 0 { MAP_INIT_CAP } else { mul_usize(m.cap, 2) };
    let new_keys = unsafe {
        heap_alloc(mul_usize(new_cap, size_of<*mut AxType>()), align_of<*mut AxType>()) as *mut *mut AxType
    };
    let new_vals = unsafe {
        heap_alloc(mul_usize(new_cap, size_of<TypeId>()), align_of<TypeId>()) as *mut TypeId
    };
    let new_states = unsafe { heap_alloc(new_cap, 1) };
    types_zero_bytes(new_states, new_cap);

    let old_keys = m.keys;
    let old_vals = m.vals;
    let old_states = m.states;
    let old_cap = m.cap;

    m.keys = new_keys;
    m.vals = new_vals;
    m.states = new_states;
    m.len = 0;
    m.cap = new_cap;

    let mut i: usize = 0;
    while (i < old_cap) {
        let st = unsafe { *(old_states + i) };
        if st == SLOT_OCCUPIED {
            let k = unsafe { *axtype_ptr_at(old_keys, i) };
            let v = unsafe { (*typeid_at(old_vals, i)).v };
            typemap_insert(mut_view(*m), k, TypeId { v: v });
        }
        i = i + 1;
    }

    if old_cap > 0 {
        unsafe {
            heap_free(old_keys as *mut u8, mul_usize(old_cap, size_of<*mut AxType>()), align_of<*mut AxType>());
            heap_free(old_vals as *mut u8, mul_usize(old_cap, size_of<TypeId>()), align_of<TypeId>());
            heap_free(old_states, old_cap, 1);
        }
    }
}

pub fn typemap_insert(m: mut_view<TypeMap>, key: *mut AxType, val: TypeId) {
    if m.cap == 0 || mul_usize(m.len + 1, MAP_LOAD_DEN) >= mul_usize(m.cap, MAP_LOAD_NUM) {
        typemap_grow(mut_view(*m));
    }
    let mask = m.cap - 1;
    let h = unsafe { key_hash_type(view(*key)) };
    let mut idx = (h as usize) & mask;
    loop {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            unsafe {
                *axtype_ptr_at(m.keys, idx) = key;
                (*typeid_at(m.vals, idx)).v = val.v;
                *(m.states + idx) = SLOT_OCCUPIED;
            }
            m.len = m.len + 1;
            return;
        }
        let k = unsafe { *axtype_ptr_at(m.keys, idx) };
        let eq = unsafe { key_eq_type(view(*k), view(*key)) };
        if eq {
            unsafe {
                (*typeid_at(m.vals, idx)).v = val.v;
            }
            return;
        }
        idx = (idx + 1) & mask;
    }
}

pub fn typemap_get(m: view<TypeMap>, key: view<AxType>) -> *mut TypeId {
    if m.cap == 0 {
        return 0 as *mut TypeId;
    }
    let mask = m.cap - 1;
    let h = key_hash_type(key);
    let mut idx = (h as usize) & mask;
    let mut probes: usize = 0;
    while (probes < m.cap) {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            return 0 as *mut TypeId;
        }
        if st == SLOT_OCCUPIED {
            let k = unsafe { *axtype_ptr_at(m.keys, idx) };
            let eq = unsafe { key_eq_type(view(*k), key) };
            if eq {
                return unsafe { typeid_at(m.vals, idx) };
            }
        }
        idx = (idx + 1) & mask;
        probes = probes + 1;
    }
    0 as *mut TypeId
}

fn interner_push_ptr(ti: mut_view<TypeInterner>, ptr: *mut AxType) -> usize {
    if ti.len == ti.cap {
        let new_cap: usize = if ti.cap == 0 { INTERNER_INIT_CAP } else { mul_usize(ti.cap, 2) };
        let new_arr = unsafe {
            heap_alloc(mul_usize(new_cap, size_of<*mut AxType>()), align_of<*mut AxType>()) as *mut *mut AxType
        };
        if ti.len > 0 && (ti.types as usize) != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(
                    ti.types as *const u8,
                    new_arr as *mut u8,
                    mul_usize(ti.len, size_of<*mut AxType>())
                );
                heap_free(
                    ti.types as *mut u8,
                    mul_usize(ti.cap, size_of<*mut AxType>()),
                    align_of<*mut AxType>()
                );
            }
        }
        ti.types = new_arr;
        ti.cap = new_cap;
    }
    let idx = ti.len;
    unsafe {
        *axtype_ptr_at(ti.types, idx) = ptr;
    }
    ti.len = idx + 1;
    idx
}

fn arena_dup_typeids(arena: mut_view<Arena>, src: *mut TypeId, count: usize) -> *mut TypeId {
    if count == 0 || (src as usize) == 0 {
        return 0 as *mut TypeId;
    }
    let bytes = mul_usize(count, size_of<TypeId>());
    let dst = arena_alloc_raw(mut_view(*arena), bytes, align_of<TypeId>()) as *mut TypeId;
    unsafe {
        ptr_copy_nonoverlapping<u8>(src as *const u8, dst as *mut u8, bytes);
    }
    dst
}

pub fn intern_type(ti: mut_view<TypeInterner>, ty: view<AxType>) -> TypeId {
    let existing = typemap_get(view(ti.map), ty);
    if (existing as usize) != 0 {
        let ex_v = unsafe { (*existing).v };
        return TypeId { v: ex_v };
    }
    let new_type = unsafe {
        arena_alloc_raw(mut_view(ti.arena), size_of<AxType>(), align_of<AxType>()) as *mut AxType
    };
    unsafe {
        copy_ax_type_into(mut_view(*new_type), ty);
    }
    if ty.kind == TY_FN && ty.param_count > 0 {
        unsafe {
            let dup_param_types = arena_dup_typeids(mut_view(ti.arena), ty.param_types, ty.param_count);

            (*new_type).param_types = dup_param_types;
        }
    }
    if ty.kind == TY_TUPLE && ty.field_count > 0 {
        unsafe {
            let dup_fields = arena_dup_typeids(mut_view(ti.arena), ty.fields, ty.field_count);

            (*new_type).fields = dup_fields;
        }
    }
    if ty.kind == TY_STRUCT {
        if ty.field_count > 0 {
            unsafe {
                let dup_fields = arena_dup_typeids(mut_view(ti.arena), ty.fields, ty.field_count);

                (*new_type).fields = dup_fields;
            }
        }
        if ty.arg_count > 0 {
            unsafe {
                let dup_args = arena_dup_typeids(mut_view(ti.arena), ty.args, ty.arg_count);

                (*new_type).args = dup_args;
            }
        }
    }
    if ty.kind == TY_ENUM {
        if ty.arg_count > 0 {
            unsafe {
                let dup_args = arena_dup_typeids(mut_view(ti.arena), ty.args, ty.arg_count);

                (*new_type).args = dup_args;
            }
        }
        if (ty.variant_field_counts as usize) != 0 && ty.variant_count > 0 {
            let counts_bytes = mul_usize(ty.variant_count, size_of<usize>());
            let new_counts = unsafe {
                arena_alloc_raw(mut_view(ti.arena), counts_bytes, align_of<usize>()) as *mut usize
            };
            unsafe {
                ptr_copy_nonoverlapping<u8>(
                    ty.variant_field_counts as *const u8,
                    new_counts as *mut u8,
                    counts_bytes
                );
                (*new_type).variant_field_counts = new_counts;
            }
        }
        if (ty.variant_fields as usize) != 0 && ty.variant_count > 0 {
            let vbytes = mul_usize(ty.variant_count, size_of<*mut TypeId>());
            let new_vfields = unsafe {
                arena_alloc_raw(mut_view(ti.arena), vbytes, align_of<*mut TypeId>()) as *mut *mut TypeId
            };
            let mut v: usize = 0;
            while (v < ty.variant_count) {
                let fc = unsafe { *usize_at(ty.variant_field_counts, v) };
                if fc > 0 {
                    let src_vf = unsafe { *typeid_ptr_at(ty.variant_fields, v) };
                    let dst_vf = arena_dup_typeids(mut_view(ti.arena), src_vf, fc);
                    unsafe {
                        *typeid_ptr_at(new_vfields, v) = dst_vf;
                    }
                } else {
                    unsafe {
                        *typeid_ptr_at(new_vfields, v) = 0 as *mut TypeId;
                    }
                }
                v = v + 1;
            }
            unsafe {
                (*new_type).variant_fields = new_vfields;
            }
        }
    }
    if ty.kind == TY_CLOSURE {
        if ty.param_count > 0 {
            unsafe {
                let dup_param_types = arena_dup_typeids(mut_view(ti.arena), ty.param_types, ty.param_count);

                (*new_type).param_types = dup_param_types;
            }
        }
        if ty.capture_count > 0 && (ty.captures as usize) != 0 {
            let cbytes = mul_usize(ty.capture_count, size_of<ClosureCapture>());
            let new_caps = unsafe {
                arena_alloc_raw(
                    mut_view(ti.arena),
                    cbytes,
                    align_of<ClosureCapture>()
                ) as *mut ClosureCapture
            };
            unsafe {
                ptr_copy_nonoverlapping<u8>(ty.captures as *const u8, new_caps as *mut u8, cbytes);
                (*new_type).captures = new_caps;
            }
        }
    }
    let idx = interner_push_ptr(mut_view(*ti), new_type);
    let id_v = (idx + 1) as u32;
    typemap_insert(mut_view(ti.map), new_type, TypeId { v: id_v });
    TypeId { v: id_v }
}

pub fn intern_singleton(ti: mut_view<TypeInterner>, kind: u8) -> TypeId {
    if kind == TY_I128 {
        if ti.t_i128.v != 0u32 {
            return TypeId { v: ti.t_i128.v };
        }
        return TypeId { v: 0x3FFF0128u32 };
    }
    if kind == TY_U128 {
        if ti.t_u128.v != 0u32 {
            return TypeId { v: ti.t_u128.v };
        }
        return TypeId { v: 0x3FFF0129u32 };
    }
    let sp = ti.scratch;
    unsafe {
        ax_type_reset(mut_view(*sp), kind);
    }
    intern_type(mut_view(*ti), unsafe { view(*sp) })
}

pub fn intern_ptr_ty(ti: mut_view<TypeInterner>, pointee: TypeId, is_mut: bool) -> TypeId {
    let sp = ti.scratch;
    unsafe {
        ax_type_reset(mut_view(*sp), TY_PTR);
        (*sp).pointee.v = pointee.v;
        (*sp).is_mut = is_mut;
    }
    intern_type(mut_view(*ti), unsafe { view(*sp) })
}

pub fn intern_view_ty(ti: mut_view<TypeInterner>, pointee: TypeId, is_mut: bool) -> TypeId {
    let k: u8 = if is_mut { TY_MUT_VIEW } else { TY_VIEW };
    let sp = ti.scratch;
    unsafe {
        ax_type_reset(mut_view(*sp), k);
        (*sp).pointee.v = pointee.v;
    }
    intern_type(mut_view(*ti), unsafe { view(*sp) })
}

pub fn intern_slice_ty(ti: mut_view<TypeInterner>, elem: TypeId) -> TypeId {
    let sp = ti.scratch;
    unsafe {
        ax_type_reset(mut_view(*sp), TY_SLICE);
        (*sp).elem.v = elem.v;
    }
    intern_type(mut_view(*ti), unsafe { view(*sp) })
}

pub fn intern_array_ty(ti: mut_view<TypeInterner>, elem: TypeId, arr_len: u64) -> TypeId {
    let sp = ti.scratch;
    unsafe {
        ax_type_reset(mut_view(*sp), TY_ARRAY);
        (*sp).elem.v = elem.v;
        (*sp).array_len = arr_len;
    }
    intern_type(mut_view(*ti), unsafe { view(*sp) })
}

pub fn intern_tuple_ty(ti: mut_view<TypeInterner>, fields: *mut TypeId, count: usize) -> TypeId {
    let sp = ti.scratch;
    unsafe {
        ax_type_reset(mut_view(*sp), TY_TUPLE);
        (*sp).fields = fields;
        (*sp).field_count = count;
    }
    intern_type(mut_view(*ti), unsafe { view(*sp) })
}

pub fn intern_fn_ty(
    ti: mut_view<TypeInterner>,
    is_unsafe: bool,
    abi: StrId,
    param_types: *mut TypeId,
    param_count: usize,
    ret_type: TypeId
) -> TypeId {
    let sp = ti.scratch;
    unsafe {
        ax_type_reset(mut_view(*sp), TY_FN);
        (*sp).is_unsafe = is_unsafe;
        (*sp).abi.v = abi.v;
        (*sp).param_types = param_types;
        (*sp).param_count = param_count;
        (*sp).ret_type.v = ret_type.v;
    }
    intern_type(mut_view(*ti), unsafe { view(*sp) })
}

pub fn intern_param_ty(ti: mut_view<TypeInterner>, name: StrId, index: u32) -> TypeId {
    let sp = ti.scratch;
    unsafe {
        ax_type_reset(mut_view(*sp), TY_PARAM);
        (*sp).name.v = name.v;
        (*sp).param_index = index;
    }
    intern_type(mut_view(*ti), unsafe { view(*sp) })
}

pub fn intern_var_ty(ti: mut_view<TypeInterner>, kind: u8, var_id: u32) -> TypeId {
    let sp = ti.scratch;
    unsafe {
        ax_type_reset(mut_view(*sp), kind);
        (*sp).var_id = var_id;
    }
    intern_type(mut_view(*ti), unsafe { view(*sp) })
}

pub fn type_interner_init(ti: mut_view<TypeInterner>) {
    ti.arena.head = 0 as *mut ArenaChunk;
    typemap_init(mut_view(ti.map));
    ti.types = 0 as *mut *mut AxType;
    ti.len = 0;
    ti.cap = 0;
    ti.next_int_var = 1u32;
    let scratch_ptr = arena_alloc_raw(mut_view(ti.arena), mul_usize(3, size_of<AxType>()), align_of<AxType>()) as *mut AxType;

    ti.scratch = scratch_ptr;

    let id_t_error = intern_singleton(mut_view(*ti), TY_ERROR);


    ti.t_error.v = id_t_error.v;
    let id_t_unit = intern_singleton(mut_view(*ti), TY_UNIT);

    ti.t_unit.v = id_t_unit.v;
    let id_t_never = intern_singleton(mut_view(*ti), TY_NEVER);

    ti.t_never.v = id_t_never.v;
    let id_t_bool = intern_singleton(mut_view(*ti), TY_BOOL);

    ti.t_bool.v = id_t_bool.v;
    let id_t_char = intern_singleton(mut_view(*ti), TY_CHAR);

    ti.t_char.v = id_t_char.v;
    let id_t_i8 = intern_singleton(mut_view(*ti), TY_I8);

    ti.t_i8.v = id_t_i8.v;
    let id_t_i16 = intern_singleton(mut_view(*ti), TY_I16);

    ti.t_i16.v = id_t_i16.v;
    let id_t_i32 = intern_singleton(mut_view(*ti), TY_I32);

    ti.t_i32.v = id_t_i32.v;
    let id_t_i64 = intern_singleton(mut_view(*ti), TY_I64);

    ti.t_i64.v = id_t_i64.v;
    let id_t_isize = intern_singleton(mut_view(*ti), TY_ISIZE);

    ti.t_isize.v = id_t_isize.v;
    let id_t_u8 = intern_singleton(mut_view(*ti), TY_U8);

    ti.t_u8.v = id_t_u8.v;
    let id_t_u16 = intern_singleton(mut_view(*ti), TY_U16);

    ti.t_u16.v = id_t_u16.v;
    let id_t_u32 = intern_singleton(mut_view(*ti), TY_U32);

    ti.t_u32.v = id_t_u32.v;
    let id_t_u64 = intern_singleton(mut_view(*ti), TY_U64);

    ti.t_u64.v = id_t_u64.v;
    let id_t_usize = intern_singleton(mut_view(*ti), TY_USIZE);

    ti.t_usize.v = id_t_usize.v;
    let id_t_str = intern_singleton(mut_view(*ti), TY_STR);

    ti.t_str.v = id_t_str.v;
    let t_i128_ptr = unsafe { axtype_at(scratch_ptr, 1) };
    let t_u128_ptr = unsafe { axtype_at(scratch_ptr, 2) };
    unsafe {
        ax_type_reset(mut_view(*t_i128_ptr), TY_I128);
        ax_type_reset(mut_view(*t_u128_ptr), TY_U128);
    }
    ti.t_i128.v = 0x3FFF0128u32;
    ti.t_u128.v = 0x3FFF0129u32;
}

pub fn type_interner_free(ti: mut_view<TypeInterner>) {
    if ti.cap > 0 && (ti.types as usize) != 0 {
        unsafe {
            heap_free(
                ti.types as *mut u8,
                mul_usize(ti.cap, size_of<*mut AxType>()),
                align_of<*mut AxType>()
            );
        }
    }
    ti.types = 0 as *mut *mut AxType;
    ti.len = 0;
    ti.cap = 0;
    typemap_free(mut_view(ti.map));
    arena_destroy(mut_view(ti.arena));
}

pub fn type_get(ti: view<TypeInterner>, id: TypeId) -> *mut AxType {
    if id.v == 0 {
        return unsafe { *axtype_ptr_at(ti.types, 0) };
    }
    if id.v == 0x3FFF0128u32 && (ti.scratch as usize) != 0 {
        if ti.t_i128.v == 0x3FFF0128u32 {
            return unsafe { axtype_at(ti.scratch, 1) };
        }
        unsafe {
            ax_type_reset(mut_view(*ti.scratch), TY_I128);
        }
        return ti.scratch;
    }
    if id.v == 0x3FFF0129u32 && (ti.scratch as usize) != 0 {
        if ti.t_u128.v == 0x3FFF0129u32 {
            return unsafe { axtype_at(ti.scratch, 2) };
        }
        unsafe {
            ax_type_reset(mut_view(*ti.scratch), TY_U128);
        }
        return ti.scratch;
    }
    let idx = (id.v - 1) as usize;
    if idx >= ti.len {
        return unsafe { *axtype_ptr_at(ti.types, 0) };
    }
    let p = unsafe { *axtype_ptr_at(ti.types, idx) };
    if id.v >= 10u32 && id.v <= 16u32 && ti.t_isize.v == 10u32 && (p as usize) != 0 {
        let exp_k: u8 = if id.v == 10u32 { TY_ISIZE }
            else if id.v == 11u32 { TY_U8 }
            else if id.v == 12u32 { TY_U16 }
            else if id.v == 13u32 { TY_U32 }
            else if id.v == 14u32 { TY_U64 }
            else if id.v == 15u32 { TY_USIZE }
            else { TY_STR };
        if unsafe { (*p).kind } != exp_k {
            unsafe { (*p).kind = exp_k; }
        }
    }
    p
}

pub fn type_is_int(id: TypeId, ti: view<TypeInterner>) -> bool {
    let t = type_get(ti, id);
    let k = unsafe { (*t).kind };
    (k >= TY_I8 && k <= TY_USIZE) || k == TY_I128 || k == TY_U128
}

pub fn type_is_signed(id: TypeId, ti: view<TypeInterner>) -> bool {
    let t = type_get(ti, id);
    let k = unsafe { (*t).kind };
    (k >= TY_I8 && k <= TY_ISIZE) || k == TY_I128
}

pub fn type_is_unsigned(id: TypeId, ti: view<TypeInterner>) -> bool {
    let t = type_get(ti, id);
    let k = unsafe { (*t).kind };
    (k >= TY_U8 && k <= TY_USIZE) || k == TY_U128
}

fn sv_is_derive(sv: view<StrView>) -> bool {
    if sv.len != 6 {
        return false;
    }
    unsafe {
        *(sv.ptr + 0) == 100u8 && *(sv.ptr + 1) == 101u8 && *(sv.ptr + 2) == 114u8 &&
            *(sv.ptr + 3) == 105u8 && *(sv.ptr + 4) == 118u8 && *(sv.ptr + 5) == 101u8
    }
}

fn sv_is_copy(sv: view<StrView>) -> bool {
    if sv.len != 4 {
        return false;
    }
    unsafe {
        *(sv.ptr + 0) == 67u8 && *(sv.ptr + 1) == 111u8 &&
            *(sv.ptr + 2) == 112u8 && *(sv.ptr + 3) == 121u8
    }
}

pub fn type_is_copy(id: TypeId, thir: view<Thir>, str_in: view<StrInterner>) -> bool {
    if id.v == 0 {
        return false;
    }
    let ty = type_get(view(thir.interner), id);
    if (ty as usize) == 0 {
        return false;
    }
    let k = unsafe { (*ty).kind };
    if k == TY_ERROR || k == TY_STR {
        return false;
    }
    if (k >= TY_UNIT && k <= TY_FN) || k == TY_I128 || k == TY_U128 || k == TY_PTR || k == TY_INT_VAR || k == TY_VIEW {
        return true;
    }
    if k == TY_ARRAY {
        let elem_v = unsafe { (*ty).elem.v };
        let elem_ty = TypeId { v: elem_v };
        return type_is_copy(elem_ty, thir, str_in);
    }
    if k == TY_TUPLE {
        let count = unsafe { (*ty).field_count };
        let fields = unsafe { (*ty).fields };
        let mut i: usize = 0;
        while (i < count) {
            let f_v = unsafe { (*typeid_at(fields, i)).v };
            let f_ty = TypeId { v: f_v };
            if !type_is_copy(f_ty, thir, str_in) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    if k == TY_CLOSURE {
        let count = unsafe { (*ty).capture_count };
        let caps = unsafe { (*ty).captures };
        let mut i: usize = 0;
        while (i < count) {
            let cap = unsafe { capture_at(caps, i) };
            let mode = unsafe { (*cap).mode };
            if mode == CAP_MUT_VIEW || mode == CAP_MOVE {
                return false;
            }
            let cty_v = unsafe { (*cap).ty.v };
            let cty = TypeId { v: cty_v };
            if !type_is_copy(cty, thir, str_in) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    if k == TY_STRUCT || k == TY_ENUM {
        let def = unsafe { (*ty).def };
        if (def as usize) == 0 {
            return false;
        }
        let mut attr: *mut HirAttr = unsafe { (*def).attrs };
        while ((attr as usize) != 0) {
            let aname_v = unsafe { (*attr).name.v };
            if aname_v != 0u32 {
                let sv = interner_get(str_in, StrId { v: aname_v });
                if sv_is_derive(view(sv)) {
                    let mut arg: *mut HirAttrArg = unsafe { (*attr).args };
                    while ((arg as usize) != 0) {
                        let mut arg_name_v = unsafe { (*arg).name.v };
                        if arg_name_v == 0u32 {
                            let aexpr: *mut HirExpr = unsafe { (*arg).expr };
                            if (aexpr as usize) != 0 {
                                let ek = unsafe { (*aexpr).kind };
                                if ek == HIR_EXPR_PATH {
                                    arg_name_v = unsafe { (*aexpr).path.name.v };
                                }
                            }
                        }
                        if arg_name_v != 0u32 {
                            let asv = interner_get(str_in, StrId { v: arg_name_v });
                            if sv_is_copy(view(asv)) {
                                return true;
                            }
                        }
                        arg = unsafe { (*arg).next };
                    }
                }
            }
            attr = unsafe { (*attr).next };
        }
        return false;
    }
    false
}

pub fn ptr_typemap_init(m: mut_view<PtrTypeMap>) {
    m.keys = 0 as *mut usize;
    m.vals = 0 as *mut TypeId;
    m.states = 0 as *mut u8;
    m.len = 0;
    m.cap = 0;
}

pub fn ptr_typemap_free(m: mut_view<PtrTypeMap>) {
    if m.cap > 0 {
        unsafe {
            heap_free(m.keys as *mut u8, mul_usize(m.cap, size_of<usize>()), align_of<usize>());
            heap_free(m.vals as *mut u8, mul_usize(m.cap, size_of<TypeId>()), align_of<TypeId>());
            heap_free(m.states, m.cap, 1);
        }
    }
    ptr_typemap_init(m);
}

fn ptr_typemap_grow(m: mut_view<PtrTypeMap>) {
    let new_cap: usize = if m.cap == 0 { MAP_INIT_CAP } else { mul_usize(m.cap, 2) };
    let new_keys = unsafe { heap_alloc(mul_usize(new_cap, size_of<usize>()), align_of<usize>()) as *mut usize };
    let new_vals = unsafe { heap_alloc(mul_usize(new_cap, size_of<TypeId>()), align_of<TypeId>()) as *mut TypeId };
    let new_states = unsafe { heap_alloc(new_cap, 1) };
    types_zero_bytes(new_states, new_cap);

    let old_keys = m.keys;
    let old_vals = m.vals;
    let old_states = m.states;
    let old_cap = m.cap;

    m.keys = new_keys;
    m.vals = new_vals;
    m.states = new_states;
    m.len = 0;
    m.cap = new_cap;

    let mut i: usize = 0;
    while (i < old_cap) {
        let st = unsafe { *(old_states + i) };
        if st == SLOT_OCCUPIED {
            let k = unsafe { *usize_at(old_keys, i) };
            let v = unsafe { (*typeid_at(old_vals, i)).v };
            ptr_typemap_insert(mut_view(*m), k, TypeId { v: v });
        }
        i = i + 1;
    }

    if old_cap > 0 {
        unsafe {
            heap_free(old_keys as *mut u8, mul_usize(old_cap, size_of<usize>()), align_of<usize>());
            heap_free(old_vals as *mut u8, mul_usize(old_cap, size_of<TypeId>()), align_of<TypeId>());
            heap_free(old_states, old_cap, 1);
        }
    }
}

pub fn ptr_typemap_insert(m: mut_view<PtrTypeMap>, key: usize, val: TypeId) {
    if m.cap == 0 || mul_usize(m.len + 1, MAP_LOAD_DEN) >= mul_usize(m.cap, MAP_LOAD_NUM) {
        ptr_typemap_grow(mut_view(*m));
    }
    let mask = m.cap - 1;
    let mut idx = (hash_u64(key as u64) as usize) & mask;
    loop {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            unsafe {
                *usize_at(m.keys, idx) = key;
                (*typeid_at(m.vals, idx)).v = val.v;
                *(m.states + idx) = SLOT_OCCUPIED;
            }
            m.len = m.len + 1;
            return;
        }
        let k = unsafe { *usize_at(m.keys, idx) };
        if k == key {
            unsafe {
                (*typeid_at(m.vals, idx)).v = val.v;
            }
            return;
        }
        idx = (idx + 1) & mask;
    }
}

pub fn ptr_typemap_get(m: view<PtrTypeMap>, key: usize) -> *mut TypeId {
    if m.cap == 0 {
        return 0 as *mut TypeId;
    }
    let mask = m.cap - 1;
    let mut idx = (hash_u64(key as u64) as usize) & mask;
    let mut probes: usize = 0;
    while (probes < m.cap) {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            return 0 as *mut TypeId;
        }
        if st == SLOT_OCCUPIED {
            let k = unsafe { *usize_at(m.keys, idx) };
            if k == key {
                return unsafe { typeid_at(m.vals, idx) };
            }
        }
        idx = (idx + 1) & mask;
        probes = probes + 1;
    }
    0 as *mut TypeId
}

pub fn ptr_u32map_init(m: mut_view<PtrU32Map>) {
    m.keys = 0 as *mut usize;
    m.vals = 0 as *mut u32;
    m.states = 0 as *mut u8;
    m.len = 0;
    m.cap = 0;
}

pub fn ptr_u32map_free(m: mut_view<PtrU32Map>) {
    if m.cap > 0 {
        unsafe {
            heap_free(m.keys as *mut u8, mul_usize(m.cap, size_of<usize>()), align_of<usize>());
            heap_free(m.vals as *mut u8, mul_usize(m.cap, size_of<u32>()), align_of<u32>());
            heap_free(m.states, m.cap, 1);
        }
    }
    ptr_u32map_init(m);
}

fn ptr_u32map_grow(m: mut_view<PtrU32Map>) {
    let new_cap: usize = if m.cap == 0 { MAP_INIT_CAP } else { mul_usize(m.cap, 2) };
    let new_keys = unsafe { heap_alloc(mul_usize(new_cap, size_of<usize>()), align_of<usize>()) as *mut usize };
    let new_vals = unsafe { heap_alloc(mul_usize(new_cap, size_of<u32>()), align_of<u32>()) as *mut u32 };
    let new_states = unsafe { heap_alloc(new_cap, 1) };
    types_zero_bytes(new_states, new_cap);

    let old_keys = m.keys;
    let old_vals = m.vals;
    let old_states = m.states;
    let old_cap = m.cap;

    m.keys = new_keys;
    m.vals = new_vals;
    m.states = new_states;
    m.len = 0;
    m.cap = new_cap;

    let mut i: usize = 0;
    while (i < old_cap) {
        let st = unsafe { *(old_states + i) };
        if st == SLOT_OCCUPIED {
            let k = unsafe { *usize_at(old_keys, i) };
            let v = unsafe { *u32_at(old_vals, i) };
            ptr_u32map_insert(mut_view(*m), k, v);
        }
        i = i + 1;
    }

    if old_cap > 0 {
        unsafe {
            heap_free(old_keys as *mut u8, mul_usize(old_cap, size_of<usize>()), align_of<usize>());
            heap_free(old_vals as *mut u8, mul_usize(old_cap, size_of<u32>()), align_of<u32>());
            heap_free(old_states, old_cap, 1);
        }
    }
}

pub fn ptr_u32map_insert(m: mut_view<PtrU32Map>, key: usize, val: u32) {
    if m.cap == 0 || mul_usize(m.len + 1, MAP_LOAD_DEN) >= mul_usize(m.cap, MAP_LOAD_NUM) {
        ptr_u32map_grow(mut_view(*m));
    }
    let mask = m.cap - 1;
    let mut idx = (hash_u64(key as u64) as usize) & mask;
    loop {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            unsafe {
                *usize_at(m.keys, idx) = key;
                *u32_at(m.vals, idx) = val;
                *(m.states + idx) = SLOT_OCCUPIED;
            }
            m.len = m.len + 1;
            return;
        }
        let k = unsafe { *usize_at(m.keys, idx) };
        if k == key {
            unsafe {
                *u32_at(m.vals, idx) = val;
            }
            return;
        }
        idx = (idx + 1) & mask;
    }
}

pub fn ptr_u32map_get(m: view<PtrU32Map>, key: usize) -> *mut u32 {
    if m.cap == 0 {
        return 0 as *mut u32;
    }
    let mask = m.cap - 1;
    let mut idx = (hash_u64(key as u64) as usize) & mask;
    let mut probes: usize = 0;
    while (probes < m.cap) {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            return 0 as *mut u32;
        }
        if st == SLOT_OCCUPIED {
            let k = unsafe { *usize_at(m.keys, idx) };
            if k == key {
                return unsafe { u32_at(m.vals, idx) };
            }
        }
        idx = (idx + 1) & mask;
        probes = probes + 1;
    }
    0 as *mut u32
}

pub fn ptr_itemmap_init(m: mut_view<PtrItemMap>) {
    m.keys = 0 as *mut usize;
    m.vals = 0 as *mut *const HirItem;
    m.states = 0 as *mut u8;
    m.len = 0;
    m.cap = 0;
}

pub fn ptr_itemmap_free(m: mut_view<PtrItemMap>) {
    if m.cap > 0 {
        unsafe {
            heap_free(m.keys as *mut u8, mul_usize(m.cap, size_of<usize>()), align_of<usize>());
            heap_free(
                m.vals as *mut u8,
                mul_usize(m.cap, size_of<*const HirItem>()),
                align_of<*const HirItem>()
            );
            heap_free(m.states, m.cap, 1);
        }
    }
    ptr_itemmap_init(m);
}

fn ptr_itemmap_grow(m: mut_view<PtrItemMap>) {
    let new_cap: usize = if m.cap == 0 { MAP_INIT_CAP } else { mul_usize(m.cap, 2) };
    let new_keys = unsafe { heap_alloc(mul_usize(new_cap, size_of<usize>()), align_of<usize>()) as *mut usize };
    let new_vals = unsafe {
        heap_alloc(mul_usize(new_cap, size_of<*const HirItem>()), align_of<*const HirItem>()) as *mut *const HirItem
    };
    let new_states = unsafe { heap_alloc(new_cap, 1) };
    types_zero_bytes(new_states, new_cap);

    let old_keys = m.keys;
    let old_vals = m.vals;
    let old_states = m.states;
    let old_cap = m.cap;

    m.keys = new_keys;
    m.vals = new_vals;
    m.states = new_states;
    m.len = 0;
    m.cap = new_cap;

    let mut i: usize = 0;
    while (i < old_cap) {
        let st = unsafe { *(old_states + i) };
        if st == SLOT_OCCUPIED {
            let k = unsafe { *usize_at(old_keys, i) };
            let v = unsafe { *item_ptr_at(old_vals, i) };
            ptr_itemmap_insert(mut_view(*m), k, v);
        }
        i = i + 1;
    }

    if old_cap > 0 {
        unsafe {
            heap_free(old_keys as *mut u8, mul_usize(old_cap, size_of<usize>()), align_of<usize>());
            heap_free(
                old_vals as *mut u8,
                mul_usize(old_cap, size_of<*const HirItem>()),
                align_of<*const HirItem>()
            );
            heap_free(old_states, old_cap, 1);
        }
    }
}

pub fn ptr_itemmap_insert(m: mut_view<PtrItemMap>, key: usize, val: *const HirItem) {
    if m.cap == 0 || mul_usize(m.len + 1, MAP_LOAD_DEN) >= mul_usize(m.cap, MAP_LOAD_NUM) {
        ptr_itemmap_grow(mut_view(*m));
    }
    let mask = m.cap - 1;
    let mut idx = (hash_u64(key as u64) as usize) & mask;
    loop {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            unsafe {
                *usize_at(m.keys, idx) = key;
                *item_ptr_at(m.vals, idx) = val;
                *(m.states + idx) = SLOT_OCCUPIED;
            }
            m.len = m.len + 1;
            return;
        }
        let k = unsafe { *usize_at(m.keys, idx) };
        if k == key {
            unsafe {
                *item_ptr_at(m.vals, idx) = val;
            }
            return;
        }
        idx = (idx + 1) & mask;
    }
}

pub fn ptr_itemmap_get(m: view<PtrItemMap>, key: usize) -> *mut *const HirItem {
    if m.cap == 0 {
        return 0 as *mut *const HirItem;
    }
    let mask = m.cap - 1;
    let mut idx = (hash_u64(key as u64) as usize) & mask;
    let mut probes: usize = 0;
    while (probes < m.cap) {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            return 0 as *mut *const HirItem;
        }
        if st == SLOT_OCCUPIED {
            let k = unsafe { *usize_at(m.keys, idx) };
            if k == key {
                return unsafe { item_ptr_at(m.vals, idx) };
            }
        }
        idx = (idx + 1) & mask;
        probes = probes + 1;
    }
    0 as *mut *const HirItem
}

pub fn sym_typemap_init(m: mut_view<SymTypeMap>) {
    m.keys = 0 as *mut u32;
    m.vals = 0 as *mut TypeId;
    m.states = 0 as *mut u8;
    m.len = 0;
    m.cap = 0;
}

pub fn sym_typemap_free(m: mut_view<SymTypeMap>) {
    if m.cap > 0 {
        unsafe {
            heap_free(m.keys as *mut u8, mul_usize(m.cap, size_of<u32>()), align_of<u32>());
            heap_free(m.vals as *mut u8, mul_usize(m.cap, size_of<TypeId>()), align_of<TypeId>());
            heap_free(m.states, m.cap, 1);
        }
    }
    sym_typemap_init(m);
}

fn sym_typemap_grow(m: mut_view<SymTypeMap>) {
    let new_cap: usize = if m.cap == 0 { MAP_INIT_CAP } else { mul_usize(m.cap, 2) };
    let new_keys = unsafe { heap_alloc(mul_usize(new_cap, size_of<u32>()), align_of<u32>()) as *mut u32 };
    let new_vals = unsafe { heap_alloc(mul_usize(new_cap, size_of<TypeId>()), align_of<TypeId>()) as *mut TypeId };
    let new_states = unsafe { heap_alloc(new_cap, 1) };
    types_zero_bytes(new_states, new_cap);

    let old_keys = m.keys;
    let old_vals = m.vals;
    let old_states = m.states;
    let old_cap = m.cap;

    m.keys = new_keys;
    m.vals = new_vals;
    m.states = new_states;
    m.len = 0;
    m.cap = new_cap;

    let mut i: usize = 0;
    while (i < old_cap) {
        let st = unsafe { *(old_states + i) };
        if st == SLOT_OCCUPIED {
            let k = unsafe { *u32_at(old_keys, i) };
            let v = unsafe { (*typeid_at(old_vals, i)).v };
            sym_typemap_insert(mut_view(*m), SymbolId { v: k }, TypeId { v: v });
        }
        i = i + 1;
    }

    if old_cap > 0 {
        unsafe {
            heap_free(old_keys as *mut u8, mul_usize(old_cap, size_of<u32>()), align_of<u32>());
            heap_free(old_vals as *mut u8, mul_usize(old_cap, size_of<TypeId>()), align_of<TypeId>());
            heap_free(old_states, old_cap, 1);
        }
    }
}

pub fn sym_typemap_insert(m: mut_view<SymTypeMap>, key: SymbolId, val: TypeId) {
    if m.cap == 0 || mul_usize(m.len + 1, MAP_LOAD_DEN) >= mul_usize(m.cap, MAP_LOAD_NUM) {
        sym_typemap_grow(mut_view(*m));
    }
    let mask = m.cap - 1;
    let mut idx = (hash_u32(key.v) as usize) & mask;
    loop {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            unsafe {
                *u32_at(m.keys, idx) = key.v;
                (*typeid_at(m.vals, idx)).v = val.v;
                *(m.states + idx) = SLOT_OCCUPIED;
            }
            m.len = m.len + 1;
            return;
        }
        let k = unsafe { *u32_at(m.keys, idx) };
        if k == key.v {
            unsafe {
                (*typeid_at(m.vals, idx)).v = val.v;
            }
            return;
        }
        idx = (idx + 1) & mask;
    }
}

pub fn sym_typemap_get(m: view<SymTypeMap>, key: SymbolId) -> *mut TypeId {
    if m.cap == 0 {
        return 0 as *mut TypeId;
    }
    let mask = m.cap - 1;
    let mut idx = (hash_u32(key.v) as usize) & mask;
    let mut probes: usize = 0;
    while (probes < m.cap) {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            return 0 as *mut TypeId;
        }
        if st == SLOT_OCCUPIED {
            let k = unsafe { *u32_at(m.keys, idx) };
            if k == key.v {
                return unsafe { typeid_at(m.vals, idx) };
            }
        }
        idx = (idx + 1) & mask;
        probes = probes + 1;
    }
    0 as *mut TypeId
}

pub fn sym_constmap_init(m: mut_view<SymConstMap>) {
    m.keys = 0 as *mut u32;
    m.vals = 0 as *mut ConstValue;
    m.states = 0 as *mut u8;
    m.len = 0;
    m.cap = 0;
}

pub fn sym_constmap_free(m: mut_view<SymConstMap>) {
    if m.cap > 0 {
        unsafe {
            heap_free(m.keys as *mut u8, mul_usize(m.cap, size_of<u32>()), align_of<u32>());
            heap_free(m.vals as *mut u8, mul_usize(m.cap, size_of<ConstValue>()), align_of<ConstValue>());
            heap_free(m.states, m.cap, 1);
        }
    }
    sym_constmap_init(m);
}

fn sym_constmap_grow(m: mut_view<SymConstMap>) {
    let new_cap: usize = if m.cap == 0 { MAP_INIT_CAP } else { mul_usize(m.cap, 2) };
    let new_keys = unsafe { heap_alloc(mul_usize(new_cap, size_of<u32>()), align_of<u32>()) as *mut u32 };
    let new_vals = unsafe {
        heap_alloc(mul_usize(new_cap, size_of<ConstValue>()), align_of<ConstValue>()) as *mut ConstValue
    };
    let new_states = unsafe { heap_alloc(new_cap, 1) };
    types_zero_bytes(new_states, new_cap);

    let old_keys = m.keys;
    let old_vals = m.vals;
    let old_states = m.states;
    let old_cap = m.cap;

    m.keys = new_keys;
    m.vals = new_vals;
    m.states = new_states;
    m.len = 0;
    m.cap = new_cap;

    let mut i: usize = 0;
    while (i < old_cap) {
        let st = unsafe { *(old_states + i) };
        if st == SLOT_OCCUPIED {
            let k = unsafe { *u32_at(old_keys, i) };
            let vp = unsafe { constval_at(old_vals, i) };
            unsafe {
                sym_constmap_insert(mut_view(*m), SymbolId { v: k }, view(*vp));
            }
        }
        i = i + 1;
    }

    if old_cap > 0 {
        unsafe {
            heap_free(old_keys as *mut u8, mul_usize(old_cap, size_of<u32>()), align_of<u32>());
            heap_free(old_vals as *mut u8, mul_usize(old_cap, size_of<ConstValue>()), align_of<ConstValue>());
            heap_free(old_states, old_cap, 1);
        }
    }
}

pub fn sym_constmap_insert(m: mut_view<SymConstMap>, key: SymbolId, val: view<ConstValue>) {
    if m.cap == 0 || mul_usize(m.len + 1, MAP_LOAD_DEN) >= mul_usize(m.cap, MAP_LOAD_NUM) {
        sym_constmap_grow(mut_view(*m));
    }
    let mask = m.cap - 1;
    let mut idx = (hash_u32(key.v) as usize) & mask;
    loop {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            unsafe {
                *u32_at(m.keys, idx) = key.v;
                let dst = constval_at(m.vals, idx);
                copy_const_value_into(mut_view(*dst), val);
                *(m.states + idx) = SLOT_OCCUPIED;
            }
            m.len = m.len + 1;
            return;
        }
        let k = unsafe { *u32_at(m.keys, idx) };
        if k == key.v {
            unsafe {
                let dst = constval_at(m.vals, idx);
                let preserve_i128 = ((*dst).kind == CONST_INT) &&
                    ((*dst).ty.v == 0x3FFF0128u32 || (*dst).ty.v == 0x3FFF0129u32) &&
                    ((*dst).int_val != 0u64 || const_val_int_hi(view(*dst)) != 0u64) &&
                    (val.kind == CONST_INT) &&
                    (val.int_val == 0u64 && const_val_int_hi(val) == 0u64);
                if !preserve_i128 {
                    copy_const_value_into(mut_view(*dst), val);
                }
            }
            return;
        }
        idx = (idx + 1) & mask;
    }
}

pub fn sym_constmap_get(m: view<SymConstMap>, key: SymbolId) -> *mut ConstValue {
    if m.cap == 0 {
        return 0 as *mut ConstValue;
    }
    let mask = m.cap - 1;
    let mut idx = (hash_u32(key.v) as usize) & mask;
    let mut probes: usize = 0;
    while (probes < m.cap) {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            return 0 as *mut ConstValue;
        }
        if st == SLOT_OCCUPIED {
            let k = unsafe { *u32_at(m.keys, idx) };
            if k == key.v {
                return unsafe { constval_at(m.vals, idx) };
            }
        }
        idx = (idx + 1) & mask;
        probes = probes + 1;
    }
    0 as *mut ConstValue
}

pub fn ptr_substmap_init(m: mut_view<PtrSubstMap>) {
    m.keys = 0 as *mut usize;
    m.vals = 0 as *mut GenericArgsSlice;
    m.states = 0 as *mut u8;
    m.len = 0;
    m.cap = 0;
}

pub fn ptr_substmap_free(m: mut_view<PtrSubstMap>) {
    if m.cap > 0 {
        unsafe {
            heap_free(m.keys as *mut u8, mul_usize(m.cap, size_of<usize>()), align_of<usize>());
            heap_free(
                m.vals as *mut u8,
                mul_usize(m.cap, size_of<GenericArgsSlice>()),
                align_of<GenericArgsSlice>()
            );
            heap_free(m.states, m.cap, 1);
        }
    }
    ptr_substmap_init(m);
}

fn ptr_substmap_grow(m: mut_view<PtrSubstMap>) {
    let new_cap: usize = if m.cap == 0 { MAP_INIT_CAP } else { mul_usize(m.cap, 2) };
    let new_keys = unsafe { heap_alloc(mul_usize(new_cap, size_of<usize>()), align_of<usize>()) as *mut usize };
    let new_vals = unsafe {
        let vbytes = mul_usize(new_cap, size_of<GenericArgsSlice>());
        heap_alloc(vbytes, align_of<GenericArgsSlice>()) as *mut GenericArgsSlice
    };
    let new_states = unsafe { heap_alloc(new_cap, 1) };
    types_zero_bytes(new_states, new_cap);

    let old_keys = m.keys;
    let old_vals = m.vals;
    let old_states = m.states;
    let old_cap = m.cap;

    m.keys = new_keys;
    m.vals = new_vals;
    m.states = new_states;
    m.len = 0;
    m.cap = new_cap;

    let mut i: usize = 0;
    while (i < old_cap) {
        let st = unsafe { *(old_states + i) };
        if st == SLOT_OCCUPIED {
            let k = unsafe { *usize_at(old_keys, i) };
            let vp = unsafe { subst_at(old_vals, i) };
            let args_ptr = unsafe { (*vp).args };
            let cnt = unsafe { (*vp).count };
            ptr_substmap_insert(mut_view(*m), k, args_ptr, cnt);
        }
        i = i + 1;
    }

    if old_cap > 0 {
        unsafe {
            heap_free(old_keys as *mut u8, mul_usize(old_cap, size_of<usize>()), align_of<usize>());
            heap_free(
                old_vals as *mut u8,
                mul_usize(old_cap, size_of<GenericArgsSlice>()),
                align_of<GenericArgsSlice>()
            );
            heap_free(old_states, old_cap, 1);
        }
    }
}

pub fn ptr_substmap_insert(
    m: mut_view<PtrSubstMap>,
    key: usize,
    args: *mut TypeId,
    count: usize
) {
    if m.cap == 0 || mul_usize(m.len + 1, MAP_LOAD_DEN) >= mul_usize(m.cap, MAP_LOAD_NUM) {
        ptr_substmap_grow(mut_view(*m));
    }
    let mask = m.cap - 1;
    let mut idx = (hash_u64(key as u64) as usize) & mask;
    loop {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            unsafe {
                *usize_at(m.keys, idx) = key;
                let vp = subst_at(m.vals, idx);
                (*vp).args = args;
                (*vp).count = count;
                *(m.states + idx) = SLOT_OCCUPIED;
            }
            m.len = m.len + 1;
            return;
        }
        let k = unsafe { *usize_at(m.keys, idx) };
        if k == key {
            unsafe {
                let vp = subst_at(m.vals, idx);
                (*vp).args = args;
                (*vp).count = count;
            }
            return;
        }
        idx = (idx + 1) & mask;
    }
}

pub fn ptr_substmap_get(m: view<PtrSubstMap>, key: usize) -> *mut GenericArgsSlice {
    if m.cap == 0 {
        return 0 as *mut GenericArgsSlice;
    }
    let mask = m.cap - 1;
    let mut idx = (hash_u64(key as u64) as usize) & mask;
    let mut probes: usize = 0;
    while (probes < m.cap) {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            return 0 as *mut GenericArgsSlice;
        }
        if st == SLOT_OCCUPIED {
            let k = unsafe { *usize_at(m.keys, idx) };
            if k == key {
                return unsafe { subst_at(m.vals, idx) };
            }
        }
        idx = (idx + 1) & mask;
        probes = probes + 1;
    }
    0 as *mut GenericArgsSlice
}

pub fn ptr_trymap_init(m: mut_view<PtrTryMap>) {
    m.keys = 0 as *mut usize;
    m.vals = 0 as *mut TryExprInfo;
    m.states = 0 as *mut u8;
    m.len = 0;
    m.cap = 0;
}

pub fn ptr_trymap_free(m: mut_view<PtrTryMap>) {
    if m.cap > 0 {
        unsafe {
            heap_free(m.keys as *mut u8, mul_usize(m.cap, size_of<usize>()), align_of<usize>());
            heap_free(m.vals as *mut u8, mul_usize(m.cap, size_of<TryExprInfo>()), align_of<TryExprInfo>());
            heap_free(m.states, m.cap, 1);
        }
    }
    ptr_trymap_init(m);
}

fn ptr_trymap_grow(m: mut_view<PtrTryMap>) {
    let new_cap: usize = if m.cap == 0 { MAP_INIT_CAP } else { mul_usize(m.cap, 2) };
    let new_keys = unsafe { heap_alloc(mul_usize(new_cap, size_of<usize>()), align_of<usize>()) as *mut usize };
    let new_vals = unsafe {
        heap_alloc(mul_usize(new_cap, size_of<TryExprInfo>()), align_of<TryExprInfo>()) as *mut TryExprInfo
    };
    let new_states = unsafe { heap_alloc(new_cap, 1) };
    types_zero_bytes(new_states, new_cap);

    let old_keys = m.keys;
    let old_vals = m.vals;
    let old_states = m.states;
    let old_cap = m.cap;

    m.keys = new_keys;
    m.vals = new_vals;
    m.states = new_states;
    m.len = 0;
    m.cap = new_cap;

    let mut i: usize = 0;
    while (i < old_cap) {
        let st = unsafe { *(old_states + i) };
        if st == SLOT_OCCUPIED {
            let k = unsafe { *usize_at(old_keys, i) };
            let vp = unsafe { tryinfo_at(old_vals, i) };
            let is_opt = unsafe { (*vp).is_opt };
            let p_idx = unsafe { (*vp).payload_idx };
            let e_idx = unsafe { (*vp).err_idx };
            ptr_trymap_insert(mut_view(*m), k, is_opt, p_idx, e_idx);
        }
        i = i + 1;
    }

    if old_cap > 0 {
        unsafe {
            heap_free(old_keys as *mut u8, mul_usize(old_cap, size_of<usize>()), align_of<usize>());
            heap_free(old_vals as *mut u8, mul_usize(old_cap, size_of<TryExprInfo>()), align_of<TryExprInfo>());
            heap_free(old_states, old_cap, 1);
        }
    }
}

pub fn ptr_trymap_insert(
    m: mut_view<PtrTryMap>,
    key: usize,
    is_opt: bool,
    payload_idx: usize,
    err_idx: usize
) {
    if m.cap == 0 || mul_usize(m.len + 1, MAP_LOAD_DEN) >= mul_usize(m.cap, MAP_LOAD_NUM) {
        ptr_trymap_grow(mut_view(*m));
    }
    let mask = m.cap - 1;
    let mut idx = (hash_u64(key as u64) as usize) & mask;
    loop {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            unsafe {
                *usize_at(m.keys, idx) = key;
                let vp = tryinfo_at(m.vals, idx);
                (*vp).is_opt = is_opt;
                (*vp).payload_idx = payload_idx;
                (*vp).err_idx = err_idx;
                *(m.states + idx) = SLOT_OCCUPIED;
            }
            m.len = m.len + 1;
            return;
        }
        let k = unsafe { *usize_at(m.keys, idx) };
        if k == key {
            unsafe {
                let vp = tryinfo_at(m.vals, idx);
                (*vp).is_opt = is_opt;
                (*vp).payload_idx = payload_idx;
                (*vp).err_idx = err_idx;
            }
            return;
        }
        idx = (idx + 1) & mask;
    }
}

pub fn ptr_trymap_get(m: view<PtrTryMap>, key: usize) -> *mut TryExprInfo {
    if m.cap == 0 {
        return 0 as *mut TryExprInfo;
    }
    let mask = m.cap - 1;
    let mut idx = (hash_u64(key as u64) as usize) & mask;
    let mut probes: usize = 0;
    while (probes < m.cap) {
        let st = unsafe { *(m.states + idx) };
        if st == SLOT_EMPTY {
            return 0 as *mut TryExprInfo;
        }
        if st == SLOT_OCCUPIED {
            let k = unsafe { *usize_at(m.keys, idx) };
            if k == key {
                return unsafe { tryinfo_at(m.vals, idx) };
            }
        }
        idx = (idx + 1) & mask;
        probes = probes + 1;
    }
    0 as *mut TryExprInfo
}

pub fn thir_init(thir: mut_view<Thir>) {
    type_interner_init(mut_view(thir.interner));
    ptr_typemap_init(mut_view(thir.expr_types));
    ptr_typemap_init(mut_view(thir.pat_types));
    ptr_u32map_init(mut_view(thir.expr_variants));
    ptr_u32map_init(mut_view(thir.pat_variants));
    ptr_itemmap_init(mut_view(thir.expr_methods));
    ptr_typemap_init(mut_view(thir.item_types));
    ptr_typemap_init(mut_view(thir.param_types));
    sym_typemap_init(mut_view(thir.symbol_types));
    sym_constmap_init(mut_view(thir.symbol_consts));
    ptr_substmap_init(mut_view(thir.expr_substs));
    ptr_substmap_init(mut_view(thir.pat_substs));
    ptr_trymap_init(mut_view(thir.expr_try_info));
}

pub fn thir_free(thir: mut_view<Thir>) {
    ptr_trymap_free(mut_view(thir.expr_try_info));
    ptr_substmap_free(mut_view(thir.pat_substs));
    ptr_substmap_free(mut_view(thir.expr_substs));
    sym_constmap_free(mut_view(thir.symbol_consts));
    sym_typemap_free(mut_view(thir.symbol_types));
    ptr_typemap_free(mut_view(thir.param_types));
    ptr_typemap_free(mut_view(thir.item_types));
    ptr_itemmap_free(mut_view(thir.expr_methods));
    ptr_u32map_free(mut_view(thir.pat_variants));
    ptr_u32map_free(mut_view(thir.expr_variants));
    ptr_typemap_free(mut_view(thir.pat_types));
    ptr_typemap_free(mut_view(thir.expr_types));
    type_interner_free(mut_view(thir.interner));
}

pub fn thir_set_expr_type(thir: mut_view<Thir>, expr: *const HirExpr, ty: TypeId) {
    ptr_typemap_insert(mut_view(thir.expr_types), expr as usize, ty);
}

pub fn thir_get_expr_type(thir: view<Thir>, expr: *const HirExpr) -> *mut TypeId {
    ptr_typemap_get(view(thir.expr_types), expr as usize)
}

pub fn thir_set_pat_type(thir: mut_view<Thir>, pat: *const HirPat, ty: TypeId) {
    ptr_typemap_insert(mut_view(thir.pat_types), pat as usize, ty);
}

pub fn thir_get_pat_type(thir: view<Thir>, pat: *const HirPat) -> *mut TypeId {
    ptr_typemap_get(view(thir.pat_types), pat as usize)
}

pub fn thir_set_item_type(thir: mut_view<Thir>, item: *const HirItem, ty: TypeId) {
    ptr_typemap_insert(mut_view(thir.item_types), item as usize, ty);
}

pub fn thir_get_item_type(thir: view<Thir>, item: *const HirItem) -> *mut TypeId {
    ptr_typemap_get(view(thir.item_types), item as usize)
}

pub fn thir_set_param_type(thir: mut_view<Thir>, param: *const HirParam, ty: TypeId) {
    ptr_typemap_insert(mut_view(thir.param_types), param as usize, ty);
}

pub fn thir_get_param_type(thir: view<Thir>, param: *const HirParam) -> *mut TypeId {
    ptr_typemap_get(view(thir.param_types), param as usize)
}

pub fn thir_set_sym_type(thir: mut_view<Thir>, sym: SymbolId, ty: TypeId) {
    sym_typemap_insert(mut_view(thir.symbol_types), sym, ty);
}

pub fn thir_get_sym_type(thir: view<Thir>, sym: SymbolId) -> *mut TypeId {
    sym_typemap_get(view(thir.symbol_types), sym)
}

pub fn thir_set_expr_variant(thir: mut_view<Thir>, expr: *const HirExpr, variant_idx: u32) {
    ptr_u32map_insert(mut_view(thir.expr_variants), expr as usize, variant_idx);
}

pub fn thir_get_expr_variant(thir: view<Thir>, expr: *const HirExpr) -> *mut u32 {
    ptr_u32map_get(view(thir.expr_variants), expr as usize)
}

pub fn thir_set_pat_variant(thir: mut_view<Thir>, pat: *const HirPat, variant_idx: u32) {
    ptr_u32map_insert(mut_view(thir.pat_variants), pat as usize, variant_idx);
}

pub fn thir_get_pat_variant(thir: view<Thir>, pat: *const HirPat) -> *mut u32 {
    ptr_u32map_get(view(thir.pat_variants), pat as usize)
}

pub fn thir_set_expr_method(thir: mut_view<Thir>, expr: *const HirExpr, method: *const HirItem) {
    ptr_itemmap_insert(mut_view(thir.expr_methods), expr as usize, method);
}

pub fn thir_get_expr_method(thir: view<Thir>, expr: *const HirExpr) -> *mut *const HirItem {
    ptr_itemmap_get(view(thir.expr_methods), expr as usize)
}

pub fn thir_set_orig_item_name(thir: mut_view<Thir>, item: *const HirItem, name_v: u32) {
    let key = (item as usize) | 1usize;
    let existing = ptr_u32map_get(view(thir.expr_variants), key);
    if (existing as usize) == 0 {
        ptr_u32map_insert(mut_view(thir.expr_variants), key, name_v);
    }
}

pub fn thir_get_orig_item_name(thir: view<Thir>, item: *const HirItem) -> *mut u32 {
    ptr_u32map_get(view(thir.expr_variants), (item as usize) | 1usize)
}

pub fn thir_set_mono_prepared(thir: mut_view<Thir>, mono_ptr: *mut u8) {
    ptr_u32map_insert(mut_view(thir.expr_variants), 1usize, 1u32);
    ptr_itemmap_insert(mut_view(thir.expr_methods), 1usize, mono_ptr as *const HirItem);
}

pub fn thir_is_mono_prepared(thir: view<Thir>) -> bool {
    (ptr_u32map_get(view(thir.expr_variants), 1usize) as usize) != 0
}

pub fn thir_get_mono_engine(thir: view<Thir>) -> *mut u8 {
    let p = ptr_itemmap_get(view(thir.expr_methods), 1usize);
    if (p as usize) == 0 {
        return 0 as *mut u8;
    }
    (unsafe { *p }) as *mut u8
}

pub struct TypeVarEntry {
    pub resolved_to: TypeId,
    pub is_generic: bool,
    pub span: Span,
}

pub struct TypeVarTable {
    pub items: *mut TypeVarEntry,
    pub len: usize,
    pub cap: usize,
    pub fn_var_start: usize,
}

pub unsafe fn typevar_at(base: *mut TypeVarEntry, idx: usize) -> *mut TypeVarEntry {
    let off = ((idx as isize) * (size_of<TypeVarEntry>() as isize)) as usize;
    ((base as usize) + off) as *mut TypeVarEntry
}

pub fn type_vars_init(tv: mut_view<TypeVarTable>) {
    tv.items = 0 as *mut TypeVarEntry;
    tv.len = 0;
    tv.cap = 0;
    tv.fn_var_start = 0;
}

pub fn type_vars_free(tv: mut_view<TypeVarTable>) {
    if tv.cap > 0 && (tv.items as usize) != 0 {
        unsafe {
            heap_free(
                tv.items as *mut u8,
                mul_usize(tv.cap, size_of<TypeVarEntry>()),
                align_of<TypeVarEntry>()
            );
        }
    }
    type_vars_init(tv);
}

fn type_vars_grow(tv: mut_view<TypeVarTable>) {
    let new_cap: usize = if tv.cap == 0 { MAP_INIT_CAP } else { mul_usize(tv.cap, 2) };
    let new_items = unsafe {
        heap_alloc(mul_usize(new_cap, size_of<TypeVarEntry>()), align_of<TypeVarEntry>()) as *mut TypeVarEntry
    };
    if tv.len > 0 && (tv.items as usize) != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(
                tv.items as *const u8,
                new_items as *mut u8,
                mul_usize(tv.len, size_of<TypeVarEntry>())
            );
            heap_free(
                tv.items as *mut u8,
                mul_usize(tv.cap, size_of<TypeVarEntry>()),
                align_of<TypeVarEntry>()
            );
        }
    }
    tv.items = new_items;
    tv.cap = new_cap;
}

pub fn type_vars_new_int_var(tv: mut_view<TypeVarTable>, ti: mut_view<TypeInterner>) -> TypeId {
    if tv.len == tv.cap {
        type_vars_grow(mut_view(*tv));
    }
    let var_id = tv.len as u32;
    let entry = unsafe { typevar_at(tv.items, tv.len) };
    unsafe {
        (*entry).resolved_to.v = 0u32;
        (*entry).is_generic = false;
        (*entry).span.file.v = 0u32;
        (*entry).span.start = 0u32;
        (*entry).span.end = 0u32;
    }
    tv.len = tv.len + 1;
    intern_var_ty(mut_view(*ti), TY_INT_VAR, var_id)
}

pub fn type_vars_new_ty_var(
    tv: mut_view<TypeVarTable>,
    ti: mut_view<TypeInterner>,
    span: view<Span>
) -> TypeId {
    if tv.len == tv.cap {
        type_vars_grow(mut_view(*tv));
    }
    let var_id = tv.len as u32;
    let entry = unsafe { typevar_at(tv.items, tv.len) };
    unsafe {
        (*entry).resolved_to.v = 0u32;
        (*entry).is_generic = true;
        (*entry).span.file.v = span.file.v;
        (*entry).span.start = span.start;
        (*entry).span.end = span.end;
    }
    tv.len = tv.len + 1;
    intern_var_ty(mut_view(*ti), TY_VAR, var_id)
}

pub fn type_vars_resolve(tv: mut_view<TypeVarTable>, ti: view<TypeInterner>, id: TypeId) -> TypeId {
    let id_v = id.v;
    if id_v == 0u32 {
        return TypeId { v: 0u32 };
    }
    let t = type_get(ti, TypeId { v: id_v });
    if (t as usize) == 0 {
        return TypeId { v: id_v };
    }
    let k = unsafe { (*t).kind };
    if k == TY_INT_VAR || k == TY_VAR {
        let vid = unsafe { (*t).var_id as usize };
        if vid < tv.len {
            let entry = unsafe { typevar_at(tv.items, vid) };
            let res_v = unsafe { (*entry).resolved_to.v };
            if res_v != 0u32 && res_v != id_v {
                let res_id = TypeId { v: res_v };
                let full = type_vars_resolve(mut_view(*tv), ti, res_id);
                let full_v = full.v;
                let entry_after = unsafe { typevar_at(tv.items, vid) };
                unsafe {
                    (*entry_after).resolved_to.v = full_v;
                }
                return TypeId { v: full_v };
            }
        }
    }
    TypeId { v: id_v }
}

pub fn type_vars_unify(
    tv: mut_view<TypeVarTable>,
    ti: view<TypeInterner>,
    a: TypeId,
    b: TypeId
) -> bool {
    let ra = type_vars_resolve(mut_view(*tv), ti, TypeId { v: a.v });
    let rb = type_vars_resolve(mut_view(*tv), ti, TypeId { v: b.v });
    let ra_v = ra.v;
    let rb_v = rb.v;
    if ra_v == rb_v {
        return true;
    }
    let ta = type_get(ti, TypeId { v: ra_v });
    let tb = type_get(ti, TypeId { v: rb_v });
    if (ta as usize) == 0 || (tb as usize) == 0 {
        return false;
    }
    let ka = unsafe { (*ta).kind };
    let kb = unsafe { (*tb).kind };
    if ka == TY_ERROR || kb == TY_ERROR {
        return true;
    }
    if ka == TY_NEVER || kb == TY_NEVER {
        return true;
    }
    if ka == TY_VAR {
        let va = unsafe { (*ta).var_id as usize };
        let vb = unsafe { (*tb).var_id as usize };
        if kb != TY_VAR || va != vb {
            if va < tv.len {
                let ea = unsafe { typevar_at(tv.items, va) };
                unsafe {
                    (*ea).resolved_to.v = rb_v;
                }
            }
        }
        return true;
    }
    if kb == TY_VAR {
        let vb = unsafe { (*tb).var_id as usize };
        if vb < tv.len {
            let eb = unsafe { typevar_at(tv.items, vb) };
            unsafe {
                (*eb).resolved_to.v = ra_v;
            }
        }
        return true;
    }
    if ka == TY_INT_VAR {
        let rb_ty = TypeId { v: rb_v };
        if kb == TY_INT_VAR || type_is_int(rb_ty, ti) {
            let va = unsafe { (*ta).var_id as usize };
            if va < tv.len {
                let ea = unsafe { typevar_at(tv.items, va) };
                unsafe {
                    (*ea).resolved_to.v = rb_v;
                }
            }
            return true;
        }
        return false;
    }
    if kb == TY_INT_VAR {
        let ra_ty = TypeId { v: ra_v };
        if type_is_int(ra_ty, ti) {
            let vb = unsafe { (*tb).var_id as usize };
            if vb < tv.len {
                let eb = unsafe { typevar_at(tv.items, vb) };
                unsafe {
                    (*eb).resolved_to.v = ra_v;
                }
            }
            return true;
        }
        return false;
    }
    if ka == TY_TUPLE && kb == TY_TUPLE {
        let fca = unsafe { (*ta).field_count };
        let fcb = unsafe { (*tb).field_count };
        if fca != fcb {
            return false;
        }
        let fa_ptr = unsafe { (*ta).fields };
        let fb_ptr = unsafe { (*tb).fields };
        let mut ok = true;
        let mut i: usize = 0;
        while (i < fca) {
            let fav = unsafe { (*typeid_at(fa_ptr, i)).v };
            let fbv = unsafe { (*typeid_at(fb_ptr, i)).v };
            let fa_ty = TypeId { v: fav };
            let fb_ty = TypeId { v: fbv };
            if !type_vars_unify(mut_view(*tv), ti, fa_ty, fb_ty) {
                ok = false;
            }
            i = i + 1;
        }
        return ok;
    }
    if ka == TY_ARRAY && kb == TY_ARRAY {
        let la = unsafe { (*ta).array_len };
        let lb = unsafe { (*tb).array_len };
        if la != lb {
            return false;
        }
        let ela = unsafe { (*ta).elem.v };
        let elb = unsafe { (*tb).elem.v };
        let ela_ty = TypeId { v: ela };
        let elb_ty = TypeId { v: elb };
        return type_vars_unify(mut_view(*tv), ti, ela_ty, elb_ty);
    }
    if ka == TY_VIEW && kb == TY_VIEW {
        let pta = unsafe { (*ta).pointee.v };
        let ptb = unsafe { (*tb).pointee.v };
        let pta_ty = TypeId { v: pta };
        let ptb_ty = TypeId { v: ptb };
        return type_vars_unify(mut_view(*tv), ti, pta_ty, ptb_ty);
    }
    if ka == TY_MUT_VIEW && kb == TY_MUT_VIEW {
        let pta = unsafe { (*ta).pointee.v };
        let ptb = unsafe { (*tb).pointee.v };
        let pta_ty = TypeId { v: pta };
        let ptb_ty = TypeId { v: ptb };
        return type_vars_unify(mut_view(*tv), ti, pta_ty, ptb_ty);
    }
    if ka == TY_PTR && kb == TY_PTR {
        let ma = unsafe { (*ta).is_mut };
        let mb = unsafe { (*tb).is_mut };
        if ma != mb {
            return false;
        }
        let pta = unsafe { (*ta).pointee.v };
        let ptb = unsafe { (*tb).pointee.v };
        let pta_ty = TypeId { v: pta };
        let ptb_ty = TypeId { v: ptb };
        return type_vars_unify(mut_view(*tv), ti, pta_ty, ptb_ty);
    }
    if ka == TY_STR && kb == TY_VIEW {
        let ptb_v = unsafe { (*tb).pointee.v };
        let p_tb = type_get(ti, TypeId { v: ptb_v });
        if (p_tb as usize) == 0 {
            return false;
        }
        let p_kb = unsafe { (*p_tb).kind };
        if p_kb != TY_SLICE {
            return false;
        }
        let elb = unsafe { (*p_tb).elem.v };
        let u8_ty = TypeId { v: ti.t_u8.v };
        let elb_ty = TypeId { v: elb };
        return type_vars_unify(mut_view(*tv), ti, u8_ty, elb_ty);
    }
    if kb == TY_STR && ka == TY_VIEW {
        let pta_v = unsafe { (*ta).pointee.v };
        let p_ta = type_get(ti, TypeId { v: pta_v });
        if (p_ta as usize) == 0 {
            return false;
        }
        let p_ka = unsafe { (*p_ta).kind };
        if p_ka != TY_SLICE {
            return false;
        }
        let ela = unsafe { (*p_ta).elem.v };
        let u8_ty = TypeId { v: ti.t_u8.v };
        let ela_ty = TypeId { v: ela };
        return type_vars_unify(mut_view(*tv), ti, u8_ty, ela_ty);
    }
    type_vars_unify_compound(mut_view(*tv), ti, ta, tb, ka, kb)
}

fn type_vars_unify_compound(
    tv: mut_view<TypeVarTable>,
    ti: view<TypeInterner>,
    ta: *const AxType,
    tb: *const AxType,
    ka: u8,
    kb: u8
) -> bool {
    if (ka == TY_ENUM && kb == TY_ENUM) || (ka == TY_STRUCT && kb == TY_STRUCT) {
        let defa = unsafe { (*ta).def as usize };
        let defb = unsafe { (*tb).def as usize };
        if defa != defb {
            return false;
        }
        let aca = unsafe { (*ta).arg_count };
        let acb = unsafe { (*tb).arg_count };
        if aca != acb {
            return false;
        }
        let args_a = unsafe { (*ta).args };
        let args_b = unsafe { (*tb).args };
        let mut ok = true;
        let mut i: usize = 0;
        while (i < aca) {
            let aav = unsafe { (*typeid_at(args_a, i)).v };
            let abv = unsafe { (*typeid_at(args_b, i)).v };
            let aa_ty = TypeId { v: aav };
            let ab_ty = TypeId { v: abv };
            if !type_vars_unify(mut_view(*tv), ti, aa_ty, ab_ty) {
                ok = false;
            }
            i = i + 1;
        }
        return ok;
    }
    if ka == TY_FN && kb == TY_FN {
        let pca = unsafe { (*ta).param_count };
        let pcb = unsafe { (*tb).param_count };
        if pca != pcb {
            return false;
        }
        let reta = unsafe { (*ta).ret_type.v };
        let retb = unsafe { (*tb).ret_type.v };
        let reta_ty = TypeId { v: reta };
        let retb_ty = TypeId { v: retb };
        if !type_vars_unify(mut_view(*tv), ti, reta_ty, retb_ty) {
            return false;
        }
        let pa_ptr = unsafe { (*ta).param_types };
        let pb_ptr = unsafe { (*tb).param_types };
        let mut i: usize = 0;
        while (i < pca) {
            let pav = unsafe { (*typeid_at(pa_ptr, i)).v };
            let pbv = unsafe { (*typeid_at(pb_ptr, i)).v };
            let pa_ty = TypeId { v: pav };
            let pb_ty = TypeId { v: pbv };
            if !type_vars_unify(mut_view(*tv), ti, pa_ty, pb_ty) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    if ka == TY_CLOSURE && kb == TY_CLOSURE {
        let cida = unsafe { (*ta).closure_id };
        let cidb = unsafe { (*tb).closure_id };
        return cida == cidb;
    }
    false
}

pub fn subst_type_with_vars(
    ty: TypeId,
    args: view<GenericArgsSlice>,
    tv: mut_view<TypeVarTable>,
    ti: mut_view<TypeInterner>
) -> TypeId {
    let ty_v = ty.v;
    if ty_v == 0u32 {
        return TypeId { v: 0u32 };
    }
    let resolved = type_vars_resolve(mut_view(*tv), view(*ti), TypeId { v: ty_v });
    let res_v = resolved.v;
    if args.count == 0 || (args.args as usize) == 0 {
        return TypeId { v: res_v };
    }
    let t = type_get(view(*ti), TypeId { v: res_v });
    if (t as usize) == 0 {
        return TypeId { v: res_v };
    }
    let kind = unsafe { (*t).kind };
    if kind == TY_PARAM {
        let idx = unsafe { (*t).param_index as usize };
        if idx < args.count {
            let sub_v = unsafe { (*typeid_at(args.args, idx)).v };
            if sub_v != 0u32 {
                return TypeId { v: sub_v };
            }
        }
        return TypeId { v: res_v };
    }
    if kind == TY_PTR || kind == TY_VIEW || kind == TY_MUT_VIEW {
        let orig_pt_v = unsafe { (*t).pointee.v };
        let orig_pt = TypeId { v: orig_pt_v };
        let new_pt = subst_type_with_vars(orig_pt, args, mut_view(*tv), mut_view(*ti));
        let new_pt_v = new_pt.v;
        if new_pt_v == orig_pt_v {
            return TypeId { v: res_v };
        }
        let t_cur = type_get(view(*ti), TypeId { v: res_v });
        let sp = ti.scratch;
        unsafe {
            copy_ax_type_into(mut_view(*sp), view(*t_cur));
            (*sp).pointee.v = new_pt_v;
        }
        return intern_type(mut_view(*ti), unsafe { view(*sp) });
    }
    if kind == TY_ARRAY || kind == TY_SLICE {
        let orig_el_v = unsafe { (*t).elem.v };
        let orig_el = TypeId { v: orig_el_v };
        let new_el = subst_type_with_vars(orig_el, args, mut_view(*tv), mut_view(*ti));
        let new_el_v = new_el.v;
        if new_el_v == orig_el_v {
            return TypeId { v: res_v };
        }
        let t_cur = type_get(view(*ti), TypeId { v: res_v });
        let sp = ti.scratch;
        unsafe {
            copy_ax_type_into(mut_view(*sp), view(*t_cur));
            (*sp).elem.v = new_el_v;
        }
        return intern_type(mut_view(*ti), unsafe { view(*sp) });
    }
    if kind == TY_TUPLE {
        let fcnt = unsafe { (*t).field_count };
        if fcnt == 0 {
            return TypeId { v: res_v };
        }
        let orig_fields = unsafe { (*t).fields };
        let new_fields = unsafe {
            let fbytes = mul_usize(fcnt, size_of<TypeId>());
            arena_alloc_raw(mut_view(ti.arena), fbytes, align_of<TypeId>()) as *mut TypeId
        };
        let mut changed = false;
        let mut i: usize = 0;
        while (i < fcnt) {
            let of_v = unsafe { (*typeid_at(orig_fields, i)).v };
            let of_ty = TypeId { v: of_v };
            let nf = subst_type_with_vars(of_ty, args, mut_view(*tv), mut_view(*ti));
            let nf_v = nf.v;
            if nf_v != of_v {
                changed = true;
            }
            unsafe {
                (*typeid_at(new_fields, i)).v = nf_v;
            }
            i = i + 1;
        }
        if !changed {
            return TypeId { v: res_v };
        }
        let t_cur = type_get(view(*ti), TypeId { v: res_v });
        let sp = ti.scratch;
        unsafe {
            copy_ax_type_into(mut_view(*sp), view(*t_cur));
            (*sp).fields = new_fields;
        }
        return intern_type(mut_view(*ti), unsafe { view(*sp) });
    }
    if kind == TY_FN {
        let orig_ret_v = unsafe { (*t).ret_type.v };
        let orig_ret = TypeId { v: orig_ret_v };
        let new_ret = subst_type_with_vars(orig_ret, args, mut_view(*tv), mut_view(*ti));
        let new_ret_v = new_ret.v;
        let mut changed: bool = new_ret_v != orig_ret_v;
        let pcnt = unsafe { (*t).param_count };
        let mut new_params: *mut TypeId = 0 as *mut TypeId;
        if pcnt > 0 {
            let orig_params = unsafe { (*t).param_types };
            new_params = unsafe {
                let pbytes = mul_usize(pcnt, size_of<TypeId>());
                arena_alloc_raw(mut_view(ti.arena), pbytes, align_of<TypeId>()) as *mut TypeId
            };
            let mut i: usize = 0;
            while (i < pcnt) {
                let op_v = unsafe { (*typeid_at(orig_params, i)).v };
                let op_ty = TypeId { v: op_v };
                let np = subst_type_with_vars(op_ty, args, mut_view(*tv), mut_view(*ti));
                let np_v = np.v;
                if np_v != op_v {
                    changed = true;
                }
                unsafe {
                    (*typeid_at(new_params, i)).v = np_v;
                }
                i = i + 1;
            }
        }
        if !changed {
            return TypeId { v: res_v };
        }
        let t_cur = type_get(view(*ti), TypeId { v: res_v });
        let sp = ti.scratch;
        unsafe {
            copy_ax_type_into(mut_view(*sp), view(*t_cur));
            (*sp).ret_type.v = new_ret_v;
            (*sp).param_types = new_params;
        }
        return intern_type(mut_view(*ti), unsafe { view(*sp) });
    }
    subst_adt_with_vars(res_v, t, kind, args, mut_view(*tv), mut_view(*ti))
}

fn subst_adt_with_vars(
    res_v: u32,
    t: *const AxType,
    kind: u8,
    args: view<GenericArgsSlice>,
    tv: mut_view<TypeVarTable>,
    ti: mut_view<TypeInterner>
) -> TypeId {
    if kind == TY_STRUCT {
        let mut changed = false;
        let acnt = unsafe { (*t).arg_count };
        let mut new_args: *mut TypeId = 0 as *mut TypeId;
        if acnt > 0 {
            let orig_args = unsafe { (*t).args };
            new_args = unsafe {
                let abytes = mul_usize(acnt, size_of<TypeId>());
                arena_alloc_raw(mut_view(ti.arena), abytes, align_of<TypeId>()) as *mut TypeId
            };
            let mut i: usize = 0;
            while (i < acnt) {
                let oa_v = unsafe { (*typeid_at(orig_args, i)).v };
                let oa_ty = TypeId { v: oa_v };
                let na = subst_type_with_vars(oa_ty, args, mut_view(*tv), mut_view(*ti));
                let na_v = na.v;
                if na_v != oa_v {
                    changed = true;
                }
                unsafe {
                    (*typeid_at(new_args, i)).v = na_v;
                }
                i = i + 1;
            }
        }
        let fcnt = unsafe { (*t).field_count };
        let mut new_fields: *mut TypeId = 0 as *mut TypeId;
        if fcnt > 0 {
            let orig_fields = unsafe { (*t).fields };
            new_fields = unsafe {
                let fbytes = mul_usize(fcnt, size_of<TypeId>());
                arena_alloc_raw(mut_view(ti.arena), fbytes, align_of<TypeId>()) as *mut TypeId
            };
            let mut i: usize = 0;
            while (i < fcnt) {
                let of_v = unsafe { (*typeid_at(orig_fields, i)).v };
                let of_ty = TypeId { v: of_v };
                let nf = subst_type_with_vars(of_ty, args, mut_view(*tv), mut_view(*ti));
                let nf_v = nf.v;
                if nf_v != of_v {
                    changed = true;
                }
                unsafe {
                    (*typeid_at(new_fields, i)).v = nf_v;
                }
                i = i + 1;
            }
        }
        if !changed {
            return TypeId { v: res_v };
        }
        let t_cur = type_get(view(*ti), TypeId { v: res_v });
        let sp = ti.scratch;
        unsafe {
            copy_ax_type_into(mut_view(*sp), view(*t_cur));
            if (new_args as usize) != 0 {
                (*sp).args = new_args;
            }
            if (new_fields as usize) != 0 {
                (*sp).fields = new_fields;
            }
        }
        return intern_type(mut_view(*ti), unsafe { view(*sp) });
    }
    if kind == TY_ENUM {
        let mut changed = false;
        let acnt = unsafe { (*t).arg_count };
        let mut new_args: *mut TypeId = 0 as *mut TypeId;
        if acnt > 0 {
            let orig_args = unsafe { (*t).args };
            new_args = unsafe {
                let abytes = mul_usize(acnt, size_of<TypeId>());
                arena_alloc_raw(mut_view(ti.arena), abytes, align_of<TypeId>()) as *mut TypeId
            };
            let mut i: usize = 0;
            while (i < acnt) {
                let oa_v = unsafe { (*typeid_at(orig_args, i)).v };
                let oa_ty = TypeId { v: oa_v };
                let na = subst_type_with_vars(oa_ty, args, mut_view(*tv), mut_view(*ti));
                let na_v = na.v;
                if na_v != oa_v {
                    changed = true;
                }
                unsafe {
                    (*typeid_at(new_args, i)).v = na_v;
                }
                i = i + 1;
            }
        }
        let vcnt = unsafe { (*t).variant_count };
        let vcounts = unsafe { (*t).variant_field_counts };
        let orig_vfields = unsafe { (*t).variant_fields };
        let mut new_vfields: *mut *mut TypeId = 0 as *mut *mut TypeId;
        if vcnt > 0 && (vcounts as usize) != 0 && (orig_vfields as usize) != 0 {
            new_vfields = unsafe {
                let vfbytes = mul_usize(vcnt, size_of<*mut TypeId>());
                arena_alloc_raw(mut_view(ti.arena), vfbytes, align_of<*mut TypeId>()) as *mut *mut TypeId
            };
            let mut v: usize = 0;
            while (v < vcnt) {
                let fc = unsafe { *usize_at(vcounts, v) };
                if fc > 0 {
                    let ovf = unsafe { *typeid_ptr_at(orig_vfields, v) };
                    let nvf = unsafe {
                        let fcbytes = mul_usize(fc, size_of<TypeId>());
                        arena_alloc_raw(mut_view(ti.arena), fcbytes, align_of<TypeId>()) as *mut TypeId
                    };
                    let mut i: usize = 0;
                    while (i < fc) {
                        let of_v = unsafe { (*typeid_at(ovf, i)).v };
                        let of_ty = TypeId { v: of_v };
                        let nf = subst_type_with_vars(of_ty, args, mut_view(*tv), mut_view(*ti));
                        let nf_v = nf.v;
                        if nf_v != of_v {
                            changed = true;
                        }
                        unsafe {
                            (*typeid_at(nvf, i)).v = nf_v;
                        }
                        i = i + 1;
                    }
                    unsafe {
                        *typeid_ptr_at(new_vfields, v) = nvf;
                    }
                } else {
                    unsafe {
                        *typeid_ptr_at(new_vfields, v) = 0 as *mut TypeId;
                    }
                }
                v = v + 1;
            }
        }
        if !changed {
            return TypeId { v: res_v };
        }
        let t_cur = type_get(view(*ti), TypeId { v: res_v });
        let sp = ti.scratch;
        unsafe {
            copy_ax_type_into(mut_view(*sp), view(*t_cur));
            if (new_args as usize) != 0 {
                (*sp).args = new_args;
            }
            if (new_vfields as usize) != 0 {
                (*sp).variant_fields = new_vfields;
            }
        }
        return intern_type(mut_view(*ti), unsafe { view(*sp) });
    }
    TypeId { v: res_v }
}

pub fn subst_type(
    ty: TypeId,
    args: view<GenericArgsSlice>,
    ti: mut_view<TypeInterner>
) -> TypeId {
    let mut empty_tv = TypeVarTable {
        items: 0 as *mut TypeVarEntry,
        len: 0,
        cap: 0,
        fn_var_start: 0,
    };
    subst_type_with_vars(TypeId { v: ty.v }, args, mut_view(empty_tv), mut_view(*ti))
}

