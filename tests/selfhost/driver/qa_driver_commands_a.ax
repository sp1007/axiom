use compiler.mir.mir.mir_stmt_is_release_barrier
use compiler.mir.mir.mir_term_is_sync_barrier

const OPT_ALL_ONES_U64: u64 = 0xFFFFFFFFFFFFFFFFu64;
const OPT_SIGN64_U64: u64 = 0x8000000000000000u64;
const OPT_LOW32_U64: u64 = 0xFFFFFFFFu64;

// --- Type Metadata Helpers ---

pub fn opt_type_bits(thir: *const Thir, ty: TypeId) -> u32 {
    let ty_v = ty.v;
    if (thir as usize) != 0 {
        let types_ptr = unsafe { (*thir).interner.types };
        if (types_ptr as usize) != 0 {
            let t = unsafe { type_get(view((*thir).interner), TypeId { v: ty_v }) };
            if (t as usize) != 0 {
                let k = unsafe { (*t).kind };
                if k == TY_I8 || k == TY_U8 || k == TY_BOOL {
                    return 8u32;
                }
                if k == TY_I16 || k == TY_U16 {
                    return 16u32;
                }
                if k == TY_I32 || k == TY_U32 || k == TY_CHAR {
                    return 32u32;
                }
                if k == TY_I64 || k == TY_U64 || k == TY_ISIZE || k == TY_USIZE {
                    return 64u32;
                }
                return 0u32;
            }
        }
    }
    // Canonical builtin TypeId fallback when Thir is null or unpopulated:
    // 4=bool, 5=char, 6=i8, 7=i16, 8=i32, 9=i64, 10=isize, 11=u8, 12=u16, 13=u32, 14=u64, 15=usize
    if ty_v == 4u32 || ty_v == 6u32 || ty_v == 11u32 {
        return 8u32;
    }
    if ty_v == 7u32 || ty_v == 12u32 {
        return 16u32;
    }
    if ty_v == 5u32 || ty_v == 8u32 || ty_v == 13u32 {
        return 32u32;
    }
    if ty_v == 9u32 || ty_v == 10u32 || ty_v == 14u32 || ty_v == 15u32 {
        return 64u32;
    }
    0u32
}

pub fn opt_type_is_signed(thir: *const Thir, ty: TypeId) -> bool {
    let ty_v = ty.v;
    if (thir as usize) != 0 {
        let types_ptr = unsafe { (*thir).interner.types };
        if (types_ptr as usize) != 0 {
            let t = unsafe { type_get(view((*thir).interner), TypeId { v: ty_v }) };
            if (t as usize) != 0 {
                let k = unsafe { (*t).kind };
                return k == TY_I8 || k == TY_I16 || k == TY_I32 || k == TY_I64 || k == TY_ISIZE;
            }
        }
    }
    ty_v >= 6u32 && ty_v <= 10u32
}

pub fn opt_type_is_bool(thir: *const Thir, ty: TypeId) -> bool {
    let ty_v = ty.v;
    if (thir as usize) != 0 {
        let types_ptr = unsafe { (*thir).interner.types };
        if (types_ptr as usize) != 0 {
            let t = unsafe { type_get(view((*thir).interner), TypeId { v: ty_v }) };
            if (t as usize) != 0 {
                let k = unsafe { (*t).kind };
                return k == TY_BOOL;
            }
        }
    }
    ty_v == 4u32
}

pub fn opt_bool_type_id(thir: *const Thir) -> TypeId {
    if (thir as usize) != 0 {
        let bv = unsafe { (*thir).interner.t_bool.v };
        if bv != 0u32 {
            return TypeId { v: bv };
        }
    }
    TypeId { v: 4u32 }
}

// --- Trap-Free 64-Bit Two's-Complement Arithmetic Helpers ---

pub fn opt_bit_mask(bits: u32) -> u64 {
    if bits == 8u32 {
        0xFFu64
    } else if bits == 16u32 {
        0xFFFFu64
    } else if bits == 32u32 {
        0xFFFFFFFFu64
    } else {
        OPT_ALL_ONES_U64
    }
}

pub fn opt_sign_bit_mask(bits: u32) -> u64 {
    if bits == 8u32 {
        0x80u64
    } else if bits == 16u32 {
        0x8000u64
    } else if bits == 32u32 {
        0x80000000u64
    } else {
        OPT_SIGN64_U64
    }
}

pub fn opt_wrapping_add_u64(a: u64, b: u64) -> u64 {
    let a_lo = a & OPT_LOW32_U64;
    let a_hi = (a >> 32u64) & OPT_LOW32_U64;
    let b_lo = b & OPT_LOW32_U64;
    let b_hi = (b >> 32u64) & OPT_LOW32_U64;
    let sum_lo = a_lo + b_lo;
    let carry = (sum_lo >> 32u64) & 1u64;
    let sum_hi = (a_hi + b_hi + carry) & OPT_LOW32_U64;
    (sum_lo & OPT_LOW32_U64) | (sum_hi << 32u64)
}

pub fn opt_twos_complement_u64(x: u64) -> u64 {
    opt_wrapping_add_u64(x ^ OPT_ALL_ONES_U64, 1u64)
}

pub fn opt_sign_extend_u64(val: u64, bits: u32) -> u64 {
    let m = opt_bit_mask(bits);
    let v = val & m;
    if bits >= 64u32 {
        return v;
    }
    let sign_bit = opt_sign_bit_mask(bits);
    if (v & sign_bit) != 0u64 {
        v | (m ^ OPT_ALL_ONES_U64)
    } else {
        v
    }
}

pub fn opt_fits_signed_bits(val_tc: u64, bits: u32) -> bool {
    if bits >= 64u32 {
        return true;
    }
    opt_sign_extend_u64(val_tc, bits) == val_tc
}

pub fn opt_checked_add_u64(a: u64, b: u64, bits: u32, out: mut_view<u64>) -> bool {
    let m = opt_bit_mask(bits);
    let a_u = a & m;
    let b_u = b & m;
    let a_lo = a_u & OPT_LOW32_U64;
    let a_hi = (a_u >> 32u64) & OPT_LOW32_U64;
    let b_lo = b_u & OPT_LOW32_U64;
    let b_hi = (b_u >> 32u64) & OPT_LOW32_U64;
    let sum_lo = a_lo + b_lo;
    let carry = (sum_lo >> 32u64) & 1u64;
    let sum_hi_full = a_hi + b_hi + carry;
    let res = (sum_lo & OPT_LOW32_U64) | ((sum_hi_full & OPT_LOW32_U64) << 32u64);
    *out = res & m;
    if bits >= 64u32 {
        (sum_hi_full >> 32u64) != 0u64
    } else {
        (res & (m ^ OPT_ALL_ONES_U64)) != 0u64
    }
}

pub fn opt_checked_sub_u64(a: u64, b: u64, bits: u32, out: mut_view<u64>) -> bool {
    let m = opt_bit_mask(bits);
    let a_u = a & m;
    let b_u = b & m;
    if a_u < b_u {
        *out = 0u64;
        return true;
    }
    *out = (a_u - b_u) & m;
    false
}

pub fn opt_mul_u32_to_u64(x: u64, y: u64) -> u64 {
    let x32 = x & OPT_LOW32_U64;
    let y_lo = y & 0xFFFFu64;
    let y_hi = (y >> 16u64) & 0xFFFFu64;
    let lo_prod = ((x32 as i64) * (y_lo as i64)) as u64;
    let hi_prod = ((x32 as i64) * (y_hi as i64)) as u64;
    lo_prod + (hi_prod << 16u64)
}

pub fn opt_div_rem_u64(n: u64, d: u64, rem_out: mut_view<u64>) -> u64 {
    if d == 0u64 {
        *rem_out = 0u64;
        return 0u64;
    }
    if (d & OPT_SIGN64_U64) != 0u64 {
        if n >= d {
            *rem_out = n - d;
            return 1u64;
        } else {
            *rem_out = n;
            return 0u64;
        }
    }
    let mut q: u64 = 0u64;
    let mut r: u64 = 0u64;
    let mut i: u32 = 64u32;
    while i > 0u32 {
        i = i - 1u32;
        let bit = (n >> (i as u64)) & 1u64;
        r = (r << 1u64) | bit;
        if r >= d {
            r = r - d;
            q = q | (1u64 << (i as u64));
        }
    }
    *rem_out = r;
    q
}

pub fn opt_checked_mul_u64_raw(a: u64, b: u64, out: mut_view<u64>) -> bool {
    let a_lo = a & OPT_LOW32_U64;
    let a_hi = (a >> 32u64) & OPT_LOW32_U64;
    let b_lo = b & OPT_LOW32_U64;
    let b_hi = (b >> 32u64) & OPT_LOW32_U64;
    let p0 = opt_mul_u32_to_u64(a_lo, b_lo);
    let p1 = opt_mul_u32_to_u64(a_lo, b_hi);
    let p2 = opt_mul_u32_to_u64(a_hi, b_lo);
    let mid = (p0 >> 32u64) + (p1 & OPT_LOW32_U64) + (p2 & OPT_LOW32_U64);
    *out = (p0 & OPT_LOW32_U64) | ((mid & OPT_LOW32_U64) << 32u64);
    if a_hi != 0u64 && b_hi != 0u64 {
        return true;
    }
    if (p1 >> 32u64) != 0u64 || (p2 >> 32u64) != 0u64 {
        return true;
    }
    (mid >> 32u64) != 0u64
}

pub fn opt_checked_mul_u64(a: u64, b: u64, bits: u32, out: mut_view<u64>) -> bool {
    let m = opt_bit_mask(bits);
    let a_u = a & m;
    let b_u = b & m;
    let mut raw: u64 = 0u64;
    let ovf64 = opt_checked_mul_u64_raw(a_u, b_u, mut_view(raw));
    *out = raw & m;
    if bits >= 64u32 {
        ovf64
    } else {
        ovf64 || ((raw & (m ^ OPT_ALL_ONES_U64)) != 0u64)
    }
}

pub fn opt_checked_add_signed(a_tc: u64, b_tc: u64, bits: u32, out: mut_view<u64>) -> bool {
    let m = opt_bit_mask(bits);
    let res_tc = opt_wrapping_add_u64(a_tc, b_tc);
    let same_sign = ((a_tc ^ b_tc) & OPT_SIGN64_U64) == 0u64;
    let flipped_sign = ((a_tc ^ res_tc) & OPT_SIGN64_U64) != 0u64;
    let ovf64 = same_sign && flipped_sign;
    let ovf = ovf64 || !opt_fits_signed_bits(res_tc, bits);
    *out = res_tc & m;
    ovf
}

pub fn opt_checked_sub_signed(a_tc: u64, b_tc: u64, bits: u32, out: mut_view<u64>) -> bool {
    let m = opt_bit_mask(bits);
    let neg_b = opt_twos_complement_u64(b_tc);
    let res_tc = opt_wrapping_add_u64(a_tc, neg_b);
    let diff_sign = ((a_tc ^ b_tc) & OPT_SIGN64_U64) != 0u64;
    let flipped_sign = ((a_tc ^ res_tc) & OPT_SIGN64_U64) != 0u64;
    let ovf64 = diff_sign && flipped_sign;
    let ovf = ovf64 || !opt_fits_signed_bits(res_tc, bits);
    *out = res_tc & m;
    ovf
}

pub fn opt_checked_mul_signed(a_tc: u64, b_tc: u64, bits: u32, out: mut_view<u64>) -> bool {
    let m = opt_bit_mask(bits);
    let a_neg = (a_tc & OPT_SIGN64_U64) != 0u64;
    let b_neg = (b_tc & OPT_SIGN64_U64) != 0u64;
    let a_mag: u64 = if a_neg {
        opt_twos_complement_u64(a_tc)
    } else {
        a_tc
    };
    let b_mag: u64 = if b_neg {
        opt_twos_complement_u64(b_tc)
    } else {
        b_tc
    };
    if a_mag == 0u64 || b_mag == 0u64 {
        *out = 0u64;
        return false;
    }
    let mut mag_prod: u64 = 0u64;
    let mag_ovf = opt_checked_mul_u64_raw(a_mag, b_mag, mut_view(mag_prod));
    if mag_ovf {
        *out = 0u64;
        return true;
    }
    let res_neg = a_neg != b_neg;
    let mut res_tc: u64 = 0u64;
    if res_neg {
        if mag_prod > OPT_SIGN64_U64 {
            *out = 0u64;
            return true;
        }
        res_tc = opt_twos_complement_u64(mag_prod);
    } else {
        if mag_prod >= OPT_SIGN64_U64 {
            *out = 0u64;
            return true;
        }
        res_tc = mag_prod;
    }
    if !opt_fits_signed_bits(res_tc, bits) {
        *out = 0u64;
        return true;
    }
    *out = res_tc & m;
    false
}

pub fn opt_signed_lt(a_tc: u64, b_tc: u64) -> bool {
    (a_tc ^ OPT_SIGN64_U64) < (b_tc ^ OPT_SIGN64_U64)
}

pub fn opt_signed_le(a_tc: u64, b_tc: u64) -> bool {
    (a_tc ^ OPT_SIGN64_U64) <= (b_tc ^ OPT_SIGN64_U64)
}

pub fn opt_is_scalar_const_op(op: view<MirOperand>) -> bool {
    if op.kind != MIR_OP_CONST {
        return false;
    }
    op.constant.kind == MIR_CONST_INT || op.constant.kind == MIR_CONST_BOOL
}

// --- Binary & Unary Constant Folding ---

pub fn do_const_fold_binop(
    thir: *const Thir,
    op: u8,
    lhs: view<MirOperand>,
    rhs: view<MirOperand>,
    out_const: mut_view<MirConst>
) -> bool {
    if !opt_is_scalar_const_op(lhs) || !opt_is_scalar_const_op(rhs) {
        return false;
    }
    if lhs.constant.ty.v != rhs.constant.ty.v {
        return false;
    }

    let ty_v = lhs.constant.ty.v;
    let bits = opt_type_bits(thir, TypeId { v: ty_v });
    if bits == 0u32 || bits > 64u32 {
        return false;
    }
    let is_signed = opt_type_is_signed(thir, TypeId { v: ty_v });
    let mask = opt_bit_mask(bits);

    let a_val = lhs.constant.val;
    let b_val = rhs.constant.val;
    let a_tc = opt_sign_extend_u64(a_val, bits);
    let b_tc = opt_sign_extend_u64(b_val, bits);

    let mut res: u64 = 0u64;
    let mut overflow: bool = false;
    let mut res_ty_v: u32 = ty_v;

    if op == MIR_BINOP_ADD {
        if is_signed {
            overflow = opt_checked_add_signed(a_tc, b_tc, bits, mut_view(res));
        } else {
            overflow = opt_checked_add_u64(a_val, b_val, bits, mut_view(res));
        }
    } else if op == MIR_BINOP_SUB {
        if is_signed {
            overflow = opt_checked_sub_signed(a_tc, b_tc, bits, mut_view(res));
        } else {
            overflow = opt_checked_sub_u64(a_val, b_val, bits, mut_view(res));
        }
    } else if op == MIR_BINOP_MUL {
        if is_signed {
            overflow = opt_checked_mul_signed(a_tc, b_tc, bits, mut_view(res));
        } else {
            overflow = opt_checked_mul_u64(a_val, b_val, bits, mut_view(res));
        }
    } else if op == MIR_BINOP_DIV {
        if is_signed {
            let min_tc = opt_sign_extend_u64(opt_sign_bit_mask(bits), bits);
            if b_tc == 0u64 || (a_tc == min_tc && b_tc == OPT_ALL_ONES_U64) {
                overflow = true;
            } else {
                let a_neg = (a_tc & OPT_SIGN64_U64) != 0u64;
                let b_neg = (b_tc & OPT_SIGN64_U64) != 0u64;
                let a_mag: u64 = if a_neg { opt_twos_complement_u64(a_tc) } else { a_tc };
                let b_mag: u64 = if b_neg { opt_twos_complement_u64(b_tc) } else { b_tc };
                let mut rem_unused: u64 = 0u64;
                let q_mag = opt_div_rem_u64(a_mag, b_mag, mut_view(rem_unused));
                let q_tc: u64 = if (a_neg != b_neg) && q_mag != 0u64 {
                    opt_twos_complement_u64(q_mag)
                } else {
                    q_mag
                };
                res = q_tc & mask;
            }
        } else {
            let b_u = b_val & mask;
            if b_u == 0u64 {
                overflow = true;
            } else {
                let mut rem_unused: u64 = 0u64;
                let q_u = opt_div_rem_u64(a_val & mask, b_u, mut_view(rem_unused));
                res = q_u & mask;
            }
        }
    } else if op == MIR_BINOP_REM {
        if is_signed {
            let min_tc = opt_sign_extend_u64(opt_sign_bit_mask(bits), bits);
            if b_tc == 0u64 || (a_tc == min_tc && b_tc == OPT_ALL_ONES_U64) {
                overflow = true;
            } else {
                let a_neg = (a_tc & OPT_SIGN64_U64) != 0u64;
                let b_neg = (b_tc & OPT_SIGN64_U64) != 0u64;
                let a_mag: u64 = if a_neg { opt_twos_complement_u64(a_tc) } else { a_tc };
                let b_mag: u64 = if b_neg { opt_twos_complement_u64(b_tc) } else { b_tc };
                let mut r_mag: u64 = 0u64;
                let _q_unused = opt_div_rem_u64(a_mag, b_mag, mut_view(r_mag));
                let r_tc: u64 = if a_neg && r_mag != 0u64 {
                    opt_twos_complement_u64(r_mag)
                } else {
                    r_mag
                };
                res = r_tc & mask;
            }
        } else {
            let b_u = b_val & mask;
            if b_u == 0u64 {
                overflow = true;
            } else {
                let mut r_u: u64 = 0u64;
                let _q_unused = opt_div_rem_u64(a_val & mask, b_u, mut_view(r_u));
                res = r_u & mask;
            }
        }
    } else if op == MIR_BINOP_SHL {
        if b_val >= (bits as u64) {
            overflow = true;
        } else {
            res = ((a_val & mask) << b_val) & mask;
        }
    } else if op == MIR_BINOP_SHR {
        if b_val >= (bits as u64) {
            overflow = true;
        } else if is_signed {
            if b_val == 0u64 {
                res = a_tc & mask;
            } else {
                let shifted = a_tc >> b_val;
                if (a_tc & OPT_SIGN64_U64) != 0u64 {
                    let fill = OPT_ALL_ONES_U64 << (64u64 - b_val);
                    res = (shifted | fill) & mask;
                } else {
                    res = shifted & mask;
                }
            }
        } else {
            res = ((a_val & mask) >> b_val) & mask;
        }
    } else if op == MIR_BINOP_BIT_AND {
        res = (a_val & b_val) & mask;
    } else if op == MIR_BINOP_BIT_OR {
        res = (a_val | b_val) & mask;
    } else if op == MIR_BINOP_BIT_XOR {
        res = (a_val ^ b_val) & mask;
    } else if op == MIR_BINOP_EQ {
        res = if (a_val & mask) == (b_val & mask) { 1u64 } else { 0u64 };
        let bty = opt_bool_type_id(thir);
        res_ty_v = bty.v;
    } else if op == MIR_BINOP_NE {
        res = if (a_val & mask) != (b_val & mask) { 1u64 } else { 0u64 };
        let bty = opt_bool_type_id(thir);
        res_ty_v = bty.v;
    } else if op == MIR_BINOP_LT {
        let cmp: bool = if is_signed {
            opt_signed_lt(a_tc, b_tc)
        } else {
            (a_val & mask) < (b_val & mask)
        };
        res = if cmp { 1u64 } else { 0u64 };
        let bty = opt_bool_type_id(thir);
        res_ty_v = bty.v;
    } else if op == MIR_BINOP_LE {
        let cmp: bool = if is_signed {
            opt_signed_le(a_tc, b_tc)
        } else {
            (a_val & mask) <= (b_val & mask)
        };
        res = if cmp { 1u64 } else { 0u64 };
        let bty = opt_bool_type_id(thir);
        res_ty_v = bty.v;
    } else if op == MIR_BINOP_GT {
        let cmp: bool = if is_signed {
            opt_signed_lt(b_tc, a_tc)
        } else {
            (a_val & mask) > (b_val & mask)
        };
        res = if cmp { 1u64 } else { 0u64 };
        let bty = opt_bool_type_id(thir);
        res_ty_v = bty.v;
    } else if op == MIR_BINOP_GE {
        let cmp: bool = if is_signed {
            opt_signed_le(b_tc, a_tc)
        } else {
            (a_val & mask) >= (b_val & mask)
        };
        res = if cmp { 1u64 } else { 0u64 };
        let bty = opt_bool_type_id(thir);
        res_ty_v = bty.v;
    } else {
        return false;
    }

    if overflow {
        return false;
    }

    mir_const_reset_vals(mut_view(*out_const), MIR_CONST_INT, res_ty_v, res);
    true
}

pub fn do_const_fold_unop(
    thir: *const Thir,
    op: u8,
    operand: view<MirOperand>,
    out_const: mut_view<MirConst>
) -> bool {
    if !opt_is_scalar_const_op(operand) {
        return false;
    }

    let ty_v = operand.constant.ty.v;
    let bits = opt_type_bits(thir, TypeId { v: ty_v });
    if bits == 0u32 || bits > 64u32 {
        return false;
    }
    let is_signed = opt_type_is_signed(thir, TypeId { v: ty_v });
    let mask = opt_bit_mask(bits);
    let val = operand.constant.val;

    let mut res: u64 = 0u64;
    if op == MIR_UNOP_NOT {
        let is_b = opt_type_is_bool(thir, TypeId { v: ty_v });
        if !is_b {
            return false;
        }
        res = if val == 0u64 { 1u64 } else { 0u64 };
    } else if op == MIR_UNOP_BITNOT {
        res = (val ^ OPT_ALL_ONES_U64) & mask;
    } else if op == MIR_UNOP_NEG {
        if !is_signed {
            return false;
        }
        let s_tc = opt_sign_extend_u64(val, bits);
        let min_tc = opt_sign_extend_u64(opt_sign_bit_mask(bits), bits);
        if s_tc == min_tc {
            return false;
        }
        res = opt_twos_complement_u64(s_tc) & mask;
    } else {
        return false;
    }

    mir_const_reset_vals(mut_view(*out_const), MIR_CONST_INT, ty_v, res);
    true
}

pub fn opt_stmt_is_sync_barrier(stmt: view<MirStmt>) -> bool {
    mir_stmt_is_sync_barrier(stmt) || mir_stmt_is_acquire_barrier(stmt) || mir_stmt_is_release_barrier(stmt)
}

pub fn opt_term_is_sync_barrier(term: view<MirTerminator>) -> bool {
    mir_term_is_sync_barrier(term)
}

pub fn opt_const_fold(body: mut_view<MirBody>, thir: *const Thir) -> bool {
    if body.bb_count == 0 || (body.bbs as usize) == 0 {
        return false;
    }
    let bool_ty = opt_bool_type_id(thir);
    let mut total_changed: bool = false;
    let mut pass_changed: bool = true;
    let mut folded = MirConst {
        ty: TypeId { v: 0u32 },
        kind: MIR_CONST_INT,
        val: 0u64,
        str_bytes: 0 as *const u8,
        str_len: 0,
        sym: compiler.kernel.id.SymbolId { v: 0u32 },
    };
    let mut loc = Span {
        file: compiler.kernel.id.FileId { v: 0u32 },
        start: 0u32,
        end: 0u32,
    };

    while pass_changed {
        pass_changed = false;
        let mut i: usize = 0;
        while i < body.bb_count {
            let bb = unsafe { mir_bb_at(body.bbs, i) };
            let stmt_count = unsafe { (*bb).stmt_count };
            let stmts = unsafe { (*bb).stmts };
            let mut j: usize = 0;
            while j < stmt_count {
                let stmt = unsafe { mir_stmt_at(stmts, j) };
                let is_sync = unsafe { opt_stmt_is_sync_barrier(view(*stmt)) };
                let sk = unsafe { (*stmt).kind };
                if !is_sync && sk == MIR_STMT_ASSIGN {
                    let rv_kind = unsafe { (*stmt).rvalue.kind };
                    if rv_kind == MIR_RVALUE_BINARY_OP {
                        let orig_op = unsafe { (*stmt).rvalue.bin_op };
                        mir_const_reset_vals(mut_view(folded), MIR_CONST_INT, 0u32, 0u64);
                        let ok = unsafe {
                            do_const_fold_binop(
                                thir,
                                orig_op,
                                view((*stmt).rvalue.lhs),
                                view((*stmt).rvalue.rhs),
                                mut_view(folded)
                            )
                        };
                        if ok {
                            unsafe {
                                mir_span_copy(mut_view(loc), view((*stmt).rvalue.lhs.location));
                                mir_rvalue_reset(mut_view((*stmt).rvalue), MIR_RVALUE_USE);
                                (*stmt).rvalue.use_op.kind = MIR_OP_CONST;
                                mir_span_copy(mut_view((*stmt).rvalue.use_op.location), view(loc));
                                mir_copy_const(mut_view((*stmt).rvalue.use_op.constant), view(folded));
                            }
                            pass_changed = true;
                            total_changed = true;
                        }
                    } else if rv_kind == MIR_RVALUE_OVERFLOWS_BINARY_OP {
                        let orig_op = unsafe { (*stmt).rvalue.bin_op };
                        mir_const_reset_vals(mut_view(folded), MIR_CONST_INT, 0u32, 0u64);
                        let ok = unsafe {
                            do_const_fold_binop(
                                thir,
                                orig_op,
                                view((*stmt).rvalue.lhs),
                                view((*stmt).rvalue.rhs),
                                mut_view(folded)
                            )
                        };
                        if ok {
                            let mut dst_ty_v = bool_ty.v;
                            let dst_loc = unsafe { (*stmt).place.local.v as usize };
                            if (body.locals as usize) != 0 && dst_loc < body.local_count {
                                let l_ty = unsafe { (*mir_local_at(body.locals, dst_loc)).ty.v };
                                if l_ty != 0u32 {
                                    dst_ty_v = l_ty;
                                }
                            }
                            unsafe {
                                mir_span_copy(mut_view(loc), view((*stmt).rvalue.lhs.location));
                                mir_rvalue_reset(mut_view((*stmt).rvalue), MIR_RVALUE_USE);
                                (*stmt).rvalue.use_op.kind = MIR_OP_CONST;
                                mir_span_copy(mut_view((*stmt).rvalue.use_op.location), view(loc));
                                mir_const_reset_vals(
                                    mut_view((*stmt).rvalue.use_op.constant),
                                    MIR_CONST_INT,
                                    dst_ty_v,
                                    0u64
                                );
                            }
                            pass_changed = true;
                            total_changed = true;
                        }
                    } else if rv_kind == MIR_RVALUE_UNARY_OP {
                        let orig_unop = unsafe { (*stmt).rvalue.un_op };
                        mir_const_reset_vals(mut_view(folded), MIR_CONST_INT, 0u32, 0u64);
                        let ok = unsafe {
                            do_const_fold_unop(
                                thir,
                                orig_unop,
                                view((*stmt).rvalue.use_op),
                                mut_view(folded)
                            )
                        };
                        if ok {
                            unsafe {
                                mir_span_copy(mut_view(loc), view((*stmt).rvalue.use_op.location));
                                mir_rvalue_reset(mut_view((*stmt).rvalue), MIR_RVALUE_USE);
                                (*stmt).rvalue.use_op.kind = MIR_OP_CONST;
                                mir_span_copy(mut_view((*stmt).rvalue.use_op.location), view(loc));
                                mir_copy_const(mut_view((*stmt).rvalue.use_op.constant), view(folded));
                            }
                            pass_changed = true;
                            total_changed = true;
                        }
                    }
                }
                j = j + 1;
            }
            i = i + 1;
        }
    }

    total_changed
}

pub fn ax_opt_const_fold(body: mut_view<MirBody>, thir: *const Thir) -> bool {
    if (thir as usize) == 0 {
        return false;
    }
    opt_const_fold(body, thir)
}

// Axiom Compiler — MIR Dead Code Elimination Pass (compiler/opt/dce.ax)
// Port of iterative dead code elimination from bootstrap/axiom0/src/opt/opt.c (`-O1` pass 2).
//
// Iteratively counts local variable uses across all basic blocks (statements, projections,
// operands, and terminators) and removes:
//   - pure assignments (`MIR_STMT_ASSIGN`) to unprojected locals with 0 uses (excluding `_0`)
//   - `StorageLive` / `StorageDead` statements for locals with 0 uses
// Repeats until a fixed point is reached so transitive chains of dead temporaries are eliminated.
module compiler.opt.dce

use compiler.kernel.arena.Arena
use compiler.kernel.arena.arena_new
use compiler.kernel.arena.arena_destroy
use compiler.kernel.arena.arena_alloc_raw

use compiler.mir.mir.MirBody
use compiler.mir.mir.MirOperand
use compiler.mir.mir.MirPlace
use compiler.mir.mir.MirRvalue
use compiler.mir.mir.MirStmt
use compiler.mir.mir.MirTerminator
use compiler.mir.mir.MIR_OP_COPY
use compiler.mir.mir.MIR_OP_MOVE
use compiler.mir.mir.MIR_PROJ_DEREF
use compiler.mir.mir.MIR_PROJ_INDEX
use compiler.mir.mir.MIR_PROJ_SUB_SLICE
use compiler.mir.mir.MIR_RVALUE_USE
use compiler.mir.mir.MIR_RVALUE_REPEAT
use compiler.mir.mir.MIR_RVALUE_REF
use compiler.mir.mir.MIR_RVALUE_LEN
use compiler.mir.mir.MIR_RVALUE_CAST
use compiler.mir.mir.MIR_RVALUE_OVERFLOWS_BINARY_OP
use compiler.mir.mir.MIR_RVALUE_BINARY_OP
use compiler.mir.mir.MIR_RVALUE_UNARY_OP
use compiler.mir.mir.MIR_RVALUE_DISCRIMINANT
use compiler.mir.mir.MIR_RVALUE_AGGREGATE
use compiler.mir.mir.MIR_STMT_ASSIGN
use compiler.mir.mir.MIR_STMT_STORAGE_LIVE
use compiler.mir.mir.MIR_STMT_STORAGE_DEAD
use compiler.mir.mir.MIR_STMT_DROP
use compiler.mir.mir.MIR_STMT_ATOMIC
use compiler.mir.mir.MIR_ATOMIC_STORE
use compiler.mir.mir.MIR_ATOMIC_CMPXCHG
use compiler.mir.mir.MIR_ATOMIC_CMPXCHG_WEAK
use compiler.mir.mir.MIR_TERM_SWITCH_INT
use compiler.mir.mir.MIR_TERM_DROP
use compiler.mir.mir.MIR_TERM_CALL
use compiler.mir.mir.MIR_TERM_ASSERT
use compiler.mir.mir.MIR_TERM_UNREACHABLE
use compiler.mir.mir.mir_mul_usize
use compiler.mir.mir.mir_bb_at
use compiler.mir.mir.mir_stmt_at
use compiler.mir.mir.mir_proj_at
use compiler.mir.mir.mir_op_at
use compiler.mir.mir.mir_copy_stmt
use compiler.mir.mir.mir_stmt_is_sync_barrier
use compiler.mir.mir.mir_term_is_sync_barrier

@intrinsic fn size_of<T>() -> usize { 0 }

unsafe fn opt_u32_at(base: *mut u32, idx: usize) -> *mut u32 {
    let off = mir_mul_usize(idx, size_of<u32>());
    ((base as usize) + off) as *mut u32
}

unsafe fn opt_inc_use(uses: *mut u32, local_v: u32, max_locals: usize) {
    let idx = local_v as usize;
    if idx < max_locals {
        let slot = opt_u32_at(uses, idx);
        let cur = *slot;
        *slot = cur + 1u32;
    }
}

pub fn opt_count_place_uses(p: view<MirPlace>, uses: *mut u32, max_locals: usize) {
    if p.proj_count == 0 || (p.projs as usize) == 0 {
        return;
    }
    let mut i: usize = 0;
    while i < p.proj_count {
        let proj = unsafe { mir_proj_at(p.projs, i) };
        let pk = unsafe { (*proj).kind };
        if pk == MIR_PROJ_INDEX {
            let idx_v = unsafe { (*proj).index_local.v };
            unsafe { opt_inc_use(uses, idx_v, max_locals) };
        } else if pk == MIR_PROJ_SUB_SLICE {
            let has_from = unsafe { (*proj).has_from };
            if has_from {
                let fl = unsafe { (*proj).from_local.v };
                unsafe { opt_inc_use(uses, fl, max_locals) };
            }
            let has_to = unsafe { (*proj).has_to };
            if has_to {
                let tl = unsafe { (*proj).to_local.v };
                unsafe { opt_inc_use(uses, tl, max_locals) };
            }
        }
        i = i + 1;
    }
}

pub fn opt_count_place_full_use(p: view<MirPlace>, uses: *mut u32, max_locals: usize) {
    unsafe { opt_inc_use(uses, p.local.v, max_locals) };
    opt_count_place_uses(p, uses, max_locals);
}

pub fn opt_count_operand_uses(op: view<MirOperand>, uses: *mut u32, max_locals: usize) {
    if op.kind == MIR_OP_COPY || op.kind == MIR_OP_MOVE {
        opt_count_place_full_use(view(op.place), uses, max_locals);
    }
}

pub fn opt_count_rvalue_uses(rv: view<MirRvalue>, uses: *mut u32, max_locals: usize) {
    let k = rv.kind;
    if k == MIR_RVALUE_USE || k == MIR_RVALUE_UNARY_OP || k == MIR_RVALUE_CAST {
        opt_count_operand_uses(view(rv.use_op), uses, max_locals);
    } else if k == MIR_RVALUE_REPEAT {
        opt_count_operand_uses(view(rv.use_op), uses, max_locals);
        if (rv.repeat_count_op as usize) != 0 {
            unsafe { opt_count_operand_uses(view(*rv.repeat_count_op), uses, max_locals) };
        }
    } else if k == MIR_RVALUE_REF || k == MIR_RVALUE_LEN || k == MIR_RVALUE_DISCRIMINANT {
        opt_count_place_full_use(view(rv.place), uses, max_locals);
    } else if k == MIR_RVALUE_BINARY_OP || k == MIR_RVALUE_OVERFLOWS_BINARY_OP {
        opt_count_operand_uses(view(rv.lhs), uses, max_locals);
        opt_count_operand_uses(view(rv.rhs), uses, max_locals);
    } else if k == MIR_RVALUE_AGGREGATE {
        if rv.operand_count > 0 && (rv.operands as usize) != 0 {
            let mut i: usize = 0;
            while i < rv.operand_count {
                let op_ptr = unsafe { mir_op_at(rv.operands, i) };
                unsafe { opt_count_operand_uses(view(*op_ptr), uses, max_locals) };
                i = i + 1;
            }
        }
    }
}

pub fn opt_rvalue_is_pure(rv: view<MirRvalue>) -> bool {
    let k = rv.kind;
    k == MIR_RVALUE_USE ||
    k == MIR_RVALUE_REF ||
    k == MIR_RVALUE_LEN ||
    k == MIR_RVALUE_CAST ||
    k == MIR_RVALUE_DISCRIMINANT ||
    k == MIR_RVALUE_AGGREGATE
}

pub fn opt_place_has_deref(p: view<MirPlace>) -> bool {
    if p.proj_count == 0 || (p.projs as usize) == 0 {
        return false;
    }
    let mut i: usize = 0;
    while i < p.proj_count {
        let proj = unsafe { mir_proj_at(p.projs, i) };
        if (unsafe { (*proj).kind }) == MIR_PROJ_DEREF {
            return true;
        }
        i = i + 1;
    }
    false
}

pub fn opt_operand_reads_deref(op: view<MirOperand>) -> bool {
    if op.kind == MIR_OP_COPY || op.kind == MIR_OP_MOVE {
        return opt_place_has_deref(view(op.place));
    }
    false
}

pub fn opt_rvalue_reads_deref(rv: view<MirRvalue>) -> bool {
    let k = rv.kind;
    if k == MIR_RVALUE_USE || k == MIR_RVALUE_UNARY_OP || k == MIR_RVALUE_CAST {
        return opt_operand_reads_deref(view(rv.use_op));
    }
    if k == MIR_RVALUE_REPEAT {
        if opt_operand_reads_deref(view(rv.use_op)) {
            return true;
        }
        if (rv.repeat_count_op as usize) != 0 {
            return unsafe { opt_operand_reads_deref(view(*rv.repeat_count_op)) };
        }
        return false;
    }
    if k == MIR_RVALUE_LEN || k == MIR_RVALUE_DISCRIMINANT {
        return opt_place_has_deref(view(rv.place));
    }
    if k == MIR_RVALUE_BINARY_OP || k == MIR_RVALUE_OVERFLOWS_BINARY_OP {
        return opt_operand_reads_deref(view(rv.lhs)) || opt_operand_reads_deref(view(rv.rhs));
    }
    if k == MIR_RVALUE_AGGREGATE {
        if rv.operand_count > 0 && (rv.operands as usize) != 0 {
            let mut i: usize = 0;
            while i < rv.operand_count {
                let op_ptr = unsafe { mir_op_at(rv.operands, i) };
                if unsafe { opt_operand_reads_deref(view(*op_ptr)) } {
                    return true;
                }
                i = i + 1;
            }
        }
    }
    false
}

pub fn opt_body_has_atomic_sync(body: view<MirBody>) -> bool {
    if body.bb_count == 0 || (body.bbs as usize) == 0 {
        return false;
    }
    let mut i: usize = 0;
    while i < body.bb_count {
        let bb = unsafe { mir_bb_at(body.bbs, i) };
        let is_unreach = unsafe { (*bb).has_terminator && (*bb).terminator.kind == MIR_TERM_UNREACHABLE };
        if !is_unreach {
            let stmt_count = unsafe { (*bb).stmt_count };
            let stmts = unsafe { (*bb).stmts };
            let mut j: usize = 0;
            while j < stmt_count {
                let stmt = unsafe { mir_stmt_at(stmts, j) };
                if unsafe { mir_stmt_is_sync_barrier(view(*stmt)) } {
                    return true;
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    false
}

pub fn opt_dce_in_arena(body: mut_view<MirBody>, scratch: mut_view<Arena>) -> bool {
    let max_locals = body.local_count;
    if max_locals == 0 || body.bb_count == 0 || (body.bbs as usize) == 0 {
        return false;
    }

    let has_atomic_sync = opt_body_has_atomic_sync(view(*body));
    let uses_bytes = mir_mul_usize(max_locals, size_of<u32>());
    let uses = arena_alloc_raw(mut_view(*scratch), uses_bytes, 4) as *mut u32;
    let mut total_changed: bool = false;
    let mut pass_changed: bool = true;

    while pass_changed {
        pass_changed = false;

        let mut u_idx: usize = 0;
        while u_idx < max_locals {
            let slot = unsafe { opt_u32_at(uses, u_idx) };
            unsafe { *slot = 0u32 };
            u_idx = u_idx + 1;
        }
        // Return place `_0` is always live
        unsafe { *opt_u32_at(uses, 0) = 1u32 };

        let mut i: usize = 0;
        while i < body.bb_count {
            let bb = unsafe { mir_bb_at(body.bbs, i) };
            let is_unreach = unsafe { (*bb).has_terminator && (*bb).terminator.kind == MIR_TERM_UNREACHABLE };
            if !is_unreach {
                let stmt_count = unsafe { (*bb).stmt_count };
                let stmts = unsafe { (*bb).stmts };
                let mut j: usize = 0;
                while j < stmt_count {
                    let stmt = unsafe { mir_stmt_at(stmts, j) };
                    let sk = unsafe { (*stmt).kind };
                    if sk == MIR_STMT_ASSIGN {
                        let p_cnt = unsafe { (*stmt).place.proj_count };
                        if p_cnt > 0 {
                            unsafe { opt_count_place_full_use(view((*stmt).place), uses, max_locals) };
                        } else {
                            unsafe { opt_count_place_uses(view((*stmt).place), uses, max_locals) };
                        }
                        unsafe { opt_count_rvalue_uses(view((*stmt).rvalue), uses, max_locals) };
                    } else if sk == MIR_STMT_DROP {
                        unsafe { opt_count_place_full_use(view((*stmt).place), uses, max_locals) };
                    } else if sk == MIR_STMT_ATOMIC {
                        let aop = unsafe { (*stmt).rvalue.bin_op };
                        if aop <= MIR_ATOMIC_CMPXCHG_WEAK && aop != MIR_ATOMIC_STORE {
                            unsafe { opt_count_place_full_use(view((*stmt).place), uses, max_locals) };
                        }
                        if aop <= MIR_ATOMIC_CMPXCHG_WEAK {
                            unsafe { opt_count_operand_uses(view((*stmt).rvalue.use_op), uses, max_locals) };
                        }
                        if aop >= MIR_ATOMIC_STORE && aop <= MIR_ATOMIC_CMPXCHG_WEAK {
                            unsafe { opt_count_operand_uses(view((*stmt).rvalue.lhs), uses, max_locals) };
                        }
                        if aop == MIR_ATOMIC_CMPXCHG || aop == MIR_ATOMIC_CMPXCHG_WEAK {
                            unsafe { opt_count_operand_uses(view((*stmt).rvalue.rhs), uses, max_locals) };
                        }
                    }
                    j = j + 1;
                }

                let has_term = unsafe { (*bb).has_terminator };
                if has_term {
                    let tk = unsafe { (*bb).terminator.kind };
                    if tk == MIR_TERM_SWITCH_INT {
                        unsafe { opt_count_operand_uses(view((*bb).terminator.discr), uses, max_locals) };
                    } else if tk == MIR_TERM_DROP {
                        unsafe { opt_count_place_full_use(view((*bb).terminator.drop_place), uses, max_locals) };
                    } else if tk == MIR_TERM_CALL {
                        unsafe { opt_count_operand_uses(view((*bb).terminator.func), uses, max_locals) };
                        let argc = unsafe { (*bb).terminator.arg_count };
                        let args = unsafe { (*bb).terminator.args };
                        if argc > 0 && (args as usize) != 0 {
                            let mut k: usize = 0;
                            while k < argc {
                                let arg_ptr = unsafe { mir_op_at(args, k) };
                                unsafe { opt_count_operand_uses(view(*arg_ptr), uses, max_locals) };
                                k = k + 1;
                            }
                        }
                        let has_dest = unsafe { (*bb).terminator.has_destination };
                        if has_dest {
                            let d_projs = unsafe { (*bb).terminator.destination.proj_count };
                            if d_projs > 0 {
                                unsafe { opt_count_place_full_use(view((*bb).terminator.destination), uses, max_locals) };
                            } else {
                                unsafe { opt_count_place_uses(view((*bb).terminator.destination), uses, max_locals) };
                            }
                        }
                    } else if tk == MIR_TERM_ASSERT {
                        unsafe { opt_count_operand_uses(view((*bb).terminator.cond), uses, max_locals) };
                    }
                }
            }
            i = i + 1;
        }

        // Remove dead statements in each reachable basic block
        i = 0;
        while i < body.bb_count {
            let bb = unsafe { mir_bb_at(body.bbs, i) };
            let is_unreach = unsafe { (*bb).has_terminator && (*bb).terminator.kind == MIR_TERM_UNREACHABLE };
            if !is_unreach {
                let stmt_count = unsafe { (*bb).stmt_count };
                let stmts = unsafe { (*bb).stmts };
                let mut write_idx: usize = 0;
                let mut j: usize = 0;
                while j < stmt_count {
                    let stmt = unsafe { mir_stmt_at(stmts, j) };
                    let is_sync = unsafe { mir_stmt_is_sync_barrier(view(*stmt)) };
                    let sk = unsafe { (*stmt).kind };
                    let mut remove: bool = false;
                    if !is_sync && sk == MIR_STMT_ASSIGN {
                        let p_cnt = unsafe { (*stmt).place.proj_count };
                        if p_cnt == 0 {
                            let lv = unsafe { (*stmt).place.local.v as usize };
                            if lv < max_locals {
                                let u_cnt = unsafe { *opt_u32_at(uses, lv) };
                                if u_cnt == 0u32 {
                                    let is_pure = unsafe { opt_rvalue_is_pure(view((*stmt).rvalue)) };
                                    let reads_deref_sync = has_atomic_sync && unsafe { opt_rvalue_reads_deref(view((*stmt).rvalue)) };
                                    if is_pure && !reads_deref_sync {
                                        remove = true;
                                    }
                                }
                            }
                        }
                    } else if !is_sync && (sk == MIR_STMT_STORAGE_LIVE || sk == MIR_STMT_STORAGE_DEAD) {
                        let lv = unsafe { (*stmt).storage_local.v as usize };
                        if lv < max_locals {
                            let u_cnt = unsafe { *opt_u32_at(uses, lv) };
                            if u_cnt == 0u32 {
                                remove = true;
                            }
                        }
                    }

                    if !remove {
                        if write_idx != j {
                            let dst_stmt = unsafe { mir_stmt_at(stmts, write_idx) };
                            unsafe { mir_copy_stmt(mut_view(*dst_stmt), view(*stmt)) };
                        }
                        write_idx = write_idx + 1;
                    } else {
                        pass_changed = true;
                        total_changed = true;
                    }
                    j = j + 1;
                }
                unsafe { (*bb).stmt_count = write_idx };
            }
            i = i + 1;
        }
    }

    total_changed
}

pub fn opt_dce(body: mut_view<MirBody>) -> bool {
    let max_locals = body.local_count;
    if max_locals == 0 || body.bb_count == 0 || (body.bbs as usize) == 0 {
        return false;
    }
    let mut scratch = arena_new();
    let total_changed = opt_dce_in_arena(body, mut_view(scratch));
    arena_destroy(mut_view(scratch));
    total_changed
}

pub fn ax_opt_dce(body: mut_view<MirBody>) -> bool {
    opt_dce(body)
}

// Axiom Compiler — MIR Control-Flow Graph Simplification Pass (compiler/opt/cfg_simp.ax)
// Port of CFG simplification from bootstrap/axiom0/src/opt/opt.c (`-O1` pass 3), plus
// redundant conditional jump elimination and single-predecessor linear block merging.
//
// Provides:
//   - `opt_cfg_fold_const_switches`: folds `SwitchInt` with a constant discriminant into `Goto`
//   - `opt_cfg_eliminate_redundant_switches`: folds constant `SwitchInt` and `SwitchInt` whose
//     arm targets all equal `otherwise` into `Goto`
//   - `opt_cfg_mark_unreachable`: computes forward reachability from `bb0` and replaces
//     unreachable blocks with empty `unreachable` blocks
//   - `opt_cfg_merge_linear_blocks`: merges `bbA -> goto bbB` chains when `bbB` (`!= bb0`) has
//     `bbA` as its sole predecessor and matching cleanup status
//   - `opt_cfg_simplify` / `ax_opt_cfg_simplify`: standard `-O1` CFG pass matching `axiom0`
//   - `opt_cfg_simplify_with_merge`: full fixed-point CFG simplification including block merging
module compiler.opt.cfg_simp

use compiler.kernel.arena.Arena
use compiler.kernel.arena.arena_new
use compiler.kernel.arena.arena_destroy
use compiler.kernel.arena.arena_alloc_raw
use compiler.source.span.Span
use compiler.mir.mir.MirBb
use compiler.mir.mir.MirBbId
use compiler.mir.mir.MirBody
use compiler.mir.mir.MIR_BB_NONE
use compiler.mir.mir.MIR_CONST_INT
use compiler.mir.mir.MIR_CONST_BOOL
use compiler.mir.mir.MIR_OP_CONST
use compiler.mir.mir.MIR_TERM_GOTO
use compiler.mir.mir.MIR_TERM_SWITCH_INT
use compiler.mir.mir.MIR_TERM_UNREACHABLE
use compiler.mir.mir.MIR_TERM_DROP
use compiler.mir.mir.MIR_TERM_CALL
use compiler.mir.mir.MIR_TERM_ASSERT
use compiler.mir.mir.mir_mul_usize
use compiler.mir.mir.mir_bb_at
use compiler.mir.mir.mir_bb_id_at
use compiler.mir.mir.mir_u64_at
use compiler.mir.mir.mir_stmt_at
use compiler.mir.mir.mir_span_copy
use compiler.mir.mir.mir_term_reset
use compiler.mir.mir.mir_copy_terminator
use compiler.mir.mir.mir_bb_push_stmt
use compiler.mir.mir.mir_stmt_is_sync_barrier
use compiler.mir.mir.mir_term_is_sync_barrier
use compiler.mir.mir.mir_bb_has_sync_barrier

@intrinsic fn size_of<T>() -> usize { 0 }

unsafe fn opt_u8_at(base: *mut u8, idx: usize) -> *mut u8 {
    ((base as usize) + idx) as *mut u8
}

unsafe fn opt_u32_at(base: *mut u32, idx: usize) -> *mut u32 {
    let off = mir_mul_usize(idx, size_of<u32>());
    ((base as usize) + off) as *mut u32
}

fn opt_zero_span() -> Span {
    Span {
        file: compiler.kernel.id.FileId { v: 0u32 },
        start: 0u32,
        end: 0u32,
    }
}

fn opt_is_valid_unwind(unwind_v: u32, bb_count: usize) -> bool {
    unwind_v != 0u32 && unwind_v != MIR_BB_NONE && (unwind_v as usize) < bb_count
}

unsafe fn opt_mark_bb_reachable(reachable: *mut u8, target_v: u32, bb_count: usize) -> bool {
    let idx = target_v as usize;
    if idx < bb_count {
        let slot = opt_u8_at(reachable, idx);
        if *slot == 0u8 {
            *slot = 1u8;
            return true;
        }
    }
    false
}

unsafe fn opt_inc_pred(preds: *mut u32, target_v: u32, bb_count: usize) {
    let idx = target_v as usize;
    if idx < bb_count {
        let slot = opt_u32_at(preds, idx);
        let cur = *slot;
        *slot = cur + 1u32;
    }
}

// Computes basic block reachability from `bb0` into `reachable[0..bb_count]`.
pub fn opt_cfg_compute_reachable(body: view<MirBody>, reachable: *mut u8) {
    let bb_count = body.bb_count;
    if bb_count == 0 || (body.bbs as usize) == 0 {
        return;
    }

    let mut i: usize = 0;
    while i < bb_count {
        let slot = unsafe { opt_u8_at(reachable, i) };
        unsafe { *slot = 0u8 };
        i = i + 1;
    }
    unsafe { *opt_u8_at(reachable, 0) = 1u8 };

    let mut r_changed: bool = true;
    while r_changed {
        r_changed = false;
        i = 0;
        while i < bb_count {
            let is_reach = unsafe { *opt_u8_at(reachable, i) != 0u8 };
            if is_reach {
                let bb = unsafe { mir_bb_at(body.bbs, i) };
                let has_term = unsafe { (*bb).has_terminator };
                if has_term {
                    let tk = unsafe { (*bb).terminator.kind };
                    if tk == MIR_TERM_GOTO {
                        let gt_v = unsafe { (*bb).terminator.goto_target.v };
                        if unsafe { opt_mark_bb_reachable(reachable, gt_v, bb_count) } {
                            r_changed = true;
                        }
                    } else if tk == MIR_TERM_SWITCH_INT {
                        let sc = unsafe { (*bb).terminator.switch_count };
                        let targets = unsafe { (*bb).terminator.targets };
                        if sc > 0 && (targets as usize) != 0 {
                            let mut j: usize = 0;
                            while j < sc {
                                let tgt_v = unsafe { (*mir_bb_id_at(targets, j)).v };
                                if unsafe { opt_mark_bb_reachable(reachable, tgt_v, bb_count) } {
                                    r_changed = true;
                                }
                                j = j + 1;
                            }
                        }
                        let ow_v = unsafe { (*bb).terminator.otherwise.v };
                        if unsafe { opt_mark_bb_reachable(reachable, ow_v, bb_count) } {
                            r_changed = true;
                        }
                    } else if tk == MIR_TERM_DROP {
                        let dt_v = unsafe { (*bb).terminator.drop_target.v };
                        if unsafe { opt_mark_bb_reachable(reachable, dt_v, bb_count) } {
                            r_changed = true;
                        }
                        let du_v = unsafe { (*bb).terminator.drop_unwind.v };
                        if opt_is_valid_unwind(du_v, bb_count) {
                            if unsafe { opt_mark_bb_reachable(reachable, du_v, bb_count) } {
                                r_changed = true;
                            }
                        }
                    } else if tk == MIR_TERM_CALL {
                        let ct_v = unsafe { (*bb).terminator.call_target.v };
                        if unsafe { opt_mark_bb_reachable(reachable, ct_v, bb_count) } {
                            r_changed = true;
                        }
                        let cu_v = unsafe { (*bb).terminator.call_unwind.v };
                        if opt_is_valid_unwind(cu_v, bb_count) {
                            if unsafe { opt_mark_bb_reachable(reachable, cu_v, bb_count) } {
                                r_changed = true;
                            }
                        }
                    } else if tk == MIR_TERM_ASSERT {
                        let at_v = unsafe { (*bb).terminator.assert_target.v };
                        if unsafe { opt_mark_bb_reachable(reachable, at_v, bb_count) } {
                            r_changed = true;
                        }
                        let au_v = unsafe { (*bb).terminator.assert_unwind.v };
                        if opt_is_valid_unwind(au_v, bb_count) {
                            if unsafe { opt_mark_bb_reachable(reachable, au_v, bb_count) } {
                                r_changed = true;
                            }
                        }
                    }
                }
            }
            i = i + 1;
        }
    }
}

// Folds `SwitchInt` terminators with constant integer/bool discriminants into `Goto`.
pub fn opt_cfg_fold_const_switches(body: mut_view<MirBody>) -> bool {
    if body.bb_count == 0 || (body.bbs as usize) == 0 {
        return false;
    }
    let mut changed: bool = false;
    let mut i: usize = 0;
    while i < body.bb_count {
        let bb = unsafe { mir_bb_at(body.bbs, i) };
        let has_term = unsafe { (*bb).has_terminator };
        if has_term {
            let tk = unsafe { (*bb).terminator.kind };
            if tk == MIR_TERM_SWITCH_INT {
                let dk = unsafe { (*bb).terminator.discr.kind };
                let ck = unsafe { (*bb).terminator.discr.constant.kind };
                if dk == MIR_OP_CONST && (ck == MIR_CONST_INT || ck == MIR_CONST_BOOL) {
                    let val = unsafe { (*bb).terminator.discr.constant.val };
                    let mut target_v = unsafe { (*bb).terminator.otherwise.v };
                    let sc = unsafe { (*bb).terminator.switch_count };
                    let values = unsafe { (*bb).terminator.values };
                    let targets = unsafe { (*bb).terminator.targets };
                    if sc > 0 && (values as usize) != 0 && (targets as usize) != 0 {
                        let mut j: usize = 0;
                        while j < sc {
                            let arm_val = unsafe { *mir_u64_at(values, j) };
                            if arm_val == val {
                                target_v = unsafe { (*mir_bb_id_at(targets, j)).v };
                                break;
                            }
                            j = j + 1;
                        }
                    }
                    let mut loc = opt_zero_span();
                    unsafe {
                        mir_span_copy(mut_view(loc), view((*bb).terminator.location));
                        mir_term_reset(mut_view((*bb).terminator), MIR_TERM_GOTO, view(loc));
                        (*bb).terminator.goto_target.v = target_v;
                    }
                    changed = true;
                }
            }
        }
        i = i + 1;
    }
    changed
}

// Eliminates both constant-discriminant `SwitchInt` and redundant `SwitchInt` where all arm
// targets equal `otherwise`.
pub fn opt_cfg_eliminate_redundant_switches(body: mut_view<MirBody>) -> bool {
    if body.bb_count == 0 || (body.bbs as usize) == 0 {
        return false;
    }
    let mut changed = opt_cfg_fold_const_switches(mut_view(*body));
    let mut i: usize = 0;
    while i < body.bb_count {
        let bb = unsafe { mir_bb_at(body.bbs, i) };
        let has_term = unsafe { (*bb).has_terminator };
        if has_term {
            let tk = unsafe { (*bb).terminator.kind };
            if tk == MIR_TERM_SWITCH_INT {
                let ow_v = unsafe { (*bb).terminator.otherwise.v };
                let sc = unsafe { (*bb).terminator.switch_count };
                let targets = unsafe { (*bb).terminator.targets };
                let mut all_same: bool = true;
                if sc > 0 && (targets as usize) != 0 {
                    let mut j: usize = 0;
                    while j < sc {
                        let tgt_v = unsafe { (*mir_bb_id_at(targets, j)).v };
                        if tgt_v != ow_v {
                            all_same = false;
                            break;
                        }
                        j = j + 1;
                    }
                }
                if all_same {
                    let mut loc = opt_zero_span();
                    unsafe {
                        mir_span_copy(mut_view(loc), view((*bb).terminator.location));
                        mir_term_reset(mut_view((*bb).terminator), MIR_TERM_GOTO, view(loc));
                        (*bb).terminator.goto_target.v = ow_v;
                    }
                    changed = true;
                }
            }
        }
        i = i + 1;
    }
    changed
}

// Clears statements in unreachable blocks and sets their terminator to `MIR_TERM_UNREACHABLE`.
pub fn opt_cfg_mark_unreachable_in_arena(body: mut_view<MirBody>, scratch: mut_view<Arena>) -> bool {
    let bb_count = body.bb_count;
    if bb_count == 0 || (body.bbs as usize) == 0 {
        return false;
    }

    let reachable = arena_alloc_raw(mut_view(*scratch), bb_count, 1);
    opt_cfg_compute_reachable(view(*body), reachable);

    let mut changed: bool = false;
    let mut i: usize = 0;
    while i < bb_count {
        let is_reach = unsafe { *opt_u8_at(reachable, i) != 0u8 };
        if !is_reach {
            let bb = unsafe { mir_bb_at(body.bbs, i) };
            let stmt_cnt = unsafe { (*bb).stmt_count };
            let has_term = unsafe { (*bb).has_terminator };
            let term_kind = unsafe { (*bb).terminator.kind };
            if stmt_cnt > 0 || (has_term && term_kind != MIR_TERM_UNREACHABLE) {
                let mut loc = opt_zero_span();
                unsafe {
                    mir_span_copy(mut_view(loc), view((*bb).terminator.location));
                    (*bb).stmt_count = 0;
                    (*bb).has_terminator = true;
                    mir_term_reset(mut_view((*bb).terminator), MIR_TERM_UNREACHABLE, view(loc));
                }
                changed = true;
            }
        }
        i = i + 1;
    }

    changed
}

pub fn opt_cfg_mark_unreachable(body: mut_view<MirBody>) -> bool {
    let bb_count = body.bb_count;
    if bb_count == 0 || (body.bbs as usize) == 0 {
        return false;
    }
    let mut scratch = arena_new();
    let changed = opt_cfg_mark_unreachable_in_arena(body, mut_view(scratch));
    arena_destroy(mut_view(scratch));
    changed
}

pub fn opt_cfg_bb_has_sync_barrier(bb: view<MirBb>) -> bool {
    mir_bb_has_sync_barrier(bb)
}

// Merges linear `bbA -> goto bbB` chains when `bbB` (`!= bb0`) has `bbA` as its sole
// predecessor among reachable blocks and identical `is_cleanup` flag, preserving
// `Sequenced-Before` statement and synchronization barrier order.
pub fn opt_cfg_merge_linear_blocks(body: mut_view<MirBody>, arena: mut_view<Arena>) -> bool {
    let bb_count = body.bb_count;
    if bb_count <= 1 || (body.bbs as usize) == 0 {
        return false;
    }

    let reachable = arena_alloc_raw(mut_view(*arena), bb_count, 1);
    let preds_bytes = mir_mul_usize(bb_count, size_of<u32>());
    let preds = arena_alloc_raw(mut_view(*arena), preds_bytes, 4) as *mut u32;
    let mut total_changed: bool = false;
    let mut pass_changed: bool = true;

    while pass_changed {
        pass_changed = false;
        opt_cfg_compute_reachable(view(*body), reachable);

        let mut i: usize = 0;
        while i < bb_count {
            let slot = unsafe { opt_u32_at(preds, i) };
            unsafe { *slot = 0u32 };
            i = i + 1;
        }

        i = 0;
        while i < bb_count {
            let is_reach = unsafe { *opt_u8_at(reachable, i) != 0u8 };
            if is_reach {
                let bb = unsafe { mir_bb_at(body.bbs, i) };
                let has_term = unsafe { (*bb).has_terminator };
                if has_term {
                    let tk = unsafe { (*bb).terminator.kind };
                    if tk == MIR_TERM_GOTO {
                        let gt_v = unsafe { (*bb).terminator.goto_target.v };
                        unsafe { opt_inc_pred(preds, gt_v, bb_count) };
                    } else if tk == MIR_TERM_SWITCH_INT {
                        let sc = unsafe { (*bb).terminator.switch_count };
                        let targets = unsafe { (*bb).terminator.targets };
                        if sc > 0 && (targets as usize) != 0 {
                            let mut j: usize = 0;
                            while j < sc {
                                let tgt_v = unsafe { (*mir_bb_id_at(targets, j)).v };
                                unsafe { opt_inc_pred(preds, tgt_v, bb_count) };
                                j = j + 1;
                            }
                        }
                        let ow_v = unsafe { (*bb).terminator.otherwise.v };
                        unsafe { opt_inc_pred(preds, ow_v, bb_count) };
                    } else if tk == MIR_TERM_DROP {
                        let dt_v = unsafe { (*bb).terminator.drop_target.v };
                        unsafe { opt_inc_pred(preds, dt_v, bb_count) };
                        let du_v = unsafe { (*bb).terminator.drop_unwind.v };
                        if opt_is_valid_unwind(du_v, bb_count) {
                            unsafe { opt_inc_pred(preds, du_v, bb_count) };
                        }
                    } else if tk == MIR_TERM_CALL {
                        let ct_v = unsafe { (*bb).terminator.call_target.v };
                        unsafe { opt_inc_pred(preds, ct_v, bb_count) };
                        let cu_v = unsafe { (*bb).terminator.call_unwind.v };
                        if opt_is_valid_unwind(cu_v, bb_count) {
                            unsafe { opt_inc_pred(preds, cu_v, bb_count) };
                        }
                    } else if tk == MIR_TERM_ASSERT {
                        let at_v = unsafe { (*bb).terminator.assert_target.v };
                        unsafe { opt_inc_pred(preds, at_v, bb_count) };
                        let au_v = unsafe { (*bb).terminator.assert_unwind.v };
                        if opt_is_valid_unwind(au_v, bb_count) {
                            unsafe { opt_inc_pred(preds, au_v, bb_count) };
                        }
                    }
                }
            }
            i = i + 1;
        }

        i = 0;
        while i < bb_count {
            let is_reach = unsafe { *opt_u8_at(reachable, i) != 0u8 };
            if is_reach {
                let bb_a = unsafe { mir_bb_at(body.bbs, i) };
                let a_has_term = unsafe { (*bb_a).has_terminator };
                let a_tk = unsafe { (*bb_a).terminator.kind };
                let a_term_sync = a_has_term && unsafe { mir_term_is_sync_barrier(view((*bb_a).terminator)) };
                if a_has_term && !a_term_sync && a_tk == MIR_TERM_GOTO {
                    let target_idx = unsafe { (*bb_a).terminator.goto_target.v as usize };
                    if target_idx > 0 && target_idx < bb_count && target_idx != i {
                        let pred_cnt = unsafe { *opt_u32_at(preds, target_idx) };
                        let bb_b = unsafe { mir_bb_at(body.bbs, target_idx) };
                        let a_cleanup = unsafe { (*bb_a).is_cleanup };
                        let b_cleanup = unsafe { (*bb_b).is_cleanup };
                        if pred_cnt == 1u32 && a_cleanup == b_cleanup {
                            let b_stmt_cnt = unsafe { (*bb_b).stmt_count };
                            let b_stmts = unsafe { (*bb_b).stmts };
                            let mut s: usize = 0;
                            while s < b_stmt_cnt {
                                let st = unsafe { mir_stmt_at(b_stmts, s) };
                                unsafe { mir_bb_push_stmt(mut_view(*bb_a), mut_view(*arena), view(*st)) };
                                s = s + 1;
                            }
                            let mut loc = opt_zero_span();
                            unsafe {
                                mir_span_copy(mut_view(loc), view((*bb_b).terminator.location));
                                mir_copy_terminator(mut_view((*bb_a).terminator), view((*bb_b).terminator));
                                (*bb_a).has_terminator = (*bb_b).has_terminator;
                                (*bb_b).stmt_count = 0;
                                (*bb_b).has_terminator = true;
                                mir_term_reset(mut_view((*bb_b).terminator), MIR_TERM_UNREACHABLE, view(loc));
                            }
                            pass_changed = true;
                            total_changed = true;
                            break;
                        }
                    }
                }
            }
            i = i + 1;
        }
    }

    total_changed
}

pub fn opt_cfg_simplify_in_arena(body: mut_view<MirBody>, scratch: mut_view<Arena>) -> bool {
    let mut total_changed: bool = false;
    let mut pass_changed: bool = true;
    while pass_changed {
        let c1 = opt_cfg_fold_const_switches(mut_view(*body));
        let c2 = opt_cfg_mark_unreachable_in_arena(mut_view(*body), mut_view(*scratch));
        pass_changed = c1 || c2;
        if pass_changed {
            total_changed = true;
        }
    }
    total_changed
}

// Standard `-O1` CFG simplification pass matching `bootstrap/axiom0/src/opt/opt.c`.
pub fn opt_cfg_simplify(body: mut_view<MirBody>) -> bool {
    let mut scratch = arena_new();
    let total_changed = opt_cfg_simplify_in_arena(body, mut_view(scratch));
    arena_destroy(mut_view(scratch));
    total_changed
}

pub fn ax_opt_cfg_simplify(body: mut_view<MirBody>) -> bool {
    opt_cfg_simplify(body)
}

// Extended CFG simplification pass combining redundant switch elimination, unreachable block
// cleanup, and single-predecessor linear block merging to a fixed point.
pub fn opt_cfg_simplify_with_merge(body: mut_view<MirBody>, arena: mut_view<Arena>) -> bool {
    let mut total_changed: bool = false;
    let mut pass_changed: bool = true;
    while pass_changed {
        let c1 = opt_cfg_eliminate_redundant_switches(mut_view(*body));
        let c2 = opt_cfg_mark_unreachable_in_arena(mut_view(*body), mut_view(*arena));
        let c3 = opt_cfg_merge_linear_blocks(mut_view(*body), mut_view(*arena));
        pass_changed = c1 || c2 || c3;
        if pass_changed {
            total_changed = true;
        }
    }
    total_changed
}

// Axiom Compiler — MIR Optimization Pipeline (`compiler.opt`)
// Port of bootstrap/axiom0/src/opt/opt.h and bootstrap/axiom0/src/opt/opt.c.
//
// Coordinates the `-O1` MIR optimization passes:
//   1. `opt_const_fold`: constant folding for binary, overflow-check, and unary rvalues
//   2. `opt_dce`: iterative dead code elimination for unused locals and storage markers
//   3. `opt_cfg_simplify`: constant switch folding and unreachable basic block cleanup
//      (plus `opt_cfg_eliminate_redundant_switches` and `opt_cfg_merge_linear_blocks`)
// Optionally invokes `verify_mir` after each pass when `verify_each` is enabled (`--verify-mir`).
module compiler.opt

use compiler.kernel.arena.Arena
use compiler.kernel.arena.arena_new
use compiler.kernel.arena.arena_destroy
use compiler.kernel.arena.arena_alloc_raw
use compiler.kernel.id.TypeId
use compiler.kernel.interner.StrView
use compiler.diag.emitter.DiagSink
use compiler.diag.format.DiagBuffer
use compiler.hir.hir.HirItem
use compiler.types.types.AxType
use compiler.types.types.Thir
use compiler.types.types.ax_type_reset
use compiler.types.types.typemap_free
use compiler.mir.mir.MirBody
use compiler.mir.mir.mir_mul_usize
use compiler.mir.mir.mir_print_ext
use compiler.verify.verifier.verify_mir
use compiler.verify.verifier.verify_parse_mir

pub use compiler.opt.const_fold.opt_type_bits
pub use compiler.opt.const_fold.opt_type_is_signed
pub use compiler.opt.const_fold.opt_type_is_bool
pub use compiler.opt.const_fold.opt_bool_type_id
pub use compiler.opt.const_fold.opt_bit_mask
pub use compiler.opt.const_fold.opt_sign_bit_mask
