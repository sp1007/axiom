                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            mb_build_expr_as_operand(mut_view(*b), unsafe {
                (*expr).elems
            }, mut_view(elem_op));
            let mut cnt_op = MirOperand {
                kind: MIR_OP_COPY, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: 0u32
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: 0u32
                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            mb_build_expr_as_operand(mut_view(*b), count_expr, mut_view(cnt_op));
            let cnt_op_ptr = unsafe {
                arena_alloc_raw(mut_view(*b.arena), size_of<MirOperand>(), align_of<MirOperand>()) as *mut MirOperand
            };
            unsafe {
                mir_copy_operand(mut_view(*cnt_op_ptr), view(cnt_op));
            }
            let mut rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
            rv.kind = MIR_RVALUE_REPEAT;
            mir_copy_operand(mut_view(rv.use_op), view(elem_op));
            rv.repeat_count = mb_eval_const_int_expr(view(*b), count_expr);
            rv.repeat_count_op = cnt_op_ptr;
            mb_emit_assign(mut_view(*b), view(*dest), view(rv), view(sp));
        } else {
            let mut cnt: usize = 0;
            let mut el: *mut HirExpr = unsafe {
                (*expr).elems
            };
            while ((el as usize) != 0) {
                cnt = cnt + 1;
                el = unsafe {
                    (*el).next
                };
            }
            let mut ops: *mut MirOperand = 0 as *mut MirOperand;
            if cnt > 0 {
                let bytes = mir_mul_usize(cnt, size_of<MirOperand>());
                ops = unsafe {
                    arena_alloc_raw(mut_view(*b.arena), bytes, align_of<MirOperand>()) as *mut MirOperand
                };
                let mut i: usize = 0;
                el = unsafe {
                    (*expr).elems
                };
                while ((el as usize) != 0) {
                    let mut op_i = MirOperand {
                        kind: MIR_OP_COPY, location: Span {
                            file: FileId {
                                v: 0u32
                            }, start: 0u32, end: 0u32
                        }, place: MirPlace {
                            local: MirLocalId {
                                v: 0u32
                            }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                        }, constant: MirConst {
                            ty: TypeId {
                                v: 0u32
                            }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                                v: 0u32
                            }
                        }
                    };
                    mb_build_expr_as_operand(mut_view(*b), el, mut_view(op_i));
                    let dst_op = unsafe {
                        mir_op_at(ops, i)
                    };
                    unsafe {
                        mir_copy_operand(mut_view(*dst_op), view(op_i));
                    }
                    i = i + 1;
                    el = unsafe {
                        (*el).next
                    };
                }
            }
            let mut rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
            rv.kind = MIR_RVALUE_AGGREGATE;
            rv.variant_idx = 0u32;
            rv.operands = ops;
            rv.operand_count = cnt;
            mb_emit_assign(mut_view(*b), view(*dest), view(rv), view(sp));
        }
        return;
    }

    if ek == HIR_EXPR_STRUCT {
        let ax = unsafe {
            type_get(view((*b.thir).interner), (TypeId {
                v: e_ty.v
            }))
        };
        let mut is_enum_struct = false;
        let mut v_idx: u32 = 0u32;
        let mut f_count: usize = 0;
        let mut def_item: *mut HirItem = 0 as *mut HirItem;
        if (ax as usize) != 0 {
            def_item = unsafe {
                ((*ax).def) as *mut HirItem
            };
            if (unsafe { (*ax).kind }) == TY_ENUM {
                is_enum_struct = true;
                let vp2 = unsafe {
                    thir_get_expr_variant(view(*b.thir), expr as *const HirExpr)
                };
                if (vp2 as usize) != 0 {
                    v_idx = unsafe {
                        *vp2
                    };
                }
                if (v_idx as usize) < (unsafe { (*ax).variant_count }) && (unsafe { (*ax).variant_field_counts as usize }) != 0 {
                    f_count = unsafe {
                        *usize_at((*ax).variant_field_counts, v_idx as usize)
                    };
                }
            } else if (unsafe { (*ax).kind }) == TY_STRUCT {
                f_count = unsafe {
                    (*ax).field_count
                };
            }
        }
        if f_count == 0 {
            let mut fi: *mut HirFieldInit = unsafe {
                (*expr).fields
            };
            while ((fi as usize) != 0) {
                f_count = f_count + 1;
                fi = unsafe {
                    (*fi).next
                };
            }
        }
        let mut ops: *mut MirOperand = 0 as *mut MirOperand;
        if f_count > 0 {
            let bytes = mir_mul_usize(f_count, size_of<MirOperand>());
            ops = unsafe {
                arena_alloc_raw(mut_view(*b.arena), bytes, align_of<MirOperand>()) as *mut MirOperand
            };
            let mut i: usize = 0;
            while (i < f_count) {
                let dst_op = unsafe {
                    mir_op_at(ops, i)
                };
                unsafe {
                    *dst_op = MirOperand {
                        kind: MIR_OP_CONST, location: Span {
                            file: FileId {
                                v: 0u32
                            }, start: 0u32, end: 0u32
                        }, place: MirPlace {
                            local: MirLocalId {
                                v: 0u32
                            }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                        }, constant: MirConst {
                            ty: TypeId {
                                v: 0u32
                            }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                                v: 0u32
                            }
                        }
                    };
                }
                i = i + 1;
            }
            let mut fi: *mut HirFieldInit = unsafe {
                (*expr).fields
            };
            let mut pos_idx: usize = 0;
            while ((fi as usize) != 0) {
                let fi_sp = Span {
                    file: FileId { v: unsafe { (*fi).span.file.v } },
                    start: unsafe { (*fi).span.start },
                    end: unsafe { (*fi).span.end },
                };
                let fi_name = StrId {
                    v: unsafe {
                        (*fi).name.v
                    }
                };
                let mut target_idx: usize = pos_idx;
                if (def_item as usize) != 0 {
                    if is_enum_struct {
                        target_idx = mb_find_enum_variant_field_index(view(*b), def_item, v_idx, (StrId {
                            v: fi_name.v
                        }), view(fi_sp)) as usize;
                    } else {
                        target_idx = mb_find_struct_field_index(view(*b), def_item, (StrId {
                            v: fi_name.v
                        }), view(fi_sp)) as usize;
                    }
                }
                if target_idx >= f_count {
                    target_idx = pos_idx;
                }
                if target_idx < f_count {
                    let mut op_f = MirOperand {
                        kind: MIR_OP_COPY, location: Span {
                            file: FileId {
                                v: 0u32
                            }, start: 0u32, end: 0u32
                        }, place: MirPlace {
                            local: MirLocalId {
                                v: 0u32
                            }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                        }, constant: MirConst {
                            ty: TypeId {
                                v: 0u32
                            }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                                v: 0u32
                            }
                        }
                    };
                    mb_build_expr_as_operand(mut_view(*b), unsafe {
                        (*fi).expr
                    }, mut_view(op_f));
                    let dst_op = unsafe {
                        mir_op_at(ops, target_idx)
                    };
                    unsafe {
                        mir_copy_operand(mut_view(*dst_op), view(op_f));
                    }
                }
                pos_idx = pos_idx + 1;
                fi = unsafe {
                    (*fi).next
                };
            }
        }
        let mut rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
        rv.kind = MIR_RVALUE_AGGREGATE;
        rv.variant_idx = v_idx;
        rv.operands = ops;
        rv.operand_count = f_count;
        mb_emit_assign(mut_view(*b), view(*dest), view(rv), view(sp));
        return;
    }

    mb_build_control_or_call_expr(mut_view(*b), expr, mut_view(*dest), has_dest);
}

fn mb_intr_temp(b: mut_view<MirBuilder>, ty_v: u32, sp: view<Span>) -> MirPlace {
    let loc = mb_new_temp(mut_view(*b), (TypeId { v: ty_v }), sp);
    mir_local_place(loc.v)
}

fn mb_intr_copy_op(p: MirPlace) -> MirOperand {
    let mut op = MirOperand {
        kind: MIR_OP_COPY,
        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        place: mir_local_place(0u32),
        constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
    };
    mir_copy_place(mut_view(op.place), view(p));
    op
}

fn mb_intr_const_op(ty_v: u32, v: u64) -> MirOperand {
    MirOperand {
        kind: MIR_OP_CONST,
        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        place: mir_local_place(0u32),
        constant: MirConst { ty: TypeId { v: ty_v }, kind: MIR_CONST_INT, val: v, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
    }
}

fn mb_intr_binop_into(
    b: mut_view<MirBuilder>,
    out_pl: view<MirPlace>,
    op: u8,
    lhs: view<MirOperand>,
    rhs: view<MirOperand>,
    sp: view<Span>
) -> MirOperand {
    let mut rv = MirRvalue {
        kind: MIR_RVALUE_BINARY_OP,
        use_op: mb_intr_copy_op(mir_local_place(0u32)),
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: mir_local_place(0u32),
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: op,
        lhs: mb_intr_copy_op(mir_local_place(0u32)),
        rhs: mb_intr_copy_op(mir_local_place(0u32)),
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
    mir_copy_operand(mut_view(rv.lhs), lhs);
    mir_copy_operand(mut_view(rv.rhs), rhs);
    mb_emit_assign(mut_view(*b), out_pl, view(rv), sp);
    let mut cp_pl = mir_local_place(0u32);
    mir_copy_place(mut_view(cp_pl), out_pl);
    mb_intr_copy_op(cp_pl)
}

fn mb_intr_binop(
    b: mut_view<MirBuilder>,
    op: u8,
    ty_v: u32,
    lhs: view<MirOperand>,
    rhs: view<MirOperand>,
    sp: view<Span>
) -> MirOperand {
    let t = mb_intr_temp(mut_view(*b), ty_v, sp);
    mb_intr_binop_into(mut_view(*b), view(t), op, lhs, rhs, sp)
}

fn mb_intr_cast_into(
    b: mut_view<MirBuilder>,
    out_pl: view<MirPlace>,
    v: view<MirOperand>,
    to_ty_v: u32,
    sp: view<Span>
) {
    let mut rv = MirRvalue {
        kind: MIR_RVALUE_CAST,
        use_op: mb_intr_copy_op(mir_local_place(0u32)),
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: mir_local_place(0u32),
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: to_ty_v },
        bin_op: MIR_BINOP_ADD,
        lhs: mb_intr_copy_op(mir_local_place(0u32)),
        rhs: mb_intr_copy_op(mir_local_place(0u32)),
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
    mir_copy_operand(mut_view(rv.use_op), v);
    mb_emit_assign(mut_view(*b), out_pl, view(rv), sp);
}

fn mb_intr_cast(
    b: mut_view<MirBuilder>,
    v: view<MirOperand>,
    from_ty_v: u32,
    to_ty_v: u32,
    sp: view<Span>
) -> MirOperand {
    if from_ty_v == to_ty_v {
        let mut out_v = mb_intr_copy_op(mir_local_place(0u32));
        mir_copy_operand(mut_view(out_v), v);
        return out_v;
    }
    let t = mb_intr_temp(mut_view(*b), to_ty_v, sp);
    mb_intr_cast_into(mut_view(*b), view(t), v, to_ty_v, sp);
    mb_intr_copy_op(t)
}

fn mb_intr_materialize(
    b: mut_view<MirBuilder>,
    v: view<MirOperand>,
    ty_v: u32,
    sp: view<Span>
) -> MirOperand {
    let t = mb_intr_temp(mut_view(*b), ty_v, sp);
    mb_emit_assign_use(mut_view(*b), view(t), v, sp);
    mb_intr_copy_op(t)
}

fn mb_intr_popcount64(b: mut_view<MirBuilder>, x: view<MirOperand>, sp: view<Span>) -> MirOperand {
    let u64_ty_v = unsafe { (*b.thir).interner.t_u64.v };
    let u32_ty_v = unsafe { (*b.thir).interner.t_u32.v };
    let c1 = mb_intr_const_op(u32_ty_v, 1u64);
    let c2 = mb_intr_const_op(u32_ty_v, 2u64);
    let c4 = mb_intr_const_op(u32_ty_v, 4u64);
    let c56 = mb_intr_const_op(u32_ty_v, 56u64);
    let m55 = mb_intr_const_op(u64_ty_v, 0x5555555555555555u64);
    let m33 = mb_intr_const_op(u64_ty_v, 0x3333333333333333u64);
    let m0f = mb_intr_const_op(u64_ty_v, 0x0F0F0F0F0F0F0F0Fu64);
    let m01 = mb_intr_const_op(u64_ty_v, 0x0101010101010101u64);
    let mut t = mb_intr_binop(mut_view(*b), MIR_BINOP_SHR, u64_ty_v, x, view(c1), sp);
    t = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_AND, u64_ty_v, view(t), view(m55), sp);
    let x1 = mb_intr_binop(mut_view(*b), MIR_BINOP_SUB, u64_ty_v, x, view(t), sp);
    let lo = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_AND, u64_ty_v, view(x1), view(m33), sp);
    let mut hi = mb_intr_binop(mut_view(*b), MIR_BINOP_SHR, u64_ty_v, view(x1), view(c2), sp);
    hi = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_AND, u64_ty_v, view(hi), view(m33), sp);
    let x2 = mb_intr_binop(mut_view(*b), MIR_BINOP_ADD, u64_ty_v, view(lo), view(hi), sp);
    let sh = mb_intr_binop(mut_view(*b), MIR_BINOP_SHR, u64_ty_v, view(x2), view(c4), sp);
    let sum = mb_intr_binop(mut_view(*b), MIR_BINOP_ADD, u64_ty_v, view(x2), view(sh), sp);
    let x3 = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_AND, u64_ty_v, view(sum), view(m0f), sp);
    let prod = mb_intr_binop(mut_view(*b), MIR_BINOP_WRAPPING_MUL, u64_ty_v, view(x3), view(m01), sp);
    mb_intr_binop(mut_view(*b), MIR_BINOP_SHR, u64_ty_v, view(prod), view(c56), sp)
}

fn mb_intr_popcount128(b: mut_view<MirBuilder>, x128: view<MirOperand>, u128_ty_v: u32, sp: view<Span>) -> MirOperand {
    let u64_ty_v = unsafe { (*b.thir).interner.t_u64.v };
    let u32_ty_v = unsafe { (*b.thir).interner.t_u32.v };
    let lo64 = mb_intr_cast(mut_view(*b), x128, u128_ty_v, u64_ty_v, sp);
    let c64 = mb_intr_const_op(u32_ty_v, 64u64);
    let hi128 = mb_intr_binop(mut_view(*b), MIR_BINOP_SHR, u128_ty_v, x128, view(c64), sp);
    let hi64 = mb_intr_cast(mut_view(*b), view(hi128), u128_ty_v, u64_ty_v, sp);
    let pc_lo = mb_intr_popcount64(mut_view(*b), view(lo64), sp);
    let pc_hi = mb_intr_popcount64(mut_view(*b), view(hi64), sp);
    mb_intr_binop(mut_view(*b), MIR_BINOP_ADD, u64_ty_v, view(pc_lo), view(pc_hi), sp)
}

fn mb_intr_bswap64(b: mut_view<MirBuilder>, x: view<MirOperand>, sp: view<Span>) -> MirOperand {
    let u64_ty_v = unsafe { (*b.thir).interner.t_u64.v };
    let u32_ty_v = unsafe { (*b.thir).interner.t_u32.v };
    let c8 = mb_intr_const_op(u32_ty_v, 8u64);
    let c16 = mb_intr_const_op(u32_ty_v, 16u64);
    let c32 = mb_intr_const_op(u32_ty_v, 32u64);
    let m00ff = mb_intr_const_op(u64_ty_v, 0x00FF00FF00FF00FFu64);
    let m0000ffff = mb_intr_const_op(u64_ty_v, 0x0000FFFF0000FFFFu64);
    let a1 = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_AND, u64_ty_v, x, view(m00ff), sp);
    let l1 = mb_intr_binop(mut_view(*b), MIR_BINOP_SHL, u64_ty_v, view(a1), view(c8), sp);
    let r1s = mb_intr_binop(mut_view(*b), MIR_BINOP_SHR, u64_ty_v, x, view(c8), sp);
    let r1 = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_AND, u64_ty_v, view(r1s), view(m00ff), sp);
    let s1 = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_OR, u64_ty_v, view(l1), view(r1), sp);
    let a2 = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_AND, u64_ty_v, view(s1), view(m0000ffff), sp);
    let l2 = mb_intr_binop(mut_view(*b), MIR_BINOP_SHL, u64_ty_v, view(a2), view(c16), sp);
    let r2s = mb_intr_binop(mut_view(*b), MIR_BINOP_SHR, u64_ty_v, view(s1), view(c16), sp);
    let r2 = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_AND, u64_ty_v, view(r2s), view(m0000ffff), sp);
    let s2 = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_OR, u64_ty_v, view(l2), view(r2), sp);
    let l3 = mb_intr_binop(mut_view(*b), MIR_BINOP_SHL, u64_ty_v, view(s2), view(c32), sp);
    let r3 = mb_intr_binop(mut_view(*b), MIR_BINOP_SHR, u64_ty_v, view(s2), view(c32), sp);
    mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_OR, u64_ty_v, view(l3), view(r3), sp)
}

fn mb_intr_bitrev64(b: mut_view<MirBuilder>, x: view<MirOperand>, sp: view<Span>) -> MirOperand {
    let u64_ty_v = unsafe { (*b.thir).interner.t_u64.v };
    let u32_ty_v = unsafe { (*b.thir).interner.t_u32.v };
    let c1 = mb_intr_const_op(u32_ty_v, 1u64);
    let c2 = mb_intr_const_op(u32_ty_v, 2u64);
    let c4 = mb_intr_const_op(u32_ty_v, 4u64);
    let m55 = mb_intr_const_op(u64_ty_v, 0x5555555555555555u64);
    let m33 = mb_intr_const_op(u64_ty_v, 0x3333333333333333u64);
    let m0f = mb_intr_const_op(u64_ty_v, 0x0F0F0F0F0F0F0F0Fu64);
    let a1 = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_AND, u64_ty_v, x, view(m55), sp);
    let l1 = mb_intr_binop(mut_view(*b), MIR_BINOP_SHL, u64_ty_v, view(a1), view(c1), sp);
    let r1s = mb_intr_binop(mut_view(*b), MIR_BINOP_SHR, u64_ty_v, x, view(c1), sp);
    let r1 = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_AND, u64_ty_v, view(r1s), view(m55), sp);
    let s1 = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_OR, u64_ty_v, view(l1), view(r1), sp);
    let a2 = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_AND, u64_ty_v, view(s1), view(m33), sp);
    let l2 = mb_intr_binop(mut_view(*b), MIR_BINOP_SHL, u64_ty_v, view(a2), view(c2), sp);
    let r2s = mb_intr_binop(mut_view(*b), MIR_BINOP_SHR, u64_ty_v, view(s1), view(c2), sp);
    let r2 = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_AND, u64_ty_v, view(r2s), view(m33), sp);
    let s2 = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_OR, u64_ty_v, view(l2), view(r2), sp);
    let a3 = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_AND, u64_ty_v, view(s2), view(m0f), sp);
    let l3 = mb_intr_binop(mut_view(*b), MIR_BINOP_SHL, u64_ty_v, view(a3), view(c4), sp);
    let r3s = mb_intr_binop(mut_view(*b), MIR_BINOP_SHR, u64_ty_v, view(s2), view(c4), sp);
    let r3 = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_AND, u64_ty_v, view(r3s), view(m0f), sp);
    let s3 = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_OR, u64_ty_v, view(l3), view(r3), sp);
    mb_intr_bswap64(mut_view(*b), view(s3), sp)
}

fn mb_intr_zext64(
    b: mut_view<MirBuilder>,
    a: view<MirOperand>,
    w_ty_v: u32,
    u_ty_v: u32,
    sp: view<Span>
) -> MirOperand {
    let u = mb_intr_cast(mut_view(*b), a, w_ty_v, u_ty_v, sp);
    let u64_ty_v = unsafe { (*b.thir).interner.t_u64.v };
    mb_intr_cast(mut_view(*b), view(u), u_ty_v, u64_ty_v, sp)
}

fn mb_intr_finish_use(b: mut_view<MirBuilder>, dest: view<MirPlace>, v: view<MirOperand>, sp: view<Span>) {
    mb_emit_assign_use(mut_view(*b), dest, v, sp);
}

fn mb_intr_assert(b: mut_view<MirBuilder>, cond: view<MirOperand>, msg_kind: u8, sp: view<Span>) {
    let bool_ty_v = unsafe { (*b.thir).interner.t_bool.v };
    let c = mb_intr_temp(mut_view(*b), bool_ty_v, sp);
    mb_emit_assign_use(mut_view(*b), view(c), cond, sp);
    let c_op = mb_intr_copy_op(c);
    mb_emit_assert(mut_view(*b), view(c_op), true, msg_kind, sp);
}

fn mb_try_build_intrinsic_call(
    b: mut_view<MirBuilder>,
    expr: *mut HirExpr,
    dest: mut_view<MirPlace>,
    has_dest: bool,
    sp: view<Span>
) -> bool {
    let callee_expr: *mut HirExpr = unsafe { (*expr).callee };
    let mut iref = intrinsic_decode(0u32);
    let code_ptr = unsafe { thir_get_expr_variant(view(*b.thir), callee_expr as *const HirExpr) };
    if (code_ptr as usize) != 0 {
        iref = intrinsic_decode(unsafe { *code_ptr });
    }
    if !iref.has_desc {
        let sym_intr = SymbolId { v: unsafe { (*callee_expr).path.symbol.v } };
        let mut fn_item_intr: *mut HirItem = 0 as *mut HirItem;
        if sym_intr.v != 0u32 {
            fn_item_intr = mb_find_item_by_sym_thir(b.thir as *const Thir, b.hir, sym_intr);
        } else {
            let mut p_sv = StrView { ptr: 0 as *const u8, len: 0 };
            let pnv = unsafe { (*callee_expr).path.name.v };
            if pnv != 0u32 && (b.str_in as usize) != 0 {
                p_sv = unsafe { interner_get(view(*b.str_in), StrId { v: pnv }) };
            } else {
                let csp = Span {
                    file: FileId { v: unsafe { (*callee_expr).span.file.v } },
                    start: unsafe { (*callee_expr).span.start },
                    end: unsafe { (*callee_expr).span.end },
                };
                p_sv = mb_span_sv(view(*b), view(csp));
            }
            fn_item_intr = mb_find_item_by_path_sv(view(*b), view(p_sv));
        }
        if (fn_item_intr as usize) != 0 && mb_has_intrinsic_attr(b.str_in, b.db, fn_item_intr) {
            let fn_sv = mb_item_name_sv(view(*b), fn_item_intr);
            iref = intrinsic_lookup(fn_sv);
        }
    }
    if !iref.has_desc {
        return false;
    }
    if iref.desc.cls != INTR_MIR_OP && iref.desc.cls != INTR_MIR_TERM {
        return false;
    }

    let mut argc: usize = 0;
    let mut cur_a: *mut HirExpr = unsafe { (*expr).args };
    while (cur_a as usize) != 0 {
        argc = argc + 1;
        cur_a = unsafe { (*cur_a).next };
    }

    if iref.desc.cls == INTR_MIR_TERM {
        if argc > 1 { return false; }
        if iref.desc.op == INTR_OP_ASSERT && argc != 1 { return false; }
        if iref.desc.op == INTR_OP_UNREACHABLE && argc != 0 { return false; }
        let mut arg_op = mb_intr_copy_op(mir_local_place(0u32));
        if argc == 1 {
            mb_build_expr_as_operand(mut_view(*b), unsafe { (*expr).args }, mut_view(arg_op));
        }
        if iref.desc.op == INTR_OP_ASSERT {
            mb_intr_assert(mut_view(*b), view(arg_op), MB_ASSERT_MSG_ASSERT, sp);
            if has_dest {
                let mut rv = MirRvalue {
                    kind: MIR_RVALUE_AGGREGATE,
                    use_op: mb_intr_copy_op(mir_local_place(0u32)),
                    repeat_count: 0u64,
                    repeat_count_op: 0 as *mut MirOperand,
                    borrow_kind: MIR_BORROW_SHARED,
                    place: mir_local_place(0u32),
                    cast_kind: MIR_CAST_INT_TO_INT,
                    target_ty: TypeId { v: 0u32 },
                    bin_op: MIR_BINOP_ADD,
                    lhs: mb_intr_copy_op(mir_local_place(0u32)),
                    rhs: mb_intr_copy_op(mir_local_place(0u32)),
                    un_op: MIR_UNOP_NOT,
                    variant_idx: 0u32,
                    operands: 0 as *mut MirOperand,
                    operand_count: 0,
                };
                mb_emit_assign(mut_view(*b), view(*dest), view(rv), sp);
            }
        } else {
            let msg_kind = if iref.desc.op == INTR_OP_UNREACHABLE {
                MB_ASSERT_MSG_UNREACHABLE
            } else {
                MB_ASSERT_MSG_PANIC
            };
            let bool_ty_v = unsafe { (*b.thir).interner.t_bool.v };
            let false_op = mb_intr_const_op(bool_ty_v, 0u64);
            mb_intr_assert(mut_view(*b), view(false_op), msg_kind, sp);
        }
        return true;
    }

    let op = iref.desc.op;
    let want: usize = if op == INTR_OP_WRAPPING_ADD || op == INTR_OP_WRAPPING_SUB || op == INTR_OP_WRAPPING_MUL || op == INTR_OP_SATURATING_ADD || op == INTR_OP_SATURATING_SUB || op == INTR_OP_SATURATING_MUL || op == INTR_OP_ROTATE_LEFT || op == INTR_OP_ROTATE_RIGHT {
        2
    } else {
        1
    };
    if argc != want {
        return false;
    }

    let arg0: *mut HirExpr = unsafe { (*expr).args };
    let arg1: *mut HirExpr = if want == 2 { unsafe { (*arg0).next } } else { 0 as *mut HirExpr };
    mb_build_intrinsic_mir_op(mut_view(*b), iref, arg0, arg1, mut_view(*dest), sp)
}

fn mb_build_intrinsic_mir_op(
    b: mut_view<MirBuilder>,
    iref: IntrinsicRef,
    arg0: *mut HirExpr,
    arg1: *mut HirExpr,
    dest: mut_view<MirPlace>,
    sp: view<Span>
) -> bool {
    let w_ty = unsafe { intrinsic_width_type(iref.width, view((*b.thir).interner)) };
    let u_ty = unsafe { intrinsic_width_unsigned_type(iref.width, view((*b.thir).interner)) };
    let w_ty_v = w_ty.v;
    let u_ty_v = u_ty.v;
    let bits = intrinsic_width_bits(iref.width);
    let u32_ty_v = unsafe { (*b.thir).interner.t_u32.v };
    let u64_ty_v = unsafe { (*b.thir).interner.t_u64.v };
    let op = iref.desc.op;
    let want: usize = if op == INTR_OP_WRAPPING_ADD || op == INTR_OP_WRAPPING_SUB || op == INTR_OP_WRAPPING_MUL || op == INTR_OP_SATURATING_ADD || op == INTR_OP_SATURATING_SUB || op == INTR_OP_SATURATING_MUL || op == INTR_OP_ROTATE_LEFT || op == INTR_OP_ROTATE_RIGHT {
        2
    } else {
        1
    };

    let mut a = mb_intr_copy_op(mir_local_place(0u32));
    mb_build_expr_as_operand(mut_view(*b), arg0, mut_view(a));
    let mut a2 = mb_intr_copy_op(mir_local_place(0u32));
    if want == 2 {
        mb_build_expr_as_operand(mut_view(*b), arg1, mut_view(a2));
    }

    if op == INTR_OP_WRAPPING_ADD || op == INTR_OP_WRAPPING_SUB || op == INTR_OP_WRAPPING_MUL || op == INTR_OP_SATURATING_ADD || op == INTR_OP_SATURATING_SUB || op == INTR_OP_SATURATING_MUL {
        let bop = if op == INTR_OP_WRAPPING_ADD {
            MIR_BINOP_WRAPPING_ADD
        } else if op == INTR_OP_WRAPPING_SUB {
            MIR_BINOP_WRAPPING_SUB
        } else if op == INTR_OP_WRAPPING_MUL {
            MIR_BINOP_WRAPPING_MUL
        } else if op == INTR_OP_SATURATING_ADD {
            MIR_BINOP_SAT_ADD
        } else if op == INTR_OP_SATURATING_SUB {
            MIR_BINOP_SAT_SUB
        } else {
            MIR_BINOP_SAT_MUL
        };
        let a0_ty = mb_expr_ty(mut_view(*b), arg0);
        let a1_ty = mb_expr_ty(mut_view(*b), arg1);
        let a_cast = mb_cast_int_if_needed(mut_view(*b), view(a), (TypeId { v: a0_ty.v }), (TypeId { v: w_ty_v }), sp);
        let a2_cast = mb_cast_int_if_needed(mut_view(*b), view(a2), (TypeId { v: a1_ty.v }), (TypeId { v: w_ty_v }), sp);
        let xa = mb_intr_materialize(mut_view(*b), view(a_cast), w_ty_v, sp);
        let xb = mb_intr_materialize(mut_view(*b), view(a2_cast), w_ty_v, sp);
        let _ = mb_intr_binop_into(mut_view(*b), view(*dest), bop, view(xa), view(xb), sp);
    } else if op == INTR_OP_WRAPPING_NEG {
        let x = mb_intr_materialize(mut_view(*b), view(a), w_ty_v, sp);
        let zero_w = mb_intr_const_op(w_ty_v, 0u64);
        let _ = mb_intr_binop_into(mut_view(*b), view(*dest), MIR_BINOP_WRAPPING_SUB, view(zero_w), view(x), sp);
    } else if op == INTR_OP_ROTATE_LEFT || op == INTR_OP_ROTATE_RIGHT {
        let x = mb_intr_materialize(mut_view(*b), view(a), w_ty_v, sp);
        let n = mb_intr_materialize(mut_view(*b), view(a2), u32_ty_v, sp);
        let xu = mb_intr_cast(mut_view(*b), view(x), w_ty_v, u_ty_v, sp);
        let mask = mb_intr_const_op(u32_ty_v, (bits - 1u32) as u64);
        let nm = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_AND, u32_ty_v, view(n), view(mask), sp);
        let bits_c = mb_intr_const_op(u32_ty_v, bits as u64);
        let mut inv = mb_intr_binop(mut_view(*b), MIR_BINOP_SUB, u32_ty_v, view(bits_c), view(nm), sp);
        inv = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_AND, u32_ty_v, view(inv), view(mask), sp);
        let hi = if op == INTR_OP_ROTATE_LEFT {
            mb_intr_binop(mut_view(*b), MIR_BINOP_SHL, u_ty_v, view(xu), view(nm), sp)
        } else {
            mb_intr_binop(mut_view(*b), MIR_BINOP_SHL, u_ty_v, view(xu), view(inv), sp)
        };
        let lo = if op == INTR_OP_ROTATE_LEFT {
            mb_intr_binop(mut_view(*b), MIR_BINOP_SHR, u_ty_v, view(xu), view(inv), sp)
        } else {
            mb_intr_binop(mut_view(*b), MIR_BINOP_SHR, u_ty_v, view(xu), view(nm), sp)
        };
        let r = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_OR, u_ty_v, view(hi), view(lo), sp);
        if w_ty_v == u_ty_v {
            mb_intr_finish_use(mut_view(*b), view(*dest), view(r), sp);
        } else {
            mb_intr_cast_into(mut_view(*b), view(*dest), view(r), w_ty_v, sp);
        }
    } else if op == INTR_OP_COUNT_ONES {
        let x = mb_intr_materialize(mut_view(*b), view(a), w_ty_v, sp);
        if bits == 128u32 {
            let xu = mb_intr_cast(mut_view(*b), view(x), w_ty_v, u_ty_v, sp);
            let cnt = mb_intr_popcount128(mut_view(*b), view(xu), u_ty_v, sp);
            mb_intr_cast_into(mut_view(*b), view(*dest), view(cnt), u32_ty_v, sp);
        } else {
            let z = mb_intr_zext64(mut_view(*b), view(x), w_ty_v, u_ty_v, sp);
            let cnt = mb_intr_popcount64(mut_view(*b), view(z), sp);
            mb_intr_cast_into(mut_view(*b), view(*dest), view(cnt), u32_ty_v, sp);
        }
    } else if op == INTR_OP_LEADING_ZEROS {
        let x = mb_intr_materialize(mut_view(*b), view(a), w_ty_v, sp);
        if bits == 128u32 {
            let mut y = mb_intr_cast(mut_view(*b), view(x), w_ty_v, u_ty_v, sp);
            let mut s: u32 = 1u32;
            while s < 128u32 {
                let sc = mb_intr_const_op(u32_ty_v, s as u64);
                let sh = mb_intr_binop(mut_view(*b), MIR_BINOP_SHR, u_ty_v, view(y), view(sc), sp);
                y = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_OR, u_ty_v, view(y), view(sh), sp);
                s = s << 1u32;
            }
            let pc = mb_intr_popcount128(mut_view(*b), view(y), u_ty_v, sp);
            let ones = mb_intr_cast(mut_view(*b), view(pc), u64_ty_v, u32_ty_v, sp);
            let bits_c = mb_intr_const_op(u32_ty_v, 128u64);
            let _ = mb_intr_binop_into(mut_view(*b), view(*dest), MIR_BINOP_SUB, view(bits_c), view(ones), sp);
        } else {
            let mut y = mb_intr_zext64(mut_view(*b), view(x), w_ty_v, u_ty_v, sp);
            let mut s: u32 = 1u32;
            while s < bits {
                let sc = mb_intr_const_op(u32_ty_v, s as u64);
                let sh = mb_intr_binop(mut_view(*b), MIR_BINOP_SHR, u64_ty_v, view(y), view(sc), sp);
                y = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_OR, u64_ty_v, view(y), view(sh), sp);
                s = s << 1u32;
            }
            let pc = mb_intr_popcount64(mut_view(*b), view(y), sp);
            let ones = mb_intr_cast(mut_view(*b), view(pc), u64_ty_v, u32_ty_v, sp);
            let bits_c = mb_intr_const_op(u32_ty_v, bits as u64);
            let _ = mb_intr_binop_into(mut_view(*b), view(*dest), MIR_BINOP_SUB, view(bits_c), view(ones), sp);
        }
    } else if op == INTR_OP_TRAILING_ZEROS {
        let x = mb_intr_materialize(mut_view(*b), view(a), w_ty_v, sp);
        if bits == 128u32 {
            let y = mb_intr_cast(mut_view(*b), view(x), w_ty_v, u_ty_v, sp);
            let one128 = mb_intr_const_op(u_ty_v, 1u64);
            let ym1 = mb_intr_binop(mut_view(*b), MIR_BINOP_WRAPPING_SUB, u_ty_v, view(y), view(one128), sp);
            let ny = mb_intr_temp(mut_view(*b), u_ty_v, sp);
            let mut nrv = MirRvalue {
                kind: MIR_RVALUE_UNARY_OP,
                use_op: mb_intr_copy_op(mir_local_place(0u32)),
                repeat_count: 0u64,
                repeat_count_op: 0 as *mut MirOperand,
                borrow_kind: MIR_BORROW_SHARED,
                place: mir_local_place(0u32),
                cast_kind: MIR_CAST_INT_TO_INT,
                target_ty: TypeId { v: 0u32 },
                bin_op: MIR_BINOP_ADD,
                lhs: mb_intr_copy_op(mir_local_place(0u32)),
                rhs: mb_intr_copy_op(mir_local_place(0u32)),
                un_op: MIR_UNOP_BITNOT,
                variant_idx: 0u32,
                operands: 0 as *mut MirOperand,
                operand_count: 0,
            };
            mir_copy_operand(mut_view(nrv.use_op), view(y));
            mb_emit_assign(mut_view(*b), view(ny), view(nrv), sp);
            let ny_op = mb_intr_copy_op(ny);
            let t = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_AND, u_ty_v, view(ny_op), view(ym1), sp);
            let pc = mb_intr_popcount128(mut_view(*b), view(t), u_ty_v, sp);
            mb_intr_cast_into(mut_view(*b), view(*dest), view(pc), u32_ty_v, sp);
        } else {
            let y = mb_intr_zext64(mut_view(*b), view(x), w_ty_v, u_ty_v, sp);
            let one64 = mb_intr_const_op(u64_ty_v, 1u64);
            let ym1 = mb_intr_binop(mut_view(*b), MIR_BINOP_WRAPPING_SUB, u64_ty_v, view(y), view(one64), sp);
            let ny = mb_intr_temp(mut_view(*b), u64_ty_v, sp);
            let mut nrv = MirRvalue {
                kind: MIR_RVALUE_UNARY_OP,
                use_op: mb_intr_copy_op(mir_local_place(0u32)),
                repeat_count: 0u64,
                repeat_count_op: 0 as *mut MirOperand,
                borrow_kind: MIR_BORROW_SHARED,
                place: mir_local_place(0u32),
                cast_kind: MIR_CAST_INT_TO_INT,
                target_ty: TypeId { v: 0u32 },
                bin_op: MIR_BINOP_ADD,
                lhs: mb_intr_copy_op(mir_local_place(0u32)),
                rhs: mb_intr_copy_op(mir_local_place(0u32)),
                un_op: MIR_UNOP_BITNOT,
                variant_idx: 0u32,
                operands: 0 as *mut MirOperand,
                operand_count: 0,
            };
            mir_copy_operand(mut_view(nrv.use_op), view(y));
            mb_emit_assign(mut_view(*b), view(ny), view(nrv), sp);
            let ny_op = mb_intr_copy_op(ny);
            let mut t = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_AND, u64_ty_v, view(ny_op), view(ym1), sp);
            if bits < 64u32 {
                let m = mb_intr_const_op(u64_ty_v, (1u64 << (bits as u64)) - 1u64);
                t = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_AND, u64_ty_v, view(t), view(m), sp);
            }
            let pc = mb_intr_popcount64(mut_view(*b), view(t), sp);
            mb_intr_cast_into(mut_view(*b), view(*dest), view(pc), u32_ty_v, sp);
        }
    } else if op == INTR_OP_SWAP_BYTES {
        let x = mb_intr_materialize(mut_view(*b), view(a), w_ty_v, sp);
        if bits == 8u32 {
            mb_intr_finish_use(mut_view(*b), view(*dest), view(x), sp);
        } else if bits == 128u32 {
            let xu = mb_intr_cast(mut_view(*b), view(x), w_ty_v, u_ty_v, sp);
            let lo64 = mb_intr_cast(mut_view(*b), view(xu), u_ty_v, u64_ty_v, sp);
            let c64 = mb_intr_const_op(u32_ty_v, 64u64);
            let hi128 = mb_intr_binop(mut_view(*b), MIR_BINOP_SHR, u_ty_v, view(xu), view(c64), sp);
            let hi64 = mb_intr_cast(mut_view(*b), view(hi128), u_ty_v, u64_ty_v, sp);
            let slo = mb_intr_bswap64(mut_view(*b), view(lo64), sp);
            let shi = mb_intr_bswap64(mut_view(*b), view(hi64), sp);
            let slo128 = mb_intr_cast(mut_view(*b), view(slo), u64_ty_v, u_ty_v, sp);
            let shi128 = mb_intr_cast(mut_view(*b), view(shi), u64_ty_v, u_ty_v, sp);
            let new_hi = mb_intr_binop(mut_view(*b), MIR_BINOP_SHL, u_ty_v, view(slo128), view(c64), sp);
            let r = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_OR, u_ty_v, view(new_hi), view(shi128), sp);
            if w_ty_v == u_ty_v {
                mb_intr_finish_use(mut_view(*b), view(*dest), view(r), sp);
            } else {
                mb_intr_cast_into(mut_view(*b), view(*dest), view(r), w_ty_v, sp);
            }
        } else {
            let z = mb_intr_zext64(mut_view(*b), view(x), w_ty_v, u_ty_v, sp);
            let mut r = mb_intr_bswap64(mut_view(*b), view(z), sp);
            if bits < 64u32 {
                let sh_c = mb_intr_const_op(u32_ty_v, (64u32 - bits) as u64);
                r = mb_intr_binop(mut_view(*b), MIR_BINOP_SHR, u64_ty_v, view(r), view(sh_c), sp);
            }
            mb_intr_cast_into(mut_view(*b), view(*dest), view(r), w_ty_v, sp);
        }
    } else if op == INTR_OP_REVERSE_BITS {
        let x = mb_intr_materialize(mut_view(*b), view(a), w_ty_v, sp);
        if bits == 128u32 {
            let xu = mb_intr_cast(mut_view(*b), view(x), w_ty_v, u_ty_v, sp);
            let lo64 = mb_intr_cast(mut_view(*b), view(xu), u_ty_v, u64_ty_v, sp);
            let c64 = mb_intr_const_op(u32_ty_v, 64u64);
            let hi128 = mb_intr_binop(mut_view(*b), MIR_BINOP_SHR, u_ty_v, view(xu), view(c64), sp);
            let hi64 = mb_intr_cast(mut_view(*b), view(hi128), u_ty_v, u64_ty_v, sp);
            let rlo = mb_intr_bitrev64(mut_view(*b), view(lo64), sp);
            let rhi = mb_intr_bitrev64(mut_view(*b), view(hi64), sp);
            let rlo128 = mb_intr_cast(mut_view(*b), view(rlo), u64_ty_v, u_ty_v, sp);
            let rhi128 = mb_intr_cast(mut_view(*b), view(rhi), u64_ty_v, u_ty_v, sp);
            let new_hi = mb_intr_binop(mut_view(*b), MIR_BINOP_SHL, u_ty_v, view(rlo128), view(c64), sp);
            let r = mb_intr_binop(mut_view(*b), MIR_BINOP_BIT_OR, u_ty_v, view(new_hi), view(rhi128), sp);
            if w_ty_v == u_ty_v {
                mb_intr_finish_use(mut_view(*b), view(*dest), view(r), sp);
            } else {
                mb_intr_cast_into(mut_view(*b), view(*dest), view(r), w_ty_v, sp);
            }
        } else {
            let z = mb_intr_zext64(mut_view(*b), view(x), w_ty_v, u_ty_v, sp);
            let mut r = mb_intr_bitrev64(mut_view(*b), view(z), sp);
            if bits < 64u32 {
                let sh_c = mb_intr_const_op(u32_ty_v, (64u32 - bits) as u64);
                r = mb_intr_binop(mut_view(*b), MIR_BINOP_SHR, u64_ty_v, view(r), view(sh_c), sp);
            }
            mb_intr_cast_into(mut_view(*b), view(*dest), view(r), w_ty_v, sp);
        }
    }
    true
}

fn mb_get_ordering(b: view<MirBuilder>, ord_expr: *const HirExpr) -> u8 {
    if (ord_expr as usize) == 0 {
        return MIR_ORDER_SEQ_CST;
    }
    let vp = unsafe { thir_get_expr_variant(view(*b.thir), ord_expr) };
    if (vp as usize) != 0 {
        let v = unsafe { *vp };
        if v <= 4u32 {
            return v as u8;
        }
    }
    let ek = unsafe { (*ord_expr).kind };
    if ek == HIR_EXPR_FIELD || ek == HIR_EXPR_PATH {
        let mut sv = StrView { ptr: 0 as *const u8, len: 0 };
        if ek == HIR_EXPR_FIELD {
            let fv = unsafe { (*ord_expr).name.v };
            if fv != 0u32 && (b.str_in as usize) != 0 {
                sv = unsafe { interner_get(view(*b.str_in), StrId { v: fv }) };
            }
        } else {
            let pv = unsafe { (*ord_expr).path.name.v };
            if pv != 0u32 && (b.str_in as usize) != 0 {
                sv = unsafe { interner_get(view(*b.str_in), StrId { v: pv }) };
            }
        }
        if mb_sv_eq_kw(view(sv), 13, 7) { return MIR_ORDER_RELAXED; }
        if mb_sv_eq_kw(view(sv), 20, 7) { return MIR_ORDER_ACQUIRE; }
        if mb_sv_eq_kw(view(sv), 27, 7) { return MIR_ORDER_RELEASE; }
        if mb_sv_eq_kw(view(sv), 34, 6) { return MIR_ORDER_ACQ_REL; }
        if mb_sv_eq_kw(view(sv), 40, 6) { return MIR_ORDER_SEQ_CST; }
    }
    MIR_ORDER_SEQ_CST
}

fn mb_emit_atomic_stmt(
    b: mut_view<MirBuilder>,
    aop: u8,
    ord: u8,
    fail_ord: u8,
    dst: view<MirPlace>,
    ptr_op: view<MirOperand>,
    val_op: view<MirOperand>,
    des_op: view<MirOperand>,
    sp: view<Span>
) {
    if aop <= MIR_ATOMIC_CMPXCHG_WEAK && aop != MIR_ATOMIC_STORE {
        let mut dst_ty_v: u32 = 0u32;
        if (b.body as usize) != 0 && (dst.local.v as usize) < (unsafe { (*b.body).local_count }) && dst.proj_count == 0 {
            let ldecl = unsafe { mir_local_at((*b.body).locals, dst.local.v as usize) };
            dst_ty_v = unsafe { (*ldecl).ty.v };
        }
        let init_op = mb_intr_const_op(dst_ty_v, 0u64);
        mb_emit_assign_use(mut_view(*b), dst, view(init_op), sp);
    }
    let mut stmt = MirStmt {
        kind: MIR_STMT_ATOMIC,
        span: Span { file: FileId { v: sp.file.v }, start: sp.start, end: sp.end },
        location: Span { file: FileId { v: sp.file.v }, start: sp.start, end: sp.end },
        place: mir_local_place(0u32),
        rvalue: MirRvalue {
            kind: MIR_RVALUE_USE,
            use_op: mb_intr_copy_op(mir_local_place(0u32)),
            repeat_count: 0u64,
            repeat_count_op: 0 as *mut MirOperand,
            borrow_kind: fail_ord,
            place: mir_local_place(0u32),
            cast_kind: ord,
            target_ty: TypeId { v: 0u32 },
            bin_op: aop,
            lhs: mb_intr_copy_op(mir_local_place(0u32)),
            rhs: mb_intr_copy_op(mir_local_place(0u32)),
            un_op: MIR_UNOP_NOT,
            variant_idx: 0u32,
            operands: 0 as *mut MirOperand,
            operand_count: 0,
        },
        storage_local: MirLocalId { v: 0u32 },
    };
    mir_copy_place(mut_view(stmt.place), dst);
    mir_copy_operand(mut_view(stmt.rvalue.use_op), ptr_op);
    mir_copy_operand(mut_view(stmt.rvalue.lhs), val_op);
    mir_copy_operand(mut_view(stmt.rvalue.rhs), des_op);
    mb_emit_stmt(mut_view(*b), view(stmt));
}

fn mb_emit_unit_to_dest(b: mut_view<MirBuilder>, dest: view<MirPlace>, has_dest: bool, sp: view<Span>) {
    if has_dest {
        let rv = MirRvalue {
            kind: MIR_RVALUE_AGGREGATE,
            use_op: mb_intr_copy_op(mir_local_place(0u32)),
            repeat_count: 0u64,
            repeat_count_op: 0 as *mut MirOperand,
            borrow_kind: MIR_BORROW_SHARED,
            place: mir_local_place(0u32),
            cast_kind: MIR_CAST_INT_TO_INT,
            target_ty: TypeId { v: 0u32 },
            bin_op: MIR_BINOP_ADD,
            lhs: mb_intr_copy_op(mir_local_place(0u32)),
            rhs: mb_intr_copy_op(mir_local_place(0u32)),
            un_op: MIR_UNOP_NOT,
            variant_idx: 0u32,
            operands: 0 as *mut MirOperand,
            operand_count: 0,
        };
        mb_emit_assign(mut_view(*b), dest, view(rv), sp);
    }
}

fn mb_try_build_atomic_call(
    b: mut_view<MirBuilder>,
    expr: *mut HirExpr,
    dest: mut_view<MirPlace>,
    has_dest: bool,
    sp: view<Span>
) -> bool {
    let callee_expr: *mut HirExpr = unsafe { (*expr).callee };
    let sym = SymbolId { v: unsafe { (*callee_expr).path.symbol.v } };
    let mut fn_item: *mut HirItem = 0 as *mut HirItem;
    if sym.v != 0u32 {
        fn_item = mb_find_item_by_sym_thir(b.thir as *const Thir, b.hir, sym);
    } else {
        let mut p_sv = StrView { ptr: 0 as *const u8, len: 0 };
        let pnv = unsafe { (*callee_expr).path.name.v };
        if pnv != 0u32 && (b.str_in as usize) != 0 {
            p_sv = unsafe { interner_get(view(*b.str_in), StrId { v: pnv }) };
        } else {
            let csp = Span {
                file: FileId { v: unsafe { (*callee_expr).span.file.v } },
                start: unsafe { (*callee_expr).span.start },
                end: unsafe { (*callee_expr).span.end },
            };
            p_sv = mb_span_sv(view(*b), view(csp));
        }
        fn_item = mb_find_item_by_path_sv(view(*b), view(p_sv));
    }
    if (fn_item as usize) == 0 || !mb_is_atomic_fn_item(b.hir, b.str_in, fn_item) {
        return false;
    }
    let fn_sv = mb_item_name_sv(view(*b), fn_item);
    let dummy_op = mb_intr_const_op(0u32, 0u64);
    let dummy_pl = mir_local_place(0u32);
    if mb_sv_eq_kw(view(fn_sv), 46, 5) {
        let arg0: *mut HirExpr = unsafe { (*expr).args };
        let ord = mb_get_ordering(view(*b), arg0);
        mb_emit_atomic_stmt(mut_view(*b), MIR_ATOMIC_FENCE, ord, 0u8, view(dummy_pl), view(dummy_op), view(dummy_op), view(dummy_op), sp);
        mb_emit_unit_to_dest(mut_view(*b), view(*dest), has_dest, sp);
        return true;
    }
    if mb_sv_eq_kw(view(fn_sv), 51, 14) {
        let arg0: *mut HirExpr = unsafe { (*expr).args };
        let ord = mb_get_ordering(view(*b), arg0);
        mb_emit_atomic_stmt(mut_view(*b), MIR_ATOMIC_COMPILER_FENCE, ord, 0u8, view(dummy_pl), view(dummy_op), view(dummy_op), view(dummy_op), sp);
        mb_emit_unit_to_dest(mut_view(*b), view(*dest), has_dest, sp);
        return true;
    }
    if mb_sv_eq_kw(view(fn_sv), 65, 14) {
        mb_emit_atomic_stmt(mut_view(*b), MIR_ATOMIC_SPIN_HINT, 0u8, 0u8, view(dummy_pl), view(dummy_op), view(dummy_op), view(dummy_op), sp);
        mb_emit_unit_to_dest(mut_view(*b), view(*dest), has_dest, sp);
        return true;
    }
    if mb_sv_eq_kw(view(fn_sv), 79, 12) {
        if has_dest {
            let bool_ty_v = unsafe { (*b.thir).interner.t_bool.v };
            let mut true_op = mb_intr_const_op(bool_ty_v, 1u64);
            true_op.constant.kind = MIR_CONST_BOOL;
            mb_emit_assign_use(mut_view(*b), view(*dest), view(true_op), sp);
        }
        return true;
    }
    false
}

fn mb_try_build_atomic_method_call(
    b: mut_view<MirBuilder>,
    expr: *mut HirExpr,
    method_item: *mut HirItem,
    dest: mut_view<MirPlace>,
    has_dest: bool,
    sp: view<Span>
) -> bool {
    if (method_item as usize) == 0 || !mb_is_atomic_fn_item(b.hir, b.str_in, method_item) {
        return false;
    }
    let m_sv = mb_item_name_sv(view(*b), method_item);
    let e_ty = mb_expr_ty(mut_view(*b), expr);
    if mb_sv_eq_kw(view(m_sv), 79, 12) {
        if has_dest {
            let bool_ty_v = unsafe { (*b.thir).interner.t_bool.v };
            let mut true_op = mb_intr_const_op(bool_ty_v, 1u64);
            true_op.constant.kind = MIR_CONST_BOOL;
            mb_emit_assign_use(mut_view(*b), view(*dest), view(true_op), sp);
        }
        return true;
    }
    if mb_sv_eq_kw(view(m_sv), 91, 3) {
        let arg0: *mut HirExpr = unsafe { (*expr).args };
        let mut op_v = mb_intr_copy_op(mir_local_place(0u32));
        mb_build_expr_as_operand(mut_view(*b), arg0, mut_view(op_v));
        if has_dest {
            let ops = unsafe {
                arena_alloc_raw(mut_view(*b.arena), size_of<MirOperand>(), align_of<MirOperand>()) as *mut MirOperand
            };
            unsafe {
                mir_copy_operand(mut_view(*ops), view(op_v));
            }
            let rv = MirRvalue {
                kind: MIR_RVALUE_AGGREGATE,
                use_op: mb_intr_copy_op(mir_local_place(0u32)),
                repeat_count: 0u64,
                repeat_count_op: 0 as *mut MirOperand,
                borrow_kind: MIR_BORROW_SHARED,
                place: mir_local_place(0u32),
                cast_kind: MIR_CAST_INT_TO_INT,
                target_ty: TypeId { v: 0u32 },
                bin_op: MIR_BINOP_ADD,
                lhs: mb_intr_copy_op(mir_local_place(0u32)),
                rhs: mb_intr_copy_op(mir_local_place(0u32)),
                un_op: MIR_UNOP_NOT,
                variant_idx: 0u32,
                operands: ops,
                operand_count: 1,
            };
            mb_emit_assign(mut_view(*b), view(*dest), view(rv), sp);
        }
        return true;
    }
    if mb_sv_eq_kw(view(m_sv), 94, 10) {
        let arg0: *mut HirExpr = unsafe { (*expr).args };
        let val_expr: *mut HirExpr = if (arg0 as usize) != 0 { arg0 } else { unsafe { (*expr).receiver } };
        let mut dummy_sl = false;
        let recv_pl = mir_build_lvalue(mut_view(*b), val_expr, mut_view(dummy_sl));
        if has_dest {
            let field_pl = mb_append_proj_field(mut_view(*b), view(recv_pl), 0u32);
            let mut op_f = mb_intr_copy_op(field_pl);
            op_f.location.file.v = sp.file.v;
            op_f.location.start = sp.start;
            op_f.location.end = sp.end;
            mb_emit_assign_use(mut_view(*b), view(*dest), view(op_f), sp);
        }
        return true;
    }

    let recv: *mut HirExpr = unsafe { (*expr).receiver };
    let recv_ty = mb_expr_ty(mut_view(*b), recv);
    let recv_ax = unsafe { type_get(view((*b.thir).interner), TypeId { v: recv_ty.v }) };
    let mut ptr_op = mb_intr_copy_op(mir_local_place(0u32));
    if (recv_ax as usize) != 0 && (unsafe { (*recv_ax).kind }) != TY_VIEW && (unsafe { (*recv_ax).kind }) != TY_MUT_VIEW && (unsafe { (*recv_ax).kind }) != TY_PTR {
        let mut dummy_sl = false;
        let recv_pl = mir_build_lvalue(mut_view(*b), recv, mut_view(dummy_sl));
        let view_ty = unsafe { intern_view_ty(mut_view((*b.thir).interner), TypeId { v: recv_ty.v }, false) };
        let tmp = mb_new_temp(mut_view(*b), view_ty, sp);
        let tmp_pl = mir_local_place(tmp.v);
        let mut ref_rv = MirRvalue {
            kind: MIR_RVALUE_REF,
            use_op: mb_intr_copy_op(mir_local_place(0u32)),
            repeat_count: 0u64,
            repeat_count_op: 0 as *mut MirOperand,
            borrow_kind: MIR_BORROW_SHARED,
            place: mir_local_place(0u32),
            cast_kind: MIR_CAST_INT_TO_INT,
            target_ty: TypeId { v: 0u32 },
            bin_op: MIR_BINOP_ADD,
            lhs: mb_intr_copy_op(mir_local_place(0u32)),
            rhs: mb_intr_copy_op(mir_local_place(0u32)),
            un_op: MIR_UNOP_NOT,
            variant_idx: 0u32,
            operands: 0 as *mut MirOperand,
            operand_count: 0,
        };
        mir_copy_place(mut_view(ref_rv.place), view(recv_pl));
        mb_emit_assign(mut_view(*b), view(tmp_pl), view(ref_rv), sp);
        ptr_op = mb_intr_copy_op(tmp_pl);
        ptr_op.location.file.v = sp.file.v;
        ptr_op.location.start = sp.start;
        ptr_op.location.end = sp.end;
    } else {
        mb_build_expr_as_operand(mut_view(*b), recv, mut_view(ptr_op));
    }

    let mut actual_dest = mir_local_place(0u32);
    if has_dest {
        mir_copy_place(mut_view(actual_dest), view(*dest));
    } else if !mb_sv_eq_kw(view(m_sv), 104, 5) {
        let tmp_d = mb_new_temp(mut_view(*b), TypeId { v: e_ty.v }, sp);
        actual_dest = mir_local_place(tmp_d.v);
    }

    let dummy_op = mb_intr_const_op(0u32, 0u64);
    let arg0: *mut HirExpr = unsafe { (*expr).args };
    if mb_sv_eq_kw(view(m_sv), 109, 4) {
        let ord = mb_get_ordering(view(*b), arg0);
        mb_emit_atomic_stmt(mut_view(*b), MIR_ATOMIC_LOAD, ord, 0u8, view(actual_dest), view(ptr_op), view(dummy_op), view(dummy_op), sp);
        return true;
    }
    if mb_sv_eq_kw(view(m_sv), 104, 5) {
        let mut val_op = mb_intr_copy_op(mir_local_place(0u32));
        mb_build_expr_as_operand(mut_view(*b), arg0, mut_view(val_op));
        let arg1: *mut HirExpr = if (arg0 as usize) != 0 { unsafe { (*arg0).next } } else { 0 as *mut HirExpr };
        let ord = mb_get_ordering(view(*b), arg1);
        let dummy_pl = mir_local_place(0u32);
        mb_emit_atomic_stmt(mut_view(*b), MIR_ATOMIC_STORE, ord, 0u8, view(dummy_pl), view(ptr_op), view(val_op), view(dummy_op), sp);
        mb_emit_unit_to_dest(mut_view(*b), view(*dest), has_dest, sp);
        return true;
    }
    let mut rmw_op: u8 = 255u8;
    if mb_sv_eq_kw(view(m_sv), 113, 4) { rmw_op = MIR_ATOMIC_SWAP; }
    else if mb_sv_eq_kw(view(m_sv), 117, 9) { rmw_op = MIR_ATOMIC_FETCH_ADD; }
    else if mb_sv_eq_kw(view(m_sv), 126, 9) { rmw_op = MIR_ATOMIC_FETCH_SUB; }
    else if mb_sv_eq_kw(view(m_sv), 135, 9) { rmw_op = MIR_ATOMIC_FETCH_AND; }
    else if mb_sv_eq_kw(view(m_sv), 144, 8) { rmw_op = MIR_ATOMIC_FETCH_OR; }
    else if mb_sv_eq_kw(view(m_sv), 152, 9) { rmw_op = MIR_ATOMIC_FETCH_XOR; }
    if rmw_op != 255u8 {
        let mut val_op = mb_intr_copy_op(mir_local_place(0u32));
        mb_build_expr_as_operand(mut_view(*b), arg0, mut_view(val_op));
        let arg1: *mut HirExpr = if (arg0 as usize) != 0 { unsafe { (*arg0).next } } else { 0 as *mut HirExpr };
        let ord = mb_get_ordering(view(*b), arg1);
        mb_emit_atomic_stmt(mut_view(*b), rmw_op, ord, 0u8, view(actual_dest), view(ptr_op), view(val_op), view(dummy_op), sp);
        return true;
    }
    let is_cmpxchg = mb_sv_eq_kw(view(m_sv), 161, 16);
    let is_cmpxchg_weak = mb_sv_eq_kw(view(m_sv), 177, 21);
    if is_cmpxchg || is_cmpxchg_weak {
        let mut exp_op = mb_intr_copy_op(mir_local_place(0u32));
        let mut des_op = mb_intr_copy_op(mir_local_place(0u32));
        mb_build_expr_as_operand(mut_view(*b), arg0, mut_view(exp_op));
        let arg1: *mut HirExpr = if (arg0 as usize) != 0 { unsafe { (*arg0).next } } else { 0 as *mut HirExpr };
        mb_build_expr_as_operand(mut_view(*b), arg1, mut_view(des_op));
        let arg2: *mut HirExpr = if (arg1 as usize) != 0 { unsafe { (*arg1).next } } else { 0 as *mut HirExpr };
        let arg3: *mut HirExpr = if (arg2 as usize) != 0 { unsafe { (*arg2).next } } else { 0 as *mut HirExpr };
        let succ_ord = mb_get_ordering(view(*b), arg2);
        let fail_ord = mb_get_ordering(view(*b), arg3);
        let aop = if is_cmpxchg { MIR_ATOMIC_CMPXCHG } else { MIR_ATOMIC_CMPXCHG_WEAK };
        mb_emit_atomic_stmt(mut_view(*b), aop, succ_ord, fail_ord, view(actual_dest), view(ptr_op), view(exp_op), view(des_op), sp);
        return true;
    }
    false
}

fn mb_build_control_or_call_expr(
    b: mut_view<MirBuilder>,
    expr: *mut HirExpr,
    dest: mut_view<MirPlace>,
    has_dest: bool
) {
    let sp = Span {
        file: FileId { v: unsafe { (*expr).span.file.v } },
        start: unsafe { (*expr).span.start },
        end: unsafe { (*expr).span.end },
    };
    let ek = unsafe {
        (*expr).kind
    };
