// HIR Desugaring, Unsafe Validation, and THIR S-Expression Emitter.
// Port of bootstrap/axiom0/src/types/typeck.c, bootstrap/axiom0/src/own/unsafe/unsafe.c,
// and bootstrap/axiom0/src/driver/emit_thir.c.
