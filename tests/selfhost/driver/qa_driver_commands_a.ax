pub const MIR_CONST_UNIT: u8 = 3u8;
pub const MIR_CONST_FN: u8 = 4u8;
pub const MIR_CONST_CLOSURE_SHIM: u8 = 5u8;
pub const MIR_CONST_INT128: u8 = MIR_CONST_INT;

pub struct MirConst {
    pub ty: TypeId,
    pub kind: u8,
    pub val: u64,
    pub str_bytes: *const u8,
    pub str_len: usize,
    pub sym: SymbolId,
}

pub fn mir_const_int_hi(c: view<MirConst>) -> u64 {
    if c.kind == MIR_CONST_INT {
        return c.str_len as u64;
    }
    0u64
}

pub fn mir_const_set_int_hi(c: mut_view<MirConst>, hi: u64) {
    c.str_len = hi as usize;
}

pub const MIR_OP_COPY: u8 = 0u8;
pub const MIR_OP_MOVE: u8 = 1u8;
pub const MIR_OP_CONST: u8 = 2u8;

