fn sv_is_spawn_name(sv: view<StrView>) -> u8 {
    if sv.len == 5 && (sv.ptr as usize) != 0 {
        let ok = unsafe {
            *(sv.ptr + 0) == 115u8 && *(sv.ptr + 1) == 112u8 &&
            *(sv.ptr + 2) == 97u8 && *(sv.ptr + 3) == 119u8 && *(sv.ptr + 4) == 110u8
        };
        if ok { return 1u8; }
    } else if sv.len == 11 && (sv.ptr as usize) != 0 {
        let ok = unsafe {
            *(sv.ptr + 0) == 115u8 && *(sv.ptr + 1) == 112u8 &&
            *(sv.ptr + 2) == 97u8 && *(sv.ptr + 3) == 119u8 && *(sv.ptr + 4) == 110u8 &&
            *(sv.ptr + 5) == 95u8 && *(sv.ptr + 6) == 108u8 && *(sv.ptr + 7) == 111u8 &&
            *(sv.ptr + 8) == 99u8 && *(sv.ptr + 9) == 97u8 && *(sv.ptr + 10) == 108u8
        };
        if ok { return 2u8; }
    }
    0u8
}

fn classify_spawn_call(cx: view<TypeckCtx>, expr: *const HirExpr) -> u8 {
    if (expr as usize) == 0 || (cx.str_in as usize) == 0 {
        return 0u8;
    }
    let ek = unsafe { (*expr).kind };
    if ek == HIR_EXPR_CALL {
        let callee: *mut HirExpr = unsafe { (*expr).callee };
        if (callee as usize) != 0 && (unsafe { (*callee).kind }) == HIR_EXPR_PATH {
            let p_sv = unsafe { tc_path_name_sv(cx, view((*callee).path)) };
            let k = sv_is_spawn_name(view(p_sv));
            if k != 0u8 { return k; }
            let pn_v = unsafe { (*callee).path.name.v };
            if pn_v != 0u32 {
                let sv2 = unsafe { interner_get(view(*cx.str_in), (StrId { v: pn_v })) };
                let k2 = sv_is_spawn_name(view(sv2));
                if k2 != 0u8 { return k2; }
            }
        }
    } else if ek == HIR_EXPR_METHOD_CALL {
        let mn_v = unsafe { (*expr).method_name.v };
        if mn_v != 0u32 {
            let sv = unsafe { interner_get(view(*cx.str_in), (StrId { v: mn_v })) };
            return sv_is_spawn_name(view(sv));
        }
    }
    0u8
}

const TC_NOTE_NOT_SEND_PTR: [35]u8 = [
    114u8, 97u8, 119u8, 32u8, 112u8, 111u8, 105u8, 110u8, 116u8, 101u8, 114u8, 115u8, 32u8,
    100u8, 111u8, 32u8, 110u8, 111u8, 116u8, 32u8, 105u8, 109u8, 112u8, 108u8, 101u8, 109u8,
    101u8, 110u8, 116u8, 32u8, 96u8, 83u8, 101u8, 110u8, 100u8,
];

const TC_NOTE_NOT_SEND_GEN: [52]u8 = [
    99u8, 97u8, 112u8, 116u8, 117u8, 114u8, 101u8, 100u8, 32u8, 116u8, 121u8, 112u8, 101u8, 32u8,
    100u8, 111u8, 101u8, 115u8, 32u8, 110u8, 111u8, 116u8, 32u8, 115u8, 97u8, 116u8, 105u8, 115u8,
    102u8, 121u8, 32u8, 96u8, 83u8, 101u8, 110u8, 100u8, 96u8, 32u8, 102u8, 111u8, 114u8, 32u8,
    96u8, 115u8, 112u8, 97u8, 119u8, 110u8, 96u8, 32u8, 99u8, 97u8,
];

const TC_NOTE_VIEW_PROVENANCE: [67]u8 = [
    110u8, 111u8, 110u8, 45u8, 101u8, 115u8, 99u8, 97u8, 112u8, 105u8, 110u8, 103u8, 32u8,
    99u8, 97u8, 112u8, 97u8, 98u8, 105u8, 108u8, 105u8, 116u8, 121u8, 32u8, 118u8, 105u8, 101u8,
    119u8, 32u8, 112u8, 114u8, 111u8, 118u8, 101u8, 110u8, 97u8, 110u8, 99u8, 101u8, 32u8,
    100u8, 111u8, 101u8, 115u8, 32u8, 110u8, 111u8, 116u8, 32u8, 111u8, 117u8, 116u8, 108u8,
    105u8, 118u8, 101u8, 32u8, 96u8, 115u8, 112u8, 97u8, 119u8, 110u8, 96u8, 32u8, 115u8, 99u8,
];

fn find_closure_expr_span(cx: view<TypeckCtx>, closure_sym: u32, fallback: Span) -> Span {
    let key = ((closure_sym as usize) << 3) | 4usize;
    let p = unsafe { ptr_itemmap_get(view((*cx.thir).expr_methods), key) };
    if (p as usize) != 0 {
        let fn_it = unsafe { *p };
        if (fn_it as usize) != 0 {
            return Span {
                file: (FileId { v: unsafe { (*fn_it).span.file.v } }),
                start: unsafe { (*fn_it).span.start },
                end: unsafe { (*fn_it).span.end },
            };
        }
    }
    fallback
}

fn tc_capture_type_name_sv(cx: view<TypeckCtx>, cap_ty: TypeId) -> StrView {
    if cap_ty.v == 0u32 || (cx.thir as usize) == 0 || (cx.str_in as usize) == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let t = unsafe { type_get(view((*cx.thir).interner), cap_ty) };
    if (t as usize) == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let tk = unsafe { (*t).kind };
    if (tk == TY_STRUCT || tk == TY_ENUM) && (unsafe { (*t).def as usize }) != 0 {
        let def_it = unsafe { (*t).def };
        let dn = unsafe { (*def_it).name };
        if dn.v != 0u32 {
            return unsafe { interner_get(view(*cx.str_in), dn) };
        }
    }
    StrView { ptr: 0 as *const u8, len: 0 }
}

fn emit_spawn_capture_diag(
    cx: mut_view<TypeckCtx>,
    code_v: u32,
    primary_sp: Span,
    cap_name: StrId,
    cap_ty: TypeId
) {
    if (cx.sink as usize) == 0 {
        return;
    }
    let sink = cx.sink;
    let code = (DiagCode { v: code_v });
    let sev = diag_code_severity(DiagCode { v: code_v });
    let msg_sv = if code_v == AX_CONC_CAPTURE_NOT_SEND {
        let p = unsafe { arena_alloc_raw(mut_view((*sink).arena), 65, 1) };
        let mut k: usize = 0;
        while k < 65 {
            unsafe { *(p + k) = TC_MSG_CAPTURE_NOT_SEND[k]; }
            k = k + 1;
        }
        StrView { ptr: p as *const u8, len: 65 }
    } else {
        let p = unsafe { arena_alloc_raw(mut_view((*sink).arena), 63, 1) };
        let mut k: usize = 0;
        while k < 63 {
            unsafe { *(p + k) = TC_MSG_ESCAPING_VIEW[k]; }
            k = k + 1;
        }
        StrView { ptr: p as *const u8, len: 63 }
    };
    let mut notes_ptr: *mut StrView = 0 as *mut StrView;
    let mut note_cnt: usize = 0;
    let tname_sv = tc_capture_type_name_sv(view(*cx), (TypeId { v: cap_ty.v }));
    if cap_name.v != 0u32 && (cx.str_in as usize) != 0 {
        let nsv = unsafe { interner_get(view(*cx.str_in), (StrId { v: cap_name.v })) };
        let nsv_len = nsv.len;
        let tn_len = tname_sv.len;
        let extra_ty = if tn_len > 0 && (tname_sv.ptr as usize) != 0 { 12 + tn_len + 1 } else { 1 };
        let nlen = 19 + nsv_len + extra_ty;
        let np = unsafe { arena_alloc_raw(mut_view((*sink).arena), nlen, 1) };
        let mut k: usize = 0;
        while k < 19 {
            unsafe { *(np + k) = TC_NOTE_CAP_PREFIX[k]; }
            k = k + 1;
        }
        let mut j: usize = 0;
        while j < nsv_len {
            unsafe { *(np + 19 + j) = *(nsv.ptr + j); }
            j = j + 1;
        }
        if tn_len > 0 && (tname_sv.ptr as usize) != 0 {
            let mut m: usize = 0;
            while m < 12 {
                unsafe { *(np + 19 + nsv_len + m) = TC_NOTE_HAS_TYPE[m]; }
                m = m + 1;
            }
            let mut r: usize = 0;
            while r < tn_len {
                unsafe { *(np + 19 + nsv_len + 12 + r) = *(tname_sv.ptr + r); }
                r = r + 1;
            }
            unsafe { *(np + 19 + nsv_len + 12 + tn_len) = 96u8; }
        } else {
            unsafe { *(np + 19 + nsv_len) = 96u8; }
        }
        let sref = unsafe { arena_alloc_raw(mut_view((*sink).arena), mul_usize(2, size_of<StrView>()), align_of<StrView>()) as *mut StrView };
        unsafe {
            (*sref).ptr = np as *const u8;
            (*sref).len = nlen;
        }
        let mut is_ptr_ty = false;
        if cap_ty.v != 0u32 && (cx.thir as usize) != 0 {
            let ct = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: cap_ty.v })) };
            if (ct as usize) != 0 && (unsafe { (*ct).kind }) == TY_PTR {
                is_ptr_ty = true;
            }
        }
        let sref2 = unsafe { (sref as usize + size_of<StrView>()) as *mut StrView };
        if code_v == AX_CONC_CAPTURE_NOT_SEND {
            if is_ptr_ty {
                let rp = unsafe { arena_alloc_raw(mut_view((*sink).arena), 36, 1) };
                let mut q: usize = 0;
                while q < 35 {
                    unsafe { *(rp + q) = TC_NOTE_NOT_SEND_PTR[q]; }
                    q = q + 1;
                }
                unsafe {
                    *(rp + 35) = 96u8;
                    (*sref2).ptr = rp as *const u8;
                    (*sref2).len = 36;
                }
            } else {
                let rp = unsafe { arena_alloc_raw(mut_view((*sink).arena), 50, 1) };
                let mut q: usize = 0;
                while q < 50 {
                    unsafe { *(rp + q) = TC_NOTE_NOT_SEND_GEN[q]; }
                    q = q + 1;
                }
                unsafe {
                    (*sref2).ptr = rp as *const u8;
                    (*sref2).len = 50;
                }
            }
        } else {
            let rp = unsafe { arena_alloc_raw(mut_view((*sink).arena), 65, 1) };
            let mut q: usize = 0;
            while q < 65 {
                unsafe { *(rp + q) = TC_NOTE_VIEW_PROVENANCE[q]; }
                q = q + 1;
            }
            unsafe {
                (*sref2).ptr = rp as *const u8;
                (*sref2).len = 65;
            }
        }
        notes_ptr = sref;
        note_cnt = 2;
    }
    let d = Diagnostic {
        code: code,
        severity: sev,
        message: msg_sv,
        primary: primary_sp,
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: notes_ptr,
        note_count: note_cnt,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    unsafe { diag_sink_report(mut_view(*sink), view(d)); }
}

fn emit_spawn_use_after_move_diag(cx: mut_view<TypeckCtx>, use_sp: Span, move_sp: Span) {
    if (cx.sink as usize) == 0 {
        return;
    }
    let sink = cx.sink;
    let code = (DiagCode { v: AX_MOVE_USE_AFTER_MOVE });
    let sev = diag_code_severity(DiagCode { v: AX_MOVE_USE_AFTER_MOVE });
    let msg_sv = unsafe { tc_alloc_diag_msg(mut_view((*sink).arena), (AX_MOVE_USE_AFTER_MOVE - 44u32) as usize) };
    let lp = unsafe { arena_alloc_raw(mut_view((*sink).arena), 37, 1) };
    let mut k: usize = 0;
    while k < 37 {
        unsafe { *(lp + k) = TC_LBL_MOVED_INTO_SPAWN[k]; }
        k = k + 1;
    }
    let lbl = unsafe { arena_alloc_raw(mut_view((*sink).arena), size_of<DiagLabel>(), align_of<DiagLabel>()) as *mut DiagLabel };
    unsafe {
        (*lbl).span.file.v = move_sp.file.v;
        (*lbl).span.start = move_sp.start;
        (*lbl).span.end = move_sp.end;
        (*lbl).message.ptr = lp as *const u8;
        (*lbl).message.len = 37;
    }
    let d = Diagnostic {
        code: code,
        severity: sev,
        message: msg_sv,
        primary: use_sp,
        labels: lbl,
        label_count: 1,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    unsafe { diag_sink_report(mut_view(*sink), view(d)); }
}

fn sync_closure_fn_item_types(cx: mut_view<TypeckCtx>, clos_t: *mut AxType) {
    if (clos_t as usize) == 0 {
        return;
    }
    let cap_count = unsafe { (*clos_t).capture_count };
    let caps = unsafe { (*clos_t).captures };
    let csym = unsafe { (*clos_t).fn_sym };
    let fn_ptr = unsafe { ptr_itemmap_get(view((*cx.thir).expr_methods), ((csym as usize) << 3) | 4usize) };
    let fn_item = if (fn_ptr as usize) != 0 { (unsafe { *fn_ptr }) as *mut HirItem } else { 0 as *mut HirItem };
    if (fn_item as usize) != 0 {
        let mut p: *mut HirParam = unsafe { (*fn_item).params };
        let mut i: usize = 0;
        while i < cap_count && (p as usize) != 0 {
            let cc = unsafe { capture_at(caps, i) };
            let cty_v = unsafe { (*cc).ty.v };
            let psym_v = unsafe { (*p).symbol.v };
            unsafe {
                thir_set_param_type(mut_view(*cx.thir), p, (TypeId { v: cty_v }));
                thir_set_sym_type(mut_view(*cx.thir), (SymbolId { v: psym_v }), (TypeId { v: cty_v }));
            }
            p = unsafe { (*p).next };
            i = i + 1;
        }
    }
    let fn_ty_v = unsafe { (*clos_t).fn_type.v };
    if fn_ty_v != 0u32 {
        let fn_t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: fn_ty_v })) };
        if (fn_t as usize) != 0 && (unsafe { (*fn_t).kind }) == TY_FN {
            let pcount = unsafe { (*fn_t).param_count };
            let ptypes = unsafe { (*fn_t).param_types };
            let mut i: usize = 0;
            while i < cap_count && i < pcount && (ptypes as usize) != 0 {
                let cc = unsafe { capture_at(caps, i) };
                unsafe { (*typeid_at(ptypes, i)).v = (*cc).ty.v; }
                i = i + 1;
            }
        }
    }
}

fn tc_get_closure_cap_name(cx: view<TypeckCtx>, closure_sym: u32, cap_idx: usize) -> StrId {
    let fn_ptr = unsafe { ptr_itemmap_get(view((*cx.thir).expr_methods), ((closure_sym as usize) << 3) | 4usize) };
    if (fn_ptr as usize) == 0 {
        return StrId { v: 0u32 };
    }
    let fn_item = (unsafe { *fn_ptr }) as *const HirItem;
    if (fn_item as usize) == 0 {
        return StrId { v: 0u32 };
    }
    let mut p: *mut HirParam = unsafe { (*fn_item).params };
    let mut i: usize = 0;
    while (p as usize) != 0 {
        if i == cap_idx {
            return StrId { v: unsafe { (*p).name.v } };
        }
        p = unsafe { (*p).next };
        i = i + 1;
    }
    StrId { v: 0u32 }
}

fn verify_closure_at_boundary(
    cx: mut_view<TypeckCtx>,
    clos_t: *mut AxType,
    boundary_kind: u8,
    call_sp: Span
) {
    if (clos_t as usize) == 0 || (cx.hir as usize) == 0 || (cx.str_in as usize) == 0 {
        return;
    }
    let csym = unsafe { (*clos_t).fn_sym };
    if boundary_kind == 1u8 || boundary_kind == 2u8 {
        unsafe {
            (*clos_t).is_repr_c = true;
        }
    }
    let clos_sp = find_closure_expr_span(
        view(*cx),
        csym,
        Span { file: (FileId { v: call_sp.file.v }), start: call_sp.start, end: call_sp.end }
    );
    let diag_sp = if boundary_kind == 3u8 {
        Span { file: (FileId { v: clos_sp.file.v }), start: clos_sp.start, end: clos_sp.end }
    } else {
        Span { file: (FileId { v: call_sp.file.v }), start: call_sp.start, end: call_sp.end }
    };
    let cap_count = unsafe { (*clos_t).capture_count };
    let caps = unsafe { (*clos_t).captures };
    let send_sv = StrView { ptr: unsafe { address_of(TC_SEND_TRAIT_NAME[0]) }, len: 4 };
    let mut changed = false;
    let mut i: usize = 0;
    while i < cap_count {
        let cc = unsafe { capture_at(caps, i) };
        let sym_v = unsafe { (*cc).sym.v };
        let mode = unsafe { (*cc).mode };
        let cname = tc_get_closure_cap_name(view(*cx), csym, i);
        let cty_v = unsafe { (*cc).ty.v };
        let vty = unsafe { thir_get_symbol_type(view(*cx.thir), (SymbolId { v: sym_v })) };
        let base_ty = if vty.v != 0u32 {
            resolve_ty(mut_view(*cx), (TypeId { v: vty.v }))
        } else {
            resolve_ty(mut_view(*cx), (TypeId { v: cty_v }))
        };
        let has_view = type_contains_view(mut_view(*cx), (TypeId { v: base_ty.v }));
        if has_view || mode == CAP_MUT_VIEW {
            emit_spawn_capture_diag(
                mut_view(*cx),
                AX_CONC_ESCAPING_VIEW,
                Span { file: (FileId { v: diag_sp.file.v }), start: diag_sp.start, end: diag_sp.end },
                (StrId { v: cname.v }),
                (TypeId { v: cty_v })
            );
        } else {
            if (boundary_kind == 1u8 || boundary_kind == 2u8) && mode != CAP_MOVE {
                let is_c = unsafe { type_is_copy((TypeId { v: base_ty.v }), view(*cx.thir), view(*cx.str_in)) };
                if !is_c {
                    unsafe {
                        (*cc).mode = CAP_MOVE;
                        (*cc).ty.v = base_ty.v;
                    }
                    changed = true;
                }
            }
            if boundary_kind == 1u8 && (cx.db as usize) != 0 {
                let ok_send = unsafe {
                    type_satisfies_auto_trait(
                        view(*cx.hir),
                        view(*cx.thir),
                        (TypeId { v: base_ty.v }),
                        1u8,
                        10007u32,
                        view(send_sv),
                        view(*cx.str_in),
                        view(*cx.db),
                        0
                    )
                };
                if !ok_send {
                    emit_spawn_capture_diag(
                        mut_view(*cx),
                        AX_CONC_CAPTURE_NOT_SEND,
                        Span { file: (FileId { v: diag_sp.file.v }), start: diag_sp.start, end: diag_sp.end },
                        (StrId { v: cname.v }),
                        (TypeId { v: base_ty.v })
                    );
                }
            }
        }
        i = i + 1;
    }
    if changed {
        sync_closure_fn_item_types(mut_view(*cx), clos_t);
    }
    let fn_ty_v = unsafe { (*clos_t).fn_type.v };
    if fn_ty_v != 0u32 {
        let fn_t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: fn_ty_v })) };
        if (fn_t as usize) != 0 && (unsafe { (*fn_t).kind }) == TY_FN {
            let ret_ty = resolve_ty(mut_view(*cx), TypeId { v: unsafe { (*fn_t).ret_type.v } });
            if ret_ty.v != 0u32 {
                let ret_view = type_contains_view(mut_view(*cx), (TypeId { v: ret_ty.v }));
                if ret_view {
                    emit_spawn_capture_diag(
                        mut_view(*cx),
                        AX_CONC_ESCAPING_VIEW,
                        Span { file: (FileId { v: diag_sp.file.v }), start: diag_sp.start, end: diag_sp.end },
                        StrId { v: 0u32 },
                        (TypeId { v: ret_ty.v })
                    );
                } else if boundary_kind == 1u8 && (cx.db as usize) != 0 && (cx.sink as usize) != 0 {
                    let ok_ret = unsafe {
                        type_satisfies_auto_trait(
                            view(*cx.hir),
                            view(*cx.thir),
                            (TypeId { v: ret_ty.v }),
                            1u8,
                            10007u32,
                            view(send_sv),
                            view(*cx.str_in),
                            view(*cx.db),
                            0
                        )
                    };
                    if !ok_ret {
                        unsafe {
                            emit_conc_bound_diag(
                                view(*cx.hir),
                                view(*cx.thir),
                                (TypeId { v: ret_ty.v }),
                                1u8,
                                10007u32,
                                view(send_sv),
                                view(*cx.str_in),
                                view(*cx.db),
                                mut_view(*cx.sink),
                                Span { file: (FileId { v: diag_sp.file.v }), start: diag_sp.start, end: diag_sp.end }
                            );
                        }
                    }
                }
            }
        }
    }
}

fn scan_spawn_boundaries_block(cx: mut_view<TypeckCtx>, blk: *const HirBlock, is_tail: bool) {
    if (blk as usize) == 0 {
        return;
    }
    let mut s: *mut HirStmt = unsafe { (*blk).stmts };
    while (s as usize) != 0 {
        let sk = unsafe { (*s).kind };
        let next_s: *mut HirStmt = unsafe { (*s).next };
        if sk == HIR_STMT_LET {
            let e: *mut HirExpr = unsafe { (*s).expr };
            let eb: *mut HirBlock = unsafe { (*s).else_block };
            if (e as usize) != 0 { scan_spawn_boundaries_expr(mut_view(*cx), e, false); }
            if (eb as usize) != 0 { scan_spawn_boundaries_block(mut_view(*cx), eb, false); }
        } else if sk == HIR_STMT_ASSIGN {
            let l: *mut HirExpr = unsafe { (*s).left };
            let r: *mut HirExpr = unsafe { (*s).right };
            if (l as usize) != 0 { scan_spawn_boundaries_expr(mut_view(*cx), l, false); }
            if (r as usize) != 0 { scan_spawn_boundaries_expr(mut_view(*cx), r, false); }
        } else if sk == HIR_STMT_EXPR {
            let e: *mut HirExpr = unsafe { (*s).expr };
            let tail_here = is_tail && (next_s as usize) == 0 && !(unsafe { (*s).has_semi });
            if (e as usize) != 0 { scan_spawn_boundaries_expr(mut_view(*cx), e, tail_here); }
        }
        s = next_s;
    }
}

fn scan_spawn_boundaries_expr(cx: mut_view<TypeckCtx>, expr: *const HirExpr, is_ret_pos: bool) {
    if (expr as usize) == 0 {
        return;
    }
    let ek = unsafe { (*expr).kind };
    if is_ret_pos {
        let et_v = unsafe { thir_get_expr_type(view(*cx.thir), expr).v };
        if et_v != 0u32 {
            let et = resolve_ty(mut_view(*cx), TypeId { v: et_v });
            let t = unsafe { type_get(view((*cx.thir).interner), et) };
            if (t as usize) != 0 && (unsafe { (*t).kind }) == TY_CLOSURE {
                let sp = Span {
                    file: (FileId { v: unsafe { (*expr).span.file.v } }),
                    start: unsafe { (*expr).span.start },
                    end: unsafe { (*expr).span.end },
                };
                verify_closure_at_boundary(mut_view(*cx), t as *mut AxType, 3u8, sp);
            }
        }
    }
    if ek == HIR_EXPR_CALL || ek == HIR_EXPR_METHOD_CALL {
        if ek == HIR_EXPR_CALL {
            let callee: *mut HirExpr = unsafe { (*expr).callee };
            if (callee as usize) != 0 { scan_spawn_boundaries_expr(mut_view(*cx), callee, false); }
        } else {
            let recv: *mut HirExpr = unsafe { (*expr).receiver };
            if (recv as usize) != 0 { scan_spawn_boundaries_expr(mut_view(*cx), recv, false); }
        }
        let mut a: *mut HirExpr = unsafe { (*expr).args };
        while (a as usize) != 0 {
            scan_spawn_boundaries_expr(mut_view(*cx), a, false);
            a = unsafe { (*a).next };
        }
        let sk = classify_spawn_call(view(*cx), expr);
        if sk != 0u8 {
            let call_sp = Span {
                file: (FileId { v: unsafe { (*expr).span.file.v } }),
                start: unsafe { (*expr).span.start },
                end: unsafe { (*expr).span.end },
            };
            let send_sv = StrView { ptr: unsafe { address_of(TC_SEND_TRAIT_NAME[0]) }, len: 4 };
            let mut arg: *mut HirExpr = unsafe { (*expr).args };
            while (arg as usize) != 0 {
                let at_v = unsafe { thir_get_expr_type(view(*cx.thir), arg).v };
                if at_v != 0u32 {
                    let arg_ty = resolve_ty(mut_view(*cx), TypeId { v: at_v });
                    let at = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: arg_ty.v })) };
                    if (at as usize) != 0 && (unsafe { (*at).kind }) == TY_CLOSURE {
                        verify_closure_at_boundary(
                            mut_view(*cx),
                            at as *mut AxType,
                            sk,
                            Span { file: (FileId { v: call_sp.file.v }), start: call_sp.start, end: call_sp.end }
                        );
                    } else if arg_ty.v != 0u32 {
                        let arg_sp = Span {
                            file: (FileId { v: unsafe { (*arg).span.file.v } }),
                            start: unsafe { (*arg).span.start },
                            end: unsafe { (*arg).span.end },
                        };
                        let has_view = type_contains_view(mut_view(*cx), (TypeId { v: arg_ty.v }));
                        if has_view {
                            let mut aname = StrId { v: 0u32 };
                            if (unsafe { (*arg).kind }) == HIR_EXPR_PATH {
                                aname.v = unsafe { (*arg).path.name.v };
                            }
                            emit_spawn_capture_diag(
                                mut_view(*cx),
                                AX_CONC_ESCAPING_VIEW,
                                Span { file: (FileId { v: arg_sp.file.v }), start: arg_sp.start, end: arg_sp.end },
                                aname,
                                (TypeId { v: arg_ty.v })
                            );
                        } else if sk == 1u8 && (cx.db as usize) != 0 {
                            let ok_send = unsafe {
                                type_satisfies_auto_trait(
                                    view(*cx.hir),
                                    view(*cx.thir),
                                    (TypeId { v: arg_ty.v }),
                                    1u8,
                                    10007u32,
                                    view(send_sv),
                                    view(*cx.str_in),
                                    view(*cx.db),
                                    0
                                )
                            };
                            if !ok_send {
                                if (unsafe { (*arg).kind }) == HIR_EXPR_PATH && (unsafe { (*arg).path.name.v }) != 0u32 {
                                    emit_spawn_capture_diag(
                                        mut_view(*cx),
                                        AX_CONC_CAPTURE_NOT_SEND,
                                        Span { file: (FileId { v: arg_sp.file.v }), start: arg_sp.start, end: arg_sp.end },
                                        StrId { v: unsafe { (*arg).path.name.v } },
                                        (TypeId { v: arg_ty.v })
                                    );
                                } else if (cx.sink as usize) != 0 {
                                    unsafe {
                                        emit_conc_bound_diag(
                                            view(*cx.hir),
                                            view(*cx.thir),
                                            (TypeId { v: arg_ty.v }),
                                            1u8,
                                            10007u32,
                                            view(send_sv),
                                            view(*cx.str_in),
                                            view(*cx.db),
                                            mut_view(*cx.sink),
                                            Span { file: (FileId { v: arg_sp.file.v }), start: arg_sp.start, end: arg_sp.end }
                                        );
                                    }
                                }
                            }
                        }
                    }
                }
                arg = unsafe { (*arg).next };
            }
        }
    } else if ek == HIR_EXPR_BLOCK || ek == HIR_EXPR_UNSAFE {
        let blk: *mut HirBlock = unsafe { (*expr).block };
        scan_spawn_boundaries_block(mut_view(*cx), blk, is_ret_pos);
    } else if ek == HIR_EXPR_IF {
        let cond_e: *mut HirExpr = unsafe { (*expr).cond };
        let blk: *mut HirBlock = unsafe { (*expr).block };
        let else_e: *mut HirExpr = unsafe { (*expr).else_branch };
        if (cond_e as usize) != 0 { scan_spawn_boundaries_expr(mut_view(*cx), cond_e, false); }
        if (blk as usize) != 0 { scan_spawn_boundaries_block(mut_view(*cx), blk, is_ret_pos); }
        if (else_e as usize) != 0 { scan_spawn_boundaries_expr(mut_view(*cx), else_e, is_ret_pos); }
    } else if ek == HIR_EXPR_WHILE {
        let cond_e: *mut HirExpr = unsafe { (*expr).cond };
        let blk: *mut HirBlock = unsafe { (*expr).block };
        if (cond_e as usize) != 0 { scan_spawn_boundaries_expr(mut_view(*cx), cond_e, false); }
        if (blk as usize) != 0 { scan_spawn_boundaries_block(mut_view(*cx), blk, false); }
    } else if ek == HIR_EXPR_FOR {
        let iter_e: *mut HirExpr = unsafe { (*expr).iter };
        let blk: *mut HirBlock = unsafe { (*expr).block };
        if (iter_e as usize) != 0 { scan_spawn_boundaries_expr(mut_view(*cx), iter_e, false); }
        if (blk as usize) != 0 { scan_spawn_boundaries_block(mut_view(*cx), blk, false); }
    } else if ek == HIR_EXPR_MATCH {
        let m_e: *mut HirExpr = unsafe { (*expr).cond };
        if (m_e as usize) != 0 { scan_spawn_boundaries_expr(mut_view(*cx), m_e, false); }
        let mut arm: *mut HirMatchArm = unsafe { (*expr).arms };
        while (arm as usize) != 0 {
            let ag: *mut HirExpr = unsafe { (*arm).guard };
            let ab: *mut HirExpr = unsafe { (*arm).body };
            if (ag as usize) != 0 { scan_spawn_boundaries_expr(mut_view(*cx), ag, false); }
            if (ab as usize) != 0 { scan_spawn_boundaries_expr(mut_view(*cx), ab, is_ret_pos); }
            arm = unsafe { (*arm).next };
        }
    } else if ek == HIR_EXPR_BINARY {
        let l: *mut HirExpr = unsafe { (*expr).left };
        let r: *mut HirExpr = unsafe { (*expr).right };
        if (l as usize) != 0 { scan_spawn_boundaries_expr(mut_view(*cx), l, false); }
        if (r as usize) != 0 { scan_spawn_boundaries_expr(mut_view(*cx), r, false); }
    } else if ek == HIR_EXPR_UNARY || ek == HIR_EXPR_CAST || ek == HIR_EXPR_VIEW || ek == HIR_EXPR_TRY || ek == HIR_EXPR_AWAIT {
        let ie: *mut HirExpr = unsafe { (*expr).inner };
        if (ie as usize) != 0 { scan_spawn_boundaries_expr(mut_view(*cx), ie, false); }
    } else if ek == HIR_EXPR_FIELD || ek == HIR_EXPR_TUPLE_INDEX {
        let b: *mut HirExpr = unsafe { (*expr).base };
        if (b as usize) != 0 { scan_spawn_boundaries_expr(mut_view(*cx), b, false); }
    } else if ek == HIR_EXPR_INDEX {
        let b: *mut HirExpr = unsafe { (*expr).base };
        let ia: *mut HirExpr = unsafe { (*expr).index_arg };
        if (b as usize) != 0 { scan_spawn_boundaries_expr(mut_view(*cx), b, false); }
        if (ia as usize) != 0 { scan_spawn_boundaries_expr(mut_view(*cx), ia, false); }
    } else if ek == HIR_EXPR_TUPLE || ek == HIR_EXPR_ARRAY {
        let mut e: *mut HirExpr = unsafe { (*expr).elems };
        while (e as usize) != 0 {
            scan_spawn_boundaries_expr(mut_view(*cx), e, false);
            e = unsafe { (*e).next };
        }
        let ce: *mut HirExpr = unsafe { (*expr).count_expr };
        if (ce as usize) != 0 { scan_spawn_boundaries_expr(mut_view(*cx), ce, false); }
    } else if ek == HIR_EXPR_STRUCT {
        let mut f: *mut HirFieldInit = unsafe { (*expr).fields };
        while (f as usize) != 0 {
            let fe: *mut HirExpr = unsafe { (*f).expr };
            if (fe as usize) != 0 { scan_spawn_boundaries_expr(mut_view(*cx), fe, false); }
            f = unsafe { (*f).next };
        }
    } else if ek == HIR_EXPR_JUMP {
        let je: *mut HirExpr = unsafe { (*expr).inner };
        let is_ret = (unsafe { (*expr).jump_kind }) == JUMP_RETURN;
        if (je as usize) != 0 { scan_spawn_boundaries_expr(mut_view(*cx), je, is_ret); }
    } else if ek == HIR_EXPR_CLOSURE {
        let cb: *mut HirExpr = unsafe { (*expr).body };
        if (cb as usize) != 0 { scan_spawn_boundaries_expr(mut_view(*cx), cb, true); }
    }
}

struct SpawnMoveTracker {
    syms: [64]u32,
    files: [64]u32,
    starts: [64]u32,
    ends: [64]u32,
    count: usize,
}

fn spawn_move_find(tr: view<SpawnMoveTracker>, sym_v: u32) -> isize {
    let cnt = tr.count;
    let mut i: usize = 0;
    while i < cnt {
        if tr.syms[i] == sym_v {
            return i as isize;
        }
        i = i + 1;
    }
    -1isize
}

fn spawn_move_record(tr: mut_view<SpawnMoveTracker>, sym_v: u32, sp: Span) {
    if sym_v == 0u32 {
        return;
    }
    let idx = spawn_move_find(view(*tr), sym_v);
    if idx >= 0isize {
        return;
    }
    let c = tr.count;
    if c < 64 {
        tr.syms[c] = sym_v;
        tr.files[c] = sp.file.v;
        tr.starts[c] = sp.start;
        tr.ends[c] = sp.end;
        tr.count = c + 1;
    }
}

fn spawn_move_get_span(tr: view<SpawnMoveTracker>, idx: usize) -> Span {
    Span {
        file: (FileId { v: tr.files[idx] }),
        start: tr.starts[idx],
        end: tr.ends[idx],
    }
}

fn spawn_move_clear(tr: mut_view<SpawnMoveTracker>, sym_v: u32) {
    let idx = spawn_move_find(view(*tr), sym_v);
    if idx >= 0isize {
        let u = idx as usize;
        tr.syms[u] = 0u32;
    }
}

fn check_spawn_moves_block(cx: mut_view<TypeckCtx>, blk: *const HirBlock, tr: mut_view<SpawnMoveTracker>) {
    if (blk as usize) == 0 {
        return;
    }
    let mut s: *mut HirStmt = unsafe { (*blk).stmts };
    while (s as usize) != 0 {
        let sk = unsafe { (*s).kind };
        if sk == HIR_STMT_LET {
            let e: *mut HirExpr = unsafe { (*s).expr };
            let eb: *mut HirBlock = unsafe { (*s).else_block };
            if (e as usize) != 0 { check_spawn_moves_expr(mut_view(*cx), e, mut_view(*tr)); }
            if (eb as usize) != 0 { check_spawn_moves_block(mut_view(*cx), eb, mut_view(*tr)); }
        } else if sk == HIR_STMT_ASSIGN {
            let l: *mut HirExpr = unsafe { (*s).left };
            let r: *mut HirExpr = unsafe { (*s).right };
            if (r as usize) != 0 { check_spawn_moves_expr(mut_view(*cx), r, mut_view(*tr)); }
            if (l as usize) != 0 {
                if (unsafe { (*l).kind }) == HIR_EXPR_PATH {
                    spawn_move_clear(mut_view(*tr), unsafe { (*l).path.symbol.v });
                } else {
                    check_spawn_moves_expr(mut_view(*cx), l, mut_view(*tr));
                }
            }
        } else if sk == HIR_STMT_EXPR {
            let e: *mut HirExpr = unsafe { (*s).expr };
            if (e as usize) != 0 { check_spawn_moves_expr(mut_view(*cx), e, mut_view(*tr)); }
        }
        s = unsafe { (*s).next };
    }
}

fn check_spawn_moves_expr(cx: mut_view<TypeckCtx>, expr: *const HirExpr, tr: mut_view<SpawnMoveTracker>) {
    if (expr as usize) == 0 {
        return;
    }
    let ek = unsafe { (*expr).kind };
    if ek == HIR_EXPR_PATH {
        let sym_v = unsafe { (*expr).path.symbol.v };
        if sym_v != 0u32 {
            let idx = spawn_move_find(view(*tr), sym_v);
            if idx >= 0isize {
                let use_sp = Span {
                    file: (FileId { v: unsafe { (*expr).span.file.v } }),
                    start: unsafe { (*expr).span.start },
                    end: unsafe { (*expr).span.end },
                };
                let mv_sp = spawn_move_get_span(view(*tr), idx as usize);
                emit_spawn_use_after_move_diag(mut_view(*cx), use_sp, mv_sp);
            }
        }
    } else if ek == HIR_EXPR_CLOSURE {
        let et_v = unsafe { thir_get_expr_type(view(*cx.thir), expr).v };
        if et_v != 0u32 {
            let et = resolve_ty(mut_view(*cx), TypeId { v: et_v });
            let t = unsafe { type_get(view((*cx.thir).interner), et) };
            if (t as usize) != 0 && (unsafe { (*t).kind }) == TY_CLOSURE {
                let is_spawned = unsafe { (*t).is_repr_c };
                let cap_count = unsafe { (*t).capture_count };
                let caps = unsafe { (*t).captures };
                let clos_sp = Span {
                    file: (FileId { v: unsafe { (*expr).span.file.v } }),
                    start: unsafe { (*expr).span.start },
                    end: unsafe { (*expr).span.end },
                };
                let mut i: usize = 0;
                while i < cap_count {
                    let cc = unsafe { capture_at(caps, i) };
                    let sym_v = unsafe { (*cc).sym.v };
                    let mode = unsafe { (*cc).mode };
                    if sym_v != 0u32 {
                        let idx = spawn_move_find(view(*tr), sym_v);
                        if idx >= 0isize {
                            let mv_sp = spawn_move_get_span(view(*tr), idx as usize);
                            emit_spawn_use_after_move_diag(
                                mut_view(*cx),
                                Span { file: (FileId { v: clos_sp.file.v }), start: clos_sp.start, end: clos_sp.end },
                                mv_sp
                            );
                        } else if is_spawned && mode == CAP_MOVE {
                            spawn_move_record(
                                mut_view(*tr),
                                sym_v,
                                Span { file: (FileId { v: clos_sp.file.v }), start: clos_sp.start, end: clos_sp.end }
                            );
                        }
                    }
                    i = i + 1;
                }
            }
        }
        let cb: *mut HirExpr = unsafe { (*expr).body };
        if (cb as usize) != 0 {
            let mut inner_tr = SpawnMoveTracker {
                syms: [0u32; 64],
                files: [0u32; 64],
                starts: [0u32; 64],
                ends: [0u32; 64],
                count: 0,
            };
            check_spawn_moves_expr(mut_view(*cx), cb, mut_view(inner_tr));
        }
    } else if ek == HIR_EXPR_CALL || ek == HIR_EXPR_METHOD_CALL {
        if ek == HIR_EXPR_CALL {
            let callee: *mut HirExpr = unsafe { (*expr).callee };
            if (callee as usize) != 0 { check_spawn_moves_expr(mut_view(*cx), callee, mut_view(*tr)); }
        } else {
            let recv: *mut HirExpr = unsafe { (*expr).receiver };
            if (recv as usize) != 0 { check_spawn_moves_expr(mut_view(*cx), recv, mut_view(*tr)); }
        }
        let sk = classify_spawn_call(view(*cx), expr);
        let mut a: *mut HirExpr = unsafe { (*expr).args };
        while (a as usize) != 0 {
            check_spawn_moves_expr(mut_view(*cx), a, mut_view(*tr));
            if sk != 0u8 && (unsafe { (*a).kind }) == HIR_EXPR_PATH {
                let sym_v = unsafe { (*a).path.symbol.v };
                if sym_v != 0u32 && (cx.str_in as usize) != 0 {
                    let at_v = unsafe { thir_get_expr_type(view(*cx.thir), a).v };
                    if at_v != 0u32 {
                        let arg_ty = resolve_ty(mut_view(*cx), TypeId { v: at_v });
                        let is_c = unsafe { type_is_copy(arg_ty, view(*cx.thir), view(*cx.str_in)) };
                        if !is_c {
                            let asp = Span {
                                file: (FileId { v: unsafe { (*a).span.file.v } }),
                                start: unsafe { (*a).span.start },
                                end: unsafe { (*a).span.end },
                            };
                            spawn_move_record(mut_view(*tr), sym_v, asp);
                        }
                    }
                }
            }
            a = unsafe { (*a).next };
        }
    } else if ek == HIR_EXPR_BLOCK || ek == HIR_EXPR_UNSAFE {
        let blk: *mut HirBlock = unsafe { (*expr).block };
        check_spawn_moves_block(mut_view(*cx), blk, mut_view(*tr));
    } else if ek == HIR_EXPR_IF {
        let cond_e: *mut HirExpr = unsafe { (*expr).cond };
        let blk: *mut HirBlock = unsafe { (*expr).block };
        let else_e: *mut HirExpr = unsafe { (*expr).else_branch };
        if (cond_e as usize) != 0 { check_spawn_moves_expr(mut_view(*cx), cond_e, mut_view(*tr)); }
        let save_cnt = tr.count;
        if (blk as usize) != 0 { check_spawn_moves_block(mut_view(*cx), blk, mut_view(*tr)); }
        let then_cnt = tr.count;
        if (else_e as usize) != 0 {
            tr.count = save_cnt;
            check_spawn_moves_expr(mut_view(*cx), else_e, mut_view(*tr));
            let else_cnt = tr.count;
            if then_cnt > else_cnt {
                tr.count = then_cnt;
            }
        }
    } else if ek == HIR_EXPR_WHILE {
        let cond_e: *mut HirExpr = unsafe { (*expr).cond };
        let blk: *mut HirBlock = unsafe { (*expr).block };
        if (cond_e as usize) != 0 { check_spawn_moves_expr(mut_view(*cx), cond_e, mut_view(*tr)); }
        if (blk as usize) != 0 { check_spawn_moves_block(mut_view(*cx), blk, mut_view(*tr)); }
    } else if ek == HIR_EXPR_FOR {
        let iter_e: *mut HirExpr = unsafe { (*expr).iter };
        let blk: *mut HirBlock = unsafe { (*expr).block };
        if (iter_e as usize) != 0 { check_spawn_moves_expr(mut_view(*cx), iter_e, mut_view(*tr)); }
        if (blk as usize) != 0 { check_spawn_moves_block(mut_view(*cx), blk, mut_view(*tr)); }
    } else if ek == HIR_EXPR_MATCH {
        let m_e: *mut HirExpr = unsafe { (*expr).cond };
        if (m_e as usize) != 0 { check_spawn_moves_expr(mut_view(*cx), m_e, mut_view(*tr)); }
        let mut arm: *mut HirMatchArm = unsafe { (*expr).arms };
        while (arm as usize) != 0 {
            let ag: *mut HirExpr = unsafe { (*arm).guard };
            let ab: *mut HirExpr = unsafe { (*arm).body };
            if (ag as usize) != 0 { check_spawn_moves_expr(mut_view(*cx), ag, mut_view(*tr)); }
            if (ab as usize) != 0 { check_spawn_moves_expr(mut_view(*cx), ab, mut_view(*tr)); }
            arm = unsafe { (*arm).next };
        }
    } else if ek == HIR_EXPR_BINARY {
        let l: *mut HirExpr = unsafe { (*expr).left };
        let r: *mut HirExpr = unsafe { (*expr).right };
        if (l as usize) != 0 { check_spawn_moves_expr(mut_view(*cx), l, mut_view(*tr)); }
        if (r as usize) != 0 { check_spawn_moves_expr(mut_view(*cx), r, mut_view(*tr)); }
    } else if ek == HIR_EXPR_UNARY || ek == HIR_EXPR_CAST || ek == HIR_EXPR_VIEW || ek == HIR_EXPR_TRY || ek == HIR_EXPR_AWAIT || ek == HIR_EXPR_JUMP {
        let ie: *mut HirExpr = unsafe { (*expr).inner };
        if (ie as usize) != 0 { check_spawn_moves_expr(mut_view(*cx), ie, mut_view(*tr)); }
    } else if ek == HIR_EXPR_FIELD || ek == HIR_EXPR_TUPLE_INDEX {
        let b: *mut HirExpr = unsafe { (*expr).base };
        if (b as usize) != 0 { check_spawn_moves_expr(mut_view(*cx), b, mut_view(*tr)); }
    } else if ek == HIR_EXPR_INDEX {
        let b: *mut HirExpr = unsafe { (*expr).base };
        let ia: *mut HirExpr = unsafe { (*expr).index_arg };
        if (b as usize) != 0 { check_spawn_moves_expr(mut_view(*cx), b, mut_view(*tr)); }
        if (ia as usize) != 0 { check_spawn_moves_expr(mut_view(*cx), ia, mut_view(*tr)); }
    } else if ek == HIR_EXPR_TUPLE || ek == HIR_EXPR_ARRAY {
        let mut e: *mut HirExpr = unsafe { (*expr).elems };
        while (e as usize) != 0 {
            check_spawn_moves_expr(mut_view(*cx), e, mut_view(*tr));
            e = unsafe { (*e).next };
        }
        let ce: *mut HirExpr = unsafe { (*expr).count_expr };
        if (ce as usize) != 0 { check_spawn_moves_expr(mut_view(*cx), ce, mut_view(*tr)); }
    } else if ek == HIR_EXPR_STRUCT {
        let mut f: *mut HirFieldInit = unsafe { (*expr).fields };
        while (f as usize) != 0 {
            let fe: *mut HirExpr = unsafe { (*f).expr };
            if (fe as usize) != 0 { check_spawn_moves_expr(mut_view(*cx), fe, mut_view(*tr)); }
            f = unsafe { (*f).next };
        }
    }
}

fn verify_closures_and_spawns(cx: mut_view<TypeckCtx>) {
    if (cx.hir as usize) == 0 || (cx.thir as usize) == 0 {
        return;
    }
    let mut it: *mut HirItem = unsafe { (*cx.hir).items };
    while (it as usize) != 0 {
        let ik = unsafe { (*it).kind };
        if ik == HIR_ITEM_FN {
            let sym_v = unsafe { (*it).symbol.v };
            if sym_v < 0x40000000u32 || sym_v >= 0x50000000u32 {
                let blk: *mut HirBlock = unsafe { (*it).body };
                if (blk as usize) != 0 {
                    scan_spawn_boundaries_block(mut_view(*cx), blk, true);
                }
            }
        } else if ik == HIR_ITEM_IMPL {
            let mut m: *mut HirItem = unsafe { (*it).members };
            while (m as usize) != 0 {
                if (unsafe { (*m).kind }) == HIR_ITEM_FN {
                    let mblk: *mut HirBlock = unsafe { (*m).body };
                    if (mblk as usize) != 0 {
                        scan_spawn_boundaries_block(mut_view(*cx), mblk, true);
                    }
                }
                m = unsafe { (*m).next };
            }
        }
        it = unsafe { (*it).next };
    }

    let mut it2: *mut HirItem = unsafe { (*cx.hir).items };
    while (it2 as usize) != 0 {
        let ik = unsafe { (*it2).kind };
        if ik == HIR_ITEM_FN {
            let sym_v = unsafe { (*it2).symbol.v };
            if sym_v < 0x40000000u32 || sym_v >= 0x50000000u32 {
                let blk: *mut HirBlock = unsafe { (*it2).body };
                if (blk as usize) != 0 {
                    let mut tr = SpawnMoveTracker {
                        syms: [0u32; 64],
                        files: [0u32; 64],
                        starts: [0u32; 64],
                        ends: [0u32; 64],
                        count: 0,
                    };
                    check_spawn_moves_block(mut_view(*cx), blk, mut_view(tr));
                }
            }
        } else if ik == HIR_ITEM_IMPL {
            let mut m: *mut HirItem = unsafe { (*it2).members };
            while (m as usize) != 0 {
                if (unsafe { (*m).kind }) == HIR_ITEM_FN {
                    let mblk: *mut HirBlock = unsafe { (*m).body };
                    if (mblk as usize) != 0 {
                        let mut tr = SpawnMoveTracker {
                            syms: [0u32; 64],
                            files: [0u32; 64],
                            starts: [0u32; 64],
                            ends: [0u32; 64],
                            count: 0,
                        };
                        check_spawn_moves_block(mut_view(*cx), mblk, mut_view(tr));
                    }
                }
                m = unsafe { (*m).next };
            }
        }
        it2 = unsafe { (*it2).next };
    }

    if (cx.str_in as usize) != 0 && (cx.db as usize) != 0 {
        let send_sv = StrView { ptr: unsafe { address_of(TC_SEND_TRAIT_NAME[0]) }, len: 4 };
        let share_sv = StrView { ptr: unsafe { address_of(TC_SHARE_TRAIT_NAME[0]) }, len: 5 };
        let tlen = unsafe { (*cx.thir).interner.len };
        let mut ti: u32 = 1u32;
        while (ti as usize) <= tlen {
            let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: ti })) };
            if (t as usize) != 0 && (unsafe { (*t).kind }) == TY_CLOSURE {
                let _ = unsafe {
                    type_satisfies_auto_trait(
                        view(*cx.hir),
                        view(*cx.thir),
                        (TypeId { v: ti }),
                        1u8,
                        10007u32,
                        view(send_sv),
                        view(*cx.str_in),
                        view(*cx.db),
                        0
                    )
                };
                let _ = unsafe {
                    type_satisfies_auto_trait(
                        view(*cx.hir),
                        view(*cx.thir),
                        (TypeId { v: ti }),
                        2u8,
                        10008u32,
                        view(share_sv),
                        view(*cx.str_in),
                        view(*cx.db),
                        0
                    )
                };
            }
            ti = ti + 1u32;
        }
    }
}

fn check_all_bounds(cx: mut_view<TypeckCtx>) {
    if (cx.hir as usize) == 0 || (cx.sink as usize) == 0 || (cx.str_in as usize) == 0 || (cx.db as usize) == 0 {
        return;
    }
    let ecap = unsafe { (*cx.thir).expr_substs.cap };
    let estates = unsafe { (*cx.thir).expr_substs.states };
    let ekeys = unsafe { (*cx.thir).expr_substs.keys };
    let evals = unsafe { (*cx.thir).expr_substs.vals };
    let mut i: usize = 0;
    while (i < ecap) {
        if (unsafe { *(estates + i) }) == SLOT_OCCUPIED {
            let ex_addr = unsafe { *usize_at(ekeys, i) };
            let ex = ex_addr as *const HirExpr;
            let args_ptr = unsafe { tc_subst_at(evals, i) };
            let acnt = unsafe { (*args_ptr).count };
            if (ex as usize) != 0 && acnt > 0 {
                let mut def: *const HirItem = 0 as *const HirItem;
                let ek = unsafe { (*ex).kind };
                if ek == HIR_EXPR_METHOD_CALL {
                    let mp = unsafe { thir_get_expr_method(view(*cx.thir), ex) };
                    if (mp as usize) != 0 {
                        def = unsafe { *mp };
                    }
                } else if ek == HIR_EXPR_CALL {
                    let callee: *mut HirExpr = unsafe { (*ex).callee };
                    if (callee as usize) != 0 && (unsafe { (*callee).kind }) == HIR_EXPR_PATH {
                        let csym_v = unsafe { (*callee).path.symbol.v };
                        def = find_item_by_symbol(view(*cx), (SymbolId { v: csym_v }));
                    }
                } else if ek == HIR_EXPR_PATH || ek == HIR_EXPR_STRUCT {
                    let esym_v = unsafe { (*ex).path.symbol.v };
                    def = find_item_by_symbol(view(*cx), (SymbolId { v: esym_v }));
                }
                let mut is_spawn_def = false;
                if (def as usize) != 0 && (unsafe { (*def).kind }) == HIR_ITEM_FN {
                    let dn_v = unsafe { (*def).name.v };
                    if dn_v != 0u32 {
                        let dsv = unsafe { interner_get(view(*cx.str_in), (StrId { v: dn_v })) };
                        is_spawn_def = sv_is_spawn_name(view(dsv)) != 0u8;
                    }
                }
                if (def as usize) != 0 && !is_spawn_def {
                    let sp_f = unsafe { (*ex).span.file.v };
                    let sp_s = unsafe { (*ex).span.start };
                    let sp_e = unsafe { (*ex).span.end };
                    let cfn_ptr = unsafe { ptr_itemmap_get(view((*cx.thir).expr_methods), ex_addr | 1usize) };
                    let cimpl_ptr = unsafe { ptr_itemmap_get(view((*cx.thir).expr_methods), ex_addr | 3usize) };
                    let cfn = if (cfn_ptr as usize) != 0 { unsafe { *cfn_ptr } } else { 0 as *const HirItem };
                    let cimpl = if (cimpl_ptr as usize) != 0 { unsafe { *cimpl_ptr } } else { 0 as *const HirItem };
                    unsafe {
                        ptr_itemmap_insert(mut_view((*cx.thir).expr_methods), 1usize, cfn);
                        ptr_itemmap_insert(mut_view((*cx.thir).expr_methods), 3usize, cimpl);
                    }
                    let _ = unsafe {
                        check_item_bounds(
                            view(*cx.hir),
                            view(*cx.thir),
                            def,
                            view(*args_ptr),
                            Span { file: (FileId { v: sp_f }), start: sp_s, end: sp_e },
                            view(*cx.str_in),
                            view(*cx.db),
                            mut_view(*cx.sink)
                        )
                    };
                    unsafe {
                        ptr_itemmap_insert(mut_view((*cx.thir).expr_methods), 1usize, 0 as *const HirItem);
                        ptr_itemmap_insert(mut_view((*cx.thir).expr_methods), 3usize, 0 as *const HirItem);
                    }
                }
            }
        }
        i = i + 1;
    }

    let pcap = unsafe { (*cx.thir).pat_substs.cap };
    let pstates = unsafe { (*cx.thir).pat_substs.states };
    let pkeys = unsafe { (*cx.thir).pat_substs.keys };
    let pvals = unsafe { (*cx.thir).pat_substs.vals };
    i = 0;
    while (i < pcap) {
        if (unsafe { *(pstates + i) }) == SLOT_OCCUPIED {
            let pat_addr = unsafe { *usize_at(pkeys, i) };
            let pat = pat_addr as *const HirPat;
            let args_ptr = unsafe { tc_subst_at(pvals, i) };
            let acnt = unsafe { (*args_ptr).count };
            if (pat as usize) != 0 && acnt > 0 {
                let mut def: *const HirItem = 0 as *const HirItem;
                let pk = unsafe { (*pat).kind };
                if pk == HIR_PAT_PATH || pk == HIR_PAT_STRUCT {
                    let psym_v = unsafe { (*pat).path.symbol.v };
                    def = find_item_by_symbol(view(*cx), (SymbolId { v: psym_v }));
                }
                if (def as usize) != 0 {
                    let sp_f = unsafe { (*pat).span.file.v };
                    let sp_s = unsafe { (*pat).span.start };
                    let sp_e = unsafe { (*pat).span.end };
                    let _ = unsafe {
                        check_item_bounds(
                            view(*cx.hir),
                            view(*cx.thir),
                            def,
                            view(*args_ptr),
                            Span { file: (FileId { v: sp_f }), start: sp_s, end: sp_e },
                            view(*cx.str_in),
                            view(*cx.db),
                            mut_view(*cx.sink)
                        )
                    };
                }
            }
        }
        i = i + 1;
    }
    unsafe { fix_unsatisfied_bound_msgs(mut_view(*cx.sink)); }
}

fn build_item_generic_param_args(cx: mut_view<TypeckCtx>, it: *const HirItem, out_count: mut_view<usize>) -> *mut TypeId {
    *out_count = 0;
    if (it as usize) == 0 {
        return 0 as *mut TypeId;
    }
    let gps: *mut HirGenericParams = unsafe { (*it).generic_params };
    if (gps as usize) == 0 {
        return 0 as *mut TypeId;
    }
    let mut cnt: usize = 0;
    let mut gp: *mut HirGenericParam = unsafe { (*gps).params };
    while ((gp as usize) != 0) {
        cnt = cnt + 1;
        gp = unsafe { (*gp).next };
    }
    if cnt == 0 {
        return 0 as *mut TypeId;
    }
    let bytes = mul_usize(cnt, size_of<TypeId>());
    let args = unsafe {
        arena_alloc_raw(mut_view((*cx.thir).interner.arena), bytes, align_of<TypeId>()) as *mut TypeId
    };
    let mut idx: usize = 0;
    gp = unsafe { (*gps).params };
    while ((gp as usize) != 0) {
        let mut p_name = unsafe { (*gp).name };
        if p_name.v == 0u32 && (cx.str_in as usize) != 0 && (cx.db as usize) != 0 {
            let sp_f = unsafe { (*gp).span.file.v };
            if sp_f != 0u32 {
                let sp_s = unsafe { (*gp).span.start };
                let sp_e = unsafe { (*gp).span.end };
                let sv = unsafe {
                    source_db_span_text(view(*cx.db), Span { file: (FileId { v: sp_f }), start: sp_s, end: sp_e })
                };
                if sv.len > 0 && (sv.ptr as usize) != 0 {
                    p_name = unsafe { interner_intern_bytes(mut_view(*cx.str_in), sv.ptr, sv.len) };
                }
            }
        }
        let pid = unsafe { intern_param_ty(mut_view((*cx.thir).interner), (StrId { v: p_name.v }), idx as u32) };
        let dst = unsafe { typeid_at(args, idx) };
        unsafe { (*dst).v = pid.v; }
        let gp_sym = unsafe { (*gp).symbol };
        if gp_sym.v != 0u32 {
            unsafe { thir_set_sym_type(mut_view(*cx.thir), (SymbolId { v: gp_sym.v }), (TypeId { v: pid.v })); }
        }
        idx = idx + 1;
        gp = unsafe { (*gp).next };
    }
    *out_count = cnt;
    args
}

fn item_has_repr_c(cx: view<TypeckCtx>, it: *const HirItem) -> bool {
    if (it as usize) == 0 || (cx.str_in as usize) == 0 {
        return false;
    }
    let mut a: *mut HirAttr = unsafe { (*it).attrs };
    while ((a as usize) != 0) {
        let aname_id = unsafe { (*a).name };
        if aname_id.v != 0u32 {
            let asv = unsafe { interner_get(view(*cx.str_in), (StrId { v: aname_id.v })) };
            if tc_sv_is_4(view(asv), 114u8, 101u8, 112u8, 114u8) {
                let mut arg: *mut HirAttrArg = unsafe { (*a).args };
                while ((arg as usize) != 0) {
                    let arg_name_id = unsafe { (*arg).name };
                    if arg_name_id.v != 0u32 {
                        let arg_sv = unsafe { interner_get(view(*cx.str_in), (StrId { v: arg_name_id.v })) };
                        if tc_sv_is_1(view(arg_sv), 99u8) || tc_sv_is_1(view(arg_sv), 67u8) {
                            return true;
                        }
                    }
                    let aex: *mut HirExpr = unsafe { (*arg).expr };
                    if (aex as usize) != 0 && (unsafe { (*aex).kind }) == HIR_EXPR_PATH {
                        let p_sv = unsafe { tc_path_name_sv(cx, view((*aex).path)) };
                        if tc_sv_is_1(view(p_sv), 99u8) || tc_sv_is_1(view(p_sv), 67u8) {
                            return true;
                        }
                    }
                    arg = unsafe { (*arg).next };
                }
            }
        }
        a = unsafe { (*a).next };
    }
    false
}

fn index_hir_items_in_thir(hir_file: view<HirFile>, thir: mut_view<Thir>) {
    ptr_itemmap_insert(mut_view(thir.expr_methods), 4usize, 0 as *const HirItem);
    let mut it: *mut HirItem = hir_file.items;
    while ((it as usize) != 0) {
        if (unsafe { (*it).span.file.v }) != 0xFFFFFFFEu32 {
            let sv = unsafe { (*it).symbol.v };
            if sv != 0u32 {
                let k = ((sv as usize) << 3) | 4usize;
                let existing = ptr_itemmap_get(view(thir.expr_methods), k);
                if (existing as usize) == 0 {
                    ptr_itemmap_insert(mut_view(thir.expr_methods), k, it as *const HirItem);
                }
            }
            if (unsafe { (*it).kind }) == HIR_ITEM_ENUM {
                let mut v: *mut HirVariantDecl = unsafe { (*it).variants };
                while ((v as usize) != 0) {
                    let vsv = unsafe { (*v).symbol.v };
                    if vsv != 0u32 {
                        let vk = ((vsv as usize) << 3) | 2usize;
                        let vexisting = ptr_itemmap_get(view(thir.expr_methods), vk);
                        if (vexisting as usize) == 0 {
                            ptr_itemmap_insert(mut_view(thir.expr_methods), vk, it as *const HirItem);
                        }
                    }
                    v = unsafe { (*v).next };
                }
            }
        }
        it = unsafe { (*it).next };
    }
    it = hir_file.items;
    while ((it as usize) != 0) {
        if (unsafe { (*it).span.file.v }) != 0xFFFFFFFEu32 {
            let ik = unsafe { (*it).kind };
            if ik == HIR_ITEM_IMPL || ik == HIR_ITEM_EXTERN_BLOCK || ik == HIR_ITEM_TRAIT {
                let mut m: *mut HirItem = unsafe { (*it).members };
                while ((m as usize) != 0) {
                    let msv = unsafe { (*m).symbol.v };
                    if msv != 0u32 {
                        let mk = ((msv as usize) << 3) | 4usize;
                        let mexisting = ptr_itemmap_get(view(thir.expr_methods), mk);
                        if (mexisting as usize) == 0 {
                            ptr_itemmap_insert(mut_view(thir.expr_methods), mk, m as *const HirItem);
                        }
                        if ik == HIR_ITEM_IMPL && (unsafe { (*m).kind }) == HIR_ITEM_FN {
                            let imk = ((msv as usize) << 3) | 6usize;
                            let imexisting = ptr_itemmap_get(view(thir.expr_methods), imk);
                            if (imexisting as usize) == 0 {
                                ptr_itemmap_insert(mut_view(thir.expr_methods), imk, m as *const HirItem);
                            }
                        }
                    }
                    m = unsafe { (*m).next };
                }
            }
        }
        it = unsafe { (*it).next };
    }
}

fn find_orig_impl_member_with_thir(hir_file: view<HirFile>, thir_ptr: *const Thir, top_fn: *const HirItem) -> *mut HirItem {
    if (top_fn as usize) == 0 {
        return 0 as *mut HirItem;
    }
    let sym_v = unsafe { (*top_fn).symbol.v };
    if sym_v == 0u32 {
        return 0 as *mut HirItem;
    }
    if (thir_ptr as usize) != 0 && (unsafe { (*thir_ptr).expr_methods.cap }) > 0 {
        let indexed: *mut *const HirItem = unsafe { ptr_itemmap_get(view((*thir_ptr).expr_methods), 4usize) };
        if (indexed as usize) != 0 {
            let imk: usize = ((sym_v as usize) << 3) | 6usize;
            let mp: *mut *const HirItem = unsafe { ptr_itemmap_get(view((*thir_ptr).expr_methods), imk) };
            if (mp as usize) != 0 {
                let m: *mut HirItem = (unsafe { *mp }) as *mut HirItem;
                if (m as usize) != 0 && (m as usize) != (top_fn as usize) {
                    return m;
                }
            }
            return 0 as *mut HirItem;
        }
    }
    let mut other: *mut HirItem = hir_file.items;
    while ((other as usize) != 0) {
        if (unsafe { (*other).kind }) == HIR_ITEM_IMPL {
            let mut m: *mut HirItem = unsafe { (*other).members };
            while ((m as usize) != 0) {
                if (m as usize) != (top_fn as usize) &&
                   (unsafe { (*m).kind }) == HIR_ITEM_FN &&
                   (unsafe { (*m).symbol.v }) == sym_v {
                    return m;
                }
                m = unsafe { (*m).next };
            }
        }
        other = unsafe { (*other).next };
    }
    0 as *mut HirItem
}

fn find_orig_impl_member(hir_file: view<HirFile>, top_fn: *const HirItem) -> *mut HirItem {
    find_orig_impl_member_with_thir(hir_file, 0 as *const Thir, top_fn)
}

fn register_item_sig(cx: mut_view<TypeckCtx>, it: *mut HirItem, parent_impl: *const HirItem) {
    if (it as usize) == 0 {
        return;
    }
    let ik = unsafe { (*it).kind };
    if ik == HIR_ITEM_FN {
        cx.current_fn = it;
        cx.current_impl = parent_impl;
        if (parent_impl as usize) != 0 {
            let pk = unsafe { (*parent_impl).kind };
            if pk == HIR_ITEM_IMPL {
                let st = unsafe { thir_get_item_type(view(*cx.thir), parent_impl) };
                cx.self_ty.v = st.v;
            } else {
                cx.self_ty.v = 0u32;
            }
        } else {
            cx.self_ty.v = 0u32;
        }

        let mut gp_cnt: usize = 0;
        let _ = build_item_generic_param_args(mut_view(*cx), it, mut_view(gp_cnt));

        let ret_node: *mut HirType = unsafe { (*it).ret_type };
        let ret_ty = if (ret_node as usize) != 0 {
            hir_type_to_typeid(mut_view(*cx), ret_node)
        } else {
            let uv = unsafe { (*cx.thir).interner.t_unit.v };
            (TypeId { v: uv })
        };

        let mut p_count: usize = 0;
        let mut p: *mut HirParam = unsafe { (*it).params };
        while ((p as usize) != 0) {
            p_count = p_count + 1;
            p = unsafe { (*p).next };
        }
        let mut p_types: *mut TypeId = 0 as *mut TypeId;
        if p_count > 0 {
            let bytes = mul_usize(p_count, size_of<TypeId>());
            p_types = unsafe {
                arena_alloc_raw(mut_view((*cx.thir).interner.arena), bytes, align_of<TypeId>()) as *mut TypeId
            };
        }
        let mut idx: usize = 0;
        p = unsafe { (*it).params };
        while ((p as usize) != 0) {
            let p_ty_node: *mut HirType = unsafe { (*p).ty };
            let mut pt = (TypeId { v: 0u32 });
            if (p_ty_node as usize) == 0 && idx == 0 && (cx.current_impl as usize) != 0 {
                if cx.self_ty.v != 0u32 {
                    pt.v = cx.self_ty.v;
                } else {
                    let sid = if (cx.str_in as usize) != 0 {
                        unsafe { tc_intern_idx(mut_view(*cx.str_in), 30) }
                    } else {
                        (StrId { v: 0u32 })
                    };
                    let sp_ty = unsafe { intern_param_ty(mut_view((*cx.thir).interner), (StrId { v: sid.v }), TC_SELF_PARAM_INDEX) };
                    pt.v = sp_ty.v;
                }
            } else {
                let h_pt = hir_type_to_typeid(mut_view(*cx), p_ty_node);
                pt.v = h_pt.v;
            }
            let dst = unsafe { typeid_at(p_types, idx) };
            unsafe { (*dst).v = pt.v; }
            // T161: a default-method instance shares its params with the trait member; their types stay the
            // member's (`Self` unsubstituted), as in axiom0 where pass 2 sets them for the checked body only.
            if !tc_is_default_inst(it as *const HirItem) {
                unsafe { thir_set_param_type(mut_view(*cx.thir), p, (TypeId { v: pt.v })); }
                let psym = unsafe { (*p).symbol };
                if psym.v != 0u32 && (cx.str_in as usize) == 0 && (cx.db as usize) == 0 {
                    unsafe { thir_set_sym_type(mut_view(*cx.thir), (SymbolId { v: psym.v }), (TypeId { v: pt.v })); }
                }
            }
            idx = idx + 1;
            p = unsafe { (*p).next };
        }
        let is_u = unsafe { (*it).is_unsafe };
        let abi_v = unsafe { (*it).abi.v };
        let fn_ty = unsafe {
            intern_fn_ty_full(
                mut_view((*cx.thir).interner),
                is_u,
                (StrId { v: abi_v }),
                p_types,
                p_count,
                (TypeId { v: ret_ty.v }),
                it
            )
        };
        unsafe { thir_set_item_type(mut_view(*cx.thir), it, (TypeId { v: fn_ty.v })); }
        // T161: the implementing type of a default-method instance, under the item address tagged with 2,
        // for the MIR instantiation (compiler/mir/builder.ax).
        if tc_is_default_inst(it as *const HirItem) && cx.self_ty.v != 0u32 {
            unsafe {
                ptr_typemap_insert(mut_view((*cx.thir).item_types), (it as usize) | 2, (TypeId { v: cx.self_ty.v }));
            }
        }
        let isym = unsafe { (*it).symbol };
        if isym.v != 0u32 && (unsafe { (*it).generic_params as usize }) == 0 && (cx.str_in as usize) == 0 && (cx.db as usize) == 0 {
            unsafe { thir_set_sym_type(mut_view(*cx.thir), (SymbolId { v: isym.v }), (TypeId { v: fn_ty.v })); }
        }
        cx.current_fn = 0 as *const HirItem;
    } else if ik == HIR_ITEM_TYPE_ALIAS {
        cx.current_fn = it;
        let aty_node: *mut HirType = unsafe { (*it).ty };
        let ty = if (aty_node as usize) != 0 {
            hir_type_to_typeid(mut_view(*cx), aty_node)
        } else {
            let aname = unsafe { (*it).name };
            unsafe { intern_param_ty(mut_view((*cx.thir).interner), (StrId { v: aname.v }), 0u32) }
        };
        unsafe { thir_set_item_type(mut_view(*cx.thir), it, (TypeId { v: ty.v })); }
        let isym = unsafe { (*it).symbol };
        if isym.v != 0u32 {
            unsafe { thir_set_sym_type(mut_view(*cx.thir), (SymbolId { v: isym.v }), (TypeId { v: ty.v })); }
        }
        cx.current_fn = 0 as *const HirItem;
    } else if ik == HIR_ITEM_CONST {
        cx.current_fn = it;
        let cty_node: *mut HirType = unsafe { (*it).ty };
        let ty = hir_type_to_typeid(mut_view(*cx), cty_node);
        unsafe { thir_set_item_type(mut_view(*cx.thir), it, (TypeId { v: ty.v })); }
        let isym = unsafe { (*it).symbol };
        if isym.v != 0u32 {
            unsafe { thir_set_sym_type(mut_view(*cx.thir), (SymbolId { v: isym.v }), (TypeId { v: ty.v })); }
        }
        cx.current_fn = 0 as *const HirItem;
    } else if ik == HIR_ITEM_STATIC {
        let sty_node: *mut HirType = unsafe { (*it).ty };
        if (sty_node as usize) != 0 {
            let ty = hir_type_to_typeid(mut_view(*cx), sty_node);
            unsafe { thir_set_item_type(mut_view(*cx.thir), it, (TypeId { v: ty.v })); }
            let isym = unsafe { (*it).symbol };
            if isym.v != 0u32 {
                unsafe { thir_set_sym_type(mut_view(*cx.thir), (SymbolId { v: isym.v }), (TypeId { v: ty.v })); }
            }
        }
    }
}

fn check_item_body(cx: mut_view<TypeckCtx>, it: *mut HirItem, parent_impl: *const HirItem) {
    if (it as usize) == 0 {
        return;
    }
    let ik = unsafe { (*it).kind };
    if ik == HIR_ITEM_FN {
        if (parent_impl as usize) == 0 {
            check_main_signature(mut_view(*cx), it);
        }
        let body_blk: *mut HirBlock = unsafe { (*it).body };
        // T161: the body of a default-method instance is the trait member's, checked once there.
        if (body_blk as usize) != 0 && !tc_is_default_inst(it as *const HirItem) {
            cx.type_vars.fn_var_start = cx.type_vars.len;
            cx.lits_len = 0;
            cx.negs_len = 0;
            cx.vars_len = 0;
            cx.loops_len = 0;
            cx.current_fn = it;
            cx.current_impl = parent_impl;
            let fn_ty_id = unsafe { thir_get_item_type(view(*cx.thir), it) };
            let fn_ty = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: fn_ty_id.v })) };
            let mut p_idx: usize = 0;
            let mut p: *mut HirParam = unsafe { (*it).params };
            while ((p as usize) != 0) {
                let psym = unsafe { (*p).symbol };
                let pm = unsafe { (*p).is_mut };
                if (fn_ty as usize) != 0 && p_idx < (unsafe { (*fn_ty).param_count }) {
                    let pt_v = unsafe { (*typeid_at((*fn_ty).param_types, p_idx)).v };
                    if psym.v != 0u32 {
                        unsafe { thir_set_sym_type(mut_view(*cx.thir), (SymbolId { v: psym.v }), (TypeId { v: pt_v })); }
                    }
                    unsafe { thir_set_param_type(mut_view(*cx.thir), p, (TypeId { v: pt_v })); }
                }
                push_var_state(mut_view(*cx), (SymbolId { v: psym.v }), pm, true);
                p_idx = p_idx + 1;
                p = unsafe { (*p).next };
            }
            let ret_v = if (fn_ty as usize) != 0 {
                unsafe { (*fn_ty).ret_type.v }
            } else {
                unsafe { (*cx.thir).interner.t_unit.v }
            };
            cx.return_type.v = ret_v;
            let _ = check_block(mut_view(*cx), body_blk, (TypeId { v: ret_v }));
            default_int_vars(mut_view(*cx));
            check_literal_ranges(mut_view(*cx));
            cx.return_type.v = 0u32;
            cx.current_fn = 0 as *const HirItem;
            cx.vars_len = 0;
        }
    } else if ik == HIR_ITEM_CONST {
        evaluate_const_item_in_impl(mut_view(*cx), it, parent_impl);
    }
}

pub fn typeck_into(
    hir_file: view<HirFile>,
    sink: mut_view<DiagSink>,
    str_in: mut_view<StrInterner>,
    db: view<SourceDatabase>,
    evaluator: *const ConstEvaluator,
    thir: mut_view<Thir>
) {
    thir_init(mut_view(*thir));

    let hir_ptr = unsafe { address_of(hir_file.items) as *mut HirFile };
    let sink_ptr = unsafe { address_of_mut(sink.arena.head) as *mut DiagSink };
    let str_ptr = unsafe { address_of_mut(str_in.bytes.head) as *mut StrInterner };
    let db_ptr = unsafe { address_of(db.arena.head) as *const SourceDatabase };
    let thir_ptr = unsafe { address_of_mut(thir.interner.arena.head) as *mut Thir };

    let mut cx = TypeckCtx {
        hir: hir_ptr,
        thir: thir_ptr,
        sink: sink_ptr,
        str_in: str_ptr,
        db: db_ptr,
        type_vars: TypeVarTable { items: 0 as *mut TypeVarEntry, len: 0, cap: 0, fn_var_start: 0 },
        return_type: (TypeId { v: 0u32 }),
        in_loop: false,
        lits: 0 as *mut LitCheck,
        lits_len: 0,
        lits_cap: 0,
        negs: 0 as *mut NegCheck,
        negs_len: 0,
        negs_cap: 0,
        vars: 0 as *mut VarState,
        vars_len: 0,
        vars_cap: 0,
        loops: 0 as *mut LoopEnv,
        loops_len: 0,
        loops_cap: 0,
        current_fn: 0 as *const HirItem,
        current_impl: 0 as *const HirItem,
        self_ty: (TypeId { v: 0u32 }),
        next_closure_id: 1u32,
        evaluator: evaluator,
        const_eval_stack: 0 as *mut SymbolId,
        const_eval_stack_len: 0,
        const_eval_stack_cap: 0,
    };
    type_vars_init(mut_view(cx.type_vars));

    annotate_intrinsic_hir(mut_view(thir.interner.arena), hir_file, view(*str_in));
    tc_mangle_drop_impls(mut_view(cx), hir_file);
    tc_instantiate_default_methods(mut_view(cx), hir_file);
    typeck_pass1a(mut_view(cx), hir_file, thir_ptr);
    typeck_pass1b_and_2(mut_view(cx), hir_file, thir_ptr, sink_ptr, str_ptr, db);

    type_vars_free(mut_view(cx.type_vars));
    if (cx.lits as usize) != 0 {
        unsafe { heap_free(cx.lits as *mut u8, mul_usize(cx.lits_cap, size_of<LitCheck>()), align_of<LitCheck>()); }
    }
    if (cx.negs as usize) != 0 {
        unsafe { heap_free(cx.negs as *mut u8, mul_usize(cx.negs_cap, size_of<NegCheck>()), align_of<NegCheck>()); }
    }
    if (cx.vars as usize) != 0 {
        unsafe { heap_free(cx.vars as *mut u8, mul_usize(cx.vars_cap, size_of<VarState>()), align_of<VarState>()); }
    }
    if (cx.loops as usize) != 0 {
        unsafe { heap_free(cx.loops as *mut u8, mul_usize(cx.loops_cap, size_of<LoopEnv>()), align_of<LoopEnv>()); }
    }
    if (cx.const_eval_stack as usize) != 0 {
        unsafe { heap_free(cx.const_eval_stack as *mut u8, mul_usize(cx.const_eval_stack_cap, size_of<SymbolId>()), align_of<SymbolId>()); }
    }
}

// SPEC-12 AXS-DROP-008 (ADR-0036 section 5): `impl P for T` declares the destructor of `T` iff the trait
// path `P` resolves to the prelude lang item `Drop`: `P` is the single segment `Drop` without generic
// arguments, and the impl's module neither declares a trait, struct, enum or type alias named `Drop` nor
// binds the name `Drop` with a `use`. Same predicate as hir_impl_is_lang_drop (compiler/hir/lower.ax,
// documented there) and ax_hir_impl_is_lang_drop / the twin in bootstrap/axiom0/src/types/typeck.c.
fn tc_name_is_drop(interner: view<StrInterner>, id: StrId) -> bool {
    if id.v == 0u32 {
        return false;
    }
    let sv = interner_get(interner, id);
    if sv.len != 4 {
        return false;
    }
    let b0 = unsafe { *(sv.ptr + 0) };
    let b1 = unsafe { *(sv.ptr + 1) };
    let b2 = unsafe { *(sv.ptr + 2) };
    let b3 = unsafe { *(sv.ptr + 3) };
    b0 == 68u8 && b1 == 114u8 && b2 == 111u8 && b3 == 112u8
}

fn tc_use_tree_binds_drop(interner: view<StrInterner>, t: *mut HirUseTree) -> bool {
    let mut cur: *mut HirUseTree = t;
    while (cur as usize) != 0 {
        let count = unsafe { (*cur).path.count };
        if (unsafe { (*cur).subtrees as usize }) != 0 {
            if tc_use_tree_binds_drop(interner, unsafe { (*cur).subtrees }) {
                return true;
            }
        } else if (unsafe { (*cur).alias.v }) != 0u32 {
            if tc_name_is_drop(interner, unsafe { (*cur).alias }) {
                return true;
            }
        } else if count > 0 {
            let off = (((count - 1) as isize) * (size_of<StrId>() as isize)) as usize;
            let seg_ptr = ((unsafe { (*cur).path.segments } as usize) + off) as *const StrId;
            if tc_name_is_drop(interner, unsafe { *seg_ptr }) {
                return true;
            }
        }
        cur = unsafe { (*cur).next };
    }
    false
}

fn tc_module_path_eq(a: *mut HirItem, b: *mut HirItem) -> bool {
    let count = unsafe { (*a).module_path.count };
    if count != (unsafe { (*b).module_path.count }) {
        return false;
    }
    let sa = unsafe { (*a).module_path.segments } as usize;
    let sb = unsafe { (*b).module_path.segments } as usize;
    let mut i: usize = 0;
    while i < count {
        let off = ((i as isize) * (size_of<StrId>() as isize)) as usize;
        let pa = (sa + off) as *const StrId;
        let pb = (sb + off) as *const StrId;
        if (unsafe { (*pa).v }) != (unsafe { (*pb).v }) {
            return false;
        }
        i = i + 1;
    }
    true
}

fn tc_impl_is_lang_drop(items: *mut HirItem, impl_item: *mut HirItem, interner: view<StrInterner>) -> bool {
    if (impl_item as usize) == 0 || (unsafe { (*impl_item).kind }) != HIR_ITEM_IMPL {
        return false;
    }
    let tp: *mut HirType = unsafe { (*impl_item).trait_path };
    if (tp as usize) == 0 || (unsafe { (*tp).kind }) != HIR_TYPE_PATH {
        return false;
    }
    if (unsafe { (*tp).path.generic_args as usize }) != 0 {
        return false;
    }
    if !tc_name_is_drop(interner, unsafe { (*tp).path.name }) {
        return false;
    }
    if (unsafe { (*tp).path.span.file.v }) != 0u32 {
        let span_len = (unsafe { (*tp).path.span.end }) - (unsafe { (*tp).path.span.start });
        if span_len != 4u32 {
            return false;
        }
    }
    let mut it: *mut HirItem = items;
    while (it as usize) != 0 {
        if tc_module_path_eq(it, impl_item) {
            let k = unsafe { (*it).kind };
            if k == HIR_ITEM_TRAIT || k == HIR_ITEM_STRUCT || k == HIR_ITEM_ENUM || k == HIR_ITEM_TYPE_ALIAS {
                if tc_name_is_drop(interner, unsafe { (*it).name }) {
                    return false;
                }
            } else if k == HIR_ITEM_USE {
                if tc_use_tree_binds_drop(interner, unsafe { (*it).use_tree }) {
                    return false;
                }
            }
        }
        it = unsafe { (*it).next };
    }
    true
}

fn tc_write_u32_dec(buf: *mut u8, start: usize, val: u32) -> usize {
    let mut tmp: [16]u8 = [0u8; 16];
    let mut dlen: usize = 0;
    let mut v = val;
    if v == 0u32 {
        unsafe { *(buf + start) = 48u8; }
        return start + 1;
    }
    while v > 0u32 {
        tmp[dlen] = (48u32 + (v % 10u32)) as u8;
        v = v / 10u32;
        dlen = dlen + 1;
    }
    let mut i: usize = 0;
    while i < dlen {
        unsafe { *(buf + start + i) = tmp[dlen - 1 - i]; }
        i = i + 1;
    }
    start + dlen
}

fn tc_mangle_drop_impls(cx: mut_view<TypeckCtx>, hir_file: view<HirFile>) {
    if (cx.str_in as usize) == 0 {
        return;
    }
    let mut drop_sym_counter: u32 = 0u32;
    let mut it: *mut HirItem = hir_file.items;
    while (it as usize) != 0 {
        if (unsafe { (*it).kind }) == HIR_ITEM_IMPL {
            let tp: *mut HirType = unsafe { (*it).trait_path };
            let st: *mut HirType = unsafe { (*it).self_type };
            if (tp as usize) != 0 && (st as usize) != 0 && (unsafe { (*st).kind }) == HIR_TYPE_PATH {
                if tc_impl_is_lang_drop(hir_file.items, it, unsafe { view(*cx.str_in) }) {
                    let mut sname = StrView { ptr: 0 as *const u8, len: 0 };
                    if (unsafe { (*st).path.name.v }) != 0u32 {
                        sname = unsafe { interner_get(view(*cx.str_in), (*st).path.name) };
                    } else if (cx.db as usize) != 0 {
                        let raw_s = unsafe { source_db_span_text(view(*cx.db), (*st).path.span) };
                        let mut lt: usize = 0;
                        while (lt) < (raw_s.len) {
                            if (unsafe { *(raw_s.ptr + lt) }) == 60u8 {
                                break;
                            }
                            lt = lt + 1;
                        }
                        sname = StrView { ptr: raw_s.ptr, len: lt };
                    }
                    if sname.len > 0 {
                        let mut m: *mut HirItem = unsafe { (*it).members };
                        while (m as usize) != 0 {
                            if (unsafe { (*m).kind }) == HIR_ITEM_FN {
                                let mut mbuf: [256]u8 = [0u8; 256];
                                let buf_ptr = unsafe { address_of(mbuf[0]) as *mut u8 };
                                let copy_len: usize = if sname.len > 240 { 240 } else { sname.len };
                                unsafe {
                                    ptr_copy_nonoverlapping<u8>(sname.ptr, buf_ptr, copy_len);
                                    *(buf_ptr + copy_len) = 36u8;
                                    *(buf_ptr + copy_len + 1) = 100u8;
                                    *(buf_ptr + copy_len + 2) = 114u8;
                                    *(buf_ptr + copy_len + 3) = 111u8;
                                    *(buf_ptr + copy_len + 4) = 112u8;
                                }
                                let base_len = copy_len + 5;
                                let mut new_name = unsafe {
                                    interner_intern_bytes(mut_view(*cx.str_in), buf_ptr as *const u8, base_len)
                                };
                                let mut disambig: u32 = 1u32;
                                loop {
                                    let mut collision = false;
                                    let mut prev: *mut HirItem = hir_file.items;
                                    while (prev as usize) != 0 && (prev as usize) != (it as usize) {
                                        if (unsafe { (*prev).kind }) == HIR_ITEM_IMPL {
                                            let mut pm: *mut HirItem = unsafe { (*prev).members };
                                            while (pm as usize) != 0 {
                                                if (unsafe { (*pm).kind }) == HIR_ITEM_FN &&
                                                   (unsafe { (*pm).name.v }) == new_name.v {
                                                    collision = true;
                                                    break;
                                                }
                                                pm = unsafe { (*pm).next };
                                            }
                                        }
                                        if collision {
                                            break;
                                        }
                                        prev = unsafe { (*prev).next };
                                    }
                                    if !collision {
                                        break;
                                    }
                                    disambig = disambig + 1u32;
                                    unsafe { *(buf_ptr + base_len) = 36u8; }
                                    let dlen = tc_write_u32_dec(buf_ptr, base_len + 1, disambig);
                                    new_name = unsafe {
                                        interner_intern_bytes(mut_view(*cx.str_in), buf_ptr as *const u8, dlen)
                                    };
                                }
                                drop_sym_counter = drop_sym_counter + 1u32;
                                let new_sym_v = 0x70000000u32 + drop_sym_counter;
                                let old_name_v = unsafe { (*m).name.v };
                                let m_body = unsafe { (*m).body };
                                unsafe {
                                    (*m).name.v = new_name.v;
                                    (*m).symbol.v = new_sym_v;
                                }
                                let mut top: *mut HirItem = hir_file.items;
                                while (top as usize) != 0 {
                                    if (top as usize) != (m as usize) &&
                                       (unsafe { (*top).kind }) == HIR_ITEM_FN &&
                                       (unsafe { (*top).body as usize }) == (m_body as usize) &&
                                       (unsafe { (*top).name.v }) == old_name_v {
                                        unsafe {
                                            (*top).name.v = new_name.v;
                                            (*top).symbol.v = new_sym_v;
                                        }
                                        break;
                                    }
                                    top = unsafe { (*top).next };
                                }
                            }
                            m = unsafe { (*m).next };
                        }
                    }
                }
            }
        }
        it = unsafe { (*it).next };
    }
}

// T161 (0133 §8, §9, §14; REQ-TRT-005, REQ-TRT-011; axiom0 typeck.c tc_instantiate_default_methods): a
// trait default method behaves, for every implementing type that does not override it, as if its body had
// been written in that type's impl. Every such (impl, default member) pair gets a member of the impl: a copy
// of the trait member item that shares its HIR body, with a fresh symbol from TC_DEFAULT_INST_SYM_BASE
// (impls in item order, then trait members in declaration order). Its signature is computed with `Self` =
// the impl's self type, method lookup finds it like a hand-written member, and the MIR of its body is the
// trait member's MIR instantiated for the impl (compiler/mir/builder.ax mb_instantiate_default). The body
// is type-checked once, as the trait member. Supertrait defaults are instantiated by the supertrait's impl.
fn tc_instantiate_default_methods(cx: mut_view<TypeckCtx>, hir_file: view<HirFile>) {
    if (cx.str_in as usize) == 0 || (cx.db as usize) == 0 {
        return;
    }
    let mut counter: u32 = 0u32;
    let mut it: *mut HirItem = hir_file.items;
    while (it as usize) != 0 {
        let tp: *mut HirType = unsafe { (*it).trait_path };
        let st: *mut HirType = unsafe { (*it).self_type };
        if (unsafe { (*it).kind }) == HIR_ITEM_IMPL && (tp as usize) != 0 && (st as usize) != 0 {
            let tr = unsafe { find_trait_by_type_path(hir_file, tp, view(*cx.str_in), view(*cx.db)) };
            if (tr as usize) != 0 {
                let mut m: *mut HirItem = unsafe { (*tr).members };
                while (m as usize) != 0 {
                    if (unsafe { (*m).kind }) == HIR_ITEM_FN && (unsafe { (*m).body as usize }) != 0 {
                        let m_name_v = unsafe { (*m).name.v };
                        let mut overridden = false;
                        let mut last: *mut HirItem = 0 as *mut HirItem;
                        let mut im: *mut HirItem = unsafe { (*it).members };
                        while (im as usize) != 0 {
                            if (unsafe { (*im).kind }) == HIR_ITEM_FN && (unsafe { (*im).name.v }) == m_name_v {
                                overridden = true;
                            }
                            last = im;
                            im = unsafe { (*im).next };
                        }
                        // 0x0FFFFFFF instances cannot be reached by any program that fits in memory.
                        if !overridden && TC_DEFAULT_INST_SYM_BASE + counter + 1u32 < TC_DEFAULT_INST_SYM_END {
                            let ibytes = size_of<HirItem>();
                            let inst = unsafe {
                                arena_alloc_raw(mut_view((*cx.thir).interner.arena), ibytes, align_of<HirItem>()) as *mut HirItem
                            };
                            counter = counter + 1u32;
                            unsafe {
                                ptr_copy_nonoverlapping<u8>(m as *const u8, inst as *mut u8, ibytes);
                                (*inst).next = 0 as *mut HirItem;
                                (*inst).symbol.v = TC_DEFAULT_INST_SYM_BASE + counter;
                            }
                            if (last as usize) == 0 {
                                unsafe { (*it).members = inst; }
                            } else {
                                unsafe { (*last).next = inst; }
                            }
                            // The MIR builder reads the instance's impl under the item address tagged with 2.
                            unsafe {
                                ptr_itemmap_insert(mut_view((*cx.thir).expr_methods), (inst as usize) | 2, it);
                            }
                        }
                    }
                    m = unsafe { (*m).next };
                }
            }
        }
        it = unsafe { (*it).next };
    }
}

pub fn tc_is_default_inst(it: *const HirItem) -> bool {
    if (it as usize) == 0 {
        return false;
    }
    let sv = unsafe { (*it).symbol.v };
    (unsafe { (*it).kind }) == HIR_ITEM_FN && sv > TC_DEFAULT_INST_SYM_BASE && sv < TC_DEFAULT_INST_SYM_END
}

fn typeck_pass1a(cx: mut_view<TypeckCtx>, hir_file: view<HirFile>, thir_ptr: *mut Thir) {
    if (thir_ptr as usize) != 0 {
        index_hir_items_in_thir(hir_file, unsafe { mut_view(*thir_ptr) });
    }
    // Pass 1a: Register Structs, Enums, and generic params in declaration order (matching axiom0 typeck.c:1660-1852).
    let mut top_it: *mut HirItem = hir_file.items;
    while ((top_it as usize) != 0) {
        let tk = unsafe { (*top_it).kind };
        if tk == HIR_ITEM_STRUCT {
            let mut arg_cnt: usize = 0;
            let args = build_item_generic_param_args(mut_view(*cx), top_it, mut_view(arg_cnt));
            cx.current_fn = top_it;
            cx.current_impl = 0 as *const HirItem;
            cx.self_ty.v = 0u32;
            let mut f_cnt: usize = 0;
            if unsafe { (*top_it).is_tuple } {
                let mut t: *mut HirType = unsafe { (*top_it).tuple_types };
                while ((t as usize) != 0) {
                    f_cnt = f_cnt + 1;
                    t = unsafe { (*t).next };
                }
            } else {
                let mut f: *mut HirFieldDecl = unsafe { (*top_it).struct_fields };
                while ((f as usize) != 0) {
                    f_cnt = f_cnt + 1;
                    f = unsafe { (*f).next };
                }
            }
            let mut flds: *mut TypeId = 0 as *mut TypeId;
            if f_cnt > 0 {
                let fbytes = mul_usize(f_cnt, size_of<TypeId>());
                flds = unsafe { arena_alloc_raw(mut_view((*thir_ptr).interner.arena), fbytes, align_of<TypeId>()) as *mut TypeId };
                let mut idx: usize = 0;
                if unsafe { (*top_it).is_tuple } {
                    let mut t: *mut HirType = unsafe { (*top_it).tuple_types };
                    while ((t as usize) != 0) {
                        let ft = hir_type_to_typeid(mut_view(*cx), t);
                        let dst = unsafe { typeid_at(flds, idx) };
                        unsafe { (*dst).v = ft.v; }
                        idx = idx + 1;
                        t = unsafe { (*t).next };
                    }
                } else {
                    let mut f: *mut HirFieldDecl = unsafe { (*top_it).struct_fields };
                    while ((f as usize) != 0) {
                        let fty_node: *mut HirType = unsafe { (*f).ty };
                        let ft = hir_type_to_typeid(mut_view(*cx), fty_node);
                        let dst = unsafe { typeid_at(flds, idx) };
                        unsafe { (*dst).v = ft.v; }
                        idx = idx + 1;
                        f = unsafe { (*f).next };
                    }
                }
            }
            let is_rc = item_has_repr_c(view(*cx), top_it);
            let st_id = unsafe { intern_struct_ty(mut_view((*thir_ptr).interner), is_rc, top_it, flds, f_cnt, args, arg_cnt) };
            unsafe { thir_set_item_type(mut_view(*thir_ptr), top_it, (TypeId { v: st_id.v })); }
            let s_sym = unsafe { (*top_it).symbol };
            if s_sym.v != 0u32 && arg_cnt == 0 && (cx.str_in as usize) == 0 && (cx.db as usize) == 0 {
                unsafe { thir_set_sym_type(mut_view(*thir_ptr), (SymbolId { v: s_sym.v }), (TypeId { v: st_id.v })); }
            }
            cx.current_fn = 0 as *const HirItem;
        } else if tk == HIR_ITEM_ENUM {
            let mut arg_cnt: usize = 0;
            let args = build_item_generic_param_args(mut_view(*cx), top_it, mut_view(arg_cnt));
            cx.current_fn = top_it;
            cx.current_impl = 0 as *const HirItem;
            cx.self_ty.v = 0u32;
            let mut v_cnt: usize = 0;
            let mut v: *mut HirVariantDecl = unsafe { (*top_it).variants };
            while ((v as usize) != 0) {
                v_cnt = v_cnt + 1;
                v = unsafe { (*v).next };
            }
            let mut v_fields: *mut *mut TypeId = 0 as *mut *mut TypeId;
            let mut v_counts: *mut usize = 0 as *mut usize;
            if v_cnt > 0 {
                let vf_bytes = mul_usize(v_cnt, size_of<*mut TypeId>());
                let vc_bytes = mul_usize(v_cnt, size_of<usize>());
                v_fields = unsafe { arena_alloc_raw(mut_view((*thir_ptr).interner.arena), vf_bytes, align_of<*mut TypeId>()) as *mut *mut TypeId };
                v_counts = unsafe { arena_alloc_raw(mut_view((*thir_ptr).interner.arena), vc_bytes, align_of<usize>()) as *mut usize };
                let mut v_idx: usize = 0;
                v = unsafe { (*top_it).variants };
                while ((v as usize) != 0) {
                    let mut f_cnt: usize = 0;
                    if unsafe { (*v).is_struct } {
                        let mut f: *mut HirFieldDecl = unsafe { (*v).struct_fields };
                        while ((f as usize) != 0) {
                            f_cnt = f_cnt + 1;
                            f = unsafe { (*f).next };
                        }
                    } else {
                        let mut t: *mut HirType = unsafe { (*v).tuple_types };
                        while ((t as usize) != 0) {
                            f_cnt = f_cnt + 1;
                            t = unsafe { (*t).next };
                        }
                    }
                    let vc_slot = unsafe { usize_at(v_counts, v_idx) };
                    unsafe { *vc_slot = f_cnt; }
                    let vf_slot = unsafe { typeid_ptr_at(v_fields, v_idx) };
                    if f_cnt > 0 {
                        let fbytes = mul_usize(f_cnt, size_of<TypeId>());
                        let f_arr = unsafe { arena_alloc_raw(mut_view((*thir_ptr).interner.arena), fbytes, align_of<TypeId>()) as *mut TypeId };
                        let mut f_idx: usize = 0;
                        if unsafe { (*v).is_struct } {
                            let mut f: *mut HirFieldDecl = unsafe { (*v).struct_fields };
                            while ((f as usize) != 0) {
                                let fty_node: *mut HirType = unsafe { (*f).ty };
                                let ft = hir_type_to_typeid(mut_view(*cx), fty_node);
                                let dst = unsafe { typeid_at(f_arr, f_idx) };
                                unsafe { (*dst).v = ft.v; }
                                f_idx = f_idx + 1;
                                f = unsafe { (*f).next };
                            }
                        } else {
                            let mut t: *mut HirType = unsafe { (*v).tuple_types };
                            while ((t as usize) != 0) {
                                let ft = hir_type_to_typeid(mut_view(*cx), t);
                                let dst = unsafe { typeid_at(f_arr, f_idx) };
                                unsafe { (*dst).v = ft.v; }
                                f_idx = f_idx + 1;
                                t = unsafe { (*t).next };
                            }
                        }
                        unsafe { *vf_slot = f_arr; }
                    } else {
                        unsafe { *vf_slot = 0 as *mut TypeId; }
                    }
                    v_idx = v_idx + 1;
                    v = unsafe { (*v).next };
                }
            }
            let en_id = unsafe {
                intern_enum_ty(
                    mut_view((*thir_ptr).interner),
                    top_it,
                    args,
                    arg_cnt,
                    v_fields,
                    v_counts,
                    v_cnt
                )
            };
            unsafe { thir_set_item_type(mut_view(*thir_ptr), top_it, (TypeId { v: en_id.v })); }
            let e_sym = unsafe { (*top_it).symbol };
            if e_sym.v != 0u32 && arg_cnt == 0 && (cx.str_in as usize) == 0 && (cx.db as usize) == 0 {
                unsafe { thir_set_sym_type(mut_view(*thir_ptr), (SymbolId { v: e_sym.v }), (TypeId { v: en_id.v })); }
            }
            cx.current_fn = 0 as *const HirItem;
        } else if tk == HIR_ITEM_IMPL || tk == HIR_ITEM_TRAIT || tk == HIR_ITEM_TYPE_ALIAS {
            let mut arg_cnt: usize = 0;
            let _ = build_item_generic_param_args(mut_view(*cx), top_it, mut_view(arg_cnt));
        }
        top_it = unsafe { (*top_it).next };
    }
}

fn typeck_pass1b_and_2(
    cx: mut_view<TypeckCtx>,
    hir_file: view<HirFile>,
    thir_ptr: *mut Thir,
    sink_ptr: *mut DiagSink,
    str_ptr: *mut StrInterner,
    db: view<SourceDatabase>
) {
    // Pass 1b: Register impl self_type, functions, methods, extern fns, consts, statics, type aliases.
    let mut top_it: *mut HirItem = hir_file.items;
    while ((top_it as usize) != 0) {
        let tk = unsafe { (*top_it).kind };
        if tk == HIR_ITEM_FN {
            let sym_v = unsafe { (*top_it).symbol.v };
            if sym_v >= 0x40000000u32 && sym_v < 0x50000000u32 {
                top_it = unsafe { (*top_it).next };
                continue;
            }
            let orig_m = find_orig_impl_member_with_thir(hir_file, thir_ptr as *const Thir, top_it);
            if (orig_m as usize) != 0 {
                let m_ty = unsafe { thir_get_item_type(view(*thir_ptr), orig_m) };
                if m_ty.v != 0u32 {
                    unsafe { thir_set_item_type(mut_view(*thir_ptr), top_it, (TypeId { v: m_ty.v })); }
                }
                top_it = unsafe { (*top_it).next };
                continue;
            }
            cx.current_impl = 0 as *const HirItem;
            cx.self_ty.v = 0u32;
            register_item_sig(mut_view(*cx), top_it, 0 as *const HirItem);
        } else if tk == HIR_ITEM_IMPL {
            cx.current_impl = top_it;
            cx.current_fn = 0 as *const HirItem;
            cx.self_ty.v = 0u32;
            let self_ty_node: *mut HirType = unsafe { (*top_it).self_type };
            let impl_self_ty = hir_type_to_typeid(mut_view(*cx), self_ty_node);
            unsafe { thir_set_item_type(mut_view(*thir_ptr), top_it, (TypeId { v: impl_self_ty.v })); }
            cx.self_ty.v = impl_self_ty.v;

            let mut m: *mut HirItem = unsafe { (*top_it).members };
            while ((m as usize) != 0) {
                register_item_sig(mut_view(*cx), m, top_it);
                m = unsafe { (*m).next };
            }
            cx.current_impl = 0 as *const HirItem;
            cx.self_ty.v = 0u32;

            let tp_node: *mut HirType = unsafe { (*top_it).trait_path };
            if (tp_node as usize) != 0 && impl_self_ty.v != 0u32 {
                if (cx.str_in as usize) != 0 && tc_impl_is_lang_drop(hir_file.items, top_it, unsafe { view(*cx.str_in) }) {
                    let self_t = unsafe { type_get(view((*thir_ptr).interner), (TypeId { v: impl_self_ty.v })) };
                    if (self_t as usize) != 0 && (unsafe { (*self_t).kind }) == TY_STRUCT {
                        let mut dm: *mut HirItem = unsafe { (*top_it).members };
                        while (dm as usize) != 0 {
                            if (unsafe { (*dm).kind }) == HIR_ITEM_FN {
                                let tk_key = ((impl_self_ty.v as usize) << 1) | 1;
                                unsafe {
                                    ptr_itemmap_insert(mut_view((*thir_ptr).expr_methods), tk_key, dm);
                                }
                                let def_ptr = unsafe { (*self_t).def };
                                if (def_ptr as usize) != 0 {
                                    let dk_key = (def_ptr as usize) | 1;
                                    unsafe {
                                        ptr_itemmap_insert(mut_view((*thir_ptr).expr_methods), dk_key, dm);
                                    }
                                }
                                break;
                            }
                            dm = unsafe { (*dm).next };
                        }
                    }
                }
            }
        } else if tk == HIR_ITEM_TRAIT {
            cx.current_impl = top_it;
            cx.self_ty.v = 0u32;
            let mut m: *mut HirItem = unsafe { (*top_it).members };
            while ((m as usize) != 0) {
                register_item_sig(mut_view(*cx), m, top_it);
                m = unsafe { (*m).next };
            }
            cx.current_impl = 0 as *const HirItem;
        } else if tk == HIR_ITEM_EXTERN_BLOCK {
            let mut m: *mut HirItem = unsafe { (*top_it).members };
            while ((m as usize) != 0) {
                let m_sym_v = unsafe { (*m).symbol.v };
                let mut has_top_clone = false;
                if m_sym_v != 0u32 {
                    let mut chk: *mut HirItem = hir_file.items;
                    while ((chk as usize) != 0) {
                        if (chk as usize) != (m as usize) &&
                           (unsafe { (*chk).kind }) == HIR_ITEM_FN &&
                           (unsafe { (*chk).symbol.v }) == m_sym_v {
                            has_top_clone = true;
                            break;
                        }
                        chk = unsafe { (*chk).next };
                    }
                }
                if !has_top_clone {
                    register_item_sig(mut_view(*cx), m, 0 as *const HirItem);
                }
                m = unsafe { (*m).next };
            }
        } else if tk == HIR_ITEM_CONST || tk == HIR_ITEM_STATIC || tk == HIR_ITEM_TYPE_ALIAS {
            cx.current_impl = 0 as *const HirItem;
            cx.self_ty.v = 0u32;
            register_item_sig(mut_view(*cx), top_it, 0 as *const HirItem);
        }
        top_it = unsafe { (*top_it).next };
    }
    if (thir_ptr as usize) != 0 {
        unsafe {
            ptr_itemmap_insert(mut_view((*thir_ptr).expr_methods), 6usize, 0 as *const HirItem);
        }
    }
    // Second sweep for top-level cloned impl methods whose impl appeared after them in hir_file.items:
    top_it = hir_file.items;
    while ((top_it as usize) != 0) {
        if (unsafe { (*top_it).kind }) == HIR_ITEM_FN {
            let existing = unsafe { thir_get_item_type(view(*thir_ptr), top_it) };
            if existing.v == 0u32 {
                let orig_m = find_orig_impl_member_with_thir(hir_file, thir_ptr as *const Thir, top_it);
                if (orig_m as usize) != 0 {
                    let m_ty = unsafe { thir_get_item_type(view(*thir_ptr), orig_m) };
                    if m_ty.v != 0u32 {
                        unsafe { thir_set_item_type(mut_view(*thir_ptr), top_it, (TypeId { v: m_ty.v })); }
                    }
                }
            }
        }
        top_it = unsafe { (*top_it).next };
    }

    // Pass 1c: Check overlapping trait impls, Send/Share impl safety, and supertrait obligations.
    unsafe {
        traits_check_overlap(hir_file, mut_view(*sink_ptr));
        let _ = check_send_share_impl_safety(hir_file, view(*str_ptr), db, mut_view(*sink_ptr));
        let _ = check_impl_supertraits(hir_file, view(*thir_ptr), view(*str_ptr), db, mut_view(*sink_ptr));
        fix_unsatisfied_bound_msgs(mut_view(*sink_ptr));
    }

    // Pass 2: Typecheck function, method, and const bodies.
    top_it = hir_file.items;
    while ((top_it as usize) != 0) {
        let tk = unsafe { (*top_it).kind };
        if tk == HIR_ITEM_FN {
            let sym_v = unsafe { (*top_it).symbol.v };
            if sym_v >= 0x40000000u32 && sym_v < 0x50000000u32 {
                top_it = unsafe { (*top_it).next };
                continue;
            }
            let orig_m = find_orig_impl_member_with_thir(hir_file, thir_ptr as *const Thir, top_it);
            if (orig_m as usize) == 0 {
                cx.current_impl = 0 as *const HirItem;
                cx.self_ty.v = 0u32;
                check_item_body(mut_view(*cx), top_it, 0 as *const HirItem);
            }
        } else if tk == HIR_ITEM_IMPL {
            cx.current_impl = top_it;
            let self_ty_node: *mut HirType = unsafe { (*top_it).self_type };
            let impl_self_ty = hir_type_to_typeid(mut_view(*cx), self_ty_node);
            cx.self_ty.v = impl_self_ty.v;
            let mut m: *mut HirItem = unsafe { (*top_it).members };
            while ((m as usize) != 0) {
                check_item_body(mut_view(*cx), m, top_it);
                m = unsafe { (*m).next };
            }
            cx.current_impl = 0 as *const HirItem;
            cx.self_ty.v = 0u32;
        } else if tk == HIR_ITEM_TRAIT {
            cx.current_impl = top_it;
            cx.self_ty.v = 0u32;
            let mut m: *mut HirItem = unsafe { (*top_it).members };
            while ((m as usize) != 0) {
                check_item_body(mut_view(*cx), m, top_it);
                m = unsafe { (*m).next };
            }
            cx.current_impl = 0 as *const HirItem;
        } else if tk == HIR_ITEM_CONST {
            cx.current_impl = 0 as *const HirItem;
            cx.self_ty.v = 0u32;
            check_item_body(mut_view(*cx), top_it, 0 as *const HirItem);
        }
        top_it = unsafe { (*top_it).next };
    }

    finalize_types(mut_view(*cx));
    verify_closures_and_spawns(mut_view(*cx));
    check_all_bounds(mut_view(*cx));
    check_atomic_struct_layouts(mut_view(*cx));
    if (thir_ptr as usize) != 0 && (sink_ptr as usize) != 0 && (str_ptr as usize) != 0 {
        unsafe {
            check_intrinsic_hir(hir_file, view(*thir_ptr), mut_view(*sink_ptr), view(*str_ptr));
        }
    }
}

fn tc_max_atomic_align(ti: view<TypeInterner>, str_in: view<StrInterner>, ty: TypeId, depth: usize) -> u64 {
    if depth > 16 || ty.v == 0u32 { return 0u64; }
    let mut inner_ty = (TypeId { v: 0u32 });
    if tc_type_is_lang_atomic(ti, str_in, (TypeId { v: ty.v }), mut_view(inner_ty)) {
        if inner_ty.v == 0u32 { return 8u64; }
        let it = type_get(ti, (TypeId { v: inner_ty.v }));
        if (it as usize) == 0 { return 8u64; }
        let ik = unsafe { (*it).kind };
        if ik == TY_BOOL || ik == TY_I8 || ik == TY_U8 { return 1u64; }
        if ik == TY_I16 || ik == TY_U16 { return 2u64; }
        if ik == TY_I32 || ik == TY_U32 { return 4u64; }
        return 8u64;
    }
    let t = type_get(ti, (TypeId { v: ty.v }));
    if (t as usize) == 0 { return 0u64; }
    let tk = unsafe { (*t).kind };
    if tk == TY_ARRAY {
        let el_v = unsafe { (*t).elem.v };
        return tc_max_atomic_align(ti, str_in, (TypeId { v: el_v }), depth + 1);
    }
    if tk == TY_TUPLE || tk == TY_STRUCT {
        let fc = unsafe { (*t).field_count };
        let flds = unsafe { (*t).fields };
        let mut max_a: u64 = 0u64;
        let mut i: usize = 0;
        while i < fc {
            let ft_v = unsafe { (*typeid_at(flds, i)).v };
            let fa = tc_max_atomic_align(ti, str_in, (TypeId { v: ft_v }), depth + 1);
            if fa > max_a { max_a = fa; }
            i = i + 1;
        }
        return max_a;
    }
    0u64
}

fn check_atomic_struct_layouts(cx: mut_view<TypeckCtx>) {
    if (cx.hir as usize) == 0 || (cx.thir as usize) == 0 || (cx.str_in as usize) == 0 { return; }
    let mut it: *mut HirItem = unsafe { (*cx.hir).items };
    while (it as usize) != 0 {
        if unsafe { (*it).kind } == HIR_ITEM_STRUCT {
            let mut is_packed = false;
            let mut has_align = false;
            let mut explicit_align: u64 = 0u64;
            let mut attr: *mut HirAttr = unsafe { (*it).attrs };
            while (attr as usize) != 0 {
                let aname_v = unsafe { (*attr).name.v };
                if aname_v != 0u32 {
                    let sv = unsafe { interner_get(view(*cx.str_in), (StrId { v: aname_v })) };
                    if tc_sv_is_6(view(sv), 112u8, 97u8, 99u8, 107u8, 101u8, 100u8) { // packed
                        is_packed = true;
                    } else if tc_sv_is_4(view(sv), 114u8, 101u8, 112u8, 114u8) { // repr
                        let mut arg: *mut HirAttrArg = unsafe { (*attr).args };
                        while (arg as usize) != 0 {
                            let arg_name_v = unsafe { (*arg).name.v };
                            if arg_name_v != 0u32 {
                                let asv = unsafe { interner_get(view(*cx.str_in), (StrId { v: arg_name_v })) };
                                if tc_sv_is_6(view(asv), 112u8, 97u8, 99u8, 107u8, 101u8, 100u8) { // packed
                                    is_packed = true;
                                }
                            }
                            let aexpr: *mut HirExpr = unsafe { (*arg).expr };
                            if (aexpr as usize) != 0 && unsafe { (*aexpr).kind } == HIR_EXPR_PATH {
                                let p_sv = unsafe { tc_path_name_sv(view(*cx), view((*aexpr).path)) };
                                if tc_sv_is_6(view(p_sv), 112u8, 97u8, 99u8, 107u8, 101u8, 100u8) { // packed
                                    is_packed = true;
                                }
                            }
                            arg = unsafe { (*arg).next };
                        }
                    } else if tc_sv_is_5(view(sv), 97u8, 108u8, 105u8, 103u8, 110u8) { // align
                        let arg: *mut HirAttrArg = unsafe { (*attr).args };
                        if (arg as usize) != 0 && (unsafe { (*arg).expr as usize }) != 0 {
                            let mut alo: u64 = 0u64;
                            let mut ahi: u64 = 0u64;
                            let mut aerr: u32 = 0u32;
                            let a_ex: *const HirExpr = (unsafe { (*arg).expr }) as *const HirExpr;
                            if eval_const_expr_u128(mut_view(*cx), a_ex, mut_view(alo), mut_view(ahi), mut_view(aerr)) && ahi == 0u64 {
                                has_align = true;
                                explicit_align = alo;
                            }
                        }
                    }
                }
                attr = unsafe { (*attr).next };
            }
            if is_packed || has_align {
                let sty = unsafe { thir_get_item_type(view(*cx.thir), it) };
                let st = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: sty.v })) };
                if (st as usize) != 0 && unsafe { (*st).kind } == TY_STRUCT {
                    let fc = unsafe { (*st).field_count };
                    let flds = unsafe { (*st).fields };
                    let mut fdecl: *mut HirFieldDecl = unsafe { (*it).struct_fields };
                    let mut fi: usize = 0;
                    while fi < fc && (fdecl as usize) != 0 {
                        let mut ft_v = unsafe { (*typeid_at(flds, fi)).v };
                        let mut req_a = unsafe { tc_max_atomic_align(view((*cx.thir).interner), view(*cx.str_in), (TypeId { v: ft_v }), 0) };
                        if req_a == 0u64 {
                            let fty_node: *mut HirType = unsafe { (*fdecl).ty };
                            if (fty_node as usize) != 0 {
                                let fty = hir_type_to_typeid(mut_view(*cx), fty_node);
                                ft_v = fty.v;
                                req_a = unsafe { tc_max_atomic_align(view((*cx.thir).interner), view(*cx.str_in), (TypeId { v: ft_v }), 0) };
                            }
                        }
                        if req_a > 0u64 && (is_packed || (has_align && explicit_align < req_a)) {
                            unsafe { type_error(mut_view(*cx), view((*fdecl).span), AX_CONC_INVALID_ATOMIC_ALIGNMENT); }
                        }
                        fi = fi + 1;
                        fdecl = unsafe { (*fdecl).next };
                    }
                }
            }
        }
        it = unsafe { (*it).next };
    }
}

// =============================================================================
// Unsafe Checker (Port of bootstrap/axiom0/src/own/unsafe/unsafe.c)
// =============================================================================

struct UnsafeCtx {
    hir: *const HirFile,
    thir: *const Thir,
    sink: *mut DiagSink,
    interner: *const StrInterner,
    in_unsafe: bool,
}

fn require_unsafe(cx: mut_view<UnsafeCtx>, sp: view<Span>) {
    if !cx.in_unsafe && (cx.sink as usize) != 0 {
        unsafe {
            report_typeck_diag(mut_view(*cx.sink), AX_UNSAFE_REQUIRED, sp.file.v, sp.start, sp.end);
        }
    }
}

fn is_unsafe_builtin_kind(k: u8) -> bool {
    k == TY_BUILTIN_PTR_ADD ||
    k == TY_BUILTIN_PTR_SUB ||
    k == TY_BUILTIN_ADDRESS_OF ||
    k == TY_BUILTIN_ADDRESS_OF_MUT ||
    k == TY_BUILTIN_DROP_IN_PLACE ||
    k == TY_BUILTIN_PTR_COPY ||
    k == TY_BUILTIN_PTR_COPY_NONOVERLAPPING ||
    k == TY_BUILTIN_PTR_WRITE_BYTES
}

fn is_unsafe_intrinsic_fn(interner: *const StrInterner, it: *const HirItem) -> bool {
    let _ = interner;
    if (it as usize) == 0 {
        return false;
    }
    unsafe { (*it).is_unsafe }
}

fn unsafe_find_item_by_sym(hir_file: *const HirFile, thir_ptr: *const Thir, sym: SymbolId) -> *const HirItem {
    if (hir_file as usize) == 0 || sym.v == 0u32 {
        return 0 as *const HirItem;
    }
    if (thir_ptr as usize) != 0 && (unsafe { (*thir_ptr).expr_methods.cap }) > 0 {
        let indexed: *mut *const HirItem = unsafe { ptr_itemmap_get(view((*thir_ptr).expr_methods), 4usize) };
        if (indexed as usize) != 0 {
            let k: usize = ((sym.v as usize) << 3) | 4usize;
            let p: *mut *const HirItem = unsafe { ptr_itemmap_get(view((*thir_ptr).expr_methods), k) };
            if (p as usize) != 0 {
                return unsafe { *p };
            }
            return 0 as *const HirItem;
        }
    }
    let mut it: *mut HirItem = unsafe { (*hir_file).items };
    while ((it as usize) != 0) {
        if (unsafe { (*it).symbol.v }) == sym.v {
            return it;
        }
        let ik = unsafe { (*it).kind };
        if ik == HIR_ITEM_EXTERN_BLOCK || ik == HIR_ITEM_IMPL || ik == HIR_ITEM_TRAIT {
            let mut m: *mut HirItem = unsafe { (*it).members };
            while ((m as usize) != 0) {
                if (unsafe { (*m).symbol.v }) == sym.v {
                    return m;
                }
                m = unsafe { (*m).next };
            }
        }
        it = unsafe { (*it).next };
    }
    0 as *const HirItem
}

fn unsafe_check_stmt(cx: mut_view<UnsafeCtx>, stmt: *const HirStmt) {
    let mut cur = stmt;
    while ((cur as usize) != 0) {
        let sk = unsafe { (*cur).kind };
        if sk == HIR_STMT_LET {
            let ex: *mut HirExpr = unsafe { (*cur).expr };
            unsafe_check_expr(mut_view(*cx), ex);
            let eb: *mut HirBlock = unsafe { (*cur).else_block };
            if (eb as usize) != 0 {
                unsafe_check_block(mut_view(*cx), eb);
            }
        } else if sk == HIR_STMT_ASSIGN {
            let l: *mut HirExpr = unsafe { (*cur).left };
            let r: *mut HirExpr = unsafe { (*cur).right };
            unsafe_check_expr(mut_view(*cx), l);
            unsafe_check_expr(mut_view(*cx), r);
        } else if sk == HIR_STMT_EXPR {
            let ex: *mut HirExpr = unsafe { (*cur).expr };
            unsafe_check_expr(mut_view(*cx), ex);
        }
        cur = unsafe { (*cur).next };
    }
}

fn unsafe_check_block(cx: mut_view<UnsafeCtx>, blk: *const HirBlock) {
    if (blk as usize) == 0 {
        return;
    }
    let stmts: *mut HirStmt = unsafe { (*blk).stmts };
    unsafe_check_stmt(mut_view(*cx), stmts);
}

fn unsafe_check_expr(cx: mut_view<UnsafeCtx>, expr: *const HirExpr) {
    let mut cur = expr;
    while ((cur as usize) != 0) {
        let k = unsafe { (*cur).kind };
        if k == HIR_EXPR_UNSAFE {
            let saved = cx.in_unsafe;
            cx.in_unsafe = true;
            let blk: *mut HirBlock = unsafe { (*cur).block };
            unsafe_check_block(mut_view(*cx), blk);
            cx.in_unsafe = saved;
        } else if k == HIR_EXPR_BLOCK || k == HIR_EXPR_LOOP || k == HIR_EXPR_COMPTIME {
            let blk: *mut HirBlock = unsafe { (*cur).block };
            unsafe_check_block(mut_view(*cx), blk);
        } else if k == HIR_EXPR_IF {
            let c: *mut HirExpr = unsafe { (*cur).cond };
            let blk: *mut HirBlock = unsafe { (*cur).block };
            let eb: *mut HirExpr = unsafe { (*cur).else_branch };
            unsafe_check_expr(mut_view(*cx), c);
            unsafe_check_block(mut_view(*cx), blk);
            unsafe_check_expr(mut_view(*cx), eb);
        } else if k == HIR_EXPR_WHILE {
            let c: *mut HirExpr = unsafe { (*cur).cond };
            let blk: *mut HirBlock = unsafe { (*cur).block };
            unsafe_check_expr(mut_view(*cx), c);
            unsafe_check_block(mut_view(*cx), blk);
        } else if k == HIR_EXPR_FOR {
            let it: *mut HirExpr = unsafe { (*cur).iter };
            let blk: *mut HirBlock = unsafe { (*cur).block };
            unsafe_check_expr(mut_view(*cx), it);
            unsafe_check_block(mut_view(*cx), blk);
        } else if k == HIR_EXPR_MATCH {
            let c: *mut HirExpr = unsafe { (*cur).cond };
            unsafe_check_expr(mut_view(*cx), c);
            let mut a: *mut HirMatchArm = unsafe { (*cur).arms };
            while ((a as usize) != 0) {
                let g: *mut HirExpr = unsafe { (*a).guard };
                let b: *mut HirExpr = unsafe { (*a).body };
                unsafe_check_expr(mut_view(*cx), g);
                unsafe_check_expr(mut_view(*cx), b);
                a = unsafe { (*a).next };
            }
        } else if k == HIR_EXPR_UNARY {
            let inner: *mut HirExpr = unsafe { (*cur).inner };
            if (unsafe { (*cur).op }) == UNOP_DEREF {
                let inner_ty_id = unsafe { thir_get_expr_type(view(*cx.thir), inner) };
                if inner_ty_id.v != 0u32 {
                    let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: inner_ty_id.v })) };
                    if (t as usize) != 0 && (unsafe { (*t).kind }) == TY_PTR {
                        unsafe { require_unsafe(mut_view(*cx), view((*cur).span)); }
                    }
                }
            }
            unsafe_check_expr(mut_view(*cx), inner);
        } else if k == HIR_EXPR_BINARY {
            let l: *mut HirExpr = unsafe { (*cur).left };
            let r: *mut HirExpr = unsafe { (*cur).right };
            let op = unsafe { (*cur).op };
            if op == BINOP_ADD || op == BINOP_SUB {
                let lty_id = unsafe { thir_get_expr_type(view(*cx.thir), l) };
                let rty_id = unsafe { thir_get_expr_type(view(*cx.thir), r) };
                let mut is_ptr_arith = false;
                if lty_id.v != 0u32 {
                    let lt = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: lty_id.v })) };
                    if (lt as usize) != 0 && (unsafe { (*lt).kind }) == TY_PTR {
                        is_ptr_arith = true;
                    }
                }
                if rty_id.v != 0u32 {
                    let rt = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: rty_id.v })) };
                    if (rt as usize) != 0 && (unsafe { (*rt).kind }) == TY_PTR {
                        is_ptr_arith = true;
                    }
                }
                if is_ptr_arith {
                    unsafe { require_unsafe(mut_view(*cx), view((*cur).span)); }
                }
            }
            unsafe_check_expr(mut_view(*cx), l);
            unsafe_check_expr(mut_view(*cx), r);
        } else if k == HIR_EXPR_CALL {
            let callee: *mut HirExpr = unsafe { (*cur).callee };
            let args: *mut HirExpr = unsafe { (*cur).args };
            let cty_id = unsafe { thir_get_expr_type(view(*cx.thir), callee) };
            let mut need_u = false;
            if cty_id.v != 0u32 {
                let ct = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: cty_id.v })) };
                if (ct as usize) != 0 {
                    let ctk = unsafe { (*ct).kind };
                    if ctk == TY_FN && (unsafe { (*ct).is_unsafe }) {
                        need_u = true;
                    } else if is_unsafe_builtin_kind(ctk) {
                        need_u = true;
                    }
                }
            }
            if !need_u && (callee as usize) != 0 && (unsafe { (*callee).kind }) == HIR_EXPR_PATH {
                let sym = unsafe { (*callee).path.symbol };
                let it = unsafe_find_item_by_sym(cx.hir, cx.thir, sym);
                if is_unsafe_intrinsic_fn(cx.interner, it) {
                    need_u = true;
                }
            }
            if need_u {
                unsafe { require_unsafe(mut_view(*cx), view((*cur).span)); }
            }
            unsafe_check_expr(mut_view(*cx), callee);
            unsafe_check_expr(mut_view(*cx), args);
        } else if k == HIR_EXPR_METHOD_CALL {
            let recv: *mut HirExpr = unsafe { (*cur).receiver };
            let args: *mut HirExpr = unsafe { (*cur).args };
            let m_it = unsafe { thir_get_expr_method(view(*cx.thir), cur) };
            if (m_it as usize) != 0 && (unsafe { (*m_it).is_unsafe }) {
                unsafe { require_unsafe(mut_view(*cx), view((*cur).span)); }
            }
            unsafe_check_expr(mut_view(*cx), recv);
            unsafe_check_expr(mut_view(*cx), args);
        } else if k == HIR_EXPR_PATH {
            let sym = unsafe { (*cur).path.symbol };
            if sym.v != 0u32 {
                let it = unsafe_find_item_by_sym(cx.hir, cx.thir, sym);
                if (it as usize) != 0 && (unsafe { (*it).kind }) == HIR_ITEM_STATIC {
                    if unsafe { (*it).is_mut || (*it).is_unsafe } {
                        unsafe { require_unsafe(mut_view(*cx), view((*cur).span)); }
                    }
                }
            }
        } else if k == HIR_EXPR_ARRAY {
            let el: *mut HirExpr = unsafe { (*cur).elems };
            let cnt: *mut HirExpr = unsafe { (*cur).count_expr };
            unsafe_check_expr(mut_view(*cx), el);
            unsafe_check_expr(mut_view(*cx), cnt);
        } else if k == HIR_EXPR_TUPLE {
            let el: *mut HirExpr = unsafe { (*cur).elems };
            unsafe_check_expr(mut_view(*cx), el);
        } else if k == HIR_EXPR_STRUCT {
            let mut f: *mut HirFieldInit = unsafe { (*cur).fields };
            while ((f as usize) != 0) {
                let fex: *mut HirExpr = unsafe { (*f).expr };
                unsafe_check_expr(mut_view(*cx), fex);
                f = unsafe { (*f).next };
            }
        } else if k == HIR_EXPR_VIEW || k == HIR_EXPR_JUMP || k == HIR_EXPR_CAST || k == HIR_EXPR_TRY || k == HIR_EXPR_AWAIT {
            let inner: *mut HirExpr = unsafe { (*cur).inner };
            unsafe_check_expr(mut_view(*cx), inner);
        } else if k == HIR_EXPR_CLOSURE {
            let saved = cx.in_unsafe;
            cx.in_unsafe = false;
            let body: *mut HirExpr = unsafe { (*cur).body };
            unsafe_check_expr(mut_view(*cx), body);
            cx.in_unsafe = saved;
        } else if k == HIR_EXPR_RANGE {
            let s: *mut HirExpr = unsafe { (*cur).start_expr };
            let e: *mut HirExpr = unsafe { (*cur).end_expr };
            unsafe_check_expr(mut_view(*cx), s);
            unsafe_check_expr(mut_view(*cx), e);
        } else if k == HIR_EXPR_FIELD || k == HIR_EXPR_TUPLE_INDEX {
            let b: *mut HirExpr = unsafe { (*cur).base };
            unsafe_check_expr(mut_view(*cx), b);
        } else if k == HIR_EXPR_INDEX {
            let b: *mut HirExpr = unsafe { (*cur).base };
            let a: *mut HirExpr = unsafe { (*cur).index_arg };
            unsafe_check_expr(mut_view(*cx), b);
            unsafe_check_expr(mut_view(*cx), a);
        }
        cur = unsafe { (*cur).next };
    }
}

pub fn unsafe_check(
    hir_file: view<HirFile>,
    thir: view<Thir>,
    sink: mut_view<DiagSink>,
    interner: view<StrInterner>
) {
    let hir_ptr = unsafe { address_of(hir_file.items) as *const HirFile };
    let thir_ptr = unsafe { address_of(thir.interner.arena.head) as *const Thir };
    let sink_ptr = unsafe { address_of_mut(sink.arena.head) as *mut DiagSink };
    let int_ptr = unsafe { address_of(interner.bytes.head) as *const StrInterner };
    let mut cx = UnsafeCtx {
        hir: hir_ptr,
        thir: thir_ptr,
        sink: sink_ptr,
        interner: int_ptr,
        in_unsafe: false,
    };

    let mut top_it: *mut HirItem = hir_file.items;
    while ((top_it as usize) != 0) {
        let tk = unsafe { (*top_it).kind };
        if tk == HIR_ITEM_FN {
            let orig_m = find_orig_impl_member_with_thir(hir_file, thir_ptr, top_it);
            if (orig_m as usize) == 0 {
                let body_blk: *mut HirBlock = unsafe { (*top_it).body };
                if (body_blk as usize) != 0 {
                    cx.in_unsafe = unsafe { (*top_it).is_unsafe };
                    unsafe_check_block(mut_view(cx), body_blk);
                }
            }
        } else if tk == HIR_ITEM_IMPL || tk == HIR_ITEM_TRAIT {
            let mut m: *mut HirItem = unsafe { (*top_it).members };
            while ((m as usize) != 0) {
                if (unsafe { (*m).kind }) == HIR_ITEM_FN {
                    let body_blk: *mut HirBlock = unsafe { (*m).body };
                    if (body_blk as usize) != 0 {
                        cx.in_unsafe = unsafe { (*m).is_unsafe };
                        unsafe_check_block(mut_view(cx), body_blk);
                    }
                }
                m = unsafe { (*m).next };
            }
        } else if tk == HIR_ITEM_CONST || tk == HIR_ITEM_STATIC {
            let ex: *mut HirExpr = unsafe { (*top_it).expr };
            if (ex as usize) != 0 {
                cx.in_unsafe = false;
                unsafe_check_expr(mut_view(cx), ex);
            }
        }
        top_it = unsafe { (*top_it).next };
    }
}

pub fn typeck_with_evaluator(
    hir_file: view<HirFile>,
    sink: mut_view<DiagSink>,
    str_in: mut_view<StrInterner>,
    db: view<SourceDatabase>,
    evaluator: *const ConstEvaluator,
    thir: mut_view<Thir>
) {
    typeck_into(hir_file, mut_view(*sink), mut_view(*str_in), db, evaluator, mut_view(*thir));
    if sink.errors == 0 {
        unsafe_check(hir_file, view(*thir), mut_view(*sink), view(*str_in));
    }
}

pub fn typeck(
    hir_file: view<HirFile>,
    sink: mut_view<DiagSink>,
    str_in: mut_view<StrInterner>,
    db: view<SourceDatabase>,
    thir: mut_view<Thir>
) {
    typeck_with_evaluator(hir_file, sink, str_in, db, 0 as *const ConstEvaluator, thir);
}

