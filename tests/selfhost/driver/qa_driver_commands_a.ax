const LOWER_NOT_SUPPORTED_MSG: [60]u8 = [
    99u8, 111u8, 110u8, 115u8, 116u8, 114u8, 117u8, 99u8, 116u8, 32u8, 112u8, 97u8, 114u8, 115u8, 101u8, 100u8,
