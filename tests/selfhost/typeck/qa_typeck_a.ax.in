01u8, 32u8, 62u8, 32u8, 64u8, 50u8, 53u8, 10u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 40u8, 71u8, 101u8, 110u8, 101u8, 114u8, 105u8, 99u8, 65u8, 114u8, 103u8, 32u8, 34u8, 34u8, 10u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 40u8, 84u8, 121u8, 112u8, 101u8, 80u8, 97u8, 116u8, 104u8, 41u8, 41u8, 10u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 40u8, 70u8, 105u8, 101u8, 108u8, 100u8, 73u8, 110u8, 105u8, 116u8, 32u8, 34u8, 118u8, 97u8, 108u8, 117u8, 101u8, 34u8, 10u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 32u8, 40u8, 69u8, 120u8, 112u8, 114u8, 76u8, 105u8, 116u8, 101u8, 114u8, 97u8, 108u8, 32u8, 60u8, 84u8, 121u8, 112u8, 101u8, 32u8, 105u8, 51u8, 50u8, 62u8, 41u8, 41u8, 41u8, 41u8, 41u8, 41u8, 10u8
];

const TC_OFF: [7]u32 = [
    0u32, 21u32, 342u32, 1799u32, 1836u32, 1955u32, 2325u32
];

fn get_sv(a: mut_view<Arena>, c_data: view<[2325]u8>, c_off: view<[7]u32>, blob_idx: usize) -> StrView {
    let start = (*c_off)[blob_idx] as usize;
    let end = (*c_off)[blob_idx + 1] as usize;
    let n = end - start;
    let dst = arena_alloc_raw(a, n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = (*c_data)[start + i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn bytes_equal(a: *const u8, a_len: usize, b: *const u8, b_len: usize) -> bool {
    if a_len != b_len {
        return false;
    }
    let mut i: usize = 0;
    while i < a_len {
        if (unsafe { *(a + i) }) != (unsafe { *(b + i) }) {
            return false;
        }
        i = i + 1;
    }
    true
}

fn bytes_contains(hay: *const u8, hay_len: usize, needle: *const u8, needle_len: usize) -> bool {
    if needle_len == 0 {
        return true;
    }
    if hay_len < needle_len {
        return false;
    }
    let mut i: usize = 0;
    while i + needle_len <= hay_len {
        if bytes_equal(unsafe { hay + i }, needle_len, needle, needle_len) {
            return true;
        }
        i = i + 1;
    }
    false
}

fn run_golden_case(
    sess: mut_view<CompilerSession>,
    parse_arena: mut_view<Arena>,
    resolve_arena: mut_view<Arena>,
    hir_arena: mut_view<Arena>,
    scratch: mut_view<Arena>,
    rmap: mut_view<ResolveMap>,
    thir_ptr: *mut Thir,
    out: mut_view<DiagBuffer>,
    diags: mut_view<DiagBuffer>,
    c_data: view<[2325]u8>,
    c_off: view<[7]u32>,
    base_blob: usize
) -> i32 {
    session_init(mut_view(*sess));
    unsafe { thir_init(mut_view(*thir_ptr)); }
    out.len = 0;
    diags.len = 0;
    let path_sv = get_sv(mut_view(*scratch), c_data, c_off, base_blob);
    let src_sv = get_sv(mut_view(*scratch), c_data, c_off, base_blob + 1);
    let exp_thir = get_sv(mut_view(*scratch), c_data, c_off, base_blob + 2);
    let errs = unsafe {
        session_typeck_and_render_human(
            mut_view(*sess),
            mut_view(*parse_arena),
            mut_view(*resolve_arena),
            mut_view(*hir_arena),
            mut_view(*rmap),
            mut_view(*thir_ptr),
            path_sv,
            src_sv,
            true,
            mut_view(*out),
            mut_view(*diags)
        )
    };
    let mut rc: i32 = 0;
    if errs != 0 || diags.len != 0 {
        rc = 10;
    } else if !bytes_equal(out.ptr as *const u8, out.len, exp_thir.ptr, exp_thir.len) {
        rc = 20;
    }
    unsafe { thir_free(mut_view(*thir_ptr)); }
    arena_reset(mut_view(*hir_arena));
    arena_reset(mut_view(*resolve_arena));
    arena_reset(mut_view(*parse_arena));
    arena_reset(mut_view(*scratch));
    session_free(mut_view(*sess));
    rc
}

pub fn main() -> i32 {
    let mut sess = session_new();
    let mut parse_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(parse_arena), 16, 8);
    let mut resolve_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(resolve_arena), 16, 8);
    let mut hir_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(hir_arena), 16, 8);
    let mut scratch = arena_with_chunk_size(65536);
    let _ = arena_alloc_raw(mut_view(scratch), 16, 8);
    let thir_ptr = unsafe { heap_alloc(size_of<Thir>(), align_of<Thir>()) as *mut Thir };
    let mut out = diag_buf_new();
    out.ptr = unsafe { heap_alloc(65536, 1) };
    out.cap = 65536;
    let mut diags = diag_buf_new();
    diags.ptr = unsafe { heap_alloc(16384, 1) };
    diags.cap = 16384;
    let mut rmap = ResolveMap {
        node_map: NodeMap { keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0 },
        module_access_nodes: NodeMap {
            keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0
        },
        extern_nodes: NodeMap {
            keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0
        },
        next_symbol_v: 1u32,
        next_std_symbol_v: 10000u32,
        naming_ctx: 0 as *mut NamingCtx,
    };
    let c_data = TC_DATA;
    let c_off = TC_OFF;
    let rc0 = run_golden_case(mut_view(sess), mut_view(parse_arena), mut_view(resolve_arena), mut_view(hir_arena),
        mut_view(scratch), mut_view(rmap), thir_ptr, mut_view(out), mut_view(diags), view(c_data), view(c_off), 0);
    if rc0 != 0 { return rc0; }
    let rc1 = run_golden_case(mut_view(sess), mut_view(parse_arena), mut_view(resolve_arena), mut_view(hir_arena),
        mut_view(scratch), mut_view(rmap), thir_ptr, mut_view(out), mut_view(diags), view(c_data), view(c_off), 3);
    if rc1 != 0 { return rc1 + 1; }
    unsafe { heap_free(thir_ptr as *mut u8, size_of<Thir>(), align_of<Thir>()); }
    diag_buf_free(mut_view(diags));
    diag_buf_free(mut_view(out));
    arena_destroy(mut_view(scratch));
    arena_destroy(mut_view(hir_arena));
    arena_destroy(mut_view(resolve_arena));
    arena_destroy(mut_view(parse_arena));
    print("OK Selfhost Typeck & THIR QA A (2 golden cases)\n");
    0
}
