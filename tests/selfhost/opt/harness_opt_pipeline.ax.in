@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

@PIPE_FN@

fn empty_node_map() -> NodeMap {
    NodeMap { keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0 }
}

fn pipe_blob(arena: mut_view<Arena>, idx: usize) -> StrView {
    let s: str = pipe_raw(idx);
    let raw_sv: StrView = unsafe { *(address_of(s) as *const StrView) };
    let bytes: view<[u8]> = unsafe { *(address_of(s) as *const view<[u8]>) };
    let n = raw_sv.len;
    let dst = arena_alloc_raw(mut_view(*arena), n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe {
            *(dst + i) = bytes[i];
        }
        i = i + 1;
    }
    unsafe {
        *(dst + n) = 0u8;
    }
    StrView { ptr: dst as *const u8, len: n }
}

fn str_eq_buf(buf: view<DiagBuffer>, exp: view<StrView>) -> bool {
    if buf.len != exp.len {
        return false;
    }
    let mut i: usize = 0;
    while i < exp.len {
        let a = unsafe { *(buf.ptr + i) };
        let b = unsafe { *(exp.ptr + i) };
        if a != b {
            return false;
        }
        i = i + 1;
    }
    true
}

fn new_arena(chunk: usize) -> Arena {
    let mut a = arena_with_chunk_size(chunk);
    let _ = arena_alloc_raw(mut_view(a), 16, 8);
    a
}

fn run_opt_pipeline(
    sess_ptr: *mut CompilerSession,
    thir_ptr: *mut Thir,
    out_ptr: *mut u8,
    out_cap: usize,
    perm_arena: mut_view<Arena>,
    parse_arena: mut_view<Arena>,
    resolve_arena: mut_view<Arena>,
    hir_arena: mut_view<Arena>,
    mir_arena: mut_view<Arena>
) -> i32 {
    let mut rmap = ResolveMap {
        node_map: empty_node_map(),
        module_access_nodes: empty_node_map(),
        extern_nodes: empty_node_map(),
        next_symbol_v: 1u32,
        next_std_symbol_v: 10000u32,
        naming_ctx: 0 as *mut NamingCtx,
    };

    let path_sv = pipe_blob(mut_view(*perm_arena), 0);
    let src_sv = pipe_blob(mut_view(*perm_arena), 1);
    let exp0_sv = pipe_blob(mut_view(*perm_arena), 2);
    let exp1_sv = pipe_blob(mut_view(*perm_arena), 3);
    let exp2_sv = pipe_blob(mut_view(*perm_arena), 4);

    let mut fid = FileId { v: 0u32 };
    let parse_res = session_parse_virtual_file(
        unsafe { mut_view(*sess_ptr) },
        mut_view(*parse_arena),
        path_sv,
        src_sv,
        mut_view(fid)
    );
    session_resolve_ast_into(unsafe { mut_view(*sess_ptr) }, mut_view(*resolve_arena), view(parse_res.ast), mut_view(rmap));
    let hir = session_lower_hir(unsafe { mut_view(*sess_ptr) }, mut_view(*hir_arena), view(parse_res.ast), view(rmap));

    if (unsafe { (*sess_ptr).diag_sink.errors }) != 0 {
        resolve_map_free(mut_view(rmap));
        return 1;
    }
    unsafe {
        session_typeck_into(mut_view(*sess_ptr), view(hir), mut_view(*thir_ptr));
    }
    if (unsafe { (*sess_ptr).diag_sink.errors }) != 0 {
        resolve_map_free(mut_view(rmap));
        return 2;
    }

    let str_in_ptr = unsafe { address_of_mut((*sess_ptr).interner) as *mut StrInterner };
    let db_ptr = unsafe { address_of((*sess_ptr).source_db) as *const SourceDatabase };
    let sink_ptr = unsafe { address_of_mut((*sess_ptr).diag_sink) as *mut DiagSink };
    let hir_ptr = unsafe { address_of(hir.items) as *const HirFile };

    let mut out = DiagBuffer { ptr: out_ptr, len: 0, cap: out_cap };

    let mut optimized_fns: usize = 0;
    let mut saw_unreachable_bb: bool = false;
    let mut saw_folded_neg1: bool = false;
    let mut it: *mut HirItem = hir.items;
    while (it as usize) != 0 {
        let it_file = unsafe { (*it).span.file.v };
        let is_fn = (unsafe { (*it).kind }) == HIR_ITEM_FN;
        if is_fn && (fid.v == 0u32 || it_file == 0u32 || it_file == fid.v) {
            let body = mir_build_fn(
                mut_view(*mir_arena),
                it,
                thir_ptr,
                hir_ptr,
                str_in_ptr,
                db_ptr,
                0 as *mut MonoEngine
            );
            if (body as usize) != 0 {
                let fn_idx = optimized_fns;
                optimized_fns = optimized_fns + 1;

                // Match `bootstrap/axiom0/src/driver/pipeline.c:448-451`:
                // 1. Verify pre-optimization MIR structural invariants.
                verify_mir(
                    unsafe { view(*body) },
                    thir_ptr as *const Thir,
                    unsafe { mut_view(*sink_ptr) },
                    it as *const HirItem
                );
                if (unsafe { (*sink_ptr).errors }) != 0 {
                    resolve_map_free(mut_view(rmap));
                    return 3;
                }

                // 2. Run the `-O1` optimizer pipeline (`verify_each = true` on fixtures 0, 1).
                let verify_each = fn_idx != 2;
                opt_run_in_arena(
                    unsafe { mut_view(*body) },
                    thir_ptr as *const Thir,
                    mut_view(*mir_arena),
                    unsafe { mut_view(*sink_ptr) },
                    verify_each,
                    it as *const HirItem
                );
                if (unsafe { (*sink_ptr).errors }) != 0 {
                    resolve_map_free(mut_view(rmap));
                    return 4;
                }

                // 3. For `tests/opt/const_fold_run.ax`, `tests/opt/qa_dce_run.ax`, and
                // `tests/opt/qa_edge_cases_run.ax`, emit post-`-O1` MIR text before drop
                // elaboration and compare byte-for-byte against `axiom0 -O1`.
                out.ptr = out_ptr;
                out.len = 0;
                out.cap = out_cap;
                mir_print(mut_view(out), unsafe { view(*body) });
                if fn_idx == 0 && !str_eq_buf(view(out), view(exp0_sv)) {
                    resolve_map_free(mut_view(rmap));
                    return 10;
                }
                if fn_idx == 1 && !str_eq_buf(view(out), view(exp1_sv)) {
                    resolve_map_free(mut_view(rmap));
                    return 11;
                }
                if fn_idx == 2 && !str_eq_buf(view(out), view(exp2_sv)) {
                    resolve_map_free(mut_view(rmap));
                    return 12;
                }

                // 4. Verify post-`-O1` ownership, capability, and drop elaboration invariants (`stage_own`).
                if fn_idx != 2 {
                    verify_mir(
                        unsafe { view(*body) },
                        thir_ptr as *const Thir,
                        unsafe { mut_view(*sink_ptr) },
                        it as *const HirItem
                    );
                    verify_mir_own(
                        unsafe { view(*body) },
                        thir_ptr as *const Thir,
                        unsafe { mut_view(*sink_ptr) },
                        it as *const HirItem
                    );
                    verify_mir_cap(
                        unsafe { view(*body) },
                        thir_ptr as *const Thir,
                        unsafe { mut_view(*sink_ptr) }
                    );
                    unsafe {
                        mir_drop_elaborate(
                            mut_view(*body),
                            mut_view(*thir_ptr),
                            view(hir),
                            db_ptr,
                            view(*str_in_ptr),
                            mut_view(*mir_arena)
                        );
                    }
                    verify_mir_drop_flags(
                        unsafe { view(*body) },
                        thir_ptr as *const Thir,
                        unsafe { mut_view(*sink_ptr) },
                        it as *const HirItem
                    );
                    if (unsafe { (*sink_ptr).errors }) != 0 {
                        resolve_map_free(mut_view(rmap));
                        return 5;
                    }
                }

                let bb_cnt = unsafe { (*body).bb_count };
                let bbs = unsafe { (*body).bbs };
                let mut bi: usize = 0;
                while bi < bb_cnt {
                    let bb = unsafe { mir_bb_at(bbs, bi) };
                    let tk = unsafe { (*bb).terminator.kind };
                    let sc = unsafe { (*bb).stmt_count };
                    if tk == MIR_TERM_UNREACHABLE && sc == 0 {
                        saw_unreachable_bb = true;
                    }
                    let stmts = unsafe { (*bb).stmts };
                    let mut si: usize = 0;
                    while si < sc {
                        let st = unsafe { mir_stmt_at(stmts, si) };
                        let sk = unsafe { (*st).kind };
                        if sk == MIR_STMT_ASSIGN {
                            let rvk = unsafe { (*st).rvalue.kind };
                            let opk = unsafe { (*st).rvalue.use_op.kind };
                            let cval = unsafe { (*st).rvalue.use_op.constant.val };
                            if rvk == MIR_RVALUE_USE && opk == MIR_OP_CONST && cval == 4294967295u64 {
                                saw_folded_neg1 = true;
                            }
                        }
                        si = si + 1;
                    }
                    bi = bi + 1;
                }
            }
        }
        it = unsafe { (*it).next };
    }

    resolve_map_free(mut_view(rmap));
    if optimized_fns != 3 || !saw_unreachable_bb || !saw_folded_neg1 {
        return 6;
    }
    0
}

pub fn main() -> i32 {
    let mut perm_arena = new_arena(524288);
    let out_cap: usize = 32768;
    let out_ptr = arena_alloc_raw(mut_view(perm_arena), out_cap, 1);
    let mut parse_arena = new_arena(262144);
    let mut resolve_arena = new_arena(262144);
    let mut hir_arena = new_arena(262144);
    let mut mir_arena = new_arena(262144);
    let str_bytes_arena = new_arena(131072);

    let sess_ptr = arena_alloc_raw(mut_view(perm_arena), size_of<CompilerSession>(), align_of<CompilerSession>()) as *mut CompilerSession;
    let str_cap: usize = 512;
    let str_arr = arena_alloc_raw(mut_view(perm_arena), str_cap * size_of<StrView>(), align_of<StrView>()) as *mut StrView;
    let smap_cap: usize = 1024;
    let smap_hashes = arena_alloc_raw(mut_view(perm_arena), smap_cap * 8, 8) as *mut u64;
    let smap_ids = arena_alloc_raw(mut_view(perm_arena), smap_cap * 4, 4) as *mut u32;
    unsafe {
        session_init(mut_view(*sess_ptr));
        arena_destroy(mut_view((*sess_ptr).interner.bytes));
        (*sess_ptr).interner.bytes = str_bytes_arena;
        (*sess_ptr).interner.strings = str_arr;
        (*sess_ptr).interner.cap = str_cap;
        (*sess_ptr).interner.map_hashes = smap_hashes;
        (*sess_ptr).interner.map_ids = smap_ids;
        (*sess_ptr).interner.map_cap = smap_cap;
    }

    let thir_ptr = arena_alloc_raw(mut_view(perm_arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    unsafe {
        thir_init(mut_view(*thir_ptr));
    }

    let rc = run_opt_pipeline(
        sess_ptr,
        thir_ptr,
        out_ptr,
        out_cap,
        mut_view(perm_arena),
        mut_view(parse_arena),
        mut_view(resolve_arena),
        mut_view(hir_arena),
        mut_view(mir_arena)
    );

    unsafe {
        thir_free(mut_view(*thir_ptr));
        (*sess_ptr).interner.cap = 0;
        (*sess_ptr).interner.map_cap = 0;
        session_free(mut_view(*sess_ptr));
    }
    arena_destroy(mut_view(mir_arena));
    arena_destroy(mut_view(hir_arena));
    arena_destroy(mut_view(resolve_arena));
    arena_destroy(mut_view(parse_arena));
    arena_destroy(mut_view(perm_arena));

    if rc != 0 {
        return rc;
    }

    print("OK opt pipeline\n");
    0
}
