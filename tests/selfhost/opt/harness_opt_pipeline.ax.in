use compiler.kernel.arena.arena_with_chunk_size
use compiler.kernel.arena.arena_destroy
use compiler.kernel.arena.arena_alloc_raw
use compiler.kernel.id.FileId
use compiler.kernel.id.SymbolId
use compiler.kernel.interner.StrInterner
use compiler.kernel.interner.StrView
use compiler.source.manager.SourceDatabase
use compiler.diag.emitter.DiagSink
use compiler.diag.format.DiagBuffer
use compiler.kernel_source_diag.session.CompilerSession
use compiler.kernel_source_diag.session.session_init
use compiler.kernel_source_diag.session.session_free
use compiler.parser.session.session_parse_virtual_file
use compiler.resolve.symtab.NodeMap
use compiler.resolve.symtab.NamingCtx
use compiler.resolve.symtab.ResolveMap
use compiler.resolve.symtab.resolve_map_free
