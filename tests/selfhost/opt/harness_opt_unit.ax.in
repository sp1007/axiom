fn check_binop_mismatch(thir: *const Thir, op: u8, lhs_ty_v: u32, rhs_ty_v: u32, lhs_v: u64, rhs_v: u64) -> bool {
    let mut lhs = MirOperand {
        kind: MIR_OP_CONST,
        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        place: mir_local_place(0u32),
        constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
    };
    let mut rhs = MirOperand {
        kind: MIR_OP_CONST,
        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        place: mir_local_place(0u32),
        constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
    };
    let mut out = MirConst {
        ty: TypeId { v: 0u32 },
        kind: MIR_CONST_INT,
        val: 0u64,
        str_bytes: 0 as *const u8,
        str_len: 0,
        sym: SymbolId { v: 0u32 },
    };
    init_const_op(mut_view(lhs), lhs_ty_v, lhs_v);
    init_const_op(mut_view(rhs), rhs_ty_v, rhs_v);
    mir_const_reset_vals(mut_view(out), MIR_CONST_INT, 0u32, 0u64);
    !do_const_fold_binop(thir, op, view(lhs), view(rhs), mut_view(out))
}

// 1. Exhaustive constant folding unit tests across all scalar types (`i8..i64`, `isize`, `u8..u64`, `usize`, `char`, `bool`).
fn test_const_fold_scalars(arena: mut_view<Arena>) -> i32 {
    let thir_ptr = arena_alloc_raw(mut_view(*arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    opt_init_minimal_thir(thir_ptr, mut_view(*arena));
    let t_ptr = thir_ptr as *const Thir;

    // --- i8 (type#6) ---
    if !check_binop_ok(t_ptr, MIR_BINOP_ADD, 6u32, 100u64, 27u64, 127u64, 6u32) { return 101; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_ADD, 6u32, 100u64, 28u64) { return 102; }
    if !check_binop_ok(t_ptr, MIR_BINOP_SUB, 6u32, 0x9Cu64, 28u64, 0x80u64, 6u32) { return 103; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_SUB, 6u32, 0x9Cu64, 29u64) { return 104; }
    if !check_binop_ok(t_ptr, MIR_BINOP_MUL, 6u32, 16u64, 7u64, 112u64, 6u32) { return 105; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_MUL, 6u32, 16u64, 8u64) { return 106; }
    if !check_binop_ok(t_ptr, MIR_BINOP_MUL, 6u32, 0xF0u64, 8u64, 0x80u64, 6u32) { return 107; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_MUL, 6u32, 0x80u64, 0xFFu64) { return 108; }
    if !check_binop_ok(t_ptr, MIR_BINOP_DIV, 6u32, 0x9Cu64, 3u64, 0xDFu64, 6u32) { return 109; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_DIV, 6u32, 0x80u64, 0xFFu64) { return 110; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_DIV, 6u32, 10u64, 0u64) { return 111; }
    if !check_binop_ok(t_ptr, MIR_BINOP_REM, 6u32, 0x9Cu64, 3u64, 0xFFu64, 6u32) { return 112; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_REM, 6u32, 0x80u64, 0xFFu64) { return 113; }
    if !check_binop_ok(t_ptr, MIR_BINOP_SHL, 6u32, 1u64, 7u64, 0x80u64, 6u32) { return 114; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_SHL, 6u32, 1u64, 8u64) { return 115; }
    if !check_binop_ok(t_ptr, MIR_BINOP_SHR, 6u32, 0xF0u64, 2u64, 0xFCu64, 6u32) { return 116; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_SHR, 6u32, 1u64, 8u64) { return 117; }
    if !check_binop_ok(t_ptr, MIR_BINOP_LT, 6u32, 0xFBu64, 2u64, 1u64, 4u32) { return 118; }
    if !check_binop_ok(t_ptr, MIR_BINOP_GT, 6u32, 0xFBu64, 2u64, 0u64, 4u32) { return 119; }
    if !check_unop_ok(t_ptr, MIR_UNOP_NEG, 6u32, 42u64, 0xD6u64) { return 120; }
    if !check_unop_ovf(t_ptr, MIR_UNOP_NEG, 6u32, 0x80u64) { return 121; }
    // `MIR_UNOP_NOT` only folds `bool` (`type#4`); `MIR_UNOP_BITNOT` folds integer bitwise NOT.
    if !check_unop_ovf(t_ptr, MIR_UNOP_NOT, 6u32, 0x0Fu64) { return 122; }
    if !check_unop_ok(t_ptr, MIR_UNOP_BITNOT, 6u32, 0x0Fu64, 0xF0u64) { return 123; }
    // Mismatched operand types must be rejected (`lhs.constant.ty.v != rhs.constant.ty.v`).
    if !check_binop_mismatch(t_ptr, MIR_BINOP_ADD, 8u32, 13u32, 1u64, 1u64) { return 124; }
    if !check_binop_mismatch(t_ptr, MIR_BINOP_LT, 6u32, 8u32, 1u64, 2u64) { return 125; }

    // --- i16 (type#7) ---
    if !check_binop_ok(t_ptr, MIR_BINOP_ADD, 7u32, 32766u64, 1u64, 32767u64, 7u32) { return 130; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_ADD, 7u32, 32767u64, 1u64) { return 131; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_SUB, 7u32, 0x8000u64, 1u64) { return 132; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_DIV, 7u32, 0x8000u64, 0xFFFFu64) { return 133; }
    if !check_unop_ovf(t_ptr, MIR_UNOP_NEG, 7u32, 0x8000u64) { return 134; }
    if !check_unop_ok(t_ptr, MIR_UNOP_NEG, 7u32, 1u64, 0xFFFFu64) { return 135; }

    // --- i32 (type#8) ---
    if !check_binop_ok(t_ptr, MIR_BINOP_ADD, 8u32, 0x7FFFFFFEu64, 1u64, 0x7FFFFFFFu64, 8u32) { return 140; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_ADD, 8u32, 0x7FFFFFFFu64, 1u64) { return 141; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_SUB, 8u32, 0x80000000u64, 1u64) { return 142; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_DIV, 8u32, 0x80000000u64, 0xFFFFFFFFu64) { return 143; }
    if !check_binop_ok(t_ptr, MIR_BINOP_SHL, 8u32, 1u64, 31u64, 0x80000000u64, 8u32) { return 144; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_SHL, 8u32, 1u64, 32u64) { return 145; }
    if !check_binop_ok(t_ptr, MIR_BINOP_SHR, 8u32, 0x80000000u64, 31u64, 0xFFFFFFFFu64, 8u32) { return 146; }
    if !check_unop_ovf(t_ptr, MIR_UNOP_NEG, 8u32, 0x80000000u64) { return 147; }

    // --- i64 (type#9) & isize (type#10) ---
    if !check_binop_ok(t_ptr, MIR_BINOP_ADD, 9u32, 0x7FFFFFFFFFFFFFFEu64, 1u64, 0x7FFFFFFFFFFFFFFFu64, 9u32) { return 150; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_ADD, 9u32, 0x7FFFFFFFFFFFFFFFu64, 1u64) { return 151; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_SUB, 9u32, 0x8000000000000000u64, 1u64) { return 152; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_SUB, 9u32, 0u64, 0x8000000000000000u64) { return 153; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_MUL, 9u32, 0x8000000000000000u64, 0xFFFFFFFFFFFFFFFFu64) { return 154; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_MUL, 9u32, 0x4000000000000000u64, 2u64) { return 155; }
    if !check_binop_ok(t_ptr, MIR_BINOP_MUL, 9u32, 0x4000000000000000u64, 0xFFFFFFFFFFFFFFFEu64, 0x8000000000000000u64, 9u32) { return 156; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_DIV, 9u32, 0x8000000000000000u64, 0xFFFFFFFFFFFFFFFFu64) { return 157; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_REM, 9u32, 0x8000000000000000u64, 0xFFFFFFFFFFFFFFFFu64) { return 158; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_DIV, 10u32, 100u64, 0u64) { return 159; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_REM, 10u32, 100u64, 0u64) { return 160; }
    if !check_unop_ovf(t_ptr, MIR_UNOP_NEG, 9u32, 0x8000000000000000u64) { return 161; }
    if !check_unop_ok(t_ptr, MIR_UNOP_NEG, 10u32, 1u64, 0xFFFFFFFFFFFFFFFFu64) { return 162; }
    if !check_binop_ok(t_ptr, MIR_BINOP_SHL, 9u32, 1u64, 63u64, 0x8000000000000000u64, 9u32) { return 163; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_SHL, 9u32, 1u64, 64u64) { return 164; }
    if !check_binop_ok(t_ptr, MIR_BINOP_SHR, 9u32, 0x8000000000000000u64, 63u64, 0xFFFFFFFFFFFFFFFFu64, 9u32) { return 165; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_SHR, 9u32, 1u64, 64u64) { return 166; }
    if !check_binop_ok(t_ptr, MIR_BINOP_LT, 9u32, 0x8000000000000000u64, 0x7FFFFFFFFFFFFFFFu64, 1u64, 4u32) { return 167; }
    if !check_binop_ok(t_ptr, MIR_BINOP_LE, 9u32, 0x8000000000000000u64, 0x8000000000000000u64, 1u64, 4u32) { return 168; }
    if !check_binop_ok(t_ptr, MIR_BINOP_GE, 9u32, 0x7FFFFFFFFFFFFFFFu64, 0x8000000000000000u64, 1u64, 4u32) { return 169; }

    // --- u8 (type#11), u16 (type#12), u32 (type#13), u64 (type#14), usize (type#15), char (type#5), bool (type#4) ---
    if !check_binop_ok(t_ptr, MIR_BINOP_ADD, 11u32, 200u64, 55u64, 255u64, 11u32) { return 170; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_ADD, 11u32, 200u64, 56u64) { return 171; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_SUB, 11u32, 0u64, 1u64) { return 172; }
    if !check_binop_ok(t_ptr, MIR_BINOP_MUL, 11u32, 16u64, 15u64, 240u64, 11u32) { return 173; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_MUL, 11u32, 16u64, 16u64) { return 174; }
    if !check_binop_ok(t_ptr, MIR_BINOP_LT, 11u32, 250u64, 10u64, 0u64, 4u32) { return 175; }
    if !check_unop_ovf(t_ptr, MIR_UNOP_NEG, 11u32, 1u64) { return 176; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_ADD, 12u32, 65535u64, 1u64) { return 177; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_SUB, 12u32, 0u64, 1u64) { return 178; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_ADD, 13u32, 0xFFFFFFFFu64, 1u64) { return 179; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_MUL, 13u32, 0x10000u64, 0x10000u64) { return 180; }
    if !check_binop_ok(t_ptr, MIR_BINOP_MUL, 13u32, 0xFFFFu64, 0xFFFFu64, 0xFFFE0001u64, 13u32) { return 181; }
    if !check_binop_ok(t_ptr, MIR_BINOP_ADD, 5u32, 65u64, 1u64, 66u64, 5u32) { return 182; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_ADD, 14u32, 0xFFFFFFFFFFFFFFFFu64, 1u64) { return 183; }
    if !check_binop_ok(t_ptr, MIR_BINOP_ADD, 14u32, 0xFFFFFFFFFFFFFFFEu64, 1u64, 0xFFFFFFFFFFFFFFFFu64, 14u32) { return 184; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_SUB, 14u32, 0u64, 1u64) { return 185; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_MUL, 14u32, 0xFFFFFFFFFFFFFFFFu64, 2u64) { return 186; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_MUL, 14u32, 0x100000000u64, 0x100000000u64) { return 187; }
    if !check_binop_ok(t_ptr, MIR_BINOP_MUL, 15u32, 0xFFFFFFFFu64, 0xFFFFFFFFu64, 0xFFFFFFFE00000001u64, 15u32) { return 188; }
    if !check_binop_ok(t_ptr, MIR_BINOP_SHR, 14u32, 0xFFFFFFFF00000000u64, 32u64, 0xFFFFFFFFu64, 14u32) { return 189; }
    if !check_binop_ok(t_ptr, MIR_BINOP_GT, 14u32, 0xFFFFFFFFFFFFFFFFu64, 0u64, 1u64, 4u32) { return 190; }
    if !check_binop_ok(t_ptr, MIR_BINOP_BIT_AND, 14u32, 0xF0F0u64, 0x0FF0u64, 0x00F0u64, 14u32) { return 191; }
    if !check_binop_ok(t_ptr, MIR_BINOP_BIT_OR, 14u32, 0xF000u64, 0x00F0u64, 0xF0F0u64, 14u32) { return 192; }
    if !check_binop_ok(t_ptr, MIR_BINOP_BIT_XOR, 14u32, 0xFF00u64, 0x0FF0u64, 0xF0F0u64, 14u32) { return 193; }
    if !check_unop_ok(t_ptr, MIR_UNOP_NOT, 4u32, 0u64, 1u64) { return 194; }
    if !check_unop_ok(t_ptr, MIR_UNOP_NOT, 4u32, 1u64, 0u64) { return 195; }
    if !check_binop_ok(t_ptr, MIR_BINOP_EQ, 4u32, 1u64, 1u64, 1u64, 4u32) { return 196; }
    if !check_binop_ok(t_ptr, MIR_BINOP_NE, 4u32, 1u64, 0u64, 1u64, 4u32) { return 197; }

    // Also test null Thir fallback (`0 as *const Thir`)
    if !check_binop_ok(0 as *const Thir, MIR_BINOP_ADD, 8u32, 40u64, 2u64, 42u64, 8u32) { return 198; }
    if !check_unop_ok(0 as *const Thir, MIR_UNOP_NOT, 4u32, 0u64, 1u64) { return 199; }

    // QA Round 1 boundary cases:
    // - `MIR_UNOP_NEG` on `bool` (`type#4`) and `char` (`type#5`) must be rejected; `MIR_UNOP_NOT` on `u32`/`char` must be rejected
    if !check_unop_ovf(t_ptr, MIR_UNOP_NEG, 4u32, 1u64) { return 250; }
    if !check_unop_ovf(t_ptr, MIR_UNOP_NEG, 5u32, 1u64) { return 250; }
    if !check_unop_ovf(t_ptr, MIR_UNOP_NOT, 13u32, 0u64) { return 251; }
    if !check_unop_ovf(t_ptr, MIR_UNOP_NOT, 5u32, 0u64) { return 252; }
    // - `INT8_MIN / 1` and `INT8_MIN % 1` succeed (`0x80` and `0`), while `INT16_MIN % -1` (`0x8000 % 0xFFFF`) overflows
    if !check_binop_ok(t_ptr, MIR_BINOP_DIV, 6u32, 0x80u64, 1u64, 0x80u64, 6u32) { return 253; }
    if !check_binop_ok(t_ptr, MIR_BINOP_REM, 6u32, 0x80u64, 1u64, 0u64, 6u32) { return 254; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_REM, 7u32, 0x8000u64, 0xFFFFu64) { return 255; }
    // - Negative shift counts (two's complement `-1` = `0xFFFFFFFFFFFFFFFF`) on signed types must be rejected
    if !check_binop_ovf(t_ptr, MIR_BINOP_SHL, 8u32, 1u64, 0xFFFFFFFFFFFFFFFFu64) { return 256; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_SHR, 9u32, 1u64, 0xFFFFFFFFFFFFFFFFu64) { return 257; }
    // - Non-integer types (`unit` = `type#2`, `str` = `type#16`, unknown `type#99`) must be rejected
    if !check_binop_ovf(t_ptr, MIR_BINOP_ADD, 2u32, 0u64, 0u64) { return 258; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_EQ, 16u32, 0u64, 0u64) { return 259; }
    if !check_unop_ovf(t_ptr, MIR_UNOP_BITNOT, 99u32, 0u64) { return 260; }

    opt_free_minimal_thir(thir_ptr);
    arena_reset(mut_view(*arena));
    0
}

fn check_mir_blob_pair(
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    out: mut_view<DiagBuffer>,
    in_idx: usize,
    exp_idx: usize,
    err_base: i32
) -> i32 {
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    out.len = 0;
    let in_sv = unit_mir_blob(mut_view(*arena), in_idx);
    let exp_sv = unit_mir_blob(mut_view(*arena), exp_idx);
    let ok = if in_idx == 0 {
        opt_mir_text(in_sv, mut_view(*out), mut_view(*sink), true)
    } else {
        opt_mir_text_in_arena(in_sv, mut_view(*out), mut_view(*sink), false, mut_view(*arena))
    };
    if !ok || sink.errors != 0 {
        return err_base;
    }
    if !str_eq_buf(view(*out), view(exp_sv)) {
        return err_base + 1;
    }
    arena_reset(mut_view(*arena));
    0
}

// 2. MIR optimization pass & differential MIR text tests.
fn test_mir_passes(arena: mut_view<Arena>, sink: mut_view<DiagSink>, out_ptr: *mut u8) -> i32 {
    let mut out = DiagBuffer { ptr: out_ptr, len: 0, cap: 32768 };

    // Case 0 (blobs 0 -> 1): Full `-O1` pipeline (const_fold + dce + cfg_simplify) with `verify_each = true`.
    let rc0 = check_mir_blob_pair(mut_view(*arena), mut_view(*sink), mut_view(out), 0, 1, 201);
    if rc0 != 0 { return rc0; }

    // Case 1 (blobs 2 -> 3): Overflowing constant ops & div-by-zero are NOT folded and NOT DCE'd.
    let rc1 = check_mir_blob_pair(mut_view(*arena), mut_view(*sink), mut_view(out), 2, 3, 203);
    if rc1 != 0 { return rc1; }

    // Case 2 (blobs 4 -> 5): Multi-iteration transitive DCE of unused pure chains and StorageLive/StorageDead.
    let rc2 = check_mir_blob_pair(mut_view(*arena), mut_view(*sink), mut_view(out), 4, 5, 205);
    if rc2 != 0 { return rc2; }

    // Case 3 (blob 6): Extended CFG simplification (`opt_cfg_eliminate_redundant_switches`,
    // `opt_cfg_merge_linear_blocks`, and `opt_run_with_merge`).
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let thir_ptr = arena_alloc_raw(mut_view(*arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    opt_init_minimal_thir(thir_ptr, mut_view(*arena));
    let in3 = unit_mir_blob(mut_view(*arena), 6);
    let body3 = verify_parse_mir(
        in3,
        unsafe { mut_view((*thir_ptr).interner) },
        mut_view(*arena)
    );
    if (body3 as usize) == 0 {
        opt_free_minimal_thir(thir_ptr);
        return 207;
    }
    opt_run_with_merge(
        unsafe { mut_view(*body3) },
        thir_ptr as *const Thir,
        mut_view(*arena),
        mut_view(*sink),
        true,
        0 as *const HirItem
    );
    if sink.errors != 0 {
        opt_free_minimal_thir(thir_ptr);
        return 208;
    }
    // After `opt_run_with_merge`, `bb0` should have merged `bb2` and `bb3` and terminate with `return`,
    // while `bb1`, `bb2`, and `bb3` should be `unreachable` with 0 statements.
    let bb0 = unsafe { mir_bb_at((*body3).bbs, 0) };
    let bb1 = unsafe { mir_bb_at((*body3).bbs, 1) };
    let bb2 = unsafe { mir_bb_at((*body3).bbs, 2) };
    let bb3 = unsafe { mir_bb_at((*body3).bbs, 3) };
    let bb0_tk = unsafe { (*bb0).terminator.kind };
    let bb1_tk = unsafe { (*bb1).terminator.kind };
    let bb2_tk = unsafe { (*bb2).terminator.kind };
    let bb3_tk = unsafe { (*bb3).terminator.kind };
    let bb1_sc = unsafe { (*bb1).stmt_count };
    let bb2_sc = unsafe { (*bb2).stmt_count };
    let bb3_sc = unsafe { (*bb3).stmt_count };
    opt_free_minimal_thir(thir_ptr);
    if bb0_tk != MIR_TERM_RETURN ||
       bb1_tk != MIR_TERM_UNREACHABLE || bb1_sc != 0 ||
       bb2_tk != MIR_TERM_UNREACHABLE || bb2_sc != 0 ||
       bb3_tk != MIR_TERM_UNREACHABLE || bb3_sc != 0 {
        return 209;
    }
    arena_reset(mut_view(*arena));

    // Case 4 (blobs 7 -> 8): Differential test on `tests/opt/qa_dce_run.ax` lowered MIR vs `axiom0 -O1`.
    let rc4 = check_mir_blob_pair(mut_view(*arena), mut_view(*sink), mut_view(out), 7, 8, 210);
    if rc4 != 0 { return rc4; }

    // Case 5 (blobs 9 -> 10): Regression test for Finding 2 — foldable `MIR_RVALUE_BINARY_OP`
    // followed immediately by overflowing or runtime `MIR_RVALUE_OVERFLOWS_BINARY_OP` must NOT
    // rewrite the subsequent overflow check to `const 0`.
    let rc5 = check_mir_blob_pair(mut_view(*arena), mut_view(*sink), mut_view(out), 9, 10, 212);
    if rc5 != 0 { return rc5; }

    // Case 6 (blobs 11 -> 12): Regression test for Finding 3 — (a) `MIR_RVALUE_UNARY_OP` is not
    // considered pure in `opt_rvalue_is_pure`, so unused `_1 = -const 128: type#6;` is preserved;
    // (b) `opt_dce` skips `MIR_TERM_UNREACHABLE` blocks during use counting, so a use in an
    // already-unreachable block does not keep dead `_2 = const 99: type#8;` in `bb0` alive.
    let rc6 = check_mir_blob_pair(mut_view(*arena), mut_view(*sink), mut_view(out), 11, 12, 214);
    if rc6 != 0 { return rc6; }

    // Case 7 (blobs 13 -> 14): Differential test on `tests/opt/const_fold_run.ax` lowered MIR vs `axiom0 -O1`.
    let rc7 = check_mir_blob_pair(mut_view(*arena), mut_view(*sink), mut_view(out), 13, 14, 216);
    if rc7 != 0 { return rc7; }

    // Case 8 (blobs 15 -> 16): Differential test on `tests/opt/qa_edge_cases_run.ax` lowered MIR vs `axiom0 -O1`.
    let rc8 = check_mir_blob_pair(mut_view(*arena), mut_view(*sink), mut_view(out), 15, 16, 218);
    if rc8 != 0 { return rc8; }

    0
}

// 3. OptIR, Cooper-Harvey-Kennedy dominators & dominance frontier, minimal SSA (OptPhi, Copy/Move
//    value sharing, SROA), MemorySSA (LiveOnEntry, MemoryDef, MemoryUse, MemoryPhi, AliasResult,
//    clobber walker), 3-valued Certainty lattice, ProofProvenance, contract verification,
//    MIR reconstruction, and unverified MIR rejection (E15.1 / SPEC-70).
fn test_optir_ssa_memssa_certainty(arena: mut_view<Arena>, sink: mut_view<DiagSink>, out_ptr: *mut u8) -> i32 {
    // 3.1 Three-valued Certainty lattice laws (REQ-OPT-397..402)
    if certainty_and(CERTAINTY_PROVEN, CERTAINTY_PROVEN) != CERTAINTY_PROVEN { return 301; }
    if certainty_and(CERTAINTY_PROVEN, CERTAINTY_POSSIBLE) != CERTAINTY_POSSIBLE { return 302; }
    if certainty_and(CERTAINTY_POSSIBLE, CERTAINTY_POSSIBLE) != CERTAINTY_POSSIBLE { return 303; }
    if certainty_and(CERTAINTY_PROVEN, CERTAINTY_UNKNOWN) != CERTAINTY_UNKNOWN { return 304; }
    if certainty_and(CERTAINTY_POSSIBLE, CERTAINTY_UNKNOWN) != CERTAINTY_UNKNOWN { return 305; }
    if certainty_and(CERTAINTY_UNKNOWN, CERTAINTY_UNKNOWN) != CERTAINTY_UNKNOWN { return 306; }

    if certainty_join_paths(CERTAINTY_PROVEN, CERTAINTY_PROVEN) != CERTAINTY_PROVEN { return 307; }
    if certainty_join_paths(CERTAINTY_PROVEN, CERTAINTY_POSSIBLE) != CERTAINTY_POSSIBLE { return 308; }
    if certainty_join_paths(CERTAINTY_PROVEN, CERTAINTY_UNKNOWN) != CERTAINTY_POSSIBLE { return 309; }
    if certainty_join_paths(CERTAINTY_POSSIBLE, CERTAINTY_UNKNOWN) != CERTAINTY_POSSIBLE { return 310; }
    if certainty_join_paths(CERTAINTY_UNKNOWN, CERTAINTY_UNKNOWN) != CERTAINTY_UNKNOWN { return 311; }

    if certainty_negate_hazard(false, CERTAINTY_PROVEN) != CERTAINTY_PROVEN { return 312; }
    if certainty_negate_hazard(false, CERTAINTY_POSSIBLE) != CERTAINTY_POSSIBLE { return 313; }
    if certainty_negate_hazard(false, CERTAINTY_UNKNOWN) != CERTAINTY_UNKNOWN { return 314; }
    if certainty_negate_hazard(true, CERTAINTY_PROVEN) != CERTAINTY_POSSIBLE { return 315; }
    if certainty_negate_hazard(true, CERTAINTY_POSSIBLE) != CERTAINTY_UNKNOWN { return 316; }
    if certainty_negate_hazard(true, CERTAINTY_UNKNOWN) != CERTAINTY_UNKNOWN { return 317; }

    if !certainty_can_rewrite(CERTAINTY_PROVEN) { return 318; }
    if certainty_can_rewrite(CERTAINTY_POSSIBLE) { return 319; }
    if certainty_can_rewrite(CERTAINTY_UNKNOWN) { return 320; }
    if certainty_should_emit_remark(CERTAINTY_PROVEN) { return 321; }
    if !certainty_should_emit_remark(CERTAINTY_POSSIBLE) { return 322; }
    if certainty_should_emit_remark(CERTAINTY_UNKNOWN) { return 323; }

    // 3.2 Lower Verified MIR fixture (blob 17) into OptIR + SSA + MemorySSA
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let thir_ptr = arena_alloc_raw(mut_view(*arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    opt_init_minimal_thir(thir_ptr, mut_view(*arena));
    let in17 = unit_mir_blob(mut_view(*arena), 17);
    let body17 = verify_parse_mir(
        in17,
        unsafe { mut_view((*thir_ptr).interner) },
        mut_view(*arena)
    );
    if (body17 as usize) == 0 {
        opt_free_minimal_thir(thir_ptr);
        return 324;
    }
    let opt_body = optir_build_from_mir(
        unsafe { view(*body17) },
        thir_ptr as *const Thir,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    );
    if (opt_body as usize) == 0 || sink.errors != 0 {
        opt_free_minimal_thir(thir_ptr);
        return 325;
    }

    // 3.3 Check CFG, RPO, Cooper-Harvey-Kennedy dominator tree, and dominance frontier (AXS-OPT-011)
    let bbc = unsafe { (*opt_body).bb_count };
    let rpoc = unsafe { (*opt_body).rpo_count };
    if bbc != 6 || rpoc != 6 {
        opt_free_minimal_thir(thir_ptr);
        return 326;
    }
    let obb0 = unsafe { opt_block_at((*opt_body).blocks, 0) };
    let obb1 = unsafe { opt_block_at((*opt_body).blocks, 1) };
    let obb2 = unsafe { opt_block_at((*opt_body).blocks, 2) };
    let obb3 = unsafe { opt_block_at((*opt_body).blocks, 3) };
    let obb4 = unsafe { opt_block_at((*opt_body).blocks, 4) };
    let obb5 = unsafe { opt_block_at((*opt_body).blocks, 5) };
    if (unsafe { (*obb0).idom.v }) != 0u32 || (unsafe { (*obb0).dom_depth }) != 0u32 ||
       (unsafe { (*obb1).idom.v }) != 0u32 || (unsafe { (*obb1).dom_depth }) != 1u32 ||
       (unsafe { (*obb2).idom.v }) != 0u32 || (unsafe { (*obb2).dom_depth }) != 1u32 ||
       (unsafe { (*obb3).idom.v }) != 0u32 || (unsafe { (*obb3).dom_depth }) != 1u32 ||
       (unsafe { (*obb4).idom.v }) != 3u32 || (unsafe { (*obb4).dom_depth }) != 2u32 ||
       (unsafe { (*obb5).idom.v }) != 3u32 || (unsafe { (*obb5).dom_depth }) != 2u32 {
        opt_free_minimal_thir(thir_ptr);
        return 327;
    }
    let bb0_id = OptBbId { v: 0u32 };
    let bb1_id = OptBbId { v: 1u32 };
    let bb3_id = OptBbId { v: 3u32 };
    let bb4_id = OptBbId { v: 4u32 };
    let bb5_id = OptBbId { v: 5u32 };
    if !opt_dominates(unsafe { view(*opt_body) }, bb0_id, bb5_id) ||
       !opt_strictly_dominates(unsafe { view(*opt_body) }, bb3_id, bb4_id) ||
       opt_dominates(unsafe { view(*opt_body) }, bb1_id, bb3_id) {
        opt_free_minimal_thir(thir_ptr);
        return 328;
    }
    // DF(bb1) = {bb3}, DF(bb2) = {bb3}, DF(bb4) = {bb3}
    if (unsafe { (*obb1).dom_frontier_count }) != 1 ||
       (unsafe { (*opt_bbid_at((*obb1).dom_frontier, 0)).v }) != 3u32 ||
       (unsafe { (*obb2).dom_frontier_count }) != 1 ||
       (unsafe { (*opt_bbid_at((*obb2).dom_frontier, 0)).v }) != 3u32 ||
       (unsafe { (*obb4).dom_frontier_count }) != 1 ||
       (unsafe { (*opt_bbid_at((*obb4).dom_frontier, 0)).v }) != 3u32 {
        opt_free_minimal_thir(thir_ptr);
        return 329;
    }

    // 3.4 Check Copy/Move SSA value sharing (REQ-OPT-337, REQ-OPT-338)
    let inst0 = unsafe { opt_inst_at((*obb0).insts, 0) }; // _1 = const 5
    let inst1 = unsafe { opt_inst_at((*obb0).insts, 1) }; // _2 = copy _1
    let inst2 = unsafe { opt_inst_at((*obb0).insts, 2) }; // _3 = move _2
    let v0_id = unsafe { (*inst0).result.v };
    let v1_id = unsafe { (*inst1).result.v };
    let v2_id = unsafe { (*inst2).result.v };
    let inst2_flags = unsafe { (*inst2).flags };
    if v0_id == 0u32 || v0_id != v1_id || v1_id != v2_id || (inst2_flags & OPT_FLAG_MOVE) == 0u16 {
        opt_free_minimal_thir(thir_ptr);
        return 330;
    }

    // 3.5 Check SROA aggregate field projection on local _4 (AXS-OPT-014)
    let mode4 = unsafe { *opt_u8_at((*opt_body).local_modes, 4) };
    let sroa4_cnt = unsafe { *opt_u32_at((*opt_body).local_sroa_count, 4) };
    if mode4 != OPT_LOCAL_SROA || sroa4_cnt != 2u32 {
        opt_free_minimal_thir(thir_ptr);
        return 331;
    }
    let inst4 = unsafe { opt_inst_at((*obb0).insts, 4) }; // (_4.0) = const 20
    let inst5 = unsafe { opt_inst_at((*obb0).insts, 5) }; // _5 = copy (_4.0) + copy (_4.1)
    if (unsafe { (*inst5).lhs.v }) != (unsafe { (*inst4).result.v }) {
        opt_free_minimal_thir(thir_ptr);
        return 332;
    }

    // 3.6 Check minimal SSA OptPhi placement at bb3 (AXS-OPT-013)
    let bb3_phis = unsafe { (*obb3).phi_count };
    if bb3_phis == 0 {
        opt_free_minimal_thir(thir_ptr);
        return 333;
    }
    let phi0 = unsafe { opt_phi_at((*obb3).phis, 0) };
    if (unsafe { (*phi0).src_local.v }) != 9u32 || (unsafe { (*phi0).arity }) != 3 {
        opt_free_minimal_thir(thir_ptr);
        return 334;
    }

    // 3.7 Check MemorySSA (LiveOnEntry, MemoryDef, MemoryUse, MemoryPhi, AliasResult, clobber walker)
    let mode7 = unsafe { *opt_u8_at((*opt_body).local_modes, 7) };
    let mode10 = unsafe { *opt_u8_at((*opt_body).local_modes, 10) };
    if mode7 != OPT_LOCAL_MEMORY || mode10 != OPT_LOCAL_MEMORY {
        opt_free_minimal_thir(thir_ptr);
        return 335;
    }
    if (unsafe { (*opt_body).mem_ssa_count }) < 4 {
        opt_free_minimal_thir(thir_ptr);
        return 336;
    }
    let mdef0 = unsafe { opt_memdef_at((*opt_body).mem_defs, 0) };
    if (unsafe { (*mdef0).kind }) != MEM_DEF_LIVE_ON_ENTRY {
        opt_free_minimal_thir(thir_ptr);
        return 337;
    }
    if !(unsafe { (*obb3).has_mem_phi }) {
        opt_free_minimal_thir(thir_ptr);
        return 338;
    }
    let inst6 = unsafe { opt_inst_at((*obb0).insts, 6) }; // _7 = const 50 (Store -> mem1)
    let inst7 = unsafe { opt_inst_at((*obb0).insts, 7) }; // _10 = const 77 (Store -> mem2)
    let inst8 = unsafe { opt_inst_at((*obb0).insts, 8) }; // _12 = copy _7 (Load -> uses mem2)
    if (unsafe { (*inst6).opcode }) != OPT_INST_STORE ||
       (unsafe { (*inst7).opcode }) != OPT_INST_STORE ||
       (unsafe { (*inst8).opcode }) != OPT_INST_LOAD {
        opt_free_minimal_thir(thir_ptr);
        return 339;
    }
    let mem1_id = MemSsaId { v: unsafe { (*inst6).mem_def.v } };
    let mem2_id = MemSsaId { v: unsafe { (*inst7).mem_def.v } };
    let load_use_id = MemSsaId { v: unsafe { (*inst8).mem_use.v } };
    if mem1_id.v == 0u32 || mem2_id.v == 0u32 || load_use_id.v != mem2_id.v {
        opt_free_minimal_thir(thir_ptr);
        return 340;
    }
    let mdef1 = unsafe { opt_memdef_at((*opt_body).mem_defs, mem1_id.v as usize) };
    if (unsafe { (*mdef1).kind }) != MEM_DEF_INST || (unsafe { (*mdef1).prev_mem.v }) != 0u32 {
        opt_free_minimal_thir(thir_ptr);
        return 341;
    }
    let reg7 = optir_extract_memory_region(unsafe { view(*opt_body) }, unsafe { view((*inst6).place) });
    let reg10 = optir_extract_memory_region(unsafe { view(*opt_body) }, unsafe { view((*inst7).place) });
    let al_same = optir_alias_query(unsafe { view(*opt_body) }, view(reg7), view(reg7));
    let al_diff = optir_alias_query(unsafe { view(*opt_body) }, view(reg7), view(reg10));
    if al_same != ALIAS_MUST_ALIAS || al_diff != ALIAS_NO_ALIAS {
        opt_free_minimal_thir(thir_ptr);
        return 342;
    }
    // mem2 (store to _10) must NOT clobber reg7, whereas mem1 (store to _7) MUST clobber reg7
    if memssa_does_clobber(unsafe { view(*opt_body) }, mem2_id, view(reg7)) ||
       !memssa_does_clobber(unsafe { view(*opt_body) }, mem1_id, view(reg7)) {
        opt_free_minimal_thir(thir_ptr);
        return 343;
    }
    let clobber_def = memssa_find_clobbering_def(
        unsafe { view(*opt_body) },
        load_use_id,
        view(reg7),
        64u32
    );
    if clobber_def.v != mem1_id.v {
        opt_free_minimal_thir(thir_ptr);
        return 344;
    }

    // 3.8 Check ProofProvenance & OptIR contract verification & MIR reconstruction
    if (unsafe { (*opt_body).provenance_count }) < 4 {
        opt_free_minimal_thir(thir_ptr);
        return 345;
    }
    if !optir_verify_contract(unsafe { view(*opt_body) }) {
        opt_free_minimal_thir(thir_ptr);
        return 346;
    }
    let recon_mir = arena_alloc_raw(mut_view(*arena), size_of<MirBody>(), align_of<MirBody>()) as *mut MirBody;
    if !optir_reconstruct_mir(unsafe { view(*opt_body) }, unsafe { mut_view(*recon_mir) }, mut_view(*arena)) {
        opt_free_minimal_thir(thir_ptr);
        return 347;
    }
    verify_mir(
        unsafe { view(*recon_mir) },
        thir_ptr as *const Thir,
        mut_view(*sink),
        0 as *const HirItem
    );
    if sink.errors != 0 {
        opt_free_minimal_thir(thir_ptr);
        return 348;
    }
    opt_free_minimal_thir(thir_ptr);
    arena_reset(mut_view(*arena));

    // 3.9 Check optir_inspect_mir_text (--emit=optir and --emit=memssa) & negative unverified MIR rejection
    let mut out = DiagBuffer { ptr: out_ptr, len: 0, cap: 32768 };
    let in17_b = unit_mir_blob(mut_view(*arena), 17);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    out.len = 0;
    if !optir_inspect_mir_text(in17_b, false, true, mut_view(out), mut_view(*sink), mut_view(*arena)) || sink.errors != 0 || out.len == 0 {
        return 349;
    }
    let in17_c = unit_mir_blob(mut_view(*arena), 17);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    out.len = 0;
    if !optir_inspect_mir_text(in17_c, true, true, mut_view(out), mut_view(*sink), mut_view(*arena)) || sink.errors != 0 || out.len == 0 {
        return 350;
    }
    let in18_bad = unit_mir_blob(mut_view(*arena), 18);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    out.len = 0;
    if optir_inspect_mir_text(in18_bad, false, false, mut_view(out), mut_view(*sink), mut_view(*arena)) || sink.errors == 0 {
        return 351;
    }
    arena_reset(mut_view(*arena));
    0
}

fn test_passmgr_effects_and_contracts(arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> i32 {
    // 4.1 EffectInfo lattice, fail-closed Unknown != Pure, and call classifications (REQ-OPT-321, REQ-OPT-348..349, REQ-OPT-393..398)
    if !effect_is_pure(EFFECT_PURE) || effect_is_pure(EFFECT_UNKNOWN) || effect_is_pure(EFFECT_READS_MEM) {
        return 401;
    }
    if effect_pure_certainty(EFFECT_PURE) != CERTAINTY_PROVEN ||
       effect_pure_certainty(EFFECT_UNKNOWN) != CERTAINTY_UNKNOWN ||
       effect_pure_certainty(EFFECT_IO) != CERTAINTY_UNKNOWN {
        return 402;
    }
    if effect_for_call_kind(CALL_KIND_PURE_INTRINSIC) != EFFECT_PURE {
        return 403;
    }
    if (effect_for_call_kind(CALL_KIND_HOST_IO) & (EFFECT_IO | EFFECT_MAY_PANIC)) != (EFFECT_IO | EFFECT_MAY_PANIC) {
        return 404;
    }
    if (effect_for_call_kind(CALL_KIND_VOLATILE_INTRINSIC) & EFFECT_VOLATILE) == 0u16 ||
       (effect_for_call_kind(CALL_KIND_ATOMIC_INTRINSIC) & EFFECT_ATOMIC) == 0u16 ||
       (effect_for_call_kind(CALL_KIND_INDIRECT_UNKNOWN) & EFFECT_UNKNOWN) == 0u16 {
        return 405;
    }

    // 4.2 DCE & reordering legality queries
    if !effect_can_dce(EFFECT_PURE) || !effect_can_dce(EFFECT_READS_MEM) {
        return 406;
    }
    if effect_can_dce(EFFECT_WRITES_MEM) || effect_can_dce(EFFECT_MAY_PANIC) ||
       effect_can_dce(EFFECT_IO) || effect_can_dce(EFFECT_VOLATILE) ||
       effect_can_dce(EFFECT_ATOMIC) || effect_can_dce(EFFECT_UNKNOWN) {
        return 407;
    }
    if effect_can_reorder(EFFECT_IO, EFFECT_VOLATILE, ALIAS_NO_ALIAS) ||
       effect_can_reorder(EFFECT_IO, EFFECT_MAY_PANIC, ALIAS_NO_ALIAS) ||
       effect_can_reorder(EFFECT_VOLATILE, EFFECT_READS_MEM, ALIAS_NO_ALIAS) ||
       effect_can_reorder(EFFECT_MAY_PANIC, EFFECT_WRITES_MEM, ALIAS_NO_ALIAS) {
        return 408;
    }
    if !effect_can_reorder(EFFECT_WRITES_MEM, EFFECT_READS_MEM, ALIAS_NO_ALIAS) ||
       effect_can_reorder(EFFECT_WRITES_MEM, EFFECT_READS_MEM, ALIAS_MAY_ALIAS) ||
       effect_can_reorder(EFFECT_VOLATILE, EFFECT_ALLOCATES, ALIAS_NO_ALIAS) ||
       effect_can_reorder(EFFECT_ALLOCATES, EFFECT_READS_MEM, ALIAS_MAY_ALIAS) {
        return 409;
    }

    // Declared annotation verification vs fail-closed unverified annotations (REQ-OPT-396)
    if !effect_annotation_matches_inferred(EFFECT_PURE, EFFECT_PURE) ||
       !effect_annotation_matches_inferred(EFFECT_READS_MEM, EFFECT_READS_MEM | EFFECT_WRITES_MEM) ||
       effect_annotation_matches_inferred(EFFECT_IO, EFFECT_PURE) ||
       effect_annotation_matches_inferred(EFFECT_MASK_CONSERVATIVE_CALL, EFFECT_PURE) {
        return 450;
    }
    if effect_resolve_declared_flags(EFFECT_MASK_CONSERVATIVE_CALL, EFFECT_PURE, false) != EFFECT_MASK_CONSERVATIVE_CALL ||
       effect_resolve_declared_flags(EFFECT_IO, EFFECT_PURE, false) != EFFECT_IO ||
       effect_resolve_declared_flags(EFFECT_MASK_CONSERVATIVE_CALL, EFFECT_PURE, true) != EFFECT_PURE ||
       effect_resolve_declared_flags(EFFECT_IO, EFFECT_PURE, true) != EFFECT_IO {
        return 451;
    }

    // 4.3 Call-graph bottom-up fixed-point propagation & recursion cycle detection
    let cg_ptr = arena_alloc_raw(mut_view(*arena), size_of<EffectCallGraph>(), align_of<EffectCallGraph>()) as *mut EffectCallGraph;
    effect_call_graph_init(unsafe { mut_view(*cg_ptr) }, mut_view(*arena), 8, 16);
    let n0 = effect_call_graph_add_node(unsafe { mut_view(*cg_ptr) }, SymbolId { v: 10u32 }, EFFECT_PURE, false);
    let n1 = effect_call_graph_add_node(unsafe { mut_view(*cg_ptr) }, SymbolId { v: 11u32 }, EFFECT_READS_MEM, false);
    let n2 = effect_call_graph_add_node(unsafe { mut_view(*cg_ptr) }, SymbolId { v: 12u32 }, EFFECT_IO | EFFECT_MAY_PANIC, false);
    let n3 = effect_call_graph_add_node(unsafe { mut_view(*cg_ptr) }, SymbolId { v: 13u32 }, EFFECT_PURE, false);
    let n4 = effect_call_graph_add_node(unsafe { mut_view(*cg_ptr) }, SymbolId { v: 14u32 }, EFFECT_PURE, false);
    // n0 -> n1 -> n2, n3 -> n3 (recursive cycle), and n4 (independent pure subgraph)
    effect_call_graph_add_edge(unsafe { mut_view(*cg_ptr) }, n0, n1);
    effect_call_graph_add_edge(unsafe { mut_view(*cg_ptr) }, n1, n2);
    effect_call_graph_add_edge(unsafe { mut_view(*cg_ptr) }, n3, n3);
    let cg_rounds = effect_call_graph_propagate(unsafe { mut_view(*cg_ptr) });
    if cg_rounds == 0u32 {
        return 410;
    }
    let s0 = effect_call_graph_node_summary(unsafe { view(*cg_ptr) }, n0);
    let s3 = effect_call_graph_node_summary(unsafe { view(*cg_ptr) }, n3);
    if (s0.flags & (EFFECT_READS_MEM | EFFECT_IO | EFFECT_MAY_PANIC)) != (EFFECT_READS_MEM | EFFECT_IO | EFFECT_MAY_PANIC) {
        return 411;
    }
    if (s3.flags & EFFECT_NONTERM) == 0u16 || s3.pure_certainty != CERTAINTY_UNKNOWN {
        return 412;
    }
    // Incremental summary update (REQ-OPT-394):
    // (a) Body-local edit in n1 adding EFFECT_MAY_PANIC does not change n1's propagated summary -> 0 nodes re-evaluated!
    if effect_call_graph_update_node_local(unsafe { mut_view(*cg_ptr) }, n1, EFFECT_READS_MEM | EFFECT_MAY_PANIC, false) != 0u32 {
        return 452;
    }
    // (b) Body-local edit in n2 adding EFFECT_VOLATILE re-evaluates only {n0, n1, n2} (3 nodes, NOT n3 or n4)
    let reeval_cnt = effect_call_graph_update_node_local(unsafe { mut_view(*cg_ptr) }, n2, EFFECT_IO | EFFECT_MAY_PANIC | EFFECT_VOLATILE, false);
    let s0_after = effect_call_graph_node_summary(unsafe { view(*cg_ptr) }, n0);
    let s4_after = effect_call_graph_node_summary(unsafe { view(*cg_ptr) }, n4);
    if reeval_cnt != 3u32 || (s0_after.flags & EFFECT_VOLATILE) == 0u16 || s4_after.flags != EFFECT_PURE {
        return 453;
    }

    // 4.4 Execution-domain boundary checks (@kernel and comptime, REQ-VER-027)
    let pure_sum = effect_summary_from_flags(SymbolId { v: 1u32 }, EFFECT_PURE);
    let io_sum = effect_summary_from_flags(SymbolId { v: 2u32 }, EFFECT_IO);
    let alloc_sum = effect_summary_from_flags(SymbolId { v: 3u32 }, EFFECT_ALLOCATES);
    let unk_sum = effect_summary_from_flags(SymbolId { v: 4u32 }, EFFECT_UNKNOWN);
    if !effect_verify_execution_domain(view(pure_sum), EXEC_DOMAIN_HOST) ||
       !effect_verify_execution_domain(view(pure_sum), EXEC_DOMAIN_COMPTIME) ||
       !effect_verify_execution_domain(view(pure_sum), EXEC_DOMAIN_KERNEL) {
        return 413;
    }
    if !effect_verify_execution_domain(view(io_sum), EXEC_DOMAIN_HOST) ||
       effect_verify_execution_domain(view(io_sum), EXEC_DOMAIN_COMPTIME) ||
       effect_verify_execution_domain(view(io_sum), EXEC_DOMAIN_KERNEL) {
        return 414;
    }
    if !effect_verify_execution_domain(view(alloc_sum), EXEC_DOMAIN_COMPTIME) ||
       effect_verify_execution_domain(view(alloc_sum), EXEC_DOMAIN_KERNEL) ||
       effect_verify_execution_domain(view(unk_sum), EXEC_DOMAIN_COMPTIME) ||
       effect_verify_execution_domain(view(unk_sum), EXEC_DOMAIN_KERNEL) {
        return 415;
    }

    // 4.5 Build OptBody from unit_mir_blob(17) and test PassManager analysis caching & transitive invalidation
    let thir_ptr = arena_alloc_raw(mut_view(*arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    opt_init_minimal_thir(thir_ptr, mut_view(*arena));
    let in17 = unit_mir_blob(mut_view(*arena), 17);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let mbody = verify_parse_mir(in17, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (mbody as usize) == 0 {
        opt_free_minimal_thir(thir_ptr);
        return 416;
    }
    let obody = optir_build_from_mir(
        unsafe { view(*mbody) },
        thir_ptr as *const Thir,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    );
    if (obody as usize) == 0 || sink.errors != 0 {
        opt_free_minimal_thir(thir_ptr);
        return 417;
    }

    // Verify effect_call_clobbers_region on non-escaping stack local vs escaped local
    let loc2_place = mir_local_place(2u32);
    let reg_local2 = optir_extract_memory_region(unsafe { view(*obody) }, view(loc2_place));
    if reg_local2.domain != STORAGE_STACK_LOCAL ||
       effect_call_clobbers_region(EFFECT_WRITES_MEM | EFFECT_UNKNOWN, view(reg_local2), false) ||
       !effect_call_clobbers_region(EFFECT_WRITES_MEM | EFFECT_UNKNOWN, view(reg_local2), true) {
        opt_free_minimal_thir(thir_ptr);
        return 418;
    }

    let pm_ptr = arena_alloc_raw(mut_view(*arena), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
    let budget_o2 = opt_budget_for_profile(OPT_PROFILE_SPEED_O2, true);
    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget_o2, mut_view(*arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*obody) }, mut_view(*arena));

    if !passmgr_is_analysis_valid(unsafe { view(*pm_ptr) }, ANALYSIS_CFG) ||
       !passmgr_is_analysis_valid(unsafe { view(*pm_ptr) }, ANALYSIS_DOMINATORS) ||
       !passmgr_is_analysis_valid(unsafe { view(*pm_ptr) }, ANALYSIS_SSA) ||
       !passmgr_is_analysis_valid(unsafe { view(*pm_ptr) }, ANALYSIS_MEMORY_SSA) ||
       !passmgr_is_analysis_valid(unsafe { view(*pm_ptr) }, ANALYSIS_RANGE_INFO) {
        opt_free_minimal_thir(thir_ptr);
        return 419;
    }

    // Ensuring already-valid analyses reuses cache without recomputing
    passmgr_ensure_analyses(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*obody) },
        mut_view(*arena),
        ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_RANGE_INFO
    );
    if passmgr_get_analysis_compute_count(unsafe { view(*pm_ptr) }, ANALYSIS_MEMORY_SSA) != 1u32 ||
       passmgr_get_analysis_compute_count(unsafe { view(*pm_ptr) }, ANALYSIS_RANGE_INFO) != 1u32 {
        opt_free_minimal_thir(thir_ptr);
        return 420;
    }

    // Invalidating SSA transitively invalidates MemorySSA, EffectInfo, AliasInfo, EscapeInfo, RangeInfo,
    // while preserving CFG, Dominators, and LoopInfo (AXS-OPT-030)
    passmgr_invalidate_analyses(unsafe { mut_view(*pm_ptr) }, ANALYSIS_MASK_SSA);
    if !passmgr_is_analysis_valid(unsafe { view(*pm_ptr) }, ANALYSIS_CFG) ||
       !passmgr_is_analysis_valid(unsafe { view(*pm_ptr) }, ANALYSIS_DOMINATORS) ||
       !passmgr_is_analysis_valid(unsafe { view(*pm_ptr) }, ANALYSIS_LOOP_INFO) {
        opt_free_minimal_thir(thir_ptr);
        return 421;
    }
    if passmgr_is_analysis_valid(unsafe { view(*pm_ptr) }, ANALYSIS_SSA) ||
       passmgr_is_analysis_valid(unsafe { view(*pm_ptr) }, ANALYSIS_MEMORY_SSA) ||
       passmgr_is_analysis_valid(unsafe { view(*pm_ptr) }, ANALYSIS_EFFECT_INFO) ||
       passmgr_is_analysis_valid(unsafe { view(*pm_ptr) }, ANALYSIS_ALIAS_INFO) ||
       passmgr_is_analysis_valid(unsafe { view(*pm_ptr) }, ANALYSIS_ESCAPE_INFO) ||
       passmgr_is_analysis_valid(unsafe { view(*pm_ptr) }, ANALYSIS_RANGE_INFO) {
        opt_free_minimal_thir(thir_ptr);
        return 422;
    }
    if passmgr_get_analysis_invalidation_count(unsafe { view(*pm_ptr) }, ANALYSIS_MEMORY_SSA) != 1u32 {
        opt_free_minimal_thir(thir_ptr);
        return 423;
    }

    // Ensuring MemorySSA recomputes SSA, MemorySSA, EffectInfo, AliasInfo, but NOT CFG or Dominators
    passmgr_ensure_analyses(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*obody) }, mut_view(*arena), ANALYSIS_MASK_MEMORY_SSA);
    if passmgr_get_analysis_compute_count(unsafe { view(*pm_ptr) }, ANALYSIS_CFG) != 1u32 ||
       passmgr_get_analysis_compute_count(unsafe { view(*pm_ptr) }, ANALYSIS_DOMINATORS) != 1u32 ||
       passmgr_get_analysis_compute_count(unsafe { view(*pm_ptr) }, ANALYSIS_SSA) != 2u32 ||
       passmgr_get_analysis_compute_count(unsafe { view(*pm_ptr) }, ANALYSIS_MEMORY_SSA) != 2u32 {
        opt_free_minimal_thir(thir_ptr);
        return 424;
    }

    // Invalidating CFG transitively invalidates Dominators, SSA, MemorySSA, RangeInfo, LoopInfo
    passmgr_invalidate_analyses(unsafe { mut_view(*pm_ptr) }, ANALYSIS_MASK_CFG);
    if passmgr_is_analysis_valid(unsafe { view(*pm_ptr) }, ANALYSIS_CFG) ||
       passmgr_is_analysis_valid(unsafe { view(*pm_ptr) }, ANALYSIS_DOMINATORS) ||
       passmgr_is_analysis_valid(unsafe { view(*pm_ptr) }, ANALYSIS_SSA) ||
       passmgr_is_analysis_valid(unsafe { view(*pm_ptr) }, ANALYSIS_MEMORY_SSA) ||
       passmgr_is_analysis_valid(unsafe { view(*pm_ptr) }, ANALYSIS_LOOP_INFO) {
        opt_free_minimal_thir(thir_ptr);
        return 425;
    }
    passmgr_ensure_analyses(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*obody) },
        mut_view(*arena),
        ANALYSIS_MASK_RANGE_INFO | ANALYSIS_MASK_EFFECT_INFO
    );

    // 4.6 Fact-driven pass scheduling & budget ceiling checks (REQ-OPT-065, REQ-OPT-373, REQ-OPT-374)
    let facts = passmgr_collect_body_facts(unsafe { view(*obody) });
    let budget_o0 = opt_budget_for_profile(OPT_PROFILE_DEBUG_O0, true);
    let budget_o1 = opt_budget_for_profile(OPT_PROFILE_BALANCED_O1, true);
    if passmgr_should_schedule_pass(PASS_SCCP, view(budget_o0), view(facts)) ||
       passmgr_should_schedule_pass(PASS_SROA, view(budget_o0), view(facts)) ||
       passmgr_should_schedule_pass(PASS_DCE, view(budget_o0), view(facts)) {
        opt_free_minimal_thir(thir_ptr);
        return 426;
    }
    if !passmgr_should_schedule_pass(PASS_SROA, view(budget_o1), view(facts)) ||
       !passmgr_should_schedule_pass(PASS_SCCP, view(budget_o2), view(facts)) {
        opt_free_minimal_thir(thir_ptr);
        return 427;
    }
    let mut tiny_budget = budget_o2;
    tiny_budget.max_ir_insts_per_fn = 2u32;
    if passmgr_should_schedule_pass(PASS_SCCP, view(tiny_budget), view(facts)) {
        opt_free_minimal_thir(thir_ptr);
        return 428;
    }

    // 4.7 Two-stage candidate legality & proof verifier (REQ-OPT-060..064, REQ-OPT-402, REQ-OPT-405)
    let cur_rev = unsafe { (*pm_ptr).ir_revision };
    let cand_proven = CandidateRewrite {
        pass_id: PASS_SCCP,
        required_prop: PROP_NO_OVERFLOW,
        proof_certainty: CERTAINTY_PROVEN,
        proof_source_analysis: ANALYSIS_RANGE_INFO,
        proof_revision: cur_rev,
        target_effect_flags: EFFECT_PURE,
        src_view_kind: MIR_VIEW_READ,
        dst_view_kind: MIR_VIEW_READ,
        is_removing_inst: false,
        cost_delta: -5i32,
    };
    if passmgr_evaluate_candidate(unsafe { view(*pm_ptr) }, view(cand_proven)) != CONTRACT_OK {
        opt_free_minimal_thir(thir_ptr);
        return 429;
    }

    // Possible certainty MUST fail closed even when cost_delta is hugely profitable (-100)
    let mut cand_possible = cand_proven;
    cand_possible.proof_certainty = CERTAINTY_POSSIBLE;
    cand_possible.cost_delta = -100i32;
    if passmgr_evaluate_candidate(unsafe { view(*pm_ptr) }, view(cand_possible)) != CONTRACT_ERR_NON_PROVEN_CERTAINTY {
        opt_free_minimal_thir(thir_ptr);
        return 430;
    }

    // Unknown certainty MUST fail closed
    let mut cand_unknown = cand_proven;
    cand_unknown.proof_certainty = CERTAINTY_UNKNOWN;
    if passmgr_evaluate_candidate(unsafe { view(*pm_ptr) }, view(cand_unknown)) != CONTRACT_ERR_NON_PROVEN_CERTAINTY {
        opt_free_minimal_thir(thir_ptr);
        return 431;
    }

    // Stale proof revision MUST fail closed
    let mut cand_stale = cand_proven;
    cand_stale.proof_revision = cur_rev + 99u32;
    if passmgr_evaluate_candidate(unsafe { view(*pm_ptr) }, view(cand_stale)) != CONTRACT_ERR_STALE_PROOF_REVISION {
        opt_free_minimal_thir(thir_ptr);
        return 432;
    }

    // Capability promotion view<T> -> mut_view<T> MUST be rejected (REQ-OPT-064)
    let mut cand_cap = cand_proven;
    cand_cap.src_view_kind = MIR_VIEW_READ;
    cand_cap.dst_view_kind = MIR_VIEW_MUT;
    if passmgr_evaluate_candidate(unsafe { view(*pm_ptr) }, view(cand_cap)) != CONTRACT_ERR_CAPABILITY_PROMOTION {
        opt_free_minimal_thir(thir_ptr);
        return 433;
    }

    // Removing volatile, I/O, or MayPanic instruction MUST be rejected (REQ-OPT-061..063)
    let mut cand_rm_vol = cand_proven;
    cand_rm_vol.is_removing_inst = true;
    cand_rm_vol.target_effect_flags = EFFECT_VOLATILE;
    if passmgr_evaluate_candidate(unsafe { view(*pm_ptr) }, view(cand_rm_vol)) != CONTRACT_ERR_OBSERVABLE_EFFECT_LOSS {
        opt_free_minimal_thir(thir_ptr);
        return 434;
    }

    // Unprofitable candidate rejected at Stage 2 after passing Stage 1
    let mut cand_unprof = cand_proven;
    cand_unprof.cost_delta = 10i32;
    if passmgr_evaluate_candidate(unsafe { view(*pm_ptr) }, view(cand_unprof)) != CONTRACT_ERR_COST_UNPROFITABLE {
        opt_free_minimal_thir(thir_ptr);
        return 435;
    }

    // Missing required analysis rejected at Stage 1
    passmgr_invalidate_analyses(unsafe { mut_view(*pm_ptr) }, ANALYSIS_MASK_RANGE_INFO);
    if passmgr_evaluate_candidate(unsafe { view(*pm_ptr) }, view(cand_proven)) != CONTRACT_ERR_MISSING_ANALYSIS {
        opt_free_minimal_thir(thir_ptr);
        return 436;
    }
    passmgr_ensure_analyses(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*obody) },
        mut_view(*arena),
        ANALYSIS_MASK_RANGE_INFO | ANALYSIS_MASK_EFFECT_INFO
    );

    // 4.8 Postcondition verification failure & automatic rollback (AXS-OPT-034, REQ-OPT-404)
    let st_dom = passmgr_inject_fault_and_verify(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*obody) },
        PASS_SCCP,
        FAULT_CORRUPT_IDOM,
        mut_view(*arena),
        mut_view(*sink)
    );
    if st_dom != CONTRACT_ERR_POSTCOND_CFG_DOM ||
       passmgr_get_pass_rollback_count(unsafe { view(*pm_ptr) }, PASS_SCCP) != 1u32 ||
       !optir_verify_contract(unsafe { view(*obody) }) {
        opt_free_minimal_thir(thir_ptr);
        return 437;
    }

    // Mark instruction 0 in bb0 as volatile store, record baseline effects, then inject FAULT_DROP_VOLATILE_INST
    let bb0_p = unsafe { opt_block_at((*obody).blocks, 0) };
    let inst0_p = unsafe { opt_inst_at((*bb0_p).insts, 0) };
    let saved_opc = unsafe { (*inst0_p).opcode };
    unsafe { (*inst0_p).opcode = OPT_INST_VOLATILE_STORE; }
    unsafe { (*pm_ptr).has_baseline_effects = false; }
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*obody) }, mut_view(*arena));
    let st_vol = passmgr_inject_fault_and_verify(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*obody) },
        PASS_DCE,
        FAULT_DROP_VOLATILE_INST,
        mut_view(*arena),
        mut_view(*sink)
    );
    if st_vol != CONTRACT_ERR_POSTCOND_EFFECTS ||
       passmgr_get_pass_rollback_count(unsafe { view(*pm_ptr) }, PASS_DCE) != 1u32 ||
       (unsafe { (*inst0_p).opcode }) != OPT_INST_VOLATILE_STORE {
        opt_free_minimal_thir(thir_ptr);
        return 438;
    }

    // Mark instruction 0 in bb0 as atomic op, verify EFFECT_ATOMIC inference, and verify FAULT_DROP_ATOMIC_INST rollback
    unsafe { (*inst0_p).opcode = OPT_INST_ATOMIC; }
    unsafe { (*pm_ptr).has_baseline_effects = false; }
    let inst0_ato_eff = effect_infer_inst(unsafe { view(*obody) }, unsafe { view(*inst0_p) }, 64u32);
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*obody) }, mut_view(*arena));
    let st_ato = passmgr_inject_fault_and_verify(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*obody) },
        PASS_DCE,
        FAULT_DROP_ATOMIC_INST,
        mut_view(*arena),
        mut_view(*sink)
    );
    if (inst0_ato_eff & (EFFECT_ATOMIC | EFFECT_READS_MEM | EFFECT_WRITES_MEM)) != (EFFECT_ATOMIC | EFFECT_READS_MEM | EFFECT_WRITES_MEM) ||
       (unsafe { (*pm_ptr).baseline_effect_summary.atomic_count }) == 0u32 ||
       st_ato != CONTRACT_ERR_POSTCOND_EFFECTS ||
       passmgr_get_pass_rollback_count(unsafe { view(*pm_ptr) }, PASS_DCE) != 2u32 ||
       (unsafe { (*inst0_p).opcode }) != OPT_INST_ATOMIC {
        unsafe { (*inst0_p).opcode = saved_opc; }
        opt_free_minimal_thir(thir_ptr);
        return 456;
    }
    unsafe { (*inst0_p).opcode = saved_opc; }
    unsafe { (*pm_ptr).has_baseline_effects = false; }

    // Inject FAULT_PROMOTE_VIEW_TO_MUT on a shared view<T> local -> rejected & rolled back (REQ-OPT-064)
    let view_ty_ptr = arena_alloc_raw(mut_view(*arena), size_of<AxType>(), align_of<AxType>()) as *mut AxType;
    let slot16 = (((unsafe { (*thir_ptr).interner.types }) as usize) + 16 * size_of<*mut AxType>()) as *mut *mut AxType;
    let inst6_p = unsafe { opt_inst_at((*bb0_p).insts, 6) }; // _7 = const 50 (OPT_INST_STORE)
    let saved_ty7 = unsafe { *opt_typeid_at((*obody).local_tys, 7) };
    let saved_len = unsafe { (*thir_ptr).interner.len };
    unsafe {
        ax_type_reset(mut_view(*view_ty_ptr), TY_VIEW);
        *slot16 = view_ty_ptr;
        (*thir_ptr).interner.len = 17;
        *opt_typeid_at((*obody).local_tys, 7) = TypeId { v: 17u32 };
    }
    let st_cap = passmgr_inject_fault_and_verify(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*obody) },
        PASS_INST_COMBINE,
        FAULT_PROMOTE_VIEW_TO_MUT,
        mut_view(*arena),
        mut_view(*sink)
    );
    let restored_vk = unsafe { (*inst6_p).place.view_kind };
    unsafe {
        *opt_typeid_at((*obody).local_tys, 7) = saved_ty7;
        (*thir_ptr).interner.len = saved_len;
    }
    if st_cap != CONTRACT_ERR_CAPABILITY_PROMOTION ||
       passmgr_get_pass_rollback_count(unsafe { view(*pm_ptr) }, PASS_INST_COMBINE) != 1u32 ||
       restored_vk == MIR_VIEW_MUT {
        opt_free_minimal_thir(thir_ptr);
        return 454;
    }

    // Verify trap-free bit-width-masked wrapping folding in pm_exec_sccp on OPT_INST_WRAPPING_BINOP
    let inst5_p = unsafe { opt_inst_at((*bb0_p).insts, 5) }; // _5 = copy (_4.0) [10] + copy (_4.1) [20]
    let saved_i5_opc = unsafe { (*inst5_p).opcode };
    let saved_i5_sub = unsafe { (*inst5_p).sub_op };
    unsafe {
        (*inst5_p).opcode = OPT_INST_WRAPPING_BINOP;
        (*inst5_p).sub_op = MIR_BINOP_WRAPPING_ADD;
    }
    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget_o1, mut_view(*arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*obody) }, mut_view(*arena));
    let sccp_changed = passmgr_run_pass(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*obody) }, PASS_SCCP, mut_view(*arena), mut_view(*sink));
    if !sccp_changed || (unsafe { (*inst5_p).opcode }) != OPT_INST_CONST {
        unsafe {
            (*inst5_p).opcode = saved_i5_opc;
            (*inst5_p).sub_op = saved_i5_sub;
        }
        opt_free_minimal_thir(thir_ptr);
        return 455;
    }

    // 4.9 Full PassManager pipeline execution across -O0, -O1, and -O2 with --verify-each
    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget_o0, mut_view(*arena));
    if !passmgr_run_pipeline(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*obody) }, mut_view(*arena), mut_view(*sink)) ||
       (unsafe { (*pm_ptr).fixedpoint_rounds_executed }) != 0u32 {
        opt_free_minimal_thir(thir_ptr);
        return 439;
    }

    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget_o1, mut_view(*arena));
    if !passmgr_run_pipeline(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*obody) }, mut_view(*arena), mut_view(*sink)) ||
       (unsafe { (*pm_ptr).fixedpoint_rounds_executed }) == 0u32 ||
       (unsafe { (*pm_ptr).fixedpoint_rounds_executed }) > budget_o1.max_fixedpoint_rounds {
        opt_free_minimal_thir(thir_ptr);
        return 440;
    }

    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget_o2, mut_view(*arena));
    if !passmgr_run_pipeline(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*obody) }, mut_view(*arena), mut_view(*sink)) ||
       (unsafe { (*pm_ptr).verify_fail_count }) != 0u32 {
        opt_free_minimal_thir(thir_ptr);
        return 441;
    }

    opt_free_minimal_thir(thir_ptr);
    arena_reset(mut_view(*arena));
    0
}

fn test_t602_qa_regressions(arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> i32 {
    // 5.1 SPEC-70 AXS-OPT-031 TransformationContract required/invalidated analysis masks
    if EFFECT_MASK_NON_STORE_OBSERVABLE != 1020u16 {
        return 501;
    }
    let c_sccp = passmgr_contract_for_pass(PASS_SCCP);
    let c_ic = passmgr_contract_for_pass(PASS_INST_COMBINE);
    let c_sroa = passmgr_contract_for_pass(PASS_SROA);
    let c_dce = passmgr_contract_for_pass(PASS_DCE);
    let c_cfg = passmgr_contract_for_pass(PASS_CFG_SIMPLIFY);
    if c_sccp.required_analyses != (ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA | ANALYSIS_MASK_EFFECT_INFO | ANALYSIS_MASK_RANGE_INFO) {
        return 502;
    }
    if c_ic.required_analyses != (ANALYSIS_MASK_CFG | ANALYSIS_MASK_SSA | ANALYSIS_MASK_EFFECT_INFO | ANALYSIS_MASK_RANGE_INFO) {
        return 503;
    }
    if c_sroa.invalidated_analyses != (ANALYSIS_MASK_SSA | ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_ALIAS_INFO | ANALYSIS_MASK_RANGE_INFO) {
        return 504;
    }
    if c_dce.required_analyses != (ANALYSIS_MASK_CFG | ANALYSIS_MASK_SSA | ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_EFFECT_INFO | ANALYSIS_MASK_ESCAPE_INFO) {
        return 505;
    }
    if c_cfg.required_analyses != (ANALYSIS_MASK_CFG | ANALYSIS_MASK_SSA | ANALYSIS_MASK_EFFECT_INFO) {
        return 506;
    }

    // 5.2 EffectCallGraph > 64 nodes mutual recursion & recursive 0-caller incremental summary preservation (REQ-OPT-394)
    let cg80 = arena_alloc_raw(mut_view(*arena), size_of<EffectCallGraph>(), align_of<EffectCallGraph>()) as *mut EffectCallGraph;
    effect_call_graph_init(unsafe { mut_view(*cg80) }, mut_view(*arena), 80, 32);
    let mut k: usize = 0;
    while k < 80 {
        let loc_eff: u16 = if k == 71 { EFFECT_IO } else { EFFECT_PURE };
        let added = effect_call_graph_add_node(unsafe { mut_view(*cg80) }, SymbolId { v: (100 + k) as u32 }, loc_eff, false);
        if added != (k as u32) {
            return 507;
        }
        k = k + 1;
    }
    // 0 -> 70 <-> 71 (mutual recursion above node index 64), 1 -> 72 -> 72 (self recursion above 64), 75 pure
    effect_call_graph_add_edge(unsafe { mut_view(*cg80) }, 0u32, 70u32);
    effect_call_graph_add_edge(unsafe { mut_view(*cg80) }, 70u32, 71u32);
    effect_call_graph_add_edge(unsafe { mut_view(*cg80) }, 71u32, 70u32);
    effect_call_graph_add_edge(unsafe { mut_view(*cg80) }, 1u32, 72u32);
    effect_call_graph_add_edge(unsafe { mut_view(*cg80) }, 72u32, 72u32);
    let _ = effect_call_graph_propagate(unsafe { mut_view(*cg80) });
    if !(unsafe { *opt_bool_at((*cg80).is_recursive, 70) }) ||
       !(unsafe { *opt_bool_at((*cg80).is_recursive, 71) }) ||
       !(unsafe { *opt_bool_at((*cg80).is_recursive, 72) }) ||
       (unsafe { *opt_bool_at((*cg80).is_recursive, 0) }) {
        return 508;
    }
    let s0_80 = effect_call_graph_node_summary(unsafe { view(*cg80) }, 0u32);
    let s70_80 = effect_call_graph_node_summary(unsafe { view(*cg80) }, 70u32);
    let s1_80 = effect_call_graph_node_summary(unsafe { view(*cg80) }, 1u32);
    let s75_80 = effect_call_graph_node_summary(unsafe { view(*cg80) }, 75u32);
    if (s70_80.flags & (EFFECT_IO | EFFECT_NONTERM)) != (EFFECT_IO | EFFECT_NONTERM) ||
       (s0_80.flags & (EFFECT_IO | EFFECT_NONTERM)) != (EFFECT_IO | EFFECT_NONTERM) ||
       (s1_80.flags & EFFECT_NONTERM) == 0u16 ||
       s75_80.flags != EFFECT_PURE {
        return 509;
    }
    // Summary-preserving edits on recursive nodes (both identical and SCC-absorbed) MUST report 0 caller re-evaluations
    if effect_call_graph_update_node_local(unsafe { mut_view(*cg80) }, 70u32, EFFECT_PURE, false) != 0u32 {
        return 510;
    }
    if effect_call_graph_update_node_local(unsafe { mut_view(*cg80) }, 70u32, EFFECT_IO, false) != 0u32 {
        return 511;
    }
    if effect_call_graph_update_node_local(unsafe { mut_view(*cg80) }, 72u32, EFFECT_NONTERM, false) != 0u32 {
        return 512;
    }
    // Summary-changing edit on node 71 adding EFFECT_ATOMIC re-evaluates only {70, 71, 0} (3 nodes) even at n=80
    let reeval_80 = effect_call_graph_update_node_local(unsafe { mut_view(*cg80) }, 71u32, EFFECT_IO | EFFECT_ATOMIC, false);
    let s0_80_after = effect_call_graph_node_summary(unsafe { view(*cg80) }, 0u32);
    let s1_80_after = effect_call_graph_node_summary(unsafe { view(*cg80) }, 1u32);
    let s75_80_after = effect_call_graph_node_summary(unsafe { view(*cg80) }, 75u32);
    if reeval_80 != 3u32 ||
       (s0_80_after.flags & EFFECT_ATOMIC) == 0u16 ||
       (s1_80_after.flags & EFFECT_ATOMIC) != 0u16 ||
       s75_80_after.flags != EFFECT_PURE {
        return 513;
    }

    // 5.3 Loop backedge non-termination across OPT_TERM_BRANCH (blob 20) and OPT_TERM_SWITCH_INT (blob 21)
    let thir_ptr = arena_alloc_raw(mut_view(*arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    opt_init_minimal_thir(thir_ptr, mut_view(*arena));

    let in20 = unit_mir_blob(mut_view(*arena), 20);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m20 = verify_parse_mir(in20, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m20 as usize) == 0 {
        opt_free_minimal_thir(thir_ptr);
        return 514;
    }
    let o20 = optir_build_from_mir(unsafe { view(*m20) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o20 as usize) == 0 || sink.errors != 0 {
        opt_free_minimal_thir(thir_ptr);
        return 515;
    }
    let bb1_20 = unsafe { opt_block_at((*o20).blocks, 1) };
    let eff20 = effect_infer_body(unsafe { mut_view(*o20) }, mut_view(*arena), 64u32);
    if (unsafe { (*bb1_20).term.kind }) != OPT_TERM_BRANCH ||
       (eff20.flags & EFFECT_NONTERM) == 0u16 ||
       effect_is_pure(eff20.flags) ||
       eff20.pure_certainty != CERTAINTY_UNKNOWN ||
       effect_can_dce(eff20.flags) {
        opt_free_minimal_thir(thir_ptr);
        return 516;
    }

    let in21 = unit_mir_blob(mut_view(*arena), 21);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m21 = verify_parse_mir(in21, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m21 as usize) == 0 {
        opt_free_minimal_thir(thir_ptr);
        return 517;
    }
    let o21 = optir_build_from_mir(unsafe { view(*m21) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o21 as usize) == 0 || sink.errors != 0 {
        opt_free_minimal_thir(thir_ptr);
        return 518;
    }
    let bb1_21 = unsafe { opt_block_at((*o21).blocks, 1) };
    let eff21 = effect_infer_body(unsafe { mut_view(*o21) }, mut_view(*arena), 64u32);
    if (unsafe { (*bb1_21).term.kind }) != OPT_TERM_SWITCH_INT ||
       (eff21.flags & EFFECT_NONTERM) == 0u16 ||
       effect_is_pure(eff21.flags) ||
       eff21.pure_certainty != CERTAINTY_UNKNOWN ||
       effect_can_dce(eff21.flags) {
        opt_free_minimal_thir(thir_ptr);
        return 519;
    }

    // 5.4 GVN/CSE MIR local clobber safety (blob 19): clobbered _5 must NOT be reused, unclobbered _7 MUST be reused
    let in19 = unit_mir_blob(mut_view(*arena), 19);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m19 = verify_parse_mir(in19, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m19 as usize) == 0 {
        opt_free_minimal_thir(thir_ptr);
        return 520;
    }
    let o19 = optir_build_from_mir(unsafe { view(*m19) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o19 as usize) == 0 || sink.errors != 0 {
        opt_free_minimal_thir(thir_ptr);
        return 521;
    }
    let pm_ptr = arena_alloc_raw(mut_view(*arena), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
    let budget_o2 = opt_budget_for_profile(OPT_PROFILE_SPEED_O2, true);
    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget_o2, mut_view(*arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*o19) }, mut_view(*arena));
    let gvn_ch = passmgr_run_pass(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*o19) }, PASS_GVN_CSE, mut_view(*arena), mut_view(*sink));
    let bb3_19 = unsafe { opt_block_at((*o19).blocks, 3) };
    let i2_19 = unsafe { opt_inst_at((*bb3_19).insts, 2) }; // _6 = copy _1 | copy _2 (after _5 = 999)
    let i4_19 = unsafe { opt_inst_at((*bb3_19).insts, 4) }; // _8 = copy _1 ^ copy _2 (unclobbered _7)
    if !gvn_ch ||
       (unsafe { (*i2_19).opcode }) != OPT_INST_BINOP ||
       (unsafe { (*i2_19).orig_stmt.rvalue.kind }) != MIR_RVALUE_BINARY_OP ||
       (unsafe { (*i4_19).opcode }) != OPT_INST_COPY ||
       (unsafe { (*i4_19).orig_stmt.rvalue.use_op.place.local.v }) != 7u32 {
        opt_free_minimal_thir(thir_ptr);
        return 522;
    }
    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget_o2, mut_view(*arena));
    if !passmgr_run_pipeline(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*o19) }, mut_view(*arena), mut_view(*sink)) ||
       (unsafe { (*i2_19).opcode }) != OPT_INST_BINOP ||
       (unsafe { (*pm_ptr).verify_fail_count }) != 0u32 {
        opt_free_minimal_thir(thir_ptr);
        return 523;
    }

    // 5.5 SCCP TY_BOOL MIR_CONST_BOOL + operand clearing + DCE dead value & DeadStore elimination (blob 22)
    let in22 = unit_mir_blob(mut_view(*arena), 22);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m22 = verify_parse_mir(in22, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m22 as usize) == 0 {
        opt_free_minimal_thir(thir_ptr);
        return 524;
    }
    let o22 = optir_build_from_mir(unsafe { view(*m22) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o22 as usize) == 0 || sink.errors != 0 {
        opt_free_minimal_thir(thir_ptr);
        return 525;
    }
    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget_o2, mut_view(*arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*o22) }, mut_view(*arena));
    let bb0_22 = unsafe { opt_block_at((*o22).blocks, 0) };
    let i0_22 = unsafe { opt_inst_at((*bb0_22).insts, 0) }; // _1 = const true
    let i1_22 = unsafe { opt_inst_at((*bb0_22).insts, 1) }; // _2 = const false
    let i2_22 = unsafe { opt_inst_at((*bb0_22).insts, 2) }; // _3 = copy _1 & copy _2
    let i3_22 = unsafe { opt_inst_at((*bb0_22).insts, 3) }; // _4 = wrapping_add(10, 32)
    let i4_22 = unsafe { opt_inst_at((*bb0_22).insts, 4) }; // _5 = const 100 (DeadStore)
    let i6_22 = unsafe { opt_inst_at((*bb0_22).insts, 6) }; // _6 = &_5 (dead value)
    let v_i0 = OptValueId { v: unsafe { (*i0_22).result.v } };
    let v_i1 = OptValueId { v: unsafe { (*i1_22).result.v } };

    if !passmgr_run_pass(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*o22) }, PASS_SCCP, mut_view(*arena), mut_view(*sink)) {
        opt_free_minimal_thir(thir_ptr);
        return 526;
    }
    if (unsafe { (*i2_22).opcode }) != OPT_INST_CONST ||
       (unsafe { (*i2_22).lhs.v }) != OPT_VALUE_NONE ||
       (unsafe { (*i2_22).rhs.v }) != OPT_VALUE_NONE ||
       (unsafe { (*i2_22).orig_stmt.rvalue.use_op.constant.kind }) != MIR_CONST_BOOL ||
       (unsafe { (*i2_22).orig_stmt.rvalue.use_op.constant.val }) != 0u64 ||
       pm_count_value_uses(unsafe { view(*o22) }, v_i0) != 0u32 ||
       pm_count_value_uses(unsafe { view(*o22) }, v_i1) != 0u32 {
        opt_free_minimal_thir(thir_ptr);
        return 527;
    }

    if !passmgr_run_pass(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*o22) }, PASS_DCE, mut_view(*arena), mut_view(*sink)) {
        opt_free_minimal_thir(thir_ptr);
        return 528;
    }
    if (unsafe { (*i4_22).opcode }) != OPT_INST_NOP ||
       (unsafe { (*i4_22).orig_stmt.kind }) == MIR_STMT_STORAGE_LIVE ||
       (unsafe { (*i0_22).opcode }) != OPT_INST_NOP ||
       (unsafe { (*i1_22).opcode }) != OPT_INST_NOP ||
       (unsafe { (*i3_22).opcode }) != OPT_INST_NOP ||
       (unsafe { (*i6_22).opcode }) != OPT_INST_NOP {
        opt_free_minimal_thir(thir_ptr);
        return 529;
    }
    let rec22 = arena_alloc_raw(mut_view(*arena), size_of<MirBody>(), align_of<MirBody>()) as *mut MirBody;
    if !optir_reconstruct_mir(unsafe { view(*o22) }, unsafe { mut_view(*rec22) }, mut_view(*arena)) {
        opt_free_minimal_thir(thir_ptr);
        return 530;
    }
    let mbb0_22 = unsafe { mir_bb_at((*rec22).bbs, 0) };
    verify_mir(unsafe { view(*rec22) }, thir_ptr as *const Thir, mut_view(*sink), 0 as *const HirItem);
    if (unsafe { (*mbb0_22).stmt_count }) != 2 || sink.errors != 0 {
        opt_free_minimal_thir(thir_ptr);
        return 531;
    }

    // 5.6 Stale RangeInfo invalidation guard (blob 23): invalidated RangeInfo must NOT be read
    let in23 = unit_mir_blob(mut_view(*arena), 23);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m23 = verify_parse_mir(in23, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m23 as usize) == 0 {
        opt_free_minimal_thir(thir_ptr);
        return 532;
    }
    let o23 = optir_build_from_mir(unsafe { view(*m23) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o23 as usize) == 0 || sink.errors != 0 {
        opt_free_minimal_thir(thir_ptr);
        return 533;
    }
    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget_o2, mut_view(*arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*o23) }, mut_view(*arena));
    let bb0_23 = unsafe { opt_block_at((*o23).blocks, 0) };
    let i0_23 = unsafe { opt_inst_at((*bb0_23).insts, 0) };
    let v_i0_23 = OptValueId { v: unsafe { (*i0_23).result.v } };
    let mut cv23: u64 = 0u64;
    if !pm_value_is_const_int(unsafe { view(*pm_ptr) }, unsafe { view(*o23) }, v_i0_23, mut_view(cv23)) || cv23 != 1u64 {
        opt_free_minimal_thir(thir_ptr);
        return 534;
    }
    // Invalidate RangeInfo while leaving (*o23).ranges non-null in memory; queries & CFG_SIMPLIFY must ignore stale ranges
    passmgr_invalidate_analyses(unsafe { mut_view(*pm_ptr) }, ANALYSIS_MASK_RANGE_INFO);
    if ((unsafe { (*o23).ranges }) as usize) == 0 ||
       pm_value_is_const_int(unsafe { view(*pm_ptr) }, unsafe { view(*o23) }, v_i0_23, mut_view(cv23)) {
        opt_free_minimal_thir(thir_ptr);
        return 535;
    }
    if passmgr_run_pass(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*o23) }, PASS_CFG_SIMPLIFY, mut_view(*arena), mut_view(*sink)) ||
       (unsafe { (*bb0_23).term.kind }) != OPT_TERM_BRANCH {
        opt_free_minimal_thir(thir_ptr);
        return 536;
    }

    opt_free_minimal_thir(thir_ptr);
    arena_reset(mut_view(*arena));
    0
}

pub fn main() -> i32 {
    let mut perm_arena = arena_new();
    let out_ptr = arena_alloc_raw(mut_view(perm_arena), 32768, 1);
    let mut arena = arena_new();
    let _ = arena_alloc_raw(mut_view(arena), 16, 8);
    let sink_ptr = arena_alloc_raw(mut_view(perm_arena), size_of<DiagSink>(), align_of<DiagSink>()) as *mut DiagSink;
    unsafe { diag_sink_init(mut_view(*sink_ptr)); }

    let rc1 = test_const_fold_scalars(mut_view(arena));
    if rc1 != 0 {
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(arena));
        arena_destroy(mut_view(perm_arena));
        return rc1;
    }

    let rc2 = test_mir_passes(mut_view(arena), unsafe { mut_view(*sink_ptr) }, out_ptr);
    if rc2 != 0 {
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(arena));
        arena_destroy(mut_view(perm_arena));
        return rc2;
    }

    let rc3 = test_optir_ssa_memssa_certainty(mut_view(arena), unsafe { mut_view(*sink_ptr) }, out_ptr);
    if rc3 != 0 {
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(arena));
        arena_destroy(mut_view(perm_arena));
        return rc3;
    }

    let rc4 = test_passmgr_effects_and_contracts(mut_view(arena), unsafe { mut_view(*sink_ptr) });
    if rc4 != 0 {
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(arena));
        arena_destroy(mut_view(perm_arena));
        return rc4;
    }

    let rc5 = test_t602_qa_regressions(mut_view(arena), unsafe { mut_view(*sink_ptr) });
    if rc5 != 0 {
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(arena));
        arena_destroy(mut_view(perm_arena));
        return rc5;
    }

    unsafe { diag_sink_free(mut_view(*sink_ptr)); }
    arena_destroy(mut_view(arena));
    arena_destroy(mut_view(perm_arena));
    print("OK opt unit (const_fold + dce + cfg_simp + mir diff)\n");
    0
}

