@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

@UNIT_MIR_FN@

fn unit_mir_blob(arena: mut_view<Arena>, idx: usize) -> StrView {
    let s: str = unit_mir_raw(idx);
    let raw_sv: StrView = unsafe { *(address_of(s) as *const StrView) };
    let bytes: view<[u8]> = unsafe { *(address_of(s) as *const view<[u8]>) };
    let n = raw_sv.len;
    let dst = arena_alloc_raw(mut_view(*arena), n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe {
            *(dst + i) = bytes[i];
        }
        i = i + 1;
    }
    unsafe {
        *(dst + n) = 0u8;
    }
    StrView { ptr: dst as *const u8, len: n }
}

fn str_eq_buf(buf: view<DiagBuffer>, exp: view<StrView>) -> bool {
    if buf.len != exp.len {
        return false;
    }
    let mut i: usize = 0;
    while i < exp.len {
        let a = unsafe { *(buf.ptr + i) };
        let b = unsafe { *(exp.ptr + i) };
        if a != b {
            return false;
        }
        i = i + 1;
    }
    true
}

fn init_const_op(op: mut_view<MirOperand>, ty_v: u32, val: u64) {
    mir_operand_zero(mut_view(*op), MIR_OP_CONST);
    mir_const_reset_vals(mut_view(op.constant), MIR_CONST_INT, ty_v, val);
}

fn check_binop_ok(
    thir: *const Thir,
    op: u8,
    ty_v: u32,
    lhs_v: u64,
    rhs_v: u64,
    exp_val: u64,
    exp_ty_v: u32
) -> bool {
    let mut lhs = MirOperand {
        kind: MIR_OP_CONST,
        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        place: mir_local_place(0u32),
        constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
    };
    let mut rhs = MirOperand {
        kind: MIR_OP_CONST,
        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        place: mir_local_place(0u32),
        constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
    };
    let mut out = MirConst {
        ty: TypeId { v: 0u32 },
        kind: MIR_CONST_INT,
        val: 0u64,
        str_bytes: 0 as *const u8,
        str_len: 0,
        sym: SymbolId { v: 0u32 },
    };
    init_const_op(mut_view(lhs), ty_v, lhs_v);
    init_const_op(mut_view(rhs), ty_v, rhs_v);
    mir_const_reset_vals(mut_view(out), MIR_CONST_INT, 0u32, 0u64);
    let ok = do_const_fold_binop(thir, op, view(lhs), view(rhs), mut_view(out));
    if !ok {
        return false;
    }
    out.kind == MIR_CONST_INT && out.val == exp_val && out.ty.v == exp_ty_v
}

fn check_binop_ovf(thir: *const Thir, op: u8, ty_v: u32, lhs_v: u64, rhs_v: u64) -> bool {
    let mut lhs = MirOperand {
