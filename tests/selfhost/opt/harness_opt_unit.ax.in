    let mut rhs = MirOperand {
        kind: MIR_OP_CONST,
        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        place: mir_local_place(0u32),
        constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
    };
    let mut out = MirConst {
        ty: TypeId { v: 0u32 },
        kind: MIR_CONST_INT,
        val: 0u64,
        str_bytes: 0 as *const u8,
        str_len: 0,
        sym: SymbolId { v: 0u32 },
    };
    init_const_op(mut_view(lhs), ty_v, lhs_v);
    init_const_op(mut_view(rhs), ty_v, rhs_v);
    mir_const_reset_vals(mut_view(out), MIR_CONST_INT, 0u32, 0u64);
    !do_const_fold_binop(thir, op, view(lhs), view(rhs), mut_view(out))
}

