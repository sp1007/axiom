}

fn check_binop_mismatch(thir: *const Thir, op: u8, lhs_ty_v: u32, rhs_ty_v: u32, lhs_v: u64, rhs_v: u64) -> bool {
    let mut lhs = MirOperand {
        kind: MIR_OP_CONST,
        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        place: mir_local_place(0u32),
        constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
    };
    let mut rhs = MirOperand {
        kind: MIR_OP_CONST,
        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        place: mir_local_place(0u32),
        constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
    };
    let mut out = MirConst {
        ty: TypeId { v: 0u32 },
        kind: MIR_CONST_INT,
        val: 0u64,
        str_bytes: 0 as *const u8,
        str_len: 0,
        sym: SymbolId { v: 0u32 },
    };
    init_const_op(mut_view(lhs), lhs_ty_v, lhs_v);
    init_const_op(mut_view(rhs), rhs_ty_v, rhs_v);
    mir_const_reset_vals(mut_view(out), MIR_CONST_INT, 0u32, 0u64);
    !do_const_fold_binop(thir, op, view(lhs), view(rhs), mut_view(out))
}

// 1. Exhaustive constant folding unit tests across all scalar types (`i8..i64`, `isize`, `u8..u64`, `usize`, `char`, `bool`).
fn test_const_fold_scalars(arena: mut_view<Arena>) -> i32 {
    let thir_ptr = arena_alloc_raw(mut_view(*arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    opt_init_minimal_thir(thir_ptr, mut_view(*arena));
    let t_ptr = thir_ptr as *const Thir;

    // --- i8 (type#6) ---
    if !check_binop_ok(t_ptr, MIR_BINOP_ADD, 6u32, 100u64, 27u64, 127u64, 6u32) { return 101; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_ADD, 6u32, 100u64, 28u64) { return 102; }
    if !check_binop_ok(t_ptr, MIR_BINOP_SUB, 6u32, 0x9Cu64, 28u64, 0x80u64, 6u32) { return 103; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_SUB, 6u32, 0x9Cu64, 29u64) { return 104; }
    if !check_binop_ok(t_ptr, MIR_BINOP_MUL, 6u32, 16u64, 7u64, 112u64, 6u32) { return 105; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_MUL, 6u32, 16u64, 8u64) { return 106; }
    if !check_binop_ok(t_ptr, MIR_BINOP_MUL, 6u32, 0xF0u64, 8u64, 0x80u64, 6u32) { return 107; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_MUL, 6u32, 0x80u64, 0xFFu64) { return 108; }
    if !check_binop_ok(t_ptr, MIR_BINOP_DIV, 6u32, 0x9Cu64, 3u64, 0xDFu64, 6u32) { return 109; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_DIV, 6u32, 0x80u64, 0xFFu64) { return 110; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_DIV, 6u32, 10u64, 0u64) { return 111; }
    if !check_binop_ok(t_ptr, MIR_BINOP_REM, 6u32, 0x9Cu64, 3u64, 0xFFu64, 6u32) { return 112; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_REM, 6u32, 0x80u64, 0xFFu64) { return 113; }
    if !check_binop_ok(t_ptr, MIR_BINOP_SHL, 6u32, 1u64, 7u64, 0x80u64, 6u32) { return 114; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_SHL, 6u32, 1u64, 8u64) { return 115; }
    if !check_binop_ok(t_ptr, MIR_BINOP_SHR, 6u32, 0xF0u64, 2u64, 0xFCu64, 6u32) { return 116; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_SHR, 6u32, 1u64, 8u64) { return 117; }
    if !check_binop_ok(t_ptr, MIR_BINOP_LT, 6u32, 0xFBu64, 2u64, 1u64, 4u32) { return 118; }
    if !check_binop_ok(t_ptr, MIR_BINOP_GT, 6u32, 0xFBu64, 2u64, 0u64, 4u32) { return 119; }
    if !check_unop_ok(t_ptr, MIR_UNOP_NEG, 6u32, 42u64, 0xD6u64) { return 120; }
    if !check_unop_ovf(t_ptr, MIR_UNOP_NEG, 6u32, 0x80u64) { return 121; }
    // `MIR_UNOP_NOT` only folds `bool` (`type#4`); `MIR_UNOP_BITNOT` folds integer bitwise NOT.
    if !check_unop_ovf(t_ptr, MIR_UNOP_NOT, 6u32, 0x0Fu64) { return 122; }
    if !check_unop_ok(t_ptr, MIR_UNOP_BITNOT, 6u32, 0x0Fu64, 0xF0u64) { return 123; }
    // Mismatched operand types must be rejected (`lhs.constant.ty.v != rhs.constant.ty.v`).
    if !check_binop_mismatch(t_ptr, MIR_BINOP_ADD, 8u32, 13u32, 1u64, 1u64) { return 124; }
    if !check_binop_mismatch(t_ptr, MIR_BINOP_LT, 6u32, 8u32, 1u64, 2u64) { return 125; }

    // --- i16 (type#7) ---
    if !check_binop_ok(t_ptr, MIR_BINOP_ADD, 7u32, 32766u64, 1u64, 32767u64, 7u32) { return 130; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_ADD, 7u32, 32767u64, 1u64) { return 131; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_SUB, 7u32, 0x8000u64, 1u64) { return 132; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_DIV, 7u32, 0x8000u64, 0xFFFFu64) { return 133; }
    if !check_unop_ovf(t_ptr, MIR_UNOP_NEG, 7u32, 0x8000u64) { return 134; }
    if !check_unop_ok(t_ptr, MIR_UNOP_NEG, 7u32, 1u64, 0xFFFFu64) { return 135; }

    // --- i32 (type#8) ---
    if !check_binop_ok(t_ptr, MIR_BINOP_ADD, 8u32, 0x7FFFFFFEu64, 1u64, 0x7FFFFFFFu64, 8u32) { return 140; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_ADD, 8u32, 0x7FFFFFFFu64, 1u64) { return 141; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_SUB, 8u32, 0x80000000u64, 1u64) { return 142; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_DIV, 8u32, 0x80000000u64, 0xFFFFFFFFu64) { return 143; }
    if !check_binop_ok(t_ptr, MIR_BINOP_SHL, 8u32, 1u64, 31u64, 0x80000000u64, 8u32) { return 144; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_SHL, 8u32, 1u64, 32u64) { return 145; }
    if !check_binop_ok(t_ptr, MIR_BINOP_SHR, 8u32, 0x80000000u64, 31u64, 0xFFFFFFFFu64, 8u32) { return 146; }
    if !check_unop_ovf(t_ptr, MIR_UNOP_NEG, 8u32, 0x80000000u64) { return 147; }

    // --- i64 (type#9) & isize (type#10) ---
    if !check_binop_ok(t_ptr, MIR_BINOP_ADD, 9u32, 0x7FFFFFFFFFFFFFFEu64, 1u64, 0x7FFFFFFFFFFFFFFFu64, 9u32) { return 150; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_ADD, 9u32, 0x7FFFFFFFFFFFFFFFu64, 1u64) { return 151; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_SUB, 9u32, 0x8000000000000000u64, 1u64) { return 152; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_SUB, 9u32, 0u64, 0x8000000000000000u64) { return 153; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_MUL, 9u32, 0x8000000000000000u64, 0xFFFFFFFFFFFFFFFFu64) { return 154; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_MUL, 9u32, 0x4000000000000000u64, 2u64) { return 155; }
    if !check_binop_ok(t_ptr, MIR_BINOP_MUL, 9u32, 0x4000000000000000u64, 0xFFFFFFFFFFFFFFFEu64, 0x8000000000000000u64, 9u32) { return 156; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_DIV, 9u32, 0x8000000000000000u64, 0xFFFFFFFFFFFFFFFFu64) { return 157; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_REM, 9u32, 0x8000000000000000u64, 0xFFFFFFFFFFFFFFFFu64) { return 158; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_DIV, 10u32, 100u64, 0u64) { return 159; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_REM, 10u32, 100u64, 0u64) { return 160; }
    if !check_unop_ovf(t_ptr, MIR_UNOP_NEG, 9u32, 0x8000000000000000u64) { return 161; }
    if !check_unop_ok(t_ptr, MIR_UNOP_NEG, 10u32, 1u64, 0xFFFFFFFFFFFFFFFFu64) { return 162; }
    if !check_binop_ok(t_ptr, MIR_BINOP_SHL, 9u32, 1u64, 63u64, 0x8000000000000000u64, 9u32) { return 163; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_SHL, 9u32, 1u64, 64u64) { return 164; }
    if !check_binop_ok(t_ptr, MIR_BINOP_SHR, 9u32, 0x8000000000000000u64, 63u64, 0xFFFFFFFFFFFFFFFFu64, 9u32) { return 165; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_SHR, 9u32, 1u64, 64u64) { return 166; }
    if !check_binop_ok(t_ptr, MIR_BINOP_LT, 9u32, 0x8000000000000000u64, 0x7FFFFFFFFFFFFFFFu64, 1u64, 4u32) { return 167; }
    if !check_binop_ok(t_ptr, MIR_BINOP_LE, 9u32, 0x8000000000000000u64, 0x8000000000000000u64, 1u64, 4u32) { return 168; }
    if !check_binop_ok(t_ptr, MIR_BINOP_GE, 9u32, 0x7FFFFFFFFFFFFFFFu64, 0x8000000000000000u64, 1u64, 4u32) { return 169; }

    // --- u8 (type#11), u16 (type#12), u32 (type#13), u64 (type#14), usize (type#15), char (type#5), bool (type#4) ---
    if !check_binop_ok(t_ptr, MIR_BINOP_ADD, 11u32, 200u64, 55u64, 255u64, 11u32) { return 170; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_ADD, 11u32, 200u64, 56u64) { return 171; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_SUB, 11u32, 0u64, 1u64) { return 172; }
    if !check_binop_ok(t_ptr, MIR_BINOP_MUL, 11u32, 16u64, 15u64, 240u64, 11u32) { return 173; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_MUL, 11u32, 16u64, 16u64) { return 174; }
    if !check_binop_ok(t_ptr, MIR_BINOP_LT, 11u32, 250u64, 10u64, 0u64, 4u32) { return 175; }
    if !check_unop_ovf(t_ptr, MIR_UNOP_NEG, 11u32, 1u64) { return 176; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_ADD, 12u32, 65535u64, 1u64) { return 177; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_SUB, 12u32, 0u64, 1u64) { return 178; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_ADD, 13u32, 0xFFFFFFFFu64, 1u64) { return 179; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_MUL, 13u32, 0x10000u64, 0x10000u64) { return 180; }
    if !check_binop_ok(t_ptr, MIR_BINOP_MUL, 13u32, 0xFFFFu64, 0xFFFFu64, 0xFFFE0001u64, 13u32) { return 181; }
    if !check_binop_ok(t_ptr, MIR_BINOP_ADD, 5u32, 65u64, 1u64, 66u64, 5u32) { return 182; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_ADD, 14u32, 0xFFFFFFFFFFFFFFFFu64, 1u64) { return 183; }
    if !check_binop_ok(t_ptr, MIR_BINOP_ADD, 14u32, 0xFFFFFFFFFFFFFFFEu64, 1u64, 0xFFFFFFFFFFFFFFFFu64, 14u32) { return 184; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_SUB, 14u32, 0u64, 1u64) { return 185; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_MUL, 14u32, 0xFFFFFFFFFFFFFFFFu64, 2u64) { return 186; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_MUL, 14u32, 0x100000000u64, 0x100000000u64) { return 187; }
    if !check_binop_ok(t_ptr, MIR_BINOP_MUL, 15u32, 0xFFFFFFFFu64, 0xFFFFFFFFu64, 0xFFFFFFFE00000001u64, 15u32) { return 188; }
    if !check_binop_ok(t_ptr, MIR_BINOP_SHR, 14u32, 0xFFFFFFFF00000000u64, 32u64, 0xFFFFFFFFu64, 14u32) { return 189; }
    if !check_binop_ok(t_ptr, MIR_BINOP_GT, 14u32, 0xFFFFFFFFFFFFFFFFu64, 0u64, 1u64, 4u32) { return 190; }
    if !check_binop_ok(t_ptr, MIR_BINOP_BIT_AND, 14u32, 0xF0F0u64, 0x0FF0u64, 0x00F0u64, 14u32) { return 191; }
    if !check_binop_ok(t_ptr, MIR_BINOP_BIT_OR, 14u32, 0xF000u64, 0x00F0u64, 0xF0F0u64, 14u32) { return 192; }
    if !check_binop_ok(t_ptr, MIR_BINOP_BIT_XOR, 14u32, 0xFF00u64, 0x0FF0u64, 0xF0F0u64, 14u32) { return 193; }
    if !check_unop_ok(t_ptr, MIR_UNOP_NOT, 4u32, 0u64, 1u64) { return 194; }
    if !check_unop_ok(t_ptr, MIR_UNOP_NOT, 4u32, 1u64, 0u64) { return 195; }
    if !check_binop_ok(t_ptr, MIR_BINOP_EQ, 4u32, 1u64, 1u64, 1u64, 4u32) { return 196; }
    if !check_binop_ok(t_ptr, MIR_BINOP_NE, 4u32, 1u64, 0u64, 1u64, 4u32) { return 197; }

    // Also test null Thir fallback (`0 as *const Thir`)
    if !check_binop_ok(0 as *const Thir, MIR_BINOP_ADD, 8u32, 40u64, 2u64, 42u64, 8u32) { return 198; }
    if !check_unop_ok(0 as *const Thir, MIR_UNOP_NOT, 4u32, 0u64, 1u64) { return 199; }

    // QA Round 1 boundary cases:
    // - `MIR_UNOP_NEG` on `bool` (`type#4`) and `char` (`type#5`) must be rejected; `MIR_UNOP_NOT` on `u32`/`char` must be rejected
    if !check_unop_ovf(t_ptr, MIR_UNOP_NEG, 4u32, 1u64) { return 250; }
    if !check_unop_ovf(t_ptr, MIR_UNOP_NEG, 5u32, 1u64) { return 250; }
    if !check_unop_ovf(t_ptr, MIR_UNOP_NOT, 13u32, 0u64) { return 251; }
    if !check_unop_ovf(t_ptr, MIR_UNOP_NOT, 5u32, 0u64) { return 252; }
    // - `INT8_MIN / 1` and `INT8_MIN % 1` succeed (`0x80` and `0`), while `INT16_MIN % -1` (`0x8000 % 0xFFFF`) overflows
    if !check_binop_ok(t_ptr, MIR_BINOP_DIV, 6u32, 0x80u64, 1u64, 0x80u64, 6u32) { return 253; }
    if !check_binop_ok(t_ptr, MIR_BINOP_REM, 6u32, 0x80u64, 1u64, 0u64, 6u32) { return 254; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_REM, 7u32, 0x8000u64, 0xFFFFu64) { return 255; }
    // - Negative shift counts (two's complement `-1` = `0xFFFFFFFFFFFFFFFF`) on signed types must be rejected
    if !check_binop_ovf(t_ptr, MIR_BINOP_SHL, 8u32, 1u64, 0xFFFFFFFFFFFFFFFFu64) { return 256; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_SHR, 9u32, 1u64, 0xFFFFFFFFFFFFFFFFu64) { return 257; }
    // - Non-integer types (`unit` = `type#2`, `str` = `type#16`, unknown `type#99`) must be rejected
    if !check_binop_ovf(t_ptr, MIR_BINOP_ADD, 2u32, 0u64, 0u64) { return 258; }
    if !check_binop_ovf(t_ptr, MIR_BINOP_EQ, 16u32, 0u64, 0u64) { return 259; }
    if !check_unop_ovf(t_ptr, MIR_UNOP_BITNOT, 99u32, 0u64) { return 260; }

    opt_free_minimal_thir(thir_ptr);
    arena_reset(mut_view(*arena));
    0
}

fn check_mir_blob_pair(
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    out: mut_view<DiagBuffer>,
    in_idx: usize,
    exp_idx: usize,
    err_base: i32
) -> i32 {
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    out.len = 0;
    let in_sv = unit_mir_blob(mut_view(*arena), in_idx);
    let exp_sv = unit_mir_blob(mut_view(*arena), exp_idx);
    let ok = if in_idx == 0 {
        opt_mir_text(in_sv, mut_view(*out), mut_view(*sink), true)
    } else {
        opt_mir_text_in_arena(in_sv, mut_view(*out), mut_view(*sink), false, mut_view(*arena))
    };
    if !ok || sink.errors != 0 {
        return err_base;
    }
    if !str_eq_buf(view(*out), view(exp_sv)) {
        return err_base + 1;
    }
    arena_reset(mut_view(*arena));
    0
}

// 2. MIR optimization pass & differential MIR text tests.
fn test_mir_passes(arena: mut_view<Arena>, sink: mut_view<DiagSink>, out_ptr: *mut u8) -> i32 {
    let mut out = DiagBuffer { ptr: out_ptr, len: 0, cap: 32768 };

    // Case 0 (blobs 0 -> 1): Full `-O1` pipeline (const_fold + dce + cfg_simplify) with `verify_each = true`.
    let rc0 = check_mir_blob_pair(mut_view(*arena), mut_view(*sink), mut_view(out), 0, 1, 201);
    if rc0 != 0 { return rc0; }

    // Case 1 (blobs 2 -> 3): Overflowing constant ops & div-by-zero are NOT folded and NOT DCE'd.
    let rc1 = check_mir_blob_pair(mut_view(*arena), mut_view(*sink), mut_view(out), 2, 3, 203);
    if rc1 != 0 { return rc1; }

    // Case 2 (blobs 4 -> 5): Multi-iteration transitive DCE of unused pure chains and StorageLive/StorageDead.
    let rc2 = check_mir_blob_pair(mut_view(*arena), mut_view(*sink), mut_view(out), 4, 5, 205);
    if rc2 != 0 { return rc2; }

    // Case 3 (blob 6): Extended CFG simplification (`opt_cfg_eliminate_redundant_switches`,
    // `opt_cfg_merge_linear_blocks`, and `opt_run_with_merge`).
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let thir_ptr = arena_alloc_raw(mut_view(*arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    opt_init_minimal_thir(thir_ptr, mut_view(*arena));
    let in3 = unit_mir_blob(mut_view(*arena), 6);
    let body3 = verify_parse_mir(
        in3,
        unsafe { mut_view((*thir_ptr).interner) },
        mut_view(*arena)
    );
    if (body3 as usize) == 0 {
        opt_free_minimal_thir(thir_ptr);
        return 207;
    }
    opt_run_with_merge(
        unsafe { mut_view(*body3) },
        thir_ptr as *const Thir,
        mut_view(*arena),
        mut_view(*sink),
        true,
        0 as *const HirItem
    );
    if sink.errors != 0 {
        opt_free_minimal_thir(thir_ptr);
        return 208;
    }
    // After `opt_run_with_merge`, `bb0` should have merged `bb2` and `bb3` and terminate with `return`,
    // while `bb1`, `bb2`, and `bb3` should be `unreachable` with 0 statements.
    let bb0 = unsafe { mir_bb_at((*body3).bbs, 0) };
    let bb1 = unsafe { mir_bb_at((*body3).bbs, 1) };
    let bb2 = unsafe { mir_bb_at((*body3).bbs, 2) };
    let bb3 = unsafe { mir_bb_at((*body3).bbs, 3) };
    let bb0_tk = unsafe { (*bb0).terminator.kind };
    let bb1_tk = unsafe { (*bb1).terminator.kind };
    let bb2_tk = unsafe { (*bb2).terminator.kind };
    let bb3_tk = unsafe { (*bb3).terminator.kind };
    let bb1_sc = unsafe { (*bb1).stmt_count };
    let bb2_sc = unsafe { (*bb2).stmt_count };
    let bb3_sc = unsafe { (*bb3).stmt_count };
    opt_free_minimal_thir(thir_ptr);
    if bb0_tk != MIR_TERM_RETURN ||
       bb1_tk != MIR_TERM_UNREACHABLE || bb1_sc != 0 ||
       bb2_tk != MIR_TERM_UNREACHABLE || bb2_sc != 0 ||
       bb3_tk != MIR_TERM_UNREACHABLE || bb3_sc != 0 {
        return 209;
    }
    arena_reset(mut_view(*arena));

    // Case 4 (blobs 7 -> 8): Differential test on `tests/opt/qa_dce_run.ax` lowered MIR vs `axiom0 -O1`.
    let rc4 = check_mir_blob_pair(mut_view(*arena), mut_view(*sink), mut_view(out), 7, 8, 210);
    if rc4 != 0 { return rc4; }

    // Case 5 (blobs 9 -> 10): Regression test for Finding 2 — foldable `MIR_RVALUE_BINARY_OP`
    // followed immediately by overflowing or runtime `MIR_RVALUE_OVERFLOWS_BINARY_OP` must NOT
    // rewrite the subsequent overflow check to `const 0`.
    let rc5 = check_mir_blob_pair(mut_view(*arena), mut_view(*sink), mut_view(out), 9, 10, 212);
    if rc5 != 0 { return rc5; }

    // Case 6 (blobs 11 -> 12): Regression test for Finding 3 — (a) `MIR_RVALUE_UNARY_OP` is not
    // considered pure in `opt_rvalue_is_pure`, so unused `_1 = -const 128: type#6;` is preserved;
    // (b) `opt_dce` skips `MIR_TERM_UNREACHABLE` blocks during use counting, so a use in an
    // already-unreachable block does not keep dead `_2 = const 99: type#8;` in `bb0` alive.
    let rc6 = check_mir_blob_pair(mut_view(*arena), mut_view(*sink), mut_view(out), 11, 12, 214);
    if rc6 != 0 { return rc6; }

    // Case 7 (blobs 13 -> 14): Differential test on `tests/opt/const_fold_run.ax` lowered MIR vs `axiom0 -O1`.
    let rc7 = check_mir_blob_pair(mut_view(*arena), mut_view(*sink), mut_view(out), 13, 14, 216);
    if rc7 != 0 { return rc7; }

    // Case 8 (blobs 15 -> 16): Differential test on `tests/opt/qa_edge_cases_run.ax` lowered MIR vs `axiom0 -O1`.
    let rc8 = check_mir_blob_pair(mut_view(*arena), mut_view(*sink), mut_view(out), 15, 16, 218);
    if rc8 != 0 { return rc8; }

    0
}

// 3. OptIR, Cooper-Harvey-Kennedy dominators & dominance frontier, minimal SSA (OptPhi, Copy/Move
//    value sharing, SROA), MemorySSA (LiveOnEntry, MemoryDef, MemoryUse, MemoryPhi, AliasResult,
//    clobber walker), 3-valued Certainty lattice, ProofProvenance, contract verification,
//    MIR reconstruction, and unverified MIR rejection (E15.1 / SPEC-70).
fn test_optir_ssa_memssa_certainty(arena: mut_view<Arena>, sink: mut_view<DiagSink>, out_ptr: *mut u8) -> i32 {
    // 3.1 Three-valued Certainty lattice laws (REQ-OPT-397..402)
    if certainty_and(CERTAINTY_PROVEN, CERTAINTY_PROVEN) != CERTAINTY_PROVEN { return 301; }
    if certainty_and(CERTAINTY_PROVEN, CERTAINTY_POSSIBLE) != CERTAINTY_POSSIBLE { return 302; }
    if certainty_and(CERTAINTY_POSSIBLE, CERTAINTY_POSSIBLE) != CERTAINTY_POSSIBLE { return 303; }
    if certainty_and(CERTAINTY_PROVEN, CERTAINTY_UNKNOWN) != CERTAINTY_UNKNOWN { return 304; }
    if certainty_and(CERTAINTY_POSSIBLE, CERTAINTY_UNKNOWN) != CERTAINTY_UNKNOWN { return 305; }
    if certainty_and(CERTAINTY_UNKNOWN, CERTAINTY_UNKNOWN) != CERTAINTY_UNKNOWN { return 306; }

    if certainty_join_paths(CERTAINTY_PROVEN, CERTAINTY_PROVEN) != CERTAINTY_PROVEN { return 307; }
    if certainty_join_paths(CERTAINTY_PROVEN, CERTAINTY_POSSIBLE) != CERTAINTY_POSSIBLE { return 308; }
    if certainty_join_paths(CERTAINTY_PROVEN, CERTAINTY_UNKNOWN) != CERTAINTY_POSSIBLE { return 309; }
    if certainty_join_paths(CERTAINTY_POSSIBLE, CERTAINTY_UNKNOWN) != CERTAINTY_POSSIBLE { return 310; }
    if certainty_join_paths(CERTAINTY_UNKNOWN, CERTAINTY_UNKNOWN) != CERTAINTY_UNKNOWN { return 311; }

    if certainty_negate_hazard(false, CERTAINTY_PROVEN) != CERTAINTY_PROVEN { return 312; }
    if certainty_negate_hazard(false, CERTAINTY_POSSIBLE) != CERTAINTY_POSSIBLE { return 313; }
    if certainty_negate_hazard(false, CERTAINTY_UNKNOWN) != CERTAINTY_UNKNOWN { return 314; }
    if certainty_negate_hazard(true, CERTAINTY_PROVEN) != CERTAINTY_POSSIBLE { return 315; }
    if certainty_negate_hazard(true, CERTAINTY_POSSIBLE) != CERTAINTY_UNKNOWN { return 316; }
    if certainty_negate_hazard(true, CERTAINTY_UNKNOWN) != CERTAINTY_UNKNOWN { return 317; }

    if !certainty_can_rewrite(CERTAINTY_PROVEN) { return 318; }
    if certainty_can_rewrite(CERTAINTY_POSSIBLE) { return 319; }
    if certainty_can_rewrite(CERTAINTY_UNKNOWN) { return 320; }
    if certainty_should_emit_remark(CERTAINTY_PROVEN) { return 321; }
    if !certainty_should_emit_remark(CERTAINTY_POSSIBLE) { return 322; }
    if certainty_should_emit_remark(CERTAINTY_UNKNOWN) { return 323; }

    // 3.2 Lower Verified MIR fixture (blob 17) into OptIR + SSA + MemorySSA
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let thir_ptr = arena_alloc_raw(mut_view(*arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    opt_init_minimal_thir(thir_ptr, mut_view(*arena));
    let in17 = unit_mir_blob(mut_view(*arena), 17);
    let body17 = verify_parse_mir(
        in17,
        unsafe { mut_view((*thir_ptr).interner) },
        mut_view(*arena)
    );
    if (body17 as usize) == 0 {
        opt_free_minimal_thir(thir_ptr);
        return 324;
    }
    let opt_body = optir_build_from_mir(
        unsafe { view(*body17) },
        thir_ptr as *const Thir,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    );
    if (opt_body as usize) == 0 || sink.errors != 0 {
        opt_free_minimal_thir(thir_ptr);
        return 325;
    }

    // 3.3 Check CFG, RPO, Cooper-Harvey-Kennedy dominator tree, and dominance frontier (AXS-OPT-011)
    let bbc = unsafe { (*opt_body).bb_count };
    let rpoc = unsafe { (*opt_body).rpo_count };
    if bbc != 6 || rpoc != 6 {
        opt_free_minimal_thir(thir_ptr);
        return 326;
    }
    let obb0 = unsafe { opt_block_at((*opt_body).blocks, 0) };
    let obb1 = unsafe { opt_block_at((*opt_body).blocks, 1) };
    let obb2 = unsafe { opt_block_at((*opt_body).blocks, 2) };
    let obb3 = unsafe { opt_block_at((*opt_body).blocks, 3) };
    let obb4 = unsafe { opt_block_at((*opt_body).blocks, 4) };
    let obb5 = unsafe { opt_block_at((*opt_body).blocks, 5) };
    if (unsafe { (*obb0).idom.v }) != 0u32 || (unsafe { (*obb0).dom_depth }) != 0u32 ||
       (unsafe { (*obb1).idom.v }) != 0u32 || (unsafe { (*obb1).dom_depth }) != 1u32 ||
       (unsafe { (*obb2).idom.v }) != 0u32 || (unsafe { (*obb2).dom_depth }) != 1u32 ||
       (unsafe { (*obb3).idom.v }) != 0u32 || (unsafe { (*obb3).dom_depth }) != 1u32 ||
       (unsafe { (*obb4).idom.v }) != 3u32 || (unsafe { (*obb4).dom_depth }) != 2u32 ||
       (unsafe { (*obb5).idom.v }) != 3u32 || (unsafe { (*obb5).dom_depth }) != 2u32 {
        opt_free_minimal_thir(thir_ptr);
        return 327;
    }
    let bb0_id = OptBbId { v: 0u32 };
    let bb1_id = OptBbId { v: 1u32 };
    let bb3_id = OptBbId { v: 3u32 };
    let bb4_id = OptBbId { v: 4u32 };
    let bb5_id = OptBbId { v: 5u32 };
    if !opt_dominates(unsafe { view(*opt_body) }, bb0_id, bb5_id) ||
       !opt_strictly_dominates(unsafe { view(*opt_body) }, bb3_id, bb4_id) ||
       opt_dominates(unsafe { view(*opt_body) }, bb1_id, bb3_id) {
        opt_free_minimal_thir(thir_ptr);
        return 328;
    }
    // DF(bb1) = {bb3}, DF(bb2) = {bb3}, DF(bb4) = {bb3}
    if (unsafe { (*obb1).dom_frontier_count }) != 1 ||
       (unsafe { (*opt_bbid_at((*obb1).dom_frontier, 0)).v }) != 3u32 ||
       (unsafe { (*obb2).dom_frontier_count }) != 1 ||
       (unsafe { (*opt_bbid_at((*obb2).dom_frontier, 0)).v }) != 3u32 ||
       (unsafe { (*obb4).dom_frontier_count }) != 1 ||
       (unsafe { (*opt_bbid_at((*obb4).dom_frontier, 0)).v }) != 3u32 {
        opt_free_minimal_thir(thir_ptr);
        return 329;
    }

    // 3.4 Check Copy/Move SSA value sharing (REQ-OPT-337, REQ-OPT-338)
    let inst0 = unsafe { opt_inst_at((*obb0).insts, 0) }; // _1 = const 5
    let inst1 = unsafe { opt_inst_at((*obb0).insts, 1) }; // _2 = copy _1
    let inst2 = unsafe { opt_inst_at((*obb0).insts, 2) }; // _3 = move _2
    let v0_id = unsafe { (*inst0).result.v };
    let v1_id = unsafe { (*inst1).result.v };
    let v2_id = unsafe { (*inst2).result.v };
    let inst2_flags = unsafe { (*inst2).flags };
    if v0_id == 0u32 || v0_id != v1_id || v1_id != v2_id || (inst2_flags & OPT_FLAG_MOVE) == 0u16 {
        opt_free_minimal_thir(thir_ptr);
        return 330;
    }

    // 3.5 Check SROA aggregate field projection on local _4 (AXS-OPT-014)
    let mode4 = unsafe { *opt_u8_at((*opt_body).local_modes, 4) };
    let sroa4_cnt = unsafe { *opt_u32_at((*opt_body).local_sroa_count, 4) };
    if mode4 != OPT_LOCAL_SROA || sroa4_cnt != 2u32 {
        opt_free_minimal_thir(thir_ptr);
        return 331;
    }
    let inst4 = unsafe { opt_inst_at((*obb0).insts, 4) }; // (_4.0) = const 20
    let inst5 = unsafe { opt_inst_at((*obb0).insts, 5) }; // _5 = copy (_4.0) + copy (_4.1)
    if (unsafe { (*inst5).lhs.v }) != (unsafe { (*inst4).result.v }) {
        opt_free_minimal_thir(thir_ptr);
        return 332;
    }

    // 3.6 Check minimal SSA OptPhi placement at bb3 (AXS-OPT-013)
    let bb3_phis = unsafe { (*obb3).phi_count };
    if bb3_phis == 0 {
        opt_free_minimal_thir(thir_ptr);
        return 333;
    }
    let phi0 = unsafe { opt_phi_at((*obb3).phis, 0) };
    if (unsafe { (*phi0).src_local.v }) != 9u32 || (unsafe { (*phi0).arity }) != 3 {
        opt_free_minimal_thir(thir_ptr);
        return 334;
    }

    // 3.7 Check MemorySSA (LiveOnEntry, MemoryDef, MemoryUse, MemoryPhi, AliasResult, clobber walker)
    let mode7 = unsafe { *opt_u8_at((*opt_body).local_modes, 7) };
    let mode10 = unsafe { *opt_u8_at((*opt_body).local_modes, 10) };
    if mode7 != OPT_LOCAL_MEMORY || mode10 != OPT_LOCAL_MEMORY {
        opt_free_minimal_thir(thir_ptr);
        return 335;
    }
    if (unsafe { (*opt_body).mem_ssa_count }) < 4 {
        opt_free_minimal_thir(thir_ptr);
        return 336;
    }
    let mdef0 = unsafe { opt_memdef_at((*opt_body).mem_defs, 0) };
    if (unsafe { (*mdef0).kind }) != MEM_DEF_LIVE_ON_ENTRY {
        opt_free_minimal_thir(thir_ptr);
        return 337;
    }
    if !(unsafe { (*obb3).has_mem_phi }) {
        opt_free_minimal_thir(thir_ptr);
        return 338;
    }
    let inst6 = unsafe { opt_inst_at((*obb0).insts, 6) }; // _7 = const 50 (Store -> mem1)
    let inst7 = unsafe { opt_inst_at((*obb0).insts, 7) }; // _10 = const 77 (Store -> mem2)
    let inst8 = unsafe { opt_inst_at((*obb0).insts, 8) }; // _12 = copy _7 (Load -> uses mem2)
    if (unsafe { (*inst6).opcode }) != OPT_INST_STORE ||
       (unsafe { (*inst7).opcode }) != OPT_INST_STORE ||
       (unsafe { (*inst8).opcode }) != OPT_INST_LOAD {
        opt_free_minimal_thir(thir_ptr);
        return 339;
    }
    let mem1_id = MemSsaId { v: unsafe { (*inst6).mem_def.v } };
    let mem2_id = MemSsaId { v: unsafe { (*inst7).mem_def.v } };
    let load_use_id = MemSsaId { v: unsafe { (*inst8).mem_use.v } };
    if mem1_id.v == 0u32 || mem2_id.v == 0u32 || load_use_id.v != mem2_id.v {
        opt_free_minimal_thir(thir_ptr);
        return 340;
    }
    let mdef1 = unsafe { opt_memdef_at((*opt_body).mem_defs, mem1_id.v as usize) };
    if (unsafe { (*mdef1).kind }) != MEM_DEF_INST || (unsafe { (*mdef1).prev_mem.v }) != 0u32 {
        opt_free_minimal_thir(thir_ptr);
        return 341;
    }
    let reg7 = optir_extract_memory_region(unsafe { view(*opt_body) }, unsafe { view((*inst6).place) });
    let reg10 = optir_extract_memory_region(unsafe { view(*opt_body) }, unsafe { view((*inst7).place) });
    let al_same = optir_alias_query(unsafe { view(*opt_body) }, view(reg7), view(reg7));
    let al_diff = optir_alias_query(unsafe { view(*opt_body) }, view(reg7), view(reg10));
    if al_same != ALIAS_MUST_ALIAS || al_diff != ALIAS_NO_ALIAS {
        opt_free_minimal_thir(thir_ptr);
        return 342;
    }
    // mem2 (store to _10) must NOT clobber reg7, whereas mem1 (store to _7) MUST clobber reg7
    if memssa_does_clobber(unsafe { view(*opt_body) }, mem2_id, view(reg7)) ||
       !memssa_does_clobber(unsafe { view(*opt_body) }, mem1_id, view(reg7)) {
        opt_free_minimal_thir(thir_ptr);
        return 343;
    }
    let clobber_def = memssa_find_clobbering_def(
        unsafe { view(*opt_body) },
        load_use_id,
        view(reg7),
        64u32
    );
    if clobber_def.v != mem1_id.v {
        opt_free_minimal_thir(thir_ptr);
        return 344;
    }

    // 3.8 Check ProofProvenance & OptIR contract verification & MIR reconstruction
    if (unsafe { (*opt_body).provenance_count }) < 4 {
        opt_free_minimal_thir(thir_ptr);
        return 345;
    }
    if !optir_verify_contract(unsafe { view(*opt_body) }) {
        opt_free_minimal_thir(thir_ptr);
        return 346;
    }
    let recon_mir = arena_alloc_raw(mut_view(*arena), size_of<MirBody>(), align_of<MirBody>()) as *mut MirBody;
    if !optir_reconstruct_mir(unsafe { view(*opt_body) }, unsafe { mut_view(*recon_mir) }, mut_view(*arena)) {
        opt_free_minimal_thir(thir_ptr);
        return 347;
    }
    verify_mir(
        unsafe { view(*recon_mir) },
        thir_ptr as *const Thir,
        mut_view(*sink),
        0 as *const HirItem
    );
    if sink.errors != 0 {
        opt_free_minimal_thir(thir_ptr);
        return 348;
    }
    opt_free_minimal_thir(thir_ptr);
    arena_reset(mut_view(*arena));

    // 3.9 Check optir_inspect_mir_text (--emit=optir and --emit=memssa) & negative unverified MIR rejection
    let mut out = DiagBuffer { ptr: out_ptr, len: 0, cap: 32768 };
    let in17_b = unit_mir_blob(mut_view(*arena), 17);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    out.len = 0;
    if !optir_inspect_mir_text(in17_b, false, true, mut_view(out), mut_view(*sink), mut_view(*arena)) || sink.errors != 0 || out.len == 0 {
        return 349;
    }
    let in17_c = unit_mir_blob(mut_view(*arena), 17);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    out.len = 0;
    if !optir_inspect_mir_text(in17_c, true, true, mut_view(out), mut_view(*sink), mut_view(*arena)) || sink.errors != 0 || out.len == 0 {
        return 350;
    }
    let in18_bad = unit_mir_blob(mut_view(*arena), 18);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    out.len = 0;
    if optir_inspect_mir_text(in18_bad, false, false, mut_view(out), mut_view(*sink), mut_view(*arena)) || sink.errors == 0 {
        return 351;
    }
    arena_reset(mut_view(*arena));
    0
}

pub fn main() -> i32 {
    let mut perm_arena = arena_new();
    let out_ptr = arena_alloc_raw(mut_view(perm_arena), 32768, 1);
    let mut arena = arena_new();
    let _ = arena_alloc_raw(mut_view(arena), 16, 8);
    let sink_ptr = arena_alloc_raw(mut_view(perm_arena), size_of<DiagSink>(), align_of<DiagSink>()) as *mut DiagSink;
    unsafe { diag_sink_init(mut_view(*sink_ptr)); }

    let rc1 = test_const_fold_scalars(mut_view(arena));
    if rc1 != 0 {
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(arena));
        arena_destroy(mut_view(perm_arena));
        return rc1;
    }

    let rc2 = test_mir_passes(mut_view(arena), unsafe { mut_view(*sink_ptr) }, out_ptr);
    if rc2 != 0 {
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(arena));
        arena_destroy(mut_view(perm_arena));
        return rc2;
    }

    let rc3 = test_optir_ssa_memssa_certainty(mut_view(arena), unsafe { mut_view(*sink_ptr) }, out_ptr);
    if rc3 != 0 {
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(arena));
        arena_destroy(mut_view(perm_arena));
        return rc3;
    }

    unsafe { diag_sink_free(mut_view(*sink_ptr)); }
    arena_destroy(mut_view(arena));
    arena_destroy(mut_view(perm_arena));
    print("OK opt unit (const_fold + dce + cfg_simp + mir diff)\n");
    0
}

