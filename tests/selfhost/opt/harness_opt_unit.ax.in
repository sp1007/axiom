        ty: TypeId { v: 0u32 },
        kind: MIR_CONST_INT,
        val: 0u64,
        str_bytes: 0 as *const u8,
        str_len: 0,
        sym: SymbolId { v: 0u32 },
    };
    init_const_op(mut_view(operand), ty_v, val);
    mir_const_reset_vals(mut_view(out), MIR_CONST_INT, 0u32, 0u64);
