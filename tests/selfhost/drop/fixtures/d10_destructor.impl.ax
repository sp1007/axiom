// d10_destructor.ax with the destructor written out (input of the C oracle only).
struct Res {}

struct Guard {
    id: i32,
    inner: Res,
}

struct Holder {
    g: Guard,
    r: Res,
}

fn main() {
    let g = Guard { id: 1, inner: Res {} };
    let h = Holder { g: Guard { id: 2, inner: Res {} }, r: Res {} };
}

impl Drop for Guard {
    fn drop(self: mut_view<Guard>) {
    }
}
