// User destructors. The Axiom harness adds `impl Drop for Guard { fn drop(...) }` to the HIR of
// this file after type checking (synthetic pass, golden d10_destructor.synth.mir); the C oracle
// sees the same impl in d10_destructor.impl.ax, and `gen_drop_tests.py check` compares the two
// elaborations up to type and symbol numbering. The plain passes compare this file as written.
struct Res {}

struct Guard {
    id: i32,
    inner: Res,
}

struct Holder {
    g: Guard,
    r: Res,
}

fn main() {
    let g = Guard { id: 1, inner: Res {} };
    let h = Holder { g: Guard { id: 2, inner: Res {} }, r: Res {} };
}
