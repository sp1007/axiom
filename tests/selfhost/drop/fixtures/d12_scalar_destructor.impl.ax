// d12_scalar_destructor.ax with the destructor written out (input of the C oracle only).
struct Guard {
    id: i32,
}

struct Holder {
    g: Guard,
    tag: i32,
}

fn main() {
    let g = Guard { id: 1 };
    let h = Holder { g: Guard { id: 2 }, tag: 3 };
}

impl Drop for Guard {
    fn drop(self: mut_view<Guard>) {
    }
}
