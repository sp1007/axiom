// Enum drop: discriminant switch over the variants whose fields need drop.
struct Res {}

enum Shape {
    Empty,
    One(Res),
    Num(i32),
    Two(Res, i32, Res),
}

fn main() {
    let a = Shape.One(Res {});
    let b = Shape.Num(4);
    let c = Shape.Two(Res {}, 1, Res {});
    let d = Shape.Empty;
}
