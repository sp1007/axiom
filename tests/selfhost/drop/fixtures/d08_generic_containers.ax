// Generic containers instantiated with a droppable type and with a copy type.
struct Res {}

struct Wrap<T> {
    v: T,
    tag: i32,
}

enum Opt<U> {
    Some(U),
    None,
}

fn main() {
    let w: Wrap<Res> = Wrap { v: Res {}, tag: 1 };
    let n: Wrap<i32> = Wrap { v: 9, tag: 2 };
    let o: Opt<Res> = Opt.Some(Res {});
    let e: Opt<i32> = Opt.None;
    let inner: Wrap<Res> = Wrap { v: Res {}, tag: 3 };
    let nested: Wrap<Wrap<Res>> = Wrap { v: inner, tag: 4 };
}
