// Drops on early return, break and continue edges.
struct Res {}

fn early(c: bool) -> i32 {
    let a = Res {};
    if c {
        return 1;
    }
    let b = Res {};
    return 2;
}

fn looping() {
    let mut i = 0;
    while i < 4 {
        let a = Res {};
        i = i + 1;
        if i == 1 {
            continue;
        }
        if i == 3 {
            break;
        }
    }
}

fn main() {
    let x = early(true);
    looping();
}
