// Field-wise drops of compound structs and a tuple, in reverse field order.
struct Res {}

struct Pair {
    a: Res,
    n: i32,
    b: Res,
}

struct Outer {
    p: Pair,
    k: u8,
    q: Res,
}

fn main() {
    let p = Pair { a: Res {}, n: 1, b: Res {} };
    let o = Outer { p: Pair { a: Res {}, n: 2, b: Res {} }, k: 3u8, q: Res {} };
    let t = (Res {}, 5u8, Res {});
    let nested = (Pair { a: Res {}, n: 6, b: Res {} }, (Res {}, 7u8));
}
