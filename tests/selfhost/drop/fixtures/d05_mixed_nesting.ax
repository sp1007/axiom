// Nested aggregates: enums inside structs and structs inside enum variants, expanded over several
// passes; a droppable argument and a partially droppable argument.
struct Res {}

struct Pair {
    a: Res,
    n: i32,
}

enum Slot {
    Free,
    Held(Pair),
    Many(Res, Pair),
}

struct Rack {
    first: Slot,
    count: u8,
    last: Slot,
}

fn take(r: Rack, n: i32, p: Pair) -> i32 {
    return n;
}

fn main() {
    let rack = Rack { first: Slot.Held(Pair { a: Res {}, n: 1 }), count: 2u8, last: Slot.Free };
    let v = take(rack, 3, Pair { a: Res {}, n: 4 });
}
