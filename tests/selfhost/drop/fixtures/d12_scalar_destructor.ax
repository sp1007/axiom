// Scalar-field user destructor (AX0-FIX-03). The Axiom harness adds `impl Drop for Guard { fn drop(...) }`
// to the HIR of this file after type checking (synthetic pass, golden d12_scalar_destructor.synth.mir);
// the C oracle sees the same impl in d12_scalar_destructor.impl.ax, and `gen_drop_tests.py check`
// compares the two elaborations up to type and symbol numbering.
struct Guard {
    id: i32,
}

struct Holder {
    g: Guard,
    tag: i32,
}

fn main() {
    let g = Guard { id: 1 };
    let h = Holder { g: Guard { id: 2 }, tag: 3 };
}
