// QA edge cases: no-drop function, move in loop body, move in both branches, droppable call
// result, two flagged locals sharing a scope, nested enum inside a tuple, conditionally moved tuple.
struct Res {}

struct Pair {
    left: Res,
    right: Res,
}

enum Slot {
    Empty,
    Full(Res),
}

fn consume(r: Res) {
}

fn make() -> Res {
    Res {}
}

fn plain(a: i32, b: bool) -> i32 {
    let c = a + 1;
    if b {
        return c;
    }
    c
}

fn loop_move(n: i32) {
    let mut i = 0;
    while i < n {
        let r = Res {};
        if i == 2 {
            consume(r);
        }
        i = i + 1;
    }
}

fn both_branches(c: bool) {
    let a = Res {};
    let b = Res {};
    if c {
        consume(a);
    } else {
        consume(b);
    }
}

fn nested(c: bool) {
    let t = (Slot.Full(Res {}), 3u8, Pair { left: Res {}, right: Res {} });
    if c {
        let u = t;
    }
}

fn main() {
    let x = plain(1, true);
    loop_move(4);
    both_branches(false);
    let r = make();
    nested(true);
}
