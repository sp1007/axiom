@intrinsic fn assert(cond: bool) {}
@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_write_bytes<T>(dst: *mut T, val: u8, count: usize) {}

fn qa_check(cond: bool) {
    if !cond {
        assert(false);
    }
}

fn qa_zero_span() -> Span {
    Span {
        file: FileId { v: 0u32 },
        start: 0u32,
        end: 0u32,
    }
}

fn alloc_init_interner() -> *mut StrInterner {
    let p = unsafe { heap_alloc(size_of<StrInterner>(), align_of<StrInterner>()) as *mut StrInterner };
    unsafe {
        ptr_write_bytes<u8>(p as *mut u8, 0u8, size_of<StrInterner>());
        interner_init(mut_view(*p));
    }
    p
}

fn free_dealloc_interner(p: *mut StrInterner) {
    interner_free(unsafe { mut_view(*p) });
    unsafe {
        heap_free(p as *mut u8, size_of<StrInterner>(), align_of<StrInterner>());
    }
}

fn alloc_init_sink() -> *mut DiagSink {
    let p = unsafe { heap_alloc(size_of<DiagSink>(), align_of<DiagSink>()) as *mut DiagSink };
    unsafe {
        ptr_write_bytes<u8>(p as *mut u8, 0u8, size_of<DiagSink>());
        diag_sink_init(mut_view(*p));
    }
    p
}

fn free_dealloc_sink(p: *mut DiagSink) {
    diag_sink_free(unsafe { mut_view(*p) });
    unsafe {
        heap_free(p as *mut u8, size_of<DiagSink>(), align_of<DiagSink>());
    }
}

fn alloc_init_thir() -> *mut Thir {
    let p = unsafe { heap_alloc(size_of<Thir>(), align_of<Thir>()) as *mut Thir };
    let int_ar = arena_new();
    unsafe {
        ptr_write_bytes<u8>(p as *mut u8, 0u8, size_of<Thir>());
        (*p).interner.arena = int_ar;
        thir_init(mut_view(*p));
    }
    p
}

fn free_dealloc_thir(p: *mut Thir) {
    thir_free(unsafe { mut_view(*p) });
    unsafe {
        heap_free(p as *mut u8, size_of<Thir>(), align_of<Thir>());
    }
}

fn free_panic_sv(sv: mut_view<StrView>) {
    if (sv.ptr as usize) != 0 {
        unsafe {
            heap_free(sv.ptr as *mut u8, sv.len + 1, 1);
        }
        sv.ptr = 0 as *const u8;
        sv.len = 0;
    }
}

fn map_mut_ptr(m: mut_view<MirBodyMap>) -> *mut MirBodyMap {
    unsafe { address_of_mut(*m) }
}

fn run_test_interp(
    main_fn: *mut HirItem,
    thir_ptr: *mut Thir,
    hir: view<HirFile>,
    str_in: *mut StrInterner,
    sink_ptr: *mut DiagSink,
    step_limit: i32,
    call_depth_limit: i32,
    mir_map_ptr: *mut MirBodyMap,
    out_buf: mut_view<DiagBuffer>,
    panic_sv: mut_view<StrView>
) -> i32 {
    interp_run(
        main_fn,
        thir_ptr,
        unsafe { address_of(*hir) },
        str_in,
        0 as *const ResolveMap,
        0 as *const Ast,
        0 as *const SourceDatabase,
        sink_ptr,
        0 as *mut MonoEngine,
        step_limit,
        call_depth_limit,
        mir_map_ptr,
        unsafe { address_of_mut(*out_buf) },
        true,
        unsafe { address_of_mut(*panic_sv) }
    )
}

fn run_test_const_eval(
    hir: view<HirFile>,
    str_in: *mut StrInterner,
    sink_ptr: *mut DiagSink,
    thir_ptr: *mut Thir,
    expr: *mut HirExpr,
    expected_ty_v: u32,
    out_res: mut_view<ConstEvalResult>
) {
    let cctx = InterpConstEvalCtx {
        hir: unsafe { address_of(*hir) },
        interner: str_in,
        rmap: 0 as *const ResolveMap,
        ast: 0 as *const Ast,
        db: 0 as *const SourceDatabase,
        sink: sink_ptr,
    };
    let limits = ConstLimits {
        max_steps: 10000,
        max_call_depth: 32,
    };
    interp_eval_const_expr_into(view(cctx), thir_ptr, expr, TypeId { v: expected_ty_v }, limits, out_res);
}

fn add_loc(body: mut_view<MirBody>, arena: mut_view<Arena>, ty_v: u32, kind: u8) -> u32 {
    let sp = qa_zero_span();
    let id = mir_add_local(body, arena, TypeId { v: ty_v }, kind, true, StrId { v: 0u32 }, view(sp));
    id.v
}

fn add_bb_ptr(body: mut_view<MirBody>, arena: mut_view<Arena>) -> *mut MirBb {
    let id = mir_add_bb(mut_view(*body), arena, false);
    unsafe { mir_bb_at(body.bbs, id.v as usize) }
}

fn op_const_int(arena: mut_view<Arena>, ty_v: u32, val: u64) -> *mut MirOperand {
    let op = arena_alloc_raw(arena, size_of<MirOperand>(), align_of<MirOperand>()) as *mut MirOperand;
    unsafe {
        mir_operand_zero(mut_view(*op), MIR_OP_CONST);
        (*op).constant.ty = TypeId { v: ty_v };
        (*op).constant.kind = MIR_CONST_INT;
        (*op).constant.val = val;
    }
    op
}

fn op_copy_local(arena: mut_view<Arena>, loc: u32) -> *mut MirOperand {
    let op = arena_alloc_raw(arena, size_of<MirOperand>(), align_of<MirOperand>()) as *mut MirOperand;
    unsafe {
        mir_operand_zero(mut_view(*op), MIR_OP_COPY);
        (*op).place = mir_local_place(loc);
    }
    op
}

fn op_fn_sym(arena: mut_view<Arena>, fn_ty_v: u32, sym_v: u32) -> *mut MirOperand {
    let op = arena_alloc_raw(arena, size_of<MirOperand>(), align_of<MirOperand>()) as *mut MirOperand;
    unsafe {
        mir_operand_zero(mut_view(*op), MIR_OP_CONST);
        (*op).constant.ty = TypeId { v: fn_ty_v };
        (*op).constant.kind = MIR_CONST_FN;
        (*op).constant.val = sym_v as u64;
        (*op).constant.sym = SymbolId { v: sym_v };
    }
    op
}

fn op_place(arena: mut_view<Arena>, place: MirPlace) -> *mut MirOperand {
    let op = arena_alloc_raw(arena, size_of<MirOperand>(), align_of<MirOperand>()) as *mut MirOperand;
    unsafe {
        mir_operand_zero(mut_view(*op), MIR_OP_COPY);
        mir_copy_place(mut_view((*op).place), view(place));
    }
    op
}

fn place_index(arena: mut_view<Arena>, base: MirPlace, idx_loc: u32) -> MirPlace {
    let proj = MirProjection {
        kind: MIR_PROJ_INDEX,
        field_idx: 0u32,
        index_local: MirLocalId { v: idx_loc },
        from_local: MirLocalId { v: 0u32 },
        to_local: MirLocalId { v: 0u32 },
        has_from: false,
        has_to: false,
        variant_idx: 0u32,
    };
    let mut dst = mir_local_place(0u32);
    mir_place_append_proj(arena, view(base), view(proj), mut_view(dst));
    dst
}

fn emit_use(bb: *mut MirBb, arena: mut_view<Arena>, dst: MirPlace, op: *mut MirOperand) {
    let stmt = arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt;
    unsafe {
        mir_stmt_zero(mut_view(*stmt), MIR_STMT_ASSIGN);
        mir_copy_place(mut_view((*stmt).place), view(dst));
        (*stmt).rvalue.kind = MIR_RVALUE_USE;
        mir_copy_operand(mut_view((*stmt).rvalue.use_op), view(*op));
        mir_bb_push_stmt(mut_view(*bb), arena, view(*stmt));
    }
}

fn emit_binop(
    bb: *mut MirBb,
    arena: mut_view<Arena>,
    dst: MirPlace,
    bin_op: u8,
    lhs: *mut MirOperand,
    rhs: *mut MirOperand
) {
    let stmt = arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt;
    unsafe {
        mir_stmt_zero(mut_view(*stmt), MIR_STMT_ASSIGN);
        mir_copy_place(mut_view((*stmt).place), view(dst));
        (*stmt).rvalue.kind = MIR_RVALUE_BINARY_OP;
        (*stmt).rvalue.bin_op = bin_op;
        mir_copy_operand(mut_view((*stmt).rvalue.lhs), view(*lhs));
        mir_copy_operand(mut_view((*stmt).rvalue.rhs), view(*rhs));
        mir_bb_push_stmt(mut_view(*bb), arena, view(*stmt));
    }
}

fn emit_cast(
    bb: *mut MirBb,
    arena: mut_view<Arena>,
    dst: MirPlace,
    cast_kind: u8,
    op: *mut MirOperand,
    target_ty_v: u32
) {
    let stmt = arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt;
    unsafe {
        mir_stmt_zero(mut_view(*stmt), MIR_STMT_ASSIGN);
        mir_copy_place(mut_view((*stmt).place), view(dst));
        (*stmt).rvalue.kind = MIR_RVALUE_CAST;
        (*stmt).rvalue.cast_kind = cast_kind;
        (*stmt).rvalue.target_ty = TypeId { v: target_ty_v };
        mir_copy_operand(mut_view((*stmt).rvalue.use_op), view(*op));
        mir_bb_push_stmt(mut_view(*bb), arena, view(*stmt));
    }
}

fn emit_agg3(
    bb: *mut MirBb,
    arena: mut_view<Arena>,
    dst: MirPlace,
    op0: *mut MirOperand,
    op1: *mut MirOperand,
    op2: *mut MirOperand
) {
    let ops = arena_alloc_raw(mut_view(*arena), mir_mul_usize(3, size_of<MirOperand>()), align_of<MirOperand>()) as *mut MirOperand;
    let stmt = arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt;
    unsafe {
        let p0 = mir_op_at(ops, 0);
        let p1 = mir_op_at(ops, 1);
        let p2 = mir_op_at(ops, 2);
        mir_copy_operand(mut_view(*p0), view(*op0));
        mir_copy_operand(mut_view(*p1), view(*op1));
        mir_copy_operand(mut_view(*p2), view(*op2));
        mir_stmt_zero(mut_view(*stmt), MIR_STMT_ASSIGN);
        mir_copy_place(mut_view((*stmt).place), view(dst));
        (*stmt).rvalue.kind = MIR_RVALUE_AGGREGATE;
        (*stmt).rvalue.variant_idx = 0u32;
        (*stmt).rvalue.operands = ops;
        (*stmt).rvalue.operand_count = 3;
        mir_bb_push_stmt(mut_view(*bb), arena, view(*stmt));
    }
}

fn term_return(bb: *mut MirBb, arena: mut_view<Arena>) {
    let term = arena_alloc_raw(arena, size_of<MirTerminator>(), align_of<MirTerminator>()) as *mut MirTerminator;
    unsafe {
        mir_term_zero(mut_view(*term), MIR_TERM_RETURN);
        mir_bb_set_terminator(mut_view(*bb), view(*term));
    }
}

fn term_goto(bb: *mut MirBb, arena: mut_view<Arena>, target_bb: u32) {
    let term = arena_alloc_raw(arena, size_of<MirTerminator>(), align_of<MirTerminator>()) as *mut MirTerminator;
    unsafe {
        mir_term_zero(mut_view(*term), MIR_TERM_GOTO);
        (*term).goto_target.v = target_bb;
        mir_bb_set_terminator(mut_view(*bb), view(*term));
    }
}

fn term_call(
    bb: *mut MirBb,
    arena: mut_view<Arena>,
    func_op: *mut MirOperand,
    args: *mut MirOperand,
    arg_count: usize,
    dst: MirPlace,
    has_dst: bool,
    target_bb: u32
) {
    let term = arena_alloc_raw(arena, size_of<MirTerminator>(), align_of<MirTerminator>()) as *mut MirTerminator;
    unsafe {
        mir_term_zero(mut_view(*term), MIR_TERM_CALL);
        mir_copy_operand(mut_view((*term).func), view(*func_op));
        (*term).args = args;
        (*term).arg_count = arg_count;
        mir_copy_place(mut_view((*term).destination), view(dst));
        (*term).has_destination = has_dst;
        (*term).call_target.v = target_bb;
        mir_bb_set_terminator(mut_view(*bb), view(*term));
    }
}

const TEST_NAMES_B: [18]u8 = [
    // 0..4: "main"
    109u8, 97u8, 105u8, 110u8,
    // 4..7: "inf"
    105u8, 110u8, 102u8,
    // 7..8: "C"
    67u8,
    // 8..18: "foreign_fn"
    102u8, 111u8, 114u8, 101u8, 105u8, 103u8, 110u8, 95u8, 102u8, 110u8,
];

fn intern_test_name(
    arena: mut_view<Arena>,
    str_in: mut_view<StrInterner>,
    off: usize,
    n: usize
) -> StrId {
    let dst = arena_alloc_raw(arena, n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe {
            *(dst + i) = TEST_NAMES_B[off + i];
        }
        i = i + 1;
    }
    unsafe {
        *(dst + n) = 0u8;
    }
    interner_intern_bytes(str_in, dst as *const u8, n)
}

fn make_fn_item(
    arena: mut_view<Arena>,
    str_in: mut_view<StrInterner>,
    thir: mut_view<Thir>,
    name_off: usize,
    name_len: usize,
    sym_v: u32,
    param_tys: *mut TypeId,
    param_count: usize,
    ret_ty_v: u32,
    abi_sid_v: u32
) -> *mut HirItem {
    let item: *mut HirItem = hir_alloc_item(mut_view(*arena), HIR_ITEM_FN, qa_zero_span());
    let sid = intern_test_name(mut_view(*arena), mut_view(*str_in), name_off, name_len);
    let fn_ty = intern_fn_ty(
        mut_view(thir.interner),
        false,
        StrId { v: abi_sid_v },
        param_tys,
        param_count,
        TypeId { v: ret_ty_v }
    );
    unsafe {
        (*item).name = StrId { v: sid.v };
        (*item).symbol = SymbolId { v: sym_v };
        (*item).abi = StrId { v: abi_sid_v };
    }

    let mut head_p: *mut HirParam = 0 as *mut HirParam;
    let mut tail_p: *mut HirParam = 0 as *mut HirParam;
    let mut i: usize = 0;
    while i < param_count {
        let p: *mut HirParam = hir_alloc_param(mut_view(*arena), qa_zero_span());
        let p_sym_v = sym_v + 100u32 + (i as u32);
        let p_ty_v = unsafe { (*typeid_at(param_tys, i)).v };
        unsafe {
            (*p).name = StrId { v: sid.v };
            (*p).symbol = SymbolId { v: p_sym_v };
        }
        thir_set_param_type(mut_view(*thir), p as *const HirParam, TypeId { v: p_ty_v });
        thir_set_sym_type(mut_view(*thir), SymbolId { v: p_sym_v }, TypeId { v: p_ty_v });
        if (head_p as usize) == 0 {
            head_p = p;
            tail_p = p;
        } else {
            unsafe {
                (*tail_p).next = p;
            }
            tail_p = p;
        }
        i = i + 1;
    }
    unsafe {
        (*item).params = head_p;
    }

    thir_set_item_type(mut_view(*thir), item as *const HirItem, TypeId { v: fn_ty.v });
    thir_set_sym_type(mut_view(*thir), SymbolId { v: sym_v }, TypeId { v: fn_ty.v });
    item
}

// =================================================================================================
// 1. Division by Zero Panic (exit_code == 101)
// =================================================================================================

fn test_div_by_zero_panic() {
    let mut arena = arena_new();
    let str_in = alloc_init_interner();
    let thir_ptr = alloc_init_thir();

    let t_i32 = unsafe { (*thir_ptr).interner.t_i32.v };

    let fn_main = make_fn_item(
        mut_view(arena),
        unsafe { mut_view(*str_in) },
        unsafe { mut_view(*thir_ptr) },
        0,
        4,
        1u32,
        0 as *mut TypeId,
        0,
        t_i32,
        0u32
    );
    let hir = HirFile { items: fn_main };

    let body = mir_body_new(mut_view(arena));
    let l_ret = add_loc(unsafe { mut_view(*body) }, mut_view(arena), t_i32, MIR_LOCAL_RETURN);
    let l_zero = add_loc(unsafe { mut_view(*body) }, mut_view(arena), t_i32, MIR_LOCAL_USER);

    let bb0 = add_bb_ptr(unsafe { mut_view(*body) }, mut_view(arena));
    let op_0 = op_const_int(mut_view(arena), t_i32, 0u64);
    let op_42 = op_const_int(mut_view(arena), t_i32, 42u64);
    let op_z = op_copy_local(mut_view(arena), l_zero);
    emit_use(bb0, mut_view(arena), mir_local_place(l_zero), op_0);
    emit_binop(
        bb0,
        mut_view(arena),
        mir_local_place(l_ret),
        MIR_BINOP_DIV,
        op_42,
        op_z
    );
    term_return(bb0, mut_view(arena));

    let mut mir_map = MirBodyMap {
        entries: 0 as *mut MirBodyEntry,
        len: 0,
        cap: 0,
    };
    mir_body_map_init(mut_view(mir_map));
    mir_body_map_insert(mut_view(mir_map), fn_main as *const HirItem, 1u32, body);

    let sink_ptr = alloc_init_sink();
    let mut out_buf = diag_buf_new();
    let mut panic_sv = StrView { ptr: 0 as *const u8, len: 0 };

    let code = run_test_interp(
        fn_main,
        thir_ptr,
        view(hir),
        str_in,
        sink_ptr,
        100000,
        64,
        map_mut_ptr(mut_view(mir_map)),
        mut_view(out_buf),
        mut_view(panic_sv)
    );

    qa_check(code == 101);
    qa_check(panic_sv.len > 0);

    free_panic_sv(mut_view(panic_sv));
    diag_buf_free(mut_view(out_buf));
    free_dealloc_sink(sink_ptr);
    mir_body_map_free(mut_view(mir_map));
    free_dealloc_thir(thir_ptr);
    free_dealloc_interner(str_in);
    arena_destroy(mut_view(arena));
}

// =================================================================================================
// 2. Signed Integer Overflow Panic (exit_code == 101)
// =================================================================================================

fn test_signed_overflow_panic() {
    let mut arena = arena_new();
    let str_in = alloc_init_interner();
    let thir_ptr = alloc_init_thir();

    let t_i8 = unsafe { (*thir_ptr).interner.t_i8.v };
    let t_i32 = unsafe { (*thir_ptr).interner.t_i32.v };

    let fn_main = make_fn_item(
        mut_view(arena),
        unsafe { mut_view(*str_in) },
        unsafe { mut_view(*thir_ptr) },
        0,
        4,
        2u32,
        0 as *mut TypeId,
        0,
        t_i32,
        0u32
    );
    let hir = HirFile { items: fn_main };

    let body = mir_body_new(mut_view(arena));
    let l_ret = add_loc(unsafe { mut_view(*body) }, mut_view(arena), t_i32, MIR_LOCAL_RETURN);
    let l_x = add_loc(unsafe { mut_view(*body) }, mut_view(arena), t_i8, MIR_LOCAL_USER);
    let l_y = add_loc(unsafe { mut_view(*body) }, mut_view(arena), t_i8, MIR_LOCAL_TEMP);

    let bb0 = add_bb_ptr(unsafe { mut_view(*body) }, mut_view(arena));
    let op_127 = op_const_int(mut_view(arena), t_i8, 127u64);
    let op_x = op_copy_local(mut_view(arena), l_x);
    let op_1 = op_const_int(mut_view(arena), t_i8, 1u64);
    let op_0 = op_const_int(mut_view(arena), t_i32, 0u64);
    emit_use(bb0, mut_view(arena), mir_local_place(l_x), op_127);
    emit_binop(
        bb0,
        mut_view(arena),
        mir_local_place(l_y),
        MIR_BINOP_ADD,
        op_x,
        op_1
    );
    emit_use(bb0, mut_view(arena), mir_local_place(l_ret), op_0);
    term_return(bb0, mut_view(arena));

    let mut mir_map = MirBodyMap {
        entries: 0 as *mut MirBodyEntry,
        len: 0,
        cap: 0,
    };
    mir_body_map_init(mut_view(mir_map));
    mir_body_map_insert(mut_view(mir_map), fn_main as *const HirItem, 2u32, body);

    let sink_ptr = alloc_init_sink();
    let mut out_buf = diag_buf_new();
    let mut panic_sv = StrView { ptr: 0 as *const u8, len: 0 };

    let code = run_test_interp(
        fn_main,
        thir_ptr,
        view(hir),
        str_in,
        sink_ptr,
        100000,
        64,
        map_mut_ptr(mut_view(mir_map)),
        mut_view(out_buf),
        mut_view(panic_sv)
    );

    qa_check(code == 101);
    qa_check(panic_sv.len > 0);

    free_panic_sv(mut_view(panic_sv));
    diag_buf_free(mut_view(out_buf));
    free_dealloc_sink(sink_ptr);
    mir_body_map_free(mut_view(mir_map));
    free_dealloc_thir(thir_ptr);
    free_dealloc_interner(str_in);
    arena_destroy(mut_view(arena));
}

// =================================================================================================
// 3. Array Bounds Check Panic (exit_code == 101)
// =================================================================================================

fn test_bounds_check_panic() {
    let mut arena = arena_new();
    let str_in = alloc_init_interner();
    let thir_ptr = alloc_init_thir();

    let t_i32 = unsafe { (*thir_ptr).interner.t_i32.v };
    let t_usize = unsafe { (*thir_ptr).interner.t_usize.v };
    let t_arr = intern_array_ty(unsafe { mut_view((*thir_ptr).interner) }, TypeId { v: t_i32 }, 3u64).v;

    let fn_main = make_fn_item(
        mut_view(arena),
        unsafe { mut_view(*str_in) },
        unsafe { mut_view(*thir_ptr) },
        0,
        4,
        3u32,
        0 as *mut TypeId,
        0,
        t_i32,
        0u32
    );
    let hir = HirFile { items: fn_main };

    let body = mir_body_new(mut_view(arena));
    let l_ret = add_loc(unsafe { mut_view(*body) }, mut_view(arena), t_i32, MIR_LOCAL_RETURN);
    let l_arr = add_loc(unsafe { mut_view(*body) }, mut_view(arena), t_arr, MIR_LOCAL_USER);
    let l_idx = add_loc(unsafe { mut_view(*body) }, mut_view(arena), t_usize, MIR_LOCAL_USER);

    let bb0 = add_bb_ptr(unsafe { mut_view(*body) }, mut_view(arena));
    let op_10 = op_const_int(mut_view(arena), t_i32, 10u64);
    let op_20 = op_const_int(mut_view(arena), t_i32, 20u64);
    let op_30 = op_const_int(mut_view(arena), t_i32, 30u64);
    let op_idx3 = op_const_int(mut_view(arena), t_usize, 3u64);
    emit_agg3(
        bb0,
        mut_view(arena),
        mir_local_place(l_arr),
        op_10,
        op_20,
        op_30
    );
    emit_use(bb0, mut_view(arena), mir_local_place(l_idx), op_idx3);

    // Read a[3] (out of bounds for [3]i32)
    let pl_idx = place_index(mut_view(arena), mir_local_place(l_arr), l_idx);
    let op_pl_idx = op_place(mut_view(arena), pl_idx);
    emit_use(bb0, mut_view(arena), mir_local_place(l_ret), op_pl_idx);
    term_return(bb0, mut_view(arena));

    let mut mir_map = MirBodyMap {
        entries: 0 as *mut MirBodyEntry,
        len: 0,
        cap: 0,
    };
    mir_body_map_init(mut_view(mir_map));
    mir_body_map_insert(mut_view(mir_map), fn_main as *const HirItem, 3u32, body);

    let sink_ptr = alloc_init_sink();
    let mut out_buf = diag_buf_new();
    let mut panic_sv = StrView { ptr: 0 as *const u8, len: 0 };

    let code = run_test_interp(
        fn_main,
        thir_ptr,
        view(hir),
        str_in,
        sink_ptr,
        100000,
        64,
        map_mut_ptr(mut_view(mir_map)),
        mut_view(out_buf),
        mut_view(panic_sv)
    );

    qa_check(code == 101);
    qa_check(panic_sv.len > 0);

    free_panic_sv(mut_view(panic_sv));
    diag_buf_free(mut_view(out_buf));
    free_dealloc_sink(sink_ptr);
    mir_body_map_free(mut_view(mir_map));
    free_dealloc_thir(thir_ptr);
    free_dealloc_interner(str_in);
    arena_destroy(mut_view(arena));
}

// =================================================================================================
// 4. Unsafe Raw Pointer UB (exit_code == 125, AX_UNSAFE_INTERP_UB)
// =================================================================================================

fn test_unsafe_raw_ptr_ub() {
    let mut arena = arena_new();
    let str_in = alloc_init_interner();
    let thir_ptr = alloc_init_thir();

    let t_i32 = unsafe { (*thir_ptr).interner.t_i32.v };
    let t_usize = unsafe { (*thir_ptr).interner.t_usize.v };
    let t_ptr_i32 = intern_ptr_ty(unsafe { mut_view((*thir_ptr).interner) }, TypeId { v: t_i32 }, false).v;

    let fn_main = make_fn_item(
        mut_view(arena),
        unsafe { mut_view(*str_in) },
        unsafe { mut_view(*thir_ptr) },
        0,
        4,
        4u32,
        0 as *mut TypeId,
        0,
        t_i32,
        0u32
    );
    let hir = HirFile { items: fn_main };

    let body = mir_body_new(mut_view(arena));
    let l_ret = add_loc(unsafe { mut_view(*body) }, mut_view(arena), t_i32, MIR_LOCAL_RETURN);
    let l_ptr = add_loc(unsafe { mut_view(*body) }, mut_view(arena), t_ptr_i32, MIR_LOCAL_TEMP);

    let bb0 = add_bb_ptr(unsafe { mut_view(*body) }, mut_view(arena));
    let op_4660 = op_const_int(mut_view(arena), t_usize, 4660u64);
    let op_0 = op_const_int(mut_view(arena), t_i32, 0u64);
    // Cast non-zero integer `4660usize` to `*const i32` -> UB (`usize as *T` with non-zero integer)
    emit_cast(
        bb0,
        mut_view(arena),
        mir_local_place(l_ptr),
        MIR_CAST_INT_TO_PTR,
        op_4660,
        t_ptr_i32
    );
    emit_use(bb0, mut_view(arena), mir_local_place(l_ret), op_0);
    term_return(bb0, mut_view(arena));

    let mut mir_map = MirBodyMap {
        entries: 0 as *mut MirBodyEntry,
        len: 0,
        cap: 0,
    };
    mir_body_map_init(mut_view(mir_map));
    mir_body_map_insert(mut_view(mir_map), fn_main as *const HirItem, 4u32, body);

    let sink_ptr = alloc_init_sink();
    let mut out_buf = diag_buf_new();
    let mut panic_sv = StrView { ptr: 0 as *const u8, len: 0 };

    let code = run_test_interp(
        fn_main,
        thir_ptr,
        view(hir),
        str_in,
        sink_ptr,
        100000,
        64,
        map_mut_ptr(mut_view(mir_map)),
        mut_view(out_buf),
        mut_view(panic_sv)
    );

    qa_check(code == 125);
    qa_check(unsafe { (*sink_ptr).errors > 0 });
    qa_check(unsafe { (*(*sink_ptr).diags).code.v == AX_UNSAFE_INTERP_UB });

    free_panic_sv(mut_view(panic_sv));
    diag_buf_free(mut_view(out_buf));
    free_dealloc_sink(sink_ptr);
    mir_body_map_free(mut_view(mir_map));
    free_dealloc_thir(thir_ptr);
    free_dealloc_interner(str_in);
    arena_destroy(mut_view(arena));
}

