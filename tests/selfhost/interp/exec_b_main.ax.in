// =================================================================================================
// 6. Call Depth Limit Exceeded (exit_code == 124, AX_DRIVER_INTERP_STACK_LIMIT)
// =================================================================================================

fn test_stack_limit_exceeded() {
    let mut arena = arena_new();
    let str_in = alloc_init_interner();
    let thir_ptr = alloc_init_thir();

    let t_i32 = unsafe { (*thir_ptr).interner.t_i32.v };

    let param_tys = arena_alloc_raw(mut_view(arena), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
    unsafe {
        (*param_tys).v = t_i32;
    }

    let fn_inf = make_fn_item(
        mut_view(arena),
        unsafe { mut_view(*str_in) },
        unsafe { mut_view(*thir_ptr) },
        4,
        3,
        60u32,
        param_tys,
        1,
        t_i32,
        0u32
    );
    let fn_main = make_fn_item(
        mut_view(arena),
        unsafe { mut_view(*str_in) },
        unsafe { mut_view(*thir_ptr) },
        0,
        4,
        61u32,
        0 as *mut TypeId,
        0,
        t_i32,
        0u32
    );
    unsafe {
        (*fn_inf).next = fn_main;
    }
    let hir = HirFile { items: fn_inf };
    let t_fn_inf = intern_fn_ty(unsafe { mut_view((*thir_ptr).interner) }, false, StrId { v: 0u32 }, param_tys, 1, TypeId { v: t_i32 }).v;

    // inf(x: i32) -> i32 { inf(x + 1) }
    let inf_body = mir_body_new(mut_view(arena));
    let l_inf_ret = add_loc(unsafe { mut_view(*inf_body) }, mut_view(arena), t_i32, MIR_LOCAL_RETURN);
    let l_inf_x = add_loc(unsafe { mut_view(*inf_body) }, mut_view(arena), t_i32, MIR_LOCAL_ARG);
    let l_inf_next = add_loc(unsafe { mut_view(*inf_body) }, mut_view(arena), t_i32, MIR_LOCAL_TEMP);

    let inf_bb0 = add_bb_ptr(unsafe { mut_view(*inf_body) }, mut_view(arena));
    let inf_bb1 = add_bb_ptr(unsafe { mut_view(*inf_body) }, mut_view(arena));
    let op_inf_x = op_copy_local(mut_view(arena), l_inf_x);
    let op_inf_1 = op_const_int(mut_view(arena), t_i32, 1u64);
    emit_binop(
        inf_bb0,
        mut_view(arena),
        mir_local_place(l_inf_next),
        MIR_BINOP_ADD,
        op_inf_x,
        op_inf_1
    );
    let inf_args = op_copy_local(mut_view(arena), l_inf_next);
    let op_fn60 = op_fn_sym(mut_view(arena), t_fn_inf, 60u32);
    term_call(
        inf_bb0,
        mut_view(arena),
        op_fn60,
        inf_args,
        1,
        mir_local_place(l_inf_ret),
        true,
        1u32
    );
    term_return(inf_bb1, mut_view(arena));

    // main() -> i32 { inf(0) }
    let main_body = mir_body_new(mut_view(arena));
    let l_main_ret = add_loc(unsafe { mut_view(*main_body) }, mut_view(arena), t_i32, MIR_LOCAL_RETURN);
    let m_bb0 = add_bb_ptr(unsafe { mut_view(*main_body) }, mut_view(arena));
    let m_bb1 = add_bb_ptr(unsafe { mut_view(*main_body) }, mut_view(arena));
    let m_args = op_const_int(mut_view(arena), t_i32, 0u64);
    let op_fn60_m = op_fn_sym(mut_view(arena), t_fn_inf, 60u32);
    term_call(
        m_bb0,
        mut_view(arena),
        op_fn60_m,
        m_args,
        1,
        mir_local_place(l_main_ret),
        true,
        1u32
    );
    term_return(m_bb1, mut_view(arena));

    let mut mir_map = MirBodyMap {
        entries: 0 as *mut MirBodyEntry,
        len: 0,
        cap: 0,
    };
    mir_body_map_init(mut_view(mir_map));
    mir_body_map_insert(mut_view(mir_map), fn_inf as *const HirItem, 60u32, inf_body);
    mir_body_map_insert(mut_view(mir_map), fn_main as *const HirItem, 61u32, main_body);

    let sink_ptr = alloc_init_sink();
    let mut out_buf = diag_buf_new();
    let mut panic_sv = StrView { ptr: 0 as *const u8, len: 0 };

    let code = run_test_interp(
        fn_main,
        thir_ptr,
        view(hir),
        str_in,
        sink_ptr,
        100000,
        8,
        map_mut_ptr(mut_view(mir_map)),
        mut_view(out_buf),
        mut_view(panic_sv)
    );

    qa_check(code == 124);
    qa_check(unsafe { (*sink_ptr).errors > 0 });
    qa_check(unsafe { (*(*sink_ptr).diags).code.v == AX_DRIVER_INTERP_STACK_LIMIT });

    free_panic_sv(mut_view(panic_sv));
    diag_buf_free(mut_view(out_buf));
    free_dealloc_sink(sink_ptr);
    mir_body_map_free(mut_view(mir_map));
    free_dealloc_thir(thir_ptr);
    free_dealloc_interner(str_in);
    arena_destroy(mut_view(arena));
}

// =================================================================================================
// 7. Non-Whitelisted FFI Call (exit_code == 1, AX_FFI_NOT_IN_ORACLE)
// =================================================================================================

fn test_ffi_not_in_oracle() {
    let mut arena = arena_new();
    let str_in = alloc_init_interner();
    let thir_ptr = alloc_init_thir();

    let t_i32 = unsafe { (*thir_ptr).interner.t_i32.v };
    let abi_c = intern_test_name(mut_view(arena), unsafe { mut_view(*str_in) }, 7, 1).v;

    let param_tys = arena_alloc_raw(mut_view(arena), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
    unsafe {
        (*param_tys).v = t_i32;
    }

    let fn_foreign = make_fn_item(
        mut_view(arena),
        unsafe { mut_view(*str_in) },
        unsafe { mut_view(*thir_ptr) },
        8,
        10,
        70u32,
        param_tys,
        1,
        t_i32,
        abi_c
    );
    let fn_main = make_fn_item(
        mut_view(arena),
        unsafe { mut_view(*str_in) },
        unsafe { mut_view(*thir_ptr) },
        0,
        4,
        71u32,
        0 as *mut TypeId,
        0,
        t_i32,
        0u32
    );
    unsafe {
        (*fn_foreign).next = fn_main;
    }
    let hir = HirFile { items: fn_foreign };
    let t_fn_foreign = intern_fn_ty(unsafe { mut_view((*thir_ptr).interner) }, false, StrId { v: abi_c }, param_tys, 1, TypeId { v: t_i32 }).v;

    // main() -> i32 { foreign_fn(10) }
    let main_body = mir_body_new(mut_view(arena));
    let l_main_ret = add_loc(unsafe { mut_view(*main_body) }, mut_view(arena), t_i32, MIR_LOCAL_RETURN);
    let m_bb0 = add_bb_ptr(unsafe { mut_view(*main_body) }, mut_view(arena));
    let m_bb1 = add_bb_ptr(unsafe { mut_view(*main_body) }, mut_view(arena));
    let m_args = op_const_int(mut_view(arena), t_i32, 10u64);
    let op_fn70 = op_fn_sym(mut_view(arena), t_fn_foreign, 70u32);
    term_call(
        m_bb0,
        mut_view(arena),
        op_fn70,
        m_args,
        1,
        mir_local_place(l_main_ret),
        true,
        1u32
    );
    term_return(m_bb1, mut_view(arena));

    let mut mir_map = MirBodyMap {
        entries: 0 as *mut MirBodyEntry,
        len: 0,
        cap: 0,
    };
    mir_body_map_init(mut_view(mir_map));
    mir_body_map_insert(mut_view(mir_map), fn_main as *const HirItem, 71u32, main_body);

    let sink_ptr = alloc_init_sink();
    let mut out_buf = diag_buf_new();
    let mut panic_sv = StrView { ptr: 0 as *const u8, len: 0 };

    let code = run_test_interp(
        fn_main,
        thir_ptr,
        view(hir),
        str_in,
        sink_ptr,
        100000,
        64,
        map_mut_ptr(mut_view(mir_map)),
        mut_view(out_buf),
        mut_view(panic_sv)
    );

    qa_check(code == 1);
    qa_check(unsafe { (*sink_ptr).errors > 0 });
    qa_check(unsafe { (*(*sink_ptr).diags).code.v == AX_FFI_NOT_IN_ORACLE });

    free_panic_sv(mut_view(panic_sv));
    diag_buf_free(mut_view(out_buf));
    free_dealloc_sink(sink_ptr);
    mir_body_map_free(mut_view(mir_map));
    free_dealloc_thir(thir_ptr);
    free_dealloc_interner(str_in);
    arena_destroy(mut_view(arena));
}

// =================================================================================================
// 8. Comptime Constant Evaluation (interp_eval_const_expr_into)
// =================================================================================================

fn make_int_lit_expr(arena: mut_view<Arena>, thir: mut_view<Thir>, val: u64, ty_v: u32) -> *mut HirExpr {
    let e: *mut HirExpr = hir_alloc_expr(arena, HIR_EXPR_LITERAL, qa_zero_span());
    unsafe {
        (*e).literal.kind = TOK_INT;
        (*e).literal.int_val = val;
    }
    thir_set_expr_type(thir, e as *const HirExpr, TypeId { v: ty_v });
    e
}

fn make_bin_expr(
    arena: mut_view<Arena>,
    thir: mut_view<Thir>,
    op: u8,
    lhs: *mut HirExpr,
    rhs: *mut HirExpr,
    ty_v: u32
) -> *mut HirExpr {
    let e: *mut HirExpr = hir_alloc_expr(arena, HIR_EXPR_BINARY, qa_zero_span());
    unsafe {
        (*e).op = op;
        (*e).left = lhs;
        (*e).right = rhs;
    }
    thir_set_expr_type(thir, e as *const HirExpr, TypeId { v: ty_v });
    e
}

fn alloc_zero_const_eval_result(arena: mut_view<Arena>) -> *mut ConstEvalResult {
    let p = arena_alloc_raw(arena, size_of<ConstEvalResult>(), align_of<ConstEvalResult>()) as *mut ConstEvalResult;
    unsafe {
        ptr_write_bytes<u8>(p as *mut u8, 0u8, size_of<ConstEvalResult>());
    }
    p
}

fn test_comptime_const_eval() {
    let mut arena = arena_new();
    let str_in = alloc_init_interner();
    let thir_ptr = alloc_init_thir();

    let t_i8 = unsafe { (*thir_ptr).interner.t_i8.v };
    let t_i32 = unsafe { (*thir_ptr).interner.t_i32.v };

    let tup_fields = arena_alloc_raw(mut_view(arena), mir_mul_usize(2, size_of<TypeId>()), align_of<TypeId>()) as *mut TypeId;
    unsafe {
        (*typeid_at(tup_fields, 0)).v = t_i32;
        (*typeid_at(tup_fields, 1)).v = t_i32;
    }
    let t_tup = intern_tuple_ty(unsafe { mut_view((*thir_ptr).interner) }, tup_fields, 2).v;

    let hir = HirFile { items: 0 as *mut HirItem };
    let sink_ptr = alloc_init_sink();

    // 8a. Scalar comptime expression: (10 + 20) * 3 - 5 == 85
    let e_10 = make_int_lit_expr(mut_view(arena), unsafe { mut_view(*thir_ptr) }, 10u64, t_i32);
    let e_20 = make_int_lit_expr(mut_view(arena), unsafe { mut_view(*thir_ptr) }, 20u64, t_i32);
    let e_add = make_bin_expr(mut_view(arena), unsafe { mut_view(*thir_ptr) }, BINOP_ADD, e_10, e_20, t_i32);
    let e_3 = make_int_lit_expr(mut_view(arena), unsafe { mut_view(*thir_ptr) }, 3u64, t_i32);
    let e_mul = make_bin_expr(mut_view(arena), unsafe { mut_view(*thir_ptr) }, BINOP_MUL, e_add, e_3, t_i32);
    let e_5 = make_int_lit_expr(mut_view(arena), unsafe { mut_view(*thir_ptr) }, 5u64, t_i32);
    let e_sub = make_bin_expr(mut_view(arena), unsafe { mut_view(*thir_ptr) }, BINOP_SUB, e_mul, e_5, t_i32);

    let res1 = alloc_zero_const_eval_result(mut_view(arena));
    run_test_const_eval(view(hir), str_in, sink_ptr, thir_ptr, e_sub, t_i32, unsafe { mut_view(*res1) });
    qa_check(unsafe { (*res1).ok });
    qa_check(unsafe { (*res1).val.kind == CONST_INT });
    qa_check(unsafe { (*res1).val.int_val == 85u64 });

    // 8b. Aggregate comptime expression: (11 + 22, 33 * 2) == (33, 66)
    let e_11 = make_int_lit_expr(mut_view(arena), unsafe { mut_view(*thir_ptr) }, 11u64, t_i32);
    let e_22 = make_int_lit_expr(mut_view(arena), unsafe { mut_view(*thir_ptr) }, 22u64, t_i32);
    let e_t0 = make_bin_expr(mut_view(arena), unsafe { mut_view(*thir_ptr) }, BINOP_ADD, e_11, e_22, t_i32);
    let e_33 = make_int_lit_expr(mut_view(arena), unsafe { mut_view(*thir_ptr) }, 33u64, t_i32);
    let e_2 = make_int_lit_expr(mut_view(arena), unsafe { mut_view(*thir_ptr) }, 2u64, t_i32);
    let e_t1 = make_bin_expr(mut_view(arena), unsafe { mut_view(*thir_ptr) }, BINOP_MUL, e_33, e_2, t_i32);
    unsafe {
        (*e_t0).next = e_t1;
    }
    let e_tup: *mut HirExpr = hir_alloc_expr(mut_view(arena), HIR_EXPR_TUPLE, qa_zero_span());
    unsafe {
        (*e_tup).elems = e_t0;
    }
    thir_set_expr_type(unsafe { mut_view(*thir_ptr) }, e_tup as *const HirExpr, TypeId { v: t_tup });

    let res2 = alloc_zero_const_eval_result(mut_view(arena));
    run_test_const_eval(view(hir), str_in, sink_ptr, thir_ptr, e_tup, t_tup, unsafe { mut_view(*res2) });
    qa_check(unsafe { (*res2).ok });
    qa_check(unsafe { (*res2).val.kind == CONST_AGGREGATE });
    qa_check(unsafe { (*res2).val.agg_size == 8 });
    let agg_ptr = unsafe { (*res2).val.agg_data };
    let f0 = unsafe { *(agg_ptr as *const i32) };
    let f1 = unsafe { *((agg_ptr + 4) as *const i32) };
    qa_check(f0 == 33);
    qa_check(f1 == 66);

    // 8c. Comptime division by zero: 10 / 0 -> AX_CONST_DIV_ZERO
    let e_div0_lhs = make_int_lit_expr(mut_view(arena), unsafe { mut_view(*thir_ptr) }, 10u64, t_i32);
    let e_div0_rhs = make_int_lit_expr(mut_view(arena), unsafe { mut_view(*thir_ptr) }, 0u64, t_i32);
    let e_div0 = make_bin_expr(mut_view(arena), unsafe { mut_view(*thir_ptr) }, BINOP_DIV, e_div0_lhs, e_div0_rhs, t_i32);

    let res3 = alloc_zero_const_eval_result(mut_view(arena));
    run_test_const_eval(view(hir), str_in, sink_ptr, thir_ptr, e_div0, t_i32, unsafe { mut_view(*res3) });
    qa_check(unsafe { !(*res3).ok });
    qa_check(unsafe { (*res3).err_code == (AX_CONST_DIV_ZERO as u16) });

    // 8d. Comptime signed overflow: 120i8 + 20i8 -> AX_CONST_OVERFLOW
    let e_ov_lhs = make_int_lit_expr(mut_view(arena), unsafe { mut_view(*thir_ptr) }, 120u64, t_i8);
    let e_ov_rhs = make_int_lit_expr(mut_view(arena), unsafe { mut_view(*thir_ptr) }, 20u64, t_i8);
    let e_ov = make_bin_expr(mut_view(arena), unsafe { mut_view(*thir_ptr) }, BINOP_ADD, e_ov_lhs, e_ov_rhs, t_i8);

    let res4 = alloc_zero_const_eval_result(mut_view(arena));
    run_test_const_eval(view(hir), str_in, sink_ptr, thir_ptr, e_ov, t_i8, unsafe { mut_view(*res4) });
    qa_check(unsafe { !(*res4).ok });
    qa_check(unsafe { (*res4).err_code == (AX_CONST_OVERFLOW as u16) });

    // 8e. Comptime step limit exceeded: max_steps=2 on multi-step expression -> AX_CONST_EVAL_LIMIT
    let res5 = alloc_zero_const_eval_result(mut_view(arena));
    let cctx_lim = InterpConstEvalCtx {
        hir: unsafe { address_of(hir) },
        interner: str_in,
        rmap: 0 as *const ResolveMap,
        ast: 0 as *const Ast,
        db: 0 as *const SourceDatabase,
        sink: sink_ptr,
    };
    let tight_limits = ConstLimits {
        max_steps: 2,
        max_call_depth: 16,
    };
    interp_eval_const_expr_into(view(cctx_lim), thir_ptr, e_sub, TypeId { v: t_i32 }, tight_limits, unsafe { mut_view(*res5) });
    qa_check(unsafe { !(*res5).ok });
    qa_check(unsafe { (*res5).err_code == (AX_CONST_EVAL_LIMIT as u16) });

    free_dealloc_sink(sink_ptr);
    free_dealloc_thir(thir_ptr);
    free_dealloc_interner(str_in);
    arena_destroy(mut_view(arena));
}

// =================================================================================================
// 9. Sub-Slice Projections & Shift Out-of-Range Panic
// =================================================================================================

fn place_subslice(arena: mut_view<Arena>, base: MirPlace, from_loc: u32, to_loc: u32) -> MirPlace {
    let proj = MirProjection {
        kind: MIR_PROJ_SUB_SLICE,
        field_idx: 0u32,
        index_local: MirLocalId { v: 0u32 },
        from_local: MirLocalId { v: from_loc },
        to_local: MirLocalId { v: to_loc },
        has_from: true,
        has_to: true,
        variant_idx: 0u32,
    };
    let mut dst = mir_local_place(0u32);
    mir_place_append_proj(arena, view(base), view(proj), mut_view(dst));
    dst
}

fn test_subslice_and_shift_overflow_edge_cases() {
    let mut arena = arena_new();
    let str_in = alloc_init_interner();
    let thir_ptr = alloc_init_thir();

    let t_i32 = unsafe { (*thir_ptr).interner.t_i32.v };
    let t_usize = unsafe { (*thir_ptr).interner.t_usize.v };
    let t_arr = intern_array_ty(unsafe { mut_view((*thir_ptr).interner) }, TypeId { v: t_i32 }, 3u64).v;

    let fn_main = make_fn_item(
        mut_view(arena),
        unsafe { mut_view(*str_in) },
        unsafe { mut_view(*thir_ptr) },
        0,
        4,
        90u32,
        0 as *mut TypeId,
        0,
        t_i32,
        0u32
    );
    let hir = HirFile { items: fn_main };

    // 9a. Valid sub-slice: arr = [10, 20, 30];arr[1..3][0] + arr[1..3][1] == 20 + 30 == 50
    let body = mir_body_new(mut_view(arena));
    let l_ret = add_loc(unsafe { mut_view(*body) }, mut_view(arena), t_i32, MIR_LOCAL_RETURN);
    let l_arr = add_loc(unsafe { mut_view(*body) }, mut_view(arena), t_arr, MIR_LOCAL_USER);
    let l_i0 = add_loc(unsafe { mut_view(*body) }, mut_view(arena), t_usize, MIR_LOCAL_TEMP);
    let l_i1 = add_loc(unsafe { mut_view(*body) }, mut_view(arena), t_usize, MIR_LOCAL_TEMP);
    let l_i3 = add_loc(unsafe { mut_view(*body) }, mut_view(arena), t_usize, MIR_LOCAL_TEMP);

    let bb0 = add_bb_ptr(unsafe { mut_view(*body) }, mut_view(arena));
    let op_10 = op_const_int(mut_view(arena), t_i32, 10u64);
    let op_20 = op_const_int(mut_view(arena), t_i32, 20u64);
    let op_30 = op_const_int(mut_view(arena), t_i32, 30u64);
    emit_agg3(bb0, mut_view(arena), mir_local_place(l_arr), op_10, op_20, op_30);
    let op_u0 = op_const_int(mut_view(arena), t_usize, 0u64);
    let op_u1 = op_const_int(mut_view(arena), t_usize, 1u64);
    let op_u3 = op_const_int(mut_view(arena), t_usize, 3u64);
    emit_use(bb0, mut_view(arena), mir_local_place(l_i0), op_u0);
    emit_use(bb0, mut_view(arena), mir_local_place(l_i1), op_u1);
    emit_use(bb0, mut_view(arena), mir_local_place(l_i3), op_u3);

    let pl_sub = place_subslice(mut_view(arena), mir_local_place(l_arr), l_i1, l_i3);
    let pl_sub0 = place_index(mut_view(arena), pl_sub, l_i0);
    let pl_sub_b = place_subslice(mut_view(arena), mir_local_place(l_arr), l_i1, l_i3);
    let pl_sub1 = place_index(mut_view(arena), pl_sub_b, l_i1);
    let op_sub0 = op_place(mut_view(arena), pl_sub0);
    let op_sub1 = op_place(mut_view(arena), pl_sub1);
    emit_binop(bb0, mut_view(arena), mir_local_place(l_ret), MIR_BINOP_ADD, op_sub0, op_sub1);
    term_return(bb0, mut_view(arena));

    let mut mir_map = MirBodyMap {
        entries: 0 as *mut MirBodyEntry,
        len: 0,
        cap: 0,
    };
    mir_body_map_init(mut_view(mir_map));
    mir_body_map_insert(mut_view(mir_map), fn_main as *const HirItem, 90u32, body);

    let sink_ptr = alloc_init_sink();
    let mut out_buf = diag_buf_new();
    let mut panic_sv = StrView { ptr: 0 as *const u8, len: 0 };

    let code = run_test_interp(
        fn_main,
        thir_ptr,
        view(hir),
        str_in,
        sink_ptr,
        100000,
        64,
        map_mut_ptr(mut_view(mir_map)),
        mut_view(out_buf),
        mut_view(panic_sv)
    );
    qa_check(code == 50);
    qa_check(panic_sv.len == 0);
    free_panic_sv(mut_view(panic_sv));

    // 9b. Out-of-bounds sub-slice (start > end: arr[3..1]) -> panic (101)
    let body_oob = mir_body_new(mut_view(arena));
    let l_ret2 = add_loc(unsafe { mut_view(*body_oob) }, mut_view(arena), t_i32, MIR_LOCAL_RETURN);
    let l_arr2 = add_loc(unsafe { mut_view(*body_oob) }, mut_view(arena), t_arr, MIR_LOCAL_USER);
    let l_from = add_loc(unsafe { mut_view(*body_oob) }, mut_view(arena), t_usize, MIR_LOCAL_TEMP);
    let l_to = add_loc(unsafe { mut_view(*body_oob) }, mut_view(arena), t_usize, MIR_LOCAL_TEMP);
    let bb_oob = add_bb_ptr(unsafe { mut_view(*body_oob) }, mut_view(arena));
    let op2_10 = op_const_int(mut_view(arena), t_i32, 10u64);
    let op2_20 = op_const_int(mut_view(arena), t_i32, 20u64);
    let op2_30 = op_const_int(mut_view(arena), t_i32, 30u64);
    emit_agg3(bb_oob, mut_view(arena), mir_local_place(l_arr2), op2_10, op2_20, op2_30);
    let op_from3 = op_const_int(mut_view(arena), t_usize, 3u64);
    let op_to1 = op_const_int(mut_view(arena), t_usize, 1u64);
    emit_use(bb_oob, mut_view(arena), mir_local_place(l_from), op_from3);
    emit_use(bb_oob, mut_view(arena), mir_local_place(l_to), op_to1);
    let pl_bad_sub = place_subslice(mut_view(arena), mir_local_place(l_arr2), l_from, l_to);
    let pl_bad_elem = place_index(mut_view(arena), pl_bad_sub, l_to);
    let op_bad_elem = op_place(mut_view(arena), pl_bad_elem);
    emit_use(bb_oob, mut_view(arena), mir_local_place(l_ret2), op_bad_elem);
    term_return(bb_oob, mut_view(arena));

    mir_body_map_insert(mut_view(mir_map), fn_main as *const HirItem, 90u32, body_oob);
    let code_oob = run_test_interp(
        fn_main,
        thir_ptr,
        view(hir),
        str_in,
        sink_ptr,
        100000,
        64,
        map_mut_ptr(mut_view(mir_map)),
        mut_view(out_buf),
        mut_view(panic_sv)
    );
    qa_check(code_oob == 101);
    qa_check(panic_sv.len > 0);
    free_panic_sv(mut_view(panic_sv));

    // 9c. Shift amount out of range (1i32 << 32i32) -> panic (101)
    let body_shl = mir_body_new(mut_view(arena));
    let l_ret3 = add_loc(unsafe { mut_view(*body_shl) }, mut_view(arena), t_i32, MIR_LOCAL_RETURN);
    let bb_shl = add_bb_ptr(unsafe { mut_view(*body_shl) }, mut_view(arena));
    let op_shl_lhs = op_const_int(mut_view(arena), t_i32, 1u64);
    let op_shl_rhs = op_const_int(mut_view(arena), t_i32, 32u64);
    emit_binop(bb_shl, mut_view(arena), mir_local_place(l_ret3), MIR_BINOP_SHL, op_shl_lhs, op_shl_rhs);
    term_return(bb_shl, mut_view(arena));

    mir_body_map_insert(mut_view(mir_map), fn_main as *const HirItem, 90u32, body_shl);
    let code_shl = run_test_interp(
        fn_main,
        thir_ptr,
        view(hir),
        str_in,
        sink_ptr,
        100000,
        64,
        map_mut_ptr(mut_view(mir_map)),
        mut_view(out_buf),
        mut_view(panic_sv)
    );
    qa_check(code_shl == 101);
    qa_check(panic_sv.len > 0);
    free_panic_sv(mut_view(panic_sv));

    diag_buf_free(mut_view(out_buf));
    free_dealloc_sink(sink_ptr);
    mir_body_map_free(mut_view(mir_map));
    free_dealloc_thir(thir_ptr);
    free_dealloc_interner(str_in);
    arena_destroy(mut_view(arena));
}

pub fn main() -> i32 {
    test_div_by_zero_panic();
    test_signed_overflow_panic();
    test_bounds_check_panic();
    test_unsafe_raw_ptr_ub();
    test_step_limit_exceeded();
    test_stack_limit_exceeded();
    test_ffi_not_in_oracle();
    test_comptime_const_eval();
    test_subslice_and_shift_overflow_edge_cases();
    print("ALL INTERP EXEC B TESTS PASSED\n");
    0
}
