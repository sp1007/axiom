}
fn mb_push_loop(
    b: mut_view<MirBuilder>,
    label: StrId,
    break_bb: MirBbId,
    continue_bb: MirBbId,
    dest: view<MirPlace>,
    has_dest: bool
) {
    if b.loop_depth >= b.loop_cap {
        let new_cap: usize = if b.loop_cap == 0 {
            8
        } else {
            b.loop_cap + b.loop_cap
        };
        let new_bytes = mir_mul_usize(new_cap, size_of<MirLoopScope>());
        let new_arr = unsafe {
            arena_alloc_raw(mut_view(*b.arena), new_bytes, align_of<MirLoopScope>()) as *mut MirLoopScope
        };
        if b.loop_depth > 0 && (b.loop_stack as usize) != 0 {
            let old_bytes = mir_mul_usize(b.loop_depth, size_of<MirLoopScope>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(b.loop_stack as *const u8, new_arr as *mut u8, old_bytes);
            }
        }
        b.loop_stack = new_arr;
        b.loop_cap = new_cap;
    }
    let ls = unsafe {
        mb_loop_scope_at(b.loop_stack, b.loop_depth)
    };
    unsafe {
        (*ls).label.v = label.v;
        (*ls).break_bb.v = break_bb.v;
        (*ls).continue_bb.v = continue_bb.v;
        mir_copy_place(mut_view((*ls).dest), dest);
        (*ls).has_dest = has_dest;
        (*ls).scope_depth = b.scope_depth;
        (*ls).drop_scope = b.current_drops;
    }
    b.loop_depth = b.loop_depth + 1;
}

fn mb_find_loop(b: view<MirBuilder>, label: StrId) -> *mut MirLoopScope {
    if b.loop_depth == 0 || (b.loop_stack as usize) == 0 {
        return 0 as *mut MirLoopScope;
    }
    if label.v != 0u32 {
        let mut i = b.loop_depth;
        while (i > 0) {
            i = i - 1;
            let ls = unsafe {
                mb_loop_scope_at(b.loop_stack, i)
            };
            if (unsafe { (*ls).label.v }) == label.v {
                return ls;
            }
        }
    }
    unsafe { mb_loop_scope_at(b.loop_stack, b.loop_depth - 1) }
}

pub fn mir_build_expr(
    b: mut_view<MirBuilder>,
    expr: *mut HirExpr,
    dest: mut_view<MirPlace>,
    has_dest: bool
) {
    if (expr as usize) == 0 || b.is_diverged {
        return;
    }
    let sp = Span {
        file: FileId { v: unsafe { (*expr).span.file.v } },
        start: unsafe { (*expr).span.start },
        end: unsafe { (*expr).span.end },
    };
    let ek = unsafe {
        (*expr).kind
    };
    let e_ty = mb_expr_ty(mut_view(*b), expr);

    // Check if expression is an enum variant constructor in THIR
    let vp = unsafe {
        thir_get_expr_variant(view(*b.thir), expr as *const HirExpr)
    };
    if (vp as usize) != 0 {
        let v_idx = unsafe {
            *vp
        };
        let mut arg_head: *mut HirExpr = 0 as *mut HirExpr;
        if ek == HIR_EXPR_CALL {
            arg_head = unsafe {
                (*expr).args
            };
        } else if ek == HIR_EXPR_METHOD_CALL {
            arg_head = unsafe {
                (*expr).args
            };
        }
        let mut f_count: usize = 0;
        let mut cur_a = arg_head;
        while ((cur_a as usize) != 0) {
            f_count = f_count + 1;
            cur_a = unsafe {
                (*cur_a).next
            };
        }
        let mut ops: *mut MirOperand = 0 as *mut MirOperand;
        if f_count > 0 {
            let bytes = mir_mul_usize(f_count, size_of<MirOperand>());
            ops = unsafe {
                arena_alloc_raw(mut_view(*b.arena), bytes, align_of<MirOperand>()) as *mut MirOperand
            };
            let mut idx: usize = 0;
            cur_a = arg_head;
            while ((cur_a as usize) != 0) {
                let mut op_i = MirOperand {
                    kind: MIR_OP_COPY, location: Span {
                        file: FileId {
                            v: 0u32
                        }, start: 0u32, end: 0u32
                    }, place: MirPlace {
                        local: MirLocalId {
                            v: 0u32
                        }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                    }, constant: MirConst {
                        ty: TypeId {
                            v: 0u32
                        }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                            v: 0u32
                        }
                    }
                };
                mb_build_expr_as_operand(mut_view(*b), cur_a, mut_view(op_i));
                let dst_op = unsafe {
                    mir_op_at(ops, idx)
                };
                unsafe {
                    mir_copy_operand(mut_view(*dst_op), view(op_i));
                }
                idx = idx + 1;
                cur_a = unsafe {
                    (*cur_a).next
                };
            }
        }
        let mut rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
        rv.kind = MIR_RVALUE_AGGREGATE;
        rv.variant_idx = v_idx;
        rv.operands = ops;
        rv.operand_count = f_count;
        mb_emit_assign(mut_view(*b), view(*dest), view(rv), view(sp));
        return;
    }

    if ek == HIR_EXPR_LITERAL || ek == HIR_EXPR_PATH || ek == HIR_EXPR_FIELD || ek == HIR_EXPR_TUPLE_INDEX || ek == HIR_EXPR_INDEX {
        let mut op = MirOperand {
            kind: MIR_OP_COPY, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: 0u32
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: 0u32
                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        mb_build_expr_as_operand(mut_view(*b), expr, mut_view(op));
        if has_dest {
            mb_emit_assign_use(mut_view(*b), view(*dest), view(op), view(sp));
        }
        return;
    }

    if ek == HIR_EXPR_BINARY {
        mb_build_binary_expr(mut_view(*b), expr, dest);
        return;
    }

    if ek == HIR_EXPR_UNARY {
        let uop = unsafe {
            (*expr).op
        };
        if uop == UNOP_DEREF {
            let mut dummy_sl = false;
            let pl = mir_build_lvalue(mut_view(*b), expr, mut_view(dummy_sl));
            let mut op = MirOperand {
                kind: MIR_OP_COPY, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: 0u32
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: 0u32
                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            mb_operand_from_place(view(*b), view(pl), (TypeId {
                v: e_ty.v
            }), mut_view(op));
            if has_dest {
                mb_emit_assign_use(mut_view(*b), view(*dest), view(op), view(sp));
            }
            return;
        }
        let inner_expr: *mut HirExpr = unsafe {
            (*expr).inner
        };
        let mut inner_op = MirOperand {
            kind: MIR_OP_COPY, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: 0u32
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: 0u32
                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        mb_build_expr_as_operand(mut_view(*b), inner_expr, mut_view(inner_op));
        if uop == UNOP_NEG {
            let inner_ty = mb_expr_ty(mut_view(*b), inner_expr);
            let bool_ty = TypeId {
                v: unsafe {
                    (*b.thir).interner.t_bool.v
                }
            };
            let zero_op = MirOperand {
                kind: MIR_OP_CONST, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: 0u32
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: inner_ty.v
                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            let ov_loc = mb_new_temp(mut_view(*b), (TypeId {
                v: bool_ty.v
            }), view(sp));
            let ov_pl = mir_local_place(ov_loc.v);
            let mut ov_rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
            ov_rv.kind = MIR_RVALUE_OVERFLOWS_BINARY_OP;
            ov_rv.bin_op = MIR_BINOP_SUB;
            mir_copy_operand(mut_view(ov_rv.lhs), view(zero_op));
            mir_copy_operand(mut_view(ov_rv.rhs), view(inner_op));
            mb_emit_assign(mut_view(*b), view(ov_pl), view(ov_rv), view(sp));

            let not_ov_loc = mb_new_temp(mut_view(*b), (TypeId {
                v: bool_ty.v
            }), view(sp));
            let not_ov_pl = mir_local_place(not_ov_loc.v);
            let mut not_rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
            not_rv.kind = MIR_RVALUE_UNARY_OP;
            not_rv.un_op = MIR_UNOP_NOT;
            not_rv.use_op = MirOperand {
                kind: MIR_OP_COPY, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: ov_loc.v
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: 0u32
                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            mb_emit_assign(mut_view(*b), view(not_ov_pl), view(not_rv), view(sp));
            let not_ov_op = MirOperand {
                kind: MIR_OP_COPY, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: not_ov_loc.v
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: 0u32
                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            mb_emit_assert(mut_view(*b), view(not_ov_op), true, MB_ASSERT_MSG_ARITH_OV, view(sp));
        }
        let mut rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
        rv.kind = MIR_RVALUE_UNARY_OP;
        rv.un_op = if uop == UNOP_NOT {
            MIR_UNOP_NOT
        } else if uop == UNOP_BITNOT {
            MIR_UNOP_BITNOT
        } else {
            MIR_UNOP_NEG
        };
        mir_copy_operand(mut_view(rv.use_op), view(inner_op));
        mb_emit_assign(mut_view(*b), view(*dest), view(rv), view(sp));
        return;
    }

    if ek == HIR_EXPR_VIEW {
        let mut dummy_sl = false;
        let p = mir_build_lvalue(mut_view(*b), unsafe {
            (*expr).inner
        }, mut_view(dummy_sl));
        let mut rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
        rv.kind = MIR_RVALUE_REF;
        rv.borrow_kind = if unsafe {
            (*expr).is_mut
        } {
            MIR_BORROW_MUT
        } else {
            MIR_BORROW_SHARED
        };
        mir_copy_place(mut_view(rv.place), view(p));
        mb_emit_assign(mut_view(*b), view(*dest), view(rv), view(sp));
        return;
    }

    if ek == HIR_EXPR_CAST {
        let inner_expr: *mut HirExpr = unsafe {
            (*expr).inner
        };
        let mut op = MirOperand {
            kind: MIR_OP_COPY, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: 0u32
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: 0u32
                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        mb_build_expr_as_operand(mut_view(*b), inner_expr, mut_view(op));
        let src_ty = mb_expr_ty(mut_view(*b), inner_expr);
        let st = unsafe {
            type_get(view((*b.thir).interner), (TypeId {
                v: src_ty.v
            }))
        };
        let dt = unsafe {
            type_get(view((*b.thir).interner), (TypeId {
                v: e_ty.v
            }))
        };
        let mut ckind: u8 = MIR_CAST_INT_TO_INT;
        if (st as usize) != 0 && (dt as usize) != 0 {
            let sk = unsafe {
                (*st).kind
            };
            let dk = unsafe {
                (*dt).kind
            };
            if sk == TY_PTR && dk == TY_PTR {
                ckind = MIR_CAST_PTR_TO_PTR;
            } else if sk == TY_PTR && dk != TY_PTR {
                ckind = MIR_CAST_PTR_TO_INT;
            } else if sk != TY_PTR && dk == TY_PTR {
                ckind = MIR_CAST_INT_TO_PTR;
            }
        }
        let mut rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
        rv.kind = MIR_RVALUE_CAST;
        rv.cast_kind = ckind;
        rv.target_ty.v = e_ty.v;
        mir_copy_operand(mut_view(rv.use_op), view(op));
        mb_emit_assign(mut_view(*b), view(*dest), view(rv), view(sp));
        return;
    }

    if ek == HIR_EXPR_TUPLE {
        let mut cnt: usize = 0;
        let mut el: *mut HirExpr = unsafe {
            (*expr).elems
        };
        while ((el as usize) != 0) {
            cnt = cnt + 1;
            el = unsafe {
                (*el).next
            };
        }
        let mut ops: *mut MirOperand = 0 as *mut MirOperand;
        if cnt > 0 {
            let bytes = mir_mul_usize(cnt, size_of<MirOperand>());
            ops = unsafe {
                arena_alloc_raw(mut_view(*b.arena), bytes, align_of<MirOperand>()) as *mut MirOperand
            };
            let mut i: usize = 0;
            el = unsafe {
                (*expr).elems
            };
            while ((el as usize) != 0) {
                let mut op_i = MirOperand {
                    kind: MIR_OP_COPY, location: Span {
                        file: FileId {
                            v: 0u32
                        }, start: 0u32, end: 0u32
                    }, place: MirPlace {
                        local: MirLocalId {
                            v: 0u32
                        }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                    }, constant: MirConst {
                        ty: TypeId {
                            v: 0u32
                        }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                            v: 0u32
                        }
                    }
                };
                mb_build_expr_as_operand(mut_view(*b), el, mut_view(op_i));
                let dst_op = unsafe {
                    mir_op_at(ops, i)
                };
                unsafe {
                    mir_copy_operand(mut_view(*dst_op), view(op_i));
                }
                i = i + 1;
                el = unsafe {
                    (*el).next
                };
            }
        }
        let mut rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
        rv.kind = MIR_RVALUE_AGGREGATE;
        rv.variant_idx = 0u32;
        rv.operands = ops;
        rv.operand_count = cnt;
        mb_emit_assign(mut_view(*b), view(*dest), view(rv), view(sp));
        return;
    }

    if ek == HIR_EXPR_ARRAY {
        let count_expr: *mut HirExpr = unsafe {
            (*expr).count_expr
        };
        if (count_expr as usize) != 0 {
            let mut elem_op = MirOperand {
                kind: MIR_OP_COPY, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: 0u32
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: 0u32
                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            mb_build_expr_as_operand(mut_view(*b), unsafe {
                (*expr).elems
            }, mut_view(elem_op));
            let mut cnt_op = MirOperand {
                kind: MIR_OP_COPY, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: 0u32
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: 0u32
                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            mb_build_expr_as_operand(mut_view(*b), count_expr, mut_view(cnt_op));
            let cnt_op_ptr = unsafe {
                arena_alloc_raw(mut_view(*b.arena), size_of<MirOperand>(), align_of<MirOperand>()) as *mut MirOperand
            };
            unsafe {
                mir_copy_operand(mut_view(*cnt_op_ptr), view(cnt_op));
            }
            let mut rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
            rv.kind = MIR_RVALUE_REPEAT;
            mir_copy_operand(mut_view(rv.use_op), view(elem_op));
            rv.repeat_count = mb_eval_const_int_expr(view(*b), count_expr);
            rv.repeat_count_op = cnt_op_ptr;
            mb_emit_assign(mut_view(*b), view(*dest), view(rv), view(sp));
        } else {
            let mut cnt: usize = 0;
            let mut el: *mut HirExpr = unsafe {
                (*expr).elems
            };
            while ((el as usize) != 0) {
                cnt = cnt + 1;
                el = unsafe {
                    (*el).next
                };
            }
            let mut ops: *mut MirOperand = 0 as *mut MirOperand;
            if cnt > 0 {
                let bytes = mir_mul_usize(cnt, size_of<MirOperand>());
                ops = unsafe {
                    arena_alloc_raw(mut_view(*b.arena), bytes, align_of<MirOperand>()) as *mut MirOperand
                };
                let mut i: usize = 0;
                el = unsafe {
                    (*expr).elems
                };
                while ((el as usize) != 0) {
                    let mut op_i = MirOperand {
                        kind: MIR_OP_COPY, location: Span {
                            file: FileId {
                                v: 0u32
                            }, start: 0u32, end: 0u32
                        }, place: MirPlace {
                            local: MirLocalId {
                                v: 0u32
                            }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                        }, constant: MirConst {
                            ty: TypeId {
                                v: 0u32
                            }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                                v: 0u32
                            }
                        }
                    };
                    mb_build_expr_as_operand(mut_view(*b), el, mut_view(op_i));
                    let dst_op = unsafe {
                        mir_op_at(ops, i)
                    };
                    unsafe {
                        mir_copy_operand(mut_view(*dst_op), view(op_i));
                    }
                    i = i + 1;
                    el = unsafe {
                        (*el).next
                    };
                }
            }
            let mut rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
            rv.kind = MIR_RVALUE_AGGREGATE;
            rv.variant_idx = 0u32;
            rv.operands = ops;
            rv.operand_count = cnt;
            mb_emit_assign(mut_view(*b), view(*dest), view(rv), view(sp));
        }
        return;
    }

    if ek == HIR_EXPR_STRUCT {
        let ax = unsafe {
            type_get(view((*b.thir).interner), (TypeId {
                v: e_ty.v
            }))
        };
        let mut is_enum_struct = false;
        let mut v_idx: u32 = 0u32;
        let mut f_count: usize = 0;
        let mut def_item: *mut HirItem = 0 as *mut HirItem;
        if (ax as usize) != 0 {
            def_item = unsafe {
                ((*ax).def) as *mut HirItem
            };
            if (unsafe { (*ax).kind }) == TY_ENUM {
                is_enum_struct = true;
                let vp2 = unsafe {
                    thir_get_expr_variant(view(*b.thir), expr as *const HirExpr)
                };
                if (vp2 as usize) != 0 {
                    v_idx = unsafe {
                        *vp2
                    };
                }
                if (v_idx as usize) < (unsafe { (*ax).variant_count }) && (unsafe { (*ax).variant_field_counts as usize }) != 0 {
                    f_count = unsafe {
                        *usize_at((*ax).variant_field_counts, v_idx as usize)
                    };
                }
            } else if (unsafe { (*ax).kind }) == TY_STRUCT {
                f_count = unsafe {
                    (*ax).field_count
                };
            }
        }
        if f_count == 0 {
            let mut fi: *mut HirFieldInit = unsafe {
                (*expr).fields
            };
            while ((fi as usize) != 0) {
                f_count = f_count + 1;
                fi = unsafe {
                    (*fi).next
                };
            }
        }
        let mut ops: *mut MirOperand = 0 as *mut MirOperand;
        if f_count > 0 {
            let bytes = mir_mul_usize(f_count, size_of<MirOperand>());
            ops = unsafe {
                arena_alloc_raw(mut_view(*b.arena), bytes, align_of<MirOperand>()) as *mut MirOperand
            };
            let mut i: usize = 0;
            while (i < f_count) {
                let dst_op = unsafe {
                    mir_op_at(ops, i)
                };
                unsafe {
                    *dst_op = MirOperand {
                        kind: MIR_OP_CONST, location: Span {
                            file: FileId {
                                v: 0u32
                            }, start: 0u32, end: 0u32
                        }, place: MirPlace {
                            local: MirLocalId {
                                v: 0u32
                            }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                        }, constant: MirConst {
                            ty: TypeId {
                                v: 0u32
                            }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                                v: 0u32
                            }
                        }
                    };
                }
                i = i + 1;
            }
            let mut fi: *mut HirFieldInit = unsafe {
                (*expr).fields
            };
            let mut pos_idx: usize = 0;
            while ((fi as usize) != 0) {
                let fi_sp = Span {
                    file: FileId { v: unsafe { (*fi).span.file.v } },
                    start: unsafe { (*fi).span.start },
                    end: unsafe { (*fi).span.end },
                };
                let fi_name = StrId {
                    v: unsafe {
                        (*fi).name.v
                    }
                };
                let mut target_idx: usize = pos_idx;
                if (def_item as usize) != 0 {
                    if is_enum_struct {
                        target_idx = mb_find_enum_variant_field_index(view(*b), def_item, v_idx, (StrId {
                            v: fi_name.v
                        }), view(fi_sp)) as usize;
                    } else {
                        target_idx = mb_find_struct_field_index(view(*b), def_item, (StrId {
                            v: fi_name.v
                        }), view(fi_sp)) as usize;
                    }
                }
                if target_idx >= f_count {
                    target_idx = pos_idx;
                }
                if target_idx < f_count {
                    let mut op_f = MirOperand {
                        kind: MIR_OP_COPY, location: Span {
                            file: FileId {
                                v: 0u32
                            }, start: 0u32, end: 0u32
                        }, place: MirPlace {
                            local: MirLocalId {
                                v: 0u32
                            }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                        }, constant: MirConst {
                            ty: TypeId {
                                v: 0u32
                            }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                                v: 0u32
                            }
                        }
                    };
                    mb_build_expr_as_operand(mut_view(*b), unsafe {
                        (*fi).expr
                    }, mut_view(op_f));
                    let dst_op = unsafe {
                        mir_op_at(ops, target_idx)
                    };
                    unsafe {
                        mir_copy_operand(mut_view(*dst_op), view(op_f));
                    }
                }
                pos_idx = pos_idx + 1;
                fi = unsafe {
                    (*fi).next
                };
            }
        }
        let mut rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
        rv.kind = MIR_RVALUE_AGGREGATE;
        rv.variant_idx = v_idx;
        rv.operands = ops;
        rv.operand_count = f_count;
        mb_emit_assign(mut_view(*b), view(*dest), view(rv), view(sp));
        return;
    }

    mb_build_control_or_call_expr(mut_view(*b), expr, mut_view(*dest), has_dest);
}
fn mb_build_control_or_call_expr(
    b: mut_view<MirBuilder>,
    expr: *mut HirExpr,
    dest: mut_view<MirPlace>,
    has_dest: bool
) {
    let sp = Span {
        file: FileId { v: unsafe { (*expr).span.file.v } },
        start: unsafe { (*expr).span.start },
        end: unsafe { (*expr).span.end },
    };
    let ek = unsafe {
        (*expr).kind
    };
    let e_ty = mb_expr_ty(mut_view(*b), expr);

