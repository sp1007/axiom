pub const MIR_CAST_PTR_TO_INT: u8 = 3u8;

pub const MIR_RVALUE_USE: u8 = 0u8;
pub const MIR_RVALUE_REPEAT: u8 = 1u8;
pub const MIR_RVALUE_REF: u8 = 2u8;
pub const MIR_RVALUE_LEN: u8 = 3u8;
pub const MIR_RVALUE_CAST: u8 = 4u8;
pub const MIR_RVALUE_OVERFLOWS_BINARY_OP: u8 = 5u8;
pub const MIR_RVALUE_BINARY_OP: u8 = 6u8;
pub const MIR_RVALUE_UNARY_OP: u8 = 7u8;
pub const MIR_RVALUE_DISCRIMINANT: u8 = 8u8;
pub const MIR_RVALUE_AGGREGATE: u8 = 9u8;

pub struct MirRvalue {
    pub kind: u8,
    pub use_op: MirOperand,
    pub repeat_count: u64,
    pub repeat_count_op: *mut MirOperand,
    pub borrow_kind: u8,
    pub place: MirPlace,
    pub cast_kind: u8,
    pub target_ty: TypeId,
    pub bin_op: u8,
    pub lhs: MirOperand,
    pub rhs: MirOperand,
    pub un_op: u8,
    pub variant_idx: u32,
    pub operands: *mut MirOperand,
    pub operand_count: usize,
}

pub const MIR_STMT_ASSIGN: u8 = 0u8;
pub const MIR_STMT_STORAGE_LIVE: u8 = 1u8;
pub const MIR_STMT_STORAGE_DEAD: u8 = 2u8;
pub const MIR_STMT_DROP: u8 = 3u8;

pub struct MirStmt {
    pub kind: u8,
    pub span: Span,
    pub location: Span,
    pub place: MirPlace,
    pub rvalue: MirRvalue,
    pub storage_local: MirLocalId,
}

pub const MIR_TERM_GOTO: u8 = 0u8;
pub const MIR_TERM_SWITCH_INT: u8 = 1u8;
pub const MIR_TERM_RETURN: u8 = 2u8;
pub const MIR_TERM_UNREACHABLE: u8 = 3u8;
pub const MIR_TERM_DROP: u8 = 4u8;
pub const MIR_TERM_CALL: u8 = 5u8;
pub const MIR_TERM_ASSERT: u8 = 6u8;

pub struct MirTerminator {
    pub kind: u8,
    pub span: Span,
    pub location: Span,
    pub goto_target: MirBbId,
    pub discr: MirOperand,
    pub switch_ty: TypeId,
    pub values: *mut u64,
    pub targets: *mut MirBbId,
    pub switch_count: usize,
    pub otherwise: MirBbId,
    pub drop_place: MirPlace,
    pub drop_target: MirBbId,
    pub drop_unwind: MirBbId,
    pub drop_flag: u32,
    pub drop_is_explicit: bool,
    pub func: MirOperand,
    pub args: *mut MirOperand,
    pub arg_count: usize,
    pub destination: MirPlace,
    pub has_destination: bool,
    pub call_target: MirBbId,
    pub call_unwind: MirBbId,
    pub cond: MirOperand,
    pub expected: bool,
    pub msg_ptr: *const u8,
    pub msg_len: usize,
    pub assert_target: MirBbId,
    pub assert_unwind: MirBbId,
}

pub struct MirBb {
    pub id: MirBbId,
    pub stmts: *mut MirStmt,
    pub stmt_count: usize,
    pub stmt_cap: usize,
    pub terminator: MirTerminator,
    pub has_terminator: bool,
    pub is_cleanup: bool,
}

pub struct MirBody {
    pub sym: SymbolId,
    pub fn_sym: SymbolId,
    pub fn_name: StrId,
    pub span: Span,
    pub arg_count: usize,
    pub locals: *mut MirLocalDecl,
    pub local_count: usize,
    pub local_cap: usize,
    pub bbs: *mut MirBb,
    pub bb_count: usize,
    pub bb_cap: usize,
    pub drop_flag_count: usize,
}

// --- Pointer Indexing Helpers ---

pub unsafe fn mir_local_at(base: *mut MirLocalDecl, idx: usize) -> *mut MirLocalDecl {
    let off = ((idx as isize) * (size_of<MirLocalDecl>() as isize)) as usize;
    ((base as usize) + off) as *mut MirLocalDecl
}

pub unsafe fn mir_local_id_at(base: *mut MirLocalId, idx: usize) -> *mut MirLocalId {
    let off = ((idx as isize) * (size_of<MirLocalId>() as isize)) as usize;
    ((base as usize) + off) as *mut MirLocalId
}

pub unsafe fn mir_proj_at(base: *mut MirProjection, idx: usize) -> *mut MirProjection {
    let off = ((idx as isize) * (size_of<MirProjection>() as isize)) as usize;
    ((base as usize) + off) as *mut MirProjection
}

pub unsafe fn mir_op_at(base: *mut MirOperand, idx: usize) -> *mut MirOperand {
    let off = ((idx as isize) * (size_of<MirOperand>() as isize)) as usize;
    ((base as usize) + off) as *mut MirOperand
}

pub unsafe fn mir_stmt_at(base: *mut MirStmt, idx: usize) -> *mut MirStmt {
    let off = ((idx as isize) * (size_of<MirStmt>() as isize)) as usize;
    ((base as usize) + off) as *mut MirStmt
}

pub unsafe fn mir_bb_at(base: *mut MirBb, idx: usize) -> *mut MirBb {
    let off = ((idx as isize) * (size_of<MirBb>() as isize)) as usize;
    ((base as usize) + off) as *mut MirBb
}

pub unsafe fn mir_bb_id_at(base: *mut MirBbId, idx: usize) -> *mut MirBbId {
    let off = ((idx as isize) * (size_of<MirBbId>() as isize)) as usize;
    ((base as usize) + off) as *mut MirBbId
}

pub unsafe fn mir_u64_at(base: *mut u64, idx: usize) -> *mut u64 {
    let off = ((idx as isize) * (size_of<u64>() as isize)) as usize;
    ((base as usize) + off) as *mut u64
}

// --- Reset & Field-by-Field Copy Helpers ---

pub fn mir_span_zero(dst: mut_view<Span>) {
    dst.file.v = 0u32;
    dst.start = 0u32;
    dst.end = 0u32;
}

pub fn mir_span_copy(dst: mut_view<Span>, src: view<Span>) {
    dst.file.v = src.file.v;
    dst.start = src.start;
    dst.end = src.end;
}

pub fn mir_proj_reset(p: mut_view<MirProjection>, kind: u8) {
    p.kind = kind;
    p.field_idx = 0u32;
    p.index_local.v = 0u32;
    p.from_local.v = 0u32;
    p.to_local.v = 0u32;
    p.has_from = false;
    p.has_to = false;
    p.variant_idx = 0u32;
}

pub fn mir_copy_proj(dst: mut_view<MirProjection>, src: view<MirProjection>) {
    dst.kind = src.kind;
    dst.field_idx = src.field_idx;
    dst.index_local.v = src.index_local.v;
    dst.from_local.v = src.from_local.v;
    dst.to_local.v = src.to_local.v;
    dst.has_from = src.has_from;
    dst.has_to = src.has_to;
    dst.variant_idx = src.variant_idx;
}

pub fn mir_place_reset_u32(p: mut_view<MirPlace>, local_v: u32) {
    p.local.v = local_v;
    p.region = MIR_REGION_UNKNOWN;
    p.view_kind = MIR_VIEW_UNKNOWN;
    p.projs = 0 as *mut MirProjection;
    p.proj_count = 0;
    p.drop_flag = MIR_DROP_FLAG_NONE;
}

pub fn mir_place_reset(p: mut_view<MirPlace>, local: MirLocalId) {
    mir_place_reset_u32(p, local.v);
}

pub fn mir_local_place(local_v: u32) -> MirPlace {
    MirPlace {
        local: MirLocalId { v: local_v },
        region: MIR_REGION_UNKNOWN,
        view_kind: MIR_VIEW_UNKNOWN,
        projs: 0 as *mut MirProjection,
        proj_count: 0,
        drop_flag: MIR_DROP_FLAG_NONE,
    }
}

pub fn mir_place_local(local: MirLocalId) -> MirPlace {
    mir_local_place(local.v)
}

pub fn mir_copy_place(dst: mut_view<MirPlace>, src: view<MirPlace>) {
    dst.local.v = src.local.v;
    dst.region = src.region;
    dst.view_kind = src.view_kind;
    dst.projs = src.projs;
    dst.proj_count = src.proj_count;
    dst.drop_flag = src.drop_flag;
}

pub fn mir_clone_place(arena: mut_view<Arena>, src: view<MirPlace>, dst: mut_view<MirPlace>) {
    dst.local.v = src.local.v;
    dst.region = src.region;
    dst.view_kind = src.view_kind;
    dst.proj_count = src.proj_count;
    dst.drop_flag = src.drop_flag;
    if src.proj_count > 0 && (src.projs as usize) != 0 {
        let bytes = mir_mul_usize(src.proj_count, size_of<MirProjection>());
        let new_projs = arena_alloc_raw(mut_view(*arena), bytes, align_of<MirProjection>()) as *mut MirProjection;
        unsafe {
            ptr_copy_nonoverlapping<u8>(src.projs as *const u8, new_projs as *mut u8, bytes);
        }
        dst.projs = new_projs;
    } else {
        dst.projs = 0 as *mut MirProjection;
    }
}

pub fn mir_place_append_proj(
    arena: mut_view<Arena>,
    src: view<MirPlace>,
    proj: view<MirProjection>,
    dst: mut_view<MirPlace>
) {
    let old_cnt = src.proj_count;
    let new_cnt = old_cnt + 1;
    let bytes = mir_mul_usize(new_cnt, size_of<MirProjection>());
    let new_projs = arena_alloc_raw(mut_view(*arena), bytes, align_of<MirProjection>()) as *mut MirProjection;
    if old_cnt > 0 && (src.projs as usize) != 0 {
        let old_bytes = mir_mul_usize(old_cnt, size_of<MirProjection>());
        unsafe {
            ptr_copy_nonoverlapping<u8>(src.projs as *const u8, new_projs as *mut u8, old_bytes);
        }
    }
    let last = unsafe {
        mir_proj_at(new_projs, old_cnt)
    };
    unsafe {
        mir_copy_proj(mut_view(*last), proj);
    }
    dst.local.v = src.local.v;
    dst.region = src.region;
    dst.view_kind = src.view_kind;
    dst.projs = new_projs;
    dst.proj_count = new_cnt;
    dst.drop_flag = src.drop_flag;
}

pub fn mir_const_reset_vals(c: mut_view<MirConst>, kind: u8, ty_v: u32, val: u64) {
    c.ty.v = ty_v;
    c.kind = kind;
    c.val = val;
    c.str_bytes = 0 as *const u8;
    c.str_len = 0;
    c.sym.v = 0u32;
}

pub fn mir_const_reset(c: mut_view<MirConst>, ty: TypeId, kind: u8) {
    mir_const_reset_vals(c, kind, ty.v, 0u64);
}

pub fn mir_copy_const(dst: mut_view<MirConst>, src: view<MirConst>) {
    dst.ty.v = src.ty.v;
    dst.kind = src.kind;
    dst.val = src.val;
    dst.str_bytes = src.str_bytes;
    dst.str_len = src.str_len;
    dst.sym.v = src.sym.v;
}

pub fn mir_operand_zero(op: mut_view<MirOperand>, kind: u8) {
    op.kind = kind;
    mir_span_zero(mut_view(op.location));
    mir_place_reset_u32(mut_view(op.place), 0u32);
    mir_const_reset_vals(mut_view(op.constant), MIR_CONST_INT, 0u32, 0u64);
}

pub fn mir_operand_reset(op: mut_view<MirOperand>, kind: u8, loc: view<Span>) {
    mir_operand_zero(mut_view(*op), kind);
    mir_span_copy(mut_view(op.location), loc);
}

pub fn mir_copy_operand(dst: mut_view<MirOperand>, src: view<MirOperand>) {
    dst.kind = src.kind;
    mir_span_copy(mut_view(dst.location), view(src.location));
    mir_copy_place(mut_view(dst.place), view(src.place));
    mir_copy_const(mut_view(dst.constant), view(src.constant));
}

pub fn mir_init_op_copy(dst: mut_view<MirOperand>, place: view<MirPlace>, loc: view<Span>) {
    mir_operand_reset(mut_view(*dst), MIR_OP_COPY, loc);
    mir_copy_place(mut_view(dst.place), place);
}

pub fn mir_init_op_move(dst: mut_view<MirOperand>, place: view<MirPlace>, loc: view<Span>) {
    mir_operand_reset(mut_view(*dst), MIR_OP_MOVE, loc);
    mir_copy_place(mut_view(dst.place), place);
}

pub fn mir_init_op_const_int(dst: mut_view<MirOperand>, ty: TypeId, val: u64, loc: view<Span>) {
    mir_operand_reset(mut_view(*dst), MIR_OP_CONST, loc);
    dst.constant.ty.v = ty.v;
    dst.constant.kind = MIR_CONST_INT;
    dst.constant.val = val;
}

pub fn mir_init_op_const_str(
    dst: mut_view<MirOperand>,
    ty: TypeId,
    bytes: *const u8,
    byte_len: usize,
    loc: view<Span>
) {
    mir_operand_reset(mut_view(*dst), MIR_OP_CONST, loc);
    dst.constant.ty.v = ty.v;
    dst.constant.kind = MIR_CONST_STR;
    dst.constant.str_bytes = bytes;
    dst.constant.str_len = byte_len;
}

pub fn mir_op_copy_local(local_v: u32) -> MirOperand {
    MirOperand {
        kind: MIR_OP_COPY,
        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        place: mir_local_place(local_v),
        constant: MirConst {
            ty: TypeId { v: 0u32 },
            kind: MIR_CONST_INT,
            val: 0u64,
            str_bytes: 0 as *const u8,
            str_len: 0,
            sym: SymbolId { v: 0u32 },
        },
    }
}

pub fn mir_op_move_local(local_v: u32) -> MirOperand {
    MirOperand {
        kind: MIR_OP_MOVE,
        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        place: mir_local_place(local_v),
        constant: MirConst {
            ty: TypeId { v: 0u32 },
            kind: MIR_CONST_INT,
            val: 0u64,
            str_bytes: 0 as *const u8,
            str_len: 0,
            sym: SymbolId { v: 0u32 },
        },
    }
}

pub fn mir_op_const_int(ty_v: u32, val: u64) -> MirOperand {
    MirOperand {
        kind: MIR_OP_CONST,
        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        place: mir_local_place(0u32),
        constant: MirConst {
            ty: TypeId { v: ty_v },
            kind: MIR_CONST_INT,
            val: val,
            str_bytes: 0 as *const u8,
            str_len: 0,
            sym: SymbolId { v: 0u32 },
        },
    }
}

pub fn mir_op_const_bool(ty_v: u32, val: bool) -> MirOperand {
    let v: u64 = if val {
        1u64
    } else {
        0u64
    };
    MirOperand {
        kind: MIR_OP_CONST,
        location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        place: mir_local_place(0u32),
        constant: MirConst {
            ty: TypeId { v: ty_v },
            kind: MIR_CONST_BOOL,
            val: v,
            str_bytes: 0 as *const u8,
            str_len: 0,
            sym: SymbolId { v: 0u32 },
        },
    }
}

pub fn mir_rvalue_reset(rv: mut_view<MirRvalue>, kind: u8) {
    rv.kind = kind;
    mir_operand_zero(mut_view(rv.use_op), MIR_OP_COPY);
    rv.repeat_count = 0u64;
    rv.repeat_count_op = 0 as *mut MirOperand;
    rv.borrow_kind = MIR_BORROW_SHARED;
    mir_place_reset_u32(mut_view(rv.place), 0u32);
    rv.cast_kind = MIR_CAST_INT_TO_INT;
    rv.target_ty.v = 0u32;
    rv.bin_op = MIR_BINOP_ADD;
    mir_operand_zero(mut_view(rv.lhs), MIR_OP_COPY);
    mir_operand_zero(mut_view(rv.rhs), MIR_OP_COPY);
    rv.un_op = MIR_UNOP_NOT;
    rv.variant_idx = 0u32;
    rv.operands = 0 as *mut MirOperand;
    rv.operand_count = 0;
}

pub fn mir_copy_rvalue(dst: mut_view<MirRvalue>, src: view<MirRvalue>) {
    dst.kind = src.kind;
    mir_copy_operand(mut_view(dst.use_op), view(src.use_op));
    dst.repeat_count = src.repeat_count;
    dst.repeat_count_op = src.repeat_count_op;
    dst.borrow_kind = src.borrow_kind;
    mir_copy_place(mut_view(dst.place), view(src.place));
    dst.cast_kind = src.cast_kind;
    dst.target_ty.v = src.target_ty.v;
    dst.bin_op = src.bin_op;
    mir_copy_operand(mut_view(dst.lhs), view(src.lhs));
    mir_copy_operand(mut_view(dst.rhs), view(src.rhs));
    dst.un_op = src.un_op;
    dst.variant_idx = src.variant_idx;
    dst.operands = src.operands;
    dst.operand_count = src.operand_count;
}

pub fn mir_stmt_zero(stmt: mut_view<MirStmt>, kind: u8) {
    stmt.kind = kind;
    mir_span_zero(mut_view(stmt.span));
    mir_span_zero(mut_view(stmt.location));
    mir_place_reset_u32(mut_view(stmt.place), 0u32);
    mir_rvalue_reset(mut_view(stmt.rvalue), MIR_RVALUE_USE);
    stmt.storage_local.v = 0u32;
}

pub fn mir_stmt_reset(stmt: mut_view<MirStmt>, kind: u8, loc: view<Span>) {
    mir_stmt_zero(mut_view(*stmt), kind);
    mir_span_copy(mut_view(stmt.span), loc);
    mir_span_copy(mut_view(stmt.location), loc);
}

pub fn mir_copy_stmt(dst: mut_view<MirStmt>, src: view<MirStmt>) {
    dst.kind = src.kind;
    if src.location.file.v != 0u32 || src.location.start != 0u32 || src.location.end != 0u32 {
        mir_span_copy(mut_view(dst.location), view(src.location));
        mir_span_copy(mut_view(dst.span), view(src.location));
    } else {
        mir_span_copy(mut_view(dst.span), view(src.span));
        mir_span_copy(mut_view(dst.location), view(src.span));
    }
    mir_copy_place(mut_view(dst.place), view(src.place));
    mir_copy_rvalue(mut_view(dst.rvalue), view(src.rvalue));
    dst.storage_local.v = src.storage_local.v;
}

pub fn mir_term_zero(term: mut_view<MirTerminator>, kind: u8) {
    term.kind = kind;
    mir_span_zero(mut_view(term.span));
    mir_span_zero(mut_view(term.location));
    term.goto_target.v = 0u32;
    mir_operand_zero(mut_view(term.discr), MIR_OP_COPY);
    term.switch_ty.v = 0u32;
    term.values = 0 as *mut u64;
    term.targets = 0 as *mut MirBbId;
    term.switch_count = 0;
    term.otherwise.v = 0u32;
    mir_place_reset_u32(mut_view(term.drop_place), 0u32);
    term.drop_target.v = 0u32;
    term.drop_unwind.v = 0u32;
    term.drop_flag = 0u32;
    term.drop_is_explicit = false;
    mir_operand_zero(mut_view(term.func), MIR_OP_COPY);
    term.args = 0 as *mut MirOperand;
    term.arg_count = 0;
    mir_place_reset_u32(mut_view(term.destination), 0u32);
    term.has_destination = false;
    term.call_target.v = 0u32;
    term.call_unwind.v = 0u32;
    mir_operand_zero(mut_view(term.cond), MIR_OP_COPY);
    term.expected = true;
    term.msg_ptr = 0 as *const u8;
    term.msg_len = 0;
    term.assert_target.v = 0u32;
    term.assert_unwind.v = 0u32;
}

pub fn mir_term_reset(term: mut_view<MirTerminator>, kind: u8, loc: view<Span>) {
    mir_term_zero(mut_view(*term), kind);
    mir_span_copy(mut_view(term.span), loc);
    mir_span_copy(mut_view(term.location), loc);
}

pub fn mir_copy_terminator(dst: mut_view<MirTerminator>, src: view<MirTerminator>) {
    dst.kind = src.kind;
    if src.location.file.v != 0u32 || src.location.start != 0u32 || src.location.end != 0u32 {
        mir_span_copy(mut_view(dst.location), view(src.location));
        mir_span_copy(mut_view(dst.span), view(src.location));
    } else {
        mir_span_copy(mut_view(dst.span), view(src.span));
        mir_span_copy(mut_view(dst.location), view(src.span));
    }
    dst.goto_target.v = src.goto_target.v;
    mir_copy_operand(mut_view(dst.discr), view(src.discr));
    dst.switch_ty.v = src.switch_ty.v;
    dst.values = src.values;
    dst.targets = src.targets;
    dst.switch_count = src.switch_count;
    dst.otherwise.v = src.otherwise.v;
    mir_copy_place(mut_view(dst.drop_place), view(src.drop_place));
    dst.drop_target.v = src.drop_target.v;
    dst.drop_unwind.v = src.drop_unwind.v;
    dst.drop_flag = src.drop_flag;
    dst.drop_is_explicit = src.drop_is_explicit;
    mir_copy_operand(mut_view(dst.func), view(src.func));
    dst.args = src.args;
    dst.arg_count = src.arg_count;
    mir_copy_place(mut_view(dst.destination), view(src.destination));
    dst.has_destination = src.has_destination;
    dst.call_target.v = src.call_target.v;
    dst.call_unwind.v = src.call_unwind.v;
    mir_copy_operand(mut_view(dst.cond), view(src.cond));
    dst.expected = src.expected;
    dst.msg_ptr = src.msg_ptr;
    dst.msg_len = src.msg_len;
    dst.assert_target.v = src.assert_target.v;
    dst.assert_unwind.v = src.assert_unwind.v;
}

pub fn mir_bb_reset_u32(bb: mut_view<MirBb>, id_v: u32, is_cleanup: bool) {
    bb.id.v = id_v;
    bb.stmts = 0 as *mut MirStmt;
    bb.stmt_count = 0;
    bb.stmt_cap = 0;
    mir_term_zero(mut_view(bb.terminator), MIR_TERM_UNREACHABLE);
    bb.has_terminator = false;
    bb.is_cleanup = is_cleanup;
}

pub fn mir_bb_reset(bb: mut_view<MirBb>, id: MirBbId) {
    mir_bb_reset_u32(bb, id.v, false);
}

pub fn mir_body_reset(body: mut_view<MirBody>) {
    body.sym.v = 0u32;
    body.fn_sym.v = 0u32;
    body.fn_name.v = 0u32;
    mir_span_zero(mut_view(body.span));
    body.arg_count = 0;
    body.locals = 0 as *mut MirLocalDecl;
    body.local_count = 0;
    body.local_cap = 0;
    body.bbs = 0 as *mut MirBb;
    body.bb_count = 0;
    body.bb_cap = 0;
    body.drop_flag_count = 0;
}

pub fn mir_body_init(body: mut_view<MirBody>) {
    mir_body_reset(body);
}

// --- Arena-Backed Builders ---

pub fn mir_body_new(arena: mut_view<Arena>) -> *mut MirBody {
    let body = arena_alloc_raw(mut_view(*arena), size_of<MirBody>(), align_of<MirBody>()) as *mut MirBody;
    unsafe {
        mir_body_reset(mut_view(*body));
    }
    body
}

pub fn mir_add_local(
    body: mut_view<MirBody>,
    arena: mut_view<Arena>,
    ty: TypeId,
    kind: u8,
    mut_flag: bool,
    name: StrId,
    span: view<Span>
) -> MirLocalId {
    if body.local_count >= body.local_cap {
        let new_cap: usize = if body.local_cap == 0 {
            8
        } else {
            body.local_cap + body.local_cap
        };
        let new_bytes = mir_mul_usize(new_cap, size_of<MirLocalDecl>());
        let new_locals = arena_alloc_raw(mut_view(*arena), new_bytes, align_of<MirLocalDecl>()) as *mut MirLocalDecl;
        if body.local_count > 0 && (body.locals as usize) != 0 {
            let old_bytes = mir_mul_usize(body.local_count, size_of<MirLocalDecl>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(body.locals as *const u8, new_locals as *mut u8, old_bytes);
            }
        }
        body.locals = new_locals;
        body.local_cap = new_cap;
    }
    let idx = body.local_count;
    body.local_count = idx + 1;
    if kind == MIR_LOCAL_ARG {
        body.arg_count = body.arg_count + 1;
    }
    let decl = unsafe {
        mir_local_at(body.locals, idx)
    };
    unsafe {
        (*decl).ty.v = ty.v;
        (*decl).kind = kind;
        (*decl).mut_flag = mut_flag;
        (*decl).name.v = name.v;
        mir_span_copy(mut_view((*decl).span), span);
        mir_span_copy(mut_view((*decl).location), span);
        (*decl).const_sym.v = 0u32;
    }
    MirLocalId { v: idx as u32 }
}

pub fn mir_add_bb(body: mut_view<MirBody>, arena: mut_view<Arena>, is_cleanup: bool) -> MirBbId {
    if body.bb_count >= body.bb_cap {
        let new_cap: usize = if body.bb_cap == 0 {
            8
        } else {
            body.bb_cap + body.bb_cap
        };
        let new_bytes = mir_mul_usize(new_cap, size_of<MirBb>());
        let new_bbs = arena_alloc_raw(mut_view(*arena), new_bytes, align_of<MirBb>()) as *mut MirBb;
        if body.bb_count > 0 && (body.bbs as usize) != 0 {
            let old_bytes = mir_mul_usize(body.bb_count, size_of<MirBb>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(body.bbs as *const u8, new_bbs as *mut u8, old_bytes);
            }
        }
        body.bbs = new_bbs;
        body.bb_cap = new_cap;
    }
    let idx = body.bb_count;
    body.bb_count = idx + 1;
    let bb = unsafe {
        mir_bb_at(body.bbs, idx)
    };
    unsafe {
        mir_bb_reset_u32(mut_view(*bb), idx as u32, is_cleanup);
    }
    MirBbId { v: idx as u32 }
}

pub fn mir_bb_push_stmt(bb: mut_view<MirBb>, arena: mut_view<Arena>, stmt: view<MirStmt>) {
    if bb.stmt_count >= bb.stmt_cap {
        let new_cap: usize = if bb.stmt_cap == 0 {
            8
        } else {
            bb.stmt_cap + bb.stmt_cap
        };
        let new_bytes = mir_mul_usize(new_cap, size_of<MirStmt>());
        let new_stmts = arena_alloc_raw(mut_view(*arena), new_bytes, align_of<MirStmt>()) as *mut MirStmt;
        if bb.stmt_count > 0 && (bb.stmts as usize) != 0 {
            let old_bytes = mir_mul_usize(bb.stmt_count, size_of<MirStmt>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(bb.stmts as *const u8, new_stmts as *mut u8, old_bytes);
            }
        }
        bb.stmts = new_stmts;
        bb.stmt_cap = new_cap;
    }
    let idx = bb.stmt_count;
    bb.stmt_count = idx + 1;
    let dst = unsafe {
        mir_stmt_at(bb.stmts, idx)
    };
    unsafe {
        mir_copy_stmt(mut_view(*dst), stmt);
    }
}

pub fn mir_bb_set_terminator(bb: mut_view<MirBb>, term: view<MirTerminator>) {
    mir_copy_terminator(mut_view(bb.terminator), term);
    bb.has_terminator = true;
}

// Axiom Compiler — MIR Drop Elaboration (compiler/mir/drop.ax)
// Port of bootstrap/axiom0/src/mir/drop/drop.h and drop.c.
//
// Drop elaboration runs after ownership checking. It
//   1. gives every local (except the return slot) whose type needs drop a boolean drop flag,
//      initialised at the top of bb0 (true for arguments, false otherwise);
//   2. arms the flag after every assignment to the local and in the return block of every call
//      that writes it, and clears it in front of every statement or terminator that moves or
//      copies the local out;
//   3. rewrites every `drop(place)` terminator into explicit cleanup blocks: a flag test (for
//      flagged locals), the user `Drop.drop` call for structs that implement it, and field-wise
//      drops of compound structs, tuples, closure environments and enum variants (through a
//      discriminant switch). The new field drops are expanded in later passes until no `drop`
//      terminator whose type is known remains.
//
// Every block, local and statement is created in the same order as the C implementation, so the
// elaborated body prints byte-identically with `ax_mir_print` (differential harness:
// tests/selfhost/drop). Behaviour kept from the C implementation on purpose (reported in
// _workspaces/reports/T082d-report.md):
//   - the destructor argument is built with a shared borrow `&place` although its local has type
//     `mut_view<T>`;
//   - copies clear a drop flag exactly like moves;
//   - field drop blocks inherit no flag, their unwind edge is bb0 and they are not cleanup blocks;
//   - a struct declared without named fields (unit, empty `{}` or tuple struct) is treated as
//     owning a resource, so it always needs drop;
//   - `impl Drop for T` is matched on the trait and self type names (source text when a source
//     database is given, interned names otherwise) and its first fn member is the destructor.
module compiler.mir.drop

