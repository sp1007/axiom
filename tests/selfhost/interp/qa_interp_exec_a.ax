// Recursive-descent parser with a Pratt expression parser: turns the lexer's token stream into the AST of
// compiler.syntax.ast.  Port of bootstrap/axiom0/src/syntax/parse.c; it produces the same trees and the same
// diagnostics, including error recovery.  Newlines are significant while `Parser.mode_on` is set.

module compiler.resolve.symtab

use std.core.host.heap_alloc
use std.core.host.heap_free
use compiler.kernel.id.StrId
use compiler.kernel.id.SymbolId
use compiler.kernel.interner.StrView
use compiler.source.span.Span

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }

pub const SYM_VAR: u8 = 0u8;
pub const SYM_FN: u8 = 1u8;
pub const SYM_STRUCT: u8 = 2u8;
pub const SYM_ENUM: u8 = 3u8;
pub const SYM_VARIANT: u8 = 4u8;
pub const SYM_TRAIT: u8 = 5u8;
pub const SYM_TYPE_ALIAS: u8 = 6u8;
pub const SYM_GENERIC_PARAM: u8 = 7u8;
pub const SYM_CONST: u8 = 8u8;
pub const SYM_STATIC: u8 = 9u8;
pub const SYM_MODULE: u8 = 10u8;
pub const SYM_PRIMITIVE: u8 = 11u8;
pub const SYM_LOCAL: u8 = 12u8;

pub struct Symbol {
    pub id: SymbolId,
    pub name: StrId,
    pub kind: u8,
    pub vis: u8,
    pub is_mut: bool,
    pub def_span: Span,
    pub node: usize,
    pub def_module: usize,
}

pub fn copy_symbol_into(dst: mut_view<Symbol>, src: view<Symbol>) {
    dst.id.v = src.id.v;
    dst.name.v = src.name.v;
    dst.kind = src.kind;
    dst.vis = src.vis;
    dst.is_mut = src.is_mut;
    dst.def_span.file.v = src.def_span.file.v;
    dst.def_span.start = src.def_span.start;
    dst.def_span.end = src.def_span.end;
    dst.node = src.node;
    dst.def_module = src.def_module;
}

pub struct NodeMap {
    pub keys: *mut usize,
    pub vals: *mut SymbolId,
    pub states: *mut u8,
    pub len: usize,
    pub cap: usize,
}

pub struct SymEnv {
    pub keys: *mut u32,
    pub vals: *mut Symbol,
    pub states: *mut u8,
    pub len: usize,
    pub cap: usize,
}

// SymbolId.v -> (module path, canonical name). Symbol ids are sparse (user ids from 1, std ids from 10000,
// extern ids from 30000), so `index` maps an id to `slot + 1` in the append-only `module_paths` /
// `canonical_names` arrays instead of indexing a dense table by id.
pub struct NamingCtx {
    pub index: NodeMap,
    pub module_paths: *mut StrView,
    pub canonical_names: *mut StrView,
    pub count: usize,
    pub cap: usize,
}

const NAMING_INITIAL_CAP: usize = 64;

pub struct ResolveMap {
    pub node_map: NodeMap,
    pub module_access_nodes: NodeMap,
    pub extern_nodes: NodeMap,
    pub next_symbol_v: u32,
    pub next_std_symbol_v: u32,
    pub naming_ctx: *mut NamingCtx,
}

fn mul_usize(a: usize, b: usize) -> usize {
    ((a as isize) * (b as isize)) as usize
}

fn symtab_zero_bytes(ptr: *mut u8, n: usize) {
    let word_count = n >> 3;
    let mut w: usize = 0;
    while w < word_count {
        let off = w << 3;
        unsafe { *(((ptr as usize) + off) as *mut u64) = 0u64; }
        w = w + 1;
    }
    let mut i: usize = word_count << 3;
    while i < n {
        unsafe { *(ptr + i) = 0u8; }
        i = i + 1;
    }
}

unsafe fn usize_at(base: *mut usize, idx: usize) -> *mut usize {
    let off = ((idx as isize) * (size_of<usize>() as isize)) as usize;
    ((base as usize) + off) as *mut usize
}

unsafe fn u32_at(base: *mut u32, idx: usize) -> *mut u32 {
    let off = ((idx as isize) * (size_of<u32>() as isize)) as usize;
    ((base as usize) + off) as *mut u32
}

unsafe fn symid_at(base: *mut SymbolId, idx: usize) -> *mut SymbolId {
    let off = ((idx as isize) * (size_of<SymbolId>() as isize)) as usize;
    ((base as usize) + off) as *mut SymbolId
}

unsafe fn symbol_at(base: *mut Symbol, idx: usize) -> *mut Symbol {
    let off = ((idx as isize) * (size_of<Symbol>() as isize)) as usize;
    ((base as usize) + off) as *mut Symbol
}

unsafe fn strview_at(base: *mut StrView, idx: usize) -> *mut StrView {
    let off = ((idx as isize) * (size_of<StrView>() as isize)) as usize;
    ((base as usize) + off) as *mut StrView
}

// Keeps the bits that survive a left shift by `HASH_MIX_SHIFT`, so the shift never overflows (native builds
// trap on overflowing shifts; the dropped high bits would be discarded anyway).
const HASH_MIX_SHIFT: usize = 7;
const HASH_MIX_MASK: usize = 0x01FFFFFFFFFFFFFF;

fn map_hash_key(key: usize) -> usize {
    let mut h = key ^ (key >> 16);
    h = h ^ ((h & HASH_MIX_MASK) << HASH_MIX_SHIFT);
    h ^ (h >> 11)
}

pub fn nodemap_init(m: mut_view<NodeMap>) {
    m.keys = 0 as *mut usize;
    m.vals = 0 as *mut SymbolId;
    m.states = 0 as *mut u8;
    m.len = 0;
    m.cap = 0;
}

pub fn nodemap_free(m: mut_view<NodeMap>) {
    if m.cap > 0 {
        unsafe {
            heap_free(m.keys as *mut u8, mul_usize(m.cap, size_of<usize>()), align_of<usize>());
            heap_free(m.vals as *mut u8, mul_usize(m.cap, size_of<SymbolId>()), align_of<SymbolId>());
            heap_free(m.states, m.cap, 1);
        }
    }
    nodemap_init(m);
}

fn nodemap_grow(m: mut_view<NodeMap>) {
    let new_cap: usize = if m.cap == 0 { 16 } else { m.cap + m.cap };
    let new_keys = unsafe { heap_alloc(mul_usize(new_cap, size_of<usize>()), align_of<usize>()) as *mut usize };
    let new_vals = unsafe {
        heap_alloc(mul_usize(new_cap, size_of<SymbolId>()), align_of<SymbolId>()) as *mut SymbolId
    };
    let new_states = unsafe { heap_alloc(new_cap, 1) };
    symtab_zero_bytes(new_states, new_cap);

    let old_keys = m.keys;
    let old_vals = m.vals;
    let old_states = m.states;
    let old_cap = m.cap;

    m.keys = new_keys;
    m.vals = new_vals;
    m.states = new_states;
    m.len = 0;
    m.cap = new_cap;

    let mut i: usize = 0;
    while i < old_cap {
        let st = unsafe { *(old_states + i) };
        if st == 1u8 {
            let k = unsafe { *usize_at(old_keys, i) };
            let v = unsafe { (*symid_at(old_vals, i)).v };
            nodemap_insert(mut_view(*m), k, SymbolId { v: v });
        }
        i = i + 1;
    }

    if old_cap > 0 {
        unsafe {
            heap_free(old_keys as *mut u8, mul_usize(old_cap, size_of<usize>()), align_of<usize>());
            heap_free(old_vals as *mut u8, mul_usize(old_cap, size_of<SymbolId>()), align_of<SymbolId>());
            heap_free(old_states, old_cap, 1);
        }
    }
}

pub fn nodemap_insert(m: mut_view<NodeMap>, key: usize, val: SymbolId) {
    if m.cap == 0 || mul_usize(m.len + 1, 10) >= mul_usize(m.cap, 7) {
        nodemap_grow(mut_view(*m));
    }
    let mask = m.cap - 1;
    let mut idx = map_hash_key(key as usize) & mask;
    loop {
        let st = unsafe { *(m.states + idx) };
        if st == 0u8 {
            unsafe {
                *usize_at(m.keys, idx) = key;
                (*symid_at(m.vals, idx)).v = val.v;
                *(m.states + idx) = 1u8;
            }
            m.len = m.len + 1;
            return;
        }
        let k = unsafe { *usize_at(m.keys, idx) };
        if k == key {
            unsafe { (*symid_at(m.vals, idx)).v = val.v; }
            return;
        }
        idx = (idx + 1) & mask;
    }
}

pub fn nodemap_get(m: view<NodeMap>, key: usize) -> *mut SymbolId {
    if m.cap == 0 {
        return 0 as *mut SymbolId;
    }
    let mask = m.cap - 1;
    let mut idx = map_hash_key(key as usize) & mask;
    let mut probes: usize = 0;
    while probes < m.cap {
        let st = unsafe { *(m.states + idx) };
        if st == 0u8 {
            return 0 as *mut SymbolId;
        }
        if st == 1u8 {
            let k = unsafe { *usize_at(m.keys, idx) };
            if k == key {
                return unsafe { symid_at(m.vals, idx) };
            }
        }
        idx = (idx + 1) & mask;
        probes = probes + 1;
    }
    0 as *mut SymbolId
}

pub fn nodemap_contains(m: view<NodeMap>, key: usize) -> bool {
    (nodemap_get(m, key) as usize) != 0
}

pub fn symenv_init(m: mut_view<SymEnv>) {
    m.keys = 0 as *mut u32;
    m.vals = 0 as *mut Symbol;
    m.states = 0 as *mut u8;
    m.len = 0;
    m.cap = 0;
}

pub fn symenv_free(m: mut_view<SymEnv>) {
    if m.cap > 0 {
        unsafe {
            heap_free(m.keys as *mut u8, mul_usize(m.cap, size_of<u32>()), align_of<u32>());
            heap_free(m.vals as *mut u8, mul_usize(m.cap, size_of<Symbol>()), align_of<Symbol>());
            heap_free(m.states, m.cap, 1);
        }
    }
    symenv_init(m);
}

fn symenv_grow(m: mut_view<SymEnv>) {
    let new_cap: usize = if m.cap == 0 { 16 } else { m.cap + m.cap };
    let new_keys = unsafe { heap_alloc(mul_usize(new_cap, size_of<u32>()), align_of<u32>()) as *mut u32 };
    let new_vals = unsafe { heap_alloc(mul_usize(new_cap, size_of<Symbol>()), align_of<Symbol>()) as *mut Symbol };
    let new_states = unsafe { heap_alloc(new_cap, 1) };
    symtab_zero_bytes(new_states, new_cap);

    let old_keys = m.keys;
    let old_vals = m.vals;
    let old_states = m.states;
    let old_cap = m.cap;

    m.keys = new_keys;
    m.vals = new_vals;
    m.states = new_states;
    m.len = 0;
    m.cap = new_cap;

    let mut i: usize = 0;
    while i < old_cap {
        let st = unsafe { *(old_states + i) };
        if st == 1u8 {
            let k = unsafe { *u32_at(old_keys, i) };
            let v_ptr = unsafe { symbol_at(old_vals, i) };
            symenv_insert(mut_view(*m), k, unsafe { view(*v_ptr) });
        }
        i = i + 1;
    }

    if old_cap > 0 {
        unsafe {
            heap_free(old_keys as *mut u8, mul_usize(old_cap, size_of<u32>()), align_of<u32>());
            heap_free(old_vals as *mut u8, mul_usize(old_cap, size_of<Symbol>()), align_of<Symbol>());
            heap_free(old_states, old_cap, 1);
        }
    }
}

pub fn symenv_insert(m: mut_view<SymEnv>, key: u32, val: view<Symbol>) {
    if m.cap == 0 || mul_usize(m.len + 1, 10) >= mul_usize(m.cap, 7) {
        symenv_grow(mut_view(*m));
    }
    let mask = m.cap - 1;
    let mut idx = map_hash_key(key as usize) & mask;
    loop {
        let st = unsafe { *(m.states + idx) };
        if st == 0u8 {
            unsafe {
                *u32_at(m.keys, idx) = key;
                let dst = symbol_at(m.vals, idx);
                copy_symbol_into(mut_view(*dst), val);
                *(m.states + idx) = 1u8;
            }
            m.len = m.len + 1;
            return;
        }
        let k = unsafe { *u32_at(m.keys, idx) };
        if k == key {
            unsafe { let dst = symbol_at(m.vals, idx);
                copy_symbol_into(mut_view(*dst), val); }
            return;
        }
        idx = (idx + 1) & mask;
    }
}

pub fn symenv_get(m: view<SymEnv>, key: u32) -> *mut Symbol {
    if m.cap == 0 {
        return 0 as *mut Symbol;
    }
    let mask = m.cap - 1;
    let mut idx = map_hash_key(key as usize) & mask;
    let mut probes: usize = 0;
    while probes < m.cap {
        let st = unsafe { *(m.states + idx) };
        if st == 0u8 {
            return 0 as *mut Symbol;
        }
        if st == 1u8 {
            let k = unsafe { *u32_at(m.keys, idx) };
            if k == key {
                return unsafe { symbol_at(m.vals, idx) };
            }
        }
        idx = (idx + 1) & mask;
        probes = probes + 1;
    }
    0 as *mut Symbol
}

pub fn symenv_contains(m: view<SymEnv>, key: u32) -> bool {
    (symenv_get(m, key) as usize) != 0
}

pub fn symenv_at_slot(m: view<SymEnv>, slot: usize) -> *mut Symbol {
    if slot >= m.cap {
        return 0 as *mut Symbol;
    }
    let st = unsafe { *(m.states + slot) };
    if st != 1u8 {
        return 0 as *mut Symbol;
    }
    unsafe { symbol_at(m.vals, slot) }
}

pub fn symenv_key_at_slot(m: view<SymEnv>, slot: usize) -> u32 {
    unsafe { *u32_at(m.keys, slot) }
}

pub fn resolve_map_init(rmap: mut_view<ResolveMap>) {
    nodemap_init(mut_view(rmap.node_map));
    nodemap_init(mut_view(rmap.module_access_nodes));
    nodemap_init(mut_view(rmap.extern_nodes));
    rmap.next_symbol_v = 1u32;
    rmap.next_std_symbol_v = 10000u32;
    rmap.naming_ctx = 0 as *mut NamingCtx;
}

pub fn resolve_map_free(rmap: mut_view<ResolveMap>) {
    nodemap_free(mut_view(rmap.extern_nodes));
    nodemap_free(mut_view(rmap.module_access_nodes));
    nodemap_free(mut_view(rmap.node_map));
    rmap.naming_ctx = 0 as *mut NamingCtx;
}
pub fn record_symbol_naming(rmap: mut_view<ResolveMap>, id: SymbolId, mod_path: StrView, item_name: StrView) {}
pub fn resolve_symbol_module_path(rmap: view<ResolveMap>, sym: SymbolId) -> StrView { StrView { ptr: 0 as *const u8, len: 0 } }
pub fn resolve_symbol_canonical_name(rmap: view<ResolveMap>, sym: SymbolId) -> StrView { StrView { ptr: 0 as *const u8, len: 0 } }

module compiler.hir.hir

