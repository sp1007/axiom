unsafe fn utf8_to_wpath(path: *const u8, path_len: usize, wpath: *mut u16, cap: usize) -> usize {
    let mut in_pos: usize = 0;
    let mut out_pos: usize = 0;
    while in_pos < path_len && out_pos + 2 < cap {
        let b0 = *(path + in_pos) as u32;
        let mut cp: u32 = 0;
        let mut step: usize = 1;
        if b0 < 0x80 {
            cp = b0;
            step = 1;
        } else if (b0 & 0xE0) == 0xC0 && in_pos + 1 < path_len {
            let b1 = *(path + in_pos + 1) as u32;
            cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F);
            step = 2;
        } else if (b0 & 0xF0) == 0xE0 && in_pos + 2 < path_len {
            let b1 = *(path + in_pos + 1) as u32;
            let b2 = *(path + in_pos + 2) as u32;
            cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F);
            step = 3;
        } else if (b0 & 0xF8) == 0xF0 && in_pos + 3 < path_len {
            let b1 = *(path + in_pos + 1) as u32;
            let b2 = *(path + in_pos + 2) as u32;
            let b3 = *(path + in_pos + 3) as u32;
            cp = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F);
            step = 4;
        } else {
            cp = 0xFFFD;
            step = 1;
        }
        in_pos = in_pos + step;

        if cp <= 0xFFFF {
            *(wpath + out_pos) = cp as u16;
            out_pos = out_pos + 1;
        } else {
            *(wpath + out_pos) = (0xD800 + ((cp - 0x10000) >> 10)) as u16;
            *(wpath + out_pos + 1) = (0xDC00 + ((cp - 0x10000) & 0x3FF)) as u16;
            out_pos = out_pos + 2;
        }
    }
    *(wpath + out_pos) = 0u16;
    out_pos
}

unsafe fn utf16_null_len(ptr: *const u16) -> usize {
    let mut count: usize = 0;
    while *(ptr + count) != 0u16 {
        count = count + 1;
    }
    count
}

unsafe fn wchars_to_utf8(wchars: *const u16, wlen: usize, buf: *mut u8, cap: usize) -> usize {
    let mut u8_len: usize = 0;
    let mut w_idx: usize = 0;
    while w_idx < wlen {
        let u0 = *(wchars + w_idx) as u32;
        let mut cp: u32 = 0;
        if u0 >= 0xD800 && u0 <= 0xDBFF && w_idx + 1 < wlen {
            let u1 = *(wchars + w_idx + 1) as u32;
            if u1 >= 0xDC00 && u1 <= 0xDFFF {
                cp = 0x10000 + (((u0 - 0xD800) << 10) | (u1 - 0xDC00));
                w_idx = w_idx + 2;
            } else {
                cp = 0xFFFD;
                w_idx = w_idx + 1;
            }
        } else if u0 >= 0xD800 && u0 <= 0xDFFF {
            cp = 0xFFFD;
            w_idx = w_idx + 1;
        } else {
            cp = u0;
            w_idx = w_idx + 1;
        }

        if cp <= 0x7F {
            if u8_len < cap { *(buf + u8_len) = cp as u8; }
            u8_len = u8_len + 1;
        } else if cp <= 0x7FF {
            if u8_len < cap { *(buf + u8_len) = (0xC0 | (cp >> 6)) as u8; }
            if u8_len + 1 < cap { *(buf + u8_len + 1) = (0x80 | (cp & 0x3F)) as u8; }
            u8_len = u8_len + 2;
        } else if cp <= 0xFFFF {
            if u8_len < cap { *(buf + u8_len) = (0xE0 | (cp >> 12)) as u8; }
            if u8_len + 1 < cap { *(buf + u8_len + 1) = (0x80 | ((cp >> 6) & 0x3F)) as u8; }
            if u8_len + 2 < cap { *(buf + u8_len + 2) = (0x80 | (cp & 0x3F)) as u8; }
            u8_len = u8_len + 3;
        } else {
            if u8_len < cap { *(buf + u8_len) = (0xF0 | (cp >> 18)) as u8; }
            if u8_len + 1 < cap { *(buf + u8_len + 1) = (0x80 | ((cp >> 12) & 0x3F)) as u8; }
            if u8_len + 2 < cap { *(buf + u8_len + 2) = (0x80 | ((cp >> 6) & 0x3F)) as u8; }
            if u8_len + 3 < cap { *(buf + u8_len + 3) = (0x80 | (cp & 0x3F)) as u8; }
            u8_len = u8_len + 4;
        }
    }
    u8_len
}

unsafe fn get_dir_table() -> *mut u8 {
    let mut vname: [6]u16 = [65u16, 88u16, 95u16, 68u16, 84u16, 0u16]; // "AX_DT\0"
    let pvname = address_of_mut(vname[0]);
    let mut val: [32]u16 = [0u16; 32];
    let pval = address_of_mut(val[0]);
    let vlen = GetEnvironmentVariableW(pvname, pval, 32);
    if vlen > 0 {
        let mut ptr_val: usize = 0;
        let mut idx: usize = 0;
        while idx < vlen as usize {
            let ch = val[idx];
            let mut digit: usize = 0;
            if ch >= 48u16 && ch <= 57u16 {
                digit = (ch - 48u16) as usize;
            } else if ch >= 97u16 && ch <= 102u16 {
                digit = (ch - 97u16 + 10u16) as usize;
            } else if ch >= 65u16 && ch <= 70u16 {
                digit = (ch - 65u16 + 10u16) as usize;
            }
            ptr_val = (ptr_val << 4) | digit;
            idx = idx + 1;
        }
        return ptr_val as *mut u8;
    }

    let tbl = HeapAlloc(GetProcessHeap(), 8u32, 40000);
    if tbl as usize == 0 {
        return 0 as *mut u8;
    }

    let mut sval: [17]u16 = [0u16; 17];
    let mut cur: usize = tbl as usize;
    let mut pos: usize = 16;
    sval[pos] = 0u16;
    while pos > 0 {
        pos = pos - 1;
        let nibble = (cur & 0x0F) as u16;
        if nibble < 10u16 {
            sval[pos] = 48u16 + nibble;
        } else {
            sval[pos] = 97u16 + (nibble - 10u16);
        }
        cur = cur >> 4;
    }
    SetEnvironmentVariableW(pvname, address_of_mut(sval[0]));
    tbl
}

pub unsafe fn __ax_host_remove(path: *const u8, path_len: usize) -> i64 {
    let mut wpath_buf: [1024]u16 = [0u16; 1024];
    let pwpath = address_of_mut(wpath_buf[0]);
    utf8_to_wpath(path, path_len, pwpath, 1024);
    if DeleteFileW(pwpath) != 0 {
        return 0;
    }
    let mut err = GetLastError();
    if err == 5u32 {
        if RemoveDirectoryW(pwpath) != 0 {
            return 0;
        }
        err = GetLastError();
    }
    if err == 2u32 || err == 3u32 { return -1; }
    if err == 5u32 { return -2; }
    -9
}

pub unsafe fn __ax_host_mkdir(path: *const u8, path_len: usize) -> i64 {
    let mut wpath_buf: [1024]u16 = [0u16; 1024];
    let pwpath = address_of_mut(wpath_buf[0]);
    utf8_to_wpath(path, path_len, pwpath, 1024);
    if CreateDirectoryW(pwpath, 0 as *mut u8) != 0 {
        return 0;
    }
    let err = GetLastError();
    if err == 183u32 { return -3; }
    if err == 3u32 { return -1; }
    if err == 5u32 { return -2; }
    -9
}

pub unsafe fn __ax_host_metadata(path: *const u8, path_len: usize, out: *mut u64) -> i64 {
    let mut wpath_buf: [1024]u16 = [0u16; 1024];
    let pwpath = address_of_mut(wpath_buf[0]);
    utf8_to_wpath(path, path_len, pwpath, 1024);

    let mut data: [10]u32 = [0u32; 10];
    let pdata = address_of_mut(data[0]) as *mut u8;
    if GetFileAttributesExW(pwpath, 0u32, pdata) == 0 {
        let err = GetLastError();
        if err == 2u32 || err == 3u32 { return -1; }
        if err == 5u32 { return -2; }
        return -9;
    }
    let attrs = data[0];
    let mut kind: u64 = 1;
    if (attrs & 0x10u32) != 0 {
        kind = 2;
    } else if (attrs & (0x40u32 | 0x400u32)) != 0 {
        kind = 3;
    }
    let size_high = data[7] as u64;
    let size_low = data[8] as u64;
    let size: u64 = (size_high << 32) | size_low;

    *out = kind;
    *(out + 1) = size;
    0
}

pub unsafe fn __ax_host_dir_open(path: *const u8, path_len: usize) -> i64 {
    let mut wpath_buf: [1024]u16 = [0u16; 1024];
    let pwpath = address_of_mut(wpath_buf[0]);
    let wlen = utf8_to_wpath(path, path_len, pwpath, 1020);
    if wlen == 0 {
        return -4;
    }
    if *(pwpath + (wlen - 1)) == 47u16 || *(pwpath + (wlen - 1)) == 92u16 {
        *(pwpath + wlen) = 42u16; // '*'
        *(pwpath + wlen + 1) = 0u16;
    } else {
        *(pwpath + wlen) = 92u16; // '\\'
        *(pwpath + wlen + 1) = 42u16; // '*'
        *(pwpath + wlen + 2) = 0u16;
    }

    let tbl = get_dir_table();
    if tbl as usize == 0 {
        return -9;
    }

    let mut slot_idx: usize = 0;
    let mut i: usize = 1;
    while i <= 64 {
        let is_open_ptr = (tbl as usize + (i - 1) * 608 + 12) as *mut u32;
        if *is_open_ptr == 0u32 {
            slot_idx = i;
            break;
        }
        i = i + 1;
    }
    if slot_idx == 0 {
        return -9;
    }

    let slot_addr = tbl as usize + (slot_idx - 1) * 608;
    let pffd = (slot_addr + 16) as *mut u8;
    let hFind = FindFirstFileW(pwpath, pffd);
    if hFind as usize == 0xFFFFFFFFFFFFFFFF {
        let err = GetLastError();
        if err == 2u32 || err == 3u32 { return -1; }
        if err == 5u32 { return -2; }
        return -9;
    }

    let phFind = slot_addr as *mut *mut u8;
    let phas_entry = (slot_addr + 8) as *mut u32;
    let pis_open = (slot_addr + 12) as *mut u32;

    *phFind = hFind;
    *phas_entry = 1u32;
    *pis_open = 1u32;

    (1000 + slot_idx) as i64
}

pub unsafe fn __ax_host_dir_next(h: i64, buf: *mut u8, cap: usize) -> i64 {
    if h < 1001 || h > 1064 {
        return -4;
    }
    let tbl = get_dir_table();
    if tbl as usize == 0 {
        return -4;
    }

    let slot_idx = (h - 1000) as usize;
    let slot_addr = tbl as usize + (slot_idx - 1) * 608;
    let pis_open = (slot_addr + 12) as *mut u32;
    if *pis_open == 0u32 {
        return -4;
    }

    let phFind = slot_addr as *mut *mut u8;
    let phas_entry = (slot_addr + 8) as *mut u32;
    let pffd = (slot_addr + 16) as *mut u8;
    let hFind = *phFind;

    while *phas_entry != 0u32 {
        let pwname = (slot_addr + 16 + 44) as *const u16;
        let ch0 = *pwname;
        let ch1 = *(pwname + 1);
        let is_dot = (ch0 == 46u16 && ch1 == 0u16);
        let is_dotdot = (ch0 == 46u16 && ch1 == 46u16 && *(pwname + 2) == 0u16);
        if !is_dot && !is_dotdot {
            break;
        }
        let ok = FindNextFileW(hFind, pffd);
        if ok == 0 {
            *phas_entry = 0u32;
            break;
        }
    }

    if *phas_entry == 0u32 {
        return 0;
    }

    let pwname = (slot_addr + 16 + 44) as *const u16;
    let wlen = utf16_null_len(pwname);
    let u8_len = wchars_to_utf8(pwname, wlen, 0 as *mut u8, 0);

    if u8_len > cap {
        return u8_len as i64;
    }

    wchars_to_utf8(pwname, wlen, buf, cap);

    let ok = FindNextFileW(hFind, pffd);
    if ok == 0 {
        *phas_entry = 0u32;
    }

    u8_len as i64
}

pub fn __ax_host_dir_close(h: i64) -> i64 {
    if h < 1001 || h > 1064 {
        return -4;
    }
    let tbl = unsafe { get_dir_table() };
    if tbl as usize == 0 {
        return -4;
    }

    let slot_idx = (h - 1000) as usize;
    let slot_addr = tbl as usize + (slot_idx - 1) * 608;
    let pis_open = (slot_addr + 12) as *mut u32;
    if unsafe { *pis_open } == 0u32 {
        return -4;
    }

    let phFind = slot_addr as *mut *mut u8;
    let phas_entry = (slot_addr + 8) as *mut u32;
    let hFind = unsafe { *phFind };

    unsafe {
        FindClose(hFind);
        *pis_open = 0u32;
        *phas_entry = 0u32;
        *phFind = 0 as *mut u8;
    }

    0
}

module host_sys_process

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
    fn GetCommandLineW() -> *const u16;
    fn LocalFree(hMem: *mut u8) -> *mut u8;
    fn GetEnvironmentVariableW(lpName: *const u16, lpBuffer: *mut u16, nSize: u32) -> u32;
    fn GetModuleFileNameW(hModule: *mut u8, lpFilename: *mut u16, nSize: u32) -> u32;
    fn ExitProcess(uExitCode: u32);
    fn GetLastError() -> u32;
}

@link("shell32")
extern "system" {
    fn CommandLineToArgvW(lpCmdLine: *const u16, pNumArgs: *mut i32) -> *mut *mut u16;
}

@intrinsic pub unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

pub fn __ax_host_args_count() -> usize {
    let mut num: [1]i32 = [0i32];
    let cmd = unsafe { GetCommandLineW() };
    let argv = unsafe { CommandLineToArgvW(cmd, address_of_mut(num[0])) };
    if argv as usize == 0 {
        return 0;
    }
    let count = num[0] as usize;
    unsafe {
        LocalFree(argv as *mut u8);
    }
    count
}

pub unsafe fn __ax_host_arg(i: usize, buf: *mut u8, cap: usize) -> i64 {
    let mut num: [1]i32 = [0i32];
    let cmd = GetCommandLineW();
    let argv = CommandLineToArgvW(cmd, address_of_mut(num[0]));
    if argv as usize == 0 {
        return -4;
    }
    let count = num[0] as usize;
    if i >= count {
        LocalFree(argv as *mut u8);
        return -4;
    }
    let warg = *(argv + i);
    let mut wlen: usize = 0;
    while *(warg + wlen) != 0u16 {
        wlen = wlen + 1;
    }

    let mut u8_len: usize = 0;
    let mut w_idx: usize = 0;
    while w_idx < wlen {
        let u0 = *(warg + w_idx) as u32;
        let mut cp: u32 = 0;
        if u0 >= 0xD800 && u0 <= 0xDBFF && w_idx + 1 < wlen {
            let u1 = *(warg + w_idx + 1) as u32;
            if u1 >= 0xDC00 && u1 <= 0xDFFF {
                cp = 0x10000 + (((u0 - 0xD800) << 10) | (u1 - 0xDC00));
                w_idx = w_idx + 2;
            } else {
                cp = 0xFFFD;
                w_idx = w_idx + 1;
            }
        } else if u0 >= 0xD800 && u0 <= 0xDFFF {
            cp = 0xFFFD;
            w_idx = w_idx + 1;
        } else {
            cp = u0;
            w_idx = w_idx + 1;
        }

        if cp <= 0x7F {
            if u8_len < cap { *(buf + u8_len) = cp as u8; }
            u8_len = u8_len + 1;
        } else if cp <= 0x7FF {
            if u8_len < cap { *(buf + u8_len) = (0xC0 | (cp >> 6)) as u8; }
            if u8_len + 1 < cap { *(buf + u8_len + 1) = (0x80 | (cp & 0x3F)) as u8; }
            u8_len = u8_len + 2;
        } else if cp <= 0xFFFF {
            if u8_len < cap { *(buf + u8_len) = (0xE0 | (cp >> 12)) as u8; }
            if u8_len + 1 < cap { *(buf + u8_len + 1) = (0x80 | ((cp >> 6) & 0x3F)) as u8; }
            if u8_len + 2 < cap { *(buf + u8_len + 2) = (0x80 | (cp & 0x3F)) as u8; }
            u8_len = u8_len + 3;
        } else {
            if u8_len < cap { *(buf + u8_len) = (0xF0 | (cp >> 18)) as u8; }
            if u8_len + 1 < cap { *(buf + u8_len + 1) = (0x80 | ((cp >> 12) & 0x3F)) as u8; }
            if u8_len + 2 < cap { *(buf + u8_len + 2) = (0x80 | ((cp >> 6) & 0x3F)) as u8; }
            if u8_len + 3 < cap { *(buf + u8_len + 3) = (0x80 | (cp & 0x3F)) as u8; }
            u8_len = u8_len + 4;
        }
    }

    LocalFree(argv as *mut u8);
    u8_len as i64
}

pub unsafe fn __ax_host_env_get(name: *const u8, name_len: usize, buf: *mut u8, cap: usize) -> i64 {
    let mut wname: [256]u16 = [0u16; 256];
    let mut in_pos: usize = 0;
    let mut out_pos: usize = 0;
    while in_pos < name_len && out_pos + 2 < 256 {
        let b0 = *(name + in_pos) as u32;
        let mut cp: u32 = 0;
        let mut step: usize = 1;
        if b0 < 0x80 {
            cp = b0;
            step = 1;
        } else if (b0 & 0xE0) == 0xC0 && in_pos + 1 < name_len {
            let b1 = *(name + in_pos + 1) as u32;
            cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F);
            step = 2;
        } else if (b0 & 0xF0) == 0xE0 && in_pos + 2 < name_len {
            let b1 = *(name + in_pos + 1) as u32;
            let b2 = *(name + in_pos + 2) as u32;
            cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F);
            step = 3;
        } else {
            cp = 0xFFFD;
            step = 1;
        }
        in_pos = in_pos + step;
        if cp <= 0xFFFF {
            wname[out_pos] = cp as u16;
            out_pos = out_pos + 1;
        } else {
            wname[out_pos] = (0xD800 + ((cp - 0x10000) >> 10)) as u16;
            wname[out_pos + 1] = (0xDC00 + ((cp - 0x10000) & 0x3FF)) as u16;
            out_pos = out_pos + 2;
        }
    }
    wname[out_pos] = 0u16;

    let pwname = address_of_mut(wname[0]);
    let needed = GetEnvironmentVariableW(pwname, 0 as *mut u16, 0);
    if needed == 0 {
        let err = GetLastError();
        if err == 203u32 {
            return -1;
        }
        return -9;
    }

    let wval = HeapAlloc(GetProcessHeap(), 8u32, (needed as usize + 1) * 2) as *mut u16;
    if wval as usize == 0 {
        return -9;
    }
    GetEnvironmentVariableW(pwname, wval, needed);

    let mut u8_len: usize = 0;
    let mut w_idx: usize = 0;
    let wval_len = (needed - 1) as usize;
    while w_idx < wval_len {
        let u0 = *(wval + w_idx) as u32;
        let mut cp: u32 = 0;
        if u0 >= 0xD800 && u0 <= 0xDBFF && w_idx + 1 < wval_len {
            let u1 = *(wval + w_idx + 1) as u32;
            if u1 >= 0xDC00 && u1 <= 0xDFFF {
                cp = 0x10000 + (((u0 - 0xD800) << 10) | (u1 - 0xDC00));
                w_idx = w_idx + 2;
            } else {
                cp = 0xFFFD;
                w_idx = w_idx + 1;
            }
        } else if u0 >= 0xD800 && u0 <= 0xDFFF {
            cp = 0xFFFD;
            w_idx = w_idx + 1;
        } else {
            cp = u0;
            w_idx = w_idx + 1;
        }

        if cp <= 0x7F {
            if u8_len < cap { *(buf + u8_len) = cp as u8; }
            u8_len = u8_len + 1;
        } else if cp <= 0x7FF {
            if u8_len < cap { *(buf + u8_len) = (0xC0 | (cp >> 6)) as u8; }
            if u8_len + 1 < cap { *(buf + u8_len + 1) = (0x80 | (cp & 0x3F)) as u8; }
            u8_len = u8_len + 2;
        } else if cp <= 0xFFFF {
            if u8_len < cap { *(buf + u8_len) = (0xE0 | (cp >> 12)) as u8; }
            if u8_len + 1 < cap { *(buf + u8_len + 1) = (0x80 | ((cp >> 6) & 0x3F)) as u8; }
            if u8_len + 2 < cap { *(buf + u8_len + 2) = (0x80 | (cp & 0x3F)) as u8; }
            u8_len = u8_len + 3;
        } else {
            if u8_len < cap { *(buf + u8_len) = (0xF0 | (cp >> 18)) as u8; }
            if u8_len + 1 < cap { *(buf + u8_len + 1) = (0x80 | ((cp >> 12) & 0x3F)) as u8; }
            if u8_len + 2 < cap { *(buf + u8_len + 2) = (0x80 | ((cp >> 6) & 0x3F)) as u8; }
            if u8_len + 3 < cap { *(buf + u8_len + 3) = (0x80 | (cp & 0x3F)) as u8; }
            u8_len = u8_len + 4;
        }
    }

    HeapFree(GetProcessHeap(), 0u32, wval as *mut u8);
    u8_len as i64
}

pub unsafe fn __ax_host_exe_path(buf: *mut u8, cap: usize) -> i64 {
    let wbuf = HeapAlloc(GetProcessHeap(), 8u32, 4096) as *mut u16;
    if wbuf as usize == 0 {
        return -9;
    }
    let wlen = GetModuleFileNameW(0 as *mut u8, wbuf, 2048);
    if wlen == 0 {
        HeapFree(GetProcessHeap(), 0u32, wbuf as *mut u8);
        return -9;
    }

    let mut u8_len: usize = 0;
    let mut w_idx: usize = 0;
    while w_idx < wlen as usize {
        let u0 = *(wbuf + w_idx) as u32;
        let mut cp: u32 = 0;
        if u0 >= 0xD800 && u0 <= 0xDBFF && w_idx + 1 < wlen as usize {
            let u1 = *(wbuf + w_idx + 1) as u32;
            if u1 >= 0xDC00 && u1 <= 0xDFFF {
                cp = 0x10000 + (((u0 - 0xD800) << 10) | (u1 - 0xDC00));
                w_idx = w_idx + 2;
            } else {
                cp = 0xFFFD;
                w_idx = w_idx + 1;
            }
        } else if u0 >= 0xD800 && u0 <= 0xDFFF {
            cp = 0xFFFD;
            w_idx = w_idx + 1;
        } else {
            cp = u0;
            w_idx = w_idx + 1;
        }

        let ch_to_write: u32 = if cp == 92 { 47 } else { cp }; // replace '\' with '/'

        if ch_to_write <= 0x7F {
            if u8_len < cap { *(buf + u8_len) = ch_to_write as u8; }
            u8_len = u8_len + 1;
        } else if ch_to_write <= 0x7FF {
            if u8_len < cap { *(buf + u8_len) = (0xC0 | (ch_to_write >> 6)) as u8; }
            if u8_len + 1 < cap { *(buf + u8_len + 1) = (0x80 | (ch_to_write & 0x3F)) as u8; }
            u8_len = u8_len + 2;
        } else if ch_to_write <= 0xFFFF {
            if u8_len < cap { *(buf + u8_len) = (0xE0 | (ch_to_write >> 12)) as u8; }
            if u8_len + 1 < cap { *(buf + u8_len + 1) = (0x80 | ((ch_to_write >> 6) & 0x3F)) as u8; }
            if u8_len + 2 < cap { *(buf + u8_len + 2) = (0x80 | (ch_to_write & 0x3F)) as u8; }
            u8_len = u8_len + 3;
        } else {
            if u8_len < cap { *(buf + u8_len) = (0xF0 | (ch_to_write >> 18)) as u8; }
            if u8_len + 1 < cap { *(buf + u8_len + 1) = (0x80 | ((ch_to_write >> 12) & 0x3F)) as u8; }
            if u8_len + 2 < cap { *(buf + u8_len + 2) = (0x80 | ((ch_to_write >> 6) & 0x3F)) as u8; }
            if u8_len + 3 < cap { *(buf + u8_len + 3) = (0x80 | (ch_to_write & 0x3F)) as u8; }
            u8_len = u8_len + 4;
        }
    }

    HeapFree(GetProcessHeap(), 0u32, wbuf as *mut u8);
    u8_len as i64
}

pub fn __ax_host_exit(code: i32) {
    unsafe {
        ExitProcess(code as u32);
    }
}

module host_sys_time

@link("kernel32")
extern "system" {
    fn QueryPerformanceCounter(lpPerformanceCount: *mut i64) -> i32;
    fn QueryPerformanceFrequency(lpFrequency: *mut i64) -> i32;
}

@intrinsic pub unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

pub fn __ax_host_monotonic_ns() -> u64 {
    let mut count: [1]i64 = [0i64];
    let mut freq: [1]i64 = [0i64];
    let ok1 = unsafe { QueryPerformanceCounter(address_of_mut(count[0])) };
    let ok2 = unsafe { QueryPerformanceFrequency(address_of_mut(freq[0])) };
    if ok1 == 0 || ok2 == 0 {
        return 0u64;
    }
    let f = freq[0] as u64;
    let c = count[0] as u64;
    if f == 0u64 {
        return 0u64;
    }
    let s = c / f;
    let rem = c % f;
    s * 1_000_000_000u64 + (rem * 1_000_000_000u64) / f
}

module compiler.kernel.id

use std.core.host.heap_alloc
use std.core.host.heap_free

@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

// Typed ID Newtypes (INV-KERN-001, 0171 AKERNEL-24, 0153 ACKERNEL-20)
// Convention: v == 0 is none / invalid; v = table_index + 1.

pub struct StrId {
    pub v: u32,
}

impl StrId {
    pub fn none() -> StrId { StrId { v: 0 } }
    pub fn is_none(self: view<StrId>) -> bool { self.v == 0 }
    pub fn is_some(self: view<StrId>) -> bool { self.v != 0 }
    pub fn eq(self: view<StrId>, other: view<StrId>) -> bool { self.v == other.v }
}

pub struct FileId {
    pub v: u32,
}

impl FileId {
    pub fn none() -> FileId { FileId { v: 0 } }
    pub fn is_none(self: view<FileId>) -> bool { self.v == 0 }
    pub fn is_some(self: view<FileId>) -> bool { self.v != 0 }
    pub fn eq(self: view<FileId>, other: view<FileId>) -> bool { self.v == other.v }
}

pub struct NodeId {
    pub v: u32,
}

impl NodeId {
    pub fn none() -> NodeId { NodeId { v: 0 } }
    pub fn is_none(self: view<NodeId>) -> bool { self.v == 0 }
    pub fn is_some(self: view<NodeId>) -> bool { self.v != 0 }
    pub fn eq(self: view<NodeId>, other: view<NodeId>) -> bool { self.v == other.v }
}

pub struct SymbolId {
    pub v: u32,
}

impl SymbolId {
    pub fn none() -> SymbolId { SymbolId { v: 0 } }
    pub fn is_none(self: view<SymbolId>) -> bool { self.v == 0 }
    pub fn is_some(self: view<SymbolId>) -> bool { self.v != 0 }
    pub fn eq(self: view<SymbolId>, other: view<SymbolId>) -> bool { self.v == other.v }
}

pub struct TypeId {
    pub v: u32,
}

impl TypeId {
    pub fn none() -> TypeId { TypeId { v: 0 } }
    pub fn is_none(self: view<TypeId>) -> bool { self.v == 0 }
    pub fn is_some(self: view<TypeId>) -> bool { self.v != 0 }
    pub fn eq(self: view<TypeId>, other: view<TypeId>) -> bool { self.v == other.v }
}

module compiler.kernel.hash

fn wrapping_add_u64(a: u64, b: u64) -> u64 {
    let a_lo = a & 0xFFFFFFFFu64;
    let a_hi = (a >> 32u64) & 0xFFFFFFFFu64;
    let b_lo = b & 0xFFFFFFFFu64;
    let b_hi = (b >> 32u64) & 0xFFFFFFFFu64;
    let sum_lo = a_lo + b_lo;
    let carry = sum_lo >> 32u64;
    let sum_hi = (a_hi + b_hi + carry) & 0xFFFFFFFFu64;
    (sum_hi << 32u64) | (sum_lo & 0xFFFFFFFFu64)
}
fn mul_u16_hash(x: u64, y: u64) -> u64 {
    ((x as i64) * (y as i64)) as u64
}
fn wrapping_mul_u64(a: u64, b: u64) -> u64 {
    let a0 = a & 0xFFFFu64;
    let a1 = (a >> 16u64) & 0xFFFFu64;
    let a2 = (a >> 32u64) & 0xFFFFu64;
    let a3 = (a >> 48u64) & 0xFFFFu64;
    let b0 = b & 0xFFFFu64;
    let b1 = (b >> 16u64) & 0xFFFFu64;
    let b2 = (b >> 32u64) & 0xFFFFu64;
    let b3 = (b >> 48u64) & 0xFFFFu64;
    let c0 = mul_u16_hash(a0, b0);
    let c1 = (c0 >> 16u64) + mul_u16_hash(a0, b1) + mul_u16_hash(a1, b0);
    let c2 = (c1 >> 16u64) + mul_u16_hash(a0, b2) + mul_u16_hash(a1, b1) + mul_u16_hash(a2, b0);
    let c3 = ((c2 >> 16u64) + mul_u16_hash(a0, b3) + mul_u16_hash(a1, b2) + mul_u16_hash(a2, b1) + mul_u16_hash(a3, b0)) & 0xFFFFu64;
    (c0 & 0xFFFFu64) | ((c1 & 0xFFFFu64) << 16u64) | ((c2 & 0xFFFFu64) << 32u64) | (c3 << 48u64)
}
fn rotate_left_u64(x: u64, n: u32) -> u64 {
    let s = (n & 63u32) as u64;
    if s == 0u64 { x } else { (x << s) | (x >> (64u64 - s)) }
}

// AXH64 v1 constants (matching bootstrap/axiom0/src/kernel/hash.c and ADR-0004 §4)
pub const AXH_K1: u64 = 0x9E3779B97F4A7C15;
pub const AXH_K2: u64 = 0xC2B2AE3D27D4EB4F;
pub const AXH_K3: u64 = 0x165667B19E3779F9;
pub const AXH_SEED: u64 = 0x27D4EB2F165667C5;
pub const AXH_M: u64 = 0x9FB21C651E98DF25;

pub fn ax_rotl64(x: u64, n: u32) -> u64 {
    rotate_left_u64(x, n)
}

fn axh_round(h: u64, w: u64) -> u64 {
    let m = wrapping_mul_u64(ax_rotl64(wrapping_mul_u64(w, AXH_K2), 31u32), AXH_K1);
    wrapping_add_u64(wrapping_mul_u64(ax_rotl64(h ^ m, 27u32), AXH_K1), AXH_K3)
}

fn axh_fold(h: u64) -> u64 {
    h ^ ax_rotl64(h, 15u32) ^ ax_rotl64(h, 40u32)
}

fn axh_avalanche(mut h: u64) -> u64 {
    h = wrapping_mul_u64(axh_fold(h), AXH_M);
    h = wrapping_mul_u64(axh_fold(h), AXH_K2);
    axh_fold(h)
}

pub struct AxHasher {
    pub h: u64,
    pub total_len: u64,
    pub buf: [8]u8,
    pub buf_len: usize,
}

pub fn ax_hasher_new() -> AxHasher {
    AxHasher {
        h: AXH_SEED,
        total_len: 0u64,
        buf: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8],
        buf_len: 0,
    }
}

pub fn ax_hasher_init(s: mut_view<AxHasher>) {
    s.h = AXH_SEED;
    s.total_len = 0u64;
    s.buf[0] = 0u8;
    s.buf[1] = 0u8;
    s.buf[2] = 0u8;
    s.buf[3] = 0u8;
    s.buf[4] = 0u8;
    s.buf[5] = 0u8;
    s.buf[6] = 0u8;
    s.buf[7] = 0u8;
    s.buf_len = 0;
}

pub fn ax_hasher_write(s: mut_view<AxHasher>, bytes: *const u8, mut byte_len: usize) {
    let mut p = bytes;
    s.total_len = wrapping_add_u64(s.total_len, byte_len as u64);
    while byte_len > 0 {
        if s.buf_len == 0 && byte_len >= 8 {
            let mut w: u64 = 0;
            let mut j: usize = 0;
            while j < 8 {
                let b = unsafe { *(p + j) } as u64;
                w = w | (b << (8 * j as u32));
                j = j + 1;
            }
            s.h = axh_round(s.h, w);
            p = unsafe { p + 8 };
            byte_len = byte_len - 8;
            continue;
        }
        s.buf[s.buf_len] = unsafe { *p };
        s.buf_len = s.buf_len + 1;
        p = unsafe { p + 1 };
        byte_len = byte_len - 1;
        if s.buf_len == 8 {
            let mut w: u64 = 0;
            let mut j: usize = 0;
            while j < 8 {
                let b = s.buf[j] as u64;
                w = w | (b << (8 * j as u32));
                j = j + 1;
            }
            s.h = axh_round(s.h, w);
            s.buf_len = 0;
        }
    }
}

pub fn ax_hasher_write_u32(s: mut_view<AxHasher>, mut v: u32) {
    let mut i: usize = 0;
    while i < 4 {
        s.total_len = wrapping_add_u64(s.total_len, 1u64);
        s.buf[s.buf_len] = (v & 0xFFu32) as u8;
        s.buf_len = s.buf_len + 1;
        if s.buf_len == 8 {
            let mut w: u64 = 0;
            let mut j: usize = 0;
            while j < 8 {
                let b = s.buf[j] as u64;
                w = w | (b << (8 * j as u32));
                j = j + 1;
            }
            s.h = axh_round(s.h, w);
            s.buf_len = 0;
        }
        v = v >> 8u32;
        i = i + 1;
    }
}

pub fn ax_hasher_write_u64(s: mut_view<AxHasher>, mut v: u64) {
    let mut i: usize = 0;
    while i < 8 {
        s.total_len = wrapping_add_u64(s.total_len, 1u64);
        s.buf[s.buf_len] = (v & 0xFFu64) as u8;
        s.buf_len = s.buf_len + 1;
        if s.buf_len == 8 {
            let mut w: u64 = 0;
            let mut j: usize = 0;
            while j < 8 {
                let b = s.buf[j] as u64;
                w = w | (b << (8 * j as u32));
                j = j + 1;
            }
            s.h = axh_round(s.h, w);
            s.buf_len = 0;
        }
        v = v >> 8u32;
        i = i + 1;
    }
}

pub fn ax_hasher_finish(s: view<AxHasher>) -> u64 {
    let mut h = s.h;
    if s.buf_len > 0 {
        let mut w: u64 = 0;
        let mut j: usize = 0;
        while j < s.buf_len {
            let b = s.buf[j] as u64;
            w = w | (b << (8 * j as u32));
            j = j + 1;
        }
        h = axh_round(h, w);
    }
    h = h ^ wrapping_mul_u64(s.total_len, AXH_K3);
    axh_avalanche(h)
}

pub fn ax_hash_bytes(bytes: *const u8, byte_len: usize) -> u64 {
    let mut s = ax_hasher_new();
    ax_hasher_write(mut_view(s), bytes, byte_len);
    ax_hasher_finish(view(s))
}

pub fn ax_hash_u32(v: u32) -> u64 {
    let mut s = ax_hasher_new();
    ax_hasher_write_u32(mut_view(s), v);
    ax_hasher_finish(view(s))
}

pub fn ax_hash_u64(v: u64) -> u64 {
    let mut s = ax_hasher_new();
    ax_hasher_write_u64(mut_view(s), v);
    ax_hasher_finish(view(s))
}

pub fn ax_hash_combine(a: u64, b: u64) -> u64 {
    let mut s = ax_hasher_new();
    ax_hasher_write_u64(mut_view(s), a);
    ax_hasher_write_u64(mut_view(s), b);
    ax_hasher_finish(view(s))
}

module compiler.kernel.arena

use std.core.host.heap_alloc
use std.core.host.heap_free

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub const AX_ARENA_DEFAULT_CHUNK: usize = 65536;
pub const AX_ARENA_MAX_ALIGN: usize = 4096;

pub struct ArenaChunk {
    pub next: *mut ArenaChunk,
    pub cap: usize,
    pub used: usize,
    pub data: *mut u8,
}

pub struct Arena {
    pub head: *mut ArenaChunk,
    pub current: *mut ArenaChunk,
    pub chunk_size: usize,
    pub bytes_requested: usize,
    pub chunk_count: usize,
    pub chunks_allocated: usize,
    pub chunks_freed: usize,
}

pub fn arena_new() -> Arena {
    arena_with_chunk_size(AX_ARENA_DEFAULT_CHUNK)
}

pub fn arena_with_chunk_size(chunk_size: usize) -> Arena {
    let sz = if chunk_size == 0 { AX_ARENA_DEFAULT_CHUNK } else { chunk_size };
    Arena {
        head: null_mut<ArenaChunk>(),
        current: null_mut<ArenaChunk>(),
        chunk_size: sz,
        bytes_requested: 0,
        chunk_count: 0,
        chunks_allocated: 0,
        chunks_freed: 0,
    }
}

pub fn arena_alloc_raw(a: mut_view<Arena>, size: usize, align: usize) -> *mut u8 {
    let mut al = align;
    if al == 0 { al = 1; }
    if al > AX_ARENA_MAX_ALIGN { al = AX_ARENA_MAX_ALIGN; }
    let mask: usize = al - 1;
    a.bytes_requested = a.bytes_requested + size;

    if a.current as usize != 0 {
        let cur: *mut ArenaChunk = a.current;
        let c_addr: usize = unsafe { (*cur).data as usize };
        let u: usize = unsafe { (*cur).used };
        let cur_addr: usize = c_addr + u;
        let al_addr: usize = (cur_addr + mask) & ~mask;
        let off: usize = al_addr - c_addr;
        let cap: usize = unsafe { (*cur).cap };
        if cap >= off {
            let rem_cap: usize = cap - off;
            if rem_cap >= size {
                unsafe {
                    (*cur).used = off + size;
                }
                let ptr: *mut u8 = unsafe { (*cur).data + off };
                return ptr;
            }
        }
    }

    let need: usize = size + (al - 1);
    let payload: usize = if need > a.chunk_size { need } else { a.chunk_size };
    let raw: *mut u8 = unsafe { heap_alloc(payload, 16) };
    let hdr: *mut ArenaChunk = unsafe { heap_alloc(size_of<ArenaChunk>(), align_of<ArenaChunk>()) as *mut ArenaChunk };
    unsafe {
        (*hdr).next = null_mut<ArenaChunk>();
        (*hdr).cap = payload;
        (*hdr).used = 0;
        (*hdr).data = raw;
    }

    if a.head as usize == 0 {
        a.head = hdr;
    } else {
        unsafe {
            (*a.current).next = hdr;
        }
    }
    a.current = hdr;
    a.chunk_count = a.chunk_count + 1;
    a.chunks_allocated = a.chunks_allocated + 1;

    let c_addr: usize = raw as usize;
    let al_addr: usize = (c_addr + mask) & ~mask;
    let off: usize = al_addr - c_addr;
    unsafe {
        (*hdr).used = off + size;
    }
    let ptr: *mut u8 = unsafe { raw + off };
    ptr
}

pub fn arena_alloc<T>(a: mut_view<Arena>, val: T) -> *mut T {
    let sz = size_of<T>();
    let al = align_of<T>();
    let ptr = arena_alloc_raw(a, sz, al) as *mut T;
    unsafe {
        *ptr = val;
    }
    ptr
}

pub fn arena_alloc_array<T>(a: mut_view<Arena>, count: usize) -> *mut T {
    let sz = size_of<T>();
    let al = align_of<T>();
    arena_alloc_raw(a, (((count as isize) * (sz as isize)) as usize), al) as *mut T
}

pub fn arena_dup(a: mut_view<Arena>, src: *const u8, size: usize) -> *mut u8 {
    let ptr = arena_alloc_raw(a, size, 1);
    if size > 0 && src as usize != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(src, ptr, size);
        }
    }
    ptr
}

pub fn arena_reset(a: mut_view<Arena>) {
    if a.head as usize == 0 {
        a.bytes_requested = 0;
        return;
    }
    let mut c: *mut ArenaChunk = unsafe { (*a.head).next };
    while c as usize != 0 {
        let next: *mut ArenaChunk = unsafe { (*c).next };
        unsafe {
            heap_free((*c).data, (*c).cap, 16);
            heap_free(c as *mut u8, size_of<ArenaChunk>(), align_of<ArenaChunk>());
        }
        a.chunks_freed = a.chunks_freed + 1;
        c = next;
    }
    unsafe {
        (*a.head).next = null_mut<ArenaChunk>();
        (*a.head).used = 0;
    }
    a.current = a.head;
    a.chunk_count = 1;
    a.bytes_requested = 0;
}

pub fn arena_destroy(a: mut_view<Arena>) {
    let mut c: *mut ArenaChunk = a.head;
    while c as usize != 0 {
        let next: *mut ArenaChunk = unsafe { (*c).next };
        unsafe {
            heap_free((*c).data, (*c).cap, 16);
            heap_free(c as *mut u8, size_of<ArenaChunk>(), align_of<ArenaChunk>());
        }
        a.chunks_freed = a.chunks_freed + 1;
        c = next;
    }
    a.head = null_mut<ArenaChunk>();
    a.current = null_mut<ArenaChunk>();
    a.chunk_count = 0;
    a.bytes_requested = 0;
}

pub fn arena_bytes_requested(a: view<Arena>) -> usize {
    a.bytes_requested
}

pub fn arena_chunk_count(a: view<Arena>) -> usize {
    a.chunk_count
}

pub fn arena_chunks_allocated(a: view<Arena>) -> usize {
    a.chunks_allocated
}

pub fn arena_chunks_freed(a: view<Arena>) -> usize {
    a.chunks_freed
}

pub fn arena_chunks_in_use(a: view<Arena>) -> usize {
    a.chunks_allocated - a.chunks_freed
}

impl Drop for Arena {
    fn drop(self: mut_view<Arena>) {
        arena_destroy(self);
    }
}

module compiler.kernel.interner

use std.core.host.heap_alloc
use std.core.host.heap_free
use compiler.kernel.hash.ax_hash_bytes
use compiler.kernel.hash.ax_hash_u32
use compiler.kernel.arena.Arena
use compiler.kernel.arena.arena_new
use compiler.kernel.arena.arena_destroy
use compiler.kernel.arena.arena_alloc_raw
use compiler.kernel.id.StrId

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub struct StrView {
    pub ptr: *const u8,
    pub len: usize,
}

pub struct StrInterner {
    pub bytes: Arena,
    pub strings: *mut StrView,
    pub len: usize,
    pub cap: usize,
    pub map_hashes: *mut u64,
    pub map_ids: *mut u32,
    pub map_cap: usize,
}

fn bytes_eq(a: *const u8, b: *const u8, n: usize) -> bool {
    let mut i: usize = 0;
    while i < n {
        if unsafe { *(a + i) } != unsafe { *(b + i) } {
            return false;
        }
        i = i + 1;
    }
    true
}

pub fn interner_init(in_: mut_view<StrInterner>) {
    in_.bytes = arena_new();
    in_.strings = 0 as *mut StrView;
    in_.len = 0;
    in_.cap = 0;
    in_.map_hashes = 0 as *mut u64;
    in_.map_ids = 0 as *mut u32;
    in_.map_cap = 0;
}

pub fn interner_new() -> StrInterner {
    let a = arena_new();
    StrInterner {
        bytes: a,
        strings: 0 as *mut StrView,
        len: 0,
        cap: 0,
        map_hashes: 0 as *mut u64,
        map_ids: 0 as *mut u32,
        map_cap: 0,
    }
}

pub fn interner_free(in_: mut_view<StrInterner>) {
    arena_destroy(mut_view(in_.bytes));
    if in_.cap > 0 && in_.strings as usize != 0 {
        unsafe {
            heap_free(in_.strings as *mut u8, (((in_.cap as isize) * (size_of<StrView>() as isize)) as usize), align_of<StrView>());
        }
    }
    if in_.map_cap > 0 && in_.map_hashes as usize != 0 {
        unsafe {
            heap_free(in_.map_hashes as *mut u8, (in_.map_cap << 3), 8);
            heap_free(in_.map_ids as *mut u8, (in_.map_cap << 2), 4);
        }
    }
    in_.strings = 0 as *mut StrView;
    in_.len = 0;
    in_.cap = 0;
    in_.map_hashes = 0 as *mut u64;
    in_.map_ids = 0 as *mut u32;
    in_.map_cap = 0;
}

fn interner_grow_map(in_: mut_view<StrInterner>) {
    let new_cap: usize = if in_.map_cap == 0 { 16 } else { in_.map_cap + in_.map_cap };
    let new_hashes: *mut u64 = unsafe { heap_alloc((new_cap << 3), 8) as *mut u64 };
    let new_ids: *mut u32 = unsafe { heap_alloc((new_cap << 2), 4) as *mut u32 };
    let mut j: usize = 0;
    while j < new_cap {
        unsafe {
            *(new_ids + j) = 0u32;
        }
        j = j + 1;
    }

    let mask = new_cap - 1;
    let mut i: usize = 0;
    while i < in_.len {
        let sv = unsafe { *(in_.strings + i) };
        let h = ax_hash_bytes(sv.ptr, sv.len);
        let mut slot = (h as usize) & mask;
        while unsafe { *(new_ids + slot) } != 0u32 {
            slot = (slot + 1) & mask;
        }
        unsafe {
            *(new_hashes + slot) = h;
            *(new_ids + slot) = (i + 1) as u32;
        }
        i = i + 1;
    }

    if in_.map_cap > 0 && in_.map_hashes as usize != 0 {
        unsafe {
            heap_free(in_.map_hashes as *mut u8, (in_.map_cap << 3), 8);
            heap_free(in_.map_ids as *mut u8, (in_.map_cap << 2), 4);
        }
    }
    in_.map_hashes = new_hashes;
    in_.map_ids = new_ids;
    in_.map_cap = new_cap;
}

pub fn interner_intern_bytes(in_: mut_view<StrInterner>, p_s: *const u8, n: usize) -> StrId {
    let h = ax_hash_bytes(p_s, n);

    if in_.map_cap > 0 {
        let mask = in_.map_cap - 1;
        let mut slot = (h as usize) & mask;
        while true {
            let id_v = unsafe { *(in_.map_ids + slot) };
            if id_v == 0u32 {
                break;
            }
            if unsafe { *(in_.map_hashes + slot) } == h {
                let sv = unsafe { *(in_.strings + ((id_v - 1) as usize)) };
                if sv.len == n && bytes_eq(sv.ptr, p_s, n) {
                    return StrId { v: id_v };
                }
            }
            slot = (slot + 1) & mask;
        }
    }

    let copy = arena_alloc_raw(mut_view(in_.bytes), n + 1, 1);
    if n > 0 && p_s as usize != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(p_s, copy, n);
            *(copy + n) = 0u8;
        }
    }

    if in_.len == in_.cap {
        let new_cap: usize = if in_.cap == 0 { 8 } else { in_.cap + in_.cap };
        let new_strings: *mut StrView = unsafe { heap_alloc((((new_cap as isize) * (size_of<StrView>() as isize)) as usize), align_of<StrView>()) as *mut StrView };
        if in_.len > 0 && in_.strings as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<StrView>(in_.strings as *const StrView, new_strings, in_.len);
                heap_free(in_.strings as *mut u8, (((in_.cap as isize) * (size_of<StrView>() as isize)) as usize), align_of<StrView>());
            }
        }
        in_.strings = new_strings;
        in_.cap = new_cap;
    }

    let sv = StrView { ptr: copy as *const u8, len: n };
    unsafe {
        *(in_.strings + in_.len) = sv;
    }
    let new_id = StrId { v: (in_.len + 1) as u32 };
    in_.len = in_.len + 1;

    if in_.map_cap == 0 || ((in_.len as isize) * 4isize) > ((in_.map_cap as isize) * 3isize) {
        interner_grow_map(in_);
    } else {
        let mask = in_.map_cap - 1;
        let mut slot = (h as usize) & mask;
        while unsafe { *(in_.map_ids + slot) } != 0u32 {
            slot = (slot + 1) & mask;
        }
        unsafe {
            *(in_.map_hashes + slot) = h;
            *(in_.map_ids + slot) = new_id.v;
        }
    }

    new_id
}

pub fn interner_intern_str(in_: mut_view<StrInterner>, s: view<Str>) -> StrId {
    let p_s = unsafe { *(address_of(*s) as *const *const u8) };
    let n = len(*s);
    interner_intern_bytes(in_, p_s, n)
}

pub fn interner_lookup_bytes(in_: view<StrInterner>, p_s: *const u8, n: usize) -> StrId {
    if in_.map_cap == 0 || in_.len == 0 {
        return StrId.none();
    }
    let h = ax_hash_bytes(p_s, n);
    let mask = in_.map_cap - 1;
    let mut slot = (h as usize) & mask;
    while true {
        let id_v = unsafe { *(in_.map_ids + slot) };
        if id_v == 0u32 {
            return StrId.none();
        }
        if unsafe { *(in_.map_hashes + slot) } == h {
            let sv = unsafe { *(in_.strings + ((id_v - 1) as usize)) };
            if sv.len == n && bytes_eq(sv.ptr, p_s, n) {
                return StrId { v: id_v };
            }
        }
        slot = (slot + 1) & mask;
    }
    StrId.none()
}

pub fn interner_lookup_str(in_: view<StrInterner>, s: view<Str>) -> StrId {
    let p_s = unsafe { *(address_of(*s) as *const *const u8) };
    let n = len(*s);
    interner_lookup_bytes(in_, p_s, n)
}

pub fn interner_get(in_: view<StrInterner>, id: StrId) -> StrView {
    if id.v == 0 || (id.v as usize) > in_.len {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    unsafe {
        *(in_.strings + ((id.v - 1) as usize))
    }
}

pub fn interner_len(in_: view<StrInterner>) -> usize {
    in_.len
}

pub fn interner_is_empty(in_: view<StrInterner>) -> bool {
    in_.len == 0
}

// U32Interner — Deterministic hash-consing for 32-bit values
pub struct U32Interner {
    pub items: *mut u32,
    pub len: usize,
    pub cap: usize,
    pub map_hashes: *mut u64,
    pub map_ids: *mut u32,
    pub map_cap: usize,
}

pub fn u32_interner_new() -> U32Interner {
    U32Interner {
        items: 0 as *mut u32,
        len: 0,
        cap: 0,
        map_hashes: 0 as *mut u64,
        map_ids: 0 as *mut u32,
        map_cap: 0,
    }
}

pub fn u32_interner_free(in_: mut_view<U32Interner>) {
    if in_.cap > 0 && in_.items as usize != 0 {
        unsafe {
            heap_free(in_.items as *mut u8, (in_.cap << 2), 4);
        }
    }
    if in_.map_cap > 0 && in_.map_hashes as usize != 0 {
        unsafe {
            heap_free(in_.map_hashes as *mut u8, (in_.map_cap << 3), 8);
            heap_free(in_.map_ids as *mut u8, (in_.map_cap << 2), 4);
        }
    }
    in_.items = 0 as *mut u32;
    in_.len = 0;
    in_.cap = 0;
    in_.map_hashes = 0 as *mut u64;
    in_.map_ids = 0 as *mut u32;
    in_.map_cap = 0;
}

module compiler.source.span

use compiler.kernel.id.FileId

pub struct Span {
    pub file: FileId,
    pub start: u32,
    pub end: u32,
}

impl Span {
    pub fn new(file: FileId, start: u32, end: u32) -> Span {
        Span { file: file, start: start, end: end }
    }

    pub fn none() -> Span {
        Span { file: FileId.none(), start: 0u32, end: 0u32 }
    }

    pub fn is_none(self: view<Span>) -> bool {
        self.file.is_none()
    }

    pub fn is_some(self: view<Span>) -> bool {
        self.file.is_some()
    }

    pub fn len(self: view<Span>) -> u32 {
        if self.end >= self.start {
            self.end - self.start
        } else {
            0u32
        }
    }

    pub fn eq(self: view<Span>, other: view<Span>) -> bool {
        self.file.eq(view(other.file)) && self.start == other.start && self.end == other.end
    }
}

pub fn span_new(file: FileId, start: u32, end: u32) -> Span {
    Span.new(file, start, end)
}

pub fn span_none() -> Span {
    Span.none()
}

pub fn span_is_none(s: view<Span>) -> bool {
    s.is_none()
}

pub struct LineCol {
    pub line: u32,       // 1-based line number
    pub col_bytes: u32,  // 1-based column in bytes
    pub col_chars: u32,  // 1-based column in Unicode scalar values
}

impl LineCol {
    pub fn zero() -> LineCol {
        LineCol { line: 0u32, col_bytes: 0u32, col_chars: 0u32 }
    }

    pub fn eq(self: view<LineCol>, other: view<LineCol>) -> bool {
        self.line == other.line && self.col_bytes == other.col_bytes && self.col_chars == other.col_chars
    }
}

module compiler.source.manager

use std.core.host.heap_alloc
use std.core.host.heap_free

use compiler.kernel.arena.Arena
use compiler.kernel.arena.arena_new
use compiler.kernel.arena.arena_alloc_raw
use compiler.kernel.arena.arena_destroy
use compiler.kernel.hash.ax_hash_bytes
use compiler.kernel.id.FileId
use compiler.kernel.interner.StrView
use compiler.source.span.Span
use compiler.source.span.LineCol
use compiler.source.span.span_new
use compiler.source.span.span_none

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

fn bytes_eq(a: *const u8, b: *const u8, n: usize) -> bool {
    let mut i: usize = 0;
    while i < n {
        if unsafe { *(a + i) } != unsafe { *(b + i) } {
            return false;
        }
        i = i + 1;
    }
    true
}

fn utf8_validate(bytes: *const u8, byte_len: usize) -> bool { true }

pub struct SourceFile {
    pub id: FileId,
    pub canonical_path: StrView,
    pub text: StrView,
    pub content_hash: u64,
    pub line_offsets: *mut u32,
    pub line_count: usize,
    pub line_cap: usize,
    pub alloc_ptr: *mut u8,
    pub alloc_size: usize,
    pub has_invalid_utf8: bool,
}

unsafe fn file_ptr(files: *mut SourceFile, idx: usize) -> *mut SourceFile {
    ((files as usize) + (((idx as isize) * (size_of<SourceFile>() as isize)) as usize)) as *mut SourceFile
}

unsafe fn offset_ptr(offsets: *mut u32, idx: usize) -> *mut u32 {
    ((offsets as usize) + (idx << 2)) as *mut u32
}

pub struct SourceDatabase {
    pub arena: Arena,
    pub files: *mut SourceFile,
    pub files_count: usize,
    pub files_cap: usize,
}

pub fn source_db_init(db: mut_view<SourceDatabase>) {
    db.arena = arena_new();
    db.files = 0 as *mut SourceFile;
    db.files_count = 0;
    db.files_cap = 0;
}

pub fn source_db_free(db: mut_view<SourceDatabase>) {
    let mut i: usize = 0;
    while i < db.files_count {
        let sf = unsafe { *(file_ptr(db.files, i)) };
        if sf.line_cap > 0 && sf.line_offsets as usize != 0 {
            unsafe {
                heap_free(sf.line_offsets as *mut u8, (sf.line_cap << 2), 4);
            }
        }
        if sf.alloc_ptr as usize != 0 && sf.alloc_size > 0 {
            unsafe {
                heap_free(sf.alloc_ptr, sf.alloc_size, 1);
            }
        }
        i = i + 1;
    }
    if db.files_cap > 0 && db.files as usize != 0 {
        unsafe {
            heap_free(db.files as *mut u8, (((db.files_cap as isize) * (size_of<SourceFile>() as isize)) as usize), align_of<SourceFile>());
        }
    }
    db.files = 0 as *mut SourceFile;
    db.files_count = 0;
    db.files_cap = 0;
    arena_destroy(mut_view(db.arena));
}

pub struct LineMapResult {
    pub offsets: *mut u32,
    pub count: usize,
    pub cap: usize,
}

fn build_line_map(text_ptr: *const u8, text_len: usize) -> LineMapResult {
    let mut cap: usize = 16;
    let mut count: usize = 0;
    let mut offsets = unsafe { heap_alloc((cap << 2), 4) as *mut u32 };

    // Line 1 starts at byte offset 0
    unsafe {
        *(offset_ptr(offsets, 0)) = 0u32;
    }
    count = 1;

    let mut i: usize = 0;
    while i < text_len {
        let b = unsafe { *(text_ptr + i) };
        if b == 13u8 && i + 1 < text_len && unsafe { *(text_ptr + i + 1) } == 10u8 { // \r\n
            if count == cap {
                let new_cap = cap + cap;
                let new_offsets = unsafe { heap_alloc((new_cap << 2), 4) as *mut u32 };
                if count > 0 && offsets as usize != 0 {
                    unsafe {
                        ptr_copy_nonoverlapping<u8>(offsets as *const u8, new_offsets as *mut u8, (count << 2));
                        heap_free(offsets as *mut u8, (cap << 2), 4);
                    }
                }
                offsets = new_offsets;
                cap = new_cap;
            }
            unsafe {
                *(offset_ptr(offsets, count)) = (i + 2) as u32;
            }
            count = count + 1;
            i = i + 2;
        } else if b == 10u8 { // \n
            if count == cap {
                let new_cap = cap + cap;
                let new_offsets = unsafe { heap_alloc((new_cap << 2), 4) as *mut u32 };
                if count > 0 && offsets as usize != 0 {
                    unsafe {
                        ptr_copy_nonoverlapping<u8>(offsets as *const u8, new_offsets as *mut u8, (count << 2));
                        heap_free(offsets as *mut u8, (cap << 2), 4);
                    }
                }
                offsets = new_offsets;
                cap = new_cap;
            }
            unsafe {
                *(offset_ptr(offsets, count)) = (i + 1) as u32;
            }
            count = count + 1;
            i = i + 1;
        } else {
            i = i + 1;
        }
    }

    LineMapResult {
        offsets: offsets,
        count: count,
        cap: cap,
    }
}

pub fn source_db_add_virtual(db: mut_view<SourceDatabase>, identity_ptr: *const u8, identity_len: usize, text_ptr: *const u8, text_len: usize) -> FileId {
    // Check if file with same identity is already loaded
    let mut i: usize = 0;
    while i < db.files_count {
        let existing = unsafe { *(file_ptr(db.files, i)) };
        if existing.canonical_path.len == identity_len && bytes_eq(existing.canonical_path.ptr, identity_ptr, identity_len) {
            return FileId { v: existing.id.v };
        }
        i = i + 1;
    }

    // Allocate copy of path in db.arena
    let path_copy = arena_alloc_raw(mut_view(db.arena), identity_len + 1, 1);
    if identity_len > 0 && identity_ptr as usize != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(identity_ptr, path_copy, identity_len);
            *(path_copy + identity_len) = 0u8;
        }
    }

    // Handle UTF-8 BOM in text
    let mut p_text = text_ptr;
    let mut actual_len = text_len;
    if actual_len >= 3 && unsafe { *p_text } == 0xEFu8 && unsafe { *(p_text + 1) } == 0xBBu8 && unsafe { *(p_text + 2) } == 0xBFu8 {
        p_text = unsafe { p_text + 3 };
        actual_len = actual_len - 3;
    }

    // Allocate copy of text in db.arena
    let text_copy = arena_alloc_raw(mut_view(db.arena), actual_len + 1, 1);
    if actual_len > 0 && p_text as usize != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(p_text, text_copy, actual_len);
            *(text_copy + actual_len) = 0u8;
        }
    }

    let hash = ax_hash_bytes(text_copy as *const u8, actual_len);
    let is_valid = utf8_validate(text_copy as *const u8, actual_len);

    let lm = build_line_map(text_copy as *const u8, actual_len);

    let new_id = FileId { v: (db.files_count + 1) as u32 };

    if db.files_count == db.files_cap {
        let new_cap = if db.files_cap == 0 { 8 } else { db.files_cap + db.files_cap };
        let new_files = unsafe { heap_alloc((((new_cap as isize) * (size_of<SourceFile>() as isize)) as usize), align_of<SourceFile>()) as *mut SourceFile };
        if db.files_count > 0 && db.files as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(db.files as *const u8, new_files as *mut u8, (((db.files_count as isize) * (size_of<SourceFile>() as isize)) as usize));
                heap_free(db.files as *mut u8, (((db.files_cap as isize) * (size_of<SourceFile>() as isize)) as usize), align_of<SourceFile>());
            }
        }
        db.files = new_files;
        db.files_cap = new_cap;
    }

    let sf = SourceFile {
        id: FileId { v: new_id.v },
        canonical_path: StrView { ptr: path_copy as *const u8, len: identity_len },
        text: StrView { ptr: text_copy as *const u8, len: actual_len },
        content_hash: hash,
        line_offsets: lm.offsets,
        line_count: lm.count,
        line_cap: lm.cap,
        alloc_ptr: 0 as *mut u8,
        alloc_size: 0,
        has_invalid_utf8: !is_valid,
    };

    unsafe {
        *(file_ptr(db.files, db.files_count)) = sf;
    }
    db.files_count = db.files_count + 1;

    new_id
}

pub fn source_db_file_count(db: view<SourceDatabase>) -> usize {
    db.files_count
}

pub fn source_db_text(db: view<SourceDatabase>, file: FileId) -> StrView {
    if file.v == 0 || (file.v as usize) > db.files_count {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let sf = unsafe { *(file_ptr(db.files, (file.v - 1) as usize)) };
    sf.text
}

pub fn source_db_path(db: view<SourceDatabase>, file: FileId) -> StrView {
    if file.v == 0 || (file.v as usize) > db.files_count {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let sf = unsafe { *(file_ptr(db.files, (file.v - 1) as usize)) };
    sf.canonical_path
}

pub fn source_db_hash(db: view<SourceDatabase>, file: FileId) -> u64 {
    if file.v == 0 || (file.v as usize) > db.files_count {
        return 0u64;
    }
    let sf = unsafe { *(file_ptr(db.files, (file.v - 1) as usize)) };
    sf.content_hash
}

pub fn source_db_has_invalid_utf8(db: view<SourceDatabase>, file: FileId) -> bool {
    if file.v == 0 || (file.v as usize) > db.files_count {
        return false;
    }
    let sf = unsafe { *(file_ptr(db.files, (file.v - 1) as usize)) };
    sf.has_invalid_utf8
}

pub fn source_db_span_text(db: view<SourceDatabase>, span: Span) -> StrView {
    if span.file.v == 0 || (span.file.v as usize) > db.files_count {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let sf = unsafe { *(file_ptr(db.files, (span.file.v - 1) as usize)) };
    if span.start > span.end || (span.end as usize) > sf.text.len {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    StrView {
        ptr: (sf.text.ptr as usize + (span.start as usize)) as *const u8,
        len: (span.end - span.start) as usize,
    }
}

pub fn source_db_line_col(db: view<SourceDatabase>, span: Span) -> LineCol { LineCol.zero() }
pub fn source_db_line_range(db: view<SourceDatabase>, file: FileId, line: u32) -> Span { span_none() }

module compiler.diag.code

@derive(Copy)
pub enum DiagSeverity {
    Error,
    Warning,
    Info,
    Hint,
}

@derive(Copy)
pub enum FixApplicability {
    MachineApplicable,
    MaybeApplicable,
    ManualReview,
}

@derive(Copy)
pub enum DiagDataKind {
    String,
    Integer,
    Boolean,
    StringList,
}

@derive(Copy)
pub struct DiagCode {
    pub v: u32,
}

pub fn diag_code(v: u32) -> DiagCode {
    DiagCode { v: v }
}

pub fn diag_code_eq(a: DiagCode, b: DiagCode) -> bool {
    a.v == b.v
}

