pub const TRAIT_PROVEN: u8 = 0u8;
pub const TRAIT_DISPROVEN: u8 = 1u8;
pub const TRAIT_AMBIGUOUS: u8 = 2u8;
pub const TRAIT_OVERFLOW: u8 = 3u8;

const MSG_OVERLAP: [38]u8 = [
    111u8, 118u8, 101u8, 114u8, 108u8, 97u8, 112u8, 112u8, 105u8, 110u8,
    103u8, 32u8, 105u8, 109u8, 112u8, 108u8, 101u8, 109u8, 101u8, 110u8,
    116u8, 97u8, 116u8, 105u8, 111u8, 110u8, 115u8, 32u8, 102u8, 111u8,
    114u8, 32u8, 116u8, 114u8, 97u8, 105u8, 116u8, 0u8,
];

const MSG_AMBIGUOUS: [24]u8 = [
    109u8, 101u8, 116u8, 104u8, 111u8, 100u8, 32u8, 99u8, 97u8, 108u8,
    108u8, 32u8, 105u8, 115u8, 32u8, 97u8, 109u8, 98u8, 105u8, 103u8,
    117u8, 111u8, 117u8, 115u8,
];

const MSG_UNSATISFIED: [28]u8 = [
    116u8, 114u8, 97u8, 105u8, 116u8, 32u8, 98u8, 111u8, 117u8, 110u8,
    100u8, 32u8, 105u8, 115u8, 32u8, 110u8, 111u8, 116u8, 32u8, 115u8,
    97u8, 116u8, 105u8, 115u8, 102u8, 105u8, 101u8, 100u8,
];

pub fn sv_eq(a: view<StrView>, b: view<StrView>) -> bool {
    let a_len: usize = a.len;
    let b_len: usize = b.len;
    if a_len != b_len {
        return false;
    }
    if a_len == 0 {
        return true;
    }
    let a_ptr: *const u8 = a.ptr;
    let b_ptr: *const u8 = b.ptr;
    if (a_ptr as usize) == 0 || (b_ptr as usize) == 0 {
        return false;
    }
    let mut i: usize = 0;
    while (i < a_len) {
        let ca = unsafe { *(a_ptr + i) };
        let cb = unsafe { *(b_ptr + i) };
        if ca != cb {
            return false;
        }
        i = i + 1;
    }
    true
}

fn sv_is_2(sv: view<StrView>, c0: u8, c1: u8) -> bool {
    let s_len: usize = sv.len;
    let s_ptr: *const u8 = sv.ptr;
    if s_len != 2 || (s_ptr as usize) == 0 {
        return false;
    }
    unsafe { *(s_ptr + 0) == c0 && *(s_ptr + 1) == c1 }
}

fn sv_is_3(sv: view<StrView>, c0: u8, c1: u8, c2: u8) -> bool {
    let s_len: usize = sv.len;
    let s_ptr: *const u8 = sv.ptr;
    if s_len != 3 || (s_ptr as usize) == 0 {
        return false;
    }
    unsafe { *(s_ptr + 0) == c0 && *(s_ptr + 1) == c1 && *(s_ptr + 2) == c2 }
}

fn sv_is_4(sv: view<StrView>, c0: u8, c1: u8, c2: u8, c3: u8) -> bool {
    let s_len: usize = sv.len;
    let s_ptr: *const u8 = sv.ptr;
    if s_len != 4 || (s_ptr as usize) == 0 {
        return false;
    }
    unsafe {
        *(s_ptr + 0) == c0 && *(s_ptr + 1) == c1 &&
            *(s_ptr + 2) == c2 && *(s_ptr + 3) == c3
    }
}

fn sv_is_5(sv: view<StrView>, c0: u8, c1: u8, c2: u8, c3: u8, c4: u8) -> bool {
    let s_len: usize = sv.len;
    let s_ptr: *const u8 = sv.ptr;
    if s_len != 5 || (s_ptr as usize) == 0 {
        return false;
    }
    unsafe {
        *(s_ptr + 0) == c0 && *(s_ptr + 1) == c1 &&
            *(s_ptr + 2) == c2 && *(s_ptr + 3) == c3 && *(s_ptr + 4) == c4
    }
}

fn sv_is_6(sv: view<StrView>, c0: u8, c1: u8, c2: u8, c3: u8, c4: u8, c5: u8) -> bool {
    let s_len: usize = sv.len;
    let s_ptr: *const u8 = sv.ptr;
    if s_len != 6 || (s_ptr as usize) == 0 {
        return false;
    }
    unsafe {
        *(s_ptr + 0) == c0 && *(s_ptr + 1) == c1 && *(s_ptr + 2) == c2 &&
            *(s_ptr + 3) == c3 && *(s_ptr + 4) == c4 && *(s_ptr + 5) == c5
    }
}

fn sv_is_8(
    sv: view<StrView>,
    c0: u8,
    c1: u8,
    c2: u8,
    c3: u8,
    c4: u8,
    c5: u8,
    c6: u8,
    c7: u8
) -> bool {
    let s_len: usize = sv.len;
    let s_ptr: *const u8 = sv.ptr;
    if s_len != 8 || (s_ptr as usize) == 0 {
        return false;
    }
    unsafe {
        *(s_ptr + 0) == c0 && *(s_ptr + 1) == c1 && *(s_ptr + 2) == c2 &&
            *(s_ptr + 3) == c3 && *(s_ptr + 4) == c4 && *(s_ptr + 5) == c5 &&
            *(s_ptr + 6) == c6 && *(s_ptr + 7) == c7
    }
}

pub fn hir_item_name_sv(
    it: *const HirItem,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>
) -> StrView {
    if (it as usize) == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let name_v = unsafe { (*it).name.v };
    if name_v != 0u32 {
        return interner_get(str_in, StrId { v: name_v });
    }
    let sp_f = unsafe { (*it).span.file.v };
    if sp_f != 0u32 {
        let sp_s = unsafe { (*it).span.start };
        let sp_e = unsafe { (*it).span.end };
        return source_db_span_text(db, Span { file: FileId { v: sp_f }, start: sp_s, end: sp_e });
    }
    StrView { ptr: 0 as *const u8, len: 0 }
}

pub fn hir_type_path_name_sv(
    ty: *const HirType,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>
) -> StrView {
    if (ty as usize) == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let tk = unsafe { (*ty).kind };
    if tk != HIR_TYPE_PATH {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let name_v = unsafe { (*ty).path.name.v };
    if name_v != 0u32 {
        return interner_get(str_in, StrId { v: name_v });
    }
    let sp_f = unsafe { (*ty).path.span.file.v };
    if sp_f != 0u32 {
        let sp_s = unsafe { (*ty).path.span.start };
        let sp_e = unsafe { (*ty).path.span.end };
        return source_db_span_text(db, Span { file: FileId { v: sp_f }, start: sp_s, end: sp_e });
    }
    StrView { ptr: 0 as *const u8, len: 0 }
}

pub fn hir_generic_param_name_sv(
    gp: *const HirGenericParam,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>
) -> StrView {
    if (gp as usize) == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let name_v = unsafe { (*gp).name.v };
    if name_v != 0u32 {
        return interner_get(str_in, StrId { v: name_v });
    }
    let sp_f = unsafe { (*gp).span.file.v };
    if sp_f != 0u32 {
        let sp_s = unsafe { (*gp).span.start };
        let sp_e = unsafe { (*gp).span.end };
        return source_db_span_text(db, Span { file: FileId { v: sp_f }, start: sp_s, end: sp_e });
    }
    StrView { ptr: 0 as *const u8, len: 0 }
}

pub fn emit_trait_ambiguous_diag(sink: mut_view<DiagSink>, sp: Span) {}
pub fn emit_trait_unsatisfied_bound_diag(sink: mut_view<DiagSink>, sp: Span) {}
pub fn traits_check_overlap(hir: view<HirFile>, sink: mut_view<DiagSink>) {}
pub fn find_trait_item(
    hir: view<HirFile>,
    sym: SymbolId,
    name: view<StrView>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>
) -> *mut HirItem {
    let name_len: usize = name.len;
    let mut it: *mut HirItem = hir.items;
    while ((it as usize) != 0) {
        let k = unsafe { (*it).kind };
        if k == HIR_ITEM_TRAIT {
            let it_sym = unsafe { (*it).symbol.v };
            if sym.v != 0u32 && it_sym == sym.v {
                return it;
            }
            if name_len > 0 {
                let it_name = hir_item_name_sv(it, str_in, db);
                if sv_eq(view(it_name), name) {
                    return it;
                }
            }
        }
        it = unsafe { (*it).next };
    }
    0 as *mut HirItem
}

pub fn find_trait_by_type_path(
    hir: view<HirFile>,
    trait_path: *const HirType,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>
) -> *mut HirItem {
    if (trait_path as usize) == 0 {
        return 0 as *mut HirItem;
    }
    let tk = unsafe { (*trait_path).kind };
    if tk != HIR_TYPE_PATH {
        return 0 as *mut HirItem;
    }
    let sym_v = unsafe { (*trait_path).path.symbol.v };
    let tr_name = hir_type_path_name_sv(trait_path, str_in, db);
    find_trait_item(hir, SymbolId { v: sym_v }, view(tr_name), str_in, db)
}

pub fn find_trait_default_method(
    hir: view<HirFile>,
    tr: *const HirItem,
    method_name: view<StrView>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>
) -> *mut HirItem {
    if (tr as usize) == 0 {
        return 0 as *mut HirItem;
    }
    let tk = unsafe { (*tr).kind };
    if tk != HIR_ITEM_TRAIT {
        return 0 as *mut HirItem;
    }
    let mut m: *mut HirItem = unsafe { (*tr).members };
    while ((m as usize) != 0) {
        let mk = unsafe { (*m).kind };
        let mbody = unsafe { (*m).body };
        if mk == HIR_ITEM_FN && (mbody as usize) != 0 {
            let m_name = hir_item_name_sv(m, str_in, db);
            if sv_eq(view(m_name), method_name) {
                return m;
            }
        }
        m = unsafe { (*m).next };
    }
    let mut st: *mut HirType = unsafe { (*tr).supertraits };
    while ((st as usize) != 0) {
        let st_it = find_trait_by_type_path(hir, st, str_in, db);
        if (st_it as usize) != 0 && (st_it as usize) != (tr as usize) {
            let found = find_trait_default_method(hir, st_it, method_name, str_in, db);
            if (found as usize) != 0 {
                return found;
            }
        }
        st = unsafe { (*st).next };
    }
    0 as *mut HirItem
}

fn prim_kind_matches_name(tk: u8, name: view<StrView>) -> bool {
    if tk == TY_I8 {
        return sv_is_2(name, 105u8, 56u8);
    }
    if tk == TY_I16 {
        return sv_is_3(name, 105u8, 49u8, 54u8);
    }
    if tk == TY_I32 {
        return sv_is_3(name, 105u8, 51u8, 50u8);
    }
    if tk == TY_I64 {
        return sv_is_3(name, 105u8, 54u8, 52u8);
    }
    if tk == TY_ISIZE {
        return sv_is_5(name, 105u8, 115u8, 105u8, 122u8, 101u8);
    }
    if tk == TY_U8 {
        return sv_is_2(name, 117u8, 56u8);
    }
    if tk == TY_U16 {
        return sv_is_3(name, 117u8, 49u8, 54u8);
    }
    if tk == TY_U32 {
        return sv_is_3(name, 117u8, 51u8, 50u8);
    }
    if tk == TY_U64 {
        return sv_is_3(name, 117u8, 54u8, 52u8);
    }
    if tk == TY_USIZE {
        return sv_is_5(name, 117u8, 115u8, 105u8, 122u8, 101u8);
    }
    if tk == TY_BOOL {
        return sv_is_4(name, 98u8, 111u8, 111u8, 108u8);
    }
    if tk == TY_CHAR {
        return sv_is_4(name, 99u8, 104u8, 97u8, 114u8);
    }
    if tk == TY_STR {
        return sv_is_3(name, 115u8, 116u8, 114u8) || sv_is_3(name, 83u8, 116u8, 114u8);
    }
    false
}

pub fn impl_matches_receiver(
    ti: view<TypeInterner>,
    str_in: view<StrInterner>,
    impl_it: *const HirItem,
    receiver_ty: TypeId
) -> bool {
    if (impl_it as usize) == 0 || receiver_ty.v == 0u32 {
        return false;
    }
    let ik = unsafe { (*impl_it).kind };
    let self_hir = unsafe { (*impl_it).self_type };
    if ik != HIR_ITEM_IMPL || (self_hir as usize) == 0 {
        return false;
    }
    let mut rt_v = receiver_ty.v;
    let mut t = type_get(ti, TypeId { v: rt_v });
    while ((t as usize) != 0) {
        let tk = unsafe { (*t).kind };
        if tk == TY_VIEW || tk == TY_MUT_VIEW || tk == TY_PTR {
            rt_v = unsafe { (*t).pointee.v };
            t = type_get(ti, TypeId { v: rt_v });
        } else {
            break;
        }
    }
    if (t as usize) == 0 {
        return false;
    }
    let mut st_hir: *const HirType = self_hir;
    while ((st_hir as usize) != 0) {
        let stk = unsafe { (*st_hir).kind };
        if stk == HIR_TYPE_VIEW || stk == HIR_TYPE_PTR {
            st_hir = unsafe { (*st_hir).elem };
        } else {
            break;
        }
    }
    if (st_hir as usize) == 0 {
        return false;
    }
    let sk = unsafe { (*st_hir).kind };
    if sk == HIR_TYPE_PATH {
        let sym_v = unsafe { (*st_hir).path.symbol.v };
        let name_v = unsafe { (*st_hir).path.name.v };
        let tk = unsafe { (*t).kind };
        let tdef = unsafe { (*t).def };
        if (tk == TY_STRUCT || tk == TY_ENUM) && (tdef as usize) != 0 {
            let def_sym_v = unsafe { (*tdef).symbol.v };
            if sym_v != 0u32 && def_sym_v == sym_v {
                return true;
            }
            let def_name_v = unsafe { (*tdef).name.v };
            if name_v != 0u32 && def_name_v == name_v {
                return true;
            }
        }
        if name_v != 0u32 {
            let name_sv = interner_get(str_in, StrId { v: name_v });
            if prim_kind_matches_name(tk, view(name_sv)) {
                return true;
            }
        }
    }
    false
}

pub fn receiver_matches_impl_self(
    thir: view<Thir>,
    str_in: view<StrInterner>,
    impl_it: *const HirItem,
    base_ty: TypeId
) -> bool {
    let base_v = base_ty.v;
    if (impl_it as usize) == 0 || base_v == 0u32 {
        return false;
    }
    let self_ty_ptr = thir_get_item_type(thir, impl_it);
    if (self_ty_ptr as usize) != 0 {
        let self_ty_v = unsafe { (*self_ty_ptr).v };
        if self_ty_v == base_v {
            return true;
        }
        let b_ptr = type_get(view(thir.interner), TypeId { v: base_v });
        let s_ptr = type_get(view(thir.interner), TypeId { v: self_ty_v });
        if (b_ptr as usize) != 0 && (s_ptr as usize) != 0 {
            let bk = unsafe { (*b_ptr).kind };
            let sk = unsafe { (*s_ptr).kind };
            let b_pt = unsafe { (*b_ptr).pointee.v };
            let s_pt = unsafe { (*s_ptr).pointee.v };
            if bk == TY_VIEW && sk == TY_VIEW && b_pt == s_pt {
                return true;
            }
            if bk == TY_VIEW && b_pt == self_ty_v {
                return true;
            }
            if bk == TY_MUT_VIEW && b_pt == self_ty_v {
                return true;
            }
            if (bk == TY_VIEW || bk == TY_MUT_VIEW) && (sk == TY_STRUCT || sk == TY_ENUM) {
                let inner_ptr = type_get(view(thir.interner), TypeId { v: b_pt });
                if (inner_ptr as usize) != 0 {
                    let ik = unsafe { (*inner_ptr).kind };
                    let idef = unsafe { (*inner_ptr).def as usize };
                    let sdef = unsafe { (*s_ptr).def as usize };
                    if ik == sk && idef != 0 && idef == sdef {
                        return true;
                    }
                }
            }
            if bk == sk && (bk == TY_STRUCT || bk == TY_ENUM) {
                let bdef = unsafe { (*b_ptr).def as usize };
                let sdef = unsafe { (*s_ptr).def as usize };
                if bdef != 0 && bdef == sdef {
                    return true;
                }
            }
        }
        return false;
    }
    impl_matches_receiver(view(thir.interner), str_in, impl_it, TypeId { v: base_v })
}

pub fn find_method_in_impl(
    hir: view<HirFile>,
    impl_it: *const HirItem,
    method_name: view<StrView>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>
) -> *mut HirItem {
    if (impl_it as usize) == 0 {
        return 0 as *mut HirItem;
    }
    let ik = unsafe { (*impl_it).kind };
    if ik != HIR_ITEM_IMPL {
        return 0 as *mut HirItem;
    }
    let mut m: *mut HirItem = unsafe { (*impl_it).members };
    while ((m as usize) != 0) {
        let mk = unsafe { (*m).kind };
        if mk == HIR_ITEM_FN {
            let m_name = hir_item_name_sv(m, str_in, db);
            if sv_eq(view(m_name), method_name) {
                return m;
            }
        }
        m = unsafe { (*m).next };
    }
    let tp = unsafe { (*impl_it).trait_path };
    if (tp as usize) != 0 {
        let tr_it = find_trait_by_type_path(hir, tp, str_in, db);
        if (tr_it as usize) != 0 {
            return find_trait_default_method(hir, tr_it, method_name, str_in, db);
        }
    }
    0 as *mut HirItem
}

pub fn find_method(
    hir: view<HirFile>,
    thir: view<Thir>,
    base_ty: TypeId,
    method_name: view<StrView>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    out_res: mut_view<u8>
) -> *mut HirItem {
    *out_res = TRAIT_DISPROVEN;
    let base_v = base_ty.v;
    if base_v == 0u32 {
        return 0 as *mut HirItem;
    }
    let mut found_fn: *mut HirItem = 0 as *mut HirItem;
    let mut match_count: usize = 0;

    let mut it: *mut HirItem = hir.items;
    while ((it as usize) != 0) {
        let ik = unsafe { (*it).kind };
        if ik == HIR_ITEM_IMPL {
            if receiver_matches_impl_self(thir, str_in, it, (TypeId { v: base_v })) {
                let m = find_method_in_impl(hir, it, method_name, str_in, db);
                if (m as usize) != 0 {
                    found_fn = m;
                    match_count = match_count + 1;
                }
            }
        } else if ik == HIR_ITEM_TRAIT {
            let mut check_v = base_v;
            let b_ptr = type_get(view(thir.interner), TypeId { v: base_v });
            if (b_ptr as usize) != 0 {
                let bk = unsafe { (*b_ptr).kind };
                if bk == TY_VIEW || bk == TY_MUT_VIEW {
                    check_v = unsafe { (*b_ptr).pointee.v };
                }
            }
            let c_ptr = type_get(view(thir.interner), TypeId { v: check_v });
            if (c_ptr as usize) != 0 && unsafe { (*c_ptr).kind } == TY_PARAM {
                let mut m: *mut HirItem = unsafe { (*it).members };
                while ((m as usize) != 0) {
                    if unsafe { (*m).kind } == HIR_ITEM_FN {
                        let m_name = hir_item_name_sv(m, str_in, db);
                        if sv_eq(view(m_name), method_name) {
                            found_fn = m;
                            match_count = match_count + 1;
                        }
                    }
                    m = unsafe { (*m).next };
                }
            }
        }
        it = unsafe { (*it).next };
    }

    if match_count == 1 {
        *out_res = TRAIT_PROVEN;
        return found_fn;
    }
    if match_count > 1 {
        *out_res = TRAIT_AMBIGUOUS;
        return 0 as *mut HirItem;
    }
    *out_res = TRAIT_DISPROVEN;
    0 as *mut HirItem
}

pub fn resolve_assoc_type(hir: view<HirFile>, thir: view<Thir>, self_ty: TypeId, assoc_name: view<StrView>, str_in: view<StrInterner>, db: view<SourceDatabase>) -> *mut HirType { 0 as *mut HirType }
pub fn satisfies_bound(hir: view<HirFile>, thir: view<Thir>, arg_ty: TypeId, bound: *const HirType, str_in: view<StrInterner>, db: view<SourceDatabase>) -> bool { true }
pub fn check_item_bounds(hir: view<HirFile>, thir: view<Thir>, callee_it: *const HirItem, args: view<GenericArgsSlice>, call_span: Span, str_in: view<StrInterner>, db: view<SourceDatabase>, sink: mut_view<DiagSink>) -> bool { true }
pub fn check_impl_supertraits(hir: view<HirFile>, thir: view<Thir>, str_in: view<StrInterner>, db: view<SourceDatabase>, sink: mut_view<DiagSink>) -> bool { true }

