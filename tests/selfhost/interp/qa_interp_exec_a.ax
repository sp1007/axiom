                while ((pf as usize) != 0) {
                    let pf_sp = Span {
                        file: FileId { v: unsafe { (*pf).span.file.v } },
                        start: unsafe { (*pf).span.start },
                        end: unsafe { (*pf).span.end },
                    };
                    let f_idx = mb_find_struct_field_index(view(*b), def_item, StrId {
                        v: unsafe {
                            (*pf).name.v
                        }
                    }, view(pf_sp));
                    let f_pl = mb_append_proj_field(mut_view(*b), scrutinee, f_idx);
                    let f_ty = mb_pat_ty(mut_view(*b), unsafe {
                        (*pf).pat
                    });
                    mb_build_pat_match_in_place(mut_view(*b), unsafe {
                        (*pf).pat
                    }, view(f_pl), (TypeId {
                        v: f_ty.v
                    }), (MirBbId {
                        v: on_fail.v
                    }));
                    pf = unsafe {
                        (*pf).next
                    };
                }
            } else if pk == HIR_PAT_TUPLE {
                let mut el: *mut HirPat = unsafe {
                    (*pat).elems
                };
                let mut idx: u32 = 0u32;
                while ((el as usize) != 0) {
                    let f_pl = mb_append_proj_field(mut_view(*b), scrutinee, idx);
                    let f_ty = mb_pat_ty(mut_view(*b), el);
                    mb_build_pat_match_in_place(mut_view(*b), el, view(f_pl), (TypeId {
                        v: f_ty.v
                    }), (MirBbId {
                        v: on_fail.v
                    }));
                    idx = idx + 1u32;
                    el = unsafe {
                        (*el).next
                    };
                }
            }
        } else if tk == TY_TUPLE {
            let mut el: *mut HirPat = unsafe {
                (*pat).elems
            };
            let mut idx: u32 = 0u32;
            while ((el as usize) != 0) {
                let f_pl = mb_append_proj_field(mut_view(*b), scrutinee, idx);
                let f_ty = mb_pat_ty(mut_view(*b), el);
                mb_build_pat_match_in_place(mut_view(*b), el, view(f_pl), (TypeId {
                    v: f_ty.v
                }), (MirBbId {
                    v: on_fail.v
                }));
                idx = idx + 1u32;
                el = unsafe {
                    (*el).next
                };
            }
        }
    }
}

fn mb_build_pat_match(
    b: mut_view<MirBuilder>,
    pat: *mut HirPat,
    scrutinee: view<MirPlace>,
    scrut_ty: TypeId,
    on_match: MirBbId,
    on_fail: MirBbId
) {
    let sp = if (pat as usize) != 0 {
        Span {
            file: FileId { v: unsafe { (*pat).span.file.v } },
            start: unsafe { (*pat).span.start },
            end: unsafe { (*pat).span.end },
        }
    } else {
        Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }
    };
    mb_build_pat_match_in_place(mut_view(*b), pat, scrutinee, (TypeId {
        v: scrut_ty.v
    }), (MirBbId {
        v: on_fail.v
    }));
    mb_terminate_goto(mut_view(*b), (MirBbId {
        v: on_match.v
    }), view(sp));
}

// =============================================================================
// Lvalue & Operand Lowering
// =============================================================================

pub fn mir_build_lvalue(b: mut_view<MirBuilder>, expr: *mut HirExpr, out_is_slice_len: mut_view<bool>) -> MirPlace {
    *out_is_slice_len = false;
    if (expr as usize) == 0 {
        return mir_local_place(0u32);
    }
    let ek = unsafe {
        (*expr).kind
    };
    let sp = Span {
        file: FileId { v: unsafe { (*expr).span.file.v } },
        start: unsafe { (*expr).span.start },
        end: unsafe { (*expr).span.end },
    };

    if ek == HIR_EXPR_PATH {
        let sym = SymbolId {
            v: unsafe {
                (*expr).path.symbol.v
            }
        };
        let mut loc = MirLocalId {
            v: 0u32
        };
        let mut is_sl: bool = false;
        if sym.v != 0u32 && mb_lookup_sym(view(*b), (SymbolId { v: sym.v }), mut_view(loc), mut_view(is_sl)) {
            *out_is_slice_len = is_sl;
            let p = mir_local_place(loc.v);
            if (loc.v as usize) < (unsafe { (*b.body).local_count }) {
                let decl = unsafe {
                    mir_local_at((*b.body).locals, loc.v as usize)
                };
                let loc_ty = TypeId {
                    v: unsafe {
                        (*decl).ty.v
                    }
                };
                if loc_ty.v != 0u32 {
                    let lt = unsafe {
                        type_get(view((*b.thir).interner), (TypeId {
                            v: loc_ty.v
                        }))
                    };
                    if (lt as usize) != 0 && ((unsafe { (*lt).kind }) == TY_VIEW || (unsafe { (*lt).kind }) == TY_MUT_VIEW) {
                        let expr_ty = mb_expr_ty(mut_view(*b), expr);
                        if expr_ty.v != 0u32 && expr_ty.v != loc_ty.v {
                            return mb_append_proj_deref(mut_view(*b), view(p));
                        }
                    }
                }
            }
            return p;
        }
        // Check closure captures if inside a closure body
        if b.closure_capture_count > 0 && (b.closure_captures as usize) != 0 && sym.v != 0u32 {
            let mut ci: usize = 0;
            while (ci < b.closure_capture_count) {
                let cap = unsafe {
                    capture_at(b.closure_captures as *mut ClosureCapture, ci)
                };
                if (unsafe { (*cap).sym.v }) == sym.v {
                    let env_pl = mir_local_place(b.closure_env_local.v);
                    let env_deref = mb_append_proj_deref(mut_view(*b), view(env_pl));
                    let cap_field = mb_append_proj_field(mut_view(*b), view(env_deref), ci as u32);
                    let cmode = unsafe {
                        (*cap).mode
                    };
                    if cmode == CAP_VIEW || cmode == CAP_MUT_VIEW {
                        return mb_append_proj_deref(mut_view(*b), view(cap_field));
                    }
                    return cap_field;
                }
                ci = ci + 1;
            }
        }
    } else if ek == HIR_EXPR_UNARY && (unsafe { (*expr).op }) == UNOP_DEREF {
        let mut inner_sl: bool = false;
        let base_pl = mir_build_lvalue(mut_view(*b), unsafe {
            (*expr).inner
        }, mut_view(inner_sl));
        return mb_append_proj_deref(mut_view(*b), view(base_pl));
    } else if ek == HIR_EXPR_FIELD {
        let mut inner_sl: bool = false;
        let mut base_pl = mir_build_lvalue(mut_view(*b), unsafe {
            (*expr).base
        }, mut_view(inner_sl));
        let mut base_ty = mb_expr_ty(mut_view(*b), unsafe {
            (*expr).base
        });
        let mut ax = unsafe {
            type_get(view((*b.thir).interner), (TypeId {
                v: base_ty.v
            }))
        };
        while ((ax as usize) != 0 && ((unsafe { (*ax).kind }) == TY_VIEW || (unsafe { (*ax).kind }) == TY_MUT_VIEW || (unsafe { (*ax).kind }) == TY_PTR)) {
            base_pl = mb_append_proj_deref(mut_view(*b), view(base_pl));
            let k = unsafe {
                (*ax).kind
            };
            let next_ty = if k == TY_PTR {
                TypeId {
                    v: unsafe {
                        (*ax).pointee.v
                    }
                }
            } else {
                TypeId {
                    v: unsafe {
                        (*ax).elem.v
                    }
                }
            };
            base_ty = mb_resolve_ty(mut_view(*b), next_ty);
            ax = unsafe {
                type_get(view((*b.thir).interner), (TypeId {
                    v: base_ty.v
                }))
            };
        }
        let mut f_idx: u32 = 0u32;
        if (ax as usize) != 0 && (unsafe { (*ax).kind }) == TY_STRUCT {
            let fname = StrId {
                v: unsafe {
                    (*expr).name.v
                }
            };
            f_idx = mb_find_struct_field_index(view(*b), unsafe {
                ((*ax).def) as *mut HirItem
            }, (StrId {
                v: fname.v
            }), view(sp));
        }
        return mb_append_proj_field(mut_view(*b), view(base_pl), f_idx);
    } else if ek == HIR_EXPR_TUPLE_INDEX {
        let mut inner_sl: bool = false;
        let mut base_pl = mir_build_lvalue(mut_view(*b), unsafe {
            (*expr).base
        }, mut_view(inner_sl));
        let mut base_ty = mb_expr_ty(mut_view(*b), unsafe {
            (*expr).base
        });
        let mut ax = unsafe {
            type_get(view((*b.thir).interner), (TypeId {
                v: base_ty.v
            }))
        };
        while ((ax as usize) != 0 && ((unsafe { (*ax).kind }) == TY_VIEW || (unsafe { (*ax).kind }) == TY_MUT_VIEW || (unsafe { (*ax).kind }) == TY_PTR)) {
            base_pl = mb_append_proj_deref(mut_view(*b), view(base_pl));
            let k = unsafe {
                (*ax).kind
            };
            let next_ty = if k == TY_PTR {
                TypeId {
                    v: unsafe {
                        (*ax).pointee.v
                    }
                }
            } else {
                TypeId {
                    v: unsafe {
                        (*ax).elem.v
                    }
                }
            };
            base_ty = mb_resolve_ty(mut_view(*b), next_ty);
            ax = unsafe {
                type_get(view((*b.thir).interner), (TypeId {
                    v: base_ty.v
                }))
            };
        }
        return mb_append_proj_field(mut_view(*b), view(base_pl), unsafe {
            (*expr).tuple_index
        });
    } else if ek == HIR_EXPR_INDEX {
        let mut inner_sl: bool = false;
        let mut base_pl = mir_build_lvalue(mut_view(*b), unsafe {
            (*expr).base
        }, mut_view(inner_sl));
        let mut base_ty = mb_expr_ty(mut_view(*b), unsafe {
            (*expr).base
        });
        let mut ax = unsafe {
            type_get(view((*b.thir).interner), (TypeId {
                v: base_ty.v
            }))
        };
        while ((ax as usize) != 0 && ((unsafe { (*ax).kind }) == TY_VIEW || (unsafe { (*ax).kind }) == TY_MUT_VIEW || (unsafe { (*ax).kind }) == TY_PTR)) {
            base_pl = mb_append_proj_deref(mut_view(*b), view(base_pl));
            let k = unsafe {
                (*ax).kind
            };
            let next_ty = if k == TY_PTR {
                TypeId {
                    v: unsafe {
                        (*ax).pointee.v
                    }
                }
            } else {
                TypeId {
                    v: unsafe {
                        (*ax).elem.v
                    }
                }
            };
            base_ty = mb_resolve_ty(mut_view(*b), next_ty);
            ax = unsafe {
                type_get(view((*b.thir).interner), (TypeId {
                    v: base_ty.v
                }))
            };
        }
        let idx_arg: *mut HirExpr = unsafe {
            (*expr).index_arg
        };
        let idx_ty = mb_expr_ty(mut_view(*b), idx_arg);
        let idx_loc = mb_new_temp(mut_view(*b), (TypeId {
            v: idx_ty.v
        }), view(sp));
        let mut idx_pl = mir_local_place(idx_loc.v);
        mir_build_expr(mut_view(*b), idx_arg, mut_view(idx_pl), true);

        if !b.is_diverged && (ax as usize) != 0 {
            let bk = unsafe {
                (*ax).kind
            };
            if bk == TY_ARRAY || bk == TY_SLICE {
                let usize_ty = TypeId {
                    v: unsafe {
                        (*b.thir).interner.t_usize.v
                    }
                };
                let len_loc = mb_new_temp(mut_view(*b), (TypeId {
                    v: usize_ty.v
                }), view(sp));
                let len_pl = mir_local_place(len_loc.v);
                if bk == TY_ARRAY {
                    let len_op = MirOperand {
                        kind: MIR_OP_CONST, location: Span {
                            file: FileId {
                                v: 0u32
                            }, start: 0u32, end: 0u32
                        }, place: MirPlace {
                            local: MirLocalId {
                                v: 0u32
                            }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                        }, constant: MirConst {
                            ty: TypeId {
                                v: usize_ty.v
                            }, kind: MIR_CONST_INT, val: unsafe {
                                (*ax).array_len
                            }, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                                v: 0u32
                            }
                        }
                    };
                    mb_emit_assign_use(mut_view(*b), view(len_pl), view(len_op), view(sp));
                } else {
                    let mut len_rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
                    len_rv.kind = MIR_RVALUE_LEN;
                    mir_copy_place(mut_view(len_rv.place), view(base_pl));
                    mb_emit_assign(mut_view(*b), view(len_pl), view(len_rv), view(sp));
                }
                let bool_ty = TypeId {
                    v: unsafe {
                        (*b.thir).interner.t_bool.v
                    }
                };
                let ok_loc = mb_new_temp(mut_view(*b), (TypeId {
                    v: bool_ty.v
                }), view(sp));
                let ok_pl = mir_local_place(ok_loc.v);
                let idx_op = MirOperand {
                    kind: MIR_OP_COPY, location: Span {
                        file: FileId {
                            v: 0u32
                        }, start: 0u32, end: 0u32
                    }, place: MirPlace {
                        local: MirLocalId {
                            v: idx_loc.v
                        }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                    }, constant: MirConst {
                        ty: TypeId {
                            v: 0u32
                        }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                            v: 0u32
                        }
                    }
                };
                let len_op = MirOperand {
                    kind: MIR_OP_COPY, location: Span {
                        file: FileId {
                            v: 0u32
                        }, start: 0u32, end: 0u32
                    }, place: MirPlace {
                        local: MirLocalId {
                            v: len_loc.v
                        }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                    }, constant: MirConst {
                        ty: TypeId {
                            v: 0u32
                        }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                            v: 0u32
                        }
                    }
                };
                let mut cmp_rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
                cmp_rv.kind = MIR_RVALUE_BINARY_OP;
                cmp_rv.bin_op = MIR_BINOP_LT;
                mir_copy_operand(mut_view(cmp_rv.lhs), view(idx_op));
                mir_copy_operand(mut_view(cmp_rv.rhs), view(len_op));
                mb_emit_assign(mut_view(*b), view(ok_pl), view(cmp_rv), view(sp));
                let ok_op = MirOperand {
                    kind: MIR_OP_COPY, location: Span {
                        file: FileId {
                            v: 0u32
                        }, start: 0u32, end: 0u32
                    }, place: MirPlace {
                        local: MirLocalId {
                            v: ok_loc.v
                        }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                    }, constant: MirConst {
                        ty: TypeId {
                            v: 0u32
                        }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                            v: 0u32
                        }
                    }
                };
                mb_emit_assert(mut_view(*b), view(ok_op), true, MB_ASSERT_MSG_BOUNDS, view(sp));
            }
        }
        return mb_append_proj_index(mut_view(*b), view(base_pl), (MirLocalId {
            v: idx_loc.v
        }));
    }

    let e_ty = mb_expr_ty(mut_view(*b), expr);
    let tmp = mb_new_temp(mut_view(*b), (TypeId {
        v: e_ty.v
    }), view(sp));
    let mut tmp_pl = mir_local_place(tmp.v);
    mir_build_expr(mut_view(*b), expr, mut_view(tmp_pl), true);
    tmp_pl
}

fn mb_build_operand(b: mut_view<MirBuilder>, expr: *mut HirExpr, out_op: mut_view<MirOperand>) {
    if (expr as usize) == 0 {
        *out_op = MirOperand {
            kind: MIR_OP_COPY, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: 0u32
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: 0u32
                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        return;
    }
    let sp = Span {
        file: FileId { v: unsafe { (*expr).span.file.v } },
        start: unsafe { (*expr).span.start },
        end: unsafe { (*expr).span.end },
    };
    let e_ty = mb_expr_ty(mut_view(*b), expr);
    let tmp = mb_new_temp(mut_view(*b), (TypeId {
        v: e_ty.v
    }), view(sp));
    let mut tmp_pl = mir_local_place(tmp.v);
    mir_build_expr(mut_view(*b), expr, mut_view(tmp_pl), true);
    mb_operand_from_place(view(*b), view(tmp_pl), (TypeId {
        v: e_ty.v
    }), mut_view(*out_op));
}

const MB_MSG_DIV_ZERO_C: [17]u8 = [
    100u8, 105u8, 118u8, 105u8, 115u8, 105u8, 111u8, 110u8, 32u8,
    98u8, 121u8, 32u8, 122u8, 101u8, 114u8, 111u8, 0u8,
];

const MB_MSG_ARITH_OV_C: [20]u8 = [
    97u8, 114u8, 105u8, 116u8, 104u8, 109u8, 101u8, 116u8, 105u8, 99u8, 32u8,
    111u8, 118u8, 101u8, 114u8, 102u8, 108u8, 111u8, 119u8, 0u8,
];

const MB_MSG_SHIFT_RANGE_C: [26]u8 = [
    115u8, 104u8, 105u8, 102u8, 116u8, 32u8, 97u8, 109u8, 111u8, 117u8, 110u8, 116u8, 32u8,
    111u8, 117u8, 116u8, 32u8, 111u8, 102u8, 32u8, 114u8, 97u8, 110u8, 103u8, 101u8, 0u8,
];

const MB_MSG_INVALID_CHAR_C: [19]u8 = [
    105u8, 110u8, 118u8, 97u8, 108u8, 105u8, 100u8, 32u8, 99u8, 104u8, 97u8, 114u8, 32u8,
    118u8, 97u8, 108u8, 117u8, 101u8, 0u8,
];

fn mb_build_expr_as_operand(b: mut_view<MirBuilder>, expr: *mut HirExpr, out_op: mut_view<MirOperand>) {
    if (expr as usize) == 0 {
        *out_op = MirOperand {
            kind: MIR_OP_COPY, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: 0u32
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: 0u32
                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        return;
    }
    let ek = unsafe {
        (*expr).kind
    };
    let e_ty = mb_expr_ty(mut_view(*b), expr);
    let sp = Span {
        file: FileId { v: unsafe { (*expr).span.file.v } },
        start: unsafe { (*expr).span.start },
        end: unsafe { (*expr).span.end },
    };

    if ek == HIR_EXPR_LITERAL {
        mir_operand_zero(mut_view(*out_op), MIR_OP_CONST);
        out_op.constant.ty.v = e_ty.v;
        let tk = unsafe {
            (*expr).literal.kind
        };
        if tk == TOK_STR || tk == TOK_BYTE_STR {
            out_op.constant.kind = MIR_CONST_STR;
            let s_ptr = unsafe {
                (*expr).literal.str_ptr
            };
            let s_len = unsafe {
                (*expr).literal.str_len as usize
            };
            if (s_ptr as usize) != 0 {
                out_op.constant.str_bytes = s_ptr;
                out_op.constant.str_len = s_len;
            } else {
                let sv = mb_span_sv(view(*b), view(sp));
                if sv.len >= 2 {
                    out_op.constant.str_bytes = unsafe {
                        sv.ptr + 1
                    };
                    out_op.constant.str_len = sv.len - 2;
                }
            }
        } else if tk == TOK_KW_TRUE {
            out_op.constant.kind = MIR_CONST_INT;
            out_op.constant.val = 1u64;
        } else if tk == TOK_KW_FALSE {
            out_op.constant.kind = MIR_CONST_INT;
            out_op.constant.val = 0u64;
        } else {
            out_op.constant.kind = MIR_CONST_INT;
            out_op.constant.val = unsafe {
                mb_token_int_val(view(*b), view((*expr).literal), false)
            };
        }
        return;
    }

    if ek == HIR_EXPR_PATH {
        let sym = SymbolId {
            v: unsafe {
                (*expr).path.symbol.v
            }
        };
        let mut loc = MirLocalId {
            v: 0u32
        };
        let mut is_sl: bool = false;
        let mut in_local = false;
        if sym.v != 0u32 && mb_lookup_sym(view(*b), (SymbolId { v: sym.v }), mut_view(loc), mut_view(is_sl)) {
            in_local = true;
        } else if b.closure_capture_count > 0 && (b.closure_captures as usize) != 0 && sym.v != 0u32 {
            let mut ci: usize = 0;
            while (ci < b.closure_capture_count) {
                let cap = unsafe {
                    capture_at(b.closure_captures as *mut ClosureCapture, ci)
                };
                if (unsafe { (*cap).sym.v }) == sym.v {
                    in_local = true;
                    break;
                }
                ci = ci + 1;
            }
        }
        if in_local {
            let mut dummy_sl = false;
            let p = mir_build_lvalue(mut_view(*b), expr, mut_view(dummy_sl));
            mb_operand_from_place(view(*b), view(p), (TypeId {
                v: e_ty.v
            }), mut_view(*out_op));
            return;
        }
        // Check if enum unit variant
        let vp = unsafe {
            thir_get_expr_variant(view(*b.thir), expr as *const HirExpr)
        };
        if (vp as usize) == 0 {
            let mut cv: *mut ConstValue = 0 as *mut ConstValue;
            if sym.v != 0u32 {
                cv = unsafe {
                    sym_constmap_get(view((*b.thir).symbol_consts), (SymbolId {
                        v: sym.v
                    }))
                };
            }
            if (cv as usize) != 0 && (unsafe { (*cv).kind }) == CONST_STR {
                mir_operand_zero(mut_view(*out_op), MIR_OP_CONST);
                out_op.constant.ty.v = e_ty.v;
                out_op.constant.kind = MIR_CONST_STR;
                out_op.constant.str_bytes = unsafe {
                    (*cv).str_bytes
                };
                out_op.constant.str_len = unsafe {
                    (*cv).str_len
                };
                return;
            }
            if (cv as usize) != 0 && (unsafe { (*cv).kind }) == CONST_INT {
                mir_operand_zero(mut_view(*out_op), MIR_OP_CONST);
                out_op.constant.ty.v = e_ty.v;
                out_op.constant.kind = MIR_CONST_INT;
                out_op.constant.val = unsafe {
                    (*cv).int_val
                };
                return;
            }
            let ax = unsafe {
                type_get(view((*b.thir).interner), (TypeId {
                    v: e_ty.v
                }))
            };
            if (ax as usize) != 0 && (unsafe { (*ax).kind }) == TY_FN {
                mir_operand_zero(mut_view(*out_op), MIR_OP_CONST);
                out_op.constant.ty.v = e_ty.v;
                out_op.constant.kind = MIR_CONST_FN;
                out_op.constant.sym.v = sym.v;
                out_op.constant.val = sym.v as u64;
                return;
            }
            if sym.v != 0u32 {
                mir_operand_zero(mut_view(*out_op), MIR_OP_CONST);
                out_op.constant.ty.v = e_ty.v;
                out_op.constant.kind = MIR_CONST_INT;
                out_op.constant.val = sym.v as u64;
                out_op.constant.sym.v = sym.v;
                return;
            }
        }
    }

    let mut is_lval_cand = false;
    if ek == HIR_EXPR_FIELD || ek == HIR_EXPR_TUPLE_INDEX {
        is_lval_cand = true;
    } else if ek == HIR_EXPR_INDEX {
        let idx_arg: *mut HirExpr = unsafe {
            (*expr).index_arg
        };
        if (idx_arg as usize) != 0 && (unsafe { (*idx_arg).kind }) != HIR_EXPR_RANGE {
            is_lval_cand = true;
        }
    }
    if is_lval_cand {
        let vp = unsafe {
            thir_get_expr_variant(view(*b.thir), expr as *const HirExpr)
        };
        let mp = unsafe {
            thir_get_expr_method(view(*b.thir), expr as *const HirExpr)
        };
        if (vp as usize) == 0 && (mp as usize) == 0 {
            let mut dummy_sl = false;
            let p = mir_build_lvalue(mut_view(*b), expr, mut_view(dummy_sl));
            mb_operand_from_place(view(*b), view(p), (TypeId {
                v: e_ty.v
            }), mut_view(*out_op));
            return;
        }
    }

    let tmp = mb_new_temp(mut_view(*b), (TypeId {
        v: e_ty.v
    }), view(sp));
    let mut tmp_pl = mir_local_place(tmp.v);
    mir_build_expr(mut_view(*b), expr, mut_view(tmp_pl), true);
    out_op.kind = MIR_OP_MOVE;
    mir_copy_place(mut_view(out_op.place), view(tmp_pl));
}

fn mb_ast_binop_to_mir(op: u8, out_is_checked: mut_view<bool>) -> u8 {
    *out_is_checked = false;
    if op == BINOP_ADD {
        *out_is_checked = true;
        return MIR_BINOP_ADD;
    }
    if op == BINOP_SUB {
        *out_is_checked = true;
        return MIR_BINOP_SUB;
    }
    if op == BINOP_MUL {
        *out_is_checked = true;
        return MIR_BINOP_MUL;
    }
    if op == BINOP_DIV {
        *out_is_checked = true;
        return MIR_BINOP_DIV;
    }
    if op == BINOP_REM {
        *out_is_checked = true;
        return MIR_BINOP_REM;
    }
    if op == BINOP_SHL {
        *out_is_checked = true;
        return MIR_BINOP_SHL;
    }
    if op == BINOP_SHR {
        *out_is_checked = true;
        return MIR_BINOP_SHR;
    }
    if op == BINOP_BITAND {
        return MIR_BINOP_BIT_AND;
    }
    if op == BINOP_BITOR {
        return MIR_BINOP_BIT_OR;
    }
    if op == BINOP_BITXOR {
        return MIR_BINOP_BIT_XOR;
    }
    if op == BINOP_EQ {
        return MIR_BINOP_EQ;
    }
    if op == BINOP_NE {
        return MIR_BINOP_NE;
    }
    if op == BINOP_LT {
        return MIR_BINOP_LT;
    }
    if op == BINOP_LE {
        return MIR_BINOP_LE;
    }
    if op == BINOP_GT {
        return MIR_BINOP_GT;
    }
    if op == BINOP_GE {
        return MIR_BINOP_GE;
    }
    MIR_BINOP_ADD
}

fn mb_type_bit_width(b: view<MirBuilder>, ty: TypeId) -> u64 {
    let ax = unsafe {
        type_get(view((*b.thir).interner), (TypeId {
            v: ty.v
        }))
    };
    if (ax as usize) == 0 {
        return 32u64;
    }
    let k = unsafe {
        (*ax).kind
    };
    if k == TY_I8 || k == TY_U8 {
        return 8u64;
    }
    if k == TY_I16 || k == TY_U16 {
        return 16u64;
    }
    if k == TY_I32 || k == TY_U32 {
        return 32u64;
    }
    if k == TY_I64 || k == TY_U64 || k == TY_ISIZE || k == TY_USIZE {
        return 64u64;
    }
    32u64
}

fn mb_build_binary_expr(b: mut_view<MirBuilder>, expr: *mut HirExpr, dest: mut_view<MirPlace>) {
    let sp = Span {
        file: FileId { v: unsafe { (*expr).span.file.v } },
        start: unsafe { (*expr).span.start },
        end: unsafe { (*expr).span.end },
    };
    let op = unsafe {
        (*expr).op
    };
    let left_expr: *mut HirExpr = unsafe {
        (*expr).left
    };
    let right_expr: *mut HirExpr = unsafe {
        (*expr).right
    };

    // Short-circuit && and ||
    if op == BINOP_LOGAND || op == BINOP_LOGOR {
        let mut lhs = MirOperand {
            kind: MIR_OP_COPY, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: 0u32
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: 0u32
                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        mb_build_expr_as_operand(mut_view(*b), left_expr, mut_view(lhs));
        if lhs.kind == MIR_OP_MOVE {
            lhs.kind = MIR_OP_COPY;
        }
        let bb_rhs = mb_new_bb(mut_view(*b), false);
        let bb_end = mb_new_bb(mut_view(*b), false);
        mb_emit_assign_use(mut_view(*b), view(*dest), view(lhs), view(sp));
        if op == BINOP_LOGAND {
            mb_emit_switch_single(mut_view(*b), view(lhs), 0u64, (MirBbId {
                v: bb_end.v
            }), (MirBbId {
                v: bb_rhs.v
            }), view(sp));
        } else {
            mb_emit_switch_single(mut_view(*b), view(lhs), 0u64, (MirBbId {
                v: bb_rhs.v
            }), (MirBbId {
                v: bb_end.v
            }), view(sp));
        }
        b.curr_bb.v = bb_rhs.v;
        b.is_diverged = false;
        let mut rhs = MirOperand {
            kind: MIR_OP_COPY, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: 0u32
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: 0u32
                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        mb_build_expr_as_operand(mut_view(*b), right_expr, mut_view(rhs));
        mb_emit_assign_use(mut_view(*b), view(*dest), view(rhs), view(sp));
        mb_terminate_goto(mut_view(*b), (MirBbId {
            v: bb_end.v
        }), view(sp));
        b.curr_bb.v = bb_end.v;
        b.is_diverged = false;
        return;
    }

    let mut lhs = MirOperand {
        kind: MIR_OP_COPY, location: Span {
            file: FileId {
                v: 0u32
            }, start: 0u32, end: 0u32
        }, place: MirPlace {
            local: MirLocalId {
                v: 0u32
            }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
        }, constant: MirConst {
            ty: TypeId {
                v: 0u32
            }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                v: 0u32
            }
        }
    };
    mb_build_expr_as_operand(mut_view(*b), left_expr, mut_view(lhs));
    let mut rhs = MirOperand {
        kind: MIR_OP_COPY, location: Span {
            file: FileId {
                v: 0u32
            }, start: 0u32, end: 0u32
        }, place: MirPlace {
            local: MirLocalId {
                v: 0u32
            }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
        }, constant: MirConst {
            ty: TypeId {
                v: 0u32
            }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                v: 0u32
            }
        }
    };
    mb_build_expr_as_operand(mut_view(*b), right_expr, mut_view(rhs));

    let mut is_checked = false;
    let binop = mb_ast_binop_to_mir(op, mut_view(is_checked));
    let lty = mb_expr_ty(mut_view(*b), left_expr);
    let rty = mb_expr_ty(mut_view(*b), right_expr);
    let lt = unsafe {
        type_get(view((*b.thir).interner), (TypeId {
            v: lty.v
        }))
    };
    let rt = unsafe {
        type_get(view((*b.thir).interner), (TypeId {
            v: rty.v
        }))
    };

    if ((lt as usize) != 0 && (unsafe { (*lt).kind }) == TY_PTR) || ((rt as usize) != 0 && (unsafe { (*rt).kind }) == TY_PTR) {
        is_checked = false;
    }

    let bool_ty = TypeId {
        v: unsafe {
            (*b.thir).interner.t_bool.v
        }
    };

    if is_checked {
        if binop == MIR_BINOP_DIV || binop == MIR_BINOP_REM {
            let cond_nz = mb_new_temp(mut_view(*b), (TypeId {
                v: bool_ty.v
            }), view(sp));
            let cond_nz_pl = mir_local_place(cond_nz.v);
            let zero_op = MirOperand {
                kind: MIR_OP_CONST, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: 0u32
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: rty.v
                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            let mut ne_rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
            ne_rv.kind = MIR_RVALUE_BINARY_OP;
            ne_rv.bin_op = MIR_BINOP_NE;
            mir_copy_operand(mut_view(ne_rv.lhs), view(rhs));
            mir_copy_operand(mut_view(ne_rv.rhs), view(zero_op));
            mb_emit_assign(mut_view(*b), view(cond_nz_pl), view(ne_rv), view(sp));
            let nz_op = MirOperand {
                kind: MIR_OP_COPY, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: cond_nz.v
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: 0u32
                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            mb_emit_assert(mut_view(*b), view(nz_op), true, MB_ASSERT_MSG_DIV_ZERO, view(sp));

            let cond_not_ov = mb_new_temp(mut_view(*b), (TypeId {
                v: bool_ty.v
            }), view(sp));
            let cond_not_ov_pl = mir_local_place(cond_not_ov.v);
            let temp_ov = mb_new_temp(mut_view(*b), (TypeId {
                v: bool_ty.v
            }), view(sp));
            let temp_ov_pl = mir_local_place(temp_ov.v);
            let mut ov_rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
            ov_rv.kind = MIR_RVALUE_OVERFLOWS_BINARY_OP;
            ov_rv.bin_op = binop;
            mir_copy_operand(mut_view(ov_rv.lhs), view(lhs));
            mir_copy_operand(mut_view(ov_rv.rhs), view(rhs));
            mb_emit_assign(mut_view(*b), view(temp_ov_pl), view(ov_rv), view(sp));

            let mut not_rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
