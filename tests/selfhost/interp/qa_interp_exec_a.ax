            };
            unsafe {
                mb_consume_op(mut_view(*b), view(*op_ci));
            }
            ci = ci + 1;
        }
        let next_bb = mb_new_bb(mut_view(*b), false);
        let bb = unsafe {
            mir_bb_at((*b.body).bbs, b.curr_bb.v as usize)
        };
        unsafe {
            mir_term_zero(mut_view((*bb).terminator), MIR_TERM_CALL);
            (*bb).terminator.span.file.v = sp.file.v;
            (*bb).terminator.span.start = sp.start;
            (*bb).terminator.span.end = sp.end;
            mir_copy_operand(mut_view((*bb).terminator.func), view(callee_op));
            (*bb).terminator.args = args_arr;
            (*bb).terminator.arg_count = arg_count;
            mir_copy_place(mut_view((*bb).terminator.destination), view(*dest));
            (*bb).terminator.has_destination = has_dest;
            (*bb).terminator.call_target.v = next_bb.v;
            (*bb).terminator.call_unwind.v = 0u32;
            (*bb).has_terminator = true;
        }
        b.curr_bb.v = next_bb.v;
        b.is_diverged = false;
        return;
    }

    if ek == HIR_EXPR_METHOD_CALL {
        let mp = unsafe {
            thir_get_expr_method(view(*b.thir), expr as *const HirExpr)
        };
        let mut method_item: *mut HirItem = 0 as *mut HirItem;
        if (mp as usize) != 0 {
            method_item = unsafe {
                (*mp) as *mut HirItem
            };
        }
        let mut callee_op = MirOperand {
            kind: MIR_OP_COPY, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: 0u32
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: 0u32
                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        mir_operand_zero(mut_view(callee_op), MIR_OP_CONST);
        callee_op.constant.kind = MIR_CONST_FN;
        let mut fn_ty_id = TypeId {
            v: 0u32
        };
        if (method_item as usize) != 0 {
            let msym = SymbolId {
                v: unsafe {
                    (*method_item).symbol.v
                }
            };
            callee_op.constant.sym.v = msym.v;
            callee_op.constant.val = msym.v as u64;
            fn_ty_id = mb_item_ty(mut_view(*b), method_item);
            callee_op.constant.ty.v = fn_ty_id.v;
        }
        let fn_ax = unsafe {
            type_get(view((*b.thir).interner), (TypeId {
                v: fn_ty_id.v
            }))
        };
        let mut explicit_args: usize = 0;
        let mut cur_a: *mut HirExpr = unsafe {
            (*expr).args
        };
        while ((cur_a as usize) != 0) {
            explicit_args = explicit_args + 1;
            cur_a = unsafe {
                (*cur_a).next
            };
        }
        let has_self: bool = if (fn_ax as usize) != 0 && (unsafe { (*fn_ax).kind }) == TY_FN {
            (explicit_args + 1) == (unsafe { (*fn_ax).param_count })
        } else {
            true
        };
        let total_args = explicit_args + (if has_self {
            1
        } else {
            0
        });
        let mut args_arr: *mut MirOperand = 0 as *mut MirOperand;
        if total_args > 0 {
            let bytes = mir_mul_usize(total_args, size_of<MirOperand>());
            args_arr = unsafe {
                arena_alloc_raw(mut_view(*b.arena), bytes, align_of<MirOperand>()) as *mut MirOperand
            };
            let mut idx: usize = 0;
            if has_self {
                let recv: *mut HirExpr = unsafe {
                    (*expr).receiver
                };
                let recv_ty = mb_expr_ty(mut_view(*b), recv);
                let recv_ax = unsafe {
                    type_get(view((*b.thir).interner), (TypeId {
                        v: recv_ty.v
                    }))
                };
                let mut need_auto_ref = false;
                let mut is_mut_ref = false;
                let mut self_ty = (TypeId {
                    v: recv_ty.v
                });
                if (fn_ax as usize) != 0 && (unsafe { (*fn_ax).param_count }) > 0 {
                    let p0_ptr = unsafe {
                        typeid_at((*fn_ax).param_types, 0)
                    };
                    self_ty = mb_resolve_ty(mut_view(*b), TypeId {
                        v: unsafe {
                            (*p0_ptr).v
                        }
                    });
                    let self_ax = unsafe {
                        type_get(view((*b.thir).interner), (TypeId {
                            v: self_ty.v
                        }))
                    };
                    if (self_ax as usize) != 0 && ((unsafe { (*self_ax).kind }) == TY_VIEW || (unsafe { (*self_ax).kind }) == TY_MUT_VIEW) {
                        if (recv_ax as usize) != 0 && (unsafe { (*recv_ax).kind }) != TY_VIEW && (unsafe { (*recv_ax).kind }) != TY_MUT_VIEW {
                            need_auto_ref = true;
                            is_mut_ref = (unsafe {
                                (*self_ax).kind
                            }) == TY_MUT_VIEW;
                        }
                    }
                }
                let dst0 = unsafe {
                    mir_op_at(args_arr, 0)
                };
                if need_auto_ref {
                    let mut dummy_sl = false;
                    let recv_pl = mir_build_lvalue(mut_view(*b), recv, mut_view(dummy_sl));
                    let tmp = mb_new_temp(mut_view(*b), self_ty, view(sp));
                    let tmp_pl = mir_local_place(tmp.v);
                    let mut ref_rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
                    ref_rv.kind = MIR_RVALUE_REF;
                    ref_rv.borrow_kind = if is_mut_ref {
                        MIR_BORROW_MUT
                    } else {
                        MIR_BORROW_SHARED
                    };
                    mir_copy_place(mut_view(ref_rv.place), view(recv_pl));
                    mb_emit_assign(mut_view(*b), view(tmp_pl), view(ref_rv), view(sp));
                    unsafe {
                        *dst0 = MirOperand {
                            kind: MIR_OP_MOVE, location: Span {
                                file: FileId {
                                    v: 0u32
                                }, start: 0u32, end: 0u32
                            }, place: MirPlace {
                                local: MirLocalId {
                                    v: tmp.v
                                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                            }, constant: MirConst {
                                ty: TypeId {
                                    v: 0u32
                                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                                    v: 0u32
                                }
                            }
                        };
                    }
                } else {
                    let mut op0 = MirOperand {
                        kind: MIR_OP_COPY, location: Span {
                            file: FileId {
                                v: 0u32
                            }, start: 0u32, end: 0u32
                        }, place: MirPlace {
                            local: MirLocalId {
                                v: 0u32
                            }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                        }, constant: MirConst {
                            ty: TypeId {
                                v: 0u32
                            }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                                v: 0u32
                            }
                        }
                    };
                    mb_build_expr_as_operand(mut_view(*b), recv, mut_view(op0));
                    unsafe {
                        mir_copy_operand(mut_view(*dst0), view(op0));
                    }
                }
                idx = 1;
            }
            cur_a = unsafe {
                (*expr).args
            };
            while ((cur_a as usize) != 0) {
                let mut op_a = MirOperand {
                    kind: MIR_OP_COPY, location: Span {
                        file: FileId {
                            v: 0u32
                        }, start: 0u32, end: 0u32
                    }, place: MirPlace {
                        local: MirLocalId {
                            v: 0u32
                        }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                    }, constant: MirConst {
                        ty: TypeId {
                            v: 0u32
                        }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                            v: 0u32
                        }
                    }
                };
                mb_build_expr_as_operand(mut_view(*b), cur_a, mut_view(op_a));
                let dst_op = unsafe {
                    mir_op_at(args_arr, idx)
                };
                unsafe {
                    mir_copy_operand(mut_view(*dst_op), view(op_a));
                }
                idx = idx + 1;
                cur_a = unsafe {
                    (*cur_a).next
                };
            }
        }
        mb_consume_op(mut_view(*b), view(callee_op));
        let mut mci: usize = 0;
        while (mci < total_args) {
            let op_mci = unsafe {
                mir_op_at(args_arr, mci)
            };
            unsafe {
                mb_consume_op(mut_view(*b), view(*op_mci));
            }
            mci = mci + 1;
        }
        let next_bb = mb_new_bb(mut_view(*b), false);
        let bb = unsafe {
            mir_bb_at((*b.body).bbs, b.curr_bb.v as usize)
        };
        unsafe {
            mir_term_zero(mut_view((*bb).terminator), MIR_TERM_CALL);
            (*bb).terminator.span.file.v = sp.file.v;
            (*bb).terminator.span.start = sp.start;
            (*bb).terminator.span.end = sp.end;
            mir_copy_operand(mut_view((*bb).terminator.func), view(callee_op));
            (*bb).terminator.args = args_arr;
            (*bb).terminator.arg_count = total_args;
            mir_copy_place(mut_view((*bb).terminator.destination), view(*dest));
            (*bb).terminator.has_destination = has_dest;
            (*bb).terminator.call_target.v = next_bb.v;
            (*bb).terminator.call_unwind.v = 0u32;
            (*bb).has_terminator = true;
        }
        b.curr_bb.v = next_bb.v;
        b.is_diverged = false;
        return;
    }

    if ek == HIR_EXPR_BLOCK || ek == HIR_EXPR_UNSAFE || ek == HIR_EXPR_COMPTIME {
        mir_build_block(mut_view(*b), unsafe {
            (*expr).block
        }, mut_view(*dest), has_dest);
        return;
    }

    if ek == HIR_EXPR_IF {
        let let_pat: *mut HirPat = unsafe {
            (*expr).let_pat
        };
        if (let_pat as usize) != 0 {
            let scrut_expr: *mut HirExpr = unsafe {
                (*expr).cond
            };
            let scrut_ty = mb_expr_ty(mut_view(*b), scrut_expr);
            let scrut_loc = mb_new_temp(mut_view(*b), (TypeId {
                v: scrut_ty.v
            }), view(sp));
            let mut scrut_pl = mir_local_place(scrut_loc.v);
            mir_build_expr(mut_view(*b), scrut_expr, mut_view(scrut_pl), true);
            let bb_else = mb_new_bb(mut_view(*b), false);
            let bb_end = mb_new_bb(mut_view(*b), false);
            mb_build_pat_match_in_place(mut_view(*b), let_pat, view(scrut_pl), (TypeId {
                v: scrut_ty.v
            }), (MirBbId {
                v: bb_else.v
            }));
            mir_build_block(mut_view(*b), unsafe {
                (*expr).block
            }, mut_view(*dest), has_dest);
            let then_diverged = b.is_diverged;
            if !b.is_diverged {
                mb_terminate_goto(mut_view(*b), (MirBbId {
                    v: bb_end.v
                }), view(sp));
            }
            b.curr_bb.v = bb_else.v;
            b.is_diverged = false;
            let else_br: *mut HirExpr = unsafe {
                (*expr).else_branch
            };
            if (else_br as usize) != 0 {
                mir_build_expr(mut_view(*b), else_br, mut_view(*dest), has_dest);
            }
            let else_diverged = b.is_diverged;
            if !b.is_diverged {
                mb_terminate_goto(mut_view(*b), (MirBbId {
                    v: bb_end.v
                }), view(sp));
            }
            b.curr_bb.v = bb_end.v;
            b.is_diverged = then_diverged && else_diverged;
            return;
        }

        let mut cond_op = MirOperand {
            kind: MIR_OP_COPY, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: 0u32
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: 0u32
                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        mb_build_expr_as_operand(mut_view(*b), unsafe {
            (*expr).cond
        }, mut_view(cond_op));
        let bb_then = mb_new_bb(mut_view(*b), false);
        let bb_else = mb_new_bb(mut_view(*b), false);
        let bb_end = mb_new_bb(mut_view(*b), false);
        mb_emit_switch_single(mut_view(*b), view(cond_op), 0u64, (MirBbId {
            v: bb_else.v
        }), (MirBbId {
            v: bb_then.v
        }), view(sp));

        b.curr_bb.v = bb_then.v;
        b.is_diverged = false;
        mir_build_block(mut_view(*b), unsafe {
            (*expr).block
        }, mut_view(*dest), has_dest);
        let then_diverged = b.is_diverged;
        if !b.is_diverged {
            mb_terminate_goto(mut_view(*b), (MirBbId {
                v: bb_end.v
            }), view(sp));
        }

        b.curr_bb.v = bb_else.v;
        b.is_diverged = false;
        let else_br: *mut HirExpr = unsafe {
            (*expr).else_branch
        };
        if (else_br as usize) != 0 {
            mir_build_expr(mut_view(*b), else_br, mut_view(*dest), has_dest);
        }
        let else_diverged = b.is_diverged;
        if !b.is_diverged {
            mb_terminate_goto(mut_view(*b), (MirBbId {
                v: bb_end.v
            }), view(sp));
        }

        b.curr_bb.v = bb_end.v;
        b.is_diverged = then_diverged && else_diverged;
        return;
    }

    mb_build_match_loop_jump_try_closure_expr(mut_view(*b), expr, mut_view(*dest), has_dest);
}
fn mb_build_match_loop_jump_try_closure_expr(
    b: mut_view<MirBuilder>,
    expr: *mut HirExpr,
    dest: mut_view<MirPlace>,
    has_dest: bool
) {
    let sp = Span {
        file: FileId { v: unsafe { (*expr).span.file.v } },
        start: unsafe { (*expr).span.start },
        end: unsafe { (*expr).span.end },
    };
    let ek = unsafe {
        (*expr).kind
    };
    let e_ty = mb_expr_ty(mut_view(*b), expr);

    if ek == HIR_EXPR_MATCH {
        let scrut_expr: *mut HirExpr = unsafe {
            (*expr).cond
        };
        let scrut_ty = mb_expr_ty(mut_view(*b), scrut_expr);
        let scrut_loc = mb_new_temp(mut_view(*b), (TypeId {
            v: scrut_ty.v
        }), view(sp));
        let mut scrut_pl = mir_local_place(scrut_loc.v);
        mir_build_expr(mut_view(*b), scrut_expr, mut_view(scrut_pl), true);

        let bb_end = mb_new_bb(mut_view(*b), false);
        let mut any_arm_reached_end = false;
        let mut arm: *mut HirMatchArm = unsafe {
            (*expr).arms
        };
        while ((arm as usize) != 0) {
            let next_arm: *mut HirMatchArm = unsafe {
                (*arm).next
            };
            let bb_next_arm = mb_new_bb(mut_view(*b), false);
            if (next_arm as usize) == 0 {
                let unreach_bb = unsafe {
                    mir_bb_at((*b.body).bbs, bb_next_arm.v as usize)
                };
                unsafe {
                    mir_term_zero(mut_view((*unreach_bb).terminator), MIR_TERM_UNREACHABLE);
                    (*unreach_bb).terminator.span.file.v = sp.file.v;
                    (*unreach_bb).terminator.span.start = sp.start;
                    (*unreach_bb).terminator.span.end = sp.end;
                    (*unreach_bb).has_terminator = true;
                }
            }
            mb_build_pat_match_in_place(mut_view(*b), unsafe {
                (*arm).pat
            }, view(scrut_pl), (TypeId {
                v: scrut_ty.v
            }), (MirBbId {
                v: bb_next_arm.v
            }));

            let guard: *mut HirExpr = unsafe {
                (*arm).guard
            };
            if (guard as usize) != 0 {
                let mut g_op = MirOperand {
                    kind: MIR_OP_COPY, location: Span {
                        file: FileId {
                            v: 0u32
                        }, start: 0u32, end: 0u32
                    }, place: MirPlace {
                        local: MirLocalId {
                            v: 0u32
                        }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                    }, constant: MirConst {
                        ty: TypeId {
                            v: 0u32
                        }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                            v: 0u32
                        }
                    }
                };
                mb_build_expr_as_operand(mut_view(*b), guard, mut_view(g_op));
                let bb_guard_ok = mb_new_bb(mut_view(*b), false);
                mb_emit_switch_single(mut_view(*b), view(g_op), 0u64, (MirBbId {
                    v: bb_next_arm.v
                }), (MirBbId {
                    v: bb_guard_ok.v
                }), view(sp));
                b.curr_bb.v = bb_guard_ok.v;
                b.is_diverged = false;
            }

            mir_build_expr(mut_view(*b), unsafe {
                (*arm).body
            }, mut_view(*dest), has_dest);
            if !b.is_diverged {
                any_arm_reached_end = true;
                mb_terminate_goto(mut_view(*b), (MirBbId {
                    v: bb_end.v
                }), view(sp));
            }

            b.curr_bb.v = bb_next_arm.v;
            b.is_diverged = false;
            arm = next_arm;
        }
        b.curr_bb.v = bb_end.v;
        b.is_diverged = !any_arm_reached_end;
        return;
    }

    if ek == HIR_EXPR_LOOP {
        let loop_bb = mb_new_bb(mut_view(*b), false);
        let exit_bb = mb_new_bb(mut_view(*b), false);
        mb_terminate_goto(mut_view(*b), (MirBbId {
            v: loop_bb.v
        }), view(sp));
        b.curr_bb.v = loop_bb.v;
        b.is_diverged = false;

        mb_push_loop(mut_view(*b), StrId {
            v: unsafe {
                (*expr).label.v
            }
        }, (MirBbId {
            v: exit_bb.v
        }), (MirBbId {
            v: loop_bb.v
        }), view(*dest), has_dest);
        mir_build_block(mut_view(*b), unsafe {
            (*expr).block
        }, mut_view(*dest), has_dest);
        if !b.is_diverged {
            mb_terminate_goto(mut_view(*b), (MirBbId {
                v: loop_bb.v
            }), view(sp));
        }
        b.loop_depth = b.loop_depth - 1;
        b.curr_bb.v = exit_bb.v;
        b.is_diverged = false;
        return;
    }

    if ek == HIR_EXPR_WHILE {
        let cond_bb = mb_new_bb(mut_view(*b), false);
        let body_bb = mb_new_bb(mut_view(*b), false);
        let exit_bb = mb_new_bb(mut_view(*b), false);
        mb_terminate_goto(mut_view(*b), (MirBbId {
            v: cond_bb.v
        }), view(sp));

        b.curr_bb.v = cond_bb.v;
        b.is_diverged = false;
        let let_pat: *mut HirPat = unsafe {
            (*expr).let_pat
        };
        if (let_pat as usize) != 0 {
            let scrut_expr: *mut HirExpr = unsafe {
                (*expr).cond
            };
            let scrut_ty = mb_expr_ty(mut_view(*b), scrut_expr);
            let scrut_loc = mb_new_temp(mut_view(*b), (TypeId {
                v: scrut_ty.v
            }), view(sp));
            let mut scrut_pl = mir_local_place(scrut_loc.v);
            mir_build_expr(mut_view(*b), scrut_expr, mut_view(scrut_pl), true);
            mb_build_pat_match_in_place(mut_view(*b), let_pat, view(scrut_pl), (TypeId {
                v: scrut_ty.v
            }), (MirBbId {
                v: exit_bb.v
            }));
            mb_terminate_goto(mut_view(*b), (MirBbId {
                v: body_bb.v
            }), view(sp));
        } else {
            let mut cond_op = MirOperand {
                kind: MIR_OP_COPY, location: Span {
                    file: FileId {
                        v: 0u32
                    }, start: 0u32, end: 0u32
                }, place: MirPlace {
                    local: MirLocalId {
                        v: 0u32
                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                }, constant: MirConst {
                    ty: TypeId {
                        v: 0u32
                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                        v: 0u32
                    }
                }
            };
            mb_build_expr_as_operand(mut_view(*b), unsafe {
                (*expr).cond
            }, mut_view(cond_op));
            mb_emit_switch_single(mut_view(*b), view(cond_op), 1u64, (MirBbId {
                v: body_bb.v
            }), (MirBbId {
                v: exit_bb.v
            }), view(sp));
        }

        b.curr_bb.v = body_bb.v;
        b.is_diverged = false;
        mb_push_loop(mut_view(*b), StrId {
            v: unsafe {
                (*expr).label.v
            }
        }, (MirBbId {
            v: exit_bb.v
        }), (MirBbId {
            v: cond_bb.v
        }), view(*dest), has_dest);
        mir_build_block(mut_view(*b), unsafe {
            (*expr).block
        }, mut_view(*dest), has_dest);
        if !b.is_diverged {
            mb_terminate_goto(mut_view(*b), (MirBbId {
                v: cond_bb.v
            }), view(sp));
        }
        b.loop_depth = b.loop_depth - 1;
        b.curr_bb.v = exit_bb.v;
        b.is_diverged = false;
        return;
    }

    if ek == HIR_EXPR_JUMP {
        let jk = unsafe {
            (*expr).jump_kind
        };
        if jk == JUMP_RETURN {
            let inner: *mut HirExpr = unsafe {
                (*expr).inner
            };
            if (inner as usize) != 0 {
                let mut ret_pl = mir_local_place(0u32);
                mir_build_expr(mut_view(*b), inner, mut_view(ret_pl), true);
            }
            if !b.is_diverged {
                mb_build_drop_chain(mut_view(*b), b.current_drops, 0 as *mut MirDropNode, MirBbId {
                    v: 0u32
                }, view(sp));
                let bb = unsafe {
                    mir_bb_at((*b.body).bbs, b.curr_bb.v as usize)
                };
                unsafe {
                    mir_term_zero(mut_view((*bb).terminator), MIR_TERM_RETURN);
                    (*bb).terminator.span.file.v = sp.file.v;
                    (*bb).terminator.span.start = sp.start;
                    (*bb).terminator.span.end = sp.end;
                    (*bb).has_terminator = true;
                }
                b.is_diverged = true;
            }
        } else if jk == JUMP_BREAK {
            let ls = mb_find_loop(view(*b), StrId {
                v: unsafe {
                    (*expr).label.v
                }
            });
            if (ls as usize) != 0 {
                let inner: *mut HirExpr = unsafe {
                    (*expr).inner
                };
                let b_bb = MirBbId {
                    v: unsafe {
                        (*ls).break_bb.v
                    }
                };
                let d_scope = unsafe {
                    (*ls).drop_scope
                };
                if (inner as usize) != 0 {
                    let mut d_pl = mir_local_place(0u32);
                    unsafe {
                        mir_copy_place(mut_view(d_pl), view((*ls).dest));
                    }
                    mir_build_expr(mut_view(*b), inner, mut_view(d_pl), true);
                }
                if !b.is_diverged {
                    mb_build_drop_chain(mut_view(*b), b.current_drops, d_scope, (MirBbId {
                        v: b_bb.v
                    }), view(sp));
                }
            }
        } else if jk == JUMP_CONTINUE {
            let ls = mb_find_loop(view(*b), StrId {
                v: unsafe {
                    (*expr).label.v
                }
            });
            if (ls as usize) != 0 {
                let c_bb = MirBbId {
                    v: unsafe {
                        (*ls).continue_bb.v
                    }
                };
                let d_scope = unsafe {
                    (*ls).drop_scope
                };
                if !b.is_diverged {
                    mb_build_drop_chain(mut_view(*b), b.current_drops, d_scope, (MirBbId {
                        v: c_bb.v
                    }), view(sp));
                }
            }
        }
        return;
    }

    if ek == HIR_EXPR_TRY {
        let inner: *mut HirExpr = unsafe {
            (*expr).inner
        };
        let inner_ty = mb_expr_ty(mut_view(*b), inner);
        let expr_loc = mb_new_temp(mut_view(*b), (TypeId {
            v: inner_ty.v
        }), view(sp));
        let mut expr_pl = mir_local_place(expr_loc.v);
        mir_build_expr(mut_view(*b), inner, mut_view(expr_pl), true);

        let mut is_opt = false;
        let mut payload_idx: u32 = 0u32;
        let mut err_idx: u32 = 1u32;
        let tinfo = unsafe {
            ptr_trymap_get(view((*b.thir).expr_try_info), expr as usize)
        };
        if (tinfo as usize) != 0 {
            is_opt = unsafe {
                (*tinfo).is_opt
            };
            payload_idx = unsafe {
                (*tinfo).payload_idx as u32
            };
            err_idx = unsafe {
                (*tinfo).err_idx as u32
            };
        }

        let u32_ty = TypeId {
            v: unsafe {
                (*b.thir).interner.t_u32.v
            }
        };
        let discr_loc = mb_new_temp(mut_view(*b), (TypeId {
            v: u32_ty.v
        }), view(sp));
        let discr_pl = mir_local_place(discr_loc.v);
        let mut discr_rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
        discr_rv.kind = MIR_RVALUE_DISCRIMINANT;
        mir_copy_place(mut_view(discr_rv.place), view(expr_pl));
        mb_emit_assign(mut_view(*b), view(discr_pl), view(discr_rv), view(sp));

        let bb_ok = mb_new_bb(mut_view(*b), false);
        let bb_err = mb_new_bb(mut_view(*b), false);
        let discr_op = MirOperand {
            kind: MIR_OP_COPY, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: discr_loc.v
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: 0u32
                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        mb_emit_switch_single(mut_view(*b), view(discr_op), payload_idx as u64, (MirBbId {
            v: bb_ok.v
        }), (MirBbId {
            v: bb_err.v
        }), view(sp));

        b.curr_bb.v = bb_ok.v;
        b.is_diverged = false;
        let ok_down = mb_append_proj_downcast(mut_view(*b), view(expr_pl), payload_idx);
        let ok_f0 = mb_append_proj_field(mut_view(*b), view(ok_down), 0u32);
        let mut ok_op = MirOperand {
            kind: MIR_OP_COPY, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: 0u32
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: 0u32
                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        ok_op.kind = MIR_OP_MOVE;
        mir_copy_place(mut_view(ok_op.place), view(ok_f0));
        if has_dest {
            mb_emit_assign_use(mut_view(*b), view(*dest), view(ok_op), view(sp));
        }

        b.curr_bb.v = bb_err.v;
        b.is_diverged = false;
        let ret_pl = mir_local_place(0u32);
        if is_opt {
            let mut rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
            rv.kind = MIR_RVALUE_AGGREGATE;
            rv.variant_idx = err_idx;
            mb_emit_assign(mut_view(*b), view(ret_pl), view(rv), view(sp));
        } else {
            let err_down = mb_append_proj_downcast(mut_view(*b), view(expr_pl), err_idx);
            let err_f0 = mb_append_proj_field(mut_view(*b), view(err_down), 0u32);
            let err_op_ptr = unsafe {
                arena_alloc_raw(mut_view(*b.arena), size_of<MirOperand>(), align_of<MirOperand>()) as *mut MirOperand
            };
            unsafe {
                (*err_op_ptr).kind = MIR_OP_MOVE;
                mir_copy_place(mut_view((*err_op_ptr).place), view(err_f0));
            }
            let mut rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
            rv.kind = MIR_RVALUE_AGGREGATE;
            rv.variant_idx = err_idx;
            rv.operands = err_op_ptr;
            rv.operand_count = 1;
            mb_emit_assign(mut_view(*b), view(ret_pl), view(rv), view(sp));
        }
        mb_build_drop_chain(mut_view(*b), b.current_drops, 0 as *mut MirDropNode, MirBbId {
            v: 0u32
        }, view(sp));
        let bb = unsafe {
            mir_bb_at((*b.body).bbs, b.curr_bb.v as usize)
        };
        unsafe {
            mir_term_zero(mut_view((*bb).terminator), MIR_TERM_RETURN);
            (*bb).terminator.span.file.v = sp.file.v;
            (*bb).terminator.span.start = sp.start;
            (*bb).terminator.span.end = sp.end;
            (*bb).has_terminator = true;
        }
        b.curr_bb.v = bb_ok.v;
        b.is_diverged = false;
        return;
    }

    if ek == HIR_EXPR_CLOSURE {
        let ax = unsafe {
            type_get(view((*b.thir).interner), (TypeId {
                v: e_ty.v
            }))
        };
        if (ax as usize) != 0 && (unsafe { (*ax).kind }) == TY_CLOSURE {
            let fn_sym = SymbolId {
                v: unsafe {
                    (*ax).fn_sym
                }
            };
            let cap_cnt = unsafe {
                (*ax).capture_count
            };
            let caps = unsafe {
                (*ax).captures
            };
            let clos_body = unsafe {
                mir_build_closure(
                    mut_view(*b.arena),
                    expr,
                    (TypeId { v: e_ty.v }),
                    b.thir,
                    b.hir,
                    b.str_in,
                    b.db,
                    b.mono,
                    view(b.subst_args)
                )
            };
            if (clos_body as usize) != 0 {
                let ent = unsafe {
                    arena_alloc_raw(mut_view(*b.arena), size_of<MirClosureBodyEntry>(), align_of<MirClosureBodyEntry>()) as *mut MirClosureBodyEntry
                };
                unsafe {
                    (*ent).sym.v = fn_sym.v;
                    (*ent).closure_id = (*ax).closure_id;
                    (*ent).body = clos_body;
                    (*ent).next = 0 as *mut MirClosureBodyEntry;
                }
                if (b.closure_tail as usize) == 0 {
                    b.closure_head = ent;
                    b.closure_tail = ent;
                } else {
                    unsafe {
                        (*b.closure_tail).next = ent;
                    }
                    b.closure_tail = ent;
                }
            }
            if cap_cnt == 0 {
                let op = MirOperand {
                    kind: MIR_OP_CONST, location: Span {
                        file: FileId {
                            v: 0u32
                        }, start: 0u32, end: 0u32
                    }, place: MirPlace {
                        local: MirLocalId {
                            v: 0u32
                        }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                    }, constant: MirConst {
                        ty: TypeId {
                            v: e_ty.v
                        }, kind: MIR_CONST_INT, val: fn_sym.v as u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                            v: 0u32
                        }
                    }
                };
                mb_emit_assign_use(mut_view(*b), view(*dest), view(op), view(sp));
            } else {
                let num_ops = 1 + cap_cnt;
                let bytes = mir_mul_usize(num_ops, size_of<MirOperand>());
                let ops = unsafe {
                    arena_alloc_raw(mut_view(*b.arena), bytes, align_of<MirOperand>()) as *mut MirOperand
                };
                let u64_ty = TypeId {
                    v: unsafe {
                        (*b.thir).interner.t_u64.v
                    }
                };
                let op0 = unsafe {
                    mir_op_at(ops, 0)
                };
                unsafe {
                    *op0 = MirOperand {
                        kind: MIR_OP_CONST, location: Span {
                            file: FileId {
                                v: 0u32
                            }, start: 0u32, end: 0u32
                        }, place: MirPlace {
                            local: MirLocalId {
                                v: 0u32
                            }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                        }, constant: MirConst {
                            ty: TypeId {
                                v: u64_ty.v
                            }, kind: MIR_CONST_INT, val: fn_sym.v as u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                                v: 0u32
                            }
                        }
                    };
                }
                let mut i: usize = 0;
                while (i < cap_cnt) {
                    let cap = unsafe {
                        capture_at(caps, i)
                    };
                    let csym = SymbolId {
                        v: unsafe {
                            (*cap).sym.v
                        }
                    };
                    let cmode = unsafe {
                        (*cap).mode
                    };
                    let cty = TypeId {
                        v: unsafe {
                            (*cap).ty.v
                        }
                    };
                    let mut cloc = MirLocalId {
                        v: 0u32
                    };
                    let mut is_sl = false;
                    mb_lookup_sym(view(*b), (SymbolId {
                        v: csym.v
                    }), mut_view(cloc), mut_view(is_sl));
                    let cap_pl = mir_local_place(cloc.v);
                    let dst_op = unsafe {
                        mir_op_at(ops, 1 + i)
                    };
                    if cmode == CAP_VIEW || cmode == CAP_MUT_VIEW {
                        let tmp = mb_new_temp(mut_view(*b), (TypeId {
                            v: cty.v
                        }), view(sp));
                        let tmp_pl = mir_local_place(tmp.v);
                        let mut ref_rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
                        ref_rv.kind = MIR_RVALUE_REF;
                        ref_rv.borrow_kind = if cmode == CAP_MUT_VIEW {
                            MIR_BORROW_MUT
                        } else {
                            MIR_BORROW_SHARED
                        };
                        mir_copy_place(mut_view(ref_rv.place), view(cap_pl));
                        mb_emit_assign(mut_view(*b), view(tmp_pl), view(ref_rv), view(sp));
                        unsafe {
                            *dst_op = MirOperand {
                                kind: MIR_OP_MOVE, location: Span {
                                    file: FileId {
                                        v: 0u32
                                    }, start: 0u32, end: 0u32
                                }, place: MirPlace {
                                    local: MirLocalId {
                                        v: tmp.v
                                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                                }, constant: MirConst {
                                    ty: TypeId {
                                        v: 0u32
                                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                                        v: 0u32
                                    }
                                }
                            };
                        }
                    } else if cmode == CAP_COPY {
                        unsafe {
                            *dst_op = MirOperand {
                                kind: MIR_OP_COPY, location: Span {
                                    file: FileId {
                                        v: 0u32
                                    }, start: 0u32, end: 0u32
                                }, place: MirPlace {
                                    local: MirLocalId {
                                        v: cloc.v
                                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                                }, constant: MirConst {
                                    ty: TypeId {
                                        v: 0u32
                                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                                        v: 0u32
                                    }
                                }
                            };
                        }
                    } else {
                        unsafe {
                            *dst_op = MirOperand {
                                kind: MIR_OP_MOVE, location: Span {
                                    file: FileId {
                                        v: 0u32
                                    }, start: 0u32, end: 0u32
                                }, place: MirPlace {
                                    local: MirLocalId {
                                        v: cloc.v
                                    }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
                                }, constant: MirConst {
                                    ty: TypeId {
                                        v: 0u32
                                    }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                                        v: 0u32
                                    }
                                }
                            };
                        }
                    }
                    i = i + 1;
                }
                let mut rv = MirRvalue {
        kind: MIR_RVALUE_USE,
        use_op: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        repeat_count: 0u64,
        repeat_count_op: 0 as *mut MirOperand,
        borrow_kind: MIR_BORROW_SHARED,
        place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
        cast_kind: MIR_CAST_INT_TO_INT,
        target_ty: TypeId { v: 0u32 },
        bin_op: MIR_BINOP_ADD,
        lhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        rhs: MirOperand {
            kind: MIR_OP_COPY,
            location: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
            place: MirPlace { local: MirLocalId { v: 0u32 }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE },
            constant: MirConst { ty: TypeId { v: 0u32 }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId { v: 0u32 } },
        },
        un_op: MIR_UNOP_NOT,
        variant_idx: 0u32,
        operands: 0 as *mut MirOperand,
        operand_count: 0,
    };
                rv.kind = MIR_RVALUE_AGGREGATE;
                rv.variant_idx = 0u32;
                rv.operands = ops;
                rv.operand_count = num_ops;
                mb_emit_assign(mut_view(*b), view(*dest), view(rv), view(sp));
            }
        }
        return;
    }
}

// =============================================================================
// Statement, Block & Function/Closure Entry Points
// =============================================================================

pub fn mir_build_stmt(b: mut_view<MirBuilder>, stmt: *mut HirStmt) {
    if (stmt as usize) == 0 || b.is_diverged {
        return;
    }
    let sk = unsafe {
        (*stmt).kind
    };
    let sp = Span {
        file: FileId { v: unsafe { (*stmt).span.file.v } },
        start: unsafe { (*stmt).span.start },
        end: unsafe { (*stmt).span.end },
    };

    if sk == HIR_STMT_LET {
        let pat: *mut HirPat = unsafe {
            (*stmt).pat
        };
        let init_expr: *mut HirExpr = unsafe {
            (*stmt).expr
        };
        let else_blk: *mut HirBlock = unsafe {
            (*stmt).else_block
        };
        let mut p_ty = mb_pat_ty(mut_view(*b), pat);
        if p_ty.v == 0u32 && (init_expr as usize) != 0 {
            p_ty = mb_expr_ty(mut_view(*b), init_expr);
        }
        if (init_expr as usize) != 0 {
            let tmp = mb_new_temp(mut_view(*b), (TypeId {
                v: p_ty.v
            }), view(sp));
            let mut tmp_pl = mir_local_place(tmp.v);
            mir_build_expr(mut_view(*b), init_expr, mut_view(tmp_pl), true);
            if !b.is_diverged {
                if (else_blk as usize) != 0 {
                    let ok_bb = mb_new_bb(mut_view(*b), false);
                    let fail_bb = mb_new_bb(mut_view(*b), false);
                    mb_build_pat_match(mut_view(*b), pat, view(tmp_pl), (TypeId {
                        v: p_ty.v
                    }), (MirBbId {
                        v: ok_bb.v
                    }), (MirBbId {
                        v: fail_bb.v
                    }));
                    b.curr_bb.v = fail_bb.v;
                    b.is_diverged = false;
                    let mut dummy_pl = mir_local_place(0u32);
                    mir_build_block(mut_view(*b), else_blk, mut_view(dummy_pl), false);
                    if !b.is_diverged {
                        let fbb = unsafe {
                            mir_bb_at((*b.body).bbs, b.curr_bb.v as usize)
                        };
                        unsafe {
                            mir_term_zero(mut_view((*fbb).terminator), MIR_TERM_UNREACHABLE);
                            (*fbb).terminator.span.file.v = sp.file.v;
                            (*fbb).terminator.span.start = sp.start;
                            (*fbb).terminator.span.end = sp.end;
                            (*fbb).has_terminator = true;
                        }
                    }
                    b.curr_bb.v = ok_bb.v;
                    b.is_diverged = false;
                } else {
                    mb_build_pat_match_in_place(mut_view(*b), pat, view(tmp_pl), (TypeId {
                        v: p_ty.v
                    }), MirBbId {
                        v: 0u32
                    });
                }
            }
        } else {
            mb_declare_pat_locals(mut_view(*b), pat, (TypeId {
                v: p_ty.v
            }));
        }
    } else if sk == HIR_STMT_ASSIGN {
        let mut dummy_sl = false;
        let mut lhs_pl = mir_build_lvalue(mut_view(*b), unsafe {
            (*stmt).left
        }, mut_view(dummy_sl));
        mir_build_expr(mut_view(*b), unsafe {
            (*stmt).right
        }, mut_view(lhs_pl), true);
    } else if sk == HIR_STMT_EXPR {
        let e: *mut HirExpr = unsafe {
            (*stmt).expr
        };
        let e_ty = mb_expr_ty(mut_view(*b), e);
        if e_ty.v != 0u32 {
            let tmp = mb_new_temp(mut_view(*b), (TypeId {
                v: e_ty.v
            }), view(sp));
            let mut tmp_pl = mir_local_place(tmp.v);
            mir_build_expr(mut_view(*b), e, mut_view(tmp_pl), true);
        } else {
            let mut void_pl = mir_local_place(0u32);
            mir_build_expr(mut_view(*b), e, mut_view(void_pl), false);
        }
    }
}

pub fn mir_build_block(
    b: mut_view<MirBuilder>,
    blk: *mut HirBlock,
    dest: mut_view<MirPlace>,
    has_dest: bool
) {
    if (blk as usize) == 0 || b.is_diverged {
        return;
    }
    let sp = Span {
        file: FileId { v: unsafe { (*blk).span.file.v } },
        start: unsafe { (*blk).span.start },
        end: unsafe { (*blk).span.end },
    };
    let old_drops: *mut MirDropNode = b.current_drops;
    let mut st: *mut HirStmt = unsafe {
        (*blk).stmts
    };
    while ((st as usize) != 0 && !b.is_diverged) {
        let next_st: *mut HirStmt = unsafe {
            (*st).next
        };
        let st_sp = Span {
            file: FileId { v: unsafe { (*st).span.file.v } },
            start: unsafe { (*st).span.start },
            end: unsafe { (*st).span.end },
        };
        if (next_st as usize) == 0 && (unsafe { (*st).kind }) == HIR_STMT_EXPR && !(unsafe { (*st).has_semi }) {
            mir_build_expr(mut_view(*b), unsafe {
                (*st).expr
            }, mut_view(*dest), has_dest);
        } else {
            mir_build_stmt(mut_view(*b), st);
        }
        // Cleanup temporaries
        if !b.is_diverged {
            let mut curr: *mut MirDropNode = b.current_drops;
            let mut prev: *mut MirDropNode = 0 as *mut MirDropNode;
            while ((curr as usize) != (old_drops as usize) && (curr as usize) != 0) {
                let is_tmp = unsafe {
                    (*curr).is_temp
                };
                let nxt = unsafe {
                    (*curr).next
                };
                if is_tmp {
                    let next_bb = mb_new_bb(mut_view(*b), false);
                    let bb = unsafe {
                        mir_bb_at((*b.body).bbs, b.curr_bb.v as usize)
                    };
                    unsafe {
                        mir_term_zero(mut_view((*bb).terminator), MIR_TERM_DROP);
                        (*bb).terminator.span.file.v = st_sp.file.v;
                        (*bb).terminator.span.start = st_sp.start;
                        (*bb).terminator.span.end = st_sp.end;
                        mir_copy_place(mut_view((*bb).terminator.drop_place), view((*curr).place));
                        (*bb).terminator.drop_target.v = next_bb.v;
                        (*bb).terminator.drop_unwind.v = 0u32;
                        (*bb).has_terminator = true;
                    }
                    b.curr_bb.v = next_bb.v;
                    b.is_diverged = false;
                    if (prev as usize) != 0 {
                        unsafe {
                            (*prev).next = nxt;
                        }
                    } else {
                        b.current_drops = nxt;
                    }
                    curr = nxt;
                } else {
                    prev = curr;
                    curr = nxt;
                }
            }
        }
        st = next_st;
    }
    if !b.is_diverged {
        mb_build_drop_chain(mut_view(*b), b.current_drops, old_drops, MirBbId {
            v: 0u32
        }, view(sp));
    }
    b.current_drops = old_drops;
}

pub fn mir_build_closure(
    arena: mut_view<Arena>,
    closure_expr: *mut HirExpr,
    closure_ty: TypeId,
    thir: *mut Thir,
    hir: *const HirFile,
    str_in: *mut StrInterner,
    db: *const SourceDatabase,
    mono: *mut MonoEngine,
    subst_args: view<GenericArgsSlice>
) -> *mut MirBody {
    if (closure_expr as usize) == 0 {
        return 0 as *mut MirBody;
    }
    let body = mir_body_new(mut_view(*arena));
    let mut b = MirBuilder {
        arena: unsafe { address_of_mut(arena.head) as *mut Arena },
        thir: thir,
        hir: hir,
        str_in: str_in,
        db: db,
        mono: mono,
        subst_args: GenericArgsSlice {
            args: subst_args.args,
            count: subst_args.count,
        },
        body: body,
        curr_bb: MirBbId { v: 0u32 },
        sym_map: 0 as *mut MirSymLocalMapEntry,
        sym_map_count: 0,
        sym_map_cap: 0,
        loop_stack: 0 as *mut MirLoopScope,
        loop_depth: 0,
        loop_cap: 0,
        scopes: 0 as *mut MirDeferScope,
        scope_depth: 0,
        scope_cap: 0,
        current_drops: 0 as *mut MirDropNode,
        is_diverged: false,
        unwind_bb: MirBbId { v: 0u32 },
        has_unwind_bb: false,
        closure_env_local: MirLocalId { v: 0u32 },
        closure_captures: 0 as *const ClosureCapture,
        closure_capture_count: 0,
        closure_head: 0 as *mut MirClosureBodyEntry,
        closure_tail: 0 as *mut MirClosureBodyEntry,
    };
    let sp = Span {
        file: FileId { v: unsafe { (*closure_expr).span.file.v } },
        start: unsafe { (*closure_expr).span.start },
        end: unsafe { (*closure_expr).span.end },
    };
    unsafe {
        (*body).span.file.v = sp.file.v;
        (*body).span.start = sp.start;
        (*body).span.end = sp.end;
    }

    let c_ax = unsafe {
        type_get(view((*thir).interner), (TypeId {
            v: closure_ty.v
        }))
    };
    let mut ret_ty = mb_expr_ty(mut_view(b), unsafe {
        (*closure_expr).body
    });
    if (c_ax as usize) != 0 && (unsafe { (*c_ax).kind }) == TY_CLOSURE {
        unsafe {
            (*body).sym.v = (*c_ax).fn_sym;
        }
        let fn_ty = TypeId {
            v: unsafe {
                (*c_ax).fn_type.v
            }
        };
        let fn_ax = unsafe {
            type_get(view((*thir).interner), (TypeId {
                v: fn_ty.v
            }))
        };
        if (fn_ax as usize) != 0 && (unsafe { (*fn_ax).kind }) == TY_FN {
            ret_ty = mb_resolve_ty(mut_view(b), TypeId {
                v: unsafe {
                    (*fn_ax).ret_type.v
                }
            });
        }
        b.closure_captures = unsafe {
            (*c_ax).captures
        };
        b.closure_capture_count = unsafe {
            (*c_ax).capture_count
        };
    }

    mb_new_local(mut_view(b), (TypeId {
        v: ret_ty.v
    }), MIR_LOCAL_RETURN, true, StrId {
        v: 0u32
    }, view(sp));

    let mut arg_cnt: usize = 0;
    if b.closure_capture_count > 0 {
        let ti = unsafe {
            mut_view((*thir).interner)
        };
        let env_ptr_ty = intern_ptr_ty(ti, (TypeId {
            v: closure_ty.v
        }), true);
        let env_loc = mb_new_local(mut_view(b), (TypeId {
            v: env_ptr_ty.v
        }), MIR_LOCAL_ARG, false, StrId {
            v: 0u32
        }, view(sp));
        b.closure_env_local.v = env_loc.v;
        arg_cnt = arg_cnt + 1;
    }

    let mut p: *mut HirParam = unsafe {
        (*closure_expr).params
    };
    while ((p as usize) != 0) {
        let p_ty = mb_param_ty(mut_view(b), p);
        let p_sp = Span {
            file: FileId { v: unsafe { (*p).span.file.v } },
            start: unsafe { (*p).span.start },
            end: unsafe { (*p).span.end },
        };
        let loc = mb_new_local(mut_view(b), (TypeId {
            v: p_ty.v
        }), MIR_LOCAL_ARG, unsafe {
            (*p).is_mut
        }, StrId {
            v: unsafe {
                (*p).name.v
            }
        }, view(p_sp));
        let loc_pl = mir_local_place(loc.v);
        mb_push_drop(mut_view(b), view(loc_pl), (TypeId {
            v: p_ty.v
        }), false, view(p_sp));
        mb_register_sym(mut_view(b), SymbolId {
            v: unsafe {
                (*p).symbol.v
            }
        }, (MirLocalId {
            v: loc.v
        }), false);
        arg_cnt = arg_cnt + 1;
        p = unsafe {
            (*p).next
        };
    }
    unsafe {
        (*body).arg_count = arg_cnt;
    }

    b.curr_bb = mb_new_bb(mut_view(b), false);
    let mut ret_pl = mir_local_place(0u32);
    mir_build_expr(mut_view(b), unsafe {
        (*closure_expr).body
    }, mut_view(ret_pl), true);

    if !b.is_diverged {
        mb_build_drop_chain(mut_view(b), b.current_drops, 0 as *mut MirDropNode, MirBbId {
            v: 0u32
        }, view(sp));
        let bb = unsafe {
            mir_bb_at((*body).bbs, b.curr_bb.v as usize)
        };
        unsafe {
            mir_term_zero(mut_view((*bb).terminator), MIR_TERM_RETURN);
            (*bb).terminator.span.file.v = sp.file.v;
            (*bb).terminator.span.start = sp.start;
            (*bb).terminator.span.end = sp.end;
            (*bb).has_terminator = true;
        }
    }
    body
}

pub fn mir_build_fn_subst(
    arena: mut_view<Arena>,
    func: *mut HirItem,
    thir: *mut Thir,
    hir: *const HirFile,
    str_in: *mut StrInterner,
    db: *const SourceDatabase,
    mono: *mut MonoEngine,
    subst_args: view<GenericArgsSlice>
) -> *mut MirBody {
    if (func as usize) == 0 || (unsafe { (*func).kind }) != HIR_ITEM_FN || (unsafe { (*func).body as usize }) == 0 {
        return 0 as *mut MirBody;
    }
    let body = mir_body_new(mut_view(*arena));
    let mut b = MirBuilder {
        arena: unsafe { address_of_mut(arena.head) as *mut Arena },
        thir: thir,
        hir: hir,
        str_in: str_in,
        db: db,
        mono: mono,
        subst_args: GenericArgsSlice {
            args: subst_args.args,
            count: subst_args.count,
        },
        body: body,
        curr_bb: MirBbId { v: 0u32 },
        sym_map: 0 as *mut MirSymLocalMapEntry,
        sym_map_count: 0,
        sym_map_cap: 0,
        loop_stack: 0 as *mut MirLoopScope,
        loop_depth: 0,
        loop_cap: 0,
        scopes: 0 as *mut MirDeferScope,
        scope_depth: 0,
        scope_cap: 0,
        current_drops: 0 as *mut MirDropNode,
        is_diverged: false,
        unwind_bb: MirBbId { v: 0u32 },
        has_unwind_bb: false,
        closure_env_local: MirLocalId { v: 0u32 },
        closure_captures: 0 as *const ClosureCapture,
        closure_capture_count: 0,
        closure_head: 0 as *mut MirClosureBodyEntry,
        closure_tail: 0 as *mut MirClosureBodyEntry,
    };
    let sp = Span {
        file: FileId { v: unsafe { (*func).span.file.v } },
        start: unsafe { (*func).span.start },
        end: unsafe { (*func).span.end },
    };
    unsafe {
        (*body).span.file.v = sp.file.v;
        (*body).span.start = sp.start;
        (*body).span.end = sp.end;
        (*body).sym.v = (*func).symbol.v;
    }

    let fn_ty = mb_item_ty(mut_view(b), func);
    let fn_ax = unsafe {
        type_get(view((*thir).interner), (TypeId {
            v: fn_ty.v
        }))
    };
    let mut ret_ty = TypeId {
        v: 0u32
    };
    if (fn_ax as usize) != 0 && (unsafe { (*fn_ax).kind }) == TY_FN {
        ret_ty = mb_resolve_ty(mut_view(b), TypeId {
            v: unsafe {
                (*fn_ax).ret_type.v
            }
        });
    }

    mb_new_local(mut_view(b), (TypeId {
        v: ret_ty.v
    }), MIR_LOCAL_RETURN, true, StrId {
        v: 0u32
    }, view(sp));

    let mut param_idx: usize = 0;
    let mut p: *mut HirParam = unsafe {
        (*func).params
    };
    while ((p as usize) != 0) {
        let mut p_ty = mb_param_ty(mut_view(b), p);
        if p_ty.v == 0u32 && (fn_ax as usize) != 0 && (unsafe { (*fn_ax).kind }) == TY_FN && param_idx < (unsafe { (*fn_ax).param_count }) {
            let pt_ptr = unsafe {
                typeid_at((*fn_ax).param_types, param_idx)
            };
            p_ty = mb_resolve_ty(mut_view(b), TypeId {
                v: unsafe {
                    (*pt_ptr).v
                }
            });
        }
        let p_sp = Span {
            file: FileId { v: unsafe { (*p).span.file.v } },
            start: unsafe { (*p).span.start },
            end: unsafe { (*p).span.end },
        };
        let loc = mb_new_local(mut_view(b), (TypeId {
            v: p_ty.v
        }), MIR_LOCAL_ARG, unsafe {
            (*p).is_mut
        }, StrId {
            v: unsafe {
                (*p).name.v
            }
        }, view(p_sp));
        let loc_pl = mir_local_place(loc.v);
        mb_push_drop(mut_view(b), view(loc_pl), (TypeId {
            v: p_ty.v
        }), false, view(p_sp));
        mb_register_sym(mut_view(b), SymbolId {
            v: unsafe {
                (*p).symbol.v
            }
        }, (MirLocalId {
            v: loc.v
        }), false);
        param_idx = param_idx + 1;
        p = unsafe {
            (*p).next
        };
    }
    unsafe {
        (*body).arg_count = param_idx;
    }

    b.curr_bb = mb_new_bb(mut_view(b), false);
    let mut ret_pl = mir_local_place(0u32);
    mir_build_block(mut_view(b), unsafe {
        (*func).body
    }, mut_view(ret_pl), true);

    if !b.is_diverged {
        mb_build_drop_chain(mut_view(b), b.current_drops, 0 as *mut MirDropNode, MirBbId {
            v: 0u32
        }, view(sp));
        let bb = unsafe {
            mir_bb_at((*body).bbs, b.curr_bb.v as usize)
        };
        unsafe {
            mir_term_zero(mut_view((*bb).terminator), MIR_TERM_RETURN);
            (*bb).terminator.span.file.v = sp.file.v;
            (*bb).terminator.span.start = sp.start;
            (*bb).terminator.span.end = sp.end;
            (*bb).has_terminator = true;
        }
    }
    body
}

pub fn mir_build_fn(
    arena: mut_view<Arena>,
    func: *mut HirItem,
    thir: *mut Thir,
    hir: *const HirFile,
    str_in: *mut StrInterner,
    db: *const SourceDatabase,
    mono: *mut MonoEngine
) -> *mut MirBody {
    let empty_subst = GenericArgsSlice {
        args: 0 as *mut TypeId,
        count: 0,
    };
    mir_build_fn_subst(arena, func, thir, hir, str_in, db, mono, view(empty_subst))
}

pub fn mir_build_expr_body(
    arena: mut_view<Arena>,
    expr: *mut HirExpr,
    ty: TypeId,
    thir: *mut Thir,
    hir: *const HirFile,
    str_in: *mut StrInterner,
    db: *const SourceDatabase
) -> *mut MirBody {
    if (expr as usize) == 0 {
        return 0 as *mut MirBody;
    }
    let body = mir_body_new(mut_view(*arena));
    let mut b = MirBuilder {
        arena: unsafe { address_of_mut(arena.head) as *mut Arena },
        thir: thir,
        hir: hir,
        str_in: str_in,
        db: db,
        mono: 0 as *mut MonoEngine,
        subst_args: GenericArgsSlice {
            args: 0 as *mut TypeId,
            count: 0,
        },
        body: body,
        curr_bb: MirBbId { v: 0u32 },
        sym_map: 0 as *mut MirSymLocalMapEntry,
        sym_map_count: 0,
        sym_map_cap: 0,
        loop_stack: 0 as *mut MirLoopScope,
        loop_depth: 0,
        loop_cap: 0,
        scopes: 0 as *mut MirDeferScope,
        scope_depth: 0,
        scope_cap: 0,
        current_drops: 0 as *mut MirDropNode,
        is_diverged: false,
        unwind_bb: MirBbId { v: 0u32 },
        has_unwind_bb: false,
        closure_env_local: MirLocalId { v: 0u32 },
        closure_captures: 0 as *const ClosureCapture,
        closure_capture_count: 0,
        closure_head: 0 as *mut MirClosureBodyEntry,
        closure_tail: 0 as *mut MirClosureBodyEntry,
    };
    let sp = Span {
        file: FileId { v: unsafe { (*expr).span.file.v } },
        start: unsafe { (*expr).span.start },
        end: unsafe { (*expr).span.end },
    };
    mb_new_local(mut_view(b), (TypeId {
        v: ty.v
    }), MIR_LOCAL_RETURN, true, StrId {
        v: 0u32
    }, view(sp));
    b.curr_bb = mb_new_bb(mut_view(b), false);
    let mut ret_pl = mir_local_place(0u32);
    mir_build_expr(mut_view(b), expr, mut_view(ret_pl), true);
    if !b.is_diverged {
        mb_build_drop_chain(mut_view(b), b.current_drops, 0 as *mut MirDropNode, MirBbId {
            v: 0u32
        }, view(sp));
        let bb = unsafe {
            mir_bb_at((*body).bbs, b.curr_bb.v as usize)
        };
        unsafe {
            mir_term_zero(mut_view((*bb).terminator), MIR_TERM_RETURN);
            (*bb).terminator.span.file.v = sp.file.v;
            (*bb).terminator.span.start = sp.start;
            (*bb).terminator.span.end = sp.end;
            (*bb).has_terminator = true;
        }
    }
    body
}

