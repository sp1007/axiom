        }), view(sp));
        b.curr_bb.v = bb_succ.v;
        b.is_diverged = false;
    } else if pk == HIR_PAT_RANGE {
        let start_pat: *mut HirPat = unsafe {
            (*pat).start_pat
        };
        let end_pat: *mut HirPat = unsafe {
            (*pat).end_pat
        };
        let start_ty = mb_pat_ty(mut_view(*b), start_pat);
        let end_ty = mb_pat_ty(mut_view(*b), end_pat);
        let start_val = mb_parse_pat_int(view(*b), start_pat);
        let end_val = mb_parse_pat_int(view(*b), end_pat);
        let bool_ty = TypeId {
            v: unsafe {
                (*b.thir).interner.t_bool.v
            }
        };

        let ge_loc = mb_new_temp(mut_view(*b), (TypeId {
            v: bool_ty.v
        }), view(sp));
        let ge_pl = mir_local_place(ge_loc.v);
        let mut scr_op1 = MirOperand {
            kind: MIR_OP_COPY, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: 0u32
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: 0u32
                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
                    v: 0u32
                }
            }
        };
        scr_op1.kind = MIR_OP_COPY;
        mir_copy_place(mut_view(scr_op1.place), scrutinee);
        let start_op = MirOperand {
            kind: MIR_OP_CONST, location: Span {
                file: FileId {
                    v: 0u32
