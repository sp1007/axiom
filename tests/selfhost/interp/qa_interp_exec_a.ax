        b.is_diverged = false;
    } else if pk == HIR_PAT_OR {
        let bb_succ = mb_new_bb(mut_view(*b), false);
        let mut alt: *mut HirPat = unsafe {
            (*pat).pats
        };
        while ((alt as usize) != 0) {
            let next_alt: *mut HirPat = unsafe {
                (*alt).next
            };
            let next_or = if (next_alt as usize) != 0 {
                mb_new_bb(mut_view(*b), false)
            } else {
                (MirBbId {
                    v: on_fail.v
                })
            };
            mb_build_pat_match_in_place(mut_view(*b), alt, scrutinee, (TypeId {
                v: s_ty.v
            }), (MirBbId {
                v: next_or.v
            }));
            mb_terminate_goto(mut_view(*b), (MirBbId {
                v: bb_succ.v
            }), view(sp));
            b.curr_bb.v = next_or.v;
            b.is_diverged = false;
            alt = next_alt;
        }
        b.curr_bb.v = bb_succ.v;
        b.is_diverged = false;
    } else if pk == HIR_PAT_PATH || pk == HIR_PAT_STRUCT || pk == HIR_PAT_TUPLE {
        let p_ty = mb_pat_ty(mut_view(*b), pat);
        let t_ty = if p_ty.v != 0u32 {
            p_ty
        } else {
            s_ty
        };
        let t = unsafe {
            type_get(view((*b.thir).interner), (TypeId {
                v: t_ty.v
            }))
