    100u8, 105u8, 114u8, 101u8, 99u8, 116u8, 32u8, 101u8, 120u8, 116u8, 101u8, 114u8,
    110u8, 32u8, 99u8, 97u8, 108u8, 108u8, 32u8, 99u8, 97u8, 110u8, 110u8, 111u8,
    116u8, 32u8, 114u8, 117u8, 110u8, 32u8, 105u8, 110u8, 32u8, 105u8, 110u8, 116u8,
    101u8, 114u8, 112u8, 114u8, 101u8, 116u8, 101u8, 114u8, 32u8, 111u8, 114u8, 97u8,
    99u8, 108u8, 101u8,
];

const INTERP_WORD_DIV_ZERO: [16]u8 = [
    100u8, 105u8, 118u8, 105u8, 115u8, 105u8, 111u8, 110u8, 32u8, 98u8, 121u8, 32u8,
    122u8, 101u8, 114u8, 111u8,
];

pub struct InterpValue {
    pub vals: [8]u64,
}

pub struct InterpAlloc {
    pub alloc_id: u32,
    pub base_addr: u64,
    pub size: u64,
    pub align: u32,
    pub host_ptr: *mut u8,
    pub is_live: bool,
    pub call_depth: i32,
}

pub struct InterpHostArg {
    pub ptr: *mut u8,
    pub len: usize,
}

pub struct InterpHostState {
    pub args: *mut InterpHostArg,
    pub argc: usize,
    pub args_cap: usize,
    pub use_custom_args: bool,
    pub open_fds: *mut i64,
    pub open_fds_len: usize,
    pub open_fds_cap: usize,
    pub open_dirs: *mut i64,
    pub open_dirs_len: usize,
    pub open_dirs_cap: usize,
    pub last_monotonic_ns: u64,
}

pub struct MirBodyEntry {
    pub item_ptr: usize,
    pub sym_v: u32,
    pub body: *mut MirBody,
}

pub struct MirBodyMap {
    pub entries: *mut MirBodyEntry,
    pub len: usize,
    pub cap: usize,
}

pub struct InterpCtx {
    pub main_fn: *mut HirItem,
    pub thir: *mut Thir,
    pub hir: *const HirFile,
    pub interner: *mut StrInterner,
    pub rmap: *const ResolveMap,
    pub ast: *const Ast,
    pub db: *const SourceDatabase,
    pub sink: *mut DiagSink,
    pub mono_engine: *mut MonoEngine,
    pub step_limit: i32,
    pub call_depth_limit: i32,
    pub mir_map: *mut MirBodyMap,
    pub build_on_demand: bool,
    pub steps: i32,
    pub call_depth: i32,
    pub arena: Arena,
    pub failed: bool,
    pub has_panicked: bool,
    pub has_exited: bool,
    pub exit_code: i32,
    pub panic_msg_ptr: *const u8,
    pub panic_msg_len: usize,
    pub out_buf: *mut DiagBuffer,
    pub capture_stdout: bool,
    pub dummy_ptr: *mut u8,
    pub allocs: *mut InterpAlloc,
    pub alloc_count: usize,
    pub alloc_cap: usize,
    pub next_synth_addr: u64,
    pub is_comptime: bool,
    pub comptime_err_code: u16,
    pub comptime_err_span: Span,
    pub comptime_err_msg: StrView,
    pub current_span: Span,
    pub host: InterpHostState,
}

// =================================================================================================
// Pointer & Memory Helpers
// =================================================================================================

pub fn interp_mul_usize(a: usize, b: usize) -> usize {
    ((a as isize) * (b as isize)) as usize
}

pub unsafe fn interp_alloc_at(base: *mut InterpAlloc, idx: usize) -> *mut InterpAlloc {
    let off = interp_mul_usize(idx, size_of<InterpAlloc>());
    ((base as usize) + off) as *mut InterpAlloc
}

pub unsafe fn interp_val_at(base: *mut InterpValue, idx: usize) -> *mut InterpValue {
    let off = interp_mul_usize(idx, size_of<InterpValue>());
    ((base as usize) + off) as *mut InterpValue
}

pub unsafe fn interp_host_arg_at(base: *mut InterpHostArg, idx: usize) -> *mut InterpHostArg {
    let off = interp_mul_usize(idx, size_of<InterpHostArg>());
    ((base as usize) + off) as *mut InterpHostArg
}

pub unsafe fn interp_i64_at(base: *mut i64, idx: usize) -> *mut i64 {
    let off = interp_mul_usize(idx, size_of<i64>());
    ((base as usize) + off) as *mut i64
}

pub unsafe fn interp_u8_ptr_at(base: *mut *mut u8, idx: usize) -> *mut *mut u8 {
    let off = interp_mul_usize(idx, size_of<*mut u8>());
    ((base as usize) + off) as *mut *mut u8
}

pub unsafe fn mir_body_entry_at(base: *mut MirBodyEntry, idx: usize) -> *mut MirBodyEntry {
    let off = interp_mul_usize(idx, size_of<MirBodyEntry>());
    ((base as usize) + off) as *mut MirBodyEntry
}

pub fn interp_val_zero() -> InterpValue {
    InterpValue {
        vals: [0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64],
    }
}

pub fn interp_val_u64(v: u64) -> InterpValue {
    InterpValue {
        vals: [v, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64],
    }
}

pub fn interp_zero_val(dst: mut_view<InterpValue>) {
    let mut i: usize = 0;
    while i < 8 {
        dst.vals[i] = 0u64;
        i = i + 1;
    }
}

pub fn interp_copy_val(dst: mut_view<InterpValue>, src: view<InterpValue>) {
    let mut i: usize = 0;
    while i < 8 {
        dst.vals[i] = src.vals[i];
        i = i + 1;
    }
}

pub unsafe fn interp_zero_bytes(dst: *mut u8, count: usize) {
    if (dst as usize) == 0 || count == 0 {
        return;
    }
    ptr_write_bytes<u8>(dst, 0u8, count);
}

pub unsafe fn interp_fill_bytes(dst: *mut u8, byte_val: u8, count: usize) {
    if (dst as usize) == 0 || count == 0 {
        return;
    }
    ptr_write_bytes<u8>(dst, byte_val, count);
}

pub unsafe fn interp_copy_bytes(dst: *mut u8, src: *const u8, count: usize) {
    if count == 0 || (dst as usize) == 0 || (src as usize) == 0 {
        return;
    }
    let dst_addr = dst as usize;
    let src_addr = src as usize;
    if dst_addr == src_addr {
        return;
    }
    if dst_addr + count <= src_addr || src_addr + count <= dst_addr {
        ptr_copy_nonoverlapping<u8>(src, dst, count);
    } else if dst_addr > src_addr && dst_addr < src_addr + count {
        let mut i: usize = count;
        while i > 0 {
            i = i - 1;
            *(dst + i) = *(src + i);
        }
    } else {
        let mut i: usize = 0;
        while i < count {
            *(dst + i) = *(src + i);
            i = i + 1;
        }
    }
}

pub unsafe fn interp_move_bytes(dst: *mut u8, src: *const u8, count: usize) {
    interp_copy_bytes(dst, src, count);
}

pub unsafe fn interp_cstr_len(s: *const u8) -> usize {
    if (s as usize) == 0 {
        return 0;
    }
    let mut n: usize = 0;
    while *(s + n) != 0u8 {
        n = n + 1;
    }
    n
}

pub unsafe fn interp_bytes_eq(a: *const u8, a_len: usize, b: *const u8, b_len: usize) -> bool {
    if a_len != b_len {
        return false;
    }
    let mut i: usize = 0;
    while i < a_len {
        if *(a + i) != *(b + i) {
            return false;
        }
        i = i + 1;
    }
    true
}

pub fn interp_sv_eq(a: view<StrView>, b: view<StrView>) -> bool {
    unsafe { interp_bytes_eq(a.ptr, a.len, b.ptr, b.len) }
}

pub fn interp_sv_contains(hay: view<StrView>, needle: view<StrView>) -> bool {
    if needle.len == 0 {
        return true;
    }
    if (hay.ptr as usize) == 0 || (needle.ptr as usize) == 0 || (hay.len) < (needle.len) {
        return false;
    }
    let mut start: usize = 0;
    while start + needle.len <= hay.len {
        let ok = unsafe { interp_bytes_eq(hay.ptr + start, needle.len, needle.ptr, needle.len) };
        if ok {
            return true;
        }
        start = start + 1;
    }
    false
}

// =================================================================================================
// Message Lookup & Formatting
// =================================================================================================

fn interp_msg_range(msg_kind: u8, out_off: mut_view<usize>, out_len: mut_view<usize>) {
    *out_off = 0;
    *out_len = 0;
    if msg_kind == INTERP_MSG_UB_NULL_DEREF {
        *out_off = 0;
        *out_len = 24;
    } else if msg_kind == INTERP_MSG_UB_MISALIGNED {
        *out_off = 24;
        *out_len = 25;
    } else if msg_kind == INTERP_MSG_UB_UNMAPPED {
        *out_off = 49;
        *out_len = 33;
    } else if msg_kind == INTERP_MSG_UB_DANGLING {
        *out_off = 82;
        *out_len = 40;
    } else if msg_kind == INTERP_MSG_UB_OOB {
        *out_off = 122;
        *out_len = 28;
    } else if msg_kind == INTERP_MSG_UB_PTR_ARITH_UNMAPPED {
        *out_off = 150;
        *out_len = 53;
    } else if msg_kind == INTERP_MSG_UB_PTR_ARITH_OOB {
        *out_off = 203;
        *out_len = 43;
    } else if msg_kind == INTERP_MSG_UB_FREE_NON_HEAP {
        *out_off = 246;
        *out_len = 39;
    } else if msg_kind == INTERP_MSG_UB_USIZE_AS_PTR {
        *out_off = 285;
        *out_len = 46;
    } else if msg_kind == INTERP_MSG_UB_OVERLAPPING_COPY {
        *out_off = 331;
        *out_len = 47;
    } else if msg_kind == INTERP_MSG_PANIC_SUBSLICE_NON_ARR {
        *out_off = 378;
        *out_len = 32;
    } else if msg_kind == INTERP_MSG_PANIC_SUBSLICE_OOB {
        *out_off = 410;
        *out_len = 23;
    } else if msg_kind == INTERP_MSG_PANIC_INDEX_NON_ARR {
        *out_off = 433;
        *out_len = 29;
    } else if msg_kind == INTERP_MSG_PANIC_INDEX_OOB {
        *out_off = 462;
        *out_len = 19;
    } else if msg_kind == INTERP_MSG_PANIC_ASSERT_FAILED {
        *out_off = 481;
        *out_len = 16;
    } else if msg_kind == INTERP_MSG_PANIC_UNREACHABLE {
        *out_off = 497;
        *out_len = 24;
    } else if msg_kind == INTERP_MSG_PANIC_PANIC {
        *out_off = 521;
        *out_len = 5;
    } else if msg_kind == INTERP_MSG_PANIC_COMPTIME_CALL {
        *out_off = 526;
        *out_len = 52;
    } else if msg_kind == INTERP_MSG_PANIC_DIV_ZERO {
        *out_off = 578;
        *out_len = 16;
    } else if msg_kind == INTERP_MSG_PANIC_SHIFT_RANGE {
        *out_off = 594;
        *out_len = 25;
    } else if msg_kind == INTERP_MSG_PANIC_ARITH_OV {
        *out_off = 619;
        *out_len = 19;
    } else if msg_kind == INTERP_MSG_PANIC_UNRESOLVED_CALL {
        *out_off = 638;
        *out_len = 24;
    } else if msg_kind == INTERP_MSG_PANIC_UNSUPPORTED_TERM {
        *out_off = 662;
        *out_len = 22;
    } else if msg_kind == INTERP_MSG_LIMIT_COMPTIME_STEP {
        *out_off = 684;
        *out_len = 52;
    } else if msg_kind == INTERP_MSG_LIMIT_STEP {
        *out_off = 736;
        *out_len = 19;
    }
}

pub fn interp_alloc_msg(arena: mut_view<Arena>, msg_kind: u8) -> StrView {
    if msg_kind == INTERP_MSG_LIMIT_STACK {
        let n: usize = 25;
        let dst = arena_alloc_raw(mut_view(*arena), n + 1, 1);
        let mut i: usize = 0;
        while i < n {
            unsafe {
                *(dst + i) = INTERP_MSG_STACK_BYTES[i];
            }
            i = i + 1;
        }
        unsafe {
            *(dst + n) = 0u8;
        }
        return StrView { ptr: dst as *const u8, len: n };
    }
    if msg_kind == INTERP_MSG_FFI_NOT_IN_ORACLE {
        let n: usize = 51;
        let dst = arena_alloc_raw(mut_view(*arena), n + 1, 1);
        let mut i: usize = 0;
        while i < n {
            unsafe {
                *(dst + i) = INTERP_MSG_FFI_BYTES[i];
            }
            i = i + 1;
        }
        unsafe {
            *(dst + n) = 0u8;
        }
        return StrView { ptr: dst as *const u8, len: n };
    }
    let mut off: usize = 0;
    let mut msg_len: usize = 0;
    interp_msg_range(msg_kind, mut_view(off), mut_view(msg_len));
    let dst = arena_alloc_raw(mut_view(*arena), msg_len + 1, 1);
    let mut i: usize = 0;
    while i < msg_len {
        unsafe {
            *(dst + i) = INTERP_MSG_BYTES[off + i];
        }
        i = i + 1;
    }
    unsafe {
        *(dst + msg_len) = 0u8;
    }
    StrView { ptr: dst as *const u8, len: msg_len }
}

pub fn interp_msg_sv(arena: mut_view<Arena>, msg_kind: u8) -> StrView {
    interp_alloc_msg(mut_view(*arena), msg_kind)
}

fn interp_msg_has_div_zero(msg_ptr: *const u8, msg_len: usize) -> bool {
    if (msg_ptr as usize) == 0 || msg_len < 16 {
        return false;
    }
    let mut start: usize = 0;
    while start + 16 <= msg_len {
        let mut matched = true;
        let mut j: usize = 0;
        while j < 16 {
            let b = unsafe { *(msg_ptr + start + j) };
            if b != INTERP_WORD_DIV_ZERO[j] {
                matched = false;
                break;
            }
            j = j + 1;
        }
        if matched {
            return true;
        }
        start = start + 1;
    }
    false
}

// =================================================================================================
// UB, Panic & Limit Reporting
// =================================================================================================

pub fn interp_push_diag(ctx: mut_view<InterpCtx>, code_v: u32, span: Span, msg: StrView) {
    if (ctx.sink as usize) != 0 {
        let d_ptr = arena_alloc_raw(mut_view(ctx.arena), size_of<Diagnostic>(), align_of<Diagnostic>()) as *mut Diagnostic;
        unsafe {
            interp_zero_bytes(d_ptr as *mut u8, size_of<Diagnostic>());
            let c = diag_code(code_v);
            let sev = diag_code_severity(c);
            (*d_ptr).code = c;
            (*d_ptr).severity = sev;
            (*d_ptr).message = msg;
            (*d_ptr).primary = span;
            diag_sink_report(mut_view(*ctx.sink), view(*d_ptr));
        }
    }
}

pub fn interp_report_ub_sv(ctx: mut_view<InterpCtx>, msg: StrView) {
    interp_push_diag(mut_view(*ctx), AX_UNSAFE_INTERP_UB, ctx.current_span, msg);
    ctx.failed = true;
    ctx.exit_code = 125;
}

pub fn interp_report_ub(ctx: mut_view<InterpCtx>, msg_kind: u8) {
    let msg = interp_alloc_msg(mut_view(ctx.arena), msg_kind);
    interp_report_ub_sv(mut_view(*ctx), msg);
}

pub fn interp_panic_sv(ctx: mut_view<InterpCtx>, msg: StrView) {
    let dup = arena_alloc_raw(mut_view(ctx.arena), msg.len + 1, 1);
    if msg.len > 0 && (msg.ptr as usize) != 0 {
        unsafe {
            interp_copy_bytes(dup, msg.ptr, msg.len);
        }
    }
    unsafe {
        *(dup + msg.len) = 0u8;
    }
    ctx.panic_msg_ptr = dup as *const u8;
    ctx.panic_msg_len = msg.len;
    ctx.has_panicked = true;
    if ctx.is_comptime {
        if interp_msg_has_div_zero(ctx.panic_msg_ptr, ctx.panic_msg_len) {
            ctx.comptime_err_code = AX_CONST_DIV_ZERO as u16;
        } else {
            ctx.comptime_err_code = AX_CONST_OVERFLOW as u16;
        }
        ctx.comptime_err_msg.ptr = ctx.panic_msg_ptr;
        ctx.comptime_err_msg.len = ctx.panic_msg_len;
        ctx.comptime_err_span = ctx.current_span;
    }
    ctx.failed = true;
    ctx.exit_code = 101;
}

pub fn interp_panic(ctx: mut_view<InterpCtx>, msg_kind: u8) {
    let msg = interp_alloc_msg(mut_view(ctx.arena), msg_kind);
    interp_panic_sv(mut_view(*ctx), msg);
}

pub fn interp_check_step_limit(ctx: mut_view<InterpCtx>) {
    if ctx.step_limit > 0 && ctx.steps >= ctx.step_limit {
        if ctx.is_comptime {
            let msg = interp_alloc_msg(mut_view(ctx.arena), INTERP_MSG_LIMIT_COMPTIME_STEP);
            ctx.comptime_err_code = AX_CONST_EVAL_LIMIT as u16;
            ctx.comptime_err_msg = msg;
            ctx.comptime_err_span = ctx.current_span;
        } else {
            let msg = interp_alloc_msg(mut_view(ctx.arena), INTERP_MSG_LIMIT_STEP);
            interp_push_diag(mut_view(*ctx), AX_DRIVER_INTERP_STEP_LIMIT, ctx.current_span, msg);
        }
        ctx.failed = true;
        ctx.exit_code = 124;
    }
}

pub fn interp_report_stack_limit(ctx: mut_view<InterpCtx>) {
    let msg = interp_alloc_msg(mut_view(ctx.arena), INTERP_MSG_LIMIT_STACK);
    interp_push_diag(mut_view(*ctx), AX_DRIVER_INTERP_STACK_LIMIT, ctx.current_span, msg);
    ctx.failed = true;
    ctx.exit_code = 124;
}

pub fn interp_report_ffi_not_in_oracle(ctx: mut_view<InterpCtx>, span: Span) {
    let msg = interp_alloc_msg(mut_view(ctx.arena), INTERP_MSG_FFI_NOT_IN_ORACLE);
    interp_push_diag(mut_view(*ctx), AX_FFI_NOT_IN_ORACLE, span, msg);
    ctx.failed = true;
    ctx.exit_code = 1;
}

// =================================================================================================
// Allocation Table & Pointer Validation
// =================================================================================================

pub fn interp_register_alloc(
    ctx: mut_view<InterpCtx>,
    host_ptr: *mut u8,
    size: u64,
    align: u32,
    call_depth: i32
) -> *mut InterpAlloc {
    if ctx.alloc_count >= ctx.alloc_cap {
        let new_cap: usize = if ctx.alloc_cap == 0 { 64 } else { interp_mul_usize(ctx.alloc_cap, 2) };
        let new_bytes = interp_mul_usize(new_cap, size_of<InterpAlloc>());
        let new_arr = unsafe { heap_alloc(new_bytes, align_of<InterpAlloc>()) as *mut InterpAlloc };
        unsafe {
            interp_zero_bytes(new_arr as *mut u8, new_bytes);
        }
        if ctx.alloc_count > 0 && (ctx.allocs as usize) != 0 {
            let old_bytes = interp_mul_usize(ctx.alloc_count, size_of<InterpAlloc>());
            let old_cap_bytes = interp_mul_usize(ctx.alloc_cap, size_of<InterpAlloc>());
            unsafe {
                ptr_copy_nonoverlapping<u8>(ctx.allocs as *const u8, new_arr as *mut u8, old_bytes);
                heap_free(ctx.allocs as *mut u8, old_cap_bytes, align_of<InterpAlloc>());
            }
        }
        ctx.allocs = new_arr;
        ctx.alloc_cap = new_cap;
    }

    let idx = ctx.alloc_count;
    ctx.alloc_count = idx + 1;
    let a = unsafe { interp_alloc_at(ctx.allocs, idx) };
    let eff_align: u64 = if align > 16u32 { align as u64 } else { 16u64 };
    let mask: u64 = eff_align - 1u64;
    let base: u64 = (ctx.next_synth_addr + mask) & (0xFFFFFFFFFFFFFFFFu64 ^ mask);
    let padded_size: u64 = (size + 15u64) & (0xFFFFFFFFFFFFFFFFu64 ^ 15u64);

    unsafe {
        (*a).alloc_id = (idx + 1) as u32;
        (*a).base_addr = base;
        (*a).size = size;
        (*a).align = if align != 0u32 { align } else { 1u32 };
        (*a).host_ptr = host_ptr;
        (*a).is_live = true;
        (*a).call_depth = call_depth;
    }
    ctx.next_synth_addr = base + padded_size + 16u64;
    a
}

pub fn interp_validate_raw_ptr(
    ctx: mut_view<InterpCtx>,
    addr: u64,
    size: u64,
    align: u32
) -> *mut u8 {
    if addr == 0u64 {
        interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_NULL_DEREF);
        return ctx.dummy_ptr;
    }
    if align > 1u32 && (addr % (align as u64)) != 0u64 {
        interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_MISALIGNED);
        return ctx.dummy_ptr;
    }

    let mut found: *mut InterpAlloc = 0 as *mut InterpAlloc;
    let mut i: usize = ctx.alloc_count;
    while i > 0 {
        i = i - 1;
        let a = unsafe { interp_alloc_at(ctx.allocs, i) };
        let base = unsafe { (*a).base_addr };
        let asz = unsafe { (*a).size };
        if addr >= base && addr < base + asz + 16u64 {
            found = a;
            break;
        }
    }
    if (found as usize) == 0 {
        i = ctx.alloc_count;
        while i > 0 {
            i = i - 1;
            let a = unsafe { interp_alloc_at(ctx.allocs, i) };
            let base = unsafe { (*a).base_addr };
            let asz = unsafe { (*a).size };
            if addr >= base && addr <= base + asz {
                found = a;
                break;
            }
        }
    }
    if (found as usize) == 0 {
        interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_UNMAPPED);
        return ctx.dummy_ptr;
    }
    let is_live = unsafe { (*found).is_live };
    if !is_live {
        interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_DANGLING);
        return ctx.dummy_ptr;
    }
    let base = unsafe { (*found).base_addr };
    let asz = unsafe { (*found).size };
    if addr + size > base + asz {
        interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_OOB);
        return ctx.dummy_ptr;
    }
    let off = (addr - base) as usize;
    unsafe { (*found).host_ptr + off }
}

pub fn interp_resolve_synth_ptr(ctx: mut_view<InterpCtx>, addr: u64) -> *mut u8 {
    if addr == 0u64 {
        return ctx.dummy_ptr;
    }
    let mut i: usize = ctx.alloc_count;
    while i > 0 {
        i = i - 1;
        let a = unsafe { interp_alloc_at(ctx.allocs, i) };
        let is_live = unsafe { (*a).is_live };
        let base = unsafe { (*a).base_addr };
        let asz = unsafe { (*a).size };
        if is_live && addr >= base && addr <= base + asz {
            let off = (addr - base) as usize;
            return unsafe { (*a).host_ptr + off };
        }
    }
    (addr as usize) as *mut u8
}

pub fn interp_validate_ptr_arith(ctx: mut_view<InterpCtx>, orig_addr: u64, new_addr: u64) {
    if orig_addr == 0u64 && new_addr == 0u64 {
        return;
    }
    let mut found: *mut InterpAlloc = 0 as *mut InterpAlloc;
    let mut i: usize = ctx.alloc_count;
    while i > 0 {
        i = i - 1;
        let a = unsafe { interp_alloc_at(ctx.allocs, i) };
        let is_live = unsafe { (*a).is_live };
        let base = unsafe { (*a).base_addr };
        let asz = unsafe { (*a).size };
        if is_live && orig_addr >= base && orig_addr <= base + asz {
            found = a;
            break;
        }
    }
    if (found as usize) == 0 {
        interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_PTR_ARITH_UNMAPPED);
        return;
    }
    let base = unsafe { (*found).base_addr };
    let asz = unsafe { (*found).size };
    if new_addr < base || new_addr > base + asz {
        interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_PTR_ARITH_OOB);
    }
}

pub fn interp_find_synth_addr(ctx: view<InterpCtx>, host_ptr: *const u8) -> u64 {
    let h_addr = host_ptr as usize;
    if h_addr == 0 {
        return 0u64;
    }
    let mut i: usize = ctx.alloc_count;
    while i > 0 {
        i = i - 1;
        let a = unsafe { interp_alloc_at(ctx.allocs, i) };
        let is_live = unsafe { (*a).is_live };
        let a_host = unsafe { (*a).host_ptr as usize };
        let a_size = unsafe { (*a).size as usize };
        if is_live && a_host != 0 && h_addr >= a_host && h_addr < a_host + a_size {
            let off = (h_addr - a_host) as u64;
            let base = unsafe { (*a).base_addr };
            return base + off;
        }
    }
    i = ctx.alloc_count;
    while i > 0 {
        i = i - 1;
        let a = unsafe { interp_alloc_at(ctx.allocs, i) };
        let is_live = unsafe { (*a).is_live };
        let a_host = unsafe { (*a).host_ptr as usize };
        let a_size = unsafe { (*a).size as usize };
        if is_live && a_host != 0 && h_addr == a_host + a_size {
            let base = unsafe { (*a).base_addr };
            let asz = unsafe { (*a).size };
            return base + asz;
        }
    }
    0u64
}

pub fn interp_ensure_const_str_alloc(
    ctx: mut_view<InterpCtx>,
    str_bytes: *const u8,
    str_len: usize
) -> u64 {
    let mut ptr: *mut u8 = str_bytes as *mut u8;
    if (ptr as usize) == 0 {
        ptr = arena_alloc_raw(mut_view(ctx.arena), 1, 1);
        unsafe {
            *ptr = 0u8;
        }
    }
    let target_host = ptr as usize;
    let min_sz: u64 = if str_len > 0 { str_len as u64 } else { 1u64 };
    let mut i: usize = 0;
    while i < ctx.alloc_count {
        let a = unsafe { interp_alloc_at(ctx.allocs, i) };
        let is_live = unsafe { (*a).is_live };
        let a_host = unsafe { (*a).host_ptr as usize };
        let a_sz = unsafe { (*a).size };
        if is_live && a_host == target_host && a_sz >= min_sz {
            return unsafe { (*a).base_addr };
        }
        i = i + 1;
    }
    let alloc_sz: u64 = (str_len + 1) as u64;
    let na = interp_register_alloc(mut_view(*ctx), ptr, alloc_sz, 1u32, 0);
    unsafe { (*na).base_addr }
}

pub fn interp_register_const_allocs(ctx: mut_view<InterpCtx>) {
    if (ctx.thir as usize) == 0 {
        return;
    }
    let cap = unsafe { (*ctx.thir).symbol_consts.cap };
    let states = unsafe { (*ctx.thir).symbol_consts.states };
    let vals = unsafe { (*ctx.thir).symbol_consts.vals };
    let mut i: usize = 0;
    while i < cap {
        let st = unsafe { *(states + i) };
        if st == 1u8 {
            let off = interp_mul_usize(i, size_of<ConstValue>());
            let cv = ((vals as usize) + off) as *mut ConstValue;
            let kind = unsafe { (*cv).kind };
            let agg_data = unsafe { (*cv).agg_data };
            if kind == CONST_AGGREGATE && (agg_data as usize) != 0 {
                let agg_sz = unsafe { (*cv).agg_size as u64 };
                let agg_al = unsafe { (*cv).agg_align as u32 };
                let _ = interp_register_alloc(mut_view(*ctx), agg_data, agg_sz, agg_al, 0);
            }
        }
        i = i + 1;
    }
}

// =================================================================================================
// Context Initialization & Teardown
// =================================================================================================

pub fn interp_ctx_init(
    ctx: mut_view<InterpCtx>,
    main_fn: *mut HirItem,
    thir: *mut Thir,
    hir: *const HirFile,
    interner: *mut StrInterner,
    rmap: *const ResolveMap,
    ast: *const Ast,
    db: *const SourceDatabase,
    sink: *mut DiagSink,
    mono_engine: *mut MonoEngine,
    step_limit: i32,
    call_depth_limit: i32,
    mir_map: *mut MirBodyMap,
    out_buf: *mut DiagBuffer,
    capture_stdout: bool
) {
    ctx.main_fn = main_fn;
    ctx.thir = thir;
    ctx.hir = hir;
    ctx.interner = interner;
    ctx.rmap = rmap;
    ctx.ast = ast;
    ctx.db = db;
    ctx.sink = sink;
    ctx.mono_engine = mono_engine;
    ctx.step_limit = step_limit;
    ctx.call_depth_limit = call_depth_limit;
    ctx.mir_map = mir_map;
    ctx.build_on_demand = true;
    ctx.steps = 0;
    ctx.call_depth = 0;
    let a = arena_with_chunk_size(65536);
    ctx.arena = a;
    ctx.failed = false;
    ctx.has_panicked = false;
    ctx.has_exited = false;
    ctx.exit_code = 0;
    ctx.panic_msg_ptr = 0 as *const u8;
    ctx.panic_msg_len = 0;
    ctx.out_buf = out_buf;
    ctx.capture_stdout = capture_stdout;
    let dummy = arena_alloc_raw(mut_view(ctx.arena), 64, 16);
    unsafe {
        interp_zero_bytes(dummy, 64);
    }
    ctx.dummy_ptr = dummy;
    ctx.allocs = 0 as *mut InterpAlloc;
    ctx.alloc_count = 0;
    ctx.alloc_cap = 0;
    ctx.next_synth_addr = INTERP_SYNTH_BASE_RUNTIME;
    ctx.is_comptime = false;
    ctx.comptime_err_code = 0u16;
    ctx.comptime_err_span = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
    ctx.comptime_err_msg = StrView { ptr: 0 as *const u8, len: 0 };
    ctx.current_span = Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 };
    ctx.host.args = 0 as *mut InterpHostArg;
    ctx.host.argc = 0;
    ctx.host.args_cap = 0;
    ctx.host.use_custom_args = false;
    ctx.host.open_fds = 0 as *mut i64;
    ctx.host.open_fds_len = 0;
    ctx.host.open_fds_cap = 0;
    ctx.host.open_dirs = 0 as *mut i64;
    ctx.host.open_dirs_len = 0;
    ctx.host.open_dirs_cap = 0;
    ctx.host.last_monotonic_ns = 0u64;
}

pub fn interp_ctx_alloc_zeroed() -> *mut InterpCtx {
    let sz = size_of<InterpCtx>();
    let al = align_of<InterpCtx>();
    let p = unsafe { heap_alloc(sz, al) as *mut InterpCtx };
    unsafe {
        interp_zero_bytes(p as *mut u8, sz);
    }
    p
}

pub fn interp_ctx_dealloc(ctx_ptr: *mut InterpCtx) {
    if (ctx_ptr as usize) != 0 {
        unsafe {
            heap_free(ctx_ptr as *mut u8, size_of<InterpCtx>(), align_of<InterpCtx>());
        }
    }
}

pub fn interp_ctx_free_allocs(ctx: mut_view<InterpCtx>) {
    if (ctx.allocs as usize) != 0 {
        let mut i: usize = 0;
        while i < ctx.alloc_count {
            let a = unsafe { interp_alloc_at(ctx.allocs, i) };
            let depth = unsafe { (*a).call_depth };
            let hptr = unsafe { (*a).host_ptr };
            let sz = unsafe { (*a).size as usize };
            if depth == -1 && (hptr as usize) != 0 {
                let alloc_bytes = if sz < 16 { 16 } else { sz };
                unsafe {
                    heap_free(hptr, alloc_bytes, 16);
                    (*a).host_ptr = 0 as *mut u8;
                    (*a).is_live = false;
                }
            }
            i = i + 1;
        }
        let cap_bytes = interp_mul_usize(ctx.alloc_cap, size_of<InterpAlloc>());
        unsafe {
            heap_free(ctx.allocs as *mut u8, cap_bytes, align_of<InterpAlloc>());
        }
        ctx.allocs = 0 as *mut InterpAlloc;
        ctx.alloc_count = 0;
        ctx.alloc_cap = 0;
    }
}

// Axiom Compiler — MIR Interpreter Host Oracle (compiler/interp/oracle.ax)
// Port of bootstrap/axiom0/src/interp/host.c.
// Implements the 18-function std.core.host capability table (ADR-0002) by validating all
// interpreted pointers against the interpreter allocation table and delegating host operations
// to std.core.host intrinsics (never raw extern "system" FFI, per ADR-0002 §6).
module compiler.interp.oracle

use std.core.host.arg
use std.core.host.args_count
use std.core.host.close
use std.core.host.dir_close
use std.core.host.dir_next
use std.core.host.dir_open
use std.core.host.env_get
use std.core.host.exe_path
use std.core.host.file_size
use std.core.host.heap_alloc
use std.core.host.heap_free
use std.core.host.metadata
use std.core.host.mkdir
use std.core.host.monotonic_ns
use std.core.host.open
use std.core.host.read
use std.core.host.remove
use std.core.host.stdio
use std.core.host.write

use compiler.kernel.interner.StrView
use compiler.diag.format.diag_buf_push_bytes
use compiler.interp.value.INTERP_MSG_UB_DANGLING
use compiler.interp.value.INTERP_MSG_UB_FREE_NON_HEAP
use compiler.interp.value.INTERP_MSG_UB_UNMAPPED
use compiler.interp.value.InterpAlloc
use compiler.interp.value.InterpCtx
use compiler.interp.value.InterpHostArg
use compiler.interp.value.InterpValue
use compiler.interp.value.interp_alloc_at
use compiler.interp.value.interp_copy_bytes
use compiler.interp.value.interp_host_arg_at
use compiler.interp.value.interp_i64_at
use compiler.interp.value.interp_mul_usize
use compiler.interp.value.interp_register_alloc
use compiler.interp.value.interp_report_ub
use compiler.interp.value.interp_validate_raw_ptr
use compiler.interp.value.interp_zero_bytes

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }

// Concatenated host intrinsic names:
//   0..10:   "heap_alloc"
//   10..22:  "heap_realloc"
//   22..31:  "heap_free"
//   31..36:  "stdio"
//   36..40:  "open"
//   40..44:  "read"
//   44..49:  "write"
//   49..54:  "close"
//   54..63:  "file_size"
//   63..73:  "args_count"
//   73..76:  "arg"
//   76..83:  "env_get"
//   83..91:  "exe_path"
//   91..95:  "exit"
//   95..101: "remove"
//   101..106:"mkdir"
//   106..114:"metadata"
//   114..122:"dir_open"
//   122..130:"dir_next"
//   130..139:"dir_close"
//   139..151:"monotonic_ns"
const HOST_NAMES_BYTES: [151]u8 = [
    // "heap_alloc" (0, 10)
    104u8, 101u8, 97u8, 112u8, 95u8, 97u8, 108u8, 108u8, 111u8, 99u8,
    // "heap_realloc" (10, 12)
    104u8, 101u8, 97u8, 112u8, 95u8, 114u8, 101u8, 97u8, 108u8, 108u8, 111u8, 99u8,
    // "heap_free" (22, 9)
    104u8, 101u8, 97u8, 112u8, 95u8, 102u8, 114u8, 101u8, 101u8,
    // "stdio" (31, 5)
    115u8, 116u8, 100u8, 105u8, 111u8,
    // "open" (36, 4)
    111u8, 112u8, 101u8, 110u8,
    // "read" (40, 4)
    114u8, 101u8, 97u8, 100u8,
    // "write" (44, 5)
    119u8, 114u8, 105u8, 116u8, 101u8,
    // "close" (49, 5)
    99u8, 108u8, 111u8, 115u8, 101u8,
    // "file_size" (54, 9)
    102u8, 105u8, 108u8, 101u8, 95u8, 115u8, 105u8, 122u8, 101u8,
    // "args_count" (63, 10)
    97u8, 114u8, 103u8, 115u8, 95u8, 99u8, 111u8, 117u8, 110u8, 116u8,
    // "arg" (73, 3)
    97u8, 114u8, 103u8,
    // "env_get" (76, 7)
    101u8, 110u8, 118u8, 95u8, 103u8, 101u8, 116u8,
    // "exe_path" (83, 8)
    101u8, 120u8, 101u8, 95u8, 112u8, 97u8, 116u8, 104u8,
    // "exit" (91, 4)
    101u8, 120u8, 105u8, 116u8,
    // "remove" (95, 6)
    114u8, 101u8, 109u8, 111u8, 118u8, 101u8,
    // "mkdir" (101, 5)
    109u8, 107u8, 100u8, 105u8, 114u8,
    // "metadata" (106, 8)
    109u8, 101u8, 116u8, 97u8, 100u8, 97u8, 116u8, 97u8,
    // "dir_open" (114, 8)
    100u8, 105u8, 114u8, 95u8, 111u8, 112u8, 101u8, 110u8,
    // "dir_next" (122, 8)
    100u8, 105u8, 114u8, 95u8, 110u8, 101u8, 120u8, 116u8,
    // "dir_close" (130, 9)
    100u8, 105u8, 114u8, 95u8, 99u8, 108u8, 111u8, 115u8, 101u8,
    // "monotonic_ns" (139, 12)
    109u8, 111u8, 110u8, 111u8, 116u8, 111u8, 110u8, 105u8, 99u8, 95u8, 110u8, 115u8,
];

fn host_name_eq(name: view<StrView>, off: usize, n: usize) -> bool {
    if name.len != n || (name.ptr as usize) == 0 {
        return false;
    }
    let mut i: usize = 0;
    while i < n {
        let ch = unsafe { *(name.ptr + i) };
        if ch != HOST_NAMES_BYTES[off + i] {
            return false;
        }
        i = i + 1;
    }
    true
}

pub fn interp_is_host_intrinsic_name(name: view<StrView>) -> bool {
    if host_name_eq(name, 0, 10) { return true; }
    if host_name_eq(name, 10, 12) { return true; }
    if host_name_eq(name, 22, 9) { return true; }
    if host_name_eq(name, 31, 5) { return true; }
    if host_name_eq(name, 36, 4) { return true; }
    if host_name_eq(name, 40, 4) { return true; }
    if host_name_eq(name, 44, 5) { return true; }
    if host_name_eq(name, 49, 5) { return true; }
    if host_name_eq(name, 54, 9) { return true; }
    if host_name_eq(name, 63, 10) { return true; }
    if host_name_eq(name, 73, 3) { return true; }
    if host_name_eq(name, 76, 7) { return true; }
    if host_name_eq(name, 83, 8) { return true; }
    if host_name_eq(name, 91, 4) { return true; }
    if host_name_eq(name, 95, 6) { return true; }
    if host_name_eq(name, 101, 5) { return true; }
    if host_name_eq(name, 106, 8) { return true; }
    if host_name_eq(name, 114, 8) { return true; }
    if host_name_eq(name, 122, 8) { return true; }
    if host_name_eq(name, 130, 9) { return true; }
    if host_name_eq(name, 139, 12) { return true; }
    false
}

// =================================================================================================
// Host State Lifecycle & Handle Tracking
// =================================================================================================

pub fn interp_host_init(ctx: mut_view<InterpCtx>) {
    ctx.host.args = 0 as *mut InterpHostArg;
    ctx.host.argc = 0;
    ctx.host.args_cap = 0;
    ctx.host.use_custom_args = false;
    ctx.host.open_fds = 0 as *mut i64;
    ctx.host.open_fds_len = 0;
    ctx.host.open_fds_cap = 0;
    ctx.host.open_dirs = 0 as *mut i64;
    ctx.host.open_dirs_len = 0;
    ctx.host.open_dirs_cap = 0;
    ctx.host.last_monotonic_ns = 0u64;
}

pub fn interp_host_set_custom_args(ctx: mut_view<InterpCtx>, enable: bool) {
    ctx.host.use_custom_args = enable;
}

pub fn interp_host_push_arg(ctx: mut_view<InterpCtx>, arg_sv: StrView) {
    ctx.host.use_custom_args = true;
    if ctx.host.argc >= ctx.host.args_cap {
        let new_cap: usize = if ctx.host.args_cap == 0 { 16 } else { interp_mul_usize(ctx.host.args_cap, 2) };
        let new_bytes = interp_mul_usize(new_cap, size_of<InterpHostArg>());
        let new_arr = unsafe { heap_alloc(new_bytes, align_of<InterpHostArg>()) as *mut InterpHostArg };
        unsafe {
            interp_zero_bytes(new_arr as *mut u8, new_bytes);
        }
        if ctx.host.argc > 0 && (ctx.host.args as usize) != 0 {
            let old_bytes = interp_mul_usize(ctx.host.argc, size_of<InterpHostArg>());
            let old_cap_bytes = interp_mul_usize(ctx.host.args_cap, size_of<InterpHostArg>());
            unsafe {
                interp_copy_bytes(new_arr as *mut u8, ctx.host.args as *const u8, old_bytes);
                heap_free(ctx.host.args as *mut u8, old_cap_bytes, align_of<InterpHostArg>());
            }
        }
        ctx.host.args = new_arr;
        ctx.host.args_cap = new_cap;
    }

    let arg_len = arg_sv.len;
    let alloc_len: usize = if arg_len < 16 { 16 } else { arg_len + 1 };
    let copy_buf = unsafe { heap_alloc(alloc_len, 1) };
    unsafe {
        interp_zero_bytes(copy_buf, alloc_len);
    }
    if arg_len > 0 && (arg_sv.ptr as usize) != 0 {
        unsafe {
            interp_copy_bytes(copy_buf, arg_sv.ptr, arg_len);
        }
    }
    let slot = unsafe { interp_host_arg_at(ctx.host.args, ctx.host.argc) };
    unsafe {
        (*slot).ptr = copy_buf;
        (*slot).len = arg_len;
    }
    ctx.host.argc = ctx.host.argc + 1;
}

fn host_record_open_fd(ctx: mut_view<InterpCtx>, fd: i64) {
    if ctx.host.open_fds_len >= ctx.host.open_fds_cap {
        let new_cap: usize = if ctx.host.open_fds_cap == 0 { 16 } else { interp_mul_usize(ctx.host.open_fds_cap, 2) };
        let new_bytes = interp_mul_usize(new_cap, size_of<i64>());
        let new_arr = unsafe { heap_alloc(new_bytes, align_of<i64>()) as *mut i64 };
        if ctx.host.open_fds_len > 0 && (ctx.host.open_fds as usize) != 0 {
            let old_bytes = interp_mul_usize(ctx.host.open_fds_len, size_of<i64>());
            let old_cap_bytes = interp_mul_usize(ctx.host.open_fds_cap, size_of<i64>());
            unsafe {
                interp_copy_bytes(new_arr as *mut u8, ctx.host.open_fds as *const u8, old_bytes);
                heap_free(ctx.host.open_fds as *mut u8, old_cap_bytes, align_of<i64>());
            }
        }
        ctx.host.open_fds = new_arr;
        ctx.host.open_fds_cap = new_cap;
    }
    unsafe {
        *interp_i64_at(ctx.host.open_fds, ctx.host.open_fds_len) = fd;
    }
    ctx.host.open_fds_len = ctx.host.open_fds_len + 1;
}

fn host_has_open_fd(ctx: view<InterpCtx>, fd: i64) -> bool {
    let mut i: usize = 0;
    while i < ctx.host.open_fds_len {
        let cur = unsafe { *interp_i64_at(ctx.host.open_fds, i) };
        if cur == fd {
            return true;
        }
        i = i + 1;
    }
    false
}

fn host_remove_open_fd(ctx: mut_view<InterpCtx>, fd: i64) -> bool {
    let mut i: usize = 0;
    while i < ctx.host.open_fds_len {
        let cur = unsafe { *interp_i64_at(ctx.host.open_fds, i) };
        if cur == fd {
            let last_idx = ctx.host.open_fds_len - 1;
            if i != last_idx {
                let last_val = unsafe { *interp_i64_at(ctx.host.open_fds, last_idx) };
                unsafe {
                    *interp_i64_at(ctx.host.open_fds, i) = last_val;
                }
            }
            ctx.host.open_fds_len = last_idx;
            return true;
        }
        i = i + 1;
    }
    false
}

fn host_record_open_dir(ctx: mut_view<InterpCtx>, dhid: i64) {
    if ctx.host.open_dirs_len >= ctx.host.open_dirs_cap {
        let new_cap: usize = if ctx.host.open_dirs_cap == 0 { 16 } else { interp_mul_usize(ctx.host.open_dirs_cap, 2) };
        let new_bytes = interp_mul_usize(new_cap, size_of<i64>());
        let new_arr = unsafe { heap_alloc(new_bytes, align_of<i64>()) as *mut i64 };
        if ctx.host.open_dirs_len > 0 && (ctx.host.open_dirs as usize) != 0 {
            let old_bytes = interp_mul_usize(ctx.host.open_dirs_len, size_of<i64>());
            let old_cap_bytes = interp_mul_usize(ctx.host.open_dirs_cap, size_of<i64>());
            unsafe {
                interp_copy_bytes(new_arr as *mut u8, ctx.host.open_dirs as *const u8, old_bytes);
                heap_free(ctx.host.open_dirs as *mut u8, old_cap_bytes, align_of<i64>());
            }
        }
        ctx.host.open_dirs = new_arr;
        ctx.host.open_dirs_cap = new_cap;
    }
    unsafe {
        *interp_i64_at(ctx.host.open_dirs, ctx.host.open_dirs_len) = dhid;
    }
    ctx.host.open_dirs_len = ctx.host.open_dirs_len + 1;
}

fn host_has_open_dir(ctx: view<InterpCtx>, dhid: i64) -> bool {
    let mut i: usize = 0;
    while i < ctx.host.open_dirs_len {
        let cur = unsafe { *interp_i64_at(ctx.host.open_dirs, i) };
        if cur == dhid {
            return true;
        }
        i = i + 1;
    }
    false
}

fn host_remove_open_dir(ctx: mut_view<InterpCtx>, dhid: i64) -> bool {
    let mut i: usize = 0;
    while i < ctx.host.open_dirs_len {
        let cur = unsafe { *interp_i64_at(ctx.host.open_dirs, i) };
        if cur == dhid {
            let last_idx = ctx.host.open_dirs_len - 1;
            if i != last_idx {
                let last_val = unsafe { *interp_i64_at(ctx.host.open_dirs, last_idx) };
                unsafe {
                    *interp_i64_at(ctx.host.open_dirs, i) = last_val;
                }
            }
            ctx.host.open_dirs_len = last_idx;
            return true;
        }
        i = i + 1;
    }
    false
}

pub fn interp_host_cleanup(ctx: mut_view<InterpCtx>) {
    let mut i: usize = 0;
    while i < ctx.host.open_fds_len {
        let fd = unsafe { *interp_i64_at(ctx.host.open_fds, i) };
        let _ = close(fd);
        i = i + 1;
    }
    if ctx.host.open_fds_cap > 0 && (ctx.host.open_fds as usize) != 0 {
        let cap_bytes = interp_mul_usize(ctx.host.open_fds_cap, size_of<i64>());
        unsafe {
            heap_free(ctx.host.open_fds as *mut u8, cap_bytes, align_of<i64>());
        }
    }
    ctx.host.open_fds = 0 as *mut i64;
    ctx.host.open_fds_len = 0;
    ctx.host.open_fds_cap = 0;

    i = 0;
    while i < ctx.host.open_dirs_len {
        let dhid = unsafe { *interp_i64_at(ctx.host.open_dirs, i) };
        let _ = dir_close(dhid);
        i = i + 1;
    }
    if ctx.host.open_dirs_cap > 0 && (ctx.host.open_dirs as usize) != 0 {
        let cap_bytes = interp_mul_usize(ctx.host.open_dirs_cap, size_of<i64>());
        unsafe {
            heap_free(ctx.host.open_dirs as *mut u8, cap_bytes, align_of<i64>());
        }
    }
    ctx.host.open_dirs = 0 as *mut i64;
    ctx.host.open_dirs_len = 0;
    ctx.host.open_dirs_cap = 0;

    i = 0;
    while i < ctx.host.argc {
        let slot = unsafe { interp_host_arg_at(ctx.host.args, i) };
        let p = unsafe { (*slot).ptr };
        let l = unsafe { (*slot).len };
        if (p as usize) != 0 {
            let alloc_len: usize = if l < 16 { 16 } else { l + 1 };
            unsafe {
                heap_free(p, alloc_len, 1);
                (*slot).ptr = 0 as *mut u8;
            }
        }
        i = i + 1;
    }
    if ctx.host.args_cap > 0 && (ctx.host.args as usize) != 0 {
        let cap_bytes = interp_mul_usize(ctx.host.args_cap, size_of<InterpHostArg>());
        unsafe {
            heap_free(ctx.host.args as *mut u8, cap_bytes, align_of<InterpHostArg>());
        }
    }
    ctx.host.args = 0 as *mut InterpHostArg;
    ctx.host.argc = 0;
    ctx.host.args_cap = 0;
    ctx.host.use_custom_args = false;
}

// =================================================================================================
// Host Intrinsic Dispatch
// =================================================================================================

fn eval_host_heap_alloc(ctx: mut_view<InterpCtx>, size: u64, align: u64, out_ret: mut_view<InterpValue>) {
    if size == 0u64 {
        out_ret.vals[0] = 0u64;
        return;
    }
    if align == 0u64 || (align & (align - 1u64)) != 0u64 || align > 4096u64 {
        out_ret.vals[0] = 0u64;
        return;
    }
    let alloc_bytes: usize = if size < 16u64 { 16 } else { size as usize };
    let mem = unsafe { heap_alloc(alloc_bytes, 16) };
    if (mem as usize) == 0 {
        out_ret.vals[0] = 0u64;
        return;
    }
    unsafe {
        interp_zero_bytes(mem, alloc_bytes);
    }
    let a = interp_register_alloc(mut_view(*ctx), mem, size, align as u32, -1);
    out_ret.vals[0] = unsafe { (*a).base_addr };
}

fn eval_host_heap_realloc(
    ctx: mut_view<InterpCtx>,
    p: u64,
    old_size: u64,
    new_size: u64,
    align: u64,
    out_ret: mut_view<InterpValue>
) {
    if p == 0u64 {
        eval_host_heap_alloc(mut_view(*ctx), new_size, align, mut_view(*out_ret));
        return;
    }
    if new_size == 0u64 {
        out_ret.vals[0] = 0u64;
        return;
    }
    if align == 0u64 || (align & (align - 1u64)) != 0u64 || align > 4096u64 {
        out_ret.vals[0] = 0u64;
        return;
    }

    let mut found: *mut InterpAlloc = 0 as *mut InterpAlloc;
    let mut i: usize = 0;
    while i < ctx.alloc_count {
        let a = unsafe { interp_alloc_at(ctx.allocs, i) };
        if (unsafe { (*a).base_addr }) == p {
            found = a;
            break;
        }
        i = i + 1;
    }
    if (found as usize) == 0 || !(unsafe { (*found).is_live }) || (unsafe { (*found).call_depth }) != -1 {
        interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_DANGLING);
        out_ret.vals[0] = 0u64;
        return;
    }

    let alloc_bytes: usize = if new_size < 16u64 { 16 } else { new_size as usize };
    let new_mem = unsafe { heap_alloc(alloc_bytes, 16) };
    if (new_mem as usize) == 0 {
        out_ret.vals[0] = 0u64;
        return;
    }
    unsafe {
        interp_zero_bytes(new_mem, alloc_bytes);
    }

    let mut copy_sz: u64 = if old_size < new_size { old_size } else { new_size };
    let found_sz = unsafe { (*found).size };
    if found_sz < copy_sz {
        copy_sz = found_sz;
    }
    let found_ptr = unsafe { (*found).host_ptr };
    if copy_sz > 0u64 && (found_ptr as usize) != 0 {
        unsafe {
            interp_copy_bytes(new_mem, found_ptr as *const u8, copy_sz as usize);
        }
    }
    if (found_ptr as usize) != 0 {
        let old_alloc_bytes: usize = if found_sz < 16u64 { 16 } else { found_sz as usize };
        unsafe {
            heap_free(found_ptr, old_alloc_bytes, 16);
        }
    }
    unsafe {
        (*found).is_live = false;
        (*found).host_ptr = 0 as *mut u8;
    }

    let na = interp_register_alloc(mut_view(*ctx), new_mem, new_size, align as u32, -1);
    out_ret.vals[0] = unsafe { (*na).base_addr };
}

fn eval_host_heap_free(ctx: mut_view<InterpCtx>, p: u64, out_ret: mut_view<InterpValue>) {
    if p == 0u64 {
        out_ret.vals[0] = 0u64;
        return;
    }
    let mut found: *mut InterpAlloc = 0 as *mut InterpAlloc;
    let mut i: usize = 0;
    while i < ctx.alloc_count {
        let a = unsafe { interp_alloc_at(ctx.allocs, i) };
        if (unsafe { (*a).base_addr }) == p {
            found = a;
            break;
        }
        i = i + 1;
    }
    if (found as usize) == 0 {
        interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_UNMAPPED);
        return;
    }
    if !(unsafe { (*found).is_live }) {
        interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_DANGLING);
        return;
    }
    if (unsafe { (*found).call_depth }) != -1 {
        interp_report_ub(mut_view(*ctx), INTERP_MSG_UB_FREE_NON_HEAP);
        return;
    }
    let found_ptr = unsafe { (*found).host_ptr };
    let found_sz = unsafe { (*found).size };
    if (found_ptr as usize) != 0 {
        let old_alloc_bytes: usize = if found_sz < 16u64 { 16 } else { found_sz as usize };
        unsafe {
            heap_free(found_ptr, old_alloc_bytes, 16);
        }
    }
    unsafe {
        (*found).is_live = false;
        (*found).host_ptr = 0 as *mut u8;
    }
    out_ret.vals[0] = 0u64;
}

pub fn interp_eval_host_intrinsic(
    ctx: mut_view<InterpCtx>,
    name: StrView,
    args: *const u64,
    arg_count: usize,
    out_ret: mut_view<InterpValue>
) -> bool {
    let a0: u64 = if arg_count > 0 && (args as usize) != 0 { unsafe { *(args + 0) } } else { 0u64 };
    let a1: u64 = if arg_count > 1 && (args as usize) != 0 { unsafe { *(args + 1) } } else { 0u64 };
    let a2: u64 = if arg_count > 2 && (args as usize) != 0 { unsafe { *(args + 2) } } else { 0u64 };
    let a3: u64 = if arg_count > 3 && (args as usize) != 0 { unsafe { *(args + 3) } } else { 0u64 };

    // 1. heap_alloc
    if host_name_eq(view(name), 0, 10) {
        eval_host_heap_alloc(mut_view(*ctx), a0, a1, mut_view(*out_ret));
        return true;
    }

    // 2. heap_realloc
    if host_name_eq(view(name), 10, 12) {
        eval_host_heap_realloc(mut_view(*ctx), a0, a1, a2, a3, mut_view(*out_ret));
        return true;
    }

    // 3. heap_free
    if host_name_eq(view(name), 22, 9) {
        eval_host_heap_free(mut_view(*ctx), a0, mut_view(*out_ret));
        return true;
    }

    // 4. stdio
    if host_name_eq(view(name), 31, 5) {
        if a0 <= 2u64 {
            out_ret.vals[0] = a0;
        } else {
            out_ret.vals[0] = (-4i64) as u64;
        }
        return true;
    }

    // 5. open
    if host_name_eq(view(name), 36, 4) {
        let path_host = interp_validate_raw_ptr(mut_view(*ctx), a0, a1, 1u32);
        if ctx.failed {
            out_ret.vals[0] = (-4i64) as u64;
            return true;
        }
        let mode = a2 as u32;
        if mode > 2u32 {
            out_ret.vals[0] = (-4i64) as u64;
            return true;
        }
        let res = unsafe { open(path_host as *const u8, a1 as usize, mode) };
        if res >= 3i64 {
            host_record_open_fd(mut_view(*ctx), res);
        }
        out_ret.vals[0] = res as u64;
        return true;
    }

    // 6. read
    if host_name_eq(view(name), 40, 4) {
        let h = a0 as i64;
        let buf_addr = a1;
        let cap = a2;
        if cap == 0u64 {
            out_ret.vals[0] = 0u64;
            return true;
        }
        let buf_host = interp_validate_raw_ptr(mut_view(*ctx), buf_addr, cap, 1u32);
        if ctx.failed {
            out_ret.vals[0] = (-4i64) as u64;
            return true;
        }
        if h != 0i64 && !(h >= 3i64 && host_has_open_fd(view(*ctx), h)) {
            out_ret.vals[0] = (-4i64) as u64;
            return true;
        }
        let res = unsafe { read(h, buf_host, cap as usize) };
        out_ret.vals[0] = res as u64;
        return true;
    }

    // 7. write
    if host_name_eq(view(name), 44, 5) {
        let h = a0 as i64;
        let p_addr = a1;
        let byte_len = a2;
        if byte_len == 0u64 {
            out_ret.vals[0] = 0u64;
            return true;
        }
        let p_host = interp_validate_raw_ptr(mut_view(*ctx), p_addr, byte_len, 1u32);
        if ctx.failed {
            out_ret.vals[0] = (-4i64) as u64;
            return true;
        }
        if h == 1i64 && (ctx.out_buf as usize) != 0 && ctx.capture_stdout {
            unsafe {
                diag_buf_push_bytes(mut_view(*ctx.out_buf), p_host as *const u8, byte_len as usize);
            }
            out_ret.vals[0] = byte_len;
            return true;
        }
        if h != 1i64 && h != 2i64 && !(h >= 3i64 && host_has_open_fd(view(*ctx), h)) {
            out_ret.vals[0] = (-4i64) as u64;
            return true;
        }
        let res = unsafe { write(h, p_host as *const u8, byte_len as usize) };
        out_ret.vals[0] = res as u64;
        return true;
    }

    // 8. close
    if host_name_eq(view(name), 49, 5) {
        let h = a0 as i64;
        if h >= 0i64 && h <= 2i64 {
            out_ret.vals[0] = 0u64;
            return true;
        }
        if h >= 3i64 && host_remove_open_fd(mut_view(*ctx), h) {
            let res = close(h);
            out_ret.vals[0] = res as u64;
            return true;
        }
        out_ret.vals[0] = (-4i64) as u64;
        return true;
    }

    // 9. file_size
    if host_name_eq(view(name), 54, 9) {
        let h = a0 as i64;
        if h < 3i64 || !host_has_open_fd(view(*ctx), h) {
            out_ret.vals[0] = (-4i64) as u64;
            return true;
        }
        let res = file_size(h);
        out_ret.vals[0] = res as u64;
        return true;
    }

    // 10. args_count
    if host_name_eq(view(name), 63, 10) {
        if ctx.host.use_custom_args {
            out_ret.vals[0] = ctx.host.argc as u64;
        } else {
            let ac = args_count();
            out_ret.vals[0] = ac as u64;
        }
        return true;
    }

    // 11. arg
    if host_name_eq(view(name), 73, 3) {
        let idx = a0 as usize;
        let buf_addr = a1;
        let cap = a2 as usize;
        if ctx.host.use_custom_args {
            if idx >= ctx.host.argc {
                out_ret.vals[0] = (-4i64) as u64;
                return true;
            }
            let slot = unsafe { interp_host_arg_at(ctx.host.args, idx) };
            let ptr = unsafe { (*slot).ptr };
            let arg_len = unsafe { (*slot).len };
            if cap > 0 && arg_len > 0 {
                let to_write: usize = if arg_len < cap { arg_len } else { cap };
                let host_buf = interp_validate_raw_ptr(mut_view(*ctx), buf_addr, to_write as u64, 1u32);
                if !ctx.failed {
                    unsafe {
                        interp_copy_bytes(host_buf, ptr as *const u8, to_write);
                    }
                }
            }
            out_ret.vals[0] = (arg_len as i64) as u64;
            return true;
        }
        let total_len = unsafe { arg(idx, 0 as *mut u8, 0) };
        if total_len < 0i64 {
            out_ret.vals[0] = total_len as u64;
            return true;
        }
        if cap > 0 && total_len > 0i64 {
            let ulen = total_len as usize;
            let to_write: usize = if ulen < cap { ulen } else { cap };
            let host_buf = interp_validate_raw_ptr(mut_view(*ctx), buf_addr, to_write as u64, 1u32);
            if !ctx.failed {
                let _ = unsafe { arg(idx, host_buf, to_write) };
            }
        }
        out_ret.vals[0] = total_len as u64;
        return true;
    }

    // 12. env_get
    if host_name_eq(view(name), 76, 7) {
        let name_addr = a0;
        let name_len = a1;
        let buf_addr = a2;
        let cap = a3 as usize;
        let name_host = interp_validate_raw_ptr(mut_view(*ctx), name_addr, name_len, 1u32);
        if ctx.failed {
            out_ret.vals[0] = (-4i64) as u64;
            return true;
        }
        let total_len = unsafe { env_get(name_host as *const u8, name_len as usize, 0 as *mut u8, 0) };
        if total_len < 0i64 {
            out_ret.vals[0] = total_len as u64;
            return true;
        }
        if cap > 0 && total_len > 0i64 {
            let ulen = total_len as usize;
            let to_write: usize = if ulen < cap { ulen } else { cap };
            let host_buf = interp_validate_raw_ptr(mut_view(*ctx), buf_addr, to_write as u64, 1u32);
            if !ctx.failed {
                let _ = unsafe { env_get(name_host as *const u8, name_len as usize, host_buf, to_write) };
            }
        }
        out_ret.vals[0] = total_len as u64;
        return true;
    }

    // 13. exe_path
    if host_name_eq(view(name), 83, 8) {
        let buf_addr = a0;
        let cap = a1 as usize;
        let total_len = unsafe { exe_path(0 as *mut u8, 0) };
        if total_len < 0i64 {
            out_ret.vals[0] = total_len as u64;
            return true;
        }
        if cap > 0 && total_len > 0i64 {
            let ulen = total_len as usize;
            let to_write: usize = if ulen < cap { ulen } else { cap };
            let host_buf = interp_validate_raw_ptr(mut_view(*ctx), buf_addr, to_write as u64, 1u32);
            if !ctx.failed {
                let _ = unsafe { exe_path(host_buf, to_write) };
            }
        }
        out_ret.vals[0] = total_len as u64;
        return true;
    }

    // 14. exit
    if host_name_eq(view(name), 91, 4) {
        let code = (a0 as u32) as i32;
        ctx.failed = true;
        ctx.has_exited = true;
        ctx.exit_code = code;
        out_ret.vals[0] = (code as i64) as u64;
        return true;
    }

    // 15. remove
    if host_name_eq(view(name), 95, 6) {
        let path_host = interp_validate_raw_ptr(mut_view(*ctx), a0, a1, 1u32);
        if ctx.failed {
            out_ret.vals[0] = (-4i64) as u64;
            return true;
        }
        let res = unsafe { remove(path_host as *const u8, a1 as usize) };
        out_ret.vals[0] = res as u64;
        return true;
    }

    // 16. mkdir
    if host_name_eq(view(name), 101, 5) {
        let path_host = interp_validate_raw_ptr(mut_view(*ctx), a0, a1, 1u32);
        if ctx.failed {
            out_ret.vals[0] = (-4i64) as u64;
            return true;
        }
        let res = unsafe { mkdir(path_host as *const u8, a1 as usize) };
        out_ret.vals[0] = res as u64;
        return true;
    }

    // 17. metadata
    if host_name_eq(view(name), 106, 8) {
        let path_host = interp_validate_raw_ptr(mut_view(*ctx), a0, a1, 1u32);
        let out_host = interp_validate_raw_ptr(mut_view(*ctx), a2, 16u64, 8u32);
        if ctx.failed {
            out_ret.vals[0] = (-4i64) as u64;
            return true;
        }
        let res = unsafe { metadata(path_host as *const u8, a1 as usize, out_host as *mut u64) };
        out_ret.vals[0] = res as u64;
        return true;
    }

    // 18. dir_open
    if host_name_eq(view(name), 114, 8) {
        let path_host = interp_validate_raw_ptr(mut_view(*ctx), a0, a1, 1u32);
        if ctx.failed {
            out_ret.vals[0] = (-4i64) as u64;
            return true;
        }
        let res = unsafe { dir_open(path_host as *const u8, a1 as usize) };
        if res > 0i64 {
            host_record_open_dir(mut_view(*ctx), res);
        }
        out_ret.vals[0] = res as u64;
        return true;
    }

    // 19. dir_next
    if host_name_eq(view(name), 122, 8) {
        let dhid = a0 as i64;
        let buf_addr = a1;
        let cap = a2 as usize;
        if !host_has_open_dir(view(*ctx), dhid) {
            out_ret.vals[0] = (-4i64) as u64;
            return true;
        }
        let n = unsafe { dir_next(dhid, 0 as *mut u8, 0) };
        if n <= 0i64 || (n as usize) > cap {
            out_ret.vals[0] = n as u64;
            return true;
        }
        let host_buf = interp_validate_raw_ptr(mut_view(*ctx), buf_addr, n as u64, 1u32);
        if ctx.failed {
            out_ret.vals[0] = (-4i64) as u64;
            return true;
        }
        let res = unsafe { dir_next(dhid, host_buf, cap) };
        out_ret.vals[0] = res as u64;
        return true;
    }

    // 20. dir_close
    if host_name_eq(view(name), 130, 9) {
        let dhid = a0 as i64;
        if host_remove_open_dir(mut_view(*ctx), dhid) {
            let res = dir_close(dhid);
            out_ret.vals[0] = res as u64;
            return true;
        }
        out_ret.vals[0] = (-4i64) as u64;
        return true;
    }

    // 21. monotonic_ns
    if host_name_eq(view(name), 139, 12) {
        let mut ns = monotonic_ns();
        if ns < ctx.host.last_monotonic_ns {
            ns = ctx.host.last_monotonic_ns;
        } else {
            ctx.host.last_monotonic_ns = ns;
        }
        out_ret.vals[0] = ns;
        return true;
    }

    false
}

