const SFT_NAMES: [90]u8 = [
    114u8, 111u8, 117u8, 110u8, 100u8, 95u8, 116u8, 105u8, 101u8, 115u8, 95u8, 101u8, 118u8, 101u8, 110u8, 110u8, 101u8, 120u8, 116u8, 95u8, 100u8, 111u8, 119u8, 110u8, 102u8, 114u8, 111u8, 109u8, 95u8, 98u8, 105u8, 116u8, 115u8, 99u8, 111u8, 112u8, 121u8, 115u8, 105u8, 103u8, 110u8, 110u8, 101u8, 120u8, 116u8, 95u8, 117u8, 112u8, 116u8, 111u8, 95u8, 98u8, 105u8, 116u8, 115u8, 102u8, 108u8, 111u8, 111u8, 114u8, 114u8, 111u8, 117u8, 110u8, 100u8, 116u8, 114u8, 117u8, 110u8, 99u8, 115u8, 113u8, 114u8, 116u8, 99u8, 101u8, 105u8, 108u8, 97u8, 98u8, 115u8, 102u8, 109u8, 97u8, 109u8, 105u8, 110u8, 109u8, 97u8, 120u8,
];

const SFT_NAME_OFF: [15]usize = [0, 15, 24, 33, 41, 48, 55, 60, 65, 70, 74, 78, 81, 84, 87];

const SFT_NAME_LEN: [15]usize = [15, 9, 9, 8, 7, 7, 5, 5, 5, 4, 4, 3, 3, 3, 3];

const SFT_BAD: [89]u8 = [115u8, 113u8, 114u8, 115u8, 113u8, 114u8, 116u8, 116u8, 83u8, 113u8, 114u8, 116u8, 97u8, 98u8, 115u8, 49u8, 102u8, 109u8, 109u8, 105u8, 110u8, 120u8, 109u8, 97u8, 120u8, 105u8, 116u8, 111u8, 95u8, 98u8, 105u8, 116u8, 102u8, 114u8, 111u8, 109u8, 95u8, 98u8, 105u8, 116u8, 99u8, 111u8, 112u8, 121u8, 115u8, 105u8, 103u8, 110u8, 101u8, 120u8, 116u8, 95u8, 117u8, 110u8, 101u8, 120u8, 116u8, 117u8, 112u8, 102u8, 108u8, 111u8, 111u8, 99u8, 101u8, 105u8, 108u8, 120u8, 116u8, 114u8, 117u8, 110u8, 99u8, 97u8, 116u8, 101u8, 120u8, 115u8, 113u8, 114u8, 116u8, 114u8, 111u8, 117u8, 110u8, 102u8, 109u8, 97u8, 97u8];

const SFT_BAD_OFF: [19]usize = [0, 0, 3, 8, 12, 16, 18, 22, 26, 32, 40, 47, 53, 59, 63, 68, 76, 81, 85];

const SFT_BAD_LEN: [19]usize = [0, 3, 5, 4, 4, 2, 4, 4, 6, 8, 7, 6, 6, 4, 5, 8, 5, 4, 4];

const SFT_SUFFIX: [8]u8 = [95u8, 102u8, 51u8, 50u8, 95u8, 102u8, 54u8, 52u8];

const SFT_N32: usize = 559;
const SFT_N64: usize = 559;
const SFT_NBAD: usize = 19;

fn sft_name_sv(off: usize, n: usize) -> StrView {
    let p = unsafe { address_of(SFT_NAMES[off]) };
    StrView { ptr: p, len: n }
}

fn sft_bad_sv(off: usize, n: usize) -> StrView {
    if n == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let p = unsafe { address_of(SFT_BAD[off]) };
    StrView { ptr: p, len: n }
}

fn sft_cell(is32: bool, i: usize, j: usize) -> u64 {
    if is32 { SFT_V32[i * 5 + j] } else { SFT_V64[i * 5 + j] }
}

fn test_softfloat_kind_names() {
    // Every one of the 15 names maps to its own kind (1..15), alone and with a `_f32` / `_f64` suffix.
    let mut k: usize = 0;
    while k < 15 {
        let off = SFT_NAME_OFF[k];
        let n = SFT_NAME_LEN[k];
        let want = (k as u32) + 1u32;
        let sv0 = sft_name_sv(off, n);
        let k0 = sf_intrinsic_kind(view(sv0));
        qa_check(k0 == want);
        let mut buf: [32]u8 = [0u8; 32];
        let mut s: usize = 0;
        while s < 2 {
            let mut i: usize = 0;
            while i < n {
                buf[i] = SFT_NAMES[off + i];
                i = i + 1;
            }
            let mut j: usize = 0;
            while j < 4 {
                buf[n + j] = SFT_SUFFIX[s * 4 + j];
                j = j + 1;
            }
            let p = unsafe { address_of(buf[0]) };
            let sv1 = StrView { ptr: p, len: n + 4 };
            let k1 = sf_intrinsic_kind(view(sv1));
            qa_check(k1 == want);
            s = s + 1;
        }
        k = k + 1;
    }
    // Near names are rejected (kind 0).
    let mut b: usize = 0;
    while b < SFT_NBAD {
        let sv2 = sft_bad_sv(SFT_BAD_OFF[b], SFT_BAD_LEN[b]);
        let k2 = sf_intrinsic_kind(view(sv2));
        qa_check(k2 == 0u32);
        b = b + 1;
    }
}

// Returns the number of mismatching rows plus the number of kinds with fewer than 8 vectors (0 = pass).
fn sft_check_width(is32: bool) -> u32 {
    let mut bad: u32 = 0u32;
    let n = if is32 { SFT_N32 } else { SFT_N64 };
    let mut counts: [16]u32 = [0u32; 16];
    let mut i: usize = 0;
    while i < n {
        let kind = sft_cell(is32, i, 0) as u32;
        let got = sf_intrinsic(kind, is32, sft_cell(is32, i, 1), sft_cell(is32, i, 2), sft_cell(is32, i, 3));
        if got != sft_cell(is32, i, 4) {
            bad = bad + 1u32;
        }
        counts[kind as usize] = counts[kind as usize] + 1u32;
        i = i + 1;
    }
    let mut k: usize = 1;
    while k < 16 {
        if counts[k] < 8u32 {
            bad = bad + 1u32;
        }
        k = k + 1;
    }
    bad
}

fn test_softfloat_vectors_f32() {
    qa_check(sft_check_width(true) == 0u32);
}

fn test_softfloat_vectors_f64() {
    qa_check(sft_check_width(false) == 0u32);
}

fn test_softfloat_binop() {
    // Operator facts with hand-computed bits (the long tables live in tests/mir/float_interp).
    qa_check(sf_binop(0u8, false, 0x3FF0000000000000u64, 0x4000000000000000u64) == 0x4008000000000000u64);
    qa_check(sf_binop(0u8, false, 0x3FB999999999999Au64, 0x3FC999999999999Au64) == 0x3FD3333333333334u64);
    qa_check(sf_binop(0u8, false, 0x8000000000000000u64, 0x0u64) == 0x0u64);
    qa_check(sf_binop(1u8, true, 0x40490FDBu64, 0x40490FDBu64) == 0x0u64);
    qa_check(sf_binop(3u8, false, 0x3FF0000000000000u64, 0x0u64) == 0x7FF0000000000000u64);
    qa_check(sf_binop(3u8, true, 0x0u64, 0x0u64) == 0x7FC00000u64);
    qa_check(sf_binop(4u8, false, 0xC010000000000000u64, 0x4000000000000000u64) == 0x8000000000000000u64);
    qa_check(sf_binop(10u8, false, 0x7FF8000000000000u64, 0x7FF8000000000000u64) == 0u64);
    qa_check(sf_binop(13u8, false, 0x7FF8000000000000u64, 0x7FF8000000000000u64) == 1u64);
    qa_check(sf_binop(11u8, true, 0x7FC00000u64, 0x3F800000u64) == 0u64);
    qa_check(sf_binop(10u8, true, 0x80000000u64, 0x0u64) == 1u64);
}

pub fn main() -> i32 {
    test_wrapping_arith();
    test_alloc_and_ptr_validation();
    test_host_oracle();
    test_mir_body_map_and_limits();
    test_softfloat_kind_names();
    test_softfloat_vectors_f32();
    test_softfloat_vectors_f64();
    test_softfloat_binop();
    print("ALL INTERP UNIT TESTS PASSED\n");
    0
}
