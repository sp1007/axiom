@intrinsic fn assert(cond: bool) {}
@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_write_bytes<T>(dst: *mut T, val: u8, count: usize) {}

fn qa_check(cond: bool) {
    if !cond {
        assert(false);
    }
}

fn qa_zero_span() -> Span {
    Span {
        file: FileId { v: 0u32 },
        start: 0u32,
        end: 0u32,
    }
}

fn alloc_init_interner() -> *mut StrInterner {
    let p = unsafe { heap_alloc(size_of<StrInterner>(), align_of<StrInterner>()) as *mut StrInterner };
    unsafe {
        ptr_write_bytes<u8>(p as *mut u8, 0u8, size_of<StrInterner>());
        interner_init(mut_view(*p));
    }
    p
}

fn free_dealloc_interner(p: *mut StrInterner) {
    interner_free(unsafe { mut_view(*p) });
    unsafe {
        heap_free(p as *mut u8, size_of<StrInterner>(), align_of<StrInterner>());
    }
}

fn alloc_init_sink() -> *mut DiagSink {
    let p = unsafe { heap_alloc(size_of<DiagSink>(), align_of<DiagSink>()) as *mut DiagSink };
    unsafe {
        ptr_write_bytes<u8>(p as *mut u8, 0u8, size_of<DiagSink>());
        diag_sink_init(mut_view(*p));
    }
    p
}

fn free_dealloc_sink(p: *mut DiagSink) {
    if (p as usize) != 0 {
        unsafe {
            diag_sink_free(mut_view(*p));
            heap_free(p as *mut u8, size_of<DiagSink>(), align_of<DiagSink>());
        }
    }
}

fn alloc_init_arena() -> *mut Arena {
    let p = unsafe { heap_alloc(size_of<Arena>(), align_of<Arena>()) as *mut Arena };
    unsafe {
        *p = arena_new();
    }
    p
}

fn free_dealloc_arena(p: *mut Arena) {
    unsafe {
        arena_destroy(mut_view(*p));
        heap_free(p as *mut u8, size_of<Arena>(), align_of<Arena>());
    }
}

fn alloc_init_thir() -> *mut Thir {
    let p = unsafe { heap_alloc(size_of<Thir>(), align_of<Thir>()) as *mut Thir };
    let int_ar = arena_new();
    unsafe {
        ptr_write_bytes<u8>(p as *mut u8, 0u8, size_of<Thir>());
        (*p).interner.arena = int_ar;
        thir_init(mut_view(*p));
    }
    p
}

fn free_dealloc_thir(p: *mut Thir) {
    thir_free(unsafe { mut_view(*p) });
    unsafe {
        heap_free(p as *mut u8, size_of<Thir>(), align_of<Thir>());
    }
}

fn free_panic_sv(sv: mut_view<StrView>) {
    if (sv.ptr as usize) != 0 {
        unsafe {
            heap_free(sv.ptr as *mut u8, sv.len + 1, 1);
        }
        sv.ptr = 0 as *const u8;
        sv.len = 0;
    }
}

fn map_mut_ptr(m: mut_view<MirBodyMap>) -> *mut MirBodyMap {
    unsafe { address_of_mut(*m) }
}

fn run_test_interp(
    main_fn: *mut HirItem,
    thir_ptr: *mut Thir,
    hir: view<HirFile>,
    str_in: *mut StrInterner,
    sink_ptr: *mut DiagSink,
    step_limit: i32,
    call_depth_limit: i32,
    mir_map_ptr: *mut MirBodyMap,
    out_buf: mut_view<DiagBuffer>,
    panic_sv: mut_view<StrView>
) -> i32 {
    interp_run(
        main_fn,
        thir_ptr,
        unsafe { address_of(*hir) },
        str_in,
        0 as *const ResolveMap,
        0 as *const Ast,
        0 as *const SourceDatabase,
        sink_ptr,
        0 as *mut MonoEngine,
        step_limit,
        call_depth_limit,
        mir_map_ptr,
        unsafe { address_of_mut(*out_buf) },
        true,
        unsafe { address_of_mut(*panic_sv) }
    )
}

fn alloc_ty1(arena: mut_view<Arena>, t0_v: u32) -> *mut TypeId {
    let p = arena_alloc_raw(arena, size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
    unsafe {
        (*typeid_at(p, 0)).v = t0_v;
    }
    p
}

fn alloc_ty2(arena: mut_view<Arena>, t0_v: u32, t1_v: u32) -> *mut TypeId {
    let p = arena_alloc_raw(arena, mir_mul_usize(2, size_of<TypeId>()), align_of<TypeId>()) as *mut TypeId;
    unsafe {
        (*typeid_at(p, 0)).v = t0_v;
        (*typeid_at(p, 1)).v = t1_v;
    }
    p
}

fn alloc_ty3(arena: mut_view<Arena>, t0_v: u32, t1_v: u32, t2_v: u32) -> *mut TypeId {
    let p = arena_alloc_raw(arena, mir_mul_usize(3, size_of<TypeId>()), align_of<TypeId>()) as *mut TypeId;
    unsafe {
        (*typeid_at(p, 0)).v = t0_v;
        (*typeid_at(p, 1)).v = t1_v;
        (*typeid_at(p, 2)).v = t2_v;
    }
    p
}

// =================================================================================================
// MIR Construction Helpers
// =================================================================================================

fn new_test_body(arena: mut_view<Arena>) -> *mut MirBody {
    let body = mir_body_new(mut_view(*arena));
    let bbs = arena_alloc_raw(arena, mir_mul_usize(32, size_of<MirBb>()), align_of<MirBb>()) as *mut MirBb;
    unsafe {
        (*body).bbs = bbs;
        (*body).bb_cap = 32;
    }
    body
}

fn add_loc(body: mut_view<MirBody>, arena: mut_view<Arena>, ty_v: u32, kind: u8) -> u32 {
    let sp = qa_zero_span();
    let id = mir_add_local(body, arena, TypeId { v: ty_v }, kind, true, StrId { v: 0u32 }, view(sp));
    id.v
}

fn add_bb_ptr(body: mut_view<MirBody>, arena: mut_view<Arena>) -> *mut MirBb {
    let id = mir_add_bb(mut_view(*body), arena, false);
    unsafe { mir_bb_at(body.bbs, id.v as usize) }
}

fn op_const_int(ar: *mut Arena, ty_v: u32, val: u64) -> *mut MirOperand {
    let op = arena_alloc_raw(unsafe { mut_view(*ar) }, size_of<MirOperand>(), align_of<MirOperand>()) as *mut MirOperand;
    unsafe {
        mir_operand_zero(mut_view(*op), MIR_OP_CONST);
        (*op).constant.ty = TypeId { v: ty_v };
        (*op).constant.kind = MIR_CONST_INT;
        (*op).constant.val = val;
    }
    op
}

fn op_copy_local(ar: *mut Arena, loc: u32) -> *mut MirOperand {
    let op = arena_alloc_raw(unsafe { mut_view(*ar) }, size_of<MirOperand>(), align_of<MirOperand>()) as *mut MirOperand;
    unsafe {
        mir_operand_zero(mut_view(*op), MIR_OP_COPY);
        (*op).place = mir_local_place(loc);
    }
    op
}

fn op_fn_sym(ar: *mut Arena, fn_ty_v: u32, sym_v: u32) -> *mut MirOperand {
    let op = arena_alloc_raw(unsafe { mut_view(*ar) }, size_of<MirOperand>(), align_of<MirOperand>()) as *mut MirOperand;
    unsafe {
        mir_operand_zero(mut_view(*op), MIR_OP_CONST);
        (*op).constant.ty = TypeId { v: fn_ty_v };
        (*op).constant.kind = MIR_CONST_FN;
        (*op).constant.val = sym_v as u64;
        (*op).constant.sym = SymbolId { v: sym_v };
    }
    op
}

fn op_builtin(ar: *mut Arena, builtin_ty_v: u32, type_arg_v: u32) -> *mut MirOperand {
    let op = arena_alloc_raw(unsafe { mut_view(*ar) }, size_of<MirOperand>(), align_of<MirOperand>()) as *mut MirOperand;
    unsafe {
        mir_operand_zero(mut_view(*op), MIR_OP_CONST);
        (*op).constant.ty = TypeId { v: builtin_ty_v };
        (*op).constant.kind = MIR_CONST_INT;
        (*op).constant.val = type_arg_v as u64;
    }
    op
}

fn op_const_str(ar: *mut Arena, str_ty_v: u32, bytes: *const u8, byte_len: usize) -> *mut MirOperand {
    let op = arena_alloc_raw(unsafe { mut_view(*ar) }, size_of<MirOperand>(), align_of<MirOperand>()) as *mut MirOperand;
    unsafe {
        mir_operand_zero(mut_view(*op), MIR_OP_CONST);
        (*op).constant.ty = TypeId { v: str_ty_v };
        (*op).constant.kind = MIR_CONST_STR;
        (*op).constant.str_bytes = bytes;
        (*op).constant.str_len = byte_len;
    }
    op
}

fn op_place(ar: *mut Arena, place: MirPlace) -> *mut MirOperand {
    let op = arena_alloc_raw(unsafe { mut_view(*ar) }, size_of<MirOperand>(), align_of<MirOperand>()) as *mut MirOperand;
    unsafe {
        mir_operand_zero(mut_view(*op), MIR_OP_COPY);
        mir_copy_place(mut_view((*op).place), view(place));
    }
    op
}

fn set_arg_op(args: *mut MirOperand, idx: usize, op: *mut MirOperand) {
    unsafe {
        let dst = mir_op_at(args, idx);
        mir_copy_operand(mut_view(*dst), view(*op));
    }
}

fn place_field(arena: mut_view<Arena>, base: MirPlace, f_idx: u32) -> MirPlace {
    let proj = MirProjection {
        kind: MIR_PROJ_FIELD,
        field_idx: f_idx,
        index_local: MirLocalId { v: 0u32 },
        from_local: MirLocalId { v: 0u32 },
        to_local: MirLocalId { v: 0u32 },
        has_from: false,
        has_to: false,
        variant_idx: 0u32,
    };
    let mut dst = mir_local_place(0u32);
    mir_place_append_proj(arena, view(base), view(proj), mut_view(dst));
    dst
}

fn place_downcast_field(arena: mut_view<Arena>, base: MirPlace, v_idx: u32, f_idx: u32) -> MirPlace {
    let p_down = MirProjection {
        kind: MIR_PROJ_DOWNCAST,
        field_idx: 0u32,
        index_local: MirLocalId { v: 0u32 },
        from_local: MirLocalId { v: 0u32 },
        to_local: MirLocalId { v: 0u32 },
        has_from: false,
        has_to: false,
        variant_idx: v_idx,
    };
    let mut mid = mir_local_place(0u32);
    mir_place_append_proj(mut_view(*arena), view(base), view(p_down), mut_view(mid));
    place_field(arena, mid, f_idx)
}

fn place_index(arena: mut_view<Arena>, base: MirPlace, idx_loc: u32) -> MirPlace {
    let proj = MirProjection {
        kind: MIR_PROJ_INDEX,
        field_idx: 0u32,
        index_local: MirLocalId { v: idx_loc },
        from_local: MirLocalId { v: 0u32 },
        to_local: MirLocalId { v: 0u32 },
        has_from: false,
        has_to: false,
        variant_idx: 0u32,
    };
    let mut dst = mir_local_place(0u32);
    mir_place_append_proj(arena, view(base), view(proj), mut_view(dst));
    dst
}

fn place_deref(arena: mut_view<Arena>, base: MirPlace) -> MirPlace {
    let proj = MirProjection {
        kind: MIR_PROJ_DEREF,
        field_idx: 0u32,
        index_local: MirLocalId { v: 0u32 },
        from_local: MirLocalId { v: 0u32 },
        to_local: MirLocalId { v: 0u32 },
        has_from: false,
        has_to: false,
        variant_idx: 0u32,
    };
    let mut dst = mir_local_place(0u32);
    mir_place_append_proj(arena, view(base), view(proj), mut_view(dst));
    dst
}

fn emit_use(bb: *mut MirBb, arena: mut_view<Arena>, dst: MirPlace, op: *mut MirOperand) {
    let stmt = arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt;
    unsafe {
        mir_stmt_zero(mut_view(*stmt), MIR_STMT_ASSIGN);
        mir_copy_place(mut_view((*stmt).place), view(dst));
        (*stmt).rvalue.kind = MIR_RVALUE_USE;
        mir_copy_operand(mut_view((*stmt).rvalue.use_op), view(*op));
        mir_bb_push_stmt(mut_view(*bb), arena, view(*stmt));
    }
}

fn emit_binop(
    bb: *mut MirBb,
    arena: mut_view<Arena>,
    dst: MirPlace,
    rv_kind: u8,
    bin_op: u8,
    lhs: *mut MirOperand,
    rhs: *mut MirOperand
) {
    let stmt = arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt;
    unsafe {
        mir_stmt_zero(mut_view(*stmt), MIR_STMT_ASSIGN);
        mir_copy_place(mut_view((*stmt).place), view(dst));
        (*stmt).rvalue.kind = rv_kind;
        (*stmt).rvalue.bin_op = bin_op;
        mir_copy_operand(mut_view((*stmt).rvalue.lhs), view(*lhs));
        mir_copy_operand(mut_view((*stmt).rvalue.rhs), view(*rhs));
        mir_bb_push_stmt(mut_view(*bb), arena, view(*stmt));
    }
}

fn emit_unop(bb: *mut MirBb, arena: mut_view<Arena>, dst: MirPlace, un_op: u8, op: *mut MirOperand) {
    let stmt = arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt;
    unsafe {
        mir_stmt_zero(mut_view(*stmt), MIR_STMT_ASSIGN);
        mir_copy_place(mut_view((*stmt).place), view(dst));
        (*stmt).rvalue.kind = MIR_RVALUE_UNARY_OP;
        (*stmt).rvalue.un_op = un_op;
        mir_copy_operand(mut_view((*stmt).rvalue.use_op), view(*op));
        mir_bb_push_stmt(mut_view(*bb), arena, view(*stmt));
    }
}

fn emit_cast(
    bb: *mut MirBb,
    arena: mut_view<Arena>,
    dst: MirPlace,
    cast_kind: u8,
    op: *mut MirOperand,
    target_ty_v: u32
) {
    let stmt = arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt;
    unsafe {
        mir_stmt_zero(mut_view(*stmt), MIR_STMT_ASSIGN);
        mir_copy_place(mut_view((*stmt).place), view(dst));
        (*stmt).rvalue.kind = MIR_RVALUE_CAST;
        (*stmt).rvalue.cast_kind = cast_kind;
        (*stmt).rvalue.target_ty = TypeId { v: target_ty_v };
        mir_copy_operand(mut_view((*stmt).rvalue.use_op), view(*op));
        mir_bb_push_stmt(mut_view(*bb), arena, view(*stmt));
    }
}

fn emit_ref(bb: *mut MirBb, arena: mut_view<Arena>, dst: MirPlace, borrow_kind: u8, src: MirPlace) {
    let stmt = arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt;
    unsafe {
        mir_stmt_zero(mut_view(*stmt), MIR_STMT_ASSIGN);
        mir_copy_place(mut_view((*stmt).place), view(dst));
        (*stmt).rvalue.kind = MIR_RVALUE_REF;
        (*stmt).rvalue.borrow_kind = borrow_kind;
        mir_copy_place(mut_view((*stmt).rvalue.place), view(src));
        mir_bb_push_stmt(mut_view(*bb), arena, view(*stmt));
    }
}

fn emit_agg2(
    bb: *mut MirBb,
    arena: mut_view<Arena>,
    dst: MirPlace,
    variant_idx: u32,
    op0: *mut MirOperand,
    op1: *mut MirOperand
) {
    let ops = arena_alloc_raw(mut_view(*arena), mir_mul_usize(2, size_of<MirOperand>()), align_of<MirOperand>()) as *mut MirOperand;
    let stmt = arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt;
    unsafe {
        let p0 = mir_op_at(ops, 0);
        let p1 = mir_op_at(ops, 1);
        mir_copy_operand(mut_view(*p0), view(*op0));
        mir_copy_operand(mut_view(*p1), view(*op1));
        mir_stmt_zero(mut_view(*stmt), MIR_STMT_ASSIGN);
        mir_copy_place(mut_view((*stmt).place), view(dst));
        (*stmt).rvalue.kind = MIR_RVALUE_AGGREGATE;
        (*stmt).rvalue.variant_idx = variant_idx;
        (*stmt).rvalue.operands = ops;
        (*stmt).rvalue.operand_count = 2;
        mir_bb_push_stmt(mut_view(*bb), arena, view(*stmt));
    }
}

fn emit_repeat(bb: *mut MirBb, arena: mut_view<Arena>, dst: MirPlace, op: *mut MirOperand, count: u64) {
    let stmt = arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt;
    unsafe {
        mir_stmt_zero(mut_view(*stmt), MIR_STMT_ASSIGN);
        mir_copy_place(mut_view((*stmt).place), view(dst));
        (*stmt).rvalue.kind = MIR_RVALUE_REPEAT;
        (*stmt).rvalue.repeat_count = count;
        mir_copy_operand(mut_view((*stmt).rvalue.use_op), view(*op));
        mir_bb_push_stmt(mut_view(*bb), arena, view(*stmt));
    }
}

fn emit_discr(bb: *mut MirBb, arena: mut_view<Arena>, dst: MirPlace, src: MirPlace) {
    let stmt = arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt;
    unsafe {
        mir_stmt_zero(mut_view(*stmt), MIR_STMT_ASSIGN);
        mir_copy_place(mut_view((*stmt).place), view(dst));
        (*stmt).rvalue.kind = MIR_RVALUE_DISCRIMINANT;
        mir_copy_place(mut_view((*stmt).rvalue.place), view(src));
        mir_bb_push_stmt(mut_view(*bb), arena, view(*stmt));
    }
}

fn emit_len(bb: *mut MirBb, arena: mut_view<Arena>, dst: MirPlace, src: MirPlace) {
    let stmt = arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt;
    unsafe {
        mir_stmt_zero(mut_view(*stmt), MIR_STMT_ASSIGN);
        mir_copy_place(mut_view((*stmt).place), view(dst));
        (*stmt).rvalue.kind = MIR_RVALUE_LEN;
        mir_copy_place(mut_view((*stmt).rvalue.place), view(src));
        mir_bb_push_stmt(mut_view(*bb), arena, view(*stmt));
    }
}

fn term_return(bb: *mut MirBb, arena: mut_view<Arena>) {
    let term = arena_alloc_raw(arena, size_of<MirTerminator>(), align_of<MirTerminator>()) as *mut MirTerminator;
    unsafe {
        mir_term_zero(mut_view(*term), MIR_TERM_RETURN);
        mir_bb_set_terminator(mut_view(*bb), view(*term));
    }
}

fn term_goto(bb: *mut MirBb, arena: mut_view<Arena>, target_bb: u32) {
    let term = arena_alloc_raw(arena, size_of<MirTerminator>(), align_of<MirTerminator>()) as *mut MirTerminator;
    unsafe {
        mir_term_zero(mut_view(*term), MIR_TERM_GOTO);
        (*term).goto_target.v = target_bb;
        mir_bb_set_terminator(mut_view(*bb), view(*term));
    }
}

fn term_assert(bb: *mut MirBb, arena: mut_view<Arena>, cond: *mut MirOperand, expected: bool, target_bb: u32) {
    let term = arena_alloc_raw(arena, size_of<MirTerminator>(), align_of<MirTerminator>()) as *mut MirTerminator;
    unsafe {
        mir_term_zero(mut_view(*term), MIR_TERM_ASSERT);
        mir_copy_operand(mut_view((*term).cond), view(*cond));
        (*term).expected = expected;
        (*term).assert_target.v = target_bb;
        mir_bb_set_terminator(mut_view(*bb), view(*term));
    }
}

fn term_switch1(
    bb: *mut MirBb,
    arena: mut_view<Arena>,
    discr: *mut MirOperand,
    val0: u64,
    target0: u32,
    otherwise_bb: u32
) {
    let vals = arena_alloc_raw(mut_view(*arena), size_of<u64>(), align_of<u64>()) as *mut u64;
    let tgts = arena_alloc_raw(mut_view(*arena), size_of<MirBbId>(), align_of<MirBbId>()) as *mut MirBbId;
    let term = arena_alloc_raw(arena, size_of<MirTerminator>(), align_of<MirTerminator>()) as *mut MirTerminator;
    unsafe {
        *vals = val0;
        (*tgts).v = target0;
        mir_term_zero(mut_view(*term), MIR_TERM_SWITCH_INT);
        mir_copy_operand(mut_view((*term).discr), view(*discr));
        (*term).values = vals;
        (*term).targets = tgts;
        (*term).switch_count = 1;
        (*term).otherwise.v = otherwise_bb;
        mir_bb_set_terminator(mut_view(*bb), view(*term));
    }
}

fn term_call(
    bb: *mut MirBb,
    arena: mut_view<Arena>,
    func_op: *mut MirOperand,
    args: *mut MirOperand,
    arg_count: usize,
    dst: MirPlace,
    has_dst: bool,
    target_bb: u32
) {
    let term = arena_alloc_raw(arena, size_of<MirTerminator>(), align_of<MirTerminator>()) as *mut MirTerminator;
    unsafe {
        mir_term_zero(mut_view(*term), MIR_TERM_CALL);
        mir_copy_operand(mut_view((*term).func), view(*func_op));
        (*term).args = args;
        (*term).arg_count = arg_count;
        mir_copy_place(mut_view((*term).destination), view(dst));
        (*term).has_destination = has_dst;
        (*term).call_target.v = target_bb;
        mir_bb_set_terminator(mut_view(*bb), view(*term));
    }
}

const TEST_NAMES_A: [80]u8 = [
    // 0..4: "main"
    109u8, 97u8, 105u8, 110u8,
    // 4..13: "intrinsic"
    105u8, 110u8, 116u8, 114u8, 105u8, 110u8, 115u8, 105u8, 99u8,
    // 13..16: "fib"
    102u8, 105u8, 98u8,
    // 16..28: "wrapping_add"
    119u8, 114u8, 97u8, 112u8, 112u8, 105u8, 110u8, 103u8, 95u8, 97u8, 100u8, 100u8,
    // 28..39: "rotate_left"
    114u8, 111u8, 116u8, 97u8, 116u8, 101u8, 95u8, 108u8, 101u8, 102u8, 116u8,
    // 39..49: "count_ones"
    99u8, 111u8, 117u8, 110u8, 116u8, 95u8, 111u8, 110u8, 101u8, 115u8,
    // 49..59: "heap_alloc"
    104u8, 101u8, 97u8, 112u8, 95u8, 97u8, 108u8, 108u8, 111u8, 99u8,
    // 59..68: "heap_free"
    104u8, 101u8, 97u8, 112u8, 95u8, 102u8, 114u8, 101u8, 101u8,
    // 68..80: "monotonic_ns"
    109u8, 111u8, 110u8, 111u8, 116u8, 111u8, 110u8, 105u8, 99u8, 95u8, 110u8, 115u8,
];

fn intern_test_name(
    arena: mut_view<Arena>,
    str_in: mut_view<StrInterner>,
    off: usize,
    n: usize
) -> StrId {
    let dst = arena_alloc_raw(arena, n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe {
            *(dst + i) = TEST_NAMES_A[off + i];
        }
        i = i + 1;
    }
    unsafe {
        *(dst + n) = 0u8;
    }
    interner_intern_bytes(str_in, dst as *const u8, n)
}

fn make_fn_item(
    arena: mut_view<Arena>,
    str_in: mut_view<StrInterner>,
    thir: mut_view<Thir>,
    name_off: usize,
    name_len: usize,
    sym_v: u32,
    param_tys: *mut TypeId,
    param_count: usize,
    ret_ty_v: u32,
    is_intrinsic: bool
) -> *mut HirItem {
    let fn_item = hir_alloc_item(mut_view(*arena), HIR_ITEM_FN, qa_zero_span());
    let name_id = intern_test_name(mut_view(*arena), mut_view(*str_in), name_off, name_len);
    unsafe {
        (*fn_item).name = StrId { v: name_id.v };
        (*fn_item).symbol = SymbolId { v: sym_v };
    }
    if is_intrinsic {
        let attr: *mut HirAttr = hir_alloc_attr(mut_view(*arena), qa_zero_span());
        let intr_id = intern_test_name(mut_view(*arena), mut_view(*str_in), 4, 9);
        unsafe {
            (*attr).name = StrId { v: intr_id.v };
            (*fn_item).attrs = attr;
        }
    }
    let mut head: *mut HirParam = 0 as *mut HirParam;
    let mut tail: *mut HirParam = 0 as *mut HirParam;
    let mut i: usize = 0;
    while i < param_count {
        let p = hir_alloc_param(mut_view(*arena), qa_zero_span());
        let pty_v = unsafe { (*typeid_at(param_tys, i)).v };
        let psym = sym_v * 10u32 + (i as u32) + 1u32;
        unsafe {
            (*p).symbol = SymbolId { v: psym };
        }
        thir_set_param_type(mut_view(*thir), p as *const HirParam, TypeId { v: pty_v });
        thir_set_sym_type(mut_view(*thir), SymbolId { v: psym }, TypeId { v: pty_v });
        if (head as usize) == 0 {
            head = p;
            tail = p;
        } else {
            unsafe {
                (*tail).next = p;
            }
            tail = p;
        }
        i = i + 1;
    }
    unsafe {
        (*fn_item).params = head;
    }
    let fn_ty = intern_fn_ty(mut_view(thir.interner), false, StrId { v: 0u32 }, param_tys, param_count, TypeId { v: ret_ty_v });
    thir_set_item_type(mut_view(*thir), fn_item as *const HirItem, TypeId { v: fn_ty.v });
    thir_set_sym_type(mut_view(*thir), SymbolId { v: sym_v }, TypeId { v: fn_ty.v });
    fn_item
}

// =================================================================================================
// 1. Arithmetic, Bitwise, Casts, Overflow Checks & Control Flow
// =================================================================================================

fn test_arith_bitwise_casts_and_control_flow() {
    let ar = alloc_init_arena();
    let str_in = alloc_init_interner();
    let thir_ptr = alloc_init_thir();

    let t_i32 = unsafe { (*thir_ptr).interner.t_i32.v };
    let t_i8 = unsafe { (*thir_ptr).interner.t_i8.v };
    let t_u8 = unsafe { (*thir_ptr).interner.t_u8.v };
    let t_bool = unsafe { (*thir_ptr).interner.t_bool.v };

    let main_item = make_fn_item(
        unsafe { mut_view(*ar) },
        unsafe { mut_view(*str_in) },
        unsafe { mut_view(*thir_ptr) },
        0,
        4,
        100u32,
        0 as *mut TypeId,
        0,
        t_i32,
        false
    );
    let hir = HirFile { items: main_item };

    let body = new_test_body(unsafe { mut_view(*ar) });
    let l_ret = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_i32, MIR_LOCAL_RETURN);
    let l_a = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_i32, MIR_LOCAL_USER);
    let l_b = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_i32, MIR_LOCAL_USER);
    let l_ovf0 = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_bool, MIR_LOCAL_TEMP);
    let l_ovf1 = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_bool, MIR_LOCAL_TEMP);
    let l_neg = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_i8, MIR_LOCAL_TEMP);
    let l_cast = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_i32, MIR_LOCAL_TEMP);
    let l_bnot = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_u8, MIR_LOCAL_TEMP);
    let l_not = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_bool, MIR_LOCAL_TEMP);
    let l_i = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_i32, MIR_LOCAL_USER);
    let l_acc = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_i32, MIR_LOCAL_USER);
    let l_cond = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_bool, MIR_LOCAL_TEMP);

    let bb0 = add_bb_ptr(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) });
    let bb_loop = add_bb_ptr(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) });
    let bb_body = add_bb_ptr(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) });
    let bb_done = add_bb_ptr(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) });

    // bb0: arithmetic, bitwise, unary, cast, overflow checks, assert -> bb_loop
    emit_binop(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_a), MIR_RVALUE_BINARY_OP, MIR_BINOP_ADD, op_const_int(ar, t_i32, 20u64), op_const_int(ar, t_i32, 7u64));
    emit_binop(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_b), MIR_RVALUE_BINARY_OP, MIR_BINOP_DIV, op_copy_local(ar, l_a), op_const_int(ar, t_i32, 3u64));
    emit_binop(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_a), MIR_RVALUE_BINARY_OP, MIR_BINOP_MUL, op_copy_local(ar, l_b), op_const_int(ar, t_i32, 5u64));
    emit_binop(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_b), MIR_RVALUE_BINARY_OP, MIR_BINOP_REM, op_copy_local(ar, l_a), op_const_int(ar, t_i32, 7u64));
    emit_binop(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_a), MIR_RVALUE_BINARY_OP, MIR_BINOP_SUB, op_copy_local(ar, l_a), op_copy_local(ar, l_b));
    emit_binop(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_a), MIR_RVALUE_BINARY_OP, MIR_BINOP_SHL, op_copy_local(ar, l_a), op_const_int(ar, t_i32, 1u64));
    emit_binop(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_a), MIR_RVALUE_BINARY_OP, MIR_BINOP_SHR, op_copy_local(ar, l_a), op_const_int(ar, t_i32, 1u64));
    emit_binop(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_b), MIR_RVALUE_BINARY_OP, MIR_BINOP_BIT_AND, op_copy_local(ar, l_a), op_const_int(ar, t_i32, 7u64));
    emit_binop(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_b), MIR_RVALUE_BINARY_OP, MIR_BINOP_BIT_OR, op_copy_local(ar, l_b), op_const_int(ar, t_i32, 1u64));
    emit_binop(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_b), MIR_RVALUE_BINARY_OP, MIR_BINOP_BIT_XOR, op_copy_local(ar, l_b), op_const_int(ar, t_i32, 1u64));

    // Overflow checks on i8
    emit_binop(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_ovf0), MIR_RVALUE_OVERFLOWS_BINARY_OP, MIR_BINOP_ADD, op_const_int(ar, t_i8, 100u64), op_const_int(ar, t_i8, 20u64));
    emit_binop(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_ovf1), MIR_RVALUE_OVERFLOWS_BINARY_OP, MIR_BINOP_ADD, op_const_int(ar, t_i8, 120u64), op_const_int(ar, t_i8, 20u64));

    // Unary ops & sign-extending cast: -5i8 as i32
    emit_unop(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_neg), MIR_UNOP_NEG, op_const_int(ar, t_i8, 5u64));
    emit_cast(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_cast), MIR_CAST_INT_TO_INT, op_copy_local(ar, l_neg), t_i32);
    emit_unop(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_bnot), MIR_UNOP_BITNOT, op_const_int(ar, t_u8, 0u64));
    emit_unop(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_not), MIR_UNOP_NOT, op_copy_local(ar, l_ovf0));

    // Initialize loop: i = 0, acc = 0
    emit_use(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_i), op_const_int(ar, t_i32, 0u64));
    emit_use(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_acc), op_const_int(ar, t_i32, 0u64));
    term_assert(bb0, unsafe { mut_view(*ar) }, op_copy_local(ar, l_ovf1), true, 1u32);

    // bb_loop (id 1): if i < 4 goto bb_body (2) else bb_done (3)
    emit_binop(bb_loop, unsafe { mut_view(*ar) }, mir_local_place(l_cond), MIR_RVALUE_BINARY_OP, MIR_BINOP_LT, op_copy_local(ar, l_i), op_const_int(ar, t_i32, 4u64));
    term_switch1(bb_loop, unsafe { mut_view(*ar) }, op_copy_local(ar, l_cond), 0u64, 3u32, 2u32);

    // bb_body (id 2): i = i + 1; acc = acc + i; goto bb_loop (1)
    emit_binop(bb_body, unsafe { mut_view(*ar) }, mir_local_place(l_i), MIR_RVALUE_BINARY_OP, MIR_BINOP_ADD, op_copy_local(ar, l_i), op_const_int(ar, t_i32, 1u64));
    emit_binop(bb_body, unsafe { mut_view(*ar) }, mir_local_place(l_acc), MIR_RVALUE_BINARY_OP, MIR_BINOP_ADD, op_copy_local(ar, l_acc), op_copy_local(ar, l_i));
    term_goto(bb_body, unsafe { mut_view(*ar) }, 1u32);

    // bb_done (id 3): ret = a (42) + acc (10) + cast (-5) - 5 = 42
    emit_binop(bb_done, unsafe { mut_view(*ar) }, mir_local_place(l_ret), MIR_RVALUE_BINARY_OP, MIR_BINOP_ADD, op_copy_local(ar, l_a), op_copy_local(ar, l_acc));
    emit_binop(bb_done, unsafe { mut_view(*ar) }, mir_local_place(l_ret), MIR_RVALUE_BINARY_OP, MIR_BINOP_ADD, op_copy_local(ar, l_ret), op_copy_local(ar, l_cast));
    emit_binop(bb_done, unsafe { mut_view(*ar) }, mir_local_place(l_ret), MIR_RVALUE_BINARY_OP, MIR_BINOP_SUB, op_copy_local(ar, l_ret), op_const_int(ar, t_i32, 5u64));
    // Also exercise EQ, NE, LE, GT, GE comparisons
    emit_binop(bb_done, unsafe { mut_view(*ar) }, mir_local_place(l_cond), MIR_RVALUE_BINARY_OP, MIR_BINOP_EQ, op_copy_local(ar, l_ret), op_copy_local(ar, l_a));
    emit_binop(bb_done, unsafe { mut_view(*ar) }, mir_local_place(l_cond), MIR_RVALUE_BINARY_OP, MIR_BINOP_NE, op_copy_local(ar, l_ret), op_const_int(ar, t_i32, 0u64));
    emit_binop(bb_done, unsafe { mut_view(*ar) }, mir_local_place(l_cond), MIR_RVALUE_BINARY_OP, MIR_BINOP_LE, op_copy_local(ar, l_ret), op_copy_local(ar, l_a));
    emit_binop(bb_done, unsafe { mut_view(*ar) }, mir_local_place(l_cond), MIR_RVALUE_BINARY_OP, MIR_BINOP_GT, op_copy_local(ar, l_ret), op_const_int(ar, t_i32, 0u64));
    emit_binop(bb_done, unsafe { mut_view(*ar) }, mir_local_place(l_cond), MIR_RVALUE_BINARY_OP, MIR_BINOP_GE, op_copy_local(ar, l_ret), op_copy_local(ar, l_a));
    term_return(bb_done, unsafe { mut_view(*ar) });

    let mut mir_map = MirBodyMap {
        entries: 0 as *mut MirBodyEntry,
        len: 0,
        cap: 0,
    };
    mir_body_map_init(mut_view(mir_map));
    mir_body_map_insert(mut_view(mir_map), main_item as *const HirItem, 100u32, body);

    let sink_ptr = alloc_init_sink();
    let mut out_buf = diag_buf_new();
    let mut panic_sv = StrView { ptr: 0 as *const u8, len: 0 };

    let code = run_test_interp(
        main_item,
        thir_ptr,
        view(hir),
        str_in,
        sink_ptr,
        100000,
        64,
        map_mut_ptr(mut_view(mir_map)),
        mut_view(out_buf),
        mut_view(panic_sv)
    );

    qa_check(code == 42);
    qa_check(panic_sv.len == 0);
    qa_check(unsafe { (*sink_ptr).errors == 0 });

    free_panic_sv(mut_view(panic_sv));
    diag_buf_free(mut_view(out_buf));
    free_dealloc_sink(sink_ptr);
    mir_body_map_free(mut_view(mir_map));
    free_dealloc_thir(thir_ptr);
    free_dealloc_interner(str_in);
    free_dealloc_arena(ar);
}

// =================================================================================================
// 2. Multi-Function Calls, Recursion (fib) & Core Intrinsics
// =================================================================================================

fn test_calls_recursion_and_core_intrinsics() {
    let ar = alloc_init_arena();
    let str_in = alloc_init_interner();
    let thir_ptr = alloc_init_thir();

    let t_i32 = unsafe { (*thir_ptr).interner.t_i32.v };
    let t_u32 = unsafe { (*thir_ptr).interner.t_u32.v };
    let t_bool = unsafe { (*thir_ptr).interner.t_bool.v };

    let p_i32 = alloc_ty1(unsafe { mut_view(*ar) }, t_i32);
    let p_u32_2 = alloc_ty2(unsafe { mut_view(*ar) }, t_u32, t_u32);
    let p_u32_1 = alloc_ty1(unsafe { mut_view(*ar) }, t_u32);

    let fn_fib = make_fn_item(
        unsafe { mut_view(*ar) },
        unsafe { mut_view(*str_in) },
        unsafe { mut_view(*thir_ptr) },
        13,
        3,
        101u32,
        p_i32,
        1,
        t_i32,
        false
    );
    let fn_wadd = make_fn_item(
        unsafe { mut_view(*ar) },
        unsafe { mut_view(*str_in) },
        unsafe { mut_view(*thir_ptr) },
        16,
        12,
        102u32,
        p_u32_2,
        2,
        t_u32,
        true
    );
    let fn_rotl = make_fn_item(
        unsafe { mut_view(*ar) },
        unsafe { mut_view(*str_in) },
        unsafe { mut_view(*thir_ptr) },
        28,
        11,
        103u32,
        p_u32_2,
        2,
        t_u32,
        true
    );
    let fn_ones = make_fn_item(
        unsafe { mut_view(*ar) },
        unsafe { mut_view(*str_in) },
        unsafe { mut_view(*thir_ptr) },
        39,
        10,
        104u32,
        p_u32_1,
        1,
        t_u32,
        true
    );
    let fn_main = make_fn_item(
        unsafe { mut_view(*ar) },
        unsafe { mut_view(*str_in) },
        unsafe { mut_view(*thir_ptr) },
        0,
        4,
        100u32,
        0 as *mut TypeId,
        0,
        t_i32,
        false
    );
    unsafe {
        (*fn_main).next = fn_fib;
        (*fn_fib).next = fn_wadd;
        (*fn_wadd).next = fn_rotl;
        (*fn_rotl).next = fn_ones;
    }
    let hir = HirFile { items: fn_main };

    let ty_fn_fib = intern_fn_ty(unsafe { mut_view((*thir_ptr).interner) }, false, StrId { v: 0u32 }, p_i32, 1, TypeId { v: t_i32 }).v;
    let ty_fn_u32_2 = intern_fn_ty(unsafe { mut_view((*thir_ptr).interner) }, false, StrId { v: 0u32 }, p_u32_2, 2, TypeId { v: t_u32 }).v;
    let ty_fn_u32_1 = intern_fn_ty(unsafe { mut_view((*thir_ptr).interner) }, false, StrId { v: 0u32 }, p_u32_1, 1, TypeId { v: t_u32 }).v;

    // Build fib(n: i32) -> i32
    let b_fib = new_test_body(unsafe { mut_view(*ar) });
    let f_ret = add_loc(unsafe { mut_view(*b_fib) }, unsafe { mut_view(*ar) }, t_i32, MIR_LOCAL_RETURN);
    let f_n = add_loc(unsafe { mut_view(*b_fib) }, unsafe { mut_view(*ar) }, t_i32, MIR_LOCAL_ARG);
    let f_cond = add_loc(unsafe { mut_view(*b_fib) }, unsafe { mut_view(*ar) }, t_bool, MIR_LOCAL_TEMP);
    let f_nm1 = add_loc(unsafe { mut_view(*b_fib) }, unsafe { mut_view(*ar) }, t_i32, MIR_LOCAL_TEMP);
    let f_nm2 = add_loc(unsafe { mut_view(*b_fib) }, unsafe { mut_view(*ar) }, t_i32, MIR_LOCAL_TEMP);
    let f_r1 = add_loc(unsafe { mut_view(*b_fib) }, unsafe { mut_view(*ar) }, t_i32, MIR_LOCAL_TEMP);
    let f_r2 = add_loc(unsafe { mut_view(*b_fib) }, unsafe { mut_view(*ar) }, t_i32, MIR_LOCAL_TEMP);

    let f_bb0 = add_bb_ptr(unsafe { mut_view(*b_fib) }, unsafe { mut_view(*ar) });
    let f_bb_base = add_bb_ptr(unsafe { mut_view(*b_fib) }, unsafe { mut_view(*ar) });
    let f_bb_rec1 = add_bb_ptr(unsafe { mut_view(*b_fib) }, unsafe { mut_view(*ar) });
    let f_bb_rec2 = add_bb_ptr(unsafe { mut_view(*b_fib) }, unsafe { mut_view(*ar) });
    let f_bb_join = add_bb_ptr(unsafe { mut_view(*b_fib) }, unsafe { mut_view(*ar) });

    emit_binop(f_bb0, unsafe { mut_view(*ar) }, mir_local_place(f_cond), MIR_RVALUE_BINARY_OP, MIR_BINOP_LE, op_copy_local(ar, f_n), op_const_int(ar, t_i32, 1u64));
    term_switch1(f_bb0, unsafe { mut_view(*ar) }, op_copy_local(ar, f_cond), 0u64, 2u32, 1u32);

    // f_bb_base (1): ret = n; return
    emit_use(f_bb_base, unsafe { mut_view(*ar) }, mir_local_place(f_ret), op_copy_local(ar, f_n));
    term_return(f_bb_base, unsafe { mut_view(*ar) });

    // f_bb_rec1 (2): nm1 = n - 1; r1 = fib(nm1) -> f_bb_rec2 (3)
    emit_binop(f_bb_rec1, unsafe { mut_view(*ar) }, mir_local_place(f_nm1), MIR_RVALUE_BINARY_OP, MIR_BINOP_SUB, op_copy_local(ar, f_n), op_const_int(ar, t_i32, 1u64));
    let args1 = arena_alloc_raw(unsafe { mut_view(*ar) }, size_of<MirOperand>(), align_of<MirOperand>()) as *mut MirOperand;
    set_arg_op(args1, 0, op_copy_local(ar, f_nm1));
    term_call(f_bb_rec1, unsafe { mut_view(*ar) }, op_fn_sym(ar, ty_fn_fib, 101u32), args1, 1, mir_local_place(f_r1), true, 3u32);

    // f_bb_rec2 (3): nm2 = n - 2; r2 = fib(nm2) -> f_bb_join (4)
    emit_binop(f_bb_rec2, unsafe { mut_view(*ar) }, mir_local_place(f_nm2), MIR_RVALUE_BINARY_OP, MIR_BINOP_SUB, op_copy_local(ar, f_n), op_const_int(ar, t_i32, 2u64));
    let args2 = arena_alloc_raw(unsafe { mut_view(*ar) }, size_of<MirOperand>(), align_of<MirOperand>()) as *mut MirOperand;
    set_arg_op(args2, 0, op_copy_local(ar, f_nm2));
    term_call(f_bb_rec2, unsafe { mut_view(*ar) }, op_fn_sym(ar, ty_fn_fib, 101u32), args2, 1, mir_local_place(f_r2), true, 4u32);

    // f_bb_join (4): ret = r1 + r2; return
    emit_binop(f_bb_join, unsafe { mut_view(*ar) }, mir_local_place(f_ret), MIR_RVALUE_BINARY_OP, MIR_BINOP_ADD, op_copy_local(ar, f_r1), op_copy_local(ar, f_r2));
    term_return(f_bb_join, unsafe { mut_view(*ar) });

    // Build main() -> i32
    let b_main = new_test_body(unsafe { mut_view(*ar) });
    let m_ret = add_loc(unsafe { mut_view(*b_main) }, unsafe { mut_view(*ar) }, t_i32, MIR_LOCAL_RETURN);
    let m_f6 = add_loc(unsafe { mut_view(*b_main) }, unsafe { mut_view(*ar) }, t_i32, MIR_LOCAL_USER);
    let m_w = add_loc(unsafe { mut_view(*b_main) }, unsafe { mut_view(*ar) }, t_u32, MIR_LOCAL_USER);
    let m_r = add_loc(unsafe { mut_view(*b_main) }, unsafe { mut_view(*ar) }, t_u32, MIR_LOCAL_USER);
    let m_c = add_loc(unsafe { mut_view(*b_main) }, unsafe { mut_view(*ar) }, t_u32, MIR_LOCAL_USER);
    let m_wi = add_loc(unsafe { mut_view(*b_main) }, unsafe { mut_view(*ar) }, t_i32, MIR_LOCAL_TEMP);
    let m_ri = add_loc(unsafe { mut_view(*b_main) }, unsafe { mut_view(*ar) }, t_i32, MIR_LOCAL_TEMP);
    let m_ci = add_loc(unsafe { mut_view(*b_main) }, unsafe { mut_view(*ar) }, t_i32, MIR_LOCAL_TEMP);

    let m_bb0 = add_bb_ptr(unsafe { mut_view(*b_main) }, unsafe { mut_view(*ar) });
    let m_bb1 = add_bb_ptr(unsafe { mut_view(*b_main) }, unsafe { mut_view(*ar) });
    let m_bb2 = add_bb_ptr(unsafe { mut_view(*b_main) }, unsafe { mut_view(*ar) });
    let m_bb3 = add_bb_ptr(unsafe { mut_view(*b_main) }, unsafe { mut_view(*ar) });
    let m_bb4 = add_bb_ptr(unsafe { mut_view(*b_main) }, unsafe { mut_view(*ar) });

    // m_bb0: f6 = fib(6) -> 8
    let m_args0 = arena_alloc_raw(unsafe { mut_view(*ar) }, size_of<MirOperand>(), align_of<MirOperand>()) as *mut MirOperand;
    set_arg_op(m_args0, 0, op_const_int(ar, t_i32, 6u64));
    term_call(m_bb0, unsafe { mut_view(*ar) }, op_fn_sym(ar, ty_fn_fib, 101u32), m_args0, 1, mir_local_place(m_f6), true, 1u32);

    // m_bb1: w = wrapping_add(0xFFFFFFFFu32, 5u32) -> 4
    let m_args1 = arena_alloc_raw(unsafe { mut_view(*ar) }, mir_mul_usize(2, size_of<MirOperand>()), align_of<MirOperand>()) as *mut MirOperand;
    set_arg_op(m_args1, 0, op_const_int(ar, t_u32, 0xFFFFFFFFu64));
    set_arg_op(m_args1, 1, op_const_int(ar, t_u32, 5u64));
    term_call(m_bb1, unsafe { mut_view(*ar) }, op_fn_sym(ar, ty_fn_u32_2, 102u32), m_args1, 2, mir_local_place(m_w), true, 2u32);

    // m_bb2: r = rotate_left(1u32, 3u32) -> 8
    let m_args2 = arena_alloc_raw(unsafe { mut_view(*ar) }, mir_mul_usize(2, size_of<MirOperand>()), align_of<MirOperand>()) as *mut MirOperand;
    set_arg_op(m_args2, 0, op_const_int(ar, t_u32, 1u64));
    set_arg_op(m_args2, 1, op_const_int(ar, t_u32, 3u64));
    term_call(m_bb2, unsafe { mut_view(*ar) }, op_fn_sym(ar, ty_fn_u32_2, 103u32), m_args2, 2, mir_local_place(m_r), true, 3u32);

    // m_bb3: c = count_ones(45u32) -> 4
    let m_args3 = arena_alloc_raw(unsafe { mut_view(*ar) }, size_of<MirOperand>(), align_of<MirOperand>()) as *mut MirOperand;
    set_arg_op(m_args3, 0, op_const_int(ar, t_u32, 45u64));
    term_call(m_bb3, unsafe { mut_view(*ar) }, op_fn_sym(ar, ty_fn_u32_1, 104u32), m_args3, 1, mir_local_place(m_c), true, 4u32);

    // m_bb4: ret = f6 + (w as i32) + (r as i32) + (c as i32) = 8 + 4 + 8 + 4 = 24
    emit_cast(m_bb4, unsafe { mut_view(*ar) }, mir_local_place(m_wi), MIR_CAST_INT_TO_INT, op_copy_local(ar, m_w), t_i32);
    emit_cast(m_bb4, unsafe { mut_view(*ar) }, mir_local_place(m_ri), MIR_CAST_INT_TO_INT, op_copy_local(ar, m_r), t_i32);
    emit_cast(m_bb4, unsafe { mut_view(*ar) }, mir_local_place(m_ci), MIR_CAST_INT_TO_INT, op_copy_local(ar, m_c), t_i32);
    emit_binop(m_bb4, unsafe { mut_view(*ar) }, mir_local_place(m_ret), MIR_RVALUE_BINARY_OP, MIR_BINOP_ADD, op_copy_local(ar, m_f6), op_copy_local(ar, m_wi));
    emit_binop(m_bb4, unsafe { mut_view(*ar) }, mir_local_place(m_ret), MIR_RVALUE_BINARY_OP, MIR_BINOP_ADD, op_copy_local(ar, m_ret), op_copy_local(ar, m_ri));
    emit_binop(m_bb4, unsafe { mut_view(*ar) }, mir_local_place(m_ret), MIR_RVALUE_BINARY_OP, MIR_BINOP_ADD, op_copy_local(ar, m_ret), op_copy_local(ar, m_ci));
    term_return(m_bb4, unsafe { mut_view(*ar) });

    let mut mir_map = MirBodyMap {
        entries: 0 as *mut MirBodyEntry,
        len: 0,
        cap: 0,
    };
    mir_body_map_init(mut_view(mir_map));
    mir_body_map_insert(mut_view(mir_map), fn_main as *const HirItem, 100u32, b_main);
    mir_body_map_insert(mut_view(mir_map), fn_fib as *const HirItem, 101u32, b_fib);

    let sink_ptr = alloc_init_sink();
    let mut out_buf = diag_buf_new();
    let mut panic_sv = StrView { ptr: 0 as *const u8, len: 0 };

    let code = run_test_interp(
        fn_main,
        thir_ptr,
        view(hir),
        str_in,
        sink_ptr,
        100000,
        64,
        map_mut_ptr(mut_view(mir_map)),
        mut_view(out_buf),
        mut_view(panic_sv)
    );

    qa_check(code == 24);
    qa_check(panic_sv.len == 0);
    qa_check(unsafe { (*sink_ptr).errors == 0 });

    free_panic_sv(mut_view(panic_sv));
    diag_buf_free(mut_view(out_buf));
    free_dealloc_sink(sink_ptr);
    mir_body_map_free(mut_view(mir_map));
    free_dealloc_thir(thir_ptr);
    free_dealloc_interner(str_in);
    free_dealloc_arena(ar);
}

// =================================================================================================
// 3. Aggregates (Tuple, Enum, Array), Projections (Field, Downcast, Index, Deref) & Views
// =================================================================================================

fn intern_shape_enum(ti: mut_view<TypeInterner>) -> u32 {
    let t_i32_v = ti.t_i32.v;
    let v0_fields = arena_alloc_raw(mut_view(ti.arena), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
    let v1_fields = arena_alloc_raw(mut_view(ti.arena), mir_mul_usize(2, size_of<TypeId>()), align_of<TypeId>()) as *mut TypeId;
    let vcounts = arena_alloc_raw(mut_view(ti.arena), mir_mul_usize(3, size_of<usize>()), align_of<usize>()) as *mut usize;
    let vfields = arena_alloc_raw(mut_view(ti.arena), mir_mul_usize(3, size_of<*mut TypeId>()), align_of<*mut TypeId>()) as *mut *mut TypeId;
    let ety = arena_alloc_raw(mut_view(ti.arena), size_of<AxType>(), align_of<AxType>()) as *mut AxType;
    unsafe {
        (*typeid_at(v0_fields, 0)).v = t_i32_v;
        (*typeid_at(v1_fields, 0)).v = t_i32_v;
        (*typeid_at(v1_fields, 1)).v = t_i32_v;
        *usize_at(vcounts, 0) = 1;
        *usize_at(vcounts, 1) = 2;
        *usize_at(vcounts, 2) = 0;
        *typeid_ptr_at(vfields, 0) = v0_fields;
        *typeid_ptr_at(vfields, 1) = v1_fields;
        *typeid_ptr_at(vfields, 2) = 0 as *mut TypeId;
        ax_type_reset(mut_view(*ety), TY_ENUM);
        (*ety).variant_count = 3;
        (*ety).variant_field_counts = vcounts;
        (*ety).variant_fields = vfields;
        intern_type(ti, view(*ety)).v
    }
}

fn test_aggregates_projections_and_views() {
    let ar = alloc_init_arena();
    let str_in = alloc_init_interner();
    let thir_ptr = alloc_init_thir();

    let t_i32 = unsafe { (*thir_ptr).interner.t_i32.v };
    let t_u32 = unsafe { (*thir_ptr).interner.t_u32.v };
    let t_usize = unsafe { (*thir_ptr).interner.t_usize.v };

    let tup_fields = alloc_ty2(unsafe { mut_view(*ar) }, t_i32, t_i32);
    let t_tup = intern_tuple_ty(unsafe { mut_view((*thir_ptr).interner) }, tup_fields, 2).v;
    let t_arr = intern_array_ty(unsafe { mut_view((*thir_ptr).interner) }, TypeId { v: t_i32 }, 3u64).v;
    let t_shape = intern_shape_enum(unsafe { mut_view((*thir_ptr).interner) });
    let t_mut_view_i32 = intern_view_ty(unsafe { mut_view((*thir_ptr).interner) }, TypeId { v: t_i32 }, true).v;

    let main_item = make_fn_item(
        unsafe { mut_view(*ar) },
        unsafe { mut_view(*str_in) },
        unsafe { mut_view(*thir_ptr) },
        0,
        4,
        100u32,
        0 as *mut TypeId,
        0,
        t_i32,
        false
    );
    let hir = HirFile { items: main_item };

    let body = new_test_body(unsafe { mut_view(*ar) });
    let l_ret = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_i32, MIR_LOCAL_RETURN);
    let l_tup = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_tup, MIR_LOCAL_USER);
    let l_shape = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_shape, MIR_LOCAL_USER);
    let l_discr = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_u32, MIR_LOCAL_TEMP);
    let l_arr = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_arr, MIR_LOCAL_USER);
    let l_len = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_usize, MIR_LOCAL_TEMP);
    let l_leni = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_i32, MIR_LOCAL_TEMP);
    let l_idx0 = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_usize, MIR_LOCAL_TEMP);
    let l_idx1 = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_usize, MIR_LOCAL_TEMP);
    let l_idx2 = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_usize, MIR_LOCAL_TEMP);
    let l_x = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_i32, MIR_LOCAL_USER);
    let l_mv = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_mut_view_i32, MIR_LOCAL_USER);
    let l_tmp = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_i32, MIR_LOCAL_TEMP);

    let bb0 = add_bb_ptr(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) });

    // 1. Tuple (20, 30) -> field 0 + field 1 = 50
    emit_agg2(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_tup), 0u32, op_const_int(ar, t_i32, 20u64), op_const_int(ar, t_i32, 30u64));
    let p_tup0 = place_field(unsafe { mut_view(*ar) }, mir_local_place(l_tup), 0u32);
    let p_tup1 = place_field(unsafe { mut_view(*ar) }, mir_local_place(l_tup), 1u32);
    emit_binop(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_tmp), MIR_RVALUE_BINARY_OP, MIR_BINOP_ADD, op_place(ar, p_tup0), op_place(ar, p_tup1));

    // 2. Enum Shape.Rect(3, 5) (variant 1) -> discr == 1, downcast(1).0 * downcast(1).1 = 15
    emit_agg2(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_shape), 1u32, op_const_int(ar, t_i32, 3u64), op_const_int(ar, t_i32, 5u64));
    emit_discr(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_discr), mir_local_place(l_shape));
    let p_w = place_downcast_field(unsafe { mut_view(*ar) }, mir_local_place(l_shape), 1u32, 0u32);
    let p_h = place_downcast_field(unsafe { mut_view(*ar) }, mir_local_place(l_shape), 1u32, 1u32);
    emit_binop(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_ret), MIR_RVALUE_BINARY_OP, MIR_BINOP_MUL, op_place(ar, p_w), op_place(ar, p_h));
    emit_binop(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_ret), MIR_RVALUE_BINARY_OP, MIR_BINOP_ADD, op_copy_local(ar, l_ret), op_copy_local(ar, l_tmp));

    // 3. Array [7; 3], arr[1] = 25, len(arr) = 3 -> arr[0] + arr[1] + arr[2] + len = 7 + 25 + 7 + 3 = 42
    emit_repeat(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_arr), op_const_int(ar, t_i32, 7u64), 3u64);
    emit_len(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_len), mir_local_place(l_arr));
    emit_cast(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_leni), MIR_CAST_INT_TO_INT, op_copy_local(ar, l_len), t_i32);

    emit_use(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_idx0), op_const_int(ar, t_usize, 0u64));
    emit_use(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_idx1), op_const_int(ar, t_usize, 1u64));
    emit_use(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_idx2), op_const_int(ar, t_usize, 2u64));
    let p_arr0 = place_index(unsafe { mut_view(*ar) }, mir_local_place(l_arr), l_idx0);
    let p_arr1_w = place_index(unsafe { mut_view(*ar) }, mir_local_place(l_arr), l_idx1);
    let p_arr1_r = place_index(unsafe { mut_view(*ar) }, mir_local_place(l_arr), l_idx1);
    let p_arr2 = place_index(unsafe { mut_view(*ar) }, mir_local_place(l_arr), l_idx2);
    emit_use(bb0, unsafe { mut_view(*ar) }, p_arr1_w, op_const_int(ar, t_i32, 25u64));

    emit_binop(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_ret), MIR_RVALUE_BINARY_OP, MIR_BINOP_ADD, op_copy_local(ar, l_ret), op_place(ar, p_arr0));
    emit_binop(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_ret), MIR_RVALUE_BINARY_OP, MIR_BINOP_ADD, op_copy_local(ar, l_ret), op_place(ar, p_arr1_r));
    emit_binop(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_ret), MIR_RVALUE_BINARY_OP, MIR_BINOP_ADD, op_copy_local(ar, l_ret), op_place(ar, p_arr2));
    emit_binop(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_ret), MIR_RVALUE_BINARY_OP, MIR_BINOP_ADD, op_copy_local(ar, l_ret), op_copy_local(ar, l_leni));

    // 4. mut_view<i32> borrow & deref write: x = 2; mv = mut_view(x); *mv = *mv + 8 -> x == 10
    emit_use(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_x), op_const_int(ar, t_i32, 2u64));
    emit_ref(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_mv), MIR_BORROW_MUT, mir_local_place(l_x));
    let p_deref_mv_w = place_deref(unsafe { mut_view(*ar) }, mir_local_place(l_mv));
    let p_deref_mv_r = place_deref(unsafe { mut_view(*ar) }, mir_local_place(l_mv));
    emit_binop(bb0, unsafe { mut_view(*ar) }, p_deref_mv_w, MIR_RVALUE_BINARY_OP, MIR_BINOP_ADD, op_place(ar, p_deref_mv_r), op_const_int(ar, t_i32, 8u64));
    emit_binop(bb0, unsafe { mut_view(*ar) }, mir_local_place(l_ret), MIR_RVALUE_BINARY_OP, MIR_BINOP_ADD, op_copy_local(ar, l_ret), op_copy_local(ar, l_x));
    // Total: 65 + 42 + 10 = 117
    term_return(bb0, unsafe { mut_view(*ar) });

    let mut mir_map = MirBodyMap {
        entries: 0 as *mut MirBodyEntry,
        len: 0,
        cap: 0,
    };
    mir_body_map_init(mut_view(mir_map));
    mir_body_map_insert(mut_view(mir_map), main_item as *const HirItem, 100u32, body);

    let sink_ptr = alloc_init_sink();
    let mut out_buf = diag_buf_new();
    let mut panic_sv = StrView { ptr: 0 as *const u8, len: 0 };

    let code = run_test_interp(
        main_item,
        thir_ptr,
        view(hir),
        str_in,
        sink_ptr,
        100000,
        64,
        map_mut_ptr(mut_view(mir_map)),
        mut_view(out_buf),
        mut_view(panic_sv)
    );

    qa_check(code == 117);
    qa_check(panic_sv.len == 0);
    qa_check(unsafe { (*sink_ptr).errors == 0 });

    free_panic_sv(mut_view(panic_sv));
    diag_buf_free(mut_view(out_buf));
    free_dealloc_sink(sink_ptr);
    mir_body_map_free(mut_view(mir_map));
    free_dealloc_thir(thir_ptr);
    free_dealloc_interner(str_in);
    free_dealloc_arena(ar);
}

// =================================================================================================
// 4. Builtin Intrinsics, Host Oracle Calls & Captured Stdout Parity ("fib=2\nsum=150\n" -> 129)
// =================================================================================================

const EXPECTED_STDOUT: [14]u8 = [
    102u8, 105u8, 98u8, 61u8, 50u8, 10u8,
    115u8, 117u8, 109u8, 61u8, 49u8, 53u8, 48u8, 10u8,
];

fn test_builtin_intrinsics_and_stdout_parity() {
    let ar = alloc_init_arena();
    let str_in = alloc_init_interner();
    let thir_ptr = alloc_init_thir();

    let t_unit = unsafe { (*thir_ptr).interner.t_unit.v };
    let t_bool = unsafe { (*thir_ptr).interner.t_bool.v };
    let t_u8 = unsafe { (*thir_ptr).interner.t_u8.v };
    let t_i32 = unsafe { (*thir_ptr).interner.t_i32.v };
    let t_u64 = unsafe { (*thir_ptr).interner.t_u64.v };
    let t_usize = unsafe { (*thir_ptr).interner.t_usize.v };
    let t_str = unsafe { (*thir_ptr).interner.t_str.v };
    let t_ptr_u8 = intern_ptr_ty(unsafe { mut_view((*thir_ptr).interner) }, TypeId { v: t_u8 }, true).v;

    let t_b_print = intern_singleton(unsafe { mut_view((*thir_ptr).interner) }, TY_BUILTIN_PRINT).v;
    let t_b_print_int = intern_singleton(unsafe { mut_view((*thir_ptr).interner) }, TY_BUILTIN_PRINT_INT).v;
    let t_b_size_of = intern_singleton(unsafe { mut_view((*thir_ptr).interner) }, TY_BUILTIN_SIZE_OF).v;
    let t_b_align_of = intern_singleton(unsafe { mut_view((*thir_ptr).interner) }, TY_BUILTIN_ALIGN_OF).v;
    let t_b_ptr_add = intern_singleton(unsafe { mut_view((*thir_ptr).interner) }, TY_BUILTIN_PTR_ADD).v;
    let t_b_ptr_write = intern_singleton(unsafe { mut_view((*thir_ptr).interner) }, TY_BUILTIN_PTR_WRITE_BYTES).v;
    let t_b_ptr_copy = intern_singleton(unsafe { mut_view((*thir_ptr).interner) }, TY_BUILTIN_PTR_COPY_NONOVERLAPPING).v;
    let t_b_is_null = intern_singleton(unsafe { mut_view((*thir_ptr).interner) }, TY_BUILTIN_IS_NULL).v;

    let p_alloc = alloc_ty2(unsafe { mut_view(*ar) }, t_usize, t_usize);
    let p_free = alloc_ty3(unsafe { mut_view(*ar) }, t_ptr_u8, t_usize, t_usize);

    let fn_alloc = make_fn_item(
        unsafe { mut_view(*ar) },
        unsafe { mut_view(*str_in) },
        unsafe { mut_view(*thir_ptr) },
        49,
        10,
        101u32,
        p_alloc,
        2,
        t_ptr_u8,
        true
    );
    let fn_free = make_fn_item(
        unsafe { mut_view(*ar) },
        unsafe { mut_view(*str_in) },
        unsafe { mut_view(*thir_ptr) },
        59,
        9,
        102u32,
        p_free,
        3,
        t_unit,
        true
    );
    let fn_mono = make_fn_item(
        unsafe { mut_view(*ar) },
        unsafe { mut_view(*str_in) },
        unsafe { mut_view(*thir_ptr) },
        68,
        12,
        103u32,
        0 as *mut TypeId,
        0,
        t_u64,
        true
    );
    let fn_main = make_fn_item(
        unsafe { mut_view(*ar) },
        unsafe { mut_view(*str_in) },
        unsafe { mut_view(*thir_ptr) },
        0,
        4,
        100u32,
        0 as *mut TypeId,
        0,
        t_i32,
        false
    );
    unsafe {
        (*fn_main).next = fn_alloc;
        (*fn_alloc).next = fn_free;
        (*fn_free).next = fn_mono;
    }
    let hir = HirFile { items: fn_main };

    let ty_fn_alloc = intern_fn_ty(unsafe { mut_view((*thir_ptr).interner) }, false, StrId { v: 0u32 }, p_alloc, 2, TypeId { v: t_ptr_u8 }).v;
    let ty_fn_free = intern_fn_ty(unsafe { mut_view((*thir_ptr).interner) }, false, StrId { v: 0u32 }, p_free, 3, TypeId { v: t_unit }).v;
    let ty_fn_mono = intern_fn_ty(unsafe { mut_view((*thir_ptr).interner) }, false, StrId { v: 0u32 }, 0 as *mut TypeId, 0, TypeId { v: t_u64 }).v;

    let body = new_test_body(unsafe { mut_view(*ar) });
    let l_ret = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_i32, MIR_LOCAL_RETURN);
    let l_sz = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_usize, MIR_LOCAL_TEMP);
    let l_al = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_usize, MIR_LOCAL_TEMP);
    let l_p1 = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_ptr_u8, MIR_LOCAL_USER);
    let l_p2 = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_ptr_u8, MIR_LOCAL_USER);
    let l_isnull = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_bool, MIR_LOCAL_TEMP);
    let l_t0 = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_u64, MIR_LOCAL_TEMP);
    let l_unit = add_loc(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) }, t_unit, MIR_LOCAL_TEMP);

    let bb0 = add_bb_ptr(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) });
    let bb1 = add_bb_ptr(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) });
    let bb2 = add_bb_ptr(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) });
    let bb3 = add_bb_ptr(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) });
    let bb4 = add_bb_ptr(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) });
    let bb5 = add_bb_ptr(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) });
    let bb6 = add_bb_ptr(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) });
    let bb7 = add_bb_ptr(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) });
    let bb8 = add_bb_ptr(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) });
    let bb9 = add_bb_ptr(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) });
    let bb10 = add_bb_ptr(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) });
    let bb11 = add_bb_ptr(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) });
    let bb12 = add_bb_ptr(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) });
    let bb13 = add_bb_ptr(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) });
    let bb14 = add_bb_ptr(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) });

    // bb0: sz = size_of<u64>() (8) -> bb1
    term_call(bb0, unsafe { mut_view(*ar) }, op_builtin(ar, t_b_size_of, t_u64), 0 as *mut MirOperand, 0, mir_local_place(l_sz), true, 1u32);

    // bb1: al = align_of<u64>() (8) -> bb2
    term_call(bb1, unsafe { mut_view(*ar) }, op_builtin(ar, t_b_align_of, t_u64), 0 as *mut MirOperand, 0, mir_local_place(l_al), true, 2u32);

    // bb2: p1 = heap_alloc(16, 8) -> bb3
    let a_alloc = arena_alloc_raw(unsafe { mut_view(*ar) }, mir_mul_usize(2, size_of<MirOperand>()), align_of<MirOperand>()) as *mut MirOperand;
    set_arg_op(a_alloc, 0, op_const_int(ar, t_usize, 16u64));
    set_arg_op(a_alloc, 1, op_copy_local(ar, l_al));
    term_call(bb2, unsafe { mut_view(*ar) }, op_fn_sym(ar, ty_fn_alloc, 101u32), a_alloc, 2, mir_local_place(l_p1), true, 3u32);

    // bb3: ptr_write_bytes<u8>(p1, 77u8, 4) -> bb4
    let a_write = arena_alloc_raw(unsafe { mut_view(*ar) }, mir_mul_usize(3, size_of<MirOperand>()), align_of<MirOperand>()) as *mut MirOperand;
    set_arg_op(a_write, 0, op_copy_local(ar, l_p1));
    set_arg_op(a_write, 1, op_const_int(ar, t_u8, 77u64));
    set_arg_op(a_write, 2, op_const_int(ar, t_usize, 4u64));
    term_call(bb3, unsafe { mut_view(*ar) }, op_builtin(ar, t_b_ptr_write, t_u8), a_write, 3, mir_local_place(l_unit), false, 4u32);

    // bb4: p2 = ptr_add<u8>(p1, 8) -> bb5
    let a_padd = arena_alloc_raw(unsafe { mut_view(*ar) }, mir_mul_usize(2, size_of<MirOperand>()), align_of<MirOperand>()) as *mut MirOperand;
    set_arg_op(a_padd, 0, op_copy_local(ar, l_p1));
    set_arg_op(a_padd, 1, op_copy_local(ar, l_sz));
    term_call(bb4, unsafe { mut_view(*ar) }, op_builtin(ar, t_b_ptr_add, t_u8), a_padd, 2, mir_local_place(l_p2), true, 5u32);

    // bb5: ptr_copy_nonoverlapping<u8>(p1, p2, 4) -> bb6
    let a_pcopy = arena_alloc_raw(unsafe { mut_view(*ar) }, mir_mul_usize(3, size_of<MirOperand>()), align_of<MirOperand>()) as *mut MirOperand;
    set_arg_op(a_pcopy, 0, op_copy_local(ar, l_p1));
    set_arg_op(a_pcopy, 1, op_copy_local(ar, l_p2));
    set_arg_op(a_pcopy, 2, op_const_int(ar, t_usize, 4u64));
    term_call(bb5, unsafe { mut_view(*ar) }, op_builtin(ar, t_b_ptr_copy, t_u8), a_pcopy, 3, mir_local_place(l_unit), false, 6u32);

    // bb6: isnull = is_null(p2) -> bb7
    let a_isnull = arena_alloc_raw(unsafe { mut_view(*ar) }, size_of<MirOperand>(), align_of<MirOperand>()) as *mut MirOperand;
    set_arg_op(a_isnull, 0, op_copy_local(ar, l_p2));
    term_call(bb6, unsafe { mut_view(*ar) }, op_builtin(ar, t_b_is_null, t_ptr_u8), a_isnull, 1, mir_local_place(l_isnull), true, 7u32);

    // bb7: t0 = monotonic_ns() -> bb8
    term_call(bb7, unsafe { mut_view(*ar) }, op_fn_sym(ar, ty_fn_mono, 103u32), 0 as *mut MirOperand, 0, mir_local_place(l_t0), true, 8u32);

    // bb8: heap_free(p1, 16, 8) -> bb9
    let a_free = arena_alloc_raw(unsafe { mut_view(*ar) }, mir_mul_usize(3, size_of<MirOperand>()), align_of<MirOperand>()) as *mut MirOperand;
    set_arg_op(a_free, 0, op_copy_local(ar, l_p1));
    set_arg_op(a_free, 1, op_const_int(ar, t_usize, 16u64));
    set_arg_op(a_free, 2, op_copy_local(ar, l_al));
    term_call(bb8, unsafe { mut_view(*ar) }, op_fn_sym(ar, ty_fn_free, 102u32), a_free, 3, mir_local_place(l_unit), false, 9u32);

    // Copy EXPECTED_STDOUT into arena so raw pointer offsets are inside a live allocation
    let stdout_lit = arena_alloc_raw(unsafe { mut_view(*ar) }, 15, 1);
    let mut si: usize = 0;
    while si < 14 {
        unsafe {
            *(stdout_lit + si) = EXPECTED_STDOUT[si];
        }
        si = si + 1;
    }
    unsafe {
        *(stdout_lit + 14) = 0u8;
    }

    // bb9..bb14: print("fib="), print_int(2), print("\n"), print("sum="), print_int(150), print("\n")
    let a_pr1 = arena_alloc_raw(unsafe { mut_view(*ar) }, size_of<MirOperand>(), align_of<MirOperand>()) as *mut MirOperand;
    set_arg_op(a_pr1, 0, op_const_str(ar, t_str, stdout_lit as *const u8, 4));
    term_call(bb9, unsafe { mut_view(*ar) }, op_builtin(ar, t_b_print, 0u32), a_pr1, 1, mir_local_place(l_unit), false, 10u32);

    let a_pi1 = arena_alloc_raw(unsafe { mut_view(*ar) }, size_of<MirOperand>(), align_of<MirOperand>()) as *mut MirOperand;
    set_arg_op(a_pi1, 0, op_const_int(ar, t_i32, 2u64));
    term_call(bb10, unsafe { mut_view(*ar) }, op_builtin(ar, t_b_print_int, 0u32), a_pi1, 1, mir_local_place(l_unit), false, 11u32);

    let a_pr2 = arena_alloc_raw(unsafe { mut_view(*ar) }, size_of<MirOperand>(), align_of<MirOperand>()) as *mut MirOperand;
    set_arg_op(a_pr2, 0, op_const_str(ar, t_str, unsafe { (stdout_lit + 5) as *const u8 }, 1));
    term_call(bb11, unsafe { mut_view(*ar) }, op_builtin(ar, t_b_print, 0u32), a_pr2, 1, mir_local_place(l_unit), false, 12u32);

    let a_pr3 = arena_alloc_raw(unsafe { mut_view(*ar) }, size_of<MirOperand>(), align_of<MirOperand>()) as *mut MirOperand;
    set_arg_op(a_pr3, 0, op_const_str(ar, t_str, unsafe { (stdout_lit + 6) as *const u8 }, 4));
    term_call(bb12, unsafe { mut_view(*ar) }, op_builtin(ar, t_b_print, 0u32), a_pr3, 1, mir_local_place(l_unit), false, 13u32);

    let a_pi2 = arena_alloc_raw(unsafe { mut_view(*ar) }, size_of<MirOperand>(), align_of<MirOperand>()) as *mut MirOperand;
    set_arg_op(a_pi2, 0, op_const_int(ar, t_i32, 150u64));
    term_call(bb13, unsafe { mut_view(*ar) }, op_builtin(ar, t_b_print_int, 0u32), a_pi2, 1, mir_local_place(l_unit), false, 14u32);

    let a_pr4 = arena_alloc_raw(unsafe { mut_view(*ar) }, size_of<MirOperand>(), align_of<MirOperand>()) as *mut MirOperand;
    set_arg_op(a_pr4, 0, op_const_str(ar, t_str, unsafe { (stdout_lit + 13) as *const u8 }, 1));
    let bb15 = add_bb_ptr(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) });
    term_call(bb14, unsafe { mut_view(*ar) }, op_builtin(ar, t_b_print, 0u32), a_pr4, 1, mir_local_place(l_unit), false, 15u32);

    // bb15: assert(!isnull) -> return 129
    let bb16 = add_bb_ptr(unsafe { mut_view(*body) }, unsafe { mut_view(*ar) });
    term_assert(bb15, unsafe { mut_view(*ar) }, op_copy_local(ar, l_isnull), false, 16u32);
    emit_use(bb16, unsafe { mut_view(*ar) }, mir_local_place(l_ret), op_const_int(ar, t_i32, 129u64));
    term_return(bb16, unsafe { mut_view(*ar) });

    let mut mir_map = MirBodyMap {
        entries: 0 as *mut MirBodyEntry,
        len: 0,
        cap: 0,
    };
    mir_body_map_init(mut_view(mir_map));
    mir_body_map_insert(mut_view(mir_map), fn_main as *const HirItem, 100u32, body);

    let sink_ptr = alloc_init_sink();
    let mut out_buf = diag_buf_new();
    let mut panic_sv = StrView { ptr: 0 as *const u8, len: 0 };

    let code = run_test_interp(
        fn_main,
        thir_ptr,
        view(hir),
        str_in,
        sink_ptr,
        100000,
        64,
        map_mut_ptr(mut_view(mir_map)),
        mut_view(out_buf),
        mut_view(panic_sv)
    );

    qa_check(code == 129);
    qa_check(panic_sv.len == 0);
    qa_check(unsafe { (*sink_ptr).errors == 0 });
    qa_check(out_buf.len == 14);
    let mut i: usize = 0;
    while i < 14 {
        let ch = unsafe { *(out_buf.ptr + i) };
        qa_check(ch == EXPECTED_STDOUT[i]);
        i = i + 1;
    }

    free_panic_sv(mut_view(panic_sv));
    diag_buf_free(mut_view(out_buf));
    free_dealloc_sink(sink_ptr);
    mir_body_map_free(mut_view(mir_map));
    free_dealloc_thir(thir_ptr);
    free_dealloc_interner(str_in);
    free_dealloc_arena(ar);
}

// =================================================================================================
// 5. On-Demand HIR -> MIR Function Lowering & Drop Elaboration via interp_run
// =================================================================================================

fn test_hir_to_mir_on_demand_lowering() {
    let mut arena = arena_new();
    let str_in = alloc_init_interner();
    let thir_ptr = alloc_init_thir();

    let t_i32 = unsafe { (*thir_ptr).interner.t_i32.v };

    // Construct HIR for `fn main() -> i32 { 20 + 20 + 1 }` and let `interp_run` lower it on-demand!
    let main_item = make_fn_item(
        mut_view(arena),
        unsafe { mut_view(*str_in) },
        unsafe { mut_view(*thir_ptr) },
        0,
        4,
        100u32,
        0 as *mut TypeId,
        0,
        t_i32,
        false
    );
    let blk: *mut HirBlock = hir_alloc_block(mut_view(arena), qa_zero_span());
    let stmt: *mut HirStmt = hir_alloc_stmt(mut_view(arena), HIR_STMT_EXPR, qa_zero_span());
    let e_20a: *mut HirExpr = hir_alloc_expr(mut_view(arena), HIR_EXPR_LITERAL, qa_zero_span());
    let e_20b: *mut HirExpr = hir_alloc_expr(mut_view(arena), HIR_EXPR_LITERAL, qa_zero_span());
    let e_1: *mut HirExpr = hir_alloc_expr(mut_view(arena), HIR_EXPR_LITERAL, qa_zero_span());
    let e_add1: *mut HirExpr = hir_alloc_expr(mut_view(arena), HIR_EXPR_BINARY, qa_zero_span());
    let e_add2: *mut HirExpr = hir_alloc_expr(mut_view(arena), HIR_EXPR_BINARY, qa_zero_span());

    unsafe {
        (*e_20a).literal.kind = TOK_INT;
        (*e_20a).literal.int_val = 20u64;
        (*e_20b).literal.kind = TOK_INT;
        (*e_20b).literal.int_val = 20u64;
        (*e_1).literal.kind = TOK_INT;
        (*e_1).literal.int_val = 1u64;

        (*e_add1).op = BINOP_ADD;
        (*e_add1).left = e_20a;
        (*e_add1).right = e_20b;

        (*e_add2).op = BINOP_ADD;
        (*e_add2).left = e_add1;
        (*e_add2).right = e_1;

        (*stmt).expr = e_add2;
        (*stmt).has_semi = false;
        (*blk).stmts = stmt;
        (*main_item).body = blk;
    }
    thir_set_expr_type(unsafe { mut_view(*thir_ptr) }, e_20a as *const HirExpr, TypeId { v: t_i32 });
    thir_set_expr_type(unsafe { mut_view(*thir_ptr) }, e_20b as *const HirExpr, TypeId { v: t_i32 });
    thir_set_expr_type(unsafe { mut_view(*thir_ptr) }, e_1 as *const HirExpr, TypeId { v: t_i32 });
    thir_set_expr_type(unsafe { mut_view(*thir_ptr) }, e_add1 as *const HirExpr, TypeId { v: t_i32 });
    thir_set_expr_type(unsafe { mut_view(*thir_ptr) }, e_add2 as *const HirExpr, TypeId { v: t_i32 });

    let hir = HirFile { items: main_item };
    let sink_ptr = alloc_init_sink();
    let mut out_buf = diag_buf_new();
    let mut panic_sv = StrView { ptr: 0 as *const u8, len: 0 };

    let code = run_test_interp(
        0 as *mut HirItem,
        thir_ptr,
        view(hir),
        str_in,
        sink_ptr,
        100000,
        64,
        0 as *mut MirBodyMap,
        mut_view(out_buf),
        mut_view(panic_sv)
    );

    qa_check(code == 41);
    qa_check(panic_sv.len == 0);
    qa_check(unsafe { (*sink_ptr).errors == 0 });

    free_panic_sv(mut_view(panic_sv));
    diag_buf_free(mut_view(out_buf));
    free_dealloc_sink(sink_ptr);
    free_dealloc_thir(thir_ptr);
    free_dealloc_interner(str_in);
    arena_destroy(mut_view(arena));
}

pub fn main() -> i32 {
    test_arith_bitwise_casts_and_control_flow();
    test_calls_recursion_and_core_intrinsics();
    test_aggregates_projections_and_views();
    test_builtin_intrinsics_and_stdout_parity();
    test_hir_to_mir_on_demand_lowering();
    print("ALL INTERP EXEC A TESTS PASSED\n");
    0
}
