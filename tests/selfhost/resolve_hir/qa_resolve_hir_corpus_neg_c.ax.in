const CORPUS_OFF: [21]u32 = [
    0u32, 37u32, 105u32, 316u32, 511u32, 540u32, 629u32, 908u32, 1141u32, 1169u32, 1613u32, 2655u32,
    3607u32, 3639u32, 3675u32, 3792u32, 3961u32, 3995u32, 4046u32, 4230u32, 4422u32,
];

fn get_sv(a: mut_view<Arena>, c_data: view<[4422]u8>, c_off: view<[21]u32>, blob_idx: usize) -> StrView {
    let start = (*c_off)[blob_idx] as usize;
    let end = (*c_off)[blob_idx + 1] as usize;
    let n = end - start;
    let dst = arena_alloc_raw(a, n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = (*c_data)[start + i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn trimmed_len(p: *const u8, n: usize) -> usize {
    let mut end = n;
    while end > 0 {
        let c = unsafe { *(p + (end - 1)) };
        if c != 10u8 && c != 13u8 && c != 32u8 {
            return end;
        }
        end = end - 1;
    }
    0
}

fn bytes_equal(a: *const u8, a_len: usize, b: *const u8, b_len: usize) -> bool {
    if a_len != b_len {
        return false;
    }
    let mut i: usize = 0;
    while i < a_len {
        if (unsafe { *(a + i) }) != (unsafe { *(b + i) }) {
            return false;
        }
        i = i + 1;
    }
    true
}

fn verify_case(
    sess: mut_view<CompilerSession>,
    parse_arena: mut_view<Arena>,
    resolve_arena: mut_view<Arena>,
    hir_arena: mut_view<Arena>,
    scratch: mut_view<Arena>,
    rmap: mut_view<ResolveMap>,
    out: mut_view<DiagBuffer>,
    diags: mut_view<DiagBuffer>,
    c_data: view<[4422]u8>,
    c_off: view<[21]u32>,
    case_idx: usize,
    need_std: bool
) -> i32 {
    session_init(mut_view(*sess));
    out.len = 0;
    diags.len = 0;
    let base = ((case_idx as isize) * (BLOBS_PER_CASE as isize)) as usize;
    let path_sv = get_sv(mut_view(*scratch), c_data, c_off, base);
    let src_sv = get_sv(mut_view(*scratch), c_data, c_off, base + 1);
    let exp_out = get_sv(mut_view(*scratch), c_data, c_off, base + 2);
    let exp_diag = get_sv(mut_view(*scratch), c_data, c_off, base + 3);
    let _ = session_hir_and_render_human(
        mut_view(*sess),
        mut_view(*parse_arena),
        mut_view(*resolve_arena),
        mut_view(*hir_arena),
        mut_view(*rmap),
        StrView { ptr: path_sv.ptr, len: path_sv.len },
        StrView { ptr: src_sv.ptr, len: src_sv.len },
        need_std,
        mut_view(*out),
        mut_view(*diags)
    );
    let mut rc: i32 = 0;
    if exp_out.len > 0 && !bytes_equal(out.ptr as *const u8, out.len, exp_out.ptr, exp_out.len) {
        rc = OUTPUT_MISMATCH_RC;
    }
    let got_diag_len = trimmed_len(diags.ptr as *const u8, diags.len);
    if !bytes_equal(diags.ptr as *const u8, got_diag_len, exp_diag.ptr, exp_diag.len) {
        rc = DIAG_MISMATCH_RC;
    }
    arena_reset(mut_view(*hir_arena));
    arena_reset(mut_view(*resolve_arena));
    arena_reset(mut_view(*parse_arena));
    session_free(mut_view(*sess));
    arena_reset(mut_view(*scratch));
    rc
}

pub fn main() -> i32 {
    let mut sess = session_new();
    let mut parse_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(parse_arena), 16, 8);
    let mut resolve_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(resolve_arena), 16, 8);
    let mut hir_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(hir_arena), 16, 8);
    let mut scratch = arena_with_chunk_size(65536);
    let _ = arena_alloc_raw(mut_view(scratch), 16, 8);
    let mut out = diag_buf_new();
    out.ptr = unsafe { heap_alloc(65536, 1) };
    out.cap = 65536;
    let mut diags = diag_buf_new();
    diags.ptr = unsafe { heap_alloc(16384, 1) };
    diags.cap = 16384;
    let mut rmap = ResolveMap {
        node_map: NodeMap { keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0 },
        module_access_nodes: NodeMap {
            keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0
        },
        extern_nodes: NodeMap {
            keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0
        },
        next_symbol_v: 1u32,
        next_std_symbol_v: 10000u32,
        naming_ctx: 0 as *mut NamingCtx,
    };
    let c_data = CORPUS_DATA;
    let c_off = CORPUS_OFF;
    let rc0 = verify_case(mut_view(sess), mut_view(parse_arena), mut_view(resolve_arena), mut_view(hir_arena),
        mut_view(scratch), mut_view(rmap), mut_view(out), mut_view(diags), view(c_data), view(c_off), 0, false);
    if rc0 != 0 {
        return rc0 + 0;
    }
    let rc1 = verify_case(mut_view(sess), mut_view(parse_arena), mut_view(resolve_arena), mut_view(hir_arena),
        mut_view(scratch), mut_view(rmap), mut_view(out), mut_view(diags), view(c_data), view(c_off), 1, true);
    if rc1 != 0 {
        return rc1 + 1;
    }
    let rc2 = verify_case(mut_view(sess), mut_view(parse_arena), mut_view(resolve_arena), mut_view(hir_arena),
        mut_view(scratch), mut_view(rmap), mut_view(out), mut_view(diags), view(c_data), view(c_off), 2, false);
    if rc2 != 0 {
        return rc2 + 2;
    }
    let rc3 = verify_case(mut_view(sess), mut_view(parse_arena), mut_view(resolve_arena), mut_view(hir_arena),
        mut_view(scratch), mut_view(rmap), mut_view(out), mut_view(diags), view(c_data), view(c_off), 3, false);
    if rc3 != 0 {
        return rc3 + 3;
    }
    let rc4 = verify_case(mut_view(sess), mut_view(parse_arena), mut_view(resolve_arena), mut_view(hir_arena),
        mut_view(scratch), mut_view(rmap), mut_view(out), mut_view(diags), view(c_data), view(c_off), 4, false);
    if rc4 != 0 {
        return rc4 + 4;
    }
    diag_buf_free(mut_view(diags));
    diag_buf_free(mut_view(out));
    arena_destroy(mut_view(scratch));
    arena_destroy(mut_view(hir_arena));
    arena_destroy(mut_view(resolve_arena));
    arena_destroy(mut_view(parse_arena));
    print("OK Resolve+HIR Corpus Neg C (5 files)\n");
    0
}
