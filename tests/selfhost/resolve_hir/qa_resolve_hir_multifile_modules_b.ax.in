const CORPUS_OFF: [19]u32 = [
    0u32, 36u32, 42u32, 91u32, 129u32, 137u32, 186u32, 220u32, 224u32, 303u32, 559u32, 601u32,
    605u32, 715u32, 1086u32, 1099u32, 1184u32, 1197u32, 1277u32,
];

fn get_sv(a: mut_view<Arena>, c_data: view<[1277]u8>, c_off: view<[19]u32>, blob_idx: usize) -> StrView {
    let start = (*c_off)[blob_idx] as usize;
    let end = (*c_off)[blob_idx + 1] as usize;
    let n = end - start;
    let dst = arena_alloc_raw(a, n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = (*c_data)[start + i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn bytes_equal(a: *const u8, a_len: usize, b: *const u8, b_len: usize) -> bool {
    if a_len != b_len {
        return false;
    }
    let mut i: usize = 0;
    while i < a_len {
        if (unsafe { *(a + i) }) != (unsafe { *(b + i) }) {
            return false;
        }
        i = i + 1;
    }
    true
}

fn verify_pkg(
    sess: mut_view<CompilerSession>,
    parse_arena: mut_view<Arena>,
    resolve_arena: mut_view<Arena>,
    hir_arena: mut_view<Arena>,
    scratch: mut_view<Arena>,
    rmap: mut_view<ResolveMap>,
    out: mut_view<DiagBuffer>,
    c_data: view<[1277]u8>,
    c_off: view<[19]u32>,
    start_blob: usize,
    file_count: usize
) -> i32 {
    session_init(mut_view(*sess));
    out.len = 0;
    let mut combined = Ast {
        items: 0 as *mut AstItem,
    };
    let mut main_fid = FileId { v: 0u32 };
    let mut main_src = StrView { ptr: 0 as *const u8, len: 0 };
    let mut i: usize = 0;
    while i < file_count {
        let b_off = start_blob + ((i as isize) * 3isize) as usize;
        let f_path = get_sv(mut_view(*scratch), c_data, c_off, b_off);
        let m_path = get_sv(mut_view(*scratch), c_data, c_off, b_off + 1);
        let f_src = get_sv(mut_view(*scratch), c_data, c_off, b_off + 2);
        let mut fid = FileId { v: 0u32 };
        let mut pr = session_parse_virtual_file(
            mut_view(*sess),
            mut_view(*parse_arena),
            f_path,
            StrView { ptr: f_src.ptr, len: f_src.len },
            mut_view(fid)
        );
        if m_path.len == 4 && (unsafe { *(m_path.ptr) }) == 109u8 && (unsafe { *(m_path.ptr + 1) }) == 97u8 && (unsafe { *(m_path.ptr + 2) }) == 105u8 {
            main_fid.v = fid.v;
            main_src.ptr = f_src.ptr;
            main_src.len = f_src.len;
        }
        session_ensure_module_header(mut_view(*sess), mut_view(*parse_arena), mut_view(pr.ast), m_path);
        let next_items = append_ast_items(combined.items, pr.ast.items);
        combined.items = next_items;
        i = i + 1;
    }
    session_append_std_prelude(mut_view(*sess), mut_view(*parse_arena), mut_view(combined), main_src);
    session_resolve_ast_into(mut_view(*sess), mut_view(*resolve_arena), view(combined), mut_view(*rmap));
    let hf = session_lower_hir(mut_view(*sess), mut_view(*hir_arena), view(combined), view(*rmap));
    session_render_hir_into(view(*sess), view(hf), FileId { v: main_fid.v }, mut_view(*out));
    let exp_idx = start_blob + ((file_count as isize) * 3isize) as usize;
    let exp_hir = get_sv(mut_view(*scratch), c_data, c_off, exp_idx);
    let mut rc: i32 = 0;
    if session_error_count(view(*sess)) != 0 {
        rc = 20;
    } else if !bytes_equal(out.ptr as *const u8, out.len, exp_hir.ptr, exp_hir.len) {
        rc = 30;
    }
    resolve_map_free(mut_view(*rmap));
    arena_reset(mut_view(*hir_arena));
    arena_reset(mut_view(*resolve_arena));
    arena_reset(mut_view(*parse_arena));
    arena_reset(mut_view(*scratch));
    session_free(mut_view(*sess));
    rc
}

fn verify_cross_file_visibility_and_json(
    sess: mut_view<CompilerSession>,
    parse_arena: mut_view<Arena>,
    resolve_arena: mut_view<Arena>,
    hir_arena: mut_view<Arena>,
    scratch: mut_view<Arena>,
    rmap: mut_view<ResolveMap>,
    out: mut_view<DiagBuffer>,
    diags: mut_view<DiagBuffer>,
    c_data: view<[1277]u8>,
    c_off: view<[19]u32>
) -> i32 {
    session_init(mut_view(*sess));
    out.len = 0;
    diags.len = 0;
    let p1 = get_sv(mut_view(*scratch), c_data, c_off, 14);
    let s1 = get_sv(mut_view(*scratch), c_data, c_off, 15);
    let p2 = get_sv(mut_view(*scratch), c_data, c_off, 16);
    let s2 = get_sv(mut_view(*scratch), c_data, c_off, 17);
    let mut fid1 = FileId { v: 0u32 };
    let mut fid2 = FileId { v: 0u32 };
    let mut pr1 = session_parse_virtual_file(mut_view(*sess), mut_view(*parse_arena), StrView { ptr: p1.ptr, len: p1.len }, StrView { ptr: s1.ptr, len: s1.len }, mut_view(fid1));
    let pr2 = session_parse_virtual_file(mut_view(*sess), mut_view(*parse_arena), p2, s2, mut_view(fid2));
    let joined_items = append_ast_items(pr1.ast.items, pr2.ast.items);
    pr1.ast.items = joined_items;
    session_resolve_ast_into(mut_view(*sess), mut_view(*resolve_arena), view(pr1.ast), mut_view(*rmap));
    let _ = session_lower_hir(mut_view(*sess), mut_view(*hir_arena), view(pr1.ast), view(*rmap));
    let errs = session_error_count(view(*sess));
    resolve_map_free(mut_view(*rmap));
    arena_reset(mut_view(*hir_arena));
    arena_reset(mut_view(*resolve_arena));
    arena_reset(mut_view(*parse_arena));
    session_free(mut_view(*sess));
    if errs == 0 {
        return 50;
    }

    session_init(mut_view(*sess));
    out.len = 0;
    diags.len = 0;
    let json_errs = session_hir_and_render_json(
        mut_view(*sess),
        mut_view(*parse_arena),
        mut_view(*resolve_arena),
        mut_view(*hir_arena),
        mut_view(*rmap),
        p1,
        s1,
        false,
        mut_view(*out),
        mut_view(*diags)
    );
    let mut rc: i32 = 0;
    if json_errs != 0 || out.len == 0 || diags.len == 0 {
        rc = 60;
    }
    arena_reset(mut_view(*hir_arena));
    arena_reset(mut_view(*resolve_arena));
    arena_reset(mut_view(*parse_arena));
    arena_reset(mut_view(*scratch));
    session_free(mut_view(*sess));
    rc
}

pub fn main() -> i32 {
    let mut sess = session_new();
    let mut parse_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(parse_arena), 16, 8);
    let mut resolve_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(resolve_arena), 16, 8);
    let mut hir_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(hir_arena), 16, 8);
    let mut scratch = arena_with_chunk_size(65536);
    let _ = arena_alloc_raw(mut_view(scratch), 16, 8);
    let mut out = diag_buf_new();
    out.ptr = unsafe { heap_alloc(65536, 1) };
    out.cap = 65536;
    let mut diags = diag_buf_new();
    diags.ptr = unsafe { heap_alloc(16384, 1) };
    diags.cap = 16384;
    let mut rmap = ResolveMap {
        node_map: NodeMap { keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0 },
        module_access_nodes: NodeMap {
            keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0
        },
        extern_nodes: NodeMap {
            keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0
        },
        next_symbol_v: 1u32,
        next_std_symbol_v: 10000u32,
        naming_ctx: 0 as *mut NamingCtx,
    };
    let c_data = CORPUS_DATA;
    let c_off = CORPUS_OFF;
    let rc_pkg0 = verify_pkg(mut_view(sess), mut_view(parse_arena), mut_view(resolve_arena),
        mut_view(hir_arena), mut_view(scratch), mut_view(rmap), mut_view(out), view(c_data), view(c_off), 0, 3);
    if rc_pkg0 != 0 {
        return rc_pkg0 + 0;
    }
    let rc_pkg1 = verify_pkg(mut_view(sess), mut_view(parse_arena), mut_view(resolve_arena),
        mut_view(hir_arena), mut_view(scratch), mut_view(rmap), mut_view(out), view(c_data), view(c_off), 10, 1);
    if rc_pkg1 != 0 {
        return rc_pkg1 + 1;
    }
    let rc_vis = verify_cross_file_visibility_and_json(
        mut_view(sess), mut_view(parse_arena), mut_view(resolve_arena), mut_view(hir_arena),
        mut_view(scratch), mut_view(rmap), mut_view(out), mut_view(diags), view(c_data), view(c_off)
    );
    if rc_vis != 0 {
        return rc_vis;
    }
    diag_buf_free(mut_view(diags));
    diag_buf_free(mut_view(out));
    arena_destroy(mut_view(scratch));
    arena_destroy(mut_view(hir_arena));
    arena_destroy(mut_view(resolve_arena));
    arena_destroy(mut_view(parse_arena));
    print("OK Resolve+HIR Multi-file Modules B (3 cases)\n");
    0
}
