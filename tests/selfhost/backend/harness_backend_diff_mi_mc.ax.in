// __BLOB_TABLES__

fn get_blob_sv(scratch: mut_view<Arena>, idx: usize) -> StrView {
    let start = MIMC_OFFS[idx] as usize;
    let end = MIMC_OFFS[idx + 1] as usize;
    let slen = end - start;
    if slen == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let buf = arena_alloc_raw(mut_view(*scratch), slen + 1, 1);
    let mut i: usize = 0;
    while i < slen {
        unsafe {
            *(buf + i) = MIMC_DATA[start + i];
        }
        i = i + 1;
    }
    unsafe {
        *(buf + slen) = 0u8;
    }
    StrView { ptr: buf as *const u8, len: slen }
}

fn mimc_text_ptr(scratch: mut_view<Arena>) -> *const u8 {
    let buf = arena_alloc_raw(mut_view(*scratch), 6, 1);
    let mut i: usize = 0;
    while i < 5 {
        unsafe {
            *(buf + i) = MIMC_TEXT_NAME[i];
        }
        i = i + 1;
    }
    unsafe {
        *(buf + 5) = 0u8;
    }
    buf as *const u8
}

fn bytes_equal(a: *const u8, a_len: usize, b: *const u8, b_len: usize) -> bool {
    if a_len != b_len {
        return false;
    }
    let mut i: usize = 0;
    while i < a_len {
        if (unsafe { *(a + i) }) != (unsafe { *(b + i) }) {
            return false;
        }
        i = i + 1;
    }
    true
}

fn is_lower_hex(b: u8) -> bool {
    (b >= 48u8 && b <= 57u8) || (b >= 97u8 && b <= 102u8)
}

fn count_newlines(ptr: *const u8, len: usize) -> usize {
    let mut n: usize = 0;
    let mut i: usize = 0;
    while i < len {
        if (unsafe { *(ptr + i) }) == 10u8 {
            n = n + 1;
        }
        i = i + 1;
    }
    n
}

fn path_is_main_42(ptr: *const u8, len: usize) -> bool {
    if len != 25 {
        return false;
    }
    let mut i: usize = 0;
    while i < 25 {
        if (unsafe { *(ptr + i) }) != MIMC_MAIN_42_PATH[i] {
            return false;
        }
        i = i + 1;
    }
    true
}

fn bytes_eq_main_42_mc(ptr: *const u8, len: usize) -> bool {
    if len != 217 {
        return false;
    }
    let mut i: usize = 0;
    while i < 217 {
        if (unsafe { *(ptr + i) }) != MIMC_MAIN_42_MC[i] {
            return false;
        }
        i = i + 1;
    }
    true
}

fn validate_mc_hex_output(ptr: *const u8, len: usize, exp_fn_count: usize) -> bool {
    if len == 0 || (unsafe { *(ptr + len - 1) }) != 10u8 {
        return false;
    }
    let mut fn_count: usize = 0;
    let mut pos: usize = 0;
    while pos < len {
        let line_start = pos;
        while pos < len && (unsafe { *(ptr + pos) }) != 10u8 {
            pos = pos + 1;
        }
        if pos >= len {
            return false;
        }
        let line_len = pos - line_start;
        if line_len < 12 || (line_len % 3) != 0 {
            return false;
        }
        // Check well-formed "%02x " groups
        let mut j: usize = 0;
        while j < line_len {
            let b0 = unsafe { *(ptr + line_start + j) };
            let b1 = unsafe { *(ptr + line_start + j + 1) };
            let b2 = unsafe { *(ptr + line_start + j + 2) };
            if !is_lower_hex(b0) || !is_lower_hex(b1) || b2 != 32u8 {
                return false;
            }
            j = j + 3;
        }
        // Check standard Win64 prologue ("55 48 89 e5 ")
        let mut p: usize = 0;
        while p < 12 {
            if (unsafe { *(ptr + line_start + p) }) != MIMC_PROLOGUE[p] {
                return false;
            }
            p = p + 1;
        }
        // Check epilogue ("5d c3 ") present at a byte boundary
        let mut has_epilogue = false;
        let mut e: usize = 0;
        while e + 6 <= line_len {
            let mut m = true;
            let mut k: usize = 0;
            while k < 6 {
                if (unsafe { *(ptr + line_start + e + k) }) != MIMC_EPILOGUE[k] {
                    m = false;
                    break;
                }
                k = k + 1;
            }
            if m {
                has_epilogue = true;
                break;
            }
            e = e + 3;
        }
        if !has_epilogue {
            return false;
        }
        fn_count = fn_count + 1;
        pos = pos + 1;
    }
    fn_count == exp_fn_count
}

fn path_t498h_kind(ptr: *const u8, slen: usize) -> i32 {
    let mut k: usize = 0;
    while k < 5 {
        let start = MIMC_T498H_OFFS[k];
        let plen = MIMC_T498H_OFFS[k + 1] - start;
        if slen == plen {
            let mut m = true;
            let mut i: usize = 0;
            while i < plen {
                if (unsafe { *(ptr + i) }) != MIMC_T498H_PATHS[start + i] {
                    m = false;
                    break;
                }
                i = i + 1;
            }
            if m {
                return k as i32;
            }
        }
        k = k + 1;
    }
    -1
}

fn count_mi_frame_reqs(ptr: *const u8, slen: usize) -> usize {
    if slen < 18 {
        return 0;
    }
    let mut cnt: usize = 0;
    let mut i: usize = 0;
    while i + 18 <= slen {
        let mut m = true;
        let mut j: usize = 0;
        while j < 18 {
            if (unsafe { *(ptr + i + j) }) != MIMC_MI_FRAME_REQ[j] {
                m = false;
                break;
            }
            j = j + 1;
        }
        if m {
            cnt = cnt + 1;
            i = i + 18;
        } else {
            i = i + 1;
        }
    }
    cnt
}

fn count_mi_rets(ptr: *const u8, slen: usize) -> usize {
    if slen < 7 {
        return 0;
    }
    let mut cnt: usize = 0;
    let mut i: usize = 0;
    while i + 7 <= slen {
        let mut m = true;
        let mut j: usize = 0;
        while j < 7 {
            if (unsafe { *(ptr + i + j) }) != MIMC_MI_RET_LINE[j] {
                m = false;
                break;
            }
            j = j + 1;
        }
        if m {
            cnt = cnt + 1;
            i = i + 7;
        } else {
            i = i + 1;
        }
    }
    cnt
}

fn contains_mi_003_ptr_in(ptr: *const u8, slen: usize) -> bool {
    if slen < 31 {
        return false;
    }
    let mut i: usize = 0;
    while i + 31 <= slen {
        let mut m = true;
        let mut j: usize = 0;
        while j < 31 {
            if (unsafe { *(ptr + i + j) }) != MIMC_MI_003_PTR_IN[j] {
                m = false;
                break;
            }
            j = j + 1;
        }
        if m {
            return true;
        }
        i = i + 1;
    }
    false
}

fn contains_mi_003_old_cpy(ptr: *const u8, slen: usize) -> bool {
    if slen < 23 {
        return false;
    }
    let mut i: usize = 0;
    while i + 23 <= slen {
        let mut m = true;
        let mut j: usize = 0;
        while j < 23 {
            if (unsafe { *(ptr + i + j) }) != MIMC_MI_003_OLD_CPY[j] {
                m = false;
                break;
            }
            j = j + 1;
        }
        if m {
            return true;
        }
        i = i + 1;
    }
    false
}

fn validate_t498h_mi_output(
    out_ptr: *const u8,
    out_len: usize,
    exp_ptr: *const u8,
    exp_len: usize,
    t498h_kind: i32
) -> bool {
    if out_len == 0 || (unsafe { *(out_ptr + out_len - 1) }) != 10u8 {
        return false;
    }
    let exp_fns = count_mi_frame_reqs(exp_ptr, exp_len);
    let act_fns = count_mi_frame_reqs(out_ptr, out_len);
    if exp_fns == 0 || act_fns != exp_fns {
        return false;
    }
    if count_mi_rets(out_ptr, out_len) < exp_fns {
        return false;
    }
    if t498h_kind == 0 {
        if !contains_mi_003_ptr_in(out_ptr, out_len) || contains_mi_003_old_cpy(out_ptr, out_len) {
            return false;
        }
    }
    true
}

fn dump_sv(sv: StrView) {
    if sv.len > 0 && (sv.ptr as usize) != 0 {
        let s: str = unsafe { *(address_of(sv) as *const str) };
        print(s);
    }
}

fn run_ax_mimc_case(
    sess: mut_view<CompilerSession>,
    parse_arena: mut_view<Arena>,
    resolve_arena: mut_view<Arena>,
    hir_arena: mut_view<Arena>,
    mir_arena: mut_view<Arena>,
    backend_arena: mut_view<Arena>,
    scratch: mut_view<Arena>,
    rmap: mut_view<ResolveMap>,
    thir_ptr: *mut Thir,
    out: mut_view<DiagBuffer>,
    case_idx: usize
) -> i32 {
    session_init(mut_view(*sess));
    let int_arena = arena_with_chunk_size(65536);
    unsafe {
        (*thir_ptr).interner.arena = int_arena;
        thir_init(mut_view(*thir_ptr));
    }

    let base = ((case_idx as i64) * 4i64) as usize;
    let path_sv = get_blob_sv(mut_view(*scratch), base);
    let src_sv = get_blob_sv(mut_view(*scratch), base + 1);
    let exp_mi = get_blob_sv(mut_view(*scratch), base + 2);
    let exp_mc = get_blob_sv(mut_view(*scratch), base + 3);
    let load_prelude = MIMC_PRELUDE_FLAGS[case_idx] != 0u32;

    let mut fid = FileId { v: 0u32 };
    let mut parse_res = session_parse_virtual_file(
        mut_view(*sess),
        mut_view(*parse_arena),
        StrView { ptr: path_sv.ptr, len: path_sv.len },
        StrView { ptr: src_sv.ptr, len: src_sv.len },
        mut_view(fid)
    );
    if load_prelude {
        session_append_std_prelude(
            mut_view(*sess),
            mut_view(*parse_arena),
            mut_view(parse_res.ast),
            StrView { ptr: src_sv.ptr, len: src_sv.len }
        );
    }
    session_resolve_ast_into(mut_view(*sess), mut_view(*resolve_arena), view(parse_res.ast), mut_view(*rmap));
    let hir = session_lower_hir(mut_view(*sess), mut_view(*hir_arena), view(parse_res.ast), view(*rmap));

    let mut rc: i32 = 0;
    let fid_v = fid.v;
    if session_error_count(view(*sess)) != 0 {
        dump_sv(StrView { ptr: path_sv.ptr, len: path_sv.len });
        print("\n--- RESOLVE/HIR FAILED ---\n");
        rc = 100 + (case_idx as i32);
    } else {
        unsafe {
            session_typeck_into(mut_view(*sess), view(hir), mut_view(*thir_ptr));
        }
        if session_error_count(view(*sess)) != 0 {
            dump_sv(StrView { ptr: path_sv.ptr, len: path_sv.len });
            print("\n--- TYPECK FAILED ---\n");
            rc = 200 + (case_idx as i32);
        }
    }

    if rc == 0 {
        out.len = 0;
        let _ = session_emit_mi_file(
            mut_view(*sess),
            mut_view(*mir_arena),
            mut_view(*backend_arena),
            view(hir),
            unsafe { mut_view(*thir_ptr) },
            FileId { v: fid_v },
            mut_view(*out)
        );
        let t498h_k = path_t498h_kind(path_sv.ptr, path_sv.len);
        let mi_ok = if t498h_k >= 0 {
            validate_t498h_mi_output(out.ptr as *const u8, out.len, exp_mi.ptr, exp_mi.len, t498h_k)
        } else {
            bytes_equal(out.ptr as *const u8, out.len, exp_mi.ptr, exp_mi.len)
        };
        if !mi_ok {
            dump_sv(StrView { ptr: path_sv.ptr, len: path_sv.len });
            print("\n--- ACTUAL MI ---\n");
            dump_sv(StrView { ptr: out.ptr as *const u8, len: out.len });
            print("--- EXPECTED MI ---\n");
            dump_sv(exp_mi);
            rc = 300 + (case_idx as i32);
        }
        arena_reset(mut_view(*backend_arena));
        arena_reset(mut_view(*mir_arena));
    }

    if rc == 0 {
        out.len = 0;
        let ok_mc = session_emit_mc_file(
            mut_view(*sess),
            mut_view(*mir_arena),
            mut_view(*backend_arena),
            view(hir),
            unsafe { mut_view(*thir_ptr) },
            FileId { v: fid_v },
            mut_view(*out)
        );
        if !ok_mc {
            dump_sv(StrView { ptr: path_sv.ptr, len: path_sv.len });
            print("\n--- MC VERIFY FAILED ---\n");
            rc = 350 + (case_idx as i32);
        } else {
            let exp_fn_count = count_newlines(exp_mc.ptr, exp_mc.len);
            if !validate_mc_hex_output(out.ptr as *const u8, out.len, exp_fn_count) {
                dump_sv(StrView { ptr: path_sv.ptr, len: path_sv.len });
                print("\n--- ACTUAL MC MALFORMED ---\n");
                dump_sv(StrView { ptr: out.ptr as *const u8, len: out.len });
                rc = 400 + (case_idx as i32);
            } else if path_is_main_42(path_sv.ptr, path_sv.len) {
                if !bytes_eq_main_42_mc(out.ptr as *const u8, out.len) {
                    dump_sv(StrView { ptr: path_sv.ptr, len: path_sv.len });
                    print("\n--- ACTUAL MC MAIN_42 MISMATCH ---\n");
                    dump_sv(StrView { ptr: out.ptr as *const u8, len: out.len });
                    rc = 425 + (case_idx as i32);
                }
            }
        }
        arena_reset(mut_view(*backend_arena));
        arena_reset(mut_view(*mir_arena));
    }

    if rc == 0 {
        let mut obj = objmodel_new();
        let ok_obj = session_emit_objmodel_hir(
            mut_view(*sess),
            mut_view(*mir_arena),
            mut_view(*backend_arena),
            view(hir),
            unsafe { mut_view(*thir_ptr) },
            FileId { v: fid_v },
            true,
            false,
            true,
            mut_view(obj)
        );
        if !ok_obj {
            dump_sv(StrView { ptr: path_sv.ptr, len: path_sv.len });
            print("\n--- OBJMODEL EMIT FAILED ---\n");
            rc = 450 + (case_idx as i32);
        } else {
            let text_name = mimc_text_ptr(mut_view(*scratch));
            let text_id = objmodel_find_section_bytes(view(obj), text_name, 5);
            let text_sec = objmodel_get_section(view(obj), text_id);
            if (text_sec as usize) == 0 || (unsafe { section_bytes_len(view(*text_sec)) }) == 0 {
                dump_sv(StrView { ptr: path_sv.ptr, len: path_sv.len });
                print("\n--- OBJMODEL EMPTY TEXT ---\n");
                rc = 475 + (case_idx as i32);
            }
        }
        objmodel_free(mut_view(obj));
        arena_reset(mut_view(*backend_arena));
        arena_reset(mut_view(*mir_arena));
    }

    resolve_map_free(mut_view(*rmap));
    unsafe {
        thir_free(mut_view(*thir_ptr));
    }
    arena_reset(mut_view(*hir_arena));
    arena_reset(mut_view(*resolve_arena));
    arena_reset(mut_view(*parse_arena));
    arena_reset(mut_view(*scratch));
    session_free(mut_view(*sess));
    rc
}

fn run_mir_mimc_case(
    backend_arena: mut_view<Arena>,
    scratch: mut_view<Arena>,
    ti_ptr: *mut TypeInterner,
    out: mut_view<DiagBuffer>,
    mir_idx: usize
) -> i32 {
    let base = (((MIMC_AX_COUNT as i64) * 4i64) + ((mir_idx as i64) * 4i64)) as usize;
    let path_sv = get_blob_sv(mut_view(*scratch), base);
    let mir_sv = get_blob_sv(mut_view(*scratch), base + 1);
    let exp_mi = get_blob_sv(mut_view(*scratch), base + 2);
    let exp_mc = get_blob_sv(mut_view(*scratch), base + 3);

    unsafe {
        (*ti_ptr).arena = arena_with_chunk_size(65536);
        type_interner_init(mut_view(*ti_ptr));
    }
    out.len = 0;
    let ok_mi = session_emit_mi_mir_text(
        mut_view(*backend_arena),
        ti_ptr,
        StrView { ptr: mir_sv.ptr, len: mir_sv.len },
        mut_view(*out)
    );
    unsafe {
        type_interner_free(mut_view(*ti_ptr));
    }
    arena_reset(mut_view(*backend_arena));

    let mut rc: i32 = 0;
    if !ok_mi {
        dump_sv(StrView { ptr: path_sv.ptr, len: path_sv.len });
        print("\n--- MIR->MI FAILED ---\n");
        rc = 500 + (mir_idx as i32);
    } else if !bytes_equal(out.ptr as *const u8, out.len, exp_mi.ptr, exp_mi.len) {
        dump_sv(StrView { ptr: path_sv.ptr, len: path_sv.len });
        print("\n--- ACTUAL MIR MI ---\n");
        dump_sv(StrView { ptr: out.ptr as *const u8, len: out.len });
        print("--- EXPECTED MIR MI ---\n");
        dump_sv(exp_mi);
        rc = 600 + (mir_idx as i32);
    }

    if rc == 0 {
        unsafe {
            (*ti_ptr).arena = arena_with_chunk_size(65536);
            type_interner_init(mut_view(*ti_ptr));
        }
        out.len = 0;
        let ok_mc = session_emit_mc_mir_text(
            mut_view(*backend_arena),
            ti_ptr,
            StrView { ptr: mir_sv.ptr, len: mir_sv.len },
            mut_view(*out)
        );
        unsafe {
            type_interner_free(mut_view(*ti_ptr));
        }
        arena_reset(mut_view(*backend_arena));
        if !ok_mc {
            dump_sv(StrView { ptr: path_sv.ptr, len: path_sv.len });
            print("\n--- MIR->MC FAILED ---\n");
            rc = 700 + (mir_idx as i32);
        } else {
            let exp_fn_count = count_newlines(exp_mc.ptr, exp_mc.len);
            if !validate_mc_hex_output(out.ptr as *const u8, out.len, exp_fn_count) {
                dump_sv(StrView { ptr: path_sv.ptr, len: path_sv.len });
                print("\n--- ACTUAL MIR MC MALFORMED ---\n");
                dump_sv(StrView { ptr: out.ptr as *const u8, len: out.len });
                rc = 800 + (mir_idx as i32);
            }
        }
    }

    arena_reset(mut_view(*scratch));
    rc
}

fn run_all_cases(param: *mut u8) -> u32 {
    let mut perm_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(perm_arena), 16, 8);
    let sess_ptr = arena_alloc_raw(mut_view(perm_arena), size_of<CompilerSession>(), align_of<CompilerSession>()) as *mut CompilerSession;
    let ti_ptr = arena_alloc_raw(mut_view(perm_arena), size_of<TypeInterner>(), align_of<TypeInterner>()) as *mut TypeInterner;
    let thir_ptr = arena_alloc_raw(mut_view(perm_arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;

    let mut parse_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(parse_arena), 16, 8);
    let mut resolve_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(resolve_arena), 16, 8);
    let mut hir_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(hir_arena), 16, 8);
    let mut mir_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(mir_arena), 16, 8);
    let mut backend_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(backend_arena), 16, 8);
    let mut scratch = arena_with_chunk_size(65536);
    let _ = arena_alloc_raw(mut_view(scratch), 16, 8);

    let mut out = diag_buf_new();
    out.ptr = arena_alloc_raw(mut_view(perm_arena), 131072, 1);
    out.cap = 131072;

    let mut rmap = ResolveMap {
        node_map: NodeMap { keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0 },
        module_access_nodes: NodeMap { keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0 },
        extern_nodes: NodeMap { keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0 },
        next_symbol_v: 1u32,
        next_std_symbol_v: 10000u32,
        naming_ctx: 0 as *mut NamingCtx,
    };

    let mut idx: usize = 0;
    while idx < MIMC_AX_COUNT {
        let rc = run_ax_mimc_case(
            unsafe { mut_view(*sess_ptr) },
            mut_view(parse_arena),
            mut_view(resolve_arena),
            mut_view(hir_arena),
            mut_view(mir_arena),
            mut_view(backend_arena),
            mut_view(scratch),
            mut_view(rmap),
            thir_ptr,
            mut_view(out),
            idx
        );
        if rc != 0 {
            return rc as u32;
        }
        idx = idx + 1;
    }

    let mut midx: usize = 0;
    while midx < MIMC_MIR_COUNT {
        let rc = run_mir_mimc_case(
            mut_view(backend_arena),
            mut_view(scratch),
            ti_ptr,
            mut_view(out),
            midx
        );
        if rc != 0 {
            return rc as u32;
        }
        midx = midx + 1;
    }

    arena_destroy(mut_view(scratch));
    arena_destroy(mut_view(backend_arena));
    arena_destroy(mut_view(mir_arena));
    arena_destroy(mut_view(hir_arena));
    arena_destroy(mut_view(resolve_arena));
    arena_destroy(mut_view(parse_arena));
    arena_destroy(mut_view(perm_arena));
    // __OK_PRINT__
    0u32
}

pub fn main() -> i32 {
    if MIMC_AX_COUNT <= 10 {
        return run_all_cases(0 as *mut u8) as i32;
    }
    let mut tid: u32 = 0u32;
    let h = unsafe { CreateThread(0 as *mut u8, 16777216, run_all_cases, 0 as *mut u8, 0u32, address_of_mut(tid)) };
    unsafe { WaitForSingleObject(h, 0xFFFFFFFFu32); }
    let mut code: u32 = 1u32;
    unsafe {
        GetExitCodeThread(h, address_of_mut(code));
        CloseHandle(h);
    }
    code as i32
}
