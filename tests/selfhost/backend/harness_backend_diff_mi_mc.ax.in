//   1: "tests/run/native_aggr/004-large-struct.ax"  (42..83)
//   2: "tests/run/native_enum/03-nested.ax"         (83..117)
//   3: "tests/run/native_enum/04-large-payload.ax"  (117..158)
//   4: "tests/run/native_enum/05-nested-enum.ax"    (158..197)
