@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

// 0..4 (5): ".text", 5..10 (6): ".rdata", 11..14 (4): "main", 15..25 (11): "axiom_panic"
const UNIT_STR_NAMES: [26]u8 = [
    46u8, 116u8, 101u8, 120u8, 116u8,
    46u8, 114u8, 100u8, 97u8, 116u8, 97u8,
    109u8, 97u8, 105u8, 110u8,
    97u8, 120u8, 105u8, 111u8, 109u8, 95u8, 112u8, 97u8, 110u8, 105u8, 99u8,
];

// __BLOB_TABLES__

fn get_unit_sv(scratch: mut_view<Arena>, idx: usize) -> StrView {
    let start = UNIT_OFFS[idx] as usize;
    let end = UNIT_OFFS[idx + 1] as usize;
    let slen = end - start;
    if slen == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let buf = arena_alloc_raw(mut_view(*scratch), slen + 1, 1);
    let mut i: usize = 0;
    while i < slen {
        unsafe {
            *(buf + i) = UNIT_DATA[start + i];
        }
        i = i + 1;
    }
    unsafe {
        *(buf + slen) = 0u8;
    }
    StrView { ptr: buf as *const u8, len: slen }
}

fn unit_name_ptr(scratch: mut_view<Arena>, off: usize, slen: usize) -> *const u8 {
    let buf = arena_alloc_raw(mut_view(*scratch), slen + 1, 1);
    let mut i: usize = 0;
    while i < slen {
        unsafe {
            *(buf + i) = UNIT_STR_NAMES[off + i];
        }
        i = i + 1;
    }
    unsafe {
        *(buf + slen) = 0u8;
    }
    buf as *const u8
}

fn bytes_equal(a: *const u8, a_len: usize, b: *const u8, b_len: usize) -> bool {
    if a_len != b_len {
        return false;
    }
    let mut i: usize = 0;
    while i < a_len {
        if (unsafe { *(a + i) }) != (unsafe { *(b + i) }) {
            return false;
        }
        i = i + 1;
    }
    true
}

fn run_mir_text_case(
    arena: mut_view<Arena>,
    scratch: mut_view<Arena>,
    ti_ptr: *mut TypeInterner,
    out: mut_view<DiagBuffer>,
    case_idx: usize
) -> i32 {
    let base = ((case_idx as i64) * 4i64) as usize;
    let mir_sv = get_unit_sv(mut_view(*scratch), base);
    let exp_lir = get_unit_sv(mut_view(*scratch), base + 1);
    let exp_mi = get_unit_sv(mut_view(*scratch), base + 2);
    let exp_mc = get_unit_sv(mut_view(*scratch), base + 3);

    unsafe {
        (*ti_ptr).arena = arena_with_chunk_size(65536);
        type_interner_init(mut_view(*ti_ptr));
    }
    out.len = 0;
    let ok_lir = session_emit_lir_mir_text(
        mut_view(*arena),
        ti_ptr,
        StrView { ptr: mir_sv.ptr, len: mir_sv.len },
        mut_view(*out)
    );
    unsafe { type_interner_free(mut_view(*ti_ptr)); }
    arena_reset(mut_view(*arena));
    if !ok_lir {
        return 100 + (case_idx as i32);
    }
    if !bytes_equal(out.ptr as *const u8, out.len, exp_lir.ptr, exp_lir.len) {
        return 120 + (case_idx as i32);
    }

    if exp_mi.len > 0 {
        unsafe {
            (*ti_ptr).arena = arena_with_chunk_size(65536);
            type_interner_init(mut_view(*ti_ptr));
        }
        out.len = 0;
        let ok_mi = session_emit_mi_mir_text(
            mut_view(*arena),
            ti_ptr,
            StrView { ptr: mir_sv.ptr, len: mir_sv.len },
            mut_view(*out)
        );
        unsafe { type_interner_free(mut_view(*ti_ptr)); }
        arena_reset(mut_view(*arena));
        if !ok_mi {
            return 200 + (case_idx as i32);
        }
        if !bytes_equal(out.ptr as *const u8, out.len, exp_mi.ptr, exp_mi.len) {
            return 220 + (case_idx as i32);
        }
    }

    if exp_mc.len > 0 {
        unsafe {
            (*ti_ptr).arena = arena_with_chunk_size(65536);
            type_interner_init(mut_view(*ti_ptr));
        }
        out.len = 0;
        let ok_mc = session_emit_mc_mir_text(
            mut_view(*arena),
            ti_ptr,
            StrView { ptr: mir_sv.ptr, len: mir_sv.len },
            mut_view(*out)
        );
        unsafe { type_interner_free(mut_view(*ti_ptr)); }
        arena_reset(mut_view(*arena));
        if !ok_mc {
            return 300 + (case_idx as i32);
        }
        if !bytes_equal(out.ptr as *const u8, out.len, exp_mc.ptr, exp_mc.len) {
            return 320 + (case_idx as i32);
        }
    }

    arena_reset(mut_view(*scratch));
    0
}

fn run_objmodel_unit_test(
    sess: mut_view<CompilerSession>,
    parse_arena: mut_view<Arena>,
    resolve_arena: mut_view<Arena>,
    hir_arena: mut_view<Arena>,
    mir_arena: mut_view<Arena>,
    backend_arena: mut_view<Arena>,
    scratch: mut_view<Arena>,
    rmap: mut_view<ResolveMap>,
    thir_ptr: *mut Thir,
    ax_blob_idx: usize,
    full_native_mode: bool
) -> i32 {
    session_init(mut_view(*sess));
    let int_arena = arena_with_chunk_size(65536);
    unsafe {
        (*thir_ptr).interner.arena = int_arena;
        thir_init(mut_view(*thir_ptr));
    }
    let path_sv = get_unit_sv(mut_view(*scratch), ax_blob_idx);
    let src_sv = get_unit_sv(mut_view(*scratch), ax_blob_idx + 1);
    let mut obj = objmodel_new();

    let rc = session_compile_and_emit_objmodel(
        mut_view(*sess),
        mut_view(*parse_arena),
        mut_view(*resolve_arena),
        mut_view(*hir_arena),
        mut_view(*mir_arena),
        mut_view(*backend_arena),
        mut_view(*rmap),
        unsafe { mut_view(*thir_ptr) },
        path_sv,
        src_sv,
        false,
        true,
        false,
        full_native_mode,
        mut_view(obj)
    );
    let mut err: i32 = 0;
    if rc != 0 {
        err = 400 + rc;
    } else if objmodel_section_count(view(obj)) != 2 {
        err = 410;
    } else {
        let text_name = unit_name_ptr(mut_view(*scratch), 0, 5);
        let rdata_name = unit_name_ptr(mut_view(*scratch), 5, 6);
        let main_name = unit_name_ptr(mut_view(*scratch), 11, 4);
        let panic_name = unit_name_ptr(mut_view(*scratch), 15, 11);
        let text_id = objmodel_find_section_bytes(view(obj), text_name, 5);
        let rdata_id = objmodel_find_section_bytes(view(obj), rdata_name, 6);
        let text_sec = objmodel_get_section(view(obj), text_id);
        let rdata_sec = objmodel_get_section(view(obj), rdata_id);
        if (text_sec as usize) == 0 || (rdata_sec as usize) == 0 {
            err = 420;
        } else if (unsafe { section_bytes_len(view(*text_sec)) }) == 0 {
            err = 430;
        } else if (unsafe { section_bytes_len(view(*rdata_sec)) }) == 0 {
            err = 440;
        } else if objmodel_symbol_count(view(obj)) < 3 {
            err = 450;
        } else if ax_symbol_id_is_none(objmodel_find_symbol_bytes(view(obj), main_name, 4)) {
            err = 460;
        } else if full_native_mode {
            if ax_symbol_id_is_none(objmodel_find_symbol_bytes(view(obj), panic_name, 11)) {
                err = 470;
            } else if (unsafe { section_relocs_len(view(*text_sec)) }) == 0 {
                err = 480;
            }
        }
    }

    objmodel_free(mut_view(obj));
    unsafe {
        thir_free(mut_view(*thir_ptr));
    }
    arena_reset(mut_view(*backend_arena));
    arena_reset(mut_view(*mir_arena));
    arena_reset(mut_view(*hir_arena));
    arena_reset(mut_view(*resolve_arena));
    arena_reset(mut_view(*parse_arena));
    arena_reset(mut_view(*scratch));
    session_free(mut_view(*sess));
    err
}

// 0..8 (8): " = udiv "
// 8..16 (8): " = urem "
// 16..33 (17): " = umul_overflow "
// 33..44 (11): "shr r10, 63"
// 44..55 (11): "sar rdx, 63"
// 55..65 (10): "shr r8, 32"
// 65..70 (5): "imul "
// 70..90 (20): "18446744073709551615"
const T140_NEEDLES: [90]u8 = [
    32u8, 61u8, 32u8, 117u8, 100u8, 105u8, 118u8, 32u8,
    32u8, 61u8, 32u8, 117u8, 114u8, 101u8, 109u8, 32u8,
    32u8, 61u8, 32u8, 117u8, 109u8, 117u8, 108u8, 95u8, 111u8, 118u8, 101u8, 114u8, 102u8, 108u8, 111u8, 119u8, 32u8,
    115u8, 104u8, 114u8, 32u8, 114u8, 49u8, 48u8, 44u8, 32u8, 54u8, 51u8,
    115u8, 97u8, 114u8, 32u8, 114u8, 100u8, 120u8, 44u8, 32u8, 54u8, 51u8,
    115u8, 104u8, 114u8, 32u8, 114u8, 56u8, 44u8, 32u8, 51u8, 50u8,
    105u8, 109u8, 117u8, 108u8, 32u8,
    49u8, 56u8, 52u8, 52u8, 54u8, 55u8, 52u8, 52u8, 48u8, 55u8, 51u8, 55u8, 48u8, 57u8, 53u8, 53u8, 49u8, 54u8, 49u8, 53u8,
];

fn has_t140_needle(hay: *const u8, hay_len: usize, off: usize, nlen: usize) -> bool {
    if hay_len < nlen {
        return false;
    }
    let limit = hay_len - nlen;
    let mut i: usize = 0;
    while i <= limit {
        let mut ok = true;
        let mut j: usize = 0;
        while j < nlen {
            if (unsafe { *(hay + i + j) }) != T140_NEEDLES[off + j] {
                ok = false;
                break;
            }
            j = j + 1;
        }
        if ok {
            return true;
        }
        i = i + 1;
    }
    false
}

fn print_ascii_digits(ptr: *const u8, len: usize) {
    let mut i: usize = 0;
    while i < len {
        let b = unsafe { *(ptr + i) };
        if b == 48u8 { print("0"); }
        else if b == 49u8 { print("1"); }
        else if b == 50u8 { print("2"); }
        else if b == 51u8 { print("3"); }
        else if b == 52u8 { print("4"); }
        else if b == 53u8 { print("5"); }
        else if b == 54u8 { print("6"); }
        else if b == 55u8 { print("7"); }
        else if b == 56u8 { print("8"); }
        else if b == 57u8 { print("9"); }
        else if b == 10u8 { print("\n"); }
        i = i + 1;
    }
}

fn run_t140_port_int_sem_test(
    backend_arena: mut_view<Arena>,
    scratch: mut_view<Arena>,
    ti_ptr: *mut TypeInterner,
    out: mut_view<DiagBuffer>,
    t140_blob_idx: usize
) -> i32 {
    // 1. Format maximum u64 (0xFFFF_FFFF_FFFF_FFFFu64) via ported lir_buf_push_u64 and mir_buf_push_u64
    out.len = 0;
    lir_buf_push_u64(mut_view(*out), 0xFFFF_FFFF_FFFF_FFFFu64);
    if !has_t140_needle(out.ptr as *const u8, out.len, 70, 20) || out.len != 20 {
        return 601;
    }
    diag_buf_push_byte(mut_view(*out), 10u8);
    mir_buf_push_u64(mut_view(*out), 0xFFFF_FFFF_FFFF_FFFFu64);
    if out.len != 41 || !has_t140_needle(unsafe { (out.ptr as *const u8) + 21 }, 20, 70, 20) {
        return 602;
    }
    diag_buf_push_byte(mut_view(*out), 10u8);
    print_ascii_digits(out.ptr as *const u8, out.len);

    // 2. Lower T140_MIR_SRC to LIR via ported compiler/lir/builder.ax and check udiv, urem, umul_overflow
    let mir_sv = get_unit_sv(mut_view(*scratch), t140_blob_idx);
    unsafe {
        (*ti_ptr).arena = arena_with_chunk_size(65536);
        type_interner_init(mut_view(*ti_ptr));
    }
    out.len = 0;
    let ok_lir = session_emit_lir_mir_text(
        mut_view(*backend_arena),
        ti_ptr,
        StrView { ptr: mir_sv.ptr, len: mir_sv.len },
        mut_view(*out)
    );
    unsafe { type_interner_free(mut_view(*ti_ptr)); }
    arena_reset(mut_view(*backend_arena));
    if !ok_lir {
        return 610;
    }
    if !has_t140_needle(out.ptr as *const u8, out.len, 0, 8) {
        return 620;
    }
    if !has_t140_needle(out.ptr as *const u8, out.len, 8, 8) {
        return 621;
    }
    if !has_t140_needle(out.ptr as *const u8, out.len, 16, 17) {
        return 622;
    }

    // 3. Emit MI & MC via ported x64 isel + frame and verify unsigned udiv/urem path and 64-bit umul_overflow check
    unsafe {
        (*ti_ptr).arena = arena_with_chunk_size(65536);
        type_interner_init(mut_view(*ti_ptr));
    }
    out.len = 0;
    let ok_mi = session_emit_mi_mir_text(
        mut_view(*backend_arena),
        ti_ptr,
        StrView { ptr: mir_sv.ptr, len: mir_sv.len },
        mut_view(*out)
    );
    unsafe { type_interner_free(mut_view(*ti_ptr)); }
    arena_reset(mut_view(*backend_arena));
    if !ok_mi {
        return 630;
    }
    if !has_t140_needle(out.ptr as *const u8, out.len, 33, 11) {
        return 631;
    }
    if has_t140_needle(out.ptr as *const u8, out.len, 44, 11) {
        return 632;
    }
    if !has_t140_needle(out.ptr as *const u8, out.len, 55, 10) {
        return 633;
    }
    if !has_t140_needle(out.ptr as *const u8, out.len, 65, 5) {
        return 634;
    }

    unsafe {
        (*ti_ptr).arena = arena_with_chunk_size(65536);
        type_interner_init(mut_view(*ti_ptr));
    }
    out.len = 0;
    let ok_mc = session_emit_mc_mir_text(
        mut_view(*backend_arena),
        ti_ptr,
        StrView { ptr: mir_sv.ptr, len: mir_sv.len },
        mut_view(*out)
    );
    unsafe { type_interner_free(mut_view(*ti_ptr)); }
    arena_reset(mut_view(*backend_arena));
    arena_reset(mut_view(*scratch));
    if !ok_mc || out.len == 0 {
        return 638;
    }
    0
}

pub fn main() -> i32 {
    let mut perm_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(perm_arena), 16, 8);
    let sess_ptr = arena_alloc_raw(mut_view(perm_arena), size_of<CompilerSession>(), align_of<CompilerSession>()) as *mut CompilerSession;
    let ti_ptr = arena_alloc_raw(mut_view(perm_arena), size_of<TypeInterner>(), align_of<TypeInterner>()) as *mut TypeInterner;
    let thir_ptr = arena_alloc_raw(mut_view(perm_arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;

    let mut parse_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(parse_arena), 16, 8);
    let mut resolve_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(resolve_arena), 16, 8);
    let mut hir_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(hir_arena), 16, 8);
    let mut mir_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(mir_arena), 16, 8);
    let mut backend_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(backend_arena), 16, 8);
    let mut scratch = arena_with_chunk_size(65536);
    let _ = arena_alloc_raw(mut_view(scratch), 16, 8);

    let mut out = diag_buf_new();
    out.ptr = arena_alloc_raw(mut_view(perm_arena), 65536, 1);
    out.cap = 65536;

    let rmap_ptr = arena_alloc_raw(mut_view(perm_arena), size_of<ResolveMap>(), align_of<ResolveMap>()) as *mut ResolveMap;
    unsafe {
        (*rmap_ptr).node_map = NodeMap { keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0 };
        (*rmap_ptr).module_access_nodes = NodeMap { keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0 };
        (*rmap_ptr).extern_nodes = NodeMap { keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0 };
        (*rmap_ptr).next_symbol_v = 1u32;
        (*rmap_ptr).next_std_symbol_v = 10000u32;
        (*rmap_ptr).naming_ctx = 0 as *mut NamingCtx;
    }

    let mut idx: usize = 0;
    while idx < UNIT_MIR_CASE_COUNT {
        let rc = run_mir_text_case(
            mut_view(backend_arena),
            mut_view(scratch),
            ti_ptr,
            mut_view(out),
            idx
        );
        if rc != 0 {
            return rc;
        }
        idx = idx + 1;
    }

    let ax_blob_idx = ((UNIT_MIR_CASE_COUNT as i64) * 4i64) as usize;
    let rc_obj0 = run_objmodel_unit_test(
        unsafe { mut_view(*sess_ptr) },
        mut_view(parse_arena),
        mut_view(resolve_arena),
        mut_view(hir_arena),
        mut_view(mir_arena),
        mut_view(backend_arena),
        mut_view(scratch),
        unsafe { mut_view(*rmap_ptr) },
        thir_ptr,
        ax_blob_idx,
        false
    );
    if rc_obj0 != 0 {
        return rc_obj0;
    }

    let rc_obj1 = run_objmodel_unit_test(
        unsafe { mut_view(*sess_ptr) },
        mut_view(parse_arena),
        mut_view(resolve_arena),
        mut_view(hir_arena),
        mut_view(mir_arena),
        mut_view(backend_arena),
        mut_view(scratch),
        unsafe { mut_view(*rmap_ptr) },
        thir_ptr,
        ax_blob_idx,
        true
    );
    if rc_obj1 != 0 {
        return rc_obj1 + 50;
    }

    let t140_blob_idx = ax_blob_idx + 2;
    let rc_t140 = run_t140_port_int_sem_test(
        mut_view(backend_arena),
        mut_view(scratch),
        ti_ptr,
        mut_view(out),
        t140_blob_idx
    );
    if rc_t140 != 0 {
        return rc_t140;
    }

    arena_destroy(mut_view(scratch));
    arena_destroy(mut_view(backend_arena));
    arena_destroy(mut_view(mir_arena));
    arena_destroy(mut_view(hir_arena));
    arena_destroy(mut_view(resolve_arena));
    arena_destroy(mut_view(parse_arena));
    arena_destroy(mut_view(perm_arena));
    print("OK Backend Unit & ObjModel\n");
    0
}
