module main

use compiler.kernel.arena.Arena
use compiler.kernel.arena.arena_with_chunk_size
use compiler.kernel.arena.arena_reset
use compiler.kernel.arena.arena_destroy
use compiler.kernel.arena.arena_alloc_raw
use compiler.kernel.id.SymbolId
use compiler.kernel.interner.StrView
use compiler.diag.format.DiagBuffer
use compiler.diag.format.diag_buf_new
use compiler.kernel_source_diag.session.CompilerSession
use compiler.kernel_source_diag.session.session_init
use compiler.kernel_source_diag.session.session_free
use compiler.resolve.symtab.NodeMap
use compiler.resolve.symtab.NamingCtx
use compiler.resolve.symtab.ResolveMap
use compiler.types.types.TypeInterner
use compiler.types.types.type_interner_init
use compiler.types.types.type_interner_free
use compiler.types.types.Thir
use compiler.types.types.thir_init
use compiler.types.types.thir_free
use compiler.backend.session.session_emit_lir_mir_text
use compiler.backend.session.session_compile_and_emit_lir

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

// __BLOB_TABLES__

fn get_blob_sv(scratch: mut_view<Arena>, idx: usize) -> StrView {
    let start = LIR_OFFS[idx] as usize;
    let end = LIR_OFFS[idx + 1] as usize;
    let slen = end - start;
    if slen == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let buf = arena_alloc_raw(mut_view(*scratch), slen + 1, 1);
    let mut i: usize = 0;
    while i < slen {
        unsafe {
            *(buf + i) = LIR_DATA[start + i];
        }
        i = i + 1;
    }
    unsafe {
        *(buf + slen) = 0u8;
    }
    StrView { ptr: buf as *const u8, len: slen }
}

fn bytes_equal(a: *const u8, a_len: usize, b: *const u8, b_len: usize) -> bool {
    if a_len != b_len {
        return false;
    }
    let mut i: usize = 0;
    while i < a_len {
        if (unsafe { *(a + i) }) != (unsafe { *(b + i) }) {
            return false;
        }
        i = i + 1;
    }
    true
}

fn dump_sv(sv: StrView) {
    if sv.len > 0 && (sv.ptr as usize) != 0 {
        let s: str = unsafe { *(address_of(sv) as *const str) };
        print(s);
    }
}

fn run_ax_lir_case(
    sess: mut_view<CompilerSession>,
    parse_arena: mut_view<Arena>,
    resolve_arena: mut_view<Arena>,
    hir_arena: mut_view<Arena>,
    mir_arena: mut_view<Arena>,
    backend_arena: mut_view<Arena>,
    scratch: mut_view<Arena>,
    rmap: mut_view<ResolveMap>,
    thir_ptr: *mut Thir,
    out: mut_view<DiagBuffer>,
    case_idx: usize
) -> i32 {
    session_init(mut_view(*sess));
    let int_arena = arena_with_chunk_size(65536);
    unsafe {
        (*thir_ptr).interner.arena = int_arena;
        thir_init(mut_view(*thir_ptr));
    }
    out.len = 0;

    let base = ((case_idx as i64) * 3i64) as usize;
    let path_sv = get_blob_sv(mut_view(*scratch), base);
    let src_sv = get_blob_sv(mut_view(*scratch), base + 1);
    let exp_lir = get_blob_sv(mut_view(*scratch), base + 2);
    let load_prelude = LIR_PRELUDE_FLAGS[case_idx] != 0u32;

    let step_rc = session_compile_and_emit_lir(
        mut_view(*sess),
        mut_view(*parse_arena),
        mut_view(*resolve_arena),
        mut_view(*hir_arena),
        mut_view(*mir_arena),
        mut_view(*backend_arena),
        mut_view(*rmap),
        unsafe { mut_view(*thir_ptr) },
        StrView { ptr: path_sv.ptr, len: path_sv.len },
        src_sv,
        load_prelude,
        false,
        false,
        mut_view(*out)
    );

    let mut rc: i32 = 0;
    if step_rc != 0 {
        dump_sv(path_sv);
        print("\n--- LIR COMPILE FAILED ---\n");
        rc = step_rc + (case_idx as i32);
    } else if !bytes_equal(out.ptr as *const u8, out.len, exp_lir.ptr, exp_lir.len) {
        dump_sv(path_sv);
        print("\n--- ACTUAL LIR ---\n");
        dump_sv(StrView { ptr: out.ptr as *const u8, len: out.len });
        print("--- EXPECTED LIR ---\n");
        dump_sv(exp_lir);
        rc = 300 + (case_idx as i32);
    }

    unsafe {
        thir_free(mut_view(*thir_ptr));
    }
    arena_reset(mut_view(*backend_arena));
    arena_reset(mut_view(*mir_arena));
    arena_reset(mut_view(*hir_arena));
    arena_reset(mut_view(*resolve_arena));
    arena_reset(mut_view(*parse_arena));
    arena_reset(mut_view(*scratch));
    session_free(mut_view(*sess));
    rc
}

fn run_mir_lir_case(
    backend_arena: mut_view<Arena>,
    scratch: mut_view<Arena>,
    ti_ptr: *mut TypeInterner,
    out: mut_view<DiagBuffer>,
    mir_idx: usize
) -> i32 {
    unsafe {
        (*ti_ptr).arena = arena_with_chunk_size(65536);
        type_interner_init(mut_view(*ti_ptr));
    }
    out.len = 0;

    let base = (((LIR_AX_COUNT as i64) * 3i64) + ((mir_idx as i64) * 3i64)) as usize;
    let path_sv = get_blob_sv(mut_view(*scratch), base);
    let mir_sv = get_blob_sv(mut_view(*scratch), base + 1);
    let exp_lir = get_blob_sv(mut_view(*scratch), base + 2);

    let ok = session_emit_lir_mir_text(mut_view(*backend_arena), ti_ptr, mir_sv, mut_view(*out));
    let mut rc: i32 = 0;
    if !ok {
        dump_sv(path_sv);
        print("\n--- MIR->LIR FAILED ---\n");
        rc = 500 + (mir_idx as i32);
    } else if !bytes_equal(out.ptr as *const u8, out.len, exp_lir.ptr, exp_lir.len) {
        dump_sv(path_sv);
        print("\n--- ACTUAL MIR LIR ---\n");
        dump_sv(StrView { ptr: out.ptr as *const u8, len: out.len });
        print("--- EXPECTED MIR LIR ---\n");
        dump_sv(exp_lir);
        rc = 600 + (mir_idx as i32);
    }

    unsafe {
        type_interner_free(mut_view(*ti_ptr));
    }
    arena_reset(mut_view(*backend_arena));
    arena_reset(mut_view(*scratch));
    rc
}

pub fn main() -> i32 {
    let mut perm_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(perm_arena), 16, 8);
    let sess_ptr = arena_alloc_raw(mut_view(perm_arena), size_of<CompilerSession>(), align_of<CompilerSession>()) as *mut CompilerSession;
    let ti_ptr = arena_alloc_raw(mut_view(perm_arena), size_of<TypeInterner>(), align_of<TypeInterner>()) as *mut TypeInterner;
    let thir_ptr = arena_alloc_raw(mut_view(perm_arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;

    let mut parse_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(parse_arena), 16, 8);
    let mut resolve_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(resolve_arena), 16, 8);
    let mut hir_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(hir_arena), 16, 8);
    let mut mir_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(mir_arena), 16, 8);
    let mut backend_arena = arena_with_chunk_size(262144);
    let _ = arena_alloc_raw(mut_view(backend_arena), 16, 8);
    let mut scratch = arena_with_chunk_size(65536);
    let _ = arena_alloc_raw(mut_view(scratch), 16, 8);

    let mut out = diag_buf_new();
    out.ptr = arena_alloc_raw(mut_view(perm_arena), 131072, 1);
    out.cap = 131072;

    let mut rmap = ResolveMap {
        node_map: NodeMap { keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0 },
        module_access_nodes: NodeMap { keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0 },
        extern_nodes: NodeMap { keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0 },
        next_symbol_v: 1u32,
        next_std_symbol_v: 10000u32,
        naming_ctx: 0 as *mut NamingCtx,
    };

    let mut idx: usize = 0;
    while idx < LIR_AX_COUNT {
        let rc = run_ax_lir_case(
            unsafe { mut_view(*sess_ptr) },
            mut_view(parse_arena),
            mut_view(resolve_arena),
            mut_view(hir_arena),
            mut_view(mir_arena),
            mut_view(backend_arena),
            mut_view(scratch),
            mut_view(rmap),
            thir_ptr,
            mut_view(out),
            idx
        );
        if rc != 0 {
            return rc;
        }
        idx = idx + 1;
    }

    let mut midx: usize = 0;
    while midx < LIR_MIR_COUNT {
        let rc = run_mir_lir_case(
            mut_view(backend_arena),
            mut_view(scratch),
            ti_ptr,
            mut_view(out),
            midx
        );
        if rc != 0 {
            return rc;
        }
        midx = midx + 1;
    }

    arena_destroy(mut_view(scratch));
    arena_destroy(mut_view(backend_arena));
    arena_destroy(mut_view(mir_arena));
    arena_destroy(mut_view(hir_arena));
    arena_destroy(mut_view(resolve_arena));
    arena_destroy(mut_view(parse_arena));
    arena_destroy(mut_view(perm_arena));
    // __OK_PRINT__
    0
}
