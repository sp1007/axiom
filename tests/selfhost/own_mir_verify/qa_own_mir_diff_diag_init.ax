use compiler.kernel.interner.interner_intern_bytes
use compiler.source.manager.SourceDatabase
use compiler.hir.hir.HIR_ITEM_FN
use compiler.hir.hir.HIR_ITEM_IMPL
use compiler.hir.hir.HIR_ITEM_TRAIT
use compiler.hir.hir.HIR_TYPE_PATH
use compiler.hir.hir.HirFile
use compiler.hir.hir.HirGenericParams
use compiler.hir.hir.HirItem
use compiler.types.types.AxType
use compiler.types.types.ClosureCapture
use compiler.types.types.GenericArgsSlice
use compiler.types.types.TY_ARRAY
use compiler.types.types.TY_CLOSURE
use compiler.types.types.TY_ENUM
