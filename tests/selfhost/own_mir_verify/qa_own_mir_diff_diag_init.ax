                let _t97 = lower_type(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*cur).self_type);
                (*hi).self_type = _t97;
                let _t98 = lower_where_clause(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*cur).where_clause);
                (*hi).where_clause = _t98;
                let _t99 = lower_item(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*cur).members);
                (*hi).members = _t99;
            }
        } else if k == ITEM_TYPE_ALIAS {
            let sym_v = alloc_or_get_sym(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), cur as usize);
            unsafe {
                (*hi).kind = HIR_ITEM_TYPE_ALIAS;
                (*hi).name.v = (*cur).name.v;
                (*hi).symbol.v = sym_v;
                let _t100 = lower_generic_params(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*cur).generic_params);
                (*hi).generic_params = _t100;
                let _t101 = lower_type(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*cur).ty);
                (*hi).ty = _t101;
            }
        } else if k == ITEM_CONST {
            let sym_v = alloc_or_get_sym(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), cur as usize);
            unsafe {
                (*hi).kind = HIR_ITEM_CONST;
                (*hi).name.v = (*cur).name.v;
                (*hi).symbol.v = sym_v;
                let _t102 = lower_type(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*cur).ty);
                (*hi).ty = _t102;
                let _t103 = lower_expr(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*cur).expr);
                (*hi).expr = _t103;
            }
        } else if k == ITEM_STATIC {
            unsafe {
                (*hi).kind = HIR_ITEM_STATIC;
                (*hi).is_unsafe = (*cur).is_unsafe;
                (*hi).is_mut = (*cur).is_mut;
                (*hi).name.v = (*cur).name.v;
                let _t104 = lower_type(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*cur).ty);
                (*hi).ty = _t104;
                let _t105 = lower_expr(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*cur).expr);
                (*hi).expr = _t105;
            }
        } else if k == ITEM_EXTERN_BLOCK {
            unsafe {
                (*hi).kind = HIR_ITEM_EXTERN_BLOCK;
                (*hi).abi.v = (*cur).abi.v;
                let _t106 = lower_item(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), (*cur).members);
                (*hi).members = _t106;
                let mut m: *mut HirItem = (*hi).members;
                while (m as usize) != 0 {
                    if (*m).kind == HIR_ITEM_FN {
                        if (*m).abi.v == 0u32 {
                            (*m).abi.v = (*cur).abi.v;
                        }
                        if ((*hi).attrs as usize) != 0 {
                            if ((*m).attrs as usize) == 0 {
                                (*m).attrs = (*hi).attrs;
                            } else {
                                let mut at: *mut HirAttr = (*m).attrs;
                                while ((*at).next as usize) != 0 {
                                    at = (*at).next;
                                }
                                (*at).next = (*hi).attrs;
                            }
                        }
                    }
                    m = (*m).next;
                }
            }
        }
        if (tail as usize) == 0 {
            head = hi;
        } else {
            unsafe { (*tail).next = hi; }
        }
        tail = hi;
        cur = unsafe { (*cur).next };
    }
    head
}

pub fn lower_ast(arena: mut_view<Arena>, ast: view<Ast>, rmap: view<ResolveMap>, sink: mut_view<DiagSink>) -> HirFile {
    let mut ctx = LowerCtx {
        fake_sym_counter: 2147483648u32,
    };
    let items = lower_item(mut_view(ctx), mut_view(*arena), view(*rmap), mut_view(*sink), ast.items);
    HirFile { items: items }
}

@intrinsic fn size_of<T>() -> usize { 0 }

fn sv_eq_cstr4(sv: StrView, c0: u8, c1: u8, c2: u8, c3: u8) -> bool {
    if sv.len != 4 {
        return false;
    }
    unsafe {
        *(sv.ptr + 0) == c0 && *(sv.ptr + 1) == c1 && *(sv.ptr + 2) == c2 && *(sv.ptr + 3) == c3
    }
}

fn clone_hir_item_shallow(arena: mut_view<Arena>, src: *mut HirItem) -> *mut HirItem {
    let dst = unsafe { hir_alloc_item(arena, (*src).kind, (*src).span) };
    unsafe {
        (*dst).attrs = (*src).attrs;
        hir_copy_vis(mut_view((*dst).vis), (*src).vis.kind, (*src).vis.span);
        hir_copy_dotted(mut_view((*dst).module_path), view((*src).module_path));
        (*dst).next = 0 as *mut HirItem;
        hir_copy_dotted(mut_view((*dst).mod_path), view((*src).mod_path));
        (*dst).use_tree = (*src).use_tree;
        (*dst).is_async = (*src).is_async;
        (*dst).is_comptime = (*src).is_comptime;
        (*dst).is_unsafe = (*src).is_unsafe;
        (*dst).is_mut = (*src).is_mut;
        (*dst).is_tuple = (*src).is_tuple;
        (*dst).abi.v = (*src).abi.v;
        (*dst).name.v = (*src).name.v;
        (*dst).symbol.v = (*src).symbol.v;
        (*dst).generic_params = (*src).generic_params;
        (*dst).params = (*src).params;
        (*dst).ret_type = (*src).ret_type;
        (*dst).where_clause = (*src).where_clause;
        (*dst).body = (*src).body;
        (*dst).struct_fields = (*src).struct_fields;
        (*dst).tuple_types = (*src).tuple_types;
        (*dst).variants = (*src).variants;
        (*dst).supertraits = (*src).supertraits;
        (*dst).trait_path = (*src).trait_path;
        (*dst).self_type = (*src).self_type;
        (*dst).members = (*src).members;
        (*dst).ty = (*src).ty;
        (*dst).expr = (*src).expr;
    }
    dst
}

// SPEC-12 AXS-DROP-008 (ADR-0036 section 5): `impl P for T` declares the destructor of `T` iff the trait
// path `P` resolves to the prelude lang item `Drop`. In v0.1 that lang item is reached only by the bare
// name, so `P` is the language Drop iff
//   (1) `P` is the single segment `Drop` without generic arguments (`m.Drop` is a path to a user item), and
//   (2) the impl's module neither declares a trait, struct, enum or type alias named `Drop` nor binds the
//       name `Drop` with a `use` (a shadowing `trait Drop`, an imported `use m.Drop`): module scope
//       shadows the prelude.
// The same predicate decides the destructor renaming below, typeck's `$drop` mangling and registration
// (compiler/types/typeck.ax tc_impl_is_lang_drop) and drop elaboration (compiler/mir/drop.ax
// drop_impl_is_lang_drop); its C twin is ax_hir_impl_is_lang_drop in bootstrap/axiom0/src/mir/drop/drop.c.
fn hir_name_is_drop(interner: view<StrInterner>, id: StrId) -> bool {
    if id.v == 0u32 {
        return false;
    }
    sv_eq_cstr4(interner_get(interner, id), 68u8, 114u8, 111u8, 112u8)
}

fn hir_use_tree_binds_drop(interner: view<StrInterner>, t: *mut HirUseTree) -> bool {
    let mut cur: *mut HirUseTree = t;
    while (cur as usize) != 0 {
        let count = unsafe { (*cur).path.count };
        if (unsafe { (*cur).subtrees as usize }) != 0 {
            if hir_use_tree_binds_drop(interner, unsafe { (*cur).subtrees }) {
                return true;
            }
        } else if (unsafe { (*cur).alias.v }) != 0u32 {
            if hir_name_is_drop(interner, unsafe { (*cur).alias }) {
                return true;
            }
        } else if count > 0 {
            let off = (((count - 1) as isize) * (size_of<StrId>() as isize)) as usize;
            let seg_ptr = ((unsafe { (*cur).path.segments } as usize) + off) as *const StrId;
            if hir_name_is_drop(interner, unsafe { *seg_ptr }) {
                return true;
            }
        }
        cur = unsafe { (*cur).next };
    }
    false
}

fn hir_module_path_eq(a: *mut HirItem, b: *mut HirItem) -> bool {
    let count = unsafe { (*a).module_path.count };
    if count != (unsafe { (*b).module_path.count }) {
        return false;
    }
    let sa = unsafe { (*a).module_path.segments } as usize;
    let sb = unsafe { (*b).module_path.segments } as usize;
    let mut i: usize = 0;
    while i < count {
        let off = ((i as isize) * (size_of<StrId>() as isize)) as usize;
        let pa = (sa + off) as *const StrId;
        let pb = (sb + off) as *const StrId;
        if (unsafe { (*pa).v }) != (unsafe { (*pb).v }) {
            return false;
        }
        i = i + 1;
    }
    true
}

pub fn hir_impl_is_lang_drop(items: *mut HirItem, impl_item: *mut HirItem, interner: view<StrInterner>) -> bool {
    if (impl_item as usize) == 0 || (unsafe { (*impl_item).kind }) != HIR_ITEM_IMPL {
        return false;
    }
    let tp: *mut HirType = unsafe { (*impl_item).trait_path };
    if (tp as usize) == 0 || (unsafe { (*tp).kind }) != HIR_TYPE_PATH {
        return false;
    }
    if (unsafe { (*tp).path.generic_args as usize }) != 0 {
        return false;
    }
    if !hir_name_is_drop(interner, unsafe { (*tp).path.name }) {
        return false;
    }
    // (1) a qualified path is longer than its last segment (spans of unspanned synthetic HIR are 0).
    if (unsafe { (*tp).path.span.file.v }) != 0u32 {
        let span_len = (unsafe { (*tp).path.span.end }) - (unsafe { (*tp).path.span.start });
        if span_len != 4u32 {
            return false;
        }
    }
    // (2) module scope shadows the prelude.
    let mut it: *mut HirItem = items;
    while (it as usize) != 0 {
        if hir_module_path_eq(it, impl_item) {
            let k = unsafe { (*it).kind };
            if k == HIR_ITEM_TRAIT || k == HIR_ITEM_STRUCT || k == HIR_ITEM_ENUM || k == HIR_ITEM_TYPE_ALIAS {
                if hir_name_is_drop(interner, unsafe { (*it).name }) {
                    return false;
                }
            } else if k == HIR_ITEM_USE {
                if hir_use_tree_binds_drop(interner, unsafe { (*it).use_tree }) {
                    return false;
                }
            }
        }
        it = unsafe { (*it).next };
    }
    true
}

pub fn hir_postprocess_items(arena: mut_view<Arena>, hf: mut_view<HirFile>, interner: mut_view<StrInterner>) {
    let mut tail: *mut HirItem = hf.items;
    if (tail as usize) == 0 {
        return;
    }
    while (unsafe { (*tail).next as usize }) != 0 {
        tail = unsafe { (*tail).next };
    }
    let orig_tail: *mut HirItem = tail;
    let mut it: *mut HirItem = hf.items;
    while (it as usize) != 0 {
        let is_last = (it as usize) == (orig_tail as usize);
        let k = unsafe { (*it).kind };
        if k == HIR_ITEM_IMPL && (unsafe { (*it).members as usize }) != 0 {
            let tp: *mut HirType = unsafe { (*it).trait_path };
            let st: *mut HirType = unsafe { (*it).self_type };
            if (tp as usize) != 0 && (st as usize) != 0 && (unsafe { (*st).kind }) == HIR_TYPE_PATH && (unsafe { (*tp).kind }) == HIR_TYPE_PATH {
                {
                    // T158 / AXS-DROP-008: the same predicate as typeck, drop elaboration and axiom0's pipeline.c.
                    if hir_impl_is_lang_drop(hf.items, it, view(*interner)) {
                        let sname = interner_get(view(*interner), unsafe { (*st).path.name });
                        let buf = arena_alloc_raw(mut_view(*arena), sname.len + 5, 1);
                        let mut i: usize = 0;
                        while (i < sname.len) {
                            unsafe { *(buf + i) = *(sname.ptr + i); }
                            i = i + 1;
                        }
                        unsafe {
                            *(buf + sname.len + 0) = 95u8;
                            *(buf + sname.len + 1) = 100u8;
                            *(buf + sname.len + 2) = 114u8;
                            *(buf + sname.len + 3) = 111u8;
                            *(buf + sname.len + 4) = 112u8;
                        }
                        let mangled_id = interner_intern_bytes(mut_view(*interner), buf as *const u8, sname.len + 5);
                        let mut m: *mut HirItem = unsafe { (*it).members };
                        while (m as usize) != 0 {
                            if (unsafe { (*m).kind }) == HIR_ITEM_FN {
                                let fname = interner_get(view(*interner), unsafe { (*m).name });
                                if sv_eq_cstr4(fname, 100u8, 114u8, 111u8, 112u8) {
                                    unsafe {
                                        (*m).name.v = mangled_id.v;
                                        (*m).symbol.v = mangled_id.v;
                                    }
                                }
                            }
                            m = unsafe { (*m).next };
                        }
                    }
                }
            }
            let mut m: *mut HirItem = unsafe { (*it).members };
            while (m as usize) != 0 {
                let copy = clone_hir_item_shallow(mut_view(*arena), m);
                unsafe { (*tail).next = copy; }
                tail = copy;
                m = unsafe { (*m).next };
            }
        } else if k == HIR_ITEM_EXTERN_BLOCK && (unsafe { (*it).members as usize }) != 0 {
            let mut m: *mut HirItem = unsafe { (*it).members };
            while (m as usize) != 0 {
                let copy = clone_hir_item_shallow(mut_view(*arena), m);
                unsafe { (*tail).next = copy; }
                tail = copy;
                m = unsafe { (*m).next };
            }
        }
        if is_last {
            break;
        }
        it = unsafe { (*it).next };
    }
}

pub fn lower_file(arena: mut_view<Arena>, ast: view<Ast>, rmap: view<ResolveMap>, sink: mut_view<DiagSink>, interner: mut_view<StrInterner>) -> HirFile {
    let mut hf = lower_ast(mut_view(*arena), ast, rmap, sink);
    hir_postprocess_items(arena, mut_view(hf), interner);
    HirFile { items: hf.items }
}

