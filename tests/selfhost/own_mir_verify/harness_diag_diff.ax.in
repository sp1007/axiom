const QA_SEAM_OFF: [9]u32 = [
    0u32, 15u32, 51u32, 68u32, 178u32, 191u32, 202u32, 219u32, 324u32,
];

fn qa_seam_blob_sv(a: mut_view<Arena>, idx: usize) -> StrView {
    let start = QA_SEAM_OFF[idx] as usize;
    let end = QA_SEAM_OFF[idx + 1] as usize;
    let n = end - start;
    let dst = arena_alloc_raw(mut_view(*a), n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe {
            *(dst + i) = QA_SEAM_DATA[start + i];
        }
        i = i + 1;
    }
    unsafe {
        *(dst + n) = 0u8;
    }
    StrView { ptr: dst as *const u8, len: n }
}

fn copy_buf_to_sv(a: mut_view<Arena>, buf: view<DiagBuffer>) -> StrView {
    let n = buf.len;
    let dst = arena_alloc_raw(mut_view(*a), n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe {
            *(dst + i) = *(buf.ptr + i);
        }
        i = i + 1;
    }
    unsafe {
        *(dst + n) = 0u8;
    }
    StrView { ptr: dst as *const u8, len: n }
}

fn run_qa_boundary_seams(
    sess: mut_view<CompilerSession>,
    parse_arena: mut_view<Arena>,
    resolve_arena: mut_view<Arena>,
    hir_arena: mut_view<Arena>,
    mir_arena: mut_view<Arena>,
    scratch: mut_view<Arena>,
    rmap: mut_view<ResolveMap>,
    thir_ptr: *mut Thir,
    human_out: mut_view<DiagBuffer>,
    json_out: mut_view<DiagBuffer>
) -> i32 {
    // Seam 1: session_emit_mir -> session_verify_mir_text_and_render_json round-trip
    session_init(mut_view(*sess));
    let int_arena1 = arena_with_chunk_size(65536);
    unsafe {
        (*thir_ptr).interner.arena = int_arena1;
        thir_init(mut_view(*thir_ptr));
    }
    human_out.len = 0;
    json_out.len = 0;
    let rt_path = qa_seam_blob_sv(mut_view(*scratch), 0);
    let rt_src = qa_seam_blob_sv(mut_view(*scratch), 1);
    let mut rt_fid = FileId { v: 0u32 };
    let rt_parse = session_parse_virtual_file(
        mut_view(*sess),
        mut_view(*parse_arena),
        StrView { ptr: rt_path.ptr, len: rt_path.len },
        StrView { ptr: rt_src.ptr, len: rt_src.len },
        mut_view(rt_fid)
    );
    session_resolve_ast_into(mut_view(*sess), mut_view(*resolve_arena), view(rt_parse.ast), mut_view(*rmap));
    let rt_hir = session_lower_hir(mut_view(*sess), mut_view(*hir_arena), view(rt_parse.ast), view(*rmap));
    unsafe {
        session_typeck_into(mut_view(*sess), view(rt_hir), mut_view(*thir_ptr));
    }
    let fn_cnt = session_emit_mir(
        mut_view(*sess),
        mut_view(*mir_arena),
        view(rt_hir),
        unsafe { mut_view(*thir_ptr) },
        FileId { v: rt_fid.v },
        mut_view(*human_out)
    );
    if fn_cnt != 1 || sess.diag_sink.len != 0 || human_out.len == 0 {
        return 701;
    }
    let emitted_mir_sv = copy_buf_to_sv(mut_view(*scratch), view(*human_out));
    resolve_map_free(mut_view(*rmap));
    unsafe {
        thir_free(mut_view(*thir_ptr));
    }
    arena_reset(mut_view(*mir_arena));
    arena_reset(mut_view(*hir_arena));
    arena_reset(mut_view(*resolve_arena));
    arena_reset(mut_view(*parse_arena));
    session_free(mut_view(*sess));

    session_init(mut_view(*sess));
    json_out.len = 0;
    let mfid = session_add_virtual_file(
        mut_view(*sess),
        StrView { ptr: rt_path.ptr, len: rt_path.len },
        StrView { ptr: emitted_mir_sv.ptr, len: emitted_mir_sv.len }
    );
    session_verify_mir_text_and_render_json(
        mut_view(*sess),
        mut_view(*mir_arena),
        mfid,
        emitted_mir_sv,
        mut_view(*json_out)
    );
    if sess.diag_sink.len != 0 || (json_out.len) < 2 {
        return 702;
    }
    arena_reset(mut_view(*mir_arena));
    arena_reset(mut_view(*scratch));
    session_free(mut_view(*sess));

    // Seam 2: session_own_mir_verify_fn + session_verify_elaborated_body on conditional drop
    session_init(mut_view(*sess));
    let int_arena2 = arena_with_chunk_size(65536);
    unsafe {
        (*thir_ptr).interner.arena = int_arena2;
        thir_init(mut_view(*thir_ptr));
    }
    let el_path = qa_seam_blob_sv(mut_view(*scratch), 2);
    let el_src = qa_seam_blob_sv(mut_view(*scratch), 3);
    let mut el_fid = FileId { v: 0u32 };
    let el_parse = session_parse_virtual_file(
        mut_view(*sess),
        mut_view(*parse_arena),
        StrView { ptr: el_path.ptr, len: el_path.len },
        StrView { ptr: el_src.ptr, len: el_src.len },
        mut_view(el_fid)
    );
    session_resolve_ast_into(mut_view(*sess), mut_view(*resolve_arena), view(el_parse.ast), mut_view(*rmap));
    let el_hir = session_lower_hir(mut_view(*sess), mut_view(*hir_arena), view(el_parse.ast), view(*rmap));
    unsafe {
        session_typeck_into(mut_view(*sess), view(el_hir), mut_view(*thir_ptr));
    }
    let mut fn_it: *mut HirItem = el_hir.items;
    while (fn_it as usize) != 0 && (unsafe { (*fn_it).kind }) != HIR_ITEM_FN {
        fn_it = unsafe { (*fn_it).next };
    }
    if (fn_it as usize) == 0 {
        return 703;
    }
    let el_body = session_own_mir_verify_fn(
        mut_view(*sess),
        mut_view(*mir_arena),
        fn_it,
        view(el_hir),
        unsafe { mut_view(*thir_ptr) },
        0 as *mut MonoEngine,
        true,
        0 as *mut DiagBuffer,
        0 as *mut DiagBuffer
    );
    if (el_body as usize) == 0 || sess.diag_sink.len != 0 {
        return 704;
    }
    let el_ok = session_verify_elaborated_body(
        mut_view(*sess),
        fn_it as *const HirItem,
        unsafe { view(*el_body) },
        unsafe { view(*thir_ptr) }
    );
    if !el_ok || sess.diag_sink.len != 0 {
        return 705;
    }
    resolve_map_free(mut_view(*rmap));
    unsafe {
        thir_free(mut_view(*thir_ptr));
    }
    arena_reset(mut_view(*mir_arena));
    arena_reset(mut_view(*hir_arena));
    arena_reset(mut_view(*resolve_arena));
    arena_reset(mut_view(*parse_arena));
    arena_reset(mut_view(*scratch));
    session_free(mut_view(*sess));

    // Seam 3: Malformed .mir syntax via human + JSON renderers
    session_init(mut_view(*sess));
    human_out.len = 0;
    json_out.len = 0;
    let br_path = qa_seam_blob_sv(mut_view(*scratch), 4);
    let br_src = qa_seam_blob_sv(mut_view(*scratch), 5);
    let br_fid = session_add_virtual_file(
        mut_view(*sess),
        StrView { ptr: br_path.ptr, len: br_path.len },
        StrView { ptr: br_src.ptr, len: br_src.len }
    );
    session_verify_mir_text_and_render_human(
        mut_view(*sess),
        mut_view(*mir_arena),
        br_fid,
        StrView { ptr: br_src.ptr, len: br_src.len },
        mut_view(*human_out)
    );
    if sess.diag_sink.len != 1 || human_out.len == 0 {
        return 706;
    }
    let br_d0 = unsafe { diag_at(sess.diag_sink.diags, 0) };
    if (unsafe { (*br_d0).code.v }) != AX_VERIFY_MIR_SYNTAX {
        return 707;
    }
    arena_reset(mut_view(*mir_arena));
    session_free(mut_view(*sess));

    session_init(mut_view(*sess));
    let br_fid2 = session_add_virtual_file(
        mut_view(*sess),
        StrView { ptr: br_path.ptr, len: br_path.len },
        StrView { ptr: br_src.ptr, len: br_src.len }
    );
    session_verify_mir_text_and_render_json(
        mut_view(*sess),
        mut_view(*mir_arena),
        br_fid2,
        StrView { ptr: br_src.ptr, len: br_src.len },
        mut_view(*json_out)
    );
    if sess.diag_sink.len != 1 || json_out.len <= 2 {
        return 708;
    }
    arena_reset(mut_view(*mir_arena));
    arena_reset(mut_view(*scratch));
    session_free(mut_view(*sess));

    // Seam 4: Compound return-type stored-view escape (tuple & array) + session_emit_mir gate
    session_init(mut_view(*sess));
    let int_arena4 = arena_with_chunk_size(65536);
    unsafe {
        (*thir_ptr).interner.arena = int_arena4;
        thir_init(mut_view(*thir_ptr));
    }
    human_out.len = 0;
    json_out.len = 0;
    let ve_path = qa_seam_blob_sv(mut_view(*scratch), 6);
    let ve_src = qa_seam_blob_sv(mut_view(*scratch), 7);
    let mut ve_fid = FileId { v: 0u32 };
    let ve_parse = session_parse_virtual_file(
        mut_view(*sess),
        mut_view(*parse_arena),
        StrView { ptr: ve_path.ptr, len: ve_path.len },
        StrView { ptr: ve_src.ptr, len: ve_src.len },
        mut_view(ve_fid)
    );
    session_resolve_ast_into(mut_view(*sess), mut_view(*resolve_arena), view(ve_parse.ast), mut_view(*rmap));
    let ve_hir = session_lower_hir(mut_view(*sess), mut_view(*hir_arena), view(ve_parse.ast), view(*rmap));
    unsafe {
        session_typeck_into(mut_view(*sess), view(ve_hir), mut_view(*thir_ptr));
    }
    session_own_mir_verify_and_render_json(
        mut_view(*sess),
        mut_view(*mir_arena),
        view(ve_hir),
        unsafe { mut_view(*thir_ptr) },
        FileId { v: ve_fid.v },
        mut_view(*json_out)
    );
    if sess.diag_sink.len != 2 || json_out.len <= 2 {
        return 709;
    }
    let ve_d0 = unsafe { diag_at(sess.diag_sink.diags, 0) };
    let ve_d1 = unsafe { diag_at(sess.diag_sink.diags, 1) };
    if (unsafe { (*ve_d0).code.v }) != AX_TYPE_STORED_VIEW_ESCAPE || (unsafe { (*ve_d1).code.v }) != AX_TYPE_STORED_VIEW_ESCAPE {
        return 710;
    }
    let gated_cnt = session_emit_mir(
        mut_view(*sess),
        mut_view(*mir_arena),
        view(ve_hir),
        unsafe { mut_view(*thir_ptr) },
        FileId { v: ve_fid.v },
        mut_view(*human_out)
    );
    if gated_cnt != 0 || human_out.len != 0 {
        return 711;
    }
    resolve_map_free(mut_view(*rmap));
    unsafe {
        thir_free(mut_view(*thir_ptr));
    }
    arena_reset(mut_view(*mir_arena));
    arena_reset(mut_view(*hir_arena));
    arena_reset(mut_view(*resolve_arena));
    arena_reset(mut_view(*parse_arena));
    arena_reset(mut_view(*scratch));
    session_free(mut_view(*sess));
    0
}

fn new_arena(chunk: usize) -> Arena {
    let mut a = arena_with_chunk_size(chunk);
    let _ = arena_alloc_raw(mut_view(a), 16, 8);
    a
}

fn new_buf(perm: mut_view<Arena>) -> DiagBuffer {
    let mut b = diag_buf_new();
    let p = arena_alloc_raw(perm, 65536, 1);
    b.ptr = p;
    b.cap = 65536;
    b
}

pub fn main() -> i32 {
    let mut sess = session_new();
    let mut perm_arena = new_arena(262144);
    let mut parse_arena = new_arena(262144);
    let mut resolve_arena = new_arena(262144);
    let mut hir_arena = new_arena(262144);
    let mut mir_arena = new_arena(262144);
    let mut scratch = new_arena(65536);
    let thir_ptr = arena_alloc_raw(mut_view(perm_arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    let mut human_out = new_buf(mut_view(perm_arena));
    let mut json_out = new_buf(mut_view(perm_arena));
    let mut rmap = ResolveMap {
        node_map: empty_node_map(),
        module_access_nodes: empty_node_map(),
        extern_nodes: empty_node_map(),
        next_symbol_v: 1u32,
        next_std_symbol_v: 10000u32,
        naming_ctx: 0 as *mut NamingCtx,
    };

    let mut idx: usize = 0;
    while idx < AX_CASE_COUNT {
        let rc = run_ax_diag_case(
            mut_view(sess),
            mut_view(parse_arena),
            mut_view(resolve_arena),
            mut_view(hir_arena),
            mut_view(mir_arena),
            mut_view(scratch),
            mut_view(rmap),
            thir_ptr,
            mut_view(human_out),
            mut_view(json_out),
            idx
        );
        if rc != 0 {
            return rc;
        }
        idx = idx + 1;
    }

    idx = 0;
    while idx < MIR_CASE_COUNT {
        let rc = run_mir_diag_case(
            mut_view(sess),
            mut_view(mir_arena),
            mut_view(scratch),
            mut_view(human_out),
            idx
        );
        if rc != 0 {
            return rc;
        }
        idx = idx + 1;
    }

    if AX_CASE_COUNT == 0 {
        let seam_rc = run_qa_boundary_seams(
            mut_view(sess),
            mut_view(parse_arena),
            mut_view(resolve_arena),
            mut_view(hir_arena),
            mut_view(mir_arena),
            mut_view(scratch),
            mut_view(rmap),
            thir_ptr,
            mut_view(human_out),
            mut_view(json_out)
        );
        if seam_rc != 0 {
            return seam_rc;
        }
    }

    arena_destroy(mut_view(scratch));
    arena_destroy(mut_view(mir_arena));
    arena_destroy(mut_view(hir_arena));
    arena_destroy(mut_view(resolve_arena));
    arena_destroy(mut_view(parse_arena));
    arena_destroy(mut_view(perm_arena));
    print("OK own_mir_verify diag @GROUP@ (@AX_CASE_COUNT@ ax + @MIR_CASE_COUNT@ mir)\n");
    0
}
