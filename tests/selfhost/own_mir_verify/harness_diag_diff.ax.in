@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

const AX_CASE_COUNT: usize = @AX_CASE_COUNT@;
const MIR_CASE_COUNT: usize = @MIR_CASE_COUNT@;

@AX_DATA_TABLE@
@AX_OFFSET_TABLE@
@AX_EXP_COUNTS@
@AX_EXP_OFF@
@AX_EXP_CODES@
@AX_EXP_MOVED_LBL@

@MIR_DATA_TABLE@
@MIR_OFFSET_TABLE@
@MIR_EXP_COUNTS@
@MIR_EXP_OFF@
@MIR_EXP_CODES@

fn ax_blob_sv(a: mut_view<Arena>, idx: usize) -> StrView {
    let start = AX_OFF[idx] as usize;
    let end = AX_OFF[idx + 1] as usize;
    let n = end - start;
    let dst = arena_alloc_raw(mut_view(*a), n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe {
            *(dst + i) = AX_DATA[start + i];
        }
        i = i + 1;
    }
    unsafe {
        *(dst + n) = 0u8;
    }
    StrView { ptr: dst as *const u8, len: n }
}

fn mir_blob_sv(a: mut_view<Arena>, idx: usize) -> StrView {
    let start = MIR_OFF[idx] as usize;
    let end = MIR_OFF[idx + 1] as usize;
    let n = end - start;
    let dst = arena_alloc_raw(mut_view(*a), n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe {
            *(dst + i) = MIR_DATA[start + i];
        }
        i = i + 1;
    }
    unsafe {
        *(dst + n) = 0u8;
    }
    StrView { ptr: dst as *const u8, len: n }
}

unsafe fn diag_at(base: *mut Diagnostic, idx: usize) -> *mut Diagnostic {
    let off = ((idx as isize) * (size_of<Diagnostic>() as isize)) as usize;
    ((base as usize) + off) as *mut Diagnostic
}

fn dump_sv(sv: StrView) {
    let s: str = unsafe { *(address_of(sv) as *const str) };
    print(s);
}

fn bytes_equal(a: *const u8, a_len: usize, b: *const u8, b_len: usize) -> bool {
    if a_len != b_len {
        return false;
    }
    let mut i: usize = 0;
    while i < a_len {
        if (unsafe { *(a + i) }) != (unsafe { *(b + i) }) {
            return false;
        }
        i = i + 1;
    }
    true
}

fn empty_node_map() -> NodeMap {
    NodeMap { keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0 }
}

fn run_ax_diag_case(
    sess: mut_view<CompilerSession>,
    parse_arena: mut_view<Arena>,
    resolve_arena: mut_view<Arena>,
    hir_arena: mut_view<Arena>,
    mir_arena: mut_view<Arena>,
    scratch: mut_view<Arena>,
    rmap: mut_view<ResolveMap>,
    thir_ptr: *mut Thir,
    human_out: mut_view<DiagBuffer>,
    json_out: mut_view<DiagBuffer>,
    case_idx: usize
) -> i32 {
    session_init(mut_view(*sess));
    let int_arena = arena_with_chunk_size(65536);
    unsafe {
        (*thir_ptr).interner.arena = int_arena;
        thir_init(mut_view(*thir_ptr));
    }
    human_out.len = 0;
    json_out.len = 0;

    let base = case_idx * 3;
    let path_sv = ax_blob_sv(mut_view(*scratch), base);
    let src_sv = ax_blob_sv(mut_view(*scratch), base + 1);
    let exp_human = ax_blob_sv(mut_view(*scratch), base + 2);

    let mut fid = FileId { v: 0u32 };
    let parse_res = session_parse_virtual_file(
        mut_view(*sess),
        mut_view(*parse_arena),
        StrView { ptr: path_sv.ptr, len: path_sv.len },
        StrView { ptr: src_sv.ptr, len: src_sv.len },
        mut_view(fid)
    );
    session_resolve_ast_into(mut_view(*sess), mut_view(*resolve_arena), view(parse_res.ast), mut_view(*rmap));
    let hir = session_lower_hir(mut_view(*sess), mut_view(*hir_arena), view(parse_res.ast), view(*rmap));
    unsafe {
        session_typeck_into(mut_view(*sess), view(hir), mut_view(*thir_ptr));
    }

    session_own_mir_verify_and_render_human(
        mut_view(*sess),
        mut_view(*mir_arena),
        view(hir),
        unsafe { mut_view(*thir_ptr) },
        FileId { v: fid.v },
        mut_view(*human_out)
    );
    session_render_json(mut_view(*sess), mut_view(*json_out));

    let exp_cnt = AX_EXP_COUNTS[case_idx] as usize;
    let code_base = AX_EXP_OFF[case_idx] as usize;
    let mut rc: i32 = 0;

    if sess.diag_sink.len != exp_cnt {
        dump_sv(StrView { ptr: path_sv.ptr, len: path_sv.len });
        print("\n--- DIAG COUNT MISMATCH ---\n");
        dump_sv(StrView { ptr: human_out.ptr as *const u8, len: human_out.len });
        rc = 100 + (case_idx as i32);
    } else {
        let mut j: usize = 0;
        while j < exp_cnt {
            let d = unsafe { diag_at(sess.diag_sink.diags, j) };
            let got_code = unsafe { (*d).code.v };
            let want_code = AX_EXP_CODES[code_base + j];
            if got_code != want_code {
                dump_sv(StrView { ptr: path_sv.ptr, len: path_sv.len });
                print("\n--- DIAG CODE MISMATCH ---\n");
                dump_sv(StrView { ptr: human_out.ptr as *const u8, len: human_out.len });
                rc = 200 + (case_idx as i32);
                break;
            }
            j = j + 1;
        }
    }

    if rc == 0 && AX_EXP_MOVED_LBL[case_idx] != 0u32 {
        let d0 = unsafe { diag_at(sess.diag_sink.diags, 0) };
        let lcnt = unsafe { (*d0).label_count };
        let lbls = unsafe { (*d0).labels as *const DiagLabel };
        if lcnt == 0 || (lbls as usize) == 0 {
            dump_sv(StrView { ptr: path_sv.ptr, len: path_sv.len });
            print("\n--- MISSING MOVED HERE LABEL ---\n");
            rc = 250 + (case_idx as i32);
        } else {
            let lmsg = unsafe { (*lbls).message };
            let lspan = unsafe { (*lbls).span };
            if lmsg.len != 10 || lspan.file.v == 0u32 {
                dump_sv(StrView { ptr: path_sv.ptr, len: path_sv.len });
                print("\n--- BAD MOVED HERE LABEL ---\n");
                rc = 260 + (case_idx as i32);
            }
        }
    }

    if rc == 0 && !bytes_equal(human_out.ptr as *const u8, human_out.len, exp_human.ptr, exp_human.len) {
        dump_sv(StrView { ptr: path_sv.ptr, len: path_sv.len });
        print("\n--- HUMAN DIAG ACTUAL ---\n");
        dump_sv(StrView { ptr: human_out.ptr as *const u8, len: human_out.len });
        print("--- EXPECTED ---\n");
        dump_sv(exp_human);
        rc = 300 + (case_idx as i32);
    }

    if rc == 0 && json_out.len == 0 {
        rc = 350 + (case_idx as i32);
    }

    resolve_map_free(mut_view(*rmap));
    unsafe {
        thir_free(mut_view(*thir_ptr));
    }
    arena_reset(mut_view(*mir_arena));
    arena_reset(mut_view(*hir_arena));
    arena_reset(mut_view(*resolve_arena));
    arena_reset(mut_view(*parse_arena));
    arena_reset(mut_view(*scratch));
    session_free(mut_view(*sess));
    rc
}

fn run_mir_diag_case(
    sess: mut_view<CompilerSession>,
    mir_arena: mut_view<Arena>,
    scratch: mut_view<Arena>,
    human_out: mut_view<DiagBuffer>,
    case_idx: usize
) -> i32 {
    session_init(mut_view(*sess));
    human_out.len = 0;

    let base = case_idx * 2;
    let path_sv = mir_blob_sv(mut_view(*scratch), base);
    let src_sv = mir_blob_sv(mut_view(*scratch), base + 1);
    let fid = session_add_virtual_file(
        mut_view(*sess),
        StrView { ptr: path_sv.ptr, len: path_sv.len },
        StrView { ptr: src_sv.ptr, len: src_sv.len }
    );

    session_verify_mir_text_and_render_human(
        mut_view(*sess),
        mut_view(*mir_arena),
        fid,
        src_sv,
        mut_view(*human_out)
    );

    let exp_cnt = MIR_EXP_COUNTS[case_idx] as usize;
    let code_base = MIR_EXP_OFF[case_idx] as usize;
    let mut rc: i32 = 0;

    if sess.diag_sink.len != exp_cnt {
        dump_sv(StrView { ptr: path_sv.ptr, len: path_sv.len });
        print("\n--- MIR VERIFY DIAG COUNT MISMATCH ---\n");
        dump_sv(StrView { ptr: human_out.ptr as *const u8, len: human_out.len });
        rc = 500 + (case_idx as i32);
    } else {
        let mut j: usize = 0;
        while j < exp_cnt {
            let d = unsafe { diag_at(sess.diag_sink.diags, j) };
            let got_code = unsafe { (*d).code.v };
            let want_code = MIR_EXP_CODES[code_base + j];
            if got_code != want_code {
                dump_sv(StrView { ptr: path_sv.ptr, len: path_sv.len });
                print("\n--- MIR VERIFY DIAG CODE MISMATCH ---\n");
                rc = 600 + (case_idx as i32);
                break;
            }
            j = j + 1;
        }
    }

    arena_reset(mut_view(*mir_arena));
    arena_reset(mut_view(*scratch));
    session_free(mut_view(*sess));
    rc
}

