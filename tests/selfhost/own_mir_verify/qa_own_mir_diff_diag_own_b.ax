fn suppress_unresolved_at_span(sink: mut_view<DiagSink>, sp: Span) {
    if (sink.diags as usize) == 0 || sink.len == 0 {
        return;
    }
    let dsize = size_of<Diagnostic>();
    let mut i: usize = 0;
    while i < sink.len {
        let dp = ((sink.diags as usize) + ((((i as isize) * (dsize as isize))) as usize)) as *mut Diagnostic;
        let code_v = unsafe { (*dp).code.v };
        let pf = unsafe { (*dp).primary.file.v };
        let ps = unsafe { (*dp).primary.start };
        let pe = unsafe { (*dp).primary.end };
        if code_v == AX_NAME_UNRESOLVED && pf == sp.file.v && ps == sp.start && pe == sp.end {
            let mut j: usize = i;
            while j + 1 < sink.len {
                let dst_p = ((sink.diags as usize) + ((((j as isize) * (dsize as isize))) as usize)) as *mut Diagnostic;
                let src_p = ((sink.diags as usize) + (((((j + 1) as isize) * (dsize as isize))) as usize)) as *mut Diagnostic;
                unsafe { *dst_p = *src_p; }
                j = j + 1;
            }
            sink.len = sink.len - 1;
            if sink.errors > 0 {
                sink.errors = sink.errors - 1;
            }
            return;
        }
        i = i + 1;
    }
}

fn emit_not_supported(ctx: mut_view<LowerCtx>, arena: mut_view<Arena>, rmap: view<ResolveMap>, sink: mut_view<DiagSink>, sp: Span) {
    let code = DiagCode { v: AX_NAME_NOT_YET_SUPPORTED };
    let buf = unsafe { arena_alloc_raw(mut_view((*sink).arena), 61, 1) };
    unsafe {
        ptr_copy_nonoverlapping<u8>(address_of(LOWER_NOT_SUPPORTED_MSG[0]), buf, 60);
        *(buf + 60) = 0u8;
    }
    let mut d = Diagnostic {
        code: code,
        severity: diag_code_severity(code),
        message: StrView { ptr: buf as *const u8, len: 60 },
        primary: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    hir_set_span(mut_view(d.primary), sp);
    unsafe { diag_sink_report(mut_view(*sink), view(d)); }
}

fn get_symbol(ctx: view<LowerCtx>, rmap: view<ResolveMap>, node: usize) -> SymbolId {
    let sym = unsafe { nodemap_get(view((*rmap).node_map), node) };
    if (sym as usize) != 0 {
        return SymbolId { v: unsafe { (*sym).v } };
    }
    let ext = unsafe { nodemap_get(view((*rmap).extern_nodes), node) };
    if (ext as usize) != 0 {
        return SymbolId { v: unsafe { (*ext).v } };
    }
    SymbolId { v: 0u32 }
}

fn lower_path_into(ctx: mut_view<LowerCtx>, arena: mut_view<Arena>, rmap: view<ResolveMap>, sink: mut_view<DiagSink>, dst: mut_view<HirPath>, seg: *mut AstTypePathSegment) {
