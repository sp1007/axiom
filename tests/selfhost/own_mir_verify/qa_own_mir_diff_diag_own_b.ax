const THIR_OFF: [114]u32 = [
    0u32, 2u32, 4u32, 7u32, 12u32, 18u32, 20u32, 30u32, 33u32, 38u32, 42u32, 54u32,
    65u32, 69u32, 76u32, 86u32, 98u32, 107u32, 112u32, 121u32, 129u32, 138u32, 147u32, 156u32,
    164u32, 171u32, 177u32, 184u32, 192u32, 200u32, 211u32, 219u32, 229u32, 239u32, 246u32, 254u32,
    259u32, 268u32, 277u32, 288u32, 296u32, 305u32, 314u32, 324u32, 333u32, 342u32, 348u32, 357u32,
    365u32, 373u32, 382u32, 389u32, 399u32, 407u32, 419u32, 427u32, 438u32, 443u32, 452u32, 462u32,
    471u32, 479u32, 488u32, 502u32, 510u32, 524u32, 533u32, 540u32, 549u32, 556u32, 565u32, 572u32,
    582u32, 590u32, 599u32, 609u32, 616u32, 622u32, 632u32, 641u32, 649u32, 660u32, 669u32, 677u32,
    690u32, 699u32, 709u32, 724u32,
    736u32, 743u32, 748u32, 750u32, 755u32, 759u32, 763u32, 765u32, 768u32, 771u32, 774u32, 779u32,
    781u32, 784u32, 787u32, 790u32, 795u32, 798u32, 811u32, 826u32, 845u32, 848u32, 850u32, 855u32,
    859u32, 860u32,
];

struct ThirDumpState {
    buf: *mut DiagBuffer,
    interner: *const StrInterner,
    thir: *const Thir,
    hir_items: *mut HirItem,
    indent: i32,
    filter_file: FileId,
}

fn td_str(st: mut_view<ThirDumpState>, idx: usize) {
    let start = THIR_OFF[idx] as usize;
    let end = THIR_OFF[idx + 1] as usize;
    let mut i = start;
    while (i < end) {
        unsafe { diag_buf_push_byte(mut_view(*st.buf), THIR_DATA[i]); }
        i = i + 1;
    }
}

fn td_nl(st: mut_view<ThirDumpState>) {
    unsafe { diag_buf_push_byte(mut_view(*st.buf), 10u8); }
    let mut i: i32 = 0;
    while (i < st.indent) {
        td_str(mut_view(*st), 0);
        i = i + 1;
    }
}

fn td_begin(st: mut_view<ThirDumpState>, idx: usize) {
    unsafe { diag_buf_push_byte(mut_view(*st.buf), 40u8); }
    td_str(mut_view(*st), idx);
    st.indent = st.indent + 1;
}

fn td_end(st: mut_view<ThirDumpState>) {
    st.indent = st.indent - 1;
    unsafe { diag_buf_push_byte(mut_view(*st.buf), 41u8); }
}

fn td_strid(st: mut_view<ThirDumpState>, id: StrId) {
    if id.v == 0u32 {
        td_str(mut_view(*st), 2);
        return;
    }
    let sv = unsafe { interner_get(view(*st.interner), (StrId { v: id.v })) };
    td_str(mut_view(*st), 1);
    unsafe {
        diag_buf_push_bytes(mut_view(*st.buf), sv.ptr, sv.len);
        diag_buf_push_byte(mut_view(*st.buf), 34u8);
    }
}

fn td_bool(st: mut_view<ThirDumpState>, b: bool) {
    if b {
        td_str(mut_view(*st), 3);
    } else {
        td_str(mut_view(*st), 4);
    }
}

fn td_u32(st: mut_view<ThirDumpState>, v: u32) {
    unsafe {
        diag_buf_push_byte(mut_view(*st.buf), 32u8);
        diag_buf_push_u32(mut_view(*st.buf), v);
    }
}

fn td_symbol(st: mut_view<ThirDumpState>, sym: SymbolId) {
    if sym.v != 0u32 {
        td_str(mut_view(*st), 5);
        unsafe { diag_buf_push_u32(mut_view(*st.buf), sym.v); }
    }
}

fn td_typeid(st: mut_view<ThirDumpState>, id: TypeId) {
    if id.v == 0u32 {
        td_str(mut_view(*st), 87);
        return;
    }
    let t = unsafe { type_get(view((*st.thir).interner), (TypeId { v: id.v })) };
    if (t as usize) == 0 {
        td_str(mut_view(*st), 87);
        return;
    }
    td_str(mut_view(*st), 88);
    let k = unsafe { (*t).kind };
    if k == TY_ERROR {
        td_str(mut_view(*st), 89);
    } else if k == TY_UNIT {
        td_str(mut_view(*st), 90);
    } else if k == TY_NEVER {
        td_str(mut_view(*st), 91);
    } else if k == TY_BOOL {
        td_str(mut_view(*st), 92);
    } else if k == TY_CHAR {
        td_str(mut_view(*st), 93);
    } else if k == TY_I8 {
        td_str(mut_view(*st), 94);
    } else if k == TY_I16 {
        td_str(mut_view(*st), 95);
    } else if k == TY_I32 {
        td_str(mut_view(*st), 96);
    } else if k == TY_I64 {
        td_str(mut_view(*st), 97);
    } else if k == TY_I128 {
        unsafe {
            diag_buf_push_byte(mut_view(*st.buf), 105u8);
            diag_buf_push_byte(mut_view(*st.buf), 49u8);
            diag_buf_push_byte(mut_view(*st.buf), 50u8);
            diag_buf_push_byte(mut_view(*st.buf), 56u8);
        }
    } else if k == TY_ISIZE {
        td_str(mut_view(*st), 98);
    } else if k == TY_U8 {
        td_str(mut_view(*st), 99);
    } else if k == TY_U16 {
        td_str(mut_view(*st), 100);
    } else if k == TY_U32 {
        td_str(mut_view(*st), 101);
    } else if k == TY_U64 {
        td_str(mut_view(*st), 102);
    } else if k == TY_U128 {
        unsafe {
            diag_buf_push_byte(mut_view(*st.buf), 117u8);
            diag_buf_push_byte(mut_view(*st.buf), 49u8);
            diag_buf_push_byte(mut_view(*st.buf), 50u8);
            diag_buf_push_byte(mut_view(*st.buf), 56u8);
        }
    } else if k == TY_USIZE {
        td_str(mut_view(*st), 103);
    } else if k == TY_STR {
        td_str(mut_view(*st), 104);
    } else if k == TY_BUILTIN_LEN {
        td_str(mut_view(*st), 105);
    } else if k == TY_BUILTIN_PRINT {
        td_str(mut_view(*st), 106);
    } else if k == TY_BUILTIN_PRINT_INT {
        td_str(mut_view(*st), 107);
    } else if k == TY_FN {
        td_str(mut_view(*st), 108);
        let pcnt = unsafe { (*t).param_count };
        let ptypes: *mut TypeId = unsafe { (*t).param_types };
        let mut i: usize = 0;
        while (i < pcnt) {
            if i > 0 {
                td_str(mut_view(*st), 109);
            }
            let pt_v = unsafe { (*typeid_at(ptypes, i)).v };
            td_typeid(mut_view(*st), (TypeId { v: pt_v }));
            i = i + 1;
        }
        td_str(mut_view(*st), 110);
        let rt_v = unsafe { (*t).ret_type.v };
        td_typeid(mut_view(*st), (TypeId { v: rt_v }));
    } else if k == TY_INT_VAR {
        td_str(mut_view(*st), 111);
        let vid = unsafe { (*t).var_id };
        unsafe { diag_buf_push_u32(mut_view(*st.buf), vid); }
    } else if k == TY_COROUTINE {
        unsafe {
            diag_buf_push_byte(mut_view(*st.buf), 67u8);
            diag_buf_push_byte(mut_view(*st.buf), 111u8);
            diag_buf_push_byte(mut_view(*st.buf), 114u8);
            diag_buf_push_byte(mut_view(*st.buf), 111u8);
            diag_buf_push_byte(mut_view(*st.buf), 117u8);
            diag_buf_push_byte(mut_view(*st.buf), 116u8);
            diag_buf_push_byte(mut_view(*st.buf), 105u8);
            diag_buf_push_byte(mut_view(*st.buf), 110u8);
            diag_buf_push_byte(mut_view(*st.buf), 101u8);
            diag_buf_push_byte(mut_view(*st.buf), 60u8);
        }
        let rt_v = unsafe { (*t).ret_type.v };
        td_typeid(mut_view(*st), (TypeId { v: rt_v }));
        unsafe {
            diag_buf_push_byte(mut_view(*st.buf), 62u8);
        }
    }
    td_str(mut_view(*st), 112);
}

fn td_maybe_pat_ty(st: mut_view<ThirDumpState>, pat: *const HirPat) {
    let p = unsafe { ptr_typemap_get(view((*st.thir).pat_types), pat as usize) };
    if (p as usize) != 0 {
        let tv = unsafe { (*p).v };
        td_typeid(st, (TypeId { v: tv }));
    }
}

fn td_maybe_expr_ty(st: mut_view<ThirDumpState>, expr: *const HirExpr) {
    let p = unsafe { ptr_typemap_get(view((*st.thir).expr_types), expr as usize) };
    if (p as usize) != 0 {
        let tv = unsafe { (*p).v };
        td_typeid(st, (TypeId { v: tv }));
    }
}

fn td_dotted(st: mut_view<ThirDumpState>, n: view<AstDottedName>) {
    td_nl(mut_view(*st));
    td_begin(mut_view(*st), 6);
    let mut i: usize = 0;
    while (i < n.count) {
        let off = mul_usize(i, size_of<StrId>());
        let seg_ptr = ((n.segments as usize) + off) as *const StrId;
        td_strid(mut_view(*st), unsafe { *seg_ptr });
        i = i + 1;
    }
    td_end(mut_view(*st));
}

fn td_vis(st: mut_view<ThirDumpState>, n: view<HirVis>) {
    td_nl(mut_view(*st));
    td_begin(mut_view(*st), 7);
    if n.kind == HIR_VIS_PRIVATE {
        td_str(mut_view(*st), 8);
    } else if n.kind == HIR_VIS_PUB {
        td_str(mut_view(*st), 9);
    } else if n.kind == HIR_VIS_PUB_PACKAGE {
        td_str(mut_view(*st), 10);
    } else if n.kind == HIR_VIS_PUB_MODULE {
        td_str(mut_view(*st), 11);
    }
    td_end(mut_view(*st));
}

fn td_attr(st: mut_view<ThirDumpState>, n: *mut HirAttr) {
    let mut cur = n;
    while ((cur as usize) != 0) {
        td_nl(mut_view(*st));
        td_begin(mut_view(*st), 12);
        td_strid(mut_view(*st), unsafe { (*cur).name });
        let mut a: *mut HirAttrArg = unsafe { (*cur).args };
        while ((a as usize) != 0) {
            td_nl(mut_view(*st));
            td_begin(mut_view(*st), 13);
            td_strid(mut_view(*st), unsafe { (*a).name });
            td_expr(mut_view(*st), unsafe { (*a).expr });
            td_end(mut_view(*st));
            a = unsafe { (*a).next };
        }
        td_end(mut_view(*st));
        cur = unsafe { (*cur).next };
    }
}

fn td_generic_args(st: mut_view<ThirDumpState>, n: *mut HirGenericArgs) {
    if (n as usize) == 0 {
        return;
    }
    let mut a: *mut HirGenericArg = unsafe { (*n).args };
    while ((a as usize) != 0) {
        td_nl(mut_view(*st));
        td_begin(mut_view(*st), 14);
        td_strid(mut_view(*st), unsafe { (*a).name });
        td_type(mut_view(*st), unsafe { (*a).ty });
        td_end(mut_view(*st));
        a = unsafe { (*a).next };
    }
}

fn td_generic_params(st: mut_view<ThirDumpState>, n: *mut HirGenericParams) {
    if (n as usize) == 0 {
        return;
    }
    let mut a: *mut HirGenericParam = unsafe { (*n).params };
    while ((a as usize) != 0) {
        td_nl(mut_view(*st));
        td_begin(mut_view(*st), 15);
        td_strid(mut_view(*st), unsafe { (*a).name });
        td_type(mut_view(*st), unsafe { (*a).bounds });
        td_end(mut_view(*st));
        a = unsafe { (*a).next };
    }
}

fn td_where_clause(st: mut_view<ThirDumpState>, n: *mut HirWhereClause) {
    if (n as usize) == 0 {
        return;
    }
    let mut a: *mut HirWherePred = unsafe { (*n).preds };
    while ((a as usize) != 0) {
        td_nl(mut_view(*st));
        td_begin(mut_view(*st), 16);
        td_type(mut_view(*st), unsafe { (*a).ty });
        td_type(mut_view(*st), unsafe { (*a).bounds });
        td_end(mut_view(*st));
        a = unsafe { (*a).next };
    }
}

fn td_path(st: mut_view<ThirDumpState>, p: view<HirPath>) {
    td_symbol(mut_view(*st), p.symbol);
    td_generic_args(mut_view(*st), p.generic_args);
}

fn td_block(st: mut_view<ThirDumpState>, n: *mut HirBlock) {
    td_nl(mut_view(*st));
    td_begin(mut_view(*st), 17);
    if (n as usize) != 0 {
        td_stmt(mut_view(*st), unsafe { (*n).stmts });
    }
    td_end(mut_view(*st));
}

fn td_type(st: mut_view<ThirDumpState>, n: *mut HirType) {
    let mut cur = n;
    while ((cur as usize) != 0) {
        td_nl(mut_view(*st));
        let k = unsafe { (*cur).kind };
        if k == HIR_TYPE_ERROR {
            td_begin(mut_view(*st), 18);
        } else if k == HIR_TYPE_PATH {
            td_begin(mut_view(*st), 19);
            td_path(mut_view(*st), unsafe { view((*cur).path) });
        } else if k == HIR_TYPE_TUPLE {
            td_begin(mut_view(*st), 20);
            td_type(mut_view(*st), unsafe { (*cur).elem_types });
        } else if k == HIR_TYPE_ARRAY {
            td_begin(mut_view(*st), 21);
            let ce: *mut HirExpr = unsafe { (*cur).count_expr };
            if (ce as usize) != 0 && (unsafe { (*ce).kind }) == HIR_EXPR_LITERAL && (unsafe { (*ce).literal.kind }) == TOK_INT && (unsafe { (*ce).next as usize }) == 0 {
                td_nl(mut_view(*st));
                td_begin(mut_view(*st), 38);
                td_end(mut_view(*st));
            } else {
                td_expr(mut_view(*st), ce);
            }
            td_type(mut_view(*st), unsafe { (*cur).elem });
        } else if k == HIR_TYPE_SLICE {
            td_begin(mut_view(*st), 22);
            td_type(mut_view(*st), unsafe { (*cur).elem });
        } else if k == HIR_TYPE_VIEW {
            td_begin(mut_view(*st), 23);
            td_bool(mut_view(*st), unsafe { (*cur).is_mut });
            td_type(mut_view(*st), unsafe { (*cur).elem });
        } else if k == HIR_TYPE_PTR {
            td_begin(mut_view(*st), 24);
            td_bool(mut_view(*st), unsafe { (*cur).is_mut });
            td_type(mut_view(*st), unsafe { (*cur).elem });
        } else if k == HIR_TYPE_FN {
            td_begin(mut_view(*st), 25);
            td_bool(mut_view(*st), unsafe { (*cur).is_unsafe });
            td_strid(mut_view(*st), unsafe { (*cur).abi });
            td_type(mut_view(*st), unsafe { (*cur).param_types });
            td_type(mut_view(*st), unsafe { (*cur).ret_type });
        } else if k == HIR_TYPE_DYN {
            td_begin(mut_view(*st), 26);
            td_type(mut_view(*st), unsafe { (*cur).bounds });
        }
        td_end(mut_view(*st));
        cur = unsafe { (*cur).next };
    }
}

fn td_pat_field(st: mut_view<ThirDumpState>, n: *mut HirPatField) {
    let mut cur = n;
    while ((cur as usize) != 0) {
        td_nl(mut_view(*st));
        td_begin(mut_view(*st), 27);
        td_strid(mut_view(*st), unsafe { (*cur).name });
        td_pat(mut_view(*st), unsafe { (*cur).pat });
        td_end(mut_view(*st));
        cur = unsafe { (*cur).next };
    }
}

fn td_pat(st: mut_view<ThirDumpState>, n: *mut HirPat) {
    let mut cur = n;
    while ((cur as usize) != 0) {
        td_nl(mut_view(*st));
        let k = unsafe { (*cur).kind };
        if k == HIR_PAT_ERROR {
            td_begin(mut_view(*st), 28);
            td_maybe_pat_ty(mut_view(*st), cur);
        } else if k == HIR_PAT_WILDCARD {
            td_begin(mut_view(*st), 29);
            td_maybe_pat_ty(mut_view(*st), cur);
        } else if k == HIR_PAT_RANGE {
            td_begin(mut_view(*st), 30);
            td_maybe_pat_ty(mut_view(*st), cur);
            td_bool(mut_view(*st), unsafe { (*cur).is_inclusive });
            td_pat(mut_view(*st), unsafe { (*cur).start_pat });
            td_pat(mut_view(*st), unsafe { (*cur).end_pat });
        } else if k == HIR_PAT_LITERAL {
            td_begin(mut_view(*st), 31);
            td_maybe_pat_ty(mut_view(*st), cur);
            td_bool(mut_view(*st), unsafe { (*cur).is_negated });
        } else if k == HIR_PAT_BINDING {
            td_begin(mut_view(*st), 32);
            td_maybe_pat_ty(mut_view(*st), cur);
            td_bool(mut_view(*st), unsafe { (*cur).is_mut });
            td_symbol(mut_view(*st), unsafe { (*cur).symbol });
        } else if k == HIR_PAT_PATH {
            td_begin(mut_view(*st), 33);
            td_maybe_pat_ty(mut_view(*st), cur);
            td_path(mut_view(*st), unsafe { view((*cur).path) });
            td_pat(mut_view(*st), unsafe { (*cur).payload });
        } else if k == HIR_PAT_TUPLE {
            td_begin(mut_view(*st), 34);
            td_maybe_pat_ty(mut_view(*st), cur);
            td_pat(mut_view(*st), unsafe { (*cur).elems });
        } else if k == HIR_PAT_OR {
            td_begin(mut_view(*st), 35);
            td_maybe_pat_ty(mut_view(*st), cur);
            td_pat(mut_view(*st), unsafe { (*cur).pats });
        } else if k == HIR_PAT_STRUCT {
            td_begin(mut_view(*st), 36);
            td_maybe_pat_ty(mut_view(*st), cur);
            td_path(mut_view(*st), unsafe { view((*cur).path) });
            td_pat_field(mut_view(*st), unsafe { (*cur).fields });
            td_bool(mut_view(*st), unsafe { (*cur).has_rest });
        }
        td_end(mut_view(*st));
        cur = unsafe { (*cur).next };
    }
}

fn td_expr(st: mut_view<ThirDumpState>, n: *mut HirExpr) {
    let mut cur = n;
    while ((cur as usize) != 0) {
        td_nl(mut_view(*st));
        let k = unsafe { (*cur).kind };
        if k == HIR_EXPR_ERROR {
            td_begin(mut_view(*st), 37);
            td_maybe_expr_ty(mut_view(*st), cur);
        } else if k == HIR_EXPR_LITERAL {
            td_begin(mut_view(*st), 38);
            td_maybe_expr_ty(mut_view(*st), cur);
        } else if k == HIR_EXPR_PATH {
            td_begin(mut_view(*st), 39);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_path(mut_view(*st), unsafe { view((*cur).path) });
        } else if k == HIR_EXPR_ARRAY {
            td_begin(mut_view(*st), 40);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_expr(mut_view(*st), unsafe { (*cur).elems });
            td_expr(mut_view(*st), unsafe { (*cur).count_expr });
        } else if k == HIR_EXPR_TUPLE {
            td_begin(mut_view(*st), 41);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_expr(mut_view(*st), unsafe { (*cur).elems });
        } else if k == HIR_EXPR_STRUCT {
            td_begin(mut_view(*st), 42);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_path(mut_view(*st), unsafe { view((*cur).path) });
            let mut f: *mut HirFieldInit = unsafe { (*cur).fields };
            while ((f as usize) != 0) {
                td_nl(mut_view(*st));
                td_begin(mut_view(*st), 43);
                td_strid(mut_view(*st), unsafe { (*f).name });
                td_expr(mut_view(*st), unsafe { (*f).expr });
                td_end(mut_view(*st));
                f = unsafe { (*f).next };
            }
        } else if k == HIR_EXPR_BLOCK {
            td_begin(mut_view(*st), 44);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_block(mut_view(*st), unsafe { (*cur).block });
        } else if k == HIR_EXPR_IF {
            td_begin(mut_view(*st), 45);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_pat(mut_view(*st), unsafe { (*cur).let_pat });
            td_expr(mut_view(*st), unsafe { (*cur).cond });
            td_block(mut_view(*st), unsafe { (*cur).block });
            td_expr(mut_view(*st), unsafe { (*cur).else_branch });
        } else if k == HIR_EXPR_MATCH {
            td_begin(mut_view(*st), 46);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_expr(mut_view(*st), unsafe { (*cur).cond });
            let mut a: *mut HirMatchArm = unsafe { (*cur).arms };
            while ((a as usize) != 0) {
                td_nl(mut_view(*st));
                td_begin(mut_view(*st), 47);
                td_pat(mut_view(*st), unsafe { (*a).pat });
                td_expr(mut_view(*st), unsafe { (*a).guard });
                td_expr(mut_view(*st), unsafe { (*a).body });
                td_end(mut_view(*st));
                a = unsafe { (*a).next };
            }
        } else if k == HIR_EXPR_LOOP {
            td_begin(mut_view(*st), 48);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_strid(mut_view(*st), unsafe { (*cur).label });
            td_block(mut_view(*st), unsafe { (*cur).block });
        } else if k == HIR_EXPR_WHILE {
            td_begin(mut_view(*st), 49);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_strid(mut_view(*st), unsafe { (*cur).label });
            td_pat(mut_view(*st), unsafe { (*cur).let_pat });
            td_expr(mut_view(*st), unsafe { (*cur).cond });
            td_block(mut_view(*st), unsafe { (*cur).block });
        } else if k == HIR_EXPR_FOR {
            td_begin(mut_view(*st), 50);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_strid(mut_view(*st), unsafe { (*cur).label });
            td_pat(mut_view(*st), unsafe { (*cur).pat });
            td_expr(mut_view(*st), unsafe { (*cur).iter });
            td_block(mut_view(*st), unsafe { (*cur).block });
        } else if k == HIR_EXPR_UNSAFE {
            td_begin(mut_view(*st), 51);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_block(mut_view(*st), unsafe { (*cur).block });
        } else if k == HIR_EXPR_VIEW {
            td_begin(mut_view(*st), 52);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_bool(mut_view(*st), unsafe { (*cur).is_mut });
            td_expr(mut_view(*st), unsafe { (*cur).inner });
        } else if k == HIR_EXPR_COMPTIME {
            td_begin(mut_view(*st), 53);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_block(mut_view(*st), unsafe { (*cur).block });
        } else if k == HIR_EXPR_JUMP {
            td_begin(mut_view(*st), 54);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_u32(mut_view(*st), (unsafe { (*cur).jump_kind }) as u32);
            td_strid(mut_view(*st), unsafe { (*cur).label });
            td_expr(mut_view(*st), unsafe { (*cur).inner });
        } else if k == HIR_EXPR_CLOSURE {
            td_begin(mut_view(*st), 55);
            td_maybe_expr_ty(mut_view(*st), cur);
            let mut p: *mut HirParam = unsafe { (*cur).params };
            while ((p as usize) != 0) {
                td_nl(mut_view(*st));
                td_begin(mut_view(*st), 56);
                td_bool(mut_view(*st), unsafe { (*p).is_mut });
                td_symbol(mut_view(*st), unsafe { (*p).symbol });
                td_type(mut_view(*st), unsafe { (*p).ty });
                td_end(mut_view(*st));
                p = unsafe { (*p).next };
            }
            td_type(mut_view(*st), unsafe { (*cur).ret_type });
            td_expr(mut_view(*st), unsafe { (*cur).body });
        } else if k == HIR_EXPR_RANGE {
            td_begin(mut_view(*st), 57);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_bool(mut_view(*st), unsafe { (*cur).is_inclusive });
            td_expr(mut_view(*st), unsafe { (*cur).start_expr });
            td_expr(mut_view(*st), unsafe { (*cur).end_expr });
        } else if k == HIR_EXPR_BINARY {
            td_begin(mut_view(*st), 58);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_u32(mut_view(*st), (unsafe { (*cur).op }) as u32);
            td_expr(mut_view(*st), unsafe { (*cur).left });
            td_expr(mut_view(*st), unsafe { (*cur).right });
        } else if k == HIR_EXPR_UNARY {
            td_begin(mut_view(*st), 59);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_u32(mut_view(*st), (unsafe { (*cur).op }) as u32);
            td_expr(mut_view(*st), unsafe { (*cur).inner });
        } else if k == HIR_EXPR_CAST {
            td_begin(mut_view(*st), 60);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_expr(mut_view(*st), unsafe { (*cur).inner });
            td_type(mut_view(*st), unsafe { (*cur).cast_ty });
        } else if k == HIR_EXPR_FIELD {
            td_begin(mut_view(*st), 61);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_expr(mut_view(*st), unsafe { (*cur).base });
            td_strid(mut_view(*st), unsafe { (*cur).name });
            td_generic_args(mut_view(*st), unsafe { (*cur).generic_args });
        } else if k == HIR_EXPR_TUPLE_INDEX {
            td_begin(mut_view(*st), 62);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_expr(mut_view(*st), unsafe { (*cur).base });
            td_u32(mut_view(*st), unsafe { (*cur).tuple_index });
        } else if k == HIR_EXPR_CALL {
            td_begin(mut_view(*st), 63);
            td_maybe_expr_ty(mut_view(*st), cur);
            let callee: *mut HirExpr = unsafe { (*cur).callee };
            let mut dumped_inferred_callee = false;
            // axiom0 records an intrinsic callee with its builtin singleton type (printed as an
            // empty `<Type >`); only a callee typed as a plain fn shows the uninstantiated fn type.
            let mut callee_is_fn = false;
            if (callee as usize) != 0 {
                let cty = unsafe { thir_get_expr_type(view(*st.thir), callee) };
                if cty.v != 0u32 {
                    let ct = unsafe { type_get(view((*st.thir).interner), TypeId { v: cty.v }) };
                    callee_is_fn = (ct as usize) != 0 && (unsafe { (*ct).kind }) == TY_FN;
                }
            }
            if callee_is_fn && (callee as usize) != 0 && (unsafe { (*callee).kind }) == HIR_EXPR_PATH && (unsafe { (*callee).next as usize }) == 0 && (unsafe { (*callee).path.generic_args as usize }) == 0 {
                let sp = unsafe { ptr_substmap_get(view((*st.thir).expr_substs), callee as usize) };
                if (sp as usize) != 0 && (unsafe { (*sp).count }) > 0 {
                    let csym = unsafe { (*callee).path.symbol };
                    if csym.v != 0u32 {
                        let mut raw_ty_v: u32 = 0u32;
                        let mut dit: *mut HirItem = st.hir_items;
                        while ((dit as usize) != 0) {
                            let dik = unsafe { (*dit).kind };
                            if dik == HIR_ITEM_FN && (unsafe { (*dit).symbol.v }) == csym.v && (unsafe { (*dit).span.file.v }) != 0xFFFFFFFEu32 {
                                let it_ty = unsafe { thir_get_item_type(view(*st.thir), dit) };
                                raw_ty_v = it_ty.v;
                                break;
                            }
                            dit = unsafe { (*dit).next };
                        }
                        if raw_ty_v == 0u32 {
                            let st_ptr = unsafe { thir_get_sym_type(view(*st.thir), (SymbolId { v: csym.v })) };
                            if (st_ptr as usize) != 0 {
                                raw_ty_v = unsafe { (*st_ptr).v };
                            }
                        }
                        if raw_ty_v != 0u32 {
                            let ax = unsafe { type_get(view((*st.thir).interner), TypeId { v: raw_ty_v }) };
                            if (ax as usize) != 0 && (unsafe { (*ax).kind }) == TY_FN {
                                td_nl(mut_view(*st));
                                td_begin(mut_view(*st), 39);
                                td_typeid(mut_view(*st), TypeId { v: raw_ty_v });
                                td_path(mut_view(*st), unsafe { view((*callee).path) });
                                td_end(mut_view(*st));
                                dumped_inferred_callee = true;
                            }
                        }
                    }
                }
            }
            if !dumped_inferred_callee {
                td_expr(mut_view(*st), callee);
            }
            td_expr(mut_view(*st), unsafe { (*cur).args });
        } else if k == HIR_EXPR_METHOD_CALL {
            td_begin(mut_view(*st), 64);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_expr(mut_view(*st), unsafe { (*cur).receiver });
            td_strid(mut_view(*st), unsafe { (*cur).method_name });
            td_generic_args(mut_view(*st), unsafe { (*cur).generic_args });
            td_expr(mut_view(*st), unsafe { (*cur).args });
        } else if k == HIR_EXPR_INDEX {
            td_begin(mut_view(*st), 65);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_expr(mut_view(*st), unsafe { (*cur).base });
            td_expr(mut_view(*st), unsafe { (*cur).index_arg });
        } else if k == HIR_EXPR_TRY {
            td_begin(mut_view(*st), 66);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_expr(mut_view(*st), unsafe { (*cur).inner });
        } else if k == HIR_EXPR_AWAIT {
            td_begin(mut_view(*st), 67);
            td_maybe_expr_ty(mut_view(*st), cur);
            td_expr(mut_view(*st), unsafe { (*cur).inner });
        }
        td_end(mut_view(*st));
        cur = unsafe { (*cur).next };
    }
}

fn td_use_tree(st: mut_view<ThirDumpState>, n: *mut HirUseTree) {
    if (n as usize) == 0 {
        return;
    }
    td_nl(mut_view(*st));
    td_begin(mut_view(*st), 68);
    td_dotted(mut_view(*st), unsafe { view((*n).path) });
    if (unsafe { (*n).alias.v }) != 0u32 {
        td_strid(mut_view(*st), unsafe { (*n).alias });
    }
    if (unsafe { (*n).subtrees as usize }) != 0 {
        td_use_tree(mut_view(*st), unsafe { (*n).subtrees });
    }
    td_end(mut_view(*st));
    if (unsafe { (*n).next as usize }) != 0 {
        td_use_tree(mut_view(*st), unsafe { (*n).next });
    }
}

fn td_stmt(st: mut_view<ThirDumpState>, n: *mut HirStmt) {
    let mut cur = n;
    while ((cur as usize) != 0) {
        td_nl(mut_view(*st));
        let k = unsafe { (*cur).kind };
        if k == HIR_STMT_ERROR {
            td_begin(mut_view(*st), 69);
        } else if k == HIR_STMT_LET {
            td_begin(mut_view(*st), 70);
            td_pat(mut_view(*st), unsafe { (*cur).pat });
            td_type(mut_view(*st), unsafe { (*cur).ty });
            td_expr(mut_view(*st), unsafe { (*cur).expr });
            if (unsafe { (*cur).else_block as usize }) != 0 {
                td_block(mut_view(*st), unsafe { (*cur).else_block });
            }
        } else if k == HIR_STMT_ASSIGN {
            td_begin(mut_view(*st), 71);
            td_expr(mut_view(*st), unsafe { (*cur).left });
            td_expr(mut_view(*st), unsafe { (*cur).right });
        } else if k == HIR_STMT_EXPR {
            td_begin(mut_view(*st), 72);
            td_bool(mut_view(*st), unsafe { (*cur).has_semi });
            td_expr(mut_view(*st), unsafe { (*cur).expr });
        }
        td_end(mut_view(*st));
        cur = unsafe { (*cur).next };
    }
}

fn td_item(st: mut_view<ThirDumpState>, n: *mut HirItem) {
    let mut cur = n;
    while ((cur as usize) != 0) {
        if (unsafe { (*cur).span.file.v }) == 0xFFFFFFFEu32 {
            cur = unsafe { (*cur).next };
            continue;
        }
        if st.filter_file.v != 0u32 && (unsafe { (*cur).span.file.v }) != 0u32 && (unsafe { (*cur).span.file.v }) != st.filter_file.v {
            cur = unsafe { (*cur).next };
            continue;
        }
        td_nl(mut_view(*st));
        let k = unsafe { (*cur).kind };
        if k == HIR_ITEM_ERROR {
            td_begin(mut_view(*st), 73);
        } else if k == HIR_ITEM_MODULE {
            td_begin(mut_view(*st), 74);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_dotted(mut_view(*st), unsafe { view((*cur).mod_path) });
        } else if k == HIR_ITEM_USE {
            td_begin(mut_view(*st), 75);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_use_tree(mut_view(*st), unsafe { (*cur).use_tree });
        } else if k == HIR_ITEM_FN {
            td_begin(mut_view(*st), 76);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_bool(mut_view(*st), unsafe { (*cur).is_async });
            td_bool(mut_view(*st), unsafe { (*cur).is_comptime });
            td_bool(mut_view(*st), unsafe { (*cur).is_unsafe });
            td_strid(mut_view(*st), unsafe { (*cur).abi });
            let orig_np = unsafe { thir_get_orig_item_name(view(*st.thir), cur as *const HirItem) };
            let fn_name_id = if (orig_np as usize) != 0 {
                StrId { v: unsafe { *orig_np } }
            } else {
                unsafe { (*cur).name }
            };
            td_strid(mut_view(*st), fn_name_id);
            td_generic_params(mut_view(*st), unsafe { (*cur).generic_params });
            let mut p: *mut HirParam = unsafe { (*cur).params };
            while ((p as usize) != 0) {
                td_nl(mut_view(*st));
                td_begin(mut_view(*st), 56);
                td_bool(mut_view(*st), unsafe { (*p).is_mut });
                td_symbol(mut_view(*st), unsafe { (*p).symbol });
                td_type(mut_view(*st), unsafe { (*p).ty });
                td_end(mut_view(*st));
                p = unsafe { (*p).next };
            }
            td_type(mut_view(*st), unsafe { (*cur).ret_type });
            td_where_clause(mut_view(*st), unsafe { (*cur).where_clause });
            if (unsafe { (*cur).body as usize }) != 0 {
                td_block(mut_view(*st), unsafe { (*cur).body });
            }
        } else if k == HIR_ITEM_STRUCT {
            td_begin(mut_view(*st), 77);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_strid(mut_view(*st), unsafe { (*cur).name });
            td_generic_params(mut_view(*st), unsafe { (*cur).generic_params });
            td_where_clause(mut_view(*st), unsafe { (*cur).where_clause });
            td_bool(mut_view(*st), unsafe { (*cur).is_tuple });
            if unsafe { (*cur).is_tuple } {
                td_type(mut_view(*st), unsafe { (*cur).tuple_types });
            } else {
                let mut f: *mut HirFieldDecl = unsafe { (*cur).struct_fields };
                while ((f as usize) != 0) {
                    td_nl(mut_view(*st));
                    td_begin(mut_view(*st), 78);
                    td_attr(mut_view(*st), unsafe { (*f).attrs });
                    td_vis(mut_view(*st), unsafe { view((*f).vis) });
                    td_strid(mut_view(*st), unsafe { (*f).name });
                    td_type(mut_view(*st), unsafe { (*f).ty });
                    td_end(mut_view(*st));
                    f = unsafe { (*f).next };
                }
            }
        } else if k == HIR_ITEM_ENUM {
            td_begin(mut_view(*st), 79);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_strid(mut_view(*st), unsafe { (*cur).name });
            td_generic_params(mut_view(*st), unsafe { (*cur).generic_params });
            td_where_clause(mut_view(*st), unsafe { (*cur).where_clause });
            let mut v: *mut HirVariantDecl = unsafe { (*cur).variants };
            while ((v as usize) != 0) {
                td_nl(mut_view(*st));
                td_begin(mut_view(*st), 80);
                td_attr(mut_view(*st), unsafe { (*v).attrs });
                td_strid(mut_view(*st), unsafe { (*v).name });
                td_bool(mut_view(*st), unsafe { (*v).is_struct });
                if unsafe { (*v).is_struct } {
                    let mut f: *mut HirFieldDecl = unsafe { (*v).struct_fields };
                    while ((f as usize) != 0) {
                        td_nl(mut_view(*st));
                        td_begin(mut_view(*st), 78);
                        td_attr(mut_view(*st), unsafe { (*f).attrs });
                        td_vis(mut_view(*st), unsafe { view((*f).vis) });
                        td_strid(mut_view(*st), unsafe { (*f).name });
                        td_type(mut_view(*st), unsafe { (*f).ty });
                        td_end(mut_view(*st));
                        f = unsafe { (*f).next };
                    }
                } else {
                    td_type(mut_view(*st), unsafe { (*v).tuple_types });
                }
                td_end(mut_view(*st));
                v = unsafe { (*v).next };
            }
        } else if k == HIR_ITEM_TRAIT {
            td_begin(mut_view(*st), 81);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_strid(mut_view(*st), unsafe { (*cur).name });
            td_generic_params(mut_view(*st), unsafe { (*cur).generic_params });
            td_type(mut_view(*st), unsafe { (*cur).supertraits });
            td_where_clause(mut_view(*st), unsafe { (*cur).where_clause });
            td_item(mut_view(*st), unsafe { (*cur).members });
        } else if k == HIR_ITEM_IMPL {
            td_begin(mut_view(*st), 82);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_generic_params(mut_view(*st), unsafe { (*cur).generic_params });
            td_type(mut_view(*st), unsafe { (*cur).trait_path });
            td_type(mut_view(*st), unsafe { (*cur).self_type });
            td_where_clause(mut_view(*st), unsafe { (*cur).where_clause });
            td_item(mut_view(*st), unsafe { (*cur).members });
        } else if k == HIR_ITEM_TYPE_ALIAS {
            td_begin(mut_view(*st), 83);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_strid(mut_view(*st), unsafe { (*cur).name });
            td_generic_params(mut_view(*st), unsafe { (*cur).generic_params });
            td_type(mut_view(*st), unsafe { (*cur).ty });
        } else if k == HIR_ITEM_CONST {
            td_begin(mut_view(*st), 84);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_strid(mut_view(*st), unsafe { (*cur).name });
            td_type(mut_view(*st), unsafe { (*cur).ty });
            td_expr(mut_view(*st), unsafe { (*cur).expr });
        } else if k == HIR_ITEM_STATIC {
            td_begin(mut_view(*st), 85);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_bool(mut_view(*st), unsafe { (*cur).is_unsafe });
            td_bool(mut_view(*st), unsafe { (*cur).is_mut });
            td_strid(mut_view(*st), unsafe { (*cur).name });
            td_type(mut_view(*st), unsafe { (*cur).ty });
            td_expr(mut_view(*st), unsafe { (*cur).expr });
        } else if k == HIR_ITEM_EXTERN_BLOCK {
            td_begin(mut_view(*st), 86);
            td_attr(mut_view(*st), unsafe { (*cur).attrs });
            td_vis(mut_view(*st), unsafe { view((*cur).vis) });
            td_strid(mut_view(*st), unsafe { (*cur).abi });
            td_item(mut_view(*st), unsafe { (*cur).members });
        }
        td_end(mut_view(*st));
        cur = unsafe { (*cur).next };
    }
}

pub fn emit_thir(
    buf: mut_view<DiagBuffer>,
    hir_file: view<HirFile>,
    thir: view<Thir>,
    interner: view<StrInterner>,
    filter_file: FileId
) {
    let buf_ptr = unsafe { address_of_mut(buf.ptr) as *mut DiagBuffer };
    let int_ptr = unsafe { address_of(interner.bytes.head) as *const StrInterner };
    let thir_ptr = unsafe { address_of(thir.interner.arena.head) as *const Thir };
    let mut st = ThirDumpState {
        buf: buf_ptr,
        interner: int_ptr,
        thir: thir_ptr,
        hir_items: hir_file.items,
        indent: 0,
        filter_file: (FileId { v: filter_file.v }),
    };
    td_item(mut_view(st), hir_file.items);
    unsafe { diag_buf_push_byte(mut_view(*buf_ptr), 10u8); }
}

fn tc_item_has_blocking_attr(it: *const HirItem, str_in: view<StrInterner>) -> bool {
    if (it as usize) == 0 {
        return false;
    }
    let mut at: *mut HirAttr = unsafe { (*it).attrs };
    while (at as usize) != 0 {
        let aname = unsafe { (*at).name };
        if aname.v != 0u32 {
            let sv = interner_get(str_in, StrId { v: aname.v });
            if tc_sv_is_8(view(sv), 98u8, 108u8, 111u8, 99u8, 107u8, 105u8, 110u8, 103u8) {
                return true;
            }
        }
        at = unsafe { (*at).next };
    }
    false
}

fn tc_bound_is_future(cx: view<TypeckCtx>, b: *const HirType) -> bool {
    if (b as usize) == 0 || (unsafe { (*b).kind }) != HIR_TYPE_PATH {
        return false;
    }
    let raw_bname = unsafe { tc_path_name_sv(cx, view((*b).path)) };
    if raw_bname.len == 0 || (raw_bname.ptr as usize) == 0 {
        return false;
    }
    let mut start: usize = 0;
    let mut end: usize = raw_bname.len;
    let mut k: usize = 0;
    while k < raw_bname.len {
        let ch = unsafe { *(raw_bname.ptr + k) };
        if ch == 60u8 {
            end = k;
            break;
        }
        if ch == 46u8 {
            start = k + 1;
        }
        k = k + 1;
    }
    if end <= start {
        return false;
    }
    let bname = StrView { ptr: unsafe { raw_bname.ptr + start }, len: end - start };
    is_future_trait_name(view(bname))
}

fn extract_future_bound_output_ty(cx: mut_view<TypeckCtx>, b: *const HirType) -> TypeId {
    let unit_v = unsafe { (*cx.thir).interner.t_unit.v };
    if (b as usize) == 0 || (unsafe { (*b).kind }) != HIR_TYPE_PATH {
        return (TypeId { v: unit_v });
    }
    let hga: *mut HirGenericArgs = unsafe { (*b).path.generic_args };
    if (hga as usize) != 0 && ((unsafe { (*hga).args }) as usize) != 0 {
        let ga: *mut HirGenericArg = unsafe { (*hga).args };
        let gty: *mut HirType = unsafe { (*ga).ty };
        if (gty as usize) != 0 {
            return hir_type_to_typeid(mut_view(*cx), gty);
        }
    }
    (TypeId { v: unit_v })
}

fn find_param_future_bound_output_in_item(
    cx: mut_view<TypeckCtx>,
    item: *const HirItem,
    p_idx: usize,
    p_name_v: u32
) -> TypeId {
    if (item as usize) == 0 {
        return (TypeId { v: 0u32 });
    }
    let mut actual_name_v: u32 = p_name_v;
    let mut actual_sym_v: u32 = 0u32;
    let gps: *mut HirGenericParams = unsafe { (*item).generic_params };
    if (gps as usize) != 0 {
        let mut idx: usize = 0;
        let mut gp: *mut HirGenericParam = unsafe { (*gps).params };
        while ((gp as usize) != 0) {
            let gname_v = unsafe { (*gp).name.v };
            if idx == p_idx {
                if gname_v != 0u32 {
                    actual_name_v = gname_v;
                }
                actual_sym_v = unsafe { (*gp).symbol.v };
            }
            if idx == p_idx || (gname_v != 0u32 && gname_v == p_name_v) {
                let mut b: *mut HirType = unsafe { (*gp).bounds };
                while ((b as usize) != 0) {
                    if tc_bound_is_future(view(*cx), b) {
                        return extract_future_bound_output_ty(mut_view(*cx), b);
                    }
                    b = unsafe { (*b).next };
                }
            }
            idx = idx + 1;
            gp = unsafe { (*gp).next };
        }
    }
    let wc: *mut HirWhereClause = unsafe { (*item).where_clause };
    if (wc as usize) != 0 {
        let p_sv = if (cx.str_in as usize) != 0 && actual_name_v != 0u32 {
            unsafe { interner_get(view(*cx.str_in), (StrId { v: actual_name_v })) }
        } else {
            StrView { ptr: 0 as *const u8, len: 0 }
        };
        let mut wp: *mut HirWherePred = unsafe { (*wc).preds };
        while ((wp as usize) != 0) {
            let wty: *mut HirType = unsafe { (*wp).ty };
            if (wty as usize) != 0 && (unsafe { (*wty).kind }) == HIR_TYPE_PATH {
                let wsym_v = unsafe { (*wty).path.symbol.v };
                let wname = unsafe { tc_path_name_sv(view(*cx), view((*wty).path)) };
                let matched = (actual_sym_v != 0u32 && wsym_v == actual_sym_v) ||
                              (p_sv.len > 0 && sv_eq(view(wname), view(p_sv)));
                if matched {
                    let mut b: *mut HirType = unsafe { (*wp).bounds };
                    while ((b as usize) != 0) {
                        if tc_bound_is_future(view(*cx), b) {
                            return extract_future_bound_output_ty(mut_view(*cx), b);
                        }
                        b = unsafe { (*b).next };
                    }
                }
            }
            wp = unsafe { (*wp).next };
        }
    }
    (TypeId { v: 0u32 })
}

fn resolve_future_output_ty(cx: mut_view<TypeckCtx>, fut_ty: TypeId) -> TypeId {
    let r_ty = resolve_ty(mut_view(*cx), (TypeId { v: fut_ty.v }));
    if r_ty.v == 0u32 || is_error(mut_view(*cx), (TypeId { v: r_ty.v })) {
        return (TypeId { v: 0u32 });
    }
    let ft = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r_ty.v })) };
    if (ft as usize) == 0 {
        return (TypeId { v: 0u32 });
    }
    let fk = unsafe { (*ft).kind };
    if fk == TY_COROUTINE {
        let ret_id = unsafe { (*ft).ret_type };
        return resolve_ty(mut_view(*cx), (TypeId { v: ret_id.v }));
    }
    if fk == TY_PARAM {
        let p_idx = unsafe { (*ft).param_index as usize };
        let p_name_v = unsafe { (*ft).name.v };
        if (cx.current_fn as usize) != 0 {
            let out1 = find_param_future_bound_output_in_item(mut_view(*cx), cx.current_fn, p_idx, p_name_v);
            if out1.v != 0u32 {
                return resolve_ty(mut_view(*cx), out1);
            }
        }
        if (cx.current_impl as usize) != 0 {
            let out2 = find_param_future_bound_output_in_item(mut_view(*cx), cx.current_impl, p_idx, p_name_v);
            if out2.v != 0u32 {
                return resolve_ty(mut_view(*cx), out2);
            }
        }
        return (TypeId { v: 0u32 });
    }
    if (cx.hir as usize) != 0 && (cx.str_in as usize) != 0 {
        let mut it: *mut HirItem = unsafe { (*cx.hir).items };
        while ((it as usize) != 0) {
            if (unsafe { (*it).kind }) == HIR_ITEM_IMPL && !(unsafe { (*it).is_negative }) {
                let tp: *mut HirType = unsafe { (*it).trait_path };
                if (tp as usize) != 0 && tc_bound_is_future(view(*cx), tp) {
                    if unsafe { type_matches_impl_self_exact(view(*cx.thir), view(*cx.str_in), it, (TypeId { v: r_ty.v })) } {
                        let mut m: *mut HirItem = unsafe { (*it).members };
                        while ((m as usize) != 0) {
                            if (unsafe { (*m).kind }) == HIR_ITEM_TYPE_ALIAS {
                                let mut m_ty = unsafe { thir_get_item_type(view(*cx.thir), m) };
                                if m_ty.v == 0u32 && ((unsafe { (*m).ty }) as usize) != 0 {
                                    let save_impl = cx.current_impl;
                                    let save_self = cx.self_ty;
                                    cx.current_impl = it;
                                    cx.self_ty.v = r_ty.v;
                                    let m_ty_ptr: *mut HirType = unsafe { (*m).ty };
                                    m_ty = hir_type_to_typeid(mut_view(*cx), m_ty_ptr);
                                    cx.current_impl = save_impl;
                                    cx.self_ty.v = save_self.v;
                                }
                                if (unsafe { (*ft).arg_count }) > 0 && ((unsafe { (*ft).args }) as usize) != 0 {
                                    let gslice = GenericArgsSlice {
                                        args: unsafe { (*ft).args },
                                        count: unsafe { (*ft).arg_count },
                                    };
                                    m_ty = unsafe {
                                        subst_ty_with_vars(
                                            mut_view((*cx.thir).interner),
                                            mut_view(cx.type_vars),
                                            m_ty,
                                            view(gslice)
                                        )
                                    };
                                }
                                return resolve_ty(mut_view(*cx), m_ty);
                            }
                            m = unsafe { (*m).next };
                        }
                        let unit_v = unsafe { (*cx.thir).interner.t_unit.v };
                        return (TypeId { v: unit_v });
                    }
                }
            }
            it = unsafe { (*it).next };
        }
    }
    (TypeId { v: 0u32 })
}

fn fn_item_has_any_future_bound(cx: view<TypeckCtx>, fn_def: *const HirItem) -> bool {
    if (fn_def as usize) == 0 {
        return false;
    }
    let gps: *mut HirGenericParams = unsafe { (*fn_def).generic_params };
    if (gps as usize) != 0 {
        let mut gp: *mut HirGenericParam = unsafe { (*gps).params };
        while ((gp as usize) != 0) {
            let mut b: *mut HirType = unsafe { (*gp).bounds };
            while ((b as usize) != 0) {
                if tc_bound_is_future(view(*cx), b) && ((unsafe { (*b).path.generic_args }) as usize) != 0 {
                    return true;
                }
                b = unsafe { (*b).next };
            }
            gp = unsafe { (*gp).next };
        }
    }
    let wc: *mut HirWhereClause = unsafe { (*fn_def).where_clause };
    if (wc as usize) != 0 {
        let mut wp: *mut HirWherePred = unsafe { (*wc).preds };
        while ((wp as usize) != 0) {
            let mut wb: *mut HirType = unsafe { (*wp).bounds };
            while ((wb as usize) != 0) {
                if tc_bound_is_future(view(*cx), wb) && ((unsafe { (*wb).path.generic_args }) as usize) != 0 {
                    return true;
                }
                wb = unsafe { (*wb).next };
            }
            wp = unsafe { (*wp).next };
        }
    }
    false
}

fn check_future_bound_outputs_for_call(
    cx: mut_view<TypeckCtx>,
    fn_def: *const HirItem,
    substs: *const GenericArgsSlice,
    call_span: Span
) {
    if (fn_def as usize) == 0 || (substs as usize) == 0 {
        return;
    }
    let cnt = unsafe { (*substs).count };
    let args = unsafe { (*substs).args };
    if cnt == 0 || (args as usize) == 0 {
        return;
    }
    let gps: *mut HirGenericParams = unsafe { (*fn_def).generic_params };
    if (gps as usize) == 0 || !fn_item_has_any_future_bound(view(*cx), fn_def) {
        return;
    }
    let save_fn = cx.current_fn;
    let mut dummy_cnt: usize = 0;
    let _ = build_item_generic_param_args(mut_view(*cx), fn_def, mut_view(dummy_cnt));
    cx.current_fn = fn_def;

    let mut idx: usize = 0;
    let mut gp: *mut HirGenericParam = unsafe { (*gps).params };
    while ((gp as usize) != 0) && idx < cnt {
        let arg_ty = resolve_ty(mut_view(*cx), unsafe { *typeid_at(args, idx) });
        let actual_out = resolve_future_output_ty(mut_view(*cx), arg_ty);
        if actual_out.v != 0u32 {
            let mut b: *mut HirType = unsafe { (*gp).bounds };
            while ((b as usize) != 0) {
                if tc_bound_is_future(view(*cx), b) && ((unsafe { (*b).path.generic_args }) as usize) != 0 {
                    let raw_exp = extract_future_bound_output_ty(mut_view(*cx), b);
                    let exp_out = unsafe {
                        subst_ty_with_vars(
                            mut_view((*cx.thir).interner),
                            mut_view(cx.type_vars),
                            raw_exp,
                            view(*substs)
                        )
                    };
                    let _ = coerce(mut_view(*cx), (TypeId { v: actual_out.v }), exp_out, view(call_span));
                }
                b = unsafe { (*b).next };
            }
            let wc: *mut HirWhereClause = unsafe { (*fn_def).where_clause };
            let gname_v = unsafe { (*gp).name.v };
            if (wc as usize) != 0 && (cx.str_in as usize) != 0 && gname_v != 0u32 {
                let g_sv = unsafe { interner_get(view(*cx.str_in), (StrId { v: gname_v })) };
                let mut wp: *mut HirWherePred = unsafe { (*wc).preds };
                while ((wp as usize) != 0) {
                    let wty: *mut HirType = unsafe { (*wp).ty };
                    if (wty as usize) != 0 && (unsafe { (*wty).kind }) == HIR_TYPE_PATH {
                        let wname = unsafe { tc_path_name_sv(view(*cx), view((*wty).path)) };
                        if sv_eq(view(wname), view(g_sv)) {
                            let mut wb: *mut HirType = unsafe { (*wp).bounds };
                            while ((wb as usize) != 0) {
                                if tc_bound_is_future(view(*cx), wb) && ((unsafe { (*wb).path.generic_args }) as usize) != 0 {
                                    let raw_exp2 = extract_future_bound_output_ty(mut_view(*cx), wb);
                                    let exp_out2 = unsafe {
                                        subst_ty_with_vars(
                                            mut_view((*cx.thir).interner),
                                            mut_view(cx.type_vars),
                                            raw_exp2,
                                            view(*substs)
                                        )
                                    };
                                    let _ = coerce(mut_view(*cx), (TypeId { v: actual_out.v }), exp_out2, view(call_span));
                                }
                                wb = unsafe { (*wb).next };
                            }
                        }
                    }
                    wp = unsafe { (*wp).next };
                }
            }
        }
        idx = idx + 1;
        gp = unsafe { (*gp).next };
    }

    cx.current_fn = save_fn;
    if (save_fn as usize) != 0 {
        let mut restore_cnt: usize = 0;
        let _ = build_item_generic_param_args(mut_view(*cx), save_fn, mut_view(restore_cnt));
    }
}

fn tc_bound_is_callable(cx: view<TypeckCtx>, b: *const HirType) -> bool {
    if (b as usize) == 0 || (unsafe { (*b).kind }) != HIR_TYPE_PATH {
        return false;
    }
    let raw_bname = unsafe { tc_path_name_sv(cx, view((*b).path)) };
    if raw_bname.len == 0 || (raw_bname.ptr as usize) == 0 {
        return false;
    }
    let mut start: usize = 0;
    let mut end: usize = raw_bname.len;
    let mut k: usize = 0;
    while k < raw_bname.len {
        let ch = unsafe { *(raw_bname.ptr + k) };
        if ch == 60u8 {
            end = k;
            break;
        }
        if ch == 46u8 {
            start = k + 1;
        }
        k = k + 1;
    }
    if end <= start {
        return false;
    }
    let bname = StrView { ptr: unsafe { raw_bname.ptr + start }, len: end - start };
    tc_sv_is_2(view(bname), 70u8, 110u8) ||
    tc_sv_is_5(view(bname), 70u8, 110u8, 77u8, 117u8, 116u8) ||
    tc_sv_is_6(view(bname), 70u8, 110u8, 79u8, 110u8, 99u8, 101u8) ||
    tc_sv_is_8(view(bname), 67u8, 97u8, 108u8, 108u8, 97u8, 98u8, 108u8, 101u8)
}

fn tc_find_callable_bound_in_item(
    cx: view<TypeckCtx>,
    item: *const HirItem,
    p_idx: usize,
    p_name_v: u32
) -> *const HirType {
    if (item as usize) == 0 {
        return 0 as *const HirType;
    }
    let mut actual_name_v: u32 = p_name_v;
    let mut actual_sym_v: u32 = 0u32;
    let gps: *mut HirGenericParams = unsafe { (*item).generic_params };
    if (gps as usize) != 0 {
        let mut idx: usize = 0;
        let mut gp: *mut HirGenericParam = unsafe { (*gps).params };
        while ((gp as usize) != 0) {
            let gname_v = unsafe { (*gp).name.v };
            if idx == p_idx {
                if gname_v != 0u32 { actual_name_v = gname_v; }
                actual_sym_v = unsafe { (*gp).symbol.v };
            }
            if idx == p_idx || (gname_v != 0u32 && gname_v == p_name_v) {
                let mut b: *mut HirType = unsafe { (*gp).bounds };
                while ((b as usize) != 0) {
                    if tc_bound_is_callable(cx, b) {
                        return b;
                    }
                    b = unsafe { (*b).next };
                }
            }
            idx = idx + 1;
            gp = unsafe { (*gp).next };
        }
    }
    let wc: *mut HirWhereClause = unsafe { (*item).where_clause };
    if (wc as usize) != 0 {
        let p_sv = if (cx.str_in as usize) != 0 && actual_name_v != 0u32 {
            unsafe { interner_get(view(*cx.str_in), (StrId { v: actual_name_v })) }
        } else {
            StrView { ptr: 0 as *const u8, len: 0 }
        };
        let mut wp: *mut HirWherePred = unsafe { (*wc).preds };
        while ((wp as usize) != 0) {
            let wty: *mut HirType = unsafe { (*wp).ty };
            if (wty as usize) != 0 && (unsafe { (*wty).kind }) == HIR_TYPE_PATH {
                let wsym_v = unsafe { (*wty).path.symbol.v };
                let wname = unsafe { tc_path_name_sv(cx, view((*wty).path)) };
                let matched = (actual_sym_v != 0u32 && wsym_v == actual_sym_v) ||
                              (p_sv.len > 0 && sv_eq(view(wname), view(p_sv)));
                if matched {
                    let mut wb: *mut HirType = unsafe { (*wp).bounds };
                    while ((wb as usize) != 0) {
                        if tc_bound_is_callable(cx, wb) {
                            return wb;
                        }
                        wb = unsafe { (*wb).next };
                    }
                }
            }
            wp = unsafe { (*wp).next };
        }
    }
    0 as *const HirType
}

fn fn_item_has_any_callable_bound_with_args(cx: view<TypeckCtx>, fn_def: *const HirItem) -> bool {
    if (fn_def as usize) == 0 {
        return false;
    }
    let gps: *mut HirGenericParams = unsafe { (*fn_def).generic_params };
    if (gps as usize) != 0 {
        let mut gp: *mut HirGenericParam = unsafe { (*gps).params };
        while ((gp as usize) != 0) {
            let mut b: *mut HirType = unsafe { (*gp).bounds };
            while ((b as usize) != 0) {
                if tc_bound_is_callable(cx, b) && ((unsafe { (*b).path.generic_args }) as usize) != 0 {
                    return true;
                }
                b = unsafe { (*b).next };
            }
            gp = unsafe { (*gp).next };
        }
    }
    let wc: *mut HirWhereClause = unsafe { (*fn_def).where_clause };
    if (wc as usize) != 0 {
        let mut wp: *mut HirWherePred = unsafe { (*wc).preds };
        while ((wp as usize) != 0) {
            let mut wb: *mut HirType = unsafe { (*wp).bounds };
            while ((wb as usize) != 0) {
                if tc_bound_is_callable(cx, wb) && ((unsafe { (*wb).path.generic_args }) as usize) != 0 {
                    return true;
                }
                wb = unsafe { (*wb).next };
            }
            wp = unsafe { (*wp).next };
        }
    }
    false
}

fn tc_callable_bound_to_subst_fn_ty(
    cx: mut_view<TypeckCtx>,
    fn_def: *const HirItem,
    substs: *const GenericArgsSlice,
    cb: *const HirType
) -> TypeId {
    if (cb as usize) == 0 || (substs as usize) == 0 {
        return (TypeId { v: 0u32 });
    }
    let hga: *mut HirGenericArgs = unsafe { (*cb).path.generic_args };
    if (hga as usize) == 0 || ((unsafe { (*hga).args }) as usize) == 0 {
        return (TypeId { v: 0u32 });
    }
    let mut gcount: usize = 0;
    let mut ga: *mut HirGenericArg = unsafe { (*hga).args };
    while ((ga as usize) != 0) {
        gcount = gcount + 1;
        ga = unsafe { (*ga).next };
    }
    if gcount == 0 {
        return (TypeId { v: 0u32 });
    }
    let save_fn = cx.current_fn;
    let mut dummy_cnt: usize = 0;
    let _ = build_item_generic_param_args(mut_view(*cx), fn_def, mut_view(dummy_cnt));
    cx.current_fn = fn_def;

    let pcount = gcount - 1;
    let mut ptypes: *mut TypeId = 0 as *mut TypeId;
    if pcount > 0 {
        let pbytes = mul_usize(pcount, size_of<TypeId>());
        ptypes = unsafe { arena_alloc_raw(mut_view((*cx.thir).interner.arena), pbytes, align_of<TypeId>()) as *mut TypeId };
    }
    let mut ret_ty = (TypeId { v: unsafe { (*cx.thir).interner.t_unit.v } });
    let mut j: usize = 0;
    ga = unsafe { (*hga).args };
    while ((ga as usize) != 0) {
        let gty: *mut HirType = unsafe { (*ga).ty };
        let raw_t = if (gty as usize) != 0 { hir_type_to_typeid(mut_view(*cx), gty) } else { TypeId { v: ret_ty.v } };
        let sub_t = unsafe {
            subst_ty_with_vars(
                mut_view((*cx.thir).interner),
                mut_view(cx.type_vars),
                raw_t,
                view(*substs)
            )
        };
        if j < pcount {
            let dst = unsafe { typeid_at(ptypes, j) };
            unsafe { (*dst).v = sub_t.v; }
        } else {
            ret_ty = sub_t;
        }
        j = j + 1;
        ga = unsafe { (*ga).next };
    }

    cx.current_fn = save_fn;
    if (cx.current_impl as usize) != 0 {
        let mut r_impl: usize = 0;
        let _ = build_item_generic_param_args(mut_view(*cx), cx.current_impl, mut_view(r_impl));
    }
    if (save_fn as usize) != 0 {
        let mut r_fn: usize = 0;
        let _ = build_item_generic_param_args(mut_view(*cx), save_fn, mut_view(r_fn));
    }
    unsafe { intern_fn_ty(mut_view((*cx.thir).interner), false, (StrId { v: 0u32 }), ptypes, pcount, (TypeId { v: ret_ty.v })) }
}

fn tc_build_callable_hint_ty(
    cx: mut_view<TypeckCtx>,
    fn_def: *const HirItem,
    substs: *const GenericArgsSlice,
    param_ty: TypeId
) -> TypeId {
    if (fn_def as usize) == 0 || (substs as usize) == 0 || !fn_item_has_any_callable_bound_with_args(view(*cx), fn_def) {
        return (TypeId { v: 0u32 });
    }
    let r_param = resolve_ty(mut_view(*cx), param_ty);
    let cnt = unsafe { (*substs).count };
    let args = unsafe { (*substs).args };
    let mut idx: usize = 0;
    while idx < cnt {
        let g_var = resolve_ty(mut_view(*cx), unsafe { *typeid_at(args, idx) });
        if g_var.v == r_param.v {
            let cb = tc_find_callable_bound_in_item(view(*cx), fn_def, idx, 0u32);
            if (cb as usize) != 0 {
                return tc_callable_bound_to_subst_fn_ty(mut_view(*cx), fn_def, substs, cb);
            }
        }
        idx = idx + 1;
    }
    (TypeId { v: 0u32 })
}

fn check_callable_bound_outputs_for_call(
    cx: mut_view<TypeckCtx>,
    fn_def: *const HirItem,
    substs: *const GenericArgsSlice,
    call_span: Span
) {
    if (fn_def as usize) == 0 || (substs as usize) == 0 || !fn_item_has_any_callable_bound_with_args(view(*cx), fn_def) {
        return;
    }
    let cnt = unsafe { (*substs).count };
    let args = unsafe { (*substs).args };
    let mut idx: usize = 0;
    while idx < cnt {
        let arg_ty = resolve_ty(mut_view(*cx), unsafe { *typeid_at(args, idx) });
        let at = unsafe { type_get(view((*cx.thir).interner), arg_ty) };
        if (at as usize) != 0 && (unsafe { (*at).kind == TY_CLOSURE || (*at).kind == TY_FN }) {
            let cb = tc_find_callable_bound_in_item(view(*cx), fn_def, idx, 0u32);
            if (cb as usize) != 0 {
                let sig_ty = tc_callable_bound_to_subst_fn_ty(mut_view(*cx), fn_def, substs, cb);
                let st = unsafe { type_get(view((*cx.thir).interner), sig_ty) };
                if (st as usize) != 0 && unsafe { (*st).kind == TY_FN } {
                    let act_pcnt = unsafe { (*at).param_count };
                    let exp_pcnt = unsafe { (*st).param_count };
                    let min_p = if act_pcnt < exp_pcnt { act_pcnt } else { exp_pcnt };
                    let mut p: usize = 0;
                    while p < min_p {
                        let ap = unsafe { *typeid_at((*at).param_types, p) };
                        let ep = unsafe { *typeid_at((*st).param_types, p) };
                        let _ = unify_ty(mut_view(*cx), ap, ep);
                        p = p + 1;
                    }
                    let act_ret = resolve_ty(mut_view(*cx), unsafe { (*at).ret_type });
                    let exp_ret = resolve_ty(mut_view(*cx), unsafe { (*st).ret_type });
                    if act_ret.v != 0u32 && exp_ret.v != 0u32 {
                        let _ = coerce(mut_view(*cx), act_ret, exp_ret, view(call_span));
                    }
                }
            }
        }
        idx = idx + 1;
    }
}

struct AsyncVisitStack {
    pub fns: [64]usize,
    pub count: usize,
}

fn async_visit_contains(st: view<AsyncVisitStack>, fn_addr: usize) -> bool {
    let mut i: usize = 0;
    while i < st.count {
        if st.fns[i] == fn_addr {
            return true;
        }
        i = i + 1;
    }
    false
}

fn type_reaches_target_async_fn(
    cx: mut_view<TypeckCtx>,
    ty: TypeId,
    target_fn: *const HirItem,
    st: mut_view<AsyncVisitStack>,
    depth: usize
) -> bool {
    if depth > 16 || ty.v == 0u32 {
        return false;
    }
    let r_ty = resolve_ty(mut_view(*cx), (TypeId { v: ty.v }));
    let t = unsafe { type_get(view((*cx.thir).interner), (TypeId { v: r_ty.v })) };
    if (t as usize) == 0 {
        return false;
    }
    let tk = unsafe { (*t).kind };
    if tk == TY_COROUTINE {
        let callee_fn: *const HirItem = unsafe { (*t).def };
        if (callee_fn as usize) == 0 {
            return false;
        }
        if (callee_fn as usize) == (target_fn as usize) {
            return true;
        }
        if !async_visit_contains(view(*st), callee_fn as usize) && (st.count) < 64 {
            let idx = st.count;
            st.fns[idx] = callee_fn as usize;
            st.count = idx + 1;
            let c_body: *mut HirBlock = unsafe { (*callee_fn).body };
            let hit = block_find_recursive_await(mut_view(*cx), c_body, target_fn, mut_view(*st));
            if (hit as usize) != 0 {
                return true;
            }
        }
        return false;
    }
    if tk == TY_TUPLE || tk == TY_STRUCT {
        let fc = unsafe { (*t).field_count };
        let fptr = unsafe { (*t).fields };
        let mut i: usize = 0;
        while i < fc && (fptr as usize) != 0 {
            let fv = unsafe { (*typeid_at(fptr, i)).v };
            if type_reaches_target_async_fn(mut_view(*cx), (TypeId { v: fv }), target_fn, mut_view(*st), depth + 1) {
                return true;
            }
            i = i + 1;
        }
    } else if tk == TY_ENUM {
        let vc = unsafe { (*t).variant_count };
        let vfc = unsafe { (*t).variant_field_counts };
        let vfptr = unsafe { (*t).variant_fields };
        let mut v: usize = 0;
        while v < vc && (vfc as usize) != 0 && (vfptr as usize) != 0 {
            let fc = unsafe { *usize_at(vfc, v) };
            let row = unsafe { *typeid_ptr_at(vfptr, v) };
            let mut j: usize = 0;
            while j < fc && (row as usize) != 0 {
                let fv = unsafe { (*typeid_at(row, j)).v };
                if type_reaches_target_async_fn(mut_view(*cx), (TypeId { v: fv }), target_fn, mut_view(*st), depth + 1) {
                    return true;
                }
                j = j + 1;
            }
            v = v + 1;
        }
    } else if tk == TY_ARRAY {
        let ev = unsafe { (*t).elem.v };
        return type_reaches_target_async_fn(mut_view(*cx), (TypeId { v: ev }), target_fn, mut_view(*st), depth + 1);
    }
    false
}

fn expr_find_recursive_await(
    cx: mut_view<TypeckCtx>,
    expr: *mut HirExpr,
    target_fn: *const HirItem,
    st: mut_view<AsyncVisitStack>
) -> *mut HirExpr {
    if (expr as usize) == 0 {
        return 0 as *mut HirExpr;
    }
    let ek = unsafe { (*expr).kind };
    if ek == HIR_EXPR_AWAIT {
        let in_e: *mut HirExpr = unsafe { (*expr).inner };
        let inner_hit = expr_find_recursive_await(mut_view(*cx), in_e, target_fn, mut_view(*st));
        if (inner_hit as usize) != 0 {
            return inner_hit;
        }
        if (in_e as usize) != 0 {
            let tp = unsafe { thir_get_expr_type(view(*cx.thir), in_e) };
            if tp.v != 0u32 {
                if type_reaches_target_async_fn(mut_view(*cx), (TypeId { v: tp.v }), target_fn, mut_view(*st), 0) {
                    return expr;
                }
            }
        }
        return 0 as *mut HirExpr;
    }
    if ek == HIR_EXPR_BLOCK || ek == HIR_EXPR_LOOP || ek == HIR_EXPR_UNSAFE || ek == HIR_EXPR_COMPTIME {
        let sub_blk: *mut HirBlock = unsafe { (*expr).block };
        return block_find_recursive_await(mut_view(*cx), sub_blk, target_fn, mut_view(*st));
    }
    if ek == HIR_EXPR_IF {
        let cond_e: *mut HirExpr = unsafe { (*expr).cond };
        let h1 = expr_find_recursive_await(mut_view(*cx), cond_e, target_fn, mut_view(*st));
        if (h1 as usize) != 0 { return h1; }
        let then_b: *mut HirBlock = unsafe { (*expr).block };
        let h2 = block_find_recursive_await(mut_view(*cx), then_b, target_fn, mut_view(*st));
        if (h2 as usize) != 0 { return h2; }
        let else_e: *mut HirExpr = unsafe { (*expr).else_branch };
        return expr_find_recursive_await(mut_view(*cx), else_e, target_fn, mut_view(*st));
    }
    if ek == HIR_EXPR_WHILE || ek == HIR_EXPR_FOR {
        let cond_e: *mut HirExpr = unsafe { (*expr).cond };
        let h1 = expr_find_recursive_await(mut_view(*cx), cond_e, target_fn, mut_view(*st));
        if (h1 as usize) != 0 { return h1; }
        let iter_e: *mut HirExpr = unsafe { (*expr).iter };
        let h2 = expr_find_recursive_await(mut_view(*cx), iter_e, target_fn, mut_view(*st));
        if (h2 as usize) != 0 { return h2; }
        let body_b: *mut HirBlock = unsafe { (*expr).block };
        return block_find_recursive_await(mut_view(*cx), body_b, target_fn, mut_view(*st));
    }
    if ek == HIR_EXPR_MATCH {
        let scrut_e: *mut HirExpr = unsafe { (*expr).cond };
        let h1 = expr_find_recursive_await(mut_view(*cx), scrut_e, target_fn, mut_view(*st));
        if (h1 as usize) != 0 { return h1; }
        let mut arm: *mut HirMatchArm = unsafe { (*expr).arms };
        while ((arm as usize) != 0) {
            let guard_e: *mut HirExpr = unsafe { (*arm).guard };
            let hg = expr_find_recursive_await(mut_view(*cx), guard_e, target_fn, mut_view(*st));
            if (hg as usize) != 0 { return hg; }
            let body_e: *mut HirExpr = unsafe { (*arm).body };
            let hb = expr_find_recursive_await(mut_view(*cx), body_e, target_fn, mut_view(*st));
            if (hb as usize) != 0 { return hb; }
            arm = unsafe { (*arm).next };
        }
        return 0 as *mut HirExpr;
    }
    if ek == HIR_EXPR_CALL {
        let callee_e: *mut HirExpr = unsafe { (*expr).callee };
        let hc = expr_find_recursive_await(mut_view(*cx), callee_e, target_fn, mut_view(*st));
        if (hc as usize) != 0 { return hc; }
        let mut a: *mut HirExpr = unsafe { (*expr).args };
        while ((a as usize) != 0) {
            let ha = expr_find_recursive_await(mut_view(*cx), a, target_fn, mut_view(*st));
            if (ha as usize) != 0 { return ha; }
            a = unsafe { (*a).next };
        }
        return 0 as *mut HirExpr;
    }
    if ek == HIR_EXPR_METHOD_CALL {
        let recv_e: *mut HirExpr = unsafe { (*expr).receiver };
        let hr = expr_find_recursive_await(mut_view(*cx), recv_e, target_fn, mut_view(*st));
        if (hr as usize) != 0 { return hr; }
        let mut a: *mut HirExpr = unsafe { (*expr).args };
        while ((a as usize) != 0) {
            let ha = expr_find_recursive_await(mut_view(*cx), a, target_fn, mut_view(*st));
            if (ha as usize) != 0 { return ha; }
            a = unsafe { (*a).next };
        }
        return 0 as *mut HirExpr;
    }
    if ek == HIR_EXPR_BINARY {
        let left_e: *mut HirExpr = unsafe { (*expr).left };
        let hl = expr_find_recursive_await(mut_view(*cx), left_e, target_fn, mut_view(*st));
        if (hl as usize) != 0 { return hl; }
        let right_e: *mut HirExpr = unsafe { (*expr).right };
        return expr_find_recursive_await(mut_view(*cx), right_e, target_fn, mut_view(*st));
    }
    if ek == HIR_EXPR_UNARY || ek == HIR_EXPR_TRY || ek == HIR_EXPR_CAST || ek == HIR_EXPR_VIEW || ek == HIR_EXPR_JUMP {
        let inner_e: *mut HirExpr = unsafe { (*expr).inner };
        return expr_find_recursive_await(mut_view(*cx), inner_e, target_fn, mut_view(*st));
    }
    if ek == HIR_EXPR_FIELD || ek == HIR_EXPR_TUPLE_INDEX || ek == HIR_EXPR_INDEX {
        let base_e: *mut HirExpr = unsafe { (*expr).base };
        let hb = expr_find_recursive_await(mut_view(*cx), base_e, target_fn, mut_view(*st));
        if (hb as usize) != 0 { return hb; }
        let idx_e: *mut HirExpr = unsafe { (*expr).index_arg };
        return expr_find_recursive_await(mut_view(*cx), idx_e, target_fn, mut_view(*st));
    }
    if ek == HIR_EXPR_TUPLE || ek == HIR_EXPR_ARRAY {
        let mut e: *mut HirExpr = unsafe { (*expr).elems };
        while ((e as usize) != 0) {
            let he = expr_find_recursive_await(mut_view(*cx), e, target_fn, mut_view(*st));
            if (he as usize) != 0 { return he; }
            e = unsafe { (*e).next };
        }
        return 0 as *mut HirExpr;
    }
    if ek == HIR_EXPR_STRUCT {
        let mut f: *mut HirFieldInit = unsafe { (*expr).fields };
        while ((f as usize) != 0) {
            let f_val: *mut HirExpr = unsafe { (*f).expr };
            let hf = expr_find_recursive_await(mut_view(*cx), f_val, target_fn, mut_view(*st));
            if (hf as usize) != 0 { return hf; }
            f = unsafe { (*f).next };
        }
        return 0 as *mut HirExpr;
    }
    0 as *mut HirExpr
}

fn block_find_recursive_await(
    cx: mut_view<TypeckCtx>,
    blk: *mut HirBlock,
    target_fn: *const HirItem,
    st: mut_view<AsyncVisitStack>
) -> *mut HirExpr {
    if (blk as usize) == 0 {
        return 0 as *mut HirExpr;
    }
    let mut s: *mut HirStmt = unsafe { (*blk).stmts };
    while ((s as usize) != 0) {
        let sk = unsafe { (*s).kind };
        if sk == HIR_STMT_LET {
            let init_e: *mut HirExpr = unsafe { (*s).expr };
            let h = expr_find_recursive_await(mut_view(*cx), init_e, target_fn, mut_view(*st));
            if (h as usize) != 0 { return h; }
            let else_b: *mut HirBlock = unsafe { (*s).else_block };
            let he = block_find_recursive_await(mut_view(*cx), else_b, target_fn, mut_view(*st));
            if (he as usize) != 0 { return he; }
        } else if sk == HIR_STMT_ASSIGN {
            let left_e: *mut HirExpr = unsafe { (*s).left };
            let hl = expr_find_recursive_await(mut_view(*cx), left_e, target_fn, mut_view(*st));
            if (hl as usize) != 0 { return hl; }
            let right_e: *mut HirExpr = unsafe { (*s).right };
            let hr = expr_find_recursive_await(mut_view(*cx), right_e, target_fn, mut_view(*st));
            if (hr as usize) != 0 { return hr; }
        } else if sk == HIR_STMT_EXPR {
            let stmt_e: *mut HirExpr = unsafe { (*s).expr };
            let he = expr_find_recursive_await(mut_view(*cx), stmt_e, target_fn, mut_view(*st));
            if (he as usize) != 0 { return he; }
        }
        s = unsafe { (*s).next };
    }
    0 as *mut HirExpr
}

fn check_single_async_fn_recursion(cx: mut_view<TypeckCtx>, fn_it: *const HirItem) {
    if (fn_it as usize) == 0 || !(unsafe { (*fn_it).is_async }) || tc_is_default_inst(fn_it) {
        return;
    }
    let body_blk: *mut HirBlock = unsafe { (*fn_it).body };
    if (body_blk as usize) == 0 {
        return;
    }
    let mut st = AsyncVisitStack {
        fns: [0usize; 64],
        count: 1,
    };
    st.fns[0] = fn_it as usize;
    let cycle_await = block_find_recursive_await(mut_view(*cx), body_blk, fn_it, mut_view(st));
    if (cycle_await as usize) != 0 {
        let _ = unsafe { type_error(mut_view(*cx), view((*cycle_await).span), AX_ASYNC_RECURSIVE_FUTURE) };
    }
}

fn check_recursive_async_fns(cx: mut_view<TypeckCtx>) {
    if (cx.hir as usize) == 0 || (cx.thir as usize) == 0 || (cx.sink as usize) == 0 {
        return;
    }
    let mut top_it: *mut HirItem = unsafe { (*cx.hir).items };
    while ((top_it as usize) != 0) {
        let tk = unsafe { (*top_it).kind };
        if tk == HIR_ITEM_FN {
            let sym_v = unsafe { (*top_it).symbol.v };
            if !(sym_v >= 0x40000000u32 && sym_v < 0x50000000u32) {
                let orig_m = unsafe { find_orig_impl_member_with_thir(view(*cx.hir), cx.thir as *const Thir, top_it) };
                if (orig_m as usize) == 0 {
                    check_single_async_fn_recursion(mut_view(*cx), top_it);
                }
            }
        } else if tk == HIR_ITEM_IMPL || tk == HIR_ITEM_TRAIT {
            let mut m: *mut HirItem = unsafe { (*top_it).members };
            while ((m as usize) != 0) {
                if (unsafe { (*m).kind }) == HIR_ITEM_FN {
                    check_single_async_fn_recursion(mut_view(*cx), m);
                }
                m = unsafe { (*m).next };
            }
        }
        top_it = unsafe { (*top_it).next };
    }
}

