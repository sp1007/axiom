    pub pat: *mut AstPat,
    pub iter: *mut AstExpr,
    pub is_mut: bool,
    pub jump_kind: u8,
    pub params: *mut AstParam,
    pub ret_type: *mut AstType,
    pub body: *mut AstExpr,
    pub is_inclusive: bool,
    pub start_expr: *mut AstExpr,
    pub end_expr: *mut AstExpr,
    pub op: u8,
    pub left: *mut AstExpr,
    pub right: *mut AstExpr,
    pub cast_ty: *mut AstType,
    pub head: *mut AstExpr,
    pub postfix_segs: *mut AstPostfixSeg,
