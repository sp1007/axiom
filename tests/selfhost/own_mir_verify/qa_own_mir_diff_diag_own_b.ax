fn lower_postfix(ctx: mut_view<LowerCtx>, arena: mut_view<Arena>, rmap: view<ResolveMap>, sink: mut_view<DiagSink>, e: *mut AstExpr) -> *mut HirExpr {
    let mut head = lower_expr(mut_view(*ctx), mut_view(*arena), view(*rmap), mut_view(*sink), unsafe { (*e).head });
    let mut seg: *mut AstPostfixSeg = unsafe { (*e).postfix_segs };
    while (seg as usize) != 0 {
        let next = unsafe { hir_alloc_expr(mut_view(*arena), HIR_EXPR_ERROR, (*seg).span) };
        let sk = unsafe { (*seg).kind };
        if sk == POSTFIX_FIELD {
            if unsafe { nodemap_contains(view((*rmap).module_access_nodes), seg as usize) } {
                let sym = unsafe { nodemap_get(view((*rmap).module_access_nodes), seg as usize) };
                unsafe {
                    (*next).kind = HIR_EXPR_PATH;
