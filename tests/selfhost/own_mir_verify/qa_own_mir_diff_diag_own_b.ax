pub struct AstStmt {
    pub kind: u8,
    pub span: Span,
    pub next: *mut AstStmt,
    pub pat: *mut AstPat,
    pub ty: *mut AstType,
    pub expr: *mut AstExpr,
    pub else_block: *mut AstBlock,
    pub op: u8,
    pub left: *mut AstExpr,
    pub right: *mut AstExpr,
    pub has_semi: bool,
}

pub struct AstFieldDecl {
    pub attrs: *mut AstAttr,
    pub vis: AstVis,
    pub span: Span,
    pub name: StrId,
    pub ty: *mut AstType,
    pub next: *mut AstFieldDecl,
}

pub struct AstVariantDecl {
    pub attrs: *mut AstAttr,
    pub span: Span,
    pub name: StrId,
    pub is_struct: bool,
    pub tuple_types: *mut AstType,
    pub struct_fields: *mut AstFieldDecl,
    pub next: *mut AstVariantDecl,
}

pub struct AstUseTree {
    pub span: Span,
    pub path: AstDottedName,
    pub alias: StrId,
    pub subtrees: *mut AstUseTree,
    pub next: *mut AstUseTree,
}

pub struct AstItem {
    pub kind: u8,
    pub span: Span,
    pub attrs: *mut AstAttr,
    pub vis: AstVis,
    pub next: *mut AstItem,
    pub mod_path: AstDottedName,
    pub use_tree: *mut AstUseTree,
    pub is_async: bool,
    pub is_comptime: bool,
    pub is_unsafe: bool,
    pub is_auto: bool,
    pub is_negative: bool,
    pub is_mut: bool,
    pub is_tuple: bool,
    pub abi: StrId,
    pub name: StrId,
    pub generic_params: *mut AstGenericParams,
    pub params: *mut AstParam,
    pub ret_type: *mut AstType,
    pub where_clause: *mut AstWhereClause,
    pub body: *mut AstBlock,
    pub struct_fields: *mut AstFieldDecl,
    pub tuple_types: *mut AstType,
    pub variants: *mut AstVariantDecl,
    pub supertraits: *mut AstType,
    pub trait_path: *mut AstType,
    pub self_type: *mut AstType,
    pub members: *mut AstItem,
    pub ty: *mut AstType,
    pub expr: *mut AstExpr,
}

pub struct Ast {
    pub items: *mut AstItem,
}

pub struct ParseResult {
    pub ast: Ast,
}

pub struct AstStats {
    pub item_count: usize,
    pub stmt_count: usize,
    pub expr_count: usize,
    pub type_count: usize,
    pub pat_count: usize,
}

