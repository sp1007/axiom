pub struct AstDottedName {
    pub span: Span,
    pub segments: *mut StrId,
    pub count: usize,
}

pub struct AstVis {
    pub span: Span,
    pub kind: u8,
}

pub struct AstAttrArg {
    pub span: Span,
    pub name: StrId,
    pub expr: *mut AstExpr,
    pub next: *mut AstAttrArg,
}

pub struct AstAttr {
    pub span: Span,
    pub name: StrId,
    pub args: *mut AstAttrArg,
    pub next: *mut AstAttr,
}

pub struct AstGenericParam {
    pub span: Span,
    pub name: StrId,
    pub bounds: *mut AstType,
    pub next: *mut AstGenericParam,
}

pub struct AstGenericParams {
    pub span: Span,
    pub params: *mut AstGenericParam,
}

pub struct AstGenericArg {
    pub span: Span,
    pub name: StrId,
    pub ty: *mut AstType,
    pub next: *mut AstGenericArg,
}

pub struct AstGenericArgs {
    pub span: Span,
    pub args: *mut AstGenericArg,
}

pub struct AstWherePred {
    pub span: Span,
    pub ty: *mut AstType,
    pub bounds: *mut AstType,
    pub next: *mut AstWherePred,
}

pub struct AstWhereClause {
    pub span: Span,
    pub preds: *mut AstWherePred,
}

pub struct AstTypePathSegment {
    pub span: Span,
    pub name: StrId,
    pub generic_args: *mut AstGenericArgs,
    pub next: *mut AstTypePathSegment,
}

pub struct AstType {
    pub kind: u8,
    pub span: Span,
    pub next: *mut AstType,
    pub segments: *mut AstTypePathSegment,
    pub elem_types: *mut AstType,
    pub count_expr: *mut AstExpr,
    pub elem: *mut AstType,
    pub is_mut: bool,
    pub is_unsafe: bool,
    pub abi: StrId,
    pub param_types: *mut AstType,
    pub ret_type: *mut AstType,
    pub bounds: *mut AstType,
}

pub struct AstPatField {
    pub span: Span,
    pub name: StrId,
    pub pat: *mut AstPat,
    pub next: *mut AstPatField,
}

pub struct AstPat {
    pub kind: u8,
    pub span: Span,
    pub next: *mut AstPat,
    pub is_inclusive: bool,
    pub start_pat: *mut AstPat,
    pub end_pat: *mut AstPat,
    pub tok: Token,
    pub is_negated: bool,
    pub is_mut: bool,
    pub name: StrId,
    pub segments: *mut AstTypePathSegment,
    pub payload: *mut AstPat,
    pub elems: *mut AstPat,
    pub pats: *mut AstPat,
    pub fields: *mut AstPatField,
    pub has_rest: bool,
}

pub struct AstPostfixSeg {
