            }));
            let rty_k = mb_type_kind(view(*b), (TypeId {
                v: rty.v
            }));
            let cmp_ty_v = if rty_k == TY_I8 && bits >= 128u64 {
                unsafe { (*b.thir).interner.t_i32.v }
            } else {
                rty.v
            };
            let cmp_rhs = mb_cast_int_if_needed(mut_view(*b), view(rhs), (TypeId {
                v: rty.v
            }), (TypeId {
                v: cmp_ty_v
            }), view(sp));
            let bits_op = MirOperand {
                kind: MIR_OP_CONST, location: Span {
