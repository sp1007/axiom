            *(sv.ptr + 3) == 117u8 && *(sv.ptr + 4) == 114u8 && *(sv.ptr + 5) == 101u8
        };
        if is_i128 || is_u128 {
            dst.symbol.v = if is_i128 { 0x3FFF0128u32 } else { 0x3FFF0129u32 };
