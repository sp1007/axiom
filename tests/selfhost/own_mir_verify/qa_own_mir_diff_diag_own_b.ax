        }

        let sp_id = b.suspend_point_count;
        b.suspend_point_count = b.suspend_point_count + 1u32;

        let bb_resume = mb_new_bb(mut_view(*b), false);
        let bb_drop = mb_new_bb(mut_view(*b), true);
        let drop_bb_ptr = unsafe {
            mir_bb_at((*b.body).bbs, bb_drop.v as usize)
        };
        unsafe {
            mir_term_zero(mut_view((*drop_bb_ptr).terminator), MIR_TERM_UNREACHABLE);
            (*drop_bb_ptr).terminator.span.file.v = sp.file.v;
            (*drop_bb_ptr).terminator.span.start = sp.start;
            (*drop_bb_ptr).terminator.span.end = sp.end;
            (*drop_bb_ptr).has_terminator = true;
        }

        let cur_bb_ptr = unsafe {
            mir_bb_at((*b.body).bbs, b.curr_bb.v as usize)
        };
        unsafe {
            mir_term_zero(mut_view((*cur_bb_ptr).terminator), MIR_TERM_SUSPEND);
            (*cur_bb_ptr).terminator.span.file.v = sp.file.v;
            (*cur_bb_ptr).terminator.span.start = sp.start;
            (*cur_bb_ptr).terminator.span.end = sp.end;
            (*cur_bb_ptr).terminator.drop_flag = sp_id;
            mir_copy_place(mut_view((*cur_bb_ptr).terminator.drop_place), view(fut_pl));
            mir_copy_place(mut_view((*cur_bb_ptr).terminator.destination), view(out_pl));
            (*cur_bb_ptr).terminator.call_target.v = bb_resume.v;
            (*cur_bb_ptr).terminator.call_unwind.v = bb_drop.v;
            (*cur_bb_ptr).has_terminator = true;
        }

        b.curr_bb.v = bb_resume.v;
        b.is_diverged = false;
