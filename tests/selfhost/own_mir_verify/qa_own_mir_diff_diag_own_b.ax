const TC_DIAG_MSG_OFF: [59]u32 = [
    0u32, 15u32, 46u32, 93u32, 140u32, 189u32, 263u32, 302u32, 334u32, 394u32, 422u32, 454u32, 479u32, 501u32, 547u32, 593u32,
    617u32, 642u32, 710u32, 754u32, 791u32, 830u32, 874u32, 929u32, 969u32, 1006u32, 1053u32, 1094u32, 1132u32, 1153u32, 1177u32, 1208u32,
    1241u32, 1291u32, 1329u32, 1413u32, 1496u32, 1554u32, 1620u32, 1657u32, 1681u32, 1713u32, 1736u32, 1787u32, 1821u32, 1840u32, 1858u32, 1893u32,
    1964u32, 2025u32, 2073u32, 2119u32, 2169u32, 2215u32, 2258u32, 2298u32, 2350u32, 2449u32, 2528u32,
];

fn tc_alloc_diag_msg(arena: mut_view<Arena>, idx: usize) -> StrView {
    let start = TC_DIAG_MSG_OFF[idx] as usize;
    let end = TC_DIAG_MSG_OFF[idx + 1] as usize;
    let n = end - start;
    if n == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let dst = arena_alloc_raw(arena, n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = TC_DIAG_MSG_DATA[start + i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn fix_unsatisfied_bound_msgs(sink: mut_view<DiagSink>) {
    if sink.len == 0 || (sink.diags as usize) == 0 {
        return;
    }
    let mut i: usize = 0;
    while i < sink.len {
        let dp = ((sink.diags as usize) + mul_usize(i, size_of<Diagnostic>())) as *mut Diagnostic;
        if unsafe { (*dp).code.v } == AX_TRAIT_UNSATISFIED_BOUND && unsafe { (*dp).message.len } == 28 {
            let new_msg = tc_alloc_diag_msg(mut_view(sink.arena), 40);
            unsafe {
                (*dp).message.ptr = new_msg.ptr;
                (*dp).message.len = new_msg.len;
            }
        }
        i = i + 1;
    }
}

pub fn report_typeck_diag(sink: mut_view<DiagSink>, code_v: u32, file_v: u32, start: u32, end: u32) {
    let code = (DiagCode { v: code_v });
    let sev = diag_code_severity(code);
    let msg_sv = if code_v >= 44u32 && code_v <= 99u32 {
        tc_alloc_diag_msg(mut_view(sink.arena), (code_v - 44u32) as usize)
    } else if code_v == AX_TYPE_UNKNOWN_INTRINSIC {
        tc_alloc_diag_msg(mut_view(sink.arena), 56)
    } else if code_v == AX_TYPE_INVALID_TLS_DECL {
        tc_alloc_diag_msg(mut_view(sink.arena), 57)
    } else {
        tc_alloc_sv(mut_view(sink.arena), 29)
    };
    let d = Diagnostic {
        code: code,
        severity: sev,
        message: msg_sv,
        primary: Span { file: (FileId { v: file_v }), start: start, end: end },
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    diag_sink_report(sink, view(d));
}

