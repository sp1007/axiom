                        marg1 = if mwant == 2 && (marg0 as usize) != 0 { unsafe { (*marg0).next } } else { 0 as *mut HirExpr };
                    } else {
                        marg0 = unsafe { (*expr).receiver };
                        marg1 = unsafe { (*expr).args };
                    }
                    if mb_build_intrinsic_mir_op(mut_view(*b), miref, marg0, marg1, mut_view(*dest), view(sp)) {
                        return;
                    }
                }
            }
        }
        let mut callee_op = MirOperand {
            kind: MIR_OP_COPY, location: Span {
                file: FileId {
                    v: 0u32
                }, start: 0u32, end: 0u32
            }, place: MirPlace {
                local: MirLocalId {
                    v: 0u32
                }, region: 0u8, view_kind: 0u8, projs: 0 as *mut MirProjection, proj_count: 0, drop_flag: MIR_DROP_FLAG_NONE
            }, constant: MirConst {
                ty: TypeId {
                    v: 0u32
                }, kind: MIR_CONST_INT, val: 0u64, str_bytes: 0 as *const u8, str_len: 0, sym: SymbolId {
