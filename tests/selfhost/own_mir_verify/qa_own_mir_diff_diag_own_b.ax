    if ek == HIR_EXPR_AWAIT {
        let inner: *mut HirExpr = unsafe {
            (*expr).inner
        };
        let inner_ty = mb_expr_ty(mut_view(*b), inner);
        let fut_loc = mb_new_temp(mut_view(*b), (TypeId {
            v: inner_ty.v
        }), view(sp));
        let mut fut_pl = mir_local_place(fut_loc.v);
        mir_build_expr(mut_view(*b), inner, mut_view(fut_pl), true);
        mb_consume_local(mut_view(*b), view(fut_pl));

        let out_ty = mb_expr_ty(mut_view(*b), expr);
        let mut out_pl = mir_local_place(0u32);
        if has_dest {
