    pub span: Span,
    pub next: *mut AstPostfixSeg,
    pub name: StrId,
    pub generic_args: *mut AstGenericArgs,
    pub tuple_index: u32,
    pub args: *mut AstExpr,
    pub index_arg: *mut AstExpr,
}

pub struct AstFieldInit {
    pub span: Span,
    pub name: StrId,
    pub expr: *mut AstExpr,
    pub next: *mut AstFieldInit,
}

pub struct AstMatchArm {
    pub span: Span,
    pub pat: *mut AstPat,
    pub guard: *mut AstExpr,
    pub body: *mut AstExpr,
    pub next: *mut AstMatchArm,
}

pub struct AstBlock {
    pub span: Span,
    pub stmts: *mut AstStmt,
}

pub struct AstParam {
    pub span: Span,
    pub is_mut: bool,
    pub name: StrId,
    pub ty: *mut AstType,
    pub next: *mut AstParam,
}

pub struct AstExpr {
    pub kind: u8,
    pub span: Span,
    pub next: *mut AstExpr,
    pub literal: Token,
    pub segments: *mut AstTypePathSegment,
    pub inner: *mut AstExpr,
    pub elems: *mut AstExpr,
    pub count_expr: *mut AstExpr,
    pub fields: *mut AstFieldInit,
