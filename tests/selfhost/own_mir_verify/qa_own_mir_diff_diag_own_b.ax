                arena_alloc_raw(mut_view(*b.arena), bytes, align_of<MirOperand>()) as *mut MirOperand
            };
            let mut i: usize = 0;
            while (i < f_count) {
                let dst_op = unsafe {
                    mir_op_at(ops, i)
                };
                unsafe {
                    *dst_op = MirOperand {
                        kind: MIR_OP_CONST, location: Span {
                            file: FileId {
                                v: 0u32
                            }, start: 0u32, end: 0u32
