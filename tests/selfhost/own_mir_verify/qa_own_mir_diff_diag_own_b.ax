fn hir_has_attr_thread_local(interner: view<StrInterner>, a: *mut HirAttr) -> bool {
    let mut cur: *mut HirAttr = a;
    while (cur as usize) != 0 {
        let sv = interner_get(interner, StrId { v: unsafe { (*cur).name.v } });
        if sv.len == 12 {
            let p = sv.ptr;
            let is_tl = unsafe {
                *(p + 0) == 116u8 && *(p + 1) == 104u8 && *(p + 2) == 114u8 && *(p + 3) == 101u8 &&
                *(p + 4) == 97u8 && *(p + 5) == 100u8 && *(p + 6) == 95u8 && *(p + 7) == 108u8 &&
                *(p + 8) == 111u8 && *(p + 9) == 99u8 && *(p + 10) == 97u8 && *(p + 11) == 108u8
            };
            if is_tl {
                return true;
            }
        }
        cur = unsafe { (*cur).next };
    }
    false
}

