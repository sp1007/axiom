fn sv_is_spawn_name(sv: view<StrView>) -> u8 {
    if sv.len == 5 && (sv.ptr as usize) != 0 {
        let ok = unsafe {
            *(sv.ptr + 0) == 115u8 && *(sv.ptr + 1) == 112u8 &&
            *(sv.ptr + 2) == 97u8 && *(sv.ptr + 3) == 119u8 && *(sv.ptr + 4) == 110u8
        };
        if ok { return 1u8; }
    } else if sv.len == 11 && (sv.ptr as usize) != 0 {
        let ok = unsafe {
            *(sv.ptr + 0) == 115u8 && *(sv.ptr + 1) == 112u8 &&
            *(sv.ptr + 2) == 97u8 && *(sv.ptr + 3) == 119u8 && *(sv.ptr + 4) == 110u8 &&
            *(sv.ptr + 5) == 95u8 && *(sv.ptr + 6) == 108u8 && *(sv.ptr + 7) == 111u8 &&
            *(sv.ptr + 8) == 99u8 && *(sv.ptr + 9) == 97u8 && *(sv.ptr + 10) == 108u8
        };
        if ok { return 2u8; }
    } else if sv.len == 12 && (sv.ptr as usize) != 0 {
        let ok = unsafe {
            *(sv.ptr + 0) == 115u8 && *(sv.ptr + 1) == 112u8 &&
            *(sv.ptr + 2) == 97u8 && *(sv.ptr + 3) == 119u8 && *(sv.ptr + 4) == 110u8 &&
            *(sv.ptr + 5) == 95u8 && *(sv.ptr + 6) == 115u8 && *(sv.ptr + 7) == 99u8 &&
            *(sv.ptr + 8) == 111u8 && *(sv.ptr + 9) == 112u8 && *(sv.ptr + 10) == 101u8 &&
            *(sv.ptr + 11) == 100u8
        };
        if ok { return 4u8; }
    }
    0u8
}

fn tc_receiver_is_thread_scope(cx: view<TypeckCtx>, recv: *const HirExpr) -> bool {
    if (recv as usize) == 0 || (cx.thir as usize) == 0 || (cx.str_in as usize) == 0 {
        return false;
    }
    let mut tid = unsafe { thir_get_expr_type(view(*cx.thir), recv) };
    if tid.v == 0u32 {
        return false;
    }
    let mut t = unsafe { type_get(view((*cx.thir).interner), tid) };
    while (t as usize) != 0 && (unsafe { (*t).kind == TY_VIEW || (*t).kind == TY_MUT_VIEW || (*t).kind == TY_PTR }) {
        tid = unsafe { (*t).pointee };
        t = unsafe { type_get(view((*cx.thir).interner), tid) };
    }
    if (t as usize) == 0 || unsafe { (*t).kind != TY_STRUCT } {
        return false;
    }
    let sdef = unsafe { (*t).def };
    if (sdef as usize) == 0 || unsafe { (*sdef).name.v == 0u32 } {
        return false;
    }
    let sv = unsafe { interner_get(view(*cx.str_in), (*sdef).name) };
    // "Scope" (len 5)
    sv.len == 5 && (sv.ptr as usize) != 0 && unsafe {
        *(sv.ptr + 0) == 83u8 && *(sv.ptr + 1) == 99u8 && *(sv.ptr + 2) == 111u8 &&
        *(sv.ptr + 3) == 112u8 && *(sv.ptr + 4) == 101u8
    }
}

fn classify_spawn_call(cx: view<TypeckCtx>, expr: *const HirExpr) -> u8 {
    if (expr as usize) == 0 || (cx.str_in as usize) == 0 {
        return 0u8;
    }
    let ek = unsafe { (*expr).kind };
    if ek == HIR_EXPR_CALL {
        let callee: *mut HirExpr = unsafe { (*expr).callee };
        if (callee as usize) != 0 && (unsafe { (*callee).kind }) == HIR_EXPR_PATH {
            let p_sv = unsafe { tc_path_name_sv(cx, view((*callee).path)) };
            let k = sv_is_spawn_name(view(p_sv));
            if k != 0u8 { return k; }
            let pn_v = unsafe { (*callee).path.name.v };
            if pn_v != 0u32 {
                let sv2 = unsafe { interner_get(view(*cx.str_in), (StrId { v: pn_v })) };
                let k2 = sv_is_spawn_name(view(sv2));
                if k2 != 0u8 { return k2; }
            }
        }
    } else if ek == HIR_EXPR_METHOD_CALL {
        let mn_v = unsafe { (*expr).method_name.v };
        if mn_v != 0u32 {
            let sv = unsafe { interner_get(view(*cx.str_in), (StrId { v: mn_v })) };
            let k = sv_is_spawn_name(view(sv));
            if k == 1u8 && tc_receiver_is_thread_scope(cx, unsafe { (*expr).receiver as *const HirExpr }) {
                return 4u8;
            }
            return k;
        }
    }
    0u8
}

