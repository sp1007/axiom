                        mcur = unsafe { (*mcur).next };
                    }
                    let mut marg0: *mut HirExpr = 0 as *mut HirExpr;
                    let mut marg1: *mut HirExpr = 0 as *mut HirExpr;
                    if m_explicit == mwant {
