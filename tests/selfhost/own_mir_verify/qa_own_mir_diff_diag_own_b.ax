use compiler.diag.code.AX_VERIFY_USE_AFTER_MOVE
use compiler.diag.code.AX_VERIFY_DOUBLE_DROP
use compiler.diag.code.AX_VERIFY_MISSING_DROP
use compiler.diag.code.AX_VERIFY_TYPE_MISMATCH
use compiler.diag.code.AX_VERIFY_UNKNOWN_LOCAL
use compiler.diag.code.AX_VERIFY_RETURN_TYPE
