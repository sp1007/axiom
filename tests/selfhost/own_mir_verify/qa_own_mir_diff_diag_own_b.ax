    101u8, 120u8, 112u8, 108u8, 105u8, 99u8, 105u8, 116u8, 32u8, 110u8,
    101u8, 103u8, 97u8, 116u8, 105u8, 118u8, 101u8, 32u8, 105u8, 109u8,
    112u8, 108u8, 32u8, 102u8, 111u8, 114u8, 32u8, 96u8, 0u8,
];

const NOTE_RAW_PTR: [44]u8 = [
    114u8, 97u8, 119u8, 32u8, 112u8, 111u8, 105u8, 110u8, 116u8, 101u8,
    114u8, 32u8, 96u8, 42u8, 99u8, 111u8, 110u8, 115u8, 116u8, 32u8,
    84u8, 96u8, 32u8, 47u8, 32u8, 96u8, 42u8, 109u8, 117u8, 116u8,
    32u8, 84u8, 96u8, 32u8, 105u8, 115u8, 32u8, 110u8, 111u8, 116u8,
    32u8, 96u8, 0u8, 0u8,
];

const NOTE_MUT_VIEW_SHARE: [65]u8 = [
    96u8, 109u8, 117u8, 116u8, 95u8, 118u8, 105u8, 101u8, 119u8, 60u8,
    84u8, 62u8, 96u8, 32u8, 103u8, 114u8, 97u8, 110u8, 116u8, 115u8,
    32u8, 101u8, 120u8, 99u8, 108u8, 117u8, 115u8, 105u8, 118u8, 101u8,
    32u8, 109u8, 117u8, 116u8, 97u8, 116u8, 105u8, 111u8, 110u8, 32u8,
    97u8, 110u8, 100u8, 32u8, 105u8, 115u8, 32u8, 110u8, 111u8, 116u8,
    32u8, 96u8, 83u8, 104u8, 97u8, 114u8, 101u8, 96u8, 0u8, 0u8,
    0u8, 0u8, 0u8, 0u8, 0u8,
];

const NOTE_VIEW_REQUIRES_SHARE: [42]u8 = [
    96u8, 118u8, 105u8, 101u8, 119u8, 60u8, 84u8, 62u8, 96u8, 32u8,
    114u8, 101u8, 113u8, 117u8, 105u8, 114u8, 101u8, 115u8, 32, 112u8,
    111u8, 105u8, 110u8, 116u8, 101u8, 101u8, 32u8, 116u8, 121u8, 112u8,
    101u8, 32u8, 96u8, 84u8, 58u8, 32u8, 83u8, 104u8, 97u8, 114u8,
    101u8, 96u8,
];

const NOTE_FIELD_PREFIX: [7]u8 = [
    102u8, 105u8, 101u8, 108u8, 100u8, 32u8, 96u8,
];

const NOTE_VARIANT_PREFIX: [9]u8 = [
    118u8, 97u8, 114u8, 105u8, 97u8, 110u8, 116u8, 32u8, 96u8,
];

const NOTE_CLOSURE_CAPTURE: [38]u8 = [
    99u8, 97u8, 112u8, 116u8, 117u8, 114u8, 101u8, 100u8, 32u8, 118u8,
    97u8, 108u8, 117u8, 101u8, 32u8, 105u8, 110u8, 32u8, 99u8, 108u8,
    111u8, 115u8, 117u8, 114u8, 101u8, 32u8, 105u8, 115u8, 32u8, 110u8,
    111u8, 116u8, 32u8, 96u8, 0u8, 0u8, 0u8, 0u8,
];

const NOTE_PARAM_PREFIX: [16]u8 = [
    116u8, 121u8, 112u8, 101u8, 32u8, 112u8, 97u8, 114u8, 97u8, 109u8,
    101u8, 116u8, 101u8, 114u8, 32u8, 96u8,
];

const NOTE_SUFFIX_NOT: [10]u8 = [
    96u8, 32u8, 105u8, 115u8, 32u8, 110u8, 111u8, 116u8, 32u8, 96u8,
];

fn hir_field_name_sv(
    f: *const HirFieldDecl,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>
) -> StrView {
    if (f as usize) == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let name_v = unsafe { (*f).name.v };
    if name_v != 0u32 {
        return interner_get(str_in, StrId { v: name_v });
    }
    let sp_f = unsafe { (*f).span.file.v };
    if sp_f != 0u32 {
        let sp_s = unsafe { (*f).span.start };
        let sp_e = unsafe { (*f).span.end };
        return source_db_span_text(db, Span { file: FileId { v: sp_f }, start: sp_s, end: sp_e });
    }
    StrView { ptr: 0 as *const u8, len: 0 }
}

fn hir_variant_name_sv(
    v: *const HirVariantDecl,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>
) -> StrView {
    if (v as usize) == 0 {
        return StrView { ptr: 0 as *const u8, len: 0 };
    }
    let name_v = unsafe { (*v).name.v };
    if name_v != 0u32 {
        return interner_get(str_in, StrId { v: name_v });
    }
    let sp_f = unsafe { (*v).span.file.v };
    if sp_f != 0u32 {
        let sp_s = unsafe { (*v).span.start };
        let sp_e = unsafe { (*v).span.end };
        return source_db_span_text(db, Span { file: FileId { v: sp_f }, start: sp_s, end: sp_e });
    }
    StrView { ptr: 0 as *const u8, len: 0 }
}

fn find_auto_trait_failure_reason(
    hir: view<HirFile>,
    thir: view<Thir>,
    ty_id: TypeId,
    auto_kind: u8,
    tr_sym_v: u32,
    tr_name: view<StrView>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    out_name: mut_view<StrView>,
    depth: usize
) -> u8 {
    let ty_v: u32 = ty_id.v;
    if depth > 16 {
        return 0u8;
    }
    let t = type_get(view(thir.interner), (TypeId { v: ty_v }));
    if (t as usize) == 0 {
        return 0u8;
    }
    let tk = unsafe { (*t).kind };
    let mut it: *mut HirItem = hir.items;
    while (it as usize) != 0 {
        let ik = unsafe { (*it).kind };
        let tp = unsafe { (*it).trait_path };
        if ik == HIR_ITEM_IMPL && (tp as usize) != 0 && unsafe { (*it).is_negative } {
            if impl_trait_matches_target(tp, auto_kind, tr_sym_v, tr_name, str_in, db) {
                if type_matches_impl_self_exact(thir, str_in, it, (TypeId { v: ty_v })) &&
                   impl_bounds_satisfied(hir, thir, it, (TypeId { v: ty_v }), str_in, db, depth + 1) {
                    if (tk == TY_STRUCT || tk == TY_ENUM) && (unsafe { (*t).def as usize }) != 0 {
                        *out_name = hir_item_name_sv(unsafe { (*t).def }, str_in, db);
                    }
                    return 1u8;
                }
            }
        }
        it = unsafe { (*it).next };
    }
    if tk == TY_PTR {
        return 2u8;
    }
    if tk == TY_MUT_VIEW {
        if auto_kind == 2u8 {
            return 3u8;
        }
        return find_auto_trait_failure_reason(hir, thir, unsafe { (*t).pointee }, 1u8, 10007u32, tr_name, str_in, db, out_name, depth + 1);
    }
    if tk == TY_VIEW {
        return 4u8;
    }
    if tk == TY_PARAM {
        let pid_v = unsafe { (*t).name.v };
        if pid_v != 0u32 {
            *out_name = interner_get(str_in, (StrId { v: pid_v }));
        }
        return 8u8;
    }
    if tk == TY_STRUCT {
        let fc = unsafe { (*t).field_count };
        let flds = unsafe { (*t).fields };
        let sdef = unsafe { (*t).def };
        let mut fdecl: *mut HirFieldDecl = if (sdef as usize) != 0 { unsafe { (*sdef).struct_fields } } else { 0 as *mut HirFieldDecl };
        let mut i: usize = 0;
        while i < fc {
            let ft = unsafe { *typeid_at(flds, i) };
            if !type_satisfies_auto_trait(hir, thir, ft, auto_kind, tr_sym_v, tr_name, str_in, db, depth + 1) {
                if (fdecl as usize) != 0 {
                    *out_name = hir_field_name_sv(fdecl, str_in, db);
                } else if (sdef as usize) != 0 {
                    *out_name = hir_item_name_sv(sdef, str_in, db);
                }
                return 5u8;
            }
            if (fdecl as usize) != 0 {
                fdecl = unsafe { (*fdecl).next };
            }
            i = i + 1;
        }
        if (sdef as usize) != 0 {
            *out_name = hir_item_name_sv(sdef, str_in, db);
        }
        return 1u8;
    }
    if tk == TY_ENUM {
        let vc = unsafe { (*t).variant_count };
        let vf_arr = unsafe { (*t).variant_fields };
        let vfc_arr = unsafe { (*t).variant_field_counts };
        let edef = unsafe { (*t).def };
        let mut vdecl: *mut HirVariantDecl = if (edef as usize) != 0 { unsafe { (*edef).variants } } else { 0 as *mut HirVariantDecl };
        if (vf_arr as usize) != 0 && (vfc_arr as usize) != 0 {
            let mut v: usize = 0;
            while v < vc {
                let fc = unsafe { *usize_at(vfc_arr, v) };
                let row = unsafe { *typeid_ptr_at(vf_arr, v) };
                if (row as usize) != 0 {
                    let mut f: usize = 0;
                    while f < fc {
                        let ft = unsafe { *typeid_at(row, f) };
                        if !type_satisfies_auto_trait(hir, thir, ft, auto_kind, tr_sym_v, tr_name, str_in, db, depth + 1) {
                            if (vdecl as usize) != 0 {
                                *out_name = hir_variant_name_sv(vdecl, str_in, db);
                            }
                            return 6u8;
                        }
                        f = f + 1;
                    }
                }
                if (vdecl as usize) != 0 {
                    vdecl = unsafe { (*vdecl).next };
                }
                v = v + 1;
            }
        }
        return 6u8;
    }
    if tk == TY_CLOSURE {
        return 7u8;
    }
    if tk == TY_COROUTINE {
        if auto_kind == 2u8 {
            return 3u8;
        }
        let ret_r = find_auto_trait_failure_reason(hir, thir, unsafe { (*t).ret_type }, auto_kind, tr_sym_v, tr_name, str_in, db, mut_view(*out_name), depth + 1);
        if ret_r != 0u8 {
            return ret_r;
        }
        let ac = unsafe { (*t).arg_count };
        let aptr = unsafe { (*t).args };
        let mut i: usize = 0;
        while i < ac {
            let at = unsafe { *typeid_at(aptr, i) };
            let r = find_auto_trait_failure_reason(hir, thir, at, auto_kind, tr_sym_v, tr_name, str_in, db, mut_view(*out_name), depth + 1);
            if r != 0u8 {
                return r;
            }
            i = i + 1;
        }
        return 0u8;
    }
    if tk == TY_ARRAY || tk == TY_SLICE {
        return find_auto_trait_failure_reason(hir, thir, unsafe { (*t).elem }, auto_kind, tr_sym_v, tr_name, str_in, db, out_name, depth + 1);
    }
    if tk == TY_TUPLE {
        let fc = unsafe { (*t).field_count };
        let flds = unsafe { (*t).fields };
        let mut i: usize = 0;
        while i < fc {
            let ft_v = unsafe { (*typeid_at(flds, i)).v };
            if !type_satisfies_auto_trait(hir, thir, (TypeId { v: ft_v }), auto_kind, tr_sym_v, tr_name, str_in, db, depth + 1) {
                return find_auto_trait_failure_reason(hir, thir, (TypeId { v: ft_v }), auto_kind, tr_sym_v, tr_name, str_in, db, out_name, depth + 1);
            }
            i = i + 1;
        }
    }
    0u8
}

fn append_bytes_to_buf(dst: *mut u8, pos: usize, src: *const u8, len: usize) -> usize {
    let mut i: usize = 0;
    while i < len {
        unsafe {
            *(dst + pos + i) = *(src + i);
        }
        i = i + 1;
    }
    pos + len
}

fn append_trait_tag(dst: *mut u8, pos: usize, auto_kind: u8) -> usize {
    let mut p = pos;
    if auto_kind == 1u8 {
        unsafe {
            *(dst + p + 0) = 83u8;
            *(dst + p + 1) = 101u8;
            *(dst + p + 2) = 110u8;
            *(dst + p + 3) = 100u8;
            *(dst + p + 4) = 96u8;
        }
        p = p + 5;
    } else {
        unsafe {
            *(dst + p + 0) = 83u8;
            *(dst + p + 1) = 104u8;
            *(dst + p + 2) = 97u8;
            *(dst + p + 3) = 114u8;
            *(dst + p + 4) = 101u8;
            *(dst + p + 5) = 96u8;
        }
        p = p + 6;
    }
    p
}

fn build_conc_failure_note(
    arena: mut_view<Arena>,
    reason: u8,
    auto_kind: u8,
    name_sv: view<StrView>
) -> StrView {
    let buf = arena_alloc_raw(arena, 128, 1);
    let mut pos: usize = 0;
    let nlen: usize = if name_sv.len > 48 { 48 } else { name_sv.len };
    if reason == 3u8 {
        let mut i: usize = 0;
        while i < 58 {
            unsafe { *(buf + i) = NOTE_MUT_VIEW_SHARE[i]; }
            i = i + 1;
        }
        pos = 58;
    } else if reason == 4u8 {
        let mut i: usize = 0;
        while i < 42 {
            unsafe { *(buf + i) = NOTE_VIEW_REQUIRES_SHARE[i]; }
            i = i + 1;
        }
        pos = 42;
    } else if reason == 1u8 && nlen > 0 && (name_sv.ptr as usize) != 0 {
        let mut i: usize = 0;
        while i < 28 {
            unsafe { *(buf + i) = NOTE_NEG_IMPL[i]; }
            i = i + 1;
        }
        pos = append_bytes_to_buf(buf, 28, name_sv.ptr, nlen);
        let mut j: usize = 0;
        while j < 10 {
            unsafe { *(buf + pos + j) = NOTE_SUFFIX_NOT[j]; }
            j = j + 1;
        }
        pos = append_trait_tag(buf, pos + 10, auto_kind);
    } else if (reason == 5u8 || reason == 6u8 || reason == 8u8) && nlen > 0 && (name_sv.ptr as usize) != 0 {
        if reason == 5u8 {
            let mut i: usize = 0;
            while i < 7 {
                unsafe { *(buf + i) = NOTE_FIELD_PREFIX[i]; }
                i = i + 1;
            }
            pos = 7;
        } else if reason == 6u8 {
            let mut i: usize = 0;
            while i < 9 {
                unsafe { *(buf + i) = NOTE_VARIANT_PREFIX[i]; }
                i = i + 1;
            }
            pos = 9;
        } else {
            let mut i: usize = 0;
            while i < 16 {
                unsafe { *(buf + i) = NOTE_PARAM_PREFIX[i]; }
                i = i + 1;
            }
            pos = 16;
        }
        pos = append_bytes_to_buf(buf, pos, name_sv.ptr, nlen);
        let mut j: usize = 0;
        while j < 10 {
            unsafe { *(buf + pos + j) = NOTE_SUFFIX_NOT[j]; }
            j = j + 1;
        }
        pos = append_trait_tag(buf, pos + 10, auto_kind);
    } else if reason == 7u8 {
        let mut i: usize = 0;
        while i < 34 {
            unsafe { *(buf + i) = NOTE_CLOSURE_CAPTURE[i]; }
            i = i + 1;
        }
        pos = append_trait_tag(buf, 34, auto_kind);
    } else {
        let mut i: usize = 0;
        while i < 42 {
            unsafe { *(buf + i) = NOTE_RAW_PTR[i]; }
            i = i + 1;
        }
        pos = append_trait_tag(buf, 42, auto_kind);
    }
    unsafe { *(buf + pos) = 0u8; }
    StrView { ptr: buf as *const u8, len: pos }
}

pub fn emit_conc_bound_diag(
    hir: view<HirFile>,
    thir: view<Thir>,
    arg_ty: TypeId,
    auto_kind: u8,
    tr_sym_v: u32,
    tr_name: view<StrView>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    sink: mut_view<DiagSink>,
    sp: Span
) {
    let t_arg = type_get(view(thir.interner), TypeId { v: arg_ty.v });
    let is_coro = (t_arg as usize) != 0 && (unsafe { (*t_arg).kind }) == TY_COROUTINE;
    let code_v = if is_coro && auto_kind == 1u8 {
        AX_ASYNC_FUTURE_NOT_SEND
    } else if auto_kind == 1u8 {
        AX_CONC_NOT_SEND
    } else {
        AX_CONC_NOT_SHARE
    };
    let msg_len: usize = if is_coro && auto_kind == 1u8 {
        65
    } else if auto_kind == 1u8 {
        68
    } else {
        65
    };
    let buf = arena_alloc_raw(mut_view(sink.arena), msg_len + 1, 1);
    let mut i: usize = 0;
    while i < msg_len {
        unsafe {
            *(buf + i) = if is_coro && auto_kind == 1u8 {
                MSG_FUTURE_NOT_SEND[i]
            } else if auto_kind == 1u8 {
                MSG_NOT_SEND[i]
            } else {
                MSG_NOT_SHARE[i]
            };
        }
        i = i + 1;
    }
    unsafe { *(buf + msg_len) = 0u8; }

    let mut reason_name = StrView { ptr: 0 as *const u8, len: 0 };
    let reason = find_auto_trait_failure_reason(
        hir,
        thir,
        arg_ty,
        auto_kind,
        tr_sym_v,
        tr_name,
        str_in,
        db,
        mut_view(reason_name),
        0
    );
    let note_sv = build_conc_failure_note(mut_view(sink.arena), reason, auto_kind, view(reason_name));
    let notes_ptr = arena_alloc_raw(mut_view(sink.arena), 16, 8) as *mut StrView;
    unsafe {
        (*notes_ptr).ptr = note_sv.ptr;
        (*notes_ptr).len = note_sv.len;
    }

    let sev = diag_code_severity(DiagCode { v: code_v });
    let mut d = Diagnostic {
        code: DiagCode { v: code_v },
        severity: sev,
        message: StrView { ptr: buf as *const u8, len: msg_len },
        primary: Span { file: FileId { v: sp.file.v }, start: sp.start, end: sp.end },
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: notes_ptr,
        note_count: 1,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    diag_sink_report(mut_view(*sink), view(d));
}

pub fn emit_safe_send_share_impl_diag(sink: mut_view<DiagSink>, sp: Span) {
    let buf = arena_alloc_raw(mut_view(sink.arena), 66, 1);
    let mut i: usize = 0;
    while i < 65 {
        unsafe { *(buf + i) = MSG_SAFE_SEND_SHARE_IMPL[i]; }
        i = i + 1;
    }
    unsafe { *(buf + 65) = 0u8; }
    let sev = diag_code_severity(DiagCode { v: AX_CONC_SAFE_SEND_SHARE_IMPL });
    let d = Diagnostic {
        code: DiagCode { v: AX_CONC_SAFE_SEND_SHARE_IMPL },
        severity: sev,
        message: StrView { ptr: buf as *const u8, len: 65 },
        primary: Span { file: FileId { v: sp.file.v }, start: sp.start, end: sp.end },
        labels: 0 as *mut DiagLabel,
        label_count: 0,
        notes: 0 as *mut StrView,
        note_count: 0,
        helps: 0 as *mut StrView,
        help_count: 0,
        fixes: 0 as *mut DiagFix,
        fix_count: 0,
        data: 0 as *mut DiagDataEntry,
        data_count: 0,
    };
    diag_sink_report(mut_view(*sink), view(d));
}

pub fn check_send_share_impl_safety(
    hir: view<HirFile>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    sink: mut_view<DiagSink>
) -> bool {
    let mut all_ok: bool = true;
    let mut it: *mut HirItem = hir.items;
    while (it as usize) != 0 {
        let ik = unsafe { (*it).kind };
        let tp = unsafe { (*it).trait_path };
        if ik == HIR_ITEM_IMPL && (tp as usize) != 0 && unsafe { (*tp).kind } == HIR_TYPE_PATH {
            if !unsafe { (*it).is_negative } && !unsafe { (*it).is_unsafe } {
                let tr_sym_v = unsafe { (*tp).path.symbol.v };
                let tr_name = hir_type_path_name_sv(tp, str_in, db);
                let ak = trait_auto_kind(hir, tr_sym_v, view(tr_name), str_in, db);
                let tr_it = find_trait_item(hir, SymbolId { v: tr_sym_v }, view(tr_name), str_in, db);
                let is_unsafe_tr = (tr_it as usize) != 0 && unsafe { (*tr_it).is_unsafe };
                if ak == 1u8 || ak == 2u8 || is_unsafe_tr {
                    let sp_f = unsafe { (*it).span.file.v };
                    let sp_s = unsafe { (*it).span.start };
                    let sp_e = unsafe { (*it).span.end };
                    emit_safe_send_share_impl_diag(
                        mut_view(*sink),
                        Span { file: FileId { v: sp_f }, start: sp_s, end: sp_e }
                    );
                    all_ok = false;
                }
            }
        }
        it = unsafe { (*it).next };
    }
    all_ok
}

fn report_unsatisfied_bound_or_conc(
    hir: view<HirFile>,
    thir: view<Thir>,
    arg_ty: TypeId,
    bound: *const HirType,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    sink: mut_view<DiagSink>,
    sp: Span
) {
    if (bound as usize) != 0 && unsafe { (*bound).kind } == HIR_TYPE_PATH {
        let tr_sym_v = unsafe { (*bound).path.symbol.v };
        let tr_name = hir_type_path_name_sv(bound, str_in, db);
        let ak = trait_auto_kind(hir, tr_sym_v, view(tr_name), str_in, db);
        if ak == 1u8 || ak == 2u8 {
            emit_conc_bound_diag(hir, thir, arg_ty, ak, tr_sym_v, view(tr_name), str_in, db, sink, sp);
            return;
        }
    }
    emit_trait_unsatisfied_bound_diag(sink, sp);
}

pub fn check_item_bounds(
    hir: view<HirFile>,
    thir: view<Thir>,
    callee_it: *const HirItem,
    args: view<GenericArgsSlice>,
    call_span: Span,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    sink: mut_view<DiagSink>
) -> bool {
    let sp_file_v = call_span.file.v;
    let sp_start = call_span.start;
    let sp_end = call_span.end;
    let arg_cnt: usize = args.count;
    let arg_ptr: *mut TypeId = args.args;
    if (callee_it as usize) == 0 || arg_cnt == 0 || (arg_ptr as usize) == 0 {
        return true;
    }
    let gps = unsafe { (*callee_it).generic_params };
    if (gps as usize) == 0 {
        return true;
    }
    let mut all_ok: bool = true;
    let mut gp: *mut HirGenericParam = unsafe { (*gps).params };
    let mut p_idx: usize = 0;
    while ((gp as usize) != 0 && p_idx < arg_cnt) {
        let arg_ty_v = unsafe { (*typeid_at(arg_ptr, p_idx)).v };
        let mut b: *mut HirType = unsafe { (*gp).bounds };
        while ((b as usize) != 0) {
            if !satisfies_bound(hir, thir, (TypeId { v: arg_ty_v }), b, str_in, db) {
                let sp = Span { file: FileId { v: sp_file_v }, start: sp_start, end: sp_end };
                report_unsatisfied_bound_or_conc(hir, thir, (TypeId { v: arg_ty_v }), b, str_in, db, mut_view(*sink), sp);
                all_ok = false;
            }
            b = unsafe { (*b).next };
        }
        gp = unsafe { (*gp).next };
        p_idx = p_idx + 1;
    }

    let wc = unsafe { (*callee_it).where_clause };
    if (wc as usize) != 0 {
        let mut wp: *mut HirWherePred = unsafe { (*wc).preds };
        while ((wp as usize) != 0) {
            let wty: *mut HirType = unsafe { (*wp).ty };
            if (wty as usize) != 0 && unsafe { (*wty).kind } == HIR_TYPE_PATH {
                let wp_name = hir_type_path_name_sv(wty, str_in, db);
                let mut gp2: *mut HirGenericParam = unsafe { (*gps).params };
                let mut idx2: usize = 0;
                while ((gp2 as usize) != 0 && idx2 < arg_cnt) {
                    let gp_name = hir_generic_param_name_sv(gp2, str_in, db);
                    if sv_eq(view(wp_name), view(gp_name)) {
                        let arg_ty2_v = unsafe { (*typeid_at(arg_ptr, idx2)).v };
                        let mut wb: *mut HirType = unsafe { (*wp).bounds };
                        while ((wb as usize) != 0) {
                            if !satisfies_bound(hir, thir, (TypeId { v: arg_ty2_v }), wb, str_in, db) {
                                let sp2 = Span {
                                    file: FileId { v: sp_file_v },
                                    start: sp_start,
                                    end: sp_end
                                };
                                report_unsatisfied_bound_or_conc(hir, thir, (TypeId { v: arg_ty2_v }), wb, str_in, db, mut_view(*sink), sp2);
                                all_ok = false;
                            }
                            wb = unsafe { (*wb).next };
                        }
                        break;
                    }
                    gp2 = unsafe { (*gp2).next };
                    idx2 = idx2 + 1;
                }
            }
            wp = unsafe { (*wp).next };
        }
    }
    all_ok
}

pub fn check_impl_supertraits(
    hir: view<HirFile>,
    thir: view<Thir>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    sink: mut_view<DiagSink>
) -> bool {
    let mut all_ok: bool = true;
    let mut it: *mut HirItem = hir.items;
    while ((it as usize) != 0) {
        let ik = unsafe { (*it).kind };
        let tp = unsafe { (*it).trait_path };
        if ik == HIR_ITEM_IMPL && (tp as usize) != 0 && !unsafe { (*it).is_negative } {
            let tr_it = find_trait_by_type_path(hir, tp, str_in, db);
            let self_ty_ptr = thir_get_item_type(thir, it);
            if (tr_it as usize) != 0 && (self_ty_ptr as usize) != 0 {
                let self_ty_v = unsafe { (*self_ty_ptr).v };
                let mut st: *mut HirType = unsafe { (*tr_it).supertraits };
                while ((st as usize) != 0) {
                    if !satisfies_bound(hir, thir, (TypeId { v: self_ty_v }), st, str_in, db) {
                        let sp_f = unsafe { (*it).span.file.v };
                        let sp_s = unsafe { (*it).span.start };
                        let sp_e = unsafe { (*it).span.end };
                        report_unsatisfied_bound_or_conc(
                            hir,
                            thir,
                            (TypeId { v: self_ty_v }),
                            st,
                            str_in,
                            db,
                            mut_view(*sink),
                            Span { file: FileId { v: sp_f }, start: sp_s, end: sp_e }
                        );
                        all_ok = false;
                    }
                    st = unsafe { (*st).next };
                }
            }
        }
        it = unsafe { (*it).next };
    }
    all_ok
}

// Generic type substitution, type argument deduction, symbol name mangling,
// and monomorphization worklist/instance cache engine.
// Port of bootstrap/axiom0/src/driver/mono.{h,c} and ax_subst_ty in typeck.c.
module compiler.traits.mono

use compiler.kernel.arena.Arena
use compiler.kernel.arena.arena_alloc_raw
use compiler.kernel.id.StrId
use compiler.kernel.id.SymbolId
use compiler.kernel.id.TypeId
use compiler.kernel.interner.StrInterner
use compiler.kernel.interner.StrView
use compiler.kernel.interner.interner_get
use compiler.kernel.interner.interner_intern_bytes
use compiler.source.manager.SourceDatabase
use compiler.hir.hir.HIR_ITEM_FN
use compiler.hir.hir.HIR_ITEM_IMPL
use compiler.hir.hir.HIR_ITEM_TRAIT
use compiler.hir.hir.HIR_TYPE_PATH
use compiler.hir.hir.HirFile
use compiler.hir.hir.HirGenericParams
use compiler.hir.hir.HirItem
use compiler.types.types.AxType
use compiler.types.types.ClosureCapture
use compiler.types.types.GenericArgsSlice
use compiler.types.types.TY_ARRAY
use compiler.types.types.TY_CLOSURE
use compiler.types.types.TY_ENUM
use compiler.types.types.TY_ERROR
use compiler.types.types.TY_FN
use compiler.types.types.TY_INT_VAR
use compiler.types.types.TY_MUT_VIEW
use compiler.types.types.TY_PARAM
use compiler.types.types.TY_PTR
use compiler.types.types.TY_SLICE
use compiler.types.types.TY_STRUCT
use compiler.types.types.TY_TUPLE
use compiler.types.types.TY_VAR
use compiler.types.types.TY_VIEW
use compiler.types.types.TypeInterner
use compiler.types.types.capture_at
use compiler.types.types.copy_ax_type_into
use compiler.types.types.intern_array_ty
use compiler.types.types.intern_fn_ty
use compiler.types.types.intern_ptr_ty
use compiler.types.types.intern_slice_ty
use compiler.types.types.intern_tuple_ty
use compiler.types.types.intern_type
use compiler.types.types.intern_view_ty
use compiler.types.types.type_get
use compiler.types.types.typeid_at
use compiler.types.types.typeid_ptr_at
use compiler.types.types.usize_at
use compiler.traits.solver.find_trait_by_type_path
use compiler.traits.solver.find_trait_default_method
use compiler.traits.solver.hir_item_name_sv
use compiler.traits.solver.impl_matches_receiver
use compiler.traits.solver.sv_eq

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub const MONO_FIRST_SYM_ID: u32 = 0x08000000u32;

pub struct MonoInstance {
    pub orig_item: *mut HirItem,
    pub new_item: *mut HirItem,
    pub args: GenericArgsSlice,
    pub mangled_sym: SymbolId,
    pub mangled_name: StrId,
    pub mir_body: usize,
    pub next: *mut MonoInstance,
    pub work_next: *mut MonoInstance,
    pub in_worklist: bool,
}

pub struct MonoEngine {
    pub arena: *mut Arena,
    pub instances_head: *mut MonoInstance,
    pub instances_tail: *mut MonoInstance,
    pub instance_count: usize,
    pub work_head: *mut MonoInstance,
    pub work_tail: *mut MonoInstance,
    pub next_counter: u32,
    pub next_sym_id: u32,
}

pub fn generic_args_eq(a: view<GenericArgsSlice>, b: view<GenericArgsSlice>) -> bool {
    let a_cnt: usize = a.count;
    let b_cnt: usize = b.count;
    if a_cnt != b_cnt {
        return false;
    }
    if a_cnt == 0 {
        return true;
    }
    let a_ptr: *mut TypeId = a.args;
    let b_ptr: *mut TypeId = b.args;
    if (a_ptr as usize) == 0 || (b_ptr as usize) == 0 {
        return (a_ptr as usize) == (b_ptr as usize);
    }
    let mut i: usize = 0;
    while (i < a_cnt) {
        let av = unsafe { (*typeid_at(a_ptr, i)).v };
        let bv = unsafe { (*typeid_at(b_ptr, i)).v };
        if av != bv {
            return false;
        }
        i = i + 1;
    }
    true
}

pub fn type_contains_param(ti: view<TypeInterner>, ty: TypeId) -> bool {
    if ty.v == 0u32 {
        return true;
    }
    let t = type_get(ti, ty);
    if (t as usize) == 0 {
        return true;
    }
    let tk = unsafe { (*t).kind };
    if tk == TY_PARAM || tk == TY_VAR || tk == TY_INT_VAR || tk == TY_ERROR {
        return true;
    }
    if tk == TY_VIEW || tk == TY_MUT_VIEW || tk == TY_PTR {
        let pt_v = unsafe { (*t).pointee.v };
        return type_contains_param(ti, TypeId { v: pt_v });
    }
    if tk == TY_ARRAY || tk == TY_SLICE {
        let el_v = unsafe { (*t).elem.v };
        return type_contains_param(ti, TypeId { v: el_v });
    }
    if tk == TY_TUPLE {
        let fcount = unsafe { (*t).field_count };
        let fields = unsafe { (*t).fields };
        let mut i: usize = 0;
        while (i < fcount) {
            let fv = unsafe { (*typeid_at(fields, i)).v };
            if type_contains_param(ti, (TypeId { v: fv })) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
    if tk == TY_FN {
        let pcount = unsafe { (*t).param_count };
        let params = unsafe { (*t).param_types };
        let mut i: usize = 0;
        while (i < pcount) {
            let pv = unsafe { (*typeid_at(params, i)).v };
            if type_contains_param(ti, (TypeId { v: pv })) {
                return true;
            }
            i = i + 1;
        }
        let rv = unsafe { (*t).ret_type.v };
        return type_contains_param(ti, (TypeId { v: rv }));
    }
    if tk == TY_STRUCT || tk == TY_ENUM {
        let acount = unsafe { (*t).arg_count };
        let args = unsafe { (*t).args };
        let mut i: usize = 0;
        while (i < acount) {
            let av = unsafe { (*typeid_at(args, i)).v };
            if type_contains_param(ti, (TypeId { v: av })) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
    false
}

pub fn mono_has_concrete_args(args: view<GenericArgsSlice>, ti: view<TypeInterner>) -> bool {
    let a_cnt: usize = args.count;
    let a_ptr: *mut TypeId = args.args;
    if a_cnt == 0 || (a_ptr as usize) == 0 {
        return false;
    }
    let mut i: usize = 0;
    while (i < a_cnt) {
        let av = unsafe { (*typeid_at(a_ptr, i)).v };
        if av == 0u32 || type_contains_param(ti, (TypeId { v: av })) {
            return false;
        }
        i = i + 1;
    }
    true
}

pub fn subst_ty(
    ti: mut_view<TypeInterner>,
    ty: TypeId,
    args: view<GenericArgsSlice>
) -> TypeId {
    subst_ty_self(mut_view(*ti), ty, args, 0u32)
}

// T161: the trait `Self` parameter (types/typeck.ax TC_SELF_PARAM_INDEX, axiom0 TC_SELF_PARAM_INDEX).
pub const MONO_SELF_PARAM_INDEX: u32 = 0xFFFFFF00u32;

// Substitutes the generic arguments `args` and, when self_v != 0, the trait `Self` parameter by the type
// `self_v` (T161: the instance of a trait default method for one implementing type; axiom0 mono.c
// subst_ty_self).
pub fn subst_ty_self(
    ti: mut_view<TypeInterner>,
    ty: TypeId,
    args: view<GenericArgsSlice>,
    self_v: u32
) -> TypeId {
    let ty_v = ty.v;
    let a_cnt: usize = args.count;
    let a_ptr: *mut TypeId = args.args;
    if ty_v == 0u32 || ((a_cnt == 0 || (a_ptr as usize) == 0) && self_v == 0u32) {
        return TypeId { v: ty_v };
    }
    let t = type_get(view(*ti), TypeId { v: ty_v });
    if (t as usize) == 0 {
        return TypeId { v: ty_v };
    }
    let tk = unsafe { (*t).kind };

    if tk == TY_PARAM {
        if self_v != 0u32 && (unsafe { (*t).param_index }) == MONO_SELF_PARAM_INDEX {
            return TypeId { v: self_v };
        }
        if (a_ptr as usize) == 0 {
            return TypeId { v: ty_v };
        }
        let idx = unsafe { (*t).param_index as usize };
        if idx < a_cnt {
            let rep_v = unsafe { (*typeid_at(a_ptr, idx)).v };
            if rep_v != 0u32 {
                return TypeId { v: rep_v };
            }
        }
        return TypeId { v: ty_v };
    }

    if tk == TY_ARRAY {
        let elem_v = unsafe { (*t).elem.v };
        let arr_len = unsafe { (*t).array_len };
        let new_elem = subst_ty_self(mut_view(*ti), TypeId { v: elem_v }, args, self_v);
        if new_elem.v == elem_v {
            return TypeId { v: ty_v };
        }
        return intern_array_ty(mut_view(*ti), new_elem, arr_len);
    }

    if tk == TY_SLICE {
        let elem_v = unsafe { (*t).elem.v };
        let new_elem = subst_ty_self(mut_view(*ti), TypeId { v: elem_v }, args, self_v);
        if new_elem.v == elem_v {
            return TypeId { v: ty_v };
        }
        return intern_slice_ty(mut_view(*ti), new_elem);
    }

    if tk == TY_VIEW {
        let pt_v = unsafe { (*t).pointee.v };
        let new_pt = subst_ty_self(mut_view(*ti), TypeId { v: pt_v }, args, self_v);
        if new_pt.v == pt_v {
            return TypeId { v: ty_v };
        }
        return intern_view_ty(mut_view(*ti), new_pt, false);
    }

    if tk == TY_MUT_VIEW {
        let pt_v = unsafe { (*t).pointee.v };
        let new_pt = subst_ty_self(mut_view(*ti), TypeId { v: pt_v }, args, self_v);
        if new_pt.v == pt_v {
            return TypeId { v: ty_v };
        }
        return intern_view_ty(mut_view(*ti), new_pt, true);
    }

    if tk == TY_PTR {
        let pt_v = unsafe { (*t).pointee.v };
        let is_mut = unsafe { (*t).is_mut };
        let new_pt = subst_ty_self(mut_view(*ti), TypeId { v: pt_v }, args, self_v);
        if new_pt.v == pt_v {
            return TypeId { v: ty_v };
        }
        return intern_ptr_ty(mut_view(*ti), new_pt, is_mut);
    }

    if tk == TY_TUPLE {
        let fcount = unsafe { (*t).field_count };
        if fcount == 0 {
            return TypeId { v: ty_v };
        }
        let orig_fields = unsafe { (*t).fields };
        let new_fields = arena_alloc_raw(
            mut_view(ti.arena),
            (((fcount as isize) * (size_of<TypeId>() as isize)) as usize),
            align_of<TypeId>()
        ) as *mut TypeId;
        let mut changed: bool = false;
        let mut i: usize = 0;
        while (i < fcount) {
            let orig_fv = unsafe { (*typeid_at(orig_fields, i)).v };
            let sub_f = subst_ty_self(mut_view(*ti), TypeId { v: orig_fv }, args, self_v);
            if sub_f.v != orig_fv {
                changed = true;
            }
            unsafe {
                (*typeid_at(new_fields, i)).v = sub_f.v;
            }
            i = i + 1;
        }
        if !changed {
            return TypeId { v: ty_v };
        }
        return intern_tuple_ty(mut_view(*ti), new_fields, fcount);
    }

    if tk == TY_FN {
        let pcount = unsafe { (*t).param_count };
        let orig_params = unsafe { (*t).param_types };
        let orig_ret_v = unsafe { (*t).ret_type.v };
        let is_unsafe = unsafe { (*t).is_unsafe };
        let abi_v = unsafe { (*t).abi.v };
        let mut new_params: *mut TypeId = 0 as *mut TypeId;
        let mut changed: bool = false;
        if pcount > 0 {
            new_params = arena_alloc_raw(
                mut_view(ti.arena),
                (((pcount as isize) * (size_of<TypeId>() as isize)) as usize),
                align_of<TypeId>()
            ) as *mut TypeId;
            let mut i: usize = 0;
            while (i < pcount) {
                let orig_pv = unsafe { (*typeid_at(orig_params, i)).v };
                let sub_p = subst_ty_self(mut_view(*ti), TypeId { v: orig_pv }, args, self_v);
                if sub_p.v != orig_pv {
                    changed = true;
                }
                unsafe {
                    (*typeid_at(new_params, i)).v = sub_p.v;
                }
                i = i + 1;
            }
        }
        let new_ret = subst_ty_self(mut_view(*ti), TypeId { v: orig_ret_v }, args, self_v);
        if new_ret.v != orig_ret_v {
            changed = true;
        }
        if !changed {
            return TypeId { v: ty_v };
        }
        return intern_fn_ty(
            mut_view(*ti),
            is_unsafe,
            StrId { v: abi_v },
            new_params,
            pcount,
            new_ret
        );
    }

    if tk == TY_STRUCT || tk == TY_ENUM || tk == TY_CLOSURE {
        return subst_ty_adt(mut_view(*ti), ty_v, t, tk, args, self_v);
    }
    TypeId { v: ty_v }
}

fn subst_ty_adt(
    ti: mut_view<TypeInterner>,
    ty_v: u32,
    t: *mut AxType,
    tk: u8,
    args: view<GenericArgsSlice>,
    self_v: u32
) -> TypeId {
    if tk == TY_STRUCT {
        let gcount = unsafe { (*t).arg_count };
        let orig_gargs = unsafe { (*t).args };
        let fcount = unsafe { (*t).field_count };
        let orig_fields = unsafe { (*t).fields };
        let mut changed: bool = false;
        let mut new_gargs: *mut TypeId = orig_gargs;
        if gcount > 0 && (orig_gargs as usize) != 0 {
            new_gargs = arena_alloc_raw(
                mut_view(ti.arena),
                (((gcount as isize) * (size_of<TypeId>() as isize)) as usize),
                align_of<TypeId>()
            ) as *mut TypeId;
            let mut i: usize = 0;
            while (i < gcount) {
                let orig_gv = unsafe { (*typeid_at(orig_gargs, i)).v };
                let sub_g = subst_ty_self(mut_view(*ti), TypeId { v: orig_gv }, args, self_v);
                if sub_g.v != orig_gv {
                    changed = true;
                }
                unsafe {
                    (*typeid_at(new_gargs, i)).v = sub_g.v;
                }
                i = i + 1;
            }
        }
        let mut new_fields: *mut TypeId = orig_fields;
        if fcount > 0 && (orig_fields as usize) != 0 {
            new_fields = arena_alloc_raw(
                mut_view(ti.arena),
                (((fcount as isize) * (size_of<TypeId>() as isize)) as usize),
                align_of<TypeId>()
            ) as *mut TypeId;
            let mut i: usize = 0;
            while (i < fcount) {
                let orig_fv = unsafe { (*typeid_at(orig_fields, i)).v };
                let sub_f = subst_ty_self(mut_view(*ti), TypeId { v: orig_fv }, args, self_v);
                if sub_f.v != orig_fv {
                    changed = true;
                }
                unsafe {
                    (*typeid_at(new_fields, i)).v = sub_f.v;
                }
                i = i + 1;
            }
        }
        if !changed {
            return TypeId { v: ty_v };
        }
        let t_latest = type_get(view(*ti), TypeId { v: ty_v });
        let sp = ti.scratch;
        unsafe {
            copy_ax_type_into(mut_view(*sp), view(*t_latest));
            (*sp).args = new_gargs;
            (*sp).arg_count = gcount;
            (*sp).fields = new_fields;
            (*sp).field_count = fcount;
        }
        return intern_type(mut_view(*ti), unsafe { view(*sp) });
    }

    subst_ty_enum_or_closure(mut_view(*ti), ty_v, t, tk, args, self_v)
}

fn subst_ty_enum_or_closure(
    ti: mut_view<TypeInterner>,
    ty_v: u32,
    t: *mut AxType,
    tk: u8,
    args: view<GenericArgsSlice>,
    self_v: u32
) -> TypeId {
    if tk == TY_ENUM {
        let gcount = unsafe { (*t).arg_count };
        let orig_gargs = unsafe { (*t).args };
        let vcount = unsafe { (*t).variant_count };
        let orig_vfields = unsafe { (*t).variant_fields };
        let orig_vcounts = unsafe { (*t).variant_field_counts };
        let mut changed: bool = false;
        let mut new_gargs: *mut TypeId = orig_gargs;
        if gcount > 0 && (orig_gargs as usize) != 0 {
            new_gargs = arena_alloc_raw(
                mut_view(ti.arena),
                (((gcount as isize) * (size_of<TypeId>() as isize)) as usize),
                align_of<TypeId>()
            ) as *mut TypeId;
            let mut i: usize = 0;
            while (i < gcount) {
                let orig_gv = unsafe { (*typeid_at(orig_gargs, i)).v };
                let sub_g = subst_ty_self(mut_view(*ti), TypeId { v: orig_gv }, args, self_v);
                if sub_g.v != orig_gv {
                    changed = true;
                }
                unsafe {
                    (*typeid_at(new_gargs, i)).v = sub_g.v;
                }
                i = i + 1;
            }
        }
        let mut new_vfields: *mut *mut TypeId = orig_vfields;
        if vcount > 0 && (orig_vfields as usize) != 0 && (orig_vcounts as usize) != 0 {
            new_vfields = arena_alloc_raw(
                mut_view(ti.arena),
                (((vcount as isize) * (size_of<*mut TypeId>() as isize)) as usize),
                align_of<*mut TypeId>()
            ) as *mut *mut TypeId;
            let mut v: usize = 0;
            while (v < vcount) {
                let fcount = unsafe { *usize_at(orig_vcounts, v) };
                let src_vf = unsafe { *typeid_ptr_at(orig_vfields, v) };
                if fcount > 0 && (src_vf as usize) != 0 {
                    let dst_vf = arena_alloc_raw(
                        mut_view(ti.arena),
                        (((fcount as isize) * (size_of<TypeId>() as isize)) as usize),
                        align_of<TypeId>()
                    ) as *mut TypeId;
                    let mut f: usize = 0;
                    while (f < fcount) {
                        let orig_fv = unsafe { (*typeid_at(src_vf, f)).v };
                        let sub_f = subst_ty_self(mut_view(*ti), TypeId { v: orig_fv }, args, self_v);
                        if sub_f.v != orig_fv {
                            changed = true;
                        }
                        unsafe {
                            (*typeid_at(dst_vf, f)).v = sub_f.v;
                        }
                        f = f + 1;
                    }
                    unsafe {
                        *typeid_ptr_at(new_vfields, v) = dst_vf;
                    }
                } else {
                    unsafe {
                        *typeid_ptr_at(new_vfields, v) = 0 as *mut TypeId;
                    }
                }
                v = v + 1;
            }
        }
        if !changed {
            return TypeId { v: ty_v };
        }
        let t_latest = type_get(view(*ti), TypeId { v: ty_v });
        let sp = ti.scratch;
        unsafe {
            copy_ax_type_into(mut_view(*sp), view(*t_latest));
            (*sp).args = new_gargs;
            (*sp).arg_count = gcount;
            (*sp).variant_fields = new_vfields;
        }
        return intern_type(mut_view(*ti), unsafe { view(*sp) });
    }

    if tk == TY_CLOSURE {
        let ccount = unsafe { (*t).capture_count };
        let orig_caps = unsafe { (*t).captures };
        let pcount = unsafe { (*t).param_count };
        let orig_params = unsafe { (*t).param_types };
        let orig_ret_v = unsafe { (*t).ret_type.v };
        let orig_fn_v = unsafe { (*t).fn_type.v };
        let orig_cid = unsafe { (*t).closure_id };
        let mut changed: bool = false;
        let mut cid_mix: u32 = orig_cid;

        let mut new_caps: *mut ClosureCapture = orig_caps;
        if ccount > 0 && (orig_caps as usize) != 0 {
            new_caps = arena_alloc_raw(
                mut_view(ti.arena),
                (((ccount as isize) * (size_of<ClosureCapture>() as isize)) as usize),
                align_of<ClosureCapture>()
            ) as *mut ClosureCapture;
            let mut c: usize = 0;
            while (c < ccount) {
                let src_cap = unsafe { capture_at(orig_caps, c) };
                let dst_cap = unsafe { capture_at(new_caps, c) };
                let orig_cty_v = unsafe { (*src_cap).ty.v };
                let sub_cty = subst_ty_self(mut_view(*ti), TypeId { v: orig_cty_v }, args, self_v);
                if sub_cty.v != orig_cty_v {
                    changed = true;
                }
                cid_mix = (cid_mix * 31u32) ^ sub_cty.v;
                unsafe {
                    (*dst_cap).sym.v = (*src_cap).sym.v;
                    (*dst_cap).mode = (*src_cap).mode;
                    (*dst_cap).ty.v = sub_cty.v;
                }
                c = c + 1;
            }
        }
        let mut new_params: *mut TypeId = orig_params;
        if pcount > 0 && (orig_params as usize) != 0 {
            new_params = arena_alloc_raw(
                mut_view(ti.arena),
                (((pcount as isize) * (size_of<TypeId>() as isize)) as usize),
                align_of<TypeId>()
            ) as *mut TypeId;
            let mut i: usize = 0;
            while (i < pcount) {
                let orig_pv = unsafe { (*typeid_at(orig_params, i)).v };
                let sub_p = subst_ty_self(mut_view(*ti), TypeId { v: orig_pv }, args, self_v);
                if sub_p.v != orig_pv {
                    changed = true;
                }
                cid_mix = (cid_mix * 31u32) ^ sub_p.v;
                unsafe {
                    (*typeid_at(new_params, i)).v = sub_p.v;
                }
                i = i + 1;
            }
        }
        let new_ret = subst_ty_self(mut_view(*ti), TypeId { v: orig_ret_v }, args, self_v);
        if new_ret.v != orig_ret_v {
            changed = true;
            cid_mix = (cid_mix * 31u32) ^ new_ret.v;
        }
        let new_fn = subst_ty_self(mut_view(*ti), TypeId { v: orig_fn_v }, args, self_v);
        if new_fn.v != orig_fn_v {
            changed = true;
        }
        if !changed {
            return TypeId { v: ty_v };
        }
        let new_cid: u32 = if cid_mix == orig_cid { orig_cid ^ 0x40000000u32 } else { cid_mix | 0x40000000u32 };
        let t_latest = type_get(view(*ti), TypeId { v: ty_v });
        let sp = ti.scratch;
        unsafe {
            copy_ax_type_into(mut_view(*sp), view(*t_latest));
            (*sp).closure_id = new_cid;
            (*sp).captures = new_caps;
            (*sp).param_types = new_params;
            (*sp).ret_type.v = new_ret.v;
            (*sp).fn_type.v = new_fn.v;
        }
        return intern_type(mut_view(*ti), unsafe { view(*sp) });
    }

    TypeId { v: ty_v }
}

pub fn deduce_args(
    gen_ty: TypeId,
    spec_ty: TypeId,
    ti: view<TypeInterner>,
    out_args: *mut TypeId,
    arg_count: usize
) {
    let gen_v = gen_ty.v;
    let spec_v = spec_ty.v;
    if gen_v == 0u32 || spec_v == 0u32 || gen_v == spec_v || (out_args as usize) == 0 {
        return;
    }
    let gt = type_get(ti, TypeId { v: gen_v });
    let st = type_get(ti, TypeId { v: spec_v });
    if (gt as usize) == 0 || (st as usize) == 0 {
        return;
    }
    let gk = unsafe { (*gt).kind };
    let sk = unsafe { (*st).kind };

    if gk == TY_PARAM {
        let idx = unsafe { (*gt).param_index as usize };
        if idx < arg_count && sk != TY_PARAM && sk != TY_VAR && sk != TY_INT_VAR && sk != TY_ERROR {
            unsafe {
                (*typeid_at(out_args, idx)).v = spec_v;
            }
        }
        return;
    }

    // Method receiver auto-view: gen_ty is view<T> or mut_view<T>, spec_ty is T
    if (gk == TY_VIEW || gk == TY_MUT_VIEW) && (sk != TY_VIEW && sk != TY_MUT_VIEW) {
        let g_pt = unsafe { (*gt).pointee.v };
        deduce_args(TypeId { v: g_pt }, TypeId { v: spec_v }, ti, out_args, arg_count);
        return;
    }

    if gk != sk {
        if (gk == TY_VIEW && sk == TY_MUT_VIEW) || (gk == TY_MUT_VIEW && sk == TY_VIEW) {
            let g_pt = unsafe { (*gt).pointee.v };
            let s_pt = unsafe { (*st).pointee.v };
            deduce_args(TypeId { v: g_pt }, TypeId { v: s_pt }, ti, out_args, arg_count);
        }
        return;
    }

    if gk == TY_VIEW || gk == TY_MUT_VIEW || gk == TY_PTR {
        let g_pt = unsafe { (*gt).pointee.v };
        let s_pt = unsafe { (*st).pointee.v };
        deduce_args(TypeId { v: g_pt }, TypeId { v: s_pt }, ti, out_args, arg_count);
        return;
    }

    if gk == TY_ARRAY || gk == TY_SLICE {
        let g_el = unsafe { (*gt).elem.v };
        let s_el = unsafe { (*st).elem.v };
        deduce_args(TypeId { v: g_el }, TypeId { v: s_el }, ti, out_args, arg_count);
        return;
    }

    if gk == TY_TUPLE {
        let g_fc = unsafe { (*gt).field_count };
        let s_fc = unsafe { (*st).field_count };
        if g_fc == s_fc {
            let g_fields = unsafe { (*gt).fields };
            let s_fields = unsafe { (*st).fields };
            let mut i: usize = 0;
            while (i < g_fc) {
                let gf = unsafe { (*typeid_at(g_fields, i)).v };
                let sf = unsafe { (*typeid_at(s_fields, i)).v };
                deduce_args(TypeId { v: gf }, TypeId { v: sf }, ti, out_args, arg_count);
                i = i + 1;
            }
        }
        return;
    }

    if gk == TY_FN {
        let g_pc = unsafe { (*gt).param_count };
        let s_pc = unsafe { (*st).param_count };
        if g_pc == s_pc {
            let g_params = unsafe { (*gt).param_types };
            let s_params = unsafe { (*st).param_types };
            let mut i: usize = 0;
            while (i < g_pc) {
                let gp = unsafe { (*typeid_at(g_params, i)).v };
                let sp = unsafe { (*typeid_at(s_params, i)).v };
                deduce_args(TypeId { v: gp }, TypeId { v: sp }, ti, out_args, arg_count);
                i = i + 1;
            }
            let g_ret = unsafe { (*gt).ret_type.v };
            let s_ret = unsafe { (*st).ret_type.v };
            deduce_args(TypeId { v: g_ret }, TypeId { v: s_ret }, ti, out_args, arg_count);
        }
        return;
    }

    if gk == TY_STRUCT || gk == TY_ENUM {
        let g_def = unsafe { (*gt).def as usize };
        let s_def = unsafe { (*st).def as usize };
        if g_def == s_def {
            let g_ac = unsafe { (*gt).arg_count };
            let s_ac = unsafe { (*st).arg_count };
            if g_ac > 0 && g_ac == s_ac {
                let g_args = unsafe { (*gt).args };
                let s_args = unsafe { (*st).args };
                let mut i: usize = 0;
                while (i < g_ac) {
                    let ga = unsafe { (*typeid_at(g_args, i)).v };
                    let sa = unsafe { (*typeid_at(s_args, i)).v };
                    deduce_args(TypeId { v: ga }, TypeId { v: sa }, ti, out_args, arg_count);
                    i = i + 1;
                }
            } else if gk == TY_STRUCT {
                let g_fc = unsafe { (*gt).field_count };
                let s_fc = unsafe { (*st).field_count };
                if g_fc == s_fc {
                    let g_fields = unsafe { (*gt).fields };
                    let s_fields = unsafe { (*st).fields };
                    let mut i: usize = 0;
                    while (i < g_fc) {
                        let gf = unsafe { (*typeid_at(g_fields, i)).v };
                        let sf = unsafe { (*typeid_at(s_fields, i)).v };
                        deduce_args(TypeId { v: gf }, TypeId { v: sf }, ti, out_args, arg_count);
                        i = i + 1;
                    }
                }
            }
        }
    }
}

fn write_u32_decimal(buf: *mut u8, offset: usize, val: u32) -> usize {
    if val == 0u32 {
        unsafe {
            *(buf + offset) = 48u8;
        }
        return offset + 1;
    }
    let mut tmp: [12]u8 = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    let mut dlen: usize = 0;
    let mut cur: u32 = val;
    while (cur > 0u32) {
        let digit = (cur % 10u32) as u8;
        tmp[dlen] = 48u8 + digit;
        dlen = dlen + 1;
        cur = cur / 10u32;
    }
    let mut i: usize = 0;
    while (i < dlen) {
        let rev_idx = dlen - 1 - i;
        unsafe {
            *(buf + offset + i) = tmp[rev_idx];
        }
        i = i + 1;
    }
    offset + dlen
}

pub fn mangle_anon_fn_name(str_in: mut_view<StrInterner>, sym: SymbolId) -> StrId {
    let buf = arena_alloc_raw(mut_view(str_in.bytes), 32, 1);
    unsafe {
        *(buf + 0) = 95u8;
        *(buf + 1) = 95u8;
        *(buf + 2) = 97u8;
        *(buf + 3) = 120u8;
        *(buf + 4) = 95u8;
        *(buf + 5) = 102u8;
        *(buf + 6) = 110u8;
        *(buf + 7) = 95u8;
    }
    let end_off = write_u32_decimal(buf, 8, sym.v);
    interner_intern_bytes(mut_view(*str_in), buf as *const u8, end_off)
}

pub fn mangle_instance_name(
    str_in: mut_view<StrInterner>,
    orig_name: StrId,
    orig_sym: SymbolId,
    arg_count: usize,
    counter: u32
) -> StrId {
    let mut base_id = StrId { v: orig_name.v };
    if base_id.v == 0u32 {
        base_id = mangle_anon_fn_name(mut_view(*str_in), orig_sym);
    }
    if arg_count == 0 {
        return base_id;
    }
    let base_sv = interner_get(view(*str_in), base_id);
    let base_len: usize = base_sv.len;
    let base_ptr: *const u8 = base_sv.ptr;
    let buf = arena_alloc_raw(mut_view(str_in.bytes), base_len + 24, 1);
    if base_len > 0 && (base_ptr as usize) != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(base_ptr, buf, base_len);
        }
    }
    let mut off = base_len;
    unsafe {
        *(buf + off) = 95u8;
        *(buf + off + 1) = 73u8;
    }
    off = write_u32_decimal(buf, off + 2, counter);
    unsafe {
        *(buf + off) = 69u8;
    }
    off = off + 1;
    interner_intern_bytes(mut_view(*str_in), buf as *const u8, off)
}

pub fn mangle_collision_name(
    str_in: mut_view<StrInterner>,
    base_name: StrId,
    sym: SymbolId
) -> StrId {
    let base_sv = interner_get(view(*str_in), base_name);
    let base_len: usize = base_sv.len;
    let base_ptr: *const u8 = base_sv.ptr;
    let buf = arena_alloc_raw(mut_view(str_in.bytes), base_len + 20, 1);
    if base_len > 0 && (base_ptr as usize) != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(base_ptr, buf, base_len);
        }
    }
    let mut off = base_len;
    unsafe {
        *(buf + off) = 95u8;
    }
    off = write_u32_decimal(buf, off + 1, sym.v);
    interner_intern_bytes(mut_view(*str_in), buf as *const u8, off)
}

pub fn mangle_drop_name(
    str_in: mut_view<StrInterner>,
    self_type_name: view<StrView>
) -> StrId {
    let s_len: usize = self_type_name.len;
    let s_ptr: *const u8 = self_type_name.ptr;
    let mut clean_len: usize = 0;
    while (clean_len < s_len) {
        let ch = unsafe { *(s_ptr + clean_len) };
        if ch == 60u8 || ch == 32u8 {
            break;
        }
        clean_len = clean_len + 1;
    }
    let buf = arena_alloc_raw(mut_view(str_in.bytes), clean_len + 6, 1);
    if clean_len > 0 && (s_ptr as usize) != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(s_ptr, buf, clean_len);
        }
    }
    unsafe {
        *(buf + clean_len + 0) = 95u8;
        *(buf + clean_len + 1) = 100u8;
        *(buf + clean_len + 2) = 114u8;
        *(buf + clean_len + 3) = 111u8;
        *(buf + clean_len + 4) = 112u8;
    }
    interner_intern_bytes(mut_view(*str_in), buf as *const u8, clean_len + 5)
}

pub fn mangle_structural_args(
    str_in: mut_view<StrInterner>,
    base_name: StrId,
    args: view<GenericArgsSlice>
) -> StrId {
    let a_cnt: usize = args.count;
    let a_ptr: *mut TypeId = args.args;
    if a_cnt == 0 || (a_ptr as usize) == 0 {
        return base_name;
    }
    let base_sv = interner_get(view(*str_in), base_name);
    let base_len: usize = base_sv.len;
    let base_ptr: *const u8 = base_sv.ptr;
    let cap = base_len + 8 + (((a_cnt as isize) * 14isize) as usize);
    let buf = arena_alloc_raw(mut_view(str_in.bytes), cap, 1);
    if base_len > 0 && (base_ptr as usize) != 0 {
        unsafe {
            ptr_copy_nonoverlapping<u8>(base_ptr, buf, base_len);
        }
    }
    let mut off = base_len;
    unsafe {
        *(buf + off) = 95u8;
        *(buf + off + 1) = 73u8;
    }
    off = off + 2;
    let mut i: usize = 0;
    while (i < a_cnt) {
        let av = unsafe { (*typeid_at(a_ptr, i)).v };
        unsafe {
            *(buf + off) = 95u8;
        }
        off = write_u32_decimal(buf, off + 1, av);
        i = i + 1;
    }
    unsafe {
        *(buf + off) = 95u8;
        *(buf + off + 1) = 69u8;
    }
    off = off + 2;
    interner_intern_bytes(mut_view(*str_in), buf as *const u8, off)
}

pub fn mono_engine_init(eng: mut_view<MonoEngine>, arena: *mut Arena) {
    eng.arena = arena;
    eng.instances_head = 0 as *mut MonoInstance;
    eng.instances_tail = 0 as *mut MonoInstance;
    eng.instance_count = 0;
    eng.work_head = 0 as *mut MonoInstance;
    eng.work_tail = 0 as *mut MonoInstance;
    eng.next_counter = 1u32;
    eng.next_sym_id = MONO_FIRST_SYM_ID;
}

pub fn mono_find_instance(
    eng: view<MonoEngine>,
    orig: *const HirItem,
    args: view<GenericArgsSlice>
) -> *mut MonoInstance {
    let orig_sym = if (orig as usize) != 0 { unsafe { (*orig).symbol.v } } else { 0u32 };
    let mut cur: *mut MonoInstance = eng.instances_head;
    while ((cur as usize) != 0) {
        let cur_orig_ptr = unsafe { (*cur).orig_item };
        let cur_orig = cur_orig_ptr as usize;
        let cur_sym = if cur_orig != 0 { unsafe { (*cur_orig_ptr).symbol.v } } else { 0u32 };
        if cur_orig == (orig as usize) || (orig_sym != 0u32 && cur_sym == orig_sym) {
            let eq = unsafe { generic_args_eq(view((*cur).args), args) };
            if eq {
                return cur;
            }
        }
        cur = unsafe { (*cur).next };
    }
    0 as *mut MonoInstance
}

fn clone_hir_item_for_mono(
    arena: mut_view<Arena>,
    orig: *const HirItem,
    new_sym: SymbolId,
    new_name: StrId
) -> *mut HirItem {
    let bytes = size_of<HirItem>();
    let copy = arena_alloc_raw(mut_view(*arena), bytes, align_of<HirItem>()) as *mut HirItem;
    unsafe {
        ptr_copy_nonoverlapping<u8>(orig as *const u8, copy as *mut u8, bytes);
        (*copy).symbol.v = new_sym.v;
        (*copy).name.v = new_name.v;
        (*copy).generic_params = 0 as *mut HirGenericParams;
        (*copy).next = 0 as *mut HirItem;
    }
    copy
}

pub fn mono_find_or_create_inst(
    eng: mut_view<MonoEngine>,
    str_in: mut_view<StrInterner>,
    orig: *mut HirItem,
    args: view<GenericArgsSlice>
) -> *mut MonoInstance {
    if (orig as usize) == 0 {
        return 0 as *mut MonoInstance;
    }
    let existing = mono_find_instance(view(*eng), orig, args);
    if (existing as usize) != 0 {
        return existing;
    }

    let inst = unsafe {
        arena_alloc_raw(
            mut_view(*eng.arena),
            size_of<MonoInstance>(),
            align_of<MonoInstance>()
        ) as *mut MonoInstance
    };

    let ac: usize = args.count;
    let a_ptr: *mut TypeId = args.args;
    let mut copied_args: *mut TypeId = 0 as *mut TypeId;
    if ac > 0 && (a_ptr as usize) != 0 {
        let abytes = (((ac as isize) * (size_of<TypeId>() as isize)) as usize);
        copied_args = unsafe {
            arena_alloc_raw(mut_view(*eng.arena), abytes, align_of<TypeId>()) as *mut TypeId
        };
        unsafe {
            ptr_copy_nonoverlapping<u8>(a_ptr as *const u8, copied_args as *mut u8, abytes);
        }
    }

    let orig_name_v = unsafe { (*orig).name.v };
    let orig_sym_v = unsafe { (*orig).symbol.v };
    let mut m_sym_v: u32 = orig_sym_v;
    let mut m_name_v: u32 = orig_name_v;
    let mut new_it: *mut HirItem = orig;

    if ac == 0 {
        let m_id = mangle_instance_name(
            mut_view(*str_in),
            StrId { v: orig_name_v },
            SymbolId { v: orig_sym_v },
            0,
            0u32
        );
        m_name_v = m_id.v;
    } else {
        m_sym_v = eng.next_sym_id;
        eng.next_sym_id = m_sym_v + 1u32;
        let cnt = eng.next_counter;
        eng.next_counter = cnt + 1u32;
        let m_id = mangle_instance_name(
            mut_view(*str_in),
            StrId { v: orig_name_v },
            SymbolId { v: orig_sym_v },
            ac,
            cnt
        );
        m_name_v = m_id.v;
        new_it = unsafe {
            clone_hir_item_for_mono(
                mut_view(*eng.arena),
                orig,
                SymbolId { v: m_sym_v },
                StrId { v: m_name_v }
            )
        };
    }

    unsafe {
        (*inst).orig_item = orig;
        (*inst).new_item = new_it;
        (*inst).args.args = copied_args;
        (*inst).args.count = ac;
        (*inst).mangled_sym.v = m_sym_v;
        (*inst).mangled_name.v = m_name_v;
        (*inst).mir_body = 0;
        (*inst).next = 0 as *mut MonoInstance;
        (*inst).work_next = 0 as *mut MonoInstance;
        (*inst).in_worklist = true;
    }

    if (eng.instances_tail as usize) != 0 {
        unsafe {
            (*eng.instances_tail).next = inst;
        }
    } else {
        eng.instances_head = inst;
    }
    eng.instances_tail = inst;
    let prev_count: usize = eng.instance_count;
    eng.instance_count = prev_count + 1;

    if (eng.work_tail as usize) != 0 {
        unsafe {
            (*eng.work_tail).work_next = inst;
        }
    } else {
        eng.work_head = inst;
    }
    eng.work_tail = inst;

    inst
}

pub fn mono_worklist_is_empty(eng: view<MonoEngine>) -> bool {
    (eng.work_head as usize) == 0
}

pub fn mono_pop_worklist(eng: mut_view<MonoEngine>) -> *mut MonoInstance {
    let head = eng.work_head;
    if (head as usize) == 0 {
        return 0 as *mut MonoInstance;
    }
    let next_w = unsafe { (*head).work_next };
    eng.work_head = next_w;
    if (next_w as usize) == 0 {
        eng.work_tail = 0 as *mut MonoInstance;
    }
    unsafe {
        (*head).work_next = 0 as *mut MonoInstance;
        (*head).in_worklist = false;
    }
    head
}

pub fn mono_resolve_trait_or_impl_method(
    hir: view<HirFile>,
    ti: view<TypeInterner>,
    str_in: view<StrInterner>,
    db: view<SourceDatabase>,
    receiver_ty: TypeId,
    method_name: view<StrView>
) -> *mut HirItem {
    let rec_v = receiver_ty.v;
    let m_len: usize = method_name.len;
    if rec_v == 0u32 || m_len == 0 {
        return 0 as *mut HirItem;
    }
    let mut it: *mut HirItem = hir.items;
    while ((it as usize) != 0) {
        if unsafe { (*it).kind } == HIR_ITEM_IMPL {
            if impl_matches_receiver(ti, str_in, it, (TypeId { v: rec_v })) {
                let mut m: *mut HirItem = unsafe { (*it).members };
                while ((m as usize) != 0) {
                    if unsafe { (*m).kind } == HIR_ITEM_FN {
                        let m_name = hir_item_name_sv(m, str_in, db);
                        if sv_eq(view(m_name), method_name) {
                            return m;
                        }
                    }
                    m = unsafe { (*m).next };
                }
                let tp = unsafe { (*it).trait_path };
                if (tp as usize) != 0 && unsafe { (*tp).kind } == HIR_TYPE_PATH {
                    let tr_it = find_trait_by_type_path(hir, tp, str_in, db);
                    if (tr_it as usize) != 0 {
                        let def_m = find_trait_default_method(hir, tr_it, method_name, str_in, db);
                        if (def_m as usize) != 0 {
                            return def_m;
                        }
                    }
                }
            }
        }
        it = unsafe { (*it).next };
    }
    0 as *mut HirItem
}

fn item_is_non_generic_fn(it: *const HirItem) -> bool {
    if (it as usize) == 0 {
        return false;
    }
    if unsafe { (*it).kind } != HIR_ITEM_FN {
        return false;
    }
    if (unsafe { (*it).body as usize }) == 0 {
        return false;
    }
    let gps = unsafe { (*it).generic_params };
    if (gps as usize) == 0 {
        return true;
    }
    (unsafe { (*gps).params as usize }) == 0
}

pub fn mono_seed_hir_items(
    eng: mut_view<MonoEngine>,
    hir: view<HirFile>,
    str_in: mut_view<StrInterner>,
    db: view<SourceDatabase>
) {
    let empty = GenericArgsSlice { args: 0 as *mut TypeId, count: 0 };
    let mut it: *mut HirItem = hir.items;
    while ((it as usize) != 0) {
        let ik = unsafe { (*it).kind };
        if item_is_non_generic_fn(it) {
            mono_find_or_create_inst(mut_view(*eng), mut_view(*str_in), it, view(empty));
        } else if ik == HIR_ITEM_IMPL {
            let mut m: *mut HirItem = unsafe { (*it).members };
            while ((m as usize) != 0) {
                if item_is_non_generic_fn(m) {
                    mono_find_or_create_inst(mut_view(*eng), mut_view(*str_in), m, view(empty));
                }
                m = unsafe { (*m).next };
            }
            let tp = unsafe { (*it).trait_path };
            if (tp as usize) != 0 && unsafe { (*tp).kind } == HIR_TYPE_PATH {
                let tr_it = find_trait_by_type_path(hir, tp, view(*str_in), db);
                if (tr_it as usize) != 0 {
                    let mut tm: *mut HirItem = unsafe { (*tr_it).members };
                    while ((tm as usize) != 0) {
                        if item_is_non_generic_fn(tm) {
                            let tm_name = hir_item_name_sv(tm, view(*str_in), db);
                            let mut overridden: bool = false;
                            let mut im: *mut HirItem = unsafe { (*it).members };
                            while ((im as usize) != 0) {
                                if unsafe { (*im).kind } == HIR_ITEM_FN {
                                    let im_name = hir_item_name_sv(im, view(*str_in), db);
                                    if sv_eq(view(tm_name), view(im_name)) {
                                        overridden = true;
                                        break;
                                    }
                                }
                                im = unsafe { (*im).next };
                            }
                            if !overridden {
                                mono_find_or_create_inst(
                                    mut_view(*eng),
                                    mut_view(*str_in),
                                    tm,
                                    view(empty)
                                );
                            }
                        }
                        tm = unsafe { (*tm).next };
                    }
                }
            }
        }
        it = unsafe { (*it).next };
    }
}

pub fn mono_dedup_instance_names(
    eng: mut_view<MonoEngine>,
    str_in: mut_view<StrInterner>
) {
    let mut i1: *mut MonoInstance = eng.instances_head;
    while ((i1 as usize) != 0) {
        let mut i2: *mut MonoInstance = unsafe { (*i1).next };
        while ((i2 as usize) != 0) {
            let n1 = unsafe { (*i1).mangled_name.v };
            let n2 = unsafe { (*i2).mangled_name.v };
            if n1 != 0u32 && n1 == n2 {
                let sym2_v = unsafe { (*i2).mangled_sym.v };
                let dedup = mangle_collision_name(
                    mut_view(*str_in),
                    StrId { v: n2 },
                    SymbolId { v: sym2_v }
                );
                unsafe {
                    (*i2).mangled_name.v = dedup.v;
                    let new_it2 = (*i2).new_item;
                    let orig_it2 = (*i2).orig_item;
                    if (new_it2 as usize) != 0 && (new_it2 as usize) != (orig_it2 as usize) {
                        (*new_it2).name.v = dedup.v;
                    }
                }
            }
            i2 = unsafe { (*i2).next };
        }
        i1 = unsafe { (*i1).next };
    }
}

