@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }

@FIXTURE_DATA@
@FIXTURE_OFF@
@FIXTURE_EXP_COUNTS@
@FIXTURE_EXP_OFF@
@FIXTURE_EXP_CODES@
@UNIT_MIR_DATA@
@UNIT_MIR_OFF@

const FIXTURE_COUNT: usize = @FIXTURE_COUNT@;

fn qa_zero_span() -> Span {
    Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 }
}

fn alloc_zero_stmt(arena: mut_view<Arena>) -> *mut MirStmt {
    let p = arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt;
    unsafe {
        mir_stmt_zero(mut_view(*p), MIR_STMT_ASSIGN);
    }
    p
}

fn set_op_copy_local(op: mut_view<MirOperand>, local_v: u32) {
    mir_operand_zero(mut_view(*op), MIR_OP_COPY);
    let pl = mir_local_place(local_v);
    op.place = pl;
}

fn set_op_move_local(op: mut_view<MirOperand>, local_v: u32) {
    mir_operand_zero(mut_view(*op), MIR_OP_MOVE);
    let pl = mir_local_place(local_v);
    op.place = pl;
}

fn set_op_const_int(op: mut_view<MirOperand>, ty_v: u32, val: u64) {
    mir_operand_zero(mut_view(*op), MIR_OP_CONST);
    op.constant.kind = MIR_CONST_INT;
    op.constant.ty = TypeId { v: ty_v };
    op.constant.val = val;
}

unsafe fn diag_at(base: *mut Diagnostic, idx: usize) -> *mut Diagnostic {
    let off = ((idx as isize) * (size_of<Diagnostic>() as isize)) as usize;
    ((base as usize) + off) as *mut Diagnostic
}

fn fixture_blob(arena: mut_view<Arena>, idx: usize) -> StrView {
    let start = FIXTURE_OFF[idx] as usize;
    let end = FIXTURE_OFF[idx + 1] as usize;
    let n = end - start;
    let dst = arena_alloc_raw(mut_view(*arena), n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe {
            *(dst + i) = FIXTURE_DATA[start + i];
        }
        i = i + 1;
    }
    unsafe {
        *(dst + n) = 0u8;
    }
    StrView { ptr: dst as *const u8, len: n }
}

fn unit_mir_blob(arena: mut_view<Arena>, idx: usize) -> StrView {
    let start = UNIT_MIR_OFF[idx] as usize;
    let end = UNIT_MIR_OFF[idx + 1] as usize;
    let n = end - start;
    let dst = arena_alloc_raw(mut_view(*arena), n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe {
            *(dst + i) = UNIT_MIR_DATA[start + i];
        }
        i = i + 1;
    }
    unsafe {
        *(dst + n) = 0u8;
    }
    StrView { ptr: dst as *const u8, len: n }
}

fn check_single_code(sink: view<DiagSink>, exp_code: u32, fail_rc: i32) -> i32 {
    if sink.errors == 0 || sink.len == 0 {
        return fail_rc;
    }
    let d0 = unsafe { diag_at(sink.diags, 0) };
    let got = unsafe { (*d0).code.v };
    if got != exp_code {
        return fail_rc + 1000;
    }
    0
}

fn alloc_init_thir(arena: mut_view<Arena>) -> *mut Thir {
    let thir_ptr = arena_alloc_raw(mut_view(*arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    let int_ar = arena_new();
    unsafe {
        (*thir_ptr).interner.arena = int_ar;
        thir_init(mut_view(*thir_ptr));
    }
    thir_ptr
}

// 1. Differential test over all 21 `.mir` fixtures from `tests/verify/` and `tests/verify/own/`.
fn test_mir_fixtures(arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> i32 {
    let mut i: usize = 0;
    while i < FIXTURE_COUNT {
        diag_sink_free(mut_view(*sink));
        diag_sink_init(mut_view(*sink));

        let text = fixture_blob(mut_view(*arena), i);
        let _ = verify_mir_text(text, mut_view(*sink));

        let exp_cnt = FIXTURE_EXP_COUNTS[i] as usize;
        let exp_base = FIXTURE_EXP_OFF[i] as usize;
        if (sink.errors as usize) != exp_cnt || sink.len != exp_cnt {
            return 100 + (i as i32);
        }
        let mut k: usize = 0;
        while k < exp_cnt {
            let d = unsafe { diag_at(sink.diags, k) };
            let got_code = unsafe { (*d).code.v };
            let exp_code = FIXTURE_EXP_CODES[exp_base + k];
            if got_code != exp_code {
                return 200 + (i as i32);
            }
            k = k + 1;
        }
        arena_reset(mut_view(*arena));
        i = i + 1;
    }

    // Also test `tests/verify/return_type.mir` (fixture index 2) with a `func` whose return type
    // in `thir.item_types` disagrees with `_0`'s type (`type#10` vs `type#2`).
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let rt_text = fixture_blob(mut_view(*arena), 2);
    let thir_ptr = alloc_init_thir(mut_view(*arena));
    let rt_body = verify_parse_mir(
        rt_text,
        unsafe { mut_view((*thir_ptr).interner) },
        mut_view(*arena)
    );
    if (rt_body as usize) == 0 {
        unsafe { thir_free(mut_view(*thir_ptr)); }
        return 250;
    }
    let fn_item = hir_alloc_item(mut_view(*arena), HIR_ITEM_FN, qa_zero_span());
    let fn_ty = intern_fn_ty(
        unsafe { mut_view((*thir_ptr).interner) },
        false,
        StrId { v: 0u32 },
        0 as *mut TypeId,
        0,
        TypeId { v: 2u32 }
    );
    thir_set_item_type(unsafe { mut_view(*thir_ptr) }, fn_item as *const HirItem, fn_ty);
    verify_mir(
        unsafe { view(*rt_body) },
        thir_ptr as *const Thir,
        mut_view(*sink),
        fn_item as *const HirItem
    );
    unsafe {
        thir_free(mut_view(*thir_ptr));
    }
    let rc_rt = check_single_code(view(*sink), AX_VERIFY_RETURN_TYPE, 251);
    if rc_rt != 0 {
        return rc_rt;
    }

    // Malformed MIR syntax -> AX_VERIFY_MIR_SYNTAX.
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let bad_syn_sv = unit_mir_blob(mut_view(*arena), 0);
    let ok_bad = verify_mir_text(bad_syn_sv, mut_view(*sink));
    if ok_bad {
        return 252;
    }
    let rc_syn = check_single_code(view(*sink), AX_VERIFY_MIR_SYNTAX, 253);
    if rc_syn != 0 {
        return rc_syn;
    }

    arena_reset(mut_view(*arena));
    0
}

// 2. Unit tests for control-flow, operator, cast, call signature, and storage-dead checks via MIR text.
fn test_cfg_and_rvalue_units(arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> i32 {
    // 2a. Valid MIR with comparison, shift, overflows, assert, switchInt, and StorageLive/StorageDead.
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let valid_mir = unit_mir_blob(mut_view(*arena), 1);
    if !verify_mir_text(valid_mir, mut_view(*sink)) {
        return 301;
    }

    // 2b. Comparison result (`bool` = type#4) assigned to `i32` (type#8) -> AX_VERIFY_TYPE_MISMATCH.
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let bad_cmp = unit_mir_blob(mut_view(*arena), 2);
    let _ = verify_mir_text(bad_cmp, mut_view(*sink));
    let rc_cmp = check_single_code(view(*sink), AX_VERIFY_TYPE_MISMATCH, 302);
    if rc_cmp != 0 {
        return rc_cmp;
    }

    // 2c. `switchInt` target out of bounds -> AX_VERIFY_BAD_TARGET.
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let bad_sw = unit_mir_blob(mut_view(*arena), 3);
    let _ = verify_mir_text(bad_sw, mut_view(*sink));
    let rc_sw = check_single_code(view(*sink), AX_VERIFY_BAD_TARGET, 303);
    if rc_sw != 0 {
        return rc_sw;
    }

    // 2d. `assert` unwind target out of bounds -> AX_VERIFY_BAD_TARGET.
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let bad_assert = unit_mir_blob(mut_view(*arena), 4);
    let _ = verify_mir_text(bad_assert, mut_view(*sink));
    let rc_as = check_single_code(view(*sink), AX_VERIFY_BAD_TARGET, 304);
    if rc_as != 0 {
        return rc_as;
    }

    // 2e. Call argument type mismatch (same arg count, wrong arg type) -> AX_VERIFY_CALL_SIGNATURE.
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let bad_call_arg = unit_mir_blob(mut_view(*arena), 5);
    let _ = verify_mir_text(bad_call_arg, mut_view(*sink));
    let rc_ca = check_single_code(view(*sink), AX_VERIFY_CALL_SIGNATURE, 305);
    if rc_ca != 0 {
        return rc_ca;
    }

    // 2f. Uninitialized return place `_0` when `_0` is `type#8` (`i32`) -> AX_VERIFY_UNINIT_USE.
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let bad_ret_uninit = unit_mir_blob(mut_view(*arena), 6);
    let _ = verify_mir_text(bad_ret_uninit, mut_view(*sink));
    let rc_ru = check_single_code(view(*sink), AX_VERIFY_UNINIT_USE, 306);
    if rc_ru != 0 {
        return rc_ru;
    }

    arena_reset(mut_view(*arena));
    0
}

// 3. Programmatic unit tests for projections, aggregates, and capabilities.
fn test_projections_aggregates_and_cap(
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> i32 {
    let thir_ptr = alloc_init_thir(mut_view(*arena));
    let t_unit_v = unsafe { (*thir_ptr).interner.t_unit.v };
    let t_bool_v = unsafe { (*thir_ptr).interner.t_bool.v };
    let t_i32_v = unsafe { (*thir_ptr).interner.t_i32.v };

    let tup_flds = arena_alloc_raw(mut_view(*arena), mir_mul_usize(2, size_of<TypeId>()), align_of<TypeId>()) as *mut TypeId;
    unsafe {
        (*typeid_at(tup_flds, 0)).v = t_i32_v;
        (*typeid_at(tup_flds, 1)).v = t_bool_v;
    }
    let t_tup = intern_tuple_ty(unsafe { mut_view((*thir_ptr).interner) }, tup_flds, 2);

    // 3a. Deref projection on non-pointer (`i32`) -> AX_VERIFY_TYPE_MISMATCH.
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let zsp = qa_zero_span();
    let body = mir_body_new(mut_view(*arena));
    let _ = unsafe { mir_add_local(mut_view(*body), mut_view(*arena), TypeId { v: t_unit_v }, MIR_LOCAL_RETURN, true, StrId { v: 0u32 }, view(zsp)) };
    let _ = unsafe { mir_add_local(mut_view(*body), mut_view(*arena), TypeId { v: t_i32_v }, MIR_LOCAL_USER, false, StrId { v: 0u32 }, view(zsp)) };
    let _ = unsafe { mir_add_local(mut_view(*body), mut_view(*arena), TypeId { v: t_tup.v }, MIR_LOCAL_USER, false, StrId { v: 0u32 }, view(zsp)) };
    let bb0_id = unsafe { mir_add_bb(mut_view(*body), mut_view(*arena), false) };
    let bb0 = unsafe { mir_bb_at((*body).bbs, bb0_id.v as usize) };

    let st_init = alloc_zero_stmt(mut_view(*arena));
    let pl1 = mir_local_place(1u32);
    unsafe {
        (*st_init).place = pl1;
        (*st_init).rvalue.kind = MIR_RVALUE_USE;
        set_op_const_int(mut_view((*st_init).rvalue.use_op), t_i32_v, 7u64);
        mir_bb_push_stmt(mut_view(*bb0), mut_view(*arena), view(*st_init));
    }

    let deref_proj = MirProjection {
        kind: MIR_PROJ_DEREF,
        field_idx: 0u32,
        index_local: MirLocalId { v: 0u32 },
        from_local: MirLocalId { v: 0u32 },
        to_local: MirLocalId { v: 0u32 },
        has_from: false,
        has_to: false,
        variant_idx: 0u32,
    };
    let mut bad_deref_place = mir_local_place(1u32);
    let base_place1 = mir_local_place(1u32);
    mir_place_append_proj(mut_view(*arena), view(base_place1), view(deref_proj), mut_view(bad_deref_place));

    let st_deref = alloc_zero_stmt(mut_view(*arena));
    unsafe {
        (*st_deref).place = bad_deref_place;
        (*st_deref).rvalue.kind = MIR_RVALUE_USE;
        set_op_const_int(mut_view((*st_deref).rvalue.use_op), t_i32_v, 1u64);
        mir_bb_push_stmt(mut_view(*bb0), mut_view(*arena), view(*st_deref));
        mir_term_zero(mut_view((*bb0).terminator), MIR_TERM_RETURN);
        (*bb0).has_terminator = true;
    }

    verify_mir(unsafe { view(*body) }, thir_ptr as *const Thir, mut_view(*sink), 0 as *const HirItem);
    let rc_deref = check_single_code(view(*sink), AX_VERIFY_TYPE_MISMATCH, 401);
    if rc_deref != 0 {
        unsafe { thir_free(mut_view(*thir_ptr)); }
        return rc_deref;
    }

    // 3b. Tuple field projection out of bounds (`_2.5` on 2-field tuple) -> AX_VERIFY_TYPE_MISMATCH.
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let oob_field_proj = MirProjection {
        kind: MIR_PROJ_FIELD,
        field_idx: 5u32,
        index_local: MirLocalId { v: 0u32 },
        from_local: MirLocalId { v: 0u32 },
        to_local: MirLocalId { v: 0u32 },
        has_from: false,
        has_to: false,
        variant_idx: 0u32,
    };
    let mut bad_field_place = mir_local_place(2u32);
    let base_place2 = mir_local_place(2u32);
    mir_place_append_proj(mut_view(*arena), view(base_place2), view(oob_field_proj), mut_view(bad_field_place));
    let st1_ptr = unsafe { mir_stmt_at((*bb0).stmts, 1) };
    unsafe {
        (*st1_ptr).place = bad_field_place;
    }
    verify_mir(unsafe { view(*body) }, thir_ptr as *const Thir, mut_view(*sink), 0 as *const HirItem);
    let rc_fld = check_single_code(view(*sink), AX_VERIFY_TYPE_MISMATCH, 402);
    if rc_fld != 0 {
        unsafe { thir_free(mut_view(*thir_ptr)); }
        return rc_fld;
    }

    // 3c. Index projection with unknown `index_local` (`_99`) -> AX_VERIFY_UNKNOWN_LOCAL.
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let bad_idx_proj = MirProjection {
        kind: MIR_PROJ_INDEX,
        field_idx: 0u32,
        index_local: MirLocalId { v: 99u32 },
        from_local: MirLocalId { v: 0u32 },
        to_local: MirLocalId { v: 0u32 },
        has_from: false,
        has_to: false,
        variant_idx: 0u32,
    };
    let mut bad_idx_place = mir_local_place(2u32);
    mir_place_append_proj(mut_view(*arena), view(base_place2), view(bad_idx_proj), mut_view(bad_idx_place));
    unsafe {
        (*st1_ptr).place = bad_idx_place;
    }
    verify_mir(unsafe { view(*body) }, thir_ptr as *const Thir, mut_view(*sink), 0 as *const HirItem);
    let rc_idx = check_single_code(view(*sink), AX_VERIFY_UNKNOWN_LOCAL, 403);
    if rc_idx != 0 {
        unsafe { thir_free(mut_view(*thir_ptr)); }
        return rc_idx;
    }

    // 3d. Tuple aggregate operand count mismatch (`_2 = Aggregate(variant#0, [_1])` on 2-field tuple) -> AX_VERIFY_TYPE_MISMATCH.
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let ops2 = arena_alloc_raw(mut_view(*arena), mir_mul_usize(2, size_of<MirOperand>()), align_of<MirOperand>()) as *mut MirOperand;
    let op0 = unsafe { mir_op_at(ops2, 0) };
    let op1 = unsafe { mir_op_at(ops2, 1) };
    let agg_pl2 = mir_local_place(2u32);
    unsafe {
        set_op_copy_local(mut_view(*op0), 1u32);
        set_op_const_int(mut_view(*op1), t_bool_v, 1u64);
        (*st1_ptr).place = agg_pl2;
        (*st1_ptr).rvalue.kind = MIR_RVALUE_AGGREGATE;
        (*st1_ptr).rvalue.operands = op0;
        (*st1_ptr).rvalue.operand_count = 1;
    }
    verify_mir(unsafe { view(*body) }, thir_ptr as *const Thir, mut_view(*sink), 0 as *const HirItem);
    let rc_agg_cnt = check_single_code(view(*sink), AX_VERIFY_TYPE_MISMATCH, 404);
    if rc_agg_cnt != 0 {
        unsafe { thir_free(mut_view(*thir_ptr)); }
        return rc_agg_cnt;
    }

    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    unsafe {
        (*st1_ptr).rvalue.operand_count = 2;
    }
    verify_mir(unsafe { view(*body) }, thir_ptr as *const Thir, mut_view(*sink), 0 as *const HirItem);
    if sink.errors != 0 {
        unsafe { thir_free(mut_view(*thir_ptr)); }
        return 405;
    }

    // 3e. Capability check (`verify_mir_cap`).
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let cap_pl2 = mir_local_place(2u32);
    let cap_pl1 = mir_local_place(1u32);
    unsafe {
        (*st1_ptr).place = cap_pl2;
        (*st1_ptr).rvalue.kind = MIR_RVALUE_REF;
        (*st1_ptr).rvalue.borrow_kind = MIR_BORROW_MUT;
        (*st1_ptr).rvalue.place = cap_pl1;
    }
    verify_mir_cap(unsafe { view(*body) }, thir_ptr as *const Thir, mut_view(*sink));
    let rc_cap_mut = check_single_code(view(*sink), AX_VERIFY_TYPE_MISMATCH, 406);
    if rc_cap_mut != 0 {
        unsafe { thir_free(mut_view(*thir_ptr)); }
        return rc_cap_mut;
    }

    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let st_move = alloc_zero_stmt(mut_view(*arena));
    let st_use_borrow = alloc_zero_stmt(mut_view(*arena));
    let pl0_a = mir_local_place(0u32);
    let pl0_b = mir_local_place(0u32);
    unsafe {
        (*st1_ptr).rvalue.borrow_kind = MIR_BORROW_SHARED;
        (*st_move).place = pl0_a;
        (*st_move).rvalue.kind = MIR_RVALUE_USE;
        set_op_move_local(mut_view((*st_move).rvalue.use_op), 1u32);
        (*st_use_borrow).place = pl0_b;
        (*st_use_borrow).rvalue.kind = MIR_RVALUE_USE;
        set_op_copy_local(mut_view((*st_use_borrow).rvalue.use_op), 2u32);
        mir_bb_push_stmt(mut_view(*bb0), mut_view(*arena), view(*st_move));
        mir_bb_push_stmt(mut_view(*bb0), mut_view(*arena), view(*st_use_borrow));
    }
    verify_mir_cap(unsafe { view(*body) }, thir_ptr as *const Thir, mut_view(*sink));
    let rc_cap_uam = check_single_code(view(*sink), AX_VERIFY_USE_AFTER_MOVE, 407);
    unsafe {
        thir_free(mut_view(*thir_ptr));
    }
    if rc_cap_uam != 0 {
        return rc_cap_uam;
    }

    arena_reset(mut_view(*arena));
    0
}

// 4. Programmatic unit tests for recursive `verify_type_needs_drop` and `verify_mir_drop_flags`.
fn test_drop_flags_and_needs_drop(
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> i32 {
    let thir_ptr = alloc_init_thir(mut_view(*arena));
    let t_unit_v = unsafe { (*thir_ptr).interner.t_unit.v };
    let t_bool_v = unsafe { (*thir_ptr).interner.t_bool.v };
    let zsp = qa_zero_span();

    let drop_struct_def = hir_alloc_item(mut_view(*arena), HIR_ITEM_FN, qa_zero_span());
    let drop_struct_flds = arena_alloc_raw(mut_view(*arena), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
    unsafe {
        ax_type_reset(mut_view(*(*thir_ptr).interner.scratch), TY_STRUCT);
        (*(*thir_ptr).interner.scratch).def = drop_struct_def;
        (*(*thir_ptr).interner.scratch).fields = 0 as *mut TypeId;
        (*(*thir_ptr).interner.scratch).field_count = 0;
    }
    let sc_ptr = unsafe { (*thir_ptr).interner.scratch };
    let t_drop_struct = intern_type(unsafe { mut_view((*thir_ptr).interner) }, unsafe { view(*sc_ptr) });
    unsafe {
        (*typeid_at(drop_struct_flds, 0)).v = t_drop_struct.v;
    }

    let enum_vf_counts = arena_alloc_raw(mut_view(*arena), size_of<usize>(), align_of<usize>()) as *mut usize;
    let enum_vf_ptrs = arena_alloc_raw(mut_view(*arena), size_of<*mut TypeId>(), align_of<*mut TypeId>()) as *mut *mut TypeId;
    unsafe {
        *usize_at(enum_vf_counts, 0) = 1;
        *typeid_ptr_at(enum_vf_ptrs, 0) = drop_struct_flds;
        ax_type_reset(mut_view(*sc_ptr), TY_ENUM);
        (*sc_ptr).variant_count = 1;
        (*sc_ptr).variant_field_counts = enum_vf_counts;
        (*sc_ptr).variant_fields = enum_vf_ptrs;
    }
    let t_drop_enum = intern_type(unsafe { mut_view((*thir_ptr).interner) }, unsafe { view(*sc_ptr) });

    let clos_caps = arena_alloc_raw(mut_view(*arena), size_of<ClosureCapture>(), align_of<ClosureCapture>()) as *mut ClosureCapture;
    unsafe {
        let cap0 = capture_at(clos_caps, 0);
        (*cap0).sym = SymbolId { v: 1u32 };
        (*cap0).mode = CAP_MOVE;
        (*cap0).ty = TypeId { v: t_drop_enum.v };
        ax_type_reset(mut_view(*sc_ptr), TY_CLOSURE);
        (*sc_ptr).closure_id = 42u32;
        (*sc_ptr).captures = clos_caps;
        (*sc_ptr).capture_count = 1;
    }
    let t_drop_closure = intern_type(unsafe { mut_view((*thir_ptr).interner) }, unsafe { view(*sc_ptr) });

    let dbody = mir_body_new(mut_view(*arena));
    let _ = unsafe { mir_add_local(mut_view(*dbody), mut_view(*arena), TypeId { v: t_unit_v }, MIR_LOCAL_RETURN, true, StrId { v: 0u32 }, view(zsp)) };
    let _ = unsafe { mir_add_local(mut_view(*dbody), mut_view(*arena), TypeId { v: t_drop_closure.v }, MIR_LOCAL_USER, false, StrId { v: 0u32 }, view(zsp)) };
    let _ = unsafe { mir_add_local(mut_view(*dbody), mut_view(*arena), TypeId { v: t_bool_v }, MIR_LOCAL_TEMP, true, StrId { v: 0u32 }, view(zsp)) };
    unsafe {
        (*dbody).drop_flag_count = 1;
    }
    let dbb0_id = unsafe { mir_add_bb(mut_view(*dbody), mut_view(*arena), false) };
    let dbb0 = unsafe { mir_bb_at((*dbody).bbs, dbb0_id.v as usize) };

    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    unsafe {
        mir_term_zero(mut_view((*dbb0).terminator), MIR_TERM_RETURN);
        (*dbb0).has_terminator = true;
    }
    verify_mir_drop_flags(unsafe { view(*dbody) }, thir_ptr as *const Thir, mut_view(*sink), 0 as *const HirItem);
    let rc_df_uninit = check_single_code(view(*sink), AX_VERIFY_UNINIT_USE, 408);
    if rc_df_uninit != 0 {
        unsafe { thir_free(mut_view(*thir_ptr)); }
        return rc_df_uninit;
    }

    let st_df_init = alloc_zero_stmt(mut_view(*arena));
    let st_c_init = alloc_zero_stmt(mut_view(*arena));
    let dpl1_a = mir_local_place(1u32);
    let dpl1_b = mir_local_place(1u32);
    let dpl2 = mir_local_place(2u32);
    unsafe {
        (*st_df_init).place = dpl2;
        (*st_df_init).rvalue.kind = MIR_RVALUE_USE;
        set_op_const_int(mut_view((*st_df_init).rvalue.use_op), t_bool_v, 0u64);

        (*st_c_init).place = dpl1_a;
        (*st_c_init).rvalue.kind = MIR_RVALUE_USE;
        set_op_const_int(mut_view((*st_c_init).rvalue.use_op), 0u32, 0u64);

        mir_bb_push_stmt(mut_view(*dbb0), mut_view(*arena), view(*st_df_init));
        mir_bb_push_stmt(mut_view(*dbb0), mut_view(*arena), view(*st_c_init));
    }

    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    verify_mir_drop_flags(unsafe { view(*dbody) }, thir_ptr as *const Thir, mut_view(*sink), 0 as *const HirItem);
    if sink.errors != 0 {
        unsafe { thir_free(mut_view(*thir_ptr)); }
        return 409;
    }

    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    verify_mir_own(unsafe { view(*dbody) }, thir_ptr as *const Thir, mut_view(*sink), drop_struct_def as *const HirItem);
    let rc_clos_drop = check_single_code(view(*sink), AX_VERIFY_MISSING_DROP, 410);
    if rc_clos_drop != 0 {
        unsafe { thir_free(mut_view(*thir_ptr)); }
        return rc_clos_drop;
    }

    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    unsafe {
        mir_term_zero(mut_view((*dbb0).terminator), MIR_TERM_DROP);
        (*dbb0).terminator.drop_place = dpl1_b;
        (*dbb0).terminator.drop_target.v = 0u32;
        (*dbb0).terminator.drop_unwind.v = 0u32;
        (*dbb0).terminator.drop_flag = MIR_DROP_FLAG_NONE;
        (*dbb0).has_terminator = true;
    }
    verify_mir_drop_flags(unsafe { view(*dbody) }, thir_ptr as *const Thir, mut_view(*sink), 0 as *const HirItem);
    let rc_unelab = check_single_code(view(*sink), AX_VERIFY_MISSING_DROP, 411);
    if rc_unelab != 0 {
        unsafe { thir_free(mut_view(*thir_ptr)); }
        return rc_unelab;
    }

    // Real-body (`func != 0`) duplicated implicit drop -> AX_VERIFY_DOUBLE_DROP.
    let dpl1_c = mir_local_place(1u32);
    let dbb1_id = unsafe { mir_add_bb(mut_view(*dbody), mut_view(*arena), false) };
    let dbb2_id = unsafe { mir_add_bb(mut_view(*dbody), mut_view(*arena), false) };
    let dbb0_r = unsafe { mir_bb_at((*dbody).bbs, dbb0_id.v as usize) };
    let dbb1_r = unsafe { mir_bb_at((*dbody).bbs, dbb1_id.v as usize) };
    let dbb2_r = unsafe { mir_bb_at((*dbody).bbs, dbb2_id.v as usize) };
    unsafe {
        (*dbb0_r).terminator.drop_target.v = dbb1_id.v;
        (*dbb0_r).terminator.drop_unwind.v = dbb1_id.v;
        (*dbb0_r).terminator.drop_is_explicit = false;
        mir_term_zero(mut_view((*dbb1_r).terminator), MIR_TERM_DROP);
        (*dbb1_r).terminator.drop_place = dpl1_c;
        (*dbb1_r).terminator.drop_target.v = dbb2_id.v;
        (*dbb1_r).terminator.drop_unwind.v = dbb2_id.v;
        (*dbb1_r).terminator.drop_flag = MIR_DROP_FLAG_NONE;
        (*dbb1_r).terminator.drop_is_explicit = false;
        (*dbb1_r).has_terminator = true;
        mir_term_zero(mut_view((*dbb2_r).terminator), MIR_TERM_RETURN);
        (*dbb2_r).has_terminator = true;
    }
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    verify_mir_own(unsafe { view(*dbody) }, thir_ptr as *const Thir, mut_view(*sink), drop_struct_def as *const HirItem);
    let rc_dup_imp = check_single_code(view(*sink), AX_VERIFY_DOUBLE_DROP, 412);
    unsafe {
        thir_free(mut_view(*thir_ptr));
    }
    if rc_dup_imp != 0 {
        return rc_dup_imp;
    }

    arena_reset(mut_view(*arena));
    0
}

// 5. QA boundary seam tests: Downcast/Subslice projections, Enum aggregates, MIR_STMT_DROP
//    borrow invalidation in `verify_mir_cap`, and `stmt.place.drop_flag` validation in `verify_mir_drop_flags`.
fn test_qa_boundary_seams(
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> i32 {
    let thir_ptr = alloc_init_thir(mut_view(*arena));
    let t_unit_v = unsafe { (*thir_ptr).interner.t_unit.v };
    let t_bool_v = unsafe { (*thir_ptr).interner.t_bool.v };
    let t_i32_v = unsafe { (*thir_ptr).interner.t_i32.v };
    let zsp = qa_zero_span();

    let enum_flds = arena_alloc_raw(mut_view(*arena), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
    let enum_vf_counts = arena_alloc_raw(mut_view(*arena), size_of<usize>(), align_of<usize>()) as *mut usize;
    let enum_vf_ptrs = arena_alloc_raw(mut_view(*arena), size_of<*mut TypeId>(), align_of<*mut TypeId>()) as *mut *mut TypeId;
    let sc_ptr = unsafe { (*thir_ptr).interner.scratch };
    unsafe {
        (*typeid_at(enum_flds, 0)).v = t_i32_v;
        *usize_at(enum_vf_counts, 0) = 1;
        *typeid_ptr_at(enum_vf_ptrs, 0) = enum_flds;
        ax_type_reset(mut_view(*sc_ptr), TY_ENUM);
        (*sc_ptr).variant_count = 1;
        (*sc_ptr).variant_field_counts = enum_vf_counts;
        (*sc_ptr).variant_fields = enum_vf_ptrs;
    }
    let t_enum = intern_type(unsafe { mut_view((*thir_ptr).interner) }, unsafe { view(*sc_ptr) });

    let body = mir_body_new(mut_view(*arena));
    let _ = unsafe { mir_add_local(mut_view(*body), mut_view(*arena), TypeId { v: t_unit_v }, MIR_LOCAL_RETURN, true, StrId { v: 0u32 }, view(zsp)) };
    let _ = unsafe { mir_add_local(mut_view(*body), mut_view(*arena), TypeId { v: t_i32_v }, MIR_LOCAL_USER, false, StrId { v: 0u32 }, view(zsp)) };
    let _ = unsafe { mir_add_local(mut_view(*body), mut_view(*arena), TypeId { v: t_enum.v }, MIR_LOCAL_USER, false, StrId { v: 0u32 }, view(zsp)) };
    let bb0_id = unsafe { mir_add_bb(mut_view(*body), mut_view(*arena), false) };
    let bb0 = unsafe { mir_bb_at((*body).bbs, bb0_id.v as usize) };

    let st_init1 = alloc_zero_stmt(mut_view(*arena));
    let st_test = alloc_zero_stmt(mut_view(*arena));
    let pl1 = mir_local_place(1u32);
    let base_pl1 = mir_local_place(1u32);
    let base_pl2 = mir_local_place(2u32);
    unsafe {
        (*st_init1).place = pl1;
        (*st_init1).rvalue.kind = MIR_RVALUE_USE;
        set_op_const_int(mut_view((*st_init1).rvalue.use_op), t_i32_v, 1u64);
        mir_bb_push_stmt(mut_view(*bb0), mut_view(*arena), view(*st_init1));
        mir_bb_push_stmt(mut_view(*bb0), mut_view(*arena), view(*st_test));
        mir_term_zero(mut_view((*bb0).terminator), MIR_TERM_RETURN);
        (*bb0).has_terminator = true;
    }
    let st1_ptr = unsafe { mir_stmt_at((*bb0).stmts, 1) };

    // 5a. Subslice projection with out-of-bounds `to_local` (`_77`) -> AX_VERIFY_UNKNOWN_LOCAL.
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let subslice_oob = MirProjection {
        kind: MIR_PROJ_SUB_SLICE,
        field_idx: 0u32,
        index_local: MirLocalId { v: 0u32 },
        from_local: MirLocalId { v: 1u32 },
        to_local: MirLocalId { v: 77u32 },
        has_from: true,
        has_to: true,
        variant_idx: 0u32,
    };
    let mut sub_place = mir_local_place(1u32);
    mir_place_append_proj(mut_view(*arena), view(base_pl1), view(subslice_oob), mut_view(sub_place));
    unsafe {
        (*st1_ptr).place = sub_place;
        (*st1_ptr).rvalue.kind = MIR_RVALUE_USE;
        set_op_const_int(mut_view((*st1_ptr).rvalue.use_op), t_i32_v, 0u64);
    }
    verify_mir(unsafe { view(*body) }, thir_ptr as *const Thir, mut_view(*sink), 0 as *const HirItem);
    let rc_sub_oob = check_single_code(view(*sink), AX_VERIFY_UNKNOWN_LOCAL, 501);
    if rc_sub_oob != 0 {
        unsafe { thir_free(mut_view(*thir_ptr)); }
        return rc_sub_oob;
    }

    // 5b. Downcast on non-enum (`_1` of type `i32`) -> AX_VERIFY_TYPE_MISMATCH.
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let dc_proj = MirProjection {
        kind: MIR_PROJ_DOWNCAST,
        field_idx: 0u32,
        index_local: MirLocalId { v: 0u32 },
        from_local: MirLocalId { v: 0u32 },
        to_local: MirLocalId { v: 0u32 },
        has_from: false,
        has_to: false,
        variant_idx: 0u32,
    };
    let mut dc_non_enum = mir_local_place(1u32);
    mir_place_append_proj(mut_view(*arena), view(base_pl1), view(dc_proj), mut_view(dc_non_enum));
    unsafe {
        (*st1_ptr).place = dc_non_enum;
    }
    verify_mir(unsafe { view(*body) }, thir_ptr as *const Thir, mut_view(*sink), 0 as *const HirItem);
    let rc_dc_ne = check_single_code(view(*sink), AX_VERIFY_TYPE_MISMATCH, 502);
    if rc_dc_ne != 0 {
        unsafe { thir_free(mut_view(*thir_ptr)); }
        return rc_dc_ne;
    }

    // 5c. Downcast on enum `_2` with out-of-bounds `variant_idx = 3` -> AX_VERIFY_TYPE_MISMATCH.
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let dc_oob_var = MirProjection {
        kind: MIR_PROJ_DOWNCAST,
        field_idx: 0u32,
        index_local: MirLocalId { v: 0u32 },
        from_local: MirLocalId { v: 0u32 },
        to_local: MirLocalId { v: 0u32 },
        has_from: false,
        has_to: false,
        variant_idx: 3u32,
    };
    let mut dc_enum_oob = mir_local_place(2u32);
    mir_place_append_proj(mut_view(*arena), view(base_pl2), view(dc_oob_var), mut_view(dc_enum_oob));
    unsafe {
        (*st1_ptr).place = dc_enum_oob;
    }
    verify_mir(unsafe { view(*body) }, thir_ptr as *const Thir, mut_view(*sink), 0 as *const HirItem);
    let rc_dc_v = check_single_code(view(*sink), AX_VERIFY_TYPE_MISMATCH, 503);
    if rc_dc_v != 0 {
        unsafe { thir_free(mut_view(*thir_ptr)); }
        return rc_dc_v;
    }

    // 5d. Downcast + Field on enum `_2` with out-of-bounds variant field index (`field_idx = 2`) -> AX_VERIFY_TYPE_MISMATCH.
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let mut dc_valid = mir_local_place(2u32);
    mir_place_append_proj(mut_view(*arena), view(base_pl2), view(dc_proj), mut_view(dc_valid));
    let fld_oob_proj = MirProjection {
        kind: MIR_PROJ_FIELD,
        field_idx: 2u32,
        index_local: MirLocalId { v: 0u32 },
        from_local: MirLocalId { v: 0u32 },
        to_local: MirLocalId { v: 0u32 },
        has_from: false,
        has_to: false,
        variant_idx: 0u32,
    };
    let mut dc_fld_oob = mir_local_place(2u32);
    mir_place_append_proj(mut_view(*arena), view(dc_valid), view(fld_oob_proj), mut_view(dc_fld_oob));
    unsafe {
        (*st1_ptr).place = dc_fld_oob;
    }
    verify_mir(unsafe { view(*body) }, thir_ptr as *const Thir, mut_view(*sink), 0 as *const HirItem);
    let rc_dc_f = check_single_code(view(*sink), AX_VERIFY_TYPE_MISMATCH, 504);
    if rc_dc_f != 0 {
        unsafe { thir_free(mut_view(*thir_ptr)); }
        return rc_dc_f;
    }

    // 5e. Enum aggregate with wrong variant field count (`0` operands instead of `1`) -> AX_VERIFY_TYPE_MISMATCH.
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let pl2_agg = mir_local_place(2u32);
    unsafe {
        (*st1_ptr).place = pl2_agg;
        (*st1_ptr).rvalue.kind = MIR_RVALUE_AGGREGATE;
        (*st1_ptr).rvalue.variant_idx = 0u32;
        (*st1_ptr).rvalue.operands = 0 as *mut MirOperand;
        (*st1_ptr).rvalue.operand_count = 0;
    }
    verify_mir(unsafe { view(*body) }, thir_ptr as *const Thir, mut_view(*sink), 0 as *const HirItem);
    let rc_enum_agg = check_single_code(view(*sink), AX_VERIFY_TYPE_MISMATCH, 505);
    if rc_enum_agg != 0 {
        unsafe { thir_free(mut_view(*thir_ptr)); }
        return rc_enum_agg;
    }

    // 5f. `verify_mir_cap`: `MIR_STMT_DROP` of borrowed local `_1` followed by use of borrow `_2` -> AX_VERIFY_USE_AFTER_MOVE.
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let st_drop1 = alloc_zero_stmt(mut_view(*arena));
    let st_read2 = alloc_zero_stmt(mut_view(*arena));
    let pl2_ref = mir_local_place(2u32);
    let pl1_ref = mir_local_place(1u32);
    let pl1_drop = mir_local_place(1u32);
    let pl0_dst = mir_local_place(0u32);
    unsafe {
        (*st1_ptr).place = pl2_ref;
        (*st1_ptr).rvalue.kind = MIR_RVALUE_REF;
        (*st1_ptr).rvalue.borrow_kind = MIR_BORROW_SHARED;
        (*st1_ptr).rvalue.place = pl1_ref;

        mir_stmt_zero(mut_view(*st_drop1), MIR_STMT_DROP);
        (*st_drop1).place = pl1_drop;

        (*st_read2).place = pl0_dst;
        (*st_read2).rvalue.kind = MIR_RVALUE_USE;
        set_op_copy_local(mut_view((*st_read2).rvalue.use_op), 2u32);

        mir_bb_push_stmt(mut_view(*bb0), mut_view(*arena), view(*st_drop1));
        mir_bb_push_stmt(mut_view(*bb0), mut_view(*arena), view(*st_read2));
    }
    verify_mir_cap(unsafe { view(*body) }, thir_ptr as *const Thir, mut_view(*sink));
    let rc_cap_drop = check_single_code(view(*sink), AX_VERIFY_USE_AFTER_MOVE, 506);
    if rc_cap_drop != 0 {
        unsafe { thir_free(mut_view(*thir_ptr)); }
        return rc_cap_drop;
    }

    // 5g. `verify_mir_drop_flags`: `drop_flag_count > local_count` -> AX_VERIFY_UNKNOWN_LOCAL;
    //     and `stmt.place.drop_flag` pointing to non-bool local `_1` (`i32`) -> AX_VERIFY_TYPE_MISMATCH.
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    unsafe {
        (*body).drop_flag_count = 99;
    }
    verify_mir_drop_flags(unsafe { view(*body) }, thir_ptr as *const Thir, mut_view(*sink), 0 as *const HirItem);
    let rc_df_cnt = check_single_code(view(*sink), AX_VERIFY_UNKNOWN_LOCAL, 507);
    if rc_df_cnt != 0 {
        unsafe { thir_free(mut_view(*thir_ptr)); }
        return rc_df_cnt;
    }

    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    unsafe {
        (*body).drop_flag_count = 0;
        (*st1_ptr).place.drop_flag = 1u32;
    }
    verify_mir_drop_flags(unsafe { view(*body) }, thir_ptr as *const Thir, mut_view(*sink), 0 as *const HirItem);
    let rc_df_ty = check_single_code(view(*sink), AX_VERIFY_TYPE_MISMATCH, 508);
    unsafe {
        let _ = t_bool_v;
        thir_free(mut_view(*thir_ptr));
    }
    if rc_df_ty != 0 {
        return rc_df_ty;
    }

    arena_reset(mut_view(*arena));
    0
}

pub fn main() -> i32 {
    let mut arena = arena_new();
    let sink_ptr = arena_alloc_raw(mut_view(arena), size_of<DiagSink>(), align_of<DiagSink>()) as *mut DiagSink;
    let mut scratch = arena_new();
    unsafe {
        diag_sink_init(mut_view(*sink_ptr));
    }

    let rc1 = test_mir_fixtures(mut_view(scratch), unsafe { mut_view(*sink_ptr) });
    if rc1 != 0 {
        return rc1;
    }

    let rc2 = test_cfg_and_rvalue_units(mut_view(scratch), unsafe { mut_view(*sink_ptr) });
    if rc2 != 0 {
        return rc2;
    }

    let rc3 = test_projections_aggregates_and_cap(mut_view(scratch), unsafe { mut_view(*sink_ptr) });
    if rc3 != 0 {
        return rc3;
    }

    let rc4 = test_drop_flags_and_needs_drop(mut_view(scratch), unsafe { mut_view(*sink_ptr) });
    if rc4 != 0 {
        return rc4;
    }

    let rc5 = test_qa_boundary_seams(mut_view(scratch), unsafe { mut_view(*sink_ptr) });
    if rc5 != 0 {
        return rc5;
    }

    unsafe {
        diag_sink_free(mut_view(*sink_ptr));
    }
    arena_destroy(mut_view(scratch));
    arena_destroy(mut_view(arena));
    print("OK verify mir (21 fixtures + unit checks)\n");
    0
}
