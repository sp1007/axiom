, 48u8, 46u8, 46u8, 52u8, 49u8, 49u8, 93u8, 32u8, 78u8, 76u8, 10u8, 69u8, 111u8, 102u8, 32u8, 91u8, 52u8, 49u8, 50u8, 46u8, 46u8, 52u8, 49u8, 50u8, 93u8, 32u8, 78u8, 76u8, 10u8, 76u8, 105u8, 110u8, 101u8, 67u8, 111u8, 109u8, 109u8, 101u8, 110u8, 116u8, 32u8, 91u8, 48u8, 46u8, 46u8, 49u8, 55u8, 93u8, 10u8, 68u8, 111u8, 99u8, 67u8, 111u8, 109u8, 109u8, 101u8, 110u8, 116u8, 32u8, 91u8, 49u8, 56u8, 46u8, 46u8, 51u8, 51u8, 93u8, 10u8, 66u8, 108u8, 111u8, 99u8, 107u8, 67u8, 111u8, 109u8, 109u8, 101u8, 110u8, 116u8, 32u8, 91u8, 51u8, 52u8, 46u8, 46u8, 54u8, 54u8, 93u8, 10u8];
const DIFF_BLOB_OFF: [3]u16 = [0u16, 412u16, 2016u16];

fn get_diff_sv(a: mut_view<Arena>, idx: usize) -> StrView {
    let start = DIFF_BLOB_OFF[idx] as usize;
    let end = DIFF_BLOB_OFF[idx + 1] as usize;
    let n = end - start;
    let dst = arena_alloc_raw(a, n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = DIFF_BLOB_DATA[start + i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn qa_sv_eq(a: StrView, b: StrView) -> bool {
    if a.len != b.len { return false; }
    test_bytes_eq(a.ptr, b.ptr, a.len)
}

pub fn main() -> i32 {
    let mut scratch = arena_new();
    let src = get_diff_sv(mut_view(scratch), 0);
    let expected_sv = get_diff_sv(mut_view(scratch), 1);

    let mut sink = diag_sink_new();
    let mut interner = interner_new();
    let mut res: LexResult = LexResult {
        arena: arena_new(),
        tokens: 0 as *mut Token,
        token_count: 0,
        token_cap: 0,
        comments: 0 as *mut Comment,
        comment_count: 0,
        comment_cap: 0,
    };

    ax_lex_into(FileId { v: 1u32 }, src, mut_view(sink), mut_view(interner), mut_view(res));
    if sink.errors != 0 { return 1; }

    let mut out = diag_buf_new();
    ax_lex_render_tokens(view(res), view(interner), mut_view(out));
    let actual_sv = diag_buf_as_str_view(view(out));
    if !qa_sv_eq(actual_sv, expected_sv) { return 2; }

    diag_buf_free(mut_view(out));
    ax_lex_result_free(mut_view(res));
    interner_free(mut_view(interner));
    diag_sink_free(mut_view(sink));
    arena_destroy(mut_view(scratch));

    print("OK Lex Differential\n");
    0
}
