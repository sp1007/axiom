const BLOB_DATA: [467]u8 = [112u8, 111u8, 115u8, 46u8, 97u8, 120u8, 49u8, 56u8, 52u8, 52u8, 54u8, 55u8, 52u8, 52u8, 48u8, 55u8, 51u8, 55u8, 48u8, 57u8, 53u8, 53u8, 49u8, 54u8, 49u8, 53u8, 117u8, 54u8, 52u8, 49u8, 56u8, 52u8, 52u8, 54u8, 55u8, 52u8, 52u8, 48u8, 55u8, 51u8, 55u8, 48u8, 57u8, 53u8, 53u8, 49u8, 54u8, 49u8, 53u8, 49u8, 56u8, 95u8, 52u8, 52u8, 54u8, 95u8, 55u8, 52u8, 52u8, 95u8, 48u8, 55u8, 51u8, 95u8, 55u8, 48u8, 57u8, 95u8, 53u8, 53u8, 49u8, 95u8, 54u8, 49u8, 53u8, 117u8, 54u8, 52u8, 48u8, 120u8, 70u8, 70u8, 70u8, 70u8, 95u8, 70u8, 70u8, 70u8, 70u8, 95u8, 70u8, 70u8, 70u8, 70u8, 95u8, 70u8, 70u8, 70u8, 70u8, 117u8, 54u8, 52u8, 48u8, 111u8, 49u8, 95u8, 55u8, 55u8, 55u8, 95u8, 55u8, 55u8, 55u8, 95u8, 55u8, 55u8, 55u8, 95u8, 55u8, 55u8, 55u8, 95u8, 55u8, 55u8, 55u8, 95u8, 55u8, 55u8, 55u8, 95u8, 55u8, 55u8, 55u8, 117u8, 54u8, 52u8, 48u8, 98u8, 49u8, 49u8, 49u8, 49u8, 95u8, 49u8, 49u8, 49u8, 49u8, 95u8, 49u8, 49u8, 49u8, 49u8, 95u8, 49u8, 49u8, 49u8, 49u8, 95u8, 49u8, 49u8, 49u8, 49u8, 95u8, 49u8, 49u8, 49u8, 49u8, 95u8, 49u8, 49u8, 49u8, 49u8, 95u8, 49u8, 49u8, 49u8, 49u8, 95u8, 49u8, 49u8, 49u8, 49u8, 95u8, 49u8, 49u8, 49u8, 49u8, 95u8, 49u8, 49u8, 49u8, 49u8, 95u8, 49u8, 49u8, 49u8, 49u8, 95u8, 49u8, 49u8, 49u8, 49u8, 95u8, 49u8, 49u8, 49u8, 49u8, 95u8, 49u8, 49u8, 49u8, 49u8, 95u8, 49u8, 49u8, 49u8, 49u8, 117u8, 54u8, 52u8, 57u8, 50u8, 50u8, 51u8, 51u8, 55u8, 50u8, 48u8, 51u8, 54u8, 56u8, 53u8, 52u8, 55u8, 55u8, 53u8, 56u8, 48u8, 56u8, 117u8, 54u8, 52u8, 49u8, 56u8, 52u8, 52u8, 54u8, 55u8, 52u8, 52u8, 48u8, 55u8, 51u8, 55u8, 48u8, 57u8, 53u8, 53u8, 49u8, 54u8, 49u8, 52u8, 117u8, 54u8, 52u8, 110u8, 101u8, 103u8, 46u8, 97u8, 120u8, 49u8, 56u8, 52u8, 52u8, 54u8, 55u8, 52u8, 52u8, 48u8, 55u8, 51u8, 55u8, 48u8, 57u8, 53u8, 53u8, 49u8, 54u8, 49u8, 54u8, 49u8, 56u8, 52u8, 52u8, 54u8, 55u8, 52u8, 52u8, 48u8, 55u8, 51u8, 55u8, 48u8, 57u8, 53u8, 53u8, 49u8, 54u8, 49u8, 54u8, 117u8, 54u8, 52u8, 49u8, 56u8, 52u8, 52u8, 54u8, 55u8, 52u8, 52u8, 48u8, 55u8, 51u8, 55u8, 48u8, 57u8, 53u8, 53u8, 49u8, 54u8, 49u8, 53u8, 48u8, 48u8, 120u8, 49u8, 95u8, 48u8, 48u8, 48u8, 48u8, 95u8, 48u8, 48u8, 48u8, 48u8, 95u8, 48u8, 48u8, 48u8, 48u8, 95u8, 48u8, 48u8, 48u8, 48u8, 117u8, 54u8, 52u8, 48u8, 111u8, 50u8, 95u8, 48u8, 48u8, 48u8, 95u8, 48u8, 48u8, 48u8, 95u8, 48u8, 48u8, 48u8, 95u8, 48u8, 48u8, 48u8, 95u8, 48u8, 48u8, 48u8, 95u8, 48u8, 48u8, 48u8, 95u8, 48u8, 48u8, 48u8, 48u8, 98u8, 49u8, 95u8, 48u8, 48u8, 48u8, 48u8, 48u8, 48u8, 48u8, 48u8, 95u8, 48u8, 48u8, 48u8, 48u8, 48u8, 48u8, 48u8, 48u8, 95u8, 48u8, 48u8, 48u8, 48u8, 48u8, 48u8, 48u8, 48u8, 95u8, 48u8, 48u8, 48u8, 48u8, 48u8, 48u8, 48u8, 48u8, 95u8, 48u8, 48u8, 48u8, 48u8, 48u8, 48u8, 48u8, 48u8, 95u8, 48u8, 48u8, 48u8, 48u8, 48u8, 48u8, 48u8, 48u8, 95u8, 48u8, 48u8, 48u8, 48u8, 48u8, 48u8, 48u8, 48u8, 95u8, 48u8, 48u8, 48u8, 48u8, 48u8, 48u8, 48u8, 48u8];
const BLOB_OFF: [17]u16 = [0u16, 6u16, 29u16, 49u16, 78u16, 102u16, 136u16, 220u16, 242u16, 265u16, 271u16, 291u16, 314u16, 335u16, 361u16, 392u16, 467u16];

fn get_sv(a: mut_view<Arena>, idx: usize) -> StrView {
    let start = BLOB_OFF[idx] as usize;
    let end = BLOB_OFF[idx + 1] as usize;
    let n = end - start;
    let dst = arena_alloc_raw(a, n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = BLOB_DATA[start + i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

unsafe fn diag_at(diags: *mut Diagnostic, idx: usize) -> *mut Diagnostic {
    diags + idx
}

fn write_sv_stdout(sv: StrView) {
    if sv.len > 0 {
        let _w = unsafe { write(stdio(1u32), sv.ptr, sv.len) };
    }
}

fn check_pos_u64(
    scratch: mut_view<Arena>,
    blob_idx: usize,
    expected_val: u64,
    expected_suf: u8,
    expected_end: u32
) -> bool {
    let sv = get_sv(scratch, blob_idx);
    let mut sink = diag_sink_new();
    let mut interner = interner_new();
    let mut res = LexResult {
        arena: arena_new(),
        tokens: 0 as *mut Token,
        token_count: 0,
        token_cap: 0,
        comments: 0 as *mut Comment,
        comment_count: 0,
        comment_cap: 0,
    };
    ax_lex_into(FileId { v: 1u32 }, sv, mut_view(sink), mut_view(interner), mut_view(res));
    let mut ok = true;
    if sink.errors != 0 || sink.warnings != 0 {
        ok = false;
    } else if res.token_count != 2 || res.comment_count != 0 {
        ok = false;
    } else {
        let t0 = lex_token_get(view(res), 0);
        let t1 = lex_token_get(view(res), 1);
        if t0.kind != TOK_INT || t0.int_val != expected_val || t0.suffix != expected_suf {
            ok = false;
        }
        if (t0.flags & TOK_FLAG_ERROR) != 0u16 {
            ok = false;
        }
        if t0.span.file.v != 1u32 || t0.span.start != 0u32 || t0.span.end != expected_end {
            ok = false;
        }
        if t1.kind != TOK_EOF || t1.span.start != expected_end || t1.span.end != expected_end {
            ok = false;
        }
    }
    ax_lex_result_free(mut_view(res));
    interner_free(mut_view(interner));
    diag_sink_free(mut_view(sink));
    ok
}

fn check_overflow(
    scratch: mut_view<Arena>,
    blob_idx: usize,
    expected_suf: u8,
    expected_end: u32
) -> bool {
    let sv = get_sv(scratch, blob_idx);
    let mut sink = diag_sink_new();
    let mut interner = interner_new();
    let mut res = LexResult {
        arena: arena_new(),
        tokens: 0 as *mut Token,
        token_count: 0,
        token_cap: 0,
        comments: 0 as *mut Comment,
        comment_count: 0,
        comment_cap: 0,
    };
    ax_lex_into(FileId { v: 1u32 }, sv, mut_view(sink), mut_view(interner), mut_view(res));
    let mut ok = true;
    if sink.errors != 1 {
        ok = false;
    } else {
        let d0 = unsafe { *(diag_at(sink.diags, 0)) };
        if d0.code.v != AX_LEX_INT_OVERFLOW {
            ok = false;
        }
        if d0.primary.file.v != 1u32 || d0.primary.start != 0u32 || d0.primary.end != expected_end {
            ok = false;
        }
    }
    if res.token_count != 2 {
        ok = false;
    } else {
        let t0 = lex_token_get(view(res), 0);
        let t1 = lex_token_get(view(res), 1);
        if t0.kind != TOK_INT || (t0.flags & TOK_FLAG_ERROR) == 0u16 || t0.int_val != 0u64 || t0.suffix != expected_suf {
            ok = false;
        }
        if t0.span.start != 0u32 || t0.span.end != expected_end {
            ok = false;
        }
        if t1.kind != TOK_EOF || t1.span.start != expected_end || t1.span.end != expected_end {
            ok = false;
        }
    }
    ax_lex_result_free(mut_view(res));
    interner_free(mut_view(interner));
    diag_sink_free(mut_view(sink));
    ok
}

pub fn main() -> i32 {
    let mut scratch = arena_new();
    let u64_max: u64 = 0xFFFFFFFFFFFFFFFFu64;

    if !check_pos_u64(mut_view(scratch), 1, u64_max, SUFFIX_U64, 23u32) { return 1; }
    if !check_pos_u64(mut_view(scratch), 2, u64_max, SUFFIX_NONE, 20u32) { return 2; }
    if !check_pos_u64(mut_view(scratch), 3, u64_max, SUFFIX_U64, 29u32) { return 3; }
    if !check_pos_u64(mut_view(scratch), 4, u64_max, SUFFIX_U64, 24u32) { return 4; }
    if !check_pos_u64(mut_view(scratch), 5, u64_max, SUFFIX_U64, 34u32) { return 5; }
    if !check_pos_u64(mut_view(scratch), 6, u64_max, SUFFIX_U64, 84u32) { return 6; }
    if !check_pos_u64(mut_view(scratch), 7, 0x8000000000000000u64, SUFFIX_U64, 22u32) { return 7; }
    if !check_pos_u64(mut_view(scratch), 8, 0xFFFFFFFFFFFFFFFEu64, SUFFIX_U64, 23u32) { return 8; }

    if !check_overflow(mut_view(scratch), 10, SUFFIX_NONE, 20u32) { return 10; }
    if !check_overflow(mut_view(scratch), 11, SUFFIX_U64, 23u32) { return 11; }
    if !check_overflow(mut_view(scratch), 12, SUFFIX_NONE, 21u32) { return 12; }
    if !check_overflow(mut_view(scratch), 13, SUFFIX_U64, 26u32) { return 13; }
    if !check_overflow(mut_view(scratch), 14, SUFFIX_NONE, 31u32) { return 14; }
    if !check_overflow(mut_view(scratch), 15, SUFFIX_NONE, 75u32) { return 15; }

    let mut sess_pos = session_new();
    session_init(mut_view(sess_pos));
    let mut pos_tok_buf = diag_buf_new();
    let mut pos_diag_buf = diag_buf_new();
    let pos_errs = session_lex_and_render_human(
        mut_view(sess_pos),
        get_sv(mut_view(scratch), 0),
        get_sv(mut_view(scratch), 1),
        mut_view(pos_tok_buf),
        mut_view(pos_diag_buf)
    );
    if pos_errs != 0 || pos_diag_buf.len != 0 {
        return 20;
    }
    write_sv_stdout(diag_buf_as_str_view(view(pos_tok_buf)));
    diag_buf_free(mut_view(pos_tok_buf));
    diag_buf_free(mut_view(pos_diag_buf));
    session_free(mut_view(sess_pos));

    let mut sess_neg = session_new();
    session_init(mut_view(sess_neg));
    let mut neg_tok_buf = diag_buf_new();
    let mut neg_diag_buf = diag_buf_new();
    let neg_errs = session_lex_and_render_human(
        mut_view(sess_neg),
        get_sv(mut_view(scratch), 9),
        get_sv(mut_view(scratch), 10),
        mut_view(neg_tok_buf),
        mut_view(neg_diag_buf)
    );
    if neg_errs != 1 {
        return 21;
    }
    write_sv_stdout(diag_buf_as_str_view(view(neg_tok_buf)));
    write_sv_stdout(diag_buf_as_str_view(view(neg_diag_buf)));
    diag_buf_free(mut_view(neg_tok_buf));
    diag_buf_free(mut_view(neg_diag_buf));
    session_free(mut_view(sess_neg));

    arena_destroy(mut_view(scratch));
    0
}
