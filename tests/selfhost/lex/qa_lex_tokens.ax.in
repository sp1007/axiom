@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic fn wrapping_add_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn rotate_left_u64(x: u64, n: u32) -> u64 { 0 }

fn test_bytes_eq(a: *const u8, b: *const u8, len: usize) -> bool {
    let mut i: usize = 0;
    while i < len {
        let ba: u8 = unsafe { *(a + i) };
        let bb: u8 = unsafe { *(b + i) };
        if ba != bb { return false; }
        i = i + 1;
    }
    true
}

unsafe fn test_diag_ptr(diags: *mut Diagnostic, idx: usize) -> *mut Diagnostic {
    diags + idx
}

const TEST_BLOB_DATA: [289]u8 = [47u8, 47u8, 32u8, 108u8, 105u8, 110u8, 101u8, 10u8, 47u8, 47u8, 47u8, 32u8, 100u8, 111u8, 99u8, 10u8, 47u8, 47u8, 47u8, 47u8, 32u8, 108u8, 105u8, 110u8, 101u8, 50u8, 10u8, 47u8, 42u8, 32u8, 98u8, 108u8, 111u8, 99u8, 107u8, 32u8, 47u8, 42u8, 32u8, 105u8, 110u8, 110u8, 101u8, 114u8, 32u8, 42u8, 47u8, 32u8, 101u8, 110u8, 100u8, 32u8, 42u8, 47u8, 10u8, 102u8, 110u8, 32u8, 108u8, 101u8, 116u8, 32u8, 109u8, 117u8, 116u8, 95u8, 118u8, 105u8, 101u8, 119u8, 32u8, 83u8, 101u8, 108u8, 102u8, 32u8, 95u8, 32u8, 102u8, 111u8, 111u8, 32u8, 39u8, 108u8, 98u8, 108u8, 32u8, 48u8, 120u8, 70u8, 95u8, 70u8, 117u8, 54u8, 52u8, 32u8, 49u8, 56u8, 52u8, 52u8, 54u8, 55u8, 52u8, 52u8, 48u8, 55u8, 51u8, 55u8, 48u8, 57u8, 53u8, 53u8, 49u8, 54u8, 49u8, 53u8, 32u8, 51u8, 46u8, 49u8, 52u8, 102u8, 51u8, 50u8, 32u8, 52u8, 50u8, 102u8, 54u8, 52u8, 32u8, 98u8, 39u8, 65u8, 39u8, 32u8, 39u8, 122u8, 39u8, 32u8, 34u8, 104u8, 105u8, 92u8, 110u8, 34u8, 32u8, 114u8, 34u8, 97u8, 92u8, 110u8, 98u8, 34u8, 32u8, 98u8, 34u8, 120u8, 121u8, 34u8, 32u8, 46u8, 46u8, 61u8, 32u8, 45u8, 62u8, 32u8, 61u8, 62u8, 32u8, 60u8, 60u8, 61u8, 32u8, 62u8, 62u8, 61u8, 102u8, 111u8, 111u8, 108u8, 98u8, 108u8, 255u8, 254u8, 36u8, 206u8, 187u8, 47u8, 42u8, 32u8, 117u8, 110u8, 99u8, 108u8, 111u8, 115u8, 101u8, 100u8, 34u8, 117u8, 110u8, 99u8, 108u8, 111u8, 115u8, 101u8, 100u8, 39u8, 49u8, 39u8, 39u8, 39u8, 97u8, 98u8, 39u8, 34u8, 92u8, 113u8, 34u8, 34u8, 92u8, 120u8, 56u8, 48u8, 34u8, 34u8, 92u8, 117u8, 123u8, 68u8, 56u8, 48u8, 48u8, 125u8, 34u8, 98u8, 34u8, 206u8, 187u8, 34u8, 48u8, 120u8, 48u8, 88u8, 49u8, 48u8, 98u8, 49u8, 48u8, 50u8, 49u8, 50u8, 51u8, 95u8, 49u8, 50u8, 51u8, 98u8, 97u8, 100u8, 49u8, 56u8, 52u8, 52u8, 54u8, 55u8, 52u8, 52u8, 48u8, 55u8, 51u8, 55u8, 48u8, 57u8, 53u8, 53u8, 49u8, 54u8, 49u8, 54u8, 46u8, 46u8, 46u8, 58u8, 58u8, 58u8, 61u8];
const TEST_BLOB_OFF: [25]u16 = [0u16, 178u16, 181u16, 184u16, 186u16, 187u16, 189u16, 200u16, 209u16, 211u16, 213u16, 217u16, 221u16, 227u16, 237u16, 242u16, 244u16, 247u16, 252u16, 256u16, 262u16, 282u16, 285u16, 287u16, 289u16];

fn get_test_sv(a: mut_view<Arena>, idx: usize) -> StrView {
    let start = TEST_BLOB_OFF[idx] as usize;
    let end = TEST_BLOB_OFF[idx + 1] as usize;
    let n = end - start;
    let dst = arena_alloc_raw(a, n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = TEST_BLOB_DATA[start + i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn qa_sv_eq(a: StrView, b: StrView) -> bool {
    if a.len != b.len { return false; }
    test_bytes_eq(a.ptr, b.ptr, a.len)
}

fn check_single_diag(scratch: mut_view<Arena>, blob_idx: usize, expected_code: u32) -> bool {
    let sv = get_test_sv(scratch, blob_idx);
    let mut sink = diag_sink_new();
    let mut interner = interner_new();
    let mut res: LexResult = LexResult {
        arena: arena_new(),
        tokens: 0 as *mut Token,
        token_count: 0,
        token_cap: 0,
        comments: 0 as *mut Comment,
        comment_count: 0,
        comment_cap: 0,
    };
    ax_lex_into(FileId { v: 1u32 }, sv, mut_view(sink), mut_view(interner), mut_view(res));
    let mut ok = false;
    if sink.errors >= 1 {
        let d0 = unsafe { *(test_diag_ptr(sink.diags, 0)) };
        if d0.code.v == expected_code {
            ok = true;
        }
    }
    ax_lex_result_free(mut_view(res));
    interner_free(mut_view(interner));
    diag_sink_free(mut_view(sink));
    ok
}

pub fn main() -> i32 {
    let mut scratch = arena_new();
    let mut sink = diag_sink_new();
    let mut interner = interner_new();
    let mut res: LexResult = LexResult {
        arena: arena_new(),
        tokens: 0 as *mut Token,
        token_count: 0,
        token_cap: 0,
        comments: 0 as *mut Comment,
        comment_count: 0,
        comment_cap: 0,
    };

    let src = get_test_sv(mut_view(scratch), 0);
    ax_lex_into(FileId { v: 1u32 }, src, mut_view(sink), mut_view(interner), mut_view(res));
    if sink.errors != 0 { return 1; }
    if res.comment_count != 4 { return 2; }
    if lex_comment_get(view(res), 0).kind != COMMENT_LINE { return 3; }
    if lex_comment_get(view(res), 1).kind != COMMENT_DOC { return 4; }
    if lex_comment_get(view(res), 2).kind != COMMENT_LINE { return 5; }
    if lex_comment_get(view(res), 3).kind != COMMENT_BLOCK { return 6; }

    let t0 = lex_token_get(view(res), 0);
    if t0.kind != TOK_KW_FN || (t0.flags & TOK_FLAG_NL_BEFORE) == 0u16 { return 7; }
    if lex_token_get(view(res), 1).kind != TOK_KW_LET { return 8; }
    if lex_token_get(view(res), 2).kind != TOK_KW_MUT_VIEW { return 9; }
    if lex_token_get(view(res), 3).kind != TOK_KW_SELF_TYPE { return 10; }
    if lex_token_get(view(res), 4).kind != TOK_UNDERSCORE { return 11; }

    let t5 = lex_token_get(view(res), 5);
    if t5.kind != TOK_IDENT || !qa_sv_eq(interner_get(view(interner), t5.ident_val), get_test_sv(mut_view(scratch), 1)) { return 12; }

    let t6 = lex_token_get(view(res), 6);
    if t6.kind != TOK_LABEL || !qa_sv_eq(interner_get(view(interner), t6.ident_val), get_test_sv(mut_view(scratch), 2)) { return 13; }

    let t7 = lex_token_get(view(res), 7);
    if t7.kind != TOK_INT || t7.int_val != 255u64 || t7.suffix != SUFFIX_U64 { return 14; }

    let t8 = lex_token_get(view(res), 8);
    if t8.kind != TOK_INT || t8.int_val != 18446744073709551615u64 || t8.suffix != SUFFIX_NONE { return 15; }

    let t9 = lex_token_get(view(res), 9);
    if t9.kind != TOK_FLOAT || t9.suffix != SUFFIX_F32 { return 16; }

    let t10 = lex_token_get(view(res), 10);
    if t10.kind != TOK_INT || t10.int_val != 42u64 || t10.suffix != SUFFIX_F64 { return 17; }

    let t11 = lex_token_get(view(res), 11);
    if t11.kind != TOK_INT || (t11.flags & TOK_FLAG_BYTE_FORM) == 0u16 || t11.int_val != 65u64 || t11.suffix != SUFFIX_U8 { return 18; }

    let t12 = lex_token_get(view(res), 12);
    if t12.kind != TOK_CHAR || t12.char_val != 122u32 { return 19; }

    let t13 = lex_token_get(view(res), 13);
    if t13.kind != TOK_STR || t13.str_len != 3 { return 20; }

    let t14 = lex_token_get(view(res), 14);
    if t14.kind != TOK_STR || (t14.flags & TOK_FLAG_RAW) == 0u16 || t14.str_len != 4 { return 21; }

    let t15 = lex_token_get(view(res), 15);
    if t15.kind != TOK_BYTE_STR || t15.str_len != 2 { return 22; }

    if lex_token_get(view(res), 16).kind != TOK_DOT_DOT_EQ { return 23; }
    if lex_token_get(view(res), 17).kind != TOK_ARROW { return 24; }
    if lex_token_get(view(res), 18).kind != TOK_FAT_ARROW { return 25; }
    if lex_token_get(view(res), 19).kind != TOK_SHL_EQ { return 26; }
    if lex_token_get(view(res), 20).kind != TOK_SHR_EQ { return 27; }
    if lex_token_get(view(res), 21).kind != TOK_EOF { return 28; }

    ax_lex_result_free(mut_view(res));
    interner_free(mut_view(interner));
    diag_sink_free(mut_view(sink));

    let diag_rc = check_all_diags(mut_view(scratch));
    if diag_rc != 0 { return diag_rc; }

    arena_destroy(mut_view(scratch));
    print("OK Lex Tokens\n");
    0
}

fn check_all_diags(scratch: mut_view<Arena>) -> i32 {
    if !check_single_diag(mut_view(*scratch), 3, AX_LEX_INVALID_UTF8) { return 100; }
    if !check_single_diag(mut_view(*scratch), 4, AX_LEX_INVALID_CHAR) { return 101; }
    if !check_single_diag(mut_view(*scratch), 5, AX_LEX_NON_ASCII_IDENT) { return 102; }
    if !check_single_diag(mut_view(*scratch), 6, AX_LEX_UNTERMINATED_COMMENT) { return 103; }
    if !check_single_diag(mut_view(*scratch), 7, AX_LEX_UNTERMINATED_STRING) { return 104; }
    if !check_single_diag(mut_view(*scratch), 8, AX_LEX_UNTERMINATED_CHAR) { return 105; }
    if !check_single_diag(mut_view(*scratch), 9, AX_LEX_BAD_CHAR_LITERAL) { return 106; }
    if !check_single_diag(mut_view(*scratch), 10, AX_LEX_BAD_CHAR_LITERAL) { return 107; }
    if !check_single_diag(mut_view(*scratch), 11, AX_LEX_INVALID_ESCAPE) { return 108; }
    if !check_single_diag(mut_view(*scratch), 12, AX_LEX_INVALID_ESCAPE) { return 109; }
    if !check_single_diag(mut_view(*scratch), 13, AX_LEX_INVALID_UNICODE_ESCAPE) { return 110; }
    if !check_single_diag(mut_view(*scratch), 14, AX_LEX_NON_ASCII_IN_BYTE_LITERAL) { return 111; }
    if !check_single_diag(mut_view(*scratch), 15, AX_LEX_MISSING_DIGITS) { return 112; }
    if !check_single_diag(mut_view(*scratch), 16, AX_LEX_BAD_BASE_PREFIX) { return 113; }
    if !check_single_diag(mut_view(*scratch), 17, AX_LEX_INVALID_DIGIT) { return 114; }
    if !check_single_diag(mut_view(*scratch), 18, AX_LEX_BAD_DIGIT_SEPARATOR) { return 115; }
    if !check_single_diag(mut_view(*scratch), 19, AX_LEX_INVALID_SUFFIX) { return 116; }
    if !check_single_diag(mut_view(*scratch), 20, AX_LEX_INT_OVERFLOW) { return 117; }
    if !check_single_diag(mut_view(*scratch), 21, AX_LEX_INVALID_OPERATOR) { return 118; }
    if !check_single_diag(mut_view(*scratch), 22, AX_LEX_COLON_COLON) { return 119; }
    if !check_single_diag(mut_view(*scratch), 23, AX_LEX_COLON_EQ) { return 120; }
    0
}
