// test: golden
// emit: ast
// T422a FU-A: `<` after a field access is a comparison, never generic arguments.

struct Timer {
    deadline_ns: u64,
}

impl Timer {
    fn earlier(self: view<Timer>, other: view<Timer>) -> bool {
        if other.deadline_ns < self.deadline_ns {
            return true;
        }
        let both = other.deadline_ns < self.deadline_ns && self.deadline_ns > other.deadline_ns;
        both
    }
}
