// QA T422a: a chained comparison through field accesses (`a.f < b.g > c`, `a.f < b.g >= c`) is still diagnosed
// exactly once each (speculation neither leaks nor duplicates the diagnostic).

struct S {
    f: i32,
    g: i32,
}

fn chained(a: S, b: S, c: i32) {
    let x = a.f < b.g > c;
    let y = a.f < b.g >= c;
}
