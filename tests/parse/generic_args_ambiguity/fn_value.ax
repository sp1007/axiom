// T422a FU-J: an item path with generic arguments followed by an expression terminator is a value.

fn id<T>(x: T) -> T {
    return x;
}

fn apply(f: fn(i32) -> i32, v: i32) -> i32 {
    return f(v);
}

fn user() {
    let f: fn(i32) -> i32 = id<i32>;
    let g = id<u8>
    let r = apply(id<i32>, 1);
    let t = [id<i32>, id<i32>];
    let c = id<i32>(3);
    let lt = f < g;
}
