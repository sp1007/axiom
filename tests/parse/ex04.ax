// test: golden
// emit: ast
const MASK: u32 = 0x0f

fn ops(a: u32, b: u32, flags: u32) -> bool {
    let sum = a + b * 2 - (a % 3)
    let bits = (a << 2 | b >> 1) ^ ~flags
    let neg = -(a as i64) + b as i64
    let masked = flags & MASK == 0
    let ordered = a < b && b <= 100 || a == b
    let chained = sum +
        bits +
        (a
            * b)
    !masked && ordered && neg != 0 && chained >= 1
}
