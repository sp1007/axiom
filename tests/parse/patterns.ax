// test: golden
// emit: ast

fn test_patterns() {
    match 0 {
        _ => 0,
        1 | 2 | 3 => 1,
        -1 => 2,
        'a'..='z' => 3,
        10..20 => 4,
        mut x => 5,
        (a, b, c) => 6,
        Enum.Variant => 7,
        Enum.Variant(a, b) => 8,
        Struct { x, y: _, .. } => 9,
    }
}
