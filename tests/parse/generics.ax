// test: golden
// emit: ast

trait Draw {
    fn draw(self: view<Self>);
}

struct Tree<T> where T: Draw {
    value: T,
    left: Box<Tree<T>>,
    right: Box<Tree<T>>,
}

enum Option<T> {
    None,
    Some(T),
}

impl<T> Draw for Tree<T> where T: Draw + Send {
    fn draw(self: view<Self>) {}
}

impl Node {
    fn new() -> Node { Node {} }
}
