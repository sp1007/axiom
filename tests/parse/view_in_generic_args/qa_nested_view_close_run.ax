// test: run
// exit: 0
// stdout: 30\n7\n11\n42\n99\n30\n
// T428p QA adversarial test: deep/nested closing `>` splits (`>>`, `>>>`, `>>=`, `>>>=`)
// across `view<..>`, `mut_view<..>`, `let` annotations, and tentative expression generic args.

fn sum_nested(opt: Option<Option<view<[i32]>>>) -> i32 {
    match opt {
        Option.Some(inner) => match inner {
            Option.Some(xs) => {
                let mut acc: i32 = 0;
                let mut i: usize = 0;
                while i < len(xs) {
                    acc = acc + xs[i];
                    i = i + 1;
                }
                acc
            }
            Option.None => -1,
        },
        Option.None => -2,
    }
}

fn read_opt_view(opt: Option<view<i32>>) -> i32 {
    match opt {
        Option.Some(v) => *v,
        Option.None => -1,
    }
}

fn replace_inner_view(slot: mut_view<Option<view<i32>>>, next: view<i32>) -> i32 {
    let prev = read_opt_view(*slot);
    *slot = Option.Some(next);
    prev
}

fn pick<T>(x: T) -> T {
    x
}

fn main() {
    let arr: [3]i32 = [5, 10, 15];
    let v: view<[i32]>= view(arr);
    let nested: Option<Option<view<[i32]>>>= Option.Some(Option.Some(v));
    print_int(sum_nested(nested) as i64);
    print("\n");

    let a: i32 = 7;
    let x: Option<view<i32>>= Option.Some(view(a));
    print_int(read_opt_view(x) as i64);
    print("\n");

    let b: i32 = 11;
    let y: Option<Option<view<i32>>>= Option.Some(Option.Some(view(b)));
    let y_val = match y {
        Option.Some(inner) => read_opt_view(inner),
        Option.None => -1,
    };
    print_int(y_val as i64);
    print("\n");

    let c: i32 = 42;
    let d: i32 = 99;
    let mut slot: Option<view<i32>>= Option.Some(view(c));
    let prev = replace_inner_view(mut_view(slot), view(d));
    print_int(prev as i64);
    print("\n");
    print_int(read_opt_view(slot) as i64);
    print("\n");

    let picked = pick<Option<view<[i32]>>>(Option.Some(v));
    print_int(sum_nested(Option.Some(picked)) as i64);
    print("\n");
}
