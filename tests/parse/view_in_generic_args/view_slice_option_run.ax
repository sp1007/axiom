// test: run
// exit: 0
// stdout: 15\n-1\n
// T428p: pass `Option<view<[i32]>>` to a function and read through the slice view.

fn sum_opt(xs: Option<view<[i32]>>) -> i32 {
    match xs {
        Option.Some(s) => {
            let mut total: i32 = 0;
            let mut i: usize = 0;
            while i < len(s) {
                total = total + s[i];
                i = i + 1;
            }
            total
        }
        Option.None => -1,
    }
}

fn main() {
    let arr: [5]i32 = [1, 2, 3, 4, 5];
    let v: view<[i32]> = view(arr);
    print_int(sum_opt(Option.Some(v)) as i64);
    print("\n");
    print_int(sum_opt(Option.None) as i64);
    print("\n");
}
