// test: ui
// exit: 0
// T428p: AXS-GRM-057 closing `>` splitting after `view<..>` / `mut_view<..>` and generic params.

struct S {
    val: i32,
}

trait Marker<T> {}

type Alias<T>= i32;
type AliasBound<T: Marker<i32>>= i32;

fn id<T>(v: T) -> T {
    v
}

impl S {
    fn take_opt_mut(opt: Option<mut_view<Self>>) -> i32 {
        match opt {
            Option.Some(s) => {
                s.val = s.val + 1;
                s.val
            }
            Option.None => 0,
        }
    }
}

fn take_opt_slice(xs: Option<view<[S]>>) -> usize {
    match xs {
        Option.Some(s) => len(s),
        Option.None => 0,
    }
}

fn take_triple_gt(r: Result<view<S>, Option<view<[u8]>>>) -> i32 {
    match r {
        Result.Ok(s) => s.val,
        Result.Err(opt) => match opt {
            Option.Some(bytes) => len(bytes) as i32,
            Option.None => 0,
        },
    }
}

fn test_splits(mut s: S) -> i32 {
    let x: Option<view<S>>= Option.None;
    let _m = S.take_opt_mut(Option.Some(mut_view(s)));
    let y: view<S>= view(s);
    let arr: [2]i32 = [10, 20];
    let _v = id<view<[i32]>>(view(arr));
    let _a: Alias<i32> = 1;
    let _b: AliasBound<i32> = 2;
    let _ = x;
    y.val
}

fn main() {
    let _ = take_opt_slice(Option.None);
    let _ = take_triple_gt(Result.Err(Option.None));
    let _ = test_splits(S { val: 7 });
}
