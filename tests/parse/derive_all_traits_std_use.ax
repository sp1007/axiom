// test: golden
// emit: ast

use std.core.prelude.Ordering
use std.core.prelude.CasResult

@derive(Copy, Clone, Eq, PartialEq, Hash, Ord)
struct Key {
    hi: i32,
    lo: i32,
}

@derive(Copy, PartialEq, Eq)
enum Mode {
    Fast,
    Safe,
}

fn use_std_types(o: Ordering, c: CasResult<i32>) -> i32 {
    c.val
}
