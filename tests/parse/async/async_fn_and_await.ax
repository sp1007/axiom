// test: golden
// emit: ast

pub async fn fetch_value(x: i32) -> i32 {
    x + 1
}

pub async unsafe fn unsafe_async_first(p: *const i32) -> i32 {
    unsafe { *p }
}

pub unsafe async fn unsafe_async_second(p: *const i32) -> i32 {
    let v = fetch_value(unsafe { *p }).await
    v
}

trait AsyncService {
    async fn handle(self: view<Self>, req: i32) -> i32
}

struct Worker {
    base: i32,
}

impl Worker {
    pub async fn compute(self: view<Worker>, delta: i32) -> i32 {
        let a = fetch_value(delta).await
        self.base + a
    }
}

impl AsyncService for Worker {
    async fn handle(self: view<Worker>, req: i32) -> i32 {
        let step1 = self.compute(req).await
        let step2 = fetch_value(step1).await
        step2
    }
}
