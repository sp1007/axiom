// test: run
// exit: 0
// stdout: 360\n720\n
// T496 QA: a loop over every valid u128 / i128 index (ascending u128, descending i128 down to 0) still reads the right
// elements; sums 360 then 720 (exact stdout, so the native legs compare an observable result).

fn main() -> i32 {
    let a: [8]i32 = [10, 20, 30, 40, 50, 60, 70, 80];
    let mut i: u128 = 0u128;
    let mut sum: i64 = 0;
    while i < 8u128 {
        sum = sum + (a[i] as i64);
        i = i + 1u128;
    }
    print_int(sum);
    print("\n");
    let mut j: i128 = 7i128;
    while j >= 0i128 {
        sum = sum + (a[j] as i64);
        j = j - 1i128;
    }
    print_int(sum);
    print("\n");
    0
}
