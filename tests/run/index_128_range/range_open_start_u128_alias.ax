// test: run
// exit: 101
// stdout: before\n
// stderr-contains: index out of bounds
// T496 / ADR-0044 §1: an open-ended range `s[lo..]` with a u128 start of 2^127 + 4 (low 64 bits 4) must trap.

fn tail_len(s: view<[i32]>, lo: u128) -> usize {
    let t = s[lo..];
    len(t)
}

fn main() -> i32 {
    print("before\n");
    let a: [8]i32 = [10, 20, 30, 40, 50, 60, 70, 80];
    let s: view<[i32]> = view(a);
    let n: usize = tail_len(s, 170141183460469231731687303715884105732u128);
    print_int(n as i64);
    print("\nUNREACHABLE\n");
    0
}
