// test: run
// exit: 101
// stdout: before\n
// stderr-contains: index out of bounds
// T496 / ADR-0044 §1: an i128 range start of -(2^64) + 1 has low 64 bits 1; reinterpreted as u128 it is
// >= 2^127 > len, so the slice must trap instead of starting at element 1.

fn first(s: view<[i32]>, lo: i128, hi: i128) -> i32 {
    let t = s[lo..hi];
    t[0]
}

fn main() -> i32 {
    print("before\n");
    let a: [8]i32 = [10, 20, 30, 40, 50, 60, 70, 80];
    let s: view<[i32]> = view(a);
    let r: i32 = first(s, -18446744073709551615i128, 3i128);
    print_int(r as i64);
    print("\nUNREACHABLE\n");
    0
}
