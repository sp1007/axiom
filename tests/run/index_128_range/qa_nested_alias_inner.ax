// test: run
// exit: 101
// stdout: before\n12\n
// stderr-contains: index out of bounds
// T496 QA: nested `m[i][j]`: a valid wide outer index first (prints 12), then a wide INNER index 2^127 + 1 that must trap.

fn main() -> i32 {
    print("before\n");
    let m: [4][4]i32 = [[0, 1, 2, 3], [10, 11, 12, 13], [20, 21, 22, 23], [30, 31, 32, 33]];
    let i: u128 = 1u128;
    print_int(m[i][2u128] as i64);
    print("\n");
    let j: u128 = 170141183460469231731687303715884105729u128;
    print_int(m[i][j] as i64);
    print("\nUNREACHABLE\n");
    0
}
