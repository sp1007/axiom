// test: run
// exit: 101
// stdout: before\n
// stderr-contains: index out of bounds
// T496: both u128 bounds are <= len but start > end; the start <= end check (done in u128) must still trap.

fn sub_len(s: view<[i32]>, lo: u128, hi: u128) -> usize {
    let t = s[lo..hi];
    len(t)
}

fn main() -> i32 {
    print("before\n");
    let a: [8]i32 = [10, 20, 30, 40, 50, 60, 70, 80];
    let s: view<[i32]> = view(a);
    let n: usize = sub_len(s, 5u128, 3u128);
    print_int(n as i64);
    print("\nUNREACHABLE\n");
    0
}
