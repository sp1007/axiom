// test: run
// exit: 0
// stdout: 80 10 40 70\n3350 5480\n8180 0\n2 50 60\n
// T496 / ADR-0044 §1: in-range 128-bit indices and range bounds (checked in u128, then cast to usize) still
// address the right elements, including mixed-width bounds and the edge values 0, len - 1 and len.

fn at_u(a: view<[8]i32>, i: u128) -> i32 { (*a)[i] }
fn at_i(a: view<[8]i32>, i: i128) -> i32 { (*a)[i] }
fn at_s(s: view<[i32]>, i: u128) -> i32 { s[i] }

// Each helper returns len * 1000 + first * 10 + last (0 for an empty sub-slice).
fn summ(t: view<[i32]>) -> i64 {
    let n: usize = len(t);
    if n == 0 { return 0; }
    (n as i64) * 1000 + (t[0] as i64) * 10 + (t[n - 1] as i64)
}
fn mixed(s: view<[i32]>, lo: u128, hi: i32) -> i64 { summ(s[lo..hi]) }
fn mixed2(s: view<[i32]>, lo: i64, hi: i128) -> i64 { summ(s[lo..hi]) }
fn both(s: view<[i32]>, lo: i128, hi: u128) -> i64 { summ(s[lo..hi]) }

fn main() -> i32 {
    let a: [8]i32 = [10, 20, 30, 40, 50, 60, 70, 80];
    let s: view<[i32]> = view(a);
    print_int(at_u(view(a), 7u128) as i64);
    print(" ");
    print_int(at_i(view(a), 0i128) as i64);
    print(" ");
    print_int(at_s(s, 3u128) as i64);
    print(" ");
    let mut v: [8]i32 = [1, 2, 3, 4, 5, 6, 7, 8];
    let k: u128 = 6u128;
    v[k] = 70;
    print_int(v[k] as i64);
    print("\n");
    print_int(mixed(s, 2u128, 5));
    print(" ");
    print_int(mixed2(s, 3i64, 8i128));
    print("\n");
    print_int(both(s, 0i128, 8u128));
    print(" ");
    print_int(both(s, 8i128, 8u128));
    print("\n");
    let t = s[4u128..6u128];
    print_int(len(t) as i64);
    print(" ");
    print_int(t[0] as i64);
    print(" ");
    print_int(t[1] as i64);
    print("\n");
    0
}
