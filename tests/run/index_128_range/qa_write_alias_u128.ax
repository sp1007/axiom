// stdout: before\n
// stderr-contains: index out of bounds
// T496 QA: the WRITE path. `v[k] = 99` with k = 2^64 + 1 (low 64 bits 1) must trap and must not store to v[1].

fn main() -> i32 {
    print("before\n");
    let mut v: [8]i32 = [1, 2, 3, 4, 5, 6, 7, 8];
    let k: u128 = 18446744073709551617u128;
    v[k] = 99;
    print("\nUNREACHABLE\n");
    0
}
