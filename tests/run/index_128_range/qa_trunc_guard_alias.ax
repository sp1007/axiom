// test: run
// exit: 101
// stdout: before\n
// stderr-contains: index out of bounds
// T496 QA: a guard on the TRUNCATED value (`i as usize < 8`) must not let the optimiser (-O1 bounds-check elimination)
// drop the 128-bit check: i = 2^64 + 3 passes the guard (low 64 bits 3) and the access must still trap.

fn at(a: view<[8]i32>, i: u128) -> i32 {
    if (i as usize) < 8 {
        return (*a)[i];
    }
    return -1;
}

fn main() -> i32 {
    print("before\n");
    let a: [8]i32 = [10, 20, 30, 40, 50, 60, 70, 80];
    print_int(at(view(a), 18446744073709551619u128) as i64);
    print("\nUNREACHABLE\n");
    0
}
