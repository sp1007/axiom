// test: run
// exit: 101
// stdout: before\n
// stderr-contains: index out of bounds
// T496 / ADR-0044 §1: a u128 range end of 2^64 + 2 has low 64 bits 2 (a valid end); it must be checked in u128
// against the widened length and trap, not be truncated to 2 first.

fn sub_len(s: view<[i32]>, lo: u128, hi: u128) -> usize {
    let t = s[lo..hi];
    len(t)
}

fn main() -> i32 {
    print("before\n");
    let a: [8]i32 = [10, 20, 30, 40, 50, 60, 70, 80];
    let s: view<[i32]> = view(a);
    let n: usize = sub_len(s, 0u128, 18446744073709551618u128);
    print_int(n as i64);
    print("\nUNREACHABLE\n");
    0
}
