// test: run
// exit: 101
// stdout: before\n2:30,40\n
// stderr-contains: index out of bounds
// T496 QA: mixed-width range `s[lo..hi]` with a narrow start (u8) and a u128 end: the in-range call prints `2:30,40`;
// the same call with end = 2^64 + 5 (low 64 bits 5, a valid end) must trap instead of yielding `3:30,40,50`.

fn pr(t: view<[i32]>) {
    print_int(len(t) as i64);
    print(":");
    let mut i: usize = 0;
    while i < len(t) {
        if i > 0 {
            print(",");
        }
        print_int(t[i] as i64);
        i = i + 1;
    }
    print("\n");
}

fn sub(s: view<[i32]>, lo: u8, hi: u128) {
    let t = s[lo..hi];
    pr(t);
}

fn main() -> i32 {
    print("before\n");
    let a: [8]i32 = [10, 20, 30, 40, 50, 60, 70, 80];
    let s: view<[i32]> = view(a);
    sub(s, 2u8, 4u128);
    sub(s, 2u8, 18446744073709551621u128);
    print("UNREACHABLE\n");
    0
}
