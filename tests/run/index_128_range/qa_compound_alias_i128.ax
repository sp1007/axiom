// stderr-contains: index out of bounds
// T496 QA: compound assignment `v[k] += 100` with an i128 index of -(2^64) + 1 (low 64 bits 1) traps (read-modify-write path).

fn main() -> i32 {
    print("before\n");
    let mut v: [8]i32 = [1, 2, 3, 4, 5, 6, 7, 8];
    let k: i128 = -18446744073709551615i128;
    v[k] += 100;
    print("\nUNREACHABLE\n");
    0
}
