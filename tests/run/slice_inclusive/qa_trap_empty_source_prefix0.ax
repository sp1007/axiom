// test: run
// exit: 101
// stdout: before\n
// stderr-contains: index out of bounds
// QA T496a / ADR-0045: `..=0` on an empty slice traps (0 < len is false).

fn main() -> i32 {
    print("before\n");
    let a: [4]i32 = [1, 2, 3, 4];
    let s: view<[i32]> = view(a);
    let e = s[0..0];
    if len(e) != 0 { return 3; }
    let t = e[..=0];
    print_int(len(t) as i64);
    0
}
