// test: run
// exit: 101
// stdout: before\n
// stderr-contains: index out of bounds
// T496a / ADR-0045: b == u128.MAX is checked in u128 (ADR-0044 section 1) and traps; neither b + 1 nor the usize truncation may wrap.

fn sub_len(s: view<[i32]>, lo: u128, hi: u128) -> usize {
    let t = s[lo..=hi];
    len(t)
}

fn main() -> i32 {
    print("before\n");
    let a: [8]i32 = [10, 20, 30, 40, 50, 60, 70, 80];
    let s: view<[i32]> = view(a);
    let n: usize = sub_len(s, 0u128, 340282366920938463463374607431768211455u128);
    print_int(n as i64);
    print("\nUNREACHABLE\n");
    0
}
