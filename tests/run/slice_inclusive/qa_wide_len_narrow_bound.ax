// test: run
// exit: 0
// stdout: 256 200 300 1 0\n
// QA T496a / ADR-0045: the exclusive end b + 1 is computed in usize, so an 8-bit bound at its maximum on a
// long slice (u8 255 -> 256 elements; i8 127 -> 128) does not wrap; start == len gives the empty slice.

fn by_u8(s: view<[u8]>, hi: u8) -> usize { len(s[..=hi]) }
fn by_i8(s: view<[u8]>, lo: i8, hi: i8) -> usize { len(s[lo..=hi]) }
fn by_usize(s: view<[u8]>, lo: usize, hi: usize) -> usize { len(s[lo..=hi]) }

fn main() -> i32 {
    let a: [300]u8 = [7u8; 300];
    let s: view<[u8]> = view(a);
    print_int(by_u8(s, 255u8) as i64);
    print(" ");
    print_int((by_i8(s, 0i8, 127i8) + 72) as i64);
    print(" ");
    print_int(by_usize(s, 0, 299) as i64);
    print(" ");
    print_int(by_usize(s, 299, 299) as i64);
    print(" ");
    print_int(by_usize(s, 300, 299) as i64);
    print("\n");
    0
}
