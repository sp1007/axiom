// test: run
// exit: 101
// stdout: before\n
// stderr-contains: index out of bounds
// T496a / ADR-0045: an inclusive u128 end of 2^64 + 2 (low 64 bits 2) is checked in u128 and traps, not truncated to 2.

fn sub_len(s: view<[i32]>, lo: u128, hi: u128) -> usize {
    let t = s[lo..=hi];
    len(t)
}

fn main() -> i32 {
    print("before\n");
    let a: [8]i32 = [10, 20, 30, 40, 50, 60, 70, 80];
    let s: view<[i32]> = view(a);
    let n: usize = sub_len(s, 0u128, 18446744073709551618u128);
    print_int(n as i64);
    print("\nUNREACHABLE\n");
    0
}
