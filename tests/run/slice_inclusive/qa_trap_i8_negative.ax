// test: run
// exit: 101
// stdout: before\n
// stderr-contains: index out of bounds
// QA T496a / ADR-0045: negative i8 bound traps (b = -1, b + 1 == 0 would give an empty slice).

fn pick(s: view<[i32]>, lo: i8, hi: i8) -> usize {
    len(s[lo..=hi])
}

fn main() -> i32 {
    print("before\n");
    let a: [8]i32 = [1, 2, 3, 4, 5, 6, 7, 8];
    print_int(pick(view(a), 0i8, -1i8) as i64);
    0
}
