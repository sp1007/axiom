// test: run
// exit: 101
// stdout: before\n
// stderr-contains: index out of bounds
// T496a / ADR-0045: b == u64.MAX must trap; b + 1 in u64 would wrap to 0.

fn sub_len(s: view<[i32]>, lo: u64, hi: u64) -> usize {
    let t = s[lo..=hi];
    len(t)
}

fn main() -> i32 {
    print("before\n");
    let a: [8]i32 = [10, 20, 30, 40, 50, 60, 70, 80];
    let s: view<[i32]> = view(a);
    let n: usize = sub_len(s, 0u64, 18446744073709551615u64);
    print_int(n as i64);
    print("\nUNREACHABLE\n");
    0
}
