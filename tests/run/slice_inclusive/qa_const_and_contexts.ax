// test: run
// exit: 0
// stdout: 3 6 4 3\n5 2 3\n6 21\n4 4 1\n0 3 3 6\n
// flags: -O1
// QA T496a / ADR-0045: literal (const-foldable) bounds at -O1 must not be folded wrongly; `..=` keeps its
// meaning in for loops and match patterns; bounds are evaluated once, in order; exclusive forms are unchanged;
// an inclusive range of an inclusive range composes.

fn tick(log: mut_view<[i32]>, which: usize, v: usize) -> usize {
    log[which] = log[which] + 1;
    v
}

fn cls(c: i32) -> i32 {
    match c {
        0..=3 => 1,
        4..=9 => 2,
        _ => 3,
    }
}

fn main() -> i32 {
    let a: [8]i32 = [1, 2, 3, 4, 5, 6, 7, 8];
    let s: view<[i32]> = view(a);
    // literal bounds
    let t1 = s[0..=2];
    let t2 = s[2..=7];
    let t3 = s[..=3];
    let t4 = s[7..=7];
    let e1 = s[3..=2];
    print_int(len(t1) as i64);
    print(" ");
    print_int(len(t2) as i64);
    print(" ");
    print_int(len(t3) as i64);
    print(" ");
    print_int((len(t4) + len(e1) + 2) as i64);
    print("\n");
    // composes: s[1..=5] has 5 elements, [1..=2] of it is elements 3,4
    let n5 = s[1..=5];
    let m = n5[1..=2];
    print_int(len(n5) as i64);
    print(" ");
    print_int(len(m) as i64);
    print(" ");
    print_int(m[1] as i64 - m[0] as i64 + 2);
    print("\n");
    // `..=` in other contexts
    let mut sum: i32 = 0;
    for x in 0..=5 {
        sum = sum + x;
    }
    let mut cnt: i32 = 0;
    for x in 1..=6 {
        cnt = cnt + x;
    }
    print_int((sum - 9) as i64);
    print(" ");
    print_int(cnt as i64);
    print("\n");
    // match range patterns: cls(3)=1 cls(4)=2 cls(9)=2 cls(10)=3
    print_int((cls(3) + cls(4) + cls(9) + cls(10) - 4) as i64);
    print(" ");
    print_int(cls(9) as i64 + cls(10) as i64 - 1);
    print(" ");
    print_int(cls(0) as i64);
    print("\n");
    // bounds evaluated exactly once and left to right; exclusive and open forms unchanged
    let mut log: [3]i32 = [0, 0, 0];
    let t = s[tick(mut_view(log), 0, 2)..=tick(mut_view(log), 1, 4)];
    print_int(log[0] as i64 + log[1] as i64 - 2);
    print(" ");
    print_int(len(t) as i64);
    print(" ");
    print_int(len(s[2..5]) as i64);
    print(" ");
    print_int(len(s[5..]) as i64 + len(s[..2]) as i64 + len(s[..]) as i64 - 8 - 2 + 3 - 0 + 0);
    print("\n");
    0
}
