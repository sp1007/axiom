// test: run
// exit: 0
// stdout: 3 3 1 0\n3 10 30\n3 10 30\n1 50 50\n4 50 80\n0\n
// T496a / ADR-0045: `s[a..=b]` and `s[..=b]` on a `view<[T]>` include element `b` (length b - a + 1);
// `s[k..=k]` has one element, `s[k..=k-1]` is empty, `s[a..=len-1]` reaches the last element.

fn show(t: view<[i32]>) {
    let n: usize = len(t);
    print_int(n as i64);
    if n > 0 {
        print(" ");
        print_int(t[0] as i64);
        print(" ");
        print_int(t[n - 1] as i64);
    }
    print("\n");
}

fn main() -> i32 {
    let a: [8]i32 = [10, 20, 30, 40, 50, 60, 70, 80];
    let s: view<[i32]> = view(a);
    let k: usize = 4;
    print_int(len(s[0..=2]) as i64);
    print(" ");
    print_int(len(s[..=2]) as i64);
    print(" ");
    print_int(len(s[k..=k]) as i64);
    print(" ");
    print_int(len(s[k..=k - 1]) as i64);
    print("\n");
    show(s[0..=2]);
    show(s[..=2]);
    show(s[k..=k]);
    show(s[k..=7]);
    show(s[k..=k - 1]);
    0
}
