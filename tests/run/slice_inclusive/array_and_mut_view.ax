// test: run
// exit: 0
// stdout: 3 2 1\n10 200 300 400 50\n10 20 30 40 99\n7 20 30 40 99\n
// T496a / ADR-0045: inclusive sub-ranges on a `[N]T` array and on a `mut_view<[T]>`; writes through the
// inclusive sub-slice reach element `b` itself.

fn dump(a: view<[5]i32>) {
    let mut i: usize = 0;
    while i < 5 {
        if i > 0 { print(" "); }
        print_int((*a)[i] as i64);
        i = i + 1;
    }
    print("\n");
}

fn fill_mid(v: mut_view<[i32]>) {
    let sub = v[1..=3];
    let n: usize = len(sub);
    let mut i: usize = 0;
    while i < n {
        sub[i] = ((i as i32) + 2) * 100;
        i = i + 1;
    }
}

fn set_last(w: mut_view<[i32]>) {
    let last = w[4u64..=4u64];
    last[0] = 99;
}

fn set_head(u: mut_view<[i32]>) {
    let head = u[..=0u128];
    head[0] = 7;
}

fn main() -> i32 {
    let c: [5]i32 = [10, 20, 30, 40, 50];
    print_int(len(c[1..=3]) as i64);
    print(" ");
    print_int(len(c[..=1]) as i64);
    print(" ");
    print_int(len(c[4..=4]) as i64);
    print("\n");
    let mut arr: [5]i32 = [10, 20, 30, 40, 50];
    fill_mid(mut_view(arr));
    dump(view(arr));
    let mut b: [5]i32 = [10, 20, 30, 40, 50];
    set_last(mut_view(b));
    dump(view(b));
    set_head(mut_view(b));
    dump(view(b));
    0
}
