// test: run
// exit: 101
// stdout: before\n
// stderr-contains: index out of bounds
// T496a / ADR-0045: a > b + 1 with u128 bounds (7..=2) traps.

fn sub_len(s: view<[i32]>, lo: u128, hi: u128) -> usize {
    let t = s[lo..=hi];
    len(t)
}

fn main() -> i32 {
    print("before\n");
    let a: [8]i32 = [10, 20, 30, 40, 50, 60, 70, 80];
    let s: view<[i32]> = view(a);
    let n: usize = sub_len(s, 7u128, 2u128);
    print_int(n as i64);
    print("\nUNREACHABLE\n");
    0
}
