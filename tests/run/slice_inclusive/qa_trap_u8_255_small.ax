// test: run
// exit: 101
// stdout: before\n
// stderr-contains: index out of bounds
// QA T496a / ADR-0045: u8 bound 255 on a short slice traps (not wrapped through 8-bit b + 1 == 0).

fn pick(s: view<[i32]>, hi: u8) -> usize {
    len(s[..=hi])
}

fn main() -> i32 {
    print("before\n");
    let a: [8]i32 = [1, 2, 3, 4, 5, 6, 7, 8];
    print_int(pick(view(a), 255u8) as i64);
    0
}
