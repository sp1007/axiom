// test: run
// exit: 101
// stdout: before\n
// stderr-contains: index out of bounds
// T496a / ADR-0045: b == usize.MAX must trap; computing b + 1 first would wrap to 0 and yield an empty slice.

fn sub_len(s: view<[i32]>, lo: usize, hi: usize) -> usize {
    let t = s[lo..=hi];
    len(t)
}

fn main() -> i32 {
    print("before\n");
    let a: [8]i32 = [10, 20, 30, 40, 50, 60, 70, 80];
    let s: view<[i32]> = view(a);
    let n: usize = sub_len(s, 0, 18446744073709551615usize);
    print_int(n as i64);
    print("\nUNREACHABLE\n");
    0
}
