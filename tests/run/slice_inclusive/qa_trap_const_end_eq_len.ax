// test: run
// exit: 101
// stdout: before\n
// stderr-contains: index out of bounds
// QA T496a / ADR-0045: literal end == len at -O1 must still trap (no const-fold to a valid slice).

fn main() -> i32 {
    print("before\n");
    let a: [8]i32 = [1, 2, 3, 4, 5, 6, 7, 8];
    let s: view<[i32]> = view(a);
    let t = s[0..=8];
    print_int(len(t) as i64);
    0
}
