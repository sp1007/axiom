// test: run
// exit: 101
// stdout: before\n
// stderr-contains: index out of bounds
// QA T496a / ADR-0045: mut_view: b == len traps and the write never happens.

fn poke(v: mut_view<[i32]>, hi: usize) {
    let t = v[2..=hi];
    t[0] = 99;
}

fn main() -> i32 {
    print("before\n");
    let mut a: [5]i32 = [1, 2, 3, 4, 5];
    poke(mut_view(a), 5);
    print_int(a[2] as i64);
    0
}
