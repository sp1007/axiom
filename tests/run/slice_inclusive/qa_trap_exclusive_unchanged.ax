// test: run
// exit: 101
// stdout: before\n
// stderr-contains: index out of bounds
// QA T496a / ADR-0045: exclusive `s[0..len+1]` still traps; `s[0..len]` stays valid (checked before the trap).

fn main() -> i32 {
    print("before\n");
    let a: [8]i32 = [1, 2, 3, 4, 5, 6, 7, 8];
    let s: view<[i32]> = view(a);
    let ok = s[0..8];
    if len(ok) != 8 { return 3; }
    let hi: usize = 9;
    let t = s[0..hi];
    print_int(len(t) as i64);
    0
}
