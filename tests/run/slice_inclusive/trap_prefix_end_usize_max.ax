// test: run
// exit: 101
// stdout: before\n
// stderr-contains: index out of bounds
// T496a / ADR-0045: `s[..=usize.MAX]` must trap, not wrap b + 1 to 0.

fn sub_len(s: view<[i32]>, hi: usize) -> usize {
    let t = s[..=hi];
    len(t)
}

fn main() -> i32 {
    print("before\n");
    let a: [8]i32 = [10, 20, 30, 40, 50, 60, 70, 80];
    let s: view<[i32]> = view(a);
    let n: usize = sub_len(s, 18446744073709551615usize);
    print_int(n as i64);
    print("\nUNREACHABLE\n");
    0
}
