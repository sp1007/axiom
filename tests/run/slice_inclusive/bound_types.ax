// test: run
// exit: 0
// stdout: 30204 30305 30608 30103 30305 30507\n40205 40306 10808 10101 50307 30507\n80108 80108 80108\n0 0 0\n
// T496a / ADR-0045: inclusive sub-ranges with u8 / i32 / usize / u64 / u128 / i128 bounds (and mixed widths)
// select elements a..b including b; the last-element end (len - 1) is valid, an empty range is a..=a-1.

// len * 10000 + first * 100 + last (0 for an empty sub-slice).
fn key(t: view<[i32]>) -> i64 {
    let n: usize = len(t);
    if n == 0 { return 0; }
    (n as i64) * 10000 + (t[0] as i64) * 100 + (t[n - 1] as i64)
}

fn r_u8(s: view<[i32]>, lo: u8, hi: u8) -> i64 { key(s[lo..=hi]) }
fn r_i32(s: view<[i32]>, lo: i32, hi: i32) -> i64 { key(s[lo..=hi]) }
fn r_usize(s: view<[i32]>, lo: usize, hi: usize) -> i64 { key(s[lo..=hi]) }
fn r_u64(s: view<[i32]>, lo: u64, hi: u64) -> i64 { key(s[lo..=hi]) }
fn r_u128(s: view<[i32]>, lo: u128, hi: u128) -> i64 { key(s[lo..=hi]) }
fn r_i128(s: view<[i32]>, lo: i128, hi: i128) -> i64 { key(s[lo..=hi]) }
fn p_u8(s: view<[i32]>, hi: u8) -> i64 { key(s[..=hi]) }
fn p_u64(s: view<[i32]>, hi: u64) -> i64 { key(s[..=hi]) }
fn p_u128(s: view<[i32]>, hi: u128) -> i64 { key(s[..=hi]) }
fn m_wide(s: view<[i32]>, lo: u128, hi: i32) -> i64 { key(s[lo..=hi]) }
fn m_narrow(s: view<[i32]>, lo: u8, hi: i128) -> i64 { key(s[lo..=hi]) }

fn sp() { print(" "); }

fn main() -> i32 {
    let a: [8]i32 = [1, 2, 3, 4, 5, 6, 7, 8];
    let s: view<[i32]> = view(a);
    print_int(r_u8(s, 1u8, 3u8));
    sp();
    print_int(r_i32(s, 2, 4));
    sp();
    print_int(r_usize(s, 5, 7));
    sp();
    print_int(r_u64(s, 0u64, 2u64));
    sp();
    print_int(r_u128(s, 2u128, 4u128));
    sp();
    print_int(r_i128(s, 4i128, 6i128));
    print("\n");
    print_int(r_u8(s, 1u8, 4u8));
    sp();
    print_int(r_i32(s, 2, 5));
    sp();
    print_int(r_usize(s, 7, 7));
    sp();
    print_int(p_u8(s, 0u8));
    sp();
    print_int(m_wide(s, 2u128, 6));
    sp();
    print_int(m_narrow(s, 4u8, 6i128));
    print("\n");
    print_int(p_u64(s, 7u64));
    sp();
    print_int(p_u128(s, 7u128));
    sp();
    print_int(r_i128(s, 0i128, 7i128));
    print("\n");
    print_int(r_u64(s, 3u64, 2u64));
    sp();
    print_int(r_u128(s, 8u128, 7u128));
    sp();
    print_int(r_i128(s, 1i128, 0i128));
    print("\n");
    0
}
