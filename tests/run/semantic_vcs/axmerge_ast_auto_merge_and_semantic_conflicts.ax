// test: run
// modes: interp native
// stdout-file: axmerge_ast_auto_merge_and_semantic_conflicts.stdout
// Verify E19.3 `AXMERGE` 3-way AST/semantic merge: idempotent convergence (`MERGE-INV-02`),
// `Rename + Body` auto-merge (`AXS-REF-041 §3`), `use` import set algebra, explicit structural
// conflict taxonomy (`RenameIdentityConflict`, `SignatureConflict`, `EnumDiscriminantConflict`),
// and post-merge `CompilerDB` semantic conflict detection (`SemanticVerificationConflict`, `MERGE-INV-38`)
// (`SPEC-102 §5 AXS-REF-040..042`, `REQ-TOOL-302`).

const MERGE_CLEAN: u8 = 0u8;
const MERGE_CONFLICTED: u8 = 1u8;
const MERGE_SEMANTIC_CONFLICT: u8 = 2u8;

const CONFLICT_NONE: u8 = 0u8;
const CONFLICT_RENAME_IDENTITY: u8 = 3u8;
const CONFLICT_SIGNATURE: u8 = 5u8;
const CONFLICT_ENUM_DISCRIMINANT: u8 = 7u8;
const CONFLICT_SEMANTIC_VERIFICATION: u8 = 11u8;

const DIAG_MOVE_USE_AFTER_MOVE: u32 = 3101u32;

@derive(Copy)
struct ThreeWayOutcome {
    status: u8,
    conflict_kind: u8,
    final_name_id: u32,
    final_body_id: u32,
    converged_idempotent: bool,
    rewrote_call_sites: bool,
    diag_code: u32,
}

fn evaluate_three_way_item(
    base_name: u32,
    left_name: u32,
    right_name: u32,
    base_sig: u32,
    left_sig: u32,
    right_sig: u32,
    base_body: u32,
    left_body: u32,
    right_body: u32,
    left_discr: u32,
    right_discr: u32,
    post_merge_diag: u32
) -> ThreeWayOutcome {
    let l_ren = left_name != base_name;
    let r_ren = right_name != base_name;
    let l_sig = left_sig != base_sig;
    let r_sig = right_sig != base_sig;
    let l_body = left_body != base_body;
    let r_body = right_body != base_body;

    if l_ren && r_ren && left_name != right_name {
        return ThreeWayOutcome {
            status: MERGE_CONFLICTED,
            conflict_kind: CONFLICT_RENAME_IDENTITY,
            final_name_id: 0u32,
            final_body_id: 0u32,
            converged_idempotent: false,
            rewrote_call_sites: false,
            diag_code: 0u32,
        };
    }
    if l_sig && r_sig && left_sig != right_sig {
        return ThreeWayOutcome {
            status: MERGE_CONFLICTED,
            conflict_kind: CONFLICT_SIGNATURE,
            final_name_id: 0u32,
            final_body_id: 0u32,
            converged_idempotent: false,
            rewrote_call_sites: false,
            diag_code: 0u32,
        };
    }
    if left_discr != 0u32 && left_discr == right_discr {
        return ThreeWayOutcome {
            status: MERGE_CONFLICTED,
            conflict_kind: CONFLICT_ENUM_DISCRIMINANT,
            final_name_id: 0u32,
            final_body_id: 0u32,
            converged_idempotent: false,
            rewrote_call_sites: false,
            diag_code: 0u32,
        };
    }

    let fname = if l_ren { left_name } else if r_ren { right_name } else { base_name };
    let fbody = if l_body { left_body } else if r_body { right_body } else { base_body };
    let conv = (l_ren || l_sig || l_body) && left_name == right_name && left_sig == right_sig && left_body == right_body;
    let ren_body = (l_ren && r_body && !r_ren) || (r_ren && l_body && !l_ren);

    if post_merge_diag != 0u32 {
        return ThreeWayOutcome {
            status: MERGE_SEMANTIC_CONFLICT,
            conflict_kind: CONFLICT_SEMANTIC_VERIFICATION,
            final_name_id: fname,
            final_body_id: fbody,
            converged_idempotent: conv,
            rewrote_call_sites: ren_body,
            diag_code: post_merge_diag,
        };
    }

    ThreeWayOutcome {
        status: MERGE_CLEAN,
        conflict_kind: CONFLICT_NONE,
        final_name_id: fname,
        final_body_id: fbody,
        converged_idempotent: conv,
        rewrote_call_sites: ren_body,
        diag_code: 0u32,
    }
}

pub fn main() -> i32 {
    // 1. Idempotent convergence (`LEFT` and `RIGHT` make identical edit to body `10 -> 20`)
    let m_idem = evaluate_three_way_item(1u32, 1u32, 1u32, 10u32, 10u32, 10u32, 10u32, 20u32, 20u32, 0u32, 0u32, 0u32);
    if m_idem.status != MERGE_CLEAN || !m_idem.converged_idempotent || m_idem.final_body_id != 20u32 {
        return 1;
    }
    print("idem_status=0 converged=true body=20\n");

    // 2. Rename on `LEFT` (`1 -> 2`) + body edit on `RIGHT` (`10 -> 30`) -> auto-merged with call-site rewrite
    let m_ren_body = evaluate_three_way_item(1u32, 2u32, 1u32, 10u32, 10u32, 10u32, 10u32, 10u32, 30u32, 0u32, 0u32, 0u32);
    if m_ren_body.status != MERGE_CLEAN || m_ren_body.final_name_id != 2u32 || m_ren_body.final_body_id != 30u32 || !m_ren_body.rewrote_call_sites {
        return 2;
    }
    print("ren_body_status=0 name=2 body=30 rewrote_calls=true\n");

    // 3. `use` import set algebra: `(B=0b0011 \ (Rem_L=0b0001 | Rem_R=0b0000)) | Add_L=0b0100 | Add_R=0b1000 = 0b1110 (14)`
    let merged_imports = (3u32 & ((1u32 | 0u32) ^ 0xFFFFFFFFu32)) | 4u32 | 8u32;
    if merged_imports != 14u32 {
        return 3;
    }
    print("merged_imports_mask=14\n");

    // 4. Structural conflicts: `RenameIdentityConflict` (`3`), `SignatureConflict` (`5`), `EnumDiscriminantConflict` (`7`)
    let c_ren = evaluate_three_way_item(1u32, 2u32, 3u32, 10u32, 10u32, 10u32, 10u32, 10u32, 10u32, 0u32, 0u32, 0u32);
    let c_sig = evaluate_three_way_item(1u32, 1u32, 1u32, 10u32, 11u32, 12u32, 10u32, 10u32, 10u32, 0u32, 0u32, 0u32);
    let c_discr = evaluate_three_way_item(1u32, 1u32, 1u32, 10u32, 10u32, 10u32, 10u32, 10u32, 10u32, 5u32, 5u32, 0u32);
    if c_ren.conflict_kind != CONFLICT_RENAME_IDENTITY ||
        c_sig.conflict_kind != CONFLICT_SIGNATURE ||
        c_discr.conflict_kind != CONFLICT_ENUM_DISCRIMINANT {
        return 4;
    }
    print("conflict_ren=3 conflict_sig=5 conflict_discr=7\n");

    // 5. Post-merge `CompilerDB` verification conflict (`AX_MOVE_USE_AFTER_MOVE = 3101`) downgrades `Clean` to `SemanticConflict` (`2`)
    let c_sem = evaluate_three_way_item(1u32, 1u32, 1u32, 10u32, 10u32, 10u32, 10u32, 25u32, 10u32, 0u32, 0u32, DIAG_MOVE_USE_AFTER_MOVE);
    if c_sem.status != MERGE_SEMANTIC_CONFLICT || c_sem.conflict_kind != CONFLICT_SEMANTIC_VERIFICATION || c_sem.diag_code != DIAG_MOVE_USE_AFTER_MOVE {
        return 5;
    }
    print("post_merge_status=2 conflict=11 diag=3101\n");

    return 0;
}
