// test: run
// modes: interp native
// stdout-file: axdiff_tree_vs_text_and_semantic_diff.stdout
// Verify E19.3 `AXDIFF` tree vs text comparison (`FormattingOnly` vs `TriviaOnly`),
// intra-module reordering (`Moved`), cross-name `Renamed` / `RenamedAndModified` evidence lattice
// (`Strong`/`Inferred` never `Exact`, `DIFF-INV-10`), capability/effect/`@repr(C)` ABI breaking diff,
// and nine-state status lattice (`Incomparable` never collapsed to `Identical`, `DIFF-INV-06..07`)
// (`SPEC-102 §4 AXS-REF-030..032`, `REQ-TOOL-301`).

const STATUS_IDENTICAL: u8 = 0u8;
const STATUS_CHANGED: u8 = 1u8;
const STATUS_MOVED: u8 = 4u8;
const STATUS_RENAMED: u8 = 5u8;
const STATUS_INCOMPARABLE: u8 = 8u8;

const CHG_TRIVIA_ONLY: u8 = 0u8;
const CHG_FORMATTING_ONLY: u8 = 1u8;
const CHG_MOVED: u8 = 5u8;
const CHG_RENAMED: u8 = 6u8;
const CHG_RENAMED_AND_MODIFIED: u8 = 7u8;
const CHG_CAPABILITY_CHANGED: u8 = 11u8;
const CHG_LAYOUT_CHANGED: u8 = 14u8;
const CHG_UNSAFE_SURFACE_CHANGED: u8 = 16u8;

const SEV_INFO: u8 = 0u8;
const SEV_BREAKING: u8 = 3u8;
const SEV_SECURITY: u8 = 4u8;

const EVID_EXACT: u8 = 0u8;
const EVID_STRONG: u8 = 1u8;
const EVID_INFERRED: u8 = 2u8;

@derive(Copy)
struct DiffEval {
    status: u8,
    change_kind: u8,
    severity: u8,
    evidence: u8,
    semantic_changes: u32,
}

fn eval_file_level_diff(
    comparable: bool,
    left_bytes: u64,
    right_bytes: u64,
    left_ast: u64,
    right_ast: u64,
    left_comments: u64,
    right_comments: u64
) -> DiffEval {
    if !comparable {
        return DiffEval {
            status: STATUS_INCOMPARABLE,
            change_kind: 0u8,
            severity: 5u8,
            evidence: 4u8,
            semantic_changes: 0u32,
        };
    }
    if left_bytes == right_bytes {
        return DiffEval {
            status: STATUS_IDENTICAL,
            change_kind: 0u8,
            severity: SEV_INFO,
            evidence: EVID_EXACT,
            semantic_changes: 0u32,
        };
    }
    if left_ast == right_ast {
        let is_fmt = left_comments == right_comments;
        return DiffEval {
            status: STATUS_CHANGED,
            change_kind: if is_fmt { CHG_FORMATTING_ONLY } else { CHG_TRIVIA_ONLY },
            severity: SEV_INFO,
            evidence: EVID_EXACT,
            semantic_changes: 0u32,
        };
    }
    DiffEval {
        status: STATUS_CHANGED,
        change_kind: 4u8,
        severity: SEV_BREAKING,
        evidence: EVID_EXACT,
        semantic_changes: 1u32,
    }
}

fn eval_item_pair_diff(
    same_key: bool,
    same_mod: bool,
    same_name: bool,
    same_sig: bool,
    same_body: bool,
    order_changed: bool,
    dice_sim_pct: u8,
    cap_changed: bool,
    layout_changed: bool,
    unsafe_changed: bool
) -> DiffEval {
    if same_key && same_mod {
        if !same_sig || !same_body || cap_changed || layout_changed || unsafe_changed {
            let ck = if layout_changed {
                CHG_LAYOUT_CHANGED
            } else if unsafe_changed {
                CHG_UNSAFE_SURFACE_CHANGED
            } else if cap_changed {
                CHG_CAPABILITY_CHANGED
            } else {
                10u8
            };
            let sev = if unsafe_changed { SEV_SECURITY } else { SEV_BREAKING };
            return DiffEval {
                status: STATUS_CHANGED,
                change_kind: ck,
                severity: sev,
                evidence: EVID_EXACT,
                semantic_changes: 1u32,
            };
        }
        if order_changed {
            return DiffEval {
                status: STATUS_MOVED,
                change_kind: CHG_MOVED,
                severity: SEV_INFO,
                evidence: EVID_EXACT,
                semantic_changes: 1u32,
            };
        }
    }
    if same_mod && !same_name && (same_body || (same_sig && dice_sim_pct >= 75u8)) {
        let modified = !same_body || !same_sig;
        let ev = if same_body && same_sig { EVID_STRONG } else { EVID_INFERRED };
        return DiffEval {
            status: STATUS_RENAMED,
            change_kind: if modified { CHG_RENAMED_AND_MODIFIED } else { CHG_RENAMED },
            severity: SEV_BREAKING,
            evidence: ev,
            semantic_changes: 1u32,
        };
    }
    DiffEval {
        status: STATUS_IDENTICAL,
        change_kind: 0u8,
        severity: SEV_INFO,
        evidence: EVID_EXACT,
        semantic_changes: 0u32,
    }
}

pub fn main() -> i32 {
    // 1. Whitespace/formatting change (`left_bytes != right_bytes`, `left_ast == right_ast`) -> `FormattingOnly`, 0 semantic changes
    let d_fmt = eval_file_level_diff(true, 0x100u64, 0x200u64, 0xABCDu64, 0xABCDu64, 0x55u64, 0x55u64);
    if d_fmt.change_kind != CHG_FORMATTING_ONLY || d_fmt.semantic_changes != 0u32 || d_fmt.severity != SEV_INFO {
        return 1;
    }
    print("fmt_only_kind=1 sem_changes=0 sev=0\n");

    // 2. Intra-module declaration reorder (`same_key && order_changed`) -> `Moved` (`Exact`), not `Removed`+`Added`
    let d_reord = eval_item_pair_diff(true, true, true, true, true, true, 100u8, false, false, false);
    if d_reord.status != STATUS_MOVED || d_reord.change_kind != CHG_MOVED || d_reord.evidence != EVID_EXACT {
        return 2;
    }
    print("intra_mod_reorder_status=4 kind=5 evidence=0\n");

    // 3. Cross-name rename with identical body -> `Renamed` with `Strong` evidence; rename + body edit -> `RenamedAndModified` with `Inferred` evidence (never `Exact`)
    let d_ren = eval_item_pair_diff(false, true, false, true, true, false, 100u8, false, false, false);
    let d_ren_mod = eval_item_pair_diff(false, true, false, true, false, false, 82u8, false, false, false);
    if d_ren.change_kind != CHG_RENAMED || d_ren.evidence != EVID_STRONG ||
        d_ren_mod.change_kind != CHG_RENAMED_AND_MODIFIED || d_ren_mod.evidence != EVID_INFERRED {
        return 3;
    }
    print("rename_kind=6 ren_ev=1 ren_mod_kind=7 ren_mod_ev=2\n");

    // 4. Semantic capability (`view -> mut_view`), `@repr(C)` layout change, and `unsafe` surface change
    let d_cap = eval_item_pair_diff(true, true, true, true, true, false, 100u8, true, false, false);
    let d_lay = eval_item_pair_diff(true, true, true, true, true, false, 100u8, false, true, false);
    let d_uns = eval_item_pair_diff(true, true, true, true, true, false, 100u8, false, false, true);
    if d_cap.change_kind != CHG_CAPABILITY_CHANGED || d_lay.change_kind != CHG_LAYOUT_CHANGED ||
        d_uns.change_kind != CHG_UNSAFE_SURFACE_CHANGED || d_uns.severity != SEV_SECURITY {
        return 4;
    }
    print("cap_chg=11 layout_chg=14 unsafe_chg=16 unsafe_sev=4\n");

    // 5. Nine-state lattice: `Incomparable` never collapses to `Identical`
    let d_inc = eval_file_level_diff(false, 0x100u64, 0x100u64, 0xABCDu64, 0xABCDu64, 0x55u64, 0x55u64);
    if d_inc.status != STATUS_INCOMPARABLE || d_inc.status == STATUS_IDENTICAL {
        return 5;
    }
    print("incomparable_status=8 not_identical=true\n");

    return 0;
}
