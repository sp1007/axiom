// Bundled E19.3 Semantic AST Diff/Merge/Patch & Lineage History Engine Probe (T810).
// Exercises `std.editor` + `std.vcs` + `compiler.query.db` + `compiler.lsp.protocol` +
// `compiler.lsp.vfs` + `compiler.lsp.handlers` + `compiler.refactor.transforms` +
// `compiler.refactor.vcs.diff` + `compiler.refactor.vcs.merge` + `compiler.refactor.vcs.patch` +
// `compiler.refactor.vcs` + `compiler.driver.refactor_cmd` end-to-end across
// `--interp`, `-O0`, `-O1`, and `-O2 --verify-each`.

module main

use std.editor.editor_snapshot

use std.vcs.LINEAGE_CREATED
use std.vcs.LINEAGE_RENAMED
use std.vcs.LINEAGE_MOVED
use std.vcs.LINEAGE_EXTRACTED_FROM
use std.vcs.LINEAGE_REMOVED
use std.vcs.PROP_MASK_FORMATTING_ONLY
use std.vcs.PROP_MASK_SIGNATURE
use std.vcs.PROP_MASK_CAPABILITY
use std.vcs.OBJ_BLOB
use std.vcs.VCS_OK
use std.vcs.VCS_INTEGRITY_ERROR
use std.vcs.VCS_CAS_CONFLICT
use std.vcs.VCS_NON_FAST_FORWARD
use std.vcs.VCS_DAG_CYCLE_ERROR
use std.vcs.REF_HEADS
use std.vcs.REF_REMOTES
use std.vcs.LineageEdge
use std.vcs.VcsTreeEntry
use std.vcs.vcs_repo_new
use std.vcs.vcs_put_object
use std.vcs.vcs_corrupt_object_for_test
use std.vcs.vcs_verify_and_get_object
use std.vcs.vcs_commit_revision
use std.vcs.vcs_record_lineage_edge
use std.vcs.vcs_history_of_symbol
use std.vcs.vcs_blame_symbol_property
use std.vcs.vcs_build_tree_snapshot
use std.vcs.vcs_build_semantic_snapshot
use std.vcs.vcs_get_ref
use std.vcs.vcs_update_ref_cas
use std.vcs.vcs_fetch_remote
use std.vcs.vcs_push_remote
use std.vcs.vcs_git_adapter_map
use std.vcs.vcs_git_lookup_rev

use compiler.lsp.protocol.lsp_str_view
use compiler.lsp.vfs.VfsWorkspace
use compiler.lsp.vfs.vfs_workspace_new
use compiler.lsp.vfs.vfs_workspace_free
use compiler.lsp.vfs.vfs_hash_str
use compiler.lsp.vfs.vfs_did_open
use compiler.lsp.vfs.vfs_doc_ptr
use compiler.lsp.handlers.LspSemanticEngine
use compiler.lsp.handlers.DIAG_MOVE_USE_AFTER_MOVE
use compiler.lsp.handlers.lsp_engine_new
use compiler.lsp.handlers.lsp_engine_free

use compiler.refactor.vcs.semantic_vcs_capabilities_query

use compiler.refactor.vcs.diff.DIFF_MODE_SEMANTIC
use compiler.refactor.vcs.diff.DIFF_STATUS_IDENTICAL
use compiler.refactor.vcs.diff.DIFF_STATUS_CHANGED
use compiler.refactor.vcs.diff.DIFF_STATUS_MOVED
use compiler.refactor.vcs.diff.DIFF_STATUS_RENAMED
use compiler.refactor.vcs.diff.DIFF_STATUS_INCOMPARABLE
use compiler.refactor.vcs.diff.DIFF_CHANGE_FORMATTING_ONLY
use compiler.refactor.vcs.diff.DIFF_CHANGE_MOVED
use compiler.refactor.vcs.diff.DIFF_CHANGE_RENAMED
use compiler.refactor.vcs.diff.DIFF_CHANGE_RENAMED_AND_MODIFIED
use compiler.refactor.vcs.diff.DIFF_CHANGE_CAPABILITY_CHANGED
use compiler.refactor.vcs.diff.DIFF_CHANGE_LAYOUT_CHANGED
use compiler.refactor.vcs.diff.DIFF_EVIDENCE_EXACT
use compiler.refactor.vcs.diff.DIFF_EVIDENCE_STRONG
use compiler.refactor.vcs.diff.DIFF_EVIDENCE_INFERRED
use compiler.refactor.vcs.diff.ABI_IMPACT_BREAKING
use compiler.refactor.vcs.diff.DIFF_ITEM_FUNCTION
use compiler.refactor.vcs.diff.DIFF_ITEM_STRUCT
use compiler.refactor.vcs.diff.RECEIVER_CAP_VIEW
use compiler.refactor.vcs.diff.RECEIVER_CAP_MUT_VIEW
use compiler.refactor.vcs.diff.axdiff_item_decl_new
use compiler.refactor.vcs.diff.axdiff_snapshot_empty
use compiler.refactor.vcs.diff.axdiff_snapshot_add_item
use compiler.refactor.vcs.diff.axdiff_compare_snapshots

use compiler.refactor.vcs.merge.MERGE_STATUS_CLEAN
use compiler.refactor.vcs.merge.MERGE_STATUS_CONFLICTED
use compiler.refactor.vcs.merge.MERGE_STATUS_SEMANTIC_CONFLICT
use compiler.refactor.vcs.merge.MERGE_ID_LEVEL_SYMBOL_KEY
use compiler.refactor.vcs.merge.MERGE_ID_LEVEL_RENAME_MOVE_FINGERPRINT
use compiler.refactor.vcs.merge.MERGE_POLICY_STRICT
use compiler.refactor.vcs.merge.CONFLICT_RENAME_IDENTITY
use compiler.refactor.vcs.merge.CONFLICT_SIGNATURE
use compiler.refactor.vcs.merge.CONFLICT_SEMANTIC_VERIFICATION
use compiler.refactor.vcs.merge.axmerge_entity_new
use compiler.refactor.vcs.merge.axmerge_bundle_new
use compiler.refactor.vcs.merge.axmerge_bundle_add_item
use compiler.refactor.vcs.merge.axmerge_has_canonical_conflict_markers
use compiler.refactor.vcs.merge.axmerge_three_way

use compiler.refactor.vcs.patch.PATCH_KIND_SEMANTIC
use compiler.refactor.vcs.patch.PATCH_OP_MODIFY_ITEM_BODY
use compiler.refactor.vcs.patch.PATCH_OP_RENAME_SYMBOL
use compiler.refactor.vcs.patch.PRECOND_SYMBOL_BODY_AST_HASH_IS
use compiler.refactor.vcs.patch.PRECOND_SYMBOL_EXISTS
use compiler.refactor.vcs.patch.PATCH_STATUS_APPLIED_CLEAN
use compiler.refactor.vcs.patch.PATCH_STATUS_APPLIED_RELOCATED
use compiler.refactor.vcs.patch.PATCH_STATUS_TARGET_NOT_FOUND
use compiler.refactor.vcs.patch.PATCH_STATUS_TARGET_AMBIGUOUS
use compiler.refactor.vcs.patch.PATCH_STATUS_DEPENDENCY_CYCLE
use compiler.refactor.vcs.patch.PATCH_STATUS_SEMANTIC_VERIFICATION_FAILED
use compiler.refactor.vcs.patch.PatchWorkspaceTargetFact
use compiler.refactor.vcs.patch.axpatch_op_empty
use compiler.refactor.vcs.patch.axpatch_new
use compiler.refactor.vcs.patch.axpatch_add_op
use compiler.refactor.vcs.patch.axpatch_workspace_state_new
use compiler.refactor.vcs.patch.axpatch_workspace_add_target
use compiler.refactor.vcs.patch.axpatch_apply_transaction
use compiler.refactor.vcs.patch.axpatch_reverse
use compiler.refactor.vcs.patch.axpatch_compose
use compiler.refactor.vcs.patch.axpatch_rebase

use compiler.driver.refactor_cmd.EXIT_OK
use compiler.driver.refactor_cmd.EXIT_DIFF_OR_CONFLICT
use compiler.driver.refactor_cmd.EXIT_CLI_USAGE_ERROR
use compiler.driver.refactor_cmd.DIAG_DRIVER_UNKNOWN_OPTION
use compiler.driver.refactor_cmd.refactor_cmd_config_default
use compiler.driver.refactor_cmd.refactor_cmd_parse_arg
use compiler.driver.refactor_cmd.refactor_cmd_run_diff
use compiler.driver.refactor_cmd.refactor_cmd_run_merge
use compiler.driver.refactor_cmd.refactor_cmd_run_patch
use compiler.driver.refactor_cmd.refactor_cmd_run_history

fn main() -> i32 {
    let mut ws = vfs_workspace_new();
    let mut eng = lsp_engine_new();

    let caps = semantic_vcs_capabilities_query();
    if !caps.compiler_db_verified || !caps.zero_codegen_firewall || caps.axdiff_schema != 1u32 {
        return 10;
    }

    let doc0: u32 = 0u32;
    let src0 = "module pkg.vcs_demo\npub fn compute(x: i32) -> i32 {\n    return x + 1\n}\n";
    let sv0 = lsp_str_view(src0);
    let _ = vfs_did_open(
        mut_view(ws),
        doc0,
        vfs_hash_str("file:///workspace/src/vcs_demo.ax"),
        1i64,
        sv0.ptr,
        sv0.len,
        0x1111u64,
        0x2222u64
    );

    // ========================================================================
    // Phase 1: `AXDIFF` Structural CST/AST & Semantic Symbol Diff (`SPEC-102 §4`)
    // ========================================================================
    let snap_fmt_l = axdiff_snapshot_empty(0x1001u64, 0xAAAAu64, 0x5555u64);
    let snap_fmt_r = axdiff_snapshot_empty(0x1002u64, 0xAAAAu64, 0x5555u64);
    let rep_fmt = axdiff_compare_snapshots(mut_view(eng), view(snap_fmt_l), view(snap_fmt_r), DIFF_MODE_SEMANTIC);
    if !rep_fmt.formatting_only || rep_fmt.semantic_change_count != 0u32 ||
        rep_fmt.changes[0].change_kind != DIFF_CHANGE_FORMATTING_ONLY {
        return 11;
    }

    // Nine-state lattice (`DIFF-INV-06..07`): `Incomparable` never collapses to `Identical`
    let mut snap_incomp = snap_fmt_l;
    snap_incomp.comparable = false;
    let rep_inc = axdiff_compare_snapshots(mut_view(eng), view(snap_incomp), view(snap_fmt_l), DIFF_MODE_SEMANTIC);
    if rep_inc.overall_status != DIFF_STATUS_INCOMPARABLE || rep_inc.overall_status == DIFF_STATUS_IDENTICAL {
        return 12;
    }

    // Multi-item semantic diff:
    // - `key=10`: intra-module declaration order change (`0 -> 1`) -> `Moved` (`Exact`)
    // - `key=20 -> 21`: cross-name rename (`calc -> compute`, same body) -> `Renamed` (`Strong`, never `Exact`!)
    // - `key=30`: capability change (`view -> mut_view`) -> `CapabilityChanged` (`Breaking`)
    // - `key=40`: `@repr(C)` struct layout size change (`16 -> 24`) -> `LayoutChanged` (`AbiImpact.Breaking`)
    let mut snap_l = axdiff_snapshot_empty(0x2001u64, 0xBBB1u64, 0x5555u64);
    let mut snap_r = axdiff_snapshot_empty(0x2002u64, 0xBBB2u64, 0x5555u64);

    let it_reord_l = axdiff_item_decl_new(1u64, 10u64, 100u64, DIFF_ITEM_FUNCTION, true, false, RECEIVER_CAP_VIEW, 0u8, 100u8, 0u32, 10u32, 30u32, 0x71u64, 0x81u64, 1u64, 0u64, 0u32, 0u32, 0u64, 0u64);
    let it_reord_r = axdiff_item_decl_new(1u64, 10u64, 100u64, DIFF_ITEM_FUNCTION, true, false, RECEIVER_CAP_VIEW, 0u8, 100u8, 1u32, 50u32, 70u32, 0x71u64, 0x81u64, 1u64, 0u64, 0u32, 0u32, 0u64, 0u64);

    let it_ren_l = axdiff_item_decl_new(1u64, 20u64, 200u64, DIFF_ITEM_FUNCTION, true, false, RECEIVER_CAP_VIEW, 0u8, 100u8, 1u32, 40u32, 60u32, 0x72u64, 0x82u64, 1u64, 0u64, 0u32, 0u32, 0u64, 0u64);
    let it_ren_r = axdiff_item_decl_new(1u64, 21u64, 201u64, DIFF_ITEM_FUNCTION, true, false, RECEIVER_CAP_VIEW, 0u8, 100u8, 0u32, 10u32, 30u32, 0x72u64, 0x82u64, 1u64, 0u64, 0u32, 0u32, 0u64, 0u64);

    let it_cap_l = axdiff_item_decl_new(1u64, 30u64, 300u64, DIFF_ITEM_FUNCTION, true, false, RECEIVER_CAP_VIEW, 0u8, 100u8, 2u32, 80u32, 100u32, 0x73u64, 0x83u64, 1u64, 0u64, 0u32, 0u32, 0u64, 0u64);
    let it_cap_r = axdiff_item_decl_new(1u64, 30u64, 300u64, DIFF_ITEM_FUNCTION, true, false, RECEIVER_CAP_MUT_VIEW, 0u8, 100u8, 2u32, 80u32, 100u32, 0x73u64, 0x83u64, 1u64, 0u64, 0u32, 0u32, 0u64, 0u64);

    let it_lay_l = axdiff_item_decl_new(1u64, 40u64, 400u64, DIFF_ITEM_STRUCT, true, false, 0u8, 1u8, 100u8, 3u32, 110u32, 140u32, 0x74u64, 0x84u64, 1u64, 0u64, 16u32, 8u32, 0u64, 0u64);
    let it_lay_r = axdiff_item_decl_new(1u64, 40u64, 400u64, DIFF_ITEM_STRUCT, true, false, 0u8, 1u8, 100u8, 3u32, 110u32, 140u32, 0x74u64, 0x84u64, 1u64, 0u64, 24u32, 8u32, 0u64, 0u64);

    let _ = axdiff_snapshot_add_item(mut_view(snap_l), it_reord_l);
    let _ = axdiff_snapshot_add_item(mut_view(snap_l), it_ren_l);
    let _ = axdiff_snapshot_add_item(mut_view(snap_l), it_cap_l);
    let _ = axdiff_snapshot_add_item(mut_view(snap_l), it_lay_l);

    let _ = axdiff_snapshot_add_item(mut_view(snap_r), it_ren_r);
    let _ = axdiff_snapshot_add_item(mut_view(snap_r), it_reord_r);
    let _ = axdiff_snapshot_add_item(mut_view(snap_r), it_cap_r);
    let _ = axdiff_snapshot_add_item(mut_view(snap_r), it_lay_r);

    let rep_sem = axdiff_compare_snapshots(mut_view(eng), view(snap_l), view(snap_r), DIFF_MODE_SEMANTIC);
    if rep_sem.change_count != 4u32 || rep_sem.moved_count != 1u32 || rep_sem.renamed_count != 1u32 ||
        rep_sem.breaking_change_count != 3u32 || rep_sem.abi_impact != ABI_IMPACT_BREAKING {
        return 13;
    }
    // Sorted by `ChangeKind ordinal`: `Moved (5)`, `Renamed (6)`, `CapabilityChanged (11)`, `LayoutChanged (14)`
    if rep_sem.changes[0].change_kind != DIFF_CHANGE_MOVED || rep_sem.changes[0].evidence != DIFF_EVIDENCE_EXACT ||
        rep_sem.changes[1].change_kind != DIFF_CHANGE_RENAMED || rep_sem.changes[1].evidence != DIFF_EVIDENCE_STRONG ||
        rep_sem.changes[2].change_kind != DIFF_CHANGE_CAPABILITY_CHANGED ||
        rep_sem.changes[3].change_kind != DIFF_CHANGE_LAYOUT_CHANGED {
        return 14;
    }

    // ========================================================================
    // Phase 2: `AXMERGE` Three-Way AST Merge & Conflict Detection (`SPEC-102 §5`)
    // ========================================================================
    let mut mb_clean = axmerge_bundle_new(MERGE_POLICY_STRICT);
    mb_clean.base_import_mask = 3u32;       // 0b0011
    mb_clean.left_removed_import_mask = 1u32; // remove bit 0
    mb_clean.left_added_import_mask = 4u32;   // add bit 2
    mb_clean.right_added_import_mask = 8u32;  // add bit 3 -> merged = 0b1110 (14)

    // Item 1: Idempotent convergence (`LEFT` and `RIGHT` apply identical body change `0x80 -> 0x89`)
    let e_b1 = axmerge_entity_new(true, DIFF_ITEM_FUNCTION, 100u64, 1000u64, 1u64, 0x70u64, 0x80u64, 1u64, 1u64, 0u32, 0u32, 10u32);
    let e_l1 = axmerge_entity_new(true, DIFF_ITEM_FUNCTION, 100u64, 1000u64, 1u64, 0x70u64, 0x89u64, 1u64, 1u64, 0u32, 0u32, 10u32);
    let e_r1 = axmerge_entity_new(true, DIFF_ITEM_FUNCTION, 100u64, 1000u64, 1u64, 0x70u64, 0x89u64, 1u64, 1u64, 0u32, 0u32, 10u32);
    let _ = axmerge_bundle_add_item(mut_view(mb_clean), MERGE_ID_LEVEL_SYMBOL_KEY, e_b1, e_l1, e_r1, true);

    // Item 2: Rename (`LEFT`: `2000 -> 2001`) + body modification (`RIGHT`: `0x90 -> 0x99`) -> auto-merged!
    let e_b2 = axmerge_entity_new(true, DIFF_ITEM_FUNCTION, 200u64, 2000u64, 1u64, 0x75u64, 0x90u64, 1u64, 1u64, 0u32, 0u32, 40u32);
    let e_l2 = axmerge_entity_new(true, DIFF_ITEM_FUNCTION, 200u64, 2001u64, 1u64, 0x75u64, 0x90u64, 1u64, 1u64, 0u32, 0u32, 40u32);
    let e_r2 = axmerge_entity_new(true, DIFF_ITEM_FUNCTION, 200u64, 2000u64, 1u64, 0x75u64, 0x99u64, 1u64, 1u64, 0u32, 0u32, 40u32);
    let _ = axmerge_bundle_add_item(mut_view(mb_clean), MERGE_ID_LEVEL_RENAME_MOVE_FINGERPRINT, e_b2, e_l2, e_r2, true);

    let mres_ok = axmerge_three_way(mut_view(eng), view(mb_clean));
    if mres_ok.status != MERGE_STATUS_CLEAN || !mres_ok.verified_by_compiler_db || mres_ok.conflict_count != 0u32 ||
        mres_ok.merged_import_mask != 14u32 || !mres_ok.merged_items[0].converged_idempotent ||
        !mres_ok.merged_items[1].auto_merged_rename_and_body || mres_ok.merged_items[1].final_name_hash != 2001u64 ||
        mres_ok.merged_items[1].final_body_ast_hash != 0x99u64 {
        return 21;
    }

    // Structural conflict (`RenameIdentityConflict` + `SignatureConflict`) & canonical 3-way conflict markers
    let mut mb_conf = axmerge_bundle_new(MERGE_POLICY_STRICT);
    let e_r2_conf = axmerge_entity_new(true, DIFF_ITEM_FUNCTION, 200u64, 2002u64, 1u64, 0x75u64, 0x90u64, 1u64, 1u64, 0u32, 0u32, 40u32);
    let _ = axmerge_bundle_add_item(mut_view(mb_conf), MERGE_ID_LEVEL_SYMBOL_KEY, e_b2, e_l2, e_r2_conf, false);
    let mres_conf = axmerge_three_way(mut_view(eng), view(mb_conf));
    if mres_conf.status != MERGE_STATUS_CONFLICTED || mres_conf.conflict_count != 1u32 ||
        mres_conf.conflicts[0].conflict_kind != CONFLICT_RENAME_IDENTITY ||
        !axmerge_has_canonical_conflict_markers(mres_conf.conflict_marker_sample) {
        return 22;
    }

    // Post-merge `CompilerDB` verification conflict (`AX_MOVE_USE_AFTER_MOVE = 3101`) downgrades `Clean` to `SemanticConflict`
    let mut mb_sem_conf = mb_clean;
    mb_sem_conf.post_merge_compiler_diag = DIAG_MOVE_USE_AFTER_MOVE;
    mb_sem_conf.post_merge_target_key = 200u64;
    let mres_sem_conf = axmerge_three_way(mut_view(eng), view(mb_sem_conf));
    if mres_sem_conf.status != MERGE_STATUS_SEMANTIC_CONFLICT || mres_sem_conf.verified_by_compiler_db ||
        mres_sem_conf.conflicts[0].conflict_kind != CONFLICT_SEMANTIC_VERIFICATION ||
        mres_sem_conf.conflicts[0].compiler_diag_code != DIAG_MOVE_USE_AFTER_MOVE {
        return 23;
    }

    // ========================================================================
    // Phase 3: `AXPATCH` Relocation, Atomic Rollback, Inversion, Compose & Rebase (`SPEC-102 §6`)
    // ========================================================================
    let mut p_body = axpatch_new(PATCH_KIND_SEMANTIC, 0x1111u64, 0x2222u64, 0x3333u64);
    let mut op_mod = axpatch_op_empty();
    op_mod.op_id = 1u32;
    op_mod.doc_id = doc0;
    op_mod.op_kind = PATCH_OP_MODIFY_ITEM_BODY;
    op_mod.precond_kind = PRECOND_SYMBOL_BODY_AST_HASH_IS;
    op_mod.target_symbol_key = 500u64;
    op_mod.new_symbol_key = 500u64;
    op_mod.before_ast_hash = 0x888u64;
    op_mod.after_ast_hash = 0x999u64;
    op_mod.recorded_span_start = 20u32;
    op_mod.recorded_span_end = 30u32;
    op_mod.before_text = lsp_str_view("return x + 1");
    op_mod.after_text = lsp_str_view("return x + 2");
    let _ = axpatch_add_op(mut_view(p_body), op_mod);

    // Target relocated (`current_span_start = 52 != recorded_span_start = 20`) -> `AppliedRelocated`
    let mut ws_state = axpatch_workspace_state_new(0x1999u64, 0x2222u64, 0x3333u64);
    let tf_reloc = PatchWorkspaceTargetFact {
        symbol_key: 500u64,
        module_hash: 1u64,
        sig_hash: 0x777u64,
        body_ast_hash: 0x888u64,
        context_anchor_hash: 0u64,
        current_span_start: 52u32,
        current_span_end: 64u32,
        match_multiplicity: 1u8,
    };
    let _ = axpatch_workspace_add_target(mut_view(ws_state), tf_reloc);
    let pres_reloc = axpatch_apply_transaction(mut_view(eng), mut_view(ws), view(p_body), view(ws_state), false);
    if pres_reloc.status != PATCH_STATUS_APPLIED_RELOCATED || pres_reloc.relocated_op_count != 1u32 ||
        !pres_reloc.verified_by_compiler_db || pres_reloc.resulting_ast_hash != 0x3333u64 {
        return 31;
    }

    // Exact patch inversion `axpatch_reverse(p_body)` restores `base_ast_hash = 0x2222`
    let p_inv = axpatch_reverse(view(p_body));
    let mut ws_state_after = axpatch_workspace_state_new(0x1999u64, 0x3333u64, 0x2222u64);
    let tf_after = PatchWorkspaceTargetFact {
        symbol_key: 500u64,
        module_hash: 1u64,
        sig_hash: 0x777u64,
        body_ast_hash: 0x999u64,
        context_anchor_hash: 0u64,
        current_span_start: 52u32,
        current_span_end: 64u32,
        match_multiplicity: 1u8,
    };
    let _ = axpatch_workspace_add_target(mut_view(ws_state_after), tf_after);
    let pres_inv = axpatch_apply_transaction(mut_view(eng), mut_view(ws), view(p_inv), view(ws_state_after), false);
    if pres_inv.resulting_ast_hash != 0x2222u64 || !pres_inv.verified_by_compiler_db {
        return 32;
    }

    // Transactional rollback when post-patch `CompilerDB` verification fails (`simulate_compiler_verify_failure == true`)
    let dp0 = vfs_doc_ptr(view(ws), doc0);
    let len_before_fail = editor_snapshot(unsafe { view((*dp0).editor) }).byte_len;
    let mut ws_state_fail = ws_state;
    ws_state_fail.simulate_compiler_verify_failure = true;
    let pres_fail = axpatch_apply_transaction(mut_view(eng), mut_view(ws), view(p_body), view(ws_state_fail), false);
    let len_after_fail = editor_snapshot(unsafe { view((*dp0).editor) }).byte_len;
    if pres_fail.status != PATCH_STATUS_SEMANTIC_VERIFICATION_FAILED || !pres_fail.rolled_back ||
        len_after_fail != len_before_fail {
        return 33;
    }

    // `axpatch_compose`: chained `Rename(10 -> 20)` + `Rename(20 -> 30)` collapses to `Rename(10 -> 30)`
    let mut p_ren1 = axpatch_new(PATCH_KIND_SEMANTIC, 1u64, 10u64, 20u64);
    let mut op_r1 = axpatch_op_empty();
    op_r1.op_kind = PATCH_OP_RENAME_SYMBOL;
    op_r1.target_symbol_key = 10u64;
    op_r1.new_symbol_key = 20u64;
    let _ = axpatch_add_op(mut_view(p_ren1), op_r1);

    let mut p_ren2 = axpatch_new(PATCH_KIND_SEMANTIC, 2u64, 20u64, 30u64);
    let mut op_r2 = axpatch_op_empty();
    op_r2.op_kind = PATCH_OP_RENAME_SYMBOL;
    op_r2.target_symbol_key = 20u64;
    op_r2.new_symbol_key = 30u64;
    let _ = axpatch_add_op(mut_view(p_ren2), op_r2);

    let comp_res = axpatch_compose(view(p_ren1), view(p_ren2));
    if !comp_res.ok || comp_res.collapsed_rename_count != 1u32 ||
        comp_res.composed_patch.op_count != 1u32 || comp_res.composed_patch.ops[0].new_symbol_key != 30u64 {
        return 34;
    }

    // `axpatch_rebase`: adapts patch across upstream `Moved` (`key=10`) and `Renamed` (`key=20 -> 21`) in `rep_sem`
    let mut p_to_rebase = axpatch_new(PATCH_KIND_SEMANTIC, 1u64, 0xBBB1u64, 0xCCC1u64);
    let mut op_on_20 = axpatch_op_empty();
    op_on_20.op_kind = PATCH_OP_MODIFY_ITEM_BODY;
    op_on_20.target_symbol_key = 20u64;
    let _ = axpatch_add_op(mut_view(p_to_rebase), op_on_20);
    let reb_res = axpatch_rebase(view(p_to_rebase), view(rep_sem), 0xBBB2u64);
    if !reb_res.ok || reb_res.adapted_rename_count != 1u32 || reb_res.rebased_patch.ops[0].target_symbol_key != 21u64 {
        return 35;
    }

    // ========================================================================
    // Phase 4: `AXHISTORY` Symbol Lineage & `AXVCS` Determinism (`SPEC-102 §7`)
    // ========================================================================
    let mut repo = vcs_repo_new();
    let c1 = vcs_commit_revision(mut_view(repo), 0u64, 0u64, 0x101u64, 0x201u64, 0x301u64, 1700000000u64, 0xAAu64);
    let c1_diff_ts = vcs_commit_revision(mut_view(repo), 0u64, 0u64, 0x101u64, 0x201u64, 0x301u64, 1999999999u64, 0xBBu64);
    if c1.status != VCS_OK || c1.revision_id != c1_diff_ts.revision_id {
        return 41;
    }
    let c2 = vcs_commit_revision(mut_view(repo), c1.revision_id, 0u64, 0x102u64, 0x202u64, 0x302u64, 1700000100u64, 0xAAu64);
    let c3 = vcs_commit_revision(mut_view(repo), c2.revision_id, 0u64, 0x103u64, 0x203u64, 0x303u64, 1700000200u64, 0xAAu64);
    let c4 = vcs_commit_revision(mut_view(repo), c3.revision_id, 0u64, 0x104u64, 0x204u64, 0x304u64, 1700000300u64, 0xAAu64);

    // Record symbol lineage: `Created(key=100) -> Renamed(100->200, sig+cap change) -> Moved(200->300, fmt-only) -> ExtractedFrom(300->400, fmt-only)`
    let _ = vcs_record_lineage_edge(mut_view(repo), LineageEdge {
        revision_id: c1.revision_id, parent_revision_id: 0u64, kind: LINEAGE_CREATED,
        modified_property_mask: PROP_MASK_SIGNATURE, evidence: DIFF_EVIDENCE_EXACT, resurrection_provenance: false,
        prior_symbol_key: 0u64, current_symbol_key: 100u64, patch_id: 0x301u64,
    });
    let _ = vcs_record_lineage_edge(mut_view(repo), LineageEdge {
        revision_id: c2.revision_id, parent_revision_id: c1.revision_id, kind: LINEAGE_RENAMED,
        modified_property_mask: PROP_MASK_CAPABILITY, evidence: DIFF_EVIDENCE_STRONG, resurrection_provenance: false,
        prior_symbol_key: 100u64, current_symbol_key: 200u64, patch_id: 0x302u64,
    });
    let _ = vcs_record_lineage_edge(mut_view(repo), LineageEdge {
        revision_id: c3.revision_id, parent_revision_id: c2.revision_id, kind: LINEAGE_MOVED,
        modified_property_mask: PROP_MASK_FORMATTING_ONLY, evidence: DIFF_EVIDENCE_STRONG, resurrection_provenance: false,
        prior_symbol_key: 200u64, current_symbol_key: 300u64, patch_id: 0x303u64,
    });
    let _ = vcs_record_lineage_edge(mut_view(repo), LineageEdge {
        revision_id: c4.revision_id, parent_revision_id: c3.revision_id, kind: LINEAGE_EXTRACTED_FROM,
        modified_property_mask: PROP_MASK_FORMATTING_ONLY, evidence: DIFF_EVIDENCE_EXACT, resurrection_provenance: false,
        prior_symbol_key: 300u64, current_symbol_key: 400u64, patch_id: 0x304u64,
    });

    let hist_400 = vcs_history_of_symbol(view(repo), 400u64);
    if !hist_400.found || hist_400.event_count != 4u32 ||
        hist_400.events[0].kind != LINEAGE_EXTRACTED_FROM ||
        hist_400.events[3].kind != LINEAGE_CREATED || hist_400.events[3].current_symbol_key != 100u64 {
        return 42;
    }

    // Property-level blame for `PROP_MASK_CAPABILITY` skips 2 formatting-only revisions (`c4`, `c3`) and blames `c2` (`patch_id = 0x302`)
    let blame_cap = vcs_blame_symbol_property(view(repo), 400u64, PROP_MASK_CAPABILITY);
    if !blame_cap.found || blame_cap.blamed_revision_id != c2.revision_id ||
        blame_cap.blamed_patch_id != 0x302u64 || blame_cap.skipped_formatting_commits != 2u32 {
        return 43;
    }

    // Non-resurrected recreation (`HISTORY-INV-14`): delete `900` then recreate `900` without resurrection -> stops at new `Created`!
    let _ = vcs_record_lineage_edge(mut_view(repo), LineageEdge {
        revision_id: c1.revision_id, parent_revision_id: 0u64, kind: LINEAGE_CREATED,
        modified_property_mask: PROP_MASK_SIGNATURE, evidence: DIFF_EVIDENCE_EXACT, resurrection_provenance: false,
        prior_symbol_key: 0u64, current_symbol_key: 900u64, patch_id: 0x301u64,
    });
    let _ = vcs_record_lineage_edge(mut_view(repo), LineageEdge {
        revision_id: c2.revision_id, parent_revision_id: c1.revision_id, kind: LINEAGE_REMOVED,
        modified_property_mask: 0u8, evidence: DIFF_EVIDENCE_EXACT, resurrection_provenance: false,
        prior_symbol_key: 900u64, current_symbol_key: 0u64, patch_id: 0x302u64,
    });
    let _ = vcs_record_lineage_edge(mut_view(repo), LineageEdge {
        revision_id: c3.revision_id, parent_revision_id: c2.revision_id, kind: LINEAGE_CREATED,
        modified_property_mask: PROP_MASK_SIGNATURE, evidence: DIFF_EVIDENCE_EXACT, resurrection_provenance: false,
        prior_symbol_key: 0u64, current_symbol_key: 900u64, patch_id: 0x303u64,
    });
    let hist_900 = vcs_history_of_symbol(view(repo), 900u64);
    if hist_900.event_count != 1u32 || !hist_900.stopped_at_non_resurrected_recreate {
        return 44;
    }

    // `AXVCS` permutation-invariant `Tree` & `Semantic` snapshot ordering (`VCS-INV-06..09, 37`)
    let te_a = VcsTreeEntry { path_key_hi: 1u64, path_key_lo: 10u64, had_backslash: false, entry_mode: 0o100644u32, object_kind: OBJ_BLOB, object_id: 11u64, semantic_file_hash: 111u64 };
    let te_b = VcsTreeEntry { path_key_hi: 1u64, path_key_lo: 20u64, had_backslash: true, entry_mode: 0o100644u32, object_kind: OBJ_BLOB, object_id: 22u64, semantic_file_hash: 222u64 };
    let te_c = VcsTreeEntry { path_key_hi: 1u64, path_key_lo: 30u64, had_backslash: false, entry_mode: 0o100644u32, object_kind: OBJ_BLOB, object_id: 33u64, semantic_file_hash: 333u64 };
    let tr1 = vcs_build_tree_snapshot(mut_view(repo), [te_c, te_a, te_b, te_a, te_a, te_a, te_a, te_a], 3u32);
    let tr2 = vcs_build_tree_snapshot(mut_view(repo), [te_b, te_c, te_a, te_a, te_a, te_a, te_a, te_a], 3u32);
    let sem1 = vcs_build_semantic_snapshot(mut_view(repo), [30u64, 10u64, 20u64, 0u64, 0u64, 0u64, 0u64, 0u64], [300u64, 100u64, 200u64, 0u64, 0u64, 0u64, 0u64, 0u64], 3u32);
    let sem2 = vcs_build_semantic_snapshot(mut_view(repo), [20u64, 30u64, 10u64, 0u64, 0u64, 0u64, 0u64, 0u64], [200u64, 300u64, 100u64, 0u64, 0u64, 0u64, 0u64, 0u64], 3u32);
    if tr1.tree_object_id != tr2.tree_object_id || tr1.normalized_backslash_count != 1u32 || sem1 != sem2 {
        return 45;
    }

    // Object integrity verification & atomic CAS refs (`VCS-INV-03, 11..15, 24`)
    let blob_id = vcs_put_object(mut_view(repo), OBJ_BLOB, 0xFACEu64);
    let _ = vcs_corrupt_object_for_test(mut_view(repo), blob_id);
    let rd_corrupt = vcs_verify_and_get_object(view(repo), blob_id);
    if rd_corrupt.status != VCS_INTEGRITY_ERROR {
        return 46;
    }
    let main_ref: u64 = 0x7777u64;
    let cas1 = vcs_update_ref_cas(mut_view(repo), REF_HEADS, main_ref, 0u64, c2.revision_id);
    let cas_stale = vcs_update_ref_cas(mut_view(repo), REF_HEADS, main_ref, c1.revision_id, c3.revision_id);
    let fetch_rc = vcs_fetch_remote(mut_view(repo), main_ref, c4.revision_id);
    let push_ff = vcs_push_remote(view(repo), c2.revision_id, c4.revision_id, false);
    let push_non_ff = vcs_push_remote(view(repo), c4.revision_id, c2.revision_id, false);
    let _ = vcs_git_adapter_map(mut_view(repo), 0x99887766u64, c4.revision_id);
    if cas1 != VCS_OK || cas_stale != VCS_CAS_CONFLICT || fetch_rc != VCS_OK ||
        vcs_get_ref(view(repo), REF_HEADS, main_ref) != c2.revision_id ||
        vcs_get_ref(view(repo), REF_REMOTES, main_ref) != c4.revision_id ||
        push_ff != VCS_OK || push_non_ff != VCS_NON_FAST_FORWARD ||
        vcs_git_lookup_rev(view(repo), 0x99887766u64) != c4.revision_id {
        return 47;
    }

    // ========================================================================
    // Phase 5: CLI Entrypoints (`axiomc diff`, `merge`, `patch`, `history`) (`SPEC-102 §7.4`)
    // ========================================================================
    let mut cli_diff = refactor_cmd_config_default();
    let _ = refactor_cmd_parse_arg(mut_view(cli_diff), "diff");
    let _ = refactor_cmd_parse_arg(mut_view(cli_diff), "--mode=semantic");
    let _ = refactor_cmd_parse_arg(mut_view(cli_diff), "--json");
    let out_diff_fmt = refactor_cmd_run_diff(mut_view(eng), view(cli_diff), view(snap_fmt_l), view(snap_fmt_r));
    let out_diff_brk = refactor_cmd_run_diff(mut_view(eng), view(cli_diff), view(snap_l), view(snap_r));

    let mut cli_merge = refactor_cmd_config_default();
    let _ = refactor_cmd_parse_arg(mut_view(cli_merge), "merge");
    let _ = refactor_cmd_parse_arg(mut_view(cli_merge), "--json");
    let out_m_ok = refactor_cmd_run_merge(mut_view(eng), view(cli_merge), view(mb_clean));
    let out_m_conf = refactor_cmd_run_merge(mut_view(eng), view(cli_merge), view(mb_conf));

    let mut cli_hist = refactor_cmd_config_default();
    let _ = refactor_cmd_parse_arg(mut_view(cli_hist), "history");
    let _ = refactor_cmd_parse_arg(mut_view(cli_hist), "--blame=cap");
    let out_hist = refactor_cmd_run_history(view(cli_hist), view(repo), 400u64);

    let mut cli_bad = refactor_cmd_config_default();
    let _ = refactor_cmd_parse_arg(mut_view(cli_bad), "--unknown-flag");
    let out_bad = refactor_cmd_run_diff(mut_view(eng), view(cli_bad), view(snap_fmt_l), view(snap_fmt_r));

    if out_diff_fmt.exit_code != EXIT_OK || out_diff_brk.exit_code != EXIT_DIFF_OR_CONFLICT ||
        out_m_ok.exit_code != EXIT_OK || out_m_conf.exit_code != EXIT_DIFF_OR_CONFLICT ||
        out_hist.exit_code != EXIT_OK || out_hist.result_hash != c2.revision_id ||
        out_bad.exit_code != EXIT_CLI_USAGE_ERROR || out_bad.diag_code != DIAG_DRIVER_UNKNOWN_OPTION ||
        ws.codegen_invocations != 0u32 {
        return 51;
    }

    print("P1_AXDIFF_FMT_SEM=0 P1_MOVED=1 P1_RENAMED=1 P1_BREAKING=3 P1_INCOMP=8\n");
    print("P2_AXMERGE_IMPORTS=14 P2_IDEM=true P2_REN_BODY=true P2_SEM_CONFLICT_DIAG=3101\n");
    print("P3_AXPATCH_RELOC=1 P3_ROLLBACK=true P3_COMPOSE_REN=1 P3_REBASE_KEY=21\n");
    print("P4_AXHIST_HOPS=4 P4_BLAME_SKIP_FMT=2 P4_TREE_DET=true P4_CAS_CONFLICT=3\n");
    print("P5_CLI_DIFF_OK=0 P5_CLI_BRK=1 P5_CLI_MERGE_OK=0 P5_CLI_BAD=2 CODEGEN=0\n");

    lsp_engine_free(mut_view(eng));
    vfs_workspace_free(mut_view(ws));
    return 0;
}
