// test: run
// stdout: OK\n

const STRS: [4]Str = ["", "hello", "a", ""];

@derive(Copy)
struct Item {
    tag: u32,
    name: Str,
}

const ITEMS: [3]Item = [
    Item { tag: 10u32, name: "" },
    Item { tag: 20u32, name: "item20" },
    Item { tag: 30u32, name: "third" }
];

fn main() -> i32 {
    if len(STRS[0]) != 0 { return 1; }
    if len(STRS[1]) != 5 { return 2; }
    if len(STRS[2]) != 1 { return 3; }
    if len(STRS[3]) != 0 { return 4; }

    if ITEMS[0].tag != 10u32 || len(ITEMS[0].name) != 0 { return 5; }
    if ITEMS[1].tag != 20u32 || len(ITEMS[1].name) != 6 { return 6; }
    if ITEMS[2].tag != 30u32 || len(ITEMS[2].name) != 5 { return 7; }
    print("OK\n");
    return 0;
}
