// test: run
// exit: 100

const TABLE_A: [4]i32 = [10, 20, 30, 40];
const TABLE_B: [4]i32 = [10, 20, 30, 40];

fn main() -> i32 {
    if TABLE_A[0] != TABLE_B[0] { return 1; }
    if TABLE_A[1] != TABLE_B[1] { return 2; }
    if TABLE_A[2] != TABLE_B[2] { return 3; }
    if TABLE_A[3] != TABLE_B[3] { return 4; }
    return TABLE_A[0] + TABLE_B[1] + TABLE_A[2] + TABLE_B[3];
}
