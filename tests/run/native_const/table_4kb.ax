// test: run
// stdout: OK 4KB\n

const TABLE_4KB: [4096]u8 = [42u8; 4096];

fn index_table() -> u8 {
    TABLE_4KB[2048]
}

fn main() -> i32 {
    let v0 = TABLE_4KB[0];
    let v1 = index_table();
    let v2 = TABLE_4KB[4095];
    if v0 != 42u8 { return 1; }
    if v1 != 42u8 { return 2; }
    if v2 != 42u8 { return 3; }
    print("OK 4KB\n");
    return 0;
}
