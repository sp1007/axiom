// test: run
// modes: interp native
// stdout-file: jsonrpc_lifecycle_and_cancellation.stdout
// SPEC-100 AXS-LSP-008, AXS-LSP-010:
// JSON-RPC 2.0 Content-Length framing, server lifecycle state machine
// (`-32002 ServerNotInitialized`, `initialize`, `initialized`, `shutdown`, `exit`),
// `$/cancelRequest`, and revision-superseding cancellation (`-32800 RequestCancelled`).

const STATE_UNINITIALIZED: u8 = 0u8;
const STATE_INITIALIZING: u8 = 1u8;
const STATE_RUNNING: u8 = 2u8;
const STATE_SHUTTING_DOWN: u8 = 3u8;
const STATE_EXITED: u8 = 4u8;

const ERR_NONE: i32 = 0i32;
const ERR_PARSE_ERROR: i32 = -32700i32;
const ERR_INVALID_REQUEST: i32 = -32600i32;
const ERR_SERVER_NOT_INITIALIZED: i32 = -32002i32;
const ERR_REQUEST_CANCELLED: i32 = -32800i32;

@derive(Copy)
struct InflightReq {
    active: bool,
    cancelled: bool,
    superseded: bool,
    req_id: i64,
    bound_rev: u64,
}

struct MiniSession {
    state: u8,
    rev: u64,
    exit_code: i32,
    reqs: [8]InflightReq,
}

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

@derive(Copy)
struct RawStr {
    ptr: *const u8,
    len: usize,
}

fn str_byte_len(s: str) -> usize {
    let raw: RawStr = unsafe { *(address_of(s) as *const RawStr) };
    raw.len
}

fn check_content_length_header(hdr: str) -> i32 {
    let hraw: RawStr = unsafe { *(address_of(hdr) as *const RawStr) };
    let hlen = hraw.len;
    let hbytes: view<[u8]> = unsafe { *(address_of(hdr) as *const view<[u8]>) };
    let pfx = "Content-Length: ";
    let pbytes: view<[u8]> = unsafe { *(address_of(pfx) as *const view<[u8]>) };
    let plen = 16;
    if hlen < (plen + 4) {
        return ERR_PARSE_ERROR;
    }
    let mut i: usize = 0;
    while i < plen {
        if hbytes[i] != pbytes[i] {
            return ERR_PARSE_ERROR;
        }
        i = i + 1;
    }
    let mut val: i32 = 0i32;
    let mut digits: usize = 0;
    while (i + 3) < hlen {
        let b = hbytes[i];
        if b == 13u8 && hbytes[i + 1] == 10u8 &&
            hbytes[i + 2] == 13u8 && hbytes[i + 3] == 10u8 {
            if digits == 0 {
                return ERR_PARSE_ERROR;
            }
            return val;
        }
        if b >= 48u8 && b <= 57u8 {
            val = (val * 10i32) + ((b - 48u8) as i32);
            digits = digits + 1;
            i = i + 1;
        } else {
            return ERR_PARSE_ERROR;
        }
    }
    ERR_PARSE_ERROR
}

fn begin_read_request(s: mut_view<MiniSession>, req_id: i64, slot: usize) -> i32 {
    if s.state == STATE_UNINITIALIZED {
        return ERR_SERVER_NOT_INITIALIZED;
    }
    if s.state == STATE_SHUTTING_DOWN || s.state == STATE_EXITED {
        return ERR_INVALID_REQUEST;
    }
    s.reqs[slot] = InflightReq {
        active: true,
        cancelled: false,
        superseded: false,
        req_id: req_id,
        bound_rev: s.rev,
    };
    ERR_NONE
}

fn cancel_request(s: mut_view<MiniSession>, target_id: i64) {
    let mut i: usize = 0;
    while i < 8 {
        if s.reqs[i].active && s.reqs[i].req_id == target_id {
            s.reqs[i].cancelled = true;
        }
        i = i + 1;
    }
}

fn advance_revision_did_change(s: mut_view<MiniSession>) {
    s.rev = s.rev + 1u64;
    let mut i: usize = 0;
    while i < 8 {
        if s.reqs[i].active && (s.reqs[i].bound_rev) < (s.rev) {
            s.reqs[i].superseded = true;
        }
        i = i + 1;
    }
}

fn finish_request(s: view<MiniSession>, slot: usize) -> i32 {
    if s.reqs[slot].cancelled || s.reqs[slot].superseded {
        return ERR_REQUEST_CANCELLED;
    }
    ERR_NONE
}

pub fn main() -> i32 {
    let valid_len = check_content_length_header("Content-Length: 42\r\n\r\n");
    let bad_len = check_content_length_header("X-Bad: 42\r\n\r\n");
    if valid_len != 42i32 || bad_len != ERR_PARSE_ERROR {
        return 1;
    }

    let mut s = MiniSession {
        state: STATE_UNINITIALIZED,
        rev: 1u64,
        exit_code: -1i32,
        reqs: [InflightReq {
            active: false,
            cancelled: false,
            superseded: false,
            req_id: 0i64,
            bound_rev: 0u64,
        }; 8],
    };

    // Pre-initialize request must fail with -32002
    if begin_read_request(mut_view(s), 1i64, 0) != ERR_SERVER_NOT_INITIALIZED {
        return 2;
    }

    // Initialize + Initialized
    s.state = STATE_INITIALIZING;
    s.state = STATE_RUNNING;

    // Request #10 cancelled via $/cancelRequest -> -32800
    if begin_read_request(mut_view(s), 10i64, 0) != ERR_NONE {
        return 3;
    }
    cancel_request(mut_view(s), 10i64);
    if finish_request(view(s), 0) != ERR_REQUEST_CANCELLED {
        return 4;
    }

    // Request #11 superseded by textDocument/didChange -> -32800
    if begin_read_request(mut_view(s), 11i64, 1) != ERR_NONE {
        return 5;
    }
    advance_revision_did_change(mut_view(s));
    if finish_request(view(s), 1) != ERR_REQUEST_CANCELLED {
        return 6;
    }

    // Shutdown -> post-shutdown request fails with -32600 -> exit sets exit_code = 0
    s.state = STATE_SHUTTING_DOWN;
    if begin_read_request(mut_view(s), 12i64, 2) != ERR_INVALID_REQUEST {
        return 7;
    }
    s.exit_code = if s.state == STATE_SHUTTING_DOWN { 0i32 } else { 1i32 };
    s.state = STATE_EXITED;
    if s.exit_code != 0i32 {
        return 8;
    }

    print("JSONRPC-LIFECYCLE-AND-CANCELLATION-OK\n");
    0
}
