// test: run
// modes: interp
// stdout: Xin chào thế giới
// native-after: T042

@intrinsic fn assert(c: bool) {}

fn main() {
    print("Xin chào thế giới");
    let s: Str = "Xin chào thế giới";
    let b: Str = b"Xin ch\xc3\xa0o th\xe1\xba\xbf gi\xe1\xbb\x9bi";
    assert(len(s) == 22);
    assert(len(b) == 22);
}
