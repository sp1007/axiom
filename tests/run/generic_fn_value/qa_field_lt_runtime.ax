// test: run
// stdout: 1\n0\n1\n0\n1\n
// exit: 0
// QA T422a FU-A at run time: `a.f < b.g` is a comparison whose result is observable, including with a
// shift on the right (`x.n < y.n >> 1`), a method call on the right and a bool combination.

struct T {
    n: i64,
    m: i64,
}

impl T {
    fn get(self: view<T>) -> i64 {
        return self.n;
    }
}

fn b2i(b: bool) -> i64 {
    if b {
        return 1;
    }
    return 0;
}

fn main() -> i32 {
    let a = T { n: 3, m: 40 };
    let b = T { n: 5, m: 8 };
    print_int(b2i(a.n < b.n));
    print("\n");
    print_int(b2i(b.n < a.n));
    print("\n");
    print_int(b2i(a.n < b.m >> 1));
    print("\n");
    print_int(b2i(a.m < b.m >> 1));
    print("\n");
    print_int(b2i(a.n < b.get() && b.n < a.m));
    print("\n");
    return 0;
}
