// test: run
// stdout: 5\n1\n
// exit: 0
// T422a FU-J: `id<Box2<i32>>` ends in `>>` followed by `;`; the closing `>` is split. A field `<` a shift
// expression (`a.n < b.n >> 1`) stays a comparison.

struct Box2<T> {
    v: T,
    n: i32,
}

fn mk<T>(x: T) -> Box2<T> {
    return Box2<T> { v: x, n: 4 };
}

fn id<T>(x: T) -> T {
    return x;
}

fn main() -> i32 {
    let a: fn(Box2<i32>) -> Box2<i32> = id<Box2<i32>>;
    let b = a(mk<i32>(5));
    let c = mk<i32>(9);
    print_int(b.v as i64);
    print("\n");
    if b.n < c.n >> 1 {
        print_int(0i64);
    } else {
        print_int(1i64);
    }
    print("\n");
    return 0;
}
