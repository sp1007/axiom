// test: run
// stdout: 5\n6\n9\n
// exit: 0
// QA T422a: an inferred generic function value (`apply(id, 5)`), a plain function value and `id<i64>` bound with let.

fn id<T>(x: T) -> T { return x; }
fn apply(f: fn(i32) -> i32, v: i32) -> i32 { return f(v); }
fn plain(x: i32) -> i32 { return x + 1; }
fn main() -> i32 {
    print_int(apply(id, 5) as i64);
    print("\n");
    print_int(apply(plain, 5) as i64);
    print("\n");
    let h = id<i64>;
    print_int(h(9i64));
    print("\n");
    return 0;
}
