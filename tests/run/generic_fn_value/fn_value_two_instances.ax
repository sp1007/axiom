// test: run
// stdout: 4\n8\n2\n1\n
// exit: 0
// T422a FU-J: several instantiations of one generic function used as values, including `tag<T>` formed
// inside a generic function (the T422 use case: a generic poll function built from a type parameter).

@intrinsic fn size_of<T>() -> usize { 0 }

fn tag<T>(x: T) -> i64 {
    return size_of<T>() as i64;
}

fn make<T>() -> fn(T) -> i64 {
    return tag<T>;
}

fn pick(flag: bool) -> fn(u8) -> i64 {
    let a: fn(u8) -> i64 = tag<u8>;
    let b: fn(u8) -> i64 = make<u8>();
    if flag {
        return a;
    }
    return b;
}

fn main() -> i32 {
    let a: fn(u32) -> i64 = tag<u32>;
    let b: fn(u64) -> i64 = tag<u64>;
    print_int(a(1u32));
    print("\n");
    print_int(b(2u64));
    print("\n");
    let m = make<u16>();
    print_int(m(3u16));
    print("\n");
    let p = pick(false);
    print_int(p(4u8));
    print("\n");
    return 0;
}
