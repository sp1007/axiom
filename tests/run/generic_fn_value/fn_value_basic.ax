// test: run
// stdout: 42\n7\n9\n
// exit: 0
// T422a FU-J: `g<T>` as a function-pointer value, plain and passed as an argument.

fn id<T>(x: T) -> T {
    return x;
}

fn twice<T>(x: T) -> T {
    return id<T>(id<T>(x));
}

fn apply(f: fn(i32) -> i32, v: i32) -> i32 {
    return f(v);
}

fn main() -> i32 {
    let f: fn(i32) -> i32 = id<i32>;
    print_int(f(42) as i64);
    print("\n");
    print_int(apply(id<i32>, 7) as i64);
    print("\n");
    let g: fn(i32) -> i32 = twice<i32>;
    print_int(g(9) as i64);
    print("\n");
    return 0;
}
