// test: run
// stdout: 1\n2\n4\n8\n|1\n4\n|8\n2\n|7\n18\n81\n|2\n3\n
// exit: 0
// QA T422a: distinct instantiations of one generic function used as values in an array, a struct field,
// a match arm, a function argument, a return value and from inside a generic function; plus an inferred
// generic value and a two-parameter generic.

@intrinsic fn size_of<T>() -> usize { 0 }

fn sz<T>() -> i64 {
    return size_of<T>() as i64;
}

fn pair<A, B>(a: A, b: B) -> i64 {
    return (size_of<A>() * 10 + size_of<B>()) as i64;
}

struct Holder {
    f: fn() -> i64,
}

fn mk<T>() -> fn() -> i64 {
    return sz<T>;
}

fn call(f: fn() -> i64) -> i64 {
    return f();
}

fn choose(k: i32) -> fn() -> i64 {
    return match k {
        0 => sz<u8>,
        1 => sz<u32>,
        _ => sz<u64>,
    };
}

fn inc(x: i32) -> i32 {
    return x + 1;
}

fn ident<T>(x: T) -> T {
    return x;
}

fn main() -> i32 {
    let arr = [sz<u8>, sz<u16>, sz<u32>, sz<u64>];
    let mut i = 0;
    while i < 4 {
        print_int(arr[i]());
        print("\n");
        i = i + 1;
    }
    print("|");
    let h1 = Holder { f: sz<u8> };
    let h2 = Holder { f: sz<u32> };
    let f1 = h1.f;
    print_int(f1());
    print("\n");
    let f2 = h2.f;
    print_int(f2());
    print("\n");
    print("|");
    print_int(call(choose(2)));
    print("\n");
    print_int(call(mk<u16>()));
    print("\n");
    print("|");
    let g: fn(i32) -> i32 = ident<i32>;
    print_int(g(7) as i64);
    print("\n");
    let p: fn(u8, u64) -> i64 = pair<u8, u64>;
    let q: fn(u64, u8) -> i64 = pair<u64, u8>;
    print_int(p(1u8, 2u64));
    print("\n");
    print_int(q(1u64, 2u8));
    print("\n");
    print("|");
    let gi: fn(i32) -> i32 = ident;
    print_int(gi(2) as i64);
    print("\n");
    let k: fn(i32) -> i32 = inc;
    print_int(k(2) as i64);
    print("\n");
    return 0;
}
