// test: run
// modes: interp native
// stdout-file: axmi_freshness_diff_and_bounds_seam.stdout
// SPEC-24 AXS-ART-003..004, AXS-ART-013..014, AXS-ART-023:
// Boundary cross-check for:
// 1. Checked 64-bit bounds arithmetic (`offset + size` wraparound) and non-overlapping
//    ascending `(section_type, id)` section table invariants.
// 2. Four-state artifact freshness classification (`Fresh`, `Stale`, `Unknown`, `Invalid`)
//    and fine-grained semantic diff (`API`, `ABI`, `Layout`, `Effect`, `Const`).
// 3. Required CPU feature mask compatibility (`AVX2` vs baseline) and strict `GenericMir`
//    schema version verification (`AX_ART_VERSION_MISMATCH`).

const AXMI_FORMAT_VERSION: u16 = 1u16;
const AXMI_MIR_SCHEMA_VERSION: u16 = 1u16;

const AXMI_FRESHNESS_FRESH: u8 = 1u8;
const AXMI_FRESHNESS_STALE: u8 = 2u8;
const AXMI_FRESHNESS_UNKNOWN: u8 = 3u8;
const AXMI_FRESHNESS_INVALID: u8 = 4u8;

const STATUS_OK: u32 = 0u32;
const AX_ART_CORRUPT_HEADER: u32 = 9501u32;
const AX_ART_VERSION_MISMATCH: u32 = 9502u32;
const AX_ART_TARGET_MISMATCH: u32 = 9503u32;

@derive(Copy)
struct SectionSpan {
    id: u32,
    section_type: u16,
    align: u32,
    offset: u64,
    size: u64,
}

@derive(Copy)
struct InterfaceSnapshot {
    schema_version: u16,
    target_fp: u64,
    cpu_feature_mask: u32,
    mir_schema_version: u16,
    interface_fp: u64,
    abi_fp: u64,
    layout_fp: u64,
    effect_fp: u64,
    const_fp: u64,
    body_fp: u64,
}

@derive(Copy)
struct DiffSummary {
    api_changed: bool,
    abi_changed: bool,
    layout_changed: bool,
    effect_changed: bool,
    const_changed: bool,
    freshness: u8,
}

fn check_bounds_u64(offset: u64, size: u64, total_size: u64) -> bool {
    if offset > total_size || size > total_size {
        return false;
    }
    if size > (total_size - offset) {
        return false;
    }
    true
}

fn validate_section_pair(s0: SectionSpan, s1: SectionSpan, payload_start: u64, total_size: u64) -> u32 {
    if (s0.offset % (s0.align as u64)) != 0u64 || (s1.offset % (s1.align as u64)) != 0u64 {
        return AX_ART_CORRUPT_HEADER;
    }
    if (s0.offset) < payload_start || !check_bounds_u64(s0.offset, s0.size, total_size) {
        return AX_ART_CORRUPT_HEADER;
    }
    let s0_end = s0.offset + s0.size;
    if (s1.offset) < s0_end || !check_bounds_u64(s1.offset, s1.size, total_size) {
        return AX_ART_CORRUPT_HEADER;
    }
    if (s1.section_type) < (s0.section_type) || (s1.section_type == s0.section_type && (s1.id) < (s0.id)) {
        return AX_ART_CORRUPT_HEADER;
    }
    STATUS_OK
}

fn classify_freshness(
    loaded: InterfaceSnapshot,
    expected_target_fp: u64,
    session_cpu_mask: u32,
    upstream_interface_fp: u64,
    upstream_abi_fp: u64
) -> u8 {
    if loaded.schema_version != AXMI_FORMAT_VERSION || loaded.mir_schema_version != AXMI_MIR_SCHEMA_VERSION {
        return AXMI_FRESHNESS_INVALID;
    }
    if loaded.target_fp != expected_target_fp {
        return AXMI_FRESHNESS_INVALID;
    }
    if (loaded.cpu_feature_mask & (~session_cpu_mask)) != 0u32 {
        return AXMI_FRESHNESS_INVALID;
    }
    if upstream_interface_fp == 0u64 {
        return AXMI_FRESHNESS_UNKNOWN;
    }
    if loaded.interface_fp == upstream_interface_fp && loaded.abi_fp == upstream_abi_fp {
        return AXMI_FRESHNESS_FRESH;
    }
    AXMI_FRESHNESS_STALE
}

fn validate_target_and_mir(loaded: InterfaceSnapshot, expected_target_fp: u64, session_cpu_mask: u32) -> u32 {
    if loaded.schema_version != AXMI_FORMAT_VERSION || loaded.mir_schema_version != AXMI_MIR_SCHEMA_VERSION {
        return AX_ART_VERSION_MISMATCH;
    }
    if loaded.target_fp != expected_target_fp || (loaded.cpu_feature_mask & (~session_cpu_mask)) != 0u32 {
        return AX_ART_TARGET_MISMATCH;
    }
    STATUS_OK
}

fn diff_snapshots(old_s: InterfaceSnapshot, new_s: InterfaceSnapshot) -> DiffSummary {
    let api_c = old_s.interface_fp != new_s.interface_fp;
    let abi_c = old_s.abi_fp != new_s.abi_fp;
    let lay_c = old_s.layout_fp != new_s.layout_fp;
    let eff_c = old_s.effect_fp != new_s.effect_fp;
    let cst_c = old_s.const_fp != new_s.const_fp;
    let fresh = if !api_c && !abi_c && !lay_c && !eff_c && !cst_c {
        AXMI_FRESHNESS_FRESH
    } else {
        AXMI_FRESHNESS_STALE
    };
    DiffSummary {
        api_changed: api_c,
        abi_changed: abi_c,
        layout_changed: lay_c,
        effect_changed: eff_c,
        const_changed: cst_c,
        freshness: fresh,
    }
}

pub fn main() -> i32 {
    // 1. Checked 64-bit bounds arithmetic overflow & section ordering/overlap checks
    if !check_bounds_u64(160u64, 64u64, 512u64) {
        return 1;
    }
    if check_bounds_u64(0xFFFFFFFFFFFFFFF0u64, 0x20u64, 0xFFFFFFFFFFFFFFFFu64) {
        return 2;
    }
    let s0 = SectionSpan { id: 0u32, section_type: 1u16, align: 8u32, offset: 160u64, size: 64u64 };
    let s1_ok = SectionSpan { id: 1u32, section_type: 2u16, align: 8u32, offset: 224u64, size: 64u64 };
    let s1_overlap = SectionSpan { id: 1u32, section_type: 2u16, align: 8u32, offset: 200u64, size: 64u64 };
    let s1_order = SectionSpan { id: 1u32, section_type: 1u16, align: 8u32, offset: 224u64, size: 64u64 };
    let s0_hi_id = SectionSpan { id: 2u32, section_type: 1u16, align: 8u32, offset: 160u64, size: 64u64 };
    if validate_section_pair(s0, s1_ok, 160u64, 512u64) != STATUS_OK {
        return 3;
    }
    if validate_section_pair(s0, s1_overlap, 160u64, 512u64) != AX_ART_CORRUPT_HEADER {
        return 4;
    }
    if validate_section_pair(s0_hi_id, s1_order, 160u64, 512u64) != AX_ART_CORRUPT_HEADER {
        return 5;
    }

    // 2. Freshness states (`Fresh`, `Stale`, `Unknown`, `Invalid`) & fine-grained diffs
    let base = InterfaceSnapshot {
        schema_version: 1u16,
        target_fp: 0x57494E36345F5838u64,
        cpu_feature_mask: 0x01u32,
        mir_schema_version: 1u16,
        interface_fp: 0x1111222233334444u64,
        abi_fp: 0xAAAABBBBCCCCDDDDu64,
        layout_fp: 0x1010101020202020u64,
        effect_fp: 0x3030303040404040u64,
        const_fp: 0x5050505060606060u64,
        body_fp: 0x7070707080808080u64,
    };

    // Private body edit only (`body_fp` changes, `interface_fp` and `abi_fp` stay identical)
    let mut priv_edit = base;
    priv_edit.body_fp = 0x9999999988888888u64;
    let d_priv = diff_snapshots(base, priv_edit);
    let f_priv = classify_freshness(base, base.target_fp, 0x03u32, priv_edit.interface_fp, priv_edit.abi_fp);
    if d_priv.api_changed || d_priv.abi_changed || f_priv != AXMI_FRESHNESS_FRESH {
        return 6;
    }

    // Effect contract edit (`effect_fp` & `interface_fp` change, `abi_fp` unchanged)
    let mut eff_edit = base;
    eff_edit.effect_fp = 0x3030303040404099u64;
    eff_edit.interface_fp = 0x1111222233339999u64;
    let d_eff = diff_snapshots(base, eff_edit);
    let f_eff = classify_freshness(base, base.target_fp, 0x03u32, eff_edit.interface_fp, eff_edit.abi_fp);
    if !d_eff.api_changed || d_eff.abi_changed || !d_eff.effect_changed || f_eff != AXMI_FRESHNESS_STALE {
        return 7;
    }

    // Layout edit (`layout_fp`, `abi_fp`, and `interface_fp` change)
    let mut lay_edit = base;
    lay_edit.layout_fp = 0x1010101020209999u64;
    lay_edit.abi_fp = 0xAAAABBBBCCCC9999u64;
    lay_edit.interface_fp = 0x1111222299994444u64;
    let d_lay = diff_snapshots(base, lay_edit);
    if !d_lay.api_changed || !d_lay.abi_changed || !d_lay.layout_changed || d_lay.freshness != AXMI_FRESHNESS_STALE {
        return 8;
    }

    // Unknown upstream fingerprint (`0`) -> `AXMI_FRESHNESS_UNKNOWN`
    let f_unk = classify_freshness(base, base.target_fp, 0x03u32, 0u64, base.abi_fp);
    if f_unk != AXMI_FRESHNESS_UNKNOWN {
        return 9;
    }

    // 3. CPU feature mask mismatch & MIR schema version mismatch
    let mut avx2_art = base;
    avx2_art.cpu_feature_mask = 0x04u32;
    if validate_target_and_mir(avx2_art, base.target_fp, 0x01u32) != AX_ART_TARGET_MISMATCH {
        return 10;
    }
    if classify_freshness(avx2_art, base.target_fp, 0x01u32, base.interface_fp, base.abi_fp) != AXMI_FRESHNESS_INVALID {
        return 11;
    }

    let mut mir_v2_art = base;
    mir_v2_art.mir_schema_version = 2u16;
    if validate_target_and_mir(mir_v2_art, base.target_fp, 0x03u32) != AX_ART_VERSION_MISMATCH {
        return 12;
    }

    print("bounds_and_sections: overflow_rejected=true overlap_rejected=true order_rejected=true\n");
    print("freshness_and_diff: priv=Fresh eff=Stale(api=true,abi=false) layout=Stale(api=true,abi=true) zero_fp=Unknown\n");
    print("cpu_and_mir_schema: avx2_mismatch=AX_ART_TARGET_MISMATCH mir_v2=AX_ART_VERSION_MISMATCH\n");
    print("AXMI-FRESHNESS-DIFF-BOUNDS-SEAM-OK\n");
    0
}
