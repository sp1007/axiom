// test: run
// modes: interp native
// stdout-file: axmi_generic_inline_and_cap_contracts.stdout
// SPEC-24 AXS-ART-011..013:
// Generic & `@inline` Verified MIR template export (`clamp_pair<T: Metric>`),
// trait impl coherence verification (`impl Metric for Pair`), and cross-module
// ownership/capability/effect contracts (`view`/`mut_view`, borrow return mask,
// no-escape mask, purity, and panic contract).

const PASS_MOVE: u8 = 0u8;
const PASS_COPY: u8 = 1u8;
const PASS_VIEW: u8 = 2u8;
const PASS_MUT_VIEW: u8 = 3u8;

const EFF_PURE: u32 = 0u32;
const EFF_READS_MEM: u32 = 1u32;
const EFF_WRITES_MEM: u32 = 2u32;

const CAP_NONE: u32 = 0u32;
const PANIC_NO_PANIC: u8 = 0u8;

@derive(Copy)
struct FnContractSummary {
    def_id: u32,
    param_count: u32,
    param0_mode: u8,
    param1_mode: u8,
    return_borrows_mask: u32,
    no_escape_mask: u32,
    effect_mask: u32,
    cap_mask: u32,
    panic_contract: u8,
    is_pure: bool,
}

@derive(Copy)
struct MirTemplateEntry {
    def_id: u32,
    schema_version: u16,
    is_generic: bool,
    is_inline: bool,
    ownership_verified: bool,
    trait_bound_id: u32,
    block_count: u32,
    local_count: u32,
    inst_count: u32,
}

@derive(Copy)
struct TraitImplRecord {
    trait_id: u32,
    self_type_id: u32,
    impl_def_id: u32,
    is_object_safe: bool,
}

fn can_instantiate_generic(tmpl: MirTemplateEntry, tr: TraitImplRecord, concrete_type_id: u32) -> bool {
    if !tmpl.ownership_verified || tmpl.schema_version != 1u16 {
        return false;
    }
    if tmpl.trait_bound_id != 0u32 {
        if tr.trait_id != tmpl.trait_bound_id || tr.self_type_id != concrete_type_id {
            return false;
        }
    }
    true
}

pub fn main() -> i32 {
    let borrow_x_contract = FnContractSummary {
        def_id: 2u32,
        param_count: 1u32,
        param0_mode: PASS_VIEW,
        param1_mode: PASS_COPY,
        return_borrows_mask: 1u32,
        no_escape_mask: 1u32,
        effect_mask: EFF_READS_MEM,
        cap_mask: CAP_NONE,
        panic_contract: PANIC_NO_PANIC,
        is_pure: false,
    };

    let mut_scale_contract = FnContractSummary {
        def_id: 5u32,
        param_count: 2u32,
        param0_mode: PASS_MUT_VIEW,
        param1_mode: PASS_COPY,
        return_borrows_mask: 0u32,
        no_escape_mask: 3u32,
        effect_mask: EFF_READS_MEM | EFF_WRITES_MEM,
        cap_mask: CAP_NONE,
        panic_contract: PANIC_NO_PANIC,
        is_pure: false,
    };

    let clamp_tmpl = MirTemplateEntry {
        def_id: 3u32,
        schema_version: 1u16,
        is_generic: true,
        is_inline: true,
        ownership_verified: true,
        trait_bound_id: 6u32,
        block_count: 3u32,
        local_count: 5u32,
        inst_count: 14u32,
    };

    let unverified_tmpl = MirTemplateEntry {
        def_id: 99u32,
        schema_version: 1u16,
        is_generic: false,
        is_inline: true,
        ownership_verified: false,
        trait_bound_id: 0u32,
        block_count: 1u32,
        local_count: 1u32,
        inst_count: 2u32,
    };

    let metric_pair_impl = TraitImplRecord {
        trait_id: 6u32,
        self_type_id: 10u32,
        impl_def_id: 7u32,
        is_object_safe: true,
    };

    if borrow_x_contract.param0_mode != PASS_VIEW || borrow_x_contract.return_borrows_mask != 1u32 {
        return 1;
    }
    if mut_scale_contract.param0_mode != PASS_MUT_VIEW || mut_scale_contract.no_escape_mask != 3u32 {
        return 2;
    }
    if !can_instantiate_generic(clamp_tmpl, metric_pair_impl, 10u32) {
        return 3;
    }
    // Type 99 does not implement Metric -> fails closed
    if can_instantiate_generic(clamp_tmpl, metric_pair_impl, 99u32) {
        return 4;
    }
    // Unverified MIR template -> rejected (INV-PIPE-002)
    if can_instantiate_generic(unverified_tmpl, metric_pair_impl, 10u32) {
        return 5;
    }

    print("fn_contract borrow_x: mode0=view ret_borrows=1 no_escape=1 effects=1 panic=NoPanic\n");
    print("fn_contract mut_scale: mode0=mut_view ret_borrows=0 no_escape=3 effects=3 panic=NoPanic\n");
    print("mir_instantiate clamp_pair<Pair>: verified=true blocks=3 locals=5 insts=14 bound_ok=true\n");
    print("AXMI-GENERIC-CAP-CONTRACTS-OK\n");
    0
}
