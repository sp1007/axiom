// test: run
// modes: interp native
// stdout-file: axmi_fail_closed_validation.stdout
// SPEC-24 AXS-ART-002..005, AXS-ART-050..053:
// Fail-closed `.axmi` binary validation (`AX_ART_CORRUPT_HEADER` / `AX_LINK_BAD_ARTIFACT`,
// `AX_ART_VERSION_MISMATCH` / `AX_LINK_ARTIFACT_SCHEMA_MISMATCH`, `AX_ART_TARGET_MISMATCH` /
// `AX_LINK_ARTIFACT_TARGET_MISMATCH`, `AX_ART_CHECKSUM_MISMATCH`) and forward/backward
// compatibility rule (unknown section with `OPTIONAL` flag succeeds; without `OPTIONAL` fails).

const STATUS_OK: u32 = 0u32;
const AX_ART_CORRUPT_HEADER: u32 = 9501u32;
const AX_ART_VERSION_MISMATCH: u32 = 9502u32;
const AX_ART_TARGET_MISMATCH: u32 = 9503u32;
const AX_ART_CHECKSUM_MISMATCH: u32 = 9504u32;

const AXMI_MAGIC_U64: u64 = 0x31303030494D5841u64;
const AXMI_SCHEMA_VERSION: u16 = 1u16;
const SEC_FLAG_OPTIONAL: u16 = 0x0010u16;

@derive(Copy)
struct HeaderPacket {
    magic: u64,
    schema_version: u16,
    total_len: u32,
    section_align: u32,
    section_offset: u32,
    unknown_sec_type: u16,
    unknown_sec_flags: u16,
    target_fp: u64,
    stored_checksum: u64,
    computed_checksum: u64,
}

fn validate_packet(pkt: HeaderPacket, expected_target_fp: u64) -> u32 {
    let plen = pkt.total_len;
    if plen < 64u32 || pkt.magic != AXMI_MAGIC_U64 {
        return AX_ART_CORRUPT_HEADER;
    }
    if pkt.section_align != 8u32 || (pkt.section_offset % pkt.section_align) != 0u32 {
        return AX_ART_CORRUPT_HEADER;
    }
    if pkt.schema_version != AXMI_SCHEMA_VERSION {
        return AX_ART_VERSION_MISMATCH;
    }
    if pkt.stored_checksum != pkt.computed_checksum {
        return AX_ART_CHECKSUM_MISMATCH;
    }
    if pkt.unknown_sec_type != 0u16 {
        if (pkt.unknown_sec_flags & SEC_FLAG_OPTIONAL) == 0u16 {
            return AX_ART_VERSION_MISMATCH;
        }
    }
    if pkt.target_fp != expected_target_fp {
        return AX_ART_TARGET_MISMATCH;
    }
    STATUS_OK
}

fn valid_packet() -> HeaderPacket {
    HeaderPacket {
        magic: AXMI_MAGIC_U64,
        schema_version: AXMI_SCHEMA_VERSION,
        total_len: 512u32,
        section_align: 8u32,
        section_offset: 448u32,
        unknown_sec_type: 0u16,
        unknown_sec_flags: 0u16,
        target_fp: 0x57494E36345F5838u64,
        stored_checksum: 0xABCD1234567890EFu64,
        computed_checksum: 0xABCD1234567890EFu64,
    }
}

pub fn main() -> i32 {
    let exp_tgt: u64 = 0x57494E36345F5838u64;
    let base = valid_packet();
    if validate_packet(base, exp_tgt) != STATUS_OK {
        return 1;
    }

    // 1. Corrupt magic
    let mut bad_magic = base;
    bad_magic.magic = 0x00303030494D5841u64;
    if validate_packet(bad_magic, exp_tgt) != AX_ART_CORRUPT_HEADER {
        return 2;
    }

    // 2. Truncated buffer
    let mut trunc = base;
    trunc.total_len = 32u32;
    if validate_packet(trunc, exp_tgt) != AX_ART_CORRUPT_HEADER {
        return 3;
    }

    // 3. Schema version mismatch
    let mut bad_ver = base;
    bad_ver.schema_version = 99u16;
    if validate_packet(bad_ver, exp_tgt) != AX_ART_VERSION_MISMATCH {
        return 4;
    }

    // 4. Unknown section with OPTIONAL flag -> succeeds
    let mut opt_sec = base;
    opt_sec.unknown_sec_type = 90u16;
    opt_sec.unknown_sec_flags = SEC_FLAG_OPTIONAL;
    if validate_packet(opt_sec, exp_tgt) != STATUS_OK {
        return 5;
    }

    // 5. Unknown section without OPTIONAL flag -> fails closed
    let mut req_sec = base;
    req_sec.unknown_sec_type = 91u16;
    req_sec.unknown_sec_flags = 0u16;
    if validate_packet(req_sec, exp_tgt) != AX_ART_VERSION_MISMATCH {
        return 6;
    }

    // 6. Target mismatch
    let mut bad_tgt = base;
    bad_tgt.target_fp = 0x4C4E5836345F4152u64;
    if validate_packet(bad_tgt, exp_tgt) != AX_ART_TARGET_MISMATCH {
        return 7;
    }

    // 7. Checksum mismatch
    let mut bad_cksum = base;
    bad_cksum.computed_checksum = 0xABCD1234567890EEu64;
    if validate_packet(bad_cksum, exp_tgt) != AX_ART_CHECKSUM_MISMATCH {
        return 8;
    }

    print("validate corrupt_magic: AX_ART_CORRUPT_HEADER/AX_LINK_BAD_ARTIFACT\n");
    print("validate future_v99: AX_ART_VERSION_MISMATCH/AX_LINK_ARTIFACT_SCHEMA_MISMATCH\n");
    print("validate unknown_optional_sec: OK\n");
    print("validate unknown_required_sec: AX_ART_VERSION_MISMATCH/AX_LINK_ARTIFACT_SCHEMA_MISMATCH\n");
    print("validate wrong_target: AX_ART_TARGET_MISMATCH/AX_LINK_ARTIFACT_TARGET_MISMATCH\n");
    print("validate bitflip_payload: AX_ART_CHECKSUM_MISMATCH/AX_LINK_BAD_ARTIFACT\n");
    print("AXMI-FAIL-CLOSED-VALIDATION-OK\n");
    0
}
