// test: run
// modes: interp native
// stdout-file: axmi_roundtrip_and_source_free_import.stdout
// SPEC-24 AXS-ART-001..004, AXS-ART-010, AXS-ART-014, INV-ART-001:
// Deterministic `.axmi` serialization (allocation-order independence via `SemanticKey` sorting),
// stripping of private helpers (`REQ-LNK-540`), and source-free downstream resolution of
// `struct Pair`, `const SCALE_FACTOR`, `fn add_pair`, and `fn scale_pair`.

const AXMI_MAGIC_U64: u64 = 0x31303030494D5841u64;
const AXMI_FORMAT_VERSION: u32 = 1u32;
const AXMI_FLAG_DETERMINISTIC: u32 = 3u32;

@derive(Copy)
struct ExportSym {
    semantic_ord: u32,
    is_pub: bool,
    is_generic: bool,
    is_inline: bool,
    param_count: u32,
    ret_type_id: u32,
    sig_hash: u64,
}

struct AxmiImage {
    magic: u64,
    version: u32,
    flags: u32,
    section_count: u32,
    stripped_private: u32,
    target_fp: u64,
    interface_fp: u64,
    content_hash: u64,
    sym_count: u32,
    sym0_ord: u32,
    sym0_hash: u64,
    sym1_ord: u32,
    sym1_hash: u64,
    sym2_ord: u32,
    sym2_hash: u64,
    pair_size: u32,
    pair_align: u32,
    scale_const: i64,
}

fn mix64(h: u64, v: u64) -> u64 {
    let x = (h ^ v) ^ ((h << 13u64) | (h >> 51u64));
    x ^ ((v << 7u64) | (v >> 57u64)) ^ 0x9E3779B97F4A7C15u64
}

fn register_sym(img: mut_view<AxmiImage>, sym: view<ExportSym>) {
    if !sym.is_pub && !sym.is_generic && !sym.is_inline {
        img.stripped_private = img.stripped_private + 1u32;
        return;
    }
    let idx = img.sym_count;
    if idx == 0u32 {
        img.sym0_ord = sym.semantic_ord;
        img.sym0_hash = sym.sig_hash;
    } else if idx == 1u32 {
        img.sym1_ord = sym.semantic_ord;
        img.sym1_hash = sym.sig_hash;
    } else if idx == 2u32 {
        img.sym2_ord = sym.semantic_ord;
        img.sym2_hash = sym.sig_hash;
    }
    img.sym_count = idx + 1u32;
}

fn finalize_axmi(img: mut_view<AxmiImage>) {
    // Sort exported symbols by canonical `semantic_ord` (`SemanticKey` order)
    if (img.sym0_ord) > (img.sym1_ord) {
        let to = img.sym0_ord;
        let th = img.sym0_hash;
        img.sym0_ord = img.sym1_ord;
        img.sym0_hash = img.sym1_hash;
        img.sym1_ord = to;
        img.sym1_hash = th;
    }
    if (img.sym1_ord) > (img.sym2_ord) {
        let to = img.sym1_ord;
        let th = img.sym1_hash;
        img.sym1_ord = img.sym2_ord;
        img.sym1_hash = img.sym2_hash;
        img.sym2_ord = to;
        img.sym2_hash = th;
    }
    if (img.sym0_ord) > (img.sym1_ord) {
        let to = img.sym0_ord;
        let th = img.sym0_hash;
        img.sym0_ord = img.sym1_ord;
        img.sym0_hash = img.sym1_hash;
        img.sym1_ord = to;
        img.sym1_hash = th;
    }

    let mut api_h: u64 = 0x41584D495F415049u64;
    api_h = mix64(api_h, img.sym0_ord as u64);
    api_h = mix64(api_h, img.sym0_hash);
    api_h = mix64(api_h, img.sym1_ord as u64);
    api_h = mix64(api_h, img.sym1_hash);
    api_h = mix64(api_h, img.sym2_ord as u64);
    api_h = mix64(api_h, img.sym2_hash);
    api_h = mix64(api_h, img.pair_size as u64);
    api_h = mix64(api_h, img.scale_const as u64);
    img.interface_fp = api_h;
    img.content_hash = mix64(mix64(img.magic, img.target_fp), img.interface_fp);
}

pub fn main() -> i32 {
    let mut fwd = AxmiImage {
        magic: AXMI_MAGIC_U64,
        version: AXMI_FORMAT_VERSION,
        flags: AXMI_FLAG_DETERMINISTIC,
        section_count: 8u32,
        stripped_private: 0u32,
        target_fp: 0x57494E36345F5838u64,
        interface_fp: 0u64,
        content_hash: 0u64,
        sym_count: 0u32,
        sym0_ord: 0u32,
        sym0_hash: 0u64,
        sym1_ord: 0u32,
        sym1_hash: 0u64,
        sym2_ord: 0u32,
        sym2_hash: 0u64,
        pair_size: 8u32,
        pair_align: 4u32,
        scale_const: 4i64,
    };
    let mut rev = AxmiImage {
        magic: AXMI_MAGIC_U64,
        version: AXMI_FORMAT_VERSION,
        flags: AXMI_FLAG_DETERMINISTIC,
        section_count: 8u32,
        stripped_private: 0u32,
        target_fp: 0x57494E36345F5838u64,
        interface_fp: 0u64,
        content_hash: 0u64,
        sym_count: 0u32,
        sym0_ord: 0u32,
        sym0_hash: 0u64,
        sym1_ord: 0u32,
        sym1_hash: 0u64,
        sym2_ord: 0u32,
        sym2_hash: 0u64,
        pair_size: 8u32,
        pair_align: 4u32,
        scale_const: 4i64,
    };

    let s_priv = ExportSym { semantic_ord: 99u32, is_pub: false, is_generic: false, is_inline: false, param_count: 1u32, ret_type_id: 1u32, sig_hash: 999u64 };
    let s_add = ExportSym { semantic_ord: 1u32, is_pub: true, is_generic: false, is_inline: true, param_count: 2u32, ret_type_id: 10u32, sig_hash: 101u64 };
    let s_clm = ExportSym { semantic_ord: 2u32, is_pub: true, is_generic: true, is_inline: true, param_count: 3u32, ret_type_id: 10u32, sig_hash: 202u64 };
    let s_scl = ExportSym { semantic_ord: 3u32, is_pub: true, is_generic: false, is_inline: false, param_count: 1u32, ret_type_id: 10u32, sig_hash: 303u64 };

    // Forward registration
    register_sym(mut_view(fwd), view(s_priv));
    register_sym(mut_view(fwd), view(s_add));
    register_sym(mut_view(fwd), view(s_clm));
    register_sym(mut_view(fwd), view(s_scl));
    finalize_axmi(mut_view(fwd));

    // Reverse registration
    register_sym(mut_view(rev), view(s_scl));
    register_sym(mut_view(rev), view(s_clm));
    register_sym(mut_view(rev), view(s_add));
    register_sym(mut_view(rev), view(s_priv));
    finalize_axmi(mut_view(rev));

    if fwd.interface_fp != rev.interface_fp || fwd.content_hash != rev.content_hash {
        return 1;
    }
    if fwd.sym_count != 3u32 || fwd.stripped_private != 1u32 {
        return 2;
    }

    // Source-free downstream resolution of `Pair` layout (8, 4) and `SCALE_FACTOR` (4)
    let resolved_val = (fwd.pair_size as i64) * fwd.scale_const + (fwd.pair_align as i64);
    if resolved_val != 36i64 {
        return 3;
    }

    print("axmi_roundtrip: magic=AXMI0001 version=1 sections=8 exported=3 stripped_private=1\n");
    print("source_free_import: Pair(size=8,align=4) SCALE_FACTOR=4 resolved_val=36\n");
    print("AXMI-ROUNDTRIP-SOURCE-FREE-OK\n");
    0
}
