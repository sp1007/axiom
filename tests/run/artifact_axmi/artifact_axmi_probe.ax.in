@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

fn probe_sv(arena: mut_view<Arena>, s: str) -> StrView {
    let raw_sv: StrView = unsafe { *(address_of(s) as *const StrView) };
    let bytes: view<[u8]> = unsafe { *(address_of(s) as *const view<[u8]>) };
    let n = raw_sv.len;
    let dst = arena_alloc_raw(mut_view(*arena), n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = bytes[i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn diag_buf_eq(a: view<DiagBuffer>, b: view<DiagBuffer>) -> bool {
    if a.len != b.len {
        return false;
    }
    let mut i: usize = 0;
    while i < (a.len) {
        let ba = unsafe { *(a.ptr + i) };
        let bb = unsafe { *(b.ptr + i) };
        if ba != bb {
            return false;
        }
        i = i + 1;
    }
    true
}

fn print_diag_buf(b: view<DiagBuffer>) {
    if (b.len) > 0 && (b.ptr as usize) != 0 {
        unsafe {
            let _ = write(stdio(1u32), b.ptr as *const u8, b.len);
        }
    }
}

fn populate_vecmath_forward(str_arena: mut_view<Arena>, iface: mut_view<AxmiModuleInterface>, scale_val: i64, priv_body_seed: u64) -> bool {
    let pkg = probe_sv(mut_view(*str_arena), "core_math");
    let mod_p = probe_sv(mut_view(*str_arena), "core_math.vecmath");
    let trp = probe_sv(mut_view(*str_arena), "x86_64-windows");
    let abi = probe_sv(mut_view(*str_arena), "win64");
    axmi_set_module_identity(mut_view(*iface), pkg, mod_p, trp, abi, 8u32, true, 0u32, AXMI_PANIC_NO_PANIC);

    // 1. Private helper function: must be stripped from `.axmi` (REQ-LNK-540)
    let sk_priv = semantic_key_new(pkg, mod_p, ITEM_NS_VALUE, 0u32, probe_sv(mut_view(*str_arena), "priv_clamp_helper"), qry_sv_empty());
    let kept_priv = axmi_add_symbol(mut_view(*iface), DefId { v: 99u32 }, ITEM_KIND_FN, false, false, false, false, 1u32, TypeId { v: 1u32 }, 0u32, 0u8, sk_priv);
    if kept_priv {
        return false;
    }
    let _ = priv_body_seed;

    // 2. Exported symbols in forward order
    let sk_add = semantic_key_new(pkg, mod_p, ITEM_NS_VALUE, 0u32, probe_sv(mut_view(*str_arena), "add_pair"), qry_sv_empty());
    let sk_bor = semantic_key_new(pkg, mod_p, ITEM_NS_VALUE, 0u32, probe_sv(mut_view(*str_arena), "borrow_x"), qry_sv_empty());
    let sk_clm = semantic_key_new(pkg, mod_p, ITEM_NS_VALUE, 0u32, probe_sv(mut_view(*str_arena), "clamp_pair"), probe_sv(mut_view(*str_arena), "T:Metric"));
    let sk_scl = semantic_key_new(pkg, mod_p, ITEM_NS_CONST, 0u32, probe_sv(mut_view(*str_arena), "SCALE_FACTOR"), qry_sv_empty());
    let sk_par = semantic_key_new(pkg, mod_p, ITEM_NS_TYPE, 0u32, probe_sv(mut_view(*str_arena), "Pair"), qry_sv_empty());
    let sk_mtr = semantic_key_new(pkg, mod_p, ITEM_NS_TRAIT, 0u32, probe_sv(mut_view(*str_arena), "Metric"), qry_sv_empty());
    let sk_imp = semantic_key_new(pkg, mod_p, ITEM_NS_TRAIT, 1u32, probe_sv(mut_view(*str_arena), "impl_Metric_Pair"), qry_sv_empty());

    let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 1u32 }, ITEM_KIND_FN, true, false, true, true, 2u32, TypeId { v: 10u32 }, 0u32, 0u8, sk_add);
    let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 2u32 }, ITEM_KIND_FN, true, false, false, false, 1u32, TypeId { v: 1u32 }, 0u32, 0u8, sk_bor);
    let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 3u32 }, ITEM_KIND_FN, true, true, true, false, 3u32, TypeId { v: 10u32 }, 1u32, 0u8, sk_clm);
    let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 4u32 }, ITEM_KIND_CONST, true, false, false, true, 0u32, TypeId { v: 1u32 }, 0u32, 0u8, sk_scl);
    let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 5u32 }, ITEM_KIND_STRUCT, true, false, false, false, 2u32, TypeId { v: 10u32 }, 0u32, 0u8, sk_par);
    let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 6u32 }, ITEM_KIND_TRAIT, true, false, false, false, 1u32, TypeId { v: 1u32 }, 0u32, 0u8, sk_mtr);
    let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 7u32 }, ITEM_KIND_IMPL, true, false, false, false, 1u32, TypeId { v: 10u32 }, 0u32, 0u8, sk_imp);

    // 3. Exported types & layouts
    let sk_mval = semantic_key_new(pkg, mod_p, ITEM_NS_TYPE, 0u32, probe_sv(mut_view(*str_arena), "MetricVal"), qry_sv_empty());
    axmi_add_type_def(mut_view(*iface), TypeId { v: 10u32 }, DefId { v: 5u32 }, AXMI_ADT_STRUCT, AXMI_REPR_C, 8u32, 4u32, true, true, true, sk_par);
    axmi_add_type_field(mut_view(*iface), TypeId { v: 10u32 }, TypeId { v: 1u32 });
    axmi_add_type_field(mut_view(*iface), TypeId { v: 10u32 }, TypeId { v: 1u32 });

    axmi_add_type_def(mut_view(*iface), TypeId { v: 11u32 }, DefId { v: 6u32 }, AXMI_ADT_STRUCT, AXMI_REPR_TRANSPARENT, 4u32, 4u32, true, true, true, sk_mval);
    axmi_add_type_field(mut_view(*iface), TypeId { v: 11u32 }, TypeId { v: 1u32 });

    // 4. Trait impls
    axmi_add_trait_impl(mut_view(*iface), TraitGoalKey { v: 1u32 }, DefId { v: 6u32 }, TypeId { v: 10u32 }, DefId { v: 7u32 }, 1u32, true, 0u32, sk_imp);

    // 5. Function ownership / capability / effect contracts
    axmi_add_fn_contract(mut_view(*iface), DefId { v: 1u32 }, 2u32, 0u32, 3u32, AXMI_EFF_PURE, AXMI_CAP_NONE, AXMI_PANIC_NO_PANIC, sk_add);
    axmi_set_fn_param_mode(mut_view(*iface), DefId { v: 1u32 }, 0u32, AXMI_PASS_COPY);
    axmi_set_fn_param_mode(mut_view(*iface), DefId { v: 1u32 }, 1u32, AXMI_PASS_COPY);

    axmi_add_fn_contract(mut_view(*iface), DefId { v: 2u32 }, 1u32, 1u32, 1u32, AXMI_EFF_READS_MEM, AXMI_CAP_NONE, AXMI_PANIC_NO_PANIC, sk_bor);
    axmi_set_fn_param_mode(mut_view(*iface), DefId { v: 2u32 }, 0u32, AXMI_PASS_VIEW);

    axmi_add_fn_contract(mut_view(*iface), DefId { v: 3u32 }, 3u32, 0u32, 7u32, AXMI_EFF_PURE, AXMI_CAP_NONE, AXMI_PANIC_NO_PANIC, sk_clm);
    axmi_set_fn_param_mode(mut_view(*iface), DefId { v: 3u32 }, 0u32, AXMI_PASS_MOVE);
    axmi_set_fn_param_mode(mut_view(*iface), DefId { v: 3u32 }, 1u32, AXMI_PASS_VIEW);
    axmi_set_fn_param_mode(mut_view(*iface), DefId { v: 3u32 }, 2u32, AXMI_PASS_VIEW);

    // 6. Exported const values
    let sk_mdim = semantic_key_new(pkg, mod_p, ITEM_NS_CONST, 0u32, probe_sv(mut_view(*str_arena), "MAX_DIM"), qry_sv_empty());
    axmi_add_const_val(mut_view(*iface), ConstEvalKey { v: 1u32 }, DefId { v: 4u32 }, TypeId { v: 1u32 }, AXMI_CONST_INT, scale_val, 0u64, qry_sv_empty(), sk_scl);
    axmi_add_const_val(mut_view(*iface), ConstEvalKey { v: 2u32 }, DefId { v: 8u32 }, TypeId { v: 1u32 }, AXMI_CONST_INT, 16i64, 0u64, qry_sv_empty(), sk_mdim);

    // 7. Verified generic & inlineable MIR templates
    let ok_m1 = axmi_add_mir_template(mut_view(*iface), DefId { v: 1u32 }, MirBodyId { v: 1u32 }, AXMI_MIR_SCHEMA_VERSION, false, true, true, 0u32, 2u32, 1u32, 3u32, 6u32, true, ConstEvalKey { v: 1u32 }, DefId { v: 0u32 }, 101u64, sk_add);
    let ok_m2 = axmi_add_mir_template(mut_view(*iface), DefId { v: 3u32 }, MirBodyId { v: 3u32 }, AXMI_MIR_SCHEMA_VERSION, true, true, false, 1u32, 3u32, 3u32, 5u32, 14u32, true, ConstEvalKey { v: 1u32 }, DefId { v: 6u32 }, 303u64, sk_clm);
    if !ok_m1 || !ok_m2 {
        return false;
    }

    // Reject unverified MIR template (INV-PIPE-002)
    let bad_mir = axmi_add_mir_template(mut_view(*iface), DefId { v: 99u32 }, MirBodyId { v: 99u32 }, AXMI_MIR_SCHEMA_VERSION, false, true, false, 0u32, 1u32, 1u32, 1u32, 2u32, false, ConstEvalKey { v: 0u32 }, DefId { v: 0u32 }, 999u64, sk_priv);
    if bad_mir {
        return false;
    }

    // 8. Dependency edge
    axmi_add_dependency(mut_view(*iface), AXMI_DEP_SEMANTIC_INPUT, probe_sv(mut_view(*str_arena), "std.core"), fingerprint128_new(11u64, 22u64), fingerprint128_new(33u64, 44u64));
    true
}

fn populate_vecmath_reverse(str_arena: mut_view<Arena>, iface: mut_view<AxmiModuleInterface>) -> bool {
    let pkg = probe_sv(mut_view(*str_arena), "core_math");
    let mod_p = probe_sv(mut_view(*str_arena), "core_math.vecmath");
    let trp = probe_sv(mut_view(*str_arena), "x86_64-windows");
    let abi = probe_sv(mut_view(*str_arena), "win64");
    axmi_set_module_identity(mut_view(*iface), pkg, mod_p, trp, abi, 8u32, true, 0u32, AXMI_PANIC_NO_PANIC);

    let sk_add = semantic_key_new(pkg, mod_p, ITEM_NS_VALUE, 0u32, probe_sv(mut_view(*str_arena), "add_pair"), qry_sv_empty());
    let sk_bor = semantic_key_new(pkg, mod_p, ITEM_NS_VALUE, 0u32, probe_sv(mut_view(*str_arena), "borrow_x"), qry_sv_empty());
    let sk_clm = semantic_key_new(pkg, mod_p, ITEM_NS_VALUE, 0u32, probe_sv(mut_view(*str_arena), "clamp_pair"), probe_sv(mut_view(*str_arena), "T:Metric"));
    let sk_scl = semantic_key_new(pkg, mod_p, ITEM_NS_CONST, 0u32, probe_sv(mut_view(*str_arena), "SCALE_FACTOR"), qry_sv_empty());
    let sk_par = semantic_key_new(pkg, mod_p, ITEM_NS_TYPE, 0u32, probe_sv(mut_view(*str_arena), "Pair"), qry_sv_empty());
    let sk_mtr = semantic_key_new(pkg, mod_p, ITEM_NS_TRAIT, 0u32, probe_sv(mut_view(*str_arena), "Metric"), qry_sv_empty());
    let sk_imp = semantic_key_new(pkg, mod_p, ITEM_NS_TRAIT, 1u32, probe_sv(mut_view(*str_arena), "impl_Metric_Pair"), qry_sv_empty());
    let sk_mval = semantic_key_new(pkg, mod_p, ITEM_NS_TYPE, 0u32, probe_sv(mut_view(*str_arena), "MetricVal"), qry_sv_empty());
    let sk_mdim = semantic_key_new(pkg, mod_p, ITEM_NS_CONST, 0u32, probe_sv(mut_view(*str_arena), "MAX_DIM"), qry_sv_empty());
    let sk_priv = semantic_key_new(pkg, mod_p, ITEM_NS_VALUE, 0u32, probe_sv(mut_view(*str_arena), "priv_clamp_helper"), qry_sv_empty());

    // Register in reverse order
    axmi_add_dependency(mut_view(*iface), AXMI_DEP_SEMANTIC_INPUT, probe_sv(mut_view(*str_arena), "std.core"), fingerprint128_new(11u64, 22u64), fingerprint128_new(33u64, 44u64));

    let _ = axmi_add_mir_template(mut_view(*iface), DefId { v: 3u32 }, MirBodyId { v: 3u32 }, AXMI_MIR_SCHEMA_VERSION, true, true, false, 1u32, 3u32, 3u32, 5u32, 14u32, true, ConstEvalKey { v: 1u32 }, DefId { v: 6u32 }, 303u64, sk_clm);
    let _ = axmi_add_mir_template(mut_view(*iface), DefId { v: 1u32 }, MirBodyId { v: 1u32 }, AXMI_MIR_SCHEMA_VERSION, false, true, true, 0u32, 2u32, 1u32, 3u32, 6u32, true, ConstEvalKey { v: 1u32 }, DefId { v: 0u32 }, 101u64, sk_add);

    axmi_add_const_val(mut_view(*iface), ConstEvalKey { v: 2u32 }, DefId { v: 8u32 }, TypeId { v: 1u32 }, AXMI_CONST_INT, 16i64, 0u64, qry_sv_empty(), sk_mdim);
    axmi_add_const_val(mut_view(*iface), ConstEvalKey { v: 1u32 }, DefId { v: 4u32 }, TypeId { v: 1u32 }, AXMI_CONST_INT, 4i64, 0u64, qry_sv_empty(), sk_scl);

    axmi_add_fn_contract(mut_view(*iface), DefId { v: 3u32 }, 3u32, 0u32, 7u32, AXMI_EFF_PURE, AXMI_CAP_NONE, AXMI_PANIC_NO_PANIC, sk_clm);
    axmi_set_fn_param_mode(mut_view(*iface), DefId { v: 3u32 }, 0u32, AXMI_PASS_MOVE);
    axmi_set_fn_param_mode(mut_view(*iface), DefId { v: 3u32 }, 1u32, AXMI_PASS_VIEW);
    axmi_set_fn_param_mode(mut_view(*iface), DefId { v: 3u32 }, 2u32, AXMI_PASS_VIEW);

    axmi_add_fn_contract(mut_view(*iface), DefId { v: 2u32 }, 1u32, 1u32, 1u32, AXMI_EFF_READS_MEM, AXMI_CAP_NONE, AXMI_PANIC_NO_PANIC, sk_bor);
    axmi_set_fn_param_mode(mut_view(*iface), DefId { v: 2u32 }, 0u32, AXMI_PASS_VIEW);

    axmi_add_fn_contract(mut_view(*iface), DefId { v: 1u32 }, 2u32, 0u32, 3u32, AXMI_EFF_PURE, AXMI_CAP_NONE, AXMI_PANIC_NO_PANIC, sk_add);
    axmi_set_fn_param_mode(mut_view(*iface), DefId { v: 1u32 }, 0u32, AXMI_PASS_COPY);
    axmi_set_fn_param_mode(mut_view(*iface), DefId { v: 1u32 }, 1u32, AXMI_PASS_COPY);

    axmi_add_trait_impl(mut_view(*iface), TraitGoalKey { v: 1u32 }, DefId { v: 6u32 }, TypeId { v: 10u32 }, DefId { v: 7u32 }, 1u32, true, 0u32, sk_imp);

    axmi_add_type_def(mut_view(*iface), TypeId { v: 11u32 }, DefId { v: 6u32 }, AXMI_ADT_STRUCT, AXMI_REPR_TRANSPARENT, 4u32, 4u32, true, true, true, sk_mval);
    axmi_add_type_field(mut_view(*iface), TypeId { v: 11u32 }, TypeId { v: 1u32 });

    axmi_add_type_def(mut_view(*iface), TypeId { v: 10u32 }, DefId { v: 5u32 }, AXMI_ADT_STRUCT, AXMI_REPR_C, 8u32, 4u32, true, true, true, sk_par);
    axmi_add_type_field(mut_view(*iface), TypeId { v: 10u32 }, TypeId { v: 1u32 });
    axmi_add_type_field(mut_view(*iface), TypeId { v: 10u32 }, TypeId { v: 1u32 });

    let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 7u32 }, ITEM_KIND_IMPL, true, false, false, false, 1u32, TypeId { v: 10u32 }, 0u32, 0u8, sk_imp);
    let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 6u32 }, ITEM_KIND_TRAIT, true, false, false, false, 1u32, TypeId { v: 1u32 }, 0u32, 0u8, sk_mtr);
    let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 5u32 }, ITEM_KIND_STRUCT, true, false, false, false, 2u32, TypeId { v: 10u32 }, 0u32, 0u8, sk_par);
    let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 4u32 }, ITEM_KIND_CONST, true, false, false, true, 0u32, TypeId { v: 1u32 }, 0u32, 0u8, sk_scl);
    let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 3u32 }, ITEM_KIND_FN, true, true, true, false, 3u32, TypeId { v: 10u32 }, 1u32, 0u8, sk_clm);
    let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 2u32 }, ITEM_KIND_FN, true, false, false, false, 1u32, TypeId { v: 1u32 }, 0u32, 0u8, sk_bor);
    let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 1u32 }, ITEM_KIND_FN, true, false, true, true, 2u32, TypeId { v: 10u32 }, 0u32, 0u8, sk_add);
    let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 99u32 }, ITEM_KIND_FN, false, false, false, false, 1u32, TypeId { v: 1u32 }, 0u32, 0u8, sk_priv);
    true
}

fn test_roundtrip_and_compiler_db_import(str_arena: mut_view<Arena>, out_dump: mut_view<DiagBuffer>) -> bool {
    let mut iface_fwd = axmi_interface_empty();
    let mut iface_rev = axmi_interface_empty();
    axmi_interface_init(mut_view(iface_fwd));
    axmi_interface_init(mut_view(iface_rev));

    if !populate_vecmath_forward(mut_view(*str_arena), mut_view(iface_fwd), 4i64, 111u64) {
        axmi_interface_free(mut_view(iface_fwd));
        axmi_interface_free(mut_view(iface_rev));
        return false;
    }
    if !populate_vecmath_reverse(mut_view(*str_arena), mut_view(iface_rev)) {
        axmi_interface_free(mut_view(iface_fwd));
        axmi_interface_free(mut_view(iface_rev));
        return false;
    }

    let mut buf_fwd = axmi_buf_empty();
    let mut buf_rev = axmi_buf_empty();
    axmi_buf_init(mut_view(buf_fwd), 2048);
    axmi_buf_init(mut_view(buf_rev), 2048);

    let aid_fwd = axmi_serialize(mut_view(iface_fwd), mut_view(buf_fwd));
    let aid_rev = axmi_serialize(mut_view(iface_rev), mut_view(buf_rev));

    // INV-ART-001: Byte-for-byte deterministic serialization regardless of registration order
    if !axmi_buf_eq(view(buf_fwd), view(buf_rev)) || !fingerprint128_eq(aid_fwd.content_hash, aid_rev.content_hash) {
        axmi_buf_free(mut_view(buf_fwd));
        axmi_buf_free(mut_view(buf_rev));
        axmi_interface_free(mut_view(iface_fwd));
        axmi_interface_free(mut_view(iface_rev));
        return false;
    }

    if (buf_fwd.len) < (AXMI_HEADER_SIZE + (8 * AXMI_SECTION_DESC_SIZE)) {
        axmi_buf_free(mut_view(buf_fwd));
        axmi_buf_free(mut_view(buf_rev));
        axmi_interface_free(mut_view(iface_fwd));
        axmi_interface_free(mut_view(iface_rev));
        return false;
    }

    // Verify private item was stripped (`REQ-LNK-540`)
    if axmi_has_symbol_named(view(iface_fwd), probe_sv(mut_view(*str_arena), "priv_clamp_helper")) || iface_fwd.stripped_private_count != 1u32 {
        axmi_buf_free(mut_view(buf_fwd));
        axmi_buf_free(mut_view(buf_rev));
        axmi_interface_free(mut_view(iface_fwd));
        axmi_interface_free(mut_view(iface_rev));
        return false;
    }

    // Deserialize into a fresh `loaded_iface`
    let mut loaded_iface = axmi_interface_empty();
    axmi_interface_init(mut_view(loaded_iface));
    let exp_tgt = axmi_target_expectation_new(
        probe_sv(mut_view(*str_arena), "x86_64-windows"),
        probe_sv(mut_view(*str_arena), "win64"),
        8u32,
        true,
        0u32,
        AXMI_PANIC_NO_PANIC
    );
    let dres = axmi_deserialize(buf_fwd.ptr as *const u8, buf_fwd.len, view(exp_tgt), mut_view(loaded_iface));
    if dres.status != AXMI_STATUS_OK || !fingerprint128_eq(loaded_iface.interface_fingerprint, iface_fwd.interface_fingerprint) {
        axmi_interface_free(mut_view(loaded_iface));
        axmi_buf_free(mut_view(buf_fwd));
        axmi_buf_free(mut_view(buf_rev));
        axmi_interface_free(mut_view(iface_fwd));
        axmi_interface_free(mut_view(iface_rev));
        return false;
    }

    // Compare `inspect --axmi` dumps before and after round-trip
    let mut dump_before = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(dump_before));
    axmi_inspect_dump(view(iface_fwd), mut_view(dump_before));
    axmi_inspect_dump(view(loaded_iface), mut_view(*out_dump));
    if !diag_buf_eq(view(dump_before), view(*out_dump)) {
        diag_buf_free(mut_view(dump_before));
        axmi_interface_free(mut_view(loaded_iface));
        axmi_buf_free(mut_view(buf_fwd));
        axmi_buf_free(mut_view(buf_rev));
        axmi_interface_free(mut_view(iface_fwd));
        axmi_interface_free(mut_view(iface_rev));
        return false;
    }
    diag_buf_free(mut_view(dump_before));

    // Source-free `CompilerDB` ingestion (SPEC-24 AXS-ART-010 sec.2):
    // Downstream `db_down` has NO `.ax` source files for `core_math.vecmath`.
    let mut db_down = query_db_empty();
    query_db_init(mut_view(db_down), 501u64);
    let pop_ok = axmi_populate_compiler_db(
        mut_view(db_down),
        view(loaded_iface),
        ModuleId { v: 2u32 },
        PackageId { v: 1u32 },
        UnitKey { v: 1u32 }
    );
    if !pop_ok {
        query_db_free(mut_view(db_down));
        axmi_interface_free(mut_view(loaded_iface));
        axmi_buf_free(mut_view(buf_fwd));
        axmi_buf_free(mut_view(buf_rev));
        axmi_interface_free(mut_view(iface_fwd));
        axmi_interface_free(mut_view(iface_rev));
        return false;
    }

    // Verify `parse_module`, `module_def_map`, `resolve_module`, `item_signature`, `layout_of`,
    // `trait_solve`, `effect_summary`, `const_eval`, and `mir_body` are served directly from `.axmi`
    // with ZERO query executions (`executed_count == 0`).
    let pm = query_parse_module(mut_view(db_down), ModuleId { v: 2u32 });
    let dm = query_module_def_map(mut_view(db_down), ModuleId { v: 2u32 });
    let rm = query_resolve_module(mut_view(db_down), ModuleId { v: 2u32 });
    let sig_add = query_item_signature(mut_view(db_down), DefId { v: 1u32 });
    let lay_pair = query_layout_of(mut_view(db_down), TypeId { v: 10u32 });
    let tr_pair = query_trait_solve(mut_view(db_down), TraitGoalKey { v: 1u32 });
    let eff_bor = query_effect_summary(mut_view(db_down), DefId { v: 2u32 });
    let cst_scl = query_const_eval(mut_view(db_down), ConstEvalKey { v: 1u32 });
    let mir_clm = query_mir_body(mut_view(db_down), DefId { v: 3u32 });

    if pm.has_parse_error || dm.exported_count != 7u32 || rm.has_resolve_error || db_down.total_provider_runs != 0u32 || db_down.total_memo_hits != 9u32 {
        query_db_free(mut_view(db_down));
        axmi_interface_free(mut_view(loaded_iface));
        axmi_buf_free(mut_view(buf_fwd));
        axmi_buf_free(mut_view(buf_rev));
        axmi_interface_free(mut_view(iface_fwd));
        axmi_interface_free(mut_view(iface_rev));
        return false;
    }
    if sig_add.param_count != 2u32 || sig_add.return_type.v != 10u32 || lay_pair.size_bytes != 8u32 || lay_pair.align_bytes != 4u32 || lay_pair.field_count != 2u32 {
        query_db_free(mut_view(db_down));
        axmi_interface_free(mut_view(loaded_iface));
        axmi_buf_free(mut_view(buf_fwd));
        axmi_buf_free(mut_view(buf_rev));
        axmi_interface_free(mut_view(iface_fwd));
        axmi_interface_free(mut_view(iface_rev));
        return false;
    }
    if tr_pair.status != TRAIT_RESULT_IMPLEMENTED || tr_pair.impl_def_id.v != 7u32 || eff_bor.effect_mask != AXMI_EFF_READS_MEM || eff_bor.is_pure {
        query_db_free(mut_view(db_down));
        axmi_interface_free(mut_view(loaded_iface));
        axmi_buf_free(mut_view(buf_fwd));
        axmi_buf_free(mut_view(buf_rev));
        axmi_interface_free(mut_view(iface_fwd));
        axmi_interface_free(mut_view(iface_rev));
        return false;
    }
    if cst_scl.int_val != 4i64 || !mir_clm.ownership_verified || mir_clm.block_count != 3u32 {
        query_db_free(mut_view(db_down));
        axmi_interface_free(mut_view(loaded_iface));
        axmi_buf_free(mut_view(buf_fwd));
        axmi_buf_free(mut_view(buf_rev));
        axmi_interface_free(mut_view(iface_fwd));
        axmi_interface_free(mut_view(iface_rev));
        return false;
    }

    // Verify capability/borrow escape contract on `borrow_x` (`DefId=2`)
    let bor_con = axmi_find_contract_by_def(view(loaded_iface), DefId { v: 2u32 });
    if bor_con.param_modes[0] != AXMI_PASS_VIEW || bor_con.return_borrows_from_mask != 1u32 || bor_con.no_escape_mask != 1u32 {
        query_db_free(mut_view(db_down));
        axmi_interface_free(mut_view(loaded_iface));
        axmi_buf_free(mut_view(buf_fwd));
        axmi_buf_free(mut_view(buf_rev));
        axmi_interface_free(mut_view(iface_fwd));
        axmi_interface_free(mut_view(iface_rev));
        return false;
    }

    // Instantiate generic `clamp_pair<Pair>` across module boundary from `.axmi` MIR template
    let inst_ok = axmi_instantiate_generic_mir(
        mut_view(db_down),
        view(loaded_iface),
        probe_sv(mut_view(*str_arena), "clamp_pair"),
        TypeId { v: 10u32 },
        probe_sv(mut_view(*str_arena), "Pair"),
        ModuleId { v: 3u32 },
        DefId { v: 20u32 }
    );
    if inst_ok.is_error || !inst_ok.ownership_verified || inst_ok.block_count != 3u32 || inst_ok.local_count != 5u32 {
        query_db_free(mut_view(db_down));
        axmi_interface_free(mut_view(loaded_iface));
        axmi_buf_free(mut_view(buf_fwd));
        axmi_buf_free(mut_view(buf_rev));
        axmi_interface_free(mut_view(iface_fwd));
        axmi_interface_free(mut_view(iface_rev));
        return false;
    }

    // Instantiating `clamp_pair` with a type `TypeId { v: 99 }` lacking `impl Metric` fails closed
    let inst_bad = axmi_instantiate_generic_mir(
        mut_view(db_down),
        view(loaded_iface),
        probe_sv(mut_view(*str_arena), "clamp_pair"),
        TypeId { v: 99u32 },
        probe_sv(mut_view(*str_arena), "Unbounded"),
        ModuleId { v: 3u32 },
        DefId { v: 21u32 }
    );
    if !inst_bad.is_error {
        query_db_free(mut_view(db_down));
        axmi_interface_free(mut_view(loaded_iface));
        axmi_buf_free(mut_view(buf_fwd));
        axmi_buf_free(mut_view(buf_rev));
        axmi_interface_free(mut_view(iface_fwd));
        axmi_interface_free(mut_view(iface_rev));
        return false;
    }

    // Freshness & early-cutoff diff check (AXS-ART-014):
    // 1. Private body edit (`priv_body_seed` 111 -> 999) keeps `interface_fingerprint` and `abi_fingerprint` identical (`Fresh`)
    let mut iface_priv_edit = axmi_interface_empty();
    let mut buf_priv_edit = axmi_buf_empty();
    axmi_interface_init(mut_view(iface_priv_edit));
    axmi_buf_init(mut_view(buf_priv_edit), 2048);
    let _ = populate_vecmath_forward(mut_view(*str_arena), mut_view(iface_priv_edit), 4i64, 999u64);
    let _ = axmi_serialize(mut_view(iface_priv_edit), mut_view(buf_priv_edit));
    let diff_priv = axmi_diff_interfaces(view(loaded_iface), view(iface_priv_edit));
    let fresh_priv = axmi_check_freshness(view(loaded_iface), view(exp_tgt), iface_priv_edit.interface_fingerprint, iface_priv_edit.abi_fingerprint);
    if diff_priv.api_changed || diff_priv.abi_changed || fresh_priv != AXMI_FRESHNESS_FRESH {
        axmi_buf_free(mut_view(buf_priv_edit));
        axmi_interface_free(mut_view(iface_priv_edit));
        query_db_free(mut_view(db_down));
        axmi_interface_free(mut_view(loaded_iface));
        axmi_buf_free(mut_view(buf_fwd));
        axmi_buf_free(mut_view(buf_rev));
        axmi_interface_free(mut_view(iface_fwd));
        axmi_interface_free(mut_view(iface_rev));
        return false;
    }

    // 2. Public `const SCALE_FACTOR` change (4 -> 8) marks interface `Stale` (`api_changed && const_changed`)
    let mut iface_const_edit = axmi_interface_empty();
    let mut buf_const_edit = axmi_buf_empty();
    axmi_interface_init(mut_view(iface_const_edit));
    axmi_buf_init(mut_view(buf_const_edit), 2048);
    let _ = populate_vecmath_forward(mut_view(*str_arena), mut_view(iface_const_edit), 8i64, 111u64);
    let _ = axmi_serialize(mut_view(iface_const_edit), mut_view(buf_const_edit));
    let diff_const = axmi_diff_interfaces(view(loaded_iface), view(iface_const_edit));
    let fresh_const = axmi_check_freshness(view(loaded_iface), view(exp_tgt), iface_const_edit.interface_fingerprint, iface_const_edit.abi_fingerprint);
    if !diff_const.api_changed || !diff_const.const_changed || fresh_const != AXMI_FRESHNESS_STALE {
        axmi_buf_free(mut_view(buf_const_edit));
        axmi_interface_free(mut_view(iface_const_edit));
        axmi_buf_free(mut_view(buf_priv_edit));
        axmi_interface_free(mut_view(iface_priv_edit));
        query_db_free(mut_view(db_down));
        axmi_interface_free(mut_view(loaded_iface));
        axmi_buf_free(mut_view(buf_fwd));
        axmi_buf_free(mut_view(buf_rev));
        axmi_interface_free(mut_view(iface_fwd));
        axmi_interface_free(mut_view(iface_rev));
        return false;
    }

    axmi_buf_free(mut_view(buf_const_edit));
    axmi_interface_free(mut_view(iface_const_edit));
    axmi_buf_free(mut_view(buf_priv_edit));
    axmi_interface_free(mut_view(iface_priv_edit));
    query_db_free(mut_view(db_down));
    axmi_interface_free(mut_view(loaded_iface));
    axmi_buf_free(mut_view(buf_fwd));
    axmi_buf_free(mut_view(buf_rev));
    axmi_interface_free(mut_view(iface_fwd));
    axmi_interface_free(mut_view(iface_rev));
    true
}

fn test_fail_closed_validation(str_arena: mut_view<Arena>, out_dump: mut_view<DiagBuffer>) -> bool {
    let mut base_iface = axmi_interface_empty();
    let mut base_buf = axmi_buf_empty();
    axmi_interface_init(mut_view(base_iface));
    axmi_buf_init(mut_view(base_buf), 2048);
    let _ = populate_vecmath_forward(mut_view(*str_arena), mut_view(base_iface), 4i64, 111u64);
    let _ = axmi_serialize(mut_view(base_iface), mut_view(base_buf));

    let exp_win = axmi_target_expectation_new(
        probe_sv(mut_view(*str_arena), "x86_64-windows"),
        probe_sv(mut_view(*str_arena), "win64"),
        8u32,
        true,
        0u32,
        AXMI_PANIC_NO_PANIC
    );

    let mut out_iface = axmi_interface_empty();
    axmi_interface_init(mut_view(out_iface));

    // 1. Corrupt magic bytes (`AX_ART_CORRUPT_HEADER` / `AX_LINK_BAD_ARTIFACT`)
    unsafe { *(base_buf.ptr + 0) = 88u8; } // 'X' instead of 'A'
    let r_magic = axmi_deserialize(base_buf.ptr as *const u8, base_buf.len, view(exp_win), mut_view(out_iface));
    unsafe { *(base_buf.ptr + 0) = 65u8; } // restore 'A'
    if r_magic.status != AX_ART_CORRUPT_HEADER || r_magic.canonical_diag_code != AX_LINK_BAD_ARTIFACT {
        axmi_interface_free(mut_view(out_iface));
        axmi_buf_free(mut_view(base_buf));
        axmi_interface_free(mut_view(base_iface));
        return false;
    }
    axmi_emit_diag(view(r_magic), probe_sv(mut_view(*str_arena), "corrupt_magic.axmi"), mut_view(*out_dump));

    // 2. Truncated buffer < 64 bytes (`AX_ART_CORRUPT_HEADER`)
    let r_trunc = axmi_deserialize(base_buf.ptr as *const u8, 32, view(exp_win), mut_view(out_iface));
    if r_trunc.status != AX_ART_CORRUPT_HEADER {
        axmi_interface_free(mut_view(out_iface));
        axmi_buf_free(mut_view(base_buf));
        axmi_interface_free(mut_view(base_iface));
        return false;
    }

    // 3. Schema version mismatch (`schema_version = 99` -> `AX_ART_VERSION_MISMATCH` / `AX_LINK_ARTIFACT_SCHEMA_MISMATCH`)
    unsafe { *(base_buf.ptr + 10) = 99u8; }
    let r_ver = axmi_deserialize(base_buf.ptr as *const u8, base_buf.len, view(exp_win), mut_view(out_iface));
    unsafe { *(base_buf.ptr + 10) = (AXMI_FORMAT_VERSION & 0xFFu16) as u8; }
    if r_ver.status != AX_ART_VERSION_MISMATCH || r_ver.canonical_diag_code != AX_LINK_ARTIFACT_SCHEMA_MISMATCH || r_ver.found_version != 99u16 {
        axmi_interface_free(mut_view(out_iface));
        axmi_buf_free(mut_view(base_buf));
        axmi_interface_free(mut_view(base_iface));
        return false;
    }
    axmi_emit_diag(view(r_ver), probe_sv(mut_view(*str_arena), "future_v99.axmi"), mut_view(*out_dump));

    // 4. Unknown section policy (AXS-ART-005 sec.1):
    // 4a. Unknown OPTIONAL section (`section_type = 90`, `AXMI_SEC_FLAG_OPTIONAL`) -> succeeds!
    let mut opt_iface = axmi_interface_empty();
    let mut opt_buf = axmi_buf_empty();
    axmi_interface_init(mut_view(opt_iface));
    axmi_buf_init(mut_view(opt_buf), 2048);
    let _ = populate_vecmath_forward(mut_view(*str_arena), mut_view(opt_iface), 4i64, 111u64);
    axmi_add_custom_section(mut_view(opt_iface), 90u32, 90u16, AXMI_SEC_DEFAULT_FLAGS | AXMI_SEC_FLAG_OPTIONAL, 0xCAFEBABEu64);
    let _ = axmi_serialize(mut_view(opt_iface), mut_view(opt_buf));
    let r_opt = axmi_deserialize(opt_buf.ptr as *const u8, opt_buf.len, view(exp_win), mut_view(out_iface));
    axmi_buf_free(mut_view(opt_buf));
    axmi_interface_free(mut_view(opt_iface));
    if r_opt.status != AXMI_STATUS_OK {
        axmi_interface_free(mut_view(out_iface));
        axmi_buf_free(mut_view(base_buf));
        axmi_interface_free(mut_view(base_iface));
        return false;
    }

    // 4b. Unknown NON-OPTIONAL section (`section_type = 91`, no `AXMI_SEC_FLAG_OPTIONAL`) -> fails closed with `AX_ART_VERSION_MISMATCH`!
    let mut req_iface = axmi_interface_empty();
    let mut req_buf = axmi_buf_empty();
    axmi_interface_init(mut_view(req_iface));
    axmi_buf_init(mut_view(req_buf), 2048);
    let _ = populate_vecmath_forward(mut_view(*str_arena), mut_view(req_iface), 4i64, 111u64);
    axmi_add_custom_section(mut_view(req_iface), 91u32, 91u16, AXMI_SEC_DEFAULT_FLAGS, 0xDEADBEEFu64);
    let _ = axmi_serialize(mut_view(req_iface), mut_view(req_buf));
    let r_req = axmi_deserialize(req_buf.ptr as *const u8, req_buf.len, view(exp_win), mut_view(out_iface));
    axmi_buf_free(mut_view(req_buf));
    axmi_interface_free(mut_view(req_iface));
    if r_req.status != AX_ART_VERSION_MISMATCH || r_req.bad_section_type != 91u16 {
        axmi_interface_free(mut_view(out_iface));
        axmi_buf_free(mut_view(base_buf));
        axmi_interface_free(mut_view(base_iface));
        return false;
    }

    // 5. Target / ABI mismatch (`x86_64-windows` artifact loaded into `aarch64-linux` session -> `AX_ART_TARGET_MISMATCH`)
    let exp_linux = axmi_target_expectation_new(
        probe_sv(mut_view(*str_arena), "aarch64-linux"),
        probe_sv(mut_view(*str_arena), "sysv64"),
        8u32,
        true,
        0u32,
        AXMI_PANIC_NO_PANIC
    );
    let r_tgt = axmi_deserialize(base_buf.ptr as *const u8, base_buf.len, view(exp_linux), mut_view(out_iface));
    if r_tgt.status != AX_ART_TARGET_MISMATCH || r_tgt.canonical_diag_code != AX_LINK_ARTIFACT_TARGET_MISMATCH {
        axmi_interface_free(mut_view(out_iface));
        axmi_buf_free(mut_view(base_buf));
        axmi_interface_free(mut_view(base_iface));
        return false;
    }
    axmi_emit_diag(view(r_tgt), probe_sv(mut_view(*str_arena), "wrong_target.axmi"), mut_view(*out_dump));

    // 6. Bit-flipped payload byte -> fails closed with `AX_ART_CHECKSUM_MISMATCH` (`AX_LINK_BAD_ARTIFACT`)
    let flip_pos = base_buf.len - 8;
    let orig_byte = unsafe { *(base_buf.ptr + flip_pos) };
    unsafe { *(base_buf.ptr + flip_pos) = orig_byte ^ 0x01u8; }
    let r_cksum = axmi_deserialize(base_buf.ptr as *const u8, base_buf.len, view(exp_win), mut_view(out_iface));
    unsafe { *(base_buf.ptr + flip_pos) = orig_byte; }
    if r_cksum.status != AX_ART_CHECKSUM_MISMATCH || r_cksum.canonical_diag_code != AX_LINK_BAD_ARTIFACT {
        axmi_interface_free(mut_view(out_iface));
        axmi_buf_free(mut_view(base_buf));
        axmi_interface_free(mut_view(base_iface));
        return false;
    }
    axmi_emit_diag(view(r_cksum), probe_sv(mut_view(*str_arena), "bitflip_payload.axmi"), mut_view(*out_dump));

    // 7. Required CPU feature mask mismatch (artifact requires AVX2=0x04, session allows 0x00) -> `AX_ART_TARGET_MISMATCH`
    let mut avx_iface = axmi_interface_empty();
    let mut avx_buf = axmi_buf_empty();
    axmi_interface_init(mut_view(avx_iface));
    axmi_buf_init(mut_view(avx_buf), 2048);
    let _ = populate_vecmath_forward(mut_view(*str_arena), mut_view(avx_iface), 4i64, 111u64);
    axmi_set_module_identity(
        mut_view(avx_iface),
        probe_sv(mut_view(*str_arena), "core_math"),
        probe_sv(mut_view(*str_arena), "core_math.vecmath"),
        probe_sv(mut_view(*str_arena), "x86_64-windows"),
        probe_sv(mut_view(*str_arena), "win64"),
        8u32,
        true,
        4u32,
        AXMI_PANIC_NO_PANIC
    );
    let _ = axmi_serialize(mut_view(avx_iface), mut_view(avx_buf));
    let r_avx = axmi_deserialize(avx_buf.ptr as *const u8, avx_buf.len, view(exp_win), mut_view(out_iface));
    axmi_buf_free(mut_view(avx_buf));
    axmi_interface_free(mut_view(avx_iface));
    if r_avx.status != AX_ART_TARGET_MISMATCH || r_avx.canonical_diag_code != AX_LINK_ARTIFACT_TARGET_MISMATCH {
        axmi_interface_free(mut_view(out_iface));
        axmi_buf_free(mut_view(base_buf));
        axmi_interface_free(mut_view(base_iface));
        return false;
    }

    // 8. Checked 64-bit bounds rejection and Freshness `Unknown`/`Invalid` states
    if axmi_check_bounds(0xFFFFFFFFFFFFFFF0u64, 0x20u64, base_buf.len as u64) ||
        axmi_check_bounds(400u64, 200u64, 512u64) {
        axmi_interface_free(mut_view(out_iface));
        axmi_buf_free(mut_view(base_buf));
        axmi_interface_free(mut_view(base_iface));
        return false;
    }
    let fresh_unk = axmi_check_freshness(view(base_iface), view(exp_win), fingerprint128_new(0u64, 0u64), base_iface.abi_fingerprint);
    let fresh_inv = axmi_check_freshness(view(base_iface), view(exp_linux), base_iface.interface_fingerprint, base_iface.abi_fingerprint);
    if fresh_unk != AXMI_FRESHNESS_UNKNOWN || fresh_inv != AXMI_FRESHNESS_INVALID {
        axmi_interface_free(mut_view(out_iface));
        axmi_buf_free(mut_view(base_buf));
        axmi_interface_free(mut_view(base_iface));
        return false;
    }

    axmi_interface_free(mut_view(out_iface));
    axmi_buf_free(mut_view(base_buf));
    axmi_interface_free(mut_view(base_iface));
    true
}

pub fn main() -> i32 {
    let mut str_arena = arena_new();
    let mut out_dump = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(out_dump));

    let ok1 = test_roundtrip_and_compiler_db_import(mut_view(str_arena), mut_view(out_dump));
    if !ok1 {
        diag_buf_free(mut_view(out_dump));
        arena_destroy(mut_view(str_arena));
        return 1;
    }

    let ok2 = test_fail_closed_validation(mut_view(str_arena), mut_view(out_dump));
    if !ok2 {
        diag_buf_free(mut_view(out_dump));
        arena_destroy(mut_view(str_arena));
        return 2;
    }

    print_diag_buf(view(out_dump));
    diag_buf_free(mut_view(out_dump));
    arena_destroy(mut_view(str_arena));
    print("ARTIFACT-AXMI-PROBE-PASS\n");
    0
}
