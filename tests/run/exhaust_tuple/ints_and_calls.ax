// test: run
// exit: 0
// stdout: 3\n7\n-1 0 1\n12 20 30\n
// T499b: all-binding / wildcard tuple arms over integers, a tuple scrutinee built from a call, and integer
// ranges that together cover the whole `i8` / `u8` domains.
fn pair(a: i64, b: i64) -> (i64, i64) {
    (a, b)
}

fn first(t: (i64, i64)) -> i64 {
    match t {
        (p, _) => p,
    }
}

fn sign(x: i8, y: bool) -> i64 {
    match (x, y) {
        (-128i8..=-1i8, _) => -1i64,
        (0i8, _) => 0i64,
        (1i8..=127i8, true) => 1i64,
        (1i8..=127i8, false) => 2i64,
    }
}

fn bucket(b: u8, c: u8) -> i64 {
    match (b, c) {
        (0u8..=99u8, 0u8) => 10i64,
        (0u8..=99u8, 1u8..=255u8) => 12i64,
        (100u8..=199u8, _) => 20i64,
        (200u8..=255u8, _) => 30i64,
    }
}

fn main() -> i32 {
    let s = match (1i64, 2i64) {
        (p, q) => p + q,
    }
    print_int(s)
    print("\n")
    print_int(first(pair(7i64, 9i64)))
    print("\n")
    print_int(sign(-5i8, true))
    print(" ")
    print_int(sign(0i8, false))
    print(" ")
    print_int(sign(100i8, true))
    print("\n")
    print_int(bucket(50u8, 3u8))
    print(" ")
    print_int(bucket(150u8, 0u8))
    print(" ")
    print_int(bucket(255u8, 255u8))
    print("\n")
    0
}
