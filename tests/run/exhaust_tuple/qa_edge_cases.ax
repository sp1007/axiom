// test: run
// exit: 0
// stdout: 1 2\n10 20 30\n1 2 3\n1 2 3\n1 2 3 4\n10 20 30 40 50\n1 2 3\n
// T499b QA boundary cross-check: nested or-patterns in tuple columns, overlapping/exclusive integer ranges,
// exact i8 min/max boundaries, struct-in-tuple, enum struct-variant payload in tuple, deeply nested tuples, and guards.
struct Flag {
    a: bool,
    b: bool,
}

enum OptBool {
    None,
    Some(bool),
}

enum Ev {
    Empty,
    Pair(bool, bool),
}

fn nested_or(t: (bool, bool)) -> i64 {
    match t {
        ((true | false), true) => 1i64,
        (true | false, false) => 2i64,
    }
}

fn overlapping_and_exclusive_u8(x: u8, y: u8) -> i64 {
    let a = match (x, y) {
        (0u8..=10u8, _) => 10i64,
        (5u8..=255u8, _) => 20i64,
    }
    let b = match (y, x) {
        (0u8..255u8, _) => 0i64,
        (255u8, _) => 10i64,
    }
    a + b
}

fn i8_exact_edges(x: i8, b: bool) -> i64 {
    match (x, b) {
        (-128i8, _) => 1i64,
        (-127i8..=126i8, _) => 2i64,
        (127i8, _) => 3i64,
    }
}

fn struct_in_tuple(t: (Flag, bool)) -> i64 {
    match t {
        (Flag { a: true, b: _ }, _) => 1i64,
        (Flag { a: false, b: true }, _) => 2i64,
        (Flag { a: false, b: false }, _) => 3i64,
    }
}

fn tuple_variant_in_tuple(t: (Ev, OptBool)) -> i64 {
    match t {
        (Ev.Empty, _) => 1i64,
        (Ev.Pair(true, _), OptBool.Some(true)) => 2i64,
        (Ev.Pair(true, _), OptBool.Some(false) | OptBool.None) => 3i64,
        (Ev.Pair(false, true), _) => 3i64,
        (Ev.Pair(false, false), _) => 4i64,
    }
}

fn deeply_nested(t: ((bool, OptBool), (u8, bool))) -> i64 {
    match t {
        ((true, OptBool.Some(true)), (0u8..=127u8, _)) => 10i64,
        ((true, OptBool.Some(true)), (128u8..=255u8, _)) => 20i64,
        ((true, OptBool.Some(false) | OptBool.None), _) => 30i64,
        ((false, _), (_, true)) => 40i64,
        ((false, _), (_, false)) => 50i64,
    }
}

fn guarded_complete(t: (bool, bool)) -> i64 {
    match t {
        (true, x) if x => 1i64,
        (true, _) => 2i64,
        (false, _) => 3i64,
    }
}

fn main() -> i32 {
    print_int(nested_or((false, true)))
    print(" ")
    print_int(nested_or((true, false)))
    print("\n")

    print_int(overlapping_and_exclusive_u8(5u8, 10u8))
    print(" ")
    print_int(overlapping_and_exclusive_u8(11u8, 10u8))
    print(" ")
    print_int(overlapping_and_exclusive_u8(20u8, 255u8))
    print("\n")

    print_int(i8_exact_edges(-128i8, true))
    print(" ")
    print_int(i8_exact_edges(0i8, false))
    print(" ")
    print_int(i8_exact_edges(127i8, true))
    print("\n")

    print_int(struct_in_tuple((Flag { a: true, b: false }, true)))
    print(" ")
    print_int(struct_in_tuple((Flag { a: false, b: true }, false)))
    print(" ")
    print_int(struct_in_tuple((Flag { a: false, b: false }, true)))
    print("\n")

    print_int(tuple_variant_in_tuple((Ev.Empty, OptBool.None)))
    print(" ")
    print_int(tuple_variant_in_tuple((Ev.Pair(true, false), OptBool.Some(true))))
    print(" ")
    print_int(tuple_variant_in_tuple((Ev.Pair(false, true), OptBool.None)))
    print(" ")
    print_int(tuple_variant_in_tuple((Ev.Pair(false, false), OptBool.Some(false))))
    print("\n")

    print_int(deeply_nested(((true, OptBool.Some(true)), (42u8, false))))
    print(" ")
    print_int(deeply_nested(((true, OptBool.Some(true)), (200u8, true))))
    print(" ")
    print_int(deeply_nested(((true, OptBool.Some(false)), (0u8, true))))
    print(" ")
    print_int(deeply_nested(((false, OptBool.None), (1u8, true))))
    print(" ")
    print_int(deeply_nested(((false, OptBool.Some(true)), (255u8, false))))
    print("\n")

    print_int(guarded_complete((true, true)))
    print(" ")
    print_int(guarded_complete((true, false)))
    print(" ")
    print_int(guarded_complete((false, true)))
    print("\n")
    0
}
