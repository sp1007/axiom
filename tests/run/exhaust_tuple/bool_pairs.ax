// test: run
// exit: 0
// stdout: 1 2 1 2\n3 3\n4 5 6 7\n10\n
// T499b: complete bool-tuple matches without a trailing `_` arm (task examples `f`, `g`).
fn f(t: (bool, bool)) -> i32 {
    match t {
        (true, q) => 1,
        (false, q) => 2,
    }
}

fn g(t: (bool, bool)) -> i32 {
    match t {
        (p, q) => 3,
    }
}

fn all4(t: (bool, bool)) -> i32 {
    match t {
        (true, true) => 4,
        (true, false) => 5,
        (false, true) => 6,
        (false, false) => 7,
    }
}

fn mixed(t: (bool, bool, bool)) -> i32 {
    match t {
        (true, _, _) => 1,
        (false, true, _) => 2,
        (_, false, true) => 3,
        (false, false, false) => 4,
    }
}

fn main() -> i32 {
    print_int(f((true, false)) as i64)
    print(" ")
    print_int(f((false, true)) as i64)
    print(" ")
    print_int(f((true, true)) as i64)
    print(" ")
    print_int(f((false, false)) as i64)
    print("\n")
    print_int(g((true, false)) as i64)
    print(" ")
    print_int(g((false, false)) as i64)
    print("\n")
    print_int(all4((true, true)) as i64)
    print(" ")
    print_int(all4((true, false)) as i64)
    print(" ")
    print_int(all4((false, true)) as i64)
    print(" ")
    print_int(all4((false, false)) as i64)
    print("\n")
    let s = mixed((true, false, false)) + mixed((false, true, false)) + mixed((false, false, true)) + mixed((false, false, false))
    print_int(s as i64)
    print("\n")
    0
}
