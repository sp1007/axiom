// test: run
// exit: 0
// stdout: 5 0 -9\n1 2 3 4\n14 7\nlet 8 9\nif 6\n
// T499b: tuples of enums with payload bindings, nested tuples, struct fields inside tuples, irrefutable
// `let (a, b) = t` and `if let` with a tuple pattern.
enum Opt { None, Some(i64) }

enum Shape { Dot, Line(i64, i64) }

struct P { x: i64, y: i64 }

fn sum_opts(a: Opt, b: Opt) -> i64 {
    match (a, b) {
        (Opt.Some(x), Opt.Some(y)) => x + y,
        (Opt.Some(x), Opt.None) => x,
        (Opt.None, Opt.Some(y)) => 0i64 - y,
        (Opt.None, Opt.None) => 0i64,
    }
}

fn nested(t: ((bool, bool), bool)) -> i64 {
    match t {
        ((true, _), true) => 1i64,
        ((true, _), false) => 2i64,
        ((false, true), _) => 3i64,
        ((false, false), _) => 4i64,
    }
}

fn shapes(s: Shape, p: P) -> i64 {
    match (s, p) {
        (Shape.Dot, P { x, y }) => x + y,
        (Shape.Line(a, b), P { x: _, y }) => a + b + y,
    }
}

fn main() -> i32 {
    print_int(sum_opts(Opt.Some(2i64), Opt.Some(3i64)))
    print(" ")
    print_int(sum_opts(Opt.None, Opt.None))
    print(" ")
    print_int(sum_opts(Opt.None, Opt.Some(9i64)))
    print("\n")
    print_int(nested(((true, false), true)))
    print(" ")
    print_int(nested(((true, true), false)))
    print(" ")
    print_int(nested(((false, true), true)))
    print(" ")
    print_int(nested(((false, false), false)))
    print("\n")
    print_int(shapes(Shape.Dot, P { x: 6i64, y: 8i64 }))
    print(" ")
    print_int(shapes(Shape.Line(1i64, 2i64), P { x: 100i64, y: 4i64 }))
    print("\n")
    let t = (8i64, 9i64)
    let (a, b) = t
    print("let ")
    print_int(a)
    print(" ")
    print_int(b)
    print("\n")
    if let (Opt.Some(v), true) = (Opt.Some(6i64), true) {
        print("if ")
        print_int(v)
        print("\n")
    }
    0
}
