// test: run
// stdout: CLOBBER_BANNER=Xin chào kiểm chứng biên\nLOOP_BACKEDGE=125\nPARTIAL_STRUCT=55\nSEQ_REBORROW=64\nMULTI_ORIGIN=1030\nCLOBBER_TOTAL=1274\n

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct Pair {
    left: i32,
    right: i32,
}

fn loop_backedge_mut_view_clobber(mv: mut_view<i32>) -> i32 {
    let mut acc: i32 = 0;
    let mut iter: i32 = 0;
    while iter < 4 {
        // Loop backedge mutates `*mv`; pre-loop value `5` must NEVER forward across iterations!
        let cur: i32 = *mv;
        acc = acc + cur;
        *mv = cur + 10;
        iter = iter + 1;
    }
    acc + *mv
}

fn partial_alias_struct_vs_field() -> i32 {
    let mut p = Pair { left: 10, right: 20 };
    // Overwriting only `p.left` (`PartialAlias`) must preserve `p.right == 20`!
    p.left = 35;
    p.left + p.right
}

fn write_via_mut_view(m: mut_view<i32>, val: i32) {
    *m = val;
}

fn sequential_reborrow_same_owner() -> i32 {
    let mut x: i32 = 1;
    write_via_mut_view(mut_view(x), 15);
    write_via_mut_view(mut_view(x), 64);
    x
}

fn cond_multi_origin(take_a: bool) -> i32 {
    let mut a: i32 = 10;
    let mut b: i32 = 20;
    let mut p: *mut i32 = unsafe { address_of_mut(a) };
    if !take_a {
        p = unsafe { address_of_mut(b) };
    }
    // `p` has two definitions (`MayAlias` with both `a` and `b`); neither `a` nor `b` may forward stale values!
    unsafe {
        *p = 500;
    }
    a + b
}

fn main() -> i32 {
    print("CLOBBER_BANNER=Xin chào kiểm chứng biên\n");

    let mut loop_val: i32 = 5;
    let r1: i32 = loop_backedge_mut_view_clobber(mut_view(loop_val));
    let r2: i32 = partial_alias_struct_vs_field();
    let r3: i32 = sequential_reborrow_same_owner();
    let r4: i32 = cond_multi_origin(true) + cond_multi_origin(false);
    let total: i32 = r1 + r2 + r3 + r4;

    print("LOOP_BACKEDGE=");
    print_int(r1);
    print("\nPARTIAL_STRUCT=");
    print_int(r2);
    print("\nSEQ_REBORROW=");
    print_int(r3);
    print("\nMULTI_ORIGIN=");
    print_int(r4);
    print("\nCLOBBER_TOTAL=");
    print_int(total);
    print("\n");
    0
}
