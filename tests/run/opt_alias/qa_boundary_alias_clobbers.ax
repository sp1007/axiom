// test: run
// stdout: QA_ALIAS_BANNER=Xin chào biên bí danh\nINTERIOR_DEREF=176\nREBORROW_LOOP=141\nINDIRECT_MUT=443\nENUM_PAYLOAD=124\nQA_ALIAS_TOTAL=884\n

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct Sink {
    mv: mut_view<i32>,
}

struct PtrWrap {
    p: *mut i32,
}

enum EitherI32 {
    Left(i32),
    Right(i32),
}

fn write_through_sink(mv: mut_view<i32>) {
    *mv = 10;
    let mut s = Sink { mv: mv };
    *(s.mv) = 77;
}

fn write_through_ptr_wrap() -> i32 {
    let mut x: i32 = 20;
    let w = PtrWrap { p: unsafe { address_of_mut(x) } };
    x = 30;
    unsafe {
        *(w.p) = 99;
    }
    x
}

fn interior_struct_deref_clobber() -> i32 {
    let mut slot: i32 = 1;
    write_through_sink(mut_view(slot));
    slot + write_through_ptr_wrap()
}

fn reborrow_mut_view_param(m: mut_view<i32>) -> i32 {
    *m = 10;
    {
        let sub: mut_view<i32> = mut_view(*m);
        *sub = 99;
    }
    *m
}

fn add_via_mut_view(m: mut_view<i32>, delta: i32) {
    *m = *m + delta;
}

fn loop_reborrow_two_slots() -> i32 {
    let mut a: i32 = 5;
    let mut b: i32 = 7;
    let mut iter: i32 = 0;
    while iter < 2 {
        if iter == 0 {
            add_via_mut_view(mut_view(a), 10);
        } else {
            add_via_mut_view(mut_view(b), 20);
        }
        iter = iter + 1;
    }
    a + b
}

fn indirect_index_and_ptr_mutation() -> i32 {
    let mut arr: [4]i32 = [10, 20, 30, 40];
    let mut idx: usize = 0;
    arr[idx] = 111;
    {
        let mi: mut_view<usize> = mut_view(idx);
        *mi = 1;
    }
    arr[idx] = 222;

    let mut x: i32 = 5;
    let mut y: i32 = 6;
    let mut p: *mut i32 = unsafe { address_of_mut(x) };
    unsafe {
        *p = 50;
    }
    {
        let mp: mut_view<*mut i32> = mut_view(p);
        *mp = unsafe { address_of_mut(y) };
    }
    unsafe {
        *p = 60;
    }

    arr[0] + arr[1] + x + y
}

fn enum_variant_payload_overwrite() -> i32 {
    let mut e = EitherI32.Left(41);
    let first: i32 = match e {
        EitherI32.Left(v) => v,
        EitherI32.Right(v) => v + 1000,
    };
    e = EitherI32.Right(83);
    let second: i32 = match e {
        EitherI32.Left(v) => v + 2000,
        EitherI32.Right(v) => v,
    };
    first + second
}

fn main() -> i32 {
    print("QA_ALIAS_BANNER=Xin chào biên bí danh\n");

    let r1: i32 = interior_struct_deref_clobber();
    let mut rb_slot: i32 = 0;
    let r2: i32 = reborrow_mut_view_param(mut_view(rb_slot)) + loop_reborrow_two_slots();
    let r3: i32 = indirect_index_and_ptr_mutation();
    let r4: i32 = enum_variant_payload_overwrite();
    let total: i32 = r1 + r2 + r3 + r4;

    print("INTERIOR_DEREF=");
    print_int(r1);
    print("\nREBORROW_LOOP=");
    print_int(r2);
    print("\nINDIRECT_MUT=");
    print_int(r3);
    print("\nENUM_PAYLOAD=");
    print_int(r4);
    print("\nQA_ALIAS_TOTAL=");
    print_int(total);
    print("\n");

    if total != 884 {
        return 1;
    }
    0
}
