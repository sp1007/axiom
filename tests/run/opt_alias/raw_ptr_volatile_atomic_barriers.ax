// test: run
// stdout: BARRIER_BANNER=Xin chào bộ nhớ an toàn\nRAW_ALIAS=77\nPTR_COPY_ADD=176\nDROP=20\nZERO_SUM=0\nBARRIER_TOTAL=253\nDROP=10\n

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic unsafe fn ptr_write_bytes<T>(dst: *mut T, val: u8, count: usize) {}

struct DropGuard {
    id: i32,
}

impl Drop for DropGuard {
    fn drop(self: mut_view<DropGuard>) {
        print("DROP=");
        print_int(self.id);
        print("\n");
    }
}

struct KeyBytes {
    b0: u8,
    b1: u8,
}

fn raw_ptr_alias_blocks_stale_forward() -> i32 {
    let mut x: i32 = 10;
    let p: *mut i32 = unsafe { address_of_mut(x) };
    // `x` has raw address exposed; store via `*p` MUST block forwarding stale `20` (`REQ-OPT-300`)!
    x = 20;
    unsafe {
        *p = 77;
    }
    x
}

fn raw_ptr_offset_and_copy() -> i32 {
    let src: [4]i32 = [11, 22, 33, 44];
    let mut dst: [4]i32 = [0, 0, 0, 0];
    let ps: *const i32 = unsafe { address_of(src) as *const i32 };
    let pd: *mut i32 = unsafe { address_of_mut(dst) as *mut i32 };
    unsafe {
        ptr_copy_nonoverlapping<i32>(ps, pd, 4);
        *(pd + 2) = 99;
    }
    dst[0] + dst[1] + dst[2] + dst[3]
}

fn main() -> i32 {
    print("BARRIER_BANNER=Xin chào bộ nhớ an toàn\n");

    let g_outer = DropGuard { id: 10 };
    let r_raw: i32 = raw_ptr_alias_blocks_stale_forward();
    let r_copy: i32 = raw_ptr_offset_and_copy();

    print("RAW_ALIAS=");
    print_int(r_raw);
    print("\nPTR_COPY_ADD=");
    print_int(r_copy);
    print("\n");

    let mut zero_sum: i32 = 99;
    {
        let g_inner = DropGuard { id: 20 };
        let mut kb = KeyBytes { b0: 170u8, b1: 221u8 };
        let kp: *mut u8 = unsafe { address_of_mut(kb) as *mut u8 };
        unsafe {
            ptr_write_bytes<u8>(kp, 0u8, 2);
        }
        zero_sum = (kb.b0 as i32) + (kb.b1 as i32);
        let _ = g_inner.id;
    }

    print("ZERO_SUM=");
    print_int(zero_sum);
    print("\n");

    let _ = g_outer.id;
    let total: i32 = r_raw + r_copy + zero_sum;
    print("BARRIER_TOTAL=");
    print_int(total);
    print("\n");
    0
}
