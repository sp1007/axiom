@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

@PROBE_MIR_FN@

fn probe_mir_blob(arena: mut_view<Arena>, idx: usize) -> StrView {
    let s: str = probe_mir_raw(idx);
    let raw_sv: StrView = unsafe { *(address_of(s) as *const StrView) };
    let bytes: view<[u8]> = unsafe { *(address_of(s) as *const view<[u8]>) };
    let n = raw_sv.len;
    let dst = arena_alloc_raw(mut_view(*arena), n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = bytes[i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn probe_set_ty_slot(types_arr: *mut *mut AxType, idx: usize, ptr: *mut AxType) {
    let slot = ((types_arr as usize) + mir_mul_usize(idx, size_of<*mut AxType>())) as *mut *mut AxType;
    unsafe { *slot = ptr; }
}

// Initializes `Thir` with accurate post-T451 primitives (`1..16`) plus capability/struct/array/enum/builtin types (`17..34`).
fn probe_init_alias_thir(thir_ptr: *mut Thir, arena: mut_view<Arena>) {
    let types_arr = arena_alloc_raw(mut_view(*arena), mir_mul_usize(64, size_of<*mut AxType>()), align_of<*mut AxType>()) as *mut *mut AxType;
    let pool = arena_alloc_raw(mut_view(*arena), mir_mul_usize(44, size_of<AxType>()), align_of<AxType>());
    let ty_sz = size_of<AxType>();

    let mut k: usize = 0;
    while k < 16 {
        let tp = ((pool as usize) + mir_mul_usize(k, ty_sz)) as *mut AxType;
        let tk: u8 = if k < 9 { k as u8 }
            else if k == 9 { TY_ISIZE }
            else if k == 10 { TY_U8 }
            else if k == 11 { TY_U16 }
            else if k == 12 { TY_U32 }
            else if k == 13 { TY_U64 }
            else if k == 14 { TY_USIZE }
            else { TY_STR };
        unsafe { ax_type_reset(mut_view(*tp), tk); }
        probe_set_ty_slot(types_arr, k, tp);
        k = k + 1;
    }

    // type#17 = view<i32>, type#18 = mut_view<i32>, type#19 = *mut i32, type#20 = struct Pair { i32, i32 }
    // type#21 = mut_view<Pair>, type#22 = view<Pair>, type#23 = [4]i32
    // type#24 = TY_BUILTIN_PTR_COPY<i32>, type#25 = TY_BUILTIN_PTR_COPY_NONOVERLAPPING<i32>
    // type#26 = TY_BUILTIN_PTR_WRITE_BYTES<i32>, type#27 = TY_BUILTIN_ADDRESS_OF_MUT<i32>
    // type#28 = fn(i32) -> i32, type#29 = *const i32
    // type#30 = struct Sink { mv: mut_view<i32> }, type#31 = struct PtrWrap { p: *mut i32 }
    // type#32 = mut_view<usize>, type#33 = enum EitherI32 { Left(i32), Right(i32) }
    // type#34 = enum PairEnum { V0(i32, i32), V1(i32) }
    let mut c: usize = 16;
    while c < 34 {
        let cp = ((pool as usize) + mir_mul_usize(c, ty_sz)) as *mut AxType;
        unsafe { ax_type_reset(mut_view(*cp), 0u8); }
        probe_set_ty_slot(types_arr, c, cp);
        c = c + 1;
    }

    let pair_flds = arena_alloc_raw(mut_view(*arena), mir_mul_usize(2, size_of<TypeId>()), align_of<TypeId>()) as *mut TypeId;
    let i32_arg = arena_alloc_raw(mut_view(*arena), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
    let copy_params = arena_alloc_raw(mut_view(*arena), mir_mul_usize(3, size_of<TypeId>()), align_of<TypeId>()) as *mut TypeId;
    let wb_params = arena_alloc_raw(mut_view(*arena), mir_mul_usize(3, size_of<TypeId>()), align_of<TypeId>()) as *mut TypeId;
    let sink_flds = arena_alloc_raw(mut_view(*arena), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
    let pwrap_flds = arena_alloc_raw(mut_view(*arena), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
    let either_vfc = arena_alloc_raw(mut_view(*arena), mir_mul_usize(2, size_of<usize>()), align_of<usize>()) as *mut usize;
    let either_vf = arena_alloc_raw(mut_view(*arena), mir_mul_usize(2, size_of<*mut TypeId>()), align_of<*mut TypeId>()) as *mut *mut TypeId;
    let penum_vfc = arena_alloc_raw(mut_view(*arena), mir_mul_usize(2, size_of<usize>()), align_of<usize>()) as *mut usize;
    let penum_vf = arena_alloc_raw(mut_view(*arena), mir_mul_usize(2, size_of<*mut TypeId>()), align_of<*mut TypeId>()) as *mut *mut TypeId;
    unsafe {
        *opt_typeid_at(pair_flds, 0) = TypeId { v: 8u32 };
        *opt_typeid_at(pair_flds, 1) = TypeId { v: 8u32 };
        *opt_typeid_at(i32_arg, 0) = TypeId { v: 8u32 };
        *opt_typeid_at(copy_params, 0) = TypeId { v: 29u32 };
        *opt_typeid_at(copy_params, 1) = TypeId { v: 19u32 };
        *opt_typeid_at(copy_params, 2) = TypeId { v: 15u32 };
        *opt_typeid_at(wb_params, 0) = TypeId { v: 19u32 };
        *opt_typeid_at(wb_params, 1) = TypeId { v: 11u32 };
        *opt_typeid_at(wb_params, 2) = TypeId { v: 15u32 };
        *opt_typeid_at(sink_flds, 0) = TypeId { v: 18u32 };
        *opt_typeid_at(pwrap_flds, 0) = TypeId { v: 19u32 };
        *(((either_vfc as usize) + mir_mul_usize(0, size_of<usize>())) as *mut usize) = 1;
        *(((either_vfc as usize) + mir_mul_usize(1, size_of<usize>())) as *mut usize) = 1;
        *(((either_vf as usize) + mir_mul_usize(0, size_of<*mut TypeId>())) as *mut *mut TypeId) = i32_arg;
        *(((either_vf as usize) + mir_mul_usize(1, size_of<*mut TypeId>())) as *mut *mut TypeId) = i32_arg;
        *(((penum_vfc as usize) + mir_mul_usize(0, size_of<usize>())) as *mut usize) = 2;
        *(((penum_vfc as usize) + mir_mul_usize(1, size_of<usize>())) as *mut usize) = 1;
        *(((penum_vf as usize) + mir_mul_usize(0, size_of<*mut TypeId>())) as *mut *mut TypeId) = pair_flds;
        *(((penum_vf as usize) + mir_mul_usize(1, size_of<*mut TypeId>())) as *mut *mut TypeId) = i32_arg;
    }

    let t17 = ((pool as usize) + mir_mul_usize(16, ty_sz)) as *mut AxType;
    let t18 = ((pool as usize) + mir_mul_usize(17, ty_sz)) as *mut AxType;
    let t19 = ((pool as usize) + mir_mul_usize(18, ty_sz)) as *mut AxType;
    let t20 = ((pool as usize) + mir_mul_usize(19, ty_sz)) as *mut AxType;
    let t21 = ((pool as usize) + mir_mul_usize(20, ty_sz)) as *mut AxType;
    let t22 = ((pool as usize) + mir_mul_usize(21, ty_sz)) as *mut AxType;
    let t23 = ((pool as usize) + mir_mul_usize(22, ty_sz)) as *mut AxType;
    let t24 = ((pool as usize) + mir_mul_usize(23, ty_sz)) as *mut AxType;
    let t25 = ((pool as usize) + mir_mul_usize(24, ty_sz)) as *mut AxType;
    let t26 = ((pool as usize) + mir_mul_usize(25, ty_sz)) as *mut AxType;
    let t27 = ((pool as usize) + mir_mul_usize(26, ty_sz)) as *mut AxType;
    let t28 = ((pool as usize) + mir_mul_usize(27, ty_sz)) as *mut AxType;
    let t29 = ((pool as usize) + mir_mul_usize(28, ty_sz)) as *mut AxType;
    let t30 = ((pool as usize) + mir_mul_usize(29, ty_sz)) as *mut AxType;
    let t31 = ((pool as usize) + mir_mul_usize(30, ty_sz)) as *mut AxType;
    let t32 = ((pool as usize) + mir_mul_usize(31, ty_sz)) as *mut AxType;
    let t33 = ((pool as usize) + mir_mul_usize(32, ty_sz)) as *mut AxType;
    let t34 = ((pool as usize) + mir_mul_usize(33, ty_sz)) as *mut AxType;
    let scratch_ty = ((pool as usize) + mir_mul_usize(36, ty_sz)) as *mut AxType;

    unsafe {
        (*t17).kind = TY_VIEW;
        (*t17).pointee = TypeId { v: 8u32 };

        (*t18).kind = TY_MUT_VIEW;
        (*t18).is_mut = true;
        (*t18).pointee = TypeId { v: 8u32 };

        (*t19).kind = TY_PTR;
        (*t19).is_mut = true;
        (*t19).pointee = TypeId { v: 8u32 };

        (*t20).kind = TY_STRUCT;
        (*t20).fields = pair_flds;
        (*t20).field_count = 2;

        (*t21).kind = TY_MUT_VIEW;
        (*t21).is_mut = true;
        (*t21).pointee = TypeId { v: 20u32 };

        (*t22).kind = TY_VIEW;
        (*t22).pointee = TypeId { v: 20u32 };

        (*t23).kind = TY_ARRAY;
        (*t23).elem = TypeId { v: 8u32 };
        (*t23).array_len = 4u64;

        (*t24).kind = TY_BUILTIN_PTR_COPY;
        (*t24).args = i32_arg;
        (*t24).arg_count = 1;
        (*t24).param_types = copy_params;
        (*t24).param_count = 3;
        (*t24).ret_type = TypeId { v: 2u32 };

        (*t25).kind = TY_BUILTIN_PTR_COPY_NONOVERLAPPING;
        (*t25).args = i32_arg;
        (*t25).arg_count = 1;
        (*t25).param_types = copy_params;
        (*t25).param_count = 3;
        (*t25).ret_type = TypeId { v: 2u32 };

        (*t26).kind = TY_BUILTIN_PTR_WRITE_BYTES;
        (*t26).args = i32_arg;
        (*t26).arg_count = 1;
        (*t26).param_types = wb_params;
        (*t26).param_count = 3;
        (*t26).ret_type = TypeId { v: 2u32 };

        (*t27).kind = TY_BUILTIN_ADDRESS_OF_MUT;
        (*t27).args = i32_arg;
        (*t27).arg_count = 1;
        (*t27).param_types = i32_arg;
        (*t27).param_count = 1;
        (*t27).ret_type = TypeId { v: 19u32 };

        (*t28).kind = TY_FN;
        (*t28).param_types = i32_arg;
        (*t28).param_count = 1;
        (*t28).ret_type = TypeId { v: 8u32 };

        (*t29).kind = TY_PTR;
        (*t29).is_mut = false;
        (*t29).pointee = TypeId { v: 8u32 };

        (*t30).kind = TY_STRUCT;
        (*t30).fields = sink_flds;
        (*t30).field_count = 1;

        (*t31).kind = TY_STRUCT;
        (*t31).fields = pwrap_flds;
        (*t31).field_count = 1;

        (*t32).kind = TY_MUT_VIEW;
        (*t32).is_mut = true;
        (*t32).pointee = TypeId { v: 15u32 };

        (*t33).kind = TY_ENUM;
        (*t33).variant_count = 2;
        (*t33).variant_field_counts = either_vfc;
        (*t33).variant_fields = either_vf;

        (*t34).kind = TY_ENUM;
        (*t34).variant_count = 2;
        (*t34).variant_field_counts = penum_vfc;
        (*t34).variant_fields = penum_vf;

        let t_i128 = ((scratch_ty as usize) + ty_sz) as *mut AxType;
        let t_u128 = ((scratch_ty as usize) + mir_mul_usize(2, ty_sz)) as *mut AxType;
        ax_type_reset(mut_view(*t_i128), TY_I128);
        ax_type_reset(mut_view(*t_u128), TY_U128);

        (*thir_ptr).interner.arena = arena_new();
        (*thir_ptr).interner.map.keys = 0 as *mut *mut AxType;
        (*thir_ptr).interner.map.vals = 0 as *mut TypeId;
        (*thir_ptr).interner.map.states = 0 as *mut u8;
        (*thir_ptr).interner.map.len = 0;
        (*thir_ptr).interner.map.cap = 0;
        (*thir_ptr).interner.types = types_arr;
        (*thir_ptr).interner.len = 34;
        (*thir_ptr).interner.cap = 64;
        (*thir_ptr).interner.next_int_var = 1u32;
        (*thir_ptr).interner.scratch = scratch_ty;
        (*thir_ptr).interner.t_error.v = 1u32;
        (*thir_ptr).interner.t_unit.v = 2u32;
        (*thir_ptr).interner.t_never.v = 3u32;
        (*thir_ptr).interner.t_bool.v = 4u32;
        (*thir_ptr).interner.t_char.v = 5u32;
        (*thir_ptr).interner.t_i8.v = 6u32;
        (*thir_ptr).interner.t_i16.v = 7u32;
        (*thir_ptr).interner.t_i32.v = 8u32;
        (*thir_ptr).interner.t_i64.v = 9u32;
        (*thir_ptr).interner.t_isize.v = 10u32;
        (*thir_ptr).interner.t_u8.v = 11u32;
        (*thir_ptr).interner.t_u16.v = 12u32;
        (*thir_ptr).interner.t_u32.v = 13u32;
        (*thir_ptr).interner.t_u64.v = 14u32;
        (*thir_ptr).interner.t_usize.v = 15u32;
        (*thir_ptr).interner.t_str.v = 16u32;
        (*thir_ptr).interner.t_i128.v = 0x3FFF0128u32;
        (*thir_ptr).interner.t_u128.v = 0x3FFF0129u32;
        (*thir_ptr).item_types.keys = 0 as *mut usize;
        (*thir_ptr).item_types.vals = 0 as *mut TypeId;
        (*thir_ptr).item_types.states = 0 as *mut u8;
        (*thir_ptr).item_types.len = 0;
        (*thir_ptr).item_types.cap = 0;
        (*thir_ptr).expr_types.len = 0;
        (*thir_ptr).expr_types.cap = 0;
    }
}

fn probe_free_alias_thir(thir_ptr: *mut Thir) {
    unsafe {
        typemap_free(mut_view((*thir_ptr).interner.map));
        arena_destroy(mut_view((*thir_ptr).interner.arena));
    }
}

fn make_deref_pl(loc: u32, arena: mut_view<Arena>) -> MirPlace {
    let pr = arena_alloc_raw(mut_view(*arena), size_of<MirProjection>(), align_of<MirProjection>()) as *mut MirProjection;
    unsafe {
        (*pr).kind = MIR_PROJ_DEREF;
        (*pr).field_idx = 0u32;
        (*pr).index_local = MirLocalId { v: 0u32 };
        (*pr).from_local = MirLocalId { v: 0u32 };
        (*pr).to_local = MirLocalId { v: 0u32 };
        (*pr).has_from = false;
        (*pr).has_to = false;
        (*pr).variant_idx = 0u32;
    }
    let mut pl = mir_local_place(loc);
    pl.projs = pr;
    pl.proj_count = 1;
    pl
}

fn make_field_pl(loc: u32, fidx: u32, arena: mut_view<Arena>) -> MirPlace {
    let pr = arena_alloc_raw(mut_view(*arena), size_of<MirProjection>(), align_of<MirProjection>()) as *mut MirProjection;
    unsafe {
        (*pr).kind = MIR_PROJ_FIELD;
        (*pr).field_idx = fidx;
        (*pr).index_local = MirLocalId { v: 0u32 };
        (*pr).from_local = MirLocalId { v: 0u32 };
        (*pr).to_local = MirLocalId { v: 0u32 };
        (*pr).has_from = false;
        (*pr).has_to = false;
        (*pr).variant_idx = 0u32;
    }
    let mut pl = mir_local_place(loc);
    pl.projs = pr;
    pl.proj_count = 1;
    pl
}

fn make_index_pl(loc: u32, idx_loc: u32, arena: mut_view<Arena>) -> MirPlace {
    let pr = arena_alloc_raw(mut_view(*arena), size_of<MirProjection>(), align_of<MirProjection>()) as *mut MirProjection;
    unsafe {
        (*pr).kind = MIR_PROJ_INDEX;
        (*pr).field_idx = 0u32;
        (*pr).index_local = MirLocalId { v: idx_loc };
        (*pr).from_local = MirLocalId { v: 0u32 };
        (*pr).to_local = MirLocalId { v: 0u32 };
        (*pr).has_from = false;
        (*pr).has_to = false;
        (*pr).variant_idx = 0u32;
    }
    let mut pl = mir_local_place(loc);
    pl.projs = pr;
    pl.proj_count = 1;
    pl
}

fn make_field_deref_pl(loc: u32, fidx: u32, arena: mut_view<Arena>) -> MirPlace {
    let prs = arena_alloc_raw(mut_view(*arena), mir_mul_usize(2, size_of<MirProjection>()), align_of<MirProjection>()) as *mut MirProjection;
    let p0 = unsafe { mir_proj_at(prs, 0) };
    let p1 = unsafe { mir_proj_at(prs, 1) };
    unsafe {
        (*p0).kind = MIR_PROJ_FIELD;
        (*p0).field_idx = fidx;
        (*p0).index_local = MirLocalId { v: 0u32 };
        (*p0).from_local = MirLocalId { v: 0u32 };
        (*p0).to_local = MirLocalId { v: 0u32 };
        (*p0).has_from = false;
        (*p0).has_to = false;
        (*p0).variant_idx = 0u32;

        (*p1).kind = MIR_PROJ_DEREF;
        (*p1).field_idx = 0u32;
        (*p1).index_local = MirLocalId { v: 0u32 };
        (*p1).from_local = MirLocalId { v: 0u32 };
        (*p1).to_local = MirLocalId { v: 0u32 };
        (*p1).has_from = false;
        (*p1).has_to = false;
        (*p1).variant_idx = 0u32;
    }
    let mut pl = mir_local_place(loc);
    pl.projs = prs;
    pl.proj_count = 2;
    pl
}

fn make_downcast_pl(loc: u32, vidx: u32, arena: mut_view<Arena>) -> MirPlace {
    let pr = arena_alloc_raw(mut_view(*arena), size_of<MirProjection>(), align_of<MirProjection>()) as *mut MirProjection;
    unsafe {
        (*pr).kind = MIR_PROJ_DOWNCAST;
        (*pr).field_idx = 0u32;
        (*pr).index_local = MirLocalId { v: 0u32 };
        (*pr).from_local = MirLocalId { v: 0u32 };
        (*pr).to_local = MirLocalId { v: 0u32 };
        (*pr).has_from = false;
        (*pr).has_to = false;
        (*pr).variant_idx = vidx;
    }
    let mut pl = mir_local_place(loc);
    pl.projs = pr;
    pl.proj_count = 1;
    pl
}

fn make_downcast_field_pl(loc: u32, vidx: u32, fidx: u32, arena: mut_view<Arena>) -> MirPlace {
    let prs = arena_alloc_raw(mut_view(*arena), mir_mul_usize(2, size_of<MirProjection>()), align_of<MirProjection>()) as *mut MirProjection;
    let p0 = unsafe { mir_proj_at(prs, 0) };
    let p1 = unsafe { mir_proj_at(prs, 1) };
    unsafe {
        (*p0).kind = MIR_PROJ_DOWNCAST;
        (*p0).field_idx = 0u32;
        (*p0).index_local = MirLocalId { v: 0u32 };
        (*p0).from_local = MirLocalId { v: 0u32 };
        (*p0).to_local = MirLocalId { v: 0u32 };
        (*p0).has_from = false;
        (*p0).has_to = false;
        (*p0).variant_idx = vidx;

        (*p1).kind = MIR_PROJ_FIELD;
        (*p1).field_idx = fidx;
        (*p1).index_local = MirLocalId { v: 0u32 };
        (*p1).from_local = MirLocalId { v: 0u32 };
        (*p1).to_local = MirLocalId { v: 0u32 };
        (*p1).has_from = false;
        (*p1).has_to = false;
        (*p1).variant_idx = 0u32;
    }
    let mut pl = mir_local_place(loc);
    pl.projs = prs;
    pl.proj_count = 2;
    pl
}

fn diag_buf_equals(a: view<DiagBuffer>, b: view<DiagBuffer>) -> bool {
    if a.len != b.len {
        return false;
    }
    let mut i: usize = 0;
    while i < a.len {
        if (unsafe { *(a.ptr + i) }) != (unsafe { *(b.ptr + i) }) {
            return false;
        }
        i = i + 1;
    }
    true
}

fn verify_alias_lattice_and_dependence(
    thir_ptr: *mut Thir,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> i32 {
    let b0 = probe_mir_blob(mut_view(*arena), 0);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m0 = verify_parse_mir(b0, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m0 as usize) == 0 {
        return 11;
    }
    let o0 = optir_build_from_mir(unsafe { view(*m0) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o0 as usize) == 0 || sink.errors != 0 {
        return 12;
    }

    let info = alias_build_info(unsafe { view(*o0) }, 0 as *const EffectCallTable, mut_view(*arena));
    let pt0 = alias_make_prog_pt(0u32, 0u32);

    // 1. Concurrent `mut_view<i32>` parameters `_1` and `_2`: NoAlias, Disjoint, Proven, CAP_MUT_DISJOINT
    let p_mv1 = make_deref_pl(1u32, mut_view(*arena));
    let p_mv2 = make_deref_pl(2u32, mut_view(*arena));
    let f_mut = alias_query_places(unsafe { view(*info) }, unsafe { view(*o0) }, mut_view(*arena), view(p_mv1), view(p_mv2), pt0);
    if f_mut.result != ALIAS_NO_ALIAS || f_mut.relation != REGION_DISJOINT ||
       f_mut.certainty != CERTAINTY_PROVEN || f_mut.reason != ALIAS_REASON_CAP_MUT_DISJOINT {
        return 13;
    }

    // 2. `view<Pair>` `_3` vs `mut_view<Pair>` `_4`: NoAlias, Disjoint, Proven, CAP_VIEW_READONLY
    let p_vp = make_deref_pl(3u32, mut_view(*arena));
    let p_mvp = make_deref_pl(4u32, mut_view(*arena));
    let f_vrw = alias_query_places(unsafe { view(*info) }, unsafe { view(*o0) }, mut_view(*arena), view(p_vp), view(p_mvp), pt0);
    if f_vrw.result != ALIAS_NO_ALIAS || f_vrw.relation != REGION_DISJOINT ||
       f_vrw.certainty != CERTAINTY_PROVEN || f_vrw.reason != ALIAS_REASON_CAP_VIEW_READONLY {
        return 14;
    }

    // 3. Struct `_6: Pair`: `_6.0` vs `_6.1` -> NoAlias FIELD_DISJOINT; `_6` vs `_6.0` -> PartialAlias CONTAINS
    let p_f0 = make_field_pl(6u32, 0u32, mut_view(*arena));
    let p_f1 = make_field_pl(6u32, 1u32, mut_view(*arena));
    let p_whole = mir_local_place(6u32);
    let f_fld = alias_query_places(unsafe { view(*info) }, unsafe { view(*o0) }, mut_view(*arena), view(p_f0), view(p_f1), pt0);
    if f_fld.result != ALIAS_NO_ALIAS || f_fld.certainty != CERTAINTY_PROVEN || f_fld.reason != ALIAS_REASON_FIELD_DISJOINT {
        return 15;
    }
    let f_sub = alias_query_places(unsafe { view(*info) }, unsafe { view(*o0) }, mut_view(*arena), view(p_whole), view(p_f0), pt0);
    if f_sub.result != ALIAS_PARTIAL_ALIAS || f_sub.relation != REGION_CONTAINS {
        return 16;
    }

    // 4. Array `_7: [4]i32`: const index `_8=0` vs `_9=2` -> NoAlias CONST_INDEX; dynamic `_5` -> MayAlias DYNAMIC_INDEX
    let p_i0 = make_index_pl(7u32, 8u32, mut_view(*arena));
    let p_i2 = make_index_pl(7u32, 9u32, mut_view(*arena));
    let p_idyn = make_index_pl(7u32, 5u32, mut_view(*arena));
    let f_cidx = alias_query_places(unsafe { view(*info) }, unsafe { view(*o0) }, mut_view(*arena), view(p_i0), view(p_i2), pt0);
    if f_cidx.result != ALIAS_NO_ALIAS || f_cidx.certainty != CERTAINTY_PROVEN || f_cidx.reason != ALIAS_REASON_CONST_INDEX {
        return 17;
    }
    let f_didx = alias_query_places(unsafe { view(*info) }, unsafe { view(*o0) }, mut_view(*arena), view(p_i0), view(p_idyn), pt0);
    if f_didx.result != ALIAS_MAY_ALIAS || f_didx.certainty != CERTAINTY_POSSIBLE || f_didx.reason != ALIAS_REASON_DYNAMIC_INDEX {
        return 18;
    }

    // 5. Shared owner (`Shared<T>` / `Arc<T>`) & unknown int-to-ptr raw pointer (`_10 = cast int -> *mut i32`)
    let p_raw_unk = make_deref_pl(10u32, mut_view(*arena));
    let f_runk = alias_query_places(unsafe { view(*info) }, unsafe { view(*o0) }, mut_view(*arena), view(p_raw_unk), view(p_mv1), pt0);
    if f_runk.result != ALIAS_UNKNOWN || f_runk.certainty != CERTAINTY_UNKNOWN || f_runk.reason != ALIAS_REASON_RAW_PTR_PROVENANCE {
        return 19;
    }

    alias_mark_shared_owner(unsafe { mut_view(*info) }, 11u32);
    alias_mark_shared_owner(unsafe { mut_view(*info) }, 12u32);
    let p_sh1 = make_deref_pl(11u32, mut_view(*arena));
    let p_sh2 = make_deref_pl(12u32, mut_view(*arena));
    let f_sh = alias_query_places(unsafe { view(*info) }, unsafe { view(*o0) }, mut_view(*arena), view(p_sh1), view(p_sh2), pt0);
    if f_sh.result != ALIAS_MAY_ALIAS || f_sh.certainty != CERTAINTY_POSSIBLE || f_sh.reason != ALIAS_REASON_SHARED_OWNER {
        return 20;
    }

    // 6. MemDependence queries (`REQ-OPT-365`)
    let d_no = memopt_query_dependence(unsafe { view(*info) }, unsafe { view(*o0) }, mut_view(*arena), view(p_mv1), MEM_ACCESS_STORE, view(p_mv2), MEM_ACCESS_LOAD, pt0);
    let d_must = memopt_query_dependence(unsafe { view(*info) }, unsafe { view(*o0) }, mut_view(*arena), view(p_mv1), MEM_ACCESS_STORE, view(p_mv1), MEM_ACCESS_LOAD, pt0);
    let d_vol = memopt_query_dependence(unsafe { view(*info) }, unsafe { view(*o0) }, mut_view(*arena), view(p_mv1), MEM_ACCESS_VOLATILE_STORE, view(p_mv2), MEM_ACCESS_LOAD, pt0);
    if d_no != MEM_DEP_NO_DEPEND || d_must != MEM_DEP_MUST_DEPEND || d_vol != MEM_DEP_UNKNOWN_DEPEND {
        return 21;
    }

    // 7. Deterministic `alias_print` byte-equality check (`AXS-ESC-017`)
    alias_populate_all_facts(unsafe { mut_view(*info) }, unsafe { view(*o0) }, mut_view(*arena));
    let mut abuf1: DiagBuffer = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<DiagBuffer>(), align_of<DiagBuffer>()) as *const DiagBuffer) };
    let mut abuf2: DiagBuffer = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<DiagBuffer>(), align_of<DiagBuffer>()) as *const DiagBuffer) };
    diag_buf_init(mut_view(abuf1));
    diag_buf_init(mut_view(abuf2));
    alias_print(mut_view(abuf1), unsafe { view(*info) });
    alias_print(mut_view(abuf2), unsafe { view(*info) });
    let eq_ok = abuf1.len > 32 && diag_buf_equals(view(abuf1), view(abuf2));
    diag_buf_free(mut_view(abuf1));
    diag_buf_free(mut_view(abuf2));
    if !eq_ok {
        return 22;
    }

    print("PROBE_ALIAS_CAPABILITY_LATTICE=OK\n");
    0
}

fn verify_forwarding_rle_and_dse(
    thir_ptr: *mut Thir,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> i32 {
    let b1 = probe_mir_blob(mut_view(*arena), 1);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m1 = verify_parse_mir(b1, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m1 as usize) == 0 {
        return 31;
    }

    // Check O0 is a strict no-op
    let mut stats_o0: MemOptStats = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<MemOptStats>(), align_of<MemOptStats>()) as *const MemOptStats) };
    memopt_stats_zero(mut_view(stats_o0));
    if !memopt_optimize_mir_body(
        unsafe { mut_view(*m1) },
        thir_ptr as *const Thir,
        OPT_PROFILE_DEBUG_O0,
        true,
        0 as *const EffectCallTable,
        mut_view(stats_o0),
        0 as *mut MemOptLog,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || stats_o0.pass_runs != 0u32 || sink.errors != 0 {
        return 32;
    }

    // Run O2 --verify-each on Blob 1:
    // - `*mv_a = 10; *mv_a = 42;` -> 1 overwrite DSE
    // - `*mv_b = 99; r1 = *mv_a;` -> 1 store-to-load forward across disjoint `mut_view`
    // - `v1 = (*vp).0; (*mvp).0 = 77; v2 = (*vp).0;` -> 1 RLE across disjoint `mut_view<Pair>`
    // - `StorageLive(_dead); _dead = Pair{1,2}; StorageDead(_dead);` -> dead non-escaped local store DSE
    let mut stats_o2: MemOptStats = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<MemOptStats>(), align_of<MemOptStats>()) as *const MemOptStats) };
    let log_ptr = arena_alloc_raw(mut_view(*arena), size_of<MemOptLog>(), align_of<MemOptLog>()) as *mut MemOptLog;
    memopt_log_init(unsafe { mut_view(*log_ptr) }, mut_view(*arena));
    if !memopt_optimize_mir_body(
        unsafe { mut_view(*m1) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        mut_view(stats_o2),
        log_ptr,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 {
        return 33;
    }
    if (stats_o2.forwarded_loads) < 1u32 ||
       (stats_o2.eliminated_redundant_loads) < 1u32 ||
       (stats_o2.eliminated_dead_stores) < 2u32 ||
       stats_o2.pass_rollbacks != 0u32 {
        return 34;
    }

    // Deterministic `memopt_print` check
    let mut mbuf1: DiagBuffer = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<DiagBuffer>(), align_of<DiagBuffer>()) as *const DiagBuffer) };
    let mut mbuf2: DiagBuffer = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<DiagBuffer>(), align_of<DiagBuffer>()) as *const DiagBuffer) };
    diag_buf_init(mut_view(mbuf1));
    diag_buf_init(mut_view(mbuf2));
    memopt_print(mut_view(mbuf1), unsafe { view(*log_ptr) });
    memopt_print(mut_view(mbuf2), unsafe { view(*log_ptr) });
    let meq = mbuf1.len > 24 && diag_buf_equals(view(mbuf1), view(mbuf2));
    diag_buf_free(mut_view(mbuf1));
    diag_buf_free(mut_view(mbuf2));
    if !meq {
        return 35;
    }

    print("PROBE_FORWARDING_RLE_AND_DSE=OK\n");
    0
}

fn verify_barriers_zerocopy_intrinsics_and_loops(
    thir_ptr: *mut Thir,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> i32 {
    // 1. Blob 2: Volatile, Atomic, Zeroize, BlackBox, FFI Call, and Zero-Copy Pin barriers (`REQ-OPT-312..314`, `REQ-OPT-347`, `REQ-OPT-365`)
    let b2 = probe_mir_blob(mut_view(*arena), 2);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m2 = verify_parse_mir(b2, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m2 as usize) == 0 {
        return 41;
    }
    let o2 = optir_build_from_mir(unsafe { view(*m2) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o2 as usize) == 0 || sink.errors != 0 {
        return 42;
    }

    let bb0 = unsafe { opt_block_at((*o2).blocks, 0) };
    // Tag instructions in bb0: 0=volatile_store, 1=volatile_load, 2=atomic_load, 3=atomic_store, 4=atomic_rmw, 5=zeroize, 6=black_box, 7=pinned_store, 8=pinned_overwrite
    unsafe {
        let i0 = opt_inst_at((*bb0).insts, 0);
        (*i0).opcode = OPT_INST_VOLATILE_STORE;
        (*i0).flags = (*i0).flags | OPT_FLAG_BARRIER;

        let i1 = opt_inst_at((*bb0).insts, 1);
        (*i1).opcode = OPT_INST_VOLATILE_LOAD;
        (*i1).flags = (*i1).flags | OPT_FLAG_BARRIER;

        let i2 = opt_inst_at((*bb0).insts, 2);
        (*i2).opcode = OPT_INST_ATOMIC;
        (*i2).sub_op = 1u8;
        (*i2).flags = (*i2).flags | OPT_FLAG_BARRIER;

        let i3 = opt_inst_at((*bb0).insts, 3);
        (*i3).opcode = OPT_INST_ATOMIC;
        (*i3).sub_op = 0u8;
        (*i3).flags = (*i3).flags | OPT_FLAG_BARRIER;

        let i4 = opt_inst_at((*bb0).insts, 4);
        (*i4).opcode = OPT_INST_ATOMIC;
        (*i4).sub_op = 2u8;
        (*i4).flags = (*i4).flags | OPT_FLAG_BARRIER;

        let i5 = opt_inst_at((*bb0).insts, 5);
        (*i5).opcode = OPT_INST_ZEROIZE;
        (*i5).flags = (*i5).flags | OPT_FLAG_BARRIER;

        let i6 = opt_inst_at((*bb0).insts, 6);
        (*i6).opcode = OPT_INST_BLACK_BOX;
        (*i6).flags = (*i6).flags | OPT_FLAG_BARRIER;
    }
    optir_construct_memssa(unsafe { mut_view(*o2) }, mut_view(*arena));

    let ctab = arena_alloc_raw(mut_view(*arena), size_of<EffectCallTable>(), align_of<EffectCallTable>()) as *mut EffectCallTable;
    effect_call_table_init(unsafe { mut_view(*ctab) }, mut_view(*arena), 8);
    let bb0_callee = OptValueId { v: unsafe { (*opt_block_at((*o2).blocks, 0)).term.callee.v } };
    effect_call_table_register(
        unsafe { mut_view(*ctab) },
        mut_view(*arena),
        SymbolId { v: 1u32 },
        bb0_callee,
        effect_summary_from_flags(SymbolId { v: 1u32 }, EFFECT_FFI | EFFECT_READS_MEM | EFFECT_WRITES_MEM)
    );

    let info2 = alias_build_info(unsafe { view(*o2) }, ctab as *const EffectCallTable, mut_view(*arena));
    alias_mark_fixed_mmio(unsafe { mut_view(*info2) }, 1u32, 0u32);

    // Check all MemAccessKind classifications (`REQ-OPT-365`)
    let ci0 = unsafe { opt_inst_at((*bb0).insts, 0) };
    let ci1 = unsafe { opt_inst_at((*bb0).insts, 1) };
    let ci2 = unsafe { opt_inst_at((*bb0).insts, 2) };
    let ci3 = unsafe { opt_inst_at((*bb0).insts, 3) };
    let ci4 = unsafe { opt_inst_at((*bb0).insts, 4) };
    let ci5 = unsafe { opt_inst_at((*bb0).insts, 5) };
    let ci6 = unsafe { opt_inst_at((*bb0).insts, 6) };
    if memopt_classify_inst(unsafe { view(*info2) }, unsafe { view(*o2) }, unsafe { view(*ci0) }) != MEM_ACCESS_VOLATILE_STORE ||
       memopt_classify_inst(unsafe { view(*info2) }, unsafe { view(*o2) }, unsafe { view(*ci1) }) != MEM_ACCESS_VOLATILE_LOAD ||
       memopt_classify_inst(unsafe { view(*info2) }, unsafe { view(*o2) }, unsafe { view(*ci2) }) != MEM_ACCESS_ATOMIC_STORE ||
       memopt_classify_inst(unsafe { view(*info2) }, unsafe { view(*o2) }, unsafe { view(*ci3) }) != MEM_ACCESS_ATOMIC_LOAD ||
       memopt_classify_inst(unsafe { view(*info2) }, unsafe { view(*o2) }, unsafe { view(*ci4) }) != MEM_ACCESS_ATOMIC_RMW ||
       memopt_classify_inst(unsafe { view(*info2) }, unsafe { view(*o2) }, unsafe { view(*ci5) }) != MEM_ACCESS_MEMSET ||
       memopt_classify_inst(unsafe { view(*info2) }, unsafe { view(*o2) }, unsafe { view(*ci6) }) != MEM_ACCESS_BARRIER {
        return 43;
    }

    // Register active zero-copy DMA pin on `_3` (`REQ-OPT-347`) and verify non-aliasing path checker!
    alias_register_zero_copy_pin(unsafe { mut_view(*info2) }, mut_view(*arena), 3u32, 3u32, ALIAS_PT_WHOLE_START, ALIAS_PT_WHOLE_END);
    let zp_mut3 = make_deref_pl(3u32, mut_view(*arena));
    let zp_mmio1 = make_deref_pl(1u32, mut_view(*arena));
    let zp_ro4 = make_deref_pl(4u32, mut_view(*arena));
    let zp_dst2 = make_deref_pl(2u32, mut_view(*arena));
    if alias_verify_zero_copy_path(unsafe { view(*info2) }, unsafe { view(*o2) }, mut_view(*arena), view(zp_mut3), view(zp_dst2), ALIAS_PT_WHOLE_START, ALIAS_PT_WHOLE_END) {
        // `*_3` is mutated at inst 7 & 8 during active transfer -> MUST return false!
        return 44;
    }
    if alias_verify_zero_copy_path(unsafe { view(*info2) }, unsafe { view(*o2) }, mut_view(*arena), view(zp_ro4), view(zp_mmio1), ALIAS_PT_WHOLE_START, ALIAS_PT_WHOLE_END) {
        // `*_1` is fixed MMIO -> MUST return false!
        return 44;
    }
    let zpt_after_4 = alias_make_prog_pt(0u32, 10u32);
    if !alias_verify_zero_copy_path(unsafe { view(*info2) }, unsafe { view(*o2) }, mut_view(*arena), view(zp_ro4), view(zp_mut3), zpt_after_4, ALIAS_PT_WHOLE_END) {
        // `*_4` (`view<i32>`) is proven `NoAlias` with `*_3` (`mut_view<i32>`), non-MMIO, live from inst 10, and unmutated -> MUST return true!
        return 45;
    }

    let pm2 = arena_alloc_raw(mut_view(*arena), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
    passmgr_init(unsafe { mut_view(*pm2) }, opt_budget_for_profile(OPT_PROFILE_SPEED_O2, true), mut_view(*arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm2) }, unsafe { mut_view(*o2) }, mut_view(*arena));
    let mut stats2: MemOptStats = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<MemOptStats>(), align_of<MemOptStats>()) as *const MemOptStats) };
    memopt_stats_zero(mut_view(stats2));
    let _ = memopt_run_pass_with_info(
        unsafe { mut_view(*pm2) },
        unsafe { mut_view(*o2) },
        unsafe { mut_view(*info2) },
        ctab as *const EffectCallTable,
        mut_view(stats2),
        0 as *mut MemOptLog,
        mut_view(*arena),
        mut_view(*sink)
    );
    if stats2.eliminated_dead_stores != 0u32 ||
       stats2.forwarded_loads != 0u32 ||
       (stats2.volatile_barriers) < 1u32 ||
       (stats2.atomic_barriers) < 1u32 ||
       (stats2.ffi_barriers) < 1u32 ||
       (stats2.zero_copy_barriers) < 1u32 {
        return 46;
    }

    // 2. Blob 3: `ptr_copy` (`memmove`) -> `ptr_copy_nonoverlapping` (`memcpy`) + `ptr_write_bytes` (`memset`)
    let b3 = probe_mir_blob(mut_view(*arena), 3);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m3 = verify_parse_mir(b3, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m3 as usize) == 0 {
        return 47;
    }
    let o3_pre = optir_build_from_mir(unsafe { view(*m3) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o3_pre as usize) == 0 || sink.errors != 0 {
        return 48;
    }
    let b3_bb2 = unsafe { opt_block_at((*o3_pre).blocks, 2) };
    if memopt_classify_term(unsafe { view(*o3_pre) }, unsafe { view((*b3_bb2).term) }, 0 as *const EffectCallTable) != MEM_ACCESS_MEMMOVE {
        return 49;
    }
    let mut stats3: MemOptStats = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<MemOptStats>(), align_of<MemOptStats>()) as *const MemOptStats) };
    if !memopt_optimize_mir_body(
        unsafe { mut_view(*m3) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        mut_view(stats3),
        0 as *mut MemOptLog,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 {
        return 50;
    }
    if stats3.memmove_to_memcpy_rewrites != 1u32 || (stats3.memset_zero_inits) < 1u32 {
        return 51;
    }
    let o3_post = optir_build_from_mir(unsafe { view(*m3) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    let b3_bb2_post = unsafe { opt_block_at((*o3_post).blocks, 2) };
    if memopt_classify_term(unsafe { view(*o3_post) }, unsafe { view((*b3_bb2_post).term) }, 0 as *const EffectCallTable) != MEM_ACCESS_MEMCPY {
        return 52;
    }

    // 3. Blob 4: Loop backedge clobber (`bb0 -> bb1 -> bb2 -> bb1`) blocks forwarding!
    let b4 = probe_mir_blob(mut_view(*arena), 4);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m4 = verify_parse_mir(b4, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m4 as usize) == 0 {
        return 53;
    }
    let o4 = optir_build_from_mir(unsafe { view(*m4) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o4 as usize) == 0 || sink.errors != 0 {
        return 54;
    }
    let info4 = alias_build_info(unsafe { view(*o4) }, 0 as *const EffectCallTable, mut_view(*arena));
    let lp_mv = make_deref_pl(1u32, mut_view(*arena));
    let mut dummy_bar: u8 = 0u8;
    if !memopt_place_clobbered_on_path(unsafe { view(*info4) }, unsafe { view(*o4) }, mut_view(*arena), 0, 0, 1, 0, view(lp_mv), 0 as *const EffectCallTable, mut_view(dummy_bar)) {
        return 55;
    }
    let mut stats4: MemOptStats = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<MemOptStats>(), align_of<MemOptStats>()) as *const MemOptStats) };
    if !memopt_optimize_mir_body(
        unsafe { mut_view(*m4) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        mut_view(stats4),
        0 as *mut MemOptLog,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 || stats4.forwarded_loads != 0u32 {
        return 56;
    }

    print("PROBE_BARRIERS_ZEROCOPY_INTRINSICS=OK\n");
    0
}

fn verify_qa_round1_regressions(
    thir_ptr: *mut Thir,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>
) -> i32 {
    let pt0 = alias_make_prog_pt(0u32, 0u32);

    // 1. Blob 5 (QA Finding 1a): Interior capability deref `((*_3).0)` on `Sink { mv: mut_view<i32> }`
    let b5 = probe_mir_blob(mut_view(*arena), 5);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m5 = verify_parse_mir(b5, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m5 as usize) == 0 {
        return 61;
    }
    let o5 = optir_build_from_mir(unsafe { view(*m5) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o5 as usize) == 0 || sink.errors != 0 {
        return 62;
    }
    let info5 = alias_build_info(unsafe { view(*o5) }, 0 as *const EffectCallTable, mut_view(*arena));
    let p_sink_deref = make_field_deref_pl(3u32, 0u32, mut_view(*arena));
    let r_sink = alias_extract_region(unsafe { view(*info5) }, unsafe { view(*o5) }, view(p_sink_deref), OptValueId { v: OPT_VALUE_NONE }, mut_view(*arena));
    if !r_sink.is_interior_deref || r_sink.has_resolved_place {
        return 63;
    }
    let p_mv1 = make_deref_pl(1u32, mut_view(*arena));
    let f5 = alias_query_places(unsafe { view(*info5) }, unsafe { view(*o5) }, mut_view(*arena), view(p_sink_deref), view(p_mv1), pt0);
    if f5.result == ALIAS_NO_ALIAS || f5.result == ALIAS_MUST_ALIAS {
        return 64;
    }
    let mut stats5: MemOptStats = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<MemOptStats>(), align_of<MemOptStats>()) as *const MemOptStats) };
    if !memopt_optimize_mir_body(
        unsafe { mut_view(*m5) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        mut_view(stats5),
        0 as *mut MemOptLog,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 || stats5.forwarded_loads != 0u32 || stats5.eliminated_dead_stores != 0u32 || stats5.pass_rollbacks != 0u32 {
        return 65;
    }

    // 2. Blob 6 (QA Finding 1b): Interior raw-ptr deref `((*_3).0)` on `PtrWrap { p: *mut i32 }` + `_3.0 = copy _2`
    let b6 = probe_mir_blob(mut_view(*arena), 6);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m6 = verify_parse_mir(b6, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m6 as usize) == 0 {
        return 66;
    }
    let o6 = optir_build_from_mir(unsafe { view(*m6) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o6 as usize) == 0 || sink.errors != 0 {
        return 67;
    }
    let info6 = alias_build_info(unsafe { view(*o6) }, 0 as *const EffectCallTable, mut_view(*arena));
    let p_pw_deref = make_field_deref_pl(3u32, 0u32, mut_view(*arena));
    let r_pw = alias_extract_region(unsafe { view(*info6) }, unsafe { view(*o6) }, view(p_pw_deref), OptValueId { v: OPT_VALUE_NONE }, mut_view(*arena));
    if !r_pw.is_interior_deref || r_pw.has_resolved_place {
        return 68;
    }
    let mut dbar6: u8 = 0u8;
    let mut drsn6: u8 = 0u8;
    if memopt_prove_dead_store(unsafe { view(*info6) }, unsafe { view(*o6) }, mut_view(*arena), 0, 3, 0 as *const EffectCallTable, mut_view(dbar6), mut_view(drsn6)) {
        // Stmt 3 (`_3.0 = copy _2`) is read by `_4 = copy ((*_3).0)` and `((*_3).0) = 99` -> MUST NOT be dead!
        return 69;
    }
    let mut stats6: MemOptStats = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<MemOptStats>(), align_of<MemOptStats>()) as *const MemOptStats) };
    if !memopt_optimize_mir_body(
        unsafe { mut_view(*m6) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        mut_view(stats6),
        0 as *mut MemOptLog,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 || stats6.forwarded_loads != 0u32 || stats6.eliminated_dead_stores != 0u32 || stats6.pass_rollbacks != 0u32 {
        return 70;
    }

    // 3. Blob 7 (QA Finding 2): `mut_view` 1-hop & 2-hop reborrow chain + sibling field sub-borrows + sequential local borrows
    let b7 = probe_mir_blob(mut_view(*arena), 7);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m7 = verify_parse_mir(b7, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m7 as usize) == 0 {
        return 71;
    }
    let o7 = optir_build_from_mir(unsafe { view(*m7) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o7 as usize) == 0 || sink.errors != 0 {
        return 72;
    }
    let info7 = alias_build_info(unsafe { view(*o7) }, 0 as *const EffectCallTable, mut_view(*arena));
    let p7_1 = make_deref_pl(1u32, mut_view(*arena));
    let p7_2 = make_deref_pl(2u32, mut_view(*arena));
    let p7_3 = make_deref_pl(3u32, mut_view(*arena));
    let p7_4 = make_deref_pl(4u32, mut_view(*arena));
    let p7_5 = make_deref_pl(5u32, mut_view(*arena));
    let p7_6 = make_deref_pl(6u32, mut_view(*arena));
    let p7_8 = make_deref_pl(8u32, mut_view(*arena));
    let p7_9 = make_deref_pl(9u32, mut_view(*arena));

    let f7_hop1 = alias_query_places(unsafe { view(*info7) }, unsafe { view(*o7) }, mut_view(*arena), view(p7_1), view(p7_3), pt0);
    let f7_hop1_end = alias_query_places(unsafe { view(*info7) }, unsafe { view(*o7) }, mut_view(*arena), view(p7_1), view(p7_3), ALIAS_PT_WHOLE_END);
    let f7_hop2 = alias_query_places(unsafe { view(*info7) }, unsafe { view(*o7) }, mut_view(*arena), view(p7_1), view(p7_4), pt0);
    if f7_hop1.result != ALIAS_MUST_ALIAS || f7_hop1.relation != REGION_SAME || f7_hop1.certainty != CERTAINTY_PROVEN ||
       f7_hop1_end.result != ALIAS_MUST_ALIAS ||
       f7_hop2.result != ALIAS_MUST_ALIAS || f7_hop2.relation != REGION_SAME || f7_hop2.certainty != CERTAINTY_PROVEN {
        return 73;
    }
    let f7_parent_sub = alias_query_places(unsafe { view(*info7) }, unsafe { view(*o7) }, mut_view(*arena), view(p7_2), view(p7_5), pt0);
    let f7_siblings = alias_query_places(unsafe { view(*info7) }, unsafe { view(*o7) }, mut_view(*arena), view(p7_5), view(p7_6), pt0);
    if f7_parent_sub.result != ALIAS_PARTIAL_ALIAS || f7_parent_sub.relation != REGION_CONTAINS ||
       f7_siblings.result != ALIAS_NO_ALIAS || f7_siblings.certainty != CERTAINTY_PROVEN || f7_siblings.reason != ALIAS_REASON_FIELD_DISJOINT {
        return 74;
    }
    let f7_seq = alias_query_places(unsafe { view(*info7) }, unsafe { view(*o7) }, mut_view(*arena), view(p7_8), view(p7_9), ALIAS_PT_WHOLE_END);
    if f7_seq.result != ALIAS_MUST_ALIAS {
        return 75;
    }

    let mut stats7: MemOptStats = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<MemOptStats>(), align_of<MemOptStats>()) as *const MemOptStats) };
    if !memopt_optimize_mir_body(
        unsafe { mut_view(*m7) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        mut_view(stats7),
        0 as *mut MemOptLog,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 || stats7.pass_rollbacks != 0u32 {
        return 76;
    }
    // Verify `_10 = copy (*_1)` was forwarded `99` from `(*_4) = 99`, NEVER stale `10` from `(*_1) = 10`!
    let bb7_0 = unsafe { mir_bb_at((*m7).bbs, 0) };
    let mut found_10 = false;
    let mut si7: usize = 0;
    while si7 < (unsafe { (*bb7_0).stmt_count }) {
        let st7 = unsafe { mir_stmt_at((*bb7_0).stmts, si7) };
        if (unsafe { (*st7).place.local.v }) == 10u32 && (unsafe { (*st7).place.proj_count }) == 0 {
            found_10 = true;
            if (unsafe { (*st7).rvalue.use_op.kind }) != MIR_OP_CONST ||
               (unsafe { (*st7).rvalue.use_op.constant.val }) != 99u64 {
                return 77;
            }
        }
        si7 = si7 + 1;
    }
    if !found_10 {
        return 77;
    }

    // 4. Blob 8 (QA Findings 3 & 4): Indirect index mutation + `MIR_PROJ_DOWNCAST` enum variant overlap & field access
    let b8 = probe_mir_blob(mut_view(*arena), 8);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m8 = verify_parse_mir(b8, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m8 as usize) == 0 {
        return 78;
    }
    let p8_e_v0 = make_downcast_field_pl(4u32, 0u32, 0u32, mut_view(*arena));
    let p8_e_v1 = make_downcast_field_pl(4u32, 1u32, 0u32, mut_view(*arena));
    let p8_e_bare = make_downcast_pl(4u32, 0u32, mut_view(*arena));
    let p8_pe_f0 = make_downcast_field_pl(5u32, 0u32, 0u32, mut_view(*arena));
    let p8_pe_f1 = make_downcast_field_pl(5u32, 0u32, 1u32, mut_view(*arena));
    unsafe {
        let bb8_0 = mir_bb_at((*m8).bbs, 0);
        let st8_7 = mir_stmt_at((*bb8_0).stmts, 7);
        let st8_8 = mir_stmt_at((*bb8_0).stmts, 8);
        let st8_9 = mir_stmt_at((*bb8_0).stmts, 9);
        let st8_11 = mir_stmt_at((*bb8_0).stmts, 11);
        mir_copy_place(mut_view((*st8_7).place), view(p8_e_v0));
        mir_copy_place(mut_view((*st8_8).place), view(p8_e_v1));
        mir_copy_place(mut_view((*st8_9).rvalue.use_op.place), view(p8_e_v0));
        mir_copy_place(mut_view((*st8_11).rvalue.use_op.place), view(p8_pe_f0));
    }
    let o8 = optir_build_from_mir(unsafe { view(*m8) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o8 as usize) == 0 || sink.errors != 0 {
        return 79;
    }
    let info8 = alias_build_info(unsafe { view(*o8) }, 0 as *const EffectCallTable, mut_view(*arena));
    if alias_count_local_defs(unsafe { view(*o8) }, 2u32) <= 1u32 {
        return 80;
    }
    let p8_arr_dyn = make_index_pl(1u32, 2u32, mut_view(*arena));
    let f8_dyn = alias_query_places(unsafe { view(*info8) }, unsafe { view(*o8) }, mut_view(*arena), view(p8_arr_dyn), view(p8_arr_dyn), pt0);
    if f8_dyn.result != ALIAS_MAY_ALIAS || f8_dyn.reason != ALIAS_REASON_DYNAMIC_INDEX {
        return 81;
    }
    let mut dbar8: u8 = 0u8;
    let mut drsn8: u8 = 0u8;
    if memopt_prove_dead_store(unsafe { view(*info8) }, unsafe { view(*o8) }, mut_view(*arena), 0, 2, 0 as *const EffectCallTable, mut_view(dbar8), mut_view(drsn8)) {
        return 82;
    }

    if alias_place_access_ty(unsafe { view(*o8) }, view(p8_e_v0)).v != 8u32 {
        return 83;
    }
    let f8_diff_var = alias_query_places(unsafe { view(*info8) }, unsafe { view(*o8) }, mut_view(*arena), view(p8_e_v0), view(p8_e_v1), pt0);
    if f8_diff_var.result != ALIAS_PARTIAL_ALIAS || f8_diff_var.relation != REGION_OVERLAPS || f8_diff_var.certainty != CERTAINTY_POSSIBLE {
        return 84;
    }
    let f8_bare = alias_query_places(unsafe { view(*info8) }, unsafe { view(*o8) }, mut_view(*arena), view(p8_e_bare), view(p8_e_bare), pt0);
    if f8_bare.result != ALIAS_PARTIAL_ALIAS || f8_bare.certainty != CERTAINTY_POSSIBLE {
        return 85;
    }
    let f8_same_var_flds = alias_query_places(unsafe { view(*info8) }, unsafe { view(*o8) }, mut_view(*arena), view(p8_pe_f0), view(p8_pe_f1), pt0);
    if f8_same_var_flds.result != ALIAS_NO_ALIAS || f8_same_var_flds.relation != REGION_DISJOINT ||
       f8_same_var_flds.certainty != CERTAINTY_PROVEN || f8_same_var_flds.reason != ALIAS_REASON_FIELD_DISJOINT {
        return 86;
    }

    let mut stats8: MemOptStats = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<MemOptStats>(), align_of<MemOptStats>()) as *const MemOptStats) };
    if !memopt_optimize_mir_body(
        unsafe { mut_view(*m8) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        mut_view(stats8),
        0 as *mut MemOptLog,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 || stats8.eliminated_dead_stores != 0u32 || stats8.forwarded_loads != 0u32 || stats8.pass_rollbacks != 0u32 {
        return 87;
    }

    print("PROBE_QA_ROUND1_REGRESSIONS=OK\n");
    0
}

fn main() -> i32 {
    let mut arena = arena_new();
    let mut sink: DiagSink = unsafe { *(arena_alloc_raw(mut_view(arena), size_of<DiagSink>(), align_of<DiagSink>()) as *const DiagSink) };
    diag_sink_init(mut_view(sink));

    let thir_ptr = arena_alloc_raw(mut_view(arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    probe_init_alias_thir(thir_ptr, mut_view(arena));

    let r1 = verify_alias_lattice_and_dependence(thir_ptr, mut_view(arena), mut_view(sink));
    if r1 != 0 {
        probe_free_alias_thir(thir_ptr);
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return r1;
    }

    let r2 = verify_forwarding_rle_and_dse(thir_ptr, mut_view(arena), mut_view(sink));
    if r2 != 0 {
        probe_free_alias_thir(thir_ptr);
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return r2;
    }

    let r3 = verify_barriers_zerocopy_intrinsics_and_loops(thir_ptr, mut_view(arena), mut_view(sink));
    if r3 != 0 {
        probe_free_alias_thir(thir_ptr);
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return r3;
    }

    let r4 = verify_qa_round1_regressions(thir_ptr, mut_view(arena), mut_view(sink));
    if r4 != 0 {
        probe_free_alias_thir(thir_ptr);
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return r4;
    }

    probe_free_alias_thir(thir_ptr);
    diag_sink_free(mut_view(sink));
    arena_destroy(mut_view(arena));
    print("PROBE_ALL=OK\n");
    0
}
