// test: run
// stdout: ALIAS_BANNER=Xin chào phân tích bí danh\nMUT_VIEW_FWD=141\nVIEW_RLE=230\nFIELD_SLICE=149\nALIAS_TOTAL=520\n

struct Pair {
    left: i32,
    right: i32,
}

fn disjoint_mut_views_forward_and_dse(a: mut_view<i32>, b: mut_view<i32>) -> i32 {
    // Overwritten store to `*a` is dead; second store `*a = 42` forwards across disjoint `*b = 99`!
    *a = 10;
    *a = 42;
    *b = 99;
    let reloaded_a: i32 = *a;
    reloaded_a + *b
}

fn view_rle_across_disjoint_mut_view(src: view<Pair>, dst: mut_view<Pair>) -> i32 {
    // `src` (`view<Pair>`) cannot overlap active `dst` (`mut_view<Pair>`) (AXS-ALIAS-003.2, REQ-OPT-301).
    let first_sum: i32 = src.left + src.right;
    dst.left = 70;
    dst.right = 80;
    let second_sum: i32 = src.left + src.right;
    first_sum + second_sum + dst.left + dst.right
}

fn write_disjoint_fields(lhs: mut_view<i32>, rhs: mut_view<i32>) -> i32 {
    *lhs = 11;
    *rhs = 22;
    let l_after: i32 = *lhs;
    l_after + *rhs
}

fn struct_field_and_const_slice_disjoint() -> i32 {
    let mut p = Pair { left: 3, right: 7 };
    let fsum: i32 = write_disjoint_fields(mut_view(p.left), mut_view(p.right));

    let mut arr: [4]i32 = [1, 2, 3, 4];
    arr[0] = 50;
    arr[2] = 60;
    let asum: i32 = arr[0] + arr[1] + arr[2] + arr[3];
    fsum + asum
}

fn main() -> i32 {
    print("ALIAS_BANNER=Xin chào phân tích bí danh\n");

    let mut slot_a: i32 = 1;
    let mut slot_b: i32 = 2;
    let r1: i32 = disjoint_mut_views_forward_and_dse(mut_view(slot_a), mut_view(slot_b));

    let src_pair = Pair { left: 15, right: 25 };
    let mut dst_pair = Pair { left: 0, right: 0 };
    let r2: i32 = view_rle_across_disjoint_mut_view(view(src_pair), mut_view(dst_pair));

    let r3: i32 = struct_field_and_const_slice_disjoint();
    let total: i32 = r1 + r2 + r3;

    print("MUT_VIEW_FWD=");
    print_int(r1);
    print("\nVIEW_RLE=");
    print_int(r2);
    print("\nFIELD_SLICE=");
    print_int(r3);
    print("\nALIAS_TOTAL=");
    print_int(total);
    print("\n");
    0
}
