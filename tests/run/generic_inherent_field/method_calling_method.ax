// test: run
// modes: interp native
// stdout: 15 24 37 21 53\n
// exit: 150
// Regression for T489: generic inherent impl methods calling other generic inherent impl
// methods (view -> view, mut_view -> view, by-value -> view, and cross-instantiation call
// from Wrap<i32> to Wrap<Wide>).

struct Wide {
    a: i64,
    b: i32,
}

struct Wrap<T> {
    k: i32,
    v: T,
    tail: i32,
}

impl<T> Wrap<T> {
    fn get_k(self: view<Wrap<T>>) -> i32 {
        self.k
    }

    fn get_tail(self: view<Wrap<T>>) -> i32 {
        self.tail
    }

    fn sum_both(self: view<Wrap<T>>) -> i32 {
        self.get_k() + self.get_tail()
    }

    fn bump_and_sum(self: mut_view<Wrap<T>>, delta: i32) -> i32 {
        self.k = self.k + delta;
        view(*self).sum_both()
    }

    fn consume_sum(self: Wrap<T>) -> i32 {
        self.sum_both()
    }

    fn cross_inst_sum(self: view<Wrap<T>>) -> i32 {
        let other = Wrap<Wide> { k: 13, v: Wide { a: 100i64, b: 200 }, tail: 8 };
        other.sum_both()
    }
}

fn main() -> i32 {
    let mut w1 = Wrap<i32> { k: 5, v: 99, tail: 10 };
    let r1 = w1.sum_both();        // 5 + 10 = 15
    let r2 = w1.bump_and_sum(9);   // (5 + 9) + 10 = 24
    let r4 = w1.cross_inst_sum();  // 13 + 8 = 21

    let w2 = Wrap<Wide> { k: 17, v: Wide { a: 7i64, b: 8 }, tail: 20 };
    let r3 = w2.consume_sum();     // 17 + 20 = 37

    let mut w3 = Wrap<Wide> { k: 22, v: Wide { a: 1i64, b: 2 }, tail: 25 };
    let r5 = w3.bump_and_sum(6);   // (22 + 6) + 25 = 53

    print_int(r1);
    print(" ");
    print_int(r2);
    print(" ");
    print_int(r3);
    print(" ");
    print_int(r4);
    print(" ");
    print_int(r5);
    print("\n");
    r1 + r2 + r3 + r4 + r5
}
