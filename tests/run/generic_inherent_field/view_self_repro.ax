// test: run
// modes: interp native
// stdout: 3 3\n
// exit: 6
// Regression for T489 (T485 follow-up F-2): generic inherent impl method with view self
// reading a field of a struct that has a T-typed field.

struct Wrap<T> {
    k: i32,
    v: T,
}

impl<T> Wrap<T> {
    fn get(self: view<Wrap<T>>) -> i32 {
        self.k
    }
}

fn main() -> i32 {
    let a = Wrap<i32> { k: 3, v: 1 };
    let r1 = a.get();
    let r2 = view(a).get();
    print_int(r1);
    print(" ");
    print_int(r2);
    print("\n");
    r1 + r2
}
