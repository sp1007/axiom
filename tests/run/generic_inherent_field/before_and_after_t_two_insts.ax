// test: run
// modes: interp native
// stdout: 17 23 19 31 41 25\n
// exit: 156
// Regression for T489: fields before and after a T-typed field across two distinct
// instantiations (i32 vs an 8-byte-aligned struct Payload whose alignment reorders fields).

@derive(Copy)
struct Payload {
    x: i64,
    y: i32,
    z: u8,
}

struct Tri<T> {
    before: i32,
    mid: T,
    after: i32,
}

impl<T> Tri<T> {
    fn get_before(self: view<Tri<T>>) -> i32 {
        self.before
    }

    fn get_after(self: view<Tri<T>>) -> i32 {
        self.after
    }

    fn get_mid(self: view<Tri<T>>) -> T where T: Copy {
        self.mid
    }
}

fn main() -> i32 {
    let t_int = Tri<i32> { before: 17, mid: 19, after: 23 };
    let a = t_int.get_before();
    let b = t_int.get_after();
    let c = t_int.get_mid();

    let t_pay = Tri<Payload> { before: 31, mid: Payload { x: 10i64, y: 12, z: 3u8 }, after: 41 };
    let d = t_pay.get_before();
    let e = t_pay.get_after();
    let p = t_pay.get_mid();
    let f = (p.x as i32) + p.y + (p.z as i32);

    print_int(a);
    print(" ");
    print_int(b);
    print(" ");
    print_int(c);
    print(" ");
    print_int(d);
    print(" ");
    print_int(e);
    print(" ");
    print_int(f);
    print("\n");
    a + b + c + d + e + f
}
