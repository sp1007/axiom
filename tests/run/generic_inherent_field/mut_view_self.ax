// test: run
// modes: interp native
// stdout: 15 29 52 71\n
// exit: 167
// Regression for T489: generic inherent impl with mut_view self updating and reading
// fields before and after a T-typed field for two instantiations (i32 and a struct).

struct Pair {
    big: i64,
    small: i32,
}

struct Boxed<T> {
    before: i32,
    item: T,
    after: i32,
}

impl<T> Boxed<T> {
    fn bump(self: mut_view<Boxed<T>>, db: i32, da: i32) -> i32 {
        self.before = self.before + db;
        self.after = self.after + da;
        self.before + self.after
    }

    fn set_item(self: mut_view<Boxed<T>>, nv: T) {
        self.item = nv;
    }

    fn read_before(self: view<Boxed<T>>) -> i32 {
        self.before
    }

    fn read_after(self: view<Boxed<T>>) -> i32 {
        self.after
    }
}

fn main() -> i32 {
    let mut b1 = Boxed<i32> { before: 10, item: 1, after: 20 };
    let _ = b1.bump(5, 9);
    mut_view(b1).set_item(99);
    let r1 = b1.read_before();
    let r2 = b1.read_after();

    let mut b2 = Boxed<Pair> { before: 40, item: Pair { big: 100i64, small: 2 }, after: 60 };
    let _ = mut_view(b2).bump(12, 11);
    b2.set_item(Pair { big: 5i64, small: 6 });
    let r3 = b2.read_before();
    let r4 = b2.read_after();

    print_int(r1);
    print(" ");
    print_int(r2);
    print(" ");
    print_int(r3);
    print(" ");
    print_int(r4);
    print("\n");
    r1 + r2 + r3 + r4
}
