// test: run
// modes: interp native
// stdout: 23 33 33 34 22 40 46 46 20 25 15 34 21 35 19 18 88\n
// exit: 152
// Adversarial QA test for T489:
// - 2-param generic struct Pair<A, B> with mixed alignments (u8, u64) and (u64, u8)
// - nested generic Wrap<Pair<u8, i64>> with same inherent method name `sum_meta` (1 vs 2 generic params)
// - multiple inherent impl blocks on Pair<A, B>, plus non-generic impl Plain { fn sum_meta, fn tag_with<U> }
// - mut_view mutation before/between/after A and B, auto-ref on field projection w.inner.bump_meta(...)
// - generic inherent method reading/replacing A and B fields directly
// - generic inherent method called from free generic fn (incl. nested Wrap<Pair<u8, T>>),
//   and from a generic trait impl

struct Pair<A, B> {
    tag: u8,
    a: A,
    mid: i32,
    b: B,
    end: u8,
}

struct Wrap<T> {
    prefix: u8,
    inner: T,
    suffix: i32,
}

struct Plain {
    x: i32,
}

trait Score {
    fn score(self: view<Self>) -> i32;
}

impl Plain {
    fn sum_meta(self: view<Plain>) -> i32 {
        self.x
    }

    fn tag_with<U>(self: view<Plain>, u: U) -> i32 {
        self.x + 1
    }
}

impl<A, B> Pair<A, B> {
    fn sum_meta(self: view<Pair<A, B>>) -> i32 {
        (self.tag as i32) + self.mid + (self.end as i32)
    }

    fn bump_meta(self: mut_view<Pair<A, B>>, dt: u8, dm: i32, de: u8) -> i32 {
        self.tag = self.tag + dt;
        self.mid = self.mid + dm;
        self.end = self.end + de;
        view(*self).sum_meta()
    }

    fn set_ab(self: mut_view<Pair<A, B>>, na: A, nb: B) {
        self.a = na;
        self.b = nb;
    }

    fn cross_swap_check(self: view<Pair<A, B>>) -> i32 {
        let mut p = Pair<u64, u8> { tag: 2u8, a: 999u64, mid: 10, b: 1u8, end: 3u8 };
        p.bump_meta(1u8, 4, 2u8)
    }
}

impl<A, B> Pair<A, B> {
    fn take_mid(self: Pair<A, B>) -> i32 {
        self.mid + (self.tag as i32) + (self.end as i32)
    }

    fn get_a(self: view<Pair<A, B>>) -> A where A: Copy {
        self.a
    }

    fn get_b(self: view<Pair<A, B>>) -> B where B: Copy {
        self.b
    }
}

impl<A, B> Score for Pair<A, B> {
    fn score(self: view<Pair<A, B>>) -> i32 {
        self.sum_meta() + 1
    }
}

impl<T> Wrap<T> {
    fn sum_meta(self: view<Wrap<T>>) -> i32 {
        (self.prefix as i32) + self.suffix
    }

    fn bump_suffix(self: mut_view<Wrap<T>>, d: i32) -> i32 {
        self.suffix = self.suffix + d;
        view(*self).sum_meta()
    }
}

fn free_pair_sum<X, Y>(p: view<Pair<X, Y>>) -> i32 {
    p.sum_meta()
}

fn free_pair_score<X, Y>(p: view<Pair<X, Y>>) -> i32 where Pair<X, Y>: Score {
    p.score()
}

fn nested_read<T>(w: view<Wrap<Pair<u8, T>>>) -> i32 {
    w.sum_meta() + w.inner.sum_meta()
}

fn main() -> i32 {
    let mut p1 = Pair<u8, u64> { tag: 1u8, a: 9u8, mid: 20, b: 1000u64, end: 2u8 };
    let r1 = p1.sum_meta();                   // 1 + 20 + 2 = 23
    let r2 = p1.bump_meta(2u8, 5, 3u8);       // 3 + 25 + 5 = 33
    p1.set_ab(12u8, 76u64);
    let r3 = free_pair_sum(view(p1));         // 33
    let r4 = p1.score();                      // 34
    let r5 = p1.cross_swap_check();           // (2+1) + (10+4) + (3+2) = 22

    let mut p2 = Pair<u64, u8> { tag: 4u8, a: 777u64, mid: 30, b: 8u8, end: 6u8 };
    let r6 = p2.sum_meta();                   // 4 + 30 + 6 = 40
    let r7 = p2.bump_meta(1u8, 2, 3u8);       // 5 + 32 + 9 = 46
    let r8 = p2.take_mid();                   // 46

    let mut w = Wrap<Pair<u8, i64>> {
        prefix: 7u8,
        inner: Pair<u8, i64> { tag: 1u8, a: 2u8, mid: 11, b: 500i64, end: 3u8 },
        suffix: 13,
    };
    let r9 = w.sum_meta();                    // 7 + 13 = 20
    let r10 = w.bump_suffix(5);               // 7 + 18 = 25
    let r11 = w.inner.sum_meta();             // 1 + 11 + 3 = 15
    let r12 = free_pair_score(view(p1));      // 34
    let r13 = w.inner.bump_meta(1u8, 4, 1u8); // (1+1) + (11+4) + (3+1) = 21
    let r14 = nested_read(view(w)) - 11;      // (25 + 21) - 11 = 35

    let pl = Plain { x: 18 };
    let r15 = pl.tag_with(99u64);             // 19
    let r16 = pl.sum_meta();                  // 18

    let r17 = (p1.get_a() as i32) + (p1.get_b() as i32); // 12 + 76 = 88

    print_int(r1); print(" ");
    print_int(r2); print(" ");
    print_int(r3); print(" ");
    print_int(r4); print(" ");
    print_int(r5); print(" ");
    print_int(r6); print(" ");
    print_int(r7); print(" ");
    print_int(r8); print(" ");
    print_int(r9); print(" ");
    print_int(r10); print(" ");
    print_int(r11); print(" ");
    print_int(r12); print(" ");
    print_int(r13); print(" ");
    print_int(r14); print(" ");
    print_int(r15); print(" ");
    print_int(r16); print(" ");
    print_int(r17); print("\n");
    (r1 + r2 + r3 + r4 + r5 + r6 + r7 + r8 + r9 + r10 + r11 + r12 + r13 + r14 + r15 + r16 + r17) % 200
}
