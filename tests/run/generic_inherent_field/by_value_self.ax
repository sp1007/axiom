// test: run
// modes: interp native
// stdout: 11 22 7 33 44 19\n
// exit: 136
// Regression for T489: generic inherent impl with by-value self reading fields before
// and after a T-typed field, instantiated with i32 and with an 8-byte-aligned struct.

struct Wide {
    hi: i64,
    lo: i32,
}

struct Holder<T> {
    head: i32,
    val: T,
    tail: i32,
}

impl<T> Holder<T> {
    fn take_head(self: Holder<T>) -> i32 {
        self.head
    }

    fn take_tail(self: Holder<T>) -> i32 {
        self.tail
    }

    fn take_val(self: Holder<T>) -> T {
        self.val
    }
}

fn main() -> i32 {
    let h1 = Holder<i32> { head: 11, val: 7, tail: 22 };
    let h2 = Holder<i32> { head: 11, val: 7, tail: 22 };
    let h3 = Holder<i32> { head: 11, val: 7, tail: 22 };
    let a = h1.take_head();
    let b = h2.take_tail();
    let c = h3.take_val();

    let w1 = Holder<Wide> { head: 33, val: Wide { hi: 10i64, lo: 9 }, tail: 44 };
    let w2 = Holder<Wide> { head: 33, val: Wide { hi: 10i64, lo: 9 }, tail: 44 };
    let w3 = Holder<Wide> { head: 33, val: Wide { hi: 10i64, lo: 9 }, tail: 44 };
    let d = w1.take_head();
    let e = w2.take_tail();
    let wv = w3.take_val();
    let f = (wv.hi as i32) + wv.lo;

    print_int(a);
    print(" ");
    print_int(b);
    print(" ");
    print_int(c);
    print(" ");
    print_int(d);
    print(" ");
    print_int(e);
    print(" ");
    print_int(f);
    print("\n");
    a + b + c + d + e + f
}
