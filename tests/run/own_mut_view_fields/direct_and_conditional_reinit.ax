// test: run
// modes: interp native
// stdout: 9\n1\n2\n9\n1\n2\n9\n1\n2\n2\n9\n1\n3\n4\n1\n8\n2\n8\n3\n4\n1\n2\n7\n3\n4\n
//
// T445 FU-4 (SPEC-12 AXS-DROP-003, AXS-DROP-007; SPEC-10 AXS-OWN-006):
// Direct moves out of mut_view fields, whole *m derefs, nested fields, independent sibling
// fields, conditional moves across branches, explicit drop(self.field), double reassignment,
// and self-transform reassignment all respect dynamic drop flags on mut_view places.

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct StrRepr {
    ptr: *const u8,
    len: usize,
}

fn emit_digit(d: u8) {
    let buf: [2]u8 = [48u8 + d, 10u8];
    let v: view<[2]u8> = view(buf);
    let p: *const u8 = unsafe { *(address_of(v) as *const *const u8) };
    let repr = StrRepr { ptr: p, len: 2 };
    let s: str = unsafe { *(address_of(repr) as *const str) };
    print(s);
}

struct Guard {
    pub id: u8,
}

impl Drop for Guard {
    fn drop(self: mut_view<Self>) {
        emit_digit(self.id);
    }
}

struct Holder {
    pub inner: Guard,
    pub tag: u8,
}

struct Outer {
    pub h: Holder,
}

struct Pair {
    pub a: Guard,
    pub b: Guard,
}

impl Holder {
    fn swap_inner(self: mut_view<Self>, g2: Guard) -> Guard {
        let old = self.inner;
        self.inner = g2;
        old
    }

    fn maybe_take_and_set(self: mut_view<Self>, take: bool, g2: Guard) {
        if take {
            let old = self.inner;
        }
        emit_digit(8u8);
        self.inner = g2;
    }

    fn drop_then_reassign_twice(self: mut_view<Self>) {
        drop(self.inner);
        self.inner = Guard { id: 2u8 };
        self.inner = Guard { id: 3u8 };
        self.inner = transform(self.inner);
    }
}

impl Pair {
    fn replace_both(self: mut_view<Self>, a2: Guard, b2: Guard) -> Guard {
        let old_a = self.a;
        self.b = b2;
        self.a = a2;
        old_a
    }
}

fn replace_deref(m: mut_view<Guard>, g2: Guard) -> Guard {
    let old = *m;
    *m = g2;
    old
}

fn swap_nested(o: mut_view<Outer>, g2: Guard) -> Guard {
    let old = o.h.inner;
    o.h.inner = g2;
    old
}

fn transform(g: Guard) -> Guard {
    emit_digit(7u8);
    Guard { id: 4u8 }
}

pub fn main() -> i32 {
    {
        let mut h = Holder { inner: Guard { id: 1u8 }, tag: 0u8 };
        let old = h.swap_inner(Guard { id: 2u8 });
        emit_digit(9u8);
    }
    {
        let mut g = Guard { id: 1u8 };
        let old = replace_deref(mut_view(g), Guard { id: 2u8 });
        emit_digit(9u8);
    }
    {
        let mut o = Outer { h: Holder { inner: Guard { id: 1u8 }, tag: 0u8 } };
        let old = swap_nested(mut_view(o), Guard { id: 2u8 });
        emit_digit(9u8);
    }
    {
        let mut p = Pair { a: Guard { id: 1u8 }, b: Guard { id: 2u8 } };
        let old_a = p.replace_both(Guard { id: 3u8 }, Guard { id: 4u8 });
        emit_digit(9u8);
    }
    {
        let mut h1 = Holder { inner: Guard { id: 1u8 }, tag: 0u8 };
        h1.maybe_take_and_set(true, Guard { id: 2u8 });
    }
    {
        let mut h2 = Holder { inner: Guard { id: 3u8 }, tag: 0u8 };
        h2.maybe_take_and_set(false, Guard { id: 4u8 });
    }
    {
        let mut h3 = Holder { inner: Guard { id: 1u8 }, tag: 0u8 };
        h3.drop_then_reassign_twice();
    }
    0
}
