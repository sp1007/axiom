// test: run
// modes: interp native
// stdout: 8\n2\n8\n4\n6\n9\n4\n7\n6\n6\n6\n9\n3\n2\n9\n1\n0\n
//
// T445 QA adversarial (SPEC-12 AXS-DROP-003/007, SPEC-10 AXS-OWN-006):
// - move out of a mut_view field and re-init it conditionally inside a loop: the dynamic
//   view drop flag must carry across iterations (HEAD dropped the moved-out value again);
// - `while let` on a mut_view place left by `break` drops the binding exactly once;
// - `while let` over a call scrutinee with `continue`/`break` drops each binding once.

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct StrRepr {
    ptr: *const u8,
    len: usize,
}

fn emit_digit(d: u8) {
    let buf: [2]u8 = [48u8 + d, 10u8];
    let v: view<[2]u8> = view(buf);
    let p: *const u8 = unsafe { *(address_of(v) as *const *const u8) };
    let repr = StrRepr { ptr: p, len: 2 };
    let s: str = unsafe { *(address_of(repr) as *const str) };
    print(s);
}

struct Guard {
    pub id: u8,
}

impl Drop for Guard {
    fn drop(self: mut_view<Self>) {
        emit_digit(self.id);
    }
}

struct Holder {
    pub guard: Option<Guard>,
    pub g2: Guard,
}

impl Holder {
    // move out and re-init in a loop, conditionally (dynamic flag across iterations)
    fn cycle(self: mut_view<Self>) {
        let mut i: u8 = 0u8;
        while i < 4u8 {
            if i % 2u8 == 0u8 {
                let old = self.g2;
                emit_digit(8u8);
            } else {
                self.g2 = Guard { id: 3u8 + i };
            }
            i = i + 1u8;
        }
    }

    // while let on a view place with break
    fn drain_break(self: mut_view<Self>) {
        while let Option.Some(g) = self.guard {
            self.guard = Option.None;
            emit_digit(9u8);
            break;
        }
        emit_digit(7u8);
    }
}

struct Counter {
    pub n: u8,
}

impl Counter {
    fn next(self: mut_view<Self>) -> Option<Guard> {
        if self.n == 0u8 {
            Option.None
        } else {
            self.n = self.n - 1u8;
            Option.Some(Guard { id: self.n })
        }
    }
}

fn while_let_continue_break() {
    let mut c = Counter { n: 4u8 };
    while let Option.Some(g) = c.next() {
        if g.id == 2u8 {
            continue;
        }
        if g.id == 0u8 {
            break;
        }
        emit_digit(9u8);
    }
}

pub fn main() -> i32 {
    {
        let mut h = Holder { guard: Option.Some(Guard { id: 4u8 }), g2: Guard { id: 2u8 } };
        h.cycle();
        emit_digit(6u8);
        h.drain_break();
        emit_digit(6u8);
    }
    emit_digit(6u8);
    while_let_continue_break();
    0
}
