// test: run
// modes: interp native
// stdout: 1\n2\n2\n3\n4\n4\n5\n6\n6\n6\n
//
// T445 QA adversarial (SPEC-11 AXS-CAP-001/002/005): view/mut_view receivers are reborrowed,
// not moved, also for a trait method on a generic `mut_view<T>`, a nested
// `mut_view<mut_view<C>>`, and a `mut_view` stored in a struct field.

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct StrRepr {
    ptr: *const u8,
    len: usize,
}

fn emit_digit(d: u8) {
    let buf: [2]u8 = [48u8 + d, 10u8];
    let v: view<[2]u8> = view(buf);
    let p: *const u8 = unsafe { *(address_of(v) as *const *const u8) };
    let repr = StrRepr { ptr: p, len: 2 };
    let s: str = unsafe { *(address_of(repr) as *const str) };
    print(s);
}

struct Ctx {
    pub count: u8,
}

trait Bump {
    fn bump(self: mut_view<Self>) -> u8;
    fn peek(self: view<Self>) -> u8;
}

impl Bump for Ctx {
    fn bump(self: mut_view<Self>) -> u8 {
        self.count = self.count + 1u8;
        self.count
    }
    fn peek(self: view<Self>) -> u8 {
        self.count
    }
}

fn generic_twice<T: Bump>(t: mut_view<T>) {
    emit_digit(t.bump());
    emit_digit(t.bump());
    emit_digit(t.peek());
}

fn nested(mm: mut_view<mut_view<Ctx> >) {
    emit_digit(mm.bump());
    emit_digit(mm.bump());
}

struct Holder {
    pub cx: mut_view<Ctx>,
}

fn via_field(h: mut_view<Holder>) {
    emit_digit(h.cx.bump());
    emit_digit(h.cx.bump());
    emit_digit(h.cx.peek());
}

fn run_nested(c: mut_view<Ctx>) {
    let mut mv = c;
    nested(mut_view(mv));
    emit_digit(mv.peek());
}

fn run_field(c: mut_view<Ctx>) {
    let mut h = Holder { cx: c };
    via_field(mut_view(h));
}

pub fn main() -> i32 {
    let mut c = Ctx { count: 0u8 };
    generic_twice(mut_view(c));
    run_nested(mut_view(c));
    run_field(mut_view(c));
    emit_digit(c.count);
    0
}
