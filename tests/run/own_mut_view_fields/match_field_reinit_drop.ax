// test: run
// modes: interp native
// stdout: 8\n9\n7\n1\n6\n2\n5\n3\n4\n0\n8\n1\n9\n2\n
//
// T445 FU-4 (SPEC-12 AXS-DROP-003, AXS-DROP-007; SPEC-10 AXS-OWN-006):
// Moving out of a field reached through `mut_view` via `match` / `if let` / `while let`
// leaves that field uninitialised, so a subsequent re-assignment MUST NOT drop the old
// moved-out value; conversely, a wildcard/non-moving arm leaves the field initialised so
// a later overwrite DOES drop the old value. A moved-out `match`/`if let` binding is dropped
// at the end of the enclosing block (current binding drop scope, unchanged by T445); a
// `while let` binding is dropped at the end of each iteration.

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct StrRepr {
    ptr: *const u8,
    len: usize,
}

fn emit_digit(d: u8) {
    let buf: [2]u8 = [48u8 + d, 10u8];
    let v: view<[2]u8> = view(buf);
    let p: *const u8 = unsafe { *(address_of(v) as *const *const u8) };
    let repr = StrRepr { ptr: p, len: 2 };
    let s: str = unsafe { *(address_of(repr) as *const str) };
    print(s);
}

struct Guard {
    pub id: u8,
}

impl Drop for Guard {
    fn drop(self: mut_view<Self>) {
        emit_digit(self.id);
    }
}

struct Worker {
    pub guard: Option<Guard>,
    pub tag: u8,
}

impl Worker {
    fn replace_guard(self: mut_view<Self>, g2: Guard) {
        match self.guard {
            Option.Some(g) => {
                emit_digit(8u8);
                self.guard = Option.Some(g2);
                emit_digit(9u8);
            },
            Option.None => {
                self.guard = Option.Some(g2);
            },
        }
        emit_digit(7u8);
    }

    fn match_wildcard_then_overwrite(self: mut_view<Self>, g3: Guard) {
        match self.guard {
            Option.Some(_) => {
                emit_digit(6u8);
            },
            Option.None => {},
        }
        self.guard = Option.Some(g3);
    }

    fn if_let_replace(self: mut_view<Self>, g4: Guard) {
        if let Option.Some(g) = self.guard {
            emit_digit(5u8);
            self.guard = Option.Some(g4);
        }
    }

    fn clear_via_match(self: mut_view<Self>) {
        match self.guard {
            Option.Some(g) => {
                self.guard = Option.None;
            },
            Option.None => {},
        }
    }

    fn match_none_noop(self: mut_view<Self>) {
        match self.guard {
            Option.Some(g) => {
                self.guard = Option.Some(g);
            },
            Option.None => {
                emit_digit(0u8);
            },
        }
    }

    fn drain_while_let(self: mut_view<Self>) {
        while let Option.Some(g) = self.guard {
            if g.id == 1u8 {
                self.guard = Option.Some(Guard { id: 2u8 });
                emit_digit(8u8);
            } else {
                self.guard = Option.None;
                emit_digit(9u8);
            }
        }
    }
}

pub fn main() -> i32 {
    {
        let mut w = Worker { guard: Option.Some(Guard { id: 1u8 }), tag: 0u8 };
        w.replace_guard(Guard { id: 2u8 });
        w.match_wildcard_then_overwrite(Guard { id: 3u8 });
        w.if_let_replace(Guard { id: 4u8 });
        w.clear_via_match();
        w.match_none_noop();
    }
    {
        let mut w2 = Worker { guard: Option.Some(Guard { id: 1u8 }), tag: 0u8 };
        w2.drain_while_let();
    }
    0
}
