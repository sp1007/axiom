// test: run
// modes: interp native
// stdout: 9\n1\n2\n5\n3\n1\n7\n6\n
//
// T445 FU-4 (SPEC-12 AXS-DROP-003, AXS-DROP-007; SPEC-10 AXS-OWN-006):
// After a partial move out of a nested field reached through `mut_view`, re-assigning the
// PARENT place drops only the fields that are still initialised (the moved-out field is
// not dropped again). A sibling that was not moved out is dropped by the re-assignment.

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct StrRepr {
    ptr: *const u8,
    len: usize,
}

fn emit_digit(d: u8) {
    let buf: [2]u8 = [48u8 + d, 10u8];
    let v: view<[2]u8> = view(buf);
    let p: *const u8 = unsafe { *(address_of(v) as *const *const u8) };
    let repr = StrRepr { ptr: p, len: 2 };
    let s: str = unsafe { *(address_of(repr) as *const str) };
    print(s);
}

struct Guard {
    pub id: u8,
}

impl Drop for Guard {
    fn drop(self: mut_view<Self>) {
        emit_digit(self.id);
    }
}

struct Holder {
    pub inner: Guard,
    pub tag: u8,
}

struct Outer {
    pub h: Holder,
}

struct Pair {
    pub a: Guard,
    pub b: Guard,
}

fn swap_parent(o: mut_view<Outer>, g2: Guard) -> Guard {
    let old = o.h.inner;
    o.h = Holder { inner: g2, tag: 1u8 };
    old
}

fn take_a_reset_pair(p: mut_view<Pair>, a2: Guard, b2: Guard) -> Guard {
    let old_a = p.a;
    emit_digit(5u8);
    *p = Pair { a: a2, b: b2 };
    old_a
}

pub fn main() -> i32 {
    {
        let mut o = Outer { h: Holder { inner: Guard { id: 1u8 }, tag: 0u8 } };
        let old = swap_parent(mut_view(o), Guard { id: 2u8 });
        emit_digit(9u8);
    }
    {
        // b (id 3) is still initialised and is dropped by `*p = ...`; a (id 1) was moved out
        // and returned, so it is dropped exactly once at block end (`old_a` first, then `pr`).
        let mut pr = Pair { a: Guard { id: 1u8 }, b: Guard { id: 3u8 } };
        let old_a = take_a_reset_pair(mut_view(pr), Guard { id: 7u8 }, Guard { id: 6u8 });
    }
    0
}
