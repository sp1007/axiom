// test: run
// modes: interp native
// stdout: 1\n2\n3\n4\n5\n6\n4\n5\n5\n
//
// T445 FU-6 (SPEC-11 AXS-CAP-001, AXS-CAP-002, AXS-CAP-005):
// Calling methods taking `self: mut_view<T>` or `self: view<T>` on a `mut_view<T>` or
// `view<T>` parameter (or local) reborrows the view rather than moving it, and executes
// identically in interp, native, and native-O1.

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct StrRepr {
    ptr: *const u8,
    len: usize,
}

fn emit_digit(d: u8) {
    let buf: [2]u8 = [48u8 + d, 10u8];
    let v: view<[2]u8> = view(buf);
    let p: *const u8 = unsafe { *(address_of(v) as *const *const u8) };
    let repr = StrRepr { ptr: p, len: 2 };
    let s: str = unsafe { *(address_of(repr) as *const str) };
    print(s);
}

struct MiniContext {
    pub count: u8,
}

impl MiniContext {
    fn bump(self: mut_view<Self>) -> u8 {
        self.count = self.count + 1u8;
        self.count
    }

    fn peek(self: view<Self>) -> u8 {
        self.count
    }

    fn bump_twice(self: mut_view<Self>) {
        emit_digit(self.bump());
        emit_digit(self.bump());
    }
}

fn use_mut_view_param(cx: mut_view<MiniContext>) {
    emit_digit(cx.bump());
    emit_digit(cx.bump());
    let v = cx.peek();
    if v == 2u8 {
        cx.bump_twice();
    }
}

fn use_local_mut_view() {
    let mut ctx2 = MiniContext { count: 4u8 };
    let mv = mut_view(ctx2);
    emit_digit(mv.bump());
    emit_digit(mv.bump());
}

// A temporary view receiver is passed by value (not reborrowed): no conflicting second
// mut_view of `*cx` is created.
fn temp_view_receiver(cx: mut_view<MiniContext>) {
    emit_digit(mut_view(*cx).bump());
    emit_digit(view(*cx).peek());
}

fn use_view_param(cx: view<MiniContext>) {
    let a = cx.peek();
    let b = cx.peek();
    if a == b {
        emit_digit(a);
    }
}

pub fn main() -> i32 {
    let mut ctx = MiniContext { count: 0u8 };
    use_mut_view_param(mut_view(ctx));
    use_local_mut_view();
    use_view_param(view(ctx));
    temp_view_receiver(mut_view(ctx));
    0
}
