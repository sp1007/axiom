// test: run
// modes: interp native
// stdout: 9 7 1 1 0 0\n9 7 8 8 0 0\n9 7 16 8 0 0\n9 7 24 8 0 0\n9 7 24 8 1 1\n16 24 1600 811\n397010 697240 897161\ndrops=3\n
// exit: 42
// Regression for T446 (FU-F): impl-level generic monomorphization of field layouts (1/8/16/24-byte F
// without @repr(C)), size_of<F>(), align_of<F>(), needs_drop<F>(), associated functions without self,
// and trait impls on Wrap<F> for both Drop and non-Drop concrete types.

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn needs_drop<T>() -> bool { false }
@intrinsic fn address_of_mut<T>(x: T) -> *mut T { 0 as *mut T }

struct Byte1 { b: u8 }
struct Word8 { x: u64 }
struct Two16 { x: u64, y: u64 }
struct Three24 { x: u64, y: u64, z: u64 }
struct Drop24 { x: u64, y: u64, counter: *mut i32 }

impl Drop for Drop24 {
    fn drop(self: mut_view<Drop24>) {
        unsafe {
            *self.counter = *self.counter + 1;
        }
    }
}

struct Drop16 { a: u64, counter: *mut i32 }
impl Drop for Drop16 {
    fn drop(self: mut_view<Drop16>) {
        unsafe {
            *self.counter = *self.counter + 1;
        }
    }
}

struct Drop8 { counter: *mut i32 }
impl Drop for Drop8 {
    fn drop(self: mut_view<Drop8>) {
        unsafe {
            *self.counter = *self.counter + 1;
        }
    }
}

struct Inner<T> { v: T }

struct Wrap<F> {
    a: u64,
    flag: u32,
    fut: F,
}

impl<F> Wrap<F> {
    fn m(self: mut_view<Wrap<F>>) -> u64 {
        let sz = size_of<F>();
        let al = align_of<F>();
        let nd: u64 = if needs_drop<F>() { 1u64 } else { 0u64 };
        let nd_w: u64 = if needs_drop<Wrap<F>>() { 1u64 } else { 0u64 };
        print_int(self.a as i32); print(" ");
        print_int(self.flag as i32); print(" ");
        print_int(sz as i32); print(" ");
        print_int(al as i32); print(" ");
        print_int(nd as i32); print(" ");
        print_int(nd_w as i32); print("\n");
        self.a + (self.flag as u64) + (sz as u64) + nd
    }

    fn f_size() -> usize {
        size_of<F>()
    }

    fn check_nested(self: view<Wrap<F>>) -> i32 {
        let s = size_of<F>() as i32;
        let nd = if needs_drop<F>() { 1 } else { 0 };
        let nd_self = if needs_drop<Wrap<F>>() { 1 } else { 0 };
        s * 100 + nd * 10 + nd_self
    }
}

trait Inspect {
    fn get_val(self: view<Self>) -> i64;
}

trait Eval {
    fn eval(self: mut_view<Self>) -> i64;
}

impl Inspect for Byte1 { fn get_val(self: view<Byte1>) -> i64 { self.b as i64 } }
impl Inspect for Three24 { fn get_val(self: view<Three24>) -> i64 { (self.x + self.z) as i64 } }
impl Inspect for Drop16 { fn get_val(self: view<Drop16>) -> i64 { self.a as i64 } }

impl<F: Inspect> Eval for Wrap<F> {
    fn eval(self: mut_view<Wrap<F>>) -> i64 {
        let sz = size_of<F>() as i64;
        let nd: i64 = if needs_drop<F>() { 1i64 } else { 0i64 };
        let v = self.fut.get_val();
        v * 100000i64 + (self.a as i64) * 10000i64 + (self.flag as i64) * 1000i64 + sz * 10i64 + nd
    }
}

fn run_scope(dc: *mut i32) {
    let mut w1 = Wrap<Byte1> { a: 9u64, flag: 7u32, fut: Byte1 { b: 3u8 } };
    let mut w8 = Wrap<Word8> { a: 9u64, flag: 7u32, fut: Word8 { x: 2u64 } };
    let mut w16 = Wrap<Two16> { a: 9u64, flag: 7u32, fut: Two16 { x: 5u64, y: 6u64 } };
    let mut w24 = Wrap<Three24> { a: 9u64, flag: 7u32, fut: Three24 { x: 2u64, y: 99u64, z: 4u64 } };
    let mut wd = Wrap<Drop24> { a: 9u64, flag: 7u32, fut: Drop24 { x: 5u64, y: 6u64, counter: dc } };
    let _ = w1.m();
    let _ = w8.m();
    let _ = w16.m();
    let _ = w24.m();
    let _ = wd.m();

    let fs16 = Wrap<Two16>.f_size();
    let fs24 = Wrap<Three24>.f_size();
    let o1 = Wrap<Inner<Two16>> { a: 1u64, flag: 2u32, fut: Inner<Two16> { v: Two16 { x: 1u64, y: 2u64 } } };
    let o2 = Wrap<Inner<Drop8>> { a: 1u64, flag: 2u32, fut: Inner<Drop8> { v: Drop8 { counter: dc } } };
    print_int(fs16 as i32); print(" ");
    print_int(fs24 as i32); print(" ");
    print_int(o1.check_nested()); print(" ");
    print_int(o2.check_nested()); print("\n");

    let mut w_d16 = Wrap<Drop16> { a: 9u64, flag: 7u32, fut: Drop16 { a: 8u64, counter: dc } };
    let e1 = w1.eval();
    let e2 = w24.eval();
    let e3 = w_d16.eval();
    print_int(e1 as i32); print(" ");
    print_int(e2 as i32); print(" ");
    print_int(e3 as i32); print("\n");
}

fn main() -> i32 {
    let mut drops: i32 = 0;
    let dc = unsafe { address_of_mut(drops) };
    run_scope(dc);
    print("drops=");
    print_int(drops);
    print("\n");
    if drops == 3 { 42 } else { 1 }
}
