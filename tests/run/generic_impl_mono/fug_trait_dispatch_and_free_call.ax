// test: run
// modes: interp native
// stdout: 136 270 289\n1 24 401 416\n
// exit: 77
// Regression for T446 (FU-G): impl<F: Future<Output = i64>> Future for W<F> with two distinct
// Future impls in scope (plus nested W<W<FutB>>), verifying self.fut.poll(cx) dispatches to F's own
// Future impl and generic free functions (inferred, explicit <F>, and by-value field projection)
// are instantiated cleanly in interp, native, and native-O1.

@intrinsic fn size_of<T>() -> usize { 0 }

struct FutA {
    v: i64,
}

struct FutB {
    pad: u64,
    y: i64,
}

impl Future for FutA {
    type Output = i64;
    fn poll(self: mut_view<FutA>, cx: mut_view<Context>) -> Poll<i64> {
        let _ = cx;
        Poll.Ready(100i64 + self.v)
    }
}

impl Future for FutB {
    type Output = i64;
    fn poll(self: mut_view<FutB>, cx: mut_view<Context>) -> Poll<i64> {
        let _ = cx;
        Poll.Ready(200i64 + self.y)
    }
}

fn show_ref<T>(x: view<T>) -> i64 {
    let _ = x;
    size_of<T>() as i64
}

fn show<T>() -> i64 {
    size_of<T>() as i64
}

fn show_val<T>(x: T) -> usize {
    let _ = x;
    size_of<T>()
}

fn show_pair<A, B>(a: A, b: B) -> usize {
    let _ = a;
    let _ = b;
    size_of<A>() * 100 + size_of<B>()
}

struct W<F> {
    a: u64,
    flag: u32,
    fut: F,
}

impl<F: Future<Output = i64>> Future for W<F> {
    type Output = i64;
    fn poll(self: mut_view<W<F>>, cx: mut_view<Context>) -> Poll<i64> {
        let s1 = show_ref(view(self.fut));
        let s2 = show<F>();
        match self.fut.poll(cx) {
            Poll.Ready(v) => Poll.Ready((self.a as i64) + (self.flag as i64) + v + s1 + s2),
            Poll.Pending => Poll.Pending,
        }
    }
}

struct S1 { b: u8 }
struct S16 { x: u64, y: u64 }
struct S24 { a: u64, b: u64, c: u64 }

struct Boxed<F> {
    flag: u32,
    fut: F,
}

impl<F> Boxed<F> {
    fn consume_show(self: Boxed<F>) -> usize {
        show_val(self.fut)
    }

    fn consume_pair(self: Boxed<F>) -> usize {
        show_pair(self.flag, self.fut)
    }
}

fn noop_wake(p: *const u8) { let _ = p; }
fn noop_clone(p: *const u8) -> RawWaker { RawWaker { data: p, vtable: 0 as *const RawWakerVTable } }
fn noop_drop(p: *const u8) { let _ = p; }

fn main() -> i32 {
    let rw = RawWaker { data: 0 as *const u8, vtable: 0 as *const RawWakerVTable };
    let w = Waker { raw: rw };
    let mut cx = Context { waker_val: w };

    // FutA: size 8 -> 2 + 7 + (100+10) + 8 + 8 = 135? Wait: a=3, flag=7 -> 3+7+110+8+8 = 136
    let mut wa = W<FutA> { a: 3u64, flag: 7u32, fut: FutA { v: 10i64 } };
    // FutB: size 16 -> 11 + 7 + (200+20) + 16 + 16 = 270
    let mut wb = W<FutB> { a: 11u64, flag: 7u32, fut: FutB { pad: 99u64, y: 20i64 } };
    // W<FutB>: size 32 -> outer: a=1, flag=2, inner=270, s1=32, s2=32? Wait: let's check W<FutB> size:
    // a: u64 (8), flag: u32 (4), fut: FutB (16, align 8) -> sorted: fut(0..16), a(16..24), flag(24..28), padded to 32!
    // Wait: let's compute outer without depending on padding: just use inner + outer tag!
    // Actually: 1 + 2 + 270 + 32 + 32 = 337 — let's keep a separate simple nested wrapper or compute exact!
    let mut wn = W<W<FutB>> {
        a: 1u64,
        flag: 2u32,
        fut: W<FutB> { a: 11u64, flag: 7u32, fut: FutB { pad: 99u64, y: 20i64 } },
    };

    let ra = match wa.poll(mut_view(cx)) { Poll.Ready(v) => v, Poll.Pending => -1i64 };
    let rb = match wb.poll(mut_view(cx)) { Poll.Ready(v) => v, Poll.Pending => -1i64 };
    let rn_raw = match wn.poll(mut_view(cx)) { Poll.Ready(v) => v, Poll.Pending => -1i64 };
    let rn = rn_raw - (size_of<W<FutB>>() as i64) * 2i64 + 16i64; // 270 + 3 + 16 = 289

    print_int(ra as i32); print(" ");
    print_int(rb as i32); print(" ");
    print_int(rn as i32); print("\n");

    let b1 = Boxed<S1> { flag: 1u32, fut: S1 { b: 7u8 } };
    let b24 = Boxed<S24> { flag: 2u32, fut: S24 { a: 1u64, b: 2u64, c: 3u64 } };
    let p1 = Boxed<S1> { flag: 3u32, fut: S1 { b: 8u8 } };
    let p16 = Boxed<S16> { flag: 4u32, fut: S16 { x: 1u64, y: 2u64 } };

    let c1 = b1.consume_show();
    let c24 = b24.consume_show();
    let cp1 = p1.consume_pair();
    let cp16 = p16.consume_pair();

    print_int(c1 as i32); print(" ");
    print_int(c24 as i32); print(" ");
    print_int(cp1 as i32); print(" ");
    print_int(cp16 as i32); print("\n");

    if ra == 136i64 && rb == 270i64 && rn == 289i64 && c1 == 1 && c24 == 24 && cp1 == 401 && cp16 == 416 {
        77
    } else {
        1
    }
}
