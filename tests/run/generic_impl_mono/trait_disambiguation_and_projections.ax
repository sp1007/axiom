// test: run
// modes: interp native
// stdout: 115 25\n106 208\n116 227\n139 257\n
// exit: 63
// Regression for T446 (FU-G): trait method disambiguation when multiple traits define the same
// method name, trait dispatch on projected by-value and mut_view<F> fields, and chained generic
// driver -> generic trait impl -> concrete trait impl calls.

@intrinsic fn size_of<T>() -> usize { 0 }

trait Tr1 {
    fn val(self: view<Self>) -> i32;
}

trait Tr2 {
    fn val(self: view<Self>) -> i32;
}

struct Item {
    n: i32,
}

impl Tr1 for Item {
    fn val(self: view<Item>) -> i32 {
        10 + self.n
    }
}

impl Tr2 for Item {
    fn val(self: view<Item>) -> i32 {
        100 + self.n
    }
}

struct Both<A, B> {
    a: A,
    b: B,
}

impl<A: Tr1, B: Tr2> Both<A, B> {
    fn sum(self: view<Both<A, B>>) -> i32 {
        self.a.val() + self.b.val()
    }
}

struct OnlyTr2<F> {
    f: F,
}

impl<F: Tr2> OnlyTr2<F> {
    fn read_tr2(self: view<OnlyTr2<F>>) -> i32 {
        self.f.val() - 80
    }
}

trait Consume {
    fn consume(self: Self) -> i64;
}

struct C1 { a: i64 }
struct C2 { pad: u64, b: i64 }

impl Consume for C1 {
    fn consume(self: C1) -> i64 { 100i64 + self.a }
}

impl Consume for C2 {
    fn consume(self: C2) -> i64 { 200i64 + self.b }
}

struct ValWrap<F> {
    tag: i64,
    f: F,
}

impl<F: Consume> Consume for ValWrap<F> {
    fn consume(self: ValWrap<F>) -> i64 {
        self.tag + self.f.consume()
    }
}

trait MyFut {
    fn poll(self: mut_view<Self>, arg: i64) -> i64;
}

struct FutA { v: i64 }
struct FutB { pad: u64, y: i64 }

impl MyFut for FutA {
    fn poll(self: mut_view<FutA>, arg: i64) -> i64 { 100i64 + self.v + arg }
}

impl MyFut for FutB {
    fn poll(self: mut_view<FutB>, arg: i64) -> i64 { 200i64 + self.y + arg }
}

struct RefWrap<F> {
    tag: i64,
    fut: mut_view<F>,
}

impl<F: MyFut> MyFut for RefWrap<F> {
    fn poll(self: mut_view<RefWrap<F>>, arg: i64) -> i64 {
        self.tag + self.fut.poll(arg)
    }
}

fn show_sz<T>(x: view<T>) -> i64 {
    let _ = x;
    size_of<T>() as i64
}

struct FullWrap<F> {
    a: u64,
    flag: u32,
    fut: F,
}

impl<F: MyFut> MyFut for FullWrap<F> {
    fn poll(self: mut_view<FullWrap<F>>, arg: i64) -> i64 {
        let p = self.fut.poll(arg);
        let s = show_sz(view(self.fut));
        (self.a as i64) + (self.flag as i64) + p + s
    }
}

fn drive<X: MyFut>(f: mut_view<X>, arg: i64) -> i64 {
    f.poll(arg)
}

fn main() -> i32 {
    let both = Both<Item, Item> { a: Item { n: 2 }, b: Item { n: 3 } };
    let o2 = OnlyTr2<Item> { f: Item { n: 5 } };
    let s1 = both.sum();       // (10+2) + (100+3) = 115
    let s2 = o2.read_tr2();    // (100+5) - 80 = 25
    print_int(s1); print(" ");
    print_int(s2); print("\n");

    let vw1 = ValWrap<C1> { tag: 1i64, f: C1 { a: 5i64 } };
    let vw2 = ValWrap<C2> { tag: 2i64, f: C2 { pad: 99u64, b: 6i64 } };
    let c1 = vw1.consume();    // 106
    let c2 = vw2.consume();    // 208
    print_int(c1 as i32); print(" ");
    print_int(c2 as i32); print("\n");

    let mut fa = FutA { v: 10i64 };
    let mut fb = FutB { pad: 99u64, y: 20i64 };
    let mut rwa = RefWrap<FutA> { tag: 1i64, fut: mut_view(fa) };
    let mut rwb = RefWrap<FutB> { tag: 2i64, fut: mut_view(fb) };
    let p1 = rwa.poll(5i64);   // 116
    let p2 = rwb.poll(5i64);   // 227
    print_int(p1 as i32); print(" ");
    print_int(p2 as i32); print("\n");

    let mut fwa = FullWrap<FutA> { a: 9u64, flag: 7u32, fut: FutA { v: 10i64 } };
    let mut fwb = FullWrap<FutB> { a: 9u64, flag: 7u32, fut: FutB { pad: 99u64, y: 20i64 } };
    let d1 = drive(mut_view(fwa), 5i64); // 9 + 7 + 115 + 8 = 139
    let d2 = drive(mut_view(fwb), 5i64); // 9 + 7 + 225 + 16 = 257
    print_int(d1 as i32); print(" ");
    print_int(d2 as i32); print("\n");

    if s1 == 115 && s2 == 25 && c1 == 106i64 && c2 == 208i64 && p1 == 116i64 && p2 == 227i64 && d1 == 139i64 && d2 == 257i64 {
        63
    } else {
        1
    }
}
