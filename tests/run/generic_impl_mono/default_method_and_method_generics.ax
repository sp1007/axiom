// test: run
// modes: interp native
// stdout: 27 109 54 218\n40 25 24 108\n
// exit: 55
// Regression for T446: trait default methods inherited by generic impl<F: Score> Score for W<F>
// (including Self substitution inside default methods) and method-level generics <U> inside
// impl<F> Wrap<F> without parameter index collision.

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn needs_drop<T>() -> bool { false }

trait Score {
    fn base(self: view<Self>) -> i32;
    fn doubled(self: view<Self>) -> i32 {
        self.base() * 2
    }
    fn self_size(self: view<Self>) -> usize {
        let _ = self;
        size_of<Self>()
    }
}

struct A {
    x: i32,
}

struct B {
    pad: u64,
    y: i32,
}

impl Score for A {
    fn base(self: view<A>) -> i32 {
        10 + self.x
    }
}

impl Score for B {
    fn base(self: view<B>) -> i32 {
        50 + self.y
    }
}

struct W<F> {
    f: F,
}

impl<F: Score> Score for W<F> {
    fn base(self: view<W<F>>) -> i32 {
        self.f.doubled() + 1
    }
}

struct S1 { b: u8 }
struct S16 { x: u64, y: u64 }
struct S24 { x: u64, y: u64, z: u64 }

struct Wrap<F> {
    a: u64,
    f: F,
}

impl<F> Wrap<F> {
    fn combine<U>(self: view<Wrap<F>>, u: view<U>) -> usize {
        let _ = u;
        let _ = self;
        size_of<F>() + size_of<U>()
    }

    fn combine_with_score<U: Score>(self: view<Wrap<F>>, u: view<U>) -> i32 where F: Score {
        self.f.base() + u.doubled()
    }
}

fn main() -> i32 {
    let wa = W<A> { f: A { x: 3 } };
    let wb = W<B> { f: B { pad: 0u64, y: 4 } };
    let r1 = wa.base();      // (10+3)*2 + 1 = 27
    let r2 = wb.base();      // (50+4)*2 + 1 = 109
    let r3 = wa.doubled();   // 54
    let r4 = wb.doubled();   // 218
    print_int(r1); print(" ");
    print_int(r2); print(" ");
    print_int(r3); print(" ");
    print_int(r4); print("\n");

    let w16 = Wrap<S16> { a: 1u64, f: S16 { x: 2u64, y: 3u64 } };
    let w1 = Wrap<S1> { a: 2u64, f: S1 { b: 9u8 } };
    let s24 = S24 { x: 1u64, y: 2u64, z: 3u64 };
    let c1 = w16.combine(view(s24));         // 16 + 24 = 40
    let c2 = w1.combine(view(s24));          // 1 + 24 = 25
    let sz_b = wb.self_size() + wa.self_size() + 4; // 16 + 4 + 4 = 24
    let w_a = Wrap<A> { a: 5u64, f: A { x: 3 } };
    let b_val = B { pad: 1u64, y: 4 };
    let sc = w_a.combine_with_score(view(b_val)) - 13; // 13 + 108 - 13 = 108

    print_int(c1 as i32); print(" ");
    print_int(c2 as i32); print(" ");
    print_int(sz_b as i32); print(" ");
    print_int(sc); print("\n");

    if r1 == 27 && r2 == 109 && r3 == 54 && r4 == 218 && c1 == 40 && c2 == 25 && sz_b == 24 && sc == 108 {
        55
    } else {
        1
    }
}
