// test: run


struct Data {
    val: i32
}

fn main() -> i32 {
    // 1. Copy capture
    let a = 10;
    let read_a = || a + 5;
    if read_a() != 15 { return 1; }
    if a != 10 { return 2; }

    // 2. Mut view capture
    let mut counter = 0;
    let mut inc = || { counter = counter + 1; };
    inc();
    inc();
    inc();
    if counter != 3 { return 3; }

    // 3. View capture (read-only borrow of non-copy struct)
    let d = Data { val: 42 };
    let get_val = || d.val;
    if get_val() != 42 { return 4; }
    if d.val != 42 { return 5; }

    return 0;
}
