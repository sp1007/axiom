// test: run
// native-after: T059

fn call_fn<F: Fn>(f: F, x: i32) -> i32 {
    f(x)
}

fn call_fn_mut<F: FnMut>(mut f: F, x: i32) -> i32 {
    f(x)
}

fn call_fn_once<F: FnOnce>(f: F, x: i32) -> i32 {
    f(x)
}

fn call_callable<F: Callable>(f: F, x: i32) -> i32 {
    f(x)
}

fn add_ten(x: i32) -> i32 {
    x + 10
}

fn main() -> i32 {
    // 1. Regular function item
    if call_fn(add_ten, 5) != 15 { return 1; }
    if call_fn_mut(add_ten, 5) != 15 { return 2; }
    if call_fn_once(add_ten, 5) != 15 { return 3; }
    if call_callable(add_ten, 5) != 15 { return 4; }

    // 2. Pure closure (copy capture -> satisfies Fn, FnMut, FnOnce, Callable)
    let k = 20;
    let add_k = |x: i32| x + k;
    if call_fn(add_k, 5) != 25 { return 5; }
    if call_fn_mut(add_k, 5) != 25 { return 6; }
    if call_fn_once(add_k, 5) != 25 { return 7; }
    if call_callable(add_k, 5) != 25 { return 8; }

    return 0;
}
