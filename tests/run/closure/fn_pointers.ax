// test: run


fn double_it(x: i32) -> i32 {
    x * 2
}

fn main() -> i32 {
    // 1. Function pointer to fn item
    let mut fp: fn(i32) -> i32 = double_it;
    if fp(21) != 42 { return 1; }

    // 2. Coercion of non-capturing closure to fn pointer
    fp = |x: i32| x + 100;
    if fp(5) != 105 { return 2; }

    // 3. Directly initialized fn pointer from non-capturing closure
    let fp2: fn(i32) -> i32 = |x: i32| x - 1;
    if fp2(10) != 9 { return 3; }

    return 0;
}
