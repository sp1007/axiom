// test: run


struct S {
    val: i32
}

fn main() -> i32 {
    let a = 10;
    let mut b = 20;
    let s = S { val: 30 };

    let mut c = |x: i32| -> i32 {
        b = b + x;
        a + b + s.val
    };

    let r1 = c(5);
    if r1 != 65 { return 1; }
    if b != 25 { return 2; }

    let r2 = c(5);
    if r2 != 70 { return 3; }
    if b != 30 { return 4; }

    return 0;
}
