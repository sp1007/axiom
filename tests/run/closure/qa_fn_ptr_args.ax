// test: run

fn add_val(x: i32) -> i32 {
    x + 5
}

fn mul_val(x: i32) -> i32 {
    x * 3
}

fn apply_op(f: fn(i32) -> i32, val: i32) -> i32 {
    f(val)
}

fn select_op(flag: bool) -> fn(i32) -> i32 {
    if flag {
        add_val
    } else {
        mul_val
    }
}

fn main() -> i32 {
    let f1 = select_op(true);
    let f2 = select_op(false);
    if apply_op(f1, 10) != 15 { return 1; }
    if apply_op(f2, 10) != 30 { return 2; }

    let f3: fn(i32) -> i32 = |n: i32| n - 4;
    if apply_op(f3, 10) != 6 { return 3; }

    return 0;
}
