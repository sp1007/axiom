// test: run
// native-after: T059

fn main() -> i32 {
    let f1 = || 42;
    if f1() != 42 { return 1; }

    let f2 = |x: i32| x + 1;
    if f2(10) != 11 { return 2; }

    let f3 = |x: i32, y: i32| x + y;
    if f3(20, 22) != 42 { return 3; }

    let f4 = |x: i32| -> i32 {
        let y = x * 2;
        y + 5
    };
    if f4(10) != 25 { return 4; }

    let direct = (|a: i32, b: i32| a * b)(6, 7);
    if direct != 42 { return 5; }

    return 0;
}
