// test: run
// native-after: T059

fn apply_mut<F: FnMut>(mut f: F, count: i32) {
    let mut i = 0;
    while count > i {
        f();
        i = i + 1;
    }
}

fn compute<T, F: Callable>(x: T, f: F) -> i32 {
    f(x)
}

fn main() -> i32 {
    let mut total = 0;
    let mut accum = || {
        total = total + 10;
    };
    apply_mut(accum, 4);
    if total != 40 { return 1; }

    let res = compute(21, |n: i32| n * 2);
    if res != 42 { return 2; }

    return 0;
}
