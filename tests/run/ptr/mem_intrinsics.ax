// test: run
// native-after: T061b

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic unsafe fn ptr_write_bytes<T>(dst: *mut T, val: u8, count: usize) {}

fn main() -> i32 {
    let mut arr1: [4]i32 = [10, 20, 30, 40];
    let mut arr2: [4]i32 = [0, 0, 0, 0];
    unsafe {
        let p1: *mut i32 = address_of_mut(arr1[0]);
        let p2: *mut i32 = address_of_mut(arr2[0]);

        // Non-overlapping copy from arr1 to arr2
        ptr_copy_nonoverlapping<i32>(p1 as *const i32, p2, 4);
        if arr2[0] != 10 || arr2[1] != 20 || arr2[2] != 30 || arr2[3] != 40 {
            return 1;
        }

        // Write bytes to zero out arr2
        let p2_u8: *mut u8 = p2 as *mut u8;
        ptr_write_bytes<u8>(p2_u8, 0, 16);
        if arr2[0] != 0 || arr2[1] != 0 || arr2[2] != 0 || arr2[3] != 0 {
            return 2;
        }

        // Overlapping copy within arr1: shift right by 1 element
        // arr1 = [10, 20, 30, 40] -> copy arr1[0..3] to arr1[1..4]
        let p1_dst: *mut i32 = p1 + 1;
        ptr_copy<i32>(p1 as *const i32, p1_dst, 3);
        if arr1[0] != 10 || arr1[1] != 10 || arr1[2] != 20 || arr1[3] != 30 {
            return 3;
        }
    }
    return 0;
}
