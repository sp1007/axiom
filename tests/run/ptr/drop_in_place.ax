// test: run
// native-after: T061b

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn drop_in_place<T>(p: *mut T) {}

struct TrackDrop {
    val: i32,
}

impl Drop for TrackDrop {
    fn drop(self: mut_view<TrackDrop>) {
        self.val = self.val + 100;
    }
}

fn main() -> i32 {
    let mut item = TrackDrop { val: 42 };
    unsafe {
        let p: *mut TrackDrop = address_of_mut(item);
        drop_in_place<TrackDrop>(p);
    }
    if item.val != 142 {
        return 1;
    }
    return 0;
}
