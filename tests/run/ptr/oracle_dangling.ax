// test: run
// exit: 125
// modes: interp
// reason: oracle-only check

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

fn get_dangling() -> *const i32 {
    let x: i32 = 42;
    unsafe {
        address_of(x)
    }
}

fn main() -> i32 {
    unsafe {
        let p: *const i32 = get_dangling();
        let val: i32 = *p;
        return val;
    }
}
