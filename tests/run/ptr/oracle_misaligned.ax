// test: run
// exit: 125
// modes: interp
// reason: oracle-only check

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

fn main() -> i32 {
    let mut buf: [16]u8 = [0; 16];
    unsafe {
        let base: *mut u8 = address_of_mut(buf[0]);
        let misaligned_addr: usize = (base as usize) + 1;
        let p: *const i32 = misaligned_addr as *const i32;
        let val: i32 = *p;
        return val;
    }
}
