// test: run
// exit: 125
// modes: interp
// reason: oracle-only check

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

fn main() -> i32 {
    let arr: [2]i32 = [1, 2];
    unsafe {
        let p: *const i32 = address_of(arr[0]);
        let oob_p: *const i32 = p + 2;
        let val: i32 = *oob_p;
        return val;
    }
}
