// test: run
// native-after: T061b

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

fn main() -> i32 {
    let mut arr: [5]i32 = [10, 20, 30, 40, 50];
    unsafe {
        let mut p: *const i32 = address_of(arr[0]);
        let end: *const i32 = p + 5;
        let mut sum: i32 = 0;
        while p < end {
            sum = sum + *p;
            p = p + 1;
        }
        if sum != 150 {
            return 1;
        }
    }
    return 0;
}
