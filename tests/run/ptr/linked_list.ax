// test: run
// exit: 60

@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }
@intrinsic fn is_null<T>(p: *const T) -> bool { false }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct Node {
    val: i32,
    next: *mut Node,
}

fn main() -> i32 {
    let mut n3 = Node { val: 30, next: null_mut<Node>() };
    let mut n2 = Node { val: 20, next: null_mut<Node>() };
    let mut n1 = Node { val: 10, next: null_mut<Node>() };
    unsafe {
        let p3: *mut Node = address_of_mut(n3);
        let p2: *mut Node = address_of_mut(n2);
        let p1: *mut Node = address_of_mut(n1);

        (*p2).next = p3;
        (*p1).next = p2;

        let mut cur: *mut Node = p1;
        let mut sum: i32 = 0;
        while !is_null(cur) {
            sum = sum + (*cur).val;
            cur = (*cur).next;
        }
        if sum != 60 {
            return 1;
        }
        return sum;
    }
}
