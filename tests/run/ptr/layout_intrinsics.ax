// test: run
// exit: 44

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn needs_drop<T>() -> bool { false }

struct Simple {
    a: i32,
    b: i64,
}

struct HasDrop {
    x: i32,
}

impl Drop for HasDrop {
    fn drop(self: mut_view<HasDrop>) {
    }
}

fn main() -> i32 {
    if size_of<i32>() != 4 { return 1; }
    if align_of<i32>() != 4 { return 2; }
    if size_of<i64>() != 8 { return 3; }
    if align_of<i64>() != 8 { return 4; }
    if size_of<[4]i32>() != 16 { return 5; }
    if align_of<[4]i32>() != 4 { return 6; }
    if size_of<Simple>() != 16 { return 7; }
    if align_of<Simple>() != 8 { return 8; }
    if needs_drop<i32>() { return 9; }
    if needs_drop<Simple>() { return 10; }
    if !needs_drop<HasDrop>() { return 11; }
    return (size_of<i32>() + size_of<i64>() + size_of<[4]i32>() + size_of<Simple>()) as i32;
}
