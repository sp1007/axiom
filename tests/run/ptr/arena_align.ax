// test: run
// native-after: T061b

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

fn align_up(addr: usize, align: usize) -> usize {
    let rem: usize = addr % align;
    if rem == 0 {
        return addr;
    }
    return addr + (align - rem);
}

fn main() -> i32 {
    let mut buffer: [64]u8 = [0; 64];
    unsafe {
        let base: *mut u8 = address_of_mut(buffer[0]);
        let base_addr: usize = base as usize;
        let aligned_addr: usize = align_up(base_addr, 16);
        let aligned_ptr: *mut i32 = aligned_addr as *mut i32;
        *aligned_ptr = 12345;
        if *aligned_ptr != 12345 {
            return 1;
        }
    }
    return 0;
}
