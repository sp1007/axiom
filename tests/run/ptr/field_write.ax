// test: run
// native-after: T061b

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct Point {
    x: i32,
    y: i32,
}

fn main() -> i32 {
    let mut pt = Point { x: 1, y: 2 };
    unsafe {
        let p: *mut Point = address_of_mut(pt);
        (*p).x = 42;
        p.y = 99;
    }
    if pt.x != 42 || pt.y != 99 {
        return 1;
    }
    return 0;
}
