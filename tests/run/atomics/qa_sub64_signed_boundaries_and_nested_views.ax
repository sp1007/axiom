// test: run
// modes: interp native
// stdout: OK qa_sub64_signed_boundaries_and_nested_views\n

@intrinsic fn assert(cond: bool) {}

struct DeepL3 {
    pub active: AtomicBool,
    pub step: AtomicI8,
}

struct DeepL2 {
    pub guard_before: u16,
    pub l3: DeepL3,
    pub sub_cnt: AtomicI16,
    pub guard_after: u16,
}

struct DeepL1 {
    pub head_guard: u32,
    pub l2: DeepL2,
    pub main_cnt: AtomicI32,
    pub tail_guard: u32,
}

struct InterleavedBoundaries {
    pub b0: AtomicBool,
    pub pad0: u8,
    pub s8: AtomicI8,
    pub pad1: u8,
    pub u8_v: AtomicU8,
    pub pad2: u16,
    pub s16: AtomicI16,
    pub pad3: u16,
    pub u16_v: AtomicU16,
    pub pad4: u32,
    pub s32: AtomicI32,
    pub pad5: u32,
    pub u32_v: AtomicU32,
    pub pad6: u64,
    pub s64: AtomicI64,
    pub pad7: u64,
}

fn mutate_i8_view(v: view<AtomicI8>, delta: i8) -> i8 {
    v.fetch_add(delta, Ordering.SeqCst)
}

fn mutate_i16_view(v: view<AtomicI16>, delta: i16) -> i16 {
    v.fetch_add(delta, Ordering.SeqCst)
}

fn mutate_i32_view(v: view<AtomicI32>, delta: i32) -> i32 {
    v.fetch_add(delta, Ordering.SeqCst)
}

fn mutate_bool_view(v: view<AtomicBool>, new_state: bool) -> bool {
    v.swap(new_state, Ordering.AcqRel)
}

fn test_signed_min_boundaries_and_wraparound() {
    // 8-bit signed boundary: min = -128i8, max = 127i8
    let a8 = AtomicI8.new(-128i8);
    assert(a8.load(Ordering.SeqCst) == -128i8);

    // CAS at min edge
    let cas8_ok = a8.compare_exchange(-128i8, 127i8, Ordering.SeqCst, Ordering.Acquire);
    assert(cas8_ok.ok && cas8_ok.val == -128i8);
    assert(a8.load(Ordering.SeqCst) == 127i8);

    // Wraparound addition: 127i8 + 1i8 wraps to -128i8 in two's complement
    let prev8_add = a8.fetch_add(1i8, Ordering.SeqCst);
    assert(prev8_add == 127i8);
    assert(a8.load(Ordering.SeqCst) == -128i8);

    // Wraparound subtraction: -128i8 - 1i8 wraps to 127i8
    let prev8_sub = a8.fetch_sub(1i8, Ordering.SeqCst);
    assert(prev8_sub == -128i8);
    assert(a8.load(Ordering.SeqCst) == 127i8);

    // Failed CAS check
    let cas8_fail = a8.compare_exchange(-128i8, 0i8, Ordering.SeqCst, Ordering.Relaxed);
    assert(!cas8_fail.ok && cas8_fail.val == 127i8);
    assert(a8.load(Ordering.SeqCst) == 127i8);

    // Weak CAS loop on signed boundary
    let mut cas8_w = a8.compare_exchange_weak(127i8, -128i8, Ordering.Release, Ordering.Relaxed);
    let mut retry8: u32 = 0u32;
    while !cas8_w.ok && retry8 < 20u32 {
        cas8_w = a8.compare_exchange_weak(127i8, -128i8, Ordering.Release, Ordering.Relaxed);
        retry8 = retry8 + 1u32;
    }
    assert(cas8_w.ok);
    assert(a8.load(Ordering.SeqCst) == -128i8);

    // 16-bit signed boundary: min = -32768i16, max = 32767i16
    let a16 = AtomicI16.new(-32768i16);
    assert(a16.load(Ordering.SeqCst) == -32768i16);

    let cas16_ok = a16.compare_exchange(-32768i16, 32767i16, Ordering.SeqCst, Ordering.Acquire);
    assert(cas16_ok.ok && cas16_ok.val == -32768i16);
    assert(a16.load(Ordering.SeqCst) == 32767i16);

    let prev16_add = a16.fetch_add(1i16, Ordering.SeqCst);
    assert(prev16_add == 32767i16);
    assert(a16.load(Ordering.SeqCst) == -32768i16);

    let prev16_sub = a16.fetch_sub(1i16, Ordering.SeqCst);
    assert(prev16_sub == -32768i16);
    assert(a16.load(Ordering.SeqCst) == 32767i16);

    let cas16_fail = a16.compare_exchange(-32768i16, 0i16, Ordering.SeqCst, Ordering.Relaxed);
    assert(!cas16_fail.ok && cas16_fail.val == 32767i16);
    assert(a16.load(Ordering.SeqCst) == 32767i16);

    let mut cas16_w = a16.compare_exchange_weak(32767i16, -32768i16, Ordering.Release, Ordering.Relaxed);
    let mut retry16: u32 = 0u32;
    while !cas16_w.ok && retry16 < 20u32 {
        cas16_w = a16.compare_exchange_weak(32767i16, -32768i16, Ordering.Release, Ordering.Relaxed);
        retry16 = retry16 + 1u32;
    }
    assert(cas16_w.ok);
    assert(a16.load(Ordering.SeqCst) == -32768i16);

    // 32-bit signed boundary: min = -2147483648i32, max = 2147483647i32
    let a32 = AtomicI32.new(-2147483648i32);
    assert(a32.load(Ordering.SeqCst) == -2147483648i32);

    let cas32_ok = a32.compare_exchange(-2147483648i32, 2147483647i32, Ordering.SeqCst, Ordering.Acquire);
    assert(cas32_ok.ok && cas32_ok.val == -2147483648i32);
    assert(a32.load(Ordering.SeqCst) == 2147483647i32);

    let prev32_add = a32.fetch_add(1i32, Ordering.SeqCst);
    assert(prev32_add == 2147483647i32);
    assert(a32.load(Ordering.SeqCst) == -2147483648i32);

    let prev32_sub = a32.fetch_sub(1i32, Ordering.SeqCst);
    assert(prev32_sub == -2147483648i32);
    assert(a32.load(Ordering.SeqCst) == 2147483647i32);

    let cas32_fail = a32.compare_exchange(-2147483648i32, 0i32, Ordering.SeqCst, Ordering.Relaxed);
    assert(!cas32_fail.ok && cas32_fail.val == 2147483647i32);
    assert(a32.load(Ordering.SeqCst) == 2147483647i32);

    let mut cas32_w = a32.compare_exchange_weak(2147483647i32, -2147483648i32, Ordering.Release, Ordering.Relaxed);
    let mut retry32: u32 = 0u32;
    while !cas32_w.ok && retry32 < 20u32 {
        cas32_w = a32.compare_exchange_weak(2147483647i32, -2147483648i32, Ordering.Release, Ordering.Relaxed);
        retry32 = retry32 + 1u32;
    }
    assert(cas32_w.ok);
    assert(a32.load(Ordering.SeqCst) == -2147483648i32);
}

fn test_interleaved_sub64_memory_integrity() {
    let s = InterleavedBoundaries {
        b0: AtomicBool.new(false),
        pad0: 0xA5u8,
        s8: AtomicI8.new(-42i8),
        pad1: 0x5Au8,
        u8_v: AtomicU8.new(200u8),
        pad2: 0x1234u16,
        s16: AtomicI16.new(-12345i16),
        pad3: 0x4321u16,
        u16_v: AtomicU16.new(54321u16),
        pad4: 0xDEADBEEFu32,
        s32: AtomicI32.new(-1000000i32),
        pad5: 0xCAFEBABEu32,
        u32_v: AtomicU32.new(3000000000u32),
        pad6: 0x0123456789ABCDEFu64,
        s64: AtomicI64.new(-9876543210123i64),
        pad7: 0xFEDCBA9876543210u64,
    };

    // Store & RMW on 1-byte atomics
    s.b0.store(true, Ordering.Release);
    assert(s.pad0 == 0xA5u8);
    assert(s.pad1 == 0x5Au8);

    let old_s8 = s.s8.swap(-1i8, Ordering.SeqCst);
    assert(old_s8 == -42i8);
    assert(s.s8.load(Ordering.SeqCst) == -1i8);
    assert(s.pad0 == 0xA5u8);
    assert(s.pad1 == 0x5Au8);

    let old_u8 = s.u8_v.fetch_add(50u8, Ordering.SeqCst);
    assert(old_u8 == 200u8);
    assert(s.u8_v.load(Ordering.SeqCst) == 250u8);
    assert(s.pad1 == 0x5Au8);
    assert(s.pad2 == 0x1234u16);

    // Store & RMW on 2-byte atomics
    let cas_s16 = s.s16.compare_exchange(-12345i16, -20000i16, Ordering.SeqCst, Ordering.Acquire);
    assert(cas_s16.ok && cas_s16.val == -12345i16);
    assert(s.s16.load(Ordering.SeqCst) == -20000i16);
    assert(s.pad2 == 0x1234u16);
    assert(s.pad3 == 0x4321u16);

    let old_u16 = s.u16_v.fetch_sub(4321u16, Ordering.SeqCst);
    assert(old_u16 == 54321u16);
    assert(s.u16_v.load(Ordering.SeqCst) == 50000u16);
    assert(s.pad3 == 0x4321u16);
    assert(s.pad4 == 0xDEADBEEFu32);

    // Store & RMW on 4-byte atomics
    let old_s32 = s.s32.fetch_add(500000i32, Ordering.SeqCst);
    assert(old_s32 == -1000000i32);
    assert(s.s32.load(Ordering.SeqCst) == -500000i32);
    assert(s.pad4 == 0xDEADBEEFu32);
    assert(s.pad5 == 0xCAFEBABEu32);

    let cas_u32 = s.u32_v.compare_exchange(3000000000u32, 4000000000u32, Ordering.SeqCst, Ordering.Acquire);
    assert(cas_u32.ok && cas_u32.val == 3000000000u32);
    assert(s.u32_v.load(Ordering.SeqCst) == 4000000000u32);
    assert(s.pad5 == 0xCAFEBABEu32);
    assert(s.pad6 == 0x0123456789ABCDEFu64);

    // Store & RMW on 8-byte atomic
    let old_s64 = s.s64.fetch_add(1000i64, Ordering.SeqCst);
    assert(old_s64 == -9876543210123i64);
    assert(s.s64.load(Ordering.SeqCst) == -9876543209123i64);
    assert(s.pad6 == 0x0123456789ABCDEFu64);
    assert(s.pad7 == 0xFEDCBA9876543210u64);
}

fn test_deep_nested_views() {
    let root = DeepL1 {
        head_guard: 0x11112222u32,
        l2: DeepL2 {
            guard_before: 0x3344u16,
            l3: DeepL3 {
                active: AtomicBool.new(false),
                step: AtomicI8.new(-10i8),
            },
            sub_cnt: AtomicI16.new(-500i16),
            guard_after: 0x5566u16,
        },
        main_cnt: AtomicI32.new(-80000i32),
        tail_guard: 0x77778888u32,
    };

    // Test passing view of nested atomics to helper functions
    let prev_b = mutate_bool_view(view(root.l2.l3.active), true);
    assert(!prev_b);
    assert(root.l2.l3.active.load(Ordering.SeqCst));

    let prev_s8 = mutate_i8_view(view(root.l2.l3.step), 5i8);
    assert(prev_s8 == -10i8);
    assert(root.l2.l3.step.load(Ordering.SeqCst) == -5i8);

    let prev_s16 = mutate_i16_view(view(root.l2.sub_cnt), 200i16);
    assert(prev_s16 == -500i16);
    assert(root.l2.sub_cnt.load(Ordering.SeqCst) == -300i16);

    let prev_s32 = mutate_i32_view(view(root.main_cnt), 30000i32);
    assert(prev_s32 == -80000i32);
    assert(root.main_cnt.load(Ordering.SeqCst) == -50000i32);

    // Verify all non-atomic structural guards remain completely untouched
    assert(root.head_guard == 0x11112222u32);
    assert(root.l2.guard_before == 0x3344u16);
    assert(root.l2.guard_after == 0x5566u16);
    assert(root.tail_guard == 0x77778888u32);
}

fn main() {
    test_signed_min_boundaries_and_wraparound();
    test_interleaved_sub64_memory_integrity();
    test_deep_nested_views();
    print("OK qa_sub64_signed_boundaries_and_nested_views\n");
}
