// test: run
// modes: interp native
// stdout: OK sub_64_bit_widths\n

@intrinsic fn assert(cond: bool) {}

struct Interleaved {
    pub a: AtomicU8,
    pub pad1: u8,
    pub b: AtomicU16,
    pub pad2: u16,
    pub c: AtomicU32,
    pub pad3: u32,
}

fn test_narrow_atomic_bool() {
    let b = AtomicBool.new(false);
    assert(!b.load(Ordering.Relaxed));
    assert(!b.load(Ordering.Acquire));
    assert(!b.load(Ordering.SeqCst));

    b.store(true, Ordering.Release);
    assert(b.load(Ordering.Acquire));

    let prev = b.swap(false, Ordering.AcqRel);
    assert(prev);
    assert(!b.load(Ordering.Relaxed));

    let p_or = b.fetch_or(true, Ordering.SeqCst);
    assert(!p_or);
    assert(b.load(Ordering.Relaxed));

    let p_and = b.fetch_and(false, Ordering.SeqCst);
    assert(p_and);
    assert(!b.load(Ordering.Relaxed));

    let p_xor = b.fetch_xor(true, Ordering.SeqCst);
    assert(!p_xor);
    assert(b.load(Ordering.Relaxed));

    let cas_ok = b.compare_exchange(true, false, Ordering.SeqCst, Ordering.Acquire);
    assert(cas_ok.ok && cas_ok.val);
    assert(!b.load(Ordering.SeqCst));

    let cas_fail = b.compare_exchange(true, true, Ordering.SeqCst, Ordering.Relaxed);
    assert(!cas_fail.ok && !cas_fail.val);
    assert(!b.load(Ordering.SeqCst));

    let mut cas_w = b.compare_exchange_weak(false, true, Ordering.Release, Ordering.Relaxed);
    let mut retries: u32 = 0u32;
    while !cas_w.ok && retries < 10u32 {
        cas_w = b.compare_exchange_weak(false, true, Ordering.Release, Ordering.Relaxed);
        retries = retries + 1u32;
    }
    assert(cas_w.ok);
    assert(b.into_inner());
}

fn test_narrow_atomic_u8_u16() {
    let u8_val = AtomicU8.new(100u8);
    let old_u8 = u8_val.fetch_add(25u8, Ordering.SeqCst);
    assert(old_u8 == 100u8);
    assert(u8_val.load(Ordering.Acquire) == 125u8);

    let sub_u8 = u8_val.fetch_sub(5u8, Ordering.AcqRel);
    assert(sub_u8 == 125u8);
    assert(u8_val.load(Ordering.SeqCst) == 120u8);

    let u16_val = AtomicU16.new(1000u16);
    let old_u16 = u16_val.fetch_add(500u16, Ordering.SeqCst);
    assert(old_u16 == 1000u16);
    assert(u16_val.load(Ordering.Acquire) == 1500u16);

    let sub_u16 = u16_val.fetch_sub(200u16, Ordering.AcqRel);
    assert(sub_u16 == 1500u16);
    assert(u16_val.load(Ordering.SeqCst) == 1300u16);
}

fn test_negative_signed_cas() {
    // 8-bit negative signed CAS
    let a8 = AtomicI8.new(-1i8);
    let r8_ok = a8.compare_exchange(-1i8, -2i8, Ordering.SeqCst, Ordering.Acquire);
    assert(r8_ok.ok && r8_ok.val == -1i8);
    assert(a8.load(Ordering.SeqCst) == -2i8);

    let r8_fail = a8.compare_exchange(0i8, -5i8, Ordering.SeqCst, Ordering.Relaxed);
    assert(!r8_fail.ok && r8_fail.val == -2i8);
    assert(a8.load(Ordering.SeqCst) == -2i8);

    let mut r8_w = a8.compare_exchange_weak(-2i8, -10i8, Ordering.Release, Ordering.Relaxed);
    let mut retries8: u32 = 0u32;
    while !r8_w.ok && retries8 < 10u32 {
        r8_w = a8.compare_exchange_weak(-2i8, -10i8, Ordering.Release, Ordering.Relaxed);
        retries8 = retries8 + 1u32;
    }
    assert(r8_w.ok);
    assert(a8.load(Ordering.SeqCst) == -10i8);

    // 16-bit negative signed CAS
    let a16 = AtomicI16.new(-100i16);
    let r16_ok = a16.compare_exchange(-100i16, -200i16, Ordering.SeqCst, Ordering.Acquire);
    assert(r16_ok.ok && r16_ok.val == -100i16);
    assert(a16.load(Ordering.SeqCst) == -200i16);

    let r16_fail = a16.compare_exchange(100i16, -300i16, Ordering.SeqCst, Ordering.Relaxed);
    assert(!r16_fail.ok && r16_fail.val == -200i16);
    assert(a16.load(Ordering.SeqCst) == -200i16);

    let mut r16_w = a16.compare_exchange_weak(-200i16, -500i16, Ordering.Release, Ordering.Relaxed);
    let mut retries16: u32 = 0u32;
    while !r16_w.ok && retries16 < 10u32 {
        r16_w = a16.compare_exchange_weak(-200i16, -500i16, Ordering.Release, Ordering.Relaxed);
        retries16 = retries16 + 1u32;
    }
    assert(r16_w.ok);
    assert(a16.load(Ordering.SeqCst) == -500i16);

    // 32-bit negative signed CAS
    let a32 = AtomicI32.new(-50000i32);
    let r32_ok = a32.compare_exchange(-50000i32, -60000i32, Ordering.SeqCst, Ordering.Acquire);
    assert(r32_ok.ok && r32_ok.val == -50000i32);
    assert(a32.load(Ordering.SeqCst) == -60000i32);

    let r32_fail = a32.compare_exchange(50000i32, -10000i32, Ordering.SeqCst, Ordering.Relaxed);
    assert(!r32_fail.ok && r32_fail.val == -60000i32);
    assert(a32.load(Ordering.SeqCst) == -60000i32);

    let mut r32_w = a32.compare_exchange_weak(-60000i32, -80000i32, Ordering.Release, Ordering.Relaxed);
    let mut retries32: u32 = 0u32;
    while !r32_w.ok && retries32 < 10u32 {
        r32_w = a32.compare_exchange_weak(-60000i32, -80000i32, Ordering.Release, Ordering.Relaxed);
        retries32 = retries32 + 1u32;
    }
    assert(r32_w.ok);
    assert(a32.load(Ordering.SeqCst) == -80000i32);
}

fn test_contiguous_arrays_no_clobber() {
    let u8_arr: [8]AtomicU8 = [
        AtomicU8.new(0x11u8),
        AtomicU8.new(0x22u8),
        AtomicU8.new(0x33u8),
        AtomicU8.new(0x44u8),
        AtomicU8.new(0x55u8),
        AtomicU8.new(0x66u8),
        AtomicU8.new(0x77u8),
        AtomicU8.new(0x88u8),
    ];

    let old0 = u8_arr[0usize].fetch_add(0x10u8, Ordering.SeqCst);
    assert(old0 == 0x11u8);
    assert(u8_arr[0usize].load(Ordering.SeqCst) == 0x21u8);
    assert(u8_arr[1usize].load(Ordering.SeqCst) == 0x22u8);
    assert(u8_arr[2usize].load(Ordering.SeqCst) == 0x33u8);
    assert(u8_arr[3usize].load(Ordering.SeqCst) == 0x44u8);
    assert(u8_arr[4usize].load(Ordering.SeqCst) == 0x55u8);
    assert(u8_arr[5usize].load(Ordering.SeqCst) == 0x66u8);
    assert(u8_arr[6usize].load(Ordering.SeqCst) == 0x77u8);
    assert(u8_arr[7usize].load(Ordering.SeqCst) == 0x88u8);

    let cas0 = u8_arr[0usize].compare_exchange(0x21u8, 0x99u8, Ordering.SeqCst, Ordering.Acquire);
    assert(cas0.ok && cas0.val == 0x21u8);
    assert(u8_arr[0usize].load(Ordering.SeqCst) == 0x99u8);
    assert(u8_arr[1usize].load(Ordering.SeqCst) == 0x22u8);

    let swp0 = u8_arr[0usize].swap(0xAAu8, Ordering.AcqRel);
    assert(swp0 == 0x99u8);
    assert(u8_arr[0usize].load(Ordering.SeqCst) == 0xAAu8);
    assert(u8_arr[1usize].load(Ordering.SeqCst) == 0x22u8);

    let u16_arr: [4]AtomicU16 = [
        AtomicU16.new(0x1000u16),
        AtomicU16.new(0x2000u16),
        AtomicU16.new(0x3000u16),
        AtomicU16.new(0x4000u16),
    ];

    let old16 = u16_arr[0usize].fetch_add(0x0500u16, Ordering.SeqCst);
    assert(old16 == 0x1000u16);
    assert(u16_arr[0usize].load(Ordering.SeqCst) == 0x1500u16);
    assert(u16_arr[1usize].load(Ordering.SeqCst) == 0x2000u16);
    assert(u16_arr[2usize].load(Ordering.SeqCst) == 0x3000u16);
    assert(u16_arr[3usize].load(Ordering.SeqCst) == 0x4000u16);

    let cas16 = u16_arr[0usize].compare_exchange(0x1500u16, 0x9999u16, Ordering.SeqCst, Ordering.Acquire);
    assert(cas16.ok && cas16.val == 0x1500u16);
    assert(u16_arr[0usize].load(Ordering.SeqCst) == 0x9999u16);
    assert(u16_arr[1usize].load(Ordering.SeqCst) == 0x2000u16);

    let u32_arr: [4]AtomicU32 = [
        AtomicU32.new(0x10000000u32),
        AtomicU32.new(0x20000000u32),
        AtomicU32.new(0x30000000u32),
        AtomicU32.new(0x40000000u32),
    ];

    let old32 = u32_arr[0usize].fetch_add(0x05000000u32, Ordering.SeqCst);
    assert(old32 == 0x10000000u32);
    assert(u32_arr[0usize].load(Ordering.SeqCst) == 0x15000000u32);
    assert(u32_arr[1usize].load(Ordering.SeqCst) == 0x20000000u32);
    assert(u32_arr[2usize].load(Ordering.SeqCst) == 0x30000000u32);
    assert(u32_arr[3usize].load(Ordering.SeqCst) == 0x40000000u32);
}

fn test_packed_struct_no_clobber() {
    let s = Interleaved {
        a: AtomicU8.new(10u8),
        pad1: 0xEEu8,
        b: AtomicU16.new(2000u16),
        pad2: 0xDDDDu16,
        c: AtomicU32.new(300000u32),
        pad3: 0xCCCCCCCCu32,
    };

    s.a.fetch_add(5u8, Ordering.SeqCst);
    assert(s.a.load(Ordering.SeqCst) == 15u8);
    assert(s.pad1 == 0xEEu8);

    let c8 = s.a.compare_exchange(15u8, 50u8, Ordering.SeqCst, Ordering.Acquire);
    assert(c8.ok && c8.val == 15u8);
    assert(s.a.load(Ordering.SeqCst) == 50u8);
    assert(s.pad1 == 0xEEu8);

    s.b.fetch_add(500u16, Ordering.SeqCst);
    assert(s.b.load(Ordering.SeqCst) == 2500u16);
    assert(s.pad2 == 0xDDDDu16);

    let c16 = s.b.compare_exchange(2500u16, 9000u16, Ordering.SeqCst, Ordering.Acquire);
    assert(c16.ok && c16.val == 2500u16);
    assert(s.b.load(Ordering.SeqCst) == 9000u16);
    assert(s.pad2 == 0xDDDDu16);

    s.c.fetch_add(10000u32, Ordering.SeqCst);
    assert(s.c.load(Ordering.SeqCst) == 310000u32);
    assert(s.pad3 == 0xCCCCCCCCu32);

    let c32 = s.c.compare_exchange(310000u32, 999999u32, Ordering.SeqCst, Ordering.Acquire);
    assert(c32.ok && c32.val == 310000u32);
    assert(s.c.load(Ordering.SeqCst) == 999999u32);
    assert(s.pad3 == 0xCCCCCCCCu32);
}

fn main() {
    test_narrow_atomic_bool();
    test_narrow_atomic_u8_u16();
    test_negative_signed_cas();
    test_contiguous_arrays_no_clobber();
    test_packed_struct_no_clobber();
    print("OK sub_64_bit_widths\n");
}
