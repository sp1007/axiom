// test: run
// modes: interp native
// stdout: OK struct_embedded_atomics\n

@intrinsic fn assert(cond: bool) {}

struct InnerCounters {
    pub active: AtomicBool,
    pub hits: AtomicU32,
}

struct NodeState {
    pub b: AtomicBool,
    pub u8_val: AtomicU8,
    pub u16_val: AtomicU16,
    pub u32_val: AtomicU32,
    pub generic_u64: Atomic<u64>,
    pub nested: InnerCounters,
    pub checksum: u64,
}

fn bump_counter(cnt: view<AtomicU32>, delta: u32) -> u32 {
    cnt.fetch_add(delta, Ordering.SeqCst)
}

fn toggle_flag(flg: view<AtomicBool>, new_val: bool) -> bool {
    flg.swap(new_val, Ordering.SeqCst)
}

fn test_struct_fields_and_methods() {
    let node = NodeState {
        b: AtomicBool.new(false),
        u8_val: AtomicU8.new(42u8),
        u16_val: AtomicU16.new(1234u16),
        u32_val: AtomicU32.new(50000u32),
        generic_u64: Atomic.new(999999999u64),
        nested: InnerCounters {
            active: AtomicBool.new(true),
            hits: AtomicU32.new(10u32),
        },
        checksum: 0xAABBCCDDEEFF0011u64,
    };

    // Direct methods on embedded atomics
    node.b.store(true, Ordering.Release);
    assert(node.b.load(Ordering.Acquire));

    let old_u8 = node.u8_val.fetch_add(8u8, Ordering.SeqCst);
    assert(old_u8 == 42u8);
    assert(node.u8_val.load(Ordering.SeqCst) == 50u8);

    let cas_16 = node.u16_val.compare_exchange(1234u16, 4321u16, Ordering.SeqCst, Ordering.Acquire);
    assert(cas_16.ok && cas_16.val == 1234u16);
    assert(node.u16_val.load(Ordering.SeqCst) == 4321u16);

    let old_u32 = node.u32_val.swap(70000u32, Ordering.AcqRel);
    assert(old_u32 == 50000u32);
    assert(node.u32_val.load(Ordering.SeqCst) == 70000u32);

    let old_g64 = node.generic_u64.fetch_add(1u64, Ordering.SeqCst);
    assert(old_g64 == 999999999u64);
    assert(node.generic_u64.load(Ordering.SeqCst) == 1000000000u64);

    // Methods on nested struct embedded atomics
    assert(node.nested.active.load(Ordering.Relaxed));
    let old_hits = node.nested.hits.fetch_add(5u32, Ordering.SeqCst);
    assert(old_hits == 10u32);
    assert(node.nested.hits.load(Ordering.SeqCst) == 15u32);

    // Verify non-atomic field is untouched
    assert(node.checksum == 0xAABBCCDDEEFF0011u64);

    // Calling helper functions with view<Atomic<T>>
    let prev_b = toggle_flag(view(node.b), false);
    assert(prev_b);
    assert(!node.b.load(Ordering.SeqCst));

    let prev_cnt = bump_counter(view(node.u32_val), 1000u32);
    assert(prev_cnt == 70000u32);
    assert(node.u32_val.load(Ordering.SeqCst) == 71000u32);

    let prev_nested_hits = bump_counter(view(node.nested.hits), 20u32);
    assert(prev_nested_hits == 15u32);
    assert(node.nested.hits.load(Ordering.SeqCst) == 35u32);
}

fn main() {
    test_struct_fields_and_methods();
    print("OK struct_embedded_atomics\n");
}
