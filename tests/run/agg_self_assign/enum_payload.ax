// test: run
// modes: interp native
// stdout: V 2 1\nW 4 3 4 3\nT 8 7\n
// covers: REQ-EXP-007, REQ-EXP-102, REQ-MIR-006
// T428j: an enum constructor assigned to a place it reads (directly, through `match` operands,
// or nested inside a struct literal) evaluates every payload operand before the destination
// changes.

@derive(Copy)
enum E {
    V(i64, i64),
    N,
}

@derive(Copy)
struct W {
    e: E,
    a: i64,
    b: i64,
}

@derive(Copy)
struct Pair {
    a: i64,
    b: i64,
}

@derive(Copy)
enum P {
    T(Pair),
    Z,
}

fn show_e(tag: str, e: E) {
    print(tag);
    match e {
        E.V(a, b) => {
            print(" ");
            print_int(a);
            print(" ");
            print_int(b);
        }
        E.N => {
            print(" N");
        }
    }
}

fn main() -> i32 {
    // Tuple-like variant whose payload operands are `match` expressions over the destination.
    let mut e = E.V(1i64, 2i64);
    e = E.V(match e { E.V(_, b) => b, _ => 0i64 }, match e { E.V(a, _) => a, _ => 0i64 });
    show_e("V", e);
    print("\n");

    // Enum payload nested in a struct literal that also swaps the struct's own fields.
    let mut w = W { e: E.N, a: 3i64, b: 4i64 };
    w = W { e: E.V(w.b, w.a), a: w.b, b: w.a };
    show_e("W", w.e);
    print(" ");
    print_int(w.a);
    print(" ");
    print_int(w.b);
    print("\n");

    // Variant carrying a struct built from the destination's payload.
    let mut t = P.T(Pair { a: 7i64, b: 8i64 });
    let cur = match t { P.T(pr) => pr, P.Z => Pair { a: 0i64, b: 0i64 } };
    t = P.T(Pair { a: match t { P.T(pr) => pr.b, P.Z => 0i64 }, b: cur.a });
    match t {
        P.T(pr) => {
            print("T ");
            print_int(pr.a);
            print(" ");
            print_int(pr.b);
            print("\n");
        }
        P.Z => {
            print("Z\n");
        }
    }
    0i32
}
