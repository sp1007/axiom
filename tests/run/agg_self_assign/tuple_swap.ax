// test: run
// modes: interp native
// stdout: 2 1\n3 1 2\n6 5 9\n
// covers: REQ-EXP-007, REQ-EXP-102, REQ-MIR-006
// T428j: a tuple literal assigned to a place it reads evaluates every element before the
// destination changes.

@derive(Copy)
struct Box2 {
    t: (i64, i64),
    k: i64,
}

fn main() -> i32 {
    let mut t: (i64, i64) = (1i64, 2i64);
    t = (t.1, t.0);
    print_int(t.0);
    print(" ");
    print_int(t.1);
    print("\n");

    let mut u: (i64, i64, i64) = (1i64, 2i64, 3i64);
    u = (u.2, u.0, u.1);
    print_int(u.0);
    print(" ");
    print_int(u.1);
    print(" ");
    print_int(u.2);
    print("\n");

    // Field destination holding a tuple.
    let mut bx = Box2 { t: (5i64, 6i64), k: 9i64 };
    bx.t = (bx.t.1, bx.t.0);
    print_int(bx.t.0);
    print(" ");
    print_int(bx.t.1);
    print(" ");
    print_int(bx.k);
    print("\n");
    0i32
}
