// test: run
// modes: interp native
// stdout: 3 1 2\n9 7 8\n30 10 20\n6 4 5\n3 1 2\n2 2 2\n1 2 3\n
// covers: REQ-EXP-007, REQ-EXP-102, REQ-MIR-006
// T428j: an array literal assigned to a place it reads evaluates every element before the
// destination changes (SPEC-03 left-to-right evaluation, the assignment takes effect last).

fn show(a: [3]i64) {
    print_int(a[0]);
    print(" ");
    print_int(a[1]);
    print(" ");
    print_int(a[2]);
    print("\n");
}

struct Holder {
    tag: i64,
    vals: [3]i64,
}

fn rotate_param(mut a: [3]i64) -> [3]i64 {
    a = [a[2], a[0], a[1]];
    a
}

fn main() -> i32 {
    // Whole-local destination.
    let mut arr: [3]i64 = [1i64, 2i64, 3i64];
    arr = [arr[2], arr[0], arr[1]];
    show(arr);

    // Index destination inside an array of arrays.
    let mut grid: [2][3]i64 = [[1i64, 2i64, 3i64], [7i64, 8i64, 9i64]];
    grid[1] = [grid[1][2], grid[1][0], grid[1][1]];
    show(grid[1]);

    // Field destination; the elements are computed from the destination.
    let mut h = Holder { tag: 0i64, vals: [10i64, 20i64, 30i64] };
    h.vals = [h.vals[2], h.vals[0] * 1i64, h.vals[1] + 0i64];
    show(h.vals);

    // Index read through a runtime index local.
    let mut b: [3]i64 = [4i64, 5i64, 6i64];
    let i: usize = 2;
    b = [b[i], b[i - 2], b[i - 1]];
    show(b);

    // Parameter destination.
    show(rotate_param([1i64, 2i64, 3i64]));

    // Repeat form reading the destination.
    let mut r: [3]i64 = [1i64, 2i64, 3i64];
    r = [r[1]; 3];
    show(r);

    // No overlap: the source stays intact.
    let src: [3]i64 = [1i64, 2i64, 3i64];
    let mut dst: [3]i64 = [0i64; 3];
    dst = [src[0], src[1], src[2]];
    show(dst);
    if h.tag != 0i64 {
        return 1i32;
    }
    0i32
}
