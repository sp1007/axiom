// test: run
// modes: interp native
// stdout: 2 1\n4 3\n3 1 2\n7 5\nbump\n100 9\n1\n
// covers: REQ-EXP-007, REQ-EXP-102, REQ-MIR-006
// T428j QA: self-reading aggregate stores through a closure capture, a nested literal, a loop, moved
// non-Copy fields, and an operand call whose side effect runs exactly once.

@derive(Copy)
struct Pair {
    a: i64,
    b: i64,
}

@derive(Copy)
struct S2 {
    x: i64,
}

@derive(Copy)
struct S {
    a: S2,
    b: S2,
}

struct Mv {
    l: Pair,
    r: Pair,
}

fn show(p: Pair) {
    print_int(p.a);
    print(" ");
    print_int(p.b);
    print("\n");
}

fn bump(c: mut_view<i64>) -> i64 {
    *c = *c + 1i64;
    print("bump\n");
    *c * 100i64
}

fn main() -> i32 {
    // Closure capture (by mut_view) assigning the captured aggregate from itself.
    let mut c = Pair { a: 1i64, b: 2i64 };
    let mut sw = || { c = Pair { a: c.b, b: c.a }; };
    sw();
    show(c);

    // Nested aggregate.
    let mut s = S { a: S2 { x: 3i64 }, b: S2 { x: 4i64 } };
    s = S { a: s.b, b: S2 { x: s.a.x } };
    print_int(s.a.x);
    print(" ");
    print_int(s.b.x);
    print("\n");

    // Loop: rotate 4 times through 3 positions.
    let mut arr: [3]i64 = [1i64, 2i64, 3i64];
    let mut i = 0i64;
    while i < 4i64 {
        arr = [arr[2], arr[0], arr[1]];
        i = i + 1i64;
    }
    print_int(arr[0]);
    print(" ");
    print_int(arr[1]);
    print(" ");
    print_int(arr[2]);
    print("\n");

    // Moves of non-Copy fields.
    let mut m = Mv { l: Pair { a: 5i64, b: 6i64 }, r: Pair { a: 7i64, b: 8i64 } };
    m = Mv { l: m.r, r: m.l };
    print_int(m.l.a);
    print(" ");
    print_int(m.r.a);
    print("\n");

    // Side effect once, left to right.
    let mut cnt = 0i64;
    let mut p = Pair { a: 9i64, b: 10i64 };
    p = Pair { a: bump(mut_view(cnt)), b: p.a };
    show(p);
    print_int(cnt);
    print("\n");
    0i32
}
