// test: golden
// emit: mir
// T428j: `swap` reads its destination, so the operands are copied to temporaries before the
// aggregate store; `fresh` (distinct source) and `disjoint` (other fields of the same local) are
// still built in place with no extra copy.
struct Pair { a: i64, b: i64 }
struct Two { l: Pair, r: Pair }
fn swap(mut p: Pair) -> i64 { p = Pair { a: p.b, b: p.a }; p.a }
fn fresh(q: Pair) -> i64 { let mut p = Pair { a: 0i64, b: 0i64 }; p = Pair { a: q.b, b: q.a }; p.a }
fn disjoint(mut t: Two) -> i64 { t.l = Pair { a: t.r.b, b: t.r.a }; t.l.a }
fn main() {}
