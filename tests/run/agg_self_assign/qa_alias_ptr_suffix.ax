// test: run
// modes: interp native
// stdout: 2 1\n4 3\n6 5\n7 8 8 7\n
// covers: REQ-EXP-007, REQ-EXP-102, REQ-MIR-006
// T428j QA round 1: places that split at a field after a shared deref, with the pointer on the
// destination side, on the source side, or on both; and two pointer fields that address different
// objects (no alias, values must still be right).

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

@derive(Copy)
struct Pair {
    a: i64,
    b: i64,
}

struct Node {
    v: Pair,
    q: *mut Pair,
}

@derive(Copy)
struct Handles {
    p: *mut Pair,
    q: *mut Pair,
}

fn show(p: Pair) {
    print_int(p.a);
    print(" ");
    print_int(p.b);
    print("\n");
}

fn main() -> i32 {
    // Destination goes through the pointer field, source reads the sibling field it points to.
    let mut n1 = Node { v: Pair { a: 1i64, b: 2i64 }, q: 0 as *mut Pair };
    n1.q = unsafe { address_of_mut(n1.v) };
    let pn1: *mut Node = unsafe { address_of_mut(n1) };
    unsafe {
        *(*pn1).q = Pair { a: (*pn1).v.b, b: (*pn1).v.a };
    }
    show(n1.v);

    // Destination is a field of the local, source goes through the sibling pointer to it.
    let mut n2 = Node { v: Pair { a: 3i64, b: 4i64 }, q: 0 as *mut Pair };
    n2.q = unsafe { address_of_mut(n2.v) };
    unsafe {
        n2.v = Pair { a: (*n2.q).b, b: (*n2.q).a };
    }
    show(n2.v);

    // Both sides through the same pointer field.
    let mut n3 = Node { v: Pair { a: 5i64, b: 6i64 }, q: 0 as *mut Pair };
    n3.q = unsafe { address_of_mut(n3.v) };
    unsafe {
        *n3.q = Pair { a: (*n3.q).b, b: (*n3.q).a };
    }
    show(n3.v);

    // Two pointer fields to different objects: no alias.
    let mut x = Pair { a: 7i64, b: 8i64 };
    let mut y = Pair { a: 0i64, b: 0i64 };
    let h = Handles { p: unsafe { address_of_mut(y) }, q: unsafe { address_of_mut(x) } };
    unsafe {
        *h.p = Pair { a: (*h.q).b, b: (*h.q).a };
    }
    print_int(x.a);
    print(" ");
    print_int(x.b);
    print(" ");
    print_int(y.a);
    print(" ");
    print_int(y.b);
    print("\n");
    0i32
}
