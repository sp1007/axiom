// test: run
// modes: interp native
// stdout: swapped 2 1\nmixed 5 4\nloop 1 2\nend\ndrop:3\ndrop:1\ndrop:2\n
// covers: REQ-EXP-007, REQ-EXP-102, REQ-MIR-006
// T428j QA: self-reading aggregate stores of Drop types: the moved guards are swapped, none is
// dropped early or twice; a Copy field inside a Drop-carrying struct is swapped in place.

struct Guard {
    id: i64,
}

impl Drop for Guard {
    fn drop(self: mut_view<Guard>) {
        print("drop:");
        print_int(self.id);
        print("\n");
    }
}

struct Two {
    l: Guard,
    r: Guard,
}

@derive(Copy)
struct Pair {
    a: i64,
    b: i64,
}

struct Mixed {
    g: Guard,
    p: Pair,
}

fn main() -> i32 {
    let mut t = Two { l: Guard { id: 1i64 }, r: Guard { id: 2i64 } };
    t = Two { l: t.r, r: t.l };
    print("swapped ");
    print_int(t.l.id);
    print(" ");
    print_int(t.r.id);
    print("\n");

    let mut m = Mixed { g: Guard { id: 3i64 }, p: Pair { a: 4i64, b: 5i64 } };
    m.p = Pair { a: m.p.b, b: m.p.a };
    print("mixed ");
    print_int(m.p.a);
    print(" ");
    print_int(m.p.b);
    print("\n");

    // Swap three more times in a loop: odd total, so l=1, r=2 at the end.
    let mut i = 0i64;
    while i < 3i64 {
        t = Two { l: t.r, r: t.l };
        i = i + 1i64;
    }
    print("loop ");
    print_int(t.l.id);
    print(" ");
    print_int(t.r.id);
    print("\n");
    print("end\n");
    0i32
}
