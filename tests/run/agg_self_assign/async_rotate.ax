// test: run
// modes: interp native
// stdout: 3 1 2\n8 7\n20 10\n7 8 9\n
// covers: REQ-EXP-007, REQ-EXP-102, REQ-MIR-006
// T428j: inside an `async fn` the aggregate assignment reads the destination's values from
// before the store, for locals that live across an `.await` (kept in the poll frame).

use std.future.block_on.block_on;

@derive(Copy)
struct Pair {
    a: i64,
    b: i64,
}

async fn tick(x: i64) -> i64 {
    x
}

async fn work() -> i64 {
    let mut arr: [3]i64 = [1i64, 2i64, 3i64];
    let mut pair = Pair { a: 7i64, b: 8i64 };
    let mut t: (i64, i64) = (10i64, 20i64);
    let k = tick(1i64).await;
    arr = [arr[2], arr[0], arr[1]];
    pair = Pair { a: pair.b, b: pair.a };
    let k2 = tick(k).await;
    t = (t.1 * k2, t.0);
    let k3 = tick(k2).await;
    print_int(arr[0]);
    print(" ");
    print_int(arr[1]);
    print(" ");
    print_int(arr[2]);
    print("\n");
    print_int(pair.a);
    print(" ");
    print_int(pair.b);
    print("\n");
    print_int(t.0);
    print(" ");
    print_int(t.1);
    print("\n");
    // An operand that suspends: the other operands still read the values from before the store.
    let mut q: (i64, i64, i64) = (9i64, 0i64, 0i64);
    q = (pair.b, tick(pair.a).await, q.0);
    pair = Pair { a: tick(pair.b).await, b: pair.a };
    print_int(pair.a);
    print(" ");
    print_int(pair.b);
    print(" ");
    print_int(q.2);
    print("\n");
    k3
}

fn main() -> i32 {
    let r = block_on(work());
    if r != 1i64 {
        return 1i32;
    }
    0i32
}
