// test: run
// modes: interp native
// stdout: 2 1\n4 3\n6 5\n8 7\n3 1 2\n10 9\n
// covers: REQ-EXP-007, REQ-EXP-102, REQ-MIR-006
// T428j: an aggregate stored through a pointer or a mut_view evaluates every operand before the
// store, including operands that reach the destination under another name (a raw pointer to a
// local, or the local behind a pointer).

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

@derive(Copy)
struct Pair {
    a: i64,
    b: i64,
}

@derive(Copy)
struct Node {
    v: Pair,
    q: *mut Pair,
}

fn show(p: Pair) {
    print_int(p.a);
    print(" ");
    print_int(p.b);
    print("\n");
}

fn swap_view(v: mut_view<Pair>) {
    *v = Pair { a: (*v).b, b: (*v).a };
}

fn main() -> i32 {
    // Store through a raw pointer, reading through the same pointer.
    let mut s1 = Pair { a: 1i64, b: 2i64 };
    let p1: *mut Pair = unsafe { address_of_mut(s1) };
    unsafe {
        *p1 = Pair { a: (*p1).b, b: (*p1).a };
    }
    show(s1);

    // Store through a mut_view.
    let mut s2 = Pair { a: 3i64, b: 4i64 };
    swap_view(mut_view(s2));
    show(s2);

    // Store to the local, reading through a raw pointer to it.
    let mut s3 = Pair { a: 5i64, b: 6i64 };
    let p3: *const Pair = unsafe { address_of(s3) };
    unsafe {
        s3 = Pair { a: (*p3).b, b: (*p3).a };
    }
    show(s3);

    // Store through a raw pointer, reading the local it points to.
    let mut s4 = Pair { a: 7i64, b: 8i64 };
    let p4: *mut Pair = unsafe { address_of_mut(s4) };
    unsafe {
        *p4 = Pair { a: s4.b, b: s4.a };
    }
    show(s4);

    // Array through a raw pointer.
    let mut arr: [3]i64 = [1i64, 2i64, 3i64];
    let pa: *mut [3]i64 = unsafe { address_of_mut(arr) };
    unsafe {
        *pa = [(*pa)[2], (*pa)[0], (*pa)[1]];
    }
    print_int(arr[0]);
    print(" ");
    print_int(arr[1]);
    print(" ");
    print_int(arr[2]);
    print("\n");

    // Same pointer, then different fields, one of which holds a pointer back to the other:
    // `(*pn).v` and `(*(*pn).q)` are the same object.
    let mut node = Node { v: Pair { a: 9i64, b: 10i64 }, q: 0 as *mut Pair };
    let pn: *mut Node = unsafe { address_of_mut(node) };
    unsafe {
        (*pn).q = address_of_mut((*pn).v);
        (*pn).v = Pair { a: (*(*pn).q).b, b: (*(*pn).q).a };
    }
    show(node.v);
    0i32
}
