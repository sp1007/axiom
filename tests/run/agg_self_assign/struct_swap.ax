// test: run
// modes: interp native
// stdout: 8 7\n2 1 5\n6 5 4 3\n12 11\n40 30 20 10\n
// covers: REQ-EXP-007, REQ-EXP-102, REQ-MIR-006
// T428j: a struct literal assigned to a place it reads evaluates every field initialiser before
// the destination changes: whole local, field destination, nested aggregates, out-of-order
// field initialisers.

@derive(Copy)
struct Pair {
    a: i64,
    b: i64,
}

@derive(Copy)
struct Outer {
    inner: Pair,
    x: i64,
    y: i64,
}

@derive(Copy)
struct Quad {
    p: i64,
    q: i64,
    r: i64,
    s: i64,
}

fn main() -> i32 {
    // Whole-local destination.
    let mut pair = Pair { a: 7i64, b: 8i64 };
    pair = Pair { a: pair.b, b: pair.a };
    print_int(pair.a);
    print(" ");
    print_int(pair.b);
    print("\n");

    // Field destination: only the inner struct is rewritten.
    let mut o = Outer { inner: Pair { a: 1i64, b: 2i64 }, x: 5i64, y: 6i64 };
    o.inner = Pair { a: o.inner.b, b: o.inner.a };
    print_int(o.inner.a);
    print(" ");
    print_int(o.inner.b);
    print(" ");
    print_int(o.x);
    print("\n");

    // Nested aggregate: the inner literal and the outer fields both read the destination.
    let mut n = Outer { inner: Pair { a: 3i64, b: 4i64 }, x: 5i64, y: 6i64 };
    n = Outer { inner: Pair { a: n.y, b: n.x }, x: n.inner.b, y: n.inner.a };
    print_int(n.inner.a);
    print(" ");
    print_int(n.inner.b);
    print(" ");
    print_int(n.x);
    print(" ");
    print_int(n.y);
    print("\n");

    // Field initialisers written out of declaration order.
    let mut w = Pair { a: 11i64, b: 12i64 };
    w = Pair { b: w.a, a: w.b };
    print_int(w.a);
    print(" ");
    print_int(w.b);
    print("\n");

    // Reverse of four fields.
    let mut z = Quad { p: 10i64, q: 20i64, r: 30i64, s: 40i64 };
    z = Quad { p: z.s, q: z.r, r: z.q, s: z.p };
    print_int(z.p);
    print(" ");
    print_int(z.q);
    print(" ");
    print_int(z.r);
    print(" ");
    print_int(z.s);
    print("\n");
    0i32
}
