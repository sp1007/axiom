// test: run
// modes: interp native
// stdout: 2 1\n4 3\n
// covers: REQ-EXP-007, REQ-EXP-102, REQ-MIR-006
// T428j QA: the destination and an operand share a root local but diverge at a field that holds
// a pointer; both pointers address the same object, so the operands must be spilled before the store.

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

@derive(Copy)
struct Pair {
    a: i64,
    b: i64,
}

@derive(Copy)
struct Handles {
    p: *mut Pair,
    q: *mut Pair,
}

struct Holder {
    v: Pair,
    p: *mut Pair,
}

fn show(p: Pair) {
    print_int(p.a);
    print(" ");
    print_int(p.b);
    print("\n");
}

fn main() -> i32 {
    // Two pointer fields of one local that point to the same object.
    let mut s = Pair { a: 1i64, b: 2i64 };
    let h = Handles { p: unsafe { address_of_mut(s) }, q: unsafe { address_of_mut(s) } };
    unsafe {
        *h.p = Pair { a: (*h.q).b, b: (*h.q).a };
    }
    show(s);

    // Field destination; operand reads the same field through a pointer stored in a sibling field.
    let mut o = Holder { v: Pair { a: 3i64, b: 4i64 }, p: 0 as *mut Pair };
    o.p = unsafe { address_of_mut(o.v) };
    unsafe {
        o.v = Pair { a: (*o.p).b, b: (*o.p).a };
    }
    show(o.v);
    0i32
}
