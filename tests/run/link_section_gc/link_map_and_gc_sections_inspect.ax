// test: run
// modes: interp native
// exit: 0
// stdout: 4096\n208\n512\n204\n8192\n56\n512\n0\n12288\n24\n512\n0\n16384\n256\n0\n0\n20480\n24\n512\n0\n24576\n32\n512\n0\n6\n28672\n3072\n1\n

const SEC_TEXT: i32 = 0;
const SEC_RDATA: i32 = 1;
const SEC_DATA: i32 = 2;
const SEC_BSS: i32 = 3;
const SEC_PDATA: i32 = 4;
const SEC_XDATA: i32 = 5;

const SCN_EXEC: i32 = 1;
const SCN_READ: i32 = 2;
const SCN_WRITE: i32 = 4;

fn align_up(v: i32, a: i32) -> i32 {
    if a <= 1 {
        return v;
    }
    let rem: i32 = v % a;
    if rem == 0 {
        v
    } else {
        v + (a - rem)
    }
}

@derive(Copy)
struct LiveSubSec {
    kind: i32,
    align: i32,
    size_bytes: i32,
    chars: i32,
}

fn print_line_i32(v: i32) {
    print_int(v);
    print("\n");
}

fn main() -> i32 {
    let rx: i32 = SCN_EXEC | SCN_READ;
    let ro: i32 = SCN_READ;
    let rw: i32 = SCN_READ | SCN_WRITE;

    let subs: [8]LiveSubSec = [
        LiveSubSec { kind: SEC_TEXT,  align: 16, size_bytes: 64,  chars: rx },
        LiveSubSec { kind: SEC_TEXT,  align: 16, size_bytes: 96,  chars: rx },
        LiveSubSec { kind: SEC_RDATA, align: 8,  size_bytes: 56,  chars: ro },
        LiveSubSec { kind: SEC_DATA,  align: 8,  size_bytes: 24,  chars: rw },
        LiveSubSec { kind: SEC_BSS,   align: 16, size_bytes: 256, chars: rw },
        LiveSubSec { kind: SEC_PDATA, align: 4,  size_bytes: 24,  chars: ro },
        LiveSubSec { kind: SEC_XDATA, align: 4,  size_bytes: 32,  chars: ro },
        LiveSubSec { kind: SEC_TEXT,  align: 16, size_bytes: 48,  chars: rx }
    ];

    let mut wx_ok: i32 = 1;
    let mut idx: usize = 0;
    while idx < 8 {
        let ch: i32 = subs[idx].chars;
        if (ch & SCN_EXEC) != 0 && (ch & SCN_WRITE) != 0 {
            wx_ok = 0;
        }
        idx = idx + 1;
    }

    let mut cur_rva: i32 = 4096;
    let mut cur_foff: i32 = 512;
    let mut out_sec_cnt: i32 = 0;

    let mut k: i32 = 0;
    while k <= SEC_XDATA {
        let mut cnt: i32 = 0;
        let mut off: i32 = 0;
        let mut s: usize = 0;
        while s < 8 {
            if subs[s].kind == k {
                off = align_up(off, subs[s].align);
                off = off + subs[s].size_bytes;
                cnt = cnt + 1;
            }
            s = s + 1;
        }
        if cnt > 0 {
            let rsize: i32 = if k == SEC_BSS { 0 } else { align_up(off, 512) };
            let pad_b: i32 = if k == SEC_TEXT { 204 } else { 0 };
            print_line_i32(cur_rva);
            print_line_i32(off);
            print_line_i32(rsize);
            print_line_i32(pad_b);
            cur_rva = cur_rva + align_up(off, 4096);
            cur_foff = cur_foff + rsize;
            out_sec_cnt = out_sec_cnt + 1;
        }
        k = k + 1;
    }

    print_line_i32(out_sec_cnt);
    print_line_i32(cur_rva);
    print_line_i32(cur_foff);
    print_line_i32(wx_ok);
    if out_sec_cnt != 6 || wx_ok != 1 {
        return 1;
    }
    0
}
