// test: run
// modes: interp native
// exit: 0
// stdout: 4096\n4\n1\n0\n6\n8\n

const IMAGE_SCN_LNK_COMDAT: i32 = 4096;

const COMDAT_SELECT_ANY: i32 = 2;
const COMDAT_SELECT_ASSOCIATIVE: i32 = 5;
const COMDAT_SELECT_LARGEST: i32 = 6;

const BIND_LOCAL: i32 = 0;
const BIND_GLOBAL: i32 = 1;
const BIND_WEAK: i32 = 2;
const BIND_COMDAT: i32 = 3;

@derive(Copy)
struct ComdatCandidate {
    obj_id: i32,
    sec_id: i32,
    key_id: i32,
    binding: i32,
    selection: i32,
    assoc_leader: i32,
    size_bytes: i32,
    folded: bool,
    winner_sec: i32,
}

fn cand_wins(cand: ComdatCandidate, cur: ComdatCandidate) -> bool {
    let cb: i32 = cand.binding;
    let lb: i32 = cur.binding;
    if cb == BIND_GLOBAL && lb == BIND_WEAK {
        return true;
    }
    if cb == BIND_WEAK && lb == BIND_GLOBAL {
        return false;
    }
    let cs: i32 = cand.selection;
    let ls: i32 = cur.selection;
    if cs == COMDAT_SELECT_LARGEST || ls == COMDAT_SELECT_LARGEST {
        let csz: i32 = cand.size_bytes;
        let lsz: i32 = cur.size_bytes;
        if csz != lsz {
            return csz > lsz;
        }
    }
    let co: i32 = cand.obj_id;
    let lo: i32 = cur.obj_id;
    if co != lo {
        return co < lo;
    }
    let csec: i32 = cand.sec_id;
    let lsec: i32 = cur.sec_id;
    csec < lsec
}

fn print_line_i32(v: i32) {
    print_int(v);
    print("\n");
}

fn main() -> i32 {
    let mut cands: [9]ComdatCandidate = [
        ComdatCandidate { obj_id: 0, sec_id: 0, key_id: 10, binding: BIND_COMDAT, selection: COMDAT_SELECT_ANY, assoc_leader: 99, size_bytes: 80, folded: false, winner_sec: 0 },
        ComdatCandidate { obj_id: 0, sec_id: 1, key_id: 0,  binding: BIND_LOCAL,  selection: COMDAT_SELECT_ASSOCIATIVE, assoc_leader: 0, size_bytes: 12, folded: false, winner_sec: 1 },
        ComdatCandidate { obj_id: 1, sec_id: 2, key_id: 10, binding: BIND_COMDAT, selection: COMDAT_SELECT_ANY, assoc_leader: 99, size_bytes: 80, folded: false, winner_sec: 2 },
        ComdatCandidate { obj_id: 1, sec_id: 3, key_id: 0,  binding: BIND_LOCAL,  selection: COMDAT_SELECT_ASSOCIATIVE, assoc_leader: 2, size_bytes: 12, folded: false, winner_sec: 3 },
        ComdatCandidate { obj_id: 2, sec_id: 4, key_id: 10, binding: BIND_COMDAT, selection: COMDAT_SELECT_ANY, assoc_leader: 99, size_bytes: 80, folded: false, winner_sec: 4 },
        ComdatCandidate { obj_id: 0, sec_id: 5, key_id: 20, binding: BIND_COMDAT, selection: COMDAT_SELECT_LARGEST, assoc_leader: 99, size_bytes: 16, folded: false, winner_sec: 5 },
        ComdatCandidate { obj_id: 1, sec_id: 6, key_id: 20, binding: BIND_COMDAT, selection: COMDAT_SELECT_LARGEST, assoc_leader: 99, size_bytes: 64, folded: false, winner_sec: 6 },
        ComdatCandidate { obj_id: 0, sec_id: 7, key_id: 30, binding: BIND_WEAK,   selection: COMDAT_SELECT_ANY, assoc_leader: 99, size_bytes: 24, folded: false, winner_sec: 7 },
        ComdatCandidate { obj_id: 2, sec_id: 8, key_id: 30, binding: BIND_GLOBAL, selection: COMDAT_SELECT_ANY, assoc_leader: 99, size_bytes: 40, folded: false, winner_sec: 8 }
    ];

    let mut folded_leaders: i32 = 0;
    let mut folded_assocs: i32 = 0;

    let mut i: usize = 0;
    while i < 9 {
        if !cands[i].folded && cands[i].key_id != 0 {
            let key: i32 = cands[i].key_id;
            let mut win_idx: usize = i;
            let mut j: usize = i + 1;
            while j < 9 {
                if !cands[j].folded && cands[j].key_id == key {
                    if cand_wins(cands[j], cands[win_idx]) {
                        win_idx = j;
                    }
                }
                j = j + 1;
            }
            let win_sec: i32 = cands[win_idx].sec_id;
            let mut k: usize = i;
            while k < 9 {
                if k != win_idx && !cands[k].folded && cands[k].key_id == key {
                    let old_sec: i32 = cands[k].sec_id;
                    cands[k].folded = true;
                    cands[k].winner_sec = win_sec;
                    folded_leaders = folded_leaders + 1;
                    let mut a: usize = 0;
                    while a < 9 {
                        if cands[a].selection == COMDAT_SELECT_ASSOCIATIVE && cands[a].assoc_leader == old_sec {
                            cands[a].folded = true;
                            cands[a].winner_sec = win_sec;
                            folded_assocs = folded_assocs + 1;
                        }
                        a = a + 1;
                    }
                }
                k = k + 1;
            }
        }
        i = i + 1;
    }

    print_line_i32(IMAGE_SCN_LNK_COMDAT);
    print_line_i32(folded_leaders);
    print_line_i32(folded_assocs);
    print_line_i32(cands[2].winner_sec);
    print_line_i32(cands[5].winner_sec);
    print_line_i32(cands[7].winner_sec);
    if folded_leaders != 4 || folded_assocs != 1 || cands[7].winner_sec != 8 {
        return 1;
    }
    0
}
