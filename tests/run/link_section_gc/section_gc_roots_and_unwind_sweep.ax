// test: run
// modes: interp native
// exit: 0
// stdout: 9\n3\n2\n280\n272\n

const SEC_TEXT: i32 = 0;
const SEC_RDATA: i32 = 1;
const SEC_DATA: i32 = 2;
const SEC_PDATA: i32 = 4;
const SEC_XDATA: i32 = 5;

const ROOT_NONE: i32 = 0;
const ROOT_ENTRY: i32 = 1;
const ROOT_USED: i32 = 3;
const ROOT_AT_PINNED: i32 = 4;

@derive(Copy)
struct GcSecNode {
    sec_id: i32,
    kind: i32,
    root_kind: i32,
    assoc_leader: i32,
    reloc_tgt_a: i32,
    reloc_tgt_b: i32,
    size_bytes: i32,
    is_live: bool,
}

fn print_line_i32(v: i32) {
    print_int(v);
    print("\n");
}

fn main() -> i32 {
    let none: i32 = 99;
    let mut secs: [12]GcSecNode = [
        GcSecNode { sec_id: 0,  kind: SEC_TEXT,  root_kind: ROOT_ENTRY,     assoc_leader: none, reloc_tgt_a: 3,    reloc_tgt_b: none, size_bytes: 64,  is_live: false },
        GcSecNode { sec_id: 1,  kind: SEC_PDATA, root_kind: ROOT_NONE,      assoc_leader: 0,    reloc_tgt_a: none, reloc_tgt_b: none, size_bytes: 12,  is_live: false },
        GcSecNode { sec_id: 2,  kind: SEC_XDATA, root_kind: ROOT_NONE,      assoc_leader: 0,    reloc_tgt_a: none, reloc_tgt_b: none, size_bytes: 16,  is_live: false },
        GcSecNode { sec_id: 3,  kind: SEC_TEXT,  root_kind: ROOT_NONE,      assoc_leader: none, reloc_tgt_a: 6,    reloc_tgt_b: none, size_bytes: 96,  is_live: false },
        GcSecNode { sec_id: 4,  kind: SEC_PDATA, root_kind: ROOT_NONE,      assoc_leader: 3,    reloc_tgt_a: none, reloc_tgt_b: none, size_bytes: 12,  is_live: false },
        GcSecNode { sec_id: 5,  kind: SEC_XDATA, root_kind: ROOT_NONE,      assoc_leader: 3,    reloc_tgt_a: none, reloc_tgt_b: none, size_bytes: 16,  is_live: false },
        GcSecNode { sec_id: 6,  kind: SEC_RDATA, root_kind: ROOT_NONE,      assoc_leader: none, reloc_tgt_a: none, reloc_tgt_b: none, size_bytes: 32,  is_live: false },
        GcSecNode { sec_id: 7,  kind: SEC_RDATA, root_kind: ROOT_USED,      assoc_leader: none, reloc_tgt_a: none, reloc_tgt_b: none, size_bytes: 24,  is_live: false },
        GcSecNode { sec_id: 8,  kind: SEC_DATA,  root_kind: ROOT_AT_PINNED, assoc_leader: none, reloc_tgt_a: none, reloc_tgt_b: none, size_bytes: 8,   is_live: false },
        GcSecNode { sec_id: 9,  kind: SEC_TEXT,  root_kind: ROOT_NONE,      assoc_leader: none, reloc_tgt_a: none, reloc_tgt_b: none, size_bytes: 240, is_live: false },
        GcSecNode { sec_id: 10, kind: SEC_PDATA, root_kind: ROOT_NONE,      assoc_leader: 9,    reloc_tgt_a: none, reloc_tgt_b: none, size_bytes: 12,  is_live: false },
        GcSecNode { sec_id: 11, kind: SEC_XDATA, root_kind: ROOT_NONE,      assoc_leader: 9,    reloc_tgt_a: none, reloc_tgt_b: none, size_bytes: 20,  is_live: false }
    ];

    let mut queue: [12]i32 = [0; 12];
    let mut q_head: usize = 0;
    let mut q_tail: usize = 0;

    let mut i: usize = 0;
    while i < 12 {
        if secs[i].root_kind != ROOT_NONE {
            secs[i].is_live = true;
            queue[q_tail] = i as i32;
            q_tail = q_tail + 1;
        }
        i = i + 1;
    }

    while q_head < q_tail {
        let cur: i32 = queue[q_head];
        q_head = q_head + 1;
        let ta: i32 = secs[cur as usize].reloc_tgt_a;
        if ta < 12 && !secs[ta as usize].is_live {
            secs[ta as usize].is_live = true;
            queue[q_tail] = ta;
            q_tail = q_tail + 1;
        }
        let tb: i32 = secs[cur as usize].reloc_tgt_b;
        if tb < 12 && !secs[tb as usize].is_live {
            secs[tb as usize].is_live = true;
            queue[q_tail] = tb;
            q_tail = q_tail + 1;
        }
        let mut a: usize = 0;
        while a < 12 {
            if !secs[a].is_live && secs[a].assoc_leader == cur {
                secs[a].is_live = true;
                queue[q_tail] = a as i32;
                q_tail = q_tail + 1;
            }
            a = a + 1;
        }
    }

    let mut retained_cnt: i32 = 0;
    let mut stripped_cnt: i32 = 0;
    let mut stripped_unwind: i32 = 0;
    let mut retained_bytes: i32 = 0;
    let mut stripped_bytes: i32 = 0;

    let mut k: usize = 0;
    while k < 12 {
        if secs[k].is_live {
            retained_cnt = retained_cnt + 1;
            retained_bytes = retained_bytes + secs[k].size_bytes;
        } else {
            stripped_cnt = stripped_cnt + 1;
            stripped_bytes = stripped_bytes + secs[k].size_bytes;
            let kd: i32 = secs[k].kind;
            if kd == SEC_PDATA || kd == SEC_XDATA {
                stripped_unwind = stripped_unwind + 1;
            }
        }
        k = k + 1;
    }

    print_line_i32(retained_cnt);
    print_line_i32(stripped_cnt);
    print_line_i32(stripped_unwind);
    print_line_i32(retained_bytes);
    print_line_i32(stripped_bytes);
    if retained_cnt != 9 || stripped_cnt != 3 || stripped_unwind != 2 {
        return 1;
    }
    0
}
