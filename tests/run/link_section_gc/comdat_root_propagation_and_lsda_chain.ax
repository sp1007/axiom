// test: run
// modes: interp native
// exit: 0
// stdout: 1\n2\n7\n2\n288\n120\n

const ROOT_NONE: i32 = 0;
const ROOT_ENTRY: i32 = 1;
const ROOT_EXPORT: i32 = 2;

@derive(Copy)
struct SecItem {
    obj_id: i32,
    sec_id: i32,
    comdat_key: i32,
    assoc_leader: i32,
    root_kind: i32,
    reloc_a: i32,
    reloc_b: i32,
    size_bytes: i32,
    folded: bool,
    live: bool,
}

fn print_line_i32(v: i32) {
    print_int(v);
    print("\n");
}

fn main() -> i32 {
    let none: i32 = 99;
    let mut secs: [10]SecItem = [
        SecItem { obj_id: 0, sec_id: 0, comdat_key: 0,  assoc_leader: none, root_kind: ROOT_ENTRY,  reloc_a: 3,    reloc_b: none, size_bytes: 48,  folded: false, live: false },
        SecItem { obj_id: 0, sec_id: 1, comdat_key: 50, assoc_leader: none, root_kind: ROOT_NONE,   reloc_a: none, reloc_b: none, size_bytes: 64,  folded: false, live: false },
        SecItem { obj_id: 1, sec_id: 2, comdat_key: 50, assoc_leader: none, root_kind: ROOT_EXPORT, reloc_a: none, reloc_b: none, size_bytes: 64,  folded: false, live: false },
        SecItem { obj_id: 0, sec_id: 3, comdat_key: 0,  assoc_leader: none, root_kind: ROOT_NONE,   reloc_a: none, reloc_b: none, size_bytes: 80,  folded: false, live: false },
        SecItem { obj_id: 0, sec_id: 4, comdat_key: 0,  assoc_leader: 3,    root_kind: ROOT_NONE,   reloc_a: none, reloc_b: none, size_bytes: 12,  folded: false, live: false },
        SecItem { obj_id: 0, sec_id: 5, comdat_key: 0,  assoc_leader: 3,    root_kind: ROOT_NONE,   reloc_a: 6,    reloc_b: 7,    size_bytes: 20,  folded: false, live: false },
        SecItem { obj_id: 0, sec_id: 6, comdat_key: 0,  assoc_leader: none, root_kind: ROOT_NONE,   reloc_a: none, reloc_b: none, size_bytes: 36,  folded: false, live: false },
        SecItem { obj_id: 0, sec_id: 7, comdat_key: 0,  assoc_leader: none, root_kind: ROOT_NONE,   reloc_a: none, reloc_b: none, size_bytes: 28,  folded: false, live: false },
        SecItem { obj_id: 1, sec_id: 8, comdat_key: 0,  assoc_leader: 9,    root_kind: ROOT_NONE,   reloc_a: 6,    reloc_b: none, size_bytes: 20,  folded: false, live: false },
        SecItem { obj_id: 1, sec_id: 9, comdat_key: 0,  assoc_leader: none, root_kind: ROOT_NONE,   reloc_a: none, reloc_b: none, size_bytes: 100, folded: false, live: false }
    ];

    let mut folded_cnt: i32 = 0;
    let mut i: usize = 0;
    while i < 10 {
        if !secs[i].folded && secs[i].comdat_key != 0 {
            let key: i32 = secs[i].comdat_key;
            let mut j: usize = i + 1;
            while j < 10 {
                if !secs[j].folded && secs[j].comdat_key == key {
                    if secs[j].root_kind != ROOT_NONE && secs[i].root_kind == ROOT_NONE {
                        secs[i].root_kind = secs[j].root_kind;
                    }
                    secs[j].folded = true;
                    folded_cnt = folded_cnt + 1;
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }

    let mut queue: [10]i32 = [0; 10];
    let mut q_head: usize = 0;
    let mut q_tail: usize = 0;
    let mut roots_seeded: i32 = 0;

    let mut r: usize = 0;
    while r < 10 {
        if !secs[r].folded && secs[r].root_kind != ROOT_NONE {
            secs[r].live = true;
            queue[q_tail] = r as i32;
            q_tail = q_tail + 1;
            roots_seeded = roots_seeded + 1;
        }
        r = r + 1;
    }

    while q_head < q_tail {
        let cur: i32 = queue[q_head];
        q_head = q_head + 1;
        let ra: i32 = secs[cur as usize].reloc_a;
        if ra < 10 && !secs[ra as usize].folded && !secs[ra as usize].live {
            secs[ra as usize].live = true;
            queue[q_tail] = ra;
            q_tail = q_tail + 1;
        }
        let rb: i32 = secs[cur as usize].reloc_b;
        if rb < 10 && !secs[rb as usize].folded && !secs[rb as usize].live {
            secs[rb as usize].live = true;
            queue[q_tail] = rb;
            q_tail = q_tail + 1;
        }
        let mut a: usize = 0;
        while a < 10 {
            if !secs[a].folded && !secs[a].live && secs[a].assoc_leader == cur {
                secs[a].live = true;
                queue[q_tail] = a as i32;
                q_tail = q_tail + 1;
            }
            a = a + 1;
        }
    }

    let mut retained_cnt: i32 = 0;
    let mut stripped_cnt: i32 = 0;
    let mut retained_bytes: i32 = 0;
    let mut stripped_bytes: i32 = 0;

    let mut k: usize = 0;
    while k < 10 {
        if !secs[k].folded {
            if secs[k].live {
                retained_cnt = retained_cnt + 1;
                retained_bytes = retained_bytes + secs[k].size_bytes;
            } else {
                stripped_cnt = stripped_cnt + 1;
                stripped_bytes = stripped_bytes + secs[k].size_bytes;
            }
        }
        k = k + 1;
    }

    print_line_i32(folded_cnt);
    print_line_i32(roots_seeded);
    print_line_i32(retained_cnt);
    print_line_i32(stripped_cnt);
    print_line_i32(retained_bytes);
    print_line_i32(stripped_bytes);
    if folded_cnt != 1 || roots_seeded != 2 || retained_cnt != 7 || stripped_cnt != 2 {
        return 1;
    }
    0
}
