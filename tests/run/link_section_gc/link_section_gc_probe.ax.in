fn new_arena(chunk: usize) -> Arena {
    let mut a = arena_with_chunk_size(chunk);
    let _ = arena_alloc_raw(mut_view(a), 16, 8);
    a
}

fn alloc_sv8(arena: mut_view<Arena>, s0: u8, s1: u8, s2: u8, s3: u8, s4: u8, s5: u8, s6: u8, s7: u8, len: usize) -> StrView {
    let b = arena_alloc_raw(mut_view(*arena), 8, 1);
    unsafe {
        *lgc_byte_at(b, 0) = s0;
        *lgc_byte_at(b, 1) = s1;
        *lgc_byte_at(b, 2) = s2;
        *lgc_byte_at(b, 3) = s3;
        *lgc_byte_at(b, 4) = s4;
        *lgc_byte_at(b, 5) = s5;
        *lgc_byte_at(b, 6) = s6;
        *lgc_byte_at(b, 7) = s7;
    }
    StrView { ptr: b as *const u8, len: len }
}

fn diag_buf_eq(a: view<DiagBuffer>, b: view<DiagBuffer>) -> bool {
    if a.len != b.len {
        return false;
    }
    let mut i: usize = 0;
    while i < a.len {
        let ba = unsafe { *(a.ptr + i) };
        let bb = unsafe { *(b.ptr + i) };
        if ba != bb {
            return false;
        }
        i = i + 1;
    }
    true
}

fn diag_buf_has_sub(db: view<DiagBuffer>, needle: StrView) -> bool {
    let dlen: usize = db.len;
    let nlen: usize = needle.len;
    if nlen == 0 || dlen < nlen {
        return false;
    }
    let limit: usize = dlen - nlen;
    let mut i: usize = 0;
    while i <= limit {
        let mut ok: bool = true;
        let mut j: usize = 0;
        while j < nlen {
            let a = unsafe { *(db.ptr + (i + j)) };
            let b = unsafe { *(needle.ptr + j) };
            if a != b {
                ok = false;
                j = nlen;
            } else {
                j = j + 1;
            }
        }
        if ok {
            return true;
        }
        i = i + 1;
    }
    false
}

fn run_probe_archive_gc_roots_and_unwind(arena: mut_view<Arena>) -> bool {
    let g = lgc_graph_new(mut_view(*arena), true, false, false);

    let s_main_obj = alloc_sv8(mut_view(*arena), 109u8, 97u8, 105u8, 110u8, 46u8, 111u8, 98u8, 106u8, 8);
    let s_std_lib  = alloc_sv8(mut_view(*arena), 115u8, 116u8, 100u8, 46u8, 108u8, 105u8, 98u8, 0u8, 7);
    let s_io_obj   = alloc_sv8(mut_view(*arena), 105u8, 111u8, 46u8, 111u8, 98u8, 106u8, 0u8, 0u8, 6);
    let s_sys_obj  = alloc_sv8(mut_view(*arena), 115u8, 121u8, 115u8, 46u8, 111u8, 98u8, 106u8, 0u8, 7);
    let s_net_obj  = alloc_sv8(mut_view(*arena), 110u8, 101u8, 116u8, 46u8, 111u8, 98u8, 106u8, 0u8, 7);

    let obj_main = lgc_add_object(unsafe { mut_view(*g) }, mut_view(*arena), s_main_obj, 0x1001u64);
    let obj_io   = lgc_add_archive_member(unsafe { mut_view(*g) }, mut_view(*arena), s_std_lib, s_io_obj, 0x1002u64);
    let obj_sys  = lgc_add_archive_member(unsafe { mut_view(*g) }, mut_view(*arena), s_std_lib, s_sys_obj, 0x1003u64);
    let obj_net  = lgc_add_archive_member(unsafe { mut_view(*g) }, mut_view(*arena), s_std_lib, s_net_obj, 0x1004u64);

    let sym_main    = alloc_sv8(mut_view(*arena), 109u8, 97u8, 105u8, 110u8, 0u8, 0u8, 0u8, 0u8, 4);
    let sym_init    = alloc_sv8(mut_view(*arena), 105u8, 110u8, 105u8, 116u8, 0u8, 0u8, 0u8, 0u8, 4);
    let sym_used    = alloc_sv8(mut_view(*arena), 117u8, 115u8, 101u8, 100u8, 95u8, 104u8, 107u8, 0u8, 7);
    let sym_mmio    = alloc_sv8(mut_view(*arena), 109u8, 109u8, 105u8, 111u8, 95u8, 97u8, 116u8, 0u8, 7);
    let sym_refl    = alloc_sv8(mut_view(*arena), 114u8, 101u8, 102u8, 108u8, 95u8, 116u8, 98u8, 0u8, 7);
    let sym_dead_fn = alloc_sv8(mut_view(*arena), 100u8, 101u8, 97u8, 100u8, 95u8, 102u8, 110u8, 0u8, 7);
    let sym_dead_ro = alloc_sv8(mut_view(*arena), 100u8, 101u8, 97u8, 100u8, 95u8, 114u8, 111u8, 0u8, 7);
    let sym_dead_bs = alloc_sv8(mut_view(*arena), 100u8, 101u8, 97u8, 100u8, 95u8, 98u8, 115u8, 0u8, 7);
    let sym_println = alloc_sv8(mut_view(*arena), 112u8, 114u8, 105u8, 110u8, 116u8, 108u8, 110u8, 0u8, 7);
    let sym_unread  = alloc_sv8(mut_view(*arena), 117u8, 110u8, 95u8, 114u8, 101u8, 97u8, 100u8, 0u8, 7);
    let sym_sys_wr  = alloc_sv8(mut_view(*arena), 115u8, 121u8, 115u8, 95u8, 119u8, 114u8, 0u8, 0u8, 6);
    let sym_tcp     = alloc_sv8(mut_view(*arena), 116u8, 99u8, 112u8, 95u8, 99u8, 111u8, 110u8, 0u8, 7);
    let sym_ghost   = alloc_sv8(mut_view(*arena), 103u8, 104u8, 111u8, 115u8, 116u8, 0u8, 0u8, 0u8, 5);

    let sec_main = lgc_emit_function_with_unwind(
        unsafe { mut_view(*g) }, mut_view(*arena), obj_main, sym_main, sym_main,
        LGC_BIND_GLOBAL, COMDAT_SELECT_NONE, 64u32, 0xAA01u64, 16u32, LGC_ROOT_ENTRY
    );
    let sec_init = lgc_emit_function_with_unwind(
        unsafe { mut_view(*g) }, mut_view(*arena), obj_main, sym_init, sym_init,
        LGC_BIND_LOCAL, COMDAT_SELECT_NONE, 32u32, 0xAA02u64, 8u32, LGC_ROOT_MODULE_INIT
    );
    let sec_used = lgc_emit_static_datum(
        unsafe { mut_view(*g) }, mut_view(*arena), obj_main, sym_used, sym_used,
        LGC_SEC_RDATA, 8u32, LGC_BIND_GLOBAL, COMDAT_SELECT_NONE, 24u32, 0xAA03u64, LGC_ROOT_USED
    );
    let sec_mmio = lgc_emit_static_datum(
        unsafe { mut_view(*g) }, mut_view(*arena), obj_main, sym_mmio, sym_mmio,
        LGC_SEC_DATA, 8u32, LGC_BIND_GLOBAL, COMDAT_SELECT_NONE, 8u32, 0xAA04u64, LGC_ROOT_NONE
    );
    lgc_set_pinned_vma(unsafe { mut_view(*g) }, sec_mmio, 0xFFE00000u64);
    let sec_refl = lgc_emit_static_datum(
        unsafe { mut_view(*g) }, mut_view(*arena), obj_main, sym_refl, sym_refl,
        LGC_SEC_RDATA, 8u32, LGC_BIND_LOCAL, COMDAT_SELECT_NONE, 48u32, 0xAA05u64, LGC_ROOT_REFLECTION
    );

    let sec_dead_fn = lgc_emit_function_with_unwind(
        unsafe { mut_view(*g) }, mut_view(*arena), obj_main, sym_dead_fn, sym_dead_fn,
        LGC_BIND_LOCAL, COMDAT_SELECT_NONE, 128u32, 0xDEAD01u64, 20u32, LGC_ROOT_NONE
    );
    let _sec_dead_ro = lgc_emit_static_datum(
        unsafe { mut_view(*g) }, mut_view(*arena), obj_main, sym_dead_ro, sym_dead_ro,
        LGC_SEC_RDATA, 16u32, LGC_BIND_LOCAL, COMDAT_SELECT_NONE, 256u32, 0xDEAD02u64, LGC_ROOT_NONE
    );
    let _sec_dead_bs = lgc_emit_static_datum(
        unsafe { mut_view(*g) }, mut_view(*arena), obj_main, sym_dead_bs, sym_dead_bs,
        LGC_SEC_BSS, 16u32, LGC_BIND_LOCAL, COMDAT_SELECT_NONE, 512u32, 0u64, LGC_ROOT_NONE
    );
    lgc_add_reloc(unsafe { mut_view(*g) }, mut_view(*arena), sec_dead_fn, 12u32, LGC_RELOC_REL32, sym_ghost, LGC_NONE_ID, 0);

    let sec_println = lgc_emit_function_with_unwind(
        unsafe { mut_view(*g) }, mut_view(*arena), obj_io, sym_println, sym_println,
        LGC_BIND_GLOBAL, COMDAT_SELECT_NONE, 96u32, 0xBB01u64, 16u32, LGC_ROOT_NONE
    );
    let _sec_unread = lgc_emit_function_with_unwind(
        unsafe { mut_view(*g) }, mut_view(*arena), obj_io, sym_unread, sym_unread,
        LGC_BIND_GLOBAL, COMDAT_SELECT_NONE, 144u32, 0xBB02u64, 16u32, LGC_ROOT_NONE
    );
    let _sec_sys_wr = lgc_emit_function_with_unwind(
        unsafe { mut_view(*g) }, mut_view(*arena), obj_sys, sym_sys_wr, sym_sys_wr,
        LGC_BIND_GLOBAL, COMDAT_SELECT_NONE, 48u32, 0xCC01u64, 8u32, LGC_ROOT_NONE
    );
    let _sec_tcp = lgc_emit_function_with_unwind(
        unsafe { mut_view(*g) }, mut_view(*arena), obj_net, sym_tcp, sym_tcp,
        LGC_BIND_GLOBAL, COMDAT_SELECT_NONE, 320u32, 0xDD01u64, 24u32, LGC_ROOT_NONE
    );

    lgc_add_reloc(unsafe { mut_view(*g) }, mut_view(*arena), sec_main, 8u32, LGC_RELOC_REL32, sym_println, LGC_NONE_ID, 0);
    lgc_add_reloc(unsafe { mut_view(*g) }, mut_view(*arena), sec_println, 16u32, LGC_RELOC_REL32, sym_sys_wr, LGC_NONE_ID, 0);

    let _u1 = sec_init;
    let _u2 = sec_used;
    let _u3 = sec_refl;

    if !lgc_run_pipeline(unsafe { mut_view(*g) }, mut_view(*arena)) {
        return false;
    }

    let st = unsafe { (*g).stats };
    if st.extracted_archive_members != 2u32 || st.skipped_archive_members != 1u32 {
        return false;
    }
    if st.roots_seeded != 5u32 {
        return false;
    }
    if st.retained_sections != 15u32 || st.retained_code_sections != 4u32 || st.retained_unwind_sections != 8u32 || st.retained_data_sections != 3u32 {
        return false;
    }
    if st.dead_stripped_sections != 8u32 || st.dead_code_stripped != 2u32 || st.dead_unwind_stripped != 4u32 || st.dead_data_stripped != 2u32 {
        return false;
    }

    let mut db1: DiagBuffer = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    let mut db2: DiagBuffer = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(db1));
    diag_buf_init(mut_view(db2));
    lgc_emit_gc_sections_report(unsafe { view(*g) }, mut_view(db1));
    lgc_emit_link_map_report(unsafe { view(*g) }, mut_view(db1));
    lgc_emit_gc_sections_report(unsafe { view(*g) }, mut_view(db2));
    lgc_emit_link_map_report(unsafe { view(*g) }, mut_view(db2));
    let ok_det: bool = diag_buf_eq(view(db1), view(db2)) &&
                       diag_buf_has_sub(view(db1), sym_println) &&
                       diag_buf_has_sub(view(db1), sym_dead_fn);
    diag_buf_free(mut_view(db1));
    diag_buf_free(mut_view(db2));
    ok_det
}

fn run_probe_comdat_generic_vtable_and_weak(arena: mut_view<Arena>) -> bool {
    let g = lgc_graph_new(mut_view(*arena), true, true, false);

    let s_a_obj = alloc_sv8(mut_view(*arena), 97u8, 46u8, 111u8, 98u8, 106u8, 0u8, 0u8, 0u8, 5);
    let s_b_obj = alloc_sv8(mut_view(*arena), 98u8, 46u8, 111u8, 98u8, 106u8, 0u8, 0u8, 0u8, 5);
    let s_c_obj = alloc_sv8(mut_view(*arena), 99u8, 46u8, 111u8, 98u8, 106u8, 0u8, 0u8, 0u8, 5);

    let obj_a = lgc_add_object(unsafe { mut_view(*g) }, mut_view(*arena), s_a_obj, 0x2001u64);
    let obj_b = lgc_add_object(unsafe { mut_view(*g) }, mut_view(*arena), s_b_obj, 0x2002u64);
    let obj_c = lgc_add_object(unsafe { mut_view(*g) }, mut_view(*arena), s_c_obj, 0x2003u64);

    let sym_exp  = alloc_sv8(mut_view(*arena), 100u8, 108u8, 108u8, 95u8, 101u8, 120u8, 112u8, 0u8, 7);
    let sym_vec  = alloc_sv8(mut_view(*arena), 118u8, 101u8, 99u8, 95u8, 112u8, 115u8, 104u8, 0u8, 7);
    let sym_vt   = alloc_sv8(mut_view(*arena), 118u8, 116u8, 95u8, 100u8, 105u8, 115u8, 112u8, 0u8, 7);
    let sym_ti   = alloc_sv8(mut_view(*arena), 116u8, 105u8, 95u8, 118u8, 101u8, 99u8, 0u8, 0u8, 6);
    let sym_pgo  = alloc_sv8(mut_view(*arena), 112u8, 103u8, 111u8, 95u8, 99u8, 110u8, 116u8, 0u8, 7);
    let sym_hook = alloc_sv8(mut_view(*arena), 97u8, 108u8, 95u8, 104u8, 111u8, 111u8, 107u8, 0u8, 7);

    let sec_exp = lgc_emit_function_with_unwind(
        unsafe { mut_view(*g) }, mut_view(*arena), obj_a, sym_exp, sym_exp,
        LGC_BIND_GLOBAL, COMDAT_SELECT_NONE, 48u32, 0x1111u64, 12u32, LGC_ROOT_EXPORT
    );

    let sec_vec_a = lgc_emit_function_with_unwind(
        unsafe { mut_view(*g) }, mut_view(*arena), obj_a, sym_vec, sym_vec,
        LGC_BIND_COMDAT, COMDAT_SELECT_ANY, 80u32, 0x7777u64, 16u32, LGC_ROOT_NONE
    );
    let sec_vec_b = lgc_emit_function_with_unwind(
        unsafe { mut_view(*g) }, mut_view(*arena), obj_b, sym_vec, sym_vec,
        LGC_BIND_COMDAT, COMDAT_SELECT_ANY, 80u32, 0x7777u64, 16u32, LGC_ROOT_NONE
    );
    let sec_vec_c = lgc_emit_function_with_unwind(
        unsafe { mut_view(*g) }, mut_view(*arena), obj_c, sym_vec, sym_vec,
        LGC_BIND_COMDAT, COMDAT_SELECT_ANY, 80u32, 0x7777u64, 16u32, LGC_ROOT_NONE
    );

    let sec_vt_a = lgc_emit_static_datum(
        unsafe { mut_view(*g) }, mut_view(*arena), obj_a, sym_vt, sym_vt,
        LGC_SEC_RDATA, 8u32, LGC_BIND_COMDAT, COMDAT_SELECT_SAME_SIZE, 32u32, 0x8881u64, LGC_ROOT_NONE
    );
    let _sec_vt_b = lgc_emit_static_datum(
        unsafe { mut_view(*g) }, mut_view(*arena), obj_b, sym_vt, sym_vt,
        LGC_SEC_RDATA, 8u32, LGC_BIND_COMDAT, COMDAT_SELECT_SAME_SIZE, 32u32, 0x8882u64, LGC_ROOT_NONE
    );

    let sec_ti_a = lgc_emit_static_datum(
        unsafe { mut_view(*g) }, mut_view(*arena), obj_a, sym_ti, sym_ti,
        LGC_SEC_RDATA, 8u32, LGC_BIND_COMDAT, COMDAT_SELECT_EXACT_MATCH, 24u32, 0x9999u64, LGC_ROOT_NONE
    );
    let _sec_ti_c = lgc_emit_static_datum(
        unsafe { mut_view(*g) }, mut_view(*arena), obj_c, sym_ti, sym_ti,
        LGC_SEC_RDATA, 8u32, LGC_BIND_COMDAT, COMDAT_SELECT_EXACT_MATCH, 24u32, 0x9999u64, LGC_ROOT_NONE
    );

    let _sec_pgo_a = lgc_emit_static_datum(
        unsafe { mut_view(*g) }, mut_view(*arena), obj_a, sym_pgo, sym_pgo,
        LGC_SEC_DATA, 8u32, LGC_BIND_COMDAT, COMDAT_SELECT_LARGEST, 16u32, 0xA001u64, LGC_ROOT_NONE
    );
    let sec_pgo_b = lgc_emit_static_datum(
        unsafe { mut_view(*g) }, mut_view(*arena), obj_b, sym_pgo, sym_pgo,
        LGC_SEC_DATA, 8u32, LGC_BIND_COMDAT, COMDAT_SELECT_LARGEST, 64u32, 0xA002u64, LGC_ROOT_NONE
    );

    let _sec_hk_a = lgc_emit_function_with_unwind(
        unsafe { mut_view(*g) }, mut_view(*arena), obj_a, sym_hook, sym_hook,
        LGC_BIND_WEAK, COMDAT_SELECT_ANY, 24u32, 0xB001u64, 0u32, LGC_ROOT_NONE
    );
    let sec_hk_c = lgc_emit_function_with_unwind(
        unsafe { mut_view(*g) }, mut_view(*arena), obj_c, sym_hook, sym_hook,
        LGC_BIND_GLOBAL, COMDAT_SELECT_ANY, 40u32, 0xB002u64, 0u32, LGC_ROOT_NONE
    );

    lgc_add_reloc(unsafe { mut_view(*g) }, mut_view(*arena), sec_exp, 4u32, LGC_RELOC_REL32, sym_vec, sec_vec_b, 0);
    lgc_add_reloc(unsafe { mut_view(*g) }, mut_view(*arena), sec_vec_a, 8u32, LGC_RELOC_ADDR32NB, sym_vt, sec_vt_a, 0);
    lgc_add_reloc(unsafe { mut_view(*g) }, mut_view(*arena), sec_vec_a, 12u32, LGC_RELOC_ADDR32NB, sym_ti, sec_ti_a, 0);
    lgc_add_reloc(unsafe { mut_view(*g) }, mut_view(*arena), sec_vec_a, 16u32, LGC_RELOC_ADDR32NB, sym_pgo, LGC_NONE_ID, 0);
    lgc_add_reloc(unsafe { mut_view(*g) }, mut_view(*arena), sec_vec_a, 20u32, LGC_RELOC_REL32, sym_hook, LGC_NONE_ID, 0);

    let _unused_vc = sec_vec_c;
    if !lgc_run_pipeline(unsafe { mut_view(*g) }, mut_view(*arena)) {
        return false;
    }

    let st = unsafe { (*g).stats };
    if st.comdat_groups_total != 5u32 || st.comdat_sections_folded != 6u32 || st.comdat_assoc_folded != 4u32 {
        return false;
    }
    let pgo_b_ptr = unsafe { lgc_sec_at((*g).secs, sec_pgo_b as usize) };
    let hk_c_ptr = unsafe { lgc_sec_at((*g).secs, sec_hk_c as usize) };
    if !(unsafe { (*pgo_b_ptr).is_live }) || !(unsafe { (*hk_c_ptr).is_live }) {
        return false;
    }

    let mut db1: DiagBuffer = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    let mut db2: DiagBuffer = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(db1));
    diag_buf_init(mut_view(db2));
    lgc_emit_gc_sections_report(unsafe { view(*g) }, mut_view(db1));
    lgc_emit_link_map_report(unsafe { view(*g) }, mut_view(db1));
    lgc_emit_gc_sections_report(unsafe { view(*g) }, mut_view(db2));
    lgc_emit_link_map_report(unsafe { view(*g) }, mut_view(db2));
    let ok_det: bool = diag_buf_eq(view(db1), view(db2)) &&
                       diag_buf_has_sub(view(db1), sym_vec) &&
                       diag_buf_has_sub(view(db1), sym_hook);
    diag_buf_free(mut_view(db1));
    diag_buf_free(mut_view(db2));
    ok_det
}

fn run_probe_negative_diags_and_modes(arena: mut_view<Arena>) -> bool {
    let s_a = alloc_sv8(mut_view(*arena), 97u8, 46u8, 111u8, 98u8, 106u8, 0u8, 0u8, 0u8, 5);
    let s_b = alloc_sv8(mut_view(*arena), 98u8, 46u8, 111u8, 98u8, 106u8, 0u8, 0u8, 0u8, 5);
    let sym_dup = alloc_sv8(mut_view(*arena), 100u8, 117u8, 112u8, 95u8, 115u8, 121u8, 109u8, 0u8, 7);

    // 1. Duplicate strong symbol -> AX_LINK_DUPLICATE_SYMBOL (136)
    let g1 = lgc_graph_new(mut_view(*arena), true, false, false);
    let o1a = lgc_add_object(unsafe { mut_view(*g1) }, mut_view(*arena), s_a, 1u64);
    let o1b = lgc_add_object(unsafe { mut_view(*g1) }, mut_view(*arena), s_b, 2u64);
    let _s1 = lgc_emit_function_with_unwind(unsafe { mut_view(*g1) }, mut_view(*arena), o1a, sym_dup, sym_dup, LGC_BIND_GLOBAL, COMDAT_SELECT_NONE, 32u32, 1u64, 0u32, LGC_ROOT_ENTRY);
    let _s2 = lgc_emit_function_with_unwind(unsafe { mut_view(*g1) }, mut_view(*arena), o1b, sym_dup, sym_dup, LGC_BIND_GLOBAL, COMDAT_SELECT_NONE, 32u32, 1u64, 0u32, LGC_ROOT_NONE);
    if lgc_run_pipeline(unsafe { mut_view(*g1) }, mut_view(*arena)) || (unsafe { (*g1).stats.diag_code }) != AX_LINK_DUPLICATE_SYMBOL {
        return false;
    }

    // 2. COMDAT_SELECT_EXACT_MATCH hash mismatch -> AX_LINK_DUPLICATE_SYMBOL (136)
    let g2 = lgc_graph_new(mut_view(*arena), true, false, false);
    let o2a = lgc_add_object(unsafe { mut_view(*g2) }, mut_view(*arena), s_a, 1u64);
    let o2b = lgc_add_object(unsafe { mut_view(*g2) }, mut_view(*arena), s_b, 2u64);
    let _e1 = lgc_emit_static_datum(unsafe { mut_view(*g2) }, mut_view(*arena), o2a, sym_dup, sym_dup, LGC_SEC_RDATA, 8u32, LGC_BIND_COMDAT, COMDAT_SELECT_EXACT_MATCH, 24u32, 0x111u64, LGC_ROOT_USED);
    let _e2 = lgc_emit_static_datum(unsafe { mut_view(*g2) }, mut_view(*arena), o2b, sym_dup, sym_dup, LGC_SEC_RDATA, 8u32, LGC_BIND_COMDAT, COMDAT_SELECT_EXACT_MATCH, 24u32, 0x222u64, LGC_ROOT_NONE);
    if lgc_run_pipeline(unsafe { mut_view(*g2) }, mut_view(*arena)) || (unsafe { (*g2).stats.diag_code }) != AX_LINK_DUPLICATE_SYMBOL {
        return false;
    }

    // 3. Undefined symbol referenced by live root -> AX_LINK_UNDEFINED_SYMBOL (135)
    let g3 = lgc_graph_new(mut_view(*arena), true, false, false);
    let o3a = lgc_add_object(unsafe { mut_view(*g3) }, mut_view(*arena), s_a, 1u64);
    let u_root = lgc_emit_function_with_unwind(unsafe { mut_view(*g3) }, mut_view(*arena), o3a, sym_dup, sym_dup, LGC_BIND_GLOBAL, COMDAT_SELECT_NONE, 32u32, 1u64, 0u32, LGC_ROOT_ENTRY);
    lgc_add_reloc(unsafe { mut_view(*g3) }, mut_view(*arena), u_root, 4u32, LGC_RELOC_REL32, s_b, LGC_NONE_ID, 0);
    if lgc_run_pipeline(unsafe { mut_view(*g3) }, mut_view(*arena)) || (unsafe { (*g3).stats.diag_code }) != AX_LINK_UNDEFINED_SYMBOL {
        return false;
    }

    // 4. `--no-gc-sections` / `--kind lib` preserves unreferenced sections (`dead_stripped_sections == 0`)
    let g4 = lgc_graph_new(mut_view(*arena), true, false, true);
    let o4a = lgc_add_object(unsafe { mut_view(*g4) }, mut_view(*arena), s_a, 1u64);
    let _r4 = lgc_emit_function_with_unwind(unsafe { mut_view(*g4) }, mut_view(*arena), o4a, sym_dup, sym_dup, LGC_BIND_LOCAL, COMDAT_SELECT_NONE, 32u32, 1u64, 8u32, LGC_ROOT_NONE);
    if !lgc_run_pipeline(unsafe { mut_view(*g4) }, mut_view(*arena)) || (unsafe { (*g4).stats.dead_stripped_sections }) != 0u32 || (unsafe { (*g4).stats.retained_sections }) != 3u32 {
        return false;
    }

    // 5. COMDAT_SELECT_SAME_SIZE byte size mismatch -> AX_LINK_DUPLICATE_SYMBOL (136)
    let g5 = lgc_graph_new(mut_view(*arena), true, false, false);
    let o5a = lgc_add_object(unsafe { mut_view(*g5) }, mut_view(*arena), s_a, 1u64);
    let o5b = lgc_add_object(unsafe { mut_view(*g5) }, mut_view(*arena), s_b, 2u64);
    let _sm1 = lgc_emit_static_datum(unsafe { mut_view(*g5) }, mut_view(*arena), o5a, sym_dup, sym_dup, LGC_SEC_RDATA, 8u32, LGC_BIND_COMDAT, COMDAT_SELECT_SAME_SIZE, 24u32, 0x111u64, LGC_ROOT_USED);
    let _sm2 = lgc_emit_static_datum(unsafe { mut_view(*g5) }, mut_view(*arena), o5b, sym_dup, sym_dup, LGC_SEC_RDATA, 8u32, LGC_BIND_COMDAT, COMDAT_SELECT_SAME_SIZE, 32u32, 0x111u64, LGC_ROOT_NONE);
    if lgc_run_pipeline(unsafe { mut_view(*g5) }, mut_view(*arena)) || (unsafe { (*g5).stats.diag_code }) != AX_LINK_DUPLICATE_SYMBOL {
        return false;
    }

    // 6. COMDAT_SELECT_NODUPLICATES collision -> AX_LINK_DUPLICATE_SYMBOL (136)
    let g6 = lgc_graph_new(mut_view(*arena), true, false, false);
    let o6a = lgc_add_object(unsafe { mut_view(*g6) }, mut_view(*arena), s_a, 1u64);
    let o6b = lgc_add_object(unsafe { mut_view(*g6) }, mut_view(*arena), s_b, 2u64);
    let _nd1 = lgc_emit_function_with_unwind(unsafe { mut_view(*g6) }, mut_view(*arena), o6a, sym_dup, sym_dup, LGC_BIND_GLOBAL, COMDAT_SELECT_NODUPLICATES, 32u32, 1u64, 0u32, LGC_ROOT_ENTRY);
    let _nd2 = lgc_emit_function_with_unwind(unsafe { mut_view(*g6) }, mut_view(*arena), o6b, sym_dup, sym_dup, LGC_BIND_GLOBAL, COMDAT_SELECT_NODUPLICATES, 32u32, 1u64, 0u32, LGC_ROOT_NONE);
    if lgc_run_pipeline(unsafe { mut_view(*g6) }, mut_view(*arena)) || (unsafe { (*g6).stats.diag_code }) != AX_LINK_DUPLICATE_SYMBOL {
        return false;
    }

    // 7. W^X violation on a live section -> AX_LINK_WX_VIOLATION (155)
    let g7 = lgc_graph_new(mut_view(*arena), true, false, false);
    let o7a = lgc_add_object(unsafe { mut_view(*g7) }, mut_view(*arena), s_a, 1u64);
    let wx_sec = lgc_emit_function_with_unwind(unsafe { mut_view(*g7) }, mut_view(*arena), o7a, sym_dup, sym_dup, LGC_BIND_GLOBAL, COMDAT_SELECT_NONE, 32u32, 1u64, 0u32, LGC_ROOT_ENTRY);
    unsafe {
        let sp = lgc_sec_at((*g7).secs, wx_sec as usize);
        (*sp).characteristics = (*sp).characteristics | IMAGE_SCN_MEM_EXECUTE | IMAGE_SCN_MEM_WRITE;
    }
    if lgc_run_pipeline(unsafe { mut_view(*g7) }, mut_view(*arena)) || (unsafe { (*g7).stats.diag_code }) != AX_LINK_WX_VIOLATION {
        return false;
    }

    true
}

fn main() -> i32 {
    let mut arena = new_arena(524288);
    if !run_probe_archive_gc_roots_and_unwind(mut_view(arena)) {
        arena_destroy(mut_view(arena));
        return 1;
    }
    print("PROBE_ARCHIVE_GC_ROOTS_AND_UNWIND=OK\n");

    if !run_probe_comdat_generic_vtable_and_weak(mut_view(arena)) {
        arena_destroy(mut_view(arena));
        return 2;
    }
    print("PROBE_COMDAT_GENERIC_VTABLE_AND_WEAK=OK\n");

    if !run_probe_negative_diags_and_modes(mut_view(arena)) {
        arena_destroy(mut_view(arena));
        return 3;
    }
    print("PROBE_NEGATIVE_DIAGS_AND_MODES=OK\n");
    print("PROBE_LINK_SECTION_GC_ALL=PASS\n");
    arena_destroy(mut_view(arena));
    0
}
