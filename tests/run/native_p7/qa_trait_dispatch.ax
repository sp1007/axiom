// test: run
// exit: 0

trait Calculator {
    fn compute(self: view<Self>, a: i32) -> i32;
}

struct Multiplier {
    factor: i32,
}

impl Calculator for Multiplier {
    fn compute(self: view<Multiplier>, a: i32) -> i32 {
        return self.factor * a;
    }
}

fn main() -> i32 {
    let m = Multiplier { factor: 3 };
    let res = m.compute(10);
    if res != 30 { return 1; }
    return 0;
}
