// test: run
// modes: native
// reason: direct FFI is native-only (ADR-0002)
// stdout: OK MultiDll\n

@link("msvcrt")
extern "C" {
    fn abs(n: i32) -> i32;
    fn labs(n: i64) -> i64;
}

@link("kernel32")
extern "system" {
    fn GetCurrentProcessId() -> u32;
}

fn main() -> i32 {
    let a: i32 = unsafe { abs(-42i32) };
    let b: i64 = unsafe { labs(-100i64) };
    let pid: u32 = unsafe { GetCurrentProcessId() };

    if a != 42i32 {
        return 1;
    }
    if b != 100i64 {
        return 2;
    }
    if pid == 0 as u32 {
        return 3;
    }
    print("OK MultiDll\n");
    return 0;
}
