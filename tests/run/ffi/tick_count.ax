// test: run
// modes: native
// reason: direct FFI is native-only (ADR-0002)
// stdout: OK TickCount\n

@link("kernel32")
extern "system" {
    fn GetTickCount64() -> u64;
}

fn main() -> i32 {
    let t: u64 = unsafe { GetTickCount64() };
    if t == 0 as u64 {
        return 1;
    }
    print("OK TickCount\n");
    return 0;
}
