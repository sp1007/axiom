// test: run
// modes: native
// reason: direct FFI is native-only (ADR-0002)
// stdout: Xin chào thế giới\n

@link("kernel32")
extern "system" {
    fn GetStdHandle(nStdHandle: u32) -> *mut u8;
    fn WriteFile(hFile: *mut u8, lpBuffer: *const u8, nNumberOfBytesToWrite: u32, lpNumberOfBytesWritten: *mut u32, lpOverlapped: *mut u8) -> i32;
}

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

fn main() -> i32 {
    let msg: [23]u8 = [88 as u8, 105 as u8, 110 as u8, 32 as u8, 99 as u8, 104 as u8, 195 as u8, 160 as u8, 111 as u8, 32 as u8, 116 as u8, 104 as u8, 225 as u8, 186 as u8, 191 as u8, 32 as u8, 103 as u8, 105 as u8, 225 as u8, 187 as u8, 155 as u8, 105 as u8, 10 as u8];
    let mut written: u32 = 0 as u32;
    unsafe {
        let h = GetStdHandle(-11i32 as u32);
        let p = address_of(msg[0]);
        let pw = address_of_mut(written);
        WriteFile(h, p, 23 as u32, pw, 0 as *mut u8);
    }
    return 0;
}
