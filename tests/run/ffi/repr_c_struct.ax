// test: run
// modes: native
// reason: direct FFI is native-only (ADR-0002)
// stdout: OK ReprC\n

@repr(C)
struct SystemTime {
    year: u16,
    month: u16,
    day_of_week: u16,
    day: u16,
    hour: u16,
    minute: u16,
    second: u16,
    milliseconds: u16,
}

@link("kernel32")
extern "system" {
    fn GetSystemTime(lpSystemTime: *mut SystemTime);
}

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

fn main() -> i32 {
    let mut st = SystemTime {
        year: 0 as u16,
        month: 0 as u16,
        day_of_week: 0 as u16,
        day: 0 as u16,
        hour: 0 as u16,
        minute: 0 as u16,
        second: 0 as u16,
        milliseconds: 0 as u16,
    };
    unsafe {
        GetSystemTime(address_of_mut(st));
    }
    let year: u16 = st.year;
    let min_year: u16 = 2020 as u16;
    if (year < min_year) {
        return 1;
    }
    print("OK ReprC\n");
    return 0;
}
