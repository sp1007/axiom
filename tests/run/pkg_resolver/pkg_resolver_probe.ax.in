fn out_str(s: str) {
    let sv = ux2_sv(s)
    let _ = unsafe { write(stdio(1), sv.ptr, sv.len) }
}

fn out_bool(b: bool) {
    if b {
        out_str("true")
    } else {
        out_str("false")
    }
}

fn new_diag_sink() -> DiagSink {
    let mut sink = DiagSink {
        arena: (query_db_empty()).arena,
        diags: 0 as *mut compiler.diag.emitter.Diagnostic,
        len: 0,
        cap: 0,
        errors: 0,
        warnings: 0,
    }
    diag_sink_init(mut_view(sink))
    sink
}

fn parse_ver_must(s: str) -> SemVer2 {
    let mut v = semver2_zero()
    let _ = semver2_parse(ux2_sv(s), mut_view(v))
    v
}

fn check_constraint_eval(expr: str, cand_str: str) -> bool {
    let mut c = semver_constraint_empty()
    if !semver_constraint_parse(ux2_sv(expr), mut_view(c)) {
        return false
    }
    let v = parse_ver_must(cand_str)
    semver_constraint_matches(view(c), view(v))
}

fn run_semver2_probe() -> bool {
    let mut sink = new_diag_sink()
    let mut v1 = semver2_zero()
    let ok_v1 = semver2_parse_checked(ux2_sv("1.2.3-alpha.1.0+exp.sha.5114f85"), mut_view(v1), mut_view(sink))
    let mut fbuf = DiagBuffer { ptr: 0 as *mut u8, len: 0usize, cap: 0usize }
    diag_buf_init(mut_view(fbuf))
    semver2_format(view(v1), mut_view(fbuf))
    let parse_ok = ok_v1 &&
        sink.errors == 0usize &&
        v1.major == 1u64 &&
        v1.minor == 2u64 &&
        v1.patch == 3u64 &&
        v1.pre_token_count == 3usize &&
        v1.pre_token_is_num[1] &&
        v1.pre_token_num[1] == 1u64 &&
        v1.build_token_count == 3usize &&
        ux2_sv_eq(diag_buf_as_str_view(view(fbuf)), ux2_sv("1.2.3-alpha.1.0+exp.sha.5114f85"))
    diag_buf_free(mut_view(fbuf))

    // Malformed SemVer 2.0 rejection (`01.0.0`, `1.0.0-01`, `1.0.0+`, `1.0`) (`AXS-PKG-004 §1`)
    let mut bad_v = semver2_zero()
    let r_bad1 = !semver2_parse_checked(ux2_sv("01.0.0"), mut_view(bad_v), mut_view(sink))
    let r_bad2 = !semver2_parse_checked(ux2_sv("1.0.0-01"), mut_view(bad_v), mut_view(sink))
    let r_bad3 = !semver2_parse_checked(ux2_sv("1.0.0+"), mut_view(bad_v), mut_view(sink))
    let r_bad4 = !semver2_parse(ux2_sv("1.0"), mut_view(bad_v))
    let mut bad_c = semver_constraint_empty()
    let r_bad_c = !semver_constraint_parse_checked(ux2_sv("^1.2.0 ||"), mut_view(bad_c), mut_view(sink))
    let d0 = diag_sink_get(view(sink), 0usize)
    let invalid_rejected = r_bad1 && r_bad2 && r_bad3 && r_bad4 && r_bad_c &&
        sink.errors == 4usize &&
        d0.code.v == AX_DRIVER_BAD_MANIFEST &&
        ux2_sv_eq(manifest_diag_get_data(view(d0), ux2_sv("kind")), ux2_sv("semver"))

    // SemVer 2.0.0 §11 total precedence chain (`AXS-PKG-004 §2`):
    // 1.0.0-alpha < 1.0.0-alpha.1 < 1.0.0-alpha.beta < 1.0.0-beta < 1.0.0-beta.2 < 1.0.0-beta.11 < 1.0.0-rc.1 < 1.0.0
    let chain: [8]SemVer2 = [
        parse_ver_must("1.0.0-alpha"),
        parse_ver_must("1.0.0-alpha.1"),
        parse_ver_must("1.0.0-alpha.beta"),
        parse_ver_must("1.0.0-beta"),
        parse_ver_must("1.0.0-beta.2"),
        parse_ver_must("1.0.0-beta.11"),
        parse_ver_must("1.0.0-rc.1"),
        parse_ver_must("1.0.0"),
    ]
    let mut chain_ok = true
    let mut ci: usize = 0usize
    while ci < 7usize {
        if semver2_cmp_precedence(view(chain[ci]), view(chain[ci + 1usize])) >= 0i32 {
            chain_ok = false
        }
        if semver2_cmp_precedence(view(chain[ci + 1usize]), view(chain[ci])) <= 0i32 {
            chain_ok = false
        }
        ci = ci + 1usize
    }
    let vb1 = parse_ver_must("1.0.0+20130313144700")
    let vb2 = parse_ver_must("1.0.0+exp.sha.5114f85")
    let build_inv_ok = semver2_cmp_precedence(view(vb1), view(vb2)) == 0i32 &&
        semver2_cmp_total_tiebreak(view(vb1), view(vb2)) < 0i32

    let mut sort_arr: [16]SemVer2 = [semver2_zero(); 16]
    sort_arr[0] = chain[2]
    sort_arr[1] = chain[7]
    sort_arr[2] = chain[0]
    sort_arr[3] = chain[5]
    sort_semver2_candidates(mut_view(sort_arr), 4usize, false)
    let desc_ok = sort_arr[0].pre_token_count == 0usize &&
        ux2_sv_eq(sort_arr[1].prerelease, ux2_sv("beta.11")) &&
        ux2_sv_eq(sort_arr[3].prerelease, ux2_sv("alpha"))
    sort_semver2_candidates(mut_view(sort_arr), 4usize, true)
    let asc_ok = ux2_sv_eq(sort_arr[0].prerelease, ux2_sv("alpha")) &&
        sort_arr[3].pre_token_count == 0usize
    let precedence_ok = chain_ok && build_inv_ok && desc_ok && asc_ok

    // Constraint operators (`=`, `!=`, `^`, `~`, `<`, `<=`, `>`, `>=`, `*`, `1.*`, `1.2.x`, `,`, `||`) (`AXS-PKG-005`)
    let constraints_ok =
        check_constraint_eval("^1.2.3", "1.2.3") &&
        check_constraint_eval("^1.2.3", "1.9.0") &&
        !check_constraint_eval("^1.2.3", "2.0.0") &&
        !check_constraint_eval("^1.2.3", "1.2.2") &&
        check_constraint_eval("^0.2.3", "0.2.9") &&
        !check_constraint_eval("^0.2.3", "0.3.0") &&
        check_constraint_eval("^0.0.3", "0.0.3") &&
        !check_constraint_eval("^0.0.3", "0.0.4") &&
        check_constraint_eval("~1.2.3", "1.2.9") &&
        !check_constraint_eval("~1.2.3", "1.3.0") &&
        check_constraint_eval("~1.2", "1.2.5") &&
        check_constraint_eval("1.*", "1.8.2") &&
        !check_constraint_eval("1.*", "2.0.0") &&
        check_constraint_eval("1.2.x", "1.2.9") &&
        !check_constraint_eval("1.2.x", "1.3.0") &&
        check_constraint_eval("*", "0.1.0") &&
        check_constraint_eval(">=1.2.0, <1.5.0, !=1.3.2", "1.4.0") &&
        !check_constraint_eval(">=1.2.0, <1.5.0, !=1.3.2", "1.3.2") &&
        check_constraint_eval("^1.2.0 || ^2.0.0", "2.3.1") &&
        !check_constraint_eval("^1.2.0 || ^2.0.0", "3.0.0")

    // Pre-release isolation rule (`AXS-PKG-005 §6`, `1065 §9`)
    let prerelease_isolation_ok =
        !check_constraint_eval("^1.0.0", "1.0.0-alpha.1") &&
        !check_constraint_eval("*", "1.0.0-alpha.1") &&
        check_constraint_eval("^1.0.0-alpha.1", "1.0.0-alpha.2") &&
        check_constraint_eval("^1.0.0-alpha.1", "1.0.0-beta.1") &&
        check_constraint_eval("^1.0.0-alpha.1", "1.0.0") &&
        check_constraint_eval("^1.0.0-alpha.1", "1.2.0") &&
        !check_constraint_eval("^1.0.0-alpha.1", "1.1.0-alpha.1") &&
        !check_constraint_eval("^1.0.0-alpha.1", "2.0.0-alpha.1")

    out_str("probe[semver2] parse_ok=")
    out_bool(parse_ok)
    out_str(" invalid_rejected=")
    out_bool(invalid_rejected)
    out_str(" precedence_ok=")
    out_bool(precedence_ok)
    out_str(" constraints_ok=")
    out_bool(constraints_ok)
    out_str(" prerelease_isolation_ok=")
    out_bool(prerelease_isolation_ok)
    out_str("\n")

    diag_sink_free(mut_view(sink))
    parse_ok && invalid_rejected && precedence_ok && constraints_ok && prerelease_isolation_ok
}

fn build_pubgrub_candidate_pool(reverse_order: bool, include_net_120: bool) -> [24]PkgCandidateManifest {
    let mut pool: [24]PkgCandidateManifest = [pkg_candidate_empty(); 24]

    let mut root = pkg_candidate_new(
        ux2_sv("default"),
        ux2_sv("app"),
        semver2_from_u32(0u32, 1u32, 0u32),
        PKG_SOURCE_WORKSPACE,
        ux2_sv("crates/app"),
        true
    )
    let d_net = pkg_dep_spec_new(ux2_sv("net_http"), ux2_sv("default"), ux2_sv("net_http"), ux2_sv("^1.0.0"), DEP_SCOPE_NORMAL)
    let d_tls = pkg_dep_spec_new(ux2_sv("tls_core"), ux2_sv("default"), ux2_sv("tls_core"), ux2_sv(">=1.1.0, <1.3.0"), DEP_SCOPE_NORMAL)
    if reverse_order {
        pkg_candidate_add_dep(mut_view(root), d_tls)
        pkg_candidate_add_dep(mut_view(root), d_net)
    } else {
        pkg_candidate_add_dep(mut_view(root), d_net)
        pkg_candidate_add_dep(mut_view(root), d_tls)
    }

    // `net_http@1.3.0` requires `tls_core >=1.4.0` (conflicts with `app@0.1.0`'s `>=1.1.0, <1.3.0`)
    let mut net_130 = pkg_candidate_new(
        ux2_sv("default"),
        ux2_sv("net_http"),
        semver2_from_u32(1u32, 3u32, 0u32),
        PKG_SOURCE_REGISTRY,
        ux2_sv("https://user:secret_token@registry.axiom.dev/index"),
        false
    )
    pkg_candidate_add_dep(
        mut_view(net_130),
        pkg_dep_spec_new(ux2_sv("tls_core"), ux2_sv("default"), ux2_sv("tls_core"), ux2_sv(">=1.4.0"), DEP_SCOPE_NORMAL)
    )

    // `net_http@1.2.0` requires `tls_core ^1.2.0` (compatible with `tls_core@1.2.0` and `tls_core@1.2.5`)
    let mut net_120 = pkg_candidate_new(
        ux2_sv("default"),
        ux2_sv("net_http"),
        semver2_from_u32(1u32, 2u32, 0u32),
        PKG_SOURCE_REGISTRY,
        ux2_sv("https://registry.axiom.dev/index"),
        false
    )
    pkg_candidate_add_dep(
        mut_view(net_120),
        pkg_dep_spec_new(ux2_sv("tls_core"), ux2_sv("default"), ux2_sv("tls_core"), ux2_sv("^1.2.0"), DEP_SCOPE_NORMAL)
    )

    let tls_140 = pkg_candidate_new(ux2_sv("default"), ux2_sv("tls_core"), semver2_from_u32(1u32, 4u32, 0u32), PKG_SOURCE_REGISTRY, ux2_sv("default"), false)
    let mut tls_129_yanked = pkg_candidate_new(ux2_sv("default"), ux2_sv("tls_core"), semver2_from_u32(1u32, 2u32, 9u32), PKG_SOURCE_REGISTRY, ux2_sv("default"), false)
    tls_129_yanked.yanked = true
    let tls_125 = pkg_candidate_new(ux2_sv("default"), ux2_sv("tls_core"), semver2_from_u32(1u32, 2u32, 5u32), PKG_SOURCE_REGISTRY, ux2_sv("default"), false)
    let tls_120 = pkg_candidate_new(ux2_sv("default"), ux2_sv("tls_core"), semver2_from_u32(1u32, 2u32, 0u32), PKG_SOURCE_REGISTRY, ux2_sv("default"), false)
    let tls_110 = pkg_candidate_new(ux2_sv("default"), ux2_sv("tls_core"), semver2_from_u32(1u32, 1u32, 0u32), PKG_SOURCE_REGISTRY, ux2_sv("default"), false)

    if !include_net_120 {
        pool[0] = root
        pool[1] = net_130
        pool[2] = tls_140
        pool[3] = tls_125
        pool[4] = tls_120
        pool[5] = tls_110
        return pool
    }

    if reverse_order {
        pool[0] = tls_110
        pool[1] = tls_120
        pool[2] = tls_125
        pool[3] = tls_129_yanked
        pool[4] = tls_140
        pool[5] = net_120
        pool[6] = net_130
        pool[7] = root
    } else {
        pool[0] = root
        pool[1] = net_130
        pool[2] = net_120
        pool[3] = tls_140
        pool[4] = tls_129_yanked
        pool[5] = tls_125
        pool[6] = tls_120
        pool[7] = tls_110
    }
    pool
}

fn run_pubgrub_resolver_probe() -> bool {
    let mut sink = new_diag_sink()
    let pool_a = build_pubgrub_candidate_pool(false, true)
    let pool_b = build_pubgrub_candidate_pool(true, true)
    let empty_locks: [16]LockedPkgPin = [locked_pkg_pin_empty(); 16]

    let mut pol_a = pkg_resolver_policy_default()
    pol_a.host_workspace_root = ux2_sv("C:/work/alpha_checkout")
    let mut pol_b = pol_a
    pol_b.host_workspace_root = ux2_sv("/home/ci/beta_checkout")

    let mut g_a = resolved_package_graph_empty()
    let mut g_b = resolved_package_graph_empty()
    let ok_a = resolve_package_graph(view(pool_a), 8usize, view(empty_locks), 0usize, view(pol_a), mut_view(g_a), mut_view(sink))
    let ok_b = resolve_package_graph(view(pool_b), 8usize, view(empty_locks), 0usize, view(pol_b), mut_view(g_b), mut_view(sink))

    let mut net_idx: usize = 0usize
    let mut tls_idx: usize = 0usize
    let found_bt = find_resolved_pkg_node(view(g_a), ux2_sv("default"), ux2_sv("net_http"), 1u64, ENV_CLASS_TARGET, mut_view(net_idx)) &&
        find_resolved_pkg_node(view(g_a), ux2_sv("default"), ux2_sv("tls_core"), 1u64, ENV_CLASS_TARGET, mut_view(tls_idx))
    // Backtracked from `net_http@1.3.0` to `1.2.0` and selected `tls_core@1.2.5` (skipping yanked `1.2.9`)
    let backtrack_ok = ok_a && found_bt &&
        g_a.nodes[net_idx].identity.version.minor == 2u64 &&
        g_a.nodes[tls_idx].identity.version.minor == 2u64 &&
        g_a.nodes[tls_idx].identity.version.patch == 5u64 &&
        !ux2_sv_contains(g_a.nodes[net_idx].identity.source_id, ux2_sv("secret_token"))

    // Lockfile-preferring resolution (`AXS-PKG-011 §2`): lock `tls_core@1.2.0`
    let mut locks: [16]LockedPkgPin = [locked_pkg_pin_empty(); 16]
    locks[0].namespace = ux2_sv("default")
    locks[0].name = ux2_sv("tls_core")
    locks[0].version = semver2_from_u32(1u32, 2u32, 0u32)
    let mut g_lock = resolved_package_graph_empty()
    let ok_lock = resolve_package_graph(view(pool_a), 8usize, view(locks), 1usize, view(pol_a), mut_view(g_lock), mut_view(sink))
    let mut tls_lock_idx: usize = 0usize
    let lock_pref_ok = ok_lock &&
        find_resolved_pkg_node(view(g_lock), ux2_sv("default"), ux2_sv("tls_core"), 1u64, ENV_CLASS_TARGET, mut_view(tls_lock_idx)) &&
        g_lock.nodes[tls_lock_idx].identity.version.patch == 0u64

    // `--minimal-versions` + `[patch]` override provenance (`AXS-PKG-011 §3`, `AXS-PKG-013 §2`)
    let mut pol_min = pol_a
    pol_min.minimal_versions = true
    let mut patch = patch_override_empty()
    patch.namespace = ux2_sv("default")
    patch.name = ux2_sv("tls_core")
    patch.version = semver2_from_u32(1u32, 2u32, 0u32)
    patch.replacement_source_kind = PKG_SOURCE_PATH
    patch.replacement_source_coord = ux2_sv("C:/work/alpha_checkout/patches/tls_core")
    pol_min.patches[0] = patch
    pol_min.patch_count = 1usize
    let mut g_min = resolved_package_graph_empty()
    let ok_min = resolve_package_graph(view(pool_a), 8usize, view(empty_locks), 0usize, view(pol_min), mut_view(g_min), mut_view(sink))
    let mut tls_min_idx: usize = 0usize
    let minimal_ok = ok_min &&
        find_resolved_pkg_node(view(g_min), ux2_sv("default"), ux2_sv("tls_core"), 1u64, ENV_CLASS_TARGET, mut_view(tls_min_idx)) &&
        g_min.nodes[tls_min_idx].identity.version.patch == 0u64 &&
        g_min.applied_patch_count == 1usize &&
        ux2_sv_eq(g_min.nodes[tls_min_idx].identity.source_id, ux2_sv("patches/tls_core"))

    // Order-invariance (`REQ-PKG-022`, `AXS-PKG-010`, `PKG-INV-01`)
    let mut sum_a = DiagBuffer { ptr: 0 as *mut u8, len: 0usize, cap: 0usize }
    let mut sum_b = DiagBuffer { ptr: 0 as *mut u8, len: 0usize, cap: 0usize }
    diag_buf_init(mut_view(sum_a))
    diag_buf_init(mut_view(sum_b))
    render_resolved_pkg_graph_summary(view(g_a), mut_view(sum_a))
    render_resolved_pkg_graph_summary(view(g_b), mut_view(sum_b))
    let order_invariant = ok_a && ok_b &&
        digest256_eq(g_a.graph_hash, g_b.graph_hash) &&
        ux2_sv_eq(diag_buf_as_str_view(view(sum_a)), diag_buf_as_str_view(view(sum_b)))
    diag_buf_free(mut_view(sum_b))
    diag_buf_free(mut_view(sum_a))

    // Unsatisfiable conflict derivation tree (`AXS-PKG-012`, `AXS-PKG-052 §1`)
    let pool_conf = build_pubgrub_candidate_pool(false, false)
    let mut sink_conf = new_diag_sink()
    let mut g_conf = resolved_package_graph_empty()
    let conf_failed = !resolve_package_graph(view(pool_conf), 6usize, view(empty_locks), 0usize, view(pol_a), mut_view(g_conf), mut_view(sink_conf))
    let d_conf = diag_sink_get(view(sink_conf), 0usize)
    let step_cnt = resolver_diag_get_list_count(view(d_conf), ux2_sv("derivation_chain"))
    let step0 = resolver_diag_get_list_item(view(d_conf), ux2_sv("derivation_chain"), 0usize)
    let step1 = resolver_diag_get_list_item(view(d_conf), ux2_sv("derivation_chain"), 1usize)
    let conflict_tree_ok = conf_failed &&
        sink_conf.errors == 1usize &&
        g_conf.conflict.has_conflict &&
        d_conf.code.v == AX_DRIVER_BAD_MANIFEST &&
        ux2_sv_eq(manifest_diag_get_data(view(d_conf), ux2_sv("kind")), ux2_sv("version_conflict")) &&
        ux2_sv_eq(manifest_diag_get_data(view(d_conf), ux2_sv("package")), ux2_sv("default/tls_core")) &&
        step_cnt == 2usize &&
        ux2_sv_eq(step0, ux2_sv("app@0.1.0 requires net_http ^1.0.0 -> net_http@1.3.0 requires tls_core >=1.4.0")) &&
        ux2_sv_eq(step1, ux2_sv("app@0.1.0 requires tls_core >=1.1.0, <1.3.0"))

    // Negative edge cases: `unpinned_vcs`, `path_traversal`, `package_cycle` (`AXS-PKG-003 §2`, `AXS-PKG-013 §1`)
    let mut pool_vcs: [24]PkgCandidateManifest = [pkg_candidate_empty(); 24]
    pool_vcs[0] = pkg_candidate_new(ux2_sv("default"), ux2_sv("app"), semver2_from_u32(0u32, 1u32, 0u32), PKG_SOURCE_WORKSPACE, ux2_sv("crates/app"), true)
    let mut d_vcs = pkg_dep_spec_new(ux2_sv("git_dep"), ux2_sv("default"), ux2_sv("git_dep"), ux2_sv("^0.1.0"), DEP_SCOPE_NORMAL)
    d_vcs.source_kind = PKG_SOURCE_VCS_COMMIT
    d_vcs.source_coord = ux2_sv("https://example.com/git_dep.git")
    d_vcs.vcs_rev = ux2_sv("main")
    pkg_candidate_add_dep(mut_view(pool_vcs[0]), d_vcs)
    let mut sink_vcs = new_diag_sink()
    let mut g_vcs = resolved_package_graph_empty()
    let vcs_rej = !resolve_package_graph(view(pool_vcs), 1usize, view(empty_locks), 0usize, view(pol_a), mut_view(g_vcs), mut_view(sink_vcs))
    let d_v = diag_sink_get(view(sink_vcs), 0usize)
    let vcs_ok = vcs_rej && ux2_sv_eq(manifest_diag_get_data(view(d_v), ux2_sv("kind")), ux2_sv("unpinned_vcs"))

    let mut pool_trav: [24]PkgCandidateManifest = [pkg_candidate_empty(); 24]
    pool_trav[0] = pkg_candidate_new(ux2_sv("default"), ux2_sv("app"), semver2_from_u32(0u32, 1u32, 0u32), PKG_SOURCE_WORKSPACE, ux2_sv("crates/app"), true)
    let mut d_trav = pkg_dep_spec_new(ux2_sv("esc"), ux2_sv("default"), ux2_sv("esc"), ux2_sv("^0.1.0"), DEP_SCOPE_NORMAL)
    d_trav.source_kind = PKG_SOURCE_PATH
    d_trav.source_coord = ux2_sv("../outside_root")
    pkg_candidate_add_dep(mut_view(pool_trav[0]), d_trav)
    let mut sink_trav = new_diag_sink()
    let mut g_trav = resolved_package_graph_empty()
    let trav_rej = !resolve_package_graph(view(pool_trav), 1usize, view(empty_locks), 0usize, view(pol_a), mut_view(g_trav), mut_view(sink_trav))
    let d_t = diag_sink_get(view(sink_trav), 0usize)
    let trav_ok = trav_rej && ux2_sv_eq(manifest_diag_get_data(view(d_t), ux2_sv("kind")), ux2_sv("path_traversal"))

    let mut pool_cyc: [24]PkgCandidateManifest = [pkg_candidate_empty(); 24]
    pool_cyc[0] = pkg_candidate_new(ux2_sv("default"), ux2_sv("alpha"), semver2_from_u32(0u32, 1u32, 0u32), PKG_SOURCE_WORKSPACE, ux2_sv("crates/alpha"), true)
    pkg_candidate_add_dep(mut_view(pool_cyc[0]), pkg_dep_spec_new(ux2_sv("beta"), ux2_sv("default"), ux2_sv("beta"), ux2_sv("^0.1.0"), DEP_SCOPE_NORMAL))
    pool_cyc[1] = pkg_candidate_new(ux2_sv("default"), ux2_sv("beta"), semver2_from_u32(0u32, 1u32, 0u32), PKG_SOURCE_WORKSPACE, ux2_sv("crates/beta"), true)
    pkg_candidate_add_dep(mut_view(pool_cyc[1]), pkg_dep_spec_new(ux2_sv("alpha"), ux2_sv("default"), ux2_sv("alpha"), ux2_sv("^0.1.0"), DEP_SCOPE_NORMAL))
    let mut sink_cyc = new_diag_sink()
    let mut g_cyc = resolved_package_graph_empty()
    let cyc_rej = !resolve_package_graph(view(pool_cyc), 2usize, view(empty_locks), 0usize, view(pol_a), mut_view(g_cyc), mut_view(sink_cyc))
    let d_c = diag_sink_get(view(sink_cyc), 0usize)
    let cyc_ok = cyc_rej &&
        ux2_sv_eq(manifest_diag_get_data(view(d_c), ux2_sv("kind")), ux2_sv("package_cycle")) &&
        ux2_sv_eq(manifest_diag_get_data(view(d_c), ux2_sv("cycle")), ux2_sv("alpha -> beta -> alpha"))
    let negative_edges_ok = vcs_ok && trav_ok && cyc_ok

    out_str("probe[pubgrub_resolver] backtrack_ok=")
    out_bool(backtrack_ok)
    out_str(" lock_pref_ok=")
    out_bool(lock_pref_ok)
    out_str(" minimal_ok=")
    out_bool(minimal_ok)
    out_str(" order_invariant=")
    out_bool(order_invariant)
    out_str(" conflict_tree_ok=")
    out_bool(conflict_tree_ok)
    out_str(" negative_edges_ok=")
    out_bool(negative_edges_ok)
    out_str("\n")

    diag_sink_free(mut_view(sink_cyc))
    diag_sink_free(mut_view(sink_trav))
    diag_sink_free(mut_view(sink_vcs))
    diag_sink_free(mut_view(sink_conf))
    diag_sink_free(mut_view(sink))

    backtrack_ok && lock_pref_ok && minimal_ok && order_invariant && conflict_tree_ok && negative_edges_ok
}

fn build_isolation_and_feature_pool(reverse_order: bool, dev_api_seed: u64) -> [24]PkgCandidateManifest {
    let mut pool: [24]PkgCandidateManifest = [pkg_candidate_empty(); 24]

    // `math@1.4.2` with features `default = []`, `simd = []`, `host_tables = []`, `software_only` (conflicts with `simd`)
    let mut math_v1 = pkg_candidate_new(
        ux2_sv("default"),
        ux2_sv("math"),
        semver2_from_u32(1u32, 4u32, 2u32),
        PKG_SOURCE_REGISTRY,
        ux2_sv("default"),
        false
    )
    math_v1.public_api_seed = 0x1111222233334444u64
    pkg_candidate_add_feature(mut_view(math_v1), ux2_sv("default"), ux2_sv_empty(), ux2_sv_empty(), ux2_sv_empty())
    pkg_candidate_add_feature(mut_view(math_v1), ux2_sv("simd"), ux2_sv_empty(), ux2_sv_empty(), ux2_sv("software_only"))
    pkg_candidate_add_feature(mut_view(math_v1), ux2_sv("host_tables"), ux2_sv_empty(), ux2_sv_empty(), ux2_sv_empty())
    pkg_candidate_add_feature(mut_view(math_v1), ux2_sv("software_only"), ux2_sv_empty(), ux2_sv_empty(), ux2_sv("simd"))

    // `math@2.0.1` (incompatible major track `MajorTrack(2)`)
    let mut math_v2 = pkg_candidate_new(
        ux2_sv("default"),
        ux2_sv("math"),
        semver2_from_u32(2u32, 0u32, 1u32),
        PKG_SOURCE_REGISTRY,
        ux2_sv("default"),
        false
    )
    math_v2.public_api_seed = 0x5555666677778888u64
    pkg_candidate_add_feature(mut_view(math_v2), ux2_sv("default"), ux2_sv_empty(), ux2_sv_empty(), ux2_sv_empty())
    pkg_candidate_add_feature(mut_view(math_v2), ux2_sv("avx512"), ux2_sv_empty(), ux2_sv_empty(), ux2_sv_empty())

    // `physics@1.0.0` depends on `math ^2.0.0` with `public = true` (`pub use` bridge) and ` math_priv ^1.0.0` with `public = false`
    let mut physics = pkg_candidate_new(
        ux2_sv("default"),
        ux2_sv("physics"),
        semver2_from_u32(1u32, 0u32, 0u32),
        PKG_SOURCE_REGISTRY,
        ux2_sv("default"),
        false
    )
    physics.public_api_seed = 0xAAAABBBBCCCCDDDDu64
    let mut d_phys_math2 = pkg_dep_spec_new(ux2_sv("math"), ux2_sv("default"), ux2_sv("math"), ux2_sv("^2.0.0"), DEP_SCOPE_NORMAL)
    d_phys_math2.is_public = true
    d_phys_math2.features[0] = ux2_sv("avx512")
    d_phys_math2.feature_count = 1usize
    let d_phys_math1_priv = pkg_dep_spec_new(ux2_sv("math_priv"), ux2_sv("default"), ux2_sv("math"), ux2_sv("^1.0.0"), DEP_SCOPE_NORMAL)
    pkg_candidate_add_dep(mut_view(physics), d_phys_math2)
    pkg_candidate_add_dep(mut_view(physics), d_phys_math1_priv)

    // `codegen_tool@1.0.0` (`[build-dependencies]` -> `Host` environment) depends on `math ^1.0.0` with `host_tables`
    let mut codegen = pkg_candidate_new(
        ux2_sv("default"),
        ux2_sv("codegen_tool"),
        semver2_from_u32(1u32, 0u32, 0u32),
        PKG_SOURCE_REGISTRY,
        ux2_sv("default"),
        false
    )
    let mut d_cg_math = pkg_dep_spec_new(ux2_sv("math"), ux2_sv("default"), ux2_sv("math"), ux2_sv("^1.0.0"), DEP_SCOPE_NORMAL)
    d_cg_math.features[0] = ux2_sv("host_tables")
    d_cg_math.feature_count = 1usize
    pkg_candidate_add_dep(mut_view(codegen), d_cg_math)

    // `serde_json@1.0.0` (optional dependency of `app`)
    let serde_json = pkg_candidate_new(
        ux2_sv("default"),
        ux2_sv("serde_json"),
        semver2_from_u32(1u32, 0u32, 0u32),
        PKG_SOURCE_REGISTRY,
        ux2_sv("default"),
        false
    )

    // `bench_harness@0.1.0` (`[dev-dependencies]` of `app`)
    let mut bench_h = pkg_candidate_new(
        ux2_sv("default"),
        ux2_sv("bench_harness"),
        semver2_from_u32(0u32, 1u32, 0u32),
        PKG_SOURCE_REGISTRY,
        ux2_sv("default"),
        false
    )
    bench_h.public_api_seed = dev_api_seed

    // Workspace root `app@0.1.0`
    let mut app = pkg_candidate_new(
        ux2_sv("default"),
        ux2_sv("app"),
        semver2_from_u32(0u32, 1u32, 0u32),
        PKG_SOURCE_WORKSPACE,
        ux2_sv("crates/app"),
        true
    )
    pkg_candidate_add_feature(mut_view(app), ux2_sv("default"), ux2_sv("fast_vec"), ux2_sv_empty(), ux2_sv_empty())
    pkg_candidate_add_feature(mut_view(app), ux2_sv("fast_vec"), ux2_sv("math_v1/simd"), ux2_sv_empty(), ux2_sv_empty())
    pkg_candidate_add_feature(mut_view(app), ux2_sv("json_report"), ux2_sv("dep:serde_json"), ux2_sv_empty(), ux2_sv_empty())
    pkg_candidate_add_feature(mut_view(app), ux2_sv("bad_dep_feat"), ux2_sv("dep:nonexistent_opt"), ux2_sv_empty(), ux2_sv_empty())
    pkg_candidate_add_feature(mut_view(app), ux2_sv("conflict_math"), ux2_sv("math_v1/software_only"), ux2_sv_empty(), ux2_sv_empty())

    let d_app_m1 = pkg_dep_spec_new(ux2_sv("math_v1"), ux2_sv("default"), ux2_sv("math"), ux2_sv("^1.0.0"), DEP_SCOPE_NORMAL)
    let d_app_phys = pkg_dep_spec_new(ux2_sv("physics"), ux2_sv("default"), ux2_sv("physics"), ux2_sv("^1.0.0"), DEP_SCOPE_NORMAL)
    let mut d_app_json = pkg_dep_spec_new(ux2_sv("serde_json"), ux2_sv("default"), ux2_sv("serde_json"), ux2_sv("^1.0.0"), DEP_SCOPE_NORMAL)
    d_app_json.optional = true
    let d_app_cg = pkg_dep_spec_new(ux2_sv("codegen_tool"), ux2_sv("default"), ux2_sv("codegen_tool"), ux2_sv("^1.0.0"), DEP_SCOPE_BUILD)
    let d_app_dev = pkg_dep_spec_new(ux2_sv("bench_harness"), ux2_sv("default"), ux2_sv("bench_harness"), ux2_sv("^0.1.0"), DEP_SCOPE_DEV)

    if reverse_order {
        pkg_candidate_add_dep(mut_view(app), d_app_dev)
        pkg_candidate_add_dep(mut_view(app), d_app_cg)
        pkg_candidate_add_dep(mut_view(app), d_app_json)
        pkg_candidate_add_dep(mut_view(app), d_app_phys)
        pkg_candidate_add_dep(mut_view(app), d_app_m1)
        pool[0] = bench_h
        pool[1] = serde_json
        pool[2] = codegen
        pool[3] = physics
        pool[4] = math_v2
        pool[5] = math_v1
        pool[6] = app
    } else {
        pkg_candidate_add_dep(mut_view(app), d_app_m1)
        pkg_candidate_add_dep(mut_view(app), d_app_phys)
        pkg_candidate_add_dep(mut_view(app), d_app_json)
        pkg_candidate_add_dep(mut_view(app), d_app_cg)
        pkg_candidate_add_dep(mut_view(app), d_app_dev)
        pool[0] = app
        pool[1] = math_v1
        pool[2] = math_v2
        pool[3] = physics
        pool[4] = codegen
        pool[5] = serde_json
        pool[6] = bench_h
    }
    pool
}

fn run_isolation_and_features_probe() -> bool {
    let mut sink = new_diag_sink()
    let empty_locks: [16]LockedPkgPin = [locked_pkg_pin_empty(); 16]
    let pool_a = build_isolation_and_feature_pool(false, 0x1111u64)
    let pool_b = build_isolation_and_feature_pool(true, 0x1111u64)
    let pool_dev = build_isolation_and_feature_pool(false, 0x9999u64)

    let mut pol_a = pkg_resolver_policy_default()
    pol_a.host_workspace_root = ux2_sv("C:/work/repo_a")
    pol_a.host_triple = ux2_sv("x86_64-windows")
    pol_a.target_triple = ux2_sv("x86_64-linux")
    pol_a.cli_features[0] = ux2_sv("json_report")
    pol_a.cli_feature_count = 1usize

    let mut pol_b = pol_a
    pol_b.host_workspace_root = ux2_sv("/opt/ci/repo_b")

    let mut pol_dev = pol_a
    pol_dev.include_dev_deps = true

    let mut g_a = resolved_package_graph_empty()
    let mut g_b = resolved_package_graph_empty()
    let mut g_dev = resolved_package_graph_empty()
    let ok_a = resolve_package_graph(view(pool_a), 7usize, view(empty_locks), 0usize, view(pol_a), mut_view(g_a), mut_view(sink))
    let ok_b = resolve_package_graph(view(pool_b), 7usize, view(empty_locks), 0usize, view(pol_b), mut_view(g_b), mut_view(sink))
    let ok_dev = resolve_package_graph(view(pool_dev), 7usize, view(empty_locks), 0usize, view(pol_dev), mut_view(g_dev), mut_view(sink))

    let mut m1_target_idx: usize = 0usize
    let mut m1_host_idx: usize = 0usize
    let mut m2_target_idx: usize = 0usize
    let mut phys_idx: usize = 0usize
    let mut app_idx: usize = 0usize
    let found_all =
        find_resolved_pkg_node(view(g_a), ux2_sv("default"), ux2_sv("math"), 1u64, ENV_CLASS_TARGET, mut_view(m1_target_idx)) &&
        find_resolved_pkg_node(view(g_a), ux2_sv("default"), ux2_sv("math"), 1u64, ENV_CLASS_HOST, mut_view(m1_host_idx)) &&
        find_resolved_pkg_node(view(g_a), ux2_sv("default"), ux2_sv("math"), 2u64, ENV_CLASS_TARGET, mut_view(m2_target_idx)) &&
        find_resolved_pkg_node(view(g_a), ux2_sv("default"), ux2_sv("physics"), 1u64, ENV_CLASS_TARGET, mut_view(phys_idx)) &&
        find_resolved_pkg_node(view(g_a), ux2_sv("default"), ux2_sv("app"), 0u64, ENV_CLASS_TARGET, mut_view(app_idx))

    let side_by_side_ok = ok_a && ok_b && ok_dev && found_all &&
        g_a.nodes[m1_target_idx].identity.package_id != g_a.nodes[m2_target_idx].identity.package_id &&
        g_a.nodes[m1_target_idx].identity.package_id != g_a.nodes[m1_host_idx].identity.package_id &&
        !digest256_eq(g_a.nodes[m1_target_idx].identity.identity_digest, g_a.nodes[m2_target_idx].identity.identity_digest)

    // Verify collision-free `_AXP_...` symbol mangling across `math@1.4.2` and `math@2.0.1` (`AXS-PKG-020 §2`)
    let mut sym1 = DiagBuffer { ptr: 0 as *mut u8, len: 0usize, cap: 0usize }
    let mut sym2 = DiagBuffer { ptr: 0 as *mut u8, len: 0usize, cap: 0usize }
    diag_buf_init(mut_view(sym1))
    diag_buf_init(mut_view(sym2))
    mangle_pkg_item_symbol(view(g_a.nodes[m1_target_idx].identity), ux2_sv("vec"), ux2_sv("Vec2"), mut_view(sym1))
    mangle_pkg_item_symbol(view(g_a.nodes[m2_target_idx].identity), ux2_sv("vec"), ux2_sv("Vec2"), mut_view(sym2))
    let sv_sym1 = diag_buf_as_str_view(view(sym1))
    let sv_sym2 = diag_buf_as_str_view(view(sym2))
    let mangling_disjoint = !ux2_sv_eq(sv_sym1, sv_sym2) &&
        ux2_sv_contains(sv_sym1, ux2_sv("_AXP_math_v1_4_2_")) &&
        ux2_sv_contains(sv_sym2, ux2_sv("_AXP_math_v2_0_1_"))
    diag_buf_free(mut_view(sym2))
    diag_buf_free(mut_view(sym1))

    // Singleton native `links` enforcement (`AXS-PKG-020 §3`, `AXS-PKG-052 §3`)
    let mut pool_links = pool_a
    pool_links[1].native_links = ux2_sv("libm_accel")
    pool_links[2].native_links = ux2_sv("libm_accel")
    let mut sink_links = new_diag_sink()
    let mut g_links = resolved_package_graph_empty()
    let links_failed = !resolve_package_graph(view(pool_links), 7usize, view(empty_locks), 0usize, view(pol_a), mut_view(g_links), mut_view(sink_links))
    let d_links = diag_sink_get(view(sink_links), 0usize)
    let links_singleton_ok = links_failed &&
        d_links.code.v == AX_DRIVER_BAD_MANIFEST &&
        ux2_sv_eq(manifest_diag_get_data(view(d_links), ux2_sv("kind")), ux2_sv("duplicate_native_links")) &&
        ux2_sv_eq(manifest_diag_get_data(view(d_links), ux2_sv("links")), ux2_sv("libm_accel"))

    // Nominal `TypeId` isolation (`AXS-PKG-021`, `AXS-PKG-052 §4`)
    let ty_v1 = mint_nominal_type_for_pkg(view(g_a), m1_target_idx, ux2_sv("vec"), ux2_sv("Vec2"))
    let ty_v2 = mint_nominal_type_for_pkg(view(g_a), m2_target_idx, ux2_sv("vec"), ux2_sv("Vec2"))
    let mut sink_ty = new_diag_sink()
    let ty_mismatch = !check_nominal_type_assignable(view(g_a), view(ty_v1), view(ty_v2), mut_view(sink_ty))
    let d_ty = diag_sink_get(view(sink_ty), 0usize)
    let nominal_type_isolation_ok = !nominal_type_eq(view(ty_v1), view(ty_v2)) &&
        ty_mismatch &&
        d_ty.code.v == AX_TYPE_MISMATCH &&
        ux2_sv_eq(manifest_diag_get_data(view(d_ty), ux2_sv("expected")), ux2_sv("math@1.4.2.Vec2")) &&
        ux2_sv_eq(manifest_diag_get_data(view(d_ty), ux2_sv("found")), ux2_sv("math@2.0.1.Vec2")) &&
        ux2_sv_eq(manifest_diag_get_data(view(d_ty), ux2_sv("reason")), ux2_sv("distinct_package_versions"))

    // `public = true` `pub use` re-export bridging (`AXS-PKG-022`)
    let mut bridged_ty = nominal_type_key_empty()
    let mut sink_re = new_diag_sink()
    let pub_bridge_ok = resolve_pub_use_reexport_type(
        view(g_a),
        phys_idx,
        ux2_sv("math"),
        ux2_sv("vec"),
        ux2_sv("Vec2"),
        mut_view(bridged_ty),
        mut_view(sink_re)
    )
    let priv_bridge_rejected = !resolve_pub_use_reexport_type(
        view(g_a),
        phys_idx,
        ux2_sv("math_priv"),
        ux2_sv("vec"),
        ux2_sv("Vec2"),
        mut_view(bridged_ty),
        mut_view(sink_re)
    )
    let reexport_bridge_ok = pub_bridge_ok &&
        priv_bridge_rejected &&
        check_nominal_type_assignable(view(g_a), view(ty_v2), view(bridged_ty), mut_view(sink_re))

    // Monotonic `Host` vs `Target` feature unification & negative feature diagnostics (`AXS-PKG-023`..`024`, `REQ-PKG-025`)
    let feat_split_ok =
        pkg_node_has_feature(view(g_a.nodes[m1_target_idx]), ux2_sv("simd")) &&
        !pkg_node_has_feature(view(g_a.nodes[m1_target_idx]), ux2_sv("host_tables")) &&
        pkg_node_has_feature(view(g_a.nodes[m1_host_idx]), ux2_sv("host_tables")) &&
        !pkg_node_has_feature(view(g_a.nodes[m1_host_idx]), ux2_sv("simd")) &&
        pkg_node_has_enabled_opt_dep(view(g_a.nodes[app_idx]), ux2_sv("serde_json"))

    let mut pol_unk = pol_a
    pol_unk.cli_features[0] = ux2_sv("undeclared_feat")
    pol_unk.cli_feature_count = 1usize
    let mut sink_unk = new_diag_sink()
    let mut g_unk = resolved_package_graph_empty()
    let unk_rej = !resolve_package_graph(view(pool_a), 7usize, view(empty_locks), 0usize, view(pol_unk), mut_view(g_unk), mut_view(sink_unk))
    let d_unk = diag_sink_get(view(sink_unk), 0usize)
    let unk_ok = unk_rej && ux2_sv_eq(manifest_diag_get_data(view(d_unk), ux2_sv("kind")), ux2_sv("unknown_feature"))

    let mut pol_miss = pol_a
    pol_miss.cli_features[0] = ux2_sv("bad_dep_feat")
    pol_miss.cli_feature_count = 1usize
    let mut sink_miss = new_diag_sink()
    let mut g_miss = resolved_package_graph_empty()
    let miss_rej = !resolve_package_graph(view(pool_a), 7usize, view(empty_locks), 0usize, view(pol_miss), mut_view(g_miss), mut_view(sink_miss))
    let d_miss = diag_sink_get(view(sink_miss), 0usize)
    let miss_ok = miss_rej && ux2_sv_eq(manifest_diag_get_data(view(d_miss), ux2_sv("kind")), ux2_sv("missing_required_feature"))

    let mut pol_fc = pol_a
    pol_fc.cli_features[0] = ux2_sv("conflict_math")
    pol_fc.cli_feature_count = 1usize
    let mut sink_fc = new_diag_sink()
    let mut g_fc = resolved_package_graph_empty()
    let fc_rej = !resolve_package_graph(view(pool_a), 7usize, view(empty_locks), 0usize, view(pol_fc), mut_view(g_fc), mut_view(sink_fc))
    let d_fc = diag_sink_get(view(sink_fc), 0usize)
    let fc_ok = fc_rej && ux2_sv_eq(manifest_diag_get_data(view(d_fc), ux2_sv("kind")), ux2_sv("feature_conflict"))

    let feature_unify_ok = feat_split_ok && unk_ok && miss_ok && fc_ok
    let inv_audit = verify_pkg_resolver_invariants(view(g_a), view(g_b), view(g_dev))

    out_str("probe[isolation_features] side_by_side_ok=")
    out_bool(side_by_side_ok)
    out_str(" mangling_disjoint=")
    out_bool(mangling_disjoint)
    out_str(" links_singleton_ok=")
    out_bool(links_singleton_ok)
    out_str(" nominal_type_isolation_ok=")
    out_bool(nominal_type_isolation_ok)
    out_str(" reexport_bridge_ok=")
    out_bool(reexport_bridge_ok)
    out_str(" feature_unify_ok=")
    out_bool(feature_unify_ok)
    out_str(" invariants_ok=")
    out_bool(inv_audit.all_passed)
    out_str("\n")

    diag_sink_free(mut_view(sink_fc))
    diag_sink_free(mut_view(sink_miss))
    diag_sink_free(mut_view(sink_unk))
    diag_sink_free(mut_view(sink_re))
    diag_sink_free(mut_view(sink_ty))
    diag_sink_free(mut_view(sink_links))
    diag_sink_free(mut_view(sink))

    side_by_side_ok && mangling_disjoint && links_singleton_ok &&
        nominal_type_isolation_ok && reexport_bridge_ok && feature_unify_ok && inv_audit.all_passed
}

pub fn main() -> i32 {
    let ok1 = run_semver2_probe()
    let ok2 = run_pubgrub_resolver_probe()
    let ok3 = run_isolation_and_features_probe()
    if !ok1 || !ok2 || !ok3 {
        return 1
    }
    out_str("PKG-RESOLVER-PROBE-PASS\n")
    0
}
