// test: run
// modes: interp native
// stdout-file: side_by_side_isolation_and_features.stdout
// SPEC-111 §3 (AXS-PKG-020..024, AXS-PKG-052..053; REQ-PKG-022, REQ-PKG-024, REQ-PKG-025, INV-PKG-001):
// Verifies side-by-side incompatible major version isolation (`math@1.4.2` vs `math@2.0.1`),
// disjoint symbol mangling and `TypeId`s (`distinct_package_versions`), `public = true` `pub use`
// re-export bridging, singleton native `links` enforcement, and `Host` vs `Target` feature isolation.

@derive(Copy)
struct VersionedPkgInstance {
    package_id: u32,
    major: u32,
    minor: u32,
    patch: u32,
    env_class: u8,     // 0 = Target, 1 = Host
    active_features: u32,
    native_links_id: u32,
}

@derive(Copy)
struct NominalTypeToken {
    origin_package_id: u32,
    item_def_id: u32,
    nominal_type_id: u64,
}

fn mint_nominal_type(pkg: VersionedPkgInstance, item_def_id: u32) -> NominalTypeToken {
    let tid = ((pkg.package_id as u64) << 32u64) ^ ((pkg.major as u64) << 16u64) ^ (item_def_id as u64)
    NominalTypeToken {
        origin_package_id: pkg.package_id,
        item_def_id: item_def_id,
        nominal_type_id: tid,
    }
}

fn mangle_symbol_hash(pkg: VersionedPkgInstance, item_def_id: u32) -> u64 {
    let mut h: u64 = 0xCBF29CE484222325u64
    let p_id = pkg.package_id as u64
    let maj = pkg.major as u64
    let min = pkg.minor as u64
    let pat = pkg.patch as u64
    let itm = item_def_id as u64
    h = (h ^ p_id) ^ (p_id << 7u64)
    h = (h ^ maj) ^ (maj << 13u64)
    h = (h ^ min) ^ (min << 19u64)
    h = (h ^ pat) ^ (pat << 23u64)
    h = (h ^ itm) ^ (itm << 29u64)
    h
}

fn bridge_pub_use_type(
    target_pkg: VersionedPkgInstance,
    item_def_id: u32,
    edge_is_public: bool,
    out_tok: mut_view<NominalTypeToken>
) -> bool {
    if !edge_is_public {
        return false
    }
    *out_tok = mint_nominal_type(target_pkg, item_def_id)
    true
}

fn has_duplicate_native_links(a: VersionedPkgInstance, b: VersionedPkgInstance) -> bool {
    a.native_links_id != 0u32 &&
        a.native_links_id == b.native_links_id &&
        a.env_class == b.env_class &&
        a.package_id != b.package_id
}

pub fn main() -> i32 {
    // 1. Side-by-side `math@1.4.2` (Target), `math@2.0.1` (Target), and `math@1.4.2` (Host)
    let math_v1_target = VersionedPkgInstance {
        package_id: 1u32,
        major: 1u32,
        minor: 4u32,
        patch: 2u32,
        env_class: 0u8,
        active_features: 1u32 | 2u32, // `default` + `simd`
        native_links_id: 0u32,
    }
    let math_v2_target = VersionedPkgInstance {
        package_id: 2u32,
        major: 2u32,
        minor: 0u32,
        patch: 1u32,
        env_class: 0u8,
        active_features: 1u32 | 4u32, // `default` + `avx512`
        native_links_id: 0u32,
    }
    let math_v1_host = VersionedPkgInstance {
        package_id: 3u32,
        major: 1u32,
        minor: 4u32,
        patch: 2u32,
        env_class: 1u8,
        active_features: 8u32,        // `host_tables` only (`AXS-PKG-023 §2`)
        native_links_id: 0u32,
    }

    // 2. Disjoint symbol mangling and nominal `TypeId` isolation (`AXS-PKG-020 §2`, `AXS-PKG-021`)
    let sym_v1 = mangle_symbol_hash(math_v1_target, 42u32)
    let sym_v2 = mangle_symbol_hash(math_v2_target, 42u32)
    let ty_v1 = mint_nominal_type(math_v1_target, 42u32)
    let ty_v2 = mint_nominal_type(math_v2_target, 42u32)
    if sym_v1 == sym_v2 || ty_v1.nominal_type_id == ty_v2.nominal_type_id {
        return 1
    }

    // 3. `public = true` `pub use` re-export preserves `TypeId` (`AXS-PKG-022`), while private edge is rejected
    let mut bridged = NominalTypeToken { origin_package_id: 0u32, item_def_id: 0u32, nominal_type_id: 0u64 }
    if bridge_pub_use_type(math_v2_target, 42u32, false, mut_view(bridged)) {
        return 2
    }
    if !bridge_pub_use_type(math_v2_target, 42u32, true, mut_view(bridged)) ||
        bridged.nominal_type_id != ty_v2.nominal_type_id {
        return 3
    }

    // 4. Singleton native `links` check (`AXS-PKG-020 §3`)
    let mut sys_a = math_v1_target
    let mut sys_b = math_v2_target
    sys_a.native_links_id = 77u32
    sys_b.native_links_id = 77u32
    if !has_duplicate_native_links(sys_a, sys_b) {
        return 4
    }

    // 5. `Host` vs `Target` feature isolation (`AXS-PKG-023 §2`, `REQ-PKG-025`)
    if (math_v1_target.active_features & 8u32) != 0u32 || (math_v1_host.active_features & 2u32) != 0u32 {
        return 5
    }

    print("SIDE-BY-SIDE-ISOLATION-AND-FEATURES-OK\n")
    0
}
