// test: run
// modes: interp native
// stdout-file: semver2_edge_cases_and_cycles.stdout
// SPEC-111 §§1..3 (AXS-PKG-004, AXS-PKG-005, AXS-PKG-013, AXS-PKG-021):
// QA regression test: verifies numeric vs alphanumeric SemVer 2.0 pre-release precedence,
// compound tilde/wildcard constraints, pre-release isolation boundaries, and cycle detection.

@derive(Copy)
struct SemVerItem {
    major: u32,
    minor: u32,
    patch: u32,
    has_pre: bool,
    pre_is_num: bool,
    pre_num: u32,
    pre_alpha_rank: u32,
    build_id: u32,
}

// SemVer 2.0.0 §11: Numeric identifiers always have lower precedence than non-numeric identifiers.
fn cmp_semver(a: SemVerItem, b: SemVerItem) -> i32 {
    if (a.major) < (b.major) {
        return -1i32
    }
    if (a.major) > (b.major) {
        return 1i32
    }
    if (a.minor) < (b.minor) {
        return -1i32
    }
    if (a.minor) > (b.minor) {
        return 1i32
    }
    if (a.patch) < (b.patch) {
        return -1i32
    }
    if (a.patch) > (b.patch) {
        return 1i32
    }
    if !a.has_pre && !b.has_pre {
        // Build metadata does not affect precedence
        return 0i32
    }
    if !a.has_pre && b.has_pre {
        return 1i32
    }
    if a.has_pre && !b.has_pre {
        return -1i32
    }
    // Both have pre-release: compare numeric vs alphanumeric
    if a.pre_is_num && !b.pre_is_num {
        // Numeric < alphanumeric (e.g., 1.0.0-1 < 1.0.0-alpha)
        return -1i32
    }
    if !a.pre_is_num && b.pre_is_num {
        return 1i32
    }
    if a.pre_is_num && b.pre_is_num {
        if (a.pre_num) < (b.pre_num) {
            return -1i32
        }
        if (a.pre_num) > (b.pre_num) {
            return 1i32
        }
        return 0i32
    }
    if (a.pre_alpha_rank) < (b.pre_alpha_rank) {
        return -1i32
    }
    if (a.pre_alpha_rank) > (b.pre_alpha_rank) {
        return 1i32
    }
    0i32
}

// Evaluates tilde constraint `~M.m.p`, `~M.m`, or `~M` (`AXS-PKG-005 §2`)
fn matches_tilde(major: u32, minor: u32, patch: u32, comp_count: u32, cand: SemVerItem) -> bool {
    if cand.has_pre {
        return false
    }
    if comp_count == 1u32 {
        // `~M`: matches M.0.0 <= cand < (M+1).0.0
        return cand.major == major
    }
    if comp_count == 2u32 {
        // `~M.m`: matches M.m.0 <= cand < M.(m+1).0
        return cand.major == major && cand.minor == minor
    }
    // `~M.m.p`: matches M.m.p <= cand < M.(m+1).0
    cand.major == major && cand.minor == minor && cand.patch >= patch
}

// Evaluates wildcard constraint `M.*` or `M.m.*` (`AXS-PKG-005 §4`)
fn matches_wildcard(major: u32, minor: u32, comp_count: u32, cand: SemVerItem) -> bool {
    if cand.has_pre {
        return false
    }
    if comp_count == 0u32 {
        // `*`: matches any stable version
        return true
    }
    if comp_count == 1u32 {
        // `M.*`: matches M.0.0 <= cand < (M+1).0.0
        return cand.major == major
    }
    // `M.m.*`: matches M.m.0 <= cand < M.(m+1).0
    cand.major == major && cand.minor == minor
}

// Evaluates caret with zero constraint `^0.0.p`, `^0.m.p`, `^M.m.p` (`AXS-PKG-005 §1`)
fn matches_caret(major: u32, minor: u32, patch: u32, cand: SemVerItem) -> bool {
    if cand.has_pre {
        return false
    }
    if major > 0u32 {
        return cand.major == major && (cand.minor > minor || (cand.minor == minor && cand.patch >= patch))
    }
    if minor > 0u32 {
        return cand.major == 0u32 && cand.minor == minor && cand.patch >= patch
    }
    cand.major == 0u32 && cand.minor == 0u32 && cand.patch == patch
}

// Simple DAG cycle detector for inter-package cycles (`AXS-PKG-013 §1`)
// Nodes 0..3: returns true if cycle exists
fn has_cycle_dfs(
    adj: view<[4][4]bool>,
    node: usize,
    state: mut_view<[4]u8>
) -> bool {
    (*state)[node] = 1u8 // visiting
    let mut next: usize = 0usize
    while next < 4usize {
        if (*adj)[node][next] {
            if (*state)[next] == 1u8 {
                return true // back-edge to visiting node -> cycle detected
            }
            if (*state)[next] == 0u8 {
                if has_cycle_dfs(adj, next, mut_view(*state)) {
                    return true
                }
            }
        }
        next = next + 1usize
    }
    (*state)[node] = 2u8 // visited
    false
}

fn check_graph_has_cycle(adj: view<[4][4]bool>) -> bool {
    let mut state: [4]u8 = [0u8; 4]
    let mut i: usize = 0usize
    while i < 4usize {
        if state[i] == 0u8 {
            if has_cycle_dfs(adj, i, mut_view(state)) {
                return true
            }
        }
        i = i + 1usize
    }
    false
}

pub fn main() -> i32 {
    // 1. SemVer 2.0 Numeric vs Alphanumeric Pre-Release Precedence (§11.4):
    // 1.0.0-1 < 1.0.0-2 < 1.0.0-10 < 1.0.0-alpha < 1.0.0-beta
    let v_pre_1 = SemVerItem { major: 1u32, minor: 0u32, patch: 0u32, has_pre: true, pre_is_num: true, pre_num: 1u32, pre_alpha_rank: 0u32, build_id: 0u32 }
    let v_pre_2 = SemVerItem { major: 1u32, minor: 0u32, patch: 0u32, has_pre: true, pre_is_num: true, pre_num: 2u32, pre_alpha_rank: 0u32, build_id: 0u32 }
    let v_pre_10 = SemVerItem { major: 1u32, minor: 0u32, patch: 0u32, has_pre: true, pre_is_num: true, pre_num: 10u32, pre_alpha_rank: 0u32, build_id: 0u32 }
    let v_pre_alpha = SemVerItem { major: 1u32, minor: 0u32, patch: 0u32, has_pre: true, pre_is_num: false, pre_num: 0u32, pre_alpha_rank: 1u32, build_id: 0u32 }
    let v_pre_beta = SemVerItem { major: 1u32, minor: 0u32, patch: 0u32, has_pre: true, pre_is_num: false, pre_num: 0u32, pre_alpha_rank: 2u32, build_id: 0u32 }

    if cmp_semver(v_pre_1, v_pre_2) >= 0i32 ||
        cmp_semver(v_pre_2, v_pre_10) >= 0i32 ||
        cmp_semver(v_pre_10, v_pre_alpha) >= 0i32 ||
        cmp_semver(v_pre_alpha, v_pre_beta) >= 0i32 {
        return 1
    }

    // 2. Tilde range evaluation (~M.m.p, ~M.m, ~M):
    let v_123 = SemVerItem { major: 1u32, minor: 2u32, patch: 3u32, has_pre: false, pre_is_num: false, pre_num: 0u32, pre_alpha_rank: 0u32, build_id: 0u32 }
    let v_129 = SemVerItem { major: 1u32, minor: 2u32, patch: 9u32, has_pre: false, pre_is_num: false, pre_num: 0u32, pre_alpha_rank: 0u32, build_id: 0u32 }
    let v_130 = SemVerItem { major: 1u32, minor: 3u32, patch: 0u32, has_pre: false, pre_is_num: false, pre_num: 0u32, pre_alpha_rank: 0u32, build_id: 0u32 }
    let v_200 = SemVerItem { major: 2u32, minor: 0u32, patch: 0u32, has_pre: false, pre_is_num: false, pre_num: 0u32, pre_alpha_rank: 0u32, build_id: 0u32 }

    // ~1.2.3 accepts 1.2.3 and 1.2.9, rejects 1.3.0
    if !matches_tilde(1u32, 2u32, 3u32, 3u32, v_123) ||
        !matches_tilde(1u32, 2u32, 3u32, 3u32, v_129) ||
        matches_tilde(1u32, 2u32, 3u32, 3u32, v_130) {
        return 2
    }
    // ~1.2 accepts 1.2.9 and 1.2.3, rejects 1.3.0
    if !matches_tilde(1u32, 2u32, 0u32, 2u32, v_129) ||
        matches_tilde(1u32, 2u32, 0u32, 2u32, v_130) {
        return 3
    }
    // ~1 accepts 1.3.0, rejects 2.0.0
    if !matches_tilde(1u32, 0u32, 0u32, 1u32, v_130) ||
        matches_tilde(1u32, 0u32, 0u32, 1u32, v_200) {
        return 4
    }

    // 3. Wildcard range evaluation (M.*, M.m.*):
    if !matches_wildcard(1u32, 2u32, 2u32, v_129) ||
        matches_wildcard(1u32, 2u32, 2u32, v_130) ||
        !matches_wildcard(1u32, 0u32, 1u32, v_130) ||
        matches_wildcard(1u32, 0u32, 1u32, v_200) {
        return 5
    }

    // 4. Caret 0.0.p vs 0.m.p vs M.m.p:
    let v_003 = SemVerItem { major: 0u32, minor: 0u32, patch: 3u32, has_pre: false, pre_is_num: false, pre_num: 0u32, pre_alpha_rank: 0u32, build_id: 0u32 }
    let v_004 = SemVerItem { major: 0u32, minor: 0u32, patch: 4u32, has_pre: false, pre_is_num: false, pre_num: 0u32, pre_alpha_rank: 0u32, build_id: 0u32 }
    // ^0.0.3 accepts only 0.0.3, rejects 0.0.4
    if !matches_caret(0u32, 0u32, 3u32, v_003) || matches_caret(0u32, 0u32, 3u32, v_004) {
        return 6
    }

    // 5. Inter-package cycle detection (AXS-PKG-013 §1):
    // Graph 1: 0 -> 1 -> 2 -> 3 (DAG, no cycle)
    let mut dag_adj: [4][4]bool = [
        [false, true, false, false],
        [false, false, true, false],
        [false, false, false, true],
        [false, false, false, false],
    ]
    if check_graph_has_cycle(view(dag_adj)) {
        return 7
    }

    // Graph 2: 0 -> 1 -> 2 -> 3 -> 1 (contains cycle 1 -> 2 -> 3 -> 1)
    let mut cyc_adj: [4][4]bool = [
        [false, true, false, false],
        [false, false, true, false],
        [false, false, false, true],
        [false, true, false, false],
    ]
    if !check_graph_has_cycle(view(cyc_adj)) {
        return 8
    }

    print("SEMVER2-EDGE-CASES-AND-CYCLES-OK\n")
    0
}
