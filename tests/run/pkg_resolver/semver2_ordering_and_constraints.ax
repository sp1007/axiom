// test: run
// modes: interp native
// stdout-file: semver2_ordering_and_constraints.stdout
// SPEC-111 §1 (AXS-PKG-004, AXS-PKG-005; REQ-PKG-022, REQ-PKG-024, REQ-ECO-8736):
// Verifies SemVer 2.0 total precedence ordering (including numeric vs alphanumeric pre-release
// identifiers and `+build` metadata invariance), caret/tilde/wildcard constraint evaluation,
// and the pre-release isolation rule (`1065 §9`).

@derive(Copy)
struct SemVerLite {
    major: u32,
    minor: u32,
    patch: u32,
    has_pre: bool,
    pre_alpha_rank: u32,
    pre_has_num: bool,
    pre_num: u32,
    build_id: u32,
}

fn cmp_semver_precedence(a: SemVerLite, b: SemVerLite) -> i32 {
    if (a.major) < (b.major) {
        return -1i32
    }
    if (a.major) > (b.major) {
        return 1i32
    }
    if (a.minor) < (b.minor) {
        return -1i32
    }
    if (a.minor) > (b.minor) {
        return 1i32
    }
    if (a.patch) < (b.patch) {
        return -1i32
    }
    if (a.patch) > (b.patch) {
        return 1i32
    }
    if !a.has_pre && !b.has_pre {
        // `+build` metadata (`build_id`) is invariant under SemVer 2.0 precedence (`AXS-PKG-004 §2`)
        return 0i32
    }
    if !a.has_pre && b.has_pre {
        return 1i32
    }
    if a.has_pre && !b.has_pre {
        return -1i32
    }
    if (a.pre_alpha_rank) < (b.pre_alpha_rank) {
        return -1i32
    }
    if (a.pre_alpha_rank) > (b.pre_alpha_rank) {
        return 1i32
    }
    if !a.pre_has_num && b.pre_has_num {
        return -1i32
    }
    if a.pre_has_num && !b.pre_has_num {
        return 1i32
    }
    if a.pre_has_num && b.pre_has_num {
        if (a.pre_num) < (b.pre_num) {
            return -1i32
        }
        if (a.pre_num) > (b.pre_num) {
            return 1i32
        }
    }
    0i32
}

// Evaluates caret constraint `^req` on candidate `cand` with Pre-Release Isolation (`AXS-PKG-005 §1 & §6`)
fn matches_caret_constraint(req: SemVerLite, cand: SemVerLite) -> bool {
    if cand.has_pre {
        if !req.has_pre ||
            req.major != cand.major ||
            req.minor != cand.minor ||
            req.patch != cand.patch {
            return false
        }
    }
    if cmp_semver_precedence(cand, req) < 0i32 {
        return false
    }
    if req.major > 0u32 {
        return cand.major == req.major
    }
    if req.minor > 0u32 {
        return cand.major == 0u32 && cand.minor == req.minor
    }
    cand.major == 0u32 && cand.minor == 0u32 && cand.patch == req.patch
}

pub fn main() -> i32 {
    // 1. SemVer 2.0 precedence: 1.0.0-alpha < 1.0.0-alpha.1 < 1.0.0-beta.2 < 1.0.0-beta.11 < 1.0.0
    let v_alpha = SemVerLite { major: 1u32, minor: 0u32, patch: 0u32, has_pre: true, pre_alpha_rank: 1u32, pre_has_num: false, pre_num: 0u32, build_id: 0u32 }
    let v_alpha_1 = SemVerLite { major: 1u32, minor: 0u32, patch: 0u32, has_pre: true, pre_alpha_rank: 1u32, pre_has_num: true, pre_num: 1u32, build_id: 0u32 }
    let v_beta_2 = SemVerLite { major: 1u32, minor: 0u32, patch: 0u32, has_pre: true, pre_alpha_rank: 2u32, pre_has_num: true, pre_num: 2u32, build_id: 0u32 }
    let v_beta_11 = SemVerLite { major: 1u32, minor: 0u32, patch: 0u32, has_pre: true, pre_alpha_rank: 2u32, pre_has_num: true, pre_num: 11u32, build_id: 0u32 }
    let v_rel_b1 = SemVerLite { major: 1u32, minor: 0u32, patch: 0u32, has_pre: false, pre_alpha_rank: 0u32, pre_has_num: false, pre_num: 0u32, build_id: 10u32 }
    let v_rel_b2 = SemVerLite { major: 1u32, minor: 0u32, patch: 0u32, has_pre: false, pre_alpha_rank: 0u32, pre_has_num: false, pre_num: 0u32, build_id: 20u32 }

    if cmp_semver_precedence(v_alpha, v_alpha_1) >= 0i32 ||
        cmp_semver_precedence(v_alpha_1, v_beta_2) >= 0i32 ||
        cmp_semver_precedence(v_beta_2, v_beta_11) >= 0i32 ||
        cmp_semver_precedence(v_beta_11, v_rel_b1) >= 0i32 ||
        cmp_semver_precedence(v_rel_b1, v_rel_b2) != 0i32 {
        return 1
    }

    // 2. Pre-release isolation (`AXS-PKG-005 §6`): `^1.0.0` rejects `1.0.0-alpha.1`, while `^1.0.0-alpha` accepts `1.0.0-alpha.1` and `1.0.0`
    if matches_caret_constraint(v_rel_b1, v_alpha_1) {
        return 2
    }
    if !matches_caret_constraint(v_alpha, v_alpha_1) || !matches_caret_constraint(v_alpha, v_rel_b1) {
        return 3
    }

    // 3. `0.y.z` caret semantics (`^0.2.3` vs `^0.0.3`)
    let v_023 = SemVerLite { major: 0u32, minor: 2u32, patch: 3u32, has_pre: false, pre_alpha_rank: 0u32, pre_has_num: false, pre_num: 0u32, build_id: 0u32 }
    let v_029 = SemVerLite { major: 0u32, minor: 2u32, patch: 9u32, has_pre: false, pre_alpha_rank: 0u32, pre_has_num: false, pre_num: 0u32, build_id: 0u32 }
    let v_030 = SemVerLite { major: 0u32, minor: 3u32, patch: 0u32, has_pre: false, pre_alpha_rank: 0u32, pre_has_num: false, pre_num: 0u32, build_id: 0u32 }
    if !matches_caret_constraint(v_023, v_029) || matches_caret_constraint(v_023, v_030) {
        return 4
    }

    print("SEMVER2-ORDERING-AND-CONSTRAINTS-OK\n")
    0
}
