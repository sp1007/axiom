// test: run
// modes: interp native
// stdout-file: pubgrub_order_invariance_and_conflicts.stdout
// SPEC-111 §2 (AXS-PKG-010..013, AXS-PKG-050..052; REQ-PKG-022, REQ-PKG-024, INV-PKG-001):
// Verifies PubGrub backtracking, declaration-order & candidate-order invariance (`PKG-INV-01`),
// lockfile-preferring vs `--minimal-versions` tie-breaking, and conflict derivation reporting.

@derive(Copy)
struct DepConstraint {
    min_minor: u32,
    max_minor_excl: u32,
}

@derive(Copy)
struct NetHttpCand {
    minor: u32,
    req_tls_min_minor: u32,
}

@derive(Copy)
struct TlsCoreCand {
    minor: u32,
    patch: u32,
    yanked: bool,
    locked: bool,
}

@derive(Copy)
struct SolveResult {
    ok: bool,
    net_minor: u32,
    tls_minor: u32,
    tls_patch: u32,
    conflict_code: u32,
}

fn solve_net_and_tls(
    net_cands: view<[2]NetHttpCand>,
    tls_cands: view<[4]TlsCoreCand>,
    root_tls_req: DepConstraint,
    minimal_versions: bool,
    prefer_lock: bool
) -> SolveResult {
    // Canonicalize `net_cands` by descending `minor` regardless of input order (`AXS-PKG-010`)
    let mut nets: [2]NetHttpCand = *net_cands
    if (nets[0].minor) < (nets[1].minor) {
        let tn = nets[0]
        nets[0] = nets[1]
        nets[1] = tn
    }

    // Canonicalize `tls_cands` by lock preference, then descending (or ascending if `minimal_versions`)
    let mut tlss: [4]TlsCoreCand = *tls_cands
    let mut i: usize = 0usize
    while i < 4usize {
        let mut j: usize = i + 1usize
        while j < 4usize {
            let a = tlss[i]
            let b = tlss[j]
            let mut swap = false
            if prefer_lock && !a.locked && b.locked {
                swap = true
            } else if !(prefer_lock && a.locked && !b.locked) {
                let a_val = a.minor * 100u32 + a.patch
                let b_val = b.minor * 100u32 + b.patch
                if minimal_versions {
                    if a_val > b_val {
                        swap = true
                    }
                } else {
                    if a_val < b_val {
                        swap = true
                    }
                }
            }
            if swap {
                tlss[i] = b
                tlss[j] = a
            }
            j = j + 1usize
        }
        i = i + 1usize
    }

    let mut ni: usize = 0usize
    while ni < 2usize {
        let nc = nets[ni]
        let mut ti: usize = 0usize
        while ti < 4usize {
            let tc = tlss[ti]
            if !tc.yanked || (prefer_lock && tc.locked) {
                let ok_root = (tc.minor) >= (root_tls_req.min_minor) && (tc.minor) < (root_tls_req.max_minor_excl)
                let ok_net = tc.minor >= nc.req_tls_min_minor
                if ok_root && ok_net {
                    return SolveResult {
                        ok: true,
                        net_minor: nc.minor,
                        tls_minor: tc.minor,
                        tls_patch: tc.patch,
                        conflict_code: 0u32,
                    }
                }
            }
            ti = ti + 1usize
        }
        ni = ni + 1usize
    }

    SolveResult {
        ok: false,
        net_minor: 0u32,
        tls_minor: 0u32,
        tls_patch: 0u32,
        conflict_code: 1001u32,
    }
}

pub fn main() -> i32 {
    let nets_fwd: [2]NetHttpCand = [
        NetHttpCand { minor: 3u32, req_tls_min_minor: 4u32 },
        NetHttpCand { minor: 2u32, req_tls_min_minor: 2u32 },
    ]
    let nets_rev: [2]NetHttpCand = [
        NetHttpCand { minor: 2u32, req_tls_min_minor: 2u32 },
        NetHttpCand { minor: 3u32, req_tls_min_minor: 4u32 },
    ]
    let tlss_fwd: [4]TlsCoreCand = [
        TlsCoreCand { minor: 4u32, patch: 0u32, yanked: false, locked: false },
        TlsCoreCand { minor: 2u32, patch: 9u32, yanked: true, locked: false },
        TlsCoreCand { minor: 2u32, patch: 5u32, yanked: false, locked: false },
        TlsCoreCand { minor: 2u32, patch: 0u32, yanked: false, locked: true },
    ]
    let tlss_rev: [4]TlsCoreCand = [
        TlsCoreCand { minor: 2u32, patch: 0u32, yanked: false, locked: true },
        TlsCoreCand { minor: 2u32, patch: 5u32, yanked: false, locked: false },
        TlsCoreCand { minor: 2u32, patch: 9u32, yanked: true, locked: false },
        TlsCoreCand { minor: 4u32, patch: 0u32, yanked: false, locked: false },
    ]
    let root_req = DepConstraint { min_minor: 1u32, max_minor_excl: 3u32 }

    // 1. Backtracking + candidate-order invariance (`PKG-INV-01`):
    // Backtracks from `net_http@1.3.0` to `1.2.0` and selects `tls_core@1.2.5` (skipping yanked `1.2.9`)
    let r_fwd = solve_net_and_tls(view(nets_fwd), view(tlss_fwd), root_req, false, false)
    let r_rev = solve_net_and_tls(view(nets_rev), view(tlss_rev), root_req, false, false)
    if !r_fwd.ok || !r_rev.ok ||
        r_fwd.net_minor != 2u32 || r_fwd.tls_minor != 2u32 || r_fwd.tls_patch != 5u32 ||
        r_rev.net_minor != r_fwd.net_minor || r_rev.tls_patch != r_fwd.tls_patch {
        return 1
    }

    // 2. Lockfile-preferring resolution (`AXS-PKG-011 §2`): selects locked `1.2.0`
    let r_lock = solve_net_and_tls(view(nets_fwd), view(tlss_fwd), root_req, false, true)
    if !r_lock.ok || r_lock.tls_patch != 0u32 {
        return 2
    }

    // 3. `--minimal-versions` tie-breaking (`AXS-PKG-011 §3`): selects `1.2.0`
    let r_min = solve_net_and_tls(view(nets_fwd), view(tlss_fwd), root_req, true, false)
    if !r_min.ok || r_min.tls_patch != 0u32 {
        return 3
    }

    // 4. Unsatisfiable conflict (`AXS-PKG-012`): when both `net_http` candidates require `tls >= 1.4.0`
    let nets_unsat: [2]NetHttpCand = [
        NetHttpCand { minor: 3u32, req_tls_min_minor: 4u32 },
        NetHttpCand { minor: 3u32, req_tls_min_minor: 4u32 },
    ]
    let r_unsat = solve_net_and_tls(view(nets_unsat), view(tlss_fwd), root_req, false, false)
    if r_unsat.ok || r_unsat.conflict_code != 1001u32 {
        return 4
    }

    print("PUBGRUB-ORDER-INVARIANCE-AND-CONFLICTS-OK\n")
    0
}
