// stdout: U 1 2\n
// stdout: U 0 1\n
// T453: native u128 register-pair arithmetic matrix (ADD/ADC, SUB/SBB, MUL+IMUL cross terms, AND/OR/XOR,
// 128-bit compares via SUB/SBB flags, udiv128/sdiv128 division and remainder, saturating ADD/SUB/MUL
// clamped with CMOVcc, NOT and two's-complement negation). Expected lines: exact Python integers mod 2^128.

fn print_bool(b: bool) {
    if b {
        print("1");
    } else {
        print("0");
    }
}

fn pair(a: u128, b: u128) {
    print_int(a.wrapping_add(b));
    print(" ");
    print_int(a.wrapping_sub(b));
    print(" ");
    print_int(a.wrapping_mul(b));
    print(" ");
    print_int(a & b);
    print(" ");
    print_int(a | b);
    print(" ");
    print_int(a ^ b);
    print(" ");
    print_bool(a < b);
    print_bool(a <= b);
    print_bool(a == b);
    print_bool(a != b);
    print_bool(a > b);
    print_bool(a >= b);
    print(" ");
    if b != 0u128 {
        print_int(a / b);
        print(" ");
        print_int(a % b);
    } else {
        print("-");
    }
    print(" S ");
    print_int(a.saturating_add(b));
    print(" ");
    print_int(a.saturating_sub(b));
    print(" ");
    print_int(a.saturating_mul(b));
    print("\n");
}

fn unary(a: u128) {
    print("U ");
    print_int(~a);
    print(" ");
    print_int(a.wrapping_neg());
    print("\n");
}

fn main() -> i32 {
    let vals: [13]u128 = [0u128, 1u128, 3u128, 7u128, 9223372036854775808u128, 18446744073709551615u128, 18446744073709551616u128, 18446744073709551617u128, 338770000845734292516042252062085074415u128, 170141183460469231731687303715884105727u128, 170141183460469231731687303715884105728u128, 340282366920938463463374607431768211454u128, 340282366920938463463374607431768211455u128];
    let mut i: usize = 0;
    while i < 13 {
        let mut j: usize = 0;
        while j < 13 {
            pair(vals[i], vals[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    let mut k: usize = 0;
    while k < 13 {
        unary(vals[k]);
        k = k + 1;
    }
    0
}
