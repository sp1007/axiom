// test: run
// modes: interp native
// exit: 101
// stdout: 4\n
// stdout: 16\n
// stdout: 256\n
// stdout: 65536\n
// stdout: 4294967296\n
// stdout: 18446744073709551616\n
// stderr-contains: panic: arithmetic overflow
// QA (T453 gate): signed 128-bit multiplication (high-limb / 256-bit check) in a loop: 2^64 squared (2^128) exceeds i128::MAX
// and must trap natively with exit 101 after the exact earlier lines were printed.

fn main() -> i32 {
    let mut v: i128 = 2i128;
    let mut i: u32 = 0u32;
    while i < 20u32 {
        v = v * v;
        print_int(v);
        print("\n");
        i = i + 1u32;
    }
    print("unreachable\n");
    0
}
