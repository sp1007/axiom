// T453: native u128 shifts for every count 0..127 (SHLD/SHRD + SHL/SHR/SAR by CL, `test cl, 64` +
// CMOVcc limb select) and rotates; expected lines from exact Python integers.

fn row(v: u128, c: u32) {
    print_int(c);
    print(" ");
    print_int(v << (0u128 + (c as u128)));
    print(" ");
    print_int(v >> (0u128 + (c as u128)));
    print(" ");
    print_int(v.rotate_left(c));
    print(" ");
    print_int(v.rotate_right(c));
    print("\n");
}

fn main() -> i32 {
    let vals: [3]u128 = [1u128, 340282366920938463463374607431768211455u128, 338770000845734292516042252062085074415u128];
    let mut i: usize = 0;
    while i < 3 {
        let mut c: u32 = 0u32;
        while c < 128u32 {
            row(vals[i], c);
            c = c + 1u32;
        }
        i = i + 1;
    }
    0
}
