fn main() -> i32 {
    let srcs: [8]i128 = [0i128, 1i128, (-1i128), (-170141183460469231731687303715884105727i128 - 1i128), 170141183460469231731687303715884105727i128, 18446744073709551744i128, (-18446744073709551743i128), 24197857203266734881846307747534221840i128];
    let mut i: usize = 0;
    while i < 8 {
        trunc_all(srcs[i]);
        i = i + 1;
    }
    widen_i8((-127i8 - 1i8));
    widen_i8((-1i8));
    widen_i8(0i8);
    widen_i8(127i8);
    widen_i16((-32767i16 - 1i16));
    widen_i16((-2i16));
    widen_i16(32767i16);
    widen_i32((-2147483647i32 - 1i32));
    widen_i32((-3i32));
    widen_i32(2147483647i32);
    widen_i64((-9223372036854775807i64 - 1i64));
    widen_i64((-5i64));
    widen_i64(9223372036854775807i64);
    widen_u8(0u8);
    widen_u8(200u8);
    widen_u8(255u8);
    widen_u16(65535u16);
    widen_u16(1u16);
    widen_u32(4294967295u32);
    widen_u64(18446744073709551615u64);
    widen_u64(9223372036854775808u64);
    0
}
