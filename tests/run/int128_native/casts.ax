// T453: native i128/u128 TRUNC to every narrow width and SEXT/ZEXT from every narrow width.

fn trunc_all(v: i128) {
    print("T");
    print(" ");
    print_int(v as i8);
    print(" ");
    print_int(v as i16);
    print(" ");
    print_int(v as i32);
    print(" ");
    print_int(v as i64);
    print(" ");
    print_int(v as isize);
    print(" ");
    print_int(v as u8);
    print(" ");
    print_int(v as u16);
    print(" ");
    print_int(v as u32);
    print(" ");
    print_int((v as u64) as u128);
    print(" ");
    print_int((v as usize) as u128);
    print(" ");
    print_int(v as u128);
    print("\n");
}

fn widen_i8(v: i8) {
    print("W ");
    print_int(v);
    print(" ");
    print_int(v as u128);
    print(" ");
    print_int((v as u128) as i128);
    print("\n");
}

