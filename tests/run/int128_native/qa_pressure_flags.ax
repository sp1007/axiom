// QA (T453 gate): register pressure (8 live pairs -> spills), flags produced early and consumed late (lt/slt),
// shift counts derived from the operand's own limbs, and a loop-carried xorshift/rotate hash. Targets -O1 regalloc/peephole.

fn f1(p0: u128, p1: u128, p2: u128, p3: u128, p4: u128, p5: u128, p6: u128, p7: u128) -> u128 {
    let a = p0.wrapping_add(p1);
    let b = p2.wrapping_sub(p3);
    let c = p4.wrapping_mul(p5);
    let d = p6 ^ p7;
    let lt = a < b;
    let slt = (c as i128) < (d as i128);
    let e = a.wrapping_add(c);
    let f = b.wrapping_sub(d);
    let g = (a & d) | (b & c);
    let h = e.wrapping_mul(f);
    let k = (h >> 5u32) ^ (g << 77u32);
    let m = if lt { k.wrapping_add(p7) } else { k.wrapping_sub(p0) };
    let n = if slt { m ^ e } else { m ^ f };
    let sh = p3 & 127u128;
    let o = n << sh;
    let r = (o ^ h).wrapping_add(a).wrapping_add(b).wrapping_add(c).wrapping_add(d);
    let sg = (r as i128) >> (p5 & 127u128);
    r ^ (sg as u128)
}

fn f2(seed: u128) -> u128 {
    let mut sv: u128 = seed;
    let mut acc: u128 = 0u128;
    let mut i: u32 = 0u32;
    while i < 300u32 {
        sv = sv ^ (sv << 13u32);
        sv = sv ^ (sv >> 7u32);
        sv = sv ^ (sv << 17u32);
        let t = sv.wrapping_mul(49544664747888569924760614037307055389u128);
        acc = acc.wrapping_add(t);
        if (t as i128) < 0i128 {
            let r = i & 127u32;
            if r != 0u32 {
                acc = (acc << r) | (acc >> (128u32 - r));
            }
        }
        if (t & 1u128) != 0u128 {
            acc = acc.wrapping_sub(t >> 64u32);
        }
        if (t >> 64u32) < (acc & 18446744073709551615u128) {
            acc = acc ^ t;
        }
        i = i + 1u32;
    }
    acc
}

fn main() -> i32 {
    print_int(f1(1u128, 2u128, 3u128, 4u128, 5u128, 6u128, 7u128, 8u128));
    print("\n");
    print_int(f1(340282366920938463463374607431768211455u128, 1u128, 0u128, 1u128, 340282366920938463463374607431768211455u128, 340282366920938463463374607431768211455u128, 170141183460469231731687303715884105728u128, 3u128));
    print("\n");
    print_int(f1(18446744073709551616u128, 18446744073709551615u128, 9223372036854775808u128, 9223372036854775808u128, 18446744073709551621u128, 77u128, 170141183460469231731687303715884105728u128, 170141183460469231731687303715884105727u128));
    print("\n");
    print_int(f1(1512366075204170929049582354406559215u128, 338770000845734292534325025077361652240u128, 1267650600228229401496703205376u128, 127u128, 64u128, 63u128, 0u128, 340282366920938463463374607431768211455u128));
    print("\n");
    print_int(f1(123456789012345678901234567890u128, 987654321098765432109876543210u128, 5u128, 128u128, 1237940039285380274899124225u128, 1180591620717411303423u128, 99u128, 100u128));
    print("\n");
    print_int(f2(1u128));
    print("\n");
    print_int(f2(210306068529402873165736369884012333109u128));
    print("\n");
    print_int(f2(340282366920938463463374607431768211455u128));
    print("\n");
    print_int(f2(170141183460469231731687303715884105728u128));
    print("\n");
    0
}
