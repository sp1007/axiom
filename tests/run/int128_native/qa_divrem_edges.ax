// QA (T453 gate): full pairwise boundary matrix for udiv128/sdiv128 (zero/one/2^63/2^64/MIN/MAX/divisors with hi=1,
// lo=0, negative multiples). Each row folds every quotient/remainder of one dividend into a wrapping hash.
// i128 MIN / -1 pairs are skipped (they panic: covered by qa_panic_i128_*).

fn mix(acc: u128, v: u128) -> u128 {
    acc.wrapping_mul(1000003u128).wrapping_add(v)
}

fn main() -> i32 {
    let vals: [32]u128 = [0u128, 1u128, 2u128, 3u128, 10u128, 340282366920938463463374607431768211455u128, 340282366920938463463374607431768211454u128, 340282366920938463463374607431768211453u128, 9223372036854775807u128, 9223372036854775808u128, 9223372036854775809u128, 18446744073709551615u128, 18446744073709551616u128, 18446744073709551617u128, 36893488147419103232u128, 1267650600228229401496703217721u128, 170141183460469231731687303715884105727u128, 170141183460469231731687303715884105726u128, 170141183460469231731687303715884105728u128, 170141183460469231731687303715884105729u128, 340282366920938463454151235394913435648u128, 340282366920938463454151235394913435647u128, 340282366920938463444927863358058659840u128, 340282366920938463444927863358058659839u128, 340282365920938463463374607431768211456u128, 1000000000000000000000000000000u128, 170141183460469231731687303715884105729u128, 340282366920938463463374607431768211455u128, 4294967295u128, 4294967296u128, 170141183460469231750134047789593657343u128, 79228162514264337593543950336u128];
    let mut i: usize = 0;
    while i < 32 {
        let mut ua: u128 = 0u128;
        let mut sa: u128 = 0u128;
        let mut j: usize = 0;
        while j < 32 {
            let a = vals[i];
            let b = vals[j];
            if b != 0u128 {
                ua = mix(ua, a / b);
                ua = mix(ua, a % b);
            }
            let x = a as i128;
            let y = b as i128;
            if y != 0i128 && !(x == (-170141183460469231731687303715884105727i128 - 1i128) && y == (-1i128)) {
                sa = mix(sa, (x / y) as u128);
                sa = mix(sa, (x % y) as u128);
            }
            j = j + 1;
        }
        print_int(ua);
        print(" ");
        print_int(sa as i128);
        print("\n");
        i = i + 1;
    }
    0
}
