// test: run
// modes: interp native
// exit: 101
// stdout: 2 4 8\n
// stderr-contains: panic: arithmetic overflow
// QA (T453 gate): checked ADD+ADC carry (u128) discovered inside a loop with a live narrow counter; the 128th doubling
// (2^127 + 2^127) must trap natively with exit 101 after the exact first lines were printed.

fn main() -> i32 {
    let mut v: u128 = 1u128;
    let mut i: u32 = 0u32;
    while i < 200u32 {
        v = v + v;
        if i < 3u32 {
            print_int(v);
            if i < 2u32 {
                print(" ");
            } else {
                print("\n");
            }
        }
        i = i + 1u32;
    }
    print("unreachable\n");
    0
}
