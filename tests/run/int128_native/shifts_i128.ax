// T453: native i128 shifts for every count 0..127 (SHLD/SHRD + SHL/SHR/SAR by CL, `test cl, 64` +
// CMOVcc limb select) and rotates; expected lines from exact Python integers.

fn row(v: i128, c: u32) {
    print_int(c);
    print(" ");
    print_int(v << (0i128 + (c as i128)));
    print(" ");
    print_int(v >> (0i128 + (c as i128)));
    print(" ");
    print_int(v.rotate_left(c));
    print(" ");
    print_int(v.rotate_right(c));
    print("\n");
}

fn main() -> i32 {
    let vals: [4]i128 = [(-1i128), (-170141183460469231731687303715884105727i128 - 1i128), 168628817385265060784354948346200968687i128, (-1442304682926340989160139421850i128)];
    let mut i: usize = 0;
    while i < 4 {
        let mut c: u32 = 0u32;
        while c < 128u32 {
            row(vals[i], c);
            c = c + 1u32;
        }
        i = i + 1;
    }
    0
}
