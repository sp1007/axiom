// T453 (SPEC-40 AXS-INT-011): Win64 call boundaries for i128/u128 — 16-byte parameters passed by
// reference in RCX/RDX/R8/R9 and in stack argument slots, 16-byte returns through the hidden sret
// pointer, mixed narrow/wide parameter lists, structs holding 128-bit fields, recursion and arrays.

fn add3(a: i128, b: u64, c: i128) -> i128 {
    a + (b as i128) + c
}

fn many(a: u8, b: i128, c: u32, d: i128, e: i128, f: u128, g: i64) -> u128 {
    let s = (a as i128) + b + (c as i128) + d + e + (g as i128);
    (s as u128) ^ f
}

fn six(a: i128, b: i128, c: i128, d: i128, e: i128, f: i128) -> i128 {
    a + b + c + d + e + f
}

fn neg_chain(a: i128, b: i128, c: i128, d: i128, e: i128, f: i128) -> i128 {
    -six(a, b, c, d, e, f)
}

fn fib(n: u32) -> u128 {
    let mut a: u128 = 0u128;
    let mut b: u128 = 1u128;
    let mut i: u32 = 0u32;
    while i < n {
        let t = a + b;
        a = b;
        b = t;
        i = i + 1u32;
    }
    a
}

fn fact(n: u128) -> u128 {
    if n <= 1u128 {
        return 1u128;
    }
    n * fact(n - 1u128)
}

struct P {
    lo: u128,
    k: u8,
    hi: i128,
}

fn sum_p(p: P) -> i128 {
    (p.lo as i128) + p.hi + (p.k as i128)
}

fn make_p(x: i128) -> P {
    P { lo: (x as u128) + 5u128, k: 7u8, hi: -x + 5i128 }
}

fn pick(flag: bool, a: u128, b: i128) -> u128 {
    if flag {
        a
    } else {
        b as u128
    }
}

fn main() -> i32 {
    print_int(add3(-170141183460469231731687303715884105000i128, 7u64, 3i128));
    print("\n");
    print_int(many(1u8, 2i128, 3u32, -4i128, 18446744073709551616i128, 0xFFu128, -1i64));
    print("\n");
    print_int(six(1i128, 1i128, 1i128, 1i128, 1i128, 1i128));
    print("\n");
    print_int(six(1i128, 2i128, 3i128, 4i128, 5i128, 6i128));
    print("\n");
    print_int(neg_chain(1i128, 2i128, 3i128, 4i128, 5i128, 6i128));
    print("\n");
    print_int(fib(150u32));
    print("\n");
    print_int(fact(22u128) / 3348u128);
    print("\n");
    let p = P { lo: 5u128, k: 9u8, hi: -100000000000000000000000i128 };
    print_int(sum_p(p));
    print("\n");
    let q = make_p(100000000000000000000000i128);
    print_int(q.lo);
    print(" ");
    print_int(q.hi);
    print("\n");
    print_int(pick(true, 340282366920938463463374607431768211455u128, 0i128));
    print(" ");
    print_int(pick(false, 0u128, -170141183460469231731687303715884105727i128 - 1i128) as i128);
    print("\n");
    let mut arr: [4]i128 = [0i128, 0i128, 0i128, 0i128];
    let mut i: usize = 0;
    while i < 4 {
        arr[i] = (170141183460469231731687303715884105727i128 / 4i128) + (i as i128);
        i = i + 1;
    }
    print_int(arr[0] + arr[1] - 6i128 + arr[2] + arr[3] + 3i128);
    print("\n");
    let mut acc: u128 = 0u128;
    let mut j: usize = 0;
    while j < 2 {
        acc = acc + 18446744073709551615u128;
        j = j + 1;
    }
    print_int(acc);
    print("\n");
    0
}
