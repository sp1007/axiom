// stdout: 24 3 0 3\n
// QA (T453 gate): shifts at the limb boundaries (0/1/63/64/65/126/127) with amounts of types u8/u32/u64/i32/u128/i64/usize,
// and amounts derived from the shifted value's own limbs (CL/RCX register-allocation conflicts).

fn row(v: u128) {
    let sv = v as i128;
    let c0: u8 = 0u8;
    let c1: u32 = 1u32;
    let c63: u64 = 63u64;
    let c64: i32 = 64i32;
    let c65: u128 = 65u128;
    let c126: i64 = 126i64;
    let c127: usize = 127usize;
    print_int(v << c0); print(" "); print_int(v >> c0); print(" "); print_int((sv >> c0) as u128);
    print(" ");
    print_int(v << c1); print(" "); print_int(v >> c1); print(" "); print_int((sv >> c1) as u128);
    print(" ");
    print_int(v << c63); print(" "); print_int(v >> c63); print(" "); print_int((sv >> c63) as u128);
    print(" ");
    print_int(v << c64); print(" "); print_int(v >> c64); print(" "); print_int((sv >> c64) as u128);
    print(" ");
    print_int(v << c65); print(" "); print_int(v >> c65); print(" "); print_int((sv >> c65) as u128);
    print(" ");
    print_int(v << c126); print(" "); print_int(v >> c126); print(" "); print_int((sv >> c126) as u128);
    print(" ");
    print_int(v << c127); print(" "); print_int(v >> c127); print(" "); print_int((sv >> c127) as u128);
    print("\n");
}

fn selfrow(v: u128) {
    let sv = v as i128;
    let sh1 = v & 127u128;
    let sh2 = (v >> 64u32) & 127u128;
    print_int(v << sh1); print(" "); print_int(v >> sh2); print(" "); print_int((sv >> sh1) as u128); print(" "); print_int((sv << sh2) as u128);
    print("\n");
}

fn main() -> i32 {
    let vals: [8]u128 = [1u128, 340282366920938463463374607431768211455u128, 170141183460469231731687303715884105728u128, 170141183460469231731687303715884105727u128, 9223372036854775808u128, 18446744073709551616u128, 295990755076957304698161171062762229231u128, 3u128];
    let mut i: usize = 0;
    while i < 8 {
        row(vals[i]);
        i = i + 1;
    }
    i = 0;
    while i < 8 {
        selfrow(vals[i]);
        i = i + 1;
    }
    0
}
