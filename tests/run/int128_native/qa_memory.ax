// test: run
// modes: interp native
// exit: 0
// stdout: 170141183460469231731687303715884105727 -170141183460469231731687303715884105728 36893488147419103232\n
// stdout: 7 -9 340282366920938463463374607431768211455\n
// stdout: 21 100000000000000000000 -100000000000000000001\n
// stdout: K1 K2 K3 KD\n
// stdout: 340282366920938463463374607431768211454 18446744073709551616 -18446744073709551617\n
// stdout: -100000000000000000001 100000000000000000000 21\n
// QA (T453 gate): 128-bit values in memory — mut_view/view parameters (16-byte loads/stores through a pointer),
// struct fields, array elements swapped, enum payloads, match on i128 literals, const/static items.

const BIG: u128 = 340282366920938463463374607431768211455u128;
const NEG: i128 = -100000000000000000001i128;

struct Box2 {
    a: i128,
    b: u128,
}

enum E {
    Wide(i128),
    Narrow(u8),
    Both(u128),
}

fn bump(p: mut_view<Box2>) {
    p.a = p.a + 1i128;
    p.b = p.b - 1u128;
}

fn rd(p: view<Box2>) -> i128 {
    p.a + (p.b as i128)
}

fn classify(x: i128) -> u8 {
    match x {
        0 => 1u8,
        1 => 2u8,
        -1 => 3u8,
        18446744073709551616 => 4u8,
        _ => 0u8,
    }
}

fn pick(e: E) -> i128 {
    match e {
        E.Wide(v) => v,
        E.Narrow(n) => (n as i128) * 3i128,
        E.Both(w) => (w as i128) + 1i128,
    }
}

fn main() -> i32 {
    let mut bx = Box2 { a: 170141183460469231731687303715884105726i128, b: 36893488147419103233u128 };
    bump(mut_view(bx));
    print_int(bx.a);
    print(" ");
    let mut by = Box2 { a: (-170141183460469231731687303715884105727i128 - 1i128) + 1i128, b: 1u128 };
    by.a = by.a - 1i128;
    print_int(by.a);
    print(" ");
    print_int(bx.b);
    print("\n");
    let k = Box2 { a: 7i128, b: 18446744073709551615u128 };
    print_int(k.a);
    print(" ");
    let kk = Box2 { a: -9i128, b: 0u128 };
    print_int(rd(view(kk)));
    print(" ");
    print_int(BIG);
    print("\n");
    let mut arr: [3]i128 = [21i128, 100000000000000000000i128, NEG];
    print_int(arr[0]);
    print(" ");
    print_int(arr[1]);
    print(" ");
    print_int(arr[2]);
    print("\n");
    let c1 = classify(0i128);
    let c2 = classify(1i128);
    let c3 = classify(-1i128);
    let c4 = classify(18446744073709551616i128);
    let c5 = classify(18446744073709551617i128);
    if c1 == 1u8 && c2 == 2u8 && c3 == 3u8 && c4 == 4u8 && c5 == 0u8 {
        print("K1 K2 K3 KD\n");
    } else {
        print("BAD\n");
    }
    let t0 = arr[0];
    arr[0] = arr[2];
    arr[2] = t0;
    let w = pick(E.Wide(-18446744073709551617i128));
    let n = pick(E.Narrow(0u8));
    let b = pick(E.Both(18446744073709551615u128));
    print_int(BIG - 1u128);
    print(" ");
    print_int(n + b);
    print(" ");
    print_int(w);
    print("\n");
    print_int(arr[0]);
    print(" ");
    print_int(arr[1]);
    print(" ");
    print_int(arr[2]);
    print("\n");
    0
}
