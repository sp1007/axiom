// test: run
// stdout: moved\n2\n

struct Droppable2 {}
impl Drop for Droppable2 {
    fn drop(self: mut_view<Droppable2>) {
        print("2\n");
    }
}

fn consume(r: Droppable2) {
    print("moved\n");
}

fn main() {
    let r = Droppable2 {};
    let cond = true;
    if cond {
        consume(r);
    }
}
