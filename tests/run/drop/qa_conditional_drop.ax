// xfail: T128 basic drop elaboration
// native-after: T051
// test: run
// stdout: moved\n2\n

struct Resource {}
impl Drop for Resource {
    fn drop(self: mut_view<Resource>) {
        let x: i64 = 2;
        print_int(x);
        print("\n");
    }
}

fn consume(r: Resource) {
    print("moved\n");
}

fn main() {
    let r = Resource {};
    let cond = true;
    if cond {
        consume(r);
    }
}
