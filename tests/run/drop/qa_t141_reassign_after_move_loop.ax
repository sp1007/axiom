// test: run
// modes: interp native
// stdout: 1\n2\n3\n4\n9\n5\n
//
// T141 QA (AXS-DROP-003 + AXS-SEM-043): reassignment of a scalar-only `impl Drop` local after it
// was explicitly dropped must not drop it again (drop flag is false), and reassignment inside a
// loop drops the previous iteration's value exactly once. The destructor prints its id.
// Expected output written by hand:
//   x = S{1}; drop(x) -> 1; x = S{2} (x was moved: nothing dropped);
//   loop i = 3, 4, 5: x = S{i} drops the old value -> 2, 3, 4; then 9; scope end drops x (5).

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct StrRepr {
    ptr: *const u8,
    len: usize,
}

fn emit_digit(d: u8) {
    let buf: [2]u8 = [48u8 + d, 10u8];
    let v: view<[2]u8> = view(buf);
    let p: *const u8 = unsafe { *(address_of(v) as *const *const u8) };
    let repr = StrRepr { ptr: p, len: 2 };
    let s: str = unsafe { *(address_of(repr) as *const str) };
    print(s);
}

struct S {
    pub id: u8,
}

impl Drop for S {
    fn drop(self: mut_view<Self>) {
        emit_digit(self.id);
    }
}

pub fn main() -> i32 {
    {
        let mut x = S { id: 1u8 };
        drop(x);
        x = S { id: 2u8 };
        let mut i: u8 = 3u8;
        while i < 6u8 {
            x = S { id: i };
            i = i + 1u8;
        }
        emit_digit(9u8);
    }
    0
}
