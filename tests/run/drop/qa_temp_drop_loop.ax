// test: run
// stdout: loop 0\nS1 drop\nloop 1\nS1 drop\nafter loop\n

struct S1 {}
impl Drop for S1 {
    fn drop(self: mut_view<S1>) {
        print("S1 drop\n");
    }
}

fn returns_s1() -> S1 {
    return S1 {};
}

fn main() {
    let mut i = 0;
    while i < 2 {
        if i == 0 {
            print("loop 0\n");
        } else {
            print("loop 1\n");
        }
        returns_s1();
        i = i + 1;
    }
    print("after loop\n");
}
