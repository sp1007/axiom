// test: run
// modes: interp native
// stdout: 1\n9\n2\n
//
// QA T141 round 1 (SPEC-03 AXS-SEM-043 step 3): assigning to a field reached through a mut_view
// drops the field's old value. A view always points at an initialised value, so the store is not a
// raw store into an uninitialised slot. Expected output written by hand: set_inner evaluates S{2},
// drops the old w.inner (1) and stores; main prints 9; scope end drops w.inner (2).

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct StrRepr {
    ptr: *const u8,
    len: usize,
}

fn emit_digit(d: u8) {
    let buf: [2]u8 = [48u8 + d, 10u8];
    let v: view<[2]u8> = view(buf);
    let p: *const u8 = unsafe { *(address_of(v) as *const *const u8) };
    let repr = StrRepr { ptr: p, len: 2 };
    let s: str = unsafe { *(address_of(repr) as *const str) };
    print(s);
}

struct S {
    pub id: u8,
}

impl Drop for S {
    fn drop(self: mut_view<Self>) {
        emit_digit(self.id);
    }
}

struct W {
    pub inner: S,
    pub tag: u8,
}

fn set_inner(w: mut_view<W>) {
    w.inner = S { id: 2u8 };
}

pub fn main() -> i32 {
    {
        let mut w = W { inner: S { id: 1u8 }, tag: 0u8 };
        set_inner(mut_view(w));
        emit_digit(9u8);
    }
    0
}
