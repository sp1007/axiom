// test: run
// modes: interp native
// stdout: 0\n4\n2\n5\n

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct StrRepr {
    ptr: *const u8,
    len: usize,
}

fn emit_digit(d: u8) {
    let buf: [2]u8 = [48u8 + d, 10u8];
    let v: view<[2]u8> = view(buf);
    let p: *const u8 = unsafe { *(address_of(v) as *const *const u8) };
    let repr = StrRepr { ptr: p, len: 2 };
    let s: str = unsafe { *(address_of(repr) as *const str) };
    print(s);
}

struct Buf {
    pub ptr: *mut u8,
    pub len: usize,
    pub cap: usize,
}

impl Drop for Buf {
    fn drop(self: mut_view<Self>) {
        emit_digit((self.cap - self.len) as u8);
    }
}

pub fn main() -> i32 {
    {
        let b1 = Buf { ptr: 0 as *mut u8, len: 6, cap: 8 };
        let b2 = Buf { ptr: 0 as *mut u8, len: 12, cap: 16 };
        emit_digit(0u8);
    }
    emit_digit(5u8);
    0
}
