// test: run
// modes: interp native
// stdout: 1\n9\n7\n9\n

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct StrRepr {
    ptr: *const u8,
    len: usize,
}

fn emit_digit(d: u8) {
    let buf: [2]u8 = [48u8 + d, 10u8];
    let v: view<[2]u8> = view(buf);
    let p: *const u8 = unsafe { *(address_of(v) as *const *const u8) };
    let repr = StrRepr { ptr: p, len: 2 };
    let s: str = unsafe { *(address_of(repr) as *const str) };
    print(s);
}

pub const AX_ARENA_DEFAULT_CHUNK: usize = 65536;

pub struct ArenaChunk {
    pub next: *mut ArenaChunk,
    pub cap: usize,
    pub used: usize,
    pub data: *mut u8,
}

pub struct Arena {
    pub head: *mut ArenaChunk,
    pub current: *mut ArenaChunk,
    pub chunk_size: usize,
    pub bytes_requested: usize,
    pub chunk_count: usize,
    pub chunks_allocated: usize,
    pub chunks_freed: usize,
}

pub fn arena_new() -> Arena {
    Arena {
        head: 0 as *mut ArenaChunk,
        current: 0 as *mut ArenaChunk,
        chunk_size: AX_ARENA_DEFAULT_CHUNK,
        bytes_requested: 0,
        chunk_count: 0,
        chunks_allocated: 0,
        chunks_freed: 0,
    }
}

pub fn arena_attach_chunk(a: mut_view<Arena>, hdr: *mut ArenaChunk, used_bytes: usize) {
    unsafe {
        (*hdr).next = 0 as *mut ArenaChunk;
        (*hdr).used = used_bytes;
    }
    if (a.head as usize) == 0 {
        a.head = hdr;
    } else {
        unsafe {
            (*a.current).next = hdr;
        }
    }
    a.current = hdr;
    a.bytes_requested = a.bytes_requested + used_bytes;
    a.chunk_count = a.chunk_count + 1;
    a.chunks_allocated = a.chunks_allocated + 1;
}

pub fn arena_destroy(a: mut_view<Arena>) {
    let mut c: *mut ArenaChunk = a.head;
    while (c as usize) != 0 {
        let next: *mut ArenaChunk = unsafe { (*c).next };
        emit_digit(9u8);
        a.chunks_freed = a.chunks_freed + 1;
        c = next;
    }
    a.head = 0 as *mut ArenaChunk;
    a.current = 0 as *mut ArenaChunk;
    a.chunk_count = 0;
    a.bytes_requested = 0;
}

impl Drop for Arena {
    fn drop(self: mut_view<Self>) {
        arena_destroy(self);
    }
}

struct WorkCtx {
    pub arena: Arena,
    pub tag: u8,
}

fn run_round() {
    let chunk = ArenaChunk {
        next: 0 as *mut ArenaChunk,
        cap: AX_ARENA_DEFAULT_CHUNK,
        used: 0,
        data: 0 as *mut u8,
    };
    let mut a = arena_new();
    let hdr: *mut ArenaChunk = unsafe { address_of(chunk) as *mut ArenaChunk };
    arena_attach_chunk(mut_view(a), hdr, 128);
    emit_digit(1u8);
}

fn run_wrapped() {
    let chunk = ArenaChunk {
        next: 0 as *mut ArenaChunk,
        cap: AX_ARENA_DEFAULT_CHUNK,
        used: 0,
        data: 0 as *mut u8,
    };
    let inner = arena_new();
    let mut ctx = WorkCtx {
        arena: inner,
        tag: 7u8,
    };
    let hdr: *mut ArenaChunk = unsafe { address_of(chunk) as *mut ArenaChunk };
    arena_attach_chunk(mut_view(ctx.arena), hdr, 64);
    emit_digit(ctx.tag);
}

pub fn main() -> i32 {
    run_round();
    run_wrapped();
    0
}
