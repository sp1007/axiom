// test: run
// stdout: 1\n

struct Droppable1 {}
impl Drop for Droppable1 {
    fn drop(self: mut_view<Droppable1>) {
        print("1\n");
    }
}

fn consume(d: Droppable1) {
    // drops d
}

fn main() {
    let mut x = Droppable1 {};
    consume(x); // x is moved
    
    // Now x is uninitialized
    let b: bool = false;
    if b {
        x = Droppable1 {}; // Reassigned conditionally
    }
    // Only one 1\n should be printed (from consume), x is uninitialized at end.
}
