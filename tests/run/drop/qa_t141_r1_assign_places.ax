// test: run
// modes: interp native
// stdout: 7\n4\n2\n9\n1\n5\n1\n9\n2\n3\n0\n1\n8\n2\n1\n8\n2\n
//
// QA T141 round 1 (SPEC-03 AXS-SEM-043, SPEC-12 AXS-DROP-003): assignment to a place whose type
// needs drop. Expected output written by hand:
//   block 1: arr[pick(1)] = make(5): rhs first (make prints 7), then the index (pick prints 4),
//            then the old arr[1] (2) is dropped; 9; scope end drops arr[0]=1, arr[1]=5.
//   block 2: deferred init `y = S{3}` drops nothing; t.0 = S{2} drops the old t.0 (1); 9;
//            scope end drops t (t.0 = 2) before y (3).
//   run(true): x is moved into consume (prints 0, then consume's parameter drop prints 1);
//            `x = S{2}` must not drop the moved-out x; 8; scope end drops x (2).
//   run(false): `x = S{2}` drops the old x (1); 8; scope end drops x (2).

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct StrRepr {
    ptr: *const u8,
    len: usize,
}

fn emit_digit(d: u8) {
    let buf: [2]u8 = [48u8 + d, 10u8];
    let v: view<[2]u8> = view(buf);
    let p: *const u8 = unsafe { *(address_of(v) as *const *const u8) };
    let repr = StrRepr { ptr: p, len: 2 };
    let s: str = unsafe { *(address_of(repr) as *const str) };
    print(s);
}

struct S {
    pub id: u8,
}

impl Drop for S {
    fn drop(self: mut_view<Self>) {
        emit_digit(self.id);
    }
}

fn make(id: u8) -> S {
    emit_digit(7u8);
    S { id: id }
}

fn pick(i: usize) -> usize {
    emit_digit(4u8);
    i
}

fn consume(s: S) {
    emit_digit(0u8);
}

fn run(c: bool) {
    let mut x = S { id: 1u8 };
    if c {
        consume(x);
    }
    x = S { id: 2u8 };
    emit_digit(8u8);
}

pub fn main() -> i32 {
    {
        let mut arr: [2]S = [S { id: 1u8 }, S { id: 2u8 }];
        arr[pick(1usize)] = make(5u8);
        emit_digit(9u8);
    }
    {
        let y: S;
        y = S { id: 3u8 };
        let mut t = (S { id: 1u8 }, 6u8);
        t.0 = S { id: 2u8 };
        emit_digit(9u8);
    }
    run(true);
    run(false);
    0
}
