// test: run
// modes: interp native
// stdout: 1\n2\n3\n9\n4\n5\n6\n
//
// T141 round 1 (SPEC-03 AXS-SEM-043 step 3 on projected places): assigning to a field drops the
// field's old value after the rhs is evaluated and before the store. Expected output written by
// hand (SPEC-12 AXS-DROP-002: locals in reverse declaration order, fields in declaration order):
//   w.inner = S{2}   -> old w.inner (1) dropped                      -> 1
//   w.inner = S{6}   -> old w.inner (2) dropped                      -> 2
//   o.w.inner = S{4} -> old o.w.inner (3, nested two levels) dropped -> 3
//   9 printed; scope end drops o first (o.w.inner = 4, then o.extra = 5), then w (w.inner = 6).

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct StrRepr {
    ptr: *const u8,
    len: usize,
}

fn emit_digit(d: u8) {
    let buf: [2]u8 = [48u8 + d, 10u8];
    let v: view<[2]u8> = view(buf);
    let p: *const u8 = unsafe { *(address_of(v) as *const *const u8) };
    let repr = StrRepr { ptr: p, len: 2 };
    let s: str = unsafe { *(address_of(repr) as *const str) };
    print(s);
}

struct S {
    pub id: u8,
}

impl Drop for S {
    fn drop(self: mut_view<Self>) {
        emit_digit(self.id);
    }
}

struct W {
    pub inner: S,
    pub tag: u8,
}

struct O {
    pub w: W,
    pub extra: S,
}

pub fn main() -> i32 {
    {
        let mut w = W { inner: S { id: 1u8 }, tag: 0u8 };
        w.inner = S { id: 2u8 };
        w.inner = S { id: 6u8 };
        let mut o = O { w: W { inner: S { id: 3u8 }, tag: 1u8 }, extra: S { id: 5u8 } };
        o.w.inner = S { id: 4u8 };
        emit_digit(9u8);
    }
    0
}
