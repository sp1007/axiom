// test: run
// modes: interp native
// stdout: 1\n5\n1\n2\n2\n8\n2\n
//
// T141 QA: reading a Copy field of a scalar-only `impl Drop` struct (directly and through a view)
// must neither mark the struct moved (it is still dropped at scope end) nor stop a later real move
// from suppressing the scope-end drop (no double drop). The destructor prints id+1.
// Expected output written by hand:
//   block 1: emit(a.id)=1, emit(peek(view(a))+4)=5, consume(a): emit(t.id)=1, t dropped in consume -> 2;
//            a is moved, so nothing at the end of block 1 (a second "2" here = double drop).
//   block 2: emit(b.id+1)=2, emit(8)=8, b dropped at block end -> 2.

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct StrRepr {
    ptr: *const u8,
    len: usize,
}

fn emit_digit(d: u8) {
    let buf: [2]u8 = [48u8 + d, 10u8];
    let v: view<[2]u8> = view(buf);
    let p: *const u8 = unsafe { *(address_of(v) as *const *const u8) };
    let repr = StrRepr { ptr: p, len: 2 };
    let s: str = unsafe { *(address_of(repr) as *const str) };
    print(s);
}

struct Tok {
    pub id: u8,
}

impl Drop for Tok {
    fn drop(self: mut_view<Self>) {
        emit_digit(self.id + 1u8);
    }
}

fn consume(t: Tok) {
    emit_digit(t.id);
}

fn peek(t: view<Tok>) -> u8 {
    t.id
}

pub fn main() -> i32 {
    {
        let a = Tok { id: 1u8 };
        emit_digit(a.id);
        emit_digit(peek(view(a)) + 4u8);
        consume(a);
    }
    {
        let b = Tok { id: 1u8 };
        emit_digit(b.id + 1u8);
        emit_digit(8u8);
    }
    0
}
