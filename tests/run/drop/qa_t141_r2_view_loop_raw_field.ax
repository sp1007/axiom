// test: run
// modes: interp native
// stdout: 1\n4\n5\n9\n8\n
//
// QA T141 round 2 (SPEC-03 AXS-SEM-043 step 3, rule "view place = drop; raw-pointer store = no
// drop"), cases the implementer tests do not cover:
// - repeated assignment to a field through a `mut_view` in a loop drops every previous value once;
// - a field store through a raw pointer (`(*p).inner = ...`, `p: *mut W`) is a raw store and does
//   not drop the old field value (the old 6 is overwritten without its destructor).
// (Element stores through `mut_view<[T]>` / `mut_view<[N]T>` were checked by hand in the QA report
// only: an index store through a deref already diverges between axiom0 and axiomc at HEAD for any
// element type, so such a program would be a new axiomc_e2e entry.)
// Expected output written by hand:
//   fill_loop(w): 4, 5, 6       -> old values 1, 4, 5 dropped (6 stays)       -> 1 4 5
//   raw_field(w): stores 8      -> no drop
//   9 printed; scope end drops w.inner (8)                                    -> 9 8

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct StrRepr {
    ptr: *const u8,
    len: usize,
}

fn emit_digit(d: u8) {
    let buf: [2]u8 = [48u8 + d, 10u8];
    let v: view<[2]u8> = view(buf);
    let p: *const u8 = unsafe { *(address_of(v) as *const *const u8) };
    let repr = StrRepr { ptr: p, len: 2 };
    let s: str = unsafe { *(address_of(repr) as *const str) };
    print(s);
}

struct S {
    pub id: u8,
}

impl Drop for S {
    fn drop(self: mut_view<Self>) {
        emit_digit(self.id);
    }
}

struct W {
    pub inner: S,
    pub tag: u8,
}

fn fill_loop(w: mut_view<W>) {
    let mut i: u8 = 4u8;
    while i < 7u8 {
        w.inner = S { id: i };
        i = i + 1u8;
    }
}

fn raw_field(w: mut_view<W>) {
    let p: *mut W = unsafe { address_of_mut(*w) };
    unsafe { (*p).inner = S { id: 8u8 }; }
}

pub fn main() -> i32 {
    {
        let mut w = W { inner: S { id: 1u8 }, tag: 0u8 };
        fill_loop(mut_view(w));
        raw_field(mut_view(w));
        emit_digit(9u8);
    }
    0
}
