// test: run
// modes: interp native
// stdout: 0\n2\n1\n3\n

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct StrRepr {
    ptr: *const u8,
    len: usize,
}

fn emit_digit(d: u8) {
    let buf: [2]u8 = [48u8 + d, 10u8];
    let v: view<[2]u8> = view(buf);
    let p: *const u8 = unsafe { *(address_of(v) as *const *const u8) };
    let repr = StrRepr { ptr: p, len: 2 };
    let s: str = unsafe { *(address_of(repr) as *const str) };
    print(s);
}

struct BoxLike<T> {
    pub ptr: *mut T,
    pub tag: u8,
}

impl<T> Drop for BoxLike<T> {
    fn drop(self: mut_view<Self>) {
        emit_digit(self.tag);
    }
}

pub fn main() -> i32 {
    {
        let x = BoxLike<i32> { ptr: 0 as *mut i32, tag: 1u8 };
        let y = BoxLike<u64> { ptr: 0 as *mut u64, tag: 2u8 };
        emit_digit(0u8);
    }
    emit_digit(3u8);
    0
}
