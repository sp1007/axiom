// test: run
// modes: interp native
// stdout: 4\n3\n8\n1\n
//
// T141 QA (AXS-DROP-003 drop flags): a scalar-only `impl Drop` value that is moved on one branch
// only is dropped at scope end exactly when it was not moved. The destructor prints its id.
// Expected output written by hand:
//   maybe_consume(true,  id 3): branch moves it into consume -> consume prints 4 (id+1), then its
//                               parameter is dropped -> 3; nothing at function end.
//   maybe_consume(false, id 1): no move; prints 8 at the end of the body, then scope-end drop -> 1.

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct StrRepr {
    ptr: *const u8,
    len: usize,
}

fn emit_digit(d: u8) {
    let buf: [2]u8 = [48u8 + d, 10u8];
    let v: view<[2]u8> = view(buf);
    let p: *const u8 = unsafe { *(address_of(v) as *const *const u8) };
    let repr = StrRepr { ptr: p, len: 2 };
    let s: str = unsafe { *(address_of(repr) as *const str) };
    print(s);
}

struct S {
    pub id: u8,
}

impl Drop for S {
    fn drop(self: mut_view<Self>) {
        emit_digit(self.id);
    }
}

fn consume(s: S) {
    emit_digit(s.id + 1u8);
}

fn maybe_consume(c: bool, id: u8) {
    let s = S { id: id };
    if c {
        consume(s);
    } else {
        emit_digit(8u8);
    }
}

pub fn main() -> i32 {
    maybe_consume(true, 3u8);
    maybe_consume(false, 1u8);
    0
}
