// test: run
// modes: interp native
// stdout: 1\n2\n3\n3\n1\n2\n3\n4\n0\n9\n1\n2\n
//
// T141 round 1 (SPEC-03 AXS-SEM-043 + SPEC-12 AXS-DROP-001/003): field assignment inside a loop,
// combined with an early `return`, and a field store after the old field value was moved out.
// Expected output written by hand:
//   run(2): iteration 1 drops inner 1 (new 2); iteration 2 drops inner 2 (new 3); i == 2 so
//           `return w.inner.id` (3) drops w on the return edge -> 1 2 3; main prints 3.
//   run(5): the loop drops 1, 2, 3 (new inner 4), ends; w dropped at function end -> 1 2 3 4;
//           main prints 0.
//   moved(): `let taken = w.inner` moves the field out, so `w.inner = S{2}` has no old value to
//           drop; 9 printed; scope end drops taken (1) then w (inner 2) -> 9 1 2.

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct StrRepr {
    ptr: *const u8,
    len: usize,
}

fn emit_digit(d: u8) {
    let buf: [2]u8 = [48u8 + d, 10u8];
    let v: view<[2]u8> = view(buf);
    let p: *const u8 = unsafe { *(address_of(v) as *const *const u8) };
    let repr = StrRepr { ptr: p, len: 2 };
    let s: str = unsafe { *(address_of(repr) as *const str) };
    print(s);
}

struct S {
    pub id: u8,
}

impl Drop for S {
    fn drop(self: mut_view<Self>) {
        emit_digit(self.id);
    }
}

struct W {
    pub inner: S,
    pub tag: u8,
}

fn run(n: u8) -> u8 {
    let mut w = W { inner: S { id: 1u8 }, tag: 0u8 };
    let mut i: u8 = 0u8;
    while i < 3u8 {
        w.inner = S { id: w.inner.id + 1u8 };
        i = i + 1u8;
        if i == n {
            return w.inner.id;
        }
    }
    w.tag = 7u8;
    0u8
}

fn moved() {
    let mut w = W { inner: S { id: 1u8 }, tag: 0u8 };
    let taken = w.inner;
    w.inner = S { id: 2u8 };
    emit_digit(9u8);
}

pub fn main() -> i32 {
    emit_digit(run(2u8));
    emit_digit(run(5u8));
    moved();
    0
}
