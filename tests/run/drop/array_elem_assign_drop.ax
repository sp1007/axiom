// test: run
// modes: interp native
// stdout: 2\n3\n7\n1\n9\n8\n5\n6\n
//
// T141 round 1 (SPEC-03 AXS-SEM-042/043): assigning to an array element whose type needs drop
// drops the element's old value after the rhs (and the index) are evaluated: the rhs of the third
// store prints its creation digit before the old element's destructor runs. Expected output
// written by hand:
//   arr[1] = S{5}           -> old arr[1] (2) dropped                       -> 2
//   arr[2] = S{6}           -> old arr[2] (3) dropped                       -> 3
//   arr[0] = make(8)        -> make prints 7, then old arr[0] (1) dropped   -> 7 1
//   9 printed; scope end drops the elements in index order: 8, 5, 6.

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct StrRepr {
    ptr: *const u8,
    len: usize,
}

fn emit_digit(d: u8) {
    let buf: [2]u8 = [48u8 + d, 10u8];
    let v: view<[2]u8> = view(buf);
    let p: *const u8 = unsafe { *(address_of(v) as *const *const u8) };
    let repr = StrRepr { ptr: p, len: 2 };
    let s: str = unsafe { *(address_of(repr) as *const str) };
    print(s);
}

struct S {
    pub id: u8,
}

impl Drop for S {
    fn drop(self: mut_view<Self>) {
        emit_digit(self.id);
    }
}

fn make(id: u8) -> S {
    emit_digit(7u8);
    S { id: id }
}

pub fn main() -> i32 {
    {
        let mut arr: [3]S = [S { id: 1u8 }, S { id: 2u8 }, S { id: 3u8 }];
        arr[1] = S { id: 5u8 };
        arr[2] = S { id: 6u8 };
        arr[0] = make(8u8);
        emit_digit(9u8);
    }
    0
}
