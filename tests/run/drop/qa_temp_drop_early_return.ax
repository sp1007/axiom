// test: run
// stdout: loop start\nS1 drop\nearly return\n

struct S1 {}
impl Drop for S1 {
    fn drop(self: mut_view<S1>) {
        print("S1 drop\n");
    }
}

fn returns_s1() -> S1 {
    return S1 {};
}

fn early_return_test() {
    let mut i = 0;
    while i < 2 {
        print("loop start\n");
        returns_s1();
        if i == 0 {
            print("early return\n");
            return;
        }
        i = i + 1;
    }
}

fn main() {
    early_return_test();
}
