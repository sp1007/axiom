// test: run
// modes: interp native
// stdout: 1\n9\n7\n2\n4\n5\n6\n8\n2\n3\n
//
// T141 round 2 (SPEC-03 AXS-SEM-043 step 3, rule "raw-pointer store = no drop; view place = drop"):
// - `self.inner = v` in a method taking `self: mut_view<Self>` drops the old field value;
// - the rhs is evaluated before the old value is dropped (`make` prints 7 before 2 is dropped);
// - a place nested under a view (`o.h.inner`) drops its old value;
// - an explicit `*m = ...` with `m: mut_view<S>` drops the old value;
// - a store through a raw pointer (`*p = ...`, `p: *mut S`) never drops the old value (the old
//   `S { id: 1 }` is overwritten without its destructor; scope end drops the new value 2).
// Expected output written by hand from those rules.

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct StrRepr {
    ptr: *const u8,
    len: usize,
}

fn emit_digit(d: u8) {
    let buf: [2]u8 = [48u8 + d, 10u8];
    let v: view<[2]u8> = view(buf);
    let p: *const u8 = unsafe { *(address_of(v) as *const *const u8) };
    let repr = StrRepr { ptr: p, len: 2 };
    let s: str = unsafe { *(address_of(repr) as *const str) };
    print(s);
}

struct S {
    pub id: u8,
}

impl Drop for S {
    fn drop(self: mut_view<Self>) {
        emit_digit(self.id);
    }
}

fn make(id: u8) -> S {
    emit_digit(7u8);
    S { id: id }
}

struct Holder {
    pub inner: S,
    pub tag: u8,
}

impl Holder {
    fn set(self: mut_view<Self>, v: S) {
        self.inner = v;
    }

    fn set_made(self: mut_view<Self>, id: u8) {
        self.inner = make(id);
    }
}

struct Outer {
    pub h: Holder,
}

fn reset_outer(o: mut_view<Outer>) {
    o.h.inner = S { id: 5u8 };
}

fn replace_view(m: mut_view<S>) {
    *m = S { id: 8u8 };
}

// Takes a raw pointer to the viewed value and stores through it: a raw store.
fn raw_store(m: mut_view<S>) {
    let p: *mut S = unsafe { address_of_mut(*m) };
    unsafe { *p = S { id: 2u8 }; }
}

pub fn main() -> i32 {
    {
        let mut h = Holder { inner: S { id: 1u8 }, tag: 0u8 };
        h.set(S { id: 2u8 });
        emit_digit(9u8);
        h.set_made(3u8);
        {
            let mut o = Outer { h: Holder { inner: S { id: 4u8 }, tag: 0u8 } };
            reset_outer(mut_view(o));
        }
        {
            let mut a = S { id: 6u8 };
            replace_view(mut_view(a));
        }
        {
            let mut b = S { id: 1u8 };
            raw_store(mut_view(b));
        }
    }
    0
}
