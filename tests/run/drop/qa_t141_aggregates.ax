// test: run
// modes: interp native
// stdout: 9\n1\n2\n3\n4\n5\n6\n
//
// T141 QA: scalar-only `impl Drop` structs nested in aggregates the needs-drop predicate recurses
// into (array, tuple, enum payload, plain wrapper struct without its own Drop).
// Expected order written by hand from SPEC-12 AXS-DROP-002 (locals in reverse declaration order;
// fields / elements in declaration order):
//   9 is printed before the block ends; locals are declared e, w, t, arr, n and dropped
//   n (nothing), arr[0]=1, arr[1]=2, t.0=3, w.a=4, w.b=5, e's payload=6.

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct StrRepr {
    ptr: *const u8,
    len: usize,
}

fn emit_digit(d: u8) {
    let buf: [2]u8 = [48u8 + d, 10u8];
    let v: view<[2]u8> = view(buf);
    let p: *const u8 = unsafe { *(address_of(v) as *const *const u8) };
    let repr = StrRepr { ptr: p, len: 2 };
    let s: str = unsafe { *(address_of(repr) as *const str) };
    print(s);
}

struct S {
    pub id: u8,
}

impl Drop for S {
    fn drop(self: mut_view<Self>) {
        emit_digit(self.id);
    }
}

struct Wrap {
    pub a: S,
    pub tag: u32,
    pub b: S,
}

enum Holder {
    Some(S),
    Nothing,
}

pub fn main() -> i32 {
    {
        let e = Holder.Some(S { id: 6u8 });
        let w = Wrap { a: S { id: 4u8 }, tag: 7u32, b: S { id: 5u8 } };
        let t = (S { id: 3u8 }, 1u32);
        let arr: [2]S = [S { id: 1u8 }, S { id: 2u8 }];
        let n = Holder.Nothing;
        emit_digit(9u8);
    }
    0
}
