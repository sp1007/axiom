// test: run
// modes: interp native
// stdout: 1\n9\n2\n
//
// T141 QA: SPEC-03 AXS-SEM-043's own example `x = transform(x)` ("reads the old x") with a
// scalar-only `impl Drop` type. The rhs moves x into transform, so step (3) finds x MOVED and drops
// nothing (AXS-DROP-003 drop flag); transform drops its parameter (prints 1); the new x (id 2) is
// dropped at scope end after 9. Expected output written by hand.

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct StrRepr {
    ptr: *const u8,
    len: usize,
}

fn emit_digit(d: u8) {
    let buf: [2]u8 = [48u8 + d, 10u8];
    let v: view<[2]u8> = view(buf);
    let p: *const u8 = unsafe { *(address_of(v) as *const *const u8) };
    let repr = StrRepr { ptr: p, len: 2 };
    let s: str = unsafe { *(address_of(repr) as *const str) };
    print(s);
}

struct S {
    pub id: u8,
}

impl Drop for S {
    fn drop(self: mut_view<Self>) {
        emit_digit(self.id);
    }
}

fn transform(s: S) -> S {
    S { id: s.id + 1u8 }
}

pub fn main() -> i32 {
    {
        let mut x = S { id: 1u8 };
        x = transform(x);
        emit_digit(9u8);
    }
    0
}
