// test: run
// modes: interp native
// stdout: 6\n2\n3\n7\n8\n1\n

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct StrRepr {
    ptr: *const u8,
    len: usize,
}

fn emit_digit(d: u8) {
    let buf: [2]u8 = [48u8 + d, 10u8];
    let v: view<[2]u8> = view(buf);
    let p: *const u8 = unsafe { *(address_of(v) as *const *const u8) };
    let repr = StrRepr { ptr: p, len: 2 };
    let s: str = unsafe { *(address_of(repr) as *const str) };
    print(s);
}

struct Token {
    pub id: u8,
}

impl Drop for Token {
    fn drop(self: mut_view<Self>) {
        emit_digit(self.id);
    }
}

fn consume(t: Token) {
    emit_digit(t.id + 4u8);
}

pub fn main() -> i32 {
    {
        let t1 = Token { id: 1u8 };
        let t2 = t1;

        let t_arg = Token { id: 2u8 };
        consume(t_arg);

        let t_explicit = Token { id: 3u8 };
        drop(t_explicit);
        emit_digit(7u8);

        emit_digit(8u8);
    }
    0
}
