// native-after: T051
// test: run
// stdout: 1\n

struct Droppable1 {}
impl Drop for Droppable1 {
    fn drop(self: mut_view<Droppable1>) {
        let x: i64 = 1;
        print_int(x);
        print("\n");
    }
}

struct Wrapper {
    d: Droppable1,
}

fn consume(d: Droppable1) {
    // prints 1 when dropping argument
}

fn main() {
    let w = Wrapper { d: Droppable1 {} };
    // Partial move
    consume(w.d);
    // When main returns, w is dropped, but its field 'd' is already moved out.
    // However, our MVP fix just disables the drop for the entire local 'w'
    // when any field is moved. Let's make sure it doesn't print a second '1\n'.
}
