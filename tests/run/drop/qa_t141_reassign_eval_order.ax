// test: run
// modes: interp native
// stdout: 5\n6\n1\n2\n9\n3\n
//
// T141 QA (AXS-SEM-043 + SPEC-12): `place = rhs` evaluates rhs FIRST, then drops the old value,
// then stores. The destructor of the old value zeroes its id, so reading `x.id` in the rhs after a
// premature drop would yield 0 (the new value would print 1 instead of 3), and `make(2)` must print
// its creation digit (6) before the old value's destructor digit (1). Expected output written by
// hand from SPEC-03 AXS-SEM-043 steps (1)-(4).

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct StrRepr {
    ptr: *const u8,
    len: usize,
}

fn emit_digit(d: u8) {
    let buf: [2]u8 = [48u8 + d, 10u8];
    let v: view<[2]u8> = view(buf);
    let p: *const u8 = unsafe { *(address_of(v) as *const *const u8) };
    let repr = StrRepr { ptr: p, len: 2 };
    let s: str = unsafe { *(address_of(repr) as *const str) };
    print(s);
}

struct S {
    pub id: u8,
}

impl Drop for S {
    fn drop(self: mut_view<Self>) {
        emit_digit(self.id);
        self.id = 0u8;
    }
}

fn make(id: u8) -> S {
    emit_digit(id + 4u8);
    S { id: id }
}

pub fn main() -> i32 {
    {
        let mut x = make(1u8);
        x = make(2u8);
        x = S { id: x.id + 1u8 };
        emit_digit(9u8);
    }
    0
}
