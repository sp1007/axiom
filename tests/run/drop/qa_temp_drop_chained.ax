// test: run
// stdout: S1 drop\nS2 drop\nafter\n

struct S1 {}
impl Drop for S1 {
    fn drop(self: mut_view<S1>) {
        print("S1 drop\n");
    }
}

struct S2 {}
impl Drop for S2 {
    fn drop(self: mut_view<S2>) {
        print("S2 drop\n");
    }
}

fn returns_s1() -> S1 {
    return S1 {};
}

fn takes_s1_returns_s2(s: S1) -> S2 {
    return S2 {};
}

fn main() {
    takes_s1_returns_s2(returns_s1());
    print("after\n");
}
