// test: run
// modes: interp native
// stdout: 0\n3\n4\n1\n2\n5\n

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct StrRepr {
    ptr: *const u8,
    len: usize,
}

fn emit_digit(d: u8) {
    let buf: [2]u8 = [48u8 + d, 10u8];
    let v: view<[2]u8> = view(buf);
    let p: *const u8 = unsafe { *(address_of(v) as *const *const u8) };
    let repr = StrRepr { ptr: p, len: 2 };
    let s: str = unsafe { *(address_of(repr) as *const str) };
    print(s);
}

struct Inner {
    pub id: u8,
}

impl Drop for Inner {
    fn drop(self: mut_view<Self>) {
        emit_digit(self.id);
    }
}

struct Outer {
    pub a: Inner,
    pub b: i32,
    pub c: Inner,
}

pub fn main() -> i32 {
    {
        let a1 = Inner { id: 1u8 };
        let c1 = Inner { id: 2u8 };
        let first = Outer { a: a1, b: 99, c: c1 };
        let a2 = Inner { id: 3u8 };
        let c2 = Inner { id: 4u8 };
        let second = Outer { a: a2, b: 77, c: c2 };
        emit_digit(0u8);
    }
    emit_digit(5u8);
    0
}
