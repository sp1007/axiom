// test: run
// modes: interp native
// stdout: 2\n1\n4\n3\n5\n

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct StrRepr {
    ptr: *const u8,
    len: usize,
}

fn emit_digit(d: u8) {
    let buf: [2]u8 = [48u8 + d, 10u8];
    let v: view<[2]u8> = view(buf);
    let p: *const u8 = unsafe { *(address_of(v) as *const *const u8) };
    let repr = StrRepr { ptr: p, len: 2 };
    let s: str = unsafe { *(address_of(repr) as *const str) };
    print(s);
}

struct Guard {
    pub id: u8,
}

impl Drop for Guard {
    fn drop(self: mut_view<Self>) {
        emit_digit(self.id);
    }
}

fn run_branch(early: bool) -> u8 {
    let g1 = Guard { id: if early { 1u8 } else { 3u8 } };
    if early {
        let g2 = Guard { id: 2u8 };
        return 4u8;
    }
    5u8
}

pub fn main() -> i32 {
    let r1 = run_branch(true);
    emit_digit(r1);
    let r2 = run_branch(false);
    emit_digit(r2);
    0
}
