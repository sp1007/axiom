// test: run
// modes: interp native
// stdout: 1\n2\n3\n8\n9\n

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct StrRepr {
    ptr: *const u8,
    len: usize,
}

fn emit_digit(d: u8) {
    let buf: [2]u8 = [48u8 + d, 10u8];
    let v: view<[2]u8> = view(buf);
    let p: *const u8 = unsafe { *(address_of(v) as *const *const u8) };
    let repr = StrRepr { ptr: p, len: 2 };
    let s: str = unsafe { *(address_of(repr) as *const str) };
    print(s);
}

struct LoopGuard {
    pub step: u8,
}

impl Drop for LoopGuard {
    fn drop(self: mut_view<Self>) {
        emit_digit(self.step);
    }
}

pub fn main() -> i32 {
    {
        let outer = LoopGuard { step: 9u8 };
        let mut i: u8 = 1u8;
        while i <= 5u8 {
            let g = LoopGuard { step: i };
            if i == 1u8 {
                i = i + 1u8;
                continue;
            }
            if i == 3u8 {
                break;
            }
            i = i + 1u8;
        }
        emit_digit(8u8);
    }
    0
}
