// test: run
// native-after: T059
struct Point {
    x: u32,
    y: u32,
}

impl Point {
    fn new(x: u32, y: u32) -> Point {
        Point { x: x, y: y }
    }

    fn sum(self: view<Point>) -> u32 {
        self.x + self.y
    }

    fn shift(self: mut_view<Point>, dx: u32, dy: u32) {
        self.x = self.x + dx;
        self.y = self.y + dy;
    }

    fn into_sum(self: Point) -> u32 {
        self.x + self.y
    }
}

fn main() {
    let mut p = Point.new(10, 20);
    { print_int(p.sum()); } // 30
    print("\n");
    { p.shift(5, 5); }
    { print_int(p.sum()); } // 40
    print("\n");
    
    // UFCS
    { print_int(Point.sum(view(p))); } // 40
    print("\n");
    { Point.shift(mut_view(p), 2, 2); } 
    { print_int(Point.sum(view(p))); } // 44
    print("\n");
    
    print_int(Point.into_sum(p)); // 44
    print("\n");
}
