// test: run
// modes: interp native
// exit: 0
// stdout: SPEC_BANNER=IPA_CallSite_Const_Closure_Specialization\nSPEC_CONST_BOOL=78\nSPEC_ENUM_TAG=100\nSPEC_FN_CLOSURE=73\nSPEC_PARTIAL=220\nSPEC_REP_IDENTITY=100\nSPEC_TOTAL=571\n

@derive(Copy)
enum OpMode {
    Linear(i32),
    Affine(i32, i32),
    Clamp(i32),
}

// 1. Constant boolean & scalar call-site specialization (`AXS-INL-030.1`, `REQ-OPT-090`)
fn spec_const_mode(x: i32, fast_path: bool) -> i32 {
    if fast_path {
        (x * 4) + 10
    } else {
        (x * 2) - 4
    }
}

// 2. Enum-tag call-site specialization (`AXS-INL-030.1`)
fn spec_enum_dispatch(mode: OpMode, val: i32) -> i32 {
    match mode {
        OpMode.Linear(k) => (val * k) + 3,
        OpMode.Affine(a, b) => (val * a) + b,
        OpMode.Clamp(hi) => if val > hi { hi } else { val },
    }
}

// 3. Higher-order function / closure parameter specialization (`AXS-INL-030.1`, `REQ-OPT-091`)
fn step_scale_plus_two(acc: i32, idx: i32) -> i32 {
    (acc * 2) + idx + 2
}

fn spec_higher_order(step: fn(i32, i32) -> i32, seed: i32, rounds: i32) -> i32 {
    let mut acc: i32 = seed;
    let mut i: i32 = 1;
    while i <= rounds {
        acc = step(acc, i);
        i = i + 1;
    }
    acc
}

// 4. Partial call-site specialization (`AXS-INL-030.3`, `REQ-OPT-092`):
// `bias` and `scale` are call-site constants while `dyn_x` and `dyn_y` remain runtime parameters.
fn partial_spec_pipeline(bias: i32, scale: i32, dyn_x: i32, dyn_y: i32) -> i32 {
    if scale <= 0 {
        return bias;
    }
    ((dyn_x + dyn_y) * scale) + bias
}

// 5. Representation-equivalent functions with address taken (`AXS-INL-029`, `REQ-OPT-098..099`)
fn rep_equiv_alpha(v: i32) -> i32 {
    v + 15
}

fn rep_equiv_beta(v: i32) -> i32 {
    v + 15
}

fn call_rep_fn(f: fn(i32) -> i32, x: i32) -> i32 {
    f(x)
}

fn main() -> i32 {
    print("SPEC_BANNER=IPA_CallSite_Const_Closure_Specialization\n");

    let v_bool: i32 = spec_const_mode(12, true) + spec_const_mode(12, false);
    print("SPEC_CONST_BOOL=");
    print_int(v_bool);
    print("\n");

    let v_enum: i32 = spec_enum_dispatch(OpMode.Linear(5), 10) +
                      spec_enum_dispatch(OpMode.Affine(4, 7), 10);
    print("SPEC_ENUM_TAG=");
    print_int(v_enum);
    print("\n");

    let v_ho: i32 = spec_higher_order(step_scale_plus_two, 6, 3);
    print("SPEC_FN_CLOSURE=");
    print_int(v_ho);
    print("\n");

    let rt_x: i32 = 25;
    let rt_y: i32 = 15;
    let v_part: i32 = partial_spec_pipeline(100, 3, rt_x, rt_y);
    print("SPEC_PARTIAL=");
    print_int(v_part);
    print("\n");

    let fa: fn(i32) -> i32 = rep_equiv_alpha;
    let fb: fn(i32) -> i32 = rep_equiv_beta;
    let v_rep: i32 = call_rep_fn(fa, 30) + call_rep_fn(fb, 40);
    print("SPEC_REP_IDENTITY=");
    print_int(v_rep);
    print("\n");

    let total: i32 = v_bool + v_enum + v_ho + v_part + v_rep;
    print("SPEC_TOTAL=");
    print_int(total);
    print("\n");

    if total != 571 {
        return 1;
    }
    0
}
