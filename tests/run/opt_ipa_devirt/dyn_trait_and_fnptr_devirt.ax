// test: run
// modes: interp native
// exit: 0
// stdout: DEVIRT_BANNER=Devirt_Trait_FnPtr_Three_Tier\nDEVIRT_STATIC_TRAIT=164\nDEVIRT_TIER1_EXACT=130\nDEVIRT_TIER2_GUARDED=100\nDEVIRT_TIER3_DYNAMIC=200\nDEVIRT_TOTAL=594\n

trait Evaluator {
    fn eval_at(self: view<Self>, x: i32) -> i32;
}

struct LinearEval {
    weight: i32,
    offset: i32,
}

impl Evaluator for LinearEval {
    fn eval_at(self: view<LinearEval>, x: i32) -> i32 {
        (x * self.weight) + self.offset
    }
}

struct QuadraticEval {
    a: i32,
    b: i32,
    c: i32,
}

impl Evaluator for QuadraticEval {
    fn eval_at(self: view<QuadraticEval>, x: i32) -> i32 {
        (self.a * x * x) + (self.b * x) + self.c
    }
}

// 1. Static trait dispatch + SROA scalarization (`REQ-OPT-103`, `REQ-OPT-105`, `REQ-OPT-112`)
fn test_static_trait_devirt() -> i32 {
    let lin = LinearEval { weight: 4, offset: 9 };
    let quad = QuadraticEval { a: 2, b: 3, c: 5 };
    lin.eval_at(15) + quad.eval_at(6)
}

// 2. Tier 1 (`DEVIRT_EXACT`): single proven concrete target (`AXS-INL-032.1`, `REQ-OPT-104`, `REQ-OPT-315`)
fn exact_target_mul3_plus7(x: i32) -> i32 {
    (x * 3) + 7
}

struct VtableSlot {
    bias: i32,
    invoke: fn(i32, i32) -> i32,
}

fn vtable_impl_five(bias: i32, x: i32) -> i32 {
    (x * 5) + bias
}

fn test_tier1_exact_devirt(x: i32, y: i32) -> i32 {
    let fp: fn(i32) -> i32 = exact_target_mul3_plus7;
    let slot = VtableSlot {
        bias: 8,
        invoke: vtable_impl_five,
    };
    let f_slot: fn(i32, i32) -> i32 = slot.invoke;
    fp(x) + f_slot(slot.bias, y)
}

// 3. Tier 2 (`DEVIRT_GUARDED`): finite 2-target guarded dispatch (`AXS-INL-032.2`, `REQ-OPT-106`)
fn target_add_ten(x: i32) -> i32 {
    x + 10
}

fn target_mul_four(x: i32) -> i32 {
    x * 4
}

fn run_guarded_two_targets(sel: i32, x: i32) -> i32 {
    let f: fn(i32) -> i32 = if sel == 0 {
        target_add_ten
    } else {
        target_mul_four
    };
    f(x)
}

// 4. Tier 3 (`DEVIRT_RETAINED_DYNAMIC`): multi-target dynamic table retention (`AXS-INL-032.3`, `REQ-OPT-107`)
fn target_sub_forty_seven(x: i32) -> i32 {
    x - 47
}

fn step_dynamic_table(idx: i32, acc: i32) -> i32 {
    let f: fn(i32) -> i32 = if idx == 0 {
        target_add_ten
    } else if idx == 1 {
        target_mul_four
    } else if idx == 2 {
        exact_target_mul3_plus7
    } else {
        target_sub_forty_seven
    };
    f(acc)
}

fn run_dynamic_pipeline(seed: i32) -> i32 {
    let mut cur: i32 = seed;
    let mut i: i32 = 0;
    while i < 4 {
        cur = step_dynamic_table(i, cur);
        i = i + 1;
    }
    cur
}

fn main() -> i32 {
    print("DEVIRT_BANNER=Devirt_Trait_FnPtr_Three_Tier\n");

    let v_static: i32 = test_static_trait_devirt();
    print("DEVIRT_STATIC_TRAIT=");
    print_int(v_static);
    print("\n");

    let v_exact: i32 = test_tier1_exact_devirt(20, 11);
    print("DEVIRT_TIER1_EXACT=");
    print_int(v_exact);
    print("\n");

    let v_guarded: i32 = run_guarded_two_targets(0, 18) + run_guarded_two_targets(1, 18);
    print("DEVIRT_TIER2_GUARDED=");
    print_int(v_guarded);
    print("\n");

    let v_dyn: i32 = run_dynamic_pipeline(10);
    print("DEVIRT_TIER3_DYNAMIC=");
    print_int(v_dyn);
    print("\n");

    let total: i32 = v_static + v_exact + v_guarded + v_dyn;
    print("DEVIRT_TOTAL=");
    print_int(total);
    print("\n");

    if total != 594 {
        return 1;
    }
    0
}
