@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

@PROBE_MIR_FN@

fn probe_blob(arena: mut_view<Arena>, idx: usize) -> StrView {
    let s: str = probe_mir_raw(idx);
    let raw_sv: StrView = unsafe { *(address_of(s) as *const StrView) };
    let bytes: view<[u8]> = unsafe { *(address_of(s) as *const view<[u8]>) };
    let n = raw_sv.len;
    let dst = arena_alloc_raw(mut_view(*arena), n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = bytes[i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn diag_buf_eq(a: view<DiagBuffer>, b: view<DiagBuffer>) -> bool {
    if a.len != b.len {
        return false;
    }
    let mut i: usize = 0;
    while i < a.len {
        let ba = unsafe { *(a.ptr + i) };
        let bb = unsafe { *(b.ptr + i) };
        if ba != bb {
            return false;
        }
        i = i + 1;
    }
    true
}

fn empty_node_map() -> NodeMap {
    NodeMap { keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0 }
}

fn new_arena(chunk: usize) -> Arena {
    let mut a = arena_with_chunk_size(chunk);
    let _ = arena_alloc_raw(mut_view(a), 16, 8);
    a
}

fn probe_init_fe_session(perm_arena: mut_view<Arena>) -> *mut CompilerSession {
    let sess_ptr = arena_alloc_raw(mut_view(*perm_arena), size_of<CompilerSession>(), align_of<CompilerSession>()) as *mut CompilerSession;
    let str_bytes_arena = new_arena(262144);
    let str_cap: usize = 2048;
    let str_arr = arena_alloc_raw(mut_view(*perm_arena), mir_mul_usize(str_cap, size_of<StrView>()), align_of<StrView>()) as *mut StrView;
    let smap_cap: usize = 4096;
    let smap_hashes = arena_alloc_raw(mut_view(*perm_arena), mir_mul_usize(smap_cap, 8), 8) as *mut u64;
    let smap_ids = arena_alloc_raw(mut_view(*perm_arena), mir_mul_usize(smap_cap, 4), 4) as *mut u32;
    unsafe {
        session_init(mut_view(*sess_ptr));
        arena_destroy(mut_view((*sess_ptr).interner.bytes));
        (*sess_ptr).interner.bytes = str_bytes_arena;
        (*sess_ptr).interner.strings = str_arr;
        (*sess_ptr).interner.cap = str_cap;
        (*sess_ptr).interner.map_hashes = smap_hashes;
        (*sess_ptr).interner.map_ids = smap_ids;
        (*sess_ptr).interner.map_cap = smap_cap;
    }
    sess_ptr
}

fn probe_free_fe_session(sess_ptr: *mut CompilerSession) {
    unsafe {
        (*sess_ptr).interner.cap = 0;
        (*sess_ptr).interner.map_cap = 0;
        session_free(mut_view(*sess_ptr));
    }
}

// Section 1: Interprocedural Specialization (`SpecializationKey`, Clone Mangling, Rep-Equiv Identity, Budget, & Cleanup)
fn probe_ipa_specialization_and_sharing() -> i32 {
    let sc = ipa_specialize_contract();
    if sc.pass_id != PASS_IPA_SPECIALIZE || sc.pass_id != 15u16 ||
       sc.preserved_analyses != (ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA | ANALYSIS_MASK_MEMORY_SSA) ||
       sc.postconditions != POSTCOND_ALL {
        return 101;
    }

    // 1a. Verify canonical `SpecializationKey` ordering and deterministic mangling (`AXS-INL-028`, `REQ-OPT-087`, `REQ-OPT-095`)
    let mut k1 = ipa_spec_key_new(SymbolId { v: 42u32 });
    ipa_spec_key_add_const_int(mut_view(k1), 2u16, 100u64, TypeId { v: 1u32 });
    ipa_spec_key_add_const_bool(mut_view(k1), 1u16, true, TypeId { v: 2u32 });
    ipa_spec_key_add_enum_tag(mut_view(k1), 4u16, 2u64, TypeId { v: 3u32 });
    ipa_spec_key_add_closure_or_fn(mut_view(k1), 3u16, SPEC_ARG_CLOSURE_SYM, SymbolId { v: 77u32 }, TypeId { v: 4u32 });

    let mut k2 = ipa_spec_key_new(SymbolId { v: 42u32 });
    ipa_spec_key_add_closure_or_fn(mut_view(k2), 3u16, SPEC_ARG_CLOSURE_SYM, SymbolId { v: 77u32 }, TypeId { v: 4u32 });
    ipa_spec_key_add_enum_tag(mut_view(k2), 4u16, 2u64, TypeId { v: 3u32 });
    ipa_spec_key_add_const_bool(mut_view(k2), 1u16, true, TypeId { v: 2u32 });
    ipa_spec_key_add_const_int(mut_view(k2), 2u16, 100u64, TypeId { v: 1u32 });

    let mut k3 = ipa_spec_key_new(SymbolId { v: 42u32 });
    ipa_spec_key_add_const_int(mut_view(k3), 2u16, 100u64, TypeId { v: 1u32 });
    ipa_spec_key_add_const_bool(mut_view(k3), 1u16, false, TypeId { v: 2u32 });
    ipa_spec_key_add_enum_tag(mut_view(k3), 4u16, 2u64, TypeId { v: 3u32 });
    ipa_spec_key_add_closure_or_fn(mut_view(k3), 3u16, SPEC_ARG_CLOSURE_SYM, SymbolId { v: 77u32 }, TypeId { v: 4u32 });

    if !ipa_spec_key_equals(view(k1), view(k2)) ||
       ipa_spec_key_fingerprint(view(k1)) != ipa_spec_key_fingerprint(view(k2)) ||
       ipa_spec_clone_sym(view(k1)).v != ipa_spec_clone_sym(view(k2)).v ||
       ipa_spec_key_equals(view(k1), view(k3)) ||
       ipa_spec_clone_sym(view(k1)).v == ipa_spec_clone_sym(view(k3)).v {
        return 102;
    }
    print("PROBE_IPA_CONTRACT_AND_KEY=OK\n");

    // 1b. Verify representation-equivalent code sharing vs `address_taken_fn` (`AXS-INL-029`, `REQ-OPT-098..099`)
    //     and `SpecializationBudget` across profiles (`AXS-INL-031`)
    let rep_a = RepEquivDesc {
        fn_sym: SymbolId { v: 10u32 }, type_size: 8u32, type_align: 8u32, abi_class: 1u8,
        has_custom_drop: false, body_fingerprint: 0x12345678u64, address_taken_fn: false,
    };
    let rep_b = RepEquivDesc {
        fn_sym: SymbolId { v: 11u32 }, type_size: 8u32, type_align: 8u32, abi_class: 1u8,
        has_custom_drop: false, body_fingerprint: 0x12345678u64, address_taken_fn: false,
    };
    let rep_addr_taken = RepEquivDesc {
        fn_sym: SymbolId { v: 12u32 }, type_size: 8u32, type_align: 8u32, abi_class: 1u8,
        has_custom_drop: false, body_fingerprint: 0x12345678u64, address_taken_fn: true,
    };
    let rep_custom_drop = RepEquivDesc {
        fn_sym: SymbolId { v: 13u32 }, type_size: 8u32, type_align: 8u32, abi_class: 1u8,
        has_custom_drop: true, body_fingerprint: 0x12345678u64, address_taken_fn: false,
    };

    let sb_o0 = ipa_budget_for_profile(OPT_PROFILE_DEBUG_O0);
    let sb_os = ipa_budget_for_profile(OPT_PROFILE_SIZE_OS);
    let sb_oz = ipa_budget_for_profile(OPT_PROFILE_MINSIZE_OZ);
    let sb_o1 = ipa_budget_for_profile(OPT_PROFILE_BALANCED_O1);
    let sb_o2 = ipa_budget_for_profile(OPT_PROFILE_SPEED_O2);
    let sb_o3 = ipa_budget_for_profile(OPT_PROFILE_MAX_O3);

    if !ipa_can_share_representation(view(rep_a), view(rep_b)) ||
       ipa_can_share_representation(view(rep_a), view(rep_addr_taken)) ||
       ipa_can_share_representation(view(rep_a), view(rep_custom_drop)) ||
       sb_o0.max_clones_per_fn != 0u32 || sb_os.max_clones_per_fn != 0u32 || sb_oz.max_clones_per_fn != 0u32 ||
       sb_o1.max_clones_per_fn != 2u32 || sb_o2.max_clones_per_fn != 8u32 || sb_o3.max_clones_per_fn != 16u32 ||
       sb_o2.max_module_growth_pct != 25u32 {
        return 103;
    }
    print("PROBE_IPA_REP_EQUIV_AND_BUDGET=OK\n");

    // 1c. Parse Blob 1 (`ipa_spec.ax`) and run call-site specialization + cache reuse + clone cap + rollback + `--emit=specialize`
    let mut perm_a = new_arena(524288);
    let mut parse_a = new_arena(262144);
    let mut res_a = new_arena(262144);
    let mut hir_a = new_arena(262144);
    let mut mir_a = new_arena(1048576);
    let sess = probe_init_fe_session(mut_view(perm_a));
    let thir_fe = arena_alloc_raw(mut_view(perm_a), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    unsafe { thir_init(mut_view(*thir_fe)); }
    let mut rmap = ResolveMap {
        node_map: empty_node_map(), module_access_nodes: empty_node_map(), extern_nodes: empty_node_map(),
        next_symbol_v: 1u32, next_std_symbol_v: 10000u32, naming_ctx: 0 as *mut NamingCtx,
    };

    let path_sv = probe_blob(mut_view(perm_a), 0);
    let src1_sv = probe_blob(mut_view(perm_a), 1);
    let mut fid = FileId { v: 0u32 };
    let pres = session_parse_virtual_file(unsafe { mut_view(*sess) }, mut_view(parse_a), path_sv, src1_sv, mut_view(fid));
    session_resolve_ast_into(unsafe { mut_view(*sess) }, mut_view(res_a), view(pres.ast), mut_view(rmap));
    let hir1 = session_lower_hir(unsafe { mut_view(*sess) }, mut_view(hir_a), view(pres.ast), view(rmap));
    unsafe { session_typeck_into(mut_view(*sess), view(hir1), mut_view(*thir_fe)); }
    if (unsafe { (*sess).diag_sink.errors }) != 0 {
        resolve_map_free(mut_view(rmap));
        unsafe { thir_free(mut_view(*thir_fe)); }
        probe_free_fe_session(sess);
        arena_destroy(mut_view(mir_a)); arena_destroy(mut_view(hir_a)); arena_destroy(mut_view(res_a));
        arena_destroy(mut_view(parse_a)); arena_destroy(mut_view(perm_a));
        return 104;
    }

    let str_in_ptr = unsafe { address_of_mut((*sess).interner) as *mut StrInterner };
    let db_ptr = unsafe { address_of((*sess).source_db) as *const SourceDatabase };
    let sink_fe = unsafe { address_of_mut((*sess).diag_sink) as *mut DiagSink };
    let hir_ptr = unsafe { address_of(hir1.items) as *const HirFile };
    let ct_fe = arena_alloc_raw(mut_view(mir_a), size_of<EffectCallTable>(), align_of<EffectCallTable>()) as *mut EffectCallTable;
    effect_call_table_init(unsafe { mut_view(*ct_fe) }, mut_view(mir_a), 32);
    let esc_tbl = arena_alloc_raw(mut_view(mir_a), size_of<EscapeSummaryTable>(), align_of<EscapeSummaryTable>()) as *mut EscapeSummaryTable;
    escape_summary_table_init(unsafe { mut_view(*esc_tbl) }, mut_view(mir_a), 32);

    let cg = callgraph_new(mut_view(mir_a), thir_fe as *const Thir, true, false);
    let mut fn_idx: usize = 0;
    let mut it: *mut HirItem = hir1.items;
    while (it as usize) != 0 {
        if (unsafe { (*it).kind }) == HIR_ITEM_FN && ((unsafe { (*it).attrs }) as usize) == 0 {
            let mbody = mir_build_fn(mut_view(mir_a), it, thir_fe, hir_ptr, str_in_ptr, db_ptr, 0 as *mut MonoEngine);
            if (mbody as usize) != 0 {
                let ob = optir_build_from_mir(unsafe { view(*mbody) }, thir_fe as *const Thir, mut_view(mir_a), unsafe { mut_view(*sink_fe) }, it as *const HirItem);
                let _ = callgraph_add_node(
                    unsafe { mut_view(*cg) },
                    mut_view(mir_a),
                    unsafe { (*it).symbol },
                    unsafe { (*it).name },
                    mbody,
                    ob,
                    it as *const HirItem,
                    INLINE_ATTR_NONE,
                    false,
                    fn_idx == 2,
                    false,
                    false,
                    DOMAIN_CPU_HOST,
                    false
                );
                fn_idx = fn_idx + 1;
            }
        }
        it = unsafe { (*it).next };
    }

    let mut rc: i32 = 0;
    if fn_idx != 3 {
        rc = 105;
    }

    // Test transactional rollback when `force_verify_fail = true`
    if rc == 0 {
        callgraph_finalize(unsafe { mut_view(*cg) }, unsafe { mut_view(*ct_fe) }, unsafe { mut_view(*esc_tbl) }, mut_view(mir_a));
        let n2_ob = unsafe { (*cg_node_at((*cg).nodes, 2)).opt_body };
        let pm_sp = arena_alloc_raw(mut_view(mir_a), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
        passmgr_init(unsafe { mut_view(*pm_sp) }, opt_budget_for_profile(OPT_PROFILE_SPEED_O2, true), mut_view(mir_a));
        passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_sp) }, unsafe { mut_view(*n2_ob) }, mut_view(mir_a));
        let rb_tbl = ipa_spec_table_new(mut_view(mir_a), 500u32);
        let mut rb_stats = ipa_spec_stats_zero();
        let rb_log = ipa_spec_log_new(mut_view(mir_a), 16);
        let rb_chg = ipa_run_specialize_pass_internal(
            unsafe { mut_view(*pm_sp) },
            unsafe { mut_view(*n2_ob) },
            unsafe { mut_view(*cg) },
            unsafe { mut_view(*rb_tbl) },
            unsafe { mut_view(*ct_fe) },
            unsafe { mut_view(*esc_tbl) },
            mut_view(rb_stats),
            rb_log,
            true,
            mut_view(mir_a),
            unsafe { mut_view(*sink_fe) }
        );
        if rb_chg || rb_stats.pass_rollbacks == 0u32 {
            rc = 106;
        }
    }

    // Run full `ipa_specialize_callgraph` at `-O2` (creates clone for `(true, 10)`, reuses clone for second `(true, 10)` callsite,
    // and creates clone for `(false, 20)`)
    if rc == 0 {
        let mut sp_stats = ipa_spec_stats_zero();
        let sp_log = ipa_spec_log_new(mut_view(mir_a), 32);

        // First verify `max_clones_per_fn` cap rejection when `max_clones_per_fn == 1` (`AXS-INL-031.1`)
        // before `ipa_specialize_callgraph` rewrites the callgraph edges.
        let cap_tbl = ipa_spec_table_new(mut_view(mir_a), 500u32);
        let n1_sym = unsafe { (*cg_node_at((*cg).nodes, 1)).fn_sym };
        let dummy_key = ipa_spec_key_new(n1_sym);
        let dummy_fp = ipa_spec_key_fingerprint(view(dummy_key));
        let _ = ipa_spec_table_insert(unsafe { mut_view(*cap_tbl) }, mut_view(mir_a), SpecCacheEntry {
            key: dummy_key,
            fingerprint: dummy_fp,
            clone_sym: SymbolId { v: 9999u32 },
            clone_node_idx: 0u32,
            inst_before: 10u32,
            inst_after: 6u32,
            effect_flags_after: 0u16,
        });
        let cap_budget = SpecializationBudget {
            profile: OPT_PROFILE_SPEED_O2,
            max_clones_per_fn: 1u32,
            max_module_growth_pct: 100u32,
            min_benefit_score: 10,
        };
        let cap_chg = ipa_specialize_callsite(
            unsafe { mut_view(*cg) },
            2,
            view(cap_budget),
            unsafe { mut_view(*cap_tbl) },
            unsafe { mut_view(*ct_fe) },
            unsafe { mut_view(*esc_tbl) },
            mut_view(sp_stats),
            sp_log,
            false,
            mut_view(mir_a),
            unsafe { mut_view(*sink_fe) }
        );
        if cap_chg || sp_stats.rejected_clone_cap == 0u32 {
            rc = 108;
        }

        let sp_tbl = ipa_specialize_callgraph(
            unsafe { mut_view(*cg) },
            OPT_PROFILE_SPEED_O2,
            unsafe { mut_view(*ct_fe) },
            unsafe { mut_view(*esc_tbl) },
            mut_view(sp_stats),
            sp_log,
            mut_view(mir_a),
            unsafe { mut_view(*sink_fe) }
        );
        if rc == 0 && ((sp_stats.clones_created) < 2u32 || (sp_stats.clones_reused) < 1u32 ||
           (sp_stats.post_spec_cleanups) < 2u32 || sp_stats.pass_rollbacks != 0u32) {
            rc = 107;
        }

        if rc == 0 {
            let mut b1 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
            let mut b2 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
            diag_buf_init(mut_view(b1));
            diag_buf_init(mut_view(b2));
            ipa_specialize_print(unsafe { view(*sp_tbl) }, view(sp_stats), mut_view(b1));
            ipa_specialize_print(unsafe { view(*sp_tbl) }, view(sp_stats), mut_view(b2));
            if (b1.len) < 48 || !diag_buf_eq(view(b1), view(b2)) {
                rc = 109;
            }
            diag_buf_free(mut_view(b1));
            diag_buf_free(mut_view(b2));
        }
    }

    if rc == 0 {
        print("PROBE_IPA_SPECIALIZE_AND_EMIT=OK\n");
    }

    resolve_map_free(mut_view(rmap));
    unsafe { thir_free(mut_view(*thir_fe)); }
    probe_free_fe_session(sess);
    arena_destroy(mut_view(mir_a)); arena_destroy(mut_view(hir_a)); arena_destroy(mut_view(res_a));
    arena_destroy(mut_view(parse_a)); arena_destroy(mut_view(perm_a));
    rc
}

// Section 2: Three-Tier Devirtualization (`DEVIRT_EXACT`, `DEVIRT_GUARDED`, `DEVIRT_RETAINED_DYNAMIC`, Inliner Cascade, & `--emit=devirt`)
fn probe_devirt_three_tier_and_cascade() -> i32 {
    let dc = devirt_contract();
    if dc.pass_id != PASS_DEVIRT || dc.pass_id != 16u16 ||
       dc.preserved_analyses != ANALYSIS_MASK_DOMINATORS ||
       dc.postconditions != POSTCOND_ALL {
        return 201;
    }

    let mut perm_a = new_arena(524288);
    let mut parse_a = new_arena(262144);
    let mut res_a = new_arena(262144);
    let mut hir_a = new_arena(262144);
    let mut mir_a = new_arena(1048576);
    let sess = probe_init_fe_session(mut_view(perm_a));
    let thir_fe = arena_alloc_raw(mut_view(perm_a), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    unsafe { thir_init(mut_view(*thir_fe)); }
    let mut rmap = ResolveMap {
        node_map: empty_node_map(), module_access_nodes: empty_node_map(), extern_nodes: empty_node_map(),
        next_symbol_v: 1u32, next_std_symbol_v: 10000u32, naming_ctx: 0 as *mut NamingCtx,
    };

    let path_sv = probe_blob(mut_view(perm_a), 0);
    let src2_sv = probe_blob(mut_view(perm_a), 2);
    let mut fid = FileId { v: 0u32 };
    let pres = session_parse_virtual_file(unsafe { mut_view(*sess) }, mut_view(parse_a), path_sv, src2_sv, mut_view(fid));
    session_resolve_ast_into(unsafe { mut_view(*sess) }, mut_view(res_a), view(pres.ast), mut_view(rmap));
    let hir2 = session_lower_hir(unsafe { mut_view(*sess) }, mut_view(hir_a), view(pres.ast), view(rmap));
    unsafe { session_typeck_into(mut_view(*sess), view(hir2), mut_view(*thir_fe)); }
    if (unsafe { (*sess).diag_sink.errors }) != 0 {
        resolve_map_free(mut_view(rmap));
        unsafe { thir_free(mut_view(*thir_fe)); }
        probe_free_fe_session(sess);
        arena_destroy(mut_view(mir_a)); arena_destroy(mut_view(hir_a)); arena_destroy(mut_view(res_a));
        arena_destroy(mut_view(parse_a)); arena_destroy(mut_view(perm_a));
        return 202;
    }

    let str_in_ptr = unsafe { address_of_mut((*sess).interner) as *mut StrInterner };
    let db_ptr = unsafe { address_of((*sess).source_db) as *const SourceDatabase };
    let sink_fe = unsafe { address_of_mut((*sess).diag_sink) as *mut DiagSink };
    let hir_ptr = unsafe { address_of(hir2.items) as *const HirFile };
    let ct_fe = arena_alloc_raw(mut_view(mir_a), size_of<EffectCallTable>(), align_of<EffectCallTable>()) as *mut EffectCallTable;
    effect_call_table_init(unsafe { mut_view(*ct_fe) }, mut_view(mir_a), 32);
    let esc_tbl = arena_alloc_raw(mut_view(mir_a), size_of<EscapeSummaryTable>(), align_of<EscapeSummaryTable>()) as *mut EscapeSummaryTable;
    escape_summary_table_init(unsafe { mut_view(*esc_tbl) }, mut_view(mir_a), 32);

    let cg = callgraph_new(mut_view(mir_a), thir_fe as *const Thir, true, false);
    // Functions in Blob 2:
    //   0: target_impl_a
    //   1: target_impl_b
    //   2: caller_exact_devirt (assigns `f = target_impl_a` locally and calls `f(x)`)
    //   3: caller_guarded_devirt (assigns `f = target_impl_a` or `target_impl_b` in branch and calls `f(x)`)
    //   4: caller_open_export (export root taking opaque `f: fn(i32) -> i32` parameter and calling `f(x)`)
    let mut fn_idx: usize = 0;
    let mut it: *mut HirItem = hir2.items;
    while (it as usize) != 0 {
        if (unsafe { (*it).kind }) == HIR_ITEM_FN && ((unsafe { (*it).attrs }) as usize) == 0 {
            let mbody = mir_build_fn(mut_view(mir_a), it, thir_fe, hir_ptr, str_in_ptr, db_ptr, 0 as *mut MonoEngine);
            if (mbody as usize) != 0 {
                let ob = optir_build_from_mir(unsafe { view(*mbody) }, thir_fe as *const Thir, mut_view(mir_a), unsafe { mut_view(*sink_fe) }, it as *const HirItem);
                let attr: u8 = if fn_idx <= 1 { INLINE_ATTR_HINT } else { INLINE_ATTR_NONE };
                let _ = callgraph_add_node(
                    unsafe { mut_view(*cg) },
                    mut_view(mir_a),
                    unsafe { (*it).symbol },
                    unsafe { (*it).name },
                    mbody,
                    ob,
                    it as *const HirItem,
                    attr,
                    false,
                    fn_idx >= 2,
                    false,
                    false,
                    DOMAIN_CPU_HOST,
                    false
                );
                fn_idx = fn_idx + 1;
            }
        }
        it = unsafe { (*it).next };
    }

    let mut rc: i32 = 0;
    if fn_idx != 5 {
        rc = 203;
    }

    if rc == 0 {
        callgraph_finalize(unsafe { mut_view(*cg) }, unsafe { mut_view(*ct_fe) }, unsafe { mut_view(*esc_tbl) }, mut_view(mir_a));

        // 2a. Verify 3-tier classification (`DEVIRT_TIER_EXACT`, `DEVIRT_TIER_GUARDED`, `DEVIRT_TIER_RETAINED_DYNAMIC`)
        let sym_a_v = unsafe { (*cg_node_at((*cg).nodes, 0)).fn_sym.v };
        let sym_b_v = unsafe { (*cg_node_at((*cg).nodes, 1)).fn_sym.v };
        let sym_c4_v = unsafe { (*cg_node_at((*cg).nodes, 4)).fn_sym.v };

        // Closed-world 1-target `DISPATCH_DYN_TRAIT` -> `DEVIRT_TIER_EXACT`
        let one_tgt = arena_alloc_raw(mut_view(mir_a), size_of<SymbolId>(), align_of<SymbolId>()) as *mut SymbolId;
        unsafe { *inl_sym_at(one_tgt, 0) = SymbolId { v: sym_a_v }; }
        let e_dyn_exact = CallEdge {
            edge_id: 10u32, caller_sym: SymbolId { v: sym_c4_v }, caller_node_idx: 4u32,
            callsite_bb: OptBbId { v: 0u32 }, callsite_inst: OptInstId { v: 0u32 },
            dispatch_kind: DISPATCH_DYN_TRAIT, known_callee: SymbolId { v: 0u32 },
            callee_node_idx: INLINE_NONE_IDX, possible_targets: one_tgt, possible_target_count: 1,
            targets_complete: true, is_inlined: false, is_tail_position: false,
            in_loop_depth: 0u32, is_cold_callsite: false, const_arg_mask: 0u64, view_arg_mask: 0u64, closure_arg_mask: 0u64,
            span: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        };
        let c_exact = devirt_classify_callsite(unsafe { view(*cg) }, view(e_dyn_exact), OPT_PROFILE_SPEED_O2);
        if c_exact.tier != DEVIRT_TIER_EXACT || c_exact.exact_callee.v != sym_a_v || !c_exact.targets_complete {
            rc = 204;
        }

        // Closed-world 2-target `DISPATCH_DYN_TRAIT` -> `DEVIRT_TIER_GUARDED`
        let two_tgts = arena_alloc_raw(mut_view(mir_a), mir_mul_usize(2, size_of<SymbolId>()), align_of<SymbolId>()) as *mut SymbolId;
        unsafe {
            *inl_sym_at(two_tgts, 0) = SymbolId { v: sym_a_v };
            *inl_sym_at(two_tgts, 1) = SymbolId { v: sym_b_v };
        }
        let mut e_dyn_guarded = CallEdge {
            edge_id: 11u32, caller_sym: SymbolId { v: sym_c4_v }, caller_node_idx: 4u32,
            callsite_bb: OptBbId { v: 0u32 }, callsite_inst: OptInstId { v: 0u32 },
            dispatch_kind: DISPATCH_DYN_TRAIT, known_callee: SymbolId { v: 0u32 },
            callee_node_idx: INLINE_NONE_IDX, possible_targets: two_tgts, possible_target_count: 2,
            targets_complete: true, is_inlined: false, is_tail_position: false,
            in_loop_depth: 0u32, is_cold_callsite: false, const_arg_mask: 0u64, view_arg_mask: 0u64, closure_arg_mask: 0u64,
            span: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        };
        let c_guarded = devirt_classify_callsite(unsafe { view(*cg) }, view(e_dyn_guarded), OPT_PROFILE_SPEED_O2);
        if c_guarded.tier != DEVIRT_TIER_GUARDED || c_guarded.target_count != 2u32 || !c_guarded.targets_complete {
            rc = 205;
        }

        // Dynamic loading active -> `DEVIRT_TIER_RETAINED_DYNAMIC(DEVIRT_REASON_DYNAMIC_LOADING)` (`REQ-OPT-113`)
        unsafe { (*cg).dynamic_loading_active = true; }
        e_dyn_guarded.targets_complete = false;
        let c_dl = devirt_classify_callsite(unsafe { view(*cg) }, view(e_dyn_guarded), OPT_PROFILE_SPEED_O2);
        unsafe { (*cg).dynamic_loading_active = false; }
        e_dyn_guarded.targets_complete = true;
        if c_dl.tier != DEVIRT_TIER_RETAINED_DYNAMIC || c_dl.reason != DEVIRT_REASON_DYNAMIC_LOADING {
            rc = 206;
        }

        // Open-world unknown target -> `DEVIRT_TIER_RETAINED_DYNAMIC(DEVIRT_REASON_OPEN_WORLD)` (`REQ-OPT-107`)
        unsafe { (*cg).closed_world = false; }
        let e_open = CallEdge {
            edge_id: 12u32, caller_sym: SymbolId { v: sym_c4_v }, caller_node_idx: 4u32,
            callsite_bb: OptBbId { v: 0u32 }, callsite_inst: OptInstId { v: 0u32 },
            dispatch_kind: DISPATCH_DYN_TRAIT, known_callee: SymbolId { v: 0u32 },
            callee_node_idx: INLINE_NONE_IDX, possible_targets: 0 as *mut SymbolId, possible_target_count: 0,
            targets_complete: false, is_inlined: false, is_tail_position: false,
            in_loop_depth: 0u32, is_cold_callsite: false, const_arg_mask: 0u64, view_arg_mask: 0u64, closure_arg_mask: 0u64,
            span: Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 },
        };
        let c_open = devirt_classify_callsite(unsafe { view(*cg) }, view(e_open), OPT_PROFILE_SPEED_O2);
        unsafe { (*cg).closed_world = true; }
        if c_open.tier != DEVIRT_TIER_RETAINED_DYNAMIC || c_open.reason != DEVIRT_REASON_OPEN_WORLD {
            rc = 207;
        }

        // Export boundary with 0 targets in closed world -> `DEVIRT_TIER_RETAINED_DYNAMIC(DEVIRT_REASON_EXPORT_BOUNDARY)`
        let c_exp = devirt_classify_callsite(unsafe { view(*cg) }, view(e_open), OPT_PROFILE_SPEED_O2);
        if c_exp.tier != DEVIRT_TIER_RETAINED_DYNAMIC || c_exp.reason != DEVIRT_REASON_EXPORT_BOUNDARY {
            rc = 208;
        }

        // Too many targets (`6 > MAX_GUARDED_TARGETS`) -> `DEVIRT_TIER_RETAINED_DYNAMIC(DEVIRT_REASON_TOO_MANY_TARGETS)`
        e_dyn_guarded.possible_target_count = 6;
        let c_many = devirt_classify_callsite(unsafe { view(*cg) }, view(e_dyn_guarded), OPT_PROFILE_SPEED_O2);
        if c_many.tier != DEVIRT_TIER_RETAINED_DYNAMIC || c_many.reason != DEVIRT_REASON_TOO_MANY_TARGETS {
            rc = 209;
        }
    }
    if rc == 0 {
        print("PROBE_DEVIRT_THREE_TIER_CLASSIFY=OK\n");
    }

    // 2b. Verify transactional rollback on `force_verify_fail = true`
    if rc == 0 {
        let n2_ob = unsafe { (*cg_node_at((*cg).nodes, 2)).opt_body };
        let pm_dv = arena_alloc_raw(mut_view(mir_a), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
        passmgr_init(unsafe { mut_view(*pm_dv) }, opt_budget_for_profile(OPT_PROFILE_SPEED_O2, true), mut_view(mir_a));
        passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_dv) }, unsafe { mut_view(*n2_ob) }, mut_view(mir_a));
        let mut rb_dstats = devirt_stats_zero();
        let rb_dlog = devirt_log_new(mut_view(mir_a), 16);
        let rb_chg = devirt_run_pass_internal(
            unsafe { mut_view(*pm_dv) },
            unsafe { mut_view(*n2_ob) },
            unsafe { mut_view(*cg) },
            true,
            unsafe { mut_view(*ct_fe) },
            unsafe { mut_view(*esc_tbl) },
            mut_view(rb_dstats),
            rb_dlog,
            0 as *mut SroaStats,
            0 as *mut SroaDecisionLog,
            true,
            mut_view(mir_a),
            unsafe { mut_view(*sink_fe) }
        );
        if rb_chg || rb_dstats.pass_rollbacks == 0u32 {
            rc = 210;
        }
    }

    // 2c. Run full `devirt_optimize_callgraph` across `caller_exact_devirt` (Tier 1 + inline cascade),
    //     `caller_guarded_devirt` (Tier 2 guarded switch), and `caller_open_export` (Tier 3 retained dynamic)
    if rc == 0 {
        let mut dstats = devirt_stats_zero();
        let dlog = devirt_log_new(mut_view(mir_a), 32);
        let mut sstats = sroa_stats_zero();
        let slog = sroa_log_new(mut_view(mir_a), 32);
        let dv_chg = devirt_optimize_callgraph(
            unsafe { mut_view(*cg) },
            OPT_PROFILE_SPEED_O2,
            true,
            unsafe { mut_view(*ct_fe) },
            unsafe { mut_view(*esc_tbl) },
            mut_view(dstats),
            dlog,
             unsafe { address_of_mut(sstats) },
            slog,
            mut_view(mir_a),
            unsafe { mut_view(*sink_fe) }
        );
        if !dv_chg ||
           dstats.exact_devirt_count == 0u32 ||
           dstats.guarded_devirt_count == 0u32 ||
           dstats.retained_dynamic_count == 0u32 ||
           dstats.inlined_after_devirt == 0u32 ||
           dstats.pass_rollbacks != 0u32 {
            rc = 211;
        } else {
            print("PROBE_DEVIRT_REWRITE_AND_INLINE_CASCADE=OK\n");
            let mut db1 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
            let mut db2 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
            diag_buf_init(mut_view(db1));
            diag_buf_init(mut_view(db2));
            devirt_print(view(dstats), dlog as *const compiler.opt.devirt.DevirtDecisionLog, mut_view(db1));
            devirt_print(view(dstats), dlog as *const compiler.opt.devirt.DevirtDecisionLog, mut_view(db2));
            if (db1.len) < 64 || !diag_buf_eq(view(db1), view(db2)) {
                rc = 212;
            }
            diag_buf_free(mut_view(db1));
            diag_buf_free(mut_view(db2));
        }
    }

    if rc == 0 {
        print("PROBE_DEVIRT_ROLLBACK_AND_EMIT=OK\n");
    }

    resolve_map_free(mut_view(rmap));
    unsafe { thir_free(mut_view(*thir_fe)); }
    probe_free_fe_session(sess);
    arena_destroy(mut_view(mir_a)); arena_destroy(mut_view(hir_a)); arena_destroy(mut_view(res_a));
    arena_destroy(mut_view(parse_a)); arena_destroy(mut_view(perm_a));
    rc
}

// Section 3: Tail-Call & Self-Tail-Recursion Optimization (`TCO_LEGAL`, Drop & Stack-View Guards, Loop Lowering, `@tailcall`)
fn probe_tailcall_loop_lowering_and_guards() -> i32 {
    let tc = tailcall_contract();
    if tc.pass_id != PASS_TAILCALL || tc.pass_id != 17u16 ||
       tc.preserved_analyses != ANALYSIS_MASK_NONE ||
       tc.postconditions != POSTCOND_ALL {
        return 301;
    }

    let mut perm_a = new_arena(524288);
    let mut parse_a = new_arena(262144);
    let mut res_a = new_arena(262144);
    let mut hir_a = new_arena(262144);
    let mut mir_a = new_arena(1048576);
    let sess = probe_init_fe_session(mut_view(perm_a));
    let thir_fe = arena_alloc_raw(mut_view(perm_a), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    unsafe { thir_init(mut_view(*thir_fe)); }
    let mut rmap = ResolveMap {
        node_map: empty_node_map(), module_access_nodes: empty_node_map(), extern_nodes: empty_node_map(),
        next_symbol_v: 1u32, next_std_symbol_v: 10000u32, naming_ctx: 0 as *mut NamingCtx,
    };

    let path_sv = probe_blob(mut_view(perm_a), 0);
    let src3_sv = probe_blob(mut_view(perm_a), 3);
    let mut fid = FileId { v: 0u32 };
    let pres = session_parse_virtual_file(unsafe { mut_view(*sess) }, mut_view(parse_a), path_sv, src3_sv, mut_view(fid));
    session_resolve_ast_into(unsafe { mut_view(*sess) }, mut_view(res_a), view(pres.ast), mut_view(rmap));
    let hir3 = session_lower_hir(unsafe { mut_view(*sess) }, mut_view(hir_a), view(pres.ast), view(rmap));
    unsafe { session_typeck_into(mut_view(*sess), view(hir3), mut_view(*thir_fe)); }
    if (unsafe { (*sess).diag_sink.errors }) != 0 {
        resolve_map_free(mut_view(rmap));
        unsafe { thir_free(mut_view(*thir_fe)); }
        probe_free_fe_session(sess);
        arena_destroy(mut_view(mir_a)); arena_destroy(mut_view(hir_a)); arena_destroy(mut_view(res_a));
        arena_destroy(mut_view(parse_a)); arena_destroy(mut_view(perm_a));
        return 302;
    }

    let str_in_ptr = unsafe { address_of_mut((*sess).interner) as *mut StrInterner };
    let db_ptr = unsafe { address_of((*sess).source_db) as *const SourceDatabase };
    let sink_fe = unsafe { address_of_mut((*sess).diag_sink) as *mut DiagSink };
    let hir_ptr = unsafe { address_of(hir3.items) as *const HirFile };
    let ct_fe = arena_alloc_raw(mut_view(mir_a), size_of<EffectCallTable>(), align_of<EffectCallTable>()) as *mut EffectCallTable;
    effect_call_table_init(unsafe { mut_view(*ct_fe) }, mut_view(mir_a), 32);
    let esc_tbl = arena_alloc_raw(mut_view(mir_a), size_of<EscapeSummaryTable>(), align_of<EscapeSummaryTable>()) as *mut EscapeSummaryTable;
    escape_summary_table_init(unsafe { mut_view(*esc_tbl) }, mut_view(mir_a), 32);

    let cg = callgraph_new(mut_view(mir_a), thir_fe as *const Thir, true, false);
    // Functions in Blob 3 (excluding `Guard.drop`):
    //   0: sum_self_tail (direct self-tail-recursion -> `TCO_LEGAL`, loop lowered)
    //   1: sibling_callee (leaf helper)
    //   2: sibling_caller (calls `sibling_callee` in tail position -> `TCO_LEGAL`, sibling tail-call)
    //   3: non_tail_rec (`1 + non_tail_rec(n - 1)` -> `TCO_ILLEGAL(TCO_REASON_NOT_TAIL_POS)`)
    //   4: drop_guard_tail (`let g = Guard { id: n }` live across call -> `TCO_ILLEGAL(TCO_REASON_LIVE_DROP_AFTER_CALL)`)
    //   5: view_consumer (takes `view<Slot>`)
    //   6: stack_view_tail (`let s = Slot { v: x }; view_consumer(view(s))` -> `TCO_ILLEGAL(TCO_REASON_STACK_VIEW_ESCAPE)`)
    let mut fn_idx: usize = 0;
    let mut it: *mut HirItem = hir3.items;
    while (it as usize) != 0 {
        if (unsafe { (*it).kind }) == HIR_ITEM_FN && ((unsafe { (*it).attrs }) as usize) == 0 {
            let mbody = mir_build_fn(mut_view(mir_a), it, thir_fe, hir_ptr, str_in_ptr, db_ptr, 0 as *mut MonoEngine);
            if (mbody as usize) != 0 {
                let ob = optir_build_from_mir(unsafe { view(*mbody) }, thir_fe as *const Thir, mut_view(mir_a), unsafe { mut_view(*sink_fe) }, it as *const HirItem);
                let _ = callgraph_add_node(
                    unsafe { mut_view(*cg) },
                    mut_view(mir_a),
                    unsafe { (*it).symbol },
                    unsafe { (*it).name },
                    mbody,
                    ob,
                    it as *const HirItem,
                    INLINE_ATTR_NONE,
                    false,
                    true,
                    false,
                    false,
                    DOMAIN_CPU_HOST,
                    false
                );
                fn_idx = fn_idx + 1;
            }
        }
        it = unsafe { (*it).next };
    }

    let mut rc: i32 = 0;
    if fn_idx != 7 {
        rc = 303;
    }

    if rc == 0 {
        callgraph_finalize(unsafe { mut_view(*cg) }, unsafe { mut_view(*ct_fe) }, unsafe { mut_view(*esc_tbl) }, mut_view(mir_a));

        // 3a. Verify `ipa_check_tco_legality` across all 5 tail-call patterns (`AXS-INL-033`)
        let n0 = unsafe { cg_node_at((*cg).nodes, 0) };
        let n2 = unsafe { cg_node_at((*cg).nodes, 2) };
        let n3 = unsafe { cg_node_at((*cg).nodes, 3) };
        let n4 = unsafe { cg_node_at((*cg).nodes, 4) };
        let n6 = unsafe { cg_node_at((*cg).nodes, 6) };

        let e0 = unsafe { cg_edge_at((*cg).edges, (*n0).out_edge_start as usize) };
        let e2 = unsafe { cg_edge_at((*cg).edges, (*n2).out_edge_start as usize) };
        let e3 = unsafe { cg_edge_at((*cg).edges, (*n3).out_edge_start as usize) };
        let e4 = unsafe { cg_edge_at((*cg).edges, (*n4).out_edge_start as usize) };
        let e6 = unsafe { cg_edge_at((*cg).edges, (*n6).out_edge_start as usize) };

        let chk_self = ipa_check_tco_legality(unsafe { view(*cg) }, unsafe { view(*e0) }, OPT_PROFILE_SPEED_O2);
        let chk_sib = ipa_check_tco_legality(unsafe { view(*cg) }, unsafe { view(*e2) }, OPT_PROFILE_SPEED_O2);
        let chk_nontail = ipa_check_tco_legality(unsafe { view(*cg) }, unsafe { view(*e3) }, OPT_PROFILE_SPEED_O2);
        let chk_drop = ipa_check_tco_legality(unsafe { view(*cg) }, unsafe { view(*e4) }, OPT_PROFILE_SPEED_O2);
        let chk_view = ipa_check_tco_legality(unsafe { view(*cg) }, unsafe { view(*e6) }, OPT_PROFILE_SPEED_O2);

        if chk_self.legality != TCO_LEGAL || !chk_self.is_self_recursion ||
           chk_sib.legality != TCO_LEGAL || chk_sib.is_self_recursion || !chk_sib.is_sibling_compatible ||
           chk_nontail.legality != TCO_ILLEGAL || chk_nontail.reason != TCO_REASON_NOT_TAIL_POS ||
           chk_drop.legality != TCO_ILLEGAL || chk_drop.reason != TCO_REASON_LIVE_DROP_AFTER_CALL ||
           chk_view.legality != TCO_ILLEGAL || chk_view.reason != TCO_REASON_STACK_VIEW_ESCAPE {
            rc = 304;
        }
    }
    if rc == 0 {
        print("PROBE_TCO_LEGALITY_AND_GUARDS=OK\n");
    }

    // 3b. Verify transactional rollback on `force_verify_fail = true`
    if rc == 0 {
        let n0_ob = unsafe { (*cg_node_at((*cg).nodes, 0)).opt_body };
        let pm_tc = arena_alloc_raw(mut_view(mir_a), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
        passmgr_init(unsafe { mut_view(*pm_tc) }, opt_budget_for_profile(OPT_PROFILE_SPEED_O2, true), mut_view(mir_a));
        passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_tc) }, unsafe { mut_view(*n0_ob) }, mut_view(mir_a));
        let mut rb_tstats = ipa_tco_stats_zero();
        let rb_tlog = ipa_tco_log_new(mut_view(mir_a), 16);
        let rb_chg = ipa_run_tailcall_pass_internal(
            unsafe { mut_view(*pm_tc) },
            unsafe { mut_view(*n0_ob) },
            unsafe { mut_view(*cg) },
            mut_view(rb_tstats),
            rb_tlog,
            true,
            mut_view(mir_a),
            unsafe { mut_view(*sink_fe) }
        );
        if rb_chg || rb_tstats.pass_rollbacks == 0u32 {
            rc = 305;
        }
    }

    // 3c. Run full `ipa_optimize_tailcalls_in_callgraph`:
    //     Verifies `sum_self_tail` (`node 0`) has its recursive `CallEdge` eliminated (`out_edge_count == 0`)
    //     and replaced by a verified loop back-edge (`loop_backedge_count >= 1`) in `OptBody`!
    if rc == 0 {
        let mut tstats = ipa_tco_stats_zero();
        let tlog = ipa_tco_log_new(mut_view(mir_a), 32);

        // Also verify explicit `@tailcall` diagnostic rejection on illegal drop-guarded and stack-view tail calls (`REQ-OPT-003`)
        let n4_pre = unsafe { cg_node_at((*cg).nodes, 4) };
        let e4_pre = unsafe { cg_edge_at((*cg).edges, (*n4_pre).out_edge_start as usize) };
        let _ = ipa_verify_tailcall_attr(unsafe { view(*cg) }, unsafe { view(*e4_pre) }, OPT_PROFILE_SPEED_O2, mut_view(tstats), tlog, mut_view(mir_a));

        let tc_chg = ipa_optimize_tailcalls_in_callgraph(
            unsafe { mut_view(*cg) },
            OPT_PROFILE_SPEED_O2,
            unsafe { mut_view(*ct_fe) },
            unsafe { mut_view(*esc_tbl) },
            mut_view(tstats),
            tlog,
            mut_view(mir_a),
            unsafe { mut_view(*sink_fe) }
        );

        let n0_after = unsafe { cg_node_at((*cg).nodes, 0) };
        let n0_ob_after = unsafe { (*n0_after).opt_body };
        let n0_facts = passmgr_collect_body_facts(unsafe { view(*n0_ob_after) });

        if !tc_chg ||
           tstats.self_loops_lowered == 0u32 ||
           tstats.sibling_tailcalls_marked == 0u32 ||
           tstats.rejected_live_drop == 0u32 ||
           tstats.rejected_stack_view == 0u32 ||
           tstats.tailcall_diag_errors == 0u32 ||
           (unsafe { (*n0_after).out_edge_count }) != 0u32 ||
           n0_facts.call_count != 0u32 ||
           n0_facts.loop_backedge_count == 0u32 {
            rc = 306;
        } else {
            print("PROBE_TCO_SELF_LOOP_LOWERING=OK\n");
            let mut tb1 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
            let mut tb2 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
            diag_buf_init(mut_view(tb1));
            diag_buf_init(mut_view(tb2));
            ipa_tailcall_print(view(tstats), mut_view(tb1));
            ipa_tailcall_print(view(tstats), mut_view(tb2));
            if (tb1.len) < 40 || !diag_buf_eq(view(tb1), view(tb2)) {
                rc = 307;
            }
            diag_buf_free(mut_view(tb1));
            diag_buf_free(mut_view(tb2));
        }
    }

    if rc == 0 {
        print("PROBE_TCO_ATTR_DIAG_AND_EMIT=OK\n");
    }

    resolve_map_free(mut_view(rmap));
    unsafe { thir_free(mut_view(*thir_fe)); }
    probe_free_fe_session(sess);
    arena_destroy(mut_view(mir_a)); arena_destroy(mut_view(hir_a)); arena_destroy(mut_view(res_a));
    arena_destroy(mut_view(parse_a)); arena_destroy(mut_view(perm_a));
    rc
}

pub fn main() -> i32 {
    let rc1 = probe_ipa_specialization_and_sharing();
    if rc1 != 0 {
        return rc1;
    }
    let rc2 = probe_devirt_three_tier_and_cascade();
    if rc2 != 0 {
        return rc2;
    }
    let rc3 = probe_tailcall_loop_lowering_and_guards();
    if rc3 != 0 {
        return rc3;
    }
    print("PROBE_IPA_DEVIRT_ALL=PASS\n");
    0
}
