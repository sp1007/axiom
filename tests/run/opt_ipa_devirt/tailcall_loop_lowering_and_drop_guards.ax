// test: run
// modes: interp native
// exit: 0
// stdout: TCO_BANNER=TailCall_Loop_Lowering_And_Drop_Guards\nTCO_SELF_SUM=125250\nTCO_PARALLEL_ARGS=165\nTCO_SIBLING_MUTUAL=100\nDROP_GUARD_DEPTH=1\nDROP_GUARD_DEPTH=2\nDROP_GUARD_DEPTH=3\nTCO_DROP_SAFE_VAL=70\nTCO_BORROW_SAFE_VAL=100\nTCO_TOTAL=125685\n

struct ScopeDropGuard {
    depth: i32,
}

impl Drop for ScopeDropGuard {
    fn drop(self: mut_view<ScopeDropGuard>) {
        print("DROP_GUARD_DEPTH=");
        print_int(self.depth);
        print("\n");
    }
}

struct StackSlot {
    v: i32,
}

// 1. Direct self-tail-recursion accumulator (`AXS-INL-033.1`, `REQ-OPT-002`)
fn sum_tail(n: i32, acc: i32) -> i32 {
    if n <= 0 {
        return acc;
    }
    sum_tail(n - 1, acc + n)
}

// 2. Parallel parameter update self-tail-recursion (`(b, a % b)` and `(n - 1, b, a + b)`)
fn gcd_tail(a: i32, b: i32) -> i32 {
    if b == 0 {
        return a;
    }
    gcd_tail(b, a % b)
}

fn fib_tail(n: i32, a: i32, b: i32) -> i32 {
    if n <= 0 {
        return a;
    }
    fib_tail(n - 1, b, a + b)
}

// 3. Sibling / mutual tail-position calls (`AXS-INL-033.2`)
fn mutual_parity_even(n: i32) -> i32 {
    if n == 0 {
        return 1;
    }
    mutual_parity_odd(n - 1)
}

fn mutual_parity_odd(n: i32) -> i32 {
    if n == 0 {
        return 0;
    }
    mutual_parity_even(n - 1)
}

// 4. Negative safety test 1 (`TCO_REASON_LIVE_DROP_AFTER_CALL`, `AXS-INL-033` Precondition 1):
// `g: ScopeDropGuard` requires post-call Drop execution; TCO MUST NOT pop the frame before `g.drop()`!
fn rec_with_drop_guard(n: i32, acc: i32) -> i32 {
    if n <= 0 {
        return acc;
    }
    let mut next_acc: i32 = 0;
    {
        let g = ScopeDropGuard { depth: n };
        next_acc = rec_with_drop_guard(g.depth - 1, acc + (g.depth * 10));
    }
    next_acc
}

// 5. Negative safety test 2 (`TCO_REASON_STACK_VIEW_ESCAPE`, `AXS-INL-033` Precondition 2):
// Passing `view(local_slot)` borrows the caller's stack frame; frame must stay live across the call!
fn callee_read_borrowed_slot(s: view<StackSlot>, scale: i32) -> i32 {
    s.v * scale
}

fn caller_with_stack_borrow(seed: i32) -> i32 {
    let local_slot = StackSlot { v: seed };
    callee_read_borrowed_slot(view(local_slot), 4)
}

fn main() -> i32 {
    print("TCO_BANNER=TailCall_Loop_Lowering_And_Drop_Guards\n");

    let v_sum: i32 = sum_tail(500, 0);
    print("TCO_SELF_SUM=");
    print_int(v_sum);
    print("\n");

    let v_par: i32 = gcd_tail(1071, 462) + fib_tail(12, 0, 1);
    print("TCO_PARALLEL_ARGS=");
    print_int(v_par);
    print("\n");

    let v_sib: i32 = (mutual_parity_even(24) * 50) + (mutual_parity_odd(25) * 50);
    print("TCO_SIBLING_MUTUAL=");
    print_int(v_sib);
    print("\n");

    let v_drop: i32 = rec_with_drop_guard(3, 10);
    print("TCO_DROP_SAFE_VAL=");
    print_int(v_drop);
    print("\n");

    let v_borrow: i32 = caller_with_stack_borrow(25);
    print("TCO_BORROW_SAFE_VAL=");
    print_int(v_borrow);
    print("\n");

    let total: i32 = v_sum + v_par + v_sib + v_drop + v_borrow;
    print("TCO_TOTAL=");
    print_int(total);
    print("\n");

    if total != 125685 {
        return 1;
    }
    0
}
