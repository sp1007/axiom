// test: run
// modes: interp native
// exit: 0
// stdout: SEAM_BANNER=Spec_Devirt_TCO_Boundary_Seam\nSEAM_CYCLIC_TCO=35\nSEAM_SPEC_DEVIRT=112\nBRANCH_DROP=22\nSEAM_GUARD_BORROW=66\nSEAM_TOTAL=213\n

@derive(Copy)
enum SeamMode {
    FastScale(i32),
    OffsetOnly(i32),
}

struct MutSlot {
    acc: i32,
}

struct BranchDrop {
    tag: i32,
}

impl Drop for BranchDrop {
    fn drop(self: mut_view<BranchDrop>) {
        print("BRANCH_DROP=");
        print_int(self.tag);
        print("\n");
    }
}

// 1. 3-parameter cyclic self-tail-recursion: requires simultaneous parallel argument staging
// (`(a, b, c) -> (b, c, (a + b) - c)`) before jumping to the loop header (`AXS-INL-033.1`).
fn cyclic_tribonacci_tail(n: i32, a: i32, b: i32, c: i32) -> i32 {
    if n <= 0 {
        return a;
    }
    cyclic_tribonacci_tail(n - 1, b, c, (a + b) - c)
}

// 2. Cross-seam 3-target guarded devirtualization (`Tier 2`, `m = 3`) inside a call-site
// enum-tag specialized pipeline (`AXS-INL-030`, `AXS-INL-032.2`).
fn seam_t0(x: i32) -> i32 {
    x + 4
}

fn seam_t1(x: i32) -> i32 {
    x * 3
}

fn seam_t2(x: i32) -> i32 {
    (x * 2) - 1
}

fn dispatch_three_way(sel: i32, x: i32) -> i32 {
    let f: fn(i32) -> i32 = if sel == 0 {
        seam_t0
    } else if sel == 1 {
        seam_t1
    } else {
        seam_t2
    };
    f(x)
}

fn spec_with_devirt(mode: SeamMode, sel: i32, x: i32) -> i32 {
    let d: i32 = dispatch_three_way(sel, x);
    match mode {
        SeamMode.FastScale(k) => d * k,
        SeamMode.OffsetOnly(off) => d + off,
    }
}

// 3. Negative TCO boundaries: `mut_view` stack borrow in tail call (`TCO_REASON_STACK_VIEW_ESCAPE`)
// and conditional branch `Drop` guard (`TCO_REASON_LIVE_DROP_AFTER_CALL`) (`AXS-INL-033`).
fn mutate_and_read(slot: mut_view<MutSlot>, delta: i32) -> i32 {
    slot.acc = slot.acc + delta;
    slot.acc * 2
}

fn caller_mut_view_tail(seed: i32) -> i32 {
    let mut local = MutSlot { acc: seed };
    mutate_and_read(mut_view(local), 7)
}

fn branch_guarded_tail(n: i32, acc: i32) -> i32 {
    if n <= 0 {
        return acc;
    }
    if n == 2 {
        let mut r: i32 = 0;
        {
            let g = BranchDrop { tag: 22 };
            r = branch_guarded_tail(n - 1, acc + g.tag);
        }
        return r;
    }
    branch_guarded_tail(n - 1, acc + n)
}

fn main() -> i32 {
    print("SEAM_BANNER=Spec_Devirt_TCO_Boundary_Seam\n");

    let v_cyc: i32 = cyclic_tribonacci_tail(6, 2, 5, 3) +
                     cyclic_tribonacci_tail(5, 10, 20, 5);
    print("SEAM_CYCLIC_TCO=");
    print_int(v_cyc);
    print("\n");

    let v_seam: i32 = spec_with_devirt(SeamMode.FastScale(2), 0, 10) +
                      spec_with_devirt(SeamMode.FastScale(2), 1, 10) +
                      spec_with_devirt(SeamMode.OffsetOnly(5), 2, 10);
    print("SEAM_SPEC_DEVIRT=");
    print_int(v_seam);
    print("\n");

    let v_guard: i32 = caller_mut_view_tail(13) + branch_guarded_tail(3, 0);
    print("SEAM_GUARD_BORROW=");
    print_int(v_guard);
    print("\n");

    let total: i32 = v_cyc + v_seam + v_guard;
    print("SEAM_TOTAL=");
    print_int(total);
    print("\n");

    if total != 213 {
        return 1;
    }
    0
}
