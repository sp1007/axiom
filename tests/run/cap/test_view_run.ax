// test: run
// native-after: T051

struct NonCopy {
    val: i32,
}

fn view_fn(a: view<NonCopy>) {}

fn test_view_read() {
    let a = NonCopy { val: 1 };
    view_fn(view(a));
    let b = a; // Ownership kept
}

fn test_view_method() {
    let a = NonCopy { val: 1 };
    let v = view(a); // ephemeral?
}

fn main() {
    test_view_read();
    test_view_method();
}
