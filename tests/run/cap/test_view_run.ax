// test: run
// exit: 2
struct NonCopy {
    val: i32,
}
fn view_fn(a: view<NonCopy>) -> i32 {
    a.val
}
fn test_view_read() -> i32 {
    let a = NonCopy { val: 1 };
    let v = view_fn(view(a));
    let b = a; // Ownership kept
    v + b.val - 1
}
fn test_view_method() -> i32 {
    let a = NonCopy { val: 1 };
    let v = view(a); // ephemeral?
    v.val
}
fn main() -> i32 {
    test_view_read() + test_view_method()
}
