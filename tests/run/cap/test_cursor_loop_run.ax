// test: run
struct Cursor {
    v: view<[4]i32>,
    idx: usize,
}
fn test_cursor_loop() {
    let arr = [10, 20, 30, 40];
    let mut c = Cursor { v: view(arr), idx: 0 };
    let mut iterations = 0;
    while 4 > c.idx {
        c.idx = c.idx + 1;
        iterations = iterations + 1;
    }
}
fn main() {
    test_cursor_loop();
}
