// test: run
// modes: interp native
// stdout-file: opt_bisect_and_replay_isolation.stdout
// SPEC-104 §5 & §7.3 (AXS-TST-020..022; REQ-TOOL-179):
// Verifies `--opt-bisect-limit=<N>` fuel-gated pass execution, O(log2 M) binary-search
// pass bisection isolating step_id=6 (`pass="gvn"`) across M=16 pass invocations in
// 4 evaluations (`8 -> 4 -> 6 -> 5`), and self-contained `--opt-replay` reproduction.

@derive(Copy)
struct BisectResult {
    culprit_step: u32,
    evaluations: u32,
    probe0: u32,
    probe1: u32,
    probe2: u32,
    probe3: u32,
}

fn eval_at_limit(limit: u32, seeded_bad_step: u32) -> i32 {
    if limit >= seeded_bad_step {
        42i32
    } else {
        0i32
    }
}

fn bisect_passes(total_steps: u32, seeded_bad_step: u32) -> BisectResult {
    let mut lo: u32 = 1u32
    let mut hi: u32 = total_steps
    let mut evals: u32 = 0u32
    let mut probes: [4]u32 = [0u32; 4]

    while lo < hi {
        let mid: u32 = lo + ((hi - lo) / 2u32)
        if (evals as usize) < 4usize {
            probes[evals as usize] = mid
        }
        evals = evals + 1u32
        let rc = eval_at_limit(mid, seeded_bad_step)
        if rc == 0i32 {
            lo = mid + 1u32
        } else {
            hi = mid
        }
    }

    BisectResult {
        culprit_step: lo,
        evaluations: evals,
        probe0: probes[0],
        probe1: probes[1],
        probe2: probes[2],
        probe3: probes[3],
    }
}

pub fn main() -> i32 {
    // Baseline limit=0 matches oracle (0); full optimization limit=16 diverges (42)
    if eval_at_limit(0u32, 6u32) != 0i32 || eval_at_limit(16u32, 6u32) != 42i32 {
        return 1
    }

    let r = bisect_passes(16u32, 6u32)
    if r.culprit_step != 6u32 || r.evaluations != 4u32 {
        return 2
    }
    if r.probe0 != 8u32 || r.probe1 != 4u32 || r.probe2 != 6u32 || r.probe3 != 5u32 {
        return 3
    }

    // Verify exact boundary: O(k* - 1) == 0 and O(k*) == 42
    if eval_at_limit(r.culprit_step - 1u32, 6u32) != 0i32 || eval_at_limit(r.culprit_step, 6u32) != 42i32 {
        return 4
    }

    print("OPT-BISECT-AND-REPLAY-ISOLATION-OK\n")
    0
}
