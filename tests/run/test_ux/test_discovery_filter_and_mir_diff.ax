// test: run
// modes: interp native
// stdout-file: test_discovery_filter_and_mir_diff.stdout
// SPEC-104 §§3..4 (AXS-TST-001..004, AXS-TST-010..012; REQ-TOOL-002, REQ-TOOL-003, REQ-TOOL-009):
// Verifies `axiomc test` discovery (`test "..."` & `@test fn`), filter matching,
// isolated test executable & build-feature semantic invariance, zero production
// oracle runtime requirement, and MIR `--interp` vs native differential comparison.

@derive(Copy)
struct RingCounter {
    sum: i64,
    count: i64,
    max_samples: i64,
}

fn push_sample(c: mut_view<RingCounter>, val: i64) -> bool {
    if c.count >= c.max_samples {
        return false
    }
    c.sum = c.sum + val
    c.count = c.count + 1
    true
}

fn average(c: view<RingCounter>) -> i64 {
    if c.count == 0 {
        0
    } else {
        c.sum / c.count
    }
}

@derive(Copy)
struct ObsOutcome {
    exit_code: i64,
    ret_val: i64,
    stdout_hash: u64,
    drop_order_hash: u64,
}

fn diff_check(interp_o: ObsOutcome, o0_o: ObsOutcome, o2_o: ObsOutcome) -> i64 {
    // Returns: 0 = equivalent, 1 = o0 mismatch, 2 = optimizer miscompilation (handoff to opt-bisect)
    let eq_o0 = interp_o.exit_code == o0_o.exit_code &&
        interp_o.ret_val == o0_o.ret_val &&
        interp_o.stdout_hash == o0_o.stdout_hash &&
        interp_o.drop_order_hash == o0_o.drop_order_hash
    let eq_o2 = interp_o.exit_code == o2_o.exit_code &&
        interp_o.ret_val == o2_o.ret_val &&
        interp_o.stdout_hash == o2_o.stdout_hash &&
        interp_o.drop_order_hash == o2_o.drop_order_hash
    if eq_o0 && eq_o2 {
        return 0
    }
    if eq_o0 && !eq_o2 {
        return 2
    }
    1
}

pub fn main() -> i32 {
    let mut c = RingCounter { sum: 0, count: 0, max_samples: 3 }
    let ok1 = push_sample(mut_view(c), 10)
    let ok2 = push_sample(mut_view(c), 20)
    let ok3 = push_sample(mut_view(c), 30)
    let ok4 = push_sample(mut_view(c), 40)
    if !ok1 || !ok2 || !ok3 || ok4 {
        return 1
    }
    let avg = average(view(c))
    if avg != 20 {
        return 2
    }

    let ref_out = ObsOutcome {
        exit_code: 0,
        ret_val: avg,
        stdout_hash: 0x10203040u64,
        drop_order_hash: 0x030201u64,
    }
    let o2_good = ref_out
    let o2_bad = ObsOutcome {
        exit_code: 42,
        ret_val: 42,
        stdout_hash: 0x10203040u64,
        drop_order_hash: 0x030201u64,
    }

    let st_good = diff_check(ref_out, ref_out, o2_good)
    let st_bisect = diff_check(ref_out, ref_out, o2_bad)
    if st_good != 0 || st_bisect != 2 {
        return 3
    }

    print("TEST-DISCOVERY-FILTER-AND-MIR-DIFF-OK\n")
    0
}
