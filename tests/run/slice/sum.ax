// sum over view<[i32]> of an array
// test: run
fn sum_slice(v: view<[i32]>) -> i32 {
    let mut sum: i32 = 0;
    let mut i: usize = 0;
    while i < len(v) {
        sum = sum + v[i];
        i = i + 1;
    }
    return sum;
}
fn main() -> i32 {
    let arr: [5]i32 = [1, 2, 3, 4, 5];
    let v: view<[i32]> = view(arr);
    let res = sum_slice(v);
    if res == 15 { return 0; }
    return 1;
}
