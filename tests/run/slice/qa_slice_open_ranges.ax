// test: run

fn main() -> i32 {
    let arr: [6]i32 = [10, 20, 30, 40, 50, 60];

    let v: view<[i32]> = view(arr);
    let left_ro = v[..3];
    let right_ro = v[3..];

    if left_ro[0] != 10 { return 1; }
    if left_ro[1] != 20 { return 2; }
    if left_ro[2] != 30 { return 3; }

    if right_ro[0] != 40 { return 4; }
    if right_ro[1] != 50 { return 5; }
    if right_ro[2] != 60 { return 6; }

    0
}
