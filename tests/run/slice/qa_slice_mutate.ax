// test: run
// native-after: T051

fn fill(v: mut_view<[i32]>, val: i32) {
    let mut i: usize = 0;
    while i < len(v) {
        v[i] = val + (i as i32);
        i = i + 1;
    }
}

fn main() -> i32 {
    let mut arr: [4]i32 = [0, 0, 0, 0];
    let v: mut_view<[i32]> = mut_view(arr);
    fill(v, 10);
    if arr[0] != 10 { return 1; }
    if arr[1] != 11 { return 2; }
    if arr[2] != 12 { return 3; }
    if arr[3] != 13 { return 4; }
    return 0;
}
