// test: run
// stdout: 60\n10\n60\n30\nOK copy_array_owner_view\n

// SPEC-10 AXS-OWN-003 / ADR-0044 section 3: `[3]u8` is Copy, so `consume(arr)` copies the array and the owner stays
// OWNED. A view into it therefore does not outlive its owner (no AX_CAP_OUTLIVES_OWNER, contrast with
// tests/ui/slice/iter_move.ax which moves a non-Copy owner), the view still reads the original bytes and `arr` can be
// read again.
struct Iter {
    s: view<[u8]>,
    i: usize,
}
fn consume(arr: [3]u8) -> u8 {
    arr[0] + arr[1] + arr[2]
}
fn main() -> i32 {
    let arr: [3]u8 = [10, 20, 30];
    let mut it = Iter { s: view(arr), i: 0 };

    let c: u8 = consume(arr);
    print_int(c as i64);
    print("\n");

    let mut sum: u8 = 0;
    let mut i: usize = it.i;
    while i < len(it.s) {
        sum = sum + it.s[i];
        i = i + 1;
        it.i = i;
    }
    print_int(it.s[0] as i64);
    print("\n");
    print_int(sum as i64);
    print("\n");
    print_int(arr[2] as i64);
    print("\n");
    print("OK copy_array_owner_view\n");
    0
}
