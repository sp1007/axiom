// test: run

fn main() -> i32 {
    let arr: [5]i32 = [10, 20, 30, 40, 50];
    let v: view<[i32]> = view(arr);
    
    let sub1 = v[1..3];
    let sub2 = v[3..5];
    
    // Check values
    if sub1[0] != 20 { return 1; }
    if sub1[1] != 30 { return 2; }
    if sub2[0] != 40 { return 3; }
    if sub2[1] != 50 { return 4; }
    
    return 0;
}
