// test: run

fn main() -> i32 {
    let mut sum = 0;
    
    let a = Option<i32>.Some(10);
    if let Option<i32>.Some(v) = a {
        sum = sum + v;
    }
    
    let mut i = 3;
    while let Option<i32>.Some(v) = (if i > 0 { Option<i32>.Some(i) } else { Option<i32>.None }) {
        sum = sum + v;
        i = i - 1;
    }
    
    if sum != 16 {
        return 1;
    }
    return 0; // 10 + 3 + 2 + 1 = 16
}
