// test: run
// native-after: T040

enum Option { None, Some(i32) }

fn main() -> i32 {
    let mut sum = 0;
    
    let a = Option.Some(10);
    if let Option.Some(v) = a {
        sum = sum + v;
    }
    
    let mut i = 3;
    while let Option.Some(v) = (if i > 0 { Option.Some(i) } else { Option.None }) {
        sum = sum + v;
        i = i - 1;
    }
    
    if sum != 16 {
        return 1;
    }
    return 0; // 10 + 3 + 2 + 1 = 16
}