// test: run

enum Result { Ok(i32), Err(i32) }

fn divide(a: i32, b: i32) -> Result {
    if b == 0 {
        return Result.Err(1);
    }
    return Result.Ok(a / b);
}

fn divide_and_add(a: i32, b: i32, c: i32) -> Result {
    let x = divide(a, b)?;
    return Result.Ok(x + c);
}

fn main() -> i32 {
    let mut sum = 0;
    
    let r1 = divide_and_add(10, 2, 5);
    if let Result.Ok(v) = r1 {
        sum = sum + v; // 10
    }
    
    let r2 = divide_and_add(10, 0, 5);
    if let Result.Err(e) = r2 {
        sum = sum + e; // 10 + 1 = 11
    }
    
    if sum != 11 {
        return 1;
    }
    return 0; // 11
}
