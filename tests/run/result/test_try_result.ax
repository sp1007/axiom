// test: run

fn divide(a: i32, b: i32) -> Result<i32, i32> {
    if b == 0 {
        return Result<i32, i32>.Err(1);
    }
    return Result<i32, i32>.Ok(a / b);
}

fn divide_and_add(a: i32, b: i32, c: i32) -> Result<i32, i32> {
    let x = divide(a, b)?;
    return Result<i32, i32>.Ok(x + c);
}

fn main() -> i32 {
    let mut sum = 0;
    
    let r1 = divide_and_add(10, 2, 5);
    if let Result<i32, i32>.Ok(v) = r1 {
        sum = sum + v; // 10
    }
    
    let r2 = divide_and_add(10, 0, 5);
    if let Result<i32, i32>.Err(e) = r2 {
        sum = sum + e; // 10 + 1 = 11
    }
    
    if sum != 11 {
        return 1;
    }
    return 0; // 11
}
