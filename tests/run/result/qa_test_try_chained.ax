// test: run

fn chain_test() -> Result<i32, i32> {
    let a = Result<i32, i32>.Ok(Result<i32, i32>.Ok(5)?)?;
    return Result<i32, i32>.Ok(a);
}

fn main() -> i32 {
    let r = chain_test();
    if let Result<i32, i32>.Ok(v) = r {
        if v == 5 {
            return 0;
        }
    }
    return 1;
}
