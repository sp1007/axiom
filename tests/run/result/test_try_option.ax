// test: run

fn extract_or_fail(x: Option<i32>) -> Option<i32> {
    let val = x?;
    return Option<i32>.Some(val + 1);
}

fn main() -> i32 {
    let a = Option<i32>.Some(41);
    let b = Option<i32>.None;
    
    let mut res = 0;
    
    if let Option<i32>.Some(v) = extract_or_fail(a) {
        res = res + v;
    }
    
    if let Option<i32>.Some(v) = extract_or_fail(b) {
        // Should not happen, b is None so extract_or_fail returns None
        res = 1000;
    }
    
    if res != 42 {
        return 1;
    }
    return 0; // 42
}
