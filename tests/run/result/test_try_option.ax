// test: run

enum Option { None, Some(i32) }

fn extract_or_fail(x: Option) -> Option {
    let val = x?;
    return Option.Some(val + 1);
}

fn main() -> i32 {
    let a = Option.Some(41);
    let b = Option.None;
    
    let mut res = 0;
    
    if let Option.Some(v) = extract_or_fail(a) {
        res = res + v;
    }
    
    if let Option.Some(v) = extract_or_fail(b) {
        // Should not happen, b is None so extract_or_fail returns None
        res = 1000;
    }
    
    if res != 42 {
        return 1;
    }
    return 0; // 42
}
