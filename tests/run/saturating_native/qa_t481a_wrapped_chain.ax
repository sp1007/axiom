// test: run
// modes: interp native
// exit: 0
// stdout: QA-T481A-OK\n
// QA adversarial (T481a): narrow saturating operands whose upper register bits are dirty because they
// come from narrow wrapping arithmetic (not from a cast), from array element loads and from a previous
// saturating result. Expected values are hand-derived constants (see comments), not computed by the same code.

fn chk(bad: u32, got: i64, want: i64) -> u32 {
    if got != want {
        return bad + 1u32;
    }
    bad
}

fn u8_case(w: u8, arr: [4]u8) -> u32 {
    let mut bad: u32 = 0u32;
    // w = 200 +w 100 = 44 (raw 300 in a 64-bit register before cleanup)
    bad = chk(bad, w as i64, 44i64);
    bad = chk(bad, w.saturating_add(250u8) as i64, 255i64);  // 294 -> 255
    bad = chk(bad, w.saturating_sub(45u8) as i64, 0i64);     // -1 -> 0
    bad = chk(bad, w.saturating_mul(6u8) as i64, 255i64);    // 264 -> 255
    bad = chk(bad, w.saturating_mul(5u8) as i64, 220i64);
    // array loads: 200 + 100 = 300 -> 255; 255 - 1 = 254; 100 * 255 -> 255
    bad = chk(bad, arr[0].saturating_add(arr[1]) as i64, 255i64);
    bad = chk(bad, arr[2].saturating_sub(arr[3]) as i64, 254i64);
    bad = chk(bad, arr[1].saturating_mul(arr[2]) as i64, 255i64);
    // chain: 250 + 10 -> 255, 255 - 5 = 250
    let c: u8 = arr[2].saturating_sub(5u8).saturating_add(10u8);
    bad = chk(bad, c as i64, 255i64);
    bad
}

fn i8_case(x: i8) -> u32 {
    let mut bad: u32 = 0u32;
    // x = 100 +w 100 = 200 -> -56
    bad = chk(bad, x as i64, -56i64);
    bad = chk(bad, x.saturating_sub(100i8) as i64, -128i64);  // -156 -> -128
    bad = chk(bad, x.saturating_add(-100i8) as i64, -128i64); // -156 -> -128
    bad = chk(bad, x.saturating_mul(2i8) as i64, -112i64);
    bad = chk(bad, x.saturating_mul(-3i8) as i64, 127i64);    // 168 -> 127
    bad = chk(bad, x.saturating_add(56i8) as i64, 0i64);
    // chain: saturate low then subtract again stays at the bound
    bad = chk(bad, x.saturating_sub(100i8).saturating_sub(1i8) as i64, -128i64);
    bad
}

fn i16_case(y: i16) -> u32 {
    let mut bad: u32 = 0u32;
    // y = 30000 +w 30000 = 60000 - 65536 = -5536
    bad = chk(bad, y as i64, -5536i64);
    bad = chk(bad, y.saturating_sub(30000i16) as i64, -32768i64); // -35536 -> bound
    bad = chk(bad, y.saturating_mul(-6i16) as i64, 32767i64);     // 33216 -> bound
    bad = chk(bad, y.saturating_mul(5i16) as i64, -27680i64);
    bad = chk(bad, y.saturating_add(5536i16) as i64, 0i64);
    bad
}

fn u32_case(z: u32) -> u32 {
    let mut bad: u32 = 0u32;
    // z = 4000000000 +w 1000000000 = 5000000000 - 4294967296 = 705032704
    bad = chk(bad, z as i64, 705032704i64);
    bad = chk(bad, z.saturating_add(4000000000u32) as i64, 4294967295i64);
    bad = chk(bad, z.saturating_sub(705032705u32) as i64, 0i64);
    bad = chk(bad, z.saturating_mul(6u32) as i64, 4230196224i64);
    bad = chk(bad, z.saturating_mul(7u32) as i64, 4294967295i64); // 4935229... -> bound
    bad
}

fn i32_case(v: i32) -> u32 {
    let mut bad: u32 = 0u32;
    // v = 2000000000 +w 2000000000 = 4000000000 - 4294967296 = -294967296
    bad = chk(bad, v as i64, -294967296i64);
    bad = chk(bad, v.saturating_sub(2000000000i32) as i64, -2147483648i64); // -2294967296 -> bound
    bad = chk(bad, v.saturating_mul(8i32) as i64, -2147483648i64);          // -2359738368 -> bound
    bad = chk(bad, v.saturating_mul(7i32) as i64, -2064771072i64);
    bad = chk(bad, v.saturating_add(294967296i32) as i64, 0i64);
    bad
}

fn main() -> i32 {
    let arr: [4]u8 = [200u8, 100u8, 255u8, 1u8];
    let w: u8 = arr[0].wrapping_add(arr[1]);
    let x: i8 = 100i8.wrapping_add(100i8);
    let y: i16 = 30000i16.wrapping_add(30000i16);
    let z: u32 = 4000000000u32.wrapping_add(1000000000u32);
    let v: i32 = 2000000000i32.wrapping_add(2000000000i32);
    let mut bad: u32 = 0u32;
    bad = bad + u8_case(w, arr);
    bad = bad + i8_case(x);
    bad = bad + i16_case(y);
    bad = bad + u32_case(z);
    bad = bad + i32_case(v);
    if bad != 0u32 {
        print("QA-T481A-BAD ");
        print_int(bad as i64);
        print("\n");
        return 1;
    }
    print("QA-T481A-OK\n");
    0
}
