fn print_u64(v: u64) {
    if v >= 10u64 {
        print_u64(v / 10u64);
    }
    print_int((v % 10u64) as i64);
}

fn print_val(v: i32) {
    let x: i64 = v as i64;
    if x < 0i64 {
        print("-");
        let mag: u64 = (0u64).wrapping_sub(x as u64);
        print_u64(mag);
    } else {
        print_u64(x as u64);
    }
}

fn check_pair(a: i32, b: i32) {
    let ra: i32 = a.saturating_add(b);
    let rs: i32 = a.saturating_sub(b);
    let rm: i32 = a.saturating_mul(b);
    print_val(ra);
    print(" ");
    print_val(rs);
    print(" ");
    print_val(rm);
    print("\n");
}

fn check_consts(a: i32) {
    let c1: i32 = a.saturating_add(1i32);
    let c2: i32 = a.saturating_add(-1i32);
    let c3: i32 = a.saturating_sub(1i32);
    let c4: i32 = a.saturating_sub(-1i32);
    let c5: i32 = a.saturating_mul(-1i32);
    let c6: i32 = a.saturating_mul(2i32);
    let c7: i32 = a.saturating_mul(2147483647i32);
    print("C ");
    print_val(c1);
    print(" ");
    print_val(c2);
    print(" ");
    print_val(c3);
    print(" ");
    print_val(c4);
    print(" ");
    print_val(c5);
    print(" ");
    print_val(c6);
    print(" ");
    print_val(c7);
    print("\n");
}

fn check_dirty(raw1: u64, raw2: u64) {
    let ca1: i32 = raw1 as i32;
    let ca2: i32 = raw2 as i32;
    let d1: i32 = ca1.saturating_add(1i32);
    let d2: i32 = ca1.saturating_sub(1i32);
    let d3: i32 = ca1.saturating_mul(-1i32);
    let d4: i32 = ca2.saturating_add(-2i32);
    let d5: i32 = ca2.saturating_sub(2i32);
    let d6: i32 = ca2.saturating_mul(2i32);
    print("D ");
    print_val(d1);
    print(" ");
    print_val(d2);
    print(" ");
    print_val(d3);
    print(" ");
    print_val(d4);
    print(" ");
    print_val(d5);
    print(" ");
    print_val(d6);
    print("\n");
}

fn main() -> i32 {
    let vals: [9]i32 = [(-2147483648i32), (-2147483647i32), (-2i32), (-1i32), 0i32, 1i32, 2i32, 2147483646i32, 2147483647i32];
    let mut i: usize = 0;
    while i < 9 {
        let mut j: usize = 0;
        while j < 9 {
            check_pair(vals[i], vals[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    let mut k: usize = 0;
    while k < 9 {
        let v: i32 = vals[k];
        check_consts(v);
        let low: u64 = (v as u64) & 0xFFFFFFFFu64;
        check_dirty(0xFFFFFFFF00000000u64 | low, 0x5555AAAA00000000u64 | low);
        k = k + 1;
    }
    0
}
