fn print_u64(v: u64) {
    if v >= 10u64 {
        print_u64(v / 10u64);
    }
    print_int((v % 10u64) as i64);
}

fn print_val(v: i64) {
    let x: i64 = v as i64;
    if x < 0i64 {
        print("-");
        let mag: u64 = (0u64).wrapping_sub(x as u64);
        print_u64(mag);
    } else {
        print_u64(x as u64);
    }
}

fn check_pair(a: i64, b: i64) {
    let ra: i64 = a.saturating_add(b);
    let rs: i64 = a.saturating_sub(b);
    let rm: i64 = a.saturating_mul(b);
    print_val(ra);
    print(" ");
    print_val(rs);
    print(" ");
    print_val(rm);
    print("\n");
}

fn check_consts(a: i64) {
    let c1: i64 = a.saturating_add(1i64);
    let c2: i64 = a.saturating_add(-1i64);
    let c3: i64 = a.saturating_sub(1i64);
    let c4: i64 = a.saturating_sub(-1i64);
    let c5: i64 = a.saturating_mul(-1i64);
    let c6: i64 = a.saturating_mul(2i64);
    let c7: i64 = a.saturating_mul(9223372036854775807i64);
    print("C ");
    print_val(c1);
    print(" ");
    print_val(c2);
    print(" ");
    print_val(c3);
    print(" ");
    print_val(c4);
    print(" ");
    print_val(c5);
    print(" ");
    print_val(c6);
    print(" ");
    print_val(c7);
    print("\n");
}

fn main() -> i32 {
    let vals: [9]i64 = [(-9223372036854775807i64 - 1i64), (-9223372036854775807i64), (-2i64), (-1i64), 0i64, 1i64, 2i64, 9223372036854775806i64, 9223372036854775807i64];
    let mut i: usize = 0;
    while i < 9 {
        let mut j: usize = 0;
        while j < 9 {
            check_pair(vals[i], vals[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    let mut k: usize = 0;
    while k < 9 {
        let v: i64 = vals[k];
        check_consts(v);
        k = k + 1;
    }
    0
}
