fn print_u64(v: u64) {
    if v >= 10u64 {
        print_u64(v / 10u64);
    }
    print_int((v % 10u64) as i64);
}

fn print_val(v: usize) {
    print_u64(v as u64);
}

fn check_pair(a: usize, b: usize) {
    let ra: usize = a.saturating_add(b);
    let rs: usize = a.saturating_sub(b);
    let rm: usize = a.saturating_mul(b);
    print_val(ra);
    print(" ");
    print_val(rs);
    print(" ");
    print_val(rm);
    print("\n");
}

fn check_consts(a: usize) {
    let c1: usize = a.saturating_add(1usize);
    let c2: usize = (1usize).saturating_add(a);
    let c3: usize = a.saturating_sub(1usize);
    let c4: usize = (0usize).saturating_sub(a);
    let c5: usize = a.saturating_mul(2usize);
    let c6: usize = a.saturating_mul(18446744073709551615usize);
    print("C ");
    print_val(c1);
    print(" ");
    print_val(c2);
    print(" ");
    print_val(c3);
    print(" ");
    print_val(c4);
    print(" ");
    print_val(c5);
    print(" ");
    print_val(c6);
    print("\n");
}

fn main() -> i32 {
    let vals: [6]usize = [0usize, 1usize, 2usize, 9223372036854775808usize, 18446744073709551614usize, 18446744073709551615usize];
    let mut i: usize = 0;
    while i < 6 {
        let mut j: usize = 0;
        while j < 6 {
            check_pair(vals[i], vals[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    let mut k: usize = 0;
    while k < 6 {
        let v: usize = vals[k];
        check_consts(v);
        k = k + 1;
    }
    0
}
