// test: run
// modes: interp native
// exit: 0
// stdout: NARROW-SAT-OK\n
// Narrow (8/16/32-bit) saturating_add/sub/mul whose operands carry dirty upper register bits.
// A narrowing cast of a wide value is a no-op in LIR, so the lowering itself must re-extend
// the operands explicitly. Operands come from (1) a narrowing cast of a value whose bits above the
// type width are garbage, (2) function parameters filled from such casts, (3) a struct field.
// Expected values come from independent wide (64-bit) arithmetic on the clean source values.

fn exp_u8(op: u32, a: u64, b: u64) -> u64 {
    let mut r: u64 = 0u64;
    if op == 0u32 {
        r = a + b;
    } else if op == 1u32 {
        if a < b {
            r = 0u64;
        } else {
            r = a - b;
        }
    } else {
        r = a * b;
    }
    if r > 255u64 {
        return 255u64;
    }
    r
}
struct Pair_u8 {
    pad: u8,
    a: u8,
    b: u8,
}

fn bad3_u8(r_add: u8, r_sub: u8, r_mul: u8, a: u64, b: u64) -> u32 {
    let mut bad: u32 = 0u32;
    if (r_add as u64) != exp_u8(0u32, a, b) {
        bad = bad + 1u32;
    }
    if (r_sub as u64) != exp_u8(1u32, a, b) {
        bad = bad + 1u32;
    }
    if (r_mul as u64) != exp_u8(2u32, a, b) {
        bad = bad + 1u32;
    }
    bad
}

fn via_param_u8(x: u8, y: u8, a: u64, b: u64) -> u32 {
    let r_add: u8 = x.saturating_add(y);
    let r_sub: u8 = x.saturating_sub(y);
    let r_mul: u8 = x.saturating_mul(y);
    bad3_u8(r_add, r_sub, r_mul, a, b)
}

fn via_field_u8(p: Pair_u8, a: u64, b: u64) -> u32 {
    let r_add: u8 = p.a.saturating_add(p.b);
    let r_sub: u8 = p.a.saturating_sub(p.b);
    let r_mul: u8 = p.a.saturating_mul(p.b);
    bad3_u8(r_add, r_sub, r_mul, a, b)
}

fn run_u8() -> u32 {
    let vals: [9]u64 = [0u64, 1u64, 2u64, 3u64, 127u64, 128u64, 129u64, 254u64, 255u64];
    let mut bad: u32 = 0u32;
    let mut i: usize = 0;
    while i < 9 {
        let mut j: usize = 0;
        while j < 9 {
            let a: u64 = vals[i];
            let b: u64 = vals[j];
            let mut pa: u64 = 0xA5A5A5A5A5A5A5A5u64;
            let mut pb: u64 = 0x5A5A5A5A5A5A5A5Au64;
            if ((i + j) % 2) == 1 {
                pa = 0xFFFFFFFFFFFFFFFFu64;
                pb = 0x0123456789ABCDEFu64;
            }
            let ra: u64 = (pa & 0xFFFFFFFFFFFFFF00u64) | ((a as u64) & 0xFFu64);
            let rb: u64 = (pb & 0xFFFFFFFFFFFFFF00u64) | ((b as u64) & 0xFFu64);
            let ca: u8 = ra as u8;
            let cb: u8 = rb as u8;
            let c_add: u8 = ca.saturating_add(cb);
            let c_sub: u8 = ca.saturating_sub(cb);
            let c_mul: u8 = ca.saturating_mul(cb);
            bad = bad + bad3_u8(c_add, c_sub, c_mul, a, b);
            bad = bad + via_param_u8(ra as u8, rb as u8, a, b);
            let p: Pair_u8 = Pair_u8 { pad: 0u8, a: ra as u8, b: rb as u8 };
            bad = bad + via_field_u8(p, a, b);
            j = j + 1;
        }
        i = i + 1;
    }
    bad
}
