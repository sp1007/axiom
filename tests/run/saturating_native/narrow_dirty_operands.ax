}

fn main() -> i32 {
    let mut bad: u32 = 0u32;
    bad = bad + run_u8();
    bad = bad + run_u16();
    bad = bad + run_u32();
    bad = bad + run_i8();
    bad = bad + run_i16();
    bad = bad + run_i32();
    if bad != 0u32 {
        print("NARROW-SAT-BAD ");
        print_int(bad as i64);
        print("\n");
        return 1;
    }
    print("NARROW-SAT-OK\n");
    0
}
