fn print_u64(v: u64) {
    if v >= 10u64 {
        print_u64(v / 10u64);
    }
    print_int((v % 10u64) as i64);
}

fn print_val(v: i8) {
    let x: i64 = v as i64;
    if x < 0i64 {
        print("-");
        let mag: u64 = (0u64).wrapping_sub(x as u64);
        print_u64(mag);
    } else {
        print_u64(x as u64);
    }
}

fn check_pair(a: i8, b: i8) {
    let ra: i8 = a.saturating_add(b);
    let rs: i8 = a.saturating_sub(b);
    let rm: i8 = a.saturating_mul(b);
    print_val(ra);
    print(" ");
    print_val(rs);
    print(" ");
    print_val(rm);
    print("\n");
}

fn check_consts(a: i8) {
    let c1: i8 = a.saturating_add(1i8);
    let c2: i8 = a.saturating_add(-1i8);
    let c3: i8 = a.saturating_sub(1i8);
    let c4: i8 = a.saturating_sub(-1i8);
    let c5: i8 = a.saturating_mul(-1i8);
    let c6: i8 = a.saturating_mul(2i8);
    let c7: i8 = a.saturating_mul(127i8);
    print("C ");
    print_val(c1);
    print(" ");
    print_val(c2);
    print(" ");
    print_val(c3);
    print(" ");
    print_val(c4);
    print(" ");
    print_val(c5);
    print(" ");
    print_val(c6);
    print(" ");
    print_val(c7);
    print("\n");
}

fn check_dirty(raw1: u64, raw2: u64) {
    let ca1: i8 = raw1 as i8;
    let ca2: i8 = raw2 as i8;
    let d1: i8 = ca1.saturating_add(1i8);
    let d2: i8 = ca1.saturating_sub(1i8);
    let d3: i8 = ca1.saturating_mul(-1i8);
    let d4: i8 = ca2.saturating_add(-2i8);
    let d5: i8 = ca2.saturating_sub(2i8);
    let d6: i8 = ca2.saturating_mul(2i8);
    print("D ");
    print_val(d1);
    print(" ");
    print_val(d2);
    print(" ");
    print_val(d3);
    print(" ");
    print_val(d4);
    print(" ");
    print_val(d5);
    print(" ");
    print_val(d6);
    print("\n");
}

fn main() -> i32 {
    let vals: [9]i8 = [(-128i8), (-127i8), (-2i8), (-1i8), 0i8, 1i8, 2i8, 126i8, 127i8];
    let mut i: usize = 0;
    while i < 9 {
        let mut j: usize = 0;
        while j < 9 {
            check_pair(vals[i], vals[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    let mut k: usize = 0;
    while k < 9 {
        let v: i8 = vals[k];
        check_consts(v);
        let low: u64 = (v as u64) & 0xFFu64;
        check_dirty(0xFFFFFFFFFFFF0000u64 | low, 0x5555AAAA55550000u64 | low);
        k = k + 1;
    }
    0
}
