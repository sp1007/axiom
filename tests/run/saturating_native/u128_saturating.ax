// T453: 128-bit row of the native saturating suite (T481 covers 8..64 bits). Expected lines are the
// SPEC-40 clamping oracle min(max(exact(a op b), u128.MIN), u128.MAX) computed with exact integers.

fn check_pair(a: u128, b: u128) {
    let ra: u128 = a.saturating_add(b);
    let rs: u128 = a.saturating_sub(b);
    let rm: u128 = a.saturating_mul(b);
    print_int(ra);
    print(" ");
    print_int(rs);
    print(" ");
    print_int(rm);
    print("\n");
}

fn check_consts(a: u128) {
    print("C");
    print(" ");
    print_int(a.saturating_add(1u128));
    print(" ");
    print_int(a.saturating_sub(1u128));
    print(" ");
    print_int(a.saturating_mul(1u128));
    print(" ");
    print_int(a.saturating_add(2u128));
    print(" ");
    print_int(a.saturating_sub(2u128));
    print(" ");
    print_int(a.saturating_mul(2u128));
    print(" ");
    print_int(a.saturating_add(18446744073709551616u128));
    print(" ");
    print_int(a.saturating_sub(18446744073709551616u128));
    print(" ");
    print_int(a.saturating_mul(18446744073709551616u128));
    print(" ");
    print_int(a.saturating_add(340282366920938463463374607431768211455u128));
    print(" ");
    print_int(a.saturating_sub(340282366920938463463374607431768211455u128));
    print(" ");
    print_int(a.saturating_mul(340282366920938463463374607431768211455u128));
    print("\n");
}

fn main() -> i32 {
    let vals: [12]u128 = [0u128, 1u128, 2u128, 3u128, 9223372036854775808u128, 18446744073709551615u128, 18446744073709551616u128, 18446744073709551617u128, 170141183460469231731687303715884105727u128, 170141183460469231731687303715884105728u128, 340282366920938463463374607431768211454u128, 340282366920938463463374607431768211455u128];
