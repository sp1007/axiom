}

fn main() -> i32 {
    let vals: [14]i128 = [(-170141183460469231731687303715884105727i128 - 1i128), (-170141183460469231731687303715884105727i128), (-18446744073709551616i128), (-9223372036854775808i128), (-2i128), (-1i128), 0i128, 1i128, 2i128, 9223372036854775808i128, 18446744073709551615i128, 18446744073709551616i128, 170141183460469231731687303715884105726i128, 170141183460469231731687303715884105727i128];
