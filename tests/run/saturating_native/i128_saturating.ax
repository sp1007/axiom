// T453: 128-bit row of the native saturating suite (T481 covers 8..64 bits). Expected lines are the
// SPEC-40 clamping oracle min(max(exact(a op b), i128.MIN), i128.MAX) computed with exact integers.

fn check_pair(a: i128, b: i128) {
    let ra: i128 = a.saturating_add(b);
    let rs: i128 = a.saturating_sub(b);
    let rm: i128 = a.saturating_mul(b);
    print_int(ra);
    print(" ");
    print_int(rs);
    print(" ");
    print_int(rm);
    print("\n");
}

fn check_consts(a: i128) {
    print("C");
    print(" ");
    print_int(a.saturating_add(1i128));
