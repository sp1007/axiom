fn print_u64(v: u64) {
    if v >= 10u64 {
        print_u64(v / 10u64);
    }
    print_int((v % 10u64) as i64);
}

fn print_val(v: u64) {
    print_u64(v as u64);
}

fn check_pair(a: u64, b: u64) {
    let ra: u64 = a.saturating_add(b);
    let rs: u64 = a.saturating_sub(b);
    let rm: u64 = a.saturating_mul(b);
    print_val(ra);
    print(" ");
    print_val(rs);
    print(" ");
    print_val(rm);
    print("\n");
}

fn check_consts(a: u64) {
    let c1: u64 = a.saturating_add(1u64);
    let c2: u64 = (1u64).saturating_add(a);
    let c3: u64 = a.saturating_sub(1u64);
    let c4: u64 = (0u64).saturating_sub(a);
    let c5: u64 = a.saturating_mul(2u64);
    let c6: u64 = a.saturating_mul(18446744073709551615u64);
    print("C ");
    print_val(c1);
    print(" ");
    print_val(c2);
    print(" ");
    print_val(c3);
    print(" ");
    print_val(c4);
    print(" ");
    print_val(c5);
    print(" ");
    print_val(c6);
    print("\n");
}

fn main() -> i32 {
    let vals: [6]u64 = [0u64, 1u64, 2u64, 9223372036854775808u64, 18446744073709551614u64, 18446744073709551615u64];
    let mut i: usize = 0;
    while i < 6 {
        let mut j: usize = 0;
        while j < 6 {
            check_pair(vals[i], vals[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    let mut k: usize = 0;
    while k < 6 {
        let v: u64 = vals[k];
        check_consts(v);
        k = k + 1;
    }
    0
}
