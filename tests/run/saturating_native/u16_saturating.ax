fn print_u64(v: u64) {
    if v >= 10u64 {
        print_u64(v / 10u64);
    }
    print_int((v % 10u64) as i64);
}

fn print_val(v: u16) {
    print_u64(v as u64);
}

fn check_pair(a: u16, b: u16) {
    let ra: u16 = a.saturating_add(b);
    let rs: u16 = a.saturating_sub(b);
    let rm: u16 = a.saturating_mul(b);
    print_val(ra);
    print(" ");
    print_val(rs);
    print(" ");
    print_val(rm);
    print("\n");
}

fn check_consts(a: u16) {
    let c1: u16 = a.saturating_add(1u16);
    let c2: u16 = (1u16).saturating_add(a);
    let c3: u16 = a.saturating_sub(1u16);
    let c4: u16 = (0u16).saturating_sub(a);
    let c5: u16 = a.saturating_mul(2u16);
    let c6: u16 = a.saturating_mul(65535u16);
    print("C ");
    print_val(c1);
    print(" ");
    print_val(c2);
    print(" ");
    print_val(c3);
    print(" ");
    print_val(c4);
    print(" ");
    print_val(c5);
    print(" ");
    print_val(c6);
    print("\n");
}

fn check_dirty(raw: u64) {
    let ca: u16 = raw as u16;
    let d1: u16 = ca.saturating_add(1u16);
    let d2: u16 = ca.saturating_sub(2u16);
    let d3: u16 = ca.saturating_mul(3u16);
    print("D ");
    print_val(d1);
    print(" ");
    print_val(d2);
    print(" ");
    print_val(d3);
    print("\n");
}

fn main() -> i32 {
    let vals: [6]u16 = [0u16, 1u16, 2u16, 32768u16, 65534u16, 65535u16];
    let mut i: usize = 0;
    while i < 6 {
        let mut j: usize = 0;
        while j < 6 {
            check_pair(vals[i], vals[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    let mut k: usize = 0;
    while k < 6 {
        let v: u16 = vals[k];
        check_consts(v);
        check_dirty(0xDEADBEEFCAFE0000u64 | (v as u64));
        k = k + 1;
    }
    0
}
