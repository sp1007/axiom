fn print_u64(v: u64) {
    if v >= 10u64 {
        print_u64(v / 10u64);
    }
    print_int((v % 10u64) as i64);
}

fn print_val(v: u8) {
    print_u64(v as u64);
}

fn check_pair(a: u8, b: u8) {
    let ra: u8 = a.saturating_add(b);
    let rs: u8 = a.saturating_sub(b);
    let rm: u8 = a.saturating_mul(b);
    print_val(ra);
    print(" ");
    print_val(rs);
    print(" ");
    print_val(rm);
    print("\n");
}

fn check_consts(a: u8) {
    let c1: u8 = a.saturating_add(1u8);
    let c2: u8 = (1u8).saturating_add(a);
    let c3: u8 = a.saturating_sub(1u8);
    let c4: u8 = (0u8).saturating_sub(a);
    let c5: u8 = a.saturating_mul(2u8);
    let c6: u8 = a.saturating_mul(255u8);
    print("C ");
    print_val(c1);
    print(" ");
    print_val(c2);
    print(" ");
    print_val(c3);
    print(" ");
    print_val(c4);
    print(" ");
    print_val(c5);
    print(" ");
    print_val(c6);
    print("\n");
}

fn check_dirty(raw: u64) {
    let ca: u8 = raw as u8;
    let d1: u8 = ca.saturating_add(1u8);
    let d2: u8 = ca.saturating_sub(2u8);
    let d3: u8 = ca.saturating_mul(3u8);
    print("D ");
    print_val(d1);
    print(" ");
    print_val(d2);
    print(" ");
    print_val(d3);
    print("\n");
}

fn main() -> i32 {
    let vals: [6]u8 = [0u8, 1u8, 2u8, 128u8, 254u8, 255u8];
    let mut i: usize = 0;
    while i < 6 {
        let mut j: usize = 0;
        while j < 6 {
            check_pair(vals[i], vals[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    let mut k: usize = 0;
    while k < 6 {
        let v: u8 = vals[k];
        check_consts(v);
        check_dirty(0xDEADBEEFCAFE0000u64 | (v as u64));
        k = k + 1;
    }
    0
}
