fn print_u64(v: u64) {
    if v >= 10u64 {
        print_u64(v / 10u64);
    }
    print_int((v % 10u64) as i64);
}

fn print_val(v: u32) {
    print_u64(v as u64);
}

fn check_pair(a: u32, b: u32) {
    let ra: u32 = a.saturating_add(b);
    let rs: u32 = a.saturating_sub(b);
    let rm: u32 = a.saturating_mul(b);
    print_val(ra);
    print(" ");
    print_val(rs);
    print(" ");
    print_val(rm);
    print("\n");
}

fn check_consts(a: u32) {
    let c1: u32 = a.saturating_add(1u32);
    let c2: u32 = (1u32).saturating_add(a);
    let c3: u32 = a.saturating_sub(1u32);
    let c4: u32 = (0u32).saturating_sub(a);
    let c5: u32 = a.saturating_mul(2u32);
    let c6: u32 = a.saturating_mul(4294967295u32);
    print("C ");
    print_val(c1);
    print(" ");
    print_val(c2);
    print(" ");
    print_val(c3);
    print(" ");
    print_val(c4);
    print(" ");
    print_val(c5);
    print(" ");
    print_val(c6);
    print("\n");
}

fn check_dirty(raw: u64) {
    let ca: u32 = raw as u32;
    let d1: u32 = ca.saturating_add(1u32);
    let d2: u32 = ca.saturating_sub(2u32);
    let d3: u32 = ca.saturating_mul(3u32);
    print("D ");
    print_val(d1);
    print(" ");
    print_val(d2);
    print(" ");
    print_val(d3);
    print("\n");
}

fn main() -> i32 {
    let vals: [6]u32 = [0u32, 1u32, 2u32, 2147483648u32, 4294967294u32, 4294967295u32];
    let mut i: usize = 0;
    while i < 6 {
        let mut j: usize = 0;
        while j < 6 {
            check_pair(vals[i], vals[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    let mut k: usize = 0;
    while k < 6 {
        let v: u32 = vals[k];
        check_consts(v);
        check_dirty(0xDEADBEEF00000000u64 | (v as u64));
        k = k + 1;
    }
    0
}
