struct Large {
    a0: i32, a1: i32, a2: i32, a3: i32, a4: i32, a5: i32, a6: i32, a7: i32,
    b0: i32, b1: i32, b2: i32, b3: i32, b4: i32, b5: i32, b6: i32, b7: i32
}
fn get_large() -> Large {
    Large {
        a0: 1, a1: 2, a2: 3, a3: 4, a4: 5, a5: 6, a6: 7, a7: 8,
        b0: 9, b1: 10, b2: 11, b3: 12, b4: 13, b5: 14, b6: 15, b7: 16
    }
}
fn sum_large(l: Large) -> i32 {
    l.a0 + l.b0
}
fn main() -> i32 {
    let l = get_large();
    sum_large(l)
}
