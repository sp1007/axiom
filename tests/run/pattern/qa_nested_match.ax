// test: run
// exit: 0

enum Status {
    Ok,
    Err(i32)
}

fn check(s: Status, c: char) -> i32 {
    match s {
        Status.Ok => {
            match c {
                'a'..='z' => return 1,
                _ => return 2,
            }
        },
        Status.Err(code) => {
            if code == 404 {
                return 3;
            } else {
                return 4;
            }
        }
    }
}

fn main() -> i32 {
    if check(Status.Ok, 'k') != 1 { return 1; }
    if check(Status.Ok, 'A') != 2 { return 2; }
    if check(Status.Err(404), 'x') != 3 { return 3; }
    if check(Status.Err(500), 'y') != 4 { return 4; }
    return 0;
}
