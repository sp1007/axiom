// test: run
// native-after: T040
struct Point { x: i32, y: i32 }

fn main() -> i32 {
    let x = 10;
    
    // Pattern that doesn't match, takes else branch
    let mut ok = 0;
    let 0..=5 = x else {
        ok = 1;
    };
    if (ok != 1) { return 1; }

    // Pattern that matches, continues execution
    let 10 = x else {
        return 2;
    };
    
    // struct destructuring in let else
    let p = Point { x: 3, y: 4 };
    let Point { x, y } = p else {
        return 3;
    };
    if (x != 3) { return 4; }
    if (y != 4) { return 5; }

    return 0;
}
