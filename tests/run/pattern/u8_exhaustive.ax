// test: run

fn check_exhaustive(x: u8) -> i32 {
    match x {
        0..=100 => return 1,
        101..=200 => return 2,
        201..=255 => return 3,
    }
}

fn main() -> i32 {
    if (check_exhaustive(50) != 1) { return 1; }
    if (check_exhaustive(150) != 2) { return 2; }
    if (check_exhaustive(250) != 3) { return 3; }
    return 0;
}
