// test: run
// native-after: T040

fn classify(c: char) -> i32 {
    match c {
        'a'..='z' | 'A'..='Z' | '_' => return 1,
        '0'..='9' => return 2,
        _ => return 0,
    }
}

fn main() -> i32 {
    if (classify('c') != 1) { return 1; }
    if (classify('X') != 1) { return 2; }
    if (classify('_') != 1) { return 3; }
    if (classify('5') != 2) { return 4; }
    if (classify('!') != 0) { return 5; }
    return 0;
}
