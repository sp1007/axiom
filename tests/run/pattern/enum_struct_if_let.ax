// test: run

enum Token {
    Ident,
    Num(i32),
    Eof,
}

struct Point {
    x: i32,
    y: i32,
}

fn main() -> i32 {
    let t = Token.Num(42);
    
    // if let
    if let Token.Num(v) = t {
        if (v != 42) { return 1; }
    } else {
        return 2;
    }

    // struct destructuring
    let p = Point { x: 10, y: 20 };
    let Point { x, y } = p;
    if (x != 10) { return 3; }
    if (y != 20) { return 4; }
    
    // while let
    let mut cnt = 0;
    let mut curr = Token.Num(42);
    while let Token.Num(v) = curr {
        cnt = cnt + 1;
        curr = Token.Ident;
    }
    if (cnt != 1) { return 5; }

    return 0;
}
