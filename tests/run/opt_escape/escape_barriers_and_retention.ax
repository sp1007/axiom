// test: run
// stdout: ESC_BARRIER_BANNER=Xin chào rào cản thoát bộ nhớ\nRET_ESCAPE_NRVO=109\nGLOBAL_ESCAPE_SINK=91\nPTR_IDENTITY_OBS=35\nLOOP_CARRIED_HEAP=101\nOVERSIZED_BOX=46\nESC_BARRIER_TOTAL=382\n

use std.core.host.heap_alloc
use std.core.host.heap_realloc
use std.core.host.heap_free

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapReAlloc(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_realloc(p: *mut u8, old_size: usize, new_size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if new_size < 16 { 16 } else { new_size };
    HeapReAlloc(h, 8u32, p, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn needs_drop<T>() -> bool { false }
@intrinsic unsafe fn drop_in_place<T>(p: *mut T) {}
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub struct Box<T> {
    pub ptr: *mut T,
}

impl<T> Drop for Box<T> {
    fn drop(self: mut_view<Box>) {
        if self.ptr as usize != 0 {
            if needs_drop<T>() {
                unsafe {
                    drop_in_place<T>(self.ptr);
                }
            }
            let sz = size_of<T>();
            let al = align_of<T>();
            unsafe {
                heap_free(self.ptr as *mut u8, sz, al);
            }
            self.ptr = 0 as *mut T;
        }
    }
}

pub fn box_new<T>(val: T) -> Box {
    let sz = size_of<T>();
    let al = align_of<T>();
    let raw = unsafe { heap_alloc(sz, al) };
    let p = raw as *mut T;
    unsafe {
        *p = val;
    }
    Box { ptr: p }
}

pub struct Vec<T> {
    pub ptr: *mut T,
    pub len: usize,
    pub cap: usize,
}

impl<T> Drop for Vec<T> {
    fn drop(self: mut_view<Vec>) {
        if self.ptr as usize != 0 {
            if needs_drop<T>() {
                let mut i: usize = 0;
                while i < self.len {
                    unsafe {
                        drop_in_place<T>(self.ptr + i);
                    }
                    i = i + 1;
                }
            }
            let sz = size_of<T>();
            let al = align_of<T>();
            unsafe {
                heap_free(self.ptr as *mut u8, self.cap * sz, al);
            }
            self.ptr = 0 as *mut T;
            self.len = 0;
            self.cap = 0;
        }
    }
}

pub fn vec_with_capacity<T>(capacity: usize) -> Vec {
    if capacity == 0 {
        return Vec { ptr: 0 as *mut T, len: 0, cap: 0 };
    }
    let sz = size_of<T>();
    let al = align_of<T>();
    let raw = unsafe { heap_alloc(capacity * sz, al) };
    Vec { ptr: raw as *mut T, len: 0, cap: capacity }
}

pub fn vec_push<T>(v: mut_view<Vec>, val: T) {
    if v.len == v.cap {
        let needed = v.len + 1;
        let mut new_cap = if v.cap == 0 { 4 } else { v.cap * 2 };
        if new_cap < needed {
            new_cap = needed;
        }
        let sz = size_of<T>();
        let al = align_of<T>();
        let raw = unsafe { heap_alloc(new_cap * sz, al) };
        let new_ptr = raw as *mut T;
        if v.len > 0 && v.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(v.ptr as *const u8, new_ptr as *mut u8, v.len * sz);
                heap_free(v.ptr as *mut u8, v.cap * sz, al);
            }
        }
        v.ptr = new_ptr;
        v.cap = new_cap;
    }
    unsafe {
        let p = v.ptr + v.len;
        *p = val;
    }
    v.len = v.len + 1;
}

struct Pair {
    a: i32,
    b: i32,
}

struct SinkBox {
    slot: mut_view<Box<i32>>,
}

struct BigBlock {
    data: [520]i64,
}

fn make_returned_box(x: i32) -> Box<i32> {
    box_new<i32>(x * 2 + 7)
}

fn make_nrvo_pair(x: i32) -> Pair {
    let p = Pair { a: x, b: x + 10 };
    p
}

fn test_return_escape_and_nrvo() -> i32 {
    let rb: Box<i32> = make_returned_box(30);
    let np: Pair = make_nrvo_pair(16);
    let rv: i32 = unsafe { *(rb.ptr) };
    rv + np.a + np.b
}

fn store_box_via_interior_mut_view(s: SinkBox, val: i32) {
    *(s.slot) = box_new<i32>(val);
}

fn test_global_escape_sink() -> i32 {
    let mut holder: Box<i32> = box_new<i32>(5);
    let sink = SinkBox { slot: mut_view(holder) };
    store_box_via_interior_mut_view(sink, 91);
    unsafe { *(holder.ptr) }
}

fn test_ptr_identity_and_usize_obs() -> i32 {
    let ba: Box<i32> = box_new<i32>(11);
    let bb: Box<i32> = box_new<i32>(22);
    let diff_ptr: i32 = if ba.ptr != bb.ptr { 1 } else { 0 };
    let ua: usize = ba.ptr as usize;
    let ub: usize = bb.ptr as usize;
    let diff_int: i32 = if ua != ub && ua != 0 && ub != 0 { 1 } else { 0 };
    let va: i32 = unsafe { *(ba.ptr) };
    let vb: i32 = unsafe { *(bb.ptr) };
    diff_ptr + diff_int + va + vb
}

fn test_loop_carried_boxes() -> i32 {
    let mut vec_b: Vec<Box<i32>> = vec_with_capacity<Box<i32>>(4);
    let mut i: i32 = 0;
    while i < 4 {
        let item: Box<i32> = box_new<i32>((i + 1) * 10);
        vec_push<Box<i32>>(mut_view(vec_b), item);
        i = i + 1;
    }
    // Verify distinct heap addresses across iterations + exact values 10, 20, 30, 40
    let p0: *mut i32 = unsafe { (*(vec_b.ptr + 0)).ptr };
    let p1: *mut i32 = unsafe { (*(vec_b.ptr + 1)).ptr };
    let p2: *mut i32 = unsafe { (*(vec_b.ptr + 2)).ptr };
    let p3: *mut i32 = unsafe { (*(vec_b.ptr + 3)).ptr };
    let distinct: i32 = if p0 != p1 && p1 != p2 && p2 != p3 && p0 != p3 { 1 } else { 0 };
    let sum_v: i32 = unsafe { *p0 + *p1 + *p2 + *p3 };
    sum_v + distinct
}

fn test_oversized_box() -> i32 {
    let init_blk = BigBlock { data: [0i64; 520] };
    let big_b: Box<BigBlock> = box_new<BigBlock>(init_blk);
    unsafe {
        (*(big_b.ptr)).data[0] = 12i64;
        (*(big_b.ptr)).data[519] = 34i64;
        ((*(big_b.ptr)).data[0] + (*(big_b.ptr)).data[519]) as i32
    }
}

fn main() -> i32 {
    print("ESC_BARRIER_BANNER=Xin chào rào cản thoát bộ nhớ\n");
    let r1: i32 = test_return_escape_and_nrvo();
    let r2: i32 = test_global_escape_sink();
    let r3: i32 = test_ptr_identity_and_usize_obs();
    let r4: i32 = test_loop_carried_boxes();
    let r5: i32 = test_oversized_box();

    print("RET_ESCAPE_NRVO=");
    print_int(r1);
    print("\nGLOBAL_ESCAPE_SINK=");
    print_int(r2);
    print("\nPTR_IDENTITY_OBS=");
    print_int(r3);
    print("\nLOOP_CARRIED_HEAP=");
    print_int(r4);
    print("\nOVERSIZED_BOX=");
    print_int(r5);
    print("\nESC_BARRIER_TOTAL=");
    print_int(r1 + r2 + r3 + r4 + r5);
    print("\n");
    0
}
