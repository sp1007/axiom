@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

@PROBE_MIR_FN@

fn probe_mir_blob(arena: mut_view<Arena>, idx: usize) -> StrView {
    let s: str = probe_mir_raw(idx);
    let raw_sv: StrView = unsafe { *(address_of(s) as *const StrView) };
    let bytes: view<[u8]> = unsafe { *(address_of(s) as *const view<[u8]>) };
    let n = raw_sv.len;
    let dst = arena_alloc_raw(mut_view(*arena), n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = bytes[i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn probe_set_ty_slot(types_arr: *mut *mut AxType, idx: usize, ptr: *mut AxType) {
    let slot = ((types_arr as usize) + mir_mul_usize(idx, size_of<*mut AxType>())) as *mut *mut AxType;
    unsafe { *slot = ptr; }
}

fn probe_ty_ptr(pool: *mut u8, idx_zero_based: usize) -> *mut AxType {
    ((pool as usize) + mir_mul_usize(idx_zero_based, size_of<AxType>())) as *mut AxType
}

fn probe_init_escape_thir(thir_ptr: *mut Thir, arena: mut_view<Arena>) {
    let types_arr = arena_alloc_raw(mut_view(*arena), mir_mul_usize(96, size_of<*mut AxType>()), align_of<*mut AxType>()) as *mut *mut AxType;
    let pool = arena_alloc_raw(mut_view(*arena), mir_mul_usize(72, size_of<AxType>()), align_of<AxType>());

    let mut k: usize = 0;
    while k < 16 {
        let tp = probe_ty_ptr(pool, k);
        let tk: u8 = if k < 9 { k as u8 }
            else if k == 9 { TY_ISIZE }
            else if k == 10 { TY_U8 }
            else if k == 11 { TY_U16 }
            else if k == 12 { TY_U32 }
            else if k == 13 { TY_U64 }
            else if k == 14 { TY_USIZE }
            else { TY_STR };
        unsafe { ax_type_reset(mut_view(*tp), tk); }
        probe_set_ty_slot(types_arr, k, tp);
        k = k + 1;
    }

    let mut c: usize = 16;
    while c < 52 {
        let cp = probe_ty_ptr(pool, c);
        unsafe { ax_type_reset(mut_view(*cp), 0u8); }
        probe_set_ty_slot(types_arr, c, cp);
        c = c + 1;
    }

    let pair_flds = arena_alloc_raw(mut_view(*arena), mir_mul_usize(2, size_of<TypeId>()), align_of<TypeId>()) as *mut TypeId;
    let i32_arg = arena_alloc_raw(mut_view(*arena), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
    let pair_arg = arena_alloc_raw(mut_view(*arena), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
    let ptr_i32_fld = arena_alloc_raw(mut_view(*arena), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
    let ptr_pair_fld = arena_alloc_raw(mut_view(*arena), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
    let alloc_params = arena_alloc_raw(mut_view(*arena), mir_mul_usize(2, size_of<TypeId>()), align_of<TypeId>()) as *mut TypeId;
    let free_params = arena_alloc_raw(mut_view(*arena), mir_mul_usize(3, size_of<TypeId>()), align_of<TypeId>()) as *mut TypeId;
    let box_i32_arg = arena_alloc_raw(mut_view(*arena), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
    let mv_i32_arg = arena_alloc_raw(mut_view(*arena), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
    let vw_i32_arg = arena_alloc_raw(mut_view(*arena), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
    let clos_fn_params = arena_alloc_raw(mut_view(*arena), mir_mul_usize(2, size_of<TypeId>()), align_of<TypeId>()) as *mut TypeId;
    let clos_cap = arena_alloc_raw(mut_view(*arena), size_of<ClosureCapture>(), align_of<ClosureCapture>()) as *mut ClosureCapture;
    let big_arg = arena_alloc_raw(mut_view(*arena), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
    let ptr_big_fld = arena_alloc_raw(mut_view(*arena), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
    let sink_ptr_fld = arena_alloc_raw(mut_view(*arena), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
    let mv_pair_arg = arena_alloc_raw(mut_view(*arena), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;

    unsafe {
        *opt_typeid_at(pair_flds, 0) = TypeId { v: 8u32 };
        *opt_typeid_at(pair_flds, 1) = TypeId { v: 8u32 };
        *opt_typeid_at(i32_arg, 0) = TypeId { v: 8u32 };
        *opt_typeid_at(pair_arg, 0) = TypeId { v: 20u32 };
        *opt_typeid_at(ptr_i32_fld, 0) = TypeId { v: 19u32 };
        *opt_typeid_at(ptr_pair_fld, 0) = TypeId { v: 26u32 };
        *opt_typeid_at(alloc_params, 0) = TypeId { v: 15u32 };
        *opt_typeid_at(alloc_params, 1) = TypeId { v: 15u32 };
        *opt_typeid_at(free_params, 0) = TypeId { v: 27u32 };
        *opt_typeid_at(free_params, 1) = TypeId { v: 15u32 };
        *opt_typeid_at(free_params, 2) = TypeId { v: 15u32 };
        *opt_typeid_at(box_i32_arg, 0) = TypeId { v: 24u32 };
        *opt_typeid_at(mv_i32_arg, 0) = TypeId { v: 18u32 };
        *opt_typeid_at(vw_i32_arg, 0) = TypeId { v: 17u32 };
        *opt_typeid_at(clos_fn_params, 0) = TypeId { v: 8u32 };
        *opt_typeid_at(clos_fn_params, 1) = TypeId { v: 8u32 };
        (*clos_cap).sym = SymbolId { v: 1u32 };
        (*clos_cap).ty = TypeId { v: 8u32 };
        (*clos_cap).mode = CAP_COPY;
        *opt_typeid_at(big_arg, 0) = TypeId { v: 37u32 };
        *opt_typeid_at(ptr_big_fld, 0) = TypeId { v: 38u32 };
        *opt_typeid_at(sink_ptr_fld, 0) = TypeId { v: 41u32 };
        *opt_typeid_at(mv_pair_arg, 0) = TypeId { v: 21u32 };

        (*probe_ty_ptr(pool, 16)).kind = TY_VIEW;
        (*probe_ty_ptr(pool, 16)).pointee = TypeId { v: 8u32 };

        (*probe_ty_ptr(pool, 17)).kind = TY_MUT_VIEW;
        (*probe_ty_ptr(pool, 17)).is_mut = true;
        (*probe_ty_ptr(pool, 17)).pointee = TypeId { v: 8u32 };

        (*probe_ty_ptr(pool, 18)).kind = TY_PTR;
        (*probe_ty_ptr(pool, 18)).is_mut = true;
        (*probe_ty_ptr(pool, 18)).pointee = TypeId { v: 8u32 };

        (*probe_ty_ptr(pool, 19)).kind = TY_STRUCT;
        (*probe_ty_ptr(pool, 19)).fields = pair_flds;
        (*probe_ty_ptr(pool, 19)).field_count = 2;

        (*probe_ty_ptr(pool, 20)).kind = TY_MUT_VIEW;
        (*probe_ty_ptr(pool, 20)).is_mut = true;
        (*probe_ty_ptr(pool, 20)).pointee = TypeId { v: 20u32 };

        (*probe_ty_ptr(pool, 21)).kind = TY_VIEW;
        (*probe_ty_ptr(pool, 21)).pointee = TypeId { v: 20u32 };

        (*probe_ty_ptr(pool, 22)).kind = TY_ARRAY;
        (*probe_ty_ptr(pool, 22)).elem = TypeId { v: 8u32 };
        (*probe_ty_ptr(pool, 22)).array_len = 4u64;

        // type#24 = Box<i32>
        (*probe_ty_ptr(pool, 23)).kind = TY_STRUCT;
        (*probe_ty_ptr(pool, 23)).fields = ptr_i32_fld;
        (*probe_ty_ptr(pool, 23)).field_count = 1;
        (*probe_ty_ptr(pool, 23)).args = i32_arg;
        (*probe_ty_ptr(pool, 23)).arg_count = 1;

        // type#25 = Box<Pair>
        (*probe_ty_ptr(pool, 24)).kind = TY_STRUCT;
        (*probe_ty_ptr(pool, 24)).fields = ptr_pair_fld;
        (*probe_ty_ptr(pool, 24)).field_count = 1;
        (*probe_ty_ptr(pool, 24)).args = pair_arg;
        (*probe_ty_ptr(pool, 24)).arg_count = 1;

        // type#26 = *mut Pair, type#27 = *mut u8
        (*probe_ty_ptr(pool, 25)).kind = TY_PTR;
        (*probe_ty_ptr(pool, 25)).is_mut = true;
        (*probe_ty_ptr(pool, 25)).pointee = TypeId { v: 20u32 };

        (*probe_ty_ptr(pool, 26)).kind = TY_PTR;
        (*probe_ty_ptr(pool, 26)).is_mut = true;
        (*probe_ty_ptr(pool, 26)).pointee = TypeId { v: 11u32 };

        // type#28 = fn(usize, usize) -> *mut u8 (heap_alloc)
        (*probe_ty_ptr(pool, 27)).kind = TY_FN;
        (*probe_ty_ptr(pool, 27)).param_types = alloc_params;
        (*probe_ty_ptr(pool, 27)).param_count = 2;
        (*probe_ty_ptr(pool, 27)).ret_type = TypeId { v: 27u32 };

        // type#29 = fn(*mut u8, usize, usize) -> unit (heap_free)
        (*probe_ty_ptr(pool, 28)).kind = TY_FN;
        (*probe_ty_ptr(pool, 28)).param_types = free_params;
        (*probe_ty_ptr(pool, 28)).param_count = 3;
        (*probe_ty_ptr(pool, 28)).ret_type = TypeId { v: 2u32 };

        // type#30 = fn(i32) -> Box<i32>, type#31 = fn(Pair) -> Box<Pair>, type#32 = fn(Box<i32>) -> *mut i32
        (*probe_ty_ptr(pool, 29)).kind = TY_FN;
        (*probe_ty_ptr(pool, 29)).param_types = i32_arg;
        (*probe_ty_ptr(pool, 29)).param_count = 1;
        (*probe_ty_ptr(pool, 29)).ret_type = TypeId { v: 24u32 };

        (*probe_ty_ptr(pool, 30)).kind = TY_FN;
        (*probe_ty_ptr(pool, 30)).param_types = pair_arg;
        (*probe_ty_ptr(pool, 30)).param_count = 1;
        (*probe_ty_ptr(pool, 30)).ret_type = TypeId { v: 25u32 };

        (*probe_ty_ptr(pool, 31)).kind = TY_FN;
        (*probe_ty_ptr(pool, 31)).param_types = box_i32_arg;
        (*probe_ty_ptr(pool, 31)).param_count = 1;
        (*probe_ty_ptr(pool, 31)).ret_type = TypeId { v: 19u32 };

        // type#33 = fn(mut_view<i32>) -> i32, type#34 = fn(view<i32>) -> view<i32>
        (*probe_ty_ptr(pool, 32)).kind = TY_FN;
        (*probe_ty_ptr(pool, 32)).param_types = mv_i32_arg;
        (*probe_ty_ptr(pool, 32)).param_count = 1;
        (*probe_ty_ptr(pool, 32)).ret_type = TypeId { v: 8u32 };

        (*probe_ty_ptr(pool, 33)).kind = TY_FN;
        (*probe_ty_ptr(pool, 33)).param_types = vw_i32_arg;
        (*probe_ty_ptr(pool, 33)).param_count = 1;
        (*probe_ty_ptr(pool, 33)).ret_type = TypeId { v: 17u32 };

        // type#35 = TY_CLOSURE(cap=[i32], (i32)->i32, fn_sym=200, fn_type=type#36)
        (*probe_ty_ptr(pool, 34)).kind = TY_CLOSURE;
        (*probe_ty_ptr(pool, 34)).fn_sym = 200u32;
        (*probe_ty_ptr(pool, 34)).fn_type = TypeId { v: 36u32 };
        (*probe_ty_ptr(pool, 34)).param_types = i32_arg;
        (*probe_ty_ptr(pool, 34)).param_count = 1;
        (*probe_ty_ptr(pool, 34)).ret_type = TypeId { v: 8u32 };
        (*probe_ty_ptr(pool, 34)).captures = clos_cap;
        (*probe_ty_ptr(pool, 34)).capture_count = 1;

        // type#36 = fn(i32, i32) -> i32
        (*probe_ty_ptr(pool, 35)).kind = TY_FN;
        (*probe_ty_ptr(pool, 35)).param_types = clos_fn_params;
        (*probe_ty_ptr(pool, 35)).param_count = 2;
        (*probe_ty_ptr(pool, 35)).ret_type = TypeId { v: 8u32 };

        // type#37 = [2048]i32 (8192 bytes), type#38 = *mut [2048]i32, type#39 = Box<[2048]i32>, type#40 = fn([2048]i32)->Box<[2048]i32>
        (*probe_ty_ptr(pool, 36)).kind = TY_ARRAY;
        (*probe_ty_ptr(pool, 36)).elem = TypeId { v: 8u32 };
        (*probe_ty_ptr(pool, 36)).array_len = 2048u64;

        (*probe_ty_ptr(pool, 37)).kind = TY_PTR;
        (*probe_ty_ptr(pool, 37)).is_mut = true;
        (*probe_ty_ptr(pool, 37)).pointee = TypeId { v: 37u32 };

        (*probe_ty_ptr(pool, 38)).kind = TY_STRUCT;
        (*probe_ty_ptr(pool, 38)).fields = ptr_big_fld;
        (*probe_ty_ptr(pool, 38)).field_count = 1;
        (*probe_ty_ptr(pool, 38)).args = big_arg;
        (*probe_ty_ptr(pool, 38)).arg_count = 1;

        (*probe_ty_ptr(pool, 39)).kind = TY_FN;
        (*probe_ty_ptr(pool, 39)).param_types = big_arg;
        (*probe_ty_ptr(pool, 39)).param_count = 1;
        (*probe_ty_ptr(pool, 39)).ret_type = TypeId { v: 39u32 };

        // type#41 = mut_view<*mut i32>, type#42 = struct SinkPtr { mv: mut_view<*mut i32> }
        (*probe_ty_ptr(pool, 40)).kind = TY_MUT_VIEW;
        (*probe_ty_ptr(pool, 40)).is_mut = true;
        (*probe_ty_ptr(pool, 40)).pointee = TypeId { v: 19u32 };

        (*probe_ty_ptr(pool, 41)).kind = TY_STRUCT;
        (*probe_ty_ptr(pool, 41)).fields = sink_ptr_fld;
        (*probe_ty_ptr(pool, 41)).field_count = 1;

        // type#43 = fn(mut_view<Pair>) -> i32
        (*probe_ty_ptr(pool, 42)).kind = TY_FN;
        (*probe_ty_ptr(pool, 42)).param_types = mv_pair_arg;
        (*probe_ty_ptr(pool, 42)).param_count = 1;
        (*probe_ty_ptr(pool, 42)).ret_type = TypeId { v: 8u32 };

        // type#44 = *mut *mut i32, type#45 = *mut Box<i32>, type#46 = Box<Box<i32>>, type#47 = fn(Box<i32>) -> Box<Box<i32>>
        let ptr_box_i32_fld = arena_alloc_raw(mut_view(*arena), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
        let mv_ptr_arg = arena_alloc_raw(mut_view(*arena), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
        let ptr_i32_arg = arena_alloc_raw(mut_view(*arena), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
        let two_ptr_args = arena_alloc_raw(mut_view(*arena), mir_mul_usize(2, size_of<TypeId>()), align_of<TypeId>()) as *mut TypeId;
        let clos_arg = arena_alloc_raw(mut_view(*arena), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;
        *opt_typeid_at(ptr_box_i32_fld, 0) = TypeId { v: 45u32 };
        *opt_typeid_at(mv_ptr_arg, 0) = TypeId { v: 41u32 };
        *opt_typeid_at(ptr_i32_arg, 0) = TypeId { v: 19u32 };
        *opt_typeid_at(two_ptr_args, 0) = TypeId { v: 19u32 };
        *opt_typeid_at(two_ptr_args, 1) = TypeId { v: 19u32 };
        *opt_typeid_at(clos_arg, 0) = TypeId { v: 35u32 };

        (*probe_ty_ptr(pool, 43)).kind = TY_PTR;
        (*probe_ty_ptr(pool, 43)).is_mut = true;
        (*probe_ty_ptr(pool, 43)).pointee = TypeId { v: 19u32 };

        (*probe_ty_ptr(pool, 44)).kind = TY_PTR;
        (*probe_ty_ptr(pool, 44)).is_mut = true;
        (*probe_ty_ptr(pool, 44)).pointee = TypeId { v: 24u32 };

        (*probe_ty_ptr(pool, 45)).kind = TY_STRUCT;
        (*probe_ty_ptr(pool, 45)).fields = ptr_box_i32_fld;
        (*probe_ty_ptr(pool, 45)).field_count = 1;
        (*probe_ty_ptr(pool, 45)).args = box_i32_arg;
        (*probe_ty_ptr(pool, 45)).arg_count = 1;

        (*probe_ty_ptr(pool, 46)).kind = TY_FN;
        (*probe_ty_ptr(pool, 46)).param_types = box_i32_arg;
        (*probe_ty_ptr(pool, 46)).param_count = 1;
        (*probe_ty_ptr(pool, 46)).ret_type = TypeId { v: 46u32 };

        // type#48 = fn(mut_view<*mut i32>) -> *mut i32
        (*probe_ty_ptr(pool, 47)).kind = TY_FN;
        (*probe_ty_ptr(pool, 47)).param_types = mv_ptr_arg;
        (*probe_ty_ptr(pool, 47)).param_count = 1;
        (*probe_ty_ptr(pool, 47)).ret_type = TypeId { v: 19u32 };

        // type#49 = fn(*mut i32) -> bool
        (*probe_ty_ptr(pool, 48)).kind = TY_FN;
        (*probe_ty_ptr(pool, 48)).param_types = ptr_i32_arg;
        (*probe_ty_ptr(pool, 48)).param_count = 1;
        (*probe_ty_ptr(pool, 48)).ret_type = TypeId { v: 4u32 };

        // type#50 = fn(*mut i32, *mut i32) -> bool
        (*probe_ty_ptr(pool, 49)).kind = TY_FN;
        (*probe_ty_ptr(pool, 49)).param_types = two_ptr_args;
        (*probe_ty_ptr(pool, 49)).param_count = 2;
        (*probe_ty_ptr(pool, 49)).ret_type = TypeId { v: 4u32 };

        // type#51 = fn(type#35) -> i32
        (*probe_ty_ptr(pool, 50)).kind = TY_FN;
        (*probe_ty_ptr(pool, 50)).param_types = clos_arg;
        (*probe_ty_ptr(pool, 50)).param_count = 1;
        (*probe_ty_ptr(pool, 50)).ret_type = TypeId { v: 8u32 };

        // type#52 = struct FlagPair { flag: bool, val: i32 }
        let flag_pair_flds = arena_alloc_raw(mut_view(*arena), mir_mul_usize(2, size_of<TypeId>()), align_of<TypeId>()) as *mut TypeId;
        *opt_typeid_at(flag_pair_flds, 0) = TypeId { v: 4u32 };
        *opt_typeid_at(flag_pair_flds, 1) = TypeId { v: 8u32 };
        (*probe_ty_ptr(pool, 51)).kind = TY_STRUCT;
        (*probe_ty_ptr(pool, 51)).fields = flag_pair_flds;
        (*probe_ty_ptr(pool, 51)).field_count = 2;

        let scratch_ty = probe_ty_ptr(pool, 60);
        let t_i128 = probe_ty_ptr(pool, 61);
        let t_u128 = probe_ty_ptr(pool, 62);
        ax_type_reset(mut_view(*t_i128), TY_I128);
        ax_type_reset(mut_view(*t_u128), TY_U128);

        (*thir_ptr).interner.arena = arena_new();
        (*thir_ptr).interner.map.keys = 0 as *mut *mut AxType;
        (*thir_ptr).interner.map.vals = 0 as *mut TypeId;
        (*thir_ptr).interner.map.states = 0 as *mut u8;
        (*thir_ptr).interner.map.len = 0;
        (*thir_ptr).interner.map.cap = 0;
        (*thir_ptr).interner.types = types_arr;
        (*thir_ptr).interner.len = 52;
        (*thir_ptr).interner.cap = 96;
        (*thir_ptr).interner.next_int_var = 1u32;
        (*thir_ptr).interner.scratch = scratch_ty;
        (*thir_ptr).interner.t_error.v = 1u32;
        (*thir_ptr).interner.t_unit.v = 2u32;
        (*thir_ptr).interner.t_never.v = 3u32;
        (*thir_ptr).interner.t_bool.v = 4u32;
        (*thir_ptr).interner.t_char.v = 5u32;
        (*thir_ptr).interner.t_i8.v = 6u32;
        (*thir_ptr).interner.t_i16.v = 7u32;
        (*thir_ptr).interner.t_i32.v = 8u32;
        (*thir_ptr).interner.t_i64.v = 9u32;
        (*thir_ptr).interner.t_isize.v = 10u32;
        (*thir_ptr).interner.t_u8.v = 11u32;
        (*thir_ptr).interner.t_u16.v = 12u32;
        (*thir_ptr).interner.t_u32.v = 13u32;
        (*thir_ptr).interner.t_u64.v = 14u32;
        (*thir_ptr).interner.t_usize.v = 15u32;
        (*thir_ptr).interner.t_str.v = 16u32;
        (*thir_ptr).interner.t_i128.v = 0x3FFF0128u32;
        (*thir_ptr).interner.t_u128.v = 0x3FFF0129u32;
        (*thir_ptr).item_types.keys = 0 as *mut usize;
        (*thir_ptr).item_types.vals = 0 as *mut TypeId;
        (*thir_ptr).item_types.states = 0 as *mut u8;
        (*thir_ptr).item_types.len = 0;
        (*thir_ptr).item_types.cap = 0;
        (*thir_ptr).expr_types.len = 0;
        (*thir_ptr).expr_types.cap = 0;
    }
}

fn probe_free_escape_thir(thir_ptr: *mut Thir) {
    unsafe {
        typemap_free(mut_view((*thir_ptr).interner.map));
        arena_destroy(mut_view((*thir_ptr).interner.arena));
    }
}

fn probe_seed_runtime_summaries(stab: mut_view<EscapeSummaryTable>, arena: mut_view<Arena>) {
    escape_summary_table_init(mut_view(*stab), mut_view(*arena), 48);

    // sym=100: heap_alloc(size, align) -> *mut u8
    let mut s_alloc = escape_summary_zero(SymbolId { v: 100u32 }, 2);
    s_alloc.returns_fresh_alloc = true;
    s_alloc.is_alloc_fn = true;
    escape_summary_table_register(mut_view(*stab), mut_view(*arena), SymbolId { v: 100u32 }, s_alloc);

    // sym=101: heap_free(ptr, size, align)
    let mut s_free = escape_summary_zero(SymbolId { v: 101u32 }, 3);
    escape_summary_set_param_escape(mut_view(s_free), mut_view(*arena), 0, ESC_ARGUMENT);
    s_free.is_free_fn = true;
    escape_summary_table_register(mut_view(*stab), mut_view(*arena), SymbolId { v: 101u32 }, s_free);

    // sym=102: box_new<i32>(val: i32) -> Box<i32>
    let mut s_box_i32 = escape_summary_zero(SymbolId { v: 102u32 }, 1);
    escape_summary_set_param_escape(mut_view(s_box_i32), mut_view(*arena), 0, ESC_RETURN);
    s_box_i32.returns_fresh_alloc = true;
    s_box_i32.ret_aliases_params_mask = 1u32;
    s_box_i32.is_box_new_fn = true;
    escape_summary_table_register(mut_view(*stab), mut_view(*arena), SymbolId { v: 102u32 }, s_box_i32);

    // sym=103: box_new<Pair>(val: Pair) -> Box<Pair>
    let mut s_box_pair = escape_summary_zero(SymbolId { v: 103u32 }, 1);
    escape_summary_set_param_escape(mut_view(s_box_pair), mut_view(*arena), 0, ESC_RETURN);
    s_box_pair.returns_fresh_alloc = true;
    s_box_pair.ret_aliases_params_mask = 1u32;
    s_box_pair.is_box_new_fn = true;
    escape_summary_table_register(mut_view(*stab), mut_view(*arena), SymbolId { v: 103u32 }, s_box_pair);

    // sym=104: box_into_raw<i32>(b: Box<i32>) -> *mut i32
    let mut s_into_raw = escape_summary_zero(SymbolId { v: 104u32 }, 1);
    escape_summary_set_param_escape(mut_view(s_into_raw), mut_view(*arena), 0, ESC_RETURN | ESC_EXTERNAL);
    s_into_raw.ret_aliases_params_mask = 1u32;
    s_into_raw.is_box_into_raw_fn = true;
    escape_summary_table_register(mut_view(*stab), mut_view(*arena), SymbolId { v: 104u32 }, s_into_raw);

    // sym=105: spawn(mv: mut_view<i32>) -> i32 (`ESC_THREAD`)
    let mut s_spawn = escape_summary_zero(SymbolId { v: 105u32 }, 1);
    escape_summary_set_param_escape(mut_view(s_spawn), mut_view(*arena), 0, ESC_THREAD);
    s_spawn.spawns_escape = true;
    s_spawn.is_spawn_fn = true;
    escape_summary_table_register(mut_view(*stab), mut_view(*arena), SymbolId { v: 105u32 }, s_spawn);

    // sym=106: extern FFI call (`ESC_EXTERNAL`)
    let mut s_ffi = escape_summary_zero(SymbolId { v: 106u32 }, 1);
    escape_summary_set_param_escape(mut_view(s_ffi), mut_view(*arena), 0, ESC_EXTERNAL);
    s_ffi.calls_ffi = true;
    escape_summary_table_register(mut_view(*stab), mut_view(*arena), SymbolId { v: 106u32 }, s_ffi);

    // sym=109: box_new<[2048]i32>(val: [2048]i32) -> Box<[2048]i32>
    let mut s_box_big = escape_summary_zero(SymbolId { v: 109u32 }, 1);
    escape_summary_set_param_escape(mut_view(s_box_big), mut_view(*arena), 0, ESC_RETURN);
    s_box_big.returns_fresh_alloc = true;
    s_box_big.ret_aliases_params_mask = 1u32;
    s_box_big.is_box_new_fn = true;
    escape_summary_table_register(mut_view(*stab), mut_view(*arena), SymbolId { v: 109u32 }, s_box_big);

    // sym=114: pure_borrow_pair(p: mut_view<Pair>) -> i32 (`ESC_ARGUMENT`)
    let mut s_borrow_pair = escape_summary_zero(SymbolId { v: 114u32 }, 1);
    escape_summary_set_param_escape(mut_view(s_borrow_pair), mut_view(*arena), 0, ESC_ARGUMENT);
    escape_summary_table_register(mut_view(*stab), mut_view(*arena), SymbolId { v: 114u32 }, s_borrow_pair);

    // sym=115: box_new<Box<i32>>(val: Box<i32>) -> Box<Box<i32>>
    let mut s_box_box = escape_summary_zero(SymbolId { v: 115u32 }, 1);
    escape_summary_set_param_escape(mut_view(s_box_box), mut_view(*arena), 0, ESC_RETURN);
    s_box_box.returns_fresh_alloc = true;
    s_box_box.ret_aliases_params_mask = 1u32;
    s_box_box.is_box_new_fn = true;
    escape_summary_table_register(mut_view(*stab), mut_view(*arena), SymbolId { v: 115u32 }, s_box_box);

    // sym=118: ffi_ptr_fn(p: *mut i32) -> bool (`ESC_EXTERNAL`)
    let mut s_ffi_ptr = escape_summary_zero(SymbolId { v: 118u32 }, 1);
    escape_summary_set_param_escape(mut_view(s_ffi_ptr), mut_view(*arena), 0, ESC_EXTERNAL);
    s_ffi_ptr.calls_ffi = true;
    escape_summary_table_register(mut_view(*stab), mut_view(*arena), SymbolId { v: 118u32 }, s_ffi_ptr);

    // sym=120: spawn_clos_fn(c: type#35) -> i32 (`ESC_THREAD`)
    let mut s_spawn_clos = escape_summary_zero(SymbolId { v: 120u32 }, 1);
    escape_summary_set_param_escape(mut_view(s_spawn_clos), mut_view(*arena), 0, ESC_THREAD);
    s_spawn_clos.spawns_escape = true;
    s_spawn_clos.is_spawn_fn = true;
    escape_summary_table_register(mut_view(*stab), mut_view(*arena), SymbolId { v: 120u32 }, s_spawn_clos);
}

fn probe_zero_bytes(ptr: *mut u8, byte_len: usize) {
    let mut i: usize = 0;
    while i < byte_len {
        unsafe { *(ptr + i) = 0u8; }
        i = i + 1;
    }
}

fn probe_make_fn_1arg(arena: mut_view<Arena>) -> *const HirItem {
    let fn_it = arena_alloc_raw(mut_view(*arena), size_of<HirItem>(), align_of<HirItem>()) as *mut HirItem;
    let p0 = arena_alloc_raw(mut_view(*arena), size_of<HirParam>(), align_of<HirParam>()) as *mut HirParam;
    probe_zero_bytes(fn_it as *mut u8, size_of<HirItem>());
    probe_zero_bytes(p0 as *mut u8, size_of<HirParam>());
    unsafe {
        (*p0).next = 0 as *mut HirParam;
        (*fn_it).kind = HIR_ITEM_FN;
        (*fn_it).params = p0;
    }
    fn_it as *const HirItem
}

fn probe_make_fn_2arg(arena: mut_view<Arena>) -> *const HirItem {
    let fn_it = arena_alloc_raw(mut_view(*arena), size_of<HirItem>(), align_of<HirItem>()) as *mut HirItem;
    let p0 = arena_alloc_raw(mut_view(*arena), size_of<HirParam>(), align_of<HirParam>()) as *mut HirParam;
    let p1 = arena_alloc_raw(mut_view(*arena), size_of<HirParam>(), align_of<HirParam>()) as *mut HirParam;
    probe_zero_bytes(fn_it as *mut u8, size_of<HirItem>());
    probe_zero_bytes(p0 as *mut u8, size_of<HirParam>());
    probe_zero_bytes(p1 as *mut u8, size_of<HirParam>());
    unsafe {
        (*p0).next = p1;
        (*p1).next = 0 as *mut HirParam;
        (*fn_it).kind = HIR_ITEM_FN;
        (*fn_it).params = p0;
    }
    fn_it as *const HirItem
}

unsafe fn probe_u16_at(base: *mut u16, idx: usize) -> *mut u16 {
    let off = mir_mul_usize(idx, size_of<u16>());
    ((base as usize) + off) as *mut u16
}

fn verify_escape_lattice_and_barriers(thir_ptr: *mut Thir, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> i32 {
    let fn_1arg = probe_make_fn_1arg(mut_view(*arena));
    let contract = escape_contract();
    if contract.pass_id != PASS_ESCAPE_PROMOTE || contract.postconditions == 0u32 {
        return 10;
    }

    // 1. 4-tier `EscapeClass` lattice & `ESC_*` bitset mapping (`AXS-ESC-001`, `REQ-OPT-042`)
    if escape_class_from_set(ESC_NONE) != ESCAPE_NO_ESCAPE ||
       escape_class_from_set(ESC_ARGUMENT) != ESCAPE_ARG_ESCAPE ||
       escape_class_from_set(ESC_RETURN) != ESCAPE_RETURN_ESCAPE ||
       escape_class_from_set(ESC_ARGUMENT | ESC_RETURN) != ESCAPE_RETURN_ESCAPE ||
       escape_class_from_set(ESC_HEAP) != ESCAPE_GLOBAL_ESCAPE ||
       escape_class_from_set(ESC_THREAD) != ESCAPE_GLOBAL_ESCAPE ||
       escape_class_from_set(ESC_EXTERNAL) != ESCAPE_GLOBAL_ESCAPE ||
       escape_class_from_set(ESC_UNKNOWN) != ESCAPE_GLOBAL_ESCAPE {
        return 11;
    }
    if escape_class_join(ESCAPE_NO_ESCAPE, ESCAPE_ARG_ESCAPE) != ESCAPE_ARG_ESCAPE ||
       escape_class_join(ESCAPE_ARG_ESCAPE, ESCAPE_RETURN_ESCAPE) != ESCAPE_RETURN_ESCAPE ||
       escape_class_join(ESCAPE_RETURN_ESCAPE, ESCAPE_GLOBAL_ESCAPE) != ESCAPE_GLOBAL_ESCAPE ||
       !escape_class_at_most(ESCAPE_ARG_ESCAPE, ESCAPE_RETURN_ESCAPE) ||
       escape_class_at_most(ESCAPE_GLOBAL_ESCAPE, ESCAPE_RETURN_ESCAPE) {
        return 12;
    }

    let stab_ptr = arena_alloc_raw(mut_view(*arena), size_of<EscapeSummaryTable>(), align_of<EscapeSummaryTable>()) as *mut EscapeSummaryTable;
    probe_seed_runtime_summaries(unsafe { mut_view(*stab_ptr) }, mut_view(*arena));

    // 2. Blob 0: `AESCAPE-26` (`*b` scalar return does NOT escape `b`) + non-null `p as usize != 0` check
    let sv0 = probe_mir_blob(mut_view(*arena), 0);
    let m0 = verify_parse_mir(sv0, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m0 as usize) == 0 {
        return 13;
    }
    let o0 = optir_build_from_mir(unsafe { view(*m0) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o0 as usize) == 0 || sink.errors != 0 {
        return 14;
    }
    optir_construct_memssa(unsafe { mut_view(*o0) }, mut_view(*arena));
    let info0 = escape_build_info(
        unsafe { view(*o0) },
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(*arena)
    );
    if escape_query_local_class(unsafe { view(*info0) }, 1u32) != ESCAPE_NO_ESCAPE ||
       escape_query_local_set(unsafe { view(*info0) }, 1u32) != ESC_NONE ||
       !escape_is_no_escape_proven(unsafe { view(*info0) }, 1u32) ||
       escape_query_local_storage(unsafe { view(*info0) }, 1u32) != STORAGE_DECISION_SSA_REGISTER ||
       !escape_is_stack_promotable(unsafe { view(*info0) }, 1u32) {
        return 15;
    }
    let lp0_1 = unsafe { escape_local_at((*info0).locals, 1) };
    if (unsafe { (*lp0_1).address_observable }) || (unsafe { (*lp0_1).reason }) != REASON_NO_ESCAPE_SROA {
        return 16;
    }

    // 3. Blob 1: All escape & storage barriers (`AXS-ESC-004`, `AXS-ESC-010`, `REQ-OPT-335..346`)
    let sv1 = probe_mir_blob(mut_view(*arena), 1);
    let m1 = verify_parse_mir(sv1, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m1 as usize) == 0 {
        return 17;
    }
    let o1 = optir_build_from_mir(unsafe { view(*m1) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), fn_1arg);
    if (o1 as usize) == 0 || sink.errors != 0 {
        return 18;
    }
    // Mark `(*_33) = const 99` in `bb7` as a volatile store (`OPT_INST_VOLATILE_STORE`) on `_12` (`_33 = &mut _12`)
    let bb7 = unsafe { opt_block_at((*o1).blocks, 7) };
    let mut found_vol = false;
    let mut ii: usize = 0;
    while ii < (unsafe { (*bb7).inst_count }) {
        let ip = unsafe { opt_inst_at((*bb7).insts, ii) };
        if (unsafe { (*ip).orig_stmt.place.local.v }) == 33u32 && (unsafe { (*ip).orig_stmt.place.proj_count }) == 1 {
            unsafe {
                (*ip).opcode = OPT_INST_VOLATILE_STORE;
                (*ip).flags = (*ip).flags | OPT_FLAG_BARRIER;
            }
            found_vol = true;
        }
        ii = ii + 1;
    }
    if !found_vol {
        return 19;
    }
    optir_construct_memssa(unsafe { mut_view(*o1) }, mut_view(*arena));
    let ainfo1 = alias_build_info(unsafe { view(*o1) }, 0 as *const EffectCallTable, mut_view(*arena));
    alias_mark_fixed_mmio(unsafe { mut_view(*ainfo1) }, 10u32, 1u32);
    alias_register_zero_copy_pin(unsafe { mut_view(*ainfo1) }, mut_view(*arena), 32u32, 11u32, ALIAS_PT_WHOLE_START, ALIAS_PT_WHOLE_END);

    let info1 = arena_alloc_raw(mut_view(*arena), size_of<EscapeInfo>(), align_of<EscapeInfo>()) as *mut EscapeInfo;
    escape_init_info(
        unsafe { mut_view(*info1) },
        unsafe { view(*o1) },
        unsafe { view(*ainfo1) },
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(*arena)
    );

    let l1_2 = unsafe { escape_local_at((*info1).locals, 2) };
    let l1_3 = unsafe { escape_local_at((*info1).locals, 3) };
    let l1_4 = unsafe { escape_local_at((*info1).locals, 4) };
    let l1_5 = unsafe { escape_local_at((*info1).locals, 5) };
    let l1_6 = unsafe { escape_local_at((*info1).locals, 6) };
    let l1_7 = unsafe { escape_local_at((*info1).locals, 7) };
    let l1_9 = unsafe { escape_local_at((*info1).locals, 9) };
    let l1_10 = unsafe { escape_local_at((*info1).locals, 10) };
    let l1_11 = unsafe { escape_local_at((*info1).locals, 11) };
    let l1_12 = unsafe { escape_local_at((*info1).locals, 12) };
    let l1_13 = unsafe { escape_local_at((*info1).locals, 13) };

    if !(unsafe { (*l1_2).address_observable }) ||
       (unsafe { (*l1_2).storage_decision }) != STORAGE_DECISION_HEAP ||
       (unsafe { (*l1_2).reason }) != REASON_ADDR_OBSERVABLE {
        return 20;
    }
    if !(unsafe { (*l1_3).identity_compared }) || !(unsafe { (*l1_4).identity_compared }) ||
       (unsafe { (*l1_3).storage_decision }) != STORAGE_DECISION_HEAP ||
       (unsafe { (*l1_3).reason }) != REASON_IDENTITY_COMPARED {
        return 21;
    }
    if ((unsafe { (*l1_5).escape_set }) & ESC_THREAD) == 0u16 ||
       (unsafe { (*l1_5).escape_class }) != ESCAPE_GLOBAL_ESCAPE ||
       (unsafe { (*l1_5).reason }) != REASON_THREAD_ESCAPE {
        return 22;
    }
    if ((unsafe { (*l1_6).escape_set }) & ESC_EXTERNAL) == 0u16 ||
       (unsafe { (*l1_6).escape_class }) != ESCAPE_GLOBAL_ESCAPE ||
       (unsafe { (*l1_6).reason }) != REASON_FFI_EXTERNAL_ESCAPE {
        return 23;
    }
    if ((unsafe { (*l1_7).escape_set }) & ESC_UNKNOWN) == 0u16 ||
       (unsafe { (*l1_7).escape_class }) != ESCAPE_GLOBAL_ESCAPE ||
       (unsafe { (*l1_7).no_escape_certainty }) != CERTAINTY_UNKNOWN ||
       (unsafe { (*l1_7).reason }) != REASON_UNKNOWN_CALL_ESCAPE {
        return 24;
    }
    if (unsafe { (*l1_9).size_bytes }) != 8192u64 ||
       (unsafe { (*l1_9).storage_decision }) != STORAGE_DECISION_HEAP ||
       (unsafe { (*l1_9).reason }) != REASON_BUDGET_EXCEEDED {
        return 25;
    }
    if (unsafe { (*l1_10).storage_decision }) != STORAGE_DECISION_FIXED_MMIO ||
       (unsafe { (*l1_10).reason }) != REASON_FIXED_MMIO {
        return 26;
    }
    if (unsafe { (*l1_11).storage_decision }) != STORAGE_DECISION_DEVICE_EXTERNAL ||
       (unsafe { (*l1_11).reason }) != REASON_ZERO_COPY_PINNED {
        return 27;
    }
    if (unsafe { (*l1_12).reason }) != REASON_VOLATILE_ATOMIC {
        return 28;
    }
    if ((unsafe { (*l1_13).escape_set }) & ESC_HEAP) == 0u16 ||
       (unsafe { (*l1_13).escape_class }) != ESCAPE_GLOBAL_ESCAPE ||
       (unsafe { (*l1_13).reason }) != REASON_GLOBAL_HEAP_ESCAPE {
        return 29;
    }

    print("PROBE_ESCAPE_LATTICE_AND_BARRIERS=OK\n");
    0
}

fn verify_interproc_summaries_and_scc(thir_ptr: *mut Thir, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> i32 {
    let stab_ptr = arena_alloc_raw(mut_view(*arena), size_of<EscapeSummaryTable>(), align_of<EscapeSummaryTable>()) as *mut EscapeSummaryTable;
    probe_seed_runtime_summaries(unsafe { mut_view(*stab_ptr) }, mut_view(*arena));

    let m_rec_a = verify_parse_mir(probe_mir_blob(mut_view(*arena), 2), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let m_rec_b = verify_parse_mir(probe_mir_blob(mut_view(*arena), 3), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let m_leak_a = verify_parse_mir(probe_mir_blob(mut_view(*arena), 4), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let m_leak_b = verify_parse_mir(probe_mir_blob(mut_view(*arena), 5), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let m_pass = verify_parse_mir(probe_mir_blob(mut_view(*arena), 6), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m_rec_a as usize) == 0 || (m_rec_b as usize) == 0 ||
       (m_leak_a as usize) == 0 || (m_leak_b as usize) == 0 || (m_pass as usize) == 0 {
        return 30;
    }
    unsafe {
        (*m_rec_a).fn_sym = SymbolId { v: 110u32 };
        (*m_rec_b).fn_sym = SymbolId { v: 111u32 };
        (*m_leak_a).fn_sym = SymbolId { v: 112u32 };
        (*m_leak_b).fn_sym = SymbolId { v: 113u32 };
        (*m_pass).fn_sym = SymbolId { v: 108u32 };
    }

    let bodies = arena_alloc_raw(mut_view(*arena), mir_mul_usize(5, size_of<*mut MirBody>()), align_of<*mut MirBody>()) as *mut *mut MirBody;
    unsafe {
        *(((bodies as usize) + mir_mul_usize(0, size_of<*mut MirBody>())) as *mut *mut MirBody) = m_rec_a;
        *(((bodies as usize) + mir_mul_usize(1, size_of<*mut MirBody>())) as *mut *mut MirBody) = m_rec_b;
        *(((bodies as usize) + mir_mul_usize(2, size_of<*mut MirBody>())) as *mut *mut MirBody) = m_leak_a;
        *(((bodies as usize) + mir_mul_usize(3, size_of<*mut MirBody>())) as *mut *mut MirBody) = m_leak_b;
        *(((bodies as usize) + mir_mul_usize(4, size_of<*mut MirBody>())) as *mut *mut MirBody) = m_pass;
    }

    let rounds = escape_solve_call_graph_summaries(
        bodies,
        5,
        thir_ptr as *const Thir,
        0 as *const EffectCallTable,
        unsafe { mut_view(*stab_ptr) },
        mut_view(*arena)
    );
    if rounds == 0u32 {
        return 31;
    }

    let mut s110 = escape_summary_zero(SymbolId { v: 0u32 }, 0);
    let mut s111 = escape_summary_zero(SymbolId { v: 0u32 }, 0);
    let mut s112 = escape_summary_zero(SymbolId { v: 0u32 }, 0);
    let mut s113 = escape_summary_zero(SymbolId { v: 0u32 }, 0);
    let mut s108 = escape_summary_zero(SymbolId { v: 0u32 }, 0);
    if !escape_summary_table_lookup(stab_ptr as *const EscapeSummaryTable, (SymbolId { v: 110u32 }), mut_view(s110)) ||
       !escape_summary_table_lookup(stab_ptr as *const EscapeSummaryTable, (SymbolId { v: 111u32 }), mut_view(s111)) ||
       !escape_summary_table_lookup(stab_ptr as *const EscapeSummaryTable, (SymbolId { v: 112u32 }), mut_view(s112)) ||
       !escape_summary_table_lookup(stab_ptr as *const EscapeSummaryTable, (SymbolId { v: 113u32 }), mut_view(s113)) ||
       !escape_summary_table_lookup(stab_ptr as *const EscapeSummaryTable, (SymbolId { v: 108u32 }), mut_view(s108)) {
        return 32;
    }

    // Non-escaping mutual recursion SCC (`rec_a <-> rec_b`) stays `ESC_ARGUMENT` (`AXS-ESC-003.3`, `REQ-OPT-357`)
    if escape_summary_param_escape(view(s110), 0) != ESC_ARGUMENT ||
       escape_summary_param_escape(view(s111), 0) != ESC_ARGUMENT ||
       s110.has_unknown_call || s111.has_unknown_call {
        return 33;
    }
    // Leaking mutual recursion SCC (`leak_a <-> leak_b`) propagates `ESC_EXTERNAL` across the cycle!
    if (escape_summary_param_escape(view(s112), 0) & ESC_EXTERNAL) == 0u16 ||
       (escape_summary_param_escape(view(s113), 0) & ESC_EXTERNAL) == 0u16 ||
       !s112.calls_ffi || !s113.calls_ffi {
        return 34;
    }
    // `passthrough_view` (`sym=108`) infers `ESC_RETURN` and `ret_aliases_params_mask == 1`
    if (escape_summary_param_escape(view(s108), 0) & ESC_RETURN) == 0u16 ||
       s108.ret_aliases_params_mask != 1u32 {
        return 35;
    }

    // Contextual caller 1 (Blob 7): consumes returned view locally -> `_1` stays `ESCAPE_ARG_ESCAPE`, stack-promotable!
    let m7 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 7), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let o7 = optir_build_from_mir(unsafe { view(*m7) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    optir_construct_memssa(unsafe { mut_view(*o7) }, mut_view(*arena));
    let info7 = escape_build_info(unsafe { view(*o7) }, 0 as *const EffectCallTable, stab_ptr as *const EscapeSummaryTable, mut_view(*arena));
    if escape_query_local_class(unsafe { view(*info7) }, 1u32) != ESCAPE_ARG_ESCAPE ||
       !escape_is_stack_promotable(unsafe { view(*info7) }, 1u32) {
        return 36;
    }

    // Contextual caller 2 (Blob 8): returns returned view -> `_1` becomes `ESCAPE_RETURN_ESCAPE` + `REASON_ACTIVE_VIEW_ESCAPE`!
    let m8 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 8), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let o8 = optir_build_from_mir(unsafe { view(*m8) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    optir_construct_memssa(unsafe { mut_view(*o8) }, mut_view(*arena));
    let info8 = escape_build_info(unsafe { view(*o8) }, 0 as *const EffectCallTable, stab_ptr as *const EscapeSummaryTable, mut_view(*arena));
    let l8_1 = unsafe { escape_local_at((*info8).locals, 1) };
    if escape_query_local_class(unsafe { view(*info8) }, 1u32) != ESCAPE_RETURN_ESCAPE ||
       !(unsafe { (*l8_1).has_active_view_escape }) ||
       (unsafe { (*l8_1).storage_decision }) != STORAGE_DECISION_HEAP ||
       (unsafe { (*l8_1).reason }) != REASON_ACTIVE_VIEW_ESCAPE {
        return 37;
    }

    print("PROBE_INTERPROC_SUMMARIES_AND_SCC=OK\n");
    0
}


fn diag_buf_equals(a: view<DiagBuffer>, b: view<DiagBuffer>) -> bool {
    if a.len != b.len {
        return false;
    }
    let mut i: usize = 0;
    while i < a.len {
        if (unsafe { *(a.ptr + i) }) != (unsafe { *(b.ptr + i) }) {
            return false;
        }
        i = i + 1;
    }
    true
}

fn verify_loop_and_disjoint_slots(thir_ptr: *mut Thir, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> i32 {
    let fn_1arg = probe_make_fn_1arg(mut_view(*arena));
    let stab_ptr = arena_alloc_raw(mut_view(*arena), size_of<EscapeSummaryTable>(), align_of<EscapeSummaryTable>()) as *mut EscapeSummaryTable;
    probe_seed_runtime_summaries(unsafe { mut_view(*stab_ptr) }, mut_view(*arena));

    // 1. Blob 9: Loop-carried `heap_alloc(16, 4)` without loop-internal killer -> `REASON_LOOP_CARRIED`, `STORAGE_DECISION_HEAP`
    let m9 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 9), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m9 as usize) == 0 {
        return 40;
    }
    let o9 = optir_build_from_mir(unsafe { view(*m9) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), fn_1arg);
    if (o9 as usize) == 0 || sink.errors != 0 {
        return 41;
    }
    let info9 = escape_build_info(unsafe { view(*o9) }, 0 as *const EffectCallTable, stab_ptr as *const EscapeSummaryTable, mut_view(*arena));
    if (unsafe { (*info9).site_count }) != 1 {
        return 42;
    }
    let sp9 = unsafe { escape_site_at((*info9).sites, 0) };
    if !(unsafe { (*sp9).in_loop }) ||
       !(unsafe { (*sp9).crosses_backedge }) ||
       (unsafe { (*sp9).storage_decision }) != STORAGE_DECISION_HEAP ||
       (unsafe { (*sp9).reason }) != REASON_LOOP_CARRIED {
        return 43;
    }

    // 2. Blob 10: Iteration-local `heap_alloc(16, 4)` + `heap_free` inside loop + disjoint `Pair` stack slots (`_6` and `_7`)
    let m10 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 10), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m10 as usize) == 0 {
        return 44;
    }
    let o10 = optir_build_from_mir(unsafe { view(*m10) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), fn_1arg);
    if (o10 as usize) == 0 || sink.errors != 0 {
        return 45;
    }
    let info10 = escape_build_info(unsafe { view(*o10) }, 0 as *const EffectCallTable, stab_ptr as *const EscapeSummaryTable, mut_view(*arena));
    if (unsafe { (*info10).site_count }) != 1 {
        return 46;
    }
    let sp10 = unsafe { escape_site_at((*info10).sites, 0) };
    if !(unsafe { (*sp10).in_loop }) ||
       (unsafe { (*sp10).crosses_backedge }) ||
       (unsafe { (*sp10).kind }) != ALLOC_KIND_BOUNDED_BUF ||
       (unsafe { (*sp10).storage_decision }) != STORAGE_DECISION_INLINE_BUFFER ||
       (unsafe { (*sp10).reason }) != REASON_INLINE_BUFFER {
        return 47;
    }
    if (unsafe { (*info10).disjoint_pair_count }) < 1 ||
       (unsafe { (*info10).reused_stack_bytes }) < 8u64 {
        return 48;
    }

    print("PROBE_LOOP_AND_DISJOINT_SLOTS=OK\n");
    0
}

fn verify_promotions_and_rollback(thir_ptr: *mut Thir, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> i32 {
    let stab_ptr = arena_alloc_raw(mut_view(*arena), size_of<EscapeSummaryTable>(), align_of<EscapeSummaryTable>()) as *mut EscapeSummaryTable;
    probe_seed_runtime_summaries(unsafe { mut_view(*stab_ptr) }, mut_view(*arena));

    let log_ptr = arena_alloc_raw(mut_view(*arena), size_of<EscapePromoteLog>(), align_of<EscapePromoteLog>()) as *mut EscapePromoteLog;
    escape_log_init(unsafe { mut_view(*log_ptr) }, mut_view(*arena), 32);

    // 1. Concrete `Box<i32>` SROA promotion (`REQ-OPT-335`, `REQ-OPT-346`)
    let m0 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 0), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m0 as usize) == 0 {
        return 50;
    }
    let mut stats0 = escape_stats_zero();
    if !escape_optimize_mir_body(
        unsafe { mut_view(*m0) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(stats0),
        log_ptr,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 || stats0.box_sroa_promotions != 1u32 || stats0.pass_rollbacks != 0u32 {
        return 51;
    }
    let m0_bb0 = unsafe { mir_bb_at((*m0).bbs, 0) };
    let m0_bb1 = unsafe { mir_bb_at((*m0).bbs, 1) };
    if (unsafe { (*m0_bb0).terminator.kind }) != MIR_TERM_GOTO ||
       (unsafe { (*m0_bb1).terminator.kind }) != MIR_TERM_DROP {
        return 52;
    }

    // 2. Concrete `Box<Pair>` `ArgumentEscape` stack-slot promotion (`REQ-OPT-335`, `AXS-ESC-011`)
    let m11 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 11), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m11 as usize) == 0 {
        return 53;
    }
    let mut stats11 = escape_stats_zero();
    if !escape_optimize_mir_body(
        unsafe { mut_view(*m11) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(stats11),
        log_ptr,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 || stats11.box_stack_promotions != 1u32 || stats11.pass_rollbacks != 0u32 {
        return 54;
    }
    let m11_bb0 = unsafe { mir_bb_at((*m11).bbs, 0) };
    if (unsafe { (*m11_bb0).terminator.kind }) != MIR_TERM_GOTO {
        return 55;
    }

    // 3. Concrete `NoEscape` closure capture scalarization & direct-call devirtualization (`REQ-OPT-336`, `AXS-ESC-012`)
    let m12 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 12), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m12 as usize) == 0 {
        return 56;
    }
    let mut stats12 = escape_stats_zero();
    if !escape_optimize_mir_body(
        unsafe { mut_view(*m12) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(stats12),
        log_ptr,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 || stats12.closure_env_promotions != 1u32 || stats12.closure_direct_calls != 1u32 {
        return 57;
    }
    let m12_bb0 = unsafe { mir_bb_at((*m12).bbs, 0) };
    if (unsafe { (*m12_bb0).terminator.kind }) != MIR_TERM_CALL ||
       (unsafe { (*m12_bb0).terminator.func.kind }) != MIR_OP_CONST ||
       (unsafe { (*m12_bb0).terminator.func.constant.val }) != 200u64 ||
       (unsafe { (*m12_bb0).terminator.arg_count }) != 2 {
        return 58;
    }

    // 4. Concrete bounded `[4]i32` inline buffer promotion + `NRVO` caller return-slot promotion (`REQ-OPT-345`, `AXS-ESC-013..014`)
    let m13 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 13), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m13 as usize) == 0 {
        return 59;
    }
    let mut stats13 = escape_stats_zero();
    if !escape_optimize_mir_body(
        unsafe { mut_view(*m13) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(stats13),
        log_ptr,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 || stats13.inline_buffer_promotions != 1u32 || stats13.nrvo_promotions != 1u32 {
        return 60;
    }
    let m13_bb0 = unsafe { mir_bb_at((*m13).bbs, 0) };
    let m13_bb1 = unsafe { mir_bb_at((*m13).bbs, 1) };
    if (unsafe { (*m13_bb0).terminator.kind }) != MIR_TERM_GOTO ||
       (unsafe { (*m13_bb1).terminator.kind }) != MIR_TERM_GOTO {
        return 61;
    }

    // 5. `-O0` (`OPT_PROFILE_DEBUG_O0`) preservation: zero promotion passes run
    let m0_o0 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 0), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let mut stats_o0 = escape_stats_zero();
    if !escape_optimize_mir_body(
        unsafe { mut_view(*m0_o0) },
        thir_ptr as *const Thir,
        OPT_PROFILE_DEBUG_O0,
        true,
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(stats_o0),
        log_ptr,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || stats_o0.pass_runs != 0u32 || (unsafe { (*mir_bb_at((*m0_o0).bbs, 0)).terminator.kind }) != MIR_TERM_CALL {
        return 62;
    }

    // 6. Atomic `PassManager` rollback on postcondition fault (`AXS-ESC-016`)
    let m0_rb = verify_parse_mir(probe_mir_blob(mut_view(*arena), 0), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let o0_rb = optir_build_from_mir(unsafe { view(*m0_rb) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    let pm_rb = arena_alloc_raw(mut_view(*arena), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
    passmgr_init(unsafe { mut_view(*pm_rb) }, opt_budget_for_profile(OPT_PROFILE_SPEED_O2, true), mut_view(*arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_rb) }, unsafe { mut_view(*o0_rb) }, mut_view(*arena));
    let pre_rev = unsafe { (*pm_rb).ir_revision };
    let info_rb = escape_build_info(unsafe { view(*o0_rb) }, 0 as *const EffectCallTable, stab_ptr as *const EscapeSummaryTable, mut_view(*arena));
    let mut stats_rb = escape_stats_zero();
    if escape_run_pass_internal(
        unsafe { mut_view(*pm_rb) },
        unsafe { mut_view(*o0_rb) },
        unsafe { mut_view(*info_rb) },
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(stats_rb),
        log_ptr,
        true,
        mut_view(*arena),
        mut_view(*sink)
    ) || stats_rb.pass_rollbacks != 1u32 || (unsafe { (*pm_rb).ir_revision }) != pre_rev || sink.errors != 0 {
        return 63;
    }

    // 7. Byte-identical deterministic `--emit=escape` printers (`AXS-ESC-017`)
    let mut db1: DiagBuffer = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<DiagBuffer>(), align_of<DiagBuffer>()) as *const DiagBuffer) };
    let mut db2: DiagBuffer = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<DiagBuffer>(), align_of<DiagBuffer>()) as *const DiagBuffer) };
    let mut db3: DiagBuffer = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<DiagBuffer>(), align_of<DiagBuffer>()) as *const DiagBuffer) };
    let mut db4: DiagBuffer = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<DiagBuffer>(), align_of<DiagBuffer>()) as *const DiagBuffer) };
    diag_buf_init(mut_view(db1));
    diag_buf_init(mut_view(db2));
    diag_buf_init(mut_view(db3));
    diag_buf_init(mut_view(db4));
    escape_print(unsafe { view(*info_rb) }, mut_view(db1));
    escape_print(unsafe { view(*info_rb) }, mut_view(db2));
    escape_promote_print(view(stats13), unsafe { view(*log_ptr) }, mut_view(db3));
    escape_promote_print(view(stats13), unsafe { view(*log_ptr) }, mut_view(db4));
    let det_ok = db1.len > 0 && diag_buf_equals(view(db1), view(db2)) &&
                 db3.len > 0 && diag_buf_equals(view(db3), view(db4));
    diag_buf_free(mut_view(db1));
    diag_buf_free(mut_view(db2));
    diag_buf_free(mut_view(db3));
    diag_buf_free(mut_view(db4));
    if !det_ok {
        return 64;
    }

    print("PROBE_PROMOTIONS_AND_ROLLBACK=OK\n");
    0
}

fn verify_qa_round1_soundness_regressions(thir_ptr: *mut Thir, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> i32 {
    let stab_ptr = arena_alloc_raw(mut_view(*arena), size_of<EscapeSummaryTable>(), align_of<EscapeSummaryTable>()) as *mut EscapeSummaryTable;
    probe_seed_runtime_summaries(unsafe { mut_view(*stab_ptr) }, mut_view(*arena));

    let log_ptr = arena_alloc_raw(mut_view(*arena), size_of<EscapePromoteLog>(), align_of<EscapePromoteLog>()) as *mut EscapePromoteLog;
    escape_log_init(unsafe { mut_view(*log_ptr) }, mut_view(*arena), 32);

    // --- QA Finding 1a: Nested `Box<Box<i32>>` & dereferenced `&mut _ptr` return escape ---
    let m14 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 14), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let m15 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 15), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m14 as usize) == 0 || (m15 as usize) == 0 {
        return 70;
    }
    let o14 = optir_build_from_mir(unsafe { view(*m14) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    let o15 = optir_build_from_mir(unsafe { view(*m15) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o14 as usize) == 0 || (o15 as usize) == 0 || sink.errors != 0 {
        return 71;
    }
    let info14 = escape_build_info(unsafe { view(*o14) }, 0 as *const EffectCallTable, stab_ptr as *const EscapeSummaryTable, mut_view(*arena));
    let info15 = escape_build_info(unsafe { view(*o15) }, 0 as *const EffectCallTable, stab_ptr as *const EscapeSummaryTable, mut_view(*arena));
    if (escape_query_local_set(unsafe { view(*info14) }, 1u32) & ESC_RETURN) == 0u16 ||
       escape_query_local_class(unsafe { view(*info14) }, 1u32) != ESCAPE_RETURN_ESCAPE ||
       escape_query_local_storage(unsafe { view(*info14) }, 1u32) != STORAGE_DECISION_HEAP {
        return 72;
    }
    if (escape_query_local_set(unsafe { view(*info15) }, 1u32) & ESC_RETURN) == 0u16 ||
       escape_query_local_class(unsafe { view(*info15) }, 1u32) != ESCAPE_RETURN_ESCAPE ||
       escape_query_local_storage(unsafe { view(*info15) }, 1u32) != STORAGE_DECISION_HEAP {
        return 73;
    }
    let mut st15 = escape_stats_zero();
    if !escape_optimize_mir_body(
        unsafe { mut_view(*m15) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(st15),
        log_ptr,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 || st15.box_sroa_promotions != 0u32 || st15.box_stack_promotions != 0u32 {
        return 74;
    }

    // --- QA Finding 1b & Finding 4: Interprocedural deref-parameter escape + pointer observability/identity summaries ---
    let m16 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 16), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let m17 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 17), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let m21 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 21), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let m22 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 22), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m16 as usize) == 0 || (m17 as usize) == 0 || (m21 as usize) == 0 || (m22 as usize) == 0 {
        return 75;
    }
    unsafe {
        (*m16).fn_sym = SymbolId { v: 116u32 };
        (*m17).fn_sym = SymbolId { v: 121u32 };
        (*m21).fn_sym = SymbolId { v: 117u32 };
        (*m22).fn_sym = SymbolId { v: 119u32 };
    }
    let qbodies = arena_alloc_raw(mut_view(*arena), mir_mul_usize(4, size_of<*mut MirBody>()), align_of<*mut MirBody>()) as *mut *mut MirBody;
    unsafe {
        *(((qbodies as usize) + mir_mul_usize(0, size_of<*mut MirBody>())) as *mut *mut MirBody) = m16;
        *(((qbodies as usize) + mir_mul_usize(1, size_of<*mut MirBody>())) as *mut *mut MirBody) = m17;
        *(((qbodies as usize) + mir_mul_usize(2, size_of<*mut MirBody>())) as *mut *mut MirBody) = m21;
        *(((qbodies as usize) + mir_mul_usize(3, size_of<*mut MirBody>())) as *mut *mut MirBody) = m22;
    }
    let qrounds = escape_solve_call_graph_summaries(
        qbodies,
        4,
        thir_ptr as *const Thir,
        0 as *const EffectCallTable,
        unsafe { mut_view(*stab_ptr) },
        mut_view(*arena)
    );
    if qrounds == 0u32 {
        return 76;
    }
    let mut s116 = escape_summary_zero(SymbolId { v: 0u32 }, 0);
    let mut s121 = escape_summary_zero(SymbolId { v: 0u32 }, 0);
    let mut s117 = escape_summary_zero(SymbolId { v: 0u32 }, 0);
    let mut s119 = escape_summary_zero(SymbolId { v: 0u32 }, 0);
    if !escape_summary_table_lookup(stab_ptr as *const EscapeSummaryTable, (SymbolId { v: 116u32 }), mut_view(s116)) ||
       !escape_summary_table_lookup(stab_ptr as *const EscapeSummaryTable, (SymbolId { v: 121u32 }), mut_view(s121)) ||
       !escape_summary_table_lookup(stab_ptr as *const EscapeSummaryTable, (SymbolId { v: 117u32 }), mut_view(s117)) ||
       !escape_summary_table_lookup(stab_ptr as *const EscapeSummaryTable, (SymbolId { v: 119u32 }), mut_view(s119)) {
        return 77;
    }
    if (escape_summary_param_escape(view(s116), 0) & ESC_RETURN) == 0u16 || s116.ret_aliases_params_mask != 1u32 {
        return 78;
    }
    if (escape_summary_param_escape(view(s121), 0) & ESC_EXTERNAL) == 0u16 || !s121.calls_ffi {
        return 79;
    }
    if !escape_summary_param_addr_observed(view(s117), 0) ||
       !escape_summary_param_identity_compared(view(s119), 0) ||
       !escape_summary_param_identity_compared(view(s119), 1) {
        return 80;
    }

    // Caller Blob 23 invoking `obs_ptr_fn` (117) and `cmp_ptrs_fn` (119) on two `Box<i32>` allocations:
    let m23 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 23), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m23 as usize) == 0 {
        return 81;
    }
    let o23 = optir_build_from_mir(unsafe { view(*m23) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o23 as usize) == 0 || sink.errors != 0 {
        return 82;
    }
    let info23 = escape_build_info(unsafe { view(*o23) }, 0 as *const EffectCallTable, stab_ptr as *const EscapeSummaryTable, mut_view(*arena));
    let l23_1 = unsafe { escape_local_at((*info23).locals, 1) };
    let l23_2 = unsafe { escape_local_at((*info23).locals, 2) };
    if !(unsafe { (*l23_1).address_observable }) ||
       !(unsafe { (*l23_1).identity_compared }) ||
       !(unsafe { (*l23_2).identity_compared }) ||
       (unsafe { (*l23_1).storage_decision }) != STORAGE_DECISION_HEAP ||
       (unsafe { (*l23_2).storage_decision }) != STORAGE_DECISION_HEAP {
        return 83;
    }
    let mut st23 = escape_stats_zero();
    if !escape_optimize_mir_body(
        unsafe { mut_view(*m23) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(st23),
        log_ptr,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 || st23.box_sroa_promotions != 0u32 || st23.box_stack_promotions != 0u32 {
        return 84;
    }

    // --- QA Finding 2a & 2b: Whole-value `Box` branch move & unbalanced `heap_alloc` branch free ---
    let m18 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 18), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let m19 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 19), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m18 as usize) == 0 || (m19 as usize) == 0 {
        return 85;
    }
    let o18 = optir_build_from_mir(unsafe { view(*m18) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    let o19 = optir_build_from_mir(unsafe { view(*m19) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o18 as usize) == 0 || (o19 as usize) == 0 || sink.errors != 0 {
        return 86;
    }
    let info18 = escape_build_info(unsafe { view(*o18) }, 0 as *const EffectCallTable, stab_ptr as *const EscapeSummaryTable, mut_view(*arena));
    let info19 = escape_build_info(unsafe { view(*o19) }, 0 as *const EffectCallTable, stab_ptr as *const EscapeSummaryTable, mut_view(*arena));
    if (unsafe { (*info18).site_count }) != 1 || (unsafe { (*info19).site_count }) != 1 {
        return 87;
    }
    let sp18 = unsafe { escape_site_at((*info18).sites, 0) };
    let sp19 = unsafe { escape_site_at((*info19).sites, 0) };
    if (unsafe { (*sp18).has_matching_free }) ||
       (unsafe { (*sp18).reason }) != REASON_UNBALANCED_FREE ||
       (unsafe { (*sp18).storage_decision }) != STORAGE_DECISION_HEAP {
        return 88;
    }
    if (unsafe { (*sp19).has_matching_free }) ||
       (unsafe { (*sp19).reason }) != REASON_UNBALANCED_FREE ||
       (unsafe { (*sp19).storage_decision }) != STORAGE_DECISION_HEAP {
        return 89;
    }
    let mut st18 = escape_stats_zero();
    let mut st19 = escape_stats_zero();
    if !escape_optimize_mir_body(
        unsafe { mut_view(*m18) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(st18),
        log_ptr,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 || st18.box_sroa_promotions != 0u32 || st18.box_stack_promotions != 0u32 {
        return 90;
    }
    if !escape_optimize_mir_body(
        unsafe { mut_view(*m19) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(st19),
        log_ptr,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 || st19.inline_buffer_promotions != 0u32 || st19.box_stack_promotions != 0u32 {
        return 91;
    }

    // --- QA Finding 3: Sequential `[StorageLive, StorageDead]` stack locals with pointer comparison/observability ---
    let m20 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 20), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m20 as usize) == 0 {
        return 92;
    }
    let o20 = optir_build_from_mir(unsafe { view(*m20) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o20 as usize) == 0 || sink.errors != 0 {
        return 93;
    }
    let info20 = escape_build_info(unsafe { view(*o20) }, 0 as *const EffectCallTable, stab_ptr as *const EscapeSummaryTable, mut_view(*arena));
    let l20_1 = unsafe { escape_local_at((*info20).locals, 1) };
    let l20_2 = unsafe { escape_local_at((*info20).locals, 2) };
    if !(unsafe { (*l20_1).identity_compared }) ||
       !(unsafe { (*l20_2).identity_compared }) ||
       !(unsafe { (*l20_1).address_observable }) ||
       (unsafe { (*info20).disjoint_pair_count }) != 0 ||
       (unsafe { (*info20).reused_stack_bytes }) != 0u64 {
        return 94;
    }

    // --- QA Finding 5a & 5b: Closure capture `StorageDead` before call + moved closure alias passed to `spawn` ---
    let m24 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 24), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let m25 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 25), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m24 as usize) == 0 || (m25 as usize) == 0 {
        return 95;
    }
    let mut st24 = escape_stats_zero();
    if !escape_optimize_mir_body(
        unsafe { mut_view(*m24) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(st24),
        log_ptr,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 || st24.closure_env_promotions != 0u32 || st24.closure_direct_calls != 0u32 {
        return 96;
    }
    let o25 = optir_build_from_mir(unsafe { view(*m25) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o25 as usize) == 0 || sink.errors != 0 {
        return 97;
    }
    let info25 = escape_build_info(unsafe { view(*o25) }, 0 as *const EffectCallTable, stab_ptr as *const EscapeSummaryTable, mut_view(*arena));
    let l25_2 = unsafe { escape_local_at((*info25).locals, 2) };
    if ((unsafe { (*l25_2).escape_set }) & ESC_THREAD) == 0u16 ||
       (unsafe { (*l25_2).escape_class }) != ESCAPE_GLOBAL_ESCAPE ||
       (unsafe { (*l25_2).reason }) != REASON_THREAD_ESCAPE ||
       (unsafe { (*l25_2).storage_decision }) != STORAGE_DECISION_HEAP {
        return 98;
    }

    // --- QA Finding 6: `p as usize` used in `!= 0` AND array index `_6[_4]` / `&_6[_4]` ---
    let m26 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 26), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m26 as usize) == 0 {
        return 99;
    }
    let o26 = optir_build_from_mir(unsafe { view(*m26) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o26 as usize) == 0 || sink.errors != 0 {
        return 100;
    }
    let info26 = escape_build_info(unsafe { view(*o26) }, 0 as *const EffectCallTable, stab_ptr as *const EscapeSummaryTable, mut_view(*arena));
    let l26_1 = unsafe { escape_local_at((*info26).locals, 1) };
    if !(unsafe { (*l26_1).address_observable }) ||
       (unsafe { (*l26_1).reason }) != REASON_ADDR_OBSERVABLE ||
       (unsafe { (*l26_1).storage_decision }) != STORAGE_DECISION_HEAP {
        return 101;
    }
    let mut st26 = escape_stats_zero();
    if !escape_optimize_mir_body(
        unsafe { mut_view(*m26) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(st26),
        log_ptr,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 || st26.box_sroa_promotions != 0u32 || st26.box_stack_promotions != 0u32 {
        return 102;
    }

    print("PROBE_QA_ROUND1_REGRESSIONS=OK\n");
    0
}

fn verify_qa_round2_regressions(thir_ptr: *mut Thir, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> i32 {
    let stab_ptr = arena_alloc_raw(mut_view(*arena), size_of<EscapeSummaryTable>(), align_of<EscapeSummaryTable>()) as *mut EscapeSummaryTable;
    probe_seed_runtime_summaries(unsafe { mut_view(*stab_ptr) }, mut_view(*arena));
    let log_ptr = arena_alloc_raw(mut_view(*arena), size_of<EscapePromoteLog>(), align_of<EscapePromoteLog>()) as *mut EscapePromoteLog;
    escape_log_init(unsafe { mut_view(*log_ptr) }, mut_view(*arena), 64);

    // --- Round 2 / Finding 1a: Parameterized 2-arg function (`arg_count == 2`) exercising ALL 4 promotion kinds ---
    // Tested with BOTH `fn_item == 0` and `fn_item == probe_make_fn_2arg` and BOTH `verify_each = false` and `true`!
    let m27_a = verify_parse_mir(probe_mir_blob(mut_view(*arena), 27), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let m27_b = verify_parse_mir(probe_mir_blob(mut_view(*arena), 27), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let m27_c = verify_parse_mir(probe_mir_blob(mut_view(*arena), 27), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m27_a as usize) == 0 || (m27_b as usize) == 0 || (m27_c as usize) == 0 {
        return 110;
    }
    if (unsafe { (*m27_a).arg_count }) != 2 {
        return 111;
    }
    let mut st27_a = escape_stats_zero();
    if !escape_optimize_mir_body(
        unsafe { mut_view(*m27_a) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        false,
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(st27_a),
        log_ptr,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 || st27_a.pass_rollbacks != 0u32 ||
       st27_a.box_sroa_promotions != 1u32 || st27_a.closure_env_promotions != 1u32 ||
       st27_a.closure_direct_calls != 1u32 || st27_a.inline_buffer_promotions != 1u32 ||
       st27_a.nrvo_promotions != 1u32 {
        return 112;
    }

    let mut st27_b = escape_stats_zero();
    if !escape_optimize_mir_body(
        unsafe { mut_view(*m27_b) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(st27_b),
        log_ptr,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 || st27_b.pass_rollbacks != 0u32 ||
       st27_b.box_sroa_promotions != 1u32 || st27_b.closure_env_promotions != 1u32 ||
       st27_b.closure_direct_calls != 1u32 || st27_b.inline_buffer_promotions != 1u32 ||
       st27_b.nrvo_promotions != 1u32 {
        return 113;
    }

    let fn_2arg = probe_make_fn_2arg(mut_view(*arena));
    let mut st27_c = escape_stats_zero();
    if !escape_optimize_mir_body(
        unsafe { mut_view(*m27_c) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(st27_c),
        log_ptr,
        mut_view(*arena),
        mut_view(*sink),
        fn_2arg
    ) || sink.errors != 0 || st27_c.pass_rollbacks != 0u32 ||
       st27_c.box_sroa_promotions != 1u32 || st27_c.closure_env_promotions != 1u32 ||
       st27_c.inline_buffer_promotions != 1u32 || st27_c.nrvo_promotions != 1u32 {
        return 114;
    }

    // --- Round 2 / Finding 1b: Parameterized 1-arg `Box<Pair>` stack promotion via `escape_run_pipeline` + `verify_each` ---
    let fn_1arg = probe_make_fn_1arg(mut_view(*arena));
    let m28 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 28), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m28 as usize) == 0 || (unsafe { (*m28).arg_count }) != 1 {
        return 115;
    }
    let o28 = optir_build_from_mir(unsafe { view(*m28) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), fn_1arg);
    if (o28 as usize) == 0 || sink.errors != 0 {
        return 116;
    }
    let pm28 = arena_alloc_raw(mut_view(*arena), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
    passmgr_init(unsafe { mut_view(*pm28) }, opt_budget_for_profile(OPT_PROFILE_SPEED_O2, true), mut_view(*arena));
    let mut st28 = escape_stats_zero();
    if !escape_run_pipeline(
        unsafe { mut_view(*pm28) },
        unsafe { mut_view(*o28) },
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(st28),
        log_ptr,
        mut_view(*arena),
        mut_view(*sink)
    ) || sink.errors != 0 || st28.box_stack_promotions != 1u32 || st28.pass_rollbacks != 0u32 {
        return 117;
    }

    // --- Round 2 / Finding 1c: Negative definite-init check STILL catches uninitialized non-arg locals when `arg_count >= 1` ---
    let m29 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 29), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m29 as usize) == 0 || (unsafe { (*m29).arg_count }) != 1 {
        return 118;
    }
    let mut st29 = escape_stats_zero();
    if escape_optimize_mir_body(
        unsafe { mut_view(*m29) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(st29),
        log_ptr,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) {
        return 119;
    }
    sink.errors = 0;

    // Also test internal pass rollback when a parameterized `OptBody` reconstructs an uninitialized non-arg local read:
    let m29_rb = verify_parse_mir(probe_mir_blob(mut_view(*arena), 29), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    let o29_rb = optir_build_from_mir(unsafe { view(*m29_rb) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), fn_1arg);
    if (o29_rb as usize) == 0 || sink.errors != 0 {
        return 120;
    }
    let pm29 = arena_alloc_raw(mut_view(*arena), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
    passmgr_init(unsafe { mut_view(*pm29) }, opt_budget_for_profile(OPT_PROFILE_SPEED_O2, true), mut_view(*arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm29) }, unsafe { mut_view(*o29_rb) }, mut_view(*arena));
    let info29 = escape_build_info(unsafe { view(*o29_rb) }, 0 as *const EffectCallTable, stab_ptr as *const EscapeSummaryTable, mut_view(*arena));
    let mut st29_rb = escape_stats_zero();
    if escape_run_pass_internal(
        unsafe { mut_view(*pm29) },
        unsafe { mut_view(*o29_rb) },
        unsafe { mut_view(*info29) },
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(st29_rb),
        log_ptr,
        false,
        mut_view(*arena),
        mut_view(*sink)
    ) || st29_rb.pass_rollbacks != 1u32 || sink.errors != 0 {
        return 121;
    }

    // --- Round 2 / Finding 2: `FunctionEscapeSummary` dynamic Arena reallocation & canary memory-corruption guard ---
    let mut sum_a: FunctionEscapeSummary = escape_summary_zero(SymbolId { v: 0u32 }, 0);
    escape_summary_init(mut_view(sum_a), SymbolId { v: 500u32 }, 18);
    if escape_summary_param_escape(view(sum_a), 17) != ESC_NONE ||
       escape_summary_param_escape(view(sum_a), 18) != ESC_UNKNOWN {
        return 122;
    }
    escape_summary_set_param_escape(mut_view(sum_a), mut_view(*arena), 17, ESC_ARGUMENT);
    let canary_esc = arena_alloc_raw(mut_view(*arena), mir_mul_usize(32, size_of<u16>()), align_of<u16>()) as *mut u16;
    let mut ci: usize = 0;
    while ci < 32 {
        unsafe { *probe_u16_at(canary_esc, ci) = 0x1234u16; }
        ci = ci + 1;
    }
    // Grow `extra_param_escapes` across 32, 64, 100, and 130 parameters — must reallocate without touching `canary_esc`!
    escape_summary_set_param_escape(mut_view(sum_a), mut_view(*arena), 36, ESC_RETURN);
    escape_summary_set_param_escape(mut_view(sum_a), mut_view(*arena), 99, ESC_HEAP);
    escape_summary_set_param_escape(mut_view(sum_a), mut_view(*arena), 129, ESC_EXTERNAL);

    escape_summary_set_param_observability(mut_view(sum_a), mut_view(*arena), 33, true, false);
    let canary_obs = arena_alloc_raw(mut_view(*arena), 64, 1);
    let mut co: usize = 0;
    while co < 64 {
        unsafe { *(canary_obs + co) = 0x55u8; }
        co = co + 1;
    }
    // Grow `extra_param_obs_flags` across 64, 105, and 129 — must reallocate without touching `canary_obs`!
    escape_summary_set_param_observability(mut_view(sum_a), mut_view(*arena), 68, false, true);
    escape_summary_set_param_observability(mut_view(sum_a), mut_view(*arena), 105, true, true);
    escape_summary_set_param_observability(mut_view(sum_a), mut_view(*arena), 129, true, false);

    let mut sum_dst = escape_summary_zero(SymbolId { v: 502u32 }, 20);
    escape_summary_set_param_escape(mut_view(sum_dst), mut_view(*arena), 18, ESC_THREAD);
    let canary_join = arena_alloc_raw(mut_view(*arena), mir_mul_usize(32, size_of<u16>()), align_of<u16>()) as *mut u16;
    let mut cj: usize = 0;
    while cj < 32 {
        unsafe { *probe_u16_at(canary_join, cj) = 0x7777u16; }
        cj = cj + 1;
    }
    if !escape_summary_join(mut_view(sum_dst), view(sum_a), mut_view(*arena)) {
        return 123;
    }

    let mut vk: usize = 0;
    while vk < 32 {
        if (unsafe { *probe_u16_at(canary_esc, vk) }) != 0x1234u16 ||
           (unsafe { *probe_u16_at(canary_join, vk) }) != 0x7777u16 {
            return 124;
        }
        vk = vk + 1;
    }
    let mut vo: usize = 0;
    while vo < 64 {
        if (unsafe { *(canary_obs + vo) }) != 0x55u8 {
            return 125;
        }
        vo = vo + 1;
    }
    if sum_dst.param_count != 130 ||
       escape_summary_param_escape(view(sum_dst), 17) != ESC_ARGUMENT ||
       escape_summary_param_escape(view(sum_dst), 18) != ESC_THREAD ||
       escape_summary_param_escape(view(sum_dst), 19) != ESC_NONE ||
       escape_summary_param_escape(view(sum_dst), 36) != ESC_RETURN ||
       escape_summary_param_escape(view(sum_dst), 99) != ESC_HEAP ||
       escape_summary_param_escape(view(sum_dst), 128) != ESC_NONE ||
       escape_summary_param_escape(view(sum_dst), 129) != ESC_EXTERNAL ||
       escape_summary_param_escape(view(sum_dst), 130) != ESC_UNKNOWN ||
       !escape_summary_param_addr_observed(view(sum_dst), 33) ||
       escape_summary_param_identity_compared(view(sum_dst), 33) ||
       escape_summary_param_addr_observed(view(sum_dst), 68) ||
       !escape_summary_param_identity_compared(view(sum_dst), 68) ||
       !escape_summary_param_addr_observed(view(sum_dst), 105) ||
       !escape_summary_param_identity_compared(view(sum_dst), 105) ||
       !escape_summary_param_addr_observed(view(sum_dst), 129) ||
       escape_summary_param_identity_compared(view(sum_dst), 129) {
        return 126;
    }

    // --- Round 2 / Finding 3a: QA's exact NRVO + `switchInt(copy _4.0)` + `box_new<i32>` reproducer ---
    let m30 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 30), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m30 as usize) == 0 {
        return 127;
    }
    let mut st30 = escape_stats_zero();
    if !escape_optimize_mir_body(
        unsafe { mut_view(*m30) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(st30),
        log_ptr,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 || st30.pass_rollbacks != 0u32 ||
       st30.box_sroa_promotions != 1u32 || st30.nrvo_promotions != 1u32 {
        return 128;
    }
    let m30_bb1 = unsafe { mir_bb_at((*m30).bbs, 1) };
    if (unsafe { (*m30_bb1).terminator.kind }) != MIR_TERM_SWITCH_INT ||
       (unsafe { (*m30_bb1).terminator.discr.place.local.v }) != 0u32 {
        return 129;
    }

    // --- Round 2 / Finding 3b: Parameterized NRVO `FlagPair` (`arg_count == 1`) + `MIR_TERM_ASSERT(copy _5.0)` ---
    let m31 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 31), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m31 as usize) == 0 || (unsafe { (*m31).arg_count }) != 1 {
        return 130;
    }
    let m31_bb1_pre = unsafe { mir_bb_at((*m31).bbs, 1) };
    let proj_f0 = arena_alloc_raw(mut_view(*arena), size_of<MirProjection>(), align_of<MirProjection>()) as *mut MirProjection;
    unsafe {
        (*proj_f0).kind = MIR_PROJ_FIELD;
        (*proj_f0).field_idx = 0u32;
        (*proj_f0).index_local = MirLocalId { v: 0u32 };
        (*proj_f0).from_local = MirLocalId { v: 0u32 };
        (*proj_f0).to_local = MirLocalId { v: 0u32 };
        (*proj_f0).has_from = false;
        (*proj_f0).has_to = false;
        (*proj_f0).variant_idx = 0u32;
        let sp = (*m31_bb1_pre).terminator.span;
        mir_term_reset(mut_view((*m31_bb1_pre).terminator), MIR_TERM_ASSERT, view(sp));
        (*m31_bb1_pre).terminator.cond = mir_op_copy_local(5u32);
        (*m31_bb1_pre).terminator.cond.place.projs = proj_f0;
        (*m31_bb1_pre).terminator.cond.place.proj_count = 1;
        (*m31_bb1_pre).terminator.expected = true;
        (*m31_bb1_pre).terminator.assert_target = MirBbId { v: 2u32 };
        (*m31_bb1_pre).terminator.assert_unwind = MirBbId { v: 4u32 };
    }
    let mut st31 = escape_stats_zero();
    if !escape_optimize_mir_body(
        unsafe { mut_view(*m31) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(st31),
        log_ptr,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 || st31.pass_rollbacks != 0u32 ||
       st31.box_sroa_promotions != 1u32 || st31.nrvo_promotions != 1u32 {
        return 131;
    }
    let m31_bb1_post = unsafe { mir_bb_at((*m31).bbs, 1) };
    if (unsafe { (*m31_bb1_post).terminator.kind }) != MIR_TERM_ASSERT ||
       (unsafe { (*m31_bb1_post).terminator.cond.place.local.v }) != 0u32 {
        return 132;
    }

    // --- Round 2 / Finding 3c: Multi-`MIR_TERM_RETURN` NRVO rejection (`return_term_count == 2`) ---
    let m32 = verify_parse_mir(probe_mir_blob(mut_view(*arena), 32), unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m32 as usize) == 0 {
        return 133;
    }
    let mut st32 = escape_stats_zero();
    if !escape_optimize_mir_body(
        unsafe { mut_view(*m32) },
        thir_ptr as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        stab_ptr as *const EscapeSummaryTable,
        mut_view(st32),
        log_ptr,
        mut_view(*arena),
        mut_view(*sink),
        0 as *const HirItem
    ) || sink.errors != 0 || st32.pass_rollbacks != 0u32 ||
       st32.box_sroa_promotions != 1u32 || st32.nrvo_promotions != 0u32 {
        return 134;
    }

    print("PROBE_QA_ROUND2_REGRESSIONS=OK\n");
    0
}

fn main() -> i32 {
    let mut arena = arena_new();
    let mut sink: DiagSink = unsafe { *(arena_alloc_raw(mut_view(arena), size_of<DiagSink>(), align_of<DiagSink>()) as *const DiagSink) };
    diag_sink_init(mut_view(sink));

    let thir_ptr = arena_alloc_raw(mut_view(arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    probe_init_escape_thir(thir_ptr, mut_view(arena));

    let r1 = verify_escape_lattice_and_barriers(thir_ptr, mut_view(arena), mut_view(sink));
    if r1 != 0 {
        probe_free_escape_thir(thir_ptr);
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return r1;
    }

    let r2 = verify_interproc_summaries_and_scc(thir_ptr, mut_view(arena), mut_view(sink));
    if r2 != 0 {
        probe_free_escape_thir(thir_ptr);
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return r2;
    }

    let r3 = verify_loop_and_disjoint_slots(thir_ptr, mut_view(arena), mut_view(sink));
    if r3 != 0 {
        probe_free_escape_thir(thir_ptr);
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return r3;
    }

    let r4 = verify_promotions_and_rollback(thir_ptr, mut_view(arena), mut_view(sink));
    if r4 != 0 {
        probe_free_escape_thir(thir_ptr);
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return r4;
    }

    let r5 = verify_qa_round1_soundness_regressions(thir_ptr, mut_view(arena), mut_view(sink));
    if r5 != 0 {
        probe_free_escape_thir(thir_ptr);
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return r5;
    }

    let r6 = verify_qa_round2_regressions(thir_ptr, mut_view(arena), mut_view(sink));
    if r6 != 0 {
        probe_free_escape_thir(thir_ptr);
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return r6;
    }

    probe_free_escape_thir(thir_ptr);
    diag_sink_free(mut_view(sink));
    arena_destroy(mut_view(arena));
    print("PROBE_ALL=OK\n");
    0
}
