// test: run
// stdout: ESC_PROMO_BANNER=Xin chào tối ưu hóa cấp phát ngăn xếp\nBOX_NOESCAPE=158\nBOX_ARG_ESCAPE=95\nCLOSURE_PROMO=227\nBOUNDED_BUF=340\nESC_PROMO_TOTAL=820\n

use std.core.host.heap_alloc
use std.core.host.heap_realloc
use std.core.host.heap_free

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapReAlloc(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_realloc(p: *mut u8, old_size: usize, new_size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if new_size < 16 { 16 } else { new_size };
    HeapReAlloc(h, 8u32, p, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn needs_drop<T>() -> bool { false }
@intrinsic unsafe fn drop_in_place<T>(p: *mut T) {}
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub struct Box<T> {
    pub ptr: *mut T,
}

impl<T> Drop for Box<T> {
    fn drop(self: mut_view<Box>) {
        if self.ptr as usize != 0 {
            if needs_drop<T>() {
                unsafe {
                    drop_in_place<T>(self.ptr);
                }
            }
            let sz = size_of<T>();
            let al = align_of<T>();
            unsafe {
                heap_free(self.ptr as *mut u8, sz, al);
            }
            self.ptr = 0 as *mut T;
        }
    }
}

pub fn box_new<T>(val: T) -> Box {
    let sz = size_of<T>();
    let al = align_of<T>();
    let raw = unsafe { heap_alloc(sz, al) };
    let p = raw as *mut T;
    unsafe {
        *p = val;
    }
    Box { ptr: p }
}

pub struct Vec<T> {
    pub ptr: *mut T,
    pub len: usize,
    pub cap: usize,
}

impl<T> Drop for Vec<T> {
    fn drop(self: mut_view<Vec>) {
        if self.ptr as usize != 0 {
            if needs_drop<T>() {
                let mut i: usize = 0;
                while i < self.len {
                    unsafe {
                        drop_in_place<T>(self.ptr + i);
                    }
                    i = i + 1;
                }
            }
            let sz = size_of<T>();
            let al = align_of<T>();
            unsafe {
                heap_free(self.ptr as *mut u8, self.cap * sz, al);
            }
            self.ptr = 0 as *mut T;
            self.len = 0;
            self.cap = 0;
        }
    }
}

pub fn vec_with_capacity<T>(capacity: usize) -> Vec {
    if capacity == 0 {
        return Vec { ptr: 0 as *mut T, len: 0, cap: 0 };
    }
    let sz = size_of<T>();
    let al = align_of<T>();
    let raw = unsafe { heap_alloc(capacity * sz, al) };
    Vec { ptr: raw as *mut T, len: 0, cap: capacity }
}

pub fn vec_push<T>(v: mut_view<Vec>, val: T) {
    if v.len == v.cap {
        let needed = v.len + 1;
        let mut new_cap = if v.cap == 0 { 4 } else { v.cap * 2 };
        if new_cap < needed {
            new_cap = needed;
        }
        let sz = size_of<T>();
        let al = align_of<T>();
        let raw = unsafe { heap_alloc(new_cap * sz, al) };
        let new_ptr = raw as *mut T;
        if v.len > 0 && v.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(v.ptr as *const u8, new_ptr as *mut u8, v.len * sz);
                heap_free(v.ptr as *mut u8, v.cap * sz, al);
            }
        }
        v.ptr = new_ptr;
        v.cap = new_cap;
    }
    unsafe {
        let p = v.ptr + v.len;
        *p = val;
    }
    v.len = v.len + 1;
}

struct Pair {
    a: i32,
    b: i32,
}

fn noescape_box_scalar_and_pair() -> i32 {
    let b1: Box<i32> = box_new<i32>(40);
    unsafe {
        *(b1.ptr) = *(b1.ptr) + 18;
    }
    let bp: Box<Pair> = box_new<Pair>(Pair { a: 35, b: 65 });
    let s1: i32 = unsafe { *(b1.ptr) };
    let s2: i32 = unsafe { (*(bp.ptr)).a + (*(bp.ptr)).b };
    s1 + s2
}

fn bump_pair(p: mut_view<Pair>, delta: i32) {
    p.a = p.a + delta;
    p.b = p.b + delta;
}

fn read_pair_diff(p: view<Pair>) -> i32 {
    (p.b - p.a) + 5
}

fn arg_escape_box_helpers() -> i32 {
    let bp: Box<Pair> = box_new<Pair>(Pair { a: 20, b: 30 });
    unsafe {
        bump_pair(mut_view(*(bp.ptr)), 15);
    }
    let sum_ab: i32 = unsafe { (*(bp.ptr)).a + (*(bp.ptr)).b };
    let diff_v: i32 = unsafe { read_pair_diff(view(*(bp.ptr))) };
    sum_ab + diff_v
}

fn noescape_capturing_closures() -> i32 {
    let factor: i32 = 17;
    let bias: i32 = 10;
    let add_f = |x: i32| -> i32 { x + factor };
    let aff = |x: i32, y: i32| -> i32 { x * 3 + y + bias };
    let r1: i32 = add_f(23);
    let r2: i32 = aff(50, 27);
    r1 + r2
}

fn bounded_buffer_and_vec() -> i32 {
    let esz: usize = size_of<i32>();
    let eal: usize = align_of<i32>();
    let raw: *mut u8 = unsafe { heap_alloc(4 * esz, eal) };
    let buf: *mut i32 = raw as *mut i32;
    let mut bsum: i32 = 0;
    unsafe {
        *(buf + 0) = 10;
        *(buf + 1) = 20;
        *(buf + 2) = 30;
        *(buf + 3) = 40;
        bsum = *(buf + 0) + *(buf + 1) + *(buf + 2) + *(buf + 3);
        heap_free(raw, 4 * esz, eal);
    }

    let mut v: Vec<i32> = vec_with_capacity<i32>(4);
    vec_push<i32>(mut_view(v), 50);
    vec_push<i32>(mut_view(v), 60);
    vec_push<i32>(mut_view(v), 70);
    vec_push<i32>(mut_view(v), 60);
    let mut vsum: i32 = 0;
    let mut i: usize = 0;
    while i < v.len {
        vsum = vsum + unsafe { *(v.ptr + i) };
        i = i + 1;
    }
    bsum + vsum
}

fn main() -> i32 {
    print("ESC_PROMO_BANNER=Xin chào tối ưu hóa cấp phát ngăn xếp\n");
    let c1: i32 = noescape_box_scalar_and_pair();
    let c2: i32 = arg_escape_box_helpers();
    let c3: i32 = noescape_capturing_closures();
    let c4: i32 = bounded_buffer_and_vec();

    print("BOX_NOESCAPE=");
    print_int(c1);
    print("\nBOX_ARG_ESCAPE=");
    print_int(c2);
    print("\nCLOSURE_PROMO=");
    print_int(c3);
    print("\nBOUNDED_BUF=");
    print_int(c4);
    print("\nESC_PROMO_TOTAL=");
    print_int(c1 + c2 + c3 + c4);
    print("\n");
    0
}
