// test: run
// stdout: ESC_DROP_BANNER=Xin chào thứ tự giải phóng tài nguyên\nDROP=102\nDROP=101\nDROP=202\nDROP=201\nDROP=300\nDROP=301\nDROP=302\nDROP=401\nDROP=402\nDROP_PARITY_SUM=1838\n

use std.core.host.heap_alloc
use std.core.host.heap_realloc
use std.core.host.heap_free

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapReAlloc(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_realloc(p: *mut u8, old_size: usize, new_size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if new_size < 16 { 16 } else { new_size };
    HeapReAlloc(h, 8u32, p, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn needs_drop<T>() -> bool { false }
@intrinsic unsafe fn drop_in_place<T>(p: *mut T) {}
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

struct DropGlue {}

pub struct Box<T> {
    pub ptr: *mut T,
    _glue: DropGlue,
}

impl<T> Drop for Box<T> {
    fn drop(self: mut_view<Box>) {
        if self.ptr as usize != 0 {
            let tag_v: i32 = (unsafe { *(self.ptr as *mut i64) }) as i32;
            print("DROP=");
            print_int(tag_v);
            print("\n");
            let sz = size_of<T>();
            let al = align_of<T>();
            unsafe {
                heap_free(self.ptr as *mut u8, sz, al);
            }
            self.ptr = 0 as *mut T;
        }
    }
}

pub fn box_new<T>(val: T) -> Box {
    let sz = size_of<T>();
    let al = align_of<T>();
    let raw = unsafe { heap_alloc(sz, al) };
    let p = raw as *mut T;
    unsafe {
        *p = val;
    }
    Box { ptr: p, _glue: DropGlue {} }
}

pub struct Vec<T> {
    pub ptr: *mut T,
    pub len: usize,
    pub cap: usize,
    _glue: DropGlue,
}

impl<T> Drop for Vec<T> {
    fn drop(self: mut_view<Vec>) {
        if self.ptr as usize != 0 {
            let mut i: usize = 0;
            while i < self.len {
                let elem_ptr: *mut i64 = unsafe { (self.ptr as *mut i64) + i };
                let tag_v: i32 = (unsafe { *elem_ptr }) as i32;
                print("DROP=");
                print_int(tag_v);
                print("\n");
                i = i + 1;
            }
            let sz = size_of<T>();
            let al = align_of<T>();
            unsafe {
                heap_free(self.ptr as *mut u8, self.cap * sz, al);
            }
            self.ptr = 0 as *mut T;
            self.len = 0;
            self.cap = 0;
        }
    }
}

pub fn vec_with_capacity<T>(capacity: usize) -> Vec {
    if capacity == 0 {
        return Vec { ptr: 0 as *mut T, len: 0, cap: 0, _glue: DropGlue {} };
    }
    let sz = size_of<T>();
    let al = align_of<T>();
    let raw = unsafe { heap_alloc(capacity * sz, al) };
    Vec { ptr: raw as *mut T, len: 0, cap: capacity, _glue: DropGlue {} }
}

pub fn vec_push<T>(v: mut_view<Vec>, val: T) {
    if v.len == v.cap {
        let needed = v.len + 1;
        let mut new_cap = if v.cap == 0 { 4 } else { v.cap * 2 };
        if new_cap < needed {
            new_cap = needed;
        }
        let sz = size_of<T>();
        let al = align_of<T>();
        let raw = unsafe { heap_alloc(new_cap * sz, al) };
        let new_ptr = raw as *mut T;
        if v.len > 0 && v.ptr as usize != 0 {
            unsafe {
                ptr_copy_nonoverlapping<u8>(v.ptr as *const u8, new_ptr as *mut u8, v.len * sz);
                heap_free(v.ptr as *mut u8, v.cap * sz, al);
            }
        }
        v.ptr = new_ptr;
        v.cap = new_cap;
    }
    unsafe {
        let p = v.ptr + v.len;
        *p = val;
    }
    v.len = v.len + 1;
}

struct DropTag {
    tag: i64,
}

impl Drop for DropTag {
    fn drop(self: mut_view<DropTag>) {
        print("DROP=");
        print_int(self.tag as i32);
        print("\n");
    }
}

fn nested_box_drop() -> i32 {
    let outer = DropTag { tag: 101i64 };
    let mut acc: i32 = 25;
    {
        let inner_b: Box<i64> = box_new<i64>(102i64);
        acc = acc + ((unsafe { *(inner_b.ptr) }) as i32) - 72;
    }
    let _keep: i32 = outer.tag as i32;
    acc
}

fn early_return_box_drop(take_early: bool) -> i32 {
    let first_b: Box<i64> = box_new<i64>(201i64);
    let second = DropTag { tag: 202i64 };
    if take_early {
        let v: i32 = ((unsafe { *(first_b.ptr) }) as i32) + (second.tag as i32) - 326;
        return v;
    }
    0
}

fn loop_iter_local_box_drop() -> i32 {
    let mut sum: i32 = 0;
    let mut k: i64 = 0i64;
    while k < 3i64 {
        let iter_b: Box<i64> = box_new<i64>(300i64 + k);
        sum = sum + ((unsafe { *(iter_b.ptr) }) as i32);
        k = k + 1i64;
    }
    sum
}

fn vec_drop_elements() -> i32 {
    let mut v: Vec<i64> = vec_with_capacity<i64>(2);
    vec_push<i64>(mut_view(v), 401i64);
    vec_push<i64>(mut_view(v), 402i64);
    (unsafe { *(v.ptr + 0) + *(v.ptr + 1) }) as i32
}

fn main() -> i32 {
    print("ESC_DROP_BANNER=Xin chào thứ tự giải phóng tài nguyên\n");
    let s1: i32 = nested_box_drop();
    let s2: i32 = early_return_box_drop(true);
    let s3: i32 = loop_iter_local_box_drop();
    let s4: i32 = vec_drop_elements();
    print("DROP_PARITY_SUM=");
    print_int(s1 + s2 + s3 + s4);
    print("\n");
    0
}
