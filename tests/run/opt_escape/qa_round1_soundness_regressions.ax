// test: run
// stdout: ESC_QA_R1_BANNER=Xin chào kiểm chứng an toàn thoát bộ nhớ vòng một\nF1_DEREF_ESCAPE=70\nF2_UNBALANCED_FREE=93\nF3_SLOT_IDENTITY=81\nF4_INTERPROC_OBS=83\nF5_CLOSURE_SOUNDNESS=85\nF6_PTR_INT_NON_NULL=80\nF7_PARAM_PROMOTIONS=100\nF8_NRVO_TERMINATOR_READS=148\nQA_R1_TOTAL=740\n

use std.core.host.heap_alloc
use std.core.host.heap_realloc
use std.core.host.heap_free

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapReAlloc(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_realloc(p: *mut u8, old_size: usize, new_size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if new_size < 16 { 16 } else { new_size };
    HeapReAlloc(h, 8u32, p, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn needs_drop<T>() -> bool { false }
@intrinsic unsafe fn drop_in_place<T>(p: *mut T) {}
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

pub struct Box<T> {
    pub ptr: *mut T,
}

impl<T> Drop for Box<T> {
    fn drop(self: mut_view<Box>) {
        if self.ptr as usize != 0 {
            if needs_drop<T>() {
                unsafe {
                    drop_in_place<T>(self.ptr);
                }
            }
            let sz = size_of<T>();
            let al = align_of<T>();
            unsafe {
                heap_free(self.ptr as *mut u8, sz, al);
            }
            self.ptr = 0 as *mut T;
        }
    }
}

pub fn box_new<T>(val: T) -> Box {
    let sz = size_of<T>();
    let al = align_of<T>();
    let raw = unsafe { heap_alloc(sz, al) };
    let p = raw as *mut T;
    unsafe {
        *p = val;
    }
    Box { ptr: p }
}

struct Pair {
    a: i32,
    b: i32,
}

fn unbox_inner_via_deref(x: i32) -> Box<i32> {
    let inner: Box<i32> = box_new<i32>(x);
    let sz = size_of<Box<i32>>();
    let al = align_of<Box<i32>>();
    let outer_raw = unsafe { heap_alloc(sz, al) };
    let outer_ptr = outer_raw as *mut Box<i32>;
    unsafe {
        *outer_ptr = inner;
    }
    let out_b: Box<i32> = unsafe { *outer_ptr };
    unsafe {
        heap_free(outer_raw, sz, al);
    }
    out_b
}

fn get_slot_ptr(slot: mut_view<*mut i32>) -> *mut i32 {
    *slot
}

fn alloc_raw_via_deref_view(x: i32) -> *mut i32 {
    let raw = unsafe { heap_alloc(size_of<i32>(), align_of<i32>()) };
    let mut p: *mut i32 = raw as *mut i32;
    unsafe {
        *p = x;
    }
    get_slot_ptr(mut_view(p))
}

fn test_f1_deref_indirection_escape() -> i32 {
    let b_inner: Box<i32> = unbox_inner_via_deref(41);
    let v1: i32 = unsafe { *(b_inner.ptr) };
    let rp: *mut i32 = alloc_raw_via_deref_view(29);
    let v2: i32 = unsafe { *rp };
    unsafe {
        heap_free(rp as *mut u8, size_of<i32>(), align_of<i32>());
    }
    v1 + v2
}

fn consume_box(b: Box<i32>) -> i32 {
    unsafe { *(b.ptr) + 5 }
}

fn branch_move_box(flag: bool, x: i32) -> i32 {
    let b: Box<i32> = box_new<i32>(x);
    if flag {
        let b2: Box<i32> = b;
        consume_box(b2)
    } else {
        unsafe { *(b.ptr) + 10 }
    }
}

fn unbalanced_local_raw(flag: bool) -> i32 {
    let raw = unsafe { heap_alloc(16, 8) };
    let p = raw as *mut i32;
    unsafe {
        *p = 19;
    }
    let v: i32 = unsafe { *p };
    if flag {
        unsafe {
            heap_free(raw, 16, 8);
        }
    }
    v
}

fn test_f2_branch_move_and_unbalanced_free() -> i32 {
    let r1: i32 = branch_move_box(true, 20);
    let r2: i32 = branch_move_box(false, 20);
    let r3: i32 = unbalanced_local_raw(true);
    let r4: i32 = unbalanced_local_raw(false);
    r1 + r2 + r3 + r4
}

fn test_f3_sequential_slot_identity_and_addr() -> i32 {
    let mut p1: *const Pair = 0 as *const Pair;
    let mut p2: *const Pair = 0 as *const Pair;
    let mut sum: i32 = 0;
    {
        let a = Pair { a: 12, b: 18 };
        p1 = unsafe { address_of<Pair>(a) };
        sum = sum + a.a + a.b;
    }
    {
        let b = Pair { a: 22, b: 28 };
        p2 = unsafe { address_of<Pair>(b) };
        sum = sum + b.a + b.b;
    }
    let non_null: i32 = if (p1 as usize) != 0usize && (p2 as usize) != 0usize { 1 } else { 0 };
    sum + non_null
}

fn callee_ptr_non_null_arith(p: *mut i32) -> i32 {
    let addr: usize = p as usize;
    if (addr ^ 1usize) != 0usize { 1 } else { 0 }
}

fn callee_ptrs_distinct(a: *mut i32, b: *mut i32) -> i32 {
    if a != b { 10 } else { 0 }
}

fn test_f4_interproc_ptr_obs_and_cmp() -> i32 {
    let b1: Box<i32> = box_new<i32>(31);
    let b2: Box<i32> = box_new<i32>(41);
    let c_obs: i32 = callee_ptr_non_null_arith(b1.ptr);
    let c_cmp: i32 = callee_ptrs_distinct(b1.ptr, b2.ptr);
    let c_same: i32 = callee_ptrs_distinct(b1.ptr, b1.ptr);
    let v_sum: i32 = unsafe { *(b1.ptr) + *(b2.ptr) };
    c_obs + c_cmp + c_same + v_sum
}

fn test_f5_closure_capture_lifetime_and_alias() -> i32 {
    let factor: i32 = 6;
    let c1 = |v: i32| -> i32 { v * factor + 3 };
    let c2 = c1;
    let r_alias: i32 = c2(7);
    let mut r_scoped: i32 = 0;
    {
        let k1: i32 = 10;
        let f1 = |v: i32| -> i32 { v + k1 };
        r_scoped = r_scoped + f1(5);
    }
    {
        let k2: i32 = 20;
        let f2 = |v: i32| -> i32 { v + k2 };
        r_scoped = r_scoped + f2(5);
    }
    r_alias + r_scoped
}

fn test_f6_ptr_to_int_index_and_switch() -> i32 {
    let b: Box<i32> = box_new<i32>(64);
    let raw_u: usize = b.ptr as usize;
    let ok: i32 = if raw_u != 0usize { 1 } else { 0 };
    let sw: i32 = match raw_u {
        0usize => 0,
        1usize => 999,
        _ => 10,
    };
    let mut arr: [4]i32 = [5, 6, 7, 8];
    let zidx: usize = raw_u - raw_u;
    arr[zidx] = arr[zidx] + unsafe { *(b.ptr) };
    arr[0] + ok + sw
}

fn param_box_sroa(x: i32, y: i32) -> i32 {
    let b: Box<i32> = box_new<i32>(x + y);
    unsafe { *(b.ptr) }
}

fn bump_pair_borrowed(p: mut_view<Pair>, delta: i32) -> i32 {
    p.a = p.a + delta;
    p.a + p.b
}

fn param_box_stack(x: i32, y: i32) -> i32 {
    let b: Box<Pair> = box_new<Pair>(Pair { a: x, b: y });
    let pv: mut_view<Pair> = unsafe { mut_view(*(b.ptr)) };
    bump_pair_borrowed(pv, 5)
}

fn param_closure_and_buf(x: i32, y: i32) -> i32 {
    let f = |v: i32| -> i32 { v + x };
    let raw = unsafe { heap_alloc(16, 4) };
    let ip = raw as *mut i32;
    let computed: i32 = f(y);
    unsafe {
        *ip = computed;
    }
    let out: i32 = unsafe { *ip };
    unsafe {
        heap_free(raw, 16, 4);
    }
    out
}

fn test_f7_param_promotions_and_verify() -> i32 {
    let s1: i32 = param_box_sroa(17, 23);
    let s2: i32 = param_box_stack(12, 18);
    let s3: i32 = param_closure_and_buf(9, 16);
    s1 + s2 + s3
}

fn make_pair_nrvo_switch(seed: i32) -> Pair {
    let b: Box<i32> = box_new<i32>(seed);
    let v: i32 = unsafe { *(b.ptr) };
    let mut out = Pair { a: v, b: 7 };
    match out.a {
        0 => {
            out.b = 99;
        },
        _ => {},
    }
    out
}

fn test_f8_nrvo_branch_switch_and_assert() -> i32 {
    let p_nz: Pair = make_pair_nrvo_switch(42);
    let p_z: Pair = make_pair_nrvo_switch(0);
    (p_nz.a + p_nz.b) + (p_z.a + p_z.b)
}

fn main() -> i32 {
    print("ESC_QA_R1_BANNER=Xin chào kiểm chứng an toàn thoát bộ nhớ vòng một\n");
    let f1: i32 = test_f1_deref_indirection_escape();
    let f2: i32 = test_f2_branch_move_and_unbalanced_free();
    let f3: i32 = test_f3_sequential_slot_identity_and_addr();
    let f4: i32 = test_f4_interproc_ptr_obs_and_cmp();
    let f5: i32 = test_f5_closure_capture_lifetime_and_alias();
    let f6: i32 = test_f6_ptr_to_int_index_and_switch();
    let f7: i32 = test_f7_param_promotions_and_verify();
    let f8: i32 = test_f8_nrvo_branch_switch_and_assert();

    print("F1_DEREF_ESCAPE=");
    print_int(f1);
    print("\nF2_UNBALANCED_FREE=");
    print_int(f2);
    print("\nF3_SLOT_IDENTITY=");
    print_int(f3);
    print("\nF4_INTERPROC_OBS=");
    print_int(f4);
    print("\nF5_CLOSURE_SOUNDNESS=");
    print_int(f5);
    print("\nF6_PTR_INT_NON_NULL=");
    print_int(f6);
    print("\nF7_PARAM_PROMOTIONS=");
    print_int(f7);
    print("\nF8_NRVO_TERMINATOR_READS=");
    print_int(f8);
    print("\nQA_R1_TOTAL=");
    print_int(f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8);
    print("\n");
    0
}
