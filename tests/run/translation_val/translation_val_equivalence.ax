// test: run
// modes: interp native
// exit: 0
// stdout: TVAL_SCALAR_POLARITY_AND_TRAPS=OK\nTVAL_CFG_MEMORY_AND_DROP=OK\nTVAL_REGALLOC_AND_SCHED_PRESSURE=OK\n

struct DropLog {
    order_hash: i64,
    drop_count: i64,
}

fn record_drop_event(log: mut_view<DropLog>, tag: i64) {
    log.order_hash = (log.order_hash * 131) + tag;
    log.drop_count = log.drop_count + 1;
}

fn check_scalar_polarity_and_checked_math(a: i64, b: i64, u_hi: u64, u_lo: u64) -> bool {
    // 1. Checked arithmetic & shift-in-range equivalence (AXS-PCT-021.1)
    let sum = a + b;
    let diff = a - b;
    let shl = (a << 3) >> 3;
    if sum != 42 || diff != 18 || shl != a {
        return false;
    }

    // 2. Signed vs unsigned comparison & division/shift polarity (REQ-CORE-3268)
    let signed_neg: i64 = -16;
    let signed_pos: i64 = 4;
    let signed_cmp = signed_neg < signed_pos;
    let signed_div = signed_neg / signed_pos;
    let signed_shr = signed_neg >> 2;

    let unsigned_cmp = u_hi > u_lo;
    let unsigned_div = u_hi / u_lo;
    let unsigned_shr = u_hi >> 2u64;

    if !signed_cmp || signed_div != -4 || signed_shr != -4 {
        return false;
    }
    if !unsigned_cmp || unsigned_div != 4u64 || unsigned_shr != 64u64 {
        return false;
    }
    true
}

fn check_cfg_memory_and_drop_order(flag: bool) -> bool {
    // 1. CFG diamond join with loop-invariant & dead-store sensitive updates (AXS-PCT-021.2..3)
    let mut acc: i64 = 0;
    let mut slot: i64 = 10;
    slot = 25; // overwritten store before any read (DSE candidate)
    let inv: i64 = 7;

    let mut i: i64 = 0;
    while i < 6 {
        let branch_val: i64 = if (i & 1) == 0 {
            slot + inv
        } else {
            slot - inv
        };
        acc = acc + branch_val;
        i = i + 1;
    }
    // 3 even iterations: (25 + 7) * 3 = 96; 3 odd iterations: (25 - 7) * 3 = 54; total = 150
    if acc != 150 {
        return false;
    }

    // 2. Unreachable branch folding must preserve observable Drop/resource sequence
    let mut dlog = DropLog { order_hash: 0, drop_count: 0 };
    if flag {
        record_drop_event(mut_view(dlog), 11);
        record_drop_event(mut_view(dlog), 22);
        record_drop_event(mut_view(dlog), 33);
    } else {
        record_drop_event(mut_view(dlog), 99);
    }
    if dlog.drop_count != 3 || dlog.order_hash != (((11 * 131) + 22) * 131 + 33) {
        return false;
    }
    true
}

fn check_regalloc_and_schedule_pressure(seed: i64) -> bool {
    // High live-range pressure across 10 simultaneous values, shifts (RCX), and division (RAX:RDX)
    // to exercise AXS-PCT-022 & AXS-PCT-023 invariants across -O0/-O1/-O2.
    let v0 = seed + 1;
    let v1 = seed + 2;
    let v2 = seed + 3;
    let v3 = seed + 4;
    let v4 = seed + 5;
    let v5 = seed + 6;
    let v6 = seed + 7;
    let v7 = seed + 8;
    let v8 = seed + 9;
    let v9 = seed + 10;

    let sh_amt = (v1 - seed) & 7; // 2 -> requires RCX in variable shift
    let shifted = (v7 << sh_amt) + (v8 >> 1);
    let div_q = (v9 * 12) / v2;   // (20 * 12) / 13 = 18 -> requires RAX:RDX in idiv
    let div_r = (v9 * 12) % v2;   // 240 % 13 = 6

    let total = v0 + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + shifted + div_q + div_r;
    total == 260
}

pub fn main() -> i32 {
    if !check_scalar_polarity_and_checked_math(30, 12, 256u64, 64u64) {
        print("FAIL: scalar polarity and traps\n");
        return 1;
    }
    print("TVAL_SCALAR_POLARITY_AND_TRAPS=OK\n");

    if !check_cfg_memory_and_drop_order(true) {
        print("FAIL: cfg memory and drop order\n");
        return 2;
    }
    print("TVAL_CFG_MEMORY_AND_DROP=OK\n");

    if !check_regalloc_and_schedule_pressure(10) {
        print("FAIL: regalloc and schedule pressure\n");
        return 3;
    }
    print("TVAL_REGALLOC_AND_SCHED_PRESSURE=OK\n");
    0
}
