@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }

unsafe fn probe_data_entry_at(base: *mut DiagDataEntry, idx: usize) -> *const DiagDataEntry {
    let off = ((idx as isize) * (size_of<DiagDataEntry>() as isize)) as usize;
    ((base as usize) + off) as *const DiagDataEntry
}

unsafe fn probe_interval_at(base: *mut LiveRangeAllocEntry, idx: usize) -> *mut LiveRangeAllocEntry {
    let off = ((idx as isize) * (size_of<LiveRangeAllocEntry>() as isize)) as usize;
    ((base as usize) + off) as *mut LiveRangeAllocEntry
}

unsafe fn probe_spill_at(base: *mut SpillSlotEntry, idx: usize) -> *mut SpillSlotEntry {
    let off = ((idx as isize) * (size_of<SpillSlotEntry>() as isize)) as usize;
    ((base as usize) + off) as *mut SpillSlotEntry
}

unsafe fn probe_sched_node_at(base: *mut ScheduleNodeEntry, idx: usize) -> *mut ScheduleNodeEntry {
    let off = ((idx as isize) * (size_of<ScheduleNodeEntry>() as isize)) as usize;
    ((base as usize) + off) as *mut ScheduleNodeEntry
}

unsafe fn probe_sched_edge_at(base: *mut ScheduleDepEdge, idx: usize) -> *mut ScheduleDepEdge {
    let off = ((idx as isize) * (size_of<ScheduleDepEdge>() as isize)) as usize;
    ((base as usize) + off) as *mut ScheduleDepEdge
}

fn build_sample_mir_body(arena: mut_view<Arena>, with_drop_stmt: bool) -> MirBody {
    let sp = Span { file: FileId { v: 1u32 }, start: 0u32, end: 10u32 };
    let body_p = mir_body_new(mut_view(*arena));
    let mut body = unsafe { *body_p };

    let _l0 = mir_add_local(mut_view(body), mut_view(*arena), TypeId { v: 4u32 }, MIR_LOCAL_RETURN, true, StrId { v: 0u32 }, view(sp));
    let _l1 = mir_add_local(mut_view(body), mut_view(*arena), TypeId { v: 4u32 }, MIR_LOCAL_ARG, false, StrId { v: 0u32 }, view(sp));
    let _l2 = mir_add_local(mut_view(body), mut_view(*arena), TypeId { v: 4u32 }, MIR_LOCAL_USER, true, StrId { v: 0u32 }, view(sp));

    let b0 = mir_add_bb(mut_view(body), mut_view(*arena), false);
    let b1 = mir_add_bb(mut_view(body), mut_view(*arena), false);

    let bb0_p = unsafe { mir_bb_at(body.bbs, b0.v as usize) };
    let st_scratch = arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt;
    unsafe {
        mir_stmt_zero(mut_view(*st_scratch), MIR_STMT_ASSIGN);
        mir_place_reset_u32(mut_view((*st_scratch).place), 0u32);
        (*st_scratch).rvalue.kind = MIR_RVALUE_USE;
        (*st_scratch).rvalue.use_op.kind = MIR_OP_CONST;
        (*st_scratch).rvalue.use_op.constant.kind = MIR_CONST_INT;
        (*st_scratch).rvalue.use_op.constant.val = 42u64;
        mir_bb_push_stmt(mut_view(*bb0_p), mut_view(*arena), view(*st_scratch));

        if with_drop_stmt {
            mir_stmt_zero(mut_view(*st_scratch), MIR_STMT_DROP);
            mir_place_reset_u32(mut_view((*st_scratch).place), 2u32);
            mir_bb_push_stmt(mut_view(*bb0_p), mut_view(*arena), view(*st_scratch));
        }

        mir_term_zero(mut_view((*bb0_p).terminator), MIR_TERM_GOTO);
        (*bb0_p).terminator.goto_target.v = b1.v;
        (*bb0_p).has_terminator = true;
    }

    let bb1_p = unsafe { mir_bb_at(body.bbs, b1.v as usize) };
    unsafe {
        mir_term_zero(mut_view((*bb1_p).terminator), MIR_TERM_RETURN);
        (*bb1_p).has_terminator = true;
    }
    body
}

// =================================================================================================
// Probe 1: 5-Tier Equivalence Hierarchy & Middle-End Scalar Rewrite Validation (AXS-PCT-020, 021.1)
// =================================================================================================
fn probe_equivalence_and_scalar() -> bool {
    // 1. Five-tier hierarchy roundtrip and lattice evaluation
    if eq_level_to_u8(eq_level_from_u8(EQ_LEVEL_0_STRUCTURAL)) != EQ_LEVEL_0_STRUCTURAL ||
       eq_level_to_u8(eq_level_from_u8(EQ_LEVEL_1_VALUE)) != EQ_LEVEL_1_VALUE ||
       eq_level_to_u8(eq_level_from_u8(EQ_LEVEL_2_MEMORY_RESOURCE)) != EQ_LEVEL_2_MEMORY_RESOURCE ||
       eq_level_to_u8(eq_level_from_u8(EQ_LEVEL_3_EFFECT_TRAP)) != EQ_LEVEL_3_EFFECT_TRAP ||
       eq_level_to_u8(eq_level_from_u8(EQ_LEVEL_4_OBSERVABLE_SEMANTIC)) != EQ_LEVEL_4_OBSERVABLE_SEMANTIC {
        return false;
    }
    let t4 = tval_evaluate_equivalence_tier(false, true, true, true, false);
    if t4 != EQ_LEVEL_4_OBSERVABLE_SEMANTIC || !tval_meets_mandatory_criterion(t4) {
        return false;
    }
    let t_fail_iso = tval_evaluate_equivalence_tier(false, true, true, true, true);
    let t2_only = tval_evaluate_equivalence_tier(false, true, true, false, false);
    let t1_only = tval_evaluate_equivalence_tier(false, true, false, true, false);
    let t0_only = tval_evaluate_equivalence_tier(true, false, false, false, false);
    if t_fail_iso != EQ_LEVEL_FAILED || t2_only != EQ_LEVEL_2_MEMORY_RESOURCE ||
       t1_only != EQ_LEVEL_1_VALUE || t0_only != EQ_LEVEL_0_STRUCTURAL ||
       tval_meets_mandatory_criterion(t2_only) {
        return false;
    }

    let mut arena = arena_new();
    let mut sink = diag_sink_new();
    let mut store = ProofStore {
        certs: 0 as *mut ProofCertificate,
        cert_count: 0,
        cert_cap: 0,
        audits: 0 as *mut AuditTrailEntry,
        audit_count: 0,
        audit_cap: 0,
        current_ir_revision: 1u32,
        current_snapshot_revision: 1u32,
        allow_trusted_boundaries: false,
        cache_hits: 0u32,
        cache_misses: 0u32,
        invalidation_events: 0u32,
    };
    proof_store_init(mut_view(store), mut_view(arena), 1u32, false);

    let mut eng = TranslationValEngine {
        validate_translations: true,
        witnesses: 0 as *mut TranslationWitness,
        witness_count: 0,
        witness_cap: 0,
        verified_count: 0u32,
        failed_count: 0u32,
        last_failure_kind: 0u8,
        last_failure_pass_id: 0u16,
        last_failure_subject: 0u32,
    };
    tval_engine_init(mut_view(eng), mut_view(arena), true);

    // Issue valid Proven certificates for signed overflow, non-zero divisor, shift-in-range, in-bounds
    let cert_nsw = proof_store_issue(
        mut_view(store),
        PROP_NO_SIGNED_OVERFLOW,
        CERTAINTY_PROVEN,
        10u32,
        0u32,
        1u32,
        FACT_ORIGIN_DATAFLOW_ENGINE,
        PCT_ANALYSIS_VALUE_RANGE,
        0u64,
        0u32,
        SymbolId { v: 1u32 }
    );
    let cert_nz = proof_store_issue(
        mut_view(store),
        PROP_NON_ZERO,
        CERTAINTY_PROVEN,
        11u32,
        0u32,
        1u32,
        FACT_ORIGIN_DATAFLOW_ENGINE,
        PCT_ANALYSIS_VALUE_RANGE,
        0u64,
        0u32,
        SymbolId { v: 1u32 }
    );
    let cert_sh = proof_store_issue(
        mut_view(store),
        PROP_SHIFT_IN_RANGE,
        CERTAINTY_PROVEN,
        12u32,
        0u32,
        1u32,
        FACT_ORIGIN_DATAFLOW_ENGINE,
        PCT_ANALYSIS_VALUE_RANGE,
        0u64,
        0u32,
        SymbolId { v: 1u32 }
    );
    let cert_ib = proof_store_issue(
        mut_view(store),
        PROP_IN_BOUNDS,
        CERTAINTY_PROVEN,
        13u32,
        0u32,
        1u32,
        FACT_ORIGIN_DATAFLOW_ENGINE,
        PCT_ANALYSIS_VALUE_RANGE,
        0u64,
        0u32,
        SymbolId { v: 1u32 }
    );

    // 2. Valid scalar rewrite eliminating overflow/div/shift/bounds checks with Proven certificates
    let ok_scalar = ScalarRewriteWitnessDesc {
        pass_id: PCT_PASS_OPT_INSTCOMBINE,
        fn_id: 1u32,
        inst_id: 100u32,
        pre_bit_width: 64u8,
        post_bit_width: 64u8,
        pre_is_signed: true,
        post_is_signed: true,
        is_comparison_or_div_or_shift: true,
        is_float: false,
        rewrote_fp_identity_or_reassoc: false,
        fp_nan_safe: true,
        fp_signed_zero_safe: true,
        pre_has_overflow_trap: true,
        post_has_overflow_trap: false,
        overflow_cert_id: cert_nsw,
        pre_has_div_zero_trap: true,
        post_has_div_zero_trap: false,
        non_zero_cert_id: cert_nz,
        pre_has_shift_trap: true,
        post_has_shift_trap: false,
        shift_cert_id: cert_sh,
        pre_has_bounds_trap: true,
        post_has_bounds_trap: false,
        bounds_cert_id: cert_ib,
        pre_sample_out_0: 42u64,
        post_sample_out_0: 42u64,
        pre_sample_out_1: 99u64,
        post_sample_out_1: 99u64,
    };
    let w_ok = tval_validate_scalar_rewrite(mut_view(eng), view(store), view(ok_scalar), mut_view(sink));
    if !w_ok.equivalence_verified || w_ok.failure_kind != TVAL_FAIL_NONE ||
       w_ok.consumed_proofs != 4u32 || w_ok.verified_level != EQ_LEVEL_4_OBSERVABLE_SEMANTIC ||
       sink.errors != 0 {
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return false;
    }

    // 3. Synthetic pass bug #1: Dropped overflow check WITHOUT a Proven certificate
    let mut bug_drop_ovf = ok_scalar;
    bug_drop_ovf.inst_id = 101u32;
    bug_drop_ovf.overflow_cert_id = PCT_PROOF_ID_INVALID;
    let w_ovf = tval_validate_scalar_rewrite(mut_view(eng), view(store), view(bug_drop_ovf), mut_view(sink));
    if w_ovf.equivalence_verified || w_ovf.failure_kind != TVAL_FAIL_DROPPED_OVERFLOW_TRAP ||
       sink.errors != 1 {
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return false;
    }
    // Verify structured diagnostic code AX_ICE_MIR_VERIFY and data.stage == "translation_val"
    let d0 = diag_sink_get(view(sink), 0);
    if d0.code.v != AX_ICE_MIR_VERIFY || d0.data_count != 3 {
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return false;
    }
    let e_stage = unsafe { probe_data_entry_at(d0.data, 0) };
    let e_detail = unsafe { probe_data_entry_at(d0.data, 2) };
    if (unsafe { (*e_stage).value.str_val.len }) != 15 ||
       (unsafe { (*e_detail).value.str_val.len }) != 21 {
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return false;
    }

    // 4. Rejections for dropped div-zero, dropped shift, dropped bounds, bitwidth/sign polarity, IEEE-754 NaN/-0.0, value mismatch
    let mut bug_div = ok_scalar;
    bug_div.non_zero_cert_id = PCT_PROOF_ID_INVALID;
    let w_div = tval_validate_scalar_rewrite(mut_view(eng), view(store), view(bug_div), mut_view(sink));

    let mut bug_sh = ok_scalar;
    bug_sh.shift_cert_id = PCT_PROOF_ID_INVALID;
    let w_sh = tval_validate_scalar_rewrite(mut_view(eng), view(store), view(bug_sh), mut_view(sink));

    let mut bug_bd = ok_scalar;
    bug_bd.bounds_cert_id = PCT_PROOF_ID_INVALID;
    let w_bd = tval_validate_scalar_rewrite(mut_view(eng), view(store), view(bug_bd), mut_view(sink));

    let mut bug_sign = ok_scalar;
    bug_sign.post_is_signed = false;
    bug_sign.overflow_cert_id = PCT_PROOF_ID_INVALID;
    let w_sign = tval_validate_scalar_rewrite(mut_view(eng), view(store), view(bug_sign), mut_view(sink));

    let mut bug_fp = ok_scalar;
    bug_fp.is_float = true;
    bug_fp.rewrote_fp_identity_or_reassoc = true;
    bug_fp.fp_nan_safe = false;
    let w_fp = tval_validate_scalar_rewrite(mut_view(eng), view(store), view(bug_fp), mut_view(sink));

    let mut bug_val = ok_scalar;
    bug_val.post_sample_out_1 = 777u64;
    let w_val = tval_validate_scalar_rewrite(mut_view(eng), view(store), view(bug_val), mut_view(sink));

    let all_rejected = !w_div.equivalence_verified && w_div.failure_kind == TVAL_FAIL_DROPPED_DIV_ZERO_TRAP &&
                       !w_sh.equivalence_verified && w_sh.failure_kind == TVAL_FAIL_DROPPED_SHIFT_TRAP &&
                       !w_bd.equivalence_verified && w_bd.failure_kind == TVAL_FAIL_DROPPED_BOUNDS_TRAP &&
                       !w_sign.equivalence_verified && w_sign.failure_kind == TVAL_FAIL_BITWIDTH_OR_SIGN_MISMATCH &&
                       !w_fp.equivalence_verified && w_fp.failure_kind == TVAL_FAIL_IEEE754_NAN_OR_SIGNED_ZERO &&
                       !w_val.equivalence_verified && w_val.failure_kind == TVAL_FAIL_SCALAR_VALUE_MISMATCH;

    diag_sink_free(mut_view(sink));
    arena_destroy(mut_view(arena));
    all_rejected
}

// =================================================================================================
// Probe 2: CFG Canonicalization, Memory/Loop Transforms & Target Legalization (AXS-PCT-021.2..3, 022.1)
// =================================================================================================
fn probe_cfg_memory_and_legalize() -> bool {
    let mut arena = arena_new();
    let mut sink = diag_sink_new();
    let mut store = ProofStore {
        certs: 0 as *mut ProofCertificate,
        cert_count: 0,
        cert_cap: 0,
        audits: 0 as *mut AuditTrailEntry,
        audit_count: 0,
        audit_cap: 0,
        current_ir_revision: 1u32,
        current_snapshot_revision: 1u32,
        allow_trusted_boundaries: false,
        cache_hits: 0u32,
        cache_misses: 0u32,
        invalidation_events: 0u32,
    };
    proof_store_init(mut_view(store), mut_view(arena), 1u32, false);

    let mut eng = TranslationValEngine {
        validate_translations: true,
        witnesses: 0 as *mut TranslationWitness,
        witness_count: 0,
        witness_cap: 0,
        verified_count: 0u32,
        failed_count: 0u32,
        last_failure_kind: 0u8,
        last_failure_pass_id: 0u16,
        last_failure_subject: 0u32,
    };
    tval_engine_init(mut_view(eng), mut_view(arena), true);

    // 1. CFG Transform Validation (AXS-PCT-021.2)
    let body_with_drop = build_sample_mir_body(mut_view(arena), true);
    let body_no_drop = build_sample_mir_body(mut_view(arena), false);

    let cfg_ok_desc = CfgTransformWitnessDesc {
        pass_id: PCT_PASS_OPT_CFG_SIMPLIFY,
        fn_id: 2u32,
        removed_edges_or_blocks: 1u32,
        branch_cond_certainty: CERTAINTY_PROVEN,
        join_pred_count: 2u32,
        phi_input_count: 2u32,
        memory_phi_complete: true,
        dom_tree_valid: true,
    };
    let w_cfg_ok = tval_validate_cfg_transform(
        mut_view(eng),
        view(body_with_drop),
        view(body_with_drop),
        view(cfg_ok_desc),
        mut_view(sink)
    );
    if !w_cfg_ok.equivalence_verified || w_cfg_ok.consumed_proofs != 1u32 {
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return false;
    }

    // Reject unproven unreachable edge removal (Certainty.Possible)
    let mut cfg_unproven = cfg_ok_desc;
    cfg_unproven.branch_cond_certainty = CERTAINTY_POSSIBLE;
    let w_cfg_unp = tval_validate_cfg_transform(
        mut_view(eng),
        view(body_with_drop),
        view(body_with_drop),
        view(cfg_unproven),
        mut_view(sink)
    );

    // Reject incomplete phi / dominance after CFG edge removal
    let mut cfg_bad_phi = cfg_ok_desc;
    cfg_bad_phi.phi_input_count = 1u32;
    let w_cfg_phi = tval_validate_cfg_transform(
        mut_view(eng),
        view(body_with_drop),
        view(body_with_drop),
        view(cfg_bad_phi),
        mut_view(sink)
    );

    // Reject CFG transform that silently dropped an observable Drop statement
    let w_cfg_drop = tval_validate_cfg_transform(
        mut_view(eng),
        view(body_with_drop),
        view(body_no_drop),
        view(cfg_ok_desc),
        mut_view(sink)
    );

    if w_cfg_unp.equivalence_verified || w_cfg_unp.failure_kind != TVAL_FAIL_UNPROVEN_UNREACHABLE_EDGE ||
       w_cfg_phi.equivalence_verified || w_cfg_phi.failure_kind != TVAL_FAIL_INCOMPLETE_PHI_OR_DOM ||
       w_cfg_drop.equivalence_verified || w_cfg_drop.failure_kind != TVAL_FAIL_DROP_OR_CAP_BARRIER_VIOLATED {
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return false;
    }

    // 2. Memory & Loop Transform Validation (AXS-PCT-021.3)
    let cert_dead = proof_store_issue(
        mut_view(store),
        PROP_DEAD_STORE,
        CERTAINTY_PROVEN,
        20u32,
        0u32,
        1u32,
        FACT_ORIGIN_DATAFLOW_ENGINE,
        PCT_ANALYSIS_SSA_DEF_USE,
        0u64,
        0u32,
        SymbolId { v: 2u32 }
    );
    let cert_noalias = proof_store_issue(
        mut_view(store),
        PROP_NO_ALIAS,
        CERTAINTY_PROVEN,
        20u32,
        21u32,
        1u32,
        FACT_ORIGIN_DATAFLOW_ENGINE,
        PCT_ANALYSIS_SSA_DEF_USE,
        0u64,
        0u32,
        SymbolId { v: 2u32 }
    );
    let cert_must = proof_store_issue(
        mut_view(store),
        PROP_MUST_ALIAS,
        CERTAINTY_PROVEN,
        22u32,
        23u32,
        1u32,
        FACT_ORIGIN_DATAFLOW_ENGINE,
        PCT_ANALYSIS_SSA_DEF_USE,
        0u64,
        0u32,
        SymbolId { v: 2u32 }
    );
    let cert_noesc = proof_store_issue(
        mut_view(store),
        PROP_NO_ESCAPE,
        CERTAINTY_PROVEN,
        24u32,
        0u32,
        1u32,
        FACT_ORIGIN_DATAFLOW_ENGINE,
        PCT_ANALYSIS_SSA_DEF_USE,
        0u64,
        0u32,
        SymbolId { v: 2u32 }
    );
    let cert_licm = proof_store_issue(
        mut_view(store),
        PROP_LOOP_INVARIANT,
        CERTAINTY_PROVEN,
        25u32,
        1u32,
        1u32,
        FACT_ORIGIN_DATAFLOW_ENGINE,
        PCT_ANALYSIS_SSA_DEF_USE,
        0u64,
        0u32,
        SymbolId { v: 2u32 }
    );
    let cert_bce = proof_store_issue(
        mut_view(store),
        PROP_IN_BOUNDS,
        CERTAINTY_PROVEN,
        26u32,
        0u32,
        1u32,
        FACT_ORIGIN_SYMBOLIC_ENGINE,
        PCT_ANALYSIS_VALUE_RANGE,
        0u64,
        0u32,
        SymbolId { v: 2u32 }
    );

    let dse_ok = MemoryLoopTransformWitnessDesc {
        pass_id: PCT_PASS_OPT_DSE,
        fn_id: 2u32,
        xform_kind: TVAL_MEM_XFORM_DSE,
        subject_inst: 20u32,
        primary_cert_id: cert_dead,
        secondary_cert_id: cert_noalias,
        touches_volatile_or_mmio: false,
        touches_atomic_sync: false,
        alters_drop_order: false,
        violates_capability_exclusivity: false,
        hoisted_op_may_trap_on_empty_loop: false,
    };
    let mut ldfwd_ok = dse_ok;
    ldfwd_ok.xform_kind = TVAL_MEM_XFORM_LOAD_FWD;
    ldfwd_ok.primary_cert_id = cert_must;

    let mut sroa_ok = dse_ok;
    sroa_ok.pass_id = PCT_PASS_OPT_SROA;
    sroa_ok.xform_kind = TVAL_MEM_XFORM_SROA;
    sroa_ok.primary_cert_id = cert_noesc;

    let mut licm_ok = dse_ok;
    licm_ok.pass_id = PCT_PASS_OPT_LICM;
    licm_ok.xform_kind = TVAL_MEM_XFORM_LICM;
    licm_ok.primary_cert_id = cert_licm;

    let mut bce_ok = dse_ok;
    bce_ok.pass_id = PCT_PASS_OPT_BCE;
    bce_ok.xform_kind = TVAL_MEM_XFORM_BCE;
    bce_ok.primary_cert_id = cert_bce;

    let w_dse = tval_validate_memory_loop_transform(mut_view(eng), view(store), view(dse_ok), mut_view(sink));
    let w_fwd = tval_validate_memory_loop_transform(mut_view(eng), view(store), view(ldfwd_ok), mut_view(sink));
    let w_sroa = tval_validate_memory_loop_transform(mut_view(eng), view(store), view(sroa_ok), mut_view(sink));
    let w_licm = tval_validate_memory_loop_transform(mut_view(eng), view(store), view(licm_ok), mut_view(sink));
    let w_bce = tval_validate_memory_loop_transform(mut_view(eng), view(store), view(bce_ok), mut_view(sink));

    if !w_dse.equivalence_verified || !w_fwd.equivalence_verified || !w_sroa.equivalence_verified ||
       !w_licm.equivalence_verified || !w_bce.equivalence_verified {
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return false;
    }

    // Rejections for volatile DSE, Drop order violation, missing NoAlias proof, and LICM hoisting trapping op
    let mut dse_vol = dse_ok;
    dse_vol.touches_volatile_or_mmio = true;
    let w_dse_vol = tval_validate_memory_loop_transform(mut_view(eng), view(store), view(dse_vol), mut_view(sink));

    let mut dse_drop = dse_ok;
    dse_drop.alters_drop_order = true;
    let w_dse_drop = tval_validate_memory_loop_transform(mut_view(eng), view(store), view(dse_drop), mut_view(sink));

    let mut sroa_no_proof = sroa_ok;
    sroa_no_proof.secondary_cert_id = PCT_PROOF_ID_INVALID;
    let w_sroa_bad = tval_validate_memory_loop_transform(mut_view(eng), view(store), view(sroa_no_proof), mut_view(sink));

    let mut licm_trap = licm_ok;
    licm_trap.hoisted_op_may_trap_on_empty_loop = true;
    let w_licm_trap = tval_validate_memory_loop_transform(mut_view(eng), view(store), view(licm_trap), mut_view(sink));

    if w_dse_vol.equivalence_verified || w_dse_vol.failure_kind != TVAL_FAIL_VOLATILE_OR_ATOMIC_ELIMINATED ||
       w_dse_drop.equivalence_verified || w_dse_drop.failure_kind != TVAL_FAIL_DROP_OR_CAP_BARRIER_VIOLATED ||
       w_sroa_bad.equivalence_verified || w_sroa_bad.failure_kind != TVAL_FAIL_MISSING_MEMORY_ALIAS_PROOF ||
       w_licm_trap.equivalence_verified || w_licm_trap.failure_kind != TVAL_FAIL_DROPPED_DIV_ZERO_TRAP {
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return false;
    }

    // 3. Target Legalization Validation (AXS-PCT-022.1)
    let leg_i128_ok = TargetLegalizationWitnessDesc {
        pass_id: PCT_PASS_LIR_LOWER,
        fn_id: 2u32,
        legalize_kind: TVAL_LEGALIZE_I128_PAIR_SPLIT,
        inst_id: 300u32,
        pre_total_bits: 128u16,
        post_lane_bits: 64u16,
        post_lane_count: 2u16,
        extension_matches_signedness: true,
        preserves_carry_borrow_chain: true,
        preserves_lane_order: true,
        preserves_trap_semantics: true,
    };
    let mut leg_narrow_ok = leg_i128_ok;
    leg_narrow_ok.legalize_kind = TVAL_LEGALIZE_NARROW_INT_PROMOTE;
    leg_narrow_ok.pre_total_bits = 64u16;
    leg_narrow_ok.post_lane_bits = 64u16;
    leg_narrow_ok.post_lane_count = 1u16;

    let mut leg_simd_ok = leg_i128_ok;
    leg_simd_ok.legalize_kind = TVAL_LEGALIZE_SIMD_VECTOR_SPLIT;
    leg_simd_ok.pre_total_bits = 256u16;
    leg_simd_ok.post_lane_bits = 128u16;
    leg_simd_ok.post_lane_count = 2u16;

    let w_leg1 = tval_validate_target_legalization(mut_view(eng), view(leg_i128_ok), mut_view(sink));
    let w_leg2 = tval_validate_target_legalization(mut_view(eng), view(leg_narrow_ok), mut_view(sink));
    let w_leg3 = tval_validate_target_legalization(mut_view(eng), view(leg_simd_ok), mut_view(sink));

    let mut leg_bad_carry = leg_i128_ok;
    leg_bad_carry.preserves_carry_borrow_chain = false;
    let w_leg_bad = tval_validate_target_legalization(mut_view(eng), view(leg_bad_carry), mut_view(sink));

    let ok = w_leg1.equivalence_verified && w_leg2.equivalence_verified && w_leg3.equivalence_verified &&
             !w_leg_bad.equivalence_verified && w_leg_bad.failure_kind == TVAL_FAIL_LEGALIZATION_MISMATCH;

    diag_sink_free(mut_view(sink));
    arena_destroy(mut_view(arena));
    ok
}

// =================================================================================================
// Probe 3: Register Allocation & Spill/Reload Witness Validation (AXS-PCT-022.2)
// =================================================================================================
fn probe_regalloc_and_spills() -> bool {
    // 1. Sub-register physical unit mapping (RAX/EAX/AX/AL/AH -> unit 0; XMM0/YMM0 -> unit 16)
    if tval_phys_reg_unit(REG_ENC_RAX) != PHYS_UNIT_RAX ||
       tval_phys_reg_unit(REG_ENC_EAX) != PHYS_UNIT_RAX ||
       tval_phys_reg_unit(REG_ENC_AX) != PHYS_UNIT_RAX ||
       tval_phys_reg_unit(REG_ENC_AL) != PHYS_UNIT_RAX ||
       tval_phys_reg_unit(REG_ENC_AH) != PHYS_UNIT_RAX ||
       tval_phys_reg_unit(REG_ENC_XMM0) != PHYS_UNIT_XMM0 ||
       tval_phys_reg_unit(REG_ENC_YMM0) != PHYS_UNIT_XMM0 {
        return false;
    }

    let mut arena = arena_new();
    let mut sink = diag_sink_new();
    let mut eng = TranslationValEngine {
        validate_translations: true,
        witnesses: 0 as *mut TranslationWitness,
        witness_count: 0,
        witness_cap: 0,
        verified_count: 0u32,
        failed_count: 0u32,
        last_failure_kind: 0u8,
        last_failure_pass_id: 0u16,
        last_failure_subject: 0u32,
    };
    tval_engine_init(mut_view(eng), mut_view(arena), true);

    let ivs = arena_alloc_raw(
        mut_view(arena),
        mir_mul_usize(3, size_of<LiveRangeAllocEntry>()),
        align_of<LiveRangeAllocEntry>()
    ) as *mut LiveRangeAllocEntry;
    let sps = arena_alloc_raw(
        mut_view(arena),
        mir_mul_usize(1, size_of<SpillSlotEntry>()),
        align_of<SpillSlotEntry>()
    ) as *mut SpillSlotEntry;

    // Valid RA witness:
    //   - vreg 1 in RAX [0..10), vreg 2 move-coalesced in EAX [5..15) with identical provenance 77
    //   - vreg 3 spilled to slot 0 with dominating store at 2 before reload at 8
    unsafe {
        *probe_interval_at(ivs, 0) = LiveRangeAllocEntry {
            vreg_id: 1u32,
            start_point: 0u32,
            end_point: 10u32,
            phys_reg_enc: REG_ENC_RAX,
            is_spilled: false,
            spill_slot_id: 0u32,
            value_provenance: 77u32,
            is_move_coalesced: true,
            crosses_call: false,
            saved_across_call: false,
        };
        *probe_interval_at(ivs, 1) = LiveRangeAllocEntry {
            vreg_id: 2u32,
            start_point: 5u32,
            end_point: 15u32,
            phys_reg_enc: REG_ENC_EAX,
            is_spilled: false,
            spill_slot_id: 0u32,
            value_provenance: 77u32,
            is_move_coalesced: true,
            crosses_call: false,
            saved_across_call: false,
        };
        *probe_interval_at(ivs, 2) = LiveRangeAllocEntry {
            vreg_id: 3u32,
            start_point: 2u32,
            end_point: 12u32,
            phys_reg_enc: REG_ENC_RBX,
            is_spilled: true,
            spill_slot_id: 0u32,
            value_provenance: 88u32,
            is_move_coalesced: false,
            crosses_call: true,
            saved_across_call: true,
        };
        *probe_spill_at(sps, 0) = SpillSlotEntry {
            slot_id: 0u32,
            vreg_id: 3u32,
            spill_store_point: 2u32,
            reload_use_point: 8u32,
            store_dominates_reload: true,
            aliases_user_local: false,
            aliases_volatile_or_mmio: false,
        };
    }

    let ra_ok = RegAllocWitnessDesc {
        pass_id: PCT_PASS_X64_REGALLOC,
        fn_id: 3u32,
        remaining_vregs: 0u32,
        intervals: ivs as *const LiveRangeAllocEntry,
        interval_count: 3,
        spills: sps as *const SpillSlotEntry,
        spill_count: 1,
        var_shift_uses_rcx: true,
        div_mul_uses_rax_rdx: true,
        callee_saved_modified_mask: 0x08u32,
        callee_saved_saved_restored_mask: 0x08u32,
    };
    let w_ra_ok = tval_validate_regalloc_witness(mut_view(eng), view(ra_ok), mut_view(sink));
    if !w_ra_ok.equivalence_verified || sink.errors != 0 {
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return false;
    }

    // 2. Synthetic pass bug #2: Clobbered live register (overlapping RAX and EAX with distinct provenance)
    unsafe {
        (*probe_interval_at(ivs, 1)).value_provenance = 999u32;
        (*probe_interval_at(ivs, 1)).is_move_coalesced = false;
    }
    let w_clobber = tval_validate_regalloc_witness(mut_view(eng), view(ra_ok), mut_view(sink));
    if w_clobber.equivalence_verified || w_clobber.failure_kind != TVAL_FAIL_CLOBBERED_LIVE_REGISTER ||
       w_clobber.failure_subject != 2u32 || sink.errors != 1 {
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return false;
    }
    // Verify backend failure emits AX_ICE_INTERNAL with data.detail == "clobbered_live_register" (len 23)
    let d_ra = diag_sink_get(view(sink), 0);
    let e_ra_detail = unsafe { probe_data_entry_at(d_ra.data, 2) };
    if d_ra.code.v != AX_ICE_INTERNAL ||
       (unsafe { (*e_ra_detail).value.str_val.len }) != 23 {
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return false;
    }

    // Restore valid provenance and test remaining RA failure modes:
    unsafe {
        (*probe_interval_at(ivs, 1)).value_provenance = 77u32;
        (*probe_interval_at(ivs, 1)).is_move_coalesced = true;
    }

    let mut ra_vreg = ra_ok;
    ra_vreg.remaining_vregs = 2u32;
    let w_vreg = tval_validate_regalloc_witness(mut_view(eng), view(ra_vreg), mut_view(sink));

    unsafe { (*probe_spill_at(sps, 0)).aliases_volatile_or_mmio = true; }
    let w_bad_spill = tval_validate_regalloc_witness(mut_view(eng), view(ra_ok), mut_view(sink));
    unsafe { (*probe_spill_at(sps, 0)).aliases_volatile_or_mmio = false; }

    unsafe {
        (*probe_interval_at(ivs, 0)).crosses_call = true;
        (*probe_interval_at(ivs, 0)).saved_across_call = false;
    }
    let w_call_clobber = tval_validate_regalloc_witness(mut_view(eng), view(ra_ok), mut_view(sink));
    unsafe { (*probe_interval_at(ivs, 0)).crosses_call = false; }

    let mut ra_bad_callee = ra_ok;
    ra_bad_callee.callee_saved_saved_restored_mask = 0u32;
    let w_bad_callee = tval_validate_regalloc_witness(mut_view(eng), view(ra_bad_callee), mut_view(sink));

    // Edge case: XMM0 and YMM0 sub-register aliasing on overlapping live intervals
    unsafe {
        (*probe_interval_at(ivs, 0)).phys_reg_enc = REG_ENC_XMM0;
        (*probe_interval_at(ivs, 0)).is_move_coalesced = false;
        (*probe_interval_at(ivs, 0)).value_provenance = 501u32;
        (*probe_interval_at(ivs, 1)).phys_reg_enc = REG_ENC_YMM0;
        (*probe_interval_at(ivs, 1)).is_move_coalesced = false;
        (*probe_interval_at(ivs, 1)).value_provenance = 502u32;
    }
    let w_xmm_ymm = tval_validate_regalloc_witness(mut_view(eng), view(ra_ok), mut_view(sink));

    // Edge case: Two simultaneously live spilled intervals sharing the same spill_slot_id
    unsafe {
        (*probe_interval_at(ivs, 0)).is_spilled = true;
        (*probe_interval_at(ivs, 0)).spill_slot_id = 0u32;
    }
    let w_spill_clash = tval_validate_regalloc_witness(mut_view(eng), view(ra_ok), mut_view(sink));

    let all_ok = !w_vreg.equivalence_verified && w_vreg.failure_kind == TVAL_FAIL_UNRESOLVED_VREG &&
                 !w_bad_spill.equivalence_verified && w_bad_spill.failure_kind == TVAL_FAIL_INVALID_SPILL_RELOAD &&
                 !w_call_clobber.equivalence_verified && w_call_clobber.failure_kind == TVAL_FAIL_ISA_FIXED_REG_OR_ABI_CLOBBER &&
                 !w_bad_callee.equivalence_verified && w_bad_callee.failure_kind == TVAL_FAIL_ISA_FIXED_REG_OR_ABI_CLOBBER &&
                 !w_xmm_ymm.equivalence_verified && w_xmm_ymm.failure_kind == TVAL_FAIL_CLOBBERED_LIVE_REGISTER &&
                 !w_spill_clash.equivalence_verified && w_spill_clash.failure_kind == TVAL_FAIL_INVALID_SPILL_RELOAD;

    diag_sink_free(mut_view(sink));
    arena_destroy(mut_view(arena));
    all_ok
}

// =================================================================================================
// Probe 4: Instruction Scheduling, Machine Finalization Gate & Witness Report (AXS-PCT-023, 024, 050)
// =================================================================================================
fn probe_schedule_finalize_and_witness() -> bool {
    let mut arena = arena_new();
    let mut sink = diag_sink_new();
    let mut store = ProofStore {
        certs: 0 as *mut ProofCertificate,
        cert_count: 0,
        cert_cap: 0,
        audits: 0 as *mut AuditTrailEntry,
        audit_count: 0,
        audit_cap: 0,
        current_ir_revision: 1u32,
        current_snapshot_revision: 1u32,
        allow_trusted_boundaries: false,
        cache_hits: 0u32,
        cache_misses: 0u32,
        invalidation_events: 0u32,
    };
    proof_store_init(mut_view(store), mut_view(arena), 1u32, false);

    let mut pct_eng = PassContractEngine {
        current_level: IR_LEVEL_OPT_IR,
        ir_revision: 1u32,
        valid_analyses: 0u32,
        analysis_digests: 0 as *mut u64,
        active_properties: SEM_PROP_MANDATORY_INTRA_LEVEL,
        verify_pass_contracts: true,
        verify_each: true,
        observable_effect_count: 0u32,
        baseline_observable_effects: 0u32,
        pass_run_count: 0u32,
        pass_commit_count: 0u32,
        pass_rollback_count: 0u32,
        verify_trap_count: 0u32,
        last_trap_kind: 0u8,
        last_trap_pass_id: 0u16,
    };
    pct_engine_init(mut_view(pct_eng), mut_view(arena), IR_LEVEL_OPT_IR, true);

    let mut eng = TranslationValEngine {
        validate_translations: true,
        witnesses: 0 as *mut TranslationWitness,
        witness_count: 0,
        witness_cap: 0,
        verified_count: 0u32,
        failed_count: 0u32,
        last_failure_kind: 0u8,
        last_failure_pass_id: 0u16,
        last_failure_subject: 0u32,
    };
    tval_engine_init(mut_view(eng), mut_view(arena), true);

    let cert_noalias = proof_store_issue(
        mut_view(store),
        PROP_NO_ALIAS,
        CERTAINTY_PROVEN,
        50u32,
        51u32,
        1u32,
        FACT_ORIGIN_DATAFLOW_ENGINE,
        PCT_ANALYSIS_CFG,
        0u64,
        0u32,
        SymbolId { v: 4u32 }
    );

    let nodes = arena_alloc_raw(
        mut_view(arena),
        mir_mul_usize(3, size_of<ScheduleNodeEntry>()),
        align_of<ScheduleNodeEntry>()
    ) as *mut ScheduleNodeEntry;
    let edges = arena_alloc_raw(
        mut_view(arena),
        mir_mul_usize(1, size_of<ScheduleDepEdge>()),
        align_of<ScheduleDepEdge>()
    ) as *mut ScheduleDepEdge;

    // 1. Valid schedule witness:
    //   - Node 0 (volatile load, pre=0, sched=0) -> Node 1 (store, pre=1, sched=1) -> Node 2 (ALU use, pre=2, sched=2)
    unsafe {
        *probe_sched_node_at(nodes, 0) = ScheduleNodeEntry {
            inst_id: 500u32,
            pre_order_idx: 0u32,
            scheduled_order_idx: 0u32,
            is_memory_load: true,
            is_memory_store: false,
            is_volatile_or_mmio: true,
            is_atomic: false,
            is_fence: false,
            is_call: false,
            is_may_trap: false,
            alias_group: 1u32,
        };
        *probe_sched_node_at(nodes, 1) = ScheduleNodeEntry {
            inst_id: 501u32,
            pre_order_idx: 1u32,
            scheduled_order_idx: 1u32,
            is_memory_load: false,
            is_memory_store: true,
            is_volatile_or_mmio: false,
            is_atomic: false,
            is_fence: false,
            is_call: false,
            is_may_trap: false,
            alias_group: 1u32,
        };
        *probe_sched_node_at(nodes, 2) = ScheduleNodeEntry {
            inst_id: 502u32,
            pre_order_idx: 2u32,
            scheduled_order_idx: 2u32,
            is_memory_load: false,
            is_memory_store: false,
            is_volatile_or_mmio: false,
            is_atomic: false,
            is_fence: false,
            is_call: false,
            is_may_trap: false,
            alias_group: 0u32,
        };
        *probe_sched_edge_at(edges, 0) = ScheduleDepEdge {
            pred_node_idx: 0u32,
            succ_node_idx: 2u32,
            dep_kind: SCHED_DEP_RAW,
            resource_kind: SCHED_RES_GPR,
        };
    }

    let sched_ok = ScheduleWitnessDesc {
        pass_id: PCT_PASS_X64_FINALIZE,
        fn_id: 4u32,
        nodes: nodes as *const ScheduleNodeEntry,
        node_count: 3,
        edges: edges as *const ScheduleDepEdge,
        edge_count: 1,
        no_alias_cert_id: cert_noalias,
        has_unknown_latency_model: false,
    };
    let w_sched_ok = tval_validate_schedule_witness(mut_view(eng), view(store), view(sched_ok), mut_view(sink));
    if !w_sched_ok.equivalence_verified || sink.errors != 0 {
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return false;
    }

    // 2. Synthetic pass bug #3: Reordered volatile load across memory store barrier
    unsafe {
        (*probe_sched_node_at(nodes, 0)).scheduled_order_idx = 1u32;
        (*probe_sched_node_at(nodes, 1)).scheduled_order_idx = 0u32;
    }
    let w_vol_reord = tval_validate_schedule_witness(mut_view(eng), view(store), view(sched_ok), mut_view(sink));
    if w_vol_reord.equivalence_verified || w_vol_reord.failure_kind != TVAL_FAIL_VOLATILE_BARRIER_REORDERED ||
       sink.errors != 1 {
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return false;
    }
    let d_sch = diag_sink_get(view(sink), 0);
    let e_sch_detail = unsafe { probe_data_entry_at(d_sch.data, 2) };
    if d_sch.code.v != AX_ICE_INTERNAL ||
       (unsafe { (*e_sch_detail).value.str_val.len }) != 26 {
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return false;
    }

    // Test EFLAGS hazard, atomic barrier reorder, trap/call barrier reorder, and aliasing store/load reorder without NoAlias proof
    unsafe {
        (*probe_sched_node_at(nodes, 0)).is_volatile_or_mmio = false;
        (*probe_sched_node_at(nodes, 0)).is_atomic = true;
    }
    let w_atm_reord = tval_validate_schedule_witness(mut_view(eng), view(store), view(sched_ok), mut_view(sink));

    unsafe {
        (*probe_sched_node_at(nodes, 0)).is_atomic = false;
        (*probe_sched_node_at(nodes, 0)).is_may_trap = true;
    }
    let w_trp_reord = tval_validate_schedule_witness(mut_view(eng), view(store), view(sched_ok), mut_view(sink));

    unsafe {
        (*probe_sched_node_at(nodes, 0)).is_may_trap = false;
    }
    let mut sched_no_proof = sched_ok;
    sched_no_proof.no_alias_cert_id = PCT_PROOF_ID_INVALID;
    let w_alias_reord = tval_validate_schedule_witness(mut_view(eng), view(store), view(sched_no_proof), mut_view(sink));

    unsafe {
        (*probe_sched_node_at(nodes, 0)).scheduled_order_idx = 2u32;
        (*probe_sched_node_at(nodes, 1)).scheduled_order_idx = 1u32;
        (*probe_sched_node_at(nodes, 2)).scheduled_order_idx = 0u32;
        (*probe_sched_edge_at(edges, 0)).resource_kind = SCHED_RES_EFLAGS;
    }
    let w_eflags = tval_validate_schedule_witness(mut_view(eng), view(store), view(sched_ok), mut_view(sink));

    // Edge case: Unknown latency model with non-conservative reordered schedule
    let mut sched_unk_lat = sched_ok;
    sched_unk_lat.has_unknown_latency_model = true;
    let w_unk_lat = tval_validate_schedule_witness(mut_view(eng), view(store), view(sched_unk_lat), mut_view(sink));

    if w_atm_reord.equivalence_verified || w_atm_reord.failure_kind != TVAL_FAIL_ATOMIC_BARRIER_REORDERED ||
       w_trp_reord.equivalence_verified || w_trp_reord.failure_kind != TVAL_FAIL_TRAP_OR_CALL_BARRIER_REORDERED ||
       w_alias_reord.equivalence_verified || w_alias_reord.failure_kind != TVAL_FAIL_ALIASING_MEMORY_REORDERED ||
       w_eflags.equivalence_verified || w_eflags.failure_kind != TVAL_FAIL_EFLAGS_HAZARD ||
       w_unk_lat.equivalence_verified || w_unk_lat.failure_kind != TVAL_FAIL_SCHEDULE_DATA_HAZARD {
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return false;
    }

    // 3. Machine Code Finalization Gate (AXS-PCT-024)
    let fin_ok = FinalMachineGateDesc {
        pass_id: PCT_PASS_X64_FINALIZE,
        fn_id: 4u32,
        completed_stages_mask: FINAL_STAGE_COMPLETE_MASK,
        remaining_vregs: 0u32,
        unresolved_abstract_slots: 0u32,
        frame_size_bytes: 4104u32,
        pushed_callee_bytes: 16u32,
        has_calls: true,
        has_chkstk_probe: true,
        secret_slot_count: 1u32,
        secret_zeroize_barriers_intact: true,
        pdata_xdata_matches_frame: true,
        callee_saved_pushed_mask: 0x18u32,
        callee_saved_popped_mask: 0x18u32,
    };
    let w_fin_ok = tval_validate_machine_finalization_gate(mut_view(eng), view(fin_ok), mut_view(sink));
    if !w_fin_ok.equivalence_verified {
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return false;
    }

    let mut fin_stage = fin_ok;
    fin_stage.completed_stages_mask = 0x1Fu8;
    let w_fin_stage = tval_validate_machine_finalization_gate(mut_view(eng), view(fin_stage), mut_view(sink));

    let mut fin_align = fin_ok;
    fin_align.frame_size_bytes = 4096u32; // (8 + 16 + 4096) = 4120 (not 16-byte aligned!)
    let w_fin_align = tval_validate_machine_finalization_gate(mut_view(eng), view(fin_align), mut_view(sink));

    let mut fin_chkstk = fin_ok;
    fin_chkstk.has_chkstk_probe = false;
    let w_fin_chkstk = tval_validate_machine_finalization_gate(mut_view(eng), view(fin_chkstk), mut_view(sink));

    let mut fin_secret = fin_ok;
    fin_secret.secret_zeroize_barriers_intact = false;
    let w_fin_secret = tval_validate_machine_finalization_gate(mut_view(eng), view(fin_secret), mut_view(sink));

    let mut fin_unwind = fin_ok;
    fin_unwind.pdata_xdata_matches_frame = false;
    let w_fin_unwind = tval_validate_machine_finalization_gate(mut_view(eng), view(fin_unwind), mut_view(sink));

    if w_fin_stage.equivalence_verified || w_fin_stage.failure_kind != TVAL_FAIL_FINALIZE_PIPELINE_STAGE ||
       w_fin_align.equivalence_verified || w_fin_align.failure_kind != TVAL_FAIL_STACK_ALIGNMENT ||
       w_fin_chkstk.equivalence_verified || w_fin_chkstk.failure_kind != TVAL_FAIL_MISSING_CHKSTK_PROBE ||
       w_fin_secret.equivalence_verified || w_fin_secret.failure_kind != TVAL_FAIL_SECRET_ZEROIZE_DROPPED ||
       w_fin_unwind.equivalence_verified || w_fin_unwind.failure_kind != TVAL_FAIL_UNWIND_METADATA_MISMATCH {
        diag_sink_free(mut_view(sink));
        arena_destroy(mut_view(arena));
        return false;
    }

    // 4. Deterministic `inspect --emit=pass-witness` formatting (AXS-PCT-050)
    let mut buf1 = diag_buf_new();
    let mut buf2 = diag_buf_new();
    tval_format_pass_witness_report(view(eng), view(pct_eng), view(store), mut_view(buf1));
    tval_format_pass_witness_report(view(eng), view(pct_eng), view(store), mut_view(buf2));
    let mut report_det = buf1.len > 64 && buf1.len == buf2.len;
    let mut b_idx: usize = 0;
    while b_idx < buf1.len && report_det {
        if (unsafe { *(buf1.ptr + b_idx) }) != (unsafe { *(buf2.ptr + b_idx) }) {
            report_det = false;
        }
        b_idx = b_idx + 1;
    }
    diag_buf_free(mut_view(buf1));
    diag_buf_free(mut_view(buf2));
    diag_sink_free(mut_view(sink));
    arena_destroy(mut_view(arena));
    report_det
}

pub fn main() -> i32 {
    if !probe_equivalence_and_scalar() {
        print("FAIL: probe_equivalence_and_scalar\n");
        return 1;
    }
    print("PROBE_EQUIVALENCE_AND_SCALAR=OK\n");

    if !probe_cfg_memory_and_legalize() {
        print("FAIL: probe_cfg_memory_and_legalize\n");
        return 2;
    }
    print("PROBE_CFG_MEMORY_AND_LEGALIZE=OK\n");

    if !probe_regalloc_and_spills() {
        print("FAIL: probe_regalloc_and_spills\n");
        return 3;
    }
    print("PROBE_REGALLOC_AND_SPILLS=OK\n");

    if !probe_schedule_finalize_and_witness() {
        print("FAIL: probe_schedule_finalize_and_witness\n");
        return 4;
    }
    print("PROBE_SCHEDULE_FINALIZE_AND_WITNESS=OK\n");
    0
}
