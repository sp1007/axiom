// test: run
// modes: interp native
// exit: 0
// stdout: TVAL_NARROW_EXT_AND_CARRY=OK\nTVAL_CALL_CLOBBER_AND_FIXED_REGS=OK\nTVAL_STORE_FWD_AND_DROP_BARRIER=OK\n
// T770 QA boundary test: narrow integer sign/zero extension & multi-word carry chains (AXS-PCT-022.1),
// live-range survival across calls with variable RCX shifts and RAX:RDX div/rem (AXS-PCT-022.2),
// and store-to-load forwarding + deterministic Drop barrier preservation (AXS-PCT-021.3, AXS-PCT-023).

struct ScopeGuard {
    id: i32,
}

impl Drop for ScopeGuard {
    fn drop(self: mut_view<ScopeGuard>) {
        if self.id == 10i32 {
            print("TVAL_STORE_FWD_AND_DROP_BARRIER=OK\n");
        }
    }
}

fn callee_mix(x: i64, y: i64) -> i64 {
    (x * 3) - y + 5
}

fn verify_narrow_ext_and_carry() -> bool {
    let b_neg: i8 = -12i8;
    let b_pos: u8 = 250u8;
    let s_ext: i64 = b_neg as i64;
    let z_ext: u64 = b_pos as u64;
    if s_ext != -12 || z_ext != 250u64 {
        return false;
    }

    // Multi-limb (lo, hi) 32-bit carry propagation in u64 (AXS-PCT-022.1)
    let a_lo: u64 = 0xFFFF_FFF0u64;
    let a_hi: u64 = 7u64;
    let b_lo: u64 = 32u64;
    let b_hi: u64 = 10u64;
    let full_lo: u64 = a_lo + b_lo;
    let sum_lo: u64 = full_lo & 0xFFFF_FFFFu64;
    let carry: u64 = full_lo >> 32u64;
    let sum_hi: u64 = a_hi + b_hi + carry;
    sum_lo == 16u64 && carry == 1u64 && sum_hi == 18u64
}

fn verify_call_clobber_and_fixed_regs(base: i64) -> bool {
    // Keep values live across calls while mixing variable shifts (RCX) and idiv/irem (RAX:RDX)
    let live_a = base + 11;
    let live_b = base + 23;
    let live_c = base + 37;
    let sh: i64 = (base - 2) & 7; // 3 when base == 5

    let c1 = callee_mix(live_a, live_b);
    let shifted = (live_c << sh) >> 1;
    let c2 = callee_mix(live_b, live_c);
    let quot = (live_c * 9) / live_a;
    let rem = (live_c * 9) % live_a;

    // base = 5 => live_a = 16, live_b = 28, live_c = 42, sh = 3
    // c1 = 48 - 28 + 5 = 25
    // shifted = (42 << 3) >> 1 = 168
    // c2 = 84 - 42 + 5 = 47
    // quot = 378 / 16 = 23, rem = 378 % 16 = 10
    let total = live_a + live_b + live_c + c1 + shifted + c2 + quot + rem;
    total == 359
}

fn verify_store_fwd_and_drop_barrier() -> bool {
    let _g = ScopeGuard { id: 10i32 };
    let mut arr: [4]i64 = [3, 6, 9, 12];
    arr[1] = 20;
    arr[2] = arr[1] + 5; // store-to-load forwarding candidate
    arr[1] = 40;
    let sum = arr[0] + arr[1] + arr[2] + arr[3];
    sum == 80
}

pub fn main() -> i32 {
    if !verify_narrow_ext_and_carry() {
        return 1;
    }
    print("TVAL_NARROW_EXT_AND_CARRY=OK\n");

    if !verify_call_clobber_and_fixed_regs(5) {
        return 2;
    }
    print("TVAL_CALL_CLOBBER_AND_FIXED_REGS=OK\n");

    if !verify_store_fwd_and_drop_barrier() {
        return 3;
    }
    0
}
