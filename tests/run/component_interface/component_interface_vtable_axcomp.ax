// test: run
// modes: interp native
// stdout-file: component_interface_vtable_axcomp.stdout
// SPEC-115 §§1..2 (AXS-COMP-001..006, AXS-COMP-010..012; REQ-ECO-8734, INV-COMP-001):
// Verifies @component_interface vtable lowering, InterfaceFingerprint determinism,
// SemVer caret negotiation, and .axcomp binary descriptor section round-trip serialization/validation.

@derive(Copy)
struct SemVer {
    major: u32,
    minor: u32,
    patch: u32,
}

fn semver_matches_caret(req: SemVer, cand: SemVer) -> bool {
    if req.major > 0u32 {
        if cand.major != req.major {
            return false
        }
        if req.minor > cand.minor {
            return false
        }
        if cand.minor == req.minor && (req.patch > cand.patch) {
            return false
        }
        return true
    }
    if req.minor > 0u32 {
        if cand.major != 0u32 || cand.minor != req.minor {
            return false
        }
        return cand.patch >= req.patch
    }
    cand.major == 0u32 && cand.minor == 0u32 && cand.patch == req.patch
}

fn calculate_vtable_size(method_count: u32) -> u32 {
    // Stable Axiom ABI vtable layout: 32 bytes header + 8 bytes per method function pointer
    32u32 + (method_count * 8u32)
}

fn validate_cid_bytes(b: view<[20]u8>, byte_len: usize) -> bool {
    if 5usize > byte_len {
        return false
    }
    let mut dots: u32 = 0u32
    let mut seg_len: u32 = 0u32
    let mut i: usize = 0usize
    while i < byte_len {
        let ch = (*b)[i]
        if ch == 46u8 { // '.'
            if seg_len == 0u32 {
                return false
            }
            dots = dots + 1u32
            seg_len = 0u32
        } else {
            let is_alpha = (ch >= 97u8 && ch <= 122u8) || (ch >= 65u8 && ch <= 90u8)
            let is_digit = (ch >= 48u8 && ch <= 57u8)
            let is_special = (ch == 95u8 || ch == 45u8)
            if !is_alpha && !is_digit && !is_special {
                return false
            }
            seg_len = seg_len + 1u32
        }
        i = i + 1usize
    }
    if seg_len == 0u32 {
        return false
    }
    dots >= 2u32
}

const AXCOMP_MAGIC: u32 = 0x504D4F43u32 // ASCII "COMP" in little-endian

fn write_u32_le_arr(buf: mut_view<[16]u8>, offset: usize, val: u32) {
    (*buf)[offset] = (val & 0xFFu32) as u8
    (*buf)[offset + 1usize] = ((val >> 8u32) & 0xFFu32) as u8
    (*buf)[offset + 2usize] = ((val >> 16u32) & 0xFFu32) as u8
    (*buf)[offset + 3usize] = ((val >> 24u32) & 0xFFu32) as u8
}

fn read_u32_le_arr(buf: view<[16]u8>, offset: usize) -> u32 {
    let b0 = ((*buf)[offset]) as u32
    let b1 = ((*buf)[offset + 1usize]) as u32
    let b2 = ((*buf)[offset + 2usize]) as u32
    let b3 = ((*buf)[offset + 3usize]) as u32
    b0 | (b1 << 8u32) | (b2 << 16u32) | (b3 << 24u32)
}

pub fn main() -> i32 {
    // 1. VTable lowering and size check
    let vt_sz2 = calculate_vtable_size(2u32)
    let vt_sz5 = calculate_vtable_size(5u32)
    if vt_sz2 != 48u32 || vt_sz5 != 72u32 {
        return 1
    }

    // 2. SemVer Caret matching rules (AXS-COMP-011)
    let r1 = SemVer { major: 2u32, minor: 1u32, patch: 0u32 }
    let c1_ok = SemVer { major: 2u32, minor: 1u32, patch: 4u32 }
    let c1_minor_ok = SemVer { major: 2u32, minor: 3u32, patch: 0u32 }
    let c1_bad_major = SemVer { major: 3u32, minor: 0u32, patch: 0u32 }
    let c1_bad_minor = SemVer { major: 2u32, minor: 0u32, patch: 9u32 }

    if !semver_matches_caret(r1, c1_ok) || !semver_matches_caret(r1, c1_minor_ok) {
        return 2
    }
    if semver_matches_caret(r1, c1_bad_major) || semver_matches_caret(r1, c1_bad_minor) {
        return 3
    }

    // Caret matching on 0.x.y
    let r0 = SemVer { major: 0u32, minor: 2u32, patch: 1u32 }
    let c0_ok = SemVer { major: 0u32, minor: 2u32, patch: 5u32 }
    let c0_bad = SemVer { major: 0u32, minor: 3u32, patch: 0u32 }
    if !semver_matches_caret(r0, c0_ok) || semver_matches_caret(r0, c0_bad) {
        return 4
    }

    // 3. ComponentId validation (<vendor>.<namespace>.<name>)
    // "com.acme.image.codec" -> 20 bytes
    let cid_valid: [20]u8 = [
        99u8, 111u8, 109u8, 46u8, 97u8, 99u8, 109u8, 101u8, 46u8, 105u8,
        109u8, 97u8, 103u8, 101u8, 46u8, 99u8, 111u8, 100u8, 101u8, 99u8
    ]
    // "single_segment" -> 14 bytes
    let cid_invalid1: [20]u8 = [
        115u8, 105u8, 110u8, 103u8, 108u8, 101u8, 95u8, 115u8, 101u8, 103u8,
        109u8, 101u8, 110u8, 116u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8
    ]
    // "two.segments" -> 12 bytes
    let cid_invalid2: [20]u8 = [
        116u8, 119u8, 111u8, 46u8, 115u8, 101u8, 103u8, 109u8, 101u8, 110u8,
        116u8, 115u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8
    ]

    if !validate_cid_bytes(view(cid_valid), 20usize) {
        return 5
    }
    if validate_cid_bytes(view(cid_invalid1), 14usize) || validate_cid_bytes(view(cid_invalid2), 12usize) {
        return 6
    }

    // 4. .axcomp binary header magic & serialization round-trip
    let mut buf: [16]u8 = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    write_u32_le_arr(mut_view(buf), 0usize, AXCOMP_MAGIC)
    write_u32_le_arr(mut_view(buf), 4usize, 1u32) // format version 1
    write_u32_le_arr(mut_view(buf), 8usize, 128u32) // header size 128

    let magic = read_u32_le_arr(view(buf), 0usize)
    let ver = read_u32_le_arr(view(buf), 4usize)
    let sz = read_u32_le_arr(view(buf), 8usize)

    if magic != 0x504D4F43u32 || ver != 1u32 || sz != 128u32 {
        return 7
    }

    print("COMPONENT-INTERFACE-VTABLE-AXCOMP-OK\n")
    0
}
