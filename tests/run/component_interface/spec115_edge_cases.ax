// test: run
// modes: interp native
// stdout-file: spec115_edge_cases.stdout
// SPEC-115 §§1..4 & §6 (AXS-COMP-002, AXS-COMP-005, AXS-COMP-011, AXS-COMP-022, AXS-COMP-032, AXS-COMP-050; REQ-ECO-8734, INV-COMP-001):
// Verifies critical SPEC-115 boundary cases:
// 1. SemVer Caret matching with 0.0.x exact patch & pre-release rejection
// 2. ComponentId format validation edge cases (leading/trailing/consecutive dots, special chars)
// 3. Corrupted .axcomp header bounds (magic, version, header_size, cid_offset < 128, overflow)
// 4. ComponentHandle stale generation vs stale epoch isolation
// 5. @hot_reload_state field-order and field-type sensitivity

@derive(Copy)
struct SemVerEdge {
    major: u32,
    minor: u32,
    patch: u32,
    is_prerelease: bool,
    prerelease_id: u32,
}

fn semver_edge_matches_caret(req: SemVerEdge, cand: SemVerEdge) -> bool {
    // AXS-COMP-011 §2: Pre-release versions NEVER match stable requirement constraints
    if !req.is_prerelease && cand.is_prerelease {
        return false
    }
    if req.is_prerelease {
        if !cand.is_prerelease || req.prerelease_id != cand.prerelease_id {
            return false
        }
    }
    if req.major > 0u32 {
        if cand.major != req.major {
            return false
        }
        if req.minor > cand.minor {
            return false
        }
        if cand.minor == req.minor && (req.patch > cand.patch) {
            return false
        }
        return true
    }
    if req.minor > 0u32 {
        if cand.major != 0u32 || cand.minor != req.minor {
            return false
        }
        return cand.patch >= req.patch
    }
    // 0.0.x exact patch matching (^0.0.3 matches ==0.0.3)
    cand.major == 0u32 && cand.minor == 0u32 && cand.patch == req.patch
}

fn validate_cid_edge(b: view<[24]u8>, byte_len: usize) -> bool {
    if 5usize > byte_len {
        return false
    }
    let mut dots: u32 = 0u32
    let mut seg_len: u32 = 0u32
    let mut i: usize = 0usize
    while i < byte_len {
        let ch = (*b)[i]
        if ch == 46u8 { // '.'
            if seg_len == 0u32 {
                return false // Leading dot or consecutive dots ".."
            }
            dots = dots + 1u32
            seg_len = 0u32
        } else {
            let is_alpha = (ch >= 97u8 && ch <= 122u8) || (ch >= 65u8 && ch <= 90u8)
            let is_digit = (ch >= 48u8 && ch <= 57u8)
            let is_special = (ch == 95u8 || ch == 45u8) // '_' or '-'
            if !is_alpha && !is_digit && !is_special {
                return false // Invalid char like '@' or '$'
            }
            seg_len = seg_len + 1u32
        }
        i = i + 1usize
    }
    if seg_len == 0u32 {
        return false // Trailing dot
    }
    dots >= 2u32
}

const AXCOMP_MAGIC: u32 = 0x504D4F43u32 // "COMP"

fn validate_axcomp_bounds(
    magic: u32,
    ver: u16,
    header_sz: u16,
    cid_offset: u32,
    cid_len: u32,
    total_buf_len: usize
) -> u32 {
    if magic != AXCOMP_MAGIC {
        return 232u32 // AX_COMP_CORRUPT_MANIFEST
    }
    if ver != 1u16 {
        return 232u32 // AX_COMP_CORRUPT_MANIFEST
    }
    if header_sz < 128u16 {
        return 232u32 // AX_COMP_CORRUPT_MANIFEST
    }
    if cid_offset < 128u32 {
        return 232u32 // Out-of-bounds: within header space
    }
    let cid_end = (cid_offset as usize) + (cid_len as usize)
    if cid_end > total_buf_len {
        return 232u32 // Out-of-bounds: exceeds buffer length
    }
    0u32
}

fn check_handle_status(slot_gen: u32, handle_gen: u32, slot_epoch: u32, handle_epoch: u32) -> u32 {
    if slot_gen != handle_gen || slot_epoch != handle_epoch {
        return 240u32 // AX_COMP_STALE_HANDLE
    }
    0u32
}

fn mix_field(acc: u64, name_hash: u64, type_hash: u64, offset: u32, size: u32) -> u64 {
    let mut x = acc ^ name_hash
    x = x ^ (x >> 17u64)
    x = x ^ (type_hash << 11u64)
    x = x ^ (offset as u64)
    x = x ^ ((size as u64) << 32u64)
    x ^ (x >> 13u64)
}

pub fn main() -> i32 {
    // 1. SemVer edge cases: 0.0.x and prerelease rejection
    let req_stable = SemVerEdge { major: 1u32, minor: 2u32, patch: 0u32, is_prerelease: false, prerelease_id: 0u32 }
    let cand_rc = SemVerEdge { major: 1u32, minor: 2u32, patch: 1u32, is_prerelease: true, prerelease_id: 1u32 }
    // Stable requirement MUST reject pre-release candidate
    if semver_edge_matches_caret(req_stable, cand_rc) {
        return 1
    }

    // Explicit prerelease requirement matches identical prerelease
    let req_rc = SemVerEdge { major: 1u32, minor: 2u32, patch: 0u32, is_prerelease: true, prerelease_id: 1u32 }
    let cand_rc_same = SemVerEdge { major: 1u32, minor: 2u32, patch: 0u32, is_prerelease: true, prerelease_id: 1u32 }
    let cand_rc_diff = SemVerEdge { major: 1u32, minor: 2u32, patch: 0u32, is_prerelease: true, prerelease_id: 2u32 }
    if !semver_edge_matches_caret(req_rc, cand_rc_same) || semver_edge_matches_caret(req_rc, cand_rc_diff) {
        return 2
    }

    // 0.0.x exact patch requirement
    let req_003 = SemVerEdge { major: 0u32, minor: 0u32, patch: 3u32, is_prerelease: false, prerelease_id: 0u32 }
    let cand_003_ok = SemVerEdge { major: 0u32, minor: 0u32, patch: 3u32, is_prerelease: false, prerelease_id: 0u32 }
    let cand_004_bad = SemVerEdge { major: 0u32, minor: 0u32, patch: 4u32, is_prerelease: false, prerelease_id: 0u32 }
    if !semver_edge_matches_caret(req_003, cand_003_ok) || semver_edge_matches_caret(req_003, cand_004_bad) {
        return 3
    }

    // 2. ComponentId edge cases: leading/trailing dot, consecutive dots, special chars
    // Valid with hyphen and underscore: "acme-1.test_ns.codec-2" (22 chars)
    let cid_valid: [24]u8 = [
        97u8, 99u8, 109u8, 101u8, 45u8, 49u8, 46u8, 116u8, 101u8, 115u8, 116u8, 95u8,
        110u8, 115u8, 46u8, 99u8, 111u8, 100u8, 101u8, 99u8, 45u8, 50u8, 0u8, 0u8
    ]
    // Leading dot: ".com.acme.codec" (15 chars)
    let cid_lead_dot: [24]u8 = [
        46u8, 99u8, 111u8, 109u8, 46u8, 97u8, 99u8, 109u8, 101u8, 46u8,
        99u8, 111u8, 100u8, 101u8, 99u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8
    ]
    // Trailing dot: "com.acme.codec." (15 chars)
    let cid_trail_dot: [24]u8 = [
        99u8, 111u8, 109u8, 46u8, 97u8, 99u8, 109u8, 101u8, 46u8,
        99u8, 111u8, 100u8, 101u8, 99u8, 46u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8
    ]
    // Consecutive dots: "com..codec" (10 chars)
    let cid_consec_dots: [24]u8 = [
        99u8, 111u8, 109u8, 46u8, 46u8, 99u8, 111u8, 100u8, 101u8, 99u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8
    ]
    // Disallowed character '@': "com.acme@codec" (14 chars)
    let cid_bad_char: [24]u8 = [
        99u8, 111u8, 109u8, 46u8, 97u8, 99u8, 109u8, 101u8, 64u8, 99u8,
        111u8, 100u8, 101u8, 99u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8
    ]

    if !validate_cid_edge(view(cid_valid), 22usize) {
        return 4
    }
    if validate_cid_edge(view(cid_lead_dot), 15usize) ||
       validate_cid_edge(view(cid_trail_dot), 15usize) ||
       validate_cid_edge(view(cid_consec_dots), 10usize) ||
       validate_cid_edge(view(cid_bad_char), 14usize) {
        return 5
    }

    // 3. Corrupted .axcomp header bounds
    let b_ok = validate_axcomp_bounds(AXCOMP_MAGIC, 1u16, 128u16, 128u32, 20u32, 256usize)
    let b_bad_magic = validate_axcomp_bounds(0x12345678u32, 1u16, 128u16, 128u32, 20u32, 256usize)
    let b_bad_ver = validate_axcomp_bounds(AXCOMP_MAGIC, 2u16, 128u16, 128u32, 20u32, 256usize)
    let b_bad_hdr_sz = validate_axcomp_bounds(AXCOMP_MAGIC, 1u16, 64u16, 128u32, 20u32, 256usize)
    let b_bad_offset = validate_axcomp_bounds(AXCOMP_MAGIC, 1u16, 128u16, 64u32, 20u32, 256usize)
    let b_overflow = validate_axcomp_bounds(AXCOMP_MAGIC, 1u16, 128u16, 250u32, 20u32, 256usize)

    if b_ok != 0u32 {
        return 6
    }
    if b_bad_magic != 232u32 || b_bad_ver != 232u32 || b_bad_hdr_sz != 232u32 ||
       b_bad_offset != 232u32 || b_overflow != 232u32 {
        return 7
    }

    // 4. ComponentHandle stale generation vs stale epoch isolation
    let h_ok = check_handle_status(10u32, 10u32, 3u32, 3u32)
    let h_gen_diff = check_handle_status(11u32, 10u32, 3u32, 3u32)
    let h_ep_diff = check_handle_status(10u32, 10u32, 4u32, 3u32)
    let h_both_diff = check_handle_status(11u32, 10u32, 4u32, 3u32)

    if h_ok != 0u32 || h_gen_diff != 240u32 || h_ep_diff != 240u32 || h_both_diff != 240u32 {
        return 8
    }

    // 5. @hot_reload_state field-order and field-type sensitivity
    let base_acc: u64 = 0x5354415445534348u64
    let hash_name_a: u64 = 0x1111u64
    let hash_name_b: u64 = 0x2222u64
    let type_u64: u64 = 0xAAAAu64
    let type_u32: u64 = 0xBBBBu64

    // Layout 1: Field A (u64, offset 0, size 8) then Field B (u32, offset 8, size 4)
    let mut h1 = mix_field(base_acc, hash_name_a, type_u64, 0u32, 8u32)
    h1 = mix_field(h1, hash_name_b, type_u32, 8u32, 4u32)

    // Layout 2 (Reordered): Field B (u32, offset 0, size 4) then Field A (u64, offset 8, size 8)
    let mut h2 = mix_field(base_acc, hash_name_b, type_u32, 0u32, 4u32)
    h2 = mix_field(h2, hash_name_a, type_u64, 8u32, 8u32)

    // Layout 3 (Type changed): Field A (u32, offset 0, size 4) then Field B (u32, offset 4, size 4)
    let mut h3 = mix_field(base_acc, hash_name_a, type_u32, 0u32, 4u32)
    h3 = mix_field(h3, hash_name_b, type_u32, 4u32, 4u32)

    if h1 == h2 || h1 == h3 || h2 == h3 {
        return 9
    }

    print("SPEC115-EDGE-CASES-OK\n")
    0
}
