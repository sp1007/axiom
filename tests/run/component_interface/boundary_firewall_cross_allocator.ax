// test: run
// modes: interp native
// stdout-file: boundary_firewall_cross_allocator.stdout
// SPEC-115 §§2..3 & §6 (AXS-COMP-002, AXS-COMP-013, AXS-COMP-020..025, AXS-COMP-050; REQ-ECO-8734, INV-COMP-001):
// Verifies boundary firewall: rejection of raw pointer escapes, unleased views, plain host boxes/collections,
// acceptance of generational handles and ComponentBox, stale handle detection, active lease unload guards,
// capability manifest verification, and duplicate registration rejection.

// Passing modes:
// 0 = by-value scalar/struct, 1 = view, 2 = mut_view, 3 = component_box,
// 4 = component_handle, 5 = opaque_ptr, 6 = raw_ptr, 7 = plain_box, 8 = plain_collection
const PASS_BY_VAL: u8 = 0u8
const PASS_VIEW: u8 = 1u8
const PASS_MUT_VIEW: u8 = 2u8
const PASS_COMPONENT_BOX: u8 = 3u8
const PASS_COMPONENT_HANDLE: u8 = 4u8
const PASS_OPAQUE_PTR: u8 = 5u8
const PASS_RAW_PTR: u8 = 6u8
const PASS_PLAIN_BOX: u8 = 7u8
const PASS_PLAIN_COLLECTION: u8 = 8u8

fn check_boundary_safety(pass_mode: u8, has_lease: bool, is_unsafe: bool) -> u32 {
    if pass_mode == PASS_RAW_PTR {
        if !is_unsafe {
            return 238u32 // AX_COMP_RAW_POINTER_ESCAPE
        }
        return 0u32
    }
    if pass_mode == PASS_VIEW || pass_mode == PASS_MUT_VIEW {
        if !has_lease {
            return 241u32 // AX_COMP_UNLOAD_ACTIVE_LEASES (unleased view violation)
        }
        return 0u32
    }
    if pass_mode == PASS_PLAIN_BOX || pass_mode == PASS_PLAIN_COLLECTION {
        return 239u32 // AX_COMP_CROSS_ALLOCATOR_VIOLATION
    }
    0u32 // PASS_BY_VAL, PASS_COMPONENT_BOX, PASS_COMPONENT_HANDLE, PASS_OPAQUE_PTR are OK
}

// Generational handle validation (AXS-COMP-022)
fn check_generational_handle(slot_gen: u32, handle_gen: u32, slot_epoch: u32, handle_epoch: u32) -> bool {
    slot_gen == handle_gen && slot_epoch == handle_epoch
}

// Unload safety guard (AXS-COMP-023)
fn check_unload_permitted(active_leases: u64) -> bool {
    active_leases == 0u64
}

// Capability manifest verification (AXS-COMP-013)
const CAP_HEAP: u32 = 0x0001u32
const CAP_FS_READ: u32 = 0x0002u32
const CAP_NET: u32 = 0x0008u32

fn check_capabilities_permitted(req_mask: u32, granted_mask: u32) -> bool {
    let ungranted = req_mask & (~granted_mask)
    ungranted == 0u32
}

// Duplicate registration check (AXS-COMP-002)
@derive(Copy)
struct RegistryEntry {
    comp_id: u32,
    semver_major: u32,
    semver_minor: u32,
    is_active: bool,
}

fn check_duplicate_registration(
    existing: view<[4]RegistryEntry>,
    count: usize,
    cand_id: u32,
    cand_major: u32,
    cand_minor: u32
) -> bool {
    let mut i: usize = 0usize
    while i < count {
        let e = (*existing)[i]
        if e.is_active && e.comp_id == cand_id && e.semver_major == cand_major && e.semver_minor == cand_minor {
            return true // Duplicate found!
        }
        i = i + 1usize
    }
    false
}

pub fn main() -> i32 {
    // 1. Boundary pass mode firewall
    let raw_err = check_boundary_safety(PASS_RAW_PTR, false, false)
    let raw_unsafe_ok = check_boundary_safety(PASS_RAW_PTR, false, true)
    let unleased_err = check_boundary_safety(PASS_VIEW, false, false)
    let leased_ok = check_boundary_safety(PASS_VIEW, true, false)
    let box_err = check_boundary_safety(PASS_PLAIN_BOX, false, false)
    let coll_err = check_boundary_safety(PASS_PLAIN_COLLECTION, false, false)

    let comp_box_ok = check_boundary_safety(PASS_COMPONENT_BOX, false, false)
    let handle_ok = check_boundary_safety(PASS_COMPONENT_HANDLE, false, false)
    let opaque_ok = check_boundary_safety(PASS_OPAQUE_PTR, false, false)

    if raw_err != 238u32 || raw_unsafe_ok != 0u32 {
        return 1
    }
    if unleased_err != 241u32 || leased_ok != 0u32 {
        return 2
    }
    if box_err != 239u32 || coll_err != 239u32 {
        return 3
    }
    if comp_box_ok != 0u32 || handle_ok != 0u32 || opaque_ok != 0u32 {
        return 4
    }

    // 2. Generational handle verification
    let h_valid = check_generational_handle(1u32, 1u32, 1u32, 1u32)
    let h_stale_gen = check_generational_handle(2u32, 1u32, 1u32, 1u32)
    let h_stale_epoch = check_generational_handle(1u32, 1u32, 2u32, 1u32)
    if !h_valid || h_stale_gen || h_stale_epoch {
        return 5
    }

    // 3. Unload safety guard
    let unload_clean = check_unload_permitted(0u64)
    let unload_blocked = check_unload_permitted(3u64)
    if !unload_clean || unload_blocked {
        return 6
    }

    // 4. Capability verification
    let cap_ok = check_capabilities_permitted(CAP_HEAP | CAP_FS_READ, CAP_HEAP | CAP_FS_READ | CAP_NET)
    let cap_denied = check_capabilities_permitted(CAP_HEAP | CAP_NET, CAP_HEAP | CAP_FS_READ)
    if !cap_ok || cap_denied {
        return 7
    }

    // 5. Duplicate registration check
    let dummy_entry = RegistryEntry { comp_id: 0u32, semver_major: 0u32, semver_minor: 0u32, is_active: false }
    let mut reg: [4]RegistryEntry = [
        RegistryEntry { comp_id: 42u32, semver_major: 1u32, semver_minor: 0u32, is_active: true },
        dummy_entry, dummy_entry, dummy_entry
    ]
    let dup_detected = check_duplicate_registration(view(reg), 1usize, 42u32, 1u32, 0u32)
    let new_allowed = check_duplicate_registration(view(reg), 1usize, 42u32, 2u32, 0u32)
    if !dup_detected || new_allowed {
        return 8
    }

    print("BOUNDARY-FIREWALL-CROSS-ALLOCATOR-OK\n")
    0
}
