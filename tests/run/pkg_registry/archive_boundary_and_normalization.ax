// test: run
// modes: interp native
// stdout-file: archive_boundary_and_normalization.stdout
// SPEC-112 §§1..4 (AXS-REG-010..013, AXS-REG-030..034; REQ-ECO-8736, REQ-PKG-024):
// Regression and boundary cross-check for archive path normalization,
// case-folding collision detection, odd-node Merkle reduction, CRLF normalization,
// sparse index path sharding, and generation rollback barriers.

@intrinsic fn wrapping_add_u32(a: u32, b: u32) -> u32 { 0 }
@intrinsic fn rotate_right_u32(a: u32, b: u32) -> u32 { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

@derive(Copy)
struct Sha256State {
    h0: u32, h1: u32, h2: u32, h3: u32,
    h4: u32, h5: u32, h6: u32, h7: u32,
    block: [64]u8,
    block_len: usize,
    total_len: u64,
}

@derive(Copy)
struct Sha256Digest {
    bytes: [32]u8,
}

fn sha256_digest_zero() -> Sha256Digest {
    Sha256Digest { bytes: [0u8; 32] }
}

fn sha256_digest_eq(a: view<Sha256Digest>, b: view<Sha256Digest>) -> bool {
    let mut i: usize = 0usize
    while i < 32usize {
        if a.bytes[i] != b.bytes[i] { return false }
        i = i + 1usize
    }
    true
}

fn rotr(x: u32, n: u32) -> u32 { rotate_right_u32(x, n) }
fn sigma0(x: u32) -> u32 { rotr(x, 7u32) ^ rotr(x, 18u32) ^ (x >> 3u32) }
fn sigma1(x: u32) -> u32 { rotr(x, 17u32) ^ rotr(x, 19u32) ^ (x >> 10u32) }
fn cap_sigma0(x: u32) -> u32 { rotr(x, 2u32) ^ rotr(x, 13u32) ^ rotr(x, 22u32) }
fn cap_sigma1(x: u32) -> u32 { rotr(x, 6u32) ^ rotr(x, 11u32) ^ rotr(x, 25u32) }
fn ch(x: u32, y: u32, z: u32) -> u32 { (x & y) ^ ((~x) & z) }
fn maj(x: u32, y: u32, z: u32) -> u32 { (x & y) ^ (x & z) ^ (y & z) }

fn sha256_k(i: usize) -> u32 {
    let k: [64]u32 = [
        0x428a2f98u32, 0x71374491u32, 0xb5c0fbcfu32, 0xe9b5dba5u32,
        0x3956c25bu32, 0x59f111f1u32, 0x923f82a4u32, 0xab1c5ed5u32,
        0xd807aa98u32, 0x12835b01u32, 0x243185beu32, 0x550c7dc3u32,
        0x72be5d74u32, 0x80deb1feu32, 0x9bdc06a7u32, 0xc19bf174u32,
        0xe49b69c1u32, 0xefbe4786u32, 0x0fc19dc6u32, 0x240ca1ccu32,
        0x2de92c6fu32, 0x4a7484aau32, 0x5cb0a9dcu32, 0x76f988dau32,
        0x983e5152u32, 0xa831c66du32, 0xb00327c8u32, 0xbf597fc7u32,
        0xc6e00bf3u32, 0xd5a79147u32, 0x06ca6351u32, 0x14292967u32,
        0x27b70a85u32, 0x2e1b2138u32, 0x4d2c6dfcu32, 0x53380d13u32,
        0x650a7354u32, 0x766a0abbu32, 0x81c2c92eu32, 0x92722c85u32,
        0xa2bfe8a1u32, 0xa81a664bu32, 0xc24b8b70u32, 0xc76c51a3u32,
        0xd192e819u32, 0xd6990624u32, 0xf40e3585u32, 0x106aa070u32,
        0x19a4c116u32, 0x1e376c08u32, 0x2748774cu32, 0x34b0bcb5u32,
        0x391c0cb3u32, 0x4ed8aa4au32, 0x5b9cca4fu32, 0x682e6ff3u32,
        0x748f82eeu32, 0x78a5636fu32, 0x84c87814u32, 0x8cc70208u32,
        0x90befffau32, 0xa4506cebu32, 0xbef9a3f7u32, 0xc67178f2u32
    ]
    k[i]
}

fn sha256_process(s: mut_view<Sha256State>) {
    let mut w: [64]u32 = [0u32; 64]
    let mut t: usize = 0usize
    while t < 16usize {
        let b0 = s.block[t * 4usize] as u32
        let b1 = s.block[t * 4usize + 1usize] as u32
        let b2 = s.block[t * 4usize + 2usize] as u32
        let b3 = s.block[t * 4usize + 3usize] as u32
        w[t] = (b0 << 24u32) | (b1 << 16u32) | (b2 << 8u32) | b3
        t = t + 1usize
    }
    while t < 64usize {
        let s0 = sigma0(w[t - 15usize])
        let s1 = sigma1(w[t - 2usize])
        let term1 = wrapping_add_u32(w[t - 16usize], s0)
        let term2 = wrapping_add_u32(w[t - 7usize], s1)
        w[t] = wrapping_add_u32(term1, term2)
        t = t + 1usize
    }

    let mut a = s.h0
    let mut b = s.h1
    let mut c = s.h2
    let mut d = s.h3
    let mut e = s.h4
    let mut f = s.h5
    let mut g = s.h6
    let mut h = s.h7

    t = 0usize
    while t < 64usize {
        let t1 = wrapping_add_u32(
            wrapping_add_u32(wrapping_add_u32(h, cap_sigma1(e)), ch(e, f, g)),
            wrapping_add_u32(sha256_k(t), w[t])
        )
        let t2 = wrapping_add_u32(cap_sigma0(a), maj(a, b, c))
        h = g
        g = f
        f = e
        e = wrapping_add_u32(d, t1)
        d = c
        c = b
        b = a
        a = wrapping_add_u32(t1, t2)
        t = t + 1usize
    }

    s.h0 = wrapping_add_u32(s.h0, a)
    s.h1 = wrapping_add_u32(s.h1, b)
    s.h2 = wrapping_add_u32(s.h2, c)
    s.h3 = wrapping_add_u32(s.h3, d)
    s.h4 = wrapping_add_u32(s.h4, e)
    s.h5 = wrapping_add_u32(s.h5, f)
    s.h6 = wrapping_add_u32(s.h6, g)
    s.h7 = wrapping_add_u32(s.h7, h)
}

fn sha256_init(s: mut_view<Sha256State>) {
    s.h0 = 0x6a09e667u32
    s.h1 = 0xbb67ae85u32
    s.h2 = 0x3c6ef372u32
    s.h3 = 0xa54ff53au32
    s.h4 = 0x510e527fu32
    s.h5 = 0x9b05688cu32
    s.h6 = 0x1f83d9abu32
    s.h7 = 0x5be0cd19u32
    s.block_len = 0usize
    s.total_len = 0u64
}

fn sha256_update(s: mut_view<Sha256State>, data: *const u8, byte_count: usize) {
    if byte_count == 0usize || (data as usize) == 0usize { return }
    s.total_len = s.total_len + (byte_count as u64)
    let mut i: usize = 0usize
    while i < byte_count {
        s.block[s.block_len] = unsafe { *(data + i) }
        s.block_len = s.block_len + 1usize
        if (s.block_len) == 64usize {
            sha256_process(mut_view(*s))
            s.block_len = 0usize
        }
        i = i + 1usize
    }
}

fn sha256_final(s: mut_view<Sha256State>, out: mut_view<Sha256Digest>) {
    let bit_len = s.total_len * 8u64
    s.block[s.block_len] = 0x80u8
    s.block_len = s.block_len + 1usize
    if s.block_len > 56usize {
        while (s.block_len) < 64usize {
            s.block[s.block_len] = 0u8
            s.block_len = s.block_len + 1usize
        }
        sha256_process(mut_view(*s))
        s.block_len = 0usize
    }
    while (s.block_len) < 56usize {
        s.block[s.block_len] = 0u8
        s.block_len = s.block_len + 1usize
    }
    let mut k: usize = 0usize
    while k < 8usize {
        let shift = ((56usize - k * 8usize) as u32)
        s.block[56usize + k] = ((bit_len >> shift) & 0xFFu64) as u8
        k = k + 1usize
    }
    sha256_process(mut_view(*s))

    let mut j: usize = 0usize
    while j < 8usize {
        let val = match j {
            0usize => s.h0
            1usize => s.h1
            2usize => s.h2
            3usize => s.h3
            4usize => s.h4
            5usize => s.h5
            6usize => s.h6
            _ => s.h7
        }
        out.bytes[j * 4usize] = ((val >> 24u32) & 0xFFu32) as u8
        out.bytes[j * 4usize + 1usize] = ((val >> 16u32) & 0xFFu32) as u8
        out.bytes[j * 4usize + 2usize] = ((val >> 8u32) & 0xFFu32) as u8
        out.bytes[j * 4usize + 3usize] = (val & 0xFFu32) as u8
        j = j + 1usize
    }
}

fn compute_node_hash(left: view<Sha256Digest>, right: view<Sha256Digest>) -> Sha256Digest {
    let mut st = Sha256State {
        h0: 0u32, h1: 0u32, h2: 0u32, h3: 0u32,
        h4: 0u32, h5: 0u32, h6: 0u32, h7: 0u32,
        block: [0u8; 64], block_len: 0usize, total_len: 0u64,
    }
    let mut d = sha256_digest_zero()
    sha256_init(mut_view(st))
    let pfx: [14]u8 = [65u8, 88u8, 80u8, 75u8, 71u8, 45u8, 78u8, 79u8, 68u8, 69u8, 45u8, 118u8, 49u8, 0u8]
    sha256_update(mut_view(st), unsafe { address_of(pfx[0]) }, 14usize)
    sha256_update(mut_view(st), unsafe { address_of(left.bytes[0]) }, 32usize)
    sha256_update(mut_view(st), unsafe { address_of(right.bytes[0]) }, 32usize)
    sha256_final(mut_view(st), mut_view(d))
    d
}

// Strict path safety checker per AXS-REG-011 / AXS-REG-013
fn is_path_safe(p: view<[u8]>) -> bool {
    let n = len(p)
    if n == 0usize { return false }
    let b0 = p[0]
    if b0 == 47u8 || b0 == 92u8 { return false }
    if n >= 2usize && p[1] == 58u8 { return false }
    if p[n - 1usize] == 47u8 { return false }

    let mut i: usize = 0usize
    while i < n {
        let b = p[i]
        if b == 92u8 || b < 32u8 || b == 127u8 { return false }
        if b == 46u8 {
            let prev_sep = i == 0usize || p[i - 1usize] == 47u8
            if prev_sep {
                if (i + 1usize) == n || p[i + 1usize] == 47u8 {
                    return false
                }
                if p[i + 1usize] == 46u8 {
                    if (i + 2usize) == n || p[i + 2usize] == 47u8 {
                        return false
                    }
                }
            }
        }
        i = i + 1usize
    }
    true
}

// Case-folding equality check
fn is_case_collision(a: view<[u8]>, b: view<[u8]>) -> bool {
    let an = len(a)
    let bn = len(b)
    if an != bn { return false }
    let mut i: usize = 0usize
    while i < an {
        let mut ba = a[i]
        let mut bb = b[i]
        if ba >= 65u8 && ba <= 90u8 { ba = ba + 32u8 }
        if bb >= 65u8 && bb <= 90u8 { bb = bb + 32u8 }
        if ba != bb { return false }
        i = i + 1usize
    }
    true
}

pub fn main() -> i32 {
    // 1. Path traversal boundary cases
    let p_dot: [1]u8 = [46u8] // "."
    let p_dotdot: [2]u8 = [46u8, 46u8] // ".."
    let p_embed_dot: [11]u8 = [115u8, 114u8, 99u8, 47u8, 46u8, 47u8, 108u8, 105u8, 98u8, 46u8, 97u8] // "src/./lib.a"
    let p_embed_dotdot: [12]u8 = [115u8, 114u8, 99u8, 47u8, 46u8, 46u8, 47u8, 108u8, 105u8, 98u8, 46u8, 97u8] // "src/../lib.a"
    let p_trailing_slash: [8]u8 = [115u8, 114u8, 99u8, 47u8, 102u8, 111u8, 111u8, 47u8] // "src/foo/"
    let p_backslash: [10]u8 = [115u8, 114u8, 99u8, 92u8, 108u8, 105u8, 98u8, 46u8, 97u8, 120u8] // "src\lib.ax"
    let p_ctrl: [10]u8 = [115u8, 114u8, 99u8, 47u8, 108u8, 7u8, 105u8, 98u8, 46u8, 97u8] // "src/l\aiba" (control 7)
    let p_axmeta: [7]u8 = [46u8, 97u8, 120u8, 109u8, 101u8, 116u8, 97u8] // ".axmeta" (valid hidden file)
    let p_valid: [10]u8 = [115u8, 114u8, 99u8, 47u8, 108u8, 105u8, 98u8, 46u8, 97u8, 120u8] // "src/lib.ax"

    if is_path_safe(view(p_dot)) { return 101 }
    if is_path_safe(view(p_dotdot)) { return 102 }
    if is_path_safe(view(p_embed_dot)) { return 103 }
    if is_path_safe(view(p_embed_dotdot)) { return 104 }
    if is_path_safe(view(p_trailing_slash)) { return 105 }
    if is_path_safe(view(p_backslash)) { return 106 }
    if is_path_safe(view(p_ctrl)) { return 107 }
    if !is_path_safe(view(p_axmeta)) { return 108 }
    if !is_path_safe(view(p_valid)) { return 109 }

    // 2. Case-folding collision boundary cases
    let s_lower: [10]u8 = [115u8, 114u8, 99u8, 47u8, 108u8, 105u8, 98u8, 46u8, 97u8, 120u8] // "src/lib.ax"
    let s_upper: [10]u8 = [83u8, 82u8, 67u8, 47u8, 76u8, 73u8, 66u8, 46u8, 65u8, 88u8] // "SRC/LIB.AX"
    let s_diff: [10]u8 = [115u8, 114u8, 99u8, 47u8, 109u8, 105u8, 98u8, 46u8, 97u8, 120u8] // "src/mib.ax"
    let s_short: [9]u8 = [115u8, 114u8, 99u8, 47u8, 108u8, 105u8, 98u8, 46u8, 97u8] // "src/lib.a"

    if !is_case_collision(view(s_lower), view(s_upper)) {
        return 110
    }
    if is_case_collision(view(s_lower), view(s_diff)) {
        return 111
    }
    if is_case_collision(view(s_lower), view(s_short)) {
        return 112
    }

    // 3. Merkle 3-leaf odd reduction promotion & tamper check
    let mut leaf0 = sha256_digest_zero()
    leaf0.bytes[0] = 10u8
    let mut leaf1 = sha256_digest_zero()
    leaf1.bytes[0] = 20u8
    let mut leaf2 = sha256_digest_zero()
    leaf2.bytes[0] = 30u8

    // 3 leaves: pair (leaf0, leaf1) -> p01; leaf2 promoted -> root = node(p01, leaf2)
    let p01 = compute_node_hash(view(leaf0), view(leaf1))
    let root3 = compute_node_hash(view(p01), view(leaf2))

    // Tampering with promoted odd leaf2 must alter the Merkle root
    let mut leaf2_tampered = leaf2
    leaf2_tampered.bytes[0] = 31u8
    let root3_tampered = compute_node_hash(view(p01), view(leaf2_tampered))

    if sha256_digest_eq(view(root3), view(root3_tampered)) {
        return 113
    }

    // 4. Rollback generation barrier check
    let active_generation = 4u32
    let min_allowed_version = 2u32

    // Target 0: invalid
    let target_0_ok = 0u32 > 0u32 && 0u32 < active_generation && 0u32 >= min_allowed_version
    if target_0_ok { return 114 }

    // Target 4: already active, no-op/blocked
    let target_4_ok = 4u32 > 0u32 && 4u32 < active_generation && 4u32 >= min_allowed_version
    if target_4_ok { return 115 }

    // Target 1: blocked by min_allowed_version (downgrade attack barrier)
    let target_1_ok = 1u32 > 0u32 && 1u32 < active_generation && 1u32 >= min_allowed_version
    if target_1_ok { return 116 }

    // Target 2: valid rollback target
    let target_2_ok = 2u32 > 0u32 && 2u32 < active_generation && 2u32 >= min_allowed_version
    if !target_2_ok { return 117 }

    print("ARCHIVE-BOUNDARY-AND-NORMALIZATION-OK\n")
    0
}
