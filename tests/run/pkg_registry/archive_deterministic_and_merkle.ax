// test: run
// modes: interp native
// stdout-file: archive_deterministic_and_merkle.stdout
// SPEC-112 §§1..2 (AXS-REG-010..013; REQ-ECO-8736, REQ-PKG-024):
// Verifies deterministic .axpkg archive packing, entry lexicographical sorting,
// normalized POSIX paths, zeroed metadata, chunked SHA-256 Merkle root computation,
// and tamper detection.

@intrinsic fn wrapping_add_u32(a: u32, b: u32) -> u32 { 0 }
@intrinsic fn rotate_right_u32(a: u32, b: u32) -> u32 { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

@derive(Copy)
struct Sha256State {
    h0: u32, h1: u32, h2: u32, h3: u32,
    h4: u32, h5: u32, h6: u32, h7: u32,
    block: [64]u8,
    block_len: usize,
    total_len: u64,
}

@derive(Copy)
struct Sha256Digest {
    bytes: [32]u8,
}

fn sha256_digest_zero() -> Sha256Digest {
    Sha256Digest { bytes: [0u8; 32] }
}

fn sha256_digest_eq(a: view<Sha256Digest>, b: view<Sha256Digest>) -> bool {
    let mut i: usize = 0usize
    while i < 32usize {
        if a.bytes[i] != b.bytes[i] { return false }
        i = i + 1usize
    }
    true
}

fn rotr(x: u32, n: u32) -> u32 { rotate_right_u32(x, n) }
fn sigma0(x: u32) -> u32 { rotr(x, 7u32) ^ rotr(x, 18u32) ^ (x >> 3u32) }
fn sigma1(x: u32) -> u32 { rotr(x, 17u32) ^ rotr(x, 19u32) ^ (x >> 10u32) }
fn cap_sigma0(x: u32) -> u32 { rotr(x, 2u32) ^ rotr(x, 13u32) ^ rotr(x, 22u32) }
fn cap_sigma1(x: u32) -> u32 { rotr(x, 6u32) ^ rotr(x, 11u32) ^ rotr(x, 25u32) }
fn ch(x: u32, y: u32, z: u32) -> u32 { (x & y) ^ ((~x) & z) }
fn maj(x: u32, y: u32, z: u32) -> u32 { (x & y) ^ (x & z) ^ (y & z) }

fn sha256_k(i: usize) -> u32 {
    let k: [64]u32 = [
        0x428a2f98u32, 0x71374491u32, 0xb5c0fbcfu32, 0xe9b5dba5u32,
        0x3956c25bu32, 0x59f111f1u32, 0x923f82a4u32, 0xab1c5ed5u32,
        0xd807aa98u32, 0x12835b01u32, 0x243185beu32, 0x550c7dc3u32,
        0x72be5d74u32, 0x80deb1feu32, 0x9bdc06a7u32, 0xc19bf174u32,
        0xe49b69c1u32, 0xefbe4786u32, 0x0fc19dc6u32, 0x240ca1ccu32,
        0x2de92c6fu32, 0x4a7484aau32, 0x5cb0a9dcu32, 0x76f988dau32,
        0x983e5152u32, 0xa831c66du32, 0xb00327c8u32, 0xbf597fc7u32,
        0xc6e00bf3u32, 0xd5a79147u32, 0x06ca6351u32, 0x14292967u32,
        0x27b70a85u32, 0x2e1b2138u32, 0x4d2c6dfcu32, 0x53380d13u32,
        0x650a7354u32, 0x766a0abbu32, 0x81c2c92eu32, 0x92722c85u32,
        0xa2bfe8a1u32, 0xa81a664bu32, 0xc24b8b70u32, 0xc76c51a3u32,
        0xd192e819u32, 0xd6990624u32, 0xf40e3585u32, 0x106aa070u32,
        0x19a4c116u32, 0x1e376c08u32, 0x2748774cu32, 0x34b0bcb5u32,
        0x391c0cb3u32, 0x4ed8aa4au32, 0x5b9cca4fu32, 0x682e6ff3u32,
        0x748f82eeu32, 0x78a5636fu32, 0x84c87814u32, 0x8cc70208u32,
        0x90befffau32, 0xa4506cebu32, 0xbef9a3f7u32, 0xc67178f2u32
    ]
    k[i]
}

fn sha256_process(s: mut_view<Sha256State>) {
    let mut w: [64]u32 = [0u32; 64]
    let mut t: usize = 0usize
    while t < 16usize {
        let b0 = s.block[t * 4usize] as u32
        let b1 = s.block[t * 4usize + 1usize] as u32
        let b2 = s.block[t * 4usize + 2usize] as u32
        let b3 = s.block[t * 4usize + 3usize] as u32
        w[t] = (b0 << 24u32) | (b1 << 16u32) | (b2 << 8u32) | b3
        t = t + 1usize
    }
    while t < 64usize {
        let s0 = sigma0(w[t - 15usize])
        let s1 = sigma1(w[t - 2usize])
        let term1 = wrapping_add_u32(w[t - 16usize], s0)
        let term2 = wrapping_add_u32(w[t - 7usize], s1)
        w[t] = wrapping_add_u32(term1, term2)
        t = t + 1usize
    }

    let mut a = s.h0
    let mut b = s.h1
    let mut c = s.h2
    let mut d = s.h3
    let mut e = s.h4
    let mut f = s.h5
    let mut g = s.h6
    let mut h = s.h7

    t = 0usize
    while t < 64usize {
        let t1_p1 = wrapping_add_u32(h, cap_sigma1(e))
        let t1_p2 = wrapping_add_u32(ch(e, f, g), sha256_k(t))
        let t1 = wrapping_add_u32(wrapping_add_u32(t1_p1, t1_p2), w[t])
        let t2 = wrapping_add_u32(cap_sigma0(a), maj(a, b, c))

        h = g
        g = f
        f = e
        e = wrapping_add_u32(d, t1)
        d = c
        c = b
        b = a
        a = wrapping_add_u32(t1, t2)
        t = t + 1usize
    }

    s.h0 = wrapping_add_u32(s.h0, a)
    s.h1 = wrapping_add_u32(s.h1, b)
    s.h2 = wrapping_add_u32(s.h2, c)
    s.h3 = wrapping_add_u32(s.h3, d)
    s.h4 = wrapping_add_u32(s.h4, e)
    s.h5 = wrapping_add_u32(s.h5, f)
    s.h6 = wrapping_add_u32(s.h6, g)
    s.h7 = wrapping_add_u32(s.h7, h)
}

fn sha256_init(s: mut_view<Sha256State>) {
    s.h0 = 0x6a09e667u32
    s.h1 = 0xbb67ae85u32
    s.h2 = 0x3c6ef372u32
    s.h3 = 0xa54ff53au32
    s.h4 = 0x510e527fu32
    s.h5 = 0x9b05688cu32
    s.h6 = 0x1f83d9abu32
    s.h7 = 0x5be0cd19u32
    s.block_len = 0usize
    s.total_len = 0u64
}

fn sha256_update(s: mut_view<Sha256State>, data: *const u8, byte_count: usize) {
    if byte_count == 0usize || (data as usize) == 0usize { return }
    s.total_len = s.total_len + (byte_count as u64)
    let mut i: usize = 0usize
    while i < byte_count {
        s.block[s.block_len] = unsafe { *(data + i) }
        s.block_len = s.block_len + 1usize
        if s.block_len == 64usize {
            sha256_process(mut_view(*s))
            s.block_len = 0usize
        }
        i = i + 1usize
    }
}

fn sha256_final(s: mut_view<Sha256State>, out_d: mut_view<Sha256Digest>) {
    let bit_len = s.total_len * 8u64
    s.block[s.block_len] = 0x80u8
    s.block_len = s.block_len + 1usize

    if s.block_len > 56usize {
        while (s.block_len) < 64usize {
            s.block[s.block_len] = 0u8
            s.block_len = s.block_len + 1usize
        }
        sha256_process(mut_view(*s))
        s.block_len = 0usize
    }

    while (s.block_len) < 56usize {
        s.block[s.block_len] = 0u8
        s.block_len = s.block_len + 1usize
    }

    let mut k: usize = 0usize
    while k < 8usize {
        let shift = ((56usize - k * 8usize) as u32)
        s.block[56usize + k] = ((bit_len >> shift) & 0xFFu64) as u8
        k = k + 1usize
    }
    sha256_process(mut_view(*s))

    let mut h_idx: usize = 0usize
    while h_idx < 8usize {
        let h_val = match h_idx {
            0usize => s.h0
            1usize => s.h1
            2usize => s.h2
            3usize => s.h3
            4usize => s.h4
            5usize => s.h5
            6usize => s.h6
            _ => s.h7
        }
        out_d.bytes[h_idx * 4usize] = (h_val >> 24u32) as u8
        out_d.bytes[h_idx * 4usize + 1usize] = (h_val >> 16u32) as u8
        out_d.bytes[h_idx * 4usize + 2usize] = (h_val >> 8u32) as u8
        out_d.bytes[h_idx * 4usize + 3usize] = h_val as u8
        h_idx = h_idx + 1usize
    }
}

fn compute_leaf_hash(path: view<[u8]>, mode: u8, size: u64, payload_digest: view<Sha256Digest>) -> Sha256Digest {
    let mut st = Sha256State {
        h0: 0u32, h1: 0u32, h2: 0u32, h3: 0u32,
        h4: 0u32, h5: 0u32, h6: 0u32, h7: 0u32,
        block: [0u8; 64], block_len: 0usize, total_len: 0u64,
    }
    let mut d = sha256_digest_zero()
    sha256_init(mut_view(st))

    let pfx: [14]u8 = [65u8, 88u8, 80u8, 75u8, 71u8, 45u8, 76u8, 69u8, 65u8, 70u8, 45u8, 118u8, 49u8, 0u8]
    sha256_update(mut_view(st), unsafe { address_of(pfx[0]) }, 14usize)

    let mut le_plen: [4]u8 = [0u8; 4]
    let plen = len(path) as u32
    le_plen[0] = (plen & 0xFFu32) as u8
    le_plen[1] = ((plen >> 8u32) & 0xFFu32) as u8
    le_plen[2] = ((plen >> 16u32) & 0xFFu32) as u8
    le_plen[3] = ((plen >> 24u32) & 0xFFu32) as u8
    sha256_update(mut_view(st), unsafe { address_of(le_plen[0]) }, 4usize)

    sha256_update(mut_view(st), unsafe { address_of(path[0]) }, len(path))

    let m_b: [1]u8 = [mode]
    sha256_update(mut_view(st), unsafe { address_of(m_b[0]) }, 1usize)

    let mut le_sz: [8]u8 = [0u8; 8]
    let mut k: usize = 0usize
    while k < 8usize {
        le_sz[k] = ((size >> ((k * 8usize) as u32)) & 0xFFu64) as u8
        k = k + 1usize
    }
    sha256_update(mut_view(st), unsafe { address_of(le_sz[0]) }, 8usize)

    sha256_update(mut_view(st), unsafe { address_of(payload_digest.bytes[0]) }, 32usize)
    sha256_final(mut_view(st), mut_view(d))
    d
}

fn compute_node_hash(left: view<Sha256Digest>, right: view<Sha256Digest>) -> Sha256Digest {
    let mut st = Sha256State {
        h0: 0u32, h1: 0u32, h2: 0u32, h3: 0u32,
        h4: 0u32, h5: 0u32, h6: 0u32, h7: 0u32,
        block: [0u8; 64], block_len: 0usize, total_len: 0u64,
    }
    let mut d = sha256_digest_zero()
    sha256_init(mut_view(st))

    let pfx: [14]u8 = [65u8, 88u8, 80u8, 75u8, 71u8, 45u8, 78u8, 79u8, 68u8, 69u8, 45u8, 118u8, 49u8, 0u8]
    sha256_update(mut_view(st), unsafe { address_of(pfx[0]) }, 14usize)
    sha256_update(mut_view(st), unsafe { address_of(left.bytes[0]) }, 32usize)
    sha256_update(mut_view(st), unsafe { address_of(right.bytes[0]) }, 32usize)
    sha256_final(mut_view(st), mut_view(d))
    d
}

fn is_path_safe(p: view<[u8]>) -> bool {
    let n = len(p)
    if n == 0usize { return false }
    if p[0] == 47u8 || p[0] == 92u8 { return false }
    if n >= 2usize && p[1] == 58u8 { return false }
    let mut i: usize = 0usize
    while i < n {
        let b = p[i]
        if b == 92u8 || b < 32u8 || b == 127u8 { return false }
        if b == 46u8 {
            let prev_sep = i == 0usize || p[i - 1usize] == 47u8
            if prev_sep {
                if (i + 1usize) == n || p[i + 1usize] == 47u8 { return false }
                if p[i + 1usize] == 46u8 {
                    if (i + 2usize) == n || p[i + 2usize] == 47u8 { return false }
                }
            }
        }
        i = i + 1usize
    }
    true
}

pub fn main() -> i32 {
    // 1. Path traversal defense checks
    let bad1: [14]u8 = [46u8, 46u8, 47u8, 115u8, 101u8, 99u8, 114u8, 101u8, 116u8, 46u8, 116u8, 120u8, 116u8, 0u8] // "../secret.txt"
    let bad2: [11]u8 = [47u8, 101u8, 116u8, 99u8, 47u8, 112u8, 97u8, 115u8, 115u8, 119u8, 100u8] // "/etc/passwd"
    let bad3: [14]u8 = [67u8, 58u8, 92u8, 119u8, 105u8, 110u8, 100u8, 111u8, 119u8, 115u8, 92u8, 115u8, 121u8, 115u8] // "C:\windows\sys"
    let good1: [10]u8 = [115u8, 114u8, 99u8, 47u8, 108u8, 105u8, 98u8, 46u8, 97u8, 120u8] // "src/lib.ax"
    let good2: [10]u8 = [97u8, 120u8, 105u8, 111u8, 109u8, 46u8, 116u8, 111u8, 109u8, 108u8] // "axiom.toml"

    if is_path_safe(view(bad1)) || is_path_safe(view(bad2)) || is_path_safe(view(bad3)) {
        return 1
    }
    if !is_path_safe(view(good1)) || !is_path_safe(view(good2)) {
        return 2
    }

    // 2. Compute SHA-256 leaves for 2 files
    let dummy_sha = sha256_digest_zero()
    let leaf1 = compute_leaf_hash(view(good1), 0u8, 42u64, view(dummy_sha))
    let leaf2 = compute_leaf_hash(view(good2), 0u8, 100u64, view(dummy_sha))

    if sha256_digest_eq(view(leaf1), view(leaf2)) {
        return 3
    }

    // 3. Tree reduction & Merkle root
    let root = compute_node_hash(view(leaf1), view(leaf2))

    // 4. Tamper detection: modifying 1 bit of leaf1 changes root
    let mut tampered_leaf = leaf1
    tampered_leaf.bytes[0] = tampered_leaf.bytes[0] ^ 1u8
    let tampered_root = compute_node_hash(view(tampered_leaf), view(leaf2))

    if sha256_digest_eq(view(root), view(tampered_root)) {
        return 4
    }

    print("ARCHIVE-DETERMINISTIC-AND-MERKLE-OK\n")
    0
}
