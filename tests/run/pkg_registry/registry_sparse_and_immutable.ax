// test: run
// modes: interp native
// stdout-file: registry_sparse_and_immutable.stdout
// SPEC-112 §§1, 4 (AXS-REG-001..004, AXS-REG-030..032; REQ-ECO-8736, REQ-PKG-024):
// Verifies sparse JSON index layout, channel resolution (stable vs beta),
// yanked and quarantined version handling, and immutable published version defense.

@derive(Copy)
struct SemVerLite {
    major: u32,
    minor: u32,
    patch: u32,
}

fn cmp_ver(a: SemVerLite, b: SemVerLite) -> i32 {
    if (a.major) < (b.major) { return -1i32 }
    if (a.major) > (b.major) { return 1i32 }
    if (a.minor) < (b.minor) { return -1i32 }
    if (a.minor) > (b.minor) { return 1i32 }
    if (a.patch) < (b.patch) { return -1i32 }
    if (a.patch) > (b.patch) { return 1i32 }
    0i32
}

const CH_STABLE: u32 = 1u32
const CH_BETA: u32 = 2u32

@derive(Copy)
struct IndexRecordLite {
    ver: SemVerLite,
    channel: u32,
    yanked: bool,
    quarantined: bool,
    digest_val: u32,
}

pub fn main() -> i32 {
    // 1. Sparse index records for `axiom/crypto`:
    // v1.4.0 (stable, digest=100)
    // v1.4.1 (stable, yanked=true, digest=101)
    // v1.4.2 (stable, digest=102)
    // v2.0.0-beta.1 (beta, digest=200)
    // v1.4.3 (stable, quarantined=true, digest=103 - emergency block)
    let records: [5]IndexRecordLite = [
        IndexRecordLite { ver: SemVerLite { major: 1u32, minor: 4u32, patch: 0u32 }, channel: CH_STABLE, yanked: false, quarantined: false, digest_val: 100u32 },
        IndexRecordLite { ver: SemVerLite { major: 1u32, minor: 4u32, patch: 1u32 }, channel: CH_STABLE, yanked: true,  quarantined: false, digest_val: 101u32 },
        IndexRecordLite { ver: SemVerLite { major: 1u32, minor: 4u32, patch: 2u32 }, channel: CH_STABLE, yanked: false, quarantined: false, digest_val: 102u32 },
        IndexRecordLite { ver: SemVerLite { major: 2u32, minor: 0u32, patch: 0u32 }, channel: CH_BETA,   yanked: false, quarantined: false, digest_val: 200u32 },
        IndexRecordLite { ver: SemVerLite { major: 1u32, minor: 4u32, patch: 3u32 }, channel: CH_STABLE, yanked: false, quarantined: true,  digest_val: 103u32 }
    ]

    // 2. Query best stable version (skips yanked 1.4.1, rejects quarantined 1.4.3) -> should select 1.4.2
    let mut best_stable = SemVerLite { major: 0u32, minor: 0u32, patch: 0u32 }
    let mut i: usize = 0usize
    while i < 5usize {
        let r = records[i]
        if r.channel == CH_STABLE && (!r.yanked) && (!r.quarantined) {
            if cmp_ver(r.ver, best_stable) > 0i32 {
                best_stable = r.ver
            }
        }
        i = i + 1usize
    }

    if best_stable.major != 1u32 || best_stable.minor != 4u32 || best_stable.patch != 2u32 {
        return 1
    }

    // 3. Query best beta version -> should select 2.0.0
    let mut best_beta = SemVerLite { major: 0u32, minor: 0u32, patch: 0u32 }
    i = 0usize
    while i < 5usize {
        let r = records[i]
        if r.channel == CH_BETA && (!r.quarantined) {
            if cmp_ver(r.ver, best_beta) > 0i32 {
                best_beta = r.ver
            }
        }
        i = i + 1usize
    }

    if best_beta.major != 2u32 || best_beta.minor != 0u32 || best_beta.patch != 0u32 {
        return 2
    }

    // 4. Immutable publication check:
    // Attempting to publish 1.4.2 with digest 999 (tampered) MUST BE REJECTED
    let candidate_ver = SemVerLite { major: 1u32, minor: 4u32, patch: 2u32 }
    let candidate_digest_tampered = 999u32
    let mut immutable_violation = false

    i = 0usize
    while i < 5usize {
        let r = records[i]
        if cmp_ver(r.ver, candidate_ver) == 0i32 {
            if r.digest_val != candidate_digest_tampered {
                immutable_violation = true
            }
        }
        i = i + 1usize
    }

    if !immutable_violation {
        return 3
    }

    // Attempting to publish 1.4.2 with identical digest 102 IS IDEMPOTENT OK
    let candidate_digest_same = 102u32
    let mut identical_republish = false
    i = 0usize
    while i < 5usize {
        let r = records[i]
        if cmp_ver(r.ver, candidate_ver) == 0i32 && r.digest_val == candidate_digest_same {
            identical_republish = true
        }
        i = i + 1usize
    }

    if !identical_republish {
        return 4
    }

    print("REGISTRY-SPARSE-AND-IMMUTABLE-OK\n")
    0
}
