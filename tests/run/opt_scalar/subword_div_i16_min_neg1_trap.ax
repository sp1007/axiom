// test: run
// exit: 101

fn dead_div_must_trap_i16(x: i16) -> i32 {
    let neg_one: i16 = -1i16;
    let unused_div: i16 = x / neg_one;
    let _ = unused_div;
    0
}

fn runtime_i16_min(seed: i32) -> i16 {
    if seed > 0 {
        -32767i16 - 1i16
    } else {
        42i16
    }
}

fn main() -> i32 {
    let m: i16 = runtime_i16_min(1);
    dead_div_must_trap_i16(m)
}
