// test: run
// exit: 101

fn dead_rem_must_trap_i32(x: i32) -> i32 {
    let neg_one: i32 = -1;
    let unused_rem: i32 = x % neg_one;
    let _ = unused_rem;
    0
}

fn runtime_i32_min(seed: i32) -> i32 {
    if seed > 0 {
        -2147483647 - 1
    } else {
        42
    }
}

fn main() -> i32 {
    let m: i32 = runtime_i32_min(1);
    dead_rem_must_trap_i32(m)
}
