// test: run
// exit: 101

fn dead_div_must_trap_i8(x: i8) -> i32 {
    let neg_one: i8 = -1i8;
    let unused_div: i8 = x / neg_one;
    let _ = unused_div;
    0
}

fn runtime_i8_min(seed: i32) -> i8 {
    if seed > 0 {
        -127i8 - 1i8
    } else {
        12i8
    }
}

fn main() -> i32 {
    let m: i8 = runtime_i8_min(1);
    dead_div_must_trap_i8(m)
}
