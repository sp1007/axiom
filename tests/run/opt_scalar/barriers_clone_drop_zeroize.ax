// test: run
// stdout: BANNER=Xin chào bảo mật\nCLONE=1\nCLONE=2\nDROP=3\nDROP=2\nZEROED_SUM=0\nDROP=1\nDONE=42\n

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_write_bytes<T>(dst: *mut T, val: u8, count: usize) {}

struct AuditGuard {
    id: i32,
}

impl Drop for AuditGuard {
    fn drop(self: mut_view<AuditGuard>) {
        print("DROP=");
        print_int(self.id);
        print("\n");
    }
}

struct SecretToken {
    code: i32,
}

struct SecretKeyBuf {
    b0: u8,
    b1: u8,
    b2: u8,
    b3: u8,
}

fn explicit_clone_token(src: view<SecretToken>, clones: mut_view<i32>) -> SecretToken {
    *clones = *clones + 1;
    print("CLONE=");
    print_int(*clones);
    print("\n");
    SecretToken { code: src.code }
}

fn run_barriers_clone_drop_zeroize() -> i32 {
    print("BANNER=Xin chào bảo mật\n");
    let g1 = AuditGuard { id: 1 };
    let mut clone_count: i32 = 0;
    let tok = SecretToken { code: 40 };

    // Result of first explicit clone is intentionally unused; side effect must be preserved (REQ-OPT-306).
    let unused_clone = explicit_clone_token(view(tok), mut_view(clone_count));
    let _ = unused_clone.code;
    let used_clone = explicit_clone_token(view(tok), mut_view(clone_count));

    // Unobservable Move/Copy temporary chain must not alter Drop ordering (REQ-OPT-304, REQ-OPT-305).
    let moved_a: i32 = used_clone.code;
    let moved_b: i32 = moved_a;

    let mut zeroed_sum: i32 = 99;
    {
        let g2 = AuditGuard { id: 2 };
        let g3 = AuditGuard { id: 3 };
        let mut secret_key = SecretKeyBuf { b0: 170u8, b1: 187u8, b2: 204u8, b3: 221u8 };
        let mut raw_slot: i32 = 10;
        let rp: *mut i32 = unsafe { address_of_mut(raw_slot) };
        unsafe {
            *rp = *rp + 5;
        }
        unsafe {
            let wipe_ptr: *mut u8 = address_of_mut(secret_key) as *mut u8;
            ptr_write_bytes<u8>(wipe_ptr, 0u8, 4);
        }
        let read_ptr: *const u8 = unsafe { address_of(secret_key) as *const u8 };
        let b0: i32 = unsafe { (*read_ptr) as i32 };
        let b1: i32 = unsafe { (*(read_ptr + 1)) as i32 };
        let b2: i32 = unsafe { (*(read_ptr + 2)) as i32 };
        let b3: i32 = unsafe { (*(read_ptr + 3)) as i32 };
        zeroed_sum = b0 + b1 + b2 + b3;
        let _ = g2.id + g3.id + raw_slot;
    }

    print("ZEROED_SUM=");
    print_int(zeroed_sum);
    print("\n");

    let _ = g1.id;
    moved_b + clone_count + zeroed_sum
}

fn main() -> i32 {
    let res = run_barriers_clone_drop_zeroize();
    print("DONE=");
    print_int(res);
    print("\n");
    if res != 42 {
        return 1;
    }
    0
}
