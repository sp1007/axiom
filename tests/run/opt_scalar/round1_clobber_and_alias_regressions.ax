// test: run
// stdout: R1_CLOBBER=1009\nR1_ADDR_OVERWRITE=55\nR1_SUBWORD_SAFE=50900\nR1_TOTAL=51964\n

@intrinsic fn wrapping_add_i32(a: i32, b: i32) -> i32 { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

fn pure_mix(a: i32) -> i32 {
    (a * 3) ^ 7
}

fn loop_backedge_param_and_call_clobber(mut p: i32, p_fixed: i32, steps: i32) -> i32 {
    let mut c: i32 = pure_mix(p);
    let mut k: i32 = 0;
    while k < steps {
        if k == 0 {
            c = 500;
            p = 20;
        }
        k = k + 1;
    }
    let c2: i32 = pure_mix(10);
    let c3: i32 = pure_mix(p);

    let mut d: i32 = pure_mix(p_fixed);
    let mut m: i32 = 0;
    while m < steps {
        if m == 0 {
            d = 400;
        }
        m = m + 1;
    }
    let d2: i32 = pure_mix(p_fixed);
    c + c2 + c3 + d + d2
}

fn addr_taken_const_and_runtime_overwrite(seed: i32) -> i32 {
    let mut a: i32 = 10;
    let pa: *const i32 = unsafe { address_of(a) };
    let before_a: i32 = unsafe { *pa };
    a = wrapping_add_i32(2, 3);
    let direct_a: i32 = a;
    let via_ptr_a: i32 = unsafe { *pa };

    let mut b: i32 = 10;
    let pb: *const i32 = unsafe { address_of(b) };
    b = wrapping_add_i32(seed, 5);
    let via_ptr_b: i32 = unsafe { *pb };
    b = 0;

    before_a + direct_a + via_ptr_a + via_ptr_b + b
}

fn subword_safe_div_rem(x8: i8, x16: i16, x32: i32, d8: i8, d16: i16, d32: i32) -> i32 {
    let q8: i8 = x8 / d8;
    let r8: i8 = 127i8 % d8;
    let q16: i16 = x16 / d16;
    let q32: i32 = x32 / d32;
    (q8 as i32) + (r8 as i32) + (q16 as i32) + q32
}

fn main() -> i32 {
    let r1: i32 = loop_backedge_param_and_call_clobber(10, 10, 2);
    print("R1_CLOBBER=");
    print_int(r1);
    print("\n");

    let r2: i32 = addr_taken_const_and_runtime_overwrite(30);
    print("R1_ADDR_OVERWRITE=");
    print_int(r2);
    print("\n");

    let r3: i32 = subword_safe_div_rem(100i8, -1000i16, -50000, -1i8, -1i16, -1);
    print("R1_SUBWORD_SAFE=");
    print_int(r3);
    print("\n");

    let total: i32 = r1 + r2 + r3;
    print("R1_TOTAL=");
    print_int(total);
    print("\n");

    if total != 51964 {
        return 1;
    }
    0
}
