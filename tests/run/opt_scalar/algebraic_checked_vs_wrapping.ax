// test: run
// stdout: WRAP_OK=4\nWRAP_REASSOC=5032704\nCHECKED_ID=105\nNONZERO_DIV=50\n

@intrinsic fn wrapping_add_i32(a: i32, b: i32) -> i32 { 0 }
@intrinsic fn wrapping_sub_i32(a: i32, b: i32) -> i32 { 0 }
@intrinsic fn wrapping_mul_i32(a: i32, b: i32) -> i32 { 0 }

fn check_wrapping_pair(x: i32, y: i32) -> i32 {
    let r1: i32 = wrapping_sub_i32(wrapping_add_i32(x, y), y);
    let r2: i32 = wrapping_add_i32(wrapping_sub_i32(x, y), y);
    let r3: i32 = wrapping_add_i32(x, 0);
    let r4: i32 = wrapping_mul_i32(x, 1);
    let r5: i32 = wrapping_mul_i32(x, 0);
    if r1 != x || r2 != x || r3 != x || r4 != x || r5 != 0 {
        return 0;
    }
    1
}

fn check_wrapping_reassoc(x: i32) -> i32 {
    wrapping_add_i32(wrapping_add_i32(x, 2000000000), 2000000000)
}

fn check_discrete_identities(x: i32, flag: bool) -> i32 {
    let a: i32 = (0 + x) + 0;
    let b: i32 = (x - 0) * 1;
    let c: i32 = (1 * x) / 1;
    let z1: i32 = (x * 0) + (0 * x) + (x % 1) + (x - x) + (x ^ x);
    let bw: i32 = ((x & x) | x) ^ 0;
    let inv_b: bool = !(!flag);
    let inv_x: i32 = ~(~x);
    let cmp_ok: i32 = if (x == x) && !(x != x) && (x <= x) && !(x < x) && inv_b {
        10
    } else {
        0
    };
    let dead_tmp1: i32 = (a + b) ^ (c + bw);
    let dead_tmp2: i32 = dead_tmp1;
    let _ = dead_tmp2;
    a + b + c + z1 + bw + inv_x + cmp_ok
}

fn check_nonzero_self_div_rem(nz: i32) -> i32 {
    if nz != 0 {
        return (nz / nz) * 50 + (nz % nz);
    }
    0
}

fn main() -> i32 {
    let i32_max: i32 = 2147483647;
    let i32_min: i32 = -2147483647 - 1;
    let wrap_ok: i32 =
        check_wrapping_pair(i32_max, 1) +
        check_wrapping_pair(i32_min, 1) +
        check_wrapping_pair(0, -1) +
        check_wrapping_pair(-1, i32_max);
    print("WRAP_OK=");
    print_int(wrap_ok);
    print("\n");

    let reassoc: i32 = check_wrapping_reassoc(300000000);
    print("WRAP_REASSOC=");
    print_int(reassoc);
    print("\n");

    let cid: i32 = check_discrete_identities(19, true);
    print("CHECKED_ID=");
    print_int(cid);
    print("\n");

    let nz_res: i32 = check_nonzero_self_div_rem(-37);
    print("NONZERO_DIV=");
    print_int(nz_res);
    print("\n");

    if wrap_ok != 4 || reassoc != 5032704 || cid != 105 || nz_res != 50 {
        return 1;
    }
    0
}
