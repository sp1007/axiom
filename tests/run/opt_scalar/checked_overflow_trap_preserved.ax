fn checked_add_then_sub(x: i32, y: i32) -> i32 {
    let sum: i32 = x + y;
    sum - y
}

fn runtime_i32_max(seed: i32) -> i32 {
    if seed > 0 {
        2147483647
    } else {
        10
    }
}

fn main() -> i32 {
    let x: i32 = runtime_i32_max(1);
    let r: i32 = checked_add_then_sub(x, 1);
    if r == x {
        return 0;
    }
    2
}
