// test: run
// stdout: QA_BANNER=Xin chào biên vô hướng\nSIBLING_GVN=128\nLOOP_CLOBBER=922\nADDR_ARITH=60\nRAW_INTERVENING=73\nSUBWORD_DIV=32576\nQA_TOTAL=33759\n

@intrinsic fn wrapping_add_i32(a: i32, b: i32) -> i32 { 0 }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

fn pure_helper(x: i32, y: i32) -> i32 {
    (x | y) + (x ^ y)
}

fn sibling_non_dominating_cse(a: i32, b: i32, flag: bool) -> i32 {
    let mut left_only: i32 = 0;
    if flag {
        left_only = (a * 7) + (b * 3);
    } else {
        left_only = (a * 5) - b;
    }
    let after: i32 = (a * 7) + (b * 3);
    left_only + after
}

fn loop_backedge_clobber_guard(x: i32, y: i32) -> i32 {
    let mut cached: i32 = pure_helper(x, y);
    let mut i: i32 = 0;
    while i < 2 {
        if i == 0 {
            cached = 900;
        }
        i = i + 1;
    }
    let recomputed: i32 = pure_helper(x, y);
    cached + recomputed
}

fn addr_taken_arith_overwrite_and_view_read(seed: i32) -> i32 {
    let mut slot: i32 = 10;
    let v1: view<i32> = view(slot);
    let r1: i32 = *v1;
    slot = wrapping_add_i32(seed, 5);
    let v2: view<i32> = view(slot);
    let r2: i32 = *v2;
    let r3: i32 = slot;
    slot = 0;
    r1 + r2 + r3 + slot
}

fn raw_ptr_store_between_stack_store_and_load() -> i32 {
    let mut x: i32 = 40;
    let p: *mut i32 = unsafe { address_of_mut(x) };
    x = 15;
    unsafe {
        *p = 73;
    }
    let loaded: i32 = x;
    loaded
}

fn signed_subword_div_boundaries(neg_one_i8: i8, neg_one_i16: i16) -> i32 {
    let min_i8: i8 = -127i8 - 1i8;
    let half_i8: i8 = min_i8 / 2i8;
    let max_div_neg1_i8: i8 = 127i8 / neg_one_i8;
    let max_div_neg1_i16: i16 = 32767i16 / neg_one_i16;
    (half_i8 as i32) + (max_div_neg1_i8 as i32) - (max_div_neg1_i16 as i32)
}

fn main() -> i32 {
    print("QA_BANNER=Xin chào biên vô hướng\n");

    let r1: i32 = sibling_non_dominating_cse(10, 4, false);
    print("SIBLING_GVN=");
    print_int(r1);
    print("\n");

    let r2: i32 = loop_backedge_clobber_guard(12, 5);
    print("LOOP_CLOBBER=");
    print_int(r2);
    print("\n");

    let r3: i32 = addr_taken_arith_overwrite_and_view_read(20);
    print("ADDR_ARITH=");
    print_int(r3);
    print("\n");

    let r4: i32 = raw_ptr_store_between_stack_store_and_load();
    print("RAW_INTERVENING=");
    print_int(r4);
    print("\n");

    let r5: i32 = signed_subword_div_boundaries(-1i8, -1i16);
    print("SUBWORD_DIV=");
    print_int(r5);
    print("\n");

    let total: i32 = r1 + r2 + r3 + r4 + r5;
    print("QA_TOTAL=");
    print_int(total);
    print("\n");

    if total != 33759 {
        return 1;
    }
    0
}
