// test: run
// stdout: GVN_CSE=604\nNOALIAS_VIEW=130\nRAW_PTR_ALIAS=110\nGVN_TOTAL=844\n

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct Pair {
    left: i32,
    right: i32,
}

fn cse_commutative_and_clobber(a: i32, b: i32, take_left: bool) -> i32 {
    let sum1: i32 = a + b;
    let prod1: i32 = a * b;
    let mut clobbered: i32 = a ^ b;
    clobbered = 500;
    let mut branch_res: i32 = 0;
    if take_left {
        let sum2: i32 = b + a;
        let xor_re: i32 = b ^ a;
        branch_res = sum2 + xor_re;
    } else {
        let prod2: i32 = b * a;
        branch_res = prod2;
    }
    sum1 + prod1 + clobbered + branch_res
}

fn view_noalias_forwarding(src: view<Pair>, dst: mut_view<Pair>) -> i32 {
    let first: i32 = src.left + src.right;
    dst.left = 90;
    dst.right = 110;
    let second: i32 = src.left + src.right;
    first + second + dst.left
}

fn raw_ptr_unknown_alias_reload() -> i32 {
    let mut slot: i32 = 33;
    let p: *mut i32 = unsafe { address_of_mut(slot) };
    let q: *mut i32 = p;
    let before: i32 = unsafe { *p };
    unsafe {
        *q = 77;
    }
    let after: i32 = unsafe { *p };
    before + after
}

fn main() -> i32 {
    let gvn_val = cse_commutative_and_clobber(6, 10, true);
    print("GVN_CSE=");
    print_int(gvn_val);
    print("\n");

    let src_pair = Pair { left: 12, right: 8 };
    let mut dst_pair = Pair { left: 1, right: 2 };
    let noalias_val = view_noalias_forwarding(view(src_pair), mut_view(dst_pair));
    print("NOALIAS_VIEW=");
    print_int(noalias_val);
    print("\n");

    let raw_val = raw_ptr_unknown_alias_reload();
    print("RAW_PTR_ALIAS=");
    print_int(raw_val);
    print("\n");

    let total = gvn_val + noalias_val + raw_val;
    print("GVN_TOTAL=");
    print_int(total);
    print("\n");

    if total != 844 {
        return 1;
    }
    0
}
