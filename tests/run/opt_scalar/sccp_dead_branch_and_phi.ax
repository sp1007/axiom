// test: run
// stdout: SCCP_DIAMOND=123\nSCCP_CAST_SWITCH=354\nSCCP_LOOP_PHI=35\nSCCP_TOTAL=512\n

fn sccp_diamond_and_unexecuted_div_zero() -> i32 {
    let seed: i32 = 12;
    let sel: i32 = (seed * 3) + 6;
    let mut phi_a: i32 = 0;
    let mut phi_b: i32 = 0;
    if sel == 42 {
        phi_a = 100;
        phi_b = 7;
    } else {
        let zero: i32 = sel - sel;
        phi_a = 100 / zero;
        phi_b = 999;
    }
    let joined: i32 = if phi_b == 7 {
        phi_a + 23
    } else {
        100 / (phi_b - 7)
    };
    joined
}

fn sccp_switch_and_casts() -> i32 {
    let raw_u8: u8 = 250u8;
    let widened_u: i32 = raw_u8 as i32;
    let reinterp_i8: i8 = raw_u8 as i8;
    let widened_s: i32 = reinterp_i8 as i32;
    let neg_shift: i32 = (-64) >> 2;
    let pos_shift: i64 = 3i64 << 5i64;
    let arm: i32 = match widened_s {
        0 => 11,
        -6 => 30,
        _ => 99,
    };
    widened_u + widened_s + neg_shift + (pos_shift as i32) + arm
}

fn sccp_loop_invariant_phi() -> i32 {
    let mut i: i32 = 0;
    let mut keep: bool = true;
    let mut acc: i32 = 0;
    while i < 5 {
        if keep {
            acc = acc + (i * 2 + 1);
        } else {
            let z: i32 = 0;
            acc = 50 / z;
            keep = false;
        }
        i = i + 1;
    }
    if keep {
        acc + 10
    } else {
        0
    }
}

fn main() -> i32 {
    let r1 = sccp_diamond_and_unexecuted_div_zero();
    print("SCCP_DIAMOND=");
    print_int(r1);
    print("\n");

    let r2 = sccp_switch_and_casts();
    print("SCCP_CAST_SWITCH=");
    print_int(r2);
    print("\n");

    let r3 = sccp_loop_invariant_phi();
    print("SCCP_LOOP_PHI=");
    print_int(r3);
    print("\n");

    let total = r1 + r2 + r3;
    print("SCCP_TOTAL=");
    print_int(total);
    print("\n");

    if total != 512 {
        return 1;
    }
    0
}
