// test: run
// modes: interp native
// stdout-file: sandbox_filesystem_env_network_clock_isolation.stdout
// SPEC-113 §2 (AXS-HERM-010..015, REQ-PKG-022, REQ-PKG-024, INV-HERM-001):
// Verifies sandbox rejection of filesystem path escapes (../, absolute host paths,
// source-dir writes), undeclared env reads, network access, and unauthorized subprocesses.

@intrinsic
fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }

const FS_PERM_DENIED: u8 = 0u8
const FS_PERM_READ: u8 = 1u8
const FS_PERM_READ_WRITE: u8 = 2u8
const FS_PERM_READ_WRITE_CREATE: u8 = 3u8

const FS_OP_READ: u8 = 0u8
const FS_OP_WRITE: u8 = 1u8
const FS_OP_CREATE: u8 = 2u8

const NET_DENIED: u8 = 0u8
const PROC_DENIED: u8 = 0u8

const CLOCK_FROZEN: u8 = 0u8
const RNG_DETERMINISTIC: u8 = 0u8

@derive(Copy)
struct MountDecl {
    mount_id: u8,
    perm: u8,
    is_active: bool,
}

fn check_fs_access(
    mount_id: u8,
    perm: u8,
    op: u8,
    has_traversal_escape: bool,
    is_unauthorized_host_path: bool
) -> bool {
    if has_traversal_escape || is_unauthorized_host_path {
        return false
    }
    if op == FS_OP_READ {
        return perm >= FS_PERM_READ
    }
    if op == FS_OP_WRITE || op == FS_OP_CREATE {
        // Writes strictly forbidden in source (0) and dependencies (1)
        if mount_id == 0u8 || mount_id == 1u8 {
            return false
        }
        return perm >= FS_PERM_READ_WRITE
    }
    false
}

fn check_env_read(is_canonical: bool, is_allowlisted: bool, is_path: bool) -> bool {
    if is_path {
        return true // PATH is allowed but yields empty string ""
    }
    is_canonical || is_allowlisted
}

fn check_net_access(net_policy: u8) -> bool {
    net_policy != NET_DENIED
}

fn check_process_spawn(proc_policy: u8) -> bool {
    proc_policy != PROC_DENIED
}

fn check_clock_query(is_host_clock: bool, clock_policy: u8) -> bool {
    if is_host_clock {
        return false // Host wall-clock strictly forbidden in hermetic build
    }
    clock_policy == CLOCK_FROZEN
}

fn check_rng_query(is_os_entropy: bool, rng_policy: u8) -> bool {
    if is_os_entropy {
        return false // OS entropy / dev/urandom strictly forbidden in hermetic build
    }
    rng_policy == RNG_DETERMINISTIC
}

pub fn main() -> i32 {
    // 1. Filesystem Mount & Path Escape Defense
    let m_src = MountDecl { mount_id: 0u8, perm: FS_PERM_READ, is_active: true }
    let m_dep = MountDecl { mount_id: 1u8, perm: FS_PERM_READ, is_active: true }
    let m_out = MountDecl { mount_id: 2u8, perm: FS_PERM_READ_WRITE_CREATE, is_active: true }
    let m_bld = MountDecl { mount_id: 3u8, perm: FS_PERM_READ_WRITE, is_active: true }

    let ok_read_src = check_fs_access(m_src.mount_id, m_src.perm, FS_OP_READ, false, false)
    let ok_read_dep = check_fs_access(m_dep.mount_id, m_dep.perm, FS_OP_READ, false, false)
    let ok_write_out = check_fs_access(m_out.mount_id, m_out.perm, FS_OP_WRITE, false, false)
    let ok_write_bld = check_fs_access(m_bld.mount_id, m_bld.perm, FS_OP_WRITE, false, false)

    let bad_traversal = check_fs_access(m_src.mount_id, m_src.perm, FS_OP_READ, true, false)
    let bad_host_path = check_fs_access(m_src.mount_id, m_src.perm, FS_OP_READ, false, true)
    let bad_write_src = check_fs_access(m_src.mount_id, m_src.perm, FS_OP_WRITE, false, false)
    let bad_write_dep = check_fs_access(m_dep.mount_id, m_dep.perm, FS_OP_WRITE, false, false)

    let fs_ok = ok_read_src && ok_read_dep && ok_write_out && ok_write_bld &&
                !bad_traversal && !bad_host_path && !bad_write_src && !bad_write_dep

    // 2. Sanitized Environment Allowlist
    let ok_canonical = check_env_read(true, false, false)
    let ok_allowlisted = check_env_read(false, true, false)
    let ok_path_scrubbed = check_env_read(false, false, true)
    let bad_undeclared_env = check_env_read(false, false, false)

    let env_ok = ok_canonical && ok_allowlisted && ok_path_scrubbed && !bad_undeclared_env

    // 3. Network & Subprocess Confinement
    let bad_net = check_net_access(NET_DENIED)
    let bad_proc = check_process_spawn(PROC_DENIED)
    let isolation_ok = !bad_net && !bad_proc

    // 4. Virtual Clock & Seeded Entropy
    let bad_host_clock = check_clock_query(true, CLOCK_FROZEN)
    let ok_virtual_clock = check_clock_query(false, CLOCK_FROZEN)
    let bad_os_entropy = check_rng_query(true, RNG_DETERMINISTIC)
    let ok_deterministic_rng = check_rng_query(false, RNG_DETERMINISTIC)

    let entropy_ok = !bad_host_clock && ok_virtual_clock && !bad_os_entropy && ok_deterministic_rng

    if !fs_ok || !env_ok || !isolation_ok || !entropy_ok {
        return 1
    }

    print("SANDBOX-FILESYSTEM-ENV-NETWORK-CLOCK-ISOLATION-OK\n")
    0
}
