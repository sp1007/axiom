// test: run
// exit: 0
// stdout: 0 3\n
// T498 / SPEC-10 AXS-OWN-003: the `[0]T` edge case of a Copy array is copied by binding and by argument
// and the source stays usable.

fn zl(a: [0]u32) -> usize {
    len(a)
}

fn main() -> i32 {
    let z: [0]u32 = [0u32; 0];
    let z2 = z;
    print_int((zl(z) + zl(z2) + len(z)) as i64);
    print(" ");
    let t: [3]u32 = [1, 1, 1];
    print_int((len(z2) + len(t)) as i64);
    print("\n");
    0
}
