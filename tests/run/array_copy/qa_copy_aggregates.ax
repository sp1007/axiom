// test: run
// exit: 0
// stdout: 7 7\n9 9\n4 4\n12 12\n
// QA (T498 gate): arrays of Copy aggregates (`@derive(Copy)` struct, tuple, enum and view) are Copy;
// each array is passed twice by value and bound twice, the source is untouched.

@derive(Copy)
struct P {
    x: i32,
    y: i32,
}

@derive(Copy)
enum K {
    A,
    B,
}

fn sp(a: [2]P) -> i32 {
    a[0].x + a[1].y
}

fn st(a: [2](i32, u8)) -> i32 {
    a[0].0 + (a[1].1 as i32)
}

fn sk(a: [3]K) -> i32 {
    let mut n: i32 = 0;
    let mut i: usize = 0;
    while i < 3 {
        n = n + match a[i] {
            K.A => 1,
            K.B => 2,
        };
        i = i + 1;
    }
    n
}

fn sv(a: [2]view<i32>) -> i32 {
    *a[0] + *a[1]
}

fn main() -> i32 {
    let ps: [2]P = [P { x: 3, y: 0 }, P { x: 0, y: 4 }];
    let ps2 = ps;
    print_int(sp(ps) as i64);
    print(" ");
    print_int(sp(ps2) as i64);
    print("\n");

    let ts: [2](i32, u8) = [(4, 1u8), (0, 5u8)];
    let ts2 = ts;
    print_int(st(ts) as i64);
    print(" ");
    print_int(st(ts2) as i64);
    print("\n");

    let ks: [3]K = [K.A, K.B, K.A];
    let ks2 = ks;
    print_int(sk(ks) as i64);
    print(" ");
    print_int(sk(ks2) as i64);
    print("\n");

    let mut p: i32 = 5;
    let mut q: i32 = 7;
    let vs: [2]view<i32> = [view(p), view(q)];
    let vs2 = vs;
    print_int(sv(vs) as i64);
    print(" ");
    print_int(sv(vs2) as i64);
    print("\n");

    0
}
