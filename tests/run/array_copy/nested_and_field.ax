// test: run
// exit: 0
// stdout: 21 21\n9 1\n30 30\n4 99\n
// T498 / SPEC-10 AXS-OWN-003: an array of arrays `[2][3]u8` and an array held in a struct field are Copy
// when the element is Copy; copies are independent of the source. (A [3]u16 field next to a u8 is avoided:
// native aggregate stores of 3/6-byte arrays are widened and clobber the neighbouring field, see the T498 report.)

struct Rec {
    tag: u8,
    vals: [4]u16,
}

fn total(g: [2][3]u8) -> u32 {
    let mut s: u32 = 0u32;
    let mut i: usize = 0;
    while i < 2 {
        let row = g[i];
        let mut j: usize = 0;
        while j < 3 {
            s = s + row[j] as u32;
            j = j + 1;
        }
        i = i + 1;
    }
    s
}

fn vsum(v: [4]u16) -> u16 {
    v[0] + v[1] + v[2] + v[3]
}

fn main() -> i32 {
    let g: [2][3]u8 = [[1, 2, 3], [4, 5, 6]];
    print_int(total(g) as i64);
    print(" ");
    print_int(total(g) as i64);
    print("\n");

    let mut h = g;
    h[0][0] = 9u8;
    let row0 = g[0];
    print_int(h[0][0] as i64);
    print(" ");
    print_int(row0[0] as i64);
    print("\n");

    let r = Rec { tag: 4u8, vals: [5, 10, 15, 0] };
    let v1 = r.vals;
    let v2 = r.vals;
    print_int(vsum(v1) as i64);
    print(" ");
    print_int(vsum(v2) as i64);
    print("\n");

    let mut v3 = r.vals;
    v3[1] = 99u16;
    print_int(r.tag as i64);
    print(" ");
    print_int((v3[1] + r.vals[1] - 10u16) as i64);
    print("\n");
    0
}
