// test: run
// exit: 0
// stdout: 3 3\n10 10\n6\n7 2\n1 2\n
// T498 / SPEC-10 AXS-OWN-003 (ADR-0044 section 3): `[N]T` with a Copy element is Copy. Copying into two
// bindings, passing the same array twice, returning a copy and mutating a copy all leave the source usable
// and unchanged.

fn sum3(a: [3]i32) -> i32 {
    a[0] + a[1] + a[2]
}

fn first(a: [2]u16) -> u16 {
    a[0]
}

fn dup(a: [2]u16) -> [2]u16 {
    let r = a;
    r
}

fn bump(a: [2]u16) -> [2]u16 {
    let mut m = a;
    m[0] = m[0] + 6u16;
    m
}

fn main() -> i32 {
    let a: [2]u16 = [1, 2];
    let b = a;
    let c = a;
    print_int((b[0] + b[1]) as i64);
    print(" ");
    print_int((c[0] + c[1]) as i64);
    print("\n");

    let t: [3]i32 = [2, 3, 5];
    print_int(sum3(t) as i64);
    print(" ");
    print_int(sum3(t) as i64);
    print("\n");

    let d = dup(a);
    print_int((first(d) + first(a) + d[1] + a[1]) as i64);
    print("\n");

    let mut m = a;
    m[0] = 7u16;
    let e = bump(a);
    print_int(m[0] as i64);
    print(" ");
    print_int(a[1] as i64);
    print("\n");
    print_int(a[0] as i64);
    print(" ");
    print_int((e[0] - 5u16) as i64);
    print("\n");
    0
}
