// test: run
// exit: 0
// stdout: 7\n7\n1\n2\nend\n5\n
// QA (T498 gate): an array of a Drop element type is not Copy and must keep MOVE semantics: it is moved
// into `b` and then into `eat`, so each element is dropped exactly once (no double drop). A Copy array field
// of a struct that also owns a Drop value can be read twice without moving the struct.

struct D {
    id: i32,
}

impl Drop for D {
    fn drop(self: mut_view<D>) {
        print_int(self.id as i64);
        print("\n");
    }
}

struct W {
    d: D,
    n: [2]u8,
}

fn eat(a: [2]D) {
}

fn main() -> i32 {
    let w = W { d: D { id: 5 }, n: [3u8, 4u8] };
    let n1 = w.n;
    let n2 = w.n;
    print_int((n1[0] + n1[1]) as i64);
    print("\n");
    print_int((n2[0] + n2[1]) as i64);
    print("\n");

    let a: [2]D = [D { id: 1 }, D { id: 2 }];
    let b = a;
    eat(b);
    print("end\n");
    0
}
