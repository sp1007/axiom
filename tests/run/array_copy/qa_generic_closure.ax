// test: run
// exit: 0
// stdout: 6\n6\n6\n3\n3\n4\n
// QA (T498 gate): a generic `[N]T` parameter instantiated with a Copy and with a non-Copy element type
// (the non-Copy instance is only moved once and read through one indexed field), an array captured by a closure and used again afterwards.

struct NC {
    v: i32,
}

fn pass<T>(a: [2]T) -> [2]T {
    a
}

fn sum3(a: [3]i32) -> i32 {
    a[0] + a[1] + a[2]
}

fn main() -> i32 {
    let t: [3]i32 = [1, 2, 3];
    let c = || sum3(t);
    print_int(c() as i64);
    print("\n");
    print_int(c() as i64);
    print("\n");
    print_int(sum3(t) as i64);
    print("\n");

    let u: [2]u8 = [1u8, 2u8];
    let u1 = pass(u);
    let u2 = pass(u);
    print_int((u1[0] + u1[1]) as i64);
    print("\n");
    print_int((u2[0] + u2[1]) as i64);
    print("\n");

    let n: [2]NC = [NC { v: 4 }, NC { v: 7 }];
    let m = pass(n);
    print_int(m[0].v as i64);
    print("\n");
    0
}
