// test: run
// exit: 0
// stdout: 1024 1024\n255 0\n7 7\n4096 4096\n
// T498 / SPEC-10 AXS-OWN-003: copying a 1 KiB `[1024]u8` into two bindings, a 4096-element `[4096]u8` and the
// `[1]T` edge case; the source stays intact after the copy is mutated. Large arrays are read through a view here to
// isolate local Copy-assignment semantics from by-value call-argument passing (covered in `tests/run/agg_arg_copies/`).

fn count_ones(a: view<[1024]u8>) -> u32 {
    let mut n: u32 = 0u32;
    let mut i: usize = 0;
    while i < 1024 {
        n = n + (*a)[i] as u32;
        i = i + 1;
    }
    n
}

fn big_sum(a: view<[4096]u8>) -> u32 {
    let mut n: u32 = 0u32;
    let mut i: usize = 0;
    while i < 4096 {
        n = n + (*a)[i] as u32;
        i = i + 1;
    }
    n
}

fn one(a: [1]i64) -> i64 {
    a[0]
}

fn main() -> i32 {
    let k: [1024]u8 = [1; 1024];
    let k1 = k;
    let k2 = k;
    print_int(count_ones(view(k1)) as i64);
    print(" ");
    print_int(count_ones(view(k2)) as i64);
    print("\n");

    let mut c = k;
    c[0] = 255u8;
    c[1023] = 0u8;
    print_int(c[0] as i64);
    print(" ");
    print_int((k[1023] - 1u8) as i64);
    print("\n");

    let s: [1]i64 = [7];
    let s2 = s;
    print_int(one(s));
    print(" ");
    print_int(one(s2));
    print("\n");

    let big: [4096]u8 = [1; 4096];
    let big2 = big;
    print_int(big_sum(view(big)) as i64);
    print(" ");
    print_int(big_sum(view(big2)) as i64);
    print("\n");
    0
}
