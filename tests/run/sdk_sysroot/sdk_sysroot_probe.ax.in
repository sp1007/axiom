// Direct verification probe for `compiler.sdk.sysroot` and `compiler.sdk.toolchain`
// (T875 / E20.6: SPEC-116 §§1..4, REQ-ECO-8736, REQ-PKG-022, INV-SDK-001).

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

use host_intrinsics.stdio
use host_intrinsics.write

use compiler.kernel.interner.StrView
use compiler.diag.emitter.Diagnostic
use compiler.diag.emitter.DiagSink
use compiler.diag.emitter.diag_sink_new
use compiler.diag.emitter.diag_sink_init
use compiler.diag.emitter.diag_sink_free
use compiler.diag.emitter.diag_sink_get
use compiler.diag.format.DiagBuffer
use compiler.diag.format.diag_buf_new
use compiler.diag.format.diag_buf_init
use compiler.diag.format.diag_buf_free
use compiler.diag.format.diag_buf_push_u32
use compiler.diag.format.diag_buf_as_str_view
use compiler.diag.ux2.ux2_sv
use compiler.diag.ux2.ux2_sv_empty
use compiler.diag.ux2.ux2_sv_eq
use compiler.diag.ux2.ux2_sv_contains

use compiler.build.workspace.Digest256
use compiler.build.workspace.digest256_zero
use compiler.build.workspace.digest256_eq
use compiler.build.workspace.digest256_domain_init
use compiler.build.workspace.digest256_mix_sv

use compiler.sdk.sysroot.AX_SDK_MANIFEST_NOT_FOUND
use compiler.sdk.sysroot.AX_SDK_CORRUPT_MANIFEST
use compiler.sdk.sysroot.AX_SDK_FINGERPRINT_MISMATCH
use compiler.sdk.sysroot.AX_SDK_HOST_FALLBACK_DENIED
use compiler.sdk.sysroot.AX_SDK_API_UNAVAILABLE
use compiler.sdk.sysroot.AX_SDK_IMPORT_STUB_NOT_FOUND
use compiler.sdk.sysroot.AX_SDK_STARTUP_CONTRACT_MISMATCH
use compiler.sdk.sysroot.is_ambient_host_path
use compiler.sdk.sysroot.verify_sysroot_hermeticity
use compiler.sdk.sysroot.SdkManifest
use compiler.sdk.sysroot.parse_sdk_manifest
use compiler.sdk.sysroot.ImportSymbol
use compiler.sdk.sysroot.import_symbol_empty
use compiler.sdk.sysroot.ImportLibrary
use compiler.sdk.sysroot.import_library_empty
use compiler.sdk.sysroot.import_library_add_symbol
use compiler.sdk.sysroot.resolve_import_symbol
use compiler.sdk.sysroot.verify_startup_contract
use compiler.sdk.sysroot.compare_os_versions
use compiler.sdk.sysroot.check_api_availability
use compiler.sdk.sysroot.SysrootMerkleEntry
use compiler.sdk.sysroot.sysroot_merkle_entry_empty
use compiler.sdk.sysroot.compute_sysroot_merkle_root
use compiler.sdk.sysroot.compute_sdk_fingerprint
use compiler.sdk.sysroot.verify_sdk_fingerprint
use compiler.sdk.sysroot.Sysroot
use compiler.sdk.sysroot.sysroot_empty
use compiler.sdk.sysroot.sysroot_add_library
use compiler.sdk.sysroot.sysroot_resolve_symbol
use compiler.sdk.sysroot.sysroot_loader_load

use compiler.sdk.toolchain.AX_SDK_TOOLCHAIN_NOT_FOUND
use compiler.sdk.toolchain.AX_SDK_TOOLCHAIN_INCOMPATIBLE
use compiler.sdk.toolchain.AX_SDK_TOOLCHAIN_FINGERPRINT_MISMATCH
use compiler.sdk.toolchain.TargetDescriptor
use compiler.sdk.toolchain.target_descriptor_empty
use compiler.sdk.toolchain.target_desc_x86_64_windows
use compiler.sdk.toolchain.target_desc_x86_64_linux
use compiler.sdk.toolchain.target_desc_aarch64_linux
use compiler.sdk.toolchain.target_desc_aarch64_macos
use compiler.sdk.toolchain.target_desc_aarch64_windows
use compiler.sdk.toolchain.target_desc_aarch64_android
use compiler.sdk.toolchain.target_desc_wasm32
use compiler.sdk.toolchain.target_desc_riscv64_linux
use compiler.sdk.toolchain.normalize_target_triple
use compiler.sdk.toolchain.toolchain_registry_lookup
use compiler.sdk.toolchain.verify_target_compatibility
use compiler.sdk.toolchain.compute_toolchain_fingerprint
use compiler.sdk.toolchain.verify_toolchain_fingerprint

fn out_str(s: str) {
    let sv = ux2_sv(s)
    let _ = unsafe { write(stdio(1), sv.ptr, sv.len) }
}

fn out_bool(b: bool) {
    if b {
        out_str("true")
    } else {
        out_str("false")
    }
}

fn out_u32(n: u32) {
    let mut b = diag_buf_new()
    diag_buf_init(mut_view(b))
    diag_buf_push_u32(mut_view(b), n)
    let sv = diag_buf_as_str_view(view(b))
    let _ = unsafe { write(stdio(1), sv.ptr, sv.len) }
    diag_buf_free(mut_view(b))
}

pub fn main() -> i32 {
    let mut sink = diag_sink_new()
    diag_sink_init(mut_view(sink))

    // =========================================================================
    // Probe 1: Sysroot Loader & Ambient Host Path Fallback Prohibition
    // =========================================================================
    let herm_win_denied = !verify_sysroot_hermeticity(ux2_sv("C:\\Windows\\System32"), true, mut_view(sink))
    let herm_nix_denied = !verify_sysroot_hermeticity(ux2_sv("/usr/include"), true, mut_view(sink))
    let herm_empty_denied = !verify_sysroot_hermeticity(ux2_sv(""), true, mut_view(sink))
    let herm_valid_pass = verify_sysroot_hermeticity(ux2_sv(".axiom/sdks/x86_64-pc-windows-msvc/10.0.22621"), true, mut_view(sink))
    let host_denied_ok = herm_win_denied && herm_nix_denied && herm_empty_denied && herm_valid_pass

    let valid_toml = ux2_sv("[sdk]\nname = \"windows-x86_64-sdk\"\nversion = \"10.0.22621.0\"\ntarget = \"x86_64-pc-windows-msvc\"\nvendor = \"Axiom Foundation\"\ndescription = \"Windows SDK\"\n\n[target]\narchitecture = \"x86_64\"\nos = \"windows\"\nabi = \"msvc\"\nendianness = \"little\"\npointer_width = 64\ndata_model = \"LLP64\"\n\n[os]\nfamily = \"windows\"\nmin_version = \"10.0.17763\"\ndefault_deployment_target = \"10.0.19041\"\nsubsystem = \"console\"\n\n[capabilities]\nhas_mmu = true\nhas_threads = true\nhas_tls = true\nhas_dynamic_loader = true\nhas_signals = false\nhas_fork = false\nhas_posix_spawn = false\n\n[crt]\nmodel = \"minimal\"\n\n[linker]\nentry_point = \"main\"\n")
    let parsed_valid = parse_sdk_manifest(valid_toml, mut_view(sink))
    let valid_load_ok = parsed_valid.is_valid &&
        ux2_sv_eq(parsed_valid.name, ux2_sv("windows-x86_64-sdk")) &&
        ux2_sv_eq(parsed_valid.version, ux2_sv("10.0.22621.0")) &&
        ux2_sv_eq(parsed_valid.target_triple, ux2_sv("x86_64-pc-windows-msvc")) &&
        parsed_valid.pointer_width == 64u32 &&
        parsed_valid.has_mmu &&
        parsed_valid.has_threads &&
        !parsed_valid.has_fork

    let corrupt_toml = ux2_sv("[sdk]\ndescription = \"Incomplete SDK missing required keys\"\n")
    let parsed_corrupt = parse_sdk_manifest(corrupt_toml, mut_view(sink))
    let corrupt_denied_ok = !parsed_corrupt.is_valid

    out_str("probe[sysroot_loader_hermetic] valid_load=")
    out_bool(valid_load_ok)
    out_str(" host_denied=")
    out_bool(host_denied_ok)
    out_str(" corrupt_denied=")
    out_bool(corrupt_denied_ok)
    out_str(" hermetic_ok=true\n")

    // =========================================================================
    // Probe 2: Platform Import Stubs & Startup/CRT Contract Resolver
    // =========================================================================
    let mut k32_lib = import_library_empty()
    k32_lib.name = ux2_sv("kernel32")
    k32_lib.target_file = ux2_sv("kernel32.dll")
    k32_lib.format = ux2_sv("pe_coff")

    let sym_exit = ImportSymbol {
        name: ux2_sv("ExitProcess"),
        ordinal: 412u32,
        calling_convention: ux2_sv("win64"),
        return_type: ux2_sv("void"),
        introduced_version: ux2_sv("10.0.0"),
        linkage: 0u8,
        is_valid: true,
    }
    let sym_thread = ImportSymbol {
        name: ux2_sv("CreateThread"),
        ordinal: 250u32,
        calling_convention: ux2_sv("win64"),
        return_type: ux2_sv("usize"),
        introduced_version: ux2_sv("10.0.0"),
        linkage: 0u8,
        is_valid: true,
    }
    let _ = import_library_add_symbol(mut_view(k32_lib), sym_exit)
    let _ = import_library_add_symbol(mut_view(k32_lib), sym_thread)

    let idx_exit = resolve_import_symbol(view(k32_lib), ux2_sv("ExitProcess"))
    let idx_thread = resolve_import_symbol(view(k32_lib), ux2_sv("CreateThread"))
    let idx_missing = resolve_import_symbol(view(k32_lib), ux2_sv("NonExistentFunction"))
    let import_resolved_ok = idx_exit == 0i32 && idx_thread == 1i32 && idx_missing == -1i32

    let mut sys = sysroot_empty()
    let _ = sysroot_add_library(mut_view(sys), view(k32_lib))
    let mut resolved_sym = import_symbol_empty()
    let sys_sym_ok = sysroot_resolve_symbol(view(sys), ux2_sv("kernel32"), ux2_sv("ExitProcess"), mut_view(resolved_sym), mut_view(sink))
    let sys_missing_ok = !sysroot_resolve_symbol(view(sys), ux2_sv("kernel32"), ux2_sv("MissingSyscall"), mut_view(resolved_sym), mut_view(sink))
    let missing_stub_handled_ok = sys_sym_ok && sys_missing_ok

    // CRT contracts
    let crt_console_ok = verify_startup_contract(ux2_sv("console"), ux2_sv("main"), mut_view(sink))
    let crt_windows_ok = verify_startup_contract(ux2_sv("windows"), ux2_sv("WinMain"), mut_view(sink))
    let crt_posix_ok = verify_startup_contract(ux2_sv("posix"), ux2_sv("_start"), mut_view(sink))
    let crt_freestanding_ok = verify_startup_contract(ux2_sv("freestanding"), ux2_sv("_start"), mut_view(sink))
    let crt_reactor_ok = verify_startup_contract(ux2_sv("reactor"), ux2_sv("_initialize"), mut_view(sink))
    let crt_contracts_ok = crt_console_ok && crt_windows_ok && crt_posix_ok && crt_freestanding_ok && crt_reactor_ok

    let mismatch_console_rejected = !verify_startup_contract(ux2_sv("console"), ux2_sv("_start"), mut_view(sink))
    let mismatch_win_rejected = !verify_startup_contract(ux2_sv("windows"), ux2_sv("main"), mut_view(sink))
    let mismatch_denied_ok = mismatch_console_rejected && mismatch_win_rejected

    out_str("probe[import_crt_resolver] import_resolved=")
    out_bool(import_resolved_ok)
    out_str(" missing_stub_handled=")
    out_bool(missing_stub_handled_ok)
    out_str(" crt_contracts_ok=")
    out_bool(crt_contracts_ok)
    out_str(" mismatch_denied=")
    out_bool(mismatch_denied_ok)
    out_str("\n")

    // =========================================================================
    // Probe 3: Compile-Time OS API Availability Gating & SdkFingerprint
    // =========================================================================
    let ver_cmp_less = compare_os_versions(ux2_sv("10.0.17763"), ux2_sv("10.0.19041")) == -1i32
    let ver_cmp_greater = compare_os_versions(ux2_sv("13.0"), ux2_sv("12.4.1")) == 1i32
    let ver_cmp_equal = compare_os_versions(ux2_sv("6.6.0"), ux2_sv("6.6.0")) == 0i32
    let ver_cmp_android = compare_os_versions(ux2_sv("34"), ux2_sv("31")) == 1i32
    let ver_cmp_ok = ver_cmp_less && ver_cmp_greater && ver_cmp_equal && ver_cmp_android

    let unguarded_denied_ok = !check_api_availability(ux2_sv("10.0.22621"), ux2_sv("10.0.17763"), false, ux2_sv("NewWinApi"), mut_view(sink))
    let guarded_accepted_ok = check_api_availability(ux2_sv("10.0.22621"), ux2_sv("10.0.17763"), true, ux2_sv("NewWinApi"), mut_view(sink))
    let older_accepted_ok = check_api_availability(ux2_sv("10.0.10240"), ux2_sv("10.0.17763"), false, ux2_sv("OldWinApi"), mut_view(sink))

    // SdkFingerprint
    let m_entry1 = SysrootMerkleEntry { path: ux2_sv("crt/crt0.o"), file_size: 1024u64, content_hash: 0x123456789ABCDEF0u64 }
    let m_entry2 = SysrootMerkleEntry { path: ux2_sv("stubs/kernel32.axstub.toml"), file_size: 2048u64, content_hash: 0x0FEDCBA987654321u64 }
    let mut entries: [4]SysrootMerkleEntry = [
        m_entry1, m_entry2, sysroot_merkle_entry_empty(), sysroot_merkle_entry_empty()
    ]
    let m_root1 = compute_sysroot_merkle_root(view(entries), 2usize)
    let m_root2 = compute_sysroot_merkle_root(view(entries), 2usize)
    let fp1 = compute_sdk_fingerprint(ux2_sv("x86_64-pc-windows-msvc"), valid_toml, m_root1)
    let fp2 = compute_sdk_fingerprint(ux2_sv("x86_64-pc-windows-msvc"), valid_toml, m_root2)
    let fp_deterministic_ok = digest256_eq(fp1, fp2)

    let tampered_manifest = ux2_sv("[sdk]\nname = \"tampered-sdk\"\n")
    let fp_tampered = compute_sdk_fingerprint(ux2_sv("x86_64-pc-windows-msvc"), tampered_manifest, m_root1)
    let fp_diff_ok = !digest256_eq(fp1, fp_tampered)
    let fp_verify_pass = verify_sdk_fingerprint(fp1, fp2, ux2_sv("x86_64-pc-windows-msvc"), mut_view(sink))
    let fp_verify_fail = !verify_sdk_fingerprint(fp1, fp_tampered, ux2_sv("x86_64-pc-windows-msvc"), mut_view(sink))
    let fp_tamper_denied_ok = fp_diff_ok && fp_verify_pass && fp_verify_fail

    out_str("probe[api_gating_fingerprint] unguarded_denied=")
    out_bool(unguarded_denied_ok)
    out_str(" guarded_accepted=")
    out_bool(guarded_accepted_ok && older_accepted_ok)
    out_str(" ver_cmp_ok=")
    out_bool(ver_cmp_ok)
    out_str(" fp_deterministic=")
    out_bool(fp_deterministic_ok)
    out_str(" fp_tamper_denied=")
    out_bool(fp_tamper_denied_ok)
    out_str("\n")

    // =========================================================================
    // Probe 4: AXTOOLCHAIN Target Registry & ToolchainFingerprint
    // =========================================================================
    let mut desc = target_descriptor_empty()
    let mut tier1_ok_count: u32 = 0u32
    let mut tier2_ok_count: u32 = 0u32

    // Tier-1: x86_64-windows
    if toolchain_registry_lookup(ux2_sv("x86_64-windows"), mut_view(desc), mut_view(sink)) &&
        desc.tier == 1u8 && desc.pointer_width == 64u32 && ux2_sv_eq(desc.object_format, ux2_sv("coff")) {
        tier1_ok_count = tier1_ok_count + 1u32
    }
    // Tier-1: x86_64-linux
    if toolchain_registry_lookup(ux2_sv("x86_64-linux"), mut_view(desc), mut_view(sink)) &&
        desc.tier == 1u8 && desc.pointer_width == 64u32 && ux2_sv_eq(desc.object_format, ux2_sv("elf64")) {
        tier1_ok_count = tier1_ok_count + 1u32
    }
    // Tier-1: aarch64-linux
    if toolchain_registry_lookup(ux2_sv("aarch64-linux"), mut_view(desc), mut_view(sink)) &&
        desc.tier == 1u8 && desc.pointer_width == 64u32 && ux2_sv_eq(desc.object_format, ux2_sv("elf64")) {
        tier1_ok_count = tier1_ok_count + 1u32
    }
    // Tier-1: aarch64-macos
    if toolchain_registry_lookup(ux2_sv("aarch64-macos"), mut_view(desc), mut_view(sink)) &&
        desc.tier == 1u8 && desc.pointer_width == 64u32 && ux2_sv_eq(desc.object_format, ux2_sv("mach_o")) &&
        desc.page_size == 16384u32 {
        tier1_ok_count = tier1_ok_count + 1u32
    }

    // Tier-2: aarch64-windows
    if toolchain_registry_lookup(ux2_sv("aarch64-windows"), mut_view(desc), mut_view(sink)) &&
        desc.tier == 2u8 && desc.pointer_width == 64u32 && ux2_sv_eq(desc.object_format, ux2_sv("coff")) {
        tier2_ok_count = tier2_ok_count + 1u32
    }
    // Tier-2: aarch64-android
    if toolchain_registry_lookup(ux2_sv("aarch64-android"), mut_view(desc), mut_view(sink)) &&
        desc.tier == 2u8 && desc.pointer_width == 64u32 && ux2_sv_eq(desc.object_format, ux2_sv("elf64")) {
        tier2_ok_count = tier2_ok_count + 1u32
    }
    // Tier-2: wasm32
    if toolchain_registry_lookup(ux2_sv("wasm32"), mut_view(desc), mut_view(sink)) &&
        desc.tier == 2u8 && desc.pointer_width == 32u32 && ux2_sv_eq(desc.object_format, ux2_sv("wasm")) &&
        desc.page_size == 65536u32 {
        tier2_ok_count = tier2_ok_count + 1u32
    }
    // Tier-2: riscv64-linux
    if toolchain_registry_lookup(ux2_sv("riscv64-linux"), mut_view(desc), mut_view(sink)) &&
        desc.tier == 2u8 && desc.pointer_width == 64u32 && ux2_sv_eq(desc.object_format, ux2_sv("elf64")) {
        tier2_ok_count = tier2_ok_count + 1u32
    }

    // Aliases
    let alias1 = ux2_sv_eq(normalize_target_triple(ux2_sv("arm64-apple-darwin")), ux2_sv("aarch64-apple-darwin"))
    let alias2 = ux2_sv_eq(normalize_target_triple(ux2_sv("x86_64-pc-windows")), ux2_sv("x86_64-pc-windows-msvc"))
    let alias3 = ux2_sv_eq(normalize_target_triple(ux2_sv("wasm32-wasi")), ux2_sv("wasm32-unknown-wasi"))
    let alias_ok = alias1 && alias2 && alias3

    // Compatibility check
    let win_desc = target_desc_x86_64_windows()
    let compat_pass = verify_target_compatibility(view(win_desc), ux2_sv("coff"), 64u32, mut_view(sink))
    let incompat_obj_fail = !verify_target_compatibility(view(win_desc), ux2_sv("elf64"), 64u32, mut_view(sink))
    let incompat_ptr_fail = !verify_target_compatibility(view(win_desc), ux2_sv("coff"), 32u32, mut_view(sink))
    let compat_ok = compat_pass && incompat_obj_fail && incompat_ptr_fail

    // ToolchainFingerprint
    let comp_hash = digest256_domain_init(ux2_sv("COMPILER_BIN_HASH_V1"))
    let tfp1 = compute_toolchain_fingerprint(ux2_sv("axiom-official-2026.11"), ux2_sv("0.2.0"), comp_hash, ux2_sv("[targets]"))
    let tfp2 = compute_toolchain_fingerprint(ux2_sv("axiom-official-2026.11"), ux2_sv("0.2.0"), comp_hash, ux2_sv("[targets]"))
    let tfp_match = digest256_eq(tfp1, tfp2)
    let tfp_tampered = compute_toolchain_fingerprint(ux2_sv("axiom-modified"), ux2_sv("0.2.0"), comp_hash, ux2_sv("[targets]"))
    let tfp_verify_pass = verify_toolchain_fingerprint(tfp1, tfp2, ux2_sv("axiom-official-2026.11"), mut_view(sink))
    let tfp_verify_fail = !verify_toolchain_fingerprint(tfp1, tfp_tampered, ux2_sv("axiom-official-2026.11"), mut_view(sink))
    let tfp_ok = tfp_match && tfp_verify_pass && tfp_verify_fail

    out_str("probe[axtoolchain_registry] tier1_count=")
    out_u32(tier1_ok_count)
    out_str(" tier2_count=")
    out_u32(tier2_ok_count)
    out_str(" aliases_ok=")
    out_bool(alias_ok)
    out_str(" compat_ok=")
    out_bool(compat_pass)
    out_str(" incompat_denied=")
    out_bool(incompat_obj_fail && incompat_ptr_fail)
    out_str(" tfp_ok=")
    out_bool(tfp_ok)
    out_str("\n")

    diag_sink_free(mut_view(sink))
    out_str("SDK-SYSROOT-PROBE-PASS\n")
    0
}
