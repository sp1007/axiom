// test: run
// modes: interp native
// stdout-file: axsdk_loader_import_crt_hermetic.stdout
// SPEC-116 §§1, 2 (AXS-SDK-001..024, INV-SDK-001, REQ-ECO-8736, REQ-PKG-022):
// Declarative .axsdk sysroot loader, ambient host path fallback prohibition
// (AX_SDK_HOST_FALLBACK_DENIED), dynamic import stub resolution & CRT startup contracts.

@intrinsic
fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }

fn fnv1a_step(h: u64, v: u64) -> u64 {
    wrapping_mul_u64(h ^ v, 1099511628211u64)
}

fn is_ambient_host_path(path_kind: u8) -> bool {
    // 0: C:\Windows\System32
    // 1: /usr/include
    // 2: /Library/Developer
    // 3: .axiom/sdks/x86_64-pc-windows-msvc/10.0.22621
    // 4: empty
    path_kind == 0u8 || path_kind == 1u8 || path_kind == 2u8 || path_kind == 4u8
}

fn verify_hermetic_sysroot(path_kind: u8, is_hermetic: bool) -> bool {
    if is_hermetic && is_ambient_host_path(path_kind) {
        // AX_SDK_HOST_FALLBACK_DENIED
        return false
    }
    true
}

fn verify_startup_contract(subsystem: u8, entry_point: u8) -> bool {
    // Subsystem: 0: console, 1: windows, 2: posix, 3: freestanding, 4: reactor
    // Entry:     0: main,    1: WinMain, 2: _start,   3: _initialize
    if subsystem == 0u8 {
        return entry_point == 0u8
    }
    if subsystem == 1u8 {
        return entry_point == 1u8
    }
    if subsystem == 2u8 {
        return entry_point == 0u8 || entry_point == 2u8
    }
    if subsystem == 3u8 {
        return entry_point == 2u8
    }
    if subsystem == 4u8 {
        return entry_point == 3u8
    }
    false
}

fn simulate_import_lookup(lib_kind: u8, sym_kind: u8) -> i32 {
    // lib: 0: kernel32, 1: libc, 2: libSystem
    // sym: 0: ExitProcess, 1: write, 2: missing
    if lib_kind == 0u8 && sym_kind == 0u8 {
        return 412i32 // ordinal
    }
    if lib_kind == 1u8 && sym_kind == 1u8 {
        return 1i32
    }
    -1i32
}

pub fn main() -> i32 {
    // 1. Ambient host path fallback rejection under hermetic mode (AXS-SDK-002, 004)
    let win_denied = !verify_hermetic_sysroot(0u8, true)
    let nix_denied = !verify_hermetic_sysroot(1u8, true)
    let mac_denied = !verify_hermetic_sysroot(2u8, true)
    let empty_denied = !verify_hermetic_sysroot(4u8, true)
    let valid_sysroot_pass = verify_hermetic_sysroot(3u8, true)
    let host_fallback_audit_ok = win_denied && nix_denied && mac_denied && empty_denied && valid_sysroot_pass

    // 2. Dynamic import stub resolution (AXS-SDK-012, 018)
    let k32_exit_found = simulate_import_lookup(0u8, 0u8) == 412i32
    let libc_write_found = simulate_import_lookup(1u8, 1u8) == 1i32
    let missing_rejected = simulate_import_lookup(0u8, 2u8) == -1i32
    let import_lookup_ok = k32_exit_found && libc_write_found && missing_rejected

    // 3. CRT startup contracts across all 5 subsystems (AXS-SDK-013)
    let console_ok = verify_startup_contract(0u8, 0u8)
    let win_ok = verify_startup_contract(1u8, 1u8)
    let posix_ok = verify_startup_contract(2u8, 2u8)
    let freestanding_ok = verify_startup_contract(3u8, 2u8)
    let reactor_ok = verify_startup_contract(4u8, 3u8)

    let console_mismatch_denied = !verify_startup_contract(0u8, 2u8)
    let win_mismatch_denied = !verify_startup_contract(1u8, 0u8)
    let crt_contracts_ok = console_ok && win_ok && posix_ok && freestanding_ok && reactor_ok &&
        console_mismatch_denied && win_mismatch_denied

    if !host_fallback_audit_ok || !import_lookup_ok || !crt_contracts_ok {
        return 1
    }

    print("AXSDK-LOADER-IMPORT-CRT-HERMETIC-OK\n")
    0
}
