// test: run
// modes: interp native
// stdout-file: qa_sdk_sysroot_boundary_edge.stdout
// QA boundary cross-check test for SPEC-116 (§§1..4, AXS-SDK-001..036, REQ-ECO-8736, REQ-PKG-022):
// Multi-component version edge comparison, startup contract subsystem boundaries,
// target page sizes & formats across Tier-1/Tier-2, and ambient host path edge cases.

@intrinsic
fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }

fn fnv1a_step(h: u64, v: u64) -> u64 {
    wrapping_mul_u64(h ^ v, 1099511628211u64)
}

fn compare_version_triples(
    v1_major: u32, v1_minor: u32, v1_patch: u32,
    v2_major: u32, v2_minor: u32, v2_patch: u32
) -> i32 {
    if v1_major > v2_major { return 1i32 }
    if v1_major < v2_major { return -1i32 }
    if v1_minor > v2_minor { return 1i32 }
    if v1_minor < v2_minor { return -1i32 }
    if v1_patch > v2_patch { return 1i32 }
    if v1_patch < v2_patch { return -1i32 }
    0i32
}

fn check_startup_contract_boundary(subsystem: u8, entry_kind: u8) -> bool {
    // Subsystem: 0: console, 1: windows, 2: posix, 3: freestanding, 4: reactor
    // Entry:     0: main, 1: WinMain, 2: _start, 3: _initialize, 4: wWinMain
    if subsystem == 0u8 {
        return entry_kind == 0u8
    }
    if subsystem == 1u8 {
        return entry_kind == 1u8 || entry_kind == 4u8
    }
    if subsystem == 2u8 {
        return entry_kind == 0u8 || entry_kind == 2u8
    }
    if subsystem == 3u8 {
        return entry_kind == 2u8
    }
    if subsystem == 4u8 {
        return entry_kind == 3u8
    }
    false
}

fn check_ambient_path_edge(path_id: u8) -> bool {
    // 0: c:/windows/system32 (lowercase forward slash)
    // 1: C:\Program Files (x86)\Windows Kits
    // 2: /usr/local/include
    // 3: /lib64
    // 4: /System/Library/Frameworks
    // 5: /Library/Developer/CommandLineTools
    // 6: .axiom/sdks/x86_64-pc-windows-msvc
    // 7: build/sysroot
    if path_id <= 5u8 {
        return true
    }
    false
}

fn query_target_pointer_width(target_id: u8) -> u32 {
    // 0: x86_64-windows  -> 64-bit
    // 1: aarch64-macos   -> 64-bit
    // 2: wasm32          -> 32-bit
    // 3: riscv64-linux   -> 64-bit
    // 4: aarch64-android -> 64-bit
    if target_id == 2u8 {
        return 32u32
    }
    64u32
}

fn query_target_page_size(target_id: u8) -> u32 {
    // 0: x86_64-windows  -> 4096
    // 1: aarch64-macos   -> 16384
    // 2: wasm32          -> 65536
    // 3: riscv64-linux   -> 4096
    // 4: aarch64-android -> 4096
    if target_id == 1u8 {
        return 16384u32
    }
    if target_id == 2u8 {
        return 65536u32
    }
    4096u32
}

fn query_target_object_format(target_id: u8) -> u8 {
    // 1: coff, 2: mach_o, 3: wasm, 4: elf64
    if target_id == 0u8 {
        return 1u8
    }
    if target_id == 1u8 {
        return 2u8
    }
    if target_id == 2u8 {
        return 3u8
    }
    4u8
}

pub fn main() -> i32 {
    // 1. Version triple comparisons
    let cmp1 = compare_version_triples(14u32, 0u32, 0u32, 14u32, 0u32, 0u32) == 0i32
    let cmp2 = compare_version_triples(14u32, 1u32, 0u32, 14u32, 0u32, 9u32) == 1i32
    let cmp3 = compare_version_triples(2u32, 4u32, 0u32, 2u32, 31u32, 0u32) == -1i32
    let ver_ok = cmp1 && cmp2 && cmp3

    // 2. Subsystem contract boundaries
    let win_wwin_ok = check_startup_contract_boundary(1u8, 4u8)
    let win_main_bad = !check_startup_contract_boundary(1u8, 0u8)
    let free_main_bad = !check_startup_contract_boundary(3u8, 0u8)
    let free_start_ok = check_startup_contract_boundary(3u8, 2u8)
    let react_init_ok = check_startup_contract_boundary(4u8, 3u8)
    let react_start_bad = !check_startup_contract_boundary(4u8, 2u8)
    let contracts_ok = win_wwin_ok && win_main_bad && free_main_bad && free_start_ok && react_init_ok && react_start_bad

    // 3. Ambient path edge cases
    let amb_win_fwd = check_ambient_path_edge(0u8)
    let amb_prog_files = check_ambient_path_edge(1u8)
    let amb_usr_local = check_ambient_path_edge(2u8)
    let amb_lib64 = check_ambient_path_edge(3u8)
    let amb_sys_lib = check_ambient_path_edge(4u8)
    let amb_lib_dev = check_ambient_path_edge(5u8)
    let not_amb_sdk = !check_ambient_path_edge(6u8)
    let not_amb_bld = !check_ambient_path_edge(7u8)
    let ambient_ok = amb_win_fwd && amb_prog_files && amb_usr_local && amb_lib64 && amb_sys_lib && amb_lib_dev && not_amb_sdk && not_amb_bld

    // 4. Target properties & page size validation
    let win_ok = query_target_pointer_width(0u8) == 64u32 && query_target_page_size(0u8) == 4096u32 && query_target_object_format(0u8) == 1u8
    let mac_ok = query_target_pointer_width(1u8) == 64u32 && query_target_page_size(1u8) == 16384u32 && query_target_object_format(1u8) == 2u8
    let wasm_ok = query_target_pointer_width(2u8) == 32u32 && query_target_page_size(2u8) == 65536u32 && query_target_object_format(2u8) == 3u8
    let riscv_ok = query_target_pointer_width(3u8) == 64u32 && query_target_page_size(3u8) == 4096u32 && query_target_object_format(3u8) == 4u8
    let android_ok = query_target_pointer_width(4u8) == 64u32 && query_target_page_size(4u8) == 4096u32 && query_target_object_format(4u8) == 4u8
    let targets_ok = win_ok && mac_ok && wasm_ok && riscv_ok && android_ok

    if !ver_ok || !contracts_ok || !ambient_ok || !targets_ok {
        return 1
    }

    print("QA-SDK-SYSROOT-BOUNDARY-EDGE-OK\n")
    0
}
