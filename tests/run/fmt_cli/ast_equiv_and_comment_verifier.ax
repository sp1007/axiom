// test: run
// modes: interp native
// stdout-file: ast_equiv_and_comment_verifier.stdout
// SPEC-101 AXS-FMT-004, AXS-FMT-030..032:
// Verifies comment conservation and final STMT_EXPR semicolon preservation in the AST verifier.

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

@derive(Copy)
struct RawStr {
    ptr: *const u8,
    len: usize,
}

@derive(Copy)
struct MockComment {
    kind: u8,
    text: str,
}

fn eq_str(a: str, b: str) -> bool {
    let ra: RawStr = unsafe { *(address_of(a) as *const RawStr) };
    let rb: RawStr = unsafe { *(address_of(b) as *const RawStr) };
    let ba: view<[u8]> = unsafe { *(address_of(a) as *const view<[u8]>) };
    let bb: view<[u8]> = unsafe { *(address_of(b) as *const view<[u8]>) };
    if ra.len != rb.len {
        return false;
    }
    let mut i: usize = 0;
    while i < ra.len {
        if ba[i] != bb[i] {
            return false;
        }
        i = i + 1;
    }
    true
}

fn verify_comment_conservation(a: view<[3]MockComment>, b: view<[3]MockComment>, count_a: usize, count_b: usize) -> i32 {
    if count_a != count_b {
        return 3;
    }
    let mut i: usize = 0;
    while i < count_a {
        let ca = (*a)[i];
        let cb = (*b)[i];
        if ca.kind != cb.kind || !eq_str(ca.text, cb.text) {
            return 3;
        }
        i = i + 1;
    }
    0
}

fn verify_final_stmt_semi(orig_has_semi: bool, fmt_has_semi: bool, is_ctrl_or_jump: bool) -> i32 {
    if !is_ctrl_or_jump && orig_has_semi != fmt_has_semi {
        return 3;
    }
    0
}

pub fn main() -> i32 {
    let orig_c: [3]MockComment = [
        MockComment { kind: 2u8, text: "//! Header" },
        MockComment { kind: 1u8, text: "/// Outer doc" },
        MockComment { kind: 0u8, text: "// Line comment" },
    ];
    let fmt_c_ok: [3]MockComment = [
        MockComment { kind: 2u8, text: "//! Header" },
        MockComment { kind: 1u8, text: "/// Outer doc" },
        MockComment { kind: 0u8, text: "// Line comment" },
    ];
    if verify_comment_conservation(view(orig_c), view(fmt_c_ok), 3, 3) != 0 {
        return 1;
    }
    if verify_comment_conservation(view(orig_c), view(fmt_c_ok), 3, 2) != 3 {
        return 2;
    }
    if verify_final_stmt_semi(false, true, false) != 3 {
        return 3;
    }
    if verify_final_stmt_semi(false, false, false) != 0 {
        return 4;
    }
    print("AST-EQUIV-AND-COMMENT-VERIFIER-OK\n");
    0
}
