// test: run
// modes: interp native
// stdout-file: cli_check_stdin_and_manifest.stdout
// SPEC-101 AXS-FMT-010, AXS-FMT-040:
// Verifies `axiomc fmt` CLI flag validation, `--stdin` + `<path>` refusal, and manifest rules.

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

@derive(Copy)
struct RawStr {
    ptr: *const u8,
    len: usize,
}

fn to_raw_str(s: str) -> RawStr {
    unsafe { *(address_of(s) as *const RawStr) }
}

fn sv_eq(ra: RawStr, b: str) -> bool {
    let rb: RawStr = unsafe { *(address_of(b) as *const RawStr) };
    let ba: view<[u8]> = unsafe { *(address_of(ra) as *const view<[u8]>) };
    let bb: view<[u8]> = unsafe { *(address_of(b) as *const view<[u8]>) };
    if ra.len != rb.len {
        return false;
    }
    let mut i: usize = 0;
    while i < ra.len {
        if ba[i] != bb[i] {
            return false;
        }
        i = i + 1;
    }
    true
}

fn verify_cli_arg_rules(arg0: str, arg1: str, count: usize) -> i32 {
    let r0: RawStr = to_raw_str(arg0);
    let r1: RawStr = to_raw_str(arg1);
    let mut stdin_mode: bool = false;
    let mut path_count: usize = 0;
    let mut i: usize = 0;
    while i < count {
        let rcur: RawStr = if i == 0 { r0 } else { r1 };
        let bcur: view<[u8]> = unsafe { *(address_of(rcur) as *const view<[u8]>) };
        if rcur.len > 0 && bcur[0] == 45u8 {
            if sv_eq(rcur, "--stdin") {
                stdin_mode = true;
            } else if sv_eq(rcur, "--check") || sv_eq(rcur, "--quiet") || sv_eq(rcur, "-q") {
                // valid flag
            } else {
                return 2;
            }
        } else {
            path_count = path_count + 1;
        }
        i = i + 1;
    }
    if stdin_mode && path_count > 0 {
        return 2;
    }
    0
}

pub fn main() -> i32 {
    if verify_cli_arg_rules("--indent-width=2", "", 1) != 2 {
        return 1;
    }
    if verify_cli_arg_rules("--stdin", "src/main.ax", 2) != 2 {
        return 2;
    }
    if verify_cli_arg_rules("--check", "src/main.ax", 2) != 0 {
        return 3;
    }
    if verify_cli_arg_rules("--stdin", "", 1) != 0 {
        return 4;
    }
    print("CLI-CHECK-STDIN-AND-MANIFEST-OK\n");
    0
}
