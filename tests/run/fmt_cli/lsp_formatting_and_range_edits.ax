// test: run
// modes: interp native
// stdout-file: lsp_formatting_and_range_edits.stdout
// SPEC-101 AXS-FMT-042, SPEC-100 AXS-LSP-053:
// Verifies minimal line-bounded `TextEdit` window computation for LSP formatting.

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

@derive(Copy)
struct RawStr {
    ptr: *const u8,
    len: usize,
}

struct MinimalEditSpan {
    start_byte: usize,
    end_byte: usize,
    new_len: usize,
}

fn compute_minimal_line_window(orig: str, formatted: str) -> MinimalEditSpan {
    let r_orig: RawStr = unsafe { *(address_of(orig) as *const RawStr) };
    let r_fmt: RawStr = unsafe { *(address_of(formatted) as *const RawStr) };
    let b_orig: view<[u8]> = unsafe { *(address_of(orig) as *const view<[u8]>) };
    let b_fmt: view<[u8]> = unsafe { *(address_of(formatted) as *const view<[u8]>) };
    let min_len: usize = if (r_orig.len) < r_fmt.len { r_orig.len } else { r_fmt.len };
    let mut diff_start: usize = 0;
    let mut last_line_start: usize = 0;
    while diff_start < min_len {
        let ba: u8 = b_orig[diff_start];
        let bb: u8 = b_fmt[diff_start];
        if ba != bb {
            break;
        }
        if ba == 10u8 {
            last_line_start = diff_start + 1;
        }
        diff_start = diff_start + 1;
    }
    if diff_start == r_orig.len && diff_start == r_fmt.len {
        return MinimalEditSpan { start_byte: 0, end_byte: 0, new_len: 0 };
    }
    let start_b: usize = last_line_start;
    let mut orig_end: usize = r_orig.len;
    let mut fmt_end: usize = r_fmt.len;
    let mut orig_line_end: usize = r_orig.len;
    let mut fmt_line_end: usize = r_fmt.len;
    while orig_end > start_b && fmt_end > start_b {
        let ba: u8 = b_orig[orig_end - 1];
        let bb: u8 = b_fmt[fmt_end - 1];
        if ba != bb {
            break;
        }
        orig_end = orig_end - 1;
        fmt_end = fmt_end - 1;
        if ba == 10u8 {
            orig_line_end = orig_end + 1;
            fmt_line_end = fmt_end + 1;
        }
    }
    MinimalEditSpan {
        start_byte: start_b,
        end_byte: orig_line_end,
        new_len: fmt_line_end - start_b,
    }
}

pub fn main() -> i32 {
    let orig: str = "pub fn a() -> i32 {\n    1\n}\n\npub fn   b() -> i32 {\n    2\n}\n";
    let fmt1: str = "pub fn a() -> i32 {\n    1\n}\n\npub fn b() -> i32 {\n    2\n}\n";
    let win: MinimalEditSpan = compute_minimal_line_window(orig, fmt1);
    if win.start_byte != 29 || win.end_byte != 51 || win.new_len != 20 {
        return 1;
    }
    let fmt2: str = "pub fn a() -> i32 {\n    1\n}\n\npub fn b() -> i32 {\n    2\n}\n";
    let fmt3: str = "pub fn a() -> i32 {\n    1\n}\n\npub fn b() -> i32 {\n    2\n}\n";
    let noop: MinimalEditSpan = compute_minimal_line_window(fmt2, fmt3);
    if noop.start_byte != 0 || noop.end_byte != 0 || noop.new_len != 0 {
        return 2;
    }
    print("LSP-FORMATTING-AND-RANGE-EDITS-OK\n");
    0
}
