// test: run
// exit: 0
// stdout: 7 21\n11 12\n4 6\n9\n33\n
// T498b (SPEC-10 AXS-OWN-003): reading a Copy field through an index of a non-Copy array only reads the
// array. `H` is not Copy (no Copy impl), its fields are: an `i32`, a `fn` pointer, a `[2]u8` and a
// view. Two and more reads through `hs[i]`, then a move of the whole `hs`, all compile and run.

struct H {
    n: i32,
    f: fn(i32) -> i32,
    b: [2]u8,
}

struct V {
    n: i32,
    v: view<[3]i32>,
}

fn inc(x: i32) -> i32 {
    x + 1
}

fn triple(x: i32) -> i32 {
    x * 3
}

fn total(hs: [2]H) -> i32 {
    hs[0].n + hs[1].n
}

fn main() -> i32 {
    let hs: [2]H = [H { n: 4, f: inc, b: [1u8, 3u8] }, H { n: 5, f: triple, b: [2u8, 3u8] }];
    // The T422b QA repro: two `fn`-pointer reads through an index.
    let a = hs[0].f;
    let b = hs[1].f;
    print_int(a(6) as i64);
    print(" ");
    print_int(b(7) as i64);
    print("\n");

    // `i32` field read twice from the same element.
    let x = hs[0].n + 7;
    let y = hs[0].n + 8;
    print_int(x as i64);
    print(" ");
    print_int(y as i64);
    print("\n");

    // `[2]u8` field (a Copy array) read through an index.
    let b0 = hs[0].b;
    let b1 = hs[1].b;
    print_int((b0[0] + b0[1]) as i64);
    print(" ");
    print_int((b1[0] + b1[1] + b0[0]) as i64);
    print("\n");

    // A call through the field directly, twice.
    let c = (hs[0].f)(1) + (hs[1].f)(2) + 1;
    print_int(c as i64);
    print("\n");

    // A view field read through an index.
    let data: [3]i32 = [10, 11, 12];
    let vs: [2]V = [V { n: 1, v: view(data) }, V { n: 2, v: view(data) }];
    let v0 = vs[0].v;
    let v1 = vs[1].v;
    print_int(((*v0)[0] + (*v1)[1] + (*v0)[2] - vs[0].n + vs[1].n - 1) as i64);
    print("\n");

    // The whole array is still owned: move it.
    let moved = hs;
    if total(moved) != 9 {
        return 1;
    }
    0
}
