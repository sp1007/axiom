// test: run
// exit: 0
// stdout: 6 6\n15\n41\n3\n
// T498b (SPEC-10 AXS-OWN-003): Copy reads through an index of a non-Copy array never move the array:
// a nested field `hs[i].inner.f`, `g[i][j].n` on an array of arrays of a non-Copy struct, reads in a
// loop, then a move of the whole array.

struct Inner {
    f: i32,
    name: str,
}

struct Outer {
    k: i32,
    inner: Inner,
}

struct Cell {
    n: i32,
}

fn count(os: [3]Outer) -> i32 {
    os[0].k + os[1].k + os[2].k
}

fn main() -> i32 {
    let os: [3]Outer = [
        Outer { k: 1, inner: Inner { f: 1, name: "a" } },
        Outer { k: 1, inner: Inner { f: 2, name: "b" } },
        Outer { k: 1, inner: Inner { f: 3, name: "c" } },
    ];
    // Nested Copy field through an index, read twice.
    let s1 = os[0].inner.f + os[1].inner.f + os[2].inner.f;
    let s2 = os[2].inner.f + os[1].inner.f + os[0].inner.f;
    print_int(s1 as i64);
    print(" ");
    print_int(s2 as i64);
    print("\n");

    // Array of arrays of a non-Copy struct: `g[i][j].n` in a loop.
    let g: [2][3]Cell = [[Cell { n: 0 }, Cell { n: 1 }, Cell { n: 2 }], [Cell { n: 3 }, Cell { n: 4 }, Cell { n: 5 }]];
    let mut sum = 0;
    let mut i: usize = 0;
    while i < 2 {
        let mut j: usize = 0;
        while j < 3 {
            sum = sum + g[i][j].n;
            j = j + 1;
        }
        i = i + 1;
    }
    print_int(sum as i64);
    print("\n");

    // Repeated reads of a nested field inside a loop body.
    let mut acc = 0;
    let mut r = 0;
    while r < 7 {
        acc = acc + os[(r % 3) as usize].inner.f;
        r = r + 1;
    }
    print_int((acc + 28) as i64);
    print("\n");

    // The arrays are still owned: move them whole.
    let g2 = g;
    let moved = os;
    if g2[1][2].n != 5 {
        return 1;
    }
    print_int(count(moved) as i64);
    print("\n");
    0
}
