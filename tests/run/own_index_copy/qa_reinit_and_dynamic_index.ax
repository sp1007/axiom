// test: run
// exit: 0
// stdout: 6\n15\n2\n33\n3\n82\n

// QA (T498b gate): re-initialising a non-Copy array after an indexed move makes Copy reads through an
// index legal again (plain, in a loop, in a branch); Copy fn-pointer reads through a dynamic index of a
// by-value parameter and of a 2-D array in a loop never move the array.

struct H {
    n: i32,
    name: str,
    f: fn(i32) -> i32,
}

struct P {
    x: i32,
    y: i32,
}

fn inc(x: i32) -> i32 {
    x + 1
}

fn dbl(x: i32) -> i32 {
    x * 2
}

fn mk() -> H {
    H { n: 1, name: "a", f: inc }
}

fn take(h: H) -> i32 {
    h.n
}

fn use_p(p: P) -> i32 {
    p.x + p.y
}

fn run(hs: [2]H, i: usize) -> i32 {
    let a = hs[i].f;
    let b = hs[0].f;
    a(10) + b(20) + hs[1].n
}

fn main() -> i32 {
    // Re-initialisation after an indexed move.
    let mut hs: [2]H = [mk(), mk()];
    let t = take(hs[0]);
    hs = [mk(), mk()];
    let a = hs[0].f;
    let b = hs[1].f;
    print_int((a(1) + b(2) + t) as i64);
    print("\n");

    // Re-initialisation inside a loop: read, move, re-init, three times.
    let mut ks: [2]H = [mk(), mk()];
    let mut i: usize = 0;
    let mut s: i32 = 0;
    while i < 3 {
        s = s + ks[0].n + ks[1].n;
        s = s + (ks[i % 2].f)(1);
        let t2 = take(ks[0]);
        ks = [mk(), mk()];
        s = s + t2;
        i = i + 1;
    }
    print_int(s as i64);
    print("\n");

    // Re-initialisation in a branch.
    let mut js: [2]H = [mk(), mk()];
    let c = true;
    if c {
        let t3 = take(js[1]);
        js = [mk(), mk()];
    }
    print_int((js[0].n + js[1].n) as i64);
    print("\n");

    // A by-value parameter array, dynamic index.
    print_int(run([mk(), mk()], 1) as i64);
    print("\n");

    // A non-Copy struct element moved out by value; the array is not used afterwards.
    let ps: [2]P = [P { x: 1, y: 2 }, P { x: 3, y: 4 }];
    print_int(use_p(ps[0]) as i64);
    print("\n");

    // 2-D array of a non-Copy struct, fn-pointer reads with variable indices in nested loops.
    let g: [2][2]H = [
        [H { n: 1, name: "a", f: inc }, H { n: 2, name: "b", f: dbl }],
        [H { n: 3, name: "c", f: dbl }, H { n: 4, name: "d", f: inc }],
    ];
    let mut total: i32 = 0;
    let mut r: usize = 0;
    while r < 2 {
        let mut q: usize = 0;
        while q < 2 {
            total = total + (g[r][q].f)(10) + g[r][q].n + g[q][r].n;
            q = q + 1;
        }
        r = r + 1;
    }
    print_int(total as i64);
    print("\n");
    0
}
