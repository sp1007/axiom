fn verify_phase1_queries_and_extraction() -> i32 {
    let mut db: CompilerDB = query_db_empty()
    query_db_init(mut_view(db), 1u64)
    let src_with_docs = ux2_sv("//! Bounded ring-buffer counters.\n//!\n//! Extra module details.\n// ordinary comment\n//// four-slash non-doc comment\n/// Fixed-capacity ring counter.\n///\n/// Body paragraph.\npub struct RingCounter { pub count: usize }\n")
    let src_without_docs = ux2_sv("// ordinary comment\npub struct RingCounter { pub count: usize }\n")

    let sf_id = SourceFileId { v: 1u32 }
    let mod_id = ModuleId { v: 1u32 }
    let st_def = DefId { v: 1u32 }
    let fn_def = DefId { v: 2u32 }
    let _ = query_db_set_source_file_input(
        mut_view(db),
        sf_id,
        ux2_sv("src/metrics/ring.ax"),
        src_with_docs,
        DURABILITY_LOW
    )
    let _ = query_db_set_module_tree_input(
        mut_view(db),
        mod_id,
        PackageId { v: 1u32 },
        ModuleId { v: 0u32 },
        ux2_sv("metrics.ring"),
        sf_id,
        DURABILITY_LOW
    )
    let _ = query_db_register_def(
        mut_view(db),
        st_def,
        mod_id,
        ITEM_KIND_STRUCT,
        true,
        0u32,
        1u32,
        doc_sem_key(ITEM_NS_TYPE, ux2_sv("metrics.ring"), ux2_sv("RingCounter"), ux2_sv("struct"))
    )
    let _ = query_db_register_def(
        mut_view(db),
        fn_def,
        mod_id,
        ITEM_KIND_FN,
        true,
        1u32,
        2u32,
        doc_sem_key(ITEM_NS_VALUE, ux2_sv("metrics.ring"), ux2_sv("average"), ux2_sv("fn(view<RingCounter>)->i64"))
    )

    let trace = docgen_eval_semantic_queries_zero_codegen(
        mut_view(db),
        mod_id,
        fn_def,
        st_def
    )
    if trace.codegen_invoked || trace.linker_invoked {
        query_db_free(mut_view(db))
        return 11
    }
    if trace.parse_module_evaluated != 1u32 ||
       trace.item_signature_evaluated != 2u32 ||
       (trace.memoized_hits) < 2u32 {
        query_db_free(mut_view(db))
        return 12
    }

    // Verify AXS-DOC-005 & REQ-TOOL-002/187 invariance
    if !docgen_verify_non_semantic_invariance(src_with_docs, src_without_docs) {
        query_db_free(mut_view(db))
        return 13
    }
    if !docgen_verify_build_feature_invariance(mut_view(db), fn_def) {
        query_db_free(mut_view(db))
        return 14
    }
    query_db_free(mut_view(db))

    // Verify AXS-DOC-002 inner `//!` and outer `///` extraction
    let mut b_in: DiagBuffer = diag_buf_new()
    docgen_extract_inner_doc(src_with_docs, mut_view(b_in))
    let sv_in = diag_buf_as_str_view(view(b_in))
    let sum_in = docgen_split_summary_and_body(sv_in)
    if !ux2_sv_eq(sum_in, ux2_sv("Bounded ring-buffer counters.")) ||
       !ux2_sv_contains(sv_in, ux2_sv("Extra module details.")) {
        diag_buf_free(mut_view(b_in))
        return 15
    }
    diag_buf_free(mut_view(b_in))

    let mut b_out: DiagBuffer = diag_buf_new()
    docgen_extract_outer_doc(src_with_docs, mut_view(b_out))
    let sv_out = diag_buf_as_str_view(view(b_out))
    let sum_out = docgen_split_summary_and_body(sv_out)
    if !ux2_sv_eq(sum_out, ux2_sv("Fixed-capacity ring counter.")) ||
       ux2_sv_contains(sv_out, ux2_sv("four-slash")) ||
       ux2_sv_contains(sv_out, ux2_sv("ordinary comment")) {
        diag_buf_free(mut_view(b_out))
        return 16
    }
    diag_buf_free(mut_view(b_out))
    0
}

fn verify_phase2_contracts_and_links() -> i32 {
    let mut g = docgen_build_metrics_ring_package(FileId { v: 1u32 })
    // Verify canonical sorting (`(module_path, kind_ordinal, name)`):
    // 0: struct RingCounter (`DOC_KIND_STRUCT = 1`)
    // 1: trait MetricSource (`DOC_KIND_TRAIT = 3`)
    // 2: fn average (`DOC_KIND_FN = 4`)
    // 3: fn debug_raw_slot (`DOC_KIND_FN = 4`)
    // 4: fn internal_slot_index (`DOC_KIND_FN = 4`)
    // 5: fn push_sample (`DOC_KIND_FN = 4`)
    if g.item_0.kind != DOC_KIND_STRUCT || !ux2_sv_eq(g.item_0.name, ux2_sv("RingCounter")) {
        return 21
    }
    if g.item_1.kind != DOC_KIND_TRAIT || !ux2_sv_eq(g.item_1.name, ux2_sv("MetricSource")) {
        return 22
    }
    if g.item_2.kind != DOC_KIND_FN || !ux2_sv_eq(g.item_2.name, ux2_sv("average")) {
        return 23
    }
    if !g.item_0.has_container_contract || !g.item_2.has_effect_summary {
        return 24
    }
    if g.item_5.param_0.passing_mode != DOC_PASS_MUT_VIEW ||
       g.item_5.param_1.passing_mode != DOC_PASS_COPY ||
       g.item_2.param_0.passing_mode != DOC_PASS_VIEW {
        return 25
    }

    let mut sink: DiagSink = diag_sink_new()
    let broken = docgen_resolve_intra_doc_links(mut_view(g), false, mut_view(sink))
    if broken != 0u32 || sink.errors != 0usize || sink.warnings != 0usize {
        diag_sink_free(mut_view(sink))
        return 26
    }
    if !g.item_0.link_0.is_resolved ||
       !ux2_sv_eq(g.item_0.link_0.resolved_href, ux2_sv("struct.RingCounter.html#method.push_sample")) {
        diag_sink_free(mut_view(sink))
        return 27
    }
    diag_sink_free(mut_view(sink))

    // Verify negative broken intra-doc link (`AX_NAME_UNRESOLVED` warning vs `--deny-broken-links` error)
    let mut bad_g1 = docgen_build_negative_doc_package(FileId { v: 2u32 })
    let mut sink_warn: DiagSink = diag_sink_new()
    let broken1 = docgen_resolve_intra_doc_links(mut_view(bad_g1), false, mut_view(sink_warn))
    if broken1 != 1u32 || sink_warn.warnings != 1usize || sink_warn.errors != 0usize {
        diag_sink_free(mut_view(sink_warn))
        return 28
    }
    diag_sink_free(mut_view(sink_warn))

    let mut bad_g2 = docgen_build_negative_doc_package(FileId { v: 2u32 })
    let mut sink_err: DiagSink = diag_sink_new()
    let broken2 = docgen_resolve_intra_doc_links(mut_view(bad_g2), true, mut_view(sink_err))
    if broken2 != 1u32 || sink_err.errors != 1usize {
        diag_sink_free(mut_view(sink_err))
        return 29
    }
    diag_sink_free(mut_view(sink_err))

    let mut b_diag: DiagBuffer = diag_buf_new()
    docgen_write_broken_link_diag_json(
        mut_view(b_diag),
        ux2_sv("NonExistentType.missing_method"),
        true
    )
    let sv_diag = diag_buf_as_str_view(view(b_diag))
    if !ux2_sv_contains(sv_diag, ux2_sv("\"code_name\":\"AX_NAME_UNRESOLVED\"")) ||
       !ux2_sv_contains(sv_diag, ux2_sv("\"context\":\"doc_link\"")) ||
       !ux2_sv_contains(sv_diag, ux2_sv("\"doc_link\":\"NonExistentType.missing_method\"")) {
        diag_buf_free(mut_view(b_diag))
        return 30
    }
    diag_buf_free(mut_view(b_diag))
    0
}

fn verify_phase3_html_search_and_json() -> i32 {
    let mut g = docgen_build_metrics_ring_package(FileId { v: 1u32 })
    let mut sink: DiagSink = diag_sink_new()
    let _ = docgen_resolve_intra_doc_links(mut_view(g), false, mut_view(sink))
    diag_sink_free(mut_view(sink))

    let mut html_a: DiagBuffer = diag_buf_new()
    let mut html_b: DiagBuffer = diag_buf_new()
    docgen_render_html_site(view(g), false, false, mut_view(html_a))
    docgen_render_html_site(view(g), false, false, mut_view(html_b))
    let sv_html_a = diag_buf_as_str_view(view(html_a))
    let sv_html_b = diag_buf_as_str_view(view(html_b))

    // Byte-for-byte determinism (`AXS-DOC-010`)
    if !ux2_sv_eq(sv_html_a, sv_html_b) {
        diag_buf_free(mut_view(html_a))
        diag_buf_free(mut_view(html_b))
        return 31
    }
    // Offline-first & hidden setup line stripping (`# let seed: i64 = 10` omitted)
    if ux2_sv_contains(sv_html_a, ux2_sv("http://")) ||
       ux2_sv_contains(sv_html_a, ux2_sv("https://")) ||
       ux2_sv_contains(sv_html_a, ux2_sv("# let seed")) ||
       !ux2_sv_contains(sv_html_a, ux2_sv("push_sample(mut_view(c), seed + 10)")) {
        diag_buf_free(mut_view(html_a))
        diag_buf_free(mut_view(html_b))
        return 32
    }
    // Private (`internal_slot_index`) and `@doc(hidden)` (`debug_raw_slot`) omitted by default
    if ux2_sv_contains(sv_html_a, ux2_sv("internal_slot_index")) ||
       ux2_sv_contains(sv_html_a, ux2_sv("debug_raw_slot")) {
        diag_buf_free(mut_view(html_a))
        diag_buf_free(mut_view(html_b))
        return 33
    }
    diag_buf_free(mut_view(html_a))
    diag_buf_free(mut_view(html_b))

    // With `--include-private` and `--include-hidden`, both appear
    let mut html_all: DiagBuffer = diag_buf_new()
    docgen_render_html_site(view(g), true, true, mut_view(html_all))
    let sv_all = diag_buf_as_str_view(view(html_all))
    if !ux2_sv_contains(sv_all, ux2_sv("internal_slot_index")) ||
       !ux2_sv_contains(sv_all, ux2_sv("debug_raw_slot")) {
        diag_buf_free(mut_view(html_all))
        return 34
    }
    diag_buf_free(mut_view(html_all))

    // Search index & `doc-graph.json` (`schema_version: 1`)
    let mut s_buf: DiagBuffer = diag_buf_new()
    let mut j_buf1: DiagBuffer = diag_buf_new()
    let mut j_buf2: DiagBuffer = diag_buf_new()
    docgen_render_search_index_json(view(g), false, false, mut_view(s_buf))
    docgen_render_doc_graph_json(view(g), false, false, mut_view(j_buf1))
    docgen_render_doc_graph_json(view(g), false, false, mut_view(j_buf2))
    let sv_s = diag_buf_as_str_view(view(s_buf))
    let sv_j1 = diag_buf_as_str_view(view(j_buf1))
    let sv_j2 = diag_buf_as_str_view(view(j_buf2))
    if !ux2_sv_eq(sv_j1, sv_j2) ||
       !ux2_sv_contains(sv_s, ux2_sv("\"format\":\"AXDOC_SEARCH\",\"schema_version\":1")) ||
       !ux2_sv_contains(sv_j1, ux2_sv("\"format\":\"AXDOC\",\"schema_version\":1")) ||
       !ux2_sv_contains(sv_j1, ux2_sv("\"container_contract\":{\"storage_kind\":\"HeapContiguous\"")) ||
       !ux2_sv_contains(sv_j1, ux2_sv("\"passing_mode\":\"mut_view\"")) {
        diag_buf_free(mut_view(s_buf))
        diag_buf_free(mut_view(j_buf1))
        diag_buf_free(mut_view(j_buf2))
        return 35
    }
    diag_buf_free(mut_view(s_buf))
    diag_buf_free(mut_view(j_buf1))
    diag_buf_free(mut_view(j_buf2))
    0
}

fn verify_phase4_doctest_runner_and_cli() -> i32 {
    // Fence parser (`AXS-DOC-051`)
    let mut blk: DocTestBlock = doc_test_block_empty()
    if docgen_parse_fence_info(ux2_sv("json"), mut_view(blk)) {
        return 41
    }
    if !docgen_parse_fence_info(ux2_sv("axiom,compile_fail(AX_CAP_CONFLICT_MUT)"), mut_view(blk)) ||
       blk.mode != DOC_TEST_COMPILE_FAIL ||
       blk.expected_diag_code != AX_CAP_CONFLICT_MUT {
        return 42
    }
    if !docgen_parse_fence_info(ux2_sv("axiom,should_panic(expected = \"empty ring\")"), mut_view(blk)) ||
       blk.mode != DOC_TEST_SHOULD_PANIC ||
       !ux2_sv_eq(blk.expected_panic_substr, ux2_sv("empty ring")) {
        return 43
    }

    let mut g = docgen_build_metrics_ring_package(FileId { v: 1u32 })
    // Wrapper synthesizer unprefixes `# let seed: i64 = 10`
    let mut h_buf: DiagBuffer = diag_buf_new()
    docgen_synthesize_doctest_harness(ux2_sv("metrics.ring"), g.item_0.doctest_0, mut_view(h_buf))
    let sv_h = diag_buf_as_str_view(view(h_buf))
    if !ux2_sv_contains(sv_h, ux2_sv("use metrics.ring.*")) ||
       !ux2_sv_contains(sv_h, ux2_sv("let seed: i64 = 10")) ||
       ux2_sv_contains(sv_h, ux2_sv("# let seed")) {
        diag_buf_free(mut_view(h_buf))
        return 44
    }
    diag_buf_free(mut_view(h_buf))

    // Span remapping back to original `.ax` doc comment line/col
    let remapped = docgen_remap_doctest_span(g.item_5.doctest_0, 3u32, 10u32)
    if remapped.source_line != 38u32 || remapped.source_col != 14u32 {
        return 45
    }

    // Run package doctests (`run`, `compile_fail(AX_CAP_CONFLICT_MUT)`, `no_run`, `should_panic`, `ignore`)
    let suite = docgen_run_package_doctests(view(g), false)
    if suite.total_blocks != 5u32 ||
       suite.passed_count != 4u32 ||
       suite.ignored_count != 1u32 ||
       suite.failed_count != 0u32 {
        return 46
    }

    // Negative `compile_fail` doctest that compiles cleanly MUST fail
    let bad_g = docgen_build_negative_doc_package(FileId { v: 2u32 })
    let bad_suite = docgen_run_package_doctests(view(bad_g), false)
    if bad_suite.failed_count != 1u32 {
        return 47
    }

    // CLI parser & `doc_cmd_execute` (`AXS-DOC-050`, `AXS-DOC-053`)
    let mut sink: DiagSink = diag_sink_new()
    let args_ok: [8]StrView = [
        ux2_sv("--out-dir"),
        ux2_sv("build/docs"),
        ux2_sv("--json"),
        ux2_sv("--test"),
        ux2_sv("src/metrics/ring.ax"),
        ux2_sv_empty(),
        ux2_sv_empty(),
        ux2_sv_empty()
    ]
    let opts_ok = doc_parse_cli_args(view(args_ok), 5usize, mut_view(sink))
    if opts_ok.has_usage_error || !opts_ok.emit_json || !opts_ok.run_doctests {
        diag_sink_free(mut_view(sink))
        return 48
    }
    let mut hb: DiagBuffer = diag_buf_new()
    let mut sb: DiagBuffer = diag_buf_new()
    let mut jb: DiagBuffer = diag_buf_new()
    let res_ok = doc_cmd_execute(
        opts_ok,
        mut_view(g),
        mut_view(hb),
        mut_view(sb),
        mut_view(jb),
        mut_view(sink)
    )
    diag_buf_free(mut_view(hb))
    diag_buf_free(mut_view(sb))
    diag_buf_free(mut_view(jb))
    if res_ok.exit_code != DOC_EXIT_OK || !res_ok.emitted_doc_graph_json || res_ok.doctest_passed != 4u32 {
        diag_sink_free(mut_view(sink))
        return 49
    }

    // Unknown CLI option -> `AX_DRIVER_UNKNOWN_OPTION` (exit code 2)
    let args_bad: [8]StrView = [
        ux2_sv("--bogus-doc-flag"),
        ux2_sv_empty(),
        ux2_sv_empty(),
        ux2_sv_empty(),
        ux2_sv_empty(),
        ux2_sv_empty(),
        ux2_sv_empty(),
        ux2_sv_empty()
    ]
    let opts_bad = doc_parse_cli_args(view(args_bad), 1usize, mut_view(sink))
    if !opts_bad.has_usage_error || opts_bad.exit_code != DOC_EXIT_USAGE {
        diag_sink_free(mut_view(sink))
        return 50
    }
    diag_sink_free(mut_view(sink))
    0
}

pub fn main() -> i32 {
    let rc1 = verify_phase1_queries_and_extraction()
    if rc1 != 0 { return rc1 }
    let rc2 = verify_phase2_contracts_and_links()
    if rc2 != 0 { return rc2 }
    let rc3 = verify_phase3_html_search_and_json()
    if rc3 != 0 { return rc3 }
    let rc4 = verify_phase4_doctest_runner_and_cli()
    if rc4 != 0 { return rc4 }
    let sv = ux2_sv("DOCGEN-PROBE-PASS\n")
    let _ = unsafe { write(stdio(1), sv.ptr, sv.len) }
    0
}
