// test: run
// modes: interp native
// stdout-file: html_json_determinism.stdout
//! Deterministic HTML/JSON item ordering & visibility filtering test (`AXS-DOC-010..012`).

@derive(Copy)
pub struct DocEntry {
    pub mod_id: i64,
    pub kind_ordinal: i64,
    pub name_rank: i64,
    pub is_private: bool,
    pub is_hidden: bool,
}

pub fn entry_less(a: DocEntry, b: DocEntry) -> bool {
    if a.mod_id != b.mod_id {
        return (a.mod_id) < b.mod_id
    }
    if a.kind_ordinal != b.kind_ordinal {
        return (a.kind_ordinal) < b.kind_ordinal
    }
    (a.name_rank) < b.name_rank
}

pub fn should_emit(e: DocEntry, include_priv: bool, include_hid: bool) -> bool {
    if e.is_private && !include_priv {
        return false
    }
    if e.is_hidden && !include_hid {
        return false
    }
    true
}

pub fn count_visible(
    entries: view<[6]DocEntry>,
    include_priv: bool,
    include_hid: bool
) -> i64 {
    let mut cnt: i64 = 0
    let mut i: usize = 0
    while i < 6usize {
        if should_emit((*entries)[i], include_priv, include_hid) {
            cnt = cnt + 1
        }
        i = i + 1
    }
    cnt
}

pub fn main() -> i32 {
    // Unsorted entries across kind_ordinal (1=struct, 3=trait, 4=fn)
    let mut items: [6]DocEntry = [
        DocEntry { mod_id: 1, kind_ordinal: 4, name_rank: 30, is_private: false, is_hidden: false },
        DocEntry { mod_id: 1, kind_ordinal: 4, name_rank: 20, is_private: true, is_hidden: false },
        DocEntry { mod_id: 1, kind_ordinal: 1, name_rank: 10, is_private: false, is_hidden: false },
        DocEntry { mod_id: 1, kind_ordinal: 4, name_rank: 15, is_private: false, is_hidden: true },
        DocEntry { mod_id: 1, kind_ordinal: 4, name_rank: 10, is_private: false, is_hidden: false },
        DocEntry { mod_id: 1, kind_ordinal: 3, name_rank: 10, is_private: false, is_hidden: false }
    ]

    let mut i: usize = 0
    while i < 6usize {
        let mut j: usize = i + 1
        while j < 6usize {
            if entry_less(items[j], items[i]) {
                let tmp = items[i]
                items[i] = items[j]
                items[j] = tmp
            }
            j = j + 1
        }
        i = i + 1
    }

    let c_default = count_visible(view(items), false, false)
    let c_priv = count_visible(view(items), true, false)
    let c_all = count_visible(view(items), true, true)
    if items[0].kind_ordinal != 1 || items[1].kind_ordinal != 3 || c_default != 4 || c_priv != 5 || c_all != 6 {
        return 1
    }
    print("HTML-JSON-DETERMINISM-OK\n")
    0
}
