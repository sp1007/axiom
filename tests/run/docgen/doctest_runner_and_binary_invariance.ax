// test: run
// modes: interp native
// stdout-file: doctest_runner_and_binary_invariance.stdout
//! Executable doc-test mode evaluation & span remapping verification (`AXS-DOC-051..052`).

pub const MODE_RUN: i64 = 0
pub const MODE_NO_RUN: i64 = 1
pub const MODE_COMPILE_FAIL: i64 = 2
pub const MODE_SHOULD_PANIC: i64 = 3
pub const MODE_IGNORE: i64 = 4

@derive(Copy)
pub struct DoctestCase {
    pub mode: i64,
    pub expected_diag: i64,
    pub actual_diag: i64,
    pub did_panic: bool,
    pub panic_matched: bool,
    pub fence_line: i64,
    pub fence_col: i64,
}

pub fn eval_doctest(c: DoctestCase, include_ignored: bool) -> i64 {
    // Returns: 1 = PASS, 0 = FAIL, 2 = IGNORED
    if c.mode == MODE_IGNORE && !include_ignored {
        return 2
    }
    if c.mode == MODE_NO_RUN {
        if c.actual_diag == 0 { return 1 } else { return 0 }
    }
    if c.mode == MODE_COMPILE_FAIL {
        if c.actual_diag == 0 {
            return 0
        }
        if c.expected_diag == 0 || c.actual_diag == c.expected_diag {
            return 1
        }
        return 0
    }
    if c.mode == MODE_SHOULD_PANIC {
        if c.actual_diag == 0 && c.did_panic && c.panic_matched {
            return 1
        }
        return 0
    }
    // MODE_RUN (or MODE_IGNORE with include_ignored = true)
    if c.actual_diag == 0 && !c.did_panic {
        1
    } else {
        0
    }
}

pub fn remap_line(fence_line: i64, offset: i64) -> i64 {
    fence_line + offset
}

pub fn remap_col(fence_col: i64, col: i64) -> i64 {
    fence_col + col - 1
}

pub fn main() -> i32 {
    let c_run = DoctestCase {
        mode: MODE_RUN,
        expected_diag: 0,
        actual_diag: 0,
        did_panic: false,
        panic_matched: false,
        fence_line: 12,
        fence_col: 5,
    }
    let c_cf_ok = DoctestCase {
        mode: MODE_COMPILE_FAIL,
        expected_diag: 201,
        actual_diag: 201,
        did_panic: false,
        panic_matched: false,
        fence_line: 35,
        fence_col: 5,
    }
    let c_cf_bad = DoctestCase {
        mode: MODE_COMPILE_FAIL,
        expected_diag: 105,
        actual_diag: 0,
        did_panic: false,
        panic_matched: false,
        fence_line: 5,
        fence_col: 5,
    }
    let c_sp_ok = DoctestCase {
        mode: MODE_SHOULD_PANIC,
        expected_diag: 0,
        actual_diag: 0,
        did_panic: true,
        panic_matched: true,
        fence_line: 62,
        fence_col: 5,
    }
    let c_ign = DoctestCase {
        mode: MODE_IGNORE,
        expected_diag: 0,
        actual_diag: 0,
        did_panic: false,
        panic_matched: false,
        fence_line: 65,
        fence_col: 5,
    }

    let r1 = eval_doctest(c_run, false)
    let r2 = eval_doctest(c_cf_ok, false)
    let r3 = eval_doctest(c_cf_bad, false)
    let r4 = eval_doctest(c_sp_ok, false)
    let r5 = eval_doctest(c_ign, false)
    let r6 = eval_doctest(c_ign, true)
    let src_line = remap_line(c_cf_ok.fence_line, 3)
    let src_col = remap_col(c_cf_ok.fence_col, 10)

    if r1 != 1 || r2 != 1 || r3 != 0 || r4 != 1 || r5 != 2 || r6 != 1 || src_line != 38 || src_col != 14 {
        return 1
    }
    print("DOCTEST-RUNNER-AND-BINARY-INVARIANCE-OK\n")
    0
}
