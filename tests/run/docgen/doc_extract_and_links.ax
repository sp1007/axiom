// test: run
// modes: interp native
// stdout-file: doc_extract_and_links.stdout
//! Bounded ring-buffer counters for deterministic telemetry (`SPEC-104 §7.2`).
//!
//! See [RingCounter] and [RingCounter.push_sample] for usage.

/// Fixed-capacity inline ring counter storing the last 4 samples.
///
/// # Examples
/// ```axiom
/// let mut c = ring_counter_new()
/// push_sample(mut_view(c), 20)
/// push_sample(mut_view(c), 40)
/// assert_eq(average(view(c)), 30)
/// ```
pub struct RingCounter {
    pub s0: i64,
    pub s1: i64,
    pub s2: i64,
    pub s3: i64,
    pub write_idx: i64,
    pub count: i64,
}

/// Creates a zero-initialized [RingCounter].
pub fn ring_counter_new() -> RingCounter {
    RingCounter {
        s0: 0,
        s1: 0,
        s2: 0,
        s3: 0,
        write_idx: 0,
        count: 0,
    }
}

/// Appends `sample` into [RingCounter], overwriting the oldest slot when full.
pub fn push_sample(self: mut_view<RingCounter>, sample: i64) {
    let idx = (*self).write_idx
    if idx == 0 {
        (*self).s0 = sample
    } else if idx == 1 {
        (*self).s1 = sample
    } else if idx == 2 {
        (*self).s2 = sample
    } else {
        (*self).s3 = sample
    }
    (*self).write_idx = (idx + 1) % 4
    if ((*self).count) < 4 {
        (*self).count = (*self).count + 1
    }
}

/// Returns the integer mean of recorded samples in [RingCounter], or `0` if empty.
pub fn average(self: view<RingCounter>) -> i64 {
    if (*self).count == 0 {
        return 0
    }
    let mut sum: i64 = 0
    if (*self).count >= 1 { sum = sum + (*self).s0 }
    if (*self).count >= 2 { sum = sum + (*self).s1 }
    if (*self).count >= 3 { sum = sum + (*self).s2 }
    if (*self).count >= 4 { sum = sum + (*self).s3 }
    sum / (*self).count
}

pub fn main() -> i32 {
    let mut c = ring_counter_new()
    push_sample(mut_view(c), 20)
    push_sample(mut_view(c), 40)
    let avg1 = average(view(c))
    push_sample(mut_view(c), 60)
    push_sample(mut_view(c), 80)
    let avg2 = average(view(c))
    // Overwrite oldest slot (20 -> 100): slots [100, 40, 60, 80] => sum 280 / 4 = 70
    push_sample(mut_view(c), 100)
    let avg3 = average(view(c))
    if avg1 != 30 || avg2 != 50 || avg3 != 70 {
        return 1
    }
    print("DOC-EXTRACT-AND-LINKS-OK\n")
    0
}
