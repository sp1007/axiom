// test: run
// modes: interp native
// stdout: 7 3 1 11 11 1\n
// T444 (T421 FU-1): a struct field `*mut Inner` whose pointee struct is declared later in the file.
// Fields written and read back through heap memory must use the pointee's real field offsets.

module std.sys.windows.heap

// Native host heap for this test program (same as std/sys/windows/heap.ax, as in tests/run/concurrency/tls).

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapReAlloc(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    if size == 0 {
        return 0 as *mut u8;
    }
    let h = GetProcessHeap();
    if h as usize == 0 {
        return 0 as *mut u8;
    }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_realloc(p: *mut u8, old_size: usize, new_size: usize, align: usize) -> *mut u8 {
    if p as usize == 0 {
        return __ax_host_heap_alloc(new_size, align);
    }
    if new_size == 0 {
        return 0 as *mut u8;
    }
    let h = GetProcessHeap();
    if h as usize == 0 {
        return 0 as *mut u8;
    }
    let alloc_bytes: usize = if new_size < 16 { 16 } else { new_size };
    HeapReAlloc(h, 8u32, p, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

module main

use std.core.host.heap_alloc
use std.core.host.heap_free

struct W {
    id: usize,
    inner: *mut Inner,
}

struct Inner {
    count: usize,
    ptr: *mut u8,
}

fn main() -> i32 {
    let buf = unsafe { heap_alloc(8usize, 8usize) };
    let ip = unsafe { heap_alloc(16usize, 8usize) as *mut Inner };
    let wp = unsafe { heap_alloc(16usize, 8usize) as *mut W };
    unsafe {
        (*ip).count = 3usize;
        (*ip).ptr = buf;
        (*wp).id = 7usize;
        (*wp).inner = ip;
    }
    let id = unsafe { (*wp).id };
    let count = unsafe { (*(*wp).inner).count };
    let p = unsafe { (*(*wp).inner).ptr };
    print_int(id as i64);
    print(" ");
    print_int(count as i64);
    print(" ");
    print_int(if (p as usize) == (buf as usize) { 1i64 } else { 0i64 });
    unsafe {
        (*(*wp).inner).count = 11usize;
    }
    let count2 = unsafe { (*ip).count };
    let count3 = unsafe { (*(*wp).inner).count };
    let p2 = unsafe { (*ip).ptr };
    print(" ");
    print_int(count2 as i64);
    print(" ");
    print_int(count3 as i64);
    print(" ");
    print_int(if (p2 as usize) == (buf as usize) { 1i64 } else { 0i64 });
    print("\n");
    unsafe {
        heap_free(wp as *mut u8, 16usize, 8usize);
        heap_free(ip as *mut u8, 16usize, 8usize);
        heap_free(buf, 8usize, 8usize);
    }
    0
}
