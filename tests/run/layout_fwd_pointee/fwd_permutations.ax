// test: run
// modes: interp native
// stdout: A 1 2 3\n
// stdout: B 10 20 30 40\n
// stdout: C 5 6 7\n
// stdout: D 100 200 300\n
// stdout: E 7 9\n
// stdout: F 11 22 33 44\n
// stdout: G 24 16 40\n
// T444 (T421 FU-1): field offsets do not depend on declaration order. Covers a by-value field of a later
// struct, a self-referential list node, two structs pointing at each other, a later generic struct behind a
// pointer, a later enum by value, nested pointers to later structs, and size_of of the forward users.

module std.sys.windows.heap

// Native host heap for this test program (same as std/sys/windows/heap.ax, as in tests/run/concurrency/tls).

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapReAlloc(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    if size == 0 {
        return 0 as *mut u8;
    }
    let h = GetProcessHeap();
    if h as usize == 0 {
        return 0 as *mut u8;
    }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_realloc(p: *mut u8, old_size: usize, new_size: usize, align: usize) -> *mut u8 {
    if p as usize == 0 {
        return __ax_host_heap_alloc(new_size, align);
    }
    if new_size == 0 {
        return 0 as *mut u8;
    }
    let h = GetProcessHeap();
    if h as usize == 0 {
        return 0 as *mut u8;
    }
    let alloc_bytes: usize = if new_size < 16 { 16 } else { new_size };
    HeapReAlloc(h, 8u32, p, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

module main

use std.core.host.heap_alloc
use std.core.host.heap_free

@intrinsic fn size_of<T>() -> usize { 0 }

// A: by-value field of a struct declared later.
struct OuterA {
    a: u8,
    mid: InnerA,
    z: u32,
}

struct InnerA {
    x: u64,
    y: u16,
}

// B: self-referential node.
struct Node {
    val: u32,
    next: *mut Node,
    tag: u64,
}

// C: mutual pointers, first one declared before the second.
struct Ping {
    p: u16,
    pong: *mut Pong,
}

struct Pong {
    q: u64,
    r: u8,
    ping: *mut Ping,
}

// D: a later generic struct behind a pointer.
struct HoldsG {
    k: u8,
    g: *mut Gen<u64>,
}

struct Gen<T> {
    small: u8,
    big: T,
    last: u32,
}

// E: a later enum by value.
struct HoldsE {
    flag: u8,
    e: Choice,
    n: u64,
}

enum Choice {
    Nothing,
    Pair(u64, u64),
}

// F: a chain of pointers to structs declared later, in reverse order.
struct L1 {
    a: u32,
    l2: *mut L2,
}

struct L2 {
    b: u8,
    l3: *mut L3,
}

struct L3 {
    c: u16,
    d: u64,
    e: u32,
}

fn choice_first(c: view<Choice>) -> i64 {
    match *c {
        Choice.Pair(a, _) => a as i64,
        Choice.Nothing => -1i64,
    }
}

fn choice_second(c: view<Choice>) -> i64 {
    match *c {
        Choice.Pair(_, b) => b as i64,
        Choice.Nothing => -1i64,
    }
}

fn main() -> i32 {
    // A
    let oa = OuterA { a: 1u8, mid: InnerA { x: 2u64, y: 3u16 }, z: 0u32 };
    print("A ");
    print_int(oa.a as i64);
    print(" ");
    print_int(oa.mid.x as i64);
    print(" ");
    print_int(oa.mid.y as i64);
    print("\n");

    // B
    let n1 = unsafe { heap_alloc(24usize, 8usize) as *mut Node };
    let n2 = unsafe { heap_alloc(24usize, 8usize) as *mut Node };
    unsafe {
        (*n2).val = 20u32;
        (*n2).tag = 40u64;
        (*n2).next = 0 as *mut Node;
        (*n1).val = 10u32;
        (*n1).tag = 30u64;
        (*n1).next = n2;
    }
    let b1 = unsafe { (*n1).val };
    let b2 = unsafe { (*(*n1).next).val };
    let b3 = unsafe { (*n1).tag };
    let b4 = unsafe { (*(*n1).next).tag };
    print("B ");
    print_int(b1 as i64);
    print(" ");
    print_int(b2 as i64);
    print(" ");
    print_int(b3 as i64);
    print(" ");
    print_int(b4 as i64);
    print("\n");

    // C
    let pi = unsafe { heap_alloc(16usize, 8usize) as *mut Ping };
    let po = unsafe { heap_alloc(24usize, 8usize) as *mut Pong };
    unsafe {
        (*pi).p = 5u16;
        (*pi).pong = po;
        (*po).q = 6u64;
        (*po).r = 7u8;
        (*po).ping = pi;
    }
    let c1 = unsafe { (*(*(*pi).pong).ping).p };
    let c2 = unsafe { (*(*pi).pong).q };
    let c3 = unsafe { (*(*pi).pong).r };
    print("C ");
    print_int(c1 as i64);
    print(" ");
    print_int(c2 as i64);
    print(" ");
    print_int(c3 as i64);
    print("\n");

    // D
    let gp = unsafe { heap_alloc(24usize, 8usize) as *mut Gen<u64> };
    let mut hg = HoldsG { k: 0u8, g: gp };
    unsafe {
        (*hg.g).small = 100u8;
        (*hg.g).big = 200u64;
        (*hg.g).last = 300u32;
    }
    hg.k = 1u8;
    let d1 = unsafe { (*gp).small };
    let d2 = unsafe { (*gp).big };
    let d3 = unsafe { (*hg.g).last };
    print("D ");
    print_int(d1 as i64);
    print(" ");
    print_int(d2 as i64);
    print(" ");
    print_int(d3 as i64);
    print("\n");

    // E
    let he = HoldsE { flag: 1u8, e: Choice.Pair(7u64, 9u64), n: 0u64 };
    print("E ");
    print_int(choice_first(view(he.e)));
    print(" ");
    print_int(choice_second(view(he.e)));
    print("\n");

    // F
    let p1 = unsafe { heap_alloc(16usize, 8usize) as *mut L1 };
    let p2 = unsafe { heap_alloc(16usize, 8usize) as *mut L2 };
    let p3 = unsafe { heap_alloc(16usize, 8usize) as *mut L3 };
    unsafe {
        (*p1).a = 11u32;
        (*p1).l2 = p2;
        (*p2).b = 22u8;
        (*p2).l3 = p3;
        (*p3).c = 33u16;
        (*p3).d = 44u64;
        (*p3).e = 55u32;
    }
    let f1 = unsafe { (*p1).a };
    let f2 = unsafe { (*(*p1).l2).b };
    let f3 = unsafe { (*(*(*p1).l2).l3).c };
    let f4 = unsafe { (*(*(*p1).l2).l3).d };
    print("F ");
    print_int(f1 as i64);
    print(" ");
    print_int(f2 as i64);
    print(" ");
    print_int(f3 as i64);
    print(" ");
    print_int(f4 as i64);
    print("\n");

    // G: sizes of the forward users (OuterA = u64 + u16 inner (16) + u8 + u32 -> 24; L3 = 16; HoldsE = enum 24 + u64 + u8 -> 40).
    print("G ");
    print_int(size_of<OuterA>() as i64);
    print(" ");
    print_int(size_of<L3>() as i64);
    print(" ");
    print_int(size_of<HoldsE>() as i64);
    print("\n");

    unsafe {
        heap_free(n1 as *mut u8, 24usize, 8usize);
        heap_free(n2 as *mut u8, 24usize, 8usize);
        heap_free(pi as *mut u8, 16usize, 8usize);
        heap_free(po as *mut u8, 24usize, 8usize);
        heap_free(gp as *mut u8, 24usize, 8usize);
        heap_free(p1 as *mut u8, 16usize, 8usize);
        heap_free(p2 as *mut u8, 16usize, 8usize);
        heap_free(p3 as *mut u8, 16usize, 8usize);
    }
    0
}
