// test: run
// modes: interp native
// stdout: S 7 3 1\n
// stdout: GN 42 99 101 202\n
// stdout: GM 11 22 33 44\n
// stdout: GE 77 88\n
// stdout: M 12 1 1 34\n
// T444 (ADR-0043 §1, INV-SEM-008): generic cyclic struct/enum substitution (types.ax + mono.ax shell-first),
// mutual generic cycle refreshed in pass 1a (tc_refresh_adt_instances), swapped FU-1 declaration order,
// and an additional std.* module path with a Waker field.

module std.sys.windows.heap

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapReAlloc(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    if size == 0 {
        return 0 as *mut u8;
    }
    let h = GetProcessHeap();
    if h as usize == 0 {
        return 0 as *mut u8;
    }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_realloc(p: *mut u8, old_size: usize, new_size: usize, align: usize) -> *mut u8 {
    if p as usize == 0 {
        return __ax_host_heap_alloc(new_size, align);
    }
    if new_size == 0 {
        return 0 as *mut u8;
    }
    let h = GetProcessHeap();
    if h as usize == 0 {
        return 0 as *mut u8;
    }
    let alloc_bytes: usize = if new_size < 16 { 16 } else { new_size };
    HeapReAlloc(h, 8u32, p, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

module std.core.zz_waker_perm

use std.core.host.heap_alloc
use std.core.host.heap_free
use std.core.prelude.RawWaker
use std.core.prelude.RawWakerVTable
use std.core.prelude.Waker

pub struct PermNode {
    pub head: usize,
    pub waker: Waker,
    pub tail: usize,
}

pub fn check_std_core_perm() {
    let n = unsafe { heap_alloc(32usize, 8usize) as *mut PermNode };
    let b1 = unsafe { heap_alloc(8usize, 8usize) };
    let b2 = unsafe { heap_alloc(32usize, 8usize) };
    let w = Waker {
        raw: RawWaker {
            data: b1 as *const u8,
            vtable: b2 as *const RawWakerVTable,
        },
    };
    unsafe {
        (*n).head = 12usize;
        (*n).tail = 34usize;
        (*n).waker = w;
    }
    let h = unsafe { (*n).head };
    let d: i64 = if unsafe { (*n).waker.raw.data as usize } == (b1 as usize) { 1i64 } else { 0i64 };
    let v: i64 = if unsafe { (*n).waker.raw.vtable as usize } == (b2 as usize) { 1i64 } else { 0i64 };
    let t = unsafe { (*n).tail };
    print("M ");
    print_int(h as i64);
    print(" ");
    print_int(d);
    print(" ");
    print_int(v);
    print(" ");
    print_int(t as i64);
    print("\n");
    unsafe {
        heap_free(n as *mut u8, 32usize, 8usize);
        heap_free(b1, 8usize, 8usize);
        heap_free(b2, 32usize, 8usize);
    }
}

module main

use std.core.host.heap_alloc
use std.core.host.heap_free
use std.core.zz_waker_perm.check_std_core_perm

// Swapped FU-1 order: InnerS declared before WS.
struct InnerS {
    count: usize,
    ptr: *mut u8,
}

struct WS {
    id: usize,
    inner: *mut InnerS,
}

// Generic self-referential struct (mono.ax subst_ty_adt shell-first).
struct GNode<T> {
    val: T,
    next: *mut GNode<T>,
    tag: u64,
}

fn gnode_read_next_tag<T>(p: *mut GNode<T>) -> u64 {
    unsafe { (*(*p).next).tag }
}

fn gnode_read_val<T>(p: *mut GNode<T>) -> T {
    unsafe { (*p).val }
}

// Mutual generic cycle where GB instantiates GA<u8> while GA is still a shell (tc_refresh_adt_instances).
struct GA<T> {
    x: T,
    b: *mut GB<T>,
}

struct GB<T> {
    y: T,
    a: *mut GA<u8>,
}

fn ga_read_b_y<T>(p: *mut GA<T>) -> T {
    unsafe { (*(*p).b).y }
}

// Generic cyclic enum (mono.ax subst_ty_enum_or_closure shell-first).
enum GTree<T> {
    Leaf(T),
    Branch(u64, *mut GTree<T>),
}

fn gtree_branch_tag<T>(t: view<GTree<T>>) -> u64 {
    match *t {
        GTree.Branch(k, _) => k,
        GTree.Leaf(_) => 0u64,
    }
}

fn gtree_branch_child<T>(t: view<GTree<T>>) -> *mut GTree<T> {
    match *t {
        GTree.Branch(_, p) => p,
        GTree.Leaf(_) => 0 as *mut GTree<T>,
    }
}

fn gtree_leaf_val<T>(t: view<GTree<T>>) -> T {
    match *t {
        GTree.Leaf(v) => v,
        GTree.Branch(_, _) => loop {},
    }
}

fn main() -> i32 {
    // S: swapped FU-1 order
    let buf = unsafe { heap_alloc(8usize, 8usize) };
    let ip = unsafe { heap_alloc(16usize, 8usize) as *mut InnerS };
    let wp = unsafe { heap_alloc(16usize, 8usize) as *mut WS };
    unsafe {
        (*ip).count = 3usize;
        (*ip).ptr = buf;
        (*wp).id = 7usize;
        (*wp).inner = ip;
    }
    let sid = unsafe { (*wp).id };
    let scount = unsafe { (*(*wp).inner).count };
    let sp_ok: i64 = if unsafe { (*(*wp).inner).ptr as usize } == (buf as usize) { 1i64 } else { 0i64 };
    print("S ");
    print_int(sid as i64);
    print(" ");
    print_int(scount as i64);
    print(" ");
    print_int(sp_ok);
    print("\n");
    unsafe {
        heap_free(wp as *mut u8, 16usize, 8usize);
        heap_free(ip as *mut u8, 16usize, 8usize);
        heap_free(buf, 8usize, 8usize);
    }

    // GN: generic self-referential struct instantiated with u64 and u32
    let gn1 = unsafe { heap_alloc(24usize, 8usize) as *mut GNode<u64> };
    let gn2 = unsafe { heap_alloc(24usize, 8usize) as *mut GNode<u64> };
    unsafe {
        (*gn2).val = 99u64;
        (*gn2).next = 0 as *mut GNode<u64>;
        (*gn2).tag = 101u64;
        (*gn1).val = 42u64;
        (*gn1).next = gn2;
        (*gn1).tag = 55u64;
    }
    let gs1 = unsafe { heap_alloc(24usize, 8usize) as *mut GNode<u32> };
    let gs2 = unsafe { heap_alloc(24usize, 8usize) as *mut GNode<u32> };
    unsafe {
        (*gs2).val = 7u32;
        (*gs2).next = 0 as *mut GNode<u32>;
        (*gs2).tag = 202u64;
        (*gs1).val = 3u32;
        (*gs1).next = gs2;
        (*gs1).tag = 1u64;
    }
    print("GN ");
    print_int(gnode_read_val<u64>(gn1) as i64);
    print(" ");
    print_int(gnode_read_val<u64>(gn2) as i64);
    print(" ");
    print_int(gnode_read_next_tag<u64>(gn1) as i64);
    print(" ");
    print_int(gnode_read_next_tag<u32>(gs1) as i64);
    print("\n");
    unsafe {
        heap_free(gn1 as *mut u8, 24usize, 8usize);
        heap_free(gn2 as *mut u8, 24usize, 8usize);
        heap_free(gs1 as *mut u8, 24usize, 8usize);
        heap_free(gs2 as *mut u8, 24usize, 8usize);
    }

    // GM: mutual generic cycle GA<u64> -> GB<u64> -> GA<u8> -> GB<u8>
    let ga64 = unsafe { heap_alloc(16usize, 8usize) as *mut GA<u64> };
    let gb64 = unsafe { heap_alloc(16usize, 8usize) as *mut GB<u64> };
    let ga8 = unsafe { heap_alloc(16usize, 8usize) as *mut GA<u8> };
    let gb8 = unsafe { heap_alloc(16usize, 8usize) as *mut GB<u8> };
    unsafe {
        (*ga64).x = 11u64;
        (*ga64).b = gb64;
        (*gb64).y = 22u64;
        (*gb64).a = ga8;
        (*ga8).x = 33u8;
        (*ga8).b = gb8;
        (*gb8).y = 44u8;
        (*gb8).a = 0 as *mut GA<u8>;
    }
    let m1 = unsafe { (*ga64).x };
    let m2 = ga_read_b_y<u64>(ga64);
    let m3 = unsafe { (*(*(*ga64).b).a).x };
    let m4 = ga_read_b_y<u8>(ga8);
    print("GM ");
    print_int(m1 as i64);
    print(" ");
    print_int(m2 as i64);
    print(" ");
    print_int(m3 as i64);
    print(" ");
    print_int(m4 as i64);
    print("\n");
    unsafe {
        heap_free(ga64 as *mut u8, 16usize, 8usize);
        heap_free(gb64 as *mut u8, 16usize, 8usize);
        heap_free(ga8 as *mut u8, 16usize, 8usize);
        heap_free(gb8 as *mut u8, 16usize, 8usize);
    }

    // GE: generic cyclic enum
    let leaf_p = unsafe { heap_alloc(24usize, 8usize) as *mut GTree<u64> };
    unsafe {
        *leaf_p = GTree.Leaf(88u64);
    }
    let root: GTree<u64> = GTree.Branch(77u64, leaf_p);
    let k = gtree_branch_tag<u64>(view(root));
    let ch = gtree_branch_child<u64>(view(root));
    let lv = gtree_leaf_val<u64>(unsafe { view(*ch) });
    print("GE ");
    print_int(k as i64);
    print(" ");
    print_int(lv as i64);
    print("\n");
    unsafe {
        heap_free(leaf_p as *mut u8, 24usize, 8usize);
    }

    // M: std.core.zz_waker_perm permutation
    check_std_core_perm();
    0
}
