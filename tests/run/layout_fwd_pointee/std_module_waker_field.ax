// test: run
// modes: interp native
// stdout: std 5 1 1 9\n
// stdout: zz 5 1 1 9\n
// T444 (T421 FU-3): a node struct with a `Waker` field (prelude `@lang("waker")`, whose `RawWaker` holds a
// pointer to the later-declared `RawWakerVTable`) declared in a module whose path starts with `std`. Storing a
// waker through a raw pointer and reading `(*n).waker.raw.data` / `.vtable` must give the stored words, exactly
// like the identical struct in a non-std module.

module std.sys.windows.heap

// Native host heap for this test program (same as std/sys/windows/heap.ax, as in tests/run/concurrency/tls).

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapReAlloc(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    if size == 0 {
        return 0 as *mut u8;
    }
    let h = GetProcessHeap();
    if h as usize == 0 {
        return 0 as *mut u8;
    }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_realloc(p: *mut u8, old_size: usize, new_size: usize, align: usize) -> *mut u8 {
    if p as usize == 0 {
        return __ax_host_heap_alloc(new_size, align);
    }
    if new_size == 0 {
        return 0 as *mut u8;
    }
    let h = GetProcessHeap();
    if h as usize == 0 {
        return 0 as *mut u8;
    }
    let alloc_bytes: usize = if new_size < 16 { 16 } else { new_size };
    HeapReAlloc(h, 8u32, p, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

module std.asyn.zz

use std.core.host.heap_alloc
use std.core.host.heap_free
use std.core.prelude.RawWaker
use std.core.prelude.RawWakerVTable
use std.core.prelude.Waker

pub struct Node {
    pub id: usize,
    pub waker: Waker,
    pub tail: usize,
}

pub fn run_std() {
    let n = unsafe { heap_alloc(32usize, 8usize) as *mut Node };
    let b1 = unsafe { heap_alloc(8usize, 8usize) };
    let b2 = unsafe { heap_alloc(32usize, 8usize) };
    let w = Waker {
        raw: RawWaker {
            data: b1 as *const u8,
            vtable: b2 as *const RawWakerVTable,
        },
    };
    unsafe {
        (*n).id = 5usize;
        (*n).tail = 9usize;
        (*n).waker = w;
    }
    let id = unsafe { (*n).id };
    let d: i64 = if unsafe { (*n).waker.raw.data as usize } == (b1 as usize) { 1i64 } else { 0i64 };
    let v: i64 = if unsafe { (*n).waker.raw.vtable as usize } == (b2 as usize) { 1i64 } else { 0i64 };
    let t = unsafe { (*n).tail };
    print("std ");
    print_int(id as i64);
    print(" ");
    print_int(d);
    print(" ");
    print_int(v);
    print(" ");
    print_int(t as i64);
    print("\n");
    unsafe {
        heap_free(n as *mut u8, 32usize, 8usize);
        heap_free(b1, 8usize, 8usize);
        heap_free(b2, 32usize, 8usize);
    }
}

module zz.yy

use std.core.host.heap_alloc
use std.core.host.heap_free
use std.core.prelude.RawWaker
use std.core.prelude.RawWakerVTable
use std.core.prelude.Waker

pub struct Node {
    pub id: usize,
    pub waker: Waker,
    pub tail: usize,
}

pub fn run_zz() {
    let n = unsafe { heap_alloc(32usize, 8usize) as *mut Node };
    let b1 = unsafe { heap_alloc(8usize, 8usize) };
    let b2 = unsafe { heap_alloc(32usize, 8usize) };
    let w = Waker {
        raw: RawWaker {
            data: b1 as *const u8,
            vtable: b2 as *const RawWakerVTable,
        },
    };
    unsafe {
        (*n).id = 5usize;
        (*n).tail = 9usize;
        (*n).waker = w;
    }
    let id = unsafe { (*n).id };
    let d: i64 = if unsafe { (*n).waker.raw.data as usize } == (b1 as usize) { 1i64 } else { 0i64 };
    let v: i64 = if unsafe { (*n).waker.raw.vtable as usize } == (b2 as usize) { 1i64 } else { 0i64 };
    let t = unsafe { (*n).tail };
    print("zz ");
    print_int(id as i64);
    print(" ");
    print_int(d);
    print(" ");
    print_int(v);
    print(" ");
    print_int(t as i64);
    print("\n");
    unsafe {
        heap_free(n as *mut u8, 32usize, 8usize);
        heap_free(b1, 8usize, 8usize);
        heap_free(b2, 32usize, 8usize);
    }
}

module main

use std.asyn.zz.run_std
use zz.yy.run_zz

fn main() -> i32 {
    run_std();
    run_zz();
    0
}
