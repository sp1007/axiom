enum Color { Red, Green, Blue }

fn main() -> i32 {
    let mut x: i32 = 0;
    let c = Color.Red;
    match c {
        Color.Red => { x = x + 1; },
        Color.Green => { x = x + 2; },
        Color.Blue => { x = x + 3; },
    }
    
    let c2 = Color.Blue;
    match c2 {
        Color.Red => { x = x + 1; },
        Color.Green => { x = x + 2; },
        Color.Blue => { x = x + 3; },
    }
    
    return x - 4;
}
