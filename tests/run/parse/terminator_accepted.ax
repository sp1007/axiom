// test: run
// exit: 88
// T146 / AXS-GRM-011: every accepted statement terminator (`;`, a line break, `}`), and the code that the old
// parser silently dropped when more than one statement shared a line.
//
// Expected value, by hand: early(false) = 6, early(true) = 5, one_line() = 3, assign_chain() = 12,
// in_call() = (4 + 1) * 2 = 10, arms(-1) = 8, arms(5) = 9, braces() = 5, checked(true) = 10,
// checked(false) = 20; the sum is 88.

fn id(x: i32) -> i32 {
    x
}

// `;` after a block-like statement, then a second statement on the same line.
fn early(c: bool) -> i32 {
    if c { return 5; }; return 6;
}

// Several `;`-terminated statements on one line, the last one without `;` before `}`.
fn one_line() -> i32 {
    let a = 1; let b = 2; a + b
}

// An assignment followed by `;` and more statements on the same line (the old parser dropped the tail).
fn assign_chain() -> i32 {
    let mut x = 0
    x = 1; x = x + 2; x = x * 4
    x
}

// A block inside a call argument: line breaks still end statements inside `{ }` (AXS-GRM-010).
fn in_call() -> i32 {
    id({
        let a = 4 + 1
        let b = a * 2
        b
    })
}

// Match arms on separate lines inside parentheses: the arm starting with `-1` must not continue the previous arm.
fn arms(n: i32) -> i32 {
    id(match n {
        0 => 7
        -1 => 8
        _ => 9
    })
}

// `}` terminates the last statement of a block and of an expression block.
fn braces() -> i32 {
    let mut total = 0
    if total == 0 { total = 2 } else { total = 3 };
    { total = total + 3 }
    total
}

// `v = 20; v` after an `if` whose body ends in `return v;`: both forms of `;` on one line.
fn checked(c: bool) -> i32 {
    let mut v = 0
    if c { v = 10; return v; }
    v = 20; v
}

fn main() -> i32 {
    let mut sum = 0
    sum = sum + early(false) + early(true)
    sum = sum + one_line() + assign_chain() + in_call()
    sum = sum + arms(-1) + arms(5) + braces()
    sum = sum + checked(true) + checked(false)
    sum
}
