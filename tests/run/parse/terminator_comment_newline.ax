// test: run
// exit: 7
// T146 QA, lexer/parser seam: a block comment that contains a line feed gives the next token NL_BEFORE
// (AXS-LEX-013), so it terminates the statement before it (AXS-GRM-011); a line comment ends the line too.
// The same-line form `let a = 3 /* c */ let b = 4` is rejected (tests/ui/parse/terminator_comment_same_line.ax).
// Expected value by hand: a = 3, b = 4, a + b = 7.

fn main() -> i32 {
    let a = 3 /* this comment
    spans two lines */ let b = 4
    let c = a + b // trailing line comment
    c
}
