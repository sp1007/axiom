// test: run
// exit: 5
// AXS-GRM-011 accepted forms for items and statements that share a line: an explicit `;` between them.
// Expected value by hand: pick(1) takes the early return (q.y = 2); pick(0) skips the `if` and returns
// a() + b() + 2 = 1 + 2 + 2 = 5; main returns 2 + 5 - 2 = 5. If the old parser dropped the tail of a line,
// `return a() + b() + 2` would be missing and the program would not type-check.
struct S { x: i32 } ; struct T { y: i32 }

fn a() -> i32 { 1 }; fn b() -> i32 { 2 }

fn pick(flag: i32) -> i32 {
    let p = S { x: flag }; let q = T { y: 2 };
    if p.x == 1 { return q.y; }; return a() + b() + 2;
}

fn main() -> i32 {
    return pick(1) + pick(0) - 2;
}
