// Bundled E19.3 CompilerDB Semantic Refactorings & LSP `codeAction` Probe (T809).
// Exercises `std.editor` + `compiler.query.db` + `compiler.lsp.protocol` +
// `compiler.lsp.vfs` + `compiler.lsp.handlers` + `compiler.refactor.transforms` +
// `compiler.refactor.code_actions` end-to-end across `--interp`, `-O0`, `-O1`, and `-O2 --verify-each`.

module main

use std.editor.LspPosition
use std.editor.LspRange
use std.editor.lsp_pos_new
use std.editor.lsp_range_new
use std.editor.editor_snapshot

use compiler.lsp.protocol.LSP_ERR_NONE
use compiler.lsp.protocol.LSP_ERR_CONTENT_MODIFIED
use compiler.lsp.protocol.lsp_str_view

use compiler.lsp.vfs.VfsWorkspace
use compiler.lsp.vfs.LspSymbolId
use compiler.lsp.vfs.FunctionId
use compiler.lsp.vfs.LspTypeId
use compiler.lsp.vfs.LocalId
use compiler.lsp.vfs.OWNERSHIP_OWNED
use compiler.lsp.vfs.OWNERSHIP_VIEW
use compiler.lsp.vfs.CAP_NONE
use compiler.lsp.vfs.DIAG_BORROW_CONFLICT
use compiler.lsp.vfs.gen_id_new
use compiler.lsp.vfs.vfs_workspace_new
use compiler.lsp.vfs.vfs_workspace_free
use compiler.lsp.vfs.vfs_hash_str
use compiler.lsp.vfs.vfs_did_open
use compiler.lsp.vfs.vfs_doc_ptr
use compiler.lsp.vfs.vfs_intern_type
use compiler.lsp.vfs.vfs_intern_function
use compiler.lsp.vfs.vfs_intern_symbol
use compiler.lsp.vfs.vfs_intern_local

use compiler.lsp.handlers.LspSemanticEngine
use compiler.lsp.handlers.DIAG_CAP_OUTLIVES_OWNER
use compiler.lsp.handlers.DIAG_MOVE_USE_AFTER_MOVE
use compiler.lsp.handlers.DIAG_NAME_DUPLICATE
use compiler.lsp.handlers.DIAG_UNSAFE_REQUIRED
use compiler.lsp.handlers.APPLICABILITY_MACHINE_APPLICABLE
use compiler.lsp.handlers.APPLICABILITY_HAS_PLACEHOLDERS
use compiler.lsp.handlers.CODE_ACTION_KIND_QUICKFIX
use compiler.lsp.handlers.CODE_ACTION_KIND_SOURCE_ORGANIZE_IMPORTS
use compiler.lsp.handlers.DISPATCH_NONE
use compiler.lsp.handlers.SYM_KIND_FUNCTION
use compiler.lsp.handlers.SYM_KIND_VARIABLE
use compiler.lsp.handlers.SEM_TOK_FUNCTION
use compiler.lsp.handlers.SEM_TOK_VARIABLE
use compiler.lsp.handlers.lsp_engine_new
use compiler.lsp.handlers.lsp_engine_free
use compiler.lsp.handlers.lsp_register_node
use compiler.lsp.handlers.lsp_handle_code_action
use compiler.lsp.handlers.lsp_handle_code_action_resolve

use compiler.refactor.transforms.REFACTOR_OK
use compiler.refactor.transforms.REFACTOR_PRECONDITION_FAILED
use compiler.refactor.transforms.REFACTOR_OWNERSHIP_CONFLICT
use compiler.refactor.transforms.REFACTOR_CAPABILITY_CONFLICT
use compiler.refactor.transforms.REFACTOR_NAME_COLLISION
use compiler.refactor.transforms.REFACTOR_UNSAFE_SYNTHESIS_FORBIDDEN
use compiler.refactor.transforms.REFACTOR_EXTRACT_FUNCTION
use compiler.refactor.transforms.REFACTOR_ORGANIZE_IMPORTS
use compiler.refactor.transforms.PARAM_MODE_BY_COPY
use compiler.refactor.transforms.PARAM_MODE_READ_VIEW
use compiler.refactor.transforms.PARAM_MODE_MUT_VIEW
use compiler.refactor.transforms.SCRUTINEE_ENUM
use compiler.refactor.transforms.VARIANT_UNIT
use compiler.refactor.transforms.VARIANT_TUPLE
use compiler.refactor.transforms.VARIANT_STRUCT
use compiler.refactor.transforms.CAP_CONV_VIEW_TO_MUT_VIEW
use compiler.refactor.transforms.ExtractFunctionRequest
use compiler.refactor.transforms.ExtractVariableRequest
use compiler.refactor.transforms.InlineVariableRequest
use compiler.refactor.transforms.PopulateMatchArmsRequest
use compiler.refactor.transforms.OrganizeImportsRequest
use compiler.refactor.transforms.ChangeSignatureRequest
use compiler.refactor.transforms.MoveItemRequest
use compiler.refactor.transforms.ConvertCapabilityViewRequest
use compiler.refactor.transforms.refactor_sv_eq
use compiler.refactor.transforms.refactor_workspace_edit_empty
use compiler.refactor.transforms.refactor_workspace_edit_add
use compiler.refactor.transforms.refactor_verify_and_commit_edit
use compiler.refactor.transforms.extract_capture_var_new
use compiler.refactor.transforms.refactor_extract_function
use compiler.refactor.transforms.refactor_extract_variable
use compiler.refactor.transforms.refactor_inline_variable
use compiler.refactor.transforms.match_variant_spec_new
use compiler.refactor.transforms.refactor_populate_match_arms
use compiler.refactor.transforms.import_entry_spec_new
use compiler.refactor.transforms.refactor_organize_imports
use compiler.refactor.transforms.refactor_change_signature
use compiler.refactor.transforms.refactor_move_item
use compiler.refactor.transforms.refactor_convert_capability_view

use compiler.refactor.code_actions.code_action_context_default
use compiler.refactor.code_actions.code_action_evaluate_context
use compiler.refactor.code_actions.code_action_resolve_and_verify

fn main() -> i32 {
    let mut ws = vfs_workspace_new();
    let mut eng = lsp_engine_new();

    let doc0: u32 = 0u32;
    let doc1: u32 = 1u32;
    let src0 = "module pkg.engine\nuse std.io.Write\nuse std.io.Read\npub fn compute(x: i32) -> i32 {\n    let y = x + 1\n    return y * 2\n}\n";
    let sv0 = lsp_str_view(src0);
    let _ = vfs_did_open(
        mut_view(ws),
        doc0,
        vfs_hash_str("file:///workspace/src/engine.ax"),
        1i64,
        sv0.ptr,
        sv0.len,
        0x1111u64,
        0x2222u64
    );

    let src1 = "module pkg.helper\npub fn assist(v: i32) -> i32 {\n    return v\n}\n";
    let sv1 = lsp_str_view(src1);
    let _ = vfs_did_open(
        mut_view(ws),
        doc1,
        vfs_hash_str("file:///workspace/src/helper.ax"),
        1i64,
        sv1.ptr,
        sv1.len,
        0x3333u64,
        0x4444u64
    );

    let ty_i32 = vfs_intern_type(mut_view(ws), doc0, "i32", 72u32, 75u32);
    let fn_compute = vfs_intern_function(mut_view(ws), doc0, "pkg.engine.compute", ty_i32, 58u32, 65u32);
    let sym_compute = vfs_intern_symbol(mut_view(ws), doc0, "pkg.engine.compute", ty_i32, 58u32, 65u32);
    let sym_y = vfs_intern_symbol(mut_view(ws), doc0, "y", ty_i32, 91u32, 92u32);
    let local_y = vfs_intern_local(mut_view(ws), doc0, fn_compute, 1u16, "y", 0u16, ty_i32, OWNERSHIP_OWNED, CAP_NONE, 91u32, 92u32);

    let _ = lsp_register_node(
        mut_view(eng),
        mut_view(ws),
        doc0,
        58u32,
        65u32,
        sym_compute,
        sym_compute.raw,
        fn_compute,
        0u16,
        SYM_KIND_FUNCTION,
        SEM_TOK_FUNCTION,
        0u32,
        true,
        true,
        false,
        false,
        ty_i32,
        OWNERSHIP_OWNED,
        CAP_NONE,
        DISPATCH_NONE,
        "compute",
        "pub fn compute(x: i32) -> i32",
        "fn(i32) -> i32",
        "",
        "",
        "Compute engine value."
    );
    let _ = lsp_register_node(
        mut_view(eng),
        mut_view(ws),
        doc0,
        91u32,
        92u32,
        sym_y,
        local_y.raw,
        fn_compute,
        1u16,
        SYM_KIND_VARIABLE,
        SEM_TOK_VARIABLE,
        0u32,
        true,
        false,
        false,
        false,
        ty_i32,
        OWNERSHIP_OWNED,
        CAP_NONE,
        DISPATCH_NONE,
        "y",
        "let y: i32",
        "i32",
        "",
        "",
        "Immutable local binding."
    );

    // ========================================================================
    // Phase 1: `extract_function` (`SPEC-102 §2.1 AXS-REF-010`)
    // ========================================================================
    let dummy_cap = extract_capture_var_new(local_y, "", "", true, false, false, false, false, false, false, false, false, false, false);
    let cap_copy = extract_capture_var_new(local_y, "count", "u32", true, false, false, false, true, false, false, true, false, false, false);
    let cap_rview = extract_capture_var_new(local_y, "buf", "Buffer", false, false, false, false, true, false, false, true, false, false, false);
    let cap_mview = extract_capture_var_new(local_y, "acc", "State", false, true, false, false, true, true, false, true, false, false, false);
    let cap_ret = extract_capture_var_new(local_y, "step_out", "u32", true, false, false, false, false, false, false, true, false, true, false);

    let ext_req_ok = ExtractFunctionRequest {
        doc_id: doc0,
        enclosing_fn: fn_compute,
        selection_start: 87u32,
        selection_end: 100u32,
        helper_insert_offset: 51u32,
        new_fn_name_str: lsp_str_view("run_step"),
        is_enclosing_async: true,
        has_await_in_selection: true,
        has_yield_in_selection: false,
        has_unstructured_loop_exit: false,
        has_non_tail_early_return: false,
        has_incomplete_syntax: false,
        error_effect_type_str: lsp_str_view("IoError"),
        generic_params_str: lsp_str_view(""),
        body_text_str: lsp_str_view("    let step_out = count + 1u32"),
        captures: [cap_copy, cap_rview, cap_mview, cap_ret, dummy_cap, dummy_cap, dummy_cap, dummy_cap],
        capture_count: 4u32,
    };
    let ext_res_ok = refactor_extract_function(mut_view(eng), mut_view(ws), view(ext_req_ok));
    if ext_res_ok.status != REFACTOR_OK || ext_res_ok.param_count != 3u32 || ext_res_ok.return_var_count != 1u32 {
        return 11;
    }
    if ext_res_ok.params[0].param_mode != PARAM_MODE_BY_COPY ||
        ext_res_ok.params[1].param_mode != PARAM_MODE_READ_VIEW ||
        ext_res_ok.params[2].param_mode != PARAM_MODE_MUT_VIEW {
        return 12;
    }
    if !ext_res_ok.is_async_helper || !ext_res_ok.has_error_effect || ext_res_ok.workspace_edit.edit_count != 2u32 {
        return 13;
    }

    // Reject `!Copy` moved in selection AND live after selection (`DIAG_MOVE_USE_AFTER_MOVE`)
    let cap_bad_move = extract_capture_var_new(local_y, "owned_pkt", "Packet", false, false, false, false, true, false, true, true, false, false, false);
    let mut ext_req_bad_move = ext_req_ok;
    ext_req_bad_move.captures[0] = cap_bad_move;
    ext_req_bad_move.capture_count = 1u32;
    let ext_res_bad_move = refactor_extract_function(mut_view(eng), mut_view(ws), view(ext_req_bad_move));
    if ext_res_bad_move.status != REFACTOR_OWNERSHIP_CONFLICT || ext_res_bad_move.diag_code != DIAG_MOVE_USE_AFTER_MOVE {
        return 14;
    }

    // Reject escaping local capability view (`DIAG_CAP_OUTLIVES_OWNER`)
    let cap_bad_view = extract_capture_var_new(local_y, "local_slice", "view<u8>", false, false, true, false, false, false, false, true, false, true, true);
    let mut ext_req_bad_view = ext_req_ok;
    ext_req_bad_view.captures[0] = cap_bad_view;
    ext_req_bad_view.capture_count = 1u32;
    let ext_res_bad_view = refactor_extract_function(mut_view(eng), mut_view(ws), view(ext_req_bad_view));
    if ext_res_bad_view.status != REFACTOR_CAPABILITY_CONFLICT || ext_res_bad_view.diag_code != DIAG_CAP_OUTLIVES_OWNER {
        return 15;
    }

    // ========================================================================
    // Phase 2: `extract_variable` & `inline_variable` (`SPEC-102 §2.2 AXS-REF-011`)
    // ========================================================================
    let ev_req_ok = ExtractVariableRequest {
        doc_id: doc0,
        enclosing_fn: fn_compute,
        stmt_insert_offset: 83u32,
        expr_start: 95u32,
        expr_end: 100u32,
        var_name_str: lsp_str_view("incremented"),
        expr_text_str: lsp_str_view("x + 1"),
        expr_type_str: lsp_str_view("i32"),
        indent_spaces: 4u32,
        is_unit_or_never: false,
        is_lhs_place: false,
        is_expr_pure: true,
        is_expr_copy: true,
        prior_stmt_aliases_expr: false,
        occurrence_count: 2u32,
        second_expr_start: 112u32,
        second_expr_end: 117u32,
        mutated_between_occurrences: false,
    };
    let ev_res_ok = refactor_extract_variable(mut_view(eng), mut_view(ws), view(ev_req_ok));
    if ev_res_ok.status != REFACTOR_OK || ev_res_ok.replaced_occurrences != 2u32 || ev_res_ok.workspace_edit.edit_count != 3u32 {
        return 21;
    }

    // Reject duplicate name collision (`y` already exists in `fn_compute` -> `DIAG_NAME_DUPLICATE`)
    let mut ev_req_dup = ev_req_ok;
    ev_req_dup.var_name_str = lsp_str_view("y");
    let ev_res_dup = refactor_extract_variable(mut_view(eng), mut_view(ws), view(ev_req_dup));
    if ev_res_dup.status != REFACTOR_NAME_COLLISION || ev_res_dup.diag_code != DIAG_NAME_DUPLICATE {
        return 22;
    }

    // `inline_variable`: immutable `let y = x + 1` (prec 10) into `y * 2` (prec 20) -> `(x + 1)`
    let inl_req_ok = InlineVariableRequest {
        doc_id: doc0,
        local_id: local_y,
        let_stmt_start: 83u32,
        let_stmt_end: 101u32,
        init_text_str: lsp_str_view("x + 1"),
        is_mutable_binding: false,
        has_definite_init: true,
        is_init_pure: true,
        is_type_copy: true,
        has_observable_drop: false,
        interferes_before_use: false,
        init_precedence: 10u8,
        use_count: 1u32,
        use_starts: [112u32, 0u32, 0u32, 0u32],
        use_ends: [113u32, 0u32, 0u32, 0u32],
        use_context_precedences: [20u8, 0u8, 0u8, 0u8],
    };
    let inl_res_ok = refactor_inline_variable(mut_view(eng), mut_view(ws), view(inl_req_ok));
    if inl_res_ok.status != REFACTOR_OK || inl_res_ok.inlined_use_count != 1u32 || inl_res_ok.parenthesized_count != 1u32 {
        return 23;
    }
    if !refactor_sv_eq(inl_res_ok.replacement_texts[0], lsp_str_view("(x + 1)")) {
        return 24;
    }

    // Reject `inline_variable` on `let mut` binding
    let mut inl_req_mut = inl_req_ok;
    inl_req_mut.is_mutable_binding = true;
    let inl_res_mut = refactor_inline_variable(mut_view(eng), mut_view(ws), view(inl_req_mut));
    if inl_res_mut.status != REFACTOR_PRECONDITION_FAILED {
        return 25;
    }

    // ========================================================================
    // Phase 3: `populate_match_arms` & `organize_imports` (`SPEC-102 §§2.3..2.4`)
    // ========================================================================
    let v_idle = match_variant_spec_new("Idle", VARIANT_UNIT, "", true);
    let v_pay = match_variant_spec_new("Payload", VARIANT_TUPLE, "v0", false);
    let v_done = match_variant_spec_new("Completed", VARIANT_STRUCT, "bytes, ok", false);
    let pm_req = PopulateMatchArmsRequest {
        doc_id: doc0,
        scrutinee_type_id: ty_i32,
        scrutinee_kind: SCRUTINEE_ENUM,
        enum_path_prefix_str: lsp_str_view("State"),
        variants_imported_unqualified: true,
        insert_offset: 100u32,
        indent_spaces: 8u32,
        bool_true_covered: false,
        bool_false_covered: false,
        has_wildcard_arm: false,
        variants: [v_idle, v_pay, v_done, v_idle, v_idle, v_idle, v_idle, v_idle],
        variant_count: 3u32,
    };
    let pm_res = refactor_populate_match_arms(mut_view(eng), mut_view(ws), view(pm_req));
    if pm_res.status != REFACTOR_OK || pm_res.applicability != APPLICABILITY_HAS_PLACEHOLDERS || pm_res.added_arm_count != 2u32 {
        return 31;
    }

    // Already exhaustive match is rejected
    let mut pm_req_exh = pm_req;
    pm_req_exh.variant_count = 1u32;
    let pm_res_exh = refactor_populate_match_arms(mut_view(eng), mut_view(ws), view(pm_req_exh));
    if pm_res_exh.status != REFACTOR_PRECONDITION_FAILED {
        return 32;
    }

    // `organize_imports`: merge sibling `std.io.{Read, Write}`, deduplicate `std.io.Read`,
    // prune unused private `std.fmt.Debug`, and preserve `pub use pkg.helper.assist`
    let sym_read = LspSymbolId { raw: gen_id_new(10u32, 1u32) };
    let sym_write = LspSymbolId { raw: gen_id_new(11u32, 1u32) };
    let sym_debug = LspSymbolId { raw: gen_id_new(12u32, 1u32) };
    let sym_assist = LspSymbolId { raw: gen_id_new(13u32, 1u32) };
    let imp_dummy = import_entry_spec_new(sym_read, "", "", "", false, false, 0u8, 0u32);
    let imp_w = import_entry_spec_new(sym_write, "std.io", "Write", "", false, false, 0u8, 2u32);
    let imp_r1 = import_entry_spec_new(sym_read, "std.io", "Read", "", false, false, 0u8, 4u32);
    let imp_r2 = import_entry_spec_new(sym_read, "std.io", "Read", "", false, false, 0u8, 4u32);
    let imp_unused = import_entry_spec_new(sym_debug, "std.fmt", "Debug", "", false, false, 0u8, 0u32);
    let imp_pub = import_entry_spec_new(sym_assist, "pkg.helper", "assist", "", true, false, 1u8, 0u32);

    let org_req = OrganizeImportsRequest {
        doc_id: doc0,
        import_block_start: 18u32,
        import_block_end: 50u32,
        entries: [imp_w, imp_r1, imp_r2, imp_unused, imp_pub, imp_dummy, imp_dummy, imp_dummy, imp_dummy, imp_dummy, imp_dummy, imp_dummy],
        entry_count: 5u32,
    };
    let org_res = refactor_organize_imports(mut_view(eng), mut_view(ws), view(org_req));
    if org_res.status != REFACTOR_OK || org_res.kept_count != 3u32 ||
        org_res.pruned_unused_count != 1u32 || org_res.deduplicated_count != 1u32 ||
        org_res.merged_group_count != 1u32 {
        return 33;
    }

    // ========================================================================
    // Phase 4: `change_signature`, `move_item` & `convert_capability_view` (`SPEC-102 §2.5`)
    // ========================================================================
    let empty_sv = lsp_str_view("");
    let cs_req = ChangeSignatureRequest {
        decl_doc_id: doc0,
        fn_symbol_id: sym_compute,
        decl_span_start: 51u32,
        decl_span_end: 80u32,
        new_decl_sig_str: lsp_str_view("pub fn compute(x: i32, scale: i32) -> i32"),
        removed_param_used_in_body: false,
        removed_arg_is_impure: false,
        added_param_has_placeholder: true,
        call_site_count: 1u32,
        call_doc_ids: [doc1, 0u32, 0u32, 0u32],
        call_starts: [45u32, 0u32, 0u32, 0u32],
        call_ends: [52u32, 0u32, 0u32, 0u32],
        call_new_texts: [lsp_str_view("compute(v, todo())"), empty_sv, empty_sv, empty_sv],
    };
    let cs_res = refactor_change_signature(mut_view(eng), mut_view(ws), view(cs_req));
    if cs_res.status != REFACTOR_OK || cs_res.applicability != APPLICABILITY_HAS_PLACEHOLDERS || cs_res.updated_call_sites != 1u32 {
        return 41;
    }

    let mv_req = MoveItemRequest {
        item_symbol_id: sym_compute,
        src_doc_id: doc0,
        src_item_start: 51u32,
        src_item_end: 120u32,
        src_import_insert_offset: 18u32,
        dst_doc_id: doc1,
        dst_insert_offset: 60u32,
        item_text_str: lsp_str_view("pub fn compute(x: i32) -> i32 { return x }\n"),
        reimport_use_str: lsp_str_view("use pkg.helper.compute\n"),
        violates_orphan_coherence: false,
        accesses_private_src_field: false,
    };
    let mv_res = refactor_move_item(mut_view(eng), mut_view(ws), view(mv_req));
    if mv_res.status != REFACTOR_OK || mv_res.workspace_edit.edit_count != 3u32 {
        return 42;
    }

    let cv_req_conflict = ConvertCapabilityViewRequest {
        doc_id: doc0,
        target_symbol_id: sym_y,
        conversion_mode: CAP_CONV_VIEW_TO_MUT_VIEW,
        decl_span_start: 83u32,
        decl_span_end: 92u32,
        new_decl_text_str: lsp_str_view("mut_view<i32>"),
        is_only_read_in_scope: false,
        caller_has_conflicting_borrow: true,
        caller_arg_is_immutable: false,
        call_site_count: 0u32,
        call_doc_ids: [0u32; 4],
        call_arg_starts: [0u32; 4],
        call_arg_ends: [0u32; 4],
        call_arg_new_texts: [empty_sv; 4],
    };
    let cv_res_conflict = refactor_convert_capability_view(mut_view(eng), mut_view(ws), view(cv_req_conflict));
    if cv_res_conflict.status != REFACTOR_CAPABILITY_CONFLICT || cv_res_conflict.diag_code != DIAG_BORROW_CONFLICT {
        return 43;
    }

    // ========================================================================
    // Phase 5: LSP `textDocument/codeAction` Ordering & Precondition Gating (`SPEC-102 §3`)
    // ========================================================================
    let sel_range = lsp_range_new(lsp_pos_new(4u32, 4u32), lsp_pos_new(4u32, 17u32));
    let mut ca_ctx = code_action_context_default(doc0, sel_range, 87u32, 100u32);
    ca_ctx.has_unresolved_symbol_diag = true;
    ca_ctx.unresolved_import_insert_offset = 18u32;
    ca_ctx.unresolved_import_text_str = lsp_str_view("use std.io.BufReader\n");
    ca_ctx.unresolved_target_symbol = LspSymbolId { raw: gen_id_new(20u32, 1u32) };
    ca_ctx.has_ambiguous_method_diag = true;
    ca_ctx.ambiguous_call_start = 95u32;
    ca_ctx.ambiguous_call_end = 100u32;
    ca_ctx.ambiguous_candidate_a_str = lsp_str_view("TraitA.op(x)");
    ca_ctx.ambiguous_candidate_b_str = lsp_str_view("TraitB.op(x)");
    ca_ctx.ambiguous_trait_a_symbol = LspSymbolId { raw: gen_id_new(21u32, 1u32) };
    ca_ctx.ambiguous_trait_b_symbol = LspSymbolId { raw: gen_id_new(22u32, 1u32) };
    ca_ctx.has_selection = true;
    ca_ctx.extract_fn_preconditions_ok = true;
    ca_ctx.extract_var_preconditions_ok = true;
    ca_ctx.cursor_on_local_binding = true;
    ca_ctx.inline_var_target_is_mutable = true; // Illegal -> must be suppressed!
    ca_ctx.inline_var_preconditions_ok = true;
    ca_ctx.has_use_imports = true;

    let ca_res = code_action_evaluate_context(mut_view(eng), mut_view(ws), view(ca_ctx));
    if ca_res.count != 6u32 || ca_res.quickfix_count != 3u32 || ca_res.refactor_count != 2u32 ||
        ca_res.source_action_count != 1u32 || ca_res.filtered_illegal_count != 1u32 {
        return 51;
    }
    if !ca_res.items[0].is_preferred || ca_res.items[0].kind_tier != CODE_ACTION_KIND_QUICKFIX {
        return 52;
    }
    if ca_res.items[5].kind_tier != CODE_ACTION_KIND_SOURCE_ORGANIZE_IMPORTS {
        return 53;
    }

    let hnd_ca = lsp_handle_code_action(mut_view(eng), mut_view(ws), doc0, sel_range, true);
    if hnd_ca.count == 0u32 || hnd_ca.source_action_count != 1u32 {
        return 54;
    }

    // ========================================================================
    // Phase 6: Snapshot-Pinned `codeAction/resolve`, `unsafe` Rejection & Rollback (`SPEC-102 §1.2, §3.2`)
    // ========================================================================
    let mut verify_edit = refactor_workspace_edit_empty(view(ws), REFACTOR_ORGANIZE_IMPORTS, APPLICABILITY_MACHINE_APPLICABLE);
    let _ = refactor_workspace_edit_add(
        view(ws),
        mut_view(verify_edit),
        doc0,
        18u32,
        50u32,
        lsp_str_view("use std.io.{Read, Write}\n")
    );
    let res_resolve_ok = code_action_resolve_and_verify(
        mut_view(eng),
        mut_view(ws),
        view(ca_res.items[5]),
        mut_view(verify_edit),
        false,
        false
    );
    if !res_resolve_ok.resolved || !res_resolve_ok.verified_by_compiler_db || res_resolve_ok.error_code != LSP_ERR_NONE {
        return 61;
    }

    // Now test `unsafe` block injection rejection and transactional rollback (`AX_UNSAFE_REQUIRED`)
    let dp0 = vfs_doc_ptr(view(ws), doc0);
    let len_before_unsafe = editor_snapshot(unsafe { view((*dp0).editor) }).byte_len;
    let mut unsafe_edit = refactor_workspace_edit_empty(view(ws), REFACTOR_EXTRACT_FUNCTION, APPLICABILITY_MACHINE_APPLICABLE);
    let _ = refactor_workspace_edit_add(
        view(ws),
        mut_view(unsafe_edit),
        doc0,
        0u32,
        0u32,
        lsp_str_view("unsafe { }\n")
    );
    let unsafe_ok = refactor_verify_and_commit_edit(
        mut_view(eng),
        mut_view(ws),
        mut_view(unsafe_edit),
        false,
        false
    );
    let len_after_unsafe = editor_snapshot(unsafe { view((*dp0).editor) }).byte_len;
    if unsafe_ok || unsafe_edit.status != REFACTOR_UNSAFE_SYNTHESIS_FORBIDDEN ||
        unsafe_edit.diag_code != DIAG_UNSAFE_REQUIRED || !unsafe_edit.rolled_back ||
        len_after_unsafe != len_before_unsafe {
        return 62;
    }

    // Stale revision rejection: `ca_res.items[0]` was created at an older workspace revision
    let res_stale = lsp_handle_code_action_resolve(mut_view(eng), mut_view(ws), view(ca_res.items[0]));
    if !res_stale.is_stale_revision || res_stale.error_code != LSP_ERR_CONTENT_MODIFIED || res_stale.resolved {
        return 63;
    }
    if ws.codegen_invocations != 0u32 {
        return 64;
    }

    print("P1_EXTRACT_FN_PARAMS=3 P1_RETURNS=1 P1_REJECT_MOVE=3101 P1_REJECT_VIEW=3008\n");
    print("P2_EXTRACT_VAR_OCC=2 P2_INLINE_PARENS=1 P2_REJECT_MUT=2\n");
    print("P3_MATCH_ADDED=2 P3_ORG_KEPT=3 P3_ORG_PRUNED=1 P3_ORG_MERGED=1\n");
    print("P5_CA_TOTAL=6 P5_CA_FILTERED=1 P6_VERIFIED=true P6_UNSAFE_DIAG=3201 P6_STALE_ERR=-32801 CODEGEN=0\n");

    lsp_engine_free(mut_view(eng));
    vfs_workspace_free(mut_view(ws));
    return 0;
}
