// test: run
// modes: interp native
// stdout-file: extract_and_inline_variable_semantics.stdout
// Verify E19.3 `extract_variable` and `inline_variable` evaluation order, purity,
// `Copy`/move rules, `let mut` rejection, and operator precedence parenthesization (`SPEC-102 §2.2 AXS-REF-011`).

const STATUS_OK: u8 = 0u8;
const STATUS_PRECONDITION_FAILED: u8 = 1u8;
const STATUS_OWNERSHIP_CONFLICT: u8 = 3u8;
const STATUS_CAPABILITY_CONFLICT: u8 = 4u8;
const STATUS_NAME_COLLISION: u8 = 6u8;

const DIAG_NAME_DUPLICATE: u32 = 2002u32;
const DIAG_BORROW_CONFLICT: u32 = 3001u32;
const DIAG_MOVE_USE_AFTER_MOVE: u32 = 3101u32;

@derive(Copy)
struct ExtractVarCheck {
    status: u8,
    diag_code: u32,
    replaced_occurrences: u32,
}

fn check_extract_variable(
    name_collides: bool,
    prior_stmt_aliases_expr: bool,
    occurrence_count: u32,
    is_pure: bool,
    is_copy: bool,
    mutated_between: bool
) -> ExtractVarCheck {
    if name_collides {
        return ExtractVarCheck { status: STATUS_NAME_COLLISION, diag_code: DIAG_NAME_DUPLICATE, replaced_occurrences: 0u32 };
    }
    if prior_stmt_aliases_expr {
        return ExtractVarCheck { status: STATUS_PRECONDITION_FAILED, diag_code: 0u32, replaced_occurrences: 0u32 };
    }
    if occurrence_count >= 2u32 {
        if !is_copy {
            return ExtractVarCheck { status: STATUS_OWNERSHIP_CONFLICT, diag_code: DIAG_MOVE_USE_AFTER_MOVE, replaced_occurrences: 0u32 };
        }
        if !is_pure || mutated_between {
            return ExtractVarCheck { status: STATUS_PRECONDITION_FAILED, diag_code: 0u32, replaced_occurrences: 0u32 };
        }
    }
    ExtractVarCheck {
        status: STATUS_OK,
        diag_code: 0u32,
        replaced_occurrences: occurrence_count,
    }
}

@derive(Copy)
struct InlineVarCheck {
    status: u8,
    diag_code: u32,
    inlined_uses: u32,
    needs_parens: bool,
}

fn check_inline_variable(
    is_mutable_binding: bool,
    use_count: u32,
    is_init_pure: bool,
    is_type_copy: bool,
    has_observable_drop: bool,
    interferes_before_use: bool,
    init_prec: u8,
    ctx_prec: u8
) -> InlineVarCheck {
    if is_mutable_binding {
        return InlineVarCheck { status: STATUS_PRECONDITION_FAILED, diag_code: 0u32, inlined_uses: 0u32, needs_parens: false };
    }
    if use_count == 0u32 {
        if !is_init_pure || has_observable_drop {
            return InlineVarCheck { status: STATUS_PRECONDITION_FAILED, diag_code: 0u32, inlined_uses: 0u32, needs_parens: false };
        }
    } else if use_count == 1u32 {
        if interferes_before_use {
            return InlineVarCheck { status: STATUS_CAPABILITY_CONFLICT, diag_code: DIAG_BORROW_CONFLICT, inlined_uses: 0u32, needs_parens: false };
        }
    } else {
        if !is_type_copy {
            return InlineVarCheck { status: STATUS_OWNERSHIP_CONFLICT, diag_code: DIAG_MOVE_USE_AFTER_MOVE, inlined_uses: 0u32, needs_parens: false };
        }
        if !is_init_pure || interferes_before_use {
            return InlineVarCheck { status: STATUS_PRECONDITION_FAILED, diag_code: 0u32, inlined_uses: 0u32, needs_parens: false };
        }
    }
    InlineVarCheck {
        status: STATUS_OK,
        diag_code: 0u32,
        inlined_uses: use_count,
        needs_parens: init_prec < ctx_prec,
    }
}

pub fn main() -> i32 {
    // 1. `extract_variable`: multi-occurrence pure + Copy succeeds (2 occurrences)
    let ev_ok = check_extract_variable(false, false, 2u32, true, true, false);
    if ev_ok.status != STATUS_OK || ev_ok.replaced_occurrences != 2u32 {
        return 1;
    }
    print("ext_pure_copy=0 occ=2\n");

    // 2. `extract_variable`: multi-occurrence !Copy rejected (`AX_MOVE_USE_AFTER_MOVE`)
    let ev_move = check_extract_variable(false, false, 2u32, true, false, false);
    if ev_move.status != STATUS_OWNERSHIP_CONFLICT || ev_move.diag_code != DIAG_MOVE_USE_AFTER_MOVE {
        return 2;
    }
    print("ext_non_copy_multi=3 diag=3101\n");

    // 3. `extract_variable`: shadowing / duplicate name rejected (`AX_NAME_DUPLICATE`)
    let ev_dup = check_extract_variable(true, false, 1u32, true, true, false);
    if ev_dup.status != STATUS_NAME_COLLISION || ev_dup.diag_code != DIAG_NAME_DUPLICATE {
        return 3;
    }
    print("ext_shadow_dup=6 diag=2002\n");

    // 4. `inline_variable`: immutable `let x = a + b` (prec 10) into `x * c` (prec 20) -> parenthesized `(a + b) * c`
    let inl_ok = check_inline_variable(false, 1u32, true, true, false, false, 10u8, 20u8);
    if inl_ok.status != STATUS_OK || inl_ok.inlined_uses != 1u32 || !inl_ok.needs_parens {
        return 4;
    }
    print("inl_add_into_mul=0 uses=1 parens=true\n");

    // 5. `inline_variable`: `let mut` binding is rejected
    let inl_mut = check_inline_variable(true, 1u32, true, true, false, false, 20u8, 10u8);
    if inl_mut.status != STATUS_PRECONDITION_FAILED {
        return 5;
    }
    print("inl_let_mut=1\n");

    // 6. `inline_variable`: 0 uses with observable `Drop` is rejected
    let inl_drop = check_inline_variable(false, 0u32, true, false, true, false, 20u8, 10u8);
    if inl_drop.status != STATUS_PRECONDITION_FAILED {
        return 6;
    }
    print("inl_zero_use_drop=1\n");

    return 0;
}
