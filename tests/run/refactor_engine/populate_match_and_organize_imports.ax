// test: run
// modes: interp native
// stdout-file: populate_match_and_organize_imports.stdout
// Verify E19.3 `populate_match_arms` (declaration-order enum expansion, tuple/struct payload
// bindings, `HasPlaceholders` applicability, exhaustive match rejection) and `organize_imports`
// (unused private import pruning, `pub use` & `@cfg` preservation, `SymbolId` deduplication,
// `as` alias preservation, and canonical dot-path brace merging) (`SPEC-102 §§2.3..2.4 AXS-REF-012..013`).

const STATUS_OK: u8 = 0u8;
const STATUS_PRECONDITION_FAILED: u8 = 1u8;

const APPLICABILITY_MACHINE_APPLICABLE: u8 = 0u8;
const APPLICABILITY_HAS_PLACEHOLDERS: u8 = 1u8;

@derive(Copy)
struct VariantArmFact {
    already_covered: bool,
    payload_arity: u32,
    is_struct_variant: bool,
}

@derive(Copy)
struct PopulateMatchCheck {
    status: u8,
    applicability: u8,
    added_arms: u32,
    synthesized_bindings: u32,
}

fn check_populate_match(variants: [4]VariantArmFact, count: u32) -> PopulateMatchCheck {
    let mut added: u32 = 0u32;
    let mut bindings: u32 = 0u32;
    let mut i: u32 = 0u32;
    while i < count {
        let v = variants[i as usize];
        if !v.already_covered {
            added = added + 1u32;
            bindings = bindings + v.payload_arity;
        }
        i = i + 1u32;
    }
    if added == 0u32 {
        return PopulateMatchCheck {
            status: STATUS_PRECONDITION_FAILED,
            applicability: APPLICABILITY_HAS_PLACEHOLDERS,
            added_arms: 0u32,
            synthesized_bindings: 0u32,
        };
    }
    PopulateMatchCheck {
        status: STATUS_OK,
        applicability: APPLICABILITY_HAS_PLACEHOLDERS,
        added_arms: added,
        synthesized_bindings: bindings,
    }
}

@derive(Copy)
struct ImportFact {
    symbol_id: u32,
    prefix_id: u32,
    has_alias: bool,
    is_pub_reexport: bool,
    is_cfg_gated: bool,
    ref_count: u32,
}

@derive(Copy)
struct OrganizeImportsCheck {
    status: u8,
    applicability: u8,
    kept_count: u32,
    pruned_unused: u32,
    dedup_count: u32,
    merged_groups: u32,
    preserved_aliases: u32,
}

fn check_organize_imports(entries: [6]ImportFact, count: u32) -> OrganizeImportsCheck {
    let dummy = ImportFact { symbol_id: 0u32, prefix_id: 0u32, has_alias: false, is_pub_reexport: false, is_cfg_gated: false, ref_count: 0u32 };
    let mut kept: [6]ImportFact = [dummy; 6];
    let mut kcount: u32 = 0u32;
    let mut pruned: u32 = 0u32;
    let mut dedup: u32 = 0u32;
    let mut aliases: u32 = 0u32;

    let mut i: u32 = 0u32;
    while i < count {
        let e = entries[i as usize];
        if e.ref_count == 0u32 && !e.is_pub_reexport && !e.is_cfg_gated {
            pruned = pruned + 1u32;
        } else {
            let mut is_dup = false;
            let mut j: u32 = 0u32;
            while j < kcount {
                let p = kept[j as usize];
                if p.symbol_id == e.symbol_id && p.is_pub_reexport == e.is_pub_reexport && p.has_alias == e.has_alias {
                    is_dup = true;
                    break;
                }
                j = j + 1u32;
            }
            if is_dup {
                dedup = dedup + 1u32;
            } else {
                kept[kcount as usize] = e;
                kcount = kcount + 1u32;
                if e.has_alias {
                    aliases = aliases + 1u32;
                }
            }
        }
        i = i + 1u32;
    }

    let mut groups: u32 = 0u32;
    let mut idx: u32 = 0u32;
    while idx < kcount {
        let cur = kept[idx as usize];
        if !cur.has_alias && !cur.is_cfg_gated && !cur.is_pub_reexport {
            let mut gend = idx + 1u32;
            while gend < kcount {
                let nxt = kept[gend as usize];
                if nxt.prefix_id == cur.prefix_id && !nxt.has_alias && !nxt.is_cfg_gated && !nxt.is_pub_reexport {
                    gend = gend + 1u32;
                } else {
                    break;
                }
            }
            if (gend - idx) >= 2u32 {
                groups = groups + 1u32;
                idx = gend;
            } else {
                idx = idx + 1u32;
            }
        } else {
            idx = idx + 1u32;
        }
    }

    OrganizeImportsCheck {
        status: STATUS_OK,
        applicability: APPLICABILITY_MACHINE_APPLICABLE,
        kept_count: kcount,
        pruned_unused: pruned,
        dedup_count: dedup,
        merged_groups: groups,
        preserved_aliases: aliases,
    }
}

pub fn main() -> i32 {
    // 1. `populate_match_arms`: 3 variants (`Idle` covered, `Payload(v0)` and `Completed { bytes, ok }` missing)
    let v0 = VariantArmFact { already_covered: true, payload_arity: 0u32, is_struct_variant: false };
    let v1 = VariantArmFact { already_covered: false, payload_arity: 1u32, is_struct_variant: false };
    let v2 = VariantArmFact { already_covered: false, payload_arity: 2u32, is_struct_variant: true };
    let pm_ok = check_populate_match([v0, v1, v2, v0], 3u32);
    if pm_ok.status != STATUS_OK || pm_ok.applicability != APPLICABILITY_HAS_PLACEHOLDERS || pm_ok.added_arms != 2u32 || pm_ok.synthesized_bindings != 3u32 {
        return 1;
    }
    print("match_non_exhaustive=0 app=1 added=2 bindings=3\n");

    // 2. `populate_match_arms`: already exhaustive match is rejected (`0` missing arms)
    let pm_done = check_populate_match([v0, v0, v0, v0], 2u32);
    if pm_done.status != STATUS_PRECONDITION_FAILED {
        return 2;
    }
    print("match_exhaustive_rejected=1\n");

    // 3. `organize_imports`: 6 entries:
    // - 2 used sibling imports in prefix 10 -> merged into 1 group
    // - 1 duplicate of first import -> deduplicated
    // - 1 unused private import (`ref_count == 0`) -> pruned
    // - 1 `pub use` re-export (`ref_count == 0`) -> preserved
    // - 1 aliased `use ... as Alias` (`ref_count == 2`) -> preserved unmerged
    let i0 = ImportFact { symbol_id: 101u32, prefix_id: 10u32, has_alias: false, is_pub_reexport: false, is_cfg_gated: false, ref_count: 3u32 };
    let i1 = ImportFact { symbol_id: 102u32, prefix_id: 10u32, has_alias: false, is_pub_reexport: false, is_cfg_gated: false, ref_count: 1u32 };
    let i2 = ImportFact { symbol_id: 101u32, prefix_id: 10u32, has_alias: false, is_pub_reexport: false, is_cfg_gated: false, ref_count: 3u32 };
    let i3 = ImportFact { symbol_id: 103u32, prefix_id: 20u32, has_alias: false, is_pub_reexport: false, is_cfg_gated: false, ref_count: 0u32 };
    let i4 = ImportFact { symbol_id: 104u32, prefix_id: 30u32, has_alias: false, is_pub_reexport: true, is_cfg_gated: false, ref_count: 0u32 };
    let i5 = ImportFact { symbol_id: 105u32, prefix_id: 10u32, has_alias: true, is_pub_reexport: false, is_cfg_gated: false, ref_count: 2u32 };
    let org = check_organize_imports([i0, i1, i2, i3, i4, i5], 6u32);
    if org.status != STATUS_OK || org.kept_count != 4u32 || org.pruned_unused != 1u32 || org.dedup_count != 1u32 || org.merged_groups != 1u32 || org.preserved_aliases != 1u32 {
        return 3;
    }
    print("org_status=0 kept=4 pruned=1 dedup=1 merged_groups=1 aliases=1\n");

    return 0;
}
