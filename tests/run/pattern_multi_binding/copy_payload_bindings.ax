// test: run
// modes: interp native
// exit: 0
// stdout: pair 7 9\nwide 11 13\ntriple 1 2 3\nmixed 5 4000000000\nif-let 21 22\nwhile-let 3 30\nwhile-let 2 20\nwhile-let 1 10\npoint 4 6\nnested 8 9 10\n

// T444b (REQ-OWN-051): several by-value bindings of Copy payload fields in one tuple-variant
// pattern copy each field once; the second binding is not a use after move.

enum Choice {
    Pair(u64, u64),
    Wide(i32, i32),
    Triple(u8, u8, u8),
    Mixed(u8, u64),
    Nothing,
}

enum Count {
    More(i32, i32),
    Done,
}

struct Point {
    x: i32,
    y: i32,
}

enum Shape {
    At(Point, i32),
    Inner(Choice, u64),
    Blank,
}

fn show2(tag: str, a: i64, b: i64) {
    print(tag);
    print(" ");
    print_int(a);
    print(" ");
    print_int(b);
    print("\n");
}

fn describe(c: Choice) {
    match c {
        Choice.Pair(a, b) => show2("pair", a as i64, b as i64),
        Choice.Wide(a, b) => show2("wide", a as i64, b as i64),
        Choice.Triple(a, b, c3) => {
            print("triple ");
            print_int(a as i64);
            print(" ");
            print_int(b as i64);
            print(" ");
            print_int(c3 as i64);
            print("\n");
        },
        Choice.Mixed(a, b) => show2("mixed", a as i64, b as i64),
        Choice.Nothing => print("nothing\n"),
    }
}

fn step(n: i32) -> Count {
    if n > 0 { Count.More(n, n * 10) } else { Count.Done }
}

fn main() -> i32 {
    describe(Choice.Pair(7u64, 9u64));
    describe(Choice.Wide(11, 13));
    describe(Choice.Triple(1u8, 2u8, 3u8));
    describe(Choice.Mixed(5u8, 4000000000u64));

    let w = Choice.Wide(21, 22);
    if let Choice.Wide(p, q) = w {
        show2("if-let", p as i64, q as i64);
    }

    let mut n = 3;
    while let Count.More(k, k10) = step(n) {
        show2("while-let", k as i64, k10 as i64);
        n = n - 1;
    }

    let s = Shape.At(Point { x: 4, y: 6 }, 0);
    match s {
        Shape.At(Point { x: px, y: py }, _) => show2("point", px as i64, py as i64),
        _ => print("other\n"),
    }

    let t = Shape.Inner(Choice.Pair(8u64, 9u64), 10u64);
    match t {
        Shape.Inner(Choice.Pair(a, b), z) => {
            print("nested ");
            print_int(a as i64);
            print(" ");
            print_int(b as i64);
            print(" ");
            print_int(z as i64);
            print("\n");
        },
        _ => print("other\n"),
    }

    return 0;
}
