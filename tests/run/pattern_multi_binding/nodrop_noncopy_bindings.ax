// test: run
// modes: interp native
// exit: 0
// stdout: two 1 2\nnested 5 6 7\nreassigned 8 9\n

// T444b (REQ-OWN-051): non-Copy payload fields that need no drop, bound by value in one pattern,
// each move only their own field place. Re-assigning the consumed scrutinee as a whole makes it
// usable again (AXS-OWN-006).

struct Token {
    v: i32,
}

enum Pair {
    Two(Token, Token),
    None,
}

enum Wrap {
    In(Pair, Token),
    Out,
}

fn sum_print(tag: str, a: Token, b: Token) {
    print(tag);
    print(" ");
    print_int(a.v as i64);
    print(" ");
    print_int(b.v as i64);
    print("\n");
}

fn main() -> i32 {
    let mut p = Pair.Two(Token { v: 1 }, Token { v: 2 });
    match p {
        Pair.Two(a, b) => sum_print("two", a, b),
        _ => return 1,
    }

    let w = Wrap.In(Pair.Two(Token { v: 5 }, Token { v: 6 }), Token { v: 7 });
    match w {
        Wrap.In(Pair.Two(a, b), c) => {
            print("nested ");
            print_int(a.v as i64);
            print(" ");
            print_int(b.v as i64);
            print(" ");
            print_int(c.v as i64);
            print("\n");
        },
        _ => return 3,
    }

    p = Pair.Two(Token { v: 8 }, Token { v: 9 });
    match p {
        Pair.Two(a, b) => sum_print("reassigned", a, b),
        _ => return 4,
    }
    return 0;
}
