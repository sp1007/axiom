// test: run
// modes: interp native
// exit: 0
// stdout: got 1 2\ndrop 2\ndrop 1\n-- two\nif-let 7 8\ndrop 8\ndrop 7\n-- if-let\nstruct 9 10\ndrop 10\ndrop 9\n-- struct\nnested 11 12 13\ndrop 13\ndrop 12\ndrop 11\n-- nested\nloop 2\ndrop 2\nloop 1\ndrop 1\n-- while-let\nmixed 14 99\ndrop 14\n-- mixed\nthree 15 16 17\ndrop 17\ndrop 16\ndrop 15\n-- three\nend\n

// T444b (REQ-OWN-051): several by-value bindings of owning (Drop) payload fields in one pattern
// move each field place once; no binding is reported as a use after move and every owned field
// is dropped exactly once. Each case runs in its own function and the caller prints a marker
// after it returns, so the output fixes "dropped exactly once, before the owner's scope ends"
// without depending on whether arm bindings drop at the arm end or the function end.

struct Res {
    id: i32,
}

impl Drop for Res {
    fn drop(self: mut_view<Res>) {
        print("drop ");
        print_int(self.id as i64);
        print("\n");
    }
}

enum Owning {
    Two(Res, Res),
    Mixed(Res, i32),
    Three(Res, Res, Res),
    Empty,
}

struct Holder {
    a: Res,
    b: Res,
}

enum Outer {
    Wrap(Owning, Res),
    Nil,
}

enum Feed {
    Item(Res, i32),
    Stop,
}

fn feed(n: i32) -> Feed {
    if n > 0 { Feed.Item(Res { id: n }, n) } else { Feed.Stop }
}

fn show2(tag: str, a: i32, b: i32) {
    print(tag);
    print(" ");
    print_int(a as i64);
    print(" ");
    print_int(b as i64);
    print("\n");
}

fn case_two() {
    let o = Owning.Two(Res { id: 1 }, Res { id: 2 });
    match o {
        Owning.Two(x, y) => show2("got", x.id, y.id),
        _ => print("other\n"),
    }
}

fn case_if_let() {
    let o = Owning.Two(Res { id: 7 }, Res { id: 8 });
    if let Owning.Two(p, q) = o {
        show2("if-let", p.id, q.id);
    }
}

fn case_struct() {
    let h = Holder { a: Res { id: 9 }, b: Res { id: 10 } };
    let Holder { a: ha, b: hb } = h;
    show2("struct", ha.id, hb.id);
}

fn case_nested() {
    let w = Outer.Wrap(Owning.Two(Res { id: 11 }, Res { id: 12 }), Res { id: 13 });
    match w {
        Outer.Wrap(Owning.Two(r1, r2), r3) => {
            print("nested ");
            print_int(r1.id as i64);
            print(" ");
            print_int(r2.id as i64);
            print(" ");
            print_int(r3.id as i64);
            print("\n");
        },
        _ => print("other\n"),
    }
}

fn case_while_let() {
    let mut n = 2;
    while let Feed.Item(r, k) = feed(n) {
        print("loop ");
        print_int(r.id as i64);
        print("\n");
        n = k - 1;
    }
}

fn case_mixed() {
    let m = Owning.Mixed(Res { id: 14 }, 99);
    match m {
        Owning.Mixed(r, v) => show2("mixed", r.id, v),
        _ => print("other\n"),
    }
}

fn case_three() {
    let t = Owning.Three(Res { id: 15 }, Res { id: 16 }, Res { id: 17 });
    match t {
        Owning.Three(a, b, c) => {
            print("three ");
            print_int(a.id as i64);
            print(" ");
            print_int(b.id as i64);
            print(" ");
            print_int(c.id as i64);
            print("\n");
        },
        _ => print("other\n"),
    }
}

fn main() -> i32 {
    case_two();
    print("-- two\n");
    case_if_let();
    print("-- if-let\n");
    case_struct();
    print("-- struct\n");
    case_nested();
    print("-- nested\n");
    case_while_let();
    print("-- while-let\n");
    case_mixed();
    print("-- mixed\n");
    case_three();
    print("-- three\n");
    print("end\n");
    return 0;
}
