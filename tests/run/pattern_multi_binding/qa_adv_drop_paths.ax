// test: run
// modes: interp native
// exit: 0
// stdout: guard small 3 7\ndrop 3\n-- guard\ncond 4 5\ndrop 5\ndrop 4\n-- cond-true\ndrop 4\ndrop 5\n-- cond-false\nempty\n-- arms0\nmixed 100 5\ndrop 100\n-- arms1\ntwo 10 20\ndrop 20\ndrop 10\n-- arms2\nr1 11 12\nr2 13 14\ndrop 14\ndrop 13\ndrop 12\ndrop 11\n-- reuse\nnb\ndrop 15\ndrop 16\n-- nobind\nl 21 5\ndrop 21\n-- either\ns 31 32\n9\ndrop 32\ndrop 31\n-- generic\nend\n

// T444b QA (adversarial, round 0): soundness of the enum variant path tree. Every owned payload
// field is dropped exactly once on every control-flow path: a guarded arm that reads only Copy
// payload, a conditionally consumed scrutinee (maybe-moved, drop flag), several arms with
// different variants, re-assigning a consumed scrutinee, a match that binds nothing, and
// generic enums instantiated with owning and Copy payloads.

struct Res {
    id: i32,
}

impl Drop for Res {
    fn drop(self: mut_view<Res>) {
        print("drop ");
        print_int(self.id as i64);
        print("\n");
    }
}

enum Owning {
    Two(Res, Res),
    Mixed(Res, i32),
    Empty,
}

enum Either<A, B> {
    L(A, B),
    R(B),
}

enum Opt<T> {
    S(T, T),
    N,
}

fn mk(n: i32) -> Owning {
    if n == 0 {
        Owning.Empty
    } else if n == 1 {
        Owning.Mixed(Res { id: 100 }, 5)
    } else {
        Owning.Two(Res { id: 10 }, Res { id: 20 })
    }
}

fn two(tag: str, a: i32, b: i32) {
    print(tag);
    print(" ");
    print_int(a as i64);
    print(" ");
    print_int(b as i64);
    print("\n");
}

fn guard() {
    let o = Owning.Mixed(Res { id: 3 }, 7);
    match o {
        Owning.Mixed(_, v) if v > 100 => print("guard big\n"),
        Owning.Mixed(r, v) => two("guard small", r.id, v),
        _ => print("other\n"),
    }
}

fn cond(flag: bool) {
    let o = Owning.Two(Res { id: 4 }, Res { id: 5 });
    if flag {
        match o {
            Owning.Two(a, b) => two("cond", a.id, b.id),
            _ => print("other\n"),
        }
    }
}

fn arms(n: i32) {
    let o = mk(n);
    match o {
        Owning.Two(a, b) => two("two", a.id, b.id),
        Owning.Mixed(r, v) => two("mixed", r.id, v),
        Owning.Empty => print("empty\n"),
    }
}

fn reuse() {
    let mut o = Owning.Two(Res { id: 11 }, Res { id: 12 });
    match o {
        Owning.Two(a, b) => two("r1", a.id, b.id),
        _ => print("other\n"),
    }
    o = Owning.Two(Res { id: 13 }, Res { id: 14 });
    match o {
        Owning.Two(a, b) => two("r2", a.id, b.id),
        _ => print("other\n"),
    }
}

fn nobind() {
    let o = Owning.Two(Res { id: 15 }, Res { id: 16 });
    match o {
        Owning.Two(_, _) => print("nb\n"),
        _ => print("other\n"),
    }
}

fn either() {
    let l: Either<Res, i32> = Either.L(Res { id: 21 }, 5);
    match l {
        Either.L(h, t) => two("l", h.id, t),
        Either.R(_) => print("r\n"),
    }
}

fn generic() {
    let o: Opt<Res> = Opt.S(Res { id: 31 }, Res { id: 32 });
    match o {
        Opt.S(a, b) => two("s", a.id, b.id),
        Opt.N => print("none\n"),
    }
    let o2: Opt<i32> = Opt.S(4, 5);
    match o2 {
        Opt.S(a, b) => {
            print_int((a + b) as i64);
            print("\n");
        },
        Opt.N => print("none\n"),
    }
}

fn main() -> i32 {
    guard();
    print("-- guard\n");
    cond(true);
    print("-- cond-true\n");
    cond(false);
    print("-- cond-false\n");
    arms(0);
    print("-- arms0\n");
    arms(1);
    print("-- arms1\n");
    arms(2);
    print("-- arms2\n");
    reuse();
    print("-- reuse\n");
    nobind();
    print("-- nobind\n");
    either();
    print("-- either\n");
    generic();
    print("-- generic\n");
    print("end\n");
    return 0;
}
