fn out_str(s: str) {
    let sv = ux2_sv(s)
    let _ = unsafe { write(stdio(1), sv.ptr, sv.len) }
}

fn out_bool(b: bool) {
    if b {
        out_str("true")
    } else {
        out_str("false")
    }
}

fn new_diag_sink() -> DiagSink {
    let mut sink = DiagSink {
        arena: (query_db_empty()).arena,
        diags: 0 as *mut compiler.diag.emitter.Diagnostic,
        len: 0,
        cap: 0,
        errors: 0,
        warnings: 0,
    }
    diag_sink_init(mut_view(sink))
    sink
}

fn probe_struct_evolution() {
    out_str("probe[struct_evolution] ")

    // Base descriptor with 1 struct
    let mut d_base = interface_descriptor_empty()
    d_base.package_name = ux2_sv("demo")
    d_base.module_path = ux2_sv("api")
    d_base.api_fingerprint = ApiFingerprint { lo: 100u64, hi: 101u64 }
    d_base.abi_fingerprint = AbiFingerprint { lo: 200u64, hi: 201u64 }
    d_base.struct_count = 1usize

    let mut s_base = interface_struct_desc_default(ux2_sv("Config"), ux2_sv("api"))
    s_base.size = 16u32
    s_base.align = 4u32
    s_base.is_extensible = false
    s_base.field_count = 2u32
    s_base.fields[0] = stable_field_desc_default(ux2_sv("width"), ux2_sv("u32"), STABLE_TYPE_U32, 4u32, 4u32)
    s_base.fields[0].offset = 0u32
    s_base.fields[1] = stable_field_desc_default(ux2_sv("height"), ux2_sv("u32"), STABLE_TYPE_U32, 4u32, 4u32)
    s_base.fields[1].offset = 4u32
    d_base.structs[0] = s_base

    // Case 1: Field offset shifted
    let mut d_cand1 = d_base
    d_cand1.abi_fingerprint = AbiFingerprint { lo: 300u64, hi: 301u64 }
    d_cand1.structs[0].fields[1].offset = 8u32 // shifted from 4 to 8!
    let mut res1 = interface_diff_result_empty()
    diff_interface_descriptors(view(d_base), view(d_cand1), mut_view(res1))
    let offset_break_ok = (res1.overall_class == COMPAT_CLASS_MAJOR_BREAKING)

    // Case 2: Alignment changed
    let mut d_cand2 = d_base
    d_cand2.abi_fingerprint = AbiFingerprint { lo: 400u64, hi: 401u64 }
    d_cand2.structs[0].align = 8u32 // changed from 4 to 8!
    let mut res2 = interface_diff_result_empty()
    diff_interface_descriptors(view(d_base), view(d_cand2), mut_view(res2))
    let align_break_ok = (res2.overall_class == COMPAT_CLASS_MAJOR_BREAKING)

    // Case 3: Field added to non-extensible struct
    let mut d_cand3 = d_base
    d_cand3.abi_fingerprint = AbiFingerprint { lo: 500u64, hi: 501u64 }
    d_cand3.structs[0].field_count = 3u32
    d_cand3.structs[0].size = 24u32
    d_cand3.structs[0].fields[2] = stable_field_desc_default(ux2_sv("depth"), ux2_sv("u32"), STABLE_TYPE_U32, 4u32, 4u32)
    d_cand3.structs[0].fields[2].offset = 8u32
    let mut res3 = interface_diff_result_empty()
    diff_interface_descriptors(view(d_base), view(d_cand3), mut_view(res3))
    let non_ext_break_ok = (res3.overall_class == COMPAT_CLASS_MAJOR_BREAKING)

    // Case 4: Field appended to extensible struct with version bump
    let mut d_ext_base = d_base
    d_ext_base.structs[0].is_extensible = true
    d_ext_base.structs[0].has_abi_header = true
    d_ext_base.structs[0].header_version = 1u32
    d_ext_base.structs[0].header_struct_size = 16u32

    let mut d_cand4 = d_ext_base
    d_cand4.abi_fingerprint = AbiFingerprint { lo: 600u64, hi: 601u64 }
    d_cand4.structs[0].header_version = 2u32 // bumped!
    d_cand4.structs[0].header_struct_size = 24u32
    d_cand4.structs[0].field_count = 3u32
    d_cand4.structs[0].fields[2] = stable_field_desc_default(ux2_sv("depth"), ux2_sv("u32"), STABLE_TYPE_U32, 4u32, 4u32)
    d_cand4.structs[0].fields[2].offset = 8u32
    let mut res4 = interface_diff_result_empty()
    diff_interface_descriptors(view(d_ext_base), view(d_cand4), mut_view(res4))
    let ext_append_ok = (res4.overall_class == COMPAT_CLASS_MINOR_ADDITIVE)

    out_str("offset_break_ok=")
    out_bool(offset_break_ok)
    out_str(" align_break_ok=")
    out_bool(align_break_ok)
    out_str(" non_extensible_break_ok=")
    out_bool(non_ext_break_ok)
    out_str(" extensible_append_ok=")
    out_bool(ext_append_ok)
    out_str("\n")
}

fn probe_signature_breaks() {
    out_str("probe[signature_breaks] ")

    let mut d_base = interface_descriptor_empty()
    d_base.package_name = ux2_sv("demo")
    d_base.module_path = ux2_sv("api")
    d_base.api_fingerprint = ApiFingerprint { lo: 100u64, hi: 101u64 }
    d_base.abi_fingerprint = AbiFingerprint { lo: 200u64, hi: 201u64 }
    d_base.fn_count = 1usize

    let mut f_base = interface_fn_desc_default(ux2_sv("compute"), ux2_sv("api"))
    f_base.call_conv = CALL_CONV_WIN64
    f_base.param_count = 2u32
    f_base.ret_type_name = ux2_sv("u32")
    f_base.ret_type_size = 4u32
    f_base.capability_mask = 0x01u64 // ReadsMem
    d_base.fns[0] = f_base

    // Case 1: Call conv break (Win64 -> SysV64)
    let mut d_cand1 = d_base
    d_cand1.abi_fingerprint = AbiFingerprint { lo: 210u64, hi: 211u64 }
    d_cand1.fns[0].call_conv = CALL_CONV_SYSV64
    let mut res1 = interface_diff_result_empty()
    diff_interface_descriptors(view(d_base), view(d_cand1), mut_view(res1))
    let cc_break_ok = (res1.overall_class == COMPAT_CLASS_MAJOR_BREAKING)

    // Case 2: Param count break (2 -> 3)
    let mut d_cand2 = d_base
    d_cand2.abi_fingerprint = AbiFingerprint { lo: 220u64, hi: 221u64 }
    d_cand2.fns[0].param_count = 3u32
    let mut res2 = interface_diff_result_empty()
    diff_interface_descriptors(view(d_base), view(d_cand2), mut_view(res2))
    let param_break_ok = (res2.overall_class == COMPAT_CLASS_MAJOR_BREAKING)

    // Case 3: Return type break (u32 -> u64)
    let mut d_cand3 = d_base
    d_cand3.abi_fingerprint = AbiFingerprint { lo: 230u64, hi: 231u64 }
    d_cand3.fns[0].ret_type_name = ux2_sv("u64")
    d_cand3.fns[0].ret_type_size = 8u32
    let mut res3 = interface_diff_result_empty()
    diff_interface_descriptors(view(d_base), view(d_cand3), mut_view(res3))
    let ret_break_ok = (res3.overall_class == COMPAT_CLASS_MAJOR_BREAKING)

    // Case 4: Capability tightened (0x01 -> 0x03)
    let mut d_cand4 = d_base
    d_cand4.abi_fingerprint = AbiFingerprint { lo: 240u64, hi: 241u64 }
    d_cand4.fns[0].capability_mask = 0x03u64
    let mut res4 = interface_diff_result_empty()
    diff_interface_descriptors(view(d_base), view(d_cand4), mut_view(res4))
    let cap_tight_ok = (res4.overall_class == COMPAT_CLASS_MAJOR_BREAKING)

    // Case 5: Capability relaxed (0x01 -> 0x00)
    let mut d_cand5 = d_base
    d_cand5.abi_fingerprint = AbiFingerprint { lo: 250u64, hi: 251u64 }
    d_cand5.fns[0].capability_mask = 0x00u64
    let mut res5 = interface_diff_result_empty()
    diff_interface_descriptors(view(d_base), view(d_cand5), mut_view(res5))
    let cap_relax_ok = (res5.overall_class == COMPAT_CLASS_MINOR_ADDITIVE)

    out_str("call_conv_break_ok=")
    out_bool(cc_break_ok)
    out_str(" param_break_ok=")
    out_bool(param_break_ok)
    out_str(" ret_break_ok=")
    out_bool(ret_break_ok)
    out_str(" cap_tightened_break_ok=")
    out_bool(cap_tight_ok)
    out_str(" cap_relaxed_ok=")
    out_bool(cap_relax_ok)
    out_str("\n")
}

fn probe_semver_enforcement() {
    out_str("probe[semver_enforcement] ")

    let mut d_base = interface_descriptor_empty()
    d_base.package_name = ux2_sv("demo")
    d_base.module_path = ux2_sv("api")
    d_base.api_fingerprint = ApiFingerprint { lo: 100u64, hi: 101u64 }
    d_base.abi_fingerprint = AbiFingerprint { lo: 200u64, hi: 201u64 }
    d_base.impl_hash = 1000u64

    // 1. Implementation-only change under patch bump (1.2.3 -> 1.2.4)
    let mut d_impl = d_base
    d_impl.impl_hash = 2000u64
    let mut cfg_patch = abi_check_cli_default()
    cfg_patch.old_path = ux2_sv("base.axmeta")
    cfg_patch.new_path = ux2_sv("cand.axmeta")
    cfg_patch.old_version = ux2_sv("1.2.3")
    cfg_patch.new_version = ux2_sv("1.2.4")
    cfg_patch.has_semver = true

    let mut out1 = diag_buf_new()
    let mut err1 = diag_buf_new()
    let rc1 = abi_check_cmd_execute(view(cfg_patch), view(d_base), view(d_impl), mut_view(out1), mut_view(err1))
    let patch_impl_ok = (rc1 == 0i32)

    // 2. Additive change under patch bump (1.2.3 -> 1.2.4) -> must be rejected with rc=2
    let mut d_add = d_base
    d_add.api_fingerprint = ApiFingerprint { lo: 150u64, hi: 151u64 }
    d_add.abi_fingerprint = AbiFingerprint { lo: 250u64, hi: 251u64 }
    d_add.fn_count = 1usize
    d_add.fns[0] = interface_fn_desc_default(ux2_sv("new_fn"), ux2_sv("api"))

    let mut out2 = diag_buf_new()
    let mut err2 = diag_buf_new()
    let rc2 = abi_check_cmd_execute(view(cfg_patch), view(d_base), view(d_add), mut_view(out2), mut_view(err2))
    let patch_additive_reject_ok = (rc2 == 2i32)

    // 3. Additive change under minor bump (1.2.3 -> 1.3.0) -> must pass with rc=0
    let mut cfg_minor = cfg_patch
    cfg_minor.old_version = ux2_sv("1.2.3")
    cfg_minor.new_version = ux2_sv("1.3.0")

    let mut out3 = diag_buf_new()
    let mut err3 = diag_buf_new()
    let rc3 = abi_check_cmd_execute(view(cfg_minor), view(d_base), view(d_add), mut_view(out3), mut_view(err3))
    let minor_additive_ok = (rc3 == 0i32)

    // 4. Breaking change under minor bump (1.2.3 -> 1.3.0) -> must be rejected with rc=1
    let mut d_base_fn = d_base
    d_base_fn.fn_count = 1usize
    d_base_fn.fns[0] = interface_fn_desc_default(ux2_sv("legacy_fn"), ux2_sv("api"))

    let mut d_break = d_base_fn
    d_break.api_fingerprint = ApiFingerprint { lo: 350u64, hi: 351u64 }
    d_break.abi_fingerprint = AbiFingerprint { lo: 450u64, hi: 451u64 }
    d_break.fn_count = 0usize // removed legacy_fn!

    let mut out4 = diag_buf_new()
    let mut err4 = diag_buf_new()
    let rc4 = abi_check_cmd_execute(view(cfg_minor), view(d_base_fn), view(d_break), mut_view(out4), mut_view(err4))
    let minor_breaking_reject_ok = (rc4 == 1i32)

    // 5. Breaking change under major bump (1.2.3 -> 2.0.0) -> must pass with rc=0
    let mut cfg_major = cfg_patch
    cfg_major.old_version = ux2_sv("1.2.3")
    cfg_major.new_version = ux2_sv("2.0.0")

    let mut out5 = diag_buf_new()
    let mut err5 = diag_buf_new()
    let rc5 = abi_check_cmd_execute(view(cfg_major), view(d_base_fn), view(d_break), mut_view(out5), mut_view(err5))
    let major_breaking_ok = (rc5 == 0i32)

    out_str("patch_impl_only_ok=")
    out_bool(patch_impl_ok)
    out_str(" patch_additive_reject_ok=")
    out_bool(patch_additive_reject_ok)
    out_str(" minor_additive_ok=")
    out_bool(minor_additive_ok)
    out_str(" minor_breaking_reject_ok=")
    out_bool(minor_breaking_reject_ok)
    out_str(" major_breaking_ok=")
    out_bool(major_breaking_ok)
    out_str("\n")
}

fn probe_symbol_versioning() {
    out_str("probe[symbol_versioning] ")

    // 1. Mangling formatting
    let mut buf_m1 = diag_buf_new()
    format_versioned_mangled_name(
        ux2_sv("demo_pkg"),
        ux2_sv("api_mod"),
        ux2_sv("parse"),
        ux2_sv("1.0"),
        false,
        mut_view(buf_m1)
    )
    let s_m1 = diag_buf_as_str_view(view(buf_m1))
    let exp_m1 = ux2_sv("axiom_demo_pkg_api_mod_parse@1.0")

    let mut buf_m2 = diag_buf_new()
    format_versioned_mangled_name(
        ux2_sv("demo_pkg"),
        ux2_sv("api_mod"),
        ux2_sv("parse"),
        ux2_sv("2.0"),
        true,
        mut_view(buf_m2)
    )
    let s_m2 = diag_buf_as_str_view(view(buf_m2))
    let exp_m2 = ux2_sv("axiom_demo_pkg_api_mod_parse@@2.0")

    let mangling_ok = ux2_sv_eq(s_m1, exp_m1) && ux2_sv_eq(s_m2, exp_m2)

    // 2. PE export aliases
    let mut buf_pe1 = diag_buf_new()
    format_pe_export_alias(ux2_sv("parse"), ux2_sv("1.0"), false, mut_view(buf_pe1))
    let s_pe1 = diag_buf_as_str_view(view(buf_pe1))
    let exp_pe1 = ux2_sv("parse_v1_0")

    let mut buf_pe2 = diag_buf_new()
    format_pe_export_alias(ux2_sv("parse"), ux2_sv("2.0"), true, mut_view(buf_pe2))
    let s_pe2 = diag_buf_as_str_view(view(buf_pe2))
    let exp_pe2 = ux2_sv("parse")

    let pe_alias_ok = ux2_sv_eq(s_pe1, exp_pe1) && ux2_sv_eq(s_pe2, exp_pe2)

    // 3. Coexistence in export table
    let dummy_export = versioned_export_desc_new(
        ux2_sv_empty(), ux2_sv_empty(), ux2_sv_empty(), ux2_sv_empty(), false, ux2_sv_empty(), ux2_sv_empty()
    )
    let mut exports: [16]VersionedExportDesc = [dummy_export; 16]
    exports[0] = versioned_export_desc_new(
        ux2_sv("demo"), ux2_sv("api"), ux2_sv("parse"), ux2_sv("1.0"), false, s_m1, s_pe1
    )
    exports[1] = versioned_export_desc_new(
        ux2_sv("demo"), ux2_sv("api"), ux2_sv("parse"), ux2_sv("2.0"), true, s_m2, s_pe2
    )
    let mut sink = new_diag_sink()
    let coexistence_ok = validate_versioned_export_coexistence(view(exports), 2usize, mut_view(sink))

    // 4. Duplicate version rejection
    exports[1].version = ux2_sv("1.0") // duplicate 1.0!
    let mut sink_dup = new_diag_sink()
    let dup_valid = validate_versioned_export_coexistence(view(exports), 2usize, mut_view(sink_dup))
    let dup_rejected = (!dup_valid) && (sink_dup.errors > 0)

    out_str("mangling_ok=")
    out_bool(mangling_ok)
    out_str(" pe_alias_ok=")
    out_bool(pe_alias_ok)
    out_str(" coexistence_ok=")
    out_bool(coexistence_ok)
    out_str(" dup_rejected=")
    out_bool(dup_rejected)
    out_str("\n")
}

pub fn main() -> i32 {
    probe_struct_evolution()
    probe_signature_breaks()
    probe_semver_enforcement()
    probe_symbol_versioning()

    out_str("ABI-COMPAT-DIFF-PROBE-PASS\n")
    0
}
