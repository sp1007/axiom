// test: run
// modes: interp native
// stdout-file: symbol_version_coexistence.stdout
// SPEC-114 §4 (AXS-ABI-030..031; REQ-ECO-8734):
// Verifies @symbol_version("1.0") + @symbol_version("2.0") versioned symbol
// mangling, PE export aliases, and shared library export coexistence.

@derive(Copy)
struct SymbolVersionModel {
    symbol_id: u32,
    version_id: u32,
    is_default: bool,
    mangled_id: u64,
    alias_id: u32,
}

fn check_export_table_coexistence(
    s1: SymbolVersionModel,
    s2: SymbolVersionModel
) -> bool {
    let same_symbol = s1.symbol_id == s2.symbol_id
    if same_symbol {
        // Rule A: no duplicate version
        if s1.version_id == s2.version_id {
            return false
        }
        // Rule B: at most one default
        if s1.is_default && s2.is_default {
            return false
        }
    }

    // Rule C: mangled symbol collision
    if s1.mangled_id == s2.mangled_id {
        return false
    }

    // Rule D: alias collision
    if s1.alias_id == s2.alias_id {
        return false
    }

    true
}

// Simple deterministic hash for mangling simulation
fn hash_mangled(pkg_id: u32, sym_id: u32, ver_id: u32, is_def: bool) -> u64 {
    let mut h: u64 = 0x517cc1b727220a95u64
    h = h ^ (pkg_id as u64).wrapping_mul(0x9e3779b97f4a7c15u64)
    h = h ^ (sym_id as u64).wrapping_mul(0xbf58476d1ce4e5b9u64)
    h = h ^ (ver_id as u64).wrapping_mul(0x94d049bb133111ebu64)
    if is_def {
        h = h ^ 0x4040u64 // '@@'
    } else {
        h = h ^ 0x40u64   // '@'
    }
    h
}

pub fn main() -> i32 {
    let pkg_id: u32 = 100u32
    let sym_id: u32 = 1u32 // compute_hash

    // v1.0 (legacy, default = false)
    let m1 = hash_mangled(pkg_id, sym_id, 10u32, false)
    let s1 = SymbolVersionModel {
        symbol_id: sym_id,
        version_id: 10u32, // 1.0
        is_default: false,
        mangled_id: m1,
        alias_id: 101u32, // compute_hash_v1_0
    }

    // v2.0 (modern, default = true)
    let m2 = hash_mangled(pkg_id, sym_id, 20u32, true)
    let s2 = SymbolVersionModel {
        symbol_id: sym_id,
        version_id: 20u32, // 2.0
        is_default: true,
        mangled_id: m2,
        alias_id: 100u32, // compute_hash (unadorned)
    }

    // 1. Mangled names must differ
    if s1.mangled_id == s2.mangled_id {
        return 1
    }

    // 2. PE export aliases must differ
    if s1.alias_id == s2.alias_id {
        return 2
    }

    // 3. Coexistence in shared library export table must succeed
    let ok_coexist = check_export_table_coexistence(s1, s2)
    if !ok_coexist {
        return 3
    }

    // 4. Duplicate version collision must be rejected
    let s_dup = SymbolVersionModel {
        symbol_id: sym_id,
        version_id: 10u32, // duplicate 1.0
        is_default: false,
        mangled_id: m1,
        alias_id: 102u32,
    }
    if check_export_table_coexistence(s1, s_dup) {
        return 4
    }

    // 5. Multiple defaults must be rejected
    let s_mult_def = SymbolVersionModel {
        symbol_id: sym_id,
        version_id: 30u32, // 3.0
        is_default: true,  // also default!
        mangled_id: hash_mangled(pkg_id, sym_id, 30u32, true),
        alias_id: 103u32,
    }
    if check_export_table_coexistence(s2, s_mult_def) {
        return 5
    }

    print("SYMBOL-VERSION-COEXISTENCE-OK\n")
    0
}
