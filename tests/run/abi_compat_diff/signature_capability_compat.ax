// test: run
// modes: interp native
// stdout-file: signature_capability_compat.stdout
// SPEC-114 §§1, 3 & 5 (AXS-ABI-002, AXS-ABI-023, AXS-ABI-040; REQ-PKG-022, REQ-PKG-024):
// Verifies detection of signature, calling convention, capability/effects,
// and parameter passing mode ABI breaks.

@derive(Copy)
struct FnModel {
    name_id: u32,
    call_conv: u8,
    param_count: u32,
    param_mode: u8, // 1=ByValue, 2=View, 3=MutView
    ret_type_id: u32,
    capability_mask: u64,
}

const CALL_CONV_C: u8 = 0u8
const CALL_CONV_WIN64: u8 = 1u8
const CALL_CONV_SYSV64: u8 = 2u8

const COMPAT_IDENTICAL: u8 = 0u8
const COMPAT_ADDITIVE: u8 = 1u8
const COMPAT_BREAKING: u8 = 2u8

fn check_fn_compat(old_f: FnModel, new_f: FnModel) -> u8 {
    if old_f.call_conv != new_f.call_conv {
        return COMPAT_BREAKING
    }
    if old_f.param_count != new_f.param_count {
        return COMPAT_BREAKING
    }
    if old_f.param_mode != new_f.param_mode {
        return COMPAT_BREAKING
    }
    if old_f.ret_type_id != new_f.ret_type_id {
        return COMPAT_BREAKING
    }

    // Capability evaluation:
    // Tightening (new requires capabilities that old didn't) -> breaking
    let tightened = (old_f.capability_mask & new_f.capability_mask) != new_f.capability_mask
    if tightened {
        return COMPAT_BREAKING
    }
    // Relaxed (old had requirements that were removed) -> additive
    if old_f.capability_mask != new_f.capability_mask {
        return COMPAT_ADDITIVE
    }

    COMPAT_IDENTICAL
}

pub fn main() -> i32 {
    let base_fn = FnModel {
        name_id: 1u32,
        call_conv: CALL_CONV_WIN64,
        param_count: 2u32,
        param_mode: 2u8, // View
        ret_type_id: 10u32, // u32
        capability_mask: 0x01u64, // ReadsMem
    }

    // 1. Calling convention break (Win64 -> SysV64)
    let f_cc = FnModel {
        name_id: 1u32,
        call_conv: CALL_CONV_SYSV64,
        param_count: 2u32,
        param_mode: 2u8,
        ret_type_id: 10u32,
        capability_mask: 0x01u64,
    }
    if check_fn_compat(base_fn, f_cc) != COMPAT_BREAKING {
        return 1
    }

    // 2. Parameter count break
    let f_params = FnModel {
        name_id: 1u32,
        call_conv: CALL_CONV_WIN64,
        param_count: 3u32,
        param_mode: 2u8,
        ret_type_id: 10u32,
        capability_mask: 0x01u64,
    }
    if check_fn_compat(base_fn, f_params) != COMPAT_BREAKING {
        return 2
    }

    // 3. Ownership / passing mode break (View -> MutView)
    let f_mode = FnModel {
        name_id: 1u32,
        call_conv: CALL_CONV_WIN64,
        param_count: 2u32,
        param_mode: 3u8, // MutView
        ret_type_id: 10u32,
        capability_mask: 0x01u64,
    }
    if check_fn_compat(base_fn, f_mode) != COMPAT_BREAKING {
        return 3
    }

    // 4. Return type break (u32 -> u64)
    let f_ret = FnModel {
        name_id: 1u32,
        call_conv: CALL_CONV_WIN64,
        param_count: 2u32,
        param_mode: 2u8,
        ret_type_id: 20u32, // u64
        capability_mask: 0x01u64,
    }
    if check_fn_compat(base_fn, f_ret) != COMPAT_BREAKING {
        return 4
    }

    // 5. Capability tightened (adding WritesMem 0x02 to requirement) -> breaking
    let f_cap_tight = FnModel {
        name_id: 1u32,
        call_conv: CALL_CONV_WIN64,
        param_count: 2u32,
        param_mode: 2u8,
        ret_type_id: 10u32,
        capability_mask: 0x03u64, // ReadsMem | WritesMem
    }
    if check_fn_compat(base_fn, f_cap_tight) != COMPAT_BREAKING {
        return 5
    }

    // 6. Capability relaxed (from 0x01 to 0x00 Pure) -> additive
    let f_cap_relax = FnModel {
        name_id: 1u32,
        call_conv: CALL_CONV_WIN64,
        param_count: 2u32,
        param_mode: 2u8,
        ret_type_id: 10u32,
        capability_mask: 0x00u64, // Pure
    }
    if check_fn_compat(base_fn, f_cap_relax) != COMPAT_ADDITIVE {
        return 6
    }

    print("SIGNATURE-CAPABILITY-COMPAT-OK\n")
    0
}
