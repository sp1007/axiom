// test: run
// modes: interp native
// stdout-file: semver_policy_enforcement.stdout
// SPEC-114 §5 (AXS-ABI-040..041, AXS-ABI-050; REQ-PKG-022, REQ-PKG-024):
// Verifies SemVer policy enforcement: patch vs minor vs major bump rules,
// exit codes and diagnostics for compatible, additive, and breaking changes.

const BUMP_PATCH: u8 = 0u8
const BUMP_MINOR: u8 = 1u8
const BUMP_MAJOR: u8 = 2u8
const BUMP_DOWNGRADE: u8 = 3u8

const CLASS_IDENTICAL: u8 = 0u8
const CLASS_IMPL_ONLY: u8 = 1u8
const CLASS_ADDITIVE: u8 = 2u8
const CLASS_BREAKING: u8 = 3u8

const EXIT_OK: i32 = 0i32
const EXIT_BREAKING: i32 = 1i32
const EXIT_SEMVER_MISMATCH: i32 = 2i32

fn evaluate_bump(
    maj_old: u32, min_old: u32, pat_old: u32,
    maj_new: u32, min_new: u32, pat_new: u32
) -> u8 {
    if maj_new > maj_old { return BUMP_MAJOR }
    if maj_new < maj_old { return BUMP_DOWNGRADE }
    if min_new > min_old { return BUMP_MINOR }
    if min_new < min_old { return BUMP_DOWNGRADE }
    if pat_new > pat_old { return BUMP_PATCH }
    if pat_new == pat_old { return BUMP_PATCH }
    BUMP_DOWNGRADE
}

fn enforce_policy(compat_class: u8, bump: u8) -> i32 {
    if bump == BUMP_DOWNGRADE {
        return EXIT_SEMVER_MISMATCH
    }

    if compat_class == CLASS_IDENTICAL || compat_class == CLASS_IMPL_ONLY {
        return EXIT_OK
    }

    if compat_class == CLASS_ADDITIVE {
        if bump == BUMP_PATCH {
            return EXIT_SEMVER_MISMATCH
        }
        return EXIT_OK
    }

    if compat_class == CLASS_BREAKING {
        if bump == BUMP_MAJOR {
            return EXIT_OK
        }
        return EXIT_BREAKING
    }

    EXIT_OK
}

pub fn main() -> i32 {
    // 1. Evaluate bumps
    let b_patch = evaluate_bump(1u32, 2u32, 3u32, 1u32, 2u32, 4u32)
    let b_minor = evaluate_bump(1u32, 2u32, 3u32, 1u32, 3u32, 0u32)
    let b_major = evaluate_bump(1u32, 2u32, 3u32, 2u32, 0u32, 0u32)
    let b_down  = evaluate_bump(1u32, 2u32, 3u32, 1u32, 1u32, 0u32)

    if b_patch != BUMP_PATCH || b_minor != BUMP_MINOR || b_major != BUMP_MAJOR || b_down != BUMP_DOWNGRADE {
        return 1
    }

    // 2. Patch release allows identical and impl-only
    if enforce_policy(CLASS_IDENTICAL, BUMP_PATCH) != EXIT_OK {
        return 2
    }
    if enforce_policy(CLASS_IMPL_ONLY, BUMP_PATCH) != EXIT_OK {
        return 3
    }

    // 3. Patch release rejects minor-additive with EXIT_SEMVER_MISMATCH (2)
    if enforce_policy(CLASS_ADDITIVE, BUMP_PATCH) != EXIT_SEMVER_MISMATCH {
        return 4
    }

    // 4. Patch release rejects major-breaking with EXIT_BREAKING (1)
    if enforce_policy(CLASS_BREAKING, BUMP_PATCH) != EXIT_BREAKING {
        return 5
    }

    // 5. Minor release allows additive, identical, and impl-only
    if enforce_policy(CLASS_ADDITIVE, BUMP_MINOR) != EXIT_OK {
        return 6
    }
    if enforce_policy(CLASS_IMPL_ONLY, BUMP_MINOR) != EXIT_OK {
        return 7
    }

    // 6. Minor release rejects major-breaking with EXIT_BREAKING (1)
    if enforce_policy(CLASS_BREAKING, BUMP_MINOR) != EXIT_BREAKING {
        return 8
    }

    // 7. Major release allows breaking, additive, and compatible
    if enforce_policy(CLASS_BREAKING, BUMP_MAJOR) != EXIT_OK {
        return 9
    }
    if enforce_policy(CLASS_ADDITIVE, BUMP_MAJOR) != EXIT_OK {
        return 10
    }

    // 8. Version downgrade rejected with EXIT_SEMVER_MISMATCH (2)
    if enforce_policy(CLASS_ADDITIVE, BUMP_DOWNGRADE) != EXIT_SEMVER_MISMATCH {
        return 11
    }

    print("SEMVER-POLICY-ENFORCEMENT-OK\n")
    0
}
