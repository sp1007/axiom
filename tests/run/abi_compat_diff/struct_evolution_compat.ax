// test: run
// modes: interp native
// stdout-file: struct_evolution_compat.stdout
// SPEC-114 §§2 & 5 (AXS-ABI-011, AXS-ABI-040; REQ-PKG-022, REQ-PKG-024):
// Verifies detection of struct field offset, size, alignment breaks,
// non-extensible vs extensible struct evolution with version bump.

@derive(Copy)
struct FieldModel {
    name_id: u32,
    offset: u32,
    size: u32,
    align: u32,
}

@derive(Copy)
struct StructModel {
    name_id: u32,
    size: u32,
    align: u32,
    is_extensible: bool,
    has_header: bool,
    header_version: u32,
    field_count: u32,
}

const COMPAT_IDENTICAL: u8 = 0u8
const COMPAT_ADDITIVE: u8 = 1u8
const COMPAT_BREAKING: u8 = 2u8

fn check_field_evolution(
    old_f: FieldModel,
    new_f: FieldModel
) -> u8 {
    if old_f.offset != new_f.offset {
        return COMPAT_BREAKING
    }
    if old_f.size != new_f.size || old_f.align != new_f.align {
        return COMPAT_BREAKING
    }
    COMPAT_IDENTICAL
}

fn check_struct_evolution(
    old_s: StructModel,
    new_s: StructModel
) -> u8 {
    if old_s.align != new_s.align {
        return COMPAT_BREAKING
    }

    if new_s.field_count > old_s.field_count {
        if old_s.is_extensible && new_s.is_extensible && new_s.has_header && new_s.header_version > old_s.header_version {
            return COMPAT_ADDITIVE
        } else {
            return COMPAT_BREAKING
        }
    }

    if !old_s.is_extensible && old_s.size != new_s.size {
        return COMPAT_BREAKING
    }

    COMPAT_IDENTICAL
}

pub fn main() -> i32 {
    // 1. Field offset break
    let f1_old = FieldModel { name_id: 1u32, offset: 8u32, size: 4u32, align: 4u32 }
    let f1_new = FieldModel { name_id: 1u32, offset: 12u32, size: 4u32, align: 4u32 }
    let c_field = check_field_evolution(f1_old, f1_new)
    if c_field != COMPAT_BREAKING {
        return 1
    }

    // 2. Field size/align break
    let f2_old = FieldModel { name_id: 2u32, offset: 16u32, size: 4u32, align: 4u32 }
    let f2_new = FieldModel { name_id: 2u32, offset: 16u32, size: 8u32, align: 8u32 }
    let c_fsize = check_field_evolution(f2_old, f2_new)
    if c_fsize != COMPAT_BREAKING {
        return 2
    }

    // 3. Non-extensible struct field addition -> breaking
    let s_non_ext_old = StructModel {
        name_id: 10u32,
        size: 16u32,
        align: 8u32,
        is_extensible: false,
        has_header: false,
        header_version: 1u32,
        field_count: 2u32,
    }
    let s_non_ext_new = StructModel {
        name_id: 10u32,
        size: 24u32,
        align: 8u32,
        is_extensible: false,
        has_header: false,
        header_version: 1u32,
        field_count: 3u32,
    }
    let c_non_ext = check_struct_evolution(s_non_ext_old, s_non_ext_new)
    if c_non_ext != COMPAT_BREAKING {
        return 3
    }

    // 4. Extensible struct field addition with header version bump -> additive
    let s_ext_old = StructModel {
        name_id: 20u32,
        size: 24u32,
        align: 8u32,
        is_extensible: true,
        has_header: true,
        header_version: 1u32,
        field_count: 3u32,
    }
    let s_ext_new = StructModel {
        name_id: 20u32,
        size: 32u32,
        align: 8u32,
        is_extensible: true,
        has_header: true,
        header_version: 2u32,
        field_count: 4u32,
    }
    let c_ext = check_struct_evolution(s_ext_old, s_ext_new)
    if c_ext != COMPAT_ADDITIVE {
        return 4
    }

    // 5. Alignment break
    let s_align_old = StructModel {
        name_id: 30u32,
        size: 16u32,
        align: 4u32,
        is_extensible: false,
        has_header: false,
        header_version: 1u32,
        field_count: 2u32,
    }
    let s_align_new = StructModel {
        name_id: 30u32,
        size: 16u32,
        align: 8u32,
        is_extensible: false,
        has_header: false,
        header_version: 1u32,
        field_count: 2u32,
    }
    let c_align = check_struct_evolution(s_align_old, s_align_new)
    if c_align != COMPAT_BREAKING {
        return 5
    }

    print("STRUCT-EVOLUTION-COMPAT-OK\n")
    0
}
