// test: run
// modes: interp native
// stdout-file: abi_compat_diff_edge_cases.stdout
// SPEC-114 §§4 & 5 (AXS-ABI-012, AXS-ABI-030..031, AXS-ABI-040..041):
// Cross-checks boundary cases: enum discriminant & non-exhaustive variant changes,
// 0.x.y SemVer transitions, version downgrades, and mangling dot sanitization.

const BUMP_PATCH: u8 = 0u8
const BUMP_MINOR: u8 = 1u8
const BUMP_MAJOR: u8 = 2u8
const BUMP_DOWNGRADE: u8 = 3u8

const COMPAT_IDENTICAL: u8 = 0u8
const COMPAT_ADDITIVE: u8 = 1u8
const COMPAT_BREAKING: u8 = 2u8

const EXIT_OK: i32 = 0i32
const EXIT_BREAKING: i32 = 1i32
const EXIT_SEMVER_MISMATCH: i32 = 2i32

// 1. Enum models
@derive(Copy)
struct VariantModel {
    name_id: u32,
    tag: u64,
}

@derive(Copy)
struct EnumModel {
    name_id: u32,
    repr_kind: u8,
    is_non_exhaustive: bool,
    variant_count: u32,
}

fn check_enum_compat(
    old_e: EnumModel,
    old_vars: view<[4]VariantModel>,
    new_e: EnumModel,
    new_vars: view<[4]VariantModel>
) -> u8 {
    // Check old variants exist and have identical tag
    let mut i: usize = 0usize
    while i < (old_e.variant_count as usize) {
        let v_old = (*old_vars)[i]
        let mut found = false
        let mut j: usize = 0usize
        while j < (new_e.variant_count as usize) {
            let v_new = (*new_vars)[j]
            if v_old.name_id == v_new.name_id {
                found = true
                if v_old.tag != v_new.tag {
                    return COMPAT_BREAKING
                }
            }
            j = j + 1usize
        }
        if !found {
            return COMPAT_BREAKING
        }
        i = i + 1usize
    }

    // Check new variants
    if new_e.variant_count > old_e.variant_count {
        if old_e.is_non_exhaustive {
            return COMPAT_ADDITIVE
        } else {
            return COMPAT_BREAKING
        }
    }

    COMPAT_IDENTICAL
}

// 2. SemVer parser and bump evaluator
@derive(Copy)
struct SemVerModel {
    major: u32,
    minor: u32,
    patch: u32,
    is_valid: bool,
}

fn eval_semver_bump(old_v: SemVerModel, new_v: SemVerModel) -> u8 {
    if !old_v.is_valid || !new_v.is_valid {
        return BUMP_DOWNGRADE
    }
    let old_maj = old_v.major
    let new_maj = new_v.major
    if new_maj > old_maj {
        return BUMP_MAJOR
    }
    if new_maj < old_maj {
        return BUMP_DOWNGRADE
    }

    let old_min = old_v.minor
    let new_min = new_v.minor
    if new_min > old_min {
        return BUMP_MINOR
    }
    if new_min < old_min {
        return BUMP_DOWNGRADE
    }

    let old_pat = old_v.patch
    let new_pat = new_v.patch
    if new_pat > old_pat {
        return BUMP_PATCH
    }
    if new_pat == old_pat {
        return BUMP_PATCH
    }
    BUMP_DOWNGRADE
}

fn check_policy(compat: u8, bump: u8) -> i32 {
    if bump == BUMP_DOWNGRADE {
        return EXIT_SEMVER_MISMATCH
    }
    if compat == COMPAT_IDENTICAL {
        return EXIT_OK
    }
    if compat == COMPAT_ADDITIVE {
        if bump == BUMP_PATCH {
            return EXIT_SEMVER_MISMATCH
        }
        return EXIT_OK
    }
    if compat == COMPAT_BREAKING {
        if bump == BUMP_MAJOR {
            return EXIT_OK
        }
        return EXIT_BREAKING
    }
    EXIT_OK
}

// 3. Mangling dot sanitization simulation
fn sanitize_dots(s: view<[8]u8>, len: usize, out: mut_view<[8]u8>) {
    let mut i: usize = 0usize
    while i < len && i < 8usize {
        let b = (*s)[i]
        if b == 46u8 { // '.'
            (*out)[i] = 95u8 // '_'
        } else {
            (*out)[i] = b
        }
        i = i + 1usize
    }
}

pub fn main() -> i32 {
    // -------------------------------------------------------------------------
    // A. Enum boundary cases
    // -------------------------------------------------------------------------
    let v_a = VariantModel { name_id: 1u32, tag: 0u64 }
    let v_b = VariantModel { name_id: 2u32, tag: 1u64 }
    let v_c = VariantModel { name_id: 3u32, tag: 2u64 }
    let dummy_v = VariantModel { name_id: 0u32, tag: 0u64 }

    let mut base_vars: [4]VariantModel = [dummy_v; 4]
    base_vars[0] = v_a
    base_vars[1] = v_b

    let base_enum = EnumModel {
        name_id: 10u32,
        repr_kind: 5u8, // u32
        is_non_exhaustive: false,
        variant_count: 2u32,
    }

    // A1: Discriminant tag altered (tag 1 -> 5) -> breaking
    let mut vars_tag_change: [4]VariantModel = [dummy_v; 4]
    vars_tag_change[0] = v_a
    vars_tag_change[1] = VariantModel { name_id: 2u32, tag: 5u64 }
    let c_tag = check_enum_compat(base_enum, view(base_vars), base_enum, view(vars_tag_change))
    if c_tag != COMPAT_BREAKING {
        return 1
    }

    // A2: Variant removed -> breaking
    let mut vars_removed: [4]VariantModel = [dummy_v; 4]
    vars_removed[0] = v_a
    let enum_removed = EnumModel {
        name_id: 10u32,
        repr_kind: 5u8,
        is_non_exhaustive: false,
        variant_count: 1u32,
    }
    let c_rem = check_enum_compat(base_enum, view(base_vars), enum_removed, view(vars_removed))
    if c_rem != COMPAT_BREAKING {
        return 2
    }

    // A3: Variant added to exhaustive enum -> breaking
    let mut vars_added: [4]VariantModel = [dummy_v; 4]
    vars_added[0] = v_a
    vars_added[1] = v_b
    vars_added[2] = v_c
    let enum_exh_added = EnumModel {
        name_id: 10u32,
        repr_kind: 5u8,
        is_non_exhaustive: false,
        variant_count: 3u32,
    }
    let c_exh = check_enum_compat(base_enum, view(base_vars), enum_exh_added, view(vars_added))
    if c_exh != COMPAT_BREAKING {
        return 3
    }

    // A4: Variant added to @non_exhaustive enum -> additive
    let enum_non_exh_base = EnumModel {
        name_id: 10u32,
        repr_kind: 5u8,
        is_non_exhaustive: true,
        variant_count: 2u32,
    }
    let enum_non_exh_new = EnumModel {
        name_id: 10u32,
        repr_kind: 5u8,
        is_non_exhaustive: true,
        variant_count: 3u32,
    }
    let c_non_exh = check_enum_compat(enum_non_exh_base, view(base_vars), enum_non_exh_new, view(vars_added))
    if c_non_exh != COMPAT_ADDITIVE {
        return 4
    }

    // -------------------------------------------------------------------------
    // B. SemVer 0.x.y & downgrade boundary cases
    // -------------------------------------------------------------------------
    let v010 = SemVerModel { major: 0u32, minor: 1u32, patch: 0u32, is_valid: true }
    let v011 = SemVerModel { major: 0u32, minor: 1u32, patch: 1u32, is_valid: true }
    let v020 = SemVerModel { major: 0u32, minor: 2u32, patch: 0u32, is_valid: true }
    let v100 = SemVerModel { major: 1u32, minor: 0u32, patch: 0u32, is_valid: true }
    let v120 = SemVerModel { major: 1u32, minor: 2u32, patch: 0u32, is_valid: true }
    let v110 = SemVerModel { major: 1u32, minor: 1u32, patch: 0u32, is_valid: true }
    let v200 = SemVerModel { major: 2u32, minor: 0u32, patch: 0u32, is_valid: true }
    let v199 = SemVerModel { major: 1u32, minor: 9u32, patch: 9u32, is_valid: true }

    // 0.1.0 -> 0.1.1 is patch
    let b_011 = eval_semver_bump(v010, v011)
    if b_011 != BUMP_PATCH || check_policy(COMPAT_ADDITIVE, b_011) != EXIT_SEMVER_MISMATCH {
        return 5
    }

    // 0.1.0 -> 0.2.0 is minor
    let b_020 = eval_semver_bump(v010, v020)
    if b_020 != BUMP_MINOR || check_policy(COMPAT_ADDITIVE, b_020) != EXIT_OK || check_policy(COMPAT_BREAKING, b_020) != EXIT_BREAKING {
        return 6
    }

    // 0.1.0 -> 1.0.0 is major
    let b_100 = eval_semver_bump(v010, v100)
    if b_100 != BUMP_MAJOR || check_policy(COMPAT_BREAKING, b_100) != EXIT_OK {
        return 7
    }

    // Downgrades:
    // 1.2.0 -> 1.1.0 (minor downgrade)
    let b_down_min = eval_semver_bump(v120, v110)
    if b_down_min != BUMP_DOWNGRADE || check_policy(COMPAT_IDENTICAL, b_down_min) != EXIT_SEMVER_MISMATCH {
        return 8
    }

    // 2.0.0 -> 1.9.9 (major downgrade)
    let b_down_maj = eval_semver_bump(v200, v199)
    if b_down_maj != BUMP_DOWNGRADE || check_policy(COMPAT_IDENTICAL, b_down_maj) != EXIT_SEMVER_MISMATCH {
        return 9
    }

    // -------------------------------------------------------------------------
    // C. Mangling dot sanitization
    // -------------------------------------------------------------------------
    // "a.b.c" -> [97, 46, 98, 46, 99]
    let mut raw_name: [8]u8 = [0u8; 8]
    raw_name[0] = 97u8 // 'a'
    raw_name[1] = 46u8 // '.'
    raw_name[2] = 98u8 // 'b'
    raw_name[3] = 46u8 // '.'
    raw_name[4] = 99u8 // 'c'

    let mut sanitized: [8]u8 = [0u8; 8]
    sanitize_dots(view(raw_name), 5usize, mut_view(sanitized))
    // Expect: 'a', '_', 'b', '_', 'c' (97, 95, 98, 95, 99)
    if sanitized[0] != 97u8 || sanitized[1] != 95u8 || sanitized[2] != 98u8 || sanitized[3] != 95u8 || sanitized[4] != 99u8 {
        return 10
    }

    print("ABI-COMPAT-DIFF-EDGE-CASES-OK\n")
    0
}
