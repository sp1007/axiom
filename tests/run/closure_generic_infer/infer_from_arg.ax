// test: run
// exit: 0
// stdout: 42 17 1 300 99\n
// T423c: generic calls inside closure bodies infer type arguments from call arguments.

struct WidePair {
    a: i64,
    b: i64,
}

fn sink<T>(v: T) {}

fn id<T>(v: T) -> T {
    v
}

fn sum_pair_second<A, B>(a: A, b: B) -> B {
    sink(a);
    b
}

pub fn main() -> i32 {
    let base: i64 = 40i64;
    let c1 = || -> i64 {
        sink(base);
        id(base + 2i64)
    };

    let c2 = |x: u8| -> i64 {
        let u = id(x);
        u as i64
    };

    let c3 = || -> i64 {
        if id(true) { 1i64 } else { 0i64 }
    };

    let c4 = || -> i64 {
        let wp = id(WidePair { a: 120i64, b: 180i64 });
        wp.a + wp.b
    };

    let c5 = || -> i64 {
        sum_pair_second(WidePair { a: 1i64, b: 2i64 }, 99i64)
    };

    print_int(c1());
    print(" ");
    print_int(c2(17u8));
    print(" ");
    print_int(c3());
    print(" ");
    print_int(c4());
    print(" ");
    print_int(c5());
    print("\n");
    0
}
