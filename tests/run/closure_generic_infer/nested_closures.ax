// T423c: nested closures (3 levels deep) each making inferred generic calls and capturing outer bindings.

fn id<T>(v: T) -> T {
    v
}

fn combine<A, B>(a: A, _b: B) -> A {
    a
}

pub fn main() -> i32 {
    let outer_v: i64 = 100i64;
    let level1 = |x: i64| -> i64 {
        let a = id(outer_v) + id(x);
        let level2 = |y: u8| -> i64 {
            let b = combine(a, id(true)) + (id(y) as i64);
            let level3 = || -> i64 {
                let c = id(b) + id(6i64);
                c
            };
            level3()
        };
        level2(40u8)
    };
    print_int(level1(100i64));
    print("\n");
    0
}
