// test: run
// exit: 0
// stdout: 42 9 300 77 150\n
// T423c: closures inside a generic fn (and generic impl method) calling another generic fn
// without type arguments using the enclosing `T`.

struct Pair16 {
    lo: i64,
    hi: i64,
}

struct Holder<T> {
    val: T,
}

fn passthrough<U>(u: U) -> U {
    u
}

fn tag_second<A, B>(a: A, b: B) -> B {
    let _ = passthrough(a);
    b
}

fn invoke_once<R, F: FnOnce<R>>(f: F) -> R {
    f()
}

fn direct_in_generic<T>(x: T) -> T {
    let c = || -> T {
        passthrough(x)
    };
    c()
}

fn hof_in_generic<T>(x: T) -> T {
    invoke_once(|| -> T {
        passthrough(x)
    })
}

fn nested_in_generic<T>(x: T) -> i64 {
    let outer_c = || -> i64 {
        let inner_c = || -> i64 {
            tag_second(x, 77i64)
        };
        inner_c()
    };
    outer_c()
}

impl<T: Copy> Holder<T> {
    fn extract_via_closure(self: view<Holder<T>>) -> T {
        let v = self.val;
        let c = || -> T {
            passthrough(v)
        };
        c()
    }
}

pub fn main() -> i32 {
    let r1 = direct_in_generic(42i64);
    let r2 = hof_in_generic(9u8);
    let p = hof_in_generic(Pair16 { lo: 125i64, hi: 175i64 });
    let r4 = nested_in_generic(Pair16 { lo: 1i64, hi: 2i64 });
    let h = Holder { val: 150i64 };
    let r5 = h.extract_via_closure();

    print_int(r1);
    print(" ");
    print_int(r2 as i64);
    print(" ");
    print_int(p.lo + p.hi);
    print(" ");
    print_int(r4);
    print(" ");
    print_int(r5);
    print("\n");
    0
}
