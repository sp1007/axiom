// test: run
// exit: 0
// stdout: 70 80 12 90 110 130\n
// T423c: generic calls inside closure bodies infer `T` from expected return types
// (explicit `-> T`, `return`, typed `let`, `fn() -> T` coercion, HOF bound, and post-closure unification).

trait Seeded {
    fn from_seed(s: i64) -> Self;
}

impl Seeded for i64 {
    fn from_seed(s: i64) -> i64 {
        s * 10i64
    }
}

impl Seeded for i32 {
    fn from_seed(s: i64) -> i32 {
        (s as i32) + 5
    }
}

fn make_seeded<T: Seeded>(s: i64) -> T {
    T.from_seed(s)
}

fn run_i64<F: FnOnce<i64>>(f: F) -> i64 {
    f()
}

fn apply_once<R, F: FnOnce<R>>(f: F) -> R {
    f()
}

pub fn main() -> i32 {
    // 1. Tail expression of `|| -> i64 { ... }`
    let c1 = || -> i64 {
        make_seeded(7i64)
    };

    // 2. Explicit `return` inside closure body
    let c2 = |flag: bool| -> i64 {
        if flag {
            return make_seeded(8i64);
        }
        0i64
    };

    // 3. Typed `let` binding inside closure body (`T = i32`)
    let c3 = || -> i64 {
        let local_v: i32 = make_seeded(7i64);
        local_v as i64
    };

    // 4. Non-capturing closure coerced to `fn() -> i64` without `-> i64` annotation
    let fp: fn() -> i64 = || make_seeded(9i64);

    // 5. Unannotated closure passed to `FnOnce<i64>` HOF
    let v5 = run_i64(|| {
        make_seeded(11i64)
    });

    // 6. Unannotated closure passed to generic `apply_once<R, F>` where `R` unifies with `i64` after the call
    let v6: i64 = apply_once(|| {
        make_seeded(13i64)
    });

    print_int(c1());
    print(" ");
    print_int(c2(true));
    print(" ");
    print_int(c3());
    print(" ");
    print_int(fp());
    print(" ");
    print_int(v5);
    print(" ");
    print_int(v6);
    print("\n");
    0
}
