// test: run
// exit: 0
// stdout: 100 200 300 400 500 600 700 800 900 1000 1100 1200 1300 777\n
// T423c QA adversarial test:
// - Closures inside a generic `impl<A, B>` method with its own method-level generic `<C>`,
//   capturing multi-word structs (16-byte Pair16, 24-byte Triple24) and calling generic fns
//   without turbofish at multiple distinct concrete instantiations.
// - Post-closure TY_VAR unification across nested closures with inferred param & return types.

@derive(Copy)
struct Pair16 {
    x: i64,
    y: i64,
}

@derive(Copy)
struct Triple24 {
    a: i64,
    b: i64,
    c: i64,
}

struct Combo<A, B> {
    first: A,
    second: B,
}

fn id<T>(v: T) -> T {
    v
}

fn pick_third<X, Y, Z>(x: X, y: Y, z: Z) -> Z {
    let _ = id(x);
    let _ = id(y);
    id(z)
}

fn invoke_once<R, F: FnOnce<R>>(f: F) -> R {
    f()
}

fn apply_deferred<T, R, F: FnOnce<T, R>>(f: F, x: T) -> R {
    f(x)
}

impl<A: Copy, B: Copy> Combo<A, B> {
    fn combine_with<C: Copy>(self: view<Combo<A, B>>, c: C) -> (A, B, C) {
        let a1 = self.first;
        let b1 = self.second;
        let a2 = self.first;
        let b2 = self.second;
        let outer = || -> (A, B, C) {
            let inner = || -> C {
                pick_third(a2, b2, c)
            };
            (id(a1), id(b1), inner())
        };
        invoke_once(outer)
    }
}

pub fn main() -> i32 {
    // Instantiation 1: (Pair16, Triple24, i64)
    let c1 = Combo {
        first: Pair16 { x: 100i64, y: 200i64 },
        second: Triple24 { a: 300i64, b: 400i64, c: 500i64 },
    };
    let r1 = c1.combine_with(600i64);

    // Instantiation 2: (Triple24, u8, Pair16)
    let c2 = Combo {
        first: Triple24 { a: 700i64, b: 800i64, c: 900i64 },
        second: 10u8,
    };
    let r2 = c2.combine_with(Pair16 { x: 1100i64, y: 1200i64 });

    // Instantiation 3: (i64, i64, Triple24)
    let c3 = Combo { first: 1i64, second: 2i64 };
    let r3 = c3.combine_with(Triple24 { a: 400i64, b: 400i64, c: 500i64 });

    // Post-closure TY_VAR unification across nested closures (param + return type inferred after closure)
    let r4: i64 = apply_deferred(|v| {
        let inner = |w| id(w) + id(77i64);
        inner(id(v))
    }, 700i64);

    print_int(r1.0.x);
    print(" ");
    print_int(r1.0.y);
    print(" ");
    print_int(r1.1.a);
    print(" ");
    print_int(r1.1.b);
    print(" ");
    print_int(r1.1.c);
    print(" ");
    print_int(r1.2);
    print(" ");
    print_int(r2.0.a);
    print(" ");
    print_int(r2.0.b);
    print(" ");
    print_int(r2.0.c);
    print(" ");
    print_int((r2.1 as i64) * 100i64);
    print(" ");
    print_int(r2.2.x);
    print(" ");
    print_int(r2.2.y);
    print(" ");
    print_int(r3.2.a + r3.2.b + r3.2.c);
    print(" ");
    print_int(r4);
    print("\n");
    0
}
