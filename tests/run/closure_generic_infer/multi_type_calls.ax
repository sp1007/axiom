// T423c: multiple generic calls with distinct inferred `T` instantiations inside one closure body.

struct Box2 {
    x: i64,
    y: i64,
}

fn id<T>(v: T) -> T {
    v
}

fn pick_left<A, B>(a: A, _b: B) -> A {
    a
}

pub fn main() -> i32 {
    let k: i64 = 50i64;
    let c = || -> i64 {
        let a = id(k);
        let b = id(true);
        let u = id(15u8);
        let s = id("Xin chào thế giới");
        let p = id(Box2 { x: 30i64, y: 49i64 });
        let m = pick_left(20i64, false);
        let bonus: i64 = if b && len(s) > 0usize { 1i64 } else { 0i64 };
        a + (u as i64) + p.x + p.y + m + bonus
    };
    print_int(c());
    print("\n");
    0
}
