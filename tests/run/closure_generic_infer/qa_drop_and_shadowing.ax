// test: run
// exit: 0
// stdout: S D1 11 D2 22 43\n
// T423c QA adversarial test:
// 1. Prelude `drop(non_copy)` inside a non-`move` closure still infers CAP_MOVE and runs Drop once.
// 2. User-defined generic `fn my_generic<T>(x: T) -> T` called without turbofish inside a closure
//    does not trigger TY_BUILTIN_DROP or leave orphaned TY_VARs.
// 3. Shadowing `drop` with a local closure inside an enclosing closure does not falsely trigger
//    TY_BUILTIN_DROP capture-move.

struct Tracked {
    id: i64,
    val: i64,
}

impl Drop for Tracked {
    fn drop(self: mut_view<Tracked>) {
        print("D");
        print_int(self.id);
        print(" ");
    }
}

fn my_generic<T>(x: T) -> T {
    x
}

fn run_once<F: FnOnce<i64>>(f: F) -> i64 {
    f()
}

pub fn main() -> i32 {
    print("S ");

    // Case 1: prelude `drop(t1)` inside a non-`move` closure infers CAP_MOVE and runs Drop once.
    let t1 = Tracked { id: 1i64, val: 11i64 };
    let c1 = || -> i64 {
        let v = my_generic(t1.val);
        drop(t1);
        v
    };
    let r1 = run_once(c1);
    print_int(r1);
    print(" ");

    // Case 2: user-defined generic fn consuming a non-Copy Drop value + another generic call.
    let t2 = Tracked { id: 2i64, val: 22i64 };
    let r2 = run_once(|| -> i64 {
        let moved = my_generic(t2);
        let bonus = my_generic(0i64);
        moved.val + bonus
    });
    print_int(r2);
    print(" ");

    // Case 3: locally shadowed `drop` callable inside a closure does not confuse `tc_is_builtin_drop_callee`.
    let base: i64 = 40i64;
    let c3 = || -> i64 {
        let drop = |x: i64| -> i64 { my_generic(x) + 3i64 };
        drop(base)
    };
    print_int(c3());
    print("\n");
    0
}
