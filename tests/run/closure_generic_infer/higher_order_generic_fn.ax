// test: run
// exit: 0
// stdout: 84 60 123\n
// T423c: closures passed to generic higher-order functions (Fn, FnMut, FnOnce, and
// reverse-ordered parameter inference) calling generic fns without `<...>`.

fn id<T>(v: T) -> T {
    v
}

fn pair_sum<A, B>(_tag: A, v: B) -> B {
    v
}

fn map_twice<A: Copy, B, C, F: Fn<A, B>, G: FnOnce<B, C>>(x: A, f: F, g: G) -> C {
    let mid = f(x);
    g(mid)
}

fn repeat_mut<F: FnMut<i64, ()>>(mut f: F, n: i64) {
    let mut i: i64 = 1i64;
    while i <= n {
        f(i);
        i = i + 1i64;
    }
}

fn apply_after<A, B, F: FnOnce<A, B>>(f: F, a: A) -> B {
    f(a)
}

pub fn main() -> i32 {
    let factor: i64 = 2i64;
    let r1 = map_twice(
        21i64,
        |x| id(x) * factor,
        |y| pair_sum(true, id(y) * 2i64)
    );

    let mut acc: i64 = 0i64;
    repeat_mut(|step| {
        acc = acc + id(step) * 20i64;
    }, 2i64);

    // Closure parameter `v` is typed as a fresh TY_VAR during `check_expr_closure` and resolved
    // by the second argument `120i64` afterwards.
    let r3 = apply_after(|v| id(v) + id(3i64), 120i64);

    print_int(r1);
    print(" ");
    print_int(acc);
    print(" ");
    print_int(r3);
    print("\n");
    0
}
