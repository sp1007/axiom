// test: run
// exit: 0
// stdout: 25 130 99 77\n
// T423c: method-style generic calls (inherent, generic-impl, type-qualified, and trait methods)
// without explicit `<...>` inside closure bodies.

struct Adder {
    base: i64,
}

impl Adder {
    fn add_with_tag<T>(self: view<Adder>, _tag: T, delta: i64) -> i64 {
        self.base + delta
    }

    fn seed<T>(tag: T, v: i64) -> i64 {
        let _ = tag;
        v
    }
}

struct Wrap<A> {
    first: A,
}

impl<A: Copy> Wrap<A> {
    fn combine<B>(self: view<Wrap<A>>, _other: B, extra: i64) -> (A, i64) {
        (self.first, extra)
    }
}

trait Scorer {
    fn score(self: view<Self>) -> i64;
}

impl Scorer for i64 {
    fn score(self: view<i64>) -> i64 {
        *self
    }
}

struct Evaluator {
    offset: i64,
}

impl Evaluator {
    fn eval<S: Scorer>(self: view<Evaluator>, item: S) -> i64 {
        self.offset + item.score()
    }
}

pub fn main() -> i32 {
    let ad = Adder { base: 10i64 };
    let c1 = || -> i64 {
        ad.add_with_tag(true, 15i64)
    };

    let w = Wrap { first: 100i64 };
    let c2 = || -> i64 {
        let p = w.combine(7u8, 30i64);
        p.0 + p.1
    };

    let c3 = || -> i64 {
        Adder.seed("Xin chào thế giới", 99i64)
    };

    let ev = Evaluator { offset: 7i64 };
    let c4 = || -> i64 {
        ev.eval(70i64)
    };

    print_int(c1());
    print(" ");
    print_int(c2());
    print(" ");
    print_int(c3());
    print(" ");
    print_int(c4());
    print("\n");
    0
}
