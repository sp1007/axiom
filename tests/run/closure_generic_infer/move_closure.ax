// test: run
// exit: 0
// stdout: C D1 55 D2 88\n
// T423c: move-capturing closure (inferred CAP_MOVE on non-Copy Drop resource)
// passing the moved capture into an inferred generic call.

struct OwnedToken {
    val: i64,
    id: i64,
}

impl Drop for OwnedToken {
    fn drop(self: mut_view<OwnedToken>) {
        print("D");
        print_int(self.id);
        print(" ");
    }
}

fn consume_generic<T>(v: T) -> T {
    v
}

fn take_and_score<T>(v: T, bonus: i64) -> i64 {
    let _ = v;
    bonus
}

fn run_once<F: FnOnce<i64>>(f: F) -> i64 {
    f()
}

pub fn main() -> i32 {
    let tok1 = OwnedToken {
        val: 50i64,
        id: 1i64,
    };
    let move_clos = || -> i64 {
        let moved_tok = consume_generic(tok1);
        moved_tok.val + 5i64
    };
    print("C ");
    let r1 = move_clos();
    print_int(r1);
    print(" ");

    let tok2 = OwnedToken {
        val: 10i64,
        id: 2i64,
    };
    let r2 = run_once(|| -> i64 {
        take_and_score(tok2, 88i64)
    });
    print_int(r2);
    print("\n");
    0
}
