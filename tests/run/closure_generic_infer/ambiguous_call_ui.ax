// test: ui
// T423c: genuinely unconstrained generic calls inside closure bodies still report
// AX_TYPE_UNKNOWN at the exact call/callee span (once per ambiguous call).

fn mystery<T>() -> i64 {
    0i64
}

struct Probe {
    v: i64,
}

impl Probe {
    fn unknown_tag<T>(self: view<Probe>) -> i64 {
        self.v
    }
}

fn run_it<F: FnOnce<i64>>(f: F) -> i64 {
    f()
}

fn main() -> i32 {
    let p = Probe { v: 1i64 };
    let r = run_it(|| -> i64 {
        let a = mystery(); //~ ERROR AX_TYPE_UNKNOWN
        let inner = || -> i64 {
            let b = mystery(); //~ ERROR AX_TYPE_UNKNOWN
            let c = p.unknown_tag(); //~ ERROR AX_TYPE_UNKNOWN
            b + c
        };
        a + inner()
    });
    r as i32
}
