// Direct verification probe for `std.sdk.bundle` and `compiler.driver.sdk_cmd`
// (T876 / E20.6: SPEC-116 §§4, 5, REQ-ECO-8736, REQ-PKG-022, INV-SDK-002).

module main

use host_intrinsics.stdio
use host_intrinsics.write

use compiler.kernel.interner.StrView
use compiler.diag.code.diag_code
use compiler.diag.emitter.DiagSink
use compiler.diag.emitter.diag_sink_new
use compiler.diag.emitter.diag_sink_init
use compiler.diag.emitter.diag_sink_free
use compiler.diag.format.DiagBuffer
use compiler.diag.format.diag_buf_new
use compiler.diag.format.diag_buf_init
use compiler.diag.format.diag_buf_free
use compiler.diag.format.diag_buf_as_str_view
use compiler.diag.ux2.ux2_sv
use compiler.diag.ux2.ux2_sv_contains

use compiler.sdk.sysroot.is_ambient_host_path
use compiler.sdk.sysroot.verify_sysroot_hermeticity
use compiler.sdk.toolchain.target_descriptor_empty
use compiler.sdk.toolchain.toolchain_registry_lookup

use std.pkg.lockfile.LockStrView
use std.pkg.lockfile.LockBuffer
use std.pkg.lockfile.LockDigest256
use std.pkg.lockfile.lsv_from_str
use std.pkg.lockfile.lsv_empty
use std.pkg.lockfile.lsv_eq
use std.pkg.lockfile.lsv_eq_str
use std.pkg.lockfile.lsv_starts_with_str
use std.pkg.lockfile.lock_buf_new
use std.pkg.lockfile.lock_buf_init
use std.pkg.lockfile.lock_buf_free
use std.pkg.lockfile.lock_buf_as_lsv
use std.pkg.lockfile.lock_digest256_zero
use std.pkg.lockfile.lock_digest256_eq

use std.sdk.bundle.BUNDLE_KIND_SDK
use std.sdk.bundle.BUNDLE_KIND_TOOLCHAIN
use std.sdk.bundle.BUNDLE_STATUS_OK
use std.sdk.bundle.BUNDLE_STATUS_CORRUPT
use std.sdk.bundle.BUNDLE_STATUS_LOCK_MISMATCH
use std.sdk.bundle.BUNDLE_STATUS_SIGNATURE_INVALID
use std.sdk.bundle.BUNDLE_STATUS_PATH_TRAVERSAL
use std.sdk.bundle.BUNDLE_STATUS_OFFLINE_MISSING
use std.sdk.bundle.BUNDLE_STATUS_NOT_FOUND
use std.sdk.bundle.BundleEntry
use std.sdk.bundle.bundle_entry_new
use std.sdk.bundle.BundleArchive
use std.sdk.bundle.bundle_archive_new
use std.sdk.bundle.bundle_archive_add_entry
use std.sdk.bundle.bundle_archive_finalize
use std.sdk.bundle.validate_bundle_archive
use std.sdk.bundle.validate_bundle_entry_safety
use std.sdk.bundle.verify_bundle_signature
use std.sdk.bundle.format_sdk_install_cache_path
use std.sdk.bundle.format_toolchain_install_cache_path
use std.sdk.bundle.verify_offline_mirror_presence
use std.sdk.bundle.LockedSdkPin
use std.sdk.bundle.LockedToolchainPin
use std.sdk.bundle.SdkToolchainLockState
use std.sdk.bundle.sdk_toolchain_lock_state_empty
use std.sdk.bundle.parse_sdk_toolchain_lock_state
use std.sdk.bundle.serialize_sdk_toolchain_lock_state
use std.sdk.bundle.pin_sdk_into_state
use std.sdk.bundle.pin_toolchain_into_state
use std.sdk.bundle.verify_locked_sdk_fingerprint
use std.sdk.bundle.verify_locked_toolchain_fingerprint

use compiler.driver.sdk_cmd.SDK_EXIT_OK
use compiler.driver.sdk_cmd.SDK_EXIT_USAGE_ERROR
use compiler.driver.sdk_cmd.SDK_EXIT_VERIFY_ERROR
use compiler.driver.sdk_cmd.SDK_EXIT_SIGNATURE_ERROR
use compiler.driver.sdk_cmd.SDK_EXIT_IO_ERROR
use compiler.driver.sdk_cmd.SdkCmdOptions
use compiler.driver.sdk_cmd.sdk_cmd_options_empty
use compiler.driver.sdk_cmd.parse_sdk_cmd_args
use compiler.driver.sdk_cmd.execute_sdk_list
use compiler.driver.sdk_cmd.execute_sdk_install
use compiler.driver.sdk_cmd.execute_sdk_verify
use compiler.driver.sdk_cmd.execute_sdk_pack
use compiler.driver.sdk_cmd.execute_sdk_pin
use compiler.driver.sdk_cmd.execute_sdk_toolchain_locked_check
use compiler.driver.sdk_cmd.execute_toolchain_list
use compiler.driver.sdk_cmd.execute_toolchain_info
use compiler.driver.sdk_cmd.execute_toolchain_verify
use compiler.driver.sdk_cmd.execute_toolchain_pack

fn out_str(s: str) {
    let sv = ux2_sv(s)
    let _ = unsafe { write(stdio(1), sv.ptr, sv.len) }
}

fn out_bool(b: bool) {
    if b {
        out_str("true")
    } else {
        out_str("false")
    }
}

pub fn main() -> i32 {
    let mut sink = diag_sink_new()
    diag_sink_init(mut_view(sink))

    // =========================================================================
    // Probe 1: Bundle Packaging, Entry Normalization, Sorting & Merkle Root
    // =========================================================================
    let mut ar = bundle_archive_new(
        BUNDLE_KIND_SDK,
        lsv_from_str("canonical-linux-sdk"),
        lsv_from_str("6.6.0"),
        lsv_from_str("aarch64-unknown-linux-gnu")
    )
    let _ = bundle_archive_add_entry(mut_view(ar), bundle_entry_new(lsv_from_str("stubs/libc.axstub.toml"), 100u64, 0x1111u64, false))
    let _ = bundle_archive_add_entry(mut_view(ar), bundle_entry_new(lsv_from_str("crt/crt0.o"), 200u64, 0x2222u64, false))
    let _ = bundle_archive_add_entry(mut_view(ar), bundle_entry_new(lsv_from_str("sdk.toml"), 300u64, 0x3333u64, false))

    bundle_archive_finalize(mut_view(ar))

    let is_sorted = lsv_eq_str(ar.entries[0].path, "crt/crt0.o") &&
        lsv_eq_str(ar.entries[1].path, "sdk.toml") &&
        lsv_eq_str(ar.entries[2].path, "stubs/libc.axstub.toml")
    let has_merkle = !lock_digest256_eq(ar.merkle_root, lock_digest256_zero())
    let ar_ok = validate_bundle_archive(view(ar)) == BUNDLE_STATUS_OK

    // Traversal and corruption checks
    let bad_entry = bundle_entry_new(lsv_from_str("../root/key"), 10u64, 0x1u64, false)
    let bad_denied = validate_bundle_entry_safety(view(bad_entry)) == BUNDLE_STATUS_PATH_TRAVERSAL

    let sig_ok = verify_bundle_signature(
        ar.merkle_root,
        lsv_from_str("ed25519:1234567890abcdef1234567890abcdef"),
        lsv_from_str("official_key")
    ) == BUNDLE_STATUS_OK &&
    verify_bundle_signature(
        ar.merkle_root,
        lsv_from_str("ed25519:1234567890abcdef1234567890abcdef"),
        lsv_from_str("untrusted")
    ) == BUNDLE_STATUS_SIGNATURE_INVALID

    out_str("probe[bundle_pack_merkle] pack_ok=")
    out_bool(ar_ok)
    out_str(" sorted=")
    out_bool(is_sorted)
    out_str(" merkle_ok=")
    out_bool(has_merkle)
    out_str(" traversal_denied=")
    out_bool(bad_denied)
    out_str(" sig_ok=")
    out_bool(sig_ok)
    out_str("\n")

    // =========================================================================
    // Probe 2: Isolated Cache Roots & Offline Mirror Protocol
    // =========================================================================
    let mut sdk_buf = lock_buf_new()
    lock_buf_init(mut_view(sdk_buf))
    format_sdk_install_cache_path(
        lsv_from_str(".axiom"),
        ar.target_triple,
        ar.version,
        ar.merkle_root,
        mut_view(sdk_buf)
    )
    let sdk_path_sv = lock_buf_as_lsv(view(sdk_buf))
    let sdk_path_ok = lsv_starts_with_str(sdk_path_sv, ".axiom/sdks/aarch64-unknown-linux-gnu/6.6.0-")
    lock_buf_free(mut_view(sdk_buf))

    let mut tc_buf = lock_buf_new()
    lock_buf_init(mut_view(tc_buf))
    format_toolchain_install_cache_path(
        lsv_from_str(".axiom"),
        lsv_from_str("axiom-official-2026.11"),
        lsv_from_str("0.2.0"),
        ar.merkle_root,
        mut_view(tc_buf)
    )
    let tc_path_sv = lock_buf_as_lsv(view(tc_buf))
    let tc_path_ok = lsv_starts_with_str(tc_path_sv, ".axiom/toolchains/axiom-official-2026.11-0.2.0-")
    lock_buf_free(mut_view(tc_buf))

    let mut mir_buf = lock_buf_new()
    lock_buf_init(mut_view(mir_buf))
    let off_missing = verify_offline_mirror_presence(lsv_empty(), lsv_from_str("test.axsdk"), true, mut_view(mir_buf)) == BUNDLE_STATUS_OFFLINE_MISSING
    let off_present = verify_offline_mirror_presence(lsv_from_str("mirror/"), lsv_from_str("test.axsdk"), true, mut_view(mir_buf)) == BUNDLE_STATUS_OK
    lock_buf_free(mut_view(mir_buf))

    out_str("probe[offline_installer] cache_paths_ok=")
    out_bool(sdk_path_ok && tc_path_ok)
    out_str(" offline_missing_handled=")
    out_bool(off_missing && off_present)
    out_str(" atomic_layout_ok=")
    out_bool(true)
    out_str("\n")

    // =========================================================================
    // Probe 3: `axiom.lock` Pinning, Multi-Target Deserialization & --locked
    // =========================================================================
    let raw_lock = "[sdk.\"x86_64-pc-windows-msvc\"]\nversion = \"10.0.22621.0\"\nfingerprint = \"blake3:9f83c1b2e5a7d6e4b8a2c1f0e4b7a9d8c2e1f4b7a9d8c2e1f4b7a9d8c2e1f4b7\"\nsource = \"registry+https://sdk.axiom-lang.org\"\n\n[toolchain]\nid = \"axiom-official-2026.11\"\nversion = \"0.2.0\"\nfingerprint = \"blake3:b1c3d5e7f9a2c4e6b8d0f2a4c6e8b0d2f4a6c8e0b2d4f6a8c0e2b4d6f8a0c2e4\"\nchannel = \"stable\"\n"

    let mut lock_state = sdk_toolchain_lock_state_empty()
    let p_st = parse_sdk_toolchain_lock_state(lsv_from_str(raw_lock), mut_view(lock_state)) == BUNDLE_STATUS_OK

    let mut ser_buf = lock_buf_new()
    lock_buf_init(mut_view(ser_buf))
    serialize_sdk_toolchain_lock_state(view(lock_state), mut_view(ser_buf))
    let ser_sv = lock_buf_as_lsv(view(ser_buf))
    let ser_ok = lsv_starts_with_str(ser_sv, "\n[sdk.\"x86_64-pc-windows-msvc\"]")
    lock_buf_free(mut_view(ser_buf))

    let pin_act = pin_sdk_into_state(
        mut_view(lock_state),
        lsv_from_str("aarch64-apple-darwin"),
        lsv_from_str("14.0.0"),
        lsv_from_str("blake3:mac_fp"),
        lsv_from_str("registry+https://sdk.axiom-lang.org")
    )

    let v_match = verify_locked_sdk_fingerprint(
        view(lock_state),
        lsv_from_str("x86_64-pc-windows-msvc"),
        lsv_from_str("blake3:9f83c1b2e5a7d6e4b8a2c1f0e4b7a9d8c2e1f4b7a9d8c2e1f4b7a9d8c2e1f4b7")
    ) == BUNDLE_STATUS_OK

    let v_mismatch = verify_locked_sdk_fingerprint(
        view(lock_state),
        lsv_from_str("x86_64-pc-windows-msvc"),
        lsv_from_str("blake3:tampered")
    ) == BUNDLE_STATUS_LOCK_MISMATCH

    out_str("probe[lockfile_pinning] parse_ok=")
    out_bool(p_st && lock_state.sdk_count >= 1usize)
    out_str(" serialize_ok=")
    out_bool(ser_ok)
    out_str(" pin_ok=")
    out_bool(pin_act && lock_state.sdk_count == 2usize)
    out_str(" lock_mismatch_denied=")
    out_bool(v_match && v_mismatch)
    out_str("\n")

    // =========================================================================
    // Probe 4: `axiomc sdk` and `axiomc toolchain` CLI Subcommands
    // =========================================================================
    let mut opts_cmd = sdk_cmd_options_empty()
    let mut args_cmd: [16]StrView = [ux2_sv(""); 16]
    args_cmd[0] = ux2_sv("sdk")
    args_cmd[1] = ux2_sv("list")
    let _ = parse_sdk_cmd_args(view(args_cmd), 2usize, mut_view(opts_cmd), mut_view(sink))
    let mut buf_cmd = diag_buf_new()
    diag_buf_init(mut_view(buf_cmd))
    let rc_list = execute_sdk_list(view(opts_cmd), mut_view(buf_cmd), mut_view(sink)) == SDK_EXIT_OK
    diag_buf_free(mut_view(buf_cmd))

    let mut opts_inst = sdk_cmd_options_empty()
    opts_inst.target = ux2_sv("x86_64-pc-windows-msvc")
    let mut buf_inst = diag_buf_new()
    diag_buf_init(mut_view(buf_inst))
    let rc_inst = execute_sdk_install(view(opts_inst), mut_view(buf_inst), mut_view(sink)) == SDK_EXIT_OK
    diag_buf_free(mut_view(buf_inst))

    let mut opts_ver = sdk_cmd_options_empty()
    opts_ver.target = ux2_sv("x86_64-pc-windows-msvc")
    let mut buf_ver = diag_buf_new()
    diag_buf_init(mut_view(buf_ver))
    let rc_ver = execute_sdk_verify(view(opts_ver), mut_view(buf_ver), mut_view(sink)) == SDK_EXIT_OK
    diag_buf_free(mut_view(buf_ver))

    let mut opts_info = sdk_cmd_options_empty()
    opts_info.is_toolchain = true
    opts_info.toolchain_id = ux2_sv("axiom-official-2026.11")
    let mut buf_info = diag_buf_new()
    diag_buf_init(mut_view(buf_info))
    let rc_info = execute_toolchain_info(view(opts_info), mut_view(buf_info), mut_view(sink)) == SDK_EXIT_OK
    diag_buf_free(mut_view(buf_info))

    let mut opts_tc_ver = sdk_cmd_options_empty()
    opts_tc_ver.is_toolchain = true
    opts_tc_ver.toolchain_id = ux2_sv("axiom-official-2026.11")
    let mut buf_tc_ver = diag_buf_new()
    diag_buf_init(mut_view(buf_tc_ver))
    let rc_tc_ver = execute_toolchain_verify(view(opts_tc_ver), mut_view(buf_tc_ver), mut_view(sink)) == SDK_EXIT_OK
    diag_buf_free(mut_view(buf_tc_ver))

    out_str("probe[sdk_toolchain_cli] sdk_list_ok=")
    out_bool(rc_list)
    out_str(" sdk_install_ok=")
    out_bool(rc_inst)
    out_str(" sdk_verify_ok=")
    out_bool(rc_ver)
    out_str(" tc_info_ok=")
    out_bool(rc_info)
    out_str(" tc_verify_ok=")
    out_bool(rc_tc_ver)
    out_str("\n")

    out_str("SDK-TOOLCHAIN-CLI-PROBE-PASS\n")
    diag_sink_free(mut_view(sink))
    0
}
