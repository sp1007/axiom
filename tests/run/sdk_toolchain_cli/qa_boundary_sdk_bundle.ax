// test: run
// modes: interp native
// stdout-file: qa_boundary_sdk_bundle.stdout
// SPEC-116 §§4, 5, AXS-SDK-035..054, REQ-ECO-8736, REQ-PKG-022:
// QA boundary cross-check test for hermetic bundle safety,
// multi-target lock pinning, signature validation, offline mirrors,
// and deterministic CLI exit code mapping.

fn print_bool(b: bool) {
    if b {
        print("true")
    } else {
        print("false")
    }
}

// Bundle & Lock Status Codes
const BUNDLE_OK: u32 = 0u32
const BUNDLE_CORRUPT: u32 = 1u32
const BUNDLE_LOCK_MISMATCH: u32 = 2u32
const BUNDLE_SIGNATURE_INVALID: u32 = 3u32
const BUNDLE_PATH_TRAVERSAL: u32 = 4u32
const BUNDLE_OFFLINE_MISSING: u32 = 5u32
const BUNDLE_NOT_FOUND: u32 = 7u32

// File modes
const MODE_DATA: u32 = 420u32 // 0o644
const MODE_EXEC: u32 = 493u32 // 0o755
const MODE_WORLD: u32 = 511u32 // 0o777 (forbidden)

// CLI Exit Codes per AXS-SDK-054
const EXIT_OK: i32 = 0i32
const EXIT_GENERAL_ERROR: i32 = 1i32
const EXIT_USAGE_ERROR: i32 = 2i32
const EXIT_VERIFY_ERROR: i32 = 3i32
const EXIT_SIGNATURE_ERROR: i32 = 4i32
const EXIT_IO_ERROR: i32 = 5i32

// 1. Entry safety validation simulation
fn check_entry_safety_boundary(
    path_kind: u32,
    mtime: u64,
    mode: u32
) -> u32 {
    // path_kind: 0 = ok, 1 = parent (..), 2 = root (/), 3 = drive (C:\)
    if path_kind == 1u32 || path_kind == 2u32 || path_kind == 3u32 {
        return BUNDLE_PATH_TRAVERSAL
    }
    // AXS-SDK-043 §2: mtime must be normalized to 0
    if mtime != 0u64 {
        return BUNDLE_CORRUPT
    }
    // Mode must be standard data (0o644) or exec (0o755)
    if mode != MODE_DATA && mode != MODE_EXEC {
        return BUNDLE_CORRUPT
    }
    BUNDLE_OK
}

// 2. Signature verification simulation
fn check_signature_boundary(
    sig_scheme: u32, // 1 = ed25519, 2 = rsa, 0 = empty
    hex_len: usize,
    key_trusted: bool
) -> u32 {
    if sig_scheme != 1u32 {
        return BUNDLE_SIGNATURE_INVALID
    }
    if hex_len < 16usize {
        return BUNDLE_SIGNATURE_INVALID
    }
    if !key_trusted {
        return BUNDLE_SIGNATURE_INVALID
    }
    BUNDLE_OK
}

// 3. Multi-target lock pinning state
const TARGET_WIN_X64: u32 = 1u32
const TARGET_LINUX_X64: u32 = 2u32
const TARGET_LINUX_ARM64: u32 = 3u32
const TARGET_DARWIN_ARM64: u32 = 4u32
const TARGET_WASM32: u32 = 5u32
const TARGET_RISCV64: u32 = 6u32

@derive(Copy)
struct PinEntry {
    target_id: u32,
    fingerprint: u64,
    is_valid: bool,
}

@derive(Copy)
struct LockStateBoundary {
    targets: [6]PinEntry,
    count: usize,
    tc_id: u32,
    tc_fp: u64,
    has_tc: bool,
}

fn lock_state_empty_boundary() -> LockStateBoundary {
    let empty_pin = PinEntry { target_id: 0u32, fingerprint: 0u64, is_valid: false }
    LockStateBoundary {
        targets: [empty_pin, empty_pin, empty_pin, empty_pin, empty_pin, empty_pin],
        count: 0usize,
        tc_id: 0u32,
        tc_fp: 0u64,
        has_tc: false,
    }
}

fn verify_sdk_pin(state: LockStateBoundary, target: u32, active_fp: u64) -> u32 {
    let mut i: usize = 0usize
    while i < state.count {
        if state.targets[i].target_id == target {
            if state.targets[i].fingerprint == active_fp {
                return BUNDLE_OK
            }
            return BUNDLE_LOCK_MISMATCH
        }
        i = i + 1usize
    }
    BUNDLE_NOT_FOUND
}

fn verify_tc_pin(state: LockStateBoundary, tc_id: u32, active_fp: u64) -> u32 {
    if !state.has_tc {
        return BUNDLE_NOT_FOUND
    }
    if state.tc_id != tc_id {
        return BUNDLE_LOCK_MISMATCH
    }
    if state.tc_fp != active_fp {
        return BUNDLE_LOCK_MISMATCH
    }
    BUNDLE_OK
}

pub fn main() -> i32 {
    // A. Boundary tests: Archive Entry Safety (AXS-SDK-043)
    let s_ok = check_entry_safety_boundary(0u32, 0u64, MODE_DATA) == BUNDLE_OK
    let s_parent = check_entry_safety_boundary(1u32, 0u64, MODE_DATA) == BUNDLE_PATH_TRAVERSAL
    let s_root = check_entry_safety_boundary(2u32, 0u64, MODE_DATA) == BUNDLE_PATH_TRAVERSAL
    let s_drive = check_entry_safety_boundary(3u32, 0u64, MODE_DATA) == BUNDLE_PATH_TRAVERSAL
    let s_mtime = check_entry_safety_boundary(0u32, 12345678u64, MODE_DATA) == BUNDLE_CORRUPT
    let s_mode_bad = check_entry_safety_boundary(0u32, 0u64, MODE_WORLD) == BUNDLE_CORRUPT
    let s_exec_ok = check_entry_safety_boundary(0u32, 0u64, MODE_EXEC) == BUNDLE_OK
    let entry_safety_all = s_ok && s_parent && s_root && s_drive && s_mtime && s_mode_bad && s_exec_ok

    // B. Boundary tests: Signature Verification (AXS-SDK-044)
    let sig_valid = check_signature_boundary(1u32, 64usize, true) == BUNDLE_OK
    let sig_wrong_scheme = check_signature_boundary(2u32, 64usize, true) == BUNDLE_SIGNATURE_INVALID
    let sig_short = check_signature_boundary(1u32, 8usize, true) == BUNDLE_SIGNATURE_INVALID
    let sig_untrusted = check_signature_boundary(1u32, 64usize, false) == BUNDLE_SIGNATURE_INVALID
    let sig_all = sig_valid && sig_wrong_scheme && sig_short && sig_untrusted

    // C. Boundary tests: Multi-Target Pinning Matrix (AXS-SDK-037..039, REQ-PKG-022)
    let mut state = lock_state_empty_boundary()
    state.targets[0] = PinEntry { target_id: TARGET_WIN_X64, fingerprint: 0x11111111u64, is_valid: true }
    state.targets[1] = PinEntry { target_id: TARGET_LINUX_X64, fingerprint: 0x22222222u64, is_valid: true }
    state.targets[2] = PinEntry { target_id: TARGET_LINUX_ARM64, fingerprint: 0x33333333u64, is_valid: true }
    state.targets[3] = PinEntry { target_id: TARGET_DARWIN_ARM64, fingerprint: 0x44444444u64, is_valid: true }
    state.targets[4] = PinEntry { target_id: TARGET_WASM32, fingerprint: 0x55555555u64, is_valid: true }
    state.count = 5usize
    state.tc_id = 100u32
    state.tc_fp = 0xAAAAAAAAAAAAAAAAu64
    state.has_tc = true

    // Verify all 5 pinned targets match
    let v_win = verify_sdk_pin(state, TARGET_WIN_X64, 0x11111111u64) == BUNDLE_OK
    let v_lin_x64 = verify_sdk_pin(state, TARGET_LINUX_X64, 0x22222222u64) == BUNDLE_OK
    let v_lin_arm = verify_sdk_pin(state, TARGET_LINUX_ARM64, 0x33333333u64) == BUNDLE_OK
    let v_mac = verify_sdk_pin(state, TARGET_DARWIN_ARM64, 0x44444444u64) == BUNDLE_OK
    let v_wasm = verify_sdk_pin(state, TARGET_WASM32, 0x55555555u64) == BUNDLE_OK
    let multi_target_pass = v_win && v_lin_x64 && v_lin_arm && v_mac && v_wasm

    // Check negative and unpinned cases
    let v_unpinned = verify_sdk_pin(state, TARGET_RISCV64, 0x66666666u64) == BUNDLE_NOT_FOUND
    let v_drift = verify_sdk_pin(state, TARGET_WIN_X64, 0xBADF00Du64) == BUNDLE_LOCK_MISMATCH
    let v_tc_ok = verify_tc_pin(state, 100u32, 0xAAAAAAAAAAAAAAAAu64) == BUNDLE_OK
    let v_tc_wrong_id = verify_tc_pin(state, 999u32, 0xAAAAAAAAAAAAAAAAu64) == BUNDLE_LOCK_MISMATCH
    let v_tc_tampered = verify_tc_pin(state, 100u32, 0xBADF00Du64) == BUNDLE_LOCK_MISMATCH
    let pin_edge_cases = v_unpinned && v_drift && v_tc_ok && v_tc_wrong_id && v_tc_tampered

    // D. Exit codes contract per AXS-SDK-054
    let exit_codes_ok = (EXIT_OK == 0i32) &&
        (EXIT_GENERAL_ERROR == 1i32) &&
        (EXIT_USAGE_ERROR == 2i32) &&
        (EXIT_VERIFY_ERROR == 3i32) &&
        (EXIT_SIGNATURE_ERROR == 4i32) &&
        (EXIT_IO_ERROR == 5i32)

    print("qa_boundary: entry_safety=")
    print_bool(entry_safety_all)
    print(" signature=")
    print_bool(sig_all)
    print(" multi_target=")
    print_bool(multi_target_pass)
    print(" pin_edges=")
    print_bool(pin_edge_cases)
    print(" exit_codes=")
    print_bool(exit_codes_ok)
    print("\nQA-BOUNDARY-SDK-BUNDLE-PASS\n")

    0
}
