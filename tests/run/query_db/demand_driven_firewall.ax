// test: run
// modes: interp native
// stdout-file: demand_driven_firewall.stdout
// SPEC-21 AXS-QRY-001..005, AXS-QRY-010..012, AXS-QRY-020:
// Demand-driven evaluation, header/body firewall (checking caller `compute` queries
// `item_signature(square)` without evaluating `typeck_body(square)` or `unreferenced_heavy`),
// legal runtime recursion (`fact` queries `item_signature(fact)`), and warm memoization hits.

@derive(Copy)
struct QuerySlot {
    kind: u32,
    item_id: u32,
    state: u32,
    verified_at: u64,
    changed_at: u64,
    hits: u32,
    misses: u32,
    value_hash: u64,
}

struct MiniDB {
    slots: [36]QuerySlot,
}

const Q_PARSE_MODULE: u32 = 1u32;
const Q_MODULE_DEF_MAP: u32 = 2u32;
const Q_RESOLVE_MODULE: u32 = 3u32;
const Q_ITEM_SIGNATURE: u32 = 4u32;
const Q_TYPECK_BODY: u32 = 5u32;

const STATE_VACANT: u32 = 0u32;
const STATE_READY: u32 = 2u32;

const ITEM_SQUARE: u32 = 1u32;
const ITEM_COMPUTE: u32 = 2u32;
const ITEM_FACT: u32 = 3u32;
const ITEM_UNREF: u32 = 4u32;

fn slot_index(kind: u32, item_id: u32) -> usize {
    ((kind - 1u32) * 5u32 + item_id) as usize
}

fn eval_query(mdb: mut_view<MiniDB>, rev: u64, kind: u32, item_id: u32) -> u64 {
    let idx = slot_index(kind, item_id);
    if mdb.slots[idx].state == STATE_READY && mdb.slots[idx].verified_at == rev {
        mdb.slots[idx].hits = mdb.slots[idx].hits + 1u32;
        return mdb.slots[idx].value_hash;
    }
    mdb.slots[idx].misses = mdb.slots[idx].misses + 1u32;
    let mut h: u64 = ((kind as u64) << 16) ^ (item_id as u64);
    if kind == Q_MODULE_DEF_MAP {
        h = h ^ eval_query(mut_view(*mdb), rev, Q_PARSE_MODULE, 0u32);
    } else if kind == Q_RESOLVE_MODULE {
        let h1 = eval_query(mut_view(*mdb), rev, Q_PARSE_MODULE, 0u32);
        let h2 = eval_query(mut_view(*mdb), rev, Q_MODULE_DEF_MAP, 0u32);
        h = h ^ h1 ^ h2;
    } else if kind == Q_ITEM_SIGNATURE {
        h = h ^ eval_query(mut_view(*mdb), rev, Q_MODULE_DEF_MAP, 0u32);
    } else if kind == Q_TYPECK_BODY {
        let hr = eval_query(mut_view(*mdb), rev, Q_RESOLVE_MODULE, 0u32);
        let hs = eval_query(mut_view(*mdb), rev, Q_ITEM_SIGNATURE, item_id);
        h = h ^ hr ^ hs;
        if item_id == ITEM_COMPUTE {
            // AXS-QRY-004 Header/Body Firewall:
            // compute(a) calls square(a) -> queries item_signature(square), NOT typeck_body(square)!
            h = h ^ eval_query(mut_view(*mdb), rev, Q_ITEM_SIGNATURE, ITEM_SQUARE);
        } else if item_id == ITEM_FACT {
            // AXS-QRY-020 Legal runtime recursion:
            // fact(n) calls fact(n - 1) -> queries item_signature(fact), NOT typeck_body(fact)!
            h = h ^ eval_query(mut_view(*mdb), rev, Q_ITEM_SIGNATURE, ITEM_FACT);
        }
    }
    mdb.slots[idx].state = STATE_READY;
    mdb.slots[idx].verified_at = rev;
    mdb.slots[idx].changed_at = rev;
    mdb.slots[idx].value_hash = h;
    h
}

pub fn main() -> i32 {
    let mut mdb = MiniDB {
        slots: [QuerySlot {
            kind: 0u32,
            item_id: 0u32,
            state: STATE_VACANT,
            verified_at: 0u64,
            changed_at: 0u64,
            hits: 0u32,
            misses: 0u32,
            value_hash: 0u64,
        }; 36],
    };

    let rev = 1u64;
    let h_cold = eval_query(mut_view(mdb), rev, Q_TYPECK_BODY, ITEM_COMPUTE);
    let h_warm = eval_query(mut_view(mdb), rev, Q_TYPECK_BODY, ITEM_COMPUTE);
    if h_cold != h_warm {
        return 1;
    }

    // Verify square signature ran, square body did NOT run, unreferenced_heavy did NOT run
    let sq_sig = mdb.slots[slot_index(Q_ITEM_SIGNATURE, ITEM_SQUARE)];
    let sq_body = mdb.slots[slot_index(Q_TYPECK_BODY, ITEM_SQUARE)];
    let unref_sig = mdb.slots[slot_index(Q_ITEM_SIGNATURE, ITEM_UNREF)];
    let unref_body = mdb.slots[slot_index(Q_TYPECK_BODY, ITEM_UNREF)];
    let comp_body = mdb.slots[slot_index(Q_TYPECK_BODY, ITEM_COMPUTE)];

    if sq_sig.misses != 1u32 || sq_body.misses != 0u32 || unref_sig.misses != 0u32 || unref_body.misses != 0u32 {
        return 2;
    }
    if comp_body.hits != 1u32 || comp_body.misses != 1u32 {
        return 3;
    }

    // Verify legal runtime recursion on fact
    let _ = eval_query(mut_view(mdb), rev, Q_TYPECK_BODY, ITEM_FACT);
    let fact_body = mdb.slots[slot_index(Q_TYPECK_BODY, ITEM_FACT)];
    let fact_sig = mdb.slots[slot_index(Q_ITEM_SIGNATURE, ITEM_FACT)];
    if fact_body.misses != 1u32 || fact_sig.misses != 1u32 || fact_sig.hits != 1u32 {
        return 4;
    }

    print("DEMAND-DRIVEN-FIREWALL-OK\n");
    0
}
