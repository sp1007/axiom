// test: run
// modes: interp native
// stdout-file: query_graph_determinism.stdout
// SPEC-21 AXS-QRY-003, AXS-QRY-013, AXS-QRY-022:
// Allocation-order-independent canonical SemanticKey comparison and cycle rotation.

@derive(Copy)
struct SemanticKeyLite {
    pkg_rank: u32,
    mod_rank: u32,
    ns: u8,
    disambig: u32,
    name_rank: u32,
    type_args_rank: u32,
}

struct KeyList {
    items: [4]SemanticKeyLite,
}

fn sem_key_cmp(a: view<SemanticKeyLite>, b: view<SemanticKeyLite>) -> i32 {
    if (a.pkg_rank) < (b.pkg_rank) { return -1; }
    if (a.pkg_rank) > (b.pkg_rank) { return 1; }
    if (a.mod_rank) < (b.mod_rank) { return -1; }
    if (a.mod_rank) > (b.mod_rank) { return 1; }
    if (a.ns) < (b.ns) { return -1; }
    if (a.ns) > (b.ns) { return 1; }
    if (a.disambig) < (b.disambig) { return -1; }
    if (a.disambig) > (b.disambig) { return 1; }
    if (a.name_rank) < (b.name_rank) { return -1; }
    if (a.name_rank) > (b.name_rank) { return 1; }
    if (a.type_args_rank) < (b.type_args_rank) { return -1; }
    if (a.type_args_rank) > (b.type_args_rank) { return 1; }
    0
}

fn sort_keys(list: mut_view<KeyList>) {
    let mut i: usize = 1;
    while i < 4 {
        let cur = list.items[i];
        let mut j: usize = i;
        while j > 0 {
            let prev = list.items[j - 1];
            if sem_key_cmp(view(prev), view(cur)) <= 0 {
                break;
            }
            list.items[j] = prev;
            j = j - 1;
        }
        list.items[j] = cur;
        i = i + 1;
    }
}

pub fn main() -> i32 {
    let k_alpha = SemanticKeyLite { pkg_rank: 1u32, mod_rank: 1u32, ns: 5u8, disambig: 0u32, name_rank: 1u32, type_args_rank: 0u32 };
    let k_beta = SemanticKeyLite { pkg_rank: 1u32, mod_rank: 1u32, ns: 5u8, disambig: 0u32, name_rank: 2u32, type_args_rank: 0u32 };
    let k_gamma = SemanticKeyLite { pkg_rank: 1u32, mod_rank: 2u32, ns: 3u8, disambig: 0u32, name_rank: 1u32, type_args_rank: 0u32 };
    let k_delta = SemanticKeyLite { pkg_rank: 2u32, mod_rank: 1u32, ns: 2u8, disambig: 0u32, name_rank: 1u32, type_args_rank: 1u32 };

    let mut fwd = KeyList { items: [k_alpha, k_beta, k_gamma, k_delta] };
    let mut rev = KeyList { items: [k_delta, k_gamma, k_beta, k_alpha] };

    sort_keys(mut_view(fwd));
    sort_keys(mut_view(rev));

    let mut i: usize = 0;
    while i < 4 {
        if sem_key_cmp(view(fwd.items[i]), view(rev.items[i])) != 0 {
            return 1;
        }
        i = i + 1;
    }
    print("QUERY-GRAPH-DETERMINISM-OK\n");
    0
}
