// test: run
// modes: interp native
// stdout: size 24 32 8\nnested 7 9 65535\nnested-all 7 9\nptr 7\nptr 9\nptr-after-write 5 1000\niflet 7\niflet 9\niflet-none\n
// T444a (ADR-0043 §4): mixed-size payload (u8, u64) reached through a struct field, through a raw
// pointer (read and overwrite), with `if let`, and `size_of` of the enum: the tag occupies [0, 4),
// the u64 is placed at 8 and the u8 at 16, so the enum is 24 bytes (it was 16 and the u8 was lost).

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

@intrinsic fn size_of<T>() -> usize { 0 }

@derive(Copy)
enum Choice {
    Pair(u8, u64),
    Single(u32),
    Nothing,
}

@derive(Copy)
struct Holder {
    tag: u16,
    c: Choice,
    tail: u16,
}

@derive(Copy)
enum Small {
    A(u8, u16),
    B,
}

fn first(c: Choice) -> u64 {
    match c {
        Choice.Pair(a, _) => a as u64,
        Choice.Single(s) => s as u64,
        Choice.Nothing => 0u64,
    }
}

fn second(c: Choice) -> u64 {
    match c {
        Choice.Pair(_, b) => b,
        Choice.Single(s) => s as u64,
        Choice.Nothing => 0u64,
    }
}

fn main() -> i32 {
    print("size ");
    print_int(size_of<Choice>() as i64);
    print(" ");
    print_int(size_of<Holder>() as i64);
    print(" ");
    print_int(size_of<Small>() as i64);
    print("\n");

    let h = Holder { tag: 1u16, c: Choice.Pair(7u8, 9u64), tail: 65535u16 };
    print("nested ");
    print_int(first(h.c) as i64);
    print(" ");
    print_int(second(h.c) as i64);
    print(" ");
    print_int(h.tail as i64);
    print("\n");
    match h.c {
        Choice.Pair(a, b) => {
            print("nested-all ");
            print_int(a as i64);
            print(" ");
            print_int(b as i64);
            print("\n");
        },
        _ => { print("nested-all wrong\n"); },
    }

    let mut slot: Choice = Choice.Nothing;
    let p: *mut Choice = unsafe { address_of_mut(slot) };
    unsafe { *p = Choice.Pair(7u8, 9u64); }
    match unsafe { *p } {
        Choice.Pair(a, _) => { print("ptr "); print_int(a as i64); print("\n"); },
        _ => { print("ptr wrong\n"); },
    }
    match unsafe { *p } {
        Choice.Pair(_, b) => { print("ptr "); print_int(b as i64); print("\n"); },
        _ => { print("ptr wrong\n"); },
    }
    unsafe { *p = Choice.Pair(5u8, 1000u64); }
    let back = unsafe { *p };
    print("ptr-after-write ");
    print_int(first(back) as i64);
    print(" ");
    print_int(second(back) as i64);
    print("\n");

    let c = Choice.Pair(7u8, 9u64);
    if let Choice.Pair(a, _) = c {
        print("iflet ");
        print_int(a as i64);
        print("\n");
    }
    if let Choice.Pair(_, b) = c {
        print("iflet ");
        print_int(b as i64);
        print("\n");
    }
    let n = Choice.Nothing;
    if let Choice.Pair(a, _) = n {
        print_int(a as i64);
    } else {
        print("iflet-none\n");
    }
    0
}
