// test: run
// modes: interp native
// stdout: 42 7\n7 42\n11 22 9\n9 11 22\n
// T444a (ADR-0043 §4): payloads mixing a raw pointer and a struct with small integer fields, in both
// orders; the pointee and the struct fields are read back through the bound payload field.

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

@derive(Copy)
struct Pt {
    x: u16,
    y: u64,
}

@derive(Copy)
enum Mix {
    BytePtr(u8, *mut u64),
    PtrByte(*mut u64, u8),
    StructByte(Pt, u8),
    ByteStruct(u8, Pt),
}

fn show(m: Mix) {
    match m {
        Mix.BytePtr(_, p) => { print_int(unsafe { *p } as i64); },
        Mix.PtrByte(p, _) => { print_int(unsafe { *p } as i64); },
        Mix.StructByte(s, _) => { print_int(s.x as i64); print(" "); print_int(s.y as i64); },
        Mix.ByteStruct(b, _) => { print_int(b as i64); },
    }
    print(" ");
    match m {
        Mix.BytePtr(b, _) => { print_int(b as i64); },
        Mix.PtrByte(_, b) => { print_int(b as i64); },
        Mix.StructByte(_, b) => { print_int(b as i64); },
        Mix.ByteStruct(_, s) => { print_int(s.x as i64); print(" "); print_int(s.y as i64); },
    }
    print("\n");
}

fn main() -> i32 {
    let mut v: u64 = 42u64;
    let p: *mut u64 = unsafe { address_of_mut(v) };
    show(Mix.BytePtr(7u8, p));
    let mut w: u64 = 7u64;
    let q: *mut u64 = unsafe { address_of_mut(w) };
    show(Mix.PtrByte(q, 42u8));
    show(Mix.StructByte(Pt { x: 11u16, y: 22u64 }, 9u8));
    show(Mix.ByteStruct(9u8, Pt { x: 11u16, y: 22u64 }));
    0
}
