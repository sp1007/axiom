// test: run
// modes: interp native
// stdout: 7 9\n9 7\n300 70000\n70000 300\n5 600\n600 5\n8 123456\n123456 8\n4000000000 77\n77 4000000000\n
// T444a (ADR-0043 §4): two-field tuple-variant payloads in every size order. Each field is bound
// alone (one binding per arm) so the bytes read come from the layout's own offset table.

@derive(Copy)
enum P2 {
    U8U64(u8, u64),
    U64U8(u64, u8),
    U16U32(u16, u32),
    U32U16(u32, u16),
    U8U16(u8, u16),
    U16U8(u16, u8),
    U8U32(u8, u32),
    U32U8(u32, u8),
    U64U32(u64, u32),
    U32U64(u32, u64),
    Empty,
}

fn first(p: P2) -> u64 {
    match p {
        P2.U8U64(a, _) => a as u64,
        P2.U64U8(a, _) => a,
        P2.U16U32(a, _) => a as u64,
        P2.U32U16(a, _) => a as u64,
        P2.U8U16(a, _) => a as u64,
        P2.U16U8(a, _) => a as u64,
        P2.U8U32(a, _) => a as u64,
        P2.U32U8(a, _) => a as u64,
        P2.U64U32(a, _) => a,
        P2.U32U64(a, _) => a as u64,
        P2.Empty => 0u64,
    }
}

fn second(p: P2) -> u64 {
    match p {
        P2.U8U64(_, b) => b,
        P2.U64U8(_, b) => b as u64,
        P2.U16U32(_, b) => b as u64,
        P2.U32U16(_, b) => b as u64,
        P2.U8U16(_, b) => b as u64,
        P2.U16U8(_, b) => b as u64,
        P2.U8U32(_, b) => b as u64,
        P2.U32U8(_, b) => b as u64,
        P2.U64U32(_, b) => b as u64,
        P2.U32U64(_, b) => b,
        P2.Empty => 0u64,
    }
}

fn show(p: P2) {
    print_int(first(p) as i64);
    print(" ");
    print_int(second(p) as i64);
    print("\n");
}

fn main() -> i32 {
    show(P2.U8U64(7u8, 9u64));
    show(P2.U64U8(9u64, 7u8));
    show(P2.U16U32(300u16, 70000u32));
    show(P2.U32U16(70000u32, 300u16));
    show(P2.U8U16(5u8, 600u16));
    show(P2.U16U8(600u16, 5u8));
    show(P2.U8U32(8u8, 123456u32));
    show(P2.U32U8(123456u32, 8u8));
    show(P2.U64U32(4000000000u64, 77u32));
    show(P2.U32U64(77u32, 4000000000u64));
    0
}
