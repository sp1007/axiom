// test: run
// modes: interp native
// stdout: 200 60000 5000000000\n200\n60000\n5000000000\n200 5000000000 60000\n200\n5000000000\n60000\n60000 200 5000000000\n60000\n200\n5000000000\n60000 5000000000 200\n60000\n5000000000\n200\n5000000000 200 60000\n5000000000\n200\n60000\n5000000000 60000 200\n5000000000\n60000\n200\n17 3000000000 9000000000\n17\n3000000000\n9000000000\n17 9000000000 3000000000\n17\n9000000000\n3000000000\n3000000000 17 9000000000\n3000000000\n17\n9000000000\n3000000000 9000000000 17\n3000000000\n9000000000\n17\n9000000000 17 3000000000\n9000000000\n17\n3000000000\n9000000000 3000000000 17\n9000000000\n3000000000\n17\n
// T444a (ADR-0043 §4): three-field tuple-variant payloads in every order of (u8, u16, u64) and of
// (u8, u32, u64). Every field is bound alone (one binding per arm), then all three together.

@derive(Copy)
enum P3 {
    A(u8, u16, u64),
    B(u8, u64, u16),
    C(u16, u8, u64),
    D(u16, u64, u8),
    E(u64, u8, u16),
    F(u64, u16, u8),
}

fn p3_f0(p: P3) -> u64 {
    match p {
        P3.A(x, _, _) => x as u64,
        P3.B(x, _, _) => x as u64,
        P3.C(x, _, _) => x as u64,
        P3.D(x, _, _) => x as u64,
        P3.E(x, _, _) => x,
        P3.F(x, _, _) => x,
    }
}

fn p3_f1(p: P3) -> u64 {
    match p {
        P3.A(_, x, _) => x as u64,
        P3.B(_, x, _) => x,
        P3.C(_, x, _) => x as u64,
        P3.D(_, x, _) => x,
        P3.E(_, x, _) => x as u64,
        P3.F(_, x, _) => x as u64,
    }
}

fn p3_f2(p: P3) -> u64 {
    match p {
        P3.A(_, _, x) => x,
        P3.B(_, _, x) => x as u64,
        P3.C(_, _, x) => x,
        P3.D(_, _, x) => x as u64,
        P3.E(_, _, x) => x as u64,
        P3.F(_, _, x) => x as u64,
    }
}

fn p3_all(p: P3) {
    match p {
        P3.A(x, y, z) => {
            print_int(x as i64); print(" "); print_int(y as i64); print(" "); print_int(z as i64);
        },
        P3.B(x, y, z) => {
            print_int(x as i64); print(" "); print_int(y as i64); print(" "); print_int(z as i64);
        },
        P3.C(x, y, z) => {
            print_int(x as i64); print(" "); print_int(y as i64); print(" "); print_int(z as i64);
        },
        P3.D(x, y, z) => {
            print_int(x as i64); print(" "); print_int(y as i64); print(" "); print_int(z as i64);
        },
        P3.E(x, y, z) => {
            print_int(x as i64); print(" "); print_int(y as i64); print(" "); print_int(z as i64);
        },
        P3.F(x, y, z) => {
            print_int(x as i64); print(" "); print_int(y as i64); print(" "); print_int(z as i64);
        },
    }
    print("\n");
}

fn p3_each(p: P3) {
    print_int(p3_f0(p) as i64); print("\n");
    print_int(p3_f1(p) as i64); print("\n");
    print_int(p3_f2(p) as i64); print("\n");
}

@derive(Copy)
enum Q3 {
    A(u8, u32, u64),
    B(u8, u64, u32),
    C(u32, u8, u64),
    D(u32, u64, u8),
    E(u64, u8, u32),
    F(u64, u32, u8),
}

fn q3_f0(p: Q3) -> u64 {
    match p {
        Q3.A(x, _, _) => x as u64,
        Q3.B(x, _, _) => x as u64,
        Q3.C(x, _, _) => x as u64,
        Q3.D(x, _, _) => x as u64,
        Q3.E(x, _, _) => x,
        Q3.F(x, _, _) => x,
    }
}

fn q3_f1(p: Q3) -> u64 {
    match p {
        Q3.A(_, x, _) => x as u64,
        Q3.B(_, x, _) => x,
        Q3.C(_, x, _) => x as u64,
        Q3.D(_, x, _) => x,
        Q3.E(_, x, _) => x as u64,
        Q3.F(_, x, _) => x as u64,
    }
}

fn q3_f2(p: Q3) -> u64 {
    match p {
        Q3.A(_, _, x) => x,
        Q3.B(_, _, x) => x as u64,
        Q3.C(_, _, x) => x,
        Q3.D(_, _, x) => x as u64,
        Q3.E(_, _, x) => x as u64,
        Q3.F(_, _, x) => x as u64,
    }
}

fn q3_all(p: Q3) {
    match p {
        Q3.A(x, y, z) => {
            print_int(x as i64); print(" "); print_int(y as i64); print(" "); print_int(z as i64);
        },
        Q3.B(x, y, z) => {
            print_int(x as i64); print(" "); print_int(y as i64); print(" "); print_int(z as i64);
        },
        Q3.C(x, y, z) => {
            print_int(x as i64); print(" "); print_int(y as i64); print(" "); print_int(z as i64);
        },
        Q3.D(x, y, z) => {
            print_int(x as i64); print(" "); print_int(y as i64); print(" "); print_int(z as i64);
        },
        Q3.E(x, y, z) => {
            print_int(x as i64); print(" "); print_int(y as i64); print(" "); print_int(z as i64);
        },
        Q3.F(x, y, z) => {
            print_int(x as i64); print(" "); print_int(y as i64); print(" "); print_int(z as i64);
        },
    }
    print("\n");
}

fn q3_each(p: Q3) {
    print_int(q3_f0(p) as i64); print("\n");
    print_int(q3_f1(p) as i64); print("\n");
    print_int(q3_f2(p) as i64); print("\n");
}

fn main() -> i32 {
    let vp3a = P3.A(200u8, 60000u16, 5000000000u64);
    p3_all(vp3a);
    p3_each(vp3a);
    let vp3b = P3.B(200u8, 5000000000u64, 60000u16);
    p3_all(vp3b);
    p3_each(vp3b);
    let vp3c = P3.C(60000u16, 200u8, 5000000000u64);
    p3_all(vp3c);
    p3_each(vp3c);
    let vp3d = P3.D(60000u16, 5000000000u64, 200u8);
    p3_all(vp3d);
    p3_each(vp3d);
    let vp3e = P3.E(5000000000u64, 200u8, 60000u16);
    p3_all(vp3e);
    p3_each(vp3e);
    let vp3f = P3.F(5000000000u64, 60000u16, 200u8);
    p3_all(vp3f);
    p3_each(vp3f);
    let vq3a = Q3.A(17u8, 3000000000u32, 9000000000u64);
    q3_all(vq3a);
    q3_each(vq3a);
    let vq3b = Q3.B(17u8, 9000000000u64, 3000000000u32);
    q3_all(vq3b);
    q3_each(vq3b);
    let vq3c = Q3.C(3000000000u32, 17u8, 9000000000u64);
    q3_all(vq3c);
    q3_each(vq3c);
    let vq3d = Q3.D(3000000000u32, 9000000000u64, 17u8);
    q3_all(vq3d);
    q3_each(vq3d);
    let vq3e = Q3.E(9000000000u64, 17u8, 3000000000u32);
    q3_all(vq3e);
    q3_each(vq3e);
    let vq3f = Q3.F(9000000000u64, 3000000000u32, 17u8);
    q3_all(vq3f);
    q3_each(vq3f);
    0
}
