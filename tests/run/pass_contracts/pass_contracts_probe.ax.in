fn probe_registry_and_certainty_lattice() -> bool {
    if ir_level_to_u8(IrLevel.Hir) != IR_LEVEL_HIR ||
       ir_level_to_u8(IrLevel.Mir) != IR_LEVEL_MIR ||
       ir_level_to_u8(IrLevel.OptIr) != IR_LEVEL_OPT_IR ||
       ir_level_to_u8(IrLevel.MachIr) != IR_LEVEL_MACH_IR {
        return false;
    }

    if pct_analysis_kind_bit(AnalysisKind.Cfg) != PCT_MASK_CFG ||
       pct_analysis_kind_bit(AnalysisKind.EffectSummary) != PCT_MASK_EFFECT_SUMMARY {
        return false;
    }

    // Topological dependency expansion: EffectSummary requires CFG, DomTree, SsaDefUse, MemorySsa, AliasSummary
    let req_eff = pct_analysis_expand_required(PCT_MASK_EFFECT_SUMMARY);
    let expected_deps = PCT_MASK_CFG | PCT_MASK_DOM_TREE | PCT_MASK_SSA_DEF_USE | PCT_MASK_MEMORY_SSA | PCT_MASK_ALIAS_SUMMARY | PCT_MASK_EFFECT_SUMMARY;
    if (req_eff & expected_deps) != expected_deps {
        return false;
    }

    // Invalidating CFG transitively invalidates DomTree, SsaDefUse, MemorySsa, AliasSummary, EffectSummary, ValueRange
    let inv_cfg = pct_analysis_expand_invalidated(PCT_MASK_CFG);
    if (inv_cfg & expected_deps) != expected_deps || (inv_cfg & PCT_MASK_VALUE_RANGE) == 0u32 {
        return false;
    }

    // Validate all canonical pass contracts (0..PCT_CANONICAL_PASS_COUNT)
    let mut pid: u16 = 0u16;
    while (pid as usize) < PCT_CANONICAL_PASS_COUNT {
        let c = pct_canonical_contract(pid);
        if !pct_validate_contract_declaration(view(c)) {
            return false;
        }
        pid = pid + 1u16;
    }

    // Reject malformed contracts:
    // (a) Conflicting preserved_analyses & invalidated_analyses
    let mut bad1 = pct_canonical_contract(PCT_PASS_OPT_BCE);
    bad1.invalidated_analyses = bad1.invalidated_analyses | PCT_MASK_CFG;
    if pct_validate_contract_declaration(view(bad1)) {
        return false;
    }
    // (b) Missing mandatory intra-level preserved_properties
    let mut bad2 = pct_canonical_contract(PCT_PASS_OPT_BCE);
    bad2.preserved_properties = SEM_PROP_CFG_WELL_FORMED;
    if pct_validate_contract_declaration(view(bad2)) {
        return false;
    }

    // Three-valued Certainty lattice (AXS-PCT-010)
    if certainty_to_u8(certainty_from_u8(CERTAINTY_PROVEN)) != CERTAINTY_PROVEN ||
       certainty_to_u8(certainty_from_u8(CERTAINTY_POSSIBLE)) != CERTAINTY_POSSIBLE ||
       certainty_to_u8(certainty_from_u8(CERTAINTY_UNKNOWN)) != CERTAINTY_UNKNOWN {
        return false;
    }
    if certainty_and(CERTAINTY_PROVEN, CERTAINTY_PROVEN) != CERTAINTY_PROVEN ||
       certainty_and(CERTAINTY_PROVEN, CERTAINTY_POSSIBLE) != CERTAINTY_POSSIBLE ||
       certainty_and(CERTAINTY_POSSIBLE, CERTAINTY_UNKNOWN) != CERTAINTY_UNKNOWN {
        return false;
    }
    if certainty_join_paths(CERTAINTY_PROVEN, CERTAINTY_UNKNOWN) != CERTAINTY_POSSIBLE ||
       certainty_join_paths(CERTAINTY_PROVEN, CERTAINTY_PROVEN) != CERTAINTY_PROVEN ||
       certainty_join_paths(CERTAINTY_UNKNOWN, CERTAINTY_UNKNOWN) != CERTAINTY_UNKNOWN {
        return false;
    }

    // Boundary & hazard degradation (budget exhaustion, FFI, volatile, FP NaN/-0.0)
    if certainty_degrade_on_boundary(CERTAINTY_PROVEN, true, false, false, false) != CERTAINTY_UNKNOWN ||
       certainty_degrade_on_boundary(CERTAINTY_PROVEN, false, true, false, false) != CERTAINTY_UNKNOWN ||
       certainty_degrade_on_boundary(CERTAINTY_PROVEN, false, false, true, false) != CERTAINTY_UNKNOWN ||
       certainty_degrade_on_boundary(CERTAINTY_PROVEN, false, false, false, true) != CERTAINTY_POSSIBLE ||
       certainty_degrade_on_boundary(CERTAINTY_PROVEN, false, false, false, false) != CERTAINTY_PROVEN {
        return false;
    }

    // Semantic firewall (AXS-PCT-004): profitability NEVER overrides Possible or Unknown
    let high_profit = ProfitabilityFact {
        estimated_benefit: 10000i32,
        threshold: 5i32,
        hotness_weight: 1000u32,
    };
    let low_profit = ProfitabilityFact {
        estimated_benefit: 1i32,
        threshold: 50i32,
        hotness_weight: 1u32,
    };
    if !pct_semantic_firewall_gate(CERTAINTY_PROVEN, view(high_profit)) ||
       pct_semantic_firewall_gate(CERTAINTY_PROVEN, view(low_profit)) ||
       pct_semantic_firewall_gate(CERTAINTY_POSSIBLE, view(high_profit)) ||
       pct_semantic_firewall_gate(CERTAINTY_UNKNOWN, view(high_profit)) {
        return false;
    }

    true
}

fn probe_proof_store_caching_and_invalidation(arena: mut_view<Arena>) -> bool {
    let mut store = ProofStore {
        certs: 0 as *mut ProofCertificate,
        cert_count: 0,
        cert_cap: 0,
        audits: 0 as *mut AuditTrailEntry,
        audit_count: 0,
        audit_cap: 0,
        current_ir_revision: 0u32,
        current_snapshot_revision: 0u32,
        allow_trusted_boundaries: true,
        cache_hits: 0u32,
        cache_misses: 0u32,
        invalidation_events: 0u32,
    };
    proof_store_init(mut_view(store), mut_view(*arena), 1u32, true);
    let fn_sym = SymbolId { v: 10u32 };

    // 1. Issue root proof c0: NoAlias(10, 20)
    let c0 = proof_store_issue(
        mut_view(store),
        PROP_NO_ALIAS,
        CERTAINTY_PROVEN,
        10u32,
        20u32,
        1u32,
        FACT_ORIGIN_DATAFLOW_ENGINE,
        PCT_ANALYSIS_CFG,
        0u64,
        0u32,
        SymbolId { v: 10u32 }
    );
    if c0 != 0u32 || !proof_store_is_cert_usable(view(store), c0) || store.cache_misses != 1u32 {
        return false;
    }

    // 2. Commuted symmetric query NoAlias(20, 10) at same revision MUST hit canonical Fingerprint128 cache!
    let c0_commuted = proof_store_issue(
        mut_view(store),
        PROP_NO_ALIAS,
        CERTAINTY_PROVEN,
        20u32,
        10u32,
        1u32,
        FACT_ORIGIN_DATAFLOW_ENGINE,
        PCT_ANALYSIS_CFG,
        0u64,
        0u32,
        SymbolId { v: 10u32 }
    );
    if c0_commuted != c0 || store.cache_hits != 1u32 || store.cert_count != 1 {
        return false;
    }

    // 3. Build parent -> child -> grandchild dependency DAG: c0 -> c1 -> c2
    let c1 = proof_store_issue(
        mut_view(store),
        PROP_LOOP_INVARIANT,
        CERTAINTY_PROVEN,
        30u32,
        0u32,
        2u32,
        FACT_ORIGIN_DATAFLOW_ENGINE,
        PCT_ANALYSIS_DOM_TREE,
        1u64 << (c0 as u64),
        0u32,
        SymbolId { v: 10u32 }
    );
    let c2 = proof_store_issue(
        mut_view(store),
        PROP_DEAD_STORE,
        CERTAINTY_PROVEN,
        40u32,
        0u32,
        3u32,
        FACT_ORIGIN_SYMBOLIC_ENGINE,
        PCT_ANALYSIS_VALUE_RANGE,
        1u64 << (c1 as u64),
        0u32,
        SymbolId { v: 10u32 }
    );
    if !proof_store_is_cert_usable(view(store), c1) || !proof_store_is_cert_usable(view(store), c2) {
        return false;
    }

    // 4. Invalidate root c0 -> c1 and c2 MUST be transitively invalidated automatically (AXS-PCT-011)
    proof_store_invalidate_cert(mut_view(store), c0);
    if proof_store_is_cert_usable(view(store), c0) ||
       proof_store_is_cert_usable(view(store), c1) ||
       proof_store_is_cert_usable(view(store), c2) {
        return false;
    }
    if proof_store_get_cert_certainty(view(store), c2) != CERTAINTY_UNKNOWN {
        return false;
    }

    // 5. Issue analysis-dependent proof c3 (DomTree) and child c4 (ValueRange), then invalidate CFG
    let c3 = proof_store_issue(
        mut_view(store),
        PROP_IN_BOUNDS,
        CERTAINTY_PROVEN,
        50u32,
        60u32,
        4u32,
        FACT_ORIGIN_SYMBOLIC_ENGINE,
        PCT_ANALYSIS_DOM_TREE,
        0u64,
        0u32,
        SymbolId { v: 10u32 }
    );
    let c4 = proof_store_issue(
        mut_view(store),
        PROP_IN_BOUNDS,
        CERTAINTY_PROVEN,
        51u32,
        60u32,
        5u32,
        FACT_ORIGIN_SYMBOLIC_ENGINE,
        PCT_ANALYSIS_VALUE_RANGE,
        1u64 << (c3 as u64),
        0u32,
        SymbolId { v: 10u32 }
    );
    if !proof_store_is_cert_usable(view(store), c3) || !proof_store_is_cert_usable(view(store), c4) {
        return false;
    }
    proof_store_invalidate_by_analyses(mut_view(store), PCT_MASK_CFG);
    if proof_store_is_cert_usable(view(store), c3) || proof_store_is_cert_usable(view(store), c4) {
        return false;
    }

    // 6. TrustedBoundary audit & policy enforcement (AXS-PCT-015):
    // Unaudited (trusted_attr_id == 0) MUST fail closed to CERTAINTY_UNKNOWN
    let c_untrusted = proof_store_issue(
        mut_view(store),
        PROP_NO_ALIAS,
        CERTAINTY_PROVEN,
        70u32,
        71u32,
        6u32,
        FACT_ORIGIN_TRUSTED_BOUNDARY,
        PCT_ANALYSIS_CFG,
        0u64,
        0u32,
        SymbolId { v: 10u32 }
    );
    if proof_store_is_cert_usable(view(store), c_untrusted) || store.audit_count != 0 {
        return false;
    }
    // Audited (trusted_attr_id == 99) with allow_trusted_boundaries == true succeeds and logs AuditTrailEntry
    let c_trusted = proof_store_issue(
        mut_view(store),
        PROP_NO_ALIAS,
        CERTAINTY_PROVEN,
        72u32,
        73u32,
        7u32,
        FACT_ORIGIN_TRUSTED_BOUNDARY,
        PCT_ANALYSIS_CFG,
        0u64,
        99u32,
        SymbolId { v: 10u32 }
    );
    if !proof_store_is_cert_usable(view(store), c_trusted) || store.audit_count != 1 {
        return false;
    }
    // Disabling allow_trusted_boundaries rejects new TrustedBoundary proofs
    store.allow_trusted_boundaries = false;
    let c_disallowed = proof_store_issue(
        mut_view(store),
        PROP_NO_ALIAS,
        CERTAINTY_PROVEN,
        74u32,
        75u32,
        8u32,
        FACT_ORIGIN_TRUSTED_BOUNDARY,
        PCT_ANALYSIS_CFG,
        0u64,
        99u32,
        SymbolId { v: 10u32 }
    );
    if proof_store_is_cert_usable(view(store), c_disallowed) || store.audit_count != 1 {
        return false;
    }

    // 7. IR mutation advances ir_revision and invalidates proofs from prior revision
    proof_store_notify_ir_mutation(mut_view(store), 72u32, PCT_MASK_SSA_DEF_USE);
    if proof_store_is_cert_usable(view(store), c_trusted) {
        return false;
    }

    true
}

fn probe_dataflow_effects_and_symbolic_domains() -> bool {
    // 1. Shared monotone dataflow fixed-point engine (AXS-PCT-012)
    let gen_masks: [3]u64 = [1u64, 2u64, 4u64];
    let kill_masks: [3]u64 = [0u64, 0u64, 0u64];
    let p_gen = unsafe { address_of(gen_masks[0]) };
    let p_kill = unsafe { address_of(kill_masks[0]) };

    let fp_fwd = pct_solve_monotone_fixpoint(PCT_DATAFLOW_FORWARD, p_gen, p_kill, 3, 0u64, 8u32);
    if !fp_fwd.converged || fp_fwd.certainty != CERTAINTY_PROVEN || fp_fwd.final_state != 7u64 {
        return false;
    }
    let fp_bwd = pct_solve_monotone_fixpoint(PCT_DATAFLOW_BACKWARD, p_gen, p_kill, 3, 0u64, 8u32);
    if !fp_bwd.converged || fp_bwd.certainty != CERTAINTY_PROVEN || fp_bwd.final_state != 7u64 {
        return false;
    }
    // Budget exhaustion before convergence (max_iterations = 1) MUST fail closed to CERTAINTY_UNKNOWN
    let fp_exhausted = pct_solve_monotone_fixpoint(PCT_DATAFLOW_FORWARD, p_gen, p_kill, 3, 0u64, 1u32);
    if fp_exhausted.converged || fp_exhausted.certainty != CERTAINTY_UNKNOWN {
        return false;
    }

    // 2. Multi-category EffectSummary lattices (AXS-PCT-013)
    let eff_pure = pct_effect_summary_pure();
    let eff_unk = pct_effect_summary_unknown();
    if !pct_effect_can_dce_or_hoist(view(eff_pure)) || !pct_effect_can_memoize_comptime(view(eff_pure)) {
        return false;
    }
    if pct_effect_can_dce_or_hoist(view(eff_unk)) || pct_effect_can_memoize_comptime(view(eff_unk)) {
        return false;
    }
    // Unknown joined with Pure MUST remain Unknown (never downgrades to Pure)
    let eff_joined = pct_effect_summary_join(view(eff_pure), view(eff_unk));
    if eff_joined.memory != MEM_EFF_UNKNOWN || pct_effect_can_dce_or_hoist(view(eff_joined)) {
        return false;
    }
    // Implicit Drop at scope exit elevates resource effect to ReleasesOrDrops and prevents DCE
    let eff_with_drop = pct_effect_summary_with_implicit_drop(view(eff_pure), view(eff_pure));
    if eff_with_drop.resource != RES_EFF_RELEASES_OR_DROPS || pct_effect_can_dce_or_hoist(view(eff_with_drop)) {
        return false;
    }
    // Debug/profiling trace does NOT alter DCE eligibility (prevents Heisenbugs)
    let mut eff_trace = pct_effect_summary_pure();
    eff_trace.has_debug_profile_trace = true;
    if !pct_effect_can_dce_or_hoist(view(eff_trace)) {
        return false;
    }
    // Reading entropy/clock forbids DCE and comptime memoization
    let mut eff_entropy = pct_effect_summary_pure();
    eff_entropy.reads_entropy_or_clock = true;
    if pct_effect_can_dce_or_hoist(view(eff_entropy)) || pct_effect_can_memoize_comptime(view(eff_entropy)) {
        return false;
    }
    // Higher-order callback effect bound check
    let mut cb_read = pct_effect_summary_pure();
    cb_read.memory = MEM_EFF_READS_ONLY;
    let mut bound_local = pct_effect_summary_pure();
    bound_local.memory = MEM_EFF_WRITES_LOCAL_ONLY;
    let mut cb_ffi = pct_effect_summary_pure();
    cb_ffi.memory = MEM_EFF_WRITES_GLOBAL_OR_HEAP;
    cb_ffi.external = EXT_EFF_FFI_BOUNDARY;
    if !pct_effect_callback_within_bound(view(cb_read), view(bound_local)) ||
       pct_effect_callback_within_bound(view(cb_ffi), view(bound_local)) {
        return false;
    }
    // Mutual recursion SCC propagation
    let eff_scc = pct_effect_propagate_scc(view(eff_pure), view(cb_read), true);
    if eff_scc.control != CTRL_EFF_MAY_DIVERGE || eff_scc.memory != MEM_EFF_READS_ONLY {
        return false;
    }

    // 3. Bounded in-process SymbolicValueDomain (AXS-PCT-014)
    let dom_pos = sym_domain_range(64u8, false, 1u64, 100u64);
    let dom_maybe_zero = sym_domain_range(64u8, false, 0u64, 100u64);
    let mut dom_congruence = sym_domain_top(64u8, false);
    dom_congruence.stride = 4u64;
    dom_congruence.offset = 2u64;

    if sym_prove_non_zero(view(dom_pos), 16u32) != CERTAINTY_PROVEN ||
       sym_prove_non_zero(view(dom_congruence), 16u32) != CERTAINTY_PROVEN ||
       sym_prove_non_zero(view(dom_maybe_zero), 16u32) != CERTAINTY_POSSIBLE ||
       sym_prove_non_zero(view(dom_pos), 0u32) != CERTAINTY_UNKNOWN {
        return false;
    }

    // ShiftInRange via range and bitmask
    let dom_sh_ok = sym_domain_range(64u8, false, 0u64, 63u64);
    let dom_sh_bad = sym_domain_const(64u8, false, 64u64);
    let mut dom_sh_mask = sym_domain_top(64u8, false);
    dom_sh_mask.known_zeros = 0xFFFFFFFF_FFFFFFC0u64;
    if sym_prove_shift_in_range(view(dom_sh_ok), 64u8, 16u32) != CERTAINTY_PROVEN ||
       sym_prove_shift_in_range(view(dom_sh_mask), 64u8, 16u32) != CERTAINTY_PROVEN ||
       sym_prove_shift_in_range(view(dom_sh_bad), 64u8, 16u32) != CERTAINTY_UNKNOWN {
        return false;
    }

    // InBounds & UTF-8 byte vs Unicode scalar mismatch protection
    let mut idx_byte = sym_domain_range(64u8, false, 0u64, 7u64);
    idx_byte.is_utf8_byte_len = true;
    let mut len_byte = sym_domain_range(64u8, false, 8u64, 16u64);
    len_byte.is_utf8_byte_len = true;
    let mut len_scalar = sym_domain_range(64u8, false, 8u64, 16u64);
    len_scalar.is_utf8_byte_len = false;
    if sym_prove_in_bounds(view(idx_byte), view(len_byte), true, 16u32) != CERTAINTY_PROVEN ||
       sym_prove_in_bounds(view(idx_byte), view(len_scalar), true, 16u32) != CERTAINTY_UNKNOWN {
        return false;
    }

    // NoUnsignedOverflow (including exact u64::MAX boundary cases: Proven, Possible, Unknown)
    let add_a = sym_domain_range(64u8, false, 10u64, 1000u64);
    let add_b = sym_domain_range(64u8, false, 20u64, 2000u64);
    if sym_prove_no_unsigned_add_overflow(view(add_a), view(add_b), 64u8, 16u32) != CERTAINTY_PROVEN {
        return false;
    }
    let max_lhs = sym_domain_range(64u8, false, 10u64, 0xFFFFFFFF_FFFFFFF5u64);
    let max_rhs_ok = sym_domain_range(64u8, false, 0u64, 10u64);
    let max_rhs_poss = sym_domain_range(64u8, false, 0u64, 11u64);
    let max_lhs_ovf = sym_domain_range(64u8, false, 0xFFFFFFFF_FFFFFFF6u64, 0xFFFFFFFF_FFFFFFFFu64);
    let max_rhs_ovf = sym_domain_range(64u8, false, 10u64, 20u64);
    if sym_prove_no_unsigned_add_overflow(view(max_lhs), view(max_rhs_ok), 64u8, 16u32) != CERTAINTY_PROVEN ||
       sym_prove_no_unsigned_add_overflow(view(max_lhs), view(max_rhs_poss), 64u8, 16u32) != CERTAINTY_POSSIBLE ||
       sym_prove_no_unsigned_add_overflow(view(max_lhs_ovf), view(max_rhs_ovf), 64u8, 16u32) != CERTAINTY_UNKNOWN ||
       sym_prove_no_unsigned_add_overflow(view(max_lhs), view(max_rhs_ok), 0u8, 16u32) != CERTAINTY_UNKNOWN ||
       sym_prove_no_unsigned_add_overflow(view(max_lhs), view(max_rhs_ok), 64u8, 0u32) != CERTAINTY_UNKNOWN {
        return false;
    }

    // Schema version mismatch on PctEffectSummary fails closed (REQ-CORE-3222, REQ-CORE-3225)
    let mut bad_schema = pct_effect_summary_pure();
    bad_schema.schema_version = 99u32;
    let joined_bad_schema = pct_effect_summary_join(view(eff_pure), view(bad_schema));
    if joined_bad_schema.memory != MEM_EFF_UNKNOWN ||
       pct_effect_can_dce_or_hoist(view(bad_schema)) ||
       pct_effect_can_memoize_comptime(view(bad_schema)) ||
       pct_effect_callback_within_bound(view(bad_schema), view(eff_pure)) {
        return false;
    }

    // Path refinement & contradiction detection
    let refined = sym_domain_refine_range(view(dom_maybe_zero), 5u64, 20u64);
    if refined.is_contradiction || refined.range_lo != 5u64 || refined.nullability != NULLABILITY_NON_NULL {
        return false;
    }
    let contrad = sym_domain_refine_range(view(refined), 30u64, 40u64);
    if !contrad.is_contradiction {
        return false;
    }

    true
}

fn probe_transactional_engine_and_verify_traps(arena: mut_view<Arena>) -> bool {
    let sp = Span { file: FileId { v: 1u32 }, start: 0u32, end: 10u32 };
    let body_p = mir_body_new(mut_view(*arena));
    let mut body = unsafe { *body_p };

    // _0: mutable return local
    let _l0 = mir_add_local(mut_view(body), mut_view(*arena), TypeId { v: 4u32 }, MIR_LOCAL_RETURN, true, StrId { v: 0u32 }, view(sp));
    // _1: immutable shared view parameter (mut_flag = false)
    let _l1 = mir_add_local(mut_view(body), mut_view(*arena), TypeId { v: 4u32 }, MIR_LOCAL_ARG, false, StrId { v: 0u32 }, view(sp));
    // _2: mutable user local
    let _l2 = mir_add_local(mut_view(body), mut_view(*arena), TypeId { v: 4u32 }, MIR_LOCAL_USER, true, StrId { v: 0u32 }, view(sp));

    let b0 = mir_add_bb(mut_view(body), mut_view(*arena), false);
    let b1 = mir_add_bb(mut_view(body), mut_view(*arena), false);

    // Populate bb0: stmt 0 is `_0 = const 42`, stmt 1 is `drop(_2)`, term is `goto -> bb1`
    let bb0_p = unsafe { mir_bb_at(body.bbs, b0.v as usize) };
    let st_scratch = arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt;
    unsafe {
        mir_stmt_zero(mut_view(*st_scratch), MIR_STMT_ASSIGN);
        mir_place_reset_u32(mut_view((*st_scratch).place), 0u32);
        (*st_scratch).rvalue.kind = MIR_RVALUE_USE;
        (*st_scratch).rvalue.use_op.kind = MIR_OP_CONST;
        (*st_scratch).rvalue.use_op.constant.kind = MIR_CONST_INT;
        (*st_scratch).rvalue.use_op.constant.val = 42u64;
        mir_bb_push_stmt(mut_view(*bb0_p), mut_view(*arena), view(*st_scratch));

        mir_stmt_zero(mut_view(*st_scratch), MIR_STMT_DROP);
        mir_place_reset_u32(mut_view((*st_scratch).place), 2u32);
        mir_bb_push_stmt(mut_view(*bb0_p), mut_view(*arena), view(*st_scratch));

        mir_term_zero(mut_view((*bb0_p).terminator), MIR_TERM_GOTO);
        (*bb0_p).terminator.goto_target.v = b1.v;
        (*bb0_p).has_terminator = true;
    }

    let bb1_p = unsafe { mir_bb_at(body.bbs, b1.v as usize) };
    unsafe {
        mir_term_zero(mut_view((*bb1_p).terminator), MIR_TERM_RETURN);
        (*bb1_p).has_terminator = true;
    }

    let mut eng = PassContractEngine {
        current_level: IR_LEVEL_OPT_IR,
        ir_revision: 1u32,
        valid_analyses: 0u32,
        analysis_digests: 0 as *mut u64,
        active_properties: SEM_PROP_MANDATORY_INTRA_LEVEL,
        verify_pass_contracts: true,
        verify_each: true,
        observable_effect_count: 0u32,
        baseline_observable_effects: 0u32,
        pass_run_count: 0u32,
        pass_commit_count: 0u32,
        pass_rollback_count: 0u32,
        verify_trap_count: 0u32,
        last_trap_kind: 0u8,
        last_trap_pass_id: 0u16,
    };
    pct_engine_init(mut_view(eng), mut_view(*arena), IR_LEVEL_OPT_IR, true);
    eng.observable_effect_count = pct_count_mir_observable_effects(view(body));
    eng.baseline_observable_effects = eng.observable_effect_count;

    let mut store = ProofStore {
        certs: 0 as *mut ProofCertificate,
        cert_count: 0,
        cert_cap: 0,
        audits: 0 as *mut AuditTrailEntry,
        audit_count: 0,
        audit_cap: 0,
        current_ir_revision: 1u32,
        current_snapshot_revision: 1u32,
        allow_trusted_boundaries: false,
        cache_hits: 0u32,
        cache_misses: 0u32,
        invalidation_events: 0u32,
    };
    proof_store_init(mut_view(store), mut_view(*arena), 1u32, false);

    let mut sink = diag_sink_new();

    // --- Case A: Valid Proven pass commits and advances ir_revision ---
    let bce_contract = pct_canonical_contract(PCT_PASS_OPT_BCE);
    pct_engine_ensure_analyses(mut_view(eng), view(body), bce_contract.required_analyses);
    let cert_bce = proof_store_issue(
        mut_view(store),
        PROP_IN_BOUNDS,
        CERTAINTY_PROVEN,
        1u32,
        2u32,
        0u32,
        FACT_ORIGIN_SYMBOLIC_ENGINE,
        PCT_ANALYSIS_SSA_DEF_USE,
        0u64,
        0u32,
        SymbolId { v: 1u32 }
    );
    let ckpt_a = pct_engine_checkpoint_mir(view(eng), view(body), mut_view(*arena));
    let res_a = pct_engine_finish_pass(
        mut_view(eng),
        view(bce_contract),
        mut_view(body),
        mut_view(store),
        view(ckpt_a),
        true,
        cert_bce,
        CERTAINTY_PROVEN,
        mut_view(sink)
    );
    if res_a != PCT_EXEC_COMMITTED || eng.ir_revision != 2u32 || eng.pass_commit_count != 1u32 || sink.errors != 0 {
        diag_sink_free(mut_view(sink));
        return false;
    }
    // `cert_bce` was backed by SsaDefUse, which BCE invalidates -> must now be unusable!
    if proof_store_is_cert_usable(view(store), cert_bce) {
        diag_sink_free(mut_view(sink));
        return false;
    }

    // --- Case B: Unknown / Possible proof obligation triggers clean transactional rollback (0 errors!) ---
    let licm_contract = pct_canonical_contract(PCT_PASS_OPT_LICM);
    pct_engine_ensure_analyses(mut_view(eng), view(body), licm_contract.required_analyses);
    let ckpt_b = pct_engine_checkpoint_mir(view(eng), view(body), mut_view(*arena));
    // Speculatively mutate statement 0 constant from 42 to 999
    unsafe {
        let s0_p = mir_stmt_at((*mir_bb_at(body.bbs, 0)).stmts, 0);
        (*s0_p).rvalue.use_op.constant.val = 999u64;
    }
    let res_b = pct_engine_finish_pass(
        mut_view(eng),
        view(licm_contract),
        mut_view(body),
        mut_view(store),
        view(ckpt_b),
        true,
        PCT_PROOF_ID_INVALID,
        CERTAINTY_UNKNOWN,
        mut_view(sink)
    );
    let restored_val = unsafe { (*mir_stmt_at((*mir_bb_at(body.bbs, 0)).stmts, 0)).rvalue.use_op.constant.val };
    if res_b != PCT_EXEC_ROLLED_BACK_OBLIGATION || restored_val != 42u64 || eng.ir_revision != 2u32 || sink.errors != 0 {
        diag_sink_free(mut_view(sink));
        return false;
    }

    // --- Case C: Consuming stale/invalidated ProofCertificate traps under --verify-pass-contracts ---
    let ckpt_c = pct_engine_checkpoint_mir(view(eng), view(body), mut_view(*arena));
    let res_c = pct_engine_finish_pass(
        mut_view(eng),
        view(bce_contract),
        mut_view(body),
        mut_view(store),
        view(ckpt_c),
        false,
        cert_bce,
        CERTAINTY_PROVEN,
        mut_view(sink)
    );
    if res_c != PCT_EXEC_ABORTED_VERIFY_TRAP ||
       eng.last_trap_kind != PCT_TRAP_STALE_PROOF_CONSUMED ||
       sink.errors != 1 {
        diag_sink_free(mut_view(sink));
        return false;
    }
    let d0 = diag_sink_get(view(sink), 0);
    if d0.code.v != AX_ICE_INTERNAL || d0.data_count != 3 {
        diag_sink_free(mut_view(sink));
        return false;
    }

    // --- Case D: Silently mutating a preserved analysis (CFG) traps under --verify-pass-contracts ---
    pct_engine_ensure_analyses(mut_view(eng), view(body), bce_contract.required_analyses);
    let ckpt_d = pct_engine_checkpoint_mir(view(eng), view(body), mut_view(*arena));
    // Mutate CFG target in bb0 from b1 to b0 while claiming BCE (which declares CFG preserved)
    unsafe {
        (*mir_bb_at(body.bbs, 0)).terminator.goto_target = MirBbId { v: 0u32 };
    }
    let res_d = pct_engine_finish_pass(
        mut_view(eng),
        view(bce_contract),
        mut_view(body),
        mut_view(store),
        view(ckpt_d),
        true,
        PCT_PROOF_ID_INVALID,
        CERTAINTY_PROVEN,
        mut_view(sink)
    );
    let restored_target = unsafe { (*mir_bb_at(body.bbs, 0)).terminator.goto_target.v };
    if res_d != PCT_EXEC_ABORTED_VERIFY_TRAP ||
       eng.last_trap_kind != PCT_TRAP_UNPRESERVED_ANALYSIS ||
       restored_target != 1u32 ||
       sink.errors != 2 {
        diag_sink_free(mut_view(sink));
        return false;
    }

    // --- Case E: Capability promotion (shared view _1 promoted to MIR_VIEW_MUT) traps with AX_ICE_MIR_VERIFY ---
    let mut custom_contract = pct_canonical_contract(PCT_PASS_OPT_BCE);
    custom_contract.required_propositions = 0u32;
    custom_contract.preserved_analyses = 0u32;
    let ckpt_e = pct_engine_checkpoint_mir(view(eng), view(body), mut_view(*arena));
    unsafe {
        let s0_p = mir_stmt_at((*mir_bb_at(body.bbs, 0)).stmts, 0);
        (*s0_p).place.local = MirLocalId { v: 1u32 };
        (*s0_p).place.view_kind = MIR_VIEW_MUT;
    }
    let res_e = pct_engine_finish_pass(
        mut_view(eng),
        view(custom_contract),
        mut_view(body),
        mut_view(store),
        view(ckpt_e),
        true,
        PCT_PROOF_ID_INVALID,
        CERTAINTY_PROVEN,
        mut_view(sink)
    );
    if res_e != PCT_EXEC_ABORTED_VERIFY_TRAP ||
       eng.last_trap_kind != PCT_TRAP_CAPABILITY_PROMOTION ||
       sink.errors != 3 {
        diag_sink_free(mut_view(sink));
        return false;
    }
    let d2 = diag_sink_get(view(sink), 2);
    if d2.code.v != AX_ICE_MIR_VERIFY {
        diag_sink_free(mut_view(sink));
        return false;
    }

    // --- Case F: Dropping observable Drop effect traps with PCT_TRAP_OBSERVABLE_EFFECT_LOSS ---
    let ckpt_f = pct_engine_checkpoint_mir(view(eng), view(body), mut_view(*arena));
    unsafe {
        (*mir_bb_at(body.bbs, 0)).stmt_count = 1;
    }
    let res_f = pct_engine_finish_pass(
        mut_view(eng),
        view(custom_contract),
        mut_view(body),
        mut_view(store),
        view(ckpt_f),
        true,
        PCT_PROOF_ID_INVALID,
        CERTAINTY_PROVEN,
        mut_view(sink)
    );
    let restored_sc = unsafe { (*mir_bb_at(body.bbs, 0)).stmt_count };
    if res_f != PCT_EXEC_ABORTED_VERIFY_TRAP ||
       eng.last_trap_kind != PCT_TRAP_OBSERVABLE_EFFECT_LOSS ||
       restored_sc != 2 ||
       sink.errors != 4 {
        diag_sink_free(mut_view(sink));
        return false;
    }

    // --- Case G: Malformed contract & IR level mismatch traps, plus structural postcondition rollback/trap ---
    let mut malformed_contract = pct_canonical_contract(PCT_PASS_OPT_BCE);
    malformed_contract.postconditions = 0u32;
    let ckpt_g1 = pct_engine_checkpoint_mir(view(eng), view(body), mut_view(*arena));
    let res_g1 = pct_engine_finish_pass(
        mut_view(eng),
        view(malformed_contract),
        mut_view(body),
        mut_view(store),
        view(ckpt_g1),
        false,
        PCT_PROOF_ID_INVALID,
        CERTAINTY_PROVEN,
        mut_view(sink)
    );
    if res_g1 != PCT_EXEC_ABORTED_VERIFY_TRAP ||
       eng.last_trap_kind != PCT_TRAP_INVALID_CONTRACT ||
       sink.errors != 5 {
        diag_sink_free(mut_view(sink));
        return false;
    }

    let mir_verify_contract = pct_canonical_contract(PCT_PASS_MIR_VERIFY);
    let ckpt_g2 = pct_engine_checkpoint_mir(view(eng), view(body), mut_view(*arena));
    let res_g2 = pct_engine_finish_pass(
        mut_view(eng),
        view(mir_verify_contract),
        mut_view(body),
        mut_view(store),
        view(ckpt_g2),
        false,
        PCT_PROOF_ID_INVALID,
        CERTAINTY_PROVEN,
        mut_view(sink)
    );
    if res_g2 != PCT_EXEC_ABORTED_VERIFY_TRAP ||
       eng.last_trap_kind != PCT_TRAP_IR_LEVEL_MISMATCH ||
       sink.errors != 6 {
        diag_sink_free(mut_view(sink));
        return false;
    }

    // Structural CFG violation (out-of-bounds goto_target = 99) with verify_pass_contracts = false
    // and FAILURE_POLICY_ROLLBACK_IR rolls back cleanly with PCT_EXEC_ROLLED_BACK_POSTCOND and 0 new errors!
    eng.verify_pass_contracts = false;
    let ckpt_g3 = pct_engine_checkpoint_mir(view(eng), view(body), mut_view(*arena));
    unsafe {
        (*mir_bb_at(body.bbs, 0)).terminator.goto_target = MirBbId { v: 99u32 };
    }
    let res_g3 = pct_engine_finish_pass(
        mut_view(eng),
        view(custom_contract),
        mut_view(body),
        mut_view(store),
        view(ckpt_g3),
        true,
        PCT_PROOF_ID_INVALID,
        CERTAINTY_PROVEN,
        mut_view(sink)
    );
    let restored_g3_tgt = unsafe { (*mir_bb_at(body.bbs, 0)).terminator.goto_target.v };
    if res_g3 != PCT_EXEC_ROLLED_BACK_POSTCOND || restored_g3_tgt != 1u32 || sink.errors != 6 {
        diag_sink_free(mut_view(sink));
        return false;
    }

    // Re-enable verify_pass_contracts: same structural CFG violation traps with PCT_TRAP_POSTCONDITION_VIOLATED
    eng.verify_pass_contracts = true;
    let ckpt_g4 = pct_engine_checkpoint_mir(view(eng), view(body), mut_view(*arena));
    unsafe {
        (*mir_bb_at(body.bbs, 0)).terminator.goto_target = MirBbId { v: 99u32 };
    }
    let res_g4 = pct_engine_finish_pass(
        mut_view(eng),
        view(custom_contract),
        mut_view(body),
        mut_view(store),
        view(ckpt_g4),
        true,
        PCT_PROOF_ID_INVALID,
        CERTAINTY_PROVEN,
        mut_view(sink)
    );
    if res_g4 != PCT_EXEC_ABORTED_VERIFY_TRAP ||
       eng.last_trap_kind != PCT_TRAP_POSTCONDITION_VIOLATED ||
       sink.errors != 7 {
        diag_sink_free(mut_view(sink));
        return false;
    }

    // --- Case H: Witness summary formatting ---
    let mut wbuf = diag_buf_new();
    pct_format_witness_summary(view(eng), view(store), mut_view(wbuf));
    let wlen = wbuf.len;
    diag_buf_free(mut_view(wbuf));
    diag_sink_free(mut_view(sink));

    wlen > 15
}

pub fn main() -> i32 {
    if !probe_registry_and_certainty_lattice() {
        print("FAIL_REGISTRY_CERTAINTY\n");
        return 1;
    }
    print("PROBE_REGISTRY_CERTAINTY=OK\n");

    let mut arena = arena_new();
    if !probe_proof_store_caching_and_invalidation(mut_view(arena)) {
        arena_destroy(mut_view(arena));
        print("FAIL_PROOF_STORE\n");
        return 2;
    }
    print("PROBE_PROOF_STORE=OK\n");

    if !probe_dataflow_effects_and_symbolic_domains() {
        arena_destroy(mut_view(arena));
        print("FAIL_EFFECTS_SYMBOLIC\n");
        return 3;
    }
    print("PROBE_EFFECTS_SYMBOLIC=OK\n");

    if !probe_transactional_engine_and_verify_traps(mut_view(arena)) {
        arena_destroy(mut_view(arena));
        print("FAIL_TRANSACTIONAL_ENGINE\n");
        return 4;
    }
    print("PROBE_TRANSACTIONAL_ENGINE=OK\n");

    arena_destroy(mut_view(arena));
    print("PROBE_ALL=OK\n");
    0
}
