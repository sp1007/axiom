// test: run
// modes: interp native
// exit: 0
// stdout: proven_opt=120\nfail_closed=77\ndrop_order=21\n
// T769 (E18.5 / SPEC-25): Differential verification of proof-authorized optimizations,
// fail-closed rollback on Unknown/Possible obligations (untaken trapping division/shift),
// and deterministic observable effect / Drop ordering across --interp and native codegen.

struct DropTracker {
    id: i32,
}

impl Drop for DropTracker {
    fn drop(self: mut_view<DropTracker>) {
        if self.id == 1i32 {
            print("1\n");
        } else {
            print("drop_order=2");
        }
    }
}

fn compute_proven_non_aliasing_and_inbounds(
    src: view<[4]i32>,
    dst: mut_view<[4]i32>,
    scale: i32
) -> i32 {
    // Dominance-refined non-zero congruence & bounded shift:
    // stride=4, offset=2 -> always non-zero; shift masked by & 3 -> always in [0, 3]
    let d: i32 = (scale & 3i32) * 4i32 + 2i32;
    let sh: i32 = scale & 1i32;
    let mut i: usize = 0;
    let mut acc: i32 = 0i32;
    while i < 4 {
        let v: i32 = ((*src)[i] << sh) / d;
        (*dst)[i] = v + (*src)[i];
        acc = acc + (*dst)[i];
        i = i + 1;
    }
    acc
}

fn compute_fail_closed_untaken_trap(flag: bool, zero_denom: i32, bad_shift: i32) -> i32 {
    let mut res: i32 = 77i32;
    let mut k: i32 = 0i32;
    while k < 3i32 {
        // Under SPEC-25 AXS-PCT-010, `zero_denom != 0` and `bad_shift < 32` have Certainty.Unknown
        // at loop header; LICM / speculative hoisting MUST fail closed and keep the operations
        // inside the untaken branch without emitting spurious user errors or trapping at runtime.
        if flag {
            res = (100i32 / zero_denom) + (1i32 << bad_shift);
        }
        k = k + 1i32;
    }
    res
}

fn verify_drop_effect_order() {
    let _first = DropTracker { id: 1i32 };
    let _second = DropTracker { id: 2i32 };
}

fn main() -> i32 {
    let src: [4]i32 = [12i32, 18i32, 24i32, 36i32];
    let mut dst: [4]i32 = [0i32, 0i32, 0i32, 0i32];
    let opt_sum = compute_proven_non_aliasing_and_inbounds(view(src), mut_view(dst), 1i32);
    if opt_sum != 120i32 {
        return 1i32;
    }
    print("proven_opt=120\n");

    let fc = compute_fail_closed_untaken_trap(false, 0i32, 64i32);
    if fc != 77i32 {
        return 2i32;
    }
    print("fail_closed=77\n");

    verify_drop_effect_order();
    0i32
}
