// test: run
// modes: interp native
// exit: 0
// stdout: boundary_congruence=44\nuntaken_nested=42\nbranch_drop=B3B2B1\n
// T769 QA boundary test: non-zero congruence & bitmask shift edge cases,
// nested untaken branches with Unknown divisors/shifts (fail-closed against hoisting),
// and deterministic Drop ordering across conditional early-exit paths.

struct BranchDrop {
    tag: i32,
}

impl Drop for BranchDrop {
    fn drop(self: mut_view<BranchDrop>) {
        if self.tag == 1i32 {
            print("B1\n");
        } else if self.tag == 2i32 {
            print("B2");
        } else {
            print("branch_drop=B3");
        }
    }
}

fn eval_boundary_congruence(seed: i32) -> i32 {
    // stride=8, offset=5 -> never 0 for any seed; shift masked by & 7 -> in [0, 7]
    let denom: i32 = (seed & 7i32) * 8i32 + 5i32;
    let sh: i32 = (seed & 3i32) + 1i32;
    let mut acc: i32 = 0i32;
    let mut i: i32 = 0i32;
    while i < 3i32 {
        let num: i32 = (45i32 << sh) + (i * 15i32);
        acc = acc + (num / denom);
        i = i + 1i32;
    }
    acc
}

fn eval_untaken_nested_hazards(outer_run: bool, inner_run: bool, zero_d: i32, over_sh: i32) -> i32 {
    let mut out: i32 = 42i32;
    let mut step: i32 = 0i32;
    while step < 4i32 {
        if outer_run {
            if inner_run {
                out = (256i32 / zero_d) + (1i32 << over_sh);
            }
        }
        step = step + 1i32;
    }
    out
}

fn run_branch_drops(early: bool) -> i32 {
    let _b1 = BranchDrop { tag: 1i32 };
    let _b2 = BranchDrop { tag: 2i32 };
    if early {
        let _b3 = BranchDrop { tag: 3i32 };
        return 10i32;
    }
    0i32
}

fn main() -> i32 {
    let c = eval_boundary_congruence(1i32);
    if c != 44i32 {
        return 1i32;
    }
    print("boundary_congruence=44\n");

    let u = eval_untaken_nested_hazards(true, false, 0i32, 99i32);
    if u != 42i32 {
        return 2i32;
    }
    print("untaken_nested=42\n");

    let d = run_branch_drops(true);
    if d != 10i32 {
        return 3i32;
    }
    0i32
}
