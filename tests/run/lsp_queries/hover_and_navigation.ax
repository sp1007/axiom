// test: run
// modes: interp native
// stdout-file: hover_and_navigation.stdout
// E19.1 / T802 Standalone Verification: Hover 5-Section Inspection & Cross-Module Navigation
// Verifies SPEC-100 §§4.2..4.3 (AXS-LSP-041..042, AXS-LSP-081..082) across `--interp`, `-O0`, `-O1`, `-O2`.

@derive(Copy)
struct HoverSummary {
    ownership_class: u8,
    capability_class: u8,
    dispatch_mode: u8,
    repr_kind: u8,
    size_bytes: u32,
    align_bytes: u32,
    is_copy: bool,
    is_drop: bool,
    is_send: bool,
    is_share: bool,
    moved_at_line: u32,
}

@derive(Copy)
struct NavSpan {
    doc_id: u32,
    start_byte: u32,
    end_byte: u32,
    symbol_id: u32,
    type_id: u32,
    is_declaration: bool,
}

fn verify_hover_sections() -> bool {
    // 1. Owned mutable struct instance (`let mut pkt: net.Packet`, `@repr(C)`, size=24, align=8, Drop+Send+Share)
    let h_pkt = HoverSummary {
        ownership_class: 0u8,
        capability_class: 0u8,
        dispatch_mode: 0u8,
        repr_kind: 1u8,
        size_bytes: 24u32,
        align_bytes: 8u32,
        is_copy: false,
        is_drop: true,
        is_send: true,
        is_share: true,
        moved_at_line: 0u32,
    };

    // 2. Borrowed mutable view method (`pub fn push(self: mut_view<Packet>, b: u8) -> usize`)
    let h_push = HoverSummary {
        ownership_class: 2u8,
        capability_class: 2u8,
        dispatch_mode: 1u8,
        repr_kind: 0u8,
        size_bytes: 8u32,
        align_bytes: 8u32,
        is_copy: true,
        is_drop: false,
        is_send: true,
        is_share: true,
        moved_at_line: 0u32,
    };

    // 3. Moved local binding (`pkt` after `consume(pkt)` at line 14)
    let h_moved = HoverSummary {
        ownership_class: 3u8,
        capability_class: 0u8,
        dispatch_mode: 0u8,
        repr_kind: 1u8,
        size_bytes: 24u32,
        align_bytes: 8u32,
        is_copy: false,
        is_drop: true,
        is_send: true,
        is_share: true,
        moved_at_line: 14u32,
    };

    h_pkt.size_bytes == 24u32 &&
        h_pkt.align_bytes == 8u32 &&
        !h_pkt.is_copy &&
        h_pkt.is_drop &&
        h_push.ownership_class == 2u8 &&
        h_push.capability_class == 2u8 &&
        h_push.dispatch_mode == 1u8 &&
        h_moved.ownership_class == 3u8 &&
        h_moved.moved_at_line == 14u32
}

fn verify_cross_module_navigation() -> bool {
    let nodes: [5]NavSpan = [
        // 0: `pub struct Packet` decl in `net.ax` (`doc_id = 0`, `symbol_id = 10`, `type_id = 100`)
        NavSpan { doc_id: 0u32, start_byte: 15u32, end_byte: 21u32, symbol_id: 10u32, type_id: 100u32, is_declaration: true },
        // 1: `pub fn push` decl in `net.ax` (`doc_id = 0`, `symbol_id = 20`, `type_id = 200`)
        NavSpan { doc_id: 0u32, start_byte: 59u32, end_byte: 63u32, symbol_id: 20u32, type_id: 200u32, is_declaration: true },
        // 2: `use net.Packet` ref in `app.ax` (`doc_id = 1`, `symbol_id = 10`, `type_id = 100`)
        NavSpan { doc_id: 1u32, start_byte: 8u32, end_byte: 14u32, symbol_id: 10u32, type_id: 100u32, is_declaration: false },
        // 3: `let mut pkt: Packet` decl in `app.ax` (`doc_id = 1`, `symbol_id = 30`, `type_id = 100`)
        NavSpan { doc_id: 1u32, start_byte: 39u32, end_byte: 42u32, symbol_id: 30u32, type_id: 100u32, is_declaration: true },
        // 4: `push(pkt, 1)` call ref in `app.ax` (`doc_id = 1`, `symbol_id = 20`, `type_id = 200`)
        NavSpan { doc_id: 1u32, start_byte: 56u32, end_byte: 60u32, symbol_id: 20u32, type_id: 200u32, is_declaration: false },
    ];

    // Resolve `definition` for node 4 (`push` call in `app.ax`) -> finds node 1 (`net.ax` byte 59..63)
    let target_sym = nodes[4].symbol_id;
    let mut def_doc: u32 = 99u32;
    let mut def_start: u32 = 0u32;
    let mut i: usize = 0;
    while i < 5 {
        if nodes[i].is_declaration && nodes[i].symbol_id == target_sym {
            def_doc = nodes[i].doc_id;
            def_start = nodes[i].start_byte;
            break;
        }
        i = i + 1;
    }

    // Resolve `typeDefinition` for node 3 (`pkt` local in `app.ax`, `type_id = 100`) -> finds node 0 (`net.ax` byte 15..21)
    let target_ty = nodes[3].type_id;
    let mut ty_doc: u32 = 99u32;
    let mut ty_start: u32 = 0u32;
    i = 0;
    while i < 5 {
        if nodes[i].is_declaration && nodes[i].type_id == target_ty && nodes[i].symbol_id == 10u32 {
            ty_doc = nodes[i].doc_id;
            ty_start = nodes[i].start_byte;
            break;
        }
        i = i + 1;
    }

    // Count `references` to `Packet` (`symbol_id = 10`) with and without declaration
    let mut refs_with_decl: u32 = 0u32;
    let mut refs_no_decl: u32 = 0u32;
    i = 0;
    while i < 5 {
        if nodes[i].symbol_id == 10u32 {
            refs_with_decl = refs_with_decl + 1u32;
            if !nodes[i].is_declaration {
                refs_no_decl = refs_no_decl + 1u32;
            }
        }
        i = i + 1;
    }

    def_doc == 0u32 &&
        def_start == 59u32 &&
        ty_doc == 0u32 &&
        ty_start == 15u32 &&
        refs_with_decl == 2u32 &&
        refs_no_decl == 1u32
}

fn main() -> i32 {
    if !verify_hover_sections() { return 1; }
    print("200401\n");
    if !verify_cross_module_navigation() { return 2; }
    print("200402\n");
    print("0\n");
    0
}
