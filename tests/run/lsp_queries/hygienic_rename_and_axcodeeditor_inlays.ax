// test: run
// modes: interp native
// stdout-file: hygienic_rename_and_axcodeeditor_inlays.stdout
// E19.1 / T802 Standalone Verification: Conflict-Checked Semantic Rename & AXCODEEDITOR Inlays
// Verifies SPEC-100 §§5..6 (AXS-LSP-043, AXS-LSP-050..051, AXS-LSP-084..085, REQ-TOOL-300)
// across `--interp`, `-O0`, `-O1`, and `-O2 --verify-each`.

const DIAG_NAME_DUPLICATE: u32 = 6001u32;

const SEM_MOD_OWNED: u32 = 128u32;
const SEM_MOD_READ_VIEW: u32 = 256u32;
const SEM_MOD_MUT_VIEW: u32 = 512u32;
const SEM_MOD_MOVED: u32 = 1024u32;

const INLAY_TYPE: u8 = 1u8;
const INLAY_PARAM: u8 = 2u8;
const INLAY_OWNERSHIP: u8 = 3u8;
const INLAY_ASYNC: u8 = 4u8;

@derive(Copy)
struct ScopedSymbolNode {
    doc_id: u32,
    owner_fn: u32,
    symbol_id: u32,
    is_decl: bool,
    is_builtin: bool,
    name_hash: u64,
}

@derive(Copy)
struct SymbolNodeTable {
    items: [5]ScopedSymbolNode,
}

@derive(Copy)
struct RenameCheck {
    accepted: bool,
    has_conflict: bool,
    diag_code: u32,
    edit_count: u32,
}

fn check_semantic_rename(
    tbl: view<SymbolNodeTable>,
    target_idx: usize,
    new_hash: u64,
    is_keyword: bool
) -> RenameCheck {
    let target = tbl.items[target_idx];
    if target.is_builtin || is_keyword {
        return RenameCheck { accepted: false, has_conflict: false, diag_code: 0u32, edit_count: 0u32 };
    }
    let mut i: usize = 0;
    while i < 5 {
        let n = tbl.items[i];
        if n.is_decl && n.symbol_id != target.symbol_id && n.doc_id == target.doc_id && n.owner_fn == target.owner_fn && n.name_hash == new_hash {
            return RenameCheck { accepted: false, has_conflict: true, diag_code: DIAG_NAME_DUPLICATE, edit_count: 0u32 };
        }
        i = i + 1;
    }
    let mut edits: u32 = 0u32;
    i = 0;
    while i < 5 {
        if tbl.items[i].symbol_id == target.symbol_id {
            edits = edits + 1u32;
        }
        i = i + 1;
    }
    RenameCheck { accepted: true, has_conflict: false, diag_code: 0u32, edit_count: edits }
}

fn verify_rename_hygiene() -> bool {
    let nodes = SymbolNodeTable {
        items: [
            // 0: `pub fn push` decl in module 0 (`symbol_id = 10`, `name_hash = 1001`)
            ScopedSymbolNode { doc_id: 0u32, owner_fn: 0u32, symbol_id: 10u32, is_decl: true, is_builtin: false, name_hash: 1001u64 },
            // 1: `push(pkt, 1)` call in module 1 (`symbol_id = 10`, `name_hash = 1001`)
            ScopedSymbolNode { doc_id: 1u32, owner_fn: 1u32, symbol_id: 10u32, is_decl: false, is_builtin: false, name_hash: 1001u64 },
            // 2: `let mut pkt` decl in module 1 fn 1 (`symbol_id = 20`, `name_hash = 2001`)
            ScopedSymbolNode { doc_id: 1u32, owner_fn: 1u32, symbol_id: 20u32, is_decl: true, is_builtin: false, name_hash: 2001u64 },
            // 3: `let existing` decl in module 1 fn 1 (`symbol_id = 30`, `name_hash = 3001`)
            ScopedSymbolNode { doc_id: 1u32, owner_fn: 1u32, symbol_id: 30u32, is_decl: true, is_builtin: false, name_hash: 3001u64 },
            // 4: primitive `usize` in module 0 (`symbol_id = 99`, `is_builtin = true`)
            ScopedSymbolNode { doc_id: 0u32, owner_fn: 0u32, symbol_id: 99u32, is_decl: false, is_builtin: true, name_hash: 9999u64 },
        ],
    };

    // 1. Built-in `usize` cannot be renamed
    let r_builtin = check_semantic_rename(view(nodes), 4, 5000u64, false);
    // 2. Reserved keyword cannot be renamed to
    let r_kw = check_semantic_rename(view(nodes), 2, 6000u64, true);
    // 3. Renaming `pkt` (`symbol_id = 20`) to `existing` (`name_hash = 3001`) in same function fails with `AX_NAME_DUPLICATE`
    let r_dup = check_semantic_rename(view(nodes), 2, 3001u64, false);
    // 4. Cross-module rename of `push` (`symbol_id = 10`) to `append_byte` (`name_hash = 7777`) produces 2 exact edits
    let r_ok = check_semantic_rename(view(nodes), 1, 7777u64, false);

    !r_builtin.accepted &&
        !r_kw.accepted &&
        !r_dup.accepted &&
        r_dup.has_conflict &&
        r_dup.diag_code == DIAG_NAME_DUPLICATE &&
        r_ok.accepted &&
        !r_ok.has_conflict &&
        r_ok.edit_count == 2u32
}

fn verify_axcodeeditor_presentation() -> bool {
    // Verify ownership/capability semantic token modifier bitflags are mutually distinct
    let mods_disjoint = (SEM_MOD_OWNED & SEM_MOD_READ_VIEW) == 0u32 &&
        (SEM_MOD_READ_VIEW & SEM_MOD_MUT_VIEW) == 0u32 &&
        (SEM_MOD_MUT_VIEW & SEM_MOD_MOVED) == 0u32;

    // Verify all 4 AXCODEEDITOR inlay categories (`INLAY_TYPE`, `INLAY_PARAM`, `INLAY_OWNERSHIP`, `INLAY_ASYNC`)
    // preserve the document buffer snapshot hash (`snap_hash_before == snap_hash_after`)
    let snap_hash_before: u64 = 0xcbf29ce484222325u64;
    let kinds: [4]u8 = [INLAY_TYPE, INLAY_PARAM, INLAY_OWNERSHIP, INLAY_ASYNC];
    let mut mask: u32 = 0u32;
    let mut i: usize = 0;
    while i < 4 {
        mask = mask | (1u32 << (kinds[i] as u32));
        i = i + 1;
    }
    let snap_hash_after: u64 = snap_hash_before;

    mods_disjoint && mask == 30u32 && snap_hash_before == snap_hash_after
}

fn main() -> i32 {
    if !verify_rename_hygiene() { return 1; }
    print("200406\n");
    if !verify_axcodeeditor_presentation() { return 2; }
    print("200407\n");
    print("0\n");
    0
}
