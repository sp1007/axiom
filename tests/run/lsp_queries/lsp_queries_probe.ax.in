@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

fn probe_setup_workspace(ws: mut_view<VfsWorkspace>, eng: mut_view<LspSemanticEngine>) -> u32 {
    let doc_net: u32 = 0u32;
    let doc_app: u32 = 1u32;

    // Module 0: `file:///workspace/net.ax`
    // Line 0 (0..11):  "module net\n" (11 bytes)
    // Line 1 (11..31): "pub struct Packet {\n" (20 bytes)
    // Line 2 (31..50): "    pub len: usize\n" (19 bytes)
    // Line 3 (50..52): "}\n" (2 bytes)
    // Line 4 (52..95): "pub fn push(p: mut_view<Packet>, b: u8) {}\n" (43 bytes)
    let net_src = "module net\npub struct Packet {\n    pub len: usize\n}\npub fn push(p: mut_view<Packet>, b: u8) {}\n";
    let net_sv = lsp_str_view(net_src);
    let _ = vfs_did_open(
        mut_view(*ws),
        doc_net,
        vfs_hash_str("file:///workspace/net.ax"),
        1i64,
        net_sv.ptr,
        net_sv.len,
        0x1111u64,
        0x2222u64
    );

    // Module 1: `file:///workspace/app.ax`
    // Line 0 (0..15):  "use net.Packet\n" (15 bytes)
    // Line 1 (15..27): "fn main() {\n" (12 bytes)
    // Line 2 (27..52): "    let mut pkt = Packet\n" (25 bytes)
    // Line 3 (52..69): "    push(pkt, 1)\n" (17 bytes)
    // Line 4 (69..78): "    pkt.\n" (9 bytes, dot at byte 76)
    // Line 5 (78..80): "}\n" (2 bytes)
    let app_src = "use net.Packet\nfn main() {\n    let mut pkt = Packet\n    push(pkt, 1)\n    pkt.\n}\n";
    let app_sv = lsp_str_view(app_src);
    let _ = vfs_did_open(
        mut_view(*ws),
        doc_app,
        vfs_hash_str("file:///workspace/app.ax"),
        1i64,
        app_sv.ptr,
        app_sv.len,
        0x3333u64,
        0x4444u64
    );

    // Intern generational entities in VFS arena (`AXS-LSP-002`)
    // Index 1: ty_packet
    let ty_packet = vfs_intern_type(mut_view(*ws), doc_net, "net.Packet", 15u32, 21u32);
    // Index 2: ty_usize
    let ty_usize = vfs_intern_type(mut_view(*ws), doc_net, "usize", 43u32, 48u32);
    // Index 3: sym_packet
    let sym_packet = vfs_intern_symbol(mut_view(*ws), doc_net, "net.Packet", ty_packet, 15u32, 21u32);
    // Index 4: sym_push
    let sym_push = vfs_intern_symbol(mut_view(*ws), doc_net, "net.push", ty_usize, 59u32, 63u32);
    // Index 5: sym_checksum
    let sym_checksum = vfs_intern_symbol(mut_view(*ws), doc_net, "net.checksum", ty_usize, 64u32, 72u32);
    // Index 6: sym_trait_ser
    let sym_trait_ser = vfs_intern_symbol(mut_view(*ws), doc_net, "net.Serializable", ty_usize, 1u32, 5u32);
    // Index 7: sym_trait_dbg
    let sym_trait_dbg = vfs_intern_symbol(mut_view(*ws), doc_net, "net.DebugFormat", ty_usize, 6u32, 10u32);
    // Index 8: fn_main
    let fn_main = vfs_intern_function(mut_view(*ws), doc_app, "app.main", ty_usize, 18u32, 22u32);
    // Index 9: loc_pkt
    let loc_pkt = vfs_intern_local(mut_view(*ws), doc_app, fn_main, 1u16, "pkt", 0u16, ty_packet, OWNERSHIP_OWNED, CAP_NONE, 39u32, 42u32);
    // Index 10: loc_ro
    let loc_ro = vfs_intern_local(mut_view(*ws), doc_app, fn_main, 1u16, "existing_local", 1u16, ty_packet, OWNERSHIP_VIEW, CAP_READ_ONLY, 27u32, 30u32);

    // Register `Packet` layout metadata (`size=24`, `align=8`, `REPR_C`) in `LspSemanticEngine` and `CompilerDB`
    lsp_register_type_meta(
        mut_view(*eng),
        mut_view(*ws),
        ty_packet,
        doc_net,
        15u32,
        21u32,
        sym_packet,
        "net.Packet",
        REPR_C,
        24u32,
        8u32,
        false,
        true,
        true,
        true
    );

    // Register `Packet` struct declaration in `net.ax` (bytes 15..21)
    let _ = lsp_register_node(
        mut_view(*eng),
        mut_view(*ws),
        doc_net,
        15u32,
        21u32,
        sym_packet,
        sym_packet.raw,
        FunctionId { raw: gen_id_new(0u32, 0u32) },
        0u16,
        SYM_KIND_STRUCT,
        SEM_TOK_STRUCT,
        0u32,
        true,
        true,
        false,
        false,
        ty_packet,
        OWNERSHIP_OWNED,
        CAP_NONE,
        DISPATCH_NONE,
        "Packet",
        "pub struct Packet",
        "net.Packet",
        "",
        "",
        "Network packet buffer with deterministic layout."
    );

    // Register `push` function declaration in `net.ax` (bytes 59..63)
    let _ = lsp_register_node(
        mut_view(*eng),
        mut_view(*ws),
        doc_net,
        59u32,
        63u32,
        sym_push,
        sym_push.raw,
        FunctionId { raw: gen_id_new(0u32, 0u32) },
        0u16,
        SYM_KIND_FUNCTION,
        SEM_TOK_FUNCTION,
        0u32,
        true,
        true,
        false,
        false,
        ty_usize,
        OWNERSHIP_MUT_VIEW,
        CAP_READ_WRITE,
        DISPATCH_INHERENT,
        "push",
        "pub fn push(p: mut_view<Packet>, b: u8) -> usize",
        "fn(mut_view<net.Packet>, u8) -> usize",
        "p",
        "impl net.Packet",
        "Appends a byte into the mutable packet view."
    );

    // Register `Packet` reference in `use net.Packet` in `app.ax` (bytes 8..14)
    let _ = lsp_register_node(
        mut_view(*eng),
        mut_view(*ws),
        doc_app,
        8u32,
        14u32,
        sym_packet,
        sym_packet.raw,
        FunctionId { raw: gen_id_new(0u32, 0u32) },
        0u16,
        SYM_KIND_STRUCT,
        SEM_TOK_STRUCT,
        0u32,
        false,
        true,
        false,
        false,
        ty_packet,
        OWNERSHIP_OWNED,
        CAP_NONE,
        DISPATCH_NONE,
        "Packet",
        "pub struct Packet",
        "net.Packet",
        "",
        "",
        "Network packet buffer with deterministic layout."
    );

    // Register `pkt` local binding in `app.ax` (bytes 39..42)
    let sym_pkt_local = LspSymbolId { raw: loc_pkt.raw };
    let _ = lsp_register_node(
        mut_view(*eng),
        mut_view(*ws),
        doc_app,
        39u32,
        42u32,
        sym_pkt_local,
        loc_pkt.raw,
        fn_main,
        1u16,
        SYM_KIND_VARIABLE,
        SEM_TOK_VARIABLE,
        0u32,
        true,
        false,
        true,
        false,
        ty_packet,
        OWNERSHIP_OWNED,
        CAP_NONE,
        DISPATCH_NONE,
        "pkt",
        "let mut pkt: net.Packet",
        "net.Packet",
        "pkt",
        "",
        "Local mutable packet instance."
    );

    // Register `push` call site in `app.ax` (bytes 56..60)
    let _ = lsp_register_node(
        mut_view(*eng),
        mut_view(*ws),
        doc_app,
        56u32,
        60u32,
        sym_push,
        sym_push.raw,
        fn_main,
        1u16,
        SYM_KIND_FUNCTION,
        SEM_TOK_FUNCTION,
        0u32,
        false,
        true,
        false,
        false,
        ty_usize,
        OWNERSHIP_MUT_VIEW,
        CAP_READ_WRITE,
        DISPATCH_INHERENT,
        "push",
        "pub fn push(p: mut_view<Packet>, b: u8) -> usize",
        "fn(mut_view<net.Packet>, u8) -> usize",
        "pkt",
        "impl net.Packet",
        "Appends a byte into the mutable packet view."
    );

    // Register `pkt` use site at `push(pkt, 1)` in `app.ax` (bytes 61..64)
    let _ = lsp_register_node(
        mut_view(*eng),
        mut_view(*ws),
        doc_app,
        61u32,
        64u32,
        sym_pkt_local,
        loc_pkt.raw,
        fn_main,
        1u16,
        SYM_KIND_VARIABLE,
        SEM_TOK_VARIABLE,
        0u32,
        false,
        false,
        true,
        false,
        ty_packet,
        OWNERSHIP_MUT_VIEW,
        CAP_READ_WRITE,
        DISPATCH_NONE,
        "pkt",
        "let mut pkt: net.Packet",
        "mut_view<net.Packet>",
        "pkt",
        "",
        ""
    );

    // Register `existing_local` in `app.ax` for rename collision checking (bytes 27..30)
    let sym_existing = LspSymbolId { raw: loc_ro.raw };
    let _ = lsp_register_node(
        mut_view(*eng),
        mut_view(*ws),
        doc_app,
        27u32,
        30u32,
        sym_existing,
        loc_ro.raw,
        fn_main,
        1u16,
        SYM_KIND_VARIABLE,
        SEM_TOK_VARIABLE,
        0u32,
        true,
        false,
        false,
        false,
        ty_packet,
        OWNERSHIP_VIEW,
        CAP_READ_ONLY,
        DISPATCH_NONE,
        "existing_local",
        "let existing_local: view<net.Packet>",
        "view<net.Packet>",
        "pkt",
        "",
        ""
    );

    // Register a built-in type reference (`usize` in `net.ax` bytes 43..48) to verify `prepareRename` rejection
    let _ = lsp_register_node(
        mut_view(*eng),
        mut_view(*ws),
        doc_net,
        43u32,
        48u32,
        LspSymbolId { raw: ty_usize.raw },
        ty_usize.raw,
        FunctionId { raw: gen_id_new(0u32, 0u32) },
        0u16,
        SYM_KIND_STRUCT,
        SEM_TOK_TYPE,
        0u32,
        false,
        true,
        false,
        true,
        ty_usize,
        OWNERSHIP_OWNED,
        CAP_NONE,
        DISPATCH_NONE,
        "usize",
        "primitive type usize",
        "usize",
        "",
        "",
        ""
    );
    doc_app
}

fn probe_populate_candidates_and_recovery(ws: mut_view<VfsWorkspace>, eng: mut_view<LspSemanticEngine>, doc_app: u32) {
    let doc_net: u32 = 0u32;
    let ty_packet = LspTypeId { raw: gen_id_new(1u32, 1u32) };
    let ty_usize = LspTypeId { raw: gen_id_new(2u32, 1u32) };
    let sym_packet = LspSymbolId { raw: gen_id_new(3u32, 1u32) };
    let sym_push = LspSymbolId { raw: gen_id_new(4u32, 1u32) };
    let sym_checksum = LspSymbolId { raw: gen_id_new(5u32, 1u32) };
    let sym_trait_ser = LspSymbolId { raw: gen_id_new(6u32, 1u32) };
    let sym_trait_dbg = LspSymbolId { raw: gen_id_new(7u32, 1u32) };
    let fn_main = FunctionId { raw: gen_id_new(8u32, 1u32) };
    let loc_pkt = LocalId { raw: gen_id_new(9u32, 1u32) };
    let sym_pkt_local = LspSymbolId { raw: gen_id_new(9u32, 1u32) };

    // Register trait implementation for `Packet` (`impl Serializable for Packet`)
    lsp_register_trait_impl(
        mut_view(*eng),
        mut_view(*ws),
        sym_trait_ser,
        ty_packet,
        doc_net,
        11u32,
        51u32,
        sym_packet,
        "net.Serializable.for.net.Packet"
    );

    // Register member completion candidates on `Packet`:
    // 1. `len: usize` (`pub` field, `REQ_RECEIVER_FIELD`)
    lsp_register_member_candidate(
        mut_view(*eng),
        doc_net,
        true,
        true,
        ty_packet,
        ty_usize,
        REQ_RECEIVER_FIELD,
        COMP_KIND_FIELD,
        sym_packet,
        LspSymbolId { raw: gen_id_new(0u32, 0u32) },
        "len",
        "len",
        "pub len: usize"
    );
    // 2. `secret_tag: u32` (private field in `net.ax` -> must be excluded in `app.ax`!)
    lsp_register_member_candidate(
        mut_view(*eng),
        doc_net,
        false,
        true,
        ty_packet,
        ty_usize,
        REQ_RECEIVER_FIELD,
        COMP_KIND_FIELD,
        sym_packet,
        LspSymbolId { raw: gen_id_new(0u32, 0u32) },
        "secret_tag",
        "secret_tag",
        "secret_tag: u32"
    );
    // 3. `checksum(self: view<Packet>) -> usize` (`pub` read-only method)
    lsp_register_member_candidate(
        mut_view(*eng),
        doc_net,
        true,
        true,
        ty_packet,
        ty_usize,
        REQ_RECEIVER_VIEW,
        COMP_KIND_METHOD,
        sym_checksum,
        LspSymbolId { raw: gen_id_new(0u32, 0u32) },
        "checksum",
        "checksum",
        "pub fn checksum(self: view<Packet>) -> usize"
    );
    // 4. `push(self: mut_view<Packet>, b: u8) -> usize` (`pub` mutable method -> excluded on `view<Packet>`!)
    lsp_register_member_candidate(
        mut_view(*eng),
        doc_net,
        true,
        true,
        ty_packet,
        ty_usize,
        REQ_RECEIVER_MUT_VIEW,
        COMP_KIND_METHOD,
        sym_push,
        LspSymbolId { raw: gen_id_new(0u32, 0u32) },
        "push",
        "push",
        "pub fn push(self: mut_view<Packet>, b: u8) -> usize"
    );
    // 5 & 6. Two ambiguous trait methods `format` from `Serializable` and `DebugFormat` (`AXS-LSP-040 §3`)
    lsp_register_member_candidate(
        mut_view(*eng),
        doc_net,
        true,
        true,
        ty_packet,
        ty_usize,
        REQ_RECEIVER_VIEW,
        COMP_KIND_METHOD,
        sym_trait_ser,
        sym_trait_ser,
        "format",
        "Serializable.format",
        "trait net.Serializable.format(view<Packet>)"
    );
    lsp_register_member_candidate(
        mut_view(*eng),
        doc_net,
        true,
        true,
        ty_packet,
        ty_usize,
        REQ_RECEIVER_VIEW,
        COMP_KIND_METHOD,
        sym_trait_dbg,
        sym_trait_dbg,
        "format",
        "DebugFormat.format",
        "trait net.DebugFormat.format(view<Packet>)"
    );

    // Register scope completion candidate for `pkt`
    lsp_register_scope_candidate(
        mut_view(*eng),
        doc_app,
        fn_main,
        1u16,
        false,
        true,
        ty_packet,
        COMP_KIND_VARIABLE,
        loc_pkt,
        sym_pkt_local,
        "pkt",
        "let mut pkt: net.Packet"
    );

    // Record partial-program `IncompleteMemberAccess` at `pkt.` in `app.ax` (dot at byte 76, line 4 char 7..8)
    let _ = vfs_record_incomplete_member_access(
        mut_view(*ws),
        doc_app,
        fn_main,
        loc_pkt,
        76u32
    );

    // Register AXCODEEDITOR inlay sites in `app.ax` (`AXS-LSP-051`, `REQ-TOOL-300`)
    lsp_register_inlay_site(mut_view(*eng), doc_app, 42u32, INLAY_KIND_INFERRED_TYPE, INLAY_SUBKIND_NONE, REGION_REL_NONE, 0u16, 0u16, ": net.Packet");
    lsp_register_inlay_site(mut_view(*eng), doc_app, 61u32, INLAY_KIND_PARAMETER_NAME, INLAY_SUBKIND_NONE, REGION_REL_NONE, 0u16, 0u16, "p:");
    lsp_register_inlay_site(mut_view(*eng), doc_app, 64u32, INLAY_KIND_OWNERSHIP_FLOW, INLAY_SUBKIND_MUT_VIEW, REGION_REL_SAME, 0u16, 0u16, "/* mut_view pkt */");
    lsp_register_inlay_site(mut_view(*eng), doc_app, 78u32, INLAY_KIND_OWNERSHIP_FLOW, INLAY_SUBKIND_DROP, REGION_REL_NONE, 0u16, 0u16, "/* drop pkt */");
    lsp_register_inlay_site(mut_view(*eng), doc_app, 70u32, INLAY_KIND_ASYNC_SUSPEND, INLAY_SUBKIND_AWAIT_STATE, REGION_REL_CONTAINS, 1u16, 2u16, "/* await #1 (2 live) */");
}

fn test_1_diagnostics_and_codes(ws: mut_view<VfsWorkspace>, eng: mut_view<LspSemanticEngine>, doc_app: u32) -> bool {
    // Poison `existing_local` (`index = 10`) with an incomplete expression and verify downstream cascade suppression
    let fn_main = FunctionId { raw: gen_id_new(8u32, 1u32) };
    let loc_ro = LocalId { raw: gen_id_new(10u32, 1u32) };
    let ty_packet = LspTypeId { raw: gen_id_new(1u32, 1u32) };
    let _ = vfs_record_incomplete_expr(mut_view(*ws), doc_app, fn_main, loc_ro, ty_packet, 27u32, 30u32);
    let _ = vfs_typecheck_local_use(mut_view(*ws), doc_app, loc_ro, true, 61u32, 64u32);

    let pub_diag = lsp_handle_publish_diagnostics(mut_view(*eng), mut_view(*ws), doc_app);
    pub_diag.doc_id == doc_app &&
        pub_diag.client_version == 1i64 &&
        pub_diag.diagnostic_count == 2u32 &&
        pub_diag.error_count == 2u32 &&
        pub_diag.cascaded_suppressed == 1u32 &&
        pub_diag.header.certainty == CERTAINTY_RECOVERED &&
        lsp_diag_code_name(DIAG_PARSE_INCOMPLETE_MEMBER).len == 26 &&
        lsp_diag_code_name(DIAG_MOVE_USE_AFTER_MOVE).len == 22 &&
        lsp_diag_code_name(DIAG_TRAIT_AMBIGUOUS_METHOD).len == 25 &&
        lsp_diag_code_name(DIAG_NAME_DUPLICATE).len == 17 &&
        ws.codegen_invocations == 0u32
}

fn test_2_hover_sections_and_layout(ws: mut_view<VfsWorkspace>, eng: mut_view<LspSemanticEngine>, doc_app: u32) -> bool {
    // Hover on `pkt` declaration in `app.ax` (line 2, char 13 -> byte 40)
    let h_pkt = lsp_handle_hover(mut_view(*eng), mut_view(*ws), doc_app, lsp_pos_new(2u32, 13u32));
    // Hover on `push` call site in `app.ax` (line 3, char 5 -> byte 57)
    let h_push = lsp_handle_hover(mut_view(*eng), mut_view(*ws), doc_app, lsp_pos_new(3u32, 5u32));

    h_pkt.found &&
        h_pkt.header.certainty == CERTAINTY_EXACT &&
        h_pkt.ownership_class == OWNERSHIP_OWNED &&
        h_pkt.is_mutable_binding &&
        h_pkt.repr_kind == REPR_C &&
        h_pkt.layout_size_bytes == 24u32 &&
        h_pkt.layout_align_bytes == 8u32 &&
        !h_pkt.is_copy &&
        h_pkt.is_drop &&
        h_pkt.is_send &&
        h_pkt.is_share &&
        h_pkt.doc_comment_str.len > 0 &&
        h_push.found &&
        h_push.dispatch_mode == DISPATCH_INHERENT &&
        h_push.ownership_class == OWNERSHIP_MUT_VIEW &&
        h_push.capability_class == CAP_READ_WRITE &&
        h_push.is_pure &&
        ws.codegen_invocations == 0u32
}

fn test_3_cross_module_navigation(ws: mut_view<VfsWorkspace>, eng: mut_view<LspSemanticEngine>, doc_app: u32) -> bool {
    // 1. Go-to-definition on `push` call in `app.ax` (line 3, char 5) -> resolves to `net.ax` (`doc_id == 0`, line 4)
    let def_push = lsp_handle_definition(mut_view(*eng), mut_view(*ws), doc_app, lsp_pos_new(3u32, 5u32));
    // 2. Go-to-type-definition on `pkt` in `app.ax` (line 2, char 13) -> resolves to `pub struct Packet` in `net.ax` (`doc_id == 0`, line 1)
    let tdef_pkt = lsp_handle_type_definition(mut_view(*eng), mut_view(*ws), doc_app, lsp_pos_new(2u32, 13u32));
    // 3. Find references on `Packet` in `app.ax` (line 0, char 10) -> 2 references (`net.ax` decl + `app.ax` use) with decl, 1 without decl
    let refs_all = lsp_handle_references(mut_view(*eng), mut_view(*ws), doc_app, lsp_pos_new(0u32, 10u32), true);
    let refs_uses = lsp_handle_references(mut_view(*eng), mut_view(*ws), doc_app, lsp_pos_new(0u32, 10u32), false);
    // 4. Document symbols in `net.ax` (`doc_id == 0`) & workspace symbols for `"Packet"`
    let dsyms = lsp_handle_document_symbol(mut_view(*eng), mut_view(*ws), 0u32);
    let wsyms = lsp_handle_workspace_symbol(mut_view(*eng), mut_view(*ws), "Packet");

    def_push.found &&
        def_push.location.doc_id == 0u32 &&
        def_push.location.range.start.line == 4u32 &&
        tdef_pkt.found &&
        tdef_pkt.location.doc_id == 0u32 &&
        tdef_pkt.location.range.start.line == 1u32 &&
        refs_all.count == 2u32 &&
        refs_uses.count == 1u32 &&
        dsyms.count == 2u32 &&
        wsyms.count == 1u32 &&
        ws.codegen_invocations == 0u32
}

fn test_6_axcodeeditor_tokens_and_inlays(ws: mut_view<VfsWorkspace>, eng: mut_view<LspSemanticEngine>, doc_app: u32) -> bool {
    let toks = lsp_handle_semantic_tokens_full(mut_view(*eng), mut_view(*ws), doc_app);
    let delta = lsp_handle_semantic_tokens_delta(mut_view(*eng), mut_view(*ws), doc_app, toks.result_id);

    let full_range = lsp_range_new(lsp_pos_new(0u32, 0u32), lsp_pos_new(10u32, 0u32));
    let inlays = lsp_handle_inlay_hints(mut_view(*eng), mut_view(*ws), doc_app, full_range);

    let valid_span = LspPresentationSpan {
        doc_id: doc_app,
        revision: ws.revision,
        layer: HIGHLIGHT_LAYER_SEMANTIC_TOKEN,
        start_byte: 8u32,
        end_byte: 14u32,
    };
    let stale_span = LspPresentationSpan {
        doc_id: doc_app,
        revision: ws.revision - 1u64,
        layer: HIGHLIGHT_LAYER_SEMANTIC_TOKEN,
        start_byte: 8u32,
        end_byte: 14u32,
    };

    toks.token_count == 5u32 &&
        (toks.tokens[1].token_modifiers & SEM_MOD_READ_VIEW) != 0u32 &&
        (toks.tokens[2].token_modifiers & SEM_MOD_OWNED_VALUE) != 0u32 &&
        (toks.tokens[4].token_modifiers & SEM_MOD_MUT_VIEW) != 0u32 &&
        delta.previous_result_id == toks.result_id &&
        delta.changed_token_count == 1u32 &&
        inlays.count == 5u32 &&
        inlays.type_hint_count == 1u32 &&
        inlays.param_hint_count == 1u32 &&
        inlays.ownership_hint_count == 2u32 &&
        inlays.async_hint_count == 1u32 &&
        !inlays.buffer_mutated &&
        lsp_verify_presentation_span(view(*ws), valid_span) &&
        !lsp_verify_presentation_span(view(*ws), stale_span) &&
        ws.codegen_invocations == 0u32
}

fn test_4_completion_and_ambiguity(ws: mut_view<VfsWorkspace>, eng: mut_view<LspSemanticEngine>, doc_app: u32) -> bool {
    let fn_main = FunctionId { raw: gen_id_new(8u32, 1u32) };
    let ty_packet = LspTypeId { raw: gen_id_new(1u32, 1u32) };
    let ty_usize = LspTypeId { raw: gen_id_new(2u32, 1u32) };
    let loc_pkt = LocalId { raw: gen_id_new(9u32, 1u32) };
    let loc_ro = LocalId { raw: gen_id_new(10u32, 1u32) };

    // 1. Complete at `pkt.` (`mut pkt`, dot at byte 76 -> line 4, char 8)
    let c_mut = lsp_handle_completion(mut_view(*eng), mut_view(*ws), doc_app, lsp_pos_new(4u32, 8u32), fn_main, 1u16, ty_usize);

    // 2. Record read-only `IncompleteMemberAccess` on `loc_ro` (`view<Packet>`) at dot byte 78 (line 5, char 0) and complete
    let _ = vfs_record_incomplete_member_access(mut_view(*ws), doc_app, fn_main, loc_ro, 78u32);
    let c_ro = lsp_handle_completion(mut_view(*eng), mut_view(*ws), doc_app, lsp_pos_new(5u32, 0u32), fn_main, 1u16, ty_usize);

    // 3. Mark `pkt` as moved at line 14 and verify both member completion (`pkt.`) and scope completion exclude `pkt`!
    lsp_mark_local_moved(mut_view(*eng), mut_view(*ws), loc_pkt, 14u32);
    let c_moved = lsp_handle_completion(mut_view(*eng), mut_view(*ws), doc_app, lsp_pos_new(4u32, 8u32), fn_main, 1u16, ty_usize);
    let c_scope = lsp_handle_completion(mut_view(*eng), mut_view(*ws), doc_app, lsp_pos_new(2u32, 4u32), fn_main, 1u16, ty_packet);

    c_mut.is_incomplete_member &&
        c_mut.header.certainty == CERTAINTY_RECOVERED &&
        c_mut.count == 5u32 &&
        c_mut.excluded_visibility_count == 1u32 &&
        c_mut.excluded_capability_count == 0u32 &&
        c_mut.ambiguous_trait_count == 2u32 &&
        c_mut.items[0].tier == COMP_TIER_INHERENT_TYPE_MATCH &&
        c_ro.count == 4u32 &&
        c_ro.excluded_capability_count == 1u32 &&
        c_ro.excluded_visibility_count == 1u32 &&
        c_moved.receiver_is_moved &&
        c_moved.receiver_moved_line == 14u32 &&
        c_moved.count == 0u32 &&
        c_moved.excluded_moved_count == 6u32 &&
        c_scope.count == 0u32 &&
        c_scope.excluded_moved_count == 1u32 &&
        ws.codegen_invocations == 0u32
}

fn test_5_hygienic_rename_and_conflicts(ws: mut_view<VfsWorkspace>, eng: mut_view<LspSemanticEngine>, doc_app: u32) -> bool {
    // 1. `prepareRename` on built-in `usize` in `net.ax` (line 2, char 14) must be rejected (`AXS-LSP-043 §1`)
    let prep_builtin = lsp_handle_prepare_rename(mut_view(*eng), mut_view(*ws), 0u32, lsp_pos_new(2u32, 14u32));
    // 2. Rename to reserved keyword `"let"` must be rejected
    let ren_kw = lsp_handle_rename(mut_view(*eng), mut_view(*ws), doc_app, lsp_pos_new(2u32, 13u32), "let");
    // 3. Rename `pkt` to `"existing_local"` in the same function scope must fail with `DIAG_NAME_DUPLICATE` (`AXS-LSP-043 §2`)
    let ren_conflict = lsp_handle_rename(mut_view(*eng), mut_view(*ws), doc_app, lsp_pos_new(2u32, 13u32), "existing_local");
    // 4. Cross-module rename of `push` (at `app.ax` line 3, char 5) to `"append_byte"` updates both `net.ax` and `app.ax`
    let ren_ok = lsp_handle_rename(mut_view(*eng), mut_view(*ws), doc_app, lsp_pos_new(3u32, 5u32), "append_byte");
    let applied = lsp_apply_workspace_rename(mut_view(*eng), mut_view(*ws), view(ren_ok));

    !prep_builtin.can_rename &&
        prep_builtin.error_code == LSP_ERR_INVALID_PARAMS &&
        !ren_kw.accepted &&
        !ren_conflict.accepted &&
        ren_conflict.has_conflict &&
        ren_conflict.conflict_diag_code == DIAG_NAME_DUPLICATE &&
        ren_ok.accepted &&
        !ren_ok.has_conflict &&
        ren_ok.affected_doc_count == 2u32 &&
        ren_ok.edit_count == 2u32 &&
        applied &&
        ws.codegen_invocations == 0u32
}

fn test_7_cli_driver_and_zero_codegen(ws: mut_view<VfsWorkspace>, eng: mut_view<LspSemanticEngine>) -> bool {
    let mut cli = lsp_default_cli_config();
    let a1 = lsp_parse_cli_arg(mut_view(cli), "--stdio");
    let a2 = lsp_parse_cli_arg(mut_view(cli), "--position-encoding=utf-16");
    let a3 = lsp_parse_cli_arg(mut_view(cli), "--inlay-ownership=true");
    let a4 = lsp_parse_cli_arg(mut_view(cli), "--unknown-flag");

    let mut drv = lsp_driver_new(cli);
    lsp_driver_apply_cli(view(drv), mut_view(*ws), mut_view(*eng));
    let mut wire_buf: [512]u8 = [0u8; 512];
    let wp = unsafe { address_of(wire_buf[0]) as *mut u8 };

    let rc_init = lsp_driver_dispatch(mut_view(drv), mut_view(*ws), mut_view(*eng), 1i64, "initialize", 2u32, "", 0i64, "", lsp_pos_new(0u32, 0u32), wp, 512);
    let rc_inited = lsp_driver_dispatch(mut_view(drv), mut_view(*ws), mut_view(*eng), 0i64, "initialized", 2u32, "", 0i64, "", lsp_pos_new(0u32, 0u32), wp, 512);
    let rc_open = lsp_driver_dispatch(mut_view(drv), mut_view(*ws), mut_view(*eng), 0i64, "textDocument/didOpen", 2u32, "file:///main.ax", 1i64, "fn main() {}\n", lsp_pos_new(0u32, 0u32), wp, 512);
    let rc_hov = lsp_driver_dispatch(mut_view(drv), mut_view(*ws), mut_view(*eng), 2i64, "textDocument/hover", 2u32, "file:///main.ax", 1i64, "", lsp_pos_new(0u32, 3u32), wp, 512);
    let rc_tok = lsp_driver_dispatch(mut_view(drv), mut_view(*ws), mut_view(*eng), 3i64, "textDocument/semanticTokens/full", 2u32, "file:///main.ax", 1i64, "", lsp_pos_new(0u32, 0u32), wp, 512);
    let rc_inl = lsp_driver_dispatch(mut_view(drv), mut_view(*ws), mut_view(*eng), 4i64, "textDocument/inlayHint", 2u32, "file:///main.ax", 1i64, "", lsp_pos_new(0u32, 0u32), wp, 512);
    let rc_shut = lsp_driver_dispatch(mut_view(drv), mut_view(*ws), mut_view(*eng), 5i64, "shutdown", 2u32, "", 0i64, "", lsp_pos_new(0u32, 0u32), wp, 512);
    let rc_exit = lsp_driver_dispatch(mut_view(drv), mut_view(*ws), mut_view(*eng), 0i64, "exit", 2u32, "", 0i64, "", lsp_pos_new(0u32, 0u32), wp, 512);

    let zero_cg = lsp_driver_verify_zero_codegen(view(drv), view(*ws));
    let ok = a1 && a2 && a3 && !a4 &&
        cli.invalid_arg_count == 1u32 &&
        rc_init == LSP_ERR_NONE &&
        rc_inited == LSP_ERR_NONE &&
        rc_open == LSP_ERR_NONE &&
        rc_hov == LSP_ERR_NONE &&
        rc_tok == LSP_ERR_NONE &&
        rc_inl == LSP_ERR_NONE &&
        rc_shut == LSP_ERR_NONE &&
        rc_exit == LSP_ERR_NONE &&
        drv.frames_processed == 8u32 &&
        drv.diagnostics_published == 1u32 &&
        zero_cg;

    lsp_driver_free(mut_view(*ws), mut_view(*eng));
    ok
}

fn main() -> i32 {
    let mut ws = vfs_workspace_new();
    let mut eng = lsp_engine_new();
    let doc_app = probe_setup_workspace(mut_view(ws), mut_view(eng));
    probe_populate_candidates_and_recovery(mut_view(ws), mut_view(eng), doc_app);

    if !test_1_diagnostics_and_codes(mut_view(ws), mut_view(eng), doc_app) { return 1; }
    print("100401\n");
    if !test_2_hover_sections_and_layout(mut_view(ws), mut_view(eng), doc_app) { return 2; }
    print("100402\n");
    if !test_3_cross_module_navigation(mut_view(ws), mut_view(eng), doc_app) { return 3; }
    print("100403\n");
    let ok6 = test_6_axcodeeditor_tokens_and_inlays(mut_view(ws), mut_view(eng), doc_app);
    if !test_4_completion_and_ambiguity(mut_view(ws), mut_view(eng), doc_app) { return 4; }
    print("100404\n");
    if !test_5_hygienic_rename_and_conflicts(mut_view(ws), mut_view(eng), doc_app) { return 5; }
    print("100405\n");
    if !ok6 { return 6; }
    print("100406\n");
    if !test_7_cli_driver_and_zero_codegen(mut_view(ws), mut_view(eng)) { return 7; }
    print("100407\n");
    print("0\n");
    0
}
