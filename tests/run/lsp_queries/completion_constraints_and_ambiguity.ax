// test: run
// modes: interp native
// stdout-file: completion_constraints_and_ambiguity.stdout
// E19.1 / T802 Standalone Verification: Constraint-Filtered Completion & Trait Ambiguity
// Verifies SPEC-100 §4.1 (AXS-LSP-040, AXS-LSP-083; REQ-TOOL-188, REQ-TOOL-189)
// across `--interp`, `-O0`, `-O1`, and `-O2 --verify-each`.

const REQ_FIELD: u8 = 1u8;
const REQ_VIEW: u8 = 2u8;
const REQ_MUT_VIEW: u8 = 3u8;

const OWN_OWNED: u8 = 0u8;
const OWN_VIEW: u8 = 1u8;
const OWN_MUT_VIEW: u8 = 2u8;
const OWN_MOVED: u8 = 3u8;

@derive(Copy)
struct Candidate {
    symbol_id: u32,
    def_doc_id: u32,
    is_pub: bool,
    is_cfg_active: bool,
    req_receiver: u8,
    trait_id: u32,
    name_hash: u64,
    result_type_id: u32,
}

@derive(Copy)
struct CandidateTable {
    items: [6]Candidate,
}

@derive(Copy)
struct FilterOutcome {
    included_count: u32,
    excluded_vis: u32,
    excluded_cap: u32,
    excluded_moved: u32,
    excluded_cfg: u32,
    ambiguous_trait_count: u32,
    top_tier_count: u32,
}

fn evaluate_member_completion(
    tbl: view<CandidateTable>,
    caller_doc_id: u32,
    rec_ownership: u8,
    rec_is_mut_binding: bool,
    expected_type_id: u32
) -> FilterOutcome {
    let mut out = FilterOutcome {
        included_count: 0u32,
        excluded_vis: 0u32,
        excluded_cap: 0u32,
        excluded_moved: 0u32,
        excluded_cfg: 0u32,
        ambiguous_trait_count: 0u32,
        top_tier_count: 0u32,
    };

    if rec_ownership == OWN_MOVED {
        out.excluded_moved = 6u32;
        return out;
    }

    let can_mutate = rec_ownership == OWN_MUT_VIEW || (rec_ownership == OWN_OWNED && rec_is_mut_binding);
    let mut i: usize = 0;
    while i < 6 {
        let c = tbl.items[i];
        if !c.is_cfg_active {
            out.excluded_cfg = out.excluded_cfg + 1u32;
        } else if c.def_doc_id != caller_doc_id && !c.is_pub {
            out.excluded_vis = out.excluded_vis + 1u32;
        } else if c.req_receiver == REQ_MUT_VIEW && !can_mutate {
            out.excluded_cap = out.excluded_cap + 1u32;
        } else {
            out.included_count = out.included_count + 1u32;
            if c.trait_id == 0u32 && c.result_type_id == expected_type_id {
                out.top_tier_count = out.top_tier_count + 1u32;
            }
            if c.trait_id > 0u32 {
                let mut j: usize = 0;
                while j < 6 {
                    if j != i && tbl.items[j].trait_id > 0u32 && tbl.items[j].name_hash == c.name_hash && tbl.items[j].trait_id != c.trait_id {
                        out.ambiguous_trait_count = out.ambiguous_trait_count + 1u32;
                        break;
                    }
                    j = j + 1;
                }
            }
        }
        i = i + 1;
    }
    out
}

fn main() -> i32 {
    let cands = CandidateTable {
        items: [
            // 0: `pub len: usize` (inherent field, returns `usize` = 10)
            Candidate { symbol_id: 1u32, def_doc_id: 0u32, is_pub: true, is_cfg_active: true, req_receiver: REQ_FIELD, trait_id: 0u32, name_hash: 101u64, result_type_id: 10u32 },
            // 1: `secret_key: u32` (private field in module 0 -> excluded in module 1)
            Candidate { symbol_id: 2u32, def_doc_id: 0u32, is_pub: false, is_cfg_active: true, req_receiver: REQ_FIELD, trait_id: 0u32, name_hash: 102u64, result_type_id: 20u32 },
            // 2: `pub fn checksum(view<Self>) -> usize`
            Candidate { symbol_id: 3u32, def_doc_id: 0u32, is_pub: true, is_cfg_active: true, req_receiver: REQ_VIEW, trait_id: 0u32, name_hash: 103u64, result_type_id: 10u32 },
            // 3: `pub fn push(mut_view<Self>) -> usize` (requires `mut_view`)
            Candidate { symbol_id: 4u32, def_doc_id: 0u32, is_pub: true, is_cfg_active: true, req_receiver: REQ_MUT_VIEW, trait_id: 0u32, name_hash: 104u64, result_type_id: 10u32 },
            // 4: `Serializable.format(view<Self>)` (trait 1, name_hash 555)
            Candidate { symbol_id: 5u32, def_doc_id: 0u32, is_pub: true, is_cfg_active: true, req_receiver: REQ_VIEW, trait_id: 1u32, name_hash: 555u64, result_type_id: 30u32 },
            // 5: `DebugFormat.format(view<Self>)` (trait 2, name_hash 555 -> ambiguous with trait 1!)
            Candidate { symbol_id: 6u32, def_doc_id: 0u32, is_pub: true, is_cfg_active: true, req_receiver: REQ_VIEW, trait_id: 2u32, name_hash: 555u64, result_type_id: 30u32 },
        ],
    };

    // 1. Read-only `view<Packet>` receiver in module 1: excludes `secret_key` (visibility) and `push` (capability)
    let ro_out = evaluate_member_completion(view(cands), 1u32, OWN_VIEW, false, 10u32);
    if ro_out.included_count != 4u32 || ro_out.excluded_vis != 1u32 || ro_out.excluded_cap != 1u32 || ro_out.ambiguous_trait_count != 2u32 {
        return 1;
    }
    print("200403\n");

    // 2. Mutable `mut_view<Packet>` receiver in module 1: includes `push`, excludes only `secret_key`
    let rw_out = evaluate_member_completion(view(cands), 1u32, OWN_MUT_VIEW, true, 10u32);
    if rw_out.included_count != 5u32 || rw_out.excluded_vis != 1u32 || rw_out.excluded_cap != 0u32 || rw_out.top_tier_count != 3u32 {
        return 2;
    }
    print("200404\n");

    // 3. Moved `Packet` receiver in module 1: all 6 candidates excluded due to move liveness
    let mv_out = evaluate_member_completion(view(cands), 1u32, OWN_MOVED, true, 10u32);
    if mv_out.included_count != 0u32 || mv_out.excluded_moved != 6u32 {
        return 3;
    }
    print("200405\n");
    print("0\n");
    0
}
