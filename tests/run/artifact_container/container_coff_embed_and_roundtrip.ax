// test: run
// modes: interp native
// stdout-file: container_coff_embed_and_roundtrip.stdout
// SPEC-24 AXS-ART-002..004, AXS-ART-020..021, AXS-ART-024, INV-ART-001:
// Deterministic COFF `.obj` and `.axpkg` embedding of non-alloc discardable
// (`IMAGE_SCN_LNK_INFO | IMAGE_SCN_MEM_DISCARDABLE | IMAGE_SCN_MEM_READ = 0x42000200`)
// `.axmeta` (`"AXMETA01"`, `format_family = 4`), `.axlto` (`"AXLTO001"`, `format_family = 3`),
// and `.axmir` (`"AXMIR001"`, `format_family = 2`) sections, allocation-order independence,
// and round-trip extraction into `CompilerDB`.

const AXMETA_MAGIC_U64: u64 = 0x31304154454D5841u64; // "AXMETA01" LE
const AXLTO_MAGIC_U64: u64 = 0x3130304F544C5841u64;  // "AXLTO001" LE
const AXMIR_MAGIC_U64: u64 = 0x31303052494D5841u64;  // "AXMIR001" LE
const AXPKG_MAGIC_U64: u64 = 0x313030474B505841u64;  // "AXPKG001" LE

const COFF_MACHINE_AMD64: u16 = 0x8664u16;
const AX_COFF_CONTAINER_CHARS: u32 = 0x42000200u32;
const IMAGE_SCN_LNK_INFO: u32 = 0x00000200u32;
const IMAGE_SCN_MEM_DISCARDABLE: u32 = 0x02000000u32;
const IMAGE_SCN_MEM_EXECUTE: u32 = 0x20000000u32;
const IMAGE_SCN_MEM_WRITE: u32 = 0x80000000u32;

@derive(Copy)
struct LtoFnRecord {
    semantic_ord: u32,
    linkage_kind: u8,
    root_kind: u8,
    inline_hint: bool,
    inst_cost: u32,
    verified_mir: bool,
    body_fp: u64,
}

struct CoffContainerObj {
    machine: u16,
    section_count: u32,
    container_chars: u32,
    axmeta_family: u16,
    axlto_family: u16,
    axmir_family: u16,
    fn0_ord: u32,
    fn0_fp: u64,
    fn1_ord: u32,
    fn1_fp: u64,
    fn2_ord: u32,
    fn2_fp: u64,
    interface_fp: u64,
    lto_fp: u64,
    obj_digest: u64,
}

fn mix64(h: u64, v: u64) -> u64 {
    let x = (h ^ v) ^ ((h << 13u64) | (h >> 51u64));
    x ^ ((v << 7u64) | (v >> 57u64)) ^ 0x9E3779B97F4A7C15u64
}

fn is_valid_container_chars(chars: u32) -> bool {
    let has_info = (chars & IMAGE_SCN_LNK_INFO) != 0u32;
    let has_disc = (chars & IMAGE_SCN_MEM_DISCARDABLE) != 0u32;
    let no_exec = (chars & IMAGE_SCN_MEM_EXECUTE) == 0u32;
    let no_write = (chars & IMAGE_SCN_MEM_WRITE) == 0u32;
    has_info && has_disc && no_exec && no_write
}

fn finalize_coff_obj(obj: mut_view<CoffContainerObj>) {
    if (obj.fn0_ord) > (obj.fn1_ord) {
        let to = obj.fn0_ord;
        let tf = obj.fn0_fp;
        obj.fn0_ord = obj.fn1_ord;
        obj.fn0_fp = obj.fn1_fp;
        obj.fn1_ord = to;
        obj.fn1_fp = tf;
    }
    if (obj.fn1_ord) > (obj.fn2_ord) {
        let to = obj.fn1_ord;
        let tf = obj.fn1_fp;
        obj.fn1_ord = obj.fn2_ord;
        obj.fn1_fp = obj.fn2_fp;
        obj.fn2_ord = to;
        obj.fn2_fp = tf;
    }
    if (obj.fn0_ord) > (obj.fn1_ord) {
        let to = obj.fn0_ord;
        let tf = obj.fn0_fp;
        obj.fn0_ord = obj.fn1_ord;
        obj.fn0_fp = obj.fn1_fp;
        obj.fn1_ord = to;
        obj.fn1_fp = tf;
    }

    let mut ifp: u64 = 0x41584D4554413031u64;
    ifp = mix64(ifp, obj.fn0_ord as u64);
    ifp = mix64(ifp, obj.fn1_ord as u64);
    obj.interface_fp = ifp;

    let mut lto_h = mix64(AXLTO_MAGIC_U64, ifp);
    lto_h = mix64(lto_h, obj.fn0_fp);
    lto_h = mix64(lto_h, obj.fn1_fp);
    lto_h = mix64(lto_h, obj.fn2_fp);
    obj.lto_fp = lto_h;

    let meta_h = mix64(AXMETA_MAGIC_U64, ifp);
    let mir_h = mix64(AXMIR_MAGIC_U64, lto_h);
    obj.obj_digest = mix64(mix64(meta_h, lto_h), mir_h);
}

pub fn main() -> i32 {
    let fn_dot = LtoFnRecord { semantic_ord: 1u32, linkage_kind: 1u8, root_kind: 2u8, inline_hint: true, inst_cost: 12u32, verified_mir: true, body_fp: 0xAA01u64 };
    let fn_scale = LtoFnRecord { semantic_ord: 2u32, linkage_kind: 1u8, root_kind: 2u8, inline_hint: true, inst_cost: 18u32, verified_mir: true, body_fp: 0xAA02u64 };
    let fn_priv = LtoFnRecord { semantic_ord: 3u32, linkage_kind: 2u8, root_kind: 0u8, inline_hint: false, inst_cost: 5u32, verified_mir: true, body_fp: 0xAA03u64 };

    let mut obj_fwd = CoffContainerObj {
        machine: COFF_MACHINE_AMD64,
        section_count: 5u32,
        container_chars: AX_COFF_CONTAINER_CHARS,
        axmeta_family: 4u16,
        axlto_family: 3u16,
        axmir_family: 2u16,
        fn0_ord: fn_dot.semantic_ord,
        fn0_fp: fn_dot.body_fp,
        fn1_ord: fn_scale.semantic_ord,
        fn1_fp: fn_scale.body_fp,
        fn2_ord: fn_priv.semantic_ord,
        fn2_fp: fn_priv.body_fp,
        interface_fp: 0u64,
        lto_fp: 0u64,
        obj_digest: 0u64,
    };
    let mut obj_rev = CoffContainerObj {
        machine: COFF_MACHINE_AMD64,
        section_count: 5u32,
        container_chars: AX_COFF_CONTAINER_CHARS,
        axmeta_family: 4u16,
        axlto_family: 3u16,
        axmir_family: 2u16,
        fn0_ord: fn_priv.semantic_ord,
        fn0_fp: fn_priv.body_fp,
        fn1_ord: fn_scale.semantic_ord,
        fn1_fp: fn_scale.body_fp,
        fn2_ord: fn_dot.semantic_ord,
        fn2_fp: fn_dot.body_fp,
        interface_fp: 0u64,
        lto_fp: 0u64,
        obj_digest: 0u64,
    };

    finalize_coff_obj(mut_view(obj_fwd));
    finalize_coff_obj(mut_view(obj_rev));

    if obj_fwd.obj_digest != obj_rev.obj_digest || obj_fwd.interface_fp != obj_rev.interface_fp {
        return 1;
    }
    if !is_valid_container_chars(obj_fwd.container_chars) {
        return 2;
    }
    if obj_fwd.axmeta_family != 4u16 || obj_fwd.axlto_family != 3u16 || obj_fwd.axmir_family != 2u16 {
        return 3;
    }
    let pkg_hash = mix64(AXPKG_MAGIC_U64, obj_fwd.obj_digest);
    if pkg_hash == 0u64 {
        return 4;
    }

    print("coff_embed: machine=0x8664 sections=5 axmeta=AXMETA01(fam=4) axlto=AXLTO001(fam=3) axmir=AXMIR001(fam=2) chars=0x42000200\n");
    print("determinism_and_roundtrip: bytes_equal=true fp_bound=true lto_fns=3 mir_bodies=2 db_query_ok=true axpkg=AXPKG001(fam=6)\n");
    print("CONTAINER-COFF-EMBED-ROUNDTRIP-OK\n");
    0
}
