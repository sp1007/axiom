// test: run
// modes: interp native
// stdout-file: container_archive_foreign_and_bounds_seam.stdout
// SPEC-24 AXS-ART-020..021, REQ-LNK-476:
// COFF `.lib` static archive (`!<arch>\n`) container extraction, mixed linking of
// Axiom `.obj` (carrying `.axmeta` + `.axlto`) and foreign C `.obj` (without `.axmeta` / `.axlto`),
// and fail-closed boundary seam checks (truncated COFF header, out-of-bounds section
// `PointerToRawData`, corrupt archive member header, and `.axlto` without `.axmeta`).

const STATUS_OK: u32 = 0u32;
const AX_ART_CORRUPT_HEADER: u32 = 9501u32;

const AR_MAGIC_U64: u64 = 0x0A3E686372613C21u64; // "!<arch>\n" LE
const AR_FMAG_U16: u16 = 0x0A60u16;              // "`\n" LE

@derive(Copy)
struct ArchiveMemberDesc {
    member_size: u32,
    fmag: u16,
    coff_len: u32,
    sec0_raw_ptr: u32,
    sec0_raw_size: u32,
    has_axmeta: bool,
    has_axlto: bool,
}

@derive(Copy)
struct ArchiveScanSummary {
    status: u32,
    member_count: u32,
    axiom_objs: u32,
    foreign_objs: u32,
    extracted_axmeta: u32,
    extracted_axlto: u32,
}

fn check_bounds_u64(offset: u64, size: u64, total_size: u64) -> bool {
    if offset > total_size || size > total_size {
        return false;
    }
    if size > (total_size - offset) {
        return false;
    }
    true
}

fn validate_coff_member(m: ArchiveMemberDesc) -> u32 {
    if m.fmag != AR_FMAG_U16 {
        return AX_ART_CORRUPT_HEADER;
    }
    if (m.coff_len) < 20u32 {
        return AX_ART_CORRUPT_HEADER;
    }
    if !check_bounds_u64(m.sec0_raw_ptr as u64, m.sec0_raw_size as u64, m.coff_len as u64) {
        return AX_ART_CORRUPT_HEADER;
    }
    // AXS-ART-020: An object file carrying `.axlto` MUST also carry `.axmeta`
    if m.has_axlto && !m.has_axmeta {
        return AX_ART_CORRUPT_HEADER;
    }
    STATUS_OK
}

fn scan_archive_pair(ar_magic: u64, m0: ArchiveMemberDesc, m1: ArchiveMemberDesc) -> ArchiveScanSummary {
    if ar_magic != AR_MAGIC_U64 {
        return ArchiveScanSummary { status: AX_ART_CORRUPT_HEADER, member_count: 0u32, axiom_objs: 0u32, foreign_objs: 0u32, extracted_axmeta: 0u32, extracted_axlto: 0u32 };
    }
    let st0 = validate_coff_member(m0);
    if st0 != STATUS_OK {
        return ArchiveScanSummary { status: st0, member_count: 0u32, axiom_objs: 0u32, foreign_objs: 0u32, extracted_axmeta: 0u32, extracted_axlto: 0u32 };
    }
    let st1 = validate_coff_member(m1);
    if st1 != STATUS_OK {
        return ArchiveScanSummary { status: st1, member_count: 1u32, axiom_objs: 0u32, foreign_objs: 0u32, extracted_axmeta: 0u32, extracted_axlto: 0u32 };
    }

    let mut ax_objs: u32 = 0u32;
    let mut fg_objs: u32 = 0u32;
    let mut meta_cnt: u32 = 0u32;
    let mut lto_cnt: u32 = 0u32;

    if m0.has_axmeta {
        ax_objs = ax_objs + 1u32;
        meta_cnt = meta_cnt + 1u32;
    } else {
        fg_objs = fg_objs + 1u32;
    }
    if m0.has_axlto { lto_cnt = lto_cnt + 1u32; }

    if m1.has_axmeta {
        ax_objs = ax_objs + 1u32;
        meta_cnt = meta_cnt + 1u32;
    } else {
        fg_objs = fg_objs + 1u32;
    }
    if m1.has_axlto { lto_cnt = lto_cnt + 1u32; }

    ArchiveScanSummary {
        status: STATUS_OK,
        member_count: 2u32,
        axiom_objs: ax_objs,
        foreign_objs: fg_objs,
        extracted_axmeta: meta_cnt,
        extracted_axlto: lto_cnt,
    }
}

pub fn main() -> i32 {
    let m_axiom = ArchiveMemberDesc {
        member_size: 1024u32,
        fmag: AR_FMAG_U16,
        coff_len: 1024u32,
        sec0_raw_ptr: 180u32,
        sec0_raw_size: 80u32,
        has_axmeta: true,
        has_axlto: true,
    };
    // Foreign C object without `.axmeta` or `.axlto` (REQ-LNK-476)
    let m_foreign = ArchiveMemberDesc {
        member_size: 204u32,
        fmag: AR_FMAG_U16,
        coff_len: 204u32,
        sec0_raw_ptr: 100u32,
        sec0_raw_size: 48u32,
        has_axmeta: false,
        has_axlto: false,
    };

    let ok_scan = scan_archive_pair(AR_MAGIC_U64, m_axiom, m_foreign);
    if ok_scan.status != STATUS_OK || ok_scan.member_count != 2u32 ||
        ok_scan.axiom_objs != 1u32 || ok_scan.foreign_objs != 1u32 ||
        ok_scan.extracted_axmeta != 1u32 || ok_scan.extracted_axlto != 1u32 {
        return 1;
    }

    // 1. Truncated COFF `.obj` header (< 20 bytes)
    let mut m_trunc = m_axiom;
    m_trunc.coff_len = 10u32;
    if validate_coff_member(m_trunc) != AX_ART_CORRUPT_HEADER {
        return 2;
    }

    // 2. Out-of-bounds COFF section `PointerToRawData`
    let mut m_oob = m_axiom;
    m_oob.sec0_raw_ptr = 0x00FFFFFFu32;
    if validate_coff_member(m_oob) != AX_ART_CORRUPT_HEADER {
        return 3;
    }

    // 3. Corrupt archive member header terminator (`fmag`)
    let mut m_bad_ar = m_foreign;
    m_bad_ar.fmag = 0x0000u16;
    if scan_archive_pair(AR_MAGIC_U64, m_axiom, m_bad_ar).status != AX_ART_CORRUPT_HEADER {
        return 4;
    }

    // 4. `.axlto` present without `.axmeta` -> rejected (`AXS-ART-020`)
    let mut m_lto_only = m_foreign;
    m_lto_only.has_axlto = true;
    m_lto_only.has_axmeta = false;
    if validate_coff_member(m_lto_only) != AX_ART_CORRUPT_HEADER {
        return 5;
    }

    print("coff_archive: magic=!<arch> members=2 axiom_objs=1 foreign_objs=1 extracted_axmeta=1 extracted_axlto=1\n");
    print("bounds_seam: trunc_coff=AX_ART_CORRUPT_HEADER oob_raw_ptr=AX_ART_CORRUPT_HEADER bad_ar_hdr=AX_ART_CORRUPT_HEADER lto_without_meta=AX_ART_CORRUPT_HEADER\n");
    print("CONTAINER-ARCHIVE-FOREIGN-BOUNDS-SEAM-OK\n");
    0
}
