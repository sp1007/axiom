fn init_probe_ascii_buf(abuf: mut_view<AxmiBuffer>) {
    axmi_buf_init(mut_view(*abuf), 1024);
    let mut i: usize = 0;
    while i < 975 {
        axmi_buf_push_u8(mut_view(*abuf), PROBE_ASCII_TABLE[i]);
        i = i + 1;
    }
    axmi_buf_push_u8(mut_view(*abuf), 0u8); // index 975
    // opcodes_dot at 976..980
    axmi_buf_push_u8(mut_view(*abuf), 0x10u8);
    axmi_buf_push_u8(mut_view(*abuf), 0x20u8);
    axmi_buf_push_u8(mut_view(*abuf), 0x31u8);
    axmi_buf_push_u8(mut_view(*abuf), 0xFFu8);
    // opcodes_scale at 980..985
    axmi_buf_push_u8(mut_view(*abuf), 0x11u8);
    axmi_buf_push_u8(mut_view(*abuf), 0x22u8);
    axmi_buf_push_u8(mut_view(*abuf), 0x44u8);
    axmi_buf_push_u8(mut_view(*abuf), 0x55u8);
    axmi_buf_push_u8(mut_view(*abuf), 0xFFu8);
    // ops_render at 985..989
    axmi_buf_push_u8(mut_view(*abuf), 0x40u8);
    axmi_buf_push_u8(mut_view(*abuf), 0x41u8);
    axmi_buf_push_u8(mut_view(*abuf), 0x42u8);
    axmi_buf_push_u8(mut_view(*abuf), 0xFFu8);
}

fn probe_sv(abuf: view<AxmiBuffer>, start: usize, count: usize) -> StrView {
    StrView {
        ptr: unsafe { (abuf.ptr as *const u8) + start },
        len: count,
    }
}

fn probe_push_slice(out: mut_view<DiagBuffer>, start: usize, count: usize) {
    let mut i: usize = 0;
    while i < count {
        diag_buf_push_byte(mut_view(*out), PROBE_ASCII_TABLE[start + i]);
        i = i + 1;
    }
}

fn populate_math_unit(
    abuf: view<AxmiBuffer>,
    iface: mut_view<AxmiModuleInterface>,
    lto: mut_view<AxLtoContainer>,
    reverse_order: bool
) {
    let pkg = probe_sv(abuf, 0, 9);     // "core_math"
    let modp = probe_sv(abuf, 9, 13);   // "core_math.vec"
    let trp = probe_sv(abuf, 22, 22);   // "x86_64-pc-windows-msvc"
    let abi = probe_sv(abuf, 44, 12);   // "win64-abi-v1"
    let empty_sv = probe_sv(abuf, 0, 0);

    axmi_set_module_identity(
        mut_view(*iface),
        pkg,
        modp,
        trp,
        abi,
        8u32,
        true,
        0x03u32,
        AXMI_PANIC_NO_PANIC
    );

    let sk_vec2 = semantic_key_new(pkg, modp, ITEM_NS_TYPE, 0u32, probe_sv(abuf, 56, 4), empty_sv);
    let sk_dot = semantic_key_new(pkg, modp, ITEM_NS_VALUE, 0u32, probe_sv(abuf, 60, 8), empty_sv);
    let sk_scale = semantic_key_new(pkg, modp, ITEM_NS_VALUE, 0u32, probe_sv(abuf, 68, 10), probe_sv(abuf, 89, 1));
    let sk_priv = semantic_key_new(pkg, modp, ITEM_NS_VALUE, 0u32, probe_sv(abuf, 78, 11), empty_sv);
    let sk_max = semantic_key_new(pkg, modp, ITEM_NS_CONST, 0u32, probe_sv(abuf, 90, 7), empty_sv);

    let opcodes_dot_ptr = unsafe { (abuf.ptr as *const u8) + 976 };
    let opcodes_scale_ptr = unsafe { (abuf.ptr as *const u8) + 980 };

    if !reverse_order {
        let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 10u32 }, ITEM_KIND_STRUCT, true, false, false, false, 0u32, TypeId { v: 1u32 }, 0u32, 0u8, sk_vec2);
        let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 11u32 }, ITEM_KIND_FN, true, false, true, false, 2u32, TypeId { v: 2u32 }, 0u32, 1u8, sk_dot);
        let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 12u32 }, ITEM_KIND_FN, true, true, true, false, 2u32, TypeId { v: 1u32 }, 1u32, 1u8, sk_scale);
        let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 13u32 }, ITEM_KIND_FN, false, false, false, false, 1u32, TypeId { v: 2u32 }, 0u32, 1u8, sk_priv);
        let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 14u32 }, ITEM_KIND_CONST, true, false, false, true, 0u32, TypeId { v: 2u32 }, 0u32, 0u8, sk_max);

        axlto_add_fn_summary(mut_view(*lto), DefId { v: 11u32 }, AXLTO_LINK_PUBLIC, AXLTO_ROOT_EXPORTED, AXMI_PANIC_NO_PANIC, true, 6u32, 12u32, AXMI_EFF_PURE, AXMI_CAP_NONE, 3u32, 3u32, 0x1001u64, 0xAA01u64, sk_dot);
        axlto_add_fn_summary(mut_view(*lto), DefId { v: 12u32 }, AXLTO_LINK_PUBLIC, AXLTO_ROOT_EXPORTED, AXMI_PANIC_NO_PANIC, true, 9u32, 18u32, AXMI_EFF_READS_MEM, AXMI_CAP_NONE, 1u32, 1u32, 0x1002u64, 0xAA02u64, sk_scale);
        axlto_add_fn_summary(mut_view(*lto), DefId { v: 13u32 }, AXLTO_LINK_INTERNAL, AXLTO_ROOT_NONE, AXMI_PANIC_NO_PANIC, false, 4u32, 5u32, AXMI_EFF_PURE, AXMI_CAP_NONE, 1u32, 1u32, 0x1003u64, 0xAA03u64, sk_priv);

        axlto_add_mir_body(mut_view(*lto), DefId { v: 11u32 }, MirBodyId { v: 1u32 }, AXMI_MIR_SCHEMA_VERSION, false, true, false, true, 2u32, 2u32, 4u32, 6u32, opcodes_dot_ptr, 4u32, sk_dot);
        axlto_add_mir_body(mut_view(*lto), DefId { v: 12u32 }, MirBodyId { v: 2u32 }, AXMI_MIR_SCHEMA_VERSION, true, true, false, true, 2u32, 3u32, 5u32, 9u32, opcodes_scale_ptr, 5u32, sk_scale);
    } else {
        let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 14u32 }, ITEM_KIND_CONST, true, false, false, true, 0u32, TypeId { v: 2u32 }, 0u32, 0u8, sk_max);
        let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 13u32 }, ITEM_KIND_FN, false, false, false, false, 1u32, TypeId { v: 2u32 }, 0u32, 1u8, sk_priv);
        let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 12u32 }, ITEM_KIND_FN, true, true, true, false, 2u32, TypeId { v: 1u32 }, 1u32, 1u8, sk_scale);
        let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 11u32 }, ITEM_KIND_FN, true, false, true, false, 2u32, TypeId { v: 2u32 }, 0u32, 1u8, sk_dot);
        let _ = axmi_add_symbol(mut_view(*iface), DefId { v: 10u32 }, ITEM_KIND_STRUCT, true, false, false, false, 0u32, TypeId { v: 1u32 }, 0u32, 0u8, sk_vec2);

        axlto_add_fn_summary(mut_view(*lto), DefId { v: 13u32 }, AXLTO_LINK_INTERNAL, AXLTO_ROOT_NONE, AXMI_PANIC_NO_PANIC, false, 4u32, 5u32, AXMI_EFF_PURE, AXMI_CAP_NONE, 1u32, 1u32, 0x1003u64, 0xAA03u64, sk_priv);
        axlto_add_fn_summary(mut_view(*lto), DefId { v: 12u32 }, AXLTO_LINK_PUBLIC, AXLTO_ROOT_EXPORTED, AXMI_PANIC_NO_PANIC, true, 9u32, 18u32, AXMI_EFF_READS_MEM, AXMI_CAP_NONE, 1u32, 1u32, 0x1002u64, 0xAA02u64, sk_scale);
        axlto_add_fn_summary(mut_view(*lto), DefId { v: 11u32 }, AXLTO_LINK_PUBLIC, AXLTO_ROOT_EXPORTED, AXMI_PANIC_NO_PANIC, true, 6u32, 12u32, AXMI_EFF_PURE, AXMI_CAP_NONE, 3u32, 3u32, 0x1001u64, 0xAA01u64, sk_dot);

        axlto_add_mir_body(mut_view(*lto), DefId { v: 12u32 }, MirBodyId { v: 2u32 }, AXMI_MIR_SCHEMA_VERSION, true, true, false, true, 2u32, 3u32, 5u32, 9u32, opcodes_scale_ptr, 5u32, sk_scale);
        axlto_add_mir_body(mut_view(*lto), DefId { v: 11u32 }, MirBodyId { v: 1u32 }, AXMI_MIR_SCHEMA_VERSION, false, true, false, true, 2u32, 2u32, 4u32, 6u32, opcodes_dot_ptr, 4u32, sk_dot);
    }

    axmi_add_type_def(mut_view(*iface), TypeId { v: 1u32 }, DefId { v: 10u32 }, AXMI_ADT_STRUCT, AXMI_REPR_C, 16u32, 8u32, true, true, true, sk_vec2);
    axmi_add_type_field(mut_view(*iface), TypeId { v: 1u32 }, TypeId { v: 2u32 });
    axmi_add_type_field(mut_view(*iface), TypeId { v: 1u32 }, TypeId { v: 2u32 });

    axmi_add_fn_contract(mut_view(*iface), DefId { v: 11u32 }, 2u32, 0u32, 3u32, AXMI_EFF_PURE, AXMI_CAP_NONE, AXMI_PANIC_NO_PANIC, sk_dot);
    axmi_add_const_val(mut_view(*iface), ConstEvalKey { v: 1u32 }, DefId { v: 14u32 }, TypeId { v: 2u32 }, AXMI_CONST_INT, 256i64, 0u64, empty_sv, sk_max);
    let _ = axmi_add_mir_template(mut_view(*iface), DefId { v: 12u32 }, MirBodyId { v: 2u32 }, AXMI_MIR_SCHEMA_VERSION, true, true, false, 1u32, 2u32, 3u32, 5u32, 9u32, true, ConstEvalKey { v: 1u32 }, DefId { v: 0u32 }, 0xAA02u64, sk_scale);

    axlto_add_call_edge(mut_view(*lto), DefId { v: 12u32 }, DefId { v: 11u32 }, 2u32, 90u32, true, true, sk_dot);
}

fn run_case_1(abuf: view<AxmiBuffer>, out: mut_view<DiagBuffer>) {
    probe_push_slice(mut_view(*out), 183, 59); // "=== CASE 1: ..."

    let mut iface_a = axmi_interface_empty();
    let mut lto_a = axlto_container_empty();
    let mut iface_b = axmi_interface_empty();
    let mut lto_b = axlto_container_empty();
    axmi_interface_init(mut_view(iface_a));
    axlto_container_init(mut_view(lto_a));
    axmi_interface_init(mut_view(iface_b));
    axlto_container_init(mut_view(lto_b));

    populate_math_unit(abuf, mut_view(iface_a), mut_view(lto_a), false);
    populate_math_unit(abuf, mut_view(iface_b), mut_view(lto_b), true);

    let mut obj_a = axmi_buf_empty();
    let mut obj_b = axmi_buf_empty();
    axmi_buf_init(mut_view(obj_a), 2048);
    axmi_buf_init(mut_view(obj_b), 2048);

    container_write_axiom_coff_obj(mut_view(iface_a), mut_view(lto_a), true, 64, 32, mut_view(obj_a));
    container_write_axiom_coff_obj(mut_view(iface_b), mut_view(lto_b), true, 64, 32, mut_view(obj_b));

    let det_eq = axmi_buf_eq(view(obj_a), view(obj_b));
    probe_push_slice(mut_view(*out), 422, 28); // "determinism_obj_bytes_equal="
    axmi_push_bool(mut_view(*out), det_eq);
    probe_push_slice(mut_view(*out), 450, 5); // " len="
    diag_buf_push_u32(mut_view(*out), obj_a.len as u32);
    diag_buf_push_byte(mut_view(*out), 10u8);

    // Round-trip extract `.axmeta` and `.axlto` from `obj_a`
    let exp_tgt = axmi_target_expectation_new(probe_sv(abuf, 22, 22), probe_sv(abuf, 44, 12), 8u32, true, 0x03u32, AXMI_PANIC_NO_PANIC);
    let mut loaded_meta = axmi_interface_empty();
    let mut loaded_lto = axlto_container_empty();
    axmi_interface_init(mut_view(loaded_meta));
    axlto_container_init(mut_view(loaded_lto));

    let eres = container_extract_coff_obj(
        obj_a.ptr as *const u8,
        obj_a.len,
        view(exp_tgt),
        mut_view(loaded_meta),
        mut_view(loaded_lto)
    );
    container_inspect_obj_dump(view(eres), view(loaded_meta), view(loaded_lto), mut_view(*out));

    // Ingest extracted `.axmeta` into a fresh `CompilerDB` and verify source-free query execution
    let mut db = query_db_empty();
    query_db_init(mut_view(db), 501u64);
    let ing_ok = axmi_populate_compiler_db(mut_view(db), view(loaded_meta), ModuleId { v: 2u32 }, PackageId { v: 1u32 }, UnitKey { v: 1u32 });
    let sig_res = query_item_signature(mut_view(db), DefId { v: 11u32 });
    let lay_res = query_layout_of(mut_view(db), TypeId { v: 1u32 });
    let db_ok = ing_ok && sig_res.param_count == 2u32 && lay_res.size_bytes == 16u32 && lay_res.align_bytes == 8u32 && db.total_provider_runs == 0u32;
    probe_push_slice(mut_view(*out), 455, 29); // "axmeta_extracted_db_query_ok="
    axmi_push_bool(mut_view(*out), db_ok);
    diag_buf_push_byte(mut_view(*out), 10u8);
    query_db_free(mut_view(db));

    // Pack and unpack standalone `.axpkg` semantic package container
    let mut pkg_buf = axmi_buf_empty();
    axmi_buf_init(mut_view(pkg_buf), 4096);
    let _ = axpkg_serialize(mut_view(iface_a), mut_view(lto_a), obj_a.ptr as *const u8, obj_a.len, mut_view(pkg_buf));

    let mut pkg_meta = axmi_interface_empty();
    let mut pkg_lto = axlto_container_empty();
    axmi_interface_init(mut_view(pkg_meta));
    axlto_container_init(mut_view(pkg_lto));
    let pres = axpkg_deserialize(pkg_buf.ptr as *const u8, pkg_buf.len, view(exp_tgt), mut_view(pkg_meta), mut_view(pkg_lto));
    container_inspect_pkg_dump(view(pres), mut_view(*out));

    axmi_interface_free(mut_view(pkg_meta));
    axlto_container_free(mut_view(pkg_lto));
    axmi_buf_free(mut_view(pkg_buf));
    axmi_interface_free(mut_view(loaded_meta));
    axlto_container_free(mut_view(loaded_lto));
    axmi_buf_free(mut_view(obj_a));
    axmi_buf_free(mut_view(obj_b));
    axmi_interface_free(mut_view(iface_a));
    axlto_container_free(mut_view(lto_a));
    axmi_interface_free(mut_view(iface_b));
    axlto_container_free(mut_view(lto_b));
}

fn run_case_2(abuf: view<AxmiBuffer>, out: mut_view<DiagBuffer>) {
    probe_push_slice(mut_view(*out), 242, 63); // "=== CASE 2: ..."

    let mut iface = axmi_interface_empty();
    let mut lto = axlto_container_empty();
    axmi_interface_init(mut_view(iface));
    axlto_container_init(mut_view(lto));
    populate_math_unit(abuf, mut_view(iface), mut_view(lto), false);

    let mut meta_buf = axmi_buf_empty();
    let mut lto_buf = axmi_buf_empty();
    axmi_buf_init(mut_view(meta_buf), 1024);
    axmi_buf_init(mut_view(lto_buf), 1024);
    let _ = axmeta_serialize(mut_view(iface), mut_view(meta_buf));
    axlto_bind_to_interface(mut_view(lto), view(iface));
    let _ = axlto_serialize(mut_view(lto), mut_view(lto_buf));

    let any_tgt = axmi_target_expectation_any();
    let mut out_m = axmi_interface_empty();
    let mut out_l = axlto_container_empty();
    axmi_interface_init(mut_view(out_m));
    axlto_container_init(mut_view(out_l));

    // 1. Corrupted `.axmeta` magic inside COFF `.obj`
    let mut bad_meta = axmi_buf_empty();
    let mut obj_buf = axmi_buf_empty();
    axmi_buf_init(mut_view(bad_meta), 1024);
    axmi_buf_init(mut_view(obj_buf), 2048);
    axmi_buf_push_bytes(mut_view(bad_meta), meta_buf.ptr as *const u8, meta_buf.len);
    unsafe { *(bad_meta.ptr + 0) = 88u8; } // 'X'
    container_write_coff_obj_ex(0 as *const u8, 32, 0 as *const u8, 0, bad_meta.ptr as *const u8, bad_meta.len, lto_buf.ptr as *const u8, lto_buf.len, 0 as *const u8, 0, AX_COFF_CONTAINER_CHARS, 1u32, mut_view(obj_buf));
    let r1 = container_extract_coff_obj(obj_buf.ptr as *const u8, obj_buf.len, view(any_tgt), mut_view(out_m), mut_view(out_l));
    container_emit_diag(r1.status, r1.found_version, r1.bad_section_type, probe_sv(abuf, 484, 20), mut_view(*out));

    // 2. Corrupted `.axlto` magic inside COFF `.obj`
    let mut bad_lto = axmi_buf_empty();
    axmi_buf_init(mut_view(bad_lto), 1024);
    axmi_buf_push_bytes(mut_view(bad_lto), lto_buf.ptr as *const u8, lto_buf.len);
    unsafe { *(bad_lto.ptr + 0) = 90u8; } // 'Z'
    container_write_coff_obj_ex(0 as *const u8, 32, 0 as *const u8, 0, meta_buf.ptr as *const u8, meta_buf.len, bad_lto.ptr as *const u8, bad_lto.len, 0 as *const u8, 0, AX_COFF_CONTAINER_CHARS, 1u32, mut_view(obj_buf));
    let r2 = container_extract_coff_obj(obj_buf.ptr as *const u8, obj_buf.len, view(any_tgt), mut_view(out_m), mut_view(out_l));
    container_emit_diag(r2.status, r2.found_version, r2.bad_section_type, probe_sv(abuf, 504, 19), mut_view(*out));

    // 3. `.axmeta` schema_version mismatch (99)
    bad_meta.len = 0;
    axmi_buf_push_bytes(mut_view(bad_meta), meta_buf.ptr as *const u8, meta_buf.len);
    unsafe {
        *(bad_meta.ptr + 10) = 99u8;
        *(bad_meta.ptr + 11) = 0u8;
    }
    container_write_coff_obj_ex(0 as *const u8, 32, 0 as *const u8, 0, bad_meta.ptr as *const u8, bad_meta.len, lto_buf.ptr as *const u8, lto_buf.len, 0 as *const u8, 0, AX_COFF_CONTAINER_CHARS, 1u32, mut_view(obj_buf));
    let r3 = container_extract_coff_obj(obj_buf.ptr as *const u8, obj_buf.len, view(any_tgt), mut_view(out_m), mut_view(out_l));
    container_emit_diag(r3.status, r3.found_version, r3.bad_section_type, probe_sv(abuf, 523, 23), mut_view(*out));

    // 4. `.axlto` schema_version mismatch (77)
    bad_lto.len = 0;
    axmi_buf_push_bytes(mut_view(bad_lto), lto_buf.ptr as *const u8, lto_buf.len);
    unsafe {
        *(bad_lto.ptr + 10) = 77u8;
        *(bad_lto.ptr + 11) = 0u8;
    }
    container_write_coff_obj_ex(0 as *const u8, 32, 0 as *const u8, 0, meta_buf.ptr as *const u8, meta_buf.len, bad_lto.ptr as *const u8, bad_lto.len, 0 as *const u8, 0, AX_COFF_CONTAINER_CHARS, 1u32, mut_view(obj_buf));
    let r4 = container_extract_coff_obj(obj_buf.ptr as *const u8, obj_buf.len, view(any_tgt), mut_view(out_m), mut_view(out_l));
    container_emit_diag(r4.status, r4.found_version, r4.bad_section_type, probe_sv(abuf, 546, 22), mut_view(*out));

    // 5. Target triple mismatch ("x86_64-unknown-linux-gnu" vs "x86_64-pc-windows-msvc")
    let linux_tgt = axmi_target_expectation_new(probe_sv(abuf, 146, 24), probe_sv(abuf, 170, 13), 8u32, true, 0x07u32, AXMI_PANIC_NO_PANIC);
    container_write_coff_obj_ex(0 as *const u8, 32, 0 as *const u8, 0, meta_buf.ptr as *const u8, meta_buf.len, lto_buf.ptr as *const u8, lto_buf.len, 0 as *const u8, 0, AX_COFF_CONTAINER_CHARS, 1u32, mut_view(obj_buf));
    let r5 = container_extract_coff_obj(obj_buf.ptr as *const u8, obj_buf.len, view(linux_tgt), mut_view(out_m), mut_view(out_l));
    container_emit_diag(r5.status, r5.found_version, r5.bad_section_type, probe_sv(abuf, 568, 22), mut_view(*out));

    // 6. CPU feature mask mismatch (artifact requires 0x03, target only allows 0x01)
    let weak_cpu_tgt = axmi_target_expectation_new(probe_sv(abuf, 22, 22), probe_sv(abuf, 44, 12), 8u32, true, 0x01u32, AXMI_PANIC_NO_PANIC);
    let r6 = container_extract_coff_obj(obj_buf.ptr as *const u8, obj_buf.len, view(weak_cpu_tgt), mut_view(out_m), mut_view(out_l));
    container_emit_diag(r6.status, r6.found_version, r6.bad_section_type, probe_sv(abuf, 590, 24), mut_view(*out));

    // 7. Checksum mismatch in `.axmeta`
    bad_meta.len = 0;
    axmi_buf_push_bytes(mut_view(bad_meta), meta_buf.ptr as *const u8, meta_buf.len);
    let flip_pos_m = bad_meta.len - 8;
    unsafe { *(bad_meta.ptr + flip_pos_m) = (*(bad_meta.ptr + flip_pos_m)) ^ 0xFFu8; }
    container_write_coff_obj_ex(0 as *const u8, 32, 0 as *const u8, 0, bad_meta.ptr as *const u8, bad_meta.len, lto_buf.ptr as *const u8, lto_buf.len, 0 as *const u8, 0, AX_COFF_CONTAINER_CHARS, 1u32, mut_view(obj_buf));
    let r7 = container_extract_coff_obj(obj_buf.ptr as *const u8, obj_buf.len, view(any_tgt), mut_view(out_m), mut_view(out_l));
    container_emit_diag(r7.status, r7.found_version, r7.bad_section_type, probe_sv(abuf, 614, 24), mut_view(*out));

    // 8. Checksum mismatch in `.axlto`
    bad_lto.len = 0;
    axmi_buf_push_bytes(mut_view(bad_lto), lto_buf.ptr as *const u8, lto_buf.len);
    let flip_pos_l = bad_lto.len - 8;
    unsafe { *(bad_lto.ptr + flip_pos_l) = (*(bad_lto.ptr + flip_pos_l)) ^ 0xFFu8; }
    container_write_coff_obj_ex(0 as *const u8, 32, 0 as *const u8, 0, meta_buf.ptr as *const u8, meta_buf.len, bad_lto.ptr as *const u8, bad_lto.len, 0 as *const u8, 0, AX_COFF_CONTAINER_CHARS, 1u32, mut_view(obj_buf));
    let r8 = container_extract_coff_obj(obj_buf.ptr as *const u8, obj_buf.len, view(any_tgt), mut_view(out_m), mut_view(out_l));
    container_emit_diag(r8.status, r8.found_version, r8.bad_section_type, probe_sv(abuf, 638, 23), mut_view(*out));

    // 9. Unknown mandatory section in `.axlto` (rejected) vs unknown optional section in `.axlto` (accepted)
    let mut lto_mand = axlto_container_empty();
    axlto_container_init(mut_view(lto_mand));
    populate_math_unit(abuf, mut_view(iface), mut_view(lto_mand), false);
    axlto_bind_to_interface(mut_view(lto_mand), view(iface));
    axlto_add_custom_section(mut_view(lto_mand), 90u32, 250u16, AXMI_SEC_DEFAULT_FLAGS, 0xCAFEu64);
    bad_lto.len = 0;
    let _ = axlto_serialize(mut_view(lto_mand), mut_view(bad_lto));
    let r9 = axlto_deserialize(bad_lto.ptr as *const u8, bad_lto.len, view(any_tgt), mut_view(out_l));
    container_emit_diag(r9.status, r9.found_version, r9.bad_section_type, probe_sv(abuf, 661, 27), mut_view(*out));
    axlto_container_free(mut_view(lto_mand));

    let mut lto_opt = axlto_container_empty();
    axlto_container_init(mut_view(lto_opt));
    populate_math_unit(abuf, mut_view(iface), mut_view(lto_opt), false);
    axlto_bind_to_interface(mut_view(lto_opt), view(iface));
    axlto_add_custom_section(mut_view(lto_opt), 91u32, 251u16, AXMI_SEC_DEFAULT_FLAGS | AXMI_SEC_FLAG_OPTIONAL, 0xBEEFu64);
    bad_lto.len = 0;
    let _ = axlto_serialize(mut_view(lto_opt), mut_view(bad_lto));
    let r9_opt = axlto_deserialize(bad_lto.ptr as *const u8, bad_lto.len, view(any_tgt), mut_view(out_l));
    probe_push_slice(mut_view(*out), 688, 30); // "unknown_optional_sec_axlto_ok="
    axmi_push_bool(mut_view(*out), r9_opt.status == AXMI_STATUS_OK && out_l.custom_section_count == 1u32);
    diag_buf_push_byte(mut_view(*out), 10u8);
    axlto_container_free(mut_view(lto_opt));

    // 10. Invalid COFF section characteristics on `.axmeta`/`.axlto` (executable `AX_COFF_TEXT_CHARS`)
    container_write_coff_obj_ex(0 as *const u8, 32, 0 as *const u8, 0, meta_buf.ptr as *const u8, meta_buf.len, lto_buf.ptr as *const u8, lto_buf.len, 0 as *const u8, 0, AX_COFF_TEXT_CHARS, 1u32, mut_view(obj_buf));
    let r10 = container_extract_coff_obj(obj_buf.ptr as *const u8, obj_buf.len, view(any_tgt), mut_view(out_m), mut_view(out_l));
    container_emit_diag(r10.status, r10.found_version, r10.bad_section_type, probe_sv(abuf, 718, 24), mut_view(*out));

    // 11. Cross-section `InterfaceFingerprint` drift between `.axmeta` and `.axlto` in the same `.obj`
    let mut lto_drift = axlto_container_empty();
    axlto_container_init(mut_view(lto_drift));
    populate_math_unit(abuf, mut_view(iface), mut_view(lto_drift), false);
    axlto_bind_to_interface(mut_view(lto_drift), view(iface));
    lto_drift.interface_fingerprint.hi = lto_drift.interface_fingerprint.hi ^ 0x1234u64;
    bad_lto.len = 0;
    let _ = axlto_serialize(mut_view(lto_drift), mut_view(bad_lto));
    container_write_coff_obj_ex(0 as *const u8, 32, 0 as *const u8, 0, meta_buf.ptr as *const u8, meta_buf.len, bad_lto.ptr as *const u8, bad_lto.len, 0 as *const u8, 0, AX_COFF_CONTAINER_CHARS, 1u32, mut_view(obj_buf));
    let r11 = container_extract_coff_obj(obj_buf.ptr as *const u8, obj_buf.len, view(any_tgt), mut_view(out_m), mut_view(out_l));
    container_emit_diag(r11.status, r11.found_version, r11.bad_section_type, probe_sv(abuf, 742, 22), mut_view(*out));
    axlto_container_free(mut_view(lto_drift));

    // 12. Unverified MIR body (`ownership_verified = false`, AXS-ART-024) patched in `.axlto`
    bad_lto.len = 0;
    axmi_buf_push_bytes(mut_view(bad_lto), lto_buf.ptr as *const u8, lto_buf.len);
    // Section 1 is GenericMir (descriptor at 64 + 48 = 112)
    let mir_sec_off = (unsafe { *(bad_lto.ptr + 112 + 12) } as usize) | ((unsafe { *(bad_lto.ptr + 112 + 13) } as usize) << 8);
    let mir_sec_sz = (unsafe { *(bad_lto.ptr + 112 + 24) } as usize) | ((unsafe { *(bad_lto.ptr + 112 + 25) } as usize) << 8);
    // Clear ownership_verified bit (bit 3) at `mir_sec_off + 4 + 10`
    unsafe { *(bad_lto.ptr + mir_sec_off + 14) = (*(bad_lto.ptr + mir_sec_off + 14)) & 0xF7u8; }
    // Recompute section checksum and top-level content_hash so checksum passes and semantic validator catches unverified MIR
    let new_mir_ck = container_compute_section_checksum(bad_lto.ptr as *const u8, mir_sec_off, mir_sec_sz);
    axmi_buf_patch_fp128_le(mut_view(bad_lto), 112 + 32, new_mir_ck);
    let new_top_hash = container_compute_content_hash(bad_lto.ptr as *const u8, bad_lto.len);
    axmi_buf_patch_fp128_le(mut_view(bad_lto), 48, new_top_hash);
    let r12 = axlto_deserialize(bad_lto.ptr as *const u8, bad_lto.len, view(any_tgt), mut_view(out_l));
    container_emit_diag(r12.status, r12.found_version, r12.bad_section_type, probe_sv(abuf, 764, 25), mut_view(*out));

    // 13. `mir_schema_version` mismatch (55) inside `.axlto` GenericMir section
    bad_lto.len = 0;
    axmi_buf_push_bytes(mut_view(bad_lto), lto_buf.ptr as *const u8, lto_buf.len);
    unsafe {
        *(bad_lto.ptr + mir_sec_off + 12) = 55u8;
        *(bad_lto.ptr + mir_sec_off + 13) = 0u8;
    }
    let new_mir_ck2 = container_compute_section_checksum(bad_lto.ptr as *const u8, mir_sec_off, mir_sec_sz);
    axmi_buf_patch_fp128_le(mut_view(bad_lto), 112 + 32, new_mir_ck2);
    let new_top_hash2 = container_compute_content_hash(bad_lto.ptr as *const u8, bad_lto.len);
    axmi_buf_patch_fp128_le(mut_view(bad_lto), 48, new_top_hash2);
    let r13 = axlto_deserialize(bad_lto.ptr as *const u8, bad_lto.len, view(any_tgt), mut_view(out_l));
    container_emit_diag(r13.status, r13.found_version, r13.bad_section_type, probe_sv(abuf, 789, 25), mut_view(*out));

    axmi_buf_free(mut_view(bad_meta));
    axmi_buf_free(mut_view(bad_lto));
    axmi_buf_free(mut_view(obj_buf));
    axmi_interface_free(mut_view(out_m));
    axlto_container_free(mut_view(out_l));
    axmi_buf_free(mut_view(meta_buf));
    axmi_buf_free(mut_view(lto_buf));
    axmi_interface_free(mut_view(iface));
    axlto_container_free(mut_view(lto));
}

fn run_case_3(abuf: view<AxmiBuffer>, out: mut_view<DiagBuffer>) {
    probe_push_slice(mut_view(*out), 305, 63); // "=== CASE 3: ..."

    let mut math_iface = axmi_interface_empty();
    let mut math_lto = axlto_container_empty();
    axmi_interface_init(mut_view(math_iface));
    axlto_container_init(mut_view(math_lto));
    populate_math_unit(abuf, mut_view(math_iface), mut_view(math_lto), false);
    axmi_recompute_fingerprints(mut_view(math_iface));

    // Build second compilation unit `app_render.scene` depending on `core_math.vec`
    let mut app_iface = axmi_interface_empty();
    let mut app_lto = axlto_container_empty();
    axmi_interface_init(mut_view(app_iface));
    axlto_container_init(mut_view(app_lto));

    let app_pkg = probe_sv(abuf, 97, 10);   // "app_render"
    let app_mod = probe_sv(abuf, 107, 16);  // "app_render.scene"
    let trp = probe_sv(abuf, 22, 22);
    let abi = probe_sv(abuf, 44, 12);
    let empty_sv = probe_sv(abuf, 0, 0);

    axmi_set_module_identity(mut_view(app_iface), app_pkg, app_mod, trp, abi, 8u32, true, 0x03u32, AXMI_PANIC_NO_PANIC);
    let sk_render = semantic_key_new(app_pkg, app_mod, ITEM_NS_VALUE, 0u32, probe_sv(abuf, 123, 12), empty_sv);
    let sk_shade = semantic_key_new(app_pkg, app_mod, ITEM_NS_VALUE, 0u32, probe_sv(abuf, 135, 11), empty_sv);
    let sk_dot = semantic_key_new(probe_sv(abuf, 0, 9), probe_sv(abuf, 9, 13), ITEM_NS_VALUE, 0u32, probe_sv(abuf, 60, 8), empty_sv);

    let _ = axmi_add_symbol(mut_view(app_iface), DefId { v: 20u32 }, ITEM_KIND_FN, true, false, false, false, 1u32, TypeId { v: 2u32 }, 0u32, 1u8, sk_render);
    axmi_add_dependency(mut_view(app_iface), AXMI_DEP_SEMANTIC_INPUT, probe_sv(abuf, 9, 13), math_iface.interface_fingerprint, math_iface.abi_fingerprint);

    let ops_render_ptr = unsafe { (abuf.ptr as *const u8) + 985 };
    axlto_add_fn_summary(mut_view(app_lto), DefId { v: 20u32 }, AXLTO_LINK_PUBLIC, AXLTO_ROOT_ENTRY, AXMI_PANIC_NO_PANIC, false, 14u32, 25u32, AXMI_EFF_PURE, AXMI_CAP_NONE, 1u32, 1u32, 0x2001u64, 0xBB01u64, sk_render);
    axlto_add_fn_summary(mut_view(app_lto), DefId { v: 21u32 }, AXLTO_LINK_INTERNAL, AXLTO_ROOT_NONE, AXMI_PANIC_NO_PANIC, true, 5u32, 8u32, AXMI_EFF_PURE, AXMI_CAP_NONE, 1u32, 1u32, 0x2002u64, 0xBB02u64, sk_shade);
    axlto_add_call_edge(mut_view(app_lto), DefId { v: 20u32 }, DefId { v: 11u32 }, 3u32, 120u32, true, true, sk_dot);
    axlto_add_call_edge(mut_view(app_lto), DefId { v: 20u32 }, DefId { v: 21u32 }, 1u32, 40u32, true, true, sk_shade);
    axlto_add_mir_body(mut_view(app_lto), DefId { v: 20u32 }, MirBodyId { v: 10u32 }, AXMI_MIR_SCHEMA_VERSION, false, false, false, true, 1u32, 2u32, 3u32, 14u32, ops_render_ptr, 4u32, sk_render);

    let mut obj_math = axmi_buf_empty();
    let mut obj_app = axmi_buf_empty();
    axmi_buf_init(mut_view(obj_math), 2048);
    axmi_buf_init(mut_view(obj_app), 2048);
    container_write_axiom_coff_obj(mut_view(math_iface), mut_view(math_lto), true, 96, 48, mut_view(obj_math));
    container_write_axiom_coff_obj(mut_view(app_iface), mut_view(app_lto), false, 128, 32, mut_view(obj_app));

    let exp_tgt = axmi_target_expectation_new(trp, abi, 8u32, true, 0x03u32, AXMI_PANIC_NO_PANIC);

    // 1. Link `obj_math` + `obj_app` into PE32+ `.exe` and verify section stripping & LTO summary consumption
    let mut sess_exe = container_link_session_new(exp_tgt);
    let _ = container_link_add_coff_obj(mut_view(sess_exe), obj_math.ptr as *const u8, obj_math.len);
    let _ = container_link_add_coff_obj(mut_view(sess_exe), obj_app.ptr as *const u8, obj_app.len);
    let mut pe_exe = axmi_buf_empty();
    axmi_buf_init(mut_view(pe_exe), 4096);
    let res_exe = container_link_finalize_pe_image(mut_view(sess_exe), PE_IMAGE_KIND_EXE, mut_view(pe_exe));
    container_inspect_pe_link_dump(view(res_exe), mut_view(*out));
    container_link_session_free(mut_view(sess_exe));

    // 2. Link `obj_math` + `obj_app` into PE32+ `.dll` and verify section stripping
    let mut sess_dll = container_link_session_new(exp_tgt);
    let _ = container_link_add_coff_obj(mut_view(sess_dll), obj_math.ptr as *const u8, obj_math.len);
    let _ = container_link_add_coff_obj(mut_view(sess_dll), obj_app.ptr as *const u8, obj_app.len);
    let mut pe_dll = axmi_buf_empty();
    axmi_buf_init(mut_view(pe_dll), 4096);
    let res_dll = container_link_finalize_pe_image(mut_view(sess_dll), PE_IMAGE_KIND_DLL, mut_view(pe_dll));
    container_inspect_pe_link_dump(view(res_dll), mut_view(*out));
    container_link_session_free(mut_view(sess_dll));

    // 3. Negative check: tamper PE section name to `.axmeta` and verify `container_verify_pe_image_stripped` rejects it
    let mut bad_pe = axmi_buf_empty();
    axmi_buf_init(mut_view(bad_pe), 4096);
    axmi_buf_push_bytes(mut_view(bad_pe), pe_exe.ptr as *const u8, pe_exe.len);
    // First PE section header is at 64 + 4 + 20 + 240 = 328
    unsafe {
        *(bad_pe.ptr + 328 + 0) = 46u8; // '.'
        *(bad_pe.ptr + 328 + 1) = 97u8; // 'a'
        *(bad_pe.ptr + 328 + 2) = 120u8; // 'x'
        *(bad_pe.ptr + 328 + 3) = 109u8; // 'm'
        *(bad_pe.ptr + 328 + 4) = 101u8; // 'e'
        *(bad_pe.ptr + 328 + 5) = 116u8; // 't'
        *(bad_pe.ptr + 328 + 6) = 97u8; // 'a'
        *(bad_pe.ptr + 328 + 7) = 0u8;
    }
    let v_bad_sec = container_verify_pe_image_stripped(bad_pe.ptr as *const u8, bad_pe.len);
    probe_push_slice(mut_view(*out), 814, 28); // "pe_injected_axmeta_detected="
    axmi_push_bool(mut_view(*out), !v_bad_sec.is_stripped_clean && v_bad_sec.has_axmeta_section);
    diag_buf_push_byte(mut_view(*out), 10u8);

    // 4. Negative check: inject `"AXMETA01"` magic bytes into PE `.text` payload and verify detection
    bad_pe.len = 0;
    axmi_buf_push_bytes(mut_view(bad_pe), pe_exe.ptr as *const u8, pe_exe.len);
    let mut mi: usize = 0;
    while mi < 8 {
        unsafe { *(bad_pe.ptr + 520 + mi) = AXMETA_MAGIC[mi]; }
        mi = mi + 1;
    }
    let v_bad_magic = container_verify_pe_image_stripped(bad_pe.ptr as *const u8, bad_pe.len);
    probe_push_slice(mut_view(*out), 842, 25); // "pe_leaked_magic_detected="
    axmi_push_bool(mut_view(*out), !v_bad_magic.is_stripped_clean && v_bad_magic.leaked_magic_count == 1u32);
    diag_buf_push_byte(mut_view(*out), 10u8);

    // 5. Cross-module dependency fingerprint mismatch (`AXS-ART-023`) rejected at link time
    let mut app_stale_iface = axmi_interface_empty();
    let mut app_stale_lto = axlto_container_empty();
    axmi_interface_init(mut_view(app_stale_iface));
    axlto_container_init(mut_view(app_stale_lto));
    axmi_set_module_identity(mut_view(app_stale_iface), app_pkg, app_mod, trp, abi, 8u32, true, 0x03u32, AXMI_PANIC_NO_PANIC);
    let _ = axmi_add_symbol(mut_view(app_stale_iface), DefId { v: 20u32 }, ITEM_KIND_FN, true, false, false, false, 1u32, TypeId { v: 2u32 }, 0u32, 1u8, sk_render);
    let mut stale_fp = math_iface.interface_fingerprint;
    stale_fp.lo = stale_fp.lo ^ 0x9999u64;
    axmi_add_dependency(mut_view(app_stale_iface), AXMI_DEP_SEMANTIC_INPUT, probe_sv(abuf, 9, 13), stale_fp, math_iface.abi_fingerprint);
    axlto_add_fn_summary(mut_view(app_stale_lto), DefId { v: 20u32 }, AXLTO_LINK_PUBLIC, AXLTO_ROOT_ENTRY, AXMI_PANIC_NO_PANIC, false, 14u32, 25u32, AXMI_EFF_PURE, AXMI_CAP_NONE, 1u32, 1u32, 0x2001u64, 0xBB01u64, sk_render);

    let mut obj_app_stale = axmi_buf_empty();
    axmi_buf_init(mut_view(obj_app_stale), 2048);
    container_write_axiom_coff_obj(mut_view(app_stale_iface), mut_view(app_stale_lto), false, 64, 0, mut_view(obj_app_stale));

    let mut sess_stale = container_link_session_new(exp_tgt);
    let _ = container_link_add_coff_obj(mut_view(sess_stale), obj_math.ptr as *const u8, obj_math.len);
    let _ = container_link_add_coff_obj(mut_view(sess_stale), obj_app_stale.ptr as *const u8, obj_app_stale.len);
    let res_stale = container_link_finalize_pe_image(mut_view(sess_stale), PE_IMAGE_KIND_EXE, mut_view(bad_pe));
    container_emit_diag(res_stale.status, res_stale.found_version, res_stale.bad_section_type, probe_sv(abuf, 867, 23), mut_view(*out));
    container_link_session_free(mut_view(sess_stale));

    axmi_buf_free(mut_view(obj_app_stale));
    axmi_interface_free(mut_view(app_stale_iface));
    axlto_container_free(mut_view(app_stale_lto));
    axmi_buf_free(mut_view(bad_pe));
    axmi_buf_free(mut_view(pe_exe));
    axmi_buf_free(mut_view(pe_dll));
    axmi_buf_free(mut_view(obj_math));
    axmi_buf_free(mut_view(obj_app));
    axmi_interface_free(mut_view(app_iface));
    axlto_container_free(mut_view(app_lto));
    axmi_interface_free(mut_view(math_iface));
    axlto_container_free(mut_view(math_lto));
}

fn run_case_4(abuf: view<AxmiBuffer>, out: mut_view<DiagBuffer>) {
    probe_push_slice(mut_view(*out), 368, 54); // "=== CASE 4: ..."

    let mut math_iface = axmi_interface_empty();
    let mut math_lto = axlto_container_empty();
    axmi_interface_init(mut_view(math_iface));
    axlto_container_init(mut_view(math_lto));
    populate_math_unit(abuf, mut_view(math_iface), mut_view(math_lto), false);

    let mut obj_axiom = axmi_buf_empty();
    let mut obj_foreign = axmi_buf_empty();
    axmi_buf_init(mut_view(obj_axiom), 2048);
    axmi_buf_init(mut_view(obj_foreign), 512);
    container_write_axiom_coff_obj(mut_view(math_iface), mut_view(math_lto), false, 80, 24, mut_view(obj_axiom));
    container_write_foreign_coff_obj(48, 16, 2u32, mut_view(obj_foreign));

    let exp_tgt = axmi_target_expectation_new(probe_sv(abuf, 22, 22), probe_sv(abuf, 44, 12), 8u32, true, 0x03u32, AXMI_PANIC_NO_PANIC);

    // 1. Inspect foreign C COFF `.obj` (without `.axmeta` / `.axlto` per REQ-LNK-476)
    let mut m_tmp = axmi_interface_empty();
    let mut l_tmp = axlto_container_empty();
    axmi_interface_init(mut_view(m_tmp));
    axlto_container_init(mut_view(l_tmp));
    let fres = container_extract_coff_obj(obj_foreign.ptr as *const u8, obj_foreign.len, view(exp_tgt), mut_view(m_tmp), mut_view(l_tmp));
    container_inspect_obj_dump(view(fres), view(m_tmp), view(l_tmp), mut_view(*out));

    // 2. Build COFF `.lib` archive (`!<arch>\n`) with 1 Axiom `.obj` + 1 foreign C `.obj`
    let mut ar_buf = axmi_buf_empty();
    axmi_buf_init(mut_view(ar_buf), 4096);
    container_write_coff_archive_begin(mut_view(ar_buf));
    container_write_coff_archive_add_member(mut_view(ar_buf), 0, obj_axiom.ptr as *const u8, obj_axiom.len);
    container_write_coff_archive_add_member(mut_view(ar_buf), 1, obj_foreign.ptr as *const u8, obj_foreign.len);

    let ares = container_extract_coff_archive(ar_buf.ptr as *const u8, ar_buf.len, view(exp_tgt));
    container_inspect_archive_dump(view(ares), mut_view(*out));

    // 3. Link the mixed `.lib` archive into a stripped PE32+ `.exe`
    let mut sess = container_link_session_new(exp_tgt);
    let _ = container_link_add_coff_archive(mut_view(sess), ar_buf.ptr as *const u8, ar_buf.len);
    let mut pe_out = axmi_buf_empty();
    axmi_buf_init(mut_view(pe_out), 4096);
    let lres = container_link_finalize_pe_image(mut_view(sess), PE_IMAGE_KIND_EXE, mut_view(pe_out));
    container_inspect_pe_link_dump(view(lres), mut_view(*out));
    container_link_session_free(mut_view(sess));

    // 4. Seam check: truncated COFF `.obj` header (10 bytes)
    let r_trunc = container_extract_coff_obj(obj_axiom.ptr as *const u8, 10, view(exp_tgt), mut_view(m_tmp), mut_view(l_tmp));
    container_emit_diag(r_trunc.status, r_trunc.found_version, r_trunc.bad_section_type, probe_sv(abuf, 890, 17), mut_view(*out));

    // 5. Seam check: out-of-bounds COFF section `PointerToRawData`
    let mut bad_obj = axmi_buf_empty();
    axmi_buf_init(mut_view(bad_obj), 2048);
    axmi_buf_push_bytes(mut_view(bad_obj), obj_axiom.ptr as *const u8, obj_axiom.len);
    // Patch section 0 `PointerToRawData` at offset `20 + 20 = 40` to 0x00FFFFFF
    unsafe {
        *(bad_obj.ptr + 40) = 0xFFu8;
        *(bad_obj.ptr + 41) = 0xFFu8;
        *(bad_obj.ptr + 42) = 0xFFu8;
        *(bad_obj.ptr + 43) = 0u8;
    }
    let r_oob = container_extract_coff_obj(bad_obj.ptr as *const u8, bad_obj.len, view(exp_tgt), mut_view(m_tmp), mut_view(l_tmp));
    container_emit_diag(r_oob.status, r_oob.found_version, r_oob.bad_section_type, probe_sv(abuf, 907, 24), mut_view(*out));

    // 6. Seam check: corrupt COFF `.lib` archive member header terminator (`0x60, 0x0A`)
    let mut bad_ar = axmi_buf_empty();
    axmi_buf_init(mut_view(bad_ar), 4096);
    axmi_buf_push_bytes(mut_view(bad_ar), ar_buf.ptr as *const u8, ar_buf.len);
    unsafe { *(bad_ar.ptr + 8 + 58) = 0x00u8; }
    let r_ar = container_extract_coff_archive(bad_ar.ptr as *const u8, bad_ar.len, view(exp_tgt));
    container_emit_diag(r_ar.status, r_ar.found_version, r_ar.bad_section_type, probe_sv(abuf, 931, 22), mut_view(*out));

    // 7. Seam check: COFF `.obj` carrying `.axlto` without `.axmeta` (violating AXS-ART-020)
    let mut lto_only_bytes = axmi_buf_empty();
    axmi_buf_init(mut_view(lto_only_bytes), 1024);
    axlto_bind_to_interface(mut_view(math_lto), view(math_iface));
    let _ = axlto_serialize(mut_view(math_lto), mut_view(lto_only_bytes));
    bad_obj.len = 0;
    container_write_coff_obj_ex(0 as *const u8, 32, 0 as *const u8, 0, 0 as *const u8, 0, lto_only_bytes.ptr as *const u8, lto_only_bytes.len, 0 as *const u8, 0, AX_COFF_CONTAINER_CHARS, 1u32, mut_view(bad_obj));
    let r_no_meta = container_extract_coff_obj(bad_obj.ptr as *const u8, bad_obj.len, view(exp_tgt), mut_view(m_tmp), mut_view(l_tmp));
    container_emit_diag(r_no_meta.status, r_no_meta.found_version, r_no_meta.bad_section_type, probe_sv(abuf, 953, 22), mut_view(*out));

    axmi_buf_free(mut_view(lto_only_bytes));
    axmi_buf_free(mut_view(bad_ar));
    axmi_buf_free(mut_view(bad_obj));
    axmi_buf_free(mut_view(pe_out));
    axmi_buf_free(mut_view(ar_buf));
    axmi_interface_free(mut_view(m_tmp));
    axlto_container_free(mut_view(l_tmp));
    axmi_buf_free(mut_view(obj_axiom));
    axmi_buf_free(mut_view(obj_foreign));
    axmi_interface_free(mut_view(math_iface));
    axlto_container_free(mut_view(math_lto));
}

fn print_diag_buf(b: view<DiagBuffer>) {
    if (b.len) > 0 && (b.ptr as usize) != 0 {
        unsafe {
            let _ = write(stdio(1u32), b.ptr as *const u8, b.len);
        }
    }
}

pub fn main() -> i32 {
    let mut abuf = axmi_buf_empty();
    init_probe_ascii_buf(mut_view(abuf));

    let mut out = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(out));

    run_case_1(view(abuf), mut_view(out));
    run_case_2(view(abuf), mut_view(out));
    run_case_3(view(abuf), mut_view(out));
    run_case_4(view(abuf), mut_view(out));

    print_diag_buf(view(out));
    diag_buf_free(mut_view(out));
    axmi_buf_free(mut_view(abuf));
    print("ARTIFACT-CONTAINER-PROBE-PASS\n");
    0
}
