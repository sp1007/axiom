// test: run
// modes: interp native
// stdout-file: container_fail_closed_validation.stdout
// SPEC-24 AXS-ART-002..005, AXS-ART-020..024, AXS-ART-050..053:
// Fail-closed validation of `.axmeta` and `.axlto` COFF container sections:
// magic corruption, schema version mismatch, target triple & CPU feature mask mismatch,
// section checksum mismatch, unknown mandatory vs optional section flags, executable/writable
// COFF section characteristics rejection, cross-section `InterfaceFingerprint` drift, and
// unverified MIR (`ownership_verified == false`) rejection.

const STATUS_OK: u32 = 0u32;
const AX_ART_CORRUPT_HEADER: u32 = 9501u32;
const AX_ART_VERSION_MISMATCH: u32 = 9502u32;
const AX_ART_TARGET_MISMATCH: u32 = 9503u32;
const AX_ART_CHECKSUM_MISMATCH: u32 = 9504u32;

const AXMETA_MAGIC_U64: u64 = 0x31304154454D5841u64;
const AXLTO_MAGIC_U64: u64 = 0x3130304F544C5841u64;
const SCHEMA_V1: u16 = 1u16;
const MIR_SCHEMA_V1: u16 = 1u16;
const SEC_FLAG_OPTIONAL: u16 = 0x0010u16;

const AX_COFF_CONTAINER_CHARS: u32 = 0x42000200u32;
const AX_COFF_TEXT_CHARS: u32 = 0x60500020u32;
const IMAGE_SCN_LNK_INFO: u32 = 0x00000200u32;
const IMAGE_SCN_MEM_DISCARDABLE: u32 = 0x02000000u32;
const IMAGE_SCN_MEM_EXECUTE: u32 = 0x20000000u32;
const IMAGE_SCN_MEM_WRITE: u32 = 0x80000000u32;

@derive(Copy)
struct ContainerPacket {
    coff_chars: u32,
    meta_magic: u64,
    lto_magic: u64,
    meta_schema: u16,
    lto_schema: u16,
    mir_schema: u16,
    target_fp: u64,
    cpu_features: u32,
    meta_ifp: u64,
    lto_ifp: u64,
    meta_cksum_ok: bool,
    lto_cksum_ok: bool,
    unknown_sec_type: u16,
    unknown_sec_flags: u16,
    mir_ownership_verified: bool,
}

fn validate_container(pkt: ContainerPacket, expected_target_fp: u64, allowed_cpu_features: u32) -> u32 {
    let has_info = (pkt.coff_chars & IMAGE_SCN_LNK_INFO) != 0u32;
    let has_disc = (pkt.coff_chars & IMAGE_SCN_MEM_DISCARDABLE) != 0u32;
    let bad_perm = (pkt.coff_chars & (IMAGE_SCN_MEM_EXECUTE | IMAGE_SCN_MEM_WRITE)) != 0u32;
    if !has_info || !has_disc || bad_perm {
        return AX_ART_CORRUPT_HEADER;
    }
    if pkt.meta_magic != AXMETA_MAGIC_U64 || pkt.lto_magic != AXLTO_MAGIC_U64 {
        return AX_ART_CORRUPT_HEADER;
    }
    if pkt.meta_schema != SCHEMA_V1 || pkt.lto_schema != SCHEMA_V1 || pkt.mir_schema != MIR_SCHEMA_V1 {
        return AX_ART_VERSION_MISMATCH;
    }
    if !pkt.meta_cksum_ok || !pkt.lto_cksum_ok {
        return AX_ART_CHECKSUM_MISMATCH;
    }
    if pkt.unknown_sec_type != 0u16 {
        if (pkt.unknown_sec_flags & SEC_FLAG_OPTIONAL) == 0u16 {
            return AX_ART_VERSION_MISMATCH;
        }
    }
    if pkt.target_fp != expected_target_fp || (pkt.cpu_features & (~allowed_cpu_features)) != 0u32 {
        return AX_ART_TARGET_MISMATCH;
    }
    if pkt.meta_ifp != pkt.lto_ifp {
        return AX_ART_CHECKSUM_MISMATCH;
    }
    if !pkt.mir_ownership_verified {
        return AX_ART_CORRUPT_HEADER;
    }
    STATUS_OK
}

fn valid_container_packet() -> ContainerPacket {
    ContainerPacket {
        coff_chars: AX_COFF_CONTAINER_CHARS,
        meta_magic: AXMETA_MAGIC_U64,
        lto_magic: AXLTO_MAGIC_U64,
        meta_schema: SCHEMA_V1,
        lto_schema: SCHEMA_V1,
        mir_schema: MIR_SCHEMA_V1,
        target_fp: 0x57494E36345F5838u64,
        cpu_features: 0x03u32,
        meta_ifp: 0x1122334455667788u64,
        lto_ifp: 0x1122334455667788u64,
        meta_cksum_ok: true,
        lto_cksum_ok: true,
        unknown_sec_type: 0u16,
        unknown_sec_flags: 0u16,
        mir_ownership_verified: true,
    }
}

pub fn main() -> i32 {
    let exp_tgt: u64 = 0x57494E36345F5838u64;
    let exp_cpu: u32 = 0x07u32;
    let base = valid_container_packet();
    if validate_container(base, exp_tgt, exp_cpu) != STATUS_OK {
        return 1;
    }

    // 1. Corrupt `.axmeta` and `.axlto` magic
    let mut bad_meta_m = base;
    bad_meta_m.meta_magic = 0u64;
    let mut bad_lto_m = base;
    bad_lto_m.lto_magic = 0u64;
    if validate_container(bad_meta_m, exp_tgt, exp_cpu) != AX_ART_CORRUPT_HEADER ||
        validate_container(bad_lto_m, exp_tgt, exp_cpu) != AX_ART_CORRUPT_HEADER {
        return 2;
    }

    // 2. Schema version mismatch in `.axmeta`, `.axlto`, and `GenericMir`
    let mut bad_m_ver = base;
    bad_m_ver.meta_schema = 99u16;
    let mut bad_l_ver = base;
    bad_l_ver.lto_schema = 77u16;
    let mut bad_mir_ver = base;
    bad_mir_ver.mir_schema = 55u16;
    if validate_container(bad_m_ver, exp_tgt, exp_cpu) != AX_ART_VERSION_MISMATCH ||
        validate_container(bad_l_ver, exp_tgt, exp_cpu) != AX_ART_VERSION_MISMATCH ||
        validate_container(bad_mir_ver, exp_tgt, exp_cpu) != AX_ART_VERSION_MISMATCH {
        return 3;
    }

    // 3. Target triple & CPU feature mismatch
    if validate_container(base, 0x4C4E5836345F4152u64, exp_cpu) != AX_ART_TARGET_MISMATCH ||
        validate_container(base, exp_tgt, 0x01u32) != AX_ART_TARGET_MISMATCH {
        return 4;
    }

    // 4. Checksum mismatch & cross-section `InterfaceFingerprint` drift
    let mut bad_ck = base;
    bad_ck.lto_cksum_ok = false;
    let mut drift_fp = base;
    drift_fp.lto_ifp = 0x9999334455667788u64;
    if validate_container(bad_ck, exp_tgt, exp_cpu) != AX_ART_CHECKSUM_MISMATCH ||
        validate_container(drift_fp, exp_tgt, exp_cpu) != AX_ART_CHECKSUM_MISMATCH {
        return 5;
    }

    // 5. Unknown mandatory vs optional section in `.axlto`
    let mut unk_req = base;
    unk_req.unknown_sec_type = 250u16;
    unk_req.unknown_sec_flags = 0u16;
    let mut unk_opt = base;
    unk_opt.unknown_sec_type = 251u16;
    unk_opt.unknown_sec_flags = SEC_FLAG_OPTIONAL;
    if validate_container(unk_req, exp_tgt, exp_cpu) != AX_ART_VERSION_MISMATCH ||
        validate_container(unk_opt, exp_tgt, exp_cpu) != STATUS_OK {
        return 6;
    }

    // 6. Executable COFF section characteristics & unverified MIR body rejection
    let mut bad_chars = base;
    bad_chars.coff_chars = AX_COFF_TEXT_CHARS;
    let mut unverified_mir = base;
    unverified_mir.mir_ownership_verified = false;
    if validate_container(bad_chars, exp_tgt, exp_cpu) != AX_ART_CORRUPT_HEADER ||
        validate_container(unverified_mir, exp_tgt, exp_cpu) != AX_ART_CORRUPT_HEADER {
        return 7;
    }

    print("validate magic_and_chars: axmeta_magic=AX_ART_CORRUPT_HEADER axlto_magic=AX_ART_CORRUPT_HEADER exec_chars=AX_ART_CORRUPT_HEADER\n");
    print("validate schema_and_sec: axmeta_v99=AX_ART_VERSION_MISMATCH axlto_v77=AX_ART_VERSION_MISMATCH mir_v55=AX_ART_VERSION_MISMATCH req_sec=AX_ART_VERSION_MISMATCH opt_sec=OK\n");
    print("validate target_and_integrity: triple=AX_ART_TARGET_MISMATCH cpu=AX_ART_TARGET_MISMATCH cksum=AX_ART_CHECKSUM_MISMATCH fp_drift=AX_ART_CHECKSUM_MISMATCH unverified_mir=AX_ART_CORRUPT_HEADER\n");
    print("CONTAINER-FAIL-CLOSED-VALIDATION-OK\n");
    0
}
