// test: run
// exit: 40
struct Box { val: i32 }
fn consume(b: Box) -> i32 { return b.val; }
fn main() -> i32 {
    let mut sum = 0;
    let mut item = Box { val: 10 };
    let mut i = 0;
    while i < 3 {
        let current = item; // move
        sum = sum + consume(current);
        item = Box { val: 10 }; // reinit
        i = i + 1;
    }
    let last = item; // move
    let total = sum + last.val;
    if total != 40 {
        return 1;
    }
    return total;
}
