// test: run
struct Box { val: i32 }
fn consume(b: Box) -> i32 { return b.val; }
fn main() -> i32 {
    let mut sum = 0;
    let mut item = Box { val: 10 };
    let mut i = 0;
    while i < 3 {
        let current = item; // move
        sum = sum + consume(current);
        item = Box { val: 10 }; // reinit
        i = i + 1;
    }
    let last = item; // move
    if sum + last.val == 40 {
        return 0;
    }
    return 1;
}
