struct Item { val: i32 }
fn main() -> i32 {
    let mut a = Item { val: 1 };
    let mut cond = true;
    if cond {
        let b = a;
        a = Item { val: 2 };
    } else {
        let c = a;
        a = Item { val: 3 };
    }
    let d = a;
    if d.val != 2 {
        return 1;
    }
    return d.val;
}
