// test: run
// exit: 142
struct Item { val: i32 }
fn consume(i: Item) -> i32 {
    return i.val;
}
fn main() -> i32 {
    let mut a = Item { val: 42 };
    let b = a; // move
    a = Item { val: 100 }; // reinit
    let sum = b.val + consume(a);
    if sum != 142 {
        return 1;
    }
    return sum;
}
