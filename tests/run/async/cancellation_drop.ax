// test: run
// modes: interp native
// stdout: subfut_drop\nlocal2_drop\nlocal1_drop\nouter_drop\n

use std.future.Context;
use std.future.Waker;
use std.future.RawWaker;
use std.future.RawWakerVTable;

struct DroppableLocal1 {
    val: i32,
}

impl Drop for DroppableLocal1 {
    fn drop(self: mut_view<DroppableLocal1>) {
        print("local1_drop\n");
    }
}

struct DroppableLocal2 {
    val: i32,
}

impl Drop for DroppableLocal2 {
    fn drop(self: mut_view<DroppableLocal2>) {
        print("local2_drop\n");
    }
}

struct PendingSubFut {
    polled: bool,
}

impl Drop for PendingSubFut {
    fn drop(self: mut_view<PendingSubFut>) {
        print("subfut_drop\n");
    }
}

impl Future for PendingSubFut {
    type Output = i32;

    fn poll(self: mut_view<PendingSubFut>, cx: mut_view<Context>) -> Poll<i32> {
        Poll.Pending
    }
}

async fn suspended_task(l1: DroppableLocal1) -> i32 {
    let l2 = DroppableLocal2 { val: 20i32 };
    let sub = PendingSubFut { polled: false };
    let res = sub.await;
    let _ = l1.val + l2.val + res;
    res
}

fn main() -> i32 {
    let mut exit_code: i32 = 0i32;
    {
        let l1 = DroppableLocal1 { val: 10i32 };
        let mut fut = suspended_task(l1);
        let mut cx = Context {
            waker_val: Waker {
                raw: RawWaker {
                    data: 0 as *const u8,
                    vtable: 0 as *const RawWakerVTable,
                },
            },
        };
        let p = fut.poll(mut_view(cx));
        match p {
            Poll.Pending => {},
            Poll.Ready(_) => {
                exit_code = 1i32;
            },
        }
    }
    if exit_code != 0i32 {
        return exit_code;
    }
    print("outer_drop\n");
    return 0i32;
}
