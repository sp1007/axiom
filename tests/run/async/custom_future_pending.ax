// test: run
// modes: interp native
// stdout: ok\n

use std.future.block_on.block_on;

struct YieldTwice {
    pub count: i32,
    pub target: i32,
}

impl Future for YieldTwice {
    type Output = i32;

    fn poll(self: mut_view<YieldTwice>, cx: mut_view<Context>) -> Poll<i32> {
        let cur_count = self.count;
        if cur_count < 2i32 {
            self.count = self.count + 1i32;
            return Poll.Pending;
        }
        return Poll.Ready(self.target);
    }
}

async fn test_yield() -> i32 {
    let mut y = YieldTwice { count: 0i32, target: 77i32 };
    let val = y.await;
    val + 3i32
}

fn main() -> i32 {
    let res = block_on(test_yield());
    if res != 80i32 {
        return 1i32;
    }
    print("ok\n");
    return 0i32;
}
