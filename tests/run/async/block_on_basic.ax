// test: run
// modes: interp native
// stdout: ok\n

use std.future.block_on.block_on;

async fn simple_val() -> i32 {
    42i32
}

async fn add_vals(a: i32, b: i32) -> i32 {
    let x = a + b;
    x
}

fn main() -> i32 {
    let r1 = block_on(simple_val());
    if r1 != 42i32 {
        return 1i32;
    }
    let r2 = block_on(add_vals(10i32, 25i32));
    if r2 != 35i32 {
        return 2i32;
    }
    print("ok\n");
    return 0i32;
}
