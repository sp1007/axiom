// test: run
// modes: interp native
// timeout: 60
// covers: REQ-ASY-122 REQ-ASY-047
// stdout: 0: cut d9:0 \n1: cut f1 d5:1101 d1:10 d9:0 \n2: cut f2 d5:1002 d1:111 d9:0 \n3: d5:1002 cut f3 d20:101 d1:12 d9:0 \n4: d5:1002 d20:2 cut f3 d21:101 d1:12 d9:0 \n5: d5:1002 d20:2 d21:2 cut f4 d1:12 d9:101 \n6: d5:1002 d20:2 d21:2 d1:12 d9:2 ready=1020 cut \n

// QA T428a: cancellation sweep. A nested async call tree is polled `n` times and then dropped, for every `n` up to
// completion. Every in-place guard alive at the cut is dropped exactly once, innermost future first, then locals in
// reverse declaration order, then the parameter; the value printed by each destructor shows every write made through
// the pointers so far (+1 per poll of the awaited future, +100 when the pending future itself is dropped).

use std.future.Context;
use std.future.Waker;
use std.future.RawWaker;
use std.future.RawWakerVTable;

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct Guard {
    pub val: i64,
    pub tag: i64,
}

impl Drop for Guard {
    fn drop(self: mut_view<Guard>) {
        print("d");
        print_int(self.tag);
        print(":");
        print_int(self.val);
        print(" ");
    }
}

// Pending once; every poll adds 1 to `*dst`, its own drop adds 100.
struct Tick {
    pub dst: *mut i64,
    pub polls: u32,
    pub name: i64,
    pub done: bool,
}

impl Future for Tick {
    type Output = i64;

    fn poll(self: mut_view<Tick>, cx: mut_view<Context>) -> Poll<i64> {
        let d = self.dst;
        unsafe { *d = *d + 1i64; }
        if self.polls < 1u32 {
            self.polls = self.polls + 1u32;
            return Poll.Pending;
        }
        self.done = true;
        Poll.Ready(1i64)
    }
}

impl Drop for Tick {
    fn drop(self: mut_view<Tick>) {
        if self.done {
            return;
        }
        let d = self.dst;
        unsafe { *d = *d + 100i64; }
        print("f");
        print_int(self.name);
        print(" ");
    }
}

fn tick(dst: *mut i64, name: i64) -> Tick {
    Tick { dst: dst, polls: 0u32, name: name, done: false }
}

async fn inner(out: *mut i64) -> i64 {
    let mut g = Guard { val: 1000i64, tag: 5i64 };
    let p = unsafe { address_of_mut(g.val) };
    let a = tick(p, 1i64).await;
    let b = tick(out, 2i64).await;
    g.val + a + b
}

async fn outer(mut param: Guard) -> i64 {
    let pp = unsafe { address_of_mut(param.val) };
    let mut first = Guard { val: 10i64, tag: 1i64 };
    let r = inner(unsafe { address_of_mut(first.val) }).await;
    let mut acc: i64 = r;
    let mut i: i64 = 0i64;
    while i < 2i64 {
        let mut step = Guard { val: 0i64, tag: 20i64 + i };
        acc = acc + tick(unsafe { address_of_mut(step.val) }, 3i64).await;
        i = i + 1i64;
    }
    let _ = tick(pp, 4i64).await;
    acc + first.val + param.val
}

fn sweep(n: i32) {
    let mut fut = outer(Guard { val: 0i64, tag: 9i64 });
    let mut cx = Context {
        waker_val: Waker {
            raw: RawWaker {
                data: 0 as *const u8,
                vtable: 0 as *const RawWakerVTable,
            },
        },
    };
    let mut i: i32 = 0i32;
    while i < n {
        match fut.poll(mut_view(cx)) {
            Poll.Pending => {},
            Poll.Ready(v) => {
                print("ready=");
                print_int(v);
                print(" ");
                i = n;
            },
        }
        i = i + 1i32;
    }
    print("cut ");
}

fn main() -> i32 {
    let mut n: i32 = 0i32;
    while n <= 6i32 {
        print_int(n as i64);
        print(": ");
        sweep(n);
        print("\n");
        n = n + 1i32;
    }
    0i32
}
