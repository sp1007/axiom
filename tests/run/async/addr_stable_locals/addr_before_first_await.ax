// test: run
// modes: interp native
// covers: REQ-ASY-122 REQ-ASY-047
// stdout: x=1111 p=1111 b=42 sum=1150\n

// ADR-0050, SPEC-33 AXS-ASY-005 item 4 / AXS-ASY-043 item 7: the address of an `async fn` local that is taken
// before the first `.await` stays valid in every later poll. Each `AddLater` future keeps the raw pointer, returns
// Pending once and adds to the pointee during its second poll (i.e. in a later call of the outer `poll`). The local
// is read through its own name and through the pointer only after the third `.await`. A field of a struct local
// (`pair.b`, a projection of the local) is covered too.

use std.future.block_on.block_on;

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct AddLater {
    pub dst: *mut i64,
    pub add: i64,
    pub polled: bool,
}

impl Future for AddLater {
    type Output = i64;

    fn poll(self: mut_view<AddLater>, cx: mut_view<Context>) -> Poll<i64> {
        if !self.polled {
            self.polled = true;
            return Poll.Pending;
        }
        let d = self.dst;
        unsafe { *d = *d + self.add; }
        Poll.Ready(self.add)
    }
}

struct Pair {
    pub a: i64,
    pub b: i64,
}

async fn three_awaits() -> i64 {
    let mut x: i64 = 1i64;
    let p = unsafe { address_of_mut(x) };
    let mut pair = Pair { a: 0i64, b: 2i64 };
    let pb = unsafe { address_of_mut(pair.b) };
    let r1 = AddLater { dst: p, add: 10i64, polled: false }.await;
    let r2 = AddLater { dst: p, add: 100i64, polled: false }.await;
    let r3 = AddLater { dst: pb, add: 40i64, polled: false }.await;
    let r4 = AddLater { dst: p, add: 1000i64, polled: false }.await;
    let via_ptr = unsafe { *p };
    print("x=");
    print_int(x);
    print(" p=");
    print_int(via_ptr);
    print(" b=");
    print_int(pair.b);
    print(" sum=");
    print_int(r1 + r2 + r3 + r4 + pair.a);
    print("\n");
    if x != 1111i64 || via_ptr != 1111i64 || pair.b != 42i64 {
        return 1i64;
    }
    0i64
}

fn main() -> i32 {
    let rc = block_on(three_awaits());
    rc as i32
}
