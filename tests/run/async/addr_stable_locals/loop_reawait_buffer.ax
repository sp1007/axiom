// test: run
// modes: interp native
// covers: REQ-ASY-122
// stdout: buf=1,4,7,10,13,16,19,22 direct=92 total=92 again=184\n

// ADR-0050: a loop that re-awaits with the same `async fn` local buffer. Every iteration hands a pointer into the
// local array (`address_of_mut(buf[i])`, an indexed projection of the local, and a pointer computed once before the
// loop) to a future that writes through it in a later poll; the element is read back right after each `.await`, and
// a second pass doubles every element through the pointer computed before the first `.await`.

use std.future.block_on.block_on;

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct StoreLater {
    pub dst: *mut u8,
    pub val: u8,
    pub polls: u32,
}

impl Future for StoreLater {
    type Output = u8;

    fn poll(self: mut_view<StoreLater>, cx: mut_view<Context>) -> Poll<u8> {
        if self.polls < 2u32 {
            self.polls = self.polls + 1u32;
            return Poll.Pending;
        }
        let d = self.dst;
        unsafe { *d = self.val; }
        Poll.Ready(self.val)
    }
}

async fn fill() -> i64 {
    let mut buf: [8]u8 = [0u8; 8];
    let base = unsafe { address_of_mut(buf[0]) };
    let mut direct: i64 = 0i64;
    let mut i: usize = 0;
    while i < 8usize {
        let v = (i as u8) * 3u8 + 1u8;
        let got = StoreLater { dst: unsafe { address_of_mut(buf[i]) }, val: v, polls: 0u32 }.await;
        if got != v {
            return -1i64;
        }
        direct = direct + (buf[i] as i64);
        i = i + 1;
    }
    let mut total: i64 = 0i64;
    print("buf=");
    let mut j: usize = 0;
    while j < 8usize {
        if j > 0usize {
            print(",");
        }
        print_int(buf[j] as i64);
        total = total + (buf[j] as i64);
        j = j + 1;
    }
    // second pass through the pointer taken before the first `.await`
    let mut k: usize = 0;
    while k < 8usize {
        let cur = unsafe { *(base + k) };
        let _ = StoreLater { dst: unsafe { base + k }, val: cur * 2u8, polls: 0u32 }.await;
        k = k + 1;
    }
    let mut again: i64 = 0i64;
    let mut m: usize = 0;
    while m < 8usize {
        again = again + (buf[m] as i64);
        m = m + 1;
    }
    print(" direct=");
    print_int(direct);
    print(" total=");
    print_int(total);
    print(" again=");
    print_int(again);
    print("\n");
    if direct != 92i64 || total != 92i64 || again != 184i64 {
        return 1i64;
    }
    0i64
}

fn main() -> i32 {
    let rc = block_on(fill());
    rc as i32
}
