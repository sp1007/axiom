// test: run
// modes: interp native
// timeout: 60
// covers: REQ-ASY-122 REQ-ASY-047
// stdout: sub drop | guard 43 here=1\ncancelled=1\n

// ADR-0050: cancelling a spawned task drops its pending state machine where it is (the task control block), it does
// not move it first. The awaited future writes through its pointer to the in-place local while it is dropped; the
// local's destructor, which runs next, must see that write and must run at the address the future was given.

module test.cancel_spawned_task

use std.asyn.executor.LocalExecutor
use std.asyn.task.TaskResult

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct Guard {
    pub val: i64,
    pub seen: *mut usize,
}

impl Drop for Guard {
    fn drop(self: mut_view<Guard>) {
        let here = unsafe { address_of_mut(*self) as *mut Guard as usize };
        let given = unsafe { *self.seen };
        print("guard ");
        print_int(self.val);
        print(" here=");
        print_int(if here == given { 1i64 } else { 0i64 });
        print("\n");
    }
}

struct Never {
    pub dst: *mut Guard,
    pub seen: *mut usize,
}

impl Future for Never {
    type Output = i64;

    fn poll(self: mut_view<Never>, cx: mut_view<Context>) -> Poll<i64> {
        let d = self.dst;
        unsafe {
            (*d).val = 42i64;
            *self.seen = d as usize;
        }
        Poll.Pending
    }
}

impl Drop for Never {
    fn drop(self: mut_view<Never>) {
        let d = self.dst;
        unsafe { (*d).val = (*d).val + 1i64; }
        print("sub drop | ");
    }
}

async fn guarded(seen: *mut usize) -> i64 {
    let mut g = Guard { val: 7i64, seen: seen };
    let f = Never { dst: unsafe { address_of_mut(g) as *mut Guard }, seen: seen };
    let r = f.await;
    g.val + r
}

pub fn main() -> i32 {
    let mut exec = LocalExecutor.new();
    let mut seen: usize = 0usize;
    let h = mut_view(exec).spawn_local(guarded(unsafe { address_of_mut(seen) }));
    let _ = mut_view(exec).try_tick();
    if seen == 0usize {
        return 2i32;
    }
    view(h).cancel();
    let cancelled = match mut_view(exec).block_on(h.join()) {
        TaskResult.Cancelled => 1i64,
        _ => 0i64,
    };
    mut_view(exec).shutdown();
    print("cancelled=");
    print_int(cancelled);
    print("\n");
    0i32
}
