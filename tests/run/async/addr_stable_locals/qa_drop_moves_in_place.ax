// test: run
// modes: interp native
// timeout: 60
// covers: REQ-ASY-122 REQ-ASY-047
// stdout: reassign d1 d2 =12\nreturned =9 d3 \nmoved_last eaten d4 =14\ncond a d5 b =15\ncond a b d5 =15\npartial d6 x d7 =13\ntake x d8 y =8\nhandoff in d9 out =10\nshadow d11 d10 =21\nbreak d12 d13 d14 after =39\nheap x=81 n=40\ndeferred d20 =1\ndeferred =0\n

// QA T428a: ownership of address-observable (in-place) locals with `Drop`. Each `Guard` prints `d<tag>` when dropped;
// every guard must be dropped exactly once, at the point the synchronous semantics prescribe: reassignment, return of
// the local, move after the last `.await`, conditional move after the last `.await`, partial move, `Option` take,
// hand-off to another async fn, shadowing, `break` out of a loop that awaits, heap-owning locals.

use std.future.block_on.block_on;
use std.future.Context;
use std.core.option.Option
use std.text.string.string_new
use std.text.string.string_push_char
use std.text.string.string_len

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct Guard {
    pub val: i64,
    pub tag: i64,
}

impl Drop for Guard {
    fn drop(self: mut_view<Guard>) {
        print("d");
        print_int(self.tag);
        print(" ");
    }
}

struct Add {
    pub dst: *mut i64,
    pub add: i64,
    pub polls: u32,
}

impl Future for Add {
    type Output = i64;

    fn poll(self: mut_view<Add>, cx: mut_view<Context>) -> Poll<i64> {
        if self.polls < 2u32 {
            self.polls = self.polls + 1u32;
            return Poll.Pending;
        }
        let d = self.dst;
        unsafe { *d = *d + self.add; }
        Poll.Ready(self.add)
    }
}

fn add(dst: *mut i64, n: i64) -> Add {
    Add { dst: dst, add: n, polls: 0u32 }
}

fn eat(g: Guard) -> i64 {
    print("eaten ");
    g.val
}

async fn reassign() -> i64 {
    let mut g = Guard { val: 1i64, tag: 1i64 };
    let p = unsafe { address_of_mut(g.val) };
    let _ = add(p, 1i64).await;
    g = Guard { val: 5i64 + g.val, tag: 2i64 };
    let _ = add(p, 5i64).await;
    g.val
}

async fn returned() -> Guard {
    let mut g = Guard { val: 4i64, tag: 3i64 };
    let p = unsafe { address_of_mut(g.val) };
    let _ = add(p, 5i64).await;
    g
}

async fn moved_last() -> i64 {
    let mut g = Guard { val: 4i64, tag: 4i64 };
    let p = unsafe { address_of_mut(g.val) };
    let _ = add(p, 5i64).await;
    let _ = add(p, 5i64).await;
    eat(g)
}

fn swallow(g: Guard) {
}

async fn cond(c: bool) -> i64 {
    let mut g = Guard { val: 5i64, tag: 5i64 };
    let p = unsafe { address_of_mut(g.val) };
    let _ = add(p, 10i64).await;
    let v = g.val;
    print("a ");
    if c {
        swallow(g);
    }
    print("b ");
    v
}

struct Two {
    pub a: Guard,
    pub b: Guard,
    pub n: i64,
}

async fn partial() -> i64 {
    let mut two = Two { a: Guard { val: 3i64, tag: 6i64 }, b: Guard { val: 2i64, tag: 7i64 }, n: 0i64 };
    let pb = unsafe { address_of_mut(two.b.val) };
    let _ = add(pb, 8i64).await;
    let v = two.a.val;
    swallow(two.a);
    print("x ");
    v + two.b.val
}

async fn take() -> i64 {
    let mut o = Option.Some(Guard { val: 3i64, tag: 8i64 });
    let p = unsafe { address_of_mut(o) };
    let mut n: i64 = 3i64;
    let q = unsafe { address_of_mut(n) };
    let _ = add(q, 5i64).await;
    print(if (p as usize) == (unsafe { address_of_mut(o) as usize }) { "x " } else { "moved " });
    let _ = add(q, 0i64).await;
    match o {
        Option.Some(g) => swallow(g),
        Option.None => print("none "),
    }
    print("y ");
    n
}

async fn receiver(mut g: Guard) -> i64 {
    print("in ");
    let p = unsafe { address_of_mut(g.val) };
    let _ = add(p, 1i64).await;
    g.val
}

async fn handoff() -> i64 {
    let mut g = Guard { val: 4i64, tag: 9i64 };
    let p = unsafe { address_of_mut(g.val) };
    let _ = add(p, 5i64).await;
    let r = receiver(g).await;
    print("out ");
    r
}

async fn shadow() -> i64 {
    let mut g = Guard { val: 1i64, tag: 10i64 };
    let p = unsafe { address_of_mut(g.val) };
    let mut g = Guard { val: 2i64, tag: 11i64 };
    let q = unsafe { address_of_mut(g.val) };
    let _ = add(p, 9i64).await;
    let _ = add(q, 9i64).await;
    g.val + (unsafe { *p })
}

async fn breaks() -> i64 {
    let mut t: i64 = 0i64;
    let mut i: i64 = 0i64;
    loop {
        let mut g = Guard { val: 12i64 + i, tag: 12i64 + i };
        let p = unsafe { address_of_mut(g.val) };
        let _ = add(p, 0i64).await;
        t = t + g.val;
        if i == 2i64 {
            break;
        }
        i = i + 1i64;
    }
    print("after ");
    t
}

async fn heap() -> i64 {
    let mut s = string_new();
    string_push_char(mut_view(s), 'x');
    let mut n: i64 = 0i64;
    let p = unsafe { address_of_mut(n) };
    let mut i: i64 = 0i64;
    while i < 40i64 {
        let _ = add(p, 1i64).await;
        string_push_char(mut_view(s), 'à');
        i = i + 1i64;
    }
    let t = n;
    print("x=");
    print_int(string_len(view(s)) as i64);
    print(" n=");
    print_int(t);
    print("\n");
    0i64
}

async fn deferred(c: bool) -> i64 {
    let mut n: i64 = 0i64;
    let p = unsafe { address_of_mut(n) };
    let _ = add(p, 0i64).await;
    let g: Guard;
    if c {
        g = Guard { val: 1i64, tag: 20i64 };
        n = g.val;
    }
    n
}

fn fin(v: i64) {
    print("=");
    print_int(v);
    print("\n");
}

fn main() -> i32 {
    print("reassign ");
    fin(block_on(reassign()));
    print("returned ");
    {
        let g = block_on(returned());
        print("=");
        print_int(g.val);
        print(" ");
    }
    print("\nmoved_last ");
    fin(block_on(moved_last()));
    print("cond ");
    fin(block_on(cond(true)));
    print("cond ");
    fin(block_on(cond(false)));
    print("partial ");
    fin(block_on(partial()));
    print("take ");
    fin(block_on(take()));
    print("handoff ");
    fin(block_on(handoff()));
    print("shadow ");
    fin(block_on(shadow()));
    print("break ");
    fin(block_on(breaks()));
    print("heap ");
    let _ = block_on(heap());
    print("deferred ");
    fin(block_on(deferred(true)));
    print("deferred ");
    fin(block_on(deferred(false)));
    0i32
}
