// test: run
// modes: interp native
// covers: REQ-ASY-122 REQ-ASY-047
// stdout: pending\nguard drop val=42\ndrops=1\n

// ADR-0050 + SPEC-33 AXS-ASY-044: a future cancelled (dropped while pending) whose suspended state holds an
// address-observable local with `Drop`. The awaited future writes through a pointer to a field of that local while
// it is pending; the cancellation drop glue then drops the in-place field exactly once, and the destructor sees the
// value written through the pointer (it would see the stale value 7 if the local had been relocated).

use std.future.Context;
use std.future.Waker;
use std.future.RawWaker;
use std.future.RawWakerVTable;

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct Guard {
    pub val: i64,
    pub drops: *mut i64,
}

impl Drop for Guard {
    fn drop(self: mut_view<Guard>) {
        print("guard drop val=");
        print_int(self.val);
        print("\n");
        let d = self.drops;
        unsafe { *d = *d + 1i64; }
    }
}

struct SetThenPend {
    pub dst: *mut i64,
}

impl Future for SetThenPend {
    type Output = i64;

    fn poll(self: mut_view<SetThenPend>, cx: mut_view<Context>) -> Poll<i64> {
        let d = self.dst;
        unsafe { *d = 42i64; }
        Poll.Pending
    }
}

async fn guarded(drops: *mut i64) -> i64 {
    let mut g = Guard { val: 7i64, drops: drops };
    let pv = unsafe { address_of_mut(g.val) };
    let r = SetThenPend { dst: pv }.await;
    g.val + r
}

fn main() -> i32 {
    let mut drops: i64 = 0i64;
    let pd = unsafe { address_of_mut(drops) };
    {
        let mut fut = guarded(pd);
        let mut cx = Context {
            waker_val: Waker {
                raw: RawWaker {
                    data: 0 as *const u8,
                    vtable: 0 as *const RawWakerVTable,
                },
            },
        };
        match fut.poll(mut_view(cx)) {
            Poll.Pending => print("pending\n"),
            Poll.Ready(_) => return 2i32,
        }
    }
    print("drops=");
    print_int(drops);
    print("\n");
    if drops != 1i64 {
        return 1i32;
    }
    0i32
}
