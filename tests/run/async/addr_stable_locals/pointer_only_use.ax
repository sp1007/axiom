// test: run
// modes: interp native
// covers: REQ-ASY-122 REQ-ASY-047
// stdout: via=1207 param=55 idx=2,30 dest=9 part=3,8\n

// ADR-0050, corner cases of "address observable": (1) the local is never named again after the `.await`, only read
// through the pointer; (2) a parameter; (3) a local that is both address-taken and used as an index, changed through
// the pointer while the task is suspended; (4) the destination of the `.await` is the local whose address was taken;
// (5) the destination is a part of such a local.

use std.future.block_on.block_on;

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct AddLater {
    pub dst: *mut i64,
    pub add: i64,
    pub polls: u32,
}

impl Future for AddLater {
    type Output = i64;

    fn poll(self: mut_view<AddLater>, cx: mut_view<Context>) -> Poll<i64> {
        if self.polls < 1u32 {
            self.polls = self.polls + 1u32;
            return Poll.Pending;
        }
        let d = self.dst;
        unsafe { *d = *d + self.add; }
        Poll.Ready(self.add)
    }
}

struct SetIndexLater {
    pub dst: *mut usize,
    pub val: usize,
    pub polls: u32,
}

impl Future for SetIndexLater {
    type Output = i64;

    fn poll(self: mut_view<SetIndexLater>, cx: mut_view<Context>) -> Poll<i64> {
        if self.polls < 1u32 {
            self.polls = self.polls + 1u32;
            return Poll.Pending;
        }
        let d = self.dst;
        unsafe { *d = self.val; }
        Poll.Ready(0i64)
    }
}

// The buffer is only reachable through `p` after its initialization.
async fn pointer_only() -> i64 {
    let mut cell: [4]i64 = [0i64, 1200i64, 0i64, 0i64];
    let p = unsafe { address_of_mut(cell[1]) };
    let a = AddLater { dst: p, add: 3i64, polls: 0u32 }.await;
    let b = AddLater { dst: p, add: 4i64, polls: 0u32 }.await;
    let v = unsafe { *p };
    v + a - 3i64 + b - 4i64
}

async fn param_addr(mut x: i64) -> i64 {
    let p = unsafe { address_of_mut(x) };
    let _ = AddLater { dst: p, add: 50i64, polls: 0u32 }.await;
    x
}

async fn index_addr() -> i64 {
    let table: [4]i64 = [0i64, 10i64, 30i64, 40i64];
    let mut i: usize = 1usize;
    let p = unsafe { address_of_mut(i) };
    let _ = SetIndexLater { dst: p, val: 2usize, polls: 0u32 }.await;
    (i as i64) * 1000i64 + table[i]
}

async fn dest_is_local() -> i64 {
    let mut x: i64 = 1i64;
    let p = unsafe { address_of_mut(x) };
    x = AddLater { dst: p, add: 7i64, polls: 0u32 }.await;
    let seen = unsafe { *p };
    let _ = AddLater { dst: p, add: 2i64, polls: 0u32 }.await;
    if seen != 7i64 {
        return -1i64;
    }
    x
}

struct Pair {
    pub a: i64,
    pub b: i64,
}

async fn dest_is_part() -> i64 {
    let mut pair = Pair { a: 1i64, b: 2i64 };
    let pa = unsafe { address_of_mut(pair.a) };
    pair.b = AddLater { dst: pa, add: 2i64, polls: 0u32 }.await;
    let _ = AddLater { dst: unsafe { address_of_mut(pair.b) }, add: 6i64, polls: 0u32 }.await;
    pair.a * 100i64 + pair.b
}

fn main() -> i32 {
    let v1 = block_on(pointer_only());
    let v2 = block_on(param_addr(5i64));
    let v3 = block_on(index_addr());
    let v4 = block_on(dest_is_local());
    let v5 = block_on(dest_is_part());
    print("via=");
    print_int(v1);
    print(" param=");
    print_int(v2);
    print(" idx=");
    print_int(v3 / 1000i64);
    print(",");
    print_int(v3 % 1000i64);
    print(" dest=");
    print_int(v4);
    print(" part=");
    print_int(v5 / 100i64);
    print(",");
    print_int(v5 % 100i64);
    print("\n");
    0i32
}
