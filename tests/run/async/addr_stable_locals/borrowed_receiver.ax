// test: run
// modes: interp native
// covers: REQ-ASY-122
// stdout: 6 35 105 8 1111\n

// ADR-0050: borrowed (not raw-pointer) locals that nothing names after the `.await`. A method keeps a raw pointer to
// its receiver inside the returned future (as `ReadExactFuture` does): held() and held_block() keep the future in a
// variable before awaiting it, held_temp() borrows a temporary of the awaited expression, held_param() a parameter.
// dest_part(): the result is stored into a part of a local whose other parts stay live.

use std.future.block_on.block_on;

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct Cell {
    pub v: i64,
}

struct Later {
    pub dst: *mut Cell,
    pub polls: u32,
}

impl Future for Later {
    type Output = i64;

    fn poll(self: mut_view<Later>, cx: mut_view<Context>) -> Poll<i64> {
        if self.polls < 2u32 {
            self.polls = self.polls + 1u32;
            return Poll.Pending;
        }
        let d = self.dst;
        unsafe { (*d).v = (*d).v + 5i64; }
        Poll.Ready(unsafe { (*d).v })
    }
}

impl Cell {
    fn later(self: mut_view<Cell>) -> Later {
        Later { dst: unsafe { address_of_mut(*self) as *mut Cell }, polls: 0u32 }
    }
}

fn make() -> Cell {
    Cell { v: 30i64 }
}

async fn held() -> i64 {
    let mut c = Cell { v: 1i64 };
    let f = mut_view(c).later();
    f.await
}

async fn held_temp() -> i64 {
    make().later().await
}

async fn held_block() -> i64 {
    let r = {
        let mut c = Cell { v: 100i64 };
        let f = mut_view(c).later();
        f.await
    };
    r
}

async fn held_param(mut c: Cell) -> i64 {
    let f = mut_view(c).later();
    f.await
}

struct Pair {
    pub a: i64,
    pub b: i64,
}

async fn dest_part() -> i64 {
    let mut src = Cell { v: -4i64 };
    let mut p = Pair { a: 1i64, b: 2i64 };
    p.b = mut_view(src).later().await;
    p.a * 1000i64 + p.b * 111i64
}

fn main() -> i32 {
    print_int(block_on(held()));
    print(" ");
    print_int(block_on(held_temp()));
    print(" ");
    print_int(block_on(held_block()));
    print(" ");
    print_int(block_on(held_param(Cell { v: 3i64 })));
    print(" ");
    print_int(block_on(dest_part()));
    print("\n");
    0i32
}
