// test: run
// modes: interp native
// timeout: 60
// covers: REQ-ASY-122 REQ-ASY-047
// stdout: polls=2 moved=0\nsub drop | guard 45 here=1\nresult=panicked\n

// QA T428a round 1: the other caller of `tcb_drop_future` (SPEC-34 AXS-EXEC-007 panic containment). The task is
// polled three times while pending (the poll frame must see the in-place local at one address each time); the third
// poll calls `task_panic` and returns Pending, so `tcb_poll_fn` drops the future of a PANICKED task. That drop must
// happen in the control block (ADR-0050, SPEC-33 AXS-ASY-005 item 4): the awaited future's Drop writes through its
// pointer into the in-place local, and the local's Drop, which runs next, must see the write at the same address.

module test.qa_r1_panic_pending_inplace

use std.asyn.executor.LocalExecutor
use std.asyn.task.TaskResult
use std.asyn.task.task_panic

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct Guard {
    pub val: i64,
    pub seen: *mut usize,
}

impl Drop for Guard {
    fn drop(self: mut_view<Guard>) {
        let here = unsafe { address_of_mut(*self) as *mut Guard as usize };
        let given = unsafe { *self.seen };
        print("guard ");
        print_int(self.val);
        print(" here=");
        print_int(if here == given { 1i64 } else { 0i64 });
        print("\n");
    }
}

struct Flaky {
    pub dst: *mut Guard,
    pub seen: *mut usize,
    pub polls: *mut i64,
    pub moved: *mut i64,
}

impl Future for Flaky {
    type Output = i64;

    fn poll(self: mut_view<Flaky>, cx: mut_view<Context>) -> Poll<i64> {
        let d = self.dst;
        unsafe {
            if *self.seen != 0usize && *self.seen != (d as usize) {
                *self.moved = *self.moved + 1i64;
            }
            *self.seen = d as usize;
            (*d).val = (*d).val + 1i64;
            *self.polls = *self.polls + 1i64;
            if *self.polls == 3i64 {
                task_panic(cx);
            } else {
                cx.waker().wake_by_ref();
            }
        }
        Poll.Pending
    }
}

impl Drop for Flaky {
    fn drop(self: mut_view<Flaky>) {
        let d = self.dst;
        unsafe { (*d).val = (*d).val + 1i64; }
        print("sub drop | ");
    }
}

async fn guarded(seen: *mut usize, polls: *mut i64, moved: *mut i64) -> i64 {
    let mut g = Guard { val: 41i64, seen: seen };
    let f = Flaky { dst: unsafe { address_of_mut(g) as *mut Guard }, seen: seen, polls: polls, moved: moved };
    let r = f.await;
    g.val + r
}

pub fn main() -> i32 {
    let mut exec = LocalExecutor.new();
    let mut seen: usize = 0usize;
    let mut polls: i64 = 0i64;
    let mut moved: i64 = 0i64;
    let h = mut_view(exec).spawn_local(guarded(unsafe { address_of_mut(seen) }, unsafe { address_of_mut(polls) },
        unsafe { address_of_mut(moved) }));
    let _ = mut_view(exec).try_tick();
    let _ = mut_view(exec).try_tick();
    print("polls=");
    print_int(polls);
    print(" moved=");
    print_int(moved);
    print("\n");
    let _ = mut_view(exec).try_tick();
    let res = match mut_view(exec).block_on(h.join()) {
        TaskResult.Panicked => "panicked",
        TaskResult.Cancelled => "cancelled",
        TaskResult.Completed(_) => "completed",
    };
    mut_view(exec).shutdown();
    print("result=");
    print(res);
    print("\n");
    0i32
}
