// test: run
// modes: interp native
// timeout: 90
// covers: REQ-ASY-122 REQ-ASY-157
// stdout: rx=3084 tail=77\n

// T428 F1 repro (ADR-0050): `recv_from` into an array that is a local of the receiving `async fn`. The
// `UdpRecvFromFuture` keeps the destination pointer and copies the datagram into it during a later poll, so the
// local must stay in place across the `.await` (oracle: no dangling pointer; native: the bytes land in the local).

module test.udp_recv_from_local

use std.core.result.Result
use std.asyn.executor.LocalExecutor
use std.asyn.task.TaskResult
use std.net.SocketAddr
use std.net.AsyncUdpSocket

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

async fn rx(b: *const AsyncUdpSocket) -> i64 {
    let mut buf: [16]u8 = [0u8; 16];
    let n = match unsafe { view(*b).recv_from(address_of_mut(buf[0]), 16usize).await } {
        Result.Ok(p) => p.0,
        Result.Err(_) => return -1i64,
    };
    (n as i64) * 1000i64 + (buf[0] as i64)
}

// A second receive into a different local after the first one: both locals are live across both awaits.
async fn rx_two(b: *const AsyncUdpSocket) -> i64 {
    let mut first: [4]u8 = [0u8; 4];
    let mut second: [4]u8 = [0u8; 4];
    match unsafe { view(*b).recv_from(address_of_mut(first[0]), 4usize).await } {
        Result.Ok(_) => {},
        Result.Err(_) => return -1i64,
    }
    match unsafe { view(*b).recv_from(address_of_mut(second[0]), 4usize).await } {
        Result.Ok(_) => {},
        Result.Err(_) => return -2i64,
    }
    (first[1] as i64) + (second[2] as i64)
}

pub fn main() -> i32 {
    let mut exec = LocalExecutor.new();
    let r = view(exec).reactor();
    let a = match AsyncUdpSocket.bind(r, SocketAddr.localhost(0u16)) {
        Result.Ok(s) => s,
        Result.Err(_) => return 1i32,
    };
    let b = match AsyncUdpSocket.bind(r, SocketAddr.localhost(0u16)) {
        Result.Ok(s) => s,
        Result.Err(_) => return 2i32,
    };
    let b_addr = view(b).local_addr();
    let pb = unsafe { address_of(b) };

    let h = mut_view(exec).spawn_local(rx(pb));
    let msg: [3]u8 = [84u8, 73u8, 77u8]; // "TIM"
    match mut_view(exec).block_on(view(a).send_to(unsafe { address_of(msg[0]) }, 3usize, b_addr)) {
        Result.Ok(_) => {},
        Result.Err(_) => return 3i32,
    }
    let v = match mut_view(exec).block_on(h.join()) {
        TaskResult.Completed(x) => x,
        _ => -100i64,
    };

    let h2 = mut_view(exec).spawn_local(rx_two(pb));
    let m1: [4]u8 = [1u8, 30u8, 3u8, 4u8];
    let m2: [4]u8 = [5u8, 6u8, 47u8, 8u8];
    match mut_view(exec).block_on(view(a).send_to(unsafe { address_of(m1[0]) }, 4usize, b_addr)) {
        Result.Ok(_) => {},
        Result.Err(_) => return 4i32,
    }
    match mut_view(exec).block_on(view(a).send_to(unsafe { address_of(m2[0]) }, 4usize, b_addr)) {
        Result.Ok(_) => {},
        Result.Err(_) => return 5i32,
    }
    let v2 = match mut_view(exec).block_on(h2.join()) {
        TaskResult.Completed(x) => x,
        _ => -100i64,
    };

    let _ = a.close();
    let _ = b.close();
    mut_view(exec).shutdown();
    print("rx=");
    print_int(v);
    print(" tail=");
    print_int(v2);
    print("\n");
    if v != 3084i64 || v2 != 77i64 {
        return 6i32;
    }
    0i32
}
