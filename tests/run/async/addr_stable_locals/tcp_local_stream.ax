// test: run
// modes: interp native
// timeout: 90
// covers: REQ-ASY-122 REQ-ASY-157
// stdout: server=11055 client=4 22 33 44 55 sum=154\n

// T428 F1 (ADR-0050): TCP I/O on a stream and on buffers that are all locals of the `async fn` tasks. The accepted
// and the connected stream live in the tasks (`ReadExactFuture`/`WriteAllFuture` keep a pointer to the stream
// local), the destination/source buffers are task-local arrays (`read`, `read_exact`, `write_all` keep raw pointers
// into them across `.await`).

module test.tcp_local_stream

use std.core.result.Result
use std.asyn.executor.LocalExecutor
use std.asyn.task.TaskResult
use std.asyn.task.LocalTaskHandle
use std.asyn.reactor.Reactor
use std.io.async_io.AsyncRead
use std.net.SocketAddr
use std.net.AsyncTcpListener
use std.net.AsyncTcpStream

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

// Accepts one connection, reads 4 bytes with read_exact into a local, sends them back incremented by 11 with
// write_all from another local. Returns the first received byte * 1000 + the last byte sent.
async fn server(l: *const AsyncTcpListener) -> i64 {
    let mut s = match unsafe { view(*l).accept().await } {
        Result.Ok(p) => p.0,
        Result.Err(_) => return -1i64,
    };
    let mut inb: [4]u8 = [0u8; 4];
    match mut_view(s).read_exact(unsafe { address_of_mut(inb[0]) }, 4usize).await {
        Result.Ok(_) => {},
        Result.Err(_) => return -2i64,
    }
    let mut outb: [4]u8 = [0u8; 4];
    let mut k: usize = 0;
    while k < 4usize {
        outb[k] = inb[k] + 11u8;
        k = k + 1;
    }
    match mut_view(s).write_all(unsafe { address_of(outb[0]) }, 4usize).await {
        Result.Ok(_) => {},
        Result.Err(_) => return -3i64,
    }
    let _ = s.close();
    (inb[0] as i64) * 1000i64 + (outb[3] as i64)
}

// Connects, sends 4 bytes with write_all, then reads the reply with `read` (slice form, possibly short) followed by
// read_exact for the rest. Returns the number of bytes read * 10^8 + the reply packed as 4 decimal pairs.
async fn client(r: *mut Reactor, port: u16) -> i64 {
    let mut c = match AsyncTcpStream.connect(r, SocketAddr.localhost(port)).await {
        Result.Ok(s) => s,
        Result.Err(_) => return -1i64,
    };
    let req: [4]u8 = [11u8, 22u8, 33u8, 44u8];
    match mut_view(c).write_all(unsafe { address_of(req[0]) }, 4usize).await {
        Result.Ok(_) => {},
        Result.Err(_) => return -2i64,
    }
    let mut rep: [4]u8 = [0u8; 4];
    let n = match mut_view(c).read(unsafe { address_of_mut(rep[0]) }, 4usize).await {
        Result.Ok(n) => n,
        Result.Err(_) => return -3i64,
    };
    if n == 0usize || n > 4usize {
        return -4i64;
    }
    if n < 4usize {
        match mut_view(c).read_exact(unsafe { address_of_mut(rep[n]) }, 4usize - n).await {
            Result.Ok(_) => {},
            Result.Err(_) => return -5i64,
        }
    }
    let _ = c.close();
    400000000i64 + (rep[0] as i64) * 1000000i64 + (rep[1] as i64) * 10000i64 + (rep[2] as i64) * 100i64 + (rep[3] as i64)
}

pub fn main() -> i32 {
    let mut exec = LocalExecutor.new();
    let r = view(exec).reactor();
    let listener = match AsyncTcpListener.bind(r, SocketAddr.localhost(0u16)) {
        Result.Ok(l) => l,
        Result.Err(_) => return 1i32,
    };
    let port = view(listener).local_addr().port;
    let pl = unsafe { address_of(listener) };
    let h_srv = mut_view(exec).spawn_local(server(pl));
    let h_cli = mut_view(exec).spawn_local(client(r, port));
    let c = match mut_view(exec).block_on(h_cli.join()) {
        TaskResult.Completed(v) => v,
        _ => -100i64,
    };
    let s = match mut_view(exec).block_on(h_srv.join()) {
        TaskResult.Completed(v) => v,
        _ => -100i64,
    };
    let _ = listener.close();
    mut_view(exec).shutdown();

    print("server=");
    print_int(s);
    print(" client=");
    if c < 0i64 {
        print_int(c);
        print("\n");
        return 2i32;
    }
    let a0 = (c / 1000000i64) % 100i64;
    let a1 = (c / 10000i64) % 100i64;
    let a2 = (c / 100i64) % 100i64;
    let a3 = c % 100i64;
    print_int(c / 100000000i64);
    print(" ");
    print_int(a0);
    print(" ");
    print_int(a1);
    print(" ");
    print_int(a2);
    print(" ");
    print_int(a3);
    print(" sum=");
    print_int(a0 + a1 + a2 + a3);
    print("\n");
    if s != 11055i64 || a0 + a1 + a2 + a3 != 154i64 {
        return 3i32;
    }
    0i32
}
