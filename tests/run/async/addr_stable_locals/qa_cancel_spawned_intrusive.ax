// test: run
// modes: interp native
// timeout: 60
// covers: REQ-ASY-122 REQ-ASY-047
// stdout: linked 7\nnode drop\ncancelled=1\nlist empty\n

// QA T428a (scope item 2): a node that lives in an async fn local registers its own address in a list head owned by `main` and removes itself
// in its destructor (an intrusive list). SPEC-33 AXS-ASY-005 item 4: the local's address is stable and std executors
// never move a polled future, so the node must remove itself when the task is cancelled.

module test.qa_cancel_spawned_intrusive

use std.asyn.executor.LocalExecutor
use std.asyn.task.TaskResult

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct Head {
    pub first: *mut Node,
}

struct Node {
    pub val: i64,
    pub head: *mut Head,
}

impl Drop for Node {
    fn drop(self: mut_view<Node>) {
        let me = unsafe { address_of_mut(*self) as *mut Node };
        let h = self.head;
        unsafe {
            if ((*h).first as usize) == (me as usize) {
                (*h).first = 0 as *mut Node;
            }
        }
        print("node drop\n");
    }
}

struct Never {
    pub polls: i64,
}

impl Future for Never {
    type Output = i64;

    fn poll(self: mut_view<Never>, cx: mut_view<Context>) -> Poll<i64> {
        self.polls = self.polls + 1i64;
        Poll.Pending
    }
}

async fn linked(head: *mut Head) -> i64 {
    let mut n = Node { val: 7i64, head: head };
    unsafe { (*head).first = address_of_mut(n) as *mut Node; }
    let r = Never { polls: 0i64 }.await;
    n.val + r
}

pub fn main() -> i32 {
    let mut exec = LocalExecutor.new();
    let mut head = Head { first: 0 as *mut Node };
    let ph = unsafe { address_of_mut(head) as *mut Head };
    let h = mut_view(exec).spawn_local(linked(ph));
    let _ = mut_view(exec).try_tick();
    let linked_now = unsafe { ((*ph).first as usize) != 0usize };
    print(if linked_now { "linked " } else { "unlinked " });
    let v = unsafe { (*((*ph).first)).val };
    print_int(v);
    print("\n");
    view(h).cancel();
    let cancelled = match mut_view(exec).block_on(h.join()) {
        TaskResult.Cancelled => 1i64,
        _ => 0i64,
    };
    mut_view(exec).shutdown();
    print("cancelled=");
    print_int(cancelled);
    print("\n");
    let still = unsafe { ((*ph).first as usize) != 0usize };
    if still {
        print("dangling node, val=");
        print_int(unsafe { (*((*ph).first)).val });
        print("\n");
        return 1i32;
    }
    print("list empty\n");
    0i32
}
