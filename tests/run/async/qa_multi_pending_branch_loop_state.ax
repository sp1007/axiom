// test: run
// modes: interp native
// stdout: loop_0_even\ndrop_d_0\nloop_1_odd\nloop_2_even\ndrop_d_2\nloop_done\n

use std.future.block_on.block_on;
use std.future.Context;

struct DroppableLocal {
    id: i32,
}

impl Drop for DroppableLocal {
    fn drop(self: mut_view<DroppableLocal>) {
        if self.id == 0i32 {
            print("drop_d_0\n");
        } else if self.id == 2i32 {
            print("drop_d_2\n");
        } else {
            print("drop_d_other\n");
        }
    }
}

struct MultiStepYield {
    pub step: i32,
    pub val: i32,
}

impl Future for MultiStepYield {
    type Output = i32;

    fn poll(self: mut_view<MultiStepYield>, cx: mut_view<Context>) -> Poll<i32> {
        let cur = self.step;
        if cur < 2i32 {
            self.step = cur + 1i32;
            return Poll.Pending;
        }
        return Poll.Ready(self.val);
    }
}

async fn run_loop_work() -> i32 {
    let mut total: i32 = 0i32;
    let mut i: i32 = 0i32;
    while (i < 3i32) {
        if (i % 2i32) == 0i32 {
            let d = DroppableLocal { id: i };
            let mut y1 = MultiStepYield { step: 0i32, val: 10i32 };
            let r1 = y1.await;
            if d.id == 0i32 {
                print("loop_0_even\n");
            } else if d.id == 2i32 {
                print("loop_2_even\n");
            }
            total = total + r1 + d.id;
        } else {
            let mut y2 = MultiStepYield { step: 0i32, val: 100i32 };
            let r2 = y2.await;
            print("loop_1_odd\n");
            total = total + r2 + i;
        }
        i = i + 1i32;
    }
    total + 1000i32
}

fn main() -> i32 {
    let res = block_on(run_loop_work());
    if res != 1123i32 {
        return 1i32;
    }
    print("loop_done\n");
    return 0i32;
}
