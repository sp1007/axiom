// test: run
// modes: interp native
// stdout: ok\n

use std.future.block_on.block_on;

async fn compute_odd(x: i32) -> i32 {
    x * 3i32 + 1i32
}

async fn compute_even(x: i32) -> i32 {
    x / 2i32
}

async fn step_branch(x: i32) -> i32 {
    if (x % 2i32) == 0i32 {
        let v = compute_even(x).await;
        v
    } else {
        let v = compute_odd(x).await;
        v
    }
}

async fn sum_steps(mut n: i32) -> i32 {
    let mut sum: i32 = 0i32;
    while n > 0i32 {
        let s = step_branch(n).await;
        sum = sum + s;
        n = n - 1i32;
    }
    sum
}

fn main() -> i32 {
    // step_branch(1) -> compute_odd(1) = 4
    // step_branch(2) -> compute_even(2) = 1
    // step_branch(3) -> compute_odd(3) = 10
    // sum = 10 + 1 + 4 = 15
    let res = block_on(sum_steps(3i32));
    if res != 15i32 {
        return 1i32;
    }
    print("ok\n");
    return 0i32;
}
