// test: run
// modes: interp native
// stdout: ok\n

use std.future.block_on.block_on;

async fn check_positive(x: i32) -> Result<i32, i32> {
    if x < 0i32 {
        return Result.Err(x);
    }
    Result.Ok(x * 2i32)
}

async fn process_values(a: i32, b: i32) -> Result<i32, i32> {
    let val_a = check_positive(a).await?;
    let val_b = check_positive(b).await?;
    Result.Ok(val_a + val_b)
}

fn main() -> i32 {
    let r1 = block_on(process_values(5i32, 10i32));
    match r1 {
        Result.Ok(v) => {
            if v != 30i32 {
                return 1i32;
            }
        },
        Result.Err(_) => {
            return 2i32;
        },
    }

    let r2 = block_on(process_values(-3i32, 10i32));
    match r2 {
        Result.Ok(_) => {
            return 3i32;
        },
        Result.Err(e) => {
            if e != -3i32 {
                return 4i32;
            }
        },
    }

    print("ok\n");
    return 0i32;
}
