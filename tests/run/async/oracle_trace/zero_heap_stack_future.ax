// test: run
// modes: interp native
// stdout: stack_future_done=88\n

use std.future.block_on.block_on;

async fn compute_add(a: i64, b: i64) -> i64 {
    a + b
}

async fn stack_pipeline(val: i64) -> i64 {
    let step1 = compute_add(val, 10i64).await;
    let step2 = compute_add(step1, 32i64).await;
    compute_add(step2, step2).await
}

fn main() -> i32 {
    // 2 + 10 = 12; 12 + 32 = 44; 44 + 44 = 88
    let res = block_on(stack_pipeline(2i64));
    print("stack_future_done=");
    print_int(res);
    print("\n");
    0i32
}
