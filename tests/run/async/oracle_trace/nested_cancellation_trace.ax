// test: run
// modes: interp native
// stdout: POLL fut=1 fn=outer_task state=0\nPOLL fut=2 fn=inner_task state=0\nSUSPEND fut=2 fn=inner_task sp=0 state=1\nSUSPEND fut=1 fn=outer_task sp=0 state=1\nleaf_drop\ninner_local_drop\ninner_param_drop\nCANCEL_DROP fut=2 fn=inner_task state=1\nouter_local_drop\nouter_param_drop\nCANCEL_DROP fut=1 fn=outer_task state=1\nfinished\n

use std.future.Context;
use std.future.Future;
use std.future.Poll;
use std.future.RawWaker;
use std.future.RawWakerVTable;
use std.future.Waker;
use std.future.trace_cancel_drop;
use std.future.trace_poll;
use std.future.trace_suspend;

struct OuterParam {
    id: i32,
}

impl Drop for OuterParam {
    fn drop(self: mut_view<OuterParam>) {
        print("outer_param_drop\n");
        trace_cancel_drop(1u64, "outer_task", 1u32);
    }
}

struct OuterLocal {
    id: i32,
}

impl Drop for OuterLocal {
    fn drop(self: mut_view<OuterLocal>) {
        print("outer_local_drop\n");
    }
}

struct InnerParam {
    id: i32,
}

impl Drop for InnerParam {
    fn drop(self: mut_view<InnerParam>) {
        print("inner_param_drop\n");
        trace_cancel_drop(2u64, "inner_task", 1u32);
    }
}

struct InnerLocal {
    id: i32,
}

impl Drop for InnerLocal {
    fn drop(self: mut_view<InnerLocal>) {
        print("inner_local_drop\n");
    }
}

struct PendingLeaf {
    id: i32,
}

impl Drop for PendingLeaf {
    fn drop(self: mut_view<PendingLeaf>) {
        print("leaf_drop\n");
    }
}

impl Future for PendingLeaf {
    type Output = i32;

    fn poll(self: mut_view<PendingLeaf>, cx: mut_view<Context>) -> Poll<i32> {
        trace_suspend(2u64, "inner_task", 0u32, 1u32);
        Poll.Pending
    }
}

async fn inner_task(ip: InnerParam) -> i32 {
    let il = InnerLocal { id: 2i32 };
    let leaf = PendingLeaf { id: 3i32 };
    let res = leaf.await;
    let _ = il.id + ip.id + res;
    res
}

async fn outer_task(op: OuterParam) -> i32 {
    let ol = OuterLocal { id: 10i32 };
    let ip = InnerParam { id: 20i32 };
    trace_poll(2u64, "inner_task", 0u32);
    let res = inner_task(ip).await;
    let _ = ol.id + op.id + res;
    res
}

fn main() -> i32 {
    {
        let op = OuterParam { id: 100i32 };
        let mut fut = outer_task(op);
        let mut cx = Context {
            waker_val: Waker {
                raw: RawWaker {
                    data: 0 as *const u8,
                    vtable: 0 as *const RawWakerVTable,
                },
            },
        };
        trace_poll(1u64, "outer_task", 0u32);
        let p = fut.poll(mut_view(cx));
        match p {
            Poll.Pending => {
                trace_suspend(1u64, "outer_task", 0u32, 1u32);
            },
            Poll.Ready(_) => {},
        }
    }
    print("finished\n");
    0i32
}
