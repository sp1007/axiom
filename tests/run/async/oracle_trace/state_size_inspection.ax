// test: run
// modes: interp native
// stdout: fut1_size_ok\nfut2_size_ok\nall_state_sizes_valid\n

use std.future.Future;
use std.future.block_on.block_on;

@intrinsic fn size_of<T>() -> usize { 0 }

async fn leaf_async(x: i32) -> i32 {
    x * 2i32
}

async fn parent_async(a: i32, b: i32) -> i32 {
    let r1 = leaf_async(a).await;
    let r2 = leaf_async(b).await;
    r1 + r2
}

fn check_fut1<F: Future>(fut: F) {
    let sz = size_of<F>();
    if sz >= 4 {
        print("fut1_size_ok\n");
    }
}

fn check_fut2<F: Future>(fut: F) {
    let sz = size_of<F>();
    if sz >= 4 {
        print("fut2_size_ok\n");
    }
}

fn main() -> i32 {
    let f1 = leaf_async(5i32);
    check_fut1(f1);
    let f2 = parent_async(3i32, 4i32);
    check_fut2(f2);
    let res = block_on(parent_async(3i32, 4i32));
    if res == 14i32 {
        print("all_state_sizes_valid\n");
    }
    0i32
}
