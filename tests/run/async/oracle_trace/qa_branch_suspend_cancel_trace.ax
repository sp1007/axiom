// test: run
// modes: interp native
// stdout: stack_layout_ok\nbranch_param_drop=0\nPOLL fut=1 fn=branch_flow state=0\nPOLL fut=101 fn=branch_yield state=0\nSUSPEND fut=101 fn=branch_yield sp=0 state=1\nSUSPEND fut=1 fn=branch_flow sp=0 state=1\nWAKE fut=1\nRESUME fut=1 fn=branch_flow sp=0 state=1\nPOLL fut=101 fn=branch_yield state=1\nRESUME fut=101 fn=branch_yield sp=0 state=1\nCOMPLETE fut=101 fn=branch_yield\nPOLL fut=102 fn=branch_yield state=0\nSUSPEND fut=102 fn=branch_yield sp=0 state=1\nSUSPEND fut=1 fn=branch_flow sp=1 state=2\nWAKE fut=1\nRESUME fut=1 fn=branch_flow sp=1 state=2\nPOLL fut=102 fn=branch_yield state=1\nRESUME fut=102 fn=branch_yield sp=0 state=1\nCOMPLETE fut=102 fn=branch_yield\nbranch_local_drop=100\nbranch_param_drop=1\nCOMPLETE fut=1 fn=branch_flow\nbranch_a_res=131\n-- cancel branch b --\nPOLL fut=2 fn=branch_flow state=0\nPOLL fut=103 fn=branch_yield state=0\nSUSPEND fut=103 fn=branch_yield sp=0 state=1\nSUSPEND fut=2 fn=branch_flow sp=2 state=3\nbranch_yield_drop=50\nbranch_local_drop=200\nbranch_param_drop=2\nCANCEL_DROP fut=2 fn=branch_flow state=3\nfinished_all\n

use std.future.Context;
use std.future.Future;
use std.future.Poll;
use std.future.RawWaker;
use std.future.RawWakerVTable;
use std.future.Waker;
use std.future.trace_complete;
use std.future.trace_poll;
use std.future.trace_resume;
use std.future.trace_suspend;
use std.future.trace_wake;
use std.future.trace_cancel_drop;

@intrinsic fn size_of<T>() -> usize { 0 }

struct BranchParam {
    id: i32,
    should_cancel: bool,
}

impl Drop for BranchParam {
    fn drop(self: mut_view<BranchParam>) {
        print("branch_param_drop=");
        print_int(self.id as i64);
        print("\n");
        if self.should_cancel {
            trace_cancel_drop(2u64, "branch_flow", 3u32);
        }
    }
}

struct BranchLocal {
    id: i32,
}

impl Drop for BranchLocal {
    fn drop(self: mut_view<BranchLocal>) {
        print("branch_local_drop=");
        print_int(self.id as i64);
        print("\n");
    }
}

struct BranchYield {
    fut_id: u64,
    val: i32,
    polled: bool,
}

impl Drop for BranchYield {
    fn drop(self: mut_view<BranchYield>) {
        print("branch_yield_drop=");
        print_int(self.val as i64);
        print("\n");
    }
}

impl Future for BranchYield {
    type Output = i32;

    fn poll(self: mut_view<BranchYield>, cx: mut_view<Context>) -> Poll<i32> {
        if !self.polled {
            self.polled = true;
            trace_poll(self.fut_id, "branch_yield", 0u32);
            trace_suspend(self.fut_id, "branch_yield", 0u32, 1u32);
            Poll.Pending
        } else {
            trace_poll(self.fut_id, "branch_yield", 1u32);
            trace_resume(self.fut_id, "branch_yield", 0u32, 1u32);
            trace_complete(self.fut_id, "branch_yield");
            Poll.Ready(self.val)
        }
    }
}

async fn branch_flow(p: BranchParam, branch_sel: i32) -> i32 {
    let loc = BranchLocal { id: p.id * 100i32 };
    if branch_sel == 1i32 {
        let y1 = BranchYield { fut_id: 101u64, val: 10i32, polled: false };
        let r1 = y1.await;
        let y2 = BranchYield { fut_id: 102u64, val: 20i32, polled: false };
        let r2 = y2.await;
        r1 + r2 + loc.id + p.id
    } else {
        let y3 = BranchYield { fut_id: 103u64, val: 50i32, polled: false };
        let r3 = y3.await;
        r3 + loc.id + p.id
    }
}

fn check_stack_fut<F: Future>(fut: F) {
    let sz = size_of<F>();
    if sz >= 4 {
        print("stack_layout_ok\n");
    }
}

fn make_cx() -> Context {
    Context {
        waker_val: Waker {
            raw: RawWaker {
                data: 0 as *const u8,
                vtable: 0 as *const RawWakerVTable,
            },
        },
    }
}

fn run_branch_a() -> i32 {
    let p1 = BranchParam { id: 1i32, should_cancel: false };
    let mut fut1 = branch_flow(p1, 1i32);
    let mut cx1 = make_cx();

    trace_poll(1u64, "branch_flow", 0u32);
    match fut1.poll(mut_view(cx1)) {
        Poll.Pending => {
            trace_suspend(1u64, "branch_flow", 0u32, 1u32);
            trace_wake(1u64);
            trace_resume(1u64, "branch_flow", 0u32, 1u32);
        },
        Poll.Ready(_) => return 10i32,
    }

    match fut1.poll(mut_view(cx1)) {
        Poll.Pending => {
            trace_suspend(1u64, "branch_flow", 1u32, 2u32);
            trace_wake(1u64);
            trace_resume(1u64, "branch_flow", 1u32, 2u32);
        },
        Poll.Ready(_) => return 11i32,
    }

    match fut1.poll(mut_view(cx1)) {
        Poll.Pending => 12i32,
        Poll.Ready(v) => {
            trace_complete(1u64, "branch_flow");
            print("branch_a_res=");
            print_int(v as i64);
            print("\n");
            0i32
        },
    }
}

fn run_branch_b_cancel() {
    let p2 = BranchParam { id: 2i32, should_cancel: true };
    let mut fut2 = branch_flow(p2, 2i32);
    let mut cx2 = make_cx();

    trace_poll(2u64, "branch_flow", 0u32);
    match fut2.poll(mut_view(cx2)) {
        Poll.Pending => {
            trace_suspend(2u64, "branch_flow", 2u32, 3u32);
        },
        Poll.Ready(_) => {},
    }
    // fut2 dropped while suspended at SP 2 (state 3)
}

fn main() -> i32 {
    // 1. Zero-heap stack future layout check
    let p_dummy = BranchParam { id: 0i32, should_cancel: false };
    let f_stack = branch_flow(p_dummy, 1i32);
    check_stack_fut(f_stack);

    // 2. Branch A: multi-step suspend/resume to completion
    let r_a = run_branch_a();
    if r_a != 0i32 {
        return r_a;
    }

    print("-- cancel branch b --\n");

    // 3. Branch B: early cancellation drop check
    run_branch_b_cancel();

    print("finished_all\n");
    0i32
}
