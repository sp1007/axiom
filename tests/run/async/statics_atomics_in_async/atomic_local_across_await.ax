// test: run
// modes: interp native
// covers: REQ-ASY-082 REQ-MIR-144
// stdout: v0=10 old1=25 cas=1,42,0,90 final=99,99 small=100,70 flag=0,1 param=1100\n

// T428i: `AtomicI64` (and `AtomicU32`, `AtomicBool`, plus `AtomicI64` parameter) used before and
// after multiple `.await` suspension points (`load`, `store`, `swap`, `fetch_add`, `fetch_sub`,
// `compare_exchange`, `compare_exchange_weak`, `fence`, `compiler_fence`, `spin_loop_hint`, `into_inner`).

use std.future.block_on.block_on;
use std.sync.atomic.fence;
use std.sync.atomic.compiler_fence;
use std.sync.atomic.spin_loop_hint;

struct YieldOnce {
    pub done: bool,
}

impl Future for YieldOnce {
    type Output = i64;

    fn poll(self: mut_view<YieldOnce>, cx: mut_view<Context>) -> Poll<i64> {
        if !self.done {
            self.done = true;
            return Poll.Pending;
        }
        Poll.Ready(1i64)
    }
}

async fn atomic_local_ops() -> i64 {
    let a = AtomicI64.new(10i64);
    let flag = AtomicBool.new(false);
    let small = AtomicU32.new(100u32);

    let v0 = a.load(Ordering.Acquire);
    a.store(25i64, Ordering.Release);
    let prev_f = flag.swap(true, Ordering.AcqRel);
    fence(Ordering.SeqCst);

    let _ = (YieldOnce { done: false }).await;

    let old1 = a.fetch_add(17i64, Ordering.AcqRel);
    let old_s = small.fetch_sub(30u32, Ordering.SeqCst);
    compiler_fence(Ordering.AcqRel);

    let _ = (YieldOnce { done: false }).await;

    let cas_ok = a.compare_exchange(42i64, 90i64, Ordering.SeqCst, Ordering.Acquire);
    let cas_fail = a.compare_exchange(42i64, 999i64, Ordering.SeqCst, Ordering.Acquire);
    let mut cur = a.load(Ordering.Relaxed);
    loop {
        let r = a.compare_exchange_weak(cur, cur + 9i64, Ordering.AcqRel, Ordering.Acquire);
        if r.ok {
            break;
        }
        cur = r.val;
        spin_loop_hint();
    }

    let _ = (YieldOnce { done: false }).await;

    let final_load = a.load(Ordering.SeqCst);
    let f_now = flag.load(Ordering.Acquire);
    let s_now = small.load(Ordering.Acquire) as i64;
    let inner = a.into_inner();

    print("v0=");
    print_int(v0);
    print(" old1=");
    print_int(old1);
    print(" cas=");
    print_int(if cas_ok.ok { 1i64 } else { 0i64 });
    print(",");
    print_int(cas_ok.val);
    print(",");
    print_int(if cas_fail.ok { 1i64 } else { 0i64 });
    print(",");
    print_int(cas_fail.val);
    print(" final=");
    print_int(final_load);
    print(",");
    print_int(inner);
    print(" small=");
    print_int(old_s as i64);
    print(",");
    print_int(s_now);
    print(" flag=");
    print_int(if prev_f { 1i64 } else { 0i64 });
    print(",");
    print_int(if f_now { 1i64 } else { 0i64 });
    0i64
}

async fn atomic_param_ops(p: AtomicI64) -> i64 {
    let a = p.fetch_add(12i64, Ordering.SeqCst);
    let _ = (YieldOnce { done: false }).await;
    let c = p.compare_exchange(512i64, 600i64, Ordering.SeqCst, Ordering.Acquire);
    let _ = (YieldOnce { done: false }).await;
    let end = p.load(Ordering.Acquire);
    if c.ok { a + end } else { -1i64 }
}

fn main() -> i32 {
    let _ = block_on(atomic_local_ops());
    let pv = block_on(atomic_param_ops(AtomicI64.new(500i64)));
    print(" param=");
    print_int(pv);
    print("\n");
    0i32
}
