// test: run
// modes: interp native
// covers: REQ-ASY-082 REQ-MIR-144
// stdout: ops=44088 arr=10700\n

// T428i MIR audit edge cases:
// 1. Locals computed before `.await` and used ONLY as operands of `MIR_STMT_ATOMIC` after `.await`.
// 2. Index locals computed before `.await` and used ONLY inside LHS destination projections
//    (`arr[i1] = ...` and `arr[i2] = fut.await`) after `.await`.

use std.future.block_on.block_on;

fn opaque_i64(x: i64) -> i64 {
    if x == -999999i64 { 0i64 } else { x }
}

fn opaque_usize(x: usize) -> usize {
    if x == 999999usize { 0usize } else { x }
}

struct ReadyAfterOne {
    pub val: i64,
    pub done: bool,
}

impl Future for ReadyAfterOne {
    type Output = i64;

    fn poll(self: mut_view<ReadyAfterOne>, cx: mut_view<Context>) -> Poll<i64> {
        if !self.done {
            self.done = true;
            return Poll.Pending;
        }
        Poll.Ready(self.val)
    }
}

async fn atomic_operands_live_across_await() -> i64 {
    let a = AtomicI64.new(1i64);
    let val_to_store = opaque_i64(44i64);
    let add_delta = opaque_i64(16i64);
    let exp_val = opaque_i64(60i64);
    let des_val = opaque_i64(88i64);

    let _ = (ReadyAfterOne { val: 0i64, done: false }).await;
    a.store(val_to_store, Ordering.Release);

    let _ = (ReadyAfterOne { val: 0i64, done: false }).await;
    let old = a.fetch_add(add_delta, Ordering.AcqRel);

    let _ = (ReadyAfterOne { val: 0i64, done: false }).await;
    let cas = a.compare_exchange(exp_val, des_val, Ordering.SeqCst, Ordering.Acquire);

    if cas.ok { old * 1000i64 + a.load(Ordering.Acquire) } else { -1i64 }
}

async fn indexed_assign_and_await_dest() -> i64 {
    let mut arr: [4]i64 = [10i64, 20i64, 30i64, 40i64];
    let i1 = opaque_usize(2usize);
    let i2 = opaque_usize(3usize);

    let _ = (ReadyAfterOne { val: 0i64, done: false }).await;
    arr[i1] = 77i64;
    arr[i2] = (ReadyAfterOne { val: 99i64, done: false }).await;

    arr[0] + arr[1] + arr[2] * 10i64 + arr[3] * 100i64
}

fn main() -> i32 {
    let v1 = block_on(atomic_operands_live_across_await());
    let v2 = block_on(indexed_assign_and_await_dest());
    print("ops=");
    print_int(v1);
    print(" arr=");
    print_int(v2);
    print("\n");
    0i32
}
