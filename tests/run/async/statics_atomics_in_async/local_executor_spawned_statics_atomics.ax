// test: run
// modes: interp native
// timeout: 60
// covers: REQ-ASY-082 REQ-MIR-144 REQ-ASY-122
// stdout: ra=3095 rb=2424 g=1355 shared=99\n

// T428i: Two spawned tasks under `LocalExecutor` interleaving across `yield_now().await` while
// reading/writing `static mut`, task-local `AtomicI64`, in-place `AtomicI64` reached via pointer,
// and a shared `AtomicI64` reached via `*const AtomicI64`.

module test.local_executor_spawned_statics_atomics

use std.asyn.executor.LocalExecutor
use std.asyn.executor.yield_now
use std.asyn.task.TaskResult

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

static mut G_SHARED: i64 = 0i64;

async fn task_a(p_shared: *const AtomicI64) -> i64 {
    let local_atom = AtomicI64.new(10i64);
    let inplace_atom = AtomicI64.new(100i64);
    let p_in: *const AtomicI64 = unsafe { address_of(inplace_atom) };

    unsafe {
        G_SHARED = 1000i64;
        (*p_in).store(110i64, Ordering.Release);
        (*p_shared).store(1i64, Ordering.Release);
    }
    local_atom.store(20i64, Ordering.Release);

    yield_now().await;

    let a_after1 = unsafe { G_SHARED };
    unsafe {
        G_SHARED = a_after1 + 89i64;
    }
    let cas_s = unsafe { (*p_shared).compare_exchange(41i64, 90i64, Ordering.SeqCst, Ordering.Acquire) };
    let la1 = local_atom.fetch_add(5i64, Ordering.AcqRel);
    let pa1 = unsafe { (*p_in).fetch_add(15i64, Ordering.AcqRel) };

    yield_now().await;

    let a_after2 = unsafe { G_SHARED };
    let sh_end = unsafe { (*p_shared).load(Ordering.Acquire) };
    let cas_l = local_atom.compare_exchange(25i64, 50i64, Ordering.SeqCst, Ordering.Acquire);
    let cas_p = unsafe { (*p_in).compare_exchange(125i64, 250i64, Ordering.SeqCst, Ordering.Acquire) };
    let la_end = local_atom.load(Ordering.Acquire);
    let pa_end = unsafe { (*p_in).load(Ordering.Acquire) };

    if !cas_s.ok || !cas_l.ok || !cas_p.ok {
        return -1i64;
    }
    a_after1 + a_after2 + sh_end + la1 + la_end + pa1 + pa_end
}

async fn task_b(p_shared: *const AtomicI64) -> i64 {
    let b_local = AtomicI64.new(7i64);
    let b_seen1 = unsafe { G_SHARED };
    unsafe {
        G_SHARED = b_seen1 + 211i64;
    }
    let b_prev = unsafe { (*p_shared).fetch_add(40i64, Ordering.AcqRel) };
    let _ = b_local.fetch_add(3i64, Ordering.SeqCst);

    yield_now().await;

    let b_seen2 = unsafe { G_SHARED };
    unsafe {
        G_SHARED = b_seen2 + 55i64;
    }
    let b_sh2 = unsafe { (*p_shared).fetch_add(9i64, Ordering.SeqCst) };
    let cas_b = b_local.compare_exchange(10i64, 33i64, Ordering.SeqCst, Ordering.Acquire);
    if !cas_b.ok {
        return -1i64;
    }
    b_seen1 + b_seen2 + b_prev + b_sh2 + b_local.load(Ordering.Acquire)
}

pub fn main() -> i32 {
    let mut exec = LocalExecutor.new();
    let shared = AtomicI64.new(0i64);
    let p_shared: *const AtomicI64 = unsafe { address_of(shared) };
    let ha = mut_view(exec).spawn_local(task_a(p_shared));
    let hb = mut_view(exec).spawn_local(task_b(p_shared));

    let ra = match mut_view(exec).block_on(ha.join()) {
        TaskResult.Completed(v) => v,
        _ => -1i64,
    };
    let rb = match mut_view(exec).block_on(hb.join()) {
        TaskResult.Completed(v) => v,
        _ => -2i64,
    };
    mut_view(exec).shutdown();

    let g = unsafe { G_SHARED };
    let sh = shared.load(Ordering.Acquire);
    print("ra=");
    print_int(ra);
    print(" rb=");
    print_int(rb);
    print(" g=");
    print_int(g);
    print(" shared=");
    print_int(sh);
    print("\n");
    0i32
}
