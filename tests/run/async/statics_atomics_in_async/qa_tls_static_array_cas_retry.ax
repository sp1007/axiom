// test: run
// modes: interp native
// covers: REQ-ASY-082 REQ-MIR-144 REQ-ASY-122
// stdout: tls=100,115,125 buf=121,2,77,4 cas=0,17,1,17,0,63,1,63 bit=48,58,58,63,85,123\n

// T428i QA adversarial test:
// 1. `@thread_local static mut` mutated externally during `.await` and read/written across multiple `.await`s.
// 2. `static mut` array element written as an `.await` destination indexed by a local (`G_BUF[idx] = fut.await`).
// 3. `AtomicI64` `compare_exchange` failure & retry across `.await` on both local-via-ptr and static atomics.
// 4. `fetch_or`, `fetch_and`, `fetch_xor`, `swap` with live-across-await mask operands.

use std.future.block_on.block_on;

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

@thread_local
static mut TLS_COUNTER: i64 = 100i64;

static mut G_BUF: [4]i64 = [1i64, 2i64, 3i64, 4i64];

static G_CAS_ATOM: AtomicI64 = AtomicI64.new(50i64);

fn opaque_i64(x: i64) -> i64 {
    if x == -777777i64 { 0i64 } else { x }
}

fn opaque_usize(x: usize) -> usize {
    if x == 777777usize { 0usize } else { x }
}

struct MutateAndReturn {
    pub p_local: *const AtomicI64,
    pub p_static: *const AtomicI64,
    pub bump: bool,
    pub ret: i64,
    pub done: bool,
}

impl Future for MutateAndReturn {
    type Output = i64;

    fn poll(self: mut_view<MutateAndReturn>, cx: mut_view<Context>) -> Poll<i64> {
        if !self.done {
            self.done = true;
            return Poll.Pending;
        }
        unsafe {
            TLS_COUNTER = TLS_COUNTER + 5i64;
            G_BUF[0] = G_BUF[0] + 40i64;
            if self.bump {
                let _ = (*self.p_local).fetch_add(7i64, Ordering.SeqCst);
                let _ = (*self.p_static).fetch_add(13i64, Ordering.SeqCst);
            }
        }
        Poll.Ready(self.ret)
    }
}

async fn async_adversarial() -> i64 {
    let tls0 = unsafe { TLS_COUNTER };
    unsafe {
        TLS_COUNTER = 110i64;
    }

    let idx = opaque_usize(2usize);
    let local_atom = AtomicI64.new(10i64);
    let p_local: *const AtomicI64 = unsafe { address_of(local_atom) };
    let p_static: *const AtomicI64 = unsafe { address_of(G_CAS_ATOM) };

    let exp_local = unsafe { (*p_local).load(Ordering.Acquire) };
    let exp_static = G_CAS_ATOM.load(Ordering.Acquire);

    unsafe {
        G_BUF[idx] = (MutateAndReturn {
            p_local: p_local,
            p_static: p_static,
            bump: true,
            ret: 77i64,
            done: false,
        }).await;
    }

    let tls1 = unsafe { TLS_COUNTER };
    let c_loc_fail = unsafe { (*p_local).compare_exchange(exp_local, 999i64, Ordering.SeqCst, Ordering.Acquire) };
    let c_st_fail = G_CAS_ATOM.compare_exchange(exp_static, 888i64, Ordering.SeqCst, Ordering.Acquire);
    let retry_loc = c_loc_fail.val;
    let retry_st = c_st_fail.val;

    let _ = (MutateAndReturn {
        p_local: p_local,
        p_static: p_static,
        bump: false,
        ret: 5i64,
        done: false,
    }).await;

    let c_loc_ok = unsafe { (*p_local).compare_exchange(retry_loc, 48i64, Ordering.SeqCst, Ordering.Acquire) };
    let c_st_ok = G_CAS_ATOM.compare_exchange(retry_st, 85i64, Ordering.SeqCst, Ordering.Acquire);

    let or_mask = opaque_i64(10i64);
    let and_mask = opaque_i64(63i64);
    let xor_mask = opaque_i64(5i64);

    let _ = (MutateAndReturn {
        p_local: p_local,
        p_static: p_static,
        bump: false,
        ret: 0i64,
        done: false,
    }).await;

    let p1 = local_atom.fetch_or(or_mask, Ordering.AcqRel);
    let p2 = local_atom.fetch_and(and_mask, Ordering.AcqRel);
    let p3 = local_atom.fetch_xor(xor_mask, Ordering.AcqRel);
    let loc_fin = local_atom.load(Ordering.Acquire);
    let p4 = unsafe { (*p_static).swap(123i64, Ordering.SeqCst) };
    let st_fin = G_CAS_ATOM.load(Ordering.Acquire);
    let tls2 = unsafe { TLS_COUNTER };

    print("tls=");
    print_int(tls0);
    print(",");
    print_int(tls1);
    print(",");
    print_int(tls2);
    print(" buf=");
    print_int(unsafe { G_BUF[0] });
    print(",");
    print_int(unsafe { G_BUF[1] });
    print(",");
    print_int(unsafe { G_BUF[2] });
    print(",");
    print_int(unsafe { G_BUF[3] });
    print(" cas=");
    print_int(if c_loc_fail.ok { 1i64 } else { 0i64 });
    print(",");
    print_int(c_loc_fail.val);
    print(",");
    print_int(if c_loc_ok.ok { 1i64 } else { 0i64 });
    print(",");
    print_int(c_loc_ok.val);
    print(",");
    print_int(if c_st_fail.ok { 1i64 } else { 0i64 });
    print(",");
    print_int(c_st_fail.val);
    print(",");
    print_int(if c_st_ok.ok { 1i64 } else { 0i64 });
    print(",");
    print_int(c_st_ok.val);
    print(" bit=");
    print_int(p1);
    print(",");
    print_int(p2);
    print(",");
    print_int(p3);
    print(",");
    print_int(loc_fin);
    print(",");
    print_int(p4);
    print(",");
    print_int(st_fin);
    print("\n");
    0i64
}

fn main() -> i32 {
    let _ = block_on(async_adversarial());
    0i32
}
