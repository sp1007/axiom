// test: run
// modes: interp native
// covers: REQ-ASY-082 REQ-MIR-144 REQ-ASY-122
// stdout: ext=5,20,120,127,1,327,500,555 inplace=50099 static_atom=1600\n

// T428i: Atomic operations reached through `*const AtomicI64` (caller storage, in-place async local
// storage never named again after `.await`, and `static` `AtomicI64`) across multiple `.await`s.

use std.future.block_on.block_on;

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

static G_SHARED_ATOM: AtomicI64 = AtomicI64.new(700i64);

struct RemoteBump {
    pub target: *const AtomicI64,
    pub add: i64,
    pub done: bool,
}

impl Future for RemoteBump {
    type Output = i64;

    fn poll(self: mut_view<RemoteBump>, cx: mut_view<Context>) -> Poll<i64> {
        if !self.done {
            self.done = true;
            return Poll.Pending;
        }
        let t = self.target;
        let prev = unsafe { (*t).fetch_add(self.add, Ordering.SeqCst) };
        Poll.Ready(prev)
    }
}

async fn ext_ptr_ops(p: *const AtomicI64) -> i64 {
    let l0 = unsafe { (*p).load(Ordering.Acquire) };
    unsafe { (*p).store(20i64, Ordering.Release); }
    let old_b1 = (RemoteBump { target: p, add: 100i64, done: false }).await;
    let fa = unsafe { (*p).fetch_add(7i64, Ordering.AcqRel) };
    let old_b2 = (RemoteBump { target: p, add: 200i64, done: false }).await;
    let cas1 = unsafe { (*p).compare_exchange(327i64, 500i64, Ordering.SeqCst, Ordering.Acquire) };
    let old_b3 = (RemoteBump { target: p, add: 55i64, done: false }).await;
    let end = unsafe { (*p).load(Ordering.SeqCst) };

    print("ext=");
    print_int(l0);
    print(",");
    print_int(old_b1);
    print(",");
    print_int(fa);
    print(",");
    print_int(old_b2);
    print(",");
    print_int(if cas1.ok { 1i64 } else { 0i64 });
    print(",");
    print_int(cas1.val);
    print(",");
    print_int(old_b3);
    print(",");
    print_int(end);
    0i64
}

async fn inplace_local_via_ptr_only() -> i64 {
    let local_atom = AtomicI64.new(30i64);
    let p: *const AtomicI64 = unsafe { address_of(local_atom) };
    unsafe { (*p).store(40i64, Ordering.Release); }
    let _ = (RemoteBump { target: p, add: 10i64, done: false }).await;
    let fa = unsafe { (*p).fetch_add(8i64, Ordering.AcqRel) };
    let _ = (RemoteBump { target: p, add: 2i64, done: false }).await;
    let cas = unsafe { (*p).compare_exchange(60i64, 90i64, Ordering.SeqCst, Ordering.Acquire) };
    let _ = (RemoteBump { target: p, add: 9i64, done: false }).await;
    let fin = unsafe { (*p).load(Ordering.Acquire) };
    if cas.ok { fa * 1000i64 + fin } else { -1i64 }
}

async fn static_atomic_in_async() -> i64 {
    let s0 = G_SHARED_ATOM.fetch_add(15i64, Ordering.SeqCst);
    let p = unsafe { address_of(G_SHARED_ATOM) };
    let _ = (RemoteBump { target: p, add: 85i64, done: false }).await;
    let cas = G_SHARED_ATOM.compare_exchange(800i64, 900i64, Ordering.SeqCst, Ordering.Acquire);
    if cas.ok { s0 + G_SHARED_ATOM.load(Ordering.Acquire) } else { -1i64 }
}

fn main() -> i32 {
    let shared = AtomicI64.new(5i64);
    let p_shared: *const AtomicI64 = unsafe { address_of(shared) };
    let _ = block_on(ext_ptr_ops(p_shared));
    let v_in = block_on(inplace_local_via_ptr_only());
    let v_st = block_on(static_atomic_in_async());
    print(" inplace=");
    print_int(v_in);
    print(" static_atom=");
    print_int(v_st);
    print("\n");
    0i32
}
