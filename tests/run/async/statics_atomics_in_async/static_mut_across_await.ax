// test: run
// modes: interp native
// covers: REQ-ASY-082
// stdout: g=1521 pair=69,400 total=4756\n

// T428i: `static` and `static mut` places accessed inside an `async fn` refer directly to the
// process-wide static storage and are never copied into the poll frame or saved/restored across `.await`.

use std.future.block_on.block_on;

struct Pair {
    pub a: i64,
    pub b: i64,
}

static mut G_SCALAR: i64 = 1000i64;
static mut G_PAIR: Pair = Pair { a: 10i64, b: 20i64 };
static G_RO: i64 = 7i64;

fn external_mutate_step1() -> i64 {
    let seen = unsafe { G_SCALAR };
    unsafe {
        G_SCALAR = seen + 201i64;
        G_PAIR.a = G_PAIR.a + 50i64;
    }
    seen
}

fn external_mutate_step2() -> i64 {
    let seen = unsafe { G_SCALAR };
    unsafe {
        G_SCALAR = seen + 300i64;
        G_PAIR.a = G_PAIR.a + 9i64;
    }
    400i64
}

struct StepFuture {
    pub step: i32,
    pub polled: bool,
}

impl Future for StepFuture {
    type Output = i64;

    fn poll(self: mut_view<StepFuture>, cx: mut_view<Context>) -> Poll<i64> {
        if !self.polled {
            self.polled = true;
            return Poll.Pending;
        }
        if self.step == 1i32 {
            return Poll.Ready(external_mutate_step1());
        }
        Poll.Ready(external_mutate_step2())
    }
}

async fn async_touch_statics() -> i64 {
    let base = unsafe { G_SCALAR } + G_RO;
    unsafe {
        G_SCALAR = G_SCALAR + 10i64;
    }
    let ext_seen1 = (StepFuture { step: 1i32, polled: false }).await;
    let after1 = unsafe { G_SCALAR };
    unsafe {
        G_SCALAR = after1 + 10i64;
        G_PAIR.b = (StepFuture { step: 2i32, polled: false }).await;
    }
    let after2 = unsafe { G_SCALAR } + G_RO;
    base + ext_seen1 + after1 + after2
}

fn main() -> i32 {
    let total = block_on(async_touch_statics());
    let g = unsafe { G_SCALAR };
    let pa = unsafe { G_PAIR.a };
    let pb = unsafe { G_PAIR.b };
    print("g=");
    print_int(g);
    print(" pair=");
    print_int(pa);
    print(",");
    print_int(pb);
    print(" total=");
    print_int(total);
    print("\n");
    0i32
}
