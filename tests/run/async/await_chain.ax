// test: run
// modes: interp native
// stdout: ok\n

use std.future.block_on.block_on;

async fn step1(x: i32) -> i32 {
    x + 1i32
}

async fn step2(x: i32) -> i32 {
    x * 2i32
}

async fn multi_step(start: i32) -> i32 {
    let a = step1(start).await;
    let b = step2(a).await;
    let c = step1(b).await;
    c
}

fn main() -> i32 {
    // (5 + 1) * 2 + 1 = 13
    let res = block_on(multi_step(5i32));
    if res != 13i32 {
        return 1i32;
    }
    print("ok\n");
    return 0i32;
}
