// test: run
// modes: interp native
// stdout: drop async 15\nOK async_lock_method_and_user_mutex_guard_name 65\n
// T422e: `.lock()`, `.read()`, and `.write()` methods whose return types are NOT `@no_suspend_hold`
// (such as `AsyncMutex.lock()` returning a Future) must not trigger `AX_CONC_GUARD_ESCAPE`, even
// inside an `unsafe` block on a parameter pointer; and user-defined structs named `MutexGuard` or
// `RwLockWriteGuard` without `@no_suspend_hold` are ordinary types (no name-keyed heuristics).

use std.future.block_on.block_on;

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct MutexGuard {
    pub v: i64,
}

struct RwLockWriteGuard {
    pub v: i64,
}

fn make_user_mutex_guard(x: i64) -> MutexGuard {
    let g = MutexGuard { v: x };
    return g;
}

struct MiniAsyncGuard {
    pub v: i64,
}

impl Drop for MiniAsyncGuard {
    fn drop(self: mut_view<MiniAsyncGuard>) {
        print("drop async ");
        print_int(self.v);
        print("\n");
    }
}

struct MiniLockFuture {
    pub seed: i64,
    pub polled: bool,
}

impl Future for MiniLockFuture {
    type Output = MiniAsyncGuard;

    fn poll(self: mut_view<MiniLockFuture>, cx: mut_view<Context>) -> Poll<MiniAsyncGuard> {
        if !self.polled {
            self.polled = true;
            return Poll.Pending;
        }
        Poll.Ready(MiniAsyncGuard { v: self.seed })
    }
}

struct MiniReadFuture {
    pub bonus: i64,
}

impl Future for MiniReadFuture {
    type Output = i64;

    fn poll(self: mut_view<MiniReadFuture>, cx: mut_view<Context>) -> Poll<i64> {
        Poll.Ready(self.bonus)
    }
}

struct MiniAsyncLock {
    pub init_v: i64,
}

impl MiniAsyncLock {
    pub fn lock(self: view<MiniAsyncLock>) -> MiniLockFuture {
        MiniLockFuture { seed: self.init_v, polled: false }
    }

    pub fn read(self: view<MiniAsyncLock>) -> MiniReadFuture {
        MiniReadFuture { bonus: 20i64 }
    }

    pub fn write(self: view<MiniAsyncLock>) -> MiniReadFuture {
        MiniReadFuture { bonus: 10i64 }
    }
}

async fn acquire_and_hold(p_lock: *const MiniAsyncLock) -> i64 {
    let mut ag = unsafe { view(*p_lock).lock() }.await;
    let ug = make_user_mutex_guard(12i64);
    let uw = RwLockWriteGuard { v: 8i64 };
    let r = unsafe { view(*p_lock).read() }.await;
    let w = unsafe { view(*p_lock).write() }.await;
    ag.v + ug.v + uw.v + r + w
}

fn main() -> i32 {
    let lk = MiniAsyncLock { init_v: 15i64 };
    let p_lk: *const MiniAsyncLock = unsafe { address_of(lk) };
    let total = block_on(acquire_and_hold(p_lk));
    if total != 65i64 {
        print("FAIL total\n");
        return 1i32;
    }
    print("OK async_lock_method_and_user_mutex_guard_name 65\n");
    0i32
}
