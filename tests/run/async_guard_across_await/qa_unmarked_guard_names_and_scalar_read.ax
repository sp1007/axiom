// test: run
// modes: interp native
// stdout: OK qa_unmarked_guard_names_and_scalar_read 77\n
// QA adversarial run test for T422e:
// - Unmarked user structs literally named `MutexGuard` and `RwLockWriteGuard` with `.lock()` /
//   `.write()` methods can be returned from functions and held across `.await`.
// - A `@no_suspend_hold` struct `Token` can have a scalar read via `.val()`, be dropped before
//   `.await`, and the extracted scalar held across `.await`.

use std.future.block_on.block_on;

struct MutexGuard {
    pub v: i64,
}

struct RwLockWriteGuard {
    pub v: i64,
}

struct FakeLock {
    pub base: i64,
}

impl FakeLock {
    pub fn lock(self: view<FakeLock>) -> MutexGuard {
        MutexGuard { v: self.base + 10i64 }
    }

    pub fn write(self: view<FakeLock>) -> RwLockWriteGuard {
        RwLockWriteGuard { v: self.base + 20i64 }
    }
}

@no_suspend_hold
struct Token {
    pub v: i64,
}

impl Token {
    pub fn val(self: view<Token>) -> i64 {
        self.v
    }
}

struct PendOnce {
    pub done: bool,
}

impl Future for PendOnce {
    type Output = i64;

    fn poll(self: mut_view<PendOnce>, cx: mut_view<Context>) -> Poll<i64> {
        if !self.done {
            self.done = true;
            return Poll.Pending;
        }
        Poll.Ready(5i64)
    }
}

fn acquire_mutex_guard(fl: view<FakeLock>) -> MutexGuard {
    let g = fl.lock();
    return g;
}

fn acquire_write_guard(fl: view<FakeLock>) -> RwLockWriteGuard {
    let g = fl.write();
    return g;
}

async fn run_all() -> i64 {
    let fl = FakeLock { base: 11i64 };
    let mg = acquire_mutex_guard(view(fl));
    let wg = acquire_write_guard(view(fl));
    let mut extracted = 0i64;
    {
        let tk = Token { v: 20i64 };
        extracted = tk.val();
    }
    let p = PendOnce { done: false }.await;
    mg.v + wg.v + extracted + p
}

fn main() -> i32 {
    let r = block_on(run_all());
    if r != 77i64 {
        print("FAIL\n");
        return 1i32;
    }
    print("OK qa_unmarked_guard_names_and_scalar_read 77\n");
    0i32
}
