// test: run
// modes: interp native
// stdout: before await\nafter await 1\nafter await 2\ndrop 7\nOK drop_guard_once_after_resume 7\n
// T422e: a Drop guard (async-style, not `@no_suspend_hold`) held across two suspension points
// stays alive in the coroutine frame and its destructor runs exactly once, after the last resume,
// when the async fn completes. The exact stdout (one `drop 7`, after `after await 2`, before the
// final line) is the evidence of the single destructor run.

use std.future.block_on.block_on;

struct ResGuard {
    pub id: i64,
}

impl Drop for ResGuard {
    fn drop(self: mut_view<ResGuard>) {
        if self.id == 7i64 {
            print("drop 7\n");
        } else {
            print("drop ?\n");
        }
    }
}

struct Pend {
    pub done: bool,
}

impl Future for Pend {
    type Output = ();

    fn poll(self: mut_view<Pend>, cx: mut_view<Context>) -> Poll<()> {
        if self.done {
            return Poll.Ready(());
        }
        self.done = true;
        Poll.Pending
    }
}

async fn work() -> i64 {
    let g = ResGuard { id: 7i64 };
    print("before await\n");
    Pend { done: false }.await;
    print("after await 1\n");
    Pend { done: false }.await;
    print("after await 2\n");
    g.id
}

fn main() -> i32 {
    let r = block_on(work());
    if r != 7i64 {
        print("FAIL value\n");
        return 1i32;
    }
    print("OK drop_guard_once_after_resume 7\n");
    0i32
}
