// test: run
// modes: interp native
// stdout: resumed\nguard dropped\nOK async_mutex_guard_name_held 5\n
// T422e regression: a type named `AsyncMutexGuard` (an async guard, SPEC-34 AXS-EXEC-031 / §6.1)
// held across `.await` must compile and run. The suspend-point guard policy is type-based
// (`@no_suspend_hold`), never keyed on a user-visible type name.

use std.future.block_on.block_on;

struct AsyncMutexGuard<T> {
    pub v: T,
}

impl<T> Drop for AsyncMutexGuard<T> {
    fn drop(self: mut_view<AsyncMutexGuard<T>>) {
        print("guard dropped\n");
    }
}

struct Ready {
    pub n: i64,
}

impl Future for Ready {
    type Output = AsyncMutexGuard<i64>;

    fn poll(self: mut_view<Ready>, cx: mut_view<Context>) -> Poll<AsyncMutexGuard<i64>> {
        Poll.Ready(AsyncMutexGuard { v: self.n })
    }
}

struct Pend {
    pub done: bool,
}

impl Future for Pend {
    type Output = ();

    fn poll(self: mut_view<Pend>, cx: mut_view<Context>) -> Poll<()> {
        if self.done {
            return Poll.Ready(());
        }
        self.done = true;
        Poll.Pending
    }
}

async fn hold() -> i64 {
    let h = Ready { n: 5i64 }.await;
    Pend { done: false }.await;
    print("resumed\n");
    h.v
}

fn main() -> i32 {
    let r = block_on(hold());
    if r != 5i64 {
        print("FAIL value\n");
        return 1i32;
    }
    print("OK async_mutex_guard_name_held 5\n");
    0i32
}
