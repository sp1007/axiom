// test: run
// modes: interp native
// stdout: OK renamed_non_drop_guard 47\n
// T422e: a plain (non-Drop) struct whose name ends in `Guard` is an ordinary value. Holding it
// across `.await` (twice) is accepted; only `@no_suspend_hold` types are rejected.

use std.future.block_on.block_on;

struct ScopeGuard {
    pub a: i64,
    pub b: i64,
}

struct Pend {
    pub left: i32,
}

impl Future for Pend {
    type Output = i64;

    fn poll(self: mut_view<Pend>, cx: mut_view<Context>) -> Poll<i64> {
        if self.left == 0i32 {
            return Poll.Ready(2i64);
        }
        self.left = self.left - 1i32;
        Poll.Pending
    }
}

async fn run() -> i64 {
    let g = ScopeGuard { a: 40i64, b: 3i64 };
    let x = Pend { left: 2i32 }.await;
    let y = Pend { left: 1i32 }.await;
    g.a + g.b + x + y
}

fn main() -> i32 {
    let r = block_on(run());
    if r != 47i64 {
        print("FAIL value\n");
        return 1i32;
    }
    print("OK renamed_non_drop_guard 47\n");
    0i32
}
