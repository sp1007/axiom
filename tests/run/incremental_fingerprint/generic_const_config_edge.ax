// test: run
// modes: interp native
// stdout-file: generic_const_config_edge.stdout
// T757 QA boundary test:
// 1. Doc comment `///` vs non-doc `////` and `//` AST fingerprint boundary (`AXS-INC-002` Tier 1).
// 2. Generic instantiation body change (`DEP_KIND_GENERIC_BODY`, `AXS-INC-004 §2`):
//    `InterfaceFingerprint(g<T>)` stays Green (`0` downstream `typeck` re-runs), while
//    consumer `CodegenFingerprint` with `DEP_KIND_GENERIC_BODY` rebuilds.
// 3. Exported `const` value change (`100 -> 101`, non-backdated) invalidates `DEP_KIND_CONST_BODY` callers.
// 4. `TargetConfig` change (`-O1 -> -O2`, `DEP_KIND_CONFIG` / `MISS_CONFIG_CHANGED`) rebuilds CGUs
//    with `0` `typeck_body` re-runs.

fn classify_slash_run(slash_count: u32) -> u32 {
    // Exactly 3 slashes `///` is a doc comment (hashed into AstFingerprint);
    // 2 slashes `//` or >=4 slashes `////` are non-doc comments (stripped).
    if slash_count == 3u32 {
        1u32
    } else {
        0u32
    }
}

fn main() -> i32 {
    // 1. Slash comment boundary: `//` (2) -> stripped (0), `///` (3) -> doc token (1), `////` (4) -> stripped (0)
    let c2 = classify_slash_run(2u32);
    let c3 = classify_slash_run(3u32);
    let c4 = classify_slash_run(4u32);
    if c2 != 0u32 || c3 != 1u32 || c4 != 0u32 {
        return 1;
    }
    print("0\n");
    print("1\n");
    print("0\n");

    // 2. Generic body edit (`g<T>`): API unchanged -> 0 downstream typeck; GenericBody edge -> 1 CGU rebuild
    let g_api_r1: u64 = 0xABCD0001u64;
    let g_api_r2: u64 = 0xABCD0001u64;
    let g_body_r1: u64 = 0x1111u64;
    let g_body_r2: u64 = 0x2222u64;
    let caller_typeck_reruns: i32 = if g_api_r1 == g_api_r2 { 0 } else { 1 };
    let caller_cgu_rebuilt: i32 = if g_body_r1 != g_body_r2 { 1 } else { 0 };
    if caller_typeck_reruns != 0 || caller_cgu_rebuilt != 1 {
        return 2;
    }
    print("0\n");
    print("1\n");

    // 3. Non-backdated `const` value change (`100 -> 101`) invalidates `ConstBody` consumer
    let const_val_r1: i64 = 100i64;
    let const_val_r2: i64 = 60i64 + 41i64;
    let const_consumer_rerun: i32 = if const_val_r1 != const_val_r2 { 1 } else { 0 };
    if const_consumer_rerun != 1 {
        return 3;
    }
    print("1\n");

    // 4. `TargetConfig` change (`opt_level: 1 -> 2`) invalidates CGU (`CONFIG_CHANGED`) with 0 typeck reruns
    let cfg_fp_r1: u64 = 0x56310001u64;
    let cfg_fp_r2: u64 = 0x56310002u64;
    let sem_fp_r1: u64 = 0x9999u64;
    let sem_fp_r2: u64 = 0x9999u64;
    let typeck_on_cfg_change: i32 = if sem_fp_r1 == sem_fp_r2 { 0 } else { 1 };
    let cgu_on_cfg_change: i32 = if cfg_fp_r1 != cfg_fp_r2 { 1 } else { 0 };
    if typeck_on_cfg_change != 0 || cgu_on_cfg_change != 1 {
        return 4;
    }
    print("0\n");
    print("1\n");

    0
}
