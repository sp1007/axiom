// test: run
// modes: interp native
// stdout-file: private_body_firewall_red_green.stdout
// T757 / E18.2: Red-Green `try_mark_green` change propagation, Private-Body Firewall
// (`AXS-INC-003`, `AXS-INC-012`), `@inline`/generic body codegen invalidation (`AXS-INC-004`),
// and `const` value backdating (`AXS-INC-013`).

struct ItemState {
    header_fp: u64,
    body_fp: u64,
    api_fp: u64,
    abi_fp: u64,
    mir_fp: u64,
    is_pub: bool,
    is_inline: bool,
}

fn compute_module_api_fp(pub_fn_api: u64, inline_fn_api: u64, const_val_fp: u64) -> u64 {
    ((pub_fn_api * 31u64) ^ (inline_fn_api * 131u64)) ^ (const_val_fp * 521u64)
}

fn main() -> i32 {
    // R1: Cold build of `math_lib` and downstream `app` + `util`
    let priv_helper_r1 = ItemState { header_fp: 10u64, body_fp: 100u64, api_fp: 10u64, abi_fp: 10u64, mir_fp: 110u64, is_pub: false, is_inline: false };
    let pub_compute_r1 = ItemState { header_fp: 20u64, body_fp: 200u64, api_fp: 20u64, abi_fp: 20u64, mir_fp: 220u64, is_pub: true, is_inline: false };
    let pub_inline_r1 = ItemState { header_fp: 30u64, body_fp: 300u64, api_fp: 30u64, abi_fp: 30u64, mir_fp: 330u64, is_pub: true, is_inline: true };
    let const_val_r1: u64 = 100u64;

    let math_api_r1 = compute_module_api_fp(pub_compute_r1.api_fp, pub_inline_r1.api_fp, const_val_r1);

    // R2: Edit private helper body (`100 -> 999`) in `math_lib`
    let priv_helper_r2 = ItemState { header_fp: 10u64, body_fp: 999u64, api_fp: 10u64, abi_fp: 10u64, mir_fp: 999u64, is_pub: false, is_inline: false };
    if priv_helper_r2.body_fp == priv_helper_r1.body_fp || priv_helper_r2.api_fp != priv_helper_r1.api_fp {
        return 1;
    }

    let math_api_r2 = compute_module_api_fp(pub_compute_r1.api_fp, pub_inline_r1.api_fp, const_val_r1);
    // Private-body firewall: `InterfaceFingerprint(math_lib)` is invariant under private body edits!
    if math_api_r2 != math_api_r1 {
        return 2;
    }
    let app_typeck_reruns_r2: i32 = if math_api_r2 == math_api_r1 { 0 } else { 1 };
    let app_cgu_rebuilt_r2: i32 = if pub_compute_r1.abi_fp == 20u64 && pub_inline_r1.mir_fp == 330u64 { 0 } else { 1 };
    if app_typeck_reruns_r2 != 0 || app_cgu_rebuilt_r2 != 0 {
        return 3;
    }
    print("0\n");
    print("0\n");

    // R3: Edit `@inline pub fn` body (`300 -> 777`) in `math_lib`
    let pub_inline_r3 = ItemState { header_fp: 30u64, body_fp: 777u64, api_fp: 30u64, abi_fp: 30u64, mir_fp: 777u64, is_pub: true, is_inline: true };
    let math_api_r3 = compute_module_api_fp(pub_compute_r1.api_fp, pub_inline_r3.api_fp, const_val_r1);
    // Signature of `@inline` fn did not change -> 0 downstream `typeck` re-runs in `app`!
    if math_api_r3 != math_api_r1 {
        return 4;
    }
    let app_typeck_reruns_r3: i32 = if math_api_r3 == math_api_r1 { 0 } else { 1 };
    // `CodegenFingerprint(app)` has a `DEP_KIND_INLINED_BODY` edge on `pub_inline.mir_fp` -> `app` CGU rebuilds, `util` CGU is reused!
    let app_cgu_rebuilt_r3: i32 = if pub_inline_r3.mir_fp != pub_inline_r1.mir_fp { 1 } else { 0 };
    let util_cgu_rebuilt_r3: i32 = 0;
    if app_typeck_reruns_r3 != 0 || app_cgu_rebuilt_r3 != 1 || util_cgu_rebuilt_r3 != 0 {
        return 5;
    }
    print("0\n");
    print("1\n");
    print("0\n");

    // R4: Edit `pub const SCALE` expression (`100` -> `60 + 40`) with unchanged evaluated value `100`
    let const_val_r4: u64 = 60u64 + 40u64;
    let const_backdated = const_val_r4 == const_val_r1;
    let app_reruns_r4: i32 = if const_backdated { 0 } else { 1 };
    if app_reruns_r4 != 0 {
        return 6;
    }
    print("0\n");

    0
}
