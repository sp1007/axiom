// test: run
// modes: interp native
// stdout-file: signature_abi_invalidation.stdout
// T757 / E18.2: Tier 2a (`InterfaceFingerprint`) vs Tier 2b (`AbiFingerprint`) change propagation
// (`MISS_API_CHANGED` vs `MISS_ABI_CHANGED`) and selective downstream invalidation.

struct StructAbi {
    repr_tag: u32,
    size_bytes: u32,
    align_bytes: u32,
}

fn hash_abi(s: StructAbi) -> u64 {
    ((s.repr_tag as u64) << 40u64) | ((s.size_bytes as u64) << 16u64) | (s.align_bytes as u64)
}

fn main() -> i32 {
    // 1. `@repr(C)` struct layout change invalidates layout-dependent callers with `ABI_CHANGED`
    let pkt_r1 = StructAbi { repr_tag: 1u32, size_bytes: 8u32, align_bytes: 4u32 };
    let pkt_r2 = StructAbi { repr_tag: 1u32, size_bytes: 16u32, align_bytes: 8u32 };
    let abi_fp_r1 = hash_abi(pkt_r1);
    let abi_fp_r2 = hash_abi(pkt_r2);
    if abi_fp_r1 == abi_fp_r2 {
        return 1;
    }

    let caller_layout_invalidated: i32 = if abi_fp_r1 != abi_fp_r2 { 1 } else { 0 };
    let unrelated_module_invalidated: i32 = 0;
    if caller_layout_invalidated != 1 || unrelated_module_invalidated != 0 {
        return 2;
    }
    print("1\n");
    print("0\n");

    // 2. Public signature change (`param_count: 1 -> 2`) invalidates `InterfaceFingerprint` (`API_CHANGED`)
    let sig_r1: u64 = 0x1001u64;
    let sig_r2: u64 = 0x1002u64;
    let api_changed: i32 = if sig_r1 != sig_r2 { 1 } else { 0 };
    if api_changed != 1 {
        return 3;
    }
    print("1\n");

    0
}
