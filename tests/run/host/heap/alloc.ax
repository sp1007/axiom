// test: run
// modes: interp
// reason: oracle-only check
// exit: 48

use std.core.host.heap_alloc
use std.core.host.heap_realloc
use std.core.host.heap_free

fn main() -> i32 {
    let p: *mut u8 = unsafe { heap_alloc(16, 8) };
    if p as usize == 0 {
        return 1;
    }
    unsafe {
        let mut i: usize = 0;
        while i < 16 {
            *(p + i) = (i + 1) as u8;
            i = i + 1;
        }
    }

    let p2: *mut u8 = unsafe { heap_realloc(p, 16, 32, 8) };
    if p2 as usize == 0 {
        return 2;
    }

    let mut res: i32 = 0;
    unsafe {
        let mut i: usize = 0;
        while i < 16 {
            if *(p2 + i) != (i + 1) as u8 {
                return 3;
            }
            i = i + 1;
        }
        while i < 32 {
            *(p2 + i) = (i + 1) as u8;
            i = i + 1;
        }
        res = (*(p2 + 15) as i32) + (*(p2 + 31) as i32);
        heap_free(p2, 32, 8);
    }

    return res;
}
