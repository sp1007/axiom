// test: run
// native-after: T070
// exit: 125
// stderr-contains: use-after-free

use std.core.host.heap_alloc
use std.core.host.heap_free

fn main() -> i32 {
    let p: *mut u8 = unsafe { heap_alloc(16, 8) };
    unsafe {
        *p = 42;
        heap_free(p, 16, 8);
        let val: u8 = *p;
        return val as i32;
    }
}
