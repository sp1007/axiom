// test: run
// exit: 136
// stdout: sum 136\n
// T423h (ADR-0048 §3): heap intrinsics with no `__ax_host_heap_*` defined by the program. Natively the driver adds
// the provider module `std.sys.windows.heap` (it was AX_LINK_UNDEFINED_SYMBOL before, see
// ../native_undefined_symbol.test for a std root without the provider); the interpreter answers the intrinsics.

use std.core.host.heap_alloc
use std.core.host.heap_realloc
use std.core.host.heap_free

fn main() -> i32 {
    let p: *mut u8 = unsafe { heap_alloc(8, 8) };
    if p as usize == 0 {
        return 1;
    }
    let mut i: usize = 0;
    while i < 8 {
        unsafe { *(p + i) = (i + 1) as u8; }
        i = i + 1;
    }
    let q: *mut u8 = unsafe { heap_realloc(p, 8, 16, 8) };
    if q as usize == 0 {
        return 2;
    }
    while i < 16 {
        unsafe { *(q + i) = (i + 1) as u8; }
        i = i + 1;
    }
    let mut sum: i64 = 0;
    let mut k: usize = 0;
    while k < 16 {
        sum = sum + (unsafe { *(q + k) }) as i64;
        k = k + 1;
    }
    unsafe { heap_free(q, 16, 8); }
    print("sum ");
    print_int(sum);
    print("\n");
    sum as i32
}
