// test: run
// native-after: T074
// stdout: Xin chào thế giới\n
// stderr: lỗi\n

use std.core.host.stdio
use std.core.host.write
use std.core.host.heap_alloc
use std.core.host.heap_free

fn main() -> i32 {
    let stdout_handle: i64 = stdio(1);
    let stderr_handle: i64 = stdio(2);

    let msg1: *mut u8 = unsafe { heap_alloc(23, 1) };
    let msg2: *mut u8 = unsafe { heap_alloc(6, 1) };

    // "Xin chào thế giới\n" (23 bytes UTF-8)
    unsafe {
        *msg1 = 0x58;
        *(msg1 + 1) = 0x69;
        *(msg1 + 2) = 0x6e;
        *(msg1 + 3) = 0x20;
        *(msg1 + 4) = 0x63;
        *(msg1 + 5) = 0x68;
        *(msg1 + 6) = 0xc3;
        *(msg1 + 7) = 0xa0;
        *(msg1 + 8) = 0x6f;
        *(msg1 + 9) = 0x20;
        *(msg1 + 10) = 0x74;
        *(msg1 + 11) = 0x68;
        *(msg1 + 12) = 0xe1;
        *(msg1 + 13) = 0xba;
        *(msg1 + 14) = 0xbf;
        *(msg1 + 15) = 0x20;
        *(msg1 + 16) = 0x67;
        *(msg1 + 17) = 0x69;
        *(msg1 + 18) = 0xe1;
        *(msg1 + 19) = 0xbb;
        *(msg1 + 20) = 0x9b;
        *(msg1 + 21) = 0x69;
        *(msg1 + 22) = 0x0a;
    }

    // "lỗi\n" (6 bytes UTF-8)
    unsafe {
        *msg2 = 0x6c;
        *(msg2 + 1) = 0xe1;
        *(msg2 + 2) = 0xbb;
        *(msg2 + 3) = 0x97;
        *(msg2 + 4) = 0x69;
        *(msg2 + 5) = 0x0a;
    }

    unsafe {
        write(stdout_handle, msg1 as *const u8, 23);
        write(stderr_handle, msg2 as *const u8, 6);
        heap_free(msg1, 23, 1);
        heap_free(msg2, 6, 1);
    }

    return 0;
}
