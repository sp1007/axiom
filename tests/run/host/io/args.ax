// test: run
// native-after: T074
// args: "xin chào"
// stdout: 2 xin chào\n

use std.core.host.args_count
use std.core.host.arg
use std.core.host.stdio
use std.core.host.write
use std.core.host.heap_alloc
use std.core.host.heap_free

fn main() -> i32 {
    let count: usize = args_count();
    if count != 2 {
        return 1;
    }

    let buf: *mut u8 = unsafe { heap_alloc(64, 1) };
    let n: i64 = unsafe { arg(1, buf, 64) };
    if n <= 0 {
        return 2;
    }

    let out_h: i64 = stdio(1);
    let prefix: *mut u8 = unsafe { heap_alloc(2, 1) };
    unsafe {
        *prefix = 0x32; // '2'
        *(prefix + 1) = 0x20; // ' '
        write(out_h, prefix as *const u8, 2);
        write(out_h, buf as *const u8, n as usize);
        *prefix = 0x0a; // '\n'
        write(out_h, prefix as *const u8, 1);
        heap_free(prefix, 2, 1);
        heap_free(buf, 64, 1);
    }

    return 0;
}
