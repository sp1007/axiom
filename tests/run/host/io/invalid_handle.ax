// test: run

use std.core.host.read
use std.core.host.write
use std.core.host.close
use std.core.host.file_size
use std.core.host.arg
use std.core.host.dir_next
use std.core.host.dir_close
use std.core.host.heap_alloc
use std.core.host.heap_free

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
    fn GetCommandLineW() -> *const u16;
    fn LocalFree(hMem: *mut u8) -> *mut u8;
}

@link("shell32")
extern "system" {
    fn CommandLineToArgvW(lpCmdLine: *const u16, pNumArgs: *mut i32) -> *mut *mut u16;
}

@intrinsic pub unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

pub unsafe fn __ax_host_read(h: i64, buf: *mut u8, cap: usize) -> i64 {
    if h < 0 || h > 2 {
        return -4;
    }
    0
}

pub unsafe fn __ax_host_write(h: i64, p: *const u8, count: usize) -> i64 {
    if h < 0 || h > 2 {
        return -4;
    }
    0
}

pub fn __ax_host_close(h: i64) -> i64 {
    if h >= 0 && h <= 2 {
        return 0;
    }
    -4
}

pub fn __ax_host_file_size(h: i64) -> i64 {
    -4
}

pub unsafe fn __ax_host_arg(i: usize, buf: *mut u8, cap: usize) -> i64 {
    let mut num: [1]i32 = [0i32];
    let cmd = GetCommandLineW();
    let argv = CommandLineToArgvW(cmd, address_of_mut(num[0]));
    if argv as usize == 0 {
        return -4;
    }
    let count = num[0] as usize;
    LocalFree(argv as *mut u8);
    if i >= count {
        return -4;
    }
    0
}

pub unsafe fn __ax_host_dir_next(h: i64, buf: *mut u8, cap: usize) -> i64 {
    -4
}

pub fn __ax_host_dir_close(h: i64) -> i64 {
    -4
}

fn main() -> i32 {
    let buf: *mut u8 = unsafe { heap_alloc(16, 1) };

    let r: i64 = unsafe { read(99, buf, 16) };
    if r != -4 {
        return 1;
    }

    let w: i64 = unsafe { write(99, buf as *const u8, 16) };
    if w != -4 {
        return 2;
    }

    let c: i64 = close(99);
    if c != -4 {
        return 3;
    }

    let sz: i64 = file_size(99);
    if sz != -4 {
        return 4;
    }

    let a: i64 = unsafe { arg(999, buf, 16) };
    if a != -4 {
        return 5;
    }

    let dn: i64 = unsafe { dir_next(999, buf, 16) };
    if dn != -4 {
        return 6;
    }

    let dc: i64 = dir_close(999);
    if dc != -4 {
        return 7;
    }

    unsafe {
        heap_free(buf, 16, 1);
    }

    return 0;
}
