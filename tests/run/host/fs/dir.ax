// test: run
// native-after: T074b

use std.core.host.mkdir
use std.core.host.dir_open
use std.core.host.dir_next
use std.core.host.dir_close
use std.core.host.open
use std.core.host.close
use std.core.host.remove
use std.core.host.heap_alloc
use std.core.host.heap_free

fn main() -> i32 {
    let dir_path: *mut u8 = unsafe { heap_alloc(32, 1) };
    // "test_host_dir" (13 chars)
    unsafe {
        *dir_path = 0x74;
        *(dir_path + 1) = 0x65;
        *(dir_path + 2) = 0x73;
        *(dir_path + 3) = 0x74;
        *(dir_path + 4) = 0x5f;
        *(dir_path + 5) = 0x68;
        *(dir_path + 6) = 0x6f;
        *(dir_path + 7) = 0x73;
        *(dir_path + 8) = 0x74;
        *(dir_path + 9) = 0x5f;
        *(dir_path + 10) = 0x64;
        *(dir_path + 11) = 0x69;
        *(dir_path + 12) = 0x72;
    }

    let mk: i64 = unsafe { mkdir(dir_path as *const u8, 13) };
    if mk < 0 {
        return 1;
    }

    // Create file: "test_host_dir/a.txt" (19 chars)
    let f1_path: *mut u8 = unsafe { heap_alloc(32, 1) };
    unsafe {
        let mut i: usize = 0;
        while i < 13 {
            *(f1_path + i) = *(dir_path + i);
            i = i + 1;
        }
        *(f1_path + 13) = 0x2f; // '/'
        *(f1_path + 14) = 0x61; // 'a'
        *(f1_path + 15) = 0x2e; // '.'
        *(f1_path + 16) = 0x74; // 't'
        *(f1_path + 17) = 0x78; // 'x'
        *(f1_path + 18) = 0x74; // 't'
    }

    let h1: i64 = unsafe { open(f1_path as *const u8, 19, 1) };
    if h1 < 0 {
        return 2;
    }
    close(h1);

    // Create file: "test_host_dir/b.txt" (19 chars)
    let f2_path: *mut u8 = unsafe { heap_alloc(32, 1) };
    unsafe {
        let mut i: usize = 0;
        while i < 19 {
            *(f2_path + i) = *(f1_path + i);
            i = i + 1;
        }
        *(f2_path + 14) = 0x62; // 'b'
    }

    let h2: i64 = unsafe { open(f2_path as *const u8, 19, 1) };
    if h2 < 0 {
        return 3;
    }
    close(h2);

    let dh: i64 = unsafe { dir_open(dir_path as *const u8, 13) };
    if dh < 0 {
        return 4;
    }

    let name_buf: *mut u8 = unsafe { heap_alloc(64, 1) };
    let mut count: i32 = 0;
    let mut saw_a: bool = false;
    let mut saw_b: bool = false;

    let mut loop_count: i32 = 0;
    while loop_count < 10 {
        let n: i64 = unsafe { dir_next(dh, name_buf, 64) };
        if n == 0 {
            break;
        }
        if n == 5 {
            // "a.txt" or "b.txt"
            unsafe {
                if *(name_buf) == 0x61 {
                    saw_a = true;
                    count = count + 1;
                }
                if *(name_buf) == 0x62 {
                    saw_b = true;
                    count = count + 1;
                }
            }
        }
        loop_count = loop_count + 1;
    }

    dir_close(dh);

    // Cleanup files and directory
    unsafe {
        remove(f1_path as *const u8, 19);
        remove(f2_path as *const u8, 19);
        remove(dir_path as *const u8, 13);
        heap_free(dir_path, 32, 1);
        heap_free(f1_path, 32, 1);
        heap_free(f2_path, 32, 1);
        heap_free(name_buf, 64, 1);
    }

    if count != 2 || !saw_a || !saw_b {
        return 5;
    }

    return 0;
}
