// test: run
// native-after: T074b

use std.core.host.open
use std.core.host.write
use std.core.host.read
use std.core.host.close
use std.core.host.file_size
use std.core.host.remove
use std.core.host.heap_alloc
use std.core.host.heap_free

fn main() -> i32 {
    let path: *mut u8 = unsafe { heap_alloc(32, 1) };
    // "test_file_io.tmp" (16 chars)
    unsafe {
        *path = 0x74;
        *(path + 1) = 0x65;
        *(path + 2) = 0x73;
        *(path + 3) = 0x74;
        *(path + 4) = 0x5f;
        *(path + 5) = 0x66;
        *(path + 6) = 0x69;
        *(path + 7) = 0x6c;
        *(path + 8) = 0x65;
        *(path + 9) = 0x5f;
        *(path + 10) = 0x69;
        *(path + 11) = 0x6f;
        *(path + 12) = 0x2e;
        *(path + 13) = 0x74;
        *(path + 14) = 0x6d;
        *(path + 15) = 0x70;
    }

    // Open for write: mode 1 = write+create+truncate
    let h: i64 = unsafe { open(path as *const u8, 16, 1) };
    if h < 0 {
        return 1;
    }

    let data: *mut u8 = unsafe { heap_alloc(8, 1) };
    unsafe {
        *data = 0x48;
        *(data + 1) = 0x65;
        *(data + 2) = 0x6c;
        *(data + 3) = 0x6c;
        *(data + 4) = 0x6f;
        *(data + 5) = 0x21;
        *(data + 6) = 0x0a; // "Hello!\n" (7 bytes)
    }

    let written: i64 = unsafe { write(h, data as *const u8, 7) };
    if written != 7 {
        return 2;
    }

    let sz: i64 = file_size(h);
    if sz != 7 {
        return 3;
    }

    let cl1: i64 = close(h);
    if cl1 < 0 {
        return 4;
    }

    // Reopen for read: mode 0
    let h2: i64 = unsafe { open(path as *const u8, 16, 0) };
    if h2 < 0 {
        return 5;
    }

    let read_buf: *mut u8 = unsafe { heap_alloc(16, 1) };
    let bytes_read: i64 = unsafe { read(h2, read_buf, 16) };
    if bytes_read != 7 {
        return 6;
    }

    unsafe {
        let mut i: usize = 0;
        while i < 7 {
            if *(read_buf + i) != *(data + i) {
                return 7;
            }
            i = i + 1;
        }
    }

    let cl2: i64 = close(h2);
    if cl2 < 0 {
        return 8;
    }

    let rm: i64 = unsafe { remove(path as *const u8, 16) };
    if rm < 0 {
        return 9;
    }

    unsafe {
        heap_free(path, 32, 1);
        heap_free(data, 8, 1);
        heap_free(read_buf, 16, 1);
    }

    return 0;
}
