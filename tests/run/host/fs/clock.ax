// native-after: T074b

use std.core.host.monotonic_ns;

fn main() -> i32 {
    let t1: u64 = monotonic_ns();
    let mut i: usize = 0;
    let mut dummy: u64 = 0;
    while i < 1000 {
        dummy = dummy + 1;
        i = i + 1;
    }
    let t2: u64 = monotonic_ns();
    if t2 < t1 {
        return 1;
    }
    return 0;
}
