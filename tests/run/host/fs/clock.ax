// test: run

use std.core.host.monotonic_ns;

@link("kernel32")
extern "system" {
    fn QueryPerformanceCounter(lpPerformanceCount: *mut i64) -> i32;
    fn QueryPerformanceFrequency(lpFrequency: *mut i64) -> i32;
}

@intrinsic pub unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

pub fn __ax_host_monotonic_ns() -> u64 {
    let mut count: [1]i64 = [0i64];
    let mut freq: [1]i64 = [0i64];
    let ok1 = unsafe { QueryPerformanceCounter(address_of_mut(count[0])) };
    let ok2 = unsafe { QueryPerformanceFrequency(address_of_mut(freq[0])) };
    if ok1 == 0 || ok2 == 0 {
        return 0u64;
    }
    let f = freq[0] as u64;
    let c = count[0] as u64;
    if f == 0u64 {
        return 0u64;
    }
    let s = c / f;
    let rem = c % f;
    s * 1_000_000_000u64 + (rem * 1_000_000_000u64) / f
}

fn main() -> i32 {
    let t1: u64 = monotonic_ns();
    let mut i: usize = 0;
    let mut dummy: u64 = 0;
    while i < 1000 {
        dummy = dummy + 1;
        i = i + 1;
    }
    let t2: u64 = monotonic_ns();
    if t2 < t1 {
        return 1;
    }
    return 0;
}
