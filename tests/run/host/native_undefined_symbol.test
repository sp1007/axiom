# A native build whose std root has no provider module for a used host intrinsic still reports the missing
# `__ax_host_<name>` at link time (T423h: with the real std root the driver adds `std.sys.windows.heap`, see
# heap/provider_native.ax; this fixture std root has `core/host.ax` only).
cmd: {compiler} build --std-root tests/run/host/fixtures/std_no_provider -o {tmp}/out.exe tests/run/host/fixtures/uses_heap_alloc.ax
exit: 1
stderr-contains: AX_LINK_UNDEFINED_SYMBOL
stderr-contains: __ax_host_heap_alloc
cache-inputs: tests/run/host/fixtures
