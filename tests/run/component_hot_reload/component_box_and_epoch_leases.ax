// test: run
// modes: interp native
// stdout-file: component_box_and_epoch_leases.stdout
// SPEC-115 §§3..5 (AXS-COMP-020..025, AXS-COMP-041..042; REQ-ECO-8734, INV-COMP-002):
// Verifies ComponentBox originating-allocator deallocation routing, generational ComponentHandle
// stale-generation and stale-epoch detection, and active ComponentLease physical-unload lockout.

const AX_COMP_CROSS_ALLOCATOR_VIOLATION: u32 = 239u32
const AX_COMP_STALE_HANDLE: u32 = 240u32
const AX_COMP_UNLOAD_ACTIVE_LEASES: u32 = 241u32
const AX_COMP_COMPONENT_QUIESCING: u32 = 246u32

const LEASE_KIND_BORROW: u32 = 1u32
const LEASE_KIND_TASK: u32 = 2u32
const LEASE_KIND_CALLBACK: u32 = 3u32
const LEASE_KIND_GPU_FENCE: u32 = 4u32

// 1. Allocator VTable and ComponentBox simulation (AXS-COMP-021)
@repr(C)
struct AllocatorVTable {
    deallocate: fn(*mut u8, *mut u8, usize, usize) -> (),
    reallocate: fn(*mut u8, *mut u8, usize, usize, usize) -> *mut u8,
}

fn mock_deallocate(ctx: *mut u8, ptr: *mut u8, size: usize, align: usize) -> () {
    let _ = ctx
    let _ = ptr
    let _ = size
    let _ = align
}

fn mock_reallocate(ctx: *mut u8, ptr: *mut u8, old_size: usize, new_size: usize, align: usize) -> *mut u8 {
    let _ = ctx
    let _ = old_size
    let _ = new_size
    let _ = align
    ptr
}

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(mut val: T) -> *mut T { 0 as *mut T }

fn check_component_box_drop(vt: *const AllocatorVTable, ptr: *mut u8, size: usize, align: usize) -> u32 {
    let _ = ptr
    let _ = size
    let _ = align
    if (vt as usize) == 0usize {
        return AX_COMP_CROSS_ALLOCATOR_VIOLATION
    }
    0u32
}

// 2. Generational Handle & Slot Table (AXS-COMP-022)
@repr(C)
@derive(Copy)
struct ComponentHandle {
    index: u32,
    generation: u32,
    epoch_id: u32,
}

@derive(Copy)
struct HandleSlot {
    generation: u32,
    epoch_id: u32,
    is_occupied: bool,
    value: u64,
}

struct HandleTable {
    slots: [8]HandleSlot,
    capacity: usize,
    count: usize,
    current_epoch: u32,
}

fn handle_table_new(epoch: u32) -> HandleTable {
    let empty_slot = HandleSlot {
        generation: 1u32,
        epoch_id: epoch,
        is_occupied: false,
        value: 0u64,
    }
    HandleTable {
        slots: [empty_slot, empty_slot, empty_slot, empty_slot,
                empty_slot, empty_slot, empty_slot, empty_slot],
        capacity: 8usize,
        count: 0usize,
        current_epoch: epoch,
    }
}

fn handle_table_insert(tbl: mut_view<HandleTable>, val: u64) -> ComponentHandle {
    let mut target_idx: usize = 8usize
    let mut i: usize = 0usize
    while i < tbl.capacity {
        if !tbl.slots[i].is_occupied {
            target_idx = i
            i = tbl.capacity
        } else {
            i = i + 1usize
        }
    }
    if target_idx >= tbl.capacity {
        return ComponentHandle { index: 0xFFFFFFFFu32, generation: 0u32, epoch_id: 0u32 }
    }

    tbl.slots[target_idx].epoch_id = tbl.current_epoch
    tbl.slots[target_idx].is_occupied = true
    tbl.slots[target_idx].value = val
    tbl.count = tbl.count + 1usize

    ComponentHandle {
        index: target_idx as u32,
        generation: tbl.slots[target_idx].generation,
        epoch_id: tbl.current_epoch,
    }
}

fn handle_table_get(tbl: view<HandleTable>, handle: ComponentHandle, out_val: mut_view<u64>) -> u32 {
    let idx = handle.index as usize
    if idx >= tbl.capacity {
        return AX_COMP_STALE_HANDLE
    }
    let slot = tbl.slots[idx]
    if !slot.is_occupied {
        return AX_COMP_STALE_HANDLE
    }
    if slot.generation != handle.generation {
        return AX_COMP_STALE_HANDLE
    }
    if slot.epoch_id != handle.epoch_id || handle.epoch_id != tbl.current_epoch {
        return AX_COMP_STALE_HANDLE
    }

    *out_val = slot.value
    0u32
}

fn handle_table_release(tbl: mut_view<HandleTable>, handle: ComponentHandle) -> u32 {
    let idx = handle.index as usize
    if idx >= tbl.capacity {
        return AX_COMP_STALE_HANDLE
    }
    if !tbl.slots[idx].is_occupied {
        return AX_COMP_STALE_HANDLE
    }
    if tbl.slots[idx].generation != handle.generation || tbl.slots[idx].epoch_id != handle.epoch_id {
        return AX_COMP_STALE_HANDLE
    }

    tbl.slots[idx].is_occupied = false
    tbl.slots[idx].generation = tbl.slots[idx].generation + 1u32
    if tbl.count > 0usize {
        tbl.count = tbl.count - 1usize
    }
    0u32
}

// 3. Epoch Tracker and ComponentLease (AXS-COMP-023, AXS-COMP-024)
struct EpochTracker {
    epoch_id: u32,
    active_leases: u64,
    status: u32,
    active_borrows: u32,
    active_tasks: u32,
    active_callbacks: u32,
    active_gpu_fences: u32,
}

fn epoch_tracker_new(epoch: u32) -> EpochTracker {
    EpochTracker {
        epoch_id: epoch,
        active_leases: 0u64,
        status: 1u32, // Active
        active_borrows: 0u32,
        active_tasks: 0u32,
        active_callbacks: 0u32,
        active_gpu_fences: 0u32,
    }
}

fn acquire_lease(trk: mut_view<EpochTracker>, kind: u32) -> u32 {
    if trk.status != 1u32 {
        return AX_COMP_COMPONENT_QUIESCING
    }
    trk.active_leases = trk.active_leases + 1u64
    if kind == LEASE_KIND_BORROW {
        trk.active_borrows = trk.active_borrows + 1u32
    } else if kind == LEASE_KIND_TASK {
        trk.active_tasks = trk.active_tasks + 1u32
    } else if kind == LEASE_KIND_CALLBACK {
        trk.active_callbacks = trk.active_callbacks + 1u32
    } else if kind == LEASE_KIND_GPU_FENCE {
        trk.active_gpu_fences = trk.active_gpu_fences + 1u32
    }
    0u32
}

fn release_lease(trk: mut_view<EpochTracker>, kind: u32) -> u32 {
    if trk.active_leases > 0u64 {
        trk.active_leases = trk.active_leases - 1u64
    }
    if kind == LEASE_KIND_BORROW && trk.active_borrows > 0u32 {
        trk.active_borrows = trk.active_borrows - 1u32
    } else if kind == LEASE_KIND_TASK && trk.active_tasks > 0u32 {
        trk.active_tasks = trk.active_tasks - 1u32
    } else if kind == LEASE_KIND_CALLBACK && trk.active_callbacks > 0u32 {
        trk.active_callbacks = trk.active_callbacks - 1u32
    } else if kind == LEASE_KIND_GPU_FENCE && trk.active_gpu_fences > 0u32 {
        trk.active_gpu_fences = trk.active_gpu_fences - 1u32
    }
    0u32
}

fn validate_unload(trk: view<EpochTracker>) -> u32 {
    if trk.active_leases > 0u64 {
        return AX_COMP_UNLOAD_ACTIVE_LEASES
    }
    0u32
}

pub fn main() -> i32 {
    // 1. Originating Allocator VTable Routing (AXS-COMP-021)
    let vt = AllocatorVTable {
        deallocate: mock_deallocate,
        reallocate: mock_reallocate,
    }
    let mut dummy_buf: [16]u8 = [
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8
    ]
    let dummy_ptr = unsafe { address_of_mut(dummy_buf[0]) }

    // Dropping with valid allocator vtable succeeds
    let vt_ptr = unsafe { address_of(vt) }
    let drop_ok = check_component_box_drop(vt_ptr, dummy_ptr, 64usize, 8usize)
    if drop_ok != 0u32 {
        return 1
    }

    // Dropping without allocator vtable returns AX_COMP_CROSS_ALLOCATOR_VIOLATION
    let drop_err = check_component_box_drop(0 as *const AllocatorVTable, dummy_ptr, 64usize, 8usize)
    if drop_err != AX_COMP_CROSS_ALLOCATOR_VIOLATION {
        return 2
    }

    // 2. Generational Handle Table: stale generation and stale epoch defense (AXS-COMP-022)
    let mut table = handle_table_new(1u32) // Epoch 1
    let h1 = handle_table_insert(mut_view(table), 42u64)
    let h2 = handle_table_insert(mut_view(table), 99u64)

    // Retrieval succeeds
    let mut val: u64 = 0u64
    let get_rc1 = handle_table_get(view(table), h1, mut_view(val))
    if get_rc1 != 0u32 || val != 42u64 {
        return 3
    }

    // Release h1: increments slot generation
    let rel_rc = handle_table_release(mut_view(table), h1)
    if rel_rc != 0u32 {
        return 4
    }

    // Use-after-free: accessing released handle detects stale generation!
    let stale_gen_rc = handle_table_get(view(table), h1, mut_view(val))
    if stale_gen_rc != AX_COMP_STALE_HANDLE {
        return 5
    }

    // Insert new item reusing slot: gets generation 2
    let h1_new = handle_table_insert(mut_view(table), 777u64)
    if h1_new.generation <= h1.generation {
        return 6
    }
    // Old handle h1 is still stale even after slot reuse!
    let stale_gen_rc2 = handle_table_get(view(table), h1, mut_view(val))
    if stale_gen_rc2 != AX_COMP_STALE_HANDLE {
        return 7
    }

    // Stale epoch defense: advance table epoch to 2 without migrating h2
    table.current_epoch = 2u32
    let stale_epoch_rc = handle_table_get(view(table), h2, mut_view(val))
    if stale_epoch_rc != AX_COMP_STALE_HANDLE {
        return 8
    }

    // 3. Epoch Tracker and ComponentLease Unload Protection (AXS-COMP-023, AXS-COMP-024)
    let mut tracker = epoch_tracker_new(1u32)
    if validate_unload(view(tracker)) != 0u32 {
        return 9
    }

    // Acquire active leases: borrow, task, callback, GPU fence
    let _ = acquire_lease(mut_view(tracker), LEASE_KIND_BORROW)
    let _ = acquire_lease(mut_view(tracker), LEASE_KIND_TASK)
    let _ = acquire_lease(mut_view(tracker), LEASE_KIND_CALLBACK)
    let _ = acquire_lease(mut_view(tracker), LEASE_KIND_GPU_FENCE)

    if tracker.active_leases != 4u64 {
        return 10
    }

    // While leases are active, physical unload is strictly rejected!
    let unload_blocked = validate_unload(view(tracker))
    if unload_blocked != AX_COMP_UNLOAD_ACTIVE_LEASES {
        return 11
    }

    // Release leases one by one
    let _ = release_lease(mut_view(tracker), LEASE_KIND_BORROW)
    let _ = release_lease(mut_view(tracker), LEASE_KIND_TASK)
    let _ = release_lease(mut_view(tracker), LEASE_KIND_CALLBACK)

    // Still 1 active lease (GPU fence): unload still blocked!
    if validate_unload(view(tracker)) != AX_COMP_UNLOAD_ACTIVE_LEASES {
        return 12
    }

    // Complete GPU fence: active leases reach 0
    let _ = release_lease(mut_view(tracker), LEASE_KIND_GPU_FENCE)
    if tracker.active_leases != 0u64 {
        return 13
    }

    // Now physical unload succeeds!
    let unload_ok = validate_unload(view(tracker))
    if unload_ok != 0u32 {
        return 14
    }

    print("COMPONENT-BOX-AND-EPOCH-LEASES-OK\n")
    0
}
