// Direct multi-module verification probe for std.component.loader and std.component.hot_reload
// (T872 / E20.7: SPEC-115 §§1..5 & §6, REQ-ECO-8734, INV-COMP-002).

module main

use host_intrinsics.stdio
use host_intrinsics.write

use std.component.loader.AX_COMP_MISSING_ENTRY_POINT
use std.component.loader.AX_COMP_MISSING_MANIFEST
use std.component.loader.AX_COMP_CORRUPT_MANIFEST
use std.component.loader.AX_COMP_DUPLICATE_REGISTRATION
use std.component.loader.AX_COMP_TARGET_MISMATCH
use std.component.loader.AX_COMP_VERSION_INCOMPATIBLE
use std.component.loader.AX_COMP_ABI_MISMATCH
use std.component.loader.AX_COMP_CAPABILITY_DENIED
use std.component.loader.AX_COMP_RAW_POINTER_ESCAPE
use std.component.loader.AX_COMP_CROSS_ALLOCATOR_VIOLATION
use std.component.loader.AX_COMP_STALE_HANDLE
use std.component.loader.AX_COMP_UNLOAD_ACTIVE_LEASES
use std.component.loader.AX_COMP_QUIESCE_TIMEOUT
use std.component.loader.AX_COMP_HOT_RELOAD_SCHEMA_MISMATCH
use std.component.loader.AX_COMP_HOT_RELOAD_MIGRATION_FAILED
use std.component.loader.AX_COMP_CAPABILITY_REVOKED
use std.component.loader.AX_COMP_COMPONENT_QUIESCING
