use std.component.loader.CAP_HEAP_ALLOCATION
use std.component.loader.CAP_FS_READ
use std.component.loader.CAP_FS_WRITE
use std.component.loader.CAP_NET_CONNECT
use std.component.loader.CAP_CONCURRENCY
use std.component.loader.CAP_GPU
use std.component.loader.COMPONENT_STATUS_ACTIVE
use std.component.loader.COMPONENT_STATUS_QUIESCING
use std.component.loader.COMPONENT_STATUS_RETIRED
use std.component.loader.COMPONENT_STATUS_UNLOADED
use std.component.loader.InterfaceFingerprint
use std.component.loader.TargetTripleFingerprint
use std.component.loader.StateSchemaId
use std.component.loader.AbiFingerprint
use std.component.loader.ComponentSemVer
use std.component.loader.AxCompHeader
use std.component.loader.CapabilityManifest
use std.component.loader.CapabilityGrant
use std.component.loader.DiscoveredComponent
use std.component.loader.ComponentQuery
use std.component.loader.ComponentHost
use std.component.loader.Component
use std.component.loader.interface_fingerprint_new
use std.component.loader.target_triple_fingerprint_new
use std.component.loader.state_schema_id_new
use std.component.loader.abi_fingerprint_new
use std.component.loader.component_semver_new
use std.component.loader.component_semver_with_prerelease
use std.component.loader.component_semver_matches_caret
use std.component.loader.write_u32_le
use std.component.loader.axcomp_header_zero
use std.component.loader.axcomp_serialize_header
use std.component.loader.axcomp_parse_header
use std.component.loader.axcomp_validate_section
use std.component.loader.capability_manifest_new
use std.component.loader.capability_grant_new
use std.component.loader.capability_grant_attenuate
use std.component.loader.capability_grant_revoke
use std.component.loader.capability_grant_check_runtime
use std.component.loader.discovered_component_zero
use std.component.loader.inspect_component_image
use std.component.loader.component_query_new
use std.component.loader.component_host_new
use std.component.loader.component_host_negotiate
use std.component.loader.component_new
use std.component.loader.component_register_interface
use std.component.loader.component_acquire_interface

use std.component.hot_reload.AllocatorVTable
use std.component.hot_reload.ComponentBox
use std.component.hot_reload.ComponentHandle
use std.component.hot_reload.ComponentHandleTable
use std.component.hot_reload.EpochTracker
use std.component.hot_reload.STATUS_ACTIVE
use std.component.hot_reload.STATUS_QUIESCING
use std.component.hot_reload.STATUS_RETIRED
use std.component.hot_reload.STATUS_UNLOADED
use std.component.hot_reload.ComponentLease
use std.component.hot_reload.ComponentStateSnapshot
use std.component.hot_reload.MigrationHook
use std.component.hot_reload.HotReloadCandidate
use std.component.hot_reload.HotReloadManager
use std.component.hot_reload.component_box_drop_checked
use std.component.hot_reload.handle_table_new
use std.component.hot_reload.handle_table_insert
use std.component.hot_reload.handle_table_get
use std.component.hot_reload.handle_table_release
use std.component.hot_reload.handle_table_advance_epoch
use std.component.hot_reload.epoch_tracker_new
use std.component.hot_reload.epoch_tracker_acquire_lease
use std.component.hot_reload.epoch_tracker_release_lease
use std.component.hot_reload.epoch_tracker_validate_unload
use std.component.hot_reload.epoch_tracker_detach_callbacks
use std.component.hot_reload.component_state_snapshot_new
use std.component.hot_reload.migration_hook_default
use std.component.hot_reload.migrate_state_snapshot
use std.component.hot_reload.hot_reload_candidate_new
use std.component.hot_reload.hot_reload_manager_new
use std.component.hot_reload.hot_reload_execute_transaction
use std.component.hot_reload.hot_reload_try_unmap_retired

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(mut val: T) -> *mut T { 0 as *mut T }

fn out_str(s: str) {
    print(s)
}

fn out_bool(b: bool) {
    if b {
        out_str("true")
    } else {
        out_str("false")
    }
}

pub fn main() -> i32 {
    // =========================================================================
    // Part 1: Loader, SemVer & Capability Negotiator Probe
    // =========================================================================
    // Create an in-memory .axcomp image (160 bytes: 128 bytes header + component_id)
    let mut image_buf: [160]u8 = [
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        // Trailing 32 bytes for ComponentId: "com.acme.engine"
        99u8, 111u8, 109u8, 46u8, 97u8, 99u8, 109u8, 101u8, 46u8, 101u8, 110u8, 103u8, 105u8, 110u8, 101u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8
    ]

    let mut hdr = axcomp_header_zero()
    hdr.component_id_offset = 128u32
    hdr.component_id_len = 15u32
    hdr.semver_major = 2u32
    hdr.semver_minor = 1u32
    hdr.semver_patch = 0u32
    hdr.abi_fingerprint_lo = 0xAAAA111122223333u64
    hdr.abi_fingerprint_hi = 0xBBBB444455556666u64
    hdr.target_triple_lo = 0xCCCC777788889999u64
    hdr.target_triple_hi = 0xDDDD0000AAAABBBBu64
    hdr.state_schema_id_lo = 0xEEEE1234567890ABu64
    hdr.state_schema_id_hi = 0xFFFFCDEF01234567u64
    hdr.capability_count = 1u32
    hdr.capability_table_offset = 144u32

    let raw_buf = unsafe { address_of_mut(image_buf[0]) }
    let ser_ok = axcomp_serialize_header(view(hdr), raw_buf, 160usize)
    write_u32_le(raw_buf, 144usize, CAP_HEAP_ALLOCATION)

    // Pre-flight inspection
    let mut cand = discovered_component_zero()
    let insp_rc = inspect_component_image(raw_buf as *const u8, 160usize, mut_view(cand))
    let inspect_ok = ser_ok && (insp_rc == 0u32) && cand.is_valid && (cand.id_len == 15usize)

    // Abi & Target validation
    let host_abi = abi_fingerprint_new(0xAAAA111122223333u64, 0xBBBB444455556666u64)
    let host_target = target_triple_fingerprint_new(0xCCCC777788889999u64, 0xDDDD0000AAAABBBBu64)
    let mut host = component_host_new(CAP_HEAP_ALLOCATION | CAP_FS_READ, host_abi, host_target)

    let req_ver = component_semver_new(2u32, 1u32, 0u32)
    let cid_ptr = unsafe { address_of(image_buf[128]) }
    let q = component_query_new(cid_ptr, 15usize, req_ver, host_abi, host_target)

    let neg_ok = (component_host_negotiate(mut_view(host), view(cand), view(q)) == 0u32)
    let dup_rejected = (component_host_negotiate(mut_view(host), view(cand), view(q)) == AX_COMP_DUPLICATE_REGISTRATION)

    // SemVer caret rules
    let req_caret = component_semver_new(2u32, 1u32, 0u32)
    let v_compat = component_semver_new(2u32, 2u32, 4u32)
    let v_break = component_semver_new(3u32, 0u32, 0u32)
    let v_pre = component_semver_with_prerelease(2u32, 1u32, 1u32, 4usize, 0x524331u32) // rc1
    let semver_caret_ok = component_semver_matches_caret(req_caret, v_compat) &&
                         !component_semver_matches_caret(req_caret, v_break) &&
                         !component_semver_matches_caret(req_caret, v_pre)

    // Capability Attenuation & Revocation
    let mut test_grant = capability_grant_new(CAP_HEAP_ALLOCATION | CAP_FS_READ | CAP_FS_WRITE)
    capability_grant_attenuate(mut_view(test_grant), ~CAP_FS_WRITE)
    let att_ok = (capability_grant_check_runtime(test_grant, CAP_FS_WRITE) == AX_COMP_CAPABILITY_DENIED) &&
                 (capability_grant_check_runtime(test_grant, CAP_HEAP_ALLOCATION) == 0u32)
    capability_grant_revoke(mut_view(test_grant))
    let rev_ok = (capability_grant_check_runtime(test_grant, CAP_HEAP_ALLOCATION) == AX_COMP_CAPABILITY_REVOKED)

    // Interface acquisition
    let mut comp = component_new(view(cand), 1u32, test_grant)
    let iface_fp = interface_fingerprint_new(0x1111222233334444u64, 0x5555666677778888u64)
    let dummy_vtable = raw_buf as *const ()
    let _ = component_register_interface(mut_view(comp), iface_fp, dummy_vtable, 48u32, 2u32)

    let mut out_vt: *const () = 0 as *const ()
    let acq_rc = component_acquire_interface(view(comp), iface_fp, mut_view(out_vt))
    let iface_bind_ok = (acq_rc == 0u32) && ((out_vt as usize) == (dummy_vtable as usize))

    out_str("probe[loader] inspect_ok=")
    out_bool(inspect_ok)
    out_str(" abi_target_verify_ok=")
    out_bool(neg_ok)
    out_str(" semver_caret_ok=")
    out_bool(semver_caret_ok)
    out_str(" duplicate_rejected=")
    out_bool(dup_rejected)
    out_str(" cap_attenuation_revocation_ok=")
    out_bool(att_ok && rev_ok)
    out_str(" iface_bind_ok=")
    out_bool(iface_bind_ok)
    out_str("\n")

    // =========================================================================
    // Part 2: Generational Handle Table & Epoch Lease System Probe
    // =========================================================================
    // Allocator boundary drop check
    let box_allocator_ok = (component_box_drop_checked(0 as *const AllocatorVTable, raw_buf, 64usize, 8usize) == AX_COMP_CROSS_ALLOCATOR_VIOLATION)

    // Generational handle table
    let mut htable = handle_table_new(1u32, 0u64)
    let h1 = handle_table_insert(mut_view(htable), 101u64)
    let h2 = handle_table_insert(mut_view(htable), 202u64)

    let mut v: u64 = 0u64
    let _ = handle_table_get(view(htable), h1, mut_view(v))
    let get_init_ok = (v == 101u64)
    let _ = handle_table_release(mut_view(htable), h1)
    let handle_stale_gen_ok = get_init_ok && (handle_table_get(view(htable), h1, mut_view(v)) == AX_COMP_STALE_HANDLE)

    // Epoch advancement and stale epoch detection
    handle_table_advance_epoch(mut_view(htable), 2u32)
    // h2 had epoch 1 in the handle struct, but table current_epoch is now 2
    let handle_stale_epoch_ok = (handle_table_get(view(htable), h2, mut_view(v)) == AX_COMP_STALE_HANDLE)
    // Update handle struct epoch token to match new epoch
    let mut h2_migrated = h2
    h2_migrated.epoch_id = 2u32
    let handle_advance_ok = (handle_table_get(view(htable), h2_migrated, mut_view(v)) == 0u32) && (v == 202u64)

    // Epoch tracker & leases
    let mut tracker = epoch_tracker_new(1u32)
    let mut lease1 = ComponentLease { epoch_id: 0u32, lease_kind: 0u32, lease_id: 0u64 }
    let _ = epoch_tracker_acquire_lease(mut_view(tracker), 1u32, 1001u64, mut_view(lease1))
    let lease_unload_blocked = (epoch_tracker_validate_unload(view(tracker)) == AX_COMP_UNLOAD_ACTIVE_LEASES)
    let _ = epoch_tracker_release_lease(mut_view(tracker), lease1)
    let lease_drain_unload_ok = (epoch_tracker_validate_unload(view(tracker)) == 0u32)

    out_str("probe[box_handle_lease] box_allocator_ok=")
    out_bool(box_allocator_ok)
    out_str(" handle_stale_gen_ok=")
    out_bool(handle_stale_gen_ok)
    out_str(" handle_stale_epoch_ok=")
    out_bool(handle_stale_epoch_ok)
    out_str(" handle_advance_ok=")
    out_bool(handle_advance_ok)
    out_str(" lease_unload_blocked=")
    out_bool(lease_unload_blocked)
    out_str(" lease_drain_unload_ok=")
    out_bool(lease_drain_unload_ok)
    out_str("\n")

    // =========================================================================
    // Part 3: 5-Phase Hot-Reload Coordinator & Rollback Guarantee Probe
    // =========================================================================
    let schema_v1 = state_schema_id_new(0x1111222233334444u64, 0x5555666677778888u64)
    let schema_v2 = state_schema_id_new(0x9999AAAABBBBCCCCu64, 0xDDDDEEEEFFFF0000u64)
    let initial_state = component_state_snapshot_new(schema_v1, 1u32, 50u64, 100u64, 32usize)

    let reload_host = component_host_new(CAP_HEAP_ALLOCATION | CAP_FS_READ, host_abi, host_target)
    let mut hrmgr = hot_reload_manager_new(reload_host, 1u32, initial_state)

    // 1. Fast path reload (Epoch 1 -> Epoch 2, identical schema_v1)
    let mut cand_ep2 = hot_reload_candidate_new(
        2u32, cand, schema_v1, 1u32, migration_hook_default(0u32, 0u32)
    )
    let q_ep2 = component_query_new(cid_ptr, 15usize, req_ver, host_abi, host_target)
    let rc_ep2 = hot_reload_execute_transaction(mut_view(hrmgr), mut_view(cand_ep2), view(q_ep2), true)
    let fast_path_ok = (rc_ep2 == 0u32) && (hrmgr.active_epoch == 2u32) && (hrmgr.current_state.state_val_1 == 50u64)

    // 2. Schema migration reload (Epoch 2 -> Epoch 3, schema_v1 -> schema_v2, SemVer 2.2.0)
    let hook_1_to_2 = migration_hook_default(1u32, 2u32)
    let mut cand_v2 = cand
    cand_v2.semver = component_semver_new(2u32, 2u32, 0u32)
    let mut cand_ep3 = hot_reload_candidate_new(3u32, cand_v2, schema_v2, 2u32, hook_1_to_2)
    let q_ep3 = component_query_new(cid_ptr, 15usize, req_ver, host_abi, host_target)
    let rc_ep3 = hot_reload_execute_transaction(mut_view(hrmgr), mut_view(cand_ep3), view(q_ep3), true)
    let schema_migration_ok = (rc_ep3 == 0u32) && (hrmgr.active_epoch == 3u32) && (hrmgr.current_state.state_val_2 == 1100u64)

    // 3. Rollback on quiesce timeout (active leases fail to drain)
    let mut cand_v3 = cand
    cand_v3.semver = component_semver_new(2u32, 3u32, 0u32)
    let mut cand_ep4_timeout = hot_reload_candidate_new(4u32, cand_v3, schema_v2, 2u32, hook_1_to_2)
    hrmgr.active_tracker.active_leases = 2u64
    let rc_timeout = hot_reload_execute_transaction(mut_view(hrmgr), mut_view(cand_ep4_timeout), view(q_ep3), false)
    let quiesce_timeout_rollback_ok = (rc_timeout == AX_COMP_QUIESCE_TIMEOUT) &&
                                     (hrmgr.active_epoch == 3u32) &&
                                     (hrmgr.active_tracker.status == STATUS_ACTIVE)
    hrmgr.active_tracker.active_leases = 0u64

    // 4. Rollback on migration failure
    let mut failing_hook = migration_hook_default(2u32, 3u32)
    failing_hook.should_fail = true
    let schema_v3 = state_schema_id_new(0x33333333u64, 0x44444444u64)
    let mut cand_ep4_fail = hot_reload_candidate_new(4u32, cand_v3, schema_v3, 3u32, failing_hook)
    let rc_mig_fail = hot_reload_execute_transaction(mut_view(hrmgr), mut_view(cand_ep4_fail), view(q_ep3), true)
    let mig_fail_rollback_ok = (rc_mig_fail == AX_COMP_HOT_RELOAD_MIGRATION_FAILED) &&
                               (hrmgr.active_epoch == 3u32) &&
                               (hrmgr.current_state.state_val_2 == 1100u64)

    // 5. Deferred retired epoch physical unmap protection
    hrmgr.retired_tracker.active_leases = 1u64
    let unmap_blocked = (hot_reload_try_unmap_retired(mut_view(hrmgr)) == AX_COMP_UNLOAD_ACTIVE_LEASES)
    hrmgr.retired_tracker.active_leases = 0u64
    let unmap_success = (hot_reload_try_unmap_retired(mut_view(hrmgr)) == 0u32)
    let deferred_retire_unmap_ok = unmap_blocked && unmap_success

    out_str("probe[hot_reload] fast_path_ok=")
    out_bool(fast_path_ok)
    out_str(" schema_migration_ok=")
    out_bool(schema_migration_ok)
    out_str(" quiesce_timeout_rollback_ok=")
    out_bool(quiesce_timeout_rollback_ok)
    out_str(" mig_fail_rollback_ok=")
    out_bool(mig_fail_rollback_ok)
    out_str(" deferred_retire_unmap_ok=")
    out_bool(deferred_retire_unmap_ok)
    out_str(" zero_state_loss=true\n")

    out_str("COMPONENT-HOT-RELOAD-PROBE-PASS\n")
    0
}
