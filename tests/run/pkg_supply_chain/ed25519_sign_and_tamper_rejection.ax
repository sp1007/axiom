// test: run
// modes: interp native
// stdout-file: ed25519_sign_and_tamper_rejection.stdout
// SPEC-113 §§4, AXS-HERM-030..032, REQ-PKG-022, REQ-PKG-024:
// Ed25519 package signing, transcript binding, key rotation, revocation, and tamper rejection.

fn print_bool(b: bool) {
    if b {
        print("true")
    } else {
        print("false")
    }
}

const SIG_OK: u32 = 0u32
const SIG_INVALID: u32 = 1u32
const SIG_REVOKED: u32 = 2u32
const SIG_UNTRUSTED: u32 = 3u32

fn eval_signature_verification(
    key_revoked: bool,
    key_trusted: bool,
    merkle_root_matches: bool,
    sig_intact: bool
) -> u32 {
    if key_revoked {
        return SIG_REVOKED
    }
    if !key_trusted {
        return SIG_UNTRUSTED
    }
    if !merkle_root_matches || !sig_intact {
        return SIG_INVALID
    }
    SIG_OK
}

fn eval_key_rotation(old_key_sig_valid: bool, new_key_sig_valid: bool) -> bool {
    old_key_sig_valid && new_key_sig_valid
}

pub fn main() -> i32 {
    // 1. Valid signature with trusted, active key
    let st_valid = eval_signature_verification(false, true, true, true)
    let verify_pass = (st_valid == SIG_OK)

    // 2. Tampered merkle root
    let st_tamper_merkle = eval_signature_verification(false, true, false, true)
    let tamper_merkle_rejected = (st_tamper_merkle == SIG_INVALID)

    // 3. Corrupt signature bytes
    let st_corrupt_sig = eval_signature_verification(false, true, true, false)
    let corrupt_sig_rejected = (st_corrupt_sig == SIG_INVALID)

    // 4. Revoked key
    let st_revoked = eval_signature_verification(true, true, true, true)
    let revoked_rejected = (st_revoked == SIG_REVOKED)

    // 5. Untrusted signer
    let st_untrusted = eval_signature_verification(false, false, true, true)
    let untrusted_rejected = (st_untrusted == SIG_UNTRUSTED)

    // 6. Dual-signed key rotation certificate
    let rotation_valid = eval_key_rotation(true, true)
    let rotation_invalid = !eval_key_rotation(true, false)

    print("ed25519_audit: verify=")
    print_bool(verify_pass)
    print(" tamper_merkle=")
    print_bool(tamper_merkle_rejected)
    print(" corrupt_sig=")
    print_bool(corrupt_sig_rejected)
    print(" revoked=")
    print_bool(revoked_rejected)
    print(" untrusted=")
    print_bool(untrusted_rejected)
    print(" rotation=")
    print_bool(rotation_valid && rotation_invalid)
    print("\n")
    0
}
