// test: run
// modes: interp native
// stdout-file: trust_cmd_cli_dispatch.stdout
// SPEC-113 §§5, AXS-HERM-040..050, REQ-PKG-022, REQ-PKG-024:
// axiomc trust, audit, and provenance CLI subcommand dispatch and deterministic exit codes.

fn print_bool(b: bool) {
    if b {
        print("true")
    } else {
        print("false")
    }
}

const EXIT_OK: i32 = 0i32
const EXIT_USAGE_ERROR: i32 = 1i32
const EXIT_AUDIT_ERROR: i32 = 2i32
const EXIT_SIGNATURE_ERROR: i32 = 3i32
const EXIT_PROVENANCE_ERROR: i32 = 4i32

fn eval_trust_keygen(has_signer: bool) -> i32 {
    if !has_signer {
        return EXIT_USAGE_ERROR
    }
    EXIT_OK
}

fn eval_trust_sign(has_artifact: bool, has_key: bool) -> i32 {
    if !has_artifact || !has_key {
        return EXIT_USAGE_ERROR
    }
    EXIT_OK
}

fn eval_trust_verify(artifact_exists: bool, sig_valid: bool) -> i32 {
    if !artifact_exists {
        return EXIT_USAGE_ERROR
    }
    if !sig_valid {
        return EXIT_SIGNATURE_ERROR
    }
    EXIT_OK
}

fn eval_trust_audit(escalation_found: bool) -> i32 {
    if escalation_found {
        return EXIT_AUDIT_ERROR
    }
    EXIT_OK
}

fn eval_provenance_verify(prov_valid: bool) -> i32 {
    if !prov_valid {
        return EXIT_PROVENANCE_ERROR
    }
    EXIT_OK
}

pub fn main() -> i32 {
    // 1. trust keygen
    let kg_ok = (eval_trust_keygen(true) == EXIT_OK)
    let kg_usage = (eval_trust_keygen(false) == EXIT_USAGE_ERROR)

    // 2. trust sign
    let sign_ok = (eval_trust_sign(true, true) == EXIT_OK)
    let sign_usage = (eval_trust_sign(false, true) == EXIT_USAGE_ERROR)

    // 3. trust verify
    let ver_ok = (eval_trust_verify(true, true) == EXIT_OK)
    let ver_bad_sig = (eval_trust_verify(true, false) == EXIT_SIGNATURE_ERROR)

    // 4. audit
    let audit_ok = (eval_trust_audit(false) == EXIT_OK)
    let audit_fail = (eval_trust_audit(true) == EXIT_AUDIT_ERROR)

    // 5. provenance verify
    let prov_ok = (eval_provenance_verify(true) == EXIT_OK)
    let prov_fail = (eval_provenance_verify(false) == EXIT_PROVENANCE_ERROR)

    let all_ok = kg_ok && kg_usage && sign_ok && sign_usage &&
                 ver_ok && ver_bad_sig && audit_ok && audit_fail &&
                 prov_ok && prov_fail

    print("trust_cli_dispatch: keygen=")
    print_bool(kg_ok && kg_usage)
    print(" sign=")
    print_bool(sign_ok && sign_usage)
    print(" verify=")
    print_bool(ver_ok && ver_bad_sig)
    print(" audit=")
    print_bool(audit_ok && audit_fail)
    print(" provenance=")
    print_bool(prov_ok && prov_fail)
    print(" all=")
    print_bool(all_ok)
    print("\n")
    0
}
