// test: run
// modes: interp native
// stdout-file: deep_transitive_capability_and_expiry_boundary.stdout
// SPEC-113 §§1, 4, AXS-HERM-001..004, AXS-HERM-030..031, REQ-PKG-022, REQ-PKG-024:
// Deep transitive capability closure, asm/process capabilities, and key validity epoch boundaries.

fn print_bool(b: bool) {
    if b {
        print("true")
    } else {
        print("false")
    }
}

const CAP_NONE: u32 = 0u32
const CAP_UNSAFE: u32 = 1u32 << 0
const CAP_FFI: u32 = 1u32 << 1
const CAP_NET: u32 = 1u32 << 2
const CAP_FS: u32 = 1u32 << 3
const CAP_PROCESS: u32 = 1u32 << 4
const CAP_ASM: u32 = 1u32 << 5
const CAP_ALL: u32 = 0x3Fu32

const STATUS_OK: u32 = 0u32
const STATUS_UNDECLARED: u32 = 1u32
const STATUS_ESCALATION: u32 = 2u32
const STATUS_EXPIRED_OR_NOT_YET_VALID: u32 = 3u32

fn audit_node_capabilities(
    declared: u32,
    actual: u32,
    policy_allowed: u32,
    policy_enforce: bool
) -> u32 {
    if (actual & (~declared)) != 0u32 {
        return STATUS_UNDECLARED
    }
    if policy_enforce {
        let required = declared | actual
        if (required & (~policy_allowed)) != 0u32 {
            return STATUS_ESCALATION
        }
    }
    STATUS_OK
}

fn check_key_validity_epoch(
    valid_from: u64,
    expires: u64,
    signed_epoch: u64
) -> u32 {
    if (signed_epoch < valid_from) || (signed_epoch > expires) {
        return STATUS_EXPIRED_OR_NOT_YET_VALID
    }
    STATUS_OK
}

pub fn main() -> i32 {
    // 1. Deep 4-level transitive capability propagation: A -> B -> C -> D
    let cap_d = CAP_ASM | CAP_PROCESS
    let cap_c = CAP_NET | cap_d
    let cap_b = CAP_FS | cap_c
    let cap_a = CAP_NONE | cap_b
    let deep_closure_ok = (cap_a == (CAP_FS | CAP_NET | CAP_PROCESS | CAP_ASM))

    // 2. Transitive escalation detection with asm & process
    let policy_limited = CAP_FS | CAP_NET
    let st_escalation = audit_node_capabilities(cap_d, cap_d, policy_limited, true)
    let deep_escalation_denied = (st_escalation == STATUS_ESCALATION)

    // 3. Permissive policy allows full closure
    let policy_full = CAP_ALL
    let st_full_ok = audit_node_capabilities(cap_d, cap_d, policy_full, true)
    let full_policy_allowed = (st_full_ok == STATUS_OK)

    // 4. Policy enforcement toggle
    let st_disabled = audit_node_capabilities(cap_d, cap_d, policy_limited, false)
    let disabled_enforcement_allowed = (st_disabled == STATUS_OK)

    // 5. Undeclared process capability detection
    let st_undec_process = audit_node_capabilities(CAP_FS, CAP_FS | CAP_PROCESS, policy_full, true)
    let undec_process_rejected = (st_undec_process == STATUS_UNDECLARED)

    // 6. Signing epoch validity boundaries [1000, 2000]
    let epoch_early = (check_key_validity_epoch(1000u64, 2000u64, 999u64) == STATUS_EXPIRED_OR_NOT_YET_VALID)
    let epoch_lower = (check_key_validity_epoch(1000u64, 2000u64, 1000u64) == STATUS_OK)
    let epoch_mid = (check_key_validity_epoch(1000u64, 2000u64, 1500u64) == STATUS_OK)
    let epoch_upper = (check_key_validity_epoch(1000u64, 2000u64, 2000u64) == STATUS_OK)
    let epoch_late = (check_key_validity_epoch(1000u64, 2000u64, 2001u64) == STATUS_EXPIRED_OR_NOT_YET_VALID)
    let epoch_boundaries_ok = epoch_early && epoch_lower && epoch_mid && epoch_upper && epoch_late

    print("deep_transitive_audit: closure=")
    print_bool(deep_closure_ok)
    print(" escalation_denied=")
    print_bool(deep_escalation_denied)
    print(" full_allowed=")
    print_bool(full_policy_allowed)
    print(" policy_disabled=")
    print_bool(disabled_enforcement_allowed)
    print(" undec_process_denied=")
    print_bool(undec_process_rejected)
    print(" epoch_bounds=")
    print_bool(epoch_boundaries_ok)
    print("\n")
    0
}
