// test: run
// modes: interp native
// stdout-file: transitive_capability_escalation_auditor.stdout
// SPEC-113 §§1, AXS-HERM-001..004, REQ-PKG-024:
// Transitive dependency capability-escalation auditor and undeclared capability defenses.

fn print_bool(b: bool) {
    if b {
        print("true")
    } else {
        print("false")
    }
}

const CAP_UNSAFE: u32 = 1u32 << 0
const CAP_FFI: u32 = 1u32 << 1
const CAP_NET: u32 = 1u32 << 2
const CAP_FS: u32 = 1u32 << 3
const CAP_PROCESS: u32 = 1u32 << 4
const CAP_ASM: u32 = 1u32 << 5

const AUDIT_OK: u32 = 0u32
const AUDIT_UNDECLARED: u32 = 1u32
const AUDIT_ESCALATION_DENIED: u32 = 2u32

fn audit_package(
    declared_caps: u32,
    actual_caps: u32,
    policy_allowed_caps: u32
) -> u32 {
    // 1. Undeclared capabilities check
    if (actual_caps & (~declared_caps)) != 0u32 {
        return AUDIT_UNDECLARED
    }
    // 2. Capability policy check
    let required = declared_caps | actual_caps
    if (required & (~policy_allowed_caps)) != 0u32 {
        return AUDIT_ESCALATION_DENIED
    }
    AUDIT_OK
}

fn compute_transitive_closure(direct_caps: u32, child_transitive_caps: u32) -> u32 {
    direct_caps | child_transitive_caps
}

pub fn main() -> i32 {
    // 1. Safe package declared and permitted
    let st_safe = audit_package(CAP_UNSAFE, CAP_UNSAFE, CAP_UNSAFE | CAP_NET)
    let safe_ok = (st_safe == AUDIT_OK)

    // 2. Transitive dependency uses undeclared capability
    let st_undec = audit_package(0u32, CAP_FFI, CAP_UNSAFE)
    let undeclared_rejected = (st_undec == AUDIT_UNDECLARED)

    // 3. Transitive dependency requests ungranted capability (escalation)
    let st_escalate = audit_package(CAP_NET, CAP_NET, CAP_UNSAFE)
    let escalation_rejected = (st_escalate == AUDIT_ESCALATION_DENIED)

    // 4. Transitive capability propagation
    let app_direct = 0u32
    let lib_direct = CAP_NET
    let sublib_direct = CAP_FFI
    let closure = compute_transitive_closure(app_direct, compute_transitive_closure(lib_direct, sublib_direct))
    let propagation_ok = (closure == (CAP_NET | CAP_FFI))

    print("cap_audit: safe=")
    print_bool(safe_ok)
    print(" undeclared_denied=")
    print_bool(undeclared_rejected)
    print(" escalation_denied=")
    print_bool(escalation_rejected)
    print(" transitive_closure=")
    print_bool(propagation_ok)
    print("\n")
    0
}
