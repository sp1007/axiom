// test: run
// modes: interp native
// stdout-file: provenance_attestation_and_ddc.stdout
// SPEC-113 §§4, AXS-HERM-033..035, REQ-PKG-022:
// Build provenance attestation manifest verification and Diverse Double-Compilation (DDC).

fn print_bool(b: bool) {
    if b {
        print("true")
    } else {
        print("false")
    }
}

const PROV_OK: u32 = 0u32
const PROV_DIGEST_MISMATCH: u32 = 1u32
const PROV_SIG_INVALID: u32 = 2u32

fn eval_provenance(
    output_digest_matches: bool,
    sig_valid: bool
) -> u32 {
    if !output_digest_matches {
        return PROV_DIGEST_MISMATCH
    }
    if !sig_valid {
        return PROV_SIG_INVALID
    }
    PROV_OK
}

fn eval_ddc(
    hash_s2a: u64,
    hash_s2b: u64,
    hash_s3: u64
) -> bool {
    (hash_s2a == hash_s2b) && (hash_s2a == hash_s3)
}

pub fn main() -> i32 {
    // 1. Provenance valid
    let st_prov_ok = eval_provenance(true, true)
    let prov_pass = (st_prov_ok == PROV_OK)

    // 2. Output artifact digest mismatch
    let st_mismatch = eval_provenance(false, true)
    let mismatch_denied = (st_mismatch == PROV_DIGEST_MISMATCH)

    // 3. Signature invalid
    let st_bad_sig = eval_provenance(true, false)
    let bad_sig_denied = (st_bad_sig == PROV_SIG_INVALID)

    // 4. Diverse Double-Compilation fixed point
    let ddc_pass = eval_ddc(0xAAAA_BBBB_CCCC_DDDDu64, 0xAAAA_BBBB_CCCC_DDDDu64, 0xAAAA_BBBB_CCCC_DDDDu64)
    let ddc_diverge = !eval_ddc(0xAAAA_BBBB_CCCC_DDDDu64, 0x1111_2222_3333_4444u64, 0xAAAA_BBBB_CCCC_DDDDu64)
    let ddc_all_ok = ddc_pass && ddc_diverge

    print("provenance_ddc: prov_pass=")
    print_bool(prov_pass)
    print(" mismatch_denied=")
    print_bool(mismatch_denied)
    print(" bad_sig_denied=")
    print_bool(bad_sig_denied)
    print(" ddc_ok=")
    print_bool(ddc_all_ok)
    print("\n")
    0
}
