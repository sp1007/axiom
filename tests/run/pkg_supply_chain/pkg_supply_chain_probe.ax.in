// Direct verification probe for `std.pkg.trust` and `compiler.driver.trust_cmd`
// (T864 / E20.4: SPEC-113 §§1, 4, 5, REQ-PKG-022, REQ-PKG-024, INV-HERM-002).

module main

use host_intrinsics.stdio
use host_intrinsics.write

use compiler.kernel.interner.StrView
use compiler.diag.code.diag_code
use compiler.diag.emitter.DiagSink
use compiler.diag.emitter.diag_sink_new
use compiler.diag.emitter.diag_sink_init
use compiler.diag.emitter.diag_sink_free
use compiler.diag.format.DiagBuffer
use compiler.diag.format.diag_buf_new
use compiler.diag.format.diag_buf_init
use compiler.diag.format.diag_buf_free
use compiler.diag.format.diag_buf_as_str_view
