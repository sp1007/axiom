use compiler.driver.query_cmd.inspect_layout_parse_arg
use compiler.driver.query_cmd.inspect_layout_execute
use compiler.driver.query_cmd.query_cli_default
use compiler.driver.query_cmd.query_cmd_parse_arg
use compiler.driver.query_cmd.query_cmd_execute

fn out_str(s: str) {
    let sv = ux2_sv(s)
    let _ = unsafe { write(stdio(1), sv.ptr, sv.len) }
}

fn out_bool(b: bool) {
    if b {
        out_str("true")
    } else {
        out_str("false")
    }
}

fn setup_test_db(db: mut_view<CompilerDB>) {
    query_db_init(mut_view(*db), 1u64)
    let src = ux2_sv("pub fn split_payload(mut buf: [8]u8) -> u8 { buf[0] }\n")
    let sf_id = SourceFileId { v: 1u32 }
    let mod_id = ModuleId { v: 1u32 }
    let def_id = DefId { v: 1u32 }
    let sk = semantic_key_new(ux2_sv("pkg"), ux2_sv("packet_proc"), ITEM_NS_VALUE, 0u32, ux2_sv("split_payload"), ux2_sv_empty())
    let _ = query_db_set_source_file_input(mut_view(*db), sf_id, ux2_sv("packet.ax"), src, DURABILITY_LOW)
    let _ = query_db_set_module_tree_input(mut_view(*db), mod_id, PackageId { v: 1u32 }, ModuleId { v: 0u32 }, ux2_sv("packet_proc"), sf_id, DURABILITY_LOW)
    let _ = query_db_register_def(mut_view(*db), def_id, mod_id, ITEM_KIND_FN, true, 0u32, 1u32, sk)
}

fn test_layout_and_protocol() -> bool {
    let domain_ok = ai_validate_domain_certainty(FACT_DOMAIN_SEMANTIC, CERTAINTY_PROVEN, false) &&
        ai_validate_domain_certainty(FACT_DOMAIN_SEMANTIC, CERTAINTY_INFERRED, false) &&
        !ai_validate_domain_certainty(FACT_DOMAIN_SEMANTIC, CERTAINTY_PROVEN, true) &&
        ai_validate_domain_certainty(FACT_DOMAIN_LAYOUT_ABI, CERTAINTY_PROVEN, false) &&
        ai_validate_domain_certainty(FACT_DOMAIN_OPTIMIZATION, CERTAINTY_POSSIBLE, true)

    let mut db = query_db_empty()
    setup_test_db(mut_view(db))
    let t0 = TypeId { v: 1u32 }

    let mut out_buf = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
    let mut err_buf = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
    diag_buf_init(mut_view(out_buf))
    diag_buf_init(mut_view(err_buf))

    let mut icfg = inspect_layout_cli_default()
    let _ = inspect_layout_parse_arg(mut_view(icfg), ux2_sv("layout"))
    let _ = inspect_layout_parse_arg(mut_view(icfg), ux2_sv("PacketHeader"))
    let _ = inspect_layout_parse_arg(mut_view(icfg), ux2_sv("packet.ax"))
    let rc_h = inspect_layout_execute(mut_view(db), t0, view(icfg), mut_view(out_buf), mut_view(err_buf))
    let sv_h = diag_buf_as_str_view(view(out_buf))
    let human_ok = rc_h == 0i32 &&
        ux2_sv_contains(sv_h, ux2_sv("Type: packet_proc.PacketHeader")) &&
        ux2_sv_contains(sv_h, ux2_sv("size: 16")) &&
        ux2_sv_contains(sv_h, ux2_sv("abi_passing: IndirectCallerCopy"))

    out_buf.len = 0
    err_buf.len = 0
    let mut icfg2 = inspect_layout_cli_default()
    let _ = inspect_layout_parse_arg(mut_view(icfg2), ux2_sv("layout"))
    let _ = inspect_layout_parse_arg(mut_view(icfg2), ux2_sv("PaddedRecord"))
    let _ = inspect_layout_parse_arg(mut_view(icfg2), ux2_sv("packet.ax"))
    let _ = inspect_layout_parse_arg(mut_view(icfg2), ux2_sv("--json"))
    let rc_j = inspect_layout_execute(mut_view(db), t0, view(icfg2), mut_view(out_buf), mut_view(err_buf))
    let sv_j = diag_buf_as_str_view(view(out_buf))
    let json_ok = rc_j == 0i32 &&
        ux2_sv_contains(sv_j, ux2_sv("\"codegen_invoked\":false")) &&
        ux2_sv_contains(sv_j, ux2_sv("\"fact_domain\":\"layout_abi\"")) &&
        ux2_sv_contains(sv_j, ux2_sv("\"padding_bytes\":14")) &&
        ux2_sv_contains(sv_j, ux2_sv("\"padding_before\":7"))

    out_buf.len = 0
    err_buf.len = 0
    let mut icfg3 = inspect_layout_cli_default()
    let _ = inspect_layout_parse_arg(mut_view(icfg3), ux2_sv("layout"))
    let _ = inspect_layout_parse_arg(mut_view(icfg3), ux2_sv("Vec<i32>"))
    let _ = inspect_layout_parse_arg(mut_view(icfg3), ux2_sv("packet.ax"))
    let _ = inspect_layout_parse_arg(mut_view(icfg3), ux2_sv("--target"))
    let _ = inspect_layout_parse_arg(mut_view(icfg3), ux2_sv("wasm32-wasi"))
    let _ = inspect_layout_parse_arg(mut_view(icfg3), ux2_sv("--json"))
    let rc_w = inspect_layout_execute(mut_view(db), t0, view(icfg3), mut_view(out_buf), mut_view(err_buf))
    let sv_w = diag_buf_as_str_view(view(out_buf))
    let wasm_ok = rc_w == 0i32 &&
        ux2_sv_contains(sv_w, ux2_sv("\"target\":\"wasm32-wasi\"")) &&
        ux2_sv_contains(sv_w, ux2_sv("\"size\":12,\"align\":4"))

    out_str("probe[layout_and_protocol] domain_ok=")
    out_bool(domain_ok)
    out_str(" human_ok=")
    out_bool(human_ok)
    out_str(" json_ok=")
    out_bool(json_ok)
    out_str(" wasm_ok=")
    out_bool(wasm_ok)
    out_str("\n")

    diag_buf_free(mut_view(err_buf))
    diag_buf_free(mut_view(out_buf))
    query_db_free(mut_view(db))

    domain_ok && human_ok && json_ok && wasm_ok
}

fn run_query_check(
    db: mut_view<CompilerDB>,
    subcmd: StrView,
    arg0: StrView,
    arg1: StrView,
    expected_substr: StrView
) -> bool {
    let m0 = ModuleId { v: 1u32 }
    let d0 = DefId { v: 1u32 }
    let t0 = TypeId { v: 1u32 }
    let gk = TraitGoalKey { v: 1u32 }
    let mut cfg = query_cli_default()
    let _ = query_cmd_parse_arg(mut_view(cfg), subcmd)
    if arg0.len > 0 {
        let _ = query_cmd_parse_arg(mut_view(cfg), arg0)
    }
    if arg1.len > 0 {
        let _ = query_cmd_parse_arg(mut_view(cfg), arg1)
    }
    let mut out_buf = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
    let mut err_buf = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
    diag_buf_init(mut_view(out_buf))
    diag_buf_init(mut_view(err_buf))
    let rc = query_cmd_execute(
        mut_view(*db), m0, d0, t0, gk, view(cfg),
        0 as *const u8, 0usize,
        mut_view(out_buf), mut_view(err_buf)
    )
    let sv = diag_buf_as_str_view(view(out_buf))
    let ok = rc == 0i32 && ux2_sv_contains(sv, expected_substr) &&
        ux2_sv_contains(sv, ux2_sv("\"codegen_invoked\":false"))
    diag_buf_free(mut_view(err_buf))
    diag_buf_free(mut_view(out_buf))
    ok
}

fn test_queries_and_gates() -> bool {
    let mut db = query_db_empty()
    setup_test_db(mut_view(db))
    let m0 = ModuleId { v: 1u32 }
    let d0 = DefId { v: 1u32 }
    let empty = ux2_sv("")

    let queries_ok =
        run_query_check(mut_view(db), ux2_sv("symbol"), ux2_sv("packet_proc.split_payload"), empty, ux2_sv("\"fact_kind\":\"symbol\"")) &&
        run_query_check(mut_view(db), ux2_sv("type"), ux2_sv("PacketHeader"), empty, ux2_sv("\"copy\":true")) &&
        run_query_check(mut_view(db), ux2_sv("ownership"), ux2_sv("split_payload"), empty, ux2_sv("\"fact_kind\":\"ownership_lifeline\"")) &&
        run_query_check(mut_view(db), ux2_sv("capabilities"), ux2_sv("split_payload"), empty, ux2_sv("\"disjoint_status\":\"Disjoint\"")) &&
        run_query_check(mut_view(db), ux2_sv("trait"), ux2_sv("Metric"), ux2_sv("Pair"), ux2_sv("\"status\":\"Implemented\"")) &&
        run_query_check(mut_view(db), ux2_sv("trait"), ux2_sv("Send"), ux2_sv("WorkerState"), ux2_sv("\"status\":\"NotImplemented\"")) &&
        run_query_check(mut_view(db), ux2_sv("container"), ux2_sv("Vec"), empty, ux2_sv("\"storage_kind\":\"HeapContiguous\"")) &&
        run_query_check(mut_view(db), ux2_sv("container"), ux2_sv("HashMap"), empty, ux2_sv("\"storage_kind\":\"HeapTable\"")) &&
        run_query_check(mut_view(db), ux2_sv("effects"), ux2_sv("std.collections.Vec.push"), empty, ux2_sv("\"allocates\":\"MayAllocate\"")) &&
        run_query_check(mut_view(db), ux2_sv("effects"), ux2_sv("std.fs.read_to_string"), empty, ux2_sv("\"FsCap\"")) &&
        run_query_check(mut_view(db), ux2_sv("effects"), ux2_sv("std.mem.volatile_load"), empty, ux2_sv("\"unsafe_required\":true")) &&
        run_query_check(mut_view(db), ux2_sv("unsafe-map"), ux2_sv("packet.ax"), empty, ux2_sv("\"fact_kind\":\"unsafe_boundary\"")) &&
        run_query_check(mut_view(db), ux2_sv("deps"), empty, empty, ux2_sv("\"fact_kind\":\"module_deps\"")) &&
        run_query_check(mut_view(db), ux2_sv("context"), ux2_sv("packet_proc.split_payload"), empty, ux2_sv("\"fact_kind\":\"ai_context_bundle\"")) &&
        run_query_check(mut_view(db), ux2_sv("facts"), ux2_sv("packet.ax"), empty, ux2_sv("\"fact_kind\":\"capability_lifeline\"")) &&
        run_query_check(mut_view(db), ux2_sv("opt-remarks"), ux2_sv("hot_loop"), empty, ux2_sv("\"fact_domain\":\"optimization\""))

    let mut axmeta_buf = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
    diag_buf_init(mut_view(axmeta_buf))
    ai_export_axmeta_container_effects(mut_view(axmeta_buf))
    let meta_sum = ai_inspect_axmeta_container_effects(axmeta_buf.ptr as *const u8, axmeta_buf.len)
    diag_buf_free(mut_view(axmeta_buf))
    let axmeta_ok = meta_sum.valid_magic && meta_sum.has_effects_sec && meta_sum.has_ai_index_sec &&
        meta_sum.container_count == META_CONTAINER_COUNT &&
        meta_sum.api_effect_count == META_API_EFFECT_COUNT

    let bad_reloc = ux2_sv("fn bad() { let elem = view(v[0]); v.push(4); let x = *elem; }")
    let res_reloc = ai_verify_patch_candidate(mut_view(db), m0, d0, bad_reloc)
    let bad_bypass = ux2_sv("@trust_ai fn hack() { volatile_load(ptr) }")
    let res_bypass = ai_verify_patch_candidate(mut_view(db), m0, d0, bad_bypass)
    let bad_uam = ux2_sv("fn uam() { consume(buf); read_view(view(buf)); }")
    let res_uam = ai_verify_patch_candidate(mut_view(db), m0, d0, bad_uam)
    let clean_patch = ux2_sv("pub fn add_pair(a: i32, b: i32) -> i32 { let sum = a + b\n sum }")
    let res_ok = ai_verify_patch_candidate(mut_view(db), m0, d0, clean_patch)

    let patch_gate_ok =
        (!res_reloc.accepted && res_reloc.primary_code.v == AX_CAP_CONTAINER_RELOC && res_reloc.diag.causal_chain.step_count == 4u32) &&
        (!res_bypass.accepted && res_bypass.bypass_attempted && res_bypass.primary_code.v == AX_UNSAFE_REQUIRED) &&
        (!res_uam.accepted && res_uam.primary_code.v == AX_MOVE_USE_AFTER_MOVE) &&
        (res_ok.accepted && !res_ok.codegen_invoked && !res_ok.disk_modified && res_ok.error_count == 0u32)

    let mut clean_pe = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
    diag_buf_init(mut_view(clean_pe))
    ai_build_mock_pe_image(false, mut_view(clean_pe))
    let rep_clean = ai_verify_production_binary(clean_pe.ptr as *const u8, clean_pe.len)
    diag_buf_free(mut_view(clean_pe))

    let mut dirty_pe = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
    diag_buf_init(mut_view(dirty_pe))
    ai_build_mock_pe_image(true, mut_view(dirty_pe))
    let rep_dirty = ai_verify_production_binary(dirty_pe.ptr as *const u8, dirty_pe.len)
    diag_buf_free(mut_view(dirty_pe))

    let pe_strip_ok =
        (rep_clean.is_valid_pe && rep_clean.is_production_clean && rep_clean.leaked_axmeta_count == 0u32 && !rep_clean.requires_runtime_axmeta) &&
        (rep_dirty.is_valid_pe && !rep_dirty.is_production_clean && rep_dirty.leaked_axmeta_count == 1u32 && rep_dirty.has_leaked_magic && rep_dirty.requires_runtime_axmeta)

    out_str("probe[queries_and_gates] queries_ok=")
    out_bool(queries_ok)
    out_str(" axmeta_ok=")
    out_bool(axmeta_ok)
    out_str(" patch_gate_ok=")
    out_bool(patch_gate_ok)
    out_str(" pe_strip_ok=")
    out_bool(pe_strip_ok)
    out_str("\n")

    query_db_free(mut_view(db))
    queries_ok && axmeta_ok && patch_gate_ok && pe_strip_ok
}

pub fn main() -> i32 {
    let ok1 = test_layout_and_protocol()
    let ok2 = test_queries_and_gates()
    if !ok1 || !ok2 {
        return 1
    }
    out_str("AI-QUERY-PROBE-OK\n")
    0
}
