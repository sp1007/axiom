// Direct verification probe for `std.meta_effects`, `compiler.ai_query`, and
// `compiler.driver.query_cmd` (T814 / E19.4: SPEC-103, SPEC-24,
// REQ-TOOL-004, REQ-TOOL-180..182, REQ-TOOL-185..187, REQ-TOOL-190, INV-DIAG-010).

module main

use host_intrinsics.stdio
use host_intrinsics.write

use compiler.kernel.interner.StrView
use compiler.diag.code.AX_MOVE_USE_AFTER_MOVE
use compiler.diag.code.AX_CAP_CONFLICT_MUT
use compiler.diag.code.AX_UNSAFE_REQUIRED
use compiler.diag.format.DiagBuffer
use compiler.diag.format.diag_buf_init
use compiler.diag.format.diag_buf_free
use compiler.diag.format.diag_buf_as_str_view
use compiler.diag.ux2.AX_CAP_CONTAINER_RELOC
use compiler.diag.ux2.ux2_sv
use compiler.diag.ux2.ux2_sv_empty
use compiler.diag.ux2.ux2_sv_eq
use compiler.diag.ux2.ux2_sv_contains
use compiler.query.db.CompilerDB
use compiler.query.db.SourceFileId
use compiler.query.db.ModuleId
use compiler.query.db.DefId
use compiler.query.db.TypeId
use compiler.query.db.PackageId
use compiler.query.db.TraitGoalKey
use compiler.query.db.ITEM_NS_VALUE
use compiler.query.db.ITEM_KIND_FN
use compiler.query.db.DURABILITY_LOW
use compiler.query.db.semantic_key_new
use compiler.query.db.query_db_empty
use compiler.query.db.query_db_init
use compiler.query.db.query_db_free
use compiler.query.db.query_db_set_source_file_input
use compiler.query.db.query_db_set_module_tree_input
use compiler.query.db.query_db_register_def

use std.meta_effects.META_CONTAINER_COUNT
use std.meta_effects.META_API_EFFECT_COUNT

use compiler.ai_query.FACT_DOMAIN_SEMANTIC
use compiler.ai_query.FACT_DOMAIN_LAYOUT_ABI
use compiler.ai_query.FACT_DOMAIN_OPTIMIZATION
use compiler.ai_query.CERTAINTY_PROVEN
use compiler.ai_query.CERTAINTY_INFERRED
use compiler.ai_query.CERTAINTY_OBSERVED
use compiler.ai_query.CERTAINTY_POSSIBLE
use compiler.ai_query.ai_validate_domain_certainty
use compiler.ai_query.ai_export_axmeta_container_effects
use compiler.ai_query.ai_inspect_axmeta_container_effects
use compiler.ai_query.ai_verify_patch_candidate
use compiler.ai_query.ai_build_mock_pe_image
use compiler.ai_query.ai_verify_production_binary

