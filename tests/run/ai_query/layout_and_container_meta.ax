// test: run
// modes: interp native
// stdout-file: layout_and_container_meta.stdout
// SPEC-103 §§5.1..5.2 (REQ-TOOL-004, REQ-TOOL-181):
// Verifies type layout/ABI inspector (`PacketHeader`, `PaddedRecord`, `Vec<i32>` across targets)
// and container semantic contract queries (`Vec`, `HashMap`, `Slice`).

@derive(Copy)
struct LayoutSummary {
    size: u64,
    align: u64,
    padding_bytes: u64,
    cache_lines: u32,
    reorder_savings: u64,
}

@derive(Copy)
struct ContainerSummary {
    storage_id: u8,
    contiguous: bool,
    relocatable: bool,
    address_stable: bool,
    random_access: bool,
    invalidation_rules: u32,
}

fn compute_layout(type_id: u32, ptr_bytes: u64) -> LayoutSummary {
    if type_id == 1u32 {
        return LayoutSummary {
            size: 16u64,
            align: 8u64,
            padding_bytes: 3u64,
            cache_lines: 1u32,
            reorder_savings: 0u64,
        }
    }
    if type_id == 2u32 {
        return LayoutSummary {
            size: 24u64,
            align: 8u64,
            padding_bytes: 10u64,
            cache_lines: 1u32,
            reorder_savings: 8u64,
        }
    }
    LayoutSummary {
        size: ptr_bytes * 3u64,
        align: ptr_bytes,
        padding_bytes: 0u64,
        cache_lines: 1u32,
        reorder_savings: 0u64,
    }
}

fn query_container(kind: u32) -> ContainerSummary {
    if kind == 0u32 {
        return ContainerSummary {
            storage_id: 1u8,
            contiguous: true,
            relocatable: true,
            address_stable: false,
            random_access: true,
            invalidation_rules: 2u32,
        }
    }
    if kind == 1u32 {
        return ContainerSummary {
            storage_id: 2u8,
            contiguous: false,
            relocatable: true,
            address_stable: false,
            random_access: false,
            invalidation_rules: 2u32,
        }
    }
    ContainerSummary {
        storage_id: 4u8,
        contiguous: true,
        relocatable: false,
        address_stable: true,
        random_access: true,
        invalidation_rules: 1u32,
    }
}

pub fn main() -> i32 {
    let hdr = compute_layout(1u32, 8u64)
    if hdr.size != 16u64 || hdr.align != 8u64 || hdr.padding_bytes != 3u64 || hdr.cache_lines != 1u32 {
        return 1
    }

    let pad_rec = compute_layout(2u32, 8u64)
    if pad_rec.size != 24u64 || pad_rec.reorder_savings != 8u64 {
        return 2
    }

    let vec_x64 = compute_layout(3u32, 8u64)
    let vec_wasm = compute_layout(3u32, 4u64)
    if vec_x64.size != 24u64 || vec_wasm.size != 12u64 || vec_wasm.align != 4u64 {
        return 3
    }

    let c_vec = query_container(0u32)
    let c_map = query_container(1u32)
    let c_slice = query_container(2u32)
    if !c_vec.contiguous || !c_vec.relocatable || c_vec.address_stable || c_vec.invalidation_rules != 2u32 {
        return 4
    }
    if c_map.storage_id != 2u8 || c_map.contiguous || !c_map.relocatable {
        return 5
    }
    if !c_slice.contiguous || c_slice.relocatable || !c_slice.address_stable {
        return 6
    }

    print("LAYOUT-AND-CONTAINER-META-OK\n")
    0
}
