// test: run
// modes: interp native
// stdout-file: ai_patch_gate_and_axmeta_strip.stdout
// SPEC-103 §§6.1..6.2 (REQ-TOOL-182, REQ-TOOL-186, REQ-TOOL-187):
// Verifies transactional AI patch verification gate (`axiomc query verify-patch`)
// and production binary `.axmeta` / `.axdb` separation.

@derive(Copy)
struct PatchGateVerdict {
    accepted: bool,
    codegen_invoked: bool,
    disk_modified: bool,
    bypass_rejected: bool,
    error_code: u32,
}

fn verify_candidate(kind: u32) -> PatchGateVerdict {
    if kind == 1u32 {
        return PatchGateVerdict {
            accepted: false,
            codegen_invoked: false,
            disk_modified: false,
            bypass_rejected: false,
            error_code: 3104u32,
        }
    }
    if kind == 2u32 {
        return PatchGateVerdict {
            accepted: false,
            codegen_invoked: false,
            disk_modified: false,
            bypass_rejected: true,
            error_code: 5001u32,
        }
    }
    PatchGateVerdict {
        accepted: true,
        codegen_invoked: false,
        disk_modified: false,
        bypass_rejected: false,
        error_code: 0u32,
    }
}

fn verify_pe_sections(has_axmeta_sec: bool, has_axdb_sec: bool) -> bool {
    !has_axmeta_sec && !has_axdb_sec
}

pub fn main() -> i32 {
    let v_reloc = verify_candidate(1u32)
    if v_reloc.accepted || v_reloc.codegen_invoked || v_reloc.disk_modified || v_reloc.error_code != 3104u32 {
        return 1
    }

    let v_bypass = verify_candidate(2u32)
    if v_bypass.accepted || !v_bypass.bypass_rejected || v_bypass.error_code != 5001u32 {
        return 2
    }

    let v_clean = verify_candidate(3u32)
    if !v_clean.accepted || v_clean.codegen_invoked || v_clean.disk_modified || v_clean.error_code != 0u32 {
        return 3
    }

    if !verify_pe_sections(false, false) {
        return 4
    }
    if verify_pe_sections(true, false) || verify_pe_sections(false, true) {
        return 5
    }

    print("AI-PATCH-GATE-AND-AXMETA-STRIP-OK\n")
    0
}
