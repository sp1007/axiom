// test: run
// modes: interp native
// stdout-file: semantic_fact_graph_and_effects.stdout
// SPEC-103 §§4.2, 5.3..5.5 (REQ-TOOL-180, REQ-TOOL-185, REQ-TOOL-190):
// Verifies AI semantic fact graph queries (FactDomain vs FactCertainty separation,
// ownership/capability lifelines, trait proof trees, and `std.meta_effects` API effect summaries).

fn check_domain_certainty(domain: u8, certainty: u8) -> bool {
    if domain == 1u8 || domain == 2u8 {
        return certainty == 1u8 || certainty == 2u8
    }
    true
}

@derive(Copy)
struct EffectFact {
    alloc_id: u8,
    block_id: u8,
    sync_id: u8,
    invalidates_views: bool,
    os_io: bool,
    unsafe_required: bool,
    cap_count: u8,
}

fn query_std_effect(api_id: u32) -> EffectFact {
    if api_id == 0u32 {
        return EffectFact {
            alloc_id: 1u8,
            block_id: 0u8,
            sync_id: 0u8,
            invalidates_views: true,
            os_io: false,
            unsafe_required: false,
            cap_count: 0u8,
        }
    }
    if api_id == 1u32 {
        return EffectFact {
            alloc_id: 1u8,
            block_id: 1u8,
            sync_id: 0u8,
            invalidates_views: false,
            os_io: true,
            unsafe_required: false,
            cap_count: 1u8,
        }
    }
    if api_id == 2u32 {
        return EffectFact {
            alloc_id: 0u8,
            block_id: 1u8,
            sync_id: 3u8,
            invalidates_views: false,
            os_io: false,
            unsafe_required: false,
            cap_count: 0u8,
        }
    }
    EffectFact {
        alloc_id: 0u8,
        block_id: 0u8,
        sync_id: 0u8,
        invalidates_views: false,
        os_io: false,
        unsafe_required: true,
        cap_count: 0u8,
    }
}

pub fn main() -> i32 {
    if !check_domain_certainty(1u8, 1u8) || !check_domain_certainty(1u8, 2u8) {
        return 1
    }
    if check_domain_certainty(1u8, 4u8) || check_domain_certainty(2u8, 3u8) {
        return 2
    }
    if !check_domain_certainty(3u8, 4u8) {
        return 3
    }

    let e_push = query_std_effect(0u32)
    let e_fs = query_std_effect(1u32)
    let e_lock = query_std_effect(2u32)
    let e_vol = query_std_effect(3u32)

    if e_push.alloc_id != 1u8 || !e_push.invalidates_views || e_push.os_io {
        return 4
    }
    if !e_fs.os_io || e_fs.cap_count != 1u8 || e_fs.block_id != 1u8 {
        return 5
    }
    if e_lock.sync_id != 3u8 || e_lock.block_id != 1u8 || e_lock.alloc_id != 0u8 {
        return 6
    }
    if !e_vol.unsafe_required || e_vol.alloc_id != 0u8 {
        return 7
    }

    print("SEMANTIC-FACT-GRAPH-AND-EFFECTS-OK\n")
    0
}
