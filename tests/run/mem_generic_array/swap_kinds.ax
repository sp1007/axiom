// test: run
// exit: 0
// stdout: u8 11 15 1 5\nu32 7 9 1 3\nu64 5 7 100000000000 3\nstruct 5 2 8 3\nnested 10 60 1 6\ntuple 9 7 1 3\nwrap 2 6 1 3\nsizes 5 12 24 32 12 24 16\n
// T498g: the body of std/core/mem.ax `swap` (copied: std module loading is T423h) with `T` an array of
// u8 / u32 / u64 / a struct, a nested array, a tuple holding an array and a struct holding an array.
// The inferred `T` of every `ptr_copy_nonoverlapping(.., 1)` must be the substituted `T`, so the whole
// value (size_of<T>() bytes) is exchanged, not its first element.

@intrinsic pub unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic pub unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic pub fn size_of<T>() -> usize { 0 }

unsafe fn swap2<T>(a: mut_view<T>, b: mut_view<T>) {
    let pa = address_of_mut(*a)
    let pb = address_of_mut(*b)
    let mut tmp: [1]T = [*a]
    let ptmp = address_of_mut(tmp[0])
    ptr_copy_nonoverlapping(pa as *const T, ptmp, 1)
    ptr_copy_nonoverlapping(pb as *const T, pa, 1)
    ptr_copy_nonoverlapping(ptmp as *const T, pb, 1)
}

struct Pt { x: u32, y: u64 }

struct Wrap { tag: u8, data: [3]u32 }

fn p4(tag: Str, a: u64, b: u64, c: u64, d: u64) {
    print(tag)
    print(" ")
    print_int(a as i64)
    print(" ")
    print_int(b as i64)
    print(" ")
    print_int(c as i64)
    print(" ")
    print_int(d as i64)
    print("\n")
}

fn main() -> i32 {
    let mut a8: [5]u8 = [1u8, 2u8, 3u8, 4u8, 5u8]
    let mut b8: [5]u8 = [11u8, 12u8, 13u8, 14u8, 15u8]
    unsafe { swap2(mut_view(a8), mut_view(b8)) }
    p4("u8", a8[0] as u64, a8[4] as u64, b8[0] as u64, b8[4] as u64)

    let mut a32: [3]u32 = [1u32, 2u32, 3u32]
    let mut b32: [3]u32 = [7u32, 8u32, 9u32]
    unsafe { swap2(mut_view(a32), mut_view(b32)) }
    p4("u32", a32[0] as u64, a32[2] as u64, b32[0] as u64, b32[2] as u64)

    let mut a64: [3]u64 = [100000000000u64, 2u64, 3u64]
    let mut b64: [3]u64 = [5u64, 6u64, 7u64]
    unsafe { swap2(mut_view(a64), mut_view(b64)) }
    p4("u64", a64[0], a64[2], b64[0], b64[2])

    let mut ap: [2]Pt = [Pt { x: 1u32, y: 2u64 }, Pt { x: 3u32, y: 4u64 }]
    let mut bp: [2]Pt = [Pt { x: 5u32, y: 6u64 }, Pt { x: 7u32, y: 8u64 }]
    unsafe { swap2(mut_view(ap), mut_view(bp)) }
    p4("struct", ap[0].x as u64, bp[0].y, ap[1].y, bp[1].x as u64)

    let mut an: [2][3]u16 = [[1u16, 2u16, 3u16], [4u16, 5u16, 6u16]]
    let mut bn: [2][3]u16 = [[10u16, 20u16, 30u16], [40u16, 50u16, 60u16]]
    unsafe { swap2(mut_view(an), mut_view(bn)) }
    p4("nested", an[0][0] as u64, an[1][2] as u64, bn[0][0] as u64, bn[1][2] as u64)

    let mut at: (u8, [2]u64) = (1u8, [2u64, 3u64])
    let mut bt: (u8, [2]u64) = (9u8, [8u64, 7u64])
    unsafe { swap2(mut_view(at), mut_view(bt)) }
    p4("tuple", at.0 as u64, at.1[1], bt.0 as u64, bt.1[1])

    let mut aw = Wrap { tag: 1u8, data: [1u32, 2u32, 3u32] }
    let mut bw = Wrap { tag: 2u8, data: [4u32, 5u32, 6u32] }
    unsafe { swap2(mut_view(aw), mut_view(bw)) }
    p4("wrap", aw.tag as u64, aw.data[2] as u64, bw.tag as u64, bw.data[2] as u64)

    print("sizes ")
    print_int(size_of<[5]u8>() as i64)
    print(" ")
    print_int(size_of<[3]u32>() as i64)
    print(" ")
    print_int(size_of<[3]u64>() as i64)
    print(" ")
    print_int(size_of<[2]Pt>() as i64)
    print(" ")
    print_int(size_of<[2][3]u16>() as i64)
    print(" ")
    print_int(size_of<(u8, [2]u64)>() as i64)
    print(" ")
    print_int(size_of<Wrap>() as i64)
    print("\n")
    0
}
