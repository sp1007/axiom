// test: run
// exit: 0
// stdout: sz 24 8 true\nnest 7 8 9 1 2 3\nwrap 9 8 7 3\nadd 30 sub 10\nnull true false 40\ndrops D 1\ntup 5 6 100 200\ndead 1 2 3 4\nDDD
// T498g QA (adversarial): inferred `T` for every generic raw-memory intrinsic, through a generic wrapper
// that is itself instantiated with several `T`, at non-trivial sizes; nothing may fall back to 1 byte.

@intrinsic pub unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic pub unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic pub unsafe fn ptr_copy<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic pub unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic pub unsafe fn ptr_write_bytes<T>(dst: *mut T, val: u8, count: usize) {}
@intrinsic pub unsafe fn drop_in_place<T>(p: *mut T) {}
@intrinsic unsafe fn ptr_add<T>(p: *const T, count: usize) -> *const T { p }
@intrinsic unsafe fn ptr_sub<T>(p: *const T, count: usize) -> *const T { p }
@intrinsic pub fn size_of<T>() -> usize { 0 }
@intrinsic pub fn align_of<T>() -> usize { 0 }
@intrinsic pub fn needs_drop<T>() -> bool { false }
@intrinsic fn null<T>() -> *const T { 0 as *const T }
@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }
@intrinsic fn is_null<T>(p: *const T) -> bool { false }

struct Tr { a: u32 }
impl Drop for Tr { fn drop(self: mut_view<Tr>) { print("D") } }
struct Pt { x: u64, y: u64, z: u64 }

unsafe fn swap<T>(a: mut_view<T>, b: mut_view<T>) {
    let pa = address_of_mut(*a)
    let pb = address_of_mut(*b)
    let mut tmp: [1]T = [*a]
    let ptmp = address_of_mut(tmp[0])
    ptr_copy_nonoverlapping(pa as *const T, ptmp, 1)
    ptr_copy_nonoverlapping(pb as *const T, pa, 1)
    ptr_copy_nonoverlapping(ptmp as *const T, pb, 1)
}

// a generic wrapper that forwards into another generic: U -> T
unsafe fn swap_twice<U>(a: mut_view<U>, b: mut_view<U>) {
    swap(mut_view(*a), mut_view(*b))
    swap(mut_view(*a), mut_view(*b))
    swap(mut_view(*a), mut_view(*b))
}

unsafe fn dp<T>(p: *mut T) { drop_in_place(p) }

fn sizes<T>() -> usize { size_of<T>() }

fn main() -> i32 {
    // size_of / align_of / needs_drop of the instantiated T
    print("sz ")
    print_int(sizes<Pt>() as i64)
    print(" ")
    print_int(align_of<Pt>() as i64)
    print(" ")
    print(if needs_drop<Tr>() { "true" } else { "false" })
    print("\n")

    // nested instantiation: swap_twice<[3]u64> -> swap<[3]u64> (odd number of swaps == one swap)
    let mut a: [3]u64 = [1u64, 2u64, 3u64]
    let mut b: [3]u64 = [7u64, 8u64, 9u64]
    unsafe { swap_twice(mut_view(a), mut_view(b)) }
    print("nest ")
    print_int(a[0] as i64); print(" "); print_int(a[1] as i64); print(" "); print_int(a[2] as i64); print(" ")
    print_int(b[0] as i64); print(" "); print_int(b[1] as i64); print(" "); print_int(b[2] as i64)
    print("\n")

    // struct with three u64: whole 24 bytes must move
    let mut s = Pt { x: 9u64, y: 8u64, z: 7u64 }
    let mut t = Pt { x: 1u64, y: 2u64, z: 3u64 }
    unsafe { swap(mut_view(s), mut_view(t)) }
    print("wrap ")
    print_int(t.x as i64); print(" "); print_int(t.y as i64); print(" "); print_int(t.z as i64); print(" ")
    print_int(s.z as i64)
    print("\n")

    // ptr_add / ptr_sub on a *const u64 with an inferred T in a non-generic function
    let v: [4]u64 = [10u64, 20u64, 30u64, 40u64]
    let base = unsafe { address_of(v[0]) }
    let p3 = unsafe { ptr_add(base, 2) }
    let p1 = unsafe { ptr_sub(ptr_add(base, 3), 2) }
    print("add ")
    print_int(unsafe { *p3 } as i64)
    print(" sub ")
    print_int(unsafe { *p1 } as i64 / 2)
    print("\n")

    // null / is_null with T inferred from the annotation (u64: 8-byte pointee)
    let np: *const u64 = null()
    let nm: *mut Pt = null_mut()
    let live = unsafe { address_of(v[1]) }
    print("null ")
    print(if is_null(np) { "true" } else { "false" })
    print(" ")
    print(if is_null(live) { "true" } else if is_null(nm as *const Pt) { "false" } else { "x" })
    print(" ")
    print_int(unsafe { *ptr_add(live, 2) } as i64)
    print("\n")

    // drop_in_place with inferred T: runs Tr's drop once per call
    let mut arr: [2]Tr = [Tr { a: 1u32 }, Tr { a: 2u32 }]
    let mut one = Tr { a: 3u32 }
    print("drops ")
    unsafe { dp(address_of_mut(one)) }
    print(" ")
    print("1")
    print("\n")
    // (the scope-end drops of `arr` x2 and `one` print three more D; `one` is intentionally dropped twice,
    //  Tr::drop only prints)

    // tuple T = (u32, [2]u64): copy 1 element of a tuple array, count 2 -> two tuples
    let src: [2](u32, [2]u64) = [(5u32, [6u64, 100u64]), (7u32, [8u64, 200u64])]
    let mut dst: [2](u32, [2]u64) = [(0u32, [0u64, 0u64]), (0u32, [0u64, 0u64])]
    unsafe { ptr_copy_nonoverlapping(address_of(src[0]), address_of_mut(dst[0]), 2) }
    print("tup ")
    print_int(dst[0].0 as i64); print(" "); print_int(dst[0].1[0] as i64); print(" ")
    print_int(dst[1].1[1] as i64 - 100); print(" "); print_int(dst[1].1[1] as i64)
    print("\n")

    // ptr_write_bytes with inferred T = u32, count 2: clears 8 bytes, not 2
    let mut z: [4]u32 = [1u32, 2u32, 3u32, 4u32]
    unsafe { ptr_write_bytes(address_of_mut(z[0]), 0u8, 2) }
    print("dead ")
    print_int(z[0] as i64 + 1); print(" "); print_int(z[1] as i64 + 2); print(" ")
    print_int(z[2] as i64); print(" "); print_int(z[3] as i64)
    print("\n")
    0
}
