// test: run
// exit: 0
// stdout: 16\n10 20 30 40\n1 2 3 4\n
// T498g: the body of std/core/mem.ax `swap` instantiated with an array `T`. Every
// `ptr_copy_nonoverlapping<[4]u32>(.., 1)` must move size_of<[4]u32>() = 16 bytes, not one element.

@intrinsic pub unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic pub unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic pub fn size_of<T>() -> usize { 0 }

unsafe fn swap2<T>(a: mut_view<T>, b: mut_view<T>) {
    let pa = address_of_mut(*a)
    let pb = address_of_mut(*b)
    let mut tmp: [1]T = [*a]
    let ptmp = address_of_mut(tmp[0])
    ptr_copy_nonoverlapping(pa as *const T, ptmp, 1)
    ptr_copy_nonoverlapping(pb as *const T, pa, 1)
    ptr_copy_nonoverlapping(ptmp as *const T, pb, 1)
}

fn show(a: view<[4]u32>) {
    print_int((*a)[0] as i64)
    print(" ")
    print_int((*a)[1] as i64)
    print(" ")
    print_int((*a)[2] as i64)
    print(" ")
    print_int((*a)[3] as i64)
    print("\n")
}

fn main() -> i32 {
    let mut p: [4]u32 = [1u32, 2u32, 3u32, 4u32]
    let mut q: [4]u32 = [10u32, 20u32, 30u32, 40u32]
    print_int(size_of<[4]u32>() as i64)
    print("\n")
    unsafe { swap2(mut_view(p), mut_view(q)) }
    show(view(p))
    show(view(q))
    0
}
