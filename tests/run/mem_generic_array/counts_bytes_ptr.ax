// test: run
// exit: 0
// stdout: n0 0 0 0 0\nn1 1 2 0 0\nn3 2 5 9 0\ncopy 1 2 1 2 3 4 5 6\nwb 0 0 0 4 5 6\nadd 8 5\nsub 2 8\nreplace 1 4 9 12\nplain 3 30000000000\n
// T498g: generic raw-memory intrinsics with an inferred array `T` (the generic bodies are local copies;
// std module loading is T423h). `count` is in units of size_of<T>(), never of the array element:
//  - ptr_copy_nonoverlapping count 0 / 1 / 3 over an array of arrays ([4][2]u32, T = [2]u32);
//  - overlapping ptr_copy of 3 rows one row forward;
//  - ptr_write_bytes over one element of [2][3]u16 (T = [3]u16) leaves the other row intact;
//  - ptr_add / ptr_sub stepping by whole rows of [3][3]u32;
//  - `replace` on an array value;
//  - a non-generic call with an inferred u64 `T` (8 bytes per element, not 4).

@intrinsic pub unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic pub unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic pub unsafe fn ptr_copy<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic pub unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic pub unsafe fn ptr_write_bytes<T>(dst: *mut T, val: u8, count: usize) {}
@intrinsic unsafe fn ptr_add<T>(p: *const T, count: usize) -> *const T { p }
@intrinsic unsafe fn ptr_sub<T>(p: *const T, count: usize) -> *const T { p }

unsafe fn cp<T>(src: *const T, dst: *mut T, n: usize) {
    ptr_copy_nonoverlapping(src, dst, n)
}

unsafe fn mv<T>(src: *const T, dst: *mut T, n: usize) {
    ptr_copy(src, dst, n)
}

unsafe fn fill<T>(dst: *mut T, v: u8, n: usize) {
    ptr_write_bytes(dst, v, n)
}

unsafe fn fwd<T>(p: *const T, n: usize) -> *const T {
    ptr_add(p, n)
}

unsafe fn back<T>(p: *const T, n: usize) -> *const T {
    ptr_sub(p, n)
}

unsafe fn replace<T>(dest: mut_view<T>, src: T) -> T {
    let old = *dest
    *dest = src
    old
}

fn rows(tag: Str, d: view<[4][2]u32>) {
    print(tag)
    print(" ")
    print_int(((*d)[0][0] + (*d)[0][1]) as i64)
    print(" ")
    print_int(((*d)[1][0] + (*d)[1][1]) as i64)
    print(" ")
    print_int(((*d)[2][0] + (*d)[2][1]) as i64)
    print(" ")
    print_int(((*d)[3][0] + (*d)[3][1]) as i64)
    print("\n")
}

fn main() -> i32 {
    let src: [4][2]u32 = [[0u32, 1u32], [1u32, 1u32], [2u32, 3u32], [4u32, 5u32]]

    let mut d0: [4][2]u32 = [[0u32; 2]; 4]
    unsafe { cp(address_of(src[0]), address_of_mut(d0[0]), 0) }
    rows("n0", view(d0))

    let mut d1: [4][2]u32 = [[0u32; 2]; 4]
    unsafe { cp(address_of(src[0]), address_of_mut(d1[0]), 1) }
    let mut d1b: [4][2]u32 = [[0u32; 2]; 4]
    unsafe { cp(address_of(src[1]), address_of_mut(d1b[1]), 1) }
    print("n1 ")
    print_int((d1[0][0] + d1[0][1]) as i64)
    print(" ")
    print_int((d1b[1][0] + d1b[1][1]) as i64)
    print(" ")
    print_int((d1[1][0] + d1[1][1]) as i64)
    print(" ")
    print_int((d1b[2][0] + d1b[2][1]) as i64)
    print("\n")

    let mut d3: [4][2]u32 = [[0u32; 2]; 4]
    unsafe { cp(address_of(src[1]), address_of_mut(d3[0]), 3) }
    rows("n3", view(d3))

    let mut m: [4][2]u32 = [[1u32, 2u32], [3u32, 4u32], [5u32, 6u32], [7u32, 8u32]]
    unsafe { mv(address_of(m[0]), address_of_mut(m[1]), 3) }
    print("copy ")
    print_int(m[0][0] as i64)
    print(" ")
    print_int(m[0][1] as i64)
    print(" ")
    print_int(m[1][0] as i64)
    print(" ")
    print_int(m[1][1] as i64)
    print(" ")
    print_int(m[2][0] as i64)
    print(" ")
    print_int(m[2][1] as i64)
    print(" ")
    print_int(m[3][0] as i64)
    print(" ")
    print_int(m[3][1] as i64)
    print("\n")

    let mut w: [2][3]u16 = [[1u16, 2u16, 3u16], [4u16, 5u16, 6u16]]
    unsafe { fill(address_of_mut(w[0]), 0u8, 1) }
    print("wb ")
    print_int(w[0][0] as i64)
    print(" ")
    print_int(w[0][1] as i64)
    print(" ")
    print_int(w[0][2] as i64)
    print(" ")
    print_int(w[1][0] as i64)
    print(" ")
    print_int(w[1][1] as i64)
    print(" ")
    print_int(w[1][2] as i64)
    print("\n")

    let g: [3][3]u32 = [[1u32, 2u32, 3u32], [4u32, 5u32, 6u32], [7u32, 8u32, 9u32]]
    let p2 = unsafe { fwd(address_of(g[0]), 2) }
    let p1 = unsafe { fwd(address_of(g[0]), 1) }
    print("add ")
    print_int(unsafe { (*p2)[1] } as i64)
    print(" ")
    print_int(unsafe { (*p1)[1] } as i64)
    print("\n")
    let q0 = unsafe { back(address_of(g[2]), 2) }
    let q1 = unsafe { back(address_of(g[2]), 0) }
    print("sub ")
    print_int(unsafe { (*q0)[1] } as i64)
    print(" ")
    print_int(unsafe { (*q1)[1] } as i64)
    print("\n")

    let mut r: [4]u32 = [1u32, 2u32, 3u32, 4u32]
    let old = unsafe { replace(mut_view(r), [9u32, 10u32, 11u32, 12u32]) }
    print("replace ")
    print_int(old[0] as i64)
    print(" ")
    print_int(old[3] as i64)
    print(" ")
    print_int(r[0] as i64)
    print(" ")
    print_int(r[3] as i64)
    print("\n")

    let a: [3]u64 = [1u64, 2u64, 30000000000u64]
    let mut b: [3]u64 = [0u64, 0u64, 0u64]
    unsafe { ptr_copy_nonoverlapping(address_of(a[0]), address_of_mut(b[0]), 3) }
    print("plain ")
    print_int((b[0] + b[1]) as i64)
    print(" ")
    print_int(b[2] as i64)
    print("\n")
    0
}
