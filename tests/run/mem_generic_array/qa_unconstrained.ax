// test: ui
// T498g QA: a pointer intrinsic whose `T` is genuinely unconstrained must be a compile error, never a
// silent 1-byte element (the unresolved inference variable used to reach MIR with size 0 -> clamped to 1).

@intrinsic fn null<T>() -> *const T { 0 as *const T }
@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }
@intrinsic fn is_null<T>(p: *const T) -> bool { false }

fn main() -> i32 {
    let p = null() //~ ERROR AX_TYPE_UNKNOWN
    let q = null_mut() //~ ERROR AX_TYPE_UNKNOWN
    0
}
