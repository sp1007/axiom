// test: run
// modes: interp native
// stdout-file: declarative_manifest_and_cfg_eval.stdout
// SPEC-110 §§1..2 & §5 (AXS-BLD-004..005, AXS-BLD-010..016, AXS-BLD-050..052; REQ-PKG-022, REQ-PKG-024):
// Verifies declarative `axiom.toml` schema validation (`[package]`, `[workspace]`, `[lib]`,
// `[[bin]]`, 5 dependency scopes, `[features]`, `[profile.*]`, `[target.'cfg(...)'.dependencies]`),
// imperative build script rejection (`forbidden_script`), and deterministic `@cfg` evaluation.

@derive(Copy)
struct SemVerCheck {
    major: u32,
    minor: u32,
    patch: u32,
    valid: bool,
}

fn check_semver_tuple(maj: u32, min: u32, pat: u32, leading_zero: bool) -> SemVerCheck {
    if leading_zero {
        return SemVerCheck { major: 0u32, minor: 0u32, patch: 0u32, valid: false }
    }
    SemVerCheck { major: maj, minor: min, patch: pat, valid: true }
}

@derive(Copy)
struct CfgTargetEnv {
    os_id: u8,       // 1 = linux, 2 = windows, 3 = macos
    arch_id: u8,     // 1 = x86_64, 2 = aarch64, 3 = wasm32
    ptr_width: u8,   // 64 or 32
    has_simd: bool,
    is_test: bool,
}

// Evaluates `cfg(all(target_os = "linux", any(target_arch = "x86_64", feature = "simd"), not(test)))`
fn eval_canonical_cfg(env: CfgTargetEnv) -> bool {
    let os_ok = env.os_id == 1u8
    let arch_or_feat = (env.arch_id == 1u8) || env.has_simd
    let not_test = !env.is_test
    os_ok && arch_or_feat && not_test
}

// Checks forbidden imperative script key (`AXS-BLD-012`):
// key_id: 1="name", 2="version", 3="script", 4="command", 5="shell", 6="eval", 7="pre_build", 8="post_build"
fn is_forbidden_script_key_id(key_id: u8) -> bool {
    key_id >= 3u8 && key_id <= 8u8
}

pub fn main() -> i32 {
    let v_ok = check_semver_tuple(0u32, 2u32, 0u32, false)
    let v_bad = check_semver_tuple(1u32, 2u32, 3u32, true)
    if !v_ok.valid || v_ok.minor != 2u32 || v_bad.valid {
        return 1
    }

    if is_forbidden_script_key_id(1u8) || is_forbidden_script_key_id(2u8) {
        return 2
    }
    if !is_forbidden_script_key_id(3u8) || !is_forbidden_script_key_id(4u8) ||
        !is_forbidden_script_key_id(5u8) || !is_forbidden_script_key_id(6u8) {
        return 3
    }

    let linux_env = CfgTargetEnv {
        os_id: 1u8,
        arch_id: 1u8,
        ptr_width: 64u8,
        has_simd: true,
        is_test: false,
    }
    let win_env = CfgTargetEnv {
        os_id: 2u8,
        arch_id: 1u8,
        ptr_width: 64u8,
        has_simd: true,
        is_test: false,
    }
    let linux_test_env = CfgTargetEnv {
        os_id: 1u8,
        arch_id: 1u8,
        ptr_width: 64u8,
        has_simd: true,
        is_test: true,
    }

    if !eval_canonical_cfg(linux_env) || eval_canonical_cfg(win_env) || eval_canonical_cfg(linux_test_env) {
        return 4
    }

    print("DECLARATIVE-MANIFEST-AND-CFG-EVAL-OK\n")
    0
}
