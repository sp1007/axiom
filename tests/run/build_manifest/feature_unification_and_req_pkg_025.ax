// test: run
// modes: interp native
// stdout-file: feature_unification_and_req_pkg_025.stdout
// SPEC-110 §1..3 (AXS-BLD-005, AXS-BLD-014..015, AXS-BLD-021, AXS-BLD-030; REQ-PKG-024, REQ-PKG-025):
// Verifies closed feature namespace (`unknown_feature`), monotonic feature unification separated by
// `Host` vs `Target` environment class, `dev-dependencies` non-leakage into downstream library
// `SemanticFingerprint`, and `REQ-PKG-025` feature integrity & semantic non-interference.

@derive(Copy)
struct FeatureState {
    declared_mask: u32,
    active_target_mask: u32,
    active_host_mask: u32,
    conflict_pair_mask: u32,
}

fn unify_feature_bit(
    st: mut_view<FeatureState>,
    feat_bit: u32,
    is_host: bool
) -> i32 {
    // Returns 0 = ok, 1 = unknown_feature, 2 = feature_conflict
    if (st.declared_mask & feat_bit) == 0u32 {
        return 1
    }
    if is_host {
        st.active_host_mask = st.active_host_mask | feat_bit
        if (st.active_host_mask & st.conflict_pair_mask) == st.conflict_pair_mask && st.conflict_pair_mask != 0u32 {
            return 2
        }
    } else {
        st.active_target_mask = st.active_target_mask | feat_bit
        if (st.active_target_mask & st.conflict_pair_mask) == st.conflict_pair_mask && st.conflict_pair_mask != 0u32 {
            return 2
        }
    }
    0
}

fn compute_lib_semantic_fp(pkg_id_hash: u64, api_hash: u64, normal_dep_fp: u64, _dev_dep_fp: u64) -> u64 {
    // `dev-dependencies` (`_dev_dep_fp`) MUST NOT participate in non-test `[lib]` `SemanticFingerprint` (`AXS-BLD-005 §2`)
    let mut fp: u64 = 0x14650FB0739D0383u64
    fp = (fp ^ pkg_id_hash) ^ (pkg_id_hash << 7u64)
    fp = (fp ^ api_hash) ^ (api_hash << 13u64)
    fp = (fp ^ normal_dep_fp) ^ (normal_dep_fp << 19u64)
    fp
}

pub fn main() -> i32 {
    // Declared features: bit 1 (`default`), bit 2 (`simd`), bit 4 (`avx2`), bit 8 (`soft_float`, conflicts with `simd`)
    let mut st = FeatureState {
        declared_mask: 1u32 | 2u32 | 4u32 | 8u32,
        active_target_mask: 0u32,
        active_host_mask: 0u32,
        conflict_pair_mask: 2u32 | 8u32,
    }

    // 1. Target edge activates `simd` (bit 2); Host build-dep edge activates `soft_float` (bit 8).
    // Because Host and Target do not bleed features (`AXS-BLD-014 §2`, `AXS-BLD-021`), neither conflicts!
    let r1 = unify_feature_bit(mut_view(st), 2u32, false)
    let r2 = unify_feature_bit(mut_view(st), 8u32, true)
    if r1 != 0 || r2 != 0 || st.active_target_mask != 2u32 || st.active_host_mask != 8u32 {
        return 1
    }

    // 2. Requesting undeclared feature bit 16 fails with `unknown_feature` (`REQ-PKG-025`)
    let r_unk = unify_feature_bit(mut_view(st), 16u32, false)
    if r_unk != 1 {
        return 2
    }

    // 3. Activating `soft_float` (bit 8) on Target alongside `simd` (bit 2) fails with `feature_conflict`
    let r_conf = unify_feature_bit(mut_view(st), 8u32, false)
    if r_conf != 2 {
        return 3
    }

    // 4. `dev-dependencies` firewall: changing `dev_dep_fp` leaves `[lib]` `SemanticFingerprint` identical
    let fp_a = compute_lib_semantic_fp(0x100u64, 0x200u64, 0x300u64, 0xAAAAu64)
    let fp_b = compute_lib_semantic_fp(0x100u64, 0x200u64, 0x300u64, 0xBBBBu64)
    if fp_a != fp_b {
        return 4
    }

    print("FEATURE-UNIFICATION-AND-REQ-PKG-025-OK\n")
    0
}
