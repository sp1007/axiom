@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

fn out_str(s: str) {
    let sv = ux2_sv(s)
    let _ = unsafe { write(stdio(1), sv.ptr, sv.len) }
}

fn out_sv(sv: StrView) {
    if sv.len > 0usize && (sv.ptr as usize) != 0usize {
        let _ = unsafe { write(stdio(1), sv.ptr, sv.len) }
    }
}

fn out_bool(b: bool) {
    if b {
        out_str("true")
    } else {
        out_str("false")
    }
}

fn new_diag_sink() -> DiagSink {
    let mut sink = DiagSink {
        arena: (query_db_empty()).arena,
        diags: 0 as *mut compiler.diag.emitter.Diagnostic,
        len: 0,
        cap: 0,
        errors: 0,
        warnings: 0,
    }
    diag_sink_init(mut_view(sink))
    sink
}

fn run_manifest_and_cfg_probe() -> bool {
    let mut sink = new_diag_sink()
    let toml_ok = ux2_sv("[workspace]\nmembers = [\n    \"crates/core_math\",\n    \"crates/app_cli\"\n]\nexclude = [\"crates/experimental\"]\ndefault_members = [\"crates/app_cli\"]\nresolver = \"1\"\n\n[package]\nname = \"app_cli\"\nversion = \"0.2.0-rc.1+build.7\"\nedition = \"2026\"\naxiom = \">=0.1.0\"\nlicense = \"Apache-2.0\"\ndescription = \"Deterministic CLI application\"\nauthors = [\"Axiom Team\"]\n\n[lib]\nname = \"app_cli\"\npath = \"src/lib.ax\"\ncrate_type = [\"axlib\", \"staticlib\"]\n\n[[bin]]\nname = \"app\"\npath = \"src/main.ax\"\n\n[[build_tool]]\nname = \"schema_tool\"\npath = \"tools/schema_tool.ax\"\ninputs = [\"schema/api.axschema\"]\noutputs = [\"generated/api_types.ax\"]\n\n[features]\ndefault = [\"simd\"]\nsimd = []\ntelemetry = [\"dep:metrics_core\"]\n\n[dependencies]\ncore_math = { path = \"../core_math\", version = \"^0.2.0\", features = [\"fast_fma\"] }\nmetrics_core = { version = \"^1.4.0\", optional = true }\n\n[dev-dependencies]\ntest_kit = \"^0.1.0\"\n\n[build-dependencies]\nschema_gen = { path = \"../schema_gen\", version = \"^0.1.0\" }\n\n[comptime-dependencies]\nct_macros = { version = \"^0.1.0\" }\n\n[system-dependencies]\nzstd_sys = { package = \"zstd\" }\n\n[target.'cfg(target_os = \"linux\")'.dependencies]\nuring_sys = { version = \"^0.3.0\" }\n\n[profile.release]\nopt_level = 3\nlto = \"thin\"\npanic = \"abort\"\ndebug_info = \"line-tables-only\"\ndeterministic = true\n")
    let mut man = declarative_manifest_empty()
    let parsed_ok = parse_axiom_toml(toml_ok, mut_view(man), mut_view(sink))
    let mut rel_prof = profile_builtin_release()
    let found_rel = manifest_find_profile(view(man), ux2_sv("release"), mut_view(rel_prof))
    let schema_ok = parsed_ok &&
        man.has_package &&
        man.has_workspace &&
        ux2_sv_eq(man.package.name, ux2_sv("app_cli")) &&
        man.package.version.major == 0u32 &&
        man.package.version.minor == 2u32 &&
        man.package.version.patch == 0u32 &&
        ux2_sv_eq(man.package.version.prerelease, ux2_sv("rc.1")) &&
        ux2_sv_eq(man.package.version.build_meta, ux2_sv("build.7")) &&
        man.workspace.member_count == 2usize &&
        man.lib_target.present &&
        man.lib_target.crate_type_count == 2usize &&
        man.bin_count == 1usize &&
        man.build_tool_count == 1usize &&
        man.feature_count == 4usize &&
        man.dependency_count == 7usize &&
        found_rel &&
        rel_prof.opt_level == 3u8 &&
        ux2_sv_eq(rel_prof.lto, ux2_sv("thin")) &&
        ux2_sv_eq(rel_prof.panic_strategy, ux2_sv("abort")) &&
        ux2_sv_eq(rel_prof.debug_info, ux2_sv("line-tables-only")) &&
        rel_prof.deterministic

    // Negative test 1: Imperative build script directive (`AXS-BLD-012`, `AXS-BLD-052 §1`)
    let mut sink_script = new_diag_sink()
    let mut bad_man = declarative_manifest_empty()
    let bad_script_toml = ux2_sv(
        "[package]\nname = \"bad_pkg\"\nversion = \"0.1.0\"\nedition = \"2026\"\nscript = \"sh ./gen.sh\"\n"
    )
    let script_ok = !parse_axiom_toml(bad_script_toml, mut_view(bad_man), mut_view(sink_script)) &&
        sink_script.errors == 1usize
    let d_script = diag_sink_get(view(sink_script), 0usize)
    let script_diag_ok = script_ok &&
        d_script.code.v == AX_DRIVER_BAD_MANIFEST &&
        ux2_sv_eq(manifest_diag_get_data(view(d_script), ux2_sv("kind")), ux2_sv("forbidden_script")) &&
        ux2_sv_eq(manifest_diag_get_data(view(d_script), ux2_sv("key")), ux2_sv("script"))

    // Negative test 2: Invalid SemVer (`01.0.0`) & invalid profile `opt_level = 7`
    let mut sink_sv = new_diag_sink()
    let bad_sv_toml = ux2_sv("[package]\nname = \"bad_ver\"\nversion = \"01.0.0\"\n")
    let sv_parse_failed = !parse_axiom_toml(bad_sv_toml, mut_view(bad_man), mut_view(sink_sv))
    let d_sv = diag_sink_get(view(sink_sv), 0usize)
    let sv_rej_ok = sv_parse_failed &&
        ux2_sv_eq(manifest_diag_get_data(view(d_sv), ux2_sv("kind")), ux2_sv("semver"))

    let mut sink_prof = new_diag_sink()
    let bad_prof_toml = ux2_sv("[package]\nname = \"p\"\nversion = \"0.1.0\"\n[profile.release]\nopt_level = 7\n")
    let prof_parse_failed = !parse_axiom_toml(bad_prof_toml, mut_view(bad_man), mut_view(sink_prof))
    let d_prof = diag_sink_get(view(sink_prof), 0usize)
    let prof_rej_ok = prof_parse_failed && d_prof.code.v == AX_DRIVER_INVALID_PROFILE

    // `@cfg(...)` deterministic evaluation & invalid key rejection (`AXS-BLD-014 §4`)
    let mut linux_ctx: CfgContext = cfg_context_default_linux_x64()
    cfg_context_add_feature(mut_view(linux_ctx), ux2_sv("simd"))
    let win_ctx: CfgContext = cfg_context_default_windows_x64()
    let cfg_expr = ux2_sv("cfg(all(target_os = \"linux\", any(target_arch = \"x86_64\", feature = \"simd\"), not(test)))")
    let mut m_linux: bool = false
    let mut m_win: bool = false
    let eval1 = cfg_validate_and_eval(cfg_expr, view(linux_ctx), mut_view(m_linux), mut_view(sink))
    let eval2 = cfg_validate_and_eval(cfg_expr, view(win_ctx), mut_view(m_win), mut_view(sink))
    let cfg_eval_ok = eval1 && m_linux && eval2 && !m_win

    let mut sink_cfg = new_diag_sink()
    let bad_cfg_toml = ux2_sv(
        "[package]\nname = \"p\"\nversion = \"0.1.0\"\n[target.'cfg(unknown_pred = \"foo\")'.dependencies]\nx = \"^0.1.0\"\n"
    )
    let cfg_parse_failed = !parse_axiom_toml(bad_cfg_toml, mut_view(bad_man), mut_view(sink_cfg))
    let d_cfg = diag_sink_get(view(sink_cfg), 0usize)
    let invalid_cfg_rejected = cfg_parse_failed &&
        d_cfg.code.v == AX_NAME_INVALID_CFG_PREDICATE &&
        ux2_sv_eq(manifest_diag_get_data(view(d_cfg), ux2_sv("key")), ux2_sv("unknown_pred"))

    out_str("probe[manifest_cfg] schema_ok=")
    out_bool(schema_ok && sv_rej_ok && prof_rej_ok)
    out_str(" scopes=5 script_rejected=")
    out_bool(script_diag_ok)
    out_str(" cfg_eval_ok=")
    out_bool(cfg_eval_ok)
    out_str(" invalid_cfg_rejected=")
    out_bool(invalid_cfg_rejected)
    out_str("\n")

    diag_sink_free(mut_view(sink_cfg))
    diag_sink_free(mut_view(sink_prof))
    diag_sink_free(mut_view(sink_sv))
    diag_sink_free(mut_view(sink_script))
    diag_sink_free(mut_view(sink))

    schema_ok && sv_rej_ok && prof_rej_ok && script_diag_ok && cfg_eval_ok && invalid_cfg_rejected
}

fn build_demo_workspace_members(
    reverse_order: bool,
    dev_dep_api_hash: u64
) -> [16]WorkspaceMemberInput {
    let e = workspace_member_input_new(ux2_sv_empty(), ux2_sv_empty())
    let mut arr: [16]WorkspaceMemberInput = [e; 16]

    let mut m_core = workspace_member_input_new(
        ux2_sv("crates/core_math"),
        ux2_sv("[package]\nname = \"core_math\"\nversion = \"0.2.0\"\nedition = \"2026\"\n[lib]\nname = \"core_math\"\npath = \"src/lib.ax\"\n[features]\ndefault = []\nfast_fma = []\nhost_codegen = []\nscalar_only = { implies = [], conflicts_with = [\"fast_fma\"] }\n")
    )
    m_core.public_api_source_hash = 0xCAFEBABE11112222u64
    m_core.has_intra_pkg_module_scc = true

    let mut m_metrics = workspace_member_input_new(
        ux2_sv("crates/metrics_core"),
        ux2_sv("[package]\nname = \"metrics_core\"\nversion = \"1.4.0\"\nedition = \"2026\"\n[lib]\nname = \"metrics_core\"\npath = \"src/lib.ax\"\n[features]\ndefault = []\njson_export = []\n")
    )
    m_metrics.public_api_source_hash = 0x3333444455556666u64

    let mut m_schema = workspace_member_input_new(
        ux2_sv("crates/schema_gen"),
        ux2_sv("[package]\nname = \"schema_gen\"\nversion = \"0.1.0\"\nedition = \"2026\"\n[lib]\nname = \"schema_gen\"\npath = \"src/lib.ax\"\n[dependencies]\ncore_math = { path = \"../core_math\", version = \"^0.2.0\", features = [\"host_codegen\"] }\n")
    )
    m_schema.public_api_source_hash = 0x777788889999AAAAu64

    let mut m_testkit = workspace_member_input_new(
        ux2_sv("crates/test_kit"),
        ux2_sv("[package]\nname = \"test_kit\"\nversion = \"0.1.0\"\nedition = \"2026\"\n[lib]\nname = \"test_kit\"\npath = \"src/lib.ax\"\n")
    )
    m_testkit.public_api_source_hash = dev_dep_api_hash

    let mut m_app = workspace_member_input_new(
        ux2_sv("crates/app_cli"),
        ux2_sv("[package]\nname = \"app_cli\"\nversion = \"0.2.0\"\nedition = \"2026\"\n[[bin]]\nname = \"app\"\npath = \"src/main.ax\"\n[features]\ndefault = [\"simd\"]\nsimd = [\"core_math/fast_fma\"]\ntelemetry = [\"dep:metrics_core\", \"metrics_core/json_export\"]\n[dependencies]\ncore_math = { path = \"../core_math\", version = \"^0.2.0\" }\nmetrics_core = { path = \"../metrics_core\", version = \"^1.4.0\", optional = true }\n[dev-dependencies]\ntest_kit = { path = \"../test_kit\", version = \"^0.1.0\" }\n[build-dependencies]\nschema_gen = { path = \"../schema_gen\", version = \"^0.1.0\" }\n[target.'cfg(target_os = \"linux\")'.dependencies]\nmetrics_core = { path = \"../metrics_core\", version = \"^1.4.0\" }\n")
    )
    m_app.public_api_source_hash = 0xBBBBCCCCDDDDEEEEu64

    if reverse_order {
        arr[0] = m_app
        arr[1] = m_testkit
        arr[2] = m_schema
        arr[3] = m_metrics
        arr[4] = m_core
    } else {
        arr[0] = m_core
        arr[1] = m_metrics
        arr[2] = m_schema
        arr[3] = m_testkit
        arr[4] = m_app
    }
    arr
}

fn demo_workspace_root_toml() -> StrView {
    ux2_sv("[workspace]\nmembers = [\n    \"crates/core_math\",\n    \"crates/metrics_core\",\n    \"crates/schema_gen\",\n    \"crates/test_kit\",\n    \"crates/app_cli\"\n]\nexclude = [\"crates/experimental\"]\ndefault_members = [\"crates/app_cli\"]\nresolver = \"1\"\n")
}

fn run_workspace_dag_and_cycle_probe() -> bool {
    let mut sink = new_diag_sink()
    let ws_toml = demo_workspace_root_toml()
    let members_a = build_demo_workspace_members(false, 0x1111u64)
    let members_b = build_demo_workspace_members(true, 0x1111u64)

    let mut opts_a: WorkspaceResolveOptions = workspace_resolve_options_default()
    opts_a.host_workspace_root = ux2_sv("C:/work/repo_alpha")
    opts_a.host_triple = ux2_sv("x86_64-windows")
    opts_a.target_triple = ux2_sv("x86_64-linux")
    opts_a.cli_features[0] = ux2_sv("telemetry")
    opts_a.cli_feature_count = 1usize

    let mut opts_b: WorkspaceResolveOptions = opts_a
    opts_b.host_workspace_root = ux2_sv("/home/ci/runners/repo_beta")

    let mut g_a: WorkspaceGraph = workspace_graph_empty()
    let mut g_b: WorkspaceGraph = workspace_graph_empty()
    let ok_a = resolve_workspace_graph(ws_toml, view(members_a), 5usize, view(opts_a), mut_view(g_a), mut_view(sink))
    let ok_b = resolve_workspace_graph(ws_toml, view(members_b), 5usize, view(opts_b), mut_view(g_b), mut_view(sink))

    let mut sum_a = DiagBuffer { ptr: 0 as *mut u8, len: 0usize, cap: 0usize }
    let mut sum_b = DiagBuffer { ptr: 0 as *mut u8, len: 0usize, cap: 0usize }
    diag_buf_init(mut_view(sum_a))
    diag_buf_init(mut_view(sum_b))
    render_workspace_graph_summary(view(g_a), mut_view(sum_a))
    render_workspace_graph_summary(view(g_b), mut_view(sum_b))
    let topo_det_ok = ok_a && ok_b &&
        g_a.package_count == 6usize &&
        ux2_sv_eq(diag_buf_as_str_view(view(sum_a)), diag_buf_as_str_view(view(sum_b))) &&
        ux2_sv_contains(diag_buf_as_str_view(view(sum_a)), ux2_sv("core_math:target,core_math:host,metrics_core:target,schema_gen:host,app_cli:target"))
    diag_buf_free(mut_view(sum_b))
    diag_buf_free(mut_view(sum_a))

    // Verify member path containment rejection (`..` escape, `AXS-BLD-013 §2`)
    let mut sink_esc = new_diag_sink()
    let mut g_esc = workspace_graph_empty()
    let esc_toml = ux2_sv("[workspace]\nmembers = [\"../outside_pkg\"]\n")
    let esc_failed = !resolve_workspace_graph(esc_toml, view(members_a), 5usize, view(opts_a), mut_view(g_esc), mut_view(sink_esc))
    let d_esc = diag_sink_get(view(sink_esc), 0usize)
    let esc_rej = esc_failed &&
        ux2_sv_eq(manifest_diag_get_data(view(d_esc), ux2_sv("kind")), ux2_sv("workspace_member")) &&
        ux2_sv_eq(manifest_diag_get_data(view(d_esc), ux2_sv("member")), ux2_sv("../outside_pkg"))

    // Verify package-level dependency cycle rejection (`alpha -> beta -> alpha`, `AXS-BLD-003 §1`, `AXS-BLD-052 §2`)
    let mut cyc_members: [16]WorkspaceMemberInput = [workspace_member_input_new(ux2_sv_empty(), ux2_sv_empty()); 16]
    cyc_members[0] = workspace_member_input_new(
        ux2_sv("crates/alpha"),
        ux2_sv("[package]\nname = \"alpha\"\nversion = \"0.1.0\"\nedition = \"2026\"\n[dependencies]\nbeta = { path = \"../beta\", version = \"^0.1.0\" }\n")
    )
    cyc_members[1] = workspace_member_input_new(
        ux2_sv("crates/beta"),
        ux2_sv("[package]\nname = \"beta\"\nversion = \"0.1.0\"\nedition = \"2026\"\n[dependencies]\nalpha = { path = \"../alpha\", version = \"^0.1.0\" }\n")
    )
    let cyc_ws_toml = ux2_sv("[workspace]\nmembers = [\"crates/alpha\", \"crates/beta\"]\n")
    let mut sink_cyc = new_diag_sink()
    let mut g_cyc = workspace_graph_empty()
    let cyc_opts = workspace_resolve_options_default()
    let cyc_rej = !resolve_workspace_graph(cyc_ws_toml, view(cyc_members), 2usize, view(cyc_opts), mut_view(g_cyc), mut_view(sink_cyc)) &&
        sink_cyc.errors == 1usize
    let d_cyc = diag_sink_get(view(sink_cyc), 0usize)
    let cyc_str = manifest_diag_get_data(view(d_cyc), ux2_sv("cycle"))
    let cycle_ok = cyc_rej &&
        d_cyc.code.v == AX_DRIVER_BAD_MANIFEST &&
        ux2_sv_eq(manifest_diag_get_data(view(d_cyc), ux2_sv("kind")), ux2_sv("package_cycle")) &&
        ux2_sv_eq(cyc_str, ux2_sv("alpha -> beta -> alpha"))

    // Verify intra-package declaration SCC allowed vs module import cycle rejected (`AXS-BLD-003 §2`)
    let mut bad_mod_members = members_a
    bad_mod_members[0].module_scc_has_import_cycle = true
    let mut sink_mod = new_diag_sink()
    let mut g_mod = workspace_graph_empty()
    let mod_failed = !resolve_workspace_graph(ws_toml, view(bad_mod_members), 5usize, view(opts_a), mut_view(g_mod), mut_view(sink_mod))
    let d_mod = diag_sink_get(view(sink_mod), 0usize)
    let mod_cyc_rej = mod_failed && d_mod.code.v == AX_NAME_IMPORT_CYCLE

    let mut cm_scc_idx: usize = 0usize
    let has_cm_scc = find_package_node_by_name_and_env(view(g_a), ux2_sv("core_math"), ENV_CLASS_TARGET, mut_view(cm_scc_idx)) &&
        g_a.packages[cm_scc_idx].has_intra_pkg_module_scc

    out_str("probe[workspace_dag] members_ok=")
    out_bool(esc_rej)
    out_str(" topo_det_ok=")
    out_bool(topo_det_ok)
    out_str(" cycle_rejected=")
    out_bool(cycle_ok)
    out_str(" cycle=\"")
    out_sv(cyc_str)
    out_str("\" intra_scc_ok=")
    out_bool(mod_cyc_rej && has_cm_scc)
    out_str("\n")

    diag_sink_free(mut_view(sink_mod))
    diag_sink_free(mut_view(sink_cyc))
    diag_sink_free(mut_view(sink_esc))
    diag_sink_free(mut_view(sink))

    esc_rej && topo_det_ok && cycle_ok && mod_cyc_rej && has_cm_scc
}

fn run_feature_unification_and_req_pkg_025_probe() -> bool {
    let mut sink = new_diag_sink()
    let ws_toml = demo_workspace_root_toml()
    let members_a = build_demo_workspace_members(false, 0x1111u64)
    let members_b = build_demo_workspace_members(true, 0x1111u64)
    let members_dev_changed = build_demo_workspace_members(false, 0x9999u64)

    let mut opts_a = workspace_resolve_options_default()
    opts_a.host_workspace_root = ux2_sv("C:/work/repo_alpha")
    opts_a.host_triple = ux2_sv("x86_64-windows")
    opts_a.target_triple = ux2_sv("x86_64-linux")
    opts_a.cli_features[0] = ux2_sv("telemetry")
    opts_a.cli_feature_count = 1usize

    let mut opts_b = opts_a
    opts_b.host_workspace_root = ux2_sv("/var/build/repo_beta")

    let mut opts_dev = opts_a
    opts_dev.include_dev_deps = true

    let mut g_a = workspace_graph_empty()
    let mut g_b = workspace_graph_empty()
    let mut g_dev = workspace_graph_empty()
    let ok_a = resolve_workspace_graph(ws_toml, view(members_a), 5usize, view(opts_a), mut_view(g_a), mut_view(sink))
    let ok_b = resolve_workspace_graph(ws_toml, view(members_b), 5usize, view(opts_b), mut_view(g_b), mut_view(sink))
    let ok_dev = resolve_workspace_graph(ws_toml, view(members_dev_changed), 5usize, view(opts_dev), mut_view(g_dev), mut_view(sink))

    // Verify Host vs Target feature isolation on `core_math` (`AXS-BLD-014 §2`, `AXS-BLD-021`)
    let mut cm_target_idx: usize = 0usize
    let mut cm_host_idx: usize = 0usize
    let mut app_idx: usize = 0usize
    let mut mc_idx: usize = 0usize
    let found_nodes = find_package_node_by_name_and_env(view(g_a), ux2_sv("core_math"), ENV_CLASS_TARGET, mut_view(cm_target_idx)) &&
        find_package_node_by_name_and_env(view(g_a), ux2_sv("core_math"), ENV_CLASS_HOST, mut_view(cm_host_idx)) &&
        find_package_node_by_name_and_env(view(g_a), ux2_sv("app_cli"), ENV_CLASS_TARGET, mut_view(app_idx)) &&
        find_package_node_by_name_and_env(view(g_a), ux2_sv("metrics_core"), ENV_CLASS_TARGET, mut_view(mc_idx))

    let unify_ok = ok_a && ok_b && ok_dev && found_nodes &&
        node_has_feature(view(g_a.packages[cm_target_idx]), ux2_sv("fast_fma")) &&
        !node_has_feature(view(g_a.packages[cm_target_idx]), ux2_sv("host_codegen")) &&
        node_has_feature(view(g_a.packages[cm_host_idx]), ux2_sv("host_codegen")) &&
        !node_has_feature(view(g_a.packages[cm_host_idx]), ux2_sv("fast_fma")) &&
        node_has_enabled_opt_dep(view(g_a.packages[app_idx]), ux2_sv("metrics_core")) &&
        node_has_feature(view(g_a.packages[mc_idx]), ux2_sv("json_export"))

    // Negative test 1: Undeclared feature request (`AXS-BLD-014 §1`, `AXS-BLD-052 §3`, `REQ-PKG-025`)
    let mut opts_unk = opts_a
    opts_unk.cli_features[0] = ux2_sv("nonexistent_simd")
    opts_unk.cli_feature_count = 1usize
    let mut sink_unk = new_diag_sink()
    let mut g_unk = workspace_graph_empty()
    let unk_rej = !resolve_workspace_graph(ws_toml, view(members_a), 5usize, view(opts_unk), mut_view(g_unk), mut_view(sink_unk)) &&
        sink_unk.errors == 1usize
    let d_unk = diag_sink_get(view(sink_unk), 0usize)
    let unk_ok = unk_rej &&
        d_unk.code.v == AX_DRIVER_BAD_MANIFEST &&
        ux2_sv_eq(manifest_diag_get_data(view(d_unk), ux2_sv("kind")), ux2_sv("unknown_feature")) &&
        ux2_sv_eq(manifest_diag_get_data(view(d_unk), ux2_sv("package")), ux2_sv("app_cli")) &&
        ux2_sv_eq(manifest_diag_get_data(view(d_unk), ux2_sv("feature")), ux2_sv("nonexistent_simd"))

    // Negative test 2: Mutually exclusive feature conflict (`fast_fma` vs `scalar_only` on `core_math`)
    let mut opts_conf = workspace_resolve_options_default()
    opts_conf.selected_packages[0] = ux2_sv("core_math")
    opts_conf.selected_package_count = 1usize
    opts_conf.cli_features[0] = ux2_sv("fast_fma")
    opts_conf.cli_features[1] = ux2_sv("scalar_only")
    opts_conf.cli_feature_count = 2usize
    let mut sink_conf = new_diag_sink()
    let mut g_conf = workspace_graph_empty()
    let conf_failed = !resolve_workspace_graph(ws_toml, view(members_a), 5usize, view(opts_conf), mut_view(g_conf), mut_view(sink_conf))
    let d_conf = diag_sink_get(view(sink_conf), 0usize)
    let conf_rej = conf_failed &&
        ux2_sv_eq(manifest_diag_get_data(view(d_conf), ux2_sv("kind")), ux2_sv("feature_conflict"))

    // Verify `REQ-PKG-025` Semantic Non-Interference & `dev-dependencies` Firewall Audit
    let audit = verify_req_pkg_025_semantic_invariance(view(g_a), view(g_b), view(g_dev))

    out_str("probe[features_req_pkg_025] unify_ok=")
    out_bool(unify_ok)
    out_str(" unknown_feat_rejected=")
    out_bool(unk_ok)
    out_str(" conflict_rejected=")
    out_bool(conf_rej)
    out_str(" req_pkg_025_audit_ok=")
    out_bool(audit.all_passed)
    out_str("\n")

    diag_sink_free(mut_view(sink_conf))
    diag_sink_free(mut_view(sink_unk))
    diag_sink_free(mut_view(sink))

    unify_ok && unk_ok && conf_rej && audit.all_passed
}

pub fn main() -> i32 {
    let ok1 = run_manifest_and_cfg_probe()
    let ok2 = run_workspace_dag_and_cycle_probe()
    let ok3 = run_feature_unification_and_req_pkg_025_probe()
    if !ok1 || !ok2 || !ok3 {
        return 1
    }
    out_str("BUILD-MANIFEST-PROBE-PASS\n")
    0
}
