// test: run
// modes: interp native
// stdout: close:11\nclose:22\nclose:44\nclose:33\ndone\n
// exit: 7
// Regression for T495: `impl<T> Drop` calling a generic inherent method (`mut_view(*self).close()`)
// on a generic struct without `T`-typed fields (shape of `AsyncSender<T>`), both directly and
// transitively via a containing struct, instantiated with two concrete types (`u64` and `u32`).

struct Handle<T> {
    ptr: *mut T,
    id: i32,
}

impl<T> Handle<T> {
    pub fn close(self: mut_view<Handle<T>>) {
        if self.id != 0 {
            print("close:");
            print_int(self.id);
            print("\n");
            self.id = 0;
        }
    }
}

impl<T> Drop for Handle<T> {
    fn drop(self: mut_view<Handle<T>>) {
        mut_view(*self).close();
    }
}

struct Outer {
    first: Handle<u64>,
    second: Handle<u32>,
}

fn main() -> i32 {
    {
        let h1 = Handle<u64> { ptr: 0 as *mut u64, id: 22 };
        let h2 = Handle<u32> { ptr: 0 as *mut u32, id: 11 };
        let _ = h1.id + h2.id;
    }
    {
        let o = Outer {
            first: Handle<u64> { ptr: 0 as *mut u64, id: 44 },
            second: Handle<u32> { ptr: 0 as *mut u32, id: 33 },
        };
        let _ = o.first.id + o.second.id;
    }
    print("done\n");
    7
}
