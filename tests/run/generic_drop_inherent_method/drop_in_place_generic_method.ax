// test: run
// modes: interp native
// stdout: finish:71:4\nfinish:82:16\nafter:0:0\nall_ok\n
// exit: 9
// Regression for T495: `drop_in_place<Cell<T>>` invoking a monomorphized `impl<T> Drop for Cell<T>`
// which in turn calls a generic inherent method reading/mutating fields across a `T`-typed field
// and evaluating `size_of<T>()`.

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn drop_in_place<T>(p: *mut T) {}

struct Wide {
    a: i64,
    b: i64,
}

struct Cell<T> {
    val: T,
    code: i32,
}

impl<T> Cell<T> {
    fn finish(self: mut_view<Cell<T>>) {
        if self.code != 0 {
            print("finish:");
            print_int(self.code);
            print(":");
            print_int(size_of<T>() as i64);
            print("\n");
            self.code = 0;
        }
    }
}

impl<T> Drop for Cell<T> {
    fn drop(self: mut_view<Cell<T>>) {
        mut_view(*self).finish();
    }
}

fn main() -> i32 {
    let mut c1 = Cell<u32> { val: 123u32, code: 71 };
    let mut c2 = Cell<Wide> { val: Wide { a: 1i64, b: 2i64 }, code: 82 };
    unsafe {
        drop_in_place<Cell<u32>>(address_of_mut(c1));
        drop_in_place<Cell<Wide>>(address_of_mut(c2));
    }
    print("after:");
    print_int(c1.code);
    print(":");
    print_int(c2.code);
    print("\n");
    print("all_ok\n");
    9
}
