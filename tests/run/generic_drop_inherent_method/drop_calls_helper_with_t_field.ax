// test: run
// modes: interp native
// stdout: drop:30:35:300\ndrop:20:25:200\ndrop:10:15:100\nend\n
// exit: 13
// Regression for T495: `impl<T> Drop` calling generic inherent methods (`mut_view(*self).helper()`
// and `view(*self).report()`) on a struct WITH a `T`-typed field ahead of / between accessed fields,
// instantiated with `u32`, `u64`, and an 8-byte-aligned struct `BigPair` whose alignment differs from `u32`.

struct BigPair {
    hi: i64,
    lo: i64,
}

struct WithPayload<T> {
    before: i32,
    payload: T,
    after: i32,
    tag: i32,
}

impl<T> WithPayload<T> {
    fn report(self: view<WithPayload<T>>) {
        print("drop:");
        print_int(self.before);
        print(":");
        print_int(self.after);
        print(":");
        print_int(self.tag);
        print("\n");
    }

    fn helper(self: mut_view<WithPayload<T>>) {
        self.after = self.after + 5;
        view(*self).report();
    }
}

impl<T> Drop for WithPayload<T> {
    fn drop(self: mut_view<WithPayload<T>>) {
        mut_view(*self).helper();
    }
}

fn main() -> i32 {
    {
        let a = WithPayload<u32> { before: 10, payload: 1u32, after: 10, tag: 100 };
        let b = WithPayload<u64> { before: 20, payload: 2u64, after: 20, tag: 200 };
        let c = WithPayload<BigPair> {
            before: 30,
            payload: BigPair { hi: 99i64, lo: 88i64 },
            after: 30,
            tag: 300,
        };
        let _ = a.tag + b.tag + c.tag;
    }
    print("end\n");
    13
}
