// test: run
// modes: interp native
// stdout-file: cascade_suppression_recovery.stdout
// SPEC-21 AXS-QRY-020, AXS-QRY-023, AXS-QRY-031:
// Verify cycle recovery fallback values (`ErrorType`, `ConstValue.Poisoned`,
// `TraitResult.Error`, `LayoutResult.Poisoned`) and cascading error suppression:
// - Downstream callers of a poisoned cycle propagate `ErrorType` silently (`suppressed_cascade == 1`)
//   without emitting secondary `AX_TYP_MISMATCH` noise.
// - Independent functions in the same module continue analysis and report genuine errors.
// - Legal runtime recursion and pointer-indirection structs do NOT trigger cycle errors.

const TY_ERR: u32 = 4294967295u32;

@derive(Copy)
struct SigState {
    ret_ty: u32,
    is_poisoned: bool,
}

@derive(Copy)
struct BodyCheckResult {
    inferred_ty: u32,
    emitted_mismatch: u32,
    suppressed_cascade: u32,
}

fn check_fn_body(callee_sig: SigState, has_local_mismatch: bool) -> BodyCheckResult {
    // AXS-QRY-031: suppress secondary type-mismatch diagnostics when an input is poisoned
    if callee_sig.is_poisoned || callee_sig.ret_ty == TY_ERR {
        return BodyCheckResult {
            inferred_ty: TY_ERR,
            emitted_mismatch: 0u32,
            suppressed_cascade: 1u32,
        };
    }
    if has_local_mismatch {
        return BodyCheckResult {
            inferred_ty: TY_ERR,
            emitted_mismatch: 1u32,
            suppressed_cascade: 0u32,
        };
    }
    BodyCheckResult {
        inferred_ty: callee_sig.ret_ty,
        emitted_mismatch: 0u32,
        suppressed_cascade: 0u32,
    }
}

fn layout_struct(base_size: u32, ptr_width: u32, indirection_fields: u32, value_self_edge: bool) -> u32 {
    if value_self_edge {
        return TY_ERR;
    }
    base_size + (ptr_width * indirection_fields)
}

pub fn main() -> i32 {
    // 1. Recursive type alias cycle `type Foo = Bar; type Bar = Foo` recovers with ErrorType
    let poisoned_alias_sig = SigState { ret_ty: TY_ERR, is_poisoned: true };

    // Downstream caller `fn use_foo(x: Foo)` has a local type mismatch against `Foo`,
    // which MUST be suppressed because `Foo` is `ErrorType`
    let caller_res = check_fn_body(poisoned_alias_sig, true);
    if caller_res.emitted_mismatch != 0u32 || caller_res.suppressed_cascade != 1u32 {
        return 1;
    }

    // Independent function `fn indep() -> i32` in the same module has a genuine mismatch
    let valid_callee_sig = SigState { ret_ty: 1u32, is_poisoned: false };
    let indep_res = check_fn_body(valid_callee_sig, true);
    if indep_res.emitted_mismatch != 1u32 || indep_res.suppressed_cascade != 0u32 {
        return 2;
    }

    // 2. Legal recursive struct behind pointer indirection (`struct Node { val: i64, next: *Node }`)
    // vs illegal value-sized recursive struct (`struct BadNode { val: i64, next: BadNode }`)
    let legal_node_size = layout_struct(8u32, 8u32, 1u32, false);
    let illegal_node_size = layout_struct(8u32, 8u32, 0u32, true);
    if legal_node_size != 16u32 || illegal_node_size != TY_ERR {
        return 3;
    }

    print("CASCADE-SUPPRESSION-RECOVERY-OK\n");
    0
}
