// test: run
// modes: interp native
// stdout-file: depth_limit_and_disambiguator_tiebreak.stdout
// SPEC-21 AXS-QRY-003, AXS-QRY-021..023, AXS-QRY-032:
// Boundary cross-check:
// 1. SemanticKey tie-breaking on (disambiguator_index, canonical_type_args) across all 4 entry
//    orders of a 4-node cycle, plus 1-node self-loop canonicalization (`steps == 2`).
// 2. Exact `CyclePolicy.DepthLimited` boundary (`depth == max_depth - 1` succeeds vs
//    `depth == max_depth` triggers `AX_QUERY_DEPTH_LIMIT` and `TRAIT_RESULT_ERROR`).
// 3. Unchanged `ContentHash` on input update (`AXS-QRY-032 §2`) increments `RevisionId`
//    without dirtying derived slots.

const DIAG_NONE: u32 = 0u32;
const DIAG_AX_QUERY_DEPTH_LIMIT: u32 = 9205u32;
const TRAIT_IMPLEMENTED: u32 = 1u32;
const TRAIT_ERROR: u32 = 4u32;

@derive(Copy)
struct FullSemKey {
    pkg_hash: u64,
    mod_hash: u64,
    name_hash: u64,
    type_args_hash: u64,
    kind_rank: u32,
    ns: u32,
    disambiguator: u32,
    id: u32,
}

@derive(Copy)
struct CycleSteps5 {
    items: [5]FullSemKey,
    step_count: u32,
}

fn full_sem_key_cmp(a: FullSemKey, b: FullSemKey) -> i32 {
    if (a.kind_rank) < (b.kind_rank) { return -1; }
    if (a.kind_rank) > (b.kind_rank) { return 1; }
    if (a.pkg_hash) < (b.pkg_hash) { return -1; }
    if (a.pkg_hash) > (b.pkg_hash) { return 1; }
    if (a.mod_hash) < (b.mod_hash) { return -1; }
    if (a.mod_hash) > (b.mod_hash) { return 1; }
    if (a.ns) < (b.ns) { return -1; }
    if (a.ns) > (b.ns) { return 1; }
    if (a.disambiguator) < (b.disambiguator) { return -1; }
    if (a.disambiguator) > (b.disambiguator) { return 1; }
    if (a.name_hash) < (b.name_hash) { return -1; }
    if (a.name_hash) > (b.name_hash) { return 1; }
    if (a.type_args_hash) < (b.type_args_hash) { return -1; }
    if (a.type_args_hash) > (b.type_args_hash) { return 1; }
    0
}

fn mix64(seed: u64, val: u64) -> u64 {
    let mut x = seed ^ (val << 13u64) ^ (seed >> 7u64) ^ 0x9E3779B97F4A7C15u64;
    x = x ^ (x >> 17u64) ^ (val >> 3u64);
    x ^ (x << 5u64)
}

fn rotate_cycle_4(k0: FullSemKey, k1: FullSemKey, k2: FullSemKey, k3: FullSemKey, cycle_len: usize, out: mut_view<CycleSteps5>) -> u64 {
    let raw: [4]FullSemKey = [k0, k1, k2, k3];
    let mut min_idx: usize = 0;
    let mut min_k: FullSemKey = raw[0];
    let mut i: usize = 1;
    while i < cycle_len {
        if full_sem_key_cmp(raw[i], min_k) < 0 {
            min_k = raw[i];
            min_idx = i;
        }
        i = i + 1;
    }
    let mut fp: u64 = mix64(0x4359434C455F5254u64, cycle_len as u64);
    let mut j: usize = 0;
    while j <= cycle_len {
        let idx = if j == cycle_len { min_idx } else { (min_idx + j) % cycle_len };
        let step = raw[idx];
        out.items[j] = step;
        fp = mix64(fp, ((step.disambiguator as u64) << 32u64) | (step.id as u64));
        fp = mix64(fp, step.type_args_hash);
        j = j + 1;
    }
    out.step_count = (cycle_len + 1) as u32;
    fp
}

@derive(Copy)
struct DepthEvalOutcome {
    status: u32,
    diag_code: u32,
}

fn eval_trait_chain(chain_len: u32, max_depth: u32) -> DepthEvalOutcome {
    let mut depth: u32 = 0u32;
    while depth < chain_len {
        if depth >= max_depth {
            return DepthEvalOutcome {
                status: TRAIT_ERROR,
                diag_code: DIAG_AX_QUERY_DEPTH_LIMIT,
            };
        }
        depth = depth + 1u32;
    }
    DepthEvalOutcome {
        status: TRAIT_IMPLEMENTED,
        diag_code: DIAG_NONE,
    }
}

fn update_input_noop_check(old_hash: u64, new_hash: u64, dependent_slots: u32) -> u32 {
    // AXS-QRY-032 §2: if ContentHash is unchanged, 0 dependent slots are marked MaybeDirty
    if old_hash == new_hash {
        return 0u32;
    }
    dependent_slots
}

pub fn main() -> i32 {
    // 1. 4-node cycle where package, module, namespace, and item name are identical;
    // tie is broken by (disambiguator, type_args_hash). Unique minimum is k2 (disamb=1, targs=25, id=30).
    let k0 = FullSemKey { pkg_hash: 7u64, mod_hash: 9u64, name_hash: 11u64, type_args_hash: 99u64, kind_rank: 15u32, ns: 4u32, disambiguator: 2u32, id: 10u32 };
    let k1 = FullSemKey { pkg_hash: 7u64, mod_hash: 9u64, name_hash: 11u64, type_args_hash: 50u64, kind_rank: 15u32, ns: 4u32, disambiguator: 1u32, id: 20u32 };
    let k2 = FullSemKey { pkg_hash: 7u64, mod_hash: 9u64, name_hash: 11u64, type_args_hash: 25u64, kind_rank: 15u32, ns: 4u32, disambiguator: 1u32, id: 30u32 };
    let k3 = FullSemKey { pkg_hash: 7u64, mod_hash: 9u64, name_hash: 11u64, type_args_hash: 10u64, kind_rank: 15u32, ns: 4u32, disambiguator: 3u32, id: 40u32 };

    let mut out0 = CycleSteps5 { items: [k0; 5], step_count: 0u32 };
    let mut out1 = CycleSteps5 { items: [k0; 5], step_count: 0u32 };
    let mut out2 = CycleSteps5 { items: [k0; 5], step_count: 0u32 };
    let mut out3 = CycleSteps5 { items: [k0; 5], step_count: 0u32 };

    let fp0 = rotate_cycle_4(k0, k1, k2, k3, 4, mut_view(out0));
    let fp1 = rotate_cycle_4(k1, k2, k3, k0, 4, mut_view(out1));
    let fp2 = rotate_cycle_4(k2, k3, k0, k1, 4, mut_view(out2));
    let fp3 = rotate_cycle_4(k3, k0, k1, k2, 4, mut_view(out3));

    if fp0 != fp1 || fp1 != fp2 || fp2 != fp3 {
        return 1;
    }
    if out0.step_count != 5u32 || out0.items[0].id != 30u32 || out0.items[1].id != 40u32 || out0.items[2].id != 10u32 || out0.items[3].id != 20u32 || out0.items[4].id != 30u32 {
        return 2;
    }

    // 2. 1-node self-loop cycle (`Q_0 -> Q_0` has step_count == 2, head == tail == Q_0)
    let mut out_self = CycleSteps5 { items: [k0; 5], step_count: 0u32 };
    let fp_self = rotate_cycle_4(k2, k0, k0, k0, 1, mut_view(out_self));
    if fp_self == 0u64 || out_self.step_count != 2u32 || out_self.items[0].id != 30u32 || out_self.items[1].id != 30u32 {
        return 3;
    }

    // 3. Exact DepthLimited boundary (max_depth == 3: chain_len 3 -> Ready, chain_len 4 -> Poisoned)
    let ok_at_limit = eval_trait_chain(3u32, 3u32);
    let err_exceeds_limit = eval_trait_chain(4u32, 3u32);
    if ok_at_limit.status != TRAIT_IMPLEMENTED || ok_at_limit.diag_code != DIAG_NONE {
        return 4;
    }
    if err_exceeds_limit.status != TRAIT_ERROR || err_exceeds_limit.diag_code != DIAG_AX_QUERY_DEPTH_LIMIT {
        return 5;
    }

    // 4. Unchanged ContentHash vs changed ContentHash dirty propagation
    let dirtied_same = update_input_noop_check(0xABCD1234u64, 0xABCD1234u64, 9u32);
    let dirtied_diff = update_input_noop_check(0xABCD1234u64, 0xABCD1235u64, 9u32);
    if dirtied_same != 0u32 || dirtied_diff != 9u32 {
        return 6;
    }

    print("DEPTH-LIMIT-AND-TIEBREAK-OK\n");
    0
}
