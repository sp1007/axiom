@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

fn probe_sv(arena: mut_view<Arena>, s: str) -> StrView {
    let raw_sv: StrView = unsafe { *(address_of(s) as *const StrView) };
    let bytes: view<[u8]> = unsafe { *(address_of(s) as *const view<[u8]>) };
    let n = raw_sv.len;
    let dst = arena_alloc_raw(mut_view(*arena), n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = bytes[i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn diag_buf_eq(a: view<DiagBuffer>, b: view<DiagBuffer>) -> bool {
    if a.len != b.len {
        return false;
    }
    let mut i: usize = 0;
    while i < (a.len) {
        let ba = unsafe { *(a.ptr + i) };
        let bb = unsafe { *(b.ptr + i) };
        if ba != bb {
            return false;
        }
        i = i + 1;
    }
    true
}

fn print_diag_buf(b: view<DiagBuffer>) {
    if (b.len) > 0 && (b.ptr as usize) != 0 {
        unsafe {
            let _ = write(stdio(1u32), b.ptr as *const u8, b.len);
        }
    }
}

fn build_cycle_fixture(str_arena: mut_view<Arena>, eng: mut_view<QueryEngine>) {
    let pkg_sv = probe_sv(mut_view(*str_arena), "app");
    let triple_sv = probe_sv(mut_view(*str_arena), "x86_64-windows");
    let abi_sv = probe_sv(mut_view(*str_arena), "win64");

    let mod_a_sv = probe_sv(mut_view(*str_arena), "reex_a");
    let mod_b_sv = probe_sv(mut_view(*str_arena), "reex_b");
    let mod_c_sv = probe_sv(mut_view(*str_arena), "cycles");

    let path_a_sv = probe_sv(mut_view(*str_arena), "src/reex_a.ax");
    let path_b_sv = probe_sv(mut_view(*str_arena), "src/reex_b.ax");
    let path_c_sv = probe_sv(mut_view(*str_arena), "src/cycles.ax");
    let src_stub = probe_sv(mut_view(*str_arena), "// cycle fixture\n");

    let unit = UnitKey { v: 1u32 };
    let pkg = PackageId { v: 1u32 };
    let sf_a = SourceFileId { v: 1u32 };
    let sf_b = SourceFileId { v: 2u32 };
    let sf_c = SourceFileId { v: 3u32 };
    let mod_a = ModuleId { v: 1u32 };
    let mod_b = ModuleId { v: 2u32 };
    let mod_c = ModuleId { v: 3u32 };

    let _ = engine_set_package_graph_input(mut_view(*eng), pkg, pkg_sv, 2026u32, 0u32, 0u64);
    let _ = engine_set_target_config_input(mut_view(*eng), unit, triple_sv, abi_sv, 0u32, 2026u32, 2u8, 8u32);
    let _ = engine_set_source_file_input(mut_view(*eng), sf_a, path_a_sv, src_stub, DURABILITY_LOW);
    let _ = engine_set_source_file_input(mut_view(*eng), sf_b, path_b_sv, src_stub, DURABILITY_LOW);
    let _ = engine_set_source_file_input(mut_view(*eng), sf_c, path_c_sv, src_stub, DURABILITY_LOW);
    let _ = engine_set_module_tree_input(mut_view(*eng), mod_a, pkg, ModuleId { v: 0u32 }, mod_a_sv, sf_a, DURABILITY_MEDIUM);
    let _ = engine_set_module_tree_input(mut_view(*eng), mod_b, pkg, ModuleId { v: 0u32 }, mod_b_sv, sf_b, DURABILITY_MEDIUM);
    let _ = engine_set_module_tree_input(mut_view(*eng), mod_c, pkg, ModuleId { v: 0u32 }, mod_c_sv, sf_c, DURABILITY_MEDIUM);

    // 1. Cyclic module re-exports: reex_a <-> reex_b (AX_QUERY_CYCLE)
    engine_add_module_reexport_dep(mut_view(*eng), mod_a, mod_b);
    engine_add_module_reexport_dep(mut_view(*eng), mod_b, mod_a);

    // 2. 3-node mutually recursive const cycle: C1 (1) -> C2 (2) -> C3 (3) -> C1 (AX_CTM_CYCLE)
    let sk_c1 = semantic_key_new(pkg_sv, mod_c_sv, ITEM_NS_CONST, 0u32, probe_sv(mut_view(*str_arena), "C1"), qry_sv_empty());
    let sk_c2 = semantic_key_new(pkg_sv, mod_c_sv, ITEM_NS_CONST, 0u32, probe_sv(mut_view(*str_arena), "C2"), qry_sv_empty());
    let sk_c3 = semantic_key_new(pkg_sv, mod_c_sv, ITEM_NS_CONST, 0u32, probe_sv(mut_view(*str_arena), "C3"), qry_sv_empty());

    let _ = query_db_register_def(mut_view(eng.db), DefId { v: 1u32 }, mod_c, ITEM_KIND_CONST, true, 0u32, 1u32, sk_c1);
    let _ = query_db_register_def(mut_view(eng.db), DefId { v: 2u32 }, mod_c, ITEM_KIND_CONST, true, 0u32, 1u32, sk_c2);
    let _ = query_db_register_def(mut_view(eng.db), DefId { v: 3u32 }, mod_c, ITEM_KIND_CONST, true, 0u32, 1u32, sk_c3);
    query_db_add_body_const_dep(mut_view(eng.db), DefId { v: 1u32 }, ConstEvalKey { v: 2u32 });
    query_db_add_body_const_dep(mut_view(eng.db), DefId { v: 2u32 }, ConstEvalKey { v: 3u32 });
    query_db_add_body_const_dep(mut_view(eng.db), DefId { v: 3u32 }, ConstEvalKey { v: 1u32 });

    // 3. 2-node recursive type alias cycle: AliasX (4) <-> AliasY (5) (AX_TYPE_CYCLE)
    let sk_ax = semantic_key_new(pkg_sv, mod_c_sv, ITEM_NS_TYPE, 0u32, probe_sv(mut_view(*str_arena), "AliasX"), qry_sv_empty());
    let sk_ay = semantic_key_new(pkg_sv, mod_c_sv, ITEM_NS_TYPE, 0u32, probe_sv(mut_view(*str_arena), "AliasY"), qry_sv_empty());
    let _ = query_db_register_def(mut_view(eng.db), DefId { v: 4u32 }, mod_c, ITEM_KIND_TYPE_ALIAS, true, 0u32, 4u32, sk_ax);
    let _ = query_db_register_def(mut_view(eng.db), DefId { v: 5u32 }, mod_c, ITEM_KIND_TYPE_ALIAS, true, 0u32, 5u32, sk_ay);
    query_db_add_sig_dep(mut_view(eng.db), DefId { v: 4u32 }, DefId { v: 5u32 });
    query_db_add_sig_dep(mut_view(eng.db), DefId { v: 5u32 }, DefId { v: 4u32 });

    // 4. 2-node cyclic trait obligations: GoalA#1 <-> GoalB#2 (AX_TRAIT_CYCLE)
    let sk_tr = semantic_key_new(pkg_sv, mod_c_sv, ITEM_NS_TRAIT, 0u32, probe_sv(mut_view(*str_arena), " CopyTrait"), qry_sv_empty());
    let _ = query_db_register_def(mut_view(eng.db), DefId { v: 6u32 }, mod_c, ITEM_KIND_TRAIT, true, 0u32, 1u32, sk_tr);
    let sk_ga = semantic_key_new(pkg_sv, mod_c_sv, ITEM_NS_TRAIT, 1u32, probe_sv(mut_view(*str_arena), "GoalA"), qry_sv_empty());
    let sk_gb = semantic_key_new(pkg_sv, mod_c_sv, ITEM_NS_TRAIT, 2u32, probe_sv(mut_view(*str_arena), "GoalB"), qry_sv_empty());
    query_db_register_trait_goal(mut_view(eng.db), TraitGoalKey { v: 1u32 }, DefId { v: 6u32 }, TypeId { v: 1u32 }, TraitGoalKey { v: 2u32 }, sk_ga);
    query_db_register_trait_goal(mut_view(eng.db), TraitGoalKey { v: 2u32 }, DefId { v: 6u32 }, TypeId { v: 2u32 }, TraitGoalKey { v: 1u32 }, sk_gb);

    // 5. Value-sized recursive struct layout (BadNode, TypeId 7) vs Legal pointer-indirection struct (LegalNode, TypeId 8)
    let sk_bad_node = semantic_key_new(pkg_sv, mod_c_sv, ITEM_NS_TYPE, 0u32, probe_sv(mut_view(*str_arena), "BadNode"), qry_sv_empty());
    let sk_legal_node = semantic_key_new(pkg_sv, mod_c_sv, ITEM_NS_TYPE, 0u32, probe_sv(mut_view(*str_arena), "LegalNode"), qry_sv_empty());
    let _ = query_db_register_def(mut_view(eng.db), DefId { v: 7u32 }, mod_c, ITEM_KIND_STRUCT, true, 0u32, 7u32, sk_bad_node);
    query_db_register_type_layout(mut_view(eng.db), TypeId { v: 7u32 }, DefId { v: 7u32 }, unit, 8u32, 8u32, false, sk_bad_node);
    query_db_add_type_layout_field(mut_view(eng.db), TypeId { v: 7u32 }, TypeId { v: 7u32 });

    query_db_register_type_layout(mut_view(eng.db), TypeId { v: 8u32 }, DefId { v: 7u32 }, unit, 8u32, 8u32, false, sk_legal_node);
    engine_add_type_indirection_field(mut_view(*eng), TypeId { v: 8u32 }, TypeId { v: 8u32 });

    // 6. Legal runtime-recursive function `fn fact(n: i64) -> i64` (DefId 8)
    let sk_fact = semantic_key_new(pkg_sv, mod_c_sv, ITEM_NS_VALUE, 0u32, probe_sv(mut_view(*str_arena), "fact"), qry_sv_empty());
    let _ = query_db_register_def(mut_view(eng.db), DefId { v: 8u32 }, mod_c, ITEM_KIND_FN, true, 1u32, 1u32, sk_fact);
    query_db_add_body_call(mut_view(eng.db), DefId { v: 8u32 }, DefId { v: 8u32 });

    // 7. Downstream caller of poisoned items (`fn caller_of_poisoned`, DefId 9) + independent fn (`fn indep_err`, DefId 10)
    let sk_caller = semantic_key_new(pkg_sv, mod_c_sv, ITEM_NS_VALUE, 0u32, probe_sv(mut_view(*str_arena), "caller_of_poisoned"), qry_sv_empty());
    let sk_indep = semantic_key_new(pkg_sv, mod_c_sv, ITEM_NS_VALUE, 0u32, probe_sv(mut_view(*str_arena), "indep_err"), qry_sv_empty());
    let _ = query_db_register_def(mut_view(eng.db), DefId { v: 9u32 }, mod_c, ITEM_KIND_FN, true, 1u32, 1u32, sk_caller);
    query_db_add_body_call(mut_view(eng.db), DefId { v: 9u32 }, DefId { v: 4u32 });
    query_db_add_body_const_dep(mut_view(eng.db), DefId { v: 9u32 }, ConstEvalKey { v: 1u32 });
    query_db_add_body_layout_dep(mut_view(eng.db), DefId { v: 9u32 }, TypeId { v: 7u32 });
    query_db_set_def_flags(mut_view(eng.db), DefId { v: 9u32 }, false, false, true);

    let _ = query_db_register_def(mut_view(eng.db), DefId { v: 10u32 }, mod_c, ITEM_KIND_FN, true, 1u32, 1u32, sk_indep);
    query_db_add_body_call(mut_view(eng.db), DefId { v: 10u32 }, DefId { v: 8u32 });
    query_db_set_def_flags(mut_view(eng.db), DefId { v: 10u32 }, false, false, true);
}

fn run_test_1_and_2(str_arena: mut_view<Arena>) -> bool {
    let mut eng_a = query_engine_empty();
    let mut eng_b = query_engine_empty();
    let mut eng_c = query_engine_empty();

    query_engine_init(mut_view(eng_a), 101u64);
    query_engine_init(mut_view(eng_b), 102u64);
    query_engine_init(mut_view(eng_c), 103u64);

    build_cycle_fixture(mut_view(*str_arena), mut_view(eng_a));
    build_cycle_fixture(mut_view(*str_arena), mut_view(eng_b));
    build_cycle_fixture(mut_view(*str_arena), mut_view(eng_c));

    // Evaluate cycles in Order A: (reex_a, C1, AliasX, GoalA, BadNode, LegalNode, fact)
    let dm_a = engine_query_module_def_map(mut_view(eng_a), ModuleId { v: 1u32 });
    let ce_c1 = engine_query_const_eval(mut_view(eng_a), ConstEvalKey { v: 1u32 });
    let sig_x = engine_query_item_signature(mut_view(eng_a), DefId { v: 4u32 });
    let tr_g1 = engine_query_trait_solve(mut_view(eng_a), TraitGoalKey { v: 1u32 });
    let lo_bad = engine_query_layout_of(mut_view(eng_a), TypeId { v: 7u32 });
    let lo_legal = engine_query_layout_of(mut_view(eng_a), TypeId { v: 8u32 });
    let tck_fact = engine_query_typeck_body(mut_view(eng_a), DefId { v: 8u32 });

    // Evaluate cycles in Order B: (BadNode, GoalB, AliasY, C2, reex_b, LegalNode, fact)
    let _ = engine_query_layout_of(mut_view(eng_b), TypeId { v: 7u32 });
    let _ = engine_query_trait_solve(mut_view(eng_b), TraitGoalKey { v: 2u32 });
    let _ = engine_query_item_signature(mut_view(eng_b), DefId { v: 5u32 });
    let _ = engine_query_const_eval(mut_view(eng_b), ConstEvalKey { v: 2u32 });
    let _ = engine_query_module_def_map(mut_view(eng_b), ModuleId { v: 2u32 });
    let _ = engine_query_layout_of(mut_view(eng_b), TypeId { v: 8u32 });
    let _ = engine_query_typeck_body(mut_view(eng_b), DefId { v: 8u32 });

    // Evaluate cycles in Order C: (C3, reex_b, AliasY, GoalB, BadNode, fact, LegalNode)
    let _ = engine_query_const_eval(mut_view(eng_c), ConstEvalKey { v: 3u32 });
    let _ = engine_query_module_def_map(mut_view(eng_c), ModuleId { v: 2u32 });
    let _ = engine_query_item_signature(mut_view(eng_c), DefId { v: 5u32 });
    let _ = engine_query_trait_solve(mut_view(eng_c), TraitGoalKey { v: 2u32 });
    let _ = engine_query_layout_of(mut_view(eng_c), TypeId { v: 7u32 });
    let _ = engine_query_typeck_body(mut_view(eng_c), DefId { v: 8u32 });
    let _ = engine_query_layout_of(mut_view(eng_c), TypeId { v: 8u32 });

    let snap_a = engine_capture_snapshot_diags(mut_view(eng_a));
    let snap_b = engine_capture_snapshot_diags(mut_view(eng_b));
    let snap_c = engine_capture_snapshot_diags(mut_view(eng_c));

    let ab_eq = engine_snapshot_diags_equivalent(view(snap_a), view(snap_b));
    let bc_eq = engine_snapshot_diags_equivalent(view(snap_b), view(snap_c));

    // Also verify byte-for-byte identical formatted cycle trace output across all 3 entry orders
    let mut trace_a = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    let mut trace_b = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    let mut trace_c = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(trace_a));
    diag_buf_init(mut_view(trace_b));
    diag_buf_init(mut_view(trace_c));
    engine_emit_cycle_traces(view(eng_a), mut_view(trace_a));
    engine_emit_cycle_traces(view(eng_b), mut_view(trace_b));
    engine_emit_cycle_traces(view(eng_c), mut_view(trace_c));
    let traces_identical = diag_buf_eq(view(trace_a), view(trace_b)) && diag_buf_eq(view(trace_b), view(trace_c));
    print_diag_buf(view(trace_a));
    diag_buf_free(mut_view(trace_a));
    diag_buf_free(mut_view(trace_b));
    diag_buf_free(mut_view(trace_c));

    let scc_a = engine_compute_tarjan_sccs(mut_view(eng_a));
    let scc_b = engine_compute_tarjan_sccs(mut_view(eng_b));
    let mut sccs_match = scc_a == 5u32 && scc_b == 5u32;
    let mut si: u32 = 0u32;
    while si < scc_a && si < scc_b {
        let sa = engine_get_tarjan_scc(view(eng_a), si);
        let sb = engine_get_tarjan_scc(view(eng_b), si);
        if !fingerprint128_eq(sa.scc_fingerprint, sb.scc_fingerprint) {
            sccs_match = false;
        }
        si = si + 1u32;
    }

    let mut scc_buf = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(scc_buf));
    engine_emit_tarjan_sccs(view(eng_a), mut_view(scc_buf));
    print_diag_buf(view(scc_buf));
    diag_buf_free(mut_view(scc_buf));

    let fallbacks_ok = engine_def_map_is_error(view(dm_a)) &&
        engine_const_is_poisoned(view(ce_c1)) &&
        engine_sig_is_poisoned(view(sig_x)) &&
        engine_trait_is_error(view(tr_g1)) &&
        engine_layout_is_poisoned(view(lo_bad)) &&
        !engine_layout_is_poisoned(view(lo_legal)) &&
        lo_legal.size_bytes == 16u32 &&
        !tck_fact.is_error;

    // Test 2: Cascading error suppression on `caller_of_poisoned` (DefId 9) vs `indep_err` (DefId 10)
    engine_reset_active_diagnostics(mut_view(eng_a));
    let tck_caller = engine_query_typeck_body(mut_view(eng_a), DefId { v: 9u32 });
    let mir_caller = engine_query_mir_body(mut_view(eng_a), DefId { v: 9u32 });
    let caller_mismatch_count = engine_count_emitted_diag_code(view(eng_a), DIAG_AX_TYP_MISMATCH);
    let cascades_after_caller = eng_a.suppressed_cascades;

    let tck_indep = engine_query_typeck_body(mut_view(eng_a), DefId { v: 10u32 });
    let indep_mismatch_count = engine_count_emitted_diag_code(view(eng_a), DIAG_AX_TYP_MISMATCH);

    let mut diag_buf = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(diag_buf));
    engine_emit_diagnostics(view(eng_a), mut_view(diag_buf));
    print_diag_buf(view(diag_buf));
    diag_buf_free(mut_view(diag_buf));

    let cascade_ok = tck_caller.is_error &&
        engine_mir_is_poisoned(view(mir_caller)) &&
        caller_mismatch_count == 0u32 &&
        cascades_after_caller == 1u32 &&
        tck_indep.is_error &&
        indep_mismatch_count == 1u32;

    query_engine_free(mut_view(eng_a));
    query_engine_free(mut_view(eng_b));
    query_engine_free(mut_view(eng_c));

    ab_eq && bc_eq && traces_identical && sccs_match && fallbacks_ok && cascade_ok
}

fn run_test_3_depth_and_warm_replay(str_arena: mut_view<Arena>) -> bool {
    let mut eng = query_engine_empty();
    query_engine_init(mut_view(eng), 201u64);
    eng.db.max_query_depth = 3u32;

    let pkg_sv = probe_sv(mut_view(*str_arena), "pkg");
    let mod_sv = probe_sv(mut_view(*str_arena), "traits");
    let path_sv = probe_sv(mut_view(*str_arena), "src/traits.ax");
    let src_sv = probe_sv(mut_view(*str_arena), "module traits\n");
    let triple_sv = probe_sv(mut_view(*str_arena), "x86_64-windows");
    let abi_sv = probe_sv(mut_view(*str_arena), "win64");

    let _ = engine_set_package_graph_input(mut_view(eng), PackageId { v: 1u32 }, pkg_sv, 2026u32, 0u32, 0u64);
    let _ = engine_set_target_config_input(mut_view(eng), UnitKey { v: 1u32 }, triple_sv, abi_sv, 0u32, 2026u32, 2u8, 8u32);
    let _ = engine_set_source_file_input(mut_view(eng), SourceFileId { v: 1u32 }, path_sv, src_sv, DURABILITY_LOW);
    let _ = engine_set_module_tree_input(mut_view(eng), ModuleId { v: 1u32 }, PackageId { v: 1u32 }, ModuleId { v: 0u32 }, mod_sv, SourceFileId { v: 1u32 }, DURABILITY_MEDIUM);

    let sk_tr = semantic_key_new(pkg_sv, mod_sv, ITEM_NS_TRAIT, 0u32, probe_sv(mut_view(*str_arena), "Deep"), qry_sv_empty());
    let _ = query_db_register_def(mut_view(eng.db), DefId { v: 1u32 }, ModuleId { v: 1u32 }, ITEM_KIND_TRAIT, true, 0u32, 1u32, sk_tr);

    // 4-step trait chain exceeding max_query_depth == 3 -> AX_QUERY_DEPTH_LIMIT
    let sk_g1 = semantic_key_new(pkg_sv, mod_sv, ITEM_NS_TRAIT, 1u32, probe_sv(mut_view(*str_arena), "Deep"), qry_sv_empty());
    let sk_g2 = semantic_key_new(pkg_sv, mod_sv, ITEM_NS_TRAIT, 2u32, probe_sv(mut_view(*str_arena), "Deep"), qry_sv_empty());
    let sk_g3 = semantic_key_new(pkg_sv, mod_sv, ITEM_NS_TRAIT, 3u32, probe_sv(mut_view(*str_arena), "Deep"), qry_sv_empty());
    let sk_g4 = semantic_key_new(pkg_sv, mod_sv, ITEM_NS_TRAIT, 4u32, probe_sv(mut_view(*str_arena), "Deep"), qry_sv_empty());
    query_db_register_trait_goal(mut_view(eng.db), TraitGoalKey { v: 1u32 }, DefId { v: 1u32 }, TypeId { v: 1u32 }, TraitGoalKey { v: 2u32 }, sk_g1);
    query_db_register_trait_goal(mut_view(eng.db), TraitGoalKey { v: 2u32 }, DefId { v: 1u32 }, TypeId { v: 2u32 }, TraitGoalKey { v: 3u32 }, sk_g2);
    query_db_register_trait_goal(mut_view(eng.db), TraitGoalKey { v: 3u32 }, DefId { v: 1u32 }, TypeId { v: 3u32 }, TraitGoalKey { v: 4u32 }, sk_g3);
    query_db_register_trait_goal(mut_view(eng.db), TraitGoalKey { v: 4u32 }, DefId { v: 1u32 }, TypeId { v: 4u32 }, TraitGoalKey { v: 0u32 }, sk_g4);

    let cold_tr = engine_query_trait_solve(mut_view(eng), TraitGoalKey { v: 1u32 });
    let cold_depth_diags = engine_count_emitted_diag_code(view(eng), DIAG_AX_QUERY_DEPTH_LIMIT);
    let snap_cold = engine_capture_snapshot_diags(mut_view(eng));

    // Clear active diagnostics and re-query warm memoized slot
    engine_reset_active_diagnostics(mut_view(eng));
    let warm_tr = engine_query_trait_solve(mut_view(eng), TraitGoalKey { v: 1u32 });
    let warm_depth_diags = engine_count_emitted_diag_code(view(eng), DIAG_AX_QUERY_DEPTH_LIMIT);
    let snap_warm = engine_capture_snapshot_diags(mut_view(eng));

    let ok = engine_trait_is_error(view(cold_tr)) &&
        engine_trait_is_error(view(warm_tr)) &&
        cold_depth_diags == 1u32 &&
        warm_depth_diags == 1u32 &&
        eng.warm_diag_replays >= 1u32 &&
        engine_snapshot_diags_equivalent(view(snap_cold), view(snap_warm));

    query_engine_free(mut_view(eng));
    ok
}

fn run_test_4_invalidation_and_cycle_fix(str_arena: mut_view<Arena>) -> bool {
    let mut eng = query_engine_empty();
    query_engine_init(mut_view(eng), 301u64);

    let pkg_sv = probe_sv(mut_view(*str_arena), "pkg");
    let mod_cyc_sv = probe_sv(mut_view(*str_arena), "cyc");
    let mod_other_sv = probe_sv(mut_view(*str_arena), "other");
    let path_cyc_sv = probe_sv(mut_view(*str_arena), "src/cyc.ax");
    let path_other_sv = probe_sv(mut_view(*str_arena), "src/other.ax");
    let triple_sv = probe_sv(mut_view(*str_arena), "x86_64-windows");
    let abi_sv = probe_sv(mut_view(*str_arena), "win64");

    let sf_cyc = SourceFileId { v: 1u32 };
    let sf_other = SourceFileId { v: 2u32 };
    let mod_cyc = ModuleId { v: 1u32 };
    let mod_other = ModuleId { v: 2u32 };

    let _ = engine_set_package_graph_input(mut_view(eng), PackageId { v: 1u32 }, pkg_sv, 2026u32, 0u32, 0u64);
    let _ = engine_set_target_config_input(mut_view(eng), UnitKey { v: 1u32 }, triple_sv, abi_sv, 0u32, 2026u32, 2u8, 8u32);
    let _ = engine_set_source_file_input(mut_view(eng), sf_cyc, path_cyc_sv, probe_sv(mut_view(*str_arena), "// v1 cyc\n"), DURABILITY_LOW);
    let _ = engine_set_source_file_input(mut_view(eng), sf_other, path_other_sv, probe_sv(mut_view(*str_arena), "// v1 other\n"), DURABILITY_LOW);
    let _ = engine_set_module_tree_input(mut_view(eng), mod_cyc, PackageId { v: 1u32 }, ModuleId { v: 0u32 }, mod_cyc_sv, sf_cyc, DURABILITY_MEDIUM);
    let _ = engine_set_module_tree_input(mut_view(eng), mod_other, PackageId { v: 1u32 }, ModuleId { v: 0u32 }, mod_other_sv, sf_other, DURABILITY_MEDIUM);

    let sk_ca = semantic_key_new(pkg_sv, mod_cyc_sv, ITEM_NS_CONST, 0u32, probe_sv(mut_view(*str_arena), "CA"), qry_sv_empty());
    let sk_cb = semantic_key_new(pkg_sv, mod_cyc_sv, ITEM_NS_CONST, 0u32, probe_sv(mut_view(*str_arena), "CB"), qry_sv_empty());
    let sk_co = semantic_key_new(pkg_sv, mod_other_sv, ITEM_NS_CONST, 0u32, probe_sv(mut_view(*str_arena), "CO"), qry_sv_empty());

    let def_ca = DefId { v: 1u32 };
    let def_cb = DefId { v: 2u32 };
    let def_co = DefId { v: 3u32 };
    let _ = query_db_register_def(mut_view(eng.db), def_ca, mod_cyc, ITEM_KIND_CONST, true, 0u32, 1u32, sk_ca);
    let _ = query_db_register_def(mut_view(eng.db), def_cb, mod_cyc, ITEM_KIND_CONST, true, 0u32, 1u32, sk_cb);
    let _ = query_db_register_def(mut_view(eng.db), def_co, mod_other, ITEM_KIND_CONST, true, 0u32, 1u32, sk_co);
    query_db_set_def_seeds(mut_view(eng.db), def_ca, 101u64, 201u64, 10i64);
    query_db_set_def_seeds(mut_view(eng.db), def_cb, 102u64, 202u64, 20i64);
    query_db_set_def_seeds(mut_view(eng.db), def_co, 103u64, 203u64, 5i64);

    query_db_add_body_const_dep(mut_view(eng.db), def_ca, ConstEvalKey { v: 2u32 });
    query_db_add_body_const_dep(mut_view(eng.db), def_cb, ConstEvalKey { v: 1u32 });

    // Initial evaluation: CA is poisoned by cycle CA <-> CB; CO is Ready (5)
    let ca_r1 = engine_query_const_eval(mut_view(eng), ConstEvalKey { v: 1u32 });
    let co_r1 = engine_query_const_eval(mut_view(eng), ConstEvalKey { v: 3u32 });
    let snap_r1 = engine_capture_snapshot_diags(mut_view(eng));

    // Edit unrelated sf_other -> CA is outside dirty cone and green-reuses its poisoned diagnostic
    let _ = engine_set_source_file_input(mut_view(eng), sf_other, path_other_sv, probe_sv(mut_view(*str_arena), "// v2 other\n"), DURABILITY_LOW);
    let ca_r2 = engine_query_const_eval(mut_view(eng), ConstEvalKey { v: 1u32 });
    let co_r2 = engine_query_const_eval(mut_view(eng), ConstEvalKey { v: 3u32 });
    let snap_r2 = engine_capture_snapshot_diags(mut_view(eng));
    let r2_green_ok = engine_const_is_poisoned(view(ca_r2)) &&
        !engine_const_is_poisoned(view(co_r2)) &&
        engine_snapshot_diags_equivalent(view(snap_r1), view(snap_r2)) &&
        eng.db.total_green_reuses >= 1u32 &&
        eng.backdated_verifications >= 1u32;

    // Fix the cycle in mod_cyc by removing CB -> CA dependency and updating sf_cyc
    engine_clear_def_deps(mut_view(eng), def_cb);
    let _ = engine_set_source_file_input(mut_view(eng), sf_cyc, path_cyc_sv, probe_sv(mut_view(*str_arena), "// v2 cyc fixed\n"), DURABILITY_LOW);
    let ca_r3 = engine_query_const_eval(mut_view(eng), ConstEvalKey { v: 1u32 });
    let cb_r3 = engine_query_const_eval(mut_view(eng), ConstEvalKey { v: 2u32 });
    let r3_ctm_diags = engine_count_emitted_diag_code(view(eng), DIAG_AX_CTM_CYCLE);

    let mut sum_buf = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(sum_buf));
    engine_emit_summary(view(eng), mut_view(sum_buf));
    print_diag_buf(view(sum_buf));
    diag_buf_free(mut_view(sum_buf));

    let r3_fixed_ok = engine_const_is_poisoned(view(ca_r1)) &&
        !engine_const_is_poisoned(view(co_r1)) &&
        !engine_const_is_poisoned(view(ca_r3)) &&
        !engine_const_is_poisoned(view(cb_r3)) &&
        ca_r3.int_val == 30i64 &&
        cb_r3.int_val == 20i64 &&
        r3_ctm_diags == 0u32 &&
        eng.total_slots_dirtied > 0u32;

    query_engine_free(mut_view(eng));
    r2_green_ok && r3_fixed_ok
}

pub fn main() -> i32 {
    let mut str_arena = arena_new();
    let ok12 = run_test_1_and_2(mut_view(str_arena));
    if !ok12 {
        arena_destroy(mut_view(str_arena));
        return 1;
    }
    let ok3 = run_test_3_depth_and_warm_replay(mut_view(str_arena));
    if !ok3 {
        arena_destroy(mut_view(str_arena));
        return 2;
    }
    let ok4 = run_test_4_invalidation_and_cycle_fix(mut_view(str_arena));
    if !ok4 {
        arena_destroy(mut_view(str_arena));
        return 3;
    }
    arena_destroy(mut_view(str_arena));
    print("QUERY-CYCLES-PROBE-PASS\n");
    0
}
