// test: run
// modes: interp native
// stdout-file: snapshot_diag_invalidation.stdout
// SPEC-21 AXS-QRY-030, AXS-QRY-032..033:
// Verify snapshot-bound diagnostic accumulation & warm-hit replay (`AXS-QRY-030`)
// and input-revision invalidation + shallow verification (`AXS-QRY-032..033`).

const STATE_READY: u8 = 2u8;
const STATE_MAYBE_DIRTY: u8 = 3u8;
const STATE_POISONED: u8 = 4u8;

@derive(Copy)
struct SlotModel {
    state: u8,
    verified_rev: u32,
    changed_rev: u32,
    diag_fp: u64,
    value_tag: i64,
}

fn eval_or_replay(slot: mut_view<SlotModel>, cur_rev: u32, cycle_broken: bool, warm_replays: mut_view<u32>) -> u64 {
    // Warm hit in same revision: replay attached diagnostic deterministically
    if (slot.state == STATE_READY || slot.state == STATE_POISONED) && slot.verified_rev == cur_rev {
        if slot.diag_fp != 0u64 {
            *warm_replays = *warm_replays + 1u32;
        }
        return slot.diag_fp;
    }

    // Untouched slot across revision (outside dirty cone): green reuse + replay
    if slot.state == STATE_POISONED && (slot.verified_rev) < cur_rev {
        slot.verified_rev = cur_rev;
        if slot.diag_fp != 0u64 {
            *warm_replays = *warm_replays + 1u32;
        }
        return slot.diag_fp;
    }

    // MaybeDirty re-evaluation after input revision change
    if cycle_broken {
        slot.state = STATE_READY;
        slot.verified_rev = cur_rev;
        slot.changed_rev = cur_rev;
        slot.diag_fp = 0u64;
        slot.value_tag = 42i64;
        return 0u64;
    }

    slot.state = STATE_POISONED;
    slot.verified_rev = cur_rev;
    slot.changed_rev = cur_rev;
    slot.diag_fp = 0xC74CC74Cu64;
    slot.value_tag = 0i64;
    slot.diag_fp
}

pub fn main() -> i32 {
    let mut slot = SlotModel {
        state: STATE_MAYBE_DIRTY,
        verified_rev: 0u32,
        changed_rev: 0u32,
        diag_fp: 0u64,
        value_tag: 0i64,
    };
    let mut warm_replays: u32 = 0u32;

    // R1 cold evaluation with cycle active
    let fp_r1_cold = eval_or_replay(mut_view(slot), 1u32, false, mut_view(warm_replays));
    // R1 warm memo hit: must replay the exact same diagnostic fingerprint
    let fp_r1_warm = eval_or_replay(mut_view(slot), 1u32, false, mut_view(warm_replays));

    // R2 unrelated input change: slot is NOT marked MaybeDirty -> green reuse + replay
    let fp_r2_green = eval_or_replay(mut_view(slot), 2u32, false, mut_view(warm_replays));

    // R3 upstream source file edit breaks the cycle -> slot marked MaybeDirty -> Ready
    slot.state = STATE_MAYBE_DIRTY;
    let fp_r3_fixed = eval_or_replay(mut_view(slot), 3u32, true, mut_view(warm_replays));

    if fp_r1_cold != fp_r1_warm || fp_r1_warm != fp_r2_green || fp_r1_cold == 0u64 {
        return 1;
    }
    if warm_replays != 2u32 || slot.state != STATE_READY || fp_r3_fixed != 0u64 || slot.value_tag != 42i64 {
        return 2;
    }

    print("SNAPSHOT-DIAG-INVALIDATION-OK\n");
    0
}
