// test: run
// modes: interp native
// stdout-file: canonical_cycle_rotation.stdout
// SPEC-21 AXS-QRY-020..022, INV-QRY-002:
// Any cycle `Q_0 -> Q_1 -> ... -> Q_{m-1} -> Q_0` is rotated to start at the unique
// minimum `(QueryKind.order_rank, SemanticKey)` regardless of entry query order,
// and Tarjan SCC discovery produces identical canonical SCCs.

@derive(Copy)
struct QKey {
    kind: u16,
    rank: u16,
    item_hash: u64,
    id: u32,
}

@derive(Copy)
struct RotatedSteps {
    items: [4]QKey,
}

fn qkey_cmp(a: QKey, b: QKey) -> i32 {
    if (a.rank) < (b.rank) { return -1; }
    if (a.rank) > (b.rank) { return 1; }
    if (a.item_hash) < (b.item_hash) { return -1; }
    if (a.item_hash) > (b.item_hash) { return 1; }
    if (a.id) < (b.id) { return -1; }
    if (a.id) > (b.id) { return 1; }
    0
}

fn mix64(seed: u64, val: u64) -> u64 {
    let mut x = seed ^ (val << 13u64) ^ (seed >> 7u64) ^ 0x9E3779B97F4A7C15u64;
    x = x ^ (x >> 17u64) ^ (val >> 3u64);
    x ^ (x << 5u64)
}

fn rotate_cycle_3(k0: QKey, k1: QKey, k2: QKey, out: mut_view<RotatedSteps>) -> u64 {
    let raw: [3]QKey = [k0, k1, k2];
    let mut min_idx: usize = 0;
    let mut min_k: QKey = raw[0];
    let mut i: usize = 1;
    while i < 3 {
        if qkey_cmp(raw[i], min_k) < 0 {
            min_k = raw[i];
            min_idx = i;
        }
        i = i + 1;
    }
    let mut fp: u64 = 0x4359434C455F5254u64;
    let mut j: usize = 0;
    while j < 4 {
        let idx = if j == 3 { min_idx } else { (min_idx + j) % 3 };
        let step = raw[idx];
        out.items[j] = step;
        fp = mix64(fp, ((step.kind as u64) << 32u64) | (step.id as u64));
        fp = mix64(fp, step.item_hash);
        j = j + 1;
    }
    fp
}

pub fn main() -> i32 {
    // 3-node mutually recursive const cycle: A (hash 100) -> B (hash 200) -> C (hash 300) -> A
    let k_a = QKey { kind: 8u16, rank: 8u16, item_hash: 100u64, id: 1u32 };
    let k_b = QKey { kind: 8u16, rank: 8u16, item_hash: 200u64, id: 2u32 };
    let k_c = QKey { kind: 8u16, rank: 8u16, item_hash: 300u64, id: 3u32 };

    let mut rot_from_a = RotatedSteps { items: [k_a; 4] };
    let mut rot_from_b = RotatedSteps { items: [k_a; 4] };
    let mut rot_from_c = RotatedSteps { items: [k_a; 4] };

    // Entry from A: stack is [A, B, C]
    let fp_a = rotate_cycle_3(k_a, k_b, k_c, mut_view(rot_from_a));
    // Entry from B: stack is [B, C, A]
    let fp_b = rotate_cycle_3(k_b, k_c, k_a, mut_view(rot_from_b));
    // Entry from C: stack is [C, A, B]
    let fp_c = rotate_cycle_3(k_c, k_a, k_b, mut_view(rot_from_c));

    if fp_a != fp_b || fp_b != fp_c {
        return 1;
    }
    let mut s: usize = 0;
    while s < 4 {
        if rot_from_a.items[s].id != rot_from_b.items[s].id || rot_from_b.items[s].id != rot_from_c.items[s].id {
            return 2;
        }
        s = s + 1;
    }
    if rot_from_a.items[0].id != 1u32 || rot_from_a.items[1].id != 2u32 || rot_from_a.items[2].id != 3u32 || rot_from_a.items[3].id != 1u32 {
        return 3;
    }

    // Cross-kind cycle: item_signature(rank 5) -> typeck_body(rank 6) -> const_eval(rank 8)
    let k_sig = QKey { kind: 5u16, rank: 5u16, item_hash: 900u64, id: 10u32 };
    let k_tck = QKey { kind: 6u16, rank: 6u16, item_hash: 50u64, id: 11u32 };
    let k_cev = QKey { kind: 8u16, rank: 8u16, item_hash: 10u64, id: 12u32 };

    let mut rot_cross_1 = RotatedSteps { items: [k_sig; 4] };
    let mut rot_cross_2 = RotatedSteps { items: [k_sig; 4] };
    let fp_x1 = rotate_cycle_3(k_tck, k_cev, k_sig, mut_view(rot_cross_1));
    let fp_x2 = rotate_cycle_3(k_cev, k_sig, k_tck, mut_view(rot_cross_2));

    if fp_x1 != fp_x2 || rot_cross_1.items[0].kind != 5u16 || rot_cross_1.items[3].kind != 5u16 {
        return 4;
    }

    print("CANONICAL-CYCLE-ROTATION-OK\n");
    0
}
