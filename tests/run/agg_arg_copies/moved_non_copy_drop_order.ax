// test: run
// exit: 0
// stdout: in_one:44\ndrop:10\nafter_one:44\ndrop:22\ndrop:21\nafter_two:11\ndrop:99\nin_one:53\ndrop:31\nafter_cond1\nskip_cond2\ndrop:32\ndone\n
// T498h: Moved non-Copy large aggregates pass without caller copy while preserving
// exact single-drop semantics and LIFO Drop order across register and stack arguments.

struct Guard {
    id: i32,
}

impl Drop for Guard {
    fn drop(self: mut_view<Guard>) {
        print("drop:");
        print_int(self.id as i64);
        print("\n");
    }
}

struct Packet {
    g: Guard,
    buf: [65536]u8,
}

fn consume_one(mut p: Packet) -> i32 {
    p.buf[0] = 40u8;
    let sum: i32 = (p.buf[0] as i32) + (p.buf[65535] as i32);
    print("in_one:");
    print_int(sum as i64);
    print("\n");
    sum
}

fn consume_reg_and_stack(a: Packet, s0: i32, s1: i32, s2: i32, b: Packet) -> i32 {
    (a.buf[0] as i32) + (b.buf[65535] as i32) + s0 + s1 + s2
}

fn run_cond(take: bool, id: i32, fill: u8) {
    let p = Packet { g: Guard { id: id }, buf: [fill; 65536] };
    if take {
        let _ = consume_one(p);
        print("after_cond1\n");
    } else {
        print("skip_cond2\n");
    }
}

fn main() -> i32 {
    let p1 = Packet { g: Guard { id: 10 }, buf: [4u8; 65536] };
    let v1: i32 = consume_one(p1);
    print("after_one:");
    print_int(v1 as i64);
    print("\n");

    {
        let _outer = Guard { id: 99 };
        let pa = Packet { g: Guard { id: 21 }, buf: [2u8; 65536] };
        let pb = Packet { g: Guard { id: 22 }, buf: [3u8; 65536] };
        let v2: i32 = consume_reg_and_stack(pa, 1, 2, 3, pb);
        print("after_two:");
        print_int(v2 as i64);
        print("\n");
    }

    run_cond(true, 31, 13u8);
    run_cond(false, 32, 14u8);
    print("done\n");
    0
}
