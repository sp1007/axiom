// test: run
// exit: 0
// stdout: 5669\n315\n
// T498h: Recursion depth with a 64 KiB by-value parameter under the default 1 MB stack:
// (1) Copy [65536]u8 mutated at each depth while verified intact after child return (depth 10).
// (2) Non-Copy 64 KiB struct moved down 24 recursive frames with zero per-frame aggregate copy.

fn rec_isolated(mut a: [65536]u8, depth: u32) -> u32 {
    if depth == 0u32 {
        return (a[0] as u32) + (a[65535] as u32);
    }
    a[0] = depth as u8;
    a[65535] = (depth * 3u32) as u8;
    let sub: u32 = rec_isolated(a, depth - 1u32);
    // `a` is read AFTER the child call: child's writes to its own `a` must not leak back.
    sub + (a[0] as u32) * 100u32 + (a[65535] as u32)
}

struct Token {
    k: u32,
}

impl Drop for Token {
    fn drop(self: mut_view<Token>) {
    }
}

struct Slab64K {
    tok: Token,
    buf: [65536]u8,
}

fn rec_move(mut s: Slab64K, depth: u32) -> u32 {
    s.buf[0] = s.buf[0] + 1u8;
    s.buf[65535] = s.buf[65535] + 2u8;
    if depth == 0u32 {
        return (s.buf[0] as u32) * 10u32 + (s.buf[65535] as u32) + s.tok.k;
    }
    rec_move(s, depth - 1u32)
}

fn run_isolated_case() -> u32 {
    let init: [65536]u8 = [9u8; 65536];
    rec_isolated(init, 10u32)
}

fn run_move_case() -> u32 {
    let slab = Slab64K { tok: Token { k: 4u32 }, buf: [1u8; 65536] };
    rec_move(slab, 24u32)
}

fn main() -> i32 {
    print_int(run_isolated_case() as i64);
    print("\n");

    print_int(run_move_case() as i64);
    print("\n");

    0
}
