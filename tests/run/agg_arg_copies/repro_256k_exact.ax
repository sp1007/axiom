// test: run
// exit: 0
// stdout: 10\n
// T498h exact repro (FU-QA-T498c-1 / triage-1122): `fn huge(a: [262144]u8, t: u32)`
// called directly from `main` with the default 1 MB stack reserve at -O0 and -O1.

fn huge(a: [262144]u8, t: u32) -> u32 {
    (a[0] as u32) + (a[131072] as u32) + (a[262143] as u32) + t
}

fn main() -> i32 {
    let a: [262144]u8 = [1u8; 262144];
    print_int(huge(a, 7u32) as i64);
    print("\n");
    0
}
