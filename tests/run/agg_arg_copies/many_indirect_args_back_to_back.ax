// test: run
// exit: 0
// stdout: 1866\n1866\n360\n878\n
// T498h: Back-to-back calls with sret + 6 indirect aggregates + 7 scalars (14 ABI args)
// across >64-byte aggregate loop-copy basic-block splits and high register pressure.

@derive(Copy)
struct Pair16 {
    lo: u64,
    hi: u64,
}

@derive(Copy)
struct Digest96 {
    words: [12]u64,
}

fn combine13(
    mut a: Pair16,
    s1: u32,
    mut b: Pair16,
    mut c: Pair16,
    s2: u64,
    s3: u32,
    s4: u64,
    s5: u64,
    s6: u64,
    mut d: Pair16,
    e: Pair16,
    f: Pair16,
    _ignored_noise: u64
) -> Digest96 {
    let w0: u64 = a.lo + (s1 as u64);
    let w1: u64 = a.hi + b.lo + b.hi;
    let w2: u64 = c.lo + c.hi + s2 + (s3 as u64);
    let w3: u64 = s4 + s5 + s6;
    let w4: u64 = d.lo + d.hi + e.lo + e.hi;
    let w5: u64 = f.lo + f.hi;
    a.lo = 9999u64;
    b.hi = 9999u64;
    c.lo = 9999u64;
    d.hi = 9999u64;
    Digest96 {
        words: [w0, w1, w2, w3, w4, w5, w0 + w1, w2 + w3, w4 + w5, 77u64, 88u64, 99u64],
    }
}

fn sum_digest(d: Digest96) -> u64 {
    let mut acc: u64 = 0u64;
    let mut i: usize = 0;
    while i < 12 {
        acc = acc + d.words[i];
        i = i + 1;
    }
    acc
}

fn many_scalars_and_agg(
    k0: u64,
    k1: u64,
    k2: u64,
    k3: u64,
    k4: u64,
    k5: u64,
    k6: u64,
    k7: u64,
    k8: u64,
    k9: u64,
    k10: u64,
    k11: u64,
    p: Pair16,
    big: Digest96
) -> Digest96 {
    let s: u64 = k0 + k1 + k2 + k3 + k4 + k5 + k6 + k7 + k8 + k9 + k10 + k11 + p.lo + p.hi + big.words[0] + big.words[11];
    let mut out: Digest96 = big;
    out.words[0] = s;
    out
}

fn run_stress(seed: u64) -> u64 {
    let p: Pair16 = Pair16 { lo: seed + 100u64, hi: seed + 200u64 };
    let big: Digest96 = Digest96 {
        words: [10u64, 1u64, 2u64, 3u64, 4u64, 5u64, 6u64, 7u64, 8u64, 9u64, 11u64, 20u64],
    };
    let mut r1: Digest96 = Digest96 { words: [0u64; 12] };
    let mut r2: Digest96 = Digest96 { words: [0u64; 12] };
    r1 = many_scalars_and_agg(
        seed + 1u64, seed + 2u64, seed + 3u64, seed + 4u64,
        seed + 5u64, seed + 6u64, seed + 7u64, seed + 8u64,
        seed + 9u64, seed + 10u64, seed + 11u64, seed + 12u64,
        p, big
    );
    r2 = many_scalars_and_agg(
        seed + 1u64, seed + 2u64, seed + 3u64, seed + 4u64,
        seed + 5u64, seed + 6u64, seed + 7u64, seed + 8u64,
        seed + 9u64, seed + 10u64, seed + 11u64, seed + 12u64,
        p, big
    );
    if r1.words[0] != r2.words[0] {
        return 0u64;
    }
    r1.words[0] + p.lo + p.hi + big.words[0]
}

fn main() -> i32 {
    let a: Pair16 = Pair16 { lo: 10u64, hi: 20u64 };
    let b: Pair16 = Pair16 { lo: 30u64, hi: 40u64 };
    let c: Pair16 = Pair16 { lo: 50u64, hi: 60u64 };
    let d: Pair16 = Pair16 { lo: 70u64, hi: 80u64 };
    let e1: Pair16 = Pair16 { lo: 90u64, hi: 100u64 };
    let f1: Pair16 = Pair16 { lo: 110u64, hi: 120u64 };
    let e2: Pair16 = Pair16 { lo: 90u64, hi: 100u64 };
    let f2: Pair16 = Pair16 { lo: 110u64, hi: 120u64 };

    let mut out1: Digest96 = Digest96 { words: [0u64; 12] };
    let mut out2: Digest96 = Digest96 { words: [0u64; 12] };
    out1 = combine13(a, 1u32, b, c, 2u64, 3u32, 4u64, 5u64, 6u64, d, e1, f1, 1000u64);
    out2 = combine13(a, 1u32, b, c, 2u64, 3u32, 4u64, 5u64, 6u64, d, e2, f2, 999999999u64);

    print_int(sum_digest(out1) as i64);
    print("\n");
    print_int(sum_digest(out2) as i64);
    print("\n");
    let live_sum: u64 = a.lo + a.hi + b.lo + b.hi + c.lo + c.hi + d.lo + d.hi;
    print_int(live_sum as i64);
    print("\n");
    print_int(run_stress(10u64) as i64);
    print("\n");
    0
}
