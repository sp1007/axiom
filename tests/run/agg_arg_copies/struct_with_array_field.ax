// test: run
// exit: 0
// stdout: 225\n125\n225\n169\n315\n
// T498h: Structs, tuples, and enums containing large array fields passed by value
// (in both register and stack slots) and returned via sret.

@derive(Copy)
struct Frame64K {
    head: u32,
    data: [65536]u8,
    tail: u64,
}

@derive(Copy)
enum Payload128K {
    Empty,
    Bulk([131072]u8, u32),
}

fn make_frame(seed: u8) -> Frame64K {
    Frame64K {
        head: 100u32,
        data: [seed; 65536],
        tail: 15u64,
    }
}

fn mutate_frame(mut f: Frame64K) -> u64 {
    f.head = 200u32;
    f.data[0] = 7u8;
    f.data[65535] = 3u8;
    (f.head as u64) + (f.data[0] as u64) + (f.data[65535] as u64) + f.tail
}

fn read_frame(f: Frame64K) -> u64 {
    (f.head as u64) + (f.data[0] as u64) + (f.data[65535] as u64) + f.tail
}

fn sum_tuple(t: ([65536]u8, u64)) -> u64 {
    (t.0[0] as u64) + (t.0[65535] as u64) + t.1
}

fn eval_payload_stack(a: u32, b: u32, c: u32, d: u32, p: Payload128K) -> u32 {
    let base: u32 = a + b + c + d;
    match p {
        Payload128K.Empty => base,
        Payload128K.Bulk(arr, tag) => base + (arr[0] as u32) + (arr[131071] as u32) + tag,
    }
}

fn main() -> i32 {
    let f0: Frame64K = make_frame(5u8);
    // f0 is Copy and still live after mutate_frame: caller copy keeps f0 intact.
    print_int(mutate_frame(f0) as i64);
    print("\n");
    print_int(read_frame(f0) as i64);
    print("\n");
    // Last use of f0:
    print_int(mutate_frame(f0) as i64);
    print("\n");

    let tup: ([65536]u8, u64) = ([9u8; 65536], 151u64);
    print_int(sum_tuple(tup) as i64);
    print("\n");

    let pay: Payload128K = Payload128K.Bulk([6u8; 131072], 293u32);
    print_int(eval_payload_stack(1u32, 2u32, 3u32, 4u32, pay) as i64);
    print("\n");

    0
}
