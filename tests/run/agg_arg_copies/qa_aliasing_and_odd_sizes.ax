// test: run
// exit: 0
// stdout: 151 159\n449 254\n132\n66 66\n6 15 21 28\n2016 2080 2145 2556 2628 2701\n
// T498h QA adversarial boundary cross-check:
// (1) Aliased sret (`x = f(x)` and `w.buf = f(w.buf)`),
// (2) Duplicate Copy args when source is dead after call (`dup3(a, a, a)` and `dup2_rev(b, b)`),
// (3) Loop back-edge liveness when `a` has no lexical use after the loop,
// (4) `view(a)` kept alive across `mut_param(a)` when `a` itself is dead after the call,
// (5) Odd indirect aggregate sizes (3, 5, 6, 7) and sizes around the 64-byte memcpy loop threshold (63, 64, 65, 71, 72, 73).

@derive(Copy)
struct Wrap100 {
    tag: u32,
    buf: [100]u8,
}

fn reverse_and_mutate(mut a: [100]u8) -> [100]u8 {
    let mut out: [100]u8 = [0u8; 100];
    let mut i: usize = 0;
    while i < 100 {
        out[i] = a[99 - i];
        i = i + 1;
    }
    a[0] = 250u8;
    a[99] = 251u8;
    out
}

fn dup3(mut x: [100]u8, mut y: [100]u8, z: [100]u8) -> u32 {
    x[0] = 200u8;
    x[99] = 201u8;
    let y0: u32 = y[0] as u32;
    y[0] = 210u8;
    y[99] = 211u8;
    (x[0] as u32) + y0 + (y[0] as u32) + (z[0] as u32) + (z[99] as u32)
}

fn dup2_rev(x: [100]u8, mut y: [100]u8) -> u32 {
    y[0] = 220u8;
    y[99] = 221u8;
    (x[0] as u32) + (x[99] as u32) + (y[0] as u32)
}

fn clobber128(mut p: [128]u8) -> u32 {
    let orig: u32 = (p[0] as u32) + (p[64] as u32) + (p[127] as u32);
    p[0] = 99u8;
    p[64] = 98u8;
    p[127] = 97u8;
    orig
}

fn sum_clobber_3(mut a: [3]u8) -> u32 {
    let mut s: u32 = 0u32;
    let mut i: usize = 0;
    while i < 3 { s = s + (a[i] as u32); i = i + 1; }
    a[0] = 0u8; a[2] = 0u8;
    s
}

fn sum_clobber_5(mut a: [5]u8) -> u32 {
    let mut s: u32 = 0u32;
    let mut i: usize = 0;
    while i < 5 { s = s + (a[i] as u32); i = i + 1; }
    a[0] = 0u8; a[4] = 0u8;
    s
}

fn sum_clobber_6(mut a: [6]u8) -> u32 {
    let mut s: u32 = 0u32;
    let mut i: usize = 0;
    while i < 6 { s = s + (a[i] as u32); i = i + 1; }
    a[0] = 0u8; a[5] = 0u8;
    s
}

fn sum_clobber_7(mut a: [7]u8) -> u32 {
    let mut s: u32 = 0u32;
    let mut i: usize = 0;
    while i < 7 { s = s + (a[i] as u32); i = i + 1; }
    a[0] = 0u8; a[6] = 0u8;
    s
}

fn sum_clobber_63(mut a: [63]u8) -> u32 {
    let mut s: u32 = 0u32;
    let mut i: usize = 0;
    while i < 63 { s = s + (a[i] as u32); i = i + 1; }
    a[0] = 0u8; a[62] = 0u8;
    s
}

