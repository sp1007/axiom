    let mut s: u32 = 0u32;
    let mut i: usize = 0;
    while i < 73 { s = s + (a[i] as u32); i = i + 1; }
    a[0] = 0u8; a[72] = 0u8;
    s
}

fn test_sret_alias() {
    let mut x: [100]u8 = [0u8; 100];
    let mut i: usize = 0;
    while i < 100 {
        x[i] = (i + 1) as u8;
        i = i + 1;
    }
    x = reverse_and_mutate(x);
    let r1: u32 = (x[0] as u32) + (x[50] as u32) + (x[99] as u32);

    let mut w: Wrap100 = Wrap100 { tag: 7u32, buf: x };
    w.buf = reverse_and_mutate(w.buf);
    let r2: u32 = w.tag + (w.buf[0] as u32) + (w.buf[50] as u32) + (w.buf[99] as u32);

    print_int(r1 as i64);
    print(" ");
    print_int(r2 as i64);
    print("\n");
}

fn test_dup_last_use() {
    let a: [100]u8 = [13u8; 100];
    let r1: u32 = dup3(a, a, a);

    let b: [100]u8 = [17u8; 100];
    let r2: u32 = dup2_rev(b, b);

    print_int(r1 as i64);
    print(" ");
    print_int(r2 as i64);
    print("\n");
}

fn test_loop_backedge_dead_after() {
    let a: [128]u8 = [11u8; 128];
    let mut i: u32 = 0u32;
    let mut acc: u32 = 0u32;
    while i < 4u32 {
        acc = acc + clobber128(a);
        i = i + 1u32;
    }
    print_int(acc as i64);
    print("\n");
}

fn test_view_dead_local() {
    let a: [128]u8 = [22u8; 128];
    let v: view<[128]u8> = view(a);
    let r: u32 = clobber128(a);
    let after: u32 = ((*v)[0] as u32) + ((*v)[64] as u32) + ((*v)[127] as u32);
    print_int(r as i64);
    print(" ");
    print_int(after as i64);
    print("\n");
}

fn test_odd_small_sizes() {
    let a3: [3]u8 = [1u8, 2u8, 3u8];
    let s3: u32 = sum_clobber_3(a3);
    let ok3: u32 = if a3[0] == 1u8 && a3[2] == 3u8 { s3 } else { 0u32 };

    let a5: [5]u8 = [1u8, 2u8, 3u8, 4u8, 5u8];
    let s5: u32 = sum_clobber_5(a5);
    let ok5: u32 = if a5[0] == 1u8 && a5[4] == 5u8 { s5 } else { 0u32 };

    let a6: [6]u8 = [1u8, 2u8, 3u8, 4u8, 5u8, 6u8];
    let s6: u32 = sum_clobber_6(a6);
    let ok6: u32 = if a6[0] == 1u8 && a6[5] == 6u8 { s6 } else { 0u32 };

    let a7: [7]u8 = [1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8];
    let s7: u32 = sum_clobber_7(a7);
    let ok7: u32 = if a7[0] == 1u8 && a7[6] == 7u8 { s7 } else { 0u32 };

    print_int(ok3 as i64); print(" ");
    print_int(ok5 as i64); print(" ");
    print_int(ok6 as i64); print(" ");
    print_int(ok7 as i64); print("\n");
}

fn test_threshold_sizes() {
    let mut a63: [63]u8 = [0u8; 63];
    let mut i: usize = 0;
    while i < 63 { a63[i] = (i + 1) as u8; i = i + 1; }
    let s63: u32 = sum_clobber_63(a63);
    let ok63: u32 = if a63[0] == 1u8 && a63[62] == 63u8 { s63 } else { 0u32 };

    let mut a64: [64]u8 = [0u8; 64];
    i = 0;
    while i < 64 { a64[i] = (i + 1) as u8; i = i + 1; }
    let s64: u32 = sum_clobber_64(a64);
    let ok64: u32 = if a64[0] == 1u8 && a64[63] == 64u8 { s64 } else { 0u32 };

    let mut a65: [65]u8 = [0u8; 65];
    i = 0;
    while i < 65 { a65[i] = (i + 1) as u8; i = i + 1; }
    let s65: u32 = sum_clobber_65(a65);
    let ok65: u32 = if a65[0] == 1u8 && a65[64] == 65u8 { s65 } else { 0u32 };

    let mut a71: [71]u8 = [0u8; 71];
    i = 0;
    while i < 71 { a71[i] = (i + 1) as u8; i = i + 1; }
    let s71: u32 = sum_clobber_71(a71);
    let ok71: u32 = if a71[0] == 1u8 && a71[70] == 71u8 { s71 } else { 0u32 };

    let mut a72: [72]u8 = [0u8; 72];
    i = 0;
    while i < 72 { a72[i] = (i + 1) as u8; i = i + 1; }
    let s72: u32 = sum_clobber_72(a72);
    let ok72: u32 = if a72[0] == 1u8 && a72[71] == 72u8 { s72 } else { 0u32 };

    let mut a73: [73]u8 = [0u8; 73];
    i = 0;
    while i < 73 { a73[i] = (i + 1) as u8; i = i + 1; }
    let s73: u32 = sum_clobber_73(a73);
    let ok73: u32 = if a73[0] == 1u8 && a73[72] == 73u8 { s73 } else { 0u32 };

    print_int(ok63 as i64); print(" ");
    print_int(ok64 as i64); print(" ");
    print_int(ok65 as i64); print(" ");
    print_int(ok71 as i64); print(" ");
    print_int(ok72 as i64); print(" ");
    print_int(ok73 as i64); print("\n");
}

fn main() -> i32 {
    test_sret_alias();
    test_dup_last_use();
    test_loop_backedge_dead_after();
    test_view_dead_local();
    test_odd_small_sizes();
    test_threshold_sizes();
    0
}
