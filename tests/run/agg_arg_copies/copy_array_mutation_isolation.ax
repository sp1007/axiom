// test: run
// exit: 0
// stdout: 157\n31\n247\n31\n37\n474\n6171\n82\n2112\n
// T498h: Copy aggregate arguments still live after the call (or aliased via borrow,
// duplicate arg, loop back-edge, or sret destination) must never observe callee mutations.

fn clobber_128k(mut p: [131072]u8, v: u8) -> u32 {
    p[0] = v;
    p[65536] = v + 1u8;
    p[131071] = v + 2u8;
    (p[0] as u32) + (p[65536] as u32) + (p[131071] as u32) + (p[1] as u32)
}

fn check_128k(a: view<[131072]u8>) -> u32 {
    ((*a)[0] as u32) + ((*a)[65536] as u32) + ((*a)[131071] as u32) + ((*a)[1] as u32)
}

fn clobber_loop_64k(mut p: [65536]u8) -> u32 {
    let orig0: u32 = p[0] as u32;
    p[0] = 99u8;
    p[65535] = 88u8;
    orig0 * 10u32 + (p[65535] as u32)
}

fn view_and_val(v: view<[4096]u8>, mut by_val: [4096]u8) -> u32 {
    let before: u32 = (*v)[0] as u32;
    by_val[0] = 111u8;
    let after: u32 = (*v)[0] as u32;
    before * 1000u32 + after * 10u32 + (by_val[0] as u32)
}

fn dup_pair(mut x: [4096]u8, y: [4096]u8) -> u32 {
    x[0] = 77u8;
    (x[0] as u32) + (y[0] as u32)
}

fn shift_arr(a: [4096]u8) -> [4096]u8 {
    let mut out: [4096]u8 = [99u8; 4096];
    out[0] = a[4095] + 1u8;
    out[4095] = a[0] + 2u8;
    out
}

fn main() -> i32 {
    let mut src: [131072]u8 = [9u8; 131072];
    src[1] = 4u8;

    let r1: u32 = clobber_128k(src, 50u8);
    print_int(r1 as i64);
    print("\n");
    print_int(check_128k(view(src)) as i64);
    print("\n");

    let r2: u32 = clobber_128k(src, 80u8);
    print_int(r2 as i64);
    print("\n");
    print_int(check_128k(view(src)) as i64);
    print("\n");

    let r3: u32 = clobber_128k(src, 10u8);
    print_int(r3 as i64);
    print("\n");

    let loop_arr: [65536]u8 = [7u8; 65536];
    let mut iter: u32 = 0u32;
    let mut acc: u32 = 0u32;
    while iter < 3u32 {
        acc = acc + clobber_loop_64k(loop_arr);
        iter = iter + 1u32;
    }
    print_int(acc as i64);
    print("\n");

    let b: [4096]u8 = [6u8; 4096];
    print_int(view_and_val(view(b), b) as i64);
    print("\n");

    let d: [4096]u8 = [5u8; 4096];
    print_int(dup_pair(d, d) as i64);
    print("\n");

    let mut s: [4096]u8 = [1u8; 4096];
    s[0] = 10u8;
    s[4095] = 20u8;
    s = shift_arr(s);
    print_int(((s[0] as u32) * 100u32 + (s[4095] as u32)) as i64);
    print("\n");

    0
}
