// test: run
// exit: 0
// stdout: 10\n11\n67\n26\n
// T498h: 256 KiB by-value aggregate arguments run within the default 1 MB stack
// at both -O0 and -O1 (from bindings, inline literals, mutating callees, and stack arg slots).

fn huge(a: [262144]u8, t: u32) -> u32 {
    (a[0] as u32) + (a[131072] as u32) + (a[262143] as u32) + t
}

fn huge_mut(mut a: [262144]u8, t: u32) -> u32 {
    a[0] = 10u8;
    a[131072] = 20u8;
    a[262143] = 30u8;
    (a[0] as u32) + (a[131072] as u32) + (a[262143] as u32) + (a[1] as u32) + t
}

fn huge_stack_arg(p0: u32, p1: u32, p2: u32, p3: u32, a: [262144]u8, tail: u32) -> u32 {
    p0 + p1 + p2 + p3 + (a[0] as u32) + (a[262143] as u32) + tail
}

fn run_binding_case() -> u32 {
    let a: [262144]u8 = [1u8; 262144];
    huge(a, 7u32)
}

fn run_literal_case() -> u32 {
    huge([2u8; 262144], 5u32)
}

fn run_mut_case() -> u32 {
    let b: [262144]u8 = [3u8; 262144];
    huge_mut(b, 4u32)
}

fn run_stack_arg_case() -> u32 {
    huge_stack_arg(1u32, 2u32, 3u32, 4u32, [5u8; 262144], 6u32)
}

fn main() -> i32 {
    print_int(run_binding_case() as i64);
    print("\n");

    print_int(run_literal_case() as i64);
    print("\n");

    print_int(run_mut_case() as i64);
    print("\n");

    print_int(run_stack_arg_case() as i64);
    print("\n");

    0
}
