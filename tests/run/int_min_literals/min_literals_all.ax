// test: run
// exit: 0
// stdout: -128\n
// stdout: -32768\n
// stdout: -2147483648\n
// stdout: -9223372036854775808\n
// stdout: -9223372036854775808\n
// stdout: -9223372036854775808\n
// stdout: -9223372036854775808\n
// stdout: -9223372036854775807\n
// stdout: 0\n
// T483 (SPEC-40 AXS-INT-004): `-lit` is folded before the range check, so every signed MIN literal is valid at run
// time. `-9223372036854775808i64` used to panic `arithmetic overflow` (0 - 9223372036854775808 checked in i64).

fn show(v: i64) {
    print_int(v);
    print("\n");
}

fn main() -> i32 {
    let a: i8 = -128i8;
    let b: i16 = -32768i16;
    let c: i32 = -2147483648i32;
    let d: i64 = -9223372036854775808i64;
    let e: isize = -9223372036854775808isize;
    print_int(a);
    print("\n");
    print_int(b);
    print("\n");
    print_int(c);
    print("\n");
    print_int(d);
    print("\n");
    print_int(e);
    print("\n");
    // Unsuffixed literal typed by its context, hex magnitude, and the neighbour of MIN.
    let g: i64 = -9223372036854775808;
    show(g);
    show(-0x8000000000000000i64);
    show(-9223372036854775807i64);
    // Negative zero is zero.
    let z: i64 = -0i64;
    show(z);
    0
}
