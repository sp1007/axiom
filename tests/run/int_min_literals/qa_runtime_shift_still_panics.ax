// test: run
// exit: 101
// stdout: before\n
// stderr-contains: panic: shift amount out of range
// QA (T483 round 0): the compile-time code AX_CONST_SHIFT_RANGE must not change run-time behaviour: a shift whose
// count is only known at run time still panics `shift amount out of range` (exit 101) in every mode.

fn sh(v: u32, n: u32) -> u32 {
    v << n
}

fn main() -> i32 {
    print("before\n");
    let r = sh(1u32, 31u32 + 1u32);
    print_int(r as i64);
    print("\nafter\n");
    0
}
