// test: run
// exit: 0
// stdout: -9223372036854775808\n
// stdout: -9223372036854775808 true\n
// stdout: -9223372036854775807\n
// stdout: min\n
// stdout: -9223372036854775808\n
// stdout: -9223372036854775808 -9223372036854775808\n
// stdout: 9223372036854775807\n
// stdout: -9223372036854775808\n
// stdout: -9223372036854775808\n
// QA (T483 round 0): the i64 MIN literal in every expression position (argument, comparison operand,
// match pattern, struct field, array element, tuple, return, generic argument, closure-free block tail,
// unary/binary operand) and the runtime semantics next to it (wrapping ops, MIN as a divisor-free value).

struct Holder {
    v: i64,
}

fn id<T>(x: T) -> T {
    x
}

fn ret_min() -> i64 {
    return -9223372036854775808i64;
}

fn classify(x: i64) -> i32 {
    match x {
        -9223372036854775808i64 => 1,
        0i64 => 2,
        _ => 3,
    }
}

fn main() -> i32 {
    print_int(id<i64>(-9223372036854775808i64));
    print("\n");
    let m = ret_min();
    print_int(m);
    if m == -9223372036854775808i64 {
        print(" true\n");
    } else {
        print(" false\n");
    }
    print_int(-9223372036854775808i64 + 1i64);
    print("\n");
    if classify(m) == 1 && classify(0i64) == 2 && classify(5i64) == 3 {
        print("min\n");
    } else {
        print("bad\n");
    }
    let h = Holder { v: -9223372036854775808i64 };
    print_int(h.v);
    print("\n");
    let arr: [2]i64 = [-9223372036854775808i64, h.v];
    print_int(arr[0]);
    print(" ");
    print_int(arr[1]);
    print("\n");
    // wrapping neg of MIN stays MIN; wrapping_sub from MIN wraps to MAX
    print_int(m.wrapping_sub(1i64));
    print("\n");
    let t: (i64, i32) = (-9223372036854775808i64, 1);
    print_int(t.0);
    print("\n");
    let blk: i64 = { -9223372036854775808i64 };
    print_int(blk);
    print("\n");
    0
}
