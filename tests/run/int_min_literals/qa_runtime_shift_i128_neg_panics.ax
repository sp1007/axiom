// test: run
// exit: 101
// stdout: ok\n
// stderr-contains: panic: shift amount out of range
// QA (T483 round 0): a run-time negative count on a 128-bit shift panics (the constant form is AX_CONST_SHIFT_RANGE,
// the run-time form keeps the panic); an in-range 127 shift first proves the value path works.

fn shr(v: i128, n: i32) -> i128 {
    v >> n
}

fn main() -> i32 {
    let a = shr(-1i128, 127i32);
    if a == -1i128 {
        print("ok\n");
    }
    let b = shr(1i128, 0i32 - 1i32);
    print_int(b as i64);
    0
}
