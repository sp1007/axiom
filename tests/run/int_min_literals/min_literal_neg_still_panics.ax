// test: run
// exit: 101
// stderr-contains: panic: arithmetic overflow
// T483: folding `-lit` must not turn runtime negation of the MIN value into a quiet wrap: `-m` where m holds
// i64.MIN still panics `arithmetic overflow` (only the literal itself is folded).

fn main() -> i32 {
    let m: i64 = -9223372036854775808i64;
    let r = -m;
    print_int(r);
    print("\n");
    0
}
