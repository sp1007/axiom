// test: run
// exit: 0
// stdout: -9223372036854775808 -5\n
// stdout: -9223372036854775808 -5\n
// T483: a literal folded by typeck stays valid when the same HIR body is checked again (trait default method
// instantiated for two implementing types, generic function used at two types).

trait Floor {
    fn floor64(self: view<Self>) -> i64 {
        -9223372036854775808i64
    }
    fn small(self: view<Self>) -> i64 {
        -5i64
    }
}

struct A { x: i32 }
struct B { y: u8 }

impl Floor for A {}
impl Floor for B {}

fn id<T>(v: T) -> T {
    v
}

fn main() -> i32 {
    let a = A { x: 1 };
    let b = B { y: 2u8 };
    print_int(a.floor64());
    print(" ");
    print_int(id<i64>(a.small()));
    print("\n");
    print_int(b.floor64());
    print(" ");
    print_int(id<i64>(b.small()));
    print("\n");
    0
}
