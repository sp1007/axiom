// test: run
// exit: 0
// stdout: -9223372036854775808\n
// stdout: -9223372036854775807\n
// stdout: 9223372036854775807\n
// stdout: true\n
// stdout: -128 127\n
// stdout: -2147483648\n
// T483 (SPEC-40 AXS-INT-004): MIN literals in `const` items and as operands of ordinary arithmetic.

const MIN64: i64 = -9223372036854775808i64;
const MINI: isize = -9223372036854775808isize;
const MIN32: i32 = -2147483648i32;

fn add_one(v: i64) -> i64 {
    v + 1i64
}

fn main() -> i32 {
    print_int(MIN64);
    print("\n");
    print_int(add_one(MIN64));
    print("\n");
    let m = -9223372036854775808i64;
    print_int(m.wrapping_sub(1i64));
    print("\n");
    if MIN64 == m && (MINI as i64) == m {
        print("true\n");
    } else {
        print("false\n");
    }
    let lo: i8 = -128i8;
    let hi: i8 = 127i8;
    print_int(lo);
    print(" ");
    print_int(hi);
    print("\n");
    print_int(MIN32);
    print("\n");
    0
}
