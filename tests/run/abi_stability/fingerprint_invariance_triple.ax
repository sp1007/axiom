// test: run
// modes: interp native
// stdout-file: fingerprint_invariance_triple.stdout
// SPEC-114 §3 (AXS-ABI-020..024, AXS-ABI-040; REQ-PKG-022, INV-SABI-002):
// Verifies independent calculation and invariance properties of ApiFingerprint,
// SemanticFingerprint, and AbiFingerprint across private body edits, @inline changes,
// physical layout modifications, and @opaque handle field isolation.

@derive(Copy)
struct DigestTriple {
    api_lo: u64,
    api_hi: u64,
    sem_lo: u64,
    sem_hi: u64,
    abi_lo: u64,
    abi_hi: u64,
}

fn hash_u64_simple(acc: u64, v: u64) -> u64 {
    acc ^ (v.wrapping_mul(0x9e3779b97f4a7c15u64))
}

fn compute_model_triple(
    pub_sig_hash: u64,
    private_body_hash: u64,
    inline_mir_hash: u64,
    is_inline: bool,
    layout_offset_hash: u64,
    opaque_internal_hash: u64,
    is_opaque: bool
) -> DigestTriple {
    // 1. ApiFingerprint: depends ONLY on public signatures
    let api_lo = hash_u64_simple(0x415049u64, pub_sig_hash)
    let api_hi = hash_u64_simple(0x5631u64, pub_sig_hash ^ 0xAAu64)

    // 2. SemanticFingerprint: depends on Api + inline MIR
    let mut sem_lo = hash_u64_simple(api_lo, 0x53454Du64)
    let mut sem_hi = hash_u64_simple(api_hi, 0x5631u64)
    if is_inline {
        sem_lo = hash_u64_simple(sem_lo, inline_mir_hash)
        sem_hi = hash_u64_simple(sem_hi, inline_mir_hash ^ 0x55u64)
    }

    // 3. AbiFingerprint: depends on layout offsets, but NOT private body,
    // and NOT opaque internal fields!
    let mut abi_lo = hash_u64_simple(0x414249u64, pub_sig_hash)
    let mut abi_hi = hash_u64_simple(0x5631u64, 0x64u64) // pointer width
    if !is_opaque {
        abi_lo = hash_u64_simple(abi_lo, layout_offset_hash)
        abi_hi = hash_u64_simple(abi_hi, layout_offset_hash ^ 0xFFu64)
    } else {
        // Opaque handle mixes fixed pointer descriptor, ignoring internal layout
        abi_lo = hash_u64_simple(abi_lo, 0x0FA9Eu64)
    }

    DigestTriple {
        api_lo: api_lo,
        api_hi: api_hi,
        sem_lo: sem_lo,
        sem_hi: sem_hi,
        abi_lo: abi_lo,
        abi_hi: abi_hi,
    }
}

pub fn main() -> i32 {
    let sig: u64 = 0x12345678u64
    let body_v1: u64 = 0xAAAAu64
    let body_v2: u64 = 0xBBBBu64
    let inline_v1: u64 = 0x1111u64
    let inline_v2: u64 = 0x2222u64
    let layout_v1: u64 = 0x7777u64
    let layout_v2: u64 = 0x8888u64
    let opaque_v1: u64 = 0x5555u64
    let opaque_v2: u64 = 0x6666u64

    // Case 1: Baseline
    let base = compute_model_triple(sig, body_v1, inline_v1, false, layout_v1, opaque_v1, false)

    // Case 2: Private body change in non-inlined function
    let priv_edit = compute_model_triple(sig, body_v2, inline_v1, false, layout_v1, opaque_v1, false)
    if base.api_lo != priv_edit.api_lo || base.api_hi != priv_edit.api_hi {
        return 1 // ApiFingerprint must be invariant
    }
    if base.sem_lo != priv_edit.sem_lo || base.sem_hi != priv_edit.sem_hi {
        return 2 // SemanticFingerprint must be invariant
    }
    if base.abi_lo != priv_edit.abi_lo || base.abi_hi != priv_edit.abi_hi {
        return 3 // AbiFingerprint must be invariant
    }

    // Case 3: Inlined body change
    let inline_edit = compute_model_triple(sig, body_v1, inline_v2, true, layout_v1, opaque_v1, false)
    let inline_base = compute_model_triple(sig, body_v1, inline_v1, true, layout_v1, opaque_v1, false)
    if inline_base.api_lo != inline_edit.api_lo || inline_base.api_hi != inline_edit.api_hi {
        return 4 // ApiFingerprint unchanged
    }
    if inline_base.sem_lo == inline_edit.sem_lo && inline_base.sem_hi == inline_edit.sem_hi {
        return 5 // SemanticFingerprint MUST change on inline body edit!
    }
    if inline_base.abi_lo != inline_edit.abi_lo || inline_base.abi_hi != inline_edit.abi_hi {
        return 6 // AbiFingerprint unchanged by inline body edit
    }

    // Case 4: Physical layout change
    let layout_edit = compute_model_triple(sig, body_v1, inline_v1, false, layout_v2, opaque_v1, false)
    if base.abi_lo == layout_edit.abi_lo && base.abi_hi == layout_edit.abi_hi {
        return 7 // AbiFingerprint MUST change on layout modification!
    }

    // Case 5: Opaque struct internal field change
    let op_base = compute_model_triple(sig, body_v1, inline_v1, false, layout_v1, opaque_v1, true)
    let op_edit = compute_model_triple(sig, body_v1, inline_v1, false, layout_v1, opaque_v2, true)
    if op_base.api_lo != op_edit.api_lo || op_base.api_hi != op_edit.api_hi {
        return 8 // ApiFingerprint invariant
    }
    if op_base.sem_lo != op_edit.sem_lo || op_base.sem_hi != op_edit.sem_hi {
        return 9 // SemanticFingerprint invariant
    }
    if op_base.abi_lo != op_edit.abi_lo || op_base.abi_hi != op_edit.abi_hi {
        return 10 // AbiFingerprint MUST BE INVARIANT under internal edits behind @opaque!
    }

    print("FINGERPRINT-INVARIANCE-TRIPLE-OK\n")
    0
}
