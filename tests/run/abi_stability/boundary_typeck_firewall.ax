// test: run
// modes: interp native
// stdout-file: boundary_typeck_firewall.stdout
// SPEC-114 §§1..2 & §6 (AXS-ABI-001..017, AXS-ABI-030, AXS-ABI-050; REQ-ECO-8734, REQ-PKG-024, INV-SABI-001):
// Verifies @abi(stable) boundary typecheck firewall: allowed fixed-width scalars, pointer handles,
// rejection of capturing closures, unrepr ADTs, raw generic exports, extensible struct header validation,
// and duplicate symbol version rejection.

@derive(Copy)
struct TypeKind {
    id: u8,
    is_stable: bool,
    size: u32,
    align: u32,
}

fn check_scalar_type(id: u8) -> TypeKind {
    // 1=i8, 2=u8, 3=i16, 4=u16, 5=i32, 6=u32, 7=i64, 8=u64, 9=f32, 10=f64, 11=bool
    if id == 1u8 || id == 2u8 || id == 11u8 {
        return TypeKind { id: id, is_stable: true, size: 1u32, align: 1u32 }
    }
    if id == 3u8 || id == 4u8 {
        return TypeKind { id: id, is_stable: true, size: 2u32, align: 2u32 }
    }
    if id == 5u8 || id == 6u8 || id == 9u8 {
        return TypeKind { id: id, is_stable: true, size: 4u32, align: 4u32 }
    }
    if id == 7u8 || id == 8u8 || id == 10u8 {
        return TypeKind { id: id, is_stable: true, size: 8u32, align: 8u32 }
    }
    TypeKind { id: id, is_stable: false, size: 0u32, align: 0u32 }
}

// Extensible struct header checker (AXS-ABI-011)
fn check_extensible_struct_header(has_header: bool, ver: u32, size: u32) -> bool {
    has_header && ver >= 1u32 && size >= 8u32
}

// Unstable boundary types checker (AXS-ABI-017)
// 101=CapturingClosure, 102=UnreprAdt, 103=BareView, 104=BareStr, 105=GenericParam
fn is_unstable_boundary_type(type_tag: u8) -> bool {
    type_tag >= 101u8 && type_tag <= 105u8
}

// Symbol version duplicate checker (AXS-ABI-030)
fn check_symbol_version_collision(v1: u32, is_def1: bool, v2: u32, is_def2: bool) -> bool {
    let ver_eq = v1 == v2
    let mult_def = is_def1 && is_def2
    ver_eq || mult_def
}

pub fn main() -> i32 {
    // 1. Verify scalars
    let u32_k = check_scalar_type(6u8)
    let f64_k = check_scalar_type(10u8)
    let bad_k = check_scalar_type(99u8)
    if !u32_k.is_stable || u32_k.size != 4u32 || u32_k.align != 4u32 {
        return 1
    }
    if !f64_k.is_stable || f64_k.size != 8u32 || f64_k.align != 8u32 {
        return 2
    }
    if bad_k.is_stable {
        return 3
    }

    // 2. Extensible struct header
    let ok_ext = check_extensible_struct_header(true, 1u32, 24u32)
    let no_hdr = check_extensible_struct_header(false, 1u32, 24u32)
    let bad_sz = check_extensible_struct_header(true, 1u32, 4u32)
    if !ok_ext || no_hdr || bad_sz {
        return 4
    }

    // 3. Rejection of unstable types
    if !is_unstable_boundary_type(101u8) || !is_unstable_boundary_type(102u8) ||
        !is_unstable_boundary_type(103u8) || !is_unstable_boundary_type(105u8) {
        return 5
    }
    if is_unstable_boundary_type(6u8) || is_unstable_boundary_type(10u8) {
        return 6
    }

    // 4. Symbol version collision
    let dup_ver = check_symbol_version_collision(1u32, false, 1u32, false)
    let mult_def = check_symbol_version_collision(1u32, true, 2u32, true)
    let valid_ver = check_symbol_version_collision(1u32, false, 2u32, true)
    if !dup_ver || !mult_def || valid_ver {
        return 7
    }

    print("BOUNDARY-TYPECK-FIREWALL-OK\n")
    0
}
