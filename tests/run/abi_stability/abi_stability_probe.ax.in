fn out_str(s: str) {
    let sv = ux2_sv(s)
    let _ = unsafe { write(stdio(1), sv.ptr, sv.len) }
}

fn out_bool(b: bool) {
    if b {
        out_str("true")
    } else {
        out_str("false")
    }
}

fn new_diag_sink() -> DiagSink {
    let mut sink = DiagSink {
        arena: (query_db_empty()).arena,
        diags: 0 as *mut compiler.diag.emitter.Diagnostic,
        len: 0,
        cap: 0,
        errors: 0,
        warnings: 0,
    }
    diag_sink_init(mut_view(sink))
    sink
}

fn sink_has_code(sink: view<DiagSink>, code_v: u32) -> bool {
    let mut i: usize = 0usize
    while i < sink.len {
        let d = diag_sink_get(sink, i)
        if d.code.v == code_v {
            return true
        }
        i = i + 1usize
    }
    false
}

fn run_boundary_typeck_probe() -> bool {
    let mut sink = new_diag_sink()
    let cur_mod = ux2_sv("demo.abi_test")

    // 1. Valid stable scalar function
    let mut f_ok = stable_fn_contract_default(ux2_sv("calc_sum"), cur_mod)
    f_ok.param_count = 2u32
    let mut params_ok: [8]StableParamContract = [
        stable_param_contract_default(ux2_sv("a"), stable_type_contract_scalar(STABLE_TYPE_U32, ux2_sv("u32"), 4u32, 4u32), true),
        stable_param_contract_default(ux2_sv("b"), stable_type_contract_scalar(STABLE_TYPE_U32, ux2_sv("u32"), 4u32, 4u32), true),
        stable_param_contract_default(ux2_sv(""), stable_type_contract_unstable(ux2_sv(""), 0u8), false),
        stable_param_contract_default(ux2_sv(""), stable_type_contract_unstable(ux2_sv(""), 0u8), false),
        stable_param_contract_default(ux2_sv(""), stable_type_contract_unstable(ux2_sv(""), 0u8), false),
        stable_param_contract_default(ux2_sv(""), stable_type_contract_unstable(ux2_sv(""), 0u8), false),
        stable_param_contract_default(ux2_sv(""), stable_type_contract_unstable(ux2_sv(""), 0u8), false),
        stable_param_contract_default(ux2_sv(""), stable_type_contract_unstable(ux2_sv(""), 0u8), false)
    ]
    let stable_scalars_ok = validate_stable_boundary_fn(view(f_ok), view(params_ok), 2usize, cur_mod, mut_view(sink))

    // 2. Rejection of capturing closure
    let mut f_closure = stable_fn_contract_default(ux2_sv("register_cb"), cur_mod)
    f_closure.param_count = 1u32
    let mut params_closure: [8]StableParamContract = [
        stable_param_contract_default(ux2_sv("cb"), stable_type_contract_unstable(ux2_sv("closure"), UNSTABLE_CLOSURE_CAPTURING), true),
        stable_param_contract_default(ux2_sv(""), stable_type_contract_unstable(ux2_sv(""), 0u8), false),
        stable_param_contract_default(ux2_sv(""), stable_type_contract_unstable(ux2_sv(""), 0u8), false),
        stable_param_contract_default(ux2_sv(""), stable_type_contract_unstable(ux2_sv(""), 0u8), false),
        stable_param_contract_default(ux2_sv(""), stable_type_contract_unstable(ux2_sv(""), 0u8), false),
        stable_param_contract_default(ux2_sv(""), stable_type_contract_unstable(ux2_sv(""), 0u8), false),
        stable_param_contract_default(ux2_sv(""), stable_type_contract_unstable(ux2_sv(""), 0u8), false),
        stable_param_contract_default(ux2_sv(""), stable_type_contract_unstable(ux2_sv(""), 0u8), false)
    ]
    let closure_valid = validate_stable_boundary_fn(view(f_closure), view(params_closure), 1usize, cur_mod, mut_view(sink))
    let closure_rejected = !closure_valid && sink_has_code(view(sink), AX_ABI_UNSTABLE_TYPE)

    // 3. Rejection of unrepr ADT
    let mut sink_adt = new_diag_sink()
    let mut f_adt = stable_fn_contract_default(ux2_sv("send_point"), cur_mod)
    f_adt.param_count = 1u32
    let mut params_adt: [8]StableParamContract = [
        stable_param_contract_default(ux2_sv("pt"), stable_type_contract_unstable(ux2_sv("Point"), UNSTABLE_UNREPR_ADT), true),
        stable_param_contract_default(ux2_sv(""), stable_type_contract_unstable(ux2_sv(""), 0u8), false),
        stable_param_contract_default(ux2_sv(""), stable_type_contract_unstable(ux2_sv(""), 0u8), false),
        stable_param_contract_default(ux2_sv(""), stable_type_contract_unstable(ux2_sv(""), 0u8), false),
        stable_param_contract_default(ux2_sv(""), stable_type_contract_unstable(ux2_sv(""), 0u8), false),
        stable_param_contract_default(ux2_sv(""), stable_type_contract_unstable(ux2_sv(""), 0u8), false),
        stable_param_contract_default(ux2_sv(""), stable_type_contract_unstable(ux2_sv(""), 0u8), false),
        stable_param_contract_default(ux2_sv(""), stable_type_contract_unstable(ux2_sv(""), 0u8), false)
    ]
    let adt_valid = validate_stable_boundary_fn(view(f_adt), view(params_adt), 1usize, cur_mod, mut_view(sink_adt))
    let unrepr_rejected = !adt_valid && sink_has_code(view(sink_adt), AX_ABI_UNSTABLE_TYPE)

    // 4. Rejection of unmonomorphized generic export
    let mut sink_gen = new_diag_sink()
    let mut f_gen = stable_fn_contract_default(ux2_sv("process_generic"), cur_mod)
    f_gen.is_generic = true
    f_gen.generic_param_count = 1u32
    let gen_valid = validate_stable_boundary_fn(view(f_gen), view(params_ok), 0usize, cur_mod, mut_view(sink_gen))
    let generic_rejected = !gen_valid && sink_has_code(view(sink_gen), AX_FFI_GENERIC_EXPORT)

    // 5. Extensible struct missing header
    let mut sink_ext = new_diag_sink()
    let mut ext_ty = stable_type_contract_scalar(STABLE_TYPE_U32, ux2_sv("MyConfig"), 16u32, 4u32)
    ext_ty.is_extensible = true
    let ext_valid = validate_extensible_struct_header(
        view(ext_ty),
        ux2_sv("width"),
        ux2_sv("u32"),
        ux2_sv("height"),
        ux2_sv("u32"),
        mut_view(sink_ext)
    )
    let missing_header_rejected = !ext_valid && sink_has_code(view(sink_ext), AX_ABI_EXTENSIBLE_MISSING_HEADER)

    // 6. Duplicate symbol version
    let mut sink_sym = new_diag_sink()
    let mut sym_entries: [8]SymbolVersionEntry = [
        symbol_version_entry_new(ux2_sv("calc"), cur_mod, ux2_sv("1.0"), true),
        symbol_version_entry_new(ux2_sv("calc"), cur_mod, ux2_sv("1.0"), true),
        symbol_version_entry_new(ux2_sv(""), ux2_sv(""), ux2_sv(""), false),
        symbol_version_entry_new(ux2_sv(""), ux2_sv(""), ux2_sv(""), false),
        symbol_version_entry_new(ux2_sv(""), ux2_sv(""), ux2_sv(""), false),
        symbol_version_entry_new(ux2_sv(""), ux2_sv(""), ux2_sv(""), false),
        symbol_version_entry_new(ux2_sv(""), ux2_sv(""), ux2_sv(""), false),
        symbol_version_entry_new(ux2_sv(""), ux2_sv(""), ux2_sv(""), false)
    ]
    let sym_valid = validate_symbol_versions(view(sym_entries), 2usize, mut_view(sink_sym))
    let sym_ver_dup_rejected = !sym_valid && sink_has_code(view(sink_sym), AX_ABI_SYMBOL_VERSION_DUPLICATE)

    out_str("probe[boundary_typeck] stable_scalars_ok=")
    out_bool(stable_scalars_ok)
    out_str(" closure_rejected=")
    out_bool(closure_rejected)
    out_str(" unrepr_rejected=")
    out_bool(unrepr_rejected)
    out_str(" generic_rejected=")
    out_bool(generic_rejected)
    out_str(" missing_header_rejected=")
    out_bool(missing_header_rejected)
    out_str(" sym_ver_dup_rejected=")
    out_bool(sym_ver_dup_rejected)
    out_str("\n")

    stable_scalars_ok && closure_rejected && unrepr_rejected &&
        generic_rejected && missing_header_rejected && sym_ver_dup_rejected
}

fn run_opaque_isolation_probe() -> bool {
    let mut sink = new_diag_sink()
    let def_mod = ux2_sv("driver.db")
    let client_mod = ux2_sv("app.main")
    let op_ty = stable_type_contract_opaque(ux2_sv("DbConn"), def_mod)

    // 1. Pointer handle across boundary -> allowed
    let ptr_ty = stable_type_contract_ptr(ux2_sv("DbConn"), true, def_mod)
    let ptr_handle_ok = validate_opaque_handle_usage(view(ptr_ty), false, client_mod, mut_view(sink))

    // 2. By-value usage outside defining module -> rejected
    let mut sink_val = new_diag_sink()
    let by_val_valid = validate_opaque_handle_usage(view(op_ty), true, client_mod, mut_view(sink_val))
    let by_val_rejected = !by_val_valid && sink_has_code(view(sink_val), AX_ABI_OPAQUE_BY_VALUE)

    // 3. By-value usage inside defining module -> allowed
    let mut sink_def = new_diag_sink()
    let inside_def_ok = validate_opaque_handle_usage(view(op_ty), true, def_mod, mut_view(sink_def))
    let layout_isolated = inside_def_ok && (sink_def.len == 0usize)

    out_str("probe[opaque_isolation] ptr_handle_ok=")
    out_bool(ptr_handle_ok)
    out_str(" by_val_rejected=")
    out_bool(by_val_rejected)
    out_str(" layout_isolated=")
    out_bool(layout_isolated)
    out_str("\n")

    ptr_handle_ok && by_val_rejected && layout_isolated
}

fn run_fingerprint_invariance_probe() -> bool {
    let target = target_platform_win64()
    let mod_path = ux2_sv("pkg.core")

    // Baseline inputs
    let mut api_items: [8]ApiItemInput = [
        api_item_input_default(ITEM_KIND_FN, ux2_sv("compute"), mod_path, true),
        api_item_input_default(ITEM_KIND_STRUCT, ux2_sv("Context"), mod_path, true),
        api_item_input_default(0u8, ux2_sv(""), ux2_sv(""), false),
        api_item_input_default(0u8, ux2_sv(""), ux2_sv(""), false),
        api_item_input_default(0u8, ux2_sv(""), ux2_sv(""), false),
        api_item_input_default(0u8, ux2_sv(""), ux2_sv(""), false),
        api_item_input_default(0u8, ux2_sv(""), ux2_sv(""), false),
        api_item_input_default(0u8, ux2_sv(""), ux2_sv(""), false)
    ]
    api_items[0].fn_param_count = 1u32
    api_items[0].fn_param_types_hash = 0x11223344u64
    api_items[0].fn_ret_type_name = ux2_sv("u32")
    api_items[1].struct_field_count = 2u32
    api_items[1].struct_fields_hash = 0x55667788u64

    let mut sem_items: [8]SemanticItemInput = [
        semantic_item_input_default(ux2_sv("compute")),
        semantic_item_input_default(ux2_sv("Context")),
        semantic_item_input_default(ux2_sv("")),
        semantic_item_input_default(ux2_sv("")),
        semantic_item_input_default(ux2_sv("")),
        semantic_item_input_default(ux2_sv("")),
        semantic_item_input_default(ux2_sv("")),
        semantic_item_input_default(ux2_sv(""))
    ]
    sem_items[0].is_inline = false
    sem_items[0].capability_contract_hash = 0x99AAu64

    let mut abi_items: [8]AbiLayoutItemInput = [
        abi_layout_item_input_default(ux2_sv("compute"), mod_path, true),
        abi_layout_item_input_default(ux2_sv("Context"), mod_path, true),
        abi_layout_item_input_default(ux2_sv("DbConn"), mod_path, true),
        abi_layout_item_input_default(ux2_sv(""), ux2_sv(""), false),
        abi_layout_item_input_default(ux2_sv(""), ux2_sv(""), false),
        abi_layout_item_input_default(ux2_sv(""), ux2_sv(""), false),
        abi_layout_item_input_default(ux2_sv(""), ux2_sv(""), false),
        abi_layout_item_input_default(ux2_sv(""), ux2_sv(""), false)
    ]
    abi_items[1].size = 16u32
    abi_items[1].align = 8u32
    abi_items[1].field_offsets_hash = 0xA1B2C3D4u64
    abi_items[2].is_opaque = true // Opaque struct
    abi_items[2].size = 24u32

    // Baseline calculation
    let base_api = compute_api_fingerprint(view(api_items), 2usize)
    let base_sem = compute_semantic_fingerprint(base_api, view(sem_items), 2usize)
    let base_abi = compute_abi_fingerprint(view(target), view(abi_items), 3usize)

    // Test 1: Invariance of ApiFingerprint under private body change
    let priv_sem = compute_semantic_fingerprint(base_api, view(sem_items), 2usize)
    let api_fp_inv_ok = api_fingerprint_eq(base_api, base_api) && semantic_fingerprint_eq(base_sem, priv_sem)

    // Test 2: SemanticFingerprint changes when @inline body changes
    sem_items[0].is_inline = true
    sem_items[0].inline_mir_body_hash = 0xEEFFu64
    let inline_sem = compute_semantic_fingerprint(base_api, view(sem_items), 2usize)
    let sem_fp_inline_ok = !semantic_fingerprint_eq(base_sem, inline_sem)
    // Restore
    sem_items[0].is_inline = false
    sem_items[0].inline_mir_body_hash = 0u64

    // Test 3: AbiFingerprint is strictly invariant under internal field changes of @opaque handle
    abi_items[2].size = 96u32 // Internal size changed from 24 to 96
    abi_items[2].field_offsets_hash = 0x99999999u64
    let opaque_abi = compute_abi_fingerprint(view(target), view(abi_items), 3usize)
    let abi_fp_opaque_inv_ok = abi_fingerprint_eq(base_abi, opaque_abi)

    // Test 4: AbiFingerprint changes when layout of non-opaque struct changes
    abi_items[1].size = 24u32 // Context size changed from 16 to 24
    abi_items[1].field_offsets_hash = 0xFEDCBA98u64
    let layout_abi = compute_abi_fingerprint(view(target), view(abi_items), 3usize)
    let abi_fp_layout_diff_ok = !abi_fingerprint_eq(base_abi, layout_abi)

    out_str("probe[fingerprint_invariance] api_fp_inv_ok=")
    out_bool(api_fp_inv_ok)
    out_str(" sem_fp_inline_ok=")
    out_bool(sem_fp_inline_ok)
    out_str(" abi_fp_opaque_inv_ok=")
    out_bool(abi_fp_opaque_inv_ok)
    out_str(" abi_fp_layout_diff_ok=")
    out_bool(abi_fp_layout_diff_ok)
    out_str("\n")

    api_fp_inv_ok && sem_fp_inline_ok && abi_fp_opaque_inv_ok && abi_fp_layout_diff_ok
}

pub fn main() -> i32 {
    let p1 = run_boundary_typeck_probe()
    let p2 = run_opaque_isolation_probe()
    let p3 = run_fingerprint_invariance_probe()

    if p1 && p2 && p3 {
        out_str("ABI-STABILITY-PROBE-PASS\n")
        0
    } else {
        out_str("ABI-STABILITY-PROBE-FAIL\n")
        1
    }
}
