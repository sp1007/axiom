// test: run
// modes: interp native
// stdout-file: opaque_handle_isolation.stdout
// SPEC-114 §2 (AXS-ABI-013, AXS-ABI-050; REQ-ECO-8734, INV-SABI-001):
// Verifies @opaque handle type isolation: permitted via pointers (*mut T / *const T),
// rejected by value outside defining module, and ensures internal layout modifications
// leave public caller ABI contract completely unchanged.

@derive(Copy)
struct OpaqueHandleContract {
    is_opaque: bool,
    def_module_id: u32,
    internal_size: u32,
    internal_align: u32,
    public_ptr_size: u32,
    public_ptr_align: u32,
}

fn check_opaque_usage_valid(h: OpaqueHandleContract, is_ptr: bool, caller_mod_id: u32) -> bool {
    if !h.is_opaque {
        return true
    }
    // Pointers are always allowed across boundaries
    if is_ptr {
        return true
    }
    // By-value is allowed ONLY within the defining module
    caller_mod_id == h.def_module_id
}

pub fn main() -> i32 {
    let def_mod: u32 = 42u32
    let caller_mod: u32 = 99u32

    // Version 1 of internal opaque struct: 24 bytes
    let h1 = OpaqueHandleContract {
        is_opaque: true,
        def_module_id: def_mod,
        internal_size: 24u32,
        internal_align: 8u32,
        public_ptr_size: 8u32,
        public_ptr_align: 8u32,
    }

    // Version 2 of internal opaque struct: added private fields -> 64 bytes
    let h2 = OpaqueHandleContract {
        is_opaque: true,
        def_module_id: def_mod,
        internal_size: 64u32,
        internal_align: 16u32,
        public_ptr_size: 8u32,
        public_ptr_align: 8u32,
    }

    // 1. Pointers across boundary are allowed in both versions
    if !check_opaque_usage_valid(h1, true, caller_mod) || !check_opaque_usage_valid(h2, true, caller_mod) {
        return 1
    }

    // 2. By-value across boundary is strictly rejected
    if check_opaque_usage_valid(h1, false, caller_mod) || check_opaque_usage_valid(h2, false, caller_mod) {
        return 2
    }

    // 3. By-value within defining module is allowed
    if !check_opaque_usage_valid(h1, false, def_mod) || !check_opaque_usage_valid(h2, false, def_mod) {
        return 3
    }

    // 4. Public ABI contract (pointer size and align) is 100% identical across private changes
    if h1.public_ptr_size != h2.public_ptr_size || h1.public_ptr_align != h2.public_ptr_align {
        return 4
    }

    print("OPAQUE-HANDLE-ISOLATION-OK\n")
    0
}
