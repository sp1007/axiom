// test: run
// modes: interp native
// stdout: 5 1 42 3 1 77 99 1\n

module main

static Y: u32 = 5u32;
static mut X: u32 = 0u32;
static mut COUNTER: i64 = 10i64;

static BIG_IMM: i128 = 18446744073709551623i128;
static mut BIG_MUT: i128 = 0i128;

static mut DROP_TALLY: i64 = 0i64;

struct Guard {
    pub id: i64,
}

impl Drop for Guard {
    fn drop(self: mut_view<Guard>) {
        let _ = self;
        unsafe {
            DROP_TALLY = DROP_TALLY + 1i64;
        }
    }
}

static IMM_GUARD: Guard = Guard { id: 77i64 };
static mut MUT_GUARD: Guard = Guard { id: 88i64 };

fn bump_by(delta: i64) {
    unsafe {
        COUNTER += delta;
    }
}

fn scale_and_sub() {
    unsafe {
        COUNTER *= 3i64;
        COUNTER -= 5i64;
    }
}

fn run_local_guard() {
    let g = Guard { id: 1i64 };
    let _ = g.id;
}

fn overwrite_static_guard() {
    unsafe {
        MUT_GUARD = Guard { id: 99i64 };
    }
}

pub fn main() -> i32 {
    unsafe {
        X = 1u32;
    }
    bump_by(4i64);
    scale_and_sub();
    bump_by(5i64);

    unsafe {
        BIG_MUT = BIG_IMM + 3i128;
    }
    let big_diff: i64 = unsafe { (BIG_MUT - BIG_IMM) as i64 };
    let big_hi: i64 = unsafe { (BIG_MUT >> 64i128) as i64 };

    run_local_guard();
    overwrite_static_guard();

    let imm_id: i64 = view(IMM_GUARD).id;
    let mut_id: i64 = unsafe { view(MUT_GUARD).id };
    let drops: i64 = unsafe { DROP_TALLY };

    print_int(Y as i64);
    print(" ");
    print_int((unsafe { X }) as i64);
    print(" ");
    print_int(unsafe { COUNTER });
    print(" ");
    print_int(big_diff);
    print(" ");
    print_int(big_hi);
    print(" ");
    print_int(imm_id);
    print(" ");
    print_int(mut_id);
    print(" ");
    print_int(drops);
    print("\n");
    0
}
