// test: run
// modes: interp native
// flags: -O2
// stdout: 5 7 20 24 53 777\n

module main

fn f_plus1(x: i64) -> i64 {
    x + 1i64
}

fn f_times4(x: i64) -> i64 {
    x * 4i64
}

static mut G_ACC: i64 = 5i64;
static mut G_PAIR: (i64, i64) = (10i64, 20i64);
static mut G_FN: fn(i64) -> i64 = f_plus1;

fn call_hook(v: i64) -> i64 {
    let fp = unsafe { G_FN };
    fp(v)
}

fn callee_clobber() {
    unsafe {
        G_ACC = G_ACC + 15i64;
        G_PAIR.0 = G_PAIR.0 + 3i64;
        G_PAIR.1 = G_PAIR.1 * 2i64;
        G_FN = f_times4;
    }
}

fn set_final() {
    unsafe {
        G_ACC = 777i64;
    }
}

pub fn main() -> i32 {
    let b0: i64 = unsafe { G_ACC };
    let r0: i64 = call_hook(6i64);
    callee_clobber();
    let b1: i64 = unsafe { G_ACC };
    let r1: i64 = call_hook(6i64);
    let p_sum: i64 = unsafe { G_PAIR.0 + G_PAIR.1 };
    set_final();
    let b2: i64 = unsafe { G_ACC };

    print_int(b0);
    print(" ");
    print_int(r0);
    print(" ");
    print_int(b1);
    print(" ");
    print_int(r1);
    print(" ");
    print_int(p_sum);
    print(" ");
    print_int(b2);
    print("\n");
    0
}
