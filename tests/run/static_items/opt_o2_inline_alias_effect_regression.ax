// test: run
// modes: interp native
// flags: -O2
// stdout: f1=109 99 123 f2=132 39 loop=117 atom=60 32\n

module main

use std.sync.atomic.Atomic
use std.sync.atomic.AtomicU32
use std.sync.atomic.Ordering

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

static mut G_VAL: i64 = 10i64;
static mut G_PAIR: (i64, i64) = (3i64, 7i64);

struct AtomicBucket {
    pub counts: [2]AtomicU32,
    pub bias: i64,
}

static IMM_ATOM: Atomic<u64> = Atomic { v: 10u64 };
static IMM_BUCKET: AtomicBucket = AtomicBucket {
    counts: [Atomic { v: 2u32 }, Atomic { v: 5u32 }],
    bias: 4i64,
};

@inline(never)
fn set_g_noinline(v: i64) {
    unsafe {
        G_VAL = v;
    }
}

@inline(never)
fn get_g_noinline() -> i64 {
    unsafe { G_VAL }
}

@inline(always)
fn set_g_inl(v: i64) {
    unsafe {
        G_VAL = v;
    }
}

@inline(always)
fn get_g_inl() -> i64 {
    unsafe { G_VAL }
}

@inline(always)
fn bump_pair_inl(dx: i64, dy: i64) {
    unsafe {
        G_PAIR.0 = G_PAIR.0 + dx;
        G_PAIR.1 = G_PAIR.1 + dy;
    }
}

@inline(never)
fn step_loop_noinline(delta: i64) {
    unsafe {
        G_VAL = G_VAL + delta;
    }
}

@inline(always)
fn step_loop_inl(delta: i64) {
    unsafe {
        G_VAL = G_VAL + delta;
    }
}

@inline(never)
fn bump_atom_noinline(v: u64) {
    let _ = IMM_ATOM.fetch_add(v, Ordering.SeqCst);
}

@inline(always)
fn bump_bucket_inl(d0: u32, d1: u32) {
    let _ = IMM_BUCKET.counts[0].fetch_add(d0, Ordering.SeqCst);
    let _ = IMM_BUCKET.counts[1].fetch_add(d1, Ordering.SeqCst);
}

@inline(always)
fn read_atom_inl() -> u64 {
    IMM_ATOM.load(Ordering.SeqCst)
}

fn test_f1_non_inlined() -> (i64, i64, i64) {
    let v0: i64 = unsafe { G_VAL };
    set_g_noinline(99i64);
    let v1: i64 = unsafe { G_VAL };
    let c1: i64 = get_g_noinline();
    set_g_noinline(123i64);
    let c2: i64 = get_g_noinline();
    (v0 + v1, c1, c2)
}

fn test_f2_inlined() -> (i64, i64) {
    unsafe {
        G_VAL = 20i64;
    }
    set_g_inl(55i64);
    let r1: i64 = unsafe { G_VAL };
    let p: *mut i64 = unsafe { address_of_mut(G_VAL) };
    unsafe {
        *p = 77i64;
    }
    let r2: i64 = get_g_inl();
    unsafe {
        G_PAIR.0 = 4i64;
        G_PAIR.1 = 6i64;
    }
    bump_pair_inl(5i64, 10i64);
    let mid_p0: i64 = unsafe { G_PAIR.0 };
    bump_pair_inl(2i64, 3i64);
    let end_sum: i64 = mid_p0 + (unsafe { G_PAIR.0 + G_PAIR.1 });
    (r1 + r2, end_sum)
}

fn test_loop_globals() -> i64 {
    unsafe {
        G_VAL = 1i64;
    }
    let mut acc: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i < 4i64 {
        step_loop_noinline(2i64);
        acc = acc + (unsafe { G_VAL });
        step_loop_inl(3i64);
        acc = acc + get_g_inl();
        i = i + 1i64;
    }
    acc + (unsafe { G_VAL })
}

fn test_atomic_statics() -> (i64, i64) {
    let mut a_acc: u64 = 0u64;
    let mut k: usize = 0;
    while k < 3 {
        bump_atom_noinline(5u64);
        a_acc = a_acc + read_atom_inl();
        bump_bucket_inl(3u32, 4u32);
        k = k + 1;
    }
    let b0 = IMM_BUCKET.counts[0].load(Ordering.SeqCst) as i64;
    let b1 = IMM_BUCKET.counts[1].load(Ordering.SeqCst) as i64;
    (a_acc as i64, b0 + b1 + IMM_BUCKET.bias)
}

pub fn main() -> i32 {
    let f1 = test_f1_non_inlined();
    let f2 = test_f2_inlined();
    let lp = test_loop_globals();
    let at = test_atomic_statics();

    print("f1=");
    print_int(f1.0);
    print(" ");
    print_int(f1.1);
    print(" ");
    print_int(f1.2);
    print(" f2=");
    print_int(f2.0);
    print(" ");
    print_int(f2.1);
    print(" loop=");
    print_int(lp);
    print(" atom=");
    print_int(at.0);
    print(" ");
    print_int(at.1);
    print("\n");
    0
}
