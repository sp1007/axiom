// test: run
// modes: interp native
// timeout: 60
// stdout: 1 1 1 1 1 99 7 200\n

module main

use std.sync.atomic.Atomic
use std.sync.atomic.Ordering
use std.thread.spawn

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

static DUP_A: [4]u32 = [1u32, 2u32, 3u32, 4u32];
static DUP_B: [4]u32 = [1u32, 2u32, 3u32, 4u32];
static IMM_CFG: i64 = 1234i64;
static mut SHARED_VAL: i64 = 7i64;

@thread_local
static mut TLS_VAL: i64 = 7i64;

static ATOMIC_SUM: Atomic<u64> = Atomic { v: 100u64 };

fn dup_a_addr_first() -> usize {
    unsafe { address_of(DUP_A) as usize }
}

fn dup_a_addr_second() -> usize {
    unsafe { address_of(DUP_A) as usize }
}

fn dup_b_addr() -> usize {
    unsafe { address_of(DUP_B) as usize }
}

pub fn main() -> i32 {
    let same_fn_addrs: i64 = if dup_a_addr_first() == dup_a_addr_second() { 1i64 } else { 0i64 };
    let distinct_statics: i64 = if dup_a_addr_first() != dup_b_addr() { 1i64 } else { 0i64 };

    let main_imm_addr: usize = unsafe { address_of(IMM_CFG) as usize };
    let main_shared_addr: usize = unsafe { address_of_mut(SHARED_VAL) as usize };
    let main_tls_addr: usize = unsafe { address_of_mut(TLS_VAL) as usize };

    let h1 = spawn(|| -> (usize, usize, usize) {
        TLS_VAL = 555i64;
        unsafe {
            SHARED_VAL = 99i64;
        }
        let _ = ATOMIC_SUM.fetch_add(25u64, Ordering.SeqCst);
        let ci: usize = unsafe { address_of(IMM_CFG) as usize };
        let cs: usize = unsafe { address_of_mut(SHARED_VAL) as usize };
        let ct: usize = unsafe { address_of_mut(TLS_VAL) as usize };
        (ci, cs, ct)
    });

    let mut child_imm_eq: i64 = 0i64;
    let mut child_shared_eq: i64 = 0i64;
    let mut child_tls_ne: i64 = 0i64;
    match h1.join() {
        Result.Ok(addrs) => {
            if addrs.0 == main_imm_addr {
                child_imm_eq = 1i64;
            }
            if addrs.1 == main_shared_addr {
                child_shared_eq = 1i64;
            }
            if addrs.2 != main_tls_addr {
                child_tls_ne = 1i64;
            }
        },
        Result.Err(_) => {},
    }

    let shared_after_join: i64 = unsafe { SHARED_VAL };
    let tls_in_main: i64 = TLS_VAL;

    let h2 = spawn(|| -> i64 {
        let _ = ATOMIC_SUM.fetch_add(30u64, Ordering.SeqCst);
        0i64
    });
    let h3 = spawn(|| -> i64 {
        let _ = ATOMIC_SUM.fetch_add(45u64, Ordering.SeqCst);
        0i64
    });
    let _ = h2.join();
    let _ = h3.join();

    let final_atomic: i64 = ATOMIC_SUM.load(Ordering.SeqCst) as i64;

    print_int(same_fn_addrs);
    print(" ");
    print_int(distinct_statics);
    print(" ");
    print_int(child_imm_eq);
    print(" ");
    print_int(child_shared_eq);
    print(" ");
    print_int(child_tls_ne);
    print(" ");
    print_int(shared_after_join);
    print(" ");
    print_int(tls_in_main);
    print(" ");
    print_int(final_atomic);
    print("\n");
    0
}
