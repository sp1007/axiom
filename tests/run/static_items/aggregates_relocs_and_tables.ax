// test: run
// modes: interp native
// stdout: Xin chào thế giới | Xin chào thế giới | 22 60 32 27 16 36 0 2080\n

module main

fn op_add10(x: i64) -> i64 {
    x + 10i64
}

fn op_mul3(x: i64) -> i64 {
    x * 3i64
}

fn op_sq(x: i64) -> i64 {
    x * x
}

@derive(Copy)
struct OpEntry {
    pub label: str,
    pub base: i64,
    pub f: fn(i64) -> i64,
}

@derive(Copy)
struct BannerSlot {
    pub text: str,
}

static TABLE: [3]OpEntry = [
    OpEntry { label: "alpha", base: 4i64, f: op_add10 },
    OpEntry { label: "Xin chào thế giới", base: 7i64, f: op_mul3 },
    OpEntry { label: "omega", base: 5i64, f: op_sq },
];

static RAW_GREETING: str = "Xin chào thế giới";
static GREETING: BannerSlot = BannerSlot { text: "Xin chào thế giới" };
static mut BANNER: BannerSlot = BannerSlot { text: "boot" };

static DEFAULT_FN: fn(i64) -> i64 = op_mul3;
static mut ACTIVE_FN: fn(i64) -> i64 = op_add10;

static mut BSS_ARR: [64]u64 = [0u64; 64];

fn sum_bss() -> u64 {
    let mut s: u64 = 0u64;
    let mut i: usize = 0;
    while i < 64 {
        s = s + (unsafe { BSS_ARR[i] });
        i = i + 1;
    }
    s
}

fn fill_bss() {
    let mut i: usize = 0;
    while i < 64 {
        unsafe {
            BSS_ARR[i] = (i + 1) as u64;
        }
        i = i + 1;
    }
}

pub fn main() -> i32 {
    let raw_len: i64 = len(RAW_GREETING) as i64;
    let mut val_sum: i64 = 0i64;
    let mut len_sum: i64 = 0i64;
    let mut i: usize = 0;
    while i < 3 {
        let ent = TABLE[i];
        let cb = ent.f;
        val_sum = val_sum + cb(ent.base);
        len_sum = len_sum + (len(ent.label) as i64);
        i = i + 1;
    }

    let d_res = (DEFAULT_FN)(9i64);
    let a_res1 = (unsafe { ACTIVE_FN })(6i64);
    unsafe {
        ACTIVE_FN = op_sq;
        BANNER = GREETING;
    }
    let a_res2 = (unsafe { ACTIVE_FN })(6i64);

    let bss_before = sum_bss();
    fill_bss();
    let bss_after = sum_bss();

    let g_copy = GREETING;
    let b_copy = unsafe { BANNER };
    print(g_copy.text);
    print(" | ");
    print(b_copy.text);
    print(" | ");
    print_int(raw_len);
    print(" ");
    print_int(val_sum);
    print(" ");
    print_int(len_sum);
    print(" ");
    print_int(d_res);
    print(" ");
    print_int(a_res1);
    print(" ");
    print_int(a_res2);
    print(" ");
    print_int(bss_before as i64);
    print(" ");
    print_int(bss_after as i64);
    print("\n");
    0
}
