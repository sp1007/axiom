@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

@PROBE_MIR_FN@

fn probe_blob(arena: mut_view<Arena>, idx: usize) -> StrView {
    let s: str = probe_mir_raw(idx);
    let raw_sv: StrView = unsafe { *(address_of(s) as *const StrView) };
    let bytes: view<[u8]> = unsafe { *(address_of(s) as *const view<[u8]>) };
    let n = raw_sv.len;
    let dst = arena_alloc_raw(mut_view(*arena), n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = bytes[i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn empty_node_map() -> NodeMap {
    NodeMap { keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0 }
}

fn new_arena(chunk: usize) -> Arena {
    let mut a = arena_with_chunk_size(chunk);
    let _ = arena_alloc_raw(mut_view(a), 16, 8);
    a
}

fn probe_init_fe_session(perm_arena: mut_view<Arena>) -> *mut CompilerSession {
    let sess_ptr = arena_alloc_raw(mut_view(*perm_arena), size_of<CompilerSession>(), align_of<CompilerSession>()) as *mut CompilerSession;
    let str_bytes_arena = new_arena(262144);
    let str_cap: usize = 2048;
    let str_arr = arena_alloc_raw(mut_view(*perm_arena), mir_mul_usize(str_cap, size_of<StrView>()), align_of<StrView>()) as *mut StrView;
    let smap_cap: usize = 4096;
    let smap_hashes = arena_alloc_raw(mut_view(*perm_arena), mir_mul_usize(smap_cap, 8), 8) as *mut u64;
    let smap_ids = arena_alloc_raw(mut_view(*perm_arena), mir_mul_usize(smap_cap, 4), 4) as *mut u32;
    unsafe {
        session_init(mut_view(*sess_ptr));
        arena_destroy(mut_view((*sess_ptr).interner.bytes));
        (*sess_ptr).interner.bytes = str_bytes_arena;
        (*sess_ptr).interner.strings = str_arr;
        (*sess_ptr).interner.cap = str_cap;
        (*sess_ptr).interner.map_hashes = smap_hashes;
        (*sess_ptr).interner.map_ids = smap_ids;
        (*sess_ptr).interner.map_cap = smap_cap;
        // T543: the interner probe loop treats slot id 0 as empty; arena memory is not zeroed (UB-04).
        let mut smap_zoff: usize = 0;
        let smap_zend: usize = smap_cap * 4;
        while smap_zoff < smap_zend {
            *((smap_ids as usize + smap_zoff) as *mut u32) = 0u32;
            smap_zoff = smap_zoff + 4;
        }
    }
    sess_ptr
}

fn probe_free_fe_session(sess_ptr: *mut CompilerSession) {
    unsafe {
        (*sess_ptr).interner.cap = 0;
        (*sess_ptr).interner.map_cap = 0;
        session_free(mut_view(*sess_ptr));
    }
}

// First `MIR_LOCAL_STATIC` local of `m` (0 when none) and its `const_sym`.
fn first_static_local(m: *mut MirBody, out_sym: mut_view<u32>) -> u32 {
    let n = unsafe { (*m).local_count };
    let mut i: usize = 0;
    while i < n {
        let d = unsafe { mir_local_at((*m).locals, i) };
        if (unsafe { (*d).kind }) == MIR_LOCAL_STATIC {
            *out_sym = unsafe { (*d).const_sym.v };
            return i as u32;
        }
        i = i + 1;
    }
    *out_sym = 0u32;
    0u32
}

fn static_local_for_sym(m: *mut MirBody, sym_v: u32, skip: u32) -> u32 {
    let n = unsafe { (*m).local_count };
    let mut i: usize = 0;
    while i < n {
        let d = unsafe { mir_local_at((*m).locals, i) };
        if (unsafe { (*d).kind }) == MIR_LOCAL_STATIC && (unsafe { (*d).const_sym.v }) == sym_v && (i as u32) != skip {
            return i as u32;
        }
        i = i + 1;
    }
    0u32
}

fn count_static_locals_for_sym(m: *mut MirBody, sym_v: u32) -> u32 {
    let n = unsafe { (*m).local_count };
    let mut cnt: u32 = 0u32;
    let mut i: usize = 0;
    while i < n {
        let d = unsafe { mir_local_at((*m).locals, i) };
        if (unsafe { (*d).kind }) == MIR_LOCAL_STATIC && (unsafe { (*d).const_sym.v }) == sym_v {
            cnt = cnt + 1u32;
        }
        i = i + 1;
    }
    cnt
}

// Index of the first basic block whose terminator calls the constant function `callee_sym_v` (`usize` max when none).
fn find_call_bb(m: *mut MirBody, callee_sym_v: u32) -> usize {
    let n = unsafe { (*m).bb_count };
    let mut b: usize = 0;
    while b < n {
        let bb = unsafe { mir_bb_at((*m).bbs, b) };
        if (unsafe { (*bb).has_terminator }) && (unsafe { (*bb).terminator.kind }) == MIR_TERM_CALL {
            if (unsafe { (*bb).terminator.func.kind }) == MIR_OP_CONST &&
               (unsafe { (*bb).terminator.func.constant.sym.v }) == callee_sym_v {
                return b;
            }
        }
        b = b + 1;
    }
    0xFFFFFFFFusize
}

// Runs the memopt pass on node `idx`'s OptBody (alias info built with the call-graph effect table) and returns
// `forwarded_loads + eliminated_redundant_loads`, or -1 when the OptBody cannot be built.
fn run_memopt_on_node(
    cg: *mut CallGraph,
    idx: usize,
    thir_fe: *mut Thir,
    ct_fe: *mut EffectCallTable,
    arena: mut_view<Arena>,
    sink_fe: *mut DiagSink
) -> i32 {
    let m = unsafe { (*cg_node_at((*cg).nodes, idx)).mir };
    let it = unsafe { (*cg_node_at((*cg).nodes, idx)).fn_item };
    let ob: *mut OptBody = optir_build_from_mir(unsafe { view(*m) }, thir_fe as *const Thir, mut_view(*arena), unsafe { mut_view(*sink_fe) }, it);
    if (ob as usize) == 0 {
        return -1;
    }
    let pm = arena_alloc_raw(mut_view(*arena), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
    passmgr_init(unsafe { mut_view(*pm) }, opt_budget_for_profile(OPT_PROFILE_SPEED_O2, true), mut_view(*arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm) }, unsafe { mut_view(*ob) }, mut_view(*arena));
    let info = alias_build_info(unsafe { view(*ob) }, ct_fe as *const EffectCallTable, mut_view(*arena));
    let mut stats: MemOptStats = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<MemOptStats>(), align_of<MemOptStats>()) as *const MemOptStats) };
    memopt_stats_zero(mut_view(stats));
    let _ = memopt_run_pass_with_info(
        unsafe { mut_view(*pm) },
        unsafe { mut_view(*ob) },
        unsafe { mut_view(*info) },
        ct_fe as *const EffectCallTable,
        mut_view(stats),
        0 as *mut MemOptLog,
        mut_view(*arena),
        unsafe { mut_view(*sink_fe) }
    );
    (stats.forwarded_loads + stats.eliminated_redundant_loads) as i32
}

fn add_static_dup(m: *mut MirBody, arena: mut_view<Arena>, src_local: u32, sym_v: u32) -> u32 {
    let d = unsafe { mir_local_at((*m).locals, src_local as usize) };
    let lid = mir_add_local(
        unsafe { mut_view(*m) },
        mut_view(*arena),
        unsafe { (*d).ty },
        MIR_LOCAL_STATIC,
        true,
        unsafe { (*d).name },
        unsafe { view((*d).span) }
    );
    let nd = unsafe { mir_local_at((*m).locals, lid.v as usize) };
    unsafe { (*nd).const_sym.v = sym_v; }
    lid.v
}

fn probe_static_summaries_inline_alias() -> i32 {
    let mut perm_a = new_arena(524288);
    let mut parse_a = new_arena(262144);
    let mut res_a = new_arena(262144);
    let mut hir_a = new_arena(262144);
    let mut mir_a = new_arena(1048576);
    let sess = probe_init_fe_session(mut_view(perm_a));
    let thir_fe = arena_alloc_raw(mut_view(perm_a), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    unsafe { thir_init(mut_view(*thir_fe)); }
    let mut rmap = ResolveMap {
        node_map: empty_node_map(), module_access_nodes: empty_node_map(), extern_nodes: empty_node_map(),
        next_symbol_v: 1u32, next_std_symbol_v: 10000u32, naming_ctx: 0 as *mut NamingCtx,
    };

    let path_sv = probe_blob(mut_view(perm_a), 0);
    let src_sv = probe_blob(mut_view(perm_a), 1);
    let mut fid = FileId { v: 0u32 };
    let pres = session_parse_virtual_file(unsafe { mut_view(*sess) }, mut_view(parse_a), path_sv, src_sv, mut_view(fid));
    session_resolve_ast_into(unsafe { mut_view(*sess) }, mut_view(res_a), view(pres.ast), mut_view(rmap));
    let hir = session_lower_hir(unsafe { mut_view(*sess) }, mut_view(hir_a), view(pres.ast), view(rmap));
    unsafe { session_typeck_into(mut_view(*sess), view(hir), mut_view(*thir_fe)); }
    let mut rc: i32 = 0;
    if (unsafe { (*sess).diag_sink.errors }) != 0 {
        rc = 301;
    }

    let str_in_ptr = unsafe { address_of_mut((*sess).interner) as *mut StrInterner };
    let db_ptr = unsafe { address_of((*sess).source_db) as *const SourceDatabase };
    let sink_fe = unsafe { address_of_mut((*sess).diag_sink) as *mut DiagSink };
    let hir_ptr = unsafe { address_of(hir.items) as *const HirFile };
    let ct_fe = arena_alloc_raw(mut_view(mir_a), size_of<EffectCallTable>(), align_of<EffectCallTable>()) as *mut EffectCallTable;
    effect_call_table_init(unsafe { mut_view(*ct_fe) }, mut_view(mir_a), 32);
    let esc_tbl = arena_alloc_raw(mut_view(mir_a), size_of<EscapeSummaryTable>(), align_of<EscapeSummaryTable>()) as *mut EscapeSummaryTable;
    escape_summary_table_init(unsafe { mut_view(*esc_tbl) }, mut_view(mir_a), 32);
    let cg: *mut CallGraph = callgraph_new(mut_view(mir_a), thir_fe as *const Thir, true, false);

    // Functions of Blob 1 in declaration order:
    //   0 pure_add, 1 set_g, 2 get_g, 3 bump_h, 4 caller_noinl, 5 caller_inl, 6 alias_host, 7 twice_g, 8 entry_root (root)
    let mut fn_idx: usize = 0;
    if rc == 0 {
        let mut it: *mut HirItem = hir.items;
        while (it as usize) != 0 {
            if (unsafe { (*it).kind }) == HIR_ITEM_FN && ((unsafe { (*it).attrs }) as usize) == 0 {
                let mbody = mir_build_fn(mut_view(mir_a), it, thir_fe, hir_ptr, str_in_ptr, db_ptr, 0 as *mut MonoEngine);
                if (mbody as usize) == 0 {
                    rc = 302;
                    break;
                }
                let ob = optir_build_from_mir(unsafe { view(*mbody) }, thir_fe as *const Thir, mut_view(mir_a), unsafe { mut_view(*sink_fe) }, it as *const HirItem);
                let _ = callgraph_add_node(
                    unsafe { mut_view(*cg) }, mut_view(mir_a),
                    unsafe { (*it).symbol }, unsafe { (*it).name },
                    mbody, ob, it as *const HirItem,
                    INLINE_ATTR_NONE, false, fn_idx == 8, false, false, DOMAIN_CPU_HOST, false
                );
                fn_idx = fn_idx + 1;
            }
            it = unsafe { (*it).next };
        }
        if rc == 0 && fn_idx != 9 {
            rc = 303;
        }
    }

    if rc == 0 {
        callgraph_finalize(unsafe { mut_view(*cg) }, unsafe { mut_view(*ct_fe) }, unsafe { mut_view(*esc_tbl) }, mut_view(mir_a));
        let n0 = unsafe { cg_node_at((*cg).nodes, 0) };
        let n1 = unsafe { cg_node_at((*cg).nodes, 1) };
        let n2 = unsafe { cg_node_at((*cg).nodes, 2) };
        let n3 = unsafe { cg_node_at((*cg).nodes, 3) };
        let n4 = unsafe { cg_node_at((*cg).nodes, 4) };
        // Control: a function touching no global memory stays `EFFECT_PURE` / `CERTAINTY_PROVEN`.
        if (unsafe { (*n0).effect_summary.flags }) != EFFECT_PURE ||
           (unsafe { (*n0).effect_summary.pure_certainty }) != CERTAINTY_PROVEN {
            rc = 310;
        // F1: `set_g` (`G = v`) writes process-wide memory and is never a proven-pure call.
        } else if ((unsafe { (*n1).effect_summary.flags }) & EFFECT_WRITES_MEM) == 0u16 ||
                  (unsafe { (*n1).effect_summary.pure_certainty }) == CERTAINTY_PROVEN {
            rc = 311;
        // F1: `get_g` (`G`) reads process-wide memory.
        } else if ((unsafe { (*n2).effect_summary.flags }) & EFFECT_READS_MEM) == 0u16 ||
                  (unsafe { (*n2).effect_summary.pure_certainty }) == CERTAINTY_PROVEN {
            rc = 312;
        // F1: `bump_h` (`H = H + 1`, unit result) reads and writes.
        } else if ((unsafe { (*n3).effect_summary.flags }) & (EFFECT_READS_MEM | EFFECT_WRITES_MEM)) != (EFFECT_READS_MEM | EFFECT_WRITES_MEM) ||
                  (unsafe { (*n3).effect_summary.pure_certainty }) == CERTAINTY_PROVEN {
            rc = 313;
        // F1: the write effect propagates to callers along call edges.
        } else if ((unsafe { (*n4).effect_summary.flags }) & EFFECT_WRITES_MEM) == 0u16 {
            rc = 314;
        }
        if rc == 0 {
            print("PROBE_STATIC_EFFECT_SUMMARIES=OK\n");
        } else {
            let mut k: usize = 0;
            while k < 5 {
                let nk = unsafe { cg_node_at((*cg).nodes, k) };
                print("node");
                print_int(k as i64);
                print(" flags=");
                print_int((unsafe { (*nk).effect_summary.flags }) as i64);
                print(" pure_cert=");
                print_int((unsafe { (*nk).effect_summary.pure_certainty }) as i64);
                print("\n");
                k = k + 1;
            }
        }
    }

    // F1 downstream: memopt (alias info built with the call-graph effect table) neither forwards nor eliminates the
    // `G` reload after the non-inlined `set_g` call.
    if rc == 0 {
        let fwd_rle_noinl = run_memopt_on_node(cg, 4, thir_fe, ct_fe, mut_view(mir_a), sink_fe);
        if fwd_rle_noinl < 0 {
            rc = 320;
        } else if fwd_rle_noinl != 0 {
            rc = 321;
        } else {
            print("PROBE_STATIC_MEMOPT_CALL_CLOBBER=OK\n");
        }
    }

    // F2.1: inlining `set_g` into `caller_inl` (which already declares `G`) reuses the caller's `MIR_LOCAL_STATIC`.
    if rc == 0 {
        let callee = unsafe { (*cg_node_at((*cg).nodes, 1)).mir };
        let caller = unsafe { (*cg_node_at((*cg).nodes, 5)).mir };
        let set_g_sym = unsafe { (*cg_node_at((*cg).nodes, 1)).fn_sym.v };
        let mut g_sym: u32 = 0u32;
        let g_callee = first_static_local(callee, mut_view(g_sym));
        if g_callee == 0u32 || g_sym == 0u32 {
            rc = 330;
        } else if count_static_locals_for_sym(caller, g_sym) != 1u32 {
            rc = 331;
        } else {
            let cbb = find_call_bb(caller, set_g_sym);
            if cbb == 0xFFFFFFFFusize {
                rc = 332;
            } else if !inline_clone_callsite_in_mir(unsafe { mut_view(*caller) }, unsafe { view(*callee) }, cbb, thir_fe as *const Thir, mut_view(mir_a)) {
                rc = 333;
            } else if count_static_locals_for_sym(caller, g_sym) != 1u32 {
                rc = 334;
            } else if find_call_bb(caller, set_g_sym) != 0xFFFFFFFFusize {
                rc = 335;
            } else {
                print("PROBE_STATIC_INLINE_DEDUP=OK\n");
            }
        }
    }

    // F2.2: two `MIR_LOCAL_STATIC` locals naming the same global never prove `ALIAS_NO_ALIAS`; unnamed statics
    // (`const_sym == 0`) stay conservative; distinct named globals remain provably disjoint.
    if rc == 0 {
        let mh = unsafe { (*cg_node_at((*cg).nodes, 6)).mir };
        let ith = unsafe { (*cg_node_at((*cg).nodes, 6)).fn_item };
        let mut first_sym: u32 = 0u32;
        let l_first = first_static_local(mh, mut_view(first_sym));
        let l_other = if l_first == 0u32 { 0u32 } else {
            let mut j: usize = (l_first as usize) + 1;
            let mut found: u32 = 0u32;
            while j < (unsafe { (*mh).local_count }) {
                let d = unsafe { mir_local_at((*mh).locals, j) };
                if (unsafe { (*d).kind }) == MIR_LOCAL_STATIC && (unsafe { (*d).const_sym.v }) != first_sym {
                    found = j as u32;
                    break;
                }
                j = j + 1;
            }
            found
        };
        if l_first == 0u32 || first_sym == 0u32 || l_other == 0u32 {
            rc = 340;
        } else {
            let l_dup = add_static_dup(mh, mut_view(mir_a), l_first, first_sym);
            let l_anon_a = add_static_dup(mh, mut_view(mir_a), l_first, 0u32);
            let l_anon_b = add_static_dup(mh, mut_view(mir_a), l_first, 0u32);
            if static_local_for_sym(mh, first_sym, l_first) != l_dup {
                rc = 341;
            } else {
                let obh: *mut OptBody = optir_build_from_mir(unsafe { view(*mh) }, thir_fe as *const Thir, mut_view(mir_a), unsafe { mut_view(*sink_fe) }, ith);
                if (obh as usize) == 0 {
                    rc = 342;
                } else {
                    let info = alias_build_info(unsafe { view(*obh) }, ct_fe as *const EffectCallTable, mut_view(mir_a));
                    let pt0 = alias_make_prog_pt(0u32, 0u32);
                    let p_first = mir_local_place(l_first);
                    let p_dup = mir_local_place(l_dup);
                    let p_other = mir_local_place(l_other);
                    let p_anon_a = mir_local_place(l_anon_a);
                    let p_anon_b = mir_local_place(l_anon_b);
                    let f_same = alias_query_places(unsafe { view(*info) }, unsafe { view(*obh) }, mut_view(mir_a), view(p_first), view(p_dup), pt0);
                    let f_anon = alias_query_places(unsafe { view(*info) }, unsafe { view(*obh) }, mut_view(mir_a), view(p_anon_a), view(p_anon_b), pt0);
                    let f_diff = alias_query_places(unsafe { view(*info) }, unsafe { view(*obh) }, mut_view(mir_a), view(p_first), view(p_other), pt0);
                    if f_same.result != ALIAS_MUST_ALIAS {
                        rc = 343;
                    } else if f_anon.result == ALIAS_NO_ALIAS {
                        rc = 344;
                    } else if f_diff.result != ALIAS_NO_ALIAS {
                        rc = 345;
                    } else {
                        print("PROBE_STATIC_ALIAS_IDENTITY=OK\n");
                    }
                }
            }
        }
    }

    resolve_map_free(mut_view(rmap));
    unsafe { thir_free(mut_view(*thir_fe)); }
    probe_free_fe_session(sess);
    arena_destroy(mut_view(mir_a)); arena_destroy(mut_view(hir_a)); arena_destroy(mut_view(res_a));
    arena_destroy(mut_view(parse_a)); arena_destroy(mut_view(perm_a));
    rc
}

pub fn main() -> i32 {
    let rc = probe_static_summaries_inline_alias();
    if rc != 0 {
        print("PROBE_FAIL rc=");
        print_int(rc as i64);
        print("\n");
        return rc;
    }
    print("PROBE_ALL=OK\n");
    0
}
