use compiler.mir.mir.MIR_TERM_CALL
use compiler.mir.mir.MirBody
use compiler.mir.mir.MirLocalId
use compiler.mir.mir.mir_add_local
use compiler.mir.mir.mir_bb_at
use compiler.mir.mir.mir_local_at
use compiler.mir.mir.mir_local_place
use compiler.mir.mir.mir_mul_usize
use compiler.mir.builder.mir_build_fn
use compiler.opt.optir.ALIAS_MUST_ALIAS
use compiler.opt.optir.ALIAS_NO_ALIAS
use compiler.opt.optir.CERTAINTY_PROVEN
use compiler.opt.optir.EFFECT_PURE
use compiler.opt.optir.EFFECT_READS_MEM
use compiler.opt.optir.EFFECT_WRITES_MEM
use compiler.opt.optir.OptBody
use compiler.opt.optir.optir_build_from_mir
