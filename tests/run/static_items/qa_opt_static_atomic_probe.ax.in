@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

@PROBE_MIR_FN@

fn probe_blob(arena: mut_view<Arena>, idx: usize) -> StrView {
    let s: str = probe_mir_raw(idx);
    let raw_sv: StrView = unsafe { *(address_of(s) as *const StrView) };
    let bytes: view<[u8]> = unsafe { *(address_of(s) as *const view<[u8]>) };
    let n = raw_sv.len;
    let dst = arena_alloc_raw(mut_view(*arena), n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = bytes[i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn empty_node_map() -> NodeMap {
    NodeMap { keys: 0 as *mut usize, vals: 0 as *mut SymbolId, states: 0 as *mut u8, len: 0, cap: 0 }
}

fn new_arena(chunk: usize) -> Arena {
    let mut a = arena_with_chunk_size(chunk);
    let _ = arena_alloc_raw(mut_view(a), 16, 8);
    a
}

fn probe_init_fe_session(perm_arena: mut_view<Arena>) -> *mut CompilerSession {
    let sess_ptr = arena_alloc_raw(mut_view(*perm_arena), size_of<CompilerSession>(), align_of<CompilerSession>()) as *mut CompilerSession;
    let str_bytes_arena = new_arena(262144);
    let str_cap: usize = 2048;
    let str_arr = arena_alloc_raw(mut_view(*perm_arena), mir_mul_usize(str_cap, size_of<StrView>()), align_of<StrView>()) as *mut StrView;
    let smap_cap: usize = 4096;
    let smap_hashes = arena_alloc_raw(mut_view(*perm_arena), mir_mul_usize(smap_cap, 8), 8) as *mut u64;
    let smap_ids = arena_alloc_raw(mut_view(*perm_arena), mir_mul_usize(smap_cap, 4), 4) as *mut u32;
    unsafe {
        session_init(mut_view(*sess_ptr));
        arena_destroy(mut_view((*sess_ptr).interner.bytes));
        (*sess_ptr).interner.bytes = str_bytes_arena;
        (*sess_ptr).interner.strings = str_arr;
        (*sess_ptr).interner.cap = str_cap;
        (*sess_ptr).interner.map_hashes = smap_hashes;
        (*sess_ptr).interner.map_ids = smap_ids;
        (*sess_ptr).interner.map_cap = smap_cap;
    }
    sess_ptr
}

fn probe_free_fe_session(sess_ptr: *mut CompilerSession) {
    unsafe {
        (*sess_ptr).interner.cap = 0;
        (*sess_ptr).interner.map_cap = 0;
        session_free(mut_view(*sess_ptr));
    }
}

// Classifies every `MIR_LOCAL_STATIC` local of node `idx` by alias domain. Returns 0 when
//   * every `mut` static is DOMAIN_GLOBAL_STATIC,
//   * every immutable struct-typed static (the Atomic-containing `CELL`) is DOMAIN_GLOBAL_STATIC + escaped_external,
//   * every immutable scalar static (`PLAIN`) is DOMAIN_CONST_RDATA,
// and at least one local of each class was seen; otherwise a non-zero code.
fn check_static_domains(cg: *mut CallGraph, idx: usize, thir_fe: *mut Thir, ct_fe: *mut EffectCallTable,
                        arena: mut_view<Arena>, sink_fe: *mut DiagSink) -> i32 {
    let m: *mut MirBody = unsafe { (*cg_node_at((*cg).nodes, idx)).mir };
    let it = unsafe { (*cg_node_at((*cg).nodes, idx)).fn_item };
    let ob: *mut OptBody = optir_build_from_mir(unsafe { view(*m) }, thir_fe as *const Thir, mut_view(*arena), unsafe { mut_view(*sink_fe) }, it);
    if (ob as usize) == 0 {
        return 420;
    }
    let info: *mut AliasInfo = alias_build_info(unsafe { view(*ob) }, ct_fe as *const EffectCallTable, mut_view(*arena));
    let mut seen_mut: u32 = 0u32;
    let mut seen_atomic: u32 = 0u32;
    let mut seen_plain: u32 = 0u32;
    let n = unsafe { (*m).local_count };
    let mut i: usize = 0;
    while i < n {
        let d = unsafe { mir_local_at((*m).locals, i) };
        if (unsafe { (*d).kind }) == MIR_LOCAL_STATIC {
            if i >= (unsafe { (*info).local_count }) {
                return 421;
            }
            let lp = unsafe { alias_local_prov_at((*info).locals, i) };
            let dom = unsafe { (*lp).domain };
            let tp = type_get(unsafe { view((*thir_fe).interner) }, TypeId { v: unsafe { (*d).ty.v } });
            let is_struct = (tp as usize) != 0 && (unsafe { (*tp).kind }) == TY_STRUCT;
            if unsafe { (*d).mut_flag } {
                seen_mut = seen_mut + 1u32;
                if dom != DOMAIN_GLOBAL_STATIC {
                    return 422;
                }
            } else if is_struct {
                seen_atomic = seen_atomic + 1u32;
                if dom != DOMAIN_GLOBAL_STATIC {
                    print("atomic static domain=");
                    print_int(dom as i64);
                    print("\n");
                    return 423;
                }
                if !(unsafe { (*lp).escaped_external }) || !(unsafe { (*lp).raw_addr_exposed }) {
                    return 424;
                }
            } else {
                seen_plain = seen_plain + 1u32;
                if dom != DOMAIN_CONST_RDATA {
                    print("plain static domain=");
                    print_int(dom as i64);
                    print("\n");
                    return 425;
                }
            }
        }
        i = i + 1;
    }
    if seen_mut == 0u32 || seen_atomic == 0u32 || seen_plain == 0u32 {
        print("seen mut=");
        print_int(seen_mut as i64);
        print(" atomic=");
        print_int(seen_atomic as i64);
        print(" plain=");
        print_int(seen_plain as i64);
        print("\n");
        return 426;
    }
    0
}

// `session_parse_virtual_file` frees the lexer arena after parsing, so string-literal attribute arguments of the
// virtual file dangle (pre-existing probe-path artefact; the driver keeps them alive). Re-point every 6-byte
// string attribute argument of a struct (here only `@lang("atomic")`) at a live copy of "atomic" so the optimizer
// sees the same HIR as in a real compile.
fn probe_fix_lang_atomic_literals(items: *mut HirItem, arena: mut_view<Arena>) -> u32 {
    let mut fixed: u32 = 0u32;
    let mut it: *mut HirItem = items;
    while (it as usize) != 0 {
        if (unsafe { (*it).kind }) == HIR_ITEM_STRUCT {
            let mut attr: *mut HirAttr = unsafe { (*it).attrs };
            while (attr as usize) != 0 {
                let args: *mut HirAttrArg = unsafe { (*attr).args };
                if (args as usize) != 0 {
                    let expr: *mut HirExpr = unsafe { (*args).expr };
                    if (expr as usize) != 0 && (unsafe { (*expr).kind }) == HIR_EXPR_LITERAL &&
                       (unsafe { (*expr).literal.str_len }) == 6 {
                        let dst = arena_alloc_raw(mut_view(*arena), 8, 1);
                        unsafe {
                            *(dst + 0) = 97u8; *(dst + 1) = 116u8; *(dst + 2) = 111u8;
                            *(dst + 3) = 109u8; *(dst + 4) = 105u8; *(dst + 5) = 99u8; *(dst + 6) = 0u8;
                            (*expr).literal.str_ptr = dst as *const u8;
                        }
                        fixed = fixed + 1u32;
                    }
                }
                attr = unsafe { (*attr).next };
            }
        }
        it = unsafe { (*it).next };
    }
    fixed
}

fn probe_atomic_static() -> i32 {
    let mut perm_a = new_arena(524288);
    let mut parse_a = new_arena(262144);
    let mut res_a = new_arena(262144);
    let mut hir_a = new_arena(262144);
    let mut mir_a = new_arena(1048576);
    let sess = probe_init_fe_session(mut_view(perm_a));
    let thir_fe = arena_alloc_raw(mut_view(perm_a), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    unsafe { thir_init(mut_view(*thir_fe)); }
    let mut rmap = ResolveMap {
        node_map: empty_node_map(), module_access_nodes: empty_node_map(), extern_nodes: empty_node_map(),
        next_symbol_v: 1u32, next_std_symbol_v: 10000u32, naming_ctx: 0 as *mut NamingCtx,
    };

    let path_sv = probe_blob(mut_view(perm_a), 0);
    let src_sv = probe_blob(mut_view(perm_a), 1);
    let mut fid = FileId { v: 0u32 };
    let pres = session_parse_virtual_file(unsafe { mut_view(*sess) }, mut_view(parse_a), path_sv, src_sv, mut_view(fid));
    session_resolve_ast_into(unsafe { mut_view(*sess) }, mut_view(res_a), view(pres.ast), mut_view(rmap));
    let hir = session_lower_hir(unsafe { mut_view(*sess) }, mut_view(hir_a), view(pres.ast), view(rmap));
    unsafe { session_typeck_into(mut_view(*sess), view(hir), mut_view(*thir_fe)); }
    let mut rc: i32 = 0;
    if (unsafe { (*sess).diag_sink.errors }) != 0 {
        rc = 401;
    }
    if rc == 0 && probe_fix_lang_atomic_literals(hir.items, mut_view(perm_a)) != 1u32 {
        rc = 404;
    }

    let str_in_ptr = unsafe { address_of_mut((*sess).interner) as *mut StrInterner };
    let db_ptr = unsafe { address_of((*sess).source_db) as *const SourceDatabase };
    let sink_fe = unsafe { address_of_mut((*sess).diag_sink) as *mut DiagSink };
    let hir_ptr = unsafe { address_of(hir.items) as *const HirFile };
    let ct_fe = arena_alloc_raw(mut_view(mir_a), size_of<EffectCallTable>(), align_of<EffectCallTable>()) as *mut EffectCallTable;
    effect_call_table_init(unsafe { mut_view(*ct_fe) }, mut_view(mir_a), 32);
    let esc_tbl = arena_alloc_raw(mut_view(mir_a), size_of<EscapeSummaryTable>(), align_of<EscapeSummaryTable>()) as *mut EscapeSummaryTable;
    escape_summary_table_init(unsafe { mut_view(*esc_tbl) }, mut_view(mir_a), 32);
    let cg: *mut CallGraph = callgraph_new(mut_view(mir_a), thir_fe as *const Thir, true, false);

    // Functions of Blob 1 in declaration order: 0 touch_cell, 1 read_plain, 2 host_all, 3 entry_root (root)
    let mut fn_idx: usize = 0;
    if rc == 0 {
        let mut it: *mut HirItem = hir.items;
        while (it as usize) != 0 {
            if (unsafe { (*it).kind }) == HIR_ITEM_FN && ((unsafe { (*it).attrs }) as usize) == 0 {
                let mbody = mir_build_fn(mut_view(mir_a), it, thir_fe, hir_ptr, str_in_ptr, db_ptr, 0 as *mut MonoEngine);
                if (mbody as usize) == 0 {
                    rc = 402;
                    break;
                }
                let ob = optir_build_from_mir(unsafe { view(*mbody) }, thir_fe as *const Thir, mut_view(mir_a), unsafe { mut_view(*sink_fe) }, it as *const HirItem);
                let _ = callgraph_add_node(
                    unsafe { mut_view(*cg) }, mut_view(mir_a),
                    unsafe { (*it).symbol }, unsafe { (*it).name },
                    mbody, ob, it as *const HirItem,
                    INLINE_ATTR_NONE, false, fn_idx == 3, false, false, DOMAIN_CPU_HOST, false
                );
                fn_idx = fn_idx + 1;
            }
            it = unsafe { (*it).next };
        }
        if rc == 0 && fn_idx != 4 {
            rc = 403;
        }
    }

    if rc == 0 {
        callgraph_finalize(unsafe { mut_view(*cg) }, unsafe { mut_view(*ct_fe) }, unsafe { mut_view(*esc_tbl) }, mut_view(mir_a));
        let n0 = unsafe { cg_node_at((*cg).nodes, 0) };
        let n1 = unsafe { cg_node_at((*cg).nodes, 1) };
        // A shared borrow of an Atomic-containing immutable static may mutate it (interior mutability).
        if ((unsafe { (*n0).effect_summary.flags }) & EFFECT_WRITES_MEM) == 0u16 ||
           (unsafe { (*n0).effect_summary.pure_certainty }) == CERTAINTY_PROVEN {
            rc = 411;
        // A read of a plain immutable static reads global memory but never writes it.
        } else if ((unsafe { (*n1).effect_summary.flags }) & EFFECT_READS_MEM) == 0u16 ||
                  ((unsafe { (*n1).effect_summary.flags }) & EFFECT_WRITES_MEM) != 0u16 ||
                  (unsafe { (*n1).effect_summary.pure_certainty }) == CERTAINTY_PROVEN {
            rc = 412;
        }
        if rc == 0 {
            print("PROBE_ATOMIC_STATIC_SUMMARY=OK\n");
        } else {
            let mut k: usize = 0;
            while k < 4 {
                let nk = unsafe { cg_node_at((*cg).nodes, k) };
                print("node");
                print_int(k as i64);
                print(" flags=");
                print_int((unsafe { (*nk).effect_summary.flags }) as i64);
                print(" pure_cert=");
                print_int((unsafe { (*nk).effect_summary.pure_certainty }) as i64);
                print("\n");
                k = k + 1;
            }
        }
    }

    if rc == 0 {
        rc = check_static_domains(cg, 2, thir_fe, ct_fe, mut_view(mir_a), sink_fe);
        if rc == 0 {
            print("PROBE_ATOMIC_STATIC_DOMAIN=OK\n");
        }
    }

    resolve_map_free(mut_view(rmap));
    unsafe { thir_free(mut_view(*thir_fe)); }
    probe_free_fe_session(sess);
    arena_destroy(mut_view(mir_a)); arena_destroy(mut_view(hir_a)); arena_destroy(mut_view(res_a));
    arena_destroy(mut_view(parse_a)); arena_destroy(mut_view(perm_a));
    rc
}

pub fn main() -> i32 {
    let rc = probe_atomic_static();
    if rc != 0 {
        print("PROBE_FAIL rc=");
        print_int(rc as i64);
        print("\n");
        return rc;
    }
    print("PROBE_ALL=OK\n");
    0
}
