// test: run
// exit: 0
// stdout: 4 1\n5 3\n12 -7\n9 0\n6 1\n42\n
// T499a: tuple expressions whose elements name let locals and parameters, with and without an annotated type,
// mixed literal/variable elements, a parameter named like a type-ish identifier (`s64`), and `(x,)`.
fn from_param(s64: i64) -> i64 {
    let t: (i64, i32) = (s64, 3i32)
    print_int(t.0)
    print(" ")
    print_int(t.1 as i64)
    print("\n")
    t.0
}

fn two_params(a: i64, b: i64) {
    let t = (a, b)
    print_int(t.0)
    print(" ")
    print_int(t.1)
    print("\n")
}

fn main() -> i32 {
    let total = 4i64
    let t = (total, true)
    print_int(t.0)
    print(" ")
    if t.1 {
        print_int(1i64)
    }
    print("\n")
    let _ = from_param(5i64)
    two_params(12i64, -7i64)
    let x = 9i64
    let m: (i64, i64) = (x, 0i64)
    print_int(m.0)
    print(" ")
    print_int(m.1)
    print("\n")
    let y = 6i64
    let z = 1i32
    let mixed = (y, z)
    print_int(mixed.0)
    print(" ")
    print_int(mixed.1 as i64)
    print("\n")
    let w = 42i64
    let one = (w,)
    print_int(one.0)
    print("\n")
    0
}
