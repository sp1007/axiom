// QA (T499a gate): a module-level `const` whose initialiser is a tuple expression naming two other consts.
// (A `static` of tuple type is AX_TYPE_UNSUPPORTED_IN_BOOTSTRAP even with literal elements: independent of T499a.)
const BASE_A: i64 = 10i64
const BASE_B: i64 = 20i64
const PAIR: (i64, i64) = (BASE_A, BASE_B)

fn main() -> i32 {
    print_int(PAIR.0 + PAIR.1)
    print("\n")
    0
}
