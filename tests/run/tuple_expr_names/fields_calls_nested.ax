// test: run
// exit: 0
// stdout: 3 4\n21 2\n1 2 3\n10 20 30\n
// T499a: tuple elements that are struct fields, call results, nested tuples built from variables, and a tuple
// built from another tuple's elements.
struct Pt { x: i64, y: i64 }

fn sq(v: i64) -> i64 { v * v }

fn main() -> i32 {
    let p = Pt { x: 3i64, y: 4i64 }
    let t = (p.x, p.y)
    print_int(t.0)
    print(" ")
    print_int(t.1)
    print("\n")
    let k = 2i64
    let c = (sq(k) + 17i64, k)
    print_int(c.0)
    print(" ")
    print_int(c.1)
    print("\n")
    let one = 1i64
    let two = 2i64
    let three = 3i64
    let n = ((one, two), three)
    print_int((n.0).0)
    print(" ")
    print_int((n.0).1)
    print(" ")
    print_int(n.1)
    print("\n")
    let base = (10i64, 20i64)
    let ten = base.0
    let again: (i64, (i64, i64)) = (ten, (base.1, base.0 + base.1))
    print_int(again.0)
    print(" ")
    print_int((again.1).0)
    print(" ")
    print_int((again.1).1)
    print("\n")
    0
}
