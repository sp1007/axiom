// test: run
// exit: 0
// stdout: 7 8 9\n3 4\n1 2 1\n5 6\n11 22\n4 5\n
// QA (T499a gate): names in tuple expressions in positions the engineer did not cover: first/middle/last of a
// 3-tuple, nested tuple with names at both depths, shadowing inside an element block (the later `x` after the block
// is the outer one), a generic function building (T, T) from parameters, a struct method call and field access
// as elements, and a tuple of fn paths applied afterwards.

struct P {
    a: i64,
    b: i64,
}

impl P {
    fn sum(self: view<P>) -> i64 {
        self.a + self.b
    }
}

fn dbl(v: i64) -> i64 {
    v * 2
}

fn inc(v: i64) -> i64 {
    v + 1
}

fn mk<T>(a: T, b: T) -> (T, T) {
    (a, b)
}

fn main() -> i32 {
    let a = 7i64
    let b = 8i64
    let c = 9i64
    let t3 = (a, b, c)
    print_int(t3.0)
    print(" ")
    print_int(t3.1)
    print(" ")
    print_int(t3.2)
    print("\n")

    let n = ((a - 4i64, b - 4i64), c)
    print_int((n.0).0)
    print(" ")
    print_int((n.0).1)
    print("\n")

    let x = 1i64
    let sh = (x, { let x = 2i64; x }, x)
    print_int(sh.0)
    print(" ")
    print_int(sh.1)
    print(" ")
    print_int(sh.2)
    print("\n")

    let g = mk(5i64, 6i64)
    print_int(g.0)
    print(" ")
    print_int(g.1)
    print("\n")

    let p = P { a: 5i64, b: 6i64 }
    let mc = (p.sum(), dbl(p.b) + p.a + 5i64)
    print_int(mc.0)
    print(" ")
    print_int(mc.1)
    print("\n")

    let fs = (dbl, inc)
    print_int((fs.0)(2i64))
    print(" ")
    print_int((fs.1)(4i64))
    print("\n")
    0
}
