// test: run
// exit: 0
// stdout: 7 1\n8 0\n15\n3 3\n-2\n
// T499a: a tuple expression naming variables as a function's return value (tail and `return`), as a call
// argument, and `(a, a)` with a Copy value used twice.
fn pair(a: i8, b: i8) -> (i8, bool) {
    let total: i8 = a + b
    (total, true)
}

fn pair_ret(v: i64) -> (i64, bool) {
    if v > 100i64 {
        return (v, true)
    }
    let w = v + 1i64
    return (w, false)
}

fn sum(p: (i64, i64)) -> i64 {
    p.0 + p.1
}

fn dup(a: i64) -> (i64, i64) {
    (a, a)
}

fn main() -> i32 {
    let p = pair(5i8, 2i8)
    print_int(p.0 as i64)
    print(" ")
    if p.1 { print_int(1i64) } else { print_int(0i64) }
    print("\n")
    let q = pair_ret(7i64)
    print_int(q.0)
    print(" ")
    if q.1 { print_int(1i64) } else { print_int(0i64) }
    print("\n")
    let a = 10i64
    let b = 5i64
    print_int(sum((a, b)))
    print("\n")
    let d = dup(3i64)
    print_int(d.0)
    print(" ")
    print_int(d.1)
    print("\n")
    let c = -2i64
    print_int(sum((c, 0i64)))
    print("\n")
    0
}
