// test: run
// exit: 0
// stdout: 5 9\nboth\nfirst 4\n14\n
// T499a: `let (a, b) = (x, y)` destructuring of a tuple built from variables, and tuple expressions of
// variables as `match` scrutinees.  T499b: the all-binding tuple arm `(p, q)` covers the scrutinee on its own, so no
// trailing `_` arm is needed.
fn classify(a: i64, b: i64) {
    match (a, b) {
        (0i64, 0i64) => print("none\n"),
        (x, 0i64) => {
            print("first ")
            print_int(x)
            print("\n")
        }
        _ => print("both\n"),
    }
}

fn main() -> i32 {
    let x = 9i64
    let y = 5i64
    let (a, b) = (y, x)
    print_int(a)
    print(" ")
    print_int(b)
    print("\n")
    classify(a, b)
    classify(4i64, 0i64)
    let s = match (a, b) {
        (p, 0i64) => p,
        (p, q) => p + q,
    }
    print_int(s)
    print("\n")
    0
}
