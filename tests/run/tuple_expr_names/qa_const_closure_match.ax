// test: run
// exit: 0
// stdout: 10 20\n13 23\n3\n1\n0\n
// QA (T499a gate): a tuple expression naming a module-level `const` inside a function, a tuple built from a captured
// variable inside a closure body, a tuple scrutinee naming locals with a literal-pattern arm, and a function-returned
// `(a, a)` duplicated name used for both elements.

const BASE_A: i64 = 10i64
const BASE_B: i64 = 20i64

fn dup(a: i64) -> (i64, i64) {
    (a, a)
}

fn main() -> i32 {
    let c = (BASE_A, BASE_B)
    print_int(c.0)
    print(" ")
    print_int(c.1)
    print("\n")

    let k = 3i64
    let f = || (BASE_A + k, BASE_B + k)
    let r = f()
    print_int(r.0)
    print(" ")
    print_int(r.1)
    print("\n")

    let u = dup(3i64)
    print_int(u.0)
    print("\n")
    if u.0 == u.1 {
        print_int(1i64)
        print("\n")
    }

    let p = 1i64
    let q = 2i64
    let z = match (p, q) {
        (1i64, 3i64) => 5i64,
        (1i64, 2i64) => 0i64,
        _ => 9i64,
    }
    print_int(z)
    print("\n")
    0
}
