// test: run
// stdout: Drop Container\nDrop C\nDrop C\n

struct C {}
impl Drop for C {
    fn drop(self: mut_view<C>) {
        print("Drop C\n");
    }
}

struct Container<T> {
    a: T,
    b: T,
}

impl<T> Drop for Container<T> {
    fn drop(self: mut_view<Container>) {
        print("Drop Container\n");
    }
}

fn main() {
    let x = Container<C> { a: C {}, b: C {} };
}
