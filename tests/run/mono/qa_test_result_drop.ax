// test: run
// stdout: Created Ok\nCreated Err\nDropping E_Payload\nDropping T_Payload\n

struct T_Payload {}
impl Drop for T_Payload {
    fn drop(self: mut_view<T_Payload>) {
        print("Dropping T_Payload\n");
    }
}

struct E_Payload {}
impl Drop for E_Payload {
    fn drop(self: mut_view<E_Payload>) {
        print("Dropping E_Payload\n");
    }
}

fn make_ok() -> Result<T_Payload, E_Payload> {
    print("Created Ok\n");
    Result<T_Payload, E_Payload>.Ok(T_Payload {})
}

fn make_err() -> Result<T_Payload, E_Payload> {
    print("Created Err\n");
    Result<T_Payload, E_Payload>.Err(E_Payload {})
}

fn main() {
    let ok = make_ok();
    let err = make_err();
}
