// test: run
// stdout: id called\nid called\nid called\n

struct Wrapper<T> {
    value: T,
}

fn id<T>(x: T) -> T {
    print("id called\n");
    x
}

fn main() {
    let w1 = Wrapper<i32> { value: 10 };
    let w2 = Wrapper<i32> { value: 20 };
    let a = id<i32>(w1.value);
    let b = id<i32>(w2.value);
    let c = id<i32>(30);
}
