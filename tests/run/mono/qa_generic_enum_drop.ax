// test: run
// stdout: Created Some\nDropping Payload\nCreated None\n

struct Payload {}
impl Drop for Payload {
    fn drop(self: mut_view<Payload>) {
        print("Dropping Payload\n");
    }
}

enum MyOption<T> {
    None,
    Some(T),
}

fn make_some() -> MyOption<Payload> {
    print("Created Some\n");
    MyOption.Some(Payload {})
}

fn make_none() -> MyOption<Payload> {
    print("Created None\n");
    MyOption.None
}

fn main() {
    let opt = make_some();
    let n = make_none();
}
