// test: run
// modes: interp native
// stdout-file: hybrid_incremental_cache_parallel_cgu.stdout
// SPEC-23 AXS-PAR-022, AXS-PAR-051:
// Verify hybrid incremental `.axiom-cache` reuse + parallel CGU codegen where
// unchanged modules reuse cached `.obj` artifacts (`status = CACHED`) while dirty
// modules are re-lowered in parallel (`status = COMPILED`) and merged into a
// byte-identical executable regardless of `--jobs N`.

@derive(Copy)
struct HybridCguEntry {
    module_rank: u32,
    prev_fp: u64,
    curr_fp: u64,
    cached_obj_digest: u64,
}

@derive(Copy)
struct HybridBuildSummary {
    cached_hits: u32,
    compiled_misses: u32,
    exe_digest: u64,
}

fn mix64(seed: u64, val: u64) -> u64 {
    let mut x = seed ^ (val << 13u64) ^ (seed >> 7u64) ^ 0x9E3779B97F4A7C15u64;
    x = x ^ (x >> 17u64) ^ (val >> 3u64);
    x ^ (x << 5u64)
}

fn compile_cgu_obj(module_rank: u32, cgu_fp: u64) -> u64 {
    mix64(0x4347555F4F424A00u64 ^ (module_rank as u64), cgu_fp)
}

fn execute_hybrid_build(jobs: u32, warm_cache: bool) -> HybridBuildSummary {
    // 4 modules: only module 3 (`physics`) changed its private body at R2 (`0x3001 -> 0x3002`)
    let m0 = HybridCguEntry {
        module_rank: 1u32,
        prev_fp: 0x1001u64,
        curr_fp: 0x1001u64,
        cached_obj_digest: compile_cgu_obj(1u32, 0x1001u64),
    };
    let m1 = HybridCguEntry {
        module_rank: 2u32,
        prev_fp: 0x2001u64,
        curr_fp: 0x2001u64,
        cached_obj_digest: compile_cgu_obj(2u32, 0x2001u64),
    };
    let m2 = HybridCguEntry {
        module_rank: 3u32,
        prev_fp: 0x3001u64,
        curr_fp: 0x3002u64,
        cached_obj_digest: compile_cgu_obj(3u32, 0x3001u64),
    };
    let m3 = HybridCguEntry {
        module_rank: 4u32,
        prev_fp: 0x4001u64,
        curr_fp: 0x4001u64,
        cached_obj_digest: compile_cgu_obj(4u32, 0x4001u64),
    };

    let entries: [4]HybridCguEntry = [m0, m1, m2, m3];
    let mut obj_digests: [4]u64 = [0u64, 0u64, 0u64, 0u64];
    let mut hits: u32 = 0u32;
    let mut misses: u32 = 0u32;

    let mut i: usize = 0;
    while i < 4 {
        // Process in reverse when `jobs > 1` to simulate out-of-order parallel workers
        let idx = if jobs > 1u32 { 3 - i } else { i };
        let e = entries[idx];
        if warm_cache && e.prev_fp == e.curr_fp {
            obj_digests[idx] = e.cached_obj_digest;
            hits = hits + 1u32;
        } else {
            obj_digests[idx] = compile_cgu_obj(e.module_rank, e.curr_fp);
            misses = misses + 1u32;
        }
        i = i + 1;
    }

    let mut exe_fp: u64 = 0x4558455F4C494E4Bu64;
    let mut k: usize = 0;
    while k < 4 {
        exe_fp = mix64(exe_fp, obj_digests[k]);
        k = k + 1;
    }

    HybridBuildSummary {
        cached_hits: hits,
        compiled_misses: misses,
        exe_digest: exe_fp,
    }
}

pub fn main() -> i32 {
    let cold_j1 = execute_hybrid_build(1u32, false);
    let cold_j8 = execute_hybrid_build(8u32, false);
    let warm_j1 = execute_hybrid_build(1u32, true);
    let warm_j8 = execute_hybrid_build(8u32, true);

    if cold_j1.cached_hits != 0u32 || cold_j1.compiled_misses != 4u32 {
        return 1;
    }
    if warm_j8.cached_hits != 3u32 || warm_j8.compiled_misses != 1u32 {
        return 2;
    }
    if cold_j1.exe_digest != cold_j8.exe_digest ||
        cold_j8.exe_digest != warm_j1.exe_digest ||
        warm_j1.exe_digest != warm_j8.exe_digest {
        return 3;
    }

    print("HYBRID-INCREMENTAL-CACHE-PARALLEL-CGU-OK\n");
    0
}
