// test: run
// modes: interp native
// stdout-file: post_join_diagnostic_and_linker_order.stdout
// SPEC-23 AXS-PAR-023, AXS-PAR-024, AXS-PAR-052:
// Verify canonical post-join `AXD-060` diagnostic sorting + deduplication across
// worker buffers (`FileId`, `byte_offset`, `code`, `SemanticKey`) and finalization
// barrier gating when errors or quarantined artifacts occur.

@derive(Copy)
struct WorkerDiag {
    file_id: u32,
    byte_offset: u32,
    code: u32,
    semantic_rank: u32,
    is_error: bool,
}

fn diag_less(a: WorkerDiag, b: WorkerDiag) -> bool {
    if a.file_id != b.file_id {
        return (a.file_id) < (b.file_id);
    }
    if a.byte_offset != b.byte_offset {
        return (a.byte_offset) < (b.byte_offset);
    }
    if a.code != b.code {
        return (a.code) < (b.code);
    }
    (a.semantic_rank) < (b.semantic_rank)
}

fn diag_eq(a: WorkerDiag, b: WorkerDiag) -> bool {
    a.file_id == b.file_id &&
        a.byte_offset == b.byte_offset &&
        a.code == b.code &&
        a.semantic_rank == b.semantic_rank &&
        a.is_error == b.is_error
}

fn mix64(seed: u64, val: u64) -> u64 {
    let mut x = seed ^ (val << 13u64) ^ (seed >> 7u64) ^ 0x9E3779B97F4A7C15u64;
    x = x ^ (x >> 17u64) ^ (val >> 3u64);
    x ^ (x << 5u64)
}

fn merge_and_dedup_diags(reverse_worker_arrival: bool) -> u64 {
    let d_file1_first = WorkerDiag { file_id: 1u32, byte_offset: 12u32, code: 2001u32, semantic_rank: 10u32, is_error: true };
    let d_file1_second = WorkerDiag { file_id: 1u32, byte_offset: 48u32, code: 4001u32, semantic_rank: 11u32, is_error: false };
    let d_file2_err = WorkerDiag { file_id: 2u32, byte_offset: 8u32, code: 2001u32, semantic_rank: 20u32, is_error: true };
    // Duplicate diagnostic emitted via diamond import path
    let d_file2_dup = WorkerDiag { file_id: 2u32, byte_offset: 8u32, code: 2001u32, semantic_rank: 20u32, is_error: true };

    let mut buf: [4]WorkerDiag = if !reverse_worker_arrival {
        [d_file1_first, d_file1_second, d_file2_err, d_file2_dup]
    } else {
        // Worker W2 finishes `file_id = 2` 50 ms before Worker W1 finishes `file_id = 1`
        [d_file2_dup, d_file2_err, d_file1_second, d_file1_first]
    };

    let mut a: usize = 1;
    while a < 4 {
        let cur = buf[a];
        let mut b: usize = a;
        while b > 0 {
            if !diag_less(cur, buf[b - 1]) {
                break;
            }
            buf[b] = buf[b - 1];
            b = b - 1;
        }
        buf[b] = cur;
        a = a + 1;
    }

    let mut digest: u64 = 0x4158445F30363000u64;
    let mut unique_count: u32 = 0u32;
    let mut i: usize = 0;
    while i < 4 {
        let cur = buf[i];
        let is_dup = if i > 0 { diag_eq(cur, buf[i - 1]) } else { false };
        if !is_dup {
            let packed = ((cur.file_id as u64) << 48u64) |
                ((cur.byte_offset as u64) << 32u64) |
                ((cur.code as u64) << 16u64) |
                (cur.semantic_rank as u64);
            digest = mix64(digest, packed);
            unique_count = unique_count + 1u32;
        }
        i = i + 1;
    }

    if unique_count != 3u32 || buf[0].file_id != 1u32 || buf[2].file_id != 2u32 {
        return 0u64;
    }
    digest
}

pub fn main() -> i32 {
    let d_serial = merge_and_dedup_diags(false);
    let d_parallel = merge_and_dedup_diags(true);
    if d_serial == 0u64 || d_serial != d_parallel {
        return 1;
    }

    print("POST-JOIN-DIAGNOSTIC-AND-LINKER-ORDER-OK\n");
    0
}
