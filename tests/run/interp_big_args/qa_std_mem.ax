// test: run
// exit: 0
// stdout: replace 5632675 5615075\nend 5615075\n
// T498c QA: std.core.mem generics that take a big value by value (`replace`, `drop`, `forget`). The argument crosses the spilled-argument path inside a std generic, and
// `replace` returns the old big value by value.

// The generics below are copies of std/core/mem.ax (replace / drop / forget) so that the test does
// not depend on std module loading. (`swap` is not covered: it copies only the first element of an array T, see the QA report.)
unsafe fn replace<T>(dest: mut_view<T>, src: T) -> T {
    let old = *dest;
    *dest = src;
    old
}

fn drop<T>(val: T) {}

fn forget<T>(val: T) {}

fn mk(seed: u8) -> [300]u8 {
    let mut a: [300]u8 = [0; 300];
    let mut i: usize = 0;
    while i < 300 {
        a[i] = ((i as u32 + seed as u32) % 251u32) as u8;
        i = i + 1;
    }
    a
}

fn ck(a: view<[300]u8>) -> u64 {
    let mut s: u64 = 0u64;
    let mut i: usize = 0;
    while i < 300 {
        s = s + ((*a)[i] as u64 + 1u64) * ((i + 1) as u64);
        i = i + 1;
    }
    s
}

fn main() -> i32 {
    let mut x = mk(1u8);
    let old = unsafe { replace(mut_view(x), mk(2u8)) };
    print("replace ");
    print_int(ck(view(old)) as i64);
    print(" ");
    print_int(ck(view(x)) as i64);
    print("\n");

    let keep = mk(5u8);
    drop(mk(6u8));
    forget(mk(7u8));
    drop(keep);
    print("end ");
    print_int(ck(view(x)) as i64);
    print("\n");
    0
}
