// test: run
// exit: 0
// stdout: make 11 600 22\npass 11 600 22\nself 633\nself-chain 11 1200 22\nbig-ret 4096 77\n
// T498c: a 616-byte struct built and returned by value, passed by value, used as by-value `self`, and a
// method that takes `self` by value and returns a new big value; a 4 KiB array returned by value.

@derive(Copy)
struct Big {
    head: u32,
    data: [600]u8,
    tail: u64,
}

impl Big {
    fn total(self: Big) -> u64 {
        let mut n: u64 = 0u64;
        let mut i: usize = 0;
        while i < 600 {
            n = n + self.data[i] as u64;
            i = i + 1;
        }
        n + self.head as u64 + self.tail
    }

    fn doubled(self: Big) -> Big {
        let mut r = self;
        let mut i: usize = 0;
        while i < 600 {
            r.data[i] = self.data[i] * 2u8;
            i = i + 1;
        }
        r
    }
}

fn make(h: u32, t: u64) -> Big {
    Big { head: h, data: [1; 600], tail: t }
}

fn data_sum(b: view<Big>) -> u64 {
    let mut n: u64 = 0u64;
    let mut i: usize = 0;
    while i < 600 {
        n = n + (*b).data[i] as u64;
        i = i + 1;
    }
    n
}

fn report(label: str, b: Big) {
    print(label);
    print(" ");
    print_int(b.head as i64);
    print(" ");
    print_int(data_sum(view(b)) as i64);
    print(" ");
    print_int(b.tail as i64);
    print("\n");
}

fn big_array(fill: u8, last: u8) -> [4096]u8 {
    let mut a: [4096]u8 = [fill; 4096];
    a[4095] = last;
    a
}

fn main() -> i32 {
    let b = make(11u32, 22u64);
    print("make ");
    print_int(b.head as i64);
    print(" ");
    print_int(data_sum(view(b)) as i64);
    print(" ");
    print_int(b.tail as i64);
    print("\n");

    report("pass", b);

    print("self ");
    print_int(b.total() as i64);
    print("\n");

    let d = b.doubled();
    report("self-chain", d);

    let a = big_array(1u8, 77u8);
    let mut n: u64 = 0u64;
    let mut i: usize = 0;
    while i < 4095 {
        n = n + a[i] as u64;
        i = i + 1;
    }
    print("big-ret ");
    print_int((n + 1u64) as i64);
    print(" ");
    print_int(a[4095] as i64);
    print("\n");
    0
}
