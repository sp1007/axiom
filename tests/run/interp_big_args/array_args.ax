// test: run
// exit: 0
// stdout: 255 1 1\n256 2 2\n257 3 3\n300 4 4\n1024 5 5\n4096 6 6\n7 300 9\n1024 1024\n
// T498c: by-value array arguments around and above the oracle's 256-byte inline argument slot. Every
// element is 1 except the last, which is the size tag `t`; sum counts the elements (the last one is
// excluded and replaced by the tag check) so a truncated copy shows up as a smaller count or a zero tag.
// The `mixed` call puts small scalars before and after a 300-byte argument (slots after a spilled one).

fn s255(a: [255]u8, t: u8) -> u32 {
    let mut n: u32 = 0u32;
    let mut i: usize = 0;
    while i < 254 {
        n = n + a[i] as u32;
        i = i + 1;
    }
    if a[254] == t { n = n + 1u32; }
    n
}

fn s256(a: [256]u8, t: u8) -> u32 {
    let mut n: u32 = 0u32;
    let mut i: usize = 0;
    while i < 255 {
        n = n + a[i] as u32;
        i = i + 1;
    }
    if a[255] == t { n = n + 1u32; }
    n
}

fn s257(a: [257]u8, t: u8) -> u32 {
    let mut n: u32 = 0u32;
    let mut i: usize = 0;
    while i < 256 {
        n = n + a[i] as u32;
        i = i + 1;
    }
    if a[256] == t { n = n + 1u32; }
    n
}

fn s300(a: [300]u8, t: u8) -> u32 {
    let mut n: u32 = 0u32;
    let mut i: usize = 0;
    while i < 299 {
        n = n + a[i] as u32;
        i = i + 1;
    }
    if a[299] == t { n = n + 1u32; }
    n
}

fn s1024(a: [1024]u8, t: u8) -> u32 {
    let mut n: u32 = 0u32;
    let mut i: usize = 0;
    while i < 1023 {
        n = n + a[i] as u32;
        i = i + 1;
    }
    if a[1023] == t { n = n + 1u32; }
    n
}

fn s4096(a: [4096]u8, t: u8) -> u32 {
    let mut n: u32 = 0u32;
    let mut i: usize = 0;
    while i < 4095 {
        n = n + a[i] as u32;
        i = i + 1;
    }
    if a[4095] == t { n = n + 1u32; }
    n
}

fn mixed(x: u32, a: [300]u8, y: u64) -> u32 {
    let mut n: u32 = 0u32;
    let mut i: usize = 0;
    while i < 300 {
        n = n + a[i] as u32;
        i = i + 1;
    }
    print_int(x as i64);
    print(" ");
    print_int(n as i64);
    print(" ");
    print_int(y as i64);
    print("\n");
    n
}

fn sum_all(a: [1024]u8) -> u32 {
    let mut n: u32 = 0u32;
    let mut i: usize = 0;
    while i < 1024 {
        n = n + a[i] as u32;
        i = i + 1;
    }
    n
}

fn line(n: u32, tag: u8, last: u8) {
    print_int(n as i64);
    print(" ");
    print_int(tag as i64);
    print(" ");
    print_int(last as i64);
    print("\n");
}

fn main() -> i32 {
    let mut a1: [255]u8 = [1; 255];
    a1[254] = 1u8;
    line(s255(a1, 1u8), 1u8, a1[254]);

    let mut a2: [256]u8 = [1; 256];
    a2[255] = 2u8;
    line(s256(a2, 2u8), 2u8, a2[255]);

    let mut a3: [257]u8 = [1; 257];
    a3[256] = 3u8;
    line(s257(a3, 3u8), 3u8, a3[256]);

    let mut a4: [300]u8 = [1; 300];
    a4[299] = 4u8;
    line(s300(a4, 4u8), 4u8, a4[299]);

    let mut a5: [1024]u8 = [1; 1024];
    a5[1023] = 5u8;
    line(s1024(a5, 5u8), 5u8, a5[1023]);

    let mut a6: [4096]u8 = [1; 4096];
    a6[4095] = 6u8;
    line(s4096(a6, 6u8), 6u8, a6[4095]);

    let m: [300]u8 = [1; 300];
    let _ = mixed(7u32, m, 9u64);

    let k: [1024]u8 = [1; 1024];
    print_int(sum_all(k) as i64);
    print(" ");
    print_int(sum_all(k) as i64);
    print("\n");
    0
}
