// test: run
// exit: 0
// timeout: 60
// stdout: huge 65542 131080\ngrid 1200\ntup 2409\ngenf 900 1200 1500\nmut 1 2 303\nconsume 1\ndrop guard 1\nafter1 300\nconsume 2\ndrop guard 2\nafter2 600\nopt 300\nsix 9654321\n
// T498c QA: sizes far above the slot (64 KiB, 128 KiB), nested arrays, tuples of big arrays, a closure with a
// big capture invoked through generic Fn / FnMut / FnOnce wrappers with a big argument, a Drop struct with a
// big field moved into a callee (dropped exactly once, by the callee), Option of a big array returned from a
// generic function, and one call with six spilled arguments (the argument buffer is rebuilt six times).

fn huge64(a: [65536]u8, t: u32) -> u32 {
    let mut n: u32 = 0u32;
    let mut i: usize = 0;
    while i < 65536 {
        n = n + (a[i] as u32);
        i = i + 1;
    }
    if a[65535] == 7u8 { n = n - 7u32 + t; }
    n
}

fn huge128(a: [131072]u8, t: u32) -> u32 {
    let mut n: u32 = 0u32;
    let mut i: usize = 0;
    while i < 131072 {
        n = n + (a[i] as u32);
        i = i + 1;
    }
    if a[131071] == 9u8 { n = n - 9u32 + t; }
    n
}

fn grid(g: [4][300]u8, k: u32) -> u32 {
    let mut n: u32 = 0u32;
    let mut r: usize = 0;
    while r < 4 {
        let mut c: usize = 0;
        while c < 300 {
            n = n + (g[r][c] as u32);
            c = c + 1;
        }
        r = r + 1;
    }
    n + k - k
}

fn pair(p: ([300]u8, [300]u8), k: u32) -> u32 {
    let mut n: u32 = 0u32;
    let mut i: usize = 0;
    while i < 300 {
        n = n + (p.0[i] as u32) * 2u32 + (p.1[i] as u32) * 3u32;
        i = i + 1;
    }
    n + k
}

fn call_fn<F: Fn>(f: F, x: [300]u8) -> u32 {
    f(x)
}

fn call_fn_mut<F: FnMut>(mut f: F, x: [300]u8) -> u32 {
    f(x)
}

fn call_fn_once<F: FnOnce>(f: F, x: [300]u8) -> u32 {
    f(x)
}

fn sum300(a: view<[300]u8>) -> u32 {
    let mut n: u32 = 0u32;
    let mut i: usize = 0;
    while i < 300 {
        n = n + (*a)[i] as u32;
        i = i + 1;
    }
    n
}

struct Guard {
    data: [300]u8,
    id: u32,
}

impl Drop for Guard {
    fn drop(self: mut_view<Guard>) {
        print("drop guard ");
        print_int(self.id as i64);
        print("\n");
    }
}

fn consume(g: Guard, k: u32) -> u32 {
    print("consume ");
    print_int(g.id as i64);
    print("\n");
    sum300(view(g.data)) + k
}

fn lift<T>(x: T) -> Option<T> {
    Option.Some(x)
}

fn six(a: [300]u8, b: [600]u8, c: [257]u8, d: [1024]u8, e: [1200]u8, f: [300]u8, k: u32) -> u64 {
    (a[299] as u64) + (b[599] as u64) * 10u64 + (c[256] as u64) * 100u64 + (d[1023] as u64) * 1000u64 + (e[1199] as u64) * 10000u64 + (f[299] as u64) * 100000u64 + (k as u64) * 1000000u64
}

fn main() -> i32 {
    let mut h: [65536]u8 = [1; 65536];
    h[65535] = 7u8;
    let mut hb: [131072]u8 = [1; 131072];
    hb[131071] = 9u8;
    print("huge ");
    print_int(huge64(h, 7u32) as i64);
    print(" ");
    print_int(huge128(hb, 9u32) as i64);
    print("\n");

    let g: [4][300]u8 = [[1; 300]; 4];
    print("grid ");
    print_int(grid(g, 7u32) as i64);
    print("\n");

    let p: ([300]u8, [300]u8) = ([1; 300], [2; 300]);
    print("tup ");
    print_int(pair(p, 9u32) as i64);
    print("\n");

    let cap: [300]u8 = [1; 300];
    let c1 = |x: [300]u8| -> u32 { sum300(view(cap)) + sum300(view(x)) };
    print("genf ");
    print_int(call_fn(c1, [2; 300]) as i64);
    print(" ");
    print_int(call_fn_mut(c1, [3; 300]) as i64);
    print(" ");
    print_int(call_fn_once(c1, [4; 300]) as i64);
    print("\n");

    let mut cnt: u32 = 0u32;
    let mut c2 = |x: [300]u8| -> u32 {
        cnt = cnt + 1u32;
        cnt + sum300(view(x))
    };
    let m1 = c2([0; 300]);
    let m2 = c2([0; 300]);
    let m3 = c2([1; 300]);
    print("mut ");
    print_int(m1 as i64);
    print(" ");
    print_int(m2 as i64);
    print(" ");
    print_int(m3 as i64);
    print("\n");

    let gd = Guard { data: [1; 300], id: 1u32 };
    let gd2 = Guard { data: [2; 300], id: 2u32 };
    let r = consume(gd, 0u32);
    print("after1 ");
    print_int(r as i64);
    print("\n");
    let r2 = consume(gd2, 0u32);
    print("after2 ");
    print_int(r2 as i64);
    print("\n");

    let o = lift([1u8; 300]);
    match o {
        Option.Some(arr) => {
            print("opt ");
            print_int(sum300(view(arr)) as i64);
            print("\n");
        }
        Option.None => { print("opt-none\n"); }
    }

    print("six ");
    print_int(six([1; 300], [2; 600], [3; 257], [4; 1024], [5; 1200], [6; 300], 9u32) as i64);
    print("\n");
    0
}
