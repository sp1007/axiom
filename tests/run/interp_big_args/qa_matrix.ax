// test: run
// exit: 0
// stdout: m1 5632675 1 40352 7\nm2 4 29 5632675\nm3 5632675 9 40352 5 1 0\nm4 7 40352 3 5632675 1\nrec 154\nown 45150 1\nstore 5632675 8129 21280225 5632675\nnest 11163515\nfnp 793937\ngen 5632675 68740352 32692\ngenw 32678\ntrait 10805943 11247756\ncap 5632675 21280225 5 9\nback 5632675\n
// T498c QA: boundary matrix for big by-value arguments. Several big arguments in one call, big arguments in
// every position next to scalars, recursion (frames must not alias), a callee that mutates or stores its
// copy (no write-through, no use after the argument buffer is freed), nested calls whose arguments are
// big temporaries, function pointers, generics, trait methods with a big by-value `self`, and closures
// capturing several big values. Every array holds distinct values so a swapped, shifted or truncated copy
// changes the checksum: ck(a) = sum((a[i] + 1) * (i + 1)).

fn ck300(a: view<[300]u8>) -> u64 {
    let mut s: u64 = 0u64;
    let mut i: usize = 0;
    while i < 300 {
        s = s + ((*a)[i] as u64 + 1u64) * ((i + 1) as u64);
        i = i + 1;
    }
    s
}

fn ck1024(a: view<[1024]u8>) -> u64 {
    let mut s: u64 = 0u64;
    let mut i: usize = 0;
    while i < 1024 {
        s = s + ((*a)[i] as u64 + 1u64) * ((i + 1) as u64);
        i = i + 1;
    }
    s
}

fn ck257(a: view<[257]u8>) -> u64 {
    let mut s: u64 = 0u64;
    let mut i: usize = 0;
    while i < 257 {
        s = s + ((*a)[i] as u64 + 1u64) * ((i + 1) as u64);
        i = i + 1;
    }
    s
}

fn ck600(a: view<[600]u8>) -> u64 {
    let mut s: u64 = 0u64;
    let mut i: usize = 0;
    while i < 600 {
        s = s + ((*a)[i] as u64 + 1u64) * ((i + 1) as u64);
        i = i + 1;
    }
    s
}

fn mk300(seed: u8) -> [300]u8 {
    let mut a: [300]u8 = [0; 300];
    let mut i: usize = 0;
    while i < 300 {
        a[i] = ((i as u32 + seed as u32) % 251u32) as u8;
        i = i + 1;
    }
    a
}

fn mk1024(seed: u8) -> [1024]u8 {
    let mut a: [1024]u8 = [0; 1024];
    let mut i: usize = 0;
    while i < 1024 {
        a[i] = ((i as u32 + seed as u32) % 251u32) as u8;
        i = i + 1;
    }
    a
}

fn mk257(seed: u8) -> [257]u8 {
    let mut a: [257]u8 = [0; 257];
    let mut i: usize = 0;
    while i < 257 {
        a[i] = ((i as u32 + seed as u32) % 251u32) as u8;
        i = i + 1;
    }
    a
}

fn mk600(seed: u8) -> [600]u8 {
    let mut a: [600]u8 = [0; 600];
    let mut i: usize = 0;
    while i < 600 {
        a[i] = ((i as u32 + seed as u32) % 251u32) as u8;
        i = i + 1;
    }
    a
}

// --- big, small, big, small (m1); small, big (m2); big, big, small (m3); small, big, small, big, small (m4)
fn m1(a: [300]u8, x: u32, b: [1024]u8, y: u8) -> u64 {
    print("m1 ");
    print_int(ck300(view(a)) as i64);
    print(" ");
    print_int(x as i64);
    print(" ");
    print_int((ck1024(view(b)) % 100000u64) as i64);
    print(" ");
    print_int(y as i64);
    print("\n");
    0u64
}

fn m2(x: u32, a: [300]u8, y: u64) -> u64 {
    print("m2 ");
    print_int(x as i64);
    print(" ");
    print_int(y as i64);
    print(" ");
    print_int(ck300(view(a)) as i64);
    print("\n");
    0u64
}

fn m3(a: [300]u8, b: [1024]u8, x: u32, c: [257]u8, p: u8, q: u8) -> u64 {
    print("m3 ");
    print_int(ck300(view(a)) as i64);
    print(" ");
    print_int(x as i64);
    print(" ");
    print_int((ck1024(view(b)) % 100000u64) as i64);
    print(" ");
    print_int(p as i64);
    print(" ");
    print_int(q as i64);
    print(" ");
    print_int((ck257(view(c)) % 2u64) as i64);
    print("\n");
    0u64
}

fn m4(p: u8, a: [300]u8, q: u32, b: [1024]u8, r: u8, c: [300]u8) -> u64 {
    print("m4 ");
    print_int(p as i64);
    print(" ");
    print_int((ck1024(view(b)) % 100000u64) as i64);
    print(" ");
    print_int(q as i64);
    print(" ");
    print_int(ck300(view(a)) as i64);
    print(" ");
    print_int((ck300(view(c)) / ck300(view(a))) as i64);
    print("\n");
    0u64
}

// --- recursion: every frame holds its own copies; the callee edits its parameter before recursing.
fn rec(mut a: [300]u8, depth: u32, mut b: [600]u8) -> u32 {
    a[0] = a[0] + 1u8;
    b[599] = b[599] + 2u8;
    if depth == 0u32 {
        return (a[0] as u32) + (b[599] as u32) + (a[299] as u32);
    }
    let inner = rec(a, depth - 1u32, b);
    // This frame's copies must be untouched by the deeper frames: a[0] == 3 - depth, b[599] == 97 + 2 * (3 - depth).
    let ok = a[0] as u32 == 3u32 - depth && b[599] as u32 == 97u32 + 2u32 * (3u32 - depth);
    if ok { inner } else { 100000u32 }
}

// --- a callee that mutates its own copy must not write through to the caller
fn own(mut a: [300]u8, mut b: [1024]u8) -> [300]u8 {
    let mut i: usize = 0;
    while i < 300 {
        a[i] = 0u8;
        i = i + 1;
    }
    b[0] = 99u8;
    a
}

// --- a callee that stores its copy in a struct which outlives the call arguments
struct Holder {
    a: [300]u8,
    n: u32,
    b: [600]u8,
}

fn store(a: [300]u8, n: u32, b: [600]u8) -> Holder {
    Holder { a: a, n: n, b: b }
}

fn pass_through(a: [300]u8) -> [300]u8 {
    a
}

fn sum_two(a: [300]u8, b: [300]u8) -> u64 {
    ck300(view(a)) + ck300(view(b))
}

// --- function pointer
fn fp_target(a: [300]u8, b: [257]u8, k: u32) -> u32 {
    ((ck300(view(a)) + ck257(view(b))) % 1000000u64) as u32 + k
}

// --- generics with a big type argument and with a big concrete parameter beside it
fn gen_id<T>(x: T) -> T {
    x
}

fn gen_mix<T>(first: T, mid: [300]u8, last: T, k: u32) -> u32 {
    let _ = first;
    let _ = last;
    (ck300(view(mid)) % 100000u64) as u32 + k
}

struct Wrap<T> {
    v: T,
    tag: u32,
}

impl<T> Wrap<T> {
    fn take(self: Wrap<T>, extra: [300]u8) -> u32 {
        let _ = self.v;
        (ck300(view(extra)) % 100000u64) as u32 + self.tag
    }
}

// --- trait method with a big by-value self and a big argument
trait Weigh {
    fn weigh(self: Self, extra: [300]u8, k: u32) -> u64;
}

struct Slab {
    data: [300]u8,
    pad: u32,
}

impl Weigh for Slab {
    fn weigh(self: Slab, extra: [300]u8, k: u32) -> u64 {
        ck300(view(self.data)) + ck300(view(extra)) + (self.pad as u64) + (k as u64)
    }
}

fn weigh_generic<W: Weigh>(w: W, extra: [300]u8) -> u64 {
    w.weigh(extra, 5u32)
}

fn main() -> i32 {
    let a = mk300(1u8);
    let b = mk1024(3u8);
    let c = mk257(5u8);
    let ca = ck300(view(a));
    let cb = ck1024(view(b));
    let _ = m1(a, 1u32, b, 7u8);
    let _ = m2(4u32, a, 29u64);
    let _ = m3(a, b, 9u32, c, 5u8, 1u8);
    let _ = m4(7u8, a, 3u32, b, 1u8, a);

    // recursion: three frames, each with its own edited copy
    let rr = rec(mk300(0u8), 2u32, mk600(0u8));
    print("rec ");
    print_int(rr as i64);
    print("\n");

    // callee mutation must not write through: a and b stay intact
    let z = own(a, b);
    print("own ");
    print_int(ck300(view(z)) as i64);
    print(" ");
    print_int(if ck300(view(a)) == ca && ck1024(view(b)) == cb { 1i64 } else { 0i64 });
    print("\n");

    // store: the Holder outlives the argument buffer
    let h = store(a, 8129u32, mk600(2u8));
    let h2 = store(pass_through(a), 1u32, mk600(2u8));
    print("store ");
    print_int(ck300(view(h.a)) as i64);
    print(" ");
    print_int(h.n as i64);
    print(" ");
    print_int(ck600(view(h2.b)) as i64);
    print(" ");
    print_int(ck300(view(h2.a)) as i64);
    print("\n");

    // nested: f(g(x), h(y)) with big temporaries
    print("nest ");
    print_int(sum_two(pass_through(a), pass_through(mk300(7u8))) as i64);
    print("\n");

    // function pointer
    let fp: fn([300]u8, [257]u8, u32) -> u32 = fp_target;
    print("fnp ");
    print_int(fp(a, c, 4u32) as i64);
    print("\n");

    // generics
    let g1 = gen_id(a);
    let g2 = gen_id(b);
    print("gen ");
    print_int(ck300(view(g1)) as i64);
    print(" ");
    print_int(ck1024(view(g2)) as i64);
    print(" ");
    print_int(gen_mix(mk600(1u8), a, mk600(2u8), 17u32) as i64);
    print("\n");
    let w = Wrap { v: mk600(9u8), tag: 3u32 };
    print("genw ");
    print_int(w.take(a) as i64);
    print("\n");

    // trait method, direct and through a generic
    let s = Slab { data: a, pad: 11u32 };
    print("trait ");
    print_int(s.weigh(c_to_300(c), 2u32) as i64);
    print(" ");
    print_int(weigh_generic(Slab { data: mk300(2u8), pad: 1u32 }, a) as i64);
    print("\n");

    // closure capturing several big values and scalars between them
    let cap1 = mk300(1u8);
    let k: u32 = 5u32;
    let cap2 = mk600(2u8);
    let k2: u64 = 9u64;
    let cl = || {
        print("cap ");
        print_int(ck300(view(cap1)) as i64);
        print(" ");
        print_int(ck600(view(cap2)) as i64);
        print(" ");
        print_int(k as i64);
        print(" ");
        print_int(k2 as i64);
        print("\n");
    };
    cl();

    // big values returned back by value
    let back = pass_through(pass_through(a));
    print("back ");
    print_int(ck300(view(back)) as i64);
    print("\n");
    0
}

fn c_to_300(c: [257]u8) -> [300]u8 {
    let mut r: [300]u8 = [0; 300];
    let mut i: usize = 0;
    while i < 257 {
        r[i] = c[i];
        i = i + 1;
    }
    r
}
