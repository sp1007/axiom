// test: run
// exit: 0
// stdout: enum 300 5 9\nenum-none 0\nopt 1024 3\nclosure 300 8\nclosure-arg 300 600 4\n
// T498c: aggregates above 256 bytes inside an enum payload (a tuple variant holding a `[300]u8` and two
// scalars), inside `Option`, and captured by value in a closure (also with a big closure argument).

@derive(Copy)
enum Packet {
    Data([300]u8, u32, u64),
    Empty,
}

fn sum300(a: view<[300]u8>) -> u32 {
    let mut n: u32 = 0u32;
    let mut i: usize = 0;
    while i < 300 {
        n = n + (*a)[i] as u32;
        i = i + 1;
    }
    n
}

fn inspect(p: Packet) {
    match p {
        Packet.Data(bytes, a, b) => {
            print("enum ");
            print_int(sum300(view(bytes)) as i64);
            print(" ");
            print_int(a as i64);
            print(" ");
            print_int(b as i64);
            print("\n");
        }
        Packet.Empty => {
            print("enum-none 0\n");
        }
    }
}

fn build(fill: u8, a: u32, b: u64) -> Packet {
    Packet.Data([fill; 300], a, b)
}

fn opt_sum(o: Option<[1024]u8>, tag: u32) {
    match o {
        Option.Some(arr) => {
            let mut n: u32 = 0u32;
            let mut i: usize = 0;
            while i < 1024 {
                n = n + arr[i] as u32;
                i = i + 1;
            }
            print("opt ");
            print_int(n as i64);
            print(" ");
            print_int(tag as i64);
            print("\n");
        }
        Option.None => {
            print("opt-none\n");
        }
    }
}

fn main() -> i32 {
    inspect(build(1u8, 5u32, 9u64));
    inspect(Packet.Empty);

    let arr: [1024]u8 = [1; 1024];
    opt_sum(Option.Some(arr), 3u32);

    let cap: [300]u8 = [1; 300];
    let k: u32 = 8u32;
    let c = || {
        print("closure ");
        print_int(sum300(view(cap)) as i64);
        print(" ");
        print_int(k as i64);
        print("\n");
    };
    c();

    let twice: [300]u8 = [2; 300];
    let g = |x: [300]u8, t: u32| {
        print("closure-arg ");
        print_int(sum300(view(cap)) as i64);
        print(" ");
        print_int(sum300(view(x)) as i64);
        print(" ");
        print_int(t as i64);
        print("\n");
    };
    g(twice, 4u32);
    0
}
