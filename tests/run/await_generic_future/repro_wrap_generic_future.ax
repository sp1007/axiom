// test: run
// modes: interp native
// stdout: 42 100\n

use std.future.block_on.block_on;

@derive(Copy)
struct Er {
    pub code: i32,
}

struct Wrap<T> {
    pub v: T,
    pub spins: i32,
}

fn wrap_pass<T>(x: T) -> T {
    x
}

impl<T: Copy> Future for Wrap<T> {
    type Output = Result<T, Er>;

    fn poll(self: mut_view<Wrap<T>>, cx: mut_view<Context>) -> Poll<Result<T, Er>> {
        let _ = cx;
        if self.spins > 0i32 {
            self.spins = self.spins - 1i32;
            return Poll.Pending;
        }
        Poll.Ready(Result.Ok(wrap_pass<T>(self.v)))
    }
}

async fn outer(seed: i64) -> i64 {
    let w1 = Wrap<i64> { v: seed + 2i64, spins: 2i32 };
    let r1 = w1.await;
    let a = match r1 {
        Result.Ok(val) => val,
        Result.Err(_) => -1i64,
    };
    let w2 = Wrap<i64> { v: a + 58i64, spins: 1i32 };
    let r2 = w2.await;
    let b = match r2 {
        Result.Ok(val) => val,
        Result.Err(_) => -2i64,
    };
    print_int(a);
    print(" ");
    print_int(b);
    print("\n");
    a + b
}

fn main() -> i32 {
    let total = block_on(outer(40i64));
    if total != 142i64 {
        return 1i32;
    }
    0i32
}
