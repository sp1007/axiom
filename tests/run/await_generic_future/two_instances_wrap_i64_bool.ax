// test: run
// modes: interp native
// stdout: d10 d20 123 true 999 false\n

use std.future.block_on.block_on;
use std.future.Context;
use std.future.Waker;
use std.future.RawWaker;
use std.future.RawWakerVTable;

struct Wrap<T> {
    pub v: T,
    pub spins: i32,
    pub id: i64,
}

fn identity_val<T>(x: T) -> T {
    x
}

impl<T> Drop for Wrap<T> {
    fn drop(self: mut_view<Wrap<T>>) {
        if self.id >= 10i64 {
            print("d");
            print_int(self.id);
            print(" ");
        }
    }
}

impl<T: Copy> Future for Wrap<T> {
    type Output = T;

    fn poll(self: mut_view<Wrap<T>>, cx: mut_view<Context>) -> Poll<T> {
        let _ = cx;
        if self.spins > 0i32 {
            self.spins = self.spins - 1i32;
            return Poll.Pending;
        }
        Poll.Ready(identity_val<T>(self.v))
    }
}

async fn suspend_i64() -> i64 {
    let w = Wrap<i64> { v: 1i64, spins: 5i32, id: 10i64 };
    w.await
}

async fn suspend_bool() -> bool {
    let w = Wrap<bool> { v: true, spins: 5i32, id: 20i64 };
    w.await
}

async fn run_both() -> i64 {
    let fi1 = Wrap<i64> { v: 123i64, spins: 2i32, id: 1i64 };
    let v1 = fi1.await;

    let fb1 = Wrap<bool> { v: true, spins: 1i32, id: 2i64 };
    let b1 = fb1.await;

    let fi2 = Wrap<i64> { v: 999i64, spins: 0i32, id: 3i64 };
    let v2 = fi2.await;

    let fb2 = Wrap<bool> { v: false, spins: 2i32, id: 4i64 };
    let b2 = fb2.await;

    print_int(v1);
    if b1 {
        print(" true ");
    } else {
        print(" false ");
    }
    print_int(v2);
    if b2 {
        print(" true\n");
    } else {
        print(" false\n");
    }
    v1 + v2
}

fn main() -> i32 {
    {
        let mut cx = Context {
            waker_val: Waker {
                raw: RawWaker {
                    data: 0 as *const u8,
                    vtable: 0 as *const RawWakerVTable,
                },
            },
        };
        {
            let mut f1 = suspend_i64();
            let _ = f1.poll(mut_view(cx));
        }
        {
            let mut f2 = suspend_bool();
            let _ = f2.poll(mut_view(cx));
        }
    }
    let sum = block_on(run_both());
    if sum != 1122i64 {
        return 1i32;
    }
    0i32
}
