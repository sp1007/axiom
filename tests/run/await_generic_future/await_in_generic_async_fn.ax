// test: run
// modes: interp native
// stdout: drop 1\ndrop 2\ndrop 3\nres 10 25 true false 110 15 99\n

use std.future.block_on.block_on;

@derive(Copy)
struct Pair {
    pub a: i64,
    pub b: i64,
}

struct Wrap<T> {
    pub v: T,
    pub spins: i32,
}

impl<T: Copy> Future for Wrap<T> {
    type Output = T;

    fn poll(self: mut_view<Wrap<T>>, cx: mut_view<Context>) -> Poll<T> {
        let _ = cx;
        if self.spins > 0i32 {
            self.spins = self.spins - 1i32;
            return Poll.Pending;
        }
        Poll.Ready(self.v)
    }
}

struct LiveDrop<T> {
    pub marker: *const T,
    pub tag: i64,
}

impl<T> Drop for LiveDrop<T> {
    fn drop(self: mut_view<LiveDrop<T>>) {
        print("drop ");
        print_int(self.tag);
        print("\n");
    }
}

// Uninstantiated generic `async fn` template in the same translation unit: must typecheck & own-check cleanly.
async fn unused_generic_async<U: Copy>(u: U) -> U {
    let w = Wrap<U> { v: u, spins: 1i32 };
    w.await
}

async fn gen_leaf<T: Copy>(x: T, spins: i32) -> T {
    let w = Wrap<T> { v: x, spins: spins };
    w.await
}

async fn gen_pipeline<T: Copy>(first: T, second: T, tag: i64) -> (T, T) {
    let guard = LiveDrop<T> { marker: 0 as *const T, tag: tag };
    let r1 = gen_leaf(first, 2i32).await;
    let r2 = gen_leaf<T>(second, 1i32).await;
    let _ = guard.tag;
    (r1, r2)
}

async fn driver() -> i64 {
    let p1 = gen_pipeline<i64>(10i64, 25i64, 1i64).await;
    let p2 = gen_pipeline(true, false, 2i64).await;
    let p3 = gen_pipeline<Pair>(Pair { a: 50i64, b: 60i64 }, Pair { a: 7i64, b: 8i64 }, 3i64).await;
    let extra = gen_leaf<i64>(99i64, 1i32).await;

    let s1 = p3.0.a + p3.0.b;
    let s2 = p3.1.a + p3.1.b;

    print("res ");
    print_int(p1.0);
    print(" ");
    print_int(p1.1);
    if p2.0 {
        print(" true");
    } else {
        print(" false");
    }
    if p2.1 {
        print(" true ");
    } else {
        print(" false ");
    }
    print_int(s1);
    print(" ");
    print_int(s2);
    print(" ");
    print_int(extra);
    print("\n");

    p1.0 + p1.1 + s1 + s2 + extra
}

fn main() -> i32 {
    let total = block_on(driver());
    if total != 259i64 {
        return 1i32;
    }
    0i32
}
