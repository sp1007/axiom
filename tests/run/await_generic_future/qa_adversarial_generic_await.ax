// test: run
// modes: interp native
// stdout: pair 10 true false 20 30 40\ndrop_order: g_inner g_outer\nchained 77 88 99\nsibling 500 true 601 false\n

use std.future.block_on.block_on;

// 1. Multi-parameter generic future: PairFut<A, B> instantiated at
//    (i64, bool), (bool, i64), and (i64, i64) in one program.
struct PairFut<A, B> {
    pub a: A,
    pub b: B,
    pub spins: i32,
}

impl<A: Copy, B: Copy> Future for PairFut<A, B> {
    type Output = (A, B);

    fn poll(self: mut_view<PairFut<A, B>>, cx: mut_view<Context>) -> Poll<(A, B)> {
        let _ = cx;
        if self.spins > 0i32 {
            self.spins = self.spins - 1i32;
            return Poll.Pending;
        }
        Poll.Ready((self.a, self.b))
    }
}

// 2. Live Drop resource held across a multi-poll generic Future .await.
struct TraceDrop {
    pub id: i32,
}

impl Drop for TraceDrop {
    fn drop(self: mut_view<TraceDrop>) {
        if self.id == 1i32 {
            print(" g_outer");
        } else if self.id == 2i32 {
            print(" g_inner");
        }
    }
}

async fn test_pair_and_drop() -> i64 {
    let p1 = PairFut<i64, bool> { a: 10i64, b: true, spins: 2i32 }.await;
    let p2 = PairFut<bool, i64> { a: false, b: 20i64, spins: 1i32 }.await;
    let p3 = PairFut<i64, i64> { a: 30i64, b: 40i64, spins: 2i32 }.await;

    print("pair ");
    print_int(p1.0);
    if p1.1 { print(" true "); } else { print(" false "); }
    if p2.0 { print("true "); } else { print("false "); }
    print_int(p2.1);
    print(" ");
    print_int(p3.0);
    print(" ");
    print_int(p3.1);
    print("\n");

    print("drop_order:");
    let acc: i64 = {
        let g_outer = TraceDrop { id: 1i32 };
        let g_inner = TraceDrop { id: 2i32 };
        let mid = PairFut<i64, bool> { a: 5i64, b: true, spins: 3i32 }.await;
        let _ = g_outer.id;
        let _ = g_inner.id;
        mid.0
    };
    print("\n");
    p1.0 + p2.1 + p3.0 + p3.1 + acc
}

// 3. Chained generic async fn calling another generic async fn that awaits
//    a generic Future impl, including a generic async fn<T> whose Output
//    does NOT mention T, called at distinct T types (i64, bool, Tag2).
@derive(Copy)
struct Tag2 {
    pub hi: i64,
    pub lo: i64,
}

struct SpinWrap<T> {
    pub val: T,
    pub spins: i32,
}

impl<T: Copy> Future for SpinWrap<T> {
    type Output = T;

    fn poll(self: mut_view<SpinWrap<T>>, cx: mut_view<Context>) -> Poll<T> {
        let _ = cx;
        if self.spins > 0i32 {
            self.spins = self.spins - 1i32;
            return Poll.Pending;
        }
        Poll.Ready(self.val)
    }
}

async fn gen_inner_no_t_out<T: Copy>(x: T, out_code: i64, spins: i32) -> i64 {
    let w = SpinWrap<T> { val: x, spins: spins };
    let _got: T = w.await;
    out_code
}

async fn gen_outer_no_t_out<T: Copy>(x: T, out_code: i64) -> i64 {
    gen_inner_no_t_out<T>(x, out_code, 2i32).await
}

async fn test_chained_no_t_out() -> i64 {
    let c1: i64 = gen_outer_no_t_out<i64>(1i64, 77i64).await;
    let c2: i64 = gen_outer_no_t_out<bool>(true, 88i64).await;
    let c3: i64 = gen_outer_no_t_out<Tag2>(Tag2 { hi: 3i64, lo: 4i64 }, 99i64).await;
    print("chained ");
    print_int(c1);
    print(" ");
    print_int(c2);
    print(" ");
    print_int(c3);
    print("\n");
    c1 + c2 + c3
}

// 4. Sibling nested generic Future impls:
//    impl<T> Future for Wrap<BoxA<T>> vs impl<T> Future for Wrap<BoxB<T>>
@derive(Copy)
struct BoxA<T> {
    pub a_val: T,
}

@derive(Copy)
struct BoxB<T> {
    pub b_val: T,
    pub bonus: i64,
}

struct Wrap<U> {
    pub inner: U,
    pub spins: i32,
}

impl<T: Copy> Future for Wrap<BoxA<T>> {
    type Output = T;

    fn poll(self: mut_view<Wrap<BoxA<T>>>, cx: mut_view<Context>) -> Poll<T> {
        let _ = cx;
        if self.spins > 0i32 {
            self.spins = self.spins - 1i32;
            return Poll.Pending;
        }
        Poll.Ready(self.inner.a_val)
    }
}

impl<T: Copy> Future for Wrap<BoxB<T>> {
    type Output = (T, i64);

    fn poll(self: mut_view<Wrap<BoxB<T>>>, cx: mut_view<Context>) -> Poll<(T, i64)> {
        let _ = cx;
        if self.spins > 0i32 {
            self.spins = self.spins - 1i32;
            return Poll.Pending;
        }
        Poll.Ready((self.inner.b_val, self.inner.bonus))
    }
}

async fn test_sibling_nested() -> i64 {
    let a1: i64 = Wrap<BoxA<i64>> { inner: BoxA<i64> { a_val: 500i64 }, spins: 2i32 }.await;
    let a2: bool = Wrap<BoxA<bool>> { inner: BoxA<bool> { a_val: true }, spins: 1i32 }.await;
    let b1 = Wrap<BoxB<i64>> { inner: BoxB<i64> { b_val: 600i64, bonus: 1i64 }, spins: 2i32 }.await;
    let b2 = Wrap<BoxB<bool>> { inner: BoxB<bool> { b_val: false, bonus: 2i64 }, spins: 1i32 }.await;

    print("sibling ");
    print_int(a1);
    if a2 { print(" true "); } else { print(" false "); }
    print_int(b1.0 + b1.1);
    if b2.0 { print(" true\n"); } else { print(" false\n"); }
    a1 + b1.0 + b1.1 + b2.1
}

async fn run_all() -> i64 {
    let s1 = test_pair_and_drop().await;
    let s2 = test_chained_no_t_out().await;
    let s3 = test_sibling_nested().await;
    s1 + s2 + s3
}

fn main() -> i32 {
    let total = block_on(run_all());
    // s1 = 10 + 20 + 30 + 40 + 5 = 105
    // s2 = 77 + 88 + 99 = 264
    // s3 = 500 + 601 + 2 = 1103
    // total = 1472
    if total != 1472i64 {
        return 1i32;
    }
    0i32
}
