// test: run
// modes: interp native
// stdout: 77 true 305\n

use std.future.block_on.block_on;

@derive(Copy)
struct Wrap2<T> {
    pub val: T,
}

@derive(Copy)
struct Alt<T> {
    pub first: T,
    pub second: T,
}

struct Wrap<U> {
    pub inner: U,
    pub spins: i32,
}

// Placed BEFORE `impl<T> Future for Wrap<Wrap2<T>>` so any outer-def-only matcher would pick the wrong impl.
impl<T: Copy> Future for Wrap<Alt<T>> {
    type Output = (T, T);

    fn poll(self: mut_view<Wrap<Alt<T>>>, cx: mut_view<Context>) -> Poll<(T, T)> {
        let _ = cx;
        if self.spins > 0i32 {
            self.spins = self.spins - 1i32;
            return Poll.Pending;
        }
        Poll.Ready((self.inner.first, self.inner.second))
    }
}

impl<T: Copy> Future for Wrap<Wrap2<T>> {
    type Output = T;

    fn poll(self: mut_view<Wrap<Wrap2<T>>>, cx: mut_view<Context>) -> Poll<T> {
        let _ = cx;
        if self.spins > 0i32 {
            self.spins = self.spins - 1i32;
            return Poll.Pending;
        }
        Poll.Ready(self.inner.val)
    }
}

async fn test_nested() -> i64 {
    let n1 = Wrap<Wrap2<i64>> { inner: Wrap2<i64> { val: 77i64 }, spins: 2i32 };
    let v1: i64 = n1.await;

    let n2 = Wrap<Wrap2<bool>> { inner: Wrap2<bool> { val: true }, spins: 1i32 };
    let v2: bool = n2.await;

    let n3 = Wrap<Alt<i64>> { inner: Alt<i64> { first: 300i64, second: 5i64 }, spins: 1i32 };
    let pair = n3.await;
    let v3 = pair.0 + pair.1;

    print_int(v1);
    if v2 {
        print(" true ");
    } else {
        print(" false ");
    }
    print_int(v3);
    print("\n");
    v1 + v3
}

fn main() -> i32 {
    let res = block_on(test_nested());
    if res != 382i64 {
        return 1i32;
    }
    0i32
}
