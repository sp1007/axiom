@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

@PROBE_MIR_FN@

fn probe_blob(arena: mut_view<Arena>, idx: usize) -> StrView {
    let s: str = probe_mir_raw(idx);
    let raw_sv: StrView = unsafe { *(address_of(s) as *const StrView) };
    let bytes: view<[u8]> = unsafe { *(address_of(s) as *const view<[u8]>) };
    let n = raw_sv.len;
    let dst = arena_alloc_raw(mut_view(*arena), n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = bytes[i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView { ptr: dst as *const u8, len: n }
}

fn diag_buf_eq(a: view<DiagBuffer>, b: view<DiagBuffer>) -> bool {
    if a.len != b.len {
        return false;
    }
    let mut i: usize = 0;
    while i < a.len {
        let ba = unsafe { *(a.ptr + i) };
        let bb = unsafe { *(b.ptr + i) };
        if ba != bb {
            return false;
        }
        i = i + 1;
    }
    true
}

fn new_arena(chunk: usize) -> Arena {
    let mut a = arena_with_chunk_size(chunk);
    let _ = arena_alloc_raw(mut_view(a), 16, 8);
    a
}

fn probe_make_fn_item(arena: mut_view<Arena>, param_count: usize) -> *const HirItem {
    let it = hir_alloc_item(mut_view(*arena), HIR_ITEM_FN, Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 });
    let mut head: *mut HirParam = 0 as *mut HirParam;
    let mut i: usize = 0;
    while i < param_count {
        let p = hir_alloc_param(mut_view(*arena), Span { file: FileId { v: 0u32 }, start: 0u32, end: 0u32 });
        unsafe { (*p).next = head; }
        head = p;
        i = i + 1;
    }
    unsafe { (*it).params = head; }
    it as *const HirItem
}

// Section 1: `TransformationContract` (`PASS_LTO = 18u16`), `.axmeta` Summary Serialization, 64/128-bit Digests, & `ThinLTO` Invalidation
fn probe_lto_contract_and_axmeta_summary() -> i32 {
    let c = lto_contract();
    if c.pass_id != PASS_LTO || c.pass_id != 18u16 ||
       c.preserved_analyses != ANALYSIS_MASK_CALL_GRAPH ||
       c.postconditions != POSTCOND_ALL ||
       LTO_MODE_OFF != 0u8 || LTO_MODE_THIN != 1u8 || LTO_MODE_FAT != 2u8 || LTO_MODE_FULL != 2u8 ||
       WORLD_CLOSED != 0u8 || WORLD_PARTIAL != 1u8 || WORLD_OPEN != 2u8 {
        return 101;
    }

    let mut arena = new_arena(131072);
    let ms1 = lto_module_summary_new(mut_view(arena), 7u32, StrId { v: 1u32 });
    // Insert functions out of symbol order (30, 10, 20) to verify deterministic canonical sorting (`AXS-LTO-002.2`, `INV-DET-001`)
    let f30 = lto_fn_summary_default(SymbolId { v: 30u32 }, StrId { v: 30u32 }, 7u32, LTO_VIS_PUB);
    let f10 = lto_fn_summary_default(SymbolId { v: 10u32 }, StrId { v: 10u32 }, 7u32, LTO_VIS_EXPORTED);
    let f20 = lto_fn_summary_default(SymbolId { v: 20u32 }, StrId { v: 20u32 }, 7u32, LTO_VIS_PRIVATE);
    lto_module_summary_add_fn(unsafe { mut_view(*ms1) }, mut_view(arena), f30);
    lto_module_summary_add_fn(unsafe { mut_view(*ms1) }, mut_view(arena), f10);
    lto_module_summary_add_fn(unsafe { mut_view(*ms1) }, mut_view(arena), f20);

    let mut st1 = lto_static_summary_default(SymbolId { v: 90u32 }, 7u32, LTO_VIS_PUB);
    st1.has_const_init = true;
    st1.init_const_val = 0xCAFEBABEu64;
    lto_module_summary_add_static(unsafe { mut_view(*ms1) }, mut_view(arena), st1);

    let tr1 = LtoTraitImplRecord {
        trait_id: 3u32,
        concrete_type_id: 14u32,
        vtable_sym: SymbolId { v: 500u32 },
        method_sym: SymbolId { v: 20u32 },
        module_id: 7u32,
        is_coerced_to_dyn: true,
        is_live_vtable: true,
    };
    lto_module_summary_add_trait_impl(unsafe { mut_view(*ms1) }, mut_view(arena), tr1);

    let s0 = unsafe { (*lto_fn_at((*ms1).fns, 0)).fn_sym.v };
    let s1 = unsafe { (*lto_fn_at((*ms1).fns, 1)).fn_sym.v };
    let s2 = unsafe { (*lto_fn_at((*ms1).fns, 2)).fn_sym.v };
    let d1 = lto_compute_module_digest(unsafe { mut_view(*ms1) });
    if s0 != 10u32 || s1 != 20u32 || s2 != 30u32 || d1.lo == 0u64 || d1.hi == 0u64 || (unsafe { (*ms1).digest_64 }) != d1.lo {
        arena_destroy(mut_view(arena));
        return 102;
    }

    // Serialize & deserialize `.axmeta` binary summary
    let mut byte_len: usize = 0;
    let bytes = lto_serialize_module_summary(unsafe { view(*ms1) }, mut_view(arena), mut_view(byte_len));
    if (bytes as usize) == 0 || byte_len <= 44 || (unsafe { *lto_u8_at(bytes, 0) }) != AXMETA_MAGIC_0 {
        arena_destroy(mut_view(arena));
        return 103;
    }

    let ms_rt = lto_deserialize_module_summary(bytes as *const u8, byte_len, mut_view(arena));
    if (ms_rt as usize) == 0 {
        arena_destroy(mut_view(arena));
        return 104;
    }
    let rt_d = unsafe { (*ms_rt).digest_128 };
    if !lto_digest128_eq(view(d1), view(rt_d)) ||
       (unsafe { (*ms_rt).fn_count }) != 3 ||
       (unsafe { (*ms_rt).static_count }) != 1 ||
       (unsafe { (*ms_rt).trait_impl_count }) != 1 ||
       (unsafe { (*lto_fn_at((*ms_rt).fns, 1)).fn_sym.v }) != 20u32 {
        arena_destroy(mut_view(arena));
        return 105;
    }

    // Tamper with digest byte and magic byte -> must fail closed (`0 as *mut LtoModuleSummary`)
    unsafe { *lto_u8_at(bytes, 16) = (*lto_u8_at(bytes, 16)) ^ 0xFFu8; }
    let ms_tampered = lto_deserialize_module_summary(bytes as *const u8, byte_len, mut_view(arena));
    unsafe { *lto_u8_at(bytes, 0) = 0u8; }
    let ms_bad_magic = lto_deserialize_module_summary(bytes as *const u8, byte_len, mut_view(arena));
    if (ms_tampered as usize) != 0 || (ms_bad_magic as usize) != 0 {
        arena_destroy(mut_view(arena));
        return 106;
    }
    print("PROBE_LTO_CONTRACT_AND_AXMETA=OK\n");

    // Verify `ThinLTO` partition invalidation (`lto_thin_partition_needs_rebuild`, `AXS-LTO-002.4`, `ALTO-47`)
    let d_same = LtoDigest128 { lo: d1.lo, hi: d1.hi };
    let d_diff_hi = LtoDigest128 { lo: d1.lo, hi: d1.hi ^ 1u64 };
    if lto_thin_partition_needs_rebuild(view(d1), view(d_same), 0x1234u64, 0x1234u64) ||
       !lto_thin_partition_needs_rebuild(view(d1), view(d_diff_hi), 0x1234u64, 0x1234u64) ||
       !lto_thin_partition_needs_rebuild(view(d1), view(d_same), 0x1234u64, 0x5678u64) {
        arena_destroy(mut_view(arena));
        return 107;
    }
    print("PROBE_LTO_THIN_INVALIDATION=OK\n");
    arena_destroy(mut_view(arena));
    0
}

// Section 2: Whole-Program Closed-World Reachability, `pub` Internalization, Root Preservation, & Dead Pruning (`AXS-LTO-005, AXS-LTO-010`)
fn probe_lto_reachability_internalization_and_roots() -> i32 {
    let mut arena = new_arena(262144);
    let mut stats = lto_stats_zero();

    // First verify `WORLD_OPEN` does NOT internalize `pub` symbols (`ALTO-22`, `REQ-OPT-266`)
    let wpo_open = lto_wpo_new(mut_view(arena), 0 as *mut CallGraph, LTO_MODE_THIN, WORLD_OPEN);
    let ms_open = lto_module_summary_new(mut_view(arena), 1u32, StrId { v: 1u32 });
    lto_module_summary_add_fn(
        unsafe { mut_view(*ms_open) },
        mut_view(arena),
        lto_fn_summary_default(SymbolId { v: 11u32 }, StrId { v: 11u32 }, 1u32, LTO_VIS_PUB)
    );
    let _ = lto_wpo_import_module(unsafe { mut_view(*wpo_open) }, ms_open, mut_view(arena), mut_view(stats));
    let open_int = lto_internalize_symbols(unsafe { mut_view(*wpo_open) }, mut_view(stats));
    let open_link = unsafe { (*lto_fn_at((*wpo_open).fns, 0)).linkage };
    if open_int != 0u32 || open_link != LTO_LINKAGE_GLOBAL {
        arena_destroy(mut_view(arena));
        return 201;
    }

    // Now build a 2-module `WORLD_CLOSED` session with `LTO_MODE_FAT`
    let mut stats_closed = lto_stats_zero();
    let wpo = lto_wpo_new(mut_view(arena), 0 as *mut CallGraph, LTO_MODE_FAT, WORLD_CLOSED);
    let mod1 = lto_module_summary_new(mut_view(arena), 1u32, StrId { v: 1u32 });
    let mod2 = lto_module_summary_new(mut_view(arena), 2u32, StrId { v: 1u32 });

    // Module 1 functions:
    //   fn#1: `main` (`LTO_VIS_PUB`, marked `LTO_ROOT_ENTRY`)
    //   fn#2: `@export` ABI function (`LTO_VIS_EXPORTED`)
    //   fn#3: private dead function (`LTO_VIS_PRIVATE`)
    lto_module_summary_add_fn(unsafe { mut_view(*mod1) }, mut_view(arena), lto_fn_summary_default(SymbolId { v: 1u32 }, StrId { v: 1u32 }, 1u32, LTO_VIS_PUB));
    lto_module_summary_add_fn(unsafe { mut_view(*mod1) }, mut_view(arena), lto_fn_summary_default(SymbolId { v: 2u32 }, StrId { v: 2u32 }, 1u32, LTO_VIS_EXPORTED));
    lto_module_summary_add_fn(unsafe { mut_view(*mod1) }, mut_view(arena), lto_fn_summary_default(SymbolId { v: 3u32 }, StrId { v: 3u32 }, 1u32, LTO_VIS_PRIVATE));

    // Module 2 functions:
    //   fn#4: `pub` FFI callback root (`LTO_ROOT_FFI_CALLBACK`)
    //   fn#5: `pub` reflection root (`LTO_ROOT_REFLECTION`)
    //   fn#6: `pub` helper referenced by `@at` MMIO static#101
    //   fn#7: `pub` unused function (internalized + dead eliminated!)
    lto_module_summary_add_fn(unsafe { mut_view(*mod2) }, mut_view(arena), lto_fn_summary_default(SymbolId { v: 4u32 }, StrId { v: 4u32 }, 2u32, LTO_VIS_PUB));
    lto_module_summary_add_fn(unsafe { mut_view(*mod2) }, mut_view(arena), lto_fn_summary_default(SymbolId { v: 5u32 }, StrId { v: 5u32 }, 2u32, LTO_VIS_PUB));
    lto_module_summary_add_fn(unsafe { mut_view(*mod2) }, mut_view(arena), lto_fn_summary_default(SymbolId { v: 6u32 }, StrId { v: 6u32 }, 2u32, LTO_VIS_PUB));
    lto_module_summary_add_fn(unsafe { mut_view(*mod2) }, mut_view(arena), lto_fn_summary_default(SymbolId { v: 7u32 }, StrId { v: 7u32 }, 2u32, LTO_VIS_PUB));

    // Statics:
    //   static#101: `@at` / `volatile` hardware MMIO table referencing `fn#6` (`AXS-LTO-005.1(e)`, `ALTO-41`)
    //   static#102: unused `pub` static (internalized + dead eliminated!)
    let mut st_mmio = lto_static_summary_default(SymbolId { v: 101u32 }, 1u32, LTO_VIS_PUB);
    st_mmio.is_volatile_or_pinned_at = true;
    st_mmio.referenced_fn_sym = SymbolId { v: 6u32 };
    lto_module_summary_add_static(unsafe { mut_view(*mod1) }, mut_view(arena), st_mmio);

    let st_dead = lto_static_summary_default(SymbolId { v: 102u32 }, 2u32, LTO_VIS_PUB);
    lto_module_summary_add_static(unsafe { mut_view(*mod2) }, mut_view(arena), st_dead);

    // Unused trait impl (no reachable `DISPATCH_DYN_TRAIT` call in the program -> RTA prunes vtable)
    lto_module_summary_add_trait_impl(unsafe { mut_view(*mod2) }, mut_view(arena), LtoTraitImplRecord {
        trait_id: 9u32,
        concrete_type_id: 42u32,
        vtable_sym: SymbolId { v: 900u32 },
        method_sym: SymbolId { v: 7u32 },
        module_id: 2u32,
        is_coerced_to_dyn: true,
        is_live_vtable: true,
    });

    let _ = lto_wpo_import_module(unsafe { mut_view(*wpo) }, mod1, mut_view(arena), mut_view(stats_closed));
    let _ = lto_wpo_import_module(unsafe { mut_view(*wpo) }, mod2, mut_view(arena), mut_view(stats_closed));

    // Register formal roots in $R_{root}$ (`Entry`, `FfiCallback`, `Reflection`)
    let mr1 = lto_mark_root_symbol(unsafe { mut_view(*wpo) }, SymbolId { v: 1u32 }, LTO_ROOT_ENTRY);
    let mr4 = lto_mark_root_symbol(unsafe { mut_view(*wpo) }, SymbolId { v: 4u32 }, LTO_ROOT_FFI_CALLBACK);
    let mr5 = lto_mark_root_symbol(unsafe { mut_view(*wpo) }, SymbolId { v: 5u32 }, LTO_ROOT_REFLECTION);
    if !mr1 || !mr4 || !mr5 {
        arena_destroy(mut_view(arena));
        return 202;
    }

    // Internalize non-root `pub` symbols (`fn#6`, `fn#7`, `static#102` -> 3 symbols internalized)
    let int_cnt = lto_internalize_symbols(unsafe { mut_view(*wpo) }, mut_view(stats_closed));
    let idx2 = lto_wpo_find_fn_idx(unsafe { view(*wpo) }, SymbolId { v: 2u32 }) as usize;
    let idx4 = lto_wpo_find_fn_idx(unsafe { view(*wpo) }, SymbolId { v: 4u32 }) as usize;
    let idx6 = lto_wpo_find_fn_idx(unsafe { view(*wpo) }, SymbolId { v: 6u32 }) as usize;
    let idx7 = lto_wpo_find_fn_idx(unsafe { view(*wpo) }, SymbolId { v: 7u32 }) as usize;
    if int_cnt != 3u32 ||
       (unsafe { (*lto_fn_at((*wpo).fns, idx2)).linkage }) != LTO_LINKAGE_EXPORTED_ROOT ||
       (unsafe { (*lto_fn_at((*wpo).fns, idx4)).linkage }) != LTO_LINKAGE_EXPORTED_ROOT ||
       !(unsafe { (*lto_fn_at((*wpo).fns, idx4)).address_taken_fn }) ||
       (unsafe { (*lto_fn_at((*wpo).fns, idx6)).linkage }) != LTO_LINKAGE_INTERNALIZED ||
       (unsafe { (*lto_fn_at((*wpo).fns, idx7)).linkage }) != LTO_LINKAGE_INTERNALIZED {
        arena_destroy(mut_view(arena));
        return 203;
    }
    print("PROBE_LTO_INTERNALIZE_AND_ROOTS=OK\n");

    let dead_cnt = lto_compute_reachability(unsafe { mut_view(*wpo) }, mut_view(arena), mut_view(stats_closed));
    let pruned_cnt = lto_prune_unreachable(unsafe { mut_view(*wpo) }, mut_view(stats_closed));
    let idx3 = lto_wpo_find_fn_idx(unsafe { view(*wpo) }, SymbolId { v: 3u32 }) as usize;
    if dead_cnt != 2u32 ||
       pruned_cnt != 4u32 ||
       stats_closed.dead_fns_eliminated != 2u32 ||
       stats_closed.dead_statics_eliminated != 1u32 ||
       stats_closed.dead_vtables_eliminated != 1u32 ||
       (unsafe { (*lto_fn_at((*wpo).fns, idx6)).reachability }) != REACH_INTERNAL ||
       (unsafe { (*lto_fn_at((*wpo).fns, idx3)).linkage }) != LTO_LINKAGE_DEAD_ELIMINATED ||
       (unsafe { (*lto_fn_at((*wpo).fns, idx7)).linkage }) != LTO_LINKAGE_DEAD_ELIMINATED ||
       (unsafe { (*lto_static_at((*wpo).statics, 0)).reachability }) != REACH_ROOT ||
       (unsafe { (*lto_static_at((*wpo).statics, 0)).root_kind }) != LTO_ROOT_PINNED_AT ||
       (unsafe { (*lto_static_at((*wpo).statics, 1)).linkage }) != LTO_LINKAGE_DEAD_ELIMINATED ||
       (unsafe { (*lto_trait_at((*wpo).trait_impls, 0)).is_live_vtable }) {
        arena_destroy(mut_view(arena));
        return 204;
    }
    print("PROBE_LTO_REACHABILITY_AND_PRUNE=OK\n");
    arena_destroy(mut_view(arena));
    0
}

// Section 3: Cross-Module Summary Propagation (`UnknownAlias` Barrier, `atomic` & `volatile`), RTA Devirt, Specialization, Inlining, & Rollback
fn probe_lto_cross_module_opt_and_summaries() -> i32 {
    let mut mir_a = new_arena(1048576);
    let thir_ptr = arena_alloc_raw(mut_view(mir_a), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    opt_init_minimal_thir(thir_ptr, mut_view(mir_a));
    let sink_fe = arena_alloc_raw(mut_view(mir_a), size_of<DiagSink>(), align_of<DiagSink>()) as *mut DiagSink;
    diag_sink_init(unsafe { mut_view(*sink_fe) });

    let ct_fe = arena_alloc_raw(mut_view(mir_a), size_of<EffectCallTable>(), align_of<EffectCallTable>()) as *mut EffectCallTable;
    effect_call_table_init(unsafe { mut_view(*ct_fe) }, mut_view(mir_a), 32);
    let esc_tbl = arena_alloc_raw(mut_view(mir_a), size_of<EscapeSummaryTable>(), align_of<EscapeSummaryTable>()) as *mut EscapeSummaryTable;
    escape_summary_table_init(unsafe { mut_view(*esc_tbl) }, mut_view(mir_a), 32);

    let cg = callgraph_new(mut_view(mir_a), thir_ptr as *const Thir, true, false);
    let wpo = lto_wpo_new(mut_view(mir_a), cg, LTO_MODE_FAT, WORLD_CLOSED);
    let mod_a = lto_module_summary_new(mut_view(mir_a), 1u32, StrId { v: 1u32 });
    let mod_b = lto_module_summary_new(mut_view(mir_a), 2u32, StrId { v: 1u32 });

    let fn_sym_vs: [5]u32 = [501u32, 502u32, 503u32, 504u32, 505u32];
    let mut rc: i32 = 0;
    let mut fn_idx: usize = 0;
    while fn_idx < 5 {
        let blob_sv = probe_blob(mut_view(mir_a), fn_idx);
        let mbody: *mut MirBody = verify_parse_mir(
            blob_sv,
            unsafe { mut_view((*thir_ptr).interner) },
            mut_view(mir_a)
        );
        if (mbody as usize) == 0 {
            rc = 301;
            break;
        }
        let sym_v = fn_sym_vs[fn_idx];
        unsafe {
            (*mbody).sym = SymbolId { v: sym_v };
            (*mbody).fn_sym = SymbolId { v: sym_v };
            (*mbody).fn_name = StrId { v: sym_v };
        }
        if fn_idx == 3 {
            // Wire `mod_a_entry` (`fn#504`) direct call targets:
            //   bb0 -> `mod_b_leaf_scale` (`fn#501`)
            //   bb1 -> `mod_b_spec_kernel` (`fn#502`)
            //   bb2 remains an indirect call with 0 local targets so `lto_resolve_closed_world_trait_targets`
            //   resolves it to `mod_b_dyn_impl` (`fn#503`) via closed-world RTA (`AXS-LTO-013.1`).
            let bb0 = unsafe { mir_bb_at((*mbody).bbs, 0) };
            let bb1 = unsafe { mir_bb_at((*mbody).bbs, 1) };
            unsafe {
                (*bb0).terminator.func.constant.kind = MIR_CONST_FN;
                (*bb0).terminator.func.constant.sym = SymbolId { v: fn_sym_vs[0] };
                (*bb0).terminator.func.constant.val = fn_sym_vs[0] as u64;

                (*bb1).terminator.func.constant.kind = MIR_CONST_FN;
                (*bb1).terminator.func.constant.sym = SymbolId { v: fn_sym_vs[1] };
                (*bb1).terminator.func.constant.val = fn_sym_vs[1] as u64;
            }
        }
        let ob = optir_build_from_verified_mir(
            unsafe { view(*mbody) },
            thir_ptr as *const Thir,
            mut_view(mir_a)
        );
        if (ob as usize) == 0 {
            rc = 302;
            break;
        }
        unsafe { (*ob).fn_sym = SymbolId { v: sym_v }; }
        let fn_item_p = probe_make_fn_item(mut_view(mir_a), unsafe { (*mbody).arg_count });
        let _ = callgraph_add_node(
            unsafe { mut_view(*cg) },
            mut_view(mir_a),
            SymbolId { v: sym_v },
            StrId { v: sym_v },
            mbody,
            ob,
            fn_item_p,
            INLINE_ATTR_NONE,
            false,
            fn_idx == 3,
            false,
            false,
            DOMAIN_CPU_HOST,
            false
        );
        let mod_id: u32 = if fn_idx == 3 { 1u32 } else { 2u32 };
        let mut fsum = lto_fn_summary_default(SymbolId { v: sym_v }, StrId { v: sym_v }, mod_id, LTO_VIS_PUB);
        if fn_idx == 0 {
            // `mod_b_leaf_scale`: test `atomic` and `volatile` preservation (`ALTO-40..41`)
            fsum.has_atomic_ops = true;
            fsum.has_volatile_ops = true;
        } else if fn_idx == 4 {
            // `mod_b_dead_helper`: test fail-closed `UnknownAlias` barrier on raw-pointer / FFI alias (`ALTO-38..39`)
            fsum.has_raw_ptr_or_ffi_alias = true;
        }
        if mod_id == 1u32 {
            lto_module_summary_add_fn(unsafe { mut_view(*mod_a) }, mut_view(mir_a), fsum);
        } else {
            lto_module_summary_add_fn(unsafe { mut_view(*mod_b) }, mut_view(mir_a), fsum);
        }
        fn_idx = fn_idx + 1;
    }

    if rc == 0 {
        // Register `mod_b_dyn_impl` (`fn_sym_vs[2]`) as the sole closed-world `dyn Trait` implementor in `mod_b`
        lto_module_summary_add_trait_impl(unsafe { mut_view(*mod_b) }, mut_view(mir_a), LtoTraitImplRecord {
            trait_id: 1u32,
            concrete_type_id: 10u32,
            vtable_sym: SymbolId { v: 700u32 },
            method_sym: SymbolId { v: fn_sym_vs[2] },
            module_id: 2u32,
            is_coerced_to_dyn: true,
            is_live_vtable: true,
        });

        let mut stats = lto_stats_zero();
        let _ = lto_wpo_import_module(unsafe { mut_view(*wpo) }, mod_a, mut_view(mir_a), mut_view(stats));
        let _ = lto_wpo_import_module(unsafe { mut_view(*wpo) }, mod_b, mut_view(mir_a), mut_view(stats));
        let _ = lto_mark_root_symbol(unsafe { mut_view(*wpo) }, SymbolId { v: fn_sym_vs[3] }, LTO_ROOT_ENTRY);

        // Verify cross-module summary propagation & fail-closed `UnknownAlias` / `atomic` / `volatile` barriers
        lto_propagate_cross_module_summaries(
            unsafe { mut_view(*wpo) },
            unsafe { mut_view(*ct_fe) },
            unsafe { mut_view(*esc_tbl) },
            mut_view(stats),
            mut_view(mir_a)
        );
        let f0_idx = lto_wpo_find_fn_idx(unsafe { view(*wpo) }, SymbolId { v: fn_sym_vs[0] }) as usize;
        let f4_idx = lto_wpo_find_fn_idx(unsafe { view(*wpo) }, SymbolId { v: fn_sym_vs[4] }) as usize;
        let f0_eff = unsafe { (*lto_fn_at((*wpo).fns, f0_idx)).effect_flags };
        let f0_alias = unsafe { (*lto_fn_at((*wpo).fns, f0_idx)).alias_state };
        let f4_alias = unsafe { (*lto_fn_at((*wpo).fns, f4_idx)).alias_state };
        let f4_mask = unsafe { (*lto_fn_at((*wpo).fns, f4_idx)).param_no_alias_mask };
        if (f0_eff & EFFECT_ATOMIC) == 0u16 ||
           (f0_eff & EFFECT_VOLATILE) == 0u16 ||
           f0_alias != LTO_ALIAS_NO_ALIAS ||
           f4_alias != LTO_ALIAS_UNKNOWN_ALIAS ||
           f4_mask != 0u64 ||
           stats.unknown_alias_barriers == 0u32 ||
           stats.atomic_barriers_preserved == 0u32 ||
           stats.volatile_mmio_preserved == 0u32 ||
           stats.cross_module_escape_noescape == 0u32 ||
           stats.cross_module_alias_noalias == 0u32 {
            rc = 303;
        }
    }

    if rc == 0 {
        print("PROBE_LTO_SUMMARY_AND_ALIAS_BARRIERS=OK\n");

        // Test `PassManager` transactional rollback when `force_verify_fail = true` (`lto_run_pass_internal`)
        callgraph_finalize(unsafe { mut_view(*cg) }, unsafe { mut_view(*ct_fe) }, unsafe { mut_view(*esc_tbl) }, mut_view(mir_a));
        let entry_ob = unsafe { (*cg_node_at((*cg).nodes, 3)).opt_body };
        let pm_lto = arena_alloc_raw(mut_view(mir_a), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
        passmgr_init(unsafe { mut_view(*pm_lto) }, opt_budget_for_profile(OPT_PROFILE_SPEED_O2, true), mut_view(mir_a));
        passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_lto) }, unsafe { mut_view(*entry_ob) }, mut_view(mir_a));
        let mut rb_stats = lto_stats_zero();
        let rb_chg = lto_run_pass_internal(
            unsafe { mut_view(*pm_lto) },
            unsafe { mut_view(*entry_ob) },
            unsafe { mut_view(*wpo) },
            unsafe { mut_view(*ct_fe) },
            unsafe { mut_view(*esc_tbl) },
            mut_view(rb_stats),
            true,
            mut_view(mir_a),
            unsafe { mut_view(*sink_fe) }
        );
        if rb_chg || rb_stats.pass_rollbacks != 1u32 {
            rc = 304;
        }
    }

    if rc == 0 {
        let mut opt_stats = lto_stats_zero();
        let inl_log = inline_log_new(mut_view(mir_a), 32);
        let sp_log = ipa_spec_log_new(mut_view(mir_a), 32);
        let dv_log = devirt_log_new(mut_view(mir_a), 32);
        let mut sr_stats = sroa_stats_zero();
        let sr_log = sroa_log_new(mut_view(mir_a), 32);

        let changed = lto_run_cross_module_opt(
            unsafe { mut_view(*wpo) },
            OPT_PROFILE_SPEED_O2,
            unsafe { mut_view(*ct_fe) },
            unsafe { mut_view(*esc_tbl) },
            mut_view(opt_stats),
            inl_log,
            sp_log,
            dv_log,
            unsafe { address_of_mut(sr_stats) },
            sr_log,
            mut_view(mir_a),
            unsafe { mut_view(*sink_fe) }
        );
        let dead_idx = lto_wpo_find_fn_idx(unsafe { view(*wpo) }, SymbolId { v: fn_sym_vs[4] }) as usize;
        if !changed ||
           opt_stats.cross_module_devirt_exact == 0u32 ||
           opt_stats.cross_module_specialized == 0u32 ||
           opt_stats.cross_module_inlined == 0u32 ||
           opt_stats.dead_fns_eliminated == 0u32 ||
           (unsafe { (*lto_fn_at((*wpo).fns, dead_idx)).linkage }) != LTO_LINKAGE_DEAD_ELIMINATED {
            rc = 305;
        } else {
            print("PROBE_LTO_CROSS_MODULE_OPT_AND_ROLLBACK=OK\n");
        }
    }

    diag_sink_free(unsafe { mut_view(*sink_fe) });
    opt_free_minimal_thir(thir_ptr);
    arena_destroy(mut_view(mir_a));
    rc
}

// Section 4: Cross-Module Generic Monomorphization Deduplication, Function-Pointer Identity Guard, & `--emit=lto` (`AXS-LTO-014, ALTO-30..33`)
fn probe_lto_generic_dedup_and_emit() -> i32 {
    let mut arena = new_arena(262144);
    let mut stats = lto_stats_zero();
    let wpo = lto_wpo_new(mut_view(arena), 0 as *mut CallGraph, LTO_MODE_FAT, WORLD_CLOSED);
    let mod1 = lto_module_summary_new(mut_view(arena), 1u32, StrId { v: 1u32 });
    let mod2 = lto_module_summary_new(mut_view(arena), 2u32, StrId { v: 1u32 });
    let mod3 = lto_module_summary_new(mut_view(arena), 3u32, StrId { v: 1u32 });

    // 1. Canonical leader in module 1: `vec_len<u64>` (`sym#201`)
    let mut g1 = lto_fn_summary_default(SymbolId { v: 201u32 }, StrId { v: 201u32 }, 1u32, LTO_VIS_PUB);
    g1.generic_def_id = 50u32;
    g1.canonical_type_arg_hash = 0xAAA00001u64;
    g1.body_fingerprint = 0x7777888899990000u64;
    g1.rep_type_size = 8u32;
    g1.rep_type_align = 8u32;
    g1.rep_abi_class = 1u8;
    g1.reachability = REACH_INTERNAL;

    // 2. Exact duplicate in module 2: `vec_len<u64>` (`sym#202`) -> `LTO_DEDUP_EXACT_INSTANCE` (`ALTO-30`)
    let mut g2 = lto_fn_summary_default(SymbolId { v: 202u32 }, StrId { v: 202u32 }, 2u32, LTO_VIS_PUB);
    g2.generic_def_id = 50u32;
    g2.canonical_type_arg_hash = 0xAAA00001u64;
    g2.body_fingerprint = 0x7777888899990000u64;
    g2.rep_type_size = 8u32;
    g2.rep_type_align = 8u32;
    g2.rep_abi_class = 1u8;
    g2.reachability = REACH_INTERNAL;

    // 3. Representation-equivalent in module 2: `vec_len<*const u8>` (`sym#203`, no address taken, no custom drop) -> `LTO_DEDUP_REP_EQUIV_SHARED` (`ALTO-31, ALTO-33`)
    let mut g3 = lto_fn_summary_default(SymbolId { v: 203u32 }, StrId { v: 203u32 }, 2u32, LTO_VIS_PUB);
    g3.generic_def_id = 50u32;
    g3.canonical_type_arg_hash = 0xBBB00002u64;
    g3.body_fingerprint = 0x7777888899990000u64;
    g3.rep_type_size = 8u32;
    g3.rep_type_align = 8u32;
    g3.rep_abi_class = 1u8;
    g3.address_taken_fn = false;
    g3.has_custom_drop = false;
    g3.reachability = REACH_INTERNAL;

    // 4. Address-taken instantiation in module 3: `vec_len<usize>` (`sym#204`, `address_taken_fn = true`) -> MUST NOT MERGE (`LTO_DEDUP_KEPT_ADDRESS_TAKEN`, `ALTO-32`)
    let mut g4 = lto_fn_summary_default(SymbolId { v: 204u32 }, StrId { v: 204u32 }, 3u32, LTO_VIS_PUB);
    g4.generic_def_id = 50u32;
    g4.canonical_type_arg_hash = 0xCCC00003u64;
    g4.body_fingerprint = 0x7777888899990000u64;
    g4.rep_type_size = 8u32;
    g4.rep_type_align = 8u32;
    g4.rep_abi_class = 1u8;
    g4.address_taken_fn = true;
    g4.reachability = REACH_INTERNAL;

    // 5. Custom-drop instantiation in module 3: `vec_len<OwnedHandle>` (`sym#205`, `has_custom_drop = true`) -> MUST NOT MERGE (`LTO_DEDUP_KEPT_CUSTOM_DROP`)
    let mut g5 = lto_fn_summary_default(SymbolId { v: 205u32 }, StrId { v: 205u32 }, 3u32, LTO_VIS_PUB);
    g5.generic_def_id = 50u32;
    g5.canonical_type_arg_hash = 0xDDD00004u64;
    g5.body_fingerprint = 0x7777888899990000u64;
    g5.rep_type_size = 8u32;
    g5.rep_type_align = 8u32;
    g5.rep_abi_class = 1u8;
    g5.has_custom_drop = true;
    g5.reachability = REACH_INTERNAL;

    lto_module_summary_add_fn(unsafe { mut_view(*mod1) }, mut_view(arena), g1);
    lto_module_summary_add_fn(unsafe { mut_view(*mod2) }, mut_view(arena), g2);
    lto_module_summary_add_fn(unsafe { mut_view(*mod2) }, mut_view(arena), g3);
    lto_module_summary_add_fn(unsafe { mut_view(*mod3) }, mut_view(arena), g4);
    lto_module_summary_add_fn(unsafe { mut_view(*mod3) }, mut_view(arena), g5);

    let _ = lto_wpo_import_module(unsafe { mut_view(*wpo) }, mod1, mut_view(arena), mut_view(stats));
    let _ = lto_wpo_import_module(unsafe { mut_view(*wpo) }, mod2, mut_view(arena), mut_view(stats));
    let _ = lto_wpo_import_module(unsafe { mut_view(*wpo) }, mod3, mut_view(arena), mut_view(stats));

    let merged = lto_deduplicate_generics(unsafe { mut_view(*wpo) }, mut_view(arena), mut_view(stats));
    if merged != 2u32 ||
       stats.generics_dedup_exact != 1u32 ||
       stats.generics_rep_shared != 1u32 ||
       stats.generics_kept_addr_taken != 1u32 ||
       stats.generics_kept_custom_drop != 1u32 ||
       (unsafe { (*wpo).dedup_count }) != 4 {
        arena_destroy(mut_view(arena));
        return 401;
    }

    let d0 = unsafe { *lto_dedup_at((*wpo).dedup_records, 0) };
    let d1 = unsafe { *lto_dedup_at((*wpo).dedup_records, 1) };
    let d2 = unsafe { *lto_dedup_at((*wpo).dedup_records, 2) };
    let d3 = unsafe { *lto_dedup_at((*wpo).dedup_records, 3) };
    if d0.decision != LTO_DEDUP_EXACT_INSTANCE || d0.canonical_sym.v != 201u32 || d0.candidate_sym.v != 202u32 ||
       d1.decision != LTO_DEDUP_REP_EQUIV_SHARED || d1.canonical_sym.v != 201u32 || d1.candidate_sym.v != 203u32 ||
       d2.decision != LTO_DEDUP_KEPT_ADDRESS_TAKEN || d2.candidate_sym.v != 204u32 ||
       d3.decision != LTO_DEDUP_KEPT_CUSTOM_DROP || d3.candidate_sym.v != 205u32 ||
       (unsafe { (*lto_fn_at((*wpo).fns, 1)).canonical_leader_sym.v }) != 201u32 ||
       (unsafe { (*lto_fn_at((*wpo).fns, 2)).canonical_leader_sym.v }) != 201u32 ||
       (unsafe { (*lto_fn_at((*wpo).fns, 3)).canonical_leader_sym.v }) != 204u32 ||
       (unsafe { (*lto_fn_at((*wpo).fns, 3)).linkage }) == LTO_LINKAGE_DEAD_ELIMINATED ||
       (unsafe { (*lto_fn_at((*wpo).fns, 4)).canonical_leader_sym.v }) != 205u32 {
        arena_destroy(mut_view(arena));
        return 402;
    }
    print("PROBE_LTO_GENERIC_DEDUP_AND_FN_PTR=OK\n");

    // Verify deterministic `--emit=lto` (`lto_print`, `AXS-PGO-015`)
    let mut b1: DiagBuffer = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    let mut b2: DiagBuffer = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(b1));
    diag_buf_init(mut_view(b2));
    lto_print(unsafe { view(*wpo) }, view(stats), mut_view(b1));
    lto_print(unsafe { view(*wpo) }, view(stats), mut_view(b2));
    let eq = diag_buf_eq(view(b1), view(b2)) && b1.len > 80;
    diag_buf_free(mut_view(b1));
    diag_buf_free(mut_view(b2));
    arena_destroy(mut_view(arena));
    if !eq {
        return 403;
    }
    print("PROBE_LTO_EMIT_DETERMINISM=OK\n");
    0
}

fn main() -> i32 {
    let r1 = probe_lto_contract_and_axmeta_summary();
    if r1 != 0 {
        return r1;
    }
    let r2 = probe_lto_reachability_internalization_and_roots();
    if r2 != 0 {
        return r2;
    }
    let r3 = probe_lto_cross_module_opt_and_summaries();
    if r3 != 0 {
        return r3;
    }
    let r4 = probe_lto_generic_dedup_and_emit();
    if r4 != 0 {
        return r4;
    }
    print("PROBE_LTO_ALL=PASS\n");
    0
}
