// test: run
// modes: interp native
// exit: 0
// stdout: LTO_XMOD_BANNER=Cross_Module_Inline_Spec_Devirt\nLTO_XMOD_TRAIT_DEVIRT=84\nLTO_XMOD_CONST_SPEC=110\nLTO_XMOD_FNPTR_DEVIRT=98\nLTO_XMOD_ESCAPE_ALIAS=84\nLTO_XMOD_TOTAL=376\n

@derive(Copy)
enum CodecMode {
    Fast(i32),
    Safe(i32, i32),
}

trait FrameChecksum {
    fn fold_word(self: view<Self>, word: i32) -> i32;
}

struct FastCrc {
    seed: i32,
}

impl FrameChecksum for FastCrc {
    fn fold_word(self: view<FastCrc>, word: i32) -> i32 {
        (word * 5) + self.seed
    }
}

struct XorHash {
    mask: i32,
}

impl FrameChecksum for XorHash {
    fn fold_word(self: view<XorHash>, word: i32) -> i32 {
        (word ^ self.mask) + 3
    }
}

struct PacketBuf {
    a: i32,
    b: i32,
}

// 1. Closed-world trait devirtualization + cross-module inlining (`AXS-LTO-011`, `AXS-LTO-013`, `REQ-OPT-271`, `REQ-OPT-273`)
fn test_trait_devirt() -> i32 {
    let crc = FastCrc { seed: 9 };
    let xh = XorHash { mask: 6 };
    crc.fold_word(12) + xh.fold_word(10)
}

// 2. Cross-module constant & enum-tag specialization + dead-branch elimination (`AXS-LTO-011.2..3`, `REQ-OPT-272`)
pub fn cross_mod_specialize(mode: CodecMode, fast_flag: bool, x: i32) -> i32 {
    let base: i32 = match mode {
        CodecMode.Fast(scale) => x * scale,
        CodecMode.Safe(scale, bias) => (x * scale) + bias,
    };
    if fast_flag {
        base + 10
    } else {
        base - 4
    }
}

// 3. Cross-module function-pointer specialization + Tier 1 Exact & Tier 2 Guarded devirtualization (`AXS-LTO-013.2`)
fn transform_double_plus_one(v: i32) -> i32 {
    (v * 2) + 1
}

fn transform_triple_minus_two(v: i32) -> i32 {
    (v * 3) - 2
}

pub fn apply_cross_mod_fn(f: fn(i32) -> i32, x: i32, sel: i32) -> i32 {
    let g: fn(i32) -> i32 = if sel == 0 {
        transform_double_plus_one
    } else {
        transform_triple_minus_two
    };
    f(x) + g(x)
}

// 4. Cross-module `FunctionEscapeSummary` (`NoEscape`) and capability `AliasSummary` (`NoAlias`) propagation (`AXS-LTO-012.2..3`, `REQ-OPT-274..276`)
pub fn cross_mod_accumulate(ro: view<PacketBuf>, out: mut_view<PacketBuf>, scale: i32) {
    out.a = out.a + (ro.a * scale);
    out.b = out.b + (ro.b * scale);
}

fn test_escape_alias_promotion() -> i32 {
    let src = PacketBuf { a: 7, b: 11 };
    let mut dst = PacketBuf { a: 10, b: 20 };
    cross_mod_accumulate(view(src), mut_view(dst), 3);
    dst.a + dst.b
}

fn main() -> i32 {
    print("LTO_XMOD_BANNER=Cross_Module_Inline_Spec_Devirt\n");

    let v_trait: i32 = test_trait_devirt();
    print("LTO_XMOD_TRAIT_DEVIRT=");
    print_int(v_trait);
    print("\n");

    let v_spec: i32 = cross_mod_specialize(CodecMode.Fast(4), true, 15) +
                      cross_mod_specialize(CodecMode.Safe(3, 8), false, 12);
    print("LTO_XMOD_CONST_SPEC=");
    print_int(v_spec);
    print("\n");

    let v_fnptr: i32 = apply_cross_mod_fn(transform_double_plus_one, 10, 0) +
                       apply_cross_mod_fn(transform_triple_minus_two, 10, 1);
    print("LTO_XMOD_FNPTR_DEVIRT=");
    print_int(v_fnptr);
    print("\n");

    let v_esc: i32 = test_escape_alias_promotion();
    print("LTO_XMOD_ESCAPE_ALIAS=");
    print_int(v_esc);
    print("\n");

    let total: i32 = v_trait + v_spec + v_fnptr + v_esc;
    print("LTO_XMOD_TOTAL=");
    print_int(total);
    print("\n");

    if total != 376 {
        return 1;
    }
    0
}
