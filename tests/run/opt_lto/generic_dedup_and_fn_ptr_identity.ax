// test: run
// modes: interp native
// exit: 0
// stdout: LTO_DEDUP_BANNER=Generic_Dedup_And_Fn_Ptr_Identity\nLTO_GENERIC_INST=175\nLTO_REP_SHARED=60\nLTO_ADDR_TAKEN_PAIR=80\nDEDUP_DROP_B=2\nDEDUP_DROP_A=1\nLTO_CUSTOM_DROP=50\nLTO_DEDUP_TOTAL=365\n

struct DropTokenA {
    id: i32,
}

impl Drop for DropTokenA {
    fn drop(self: mut_view<DropTokenA>) {
        print("DEDUP_DROP_A=");
        print_int(self.id);
        print("\n");
    }
}

struct DropTokenB {
    id: i32,
}

impl Drop for DropTokenB {
    fn drop(self: mut_view<DropTokenB>) {
        print("DEDUP_DROP_B=");
        print_int(self.id);
        print("\n");
    }
}

// 1. Generic monomorphization deduplication (`AXS-LTO-014.1`, `REQ-OPT-267`, `ALTO-30`)
pub fn generic_id<T>(x: T) -> T {
    x
}

pub fn generic_select<T>(cond: bool, a: T, b: T) -> T {
    if cond {
        a
    } else {
        b
    }
}

fn test_generic_dedup() -> i32 {
    let a: i32 = generic_id<i32>(42) + generic_id<i32>(58);
    let b: i64 = generic_id<i64>(30i64) + generic_select<i64>(true, 20i64, 99i64);
    let c: i32 = generic_select<i32>(false, 10, 25);
    a + (b as i32) + c
}

// 2. Non-address-taken representation-equivalent functions (`AXS-LTO-014.2`, `REQ-OPT-268`, `REQ-OPT-270`, `ALTO-31`, `ALTO-33`)
fn clamp_non_neg_a(x: i32) -> i32 {
    if x < 0 {
        0
    } else {
        x + 5
    }
}

fn clamp_non_neg_b(x: i32) -> i32 {
    if x < 0 {
        0
    } else {
        x + 5
    }
}

// 3. Address-taken representation-equivalent functions (`AXS-LTO-014.3`, `REQ-OPT-269`, `ALTO-32`)
// Because `address_taken_fn == true`, their function-pointer identities MUST remain distinct.
fn addr_taken_left(x: i32) -> i32 {
    x + 11
}

fn addr_taken_right(x: i32) -> i32 {
    x + 11
}

fn invoke_pair(f1: fn(i32) -> i32, f2: fn(i32) -> i32, v: i32) -> i32 {
    f1(v) + f2(v + 10)
}

// 4. Distinct custom `Drop` glue barrier (`has_custom_drop == true`, `AXS-LTO-014.2`, `ALTO-31`)
fn run_drop_distinct() -> i32 {
    let mut sum: i32 = 0;
    {
        let ta = DropTokenA { id: 1 };
        let tb = DropTokenB { id: 2 };
        sum = (ta.id * 10) + (tb.id * 20);
    }
    sum
}

fn main() -> i32 {
    print("LTO_DEDUP_BANNER=Generic_Dedup_And_Fn_Ptr_Identity\n");

    let v_gen: i32 = test_generic_dedup();
    print("LTO_GENERIC_INST=");
    print_int(v_gen);
    print("\n");

    let v_rep: i32 = clamp_non_neg_a(20) + clamp_non_neg_b(30) + clamp_non_neg_a(-5);
    print("LTO_REP_SHARED=");
    print_int(v_rep);
    print("\n");

    let fp_left: fn(i32) -> i32 = addr_taken_left;
    let fp_right: fn(i32) -> i32 = addr_taken_right;
    let v_addr: i32 = invoke_pair(fp_left, fp_right, 24);
    print("LTO_ADDR_TAKEN_PAIR=");
    print_int(v_addr);
    print("\n");

    let v_drop: i32 = run_drop_distinct();
    print("LTO_CUSTOM_DROP=");
    print_int(v_drop);
    print("\n");

    let total: i32 = v_gen + v_rep + v_addr + v_drop;
    print("LTO_DEDUP_TOTAL=");
    print_int(total);
    print("\n");

    if total != 365 {
        return 1;
    }
    0
}
