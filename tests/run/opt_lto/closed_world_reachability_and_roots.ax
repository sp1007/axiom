// test: run
// modes: interp native
// exit: 0
// stdout: LTO_ROOTS_BANNER=Closed_World_Reachability_And_Roots\nLTO_INTERNAL_REACH=100\nLTO_EXPORT_ROOT=72\nLTO_FFI_CALLBACK=54\nLTO_REFLECT_DYN=100\nMMIO_GUARD_DROP=7\nLTO_MMIO_SEQ=74\nLTO_ROOTS_TOTAL=400\n

struct MmioAuditGuard {
    reg_id: i32,
}

impl Drop for MmioAuditGuard {
    fn drop(self: mut_view<MmioAuditGuard>) {
        print("MMIO_GUARD_DROP=");
        print_int(self.reg_id);
        print("\n");
    }
}

// 1. Reachable internal functions from `main` (`AXS-LTO-005.1`, `AXS-LTO-010`)
pub fn internal_math_scale(x: i32) -> i32 {
    (x * 3) + 5
}

pub fn internal_pipeline_step(a: i32, b: i32) -> i32 {
    internal_math_scale(a) + internal_math_scale(b)
}

// 2. `@export` ABI boundary root (`AXS-LTO-004.2`, `AXS-LTO-005.1`, `REQ-OPT-264`, `ALTO-27`)
@export
pub fn exported_abi_entry(code: i32) -> i32 {
    (code * 4) + 12
}

// 3. FFI callback root with `address_taken_fn == true` (`AXS-LTO-005.1`, `REQ-OPT-266`, `ALTO-29`)
fn ffi_irq_callback(status: i32) -> i32 {
    (status & 255) + 10
}

fn invoke_registered_callback(cb: fn(i32) -> i32, raw_status: i32) -> i32 {
    cb(raw_status)
}

// 4. Reflection & dynamic symbol lookup roots (`AXS-LTO-005.1`, `REQ-OPT-265`, `ALTO-28`)
fn reflection_type_hook(tag: i32) -> i32 {
    (tag * 7) - 3
}

fn dynamic_plugin_entry(v: i32) -> i32 {
    v + 29
}

// 5. Hardware MMIO / Drop sequence barrier (`AXS-LTO-015.2..3`, `REQ-OPT-277..278`, `ALTO-40..41`)
fn run_mmio_sequence(seed: i32) -> i32 {
    let mut out_val: i32 = 0;
    {
        let g = MmioAuditGuard { reg_id: 7 };
        out_val = (seed * 2) + (g.reg_id * 2);
    }
    out_val
}

// 6. Unreferenced non-exported `pub` helpers eligible for closed-world internalization and dead stripping (`AXS-LTO-010`, `REQ-OPT-263`)
pub fn dead_unused_helper_alpha(x: i32) -> i32 {
    (x * 999) - 123
}

fn dead_unused_helper_beta(y: i32) -> i32 {
    y ^ 4095
}

fn main() -> i32 {
    print("LTO_ROOTS_BANNER=Closed_World_Reachability_And_Roots\n");

    let v_reach: i32 = internal_pipeline_step(10, 20);
    print("LTO_INTERNAL_REACH=");
    print_int(v_reach);
    print("\n");

    let v_exp: i32 = exported_abi_entry(15);
    print("LTO_EXPORT_ROOT=");
    print_int(v_exp);
    print("\n");

    let cb_ptr: fn(i32) -> i32 = ffi_irq_callback;
    let v_ffi: i32 = invoke_registered_callback(cb_ptr, 300);
    print("LTO_FFI_CALLBACK=");
    print_int(v_ffi);
    print("\n");

    let r_ref: fn(i32) -> i32 = reflection_type_hook;
    let r_dyn: fn(i32) -> i32 = dynamic_plugin_entry;
    let v_ref_dyn: i32 = r_ref(8) + r_dyn(18);
    print("LTO_REFLECT_DYN=");
    print_int(v_ref_dyn);
    print("\n");

    let v_mmio: i32 = run_mmio_sequence(30);
    print("LTO_MMIO_SEQ=");
    print_int(v_mmio);
    print("\n");

    let total: i32 = v_reach + v_exp + v_ffi + v_ref_dyn + v_mmio;
    print("LTO_ROOTS_TOTAL=");
    print_int(total);
    print("\n");

    if total != 400 {
        return 1;
    }
    0
}
