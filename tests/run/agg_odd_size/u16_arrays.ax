// test: run
// exit: 0
// stdout: 4369 1 2 3 8738\n4369 9 8 7 8738\n4369 9 8 7 8738\n10 20 30 200 201\n31 32 33 200 201\n
// T498a: a 6-byte [3]u16 field between/next to u16 and u8 fields; literal construction, a field store and a
// whole-field copy into a second struct keep every neighbouring field intact.

struct U3 { w: u16, x: [3]u16, z: u16 }
struct U3b { x: [3]u16, t: u8, u: u8 }

fn show(s: view<U3>) {
    print_int(s.w as i64);
    print(" ");
    print_int(s.x[0] as i64);
    print(" ");
    print_int(s.x[1] as i64);
    print(" ");
    print_int(s.x[2] as i64);
    print(" ");
    print_int(s.z as i64);
    print("\n");
}

fn showb(s: view<U3b>) {
    print_int(s.x[0] as i64);
    print(" ");
    print_int(s.x[1] as i64);
    print(" ");
    print_int(s.x[2] as i64);
    print(" ");
    print_int(s.t as i64);
    print(" ");
    print_int(s.u as i64);
    print("\n");
}

fn main() -> i32 {
    let mut a = U3 { w: 4369u16, x: [1u16, 2u16, 3u16], z: 8738u16 };
    show(view(a));
    a.x = [9u16, 8u16, 7u16];
    show(view(a));
    let mut c = U3 { w: 4369u16, x: [0u16; 3], z: 8738u16 };
    c.x = a.x;
    show(view(c));

    let mut b = U3b { x: [10u16, 20u16, 30u16], t: 200u8, u: 201u8 };
    showb(view(b));
    b.x = [31u16, 32u16, 33u16];
    showb(view(b));
    0
}
