// test: run
// exit: 0
// stdout: 1 2 3 9\n4 5 6 9\n11 12 13 | 21 22 23 | 31 32 33\n11 12 13 | 7 7 7 | 31 32 33\n100 200 300 | 400 500 600\n1 2 3 | 400 500 600\n
// T498a: odd-size aggregates as a tuple element and as elements of an array: writing one element (a 3-byte
// or 6-byte struct) must not overwrite the first bytes of the next element.

@derive(Copy)
struct R3 { x: [3]u8 }
@derive(Copy)
struct R6 { v: [3]u16 }

fn show_r3(a: [3]R3) {
    let mut i: usize = 0;
    while i < 3 {
        if i > 0 {
            print(" | ");
        }
        print_int(a[i].x[0] as i64);
        print(" ");
        print_int(a[i].x[1] as i64);
        print(" ");
        print_int(a[i].x[2] as i64);
        i = i + 1;
    }
    print("\n");
}

fn show_r6(a: [2]R6) {
    print_int(a[0].v[0] as i64);
    print(" ");
    print_int(a[0].v[1] as i64);
    print(" ");
    print_int(a[0].v[2] as i64);
    print(" | ");
    print_int(a[1].v[0] as i64);
    print(" ");
    print_int(a[1].v[1] as i64);
    print(" ");
    print_int(a[1].v[2] as i64);
    print("\n");
}

fn main() -> i32 {
    let mut t: ([3]u8, u8) = ([1u8, 2u8, 3u8], 9u8);
    print_int(t.0[0] as i64);
    print(" ");
    print_int(t.0[1] as i64);
    print(" ");
    print_int(t.0[2] as i64);
    print(" ");
    print_int(t.1 as i64);
    print("\n");
    t.0 = [4u8, 5u8, 6u8];
    print_int(t.0[0] as i64);
    print(" ");
    print_int(t.0[1] as i64);
    print(" ");
    print_int(t.0[2] as i64);
    print(" ");
    print_int(t.1 as i64);
    print("\n");

    let mut a = [R3 { x: [11u8, 12u8, 13u8] }, R3 { x: [21u8, 22u8, 23u8] }, R3 { x: [31u8, 32u8, 33u8] }];
    show_r3(a);
    a[1] = R3 { x: [7u8; 3] };
    show_r3(a);

    let mut b = [R6 { v: [100u16, 200u16, 300u16] }, R6 { v: [400u16, 500u16, 600u16] }];
    show_r6(b);
    b[0].v = [1u16, 2u16, 3u16];
    show_r6(b);
    0
}
