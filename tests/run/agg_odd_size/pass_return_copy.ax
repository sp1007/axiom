// test: run
// exit: 0
// stdout: 3 6 9 66\n4 8 12 77\n4 8 12 77\n4 8 12 77\n1 2 3 4 5 | 250 251\n50 2 3 4 5 | 250 251\n9 9 9 9 9 9 9 | 88\n9 9 9 9 9 9 9 | 88\n
// T498a: 3/5/7-byte aggregates passed by value (Win64: by reference), returned (hidden return pointer),
// assigned, copied twice and mutated through a mut_view; neighbouring fields printed after every step.

@derive(Copy)
struct P { x: [3]u16, k: u8 }
struct Q { a: [5]u8, s: u8, t: u8 }
@derive(Copy)
struct S7 { x: [7]u8, g: u8 }

fn scale(v: [3]u16, by: u16) -> [3]u16 {
    [v[0] * by, v[1] * by, v[2] * by]
}

fn make_p(base: u16, k: u8) -> P {
    P { x: [base, base * 2u16, base * 3u16], k: k }
}

fn show_p(p: P) {
    print_int(p.x[0] as i64);
    print(" ");
    print_int(p.x[1] as i64);
    print(" ");
    print_int(p.x[2] as i64);
    print(" ");
    print_int(p.k as i64);
    print("\n");
}

fn show_q(q: view<Q>) {
    let mut i: usize = 0;
    while i < 5 {
        if i > 0 {
            print(" ");
        }
        print_int(q.a[i] as i64);
        i = i + 1;
    }
    print(" | ");
    print_int(q.s as i64);
    print(" ");
    print_int(q.t as i64);
    print("\n");
}

fn poke(q: mut_view<Q>, v: u8) {
    let mut a = q.a;
    a[0] = v;
    q.a = a;
}

fn fill7(s: mut_view<S7>, a: [7]u8) {
    s.x = a;
}

fn show_s7(s: view<S7>) {
    let mut i: usize = 0;
    while i < 7 {
        print_int(s.x[i] as i64);
        print(" ");
        i = i + 1;
    }
    print("| ");
    print_int(s.g as i64);
    print("\n");
}

fn main() -> i32 {
    let p1 = make_p(3u16, 66u8);
    show_p(p1);
    let mut p2 = P { x: [0u16; 3], k: 77u8 };
    p2.x = scale(p1.x, 1u16);
    p2.x = scale([1u16, 2u16, 3u16], 4u16);
    show_p(p2);
    let p3 = p2;
    let p4 = p3;
    show_p(p3);
    show_p(p4);

    let mut q = Q { a: [1u8, 2u8, 3u8, 4u8, 5u8], s: 250u8, t: 251u8 };
    show_q(view(q));
    poke(mut_view(q), 50u8);
    show_q(view(q));

    let mut s = S7 { x: [0u8; 7], g: 88u8 };
    let src = [9u8; 7];
    fill7(mut_view(s), src);
    show_s7(view(s));
    let s2 = s;
    show_s7(view(s2));
    0
}
