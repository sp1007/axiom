// test: run
// exit: 0
// stdout: 17 1 2 3 34\n17 7 8 9 34\n5 6 7 8 9 4660\n1 1 1 1 1 4660\n171 1 2 3 4 5 6 7\n171 7 6 5 4 3 2 1\n
// T498a: [3]u8, [5]u8 and [7]u8 fields next to u8/u16 fields. Construction from a struct literal and a later
// field store must not write past the array: the canaries print every byte of the neighbouring fields.

struct A3 { a: u8, x: [3]u8, b: u8 }
struct A5 { x: [5]u8, t: u16 }
struct A7 { h: u8, x: [7]u8 }

fn show3(s: view<A3>) {
    print_int(s.a as i64);
    print(" ");
    print_int(s.x[0] as i64);
    print(" ");
    print_int(s.x[1] as i64);
    print(" ");
    print_int(s.x[2] as i64);
    print(" ");
    print_int(s.b as i64);
    print("\n");
}

fn show5(s: view<A5>) {
    let mut i: usize = 0;
    while i < 5 {
        print_int(s.x[i] as i64);
        print(" ");
        i = i + 1;
    }
    print_int(s.t as i64);
    print("\n");
}

fn show7(s: view<A7>) {
    print_int(s.h as i64);
    let mut i: usize = 0;
    while i < 7 {
        print(" ");
        print_int(s.x[i] as i64);
        i = i + 1;
    }
    print("\n");
}

fn main() -> i32 {
    let mut s3 = A3 { a: 17u8, x: [1u8, 2u8, 3u8], b: 34u8 };
    show3(view(s3));
    s3.x = [7u8, 8u8, 9u8];
    show3(view(s3));

    let mut s5 = A5 { x: [5u8, 6u8, 7u8, 8u8, 9u8], t: 4660u16 };
    show5(view(s5));
    s5.x = [1u8; 5];
    show5(view(s5));

    let mut s7 = A7 { h: 171u8, x: [1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8] };
    show7(view(s7));
    s7.x = [7u8, 6u8, 5u8, 4u8, 3u8, 2u8, 1u8];
    show7(view(s7));
    0
}
