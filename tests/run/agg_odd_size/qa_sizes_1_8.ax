// test: run
// exit: 0
// stdout: 161 10 178\n161 40 178\n161 70 178\n1 70 2\n70\n200 | 160 | 180 | \n161 10 11 178\n161 40 41 178\n161 70 71 178\n1 70 71 2\n281\n200 201 | 160 161 | 180 181 | \n161 10 11 12 178\n161 40 41 42 178\n161 70 71 72 178\n1 70 71 72 2\n915\n200 201 202 | 160 161 162 | 180 181 182 | \n161 10 11 12 13 178\n161 40 41 42 43 178\n161 70 71 72 73 178\n1 70 71 72 73 2\n2818\n200 201 202 203 | 160 161 162 163 | 180 181 182 183 | \n161 10 11 12 13 14 178\n161 40 41 42 43 44 178\n161 70 71 72 73 74 178\n1 70 71 72 73 74 2\n8528\n200 201 202 203 204 | 160 161 162 163 164 | 180 181 182 183 184 | \n161 10 11 12 13 14 15 178\n161 40 41 42 43 44 45 178\n161 70 71 72 73 74 75 178\n1 70 71 72 73 74 75 2\n25659\n200 201 202 203 204 205 | 160 161 162 163 164 165 | 180 181 182 183 184 185 | \n161 10 11 12 13 14 15 16 178\n161 40 41 42 43 44 45 46 178\n161 70 71 72 73 74 75 76 178\n1 70 71 72 73 74 75 76 2\n77053\n200 201 202 203 204 205 206 | 160 161 162 163 164 165 166 | 180 181 182 183 184 185 186 | \n161 10 11 12 13 14 15 16 17 178\n161 40 41 42 43 44 45 46 47 178\n161 70 71 72 73 74 75 76 77 178\n1 70 71 72 73 74 75 76 77 2\n231236\n200 201 202 203 204 205 206 207 | 160 161 162 163 164 165 166 167 | 180 181 182 183 184 185 186 187 | \n
// QA T498a (adversarial): [N]u8 for N = 1..8: literal, field store, mut_view store, copy, by-value arg, array element store (const and dynamic index), return of a struct.
// Every step prints every byte of the aggregate and of both neighbouring canary fields.

struct W1 { pre: u8, x: [1]u8, post: u8 }
@derive(Copy)
struct H1 { x: [1]u8 }
fn mk1(s: u8) -> [1]u8 { [(s + 0u8)] }
fn sum1(v: [1]u8) -> i64 {
    let mut t: i64 = 0;
    let mut i: usize = 0;
    while i < 1 { t = t * 3 + (v[i] as i64); i = i + 1; }
    t
}
fn set1(w: mut_view<W1>, s: u8) { w.x = mk1(s); }
fn show1(w: view<W1>) {
    print_int(w.pre as i64);
    let mut i: usize = 0;
    while i < 1 { print(" "); print_int(w.x[i] as i64); i = i + 1; }
    print(" ");
    print_int(w.post as i64);
    print("\n");
}
fn showh1(a: [3]H1) {
    let mut j: usize = 0;
    while j < 3 {
        let mut i: usize = 0;
        while i < 1 { print_int(a[j].x[i] as i64); print(" "); i = i + 1; }
        print("| ");
        j = j + 1;
    }
    print("\n");
}
fn ret_h1(s: u8) -> H1 { H1 { x: mk1(s) } }
fn run1(k: usize) {
    let mut w = W1 { pre: 161u8, x: mk1(10u8), post: 178u8 };
    show1(view(w));
    w.x = mk1(40u8);
    show1(view(w));
    set1(mut_view(w), 70u8);
    show1(view(w));
    let c = w.x;
    let d = c;
    let mut w2 = W1 { pre: 1u8, x: d, post: 2u8 };
    w2.x = mk1(90u8);
    w2.x = c;
    show1(view(w2));
    print_int(sum1(w2.x));
    print("\n");
    let mut arr = [H1 { x: mk1(100u8) }, H1 { x: mk1(120u8) }, H1 { x: mk1(140u8) }];
    arr[1] = H1 { x: mk1(160u8) };
    arr[2].x = mk1(180u8);
    arr[k] = ret_h1(200u8);
    showh1(arr);
}

