// test: run
// exit: 0
// stdout: -7 -1 -128 127 -9\n-2 -3 100 -100 -1 -6\n-1 -2 -3 -4 -5 -6 -128 -149\n-300 -1 -32768 32767 -5\n-3 -4 -5\n-124 -2340 -880 -20000 -11700 368576 5746740 8426508 -6240 9168\n-33 -39 -5 19000 -117 -27433\n
// QA T498a (adversarial): signed odd-size aggregates ([3]i8, [5]i8, [7]i8, [3]i16, (i8,i8,i8)) keep the
// sign of every loaded byte, and a loop with ten live accumulators copies 3- and 6-byte values under -O1
// register pressure (the partial-register load/store sequences must not clobber a live value).
struct S3 { lo: i8, a: [3]i8, hi: i8 }
struct S6 { h: i16, v: [3]i16, t: i8 }

fn mk3(x: i8, y: i8, z: i8) -> [3]i8 { [x, y, z] }
fn mk5() -> [5]i8 { [-2i8, -3i8, 100i8, -100i8, -1i8] }
fn mk7() -> [7]i8 { [-1i8, -2i8, -3i8, -4i8, -5i8, -6i8, -128i8] }
fn trip() -> (i8, i8, i8) { (-3i8, -4i8, -5i8) }

fn sum5(v: [5]i8) -> i64 {
    let mut t: i64 = 0;
    let mut i: usize = 0;
    while i < 5 { t = t + (v[i] as i64); i = i + 1; }
    t
}

fn show_arr7(v: [7]i8) {
    let mut t: i64 = 0;
    let mut i: usize = 0;
    while i < 7 { print_int(v[i] as i64); print(" "); t = t + (v[i] as i64); i = i + 1; }
    print_int(t);
    print("\n");
}

fn sp(v: i64) { print_int(v); print(" "); }

fn main() -> i32 {
    let mut s = S3 { lo: -7i8, a: [0i8; 3], hi: -9i8 };
    s.a = mk3(-1i8, -128i8, 127i8);
    sp(s.lo as i64); sp(s.a[0] as i64); sp(s.a[1] as i64); sp(s.a[2] as i64);
    print_int(s.hi as i64); print("\n");

    let f = mk5();
    let g = f;
    sp(g[0] as i64); sp(g[1] as i64); sp(g[2] as i64); sp(g[3] as i64); sp(g[4] as i64);
    print_int(sum5(g)); print("\n");
    show_arr7(mk7());

    let mut w = S6 { h: -300i16, v: [0i16; 3], t: -5i8 };
    w.v = [-1i16, -32768i16, 32767i16];
    sp(w.h as i64); sp(w.v[0] as i64); sp(w.v[1] as i64); sp(w.v[2] as i64);
    print_int(w.t as i64); print("\n");

    let (ta, tb, tc) = trip();
    sp(ta as i64); sp(tb as i64); print_int(tc as i64); print("\n");

    let mut a0: i64 = 0;
    let mut a1: i64 = 0;
    let mut a2: i64 = 0;
    let mut a3: i64 = 0;
    let mut a4: i64 = 0;
    let mut a5: i64 = 0;
    let mut a6: i64 = 0;
    let mut a7: i64 = 0;
    let mut a8: i64 = 0;
    let mut a9: i64 = 0;
    let mut p: [3]i8 = [0i8; 3];
    let mut q: [3]i16 = [0i16; 3];
    let mut i: i64 = 0;
    while i < 40 {
        p = [(i * 7 - 50) as i8, (0 - i) as i8, (i * 13) as i8];
        q = [(i * 1000 - 20000) as i16, (0 - i * 3) as i16, (i * 977) as i16];
        let c = p;
        let d = q;
        a0 = a0 + (c[0] as i64);
        a1 = a1 + (c[1] as i64) * 3;
        a2 = a2 + (c[2] as i64) - i;
        a3 = a3 + (d[0] as i64);
        a4 = a4 + (d[1] as i64) * 5;
        a5 = a5 + ((d[2] as i64) ^ i);
        a6 = a6 + (a0 - a3);
        a7 = a7 + (c[0] as i64) * (d[2] as i64);
        a8 = a8 + ((c[1] as i64) + (d[1] as i64)) * 2;
        a9 = a9 + a7 % 1000;
        i = i + 1;
    }
    sp(a0); sp(a1); sp(a2); sp(a3); sp(a4); sp(a5); sp(a6); sp(a7); sp(a8); print_int(a9); print("\n");
    sp(p[0] as i64); sp(p[1] as i64); sp(p[2] as i64); sp(q[0] as i64); sp(q[1] as i64); print_int(q[2] as i64);
    print("\n");
    0
}
