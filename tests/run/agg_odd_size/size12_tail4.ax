// test: run
// exit: 0
// stdout: 1 2 3 | 4 5\n7 7 7 | 4 5\n9 8 7 | 4 5\n
// T498a no-regression: a 12-byte aggregate (8 + 4 tail) is copied with the 8+4 decomposition; a [3]u32
// field next to two u16 fields keeps them intact on construction, a field store and a whole copy.

struct T12 { x: [3]u32, a: u16, b: u16 }

fn show(t: view<T12>) {
    print_int(t.x[0] as i64);
    print(" ");
    print_int(t.x[1] as i64);
    print(" ");
    print_int(t.x[2] as i64);
    print(" | ");
    print_int(t.a as i64);
    print(" ");
    print_int(t.b as i64);
    print("\n");
}

fn rev(x: [3]u32) -> [3]u32 {
    [x[2], x[1], x[0]]
}

fn main() -> i32 {
    let mut t = T12 { x: [1u32, 2u32, 3u32], a: 4u16, b: 5u16 };
    show(view(t));
    t.x = [7u32; 3];
    show(view(t));
    t.x = rev([7u32, 8u32, 9u32]);
    let u = t;
    show(view(u));
    0
}
