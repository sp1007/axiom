// QA T498a (adversarial): [N]u8 for N = 9..16 (multi-chunk tails 1..7): same operations as qa_sizes_1_8.
// Every step prints every byte of the aggregate and of both neighbouring canary fields.

struct W9 { pre: u8, x: [9]u8, post: u8 }
@derive(Copy)
struct H9 { x: [9]u8 }
fn mk9(s: u8) -> [9]u8 { [(s + 0u8), (s + 1u8), (s + 2u8), (s + 3u8), (s + 4u8), (s + 5u8), (s + 6u8), (s + 7u8), (s + 8u8)] }
fn sum9(v: [9]u8) -> i64 {
    let mut t: i64 = 0;
    let mut i: usize = 0;
    while i < 9 { t = t * 3 + (v[i] as i64); i = i + 1; }
    t
}
fn set9(w: mut_view<W9>, s: u8) { w.x = mk9(s); }
fn show9(w: view<W9>) {
    print_int(w.pre as i64);
    let mut i: usize = 0;
    while i < 9 { print(" "); print_int(w.x[i] as i64); i = i + 1; }
    print(" ");
    print_int(w.post as i64);
    print("\n");
}
fn showh9(a: [3]H9) {
    let mut j: usize = 0;
    while j < 3 {
        let mut i: usize = 0;
        while i < 9 { print_int(a[j].x[i] as i64); print(" "); i = i + 1; }
        print("| ");
        j = j + 1;
    }
    print("\n");
}
fn ret_h9(s: u8) -> H9 { H9 { x: mk9(s) } }
fn run9(k: usize) {
    let mut w = W9 { pre: 161u8, x: mk9(10u8), post: 178u8 };
    show9(view(w));
    w.x = mk9(40u8);
    show9(view(w));
    set9(mut_view(w), 70u8);
    show9(view(w));
    let c = w.x;
    let d = c;
    let mut w2 = W9 { pre: 1u8, x: d, post: 2u8 };
    w2.x = mk9(90u8);
    w2.x = c;
    show9(view(w2));
    print_int(sum9(w2.x));
    print("\n");
    let mut arr = [H9 { x: mk9(100u8) }, H9 { x: mk9(120u8) }, H9 { x: mk9(140u8) }];
    arr[1] = H9 { x: mk9(160u8) };
    arr[2].x = mk9(180u8);
    arr[k] = ret_h9(200u8);
    showh9(arr);
}

