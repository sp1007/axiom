// test: run
// exit: 0
// stdout: 4\n4 5 10 15\n
// T498a / FU-T498-AGG-WIDEN: `vals: [3]u16` is 6 bytes and laid out before `tag`; natively the array
// was stored with one widened 8-byte access after `tag` was stored and overwrote it (printed 0).

struct Rec { tag: u8, vals: [3]u16 }

fn main() -> i32 {
    let r = Rec { tag: 4u8, vals: [5u16, 10u16, 15u16] };
    print_int(r.tag as i64);
    print("\n");
    print_int(r.tag as i64);
    print(" ");
    print_int(r.vals[0] as i64);
    print(" ");
    print_int(r.vals[1] as i64);
    print(" ");
    print_int(r.vals[2] as i64);
    print("\n");
    0
}
