// test: run
// stdout: 4609434218613702656\n4621256167635550208\n4621256167635550208\n1077936128\n2\n4372995238176751616\n1036831949\n53\n7\n-1021\n4611686018427387904\n2147483647\n-128\n32\n4613937818241073152\n
// T458b (SPEC-41 AXS-FLT-004, AXS-FLT-010 §3): `f32` and `f64` are path heads exactly like the integer names --
// `f64.f(...)` reaches an inherent function and a trait function (static dispatch), `f64.NAME` / `f32.NAME` /
// `u8.NAME` / `i32.NAME` read inherent associated constants -- in the oracle and natively. Associated constants may
// read other constants (also before their definition). Built-in integer MIN / MAX / BITS keep working.
// Expected bits: Python `struct.pack('<d'/'<f', ...)` (independent oracle).

@intrinsic fn to_bits_f64(x: f64) -> u64 { 0u64 }
@intrinsic fn to_bits_f32(x: f32) -> u32 { 0u32 }

const ONE: f64 = 1.0;

impl f64 {
    pub const RADIX: u32 = 2u32;
    pub const EPS: f64 = ONE / 4503599627370496.0;
    pub const TWO: f64 = ONE + ONE;
    pub const MANT: u32 = 53u32;
    pub const MIN_EXP: i32 = -1021;

    pub fn half(x: f64) -> f64 {
        x * 0.5
    }
}

impl f32 {
    pub const TENTH: f32 = 0.1;

    pub fn from_int(v: i32) -> f32 {
        v as f32
    }
}

impl u8 {
    pub const SEVEN: u8 = 7u8;
}

impl i32 {
    pub const NEG: i32 = -128;
}

trait Make {
    fn make(v: i32) -> Self;
}

impl Make for f64 {
    fn make(v: i32) -> f64 {
        v as f64
    }
}

// Static dispatch through a type parameter instantiated with f64 (monomorphised to the `impl Make for f64` member).
fn build<T: Make>(v: i32) -> T {
    T.make(v)
}

fn pb(x: f64) {
    print_int(to_bits_f64(x) as i64);
    print("\n");
}

fn pn(v: i64) {
    print_int(v);
    print("\n");
}

fn main() -> i32 {
    pb(f64.half(3.0));
    pb(f64.make(9));
    let m: f64 = build<f64>(9);
    pb(m);
    pn(to_bits_f32(f32.from_int(3)) as i64);
    pn(f64.RADIX as i64);
    pb(f64.EPS);
    pn(to_bits_f32(f32.TENTH) as i64);
    pn(f64.MANT as i64);
    pn(u8.SEVEN as i64);
    pn(f64.MIN_EXP as i64);
    pb(f64.TWO);
    pn(i32.MAX as i64);
    pn(i32.NEG as i64);
    pn(i32.BITS as i64);
    // Associated constants as operands of run-time arithmetic.
    let x: f64 = f64.TWO + f64.half(2.0);
    pb(x);
    0
}
