// test: run
// stdout: 4607182418800017408\n-9223372036854775808\n4611686018427387904\n9218868437227405312\n-4620693217682128896\n1069547520\n2147483648\n3\n4598175219545276416\n7\n3223322624\n4609434218613702656\n1056964608\n2\n-9223372036854775808\n4602678819172646912\n
// T458b (SPEC-41 AXS-FLT-003 rule 4): float constant tables (`const T: [N]f64` indexed at run time), const structs
// and tuples with float fields, nested arrays of structs and a table built from other constants read the same bits
// in the oracle and natively. `-0.0` inside an aggregate is never zero-filled.
// Expected bits: Python `struct.pack('<d'/'<f', ...)` (independent oracle).
// (Enum constants with payload fields stay AX_TYPE_UNSUPPORTED_IN_BOOTSTRAP for every payload type,
// tests/ui/comptime/invalid_type_err.ax; floats change nothing there.)

@intrinsic fn to_bits_f64(x: f64) -> u64 { 0u64 }
@intrinsic fn to_bits_f32(x: f32) -> u32 { 0u32 }

const TABLE: [5]f64 = [1.0, -0.0, 2.0, 1.0 / 0.0, -0.5];
const TABLE32: [2]f32 = [1.5, -0.0];

struct Coeff {
    k: i32,
    c: f64,
    w: f32,
}

const TUP: (f64, i32, f32) = (0.25, 7, -2.5);
const CO: Coeff = Coeff { k: 3, c: 1.5, w: 0.5 };
const NESTED: [2]Coeff = [Coeff { k: 1, c: 0.5, w: 0.0 }, Coeff { k: 2, c: -0.0, w: 1.0 }];
const BASE: f64 = 1.5;
const DERIVED: [2]f64 = [BASE / 3.0, BASE * 2.0];

fn pb(x: f64) {
    print_int(to_bits_f64(x) as i64);
    print("\n");
}

fn pb32(x: f32) {
    print_int(to_bits_f32(x) as i64);
    print("\n");
}

fn main() -> i32 {
    let mut i: usize = 0;
    while i < 5 {
        pb(TABLE[i]);
        i = i + 1;
    }
    let mut j: usize = 0;
    while j < 2 {
        pb32(TABLE32[j]);
        j = j + 1;
    }
    print_int(CO.k as i64);
    print("\n");
    pb(TUP.0);
    print_int(TUP.1 as i64);
    print("\n");
    pb32(TUP.2);
    pb(CO.c);
    pb32(CO.w);
    let k: usize = 1;
    let n = NESTED[k];
    print_int(n.k as i64);
    print("\n");
    pb(n.c);
    let z: usize = k - 1;
    pb(DERIVED[z]);
    0
}
