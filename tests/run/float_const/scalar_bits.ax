// test: run
// stdout: 4609434218613702656\n-4613937818241073152\n0\n-9223372036854775808\n9218868437227405312\n-4503599627370496\nnan 1\n1\n4503599627370496\n9218868437227405311\n4591870180066957722\n1036831949\n2147483648\n1\n2139095039\n1065353217\n1065353217\n2139095040\nnan32 1\n
// T458b (SPEC-41 AXS-FLT-003 rule 4, AXS-FLT-002): scalar float `const` items keep their exact IEEE-754 bit pattern in
// the oracle and natively (-O0 / -O1). Expected bits computed by hand / Python `struct.pack` (independent oracle).
// `1.0 / 0.0`, `0.0 / 0.0` and `-0.0` are valid constants (no AX_CONST_DIV_ZERO / AX_CONST_OVERFLOW).

@intrinsic fn to_bits_f64(x: f64) -> u64 { 0u64 }
@intrinsic fn to_bits_f32(x: f32) -> u32 { 0u32 }

const P15: f64 = 1.5;
const N15: f64 = -1.5;
const PZ: f64 = 0.0;
const NZ: f64 = -0.0;
const PINF: f64 = 1.0 / 0.0;
const NINF: f64 = -1.0 / 0.0;
const QNAN: f64 = 0.0 / 0.0;
const MIN_SUB: f64 = 4.9e-324;
const MIN_NORM: f64 = 2.2250738585072014e-308;
const MAX64: f64 = 1.7976931348623157e308;
const TENTH: f64 = 0.1;

const TENTH32: f32 = 0.1;
const NZ32: f32 = -0.0;
const MIN_SUB32: f32 = 1.4e-45;
const MAX32: f32 = 3.4028234663852886e38;
// 1 + 2^-24 + 2^-60 (truncated): rounding through f64 lands on the f32 midpoint and ties to 1.0 (0x3F800000);
// rounded directly to f32 it is above the midpoint: 1 + 2^-23 (0x3F800001).
const DIRECT32: f32 = 1.000000059604644775390625086736;
const INF32: f32 = 1.0f32 / 0.0f32;
const NAN32: f32 = 0.0f32 / 0.0f32;

fn pb(x: f64) {
    print_int(to_bits_f64(x) as i64);
    print("\n");
}

fn pb32(x: f32) {
    print_int(to_bits_f32(x) as i64);
    print("\n");
}

fn main() -> i32 {
    pb(P15);
    pb(N15);
    pb(PZ);
    pb(NZ);
    pb(PINF);
    pb(NINF);
    // A NaN's sign/payload from arithmetic is not observable (SPEC-41 AXS-FLT-002): check NaN-ness only.
    print("nan ");
    print_int(if QNAN != QNAN { 1i64 } else { 0i64 });
    print("\n");
    pb(MIN_SUB);
    pb(MIN_NORM);
    pb(MAX64);
    pb(TENTH);
    pb32(TENTH32);
    pb32(NZ32);
    pb32(MIN_SUB32);
    pb32(MAX32);
    pb32(DIRECT32);
    let lit: f32 = 1.000000059604644775390625086736;
    pb32(lit);
    pb32(INF32);
    print("nan32 ");
    print_int(if NAN32 != NAN32 { 1i64 } else { 0i64 });
    print("\n");
    0
}
