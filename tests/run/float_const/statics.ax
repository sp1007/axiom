// test: run
// stdout: -9223372036854775808\n4609434218613702656\n2147483648\n-9223372036854775808\n4613937818241073152\n-9223372036854775808\n4612811918334230528\n4611686018427387904\n-9223372036854775808\n4607182418800017408\n1069547520\n4598175219545276416\n0\n-9223372036854775808\n4602678819172646912\n
// T458b (SPEC-41 AXS-FLT-003 rule 4): float `static` items of every storage class -- immutable (`.rdata`),
// `static mut` (`.data`), all-zero `static mut` (`.bss`) and `@thread_local static mut` -- scalar and aggregate,
// initialised from literals and from float constants. `-0.0` is never placed as zero-fill (its bits are
// 0x8000_0000_0000_0000). Expected bits: Python `struct.pack('<d'/'<f', ...)` (independent oracle).

@intrinsic fn to_bits_f64(x: f64) -> u64 { 0u64 }
@intrinsic fn to_bits_f32(x: f32) -> u32 { 0u32 }

const HALF: f64 = 0.5;

static NZ: f64 = -0.0;
static RO: f64 = 1.5;
static NZ32: f32 = -0.0;
static RO_TABLE: [2]f64 = [-0.0, HALF * 6.0];
static mut MUT_NZ: f64 = -0.0;
static mut MUT_V: f64 = 2.5;
static mut MUT_ZERO: [2]f64 = [0.0, 0.0];
static mut MUT_PAIR: (f64, f32) = (-0.0, 1.5);

@thread_local
static mut TLS_V: f64 = 0.25;

@thread_local
static mut TLS_ARR: [2]f64 = [0.0, -0.0];

fn pb(x: f64) {
    print_int(to_bits_f64(x) as i64);
    print("\n");
}

fn pb32(x: f32) {
    print_int(to_bits_f32(x) as i64);
    print("\n");
}

fn main() -> i32 {
    pb(NZ);
    pb(RO);
    pb32(NZ32);
    let mut i: usize = 0;
    while i < 2 {
        pb(RO_TABLE[i]);
        i = i + 1;
    }
    unsafe {
        pb(MUT_NZ);
        pb(MUT_V);
        MUT_V = MUT_V - HALF;
        pb(MUT_V);
        pb(MUT_PAIR.0);
        MUT_ZERO[1] = 1.0;
        pb(MUT_ZERO[1]);
        pb32(MUT_PAIR.1);
    }
    pb(TLS_V);
    pb(TLS_ARR[0]);
    pb(TLS_ARR[1]);
    TLS_ARR[0] = TLS_V * 2.0;
    pb(TLS_ARR[0]);
    0
}
