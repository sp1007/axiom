// test: run
// stdout: -9223372036854775808\n1266679808\n1\n2147483647\n0\n0\n255\n4617315517961601024\n1069547520\n4612811918334230528\n8\n16\n-9223372036854775808\n7\n
// QA (T458b gate) adversarial cases the engineer did not cover: negation of a constant (-0.0 from `-ZERO`),
// f32 strict rounding of a constant expression (16777216.0 + 1.0 stays 16777216.0 in f32), NaN-ness of a constant,
// saturating float -> int casts evaluated at compile time (SPEC-41 AXS-FLT-022), a const computed from a literal product, same-named
// associated constants on distinct primitive types (f32 vs f64, u8 vs u16), and a static initialised from a const
// computed through negation.
// Expected values: Python `struct.pack` (independent oracle).

@intrinsic fn to_bits_f64(x: f64) -> u64 { 0u64 }
@intrinsic fn to_bits_f32(x: f32) -> u32 { 0u32 }

const ZERO: f64 = 0.0;
const NEGZ: f64 = -ZERO;
const F24: f32 = 16777216.0;
const F24P1: f32 = F24 + 1.0;
const LOCAL: f64 = 2.5 * 2.0;
const NAN: f64 = 0.0 / 0.0;
const SAT: i32 = 1e20 as i32;
const NANI: i32 = NAN as i32;
const NEGU: u32 = (-42.0) as u32;
const BIG: u8 = 999.9 as u8;
static NEG_STATIC: f64 = -ZERO;

impl f32 {
    pub const K: f32 = 1.5;
}

impl f64 {
    pub const K: f64 = 2.5;
}

impl u8 {
    pub const W: u8 = 8u8;
}

impl u16 {
    pub const W: u16 = 16u16;
}

fn pn(v: i64) {
    print_int(v);
    print("\n");
}

fn main() -> i32 {
    pn(to_bits_f64(NEGZ) as i64);
    pn(to_bits_f32(F24P1) as i64);
    if NAN != NAN { pn(1); } else { pn(0); }
    pn(SAT as i64);
    pn(NANI as i64);
    pn(NEGU as i64);
    pn(BIG as i64);
    pn(to_bits_f64(LOCAL) as i64);
    pn(to_bits_f32(f32.K) as i64);
    pn(to_bits_f64(f64.K) as i64);
    pn(u8.W as i64);
    pn(u16.W as i64);
    pn(to_bits_f64(NEG_STATIC) as i64);
    pn(u8.W as i64 - 1);
    0
}
