// test: run
// stdout: 4613937818241073152\n9\n4612811918334230528\n4615063718147915776\n4609434218613702656\n4602678819172646912\n4611686018427387904\n4620130267728707584\n9218868437227405312\n4591870180174331904\n1050253722\n4615063718147915776\n4609434218613702656\n3\n4619004367821864960\n
// T458b (SPEC-41 AXS-FLT-003 rule 4, AXS-FLT-010, REQ-OWNER-007): float `const` initializers are evaluated by the
// oracle's strict soft-float: forward references between constants, arithmetic, casts (int <-> float, f32 -> f64),
// REQ-OWNER-007 promotion of unsuffixed integer literals and integer constants, overflow to infinity, an integer
// constant computed from float constants, and constants used as operands and call arguments.
// Expected bits: Python `struct.pack('<d'/'<f', ...)` (independent oracle).

@intrinsic fn to_bits_f64(x: f64) -> u64 { 0u64 }
@intrinsic fn to_bits_f32(x: f32) -> u32 { 0u32 }

// B reads A before A's definition: the value never depends on source order.
const B: f64 = A * 2.0;
const A: f64 = 1.5;
const N: i32 = (B * 3.0) as i32;
const PROMO: f64 = 2 + 0.5;
const SEVEN_HALF: f64 = (7 as f64) / 2.0;
const SCALED: f64 = 10 as f64 * 0.25 - 1.0;
const THIRD: f64 = A / 3.0;
const SUM: f64 = A + THIRD;
const CHAIN: f64 = 3.25 * 2.0 + 1.0;
const OVER: f64 = 1e300 * 1e10;
const TENTH32: f32 = 0.1;
const WIDE: f64 = TENTH32 as f64;
const S32: f32 = 0.1f32 + 0.2f32;
const K: i32 = 3;
const KP: f64 = K + 0.5;

fn pb(x: f64) {
    print_int(to_bits_f64(x) as i64);
    print("\n");
}

fn twice(x: f64) -> f64 {
    x * 2.0
}

fn main() -> i32 {
    pb(B);
    print_int(N as i64);
    print("\n");
    pb(PROMO);
    pb(SEVEN_HALF);
    pb(SCALED);
    pb(THIRD);
    pb(SUM);
    pb(CHAIN);
    pb(OVER);
    pb(WIDE);
    print_int(to_bits_f32(S32) as i64);
    print("\n");
    pb(KP);
    // Constants as operands (run-time arithmetic) and as call arguments.
    let mut x: f64 = 0.0;
    x = x + A;
    pb(x);
    let n: i32 = (x * 2.0) as i32;
    print_int(n as i64);
    print("\n");
    pb(twice(CHAIN - 1.0) - CHAIN + 1.0);
    0
}
