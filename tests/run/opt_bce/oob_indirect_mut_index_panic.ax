// test: run
// exit: 101

// Indirect `mut_view<usize>` mutation invalidates any prior dominating `i < len(s)` guard (`AXS-BCE-006` rule 2).
fn corrupt_index(p: mut_view<usize>) {
    *p = 99;
}

fn read_after_mut_view_clobber(s: view<[i32]>, start: usize) -> i32 {
    let mut i: usize = start;
    if i < len(s) {
        corrupt_index(mut_view(i));
        return s[i];
    }
    0
}

fn main() -> i32 {
    let arr: [4]i32 = [1, 2, 3, 4];
    let s: view<[i32]> = view(arr);
    let v: i32 = read_after_mut_view_clobber(s, 1);
    print_int(v);
    0
}
