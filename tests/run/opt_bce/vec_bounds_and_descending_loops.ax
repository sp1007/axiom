// test: run
// stdout: VEC_BANNER=Xin chào kiểm tra biên động\nVEC_SUM=165\nDESC_SUM=90\nCANON_CFG=150\nVEC_TOTAL=405\n

@intrinsic fn assert(c: bool) {}
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct Vec<T> {
    ptr: *mut T,
    len: usize,
    cap: usize,
}

fn sum_unmodified_vec(v: view<Vec<i32>>) -> i32 {
    let mut i: usize = 0;
    let mut acc: i32 = 0;
    while i < v.len {
        assert(i < v.len);
        let elem: i32 = unsafe { *(v.ptr + i) };
        acc = acc + elem;
        i = i + 1;
    }
    acc
}

fn descending_slice_weighted_sum(s: view<[i32]>) -> i32 {
    let mut k: usize = len(s);
    let mut acc: i32 = 0;
    while k > 0 {
        k = k - 1;
        acc = acc + s[k] * ((k as i32) + 1);
    }
    acc
}

fn multi_preheader_multi_latch_loop(s: view<[i32]>, start_mode: bool) -> i32 {
    let mut i: usize = 0;
    let mut acc: i32 = 0;
    if start_mode {
        acc = 10;
    } else {
        acc = 20;
    }
    while i < len(s) {
        let cur: i32 = s[i];
        if cur < 0 {
            break;
        }
        if (i & 1) == 0 {
            acc = acc + cur * 2;
            i = i + 1;
            continue;
        }
        acc = acc + cur * 3;
        i = i + 1;
    }
    acc + (i as i32)
}

fn main() -> i32 {
    print("VEC_BANNER=Xin chào kiểm tra biên động\n");

    let mut backing: [5]i32 = [11, 22, 33, 44, 55];
    let v = Vec<i32> {
        ptr: unsafe { address_of_mut(backing) as *mut i32 },
        len: 5,
        cap: 5,
    };
    let r1: i32 = sum_unmodified_vec(view(v));

    let desc_arr: [4]i32 = [3, 6, 9, 12];
    let r2: i32 = descending_slice_weighted_sum(view(desc_arr));

    let cfg_arr: [5]i32 = [4, 5, 6, 7, -1];
    let r3: i32 = multi_preheader_multi_latch_loop(view(cfg_arr), true) +
                  multi_preheader_multi_latch_loop(view(cfg_arr), false);
    let total: i32 = r1 + r2 + r3;

    print("VEC_SUM=");
    print_int(r1);
    print("\nDESC_SUM=");
    print_int(r2);
    print("\nCANON_CFG=");
    print_int(r3);
    print("\nVEC_TOTAL=");
    print_int(total);
    print("\n");
    0
}
