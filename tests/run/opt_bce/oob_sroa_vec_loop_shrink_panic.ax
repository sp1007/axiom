// test: run
// exit: 101

@intrinsic fn assert(c: bool) {}
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct Vec<T> {
    ptr: *mut T,
    len: usize,
    cap: usize,
}

// Regression for QA Round 0 Finding 1b: SROA-promoted `Vec<i32>` with `if shrink { v.len = 0; }`
// inside `while i < v.len` MUST NOT have `assert(i < v.len)` eliminated.
fn bug1b_sroa_vec_shrink_in_loop(mut v: Vec<i32>, shrink: bool) -> i32 {
    let mut i: usize = 0;
    let mut acc: i32 = 0;
    while i < v.len {
        if shrink {
            v.len = 0;
        }
        assert(i < v.len);
        acc = acc + unsafe { *(v.ptr + i) };
        i = i + 1;
    }
    acc
}

fn main() -> i32 {
    let mut backing: [4]i32 = [10, 20, 30, 40];
    let v = Vec<i32> {
        ptr: unsafe { address_of_mut(backing) as *mut i32 },
        len: 3,
        cap: 4,
    };
    let res: i32 = bug1b_sroa_vec_shrink_in_loop(v, true);
    print_int(res);
    0
}
