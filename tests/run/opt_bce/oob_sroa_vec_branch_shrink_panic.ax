// test: run
// exit: 101

@intrinsic fn assert(c: bool) {}
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct Vec<T> {
    ptr: *mut T,
    len: usize,
    cap: usize,
}

// Regression for QA Round 0 Finding 1a: SROA-promoted `Vec<i32>` with conditional `v.len = 0`
// between `if idx < v.len` and `assert(idx < v.len)` MUST NOT have its assert eliminated.
fn bug1a_sroa_vec_len_branch(mut v: Vec<i32>, idx: usize, c1: bool, c2: bool) -> i32 {
    if c1 {
        v.len = 4;
    }
    if idx < v.len {
        if c2 {
            v.len = 0;
        }
        assert(idx < v.len);
        return unsafe { *(v.ptr + idx) };
    }
    0
}

fn main() -> i32 {
    let mut backing: [4]i32 = [10, 20, 30, 40];
    let v = Vec<i32> {
        ptr: unsafe { address_of_mut(backing) as *mut i32 },
        len: 2,
        cap: 4,
    };
    let res: i32 = bug1a_sroa_vec_len_branch(v, 2, true, true);
    print_int(res);
    0
}
