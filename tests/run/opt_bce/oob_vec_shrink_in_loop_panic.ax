// test: run
// exit: 101

@intrinsic fn assert(c: bool) {}
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct Vec<T> {
    ptr: *mut T,
    len: usize,
    cap: usize,
}

fn vec_shrink_one(v: mut_view<Vec<i32>>) {
    if v.len > 0 {
        v.len = v.len - 1;
    }
}

// `vec_shrink_one` inside the loop mutates `v.len`, invalidating `saved_n = v.len` (`AXS-BCE-002` rule 3).
fn sum_with_shrinking_vec(v: mut_view<Vec<i32>>) -> i32 {
    let saved_n: usize = v.len;
    let mut i: usize = 0;
    let mut acc: i32 = 0;
    while i < saved_n {
        vec_shrink_one(mut_view(*v));
        assert(i < v.len);
        let elem: i32 = unsafe { *(v.ptr + i) };
        acc = acc + elem;
        i = i + 1;
    }
    acc
}

fn main() -> i32 {
    let mut backing: [4]i32 = [10, 20, 30, 40];
    let mut v = Vec<i32> {
        ptr: unsafe { address_of_mut(backing) as *mut i32 },
        len: 3,
        cap: 4,
    };
    let res: i32 = sum_with_shrinking_vec(mut_view(v));
    print_int(res);
    0
}
