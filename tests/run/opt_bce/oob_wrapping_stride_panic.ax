// test: run
// exit: 101

@intrinsic fn wrapping_add_usize(a: usize, b: usize) -> usize { 0 }

// Wrapping induction step (`ARITH_WRAPPING`) is NOT proven non-wrapping: `i` jumps to 5
// inside the loop body before the next header check (`AXS-LOOP-006`, `AXS-BCE-004`).
fn sum_with_wrapping_jump(s: view<[i32]>, stride: usize) -> i32 {
    let mut i: usize = 0;
    let mut acc: i32 = 0;
    while i < len(s) {
        let jumped: usize = wrapping_add_usize(i, stride);
        acc = acc + s[jumped];
        i = wrapping_add_usize(i, 1);
    }
    acc
}

fn main() -> i32 {
    let arr: [4]i32 = [5, 6, 7, 8];
    let s: view<[i32]> = view(arr);
    let v: i32 = sum_with_wrapping_jump(s, 5);
    print_int(v);
    0
}
