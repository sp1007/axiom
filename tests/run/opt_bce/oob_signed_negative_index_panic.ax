// test: run
// exit: 101

// Signed index `i < 4` WITHOUT `i >= 0` MUST retain bounds check because `-1 as usize`
// wraps to `usize::MAX` (`AXS-BCE-003` rule 3, `REQ-OPT-140`).
fn read_signed_without_lower_guard(arr: view<[4]i32>, i: i64) -> i32 {
    if i < 4i64 {
        return (*arr)[i as usize];
    }
    0
}

fn main() -> i32 {
    let arr: [4]i32 = [11, 22, 33, 44];
    let neg_i: i64 = -1i64;
    let v: i32 = read_signed_without_lower_guard(view(arr), neg_i);
    print_int(v);
    0
}
