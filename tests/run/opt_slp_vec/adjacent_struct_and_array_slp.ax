// test: run
// stdout: SLP_BANNER=Xin chào vector hóa khối cơ bản SLP\nDROP_GUARD=91\nVEC2=54\nVEC4=340\nARR8=780\nCOMMUTE4=220\n

struct SlpGuard {
    id: i32,
}

impl Drop for SlpGuard {
    fn drop(self: mut_view<SlpGuard>) {
        print("DROP_GUARD=");
        print_int(self.id);
        print("\n");
    }
}

@derive(Copy)
struct Vec2i {
    x: i32,
    y: i32,
}

@derive(Copy)
struct Vec4i {
    x: i32,
    y: i32,
    z: i32,
    w: i32,
}

fn kernel_vec2_slp(a: view<Vec2i>, b: view<Vec2i>) -> i32 {
    let mut out = Vec2i { x: 0, y: 0 };
    out.x = a.x * 2 + b.x;
    out.y = a.y * 2 + b.y;
    out.x + out.y
}

fn kernel_vec4_slp(a: view<Vec4i>, b: view<Vec4i>, scale: i32) -> i32 {
    let mut out = Vec4i { x: 0, y: 0, z: 0, w: 0 };
    out.w = a.w * scale + b.w;
    out.z = a.z * scale + b.z;
    out.y = a.y * scale + b.y;
    out.x = a.x * scale + b.x;
    out.x + out.y + out.z + out.w
}

fn kernel_arr8_slp(dst: mut_view<[i32]>, a: view<[i32]>, b: view<[i32]>) -> i32 {
    dst[0] = a[0] * 2 + b[0];
    dst[1] = a[1] * 2 + b[1];
    dst[2] = a[2] * 2 + b[2];
    dst[3] = a[3] * 2 + b[3];
    dst[4] = a[4] * 2 + b[4];
    dst[5] = a[5] * 2 + b[5];
    dst[6] = a[6] * 2 + b[6];
    dst[7] = a[7] * 2 + b[7];
    dst[0] + dst[1] + dst[2] + dst[3] + dst[4] + dst[5] + dst[6] + dst[7]
}

fn kernel_commute4_slp(a: view<Vec4i>, b: view<Vec4i>) -> i32 {
    let mut out = Vec4i { x: 0, y: 0, z: 0, w: 0 };
    out.x = a.x + b.x;
    out.y = b.y + a.y;
    out.z = a.z + b.z;
    out.w = b.w + a.w;
    out.x + out.y + out.z + out.w
}

fn run_slp_suite() -> [4]i32 {
    let g = SlpGuard { id: 91 };
    let v2a = Vec2i { x: 10, y: 10 };
    let v2b = Vec2i { x: 3, y: 11 };
    let r2: i32 = kernel_vec2_slp(view(v2a), view(v2b));

    let v4a = Vec4i { x: 10, y: 20, z: 30, w: 40 };
    let v4b = Vec4i { x: 10, y: 20, z: 30, w: -20 };
    let r4: i32 = kernel_vec4_slp(view(v4a), view(v4b), 3);

    let a8: [8]i32 = [10, 20, 30, 40, 50, 60, 70, 80];
    let b8: [8]i32 = [5, 10, 15, 20, 25, 30, 35, -80];
    let mut dst8: [8]i32 = [0; 8];
    let r8: i32 = kernel_arr8_slp(mut_view(dst8), view(a8), view(b8));

    let ca = Vec4i { x: 15, y: 25, z: 35, w: 45 };
    let cb = Vec4i { x: 5, y: 15, z: 25, w: 55 };
    let rc: i32 = kernel_commute4_slp(view(ca), view(cb));
    let _ = g.id;
    [r2, r4, r8, rc]
}

fn main() -> i32 {
    print("SLP_BANNER=Xin chào vector hóa khối cơ bản SLP\n");
    let res: [4]i32 = run_slp_suite();
    print("VEC2=");
    print_int(res[0]);
    print("\nVEC4=");
    print_int(res[1]);
    print("\nARR8=");
    print_int(res[2]);
    print("\nCOMMUTE4=");
    print_int(res[3]);
    print("\n");
    0
}
