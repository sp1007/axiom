// test: run
// stdout: SCATTER_GATHER=173\nALIAS_INTERLEAVE=88\nDEP_CHAIN=195\n

@derive(Copy)
struct Vec4i {
    x: i32,
    y: i32,
    z: i32,
    w: i32,
}

fn kernel_scatter_gather(src: view<[i32]>) -> i32 {
    let mut out = Vec4i { x: 0, y: 0, z: 0, w: 0 };
    out.x = src[7] + 2;
    out.y = src[2] - 3;
    out.z = src[5] / 2;
    out.w = src[1] - 2;
    out.x + out.y + out.z + out.w
}

fn kernel_alias_interleave(buf: mut_view<[i32]>) -> i32 {
    buf[0] = buf[0] + 5;
    buf[1] = buf[0] + 7;
    buf[2] = buf[1] + 3;
    buf[3] = buf[2] + 1;
    buf[0] + buf[1] + buf[2] + buf[3]
}

fn kernel_dep_chain(seed: i32) -> i32 {
    let mut out = Vec4i { x: 0, y: 0, z: 0, w: 0 };
    let t0: i32 = seed;
    let t1: i32 = t0 * 2;
    let t2: i32 = t1 + 25;
    let t3: i32 = t2 + 40;
    out.x = t0;
    out.y = t1;
    out.z = t2;
    out.w = t3;
    out.x + out.y + out.z + out.w
}

fn main() -> i32 {
    let src: [8]i32 = [11, 22, 33, 44, 55, 66, 77, 88];
    let sg: i32 = kernel_scatter_gather(view(src));

    let mut buf: [4]i32 = [10, 20, 30, 40];
    let al: i32 = kernel_alias_interleave(mut_view(buf));

    let dc: i32 = kernel_dep_chain(15);

    print("SCATTER_GATHER=");
    print_int(sg);
    print("\nALIAS_INTERLEAVE=");
    print_int(al);
    print("\nDEP_CHAIN=");
    print_int(dc);
    print("\n");
    0
}
