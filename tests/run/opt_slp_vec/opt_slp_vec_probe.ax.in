@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }

struct ProbeTypes {
    thir: *mut Thir,
    ty_i32: u32,
    ty_usize: u32,
    ty_bool: u32,
    ty_f64: u32,
    ty_view_i32: u32,
    ty_mut_view_i32: u32,
    ty_ptr_i32: u32,
    ty_arr16_i32: u32,
    ty_arr16_f64: u32,
    ty_vec4_i32: u32,
}

fn probe_set_ty_slot(types_arr: *mut *mut AxType, idx: usize, ptr: *mut AxType) {
    let slot = ((types_arr as usize) + mir_mul_usize(idx, size_of<*mut AxType>())) as *mut *mut AxType;
    unsafe { *slot = ptr; }
}

fn pb_init_types(arena: mut_view<Arena>) -> ProbeTypes {
    let thir_ptr = arena_alloc_raw(mut_view(*arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    let types_arr = arena_alloc_raw(mut_view(*arena), mir_mul_usize(32, size_of<*mut AxType>()), align_of<*mut AxType>()) as *mut *mut AxType;
    let pool = arena_alloc_raw(mut_view(*arena), mir_mul_usize(28, size_of<AxType>()), align_of<AxType>());
    let ty_sz = size_of<AxType>();

    let mut k: usize = 0;
    while k < 16 {
        let tp = ((pool as usize) + mir_mul_usize(k, ty_sz)) as *mut AxType;
        let tk: u8 = if k < 9 { k as u8 }
            else if k == 9 { TY_ISIZE }
            else if k == 10 { TY_U8 }
            else if k == 11 { TY_U16 }
            else if k == 12 { TY_U32 }
            else if k == 13 { TY_U64 }
            else if k == 14 { TY_USIZE }
            else { TY_STR };
        unsafe { ax_type_reset(mut_view(*tp), tk); }
        probe_set_ty_slot(types_arr, k, tp);
        k = k + 1;
    }

    let mut c: usize = 16;
    while c < 26 {
        let cp = ((pool as usize) + mir_mul_usize(c, ty_sz)) as *mut AxType;
        unsafe { ax_type_reset(mut_view(*cp), 0u8); }
        probe_set_ty_slot(types_arr, c, cp);
        c = c + 1;
    }

    let t17 = ((pool as usize) + mir_mul_usize(16, ty_sz)) as *mut AxType;
    let t18 = ((pool as usize) + mir_mul_usize(17, ty_sz)) as *mut AxType;
    let t19 = ((pool as usize) + mir_mul_usize(18, ty_sz)) as *mut AxType;
    let t20 = ((pool as usize) + mir_mul_usize(19, ty_sz)) as *mut AxType;
    let t21 = ((pool as usize) + mir_mul_usize(20, ty_sz)) as *mut AxType;
    let t22 = ((pool as usize) + mir_mul_usize(21, ty_sz)) as *mut AxType;
    let t23 = ((pool as usize) + mir_mul_usize(22, ty_sz)) as *mut AxType;
    let t24 = ((pool as usize) + mir_mul_usize(23, ty_sz)) as *mut AxType;
    let scratch_ty = ((pool as usize) + mir_mul_usize(24, ty_sz)) as *mut AxType;
    let vec4_flds = arena_alloc_raw(mut_view(*arena), mir_mul_usize(4, size_of<TypeId>()), align_of<TypeId>()) as *mut TypeId;

    unsafe {
        ax_type_reset(mut_view(*scratch_ty), 0u8);

        (*t17).kind = TY_VIEW;
        (*t17).pointee = TypeId { v: 23u32 };

        (*t18).kind = TY_MUT_VIEW;
        (*t18).is_mut = true;
        (*t18).pointee = TypeId { v: 23u32 };

        (*t19).kind = TY_PTR;
        (*t19).is_mut = true;
        (*t19).pointee = TypeId { v: 20u32 };

        (*t20).kind = TY_ARRAY;
        (*t20).elem = TypeId { v: 8u32 };
        (*t20).array_len = 16u64;

        (*t21).kind = VEC_TY_F64;

        (*t22).kind = TY_ARRAY;
        (*t22).elem = TypeId { v: 21u32 };
        (*t22).array_len = 16u64;

        (*t23).kind = TY_SLICE;
        (*t23).elem = TypeId { v: 8u32 };

        *(((vec4_flds as usize) + 0 * size_of<TypeId>()) as *mut TypeId) = TypeId { v: 8u32 };
        *(((vec4_flds as usize) + 1 * size_of<TypeId>()) as *mut TypeId) = TypeId { v: 8u32 };
        *(((vec4_flds as usize) + 2 * size_of<TypeId>()) as *mut TypeId) = TypeId { v: 8u32 };
        *(((vec4_flds as usize) + 3 * size_of<TypeId>()) as *mut TypeId) = TypeId { v: 8u32 };
        (*t24).kind = TY_STRUCT;
        (*t24).fields = vec4_flds;
        (*t24).field_count = 4;

        (*thir_ptr).interner.arena = arena_new();
        (*thir_ptr).interner.map.keys = 0 as *mut *mut AxType;
        (*thir_ptr).interner.map.vals = 0 as *mut TypeId;
        (*thir_ptr).interner.map.states = 0 as *mut u8;
        (*thir_ptr).interner.map.len = 0;
        (*thir_ptr).interner.map.cap = 0;
        (*thir_ptr).interner.types = types_arr;
        (*thir_ptr).interner.len = 24;
        (*thir_ptr).interner.cap = 32;
        (*thir_ptr).interner.next_int_var = 1u32;
        (*thir_ptr).interner.scratch = scratch_ty;
        (*thir_ptr).interner.t_error.v = 1u32;
        (*thir_ptr).interner.t_unit.v = 2u32;
        (*thir_ptr).interner.t_never.v = 3u32;
        (*thir_ptr).interner.t_bool.v = 4u32;
        (*thir_ptr).interner.t_char.v = 5u32;
        (*thir_ptr).interner.t_i8.v = 6u32;
        (*thir_ptr).interner.t_i16.v = 7u32;
        (*thir_ptr).interner.t_i32.v = 8u32;
        (*thir_ptr).interner.t_i64.v = 9u32;
        (*thir_ptr).interner.t_isize.v = 10u32;
        (*thir_ptr).interner.t_u8.v = 11u32;
        (*thir_ptr).interner.t_u16.v = 12u32;
        (*thir_ptr).interner.t_u32.v = 13u32;
        (*thir_ptr).interner.t_u64.v = 14u32;
        (*thir_ptr).interner.t_usize.v = 15u32;
        (*thir_ptr).interner.t_str.v = 16u32;
        (*thir_ptr).interner.t_i128.v = 0x3FFF0128u32;
        (*thir_ptr).interner.t_u128.v = 0x3FFF0129u32;
        (*thir_ptr).item_types.keys = 0 as *mut usize;
        (*thir_ptr).item_types.vals = 0 as *mut TypeId;
        (*thir_ptr).item_types.states = 0 as *mut u8;
        (*thir_ptr).item_types.len = 0;
        (*thir_ptr).item_types.cap = 0;
        (*thir_ptr).expr_types.keys = 0 as *mut usize;
        (*thir_ptr).expr_types.vals = 0 as *mut TypeId;
        (*thir_ptr).expr_types.states = 0 as *mut u8;
        (*thir_ptr).expr_types.len = 0;
        (*thir_ptr).expr_types.cap = 0;
    }

    ProbeTypes {
        thir: thir_ptr,
        ty_i32: 8u32,
        ty_usize: 15u32,
        ty_bool: 4u32,
        ty_f64: 21u32,
        ty_view_i32: 17u32,
        ty_mut_view_i32: 18u32,
        ty_ptr_i32: 19u32,
        ty_arr16_i32: 20u32,
        ty_arr16_f64: 22u32,
        ty_vec4_i32: 24u32,
    }
}

fn pb_span() -> Span {
    Span { file: FileId { v: 1u32 }, start: 1u32, end: 10u32 }
}

fn pb_new_mir_body(arena: mut_view<Arena>, ret_ty: u32, arg_count: usize) -> *mut MirBody {
    let mb = arena_alloc_raw(mut_view(*arena), size_of<MirBody>(), align_of<MirBody>()) as *mut MirBody;
    unsafe {
        mir_body_reset(mut_view(*mb));
        (*mb).arg_count = arg_count;
    }
    let sp = pb_span();
    let _ = unsafe { mir_add_local(mut_view(*mb), mut_view(*arena), TypeId { v: ret_ty }, 0u8, true, StrId { v: 0u32 }, view(sp)) };
    mb
}

fn pb_add_local(mb: mut_view<MirBody>, arena: mut_view<Arena>, ty: u32, is_arg: bool) -> u32 {
    let sp = pb_span();
    let kind: u8 = if is_arg { MIR_LOCAL_ARG } else { 0u8 };
    mir_add_local(mut_view(*mb), mut_view(*arena), TypeId { v: ty }, kind, true, StrId { v: 0u32 }, view(sp)).v
}

fn pb_add_bb(mb: mut_view<MirBody>, arena: mut_view<Arena>) -> u32 {
    mir_add_bb(mut_view(*mb), mut_view(*arena), false).v
}

fn pb_op_const(ty: u32, val: u64) -> MirOperand {
    mir_op_const_int(ty, val)
}

fn pb_op_copy(loc: u32) -> MirOperand {
    mir_op_copy_local(loc)
}

fn pb_place_field(arena: mut_view<Arena>, base: u32, field_idx: u32) -> MirPlace {
    let parr = arena_alloc_raw(mut_view(*arena), size_of<MirProjection>(), align_of<MirProjection>()) as *mut MirProjection;
    let p0 = unsafe { mir_proj_at(parr, 0) };
    unsafe {
        mir_proj_reset(mut_view(*p0), MIR_PROJ_FIELD);
        (*p0).field_idx = field_idx;
    }
    let mut pl = mir_local_place(base);
    pl.projs = parr;
    pl.proj_count = 1;
    pl
}

fn pb_place_index(arena: mut_view<Arena>, base: u32, idx_loc: u32) -> MirPlace {
    let parr = arena_alloc_raw(mut_view(*arena), size_of<MirProjection>(), align_of<MirProjection>()) as *mut MirProjection;
    let p0 = unsafe { mir_proj_at(parr, 0) };
    unsafe {
        mir_proj_reset(mut_view(*p0), MIR_PROJ_INDEX);
        (*p0).index_local = MirLocalId { v: idx_loc };
    }
    let mut pl = mir_local_place(base);
    pl.projs = parr;
    pl.proj_count = 1;
    pl
}

fn pb_place_deref_index(arena: mut_view<Arena>, base: u32, idx_loc: u32) -> MirPlace {
    let parr = arena_alloc_raw(mut_view(*arena), mir_mul_usize(2, size_of<MirProjection>()), align_of<MirProjection>()) as *mut MirProjection;
    let p0 = unsafe { mir_proj_at(parr, 0) };
    let p1 = unsafe { mir_proj_at(parr, 1) };
    unsafe {
        mir_proj_reset(mut_view(*p0), MIR_PROJ_DEREF);
        mir_proj_reset(mut_view(*p1), MIR_PROJ_INDEX);
        (*p1).index_local = MirLocalId { v: idx_loc };
    }
    let mut pl = mir_local_place(base);
    pl.projs = parr;
    pl.proj_count = 2;
    pl
}

fn pb_blank_stmt(arena: mut_view<Arena>) -> MirStmt {
    let mut st: MirStmt = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt) };
    mir_stmt_zero(mut_view(st), MIR_STMT_ASSIGN);
    st.span = pb_span();
    st.location = pb_span();
    st
}

fn pb_push_const(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, dst: u32, ty: u32, val: u64) {
    let mut st = pb_blank_stmt(mut_view(*arena));
    st.place = mir_local_place(dst);
    mir_rvalue_reset(mut_view(st.rvalue), MIR_RVALUE_USE);
    st.rvalue.use_op = pb_op_const(ty, val);
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    mir_bb_push_stmt(unsafe { mut_view(*bptr) }, mut_view(*arena), view(st));
}

fn pb_push_binop(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, dst: u32, op: u8, lhs: MirOperand, rhs: MirOperand) {
    let mut st = pb_blank_stmt(mut_view(*arena));
    st.place = mir_local_place(dst);
    mir_rvalue_reset(mut_view(st.rvalue), MIR_RVALUE_BINARY_OP);
    st.rvalue.bin_op = op;
    st.rvalue.lhs = lhs;
    st.rvalue.rhs = rhs;
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    mir_bb_push_stmt(unsafe { mut_view(*bptr) }, mut_view(*arena), view(st));
}

fn pb_push_checked_binop(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, dst: u32, op: u8, lhs: MirOperand, rhs: MirOperand) {
    let mut st = pb_blank_stmt(mut_view(*arena));
    st.place = mir_local_place(dst);
    mir_rvalue_reset(mut_view(st.rvalue), MIR_RVALUE_OVERFLOWS_BINARY_OP);
    st.rvalue.bin_op = op;
    st.rvalue.lhs = lhs;
    st.rvalue.rhs = rhs;
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    mir_bb_push_stmt(unsafe { mut_view(*bptr) }, mut_view(*arena), view(st));
}

fn pb_push_load_field(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, dst: u32, base: u32, field_idx: u32) {
    let mut st = pb_blank_stmt(mut_view(*arena));
    st.place = mir_local_place(dst);
    mir_rvalue_reset(mut_view(st.rvalue), MIR_RVALUE_USE);
    st.rvalue.use_op.kind = MIR_OP_COPY;
    st.rvalue.use_op.place = pb_place_field(mut_view(*arena), base, field_idx);
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    mir_bb_push_stmt(unsafe { mut_view(*bptr) }, mut_view(*arena), view(st));
}

fn pb_push_store_field(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, base: u32, field_idx: u32, src_op: MirOperand) {
    let mut st = pb_blank_stmt(mut_view(*arena));
    st.place = pb_place_field(mut_view(*arena), base, field_idx);
    mir_rvalue_reset(mut_view(st.rvalue), MIR_RVALUE_USE);
    st.rvalue.use_op = src_op;
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    mir_bb_push_stmt(unsafe { mut_view(*bptr) }, mut_view(*arena), view(st));
}

fn pb_push_load_idx(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, dst: u32, base: u32, idx_loc: u32) {
    let mut st = pb_blank_stmt(mut_view(*arena));
    st.place = mir_local_place(dst);
    mir_rvalue_reset(mut_view(st.rvalue), MIR_RVALUE_USE);
    st.rvalue.use_op.kind = MIR_OP_COPY;
    st.rvalue.use_op.place = pb_place_index(mut_view(*arena), base, idx_loc);
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    mir_bb_push_stmt(unsafe { mut_view(*bptr) }, mut_view(*arena), view(st));
}

fn pb_push_store_idx(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, base: u32, idx_loc: u32, src_op: MirOperand) {
    let mut st = pb_blank_stmt(mut_view(*arena));
    st.place = pb_place_index(mut_view(*arena), base, idx_loc);
    mir_rvalue_reset(mut_view(st.rvalue), MIR_RVALUE_USE);
    st.rvalue.use_op = src_op;
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    mir_bb_push_stmt(unsafe { mut_view(*bptr) }, mut_view(*arena), view(st));
}

fn pb_push_load_deref_idx(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, dst: u32, base: u32, idx_loc: u32) {
    let mut st = pb_blank_stmt(mut_view(*arena));
    st.place = mir_local_place(dst);
    mir_rvalue_reset(mut_view(st.rvalue), MIR_RVALUE_USE);
    st.rvalue.use_op.kind = MIR_OP_COPY;
    st.rvalue.use_op.place = pb_place_deref_index(mut_view(*arena), base, idx_loc);
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    mir_bb_push_stmt(unsafe { mut_view(*bptr) }, mut_view(*arena), view(st));
}

fn pb_push_store_deref_idx(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, base: u32, idx_loc: u32, src_op: MirOperand) {
    let mut st = pb_blank_stmt(mut_view(*arena));
    st.place = pb_place_deref_index(mut_view(*arena), base, idx_loc);
    mir_rvalue_reset(mut_view(st.rvalue), MIR_RVALUE_USE);
    st.rvalue.use_op = src_op;
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    mir_bb_push_stmt(unsafe { mut_view(*bptr) }, mut_view(*arena), view(st));
}

fn pb_set_return(mb: mut_view<MirBody>, bb: u32) {
    let sp = pb_span();
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    unsafe {
        mir_term_reset(mut_view((*bptr).terminator), MIR_TERM_RETURN, view(sp));
        (*bptr).has_terminator = true;
    }
}

fn pb_init_pm(arena: mut_view<Arena>, obody: mut_view<OptBody>, profile: u8, verify_each: bool) -> *mut PassManager {
    let pm = arena_alloc_raw(mut_view(*arena), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
    let budget = opt_budget_for_profile(profile, verify_each);
    passmgr_init(unsafe { mut_view(*pm) }, budget, mut_view(*arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm) }, mut_view(*obody), mut_view(*arena));
    pm
}

fn pb_new_sink(arena: mut_view<Arena>) -> *mut DiagSink {
    let sink_ptr = arena_alloc_raw(mut_view(*arena), size_of<DiagSink>(), align_of<DiagSink>()) as *mut DiagSink;
    unsafe { diag_sink_init(mut_view(*sink_ptr)); }
    sink_ptr
}

fn pb_build_opt_body(mb: view<MirBody>, pt: view<ProbeTypes>, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> *mut OptBody {
    let dummy_fn = arena_alloc_raw(mut_view(*arena), size_of<HirItem>(), align_of<HirItem>()) as *mut u8;
    let mut z: usize = 0;
    while z < size_of<HirItem>() {
        unsafe { *(((dummy_fn as usize) + z) as *mut u8) = 0u8; }
        z = z + 1;
    }
    optir_build_from_mir(mb, pt.thir, mut_view(*arena), mut_view(*sink), dummy_fn as *const HirItem)
}

fn run_case1_struct_and_array_adjacent_slp(pt: view<ProbeTypes>) -> bool {
    let mut arena = arena_with_chunk_size(4194304);
    let sink = pb_new_sink(mut_view(arena));

    // 1A: 4-lane struct field SLP (`out.w, out.z, out.y, out.x` sorted + commutative swap on lane 1)
    let mb = pb_new_mir_body(mut_view(arena), pt.ty_i32, 3);
    let a_loc = pb_add_local(unsafe { mut_view(*mb) }, mut_view(arena), pt.ty_vec4_i32, true);
    let b_loc = pb_add_local(unsafe { mut_view(*mb) }, mut_view(arena), pt.ty_vec4_i32, true);
    let out_loc = pb_add_local(unsafe { mut_view(*mb) }, mut_view(arena), pt.ty_vec4_i32, true);
    let bb0 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(arena));

    let mut f: u32 = 0u32;
    let mut sum_locs: [4]u32 = [0u32, 0u32, 0u32, 0u32];
    while f < 4u32 {
        let la = pb_add_local(unsafe { mut_view(*mb) }, mut_view(arena), pt.ty_i32, false);
        let lb = pb_add_local(unsafe { mut_view(*mb) }, mut_view(arena), pt.ty_i32, false);
        let ls = pb_add_local(unsafe { mut_view(*mb) }, mut_view(arena), pt.ty_i32, false);
        pb_push_load_field(unsafe { mut_view(*mb) }, mut_view(arena), bb0, la, a_loc, f);
        pb_push_load_field(unsafe { mut_view(*mb) }, mut_view(arena), bb0, lb, b_loc, f);
        if f == 1u32 {
            // Commutative swap on lane 1: b.y + a.y
            pb_push_binop(unsafe { mut_view(*mb) }, mut_view(arena), bb0, ls, MIR_BINOP_WRAPPING_ADD, pb_op_copy(lb), pb_op_copy(la));
        } else {
            pb_push_binop(unsafe { mut_view(*mb) }, mut_view(arena), bb0, ls, MIR_BINOP_WRAPPING_ADD, pb_op_copy(la), pb_op_copy(lb));
        }
        sum_locs[f as usize] = ls;
        f = f + 1u32;
    }
    // Emit stores in descending field order (3, 2, 1, 0) to verify sorting by offset!
    pb_push_store_field(unsafe { mut_view(*mb) }, mut_view(arena), bb0, out_loc, 3u32, pb_op_copy(sum_locs[3]));
    pb_push_store_field(unsafe { mut_view(*mb) }, mut_view(arena), bb0, out_loc, 2u32, pb_op_copy(sum_locs[2]));
    pb_push_store_field(unsafe { mut_view(*mb) }, mut_view(arena), bb0, out_loc, 1u32, pb_op_copy(sum_locs[1]));
    pb_push_store_field(unsafe { mut_view(*mb) }, mut_view(arena), bb0, out_loc, 0u32, pb_op_copy(sum_locs[0]));
    pb_set_return(unsafe { mut_view(*mb) }, bb0);

    let obody = pb_build_opt_body(unsafe { view(*mb) }, pt, mut_view(arena), unsafe { mut_view(*sink) });
    if (obody as usize) == 0 || (unsafe { (*sink).errors }) != 0u32 {
        return false;
    }
    let pm = pb_init_pm(mut_view(arena), unsafe { mut_view(*obody) }, OPT_PROFILE_SPEED_O2, true);
    let mut stats: SlpVecStats = unsafe { *(arena_alloc_raw(mut_view(arena), size_of<SlpVecStats>(), align_of<SlpVecStats>()) as *mut SlpVecStats) };
    slp_vec_stats_zero(mut_view(stats));
    let changed = opt_slp_vec(unsafe { mut_view(*pm) }, unsafe { mut_view(*obody) }, 0 as *const EffectCallTable, 0 as *const AliasInfo, mut_view(stats), mut_view(arena), unsafe { mut_view(*sink) });
    if !changed || stats.trees_vectorized != 1u32 || stats.store_chains_vectorized != 1u32 || stats.lanes_packed_total != 4u32 || stats.record_count != 1 {
        return false;
    }
    let rec0 = unsafe { slp_vec_record_at(stats.records, 0) };
    if !(unsafe { (*rec0).applied }) || (unsafe { (*rec0).lane_count }) != 4u8 || (unsafe { (*rec0).vload_count }) != 2u8 || (unsafe { (*rec0).vstore_count }) != 1u8 || (unsafe { (*rec0).vbinop_count }) != 1u8 {
        return false;
    }

    // 1B: 8-lane array SLP on AVX2 target caps
    let mb8 = pb_new_mir_body(mut_view(arena), pt.ty_i32, 3);
    let arr_a = pb_add_local(unsafe { mut_view(*mb8) }, mut_view(arena), pt.ty_view_i32, true);
    let arr_b = pb_add_local(unsafe { mut_view(*mb8) }, mut_view(arena), pt.ty_view_i32, true);
    let arr_out = pb_add_local(unsafe { mut_view(*mb8) }, mut_view(arena), pt.ty_mut_view_i32, true);
    let bb8 = pb_add_bb(unsafe { mut_view(*mb8) }, mut_view(arena));
    let mut k: u64 = 0u64;
    while k < 8u64 {
        let idx_l = pb_add_local(unsafe { mut_view(*mb8) }, mut_view(arena), pt.ty_usize, false);
        let va = pb_add_local(unsafe { mut_view(*mb8) }, mut_view(arena), pt.ty_i32, false);
        let vb = pb_add_local(unsafe { mut_view(*mb8) }, mut_view(arena), pt.ty_i32, false);
        let vs = pb_add_local(unsafe { mut_view(*mb8) }, mut_view(arena), pt.ty_i32, false);
        pb_push_const(unsafe { mut_view(*mb8) }, mut_view(arena), bb8, idx_l, pt.ty_usize, k);
        pb_push_load_deref_idx(unsafe { mut_view(*mb8) }, mut_view(arena), bb8, va, arr_a, idx_l);
        pb_push_load_deref_idx(unsafe { mut_view(*mb8) }, mut_view(arena), bb8, vb, arr_b, idx_l);
        pb_push_binop(unsafe { mut_view(*mb8) }, mut_view(arena), bb8, vs, MIR_BINOP_WRAPPING_ADD, pb_op_copy(va), pb_op_copy(vb));
        pb_push_store_deref_idx(unsafe { mut_view(*mb8) }, mut_view(arena), bb8, arr_out, idx_l, pb_op_copy(vs));
        k = k + 1u64;
    }
    pb_set_return(unsafe { mut_view(*mb8) }, bb8);

    let ob8 = pb_build_opt_body(unsafe { view(*mb8) }, pt, mut_view(arena), unsafe { mut_view(*sink) });
    let pm8 = pb_init_pm(mut_view(arena), unsafe { mut_view(*ob8) }, OPT_PROFILE_SPEED_O2, true);
    let avx2_caps = vec_avx2_target_caps();
    slp_vec_stats_zero(mut_view(stats));
    let ch8 = opt_slp_vec_with_caps(unsafe { mut_view(*pm8) }, unsafe { mut_view(*ob8) }, 0 as *const EffectCallTable, 0 as *const AliasInfo, view(avx2_caps), mut_view(stats), mut_view(arena), unsafe { mut_view(*sink) });
    if !ch8 || stats.trees_vectorized != 1u32 || stats.lanes_packed_total != 8u32 {
        return false;
    }
    true
}

fn run_case2_broadcast_gather_and_ext_extract_cost(pt: view<ProbeTypes>) -> bool {
    let mut arena = arena_with_chunk_size(4194304);
    let sink = pb_new_sink(mut_view(arena));
    let mut stats: SlpVecStats = unsafe { *(arena_alloc_raw(mut_view(arena), size_of<SlpVecStats>(), align_of<SlpVecStats>()) as *mut SlpVecStats) };

    // 2A: Broadcast scalar multiplier + 1 external scalar extract (`s0` also used after stores)
    let mb = pb_new_mir_body(mut_view(arena), pt.ty_i32, 3);
    let a_loc = pb_add_local(unsafe { mut_view(*mb) }, mut_view(arena), pt.ty_vec4_i32, true);
    let scale_loc = pb_add_local(unsafe { mut_view(*mb) }, mut_view(arena), pt.ty_i32, true);
    let out_loc = pb_add_local(unsafe { mut_view(*mb) }, mut_view(arena), pt.ty_vec4_i32, true);
    let bb0 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(arena));

    let mut prod_locs: [4]u32 = [0u32, 0u32, 0u32, 0u32];
    let mut f: u32 = 0u32;
    while f < 4u32 {
        let la = pb_add_local(unsafe { mut_view(*mb) }, mut_view(arena), pt.ty_i32, false);
        let lp = pb_add_local(unsafe { mut_view(*mb) }, mut_view(arena), pt.ty_i32, false);
        pb_push_load_field(unsafe { mut_view(*mb) }, mut_view(arena), bb0, la, a_loc, f);
        pb_push_binop(unsafe { mut_view(*mb) }, mut_view(arena), bb0, lp, MIR_BINOP_WRAPPING_MUL, pb_op_copy(la), pb_op_copy(scale_loc));
        pb_push_store_field(unsafe { mut_view(*mb) }, mut_view(arena), bb0, out_loc, f, pb_op_copy(lp));
        prod_locs[f as usize] = lp;
        f = f + 1u32;
    }
    // External scalar use of lane 0 product outside the SLP tree (assigned to return local 0)
    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(arena), bb0, 0u32, MIR_BINOP_WRAPPING_ADD, pb_op_copy(prod_locs[0]), pb_op_const(pt.ty_i32, 1u64));
    pb_set_return(unsafe { mut_view(*mb) }, bb0);

    let ob = pb_build_opt_body(unsafe { view(*mb) }, pt, mut_view(arena), unsafe { mut_view(*sink) });
    let pm = pb_init_pm(mut_view(arena), unsafe { mut_view(*ob) }, OPT_PROFILE_SPEED_O2, true);
    slp_vec_stats_zero(mut_view(stats));
    let ch = opt_slp_vec(unsafe { mut_view(*pm) }, unsafe { mut_view(*ob) }, 0 as *const EffectCallTable, 0 as *const AliasInfo, mut_view(stats), mut_view(arena), unsafe { mut_view(*sink) });
    if !ch || stats.trees_vectorized != 1u32 || stats.broadcast_nodes_emitted != 1u32 || stats.external_extracts_emitted != 1u32 {
        return false;
    }
    let rec = unsafe { slp_vec_record_at(stats.records, 0) };
    if (unsafe { (*rec).vsplat_count }) != 1u8 || (unsafe { (*rec).vextract_count }) != 1u8 || (unsafe { (*rec).net_benefit }) <= 0i32 {
        return false;
    }

    // 2B: Unprofitable gather-heavy pack (non-contiguous indices 0, 5, 11, 14 with no vector arithmetic) -> rejected by cost model (`REQ-OPT-220`)
    let mb_g = pb_new_mir_body(mut_view(arena), pt.ty_i32, 2);
    let src_arr = pb_add_local(unsafe { mut_view(*mb_g) }, mut_view(arena), pt.ty_view_i32, true);
    let dst_vec = pb_add_local(unsafe { mut_view(*mb_g) }, mut_view(arena), pt.ty_vec4_i32, true);
    let bbg = pb_add_bb(unsafe { mut_view(*mb_g) }, mut_view(arena));
    let g_indices: [4]u64 = [0u64, 5u64, 11u64, 14u64];
    f = 0u32;
    while f < 4u32 {
        let il = pb_add_local(unsafe { mut_view(*mb_g) }, mut_view(arena), pt.ty_usize, false);
        let vl = pb_add_local(unsafe { mut_view(*mb_g) }, mut_view(arena), pt.ty_i32, false);
        pb_push_const(unsafe { mut_view(*mb_g) }, mut_view(arena), bbg, il, pt.ty_usize, g_indices[f as usize]);
        pb_push_load_deref_idx(unsafe { mut_view(*mb_g) }, mut_view(arena), bbg, vl, src_arr, il);
        pb_push_store_field(unsafe { mut_view(*mb_g) }, mut_view(arena), bbg, dst_vec, f, pb_op_copy(vl));
        f = f + 1u32;
    }
    pb_set_return(unsafe { mut_view(*mb_g) }, bbg);

    let ob_g = pb_build_opt_body(unsafe { view(*mb_g) }, pt, mut_view(arena), unsafe { mut_view(*sink) });
    let pm_g = pb_init_pm(mut_view(arena), unsafe { mut_view(*ob_g) }, OPT_PROFILE_SPEED_O2, true);
    slp_vec_stats_zero(mut_view(stats));
    let ch_g = opt_slp_vec(unsafe { mut_view(*pm_g) }, unsafe { mut_view(*ob_g) }, 0 as *const EffectCallTable, 0 as *const AliasInfo, mut_view(stats), mut_view(arena), unsafe { mut_view(*sink) });
    if ch_g || stats.trees_vectorized != 0u32 || stats.rejected_cost == 0u32 {
        return false;
    }
    true
}

fn run_case3_horiz_reduction_and_unrolled_slp(pt: view<ProbeTypes>) -> bool {
    let mut arena = arena_with_chunk_size(4194304);
    let sink = pb_new_sink(mut_view(arena));
    let mut stats: SlpVecStats = unsafe { *(arena_alloc_raw(mut_view(arena), size_of<SlpVecStats>(), align_of<SlpVecStats>()) as *mut SlpVecStats) };

    // 3A: 4-lane horizontal dot-product reduction `(a.x*b.x + a.y*b.y) + (a.z*b.z + a.w*b.w)`
    let mb_r = pb_new_mir_body(mut_view(arena), pt.ty_i32, 2);
    let a_loc = pb_add_local(unsafe { mut_view(*mb_r) }, mut_view(arena), pt.ty_vec4_i32, true);
    let b_loc = pb_add_local(unsafe { mut_view(*mb_r) }, mut_view(arena), pt.ty_vec4_i32, true);
    let bbr = pb_add_bb(unsafe { mut_view(*mb_r) }, mut_view(arena));

    let mut prods: [4]u32 = [0u32, 0u32, 0u32, 0u32];
    let mut f: u32 = 0u32;
    while f < 4u32 {
        let la = pb_add_local(unsafe { mut_view(*mb_r) }, mut_view(arena), pt.ty_i32, false);
        let lb = pb_add_local(unsafe { mut_view(*mb_r) }, mut_view(arena), pt.ty_i32, false);
        let lp = pb_add_local(unsafe { mut_view(*mb_r) }, mut_view(arena), pt.ty_i32, false);
        pb_push_load_field(unsafe { mut_view(*mb_r) }, mut_view(arena), bbr, la, a_loc, f);
        pb_push_load_field(unsafe { mut_view(*mb_r) }, mut_view(arena), bbr, lb, b_loc, f);
        pb_push_binop(unsafe { mut_view(*mb_r) }, mut_view(arena), bbr, lp, MIR_BINOP_WRAPPING_MUL, pb_op_copy(la), pb_op_copy(lb));
        prods[f as usize] = lp;
        f = f + 1u32;
    }
    let s01 = pb_add_local(unsafe { mut_view(*mb_r) }, mut_view(arena), pt.ty_i32, false);
    let s23 = pb_add_local(unsafe { mut_view(*mb_r) }, mut_view(arena), pt.ty_i32, false);
    pb_push_binop(unsafe { mut_view(*mb_r) }, mut_view(arena), bbr, s01, MIR_BINOP_WRAPPING_ADD, pb_op_copy(prods[0]), pb_op_copy(prods[1]));
    pb_push_binop(unsafe { mut_view(*mb_r) }, mut_view(arena), bbr, s23, MIR_BINOP_WRAPPING_ADD, pb_op_copy(prods[2]), pb_op_copy(prods[3]));
    pb_push_binop(unsafe { mut_view(*mb_r) }, mut_view(arena), bbr, 0u32, MIR_BINOP_WRAPPING_ADD, pb_op_copy(s01), pb_op_copy(s23));
    pb_set_return(unsafe { mut_view(*mb_r) }, bbr);

    let ob_r = pb_build_opt_body(unsafe { view(*mb_r) }, pt, mut_view(arena), unsafe { mut_view(*sink) });
    let pm_r = pb_init_pm(mut_view(arena), unsafe { mut_view(*ob_r) }, OPT_PROFILE_SPEED_O2, true);
    slp_vec_stats_zero(mut_view(stats));
    let ch_r = opt_slp_vec(unsafe { mut_view(*pm_r) }, unsafe { mut_view(*ob_r) }, 0 as *const EffectCallTable, 0 as *const AliasInfo, mut_view(stats), mut_view(arena), unsafe { mut_view(*sink) });
    if !ch_r || stats.reductions_vectorized != 1u32 || stats.lanes_packed_total != 4u32 {
        return false;
    }
    let rec_r = unsafe { slp_vec_record_at(stats.records, 0) };
    if (unsafe { (*rec_r).seed_kind }) != SLP_SEED_HORIZ_REDUCTION || (unsafe { (*rec_r).reduction_op }) != VREDUCE_ADD || (unsafe { (*rec_r).vreduce_count }) != 1u8 {
        return false;
    }

    // 3B: Strict FP horizontal reduction rejected (`REASON_STRICT_FP_REDUCTION`), accepted under `FP_MODE_RELAXED`
    let mb_fp = pb_new_mir_body(mut_view(arena), pt.ty_f64, 1);
    let arr_fp = pb_add_local(unsafe { mut_view(*mb_fp) }, mut_view(arena), pt.ty_arr16_f64, true);
    let bbfp = pb_add_bb(unsafe { mut_view(*mb_fp) }, mut_view(arena));
    let mut fp_vals: [4]u32 = [0u32, 0u32, 0u32, 0u32];
    f = 0u32;
    while f < 4u32 {
        let il = pb_add_local(unsafe { mut_view(*mb_fp) }, mut_view(arena), pt.ty_usize, false);
        let vl = pb_add_local(unsafe { mut_view(*mb_fp) }, mut_view(arena), pt.ty_f64, false);
        pb_push_const(unsafe { mut_view(*mb_fp) }, mut_view(arena), bbfp, il, pt.ty_usize, f as u64);
        pb_push_load_idx(unsafe { mut_view(*mb_fp) }, mut_view(arena), bbfp, vl, arr_fp, il);
        fp_vals[f as usize] = vl;
        f = f + 1u32;
    }
    let fp01 = pb_add_local(unsafe { mut_view(*mb_fp) }, mut_view(arena), pt.ty_f64, false);
    let fp23 = pb_add_local(unsafe { mut_view(*mb_fp) }, mut_view(arena), pt.ty_f64, false);
    pb_push_binop(unsafe { mut_view(*mb_fp) }, mut_view(arena), bbfp, fp01, MIR_BINOP_ADD, pb_op_copy(fp_vals[0]), pb_op_copy(fp_vals[1]));
    pb_push_binop(unsafe { mut_view(*mb_fp) }, mut_view(arena), bbfp, fp23, MIR_BINOP_ADD, pb_op_copy(fp_vals[2]), pb_op_copy(fp_vals[3]));
    pb_push_binop(unsafe { mut_view(*mb_fp) }, mut_view(arena), bbfp, 0u32, MIR_BINOP_ADD, pb_op_copy(fp01), pb_op_copy(fp23));
    pb_set_return(unsafe { mut_view(*mb_fp) }, bbfp);

    let ob_fp = pb_build_opt_body(unsafe { view(*mb_fp) }, pt, mut_view(arena), unsafe { mut_view(*sink) });
    let mut strict_caps = vec_avx2_target_caps();
    strict_caps.fp_mode = FP_MODE_STRICT;
    let ob_fp_bb0 = unsafe { opt_block_at((*ob_fp).blocks, 0) };
    let root_fp_idx = (unsafe { (*ob_fp_bb0).inst_count }) - 1;
    let strict_tree = slp_build_reduction_seed_tree(unsafe { view(*ob_fp) }, unsafe { view(*ob_fp_bb0) }, 0 as *const AliasInfo, view(strict_caps), OPT_PROFILE_SPEED_O2, root_fp_idx, mut_view(arena));
    if strict_tree.is_valid || strict_tree.reject_reason != REASON_STRICT_FP_REDUCTION {
        return false;
    }
    let mut relaxed_caps = vec_avx2_target_caps();
    relaxed_caps.fp_mode = FP_MODE_RELAXED;
    let relaxed_tree = slp_build_reduction_seed_tree(unsafe { view(*ob_fp) }, unsafe { view(*ob_fp_bb0) }, 0 as *const AliasInfo, view(relaxed_caps), OPT_PROFILE_SPEED_O2, root_fp_idx, mut_view(arena));
    if !relaxed_tree.is_valid || !relaxed_tree.cost.profitable {
        return false;
    }

    // 3C: Post-unroll relative index SLP (`out[base + 0]..out[base + 3] = a[base + 0]..a[base + 3] + b[base + 0]..b[base + 3]`)
    let mb_u = pb_new_mir_body(mut_view(arena), pt.ty_i32, 4);
    let ua = pb_add_local(unsafe { mut_view(*mb_u) }, mut_view(arena), pt.ty_view_i32, true);
    let ub = pb_add_local(unsafe { mut_view(*mb_u) }, mut_view(arena), pt.ty_view_i32, true);
    let uout = pb_add_local(unsafe { mut_view(*mb_u) }, mut_view(arena), pt.ty_mut_view_i32, true);
    let base_iv = pb_add_local(unsafe { mut_view(*mb_u) }, mut_view(arena), pt.ty_usize, true);
    let bbu = pb_add_bb(unsafe { mut_view(*mb_u) }, mut_view(arena));
    f = 0u32;
    while f < 4u32 {
        let idx_k = pb_add_local(unsafe { mut_view(*mb_u) }, mut_view(arena), pt.ty_usize, false);
        let la = pb_add_local(unsafe { mut_view(*mb_u) }, mut_view(arena), pt.ty_i32, false);
        let lb = pb_add_local(unsafe { mut_view(*mb_u) }, mut_view(arena), pt.ty_i32, false);
        let ls = pb_add_local(unsafe { mut_view(*mb_u) }, mut_view(arena), pt.ty_i32, false);
        pb_push_binop(unsafe { mut_view(*mb_u) }, mut_view(arena), bbu, idx_k, MIR_BINOP_WRAPPING_ADD, pb_op_copy(base_iv), pb_op_const(pt.ty_usize, f as u64));
        pb_push_load_deref_idx(unsafe { mut_view(*mb_u) }, mut_view(arena), bbu, la, ua, idx_k);
        pb_push_load_deref_idx(unsafe { mut_view(*mb_u) }, mut_view(arena), bbu, lb, ub, idx_k);
        pb_push_binop(unsafe { mut_view(*mb_u) }, mut_view(arena), bbu, ls, MIR_BINOP_WRAPPING_ADD, pb_op_copy(la), pb_op_copy(lb));
        pb_push_store_deref_idx(unsafe { mut_view(*mb_u) }, mut_view(arena), bbu, uout, idx_k, pb_op_copy(ls));
        f = f + 1u32;
    }
    pb_set_return(unsafe { mut_view(*mb_u) }, bbu);

    let ob_u = pb_build_opt_body(unsafe { view(*mb_u) }, pt, mut_view(arena), unsafe { mut_view(*sink) });
    let pm_u = pb_init_pm(mut_view(arena), unsafe { mut_view(*ob_u) }, OPT_PROFILE_SPEED_O2, true);
    slp_vec_stats_zero(mut_view(stats));
    let ch_u = opt_slp_vec(unsafe { mut_view(*pm_u) }, unsafe { mut_view(*ob_u) }, 0 as *const EffectCallTable, 0 as *const AliasInfo, mut_view(stats), mut_view(arena), unsafe { mut_view(*sink) });
    if !ch_u || stats.trees_vectorized != 1u32 || stats.lanes_packed_total != 4u32 {
        return false;
    }
    true
}

fn run_case4_alias_barriers_and_overflow_rejection(pt: view<ProbeTypes>) -> bool {
    let mut arena = arena_with_chunk_size(4194304);
    let sink = pb_new_sink(mut_view(arena));
    let mut stats: SlpVecStats = unsafe { *(arena_alloc_raw(mut_view(arena), size_of<SlpVecStats>(), align_of<SlpVecStats>()) as *mut SlpVecStats) };

    // 4A: Intervening raw pointer store (*raw_ptr)[0] between out[0] and out[1] -> MayAlias/UnknownAlias rejected (`REQ-OPT-215`)
    let mb_al = pb_new_mir_body(mut_view(arena), pt.ty_i32, 4);
    let a_loc = pb_add_local(unsafe { mut_view(*mb_al) }, mut_view(arena), pt.ty_view_i32, true);
    let b_loc = pb_add_local(unsafe { mut_view(*mb_al) }, mut_view(arena), pt.ty_view_i32, true);
    let out_loc = pb_add_local(unsafe { mut_view(*mb_al) }, mut_view(arena), pt.ty_ptr_i32, true);
    let raw_p = pb_add_local(unsafe { mut_view(*mb_al) }, mut_view(arena), pt.ty_ptr_i32, true);
    let bbal = pb_add_bb(unsafe { mut_view(*mb_al) }, mut_view(arena));

    let mut k: u32 = 0u32;
    while k < 4u32 {
        let il = pb_add_local(unsafe { mut_view(*mb_al) }, mut_view(arena), pt.ty_usize, false);
        let la = pb_add_local(unsafe { mut_view(*mb_al) }, mut_view(arena), pt.ty_i32, false);
        let lb = pb_add_local(unsafe { mut_view(*mb_al) }, mut_view(arena), pt.ty_i32, false);
        let ls = pb_add_local(unsafe { mut_view(*mb_al) }, mut_view(arena), pt.ty_i32, false);
        pb_push_const(unsafe { mut_view(*mb_al) }, mut_view(arena), bbal, il, pt.ty_usize, k as u64);
        pb_push_load_deref_idx(unsafe { mut_view(*mb_al) }, mut_view(arena), bbal, la, a_loc, il);
        pb_push_load_deref_idx(unsafe { mut_view(*mb_al) }, mut_view(arena), bbal, lb, b_loc, il);
        pb_push_binop(unsafe { mut_view(*mb_al) }, mut_view(arena), bbal, ls, MIR_BINOP_WRAPPING_ADD, pb_op_copy(la), pb_op_copy(lb));
        pb_push_store_deref_idx(unsafe { mut_view(*mb_al) }, mut_view(arena), bbal, out_loc, il, pb_op_copy(ls));
        if k == 1u32 {
            // Intervening write through raw pointer `*raw_p` which MayAlias `*out_loc`
            let clob_idx = pb_add_local(unsafe { mut_view(*mb_al) }, mut_view(arena), pt.ty_usize, false);
            pb_push_const(unsafe { mut_view(*mb_al) }, mut_view(arena), bbal, clob_idx, pt.ty_usize, 0u64);
            pb_push_store_deref_idx(unsafe { mut_view(*mb_al) }, mut_view(arena), bbal, raw_p, clob_idx, pb_op_const(pt.ty_i32, 99u64));
        }
        k = k + 1u32;
    }
    pb_set_return(unsafe { mut_view(*mb_al) }, bbal);

    let ob_al = pb_build_opt_body(unsafe { view(*mb_al) }, pt, mut_view(arena), unsafe { mut_view(*sink) });
    let pm_al = pb_init_pm(mut_view(arena), unsafe { mut_view(*ob_al) }, OPT_PROFILE_SPEED_O2, true);
    slp_vec_stats_zero(mut_view(stats));
    let ch_al = opt_slp_vec(unsafe { mut_view(*pm_al) }, unsafe { mut_view(*ob_al) }, 0 as *const EffectCallTable, 0 as *const AliasInfo, mut_view(stats), mut_view(arena), unsafe { mut_view(*sink) });
    if ch_al || stats.trees_vectorized != 0u32 || stats.rejected_unknown_alias == 0u32 {
        return false;
    }

    // 4B: Unproven checked overflow in lane arithmetic -> rejected with `REASON_CHECKED_OVERFLOW_TRAP`
    let mb_ov = pb_new_mir_body(mut_view(arena), pt.ty_i32, 3);
    let va_loc = pb_add_local(unsafe { mut_view(*mb_ov) }, mut_view(arena), pt.ty_vec4_i32, true);
    let vb_loc = pb_add_local(unsafe { mut_view(*mb_ov) }, mut_view(arena), pt.ty_vec4_i32, true);
    let vout_loc = pb_add_local(unsafe { mut_view(*mb_ov) }, mut_view(arena), pt.ty_vec4_i32, true);
    let bbov = pb_add_bb(unsafe { mut_view(*mb_ov) }, mut_view(arena));
    k = 0u32;
    while k < 4u32 {
        let la = pb_add_local(unsafe { mut_view(*mb_ov) }, mut_view(arena), pt.ty_i32, false);
        let lb = pb_add_local(unsafe { mut_view(*mb_ov) }, mut_view(arena), pt.ty_i32, false);
        let ls = pb_add_local(unsafe { mut_view(*mb_ov) }, mut_view(arena), pt.ty_i32, false);
        pb_push_load_field(unsafe { mut_view(*mb_ov) }, mut_view(arena), bbov, la, va_loc, k);
        pb_push_load_field(unsafe { mut_view(*mb_ov) }, mut_view(arena), bbov, lb, vb_loc, k);
        pb_push_binop(unsafe { mut_view(*mb_ov) }, mut_view(arena), bbov, ls, MIR_BINOP_WRAPPING_ADD, pb_op_copy(la), pb_op_copy(lb));
        pb_push_store_field(unsafe { mut_view(*mb_ov) }, mut_view(arena), bbov, vout_loc, k, pb_op_copy(ls));
        k = k + 1u32;
    }
    pb_set_return(unsafe { mut_view(*mb_ov) }, bbov);

    let ob_ov = pb_build_opt_body(unsafe { view(*mb_ov) }, pt, mut_view(arena), unsafe { mut_view(*sink) });
    let bb_ov0 = unsafe { opt_block_at((*ob_ov).blocks, 0) };
    unsafe {
        (*opt_inst_at((*bb_ov0).insts, 2)).opcode = OPT_INST_CHECKED_BINOP;
        (*opt_inst_at((*bb_ov0).insts, 6)).opcode = OPT_INST_CHECKED_BINOP;
        (*opt_inst_at((*bb_ov0).insts, 10)).opcode = OPT_INST_CHECKED_BINOP;
        (*opt_inst_at((*bb_ov0).insts, 14)).opcode = OPT_INST_CHECKED_BINOP;
    }
    let pm_ov = pb_init_pm(mut_view(arena), unsafe { mut_view(*ob_ov) }, OPT_PROFILE_SPEED_O2, true);
    slp_vec_stats_zero(mut_view(stats));
    let ch_ov = opt_slp_vec(unsafe { mut_view(*pm_ov) }, unsafe { mut_view(*ob_ov) }, 0 as *const EffectCallTable, 0 as *const AliasInfo, mut_view(stats), mut_view(arena), unsafe { mut_view(*sink) });
    if ch_ov || stats.trees_vectorized != 0u32 || stats.rejected_checked_overflow == 0u32 {
        return false;
    }

    // 4C: Intervening volatile barrier between stores -> rejected with `REASON_VOLATILE_BARRIER`
    let ob_vol = pb_build_opt_body(unsafe { view(*mb_ov) }, pt, mut_view(arena), unsafe { mut_view(*sink) });
    let bb_vol = unsafe { opt_block_at((*ob_vol).blocks, 0) };
    let inst_mid = unsafe { opt_inst_at((*bb_vol).insts, 5) };
    unsafe {
        (*inst_mid).opcode = OPT_INST_VOLATILE_LOAD;
        (*inst_mid).flags = OPT_FLAG_BARRIER;
    }
    let pm_vol = pb_init_pm(mut_view(arena), unsafe { mut_view(*ob_vol) }, OPT_PROFILE_SPEED_O2, true);
    slp_vec_stats_zero(mut_view(stats));
    let ch_vol = opt_slp_vec(unsafe { mut_view(*pm_vol) }, unsafe { mut_view(*ob_vol) }, 0 as *const EffectCallTable, 0 as *const AliasInfo, mut_view(stats), mut_view(arena), unsafe { mut_view(*sink) });
    if ch_vol || stats.rejected_volatile == 0u32 {
        return false;
    }
    true
}

fn run_case5_lir_vec_lower_128_256_movq_split() -> bool {
    let mut arena = arena_with_chunk_size(2097152);
    let sse2_caps = vec_default_target_caps();
    let avx2_caps = vec_avx2_target_caps();

    // 5A: Type legalization checks (64-bit -> Vec128 MOVQ, 128-bit -> Vec128, 256-bit -> Vec256 on AVX2 vs 2xVec128 split on SSE2)
    let ty_64 = vec_lower_legalize_type(view(sse2_caps), VEC_ELEM_I32, 2u8);
    if ty_64.vec_kind != LIR_VEC_TY_V128 || ty_64.reg_class != REG_CLASS_VEC128 || ty_64.total_bits != 64u16 || ty_64.alloc_bits != 128u16 || ty_64.split_count != 1u8 {
        return false;
    }
    let ty_128 = vec_lower_legalize_type(view(sse2_caps), VEC_ELEM_I32, 4u8);
    if ty_128.vec_kind != LIR_VEC_TY_V128 || ty_128.total_bits != 128u16 || ty_128.split_count != 1u8 {
        return false;
    }
    let ty_256_avx2 = vec_lower_legalize_type(view(avx2_caps), VEC_ELEM_I32, 8u8);
    if ty_256_avx2.vec_kind != LIR_VEC_TY_V256 || ty_256_avx2.reg_class != REG_CLASS_VEC256 || ty_256_avx2.total_bits != 256u16 || ty_256_avx2.split_count != 1u8 {
        return false;
    }
    let ty_256_sse2 = vec_lower_legalize_type(view(sse2_caps), VEC_ELEM_I32, 8u8);
    if ty_256_sse2.vec_kind != LIR_VEC_TY_V128 || ty_256_sse2.reg_class != REG_CLASS_VEC128 || ty_256_sse2.split_count != 2u8 || ty_256_sse2.lane_count != 4u8 {
        return false;
    }

    // 5B: Alignment flag selection (`ALIGN_KNOWN_ALIGNED` vs `ALIGN_UNKNOWN` / `ALIGN_KNOWN_UNALIGNED`)
    let mf_aligned = vec_lower_select_mem_flags(ALIGN_KNOWN_ALIGNED, 32u16, view(ty_256_avx2), false, false);
    let mf_unknown = vec_lower_select_mem_flags(ALIGN_UNKNOWN, 32u16, view(ty_256_avx2), false, false);
    let mf_unaligned = vec_lower_select_mem_flags(ALIGN_KNOWN_UNALIGNED, 8u16, view(ty_128), false, false);
    if (mf_aligned & LIR_MEM_FLAG_ALIGNED) == 0u8 || (mf_unknown & LIR_MEM_FLAG_ALIGNED) != 0u8 || (mf_unaligned & LIR_MEM_FLAG_ALIGNED) != 0u8 {
        return false;
    }

    // 5C: Lower 64-bit 2x32 pack -> exact 64-bit `LIR_INST_VMOVQ_64` transfers
    let mut vbody64: LirVecBody = unsafe { *(arena_alloc_raw(mut_view(arena), size_of<LirVecBody>(), align_of<LirVecBody>()) as *mut LirVecBody) };
    let mut vstats64: VecLowerStats = unsafe { *(arena_alloc_raw(mut_view(arena), size_of<VecLowerStats>(), align_of<VecLowerStats>()) as *mut VecLowerStats) };
    vec_lower_body_init(mut_view(vbody64), SymbolId { v: 1u32 }, sse2_caps.isa_level);
    vec_lower_stats_zero(mut_view(vstats64));
    let vr_a64 = vec_lower_emit_load(mut_view(vbody64), view(sse2_caps), VEC_ELEM_I32, 2u8, 1u32, 0i32, ALIGN_UNKNOWN, 4u16, mut_view(vstats64), mut_view(arena));
    let vr_b64 = vec_lower_emit_load(mut_view(vbody64), view(sse2_caps), VEC_ELEM_I32, 2u8, 2u32, 0i32, ALIGN_UNKNOWN, 4u16, mut_view(vstats64), mut_view(arena));
    let vr_s64 = vec_lower_emit_binop(mut_view(vbody64), view(sse2_caps), VEC_ELEM_I32, 2u8, MIR_BINOP_ADD, vr_a64, vr_b64, mut_view(vstats64), mut_view(arena));
    vec_lower_emit_store(mut_view(vbody64), view(sse2_caps), VEC_ELEM_I32, 2u8, vr_s64, 3u32, 0i32, ALIGN_UNKNOWN, 4u16, mut_view(vstats64), mut_view(arena));
    if vstats64.narrow_64_movq_emitted != 3u32 || !vec_lower_verify_body(view(vbody64), view(sse2_caps), mut_view(vstats64)) {
        return false;
    }

    // 5D: Lower 256-bit 8x32 on SSE2 (splits into 2x128-bit pairs) vs AVX2 (uses YMM + VZEROUPPER)
    let mut vbody_split: LirVecBody = unsafe { *(arena_alloc_raw(mut_view(arena), size_of<LirVecBody>(), align_of<LirVecBody>()) as *mut LirVecBody) };
    let mut vstats_split: VecLowerStats = unsafe { *(arena_alloc_raw(mut_view(arena), size_of<VecLowerStats>(), align_of<VecLowerStats>()) as *mut VecLowerStats) };
    vec_lower_body_init(mut_view(vbody_split), SymbolId { v: 2u32 }, sse2_caps.isa_level);
    vec_lower_stats_zero(mut_view(vstats_split));
    let vr_lo = vec_lower_emit_load(mut_view(vbody_split), view(sse2_caps), VEC_ELEM_I32, 8u8, 1u32, 0i32, ALIGN_UNKNOWN, 4u16, mut_view(vstats_split), mut_view(arena));
    let vr_sum = vec_lower_emit_binop(mut_view(vbody_split), view(sse2_caps), VEC_ELEM_I32, 8u8, MIR_BINOP_ADD, vr_lo, vr_lo, mut_view(vstats_split), mut_view(arena));
    vec_lower_emit_store(mut_view(vbody_split), view(sse2_caps), VEC_ELEM_I32, 8u8, vr_sum, 2u32, 0i32, ALIGN_UNKNOWN, 4u16, mut_view(vstats_split), mut_view(arena));
    if vstats_split.split_256_to_128_pairs != 3u32 || vbody_split.frame.uses_ymm || !vec_lower_verify_body(view(vbody_split), view(sse2_caps), mut_view(vstats_split)) {
        return false;
    }

    // Integer DIV scalarization check (`LIR_INST_SCALAR_LANE_OP`)
    let _ = vec_lower_emit_binop(mut_view(vbody_split), view(sse2_caps), VEC_ELEM_I32, 4u8, MIR_BINOP_DIV, vr_lo, vr_lo, mut_view(vstats_split), mut_view(arena));
    if vstats_split.scalarized_ops_emitted != 4u32 {
        return false;
    }
    true
}

fn run_case6_emit_slp_and_lir_formatters(pt: view<ProbeTypes>) -> bool {
    let mut arena = arena_with_chunk_size(4194304);
    let sink = pb_new_sink(mut_view(arena));

    let mb = pb_new_mir_body(mut_view(arena), pt.ty_i32, 3);
    let a_loc = pb_add_local(unsafe { mut_view(*mb) }, mut_view(arena), pt.ty_view_i32, true);
    let b_loc = pb_add_local(unsafe { mut_view(*mb) }, mut_view(arena), pt.ty_view_i32, true);
    let out_loc = pb_add_local(unsafe { mut_view(*mb) }, mut_view(arena), pt.ty_mut_view_i32, true);
    let bb0 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(arena));
    let mut k: u64 = 0u64;
    while k < 8u64 {
        let il = pb_add_local(unsafe { mut_view(*mb) }, mut_view(arena), pt.ty_usize, false);
        let la = pb_add_local(unsafe { mut_view(*mb) }, mut_view(arena), pt.ty_i32, false);
        let lb = pb_add_local(unsafe { mut_view(*mb) }, mut_view(arena), pt.ty_i32, false);
        let ls = pb_add_local(unsafe { mut_view(*mb) }, mut_view(arena), pt.ty_i32, false);
        pb_push_const(unsafe { mut_view(*mb) }, mut_view(arena), bb0, il, pt.ty_usize, k);
        pb_push_load_deref_idx(unsafe { mut_view(*mb) }, mut_view(arena), bb0, la, a_loc, il);
        pb_push_load_deref_idx(unsafe { mut_view(*mb) }, mut_view(arena), bb0, lb, b_loc, il);
        pb_push_binop(unsafe { mut_view(*mb) }, mut_view(arena), bb0, ls, MIR_BINOP_WRAPPING_ADD, pb_op_copy(la), pb_op_copy(lb));
        pb_push_store_deref_idx(unsafe { mut_view(*mb) }, mut_view(arena), bb0, out_loc, il, pb_op_copy(ls));
        k = k + 1u64;
    }
    pb_set_return(unsafe { mut_view(*mb) }, bb0);

    let avx2_caps = vec_avx2_target_caps();
    let mut stats: SlpVecStats = unsafe { *(arena_alloc_raw(mut_view(arena), size_of<SlpVecStats>(), align_of<SlpVecStats>()) as *mut SlpVecStats) };
    let ok = slp_vec_optimize_mir_body(
        unsafe { mut_view(*mb) },
        pt.thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        view(avx2_caps),
        mut_view(stats),
        mut_view(arena),
        unsafe { mut_view(*sink) },
        0 as *const HirItem
    );
    if !ok || stats.trees_vectorized != 1u32 || stats.lanes_packed_total != 8u32 {
        return false;
    }

    // Also test lowering synthetic OptIR vector instructions on AVX2 -> emits YMM + VZEROUPPER before RET
    let ob = pb_build_opt_body(unsafe { view(*mb) }, pt, mut_view(arena), unsafe { mut_view(*sink) });
    let bb_ob = unsafe { opt_block_at((*ob).blocks, 0) };
    unsafe {
        (*opt_inst_at((*bb_ob).insts, 1)).opcode = OPT_INST_VLOAD;
        (*opt_inst_at((*bb_ob).insts, 2)).opcode = OPT_INST_VLOAD;
        (*opt_inst_at((*bb_ob).insts, 3)).opcode = OPT_INST_VBINOP;
        (*opt_inst_at((*bb_ob).insts, 4)).opcode = OPT_INST_VSTORE;
    }
    let mut vbody: LirVecBody = unsafe { *(arena_alloc_raw(mut_view(arena), size_of<LirVecBody>(), align_of<LirVecBody>()) as *mut LirVecBody) };
    let mut vstats: VecLowerStats = unsafe { *(arena_alloc_raw(mut_view(arena), size_of<VecLowerStats>(), align_of<VecLowerStats>()) as *mut VecLowerStats) };
    vec_lower_stats_zero(mut_view(vstats));
    if !vec_lower_opt_body(unsafe { view(*ob) }, view(avx2_caps), 8u8, ALIGN_KNOWN_ALIGNED, 32u16, mut_view(vbody), mut_view(vstats), mut_view(arena)) {
        return false;
    }
    if !vbody.frame.uses_ymm || !vbody.frame.requires_32_byte_alignment || !vbody.frame.vzeroupper_before_ret || vstats.vzeroupper_emitted == 0u32 {
        return false;
    }
    if !vec_lower_verify_body(view(vbody), view(avx2_caps), mut_view(vstats)) {
        return false;
    }

    let mut dbuf = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(dbuf));
    slp_vec_print(view(stats), mut_view(dbuf));
    vec_lower_print(view(vbody), view(vstats), mut_view(dbuf));
    if (dbuf.len) < 60 {
        return false;
    }
    let contract = slp_vec_contract();
    if contract.pass_id != PASS_SLP_VEC {
        return false;
    }
    true
}

pub fn main() -> i32 {
    let mut type_arena = arena_with_chunk_size(1048576);
    let pt = pb_init_types(mut_view(type_arena));

    if !run_case1_struct_and_array_adjacent_slp(view(pt)) {
        print("CASE1_STRUCT_AND_ARRAY_ADJACENT_SLP: FAIL\n");
        return 1;
    }
    print("CASE1_STRUCT_AND_ARRAY_ADJACENT_SLP: OK\n");

    if !run_case2_broadcast_gather_and_ext_extract_cost(view(pt)) {
        print("CASE2_BROADCAST_GATHER_AND_EXT_EXTRACT_COST: FAIL\n");
        return 2;
    }
    print("CASE2_BROADCAST_GATHER_AND_EXT_EXTRACT_COST: OK\n");

    if !run_case3_horiz_reduction_and_unrolled_slp(view(pt)) {
        print("CASE3_HORIZ_REDUCTION_AND_UNROLLED_SLP: FAIL\n");
        return 3;
    }
    print("CASE3_HORIZ_REDUCTION_AND_UNROLLED_SLP: OK\n");

    if !run_case4_alias_barriers_and_overflow_rejection(view(pt)) {
        print("CASE4_ALIAS_BARRIERS_AND_OVERFLOW_REJECTION: FAIL\n");
        return 4;
    }
    print("CASE4_ALIAS_BARRIERS_AND_OVERFLOW_REJECTION: OK\n");

    if !run_case5_lir_vec_lower_128_256_movq_split() {
        print("CASE5_LIR_VEC_LOWER_128_256_MOVQ_SPLIT: FAIL\n");
        return 5;
    }
    print("CASE5_LIR_VEC_LOWER_128_256_MOVQ_SPLIT: OK\n");

    if !run_case6_emit_slp_and_lir_formatters(view(pt)) {
        print("CASE6_EMIT_SLP_AND_LIR_FORMATTERS: FAIL\n");
        return 6;
    }
    print("CASE6_EMIT_SLP_AND_LIR_FORMATTERS: OK\n");

    print("OPT-SLP-VEC-PROBE: ALL-OK\n");
    0
}
