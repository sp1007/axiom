// test: run
// stdout: UNROLL4=520\nHORIZ_ADD=206\nHORIZ_XOR=15\nEXT_USE=389\n

@derive(Copy)
struct Vec4i {
    x: i32,
    y: i32,
    z: i32,
    w: i32,
}

fn kernel_unrolled_stride4(dst: mut_view<[i32]>, a: view<[i32]>, b: view<[i32]>, base: usize) -> i32 {
    let i0: usize = base;
    let i1: usize = base + 1;
    let i2: usize = base + 2;
    let i3: usize = base + 3;
    dst[i0] = a[i0] * 2 + b[i0];
    dst[i1] = a[i1] * 2 + b[i1];
    dst[i2] = a[i2] * 2 + b[i2];
    dst[i3] = a[i3] * 2 + b[i3];
    dst[i0] + dst[i1] + dst[i2] + dst[i3]
}

fn kernel_horiz_dot(a: view<Vec4i>, b: view<Vec4i>) -> i32 {
    let p0: i32 = a.x * b.x;
    let p1: i32 = a.y * b.y;
    let p2: i32 = a.z * b.z;
    let p3: i32 = a.w * b.w;
    (p0 + p1) + (p2 + p3)
}

fn kernel_horiz_xor(a: view<Vec4i>, b: view<Vec4i>) -> i32 {
    let x0: i32 = a.x ^ b.x;
    let x1: i32 = a.y ^ b.y;
    let x2: i32 = a.z ^ b.z;
    let x3: i32 = a.w ^ b.w;
    (x0 ^ x1) ^ (x2 ^ x3)
}

fn kernel_ext_extract_use(a: view<Vec4i>, b: view<Vec4i>) -> i32 {
    let s0: i32 = a.x * 2 + b.x;
    let s1: i32 = a.y * 2 + b.y;
    let s2: i32 = a.z * 2 + b.z;
    let s3: i32 = a.w * 2 + b.w;
    let mut out = Vec4i { x: 0, y: 0, z: 0, w: 0 };
    out.x = s0;
    out.y = s1;
    out.z = s2;
    out.w = s3;
    let ext_bonus: i32 = s1 * 2 + s0 + 14;
    (out.x + out.y + out.z + out.w) + ext_bonus
}

fn main() -> i32 {
    let a: [8]i32 = [10, 20, 30, 40, 25, 35, 45, 55];
    let b: [8]i32 = [5, 10, 15, 20, 30, 40, 60, 70];
    let mut dst: [8]i32 = [0; 8];
    let u4: i32 = kernel_unrolled_stride4(mut_view(dst), view(a), view(b), 4);

    let da = Vec4i { x: 3, y: 5, z: 7, w: 9 };
    let db = Vec4i { x: 4, y: 6, z: 8, w: 12 };
    let hadd: i32 = kernel_horiz_dot(view(da), view(db));

    let xa = Vec4i { x: 1, y: 2, z: 4, w: 8 };
    let xb = Vec4i { x: 0, y: 0, z: 0, w: 0 };
    let hxor: i32 = kernel_horiz_xor(view(xa), view(xb));

    let ea = Vec4i { x: 10, y: 20, z: 30, w: 40 };
    let eb = Vec4i { x: 5, y: 10, z: 15, w: 20 };
    let ext: i32 = kernel_ext_extract_use(view(ea), view(eb));

    print("UNROLL4=");
    print_int(u4);
    print("\nHORIZ_ADD=");
    print_int(hadd);
    print("\nHORIZ_XOR=");
    print_int(hxor);
    print("\nEXT_USE=");
    print_int(ext);
    print("\n");
    0
}
