// test: run
// exit: 101

@derive(Copy)
struct Vec4i {
    x: i32,
    y: i32,
    z: i32,
    w: i32,
}

fn slp_lane_overflow_must_trap(a: view<Vec4i>, b: view<Vec4i>) -> i32 {
    let mut out = Vec4i { x: 0, y: 0, z: 0, w: 0 };
    out.x = a.x + b.x;
    out.y = a.y + b.y;
    out.z = a.z + b.z;
    out.w = a.w + b.w;
    out.x + out.y + out.z + out.w
}

fn main() -> i32 {
    let a = Vec4i { x: 10, y: 20, z: 2147483640, w: 40 };
    let b = Vec4i { x: 1, y: 2, z: 100, w: 4 };
    let v: i32 = slp_lane_overflow_must_trap(view(a), view(b));
    print_int(v);
    0
}
