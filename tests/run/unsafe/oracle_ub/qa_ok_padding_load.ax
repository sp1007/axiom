// test: run
// modes: interp native
// stdout: 7 9\n
// QA T502 (UB-04 negative, SPEC-50 UB-04 row: padding bytes during aggregate copy are NOT UB): a typed load of the whole struct into a local.
// The block is written only at offsets 0 (u8) and 8 (u64); bytes 1..7 are padding and stay uninitialized.

use std.core.host.heap_alloc
use std.core.host.heap_free

@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

@repr(C)
struct P {
    a: u8,
    b: u64,
}

pub fn main() -> i32 {
    unsafe {
        let raw: *mut u8 = heap_alloc(16, 8);
        *raw = 7u8;
        let hi: *mut u64 = (raw + 8usize) as *mut u64;
        *hi = 9u64;
        let src: *mut P = raw as *mut P;
        let s: P = *src;
        print_int(s.a as i64);
        print(" ");
        print_int(s.b as i64);
        heap_free(raw, 16, 8);
    }
    print("\n");
    0
}
