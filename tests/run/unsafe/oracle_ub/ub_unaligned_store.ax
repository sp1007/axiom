// test: run
// modes: interp
// reason: oracle-only check
// exit: 125
// stderr-contains: AX_UNSAFE_INTERP_UB
// stderr-contains: misaligned pointer access
// T502 (UB-03): a typed `u64` store through a heap pointer offset by 4 bytes.

use std.core.host.heap_alloc

pub fn main() -> i32 {
    let p: *mut u8 = unsafe { heap_alloc(32, 8) };
    unsafe {
        *((p + 4usize) as *mut u64) = 5u64;
    }
    0
}
