// test: run
// modes: interp native
// stdout: 33 1 1 1 1\n
// T502 (SPEC-50 AXS-UNS-011/012, negative for UB-01/UB-02): the checks never fire on valid programs. An exposed address
// (`p as usize`) that is cast back inside the same live object is usable; the one-past-the-end pointer may be formed and compared;
// pointers to elements of a heap block and `ptr_diff`-style address arithmetic agree.

use std.core.host.heap_alloc
use std.core.host.heap_free

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

fn flag(b: bool) -> i32 {
    if b { 1 } else { 0 }
}

pub fn main() -> i32 {
    let mut buf: [4]u32 = [1u32, 2u32, 3u32, 4u32];
    let p: *mut u32 = unsafe { address_of_mut(buf[0]) };
    let a: usize = p as usize;
    let q: *mut u32 = (a + 8usize) as *mut u32;
    unsafe {
        *q = 33u32;
    }
    let end: *mut u32 = unsafe { p + 4usize };
    let heap: *mut u32 = unsafe { heap_alloc(16, 8) as *mut u32 };
    unsafe {
        *heap = 5u32;
        *(heap + 3usize) = 6u32;
    }
    let h_end: *mut u32 = unsafe { heap + 4usize };
    let same: bool = unsafe { (*(heap + 3usize)) == 6u32 && *heap == 5u32 };
    print_int(buf[2] as i64);
    print(" ");
    print_int(flag((end as usize) == a + 16usize) as i64);
    print(" ");
    print_int(flag((h_end as usize) == (heap as usize) + 16usize) as i64);
    print(" ");
    print_int(flag(same) as i64);
    print(" ");
    print_int(flag(buf[0] == 1u32 && buf[3] == 4u32) as i64);
    print("\n");
    unsafe {
        heap_free(heap as *mut u8, 16, 8);
    }
    0
}
