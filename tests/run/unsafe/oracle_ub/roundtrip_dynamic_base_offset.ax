// test: run
// modes: interp native
// native-after: T504
// stdout: 1 1 1 11 22 1\n
// T502 (REQ-OWNER-008, SPEC-50 AXS-UNS-024/025): block-scope `@addr(base + 0x100)` where `base = fn_addr(foo)` is computed at run
// time. The address lies outside every live object, so the oracle maps the region when the declaration binds it;
// `static_addr(REG) == base + 0x100` and reads/writes act on the bound address.

@intrinsic fn fn_addr<F>(f: F) -> usize { 0 }
@intrinsic fn static_addr<S>(s: S) -> usize { 0 }
@intrinsic fn addr_of<T>(x: T) -> usize { 0 }

fn foo() -> i32 {
    1
}

fn flag(b: bool) -> i32 {
    if b { 1 } else { 0 }
}

pub fn main() -> i32 {
    let base: usize = fn_addr(foo);
    @addr(base + 0x100) unsafe static mut REG: u32;
    @addr(base + 0x200) unsafe static mut SLOT: u32 = 22u32;
    unsafe {
        REG = 11u32;
        print_int(flag(static_addr(REG) == base + 0x100) as i64);
        print(" ");
        print_int(flag(addr_of(SLOT) == base + 0x200) as i64);
        print(" ");
        print_int(flag(static_addr(REG) != static_addr(SLOT)) as i64);
        print(" ");
        print_int(REG as i64);
        print(" ");
        print_int(SLOT as i64);
        print(" ");
        print_int(flag(addr_of(REG) - base == 0x100usize) as i64);
    }
    print("\n");
    0
}
