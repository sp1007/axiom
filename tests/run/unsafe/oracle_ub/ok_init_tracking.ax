// test: run
// modes: interp native
// stdout: 36 36 7 1 2 3 4 5 6 7 8\n
// T502 (UB-04 negative): the uninitialized-read detector never fires on initialized heap bytes. A block written element by element,
// by `ptr_write_bytes`, by `ptr_copy_nonoverlapping` or kept across `heap_realloc` reads back without a diagnostic.

use std.core.host.heap_alloc
use std.core.host.heap_free
use std.core.host.heap_realloc

@intrinsic unsafe fn ptr_write_bytes<T>(dst: *mut T, val: u8, count: usize) {}
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub fn main() -> i32 {
    unsafe {
        // element by element
        let p: *mut u8 = heap_alloc(8, 8);
        let mut i: usize = 0;
        while i < 8 {
            *(p + i) = (i + 1) as u8;
            i = i + 1;
        }
        let mut sum: i32 = 0;
        i = 0;
        while i < 8 {
            sum = sum + (*(p + i)) as i32;
            i = i + 1;
        }
        // grown block keeps the prefix
        let q: *mut u8 = heap_realloc(p, 8, 32, 8);
        let mut sum2: i32 = 0;
        i = 0;
        while i < 8 {
            sum2 = sum2 + (*(q + i)) as i32;
            i = i + 1;
        }
        // memset makes the whole block readable as one word
        let z: *mut u64 = heap_alloc(16, 8) as *mut u64;
        ptr_write_bytes<u8>(z as *mut u8, 7u8, 16);
        let w: u64 = *(z + 1usize);
        // a raw byte copy initializes its destination
        let c: *mut u8 = heap_alloc(8, 8);
        ptr_copy_nonoverlapping<u8>(q as *const u8, c, 8);
        print_int(sum as i64);
        print(" ");
        print_int(sum2 as i64);
        print(" ");
        print_int((w & 0xFFu64) as i64);
        i = 0;
        while i < 8 {
            print(" ");
            print_int((*(c + i)) as i64);
            i = i + 1;
        }
        heap_free(c, 8, 8);
        heap_free(z as *mut u8, 16, 8);
        heap_free(q, 32, 8);
    }
    print("\n");
    0
}
