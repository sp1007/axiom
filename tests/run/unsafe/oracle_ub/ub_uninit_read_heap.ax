// test: run
// modes: interp
// reason: oracle-only check
// exit: 125
// stderr-contains: AX_UNSAFE_INTERP_UB
// stderr-contains: uninitialized memory
// T502 (UB-04): a typed load from a freshly allocated block whose bytes were never written.

use std.core.host.heap_alloc

pub fn main() -> i32 {
    let p: *mut u32 = unsafe { heap_alloc(16, 8) as *mut u32 };
    let v: u32 = unsafe { *p };
    v as i32
}
