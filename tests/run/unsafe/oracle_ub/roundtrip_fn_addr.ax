// test: run
// modes: interp native
// native-after: T504
// stdout: 1 1 1 1 1 1 1 42\n
// T502 (REQ-OWNER-008, SPEC-50 AXS-UNS-021/025): `@addr(A) fn` round trip. `fn_addr(isr)`, `addr_of(isr)`, `isr as usize` and the
// cast of a function-pointer value all equal A; ordinary functions get distinct, deterministic non-zero code addresses; the
// placed function stays directly callable.

@intrinsic fn fn_addr<F>(f: F) -> usize { 0 }
@intrinsic fn addr_of<T>(x: T) -> usize { 0 }

@addr(0x2000_0000) unsafe fn isr() -> i32 {
    42
}

fn plain() -> i32 {
    7
}

fn other() -> i32 {
    8
}

fn flag(b: bool) -> i32 {
    if b { 1 } else { 0 }
}

pub fn main() -> i32 {
    let a: usize = fn_addr(isr);
    let b: usize = addr_of(isr);
    let c: usize = isr as usize;
    let fp: unsafe fn() -> i32 = isr;
    let d: usize = fp as usize;
    let p: usize = fn_addr(plain);
    let o: usize = fn_addr(other);

    print_int(flag(a == 0x2000_0000usize) as i64);
    print(" ");
    print_int(flag(b == a) as i64);
    print(" ");
    print_int(flag(c == a) as i64);
    print(" ");
    print_int(flag(d == a) as i64);
    print(" ");
    print_int(flag(p != o && p != 0usize && o != 0usize && p != a && o != a) as i64);
    print(" ");
    print_int(flag(p == fn_addr(plain) && p == (plain as usize)) as i64);
    print(" ");
    print_int(flag((a as u64) == 536870912u64) as i64);
    print(" ");
    print_int(unsafe { isr() } as i64);
    print("\n");
    0
}
