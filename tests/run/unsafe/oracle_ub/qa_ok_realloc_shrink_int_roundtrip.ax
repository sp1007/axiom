// test: run
// modes: interp native
// stdout: 5 8 77 21\n
// QA T502 (negative): shrinking realloc keeps the initialised prefix; the tail of a grown block is written before it is read; a pointer
// that goes through `as usize` and back to a pointer inside the same live block keeps its provenance (exposed provenance), also for
// an interior address.

use std.core.host.heap_alloc
use std.core.host.heap_free
use std.core.host.heap_realloc

pub fn main() -> i32 {
    unsafe {
        let p: *mut u32 = heap_alloc(16, 4) as *mut u32;
        *p = 5u32;
        *(p + 1usize) = 8u32;
        *(p + 2usize) = 1u32;
        *(p + 3usize) = 2u32;
        let q: *mut u32 = heap_realloc(p as *mut u8, 16, 8, 4) as *mut u32;
        let a: u32 = *q;
        let b: u32 = *(q + 1usize);
        // grow again and initialise only the new tail before reading it
        let r: *mut u32 = heap_realloc(q as *mut u8, 8, 24, 4) as *mut u32;
        *(r + 2usize) = 77u32;
        let c: u32 = *(r + 2usize);
        // integer round trip into the interior of the block
        let base: usize = r as usize;
        let inner: *mut u32 = (base + 12usize) as *mut u32;
        *inner = 21u32;
        let d: u32 = *(r + 3usize);
        print_int(a as i64);
        print(" ");
        print_int(b as i64);
        print(" ");
        print_int(c as i64);
        print(" ");
        print_int(d as i64);
        heap_free(r as *mut u8, 24, 4);
    }
    print("\n");
    0
}
