// test: run
// modes: interp
// reason: oracle-only check
// exit: 125
// stderr-contains: AX_UNSAFE_INTERP_UB
// stderr-contains: uninitialized memory
// T502 round 1 (UB-04): padding is exempt, but a real field of a nested struct (`inner.b`) that was never written still is an
// uninitialized read when the whole struct is loaded.

use std.core.host.heap_alloc

@repr(C)
struct Inner {
    a: u8,
    b: u32,
}

@repr(C)
struct Outer {
    x: u8,
    inner: Inner,
    y: u64,
}

pub fn main() -> i32 {
    unsafe {
        let raw: *mut u8 = heap_alloc(24, 8);
        *raw = 1u8;
        *(raw + 4usize) = 2u8;
        *((raw + 16usize) as *mut u64) = 4u64;
        let o: Outer = *(raw as *mut Outer);
        return o.x as i32;
    }
}
