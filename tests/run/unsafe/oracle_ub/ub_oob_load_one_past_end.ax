// test: run
// modes: interp
// reason: oracle-only check
// exit: 125
// stderr-contains: AX_UNSAFE_INTERP_UB
// stderr-contains: out-of-bounds pointer access
// T502 (UB-02): the one-past-the-end pointer may be formed (`p + 4`) but not dereferenced.

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

pub fn main() -> i32 {
    let buf: [4]u32 = [1u32, 2u32, 3u32, 4u32];
    let p: *const u32 = unsafe { address_of(buf[0]) };
    let end: *const u32 = unsafe { p + 4usize };
    let v: u32 = unsafe { *end };
    v as i32
}
