// test: run
// modes: interp
// reason: oracle-only check
// exit: 125
// stderr-contains: AX_UNSAFE_INTERP_UB
// stderr-contains: invalid fixed address
// T502 (UB-12, SPEC-50 AXS-UNS-024): a dynamic `@addr(E)` address is checked when it is bound; `u32` needs `E % 4 == 0`.

@intrinsic fn static_addr<S>(s: S) -> usize { 0 }

static mut BUF: [4]u32 = [1u32, 2u32, 3u32, 4u32];

pub fn main() -> i32 {
    let base: usize = static_addr(BUF);
    @addr(base + 1) unsafe static mut BAD: u32;
    unsafe {
        BAD = 1u32;
    }
    0
}
