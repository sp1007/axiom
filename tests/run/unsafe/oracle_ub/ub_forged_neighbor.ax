// test: run
// modes: interp
// reason: oracle-only check
// exit: 125
// stderr-contains: AX_UNSAFE_INTERP_UB
// stderr-contains: invalid provenance
// T502 (UB-01): an address computed from the exposed address of one local, but pointing between allocations, is forged.

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

pub fn main() -> i32 {
    let x: u32 = 5u32;
    let ax: usize = unsafe { address_of(x) } as usize;
    let py: *const u32 = (ax + 4096usize) as *const u32;
    let v: u32 = unsafe { *py };
    v as i32
}
