// test: run
// modes: interp native
// stdout: 10 20 3 4 5 9\n
// QA T502 (UB-07 negative): a `static mut` aggregate and a mutable local copy of a `const` aggregate are ordinary writable memory.
// Writing through raw pointers derived from them must not be reported as a write to read-only memory (constant pools are read-only,
// but only the constant itself).

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

const BASE: [4]u32 = [1u32, 2u32, 3u32, 4u32];

static mut TABLE: [4]u32 = [1u32, 2u32, 3u32, 4u32];

pub fn main() -> i32 {
    let mut local: [4]u32 = BASE;
    unsafe {
        let p: *mut u32 = address_of_mut(TABLE) as *mut u32;
        *p = 10u32;
        *(p + 1usize) = 20u32;
        let q: *mut u32 = address_of_mut(local) as *mut u32;
        *(q + 3usize) = 9u32;
        *(q + 2usize) = BASE[3] + 1u32;
    }
    unsafe {
        print_int(TABLE[0] as i64);
        print(" ");
        print_int(TABLE[1] as i64);
        print(" ");
        print_int(TABLE[2] as i64);
        print(" ");
        print_int(TABLE[3] as i64);
    }
    print(" ");
    print_int(local[2] as i64);
    print(" ");
    print_int(local[3] as i64);
    print("\n");
    0
}
