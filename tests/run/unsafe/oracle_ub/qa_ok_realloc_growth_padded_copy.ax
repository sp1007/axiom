// test: run
// modes: interp native
// stdout: 7 9 5 6 7 9 5 6 7 9\n
// QA T502 round 1 (UB-04 negative): realloc growth of a block of padded structs, then a typed load of the whole `[2]P`, a raw byte copy
// of the grown block into new storage, and a typed whole-struct copy out of it. Element 0 survives the growth (padding uninitialized),
// element 1 is written after it; no padding byte is ever read as a value.

use std.core.host.heap_alloc
use std.core.host.heap_free
use std.core.host.heap_realloc

@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

@repr(C)
struct P {
    a: u8,
    b: u64,
}

pub fn main() -> i32 {
    unsafe {
        let r0: *mut u8 = heap_alloc(16, 8);
        *r0 = 7u8;
        *((r0 + 8usize) as *mut u64) = 9u64;
        let r: *mut u8 = heap_realloc(r0, 16, 32, 8);
        *(r + 16usize) = 5u8;
        *((r + 24usize) as *mut u64) = 6u64;
        let arr: [2]P = *(r as *mut [2]P);
        let cp: *mut u8 = heap_alloc(32, 8);
        ptr_copy_nonoverlapping<u8>(r as *const u8, cp, 32);
        let arr2: [2]P = *(cp as *mut [2]P);
        let one: *mut u8 = heap_alloc(16, 8);
        *(one as *mut P) = *(r as *mut P);
        let p0: P = *(one as *mut P);
        print_int(arr[0].a as i64);
        print(" ");
        print_int(arr[0].b as i64);
        print(" ");
        print_int(arr[1].a as i64);
        print(" ");
        print_int(arr[1].b as i64);
        print(" ");
        print_int(arr2[0].a as i64);
        print(" ");
        print_int(arr2[0].b as i64);
        print(" ");
        print_int(arr2[1].a as i64);
        print(" ");
        print_int(arr2[1].b as i64);
        print(" ");
        print_int(p0.a as i64);
        print(" ");
        print_int(p0.b as i64);
        heap_free(one, 16, 8);
        heap_free(cp, 32, 8);
        heap_free(r, 32, 8);
    }
    print("\n");
    0
}
