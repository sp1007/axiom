// test: run
// modes: interp
// reason: oracle-only check
// exit: 125
// stderr-contains: AX_UNSAFE_INTERP_UB
// stderr-contains: out of allocation bounds
// T502 (UB-02): `p + n` must stay inside `[base, base + size]` of the allocation `p` derives from.

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

pub fn main() -> i32 {
    let buf: [4]u32 = [1u32, 2u32, 3u32, 4u32];
    let p: *const u32 = unsafe { address_of(buf[0]) };
    let q: *const u32 = unsafe { p + 6usize };
    let _ = q;
    0
}
