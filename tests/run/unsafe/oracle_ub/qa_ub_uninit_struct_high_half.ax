// test: run
// modes: interp
// reason: oracle-only check
// exit: 125
// stderr-contains: AX_UNSAFE_INTERP_UB
// stderr-contains: uninitialized memory
// QA T502 (UB-04 positive): only the low u32 of a padding-free {u32,u32} struct is written (through a u32 pointer); the whole-struct
// load reads four uninitialized bytes.

use std.core.host.heap_alloc

struct Pair {
    a: u32,
    b: u32,
}

pub fn main() -> i32 {
    unsafe {
        let raw: *mut u8 = heap_alloc(8, 4);
        *(raw as *mut u32) = 4u32;
        let s: Pair = *(raw as *mut Pair);
        return s.a as i32;
    }
}
