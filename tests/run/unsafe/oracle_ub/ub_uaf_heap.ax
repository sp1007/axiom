// test: run
// modes: interp
// reason: oracle-only check
// exit: 125
// stderr-contains: AX_UNSAFE_INTERP_UB
// stderr-contains: use-after-free
// T502 (SPEC-50 AXS-UNS-015 UB-01): a load through a pointer into a heap block after `heap_free` is use-after-free.

use std.core.host.heap_alloc
use std.core.host.heap_free

pub fn main() -> i32 {
    let p: *mut u32 = unsafe { heap_alloc(16, 8) as *mut u32 };
    unsafe {
        *p = 41u32;
        heap_free(p as *mut u8, 16, 8);
        let v: u32 = *p;
        return v as i32;
    }
}
