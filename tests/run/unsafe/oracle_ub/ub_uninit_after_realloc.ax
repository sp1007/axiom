// test: run
// modes: interp
// reason: oracle-only check
// exit: 125
// stderr-contains: AX_UNSAFE_INTERP_UB
// stderr-contains: uninitialized memory
// T502 (UB-04): `heap_realloc` keeps the byte state of the copied prefix; the grown tail is uninitialized.

use std.core.host.heap_alloc
use std.core.host.heap_realloc

pub fn main() -> i32 {
    let p: *mut u8 = unsafe { heap_alloc(8, 8) };
    unsafe {
        let mut i: usize = 0;
        while i < 8 {
            *(p + i) = (i + 1) as u8;
            i = i + 1;
        }
        let q: *mut u8 = heap_realloc(p, 8, 24, 8);
        let kept: u8 = *(q + 7usize);
        let grown: u8 = *(q + 8usize);
        return (kept + grown) as i32;
    }
}
