// test: run
// modes: interp
// reason: oracle-only check
// exit: 125
// stderr-contains: AX_UNSAFE_INTERP_UB
// stderr-contains: use-after-free
// T502 (UB-01): a raw pointer to a local outlives the call frame (`StorageDead`); loading through it is dangling.

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

fn leak() -> *const u32 {
    let x: u32 = 7u32;
    unsafe { address_of(x) }
}

pub fn main() -> i32 {
    let p: *const u32 = leak();
    let v: u32 = unsafe { *p };
    v as i32
}
