// test: run
// modes: interp native
// native-after: T504
// stdout: 4660 4660 1 17\n
// T502 (SPEC-50 AXS-UNS-023, ADR-0001 §2): two overlays of one address share storage; a narrower overlay inside a wider one reads
// the same bytes (little endian); a raw pointer derived from one overlay sees writes through the other.

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

@addr(0x2000_0400) unsafe static mut WORD: u32;
@addr(0x2000_0400) unsafe static mut LOW: u16;
@addr(0x2000_0400) unsafe static mut ALIAS: u32;

fn flag(b: bool) -> i32 {
    if b { 1 } else { 0 }
}

pub fn main() -> i32 {
    unsafe {
        WORD = 0x0001_1234u32;
        print_int(LOW as i64);
        print(" ");
        print_int((ALIAS & 0xFFFFu32) as i64);
        print(" ");
        let p: *mut u32 = address_of_mut(ALIAS);
        *p = 0x0000_0011u32;
        print_int(flag(WORD == 17u32) as i64);
        print(" ");
        print_int(WORD as i64);
    }
    print("\n");
    0
}
