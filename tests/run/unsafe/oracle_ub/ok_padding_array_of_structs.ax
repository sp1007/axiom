// test: run
// modes: interp native
// stdout: 66 66 3\n
// T502 round 1 (UB-04 negative): an array of `@repr(C)` structs with padding (`{ a: u8, b: u32 }`, size 8). Each element's two fields are
// written; the 3 padding bytes after `a` of every element stay uninitialized. Loading the whole `[3]E` array, copying it to another
// block and reading elements through the copy never trap.

use std.core.host.heap_alloc
use std.core.host.heap_free

@repr(C)
struct E {
    a: u8,
    b: u32,
}

pub fn main() -> i32 {
    unsafe {
        let raw: *mut u8 = heap_alloc(24, 8);
        let mut i: usize = 0;
        while i < 3 {
            *(raw + i * 8usize) = (i + 1) as u8;
            *((raw + i * 8usize + 4usize) as *mut u32) = ((i + 1) * 10) as u32;
            i = i + 1;
        }
        let arr: [3]E = *(raw as *mut [3]E);
        let dst_raw: *mut u8 = heap_alloc(24, 8);
        *(dst_raw as *mut [3]E) = *(raw as *mut [3]E);
        let c: *mut E = dst_raw as *mut E;
        let s1: u32 = (arr[0].a as u32) + arr[0].b + (arr[1].a as u32) + arr[1].b + (arr[2].a as u32) + arr[2].b;
        let e2: E = *(c + 2usize);
        let s2: u32 = ((*c).a as u32) + (*c).b + ((*(c + 1usize)).a as u32) + (*(c + 1usize)).b + (e2.a as u32) + e2.b;
        print_int(s1 as i64);
        print(" ");
        print_int(s2 as i64);
        print(" ");
        print_int(e2.a as i64);
        heap_free(dst_raw, 24, 8);
        heap_free(raw, 24, 8);
    }
    print("\n");
    0
}
