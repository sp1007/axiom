// test: run
// modes: interp
// reason: oracle-only check
// exit: 125
// stderr-contains: AX_UNSAFE_INTERP_UB
// stderr-contains: use-after-free
// T502 (UB-01 / UB-10): freeing a block twice is a use of a dangling pointer.

use std.core.host.heap_alloc
use std.core.host.heap_free

pub fn main() -> i32 {
    let p: *mut u8 = unsafe { heap_alloc(32, 8) };
    unsafe {
        heap_free(p, 32, 8);
        heap_free(p, 32, 8);
    }
    0
}
