// test: run
// modes: interp
// reason: oracle-only check
// exit: 125
// stderr-contains: AX_UNSAFE_INTERP_UB
// stderr-contains: invalid provenance
// T502 (UB-01 / UB-07, SPEC-50 AXS-UNS-021): a function's code address is an identity; the code bytes cannot be read as data.

@intrinsic fn fn_addr<F>(f: F) -> usize { 0 }

fn target() -> i32 {
    1
}

pub fn main() -> i32 {
    let code: *const u8 = fn_addr(target) as *const u8;
    let b: u8 = unsafe { *code };
    b as i32
}
