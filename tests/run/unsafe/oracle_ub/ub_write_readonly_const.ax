// test: run
// modes: interp
// reason: oracle-only check
// exit: 125
// stderr-contains: AX_UNSAFE_INTERP_UB
// stderr-contains: read-only memory
// T502 (UB-07, SPEC-50 AXS-UNS-011): a `*mut` derived from a `*const` into a constant table has `ReadOnly` provenance; storing
// through it is undefined behavior.

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

const TABLE: [4]u32 = [1u32, 2u32, 3u32, 4u32];

pub fn main() -> i32 {
    let p: *mut u32 = unsafe { address_of(TABLE[1]) } as *mut u32;
    unsafe {
        *p = 9u32;
    }
    0
}
