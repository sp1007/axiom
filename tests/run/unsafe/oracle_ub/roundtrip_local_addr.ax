// test: run
// modes: interp native
// stdout: 1 1 1 55 56 56 1\n
// T502 (REQ-OWNER-008, SPEC-50 AXS-UNS-023/025): `@addr(E) let mut` overlays a local on a live object. The binding aliases the
// storage at `E` (here the second word of a stack buffer), so `address_of(v) as usize == E` and writes through the binding
// and through the buffer agree.

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic fn addr_of<T>(x: T) -> usize { 0 }

fn flag(b: bool) -> i32 {
    if b { 1 } else { 0 }
}

pub fn main() -> i32 {
    let mut backing: [4]u32 = [10u32, 20u32, 30u32, 40u32];
    let buf_base: usize = unsafe { address_of_mut(backing[0]) } as usize;
    unsafe {
        @addr(buf_base + 4) let mut header: u32 = 55u32;
        print_int(flag(addr_of(header) == buf_base + 4) as i64);
        print(" ");
        print_int(flag((address_of(header) as usize) == buf_base + 4) as i64);
        print(" ");
        print_int(flag(backing[1] == 55u32) as i64);
        print(" ");
        print_int(header as i64);
        header = header + 1u32;
        print(" ");
        print_int(header as i64);
        print(" ");
        print_int(backing[1] as i64);
        print(" ");
        print_int(flag(backing[0] == 10u32 && backing[2] == 30u32) as i64);
    }
    print("\n");
    0
}
