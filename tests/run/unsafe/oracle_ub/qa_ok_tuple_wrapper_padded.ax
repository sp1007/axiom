// test: run
// modes: interp native
// stdout: 7 9 5 6 7 9 5 6 7 9 5 6\n
// QA T502 round 1 (UB-04 negative): a struct of two padded structs (`W`) and a tuple of two padded structs. Fields of `W` are written at
// their byte offsets only; the tuple is block-copied in as bytes. A typed load, `*d1 = *s`, `*d2 = *d1` (padding already reset to
// uninitialized by the first copy) and reads of the fields never report the padding.

use std.core.host.heap_alloc
use std.core.host.heap_free

@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

@repr(C)
struct P {
    a: u8,
    b: u64,
}

@repr(C)
struct W {
    x: P,
    y: P,
}

pub fn main() -> i32 {
    unsafe {
        let raw: *mut u8 = heap_alloc(32, 8);
        *raw = 7u8;
        *((raw + 8usize) as *mut u64) = 9u64;
        *(raw + 16usize) = 5u8;
        *((raw + 24usize) as *mut u64) = 6u64;
        let w: W = *(raw as *mut W);
        let d1_raw: *mut u8 = heap_alloc(32, 8);
        *(d1_raw as *mut W) = *(raw as *mut W);
        let d2_raw: *mut u8 = heap_alloc(32, 8);
        *(d2_raw as *mut W) = *(d1_raw as *mut W);
        let c: W = *(d2_raw as *mut W);

        let t: (P, P) = (P { a: 7u8, b: 9u64 }, P { a: 5u8, b: 6u64 });
        let tb: *mut u8 = heap_alloc(32, 8);
        ptr_copy_nonoverlapping<u8>(address_of(t) as *const u8, tb, 32);
        let t1: *mut u8 = heap_alloc(32, 8);
        *(t1 as *mut (P, P)) = *(tb as *mut (P, P));
        let t2: *mut u8 = heap_alloc(32, 8);
        *(t2 as *mut (P, P)) = *(t1 as *mut (P, P));
        let tt: (P, P) = *(t2 as *mut (P, P));

        print_int(w.x.a as i64);
        print(" ");
        print_int(w.x.b as i64);
        print(" ");
        print_int(w.y.a as i64);
        print(" ");
        print_int(w.y.b as i64);
        print(" ");
        print_int(c.x.a as i64);
        print(" ");
        print_int(c.x.b as i64);
        print(" ");
        print_int(c.y.a as i64);
        print(" ");
        print_int(c.y.b as i64);
        print(" ");
        print_int(tt.0.a as i64);
        print(" ");
        print_int(tt.0.b as i64);
        print(" ");
        print_int(tt.1.a as i64);
        print(" ");
        print_int(tt.1.b as i64);
        heap_free(t2, 32, 8);
        heap_free(t1, 32, 8);
        heap_free(tb, 32, 8);
        heap_free(d2_raw, 32, 8);
        heap_free(d1_raw, 32, 8);
        heap_free(raw, 32, 8);
    }
    print("\n");
    0
}
