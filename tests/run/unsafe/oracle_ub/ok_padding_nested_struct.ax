// test: run
// modes: interp native
// stdout: 1 2 3 4 1 2 3 4\n
// T502 round 1 (UB-04 negative, SPEC-50 UB-04 row): a nested `@repr(C)` struct with padding at two levels. Only the real fields are
// written (`x` at 0, `inner.a` at 4, `inner.b` at 8, `y` at 16); the padding bytes 1..3, 5..7, 12..15 stay uninitialized. A typed load
// and a whole-struct copy read only the fields, and the copy keeps the padding uninitialized without trapping.

use std.core.host.heap_alloc
use std.core.host.heap_free

@repr(C)
struct Inner {
    a: u8,
    b: u32,
}

@repr(C)
struct Outer {
    x: u8,
    inner: Inner,
    y: u64,
}

pub fn main() -> i32 {
    unsafe {
        let raw: *mut u8 = heap_alloc(24, 8);
        *raw = 1u8;
        *(raw + 4usize) = 2u8;
        *((raw + 8usize) as *mut u32) = 3u32;
        *((raw + 16usize) as *mut u64) = 4u64;
        let o: Outer = *(raw as *mut Outer);
        let dst_raw: *mut u8 = heap_alloc(24, 8);
        *(dst_raw as *mut Outer) = *(raw as *mut Outer);
        let c: *mut Outer = dst_raw as *mut Outer;
        print_int(o.x as i64);
        print(" ");
        print_int(o.inner.a as i64);
        print(" ");
        print_int(o.inner.b as i64);
        print(" ");
        print_int(o.y as i64);
        print(" ");
        print_int((*c).x as i64);
        print(" ");
        print_int((*c).inner.a as i64);
        print(" ");
        print_int((*c).inner.b as i64);
        print(" ");
        print_int((*c).y as i64);
        heap_free(dst_raw, 24, 8);
        heap_free(raw, 24, 8);
    }
    print("\n");
    0
}
