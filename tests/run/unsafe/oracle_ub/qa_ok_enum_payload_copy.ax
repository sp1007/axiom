// test: run
// modes: interp native
// stdout: 3 9 5 1 2 4\n
// QA T502 round 1 (UB-04 negative): enums with payload are copied whole through raw pointers without a report: a typed load, a
// whole-enum store `*dst = *src`, a struct that contains an enum, and an array of enums built element by element.

use std.core.host.heap_alloc
use std.core.host.heap_free

@copy
enum E {
    Big(u64),
    Small(u8),
}

struct Wrap {
    tag: u8,
    e: E,
}

fn val(e: E) -> u64 {
    match e {
        E.Big(x) => x,
        E.Small(y) => y as u64,
    }
}

pub fn main() -> i32 {
    unsafe {
        let p: *mut E = heap_alloc(16, 8) as *mut E;
        *p = E.Small(3u8);
        let e1: E = *p;
        let q: *mut E = heap_alloc(16, 8) as *mut E;
        *q = *p;
        let e2: E = *q;
        *p = E.Big(9u64);
        let e3: E = *p;

        let w: *mut Wrap = heap_alloc(32, 8) as *mut Wrap;
        (*w).tag = 5u8;
        (*w).e = E.Small(1u8);
        let w2: *mut Wrap = heap_alloc(32, 8) as *mut Wrap;
        *w2 = *w;
        let w3: Wrap = *w2;

        let arr: *mut [3]E = heap_alloc(48, 8) as *mut [3]E;
        let ep: *mut E = arr as *mut E;
        *ep = E.Big(2u64);
        *(ep + 1usize) = E.Small(4u8);
        *(ep + 2usize) = E.Big(7u64);
        let _whole: [3]E = *arr;
        let a0: E = *ep;
        let a1: E = *(ep + 1usize);

        print_int(val(e1) as i64);
        print(" ");
        print_int(val(e3) as i64);
        print(" ");
        print_int(w3.tag as i64);
        print(" ");
        print_int(val(w3.e) as i64);
        print(" ");
        print_int(val(a0) as i64);
        print(" ");
        print_int(val(a1) as i64);
        heap_free(arr as *mut u8, 48, 8);
        heap_free(w2 as *mut u8, 32, 8);
        heap_free(w as *mut u8, 32, 8);
        heap_free(q as *mut u8, 16, 8);
        heap_free(p as *mut u8, 16, 8);
        if val(e2) != 3u64 {
            return 1;
        }
    }
    print("\n");
    0
}
