// test: run
// modes: interp
// reason: oracle-only check
// exit: 125
// stderr-contains: AX_UNSAFE_INTERP_UB
// stderr-contains: uninitialized memory
// QA T502 round 1 (UB-04 positive): after a typed whole-struct copy the destination padding is uninitialized again; reading a
// padding byte as a u8 value must report it.

use std.core.host.heap_alloc

@repr(C)
struct P {
    a: u8,
    b: u64,
}

pub fn main() -> i32 {
    unsafe {
        let r: *mut u8 = heap_alloc(16, 8);
        *r = 7u8;
        *((r + 8usize) as *mut u64) = 9u64;
        let d: *mut u8 = heap_alloc(16, 8);
        *(d as *mut P) = *(r as *mut P);
        let pad: u8 = *(d + 3usize);
        return pad as i32;
    }
}
