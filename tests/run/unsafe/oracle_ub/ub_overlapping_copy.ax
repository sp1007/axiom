// test: run
// modes: interp
// reason: oracle-only check
// exit: 125
// stderr-contains: AX_UNSAFE_INTERP_UB
// stderr-contains: overlapping
// T502 (UB-09): `ptr_copy_nonoverlapping` over overlapping ranges.

use std.core.host.heap_alloc

@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}

pub fn main() -> i32 {
    let p: *mut u8 = unsafe { heap_alloc(32, 8) };
    unsafe {
        let mut i: usize = 0;
        while i < 32 {
            *(p + i) = i as u8;
            i = i + 1;
        }
        ptr_copy_nonoverlapping<u8>(p as *const u8, p + 4usize, 16);
    }
    0
}
