// test: run
// modes: interp
// reason: oracle-only check
// exit: 125
// stderr-contains: AX_UNSAFE_INTERP_UB
// stderr-contains: out-of-bounds pointer access
// T502 (UB-02): an 8-byte store at offset 8 of a 12-byte block ends past it.

use std.core.host.heap_alloc

pub fn main() -> i32 {
    let p: *mut u8 = unsafe { heap_alloc(12, 8) };
    unsafe {
        let tail: *mut u64 = (p + 8usize) as *mut u64;
        *tail = 1u64;
    }
    0
}
