// test: run
// modes: interp
// reason: oracle-only check
// exit: 125
// stderr-contains: AX_UNSAFE_INTERP_UB
// stderr-contains: uninitialized memory
// QA T502 round 1 (UB-04 positive): in a block holding [2]P the second element has field b never written; the whole-array load
// must report it.

use std.core.host.heap_alloc

@repr(C)
struct P {
    a: u8,
    b: u64,
}

pub fn main() -> i32 {
    unsafe {
        let r: *mut u8 = heap_alloc(32, 8);
        *r = 7u8;
        *((r + 8usize) as *mut u64) = 9u64;
        *(r + 16usize) = 5u8;
        let arr: [2]P = *(r as *mut [2]P);
        return arr[0].a as i32;
    }
}
