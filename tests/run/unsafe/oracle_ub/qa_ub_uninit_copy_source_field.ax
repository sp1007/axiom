// test: run
// modes: interp
// reason: oracle-only check
// exit: 125
// stderr-contains: AX_UNSAFE_INTERP_UB
// stderr-contains: uninitialized memory
// QA T502 round 1 (UB-04 positive): the source struct of a whole-struct copy has field b unwritten; the copy must report it
// (padding is exempt, a real field is not).

use std.core.host.heap_alloc

@repr(C)
struct P {
    a: u8,
    b: u64,
}

pub fn main() -> i32 {
    unsafe {
        let r: *mut u8 = heap_alloc(16, 8);
        *r = 7u8;
        let d: *mut u8 = heap_alloc(16, 8);
        *(d as *mut P) = *(r as *mut P);
        return 0;
    }
}
