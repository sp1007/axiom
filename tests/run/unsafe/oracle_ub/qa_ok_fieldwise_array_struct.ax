// test: run
// modes: interp native
// stdout: 6 10 3 7\n
// QA T502 (UB-04 negative): aggregates built piecewise through raw pointers are readable as a whole once every byte was written:
// an array built element by element, a struct built field by field (no padding) and a struct with a nested array.

use std.core.host.heap_alloc
use std.core.host.heap_free

struct Pair {
    a: u32,
    b: u32,
}

struct Holder {
    n: u32,
    arr: [2]u32,
}

pub fn main() -> i32 {
    unsafe {
        let ap: *mut [4]u32 = heap_alloc(16, 4) as *mut [4]u32;
        (*ap)[0] = 1u32;
        (*ap)[1] = 2u32;
        (*ap)[2] = 3u32;
        (*ap)[3] = 4u32;
        let whole: [4]u32 = *ap;
        let s1: u32 = whole[0] + whole[1] + whole[2] - 0u32;

        let pp: *mut Pair = heap_alloc(8, 4) as *mut Pair;
        (*pp).a = 4u32;
        (*pp).b = 6u32;
        let pair: Pair = *pp;

        let hp: *mut Holder = heap_alloc(12, 4) as *mut Holder;
        (*hp).n = 3u32;
        (*hp).arr[0] = 3u32;
        (*hp).arr[1] = 4u32;
        let h: Holder = *hp;

        print_int(s1 as i64);
        print(" ");
        print_int((pair.a + pair.b) as i64);
        print(" ");
        print_int(h.n as i64);
        print(" ");
        print_int((h.arr[0] + h.arr[1]) as i64);
        heap_free(hp as *mut u8, 12, 4);
        heap_free(pp as *mut u8, 8, 4);
        heap_free(ap as *mut u8, 16, 4);
    }
    print("\n");
    0
}
