// test: run
// modes: interp native
// native-after: T504
// stdout: 1 1 1 7 9 1 1\n
// T502 (REQ-OWNER-008, SPEC-50 AXS-UNS-023/025): item-scope `@addr(A) unsafe static mut` with constant addresses outside every
// live object. The oracle maps `[A, A + size_of::<T>())` on demand; reads and writes work; `static_addr(S) == A`,
// `addr_of(S) == A` and `address_of(S) as usize == A`; a field address is inside the overlay; a raw pointer derived from the
// overlay reads and writes the same bytes.

@intrinsic fn static_addr<S>(s: S) -> usize { 0 }
@intrinsic fn addr_of<T>(x: T) -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

@repr(C)
struct Uart {
    pub ctrl: u32,
    pub data: u32,
}

@addr(0x2000_0100) unsafe static mut REG: u32;
@at(0x2000_0200) unsafe static mut UART: Uart;

fn flag(b: bool) -> i32 {
    if b { 1 } else { 0 }
}

pub fn main() -> i32 {
    let a: bool = static_addr(REG) == 0x2000_0100usize;
    let b: bool = addr_of(UART) == 0x2000_0200usize;
    let c: bool = unsafe { address_of(REG) as usize } == 0x2000_0100usize;
    unsafe {
        let d: bool = addr_of(UART.data) == 0x2000_0204usize;
        REG = 7u32;
        UART.ctrl = 2u32;
        UART.data = UART.ctrl + 7u32;
        let p: *mut u32 = address_of_mut(REG);
        print_int(flag(a && b && c && d) as i64);
        print(" ");
        print_int(flag(*p == 7u32) as i64);
        print(" ");
        *p = *p + 0u32;
        print_int(flag(REG == 7u32) as i64);
        print(" ");
        print_int(REG as i64);
        print(" ");
        print_int(UART.data as i64);
        print(" ");
        print_int(flag(UART.ctrl == 2u32) as i64);
        print(" ");
        print_int(flag(addr_of(REG) == static_addr(REG)) as i64);
    }
    print("\n");
    0
}
