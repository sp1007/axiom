// test: run
// modes: interp
// reason: oracle-only check
// exit: 125
// stderr-contains: AX_UNSAFE_INTERP_UB
// stderr-contains: misaligned pointer access
// T502 (UB-03): a typed `u32` load at an address that is not a multiple of 4.

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

pub fn main() -> i32 {
    let buf: [8]u8 = [1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8];
    let p: *const u8 = unsafe { address_of(buf[0]) };
    let w: u32 = unsafe { *((p + 1usize) as *const u32) };
    w as i32
}
