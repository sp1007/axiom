// test: run
// modes: interp
// reason: oracle-only check
// exit: 125
// stderr-contains: AX_UNSAFE_INTERP_UB
// stderr-contains: uninitialized memory
// T502 (UB-04): element 0 and 1 are written; element 2 of the same block is still uninitialized.

use std.core.host.heap_alloc

pub fn main() -> i32 {
    let p: *mut u32 = unsafe { heap_alloc(16, 8) as *mut u32 };
    unsafe {
        *p = 1u32;
        *(p + 1usize) = 2u32;
        let a: u32 = *p;
        let b: u32 = *(p + 1usize);
        let c: u32 = *(p + 2usize);
        return (a + b + c) as i32;
    }
}
