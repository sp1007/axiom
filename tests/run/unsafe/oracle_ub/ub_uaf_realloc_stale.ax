// test: run
// modes: interp
// reason: oracle-only check
// exit: 125
// stderr-contains: AX_UNSAFE_INTERP_UB
// stderr-contains: use-after-free
// T502 (UB-01): `heap_realloc` retires the old block; a pointer into it that is kept and stored through is dangling.

use std.core.host.heap_alloc
use std.core.host.heap_realloc

pub fn main() -> i32 {
    let old: *mut u8 = unsafe { heap_alloc(16, 8) };
    unsafe {
        *old = 1u8;
        let grown: *mut u8 = heap_realloc(old, 16, 64, 8);
        *grown = 2u8;
        *old = 3u8;
    }
    0
}
