// test: run
// exit: 0
// modes: interp
// native-after: T028
fn main() -> i32 {
    let a: i32 = -16;
    let b: i32 = a >> 2;
    if b != -4 { return 1; }
    
    let c: u32 = 0xFFFFFFF0;
    let d: u32 = c >> 2;
    if d != 0x3FFFFFFC { return 2; }
    
    let e: i32 = 1;
    let f = e << 4;
    if f != 16 { return 3; }
    
    return 0;
}
