// test: run
// modes: interp native
// stdout: 0\n2\n1\n3\n

module mod_a

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct StrRepr {
    ptr: *const u8,
    len: usize,
}

pub fn emit_digit_a(d: u8) {
    let buf: [2]u8 = [48u8 + d, 10u8];
    let v: view<[2]u8> = view(buf);
    let p: *const u8 = unsafe { *(address_of(v) as *const *const u8) };
    let repr = StrRepr { ptr: p, len: 2 };
    let s: str = unsafe { *(address_of(repr) as *const str) };
    print(s);
}

pub struct Helper {
    pub id: u8,
}

impl Drop for Helper {
    fn drop(self: mut_view<Self>) {
        emit_digit_a(self.id);
    }
}

module mod_b

use mod_a.emit_digit_a

pub struct Helper {
    pub id: u8,
}

impl Drop for Helper {
    fn drop(self: mut_view<Self>) {
        emit_digit_a(self.id);
    }
}

module main

use mod_a
use mod_b
use mod_a.emit_digit_a

pub fn main() -> i32 {
    {
        let a = mod_a.Helper { id: 1u8 };
        let b = mod_b.Helper { id: 2u8 };
        emit_digit_a(0u8);
    }
    emit_digit_a(3u8);
    0
}
