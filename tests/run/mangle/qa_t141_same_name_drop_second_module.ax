// test: run
// modes: interp native
// stdout: 1\n2\n7\n
//
// T141 QA: two modules declare a struct with the same bare name `Res`; only the SECOND module's
// `Res` has `impl Drop`. The drop-impl lookup must match by symbol, not by bare name: mod_a.Res
// must never run mod_b's destructor. Expected output written by hand: mod_a.Res (no Drop) prints
// nothing when dropped; mod_b.Res prints its id (7) at scope end, after the explicit digits 1, 2.

module mod_a

pub struct Res {
    pub id: u8,
}

module mod_b

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct StrRepr {
    ptr: *const u8,
    len: usize,
}

pub fn emit_digit(d: u8) {
    let buf: [2]u8 = [48u8 + d, 10u8];
    let v: view<[2]u8> = view(buf);
    let p: *const u8 = unsafe { *(address_of(v) as *const *const u8) };
    let repr = StrRepr { ptr: p, len: 2 };
    let s: str = unsafe { *(address_of(repr) as *const str) };
    print(s);
}

pub struct Res {
    pub id: u8,
}

impl Drop for Res {
    fn drop(self: mut_view<Self>) {
        emit_digit(self.id);
    }
}

module main

use mod_a
use mod_b
use mod_b.emit_digit

pub fn main() -> i32 {
    {
        let b = mod_b.Res { id: 7u8 };
        let a = mod_a.Res { id: 5u8 };
        emit_digit(1u8);
        emit_digit(2u8);
    }
    0
}
