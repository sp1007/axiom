// test: run
// modes: interp native
// stdout: 7\n8\n4\n2\n5\n

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct StrRepr {
    ptr: *const u8,
    len: usize,
}

fn emit_digit(d: u8) {
    let buf: [2]u8 = [48u8 + d, 10u8];
    let v: view<[2]u8> = view(buf);
    let p: *const u8 = unsafe { *(address_of(v) as *const *const u8) };
    let repr = StrRepr { ptr: p, len: 2 };
    let s: str = unsafe { *(address_of(repr) as *const str) };
    print(s);
}

struct Foo {
    pub x: u8,
}

impl Drop for Foo {
    fn drop(self: mut_view<Self>) {
        emit_digit(self.x);
    }
}

fn Foo_drop() -> u8 {
    7u8
}

struct Alpha {
    pub v: u8,
}

impl Drop for Alpha {
    fn drop(self: mut_view<Self>) {
        emit_digit(self.v);
    }
}

struct Beta {
    pub v: u8,
}

impl Drop for Beta {
    fn drop(self: mut_view<Self>) {
        emit_digit(self.v);
    }
}

pub fn main() -> i32 {
    {
        let f_auto = Foo { x: 5u8 };
        let r = Foo_drop();
        emit_digit(r);

        let a = Alpha { v: 2u8 };
        let b = Beta { v: 4u8 };
        emit_digit((a.v + 1u8) + (b.v + 1u8));
    }
    0
}
