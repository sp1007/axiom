// test: run
// modes: interp native
// stdout: 7\n9\n3\n
//
// T141 round 1 (ADR-0034 section 6): a user function literally named `Widget_drop`, with the same
// signature as the destructor of `impl Drop for Widget`, is called explicitly and must stay
// distinct from the destructor (symbol `Widget$drop`); `tests/run/mangle/drop_symbols.test` checks
// the object's symbol table for this program. Expected output written by hand:
//   Widget_drop(mut_view(w)) prints 7 and sets w.id = 3; 9 printed; scope end runs the
//   destructor once, printing w.id = 3.

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

struct StrRepr {
    ptr: *const u8,
    len: usize,
}

fn emit_digit(d: u8) {
    let buf: [2]u8 = [48u8 + d, 10u8];
    let v: view<[2]u8> = view(buf);
    let p: *const u8 = unsafe { *(address_of(v) as *const *const u8) };
    let repr = StrRepr { ptr: p, len: 2 };
    let s: str = unsafe { *(address_of(repr) as *const str) };
    print(s);
}

struct Widget {
    pub id: u8,
}

impl Drop for Widget {
    fn drop(self: mut_view<Self>) {
        emit_digit(self.id);
    }
}

fn Widget_drop(w: mut_view<Widget>) {
    emit_digit(7u8);
    w.id = 3u8;
}

pub fn main() -> i32 {
    {
        let mut w = Widget { id: 1u8 };
        Widget_drop(mut_view(w));
        emit_digit(9u8);
    }
    0
}
