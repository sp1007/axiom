// test: run
// modes: interp native
// stdout-file: cache_corruption_and_version_eviction.stdout
// T758 / E18.2: Versioned & checksummed `.axcache` validation (`AXIC_MAGIC`, `AXIC_SCHEMA_VERSION`),
// corruption/truncation/compiler-upgrade eviction (`CACHE_EVICT_SCHEMA_MISMATCH`,
// `CACHE_EVICT_COMPILER_CHANGED`, `CACHE_EVICT_CORRUPT_CHECKSUM`, `CACHE_EVICT_TRUNCATED`,
// `CACHE_EVICT_MISSING_OBJECT`), and transparent clean rebuild fallback (`AXS-INC-022`).

const AXIC_MAGIC: u64 = 0x3145484341435841u64;
const AXIC_SCHEMA_VERSION: u32 = 1u32;

const EVICT_NONE: u32 = 0u32;
const EVICT_SCHEMA_MISMATCH: u32 = 2u32;
const EVICT_COMPILER_CHANGED: u32 = 3u32;
const EVICT_ENV_MISMATCH: u32 = 4u32;
const EVICT_CORRUPT_CHECKSUM: u32 = 5u32;
const EVICT_TRUNCATED: u32 = 6u32;
const EVICT_MISSING_OBJECT: u32 = 7u32;

@derive(Copy)
struct CacheHeader {
    magic: u64,
    schema_version: u32,
    compiler_digest: u64,
    env_digest: u64,
    payload_len: u32,
    expected_len: u32,
    payload_checksum: u64,
    computed_checksum: u64,
    obj_blob_present: bool,
}

fn validate_cache_header(h: CacheHeader, active_compiler: u64, active_env: u64) -> u32 {
    let plen = h.payload_len;
    let elen = h.expected_len;
    if plen < 48u32 || plen < (elen) {
        return EVICT_TRUNCATED;
    }
    if h.magic != AXIC_MAGIC || h.schema_version != AXIC_SCHEMA_VERSION {
        return EVICT_SCHEMA_MISMATCH;
    }
    if h.payload_checksum != h.computed_checksum {
        return EVICT_CORRUPT_CHECKSUM;
    }
    if h.compiler_digest != active_compiler {
        return EVICT_COMPILER_CHANGED;
    }
    if h.env_digest != active_env {
        return EVICT_ENV_MISMATCH;
    }
    if !h.obj_blob_present {
        return EVICT_MISSING_OBJECT;
    }
    EVICT_NONE
}

fn main() -> i32 {
    let valid = CacheHeader {
        magic: AXIC_MAGIC,
        schema_version: AXIC_SCHEMA_VERSION,
        compiler_digest: 0xAA01u64,
        env_digest: 0xBB01u64,
        payload_len: 512u32,
        expected_len: 512u32,
        payload_checksum: 0x99887766u64,
        computed_checksum: 0x99887766u64,
        obj_blob_present: true,
    };
    if validate_cache_header(valid, 0xAA01u64, 0xBB01u64) != EVICT_NONE {
        return 1;
    }
    print("0\n");

    // 1. Schema version mismatch -> EVICT_SCHEMA_MISMATCH (2)
    let bad_schema = CacheHeader {
        magic: AXIC_MAGIC,
        schema_version: 99u32,
        compiler_digest: 0xAA01u64,
        env_digest: 0xBB01u64,
        payload_len: 512u32,
        expected_len: 512u32,
        payload_checksum: 0x99887766u64,
        computed_checksum: 0x99887766u64,
        obj_blob_present: true,
    };
    if validate_cache_header(bad_schema, 0xAA01u64, 0xBB01u64) != EVICT_SCHEMA_MISMATCH {
        return 2;
    }
    print("2\n");

    // 2. Compiler binary digest upgrade -> EVICT_COMPILER_CHANGED (3)
    if validate_cache_header(valid, 0xAA02u64, 0xBB01u64) != EVICT_COMPILER_CHANGED {
        return 3;
    }
    print("3\n");

    // 3. Bit-flipped payload checksum -> EVICT_CORRUPT_CHECKSUM (5)
    let bad_csum = CacheHeader {
        magic: AXIC_MAGIC,
        schema_version: AXIC_SCHEMA_VERSION,
        compiler_digest: 0xAA01u64,
        env_digest: 0xBB01u64,
        payload_len: 512u32,
        expected_len: 512u32,
        payload_checksum: 0x99887766u64 ^ 1u64,
        computed_checksum: 0x99887766u64,
        obj_blob_present: true,
    };
    if validate_cache_header(bad_csum, 0xAA01u64, 0xBB01u64) != EVICT_CORRUPT_CHECKSUM {
        return 4;
    }
    print("5\n");

    // 4. Truncated cache file -> EVICT_TRUNCATED (6)
    let truncated = CacheHeader {
        magic: AXIC_MAGIC,
        schema_version: AXIC_SCHEMA_VERSION,
        compiler_digest: 0xAA01u64,
        env_digest: 0xBB01u64,
        payload_len: 120u32,
        expected_len: 512u32,
        payload_checksum: 0x99887766u64,
        computed_checksum: 0x99887766u64,
        obj_blob_present: true,
    };
    if validate_cache_header(truncated, 0xAA01u64, 0xBB01u64) != EVICT_TRUNCATED {
        return 5;
    }
    print("6\n");

    // 5. Missing `.obj` artifact blob -> EVICT_MISSING_OBJECT (7)
    let missing_obj = CacheHeader {
        magic: AXIC_MAGIC,
        schema_version: AXIC_SCHEMA_VERSION,
        compiler_digest: 0xAA01u64,
        env_digest: 0xBB01u64,
        payload_len: 512u32,
        expected_len: 512u32,
        payload_checksum: 0x99887766u64,
        computed_checksum: 0x99887766u64,
        obj_blob_present: false,
    };
    if validate_cache_header(missing_obj, 0xAA01u64, 0xBB01u64) != EVICT_MISSING_OBJECT {
        return 6;
    }
    print("7\n");

    0
}
