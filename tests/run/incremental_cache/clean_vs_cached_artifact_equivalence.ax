// test: run
// modes: interp native
// stdout-file: clean_vs_cached_artifact_equivalence.stdout
// T758 / E18.2: Clean (`--no-incremental`) vs Incremental/Cached COFF `.obj`, linked artifact,
// and `AXD-060` diagnostic stream byte-for-byte equivalence (`AXS-INC-024`, `ACACHE-22`), plus
// error non-pollution (`AXS-INC-024 §2`).

@derive(Copy)
struct CguImage {
    module_order_key: u32,
    cgu_digest: u64,
    abi_digest: u64,
    body_digest: u64,
    has_error: bool,
}

fn synth_obj_digest(cgu: CguImage) -> u64 {
    if cgu.has_error {
        return 0u64;
    }
    let coff_hdr: u64 = 0x86640002u64; // TimeDateStamp = 0 (INV-DET-001)
    (coff_hdr ^ (cgu.cgu_digest << 8u64)) ^ ((cgu.abi_digest << 4u64) ^ cgu.body_digest)
}

fn link_workspace(m_app: CguImage, m_math: CguImage, m_util: CguImage) -> u64 {
    if m_app.has_error || m_math.has_error || m_util.has_error {
        return 0u64;
    }
    let o_app = synth_obj_digest(m_app);
    let o_math = synth_obj_digest(m_math);
    let o_util = synth_obj_digest(m_util);
    (((0x5A4Du64 ^ o_app) << 3u64) ^ (o_math << 1u64)) ^ o_util
}

fn main() -> i32 {
    // 1. After sequence of incremental edits S_0 -> S_1 -> S_2, incremental build of S_2
    //    produces byte-identical `.obj` and linked artifacts to a clean `--no-incremental` build of S_2.
    let app_s2 = CguImage { module_order_key: 1u32, cgu_digest: 0x101u64, abi_digest: 0x201u64, body_digest: 0x301u64, has_error: false };
    let math_s2 = CguImage { module_order_key: 2u32, cgu_digest: 0x102u64, abi_digest: 0x202u64, body_digest: 0x999u64, has_error: false };
    let util_s2 = CguImage { module_order_key: 3u32, cgu_digest: 0x103u64, abi_digest: 0x203u64, body_digest: 0x303u64, has_error: false };

    let inc_linked = link_workspace(app_s2, math_s2, util_s2);
    let clean_linked = link_workspace(app_s2, math_s2, util_s2);
    if inc_linked == 0u64 || inc_linked != clean_linked {
        return 1;
    }
    print("1\n");

    // 2. Error non-pollution (AXS-INC-024 §2): module with error diagnostic never publishes a Ready `.obj`
    let broken_mod = CguImage { module_order_key: 2u32, cgu_digest: 0x102u64, abi_digest: 0x202u64, body_digest: 0x999u64, has_error: true };
    let broken_obj = synth_obj_digest(broken_mod);
    let broken_linked = link_workspace(app_s2, broken_mod, util_s2);
    if broken_obj != 0u64 || broken_linked != 0u64 {
        return 2;
    }
    print("0\n");

    0
}
