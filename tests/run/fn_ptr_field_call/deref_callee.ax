// test: run
// stdout: 7\n
// exit: 0
// T422b FU-2 (backend half): `(*p)(x)` where `p` points at a function pointer.

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

fn inc(x: i32) -> i32 {
    return x + 1;
}

fn main() -> i32 {
    let f: fn(i32) -> i32 = inc;
    unsafe {
        let p = address_of(f);
        print_int((*p)(6) as i64);
        print("\n");
    }
    return 0;
}
