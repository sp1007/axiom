// test: run
// stdout: 100\n7\n
// exit: 0
// T422b FU-2: `((*vt).wake)(data)` — call through a function-pointer field reached through a raw pointer.

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct VTable {
    wake: fn(*mut i64) -> i64,
    base: i64,
}

fn wake_impl(p: *mut i64) -> i64 {
    unsafe {
        *p = *p + 1;
        return *p;
    }
}

fn run(vt: *mut VTable, data: *mut i64) -> i64 {
    unsafe {
        return ((*vt).wake)(data);
    }
}

fn main() -> i32 {
    let mut cell: i64 = 99;
    let mut vt = VTable { wake: wake_impl, base: 7 };
    unsafe {
        let pv = address_of_mut(vt);
        let pc = address_of_mut(cell);
        print_int(run(pv, pc));
        print("\n");
        print_int((*pv).base);
        print("\n");
    }
    return 0;
}
