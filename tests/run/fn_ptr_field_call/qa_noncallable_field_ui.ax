// test: ui
// QA T422b: a grouped callee that is not callable must still be diagnosed (not silently turned into a method call).
struct S {
    n: i32,
    f: fn(i32) -> i32,
}

fn main() {
    let s = S { n: 1, f: |x: i32| x };
    let a = (s.n)(1); //~ ERROR AX_TYPE_NOT_CALLABLE
    let b = (s.missing)(1); //~ ERROR AX_TYPE_UNKNOWN_FIELD
    let c = s.n(1); //~ ERROR AX_TYPE_UNKNOWN_FIELD
}
