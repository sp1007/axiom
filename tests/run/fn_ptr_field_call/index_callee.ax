// test: run
// stdout: 9\n8\n
// exit: 0
// T422b FU-2 (backend half): a callee that is a place with a projection (array element) is an indirect call whose
// callee type is the element type, not the type of the root local.

fn dbl(x: i32) -> i32 {
    return x * 2;
}

fn inc(x: i32) -> i32 {
    return x + 1;
}

fn main() -> i32 {
    let fs: [2]fn(i32) -> i32 = [dbl, inc];
    print_int(fs[1](8) as i64);
    print("\n");
    print_int(fs[0](4) as i64);
    print("\n");
    return 0;
}
