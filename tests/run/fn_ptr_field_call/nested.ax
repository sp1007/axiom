// test: run
// stdout: 14\n9\n
// exit: 0
// T422b FU-2: function-pointer field of a nested struct, and a field selected from an array element.

struct Inner {
    f: fn(i32) -> i32,
}

struct Outer {
    pad: i32,
    inner: Inner,
}

fn dbl(x: i32) -> i32 {
    return x * 2;
}

fn inc(x: i32) -> i32 {
    return x + 1;
}

fn main() -> i32 {
    let o = Outer { pad: 0, inner: Inner { f: dbl } };
    print_int((o.inner.f)(7) as i64);
    print("\n");
    let arr: [2]Inner = [Inner { f: dbl }, Inner { f: inc }];
    print_int((arr[1].f)(8) as i64);
    print("\n");
    return 0;
}
