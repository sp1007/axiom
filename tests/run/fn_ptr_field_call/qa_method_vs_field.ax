// test: run
// stdout: 101\n6\n101\n6\n
// exit: 0
// QA T422b: a struct with a method AND a fn-pointer field of the same name. Ungrouped `s.go(x)` and `(s).go(x)` stay
// method calls; the grouped `(s.go)(x)` calls the field value.

struct S {
    go: fn(i32) -> i32,
    n: i32,
}

impl S {
    fn go(self: view<S>, x: i32) -> i32 {
        return x + 100 + self.n;
    }
}

fn dbl(x: i32) -> i32 {
    return x * 2;
}

fn main() -> i32 {
    let s = S { go: dbl, n: 0 };
    print_int(s.go(1) as i64);
    print("\n");
    print_int((s.go)(3) as i64);
    print("\n");
    print_int((s).go(1) as i64);
    print("\n");
    print_int(((s).go)(3) as i64);
    print("\n");
    return 0;
}
