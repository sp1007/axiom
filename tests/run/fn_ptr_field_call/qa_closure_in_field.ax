// test: run
// stdout: 8\n18\n
// exit: 0
// QA T422b: non-capturing closures coerced to fn-pointer fields, called through a grouped field and through an array of structs.

struct H {
    f: fn(i32) -> i32,
}

fn main() -> i32 {
    let h = H { f: |x: i32| x + 5 };
    print_int((h.f)(3) as i64);
    print("\n");
    let hs: [2]H = [H { f: |x: i32| x * 2 }, H { f: |x: i32| x - 1 }];
    print_int((hs[0].f)(9) as i64);
    print("\n");
    return 0;
}
