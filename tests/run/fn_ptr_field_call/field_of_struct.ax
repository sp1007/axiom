// test: run
// stdout: 11\n33\n
// exit: 0
// T422b FU-2: call through a function-pointer field of a struct value (parenthesised callee, and via a local).

struct Ops {
    add: fn(i64, i64) -> i64,
    tag: i64,
}

fn add2(a: i64, b: i64) -> i64 {
    return a + b;
}

fn main() -> i32 {
    let o = Ops { add: add2, tag: 1 };
    print_int((o.add)(5, 6));
    print("\n");
    let f = o.add;
    print_int(f(30, 3));
    print("\n");
    return 0;
}
