// test: run
// stdout: 12\n12\n9\n9\n20\n
// exit: 0
// QA T422b: chained calls `(x.f)(a)(b)`, `((x.f)(a))(b)`, double parentheses `((g))(b)`, and a field returning a fn pointer.

struct Maker {
    mk: fn(i32) -> fn(i32) -> i32,
}

fn add_a(x: i32) -> i32 {
    return x + 4;
}

fn mk_adder(a: i32) -> fn(i32) -> i32 {
    return add_a;
}

fn dbl(x: i32) -> i32 {
    return x * 2;
}

fn main() -> i32 {
    let m = Maker { mk: mk_adder };
    print_int(((m.mk)(0))(8) as i64);
    print("\n");
    print_int((m.mk)(0)(8) as i64);
    print("\n");
    let g: fn(i32) -> i32 = dbl;
    print_int(((g))(4) as i64 + 1);
    print("\n");
    print_int((((m.mk))(0))(5) as i64);
    print("\n");
    print_int((g)(10) as i64);
    print("\n");
    return 0;
}
