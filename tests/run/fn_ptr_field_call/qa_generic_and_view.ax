// test: run
// stdout: 5\n7\n12\n13\n
// exit: 0
// QA T422b: fn-pointer field of a generic struct (two instantiations) and calls through view / mut_view parameters.

struct Holder<T> {
    f: fn(T) -> T,
}

struct Ops {
    f: fn(i32) -> i32,
}

fn id_i32(x: i32) -> i32 {
    return x;
}

fn id_i64(x: i64) -> i64 {
    return x + 1;
}

fn plus_ten(x: i32) -> i32 {
    return x + 10;
}

fn via_view(o: view<Ops>, x: i32) -> i32 {
    return (o.f)(x);
}

fn via_mut_view(o: mut_view<Ops>, x: i32) -> i32 {
    return (o.f)(x);
}

fn main() -> i32 {
    let a = Holder<i32> { f: id_i32 };
    let b = Holder<i64> { f: id_i64 };
    print_int((a.f)(5) as i64);
    print("\n");
    print_int((b.f)(6i64));
    print("\n");
    let mut o = Ops { f: plus_ten };
    print_int(via_view(view(o), 2) as i64);
    print("\n");
    print_int(via_mut_view(mut_view(o), 3) as i64);
    print("\n");
    return 0;
}
