// test: run
// exit: 0

fn test_array_literal() -> i32 {
    let mut sum = 0;
    for x in [10, 20, 30, 40] {
        sum = sum + x;
    }
    if sum != 100 { return 1; }
    0
}

fn test_array_var() -> i32 {
    let arr: [4]i32 = [1, 2, 3, 4];
    let mut sum = 0;
    for x in arr {
        sum = sum + x;
    }
    if sum != 10 { return 2; }
    0
}

fn test_view() -> i32 {
    let arr: [5]i32 = [10, 20, 30, 40, 50];
    let v: view<[i32]> = view(arr);
    let mut sum = 0;
    for x in v {
        sum = sum + x;
    }
    if sum != 150 { return 3; }
    0
}

fn test_slice_subrange() -> i32 {
    let arr: [5]i32 = [1, 2, 3, 4, 5];
    let v: view<[i32]> = view(arr);
    let sub = v[1..4];
    let mut sum = 0;
    for x in sub {
        sum = sum + x;
    }
    // 2 + 3 + 4 = 9
    if sum != 9 { return 4; }
    0
}

fn test_break_continue() -> i32 {
    let arr: [5]i32 = [10, 20, 30, 40, 50];
    let mut sum = 0;
    for x in arr {
        if x == 20 {
            continue;
        }
        if x == 40 {
            break;
        }
        sum = sum + x;
    }
    // 10 + 30 = 40
    if sum != 40 { return 5; }
    0
}

fn main() -> i32 {
    let r1 = test_array_literal();
    if r1 != 0 { return r1; }

    let r2 = test_array_var();
    if r2 != 0 { return r2; }

    let r3 = test_view();
    if r3 != 0 { return r3; }

    let r4 = test_slice_subrange();
    if r4 != 0 { return r4; }

    let r5 = test_break_continue();
    if r5 != 0 { return r5; }

    0
}
