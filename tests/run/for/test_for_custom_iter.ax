// test: run
// exit: 0

@lang("Iterator")
pub trait Iterator {
    type Item;
    fn next(self: mut_view<Self>) -> Option<Self.Item>;
}

struct Counter {
    cur: i32,
    max: i32
}

impl Iterator for Counter {
    type Item = i32;
    fn next(self: mut_view<Self>) -> Option<i32> {
        let cur = self.cur;
        if cur < self.max {
            self.cur = cur + 1;
            Option.Some(cur)
        } else {
            Option.None
        }
    }
}

struct StepCounter {
    cur: i32,
    max: i32,
    step: i32
}

impl Iterator for StepCounter {
    type Item = i32;
    fn next(self: mut_view<Self>) -> Option<i32> {
        let cur = self.cur;
        if cur < self.max {
            self.cur = cur + self.step;
            Option.Some(cur)
        } else {
            Option.None
        }
    }
}

struct Point {
    x: i32,
    y: i32
}

struct PointGen {
    cur: i32,
    count: i32
}

impl Iterator for PointGen {
    type Item = Point;
    fn next(self: mut_view<Self>) -> Option<Point> {
        let cur = self.cur;
        if cur < self.count {
            self.cur = cur + 1;
            let pt = Point { x: cur, y: cur * 10 };
            Option.Some(pt)
        } else {
            Option.None
        }
    }
}

fn test_counter() -> i32 {
    let c = Counter { cur: 1, max: 5 };
    let mut sum = 0;
    for x in c {
        sum = sum + x;
    }
    // 1 + 2 + 3 + 4 = 10
    if sum != 10 { return 1; }
    0
}

fn test_counter_break() -> i32 {
    let c = Counter { cur: 1, max: 10 };
    let mut sum = 0;
    for x in c {
        if x == 4 {
            break;
        }
        sum = sum + x;
    }
    // 1 + 2 + 3 = 6
    if sum != 6 { return 2; }
    0
}

fn test_step_counter() -> i32 {
    let sc = StepCounter { cur: 0, max: 10, step: 2 };
    let mut sum = 0;
    for x in sc {
        sum = sum + x;
    }
    // 0 + 2 + 4 + 6 + 8 = 20
    if sum != 20 { return 3; }
    0
}

fn test_point_iter() -> i32 {
    let pg = PointGen { cur: 0, count: 4 };
    let mut sum_x = 0;
    let mut sum_y = 0;
    for p in pg {
        sum_x = sum_x + p.x;
        sum_y = sum_y + p.y;
    }
    // x: 0 + 1 + 2 + 3 = 6
    // y: 0 + 10 + 20 + 30 = 60
    if sum_x != 6 { return 4; }
    if sum_y != 60 { return 5; }
    0
}

fn main() -> i32 {
    let r1 = test_counter();
    if r1 != 0 { return r1; }

    let r2 = test_counter_break();
    if r2 != 0 { return r2; }

    let r3 = test_step_counter();
    if r3 != 0 { return r3; }

    let r4 = test_point_iter();
    if r4 != 0 { return r4; }

    0
}
