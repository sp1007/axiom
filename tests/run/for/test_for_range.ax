// test: run
// exit: 0

fn test_half_open() -> i32 {
    let mut sum = 0;
    let mut count = 0;
    for x in 0..5 {
        sum = sum + x;
        count = count + 1;
    }
    if sum != 10 { return 1; }
    if count != 5 { return 2; }
    0
}

fn test_inclusive() -> i32 {
    let mut sum = 0;
    let mut count = 0;
    for x in 0..=5 {
        sum = sum + x;
        count = count + 1;
    }
    if sum != 15 { return 3; }
    if count != 6 { return 4; }
    0
}

fn test_empty() -> i32 {
    let mut count = 0;
    for x in 5..5 {
        count = count + 1;
    }
    if count != 0 { return 5; }

    for x in 5..=4 {
        count = count + 1;
    }
    if count != 0 { return 6; }
    0
}

fn test_break_continue() -> i32 {
    let mut sum = 0;
    for x in 0..10 {
        if x == 2 {
            continue;
        }
        if x == 5 {
            break;
        }
        sum = sum + x;
    }
    // 0 + 1 + 3 + 4 = 8
    if sum != 8 { return 7; }
    0
}

fn test_negative() -> i32 {
    let mut sum = 0;
    for x in -5..-2 {
        sum = sum + x;
    }
    // -5 + -4 + -3 = -12
    if sum != -12 { return 8; }
    0
}

fn test_inclusive_single() -> i32 {
    let mut sum = 0;
    let mut count = 0;
    for x in 7..=7 {
        sum = sum + x;
        count = count + 1;
    }
    if sum != 7 { return 9; }
    if count != 1 { return 10; }
    0
}

fn main() -> i32 {
    let r1 = test_half_open();
    if r1 != 0 { return r1; }

    let r2 = test_inclusive();
    if r2 != 0 { return r2; }

    let r3 = test_empty();
    if r3 != 0 { return r3; }

    let r4 = test_break_continue();
    if r4 != 0 { return r4; }

    let r5 = test_negative();
    if r5 != 0 { return r5; }

    let r6 = test_inclusive_single();
    if r6 != 0 { return r6; }

    0
}
