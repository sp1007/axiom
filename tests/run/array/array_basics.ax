struct Point {
    x: i32,
    y: i32
}

struct Polygon {
    points: [3]Point
}

fn main() -> i32 {
    let mut arr = [1, 2, 3];
    if len(arr) != 3 { return 1; }
    if arr[0] != 1 { return 2; }
    arr[1] = 42;
    if arr[1] != 42 { return 3; }
    
    let mut repeated = [7; 5];
    if len(repeated) != 5 { return 4; }
    if repeated[4] != 7 { return 5; }
    repeated[4] = 99;
    if repeated[4] != 99 { return 6; }
    
    let points = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }];
    if len(points) != 2 { return 7; }
    if points[1].x != 3 { return 8; }
    
    let poly = Polygon {
        points: [Point { x: 0, y: 0 }, Point { x: 10, y: 0 }, Point { x: 0, y: 10 }]
    };
    if poly.points[2].y != 10 { return 9; }
    
    0
}
