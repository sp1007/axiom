// test: run
// exit: 0
// stdout: lo=0 hi=1 -> 0 18446744073709551615\nlo=1 hi=1 -> 18446744073709551615 18446744073709551614\nlo=0 hi=0 -> 0 0\nlo=max hi=max -> 1 0\nlo=2^63 hi=0 -> 9223372036854775808 18446744073709551615\nchecks=40 bad=0\n
//
// T482 (FU-T452-NEG): the original two's-complement negation form of `u128_neg_raw`
// (`x ^ all-ones` + 1 with a value-producing `if` for the carry into the high word) must give
// the same result as the `0 - x` form at -O0, -O1 and in the oracle. The wrapping add is split
// into 32-bit halves exactly as in compiler/interp/interp.ax, and the result is written through
// a `mut_view` struct field as the interpreter does.

struct Ctx {
    val_hi: u64,
    val_ovf: bool,
}

fn w_add_u64(a: u64, b: u64) -> u64 {
    let a_lo = a & 0xFFFFFFFFu64;
    let a_hi = (a >> 32u64) & 0xFFFFFFFFu64;
    let b_lo = b & 0xFFFFFFFFu64;
    let b_hi = (b >> 32u64) & 0xFFFFFFFFu64;
    let sum_lo = a_lo + b_lo;
    let carry = sum_lo >> 32u64;
    let sum_hi = (a_hi + b_hi + carry) & 0xFFFFFFFFu64;
    (sum_hi << 32u64) | (sum_lo & 0xFFFFFFFFu64)
}

fn w_neg_u64(a: u64) -> u64 {
    w_add_u64(a ^ 0xFFFFFFFFFFFFFFFFu64, 1u64)
}

fn w_sub_u64(a: u64, b: u64) -> u64 {
    w_add_u64(a, w_neg_u64(b))
}

// Original form (T452 before the workaround).
fn neg_orig(lo: u64, hi: u64, ctx: mut_view<Ctx>) -> u64 {
    let nlo = w_add_u64(lo ^ 0xFFFFFFFFFFFFFFFFu64, 1u64);
    let carry: u64 = if lo == 0u64 { 1u64 } else { 0u64 };
    let nhi = w_add_u64(hi ^ 0xFFFFFFFFFFFFFFFFu64, carry);
    ctx.val_hi = nhi;
    nlo
}

// Workaround form now in compiler/interp/interp.ax.
fn neg_sub(lo: u64, hi: u64, ctx: mut_view<Ctx>) -> u64 {
    let nlo = w_sub_u64(0u64, lo);
    let mut borrow: u64 = 0u64;
    if lo != 0u64 {
        borrow = 1u64;
    }
    let nhi = w_sub_u64(w_sub_u64(0u64, hi), borrow);
    ctx.val_hi = nhi;
    nlo
}

// Same as neg_orig but with the carry as a statement-level `if` and with an early return path,
// to cover the other MIR shapes of a value-producing branch feeding a call argument.
fn neg_orig_stmt(lo: u64, hi: u64, ctx: mut_view<Ctx>) -> u64 {
    let mut carry: u64 = 0u64;
    if lo == 0u64 {
        carry = 1u64;
    }
    let nlo = w_add_u64(lo ^ 0xFFFFFFFFFFFFFFFFu64, 1u64);
    if hi == 0u64 && lo == 0u64 {
        ctx.val_hi = 0u64;
        return 0u64;
    }
    ctx.val_hi = w_add_u64(hi ^ 0xFFFFFFFFFFFFFFFFu64, carry);
    nlo
}

fn show(label: str, lo: u64, hi: u64) {
    let mut ctx = Ctx { val_hi: 0u64, val_ovf: false };
    let nlo = neg_orig(lo, hi, mut_view(ctx));
    print(label);
    print(" -> ");
    print_u64(nlo);
    print(" ");
    print_u64(ctx.val_hi);
    print("\n");
}

fn print_u64(v: u64) {
    if v >= 10u64 {
        print_u64(v / 10u64);
    }
    let d = (v % 10u64) as u8;
    print_digit(d);
}

fn print_digit(d: u8) {
    if d == 0u8 { print("0"); }
    if d == 1u8 { print("1"); }
    if d == 2u8 { print("2"); }
    if d == 3u8 { print("3"); }
    if d == 4u8 { print("4"); }
    if d == 5u8 { print("5"); }
    if d == 6u8 { print("6"); }
    if d == 7u8 { print("7"); }
    if d == 8u8 { print("8"); }
    if d == 9u8 { print("9"); }
}

fn main() -> i32 {
    let max = 0xFFFFFFFFFFFFFFFFu64;
    show("lo=0 hi=1", 0u64, 1u64);
    show("lo=1 hi=1", 1u64, 1u64);
    show("lo=0 hi=0", 0u64, 0u64);
    show("lo=max hi=max", max, max);
    show("lo=2^63 hi=0", 0x8000000000000000u64, 0u64);

    let mut vals: [5]u64 = [0u64, 1u64, 0x8000000000000000u64, 0xFFFFFFFF00000000u64, max];
    let mut checks: u32 = 0u32;
    let mut bad: u32 = 0u32;
    let mut i: usize = 0;
    while i < 5 {
        let mut j: usize = 0;
        while j < 2 {
            let lo = vals[i];
            let hi = if j == 0 { 1u64 } else { vals[4 - i] };
            let mut a = Ctx { val_hi: 0u64, val_ovf: false };
            let mut b = Ctx { val_hi: 0u64, val_ovf: false };
            let mut c = Ctx { val_hi: 0u64, val_ovf: false };
            let la = neg_orig(lo, hi, mut_view(a));
            let lb = neg_sub(lo, hi, mut_view(b));
            let lc = neg_orig_stmt(lo, hi, mut_view(c));
            checks = checks + 4u32;
            if la != lb { bad = bad + 1u32; }
            if a.val_hi != b.val_hi { bad = bad + 1u32; }
            if !(hi == 0u64 && lo == 0u64) {
                if lc != lb { bad = bad + 1u32; }
                if c.val_hi != b.val_hi { bad = bad + 1u32; }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    print("checks=");
    print_u64(checks as u64);
    print(" bad=");
    print_u64(bad as u64);
    print("\n");
    vals[0] = 0u64;
    if bad != 0u32 {
        return 1;
    }
    0
}
