// test: run
// exit: 0
// stdout: 0 0 0 0 0 0\n18446744073709551615 0 18446744073709551615 0 1 0\n18446744073709551614 0 18446744073709551614 0 2 0\n18446744073709551613 0 18446744073709551613 0 3 0\n18446744073709551615 18446744073709551615 18446744073709551615 18446744073709551615 0 18446744073709551615\n18446744073709551612 18446744073709551614 18446744073709551612 18446744073709551614 3 18446744073709551615\nsum=0\n
//
// QA (T482, FU-T452-NEG): i128 negation on values built at run time in a loop (so the -O1 folder
// cannot fold them), alternating low word 0 (carry into the high word) and low word != 0.
// Per line: hi lo of -x, hi lo of (0 - x), then the signed quotient/remainder words of
// (-x) / (-(2^64)) that go through the |a| * |b| negation helper of the interpreter
// (u128_neg_raw) and the native i128 division path. Expected values from a Python big-int model.

fn print_u64(v: u64) {
    if v >= 10u64 {
        print_u64(v / 10u64);
    }
    let d = (v % 10u64) as i64;
    print_int(d);
}

fn hi(x: i128) -> u64 {
    ((x >> 64i128) & 0xFFFFFFFFFFFFFFFFi128) as u64
}

fn lo(x: i128) -> u64 {
    (x & 0xFFFFFFFFFFFFFFFFi128) as u64
}

fn main() -> i32 {
    let two64: i128 = 1i128 << 64i128;
    let mut sum: i128 = 0i128;
    let mut k: i128 = 0i128;
    while k < 6i128 {
        // k = 0..3: x = k * 2^64 (low word 0, carry into the high word); k = 4, 5: x = k - 3 and
        // x = 2^64 * 3 + (k - 3) (low word != 0, no carry).
        let mut x: i128 = k * two64;
        if k == 4i128 {
            x = k - 3i128;
        }
        if k == 5i128 {
            x = 3i128 * two64 + (k - 3i128);
        }
        let n = -x;
        let m = 0i128 - x;
        let q = n / (-two64);
        let r = n % (-two64);
        print_u64(hi(n));
        print(" ");
        print_u64(lo(n));
        print(" ");
        print_u64(hi(m));
        print(" ");
        print_u64(lo(m));
        print(" ");
        print_u64(lo(q));
        print(" ");
        print_u64(hi(r));
        print("\n");
        sum = sum + n + x;
        k = k + 1i128;
    }
    print("sum=");
    print_u64(lo(sum));
    print("\n");
    0
}
