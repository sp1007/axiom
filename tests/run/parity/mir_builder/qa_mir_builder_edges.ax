// test: run
// modes: interp native
// stdout: 0\n55295\n57344\n1114111\n75\n87\n7733\n552\n92\n90\n91\n93\n

const WEIGHTS: [4]i32 = [10, 20, 30, 40];

struct Inner {
    x: i32,
    y: i32,
}

struct Outer {
    pair: (i32, i32),
    inner: Inner,
}

impl Outer {
    fn mutate_via_mut_view(self: mut_view<Outer>, dx: i32, dy: i32) {
        (*self).pair.0 = (*self).pair.0 + dx;
        (*self).pair.1 = (*self).pair.1 + dy;
        (*self).inner.x = (*self).inner.x + dx * 2;
        (*self).inner.y = (*self).inner.y + dy * 3;
    }

    fn read_via_view(self: view<Outer>) -> i32 {
        (*self).pair.0 + (*self).pair.1 * 10 + (*self).inner.x * 100 + (*self).inner.y * 1000
    }
}

struct Track {
    tag: i32,
}

impl Drop for Track {
    fn drop(self: mut_view<Track>) {
        print_int((*self).tag);
        print("\n");
    }
}

fn char_roundtrip(v: u32) -> u32 {
    let c: char = v as char;
    c as u32
}

fn sum_tuple_view(t: view<(i32, i32)>) -> i32 {
    (*t).0 + (*t).1 * 10
}

fn nested_ranges() -> i32 {
    let mut acc: i32 = 0;
    for i in 1..4 {
        for j in 5..5 {
            acc = acc + 1000 + j;
        }
        for k in 5..2 {
            acc = acc + 2000 + k;
        }
        for m in 4..5 {
            acc = acc + i * 10 + m;
        }
    }
    for p in 3..=3 {
        acc = acc + p;
    }
    for q in 4..=2 {
        acc = acc + 5000 + q;
    }
    acc
}

fn index_mix(s: view<[i32]>, m: mut_view<[i32]>, idx: usize) -> i32 {
    let w0: i32 = WEIGHTS[idx];
    let w1: i32 = WEIGHTS[idx + 1usize];
    m[idx + 1usize] = s[idx] + w1;
    let fixed: [3]i32 = [100, 200, 300];
    w0 + m[idx + 1usize] + fixed[idx] + fixed[idx + 1usize]
}

fn replace_track(mv: mut_view<[Track]>, base_i: usize, new_tag: i32) {
    mv[base_i + 1usize] = Track { tag: new_tag };
}

fn main() {
    // 1. Boundary u32 as char casts (0, 0xD7FF, 0xE000, 0x10FFFF)
    print_int(char_roundtrip(0u32) as i32);
    print("\n");
    print_int(char_roundtrip(0xD7FFu32) as i32);
    print("\n");
    print_int(char_roundtrip(0xE000u32) as i32);
    print("\n");
    print_int(char_roundtrip(0x10FFFFu32) as i32);
    print("\n");

    // 2. Nested for range loops with empty and single-element ranges
    print_int(nested_ranges());
    print("\n");

    // 3. Chained deref + tuple/struct field projections
    let tup: (i32, i32) = (7, 8);
    print_int(sum_tuple_view(view(tup)));
    print("\n");

    let mut outer = Outer {
        pair: (1, 2),
        inner: Inner { x: 3, y: 4 },
    };
    outer.mutate_via_mut_view(2, 1);
    print_int(outer.read_via_view());
    print("\n");

    // 4. Indexing view<[T]>, mut_view<[T]>, fixed arrays, CONST_AGGREGATE tables
    let arr_in: [4]i32 = [1, 2, 3, 4];
    let mut arr_out: [4]i32 = [0, 0, 0, 0];
    let res = index_mix(view(arr_in), mut_view(arr_out), 1usize);
    print_int(res);
    print("\n");

    // 5. Element assignment through mut_view<[Track]> with expression index dropping old element
    {
        let mut tracks: [2]Track = [Track { tag: 91 }, Track { tag: 92 }];
        replace_track(mut_view(tracks), 0usize, 93);
        print_int(90i32);
        print("\n");
    }
}
