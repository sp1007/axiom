// test: run
// modes: interp native
// stdout: 2\n1\n5\n3\n77\n99\n4\n7\n6\n

struct S {
    id: i32,
}

impl Drop for S {
    fn drop(self: mut_view<S>) {
        print_int((*self).id);
        print("\n");
    }
}

fn make_s(tag: i32, id: i32) -> S {
    print_int(tag);
    print("\n");
    S { id: id }
}

fn store_slice(v: mut_view<[S]>, i: usize, tag: i32, id: i32) {
    v[i] = make_s(tag, id);
}

fn store_arr(a: mut_view<[3]S>, i: usize, tag: i32, id: i32) {
    (*a)[i] = make_s(tag, id);
}

fn store_u8_slice(v: mut_view<[u8]>, i: usize, val: u8) {
    v[i] = val;
}

fn store_u8_arr(a: mut_view<[3]u8>, i: usize, val: u8) {
    (*a)[i] = val;
}

fn main() {
    let mut arr: [3]S = [S { id: 1 }, S { id: 3 }, S { id: 6 }];
    store_slice(mut_view(arr), 0usize, 2, 4);
    store_arr(mut_view(arr), 1usize, 5, 7);

    let mut bytes: [3]u8 = [1u8, 2u8, 3u8];
    store_u8_slice(mut_view(bytes), 0usize, 77u8);
    store_u8_arr(mut_view(bytes), 2usize, 99u8);
    print_int(bytes[0usize] as i32);
    print("\n");
    print_int(bytes[2usize] as i32);
    print("\n");
}
