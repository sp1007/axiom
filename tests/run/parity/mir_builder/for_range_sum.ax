// test: run
// modes: interp native
// stdout: 145\n165\n

fn main() {
    let mut sum_half: i32 = 0;
    for i in 10..20 {
        sum_half = sum_half + i;
    }
    print_int(sum_half);
    print("\n");

    let mut sum_incl: i32 = 0;
    for j in 10..=20 {
        sum_incl = sum_incl + j;
    }
    print_int(sum_incl);
    print("\n");
}
