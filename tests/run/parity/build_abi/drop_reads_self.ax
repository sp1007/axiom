// test: run
// modes: interp native
// stdout: in_take_one\ndrop1:42\nin_take_two\ndrop2:7:100000\ndrop1:99\ndrop2:3:-500\nin_block\ndrop2:9:2026\ndrop1:11\ndone\n

module main

struct OneField {
    pub x: i32,
}

impl Drop for OneField {
    fn drop(self: mut_view<Self>) {
        print("drop1:");
        print_int(self.x as i64);
        print("\n");
    }
}

struct TwoFields {
    pub tag: u8,
    pub val: i64,
}

impl Drop for TwoFields {
    fn drop(self: mut_view<Self>) {
        print("drop2:");
        print_int(self.tag as i64);
        print(":");
        print_int(self.val);
        print("\n");
    }
}

fn take_one(p: OneField) {
    print("in_take_one\n");
}

fn take_two(p: TwoFields) {
    print("in_take_two\n");
}

fn make_one(v: i32) -> OneField {
    OneField { x: v }
}

fn make_two(t: u8, v: i64) -> TwoFields {
    TwoFields { tag: t, val: v }
}

pub fn main() -> i32 {
    take_one(OneField { x: 42i32 });
    take_two(TwoFields { tag: 7u8, val: 100000i64 });
    make_one(99i32);
    make_two(3u8, -500i64);
    {
        let b1 = OneField { x: 11i32 };
        let b2 = TwoFields { tag: 9u8, val: 2026i64 };
        print("in_block\n");
    }
    print("done\n");
    0
}
