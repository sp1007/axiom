// test: run
// modes: interp native
// stdout: early_true\nmw:-7:300:-40000:9000000000\ninner:101:5\n77\nearly_false\nmw:-7:300:-40000:9000000000\ninner:101:5\nfive:60\ninner:50:9\n5\nin_nested_block\nouter:777:301:302\ninner:301:2\ninner:302:3\ninner:201:1\nmw:12:-1000:123456:-9999999999\nall_done\n

module main

struct Inner {
    pub id: i32,
    pub flag: u8,
}

impl Drop for Inner {
    fn drop(self: mut_view<Self>) {
        print("inner:");
        print_int(self.id as i64);
        print(":");
        print_int(self.flag as i64);
        print("\n");
    }
}

struct MultiWidth {
    pub a: i8,
    pub b: i16,
    pub c: i32,
    pub d: i64,
}

impl Drop for MultiWidth {
    fn drop(self: mut_view<Self>) {
        print("mw:");
        print_int(self.a as i64);
        print(":");
        print_int(self.b as i64);
        print(":");
        print_int(self.c as i64);
        print(":");
        print_int(self.d);
        print("\n");
    }
}

struct PureGlue {
    pub first: Inner,
    pub second: MultiWidth,
}

struct OuterCustom {
    pub tag: i64,
    pub first: Inner,
    pub second: Inner,
}

impl Drop for OuterCustom {
    fn drop(self: mut_view<Self>) {
        print("outer:");
        print_int(self.tag);
        print(":");
        print_int(self.first.id as i64);
        print(":");
        print_int(self.second.id as i64);
        print("\n");
    }
}

fn early_exit(cond: bool) -> i64 {
    let a = Inner { id: 101i32, flag: 5u8 };
    let b = MultiWidth { a: -7i8, b: 300i16, c: -40000i32, d: 9000000000i64 };
    if cond {
        print("early_true\n");
        return 77i64;
    }
    print("early_false\n");
    88i64
}

fn five_arg_callee(x0: i64, x1: i64, x2: i64, p: Inner, x4: i64) -> i64 {
    print("five:");
    print_int(x0 + x1 + x2 + (p.id as i64) + x4);
    print("\n");
    x0 + x4
}

pub fn main() -> i32 {
    let r1 = early_exit(true);
    print_int(r1);
    print("\n");

    let _ = early_exit(false);

    let r5 = five_arg_callee(1i64, 2i64, 3i64, Inner { id: 50i32, flag: 9u8 }, 4i64);
    print_int(r5);
    print("\n");

    {
        let pg = PureGlue {
            first: Inner { id: 201i32, flag: 1u8 },
            second: MultiWidth { a: 12i8, b: -1000i16, c: 123456i32, d: -9999999999i64 },
        };
        let oc = OuterCustom {
            tag: 777i64,
            first: Inner { id: 301i32, flag: 2u8 },
            second: Inner { id: 302i32, flag: 3u8 },
        };
        print("in_nested_block\n");
    }

    print("all_done\n");
    0
}
