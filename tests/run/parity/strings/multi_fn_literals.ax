// test: run
// modes: interp native
// stdout: ascii literal\n-\nXin chào thế giới\na\0b\nThe quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. \nin guard fn\nguard drop\nmain done\n
// ADR-0035: every function owns its string literals (object-local data symbols); each function
// must print its OWN literal, including empty, UTF-8, embedded-NUL and >100-byte literals, and a
// destructor body must see its own literal as well. Expected output is derived by hand from the
// source order below (category A), not captured from either compiler.

struct Guard {}

impl Drop for Guard {
    fn drop(self: mut_view<Guard>) {
        print("guard drop\n");
    }
}

fn f_ascii() {
    print("ascii literal\n");
}

fn f_empty() {
    print("");
    print("-\n");
}

fn f_utf8() {
    print("Xin chào thế giới\n");
}

fn f_nul() {
    print("a\0b\n");
}

fn f_long() {
    print("The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. \n");
}

fn f_guard() {
    let g = Guard {};
    print("in guard fn\n");
}

fn main() {
    f_ascii();
    f_empty();
    f_utf8();
    f_nul();
    f_long();
    f_guard();
    print("main done\n");
}
