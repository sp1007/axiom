// test: run
// modes: interp native
// stdout: first\nsecond: two\nthird: Xin chào\nfirst\n
// ADR-0035: string literals in three functions of one object; each function must read its OWN
// literal (object-local data symbols resolved by symbol index). No destructors: this program is
// also linked in-process by tests/selfhost/obj_link_driver and compared byte for byte with axiom0.

fn one() {
    print("first\n");
}

fn two() {
    print("second: two\n");
}

fn three() {
    print("third: Xin chào\n");
}

fn main() {
    one();
    two();
    three();
    one();
}
