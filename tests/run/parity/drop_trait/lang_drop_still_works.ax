// test: run
// modes: interp native
// stdout: in\ndrop 3\nout\n
// T158 / SPEC-12 AXS-DROP-008 control: the bare name `Drop`, with no item named `Drop` declared in or
// imported into the module, is the prelude lang item. `impl Drop for S` is the destructor and runs at
// scope end (after the last statement of the block, before the statement that follows the block).
// Expected output written by hand: "in" inside the block, then the destructor of `s` ("drop 3"), then
// "out".

module main

struct S {
    pub id: u8,
}

impl Drop for S {
    fn drop(self: mut_view<Self>) {
        if self.id == 3u8 {
            print("drop 3\n");
        } else {
            print("drop ?\n");
        }
    }
}

pub fn main() -> i32 {
    {
        let s = S { id: 3u8 };
        print("in\n");
    }
    print("out\n");
    0
}
