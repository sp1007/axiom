// test: run
// modes: interp native
// stdout: in-s2\nlang-s2\nafter-s2\nalias-in 9 9\ndone\n
// T158 QA boundary cross-check (SPEC-12 AXS-DROP-008):
//   1. `use traits.Drop as UserDrop` in `m_renamed_out` binds `UserDrop` (not `Drop`), so prelude
//      `Drop` remains unshadowed: bare `impl Drop for S2` is the language destructor (`S2$drop`)
//      and runs at scope end.
//   2. `use traits.Cleanup as Drop` in `m_renamed_in` binds `Drop` via alias, shadowing prelude
//      `Drop`: bare `impl Drop for S3` implements the user trait `Cleanup` (`S3` stays Copy,
//      `s.drop()` is an ordinary method call, and nothing runs at scope end).

module traits

pub trait Drop {
    fn drop(self: mut_view<Self>);
}

pub trait Cleanup {
    fn drop(self: mut_view<Self>);
}

module m_renamed_out

use traits.Drop as UserDrop

pub struct S2 {
    pub x: u8,
}

impl Drop for S2 {
    fn drop(self: mut_view<Self>) {
        print("lang-s2\n");
    }
}

pub fn run_out() {
    {
        let _s2 = S2 { x: 2u8 };
        print("in-s2\n");
    }
    print("after-s2\n");
}

module m_renamed_in

use traits.Cleanup as Drop

@derive(Copy)
pub struct S3 {
    pub v: u8,
}

impl Drop for S3 {
    fn drop(self: mut_view<Self>) {
        print("alias-in ");
    }
}

fn print_nine(v: u8) {
    if v == 9u8 {
        print("9");
    } else {
        print("?");
    }
}

pub fn run_in() {
    {
        let mut s = S3 { v: 9u8 };
        s.drop();
        let c1 = s;
        let c2 = s;
        print_nine(c1.v);
        print(" ");
        print_nine(c2.v);
        print("\n");
    }
}

module main

use m_renamed_out
use m_renamed_in

pub fn main() -> i32 {
    m_renamed_out.run_out();
    m_renamed_in.run_in();
    print("done\n");
    0
}
