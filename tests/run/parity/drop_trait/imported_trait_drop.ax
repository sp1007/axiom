// test: run
// modes: interp native
// stdout: begin\nuser drop\nend\n
// T158 / SPEC-12 AXS-DROP-008: `use traits.Drop` imports a user trait into module `main`, so the bare
// name `Drop` there refers to the import and not to the prelude lang item. `impl Drop for S` implements
// the user trait: nothing runs at scope end and `s.drop()` is an ordinary method call.
// Expected output written by hand: begin / the explicit call prints "user drop" once / end; the scope
// end of `s` prints nothing.

module traits

pub trait Drop {
    fn drop(self: mut_view<Self>);
}

module main

use traits.Drop

struct S {
    pub id: u8,
}

impl Drop for S {
    fn drop(self: mut_view<Self>) {
        print("user drop\n");
    }
}

pub fn main() -> i32 {
    let mut s = S { id: 1u8 };
    print("begin\n");
    s.drop();
    print("end\n");
    0
}
