// test: run
// modes: interp native
// stdout: before\nuser drop\nafter\ncopy 7 7\nend\n
// T158 / SPEC-12 AXS-DROP-008 (ADR-0036 section 5): `impl traits.Drop for S` names a USER trait that
// happens to be called `Drop`; it is not the language destructor. Nothing runs at scope end, the
// `drop` method is an ordinary method (an explicit `s.drop()` prints once), and `S` stays copyable.
// Before T158 axiom0 and axiomc took any path ending in `.Drop` for the language Drop.
// Expected output written by hand:
//   before / explicit s.drop() prints "user drop" once / after / a copy of S is read twice ("copy 7 7")
//   / end; the scope end of `s`, `t` and `u` prints nothing.

module traits

pub trait Drop {
    fn drop(self: mut_view<Self>);
}

module main

use traits

@derive(Copy)
struct S {
    pub id: u8,
}

impl traits.Drop for S {
    fn drop(self: mut_view<Self>) {
        print("user drop\n");
    }
}

fn say_id(d: u8) {
    if d == 7u8 {
        print("7");
    } else {
        print("?");
    }
}

pub fn main() -> i32 {
    {
        let mut s = S { id: 7u8 };
        print("before\n");
        s.drop();
        print("after\n");
        let t = s;
        let u = s;
        print("copy ");
        say_id(t.id);
        print(" ");
        say_id(u.id);
        print("\n");
    }
    print("end\n");
    0
}
