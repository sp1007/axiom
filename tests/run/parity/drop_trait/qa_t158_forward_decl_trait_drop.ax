// test: run
// modes: interp native
// stdout: forward 5 5\nin-guard\nguard-drop\ndone\n
// T158 QA boundary cross-check (SPEC-12 AXS-DROP-008):
//   In `main`, `impl Drop for S` appears lexically BEFORE `trait Drop` in the same module.
//   Module-scope shadowing does not depend on item declaration order, so `impl Drop for S`
//   implements the local user trait `Drop` (`S` stays Copy and nothing runs at scope end),
//   while `plain.Guard` in a sibling module without `trait Drop` uses the prelude destructor.

module plain

pub struct Guard {
    pub id: u8,
}

impl Drop for Guard {
    fn drop(self: mut_view<Self>) {
        print("guard-drop\n");
    }
}

pub fn run_guard() {
    let _g = Guard { id: 1u8 };
    print("in-guard\n");
}

module main

use plain

@derive(Copy)
struct S {
    pub v: u8,
}

impl Drop for S {
    fn drop(self: mut_view<Self>) {
        print("forward ");
    }
}

trait Drop {
    fn drop(self: mut_view<Self>);
}

fn print_five(v: u8) {
    if v == 5u8 {
        print("5");
    } else {
        print("?");
    }
}

pub fn main() -> i32 {
    {
        let mut s = S { v: 5u8 };
        s.drop();
        let a = s;
        let b = s;
        print_five(a.v);
        print(" ");
        print_five(b.v);
        print("\n");
    }
    plain.run_guard();
    print("done\n");
    0
}
