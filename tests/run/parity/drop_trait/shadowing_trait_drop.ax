// test: run
// modes: interp native
// stdout: enter\nin guard\nguard\nexplicit\nleave\n
// T158 / SPEC-12 AXS-DROP-008: a module that declares its own `trait Drop` makes the bare name `Drop`
// refer to it, so `impl Drop for S` there implements the USER trait; it is not the language
// destructor and nothing runs at scope end. Module `plain` has no `Drop` item of its own, so its bare
// `Drop` is still the prelude lang item (`Guard` prints "guard" at scope end). The two modules in one
// program prove that the decision is made per resolved name and not per file.
// Expected output written by hand:
//   enter; plain.run_guard(): "in guard" then the destructor of `g` ("guard"); an explicit `s.drop()`
//   in main calls the user trait method ("explicit"); leave. The scope end of `s` prints nothing.

module plain

pub struct Guard {
    pub id: u8,
}

impl Drop for Guard {
    fn drop(self: mut_view<Self>) {
        print("guard\n");
    }
}

pub fn run_guard() {
    let g = Guard { id: 1u8 };
    print("in guard\n");
}

module main

use plain

trait Drop {
    fn drop(self: mut_view<Self>);
}

struct S {
    pub id: u8,
}

impl Drop for S {
    fn drop(self: mut_view<Self>) {
        print("explicit\n");
    }
}

pub fn main() -> i32 {
    let mut s = S { id: 1u8 };
    print("enter\n");
    plain.run_guard();
    s.drop();
    print("leave\n");
    0
}
