// test: run
// modes: interp native
// exit: 0
// stdout: 2\n50\n6\n

fn emit_line(v: i64) {
    print_int(v);
    print("\n");
}

fn main() -> i32 {
    let arr: [5]i32 = [10, 20, 30, 40, 50];
    let s: view<[i32]> = view(arr);
    let sub = s[1..3];
    emit_line(len(sub) as i64);
    emit_line((sub[0] + sub[1]) as i64);

    let mut for_sum: i32 = 0;
    for x in [1, 2, 3] {
        for_sum = for_sum + x;
    }
    emit_line(for_sum as i64);

    0
}
