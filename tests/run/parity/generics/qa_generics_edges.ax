// test: run
// modes: interp native
// exit: 37
// stdout: 62\n151\n636\n210\n1225\n103\ndrop:2\ndrop:1\n34\ndrop:2\ndrop:1\n

trait Copy {}

trait Add {
    fn add(self: Self, other: Self) -> Self;
}

trait Sub {
    fn sub(self: Self, other: Self) -> Self;
}

trait Eq {
    fn eq(self: view<Self>, other: view<Self>) -> bool;
}

trait Ord {
    fn cmp(self: view<Self>, other: view<Self>) -> i32;
}

trait Index {
    fn index(self: view<Self>, idx: usize) -> Vec2;
}

struct Pair<A, B> {
    left: A,
    right: B,
}

struct Boxed<T> {
    inner: T,
    tag: i32,
}

enum Either<L, R> {
    Left(L),
    Right(R),
}

@derive(Copy)
struct Vec2 {
    x: i32,
    y: i32,
}

impl Add for Vec2 {
    fn add(self: Vec2, other: Vec2) -> Vec2 {
        Vec2 { x: self.x + other.x, y: self.y + other.y }
    }
}

impl Sub for Vec2 {
    fn sub(self: Vec2, other: Vec2) -> Vec2 {
        Vec2 { x: self.x - other.x, y: self.y - other.y }
    }
}

impl Eq for Vec2 {
    fn eq(self: view<Vec2>, other: view<Vec2>) -> bool {
        self.x == other.x && self.y == other.y
    }
}

impl Ord for Vec2 {
    fn cmp(self: view<Vec2>, other: view<Vec2>) -> i32 {
        let s1 = self.x + self.y;
        let s2 = other.x + other.y;
        if s1 < s2 {
            0
        } else if s1 == s2 {
            1
        } else {
            2
        }
    }
}

struct Grid {
    v0: Vec2,
    v1: Vec2,
    v2: Vec2,
}

impl Index for Grid {
    fn index(self: view<Grid>, idx: usize) -> Vec2 {
        if idx == 0 {
            self.v0
        } else if idx == 1 {
            self.v1
        } else {
            self.v2
        }
    }
}

struct Guard {
    id: i32,
}

impl Drop for Guard {
    fn drop(self: mut_view<Guard>) {
        print("drop:");
        print_int(self.id as i64);
        print("\n");
    }
}

fn emit_line(v: i64) {
    print_int(v);
    print("\n");
}

fn id_val<X>(x: X) -> X {
    x
}

fn first_after_id<A, B>(a: A, _b: B) -> A {
    id_val(a)
}

fn eval_either(e: Either<i32, Pair<i32, i32>>) -> i32 {
    match e {
        Either.Left(v) => id_val(v),
        Either.Right(p) => p.left * 10 + p.right,
    }
}

fn half_even(x: i32) -> Option<i32> {
    if x % 2 == 0 {
        Option<i32>.Some(x / 2)
    } else {
        Option<i32>.None
    }
}

fn try_opt_chain(x: i32) -> Option<i32> {
    let a = half_even(x)?;
    let b = half_even(a + 2)?;
    Option<i32>.Some(a + b)
}

fn check_pos(x: i32) -> Result<i32, i32> {
    if x > 0 {
        Result<i32, i32>.Ok(x)
    } else {
        Result<i32, i32>.Err(-x)
    }
}

fn try_res_with_drop(fail_second: bool) -> Result<i32, i32> {
    let _g1 = Guard { id: 1 };
    let v1 = check_pos(20)?;
    let _g2 = Guard { id: 2 };
    let v2 = if fail_second {
        check_pos(-37)?
    } else {
        check_pos(14)?
    };
    Result<i32, i32>.Ok(v1 + v2)
}

fn main() -> i32 {
    let p0 = Pair<i64, i32> {
        left: first_after_id(40i64, true),
        right: first_after_id(15, 99i64),
    };
    let b0 = Boxed<Pair<i64, i32>> {
        inner: p0,
        tag: id_val(7),
    };
    emit_line(b0.inner.left + (b0.inner.right as i64) + (b0.tag as i64));

    let e1 = eval_either(Either<i32, Pair<i32, i32>>.Left(19));
    let e2 = eval_either(Either<i32, Pair<i32, i32>>.Right(Pair<i32, i32> { left: 11, right: 22 }));
    emit_line((e1 + e2) as i64);

    let arr: [6]i32 = [3, 6, 9, 12, 15, 18];
    let s: view<[i32]> = view(arr);
    let full = s[..];
    let head4 = full[..4];
    let mid2 = head4[1..];
    let tail = arr[4..6];
    let slice_score = (len(full) as i32) * 100 + mid2[0] + mid2[2] + tail[1];
    emit_line(slice_score as i64);

    let mut arr_sum: i32 = 0;
    for x in [2, 4, 6, 8] {
        arr_sum = arr_sum + x;
    }
    let mut inc_sum: i32 = 0;
    for k in 1..=4 {
        inc_sum = inc_sum + k;
    }
    emit_line((arr_sum * 10 + inc_sum) as i64);

    let grid = Grid {
        v0: Vec2 { x: 10, y: 20 },
        v1: Vec2 { x: 5, y: 7 },
        v2: Vec2 { x: 3, y: 2 },
    };
    let v_res = grid[0] + grid[1] - grid[2];
    let g1 = grid[1];
    let g2 = grid[2];
    let expected_v = Vec2 { x: 12, y: 25 };
    if !(v_res == expected_v) || (v_res != expected_v) || !(g2 < g1) || !(g1 > g2) {
        return 91;
    }
    emit_line((v_res.x * 100 + v_res.y) as i64);

    let opt_ok = match try_opt_chain(12) {
        Option.Some(v) => v,
        Option.None => -1,
    };
    let opt_none = match try_opt_chain(10) {
        Option.Some(v) => v,
        Option.None => 3,
    };
    emit_line((opt_ok * 10 + opt_none) as i64);

    match try_res_with_drop(false) {
        Result.Ok(v) => emit_line(v as i64),
        Result.Err(_) => {
            return 92;
        }
    }

    match try_res_with_drop(true) {
        Result.Ok(_) => 93,
        Result.Err(code) => code,
    }
}
