// test: run
// modes: interp native
// exit: 0
// stdout: 42\n1\n17\n500\n

fn emit_line(v: i64) {
    print_int(v);
    print("\n");
}

fn id<T>(x: T) -> T {
    x
}

fn pick_first<A, B>(a: A, _b: B) -> A {
    a
}

fn main() -> i32 {
    let v_i32: i32 = id(42);
    let v_bool: bool = id(true);
    emit_line(v_i32 as i64);
    emit_line(if v_bool { 1i64 } else { 0i64 });

    let p1: i32 = pick_first(17, false);
    let p2: i64 = pick_first(500i64, 9);
    emit_line(p1 as i64);
    emit_line(p2);

    0
}
