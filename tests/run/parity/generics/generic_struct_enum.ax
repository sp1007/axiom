// test: run
// modes: interp native
// exit: 23
// stdout: 42\n7\n-1\n

struct Pair<T, U> {
    first: T,
    second: U,
}

fn emit_line(v: i64) {
    print_int(v);
    print("\n");
}

fn unwrap_or_neg1(opt: Option<i32>) -> i32 {
    match opt {
        Option.Some(v) => v,
        Option.None => -1,
    }
}

fn step_ok(x: i32) -> Result<i32, i32> {
    Result<i32, i32>.Ok(x + 5)
}

fn step_err(code: i32) -> Result<i32, i32> {
    Result<i32, i32>.Err(code)
}

fn run_pipeline() -> Result<i32, i32> {
    let v = step_ok(10)?;
    let _never = step_err(v + 8)?;
    Result<i32, i32>.Ok(999)
}

fn main() -> i32 {
    let p = Pair<i32, i32> { first: 12, second: 30 };
    let pair_sum = p.first + p.second;
    emit_line(pair_sum as i64);

    emit_line(unwrap_or_neg1(Option<i32>.Some(7)) as i64);
    emit_line(unwrap_or_neg1(Option<i32>.None) as i64);

    match run_pipeline() {
        Result.Ok(v) => v,
        Result.Err(e) => e,
    }
}
