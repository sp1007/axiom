// test: run
// modes: interp native
// stdout: 2\n2\n3\nD3\nempty\nE\n5\nD5\n
// T157 / SPEC-11 AXS-CAP-008 (ADR-0036 section 2): a raw pointer from `address_of` /
// `address_of_mut` holds no capability. Taking raw pointers to locals of an `impl Drop` type (one
// with a scalar field, one fieldless), storing through them, then reading, viewing, moving the owner
// and letting it be dropped at scope end is accepted by axiom0 and axiomc (before T157 both reported
// a false AX_CAP_OUTLIVES_OWNER at the function end). The whole-value store `*p = ...` is a raw store:
// the old value is overwritten without its destructor (SPEC-12 AXS-DROP-007).
// Expected output written by hand:
//   scalar_case: field store 2 -> read through q: 2, read owner: 2; raw store 3 (no "D2");
//                view of the owner: 3; scope end drops b                     -> 2 2 3 D3
//   empty_case:  raw store, view of the owner prints "empty"; scope end      -> empty E
//   moved_case:  owner moved into n after taking a pointer; n printed, dropped -> 5 D5

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

fn say(d: u8) {
    if d == 1u8 {
        print("1\n");
    } else if d == 2u8 {
        print("2\n");
    } else if d == 3u8 {
        print("3\n");
    } else if d == 5u8 {
        print("5\n");
    } else {
        print("?\n");
    }
}

fn say_drop(d: u8) {
    if d == 3u8 {
        print("D3\n");
    } else if d == 5u8 {
        print("D5\n");
    } else {
        print("D?\n");
    }
}

struct Scalar {
    pub id: u8,
}

impl Drop for Scalar {
    fn drop(self: mut_view<Self>) {
        say_drop(self.id);
    }
}

struct Empty {}

impl Drop for Empty {
    fn drop(self: mut_view<Self>) {
        print("E\n");
    }
}

fn show(s: view<Scalar>) {
    say(s.id);
}

fn show_empty(e: view<Empty>) {
    print("empty\n");
}

fn scalar_case() {
    let mut b = Scalar { id: 1u8 };
    let p: *mut Scalar = unsafe { address_of_mut(b) };
    unsafe { (*p).id = 2u8; }
    let q: *const Scalar = unsafe { address_of(b) };
    say(unsafe { (*q).id });
    say(b.id);
    unsafe { *p = Scalar { id: 3u8 }; }
    show(view(b));
}

fn empty_case() {
    let mut e = Empty {};
    let pe: *mut Empty = unsafe { address_of_mut(e) };
    let pc: *const Empty = unsafe { address_of(e) };
    unsafe { *pe = Empty {}; }
    show_empty(view(e));
}

fn moved_case() {
    let mut m = Scalar { id: 5u8 };
    let pm: *mut Scalar = unsafe { address_of_mut(m) };
    let n = m;
    say(n.id);
}

pub fn main() -> i32 {
    scalar_case();
    empty_case();
    moved_case();
    0
}
