// test: run
// modes: interp native
// exit: 42
// stdout: 2\n2\nd2\n3\nd3\n4\nd4\n5\nd5\nd5\n6\nd6\n7\nd7\n9\nd9\n
// T157 QA (SPEC-11 AXS-CAP-008/009): programs that the last-use extent of a view local makes valid,
// and genuinely Copy owners that the "whole-local copy of a dropped local is a move" rule must not
// reject. Each case prints values and destructor output; the exit code is the sum of the returned
// values minus 2. Expected output written by hand:
//   copy_i32:         i32 owner viewed, b = a is a copy; prints b + *v           -> 2           (+2)
//   copy_struct:      @derive(Copy) P viewed and copied; prints b.x + v.x        -> 2           (+2)
//   view_in_loop:     view of a (x 2) taken and used 3 times in a loop; a dropped -> d2          (+6)
//   branch_other_use: c false: the view is used, the move is on the other branch -> 3 d3        (+3)
//   early_return:     c true: prints and returns through the view; a dropped     -> 4 d4        (+4)
//   move_after_last:  view used, then a moved into b; b dropped                  -> 5 d5        (+5)
//   reassign_after:   view used (5), a = D{6} drops the old a; prints 6; end     -> d5 6 d6     (+6)
//   raw_loop:         address_of_mut in a loop stores 5, 6, 7; owner read        -> 7 d7        (+7)
//   raw_then_views:   raw store 9, a second raw pointer, a view read, owner read -> 9 d9        (+9)
//   44 - 2 = 42

struct D {
    pub x: i32,
}

impl Drop for D {
    fn drop(self: mut_view<Self>) {
        say_d(self.x);
    }
}

@derive(Copy)
struct P {
    x: i32,
}

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

fn say(n: i32) {
    if n == 2 {
        print("2\n");
    } else if n == 3 {
        print("3\n");
    } else if n == 4 {
        print("4\n");
    } else if n == 5 {
        print("5\n");
    } else if n == 6 {
        print("6\n");
    } else if n == 7 {
        print("7\n");
    } else if n == 9 {
        print("9\n");
    } else {
        print("?\n");
    }
}

fn say_d(n: i32) {
    if n == 2 {
        print("d2\n");
    } else if n == 3 {
        print("d3\n");
    } else if n == 4 {
        print("d4\n");
    } else if n == 5 {
        print("d5\n");
    } else if n == 6 {
        print("d6\n");
    } else if n == 7 {
        print("d7\n");
    } else if n == 8 {
        print("d8\n");
    } else if n == 9 {
        print("d9\n");
    } else {
        print("d?\n");
    }
}

fn use_d(v: view<D>) -> i32 {
    v.x
}

fn use_i(v: view<i32>) -> i32 {
    *v
}

fn use_p(v: view<P>) -> i32 {
    v.x
}

fn copy_i32() -> i32 {
    let a = 1;
    let v = view(a);
    let b = a;
    let r = b + use_i(v);
    say(r);
    r
}

fn copy_struct() -> i32 {
    let a = P { x: 1 };
    let v = view(a);
    let b = a;
    let r = b.x + use_p(v);
    say(r);
    r
}

fn view_in_loop() -> i32 {
    let a = D { x: 2 };
    let mut i = 0;
    let mut s = 0;
    while i < 3 {
        let v = view(a);
        s = s + use_d(v);
        i = i + 1;
    }
    s
}

fn branch_other_use(c: bool) -> i32 {
    let a = D { x: 3 };
    let v = view(a);
    if c {
        let b = a;
        0
    } else {
        let r = use_d(v);
        say(r);
        r
    }
}

fn early_return(c: bool) -> i32 {
    let a = D { x: 4 };
    let v = view(a);
    if c {
        say(use_d(v));
        return use_d(v);
    }
    let b = a;
    0
}

fn move_after_last() -> i32 {
    let a = D { x: 5 };
    let v = view(a);
    let r = use_d(v);
    say(r);
    let b = a;
    r
}

fn reassign_after() -> i32 {
    let mut a = D { x: 5 };
    let v = view(a);
    let r = use_d(v);
    a = D { x: 6 };
    say(a.x);
    r + 1
}

fn raw_loop() -> i32 {
    let mut b = D { x: 1 };
    let mut i = 0;
    while i < 3 {
        let p: *mut D = unsafe { address_of_mut(b) };
        unsafe { (*p).x = 5 + i; }
        i = i + 1;
    }
    say(b.x);
    b.x
}

fn raw_then_views() -> i32 {
    let mut b = D { x: 8 };
    let p: *mut D = unsafe { address_of_mut(b) };
    unsafe { (*p).x = 9; }
    let q: *mut D = unsafe { address_of_mut(b) };
    let v = view(b);
    let r = use_d(v);
    unsafe { (*q).x = r; }
    say(b.x);
    r
}

pub fn main() -> i32 {
    let mut s = copy_i32();
    s = s + copy_struct();
    s = s + view_in_loop();
    s = s + branch_other_use(false);
    s = s + early_return(true);
    s = s + move_after_last();
    s = s + reassign_after();
    s = s + raw_loop();
    s = s + raw_then_views();
    s - 2
}
