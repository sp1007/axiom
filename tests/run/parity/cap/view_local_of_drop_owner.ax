// test: run
// modes: interp native
// stdout: 1\n3\nD3\nD1\n4\n5\nD5\n4\nD4\nD6\n6\nD8\nD6\n8\n
// T157 / SPEC-11 AXS-CAP-009 (ADR-0036 section 3): a view local declared after its owner is dead
// before the owner's scope-end drop (locals die in reverse declaration order, SPEC-12 AXS-DROP-002),
// so `let va: view<S> = view(a)` / `let mv: mut_view<S> = mut_view(b)` on an `impl Drop` owner is
// valid at a function end, at the end of a nested block and on an early `return` (before T157 both
// compilers reported a false AX_CAP_OUTLIVES_OWNER). Destructor order is pinned.
// Expected output written by hand:
//   basic:          va.id 1, mv.id = 3 printed 3; end drops b then a        -> 1 3 D3 D1
//   nested:         va.id 4, vi.id 5; block end drops inner; a.id 4; end    -> 4 5 D5 4 D4
//   early(true):    return va.id: a dropped before the caller prints 6     -> D6 6
//   early(false):   mv.id = 8 returned; b then a dropped; caller prints 8  -> D8 D6 8

module main

fn say(d: u8) {
    if d == 1u8 {
        print("1\n");
    } else if d == 3u8 {
        print("3\n");
    } else if d == 4u8 {
        print("4\n");
    } else if d == 5u8 {
        print("5\n");
    } else if d == 6u8 {
        print("6\n");
    } else if d == 8u8 {
        print("8\n");
    } else {
        print("?\n");
    }
}

struct S {
    pub id: u8,
}

impl Drop for S {
    fn drop(self: mut_view<Self>) {
        let d = self.id;
        if d == 1u8 {
            print("D1\n");
        } else if d == 3u8 {
            print("D3\n");
        } else if d == 4u8 {
            print("D4\n");
        } else if d == 5u8 {
            print("D5\n");
        } else if d == 6u8 {
            print("D6\n");
        } else if d == 8u8 {
            print("D8\n");
        } else {
            print("D?\n");
        }
    }
}

fn basic() {
    let a = S { id: 1u8 };
    let va: view<S> = view(a);
    say(va.id);
    let mut b = S { id: 2u8 };
    let mv: mut_view<S> = mut_view(b);
    mv.id = 3u8;
    say(mv.id);
}

fn nested() {
    let a = S { id: 4u8 };
    {
        let va: view<S> = view(a);
        let inner = S { id: 5u8 };
        let vi: view<S> = view(inner);
        say(va.id);
        say(vi.id);
    }
    say(a.id);
}

fn early(flag: bool) -> u8 {
    let a = S { id: 6u8 };
    let va: view<S> = view(a);
    if flag {
        return va.id;
    }
    let mut b = S { id: 7u8 };
    let mv: mut_view<S> = mut_view(b);
    mv.id = 8u8;
    mv.id
}

pub fn main() -> i32 {
    basic();
    nested();
    say(early(true));
    say(early(false));
    0
}
