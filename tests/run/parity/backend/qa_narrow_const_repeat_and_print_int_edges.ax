// test: run
// modes: interp native
// exit: 0
// stdout: -2147483648\n-2147483647\n-1\n2147483647\n-128\n-1\n127\n0\n128\n255\n-32768\n-1\n32767\n0\n32768\n65535\n-1\n255\n-1\n65535\n-1\n4294967295\n-128\n-32768\n-2147483648\nhead:4:-128:-32768:-2147483648:4294967295\n:0:-1:-1:-1:0\ntail:4:127:32767:2147483647:2147483648\n0\n-1\n1\n-9223372036854775808\n-9223372036854775807\n9223372036854775807\n-300020600\n

struct EdgeRow {
    label: Str,
    b: i8,
    h: i16,
    w: i32,
    u: u32,
}

struct EdgeTable {
    r0: EdgeRow,
    r1: EdgeRow,
    r2: EdgeRow,
}

const EDGES: EdgeTable = EdgeTable {
    r0: EdgeRow { label: "head", b: -128i8, h: -32768i16, w: -2147483648i32, u: 4294967295u32 },
    r1: EdgeRow { label: "", b: -1i8, h: -1i16, w: -1i32, u: 0u32 },
    r2: EdgeRow { label: "tail", b: 127i8, h: 32767i16, w: 2147483647i32, u: 2147483648u32 },
};

fn emit_line(v: i64) {
    print_int(v);
    print("\n");
}

fn emit_row(r: EdgeRow) {
    let n = len(r.label);
    print(r.label);
    print(":");
    print_int(n as i64);
    print(":");
    print_int(r.b as i64);
    print(":");
    print_int(r.h as i64);
    print(":");
    print_int(r.w as i64);
    print(":");
    print_int(r.u as i64);
    print("\n");
}

fn main() -> i32 {
    let (v0, v1, v2, v3) = (-2147483648, -2147483647, -1, 2147483647);
    emit_line(v0 as i64);
    emit_line(v1 as i64);
    emit_line(v2 as i64);
    emit_line(v3 as i64);

    let (b0, b1, b2): (i8, i8, i8) = (-128i8, -1i8, 127i8);
    emit_line(b0 as i64);
    emit_line(b1 as i64);
    emit_line(b2 as i64);

    let (ub0, ub1, ub2): (u8, u8, u8) = (0u8, 128u8, 255u8);
    emit_line(ub0 as i64);
    emit_line(ub1 as i64);
    emit_line(ub2 as i64);

    let (h0, h1, h2): (i16, i16, i16) = (-32768i16, -1i16, 32767i16);
    emit_line(h0 as i64);
    emit_line(h1 as i64);
    emit_line(h2 as i64);

    let (uh0, uh1, uh2): (u16, u16, u16) = (0u16, 32768u16, 65535u16);
    emit_line(uh0 as i64);
    emit_line(uh1 as i64);
    emit_line(uh2 as i64);

    let neg1: i64 = -1i64;
    emit_line((neg1 as i8) as i64);
    emit_line((neg1 as u8) as i64);
    emit_line((neg1 as i16) as i64);
    emit_line((neg1 as u16) as i64);
    emit_line((neg1 as i32) as i64);
    emit_line((neg1 as u32) as i64);

    let hi_b: u8 = 128u8;
    let hi_h: u16 = 32768u16;
    let hi_w: u32 = 2147483648u32;
    emit_line((hi_b as i8) as i64);
    emit_line((hi_h as i16) as i64);
    emit_line((hi_w as i32) as i64);

    emit_row(EDGES.r0);
    emit_row(EDGES.r1);
    emit_row(EDGES.r2);

    emit_line(0i64);
    emit_line(-1i64);
    emit_line(1i64);
    let i64_min: i64 = -1073741824i64 * 8589934592i64;
    let i64_min_plus_1: i64 = i64_min + 1i64;
    let i64_max: i64 = 0i64 - i64_min_plus_1;
    emit_line(i64_min);
    emit_line(i64_min_plus_1);
    emit_line(i64_max);

    let cap_b: i8 = -100i8;
    let cap_h: i16 = -20000i16;
    let cap_w: i32 = -300000000i32;
    let cl = |delta: i16| -> i64 {
        (cap_b as i64) + (cap_h as i64) + (cap_w as i64) + (delta as i64)
    };
    emit_line(cl(-500i16));

    0
}
