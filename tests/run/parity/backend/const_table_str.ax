// test: run
// modes: interp native
// exit: 0
// stdout: fn:2\n:0\nlet:3\nconst:5\napple:5:101:10\n:0:-42:20\ncherry:6:303:30\n

struct WordTable {
    w0: Str,
    w1: Str,
    w2: Str,
    w3: Str,
}

const WORDS: WordTable = WordTable {
    w0: "fn",
    w1: "",
    w2: "let",
    w3: "const",
};

struct Entry {
    name: Str,
    id: i32,
    tag: u32,
}

struct EntryTable {
    e0: Entry,
    e1: Entry,
    e2: Entry,
}

const TABLE: EntryTable = EntryTable {
    e0: Entry { name: "apple", id: 101, tag: 10u32 },
    e1: Entry { name: "", id: -42, tag: 20u32 },
    e2: Entry { name: "cherry", id: 303, tag: 30u32 },
};

fn emit_word(s: Str, n: usize) {
    print(s);
    print(":");
    print_int(n as i64);
    print("\n");
}

fn emit_entry(e: Entry) {
    let n = len(e.name);
    let id = e.id;
    let tag = e.tag;
    print(e.name);
    print(":");
    print_int(n as i64);
    print(":");
    print_int(id as i64);
    print(":");
    print_int(tag as i64);
    print("\n");
}

fn main() -> i32 {
    emit_word(WORDS.w0, len(WORDS.w0));
    emit_word(WORDS.w1, len(WORDS.w1));
    emit_word(WORDS.w2, len(WORDS.w2));
    emit_word(WORDS.w3, len(WORDS.w3));

    emit_entry(TABLE.e0);
    emit_entry(TABLE.e1);
    emit_entry(TABLE.e2);

    0
}
