// test: run
// modes: interp native
// exit: 0
// stdout: -1\n-2\n-300000\n-1\n-2147483648\n-42\n-1\n-32768\n-12345\n-1\n-128\n-77\n2147483648\n3000000000\n4294967295\n-10\n-20\n-30\n-40\n-100\n-200\n-300\n-400\n-55\n-1234\n-987654\n3500000000\n-7\n-89\n-9\n-999\n-99999\n4000000000\n

struct TripletI32 {
    x: i32,
    y: i32,
    z: i32,
}

struct TripletI16 {
    x: i16,
    y: i16,
    z: i16,
}

struct TripletI8 {
    x: i8,
    y: i8,
    z: i8,
}

struct TripletU32 {
    x: u32,
    y: u32,
    z: u32,
}

struct NarrowPacket {
    b: i8,
    h: i16,
    w: i32,
    u: u32,
}

fn emit_line(v: i64) {
    print_int(v);
    print("\n");
}

fn main() -> i32 {
    let a = (-1, -2, -300000);
    let (a0, a1, a2) = a;
    emit_line(a0 as i64);
    emit_line(a1 as i64);
    emit_line(a2 as i64);

    let a_i32 = TripletI32 { x: -1i32, y: -2147483648i32, z: -42i32 };
    emit_line(a_i32.x as i64);
    emit_line(a_i32.y as i64);
    emit_line(a_i32.z as i64);

    let a_i16 = TripletI16 { x: -1i16, y: -32768i16, z: -12345i16 };
    emit_line(a_i16.x as i64);
    emit_line(a_i16.y as i64);
    emit_line(a_i16.z as i64);

    let a_i8 = TripletI8 { x: -1i8, y: -128i8, z: -77i8 };
    emit_line(a_i8.x as i64);
    emit_line(a_i8.y as i64);
    emit_line(a_i8.z as i64);

    let a_u32 = TripletU32 { x: 2147483648u32, y: 3000000000u32, z: 4294967295u32 };
    emit_line(a_u32.x as i64);
    emit_line(a_u32.y as i64);
    emit_line(a_u32.z as i64);

    let nested = ((-10, -20), (-30, -40));
    let ((n00, n01), (n10, n11)) = nested;
    emit_line(n00 as i64);
    emit_line(n01 as i64);
    emit_line(n10 as i64);
    emit_line(n11 as i64);

    let ((m00, m01), (m10, m11)): ((i16, i16), (i16, i16)) = ((-100i16, -200i16), (-300i16, -400i16));
    emit_line(m00 as i64);
    emit_line(m01 as i64);
    emit_line(m10 as i64);
    emit_line(m11 as i64);

    let pkt = NarrowPacket {
        b: -55i8,
        h: -1234i16,
        w: -987654i32,
        u: 3500000000u32,
    };
    emit_line(pkt.b as i64);
    emit_line(pkt.h as i64);
    emit_line(pkt.w as i64);
    emit_line(pkt.u as i64);

    let (t0, t1) = (-7, -89);
    emit_line(t0 as i64);
    emit_line(t1 as i64);

    let (x8, x16, x32, xu32): (i8, i16, i32, u32) = (-9i8, -999i16, -99999i32, 4000000000u32);
    emit_line(x8 as i64);
    emit_line(x16 as i64);
    emit_line(x32 as i64);
    emit_line(xu32 as i64);

    0
}
