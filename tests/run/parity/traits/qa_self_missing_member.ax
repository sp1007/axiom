    type Item;
    fn get(self: view<Self>) -> Self.Itm; //~ ERROR AX_NAME_UNRESOLVED
}

struct P {
    v: i32,
}

impl P {
    fn bad(self: view<Self>) -> Self.Missing { //~ ERROR AX_NAME_UNRESOLVED
        0
    }
}

fn main() -> i32 {
    0
}
