// test: run
// modes: interp native
// exit: 0
// stdout: 7\n30\n1\n0\n1\n

// Two structs derive the same traits. Each derived method (`eq`, `hash`) is a separate function and must be
// emitted under a distinct symbol, otherwise the image fails to link (duplicate `hash`) or binds a call to the
// wrong type's body.

@lang("eq")
trait PartialEq {
    fn eq(self: view<Self>, other: view<Self>) -> bool;
}

trait Hasher {
    fn write_u32(self: mut_view<Self>, i: u32);
}

trait Hash {
    fn hash<H: Hasher>(self: view<Self>, state: mut_view<H>);
}

impl PartialEq for u32 {
    fn eq(self: view<u32>, other: view<u32>) -> bool { *self == *other }
}

impl Hash for u32 {
    fn hash<H: Hasher>(self: view<u32>, state: mut_view<H>) {
        state.write_u32(*self);
    }
}

struct SumHasher {
    val: u32,
}

impl Hasher for SumHasher {
    fn write_u32(self: mut_view<SumHasher>, i: u32) {
        self.val = self.val + i;
    }
}

@derive(PartialEq, Hash)
struct Point {
    x: u32,
    y: u32,
}

@derive(PartialEq, Hash)
struct Pair {
    a: u32,
    b: u32,
}

fn hash_point(p: view<Point>) -> u32 {
    let mut h = SumHasher { val: 0 };
    p.hash(mut_view(h));
    h.val
}

fn hash_pair(p: view<Pair>) -> u32 {
    let mut h = SumHasher { val: 0 };
    p.hash(mut_view(h));
    h.val
}

fn emit_line(v: i64) {
    print_int(v);
    print("\n");
}

fn flag(b: bool) -> i64 {
    if b { 1 } else { 0 }
}

fn main() -> i32 {
    let p1 = Point { x: 3, y: 4 };
    let p2 = Point { x: 3, y: 5 };
    let q1 = Pair { a: 10, b: 20 };
    let q2 = Pair { a: 10, b: 20 };
    emit_line(hash_point(view(p1)) as i64);
    emit_line(hash_pair(view(q1)) as i64);
    emit_line(flag(q1.eq(view(q2))));
    emit_line(flag(p1.eq(view(p2))));
    emit_line(flag(p1.eq(view(p1))));
    0
}
