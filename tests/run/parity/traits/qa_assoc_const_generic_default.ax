// test: run
// modes: interp native
// exit: 3
// stdout: 10\n25\n35\nbox\n42\n100\n42\n49\n7\n

// QA (T153 gate): crossing seams the engineer's tests do not cover.
// - `Type.CONST` for the same associated const name in two impls (distinct values), and a string const,
//   used as operands of arithmetic and of a call (mir operand-of-FIELD const case).
// - A default method reached through a generic bound (`T: Greet`) as well as directly: the default body must
//   be emitted as a monomorphization instance of the trait member and bound at both call sites.
// - A default method calling another default method (no required method involved: T161 is out of scope).
// - One generic instantiation only: a second `via_bound` instance with another impl hits a pre-existing
//   interpreter defect (both instances bind the first impl; native is correct), reported as a follow-up.
// - A non-zero exit value so the native leg checks more than "exit 0".

trait Sized2 {
    const CAP: i32;
    const NAME: str;
    fn size(self: view<Self>) -> i32;
}

struct Small {
    n: i32,
}

impl Sized2 for Small {
    const CAP: i32 = 10;
    const NAME: str = "box";
    fn size(self: view<Small>) -> i32 {
        self.n
    }
}

struct Large {
    n: i32,
}

impl Sized2 for Large {
    const CAP: i32 = 25;
    const NAME: str = "crate";
    fn size(self: view<Large>) -> i32 {
        self.n
    }
}

trait Greet {
    fn hello(self: view<Self>) -> i32 {
        42
    }
    fn hello_plus(self: view<Self>) -> i32 {
        self.hello() + 7
    }
}

struct A {
    id: i32,
}

impl Greet for A {}

struct B {
    id: i32,
}

impl Greet for B {
    fn hello(self: view<B>) -> i32 {
        100
    }
}

fn via_bound<T: Greet>(x: view<T>) -> i32 {
    x.hello()
}

fn emit_line(v: i64) {
    print_int(v);
    print("\n");
}

fn main() -> i32 {
    emit_line(Small.CAP as i64);
    emit_line(Large.CAP as i64);
    emit_line((Small.CAP + Large.CAP) as i64);
    print(Small.NAME);
    print("\n");
    let a = A { id: 1 };
    let b = B { id: 2 };
    emit_line(via_bound(view(a)) as i64);
    emit_line(b.hello() as i64);
    emit_line(a.hello() as i64);
    emit_line(a.hello_plus() as i64);
    let s = Small { n: 7 };
    emit_line(s.size() as i64);
    a.id + b.id
}
