// test: run
// modes: interp native
// exit: 0
// stdout: 42\n100\n5\n7\n7\n

// Two types implement the same trait: one keeps the default `hello`, one overrides it. A third type has an
// inherent method with the same name and no trait impl. All three `hello` functions must get distinct,
// correctly bound symbols in the built image (a bare name `hello` for all of them links the wrong body).

trait Greet {
    fn hello(self: view<Self>) -> i32 {
        42
    }
    fn bye(self: view<Self>) -> i32 {
        7
    }
}

struct DefaultUser {
    id: i32,
}

impl Greet for DefaultUser {}

struct CustomUser {
    id: i32,
}

impl Greet for CustomUser {
    fn hello(self: view<CustomUser>) -> i32 {
        100
    }
}

struct PlainUser {
    id: i32,
}

impl PlainUser {
    fn hello(self: view<PlainUser>) -> i32 {
        5
    }
}

fn emit_line(v: i32) {
    print_int(v as i64);
    print("\n");
}

fn main() -> i32 {
    let d = DefaultUser { id: 1 };
    let c = CustomUser { id: 2 };
    let p = PlainUser { id: 3 };
    emit_line(d.hello());
    emit_line(c.hello());
    emit_line(p.hello());
    emit_line(d.bye());
    emit_line(c.bye());
    if d.id + c.id + p.id != 6 {
        return 1;
    }
    0
}
