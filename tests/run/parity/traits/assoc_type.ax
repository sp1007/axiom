// test: run
// modes: interp native
// exit: 0
// stdout: 42\n-7\n3\n

// A trait whose method returns `Self.Item` (an associated type), implemented by two types that bind `Item`
// differently. The signature path `Self.Item` must resolve in the built image exactly as in the oracle.

trait Container {
    type Item;
    fn get(self: view<Self>) -> Self.Item;
}

struct IntBox {
    value: i32,
}

impl Container for IntBox {
    type Item = i32;
    fn get(self: view<IntBox>) -> Self.Item {
        self.value
    }
}

struct WideBox {
    value: i64,
}

impl Container for WideBox {
    type Item = i64;
    fn get(self: view<WideBox>) -> Self.Item {
        self.value
    }
}

fn emit_line(v: i64) {
    print_int(v);
    print("\n");
}

fn main() -> i32 {
    let a = IntBox { value: 42 };
    let b = WideBox { value: -7 };
    let x: i32 = a.get();
    let y: i64 = b.get();
    emit_line(x as i64);
    emit_line(y);
    emit_line((x as i64) + y - 32);
    0
}
