// test: run
// modes: interp native
// exit: 0
// stdout: 19\n25\n14\n22\n8\n24\n42\n91\n670\n123\n106\n701\n55\n702\n

fn emit_i32(v: i32) {
    print_int(v as i64);
    print("\n");
}

struct Pipeline {
    pre: fn(i32) -> i32,
    combine: fn(i32, i32) -> i32,
    post: fn(i32) -> i32,
}

struct Boxed {
    n: i32,
}

struct Guard {
    code: i32,
}

impl Drop for Guard {
    fn drop(self: mut_view<Guard>) {
        emit_i32(self.code);
    }
}

fn triple(x: i32) -> i32 {
    x * 3
}

fn take_boxed(b: Boxed) -> i32 {
    b.n
}

fn consume_guard(g: Guard) -> i32 {
    g.code - 646
}

fn run_pipe(p: view<Pipeline>, a: i32, b: i32) -> i32 {
    let pre = p.pre;
    let combine = p.combine;
    let post = p.post;
    let x = pre(a);
    let y = combine(x, b);
    post(y)
}

fn pick_return_fn(mode: i32) -> fn(i32) -> i32 {
    if mode == 0 {
        return |v| v + 4;
    }
    if mode == 1 {
        return triple;
    }
    return |v| v * v;
}

fn choose_match_fn(tag: i32) -> fn(i32) -> i32 {
    match tag {
        0 => triple,
        1 => |n| n + 15,
        _ => |n| n - 2,
    }
}

fn fold_twice<F: Fn>(f: F, seed: i32) -> i32 {
    let mid: i32 = f(seed);
    f(mid)
}

fn step_three<F: FnMut>(mut f: F, a: i32, b: i32, c: i32) -> i32 {
    let r1: i32 = f(a);
    let r2: i32 = f(b);
    let r3: i32 = f(c);
    r1 + r2 + r3
}

fn main() -> i32 {
    let mut pipe = Pipeline {
        pre: triple,
        combine: |lhs, rhs| lhs + rhs * 2,
        post: |z| z - 1,
    };
    emit_i32(run_pipe(view(pipe), 4, 4));

    pipe.post = |z| z + 5;
    emit_i32(run_pipe(view(pipe), 4, 4));

    let table: [3]fn(i32) -> i32 = [
        pick_return_fn(0),
        choose_match_fn(1),
        |k| k * 2 - 6,
    ];
    let f0 = table[0];
    let f1 = table[1];
    let f2 = table[2];
    emit_i32(f0(10));
    emit_i32(f1(7));
    emit_i32(f2(7));

    let offset: i32 = 3;
    let outer1 = |a: i32| -> i32 {
        offset + a + (|b: i32| b * 2)(4)
    };
    emit_i32(fold_twice(outer1, 2));

    let outer2 = |a: i32| -> i32 {
        let m: i32 = a + 10;
        (|b: i32| m + b)(2)
    };
    emit_i32(outer2(30));

    let s6 = (|a: i32, b: i32, c: i32, d: i32, e: i32, f: i32| {
        a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6
    })(1, 2, 3, 4, 5, 6);
    emit_i32(s6);

    let cv: i32 = 100;
    let mut cm: i32 = 20;
    let bx = Boxed { n: 7 };
    let mut mix6 = |p1: i32, p2: i32, p3: i32| -> i32 {
        cm = cm + p1;
        cv + cm + take_boxed(bx) + p2 * 10 + p3 * 100
    };
    emit_i32(mix6(3, 4, 5));
    emit_i32((|| cm + cv)());

    let mut acc: i32 = 0;
    let stepped = step_three(|d: i32| -> i32 {
        acc = acc + d;
        acc
    }, 1, 2, 3);
    emit_i32(stepped * 10 + acc);

    {
        let g_called = Guard { code: 701 };
        let g_unused = Guard { code: 702 };
        let c_called = || consume_guard(g_called);
        let _c_unused = || consume_guard(g_unused);
        let got = c_called();
        emit_i32(got);
    }

    0
}
