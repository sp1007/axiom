// test: run
// modes: interp native
// exit: 0
// stdout: 21\n16\n15\n24\n

fn emit_line(v: i64) {
    print_int(v);
    print("\n");
}

fn triple(x: i32) -> i32 {
    x * 3
}

fn apply_op(f: fn(i32) -> i32, x: i32) -> i32 {
    f(x)
}

fn main() -> i32 {
    let r1: i32 = apply_op(triple, 7);
    emit_line(r1 as i64);

    let r2: i32 = apply_op(|n: i32| n + 9, 7);
    emit_line(r2 as i64);

    let mut fp: fn(i32) -> i32 = triple;
    let r3: i32 = fp(5);
    emit_line(r3 as i64);

    fp = |n: i32| n * n - 1;
    let r4: i32 = fp(5);
    emit_line(r4 as i64);

    0
}
