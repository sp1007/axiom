// test: run
// modes: interp native
// exit: 0
// stdout: 33\n129\n

struct Tag {
    weight: i32,
}

fn emit_line(v: i64) {
    print_int(v);
    print("\n");
}

fn first_calc() -> i32 {
    let factor: i32 = 4;
    let mut offset: i32 = 10;
    let tag = Tag { weight: 3 };
    let mut compute = |x: i32| -> i32 {
        offset = offset + tag.weight;
        x * factor + offset
    };
    let res: i32 = compute(5);
    if tag.weight != 3 { return -1; }
    res
}

fn second_calc() -> i32 {
    let factor: i32 = 7;
    let mut offset: i32 = 100;
    let tag = Tag { weight: 6 };
    let mut compute = |x: i32| -> i32 {
        offset = offset - tag.weight;
        x * factor + offset
    };
    let res: i32 = compute(5);
    if tag.weight != 6 { return -1; }
    res
}

fn main() -> i32 {
    let r1: i32 = first_calc();
    let r2: i32 = second_calc();
    if r1 != 33 { return 1; }
    if r2 != 129 { return 2; }
    emit_line(r1 as i64);
    emit_line(r2 as i64);
    0
}
