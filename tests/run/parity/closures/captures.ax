// test: run
// modes: interp native
// exit: 0
// stdout: 25\n17\n42\n

struct Boxed {
    val: i32,
}

fn consume_boxed(b: Boxed) -> i32 {
    b.val
}

fn emit_line(v: i64) {
    print_int(v);
    print("\n");
}

fn main() -> i32 {
    // 1. Capture by view (non-Copy struct borrowed immutably, still live after call)
    let shared = Boxed { val: 20 };
    let by_view = |delta: i32| -> i32 {
        let out: i32 = shared.val + delta;
        emit_line(out as i64);
        out
    };
    let r1: i32 = by_view(5);
    if r1 != 25 { return 1; }
    if shared.val != 20 { return 2; }

    // 2. Capture by mut_view (mutates outer binding in place)
    let mut acc: i32 = 10;
    let mut by_mut_view = |step: i32| -> i32 {
        acc = acc + step;
        emit_line(acc as i64);
        acc
    };
    let r2: i32 = by_mut_view(7);
    if r2 != 17 { return 3; }
    if acc != 17 { return 4; }

    // 3. Capture by move (consumes non-Copy struct inside closure body)
    let owned = Boxed { val: 30 };
    let by_move = |extra: i32| -> i32 {
        let out: i32 = consume_boxed(owned) + extra;
        emit_line(out as i64);
        out
    };
    let r3: i32 = by_move(12);
    if r3 != 42 { return 5; }

    0
}
