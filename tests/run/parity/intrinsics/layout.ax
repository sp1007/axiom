// test: run
// modes: interp native
// stdout: 4\n8\n16\nfalse\ntrue\n

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn needs_drop<T>() -> bool { false }

struct HasDrop {
    x: i32,
}

impl Drop for HasDrop {
    fn drop(self: mut_view<HasDrop>) {
    }
}

fn print_digit(d: usize) {
    if d == 0 { print("0"); }
    else if d == 1 { print("1"); }
    else if d == 2 { print("2"); }
    else if d == 3 { print("3"); }
    else if d == 4 { print("4"); }
    else if d == 5 { print("5"); }
    else if d == 6 { print("6"); }
    else if d == 7 { print("7"); }
    else if d == 8 { print("8"); }
    else { print("9"); }
}

fn print_usize_ln(v: usize) {
    if v >= 10 {
        print_digit(v / 10);
    }
    print_digit(v % 10);
    print("\n");
}

fn print_bool_ln(b: bool) {
    if b {
        print("true\n");
    } else {
        print("false\n");
    }
}

fn main() -> i32 {
    let s_i32 = size_of<i32>();
    let a_i64 = align_of<i64>();
    let s_arr = size_of<[4]i32>();
    let nd_i32 = needs_drop<i32>();
    let nd_hd = needs_drop<HasDrop>();

    print_usize_ln(s_i32);
    print_usize_ln(a_i64);
    print_usize_ln(s_arr);
    print_bool_ln(nd_i32);
    print_bool_ln(nd_hd);

    if s_i32 != 4 { return 1; }
    if a_i64 != 8 { return 2; }
    if s_arr != 16 { return 3; }
    if nd_i32 != false { return 4; }
    if nd_hd != true { return 5; }
    0
}
