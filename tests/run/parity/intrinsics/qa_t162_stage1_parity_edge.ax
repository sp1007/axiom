// test: run
// modes: interp native
// exit: 0
// stdout: 42\n186\n

@intrinsic fn wrapping_add_u64(a: u64, b: u64) -> u64 { a }
@intrinsic fn wrapping_sub_u64(a: u64, b: u64) -> u64 { a }
@intrinsic fn wrapping_mul_u64(a: u64, b: u64) -> u64 { a }
@intrinsic fn wrapping_add_i32(a: i32, b: i32) -> i32 { a }
@intrinsic fn wrapping_sub_i32(a: i32, b: i32) -> i32 { a }
@intrinsic fn wrapping_mul_i32(a: i32, b: i32) -> i32 { a }

trait StepHash {
    fn bias(self: view<Self>) -> u64;
    fn step(self: view<Self>, x: u64) -> u64 {
        x + self.bias()
    }
}

struct DefaultStepper {
    tag: u64,
}

struct CustomStepper {
    extra: u64,
}

struct OverrideStepper {
    fixed: u64,
}

impl StepHash for DefaultStepper {
    fn bias(self: view<DefaultStepper>) -> u64 {
        self.tag
    }
}

impl StepHash for CustomStepper {
    fn bias(self: view<CustomStepper>) -> u64 {
        self.extra
    }
}

impl StepHash for OverrideStepper {
    fn bias(self: view<OverrideStepper>) -> u64 {
        0u64
    }
    fn step(self: view<OverrideStepper>, x: u64) -> u64 {
        self.fixed
    }
}

struct Bucket {
    slots: [4]i32,
}

fn bucket_new() -> Bucket {
    Bucket {
        slots: [0; 4],
    }
}

fn bucket_set(b: mut_view<Bucket>, idx: usize, val: i32) {
    b.slots[idx] = val;
}

fn classify_diverging_if_else(v: u64) -> u64 {
    if v == 0u64 {
        return 11u64;
    } else if v == 1u64 {
        return 22u64;
    } else {
        return 42u64;
    }
}

fn sum_i32_array(b: view<Bucket>) -> i32 {
    b.slots[0] + b.slots[1] + b.slots[2] + b.slots[3]
}

fn main() -> i32 {
    // 1. Wrapping unsigned & signed boundary arithmetic
    let u_max: u64 = 0xFFFFFFFFFFFFFFFFu64;
    let wa = wrapping_add_u64(u_max, 2u64); // 1
    let ws = wrapping_sub_u64(0u64, 1u64);  // u_max
    let wm = wrapping_mul_u64(0x8000000000000001u64, 2u64); // 2
    if wa != 1u64 || ws != u_max || wm != 2u64 {
        return 1;
    }

    let i_max: i32 = 2147483647;
    let i_min: i32 = -2147483647 - 1;
    let sa = wrapping_add_i32(i_max, 1); // i_min
    let ss = wrapping_sub_i32(i_min, 1); // i_max
    let sm = wrapping_mul_i32(1073741824, 2); // i_min
    if sa != i_min || ss != i_max || sm != i_min {
        return 2;
    }

    // 2. Unreachable join block after exhaustive if/else return chain
    let c = classify_diverging_if_else(wa + wm);
    if c != 42u64 {
        return 3;
    }
    print("42\n");

    // 3. Array repeat [val; N] with unsuffixed integer literal inference (TY_INT_VAR inside TY_ARRAY)
    let mut b = bucket_new();
    let rep: [4]i32 = [7; 4];
    bucket_set(mut_view(b), 0, rep[0]);
    bucket_set(mut_view(b), 1, wrapping_add_i32(rep[1], 3)); // 7 + 3 = 10
    bucket_set(mut_view(b), 2, rep[2]);
    bucket_set(mut_view(b), 3, rep[3]);
    let arr_sum = sum_i32_array(view(b)) as u64;             // 7 + 10 + 7 + 7 = 31

    // 4. Trait default method vs partial override across three impls
    let d = DefaultStepper { tag: 10u64 };
    let k = CustomStepper { extra: 50u64 };
    let ov = OverrideStepper { fixed: 77u64 };
    let r1 = d.step(9u64);   // 9 + 10 = 19
    let r2 = k.step(9u64);   // 9 + 50 = 59
    let r3 = ov.step(9u64);  // 77
    let total = wrapping_add_u64(arr_sum + r1, r2 + r3); // 31 + 19 + 59 + 77 = 186
    if total != 186u64 {
        return 4;
    }
    print("186\n");
    0
}
