// test: run
// modes: interp native
// stdout: 783\n

@intrinsic fn wrapping_add_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn rotate_left_u32(a: u32, b: u32) -> u32 { 0 }
@intrinsic fn count_ones_u32(a: u32) -> u32 { 0 }

fn main() -> i32 {
    let x = wrapping_add_u64(3, 4);
    let y = rotate_left_u32(1, 3);
    let z = count_ones_u32(7);
    let v = x * 100 + (y as u64) * 10 + (z as u64);
    if v == 783 {
        print("783\n");
        return 0;
    }
    1
}
