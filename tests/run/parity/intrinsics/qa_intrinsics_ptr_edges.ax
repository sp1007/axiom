// test: run
// modes: interp native
// stdout: 88\n268\n90\n165\n12\n128\n

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn needs_drop<T>() -> bool { false }
@intrinsic unsafe fn drop_in_place<T>(ptr: *mut T) {}
@intrinsic fn null<T>() -> *const T { 0 as *const T }
@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }
@intrinsic fn is_null<T>(p: *const T) -> bool { false }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_add<T>(p: *const T, count: usize) -> *const T { p }
@intrinsic unsafe fn ptr_sub<T>(p: *const T, count: usize) -> *const T { p }
@intrinsic unsafe fn ptr_copy<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic unsafe fn ptr_write_bytes<T>(dst: *mut T, val: u8, count: usize) {}
@intrinsic fn wrapping_add_u8(a: u8, b: u8) -> u8 { a }
@intrinsic fn wrapping_sub_u8(a: u8, b: u8) -> u8 { a }
@intrinsic fn wrapping_mul_i16(a: i16, b: i16) -> i16 { a }
@intrinsic fn wrapping_neg_i8(a: i8) -> i8 { a }
@intrinsic fn rotate_left_u16(a: u16, n: u32) -> u16 { a }
@intrinsic fn rotate_right_i8(a: i8, n: u32) -> i8 { a }
@intrinsic fn count_ones_i8(a: i8) -> u32 { 0u32 }
@intrinsic fn leading_zeros_i8(a: i8) -> u32 { 0u32 }
@intrinsic fn leading_zeros_u16(a: u16) -> u32 { 0u32 }
@intrinsic fn trailing_zeros_u64(a: u64) -> u32 { 0u32 }

struct Dropper {
    counter: *mut i32,
    tag: i32,
}

impl Drop for Dropper {
    fn drop(self: mut_view<Dropper>) {
        if !is_null<i32>(self.counter) {
            unsafe { *self.counter = *self.counter + self.tag; }
        }
    }
}

unsafe fn read_via_const(p: *const u64) -> u64 {
    *p
}

fn print_u32(v: u32) {
    if v >= 10u32 {
        print_u32(v / 10u32);
    }
    let d = v % 10u32;
    if d == 0u32 { print("0"); }
    else if d == 1u32 { print("1"); }
    else if d == 2u32 { print("2"); }
    else if d == 3u32 { print("3"); }
    else if d == 4u32 { print("4"); }
    else if d == 5u32 { print("5"); }
    else if d == 6u32 { print("6"); }
    else if d == 7u32 { print("7"); }
    else if d == 8u32 { print("8"); }
    else { print("9"); }
}

fn print_u32_ln(v: u32) {
    print_u32(v);
    print("\n");
}

fn main() -> i32 {
    // 1. Concrete layout + needs_drop (8*10 + 8 + 0 = 88; 16*10 + 8 + 100 = 268)
    let l_u64 = size_of<u64>() * 10usize + align_of<u64>() + (if needs_drop<u64>() { 100usize } else { 0usize });
    let l_drp = size_of<Dropper>() * 10usize + align_of<Dropper>() + (if needs_drop<Dropper>() { 100usize } else { 0usize });
    print_u32_ln(l_u64 as u32);
    print_u32_ln(l_drp as u32);
    if l_u64 != 88usize { return 1; }
    if l_drp != 268usize { return 2; }

    // 2. null / null_mut / is_null + *mut T -> *const T implicit coercion
    let np: *const u64 = null<u64>();
    let nmp: *mut u64 = null_mut<u64>();
    if !is_null<u64>(np) { return 3; }
    if !is_null<u64>(nmp) { return 4; }

    let mut arr: [5]u64 = [10u64, 20u64, 30u64, 40u64, 50u64];
    let p0: *mut u64 = unsafe { address_of_mut(arr[0]) };
    let p0c: *const u64 = p0;
    if is_null<u64>(p0) { return 5; }
    if unsafe { read_via_const(p0) } != 10u64 { return 6; }

    // 3. Pointer comparisons, ptr_add, ptr_sub, p + i, p - i
    let p3: *const u64 = unsafe { ptr_add<u64>(p0c, 3usize) };
    let p1: *const u64 = unsafe { ptr_sub<u64>(p3, 2usize) };
    if !(p0c < p3 && p1 > p0c && p1 <= p3 && p3 >= p1 && p1 != p3) { return 7; }
    if unsafe { *p3 } != 40u64 { return 8; }
    if unsafe { *p1 } != 20u64 { return 9; }
    let p4 = unsafe { (p1 + 3usize) - 1usize };
    if unsafe { *p4 } != 40u64 { return 10; }

    // 4. Overlapping ptr_copy forward ([0..4] -> [1..5]) and backward ([2..5] -> [0..3])
    unsafe { ptr_copy<u64>(p0, p0 + 1usize, 4usize); }
    if arr[0] != 10u64 || arr[1] != 10u64 || arr[2] != 20u64 || arr[3] != 30u64 || arr[4] != 40u64 {
        return 11;
    }
    unsafe { ptr_copy<u64>(p0 + 2usize, p0, 3usize); }
    if arr[0] != 20u64 || arr[1] != 30u64 || arr[2] != 40u64 { return 12; }
    print_u32_ln((arr[0] + arr[1] + arr[2]) as u32);

    // 5. ptr_write_bytes + ptr_copy_nonoverlapping (77 + 88 = 165)
    let mut dst: [3]u32 = [1u32, 2u32, 3u32];
    let dp: *mut u32 = unsafe { address_of_mut(dst[0]) };
    unsafe { ptr_write_bytes<u32>(dp, 0x01u8, 2usize); }
    if dst[0] != 0x01010101u32 || dst[1] != 0x01010101u32 || dst[2] != 3u32 { return 13; }
    let src: [2]u32 = [77u32, 88u32];
    unsafe { ptr_copy_nonoverlapping<u32>(address_of(src[0]), dp + 1usize, 2usize); }
    if dst[0] != 0x01010101u32 || dst[1] != 77u32 || dst[2] != 88u32 { return 14; }
    print_u32_ln(dst[1] + dst[2]);

    // 6. drop_in_place<Dropper> + raw pointer field auto-deref read/write (7 + 5 = 12)
    let mut drops: i32 = 0;
    let drops_ptr: *mut i32 = unsafe { address_of_mut(drops) };
    {
        let mut d = Dropper { counter: drops_ptr, tag: 7 };
        let dp_d: *mut Dropper = unsafe { address_of_mut(d) };
        if unsafe { dp_d.tag } != 7 { return 15; }
        unsafe { drop_in_place<Dropper>(dp_d); }
        if drops != 7 { return 16; }
        unsafe { dp_d.tag = 5; }
    }
    print_u32_ln(drops as u32);
    if drops != 12 { return 17; }

    // 7. Pointer <-> integer casts
    let addr = p0 as usize;
    let roundtrip = addr as *const u64;
    if roundtrip != p0c { return 18; }

    // 8. Signed & boundary width-suffixed intrinsics
    let wa = wrapping_add_u8(255u8, 1u8);          // 0
    let ws = wrapping_sub_u8(0u8, 1u8);            // 255
    let wm = wrapping_mul_i16(-300i16, 200i16);    // -60000 + 65536 = 5536
    let wn = wrapping_neg_i8(-128i8);              // -128
    let rl0 = rotate_left_u16(0x1234u16, 0u32);    // 0x1234
    let rl1 = rotate_left_u16(0x8001u16, 1u32);    // 0x0003
    let rr = rotate_right_i8(-128i8, 1u32);        // 64
    let co = count_ones_i8(-1i8);                  // 8
    let lz_neg = leading_zeros_i8(-1i8);           // 0
    let lz_zero = leading_zeros_u16(0u16);         // 16
    let tz_zero = trailing_zeros_u64(0u64);        // 64
    let tz_bit = trailing_zeros_u64(1u64 << 40u32);// 40
    if wa != 0u8 || ws != 255u8 || wm != 5536i16 || wn != -128i8 || rl0 != 0x1234u16 || rl1 != 3u16 || rr != 64i8 {
        return 19;
    }
    let bit_sum = co + lz_neg + lz_zero + tz_zero + tz_bit; // 8 + 0 + 16 + 64 + 40 = 128
    print_u32_ln(bit_sum);
    if bit_sum != 128u32 { return 20; }

    0
}
