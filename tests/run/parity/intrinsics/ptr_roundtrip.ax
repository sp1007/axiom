// test: run
// modes: interp native
// stdout: 42\n

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

fn print_digit(d: i32) {
    if d == 0 { print("0"); }
    else if d == 1 { print("1"); }
    else if d == 2 { print("2"); }
    else if d == 3 { print("3"); }
    else if d == 4 { print("4"); }
    else if d == 5 { print("5"); }
    else if d == 6 { print("6"); }
    else if d == 7 { print("7"); }
    else if d == 8 { print("8"); }
    else { print("9"); }
}

fn print_i32_ln(v: i32) {
    if v >= 10 {
        print_digit(v / 10);
    }
    print_digit(v % 10);
    print("\n");
}

fn main() -> i32 {
    let mut arr: [4]i32 = [10, 20, 30, 40];
    unsafe {
        let p: *mut i32 = address_of_mut(arr[0]);
        *(p + 2) = 42;
        let got_ptr = *(p + 2);
        let got_arr = arr[2];
        print_i32_ln(got_arr);
        if got_ptr != 42 { return 1; }
        if got_arr != 42 { return 2; }
    }
    0
}
