const LEN: i32 = 2 + 2;

fn first_of_slice(s: view<[i32]>) -> i32 {
    let pair: (i32, i64) = (10 as i32, 20 as i64);
    s[0] + pair.0 + (pair.1 as i32)
}

fn main() -> i32 {
    let arr: [LEN]i32 = [1, 2, 3, 4];
    let base = first_of_slice(view(arr));
    let z = base[0];
    //~^ ERROR AX_TYPE_CANNOT_INDEX
    z
}
