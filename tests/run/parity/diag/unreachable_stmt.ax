// test: ui
// T156 (ADR-0035 section 3): diagnostic message text parity for AX_TYPE_UNREACHABLE.
// stderr: warning[AX_TYPE_UNREACHABLE]: unreachable statement\n --> tests/run/parity/diag/unreachable_stmt.ax:16:5\n   | \n16 |     v = v + 35;\n   |     ^\n   | \n\n0 errors, 1 warning\n

enum Flag {
    Early,
    Keep,
}

fn helper(f: Flag) -> i32 {
    let mut v = 0;
    match f {
        Flag.Early => { return 1; },
        Flag.Keep => { v = 7; },
    }
    v = v + 35;
    //~^ WARN AX_TYPE_UNREACHABLE
    v
}

fn main() -> i32 {
    print_int(helper(Flag.Keep));
    print("\n");
    0
}
