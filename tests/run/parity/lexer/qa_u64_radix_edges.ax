// test: run
// modes: interp native
// exit: 0
// stdout: 18446744073709551615\n
// stdout: 1152921504606846975\n
// stdout: 2305843009213693951\n
// stdout: 9223372036854775807\n
// stdout: 119\n
// stdout: 9\n

const C_DEC_LZ_MAX: u64 = 000018446744073709551615u64;
const C_OCT_MAX: u64 = 0o1777777777777777777777u64;

fn print_digit(d: u64) {
    if d == 0u64 {
        print("0");
    } else if d == 1u64 {
        print("1");
    } else if d == 2u64 {
        print("2");
    } else if d == 3u64 {
        print("3");
    } else if d == 4u64 {
        print("4");
    } else if d == 5u64 {
        print("5");
    } else if d == 6u64 {
        print("6");
    } else if d == 7u64 {
        print("7");
    } else if d == 8u64 {
        print("8");
    } else {
        print("9");
    }
}

fn print_u64_ln(n: u64) {
    if n >= 10u64 {
        print_u64_rec(n / 10u64);
    }
    print_digit(n % 10u64);
    print("\n");
}

fn print_u64_rec(n: u64) {
    if n >= 10u64 {
        print_u64_rec(n / 10u64);
    }
    print_digit(n % 10u64);
}

fn classify_edge(x: u64) -> u64 {
    match x {
        18446744073709551610u64 => 10u64,
        18446744073709551614u64 => 14u64,
        18446744073709551615u64 => 15u64,
        0x8000_0000_0000_0000u64 => 80u64,
        _ => 0u64,
    }
}

fn main() -> i32 {
    let hex_max: u64 = 0xFFFF_FFFF_FFFF_FFFFu64;
    let hex_lz_mix: u64 = 0x0000_ffff_FFFF_ffff_FFFFu64;
    let oct_unsep: u64 = 0o1777777777777777777777u64;
    let oct_lz: u64 = 0o000_1777777777777777777777u64;
    let bin_bytes: u64 = 0b11111111_11111111_11111111_11111111_11111111_11111111_11111111_11111111u64;
    let bin_lz_usize: usize = 0b0000_11111111_11111111_11111111_11111111_11111111_11111111_11111111_11111111usize;
    let dec_sep: u64 = 18_446_744_073_709_551_615u64;
    let dec_prev_inc: u64 = 18446744073709551614u64 + 1u64;
    let dec_lz: u64 = 000018446744073709551615u64;
    let dec_lz_unsuf: u64 = 0000_1844_6744_0737_0955_1615;

    // Scanner quotient bounds max_q in bases 16, 8, 2, 10:
    let max_q_hex: u64 = 0x0FFF_FFFF_FFFF_FFFFu64;
    let max_q_oct: u64 = 0o177777777777777777777u64;
    let max_q_bin: u64 = 0b01111111_11111111_11111111_11111111_11111111_11111111_11111111_11111111u64;
    let max_q_dec: u64 = 1844674407370955161u64;
    let max_q_dec_x10: u64 = 18446744073709551610u64;
    let i64_hi: i64 = 9223372036854775807i64;
    let isize_hi: isize = 9223372036854775807isize;

    print_u64_ln(dec_lz);
    print_u64_ln(max_q_hex);
    print_u64_ln(max_q_oct);
    print_u64_ln(max_q_bin);

    let msum: u64 = classify_edge(max_q_dec_x10) +
        classify_edge(18446744073709551614u64) +
        classify_edge(C_DEC_LZ_MAX) +
        classify_edge(9223372036854775808u64) +
        classify_edge(max_q_dec);
    print_u64_ln(msum);

    // AXS-LEX-056: `..` directly after 20-digit integer literals must lex as Int DotDot Int, not Float
    let mut rsum: u64 = 0u64;
    for v in 18446744073709551612u64..18446744073709551615u64 {
        rsum = rsum + (v - 18446744073709551610u64);
    }
    print_u64_ln(rsum);

    if hex_max != dec_sep || hex_lz_mix != dec_sep {
        return 1;
    }
    if oct_unsep != dec_sep || oct_lz != dec_sep || C_OCT_MAX != dec_sep {
        return 2;
    }
    if bin_bytes != dec_sep || (bin_lz_usize as u64) != dec_sep {
        return 3;
    }
    if dec_prev_inc != dec_sep || dec_lz != dec_sep || dec_lz_unsuf != dec_sep || C_DEC_LZ_MAX != dec_sep {
        return 4;
    }
    if (dec_sep >> 4u32) != max_q_hex || (dec_sep >> 3u32) != max_q_oct || (dec_sep >> 1u32) != max_q_bin {
        return 5;
    }
    if max_q_dec * 10u64 != max_q_dec_x10 || max_q_dec_x10 + 5u64 != dec_sep {
        return 6;
    }
    if (i64_hi as u64) != max_q_bin || (isize_hi as u64) != max_q_bin {
        return 7;
    }
    if msum != 119u64 || rsum != 9u64 {
        return 8;
    }
    0
}
