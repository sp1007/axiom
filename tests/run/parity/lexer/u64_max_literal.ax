// test: run
// modes: interp native
// exit: 0
// stdout: 18446744073709551615\n
// stdout: true\n
// stdout: 4611686018427387904\n

fn print_digit(d: u64) {
    if d == 0u64 {
        print("0");
    } else if d == 1u64 {
        print("1");
    } else if d == 2u64 {
        print("2");
    } else if d == 3u64 {
        print("3");
    } else if d == 4u64 {
        print("4");
    } else if d == 5u64 {
        print("5");
    } else if d == 6u64 {
        print("6");
    } else if d == 7u64 {
        print("7");
    } else if d == 8u64 {
        print("8");
    } else {
        print("9");
    }
}

fn print_u64(n: u64) {
    if n >= 10u64 {
        print_u64(n / 10u64);
    }
    print_digit(n % 10u64);
}

fn main() -> i32 {
    let dec_max: u64 = 18446744073709551615u64;
    let dec_unsuf: u64 = 18446744073709551615;
    let dec_sep: u64 = 18_446_744_073_709_551_615u64;
    let hex_max: u64 = 0xFFFF_FFFF_FFFF_FFFFu64;
    let oct_max: u64 = 0o1_777_777_777_777_777_777_777u64;
    let bin_max: u64 = 0b1111_1111_1111_1111_1111_1111_1111_1111_1111_1111_1111_1111_1111_1111_1111_1111u64;
    let usize_max: usize = 18446744073709551615usize;
    let high_bit: u64 = 9223372036854775808u64;
    let half: u64 = 9223372036854775808u64 / 2u64;

    print_u64(dec_max);
    print("\n");

    let eq: bool = 0xFFFF_FFFF_FFFF_FFFFu64 == 18446744073709551615u64;
    if eq {
        print("true\n");
    } else {
        print("false\n");
    }

    print_u64(half);
    print("\n");

    if !eq || hex_max != dec_max {
        return 1;
    }
    if dec_max != dec_unsuf || dec_max != dec_sep {
        return 2;
    }
    if dec_max != oct_max || dec_max != bin_max {
        return 3;
    }
    if (usize_max as u64) != dec_max {
        return 4;
    }
    if half != 4611686018427387904u64 {
        return 5;
    }
    if high_bit - 1u64 != 9223372036854775807u64 {
        return 6;
    }
    if dec_max - 1u64 != 18446744073709551614u64 {
        return 7;
    }
    if dec_max / 10u64 != 1844674407370955161u64 || dec_max % 10u64 != 5u64 {
        return 8;
    }
    0
}
