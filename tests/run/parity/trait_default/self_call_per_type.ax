// test: run
// modes: interp native
// exit: 0
// stdout: 18\n20\n77\n9\n10\n11\n

// T161: a trait default method is instantiated per implementing type. `self.base()` inside the
// default body `twice` binds to the impl of the receiver's type, not to the first impl (0133 §8, §9).
// C overrides `twice`, so its own body runs.

trait Base {
    fn base(self: view<Self>) -> i32;
    fn twice(self: view<Self>) -> i32 {
        self.base() * 2
    }
}

struct A {
    x: i32,
}

struct B {
    x: i32,
}

struct C {
    x: i32,
}

impl Base for A {
    fn base(self: view<A>) -> i32 {
        9
    }
}

impl Base for B {
    fn base(self: view<B>) -> i32 {
        10
    }
}

impl Base for C {
    fn base(self: view<C>) -> i32 {
        11
    }
    fn twice(self: view<C>) -> i32 {
        77
    }
}

fn show(v: i32) {
    print_int(v as i64);
    print("\n");
}

fn main() {
    let a = A { x: 1 };
    let b = B { x: 2 };
    let c = C { x: 3 };
    show(a.twice());
    show(b.twice());
    show(c.twice());
    show(a.base());
    show(b.base());
    show(c.base());
}
