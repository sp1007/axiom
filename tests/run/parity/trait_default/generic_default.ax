// test: run
// modes: interp native
// exit: 0
// stdout: 7\n70000000000\n0\n1\n2\n10\n

// T161: a default method with its own type parameter `U`, used by two implementing types. `Self` and
// `U` are distinct parameters (0133 §8, §9): `self.weight()` binds to the implementing impl, and `U`
// is instantiated per call (i64, bool) independently of `Self`.
// Out of scope here: a trait-method call on a value of type `U` (`u.weight()`): in `run --interp` it
// is the generic-call dispatch defect reported by the T153 gate (T161 report, follow-ups).

trait Weigh {
    fn weight(self: view<Self>) -> i32;
    fn either<U>(self: view<Self>, big: U, small: U) -> U {
        if self.weight() > 5 {
            big
        } else {
            small
        }
    }
}

struct Light {
    w: i32,
}

struct Heavy {
    w: i32,
}

impl Weigh for Light {
    fn weight(self: view<Light>) -> i32 {
        self.w
    }
}

impl Weigh for Heavy {
    fn weight(self: view<Heavy>) -> i32 {
        self.w * 10
    }
}

fn show(v: i64) {
    print_int(v);
    print("\n");
}

fn bit(b: bool) -> i64 {
    if b {
        1
    } else {
        0
    }
}

fn main() {
    let l = Light { w: 2 };
    let h = Heavy { w: 1 };
    let big: i64 = 70000000000;
    show(l.either(big, 7));
    show(h.either(big, 7));
    show(bit(l.either(true, false)));
    show(bit(h.either(true, false)));
    show(l.weight() as i64);
    show(h.weight() as i64);
}
