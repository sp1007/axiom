// test: run
// modes: interp native
// exit: 0
// stdout: 103\n206\n4\n104\n208\n

// T161: a subtrait default method calls a method of its supertrait on `self`. For each implementing
// type the call binds to that type's impl of the supertrait (0133 §9, §14), and a default calling
// another default of the same trait keeps `Self` = the implementing type.

trait Named {
    fn code(self: view<Self>) -> i32;
}

trait Tagged: Named {
    fn tag(self: view<Self>) -> i32 {
        self.code() + 100
    }
    fn double_tag(self: view<Self>) -> i32 {
        self.tag() * 2
    }
}

struct P {
    v: i32,
}

struct Q {
    v: i32,
}

impl Named for P {
    fn code(self: view<P>) -> i32 {
        3
    }
}

impl Named for Q {
    fn code(self: view<Q>) -> i32 {
        self.v
    }
}

impl Tagged for P {}

impl Tagged for Q {}

fn show(v: i32) {
    print_int(v as i64);
    print("\n");
}

fn main() {
    let p = P { v: 1 };
    let q = Q { v: 4 };
    show(p.tag());
    show(p.double_tag());
    show(q.code());
    show(q.tag());
    show(q.double_tag());
}
