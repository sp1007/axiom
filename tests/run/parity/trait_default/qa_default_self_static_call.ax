// test: run
// modes: interp native
// exit: 0
// stdout: 8\n80\n5\n41\n40\n

// QA (T161 gate, finding F1): a `Self` path call of a static (receiver-less) trait member inside a
// default body, `Self.k()`, must bind to the implementing type's impl (0133 A§8, A§9; task scope:
// "method calls and `Self` paths inside the body ... resolve against that type's impl"). With
// A.k() = 4 and B.k() = 40: A.twice_k() = 8, B.twice_k() = 80, a.via_self() = 5, b.via_self() = 41.
// Round 0 prints 8 8 5 5 40 in both legs: the call has no receiver argument, so the MIR
// instantiation (mono.c ax_mono_instantiate_default / builder.ax mb_instantiate_default) skips it
// (`arg_count == 0`) and it keeps the first impl's member.

trait Base {
    fn k() -> i32;
    fn twice_k() -> i32 {
        Self.k() * 2
    }
    fn via_self(self: view<Self>) -> i32 {
        Self.k() + 1
    }
}

struct A {
    v: i32,
}

struct B {
    v: i32,
}

impl Base for A {
    fn k() -> i32 {
        4
    }
}

impl Base for B {
    fn k() -> i32 {
        40
    }
}

fn show(v: i32) {
    print_int(v as i64);
    print("\n");
}

fn main() {
    let a = A { v: 0 };
    let b = B { v: 0 };
    show(A.twice_k());
    show(B.twice_k());
    show(a.via_self());
    show(b.via_self());
    show(B.k());
}
