// test: run
// modes: interp native
// exit: 0
// stdout: 30\n50\n120\n1002\n2004\n3007\n409\n707\n5\n12\n7\n45\n

// QA (T161 gate): seams the engineer's tests do not cover.
// - A default (`outer`) calling another default (`inner`) that calls a per-type required method
//   (`base`); three types, C overrides only the inner default, so A/B run both defaults and C runs the
//   default `outer` over its own `inner` (0133 A§8, A§9).
// - `Self.K + self.base()` in one default body (const and method of the same impl).
// - A default taking a second `view<Self>` argument.
// - A recursive default (`down` calls itself): the recursion stays in the type's own instance.
// - A default of a second trait taking and returning `Self` by value (`bump2` calls `bump` twice).

trait Base {
    const K: i32;
    fn base(self: view<Self>) -> i32;
    fn inner(self: view<Self>) -> i32 {
        self.base() + 1
    }
    fn outer(self: view<Self>) -> i32 {
        self.inner() * 10
    }
    fn mixed(self: view<Self>) -> i32 {
        Self.K + self.base()
    }
    fn pair(self: view<Self>, other: view<Self>) -> i32 {
        self.base() * 100 + other.base()
    }
    fn down(self: view<Self>, n: i32) -> i32 {
        if n == 0 {
            self.base()
        } else {
            self.down(n - 1) + 1
        }
    }
}

trait Bump {
    fn bump(self: Self) -> Self;
    fn bump2(self: Self) -> Self {
        let x = self.bump();
        x.bump()
    }
}

struct A {
    v: i32,
}

struct B {
    v: i32,
}

struct C {
    v: i32,
}

impl Base for A {
    const K: i32 = 1000;
    fn base(self: view<A>) -> i32 {
        2
    }
}

impl Base for B {
    const K: i32 = 2000;
    fn base(self: view<B>) -> i32 {
        self.v
    }
}

impl Base for C {
    const K: i32 = 3000;
    fn base(self: view<C>) -> i32 {
        7
    }
    fn inner(self: view<C>) -> i32 {
        self.base() + 5
    }
}

impl Bump for A {
    fn bump(self: A) -> A {
        A { v: self.v + 1 }
    }
}

impl Bump for B {
    fn bump(self: B) -> B {
        B { v: self.v * 3 }
    }
}

fn show(v: i32) {
    print_int(v as i64);
    print("\n");
}

fn main() {
    let a = A { v: 0 };
    let b = B { v: 4 };
    let c = C { v: 0 };
    show(a.outer());
    show(b.outer());
    show(c.outer());
    show(a.mixed());
    show(b.mixed());
    show(c.mixed());
    let b2 = B { v: 9 };
    show(b.pair(view(b2)));
    show(c.pair(view(c)));
    show(a.down(3));
    show(c.down(5));
    let a5 = A { v: 5 };
    let b5 = B { v: 5 };
    let a7 = a5.bump2();
    show(a7.v);
    let b45 = b5.bump2();
    show(b45.v);
}
