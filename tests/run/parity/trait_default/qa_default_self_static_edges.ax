// test: run
// modes: interp native
// exit: 0
// stdout: 103\n109\n3003\n9003\n2\n1\n5\n70000000000\n

// QA (T161 gate, round 1): receiver-less `Self.` calls inside default bodies, beyond F1.
// - A subtrait default calls a receiver-less member of its supertrait through `Self.` (`Self.code()`):
//   A.code() = 3, B.code() = 9 -> tag = 103 / 109.
// - The same default also calls `A.code()` on a concrete type: that call must keep A's member and is not
//   rebound to the implementing type -> vs_a = code * 1000 + 3 = 3003 / 9003.
// - A generic default (`pick<U>`) with a `Self.code()` condition, instantiated with U = i32 and i64:
//   A (3, not > 5) picks `small`, B (9) picks `big` -> 2, 1, 5, 70000000000.

trait Named {
    fn code() -> i32;
}

trait Tagged: Named {
    fn tag() -> i32 {
        Self.code() + 100
    }
    fn vs_a() -> i32 {
        Self.code() * 1000 + A.code()
    }
    fn pick<U>(self: view<Self>, big: U, small: U) -> U {
        if Self.code() > 5 {
            big
        } else {
            small
        }
    }
}

struct A {
    v: i32,
}

struct B {
    v: i32,
}

impl Named for A {
    fn code() -> i32 {
        3
    }
}

impl Named for B {
    fn code() -> i32 {
        9
    }
}

impl Tagged for A {}

impl Tagged for B {}

fn show(v: i32) {
    print_int(v as i64);
    print("\n");
}

fn main() {
    let a = A { v: 0 };
    let b = B { v: 0 };
    show(A.tag());
    show(B.tag());
    show(A.vs_a());
    show(B.vs_a());
    show(a.pick(1, 2));
    show(b.pick(1, 2));
    let big: i64 = 70000000000;
    print_int(a.pick(big, 5));
    print("\n");
    print_int(b.pick(big, 5));
    print("\n");
}
