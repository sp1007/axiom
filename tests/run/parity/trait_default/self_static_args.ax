// test: run
// modes: interp native
// exit: 0
// stdout: 17\n45\n31\n71\n103\n107\n13\n29\n

// T161 round 1 (QA finding F1): receiver-less trait member calls through `Self` inside default bodies
// bind to the implementing type's impl (0133 §8, §9). Covers `Self.k(x)` with arguments, `Self.scale()`
// reached from a default called by another default (method and static chains), and a two-argument
// static member, over two implementing types.
// P: k(x) = x + 1, scale = 3, mix(a, b) = a + b.  Q: k(x) = x * 3, scale = 7, mix(a, b) = a * b.
// apply(5) = k(5) + k(10): P 6 + 11 = 17, Q 15 + 30 = 45.
// outer = inner + 1 = scale * 10 + 1: P 31, Q 71.
// chain = base + 100 = scale + 100: P 103, Q 107.
// pair(4) = mix(4, scale) + 6: P 4 + 3 + 6 = 13; Q overrides pair as mix(4, scale) + 1 = 4 * 7 + 1 = 29.

trait Calc {
    fn k(x: i32) -> i32;
    fn scale() -> i32;
    fn mix(a: i32, b: i32) -> i32;
    fn apply(v: i32) -> i32 {
        Self.k(v) + Self.k(v * 2)
    }
    fn inner(self: view<Self>) -> i32 {
        Self.scale() * 10
    }
    fn outer(self: view<Self>) -> i32 {
        self.inner() + 1
    }
    fn base() -> i32 {
        Self.scale()
    }
    fn chain() -> i32 {
        Self.base() + 100
    }
    fn pair(v: i32) -> i32 {
        Self.mix(v, Self.scale()) + 6
    }
}

struct P {
    v: i32,
}

struct Q {
    v: i32,
}

impl Calc for P {
    fn k(x: i32) -> i32 {
        x + 1
    }
    fn scale() -> i32 {
        3
    }
    fn mix(a: i32, b: i32) -> i32 {
        a + b
    }
}

impl Calc for Q {
    fn k(x: i32) -> i32 {
        x * 3
    }
    fn scale() -> i32 {
        7
    }
    fn mix(a: i32, b: i32) -> i32 {
        a * b
    }
    fn pair(v: i32) -> i32 {
        Self.mix(v, Self.scale()) + 1
    }
}

fn show(v: i32) {
    print_int(v as i64);
    print("\n");
}

fn main() {
    let p = P { v: 0 };
    let q = Q { v: 0 };
    show(P.apply(5));
    show(Q.apply(5));
    show(p.outer());
    show(q.outer());
    show(P.chain());
    show(Q.chain());
    show(P.pair(4));
    show(Q.pair(4));
}
