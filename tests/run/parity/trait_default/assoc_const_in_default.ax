// test: run
// modes: interp native
// exit: 0
// stdout: 5\n50\n6\n51\n

// T161: a default method body reads `Self.CONST`; each implementing type sees the constant of its
// own impl (0133 §8, §14).

trait Limit {
    const MAX: i32;
    fn max(self: view<Self>) -> i32 {
        Self.MAX
    }
    fn max_plus(self: view<Self>, d: i32) -> i32 {
        Self.MAX + d
    }
}

struct Small {
    n: i32,
}

struct Big {
    n: i32,
}

impl Limit for Small {
    const MAX: i32 = 5;
}

impl Limit for Big {
    const MAX: i32 = 50;
}

fn show(v: i32) {
    print_int(v as i64);
    print("\n");
}

fn main() {
    let s = Small { n: 1 };
    let b = Big { n: 1 };
    show(s.max());
    show(b.max());
    show(s.max_plus(s.n));
    show(b.max_plus(b.n));
}
