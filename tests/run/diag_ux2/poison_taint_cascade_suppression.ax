// test: run
// modes: interp native
// stdout-file: poison_taint_cascade_suppression.stdout
// SPEC-103 AXS-DIAG-004 (REQ-TOOL-298, INV-DIAG-009):
// Verifies root-cause `PoisonTaint` propagation, cascading error suppression,
// ownership poison clearing upon re-initialization (`x = new_val`), and sibling independence.

const OWN_OWNED: u8 = 1u8
const OWN_MOVED: u8 = 2u8
const OWN_POISONED: u8 = 3u8

struct CascadeSim {
    sym_poisoned: [8]bool,
    local_own: [8]u8,
    emitted_errors: u32,
    suppressed_cascades: u32,
}

fn sim_new() -> CascadeSim {
    CascadeSim {
        sym_poisoned: [false; 8],
        local_own: [OWN_OWNED; 8],
        emitted_errors: 0u32,
        suppressed_cascades: 0u32,
    }
}

fn emit_root_type_err(s: mut_view<CascadeSim>, sym: usize) {
    s.emitted_errors = s.emitted_errors + 1u32
    s.sym_poisoned[sym] = true
}

fn check_dependent_expr(s: mut_view<CascadeSim>, sym: usize, has_mismatch: bool) {
    if s.sym_poisoned[sym] {
        s.suppressed_cascades = s.suppressed_cascades + 1u32
        return
    }
    if has_mismatch {
        s.emitted_errors = s.emitted_errors + 1u32
    }
}

fn use_moved_local(s: mut_view<CascadeSim>, local_id: usize) {
    if s.local_own[local_id] == OWN_POISONED {
        s.suppressed_cascades = s.suppressed_cascades + 1u32
        return
    }
    if s.local_own[local_id] == OWN_MOVED {
        s.emitted_errors = s.emitted_errors + 1u32
        s.local_own[local_id] = OWN_POISONED
    }
}

fn reinit_local(s: mut_view<CascadeSim>, local_id: usize) {
    s.local_own[local_id] = OWN_OWNED
}

pub fn main() -> i32 {
    let mut sim = sim_new()

    // 1. Root unresolved/type error on `sym 1` (`let x = unknown_fn()`)
    emit_root_type_err(mut_view(sim), 1)
    // Subsequent `x.f`, `x.m()`, `x[0]`, `x + 1` must be suppressed (0 secondary errors)
    check_dependent_expr(mut_view(sim), 1, true)
    check_dependent_expr(mut_view(sim), 1, true)
    check_dependent_expr(mut_view(sim), 1, true)
    check_dependent_expr(mut_view(sim), 1, true)

    if sim.emitted_errors != 1u32 || sim.suppressed_cascades != 4u32 {
        return 1
    }

    // 2. Unpoisoned sibling symbol `sym 2` in the same function still reports genuine error
    check_dependent_expr(mut_view(sim), 2, true)
    if sim.emitted_errors != 2u32 {
        return 2
    }

    // 3. Ownership move taint on `local 3`: first use-after-move emits 1 error and poisons `local 3`;
    //    second use-after-move in the same path is suppressed.
    sim.local_own[3] = OWN_MOVED
    use_moved_local(mut_view(sim), 3)
    use_moved_local(mut_view(sim), 3)
    if sim.emitted_errors != 3u32 || sim.suppressed_cascades != 5u32 {
        return 3
    }

    // 4. Re-initializing `local 3` (`buf = Buffer { data: 9 }`) clears poison taint;
    //    a subsequent move + use-after-move is checked and reported normally!
    reinit_local(mut_view(sim), 3)
    sim.local_own[3] = OWN_MOVED
    use_moved_local(mut_view(sim), 3)
    if sim.emitted_errors != 4u32 {
        return 4
    }

    print("POISON-TAINT-CASCADE-SUPPRESSION-OK\n")
    0
}
