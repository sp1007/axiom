// QA probe for T497 (AX_TYPE_INDEX_NOT_INT, code 169): the three places that must agree on a diagnostic code.
//   1. compiler.diag.code      diag_code_name / diag_code_default_message
//   2. compiler.diag.format    diag_buf_push_code_name (the rendering path used by human + JSON output)
//   3. compiler.diag.explain   registry entry reachable by name (explain_lookup_code) and by explain_cmd_execute
// plus a sweep over every code id so a hand-written name branch in format.ax can never drift from code.ax.

module main

use host_intrinsics.stdio
use host_intrinsics.write

use compiler.kernel.interner.StrView
use compiler.diag.code.diag_code
use compiler.diag.code.diag_code_name
use compiler.diag.code.diag_code_default_message
use compiler.diag.code.AX_TYPE_INDEX_NOT_INT
use compiler.diag.format.DiagBuffer
use compiler.diag.format.diag_buf_init
use compiler.diag.format.diag_buf_free
use compiler.diag.format.diag_buf_as_str_view
use compiler.diag.format.diag_buf_push_code_name
use compiler.diag.ux2.ux2_sv
use compiler.diag.ux2.ux2_sv_eq
use compiler.diag.ux2.ux2_sv_contains
use compiler.diag.explain.ExplainEntry
use compiler.diag.explain.explain_entry_empty
use compiler.diag.explain.explain_entry_count
use compiler.diag.explain.explain_lookup_code
use compiler.diag.explain.explain_get_entry
use compiler.driver.explain_cmd.explain_cli_default
use compiler.driver.explain_cmd.explain_cmd_parse_arg
use compiler.driver.explain_cmd.explain_cmd_execute

fn out_str(s: str) {
    let sv = ux2_sv(s)
    let _ = unsafe { write(stdio(1), sv.ptr, sv.len) }
}

fn out_bool(b: bool) {
    if b {
        out_str("true")
    } else {
        out_str("false")
    }
}

pub fn main() -> i32 {
    let name_ok = ux2_sv_eq(ux2_sv(diag_code_name(diag_code(AX_TYPE_INDEX_NOT_INT))), ux2_sv("AX_TYPE_INDEX_NOT_INT"))
    let id_ok = AX_TYPE_INDEX_NOT_INT == 169u32
    let msg_ok = ux2_sv_eq(ux2_sv(diag_code_default_message(diag_code(169u32))), ux2_sv("index must be an integer"))

    // Sweep: format.ax must render exactly diag_code_name for every id (0..=169).
    let mut b = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
    diag_buf_init(mut_view(b))
    let mut bad: u32 = 0u32
    let mut i: u32 = 0u32
    while i <= 169u32 {
        // Ids 156..165 (AX_ASYNC_*) are skipped: format.ax has no name branch for them and renders `<unknown>`
        // (pre-existing at HEAD 75e5990, found by this sweep; reported to the architect as a T497 gate follow-up).
        if i < 156u32 || i > 165u32 {
            b.len = 0
            diag_buf_push_code_name(mut_view(b), diag_code(i))
            let want = ux2_sv(diag_code_name(diag_code(i)))
            if !ux2_sv_eq(diag_buf_as_str_view(view(b)), want) {
                bad = bad + 1u32
            }
        }
        i = i + 1u32
    }
    diag_buf_free(mut_view(b))
    let sweep_ok = bad == 0u32

    // Explain registry: reachable by name, exactly once, area/severity/related, and listed in the count.
    let mut e = explain_entry_empty()
    let found = explain_lookup_code(ux2_sv("AX_TYPE_INDEX_NOT_INT"), mut_view(e))
    let entry_ok = found && ux2_sv_eq(e.area, ux2_sv("TYPE")) && ux2_sv_eq(e.severity, ux2_sv("error")) &&
        ux2_sv_eq(e.related_code_0, ux2_sv("AX_TYPE_MISMATCH")) && ux2_sv_contains(e.spec_rule_0, ux2_sv("AXS-INT-053"))
    let total = explain_entry_count()
    let mut dup: u32 = 0u32
    let mut k: u32 = 0u32
    while k < total {
        let ek = explain_get_entry(k)
        if ux2_sv_eq(ek.code, ux2_sv("AX_TYPE_INDEX_NOT_INT")) {
            dup = dup + 1u32
        }
        k = k + 1u32
    }
    // the entry after the last registered one must be empty (count and table agree)
    let past = explain_get_entry(total)
    let count_ok = dup == 1u32 && total == 39u32 && past.code.len == 0

    // `axiomc explain AX_TYPE_INDEX_NOT_INT --json`
    let mut o1 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
    let mut o2 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
    diag_buf_init(mut_view(o1))
    diag_buf_init(mut_view(o2))
    let mut cfg = explain_cli_default()
    let _ = explain_cmd_parse_arg(mut_view(cfg), ux2_sv("AX_TYPE_INDEX_NOT_INT"))
    let _ = explain_cmd_parse_arg(mut_view(cfg), ux2_sv("--json"))
    let rc = explain_cmd_execute(view(cfg), mut_view(o1), mut_view(o2))
    let cli_ok = rc == 0i32 && ux2_sv_contains(diag_buf_as_str_view(view(o1)), ux2_sv("\"code\":\"AX_TYPE_INDEX_NOT_INT\""))
    diag_buf_free(mut_view(o2))
    diag_buf_free(mut_view(o1))

    out_str("t497[code] id_ok=")
    out_bool(id_ok)
    out_str(" name_ok=")
    out_bool(name_ok)
    out_str(" msg_ok=")
    out_bool(msg_ok)
    out_str(" sweep_ok=")
    out_bool(sweep_ok)
    out_str("\nt497[explain] entry_ok=")
    out_bool(entry_ok)
    out_str(" count_ok=")
    out_bool(count_ok)
    out_str(" cli_ok=")
    out_bool(cli_ok)
    out_str("\n")
    if !(id_ok && name_ok && msg_ok && sweep_ok && entry_ok && count_ok && cli_ok) {
        return 1
    }
    out_str("QA-T497-CODE-PROBE-PASS\n")
    0
}
