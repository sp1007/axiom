// test: run
// modes: interp native
// stdout: D:11\nD:21\nD:22\nD:23\nD:24\nD:25\nD:26\nD:31\nD:32\nD:33\nD:34\nOWN:40\nD:41\nD:42\nD:43\nD:44\n
// exit: 93

use std.core.host.heap_alloc
use std.core.host.heap_realloc
use std.core.host.heap_free

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapReAlloc(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_realloc(p: *mut u8, old_size: usize, new_size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if new_size < 16 { 16 } else { new_size };
    HeapReAlloc(h, 8u32, p, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn drop_in_place<T>(p: *mut T) {}

struct Guard {
    id: i64,
}

impl Drop for Guard {
    fn drop(self: mut_view<Guard>) {
        print("D:");
        print_int(self.id);
        print("\n");
    }
}

fn consume_guard(_g: Guard) {}

struct OwnHeader {
    tag: i64,
    inner: Guard,
}

impl Drop for OwnHeader {
    fn drop(self: mut_view<OwnHeader>) {
        print("OWN:");
        print_int(self.tag);
        print("\n");
    }
}

enum MaybeGuard {
    Empty,
    Full(Guard),
}

unsafe fn kill<T>(p: *mut T) {
    drop_in_place<T>(p);
}

fn heap_drop_direct<T>(val: T) {
    let sz = size_of<T>();
    let al = align_of<T>();
    let raw = unsafe { heap_alloc(sz, al) };
    let p = raw as *mut T;
    unsafe {
        *p = val;
        drop_in_place<T>(p);
        heap_free(raw, sz, al);
    }
}

fn heap_drop_via_kill<T>(val: T) {
    let sz = size_of<T>();
    let al = align_of<T>();
    let raw = unsafe { heap_alloc(sz, al) };
    let p = raw as *mut T;
    unsafe {
        *p = val;
        kill<T>(p);
        heap_free(raw, sz, al);
    }
}

fn main() -> i32 {
    let g11 = Guard { id: 11 };
    heap_drop_direct(|| { consume_guard(g11); });

    let g21 = Guard { id: 21 };
    let g22 = Guard { id: 22 };
    let g23 = Guard { id: 23 };
    heap_drop_direct(|| {
        consume_guard(g21);
        consume_guard(g22);
        consume_guard(g23);
    });

    let g24 = Guard { id: 24 };
    let g25 = Guard { id: 25 };
    let g26 = Guard { id: 26 };
    heap_drop_via_kill(|| {
        consume_guard(g24);
        consume_guard(g25);
        consume_guard(g26);
    });

    let t_sz = size_of<(Guard, i64, Guard)>();
    let t_al = align_of<(Guard, i64, Guard)>();
    let t_raw = unsafe { heap_alloc(t_sz, t_al) };
    let t_ptr = t_raw as *mut (Guard, i64, Guard);
    unsafe {
        *t_ptr = (Guard { id: 31 }, 100i64, Guard { id: 32 });
        drop_in_place<(Guard, i64, Guard)>(t_ptr);
        *t_ptr = (Guard { id: 33 }, 200i64, Guard { id: 34 });
        kill<(Guard, i64, Guard)>(t_ptr);
        heap_free(t_raw, t_sz, t_al);
    }

    let nested: (OwnHeader, [2]Guard, MaybeGuard) = (
        OwnHeader { tag: 40, inner: Guard { id: 41 } },
        [Guard { id: 42 }, Guard { id: 43 }],
        MaybeGuard.Full(Guard { id: 44 }),
    );
    heap_drop_via_kill<(OwnHeader, [2]Guard, MaybeGuard)>(nested);

    93
}
