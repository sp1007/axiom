// test: run
// modes: interp native
// stdout: B\nD:101\nB\nD:102\nD:103\nD:104\n
// exit: 42

use std.core.host.heap_alloc
use std.core.host.heap_realloc
use std.core.host.heap_free

@link("kernel32")
extern "system" {
    fn GetProcessHeap() -> *mut u8;
    fn HeapAlloc(hHeap: *mut u8, dwFlags: u32, dwBytes: usize) -> *mut u8;
    fn HeapReAlloc(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8, dwBytes: usize) -> *mut u8;
    fn HeapFree(hHeap: *mut u8, dwFlags: u32, lpMem: *mut u8) -> i32;
}

pub unsafe fn __ax_host_heap_alloc(size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if size < 16 { 16 } else { size };
    HeapAlloc(h, 8u32, alloc_bytes)
}

pub unsafe fn __ax_host_heap_realloc(p: *mut u8, old_size: usize, new_size: usize, align: usize) -> *mut u8 {
    let h = GetProcessHeap();
    if h as usize == 0 { return 0 as *mut u8; }
    let alloc_bytes: usize = if new_size < 16 { 16 } else { new_size };
    HeapReAlloc(h, 8u32, p, alloc_bytes)
}

pub unsafe fn __ax_host_heap_free(p: *mut u8, size: usize, align: usize) {
    if p as usize != 0 {
        let h = GetProcessHeap();
        if h as usize != 0 {
            HeapFree(h, 0u32, p);
        }
    }
}

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn needs_drop<T>() -> bool { false }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn drop_in_place<T>(p: *mut T) {}

struct RawSlot {
    words: [16]u64,
}

struct Guard {
    id: i64,
}

impl Drop for Guard {
    fn drop(self: mut_view<Guard>) {
        print("D:");
        print_int(self.id);
        print("\n");
    }
}

struct HeapBox<T> {
    ptr: *mut T,
}

impl<T> Drop for HeapBox<T> {
    fn drop(self: mut_view<HeapBox<T>>) {
        if self.ptr as usize != 0 {
            print("B\n");
            if needs_drop<T>() {
                unsafe {
                    drop_in_place<T>(self.ptr);
                }
            }
            let sz = size_of<T>();
            let al = align_of<T>();
            unsafe {
                heap_free(self.ptr as *mut u8, sz, al);
            }
            self.ptr = 0 as *mut T;
        }
    }
}

fn heap_box_new<T>(val: T) -> HeapBox<T> {
    let sz = size_of<T>();
    let al = align_of<T>();
    let raw = unsafe { heap_alloc(sz, al) };
    let p = raw as *mut T;
    unsafe {
        *p = val;
    }
    HeapBox<T> { ptr: p }
}

unsafe fn kill<T>(p: *mut T) {
    drop_in_place<T>(p);
}

fn slot_drop_direct<T>(val: T) {
    let mut slot = RawSlot { words: [0u64; 16] };
    let p = unsafe { address_of_mut(slot.words[0]) as *mut T };
    unsafe {
        *p = val;
        drop_in_place<T>(p);
    }
}

fn slot_drop_via_kill<T>(val: T) {
    let mut slot = RawSlot { words: [0u64; 16] };
    let p = unsafe { address_of_mut(slot.words[0]) as *mut T };
    unsafe {
        *p = val;
        kill<T>(p);
    }
}

fn main() -> i32 {
    let b1 = heap_box_new<Guard>(Guard { id: 101 });
    slot_drop_direct(|| {
        drop(b1);
    });

    let b2 = heap_box_new<(Guard, i64, Guard)>((Guard { id: 102 }, 7i64, Guard { id: 103 }));
    let g_tail = Guard { id: 104 };
    slot_drop_via_kill(|| {
        drop(b2);
        drop(g_tail);
    });

    42
}
