// test: run
// modes: interp native
// stdout: S:1\nD:2\nD:3\nS:4\nD:5\nD:6\nD:11\nD:12\nD:13\nD:14\nD:21\nD:22\nD:23\nD:24\nD:25\nD:26\nD:27\nD:31\nD:32\nD:41\nD:42\nD:43\nD:51\nD:52\nP:60\nD:61\nP:70\n
// exit: 83

@intrinsic fn needs_drop<T>() -> bool { false }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn drop_in_place<T>(p: *mut T) {}

struct RawSlot {
    words: [24]u64,
}

struct Guard {
    id: i64,
}

impl Drop for Guard {
    fn drop(self: mut_view<Guard>) {
        print("D:");
        print_int(self.id);
        print("\n");
    }
}

struct OwnAndFields {
    own_id: i64,
    a: Guard,
    b: Guard,
}

impl Drop for OwnAndFields {
    fn drop(self: mut_view<OwnAndFields>) {
        print("S:");
        print_int(self.own_id);
        print("\n");
    }
}

enum RichChoice<F> {
    Empty,
    One(Guard),
    Pair((Guard, Guard)),
    Clos(F),
}

struct ClosHolder<F> {
    f: F,
    tail: Guard,
}

unsafe fn kill<T>(p: *mut T) {
    drop_in_place<T>(p);
}

unsafe fn kill2<A, B>(pa: *mut A, pb: *mut B) {
    kill<A>(pa);
    kill<B>(pb);
}

fn slot_drop<T>(val: T) {
    let mut slot = RawSlot { words: [0u64; 24] };
    let p = unsafe { address_of_mut(slot.words[0]) as *mut T };
    unsafe {
        *p = val;
        kill<T>(p);
    }
}

fn consume_guard(_g: Guard) {}

fn get_guard_ptr(p: *mut Guard, tag: i64) -> *mut Guard {
    print("P:");
    print_int(tag);
    print("\n");
    p
}

fn get_i64_ptr(p: *mut i64, tag: i64) -> *mut i64 {
    print("P:");
    print_int(tag);
    print("\n");
    p
}

fn test_enum_with_closure<F>(f: F) {
    let mut slot = RawSlot { words: [0u64; 24] };
    let p = unsafe { address_of_mut(slot.words[0]) as *mut RichChoice<F> };
    unsafe {
        *p = RichChoice<F>.Empty;
        kill<RichChoice<F>>(p);
        *p = RichChoice<F>.One(Guard { id: 11 });
        kill<RichChoice<F>>(p);
        *p = RichChoice<F>.Pair((Guard { id: 12 }, Guard { id: 13 }));
        kill<RichChoice<F>>(p);
        *p = RichChoice<F>.Clos(f);
        kill<RichChoice<F>>(p);
    }
}

fn test_holder<F>(f: F, tail: Guard) {
    slot_drop<ClosHolder<F>>(ClosHolder<F> { f: f, tail: tail });
}

fn main() -> i32 {
    // 1. Scope-end DROP vs drop_in_place on struct with own Drop + 2 Guard fields
    {
        let _scope_val = OwnAndFields { own_id: 1, a: Guard { id: 2 }, b: Guard { id: 3 } };
    }
    slot_drop<OwnAndFields>(OwnAndFields { own_id: 4, a: Guard { id: 5 }, b: Guard { id: 6 } });

    // 2. Enum with payloadless, Guard, tuple, and closure variants
    let g14 = Guard { id: 14 };
    test_enum_with_closure(|| { consume_guard(g14); });

    // 3. Nested closure + closure capturing tuple and array
    let g21 = Guard { id: 21 };
    let inner = || { consume_guard(g21); };
    let g22 = Guard { id: 22 };
    let tup = (Guard { id: 23 }, Guard { id: 24 });
    let arr = [Guard { id: 25 }, Guard { id: 26 }];
    let g27 = Guard { id: 27 };
    slot_drop(|| {
        drop(inner);
        consume_guard(g22);
        drop(tup);
        drop(arr);
        consume_guard(g27);
    });

    // 4. Generic struct holding a closure + Guard
    let g31 = Guard { id: 31 };
    test_holder(|| { consume_guard(g31); }, Guard { id: 32 });

    // 5. Element-pointer drop_in_place on a raw array slot (drop elements 1, 2, 0 in custom order)
    let mut arr_slot = RawSlot { words: [0u64; 24] };
    let arr_p = unsafe { address_of_mut(arr_slot.words[0]) as *mut [3]Guard };
    unsafe {
        *arr_p = [Guard { id: 43 }, Guard { id: 41 }, Guard { id: 42 }];
        let e1 = address_of_mut((*arr_p)[1]);
        let e2 = address_of_mut((*arr_p)[2]);
        let e0 = address_of_mut((*arr_p)[0]);
        drop_in_place<Guard>(e1);
        kill<Guard>(e2);
        drop_in_place<Guard>(e0);
    }

    // 6. Nested generic kill2<A, B> instantiated with (droppable, non-droppable) and (non-droppable, droppable)
    let mut s_a = RawSlot { words: [0u64; 24] };
    let mut n1: i64 = 10;
    let pa = unsafe { address_of_mut(s_a.words[0]) as *mut Guard };
    unsafe {
        *pa = Guard { id: 51 };
        kill2<Guard, i64>(pa, address_of_mut(n1));
        *pa = Guard { id: 52 };
        kill2<i64, Guard>(address_of_mut(n1), pa);
    }

    // 7. Side-effecting pointer expression evaluated exactly once for both needs_drop and !needs_drop
    let mut s_se = RawSlot { words: [0u64; 24] };
    let pse = unsafe { address_of_mut(s_se.words[0]) as *mut Guard };
    let mut n2: i64 = 73;
    unsafe {
        *pse = Guard { id: 61 };
        drop_in_place<Guard>(get_guard_ptr(pse, 60));
        drop_in_place<i64>(get_i64_ptr(address_of_mut(n2), 70));
    }

    (n1 + n2) as i32
}
