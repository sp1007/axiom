// test: run
// modes: interp native
// stdout: D:101\nD:102\nD:103\nD:104\nD:201\nD:202\nD:203\nD:204\nOWN:300\nD:301\nOWN:302\nD:303\nGOWN:400\nD:401\nGOWN:402\n
// exit: 64

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn drop_in_place<T>(p: *mut T) {}

struct RawSlot {
    words: [16]u64,
}

struct Guard {
    id: i64,
}

impl Drop for Guard {
    fn drop(self: mut_view<Guard>) {
        print("D:");
        print_int(self.id);
        print("\n");
    }
}

struct GluePair {
    first: Guard,
    mid: i64,
    second: Guard,
}

enum Slot {
    Empty,
    Single(Guard),
    Both(Guard, Guard),
}

struct WithOwnDrop {
    own_id: i64,
    g: Guard,
}

impl Drop for WithOwnDrop {
    fn drop(self: mut_view<WithOwnDrop>) {
        print("OWN:");
        print_int(self.own_id);
        print("\n");
    }
}

struct GenWithOwnDrop<T> {
    own_id: i64,
    inner: T,
}

impl<T> Drop for GenWithOwnDrop<T> {
    fn drop(self: mut_view<GenWithOwnDrop<T>>) {
        print("GOWN:");
        print_int(self.own_id);
        print("\n");
    }
}

unsafe fn kill<T>(p: *mut T) {
    drop_in_place<T>(p);
}

fn main() -> i32 {
    let mut slot = RawSlot { words: [0u64; 16] };

    let gp1_p = unsafe { address_of_mut(slot.words[0]) as *mut GluePair };
    unsafe {
        *gp1_p = GluePair { first: Guard { id: 101 }, mid: 5i64, second: Guard { id: 102 } };
        drop_in_place<GluePair>(gp1_p);
        *gp1_p = GluePair { first: Guard { id: 103 }, mid: 6i64, second: Guard { id: 104 } };
        kill<GluePair>(gp1_p);
    }

    let sl_p = unsafe { address_of_mut(slot.words[0]) as *mut Slot };
    unsafe {
        *sl_p = Slot.Empty;
        drop_in_place<Slot>(sl_p);
        *sl_p = Slot.Single(Guard { id: 201 });
        drop_in_place<Slot>(sl_p);
        *sl_p = Slot.Empty;
        kill<Slot>(sl_p);
        *sl_p = Slot.Single(Guard { id: 202 });
        kill<Slot>(sl_p);
        *sl_p = Slot.Both(Guard { id: 203 }, Guard { id: 204 });
        kill<Slot>(sl_p);
    }

    let w_p = unsafe { address_of_mut(slot.words[0]) as *mut WithOwnDrop };
    unsafe {
        *w_p = WithOwnDrop { own_id: 300, g: Guard { id: 301 } };
        drop_in_place<WithOwnDrop>(w_p);
        *w_p = WithOwnDrop { own_id: 302, g: Guard { id: 303 } };
        kill<WithOwnDrop>(w_p);
    }

    let gw1_p = unsafe { address_of_mut(slot.words[0]) as *mut GenWithOwnDrop<Guard> };
    unsafe {
        *gw1_p = GenWithOwnDrop<Guard> { own_id: 400, inner: Guard { id: 401 } };
        kill<GenWithOwnDrop<Guard>>(gw1_p);
    }

    let gw2_p = unsafe { address_of_mut(slot.words[0]) as *mut GenWithOwnDrop<i64> };
    unsafe {
        *gw2_p = GenWithOwnDrop<i64> { own_id: 402, inner: 99i64 };
        kill<GenWithOwnDrop<i64>>(gw2_p);
    }

    64
}
