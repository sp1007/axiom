// test: run
// modes: interp native
// stdout: D:11\nD:12\nD:13\nD:14\nD:21\nD:22\nD:23\nD:24\nD:31\nD:32\nD:33\nD:34\n
// exit: 55

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn drop_in_place<T>(p: *mut T) {}

struct RawSlot {
    words: [16]u64,
}

struct Guard {
    id: i64,
}

impl Drop for Guard {
    fn drop(self: mut_view<Guard>) {
        print("D:");
        print_int(self.id);
        print("\n");
    }
}

unsafe fn kill<T>(p: *mut T) {
    drop_in_place<T>(p);
}

fn main() -> i32 {
    let mut s1 = RawSlot { words: [0u64; 16] };
    let p1 = unsafe { address_of_mut(s1.words[0]) as *mut (Guard, i64, Guard) };
    unsafe {
        *p1 = (Guard { id: 11 }, 999i64, Guard { id: 12 });
        drop_in_place<(Guard, i64, Guard)>(p1);
    }

    let mut s2 = RawSlot { words: [0u64; 16] };
    let p2 = unsafe { address_of_mut(s2.words[0]) as *mut (Guard, i64, Guard) };
    unsafe {
        *p2 = (Guard { id: 13 }, 888i64, Guard { id: 14 });
        kill<(Guard, i64, Guard)>(p2);
    }

    let mut s3 = RawSlot { words: [0u64; 16] };
    let p3 = unsafe { address_of_mut(s3.words[0]) as *mut [2]Guard };
    unsafe {
        *p3 = [Guard { id: 21 }, Guard { id: 22 }];
        drop_in_place<[2]Guard>(p3);
    }

    let mut s4 = RawSlot { words: [0u64; 16] };
    let p4 = unsafe { address_of_mut(s4.words[0]) as *mut [2]Guard };
    unsafe {
        *p4 = [Guard { id: 23 }, Guard { id: 24 }];
        kill<[2]Guard>(p4);
    }

    let mut s5 = RawSlot { words: [0u64; 16] };
    let p5 = unsafe { address_of_mut(s5.words[0]) as *mut [2](Guard, Guard) };
    unsafe {
        *p5 = [
            (Guard { id: 31 }, Guard { id: 32 }),
            (Guard { id: 33 }, Guard { id: 34 }),
        ];
        kill<[2](Guard, Guard)>(p5);
    }

    55
}
