// test: run
// modes: interp native
// stdout: D:10\nD:21\nD:22\nD:23\nD:31\nD:32\nD:33\nD:41\nD:51\nD:52\nD:53\nD:61\nD:62\n
// exit: 77

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn drop_in_place<T>(p: *mut T) {}

struct RawSlot {
    words: [16]u64,
}

struct Guard {
    id: i64,
}

impl Drop for Guard {
    fn drop(self: mut_view<Guard>) {
        print("D:");
        print_int(self.id);
        print("\n");
    }
}

fn consume_guard(_g: Guard) {}

unsafe fn kill<T>(p: *mut T) {
    drop_in_place<T>(p);
}

fn slot_drop_direct<T>(val: T) {
    let mut slot = RawSlot { words: [0u64; 16] };
    let p = unsafe { address_of_mut(slot.words[0]) as *mut T };
    unsafe {
        *p = val;
        drop_in_place<T>(p);
    }
}

fn slot_drop_via_kill<T>(val: T) {
    let mut slot = RawSlot { words: [0u64; 16] };
    let p = unsafe { address_of_mut(slot.words[0]) as *mut T };
    unsafe {
        *p = val;
        kill<T>(p);
    }
}

fn drop_closure_1_direct() -> i32 {
    let g1 = Guard { id: 10 };
    let mut slot = RawSlot { words: [0u64; 16] };
    let c = || { consume_guard(g1); };
    let p = unsafe { address_of_mut(slot.words[0]) };
    let _ = p;
    slot_drop_direct(c);
    11
}

fn drop_closure_3_scope_ref() -> i32 {
    let g1 = Guard { id: 21 };
    let k: i64 = 5;
    let g2 = Guard { id: 22 };
    let g3 = Guard { id: 23 };
    let _c = || -> i64 {
        consume_guard(g1);
        consume_guard(g2);
        consume_guard(g3);
        k
    };
    12
}

fn drop_closure_3_direct() -> i32 {
    let g1 = Guard { id: 31 };
    let k: i64 = 7;
    let g2 = Guard { id: 32 };
    let g3 = Guard { id: 33 };
    slot_drop_direct(|| -> i64 {
        consume_guard(g1);
        consume_guard(g2);
        consume_guard(g3);
        k
    });
    13
}

fn drop_closure_1_via_kill() -> i32 {
    let g1 = Guard { id: 41 };
    slot_drop_via_kill(|| { consume_guard(g1); });
    14
}

fn drop_closure_3_via_kill() -> i32 {
    let g1 = Guard { id: 51 };
    let g2 = Guard { id: 52 };
    let g3 = Guard { id: 53 };
    slot_drop_via_kill(|| {
        consume_guard(g1);
        consume_guard(g2);
        consume_guard(g3);
    });
    15
}

fn kill_closure_in_generic<U>(u: U, g: Guard) -> i32 {
    slot_drop_via_kill(|| {
        drop(u);
        drop(g);
    });
    12
}

fn main() -> i32 {
    let a = drop_closure_1_direct();
    let b = drop_closure_3_scope_ref();
    let c = drop_closure_3_direct();
    let d = drop_closure_1_via_kill();
    let e = drop_closure_3_via_kill();
    let f = kill_closure_in_generic<Guard>(Guard { id: 61 }, Guard { id: 62 });
    a + b + c + d + e + f
}
