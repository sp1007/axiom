// test: run
// modes: interp native
// stdout: 
// exit: 89

@intrinsic fn needs_drop<T>() -> bool { true }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn drop_in_place<T>(p: *mut T) {}

struct PlainPair {
    a: i64,
    b: i64,
}

enum PlainChoice {
    None,
    Some(i64),
}

unsafe fn kill<T>(p: *mut T) {
    drop_in_place<T>(p);
}

fn check_closure_no_drop<F>(mut f: F) -> bool {
    let nd = needs_drop<F>();
    unsafe {
        drop_in_place<F>(address_of_mut(f));
        kill<F>(address_of_mut(f));
    }
    nd
}

fn main() -> i32 {
    if needs_drop<i64>() { return 1; }
    if needs_drop<(i64, bool)>() { return 2; }
    if needs_drop<[3]i64>() { return 3; }
    if needs_drop<PlainPair>() { return 4; }
    if needs_drop<PlainChoice>() { return 5; }

    let mut x: i64 = 20;
    let mut tup: (i64, bool) = (15, true);
    let mut arr: [3]i64 = [3, 4, 5];
    let mut st = PlainPair { a: 10, b: 12 };
    let mut en = PlainChoice.Some(20);

    unsafe {
        drop_in_place<i64>(address_of_mut(x));
        kill<i64>(address_of_mut(x));
        drop_in_place<(i64, bool)>(address_of_mut(tup));
        kill<(i64, bool)>(address_of_mut(tup));
        drop_in_place<[3]i64>(address_of_mut(arr));
        kill<[3]i64>(address_of_mut(arr));
        drop_in_place<PlainPair>(address_of_mut(st));
        kill<PlainPair>(address_of_mut(st));
        drop_in_place<PlainChoice>(address_of_mut(en));
        kill<PlainChoice>(address_of_mut(en));
    }

    let bias: i64 = 7;
    let copy_clos = |v: i64| -> i64 { v + bias };
    if check_closure_no_drop(copy_clos) { return 6; }

    let en_v: i64 = match en {
        PlainChoice.None => 0,
        PlainChoice.Some(v) => v,
    };
    let total: i64 = x + tup.0 + arr[0] + arr[1] + arr[2] + st.a + st.b + en_v;
    total as i32
}
