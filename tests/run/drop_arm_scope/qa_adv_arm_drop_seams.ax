// test: run
// modes: interp native
// stdout: inner 6\ndrop 3\ndrop 2\nouter-after-inner 1\ndrop 1\nafter-outer\ndrop 11\ndrop 10\nexpr-val=21\npmove 20\ndrop 20\nafter-reinit-true\ndrop 22\ndrop 21\npmove 30\ndrop 30\nafter-reinit-false\ndrop 31\nrefute-guard-ok 40\ndrop 40\nafter-refute-guard\nwl 51\ndrop 51\ndrop 52\nwl 53\ndrop 53\ndrop 54\nafter-wl\nconsumed 60\ndrop 60\ndrop 61\nafter-cond-true\ndrop 63\ndrop 62\nafter-cond-false\ndrop 71\nafter-let-else 70\ndrop 70\n
//
// T445a QA adversarial (round 0): boundary cross-check for ADR-0047 / SPEC-12 AXS-DROP-009:
// - nested `match` inside a `match` arm (inner drops before outer body remainder and outer binding)
// - `match` as a value expression with inner local + arm binding dropping before post-`let` code
// - partial move of struct field + re-assignment via function call (re-arming SubDropFlags) and
//   conditional re-assignment (true/false paths, no leak and no double-drop)
// - refutable sibling sub-pattern mismatch `(Some(g), 1)` + failing guard `(Some(g), 2) if ...`
//   followed by matching arm moving `g`
// - `while let` over temporary scrutinee with an unbound field across `continue` and `break`
// - conditional move of one binding in a multi-binding arm
// - `let ... else` partial move from a temporary scrutinee (unbound part drops at statement end)

module main

struct D {
    pub id: i32,
}

impl Drop for D {
    fn drop(self: mut_view<D>) {
        print("drop ");
        print_int(self.id as i64);
        print("\n");
    }
}

struct Pair {
    pub a: D,
    pub b: D,
}

enum Duo {
    Both(D, D),
    One(D),
    Empty,
}

fn mk(id: i32) -> D {
    D { id: id }
}

fn mk_pair(a: i32, b: i32) -> Pair {
    Pair { a: mk(a), b: mk(b) }
}

fn mk_duo(a: i32, b: i32) -> Duo {
    Duo.Both(mk(a), mk(b))
}

fn consume(d: D) {
    print("consumed ");
    print_int(d.id as i64);
    print("\n");
}

fn test_nested_match() {
    let o = Option.Some(mk(1));
    let i = Option.Some(mk(2));
    match o {
        Option.Some(a) => {
            match i {
                Option.Some(b) => {
                    let c = mk(3);
                    print("inner ");
                    print_int((a.id + b.id + c.id) as i64);
                    print("\n");
                },
                Option.None => {},
            }
            print("outer-after-inner ");
            print_int(a.id as i64);
            print("\n");
        },
        Option.None => {},
    }
    print("after-outer\n");
}

fn test_value_expr_match() {
    let x = Duo.One(mk(10));
    let v = match x {
        Duo.One(g) => {
            let t = mk(11);
            g.id + t.id
        },
        _ => 0,
    };
    print("expr-val=");
    print_int(v as i64);
    print("\n");
}

fn test_partial_reinit(do_reinit: bool, base: i32, tag: str) {
    let mut p = mk_pair(base, base + 1);
    match p {
        Pair { a, b: _ } => {
            print("pmove ");
            print_int(a.id as i64);
            print("\n");
        },
    }
    if do_reinit {
        p.a = mk(base + 2);
    }
    print(tag);
    print("\n");
}

fn test_refute_and_guard() {
    let tup = (Option.Some(mk(40)), 2);
    match tup {
        (Option.Some(g), 1) => {
            print("wrong1 ");
            print_int(g.id as i64);
            print("\n");
        },
        (Option.Some(g), 2) if g.id == 999 => {
            print("wrong2 ");
            print_int(g.id as i64);
            print("\n");
        },
        (Option.Some(g), 2) => {
            print("refute-guard-ok ");
            print_int(g.id as i64);
            print("\n");
        },
        _ => {},
    }
    print("after-refute-guard\n");
}

fn next_pair(step: mut_view<i32>) -> Option<Pair> {
    *step = *step + 1;
    if *step == 1 {
        Option.Some(mk_pair(51, 52))
    } else if *step == 2 {
        Option.Some(mk_pair(53, 54))
    } else {
        Option.None
    }
}

fn test_while_let_partial_temp() {
    let mut step = 0;
    while let Option.Some(Pair { a, b: _ }) = next_pair(mut_view(step)) {
        print("wl ");
        print_int(a.id as i64);
        print("\n");
        if step == 1 {
            continue;
        }
        if step == 2 {
            break;
        }
    }
    print("after-wl\n");
}

fn test_cond_move_multi(take_first: bool, a_id: i32, b_id: i32, tag: str) {
    let d = mk_duo(a_id, b_id);
    match d {
        Duo.Both(g, h) => {
            if take_first {
                consume(g);
            }
            let _ = h.id;
        },
        _ => {},
    }
    print(tag);
    print("\n");
}

fn test_let_else_partial_temp() -> i32 {
    let Duo.Both(a, _) = mk_duo(70, 71) else {
        return -1;
    };
    print("after-let-else ");
    print_int(a.id as i64);
    print("\n");
    0
}

pub fn main() -> i32 {
    test_nested_match();
    test_value_expr_match();
    test_partial_reinit(true, 20, "after-reinit-true");
    test_partial_reinit(false, 30, "after-reinit-false");
    test_refute_and_guard();
    test_while_let_partial_temp();
    test_cond_move_multi(true, 60, 61, "after-cond-true");
    test_cond_move_multi(false, 62, 63, "after-cond-false");
    let _ = test_let_else_partial_temp();
    0
}
