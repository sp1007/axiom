// test: run
// modes: interp native
// stdout: after-let-pair 1 2\ndrop 2\ndrop 1\nafter-let-block\ndrop 4\nafter-partial-let 3\ndrop 3\nlet-else-ok 5\nafter-let-else-stmt\ndrop 6\ndrop 5\nlet-else-bail\ndrop 7\ndrop 8\ngot-bail=-1\n
//
// ADR-0047 §6 / SPEC-12 AXS-DROP-009: `let P = e;` (irrefutable) and `let P = e else { ... };`
// keep the ordinary `let` drop scope: bindings live until the end of the enclosing block, while
// any unbound parts of a temporary initializer drop at the end of the `let` statement.

module main

struct D {
    pub id: i32,
}

impl Drop for D {
    fn drop(self: mut_view<D>) {
        print("drop ");
        print_int(self.id as i64);
        print("\n");
    }
}

struct Pair {
    pub a: D,
    pub b: D,
}

enum Duo {
    One(D, D),
    Two(D),
}

fn make_pair(a: i32, b: i32) -> Pair {
    Pair { a: D { id: a }, b: D { id: b } }
}

fn make_duo(ok: bool) -> Duo {
    if ok {
        Duo.Two(D { id: 5 })
    } else {
        Duo.One(D { id: 7 }, D { id: 8 })
    }
}

fn test_let_else(ok: bool) -> i32 {
    let Duo.Two(g) = make_duo(ok) else {
        print("let-else-bail\n");
        return -1;
    };
    print("let-else-ok ");
    print_int(g.id as i64);
    print("\n");
    let after = D { id: 6 };
    print("after-let-else-stmt\n");
    g.id + after.id
}

pub fn main() -> i32 {
    {
        let Pair { a, b } = make_pair(1, 2);
        print("after-let-pair ");
        print_int(a.id as i64);
        print(" ");
        print_int(b.id as i64);
        print("\n");
    }
    print("after-let-block\n");

    {
        let Pair { a, .. } = make_pair(3, 4);
        print("after-partial-let ");
        print_int(a.id as i64);
        print("\n");
    }

    let _ = test_let_else(true);
    let r = test_let_else(false);
    print("got-bail=");
    print_int(r as i64);
    print("\n");
    0
}
