// test: run
// modes: interp native
// stdout: second-arm 5\ndrop 5\nafter-rebind\nfallback-wild\nafter-wild\ndrop 6\ntemp-guard-second 7\ndrop 7\ndrop 8\nafter-temp-guard\nor-guard 12\ndrop 12\nafter-or-guard\nview-guard-second 20\ndrop 20\nafter-view-guard\ndrop 21\n
//
// ADR-0047 §2 / SPEC-12 AXS-DROP-009: a `match` guard (`if cond`) inspects pattern bindings by
// view without moving out of the scrutinee; when the guard fails, neither move nor drop occurs
// in that arm, so a later arm can bind the same payload by value or leave it in the scrutinee.

module main

struct D {
    pub id: i32,
}

impl Drop for D {
    fn drop(self: mut_view<D>) {
        print("drop ");
        print_int(self.id as i64);
        print("\n");
    }
}

enum Slot {
    One(D),
    Two(D, D),
    Alt(D),
    Empty,
}

struct Holder {
    pub slot: Option<D>,
}

fn id_gt(d: view<D>, lim: i32) -> bool {
    d.id > lim
}

fn make_two(a: i32, b: i32) -> Slot {
    Slot.Two(D { id: a }, D { id: b })
}

fn replace_if_not_99(h: mut_view<Holder>, next_d: D) {
    match h.slot {
        Option.Some(g) if g.id == 99 => {
            h.slot = Option.Some(next_d);
        },
        Option.Some(g) => {
            print("view-guard-second ");
            print_int(g.id as i64);
            print("\n");
            h.slot = Option.Some(next_d);
        },
        Option.None => {
            h.slot = Option.Some(next_d);
        },
    }
}

pub fn main() -> i32 {
    {
        let s = Slot.One(D { id: 5 });
        match s {
            Slot.One(d) if d.id > 10 => {
                print("wrong\n");
            },
            Slot.One(d) if id_gt(view(d), 20) => {
                print("wrong2\n");
            },
            Slot.One(d) => {
                print("second-arm ");
                print_int(d.id as i64);
                print("\n");
            },
            _ => {},
        }
        print("after-rebind\n");
    }

    {
        let s2 = Slot.One(D { id: 6 });
        match s2 {
            Slot.One(d) if d.id > 10 => {
                print("wrong\n");
            },
            _ => {
                print("fallback-wild\n");
            },
        }
        print("after-wild\n");
    }

    match make_two(7, 8) {
        Slot.Two(a, b) if a.id + b.id > 100 => {
            print("wrong\n");
        },
        Slot.Two(a, _) => {
            print("temp-guard-second ");
            print_int(a.id as i64);
            print("\n");
        },
        _ => {},
    }
    print("after-temp-guard\n");

    {
        let c = (2, Slot.One(D { id: 12 }));
        match c {
            (1 | 2, Slot.One(d)) if d.id > 50 => {
                print("wrong\n");
            },
            (1 | 2, Slot.One(d)) if id_gt(view(d), 10) => {
                print("or-guard ");
                print_int(d.id as i64);
                print("\n");
            },
            _ => {},
        }
        print("after-or-guard\n");
    }

    {
        let mut h = Holder { slot: Option.Some(D { id: 20 }) };
        replace_if_not_99(mut_view(h), D { id: 21 });
        print("after-view-guard\n");
    }
    0
}
