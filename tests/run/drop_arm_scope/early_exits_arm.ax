// test: run
// modes: interp native
// stdout: ret-arm\ndrop 12\ndrop 11\ndrop 10\ndrop 1\nafter-ret=7\niter0\ndrop 22\ndrop 21\ndrop 20\niter1-break\ndrop 32\ndrop 31\ndrop 30\nafter-loop\nlabeled-break\ndrop 42\ndrop 41\ndrop 40\nafter-labeled=99\n
//
// ADR-0047 / SPEC-12 AXS-DROP-009 §1: early `return`, `continue`, `break`, and labeled
// `break 'outer val` from inside a `match` arm drop the arm's locals, then the arm's pattern
// bindings in reverse order, then any enclosing scopes crossed by the jump.

module main

struct D {
    pub id: i32,
}

impl Drop for D {
    fn drop(self: mut_view<D>) {
        print("drop ");
        print_int(self.id as i64);
        print("\n");
    }
}

enum Msg {
    Pair(D, D),
    Skip,
}

fn early_ret() -> i32 {
    let fn_guard = D { id: 1 };
    let m = Msg.Pair(D { id: 10 }, D { id: 11 });
    match m {
        Msg.Pair(a, b) => {
            let inner = D { id: 12 };
            let _ = a.id + b.id + inner.id + fn_guard.id;
            print("ret-arm\n");
            return 7;
        },
        Msg.Skip => {},
    }
    0
}

pub fn main() -> i32 {
    let r = early_ret();
    print("after-ret=");
    print_int(r as i64);
    print("\n");

    let mut i = 0;
    while i < 3 {
        let loop_local = if i == 0 { D { id: 20 } } else { D { id: 30 } };
        let m = if i == 0 {
            Msg.Pair(D { id: 21 }, D { id: 22 })
        } else {
            Msg.Pair(D { id: 31 }, D { id: 32 })
        };
        i = i + 1;
        match m {
            Msg.Pair(a, b) => {
                let _ = a.id + b.id + loop_local.id;
                if i == 1 {
                    print("iter0\n");
                    continue;
                }
                print("iter1-break\n");
                break;
            },
            Msg.Skip => {},
        }
    }
    print("after-loop\n");

    let lv: i32 = 'outer: loop {
        let outer_g = D { id: 40 };
        loop {
            let m = Msg.Pair(D { id: 41 }, D { id: 42 });
            match m {
                Msg.Pair(a, b) => {
                    let _ = outer_g.id + a.id + b.id;
                    print("labeled-break\n");
                    break 'outer 99;
                },
                Msg.Skip => {},
            }
        }
    };
    print("after-labeled=");
    print_int(lv as i64);
    print("\n");
    0
}
