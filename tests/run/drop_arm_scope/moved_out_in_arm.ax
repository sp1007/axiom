// test: run
// modes: interp native
// stdout: consumed 1\ndrop 1\nin-arm-after-call\ndrop 2\nafter-call-arm\nafter-expr-move 3\ndrop 3\nafter-ret-fn 4\ndrop 4\nbranch-move 5\ndrop 5\nafter-cond-true\nbranch-keep 6\ndrop 6\nafter-cond-false\n
//
// ADR-0047 / SPEC-12 AXS-DROP-003, AXS-DROP-009 §3: a binding moved out inside the arm (into
// a call, a struct/result value, or `return`) is NOT dropped again at the end of the arm.

module main

struct D {
    pub id: i32,
}

impl Drop for D {
    fn drop(self: mut_view<D>) {
        print("drop ");
        print_int(self.id as i64);
        print("\n");
    }
}

enum PairOpt {
    Both(D, D),
    One(D),
    None,
}

fn consume(d: D) {
    print("consumed ");
    print_int(d.id as i64);
    print("\n");
}

fn extract_via_return(p: PairOpt) -> D {
    match p {
        PairOpt.One(d) => {
            return d;
        },
        _ => D { id: 0 },
    }
}

fn cond_move(p: PairOpt, take_it: bool) {
    match p {
        PairOpt.One(d) => {
            if take_it {
                print("branch-move ");
                print_int(d.id as i64);
                print("\n");
                let _k = d;
            } else {
                print("branch-keep ");
                print_int(d.id as i64);
                print("\n");
            }
        },
        _ => {},
    }
}

pub fn main() -> i32 {
    let p1 = PairOpt.Both(D { id: 1 }, D { id: 2 });
    match p1 {
        PairOpt.Both(a, b) => {
            consume(a);
            print("in-arm-after-call\n");
            let _ = b.id;
        },
        _ => {},
    }
    print("after-call-arm\n");

    let p2 = PairOpt.One(D { id: 3 });
    let kept = match p2 {
        PairOpt.One(d) => d,
        _ => D { id: 0 },
    };
    print("after-expr-move ");
    print_int(kept.id as i64);
    print("\n");
    drop(kept);

    let r = extract_via_return(PairOpt.One(D { id: 4 }));
    print("after-ret-fn ");
    print_int(r.id as i64);
    print("\n");
    drop(r);

    cond_move(PairOpt.One(D { id: 5 }), true);
    print("after-cond-true\n");

    cond_move(PairOpt.One(D { id: 6 }), false);
    print("after-cond-false\n");
    0
}
