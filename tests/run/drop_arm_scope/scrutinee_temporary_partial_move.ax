// test: run
// modes: interp native
// stdout: temp-pair 1\ndrop 1\ndrop 2\nafter-temp-pair\ntemp-enum 3\ndrop 3\ndrop 4\nafter-temp-enum\ntemp-wild\ndrop 5\ndrop 6\nafter-temp-wild\ntemp-iflet 7\ndrop 7\ndrop 8\nafter-temp-iflet\ntemp-expr\ndrop 9\ndrop 10\nres=17\nafter-temp-expr\n
//
// ADR-0047 / SPEC-12 AXS-DROP-009 §5: when the scrutinee is a temporary (rvalue), bindings
// drop at the end of the arm, and remaining unbound parts of the temporary drop at the end of
// the `match` / `if let` statement (before the next statement).

module main

struct D {
    pub id: i32,
}

impl Drop for D {
    fn drop(self: mut_view<D>) {
        print("drop ");
        print_int(self.id as i64);
        print("\n");
    }
}

struct Pair {
    pub a: D,
    pub b: D,
}

enum Duo {
    Both(D, D),
    Empty,
}

fn make_pair(a: i32, b: i32) -> Pair {
    Pair { a: D { id: a }, b: D { id: b } }
}

fn make_duo(a: i32, b: i32) -> Duo {
    Duo.Both(D { id: a }, D { id: b })
}

pub fn main() -> i32 {
    match make_pair(1, 2) {
        Pair { a, .. } => {
            print("temp-pair ");
            print_int(a.id as i64);
            print("\n");
        },
    }
    print("after-temp-pair\n");

    match make_duo(3, 4) {
        Duo.Both(x, _) => {
            print("temp-enum ");
            print_int(x.id as i64);
            print("\n");
        },
        Duo.Empty => {},
    }
    print("after-temp-enum\n");

    match make_pair(5, 6) {
        _ => {
            print("temp-wild\n");
        },
    }
    print("after-temp-wild\n");

    if let Duo.Both(x, _) = make_duo(7, 8) {
        print("temp-iflet ");
        print_int(x.id as i64);
        print("\n");
    }
    print("after-temp-iflet\n");

    let res = match make_duo(9, 10) {
        Duo.Both(x, _) => {
            print("temp-expr\n");
            x.id + 8
        },
        Duo.Empty => 0,
    };
    print("res=");
    print_int(res as i64);
    print("\n");
    print("after-temp-expr\n");
    0
}
