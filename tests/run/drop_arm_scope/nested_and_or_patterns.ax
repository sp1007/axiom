// test: run
// modes: interp native
// stdout: nested 1 2 3\ndrop 3\ndrop 2\ndrop 1\nafter-nested\nor1 10 11\ndrop 11\ndrop 10\nafter-or1\nor2 20 21\ndrop 21\ndrop 20\nafter-or2\nnested-or 30\ndrop 30\nafter-nested-or\nrefute-second 40\ndrop 40\nafter-refute\nreordered 51 50\ndrop 50\ndrop 51\nafter-reordered\n
//
// ADR-0047 / SPEC-12 AXS-DROP-009 §1: nested patterns, nested OR-patterns alongside bindings,
// struct field pattern order (`Sub { y: first, x: second }` drops `second` then `first`), and
// refutable sibling sub-patterns (`(Some(x), 1)` failing on `2` without moving or dropping `x`,
// so the next arm `(Some(x), 2)` binds `x` cleanly).
// Note: v0.1 grammar has no `x @ P` syntax (`@` is attributes only, SPEC-02).

module main

struct D {
    pub id: i32,
}

impl Drop for D {
    fn drop(self: mut_view<D>) {
        print("drop ");
        print_int(self.id as i64);
        print("\n");
    }
}

struct Sub {
    pub x: D,
    pub y: D,
}

enum Outer {
    Deep(Sub, (D, i32)),
    Plain,
}

enum Choice {
    Left(D),
    PairA(D, D),
}

enum Tag {
    A,
    B,
    C,
}

fn run_or(tag: i32, c: Choice, label: str) {
    let inp = (tag, c);
    match inp {
        (1 | 2, Choice.PairA(a, b)) => {
            print(label);
            print(" ");
            print_int(a.id as i64);
            print(" ");
            print_int(b.id as i64);
            print("\n");
        },
        _ => {},
    }
}

pub fn main() -> i32 {
    let o = Outer.Deep(Sub { x: D { id: 1 }, y: D { id: 2 } }, (D { id: 3 }, 9));
    match o {
        Outer.Deep(Sub { x: a, y: b }, (c, 9)) => {
            print("nested ");
            print_int(a.id as i64);
            print(" ");
            print_int(b.id as i64);
            print(" ");
            print_int(c.id as i64);
            print("\n");
        },
        _ => {},
    }
    print("after-nested\n");

    run_or(1, Choice.PairA(D { id: 10 }, D { id: 11 }), "or1");
    print("after-or1\n");

    run_or(2, Choice.PairA(D { id: 20 }, D { id: 21 }), "or2");
    print("after-or2\n");

    let no = Option.Some((Choice.Left(D { id: 30 }), Tag.B));
    match no {
        Option.Some((Choice.Left(x), Tag.A | Tag.B)) => {
            print("nested-or ");
            print_int(x.id as i64);
            print("\n");
        },
        _ => {},
    }
    print("after-nested-or\n");

    let tup = (Option.Some(D { id: 40 }), 2);
    match tup {
        (Option.Some(x), 1) => {
            print("wrong ");
            print_int(x.id as i64);
            print("\n");
        },
        (Option.Some(x), 2) => {
            print("refute-second ");
            print_int(x.id as i64);
            print("\n");
        },
        _ => {},
    }
    print("after-refute\n");

    let sub = Sub { x: D { id: 50 }, y: D { id: 51 } };
    match sub {
        Sub { y: first, x: second } => {
            print("reordered ");
            print_int(first.id as i64);
            print(" ");
            print_int(second.id as i64);
            print("\n");
        },
    }
    print("after-reordered\n");
    0
}
