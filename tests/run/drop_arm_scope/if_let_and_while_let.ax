// test: run
// modes: interp native
// stdout: then 1 2\ndrop 10\ndrop 2\ndrop 1\nafter-if-some\nelse-branch\ndrop 20\nafter-if-none\nelse-if 3\ndrop 3\nafter-else-if\nwl-norm 1\ndrop 101\ndrop 32\ndrop 31\nwl-cont 2\ndrop 102\ndrop 42\ndrop 41\nwl-break 3\ndrop 103\ndrop 52\ndrop 51\nafter-while-let\nwl-end 1\ndrop 61\nwl-end 2\ndrop 62\nafter-while-let-exhausted\n
//
// ADR-0047 / SPEC-12 AXS-DROP-009 §4: `if let P = e { A } else { B }` drops `P`'s bindings at
// the end of `A` (never in `B`); `while let P = e { A }` drops `P`'s bindings at the end of
// each iteration of `A` as well as on `continue` and `break`.

module main

struct D {
    pub id: i32,
}

impl Drop for D {
    fn drop(self: mut_view<D>) {
        print("drop ");
        print_int(self.id as i64);
        print("\n");
    }
}

enum Item {
    Pair(D, D),
    One(D),
    Empty,
}

fn next_item(step: mut_view<i32>) -> Item {
    *step = *step + 1;
    if *step == 1 {
        Item.Pair(D { id: 31 }, D { id: 32 })
    } else if *step == 2 {
        Item.Pair(D { id: 41 }, D { id: 42 })
    } else if *step == 3 {
        Item.Pair(D { id: 51 }, D { id: 52 })
    } else {
        Item.Empty
    }
}

fn next_two(step: mut_view<i32>) -> Option<D> {
    *step = *step + 1;
    if *step == 1 {
        Option.Some(D { id: 61 })
    } else if *step == 2 {
        Option.Some(D { id: 62 })
    } else {
        Option.None
    }
}

pub fn main() -> i32 {
    let s1 = Item.Pair(D { id: 1 }, D { id: 2 });
    if let Item.Pair(a, b) = s1 {
        let loc = D { id: 10 };
        print("then ");
        print_int(a.id as i64);
        print(" ");
        print_int((b.id + loc.id - 10) as i64);
        print("\n");
    } else {
        print("unexpected\n");
    }
    print("after-if-some\n");

    let s2 = Item.Empty;
    if let Item.Pair(a, b) = s2 {
        let _ = a.id + b.id;
    } else {
        let eloc = D { id: 20 };
        let _ = eloc.id;
        print("else-branch\n");
    }
    print("after-if-none\n");

    let s3 = Item.One(D { id: 3 });
    if let Item.Pair(a, _) = s3 {
        let _ = a.id;
    } else if let Item.One(c) = s3 {
        print("else-if ");
        print_int(c.id as i64);
        print("\n");
    }
    print("after-else-if\n");

    let mut step = 0;
    while let Item.Pair(a, b) = next_item(mut_view(step)) {
        let body_d = D { id: 100 + step };
        let _ = a.id + b.id + body_d.id;
        if step == 1 {
            print("wl-norm 1\n");
        } else if step == 2 {
            print("wl-cont 2\n");
            continue;
        } else {
            print("wl-break 3\n");
            break;
        }
    }
    print("after-while-let\n");

    let mut step2 = 0;
    while let Option.Some(d) = next_two(mut_view(step2)) {
        print("wl-end ");
        print_int(step2 as i64);
        print("\n");
        let _ = d.id;
    }
    print("after-while-let-exhausted\n");
    0
}
