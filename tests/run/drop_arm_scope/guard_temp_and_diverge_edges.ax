// test: run
// modes: interp native
// stdout: drop 11\ndrop 12\ntop-or-hit\nafter-top-or\nfdrop 21\nfdrop 22\nflag-ok 20\ndrop 20\nafter-flag\ndrop 36\ndrop 35\ndrop 39\ndrop 37\nsc-ok 30\ndrop 30\ndrop 38\nsc-ok 31\ndrop 31\nafter-sc\ndrop 52\ngtry-fall 51\ndrop 51\ngtry-after 50\ndrop 50\nres0=51\ndrop 62\ngtry-hit 61\ndrop 61\ngtry-after 60\ndrop 60\nres1=61\ndrop 72\ndrop 71\ndrop 70\nres2-err=79\ndrop 79\ndrop 82\ndrop 81\ndrop 80\nuncond-ret=88\ndrop 90\nwbody 0\ndrop 91\nwbody 1\ndrop 92\nafter-while\n
//
// T445a round 1 regression (F1 + guard/condition temporary & divergence edges):
// - top-level OR-pattern (`1 | 2 if ...`) with droppable temporaries in the guard (failing & matching)
// - guard operand projecting a `bool` field out of a droppable temporary whose `Drop` mutates the field
// - multiple droppable temporaries in a guard (LIFO reverse drop order) and short-circuit `&&` / `||`
//   inside a loop (drop flags re-armed and cleared cleanly across iterations)
// - `?` (`Result<bool, D>`) and unconditional `return` inside a `match` guard
// - `while` condition allocating a droppable temporary (dropped on both body and exit edges)

module main

struct D {
    pub id: i32,
}

impl Drop for D {
    fn drop(self: mut_view<D>) {
        print("drop ");
        print_int(self.id as i64);
        print("\n");
    }
}

struct FlagBox {
    pub id: i32,
    pub flag: bool,
}

impl Drop for FlagBox {
    fn drop(self: mut_view<FlagBox>) {
        self.flag = !self.flag;
        print("fdrop ");
        print_int(self.id as i64);
        print("\n");
    }
}

fn mk(id: i32) -> D {
    D { id: id }
}

fn mk_flag(id: i32, flag: bool) -> FlagBox {
    FlagBox { id: id, flag: flag }
}

fn eq2(a: i32, b: i32) -> bool {
    a == b
}

fn test_top_level_or_guard_temps() {
    let v = 2;
    match v {
        1 | 2 if mk(11).id == v => {
            print("wrong-top-or\n");
        },
        1 | 2 if mk(12).id == 12 => {
            print("top-or-hit\n");
        },
        _ => {},
    }
    print("after-top-or\n");
}

fn test_projected_bool_temp_in_guard() {
    let x = Option.Some(mk(20));
    match x {
        Option.Some(g) if mk_flag(21, false).flag => {
            let _ = g.id;
            print("wrong-flag\n");
        },
        Option.Some(g) if mk_flag(22, true).flag => {
            print("flag-ok ");
            print_int(g.id as i64);
            print("\n");
        },
        _ => {},
    }
    print("after-flag\n");
}

fn test_multi_temp_and_short_circuit_guard() {
    let mut step = 0;
    while step < 2 {
        let item = Option.Some(mk(30 + step));
        match item {
            Option.Some(g) if (step == 0) && eq2(mk(35).id, mk(36).id) => {
                let _ = g.id;
                print("wrong-sc\n");
            },
            Option.Some(g) if (mk(37 + step).id == 38) || (mk(39 + step).id == 39) => {
                print("sc-ok ");
                print_int(g.id as i64);
                print("\n");
            },
            _ => {},
        }
        step = step + 1;
    }
    print("after-sc\n");
}

fn step_bool_res(mode: i32) -> Result<bool, D> {
    if mode == 0 {
        Result.Ok(false)
    } else if mode == 1 {
        Result.Ok(true)
    } else {
        Result.Err(mk(79))
    }
}

fn guard_try_res(mode: i32, base: i32) -> Result<i32, D> {
    let outer = mk(base);
    let s = Option.Some(mk(base + 1));
    let mut out = 0;
    match s {
        Option.Some(g) if (mk(base + 2).id == (base + 2)) && step_bool_res(mode)? => {
            print("gtry-hit ");
            print_int(g.id as i64);
            print("\n");
            out = g.id;
        },
        Option.Some(g) => {
            print("gtry-fall ");
            print_int(g.id as i64);
            print("\n");
            out = g.id;
        },
        Option.None => {},
    }
    print("gtry-after ");
    print_int(outer.id as i64);
    print("\n");
    Result.Ok(out)
}

fn guard_uncond_return() -> i32 {
    let outer = mk(80);
    let r = match Option.Some(mk(81)) {
        Option.Some(g) if {
            let gt = mk(82);
            let _ = g.id + gt.id + outer.id;
            return 88;
        } => 0,
        _ => 1,
    };
    r
}

fn test_diverging_guards_and_try() {
    match guard_try_res(0, 50) {
        Result.Ok(v) => {
            print("res0=");
            print_int(v as i64);
            print("\n");
        },
        Result.Err(_) => {},
    }
    match guard_try_res(1, 60) {
        Result.Ok(v) => {
            print("res1=");
            print_int(v as i64);
            print("\n");
        },
        Result.Err(_) => {},
    }
    match guard_try_res(2, 70) {
        Result.Ok(_) => {},
        Result.Err(e) => {
            print("res2-err=");
            print_int(e.id as i64);
            print("\n");
        },
    }
    let ur = guard_uncond_return();
    print("uncond-ret=");
    print_int(ur as i64);
    print("\n");
}

fn test_while_cond_temp() {
    let mut wi = 0;
    while mk(90 + wi).id < 92 {
        print("wbody ");
        print_int(wi as i64);
        print("\n");
        wi = wi + 1;
    }
    print("after-while\n");
}

pub fn main() -> i32 {
    test_top_level_or_guard_temps();
    test_projected_bool_temp_in_guard();
    test_multi_temp_and_short_circuit_guard();
    test_diverging_guards_and_try();
    test_while_cond_temp();
    0
}
