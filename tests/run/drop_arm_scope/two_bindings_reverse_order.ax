// test: run
// modes: interp native
// stdout: two 1 2\ndrop 2\ndrop 1\nafter-two\nthree 3 4 5\ndrop 5\ndrop 4\ndrop 3\nafter-three\nnamed 6 7\ndrop 7\ndrop 6\nafter-named\npair 8 9\ndrop 9\ndrop 8\nafter-pair\ntup 10 11\ndrop 11\ndrop 10\nafter-tup\n
//
// ADR-0047 / SPEC-12 AXS-DROP-009 §1: multiple by-value bindings in a single pattern are
// dropped at the end of the arm in reverse order of their left-to-right pattern position.

module main

struct D {
    pub id: i32,
}

impl Drop for D {
    fn drop(self: mut_view<D>) {
        print("drop ");
        print_int(self.id as i64);
        print("\n");
    }
}

struct Named {
    pub first: D,
    pub second: D,
}

enum Multi {
    Two(D, D),
    Three(D, D, D),
    Named(Named),
}

struct Pair {
    pub a: D,
    pub b: D,
}

pub fn main() -> i32 {
    let m1 = Multi.Two(D { id: 1 }, D { id: 2 });
    match m1 {
        Multi.Two(a, b) => {
            print("two ");
            print_int(a.id as i64);
            print(" ");
            print_int(b.id as i64);
            print("\n");
        },
        _ => {},
    }
    print("after-two\n");

    let m2 = Multi.Three(D { id: 3 }, D { id: 4 }, D { id: 5 });
    match m2 {
        Multi.Three(a, b, c) => {
            print("three ");
            print_int(a.id as i64);
            print(" ");
            print_int(b.id as i64);
            print(" ");
            print_int(c.id as i64);
            print("\n");
        },
        _ => {},
    }
    print("after-three\n");

    let m3 = Multi.Named(Named { first: D { id: 6 }, second: D { id: 7 } });
    match m3 {
        Multi.Named(Named { first: f, second: s }) => {
            print("named ");
            print_int(f.id as i64);
            print(" ");
            print_int(s.id as i64);
            print("\n");
        },
        _ => {},
    }
    print("after-named\n");

    let p = Pair { a: D { id: 8 }, b: D { id: 9 } };
    match p {
        Pair { a, b } => {
            print("pair ");
            print_int(a.id as i64);
            print(" ");
            print_int(b.id as i64);
            print("\n");
        },
    }
    print("after-pair\n");

    let t = (D { id: 10 }, D { id: 11 });
    match t {
        (x, y) => {
            print("tup ");
            print_int(x.id as i64);
            print(" ");
            print_int(y.id as i64);
            print("\n");
        },
    }
    print("after-tup\n");
    0
}
