// test: run
// modes: interp native
// stdout: drop 99\nok 1\ndrop 1\nafter-plain\ndrop 88\nor-ok 2\ndrop 2\nafter-or\ndrop 77\nhit 3\ndrop 3\nafter-hit\n
//
// T445a QA adversarial (round 0, F1): a `match` guard (`if cond`) that allocates a droppable
// temporary (e.g. `mk(99).id == g.id`) MUST drop that temporary on both the guard-false edge
// (before trying the next arm / OR-alternative) and the guard-true edge (before entering the
// arm body), without triggering `AX_VERIFY_MISSING_DROP` or leaking the temporary.

module main

struct D {
    pub id: i32,
}

impl Drop for D {
    fn drop(self: mut_view<D>) {
        print("drop ");
        print_int(self.id as i64);
        print("\n");
    }
}

fn mk(id: i32) -> D {
    D { id: id }
}

pub fn main() -> i32 {
    let x = Option.Some(mk(1));
    match x {
        Option.Some(g) if mk(99).id == g.id => {
            print("wrong\n");
        },
        Option.Some(g) => {
            print("ok ");
            print_int(g.id as i64);
            print("\n");
        },
        Option.None => {},
    }
    print("after-plain\n");

    let y = (2, Option.Some(mk(2)));
    match y {
        (1 | 2, Option.Some(g)) if mk(88).id == g.id => {
            print("wrong-or\n");
        },
        (1 | 2, Option.Some(g)) => {
            print("or-ok ");
            print_int(g.id as i64);
            print("\n");
        },
        _ => {},
    }
    print("after-or\n");

    let z = Option.Some(mk(3));
    match z {
        Option.Some(g) if mk(77).id == 77 => {
            print("hit ");
            print_int(g.id as i64);
            print("\n");
        },
        _ => {},
    }
    print("after-hit\n");
    0
}
