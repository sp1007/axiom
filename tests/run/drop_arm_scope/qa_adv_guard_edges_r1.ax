// test: run
// modes: interp native
// stdout: drop 41\ndrop 40\nor-ret=42\ndrop 35\ndrop 30\nloop-hit 20\ndrop 20\nloop-end 10\ndrop 10\ndrop 36\ndrop 31\ndrop 21\ndrop 11\ndrop 37\ndrop 32\ndrop 22\ndrop 12\nafter-loop\ndrop 52\ndrop 51\nnested-ok 50\ndrop 50\nafter-nested\n
//
// T445a QA adversarial (round 1): boundary seams for guard-temporary unwinding & divergence:
// 1. Top-level OR-pattern arm (`1 | 2 if { ... return 42; }`) where all guard alternatives
//    diverge unconditionally (`any_alt_ok == false` -> `bb_arm_body` unreachable).
// 2. `continue` and `break` inside a `match` guard inside a `while` loop with a loop local,
//    a droppable temporary scrutinee, a short-circuit `&&` guard temporary, and a guard block local.
// 3. Nested `match` inside a `match` guard (inner guard temp + inner arm binding drop before
//    outer guard finishes; outer scrutinee remains unmoved on guard-false).

module main

struct D {
    pub id: i32,
}

impl Drop for D {
    fn drop(self: mut_view<D>) {
        print("drop ");
        print_int(self.id as i64);
        print("\n");
    }
}

fn mk(id: i32) -> D {
    D { id: id }
}

fn or_guard_uncond_ret(v: i32) -> i32 {
    let outer = mk(40);
    let r = match v {
        1 | 2 if {
            let gt = mk(41);
            let _ = gt.id + outer.id;
            return 42;
        } => 0,
        _ => 1,
    };
    r
}

fn test_guard_continue_break_in_loop() {
    let mut i = 0;
    while i < 3 {
        let cur = i;
        i = i + 1;
        let lv = mk(10 + cur);
        match Option.Some(mk(20 + cur)) {
            Option.Some(g) if (mk(30 + cur).id > 0) && {
                let gb = mk(35 + cur);
                let _ = g.id + lv.id + gb.id;
                if cur == 1 {
                    continue;
                }
                if cur == 2 {
                    break;
                }
                true
            } => {
                print("loop-hit ");
                print_int(g.id as i64);
                print("\n");
            },
            _ => {
                print("loop-miss\n");
            },
        }
        print("loop-end ");
        print_int(lv.id as i64);
        print("\n");
    }
    print("after-loop\n");
}

fn test_nested_match_in_guard() {
    let x = Option.Some(mk(50));
    match x {
        Option.Some(g) if match Option.Some(mk(51)) {
            Option.Some(inner) if mk(52).id == 52 => inner.id == g.id,
            _ => false,
        } => {
            print("nested-wrong\n");
        },
        Option.Some(g) => {
            print("nested-ok ");
            print_int(g.id as i64);
            print("\n");
        },
        Option.None => {},
    }
    print("after-nested\n");
}

pub fn main() -> i32 {
    let r = or_guard_uncond_ret(2);
    print("or-ret=");
    print_int(r as i64);
    print("\n");
    test_guard_continue_break_in_loop();
    test_nested_match_in_guard();
    0
}
