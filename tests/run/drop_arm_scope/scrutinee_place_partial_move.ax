// test: run
// modes: interp native
// stdout: struct-arm 1\ndrop 1\nafter-struct-match\ndrop 2\ntup-arm 3\ndrop 3\nafter-tup-match\ndrop 4\nenum-arm 5\ndrop 5\nafter-enum-match\ndrop 6\ncond-move 7\ndrop 7\nafter-cond-true\ndrop 8\nafter-cond-false\ndrop 9\ndrop 10\nreinit-arm 11\ndrop 11\nafter-reinit\ndrop 13\ndrop 12\nnested-arm 14\ndrop 14\ndrop 15\nafter-nested-reinit\ndrop 17\ndrop 16\n
//
// ADR-0047 / SPEC-12 AXS-DROP-009 §5: when the scrutinee is a place, parts bound by value drop
// at the end of the arm, while parts NOT moved into bindings stay in the scrutinee place and
// are dropped by that place's own scope using partial-move drop flags (AXS-DROP-003).

module main

struct D {
    pub id: i32,
}

impl Drop for D {
    fn drop(self: mut_view<D>) {
        print("drop ");
        print_int(self.id as i64);
        print("\n");
    }
}

struct Pair {
    pub a: D,
    pub b: D,
}

struct OuterPair {
    pub inner: Pair,
    pub extra: D,
}

enum Duo {
    Both(D, D),
    Empty,
}

fn run_cond_partial(take_first: bool, id_a: i32, id_b: i32) {
    let p = Pair { a: D { id: id_a }, b: D { id: id_b } };
    if take_first {
        match p {
            Pair { a, .. } => {
                print("cond-move ");
                print_int(a.id as i64);
                print("\n");
            },
        }
        print("after-cond-true\n");
    } else {
        print("after-cond-false\n");
    }
}

pub fn main() -> i32 {
    {
        let p = Pair { a: D { id: 1 }, b: D { id: 2 } };
        match p {
            Pair { a, .. } => {
                print("struct-arm ");
                print_int(a.id as i64);
                print("\n");
            },
        }
        print("after-struct-match\n");
    }

    {
        let t = (D { id: 3 }, D { id: 4 });
        match t {
            (x, _) => {
                print("tup-arm ");
                print_int(x.id as i64);
                print("\n");
            },
        }
        print("after-tup-match\n");
    }

    {
        let e = Duo.Both(D { id: 5 }, D { id: 6 });
        match e {
            Duo.Both(x, _) => {
                print("enum-arm ");
                print_int(x.id as i64);
                print("\n");
            },
            Duo.Empty => {},
        }
        print("after-enum-match\n");
    }

    run_cond_partial(true, 7, 8);
    run_cond_partial(false, 9, 10);

    {
        let mut p = Pair { a: D { id: 11 }, b: D { id: 12 } };
        match p {
            Pair { a, .. } => {
                print("reinit-arm ");
                print_int(a.id as i64);
                print("\n");
            },
        }
        p.a = D { id: 13 };
        print("after-reinit\n");
    }

    {
        let mut o = OuterPair {
            inner: Pair { a: D { id: 14 }, b: D { id: 15 } },
            extra: D { id: 16 },
        };
        match o.inner {
            Pair { a, .. } => {
                print("nested-arm ");
                print_int(a.id as i64);
                print("\n");
            },
        }
        o.inner.b = D { id: 17 };
        print("after-nested-reinit\n");
    }
    0
}
