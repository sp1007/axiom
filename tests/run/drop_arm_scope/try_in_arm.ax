// test: run
// modes: interp native
// stdout: ok-body 10\ndrop 4\ndrop 3\ndrop 2\nafter-match-ok\ndrop 1\ngot-ok=15\nerr-before-try\ndrop 14\ndrop 13\ndrop 12\ndrop 11\ngot-err=99\ndrop 99\nopt-before-try\ndrop 23\ndrop 22\ndrop 21\ngot-none\n
//
// ADR-0047 / SPEC-12 AXS-DROP-009 §1: `?` (`Result` and `Option`) inside a `match` arm drops
// the arm's locals and pattern bindings in reverse order on both Ok/Some and Err/None paths.

module main

struct D {
    pub id: i32,
}

impl Drop for D {
    fn drop(self: mut_view<D>) {
        print("drop ");
        print_int(self.id as i64);
        print("\n");
    }
}

enum Boxed {
    Pair(D, D),
    Empty,
}

fn step_res(fail: bool) -> Result<i32, D> {
    if fail {
        Result.Err(D { id: 99 })
    } else {
        Result.Ok(10)
    }
}

fn run_res(fail: bool) -> Result<i32, D> {
    let outer = D { id: if fail { 11 } else { 1 } };
    let b = Boxed.Pair(
        D { id: if fail { 12 } else { 2 } },
        D { id: if fail { 13 } else { 3 } }
    );
    let mut acc = 0;
    match b {
        Boxed.Pair(x, y) => {
            let inner = D { id: if fail { 14 } else { 4 } };
            if fail {
                print("err-before-try\n");
            }
            let v = step_res(fail)?;
            print("ok-body ");
            print_int(v as i64);
            print("\n");
            acc = v + x.id + y.id + inner.id - 4;
        },
        Boxed.Empty => {},
    }
    print("after-match-ok\n");
    let _ = outer.id;
    Result.Ok(acc)
}

fn step_opt(none: bool) -> Option<i32> {
    if none {
        Option.None
    } else {
        Option.Some(1)
    }
}

fn run_opt() -> Option<i32> {
    let outer = D { id: 21 };
    let b = Boxed.Pair(D { id: 22 }, D { id: 23 });
    match b {
        Boxed.Pair(x, y) => {
            print("opt-before-try\n");
            let v = step_opt(true)?;
            let _ = x.id + y.id + outer.id + v;
        },
        Boxed.Empty => {},
    }
    Option.Some(0)
}

pub fn main() -> i32 {
    match run_res(false) {
        Result.Ok(v) => {
            print("got-ok=");
            print_int(v as i64);
            print("\n");
        },
        Result.Err(_) => {},
    }
    match run_res(true) {
        Result.Ok(_) => {},
        Result.Err(e) => {
            print("got-err=");
            print_int(e.id as i64);
            print("\n");
        },
    }
    match run_opt() {
        Option.Some(_) => {},
        Option.None => {
            print("got-none\n");
        },
    }
    0
}
