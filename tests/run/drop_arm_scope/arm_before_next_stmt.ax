// test: run
// modes: interp native
// stdout: in-arm 1\ndrop 10\ndrop 1\nafter-stmt-match\ndrop 20\ndrop 2\nval=42\nafter-expr-match\ndrop 99\n
//
// ADR-0047 / SPEC-12 AXS-DROP-009 §1: a by-value `match` arm binding is dropped at the end of
// the arm — after the arm body's own locals, and before the statement following the `match`.

module main

struct D {
    pub id: i32,
}

impl Drop for D {
    fn drop(self: mut_view<D>) {
        print("drop ");
        print_int(self.id as i64);
        print("\n");
    }
}

enum Wrap {
    Val(D),
    Empty,
}

fn make_temp(id: i32) -> D {
    D { id: id }
}

pub fn main() -> i32 {
    let outer = D { id: 99 };

    let w1 = Wrap.Val(D { id: 1 });
    match w1 {
        Wrap.Val(x) => {
            let body_local = D { id: 10 };
            print("in-arm ");
            print_int((x.id + body_local.id - 10) as i64);
            print("\n");
        },
        Wrap.Empty => {},
    }
    print("after-stmt-match\n");

    let w2 = Wrap.Val(D { id: 2 });
    let v = match w2 {
        Wrap.Val(y) => make_temp(20).id + y.id + 20,
        Wrap.Empty => 0,
    };
    print("val=");
    print_int(v as i64);
    print("\n");
    print("after-expr-match\n");
    let _ = outer.id;
    0
}
