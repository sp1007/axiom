// test: run
// modes: interp native
// stdout: 155\n

struct Pair {
    a: i32,
    b: i32,
}

fn bump(dst: mut_view<i32>, src: view<i32>) {
    *dst = *dst + *src;
}

fn compute(flag: i32) -> i32 {
    let base: i32 = 5;
    let cpy: i32 = base;
    let p = Pair { a: cpy, b: 10 };
    let mut acc: i32 = p.a + p.b;
    if flag > 0 {
        acc = acc + 30;
    } else {
        acc = acc + 40;
    }
    let mut i: i32 = 0;
    let step: i32 = 25;
    while i < 4 {
        bump(mut_view(acc), view(step));
        i = i + 1;
    }
    acc + p.b
}

fn main() -> i32 {
    let ans = compute(1);
    print_int(ans);
    print("\n");
    if ans == 155 {
        return 0;
    }
    1
}
