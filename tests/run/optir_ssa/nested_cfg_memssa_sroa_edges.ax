// test: run
// modes: interp native
// stdout: 246\n

struct Vec3 {
    x: i32,
    y: i32,
    z: i32,
}

struct BoxedPair {
    lo: i32,
    hi: i32,
}

fn read_boxed_sum(bp: view<BoxedPair>) -> i32 {
    (*bp).lo + (*bp).hi
}

fn add_into(dst: mut_view<i32>, delta: view<i32>) {
    *dst = *dst + *delta;
}

fn run_edges(n: i32) -> i32 {
    let mut v = Vec3 { x: 4, y: 6, z: 10 };
    v.x = v.x + 1;
    v.z = v.y * 2;
    let sroa_sum: i32 = v.x + v.y + v.z;

    let bp = BoxedPair { lo: 30, hi: 70 };
    let mem_base: i32 = read_boxed_sum(view(bp));

    let mut acc: i32 = sroa_sum + mem_base;
    let mut bonus: i32 = 10;
    let mut i: i32 = 0;
    let bump50: i32 = 50;
    while i < n {
        if i == 1 {
            add_into(mut_view(bonus), view(bump50));
        }
        if (i % 2) == 0 {
            acc = acc + 20;
        } else {
            acc = acc + 30;
        }
        let step_copy: i32 = i;
        acc = acc + step_copy;
        i = i + 1;
    }

    let final_acc: i32 = acc;
    let slot: i32 = bonus - 10;
    final_acc + slot
}

fn main() -> i32 {
    let res = run_edges(3);
    print_int(res);
    print("\n");
    if res == 246 {
        return 0;
    }
    1
}
