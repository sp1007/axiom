// test: run
// exit: 101
// Verifies that LICM does NOT hoist a trapping division across a conditional or early-exiting
// path, and that side effects before the panicking iteration are preserved.

fn loop_trap_at_iter_two(denom: i32) -> i32 {
    let mut i: i32 = 0;
    let mut acc: i32 = 0;
    while i < 5 {
        print("STEP=");
        print_int(i);
        print("\n");
        if i == 2 {
            let trap_val: i32 = 100 / denom;
            acc = acc + trap_val;
        }
        i = i + 1;
    }
    acc
}

fn main() -> i32 {
    let r: i32 = loop_trap_at_iter_two(0);
    print_int(r);
    0
}
