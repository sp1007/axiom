// test: run
// stdout: ITER_DROP=100\nITER_DROP=101\nITER_DROP=102\nPEEL_N0=0\nPEEL_N1=33\nPEEL_N2=66\nUNSW_ZERO=42\nLIVEOUT_FUSE=90\nDROP_CNT=3\n

struct IterDropGuard {
    tag: i32,
}

impl Drop for IterDropGuard {
    fn drop(self: mut_view<IterDropGuard>) {
        print("ITER_DROP=");
        print_int(self.tag);
        print("\n");
    }
}

fn peel_variable_trip(a: view<[i32]>, n: usize) -> i32 {
    let mut i: usize = 0;
    let mut acc: i32 = 0;
    while i < n {
        if i == 0 {
            acc = acc + a[0] * 3;
        } else {
            acc = acc + a[i - 1] + a[i];
        }
        i = i + 1;
    }
    acc
}

fn peel_single_trip_const(a: view<[i32]>) -> i32 {
    let mut i: usize = 0;
    let mut acc: i32 = 0;
    while i < 1 {
        if i == 0 {
            acc = acc + a[0] * 3;
        } else {
            acc = acc + a[i - 1] + a[i];
        }
        i = i + 1;
    }
    acc
}

fn unswitch_zero_trip_with_trap(n: usize, flag: bool, zero_denom: i32) -> i32 {
    let mut i: usize = 0;
    let mut acc: i32 = 42;
    while i < n {
        if flag {
            acc = acc + (100 / zero_denom);
        } else {
            acc = acc + 1;
        }
        i = i + 1;
    }
    acc
}

fn fuse_with_liveout_buffer_read() -> i32 {
    let src: [4]i32 = [2, 4, 6, 8];
    let mut tmp: [4]i32 = [0, 0, 0, 0];

    let mut i: usize = 0;
    while i < 4 {
        tmp[i] = src[i] * 3;
        i = i + 1;
    }

    let mut j: usize = 0;
    let mut sum: i32 = 0;
    while j < 4 {
        sum = sum + tmp[j];
        j = j + 1;
    }

    // `tmp` is read outside the fused loops, so `tmp[i] = src[i] * 3` must NOT be dead-store elided!
    sum + tmp[0] + tmp[3]
}

fn loop_drop_continue_and_break() -> i32 {
    let mut i: i32 = 0;
    let mut count: i32 = 0;
    while i < 5 {
        let _g = IterDropGuard { tag: 100 + i };
        count = count + 1;
        if i == 1 {
            i = i + 1;
            continue;
        }
        if i == 2 {
            break;
        }
        i = i + 1;
    }
    count
}

fn main() -> i32 {
    let arr: [4]i32 = [11, 22, 33, 44];
    let sv: view<[i32]> = view(arr);

    let dcnt: i32 = loop_drop_continue_and_break();
    let p0: i32 = peel_variable_trip(sv, 0);
    let p1: i32 = peel_single_trip_const(sv);
    let p2: i32 = peel_variable_trip(sv, 2);
    let uz: i32 = unswitch_zero_trip_with_trap(0, true, 0);
    let lf: i32 = fuse_with_liveout_buffer_read();

    print("PEEL_N0=");
    print_int(p0);
    print("\nPEEL_N1=");
    print_int(p1);
    print("\nPEEL_N2=");
    print_int(p2);
    print("\nUNSW_ZERO=");
    print_int(uz);
    print("\nLIVEOUT_FUSE=");
    print_int(lf);
    print("\nDROP_CNT=");
    print_int(dcnt);
    print("\n");
    0
}
