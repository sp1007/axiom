// test: run
// exit: 101
// Verifies that when a versioned symbolic loop (`while i < n`) is called with `n > len(slice)`,
// the pure preheader guard (`n <= len(slice)`) routes execution to the fallback loop, which
// executes iterations 0..len(slice)-1 and panics at `i == len(slice)`.

fn sum_prefix_versioned(s: view<[i32]>, n: usize) -> i32 {
    let mut i: usize = 0;
    let mut acc: i32 = 0;
    while i < n {
        acc = acc + s[i];
        i = i + 1;
    }
    acc
}

fn main() -> i32 {
    let arr: [4]i32 = [10, 20, 30, 40];
    let sv: view<[i32]> = view(arr);
    let oob_n: usize = 6;
    let res: i32 = sum_prefix_versioned(sv, oob_n);
    print_int(res);
    0
}
