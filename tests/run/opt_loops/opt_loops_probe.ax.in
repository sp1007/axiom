@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }

struct ProbeTypes {
    thir: *mut Thir,
    ty_i32: u32,
    ty_usize: u32,
    ty_bool: u32,
    ty_f64: u32,
    ty_arr8_i32: u32,
}

fn probe_set_ty_slot(types_arr: *mut *mut AxType, idx: usize, ptr: *mut AxType) {
    let slot = ((types_arr as usize) + mir_mul_usize(idx, size_of<*mut AxType>())) as *mut *mut AxType;
    unsafe { *slot = ptr; }
}

fn pb_init_types(arena: mut_view<Arena>) -> ProbeTypes {
    let thir_ptr = arena_alloc_raw(mut_view(*arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    let types_arr = arena_alloc_raw(mut_view(*arena), mir_mul_usize(32, size_of<*mut AxType>()), align_of<*mut AxType>()) as *mut *mut AxType;
    let pool = arena_alloc_raw(mut_view(*arena), mir_mul_usize(28, size_of<AxType>()), align_of<AxType>());
    let ty_sz = size_of<AxType>();

    let mut k: usize = 0;
    while k < 16 {
        let tp = ((pool as usize) + mir_mul_usize(k, ty_sz)) as *mut AxType;
        let tk: u8 = if k < 9 { k as u8 }
            else if k == 9 { TY_ISIZE }
            else if k == 10 { TY_U8 }
            else if k == 11 { TY_U16 }
            else if k == 12 { TY_U32 }
            else if k == 13 { TY_U64 }
            else if k == 14 { TY_USIZE }
            else { TY_STR };
        unsafe { ax_type_reset(mut_view(*tp), tk); }
        probe_set_ty_slot(types_arr, k, tp);
        k = k + 1;
    }

    let mut c: usize = 16;
    while c < 22 {
        let cp = ((pool as usize) + mir_mul_usize(c, ty_sz)) as *mut AxType;
        unsafe { ax_type_reset(mut_view(*cp), 0u8); }
        probe_set_ty_slot(types_arr, c, cp);
        c = c + 1;
    }

    let t17 = ((pool as usize) + mir_mul_usize(16, ty_sz)) as *mut AxType;
    let t18 = ((pool as usize) + mir_mul_usize(17, ty_sz)) as *mut AxType;
    let t19 = ((pool as usize) + mir_mul_usize(18, ty_sz)) as *mut AxType;
    let t20 = ((pool as usize) + mir_mul_usize(19, ty_sz)) as *mut AxType;
    let t21 = ((pool as usize) + mir_mul_usize(20, ty_sz)) as *mut AxType;
    let t22 = ((pool as usize) + mir_mul_usize(21, ty_sz)) as *mut AxType;
    let scratch_ty = ((pool as usize) + mir_mul_usize(22, ty_sz)) as *mut AxType;
    let fn_params = arena_alloc_raw(mut_view(*arena), size_of<TypeId>(), align_of<TypeId>()) as *mut TypeId;

    unsafe {
        *opt_typeid_at(fn_params, 0) = TypeId { v: 8u32 };
        ax_type_reset(mut_view(*scratch_ty), 0u8);

        (*t17).kind = TY_VIEW;
        (*t17).pointee = TypeId { v: 8u32 };

        (*t18).kind = TY_MUT_VIEW;
        (*t18).is_mut = true;
        (*t18).pointee = TypeId { v: 8u32 };

        (*t19).kind = TY_PTR;
        (*t19).is_mut = true;
        (*t19).pointee = TypeId { v: 8u32 };

        (*t20).kind = TY_ARRAY;
        (*t20).elem = TypeId { v: 8u32 };
        (*t20).array_len = 8u64;

        (*t21).kind = TY_FN;
        (*t21).param_types = fn_params;
        (*t21).param_count = 1;
        (*t21).ret_type = TypeId { v: 8u32 };

        (*t22).kind = LXF_TY_F64;

        (*thir_ptr).interner.arena = arena_new();
        (*thir_ptr).interner.map.keys = 0 as *mut *mut AxType;
        (*thir_ptr).interner.map.vals = 0 as *mut TypeId;
        (*thir_ptr).interner.map.states = 0 as *mut u8;
        (*thir_ptr).interner.map.len = 0;
        (*thir_ptr).interner.map.cap = 0;
        (*thir_ptr).interner.types = types_arr;
        (*thir_ptr).interner.len = 22;
        (*thir_ptr).interner.cap = 32;
        (*thir_ptr).interner.next_int_var = 1u32;
        (*thir_ptr).interner.scratch = scratch_ty;
        (*thir_ptr).interner.t_error.v = 1u32;
        (*thir_ptr).interner.t_unit.v = 2u32;
        (*thir_ptr).interner.t_never.v = 3u32;
        (*thir_ptr).interner.t_bool.v = 4u32;
        (*thir_ptr).interner.t_char.v = 5u32;
        (*thir_ptr).interner.t_i8.v = 6u32;
        (*thir_ptr).interner.t_i16.v = 7u32;
        (*thir_ptr).interner.t_i32.v = 8u32;
        (*thir_ptr).interner.t_i64.v = 9u32;
        (*thir_ptr).interner.t_isize.v = 10u32;
        (*thir_ptr).interner.t_u8.v = 11u32;
        (*thir_ptr).interner.t_u16.v = 12u32;
        (*thir_ptr).interner.t_u32.v = 13u32;
        (*thir_ptr).interner.t_u64.v = 14u32;
        (*thir_ptr).interner.t_usize.v = 15u32;
        (*thir_ptr).interner.t_str.v = 16u32;
        (*thir_ptr).interner.t_i128.v = 0x3FFF0128u32;
        (*thir_ptr).interner.t_u128.v = 0x3FFF0129u32;
        (*thir_ptr).item_types.keys = 0 as *mut usize;
        (*thir_ptr).item_types.vals = 0 as *mut TypeId;
        (*thir_ptr).item_types.states = 0 as *mut u8;
        (*thir_ptr).item_types.len = 0;
        (*thir_ptr).item_types.cap = 0;
        (*thir_ptr).expr_types.keys = 0 as *mut usize;
        (*thir_ptr).expr_types.vals = 0 as *mut TypeId;
        (*thir_ptr).expr_types.states = 0 as *mut u8;
        (*thir_ptr).expr_types.len = 0;
        (*thir_ptr).expr_types.cap = 0;
    }

    ProbeTypes {
        thir: thir_ptr,
        ty_i32: 8u32,
        ty_usize: 15u32,
        ty_bool: 4u32,
        ty_f64: 22u32,
        ty_arr8_i32: 20u32,
    }
}

fn pb_span() -> Span {
    Span { file: FileId { v: 1u32 }, start: 1u32, end: 10u32 }
}

fn pb_new_mir_body(arena: mut_view<Arena>, ret_ty: u32, arg_count: usize) -> *mut MirBody {
    let mb = arena_alloc_raw(mut_view(*arena), size_of<MirBody>(), align_of<MirBody>()) as *mut MirBody;
    unsafe {
        mir_body_reset(mut_view(*mb));
        (*mb).arg_count = arg_count;
    }
    let sp = pb_span();
    let _ = unsafe { mir_add_local(mut_view(*mb), mut_view(*arena), TypeId { v: ret_ty }, 0u8, true, StrId { v: 0u32 }, view(sp)) };
    mb
}

fn pb_add_local(mb: mut_view<MirBody>, arena: mut_view<Arena>, ty: u32, is_arg: bool) -> u32 {
    let sp = pb_span();
    let kind: u8 = if is_arg { MIR_LOCAL_ARG } else { 0u8 };
    mir_add_local(mut_view(*mb), mut_view(*arena), TypeId { v: ty }, kind, true, StrId { v: 0u32 }, view(sp)).v
}

fn pb_add_bb(mb: mut_view<MirBody>, arena: mut_view<Arena>) -> u32 {
    mir_add_bb(mut_view(*mb), mut_view(*arena), false).v
}

fn pb_op_const(ty: u32, val: u64) -> MirOperand {
    mir_op_const_int(ty, val)
}

fn pb_op_copy(loc: u32) -> MirOperand {
    mir_op_copy_local(loc)
}

fn pb_place_index(arena: mut_view<Arena>, base: u32, idx_loc: u32) -> MirPlace {
    let parr = arena_alloc_raw(mut_view(*arena), size_of<MirProjection>(), align_of<MirProjection>()) as *mut MirProjection;
    let p0 = unsafe { mir_proj_at(parr, 0) };
    unsafe {
        mir_proj_reset(mut_view(*p0), MIR_PROJ_INDEX);
        (*p0).index_local = MirLocalId { v: idx_loc };
    }
    let mut pl = mir_local_place(base);
    pl.projs = parr;
    pl.proj_count = 1;
    pl
}

fn pb_blank_stmt(arena: mut_view<Arena>) -> MirStmt {
    let mut st: MirStmt = unsafe { *(arena_alloc_raw(mut_view(*arena), size_of<MirStmt>(), align_of<MirStmt>()) as *mut MirStmt) };
    mir_stmt_zero(mut_view(st), MIR_STMT_ASSIGN);
    st.span = pb_span();
    st.location = pb_span();
    st
}

fn pb_push_const(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, dst: u32, ty: u32, val: u64) {
    let mut st = pb_blank_stmt(mut_view(*arena));
    st.place = mir_local_place(dst);
    mir_rvalue_reset(mut_view(st.rvalue), MIR_RVALUE_USE);
    st.rvalue.use_op = pb_op_const(ty, val);
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    mir_bb_push_stmt(unsafe { mut_view(*bptr) }, mut_view(*arena), view(st));
}

fn pb_push_copy(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, dst: u32, src: u32) {
    let mut st = pb_blank_stmt(mut_view(*arena));
    st.place = mir_local_place(dst);
    mir_rvalue_reset(mut_view(st.rvalue), MIR_RVALUE_USE);
    st.rvalue.use_op = pb_op_copy(src);
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    mir_bb_push_stmt(unsafe { mut_view(*bptr) }, mut_view(*arena), view(st));
}

fn pb_push_binop(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, dst: u32, op: u8, lhs: MirOperand, rhs: MirOperand) {
    let mut st = pb_blank_stmt(mut_view(*arena));
    st.place = mir_local_place(dst);
    mir_rvalue_reset(mut_view(st.rvalue), MIR_RVALUE_BINARY_OP);
    st.rvalue.bin_op = op;
    st.rvalue.lhs = lhs;
    st.rvalue.rhs = rhs;
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    mir_bb_push_stmt(unsafe { mut_view(*bptr) }, mut_view(*arena), view(st));
}

fn pb_push_load_idx(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, dst: u32, base: u32, idx_loc: u32) {
    let mut st = pb_blank_stmt(mut_view(*arena));
    st.place = mir_local_place(dst);
    mir_rvalue_reset(mut_view(st.rvalue), MIR_RVALUE_USE);
    st.rvalue.use_op.kind = MIR_OP_COPY;
    st.rvalue.use_op.place = pb_place_index(mut_view(*arena), base, idx_loc);
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    mir_bb_push_stmt(unsafe { mut_view(*bptr) }, mut_view(*arena), view(st));
}

fn pb_push_store_idx(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, base: u32, idx_loc: u32, src_op: MirOperand) {
    let mut st = pb_blank_stmt(mut_view(*arena));
    st.place = pb_place_index(mut_view(*arena), base, idx_loc);
    mir_rvalue_reset(mut_view(st.rvalue), MIR_RVALUE_USE);
    st.rvalue.use_op = src_op;
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    mir_bb_push_stmt(unsafe { mut_view(*bptr) }, mut_view(*arena), view(st));
}

fn pb_push_len(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, dst: u32, container: u32) {
    let mut st = pb_blank_stmt(mut_view(*arena));
    st.place = mir_local_place(dst);
    mir_rvalue_reset(mut_view(st.rvalue), MIR_RVALUE_LEN);
    st.rvalue.place = mir_local_place(container);
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    mir_bb_push_stmt(unsafe { mut_view(*bptr) }, mut_view(*arena), view(st));
}

fn pb_set_goto(mb: mut_view<MirBody>, bb: u32, target: u32) {
    let sp = pb_span();
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    unsafe {
        mir_term_reset(mut_view((*bptr).terminator), MIR_TERM_GOTO, view(sp));
        (*bptr).terminator.goto_target = MirBbId { v: target };
        (*bptr).has_terminator = true;
    }
}

fn pb_set_return(mb: mut_view<MirBody>, bb: u32) {
    let sp = pb_span();
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    unsafe {
        mir_term_reset(mut_view((*bptr).terminator), MIR_TERM_RETURN, view(sp));
        (*bptr).has_terminator = true;
    }
}

fn pb_set_branch(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, cond_loc: u32, true_bb: u32, false_bb: u32) {
    let sp = pb_span();
    let svals = arena_alloc_raw(mut_view(*arena), size_of<u64>(), align_of<u64>()) as *mut u64;
    let stgts = arena_alloc_raw(mut_view(*arena), size_of<MirBbId>(), align_of<MirBbId>()) as *mut MirBbId;
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    unsafe {
        *svals = 0u64;
        *stgts = MirBbId { v: false_bb };
        mir_term_reset(mut_view((*bptr).terminator), MIR_TERM_SWITCH_INT, view(sp));
        (*bptr).terminator.discr = pb_op_copy(cond_loc);
        (*bptr).terminator.values = svals;
        (*bptr).terminator.targets = stgts;
        (*bptr).terminator.switch_count = 1;
        (*bptr).terminator.otherwise = MirBbId { v: true_bb };
        (*bptr).has_terminator = true;
    }
}

fn pb_set_assert(mb: mut_view<MirBody>, arena: mut_view<Arena>, bb: u32, cond_loc: u32, expected: bool, ok_bb: u32) {
    let sp = pb_span();
    let unw_bb = mir_add_bb(mut_view(*mb), mut_view(*arena), true);
    let uptr = unsafe { mir_bb_at(mb.bbs, unw_bb.v as usize) };
    unsafe {
        mir_term_reset(mut_view((*uptr).terminator), MIR_TERM_UNREACHABLE, view(sp));
        (*uptr).has_terminator = true;
    }
    let bptr = unsafe { mir_bb_at(mb.bbs, bb as usize) };
    unsafe {
        mir_term_reset(mut_view((*bptr).terminator), MIR_TERM_ASSERT, view(sp));
        (*bptr).terminator.cond = pb_op_copy(cond_loc);
        (*bptr).terminator.expected = expected;
        (*bptr).terminator.assert_target = MirBbId { v: ok_bb };
        (*bptr).terminator.assert_unwind = unw_bb;
        (*bptr).has_terminator = true;
    }
}

fn pb_prepare_opt_body(
    mb: view<MirBody>,
    pt: view<ProbeTypes>,
    profile: u8,
    arena: mut_view<Arena>,
    sink: mut_view<DiagSink>,
    out_pm: mut_view<*mut PassManager>,
    out_alias: mut_view<*const AliasInfo>
) -> *mut OptBody {
    let dummy_fn = arena_alloc_raw(mut_view(*arena), size_of<HirItem>(), align_of<HirItem>()) as *mut HirItem;
    let db = dummy_fn as *mut u8;
    let mut z: usize = 0;
    while z < size_of<HirItem>() {
        unsafe { *opt_u8_at(db, z) = 0u8; }
        z = z + 1;
    }
    let obody = optir_build_from_mir(mb, pt.thir as *const Thir, mut_view(*arena), mut_view(*sink), dummy_fn as *const HirItem);
    let pm_ptr = arena_alloc_raw(mut_view(*arena), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
    let budget = opt_budget_for_profile(profile, true);
    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget, mut_view(*arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*obody) }, mut_view(*arena));

    let alias_ptr = alias_build_info(unsafe { view(*obody) }, 0 as *const EffectCallTable, mut_view(*arena)) as *const AliasInfo;
    let mut simp_stats = LoopSimplifyStats {
        pass_runs: 0u32,
        pass_changes: 0u32,
        pass_rollbacks: 0u32,
        loops_discovered: 0u32,
        irreducible_cycles: 0u32,
        preheaders_inserted: 0u32,
        latches_merged: 0u32,
        dedicated_exits_inserted: 0u32,
        lcssa_phis_inserted: 0u32,
    };
    loops_stats_zero(mut_view(simp_stats));
    let _ = opt_loop_simplify(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*obody) },
        0 as *const EffectCallTable,
        alias_ptr,
        mut_view(simp_stats),
        mut_view(*arena),
        mut_view(*sink)
    );
    *out_pm = pm_ptr;
    *out_alias = alias_build_info(unsafe { view(*obody) }, 0 as *const EffectCallTable, mut_view(*arena)) as *const AliasInfo;
    obody
}

fn pb_zero_stats() -> LoopXformStats {
    let mut stats = LoopXformStats {
        pass_runs: 0u32, pass_changes: 0u32, pass_rollbacks: 0u32,
        licm_hoisted_scalars: 0u32, licm_hoisted_loads: 0u32, licm_hoisted_guards: 0u32,
        licm_blocked_traps: 0u32, licm_blocked_clobbers: 0u32, licm_blocked_barriers: 0u32,
        iv_strength_reduced: 0u32, iv_addr_evolutions: 0u32, iv_blocked_overflow: 0u32,
        loops_peeled: 0u32, loops_unswitched: 0u32, loops_unrolled_full: 0u32,
        loops_unrolled_partial: 0u32, loops_versioned: 0u32, loops_fused: 0u32,
        iter_buffers_forwarded: 0u32, fusion_blocked_dep: 0u32, fusion_blocked_barriers: 0u32,
        bce_eliminated_after_xform: 0u32, records: 0 as *mut LoopXformRecord,
        record_count: 0, record_cap: 0,
    };
    loop_xform_stats_zero(mut_view(stats));
    stats
}

fn test_case1a_licm_pos_and_guards(pt: view<ProbeTypes>, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> bool {
    let mb = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 3);
    let arg_a = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, true);
    let arg_b = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, true);
    let arg_arr = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_arr8_i32, true);
    let loc_i = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, false);
    let loc_acc = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);
    let loc_cnd = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_bool, false);
    let loc_inv1 = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);
    let loc_inv2 = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);
    let loc_len = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, false);
    let loc_g = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_bool, false);

    let bb0 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb1 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb2 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb3 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb4 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, loc_i, pt.ty_usize, 0u64);
    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, loc_acc, pt.ty_i32, 0u64);
    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, loc_g, MIR_BINOP_EQ, pb_op_copy(arg_a), pb_op_copy(arg_b));
    pb_set_goto(unsafe { mut_view(*mb) }, bb0, bb1);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb1, loc_cnd, MIR_BINOP_LT, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 4u64));
    pb_set_branch(unsafe { mut_view(*mb) }, mut_view(*arena), bb1, loc_cnd, bb2, bb4);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_inv1, MIR_BINOP_WRAPPING_ADD, pb_op_copy(arg_a), pb_op_copy(arg_b));
    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_inv2, MIR_BINOP_WRAPPING_MUL, pb_op_copy(loc_inv1), pb_op_const(pt.ty_i32, 3u64));
    pb_push_len(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_len, arg_arr);
    pb_set_assert(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_g, true, bb3);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb3, loc_acc, MIR_BINOP_WRAPPING_ADD, pb_op_copy(loc_acc), pb_op_copy(loc_inv2));
    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb3, loc_i, MIR_BINOP_ADD, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb) }, bb3, bb1);

    pb_push_copy(unsafe { mut_view(*mb) }, mut_view(*arena), bb4, 0u32, loc_acc);
    pb_set_return(unsafe { mut_view(*mb) }, bb4);

    let mut pm_ptr = 0 as *mut PassManager;
    let mut alias_ptr = 0 as *const AliasInfo;
    let obody = pb_prepare_opt_body(unsafe { view(*mb) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(pm_ptr), mut_view(alias_ptr));

    let mut stats = pb_zero_stats();
    let changed = opt_licm(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*obody) },
        0 as *const EffectCallTable,
        alias_ptr,
        mut_view(stats),
        mut_view(*arena),
        mut_view(*sink)
    );
    changed && stats.pass_rollbacks == 0u32 &&
        stats.licm_hoisted_scalars >= 2u32 &&
        stats.licm_hoisted_loads >= 1u32 &&
        stats.licm_hoisted_guards >= 1u32
}

fn test_case1b_licm_neg_gates(pt: view<ProbeTypes>, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> bool {
    let mb = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 3);
    let arg_n = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, true);
    let arg_d = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, true);
    let arg_arr = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_arr8_i32, true);
    let loc_i = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, false);
    let loc_z = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, false);
    let loc_cnd = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_bool, false);
    let loc_div = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);
    let loc_clob = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);
    let loc_vol = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);
    let loc_g = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_bool, false);

    let bb0 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb1 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb2 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb3 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb4 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, loc_i, pt.ty_usize, 0u64);
    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, loc_z, pt.ty_usize, 0u64);
    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, loc_g, MIR_BINOP_EQ, pb_op_copy(arg_d), pb_op_const(pt.ty_i32, 1u64));
    pb_set_goto(unsafe { mut_view(*mb) }, bb0, bb1);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb1, loc_cnd, MIR_BINOP_LT, pb_op_copy(loc_i), pb_op_copy(arg_n));
    pb_set_branch(unsafe { mut_view(*mb) }, mut_view(*arena), bb1, loc_cnd, bb2, bb4);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_div, MIR_BINOP_DIV, pb_op_const(pt.ty_i32, 100u64), pb_op_copy(arg_d));
    pb_push_store_idx(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, arg_arr, loc_i, pb_op_const(pt.ty_i32, 9u64));
    pb_push_load_idx(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_clob, arg_arr, loc_z);
    pb_push_copy(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_vol, arg_d);
    pb_set_assert(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_g, true, bb3);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb3, loc_i, MIR_BINOP_ADD, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb) }, bb3, bb1);

    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb4, 0u32, pt.ty_i32, 0u64);
    pb_set_return(unsafe { mut_view(*mb) }, bb4);

    let mut pm_ptr = 0 as *mut PassManager;
    let mut alias_ptr = 0 as *const AliasInfo;
    let obody = pb_prepare_opt_body(unsafe { view(*mb) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(pm_ptr), mut_view(alias_ptr));

    let b2_opt = unsafe { opt_block_at((*obody).blocks, bb2 as usize) };
    let vol_inst = unsafe { opt_inst_at((*b2_opt).insts, 3) };
    unsafe {
        (*vol_inst).opcode = OPT_INST_VOLATILE_LOAD;
        (*vol_inst).flags = OPT_FLAG_BARRIER;
    }

    let mut stats = pb_zero_stats();
    let changed = opt_licm(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*obody) },
        0 as *const EffectCallTable,
        alias_ptr,
        mut_view(stats),
        mut_view(*arena),
        mut_view(*sink)
    );
    !changed &&
        stats.licm_hoisted_scalars == 0u32 &&
        stats.licm_hoisted_loads == 0u32 &&
        stats.licm_hoisted_guards == 0u32 &&
        stats.licm_blocked_traps >= 2u32 &&
        stats.licm_blocked_clobbers >= 1u32 &&
        stats.licm_blocked_barriers >= 1u32
}

fn test_case2_iv_sr_and_overflow_gate(pt: view<ProbeTypes>, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> bool {
    let mb = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 1);
    let arg_arr = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_arr8_i32, true);
    let loc_i = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, false);
    let loc_cnd = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_bool, false);
    let loc_mul_ok = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, false);
    let loc_mul_wrap = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, false);
    let loc_elem = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);

    let bb0 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb1 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb2 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb3 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, loc_i, pt.ty_usize, 0u64);
    pb_set_goto(unsafe { mut_view(*mb) }, bb0, bb1);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb1, loc_cnd, MIR_BINOP_LT, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 8u64));
    pb_set_branch(unsafe { mut_view(*mb) }, mut_view(*arena), bb1, loc_cnd, bb2, bb3);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_mul_ok, MIR_BINOP_MUL, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 4u64));
    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_mul_wrap, MIR_BINOP_WRAPPING_MUL, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 6u64));
    pb_push_load_idx(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_elem, arg_arr, loc_i);
    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_i, MIR_BINOP_ADD, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb) }, bb2, bb1);

    pb_push_copy(unsafe { mut_view(*mb) }, mut_view(*arena), bb3, 0u32, loc_elem);
    pb_set_return(unsafe { mut_view(*mb) }, bb3);

    let mut pm_ptr = 0 as *mut PassManager;
    let mut alias_ptr = 0 as *const AliasInfo;
    let obody = pb_prepare_opt_body(unsafe { view(*mb) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(pm_ptr), mut_view(alias_ptr));

    let mut stats = pb_zero_stats();
    let changed_pos = opt_iv_strength_reduce(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*obody) },
        0 as *const EffectCallTable,
        alias_ptr,
        mut_view(stats),
        mut_view(*arena),
        mut_view(*sink)
    );
    let sr_cnt = stats.iv_strength_reduced;
    let addr_cnt = stats.iv_addr_evolutions;
    if !changed_pos || sr_cnt < 2u32 || addr_cnt < 1u32 {
        return false;
    }

    let mb_neg = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 0);
    let ni = pb_add_local(unsafe { mut_view(*mb_neg) }, mut_view(*arena), pt.ty_i32, false);
    let ncnd = pb_add_local(unsafe { mut_view(*mb_neg) }, mut_view(*arena), pt.ty_bool, false);
    let nbad = pb_add_local(unsafe { mut_view(*mb_neg) }, mut_view(*arena), pt.ty_i32, false);
    let nbb0 = pb_add_bb(unsafe { mut_view(*mb_neg) }, mut_view(*arena));
    let nbb1 = pb_add_bb(unsafe { mut_view(*mb_neg) }, mut_view(*arena));
    let nbb2 = pb_add_bb(unsafe { mut_view(*mb_neg) }, mut_view(*arena));
    let nbb3 = pb_add_bb(unsafe { mut_view(*mb_neg) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb_neg) }, mut_view(*arena), nbb0, ni, pt.ty_i32, 0u64);
    pb_set_goto(unsafe { mut_view(*mb_neg) }, nbb0, nbb1);
    pb_push_binop(unsafe { mut_view(*mb_neg) }, mut_view(*arena), nbb1, ncnd, MIR_BINOP_LT, pb_op_copy(ni), pb_op_const(pt.ty_i32, 4u64));
    pb_set_branch(unsafe { mut_view(*mb_neg) }, mut_view(*arena), nbb1, ncnd, nbb2, nbb3);
    pb_push_binop(unsafe { mut_view(*mb_neg) }, mut_view(*arena), nbb2, nbad, MIR_BINOP_MUL, pb_op_copy(ni), pb_op_const(pt.ty_i32, 1000000000u64));
    pb_push_binop(unsafe { mut_view(*mb_neg) }, mut_view(*arena), nbb2, ni, MIR_BINOP_ADD, pb_op_copy(ni), pb_op_const(pt.ty_i32, 1u64));
    pb_set_goto(unsafe { mut_view(*mb_neg) }, nbb2, nbb1);
    pb_push_copy(unsafe { mut_view(*mb_neg) }, mut_view(*arena), nbb3, 0u32, nbad);
    pb_set_return(unsafe { mut_view(*mb_neg) }, nbb3);

    let mut npm = 0 as *mut PassManager;
    let mut nalias = 0 as *const AliasInfo;
    let nob = pb_prepare_opt_body(unsafe { view(*mb_neg) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(npm), mut_view(nalias));
    let mut nstats = pb_zero_stats();
    let changed_neg = opt_iv_strength_reduce(
        unsafe { mut_view(*npm) },
        unsafe { mut_view(*nob) },
        0 as *const EffectCallTable,
        nalias,
        mut_view(nstats),
        mut_view(*arena),
        mut_view(*sink)
    );
    !changed_neg && nstats.iv_strength_reduced == 0u32 && nstats.iv_blocked_overflow >= 1u32
}

fn test_case3_loop_peel(pt: view<ProbeTypes>, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> bool {
    let mb = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 1);
    let arg_arr = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_arr8_i32, true);
    let loc_i = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, false);
    let loc_cnd = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_bool, false);
    let loc_is0 = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_bool, false);
    let loc_im1 = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, false);
    let loc_acc = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);

    let bb0 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb1 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb2 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb3 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb4 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb5 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb6 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, loc_i, pt.ty_usize, 0u64);
    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, loc_acc, pt.ty_i32, 0u64);
    pb_set_goto(unsafe { mut_view(*mb) }, bb0, bb1);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb1, loc_cnd, MIR_BINOP_LT, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 6u64));
    pb_set_branch(unsafe { mut_view(*mb) }, mut_view(*arena), bb1, loc_cnd, bb2, bb6);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_is0, MIR_BINOP_EQ, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 0u64));
    pb_set_branch(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_is0, bb3, bb4);

    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb3, loc_acc, pt.ty_i32, 10u64);
    pb_set_goto(unsafe { mut_view(*mb) }, bb3, bb5);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb4, loc_im1, MIR_BINOP_SUB, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 1u64));
    pb_push_load_idx(unsafe { mut_view(*mb) }, mut_view(*arena), bb4, loc_acc, arg_arr, loc_im1);
    pb_set_goto(unsafe { mut_view(*mb) }, bb4, bb5);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb5, loc_i, MIR_BINOP_ADD, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb) }, bb5, bb1);

    pb_push_copy(unsafe { mut_view(*mb) }, mut_view(*arena), bb6, 0u32, loc_acc);
    pb_set_return(unsafe { mut_view(*mb) }, bb6);

    let mut pm_ptr = 0 as *mut PassManager;
    let mut alias_ptr = 0 as *const AliasInfo;
    let obody = pb_prepare_opt_body(unsafe { view(*mb) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(pm_ptr), mut_view(alias_ptr));

    let mut stats = pb_zero_stats();
    let changed = opt_loop_peel(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*obody) },
        0 as *const EffectCallTable,
        alias_ptr,
        mut_view(stats),
        mut_view(*arena),
        mut_view(*sink)
    );
    changed && stats.pass_rollbacks == 0u32 && stats.loops_peeled == 1u32
}

fn test_case4_loop_unswitch(pt: view<ProbeTypes>, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> bool {
    let mb = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 1);
    let arg_flag = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_bool, true);
    let loc_i = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, false);
    let loc_cnd = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_bool, false);
    let loc_acc = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);

    let bb0 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb1 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb2 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb3 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb4 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb5 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb6 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, loc_i, pt.ty_usize, 0u64);
    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, loc_acc, pt.ty_i32, 0u64);
    pb_set_goto(unsafe { mut_view(*mb) }, bb0, bb1);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb1, loc_cnd, MIR_BINOP_LT, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 8u64));
    pb_set_branch(unsafe { mut_view(*mb) }, mut_view(*arena), bb1, loc_cnd, bb2, bb6);

    pb_set_branch(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, arg_flag, bb3, bb4);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb3, loc_acc, MIR_BINOP_WRAPPING_ADD, pb_op_copy(loc_acc), pb_op_const(pt.ty_i32, 5u64));
    pb_set_goto(unsafe { mut_view(*mb) }, bb3, bb5);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb4, loc_acc, MIR_BINOP_WRAPPING_ADD, pb_op_copy(loc_acc), pb_op_const(pt.ty_i32, 2u64));
    pb_set_goto(unsafe { mut_view(*mb) }, bb4, bb5);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb5, loc_i, MIR_BINOP_ADD, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb) }, bb5, bb1);

    pb_push_copy(unsafe { mut_view(*mb) }, mut_view(*arena), bb6, 0u32, loc_acc);
    pb_set_return(unsafe { mut_view(*mb) }, bb6);

    let mut pm_ptr = 0 as *mut PassManager;
    let mut alias_ptr = 0 as *const AliasInfo;
    let obody = pb_prepare_opt_body(unsafe { view(*mb) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(pm_ptr), mut_view(alias_ptr));

    let mut stats = pb_zero_stats();
    let changed = opt_loop_unswitch(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*obody) },
        0 as *const EffectCallTable,
        alias_ptr,
        mut_view(stats),
        mut_view(*arena),
        mut_view(*sink)
    );
    let post_tree = loops_discover(unsafe { view(*obody) }, 0 as *const EffectCallTable, alias_ptr, mut_view(*arena));
    changed && stats.pass_rollbacks == 0u32 && stats.loops_unswitched == 1u32 &&
        (unsafe { (*post_tree).loop_count }) == 2
}

fn test_case5_loop_unroll(pt: view<ProbeTypes>, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> bool {
    let mb_full = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 0);
    let fi = pb_add_local(unsafe { mut_view(*mb_full) }, mut_view(*arena), pt.ty_usize, false);
    let fcnd = pb_add_local(unsafe { mut_view(*mb_full) }, mut_view(*arena), pt.ty_bool, false);
    let facc = pb_add_local(unsafe { mut_view(*mb_full) }, mut_view(*arena), pt.ty_i32, false);
    let fbb0 = pb_add_bb(unsafe { mut_view(*mb_full) }, mut_view(*arena));
    let fbb1 = pb_add_bb(unsafe { mut_view(*mb_full) }, mut_view(*arena));
    let fbb2 = pb_add_bb(unsafe { mut_view(*mb_full) }, mut_view(*arena));
    let fbb3 = pb_add_bb(unsafe { mut_view(*mb_full) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb_full) }, mut_view(*arena), fbb0, fi, pt.ty_usize, 0u64);
    pb_push_const(unsafe { mut_view(*mb_full) }, mut_view(*arena), fbb0, facc, pt.ty_i32, 0u64);
    pb_set_goto(unsafe { mut_view(*mb_full) }, fbb0, fbb1);
    pb_push_binop(unsafe { mut_view(*mb_full) }, mut_view(*arena), fbb1, fcnd, MIR_BINOP_LT, pb_op_copy(fi), pb_op_const(pt.ty_usize, 4u64));
    pb_set_branch(unsafe { mut_view(*mb_full) }, mut_view(*arena), fbb1, fcnd, fbb2, fbb3);
    pb_push_binop(unsafe { mut_view(*mb_full) }, mut_view(*arena), fbb2, facc, MIR_BINOP_WRAPPING_ADD, pb_op_copy(facc), pb_op_const(pt.ty_i32, 7u64));
    pb_push_binop(unsafe { mut_view(*mb_full) }, mut_view(*arena), fbb2, fi, MIR_BINOP_ADD, pb_op_copy(fi), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb_full) }, fbb2, fbb1);
    pb_push_copy(unsafe { mut_view(*mb_full) }, mut_view(*arena), fbb3, 0u32, facc);
    pb_set_return(unsafe { mut_view(*mb_full) }, fbb3);

    let mut fpm = 0 as *mut PassManager;
    let mut falias = 0 as *const AliasInfo;
    let fob = pb_prepare_opt_body(unsafe { view(*mb_full) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(fpm), mut_view(falias));
    let mut fstats = pb_zero_stats();
    let c_full = opt_loop_unroll(
        unsafe { mut_view(*fpm) },
        unsafe { mut_view(*fob) },
        0 as *const EffectCallTable,
        falias,
        mut_view(fstats),
        mut_view(*arena),
        mut_view(*sink)
    );
    let ftree_after = loops_discover(unsafe { view(*fob) }, 0 as *const EffectCallTable, falias, mut_view(*arena));
    if !c_full || fstats.loops_unrolled_full != 1u32 || (unsafe { (*ftree_after).loop_count }) != 0 {
        return false;
    }

    let mb_part = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 0);
    let pi = pb_add_local(unsafe { mut_view(*mb_part) }, mut_view(*arena), pt.ty_usize, false);
    let pcnd = pb_add_local(unsafe { mut_view(*mb_part) }, mut_view(*arena), pt.ty_bool, false);
    let pacc = pb_add_local(unsafe { mut_view(*mb_part) }, mut_view(*arena), pt.ty_i32, false);
    let pbb0 = pb_add_bb(unsafe { mut_view(*mb_part) }, mut_view(*arena));
    let pbb1 = pb_add_bb(unsafe { mut_view(*mb_part) }, mut_view(*arena));
    let pbb2 = pb_add_bb(unsafe { mut_view(*mb_part) }, mut_view(*arena));
    let pbb3 = pb_add_bb(unsafe { mut_view(*mb_part) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb_part) }, mut_view(*arena), pbb0, pi, pt.ty_usize, 0u64);
    pb_push_const(unsafe { mut_view(*mb_part) }, mut_view(*arena), pbb0, pacc, pt.ty_i32, 0u64);
    pb_set_goto(unsafe { mut_view(*mb_part) }, pbb0, pbb1);
    pb_push_binop(unsafe { mut_view(*mb_part) }, mut_view(*arena), pbb1, pcnd, MIR_BINOP_LT, pb_op_copy(pi), pb_op_const(pt.ty_usize, 32u64));
    pb_set_branch(unsafe { mut_view(*mb_part) }, mut_view(*arena), pbb1, pcnd, pbb2, pbb3);
    pb_push_binop(unsafe { mut_view(*mb_part) }, mut_view(*arena), pbb2, pacc, MIR_BINOP_WRAPPING_ADD, pb_op_copy(pacc), pb_op_const(pt.ty_i32, 3u64));
    pb_push_binop(unsafe { mut_view(*mb_part) }, mut_view(*arena), pbb2, pi, MIR_BINOP_ADD, pb_op_copy(pi), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb_part) }, pbb2, pbb1);
    pb_push_copy(unsafe { mut_view(*mb_part) }, mut_view(*arena), pbb3, 0u32, pacc);
    pb_set_return(unsafe { mut_view(*mb_part) }, pbb3);

    let mut ppm = 0 as *mut PassManager;
    let mut palias = 0 as *const AliasInfo;
    let pob = pb_prepare_opt_body(unsafe { view(*mb_part) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(ppm), mut_view(palias));
    let mut pstats = pb_zero_stats();
    let c_part = opt_loop_unroll(
        unsafe { mut_view(*ppm) },
        unsafe { mut_view(*pob) },
        0 as *const EffectCallTable,
        palias,
        mut_view(pstats),
        mut_view(*arena),
        mut_view(*sink)
    );
    c_part && pstats.loops_unrolled_partial == 1u32
}

fn test_case6_loop_version(pt: view<ProbeTypes>, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> bool {
    let mb = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 2);
    let arg_arr = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_arr8_i32, true);
    let arg_n = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, true);
    let loc_i = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, false);
    let loc_cnd = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_bool, false);
    let loc_len = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, false);
    let loc_inb = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_bool, false);
    let loc_elem = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);
    let loc_acc = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);

    let bb0 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb1 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb2 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb3 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb4 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, loc_i, pt.ty_usize, 0u64);
    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, loc_acc, pt.ty_i32, 0u64);
    pb_set_goto(unsafe { mut_view(*mb) }, bb0, bb1);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb1, loc_cnd, MIR_BINOP_LT, pb_op_copy(loc_i), pb_op_copy(arg_n));
    pb_set_branch(unsafe { mut_view(*mb) }, mut_view(*arena), bb1, loc_cnd, bb2, bb4);

    pb_push_len(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_len, arg_arr);
    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_inb, MIR_BINOP_LT, pb_op_copy(loc_i), pb_op_copy(loc_len));
    pb_set_assert(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_inb, true, bb3);

    pb_push_load_idx(unsafe { mut_view(*mb) }, mut_view(*arena), bb3, loc_elem, arg_arr, loc_i);
    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb3, loc_acc, MIR_BINOP_WRAPPING_ADD, pb_op_copy(loc_acc), pb_op_copy(loc_elem));
    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb3, loc_i, MIR_BINOP_ADD, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb) }, bb3, bb1);

    pb_push_copy(unsafe { mut_view(*mb) }, mut_view(*arena), bb4, 0u32, loc_acc);
    pb_set_return(unsafe { mut_view(*mb) }, bb4);

    let mut pm_ptr = 0 as *mut PassManager;
    let mut alias_ptr = 0 as *const AliasInfo;
    let obody = pb_prepare_opt_body(unsafe { view(*mb) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(pm_ptr), mut_view(alias_ptr));

    let mut stats = pb_zero_stats();
    let changed = opt_loop_version(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*obody) },
        0 as *const EffectCallTable,
        alias_ptr,
        mut_view(stats),
        mut_view(*arena),
        mut_view(*sink)
    );
    let post_tree = loops_discover(unsafe { view(*obody) }, 0 as *const EffectCallTable, 0 as *const AliasInfo, mut_view(*arena));
    changed && stats.pass_rollbacks == 0u32 &&
        stats.loops_versioned == 1u32 &&
        stats.bce_eliminated_after_xform == 1u32 &&
        (unsafe { (*post_tree).loop_count }) == 2
}

fn test_case7_loop_fuse_and_iter_forward(pt: view<ProbeTypes>, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> bool {
    let mb = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 1);
    let arg_src = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_arr8_i32, true);
    let loc_tmp = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_arr8_i32, false);
    let loc_i = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, false);
    let loc_j = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_usize, false);
    let loc_c1 = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_bool, false);
    let loc_c2 = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_bool, false);
    let loc_v = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);
    let loc_x = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);
    let loc_acc = pb_add_local(unsafe { mut_view(*mb) }, mut_view(*arena), pt.ty_i32, false);

    let bb0 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb1 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb2 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb3 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb4 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb5 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));
    let bb6 = pb_add_bb(unsafe { mut_view(*mb) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, loc_i, pt.ty_usize, 0u64);
    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb0, loc_acc, pt.ty_i32, 0u64);
    pb_set_goto(unsafe { mut_view(*mb) }, bb0, bb1);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb1, loc_c1, MIR_BINOP_LT, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 8u64));
    pb_set_branch(unsafe { mut_view(*mb) }, mut_view(*arena), bb1, loc_c1, bb2, bb3);
    pb_push_load_idx(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_v, arg_src, loc_i);
    pb_push_store_idx(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_tmp, loc_i, pb_op_copy(loc_v));
    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb2, loc_i, MIR_BINOP_ADD, pb_op_copy(loc_i), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb) }, bb2, bb1);

    pb_push_const(unsafe { mut_view(*mb) }, mut_view(*arena), bb3, loc_j, pt.ty_usize, 0u64);
    pb_set_goto(unsafe { mut_view(*mb) }, bb3, bb4);

    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb4, loc_c2, MIR_BINOP_LT, pb_op_copy(loc_j), pb_op_const(pt.ty_usize, 8u64));
    pb_set_branch(unsafe { mut_view(*mb) }, mut_view(*arena), bb4, loc_c2, bb5, bb6);
    pb_push_load_idx(unsafe { mut_view(*mb) }, mut_view(*arena), bb5, loc_x, loc_tmp, loc_j);
    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb5, loc_acc, MIR_BINOP_WRAPPING_ADD, pb_op_copy(loc_acc), pb_op_copy(loc_x));
    pb_push_binop(unsafe { mut_view(*mb) }, mut_view(*arena), bb5, loc_j, MIR_BINOP_ADD, pb_op_copy(loc_j), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb) }, bb5, bb4);

    pb_push_copy(unsafe { mut_view(*mb) }, mut_view(*arena), bb6, 0u32, loc_acc);
    pb_set_return(unsafe { mut_view(*mb) }, bb6);

    let mut pm_ptr = 0 as *mut PassManager;
    let mut alias_ptr = 0 as *const AliasInfo;
    let obody = pb_prepare_opt_body(unsafe { view(*mb) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(pm_ptr), mut_view(alias_ptr));

    let mut stats = pb_zero_stats();
    let c_fuse = opt_loop_fuse(
        unsafe { mut_view(*pm_ptr) },
        unsafe { mut_view(*obody) },
        0 as *const EffectCallTable,
        alias_ptr,
        mut_view(stats),
        mut_view(*arena),
        mut_view(*sink)
    );
    let post_tree = loops_discover(unsafe { view(*obody) }, 0 as *const EffectCallTable, 0 as *const AliasInfo, mut_view(*arena));
    if !c_fuse || stats.loops_fused != 1u32 || stats.iter_buffers_forwarded != 1u32 ||
       (unsafe { (*post_tree).loop_count }) != 1 {
        return false;
    }

    let mb_neg = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 1);
    let n_arr = pb_add_local(unsafe { mut_view(*mb_neg) }, mut_view(*arena), pt.ty_arr8_i32, true);
    let ni = pb_add_local(unsafe { mut_view(*mb_neg) }, mut_view(*arena), pt.ty_usize, false);
    let nj = pb_add_local(unsafe { mut_view(*mb_neg) }, mut_view(*arena), pt.ty_usize, false);
    let njp1 = pb_add_local(unsafe { mut_view(*mb_neg) }, mut_view(*arena), pt.ty_usize, false);
    let nc1 = pb_add_local(unsafe { mut_view(*mb_neg) }, mut_view(*arena), pt.ty_bool, false);
    let nc2 = pb_add_local(unsafe { mut_view(*mb_neg) }, mut_view(*arena), pt.ty_bool, false);
    let nx = pb_add_local(unsafe { mut_view(*mb_neg) }, mut_view(*arena), pt.ty_i32, false);

    let n0 = pb_add_bb(unsafe { mut_view(*mb_neg) }, mut_view(*arena));
    let n1 = pb_add_bb(unsafe { mut_view(*mb_neg) }, mut_view(*arena));
    let n2 = pb_add_bb(unsafe { mut_view(*mb_neg) }, mut_view(*arena));
    let n3 = pb_add_bb(unsafe { mut_view(*mb_neg) }, mut_view(*arena));
    let n4 = pb_add_bb(unsafe { mut_view(*mb_neg) }, mut_view(*arena));
    let n5 = pb_add_bb(unsafe { mut_view(*mb_neg) }, mut_view(*arena));
    let n6 = pb_add_bb(unsafe { mut_view(*mb_neg) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb_neg) }, mut_view(*arena), n0, ni, pt.ty_usize, 0u64);
    pb_set_goto(unsafe { mut_view(*mb_neg) }, n0, n1);
    pb_push_binop(unsafe { mut_view(*mb_neg) }, mut_view(*arena), n1, nc1, MIR_BINOP_LT, pb_op_copy(ni), pb_op_const(pt.ty_usize, 6u64));
    pb_set_branch(unsafe { mut_view(*mb_neg) }, mut_view(*arena), n1, nc1, n2, n3);
    pb_push_store_idx(unsafe { mut_view(*mb_neg) }, mut_view(*arena), n2, n_arr, ni, pb_op_const(pt.ty_i32, 42u64));
    pb_push_binop(unsafe { mut_view(*mb_neg) }, mut_view(*arena), n2, ni, MIR_BINOP_ADD, pb_op_copy(ni), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb_neg) }, n2, n1);

    pb_push_const(unsafe { mut_view(*mb_neg) }, mut_view(*arena), n3, nj, pt.ty_usize, 0u64);
    pb_set_goto(unsafe { mut_view(*mb_neg) }, n3, n4);
    pb_push_binop(unsafe { mut_view(*mb_neg) }, mut_view(*arena), n4, nc2, MIR_BINOP_LT, pb_op_copy(nj), pb_op_const(pt.ty_usize, 6u64));
    pb_set_branch(unsafe { mut_view(*mb_neg) }, mut_view(*arena), n4, nc2, n5, n6);
    pb_push_binop(unsafe { mut_view(*mb_neg) }, mut_view(*arena), n5, njp1, MIR_BINOP_ADD, pb_op_copy(nj), pb_op_const(pt.ty_usize, 1u64));
    pb_push_load_idx(unsafe { mut_view(*mb_neg) }, mut_view(*arena), n5, nx, n_arr, njp1);
    pb_push_binop(unsafe { mut_view(*mb_neg) }, mut_view(*arena), n5, nj, MIR_BINOP_ADD, pb_op_copy(nj), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb_neg) }, n5, n4);
    pb_push_copy(unsafe { mut_view(*mb_neg) }, mut_view(*arena), n6, 0u32, nx);
    pb_set_return(unsafe { mut_view(*mb_neg) }, n6);

    let mut npm = 0 as *mut PassManager;
    let mut nalias = 0 as *const AliasInfo;
    let nob = pb_prepare_opt_body(unsafe { view(*mb_neg) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(npm), mut_view(nalias));
    let mut nstats = pb_zero_stats();
    let c_neg = opt_loop_fuse(
        unsafe { mut_view(*npm) },
        unsafe { mut_view(*nob) },
        0 as *const EffectCallTable,
        nalias,
        mut_view(nstats),
        mut_view(*arena),
        mut_view(*sink)
    );
    !c_neg && nstats.loops_fused == 0u32 && nstats.fusion_blocked_dep == 1u32
}

fn test_case8_reduction_legality_and_print(pt: view<ProbeTypes>, arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> bool {
    let c_licm = licm_contract();
    let c_sr = iv_strength_reduce_contract();
    let c_unsw = loop_unswitch_contract();
    let c_pu = loop_peel_unroll_contract();
    let c_ver = loop_version_contract();
    let c_fuse = loop_fuse_contract();
    if c_licm.pass_id != PASS_LICM || c_sr.pass_id != PASS_IV_STRENGTH_REDUCE ||
       c_unsw.pass_id != PASS_LOOP_UNSWITCH || c_pu.pass_id != PASS_LOOP_PEEL_UNROLL ||
       c_ver.pass_id != PASS_LOOP_VERSION || c_fuse.pass_id != PASS_LOOP_FUSE {
        return false;
    }

    let b_o0 = loop_cost_budget_for_profile(OPT_PROFILE_DEBUG_O0);
    let b_os = loop_cost_budget_for_profile(OPT_PROFILE_SIZE_OS);
    let b_o1 = loop_cost_budget_for_profile(OPT_PROFILE_BALANCED_O1);
    let b_o2 = loop_cost_budget_for_profile(OPT_PROFILE_SPEED_O2);
    if b_o0.allow_licm || !b_os.allow_licm || b_os.allow_full_unroll ||
       !b_o1.allow_full_unroll || b_o1.allow_partial_unroll || !b_o2.allow_partial_unroll || !b_o2.allow_versioning {
        return false;
    }

    let mb_int = pb_new_mir_body(mut_view(*arena), pt.ty_i32, 0);
    let ii = pb_add_local(unsafe { mut_view(*mb_int) }, mut_view(*arena), pt.ty_usize, false);
    let icnd = pb_add_local(unsafe { mut_view(*mb_int) }, mut_view(*arena), pt.ty_bool, false);
    let iacc = pb_add_local(unsafe { mut_view(*mb_int) }, mut_view(*arena), pt.ty_i32, false);
    let ib0 = pb_add_bb(unsafe { mut_view(*mb_int) }, mut_view(*arena));
    let ib1 = pb_add_bb(unsafe { mut_view(*mb_int) }, mut_view(*arena));
    let ib2 = pb_add_bb(unsafe { mut_view(*mb_int) }, mut_view(*arena));
    let ib3 = pb_add_bb(unsafe { mut_view(*mb_int) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb_int) }, mut_view(*arena), ib0, ii, pt.ty_usize, 0u64);
    pb_push_const(unsafe { mut_view(*mb_int) }, mut_view(*arena), ib0, iacc, pt.ty_i32, 0u64);
    pb_set_goto(unsafe { mut_view(*mb_int) }, ib0, ib1);
    pb_push_binop(unsafe { mut_view(*mb_int) }, mut_view(*arena), ib1, icnd, MIR_BINOP_LT, pb_op_copy(ii), pb_op_const(pt.ty_usize, 8u64));
    pb_set_branch(unsafe { mut_view(*mb_int) }, mut_view(*arena), ib1, icnd, ib2, ib3);
    pb_push_binop(unsafe { mut_view(*mb_int) }, mut_view(*arena), ib2, iacc, MIR_BINOP_WRAPPING_ADD, pb_op_copy(iacc), pb_op_const(pt.ty_i32, 3u64));
    pb_push_binop(unsafe { mut_view(*mb_int) }, mut_view(*arena), ib2, ii, MIR_BINOP_ADD, pb_op_copy(ii), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb_int) }, ib2, ib1);
    pb_push_copy(unsafe { mut_view(*mb_int) }, mut_view(*arena), ib3, 0u32, iacc);
    pb_set_return(unsafe { mut_view(*mb_int) }, ib3);

    let mut ipm = 0 as *mut PassManager;
    let mut ialias = 0 as *const AliasInfo;
    let iob = pb_prepare_opt_body(unsafe { view(*mb_int) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(ipm), mut_view(ialias));
    let itree = loops_discover(unsafe { view(*iob) }, 0 as *const EffectCallTable, ialias, mut_view(*arena));
    scev_analyze_tree(unsafe { mut_view(*itree) }, unsafe { view(*iob) }, ialias, mut_view(*arena));
    let ilp = unsafe { loop_desc_at((*itree).loops, 0) };
    let ired = loop_xform_recognize_reduction(unsafe { view(*ilp) }, unsafe { view(*iob) }, ialias);
    if !ired.valid || !ired.reassoc_legal || ired.is_float {
        return false;
    }
    if !loop_xform_can_distribute(unsafe { view(*itree) }, unsafe { view(*ilp) }, unsafe { view(*iob) }, ialias, mut_view(*arena)) ||
       !loop_xform_can_vectorize_or_parallelize(unsafe { view(*itree) }, unsafe { view(*ilp) }, unsafe { view(*iob) }, ialias, mut_view(*arena)) {
        return false;
    }

    let mb_flt = pb_new_mir_body(mut_view(*arena), pt.ty_f64, 1);
    let fstep = pb_add_local(unsafe { mut_view(*mb_flt) }, mut_view(*arena), pt.ty_f64, true);
    let fi = pb_add_local(unsafe { mut_view(*mb_flt) }, mut_view(*arena), pt.ty_usize, false);
    let fcnd = pb_add_local(unsafe { mut_view(*mb_flt) }, mut_view(*arena), pt.ty_bool, false);
    let facc = pb_add_local(unsafe { mut_view(*mb_flt) }, mut_view(*arena), pt.ty_f64, false);
    let fb0 = pb_add_bb(unsafe { mut_view(*mb_flt) }, mut_view(*arena));
    let fb1 = pb_add_bb(unsafe { mut_view(*mb_flt) }, mut_view(*arena));
    let fb2 = pb_add_bb(unsafe { mut_view(*mb_flt) }, mut_view(*arena));
    let fb3 = pb_add_bb(unsafe { mut_view(*mb_flt) }, mut_view(*arena));

    pb_push_const(unsafe { mut_view(*mb_flt) }, mut_view(*arena), fb0, fi, pt.ty_usize, 0u64);
    pb_push_copy(unsafe { mut_view(*mb_flt) }, mut_view(*arena), fb0, facc, fstep);
    pb_set_goto(unsafe { mut_view(*mb_flt) }, fb0, fb1);
    pb_push_binop(unsafe { mut_view(*mb_flt) }, mut_view(*arena), fb1, fcnd, MIR_BINOP_LT, pb_op_copy(fi), pb_op_const(pt.ty_usize, 8u64));
    pb_set_branch(unsafe { mut_view(*mb_flt) }, mut_view(*arena), fb1, fcnd, fb2, fb3);
    pb_push_binop(unsafe { mut_view(*mb_flt) }, mut_view(*arena), fb2, facc, MIR_BINOP_ADD, pb_op_copy(facc), pb_op_copy(fstep));
    pb_push_binop(unsafe { mut_view(*mb_flt) }, mut_view(*arena), fb2, fi, MIR_BINOP_ADD, pb_op_copy(fi), pb_op_const(pt.ty_usize, 1u64));
    pb_set_goto(unsafe { mut_view(*mb_flt) }, fb2, fb1);
    pb_push_copy(unsafe { mut_view(*mb_flt) }, mut_view(*arena), fb3, 0u32, facc);
    pb_set_return(unsafe { mut_view(*mb_flt) }, fb3);

    let mut fpm = 0 as *mut PassManager;
    let mut falias = 0 as *const AliasInfo;
    let fob = pb_prepare_opt_body(unsafe { view(*mb_flt) }, pt, OPT_PROFILE_SPEED_O2, mut_view(*arena), mut_view(*sink), mut_view(fpm), mut_view(falias));
    let ftree = loops_discover(unsafe { view(*fob) }, 0 as *const EffectCallTable, falias, mut_view(*arena));
    scev_analyze_tree(unsafe { mut_view(*ftree) }, unsafe { view(*fob) }, falias, mut_view(*arena));
    let flp = unsafe { loop_desc_at((*ftree).loops, 0) };
    let fred = loop_xform_recognize_reduction(unsafe { view(*flp) }, unsafe { view(*fob) }, falias);
    if !fred.valid || fred.reassoc_legal || !fred.is_float {
        return false;
    }

    let mut stats = pb_zero_stats();
    let dummy_fn = arena_alloc_raw(mut_view(*arena), size_of<HirItem>(), align_of<HirItem>()) as *mut HirItem;
    let db = dummy_fn as *mut u8;
    let mut z: usize = 0;
    while z < size_of<HirItem>() {
        unsafe { *opt_u8_at(db, z) = 0u8; }
        z = z + 1;
    }
    let ok_e2e = loop_xform_optimize_mir_body(
        unsafe { mut_view(*mb_int) },
        pt.thir as *const Thir,
        OPT_PROFILE_SPEED_O2,
        true,
        0 as *const EffectCallTable,
        mut_view(stats),
        mut_view(*arena),
        mut_view(*sink),
        dummy_fn as *const HirItem
    );
    if !ok_e2e || stats.loops_unrolled_full != 1u32 {
        return false;
    }

    let mut dbuf = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(dbuf));
    loop_xform_print(view(stats), mut_view(dbuf));
    dbuf.len > 120 && (unsafe { *(dbuf.ptr) }) == 108u8 && (unsafe { *opt_u8_at(dbuf.ptr, 1) }) == 111u8
}

fn main() -> i32 {
    let mut arena = arena_with_chunk_size(4194304);
    let _ = arena_alloc_raw(mut_view(arena), 16, 8);
    let sink_ptr = arena_alloc_raw(mut_view(arena), size_of<DiagSink>(), align_of<DiagSink>()) as *mut DiagSink;
    unsafe { diag_sink_init(mut_view(*sink_ptr)); }
    let pt = pb_init_types(mut_view(arena));

    if !test_case1a_licm_pos_and_guards(view(pt), mut_view(arena), unsafe { mut_view(*sink_ptr) }) {
        print("FAIL: CASE1_LICM_POS_AND_GUARDS\n");
        return 1;
    }
    print("CASE1_LICM_POS_AND_GUARDS: OK\n");

    if !test_case1b_licm_neg_gates(view(pt), mut_view(arena), unsafe { mut_view(*sink_ptr) }) {
        print("FAIL: CASE1B_LICM_NEG_TRAP_CLOBBER_BARRIER\n");
        return 1;
    }
    print("CASE1B_LICM_NEG_TRAP_CLOBBER_BARRIER: OK\n");

    if !test_case2_iv_sr_and_overflow_gate(view(pt), mut_view(arena), unsafe { mut_view(*sink_ptr) }) {
        print("FAIL: CASE2_IV_SR_AND_OVERFLOW_GATE\n");
        return 1;
    }
    print("CASE2_IV_SR_AND_OVERFLOW_GATE: OK\n");

    if !test_case3_loop_peel(view(pt), mut_view(arena), unsafe { mut_view(*sink_ptr) }) {
        print("FAIL: CASE3_LOOP_PEEL_FIRST_ITER\n");
        return 1;
    }
    print("CASE3_LOOP_PEEL_FIRST_ITER: OK\n");

    if !test_case4_loop_unswitch(view(pt), mut_view(arena), unsafe { mut_view(*sink_ptr) }) {
        print("FAIL: CASE4_LOOP_UNSWITCH_INVARIANT\n");
        return 1;
    }
    print("CASE4_LOOP_UNSWITCH_INVARIANT: OK\n");

    if !test_case5_loop_unroll(view(pt), mut_view(arena), unsafe { mut_view(*sink_ptr) }) {
        print("FAIL: CASE5_LOOP_UNROLL_FULL_AND_PARTIAL\n");
        return 1;
    }
    print("CASE5_LOOP_UNROLL_FULL_AND_PARTIAL: OK\n");

    if !test_case6_loop_version(view(pt), mut_view(arena), unsafe { mut_view(*sink_ptr) }) {
        print("FAIL: CASE6_LOOP_VERSION_FAST_AND_FALLBACK\n");
        return 1;
    }
    print("CASE6_LOOP_VERSION_FAST_AND_FALLBACK: OK\n");

    if !test_case7_loop_fuse_and_iter_forward(view(pt), mut_view(arena), unsafe { mut_view(*sink_ptr) }) {
        print("FAIL: CASE7_LOOP_FUSE_AND_ITER_FORWARD\n");
        return 1;
    }
    print("CASE7_LOOP_FUSE_AND_ITER_FORWARD: OK\n");

    if !test_case8_reduction_legality_and_print(view(pt), mut_view(arena), unsafe { mut_view(*sink_ptr) }) {
        print("FAIL: CASE8_REDUCTION_LEGALITY_AND_PRINT\n");
        return 1;
    }
    print("CASE8_REDUCTION_LEGALITY_AND_PRINT: OK\n");

    print("OPT-LOOPS-PROBE: ALL-OK\n");
    0
}
