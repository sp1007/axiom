// test: run
// stdout: LXF_BANNER=Xin chào tối ưu hóa biến đổi vòng lặp\nDROP_GUARD=10\nDROP_GUARD=20\nLICM_RES=468\nSR_RES=420\nPEEL_RES=180\nUNSWITCH_T=214\nUNSWITCH_F=94\nUNROLL_RES=598\nVERSION_RES=100\nFUSE_ITER_RES=120\nLXF_TOTAL=2194\n

struct LoopDropGuard {
    id: i32,
}

impl Drop for LoopDropGuard {
    fn drop(self: mut_view<LoopDropGuard>) {
        print("DROP_GUARD=");
        print_int(self.id);
        print("\n");
    }
}

fn test_licm_and_zero_trip_safety(s: view<[i32]>, a: i32, b: i32, zero_n: usize, zero_denom: i32) -> i32 {
    let mut i: usize = 0;
    let mut acc: i32 = 0;
    while i < 8 {
        let inv_scalar: i32 = (a + b) * 3 - 5;
        let inv_load: i32 = s[0] + (len(s) as i32);
        acc = acc + inv_scalar + inv_load + (i as i32);
        i = i + 1;
    }

    // Zero-trip loop with trapping division by `zero_denom == 0`: MUST NOT hoist trap!
    let mut z: usize = 0;
    while z < zero_n {
        let bad: i32 = 100 / zero_denom;
        acc = acc + bad;
        z = z + 1;
    }
    acc
}

fn test_iv_strength_reduction() -> i32 {
    let mut i: i32 = 0;
    let mut sum_checked: i32 = 0;
    while i < 8 {
        let scaled: i32 = i * 6;
        sum_checked = sum_checked + scaled;
        i = i + 1;
    }

    let mut j: i32 = 0;
    let mut sum_wrap: i32 = 0;
    while j < 8 {
        let wscaled: i32 = j * 9;
        sum_wrap = sum_wrap + wscaled;
        j = j + 1;
    }
    sum_checked + sum_wrap
}

fn test_first_iter_peeling_and_shifted_bce(a: view<[i32]>) -> i32 {
    let mut i: usize = 0;
    let mut acc: i32 = 0;
    while i < 5 {
        if i == 0 {
            acc = acc + a[0] * 2;
        } else {
            acc = acc + a[i - 1] + a[i];
        }
        i = i + 1;
    }
    acc
}

fn test_loop_unswitching(s: view<[i32]>, flag: bool) -> i32 {
    let mut i: usize = 0;
    let mut acc: i32 = 0;
    while i < 4 {
        if flag {
            acc = acc + s[i] * 3 + 1;
        } else {
            acc = acc + s[i] + 6;
        }
        i = i + 1;
    }
    acc
}

fn test_full_and_partial_unrolling() -> i32 {
    // 0-trip unroll
    let mut z: usize = 0;
    let mut acc: i32 = 0;
    while z < 0 {
        acc = acc + 999;
        z = z + 1;
    }

    // Full unroll (N = 4)
    let mut i: usize = 0;
    while i < 4 {
        acc = acc + ((i as i32) * 5 + 2);
        i = i + 1;
    }

    // Partial unroll candidate (N = 32)
    let mut k: usize = 0;
    while k < 32 {
        acc = acc + (k as i32) + 2;
        k = k + 1;
    }
    acc
}

fn test_loop_versioning_fast_path(s: view<[i32]>, n: usize) -> i32 {
    let mut i: usize = 0;
    let mut acc: i32 = 0;
    while i < n {
        acc = acc + s[i];
        i = i + 1;
    }
    acc
}

fn test_adjacent_loop_fusion_and_iter_pipeline() -> i32 {
    let src: [8]i32 = [2, 5, 8, 11, 14, 17, 20, 23];
    let mut tmp: [8]i32 = [0, 0, 0, 0, 0, 0, 0, 0];

    // Stage 1 (producer / map): tmp[i] = src[i] * 2 + 1
    let mut i: usize = 0;
    while i < 6 {
        let v: i32 = src[i] * 2 + 1;
        tmp[i] = v;
        i = i + 1;
    }

    // Stage 2 (consumer / fold): sum of tmp[0..6]
    let mut j: usize = 0;
    let mut folded: i32 = 0;
    while j < 6 {
        let x: i32 = tmp[j];
        folded = folded + x;
        j = j + 1;
    }

    // Drop ordering verification inside loop scope
    {
        let _g1 = LoopDropGuard { id: 10 };
    }
    {
        let _g2 = LoopDropGuard { id: 20 };
    }

    folded
}

fn main() -> i32 {
    print("LXF_BANNER=Xin chào tối ưu hóa biến đổi vòng lặp\n");

    let s_arr: [5]i32 = [10, 15, 20, 25, 30];
    let s_view: view<[i32]> = view(s_arr);

    let r_licm: i32 = test_licm_and_zero_trip_safety(s_view, 7, 8, 0, 0);
    let r_sr: i32 = test_iv_strength_reduction();
    let r_peel: i32 = test_first_iter_peeling_and_shifted_bce(s_view);
    let r_unsw_t: i32 = test_loop_unswitching(s_view, true);
    let r_unsw_f: i32 = test_loop_unswitching(s_view, false);
    let r_unroll: i32 = test_full_and_partial_unrolling();
    let r_ver: i32 = test_loop_versioning_fast_path(s_view, 5);
    let r_fuse: i32 = test_adjacent_loop_fusion_and_iter_pipeline();

    let total: i32 = r_licm + r_sr + r_peel + r_unsw_t + r_unsw_f + r_unroll + r_ver + r_fuse;

    print("LICM_RES=");
    print_int(r_licm);
    print("\nSR_RES=");
    print_int(r_sr);
    print("\nPEEL_RES=");
    print_int(r_peel);
    print("\nUNSWITCH_T=");
    print_int(r_unsw_t);
    print("\nUNSWITCH_F=");
    print_int(r_unsw_f);
    print("\nUNROLL_RES=");
    print_int(r_unroll);
    print("\nVERSION_RES=");
    print_int(r_ver);
    print("\nFUSE_ITER_RES=");
    print_int(r_fuse);
    print("\nLXF_TOTAL=");
    print_int(total);
    print("\n");
    0
}
