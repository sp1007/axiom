// test: run
// stdout: NEG_DEP_ARR=23\nSCALAR_DEP=150\nALIAS_CLOBBER=14\n
// Verifies that adjacent loops with negative-distance memory dependences (`a[i]` written in L1,
// `a[i + 1]` read in L2) or loop-carried scalar dependences are NOT illegally fused, and that
// clobbered array loads inside a loop are NOT hoisted by LICM.

fn test_negative_distance_not_fused() -> i32 {
    let mut a: [5]i32 = [1, 2, 3, 4, 5];
    let mut b: [5]i32 = [0, 0, 0, 0, 0];

    // Loop 1 writes `a[i] = (i + 1) * 2`
    let mut i: usize = 0;
    while i < 4 {
        a[i] = ((i as i32) + 1) * 2;
        i = i + 1;
    }

    // Loop 2 reads `a[j + 1]` (distance d = -1 < 0 relative to Loop 1's write `a[i]`)
    let mut j: usize = 0;
    let mut sum: i32 = 0;
    while j < 4 {
        b[j] = a[j + 1];
        sum = sum + b[j];
        j = j + 1;
    }
    sum
}

fn test_scalar_reduction_dep_not_fused() -> i32 {
    let arr: [4]i32 = [2, 3, 4, 6];
    let mut i: usize = 0;
    let mut total: i32 = 0;
    while i < 4 {
        total = total + arr[i];
        i = i + 1;
    }

    let mut j: usize = 0;
    let mut scaled: i32 = 0;
    while j < 4 {
        scaled = scaled + total + arr[j];
        j = j + 1;
    }
    scaled + total * 5
}

fn test_clobbered_load_not_hoisted() -> i32 {
    let mut arr: [4]i32 = [1, 2, 3, 4];
    let mut i: usize = 0;
    let mut acc: i32 = 0;
    while i < 4 {
        arr[0] = arr[0] + (i as i32);
        let first: i32 = arr[0];
        acc = acc + first;
        i = i + 1;
    }
    acc
}

fn main() -> i32 {
    let r1: i32 = test_negative_distance_not_fused();
    let r2: i32 = test_scalar_reduction_dep_not_fused();
    let r3: i32 = test_clobbered_load_not_hoisted();
    print("NEG_DEP_ARR=");
    print_int(r1);
    print("\nSCALAR_DEP=");
    print_int(r2);
    print("\nALIAS_CLOBBER=");
    print_int(r3);
    print("\n");
    0
}
