// test: run
// exit: 101
// Verifies that `opt_iv_strength_reduce` does NOT strength-reduce a checked multiplication
// (`i * 1000000000`) into wrapping addition when `NoOverflow` is not proven, preserving the
// exact checked arithmetic overflow panic (`exit: 101`).

fn checked_mul_overflow_in_loop() -> i32 {
    let mut i: i32 = 0;
    let mut acc: i32 = 0;
    while i < 4 {
        let prod: i32 = i * 1000000000;
        acc = prod;
        i = i + 1;
    }
    acc
}

fn main() -> i32 {
    let r: i32 = checked_mul_overflow_in_loop();
    print_int(r);
    0
}
