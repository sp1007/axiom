// test: run
// modes: interp native
// stdout-file: store_sha256_cache_and_sandbox.stdout
// SPEC-111 §4 (AXS-PKG-032; REQ-PKG-024, REQ-ECO-8736):
// Verifies SHA-256 content-addressed package cache keying, pre-use digest verification,
// sandboxed extraction path-traversal rejection, and archive bomb quota limits.

const MAX_ARCHIVE: usize = 67108864usize        // 64 MiB
const MAX_UNCOMPRESSED: usize = 268435456usize  // 256 MiB
const MAX_RATIO: usize = 100usize
const MAX_FILES: usize = 16384usize

fn check_traversal(p: view<[u8]>) -> bool {
    let n = len(p)
    if n == 0usize {
        return true
    }
    let b0 = p[0]
    if b0 == 47u8 || b0 == 92u8 {
        return true
    }
    if n >= 2usize && p[1] == 58u8 {
        return true
    }
    let mut i: usize = 0usize
    while i < n {
        let b = p[i]
        if b == 0u8 || b == 92u8 {
            return true
        }
        if b == 46u8 && (i + 1usize) < n && p[i + 1usize] == 46u8 {
            let prev_sep = i == 0usize || p[i - 1usize] == 47u8
            let next_sep = (i + 2usize) == n || p[i + 2usize] == 47u8
            if prev_sep && next_sep {
                return true
            }
        }
        i = i + 1usize
    }
    false
}

fn check_quotas(arch_size: usize, uncomp_size: usize, count: usize) -> bool {
    if arch_size > MAX_ARCHIVE || uncomp_size > MAX_UNCOMPRESSED || count > MAX_FILES {
        return false
    }
    if arch_size > 0usize && (uncomp_size / arch_size) > MAX_RATIO {
        return false
    }
    true
}

@derive(Copy)
struct Hash256 {
    w0: u64,
    w1: u64,
    w2: u64,
    w3: u64,
}

fn check_sha256_match(a: Hash256, b: Hash256) -> bool {
    a.w0 == b.w0 && a.w1 == b.w1 && a.w2 == b.w2 && a.w3 == b.w3
}

pub fn main() -> i32 {
    let sha_exp = Hash256 { w0: 0xE3B0C44298FC1C14u64, w1: 0x9AFBF4C8996FB924u64, w2: 0x27AE41E4649B934Cu64, w3: 0xA495991B7852B855u64 }
    let sha_ok = Hash256 { w0: 0xE3B0C44298FC1C14u64, w1: 0x9AFBF4C8996FB924u64, w2: 0x27AE41E4649B934Cu64, w3: 0xA495991B7852B855u64 }
    let sha_tampered = Hash256 { w0: 0xE3B0C44298FC1C14u64, w1: 0x9AFBF4C8996FB924u64, w2: 0x27AE41E4649B934Cu64, w3: 0xA495991B7852B800u64 }

    let digest_match = check_sha256_match(sha_exp, sha_ok)
    let digest_mismatch = !check_sha256_match(sha_exp, sha_tampered)

    // "src/main.ax"
    let p_ok: [11]u8 = [115u8, 114u8, 99u8, 47u8, 109u8, 97u8, 105u8, 110u8, 46u8, 97u8, 120u8]
    // "/etc/shadow"
    let p_abs: [11]u8 = [47u8, 101u8, 116u8, 99u8, 47u8, 115u8, 104u8, 97u8, 100u8, 111u8, 119u8]
    // "C:\secret.dll"
    let p_win: [13]u8 = [67u8, 58u8, 92u8, 115u8, 101u8, 99u8, 114u8, 101u8, 116u8, 46u8, 100u8, 108u8, 108u8]
    // "src/../../target"
    let p_dotdot: [16]u8 = [115u8, 114u8, 99u8, 47u8, 46u8, 46u8, 47u8, 46u8, 46u8, 47u8, 116u8, 97u8, 114u8, 103u8, 101u8, 116u8]

    let t_ok = !check_traversal(view(p_ok))
    let t_abs = check_traversal(view(p_abs))
    let t_win = check_traversal(view(p_win))
    let t_dotdot = check_traversal(view(p_dotdot))

    let q_ok = check_quotas(1024usize, 4096usize, 50usize)
    let q_arch_overflow = !check_quotas(70000000usize, 70000000usize, 10usize)
    let q_ratio_bomb = !check_quotas(1024usize, 500000usize, 10usize)
    let q_files_overflow = !check_quotas(1024usize, 2048usize, 20000usize)

    if !digest_match || !digest_mismatch || !t_ok || !t_abs || !t_win || !t_dotdot ||
        !q_ok || !q_arch_overflow || !q_ratio_bomb || !q_files_overflow {
        return 1
    }

    print("STORE-SHA256-CACHE-AND-SANDBOX-OK\n")
    0
}
