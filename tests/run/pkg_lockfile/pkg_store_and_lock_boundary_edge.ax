// test: run
// modes: interp native
// stdout-file: pkg_store_and_lock_boundary_edge.stdout
// SPEC-111 §§4..5 (AXS-PKG-030..033, AXS-PKG-040; REQ-PKG-022, REQ-PKG-024, REQ-ECO-8736):
// QA regression test for T856 (boundary, negative, and edge cases for store sandbox, quotas, digests, and SemVer sorting).

const MAX_ARCHIVE: usize = 67108864usize        // 64 MiB
const MAX_UNCOMPRESSED: usize = 268435456usize  // 256 MiB
const MAX_RATIO: usize = 100usize
const MAX_FILES: usize = 16384usize

fn check_traversal(p: view<[u8]>) -> bool {
    let n = len(p)
    if n == 0usize {
        return true
    }
    let b0 = p[0]
    if b0 == 47u8 || b0 == 92u8 {
        return true
    }
    if n >= 2usize && p[1] == 58u8 {
        return true
    }
    let mut i: usize = 0usize
    while i < n {
        let b = p[i]
        if b == 0u8 || b == 92u8 {
            return true
        }
        if b == 46u8 && (i + 1usize) < n && p[i + 1usize] == 46u8 {
            let prev_sep = i == 0usize || p[i - 1usize] == 47u8
            let next_sep = (i + 2usize) == n || p[i + 2usize] == 47u8
            if prev_sep && next_sep {
                return true
            }
        }
        i = i + 1usize
    }
    false
}

fn check_quotas(arch_size: usize, uncomp_size: usize, count: usize) -> bool {
    if arch_size > MAX_ARCHIVE || uncomp_size > MAX_UNCOMPRESSED || count > MAX_FILES {
        return false
    }
    if arch_size > 0usize && (uncomp_size / arch_size) > MAX_RATIO {
        return false
    }
    true
}

fn check_hex_char(b: u8) -> bool {
    (b >= 48u8 && b <= 57u8) || (b >= 97u8 && b <= 102u8) || (b >= 65u8 && b <= 70u8)
}

fn is_valid_digest(p: view<[u8]>) -> bool {
    let n = len(p)
    if n != 64usize {
        return false
    }
    let mut i: usize = 0usize
    while i < 64usize {
        if !check_hex_char(p[i]) {
            return false
        }
        i = i + 1usize
    }
    true
}

fn cmp_semver_3(a_maj: u32, a_min: u32, a_pat: u32, b_maj: u32, b_min: u32, b_pat: u32) -> i32 {
    if a_maj < b_maj { return -1i32 }
    if a_maj > b_maj { return 1i32 }
    if a_min < b_min { return -1i32 }
    if a_min > b_min { return 1i32 }
    if a_pat < b_pat { return -1i32 }
    if a_pat > b_pat { return 1i32 }
    0i32
}

fn check_offline_coverage(is_offline: bool, total_external: usize, cached_count: usize) -> bool {
    if !is_offline {
        return true
    }
    cached_count >= total_external
}

pub fn main() -> i32 {
    // 1. Quota exact boundary tests
    let q_exact_arch = check_quotas(MAX_ARCHIVE, MAX_ARCHIVE, 10usize)
    let q_over_arch = !check_quotas(MAX_ARCHIVE + 1usize, MAX_ARCHIVE, 10usize)
    let q_exact_uncomp = check_quotas(10000000usize, MAX_UNCOMPRESSED, 10usize)
    let q_over_uncomp = !check_quotas(10000000usize, MAX_UNCOMPRESSED + 1usize, 10usize)
    let q_exact_ratio = check_quotas(1000usize, 100000usize, 10usize)
    let q_over_ratio = !check_quotas(1000usize, 101000usize, 10usize)
    let q_exact_count = check_quotas(1024usize, 2048usize, MAX_FILES)
    let q_over_count = !check_quotas(1024usize, 2048usize, MAX_FILES + 1usize)
    let q_zero = check_quotas(0usize, 0usize, 0usize)

    let quotas_ok = q_exact_arch && q_over_arch && q_exact_uncomp && q_over_uncomp &&
        q_exact_ratio && q_over_ratio && q_exact_count && q_over_count && q_zero

    // 2. Traversal edge cases:
    let p_empty: [1]u8 = [0u8]
    let t_empty = check_traversal(p_empty[0..0])

    let p_bare_dotdot: [2]u8 = [46u8, 46u8]
    let t_bare_dotdot = check_traversal(view(p_bare_dotdot))

    let p_lead_dotdot: [12]u8 = [46u8, 46u8, 47u8, 101u8, 115u8, 99u8, 97u8, 112u8, 101u8, 46u8, 97u8, 120u8]
    let t_lead_dotdot = check_traversal(view(p_lead_dotdot))

    let p_trail_dotdot: [6]u8 = [100u8, 105u8, 114u8, 47u8, 46u8, 46u8]
    let t_trail_dotdot = check_traversal(view(p_trail_dotdot))

    let p_mid_dotdot: [18]u8 = [100u8, 105u8, 114u8, 47u8, 115u8, 117u8, 98u8, 47u8, 46u8, 46u8, 47u8, 102u8, 105u8, 108u8, 101u8, 46u8, 97u8, 120u8]
    let t_mid_dotdot = check_traversal(view(p_mid_dotdot))

    let p_backslash: [11]u8 = [100u8, 105u8, 114u8, 92u8, 102u8, 105u8, 108u8, 101u8, 46u8, 97u8, 120u8]
    let t_backslash = check_traversal(view(p_backslash))

    let p_drive: [8]u8 = [68u8, 58u8, 115u8, 101u8, 99u8, 114u8, 101u8, 116u8]
    let t_drive = check_traversal(view(p_drive))

    let p_valid: [11]u8 = [115u8, 114u8, 99u8, 47u8, 109u8, 97u8, 105u8, 110u8, 46u8, 97u8, 120u8]
    let t_valid = !check_traversal(view(p_valid))

    let traversal_ok = t_empty && t_bare_dotdot && t_lead_dotdot && t_trail_dotdot &&
        t_mid_dotdot && t_backslash && t_drive && t_valid

    // 3. Digest hex validation boundary tests:
    let d_valid: [64]u8 = [
        48u8, 49u8, 50u8, 51u8, 52u8, 53u8, 54u8, 55u8, 56u8, 57u8, 97u8, 98u8, 99u8, 100u8, 101u8, 102u8,
        65u8, 66u8, 67u8, 68u8, 69u8, 70u8, 48u8, 49u8, 50u8, 51u8, 52u8, 53u8, 54u8, 55u8, 56u8, 57u8,
        97u8, 98u8, 99u8, 100u8, 101u8, 102u8, 65u8, 66u8, 67u8, 68u8, 69u8, 70u8, 48u8, 49u8, 50u8, 51u8,
        52u8, 53u8, 54u8, 55u8, 56u8, 57u8, 97u8, 98u8, 99u8, 100u8, 101u8, 102u8, 65u8, 66u8, 67u8, 68u8
    ]
    let d_valid_ok = is_valid_digest(view(d_valid))

    let d_short_ok = !is_valid_digest(d_valid[0..63])

    let mut d_bad = d_valid
    d_bad[10] = 103u8
    let d_bad_char_ok = !is_valid_digest(view(d_bad))

    let digest_ok = d_valid_ok && d_short_ok && d_bad_char_ok

    // 4. SemVer 2.0 total ordering boundary:
    let sv_maj_ok = cmp_semver_3(2u32, 0u32, 0u32, 1u32, 99u32, 99u32) > 0i32
    let sv_min_ok = cmp_semver_3(1u32, 2u32, 0u32, 1u32, 1u32, 99u32) > 0i32
    let sv_pat_ok = cmp_semver_3(1u32, 0u32, 1u32, 1u32, 0u32, 0u32) > 0i32
    let sv_eq_ok = cmp_semver_3(1u32, 2u32, 3u32, 1u32, 2u32, 3u32) == 0i32
    let semver_ok = sv_maj_ok && sv_min_ok && sv_pat_ok && sv_eq_ok

    // 5. Offline coverage edge cases:
    let off_zero = check_offline_coverage(true, 0usize, 0usize)
    let off_surplus = check_offline_coverage(true, 3usize, 5usize)
    let off_exact = check_offline_coverage(true, 3usize, 3usize)
    let off_deficit = !check_offline_coverage(true, 3usize, 2usize)
    let online_deficit = check_offline_coverage(false, 3usize, 0usize)
    let coverage_ok = off_zero && off_surplus && off_exact && off_deficit && online_deficit

    if !quotas_ok || !traversal_ok || !digest_ok || !semver_ok || !coverage_ok {
        return 1
    }

    print("PKG-STORE-AND-LOCK-BOUNDARY-EDGE-OK\n")
    0
}
