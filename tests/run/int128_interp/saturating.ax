// test: run
// native-after: T453
// exit: 0
// stdout: ok\n

fn main() -> i32 {
    // 1. i128 bounds
    let max_i128: i128 = 170141183460469231731687303715884105727i128;
    let min_i128: i128 = -170141183460469231731687303715884105728i128;
    let one_i128: i128 = 1i128;

    if max_i128.saturating_add(one_i128) != max_i128 {
        return 1;
    }
    if min_i128.saturating_sub(one_i128) != min_i128 {
        return 2;
    }
    if max_i128.saturating_mul(2i128) != max_i128 {
        return 3;
    }
    if min_i128.saturating_mul(2i128) != min_i128 {
        return 4;
    }

    // 2. u128 bounds
    let max_u128: u128 = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFu128;
    let zero_u128: u128 = 0u128;
    let one_u128: u128 = 1u128;

    if max_u128.saturating_add(one_u128) != max_u128 {
        return 5;
    }
    if zero_u128.saturating_sub(one_u128) != zero_u128 {
        return 6;
    }
    if max_u128.saturating_mul(2u128) != max_u128 {
        return 7;
    }

    // 3. i32 bounds
    let max_i32: i32 = 2147483647;
    let min_i32: i32 = -2147483648;
    if max_i32.saturating_add(1) != max_i32 {
        return 8;
    }
    if min_i32.saturating_sub(1) != min_i32 {
        return 9;
    }
    if max_i32.saturating_mul(2) != max_i32 {
        return 10;
    }

    // 4. u8 bounds
    let max_u8: u8 = 255u8;
    let zero_u8: u8 = 0u8;
    if max_u8.saturating_add(1u8) != max_u8 {
        return 11;
    }
    if zero_u8.saturating_sub(1u8) != zero_u8 {
        return 12;
    }

    print("ok\n");
    0
}
