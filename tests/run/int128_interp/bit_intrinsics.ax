// test: run
// native-after: T453
// exit: 0
// stdout: ok\n

fn main() -> i32 {
    let val_u128: u128 = 0x80000000000000000000000000000001u128;
    if val_u128.count_ones() != 2u32 {
        return 1;
    }
    if val_u128.leading_zeros() != 0u32 {
        return 2;
    }
    if val_u128.trailing_zeros() != 0u32 {
        return 3;
    }

    let zero_u128: u128 = 0u128;
    if zero_u128.leading_zeros() != 128u32 {
        return 4;
    }
    if zero_u128.trailing_zeros() != 128u32 {
        return 5;
    }

    // rotate_left and rotate_right
    let one_u128: u128 = 1u128;
    let rot_l = one_u128.rotate_left(1u32);
    if rot_l != 2u128 {
        return 6;
    }
    let rot_r = rot_l.rotate_right(1u32);
    if rot_r != 1u128 {
        return 7;
    }
    let rot_wrap = one_u128.rotate_right(1u32);
    if rot_wrap != 0x80000000000000000000000000000000u128 {
        return 8;
    }

    // swap_bytes
    let pattern_u128: u128 = 0x0102030405060708090A0B0C0D0E0F10u128;
    let swapped = pattern_u128.swap_bytes();
    if swapped != 0x100F0E0D0C0B0A090807060504030201u128 {
        return 9;
    }

    // reverse_bits
    let rev_in: u128 = 1u128;
    let rev_out = rev_in.reverse_bits();
    if rev_out != 0x80000000000000000000000000000000u128 {
        return 10;
    }

    // wrapping_*
    let max_u128: u128 = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFu128;
    if max_u128.wrapping_add(1u128) != 0u128 {
        return 11;
    }
    if zero_u128.wrapping_sub(1u128) != max_u128 {
        return 12;
    }

    print("ok\n");
    0
}
