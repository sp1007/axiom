// test: run
// native-after: T453
// exit: 0
// stdout: ok\n

fn main() -> i32 {
    let s64: i64 = 100000;
    let s32: i32 = -2000;
    let u16v: u16 = 500u16;
    let b8: u8 = 200u8;
    let s8: i8 = -50i8;

    // Pattern D compound expression promotion
    // (100000 + (-6000)) - (500 + 400 - 50 - 7) / (4 - (-50))
    // = 94000 - 843 / 54 = 94000 - 15 = 93985
    let total: i64 = (s64 + (s32 * 3) as i64) - (u16v as i64 + (b8 as i64 * 2) + s8 as i64 - 7) / (4 - s8 as i64);
    if total != 93985 {
        return 1;
    }

    // Extended Pattern D with 128-bit
    let big128: i128 = 100000000000000000000i128;
    let combined = big128 + (total as i128);
    if combined != 100000000000000093985i128 {
        return 2;
    }

    print("ok\n");
    0
}
