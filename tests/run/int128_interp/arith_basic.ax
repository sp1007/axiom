// test: run
// native-after: T453
// exit: 0
// stdout: ok\n

fn main() -> i32 {
    // 1. Basic i128 addition, subtraction, multiplication
    let a: i128 = 100000000000000000000i128;
    let b: i128 = 200000000000000000000i128;
    let c = a + b;
    if c != 300000000000000000000i128 {
        return 1;
    }
    let d = c - a;
    if d != b {
        return 2;
    }

    // 2. Unary negation
    let neg_a = -a;
    if neg_a + a != 0i128 {
        return 3;
    }

    // 3. Multiplication and division
    let m1: i128 = 1000000000000i128;
    let m2: i128 = 2000000000000i128;
    let prod = m1 * m2;
    if prod / m1 != m2 {
        return 4;
    }
    if prod % m1 != 0i128 {
        return 5;
    }

    // 4. Bitwise operations
    let x: u128 = 0xF0F0F0F0F0F0F0F0F0F0F0F0F0F0F0F0u128;
    let y: u128 = 0x0F0F0F0F0F0F0F0F0F0F0F0F0F0F0F0Fu128;
    if (x & y) != 0u128 {
        return 6;
    }
    if (x | y) != 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFu128 {
        return 7;
    }
    if (x ^ y) != 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFu128 {
        return 8;
    }
    if ~x != y {
        return 9;
    }

    // 5. Shifts
    let one: u128 = 1u128;
    let sh1 = one << 64u128;
    if sh1 != 0x00000000000000010000000000000000u128 {
        return 10;
    }
    if (sh1 >> 64u128) != one {
        return 11;
    }

    // Arithmetic shift right
    let neg_two: i128 = -2i128;
    if (neg_two >> 1i128) != -1i128 {
        return 12;
    }

    // 6. Comparisons
    let small: i128 = -5i128;
    let big: i128 = 5i128;
    if !(small < big) || small > big || small == big || !(small <= big) || !(big >= small) {
        return 13;
    }

    // 7. Casts across widths
    let i8_val: i8 = -42i8;
    let i128_cast = i8_val as i128;
    if i128_cast != -42i128 {
        return 14;
    }
    let back_i8 = i128_cast as i8;
    if back_i8 != i8_val {
        return 15;
    }

    let u8_val: u8 = 200u8;
    let u128_cast = u8_val as u128;
    if u128_cast != 200u128 {
        return 16;
    }
    let back_u8 = u128_cast as u8;
    if back_u8 != u8_val {
        return 17;
    }

    print("ok\n");
    0
}
