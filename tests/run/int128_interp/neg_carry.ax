// test: run
// native-after: T453
// exit: 0
// stdout: ok\n

fn main() -> i32 {
    // Two's-complement negation must carry out of the low word when lo == 0.
    let two64: i128 = 1i128 << 64i128;
    let n = -two64;
    if (n >> 64i128) != -1i128 {
        return 1;
    }
    if (n & 0xFFFFFFFFFFFFFFFFi128) != 0i128 {
        return 2;
    }
    if n + two64 != 0i128 {
        return 3;
    }
    if n / two64 != -1i128 {
        return 4;
    }
    if n % 7i128 != -2i128 {
        return 5;
    }
    let step: i128 = 4294967296i128;
    if n / step != -4294967296i128 {
        return 6;
    }
    // Signed multiplication goes through |a| * |b| with the same negation helper.
    if n * 3i128 != -55340232221128654848i128 {
        return 7;
    }
    if two64 * -3i128 != -55340232221128654848i128 {
        return 8;
    }
    // Mixed-sign cases at the i128 bounds.
    let max: i128 = 170141183460469231731687303715884105727i128;
    let min: i128 = -max - 1i128;
    if min / 2i128 != -85070591730234615865843651857942052864i128 {
        return 9;
    }
    if min % 3i128 != -2i128 {
        return 10;
    }
    if max.wrapping_add(1i128) != min {
        return 11;
    }
    // u128 wrapping_sub of 2^64 stays exact.
    let u: u128 = 1u128 << 64u128;
    if u.wrapping_sub(1u128) != 0xFFFFFFFFFFFFFFFFu128 {
        return 12;
    }
    print("ok\n");
    0
}
