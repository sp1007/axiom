// test: run
// exit: 15
struct MyHasher { val: u32, }
trait Hasher {
    fn write_u32(self: mut_view<Self>, i: u32);
}
impl Hasher for MyHasher {
    fn write_u32(self: mut_view<MyHasher>, i: u32) {
        self.val = self.val + i;
    }
}
fn main() -> i32 {
    let mut h = MyHasher { val: 5 };
    h.write_u32(10);
    h.val as i32
}
