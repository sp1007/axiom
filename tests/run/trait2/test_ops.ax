// test: run
trait Copy {}

trait Add {
    fn add(self: Self, other: Self) -> Self;
}

trait Sub {
    fn sub(self: Self, other: Self) -> Self;
}

trait Mul {
    fn mul(self: Self, other: Self) -> Self;
}

trait Div {
    fn div(self: Self, other: Self) -> Self;
}

trait Rem {
    fn rem(self: Self, other: Self) -> Self;
}

trait Eq {
    fn eq(self: view<Self>, other: view<Self>) -> bool;
}

trait Ord {
    fn cmp(self: view<Self>, other: view<Self>) -> i32;
}

trait Index {
    fn index(self: view<Self>, idx: usize) -> i32;
}

@derive(Copy)
struct Num {
    val: i32,
}

impl Add for Num {
    fn add(self: Num, other: Num) -> Num {
        Num { val: self.val + other.val }
    }
}

impl Sub for Num {
    fn sub(self: Num, other: Num) -> Num {
        Num { val: self.val - other.val }
    }
}

impl Mul for Num {
    fn mul(self: Num, other: Num) -> Num {
        Num { val: self.val * other.val }
    }
}

impl Div for Num {
    fn div(self: Num, other: Num) -> Num {
        Num { val: self.val / other.val }
    }
}

impl Rem for Num {
    fn rem(self: Num, other: Num) -> Num {
        Num { val: self.val % other.val }
    }
}

impl Eq for Num {
    fn eq(self: view<Num>, other: view<Num>) -> bool {
        self.val == other.val
    }
}

impl Ord for Num {
    fn cmp(self: view<Num>, other: view<Num>) -> i32 {
        let v1 = self.val;
        let v2 = other.val;
        if (v1 < v2) {
            0
        } else if (v1 == v2) {
            1
        } else {
            2
        }
    }
}

struct Buffer {
    a: i32,
    b: i32,
}

impl Index for Buffer {
    fn index(self: view<Buffer>, idx: usize) -> i32 {
        if idx == 0 {
            self.a
        } else {
            self.b
        }
    }
}

fn fail_sc() -> bool {
    1 / 0 == 0
}

fn check_sc() -> bool {
    let a = false && fail_sc();
    let b = true || fail_sc();
    !a && b
}

fn main() -> i32 {
    let n1 = Num { val: 10 };
    let n2 = Num { val: 3 };

    let sum = n1 + n2;
    let diff = n1 - n2;
    let prod = n1 * n2;
    let quot = n1 / n2;
    let r = n1 % n2;

    if sum.val != 13 || diff.val != 7 || prod.val != 30 || quot.val != 3 || r.val != 1 {
        return 1;
    }

    if !(n1 == n1) || (n1 == n2) || !(n1 != n2) {
        return 2;
    }

    if !(n2 < n1) || !(n1 > n2) || !(n2 <= n1) || !(n1 >= n2) {
        return 3;
    }

    let buf = Buffer { a: 100, b: 200 };
    if buf[0] != 100 || buf[1] != 200 {
        return 4;
    }

    if !check_sc() {
        return 5;
    }

    0
}
