// test: run
// native-after: T059
trait Base {
    fn base_val(self: view<Self>) -> i32;
}

trait Derived : Base {
    fn derived_val(self: view<Self>) -> i32;
}

struct Item {
    x: i32,
}

impl Base for Item {
    fn base_val(self: view<Self>) -> i32 {
        self.x
    }
}

impl Derived for Item {
    fn derived_val(self: view<Self>) -> i32 {
        self.x * 2
    }
}

fn main() -> i32 {
    let item = Item { x: 21 };
    let b = item.base_val();
    let d = item.derived_val();
    if b == 21 && d == 42 {
        0
    } else {
        1
    }
}
