// test: run
trait Greet {
    fn hello(self: view<Self>) -> i32 {
        42
    }
}

struct DefaultUser {
    id: i32,
}

impl Greet for DefaultUser {}

struct CustomUser {
    id: i32,
}

impl Greet for CustomUser {
    fn hello(self: view<Self>) -> i32 {
        100
    }
}

fn main() -> i32 {
    let d = DefaultUser { id: 1 };
    let c = CustomUser { id: 2 };
    if d.hello() == 42 && c.hello() == 100 {
        0
    } else {
        1
    }
}
