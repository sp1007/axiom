// native-after: T059
// test: run
@lang("Ordering")
@derive(Copy)
enum Ordering {
    Less,
    Equal,
    Greater,
}
impl Clone for Ordering { fn clone(self: view<Ordering>) -> Ordering { *self } }

@lang("cmp")
trait Ord {
    fn cmp(self: view<Self>, other: view<Self>) -> Ordering;
}

@lang("eq")
trait PartialEq {
    fn eq(self: view<Self>, other: view<Self>) -> bool;
}

trait Eq: PartialEq {}

@lang("clone")
trait Clone {
    fn clone(self: view<Self>) -> Self;
}

trait Copy: Clone {}

trait Hasher {
    fn write_u32(self: mut_view<Self>, i: u32);
}

trait Hash {
    fn hash<H: Hasher>(self: view<Self>, state: mut_view<H>);
}

// Implement base types
impl PartialEq for u32 {
    fn eq(self: view<u32>, other: view<u32>) -> bool { *self == *other }
}
impl Eq for u32 {}

impl Ord for u32 {
    fn cmp(self: view<u32>, other: view<u32>) -> Ordering {
        if *self < *other { return Ordering.Less; }
        else if *self > *other { return Ordering.Greater; }
        else { return Ordering.Equal; }
    }
}

impl Clone for u32 {
    fn clone(self: view<u32>) -> u32 { *self }
}
impl Copy for u32 {}

impl Hash for u32 {
    fn hash<H: Hasher>(self: view<u32>, state: mut_view<H>) {
        state.write_u32(*self);
    }
}

struct MyHasher {
    val: u32,
}
impl Hasher for MyHasher {
    fn write_u32(self: mut_view<MyHasher>, i: u32) {
        self.val = self.val + i;
    }
}

@derive(Copy, Clone, Eq, PartialEq, Ord, Hash)
struct Point {
    x: u32,
    y: u32,
}

struct MapEntry {
    key: Point,
    val: i32,
    occupied: bool,
}

fn hash_point(p: view<Point>) -> u32 {
    let mut h = MyHasher { val: 0 };
    p.hash(mut_view(h));
    h.val
}

fn main() -> i32 {
    // 1. Test derived Eq and PartialEq
    let p1 = Point { x: 10, y: 20 };
    let p2 = Point { x: 10, y: 20 };
    let p3 = Point { x: 5, y: 30 };
    if !p1.eq(view(p2)) || p1.eq(view(p3)) {
        return 1;
    }

    // 2. Test derived Ord used for sorting
    let mut points = [
        Point { x: 20, y: 10 },
        Point { x: 5, y: 50 },
        Point { x: 10, y: 20 }
    ];
    
    let mut i: usize = 0;
    while i < 3 {
        let mut j: usize = i + 1;
        while j < 3 {
            let p_i = points[i];
            let p_j = points[j];
            let order = p_i.cmp(view(p_j));
            match order {
                Ordering.Greater => {
                    points[i] = p_j;
                    points[j] = p_i;
                },
                _ => {}
            }
            j = j + 1;
        }
        i = i + 1;
    }

    if points[0].x != 5 || points[1].x != 10 || points[2].x != 20 {
        return 2;
    }

    // 3. Test derived Hash + Eq used as key in hash lookup
    let mut entries = [
        MapEntry { key: Point { x: 0, y: 0 }, val: 0, occupied: false },
        MapEntry { key: Point { x: 0, y: 0 }, val: 0, occupied: false },
        MapEntry { key: Point { x: 0, y: 0 }, val: 0, occupied: false },
        MapEntry { key: Point { x: 0, y: 0 }, val: 0, occupied: false }
    ];

    // Insert (p1, 100) and (p3, 200)
    let h1: usize = (hash_point(view(p1)) % 4) as usize;
    entries[h1] = MapEntry { key: p1, val: 100, occupied: true };

    let h3: usize = (hash_point(view(p3)) % 4) as usize;
    entries[h3] = MapEntry { key: p3, val: 200, occupied: true };

    // Lookup p2 (which has the same key as p1)
    let lookup_h: usize = (hash_point(view(p2)) % 4) as usize;
    let entry = entries[lookup_h];
    if !entry.occupied || !entry.key.eq(view(p2)) || entry.val != 100 {
        return 3;
    }

    0
}
