// test: run
// native-after: T059
trait Container {
    type Item;
    const CAPACITY: i32;
    fn get(self: view<Self>) -> Self.Item;
}

struct IntBox {
    value: i32,
}

impl Container for IntBox {
    type Item = i32;
    const CAPACITY: i32 = 10;
    fn get(self: view<Self>) -> Self.Item {
        self.value
    }
}

fn main() -> i32 {
    let b = IntBox { value: 42 };
    let v: i32 = b.get();
    let cap: i32 = IntBox.CAPACITY;
    if v == 42 && cap == 10 {
        0
    } else {
        1
    }
}
