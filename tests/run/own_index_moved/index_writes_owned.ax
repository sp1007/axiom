// test: run
// exit: 0
// stdout: 5 1\n8 2\n12\n7 6\n3\n9\n4\n9 9\n10 20\n1\n2\n
// T498e (SPEC-10 AXS-OWN-006): every write through an index of a definitely OWNED array is accepted and
// keeps the array OWNED: `a[i].f = v`, `a[i] = v` (plain and drop-needing element: the old element is
// dropped in place), `a[i][j] = v`, `a[i] op= v`, an array in a struct field; whole reassignment
// `hs = [...]` after a move reinitialises the array.

struct H {
    n: u32,
}

struct D {
    id: i32,
}

impl Drop for D {
    fn drop(self: mut_view<D>) {
        print_int(self.id as i64);
        print("\n");
    }
}

struct W {
    k: u32,
    hs: [2]H,
}

fn mk(n: u32) -> H {
    H { n: n }
}

fn eat(hs: [2]H) -> u32 {
    hs[0].n + hs[1].n
}

fn main() -> i32 {
    let mut hs: [2]H = [mk(1u32), mk(1u32)];
    hs[0].n = 5u32;
    print_int(hs[0].n as i64);
    print(" ");
    print_int(hs[1].n as i64);
    print("\n");

    hs[1] = mk(2u32);
    hs[0].n += 3u32;
    print_int(hs[0].n as i64);
    print(" ");
    print_int(hs[1].n as i64);
    print("\n");

    // Whole reassignment after a move reinitialises the array.
    let t = hs;
    hs = [mk(3u32), mk(4u32)];
    print_int((eat(t) + 2u32) as i64);
    print("\n");
    let i: usize = 1;
    hs[i].n = hs[i].n + 2u32;
    print_int((hs[0].n + 4u32) as i64);
    print(" ");
    print_int(hs[1].n as i64);
    print("\n");

    // Drop-needing elements: the replaced element (id 3) is dropped at the assignment.
    let mut ds: [2]D = [D { id: 3 }, D { id: 4 }];
    ds[0] = D { id: 9 };
    // 2-D writes.
    let mut g: [2][2]u32 = [[0u32, 0u32], [0u32, 0u32]];
    g[1][0] = 9u32;
    g[0][1] = g[1][0];
    // An array in a struct field.
    let mut w = W { k: 7u32, hs: [mk(1u32), mk(1u32)] };
    w.hs[0].n = 10u32;
    w.hs[1] = mk(20u32);
    let ds2 = ds;
    ds = [D { id: 1 }, D { id: 2 }];
    drop(ds2);
    print_int(g[1][0] as i64);
    print(" ");
    print_int(g[0][1] as i64);
    print("\n");
    print_int(w.hs[0].n as i64);
    print(" ");
    print_int(w.hs[1].n as i64);
    print("\n");
    0
}
