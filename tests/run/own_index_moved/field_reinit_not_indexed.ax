// test: run
// exit: 0
// stdout: 5 2\n3\n
// T498e (SPEC-10 AXS-OWN-006, AOWN-37): the indexed-write rule does not touch field reinitialisation of
// a plain struct: after `s.a` is moved, `s.a = ...` reinitialises it, and the struct is whole again.

struct B {
    v: u32,
}

struct S {
    a: B,
    m: u32,
}

fn take(b: B) -> u32 {
    b.v
}

fn main() -> i32 {
    let mut s = S { a: B { v: 3u32 }, m: 2u32 };
    let x = take(s.a);
    s.a = B { v: 5u32 };
    print_int(s.a.v as i64);
    print(" ");
    print_int(s.m as i64);
    print("\n");
    let whole = s;
    print_int(x as i64);
    print("\n");
    0
}
