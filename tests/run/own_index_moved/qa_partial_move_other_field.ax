// test: run
// exit: 0
// stdout: 5 3\n8\n6 4\n
// QA (T498e gate): the indexed-write rule must not over-reject. After a different field of the struct
// was moved out (`w.name`), the array field `w.hs` is still definitely OWNED, so writes through its
// index are accepted and keep it owned; after `w.hs` is moved and reassigned as a whole, writes are
// accepted again.

struct H {
    n: u32,
}

struct W {
    name: H,
    hs: [2]H,
}

fn mk(n: u32) -> H {
    H { n: n }
}

fn take(h: H) -> u32 {
    h.n
}

fn eat(hs: [2]H) -> u32 {
    hs[0].n + hs[1].n
}

fn main() -> i32 {
    let mut w = W { name: mk(3u32), hs: [mk(1u32), mk(2u32)] };
    let nm = take(w.name);
    w.hs[0].n = 5u32;
    w.hs[1] = mk(nm);
    print_int(w.hs[0].n as i64);
    print(" ");
    print_int(w.hs[1].n as i64);
    print("\n");

    let t = w.hs;
    w.hs = [mk(1u32), mk(2u32)];
    w.hs[1].n += 1u32;
    w.hs[0] = mk(w.hs[1].n + 3u32);
    print_int((eat(t) + 0u32) as i64);
    print("\n");
    print_int(w.hs[0].n as i64);
    print(" ");
    print_int((w.hs[1].n + 1u32) as i64);
    print("\n");
    0
}
