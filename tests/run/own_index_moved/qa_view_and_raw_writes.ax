// test: run
// exit: 0
// stdout: 7 8 9\n4 5\n
// QA (T498e gate): writes through an index behind a mut_view parameter or a raw-pointer deref keep their
// handling (the base is read, not the array place): they are accepted, also for an array in a struct
// field, and the caller sees the writes.

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct H {
    n: u32,
}

struct W {
    k: u32,
    hs: [2]H,
}

fn mk(n: u32) -> H {
    H { n: n }
}

fn fill(a: mut_view<[2]H>) {
    (*a)[0].n = 7u32;
    (*a)[1] = mk(8u32);
}

fn bump(w: mut_view<W>) {
    w.hs[0].n = 4u32;
    w.hs[1].n += 5u32;
}

fn main() -> i32 {
    let mut hs: [2]H = [mk(1u32), mk(1u32)];
    fill(mut_view(hs));
    let mut gs: [2]H = [mk(0u32), mk(0u32)];
    unsafe {
        let p: *mut [2]H = address_of_mut(gs);
        (*p)[1].n = 9u32;
    }
    print_int(hs[0].n as i64);
    print(" ");
    print_int(hs[1].n as i64);
    print(" ");
    print_int(gs[1].n as i64);
    print("\n");
    let mut w = W { k: 0u32, hs: [mk(1u32), mk(0u32)] };
    bump(mut_view(w));
    print_int(w.hs[0].n as i64);
    print(" ");
    print_int(w.hs[1].n as i64);
    print("\n");
    0
}
