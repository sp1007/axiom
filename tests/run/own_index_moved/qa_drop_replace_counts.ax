// test: run
// exit: 0
// stdout: D1\nD2\nD3\nD4\nD5\nD6\nD9\nD8\nE\nD16\nD7\nD107\nD17\nD14\nD15\nD10\nD11\nD12\n
// QA (T498e gate): drop-then-store is an in-place replace; the array stays OWNED and every replaced
// element's destructor runs exactly once, at the assignment. Covers a loop, a dynamic index, an array
// in a struct field, a 2-D array and a replacement value built from another element. The surviving
// elements are dropped once at the end of main (locals in reverse order, elements in index order).

struct D {
    id: i32,
}

impl Drop for D {
    fn drop(self: mut_view<D>) {
        print("D");
        print_int(self.id as i64);
        print("\n");
    }
}

struct W {
    k: i32,
    ds: [2]D,
}

fn main() -> i32 {
    let mut ds: [3]D = [D { id: 1 }, D { id: 2 }, D { id: 3 }];
    let mut i: usize = 0;
    while i < 3 {
        ds[i] = D { id: 10 + (i as i32) };
        i = i + 1;
    }
    let mut w = W { k: 1, ds: [D { id: 4 }, D { id: 5 }] };
    let j: usize = 1;
    w.ds[0] = D { id: 14 };
    w.ds[j] = D { id: 15 };
    let mut g: [2][2]D = [[D { id: 6 }, D { id: 7 }], [D { id: 8 }, D { id: 9 }]];
    g[0][0] = D { id: 16 };
    g[1][1] = D { id: 17 };
    g[1][0] = D { id: g[0][1].id + 100 };
    print("E\n");
    0
}
