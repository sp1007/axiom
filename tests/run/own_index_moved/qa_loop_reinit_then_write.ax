// test: run
// exit: 0
// stdout: 9\n2\n
// QA (T498e gate): the array is moved and reassigned as a whole in every loop iteration, and written
// through an index before the move and after the reassignment; a maybe-moved state never reaches an
// indexed write. Also a write in only one branch of an if/else that each leave the array owned.

struct H {
    n: u32,
}

fn mk(n: u32) -> H {
    H { n: n }
}

fn eat(hs: [2]H) -> u32 {
    hs[0].n + hs[1].n
}

fn main() -> i32 {
    let mut hs: [2]H = [mk(1u32), mk(1u32)];
    let mut i: usize = 0;
    let mut s: u32 = 0u32;
    while i < 3 {
        hs[i % 2].n = hs[i % 2].n + 1u32;
        s = s + eat(hs);
        hs = [mk(1u32), mk(0u32)];
        hs[1] = mk(1u32);
        i = i + 1;
    }
    print_int(s as i64);
    print("\n");

    let mut ks: [2]H = [mk(1u32), mk(1u32)];
    let c: i32 = 4;
    if c > 2 {
        let t = eat(ks);
        ks = [mk(t), mk(0u32)];
    } else {
        ks[0].n = 9u32;
    }
    ks[1].n = 2u32;
    print_int(ks[1].n as i64);
    print("\n");
    0
}
