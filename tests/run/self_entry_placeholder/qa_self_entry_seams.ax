// test: run
// modes: interp native
// covers: REQ-TST-072
// stdout: qa-seams: 511 | 1002 1109 1205 2704 1024 2748 | 2001 2101 2016 2116\n

module near_miss

// Near-miss `@lang(...)` attributes and unmarked functions must remain ordinary functions.
@lang("self_entry_x")
fn __ax_thread_self_entry(ctx: *mut u8) -> i64 {
    let _ = ctx;
    101i64
}

@lang("self")
fn short_lang(ctx: *mut u8) -> i64 {
    let _ = ctx;
    102i64
}

@lang("self_entr")
fn off_by_one_lang(ctx: *mut u8) -> i64 {
    let _ = ctx;
    103i64
}

fn unmarked_plain(ctx: *mut u8) -> i64 {
    let _ = ctx;
    104i64
}

pub fn run_near_miss<T>() -> i64 {
    let f1: fn(*mut u8) -> i64 = __ax_thread_self_entry;
    let f2: fn(*mut u8) -> i64 = short_lang;
    let f3: fn(*mut u8) -> i64 = off_by_one_lang;
    let f4: fn(*mut u8) -> i64 = unmarked_plain;
    let rep: [2]fn(*mut u8) -> i64 = [__ax_thread_self_entry; 2];
    let p = 0 as *mut u8;
    f1(p) + f2(p) + f3(p) + f4(p) + rep[1](p)
}

module seam_a

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

// Stacked attributes: `@lang("self_entry")` is the second attribute in the list.
@lang("ignored_first_tag")
@lang("self_entry")
fn __ax_thread_self_entry(ctx: *mut u8) -> i64 {
    let _ = ctx;
    -111i64
}

struct HolderA {
    cb: fn(*mut u8) -> i64,
    tag: i64,
}

unsafe fn tramp_a<T>(raw: *mut (u32, T)) -> i64 {
    let p = raw as *mut u32;
    let st = *p;
    let sz = size_of<T>() as i64;
    if st == 0u32 {
        *p = 10u32;
        return __ax_thread_self_entry(raw as *mut u8);
    }
    if st == 1u32 {
        *p = 11u32;
        let h = HolderA { cb: __ax_thread_self_entry, tag: 7i64 };
        let f = h.cb;
        return f(raw as *mut u8) + h.tag;
    }
    if st == 2u32 {
        *p = 12u32;
        let tup = (3i64, __ax_thread_self_entry);
        let f = tup.1;
        return f(raw as *mut u8) + tup.0;
    }
    if st == 3u32 {
        *p = 13u32;
        let arr: [2]fn(*mut u8) -> i64 = [__ax_thread_self_entry; 2];
        let f = arr[0];
        let g = arr[1];
        return f(raw as *mut u8) + g(raw as *mut u8);
    }
    if st == 10u32 {
        return 1000i64 + sz;
    }
    if st == 11u32 {
        return 1100i64 + sz;
    }
    if st == 12u32 {
        return 1200i64 + sz;
    }
    if st == 13u32 {
        *p = 14u32;
        return 1300i64 + sz;
    }
    1400i64 + sz
}

pub fn run_a<T>(mode: u32) -> i64 {
    let mut st: u32 = mode;
    unsafe { tramp_a<T>(address_of_mut<u32>(st) as *mut (u32, T)) }
}

module seam_b

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

@lang("self_entry")
fn __ax_thread_self_entry(ctx: *mut u8) -> i64 {
    let _ = ctx;
    -222i64
}

unsafe fn tramp_b<T>(raw: *mut (u32, T)) -> i64 {
    let p = raw as *mut u32;
    let st = *p;
    let sz = size_of<T>() as i64;
    if st == 0u32 {
        *p = 20u32;
        let arr: [2]fn(*mut u8) -> i64 = [__ax_thread_self_entry, __ax_thread_self_entry];
        let f = arr[1];
        return f(raw as *mut u8);
    }
    if st == 1u32 {
        *p = 21u32;
        return __ax_thread_self_entry(raw as *mut u8);
    }
    if st == 20u32 {
        return 2000i64 + sz;
    }
    2100i64 + sz
}

pub fn run_b<T>(mode: u32) -> i64 {
    let mut st: u32 = mode;
    unsafe { tramp_b<T>(address_of_mut<u32>(st) as *mut (u32, T)) }
}

module app

use near_miss.run_near_miss
use seam_a.run_a
use seam_b.run_b

pub fn main() -> i32 {
    print("qa-seams: ");
    print_int(run_near_miss<u64>());
    print(" | ");
    print_int(run_a<u16>(0u32));
    print(" ");
    print_int(run_a<u16>(1u32));
    print(" ");
    print_int(run_a<u16>(2u32));
    print(" ");
    print_int(run_a<u16>(3u32));
    print(" ");
    print_int(run_a<[3]i64>(0u32));
    print(" ");
    print_int(run_a<[3]i64>(3u32));
    print(" | ");
    print_int(run_b<u8>(0u32));
    print(" ");
    print_int(run_b<u8>(1u32));
    print(" ");
    print_int(run_b<[2]i64>(0u32));
    print(" ");
    print_int(run_b<[2]i64>(1u32));
    print("\n");
    0
}
