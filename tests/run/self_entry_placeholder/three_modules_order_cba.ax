// test: run
// modes: interp native
// covers: REQ-TST-072
// stdout: three: 18 26 | 202 216 | 3001 3040 3101\n

module m3

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

@lang("self_entry")
fn __ax_thread_self_entry(ctx: *mut u8) -> i64 {
    let _ = ctx;
    -3i64
}

unsafe fn m3_tramp<T>(raw: *mut (u32, T)) -> i64 {
    let p = raw as *mut u32;
    let st = *p;
    if st == 0u32 {
        *p = 1u32;
        let f = __ax_thread_self_entry;
        return f(raw as *mut u8);
    }
    if st == 2u32 {
        *p = 3u32;
        let tbl: [2]fn(*mut u8) -> i64 = [__ax_thread_self_entry; 2];
        let f = tbl[1];
        return f(raw as *mut u8);
    }
    if st == 3u32 {
        return 3100i64 + (size_of<T>() as i64);
    }
    3000i64 + (size_of<T>() as i64)
}

pub fn run_m3<T>(mode: u32) -> i64 {
    let mut st: u32 = mode;
    unsafe { m3_tramp<T>(address_of_mut<u32>(st) as *mut (u32, T)) }
}

module m2

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

@lang("self_entry")
fn __ax_thread_self_entry(ctx: *mut u8) -> i64 {
    let _ = ctx;
    -2i64
}

unsafe fn m2_tramp<T>(raw: *mut (u32, T)) -> i64 {
    let p = raw as *mut u32;
    if *p == 0u32 {
        *p = 1u32;
        let pair = (__ax_thread_self_entry, 0i64);
        let f = pair.0;
        return f(raw as *mut u8);
    }
    200i64 + (size_of<T>() as i64)
}

pub fn run_m2<T>() -> i64 {
    let mut st: u32 = 0u32;
    unsafe { m2_tramp<T>(address_of_mut<u32>(st) as *mut (u32, T)) }
}

module m1

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

@lang("self_entry")
fn __ax_thread_self_entry(ctx: *mut u8) -> i64 {
    let _ = ctx;
    -1i64
}

unsafe fn m1_tramp<T>(raw: *mut (u32, T)) -> i64 {
    let p = raw as *mut u32;
    if *p == 0u32 {
        *p = 1u32;
        let f = __ax_thread_self_entry;
        return f(raw as *mut u8);
    }
    10i64 + (size_of<T>() as i64)
}

pub fn run_m1<T>() -> i64 {
    let mut st: u32 = 0u32;
    unsafe { m1_tramp<T>(address_of_mut<u32>(st) as *mut (u32, T)) }
}

module main_mod

use m1.run_m1
use m2.run_m2
use m3.run_m3

pub fn main() -> i32 {
    print("three: ");
    print_int(run_m1<i64>());
    print(" ");
    print_int(run_m1<[2]i64>());
    print(" | ");
    print_int(run_m2<u16>());
    print(" ");
    print_int(run_m2<[4]u32>());
    print(" | ");
    print_int(run_m3<u8>(0u32));
    print(" ");
    print_int(run_m3<[5]i64>(0u32));
    print(" ");
    print_int(run_m3<u8>(2u32));
    print("\n");
    0
}
