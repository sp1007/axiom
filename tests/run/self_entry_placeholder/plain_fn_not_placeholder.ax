// test: run
// modes: interp native
// covers: REQ-TST-072
// stdout: plain: 52 94 777 508 333 904\n

module plain_only

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

// Plain functions named `__ax_thread_self_entry` and `__ax_fiber_self_entry` WITHOUT `@lang("self_entry")`
// must behave as ordinary functions even when referenced from a generic function.
fn __ax_thread_self_entry(ctx: *mut u8) -> i64 {
    unsafe { *(ctx as *const i64) + 42i64 }
}

fn __ax_fiber_self_entry(ctx: *mut u8) -> i64 {
    unsafe { *(ctx as *const i64) + 84i64 }
}

pub fn call_plain_from_generic<T>(base: i64) -> (i64, i64) {
    let mut x: i64 = base;
    let p = unsafe { address_of_mut<i64>(x) as *mut u8 };
    let f1: fn(*mut u8) -> i64 = __ax_thread_self_entry;
    let f2: fn(*mut u8) -> i64 = __ax_fiber_self_entry;
    (f1(p), f2(p))
}

module other_lang

// A different `@lang(...)` tag must not trigger self-entry rewriting.
@lang("not_self_entry")
fn __ax_thread_self_entry(ctx: *mut u8) -> i64 {
    let _ = ctx;
    777i64
}

pub fn call_other_lang<T>() -> i64 {
    let f: fn(*mut u8) -> i64 = __ax_thread_self_entry;
    f(0 as *mut u8)
}

module marked_custom

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

// Arbitrary placeholder name with `@lang("self_entry")` alongside an unmarked `__ax_thread_self_entry`
// in the very same module.
@lang("self_entry")
fn arbitrary_hook_name(ctx: *mut u8) -> i64 {
    let _ = ctx;
    -500i64
}

fn __ax_thread_self_entry(ctx: *mut u8) -> i64 {
    let _ = ctx;
    333i64
}

unsafe fn custom_tramp<T>(raw: *mut (u32, T)) -> i64 {
    let p = raw as *mut u32;
    if *p == 0u32 {
        *p = 1u32;
        let self_fn = arbitrary_hook_name;
        return self_fn(raw as *mut u8);
    }
    500i64 + (size_of<T>() as i64)
}

pub fn run_custom_and_plain<T>() -> (i64, i64) {
    let mut st: u32 = 0u32;
    let r_self = unsafe { custom_tramp<T>(address_of_mut<u32>(st) as *mut (u32, T)) };
    let plain_fn: fn(*mut u8) -> i64 = __ax_thread_self_entry;
    let r_plain = plain_fn(0 as *mut u8);
    (r_self, r_plain)
}

module marked_std_name

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

@lang("self_entry")
fn __ax_thread_self_entry(ctx: *mut u8) -> i64 {
    let _ = ctx;
    -900i64
}

unsafe fn std_tramp<T>(raw: *mut (u32, T)) -> i64 {
    let p = raw as *mut u32;
    if *p == 0u32 {
        *p = 1u32;
        let f = __ax_thread_self_entry;
        return f(raw as *mut u8);
    }
    900i64 + (size_of<T>() as i64)
}

pub fn run_std_name<T>() -> i64 {
    let mut st: u32 = 0u32;
    unsafe { std_tramp<T>(address_of_mut<u32>(st) as *mut (u32, T)) }
}

module app

use plain_only.call_plain_from_generic
use other_lang.call_other_lang
use marked_custom.run_custom_and_plain
use marked_std_name.run_std_name

pub fn main() -> i32 {
    let p = call_plain_from_generic<u64>(10i64);
    let o = call_other_lang<u64>();
    let c = run_custom_and_plain<i64>();
    let s = run_std_name<u32>();
    print("plain: ");
    print_int(p.0);
    print(" ");
    print_int(p.1);
    print(" ");
    print_int(o);
    print(" ");
    print_int(c.0);
    print(" ");
    print_int(c.1);
    print(" ");
    print_int(s);
    print("\n");
    0
}
