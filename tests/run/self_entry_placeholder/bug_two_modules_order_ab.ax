// test: run
// modes: interp native
// covers: REQ-TST-072
// stdout: Xin chào thế giới: 108 1116 124 1148 | 204 2208 216 2232\n

module alpha

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

@lang("self_entry")
fn __ax_thread_self_entry(ctx: *mut u8) -> i64 {
    let _ = ctx;
    -999i64
}

@repr(C)
pub struct AlphaSlot {
    pub phase: u32,
    pub pad: u32,
    pub entry: fn(*mut u8) -> i64,
    pub out: i64,
}

fn invoke_alpha(f: fn(*mut u8) -> i64, raw: *mut u8) -> i64 {
    f(raw)
}

unsafe fn alpha_tramp<T>(raw_typed: *mut (AlphaSlot, T)) -> i64 {
    let raw = raw_typed as *mut u8;
    let s = raw as *mut AlphaSlot;
    let ph = (*s).phase;
    let sz = size_of<T>() as i64;
    if ph == 0u32 {
        (*s).entry = __ax_thread_self_entry;
        (*s).phase = 1u32;
        return invoke_alpha(__ax_thread_self_entry, raw);
    }
    if ph == 1u32 {
        (*s).phase = 2u32;
        let v = 100i64 + sz;
        (*s).out = v;
        return v;
    }
    let v = (*s).out + 1000i64 + sz;
    (*s).out = v;
    v
}

pub fn run_alpha<T>() -> (i64, i64) {
    let mut slot = AlphaSlot {
        phase: 0u32,
        pad: 0u32,
        entry: __ax_thread_self_entry,
        out: -1i64,
    };
    let r1 = unsafe { alpha_tramp<T>(address_of_mut<AlphaSlot>(slot) as *mut (AlphaSlot, T)) };
    let saved = slot.entry;
    let r2 = unsafe { saved(address_of_mut<AlphaSlot>(slot) as *mut u8) };
    (r1, r2)
}

module beta

@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

@lang("self_entry")
fn __ax_thread_self_entry(ctx: *mut u8) -> i64 {
    let _ = ctx;
    -888i64
}

@repr(C)
pub struct BetaSlot {
    pub phase: u32,
    pub pad: u32,
    pub entry: fn(*mut u8) -> i64,
    pub out: i64,
}

fn invoke_beta(f: fn(*mut u8) -> i64, raw: *mut u8) -> i64 {
    f(raw)
}

unsafe fn beta_tramp<T>(raw_typed: *mut (BetaSlot, T)) -> i64 {
    let raw = raw_typed as *mut u8;
    let s = raw as *mut BetaSlot;
    let ph = (*s).phase;
    let sz = size_of<T>() as i64;
    if ph == 0u32 {
        (*s).entry = __ax_thread_self_entry;
        (*s).phase = 1u32;
        return invoke_beta(__ax_thread_self_entry, raw);
    }
    if ph == 1u32 {
        (*s).phase = 2u32;
        let v = 200i64 + sz;
        (*s).out = v;
        return v;
    }
    let v = (*s).out + 2000i64 + sz;
    (*s).out = v;
    v
}

pub fn run_beta<T>() -> (i64, i64) {
    let mut slot = BetaSlot {
        phase: 0u32,
        pad: 0u32,
        entry: __ax_thread_self_entry,
        out: -1i64,
    };
    let r1 = unsafe { beta_tramp<T>(address_of_mut<BetaSlot>(slot) as *mut (BetaSlot, T)) };
    let saved = slot.entry;
    let r2 = unsafe { saved(address_of_mut<BetaSlot>(slot) as *mut u8) };
    (r1, r2)
}

module app

use alpha.run_alpha
use beta.run_beta

pub fn main() -> i32 {
    let a1 = run_alpha<i64>();
    let a2 = run_alpha<[3]i64>();
    let b1 = run_beta<u32>();
    let b2 = run_beta<[2]i64>();
    print("Xin chào thế giới: ");
    print_int(a1.0);
    print(" ");
    print_int(a1.1);
    print(" ");
    print_int(a2.0);
    print(" ");
    print_int(a2.1);
    print(" | ");
    print_int(b1.0);
    print(" ");
    print_int(b1.1);
    print(" ");
    print_int(b2.0);
    print(" ");
    print_int(b2.1);
    print("\n");
    0
}
