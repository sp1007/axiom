// test: run
// modes: interp native
// stdout: 107 205 73 94\n
// exit: 42
// covers: REQ-TST-072
// QA T423d adversarial: mixing impl-level and method-level generics in the same bound
// (`impl<A> S<A> { fn mix<B, F: FnOnce<A, B, (A, B)>> }`), calling it from inside ANOTHER
// generic `impl<X, Y> Caller<X, Y>` (verifying `cx.current_impl` save/restore and no param
// index leakage), and calling a reordered `impl<A, B> Flipped<B, A>` from inside `Caller<X, Y>`.

struct S<A> {
    pub a: A,
}

impl<A> S<A> {
    pub fn mix<B, F: FnOnce<A, B, (A, B)>>(self: S<A>, b: B, f: F) -> (A, B) {
        f(self.a, b)
    }

    pub fn mix_where<B, F>(self: S<A>, b: B, f: F) -> (B, A)
    where
        F: FnOnce<B, A, (B, A)>
    {
        f(b, self.a)
    }
}

struct Flipped<P, Q> {
    pub first: P,
    pub second: Q,
}

impl<A, B> Flipped<B, A> {
    pub fn combine<F: FnOnce<A, B, i64>>(self: Flipped<B, A>, f: F) -> i64 {
        f(self.second, self.first)
    }
}

struct Caller<X, Y> {
    pub x: X,
    pub y: Y,
}

impl<X, Y> Caller<X, Y> {
    pub fn run_cross<G: FnOnce<X, Y, i64>>(self: Caller<X, Y>, g: G) -> i64 {
        let sx: S<X> = S<X> { a: self.x };
        let p1: (X, Y) = sx.mix<Y>(self.y, |a: X, b: Y| -> (X, Y) { (a, b) });
        let sy: S<Y> = S<Y> { a: p1.1 };
        let p2: (X, Y) = sy.mix_where<X>(p1.0, |b: X, a: Y| -> (X, Y) { (b, a) });
        g(p2.0, p2.1)
    }

    pub fn run_flipped(self: Caller<X, Y>, f: fn(Y, X) -> i64) -> i64 {
        let fl: Flipped<X, Y> = Flipped<X, Y> { first: self.x, second: self.y };
        fl.combine(f)
    }
}

fn score_flipped(y: i64, x: bool) -> i64 {
    if x { y + 50i64 } else { y + 10i64 }
}

pub fn main() -> i32 {
    let s1: S<i64> = S<i64> { a: 100i64 };
    let r1_pair: (i64, bool) = s1.mix(true, |n: i64, flag: bool| -> (i64, bool) {
        if flag { (n + 7i64, flag) } else { (n, flag) }
    });
    let r1: i64 = r1_pair.0;

    let s2: S<bool> = S<bool> { a: true };
    let r2_pair: (i64, bool) = s2.mix_where(200i64, |n: i64, flag: bool| -> (i64, bool) {
        if flag { (n + 5i64, flag) } else { (n, flag) }
    });
    let r2: i64 = r2_pair.0;

    let c1: Caller<i64, bool> = Caller<i64, bool> { x: 70i64, y: true };
    let r3: i64 = c1.run_cross(|xv: i64, yv: bool| -> i64 {
        if yv { xv + 3i64 } else { xv }
    });

    let c2: Caller<bool, i64> = Caller<bool, i64> { x: true, y: 44i64 };
    let r4: i64 = c2.run_flipped(score_flipped);

    print_int(r1); print(" ");
    print_int(r2); print(" ");
    print_int(r3); print(" ");
    print_int(r4); print("\n");

    if r1 == 107i64 && r2 == 205i64 && r3 == 73i64 && r4 == 94i64 {
        42
    } else {
        1
    }
}
