// test: run
// modes: interp native
// stdout: 35 1 70 55 88 64\n
// exit: 42
// covers: REQ-TST-072
// T423d: two impl generics in a single method bound (`F: FnOnce<A, R>`), reordered impl generics on the
// self type (`impl<A, B> Flipped<B, A>`), and impl generics nested inside generic type constructors inside
// a method bound (`F: FnOnce<Option<R>>`, `where F: FnOnce<Result<R, i32>>`, and `F: FnOnce<Option<(A, R)>>`).

struct Mapper<A, R> {
    pub input: A,
}

impl<A, R> Mapper<A, R> {
    pub fn apply<F: FnOnce<A, R>>(self: Mapper<A, R>, f: F) -> R {
        f(self.input)
    }

    pub fn apply_where<F>(self: Mapper<A, R>, f: F) -> R where F: FnOnce<A, R> {
        f(self.input)
    }

    pub fn produce_opt_pair<F: FnOnce<Option<(A, R)>>>(self: Mapper<A, R>, dflt: R, f: F) -> (A, R) {
        match f() {
            Option.Some(p) => p,
            Option.None => (self.input, dflt),
        }
    }
}

struct Flipped<X, Y> {
    pub left: X,
    pub right: Y,
}

impl<A, B> Flipped<B, A> {
    pub fn combine<F: FnOnce<A, B, i64>>(self: Flipped<B, A>, f: F) -> i64 {
        f(self.right, self.left)
    }
}

struct OptBox<R> {
    pub dflt: R,
}

impl<R> OptBox<R> {
    pub fn build<F: FnOnce<Option<R>>>(self: OptBox<R>, f: F) -> R {
        match f() {
            Option.Some(v) => v,
            Option.None => self.dflt,
        }
    }

    pub fn build_res<F>(self: OptBox<R>, f: F) -> R where F: FnOnce<Result<R, i32>> {
        match f() {
            Result.Ok(v) => v,
            Result.Err(_) => self.dflt,
        }
    }
}

pub fn main() -> i32 {
    let m1: Mapper<i64, i64> = Mapper<i64, i64> { input: 5i64 };
    let r1: i64 = m1.apply(|x: i64| -> i64 { x * 7i64 });

    let m2: Mapper<i64, bool> = Mapper<i64, bool> { input: 9i64 };
    let r2: bool = m2.apply_where(|x: i64| -> bool { x > 3i64 });
    let r2_i: i64 = if r2 { 1i64 } else { 0i64 };

    let fl: Flipped<bool, i64> = Flipped<bool, i64> { left: true, right: 60i64 };
    let r3: i64 = fl.combine(|a: i64, b: bool| -> i64 {
        if b { a + 10i64 } else { a }
    });

    let ob1: OptBox<i64> = OptBox<i64> { dflt: 11i64 };
    let r4: i64 = ob1.build(|| -> Option<i64> { Option.Some(55i64) });

    let ob2: OptBox<i64> = OptBox<i64> { dflt: 88i64 };
    let r5: i64 = ob2.build_res(|| -> Result<i64, i32> { Result.Err(3i32) });

    let m3: Mapper<i64, i64> = Mapper<i64, i64> { input: 10i64 };
    let pair6: (i64, i64) = m3.produce_opt_pair(0i64, || -> Option<(i64, i64)> {
        Option.Some((24i64, 40i64))
    });
    let r6: i64 = pair6.0 + pair6.1;

    print_int(r1); print(" ");
    print_int(r2_i); print(" ");
    print_int(r3); print(" ");
    print_int(r4); print(" ");
    print_int(r5); print(" ");
    print_int(r6); print("\n");

    if r1 == 35i64 && r2_i == 1i64 && r3 == 70i64 && r4 == 55i64 && r5 == 88i64 && r6 == 64i64 {
        42
    } else {
        1
    }
}
