// test: run
// modes: interp native
// stdout: 42 1 30 99 17 32\n
// exit: 42
// covers: REQ-TST-072
// T423d: inline and `where`-clause callable bounds on methods naming an enclosing `impl`'s generic parameter,
// including calling `f()` inside the method body, capturing closures, function items, `Fn`/`FnMut`, and
// forward calls from `main` to an `impl` declared later in the file.

struct Pair {
    pub a: i64,
    pub b: i64,
}

struct W<R> {
    pub v: R,
}

impl<R> W<R> {
    pub fn mk<F: FnOnce<R>>(f: F) -> W<R> {
        W<R> { v: f() }
    }

    pub fn mk_where<F>(f: F) -> W<R> where F: FnOnce<R> {
        W<R> { v: f() }
    }

    pub fn sum_twice<F>(mut f: F) -> (R, R) where F: FnMut<R> {
        let first: R = f();
        let second: R = f();
        (first, second)
    }
}

fn make_seventeen() -> i64 {
    17i64
}

pub fn main() -> i32 {
    let base: i64 = 40i64;
    let w1: W<i64> = W<i64>.mk(|| -> i64 { base + 2i64 });
    let w2: W<bool> = W<bool>.mk_where(|| -> bool { base == 40i64 });
    let w3: W<Pair> = W<Pair>.mk(|| -> Pair { Pair { a: 12i64, b: 18i64 } });
    let w4: AfterMain<i64> = AfterMain<i64>.create(|| -> i64 { 99i64 });
    let w5: W<i64> = W<i64>.mk_where(make_seventeen);

    let mut step: i64 = 10i64;
    let tup: (i64, i64) = W<i64>.sum_twice(|| -> i64 {
        step = step + 4i64;
        step
    });
    let pair_sum: i64 = w3.v.a + w3.v.b;
    let mut_sum: i64 = tup.0 + tup.1;
    let b_int: i64 = if w2.v { 1i64 } else { 0i64 };

    print_int(w1.v); print(" ");
    print_int(b_int); print(" ");
    print_int(pair_sum); print(" ");
    print_int(w4.item); print(" ");
    print_int(w5.v); print(" ");
    print_int(mut_sum); print("\n");

    if w1.v == 42i64 && b_int == 1i64 && pair_sum == 30i64 && w4.item == 99i64 && w5.v == 17i64 && mut_sum == 32i64 {
        42
    } else {
        1
    }
}

struct AfterMain<R> {
    pub item: R,
}

impl<R> AfterMain<R> {
    pub fn create<F: FnOnce<R>>(f: F) -> AfterMain<R> {
        let local_copy: F = f;
        AfterMain<R> { item: local_copy() }
    }
}
