// test: run
// modes: interp native
// stdout: 19 23 11 77 52 31\n
// exit: 42
// covers: REQ-TST-072
// T423d: call sites with inferred receiver and method type arguments (`let w: W<i64> = W.mk(|| { 19i64 })`,
// `let w2 = W.mk(|| -> i64 { 23i64 })` followed by `.get()`) and explicit receiver + method type arguments
// (`W<i64>.mk<fn() -> i64>(fn_item)`), plus `Future<Output = R>` bound on a generic impl method.

struct W<R> {
    pub val: R,
}

impl<R> W<R> {
    pub fn mk<F: FnOnce<R>>(f: F) -> W<R> {
        W<R> { val: f() }
    }

    pub fn get(self: W<R>) -> R {
        self.val
    }
}

struct Transformer<A, R> {
    pub seed: A,
}

impl<A, R> Transformer<A, R> {
    pub fn run<F: FnOnce<A, R>>(self: Transformer<A, R>, f: F) -> R {
        f(self.seed)
    }
}

struct ReadyI64 {
    pub x: i64,
}

impl Future for ReadyI64 {
    type Output = i64;
    fn poll(self: mut_view<ReadyI64>, cx: mut_view<Context>) -> Poll<i64> {
        let _ = cx;
        Poll.Ready(self.x)
    }
}

struct Runner<R> {
    pub dflt: R,
}

impl<R> Runner<R> {
    pub fn drive<F: Future<Output = R>>(self: Runner<R>, mut fut: F) -> R {
        let rw = RawWaker { data: 0 as *const u8, vtable: 0 as *const RawWakerVTable };
        let w = Waker { raw: rw };
        let mut cx = Context { waker_val: w };
        match fut.poll(mut_view(cx)) {
            Poll.Ready(v) => v,
            Poll.Pending => self.dflt,
        }
    }
}

fn seventy_seven() -> i64 {
    77i64
}

fn quad(x: i64) -> i64 {
    x * 4i64
}

pub fn main() -> i32 {
    let w1: W<i64> = W.mk(|| { 19i64 });
    let w2 = W.mk(|| -> i64 { 23i64 });
    let v2: i64 = w2.get();
    let w3 = W<i64>.mk(|| { 11i64 });
    let w4: W<i64> = W<i64>.mk<fn() -> i64>(seventy_seven);

    let tr = Transformer<i64, i64> { seed: 13i64 };
    let v5: i64 = tr.run<fn(i64) -> i64>(quad);

    let rn = Runner<i64> { dflt: 0i64 };
    let v6: i64 = rn.drive(ReadyI64 { x: 31i64 });

    print_int(w1.val); print(" ");
    print_int(v2); print(" ");
    print_int(w3.val); print(" ");
    print_int(w4.val); print(" ");
    print_int(v5); print(" ");
    print_int(v6); print("\n");

    if w1.val == 19i64 && v2 == 23i64 && w3.val == 11i64 && w4.val == 77i64 && v5 == 52i64 && v6 == 31i64 {
        42
    } else {
        1
    }
}
