// test: run
// modes: interp native
// stdout: 25 48 91 63\n
// exit: 42
// covers: REQ-TST-072
// T423d: trait impl methods whose method-level generic bounds name the impl/trait generic parameter
// (`impl<T> Sink<T> for Bucket<T> { fn accept<U: IntoVal<T>>(...) }`, `impl<Tag, T> Sink<T> for ...`,
// callable bounds on trait impl methods, and dispatch through a generic bound `X: Sink<i64>`).

trait IntoVal<T> {
    fn into_val(self: Self) -> T;
}

struct FromI32 {
    pub raw: i32,
}

impl IntoVal<i64> for FromI32 {
    fn into_val(self: FromI32) -> i64 {
        (self.raw as i64) + 5i64
    }
}

struct Wrap<X> {
    pub x: X,
}

impl<X> IntoVal<Option<X>> for Wrap<X> {
    fn into_val(self: Wrap<X>) -> Option<X> {
        Option.Some(self.x)
    }
}

trait Sink<T> {
    fn accept<U: IntoVal<T>>(self: view<Self>, u: U) -> T;
    fn compute<F: FnOnce<T, T>>(self: view<Self>, seed: T, f: F) -> T;
}

struct Bucket<T> {
    pub bias: T,
}

impl<T> Sink<T> for Bucket<T> {
    fn accept<U: IntoVal<T>>(self: view<Bucket<T>>, u: U) -> T {
        let _ = self;
        u.into_val()
    }

    fn compute<F: FnOnce<T, T>>(self: view<Bucket<T>>, seed: T, f: F) -> T {
        let _ = self;
        f(seed)
    }
}

struct TaggedBucket<Tag, T> {
    pub tag: Tag,
    pub fallback: T,
}

impl<Tag, T> Sink<T> for TaggedBucket<Tag, T> {
    fn accept<U: IntoVal<T>>(self: view<TaggedBucket<Tag, T>>, u: U) -> T {
        let _ = self;
        u.into_val()
    }

    fn compute<F: FnOnce<T, T>>(self: view<TaggedBucket<Tag, T>>, seed: T, f: F) -> T {
        let _ = self;
        f(seed)
    }
}

fn through_trait_bound<S: Sink<i64>>(s: view<S>) -> i64 {
    let a: i64 = s.accept(FromI32 { raw: 50i32 });
    s.compute(a, |v: i64| -> i64 { v + 8i64 })
}

pub fn main() -> i32 {
    let b: Bucket<i64> = Bucket<i64> { bias: 0i64 };
    let v1: i64 = view(b).accept(FromI32 { raw: 20i32 });
    let v2: i64 = view(b).compute(16i64, |n: i64| -> i64 { n * 3i64 });

    let tb: TaggedBucket<u8, Option<i64>> = TaggedBucket<u8, Option<i64>> {
        tag: 1u8,
        fallback: Option.None,
    };
    let opt_v: Option<i64> = view(tb).accept(Wrap<i64> { x: 91i64 });
    let v3: i64 = match opt_v {
        Option.Some(k) => k,
        Option.None => 0i64,
    };

    let v4: i64 = through_trait_bound(view(b));

    print_int(v1); print(" ");
    print_int(v2); print(" ");
    print_int(v3); print(" ");
    print_int(v4); print("\n");

    if v1 == 25i64 && v2 == 48i64 && v3 == 91i64 && v4 == 63i64 {
        42
    } else {
        1
    }
}
