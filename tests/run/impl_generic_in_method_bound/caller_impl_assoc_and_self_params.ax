// test: run
// modes: interp native
// stdout: 62 50 169 88\n
// exit: 42
// covers: REQ-TST-072
// T423d (QA F1 regression): calling `W<Y>.mk(|| -> Y { ... })` and `W.mk(...)` from inside
// `impl<X, Y> Caller<X, Y>`, methods whose `Self` contains caller `TY_PARAM`s (`W<Y>`,
// `Pair<X, Y>`, and trait `Self` on `U: WithSelf<Y>`), plus non-generic `impl` / `trait`
// methods with swapped caller `TY_PARAM` slices (`[Y, X]`) and reordered `impl<A, B> RevPair<B, A>`.

struct W<R> {
    pub val: R,
}

impl<R> W<R> {
    pub fn mk<F: FnOnce<R>>(f: F) -> W<R> {
        W<R> { val: f() }
    }

    pub fn map_self<F: FnOnce<view<Self>, R>>(self: Self, f: F) -> (Self, R) {
        let out: R = f(view(self));
        (self, out)
    }
}

struct Pair<A, B> {
    pub a: A,
    pub b: B,
}

impl<A, B> Pair<A, B> {
    pub fn swapped(self: Pair<A, B>) -> (B, A) {
        (self.b, self.a)
    }
}

trait WithSelf<R> {
    fn fold_self<F: FnOnce<view<Self>, R>>(self: Self, f: F) -> (Self, R);
}

impl<P, Q> WithSelf<Q> for Pair<P, Q> {
    fn fold_self<F: FnOnce<view<Pair<P, Q>>, Q>>(self: Pair<P, Q>, f: F) -> (Pair<P, Q>, Q) {
        let out: Q = f(view(self));
        (self, out)
    }
}

trait ExtractTwo<A, B> {
    fn extract_two(self: Self) -> (Self, A, B);
}

struct Token {
    pub k: i64,
}

impl ExtractTwo<i64, bool> for Token {
    fn extract_two(self: Token) -> (Token, i64, bool) {
        let kv: i64 = self.k;
        (self, kv + 9i64, kv > 0i64)
    }
}

struct RevPair<P, Q> {
    pub first: P,
    pub second: Q,
}

impl<A, B> RevPair<B, A> {
    pub fn second_as_a(self: RevPair<B, A>) -> A {
        self.second
    }

    pub fn first_as_b(self: RevPair<B, A>) -> B {
        self.first
    }
}

struct Caller<X, Y> {
    pub x: X,
    pub y: Y,
}

impl<X, Y> Caller<X, Y> {
    pub fn make_via_assoc(self: Caller<X, Y>, y_extra: Y) -> (X, Y, Y) {
        let x_val: X = self.x;
        let y_val: Y = self.y;
        let wy1: W<Y> = W<Y>.mk(|| -> Y { y_val });
        let wy1_v: Y = wy1.val;
        let wy2: W<Y> = W.mk(|| { wy1_v });
        let mapped: (W<Y>, Y) = wy2.map_self(|_w: view<W<Y>>| -> Y { y_extra });
        let wx: W<X> = W<X>.mk(|| -> X { x_val });
        (wx.val, mapped.0.val, mapped.1)
    }

    pub fn fold_self_all<U: WithSelf<Y>>(self: Caller<X, Y>, u: U, y2: Y) -> (X, Y, Y) {
        let p: Pair<X, Y> = Pair<X, Y> { a: self.x, b: self.y };
        let pr: (Pair<X, Y>, Y) = p.fold_self(|_pv: view<Pair<X, Y>>| -> Y { y2 });
        let sw: (X, Y) = (Pair<Y, X> { a: pr.0.b, b: pr.0.a }).swapped();
        let sw_x: X = sw.0;
        let sw_y: Y = sw.1;
        let ur: (U, Y) = u.fold_self(|_uv: view<U>| -> Y { sw_y });
        let _ = ur.0;
        (sw_x, pr.1, ur.1)
    }

    pub fn extract_cross<U: ExtractTwo<Y, X>>(self: Caller<X, Y>, u: U) -> (U, Y, X) {
        let _ = self;
        u.extract_two()
    }

    pub fn rev_get(self: Caller<X, Y>, y2: Y, x2: X) -> (Y, X) {
        let rp1: RevPair<X, Y> = RevPair<X, Y> { first: self.x, second: self.y };
        let rp2: RevPair<X, Y> = RevPair<X, Y> { first: x2, second: y2 };
        let a_val: Y = rp1.second_as_a();
        let b_val: X = rp2.first_as_b();
        (a_val, b_val)
    }
}

pub fn main() -> i32 {
    let c1: Caller<bool, i64> = Caller<bool, i64> { x: true, y: 31i64 };
    let t1: (bool, i64, i64) = c1.make_via_assoc(31i64);
    let v1: i64 = if t1.0 { t1.1 + t1.2 } else { 0i64 };

    let c2: Caller<bool, i64> = Caller<bool, i64> { x: true, y: 45i64 };
    let p_arg: Pair<i32, i64> = Pair<i32, i64> { a: 7i32, b: 45i64 };
    let t2: (bool, i64, i64) = c2.fold_self_all(p_arg, 45i64);
    let v2: i64 = if t2.0 && t2.2 == 45i64 { t2.1 + 5i64 } else { 0i64 };

    let c3: Caller<bool, i64> = Caller<bool, i64> { x: false, y: 0i64 };
    let t3: (Token, i64, bool) = c3.extract_cross(Token { k: 80i64 });
    let v3: i64 = if t3.2 { t3.0.k + t3.1 } else { 0i64 };

    let c4: Caller<bool, i64> = Caller<bool, i64> { x: true, y: 77i64 };
    let t4: (i64, bool) = c4.rev_get(22i64, true);
    let v4: i64 = if t4.1 { t4.0 + 11i64 } else { 0i64 };

    print_int(v1); print(" ");
    print_int(v2); print(" ");
    print_int(v3); print(" ");
    print_int(v4); print("\n");

    if v1 == 62i64 && v2 == 50i64 && v3 == 169i64 && v4 == 88i64 {
        42
    } else {
        1
    }
}
