// test: run
// exit: 0
// stdout: 1 2 3\n10 20 30 40\n1 2 3 4\n1 2\n100 200\n10 20\n
// T499c: complete matches on structs with refutable fields, bare u8/i8 ranges + or-patterns,
// char Unicode scalar domain, and full-width u128/i128 intervals.

struct Packet {
    ok: bool,
    tag: u8,
    extra: i64,
}

fn eval_packet(p: Packet) -> i64 {
    match p {
        Packet { ok: true, tag: 0u8..=127u8, extra } => extra + 1i64,
        Packet { ok: true, tag: 128u8..=255u8, extra } => extra + 2i64,
        Packet { ok: false, .. } => 3i64,
    }
}

fn eval_u8(x: u8) -> i64 {
    match x {
        0u8..10u8 => 10i64,
        10u8 | 11u8 => 20i64,
        12u8..=254u8 => 30i64,
        255u8 => 40i64,
    }
}

fn eval_i8(x: i8) -> i64 {
    match x {
        -128i8 => 1i64,
        -127i8..=0i8 => 2i64,
        1i8..=126i8 => 3i64,
        127i8 => 4i64,
    }
}

fn eval_char(c: char) -> i64 {
    match c {
        '\0'..='\u{D7FF}' => 1i64,
        '\u{E000}'..='\u{10FFFF}' => 2i64,
    }
}

fn eval_u128(x: u128) -> i64 {
    match x {
        0u128..=18446744073709551615u128 => 100i64,
        18446744073709551616u128..=340282366920938463463374607431768211455u128 => 200i64,
    }
}

fn eval_i128(x: i128) -> i64 {
    match x {
        -170141183460469231731687303715884105728i128..=-1i128 => 10i64,
        0i128..=170141183460469231731687303715884105727i128 => 20i64,
    }
}

fn main() -> i32 {
    print_int(eval_packet(Packet { ok: true, tag: 5u8, extra: 0i64 }))
    print(" ")
    print_int(eval_packet(Packet { ok: true, tag: 200u8, extra: 0i64 }))
    print(" ")
    print_int(eval_packet(Packet { ok: false, tag: 255u8, extra: 99i64 }))
    print("\n")

    print_int(eval_u8(9u8))
    print(" ")
    print_int(eval_u8(11u8))
    print(" ")
    print_int(eval_u8(100u8))
    print(" ")
    print_int(eval_u8(255u8))
    print("\n")

    print_int(eval_i8(-128i8))
    print(" ")
    print_int(eval_i8(0i8))
    print(" ")
    print_int(eval_i8(50i8))
    print(" ")
    print_int(eval_i8(127i8))
    print("\n")

    print_int(eval_char('ế'))
    print(" ")
    print_int(eval_char('\u{10FFFF}'))
    print("\n")

    print_int(eval_u128(42u128))
    print(" ")
    print_int(eval_u128(1u128 << 64))
    print("\n")

    print_int(eval_i128(-5i128))
    print(" ")
    print_int(eval_i128(5i128))
    print("\n")
    0
}
