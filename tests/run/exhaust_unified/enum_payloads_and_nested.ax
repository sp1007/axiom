// test: run
// exit: 0
// stdout: 10 20 77 0\n11 22 33\n1 2 3 4 5\n100 200 300\n
// T499c: complete matches on enums with refutable payloads, bool-payload enums without wildcard,
// nested enum-in-enum with u8 range payloads, and generic Option<OptBool> with inferred None.

enum Opt {
    None,
    Some(i64),
}

enum OptBool {
    None,
    Some(bool),
}

enum Inner {
    Leaf(bool),
    Node(u8),
}

enum Outer {
    Empty,
    Wrap(Inner),
}

fn classify_opt(o: Opt) -> i64 {
    match o {
        Opt.Some(1i64) => 10i64,
        Opt.Some(2i64) => 20i64,
        Opt.Some(x) => x + 70i64,
        Opt.None => 0i64,
    }
}

fn eval_opt_bool(o: OptBool) -> i64 {
    match o {
        OptBool.Some(true) => 11i64,
        OptBool.Some(false) => 22i64,
        OptBool.None => 33i64,
    }
}

fn eval_nested(x: Outer) -> i64 {
    match x {
        Outer.Wrap(Inner.Leaf(true)) => 1i64,
        Outer.Wrap(Inner.Leaf(false)) => 2i64,
        Outer.Wrap(Inner.Node(0u8..=127u8)) => 3i64,
        Outer.Wrap(Inner.Node(128u8..=255u8)) => 4i64,
        Outer.Empty => 5i64,
    }
}

fn eval_inferred_none() -> i64 {
    let n = Option.None
    let a = match n {
        Option.Some(OptBool.Some(true)) => 10i64,
        Option.Some(OptBool.Some(false) | OptBool.None) => 20i64,
        Option.None => 100i64,
    }
    let s1 = Option.Some(OptBool.Some(true))
    let b = match s1 {
        Option.Some(OptBool.Some(true)) => 200i64,
        Option.Some(OptBool.Some(false)) => 210i64,
        Option.Some(OptBool.None) => 220i64,
        Option.None => 230i64,
    }
    let s2 = Option.Some(OptBool.None)
    let c = match s2 {
        Option.Some(OptBool.Some(true | false)) => 290i64,
        Option.Some(OptBool.None) => 300i64,
        Option.None => 310i64,
    }
    print_int(a)
    print(" ")
    print_int(b)
    print(" ")
    print_int(c)
    print("\n")
    a + b + c
}

fn main() -> i32 {
    print_int(classify_opt(Opt.Some(1i64)))
    print(" ")
    print_int(classify_opt(Opt.Some(2i64)))
    print(" ")
    print_int(classify_opt(Opt.Some(7i64)))
    print(" ")
    print_int(classify_opt(Opt.None))
    print("\n")

    print_int(eval_opt_bool(OptBool.Some(true)))
    print(" ")
    print_int(eval_opt_bool(OptBool.Some(false)))
    print(" ")
    print_int(eval_opt_bool(OptBool.None))
    print("\n")

    print_int(eval_nested(Outer.Wrap(Inner.Leaf(true))))
    print(" ")
    print_int(eval_nested(Outer.Wrap(Inner.Leaf(false))))
    print(" ")
    print_int(eval_nested(Outer.Wrap(Inner.Node(64u8))))
    print(" ")
    print_int(eval_nested(Outer.Wrap(Inner.Node(200u8))))
    print(" ")
    print_int(eval_nested(Outer.Empty))
    print("\n")

    let _ = eval_inferred_none()
    0
}
