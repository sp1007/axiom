// test: run
// exit: 0
// stdout: 1 2 9\n10 20 20\n100 200 200\n42\n
// T499c QA boundary cross-check: complete matches on char surrogate boundaries and straddling range,
// u128 exclusive 2^64 boundary (borrow across lo/hi), i128 exclusive 0 boundary, and TY_UNIT ().

fn eval_char_bounds(c: char) -> i64 {
    match c {
        '\0'..='\u{D7FF}' => 1i64,
        '\u{E000}'..='\u{10FFFF}' => 2i64,
    }
}

fn eval_char_straddle(c: char) -> i64 {
    match c {
        '\0'..='\u{10FFFF}' => 9i64,
    }
}

fn eval_u128_excl_carry(x: u128) -> i64 {
    match x {
        0u128..18446744073709551616u128 => 10i64,
        18446744073709551616u128..=340282366920938463463374607431768211455u128 => 20i64,
    }
}

fn eval_i128_excl_zero(x: i128) -> i64 {
    match x {
        -170141183460469231731687303715884105728i128..0i128 => 100i64,
        0i128..=170141183460469231731687303715884105727i128 => 200i64,
    }
}

fn eval_unit(u: ()) -> i64 {
    match u {
        _ => 42i64,
    }
}

fn main() -> i32 {
    print_int(eval_char_bounds('\u{D7FF}'))
    print(" ")
    print_int(eval_char_bounds('\u{E000}'))
    print(" ")
    print_int(eval_char_straddle('ế'))
    print("\n")

    print_int(eval_u128_excl_carry(18446744073709551615u128))
    print(" ")
    print_int(eval_u128_excl_carry(1u128 << 64))
    print(" ")
    print_int(eval_u128_excl_carry((1u128 << 64) + 1u128))
    print("\n")

    print_int(eval_i128_excl_zero(-1i128))
    print(" ")
    print_int(eval_i128_excl_zero(0i128))
    print(" ")
    print_int(eval_i128_excl_zero(1i128))
    print("\n")

    print_int(eval_unit(()))
    print("\n")
    0
}
