// test: run
// modes: interp native
// stdout-file: workspace_cli_and_graph_introspection.stdout
// SPEC-110 §5 (AXS-BLD-040..042, REQ-PKG-024, REQ-PKG-025):
// Verifies workspace CLI subcommand semantics (`build`, `check`, `run`, `clean`,
// `graph --format=json|dot`) and exit-code discipline.

const CMD_BUILD: u8 = 0u8
const CMD_CHECK: u8 = 1u8
const CMD_RUN: u8 = 2u8
const CMD_CLEAN: u8 = 5u8
const CMD_GRAPH: u8 = 6u8

const FMT_JSON: u8 = 0u8
const FMT_DOT: u8 = 1u8
const FMT_INVALID: u8 = 255u8

fn eval_cli_exit_code(cmd: u8, bin_count: u32, has_bin_selector: bool, fmt: u8) -> i32 {
    if cmd == CMD_GRAPH {
        if fmt != FMT_JSON && fmt != FMT_DOT {
            return 2i32
        }
        return 0i32
    }
    if cmd == CMD_RUN {
        if bin_count == 0u32 {
            return 2i32
        }
        if bin_count > 1u32 && !has_bin_selector {
            return 2i32
        }
        return 0i32
    }
    0i32
}

pub fn main() -> i32 {
    let build_exit = eval_cli_exit_code(CMD_BUILD, 1u32, false, FMT_JSON)
    let check_exit = eval_cli_exit_code(CMD_CHECK, 1u32, false, FMT_JSON)
    let run_ambig_exit = eval_cli_exit_code(CMD_RUN, 2u32, false, FMT_JSON)
    let run_sel_exit = eval_cli_exit_code(CMD_RUN, 2u32, true, FMT_JSON)
    let graph_json_exit = eval_cli_exit_code(CMD_GRAPH, 1u32, false, FMT_JSON)
    let graph_dot_exit = eval_cli_exit_code(CMD_GRAPH, 1u32, false, FMT_DOT)
    let graph_bad_exit = eval_cli_exit_code(CMD_GRAPH, 1u32, false, FMT_INVALID)
    let clean_exit = eval_cli_exit_code(CMD_CLEAN, 1u32, false, FMT_JSON)

    if build_exit != 0i32 || check_exit != 0i32 || run_ambig_exit != 2i32 ||
        run_sel_exit != 0i32 || graph_json_exit != 0i32 || graph_dot_exit != 0i32 ||
        graph_bad_exit != 2i32 || clean_exit != 0i32 {
        return 1
    }

    print("WORKSPACE-CLI-AND-GRAPH-INTROSPECTION-OK\n")
    0
}
