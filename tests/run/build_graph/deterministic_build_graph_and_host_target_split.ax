// test: run
// modes: interp native
// stdout: DETERMINISTIC-BUILD-GRAPH-AND-HOST-TARGET-SPLIT-OK\n
// SPEC-110 §3 (AXS-BLD-020..025, INV-BLD-001, REQ-PKG-022):
// Verifies determinism of the compilation-unit action DAG, HOST/target cross-build
// isolation (`AX_LINK_ARTIFACT_TARGET_MISMATCH` = 220), and worker-count invariance.

@intrinsic
fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }

const ENV_TARGET: u8 = 0u8
const ENV_HOST: u8 = 1u8

const ACT_RUN_BUILD_TOOL: u8 = 0u8
const ACT_EMIT_INTERFACE: u8 = 1u8
const ACT_COMPILE_CGU: u8 = 2u8
const ACT_ASSEMBLE_ARCHIVE: u8 = 3u8
const ACT_LINK_ARTIFACT: u8 = 4u8

const AX_LINK_ARTIFACT_TARGET_MISMATCH: u32 = 220u32

@derive(Copy)
struct ActionNode {
    id: u32,
    kind: u8,
    env_class: u8,
    triple_id: u32,
    build_fingerprint: u64,
}

fn fnv1a_step(h: u64, v: u64) -> u64 {
    wrapping_mul_u64(h ^ v, 1099511628211u64)
}

fn compute_action_key(pkg_id: u64, kind: u8, env_class: u8, triple_id: u32) -> u64 {
    let mut h: u64 = 14695981039346656037u64
    h = fnv1a_step(h, pkg_id)
    h = fnv1a_step(h, kind as u64)
    h = fnv1a_step(h, env_class as u64)
    h = fnv1a_step(h, triple_id as u64)
    h
}

fn verify_link_isolation(consumer: view<ActionNode>, provider: view<ActionNode>) -> u32 {
    if provider.kind == ACT_RUN_BUILD_TOOL {
        return 0u32
    }
    if consumer.env_class != provider.env_class || consumer.triple_id != provider.triple_id {
        return AX_LINK_ARTIFACT_TARGET_MISMATCH
    }
    0u32
}

fn schedule_digest_for_jobs(nodes: view<[6]ActionNode>, jobs: u32) -> u64 {
    let _ = jobs
    let mut acc: u64 = 14695981039346656037u64
    let mut i: usize = 0usize
    while i < 6usize {
        acc = fnv1a_step(acc, (*nodes)[i].id as u64)
        acc = fnv1a_step(acc, (*nodes)[i].build_fingerprint)
        i = i + 1usize
    }
    acc
}

pub fn main() -> i32 {
    let h_triple: u32 = 1u32
    let target_triple: u32 = 2u32

    let n0 = ActionNode {
        id: 0u32,
        kind: ACT_EMIT_INTERFACE,
        env_class: ENV_HOST,
        triple_id: h_triple,
        build_fingerprint: compute_action_key(10u64, ACT_EMIT_INTERFACE, ENV_HOST, h_triple),
    }
    let n1 = ActionNode {
        id: 1u32,
        kind: ACT_ASSEMBLE_ARCHIVE,
        env_class: ENV_HOST,
        triple_id: h_triple,
        build_fingerprint: compute_action_key(10u64, ACT_ASSEMBLE_ARCHIVE, ENV_HOST, h_triple),
    }
    let n2 = ActionNode {
        id: 2u32,
        kind: ACT_RUN_BUILD_TOOL,
        env_class: ENV_HOST,
        triple_id: h_triple,
        build_fingerprint: compute_action_key(20u64, ACT_RUN_BUILD_TOOL, ENV_HOST, h_triple),
    }
    let n3 = ActionNode {
        id: 3u32,
        kind: ACT_EMIT_INTERFACE,
        env_class: ENV_TARGET,
        triple_id: target_triple,
        build_fingerprint: compute_action_key(30u64, ACT_EMIT_INTERFACE, ENV_TARGET, target_triple),
    }
    let n4 = ActionNode {
        id: 4u32,
        kind: ACT_COMPILE_CGU,
        env_class: ENV_TARGET,
        triple_id: target_triple,
        build_fingerprint: compute_action_key(30u64, ACT_COMPILE_CGU, ENV_TARGET, target_triple),
    }
    let n5 = ActionNode {
        id: 5u32,
        kind: ACT_LINK_ARTIFACT,
        env_class: ENV_TARGET,
        triple_id: target_triple,
        build_fingerprint: compute_action_key(30u64, ACT_LINK_ARTIFACT, ENV_TARGET, target_triple),
    }

    let nodes: [6]ActionNode = [n0, n1, n2, n3, n4, n5]
    let valid_iso = verify_link_isolation(view(n5), view(n4)) == 0u32 &&
                    verify_link_isolation(view(n3), view(n2)) == 0u32
    let mismatch_diag = verify_link_isolation(view(n5), view(n1))

    let d_jobs1 = schedule_digest_for_jobs(view(nodes), 1u32)
    let d_jobs8 = schedule_digest_for_jobs(view(nodes), 8u32)
    let jobs_invariant = d_jobs1 == d_jobs8 && n0.build_fingerprint != n3.build_fingerprint

    if !valid_iso || mismatch_diag != AX_LINK_ARTIFACT_TARGET_MISMATCH || !jobs_invariant {
        return 1
    }

    print("DETERMINISTIC-BUILD-GRAPH-AND-HOST-TARGET-SPLIT-OK\n")
    0
}
