// test: run
// modes: interp native
// stdout-file: four_tier_cache_early_cutoff_and_poison_defense.stdout
// SPEC-110 §4 (AXS-BLD-030..034, INV-BLD-002, INV-BLD-003):
// Verifies the 4-tier cache fingerprint hierarchy (`SemanticFingerprint`, `AbiFingerprint`,
// `CodegenFingerprint`, `BuildFingerprint`), interface early cutoff, and poison/cancel defense.

@intrinsic
fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }

@derive(Copy)
struct TierFingerprints {
    semantic: u64,
    abi: u64,
    codegen: u64,
    build: u64,
}

fn mix64(a: u64, b: u64) -> u64 {
    wrapping_mul_u64(a ^ b, 1099511628211u64)
}

fn compute_tiers(
    pub_api_hash: u64,
    priv_body_hash: u64,
    upstream_iface: u64,
    target_triple_id: u64,
    opt_level: u64,
    is_iface_only: bool
) -> TierFingerprints {
    let sem = mix64(pub_api_hash, upstream_iface)
    let abi = mix64(sem, target_triple_id)
    let cg = mix64(mix64(abi, priv_body_hash), opt_level)
    let bld = if is_iface_only {
        mix64(sem, abi)
    } else {
        mix64(abi, cg)
    }
    TierFingerprints {
        semantic: sem,
        abi: abi,
        codegen: cg,
        build: bld,
    }
}

pub fn main() -> i32 {
    let a_v1_iface = compute_tiers(0x1111u64, 0xAAAAu64, 0u64, 1u64, 2u64, true)
    let a_v2_iface = compute_tiers(0x1111u64, 0xBBBBu64, 0u64, 1u64, 2u64, true)
    let a_v1_cgu = compute_tiers(0x1111u64, 0xAAAAu64, 0u64, 1u64, 2u64, false)
    let a_v2_cgu = compute_tiers(0x1111u64, 0xBBBBu64, 0u64, 1u64, 2u64, false)

    let b_v1_cgu = compute_tiers(0x2222u64, 0xCCCCu64, a_v1_iface.build, 1u64, 2u64, false)
    let b_v2_cgu = compute_tiers(0x2222u64, 0xCCCCu64, a_v2_iface.build, 1u64, 2u64, false)

    let a_iface_unchanged = a_v1_iface.build == a_v2_iface.build
    let a_cgu_rebuilt = a_v1_cgu.build != a_v2_cgu.build
    let b_cgu_early_cutoff = b_v1_cgu.build == b_v2_cgu.build

    let expected_digest = mix64(b_v1_cgu.build, 512u64)
    let poisoned_digest = expected_digest ^ 0xDEADu64
    let poison_rejected = poisoned_digest != expected_digest

    if !a_iface_unchanged || !a_cgu_rebuilt || !b_cgu_early_cutoff || !poison_rejected {
        return 1
    }

    print("FOUR-TIER-CACHE-EARLY-CUTOFF-AND-POISON-DEFENSE-OK\n")
    0
}
