// test: run
// modes: interp native
// exit: 35

fn id_usize(x: usize) -> usize { x }
fn id_isize(x: isize) -> isize { x }

fn main() -> i32 {
    let u: usize = id_usize(3usize);
    let u_shl: usize = u << 40;
    let u_shr: usize = u_shl >> 40;

    let s: isize = id_isize(-5isize);
    let s_shl: isize = s << 40;
    let s_shr: isize = s_shl >> 40;

    if u_shl != 3298534883328usize { return 1; }
    if u_shr != 3usize { return 2; }
    if s_shl != -5497558138880isize { return 3; }
    if s_shr != -5isize { return 4; }

    // 3 * 10 + 5 == 35
    (u_shr as i32) * 10 + (0 - (s_shr as i32))
}
