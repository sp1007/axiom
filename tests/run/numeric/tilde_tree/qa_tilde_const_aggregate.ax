// test: run
// stdout: 744\n5\n-1\n-65535\n4294967040\n4294967294\n744\n127\n
// QA (T499 gate): const aggregates (array / struct initialisers, evaluated by backend_eval_const_int) whose elements are
// widening trees with `~` over a promotion cast node.  Exact Python integers: ~255+1000, ~(-1)+5, ~0, ~65535+1,
// ~255 & 0xFFFFFFFF, ~1 | 0 (u32), ~255+1000, ~(-128).
const A: [4]i64 = [~255u8 + 1000i64, ~(-1i8) + 5i64, ~0u32 + 0i64, ~65535u16 + 1i64];
const B: [2]u32 = [~255u8 & 4294967295u32, ~1u16 | 0u32];
struct P { a: i64, b: i32 }
const Q: P = P { a: ~255u8 + 1000i64, b: ~(-128i8) + 0i32 };
fn main() -> i32 {
    print_int(A[0]); print("\n");
    print_int(A[1]); print("\n");
    print_int(A[2]); print("\n");
    print_int(A[3]); print("\n");
    print_int(B[0] as i64); print("\n");
    print_int(B[1] as i64); print("\n");
    print_int(Q.a); print("\n");
    print_int(Q.b as i64); print("\n");
    0
}
