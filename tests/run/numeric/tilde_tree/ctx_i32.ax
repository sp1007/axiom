fn report(ok: bool, bits: i64) {
    if ok { print("ok "); } else { print("BAD "); }
    print_int(bits);
    print("\n");
}

fn add_u8(x: u8, k: i32) -> i32 {
    let r: i32 = ~x + k;
    r
}

fn xor_u8(x: u8, k: i32) -> i32 {
    let r: i32 = k ^ ~x;
    r
}

fn two_u8(x: u8, y: u8, k: i32) -> i32 {
    let r: i32 = (~x + ~y) * k;
    r
}

fn add_u16(x: u16, k: i32) -> i32 {
    let r: i32 = ~x + k;
    r
}

fn xor_u16(x: u16, k: i32) -> i32 {
