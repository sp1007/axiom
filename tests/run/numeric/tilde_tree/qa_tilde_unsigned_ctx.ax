// test: run
// stdout: 65520\n4294967294\n-2\n-2\n255\n4294967040\nOK qa tilde unsigned ctx\n
// QA (T499 gate): unsigned tree contexts (the generated ctx_*.ax files only cover signed contexts and usize).
// `~x` of an unsigned narrow leaf in a tree of an unsigned wider context is a zero-extension followed by the bit-not
// in the context type, e.g. ~0x0Fu8 in u16 is 0xFFF0 (65520), not 0x00F0 (240).  Exact Python integers:
//   u16:  (~15 & 0xFFFF)                   = 65520
//   u32:  (~1 & 0xFFFFFFFF)                = 4294967294
//   u64:  (~1 & 0xFFFF_FFFF_FFFF_FFFF)     = 2^64 - 2   (printed as i64: -2)
//   u128: ~1 & (2^128 - 1)                 = 2^128 - 2  (low 64 bits 2^64 - 2 -> -2 as i64, high 64 bits all ones)
fn u16_ctx(x: u8, k: u16) -> u16 {
    let r: u16 = ~x & k;
    r
}

fn u32_ctx(x: u16, k: u32) -> u32 {
    let r: u32 = ~x & k;
    r
}

fn u64_ctx(x: u32, k: u64) -> u64 {
    let r: u64 = ~x & k;
    r
}

fn u128_ctx(x: u64, k: u128) -> u128 {
    let r: u128 = ~x & k;
    r
}

fn u32_from_u8_or(x: u8, k: u32) -> u32 {
    let r: u32 = ~x | k;
    r
}

fn main() -> i32 {
    print_int(u16_ctx(15u8, 65535u16) as i64);
    print("\n");
    print_int(u32_ctx(1u16, 4294967295u32) as i64);
    print("\n");
    print_int(u64_ctx(1u32, 18446744073709551615u64) as i64);
    print("\n");
    // low 64 bits of ~1 in u128 are 0xFFFF_FFFF_FFFF_FFFE: -2 as i64
    let w: u128 = u128_ctx(1u64, 340282366920938463463374607431768211455u128);
    print_int((w & 18446744073709551615u128) as i64);
    print("\n");
    // high 64 bits of ~1u64 widened to u128 are all ones (zero-extension happens BEFORE the not): -1 as i64 would print -1,
    // so check it as a comparison to keep the expectation obvious: the u64 narrow form would give 0 here.
    if (w >> 64u32) == 18446744073709551615u128 { print("255\n"); } else { print("0\n"); }
    // ~0xFFu8 | 0 in u32 = 0xFFFFFF00
    print_int(u32_from_u8_or(255u8, 0u32) as i64);
    print("\n");
    print("OK qa tilde unsigned ctx\n");
    0
}
