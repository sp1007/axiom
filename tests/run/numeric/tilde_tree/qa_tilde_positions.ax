// test: run
// stdout: 744\n744\n744\n1000\n744\n744\n1488\n744\n744\n744\n744\n744\n2232\n744\n744\n744\n1\n
// QA (T499 gate): a `~x + y` widening tree in every position where typeck could visit a tree more than once
// (call / generic call / method / trait method arguments, struct fields, return, assignment, array element, block,
// while body, closure body and closure argument, unsafe block, condition). ~255u8 + 1000i64 == 744 everywhere.
struct S { f: i64, g: i32 }
struct W<T> { v: T }

fn take64(x: i64) -> i64 { x }
fn ident<T>(t: T) -> T { t }
fn pair<T>(a: T, b: T) -> T { b }

impl S {
    fn add(self: view<S>, k: i64) -> i64 { k + self.f }
}

trait Tw { fn tw(self: view<Self>, k: i64) -> i64; }
impl Tw for S { fn tw(self: view<S>, k: i64) -> i64 { k * 2 } }

fn call_arg(b8: u8, s64: i64) -> i64 { take64(~b8 + s64) }
fn gen_arg(b8: u8, s64: i64) -> i64 { ident(~b8 + s64) }
fn gen_arg2(b8: u8, s64: i64) -> i64 { pair(s64, ~b8 + s64) }
fn gen_arg3(b8: u8, s64: i64) -> i64 { pair(~b8 + s64, s64) }
fn field_init(b8: u8, s64: i64) -> i64 { let s = S { f: ~b8 + s64, g: 1 }; s.f }
fn method_arg(b8: u8, s64: i64) -> i64 { let s = S { f: 0, g: 1 }; s.add(~b8 + s64) }
fn trait_arg(b8: u8, s64: i64) -> i64 { let s = S { f: 0, g: 1 }; s.tw(~b8 + s64) }
fn ret_expr(b8: u8, s64: i64) -> i64 { return ~b8 + s64; }
fn assign(b8: u8, s64: i64) -> i64 {
    let mut x: i64 = 0;
    x = ~b8 + s64;
    x
}
fn arr_(b8: u8, s64: i64) -> i64 { let t: [2]i64 = [~b8 + s64, 2]; t[0] }
fn gen_struct(b8: u8, s64: i64) -> i64 { let w: W<i64> = W { v: ~b8 + s64 }; w.v }
fn block_(b8: u8, s64: i64) -> i64 { let r: i64 = { let q: i64 = 1; ~b8 + s64 + q - q }; r }
fn loop_(b8: u8, s64: i64) -> i64 {
    let mut acc: i64 = 0;
    let mut i: i32 = 0;
    while i < 3 { acc = acc + (~b8 + s64); i = i + 1; }
    acc
}
fn clos_cap(b8: u8, s64: i64) -> i64 {
    let f = |k: i64| -> i64 { ~b8 + k };
    f(s64)
}
fn clos_ret(b8: u8) -> i64 {
    let f = |k: i64| -> i64 { k };
    f(~b8 + 1000i64)
}
fn unsafe_blk(b8: u8, s64: i64) -> i64 { unsafe { ~b8 + s64 } }
fn cond(b8: u8, s64: i64) -> i64 { if (~b8 + s64) > 0 { 1 } else { 0 } }
fn main() -> i32 {
    print_int(call_arg(255u8, 1000i64)); print("\n");
    print_int(gen_arg(255u8, 1000i64)); print("\n");
    print_int(gen_arg2(255u8, 1000i64)); print("\n");
    print_int(gen_arg3(255u8, 1000i64)); print("\n");
    print_int(field_init(255u8, 1000i64)); print("\n");
    print_int(method_arg(255u8, 1000i64)); print("\n");
    print_int(trait_arg(255u8, 1000i64)); print("\n");
    print_int(ret_expr(255u8, 1000i64)); print("\n");
    print_int(assign(255u8, 1000i64)); print("\n");
    print_int(arr_(255u8, 1000i64)); print("\n");
    print_int(gen_struct(255u8, 1000i64)); print("\n");
    print_int(block_(255u8, 1000i64)); print("\n");
    print_int(loop_(255u8, 1000i64)); print("\n");
    print_int(clos_cap(255u8, 1000i64)); print("\n");
    print_int(clos_ret(255u8)); print("\n");
    print_int(unsafe_blk(255u8, 1000i64)); print("\n");
    print_int(cond(255u8, 1000i64)); print("\n");
    0
}
