// test: run
// stdout: 744\n744\n-1\n0\n0\n255\n-256\nOK tilde const\n
// T499 (ADR-0044 section 2): compile-time evaluation of a widening tree with `~` agrees with run time, and a `~x`
// outside a widening tree keeps the operand type.
//   K1: ~255u8 in i64 = -256; -256 + 1000 = 744 (const evaluator)
//   K2: a const operand of type u8 used in a run-time i64 tree: same value
//   K3: ~0u8 in i64 = -1 (i64 + IntVar context through a u8 leaf)
//   standalone ~255u8 is 0 in u8; `(~b8) as i64` is a cast of the u8 result, not a tree: 0
//   `~(b8 as i64)` written explicitly: -256
const K1: i64 = ~255u8 + 1000;
const B8: u8 = 255u8;
const K3: i64 = ~0u8 + 0;

fn standalone(b8: u8) -> u8 {
    let r: u8 = ~b8;
    r
}

fn main() -> i32 {
    print_int(K1);
    print("\n");
    let s64: i64 = 1000;
    let k2: i64 = ~B8 + s64;
    print_int(k2);
    print("\n");
    print_int(K3);
    print("\n");
    print_int(standalone(255u8) as i64);
    print("\n");
    let b8: u8 = 255u8;
    let c: i64 = (~b8) as i64;
    print_int(c);
    print("\n");
    let z: u8 = ~0u8;
    print_int(z as i64);
    print("\n");
    print_int(~(b8 as i64));
    print("\n");
    print("OK tilde const\n");
    0
}
