// test: run
// stdout: 4294967040\n1127\n5\n65520\n-32768\n255\n-2\n-792\n5\n
// QA (T499 gate): const items (and a const array length) whose initialiser is a widening tree with `~`.  Exact Python
// integers; each value is the tree evaluated in the context type: ~255 & 0xFFFFFFFF (u32), ~(-128) + 1000 (i64),
// ~(-1) + 5, ~15 & 0xFFFF (u16), ~32767 (i32), ~~255, ~1 & (2^64-1) printed as i64, ~255 ^ 1000 (i128), (~250 & 255) = 5.
const C1: u32 = ~255u8 & 4294967295u32;
const C2: i64 = ~(-128i8) + 1000i64;
const C3: i64 = ~(-1i8) + 5i64;
const C4: u16 = ~15u8 & 65535u16;
const C5: i32 = ~(32767i16) + 0i32;
const C6: i64 = ~~255u8 + 0i64;
const C7: u64 = ~1u32 & 18446744073709551615u64;
const C8: i128 = ~(255u8) ^ 1000i128;
const N: usize = (~250u8 & 255usize);
const BIG: [N]u8 = [1u8, 2u8, 3u8, 4u8, 5u8];

fn main() -> i32 {
    print_int(C1 as i64); print("\n");
    print_int(C2); print("\n");
    print_int(C3); print("\n");
    print_int(C4 as i64); print("\n");
    print_int(C5 as i64); print("\n");
    print_int(C6); print("\n");
    print_int(C7 as i64); print("\n");
    print_int(C8 as i64); print("\n");
    print_int(BIG[4] as i64); print("\n");
    0
}
