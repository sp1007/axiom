fn report(ok: bool, bits: i64) {
    if ok { print("ok "); } else { print("BAD "); }
    print_int(bits);
    print("\n");
}

fn add_u8(x: u8, k: i16) -> i16 {
    let r: i16 = ~x + k;
    r
}

fn xor_u8(x: u8, k: i16) -> i16 {
    let r: i16 = k ^ ~x;
    r
}

fn two_u8(x: u8, y: u8, k: i16) -> i16 {
    let r: i16 = (~x + ~y) * k;
    r
}

fn add_i8(x: i8, k: i16) -> i16 {
    let r: i16 = ~x + k;
    r
}

fn xor_i8(x: i8, k: i16) -> i16 {
    let r: i16 = k ^ ~x;
    r
}

fn two_i8(x: i8, y: i8, k: i16) -> i16 {
    let r: i16 = (~x + ~y) * k;
    r
}

