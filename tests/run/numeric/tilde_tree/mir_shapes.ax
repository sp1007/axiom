// test: helper
// T499: input of mir_check.py (mir_shapes.test); body 0 a `~` in a widening tree, body 1 a standalone `~`.
fn tree(b8: u8, s64: i64) -> i64 {
    let r: i64 = ~b8 + s64;
    r
}

fn alone(b8: u8) -> u8 {
    let r: u8 = ~b8;
    r
}

fn main() -> i32 {
    let a = tree(255u8, 1000i64);
    let b = alone(255u8);
    if a == 744i64 && b == 0u8 { 0 } else { 1 }
}
