// test: run
// stdout: 5\n5\n5\n1255\n744\n489\n1044\n-32763\n-255\n1128\n1128\n1004\n1000\n1126\ncmp t\ncmp2 t\n13\n744\n1488\n768\n-792\n744\n744\n
// QA (T499 gate): adversarial shapes for unary `~` in widening trees: nested `~~x`, `~(a + b)` with mixed widths,
// signed narrow leaves, literals, `-`/`~` combinations, shifts (a shift stays a leaf of its own left operand type),
// comparison / index / closure / generic / if / match positions, const array length with a `~` tree.
// Expectations: exact Python integers (tree evaluated in the context type, SPEC-40 AXS-INT-052 rule 4).
const LEN: usize = (~250u8 & 255usize) as usize;
const ARR_N: usize = ~250u8 & 255usize;

fn nested(b8: u8, s64: i64) -> i64 {
    let r: i64 = ~~b8 + s64;
    r
}
fn nested3(b8: u8, s64: i64) -> i64 {
    let r: i64 = ~~~b8 + s64;
    r
}
fn not_sum(a: u8, b: u8, s64: i64) -> i64 {
    let r: i64 = ~(a + b) + s64;
    r
}
fn not_sum_mixed(a: u8, b: i16, s64: i64) -> i64 {
    let r: i64 = ~(a + b) * 1 + s64;
    r
}
fn signed16(x: i16, k: i32) -> i32 {
    let r: i32 = ~x + k;
    r
}
fn lit(b8: u8) -> i64 {
    let r: i64 = ~b8 + 1;
    r
}
fn neg_in_tree(s8: i8, s64: i64) -> i64 {
    let r: i64 = -s8 + s64;
    r
}
fn neg_not(s8: i8, s64: i64) -> i64 {
    let r: i64 = -~s8 + s64;
    r
}
fn not_neg(s8: i8, s64: i64) -> i64 {
    let r: i64 = ~-s8 + s64;
    r
}
fn shift_left(b8: u8, s64: i64) -> i64 {
    let r: i64 = (~b8 << 1u32) + s64;
    r
}
fn shift_left2(b8: u8, s64: i64) -> i64 {
    let r: i64 = (~b8 >> 1u32) + s64;
    r
}
fn cmp(b8: u8, s64: i64) -> bool {
    ~b8 < s64
}
fn cmp2(b8: u8, s64: i64) -> bool {
    (~b8 + s64) < 0
}
fn idx(a: [4]i64, b8: u8) -> i64 {
    a[~b8 & 3usize]
}
fn closure_case(b8: u8, s64: i64) -> i64 {
    let f = |x: u8| -> i64 { ~x + 1000i64 };
    f(b8) + s64 - s64
}
fn gen<T>(x: T, b8: u8, s64: i64) -> i64 {
    let r: i64 = ~b8 + s64;
    r
}
fn gen2(b8: u8, s64: i64) -> i64 {
    gen(1u8, b8, s64) + gen(2i32, b8, s64)
}
fn into_u64(b8: u8, k: u64) -> u64 {
    let r: u64 = ~b8 & k;
    r
}
fn into_i128(b8: u8, k: i128) -> i128 {
    let r: i128 = ~b8 ^ k;
    r
}
fn if_expr(b8: u8, s64: i64, c: bool) -> i64 {
    let r: i64 = if c { ~b8 + s64 } else { s64 };
    r
}
fn match_expr(b8: u8, s64: i64, c: i32) -> i64 {
    let r: i64 = match c { 0 => ~b8 + s64, _ => s64 };
    r
}
fn main() -> i32 {
    let arr: [LEN]u8 = [1u8, 2u8, 3u8, 4u8, 5u8];
    print_int(LEN as i64); print("\n");
    print_int(arr[4] as i64); print("\n");
    print_int(ARR_N as i64); print("\n");
    print_int(nested(255u8, 1000i64)); print("\n");
    print_int(nested3(255u8, 1000i64)); print("\n");
    print_int(not_sum(255u8, 255u8, 1000i64)); print("\n");
    print_int(not_sum_mixed(255u8, -300i16, 1000i64)); print("\n");
    print_int(signed16(32767i16, 5i32) as i64); print("\n");
    print_int(lit(255u8)); print("\n");
    print_int(neg_in_tree(-128i8, 1000i64)); print("\n");
    print_int(neg_not(127i8, 1000i64)); print("\n");
    print_int(not_neg(5i8, 1000i64)); print("\n");
    print_int(shift_left(255u8, 1000i64)); print("\n");
    print_int(shift_left2(2u8, 1000i64)); print("\n");
    if cmp(255u8, 1000i64) { print("cmp t\n"); } else { print("cmp f\n"); }
    if cmp2(255u8, 100i64) { print("cmp2 t\n"); } else { print("cmp2 f\n"); }
    print_int(idx([10i64, 11i64, 12i64, 13i64], 252u8)); print("\n");
    print_int(closure_case(255u8, 1000i64)); print("\n");
    print_int(gen2(255u8, 1000i64)); print("\n");
    print_int(into_u64(255u8, 1000u64) as i64); print("\n");
    print_int(into_i128(255u8, 1000i128) as i64); print("\n");
    print_int(if_expr(255u8, 1000i64, true)); print("\n");
    print_int(match_expr(255u8, 1000i64, 0i32)); print("\n");
    0
}
