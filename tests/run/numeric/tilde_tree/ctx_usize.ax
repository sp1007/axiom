fn report(ok: bool, bits: i64) {
    if ok { print("ok "); } else { print("BAD "); }
    print_int(bits);
    print("\n");
}

fn add_u8(x: u8, k: usize) -> usize {
    let r: usize = ~x - k;
    r
}

fn xor_u8(x: u8, k: usize) -> usize {
    let r: usize = k ^ ~x;
    r
}

fn two_u8(x: u8, y: u8, k: usize) -> usize {
    let r: usize = (~x & ~y) | k;
    r
}

fn add_u16(x: u16, k: usize) -> usize {
    let r: usize = ~x - k;
    r
}

fn xor_u16(x: u16, k: usize) -> usize {
    let r: usize = k ^ ~x;
    r
}

fn two_u16(x: u16, y: u16, k: usize) -> usize {
    let r: usize = (~x & ~y) | k;
    r
}

fn add_u32(x: u32, k: usize) -> usize {
    let r: usize = ~x - k;
    r
}

fn xor_u32(x: u32, k: usize) -> usize {
    let r: usize = k ^ ~x;
    r
}

fn two_u32(x: u32, y: u32, k: usize) -> usize {
    let r: usize = (~x & ~y) | k;
    r
}

