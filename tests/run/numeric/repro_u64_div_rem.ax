// test: run
// modes: interp native
// exit: 122

fn id_u64(x: u64) -> u64 { x }
fn id_usize(x: usize) -> usize { x }

fn main() -> i32 {
    let hi_u64: u64 = id_u64(1u64) << 63;
    let max_u64: u64 = ~id_u64(0u64);
    let max_usize: usize = ~id_usize(0usize);

    // Audit values from T140:
    // 1. 0x8000000000000000u64 / (1u64 << 56) == 128
    let a1: u64 = hi_u64 / (id_u64(1u64) << 56);
    // 2. 0xFFFF_FFFF_FFFF_FFFFu64 % 10u64 == 5
    let a2: u64 = max_u64 % id_u64(10u64);
    // 3. 0xFFFF_FFFF_FFFF_FFFFusize / (1usize << 56) == 255
    let a3: usize = max_usize / (id_usize(1usize) << 56);

    // Additional 64-bit unsigned edge cases (divisor with bit 63 set, max / 1, max / 2):
    let q1: u64 = max_u64 / id_u64(1u64);
    let r_hi: u64 = max_u64 % hi_u64;
    let q_u2: usize = max_usize / id_usize(2usize);
    let r_u2: usize = max_usize % id_usize(2usize);

    if a1 != 128u64 { return 1; }
    if a2 != 5u64 { return 2; }
    if a3 != 255usize { return 3; }
    if q1 != max_u64 { return 4; }
    if r_hi != hi_u64 - 1u64 { return 5; }
    if q_u2 != (hi_u64 - 1u64) as usize { return 6; }
    if r_u2 != 1usize { return 7; }

    // 128 ^ 5 ^ 255 == 122
    ((a1 as i32) ^ (a2 as i32)) ^ (a3 as i32)
}
