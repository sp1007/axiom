// test: run
// exit: 44

@intrinsic fn assert(c: bool) {}

fn main() -> i32 {
    let c = 'ế';
    assert(c as u32 == 0x1EBF);
    if (c as u32) != 0x1EBF { return 1; }
    assert(0x10FFFFu32 as char as u32 == 0x10FFFF);
    if (0x10FFFFu32 as char as u32) != 0x10FFFF { return 2; }
    assert(255u8 as char as u32 == 255);
    if (255u8 as char as u32) != 255 { return 3; }

    // Some normal casts
    assert(1i32 as u32 == 1);
    if (1i32 as u32) != 1 { return 4; }
    assert(-1i32 as u32 == 0xFFFFFFFF);
    if (-1i32 as u32) != 0xFFFFFFFF { return 5; }
    assert(300 as u8 == 44);
    if (300 as u8) != 44 { return 6; }
    assert(0x80u8 as i8 == -128);
    if (0x80u8 as i8) != -128 { return 7; }

    (300 as u8) as i32
}
