// test: run
// modes: interp native
// stdout: 128\n
// stdout: 5\n
// stdout: 255\n
// stdout: 18446744073709551615\n
// stdout: 3298534883328\n
// stdout: 3\n
// stdout: -5497558138880\n
// stdout: -5\n

fn print_digit(d: u64) {
    if d == 0u64 { print("0"); } else if d == 1u64 { print("1"); }
    else if d == 2u64 { print("2"); } else if d == 3u64 { print("3"); }
    else if d == 4u64 { print("4"); } else if d == 5u64 { print("5"); }
    else if d == 6u64 { print("6"); } else if d == 7u64 { print("7"); }
    else if d == 8u64 { print("8"); } else { print("9"); }
}

fn print_u64_ln(n: u64) {
    if n >= 10u64 { print_u64_no_nl(n / 10u64); }
    print_digit(n % 10u64);
    print("\n");
}

fn print_u64_no_nl(n: u64) {
    if n >= 10u64 { print_u64_no_nl(n / 10u64); }
    print_digit(n % 10u64);
}

fn print_isize_ln(n: isize) {
    if n < 0isize {
        print("-");
        print_u64_ln((0isize - n) as u64);
    } else {
        print_u64_ln(n as u64);
    }
}

fn id_u64(x: u64) -> u64 { x }
fn id_usize(x: usize) -> usize { x }
fn id_isize(x: isize) -> isize { x }

fn main() -> i32 {
    let hi_u64: u64 = id_u64(0x8000000000000000u64);
    let max_u64: u64 = id_u64(18446744073709551615u64);
    let max_usize: usize = id_usize(18446744073709551615usize);

    // 1. u64 0x8000000000000000 / (1u64 << 56) prints 128
    let a1: u64 = hi_u64 / (id_u64(1u64) << 56);
    print_u64_ln(a1);

    // 2. 0xFFFF_FFFF_FFFF_FFFFu64 % 10u64 prints 5
    let a2: u64 = max_u64 % id_u64(10u64);
    print_u64_ln(a2);

    // 3. 0xFFFF_FFFF_FFFF_FFFFusize / (1usize << 56) prints 255
    let a3: usize = max_usize / (id_usize(1usize) << 56);
    print_u64_ln(a3 as u64);

    // 4. 0xFFFF_FFFF_FFFF_FFFFu64 / 1u64 prints 18446744073709551615
    let a4: u64 = max_u64 / id_u64(1u64);
    print_u64_ln(a4);

    // 5. usize / isize shifts by 40
    let u: usize = id_usize(3usize);
    let u_shl: usize = u << 40;
    let u_shr: usize = u_shl >> 40;
    print_u64_ln(u_shl as u64);
    print_u64_ln(u_shr as u64);

    let s: isize = id_isize(-5isize);
    let s_shl: isize = s << 40;
    let s_shr: isize = s_shl >> 40;
    print_isize_ln(s_shl);
    print_isize_ln(s_shr);

    if a1 != 128u64 || a2 != 5u64 || a3 != 255usize || a4 != max_u64 { return 1; }
    if u_shl != 3298534883328usize || u_shr != 3usize { return 2; }
    if s_shl != -5497558138880isize || s_shr != -5isize { return 3; }
    0
}
