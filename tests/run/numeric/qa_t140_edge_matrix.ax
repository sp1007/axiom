// test: run
// modes: interp native
// stdout: 3 4611686018427387900\n
// stdout: 6148914691236517205 0\n
// stdout: 0 9223372036854775808\n
// stdout: 18446744071562067968 18446744073709551615\n
// stdout: -1 -2 -1\n

fn print_digit(d: u64) {
    if d == 0u64 { print("0"); } else if d == 1u64 { print("1"); }
    else if d == 2u64 { print("2"); } else if d == 3u64 { print("3"); }
    else if d == 4u64 { print("4"); } else if d == 5u64 { print("5"); }
    else if d == 6u64 { print("6"); } else if d == 7u64 { print("7"); }
    else if d == 8u64 { print("8"); } else { print("9"); }
}

fn print_u64(n: u64) {
    if n >= 10u64 { print_u64(n / 10u64); }
    print_digit(n % 10u64);
}

fn print_isize(n: isize) {
    if n < 0isize {
        print("-");
        print_u64((0isize - n) as u64);
    } else {
        print_u64(n as u64);
    }
}

fn id_u64(x: u64) -> u64 { x }
fn id_usize(x: usize) -> usize { x }
fn id_isize(x: isize) -> isize { x }

fn main() -> i32 {
    let max_u64: u64 = ~id_u64(0u64);
    let hb_u64: u64 = id_u64(1u64) << 63u32;

    // 1. Odd quotient > 1 with d < 2^63 where 2*r_half + (n&1) >= d triggers step-1 adjustment:
    // n = 2^64 - 1, d = 2^62 + 1 = 4611686018427387905 -> q = 3, r = 2^62 - 4 = 4611686018427387900
    let d1: u64 = (id_u64(1u64) << 62u32) + id_u64(1u64);
    let q1: u64 = max_u64 / d1;
    let r1: u64 = max_u64 % d1;
    print_u64(q1);
    print(" ");
    print_u64(r1);
    print("\n");

    // 2. Exact division of 2^64 - 1 by 3 (odd quotient 6148914691236517205, remainder 0):
    let q2: usize = (~id_usize(0usize)) / id_usize(3usize);
    let r2: usize = (~id_usize(0usize)) % id_usize(3usize);
    print_u64(q2 as u64);
    print(" ");
    print_u64(r2 as u64);
    print("\n");

    // 3. Even dividend >= 2^63 divided by dividend + 1 (both >= 2^63, same half-value 2^62):
    let d3: u64 = hb_u64 + id_u64(1u64);
    let q3: u64 = hb_u64 / d3;
    let r3: u64 = hb_u64 % d3;
    print_u64(q3);
    print(" ");
    print_u64(r3);
    print("\n");

    // 4. 64-bit unsigned multiply just below overflow on middle-limb carry:
    // a = 2^33 - 1 (a1 = 1, a0 = 2^32 - 1), b = 2^31 (b1 = 0, b0 = 2^31)
    // a1*b0 + (a0*b0 >> 32) = 2^31 + (2^31 - 1) = 2^32 - 1 (max non-carrying middle sum)
    // Product = 2^64 - 2^31 = 18446744071562067968
    let ma: u64 = id_u64(8589934591u64);
    let mb: u64 = id_u64(2147483648u64);
    let prod1: u64 = ma * mb;
    // Also (2^32 - 1) * (2^32 + 1) = 2^64 - 1 on usize:
    let prod2: usize = id_usize(4294967295usize) * id_usize(4294967297usize);
    print_u64(prod1);
    print(" ");
    print_u64(prod2 as u64);
    print("\n");

    // 5. Negative isize right shifts at 0, 32, 63:
    let neg_s0: isize = id_isize(-1isize) >> id_isize(0isize);
    let neg_s32: isize = (id_isize(-2isize) << id_isize(32isize)) >> id_isize(32isize);
    let neg_s63: isize = (id_isize(-1isize) << id_isize(63isize)) >> id_isize(63isize);
    print_isize(neg_s0);
    print(" ");
    print_isize(neg_s32);
    print(" ");
    print_isize(neg_s63);
    print("\n");

    let exp_prod1: u64 = (~0u64) - 2147483647u64;
    if q1 != 3u64 || r1 != 4611686018427387900u64 { return 1; }
    if q2 != 6148914691236517205usize || r2 != 0usize { return 2; }
    if q3 != 0u64 || r3 != hb_u64 { return 3; }
    if prod1 != exp_prod1 || prod2 != (~0usize) { return 4; }
    if neg_s0 != -1isize || neg_s32 != -2isize || neg_s63 != -1isize { return 5; }
    0
}
