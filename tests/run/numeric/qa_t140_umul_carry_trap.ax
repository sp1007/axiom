// test: run
// modes: interp native
// exit: 101
// stderr: panic: arithmetic overflow\n

fn id_u64(x: u64) -> u64 { x }

fn main() -> i32 {
    // a = 2^33 - 1 (a1 = 1, a0 = 0xFFFF_FFFF)
    // b = 2^31 + 1 (b1 = 0, b0 = 0x8000_0001)
    // Here a1*b1 == 0, (a1*b0)>>32 == 0, (a0*b1)>>32 == 0,
    // and overflow occurs solely via (a1*b0 & 0xFFFFFFFF) + ((a0*b0) >> 32) == 2^32 + 1 >= 2^32.
    let a: u64 = id_u64(8589934591u64);
    let b: u64 = id_u64(2147483649u64);
    let c: u64 = a * b;
    if c == 0u64 { return 1; }
    0
}
