// test: run
// native-after: T037

@intrinsic fn assert(c: bool) {}

fn main() -> i32 {
    let mut x: i8 = 127;
    assert(x + 0 == 127);
    let min_i8: i8 = (-127 - 1);
    assert(min_i8 - 0 == min_i8);
    
    let mut y: u8 = 255;
    assert(y + 0 == 255);

    let mut i16_max: i16 = 32767;
    assert(i16_max + 0 == 32767);
    let min_i16: i16 = (-32767 - 1);
    assert(min_i16 - 0 == min_i16);
    
    let mut u16_max: u16 = 65535;
    assert(u16_max + 0 == 65535);

    let mut i32_max: i32 = 2147483647;
    assert(i32_max + 0 == 2147483647);
    let min_i32: i32 = (-2147483647 - 1);
    assert(min_i32 - 0 == min_i32);

    let mut u32_max: u32 = 4294967295;
    assert(u32_max + 0 == 4294967295);

    let mut i64_max: i64 = 9223372036854775807;
    assert(i64_max + 0 == 9223372036854775807);
    let min_i64: i64 = (-9223372036854775807 - 1);
    assert(min_i64 - 0 == min_i64);

    let mut u64_max: u64 = 18446744073709551615;
    assert(u64_max + 0 == 18446744073709551615);
    
    let mut isize_max: isize = 9223372036854775807;
    assert(isize_max + 0 == 9223372036854775807);
    let min_isize: isize = (-9223372036854775807 - 1);
    assert(min_isize - 0 == min_isize);
    
    let mut usize_max: usize = 18446744073709551615;
    assert(usize_max + 0 == 18446744073709551615);

    // Test division
    let m: i32 = -2147483648;
    assert(m / 1 == m);
    
    let mut usize_val: usize = 0;
    assert(usize_val + 0 == 0);
    0
}
