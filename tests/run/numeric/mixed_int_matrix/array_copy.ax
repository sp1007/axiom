// test: run
// stdout: 6\n6\n9\nOK array_copy\n

// SPEC-10 AXS-OWN-003 (ADR-0044 section 3): `[N]T` is Copy iff T is Copy, so the same array can be passed by value
// twice, copied into two bindings and read again afterwards.
fn sum2(a: [2]u8) -> u8 {
    a[0] + a[1]
}

fn main() -> i32 {
    let a: [2]u8 = [1, 2];
    let x: u8 = sum2(a);
    let y: u8 = sum2(a);
    print_int((x + y) as i64);
    print("\n");
    let b: [2]u8 = a;
    let c: [2]u8 = a;
    print_int((sum2(b) + sum2(c)) as i64);
    print("\n");
    print_int((sum2(a) + sum2(b) + sum2(c)) as i64);
    print("\n");
    print("OK array_copy\n");
    0
}
