// test: helper
// T455 follow-up FU-T455-IDX128 (NOT run by the suite; run it by hand to reproduce).
// SPEC-40 AXS-INT-053 / AXS-INT-054 lower `a[i]` for a non-usize index as `Cast(IntToInt, i, usize)` followed by the
// bounds check `idx_usize < len`.  For a 128-bit index the cast truncates, so u128 `2^64 + 1` becomes usize 1 and
// the access silently reads element 1 instead of trapping `index out of bounds`.  i64/u64 indices are exact (no
// truncation on a 64-bit target); only i128/u128 values >= 2^64 alias.
//   expected: exit 101 `panic: index out of bounds`      actual (interp, native -O0, native -O1): exit 0, prints 20
fn at(a: view<[8]i32>, i: u128) -> i32 { (*a)[i] }

fn main() -> i32 {
    let a: [8]i32 = [10, 20, 30, 40, 50, 60, 70, 80];
    print_int(at(view(a), 18446744073709551617u128) as i64);
    print("\n");
    0
}
