// test: helper
// T455 follow-up FU-T455-IDXCODE (NOT run by the suite).  SPEC-40 AXS-INT-053 / AXS-INT-060 say a non-integer index
// (bool, f32, f64, struct) is rejected with AX_TYPE_INDEX_NOT_INT (2014).  That code is not defined in
// compiler/diag/code.ax; the compiler reports AX_TYPE_MISMATCH instead.  Once the code exists, turn this file into
// `// test: ui` with the annotation below.
fn main() -> i32 {
    let a: [4]i32 = [1, 2, 3, 4];
    let i: bool = true;
    let x: i32 = a[i]; // expected: ERROR AX_TYPE_INDEX_NOT_INT, actual: ERROR AX_TYPE_MISMATCH
    return x;
}
