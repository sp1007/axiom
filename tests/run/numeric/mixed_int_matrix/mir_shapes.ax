// test: helper
// Input of mir_check.py (mir_homogeneous.test): body 0 is REQ-OWNER-007 Pattern D, body 1 a promoted array index,
// body 2 a shift whose count has another type than the left operand.

fn calc(b8: u8, s8: i8, u16v: u16, s32: i32, s64: i64) -> i64 {
    let total: i64 = (s64 + s32 * 3) - (u16v + b8 * 2 + s8 - 7) / (4 - s8);
    total
}

fn idx(a: view<[8]i32>, i: i16, j: u8, n: usize) -> i32 {
    (*a)[i + j]
}

fn sh(x: u32, n: u8) -> u32 {
    x << n
}

fn main() -> i32 {
    0
}
