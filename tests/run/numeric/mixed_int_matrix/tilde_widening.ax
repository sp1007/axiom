// test: run
// stdout: 744\n999\n1255\n0\nOK tilde_widening\n
// xfail: T499 unary ~ of a narrow unsigned leaf is computed in the leaf type instead of the tree context (ADR-0044 section 2)

// SPEC-40 AXS-INT-052 rule 4 (ADR-0044 section 2): inside a widening arithmetic tree every node, including unary `~`,
// is evaluated in the context type, i.e. the operand is widened first.  Expected values are exact integers:
//   ~255 in i64 = -256;  -256 + 1000 = 744
//   ~0   in i64 = -1;    -1 + 1000 = 999
//   ~(-1i8) is 0 whether the operand is widened first or not (sign extension commutes with ~), 0 + 1255 = 1255
// A standalone `~b8` that is not part of a widening tree keeps the u8 type: ~255u8 = 0.
fn tilde_u8(b8: u8, s64: i64) -> i64 {
    let r: i64 = ~b8 + s64;
    r
}

fn tilde_i8(s8: i8, s64: i64) -> i64 {
    let r: i64 = ~s8 + s64;
    r
}

fn tilde_standalone(b8: u8) -> u8 {
    let r: u8 = ~b8;
    r
}

fn main() -> i32 {
    print_int(tilde_u8(255u8, 1000i64));
    print("\n");
    print_int(tilde_u8(0u8, 1000i64));
    print("\n");
    print_int(tilde_i8(-1i8, 1255i64));
    print("\n");
    print_int(tilde_standalone(255u8) as i64);
    print("\n");
    print("OK tilde_widening\n");
    0
}
