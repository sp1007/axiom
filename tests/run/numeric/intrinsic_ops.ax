@intrinsic fn wrapping_add_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn wrapping_sub_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn wrapping_neg_u64(a: u64) -> u64 { 0 }
@intrinsic fn rotate_left_u64(a: u64, b: u32) -> u64 { 0 }
@intrinsic fn rotate_right_u64(a: u64, b: u32) -> u64 { 0 }
@intrinsic fn leading_zeros_u64(a: u64) -> u32 { 0 }
@intrinsic fn trailing_zeros_u64(a: u64) -> u32 { 0 }
@intrinsic fn count_ones_u64(a: u64) -> u32 { 0 }

@intrinsic fn wrapping_add_isize(a: isize, b: isize) -> isize { 0 }
@intrinsic fn wrapping_sub_isize(a: isize, b: isize) -> isize { 0 }
@intrinsic fn wrapping_mul_isize(a: isize, b: isize) -> isize { 0 }
@intrinsic fn wrapping_neg_isize(a: isize) -> isize { 0 }
@intrinsic fn rotate_left_isize(a: isize, b: u32) -> isize { 0 }
@intrinsic fn rotate_right_isize(a: isize, b: u32) -> isize { 0 }
@intrinsic fn leading_zeros_isize(a: isize) -> u32 { 0 }
@intrinsic fn trailing_zeros_isize(a: isize) -> u32 { 0 }
@intrinsic fn count_ones_isize(a: isize) -> u32 { 0 }

@intrinsic fn wrapping_add_usize(a: usize, b: usize) -> usize { 0 }
@intrinsic fn wrapping_sub_usize(a: usize, b: usize) -> usize { 0 }
@intrinsic fn wrapping_mul_usize(a: usize, b: usize) -> usize { 0 }
@intrinsic fn wrapping_neg_usize(a: usize) -> usize { 0 }
@intrinsic fn rotate_left_usize(a: usize, b: u32) -> usize { 0 }
@intrinsic fn rotate_right_usize(a: usize, b: u32) -> usize { 0 }
@intrinsic fn leading_zeros_usize(a: usize) -> u32 { 0 }
@intrinsic fn trailing_zeros_usize(a: usize) -> u32 { 0 }
@intrinsic fn count_ones_usize(a: usize) -> u32 { 0 }
fn test_fnv1a() {
    let prime: u32 = 16777619;
    let mut hash: u32 = 2166136261;
    // FNV-1a over 4 bytes: 0x12, 0x34, 0x56, 0x78
    hash = wrapping_mul_u32(hash ^ 0x12, prime);
    hash = wrapping_mul_u32(hash ^ 0x34, prime);
    hash = wrapping_mul_u32(hash ^ 0x56, prime);
    hash = wrapping_mul_u32(hash ^ 0x78, prime);
    
    assert(hash == 1528059109);
}

fn main() -> i32 {
    let max_i32 = 2147483647;
    let min_i32 = (-2147483647 - 1);
    assert(wrapping_add_i32(max_i32, 1) == min_i32);
    assert(wrapping_sub_i32(min_i32, 1) == max_i32);
    assert(wrapping_mul_i32(max_i32, 2) == -2);
    assert(wrapping_neg_i32(min_i32) == min_i32);
    assert(rotate_left_i32(0x01234567, 8) == 0x23456701);
    assert(rotate_right_i32(0x01234567, 8) == 0x67012345);
    assert(leading_zeros_i32(0x0000FFFF) == 16);
    assert(trailing_zeros_i32(-65536) == 16);
    assert(count_ones_i32(0x0F0F0F0F) == 16);

    let max_u32 = 4294967295;
    let min_u32 = 0;
    assert(wrapping_add_u32(max_u32, 1) == min_u32);
    assert(wrapping_sub_u32(min_u32, 1) == max_u32);
    assert(wrapping_mul_u32(max_u32, 2) == 4294967294);
    assert(wrapping_neg_u32(1) == 4294967295);

    let max_i8: i8 = 127;
    let min_i8: i8 = (-127 - 1);
    assert(wrapping_add_i8(max_i8, 1) == min_i8);
    assert(wrapping_sub_i8(min_i8, 1) == max_i8);
    assert(wrapping_neg_i8(min_i8) == min_i8);

    let max_u8: u8 = 255;
    let min_u8: u8 = 0;
    assert(wrapping_add_u8(max_u8, 1) == min_u8);
    assert(wrapping_sub_u8(min_u8, 1) == max_u8);

    let max_i16: i16 = 32767;
    let min_i16: i16 = (-32767 - 1);
    assert(wrapping_add_i16(max_i16, 1) == min_i16);
    assert(wrapping_sub_i16(min_i16, 1) == max_i16);

    let max_u16: u16 = 65535;
    let min_u16: u16 = 0;
    assert(wrapping_add_u16(max_u16, 1) == min_u16);
    assert(wrapping_sub_u16(min_u16, 1) == max_u16);

    let max_i64: i64 = 9223372036854775807;
    let min_i64: i64 = (-9223372036854775807 - 1);
    assert(wrapping_add_i64(max_i64, 1) == min_i64);
    assert(wrapping_sub_i64(min_i64, 1) == max_i64);
    
    let max_u64: u64 = 18446744073709551615;
    let min_u64: u64 = 0;
    assert(wrapping_add_u64(max_u64, 1) == min_u64);
    assert(wrapping_sub_u64(min_u64, 1) == max_u64);

    let max_isize: isize = 9223372036854775807;
    let min_isize: isize = (-9223372036854775807 - 1);
    assert(wrapping_add_isize(max_isize, 1) == min_isize);
    assert(wrapping_sub_isize(min_isize, 1) == max_isize);
    
    let max_usize: usize = 18446744073709551615;
    let min_usize: usize = 0;
    assert(wrapping_add_usize(max_usize, 1) == min_usize);
    assert(wrapping_sub_usize(min_usize, 1) == max_usize);

    // u8 intrinsics
    assert(wrapping_mul_u8(max_u8, 2) == 254);
    assert(rotate_left_u8(0x12, 4) == 0x21);
    assert(rotate_right_u8(0x12, 4) == 0x21);
    assert(leading_zeros_u8(0x0F) == 4);
    assert(trailing_zeros_u8(0xF0) == 4);
    assert(count_ones_u8(0x0F) == 4);

    // i8 intrinsics
    assert(wrapping_mul_i8(max_i8, 2) == -2);
    assert(rotate_left_i8(0x12, 4) == 0x21);
    assert(rotate_right_i8(0x12, 4) == 0x21);
    assert(leading_zeros_i8(0x0F) == 4);
    assert(trailing_zeros_i8(-16) == 4); // -16 is 0xF0
    assert(count_ones_i8(0x0F) == 4);

    // u16 intrinsics
    assert(wrapping_mul_u16(max_u16, 2) == 65534);
    assert(rotate_left_u16(0x1234, 8) == 0x3412);
    assert(rotate_right_u16(0x1234, 8) == 0x3412);
    assert(leading_zeros_u16(0x00FF) == 8);
    assert(trailing_zeros_u16(0xFF00) == 8);
    assert(count_ones_u16(0x0F0F) == 8);

    // i16 intrinsics
    assert(wrapping_mul_i16(max_i16, 2) == -2);
    assert(rotate_left_i16(0x1234, 8) == 0x3412);
    assert(rotate_right_i16(0x1234, 8) == 0x3412);
    assert(leading_zeros_i16(0x00FF) == 8);
    assert(trailing_zeros_i16(-256) == 8); // -256 is 0xFF00
    assert(count_ones_i16(0x0F0F) == 8);

    // i64 intrinsics
    assert(wrapping_mul_i64(max_i64, 2) == -2);
    assert(rotate_left_i64(0x0123456789ABCDEF, 32) == -8526495043095935641); // 0x89ABCDEF01234567
    assert(rotate_right_i64(0x0123456789ABCDEF, 32) == -8526495043095935641);
    assert(leading_zeros_i64(0x0000FFFFFFFFFFFF) == 16);
    assert(trailing_zeros_i64(-65536) == 16);
    assert(count_ones_i64(0x0F0F0F0F0F0F0F0F) == 32);

    // u64 intrinsics
    assert(wrapping_mul_u64(max_u64, 2) == 18446744073709551614);
    assert(rotate_left_u64(0x0123456789ABCDEF, 32) == 0x89ABCDEF01234567);
    assert(rotate_right_u64(0x0123456789ABCDEF, 32) == 0x89ABCDEF01234567);
    assert(leading_zeros_u64(0x0000FFFFFFFFFFFF) == 16);
    assert(trailing_zeros_u64(0xFFFFFFFFFFFF0000) == 16);
    assert(count_ones_u64(0x0F0F0F0F0F0F0F0F) == 32);

    // isize intrinsics
    assert(wrapping_mul_isize(max_isize, 2) == -2);
    assert(rotate_left_isize(0x0123456789ABCDEF, 32) == -8526495043095935641); // 0x89ABCDEF01234567
    assert(rotate_right_isize(0x0123456789ABCDEF, 32) == -8526495043095935641);
    assert(leading_zeros_isize(0x0000FFFFFFFFFFFF) == 16);
    assert(trailing_zeros_isize(-65536) == 16);
    assert(count_ones_isize(0x0F0F0F0F0F0F0F0F) == 32);

    // usize intrinsics
    assert(wrapping_mul_usize(max_usize, 2) == 18446744073709551614);
    assert(rotate_left_usize(0x0123456789ABCDEF, 32) == 0x89ABCDEF01234567);
    assert(rotate_right_usize(0x0123456789ABCDEF, 32) == 0x89ABCDEF01234567);
    assert(leading_zeros_usize(0x0000FFFFFFFFFFFF) == 16);
    assert(trailing_zeros_usize(0xFFFFFFFFFFFF0000) == 16);
    assert(count_ones_usize(0x0F0F0F0F0F0F0F0F) == 32);
    test_fnv1a();
    
    0
}

