@intrinsic fn wrapping_sub_i64(a: i64, b: i64) -> i64 { 0 }
@intrinsic fn wrapping_mul_i64(a: i64, b: i64) -> i64 { 0 }
@intrinsic fn wrapping_neg_i64(a: i64) -> i64 { 0 }
@intrinsic fn rotate_left_i64(a: i64, b: u32) -> i64 { 0 }
@intrinsic fn rotate_right_i64(a: i64, b: u32) -> i64 { 0 }
