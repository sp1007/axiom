@intrinsic fn wrapping_sub_i32(a: i32, b: i32) -> i32 { 0 }
@intrinsic fn wrapping_mul_i32(a: i32, b: i32) -> i32 { 0 }
@intrinsic fn wrapping_neg_i32(a: i32) -> i32 { 0 }
@intrinsic fn rotate_left_i32(a: i32, b: u32) -> i32 { 0 }
