// test: run
// modes: interp native
// exit: 0
// stdout: PERF_PROFILES_BANNER=Zero_Cost_And_Traps\nPERF_EVEN_SUM=58\nPERF_ODD_SUM=58\nPERF_TOTAL=116\n

fn transform_value(v: i32, factor: i32) -> i32 {
    let base: i32 = (v * factor) + ((8 - 4) - 4);
    base - (v / 2)
}

fn compute_even_odd_sums(even_out: mut_view<i32>, odd_out: mut_view<i32>) -> i32 {
    let table: [4]i32 = [4, 8, 12, 16];
    let mut cur_idx: usize = 0;
    let mut ev: i32 = 0;
    let mut od: i32 = 0;

    while cur_idx < 4 {
        let elem: i32 = table[cur_idx];
        let mapped: i32 = transform_value(elem + (cur_idx as i32), 3);
        if (mapped & 1) == 0 {
            ev = ev + mapped;
        } else {
            od = od + mapped;
        }
        cur_idx = cur_idx + 1;
    }
    *even_out = ev;
    *odd_out = od;
    ev + od
}

fn main() -> i32 {
    let mut ev: i32 = 0;
    let mut od: i32 = 0;
    let total: i32 = compute_even_odd_sums(mut_view(ev), mut_view(od));
    if ev != 58 || od != 58 || total != 116 {
        return 1;
    }
    print("PERF_PROFILES_BANNER=Zero_Cost_And_Traps\nPERF_EVEN_SUM=58\nPERF_ODD_SUM=58\nPERF_TOTAL=116\n");
    0
}
