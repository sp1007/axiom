// test: run
// modes: interp native
// exit: 0
// stdout: PERF_SIZE_BANNER=Sharing_And_Startup\nPERF_HANDLE_A=832\nPERF_HANDLE_B=1664\nPERF_TUNE_CAND=3\n

fn handle_mix_i32(raw_id: i32, tag: i32) -> i32 {
    let scaled: i32 = (raw_id * 8) + (raw_id / 4);
    scaled + tag
}

fn select_legal_candidate() -> i32 {
    let cand1_legal: bool = true;
    let cand1_us: i32 = 400;
    let cand2_legal: bool = false;
    let cand2_us: i32 = 10;
    let cand3_legal: bool = true;
    let cand3_us: i32 = 220;

    let mut best_id: i32 = 0;
    let mut best_us: i32 = 999999;

    if cand1_legal && cand1_us < best_us {
        best_id = 1;
        best_us = cand1_us;
    }
    if cand2_legal && cand2_us < best_us {
        best_id = 2;
        best_us = cand2_us;
    }
    if cand3_legal && cand3_us < best_us {
        best_id = 3;
        best_us = cand3_us;
    }
    best_id
}

fn main() -> i32 {
    let v1: i32 = handle_mix_i32(100, 7);
    let v2: i32 = handle_mix_i32(200, 14);
    let cand: i32 = select_legal_candidate();

    if v1 != 832 || v2 != 1664 || cand != 3 {
        return 1;
    }
    print("PERF_SIZE_BANNER=Sharing_And_Startup\nPERF_HANDLE_A=832\nPERF_HANDLE_B=1664\nPERF_TUNE_CAND=3\n");
    0
}
