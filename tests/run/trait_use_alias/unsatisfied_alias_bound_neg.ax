// test: ui
// T492 negative test: `use alpha.First as Second` binds `Second` to `alpha.First`, not `alpha.Second`.
// A type that implements only `alpha.Second` must not satisfy a `T: Second` bound or a supertrait `Sub: Second`.

module alpha

pub trait First {
    fn f(self: view<Self>) -> i32;
}

pub trait Second {
    fn f(self: view<Self>) -> i32;
}

module main

use alpha.First as Second

trait Sub: Second {
    fn sub_f(self: view<Self>) -> i32 {
        self.f()
    }
}

struct OnlyRealSecond {
    pub v: i32,
}

impl alpha.Second for OnlyRealSecond {
    fn f(self: view<Self>) -> i32 {
        self.v
    }
}

impl Sub for OnlyRealSecond {} //~ ERROR AX_TRAIT_UNSATISFIED_BOUND

fn require_aliased<T: Second>(x: view<T>) -> i32 {
    x.f()
}

fn main() -> i32 {
    let s = OnlyRealSecond { v: 1 };
    require_aliased(view(s)) //~ ERROR AX_TRAIT_UNSATISFIED_BOUND
}
