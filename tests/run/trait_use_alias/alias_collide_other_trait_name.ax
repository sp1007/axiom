// test: run
// modes: interp native
// exit: 37
// stdout: swapped 15 45\nsuper 15 115\nreexport 15\nstd_as_eq -1 1 0\n
// T492 regression: `use … as Alias` where `Alias` equals another existing trait's name in the same or another
// module (`use alpha.First as Second` and `use beta.Second as First`, plus `use std.core.cmp.Ord as Eq` while
// `std.core.cmp.Eq` and `alpha.Eq` exist, and chained `pub use … as` re-exports).

module alpha

pub trait First {
    fn val(self: view<Self>) -> i32 {
        10
    }
    fn compute(self: view<Self>) -> i32;
}

pub trait Second {
    fn val(self: view<Self>) -> i32 {
        20
    }
    fn compute(self: view<Self>) -> i32;
}

pub trait Eq {
    fn eq_tag(self: view<Self>) -> i32 {
        99
    }
}

module beta

pub trait First {
    fn val(self: view<Self>) -> i32 {
        30
    }
    fn compute(self: view<Self>) -> i32;
}

pub trait Second {
    fn val(self: view<Self>) -> i32 {
        40
    }
    fn compute(self: view<Self>) -> i32;
}

module mid

use alpha.First as Second

pub use Second as ReExportedFirst

pub trait SubOfAlphaFirst: Second {
    fn sub_val(self: view<Self>) -> i32 {
        self.compute() + 100
    }
}

module main

// `Second` names `alpha.First` (even though `alpha.Second` and `beta.Second` exist).
use alpha.First as Second
// `First` names `beta.Second` (even though `alpha.First` and `beta.First` exist).
use beta.Second as First
// `Eq` names `std.core.cmp.Ord` (even though `std.core.cmp.Eq` and `alpha.Eq` exist).
use std.core.cmp.Ord as Eq
use mid.SubOfAlphaFirst as SubAlias
use mid.ReExportedFirst as ChainSecond

struct ItemA {
    pub x: i32,
}

struct ItemB {
    pub x: i32,
}

struct OtherA {
    pub x: i32,
}

// Implements `alpha.First` (via alias `Second`) for `ItemA`.
impl Second for ItemA {
    fn compute(self: view<Self>) -> i32 {
        self.val() + self.x
    }
}

// Implement `alpha.Second` on `OtherA` so `alpha.Second` is active in the program while `ItemA` implements only
// `alpha.First` (via `use alpha.First as Second`).
impl alpha.Second for OtherA {
    fn compute(self: view<Self>) -> i32 {
        self.val() + self.x + 500
    }
}

impl SubAlias for ItemA {}

// Implements `beta.Second` (via alias `First`) for `ItemB`.
impl First for ItemB {
    fn compute(self: view<Self>) -> i32 {
        self.val() + self.x
    }
}

impl Eq for ItemA {
    fn cmp(self: view<Self>, other: view<Self>) -> std.core.cmp.Ordering {
        if (self.x) < (other.x) {
            std.core.cmp.Ordering.Less
        } else if (self.x) > (other.x) {
            std.core.cmp.Ordering.Greater
        } else {
            std.core.cmp.Ordering.Equal
        }
    }
}

fn call_second<T: Second>(a: view<T>) -> i32 {
    a.compute()
}

fn call_first<T: First>(b: view<T>) -> i32 {
    b.compute()
}

fn call_sub_compute<T: SubAlias>(a: view<T>) -> i32 {
    a.compute()
}

fn call_sub_val<T: SubAlias>(a: view<T>) -> i32 {
    a.sub_val()
}

fn call_chain<T>(a: view<T>) -> i32 where T: ChainSecond {
    a.compute()
}

fn call_std_as_eq<T: Eq>(a: view<T>, b: view<T>) -> i64 {
    match a.cmp(b) {
        std.core.cmp.Ordering.Less => -1,
        std.core.cmp.Ordering.Equal => 0,
        std.core.cmp.Ordering.Greater => 1,
    }
}

fn main() -> i32 {
    let a = ItemA { x: 5 };
    let b = ItemB { x: 5 };
    let v_a = call_second(view(a));
    let v_b = call_first(view(b));
    print("swapped ");
    print_int(v_a as i64);
    print(" ");
    print_int(v_b as i64);

    let sv1 = call_sub_compute(view(a));
    let sv2 = call_sub_val(view(a));
    print("\nsuper ");
    print_int(sv1 as i64);
    print(" ");
    print_int(sv2 as i64);

    let cv = call_chain(view(a));
    print("\nreexport ");
    print_int(cv as i64);

    let a2 = ItemA { x: 9 };
    let c1 = call_std_as_eq(view(a), view(a2));
    let c2 = call_std_as_eq(view(a2), view(a));
    let c3 = call_std_as_eq(view(a), view(a));
    print("\nstd_as_eq ");
    print_int(c1);
    print(" ");
    print_int(c2);
    print(" ");
    print_int(c3);
    print("\n");

    // 15 + 45 - 23 = 37
    v_a + v_b - 23
}
