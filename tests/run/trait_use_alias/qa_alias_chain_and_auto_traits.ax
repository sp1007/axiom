// test: run
// modes: interp native
// exit: 66
// stdout: chain 7 17 124\nauto 11 11 22\n
// T492 QA adversarial test:
// 1) Multi-level `pub use ... as` alias chain (3 hops across modules) + transitive aliased supertrait
//    hierarchy where a grandchild trait's default method calls both its parent's default method and
//    its grandparent's method on `Self` (`TC_SELF_PARAM_INDEX`), implemented via `impl Alias for T`
//    and exercised through `where T: FinalLeaf`.
// 2) Aliased user `auto trait` (`m_auto.SafeMark` re-exported through alias chain to `MyMark`)
//    combined with `Send`/`Share` auto-trait bounds (`unsafe impl Send`/`Share` on a raw-pointer struct,
//    `view<RawBox>: Send` requiring `RawBox: Share`, exercising retired 10007/10008 sentinel paths).

module m0

pub trait Base {
    fn base_v(self: view<Self>) -> i32;
    fn base_default(self: view<Self>) -> i32 {
        self.base_v() + 10
    }
}

pub auto trait SafeMark {}

module m1

pub use m0.Base as Hop1
pub use m0.SafeMark as MarkHop1

pub trait Mid: Hop1 {
    fn mid_v(self: view<Self>) -> i32 {
        self.base_default()
    }
}

module m2

pub use m1.Hop1 as Hop2
pub use m1.MarkHop1 as MarkHop2
pub use m1.Mid as MidHop1

pub trait Leaf: MidHop1 {
    fn leaf_v(self: view<Self>) -> i32 {
        self.mid_v() + self.base_v() + 100
    }
}

module m3

pub use m2.Hop2 as Hop3
pub use m2.MarkHop2 as MarkHop3
pub use m2.MidHop1 as MidHop2
pub use m2.Leaf as LeafHop1

module main

use m3.Hop3 as FinalBase
use m3.MarkHop3 as MyMark
use m3.MidHop2 as FinalMid
use m3.LeafHop1 as FinalLeaf

struct Boxed {
    pub v: i32,
}

impl FinalBase for Boxed {
    fn base_v(self: view<Self>) -> i32 {
        self.v
    }
}

impl FinalMid for Boxed {}
impl FinalLeaf for Boxed {}

struct RawBox {
    pub ptr: *mut i32,
    pub tag: i32,
}

unsafe impl Send for RawBox {}
unsafe impl Share for RawBox {}
impl MyMark for RawBox {}

fn use_leaf_where<T>(x: view<T>) -> i32 where T: FinalLeaf + MyMark {
    x.leaf_v()
}

fn use_mid_where<T>(x: view<T>) -> i32 where T: FinalMid {
    x.mid_v()
}

fn use_base_where<T>(x: view<T>) -> i32 where T: FinalBase + Send {
    x.base_v()
}

fn send_and_mark<T: Send + MyMark>(x: T) -> T {
    x
}

fn send_view<T: Send>(v: T) -> T {
    v
}

fn share_double<T>(v: view<T>) -> i32 where T: Share + FinalBase + MyMark {
    v.base_v() * 2
}

fn main() -> i32 {
    let b = Boxed { v: 7 };
    let r_base = use_base_where(view(b));
    let r_mid = use_mid_where(view(b));
    let r_leaf = use_leaf_where(view(b));
    print("chain ");
    print_int(r_base as i64);
    print(" ");
    print_int(r_mid as i64);
    print(" ");
    print_int(r_leaf as i64);

    let rb = RawBox { ptr: 0 as *mut i32, tag: 11 };
    let rb2 = send_and_mark(rb);
    // `view<RawBox>` is `Send` iff `RawBox: Share` (tests retired 10008 sentinel path).
    let rv = send_view(view(rb2));
    let b11 = Boxed { v: 11 };
    let sd = share_double(view(b11));
    print("\nauto ");
    print_int(rb2.tag as i64);
    print(" ");
    print_int(rv.tag as i64);
    print(" ");
    print_int(sd as i64);
    print("\n");

    // 7 + 17 + 20 + 22 = 66
    r_base + r_mid + (rv.tag + 9) + sd
}
