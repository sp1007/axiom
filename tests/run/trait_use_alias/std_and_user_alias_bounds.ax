// test: run
// modes: interp native
// exit: 42
// stdout: std -1 1 0\nuser 6 18\nwrap 60 61\nsuper -1 1 6 16\nwhere 18 1\nmulti 6 -1\n
// T492 regression: trait bounds, `impl Alias for T`, and supertrait lists naming a `use … as Alias` import
// (for both std traits and user traits, including same-named traits across domains, inline bounds, where clauses,
// default methods, and generic impls).

module tr

pub trait Ord {
    fn rank(self: view<Self>) -> i32;
}

pub trait Scale {
    fn scaled(self: view<Self>, factor: i32) -> i32 {
        factor
    }
}

module sub

use tr.Ord as BaseOrd
use std.core.cmp.Ord as StdBaseOrd

pub trait Eq: BaseOrd {
    fn eqv(self: view<Self>) -> i32 {
        self.rank() + 1
    }
}

pub trait Sorted: StdBaseOrd + BaseOrd {
    fn sorted_bonus(self: view<Self>) -> i32 {
        self.rank() + 10
    }
}

module main

use std.core.cmp.Ord as StdOrd
use std.core.cmp.Ordering as StdOrdering
use tr.Ord as MyOrd
use tr.Scale as MyScale
use sub.Eq as MyEq
use sub.Sorted as MySorted

struct K {
    pub v: i32,
}

struct W<T> {
    pub inner: T,
}

impl MyOrd for K {
    fn rank(self: view<Self>) -> i32 {
        self.v
    }
}

impl MyScale for K {
    fn scaled(self: view<Self>, factor: i32) -> i32 {
        self.v * factor
    }
}

impl StdOrd for K {
    fn cmp(self: view<Self>, other: view<Self>) -> StdOrdering {
        if (self.v) < (other.v) {
            StdOrdering.Less
        } else if (self.v) > (other.v) {
            StdOrdering.Greater
        } else {
            StdOrdering.Equal
        }
    }
}

impl MySorted for K {}

impl<T: MyOrd> MyOrd for W<T> {
    fn rank(self: view<Self>) -> i32 {
        self.inner.rank() * 10
    }
}

impl<T: MyOrd> MyEq for W<T> {}

fn by_std<T: StdOrd>(a: view<T>, b: view<T>) -> i64 {
    match a.cmp(b) {
        StdOrdering.Less => -1,
        StdOrdering.Equal => 0,
        StdOrdering.Greater => 1,
    }
}

fn by_user<T: MyOrd>(x: view<T>) -> i32 {
    x.rank()
}

fn by_eq<T: MyEq>(x: view<T>) -> i32 {
    x.eqv()
}

fn by_super_cmp<T: MySorted>(a: view<T>, b: view<T>) -> i64 {
    match a.cmp(b) {
        StdOrdering.Less => -1,
        StdOrdering.Equal => 0,
        StdOrdering.Greater => 1,
    }
}

fn by_super_rank<T: MySorted>(x: view<T>) -> i32 {
    x.rank()
}

fn by_super_bonus<T: MySorted>(x: view<T>) -> i32 {
    x.sorted_bonus()
}

fn by_where_sc<T>(a: view<T>, b: view<T>) -> i32 where T: MyScale + StdOrd {
    let _ = a.cmp(b);
    a.scaled(3)
}

fn by_where_cm<T>(a: view<T>, b: view<T>) -> i64 where T: MyScale + StdOrd {
    let _ = a.scaled(3);
    match a.cmp(b) {
        StdOrdering.Less => -1,
        StdOrdering.Equal => 0,
        StdOrdering.Greater => 1,
    }
}

fn multi<T: MyOrd + StdOrd>(a: view<T>, b: view<T>) -> i64 {
    let r = a.rank() as i64;
    match a.cmp(b) {
        StdOrdering.Less => r * 0 - 1,
        StdOrdering.Equal => r,
        StdOrdering.Greater => r + 100,
    }
}

fn main() -> i32 {
    let x: u32 = 2;
    let y: u32 = 8;
    let s1 = by_std(view(x), view(y));
    let s2 = by_std(view(y), view(x));
    let s3 = by_std(view(x), view(x));
    print("std ");
    print_int(s1);
    print(" ");
    print_int(s2);
    print(" ");
    print_int(s3);

    let k = K { v: 6 };
    let k2 = K { v: 2 };
    let u1 = by_user(view(k));
    let w_sc = by_where_sc(view(k), view(k2));
    let w_cm = by_where_cm(view(k), view(k2));
    print("\nuser ");
    print_int(u1 as i64);
    print(" ");
    print_int(w_sc as i64);

    let w = W { inner: K { v: 6 } };
    let wr = by_user(view(w));
    let we = by_eq(view(w));
    print("\nwrap ");
    print_int(wr as i64);
    print(" ");
    print_int(we as i64);

    let k1 = K { v: 1 };
    let k3 = K { v: 3 };
    let sc1 = by_super_cmp(view(k1), view(k3));
    let sc2 = by_super_cmp(view(k3), view(k1));
    let sr = by_super_rank(view(k));
    let sb = by_super_bonus(view(k));
    print("\nsuper ");
    print_int(sc1);
    print(" ");
    print_int(sc2);
    print(" ");
    print_int(sr as i64);
    print(" ");
    print_int(sb as i64);

    print("\nwhere ");
    print_int(w_sc as i64);
    print(" ");
    print_int(w_cm);

    let m1 = multi(view(k), view(k));
    let m2 = multi(view(k1), view(k3));
    print("\nmulti ");
    print_int(m1);
    print(" ");
    print_int(m2);
    print("\n");

    // 6 + 18 + 16 + 2 = 42
    u1 + w_sc + sb + ((s2 + w_cm) as i32)
}
