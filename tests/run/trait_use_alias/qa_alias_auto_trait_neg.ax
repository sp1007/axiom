// test: ui
// T492 QA adversarial negative test:
// 1) Negative impl through an aliased user `auto trait` (`impl !MyMark for BadMark {}`) propagates structurally
//    to wrapper structs and rejects both the aliased bound `T: MyMark` and the canonical bound `T: m_auto.SafeMark`.
// 2) `Send` / `Share` checks after retiring 10007/10008 sentinels: safe impl rejection, `!Send` on `mut_view<T>`,
//    and `!Share` on `view<T>` passed to `T: Send`.

module m_auto

pub auto trait SafeMark {}

module main

use m_auto.SafeMark as MyMark

struct BadMark {
    pub v: i32,
}

impl !MyMark for BadMark {}

struct Holder {
    pub inner: BadMark,
}

struct SafeFail {
    pub ptr: *mut i32,
}

impl Send for SafeFail {} //~ ERROR AX_CONC_SAFE_SEND_SHARE_IMPL
impl Share for SafeFail {} //~ ERROR AX_CONC_SAFE_SEND_SHARE_IMPL

struct Pinned {
    pub v: i32,
}

impl !Send for Pinned {}

struct NoShare {
    pub v: i32,
}

impl !Share for NoShare {}

fn need_my_mark<T: MyMark>(_x: view<T>) {}
fn need_canon_mark<T: m_auto.SafeMark>(_x: view<T>) {}
fn need_send<T: Send>(_x: T) {}
fn need_share<T: Share>(_x: T) {}

fn main() -> i32 {
    let h = Holder { inner: BadMark { v: 1 } };
    need_my_mark(view(h)); //~ ERROR AX_TRAIT_UNSATISFIED_BOUND
    need_canon_mark(view(h)); //~ ERROR AX_TRAIT_UNSATISFIED_BOUND

    let mut p = Pinned { v: 2 };
    let mv_p = mut_view(p);
    need_send(mv_p); //~ ERROR AX_CONC_NOT_SEND

    let ns = NoShare { v: 3 };
    let v_ns = view(ns);
    need_send(v_ns); //~ ERROR AX_CONC_NOT_SEND
    need_share(ns); //~ ERROR AX_CONC_NOT_SHARE
    0
}
