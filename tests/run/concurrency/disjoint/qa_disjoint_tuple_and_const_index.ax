// test: run
// modes: interp native
// stdout: 95\n

module qa_disjoint_tuple_and_const_index

struct Arc<T> {
    pub inner: T,
}

fn par_join<A: FnOnce, B: FnOnce>(left: A, right: B) -> i32 {
    let l = left();
    let r = right();
    l + r
}

fn spawn_scoped<F: FnOnce>(f: F) -> i32 {
    f()
}

pub fn main() -> i32 {
    // 1. Disjoint tuple field projections (.0 vs .1) mutated in parallel:
    let mut tup = (10, 20);
    let f0 = mut_view(tup.0);
    let f1 = mut_view(tup.1);
    let r1 = par_join(
        || -> i32 { *f0 = *f0 + 5; *f0 },
        || -> i32 { *f1 = *f1 + 5; *f1 }
    );

    // 2. Disjoint constant array index projections ([0] vs [3]) mutated in parallel:
    let mut arr: [4]i32 = [2, 10, 15, 18];
    let e0 = mut_view(arr[0]);
    let e3 = mut_view(arr[3]);
    let r2 = par_join(
        || -> i32 { *e0 = *e0 + 3; *e0 },
        || -> i32 { *e3 = *e3 + 2; *e3 }
    );

    // 3. Arc<i32> is Share because i32 is Share; read-only views across threads are valid:
    let shared_arc = Arc { inner: 15 };
    let va = view(shared_arc);
    let s1 = spawn_scoped(|| -> i32 { (*va).inner });
    let s2 = spawn_scoped(|| -> i32 { (*va).inner });

    // r1 = 15 + 25 = 40
    // r2 = 5 + 20 = 25
    // s1 + s2 = 15 + 15 = 30
    // total = 40 + 25 + 30 = 95
    print_int(r1 + r2 + s1 + s2);
    print("\n");
    0
}
