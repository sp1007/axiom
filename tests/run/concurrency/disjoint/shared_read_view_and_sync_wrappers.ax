// test: run
// modes: interp native
// stdout: 120\n

module test_shared_read_view_and_sync_wrappers

struct Config {
    pub base: i32,
    pub scale: i32,
}

struct Mutex {
    pub locked_val: i32,
}

struct AtomicI32 {
    pub v: i32,
}

fn par_join<A: FnOnce, B: FnOnce>(left: A, right: B) -> i32 {
    left() + right()
}

fn spawn_scoped<F: FnOnce>(f: F) -> i32 {
    f()
}

pub fn main() -> i32 {
    // 1. Concurrent READ/READ sharing via `view<Config>` where `Config: Share`:
    let cfg = Config { base: 15, scale: 2 };
    let vcfg = view(cfg);
    let r1 = par_join(
        || -> i32 { (*vcfg).base * (*vcfg).scale },
        || -> i32 { (*vcfg).base + (*vcfg).scale }
    );

    // 2. Sibling `spawn_scoped` tasks sharing `view<Config>`:
    let s1 = spawn_scoped(|| -> i32 { (*vcfg).base });
    let s2 = spawn_scoped(|| -> i32 { (*vcfg).scale });

    // 3. Concurrent access through `Mutex` and `AtomicI32` synchronization wrappers:
    let mtx = Mutex { locked_val: 20 };
    let vmtx = view(mtx);
    let atom = AtomicI32 { v: 8 };
    let vatom = view(atom);
    let r2 = par_join(
        || -> i32 { (*vmtx).locked_val + (*vatom).v },
        || -> i32 { (*vmtx).locked_val + (*vatom).v }
    );

    // r1 = 30 + 17 = 47
    // s1 + s2 = 15 + 2 = 17
    // r2 = 28 + 28 = 56
    // total = 47 + 17 + 56 = 120
    print_int(r1 + s1 + s2 + r2);
    print("\n");
    0
}
