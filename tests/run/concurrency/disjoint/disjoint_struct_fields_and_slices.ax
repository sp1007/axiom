// test: run
// modes: interp native
// stdout: 142\n

module test_disjoint_struct_fields_and_slices

struct Leaf {
    pub x: i32,
    pub y: i32,
}

struct TreePair {
    pub left: Leaf,
    pub right: Leaf,
}

struct Counters {
    pub a: i32,
    pub b: i32,
}

fn par_join<A: FnOnce, B: FnOnce>(left: A, right: B) -> i32 {
    let l = left();
    let r = right();
    l + r
}

pub fn main() -> i32 {
    // 1. Concurrent `mut_view` borrows of disjoint struct fields `c.a` and `c.b`:
    let mut c = Counters { a: 10, b: 20 };
    let ma = mut_view(c.a);
    let mb = mut_view(c.b);
    let r1 = par_join(
        || -> i32 { *ma = *ma + 5; *ma },
        || -> i32 { *mb = *mb + 7; *mb }
    );

    // 2. Inline closure mutation of disjoint struct fields `c2.a` and `c2.b`:
    let mut c2 = Counters { a: 15, b: 27 };
    let r2 = par_join(
        || -> i32 { c2.a = c2.a + 3; c2.a },
        || -> i32 { c2.b = c2.b + 4; c2.b }
    );

    // 3. Nested disjoint struct fields `tp.left.x` vs `tp.right.x`:
    let mut tp = TreePair {
        left: Leaf { x: 2, y: 3 },
        right: Leaf { x: 4, y: 5 },
    };
    let mlx = mut_view(tp.left.x);
    let mrx = mut_view(tp.right.x);
    let r3 = par_join(
        || -> i32 { *mlx = *mlx * 3; *mlx },
        || -> i32 { *mrx = *mrx * 3; *mrx }
    );

    // 4. Disjoint constant mutable slice sub-ranges `ms0[0..2]` and `ms0[2..4]`:
    let mut arr: [4]i32 = [1, 2, 3, 4];
    let ms0: mut_view<[i32]> = mut_view(arr);
    let mut s_lo = ms0[0..2];
    let mut s_hi = ms0[2..4];
    let r4 = par_join(
        || -> i32 { s_lo[0] = s_lo[0] + 2; s_lo[1] = s_lo[1] + 2; s_lo[0] + s_lo[1] },
        || -> i32 { s_hi[0] = s_hi[0] + 3; s_hi[1] = s_hi[1] + 3; s_hi[0] + s_hi[1] }
    );

    // 5. Symbolic split mutable sub-slices `ms[..mid]` and `ms[mid..]`:
    let mut arr2: [4]i32 = [2, 3, 4, 5];
    let ms: mut_view<[i32]> = mut_view(arr2);
    let mid: usize = 2;
    let mut sp_lo = ms[..mid];
    let mut sp_hi = ms[mid..];
    let r5 = par_join(
        || -> i32 { sp_lo[0] = sp_lo[0] + 1; sp_lo[1] = sp_lo[1] + 1; sp_lo[0] + sp_lo[1] },
        || -> i32 { sp_hi[0] = sp_hi[0] + 1; sp_hi[1] = sp_hi[1] + 1; sp_hi[0] + sp_hi[1] }
    );

    print_int(r1 + r2 + r3 + r4 + (r5 - 5));
    print("\n");
    0
}
