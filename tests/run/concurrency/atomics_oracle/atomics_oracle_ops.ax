// test: run
// modes: interp native
// stdout: ops:ok\nwrap:ok\nweak_cas:ok\nptr:ok\nlock_free:ok\n

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

fn test_all_widths_and_ops() -> bool {
    let ab = AtomicBool.new(false);
    if ab.load(Ordering.SeqCst) { return false; }
    ab.store(true, Ordering.Release);
    if !ab.load(Ordering.Acquire) { return false; }
    let prev_b = ab.swap(false, Ordering.AcqRel);
    if !prev_b || ab.load(Ordering.Relaxed) { return false; }
    let prev_or_b = ab.fetch_or(true, Ordering.SeqCst);
    if prev_or_b || !ab.load(Ordering.SeqCst) { return false; }
    let prev_xor_b = ab.fetch_xor(true, Ordering.SeqCst);
    if !prev_xor_b || ab.load(Ordering.SeqCst) { return false; }
    let prev_and_b = ab.fetch_and(false, Ordering.SeqCst);
    if prev_and_b || ab.load(Ordering.SeqCst) { return false; }

    let a8 = AtomicU8.new(10u8);
    if a8.fetch_add(5u8, Ordering.SeqCst) != 10u8 { return false; }
    if a8.fetch_sub(3u8, Ordering.SeqCst) != 15u8 { return false; }
    if a8.load(Ordering.SeqCst) != 12u8 { return false; }

    let a16 = AtomicU16.new(1000u16);
    if a16.fetch_add(234u16, Ordering.Acquire) != 1000u16 { return false; }
    if a16.swap(500u16, Ordering.Release) != 1234u16 { return false; }
    if a16.into_inner() != 500u16 { return false; }

    let a32 = AtomicU32.new(0x0FF0u32);
    if a32.fetch_and(0x00FFu32, Ordering.AcqRel) != 0x0FF0u32 { return false; }
    if a32.fetch_or(0xF000u32, Ordering.AcqRel) != 0x00F0u32 { return false; }
    if a32.fetch_xor(0xFFFFu32, Ordering.AcqRel) != 0xF0F0u32 { return false; }
    if a32.load(Ordering.SeqCst) != 0x0F0Fu32 { return false; }

    let a64 = AtomicU64.new(100u64);
    let cas1 = a64.compare_exchange(100u64, 200u64, Ordering.AcqRel, Ordering.Acquire);
    if !cas1.ok || cas1.val != 100u64 { return false; }
    let cas2 = a64.compare_exchange(100u64, 300u64, Ordering.AcqRel, Ordering.Acquire);
    if cas2.ok || cas2.val != 200u64 { return false; }
    if a64.load(Ordering.SeqCst) != 200u64 { return false; }

    let ai8 = AtomicI8.new(-10i8);
    if ai8.fetch_add(25i8, Ordering.SeqCst) != -10i8 { return false; }
    if ai8.load(Ordering.SeqCst) != 15i8 { return false; }

    let ai16 = AtomicI16.new(-300i16);
    if ai16.fetch_sub(200i16, Ordering.SeqCst) != -300i16 { return false; }
    if ai16.load(Ordering.SeqCst) != -500i16 { return false; }

    let ai32 = AtomicI32.new(-50i32);
    if ai32.fetch_add(70i32, Ordering.SeqCst) != -50i32 { return false; }
    if ai32.load(Ordering.SeqCst) != 20i32 { return false; }

    let ai64 = AtomicI64.new(-1000i64);
    if ai64.swap(2000i64, Ordering.SeqCst) != -1000i64 { return false; }
    if ai64.load(Ordering.SeqCst) != 2000i64 { return false; }

    let aus = AtomicUsize.new(7usize);
    if aus.fetch_add(8usize, Ordering.SeqCst) != 7usize { return false; }
    if aus.load(Ordering.SeqCst) != 15usize { return false; }

    let ais = AtomicIsize.new(-7isize);
    if ais.fetch_add(10isize, Ordering.SeqCst) != -7isize { return false; }
    if ais.load(Ordering.SeqCst) != 3isize { return false; }

    fence(Ordering.Acquire);
    fence(Ordering.Release);
    fence(Ordering.AcqRel);
    fence(Ordering.SeqCst);
    compiler_fence(Ordering.Acquire);
    compiler_fence(Ordering.Release);
    compiler_fence(Ordering.AcqRel);
    compiler_fence(Ordering.SeqCst);
    spin_loop_hint();
    true
}

fn test_wrapping_overflow() -> bool {
    let u8_max = AtomicU8.new(255u8);
    if u8_max.fetch_add(1u8, Ordering.SeqCst) != 255u8 { return false; }
    if u8_max.load(Ordering.SeqCst) != 0u8 { return false; }
    if u8_max.fetch_sub(1u8, Ordering.SeqCst) != 0u8 { return false; }
    if u8_max.load(Ordering.SeqCst) != 255u8 { return false; }

    let u16_max = AtomicU16.new(65535u16);
    if u16_max.fetch_add(2u16, Ordering.SeqCst) != 65535u16 { return false; }
    if u16_max.load(Ordering.SeqCst) != 1u16 { return false; }

    let u32_max = AtomicU32.new(0xFFFFFFFFu32);
    if u32_max.fetch_add(1u32, Ordering.SeqCst) != 0xFFFFFFFFu32 { return false; }
    if u32_max.load(Ordering.SeqCst) != 0u32 { return false; }
    if u32_max.fetch_sub(1u32, Ordering.SeqCst) != 0u32 { return false; }
    if u32_max.load(Ordering.SeqCst) != 0xFFFFFFFFu32 { return false; }

    let u64_max = AtomicU64.new(0xFFFFFFFFFFFFFFFFu64);
    if u64_max.fetch_add(1u64, Ordering.SeqCst) != 0xFFFFFFFFFFFFFFFFu64 { return false; }
    if u64_max.load(Ordering.SeqCst) != 0u64 { return false; }
    if u64_max.fetch_sub(1u64, Ordering.SeqCst) != 0u64 { return false; }
    if u64_max.load(Ordering.SeqCst) != 0xFFFFFFFFFFFFFFFFu64 { return false; }

    let i8_max = AtomicI8.new(127i8);
    if i8_max.fetch_add(1i8, Ordering.SeqCst) != 127i8 { return false; }
    if i8_max.load(Ordering.SeqCst) != -128i8 { return false; }
    if i8_max.fetch_sub(1i8, Ordering.SeqCst) != -128i8 { return false; }
    if i8_max.load(Ordering.SeqCst) != 127i8 { return false; }
    true
}

fn test_compare_exchange_weak_retry_loop() -> bool {
    let counter = AtomicU64.new(0u64);
    let mut target_increments: u64 = 0u64;
    let mut total_attempts: u64 = 0u64;
    while target_increments < 16u64 {
        let mut cur = counter.load(Ordering.Relaxed);
        while true {
            total_attempts = total_attempts + 1u64;
            let res = counter.compare_exchange_weak(cur, cur + 1u64, Ordering.AcqRel, Ordering.Relaxed);
            if res.ok {
                break;
            }
            cur = res.val;
            spin_loop_hint();
        }
        target_increments = target_increments + 1u64;
    }
    if counter.load(Ordering.SeqCst) != 16u64 {
        return false;
    }
    if total_attempts < 16u64 {
        return false;
    }
    true
}

fn test_atomic_raw_ptr() -> bool {
    let mut a: u64 = 111u64;
    let mut b: u64 = 222u64;
    let pa: *mut u64 = unsafe { address_of_mut(a) };
    let pb: *mut u64 = unsafe { address_of_mut(b) };

    let aptr: Atomic<*mut u64> = Atomic.new(pa);
    if (aptr.load(Ordering.Acquire) as usize) != (pa as usize) { return false; }
    let old = aptr.swap(pb, Ordering.AcqRel);
    if (old as usize) != (pa as usize) { return false; }
    let cas = aptr.compare_exchange(pb, pa, Ordering.AcqRel, Ordering.Acquire);
    if !cas.ok || (cas.val as usize) != (pb as usize) { return false; }
    let cur = aptr.load(Ordering.Acquire);
    let read_a = unsafe { *cur };
    read_a == 111u64
}

fn test_lock_free() -> bool {
    is_lock_free<bool>() &&
    is_lock_free<u8>() &&
    is_lock_free<u16>() &&
    is_lock_free<u32>() &&
    is_lock_free<u64>() &&
    is_lock_free<usize>() &&
    is_lock_free<i8>() &&
    is_lock_free<i16>() &&
    is_lock_free<i32>() &&
    is_lock_free<i64>() &&
    is_lock_free<isize>() &&
    is_lock_free<*mut u8>()
}

pub fn main() -> i32 {
    if !test_all_widths_and_ops() { return 1; }
    print("ops:ok\n");
    if !test_wrapping_overflow() { return 2; }
    print("wrap:ok\n");
    if !test_compare_exchange_weak_retry_loop() { return 3; }
    print("weak_cas:ok\n");
    if !test_atomic_raw_ptr() { return 4; }
    print("ptr:ok\n");
    if !test_lock_free() { return 5; }
    print("lock_free:ok\n");
    0
}
