// test: run
// modes: interp native
// stdout: mp:ok\nmp_fence:ok\nsb:ok\nsb_fence:ok\nrel_seq:ok\nspinlock:ok\n

struct MpState {
    pub payload: u64,
    pub saw_flag: u32,
    pub observed: u64,
}

fn thread_0_mp(s: mut_view<MpState>, flag: view<AtomicU32>) {
    s.payload = 42u64;
    flag.store(1u32, Ordering.Release);
}

fn thread_1_mp(s: mut_view<MpState>, flag: view<AtomicU32>) {
    let f = flag.load(Ordering.Acquire);
    if f == 1u32 {
        s.saw_flag = 1u32;
        s.observed = s.payload;
    }
}

fn test_mp() -> bool {
    let mut iter: u32 = 0u32;
    let mut saw_published: u32 = 0u32;
    while iter < 16u32 {
        let mut s = MpState {
            payload: 0u64,
            saw_flag: 0u32,
            observed: 0u64,
        };
        let flag = AtomicU32.new(0u32);
        thread_0_mp(mut_view(s), view(flag));
        thread_1_mp(mut_view(s), view(flag));
        if s.saw_flag == 1u32 {
            if s.observed != 42u64 {
                return false;
            }
            saw_published = saw_published + 1u32;
        }
        iter = iter + 1u32;
    }
    saw_published > 0u32
}

fn thread_0_mp_fence(s: mut_view<MpState>, flag: view<AtomicU32>) {
    s.payload = 99u64;
    fence(Ordering.Release);
    flag.store(1u32, Ordering.Relaxed);
}

fn thread_1_mp_fence(s: mut_view<MpState>, flag: view<AtomicU32>) {
    let f = flag.load(Ordering.Relaxed);
    if f == 1u32 {
        fence(Ordering.Acquire);
        s.saw_flag = 1u32;
        s.observed = s.payload;
    }
}

fn test_mp_fence() -> bool {
    let mut iter: u32 = 0u32;
    let mut saw_published: u32 = 0u32;
    while iter < 16u32 {
        let mut s = MpState {
            payload: 0u64,
            saw_flag: 0u32,
            observed: 0u64,
        };
        let flag = AtomicU32.new(0u32);
        thread_0_mp_fence(mut_view(s), view(flag));
        thread_1_mp_fence(mut_view(s), view(flag));
        if s.saw_flag == 1u32 {
            if s.observed != 99u64 {
                return false;
            }
            saw_published = saw_published + 1u32;
        }
        iter = iter + 1u32;
    }
    saw_published > 0u32
}

struct SbState {
    pub r0: u32,
    pub r1: u32,
}

fn thread_0_sb(s: mut_view<SbState>, x: view<AtomicU32>, y: view<AtomicU32>) {
    x.store(1u32, Ordering.SeqCst);
    s.r0 = y.load(Ordering.SeqCst);
}

fn thread_1_sb(s: mut_view<SbState>, x: view<AtomicU32>, y: view<AtomicU32>) {
    y.store(1u32, Ordering.SeqCst);
    s.r1 = x.load(Ordering.SeqCst);
}

fn test_sb() -> bool {
    let mut iter: u32 = 0u32;
    while iter < 32u32 {
        let mut s = SbState {
            r0: 0u32,
            r1: 0u32,
        };
        let x = AtomicU32.new(0u32);
        let y = AtomicU32.new(0u32);
        thread_0_sb(mut_view(s), view(x), view(y));
        thread_1_sb(mut_view(s), view(x), view(y));
        if s.r0 == 0u32 && s.r1 == 0u32 {
            return false;
        }
        iter = iter + 1u32;
    }
    true
}

fn thread_0_sb_fence(s: mut_view<SbState>, x: view<AtomicU32>, y: view<AtomicU32>) {
    x.store(1u32, Ordering.Relaxed);
    fence(Ordering.SeqCst);
    s.r0 = y.load(Ordering.Relaxed);
}

fn thread_1_sb_fence(s: mut_view<SbState>, x: view<AtomicU32>, y: view<AtomicU32>) {
    y.store(1u32, Ordering.Relaxed);
    fence(Ordering.SeqCst);
    s.r1 = x.load(Ordering.Relaxed);
}

fn test_sb_fence() -> bool {
    let mut iter: u32 = 0u32;
    while iter < 32u32 {
        let mut s = SbState {
            r0: 0u32,
            r1: 0u32,
        };
        let x = AtomicU32.new(0u32);
        let y = AtomicU32.new(0u32);
        thread_0_sb_fence(mut_view(s), view(x), view(y));
        thread_1_sb_fence(mut_view(s), view(x), view(y));
        if s.r0 == 0u32 && s.r1 == 0u32 {
            return false;
        }
        iter = iter + 1u32;
    }
    true
}

struct RelSeqState {
    pub payload: u64,
    pub observed: u64,
    pub final_seq: u32,
}

fn thread_0_rel_seq(s: mut_view<RelSeqState>, seq: view<AtomicU32>) {
    s.payload = 777u64;
    seq.store(1u32, Ordering.Release);
}

fn thread_1_rel_seq(seq: view<AtomicU32>) {
    let v = seq.load(Ordering.Relaxed);
    if v == 1u32 {
        let _ = seq.fetch_add(1u32, Ordering.Relaxed);
    }
}

fn thread_2_rel_seq(s: mut_view<RelSeqState>, seq: view<AtomicU32>) {
    let v = seq.load(Ordering.Acquire);
    s.final_seq = v;
    if v >= 1u32 {
        s.observed = s.payload;
    }
}

fn test_release_sequence() -> bool {
    let mut iter: u32 = 0u32;
    while iter < 16u32 {
        let mut s = RelSeqState {
            payload: 0u64,
            observed: 0u64,
            final_seq: 0u32,
        };
        let seq = AtomicU32.new(0u32);
        thread_0_rel_seq(mut_view(s), view(seq));
        thread_1_rel_seq(view(seq));
        thread_2_rel_seq(mut_view(s), view(seq));
        if s.final_seq >= 1u32 && s.observed != 777u64 {
            return false;
        }
        iter = iter + 1u32;
    }
    true
}

struct SpinLockState {
    pub shared_counter: u64,
}

fn thread_0_spin(s: mut_view<SpinLockState>, lock: view<AtomicU32>) {
    while true {
        let res = lock.compare_exchange_weak(0u32, 1u32, Ordering.Acquire, Ordering.Relaxed);
        if res.ok {
            break;
        }
        spin_loop_hint();
    }
    let cur = s.shared_counter;
    s.shared_counter = cur + 10u64;
    lock.store(0u32, Ordering.Release);
}

fn thread_1_spin(s: mut_view<SpinLockState>, lock: view<AtomicU32>) {
    while true {
        let res = lock.compare_exchange_weak(0u32, 1u32, Ordering.Acquire, Ordering.Relaxed);
        if res.ok {
            break;
        }
        spin_loop_hint();
    }
    let cur = s.shared_counter;
    s.shared_counter = cur + 20u64;
    lock.store(0u32, Ordering.Release);
}

fn test_spinlock() -> bool {
    let mut iter: u32 = 0u32;
    while iter < 16u32 {
        let mut s = SpinLockState {
            shared_counter: 0u64,
        };
        let lock = AtomicU32.new(0u32);
        thread_0_spin(mut_view(s), view(lock));
        thread_1_spin(mut_view(s), view(lock));
        if s.shared_counter != 30u64 {
            return false;
        }
        iter = iter + 1u32;
    }
    true
}

pub fn main() -> i32 {
    if !test_mp() { return 1; }
    print("mp:ok\n");
    if !test_mp_fence() { return 2; }
    print("mp_fence:ok\n");
    if !test_sb() { return 3; }
    print("sb:ok\n");
    if !test_sb_fence() { return 4; }
    print("sb_fence:ok\n");
    if !test_release_sequence() { return 5; }
    print("rel_seq:ok\n");
    if !test_spinlock() { return 6; }
    print("spinlock:ok\n");
    0
}
