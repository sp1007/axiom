// test: run
// modes: interp
// exit: 125
// stderr-contains: AX_UNSAFE_INTERP_UB

struct UnsyncState {
    pub payload: u64,
    pub observed: u64,
}

fn thread_0_writer(s: mut_view<UnsyncState>, flag: view<AtomicU32>) {
    s.payload = 42u64;
    flag.store(1u32, Ordering.Relaxed);
}

fn thread_1_reader(s: mut_view<UnsyncState>, flag: view<AtomicU32>) {
    let _ = flag.load(Ordering.Relaxed);
    s.observed = s.payload;
}

pub fn main() -> i32 {
    let mut s = UnsyncState {
        payload: 0u64,
        observed: 0u64,
    };
    let flag = AtomicU32.new(0u32);
    thread_0_writer(mut_view(s), view(flag));
    thread_1_reader(mut_view(s), view(flag));
    0
}
