// test: run
// modes: interp
// exit: 125
// stderr-contains: AX_UNSAFE_INTERP_UB

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

fn thread_0_atomic(cell: view<AtomicU64>) {
    cell.store(100u64, Ordering.Relaxed);
}

fn thread_1_ordinary(raw: *mut u64) {
    unsafe {
        *raw = 200u64;
    }
}

pub fn main() -> i32 {
    let mut cell = AtomicU64.new(0u64);
    let p_cell: *mut Atomic<u64> = unsafe { address_of_mut(cell) };
    let raw: *mut u64 = p_cell as *mut u64;
    thread_0_atomic(view(cell));
    thread_1_ordinary(raw);
    0
}
