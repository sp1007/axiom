// test: run
// modes: interp native
// stdout: corr:ok\nlb:ok\nstrong_vs_weak_cas:ok\naba_tag:ok\nsigned_wrap:ok\n

fn oracle_set_seed(seed: u64) {
    let _ = seed;
}

fn oracle_join_all() {}

struct CorrState {
    pub r1: u32,
    pub r2: u32,
}

fn thread_0_corr(x: view<AtomicU32>) {
    x.store(1u32, Ordering.Relaxed);
    x.store(2u32, Ordering.Relaxed);
}

fn thread_1_corr(s: mut_view<CorrState>, x: view<AtomicU32>) {
    s.r1 = x.load(Ordering.Relaxed);
    s.r2 = x.load(Ordering.Relaxed);
}

fn test_corr_coherence() -> bool {
    let mut seed: u64 = 1u64;
    while seed <= 16u64 {
        oracle_set_seed(seed);
        let mut s = CorrState {
            r1: 0u32,
            r2: 0u32,
        };
        let x = AtomicU32.new(0u32);
        thread_0_corr(view(x));
        thread_1_corr(mut_view(s), view(x));
        oracle_join_all();
        if s.r1 > s.r2 {
            return false;
        }
        seed = seed + 1u64;
    }
    true
}

struct LbState {
    pub r0: u32,
    pub r1: u32,
}

fn thread_0_lb(s: mut_view<LbState>, x: view<AtomicU32>, y: view<AtomicU32>) {
    let v = x.load(Ordering.Acquire);
    s.r0 = v;
    y.store(v, Ordering.Release);
}

fn thread_1_lb(s: mut_view<LbState>, x: view<AtomicU32>, y: view<AtomicU32>) {
    let v = y.load(Ordering.Acquire);
    s.r1 = v;
    x.store(v, Ordering.Release);
}

fn test_load_buffering_no_oota() -> bool {
    let mut iter: u32 = 0u32;
    while iter < 16u32 {
        let mut s = LbState {
            r0: 99u32,
            r1: 99u32,
        };
        let x = AtomicU32.new(0u32);
        let y = AtomicU32.new(0u32);
        thread_0_lb(mut_view(s), view(x), view(y));
        thread_1_lb(mut_view(s), view(x), view(y));
        if s.r0 != 0u32 || s.r1 != 0u32 {
            return false;
        }
        iter = iter + 1u32;
    }
    true
}

fn test_strong_vs_weak_cas_liveness() -> bool {
    let strong_cell = AtomicU64.new(10u64);
    let r_strong = strong_cell.compare_exchange(10u64, 20u64, Ordering.SeqCst, Ordering.SeqCst);
    if !r_strong.ok || r_strong.val != 10u64 {
        return false;
    }
    if strong_cell.load(Ordering.SeqCst) != 20u64 {
        return false;
    }

    let weak_cell = AtomicU64.new(100u64);
    let mut attempts: u32 = 0u32;
    while attempts < 4u32 {
        attempts = attempts + 1u32;
        let r_weak = weak_cell.compare_exchange_weak(100u64, 200u64, Ordering.AcqRel, Ordering.Acquire);
        if r_weak.ok {
            break;
        }
        if r_weak.val != 100u64 {
            return false;
        }
    }
    if weak_cell.load(Ordering.SeqCst) != 200u64 || attempts > 2u32 {
        return false;
    }
    true
}

fn pack_tagged(tag: u32, idx: u32) -> u64 {
    ((tag as u64) << 32u64) | (idx as u64)
}

fn test_aba_tagged_detection() -> bool {
    let head = AtomicU64.new(pack_tagged(1u32, 10u32));
    let observed = head.load(Ordering.Acquire);

    // Simulate A -> B -> A with monotonic tag increments (tag 1 -> 2 -> 3)
    let c1 = head.compare_exchange(pack_tagged(1u32, 10u32), pack_tagged(2u32, 20u32), Ordering.AcqRel, Ordering.Acquire);
    if !c1.ok {
        return false;
    }
    let c2 = head.compare_exchange(pack_tagged(2u32, 20u32), pack_tagged(3u32, 10u32), Ordering.AcqRel, Ordering.Acquire);
    if !c2.ok {
        return false;
    }

    // Stale CAS expecting (tag=1, idx=10) must fail and return (tag=3, idx=10)
    let stale = head.compare_exchange(observed, pack_tagged(2u32, 99u32), Ordering.AcqRel, Ordering.Acquire);
    if stale.ok || stale.val != pack_tagged(3u32, 10u32) {
        return false;
    }
    true
}

fn test_signed_wrapping_boundaries() -> bool {
    let a16 = AtomicI16.new(32767i16);
    if a16.fetch_add(1i16, Ordering.SeqCst) != 32767i16 { return false; }
    if a16.load(Ordering.SeqCst) != -32768i16 { return false; }
    if a16.fetch_sub(1i16, Ordering.SeqCst) != -32768i16 { return false; }
    if a16.load(Ordering.SeqCst) != 32767i16 { return false; }

    let a32 = AtomicI32.new(2147483647i32);
    if a32.fetch_add(1i32, Ordering.SeqCst) != 2147483647i32 { return false; }
    if a32.load(Ordering.SeqCst) != (-2147483647i32 - 1i32) { return false; }
    if a32.fetch_sub(1i32, Ordering.SeqCst) != (-2147483647i32 - 1i32) { return false; }
    if a32.load(Ordering.SeqCst) != 2147483647i32 { return false; }

    let a64 = AtomicI64.new(9223372036854775807i64);
    if a64.fetch_add(1i64, Ordering.SeqCst) != 9223372036854775807i64 { return false; }
    if a64.load(Ordering.SeqCst) != (-9223372036854775807i64 - 1i64) { return false; }
    if a64.fetch_sub(1i64, Ordering.SeqCst) != (-9223372036854775807i64 - 1i64) { return false; }
    if a64.load(Ordering.SeqCst) != 9223372036854775807i64 { return false; }
    true
}

pub fn main() -> i32 {
    if !test_corr_coherence() { return 1; }
    print("corr:ok\n");
    if !test_load_buffering_no_oota() { return 2; }
    print("lb:ok\n");
    if !test_strong_vs_weak_cas_liveness() { return 3; }
    print("strong_vs_weak_cas:ok\n");
    if !test_aba_tagged_detection() { return 4; }
    print("aba_tag:ok\n");
    if !test_signed_wrapping_boundaries() { return 5; }
    print("signed_wrap:ok\n");
    0
}
