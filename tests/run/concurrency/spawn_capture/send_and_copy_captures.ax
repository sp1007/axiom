// test: run
// modes: interp native
// stdout: 100\n

module test_send_and_copy_captures

@derive(Copy)
struct Config {
    pub scale: i32,
    pub offset: i32,
}

struct OwnedPacket {
    pub payload: i32,
}

struct LocalRc {
    pub refs: usize,
}

impl !Send for LocalRc {}

fn spawn<F: FnOnce + Send>(f: F) -> i32 {
    f()
}

pub fn main() -> i32 {
    // Uncaptured !Send locals in the enclosing scope must NOT taint closure Send (0116 §84):
    let _uncaptured_ptr: *mut u8 = 0 as *mut u8;
    let _uncaptured_rc = LocalRc { refs: 1 };

    let pkt = OwnedPacket { payload: 30 };
    let cfg = Config { scale: 2, offset: 10 };
    let bonus: i32 = 15;

    let res = spawn(|| -> i32 {
        pkt.payload * cfg.scale + cfg.offset + bonus
    });

    // Copy captures (`cfg` and `bonus`) remain usable in the parent scope after `spawn`:
    let total = res + cfg.offset + bonus - 10;
    print_int(total);
    print("\n");
    0
}
