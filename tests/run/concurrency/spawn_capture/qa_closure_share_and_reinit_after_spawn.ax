// test: run
// modes: interp native
// stdout: 92\n

module test_qa_closure_share_and_reinit_after_spawn

struct SendOnlyJob {
    pub amount: i32,
}

impl !Share for SendOnlyJob {}

fn spawn<F: FnOnce + Send>(f: F) -> i32 {
    f()
}

fn run_send_share<F: FnOnce + Send + Share>(f: F) -> i32 {
    f()
}

pub fn main() -> i32 {
    // 1. Closure capturing only Send + Share values derives both Send and Share:
    let base: i32 = 20;
    let factor: i32 = 3;
    let r1 = run_send_share(|| -> i32 {
        base * factor
    });

    // 2. Closure capturing `Send + !Share` struct still satisfies `Send` for `spawn`:
    let mut job = SendOnlyJob { amount: 12 };
    let r2 = spawn(|| -> i32 {
        job.amount
    });

    // 3. Reassigning `job` after move into `spawn` reinitializes the binding for a subsequent `spawn`:
    job = SendOnlyJob { amount: 20 };
    let r3 = spawn(|| -> i32 {
        job.amount
    });

    print_int(r1 + r2 + r3);
    print("\n");
    0
}
