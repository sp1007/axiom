// test: run
// modes: interp native
// stdout: 55\n

module test_spawn_local_non_send

struct LocalTaskData {
    pub raw_tag: *mut u8,
    pub value: i32,
}

impl !Send for LocalTaskData {}

fn spawn_local<F: FnOnce>(f: F) -> i32 {
    f()
}

pub fn main() -> i32 {
    let data = LocalTaskData {
        raw_tag: 0 as *mut u8,
        value: 40,
    };
    let step: i32 = 15;

    let out = spawn_local(|| -> i32 {
        let _ = data.raw_tag;
        data.value + step
    });

    // `step` is Copy so it remains valid after `spawn_local`:
    if step != 15 {
        return 1;
    }
    print_int(out);
    print("\n");
    0
}
