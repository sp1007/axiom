// test: run
// modes: interp native
// stdout: 100 142 7\n

module main

@thread_local static mut COUNTER: i64 = 100i64;
@thread_local static mut VALUE: i32 = 7i32;

fn bump_counter() {
    COUNTER = COUNTER + 42i64;
}

pub fn main() -> i32 {
    print_int(COUNTER);
    print(" ");
    bump_counter();
    print_int(COUNTER);
    print(" ");
    print_int(VALUE as i64);
    print("\n");
    0
}
