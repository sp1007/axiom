// test: run
// modes: interp native
// stdout: 10 20 30 11 22 33\n

module main

@thread_local static mut VAL_A: i32 = 10i32;
@thread_local static mut VAL_B: i64 = 20i64;
@thread_local static mut VAL_C: u8 = 30u8;

fn bump() {
    VAL_A = VAL_A + 1i32;
    VAL_B = VAL_B + 2i64;
    VAL_C = VAL_C + 3u8;
}

pub fn main() -> i32 {
    print_int(VAL_A as i64);
    print(" ");
    print_int(VAL_B);
    print(" ");
    print_int(VAL_C as i64);
    print(" ");
    bump();
    print_int(VAL_A as i64);
    print(" ");
    print_int(VAL_B);
    print(" ");
    print_int(VAL_C as i64);
    print("\n");
    0
}
