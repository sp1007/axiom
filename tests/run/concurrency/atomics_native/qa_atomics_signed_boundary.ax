// QA boundary test (T407): signed sub-64-bit atomics (AtomicI8, AtomicI16, AtomicI32, AtomicIsize)
// sign-extension and INT_MAX/INT_MIN wraparound across load, store, swap, fetch_add, fetch_sub,
// fetch_and, fetch_or, fetch_xor, compare_exchange, and compare_exchange_weak.
//
// test: run
// modes: native
// stdout: OK qa_atomics_signed_boundary -1 -2 -3 -4\n

@intrinsic fn assert(cond: bool) {}

fn check(cond: bool) {
    assert(cond);
}

fn test_atomic_i8_signed() -> i64 {
    let a = AtomicI8.new(127i8);
    let old_max = a.fetch_add(1i8, Ordering.SeqCst);
    check(old_max == 127i8);
    let min_v = a.load(Ordering.Acquire);
    check(min_v < 0i8 && min_v == (-127i8 - 1i8));

    let old_min = a.fetch_sub(1i8, Ordering.AcqRel);
    check(old_min == (-127i8 - 1i8));
    check(a.load(Ordering.Relaxed) == 127i8);

    a.store(-5i8, Ordering.SeqCst);
    let loaded = a.load(Ordering.Acquire);
    check(a.load(Ordering.SeqCst) == -5i8 && loaded < 0i8);

    let prev = a.swap(-1i8, Ordering.AcqRel);
    check(prev == -5i8 && prev < 0i8);

    let r_and = a.fetch_and(-2i8, Ordering.Relaxed);
    check(r_and == -1i8);
    check(a.load(Ordering.Relaxed) == -2i8);

    let r_or = a.fetch_or(1i8, Ordering.Release);
    check(r_or == -2i8);
    check(a.load(Ordering.Acquire) == -1i8);

    let r_xor = a.fetch_xor(0i8, Ordering.SeqCst);
    check(r_xor == -1i8);

    let cas_ok = a.compare_exchange(-1i8, -10i8, Ordering.SeqCst, Ordering.Acquire);
    let ok_val = cas_ok.val;
    check(cas_ok.ok && ok_val == -1i8 && ok_val < 0i8);
    let cas_fail = a.compare_exchange(-1i8, 0i8, Ordering.AcqRel, Ordering.Relaxed);
    let fail_val = cas_fail.val;
    check(!cas_fail.ok && fail_val == -10i8 && fail_val < 0i8);

    let cas_w = a.compare_exchange_weak(-10i8, -1i8, Ordering.Release, Ordering.Relaxed);
    check(cas_w.ok && cas_w.val == -10i8);

    a.into_inner() as i64
}

fn test_atomic_i16_signed() -> i64 {
    let a = AtomicI16.new(32767i16);
    let old_max = a.fetch_add(1i16, Ordering.SeqCst);
    check(old_max == 32767i16);
    let min_v = a.load(Ordering.SeqCst);
    check(min_v < 0i16 && min_v == (-32767i16 - 1i16));

    let old_min = a.fetch_sub(1i16, Ordering.Release);
    check(old_min == (-32767i16 - 1i16));
    check(a.load(Ordering.Acquire) == 32767i16);

    let _ = a.swap(-100i16, Ordering.SeqCst);
    let r_and = a.fetch_and(-1i16, Ordering.AcqRel);
    check(r_and == -100i16 && r_and < 0i16);

    let r_or = a.fetch_or(-2i16, Ordering.Relaxed);
    check(r_or == -100i16);
    check(a.load(Ordering.Relaxed) == -2i16);

    let r_xor = a.fetch_xor(0i16, Ordering.SeqCst);
    check(r_xor == -2i16 && r_xor < 0i16);

    let cas_fail = a.compare_exchange(2i16, 0i16, Ordering.SeqCst, Ordering.Acquire);
    let fail_val = cas_fail.val;
    check(!cas_fail.ok && fail_val == -2i16 && fail_val < 0i16);

    a.into_inner() as i64
}

fn test_atomic_i32_signed() -> i64 {
    let a = AtomicI32.new(2147483647i32);
    let old_max = a.fetch_add(1i32, Ordering.SeqCst);
    check(old_max == 2147483647i32);
    let min_v = a.load(Ordering.Acquire);
    check(min_v < 0i32 && min_v == (-2147483647i32 - 1i32));

    let old_min = a.fetch_sub(1i32, Ordering.SeqCst);
    check(old_min == (-2147483647i32 - 1i32));
    check(a.load(Ordering.Relaxed) == 2147483647i32);

    a.store(-7i32, Ordering.SeqCst);
    let r_or = a.fetch_or(4i32, Ordering.AcqRel);
    check(r_or == -7i32 && r_or < 0i32);
    check(a.load(Ordering.Acquire) == -3i32);

    let cas_ok = a.compare_exchange(-3i32, -30i32, Ordering.SeqCst, Ordering.Acquire);
    let ok_val = cas_ok.val;
    check(cas_ok.ok && ok_val == -3i32 && ok_val < 0i32);
    let prev = a.swap(-3i32, Ordering.SeqCst);
    check(prev == -30i32 && prev < 0i32);

    a.into_inner() as i64
}

fn test_atomic_isize_signed() -> i64 {
    let a = AtomicIsize.new(-10isize);
    let old = a.fetch_add(6isize, Ordering.SeqCst);
    check(old == -10isize && old < 0isize);
    let cur = a.load(Ordering.Acquire);
    check(cur == -4isize);
    let cas = a.compare_exchange(-4isize, -4isize, Ordering.AcqRel, Ordering.Relaxed);
    check(cas.ok && cas.val == -4isize);
    a.into_inner() as i64
}

fn main() {
    let v1 = test_atomic_i8_signed();
    let v2 = test_atomic_i16_signed();
    let v3 = test_atomic_i32_signed();
    let v4 = test_atomic_isize_signed();
    check(v1 == -1i64 && v2 == -2i64 && v3 == -3i64 && v4 == -4i64);
    print("OK qa_atomics_signed_boundary -1 -2 -3 -4\n");
}
