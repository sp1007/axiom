// test: run
// modes: native
// stdout: OK atomics_native 8 16 32 64\n

@intrinsic fn assert(cond: bool) {}
@intrinsic unsafe fn address_of_mut<T>(x: T) -> *mut T { 0 as *mut T }

fn check(cond: bool, code: i32) {
    assert(cond);
    let _ = code;
}

fn test_atomic_bool() {
    let b = AtomicBool.new(false);
    check(!b.load(Ordering.Relaxed), 1);
    check(!b.load(Ordering.Acquire), 2);
    check(!b.load(Ordering.SeqCst), 3);

    b.store(true, Ordering.Release);
    check(b.load(Ordering.Acquire), 4);
    b.store(false, Ordering.SeqCst);
    check(!b.load(Ordering.SeqCst), 5);

    let prev0 = b.swap(true, Ordering.AcqRel);
    check(!prev0, 6);
    check(b.load(Ordering.Relaxed), 7);

    let prev1 = b.fetch_and(false, Ordering.SeqCst);
    check(prev1, 8);
    check(!b.load(Ordering.Relaxed), 9);

    let prev2 = b.fetch_or(true, Ordering.Acquire);
    check(!prev2, 10);
    check(b.load(Ordering.Relaxed), 11);

    let prev3 = b.fetch_xor(true, Ordering.Release);
    check(prev3, 12);
    check(!b.load(Ordering.Relaxed), 13);

    let cas_ok = b.compare_exchange(false, true, Ordering.SeqCst, Ordering.Acquire);
    check(cas_ok.ok && !cas_ok.val, 14);
    check(b.load(Ordering.SeqCst), 15);

    let cas_fail = b.compare_exchange(false, false, Ordering.AcqRel, Ordering.Relaxed);
    check(!cas_fail.ok && cas_fail.val, 16);
    check(b.load(Ordering.Relaxed), 17);

    let cas_w = b.compare_exchange_weak(true, false, Ordering.Release, Ordering.Relaxed);
    check(cas_w.ok && cas_w.val, 18);
    check(!b.into_inner(), 19);
}

fn test_atomic_u8() -> u32 {
    let a = AtomicU8.new(250u8);
    check(a.load(Ordering.Acquire) == 250u8, 20);
    a.store(255u8, Ordering.SeqCst);
    check(a.load(Ordering.SeqCst) == 255u8, 21);

    // Wrapping overflow: 255 + 1 -> 0, returns 255
    let old_add = a.fetch_add(1u8, Ordering.SeqCst);
    check(old_add == 255u8, 22);
    check(a.load(Ordering.Relaxed) == 0u8, 23);

    // Wrapping underflow: 0 - 1 -> 255, returns 0
    let old_sub = a.fetch_sub(1u8, Ordering.AcqRel);
    check(old_sub == 0u8, 24);
    check(a.load(Ordering.Acquire) == 255u8, 25);

    let old_and = a.fetch_and(0x0Fu8, Ordering.Relaxed);
    check(old_and == 255u8, 26);
    check(a.load(Ordering.Relaxed) == 0x0Fu8, 27);

    let old_or = a.fetch_or(0xA0u8, Ordering.Release);
    check(old_or == 0x0Fu8, 28);
    check(a.load(Ordering.Acquire) == 0xAFu8, 29);

    let old_xor = a.fetch_xor(0xFFu8, Ordering.SeqCst);
    check(old_xor == 0xAFu8, 30);
    check(a.load(Ordering.Relaxed) == 0x50u8, 31);

    let old_swap = a.swap(8u8, Ordering.SeqCst);
    check(old_swap == 0x50u8, 32);

    let c1 = a.compare_exchange(8u8, 18u8, Ordering.AcqRel, Ordering.Acquire);
    check(c1.ok && c1.val == 8u8, 33);
    let c2 = a.compare_exchange(8u8, 99u8, Ordering.AcqRel, Ordering.Acquire);
    check(!c2.ok && c2.val == 18u8, 34);

    (a.into_inner() - 10u8) as u32
}

fn test_atomic_u16() -> u32 {
    let a = AtomicU16.new(65535u16);
    check(a.load(Ordering.SeqCst) == 65535u16, 40);

    // Wrapping overflow: 65535 + 1 -> 0
    let old_add = a.fetch_add(1u16, Ordering.Acquire);
    check(old_add == 65535u16, 41);
    check(a.load(Ordering.Relaxed) == 0u16, 42);

    // Wrapping underflow: 0 - 1 -> 65535
    let old_sub = a.fetch_sub(1u16, Ordering.Release);
    check(old_sub == 0u16, 43);
    check(a.load(Ordering.SeqCst) == 65535u16, 44);

    let old_and = a.fetch_and(0x00FFu16, Ordering.AcqRel);
    check(old_and == 65535u16, 45);
    check(a.load(Ordering.Relaxed) == 0x00FFu16, 46);

    let old_or = a.fetch_or(0x1200u16, Ordering.Relaxed);
    check(old_or == 0x00FFu16, 47);
    check(a.load(Ordering.Relaxed) == 0x12FFu16, 48);

    let old_xor = a.fetch_xor(0x12F0u16, Ordering.SeqCst);
    check(old_xor == 0x12FFu16, 49);
    check(a.load(Ordering.Relaxed) == 0x000Fu16, 50);

    let c1 = a.compare_exchange(15u16, 16u16, Ordering.SeqCst, Ordering.Relaxed);
    check(c1.ok && c1.val == 15u16, 51);
    let c2 = a.compare_exchange(15u16, 99u16, Ordering.SeqCst, Ordering.Relaxed);
    check(!c2.ok && c2.val == 16u16, 52);

    a.into_inner() as u32
}

fn test_atomic_u32() -> u32 {
    let a = AtomicU32.new(0xFFFFFFFFu32);
    check(a.load(Ordering.Acquire) == 0xFFFFFFFFu32, 60);

    // Wrapping overflow: u32.MAX + 1 -> 0
    let old_add = a.fetch_add(1u32, Ordering.SeqCst);
    check(old_add == 0xFFFFFFFFu32, 61);
    check(a.load(Ordering.Relaxed) == 0u32, 62);

    // Wrapping underflow: 0 - 1 -> u32.MAX
    let old_sub = a.fetch_sub(1u32, Ordering.SeqCst);
    check(old_sub == 0u32, 63);
    check(a.load(Ordering.Relaxed) == 0xFFFFFFFFu32, 64);

    let old_and = a.fetch_and(0x0000FFFFu32, Ordering.Relaxed);
    check(old_and == 0xFFFFFFFFu32, 65);
    let old_or = a.fetch_or(0x00010000u32, Ordering.Relaxed);
    check(old_or == 0x0000FFFFu32, 66);
    let old_xor = a.fetch_xor(0x0001FFFFu32, Ordering.Relaxed);
    check(old_xor == 0x0001FFFFu32, 67);
    check(a.load(Ordering.Relaxed) == 0u32, 68);

    a.store(100u32, Ordering.Release);
    let prev = a.swap(32u32, Ordering.SeqCst);
    check(prev == 100u32, 69);

    let c1 = a.compare_exchange(32u32, 64u32, Ordering.AcqRel, Ordering.Acquire);
    check(c1.ok && c1.val == 32u32, 70);
    let c2 = a.compare_exchange(32u32, 128u32, Ordering.AcqRel, Ordering.Acquire);
    check(!c2.ok && c2.val == 64u32, 71);

    a.into_inner() - 32u32
}

fn test_atomic_u64_i64_usize_ptr() -> u32 {
    let a = AtomicU64.new(0xFFFFFFFFFFFFFFFFu64);
    // Wrapping overflow: u64.MAX + 1 -> 0
    let old_add = a.fetch_add(1u64, Ordering.SeqCst);
    check(old_add == 0xFFFFFFFFFFFFFFFFu64, 80);
    check(a.load(Ordering.Acquire) == 0u64, 81);

    // Wrapping underflow: 0 - 1 -> u64.MAX
    let old_sub = a.fetch_sub(1u64, Ordering.Relaxed);
    check(old_sub == 0u64, 82);
    check(a.load(Ordering.SeqCst) == 0xFFFFFFFFFFFFFFFFu64, 83);

    let _ = a.fetch_and(0xFFu64, Ordering.AcqRel);
    check(a.load(Ordering.Relaxed) == 0xFFu64, 84);
    let _ = a.fetch_or(0x100u64, Ordering.Release);
    check(a.load(Ordering.Acquire) == 0x1FFu64, 85);
    let _ = a.fetch_xor(0x1BFu64, Ordering.SeqCst);
    check(a.load(Ordering.Relaxed) == 64u64, 86);

    // Signed i64 wrapping across INT64_MAX -> INT64_MIN
    let si = AtomicI64.new(0x7FFFFFFFFFFFFFFFi64);
    let old_si = si.fetch_add(1i64, Ordering.SeqCst);
    check(old_si == 0x7FFFFFFFFFFFFFFFi64, 87);
    let back_si = si.fetch_sub(1i64, Ordering.SeqCst);
    check(back_si == (-9223372036854775807i64 - 1i64), 88);
    check(si.into_inner() == 0x7FFFFFFFFFFFFFFFi64, 89);

    // AtomicUsize
    let uz = AtomicUsize.new(10usize);
    let prev_uz = uz.fetch_add(54usize, Ordering.AcqRel);
    check(prev_uz == 10usize, 90);
    let cas_uz = uz.compare_exchange(64usize, 100usize, Ordering.SeqCst, Ordering.Acquire);
    check(cas_uz.ok && cas_uz.val == 64usize, 91);
    check(uz.into_inner() == 100usize, 92);

    // Atomic<*mut u64>
    let mut x: u64 = 111u64;
    let mut y: u64 = 222u64;
    let px: *mut u64 = unsafe { address_of_mut(x) };
    let py: *mut u64 = unsafe { address_of_mut(y) };
    let ap: Atomic<*mut u64> = Atomic.new(px);
    check((ap.load(Ordering.Acquire) as usize) == (px as usize), 93);
    let old_p = ap.swap(py, Ordering.SeqCst);
    check((old_p as usize) == (px as usize), 94);
    let cas_p1 = ap.compare_exchange(py, px, Ordering.AcqRel, Ordering.Acquire);
    check(cas_p1.ok && (cas_p1.val as usize) == (py as usize), 95);
    let cas_p2 = ap.compare_exchange(py, py, Ordering.AcqRel, Ordering.Acquire);
    check(!cas_p2.ok && (cas_p2.val as usize) == (px as usize), 96);
    let val_via_ptr = unsafe { *ap.load(Ordering.SeqCst) };
    check(val_via_ptr == 111u64, 97);

    // Fences and spin hint
    fence(Ordering.Acquire);
    fence(Ordering.Release);
    fence(Ordering.AcqRel);
    fence(Ordering.SeqCst);
    compiler_fence(Ordering.Acquire);
    compiler_fence(Ordering.Release);
    compiler_fence(Ordering.AcqRel);
    compiler_fence(Ordering.SeqCst);
    spin_loop_hint();

    a.into_inner() as u32
}

fn main() {
    test_atomic_bool();
    let v8 = test_atomic_u8();
    let v16 = test_atomic_u16();
    let v32 = test_atomic_u32();
    let v64 = test_atomic_u64_i64_usize_ptr();
    check(v8 == 8u32, 98);
    check(v16 == 16u32, 99);
    check(v32 == 32u32, 100);
    check(v64 == 64u32, 101);
    print("OK atomics_native 8 16 32 64\n");
}
