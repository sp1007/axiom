// test: run
// modes: interp native
// stdout: 42\n

module test_auto_derive_and_unsafe_impl

@derive(Copy)
struct Point {
    pub x: i32,
    pub y: i32,
}

enum Packet {
    Empty,
    Coords(Point),
}

struct SyncHandle<T> {
    pub raw: *mut T,
    pub tag: i32,
}

unsafe impl<T: Send + Share> Send for SyncHandle<T> {}
unsafe impl<T: Send + Share> Share for SyncHandle<T> {}

struct LocalCache {
    pub val: i32,
}

impl !Share for LocalCache {}

fn assert_send<T: Send>(x: T) -> T {
    x
}

fn check_send<T: Send>(_x: T) {
}

fn check_share<T: Share>(_x: view<T>) {
}

fn assert_send_and_share<T: Send + Share>(x: T) -> T {
    x
}

fn forward_generic_send<T: Send + Share>(x: T, v: view<T>) -> T {
    check_send(v);
    check_share(v);
    assert_send_and_share(x)
}

pub fn main() -> i32 {
    let p = Point { x: 10, y: 12 };
    let p2 = forward_generic_send(p, view(p));
    let pkt = assert_send_and_share(Packet.Coords(p2));

    let mut local_val: i32 = 20;
    {
        check_send(mut_view(local_val));
    }

    // LocalCache is !Share, but still Send by structural auto-derivation:
    let lc = assert_send(LocalCache { val: 5 });

    // SyncHandle<Point> is Send + Share via unsafe impl<T: Send + Share>:
    let sh = assert_send_and_share(SyncHandle<Point> {
        raw: 0 as *mut Point,
        tag: lc.val,
    });

    let base: i32 = match pkt {
        Packet.Empty => 0,
        Packet.Coords(pt) => pt.x + pt.y,
    };

    let clos = || -> i32 {
        base + sh.tag + 15
    };
    let clos2 = assert_send_and_share(clos);
    print_int(clos2());
    print("\n");
    0
}
