// test: run
// exit: 0
// stdout: 0\n
// stdout: 9223372036854775807\n
// stdout: 9223372036854775808\n
// stdout: 9223372036854775809\n
// stdout: 18446744073709551615\n
// stdout: 18446744073709551614\n
// stdout: 12345678901234567890\n
// stdout: 9223372036854775807\n
// stdout: 9223372036854775808\n
// stdout: 18446744073709551615\n
// T453a (SPEC-40): print_int of u64/usize values >= 2^63 prints the unsigned value (the host routine
// is signed 64-bit; the lowering sends unsigned 64-bit operands through the zero-extending path).

fn main() -> i32 {
    print_int(0u64);
    print("\n");
    print_int(9223372036854775807u64);
    print("\n");
    print_int(9223372036854775808u64);
    print("\n");
    print_int(9223372036854775809u64);
    print("\n");
    print_int(18446744073709551615u64);
    print("\n");
    print_int(18446744073709551614u64);
    print("\n");
    print_int(12345678901234567890u64);
    print("\n");
    print_int(9223372036854775807usize);
    print("\n");
    print_int(9223372036854775808usize);
    print("\n");
    print_int(18446744073709551615usize);
    print("\n");
    0
}
