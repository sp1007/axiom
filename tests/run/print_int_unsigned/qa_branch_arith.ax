// QA T453a: unsigned 64-bit values produced by branches, wide division/multiplication, and bit ops.

fn pick(c: bool) -> u64 {
    if c { 18446744073709551615u64 } else { 9223372036854775808u64 }
}

fn id(x: u64) -> u64 {
    x
}

fn main() -> i32 {
    print_int(pick(true));
    print("\n");
    print_int(pick(false));
    print("\n");
    print_int(id(18446744073709551615u64) / id(3u64));
    print("\n");
    print_int(id(18446744073709551615u64) - id(5u64));
    print("\n");
    print_int(id(6148914691236517205u64) * id(2u64));
    print("\n");
    print_int(id(18446744073709551615u64) % id(18446744073709551615u64));
    print("\n");
    print_int((id(18446744073709551615u64) ^ id(18446744073709551614u64)) as usize);
    print("\n");
    0
}
