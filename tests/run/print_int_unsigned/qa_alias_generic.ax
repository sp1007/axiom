// test: run
// exit: 0
// stdout: 18446744073709551615\n
// stdout: 9223372036854775808\n
// stdout: 18446744073709551615\n
// stdout: 9223372036854775808\n
// stdout: 18446744073709551615\n
// stdout: -9223372036854775808\n
// stdout: 4294967295\n
// QA T453a: u64 through an alias, a generic identity, a slice/array element, a mut_view write, a closure-free
// helper and a loop-carried value; signed and narrow neighbours unchanged.

pub type Word = u64
pub type Size = usize

fn ident<T>(x: T) -> T {
    x
}

fn at(a: [3]u64, i: usize) -> u64 {
    a[i]
}

fn bump(c: mut_view<u64>) {
    *c = 18446744073709551615u64;
}

fn main() -> i32 {
    let w: Word = 18446744073709551615u64;
    print_int(w);
    print("\n");
    let s: Size = 9223372036854775808usize;
    print_int(ident(s));
    print("\n");
    let g: u64 = ident(18446744073709551615u64);
    print_int(g);
    print("\n");
    let arr: [3]u64 = [1u64, 9223372036854775808u64, 18446744073709551615u64];
    print_int(at(arr, 1));
    print("\n");
    let mut cell: u64 = 0u64;
    bump(mut_view(cell));
    print_int(cell);
    print("\n");
    print_int(ident(-9223372036854775807i64 - 1i64));
    print("\n");
    print_int(ident(4294967295u32));
    print("\n");
    0
}
