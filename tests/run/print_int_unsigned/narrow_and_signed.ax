// T453a (SPEC-40): narrow unsigned operands keep printing their value, signed operands keep printing negatives.

fn main() -> i32 {
    print_int(255u8);
    print("\n");
    print_int(65535u16);
    print("\n");
    print_int(4294967295u32);
    print("\n");
    print_int(128u8);
    print("\n");
    print_int(32768u16);
    print("\n");
    print_int(2147483648u32);
    print("\n");
    print_int(-1i64);
    print("\n");
    print_int(-9223372036854775808i64);
    print("\n");
    print_int(9223372036854775807i64);
    print("\n");
    print_int(-128i8);
    print("\n");
    print_int(-32768i16);
    print("\n");
    print_int(-2147483648i32);
    print("\n");
    print_int(-1isize);
    print("\n");
    print_int(0usize);
    print("\n");
    0
}
