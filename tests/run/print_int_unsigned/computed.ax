// T453a (SPEC-40): computed (non-constant) u64/usize values >= 2^63, in registers, in struct fields,
// through calls and in loops, print as unsigned; narrow wrapping results stay in range.

struct Pair {
    a: u64,
    b: usize,
}

fn id64(x: u64) -> u64 {
    x
}

fn shl63(n: u32) -> u64 {
    1u64 << n
}

fn main() -> i32 {
    let zero: u64 = id64(0u64);
    let wrapped: u64 = zero.wrapping_sub(1u64);
    print_int(wrapped);
    print("\n");
    let top: u64 = shl63(63u32);
    print_int(top);
    print("\n");
    let top2: u64 = (9223372036854775807u64 + id64(1u64));
    print_int(top2);
    print("\n");
    let neg1: i64 = -1i64;
    let as_u: u64 = neg1 as u64;
    print_int(as_u);
    print("\n");
    let u_max: usize = neg1 as usize;
    print_int(u_max);
    print("\n");
    let p = Pair { a: as_u, b: u_max };
    print_int(p.a);
    print("\n");
    let n8: u8 = id64(255u64) as u8;
    print_int(n8);
    print("\n");
    let n32: u32 = id64(4294967295u64) as u32;
    print_int(n32);
    print("\n");
    let w8: u8 = id64(200u64) as u8;
    print_int(w8);
    print("\n");
    let w8b: u8 = w8.wrapping_add(100u8);
    print_int(w8b);
    print("\n");
    let w32: u32 = (id64(0u64) as u32).wrapping_sub(1u32);
    print_int(w32);
    print("\n");
    print_int(top);
    print("\n");
    print_int(p.b);
    print("\n");
    print_int(neg1);
    print("\n");
    // loop: doubling from 2^62 reaches 2^63 and prints unsigned
    let mut v: u64 = 4611686018427387904u64;
    let mut i: u32 = 0u32;
    while i < 1u32 {
        v = v * 2u64;
        i = i + 1u32;
    }
    print_int(v | 9223372036854775807u64);
    print("\n");
    0
}
