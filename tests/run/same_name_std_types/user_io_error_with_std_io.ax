// test: run
// modes: interp native
// exit: 0
// stdout: 105 9 1 1\n
// T428g: a user `struct IoError` must not collide with `std.io.IoError` in `std.io` signatures and bodies.

use std.io.IoError as StdIoError
use std.io.String as IoString
use std.io.io_error_from_code
use std.io.read_to_string

struct IoError {
    code: i32,
    detail: i32,
}

fn fail_user(c: i32) -> Result<i32, IoError> {
    Result.Err(IoError { code: c, detail: 9i32 })
}

fn probe_std_io(do_open: bool, path: Str) -> Result<IoString, StdIoError> {
    if do_open {
        read_to_string(path)
    } else {
        Result.Err(io_error_from_code(-5i64))
    }
}

fn main() -> i32 {
    let u = match fail_user(105i32) {
        Result.Ok(v) => IoError { code: v, detail: 0i32 },
        Result.Err(e) => e,
    }
    let se: StdIoError = io_error_from_code(-1i64)
    let is_nf = match se {
        StdIoError.NotFound => 1i64,
        _ => 0i64,
    }
    let is_to = match probe_std_io(false, "__unused_t428g__") {
        Result.Ok(_) => 0i64,
        Result.Err(e) => match e {
            StdIoError.TimedOut => 1i64,
            _ => 0i64,
        },
    }
    print_int(u.code as i64)
    print(" ")
    print_int(u.detail as i64)
    print(" ")
    print_int(is_nf)
    print(" ")
    print_int(is_to)
    print("\n")
    0
}
