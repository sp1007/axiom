// test: run
// modes: interp native
// exit: 0
// stdout: 42 7 16 65\n
// T428g: a user `struct String` must not collide with `std.io.String` inside `read_to_string(path) -> Result<String, IoError>`.

use std.io.IoError
use std.io.String as IoString
use std.io.read_to_string
use std.io.string_with_capacity as io_string_with_capacity

struct String {
    x: i32,
    tag: i32,
}

fn wrap_user(v: i32) -> Option<String> {
    Option.Some(String { x: v, tag: 7i32 })
}

fn make_or_read_io(do_open: bool, path: Str) -> Result<IoString, IoError> {
    if do_open {
        read_to_string(path)
    } else {
        let mut s = io_string_with_capacity(16usize)
        unsafe {
            *(s.ptr) = 65u8
        }
        s.len = 1usize
        Result.Ok(s)
    }
}

fn main() -> i32 {
    let us = match wrap_user(42i32) {
        Option.Some(s) => s,
        Option.None => String { x: 0i32, tag: 0i32 },
    }
    let mut io_cap: i64 = 0i64
    let mut io_b0: i64 = 0i64
    match make_or_read_io(false, "__unused_t428g__") {
        Result.Ok(ios) => {
            io_cap = ios.cap as i64
            io_b0 = (unsafe { *(ios.ptr) }) as i64
        },
        Result.Err(_) => {
            io_cap = -1i64
        },
    }
    print_int(us.x as i64)
    print(" ")
    print_int(us.tag as i64)
    print(" ")
    print_int(io_cap)
    print(" ")
    print_int(io_b0)
    print("\n")
    0
}
