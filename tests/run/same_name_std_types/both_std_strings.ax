// test: run
// modes: interp native
// exit: 0
// stdout: 4 24 90\n
// T428g: importing both `std.text.string.String` and `std.io.read_to_string` (which uses `std.io.String`) in one program.

use std.text.string.String
use std.text.string.string_new
use std.text.string.string_push_char
use std.text.string.string_len
use std.io.IoError
use std.io.String as IoString
use std.io.read_to_string
use std.io.string_with_capacity as io_string_with_capacity

fn text_len_opt(o: Option<String>) -> usize {
    match o {
        Option.Some(s) => string_len(view(s)),
        Option.None => 0usize,
    }
}

fn make_or_read_io(do_open: bool, path: Str) -> Result<IoString, IoError> {
    if do_open {
        read_to_string(path)
    } else {
        let mut ios = io_string_with_capacity(24usize)
        unsafe {
            *(ios.ptr) = 90u8
        }
        ios.len = 1usize
        Result.Ok(ios)
    }
}

fn main() -> i32 {
    let mut ts: String = string_new()
    string_push_char(mut_view(ts), 'A')
    string_push_char(mut_view(ts), 'ế')
    let tlen = text_len_opt(Option.Some(ts))

    let mut icap: i64 = 0i64
    let mut ib0: i64 = 0i64
    match make_or_read_io(false, "__unused_t428g__") {
        Result.Ok(s) => {
            icap = s.cap as i64
            ib0 = (unsafe { *(s.ptr) }) as i64
        },
        Result.Err(_) => {
            icap = -1i64
        },
    }

    print_int(tlen as i64)
    print(" ")
    print_int(icap)
    print(" ")
    print_int(ib0)
    print("\n")
    0
}
