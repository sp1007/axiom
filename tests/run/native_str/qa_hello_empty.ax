// test: run
// exit: 42
// stdout: 

@intrinsic fn assert(c: bool) {}

fn main() -> i32 {
    let e: Str = "";
    let be: Str = b"";
    assert(len(e) == 0);
    if len(e) != 0 { return 1; }
    assert(len(be) == 0);
    if len(be) != 0 { return 2; }
    let res = (len(e) + len(be) + 42) as i32;
    print(e);
    return res;
}
