// test: run
// modes: interp
// reason: oracle-only check (the step-limit exists only in the oracle)
// exit: 124
// flags: --step-limit 2000
// stdout: before the hang\n42\n
// stderr-contains: step limit exceeded
// T422b FU-K: stdout produced before the step-limit error must still reach the process stdout.

fn main() -> i32 {
    print("before the hang\n");
    print_int(42i64);
    print("\n");
    let mut i: i64 = 0;
    while i >= 0 {
        i = i + 1;
        if i > 1000000 {
            i = 0;
        }
    }
    return 0;
}
