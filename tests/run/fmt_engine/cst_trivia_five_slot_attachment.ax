// test: run
// modes: interp native
// stdout-file: cst_trivia_five_slot_attachment.stdout
// SPEC-101 AXS-FMT-001..004:
// Lossless CST trivia taxonomy, 5-slot deterministic comment attachment,
// `#region` / `#endregion` canonicalization, UTF-8 scalar width counting,
// and comment conservation invariant.

const TRIVIA_LINE_COMMENT: u8 = 0u8;
const TRIVIA_OUTER_DOC: u8 = 1u8;
const TRIVIA_INNER_DOC: u8 = 2u8;
const TRIVIA_BLOCK_COMMENT: u8 = 3u8;
const TRIVIA_REGION_DIRECTIVE: u8 = 4u8;

const SLOT_HEADER: u8 = 1u8;
const SLOT_TRAILING: u8 = 2u8;
const SLOT_INLINE: u8 = 3u8;
const SLOT_LEADING: u8 = 4u8;
const SLOT_DANGLING: u8 = 5u8;

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

@derive(Copy)
struct RawStr {
    ptr: *const u8,
    len: usize,
}

fn utf8_scalar_len(s: str) -> usize {
    let raw: RawStr = unsafe { *(address_of(s) as *const RawStr) };
    let bytes: view<[u8]> = unsafe { *(address_of(s) as *const view<[u8]>) };
    let mut count: usize = 0;
    let mut i: usize = 0;
    while i < raw.len {
        let b = bytes[i];
        if (b & 0xC0u8) != 0x80u8 {
            count = count + 1;
        }
        i = i + 1;
    }
    count
}

fn classify_slot(
    prev_tok: i32,
    next_tok: i32,
    next_is_close_delim: bool,
    same_line_prev: bool,
    same_line_next: bool,
    is_single_line: bool,
    kind: u8,
    in_header_banner: bool
) -> u8 {
    if prev_tok < 0 && (kind == TRIVIA_INNER_DOC || in_header_banner) {
        return SLOT_HEADER;
    }
    if same_line_prev && is_single_line && !same_line_next &&
            kind != TRIVIA_OUTER_DOC && kind != TRIVIA_INNER_DOC {
        return SLOT_TRAILING;
    }
    if kind == TRIVIA_BLOCK_COMMENT && prev_tok >= 0 && same_line_next {
        return SLOT_INLINE;
    }
    if next_tok < 0 || next_is_close_delim {
        return SLOT_DANGLING;
    }
    SLOT_LEADING
}

pub fn main() -> i32 {
    // 1. Verify UTF-8 scalar width vs byte length on Vietnamese & emoji text.
    let vn = "Xin chào Việt Nam";
    let vn_raw: RawStr = unsafe { *(address_of(vn) as *const RawStr) };
    if vn_raw.len != 20 || utf8_scalar_len(vn) != 17 {
        return 1;
    }

    // 2. Verify 5-Slot Deterministic Attachment Priority Order:
    // Slot 1: Inner doc `//!` or blank-line-separated banner at top of file.
    let s1 = classify_slot(-1, 0, false, false, false, true, TRIVIA_INNER_DOC, false);
    let s1b = classify_slot(-1, 0, false, false, false, true, TRIVIA_LINE_COMMENT, true);
    if s1 != SLOT_HEADER || s1b != SLOT_HEADER {
        return 2;
    }

    // Slot 2: Same-line trailing comment with no token following on that line.
    let s2 = classify_slot(3, 4, false, true, false, true, TRIVIA_LINE_COMMENT, false);
    if s2 != SLOT_TRAILING {
        return 3;
    }

    // Slot 3: Inline block comment `/* ... */` followed by a token on the same line.
    let s3 = classify_slot(1, 2, false, true, true, true, TRIVIA_BLOCK_COMMENT, false);
    if s3 != SLOT_INLINE {
        return 4;
    }

    // Slot 4: Leading comment (outer doc, region directive, line comment) before a non-delimiter token.
    let s4a = classify_slot(2, 3, false, false, false, true, TRIVIA_OUTER_DOC, false);
    let s4b = classify_slot(2, 3, false, false, false, true, TRIVIA_REGION_DIRECTIVE, false);
    if s4a != SLOT_LEADING || s4b != SLOT_LEADING {
        return 5;
    }

    // Slot 5: Dangling comment before `}`, `)`, `]` or before `EOF`.
    let s5a = classify_slot(5, 6, true, false, false, true, TRIVIA_LINE_COMMENT, false);
    let s5b = classify_slot(5, -1, false, false, false, true, TRIVIA_LINE_COMMENT, false);
    if s5a != SLOT_DANGLING || s5b != SLOT_DANGLING {
        return 6;
    }

    print("CST-TRIVIA-FIVE-SLOT-ATTACHMENT-OK\n");
    0
}
