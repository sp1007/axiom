@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

@derive(Copy)
struct RawStr {
    ptr: *const u8,
    len: usize,
}

fn sv_from_str(s: str) -> StrView {
    let raw: RawStr = unsafe { *(address_of(s) as *const RawStr) };
    let bytes: view<[u8]> = unsafe { *(address_of(s) as *const view<[u8]>) };
    let n = raw.len;
    let dst = unsafe { heap_alloc(n + 1, 1) };
    let mut i: usize = 0;
    while i < n {
        unsafe { *(dst + i) = bytes[i]; }
        i = i + 1;
    }
    unsafe { *(dst + n) = 0u8; }
    StrView {
        ptr: dst as *const u8,
        len: n,
    }
}

fn sv_eq(a: StrView, b: StrView) -> bool {
    if a.len != b.len {
        return false;
    }
    let mut i: usize = 0;
    while i < a.len {
        if unsafe { *(a.ptr + i) } != unsafe { *(b.ptr + i) } {
            return false;
        }
        i = i + 1;
    }
    true
}

fn buf_as_sv(b: view<DiagBuffer>) -> StrView {
    StrView {
        ptr: b.ptr as *const u8,
        len: b.len,
    }
}

fn sv_contains(hay: StrView, needle: StrView) -> bool {
    if needle.len == 0 {
        return true;
    }
    if (hay.len) < needle.len {
        return false;
    }
    let limit = hay.len - needle.len;
    let mut i: usize = 0;
    while i <= limit {
        let mut ok = true;
        let mut j: usize = 0;
        while j < needle.len {
            let h_idx: usize = i + j;
            if unsafe { *(hay.ptr + h_idx) } != unsafe { *(needle.ptr + j) } {
                ok = false;
                break;
            }
            j = j + 1;
        }
        if ok {
            return true;
        }
        i = i + 1;
    }
    false
}

fn out_str(s: str) {
    let sv = sv_from_str(s);
    unsafe { write(stdio(1), sv.ptr, sv.len); }
}

fn out_sv(sv: StrView) {
    unsafe { write(stdio(1), sv.ptr, sv.len); }
}

fn out_bool(b: bool) {
    if b {
        out_str("true");
    } else {
        out_str("false");
    }
}

fn out_usize(v: usize) {
    let mut buf: [24]u8 = [0u8; 24];
    if v == 0 {
        buf[0] = 48u8;
        unsafe { write(stdio(1), address_of<u8>(buf[0]), 1); }
        return;
    }
    let mut x = v;
    let mut n: usize = 0;
    while x > 0 {
        buf[23 - n] = 48u8 + ((x % 10) as u8);
        x = x / 10;
        n = n + 1;
    }
    unsafe { write(stdio(1), address_of<u8>(buf[24 - n]), n); }
}

fn buf_contains(b: view<DiagBuffer>, needle: StrView) -> bool {
    sv_contains(buf_as_sv(b), needle)
}

fn run_cst_trivia_probe() -> bool {
    let bom_bytes: [6]u8 = [0xEFu8, 0xBBu8, 0xBFu8, 102u8, 110u8, 32u8];
    let bom_ptr = unsafe { address_of<u8>(bom_bytes[0]) };
    let stripped = cst_strip_bom(StrView { ptr: bom_ptr, len: 6 });
    let s_ptr = stripped.ptr;
    let s_len = stripped.len;
    let bom_ok = cst_has_bom(StrView { ptr: bom_ptr, len: 6 }) &&
        !cst_has_bom(StrView { ptr: s_ptr, len: s_len }) &&
        s_len == 3;

    // "Xin chào Việt Nam" (22 UTF-8 bytes, 17 Unicode scalar values)
    let vn = sv_from_str("Xin chào Việt Nam");
    let vn_bytes = vn.len;
    let vn_scalars = cst_utf8_scalar_len(vn.ptr, vn.len);

    // "🚀🔥" (8 UTF-8 bytes, 2 Unicode scalar values)
    let emoji_bytes: [8]u8 = [0xF0u8, 0x9Fu8, 0x9Au8, 0x80u8, 0xF0u8, 0x9Fu8, 0x94u8, 0xA5u8];
    let emoji_scalars = cst_utf8_scalar_len(unsafe { address_of<u8>(emoji_bytes[0]) }, 8);

    // Source exercising all 5 slots + comment normalization
    let src = sv_from_str("//!module doc\n//banner\n\n//#region  helpers  \n///outer doc\npub fn add(/*inline*/ a: i32, b: i32) -> i32 {\n    let s = a + b; //trail\n    s\n    //dangling in block\n}\n//#endregion\npub const K: i32 = 1;\n//eof comment\n");
    let mut arena = arena_new();
    let mut interner = interner_new();
    let mut sink = DiagSink {
        arena: arena_new(),
        diags: 0 as *mut Diagnostic,
        len: 0,
        cap: 0,
        errors: 0,
        warnings: 0,
    };
    diag_sink_init(mut_view(sink));
    let mut lex_res = LexResult {
        arena: arena_new(),
        tokens: 0 as *mut Token,
        token_count: 0,
        token_cap: 0,
        comments: 0 as *mut Comment,
        comment_count: 0,
        comment_cap: 0,
    };
    let mut parse_res = ParseResult { ast: Ast { items: 0 as *mut AstItem } };
    let mut cst = cst_parse_and_build(
        mut_view(arena),
        mut_view(interner),
        mut_view(sink),
        FileId { v: 1u32 },
        src,
        mut_view(lex_res),
        mut_view(parse_res)
    );

    let slots_ok = cst.header_count == 2 &&
        cst.trailing_count == 1 &&
        cst.inline_count == 1 &&
        cst.leading_count == 3 &&
        cst.dangling_count == 2;

    let mut eng = DocEngine { arena: 0 as *mut Arena, nodes: 0 as *mut DocNode, count: 0, cap: 0 };
    doc_engine_init(mut_view(eng), mut_view(arena), 512);
    let mut ctx = FmtCtx {
        arena: unsafe { address_of_mut<Arena>(arena) },
        interner: unsafe { address_of<StrInterner>(interner) },
        cst: unsafe { address_of_mut<CstFile>(cst) },
        eng: unsafe { address_of_mut<DocEngine>(eng) },
    };
    let root_doc = fmt_print_module(view(ctx), view(parse_res.ast));
    let mut out_buf = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(out_buf));
    doc_render_to_buf(view(eng), root_doc, FMT_MAX_WIDTH, mut_view(out_buf));
    let unemitted = cst_unemitted_count(view(cst));
    let norm_ok = buf_contains(view(out_buf), sv_from_str("//! module doc")) &&
        buf_contains(view(out_buf), sv_from_str("// banner")) &&
        buf_contains(view(out_buf), sv_from_str("// #region helpers")) &&
        buf_contains(view(out_buf), sv_from_str("/// outer doc")) &&
        buf_contains(view(out_buf), sv_from_str("// trail")) &&
        buf_contains(view(out_buf), sv_from_str("// dangling in block")) &&
        buf_contains(view(out_buf), sv_from_str("// #endregion")) &&
        buf_contains(view(out_buf), sv_from_str("// eof comment"));

    out_str("probe[cst_trivia] bom_ok=");
    out_bool(bom_ok);
    out_str(" vn_bytes=");
    out_usize(vn_bytes);
    out_str(" vn_scalars=");
    out_usize(vn_scalars);
    out_str(" emoji_scalars=");
    out_usize(emoji_scalars);
    out_str(" norm_ok=");
    out_bool(norm_ok);
    out_str(" slots_ok=");
    out_bool(slots_ok);
    out_str(" unemitted=");
    out_usize(unemitted);
    out_str("\n");

    diag_buf_free(mut_view(out_buf));
    ax_lex_result_free(mut_view(lex_res));
    diag_sink_free(mut_view(sink));
    interner_free(mut_view(interner));
    arena_destroy(mut_view(arena));

    bom_ok && vn_bytes == 20 && vn_scalars == 17 && emoji_scalars == 2 && norm_ok && slots_ok && unemitted == 0
}

fn run_wadler_lindig_probe() -> bool {
    let mut arena = arena_new();
    let mut eng = DocEngine { arena: 0 as *mut Arena, nodes: 0 as *mut DocNode, count: 0, cap: 0 };
    doc_engine_init(mut_view(eng), mut_view(arena), 256);

    // Build `Group("fn f(" + Indent(4, SoftLineEmpty + "a: i32," + SoftLine + "b: i32" + IfBreak(",", "")) + SoftLineEmpty + ")")`
    let p_open = doc_text_sv(mut_view(eng), sv_from_str("fn f("));
    let p_a = doc_text_sv(mut_view(eng), sv_from_str("a: i32,"));
    let p_b = doc_text_sv(mut_view(eng), sv_from_str("b: i32"));
    let sl = doc_softline(mut_view(eng));
    let sle = doc_softline_empty(mut_view(eng));
    let comma_txt = doc_text_sv(mut_view(eng), sv_from_str(","));
    let ib_comma = doc_if_break(mut_view(eng), comma_txt, 0u32);
    let sfx_txt = doc_text_sv(mut_view(eng), sv_from_str(" // end-sig"));
    let suffix = doc_line_suffix(mut_view(eng), sfx_txt);
    let p_close = doc_text_sv(mut_view(eng), sv_from_str(")"));

    let p_a_sfx = doc_concat(mut_view(eng), p_a, suffix);
    let inner1 = doc_concat(mut_view(eng), sle, p_a_sfx);
    let inner2 = doc_concat(mut_view(eng), sl, p_b);
    let inner3 = doc_concat(mut_view(eng), inner1, inner2);
    let inner4 = doc_concat(mut_view(eng), inner3, ib_comma);
    let ind = doc_indent(mut_view(eng), FMT_INDENT_STEP, inner4);
    let g_body = doc_concat(mut_view(eng), p_open, ind);
    let g_body2 = doc_concat(mut_view(eng), g_body, sle);
    let g_body3 = doc_concat(mut_view(eng), g_body2, p_close);
    let grp = doc_group(mut_view(eng), g_body3);

    let mut buf_flat = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(buf_flat));
    doc_render_to_buf(view(eng), grp, 100, mut_view(buf_flat));
    let flat_ok = sv_eq(buf_as_sv(view(buf_flat)), sv_from_str("fn f(a: i32, b: i32) // end-sig"));

    let mut buf_brk = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(buf_brk));
    doc_render_to_buf(view(eng), grp, 12, mut_view(buf_brk));
    let break_ok = sv_eq(
        buf_as_sv(view(buf_brk)),
        sv_from_str("fn f(\n    a: i32, // end-sig\n    b: i32,\n)")
    );
    let suffix_ok = sv_contains(buf_as_sv(view(buf_brk)), sv_from_str("a: i32, // end-sig\n"));

    // Verify no line has trailing whitespace before `\n`
    let brk_sv = buf_as_sv(view(buf_brk));
    let mut no_trail_ws = true;
    let mut i: usize = 1;
    while i < brk_sv.len {
        if unsafe { *(brk_sv.ptr + i) } == 10u8 {
            let prev_idx: usize = i - 1;
            let prev = unsafe { *(brk_sv.ptr + prev_idx) };
            if prev == 32u8 || prev == 9u8 {
                no_trail_ws = false;
            }
        }
        i = i + 1;
    }

    // Empty file formatting -> 0 bytes (`AXS-FMT-014`)
    let mut empty_buf = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(empty_buf));
    let empty_ok = fmt_format_source(sv_from_str("   \n\t\r\n  "), mut_view(empty_buf)) && empty_buf.len == 0;

    out_str("probe[wadler_lindig] flat_ok=");
    out_bool(flat_ok);
    out_str(" break_ok=");
    out_bool(break_ok);
    out_str(" suffix_ok=");
    out_bool(suffix_ok);
    out_str(" no_trail_ws=");
    out_bool(no_trail_ws);
    out_str(" empty_ok=");
    out_bool(empty_ok);
    out_str("\n");

    diag_buf_free(mut_view(empty_buf));
    diag_buf_free(mut_view(buf_brk));
    diag_buf_free(mut_view(buf_flat));
    arena_destroy(mut_view(arena));

    flat_ok && break_ok && suffix_ok && no_trail_ws && empty_ok
}

fn run_ex_fmt_01_probe() -> bool {
    let input = sv_from_str("module demo.network;\nuse std.io.{Write,Read,self};\nuse std.collections.HashMap;\nuse std.alloc.Allocator;\n\n\n@derive(Clone,Eq)\n/// Compute packet checksum.\n@repr(C)\npub struct Packet{pub id:u32,pub payload:Slice<u8>}\npub fn verify(pkt:view<Packet>,limit:u32)->bool{\nlet sum = pkt.id + (pkt.payload.len() as u32); // compute total\nif (sum > limit) { return false; }\ntrue\n}\n");
    let expected = sv_from_str("module demo.network\n\nuse std.alloc.Allocator\nuse std.collections.HashMap\nuse std.io.{self, Read, Write}\n\n/// Compute packet checksum.\n@repr(C)\n@derive(Clone, Eq)\npub struct Packet {\n    pub id: u32,\n    pub payload: Slice<u8>,\n}\n\npub fn verify(pkt: view<Packet>, limit: u32) -> bool {\n    let sum = pkt.id + (pkt.payload.len() as u32) // compute total\n    if sum > limit {\n        return false\n    }\n    true\n}\n");

    let mut buf1 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    let mut buf2 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(buf1));
    diag_buf_init(mut_view(buf2));

    let ok1 = fmt_format_source(input, mut_view(buf1));
    let exact_match = ok1 && sv_eq(buf_as_sv(view(buf1)), expected);

    let ok2 = fmt_format_source(buf_as_sv(view(buf1)), mut_view(buf2));
    let idempotent = ok2 && sv_eq(buf_as_sv(view(buf1)), buf_as_sv(view(buf2)));
    let comments_conserved = buf_contains(view(buf1), sv_from_str("/// Compute packet checksum.")) &&
        buf_contains(view(buf1), sv_from_str("// compute total"));

    out_str("probe[ex_fmt_01] exact_match=");
    out_bool(exact_match);
    out_str(" idempotent=");
    out_bool(idempotent);
    out_str(" comments_conserved=");
    out_bool(comments_conserved);
    out_str("\n");

    diag_buf_free(mut_view(buf2));
    diag_buf_free(mut_view(buf1));
    exact_match && idempotent && comments_conserved
}

fn run_ex_fmt_02_and_neg_probe() -> bool {
    let input02 = sv_from_str("pub fn process_pipeline(items: view<Vec<LayoutItem>>, threshold: i64, scale: i64) -> i64 {\n    let result = items.iter().filter(|item| item.weight > threshold && item.active).map(|item| item.weight * scale + item.bias).fold(0, |acc, val| acc + val);\n    if (result > 1000 && scale > 0) { return result; } else { return 0; }\n}\n");
    let expected02 = sv_from_str("pub fn process_pipeline(items: view<Vec<LayoutItem>>, threshold: i64, scale: i64) -> i64 {\n    let result = items\n        .iter()\n        .filter(|item| item.weight > threshold && item.active)\n        .map(|item| item.weight * scale + item.bias)\n        .fold(0, |acc, val| acc + val)\n    if result > 1000 && scale > 0 {\n        return result\n    } else {\n        return 0\n    }\n}\n");

    let mut b1 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    let mut b2 = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(b1));
    diag_buf_init(mut_view(b2));

    let ok1 = fmt_format_source(input02, mut_view(b1));
    let ex02_match = ok1 && sv_eq(buf_as_sv(view(b1)), expected02);
    let ok2 = fmt_format_source(buf_as_sv(view(b1)), mut_view(b2));
    let idempotent = ok2 && sv_eq(buf_as_sv(view(b1)), buf_as_sv(view(b2)));

    // NEG-FMT-01: Long binary expression must keep `+` at end of line, never at start of next line.
    let bin_in = sv_from_str("pub fn calc(alpha_long_variable: i64, beta_long_variable: i64, gamma_long_variable: i64, delta_long_variable: i64, epsilon_long_variable: i64) -> i64 {\n    let total = alpha_long_variable + beta_long_variable + gamma_long_variable + delta_long_variable + epsilon_long_variable;\n    total\n}\n");
    let mut b_bin = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(b_bin));
    let bin_ok = fmt_format_source(bin_in, mut_view(b_bin));
    let neg01_trailing_op = bin_ok &&
        buf_contains(view(b_bin), sv_from_str("+\n        ")) &&
        !buf_contains(view(b_bin), sv_from_str("\n        + "));

    // NEG-FMT-02: Trailing semicolon on final STMT_EXPR must be preserved, while stripped on non-final STMT_EXPR.
    let semi_in = sv_from_str("pub fn run(x: i32) {\n    first_effect(x);\n    side_effect(x);\n}\n");
    let semi_exp = sv_from_str("pub fn run(x: i32) {\n    first_effect(x)\n    side_effect(x);\n}\n");
    let mut b_semi = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(b_semi));
    let neg02_semi_kept = fmt_format_source(semi_in, mut_view(b_semi)) &&
        sv_eq(buf_as_sv(view(b_semi)), semi_exp);

    // Region barrier & literal preservation (`0xFF_00u32`)
    let reg_in = sv_from_str("use z.b;\nuse a.b;\n// #region custom\nuse m.n;\nuse c.d;\n// #endregion\n\npub const MASK: u32 = 0xFF_00u32;\n");
    let reg_exp = sv_from_str("use a.b\nuse z.b\n// #region custom\nuse c.d\nuse m.n\n// #endregion\n\npub const MASK: u32 = 0xFF_00u32\n");
    let mut b_reg = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 };
    diag_buf_init(mut_view(b_reg));
    let reg_ok = fmt_format_source(reg_in, mut_view(b_reg));
    let region_barrier_ok = reg_ok && sv_eq(buf_as_sv(view(b_reg)), reg_exp);
    let literals_ok = buf_contains(view(b_reg), sv_from_str("0xFF_00u32"));

    out_str("probe[ex_fmt_02_and_neg] ex02_match=");
    out_bool(ex02_match);
    out_str(" idempotent=");
    out_bool(idempotent);
    out_str(" neg01_trailing_op=");
    out_bool(neg01_trailing_op);
    out_str(" neg02_semi_kept=");
    out_bool(neg02_semi_kept);
    out_str(" region_barrier_ok=");
    out_bool(region_barrier_ok);
    out_str(" literals_ok=");
    out_bool(literals_ok);
    out_str("\n");

    diag_buf_free(mut_view(b_reg));
    diag_buf_free(mut_view(b_semi));
    diag_buf_free(mut_view(b_bin));
    diag_buf_free(mut_view(b2));
    diag_buf_free(mut_view(b1));

    ex02_match && idempotent && neg01_trailing_op && neg02_semi_kept && region_barrier_ok && literals_ok
}

pub fn main() -> i32 {
    let ok1 = run_cst_trivia_probe();
    let ok2 = run_wadler_lindig_probe();
    let ok3 = run_ex_fmt_01_probe();
    let ok4 = run_ex_fmt_02_and_neg_probe();
    if !ok1 || !ok2 || !ok3 || !ok4 {
        return 1;
    }
    out_str("FMT-ENGINE-PROBE-PASS\n");
    0
}
