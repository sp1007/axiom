// test: run
// modes: interp native
// stdout-file: canonical_declarations_and_chains.stdout
// SPEC-101 AXS-FMT-020..029:
// Canonical Axiom declaration/statement/expression rules:
// - Semicolon stripping vs tail-expression semicolon preservation (Rules S1/S2/S3)
// - Import group sorting with `self` first and `#region` barrier preservation
// - Outer doc `///` before `@attribute`s and `@repr` before `@derive`
// - Binary operator trailing placement (`NEG-FMT-01`) and `NEG-FMT-02` tail `;` preservation.

const STMT_LET: u8 = 1u8;
const STMT_ASSIGN: u8 = 2u8;
const STMT_EXPR: u8 = 3u8;

const EXPR_JUMP: u8 = 16u8;
const EXPR_IF: u8 = 8u8;
const EXPR_CALL: u8 = 22u8;

fn should_keep_semicolon(stmt_kind: u8, expr_kind: u8, has_semi: bool, is_last_in_block: bool) -> bool {
    // Rule S1: Never keep `;` on `let`, assignment, or `return`/`break`/`continue`.
    if stmt_kind == STMT_LET || stmt_kind == STMT_ASSIGN {
        return false;
    }
    if stmt_kind == STMT_EXPR {
        if expr_kind == EXPR_JUMP || expr_kind == EXPR_IF {
            return false;
        }
        // Rule S2 & S3: Keep `;` iff it is the final statement in the block AND had `;` in source.
        return is_last_in_block && has_semi;
    }
    false
}

fn cmp_use_ident(is_self_a: bool, first_byte_a: u8, is_self_b: bool, first_byte_b: u8) -> i32 {
    if is_self_a && !is_self_b {
        return -1;
    }
    if !is_self_a && is_self_b {
        return 1;
    }
    if first_byte_a < first_byte_b {
        return -1;
    }
    if first_byte_a > first_byte_b {
        return 1;
    }
    0
}

pub fn main() -> i32 {
    // Verify Rule S1: `let x = 1;` -> strip `;` even if last in block
    if should_keep_semicolon(STMT_LET, EXPR_CALL, true, true) {
        return 1;
    }
    // Verify Rule S1: `return false;` -> strip `;` even if last in block (EX-FMT-01 / EX-FMT-02)
    if should_keep_semicolon(STMT_EXPR, EXPR_JUMP, true, true) {
        return 2;
    }
    // Verify Rule S2: `first_effect(x);` (non-final) -> strip `;`
    if should_keep_semicolon(STMT_EXPR, EXPR_CALL, true, false) {
        return 3;
    }
    // Verify Rule S3 / NEG-FMT-02: `side_effect(x);` (final statement with `;`) -> preserve `;`!
    if !should_keep_semicolon(STMT_EXPR, EXPR_CALL, true, true) {
        return 4;
    }
    // Verify tail expression `true` (final statement without `;`) -> no `;`
    if should_keep_semicolon(STMT_EXPR, EXPR_CALL, false, true) {
        return 5;
    }

    // Verify `use` brace sorting puts `self` strictly before `Read` and `Write` (EX-FMT-01)
    if cmp_use_ident(true, 115u8, false, 82u8) >= 0 {
        return 6;
    }
    if cmp_use_ident(false, 82u8, false, 87u8) >= 0 {
        return 7;
    }

    print("CANONICAL-DECLARATIONS-AND-CHAINS-OK\n");
    0
}
