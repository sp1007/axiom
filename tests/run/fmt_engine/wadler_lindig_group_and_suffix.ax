// test: run
// modes: interp native
// stdout-file: wadler_lindig_group_and_suffix.stdout
// SPEC-101 AXS-FMT-010..014:
// Wadler-Lindig `Doc` combinator algebra (`Nil`, `Text`, `HardLine`, `BlankLine`,
// `Line`, `SoftLine`, `SoftLineEmpty`, `Indent`, `Group`, `IfBreak`, `LineSuffix`,
// `Concat`) and `O(W)` bounded `fits()` solver.

const DOC_NIL: u8 = 0u8;
const DOC_TEXT: u8 = 1u8;
const DOC_HARDLINE: u8 = 2u8;
const DOC_LINE: u8 = 4u8;
const DOC_SOFTLINE_EMPTY: u8 = 6u8;
const DOC_INDENT: u8 = 7u8;
const DOC_GROUP: u8 = 8u8;
const DOC_IF_BREAK: u8 = 9u8;
const DOC_LINE_SUFFIX: u8 = 10u8;
const DOC_CONCAT: u8 = 11u8;

const MODE_FLAT: u8 = 0u8;
const MODE_BREAK: u8 = 1u8;

@derive(Copy)
struct MiniDoc {
    kind: u8,
    force_break: bool,
    width: i32,
    indent: i32,
    left: usize,
    right: usize,
}

@derive(Copy)
struct MiniCmd {
    indent: i32,
    mode: u8,
    doc_id: usize,
}

fn mini_fits(nodes: view<[32]MiniDoc>, rem: i32, root_id: usize) -> bool {
    let mut w = rem;
    if (*nodes)[root_id].force_break {
        return false;
    }
    let mut stack: [32]MiniCmd = [MiniCmd { indent: 0, mode: MODE_FLAT, doc_id: 0 }; 32];
    stack[0] = MiniCmd { indent: 0, mode: MODE_FLAT, doc_id: root_id };
    let mut sp: usize = 1;

    while w >= 0 && sp > 0 {
        sp = sp - 1;
        let cmd = stack[sp];
        let nd = (*nodes)[cmd.doc_id];
        if nd.kind == DOC_NIL || nd.kind == DOC_LINE_SUFFIX {
            continue;
        } else if nd.kind == DOC_TEXT {
            w = w - nd.width;
        } else if nd.kind == DOC_HARDLINE {
            if cmd.mode == MODE_FLAT {
                return false;
            }
            return true;
        } else if nd.kind == DOC_LINE {
            if cmd.mode == MODE_FLAT {
                w = w - 1;
            } else {
                return true;
            }
        } else if nd.kind == DOC_SOFTLINE_EMPTY {
            if cmd.mode == MODE_BREAK {
                return true;
            }
        } else if nd.kind == DOC_INDENT || nd.kind == DOC_GROUP {
            stack[sp] = MiniCmd { indent: cmd.indent + nd.indent, mode: MODE_FLAT, doc_id: nd.left };
            sp = sp + 1;
        } else if nd.kind == DOC_IF_BREAK {
            let child = if cmd.mode == MODE_BREAK { nd.left } else { nd.right };
            stack[sp] = MiniCmd { indent: cmd.indent, mode: cmd.mode, doc_id: child };
            sp = sp + 1;
        } else if nd.kind == DOC_CONCAT {
            stack[sp] = MiniCmd { indent: cmd.indent, mode: cmd.mode, doc_id: nd.right };
            stack[sp + 1] = MiniCmd { indent: cmd.indent, mode: cmd.mode, doc_id: nd.left };
            sp = sp + 2;
        }
    }
    w >= 0
}

pub fn main() -> i32 {
    let mut nodes: [32]MiniDoc = [MiniDoc {
        kind: DOC_NIL,
        force_break: false,
        width: 0,
        indent: 0,
        left: 0,
        right: 0,
    }; 32];

    // 1: Text("fn foo(a: i32,") width 14
    nodes[1] = MiniDoc { kind: DOC_TEXT, force_break: false, width: 14, indent: 0, left: 0, right: 0 };
    // 2: Line (1 space in flat, \n in break)
    nodes[2] = MiniDoc { kind: DOC_LINE, force_break: false, width: 0, indent: 0, left: 0, right: 0 };
    // 3: Text("b: i32)") width 7
    nodes[3] = MiniDoc { kind: DOC_TEXT, force_break: false, width: 7, indent: 0, left: 0, right: 0 };
    // 4: LineSuffix(" // comment") width 0 in fits()
    nodes[4] = MiniDoc { kind: DOC_LINE_SUFFIX, force_break: false, width: 11, indent: 0, left: 0, right: 0 };
    // 5: Concat(1, 2) -> width 15
    nodes[5] = MiniDoc { kind: DOC_CONCAT, force_break: false, width: 0, indent: 0, left: 1, right: 2 };
    // 6: Concat(3, 4) -> width 7 (LineSuffix is 0 width in fits)
    nodes[6] = MiniDoc { kind: DOC_CONCAT, force_break: false, width: 0, indent: 0, left: 3, right: 4 };
    // 7: Concat(5, 6) -> total flat width = 14 + 1 + 7 = 22
    nodes[7] = MiniDoc { kind: DOC_CONCAT, force_break: false, width: 0, indent: 0, left: 5, right: 6 };
    // 8: Group(7)
    nodes[8] = MiniDoc { kind: DOC_GROUP, force_break: false, width: 0, indent: 0, left: 7, right: 0 };

    if !mini_fits(view(nodes), 100, 8) {
        return 1;
    }
    if !mini_fits(view(nodes), 22, 8) {
        return 2;
    }
    if mini_fits(view(nodes), 21, 8) {
        return 3;
    }

    // HardLine forces break even when width is 100
    nodes[9] = MiniDoc { kind: DOC_HARDLINE, force_break: true, width: 0, indent: 0, left: 0, right: 0 };
    nodes[10] = MiniDoc { kind: DOC_CONCAT, force_break: true, width: 0, indent: 0, left: 1, right: 9 };
    if mini_fits(view(nodes), 100, 10) {
        return 4;
    }

    print("WADLER-LINDIG-GROUP-AND-SUFFIX-OK\n");
    0
}
