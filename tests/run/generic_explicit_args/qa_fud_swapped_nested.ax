// test: run
// modes: interp native
// stdout: 15 25 14\n35 45\n105 26\n
// exit: 42
// QA adversarial (T448 FU-D): callee and caller are both generic with the SAME parameter names (`F`, `T`),
// the callee declares its parameters in swapped order (`T` before `F`), the bound-fixed `T` flows through two
// nested generic calls, and the caller's own `T` is bound to the future's output (`F: Future<Output = T>`).

struct FA {
    v: i64,
}

struct FB {
    pad: u64,
    y: u32,
}

impl Future for FA {
    type Output = i64;
    fn poll(self: mut_view<FA>, cx: mut_view<Context>) -> Poll<i64> {
        let _ = cx;
        Poll.Ready(self.v + 5i64)
    }
}

impl Future for FB {
    type Output = u32;
    fn poll(self: mut_view<FB>, cx: mut_view<Context>) -> Poll<u32> {
        let _ = cx;
        Poll.Ready(self.y + 3u32)
    }
}

// swapped order: T first (determined only by the bound of F)
fn drive_swapped<T, F: Future<Output = T>>(fut: mut_view<F>, cx: mut_view<Context>) -> Poll<Result<T, u32>> {
    match fut.poll(cx) {
        Poll.Ready(v) => Poll.Ready(Result.Ok(v)),
        Poll.Pending => Poll.Ready(Result.Err(9u32)),
    }
}

// same names as the callee, same order, caller's T tied to F's output
fn mid<F: Future<Output = T>, T>(fut: mut_view<F>, cx: mut_view<Context>) -> Poll<Result<T, u32>> {
    drive_swapped(fut, cx)
}

// concrete output bound, nested two levels: outer -> mid -> drive_swapped
fn top_i64<F: Future<Output = i64>>(fut: mut_view<F>, cx: mut_view<Context>) -> i64 {
    match mid(fut, cx) {
        Poll.Ready(Result.Ok(v)) => v + 10i64,
        Poll.Ready(Result.Err(_)) => -1i64,
        Poll.Pending => -2i64,
    }
}

fn top_u32<G: Future<Output = u32>>(fut: mut_view<G>, cx: mut_view<Context>) -> u32 {
    match drive_swapped(fut, cx) {
        Poll.Ready(Result.Ok(v)) => v * 2u32,
        Poll.Ready(Result.Err(_)) => 0u32,
        Poll.Pending => 1u32,
    }
}

struct Wrap<F> {
    inner: F,
    k: i64,
}

impl<F: Future<Output = i64>> Future for Wrap<F> {
    type Output = i64;
    fn poll(self: mut_view<Wrap<F>>, cx: mut_view<Context>) -> Poll<i64> {
        match drive_swapped(mut_view(self.inner), cx) {
            Poll.Ready(Result.Ok(v)) => Poll.Ready(v + self.k),
            Poll.Ready(Result.Err(_)) => Poll.Ready(-1i64),
            Poll.Pending => Poll.Pending,
        }
    }
}

fn main() -> i32 {
    let rw = RawWaker { data: 0 as *const u8, vtable: 0 as *const RawWakerVTable };
    let w = Waker { raw: rw };
    let mut cx = Context { waker_val: w };

    let mut fa = FA { v: 0i64 };
    let mut fb = FB { pad: 1u64, y: 4u32 };
    let a = top_i64(mut_view(fa), mut_view(cx));
    let mut fa2 = FA { v: 10i64 };
    let a2 = top_i64(mut_view(fa2), mut_view(cx));
    let b = top_u32(mut_view(fb), mut_view(cx));
    print_int(a as i32); print(" ");
    print_int(a2 as i32); print(" ");
    print_int(b as i32); print("\n");

    // nested generic impl: Wrap<Wrap<FA>>
    let mut ww = Wrap<Wrap<FA>> { inner: Wrap<FA> { inner: FA { v: 10i64 }, k: 10i64 }, k: 10i64 };
    let rr = match ww.poll(mut_view(cx)) { Poll.Ready(v) => v, Poll.Pending => -2i64 };
    let mut w1 = Wrap<FA> { inner: FA { v: 30i64 }, k: 10i64 };
    let r1 = match w1.poll(mut_view(cx)) { Poll.Ready(v) => v, Poll.Pending => -2i64 };
    print_int(rr as i32); print(" ");
    print_int(r1 as i32); print("\n");

    // top-level: Wrap used through the generic caller
    let mut w2 = Wrap<FA> { inner: FA { v: 80i64 }, k: 10i64 };
    let t2 = top_i64(mut_view(w2), mut_view(cx));
    let mut fb2 = FB { pad: 0u64, y: 10u32 };
    let b2 = top_u32(mut_view(fb2), mut_view(cx));
    print_int(t2 as i32); print(" ");
    print_int(b2 as i32); print("\n");

    if a == 15i64 && a2 == 25i64 && b == 14u32 && rr == 35i64 && r1 == 45i64 && t2 == 105i64 && b2 == 26u32 { 42 } else { 1 }
}
