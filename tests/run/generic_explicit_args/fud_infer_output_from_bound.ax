// test: run
// modes: interp native
// stdout: 110 220\n111 -1\n
// exit: 42
// Regression for T448 (T422 FU-D): inside a generic function / generic impl whose parameter has the bound
// `F: Future<Output = i64>`, calling a helper `h<F2: Future<Output = T>, T>(fut: mut_view<F2>, ..)` infers
// `T = i64` from the caller's bound (no annotation, no explicit type arguments).

struct FutA {
    v: i64,
}

struct FutB {
    pad: u64,
    y: i64,
    left: u32,
}

impl Future for FutA {
    type Output = i64;
    fn poll(self: mut_view<FutA>, cx: mut_view<Context>) -> Poll<i64> {
        let _ = cx;
        Poll.Ready(100i64 + self.v)
    }
}

impl Future for FutB {
    type Output = i64;
    fn poll(self: mut_view<FutB>, cx: mut_view<Context>) -> Poll<i64> {
        let _ = cx;
        if self.left == 0u32 {
            Poll.Ready(200i64 + self.y)
        } else {
            self.left = self.left - 1u32;
            Poll.Pending
        }
    }
}

fn h<F: Future<Output = T>, T>(fut: mut_view<F>, cx: mut_view<Context>) -> Poll<Result<T, u32>> {
    match fut.poll(cx) {
        Poll.Ready(v) => Poll.Ready(Result.Ok(v)),
        Poll.Pending => Poll.Ready(Result.Err(9u32)),
    }
}

// Generic function: `T` of `h` comes from `F: Future<Output = i64>`.
fn outer<F: Future<Output = i64>>(fut: mut_view<F>, cx: mut_view<Context>) -> i64 {
    let r = h(fut, cx);
    match r {
        Poll.Ready(Result.Ok(v)) => v,
        Poll.Ready(Result.Err(_)) => -1i64,
        Poll.Pending => -2i64,
    }
}

struct W<F> {
    extra: i64,
    fut: F,
}

// Generic impl: the same inference inside a `poll` method.
impl<F: Future<Output = i64>> Future for W<F> {
    type Output = i64;
    fn poll(self: mut_view<W<F>>, cx: mut_view<Context>) -> Poll<i64> {
        match h(mut_view(self.fut), cx) {
            Poll.Ready(Result.Ok(v)) => Poll.Ready(v + self.extra),
            Poll.Ready(Result.Err(_)) => Poll.Ready(-1i64),
            Poll.Pending => Poll.Pending,
        }
    }
}

fn main() -> i32 {
    let rw = RawWaker { data: 0 as *const u8, vtable: 0 as *const RawWakerVTable };
    let w = Waker { raw: rw };
    let mut cx = Context { waker_val: w };

    let mut a = FutA { v: 10i64 };
    let mut b = FutB { pad: 5u64, y: 20i64, left: 0u32 };
    let ra = outer(mut_view(a), mut_view(cx));
    let rb = outer(mut_view(b), mut_view(cx));
    print_int(ra as i32); print(" ");
    print_int(rb as i32); print("\n");

    let mut wa = W<FutA> { extra: 1i64, fut: FutA { v: 10i64 } };
    let mut wb = W<FutB> { extra: 2i64, fut: FutB { pad: 5u64, y: 20i64, left: 1u32 } };
    let pa = match wa.poll(mut_view(cx)) { Poll.Ready(v) => v, Poll.Pending => -2i64 };
    let pb = match wb.poll(mut_view(cx)) { Poll.Ready(v) => v, Poll.Pending => -2i64 };
    print_int(pa as i32); print(" ");
    print_int(pb as i32); print("\n");

    if ra == 110i64 && rb == 220i64 && pa == 111i64 && pb == -1i64 { 42 } else { 1 }
}
