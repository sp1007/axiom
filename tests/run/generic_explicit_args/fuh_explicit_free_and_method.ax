// test: run
// modes: interp native
// stdout: 24 1 16\n124 101 116\n24 16 3\n
// exit: 42
// Regression for T448 (T422 FU-H): explicit type arguments are honoured when the type parameter occurs
// only in the body (`size_of<T>()`), only in the return type, or only in a bound, both for free
// functions (`free_one<A>()`) and for methods (`g.one<A>()`), without annotating the result.

@intrinsic fn size_of<T>() -> usize { 0 }

struct S1 { b: u8 }
struct S16 { x: u64, y: u64 }
struct S24 { a: u64, b: u64, c: u64 }

trait Tag {
    fn tag() -> u64;
}

impl Tag for S1 { fn tag() -> u64 { 1u64 } }
impl Tag for S16 { fn tag() -> u64 { 2u64 } }
impl Tag for S24 { fn tag() -> u64 { 3u64 } }

fn free_one<T>() -> usize {
    size_of<T>()
}

struct G {
    k: usize,
}

struct Res<T> {
    n: usize,
    slot: Option<T>,
}

impl G {
    fn one<T>(self: view<G>) -> usize {
        self.k + size_of<T>()
    }

    // `T` occurs only in the return type.
    fn collect<T>(self: view<G>) -> Result<Res<T>, u32> {
        if self.k == 0 {
            Result.Err(7u32)
        } else {
            Result.Ok(Res<T> { n: size_of<T>(), slot: Option.None })
        }
    }
}

// `T` occurs only in a bound.
fn tag_of<T: Tag>() -> u64 {
    T.tag()
}

fn main() -> i32 {
    let a = free_one<S24>();
    let b = free_one<S1>();
    let c = free_one<S16>();
    print_int(a as i32); print(" ");
    print_int(b as i32); print(" ");
    print_int(c as i32); print("\n");

    let g = G { k: 100 };
    let m1 = g.one<S24>();
    let m2 = g.one<S1>();
    let m3 = g.one<S16>();
    print_int(m1 as i32); print(" ");
    print_int(m2 as i32); print(" ");
    print_int(m3 as i32); print("\n");

    let r = g.collect<S24>();
    let n24 = match r {
        Result.Ok(x) => match x.slot {
            Option.Some(_) => 0,
            Option.None => x.n,
        },
        Result.Err(_) => 0,
    };
    let n16 = match g.collect<S16>() {
        Result.Ok(x) => x.n,
        Result.Err(_) => 0,
    };
    let t = tag_of<S24>();
    print_int(n24 as i32); print(" ");
    print_int(n16 as i32); print(" ");
    print_int(t as i32); print("\n");

    if a == 24 && b == 1 && c == 16 && m1 == 124 && m2 == 101 && m3 == 116 && n24 == 24 && n16 == 16 && t == 3u64 {
        42
    } else {
        1
    }
}
