// test: run
// modes: interp native
// stdout: 8 100 1\n16 100 1\n8 16\n
// exit: 42
// Regression for T448 (T421 FU-5): `let h = self.exec.spawn(Child {..}, poll_child)` inside a
// `Future::poll` infers `T` of `spawn<F: Future<Output = T>, T>` from `Child`'s `Future` impl (no
// `let h: Handle<i64>` annotation) even when nothing after the call constrains `T` (the handle is only
// inspected through methods that do not mention `T`). Same call in a plain function and with a 16-byte output.

@intrinsic fn size_of<T>() -> usize { 0 }

struct Pair {
    a: i64,
    b: i64,
}

struct Child {
    base: i64,
}

struct BigChild {
    base: i64,
}

impl Future for Child {
    type Output = i64;
    fn poll(self: mut_view<Child>, cx: mut_view<Context>) -> Poll<i64> {
        let _ = cx;
        Poll.Ready(self.base + 7i64)
    }
}

impl Future for BigChild {
    type Output = Pair;
    fn poll(self: mut_view<BigChild>, cx: mut_view<Context>) -> Poll<Pair> {
        let _ = cx;
        Poll.Ready(Pair { a: self.base, b: 1i64 })
    }
}

fn poll_child(raw: *mut u8, cx: *mut u8) -> u32 {
    let _ = raw;
    let _ = cx;
    0u32
}

struct Handle<T> {
    id: u64,
    out: Option<T>,
}

impl<T> Handle<T> {
    fn payload_size(self: view<Handle<T>>) -> usize {
        size_of<T>()
    }

    fn ready(self: view<Handle<T>>) -> bool {
        match self.out {
            Option.Some(_) => true,
            Option.None => false,
        }
    }

    fn detach(self: Handle<T>) {
        let _ = self;
    }
}

struct Exec {
    next_id: u64,
}

impl Exec {
    fn spawn<F: Future<Output = T>, T>(self: view<Exec>, fut: F, poll_fn: fn(*mut u8, *mut u8) -> u32) -> Handle<T> {
        let _ = poll_fn;
        let rw = RawWaker { data: 0 as *const u8, vtable: 0 as *const RawWakerVTable };
        let w = Waker { raw: rw };
        let mut cx = Context { waker_val: w };
        let mut f = fut;
        match f.poll(mut_view(cx)) {
            Poll.Ready(v) => Handle<T> { id: self.next_id, out: Option.Some(v) },
            Poll.Pending => Handle<T> { id: self.next_id, out: Option.None },
        }
    }
}

struct Parent {
    exec: Exec,
    seed: i64,
}

impl Future for Parent {
    type Output = i64;
    fn poll(self: mut_view<Parent>, cx: mut_view<Context>) -> Poll<i64> {
        let _ = cx;
        let h = self.exec.spawn(Child { base: self.seed }, poll_child);
        let hb = self.exec.spawn(BigChild { base: self.seed }, poll_child);
        let s = h.payload_size();
        let sb = hb.payload_size();
        h.detach();
        hb.detach();
        Poll.Ready((s as i64) * 100i64 + (sb as i64))
    }
}

fn report(ex: view<Exec>) -> usize {
    let h = ex.spawn(Child { base: 1i64 }, poll_child);
    let s = h.payload_size();
    print_int(s as i32); print(" ");
    print_int(h.id as i32); print(" ");
    let r1: i32 = if h.ready() { 1 } else { 0 };
    print_int(r1); print("\n");
    h.detach();
    let hb = ex.spawn(BigChild { base: 1i64 }, poll_child);
    let sb = hb.payload_size();
    print_int(sb as i32); print(" ");
    print_int(hb.id as i32); print(" ");
    let r2: i32 = if hb.ready() { 1 } else { 0 };
    print_int(r2); print("\n");
    hb.detach();
    s * 100 + sb
}

fn main() -> i32 {
    let ex = Exec { next_id: 100u64 };
    let from_fn = report(view(ex));

    let rw = RawWaker { data: 0 as *const u8, vtable: 0 as *const RawWakerVTable };
    let w = Waker { raw: rw };
    let mut cx = Context { waker_val: w };
    let mut p = Parent { exec: Exec { next_id: 100u64 }, seed: 400i64 };
    let from_poll = match p.poll(mut_view(cx)) { Poll.Ready(v) => v, Poll.Pending => -1i64 };

    print_int((from_poll / 100i64) as i32); print(" ");
    print_int((from_poll % 100i64) as i32); print("\n");
    if from_fn == 816 && from_poll == 816i64 { 42 } else { 1 }
}
