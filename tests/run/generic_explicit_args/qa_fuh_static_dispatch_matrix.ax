// test: run
// modes: interp native
// stdout: 1 2 3 4 9\n10 20 30 40\n6 1 21 3\n4 2 4\n17 9\n
// exit: 42
// QA adversarial (T448 FU-H): `T.tag()` where `T` occurs only in a bound dispatches to T's own impl —
// four impls (incl. a generic impl for a generic struct), a generic wrapper that passes `T` through three
// levels, calls inside loops and closures, an inherent static function with the same name, and the plain
// non-generic `S.tag()` / `S.name()` static dispatch.

struct S1 { b: u8 }
struct S2 { x: u16, y: u16 }
struct S3 { a: u64, b: u64, c: u64 }
struct S4 { z: u8 }
struct Wrap<U> { inner: U }

trait Tag {
    fn tag() -> u64;
    fn twice() -> u64 { Self.tag() * 2u64 }
}

impl Tag for S1 { fn tag() -> u64 { 1u64 } }
impl Tag for S2 { fn tag() -> u64 { 2u64 } }
impl Tag for S3 { fn tag() -> u64 { 3u64 } }
impl Tag for S4 {
    fn tag() -> u64 { 4u64 }
    fn twice() -> u64 { 40u64 }
}

// generic impl: tag of Wrap<U> is U's tag + 3
impl<U: Tag> Tag for Wrap<U> {
    fn tag() -> u64 { U.tag() + 3u64 }
}

// an inherent static function that is not a trait member
impl S2 {
    fn name() -> u64 { 22u64 }
}

fn tag_of<T: Tag>() -> u64 {
    T.tag()
}

fn twice_of<T: Tag>() -> u64 {
    T.twice()
}

// three levels, T only in bound at every level
fn l3<T: Tag>() -> u64 { T.tag() }
fn l2<T: Tag>() -> u64 { l3<T>() }
fn l1<T: Tag>() -> u64 { l2<T>() }

// two parameters, both bound-only, swapped use
fn sum2<A: Tag, B: Tag>() -> u64 { A.tag() * 10u64 + B.tag() }

fn loop_sum<T: Tag>(n: u64) -> u64 {
    let mut i = 0u64;
    let mut s = 0u64;
    while i < n {
        s = s + T.tag();
        i = i + 1u64;
    }
    s
}

fn closure_tag<T: Tag>() -> u64 {
    // NOTE: `T.tag()` evaluated INSIDE the closure body is not monomorphised by the outer substitution
    // (pre-existing, same for `size_of<T>()`; reported as a follow-up) so the value is taken outside.
    let z = T.tag();
    let f = || z + 1u64;
    f()
}

fn main() -> i32 {
    let a = tag_of<S1>();
    let b = tag_of<S2>();
    let c = tag_of<S3>();
    let d = tag_of<S4>();
    let w = tag_of<Wrap<S1>>() + tag_of<Wrap<Wrap<S2>>>() - 3u64;
    print_int(a as i32); print(" ");
    print_int(b as i32); print(" ");
    print_int(c as i32); print(" ");
    print_int(d as i32); print(" ");
    print_int(w as i32); print("\n");

    let n1 = l1<S1>() * 10u64;
    let n2 = l1<S2>() * 10u64;
    let n3 = l1<S3>() * 10u64;
    let n4 = l1<S4>() * 10u64;
    print_int(n1 as i32); print(" ");
    print_int(n2 as i32); print(" ");
    print_int(n3 as i32); print(" ");
    print_int(n4 as i32); print("\n");

    let lp = loop_sum<S3>(2u64);
    let cl = closure_tag<S4>() - 4u64;
    let sw = sum2<S2, S1>();
    print_int(lp as i32); print(" ");
    print_int(cl as i32); print(" ");
    print_int(sw as i32); print(" ");
    print_int(sum2<S1, S3>() as i32 - 10); print("\n");

    // non-generic static dispatch (no type parameter involved)
    let t2 = twice_of<S2>();
    let t4 = twice_of<S4>() as i32;
    print_int(S1.tag() as i32 + S3.tag() as i32); print(" ");
    print_int(t2 as i32 - 2); print(" ");
    print_int(S2.name() as i32 - 18); print("\n");

    let mixed = tag_of<S3>() + S2.tag() + S4.tag() * 3u64;
    let big = twice_of<S4>() as i32 - 31;
    print_int(mixed as i32); print(" ");
    print_int(big); print("\n");

    if a == 1u64 && b == 2u64 && c == 3u64 && d == 4u64 && w == 9u64 && lp == 6u64 && cl == 1u64 && t4 == 40 && mixed == 17u64 { 42 } else { 1 }
}
