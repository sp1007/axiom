// test: run
// modes: interp native
// stdout: 8 16 8\n8 8 1\n
// exit: 42
// QA adversarial (T448 FU-5): the method-call `Future` bound check applies only to methods of impls without
// generic parameters (documented limit). A method of a GENERIC impl must neither be newly rejected nor
// miscompiled: here `GEx<X>.spawn<F: Future<Output = T>, T>` is used with the result constrained by a later
// use, plus a generic caller `run<F: Future<Output = i64>>` that spawns its own `F` on a non-generic impl.

@intrinsic fn size_of<T>() -> usize { 0 }

struct Pair { a: i64, b: i64 }
struct Child { base: i64 }
struct Big { base: i64 }

impl Future for Child {
    type Output = i64;
    fn poll(self: mut_view<Child>, cx: mut_view<Context>) -> Poll<i64> {
        let _ = cx;
        Poll.Ready(self.base + 7i64)
    }
}

impl Future for Big {
    type Output = Pair;
    fn poll(self: mut_view<Big>, cx: mut_view<Context>) -> Poll<Pair> {
        let _ = cx;
        Poll.Ready(Pair { a: self.base, b: 1i64 })
    }
}

struct Handle<T> { out: Option<T> }

impl<T> Handle<T> {
    fn size(self: view<Handle<T>>) -> usize { size_of<T>() }
    fn get(self: Handle<T>, dflt: T) -> T {
        match self.out {
            Option.Some(v) => v,
            Option.None => dflt,
        }
    }
}

struct Ex { id: u64 }

impl Ex {
    fn spawn<F: Future<Output = T>, T>(self: view<Ex>, fut: F) -> Handle<T> {
        let rw = RawWaker { data: 0 as *const u8, vtable: 0 as *const RawWakerVTable };
        let w = Waker { raw: rw };
        let mut cx = Context { waker_val: w };
        let mut f = fut;
        match f.poll(mut_view(cx)) {
            Poll.Ready(v) => Handle<T> { out: Option.Some(v) },
            Poll.Pending => Handle<T> { out: Option.None },
        }
    }
}

struct GEx<X> { tagv: X }

impl<X> GEx<X> {
    fn spawn<F: Future<Output = T>, T>(self: view<GEx<X>>, fut: F) -> Handle<T> {
        let rw = RawWaker { data: 0 as *const u8, vtable: 0 as *const RawWakerVTable };
        let w = Waker { raw: rw };
        let mut cx = Context { waker_val: w };
        let mut f = fut;
        match f.poll(mut_view(cx)) {
            Poll.Ready(v) => Handle<T> { out: Option.Some(v) },
            Poll.Pending => Handle<T> { out: Option.None },
        }
    }
}

fn run<F: Future<Output = i64>>(ex: view<Ex>, fut: F) -> usize {
    let h = ex.spawn(fut);
    let s = h.size();
    h.get(0i64);
    s
}

fn main() -> i32 {
    let ex = Ex { id: 1u64 };
    let gex = GEx<u8> { tagv: 3u8 };

    let h1 = ex.spawn(Child { base: 1i64 });
    let h2 = ex.spawn(Big { base: 1i64 });
    let s1 = h1.size();
    let s2 = h2.size();
    h1.get(0i64);
    // generic-impl method: T fixed by the later use `get(0i64)`
    let g1 = gex.spawn(Child { base: 2i64 });
    let sg = g1.size();
    let v = g1.get(0i64);
    print_int(s1 as i32); print(" ");
    print_int(s2 as i32); print(" ");
    print_int(sg as i32); print("\n");

    let r = run(view(ex), Child { base: 5i64 });
    let r2 = run<Child>(view(ex), Child { base: 6i64 });
    let ok: i32 = if v == 9i64 { 1 } else { 0 };
    print_int(r as i32); print(" ");
    print_int(r2 as i32); print(" ");
    print_int(ok); print("\n");

    if s1 == 8 && s2 == 16 && sg == 8 && r == 8 && r2 == 8 && v == 9i64 { 42 } else { 1 }
}
