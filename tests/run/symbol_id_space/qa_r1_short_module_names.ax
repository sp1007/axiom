// test: run
// modes: interp native
// stdout: s 1\nst 2\nstdx 3\nstd -1\n
// T164 QA round 1 (adversarial): user modules whose names are prefixes or extensions of `std` (`s`, `st`,
// `stdx`) define traits named like std traits. The std/user domain test on a module path must compare the
// whole first segment (`std` exactly), never read past a shorter name or accept a longer one.
// Expected output written by hand from the default-method bodies below; std cmp of 1u8 vs 2u8 is Less (-1).

module s

pub trait Ord {
    fn sv(self: view<Self>) -> i32 {
        1
    }
}

module st

pub trait Ord {
    fn stv(self: view<Self>) -> i32 {
        2
    }
}

module stdx

pub trait Ord {
    fn sxv(self: view<Self>) -> i32 {
        3
    }
}

module main

struct P {
    pub v: i32,
}

impl s.Ord for P {}
impl st.Ord for P {}
impl stdx.Ord for P {}

fn a<T: s.Ord>(x: view<T>) -> i32 {
    x.sv()
}

fn b<T: st.Ord>(x: view<T>) -> i32 {
    x.stv()
}

fn c<T: stdx.Ord>(x: view<T>) -> i32 {
    x.sxv()
}

fn d<T: std.core.cmp.Ord>(x: view<T>, y: view<T>) -> i64 {
    match x.cmp(y) {
        std.core.cmp.Ordering.Less => -1,
        std.core.cmp.Ordering.Equal => 0,
        std.core.cmp.Ordering.Greater => 1,
    }
}

fn main() -> i32 {
    let p = P { v: 0 };
    print("s ")
    print_int(a(view(p)) as i64)
    print("\nst ")
    print_int(b(view(p)) as i64)
    print("\nstdx ")
    print_int(c(view(p)) as i64)
    let x: u8 = 1
    let y: u8 = 2
    print("\nstd ")
    print_int(d(view(x), view(y)))
    print("\n")
    0
}
