// test: ui
// T164 QA round 1 (adversarial, negative): the user trait `tr.Eq` has the user supertrait `tr.Ord`. `K`
// implements only the std `Ord` (same name, other domain), so `impl tr.Eq for K` lacks its supertrait: the
// coherence check (`check_impl_supertraits`, formerly an id-range domain test) must still reject it.

module tr

pub trait Ord {
    fn rank(self: view<Self>) -> i32;
}

pub trait Eq: Ord {
    fn eqv(self: view<Self>) -> i32 {
        1
    }
}

module main

struct K {
    pub v: i32,
}

impl std.core.cmp.Ord for K {
    fn cmp(self: view<Self>, other: view<Self>) -> std.core.cmp.Ordering {
        std.core.cmp.Ordering.Equal
    }
}

impl tr.Eq for K {} //~ ERROR AX_TRAIT_UNSATISFIED_BOUND

fn main() -> i32 {
    0
}
