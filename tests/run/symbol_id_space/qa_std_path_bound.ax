// test: run
// modes: interp native
// stdout: -1 1 0\n
// T164 QA (minimal regression): a generic bound spelled with the full std path `std.core.cmp.Ord` and no
// `use`, no user trait at all. The method `cmp` of the bound must be found (passes at HEAD; the T164 round-0
// solver rejected it with AX_TYPE_UNKNOWN_FIELD at `a.cmp(b)`).
// Expected output written by hand: 3 vs 9 Less (-1), 9 vs 3 Greater (1), 3 vs 3 Equal (0).

fn s<T: std.core.cmp.Ord>(a: view<T>, b: view<T>) -> i64 {
    match a.cmp(b) {
        std.core.cmp.Ordering.Less => -1,
        std.core.cmp.Ordering.Equal => 0,
        std.core.cmp.Ordering.Greater => 1,
    }
}

fn main() -> i32 {
    let x: u32 = 3
    let y: u32 = 9
    print_int(s(view(x), view(y)))
    print(" ")
    print_int(s(view(y), view(x)))
    print(" ")
    print_int(s(view(x), view(x)))
    print("\n")
    0
}
