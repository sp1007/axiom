// test: run
// modes: interp native
// stdout: ord 5 6\nclone 7 7\nfut 11 11\neq 6 6\niter 3 3\nstd -1 1 0\n
// T164 QA (adversarial): user traits named like std traits (Ord, Clone, Future, Eq, Iterator) in a user
// module, reached both through `use` and by full path, next to a std `Ord` bound spelled `std.core.cmp.Ord`.
// The trait solver must pick the user trait for every user reference (default methods, supertraits) and
// the std trait for the std path (`sym_is_std_item` replaced by module-path / `use` domain rules).
// Expected output written by hand: rank of P{5} is 5, through the generic `use` bound and +1 through the
// full-path bound; default methods 7, 11 and 3 from the user traits; user Eq (supertrait user Ord) gives
// rank+1 = 6; std Ord on u32: 3 vs 9 Less (-1), 9 vs 3 Greater (1), 3 vs 3 Equal (0).

module mytraits

pub trait Ord {
    fn rank(self: view<Self>) -> i32;
}

pub trait Clone {
    fn dup_score(self: view<Self>) -> i32 {
        7
    }
}

pub trait Future {
    fn ready_val(self: view<Self>) -> i32 {
        11
    }
}

pub trait Eq: Ord {
    fn eqv(self: view<Self>) -> i32;
}

pub trait Iterator {
    fn step(self: view<Self>) -> i32 {
        3
    }
}

module main

use mytraits.Ord
use mytraits.Eq

struct P {
    pub v: i32,
}

impl Ord for P {
    fn rank(self: view<Self>) -> i32 {
        self.v
    }
}

impl mytraits.Clone for P {}

impl mytraits.Future for P {}

impl Eq for P {
    fn eqv(self: view<Self>) -> i32 {
        self.rank() + 1
    }
}

impl mytraits.Iterator for P {}

fn by_use<T: Ord>(x: view<T>) -> i32 {
    x.rank()
}

fn by_path<T: mytraits.Ord>(x: view<T>) -> i32 {
    x.rank() + 1
}

fn cl<T: mytraits.Clone>(x: view<T>) -> i32 {
    x.dup_score()
}

fn fut<T: mytraits.Future>(x: view<T>) -> i32 {
    x.ready_val()
}

fn eqb<T: Eq>(x: view<T>) -> i32 {
    x.eqv()
}

fn it<T: mytraits.Iterator>(x: view<T>) -> i32 {
    x.step()
}

fn std_ord<T: std.core.cmp.Ord>(a: view<T>, b: view<T>) -> i64 {
    match a.cmp(b) {
        std.core.cmp.Ordering.Less => -1,
        std.core.cmp.Ordering.Equal => 0,
        std.core.cmp.Ordering.Greater => 1,
    }
}

fn main() -> i32 {
    let p = P { v: 5 };
    print("ord ")
    print_int(by_use(view(p)) as i64)
    print(" ")
    print_int(by_path(view(p)) as i64)
    print("\nclone ")
    print_int(p.dup_score() as i64)
    print(" ")
    print_int(cl(view(p)) as i64)
    print("\nfut ")
    print_int(p.ready_val() as i64)
    print(" ")
    print_int(fut(view(p)) as i64)
    print("\neq ")
    print_int(p.eqv() as i64)
    print(" ")
    print_int(eqb(view(p)) as i64)
    print("\niter ")
    print_int(p.step() as i64)
    print(" ")
    print_int(it(view(p)) as i64)
    print("\nstd ")
    let x: u32 = 3
    let y: u32 = 9
    print_int(std_ord(view(x), view(y)))
    print(" ")
    print_int(std_ord(view(y), view(x)))
    print(" ")
    print_int(std_ord(view(x), view(x)))
    print("\n")
    0
}
