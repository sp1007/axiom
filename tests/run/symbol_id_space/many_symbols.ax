@link("kernel32")
extern "system" {
    fn GetCurrentProcessId() -> u32;
    fn GetCurrentThreadId() -> u32;
    fn GetTickCount() -> u32;
    fn GetLastError() -> u32;
    fn GetStdHandle(n: u32) -> usize;
    fn CloseHandle(h: usize) -> i32;
}

fn last_variant(e: E575) -> i64 {
    match e {
        E575.V0 => 0,
        E575.V49 => 49,
        _ => 1,
    }
}

fn ord_score<T: Ord>(a: view<T>, b: view<T>) -> i64 {
    match a.cmp(b) {
        Ordering.Less => -1,
        Ordering.Equal => 0,
        Ordering.Greater => 1,
    }
}

fn call_externs() -> u32 {
    let pid: u32 = unsafe { GetCurrentProcessId() };
    let tid: u32 = unsafe { GetCurrentThreadId() };
    let ticks: u32 = unsafe { GetTickCount() };
    let err: u32 = unsafe { GetLastError() };
    let h: usize = unsafe { GetStdHandle(4294967285u32) };
    let closed: i32 = unsafe { CloseHandle(0) };
    pid + tid + ticks + err + (h as u32) + (closed as u32)
}

fn main() -> i32 {
    print("enums ")
    print_int(576i64)
    print(" last ")
    print_int(last_variant(E575.V49))
    print("\n")
