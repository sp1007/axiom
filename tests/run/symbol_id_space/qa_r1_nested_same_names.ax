// test: run
// modes: interp native
// stdout: hash 1 2 1 2\ndef 31 32\nfut 41\nclone 51\niter 61\neq 71 72\nord 5 50\nstd -1 1\n
// T164 QA round 1 (adversarial): two nested user modules `lib.inner` and `lib.other` both define traits named
// like std/prelude traits (Hash, Default, Future, Clone, Iterator, Eq, Ord) whose default methods share a name
// but return different values. Each reference (via `use`, via qualified nested path) must select the trait of
// exactly its defining module (HirPath.def_mod), never the same-named trait of the sibling module or of std.
// Expected output written by hand from the default-method bodies below.

module lib.inner

pub trait Hash {
    fn tag(self: view<Self>) -> i32 {
        1
    }
}

pub trait Default {
    fn dv(self: view<Self>) -> i32 {
        31
    }
}

pub trait Future {
    fn ready_val(self: view<Self>) -> i32 {
        41
    }
}

pub trait Clone {
    fn dup_score(self: view<Self>) -> i32 {
        51
    }
}

pub trait Iterator {
    fn step(self: view<Self>) -> i32 {
        61
    }
}

pub trait Ord {
    fn rank(self: view<Self>) -> i32;
}

pub trait Eq: Ord {
    fn eqv(self: view<Self>) -> i32 {
        71
    }
}

module lib.other

pub trait Hash {
    fn tag(self: view<Self>) -> i32 {
        2
    }
}

pub trait Default {
    fn dv(self: view<Self>) -> i32 {
        32
    }
}

pub trait Ord {
    fn rank(self: view<Self>) -> i32;
}

pub trait Eq: Ord {
    fn eqv(self: view<Self>) -> i32 {
        72
    }
}

module main

use lib.inner.Hash
use lib.inner.Future

struct P {
    pub v: i32,
}

struct Q {
    pub v: i32,
}

impl Hash for P {}
impl lib.other.Hash for Q {}
impl lib.inner.Default for P {}
impl lib.other.Default for Q {}
impl Future for P {}
impl lib.inner.Clone for P {}
impl lib.inner.Iterator for P {}

impl lib.inner.Ord for P {
    fn rank(self: view<Self>) -> i32 {
        self.v
    }
}
impl lib.inner.Eq for P {}

impl lib.other.Ord for Q {
    fn rank(self: view<Self>) -> i32 {
        self.v * 10
    }
}
impl lib.other.Eq for Q {}

fn h_use<T: Hash>(x: view<T>) -> i32 {
    x.tag()
}

fn h_other<T: lib.other.Hash>(x: view<T>) -> i32 {
    x.tag()
}

fn d_in<T: lib.inner.Default>(x: view<T>) -> i32 {
    x.dv()
}

fn d_other<T: lib.other.Default>(x: view<T>) -> i32 {
    x.dv()
}

fn f<T: Future>(x: view<T>) -> i32 {
    x.ready_val()
}

fn e_in<T: lib.inner.Eq>(x: view<T>) -> i32 {
    x.eqv()
}

fn e_other<T: lib.other.Eq>(x: view<T>) -> i32 {
    x.eqv()
}

fn r_in<T: lib.inner.Eq>(x: view<T>) -> i32 {
    x.rank()
}

fn r_other<T: lib.other.Eq>(x: view<T>) -> i32 {
    x.rank()
}

fn s<T: std.core.cmp.Ord>(a: view<T>, b: view<T>) -> i64 {
    match a.cmp(b) {
        std.core.cmp.Ordering.Less => -1,
        std.core.cmp.Ordering.Equal => 0,
        std.core.cmp.Ordering.Greater => 1,
    }
}

fn main() -> i32 {
    let p = P { v: 5 };
    let q = Q { v: 5 };
    print("hash ")
    print_int(h_use(view(p)) as i64)
    print(" ")
    print_int(h_other(view(q)) as i64)
    print(" ")
    print_int(p.tag() as i64)
    print(" ")
    print_int(q.tag() as i64)
    print("\ndef ")
    print_int(d_in(view(p)) as i64)
    print(" ")
    print_int(d_other(view(q)) as i64)
    print("\nfut ")
    print_int(f(view(p)) as i64)
    print("\nclone ")
    print_int(p.dup_score() as i64)
    print("\niter ")
    print_int(p.step() as i64)
    print("\neq ")
    print_int(e_in(view(p)) as i64)
    print(" ")
    print_int(e_other(view(q)) as i64)
    print("\nord ")
    print_int(r_in(view(p)) as i64)
    print(" ")
    print_int(r_other(view(q)) as i64)
    print("\nstd ")
    let a: u64 = 2
    let b: u64 = 8
    print_int(s(view(a), view(b)))
    print(" ")
    print_int(s(view(b), view(a)))
    print("\n")
    0
}
