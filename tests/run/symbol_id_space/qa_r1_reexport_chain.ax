// test: run
// modes: interp native
// stdout: std -1 1 0\nuser 21 21 21\nnear 7\n
// T164 QA round 1 (adversarial): `pub use` chains. The std `Ord` travels std -> c1 -> c2 -> main; the user trait
// `Default` travels u1 -> u2 -> u3 -> main and is also named by the qualified re-export path `u3.Default`. A
// second user `Default` in `near` (re-exporting nothing) must not be picked. The trait solver must follow each
// binding to the defining module (naming table), not to the module named in the `use`/path.
// Expected output written by hand: std cmp on u16 (3 vs 9, 9 vs 3, 3 vs 3); u1.Default.dv() = 21; near = 7.

module c1

pub use std.core.cmp.Ord

module c2

pub use c1.Ord

module u1

pub trait Default {
    fn dv(self: view<Self>) -> i32 {
        21
    }
}

module u2

pub use u1.Default

module u3

pub use u2.Default

module near

pub trait Default {
    fn dv(self: view<Self>) -> i32 {
        7
    }
}

module main

use c2.Ord
use u3.Default

struct P {
    pub v: i32,
}

struct R {
    pub v: i32,
}

impl Default for P {}
impl near.Default for R {}

fn s<T: Ord>(a: view<T>, b: view<T>) -> i64 {
    match a.cmp(b) {
        std.core.cmp.Ordering.Less => -1,
        std.core.cmp.Ordering.Equal => 0,
        std.core.cmp.Ordering.Greater => 1,
    }
}

fn d_use<T: Default>(x: view<T>) -> i32 {
    x.dv()
}

fn d_path<T: u3.Default>(x: view<T>) -> i32 {
    x.dv()
}

fn d_near<T: near.Default>(x: view<T>) -> i32 {
    x.dv()
}

fn main() -> i32 {
    let x: u16 = 3
    let y: u16 = 9
    print("std ")
    print_int(s(view(x), view(y)))
    print(" ")
    print_int(s(view(y), view(x)))
    print(" ")
    print_int(s(view(x), view(x)))
    let p = P { v: 1 };
    print("\nuser ")
    print_int(d_use(view(p)) as i64)
    print(" ")
    print_int(d_path(view(p)) as i64)
    print(" ")
    print_int(p.dv() as i64)
    let r = R { v: 2 };
    print("\nnear ")
    print_int(d_near(view(r)) as i64)
    print("\n")
    0
}
