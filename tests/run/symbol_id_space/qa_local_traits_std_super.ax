// test: run
// modes: interp native
// stdout: local 21 4\nranked 1 -1 0\nfut 9\n
// T164 QA (adversarial): module `main` defines its own `Ord` and `Future` (same names as std.core.cmp.Ord and
// the prelude's Future) and refers to them unqualified, while a user trait `Ranked` has the std supertrait
// `std.core.cmp.Ord` and a user struct implements the std trait by full path. The solver must take the
// module-local trait for the bare names and the std trait for the `std.` paths (supertrait domain check).
// Expected output written by hand: local Ord default method 21, local `level` 4; Ranked uses std cmp of
// W{8} vs W{2} Greater (1), W{2} vs W{8} Less (-1), equal (0); local Future default method 9.

module main

trait Ord {
    fn weight(self: view<Self>) -> i32 {
        21
    }
    fn level(self: view<Self>) -> i32;
}

trait Future {
    fn later(self: view<Self>) -> i32 {
        9
    }
}

trait Ranked: std.core.cmp.Ord {
    fn sign_vs(self: view<Self>, other: view<Self>) -> i64 {
        match self.cmp(other) {
            std.core.cmp.Ordering.Less => -1,
            std.core.cmp.Ordering.Equal => 0,
            std.core.cmp.Ordering.Greater => 1,
        }
    }
}

struct W {
    pub v: i32,
}

impl std.core.cmp.Ord for W {
    fn cmp(self: view<W>, other: view<W>) -> std.core.cmp.Ordering {
        let sv: i32 = self.v
        let ov: i32 = other.v
        if sv < ov {
            std.core.cmp.Ordering.Less
        } else if sv > ov {
            std.core.cmp.Ordering.Greater
        } else {
            std.core.cmp.Ordering.Equal
        }
    }
}

impl Ranked for W {}

impl Ord for W {
    fn level(self: view<Self>) -> i32 {
        self.v / 2
    }
}

impl Future for W {}

fn local_w<T: Ord>(x: view<T>) -> i32 {
    x.weight()
}

fn local_l<T: Ord>(x: view<T>) -> i32 {
    x.level()
}

fn ranked<T: Ranked>(a: view<T>, b: view<T>) -> i64 {
    a.sign_vs(b)
}

fn fut<T: Future>(x: view<T>) -> i32 {
    x.later()
}

fn main() -> i32 {
    let a = W { v: 8 };
    let b = W { v: 2 };
    print("local ")
    print_int(local_w(view(a)) as i64)
    print(" ")
    print_int(local_l(view(a)) as i64)
    print("\nranked ")
    print_int(ranked(view(a), view(b)))
    print(" ")
    print_int(ranked(view(b), view(a)))
    print(" ")
    print_int(ranked(view(a), view(a)))
    print("\nfut ")
    print_int(fut(view(b)) as i64)
    print("\n")
    0
}
