// test: run
// modes: interp native
// stdout: 11 12\n
// T164 QA (minimal regression): a user trait named `Future` (the prelude exports std's `Future`) in module
// `m`, implemented and bounded through the qualified path `m.Future` with no `use`. Its default method must be
// found for the concrete call and through the generic bound (passes at HEAD; the T164 round-0 solver picked the
// prelude's std `Future` for the qualified user path and rejected `ready_val` with AX_TYPE_UNKNOWN_FIELD).
// Expected output written by hand: default method 11; through the bound 11 + 1 = 12.

module m

pub trait Future {
    fn ready_val(self: view<Self>) -> i32 {
        11
    }
}

module main

struct P {
    pub v: i32,
}

impl m.Future for P {}

fn via_bound<T: m.Future>(x: view<T>) -> i32 {
    x.ready_val() + 1
}

fn main() -> i32 {
    let p = P { v: 5 }
    print_int(p.ready_val() as i64)
    print(" ")
    print_int(via_bound(view(p)) as i64)
    print("\n")
    0
}
