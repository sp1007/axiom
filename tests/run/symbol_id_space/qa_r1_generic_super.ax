// test: run
// modes: interp native
// stdout: path -1 1 0\nmy 6\nwrap 60 61\nsuper -1 1\nmulti 6 -1\n
// T164 QA round 1 (adversarial): qualified std and user traits of the same name, generic impls with bounds
// (`impl<T: tr.Ord> tr.Ord for W<T>`), supertraits across domains (user `Sorted: std.core.cmp.Ord` used through
// the subtrait bound; user `Eq: tr.Ord`), and a two-trait bound mixing a user and a std trait.
// Expected output written by hand: std cmp on u32 (2 vs 8, 8 vs 2, 2 vs 2); rank of K{6} = 6; W<K{6}> rank = 60
// and its user Eq default = rank + 1 = 61; Sorted via std supertrait on K (K.v 1 vs 3, 3 vs 1); multi = 6 and -1.

module tr

pub trait Ord {
    fn rank(self: view<Self>) -> i32;
}

pub trait Eq: Ord {
    fn eqv(self: view<Self>) -> i32 {
        self.rank() + 1
    }
}

pub trait Sorted: std.core.cmp.Ord {
    fn sorted_tag(self: view<Self>) -> i32 {
        0
    }
}

module main


struct K {
    pub v: i32,
}

struct W<T> {
    pub inner: T,
}

impl tr.Ord for K {
    fn rank(self: view<Self>) -> i32 {
        self.v
    }
}

impl std.core.cmp.Ord for K {
    fn cmp(self: view<Self>, other: view<Self>) -> std.core.cmp.Ordering {
        if (self.v) < (other.v) {
            std.core.cmp.Ordering.Less
        } else if (self.v) > (other.v) {
            std.core.cmp.Ordering.Greater
        } else {
            std.core.cmp.Ordering.Equal
        }
    }
}

impl tr.Sorted for K {}

impl<T: tr.Ord> tr.Ord for W<T> {
    fn rank(self: view<Self>) -> i32 {
        self.inner.rank() * 10
    }
}

impl<T: tr.Ord> tr.Eq for W<T> {}

fn by_std<T: std.core.cmp.Ord>(a: view<T>, b: view<T>) -> i64 {
    match a.cmp(b) {
        std.core.cmp.Ordering.Less => -1,
        std.core.cmp.Ordering.Equal => 0,
        std.core.cmp.Ordering.Greater => 1,
    }
}

fn by_user<T: tr.Ord>(x: view<T>) -> i32 {
    x.rank()
}

fn by_eq<T: tr.Eq>(x: view<T>) -> i32 {
    x.eqv()
}

fn by_super<T: tr.Sorted>(a: view<T>, b: view<T>) -> i64 {
    match a.cmp(b) {
        std.core.cmp.Ordering.Less => -1,
        std.core.cmp.Ordering.Equal => 0,
        std.core.cmp.Ordering.Greater => 1,
    }
}

fn multi<T: tr.Ord + std.core.cmp.Ord>(a: view<T>, b: view<T>) -> i64 {
    let r = a.rank() as i64;
    match a.cmp(b) {
        std.core.cmp.Ordering.Less => r * 0 - 1,
        std.core.cmp.Ordering.Equal => r,
        std.core.cmp.Ordering.Greater => r + 100,
    }
}

fn main() -> i32 {
    let x: u32 = 2
    let y: u32 = 8
    print("path ")
    print_int(by_std(view(x), view(y)))
    print(" ")
    print_int(by_std(view(y), view(x)))
    print(" ")
    print_int(by_std(view(x), view(x)))
    let k = K { v: 6 };
    print("\nmy ")
    print_int(by_user(view(k)) as i64)
    let w = W { inner: K { v: 6 } };
    print("\nwrap ")
    print_int(by_user(view(w)) as i64)
    print(" ")
    print_int(by_eq(view(w)) as i64)
    let k1 = K { v: 1 };
    let k3 = K { v: 3 };
    print("\nsuper ")
    print_int(by_super(view(k1), view(k3)))
    print(" ")
    print_int(by_super(view(k3), view(k1)))
    print("\nmulti ")
    print_int(multi(view(k), view(k)))
    print(" ")
    print_int(multi(view(k1), view(k3)))
    print("\n")
    0
}
