// test: run
// modes: interp native
// stdout: std -1 1 0\nuser 4\n
// T164 QA (adversarial): the std trait `Ord` re-exported by a user module (`facade`, path not starting with
// `std.`) and imported with `use facade.Ord`, while another user module defines its own `Ord`. The bound
// `T: Ord` is the std trait (`a.cmp(b)` on u32), the bound `T: mytraits.Ord` the user one. Passes at HEAD.
// Expected output written by hand: std cmp 3 vs 9 Less (-1), 9 vs 3 Greater (1), 3 vs 3 Equal (0); rank of Q{4} is 4.

module facade

pub use std.core.cmp.Ord

module mytraits

pub trait Ord {
    fn rank(self: view<Self>) -> i32;
}

module main

use facade.Ord

struct Q {
    pub v: i32,
}

impl mytraits.Ord for Q {
    fn rank(self: view<Self>) -> i32 {
        self.v
    }
}

fn s<T: Ord>(a: view<T>, b: view<T>) -> i64 {
    match a.cmp(b) {
        std.core.cmp.Ordering.Less => -1,
        std.core.cmp.Ordering.Equal => 0,
        std.core.cmp.Ordering.Greater => 1,
    }
}

fn u<T: mytraits.Ord>(x: view<T>) -> i32 {
    x.rank()
}

fn main() -> i32 {
    let x: u32 = 3
    let y: u32 = 9
    print("std ")
    print_int(s(view(x), view(y)))
    print(" ")
    print_int(s(view(y), view(x)))
    print(" ")
    print_int(s(view(x), view(x)))
    print("\nuser ")
    let q = Q { v: 4 }
    print_int(u(view(q)) as i64)
    print("\n")
    0
}
