// test: run
// stdout: RECUR_SUM=247\nBACK_ANTI=63\nOVERLAP_ALIAS=136\n

fn recurrence_distance_one() -> i32 {
    let mut a: [7]i32 = [1, 0, 0, 0, 0, 0, 0];
    let mut i: usize = 0;
    while i < 6 {
        let prev: i32 = a[i];
        a[i + 1] = prev * 2 + 1;
        i = i + 1;
    }
    let mut k: usize = 0;
    let mut sum: i32 = 0;
    while k < 7 {
        sum = sum + a[k];
        k = k + 1;
    }
    sum
}

fn backward_anti_dependence() -> i32 {
    let mut b: [6]i32 = [0, 6, 7, 9, 11, 10];
    let mut i: usize = 0;
    while i < 5 {
        let next_val: i32 = b[i + 1];
        b[i] = next_val + 2;
        i = i + 1;
    }
    let mut k: usize = 0;
    let mut sum: i32 = 0;
    while k < 6 {
        sum = sum + b[k];
        k = k + 1;
    }
    sum
}

fn overlapping_slice_recurrence(mv: mut_view<[i32]>) -> i32 {
    let mut i: usize = 0;
    while i + 1 < len(mv) {
        let cur: i32 = mv[i];
        mv[i + 1] = cur + 4;
        i = i + 1;
    }
    let mut k: usize = 0;
    let mut sum: i32 = 0;
    while k < len(mv) {
        sum = sum + mv[k];
        k = k + 1;
    }
    sum
}

fn main() -> i32 {
    let r1: i32 = recurrence_distance_one();
    let r2: i32 = backward_anti_dependence();
    let mut buf: [8]i32 = [3, 0, 0, 0, 0, 0, 0, 0];
    let r3: i32 = overlapping_slice_recurrence(mut_view(buf));

    print("RECUR_SUM=");
    print_int(r1);
    print("\nBACK_ANTI=");
    print_int(r2);
    print("\nOVERLAP_ALIAS=");
    print_int(r3);
    print("\n");
    0
}
