// test: run
// exit: 101

fn checked_sum_must_trap(s: view<[i32]>) -> i32 {
    let mut i: usize = 0;
    let mut acc: i32 = 2000000000;
    while i < len(s) {
        acc = acc + s[i];
        i = i + 1;
    }
    acc
}

fn main() -> i32 {
    let arr: [6]i32 = [50000000, 50000000, 50000000, 50000000, 50000000, 50000000];
    let v: i32 = checked_sum_must_trap(view(arr));
    print_int(v);
    0
}
