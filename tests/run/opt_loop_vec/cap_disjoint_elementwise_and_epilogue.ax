// test: run
// stdout: VEC_BANNER=Xin chào vector hóa vòng lặp tự động\nDROP_GUARD=77\nN0=0\nN1=19\nN3=69\nN4=100\nN7=217\nN8=264\nN19=1045\nBLEND=167\n

struct VecGuard {
    id: i32,
}

impl Drop for VecGuard {
    fn drop(self: mut_view<VecGuard>) {
        print("DROP_GUARD=");
        print_int(self.id);
        print("\n");
    }
}

fn fill_inputs(a: mut_view<[i32]>, b: mut_view<[i32]>) {
    let mut i: usize = 0;
    while i < len(a) && i < len(b) {
        let iv: i32 = i as i32;
        a[i] = iv + 2;
        b[i] = iv * 2 + 5;
        i = i + 1;
    }
}

fn kernel_cap_disjoint(dst: mut_view<[i32]>, a: view<[i32]>, b: view<[i32]>, scale: i32, bias: i32, n: usize) -> i32 {
    let mut i: usize = 0;
    while i < n && i < len(dst) && i < len(a) && i < len(b) {
        dst[i] = a[i] * scale + b[i] + bias;
        i = i + 1;
    }
    let mut k: usize = 0;
    let mut sum: i32 = 0;
    while k < n && k < len(dst) {
        sum = sum + dst[k];
        k = k + 1;
    }
    sum
}

fn kernel_predicated_blend(dst: mut_view<[i32]>, a: view<[i32]>, b: view<[i32]>, n: usize) -> i32 {
    let mut i: usize = 0;
    while i < n && i < len(dst) && i < len(a) && i < len(b) {
        let av: i32 = a[i];
        let bv: i32 = b[i];
        let picked: i32 = if av > 6 { av + 10 } else { bv + 1 };
        dst[i] = picked;
        i = i + 1;
    }
    let mut k: usize = 0;
    let mut acc: i32 = 0;
    while k < n && k < len(dst) {
        acc = acc + dst[k];
        k = k + 1;
    }
    acc
}

fn run_kernels() -> [8]i32 {
    let g = VecGuard { id: 77 };
    let mut a: [24]i32 = [0; 24];
    let mut b: [24]i32 = [0; 24];
    let mut dst: [24]i32 = [0; 24];
    fill_inputs(mut_view(a), mut_view(b));

    let s0: i32 = kernel_cap_disjoint(mut_view(dst), view(a), view(b), 2, 10, 0);
    let s1: i32 = kernel_cap_disjoint(mut_view(dst), view(a), view(b), 2, 10, 1);
    let s3: i32 = kernel_cap_disjoint(mut_view(dst), view(a), view(b), 2, 10, 3);
    let s4: i32 = kernel_cap_disjoint(mut_view(dst), view(a), view(b), 2, 10, 4);
    let s7: i32 = kernel_cap_disjoint(mut_view(dst), view(a), view(b), 2, 10, 7);
    let s8: i32 = kernel_cap_disjoint(mut_view(dst), view(a), view(b), 2, 10, 8);
    let s19: i32 = kernel_cap_disjoint(mut_view(dst), view(a), view(b), 2, 10, 19);
    let blend: i32 = kernel_predicated_blend(mut_view(dst), view(a), view(b), 11);
    let _ = g.id;
    [s0, s1, s3, s4, s7, s8, s19, blend]
}

fn main() -> i32 {
    print("VEC_BANNER=Xin chào vector hóa vòng lặp tự động\n");
    let res: [8]i32 = run_kernels();
    print("N0=");
    print_int(res[0]);
    print("\nN1=");
    print_int(res[1]);
    print("\nN3=");
    print_int(res[2]);
    print("\nN4=");
    print_int(res[3]);
    print("\nN7=");
    print_int(res[4]);
    print("\nN8=");
    print_int(res[5]);
    print("\nN19=");
    print_int(res[6]);
    print("\nBLEND=");
    print_int(res[7]);
    print("\n");
    0
}
