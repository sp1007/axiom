// test: run
// stdout: WRAP_ADD=455\nWRAP_MUL=362880\nBIT_XOR=19\nBIT_OR=63\nBIT_AND=0\nMIN_MAX=97\n

@intrinsic fn wrapping_add_i32(a: i32, b: i32) -> i32 { 0 }
@intrinsic fn wrapping_mul_i32(a: i32, b: i32) -> i32 { 0 }

fn reduce_wrapping_add(s: view<[i32]>) -> i32 {
    let mut i: usize = 0;
    let mut acc: i32 = 0;
    while i < len(s) {
        acc = wrapping_add_i32(acc, s[i]);
        i = i + 1;
    }
    acc
}

fn reduce_wrapping_mul(s: view<[i32]>) -> i32 {
    let mut i: usize = 0;
    let mut acc: i32 = 1;
    while i < len(s) {
        acc = wrapping_mul_i32(acc, s[i]);
        i = i + 1;
    }
    acc
}

fn reduce_bit_xor(s: view<[i32]>) -> i32 {
    let mut i: usize = 0;
    let mut acc: i32 = 0;
    while i < len(s) {
        acc = acc ^ s[i];
        i = i + 1;
    }
    acc
}

fn reduce_bit_or(s: view<[i32]>) -> i32 {
    let mut i: usize = 0;
    let mut acc: i32 = 0;
    while i < len(s) {
        acc = acc | s[i];
        i = i + 1;
    }
    acc
}

fn reduce_bit_and(s: view<[i32]>) -> i32 {
    let mut i: usize = 0;
    let mut acc: i32 = 63;
    while i < len(s) {
        acc = acc & s[i];
        i = i + 1;
    }
    acc
}

fn reduce_min_max(s: view<[i32]>) -> i32 {
    let mut i: usize = 0;
    let mut lo: i32 = 1000;
    let mut hi: i32 = -1000;
    while i < len(s) {
        let v: i32 = s[i];
        lo = if v < lo { v } else { lo };
        hi = if v > hi { v } else { hi };
        i = i + 1;
    }
    lo + hi
}

fn main() -> i32 {
    let add_arr: [13]i32 = [5, 10, 15, 20, 25, 30, 35, 40, 45, 50, 55, 60, 65];
    let mul_arr: [9]i32 = [1, 2, 3, 4, 5, 6, 7, 8, 9];
    let xor_arr: [9]i32 = [3, 7, 12, 5, 9, 14, 3, 7, 29];
    let or_arr: [9]i32 = [1, 2, 4, 8, 16, 32, 3, 12, 48];
    let and_arr: [9]i32 = [63, 31, 15, 7, 3, 1, 62, 30, 14];
    let mm_arr: [11]i32 = [42, 17, 88, 5, 63, 92, 11, 29, 74, 8, 51];

    print("WRAP_ADD=");
    print_int(reduce_wrapping_add(view(add_arr)));
    print("\nWRAP_MUL=");
    print_int(reduce_wrapping_mul(view(mul_arr)));
    print("\nBIT_XOR=");
    print_int(reduce_bit_xor(view(xor_arr)));
    print("\nBIT_OR=");
    print_int(reduce_bit_or(view(or_arr)));
    print("\nBIT_AND=");
    print_int(reduce_bit_and(view(and_arr)));
    print("\nMIN_MAX=");
    print_int(reduce_min_max(view(mm_arr)));
    print("\n");
    0
}
