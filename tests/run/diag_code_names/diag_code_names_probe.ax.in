// T497a: every code id renders through compiler.diag.format.diag_buf_push_code_name with exactly the name diag_code_name gives,
// and no registered id renders as `<unknown>`. "Registered" is judged by an independent table: diag_code_default_message is
// non-empty exactly for registered ids, so a code added to the message table (or the name table) but missing from the other
// is reported too. The sweep goes past the highest registered id (169) to check that unregistered ids stay `<unknown>`.

module main

use host_intrinsics.stdio
use host_intrinsics.write

use compiler.kernel.interner.StrView
use compiler.diag.code.diag_code
use compiler.diag.code.diag_code_name
use compiler.diag.code.diag_code_default_message
use compiler.diag.format.DiagBuffer
use compiler.diag.format.diag_buf_init
use compiler.diag.format.diag_buf_free
use compiler.diag.format.diag_buf_as_str_view
use compiler.diag.format.diag_buf_push_code_name
use compiler.diag.format.diag_buf_push_u32
use compiler.diag.ux2.ux2_sv
use compiler.diag.ux2.ux2_sv_eq

fn out_str(s: str) {
    let sv = ux2_sv(s)
    let _ = unsafe { write(stdio(1), sv.ptr, sv.len) }
}

fn out_u32(n: u32) {
    let mut nb = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
    diag_buf_init(mut_view(nb))
    diag_buf_push_u32(mut_view(nb), n)
    let sv = diag_buf_as_str_view(view(nb))
    let _ = unsafe { write(stdio(1), sv.ptr, sv.len) }
    diag_buf_free(mut_view(nb))
}

pub fn main() -> i32 {
    let unknown = ux2_sv("<unknown>")
    let mut b = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
    diag_buf_init(mut_view(b))
    let mut mismatch: u32 = 0u32
    let mut unknown_registered: u32 = 0u32
    let mut registered: u32 = 0u32
    let mut highest: u32 = 0u32
    let mut i: u32 = 0u32
    while i <= 255u32 {
        b.len = 0
        diag_buf_push_code_name(mut_view(b), diag_code(i))
        let rendered = diag_buf_as_str_view(view(b))
        let want = ux2_sv(diag_code_name(diag_code(i)))
        if !ux2_sv_eq(rendered, want) {
            mismatch = mismatch + 1u32
        }
        let has_message = ux2_sv(diag_code_default_message(diag_code(i))).len > 0
        let is_unknown = ux2_sv_eq(rendered, unknown)
        if has_message {
            registered = registered + 1u32
            highest = i
            if is_unknown {
                unknown_registered = unknown_registered + 1u32
            }
        } else if !is_unknown {
            // named but without a message: the two tables disagree
            unknown_registered = unknown_registered + 1u32
        }
        i = i + 1u32
    }
    // the async family (AX_ASYNC_*, ids 156..165) is the case that regressed: pin it explicitly
    let mut async_bad: u32 = 0u32
    let mut k: u32 = 156u32
    while k <= 165u32 {
        b.len = 0
        diag_buf_push_code_name(mut_view(b), diag_code(k))
        let rendered = diag_buf_as_str_view(view(b))
        let prefix = ux2_sv("AX_ASYNC_")
        let mut ok = rendered.len > prefix.len
        let mut j: usize = 0
        while ok && j < prefix.len {
            if unsafe { *(rendered.ptr + j) != *(prefix.ptr + j) } {
                ok = false
            }
            j = j + 1
        }
        if !ok {
            async_bad = async_bad + 1u32
        }
        k = k + 1u32
    }
    diag_buf_free(mut_view(b))

    out_str("codes mismatch=")
    out_u32(mismatch)
    out_str(" table_disagree=")
    out_u32(unknown_registered)
    out_str(" async_bad=")
    out_u32(async_bad)
    out_str(" registered_nonzero=")
    if registered > 0u32 && highest >= 169u32 { out_str("true") } else { out_str("false") }
    out_str("\n")
    if mismatch != 0u32 || unknown_registered != 0u32 || async_bad != 0u32 || registered == 0u32 || highest < 169u32 {
        return 1
    }
    out_str("DIAG-CODE-NAMES-PROBE-PASS\n")
    0
}
