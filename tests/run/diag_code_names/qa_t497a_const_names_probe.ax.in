// T497a QA: dump `<id> <rendered name>` for every id 0..=300 through compiler.diag.format.diag_buf_push_code_name. The oracle compares the
// dump with an expectation parsed from the `pub const AX_*: u32 = N;` constants of compiler/diag/code.ax (a third source, independent of
// both name tables), so the rendering of every id is pinned, including the unregistered holes and ids past the highest code.

module main

use host_intrinsics.stdio
use host_intrinsics.write

use compiler.diag.code.diag_code
use compiler.diag.format.DiagBuffer
use compiler.diag.format.diag_buf_init
use compiler.diag.format.diag_buf_free
use compiler.diag.format.diag_buf_as_str_view
use compiler.diag.format.diag_buf_push_byte
use compiler.diag.format.diag_buf_push_code_name
use compiler.diag.format.diag_buf_push_u32

pub fn main() -> i32 {
    let mut b = DiagBuffer { ptr: 0 as *mut u8, len: 0, cap: 0 }
    diag_buf_init(mut_view(b))
    let mut i: u32 = 0u32
    while i <= 300u32 {
        b.len = 0
        diag_buf_push_u32(mut_view(b), i)
        diag_buf_push_byte(mut_view(b), 32u8)
        diag_buf_push_code_name(mut_view(b), diag_code(i))
        diag_buf_push_byte(mut_view(b), 10u8)
        let sv = diag_buf_as_str_view(view(b))
        let _ = unsafe { write(stdio(1), sv.ptr, sv.len) }
        i = i + 1u32
    }
    diag_buf_free(mut_view(b))
    0
}
