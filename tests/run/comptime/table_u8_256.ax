// test: run
// exit: 126

const TABLE: [256]u8 = [42u8; 256];

fn main() -> i32 {
    let v0 = TABLE[0];
    let v128 = TABLE[128];
    let v255 = TABLE[255];
    if v0 != 42u8 { return 1; }
    if v128 != 42u8 { return 2; }
    if v255 != 42u8 { return 3; }
    return (v0 + v128 + v255) as i32;
}
