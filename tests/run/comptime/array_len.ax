// test: run
// exit: 53
const N: usize = 2 + 2;
const M: usize = N * 2;

fn main() -> i32 {
    let arr: [2 + 2]i32 = [1, 2, 3, 4];
    if arr[3] != 4 { return 1; }

    let rep: [N]i32 = [42; N];
    if rep[0] != 42 || rep[3] != 42 { return 2; }

    let rep2: [M]i32 = [7; M];
    if rep2[0] != 7 || rep2[7] != 7 { return 3; }

    return arr[3] + rep[0] + rep2[0];
}
