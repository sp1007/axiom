// test: run
const N: usize = 2 + 2;
const M: usize = N * 2;

fn main() {
    let arr: [2 + 2]i32 = [1, 2, 3, 4];
    if arr[3] != 4 { return; }

    let rep: [N]i32 = [42; N];
    if rep[0] != 42 || rep[3] != 42 { return; }

    let rep2: [M]i32 = [7; M];
    if rep2[0] != 7 || rep2[7] != 7 { return; }
}
