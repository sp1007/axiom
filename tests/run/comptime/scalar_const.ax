// test: run
const A: i32 = 10 + 20 * 2;
const B: i32 = (A - 10) / 4;
const C: bool = (A > 40) && (B == 10);
const D: u32 = (1u32 << 4) | 0x0Fu32;
const E: char = 'Z';

fn main() {
    if A != 50 { return; }
    if B != 10 { return; }
    if !C { return; }
    if D != 31u32 { return; }
    if E != 'Z' { return; }
}
