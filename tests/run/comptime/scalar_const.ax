// test: run
// exit: 91
const A: i32 = 10 + 20 * 2;
const B: i32 = (A - 10) / 4;
const C: bool = (A > 40) && (B == 10);
const D: u32 = (1u32 << 4) | 0x0Fu32;
const E: char = 'Z';

fn main() -> i32 {
    if A != 50 { return 1; }
    if B != 10 { return 2; }
    if !C { return 3; }
    if D != 31u32 { return 4; }
    if E != 'Z' { return 5; }
    return A + B + (D as i32);
}
