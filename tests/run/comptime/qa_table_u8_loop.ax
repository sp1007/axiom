// test: run
// exit: 42

const TABLE: [256]u8 = [42u8; 256];

fn main() -> i32 {
    let mut i: usize = 0;
    let mut count: usize = 0;
    loop {
        if i >= 256 { break; }
        if TABLE[i] != 42u8 { return 1; }
        count = count + 1;
        i = i + 1;
    }
    if count != 256 { return 2; }
    return TABLE[128] as i32;
}
