// test: run
// exit: 118

@derive(Copy)
struct Entry {
    name: Str,
    id: i32,
}

const TABLE: [3]Entry = [
    Entry { name: "apple", id: 101 },
    Entry { name: "banana", id: 202 },
    Entry { name: "cherry", id: 303 }
];

fn main() -> i32 {
    if len(TABLE[0].name) != 5 { return 1; }
    if TABLE[0].id != 101 { return 2; }
    if len(TABLE[1].name) != 6 { return 3; }
    if TABLE[1].id != 202 { return 4; }
    if len(TABLE[2].name) != 6 { return 5; }
    if TABLE[2].id != 303 { return 6; }
    return (len(TABLE[0].name) + len(TABLE[1].name) + len(TABLE[2].name)) as i32 + TABLE[0].id;
}
