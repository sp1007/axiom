// test: run
// native-after: T061d

@derive(Copy)
struct Entry {
    name: Str,
    id: i32,
}

const TABLE: [3]Entry = [
    Entry { name: "apple", id: 101 },
    Entry { name: "banana", id: 202 },
    Entry { name: "cherry", id: 303 }
];

fn main() {
    if len(TABLE[0].name) != 5 { return; }
    if TABLE[0].id != 101 { return; }
    if len(TABLE[1].name) != 6 { return; }
    if TABLE[1].id != 202 { return; }
    if len(TABLE[2].name) != 6 { return; }
    if TABLE[2].id != 303 { return; }
}
