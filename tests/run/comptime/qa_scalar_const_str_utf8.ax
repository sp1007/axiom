// test: run
// exit: 83
// stdout: Xin chào thế giới\n

const GREETING: Str = "Xin chào thế giới\n";

@derive(Copy)
struct Pair {
    a: i32,
    b: i32,
}

const PAIRS: [4]Pair = [
    Pair { a: 10, b: 5 },
    Pair { a: 12, b: 15 },
    Pair { a: 20, b: 8 },
    Pair { a: 14, b: 15 }
];

fn main() -> i32 {
    if len(GREETING) != 23 { return 1; }
    if PAIRS[0].a != 10 || PAIRS[0].b != 5 { return 2; }
    if PAIRS[1].a != 12 || PAIRS[1].b != 15 { return 3; }
    if PAIRS[2].a != 20 || PAIRS[2].b != 8 { return 4; }
    if PAIRS[3].a != 14 || PAIRS[3].b != 15 { return 5; }
    print(GREETING);
    return (len(GREETING) as i32) + PAIRS[0].a + PAIRS[1].b + PAIRS[2].a + PAIRS[3].b;
}
