// test: run
// native-after: T061d

@derive(Copy)
struct Point {
    x: i32,
    y: i32,
}

const POINTS: [3]Point = [
    Point { x: 10, y: 20 },
    Point { x: 30, y: 40 },
    Point { x: 50, y: 60 }
];

fn main() {
    let p0 = POINTS[0];
    let p1 = POINTS[1];
    let p2 = POINTS[2];
    if p0.x != 10 || p0.y != 20 { return; }
    if p1.x != 30 || p1.y != 40 { return; }
    if p2.x != 50 || p2.y != 60 { return; }
}
