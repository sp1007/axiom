// test: run
// exit: 210

@derive(Copy)
struct Point {
    x: i32,
    y: i32,
}

const POINTS: [3]Point = [
    Point { x: 10, y: 20 },
    Point { x: 30, y: 40 },
    Point { x: 50, y: 60 }
];

fn main() -> i32 {
    let p0 = POINTS[0];
    let p1 = POINTS[1];
    let p2 = POINTS[2];
    if p0.x != 10 || p0.y != 20 { return 1; }
    if p1.x != 30 || p1.y != 40 { return 2; }
    if p2.x != 50 || p2.y != 60 { return 3; }
    return p0.x + p0.y + p1.x + p1.y + p2.x + p2.y;
}
