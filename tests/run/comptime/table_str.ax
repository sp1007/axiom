// test: run
// exit: 10

const KEYWORDS: [3]Str = ["fn", "let", "const"];

fn main() -> i32 {
    if len(KEYWORDS[0]) != 2 { return 1; }
    if len(KEYWORDS[1]) != 3 { return 2; }
    if len(KEYWORDS[2]) != 5 { return 3; }
    return (len(KEYWORDS[0]) + len(KEYWORDS[1]) + len(KEYWORDS[2])) as i32;
}
