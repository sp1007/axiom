// test: run
// modes: interp native
// exit: 0
// stdout: GC_ROOTS_BANNER=Section_GC_Dead_Strip_And_Roots\nMMIO_GUARD_DROP=14\nGC_MMIO_VAL=28\nGC_EXPORT_ROOT=42\nGC_FFI_CALLBACK=21\nGC_TOTAL=91\n

struct MmioGuard {
    reg_val: i32,
}

impl Drop for MmioGuard {
    fn drop(self: mut_view<MmioGuard>) {
        print("MMIO_GUARD_DROP=");
        print_int(self.reg_val);
        print("\n");
    }
}

fn touch_mmio_guard(g: MmioGuard, log: mut_view<i32>) -> i32 {
    *log = *log + g.reg_val;
    g.reg_val
}

fn dead_unreachable_helper_a(x: i32) -> i32 {
    x * 999 + 12345
}

fn dead_unreachable_helper_b(x: i32) -> i32 {
    dead_unreachable_helper_a(x) - 777
}

pub fn exported_api_root(seed: i32) -> i32 {
    seed + 17
}

fn ffi_callback_root(delta: i32) -> i32 {
    delta * 3
}

fn invoke_callback(cb: fn(i32) -> i32, v: i32) -> i32 {
    cb(v)
}

fn main() -> i32 {
    print("GC_ROOTS_BANNER=Section_GC_Dead_Strip_And_Roots\n");

    let mut mmio_log: i32 = 0;
    let g = MmioGuard { reg_val: 14 };
    let v_mmio: i32 = touch_mmio_guard(g, mut_view(mmio_log)) + mmio_log;
    print("GC_MMIO_VAL=");
    print_int(v_mmio);
    print("\n");

    let v_exp: i32 = exported_api_root(25);
    print("GC_EXPORT_ROOT=");
    print_int(v_exp);
    print("\n");

    let v_cb: i32 = invoke_callback(ffi_callback_root, 7);
    print("GC_FFI_CALLBACK=");
    print_int(v_cb);
    print("\n");

    let total: i32 = v_mmio + v_exp + v_cb;
    print("GC_TOTAL=");
    print_int(total);
    print("\n");

    if total != 91 {
        return 1;
    }
    0
}
