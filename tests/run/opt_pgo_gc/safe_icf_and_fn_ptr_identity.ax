// test: run
// modes: interp native
// exit: 0
// stdout: ICF_BANNER=Safe_ICF_And_Fn_Ptr_Identity\nICF_DIRECT_PAIR=34\nICF_ADDR_TAKEN_PAIR=34\nICF_RO_CONST=22\nICF_TOTAL=90\n

fn icf_direct_alpha(x: i32, y: i32) -> i32 {
    let t: i32 = (x + y) * 2;
    t - 3
}

fn icf_direct_beta(x: i32, y: i32) -> i32 {
    let t: i32 = (x + y) * 2;
    t - 3
}

fn icf_addr_taken_one(v: i32) -> i32 {
    (v * 4) + 5
}

fn icf_addr_taken_two(v: i32) -> i32 {
    (v * 4) + 5
}

fn apply_fn_ptr_pair(fp1: fn(i32) -> i32, fp2: fn(i32) -> i32, arg: i32) -> i32 {
    fp1(arg) + fp2(arg)
}

fn ro_const_pool_probe() -> i32 {
    let a: [3]i32 = [3, 4, 4];
    let b: [3]i32 = [3, 4, 4];
    a[0] + a[1] + a[2] + b[0] + b[1] + b[2]
}

fn main() -> i32 {
    print("ICF_BANNER=Safe_ICF_And_Fn_Ptr_Identity\n");

    let v_dir: i32 = icf_direct_alpha(6, 4) + icf_direct_beta(6, 4);
    print("ICF_DIRECT_PAIR=");
    print_int(v_dir);
    print("\n");

    let fp1: fn(i32) -> i32 = icf_addr_taken_one;
    let fp2: fn(i32) -> i32 = icf_addr_taken_two;
    let v_addr: i32 = apply_fn_ptr_pair(fp1, fp2, 3);
    print("ICF_ADDR_TAKEN_PAIR=");
    print_int(v_addr);
    print("\n");

    let v_ro: i32 = ro_const_pool_probe();
    print("ICF_RO_CONST=");
    print_int(v_ro);
    print("\n");

    let total: i32 = v_dir + v_addr + v_ro;
    print("ICF_TOTAL=");
    print_int(total);
    print("\n");

    if total != 90 {
        return 1;
    }
    0
}
