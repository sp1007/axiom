// test: run
// modes: interp native
// exit: 0
// stdout: PGO_SAFETY_BANNER=PGO_Epistemic_Safety_Barriers\nPGO_CHECKED_ARR=30\nPGO_CONST_TIME=23\nPGO_BARRIER_SEQ=15\nPGO_SAFETY_TOTAL=68\n

fn constant_time_select(mask_all_ones: i32, a: i32, b: i32) -> i32 {
    (mask_all_ones & a) | ((0 - 1 - mask_all_ones) & b)
}

fn checked_array_probe(idx: usize) -> i32 {
    let arr: [4]i32 = [10, 20, 30, 40];
    if idx < 4 {
        arr[idx]
    } else {
        0
    }
}

fn ordered_barrier_steps(log: mut_view<i32>, trigger_cold: bool) -> i32 {
    *log = (*log * 3) + 2;
    if trigger_cold {
        *log = (*log * 2) + 5;
    } else {
        *log = (*log * 2) + 1;
    }
    *log
}

fn main() -> i32 {
    print("PGO_SAFETY_BANNER=PGO_Epistemic_Safety_Barriers\n");

    let v_arr: i32 = checked_array_probe(2);
    print("PGO_CHECKED_ARR=");
    print_int(v_arr);
    print("\n");

    let v_ct: i32 = constant_time_select(0 - 1, 23, 99);
    print("PGO_CONST_TIME=");
    print_int(v_ct);
    print("\n");

    let mut trace: i32 = 1;
    let v_ord: i32 = ordered_barrier_steps(mut_view(trace), false);
    let bonus: i32 = if trace == 11 { 4 } else { 0 };
    let v_seq: i32 = v_ord + bonus;
    print("PGO_BARRIER_SEQ=");
    print_int(v_seq);
    print("\n");

    let total: i32 = v_arr + v_ct + v_seq;
    print("PGO_SAFETY_TOTAL=");
    print_int(total);
    print("\n");

    if total != 68 {
        return 1;
    }
    0
}
