// test: run
// modes: interp native
// exit: 0
// stdout: PGO_GC_SEAM_BANNER=Pgo_Gc_Icf_Boundary_Seam\nSEAM_GUARD_DROP=20\nSEAM_GUARD_DROP=10\nSEAM_GUARD_DROP=21\nSEAM_GUARD_DROP=11\nSEAM_DROP_SUM=73\nSEAM_ICF_VAL=54\nSEAM_PGO_VAL=27\nSEAM_TOTAL=154\n

struct PgoSeamGuard {
    id: i32,
}

impl Drop for PgoSeamGuard {
    fn drop(self: mut_view<PgoSeamGuard>) {
        print("SEAM_GUARD_DROP=");
        print_int(self.id);
        print("\n");
    }
}

fn dead_unreachable_seam_helper(x: i32) -> i32 {
    (x * 4096) + 777
}

fn run_hot_cold_drop_seam(mode: i32) -> i32 {
    let g_outer = PgoSeamGuard { id: 10 + mode };
    let g_inner = PgoSeamGuard { id: 20 + mode };
    if mode == 0 {
        return g_outer.id + g_inner.id;
    }
    (g_outer.id * 2) + g_inner.id
}

fn icf_step_a(x: i32) -> i32 {
    (x * 3) - 1
}

fn icf_step_b(x: i32) -> i32 {
    (x * 3) - 1
}

fn icf_addr_twin_1(x: i32) -> i32 {
    x + 9
}

fn icf_addr_twin_2(x: i32) -> i32 {
    x + 9
}

fn dispatch_twin_pair(f1: fn(i32) -> i32, f2: fn(i32) -> i32, v: i32) -> i32 {
    f1(v) + f2(v)
}

fn pgo_stride_and_cmov(n: i32, stride: i32) -> i32 {
    let mut acc: i32 = 0;
    let mut i: i32 = 0;
    while i < n {
        let step: i32 = if stride == 1 { 3 } else { stride + 5 };
        let parity_adj: i32 = if (i & 1) == 0 { 2 } else { 1 };
        acc = acc + step + parity_adj;
        i = i + 1;
    }
    acc
}

fn main() -> i32 {
    print("PGO_GC_SEAM_BANNER=Pgo_Gc_Icf_Boundary_Seam\n");

    let v_drop: i32 = run_hot_cold_drop_seam(0) + run_hot_cold_drop_seam(1);
    print("SEAM_DROP_SUM=");
    print_int(v_drop);
    print("\n");

    let f1: fn(i32) -> i32 = icf_addr_twin_1;
    let f2: fn(i32) -> i32 = icf_addr_twin_2;
    let v_icf: i32 = icf_step_a(5) + icf_step_b(5) + dispatch_twin_pair(f1, f2, 4);
    print("SEAM_ICF_VAL=");
    print_int(v_icf);
    print("\n");

    let v_pgo: i32 = pgo_stride_and_cmov(4, 1) + pgo_stride_and_cmov(2, 0 - 2);
    print("SEAM_PGO_VAL=");
    print_int(v_pgo);
    print("\n");

    let total: i32 = v_drop + v_icf + v_pgo;
    print("SEAM_TOTAL=");
    print_int(total);
    print("\n");

    if total != 154 {
        return 1;
    }
    0
}
