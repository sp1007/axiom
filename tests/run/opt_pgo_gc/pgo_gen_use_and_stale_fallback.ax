// test: run
// modes: interp native
// exit: 0
// stdout: PGO_BANNER=PGO_Gen_Use_And_Stale_Fallback\nPGO_STRIDE_SPEC=25\nPGO_GUARDED_CALLS=57\nPGO_COLD_SPLIT=4\nPGO_TOTAL=86\n

fn hot_target_op(x: i32) -> i32 {
    x + 5
}

fn cold_target_op(x: i32) -> i32 {
    x + 19
}

fn dispatch_guarded_call(fp: fn(i32) -> i32, arg: i32) -> i32 {
    fp(arg)
}

fn step_with_stride(base: i32, stride: i32, steps: i32) -> i32 {
    let mut acc: i32 = base;
    let mut i: i32 = 0;
    while i < steps {
        if stride == 1 {
            acc = acc + 2;
        } else {
            acc = acc + stride;
        }
        i = i + 1;
    }
    acc
}

fn cold_diagnostic_branch(flag: i32) -> i32 {
    if flag < 0 {
        999
    } else {
        4
    }
}

fn main() -> i32 {
    print("PGO_BANNER=PGO_Gen_Use_And_Stale_Fallback\n");

    let v_stride: i32 = step_with_stride(0, 1, 8) + step_with_stride(0, 3, 3);
    print("PGO_STRIDE_SPEC=");
    print_int(v_stride);
    print("\n");

    let c1: i32 = dispatch_guarded_call(hot_target_op, 4);
    let c2: i32 = dispatch_guarded_call(hot_target_op, 4);
    let c3: i32 = dispatch_guarded_call(hot_target_op, 4);
    let c_rare: i32 = dispatch_guarded_call(cold_target_op, 11);
    let v_calls: i32 = c1 + c2 + c3 + c_rare;
    print("PGO_GUARDED_CALLS=");
    print_int(v_calls);
    print("\n");

    let v_split: i32 = cold_diagnostic_branch(1);
    print("PGO_COLD_SPLIT=");
    print_int(v_split);
    print("\n");

    let total: i32 = v_stride + v_calls + v_split;
    print("PGO_TOTAL=");
    print_int(total);
    print("\n");

    if total != 86 {
        return 1;
    }
    0
}
