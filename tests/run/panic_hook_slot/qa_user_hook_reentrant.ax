// test: run
// modes: native
// reason: direct FFI is native-only (ADR-0002)
// covers: REQ-TST-072
// stdout: first true\nhook 1 panic: index out of bounds\nhook 2 panic: division by zero\n
// exit: 101
// stderr-contains: panic: division by zero

// T538 QA: the hook slot without any std runtime. The linker stub passes the message (pointer, length) to
// the registered hook; a panic raised inside the hook re-enters the hook, the inner call returns, and the
// process exits with 101.

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

extern "C" { fn __ax_panic_hook_set(hook: usize) -> usize; }

@link("kernel32")
extern "system" {
    fn GetStdHandle(n: i32) -> *mut u8;
    fn WriteFile(h: *mut u8, p: *const u8, n: u32, w: *mut u32, o: *mut u8) -> i32;
}

static mut DEPTH: i64 = 0i64;

fn my_hook(msg: *const u8, n: usize) -> u32 {
    unsafe {
        DEPTH = DEPTH + 1i64;
        print("hook ");
        print_int(DEPTH);
        print(" ");
        // The message already ends with a line break.
        let w: [1]u32 = [0u32];
        WriteFile(GetStdHandle(-11), msg, n as u32, address_of(w[0]) as *mut u32, 0 as *mut u8);
        if DEPTH == 1i64 {
            let z: i64 = DEPTH - 1i64;
            print_int(10i64 / z);
        }
    }
    0u32
}

fn pick(a: [3]i32, i: usize) -> i32 {
    a[i]
}

pub fn main() -> i32 {
    let t: [1]fn(*const u8, usize) -> u32 = [my_hook];
    unsafe {
        let h = *(address_of(t[0]) as *const usize);
        let p = __ax_panic_hook_set(h);
        let q = __ax_panic_hook_set(h);
        if p == 0usize && q == h { print("first true\n"); } else { print("first false\n"); }
    }
    let a: [3]i32 = [1, 2, 3];
    let mut i: usize = 1usize;
    while i < 9usize { i = i + 2usize; }
    print_int(pick(a, i) as i64);
    print("not reached\n");
    0
}
