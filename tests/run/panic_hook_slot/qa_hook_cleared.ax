// test: run
// modes: native
// reason: direct FFI is native-only (ADR-0002)
// timeout: 60
// covers: REQ-TST-072
// stdout: contained\nprev set\nnow null\n
// exit: 101
// stderr-contains: panic: explicit panic

// T538 QA: with the hook cleared (slot 0) a spawned-thread panic is not contained any more and the process
// exits with 101, so containment really comes from the slot and from nothing else (no exit hook is left).

module main

use std.thread.spawn

@intrinsic fn panic(msg: str) {}

extern "C" { fn __ax_panic_hook_set(hook: usize) -> usize; }

pub fn main() -> i32 {
    let a = spawn(|| -> i64 { panic("first"); 1i64 });
    match a.join() {
        Result.Ok(_x) => { print("not contained\n"); },
        Result.Err(_e) => { print("contained\n"); },
    }
    let p = unsafe { __ax_panic_hook_set(0usize) };
    if p != 0usize { print("prev set\n"); }
    let q = unsafe { __ax_panic_hook_set(0usize) };
    if q == 0usize { print("now null\n"); }
    let b = spawn(|| -> i64 { panic("second"); 1i64 });
    match b.join() {
        Result.Ok(_x) => { print("ok\n"); },
        Result.Err(_e) => { print("err\n"); },
    }
    print("not reached\n");
    0
}
