// test: run
// modes: interp native
// timeout: 120
// covers: REQ-TST-072, REQ-CONC-219
// stdout: 2\npanicked\nthread err\nd err\n60\n
// exit: 101
// stderr-contains: panic: explicit panic

// T538 QA: live std, fibers and threads sharing the one process-wide hook. A thread spawned and joined
// inside a fiber panics, then the fiber itself panics; a thread spawned after the fiber hook replaced the
// thread hook still joins Err; four threads race fiber panics (20 each), one of them then panics outside
// any fiber; a final main-thread panic exits 101.

module main

use std.thread.spawn
use std.fiber.Fiber
use std.fiber.FiberState

@intrinsic fn panic(msg: str) {}

fn work() -> i64 {
    let mut caught: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i < 20i64 {
        let mut f: Fiber<(), i64> = Fiber.new(|| -> i64 { panic("race"); 1i64 });
        match f.resume() {
            FiberState.Yielded(_u) => {},
            FiberState.Completed(_r) => {},
            FiberState.Panicked => { caught = caught + 1i64; },
        }
        i = i + 1i64;
    }
    caught
}

pub fn main() -> i32 {
    let mut f: Fiber<(), i64> = Fiber.new(|| -> i64 {
        let t = spawn(|| -> i64 { panic("thread inside a fiber"); 1i64 });
        let r = match t.join() { Result.Ok(_x) => 1i64, Result.Err(_e) => 2i64 };
        print_int(r);
        print("\n");
        panic("fiber itself");
        r
    });
    match f.resume() {
        FiberState.Yielded(_u) => { print("yielded\n"); },
        FiberState.Completed(_r) => { print("completed\n"); },
        FiberState.Panicked => { print("panicked\n"); },
    }
    let s = spawn(|| -> i64 { panic("thread after the fiber hook"); 1i64 });
    match s.join() {
        Result.Ok(_x) => { print("thread ok\n"); },
        Result.Err(_e) => { print("thread err\n"); },
    }
    let a = spawn(|| -> i64 { work() });
    let b = spawn(|| -> i64 { work() });
    let c = spawn(|| -> i64 { work() });
    let d = spawn(|| -> i64 { let k = work(); panic("after the fibers"); k });
    let mut tot: i64 = 0i64;
    match a.join() { Result.Ok(x) => { tot = tot + x; }, Result.Err(_e) => { print("a err\n"); } }
    match b.join() { Result.Ok(x) => { tot = tot + x; }, Result.Err(_e) => { print("b err\n"); } }
    match c.join() { Result.Ok(x) => { tot = tot + x; }, Result.Err(_e) => { print("c err\n"); } }
    match d.join() { Result.Ok(x) => { tot = tot + x; }, Result.Err(_e) => { print("d err\n"); } }
    print_int(tot);
    print("\n");
    panic("main end");
    0
}
