// test: run
// modes: interp native
// covers: REQ-TST-072
// stdout: before\n
// exit: 101
// stderr-contains: panic: explicit panic

// T538: no fiber or thread, so no panic hook is registered: `axiom_panic` reads the read-only zero slot,
// writes the message and exits with 101 exactly as before.

module main

@intrinsic fn panic(msg: str) {}

fn depth(n: i32) -> i32 {
    if n == 0 {
        panic("no_hook_panic boom");
    }
    depth(n - 1) + 1
}

pub fn main() -> i32 {
    print("before\n");
    let r = depth(3);
    print("after ");
    print_int(r as i64);
    print("\n");
    0
}
