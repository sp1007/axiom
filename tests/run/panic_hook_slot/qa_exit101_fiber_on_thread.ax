// test: run
// modes: native
// reason: direct FFI is native-only (ADR-0002)
// timeout: 60
// covers: REQ-TST-072
// stdout: panicked\nin fiber\n
// exit: 101
// stderr-contains: panic: explicit panic

// T538 QA: live std, a fiber on a spawned thread. Its panic is contained; a user ExitProcess(101) in the
// next fiber of the same thread is contained neither by the fiber layer nor by the thread layer
// (the pre-T538 compiler contained it and the program exited 0).

module main

use std.thread.spawn
use std.fiber.Fiber
use std.fiber.FiberState

@intrinsic fn panic(msg: str) {}

@link("kernel32")
extern "system" {
    fn ExitProcess(uExitCode: u32);
}

pub fn main() -> i32 {
    let t = spawn(|| -> i64 {
        let mut f: Fiber<(), i64> = Fiber.new(|| -> i64 { panic("x"); 1i64 });
        match f.resume() {
            FiberState.Yielded(_u) => { print("yielded\n"); },
            FiberState.Completed(_r) => { print("completed\n"); },
            FiberState.Panicked => { print("panicked\n"); },
        }
        let mut g: Fiber<(), i64> = Fiber.new(|| -> i64 {
            print("in fiber\n");
            unsafe { ExitProcess(101u32); }
            1i64
        });
        match g.resume() {
            FiberState.Yielded(_u) => { print("yielded\n"); },
            FiberState.Completed(_r) => { print("completed\n"); },
            FiberState.Panicked => { print("contained\n"); },
        }
        1i64
    });
    match t.join() {
        Result.Ok(_x) => { print("ok\n"); },
        Result.Err(_e) => { print("err\n"); },
    }
    print("not reached\n");
    0
}
