// test: run
// modes: interp native
// timeout: 60
// covers: REQ-TST-072
// stdout: thr1 err\nfib1 panicked\nthr2 err\nfiber exit 101\n
// exit: 101

// T538 QA: dual-mode (`interp` + `native`) proof that `host.exit(101)` (`ExitProcess(101)` natively)
// inside a fiber after both thread and fiber panics have been contained terminates the process
// with exit code 101 instead of being mistaken for a fiber panic (`FiberState.Panicked`).

module main

use std.thread.spawn
use std.fiber.Fiber
use std.fiber.FiberState
use std.core.host.exit

@intrinsic fn panic(msg: str) {}

pub fn main() -> i32 {
    let t1 = spawn(|| -> i64 { panic("t1 boom"); 1i64 });
    match t1.join() {
        Result.Ok(_x) => { print("thr1 ok\n"); },
        Result.Err(_e) => { print("thr1 err\n"); },
    }
    let mut f1: Fiber<(), i64> = Fiber.new(|| -> i64 { panic("f1 boom"); 1i64 });
    match f1.resume() {
        FiberState.Yielded(_u) => { print("fib1 yielded\n"); },
        FiberState.Completed(_r) => { print("fib1 completed\n"); },
        FiberState.Panicked => { print("fib1 panicked\n"); },
    }
    let t2 = spawn(|| -> i64 { panic("t2 boom"); 1i64 });
    match t2.join() {
        Result.Ok(_x) => { print("thr2 ok\n"); },
        Result.Err(_e) => { print("thr2 err\n"); },
    }
    let mut f2: Fiber<(), i64> = Fiber.new(|| -> i64 {
        print("fiber exit 101\n");
        exit(101);
        1i64
    });
    match f2.resume() {
        FiberState.Yielded(_u) => { print("fib2 yielded\n"); },
        FiberState.Completed(_r) => { print("fib2 completed\n"); },
        FiberState.Panicked => { print("fib2 contained\n"); },
    }
    print("not reached\n");
    0
}
