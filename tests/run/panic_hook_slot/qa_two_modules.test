# T538 QA: one hook slot per module (EXE + Axiom DLL) and the Win64 contract of the hook call.
skip-unless: tool gcc
skip-unless: tool objdump
nocache: reads repo std/ tree and invokes host gcc/objdump on temporary PE/COFF artifacts
cmd: python {test_dir}/qa_two_modules_oracle.py {compiler} {tmp} {root}
exit: 0
timeout: 300
stdout: PANIC-HOOK-MODULES-OK\n
