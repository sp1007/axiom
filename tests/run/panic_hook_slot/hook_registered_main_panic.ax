// test: run
// modes: interp native
// timeout: 60
// covers: REQ-TST-072
// stdout: joined -1 9\n
// exit: 101
// stderr-contains: panic: explicit panic

// T538: spawning threads registers the thread runtime's panic hook (native). A spawned-thread panic is
// contained (join Err); a panic on the main thread runs the hook, which returns, and `axiom_panic`
// still ends the process with exit code 101 after writing the message.

module main

use std.thread.spawn

@intrinsic fn panic(msg: str) {}

pub fn main() -> i32 {
    let a = spawn(|| -> i64 {
        panic("hook_registered_main_panic worker");
        1i64
    });
    let av = match a.join() {
        Result.Ok(x) => x,
        Result.Err(_e) => -1i64,
    };
    let g = spawn(|| -> i64 { 9i64 });
    let gv = match g.join() {
        Result.Ok(x) => x,
        Result.Err(_e) => -2i64,
    };
    print("joined ");
    print_int(av);
    print(" ");
    print_int(gv);
    print("\n");
    panic("hook_registered_main_panic main");
    0
}
