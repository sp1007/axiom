// test: run
// modes: interp native
// stdout: STAGE_1=10\nSTAGE_2=35\nSTAGE_3=77\nFINAL=122\n

struct Acc {
    a: i32,
    b: i32,
}

fn pure_fold_helper(x: i32, y: i32) -> i32 {
    let c1: i32 = 6 + 4;
    let c2: i32 = (x + 0) * 1;
    let c3: i32 = (y - 0) ^ 0;
    c1 + c2 + c3
}

fn guarded_div_helper(num: i32, den: i32) -> i32 {
    if den != 0 {
        return num / den;
    }
    0
}

fn read_shared_view(v: view<Acc>) -> i32 {
    v.a + v.b
}

fn update_mut_view(m: mut_view<Acc>, delta: i32) {
    m.a = m.a + delta;
    m.b = m.b + (delta * 2);
}

fn io_stage_one(v: i32) -> i32 {
    print("STAGE_1=");
    print_int(v);
    print("\n");
    v
}

fn io_stage_two(v: i32) -> i32 {
    print("STAGE_2=");
    print_int(v);
    print("\n");
    v
}

fn io_stage_three(v: i32) -> i32 {
    print("STAGE_3=");
    print_int(v);
    print("\n");
    v
}

fn main() -> i32 {
    let mut acc = Acc { a: 3, b: 7 };
    let init_sum = read_shared_view(view(acc));
    let s1 = io_stage_one(init_sum);

    update_mut_view(mut_view(acc), 5);
    let after_mut = read_shared_view(view(acc));
    let folded = pure_fold_helper(after_mut, 0);
    let s2 = io_stage_two(folded);

    let mut loop_acc: i32 = 0;
    let mut i: i32 = 1;
    while i <= 6 {
        loop_acc = loop_acc + guarded_div_helper(i * 22, 2);
        i = i + 1;
    }
    let s3_in = loop_acc / 3;
    let s3 = io_stage_three(s3_in);

    // Dead pure computation must not disturb I/O ordering or final result
    let dead_pure = pure_fold_helper(s1, s2);
    let _ = dead_pure;

    let total = s1 + s2 + s3;
    print("FINAL=");
    print_int(total);
    print("\n");

    if total != 122 {
        return 1;
    }
    0
}
