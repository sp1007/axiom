// test: run
// modes: interp native
// stdout: ENTER=25\nDROP=3\nDROP=2\nMID=40\nDROP=1\nDONE=40\n

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

struct ScopeGuard {
    tag: i32,
}

impl Drop for ScopeGuard {
    fn drop(self: mut_view<ScopeGuard>) {
        print("DROP=");
        print_int(self.tag);
        print("\n");
    }
}

fn run_drop_and_raw_ptr() -> i32 {
    let g1 = ScopeGuard { tag: 1 };
    let mut slot: i32 = 10;
    let p: *mut i32 = unsafe { address_of_mut(slot) };
    unsafe {
        *p = *p + 15;
    }
    print("ENTER=");
    print_int(slot);
    print("\n");
    {
        let g2 = ScopeGuard { tag: 2 };
        let g3 = ScopeGuard { tag: 3 };
        unsafe {
            *p = *p + 15;
        }
        let _ = g2.tag + g3.tag;
    }
    let dead_pure: i32 = (slot + 0) * 1;
    let _ = dead_pure;
    print("MID=");
    print_int(slot);
    print("\n");
    let _ = g1.tag;
    slot
}

fn main() -> i32 {
    let res = run_drop_and_raw_ptr();
    print("DONE=");
    print_int(res);
    print("\n");
    if res != 40 {
        return 1;
    }
    0
}
