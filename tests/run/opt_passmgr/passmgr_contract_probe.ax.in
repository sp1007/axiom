@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

@PROBE_MIR_FN@

fn probe_mir_blob(arena: mut_view<Arena>, idx: usize) -> StrView {
    let s: str = probe_mir_raw(idx);
    let raw_sv: StrView = unsafe { *(address_of(s) as *const StrView) };
    let bytes: view<[u8]> = unsafe { *(address_of(s) as *const view<[u8]>) };
    let n = raw_sv.len;
    let dst = arena_alloc_raw(mut_view(*arena), n + 1, 1);
    let mut i: usize = 0;
    while i < n {
        unsafe {
            *(dst + i) = bytes[i];
        }
        i = i + 1;
    }
    unsafe {
        *(dst + n) = 0u8;
    }
    StrView { ptr: dst as *const u8, len: n }
}

fn verify_effects_and_call_graph(arena: mut_view<Arena>) -> i32 {
    if !effect_is_pure(EFFECT_PURE) || effect_is_pure(EFFECT_UNKNOWN) || effect_is_pure(EFFECT_READS_MEM) {
        return 11;
    }
    if effect_pure_certainty(EFFECT_PURE) != CERTAINTY_PROVEN ||
       effect_pure_certainty(EFFECT_UNKNOWN) != CERTAINTY_UNKNOWN ||
       effect_pure_certainty(EFFECT_ATOMIC) != CERTAINTY_UNKNOWN {
        return 12;
    }
    if effect_for_call_kind(CALL_KIND_PURE_INTRINSIC) != EFFECT_PURE ||
       (effect_for_call_kind(CALL_KIND_HOST_IO) & (EFFECT_IO | EFFECT_MAY_PANIC)) != (EFFECT_IO | EFFECT_MAY_PANIC) ||
       (effect_for_call_kind(CALL_KIND_VOLATILE_INTRINSIC) & EFFECT_VOLATILE) == 0u16 ||
       (effect_for_call_kind(CALL_KIND_ATOMIC_INTRINSIC) & EFFECT_ATOMIC) == 0u16 ||
       (effect_for_call_kind(CALL_KIND_INDIRECT_UNKNOWN) & EFFECT_UNKNOWN) == 0u16 {
        return 13;
    }
    if !effect_can_dce(EFFECT_PURE) || !effect_can_dce(EFFECT_READS_MEM) ||
       effect_can_dce(EFFECT_IO) || effect_can_dce(EFFECT_ATOMIC) ||
       effect_can_dce(EFFECT_VOLATILE) || effect_can_dce(EFFECT_MAY_PANIC) ||
       effect_can_dce(EFFECT_UNKNOWN) {
        return 14;
    }
    if effect_can_reorder(EFFECT_IO, EFFECT_ATOMIC, ALIAS_NO_ALIAS) ||
       effect_can_reorder(EFFECT_ATOMIC, EFFECT_VOLATILE, ALIAS_NO_ALIAS) ||
       effect_can_reorder(EFFECT_ATOMIC, EFFECT_READS_MEM, ALIAS_NO_ALIAS) ||
       effect_can_reorder(EFFECT_MAY_PANIC, EFFECT_WRITES_MEM, ALIAS_NO_ALIAS) ||
       !effect_can_reorder(EFFECT_WRITES_MEM, EFFECT_READS_MEM, ALIAS_NO_ALIAS) ||
       effect_can_reorder(EFFECT_WRITES_MEM, EFFECT_READS_MEM, ALIAS_MAY_ALIAS) {
        return 15;
    }
    let io_sum = effect_summary_from_flags(SymbolId { v: 1u32 }, EFFECT_IO);
    let alloc_sum = effect_summary_from_flags(SymbolId { v: 2u32 }, EFFECT_ALLOCATES);
    if !effect_verify_execution_domain(view(io_sum), EXEC_DOMAIN_HOST) ||
       effect_verify_execution_domain(view(io_sum), EXEC_DOMAIN_COMPTIME) ||
       effect_verify_execution_domain(view(io_sum), EXEC_DOMAIN_KERNEL) ||
       !effect_verify_execution_domain(view(alloc_sum), EXEC_DOMAIN_COMPTIME) ||
       effect_verify_execution_domain(view(alloc_sum), EXEC_DOMAIN_KERNEL) {
        return 16;
    }

    // 80-node (>64) call graph preserving I/O, atomic, volatile, MayPanic & incremental SCC update
    let cg = arena_alloc_raw(mut_view(*arena), size_of<EffectCallGraph>(), align_of<EffectCallGraph>()) as *mut EffectCallGraph;
    effect_call_graph_init(unsafe { mut_view(*cg) }, mut_view(*arena), 80, 32);
    let mut k: usize = 0;
    while k < 80 {
        let loc_eff: u16 = if k == 71 {
            EFFECT_IO | EFFECT_MAY_PANIC
        } else if k == 73 {
            EFFECT_VOLATILE
        } else {
            EFFECT_PURE
        };
        let added = effect_call_graph_add_node(unsafe { mut_view(*cg) }, SymbolId { v: (200 + k) as u32 }, loc_eff, false);
        if added != (k as u32) {
            return 17;
        }
        k = k + 1;
    }
    // 0 -> 70 <-> 71 (mutual recursion above 64), 1 -> 72 -> 72 (self recursion), 2 -> 73 (volatile), 75 pure
    effect_call_graph_add_edge(unsafe { mut_view(*cg) }, 0u32, 70u32);
    effect_call_graph_add_edge(unsafe { mut_view(*cg) }, 70u32, 71u32);
    effect_call_graph_add_edge(unsafe { mut_view(*cg) }, 71u32, 70u32);
    effect_call_graph_add_edge(unsafe { mut_view(*cg) }, 1u32, 72u32);
    effect_call_graph_add_edge(unsafe { mut_view(*cg) }, 72u32, 72u32);
    effect_call_graph_add_edge(unsafe { mut_view(*cg) }, 2u32, 73u32);
    if effect_call_graph_propagate(unsafe { mut_view(*cg) }) == 0u32 {
        return 18;
    }
    let s0 = effect_call_graph_node_summary(unsafe { view(*cg) }, 0u32);
    let s1 = effect_call_graph_node_summary(unsafe { view(*cg) }, 1u32);
    let s2 = effect_call_graph_node_summary(unsafe { view(*cg) }, 2u32);
    let s75 = effect_call_graph_node_summary(unsafe { view(*cg) }, 75u32);
    if (s0.flags & (EFFECT_IO | EFFECT_MAY_PANIC | EFFECT_NONTERM)) != (EFFECT_IO | EFFECT_MAY_PANIC | EFFECT_NONTERM) ||
       (s1.flags & EFFECT_NONTERM) == 0u16 ||
       (s2.flags & EFFECT_VOLATILE) == 0u16 ||
       s75.flags != EFFECT_PURE {
        return 19;
    }
    // Summary-preserving update inside recursive SCC above 64 -> 0 caller re-evaluations
    if effect_call_graph_update_node_local(unsafe { mut_view(*cg) }, 70u32, EFFECT_IO, false) != 0u32 {
        return 20;
    }
    // Summary-changing update adding EFFECT_ATOMIC to node 71 -> propagates to {70, 71, 0} (3 nodes)
    let reeval = effect_call_graph_update_node_local(unsafe { mut_view(*cg) }, 71u32, EFFECT_IO | EFFECT_MAY_PANIC | EFFECT_ATOMIC, false);
    let s0_after = effect_call_graph_node_summary(unsafe { view(*cg) }, 0u32);
    let s2_after = effect_call_graph_node_summary(unsafe { view(*cg) }, 2u32);
    if reeval != 3u32 ||
       (s0_after.flags & EFFECT_ATOMIC) == 0u16 ||
       (s2_after.flags & EFFECT_ATOMIC) != 0u16 {
        return 21;
    }
    arena_reset(mut_view(*arena));
    0
}

fn verify_passmgr_caching_contracts_and_passes(arena: mut_view<Arena>, sink: mut_view<DiagSink>) -> i32 {
    if EFFECT_MASK_NON_STORE_OBSERVABLE != 1020u16 ||
       EFFECT_MASK_CONSERVATIVE_CALL == EFFECT_PURE {
        return 30;
    }
    let c_sccp = passmgr_contract_for_pass(PASS_SCCP);
    let c_ic = passmgr_contract_for_pass(PASS_INST_COMBINE);
    let c_sroa = passmgr_contract_for_pass(PASS_SROA);
    let c_dce = passmgr_contract_for_pass(PASS_DCE);
    let c_cfg = passmgr_contract_for_pass(PASS_CFG_SIMPLIFY);
    if c_sccp.required_analyses != (ANALYSIS_MASK_CFG | ANALYSIS_MASK_DOMINATORS | ANALYSIS_MASK_SSA | ANALYSIS_MASK_EFFECT_INFO | ANALYSIS_MASK_RANGE_INFO) ||
       c_ic.required_analyses != (ANALYSIS_MASK_CFG | ANALYSIS_MASK_SSA | ANALYSIS_MASK_EFFECT_INFO | ANALYSIS_MASK_RANGE_INFO) ||
       c_sroa.invalidated_analyses != (ANALYSIS_MASK_SSA | ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_ALIAS_INFO | ANALYSIS_MASK_RANGE_INFO) ||
       c_dce.required_analyses != (ANALYSIS_MASK_CFG | ANALYSIS_MASK_SSA | ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_EFFECT_INFO | ANALYSIS_MASK_ESCAPE_INFO) ||
       c_cfg.required_analyses != (ANALYSIS_MASK_CFG | ANALYSIS_MASK_SSA | ANALYSIS_MASK_EFFECT_INFO) {
        return 31;
    }

    let thir_ptr = arena_alloc_raw(mut_view(*arena), size_of<Thir>(), align_of<Thir>()) as *mut Thir;
    opt_init_minimal_thir(thir_ptr, mut_view(*arena));

    // Blob 0 (diamond + loop + sroa + memphi): caching, transitive invalidation, candidate verifier, rollback, -O0/-O1/-O2
    let in0 = probe_mir_blob(mut_view(*arena), 0);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m0 = verify_parse_mir(in0, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m0 as usize) == 0 {
        opt_free_minimal_thir(thir_ptr);
        return 32;
    }
    let obody = optir_build_from_mir(unsafe { view(*m0) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (obody as usize) == 0 || sink.errors != 0 {
        opt_free_minimal_thir(thir_ptr);
        return 33;
    }
    let loc2_place = mir_local_place(2u32);
    let reg_loc2 = optir_extract_memory_region(unsafe { view(*obody) }, view(loc2_place));
    if reg_loc2.domain != STORAGE_STACK_LOCAL ||
       effect_call_clobbers_region(EFFECT_WRITES_MEM | EFFECT_UNKNOWN, view(reg_loc2), false) ||
       !effect_call_clobbers_region(EFFECT_WRITES_MEM | EFFECT_UNKNOWN, view(reg_loc2), true) {
        opt_free_minimal_thir(thir_ptr);
        return 34;
    }

    let pm_ptr = arena_alloc_raw(mut_view(*arena), size_of<PassManager>(), align_of<PassManager>()) as *mut PassManager;
    let budget_o0 = opt_budget_for_profile(OPT_PROFILE_DEBUG_O0, true);
    let budget_o1 = opt_budget_for_profile(OPT_PROFILE_BALANCED_O1, true);
    let budget_o2 = opt_budget_for_profile(OPT_PROFILE_SPEED_O2, true);
    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget_o2, mut_view(*arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*obody) }, mut_view(*arena));

    // Cache hit without recomputation
    passmgr_ensure_analyses(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*obody) }, mut_view(*arena), ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_RANGE_INFO);
    if passmgr_get_analysis_compute_count(unsafe { view(*pm_ptr) }, ANALYSIS_MEMORY_SSA) != 1u32 ||
       passmgr_get_analysis_compute_count(unsafe { view(*pm_ptr) }, ANALYSIS_RANGE_INFO) != 1u32 {
        opt_free_minimal_thir(thir_ptr);
        return 35;
    }
    // Transitive SSA invalidation preserves CFG/Dom/LoopInfo while invalidating SSA/MemSSA/Effect/Alias/Escape/Range
    passmgr_invalidate_analyses(unsafe { mut_view(*pm_ptr) }, ANALYSIS_MASK_SSA);
    if !passmgr_is_analysis_valid(unsafe { view(*pm_ptr) }, ANALYSIS_CFG) ||
       !passmgr_is_analysis_valid(unsafe { view(*pm_ptr) }, ANALYSIS_DOMINATORS) ||
       !passmgr_is_analysis_valid(unsafe { view(*pm_ptr) }, ANALYSIS_LOOP_INFO) ||
       passmgr_is_analysis_valid(unsafe { view(*pm_ptr) }, ANALYSIS_MEMORY_SSA) ||
       passmgr_is_analysis_valid(unsafe { view(*pm_ptr) }, ANALYSIS_EFFECT_INFO) ||
       passmgr_is_analysis_valid(unsafe { view(*pm_ptr) }, ANALYSIS_RANGE_INFO) ||
       passmgr_get_analysis_invalidation_count(unsafe { view(*pm_ptr) }, ANALYSIS_MEMORY_SSA) != 1u32 {
        opt_free_minimal_thir(thir_ptr);
        return 36;
    }
    passmgr_ensure_analyses(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*obody) }, mut_view(*arena), ANALYSIS_MASK_MEMORY_SSA | ANALYSIS_MASK_RANGE_INFO);
    if passmgr_get_analysis_compute_count(unsafe { view(*pm_ptr) }, ANALYSIS_CFG) != 1u32 ||
       passmgr_get_analysis_compute_count(unsafe { view(*pm_ptr) }, ANALYSIS_MEMORY_SSA) != 2u32 {
        opt_free_minimal_thir(thir_ptr);
        return 37;
    }

    // Two-stage candidate legality & proof verifier
    let cur_rev = unsafe { (*pm_ptr).ir_revision };
    let cand_ok = CandidateRewrite {
        pass_id: PASS_SCCP,
        required_prop: PROP_NO_OVERFLOW,
        proof_certainty: CERTAINTY_PROVEN,
        proof_source_analysis: ANALYSIS_RANGE_INFO,
        proof_revision: cur_rev,
        target_effect_flags: EFFECT_PURE,
        src_view_kind: MIR_VIEW_READ,
        dst_view_kind: MIR_VIEW_READ,
        is_removing_inst: false,
        cost_delta: -5i32,
    };
    let mut cand_poss = cand_ok;
    cand_poss.proof_certainty = CERTAINTY_POSSIBLE;
    cand_poss.cost_delta = -100i32;
    let mut cand_unk = cand_ok;
    cand_unk.proof_certainty = CERTAINTY_UNKNOWN;
    let mut cand_stale = cand_ok;
    cand_stale.proof_revision = cur_rev + 7u32;
    let mut cand_cap = cand_ok;
    cand_cap.src_view_kind = MIR_VIEW_READ;
    cand_cap.dst_view_kind = MIR_VIEW_MUT;
    let mut cand_rm_ato = cand_ok;
    cand_rm_ato.is_removing_inst = true;
    cand_rm_ato.target_effect_flags = EFFECT_ATOMIC;
    let mut cand_rm_io = cand_ok;
    cand_rm_io.is_removing_inst = true;
    cand_rm_io.target_effect_flags = EFFECT_IO;
    let mut cand_cost = cand_ok;
    cand_cost.cost_delta = 5i32;

    if passmgr_evaluate_candidate(unsafe { view(*pm_ptr) }, view(cand_ok)) != CONTRACT_OK ||
       passmgr_evaluate_candidate(unsafe { view(*pm_ptr) }, view(cand_poss)) != CONTRACT_ERR_NON_PROVEN_CERTAINTY ||
       passmgr_evaluate_candidate(unsafe { view(*pm_ptr) }, view(cand_unk)) != CONTRACT_ERR_NON_PROVEN_CERTAINTY ||
       passmgr_evaluate_candidate(unsafe { view(*pm_ptr) }, view(cand_stale)) != CONTRACT_ERR_STALE_PROOF_REVISION ||
       passmgr_evaluate_candidate(unsafe { view(*pm_ptr) }, view(cand_cap)) != CONTRACT_ERR_CAPABILITY_PROMOTION ||
       passmgr_evaluate_candidate(unsafe { view(*pm_ptr) }, view(cand_rm_ato)) != CONTRACT_ERR_OBSERVABLE_EFFECT_LOSS ||
       passmgr_evaluate_candidate(unsafe { view(*pm_ptr) }, view(cand_rm_io)) != CONTRACT_ERR_OBSERVABLE_EFFECT_LOSS ||
       passmgr_evaluate_candidate(unsafe { view(*pm_ptr) }, view(cand_cost)) != CONTRACT_ERR_COST_UNPROFITABLE {
        opt_free_minimal_thir(thir_ptr);
        return 38;
    }
    passmgr_invalidate_analyses(unsafe { mut_view(*pm_ptr) }, ANALYSIS_MASK_EFFECT_INFO);
    if passmgr_evaluate_candidate(unsafe { view(*pm_ptr) }, view(cand_ok)) != CONTRACT_ERR_MISSING_ANALYSIS {
        opt_free_minimal_thir(thir_ptr);
        return 39;
    }
    passmgr_ensure_analyses(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*obody) }, mut_view(*arena), ANALYSIS_MASK_EFFECT_INFO);

    // Fault injection & automatic snapshot rollback: IDOM, VOLATILE, ATOMIC, and VIEW->MUT capability promotion
    if passmgr_inject_fault_and_verify(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*obody) }, PASS_SCCP, FAULT_CORRUPT_IDOM, mut_view(*arena), mut_view(*sink)) != CONTRACT_ERR_POSTCOND_CFG_DOM ||
       passmgr_get_pass_rollback_count(unsafe { view(*pm_ptr) }, PASS_SCCP) != 1u32 ||
       !optir_verify_contract(unsafe { view(*obody) }) {
        opt_free_minimal_thir(thir_ptr);
        return 40;
    }
    let bb0_p = unsafe { opt_block_at((*obody).blocks, 0) };
    let inst0_p = unsafe { opt_inst_at((*bb0_p).insts, 0) };
    let saved_opc = unsafe { (*inst0_p).opcode };

    unsafe {
        (*inst0_p).opcode = OPT_INST_VOLATILE_STORE;
        (*pm_ptr).has_baseline_effects = false;
    }
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*obody) }, mut_view(*arena));
    if passmgr_inject_fault_and_verify(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*obody) }, PASS_DCE, FAULT_DROP_VOLATILE_INST, mut_view(*arena), mut_view(*sink)) != CONTRACT_ERR_POSTCOND_EFFECTS ||
       (unsafe { (*inst0_p).opcode }) != OPT_INST_VOLATILE_STORE {
        unsafe { (*inst0_p).opcode = saved_opc; }
        opt_free_minimal_thir(thir_ptr);
        return 41;
    }

    unsafe {
        (*inst0_p).opcode = OPT_INST_ATOMIC;
        (*pm_ptr).has_baseline_effects = false;
    }
    let ato_ieff = effect_infer_inst(unsafe { view(*obody) }, unsafe { view(*inst0_p) }, 64u32);
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*obody) }, mut_view(*arena));
    if (ato_ieff & EFFECT_ATOMIC) == 0u16 ||
       (unsafe { (*pm_ptr).baseline_effect_summary.atomic_count }) == 0u32 ||
       passmgr_inject_fault_and_verify(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*obody) }, PASS_DCE, FAULT_DROP_ATOMIC_INST, mut_view(*arena), mut_view(*sink)) != CONTRACT_ERR_POSTCOND_EFFECTS ||
       (unsafe { (*inst0_p).opcode }) != OPT_INST_ATOMIC {
        unsafe { (*inst0_p).opcode = saved_opc; }
        opt_free_minimal_thir(thir_ptr);
        return 42;
    }
    unsafe {
        (*inst0_p).opcode = saved_opc;
        (*pm_ptr).has_baseline_effects = false;
    }

    let view_ty_ptr = arena_alloc_raw(mut_view(*arena), size_of<AxType>(), align_of<AxType>()) as *mut AxType;
    let slot16 = (((unsafe { (*thir_ptr).interner.types }) as usize) + 16 * size_of<*mut AxType>()) as *mut *mut AxType;
    let inst6_p = unsafe { opt_inst_at((*bb0_p).insts, 6) };
    let saved_ty7 = unsafe { *opt_typeid_at((*obody).local_tys, 7) };
    let saved_len = unsafe { (*thir_ptr).interner.len };
    unsafe {
        ax_type_reset(mut_view(*view_ty_ptr), TY_VIEW);
        *slot16 = view_ty_ptr;
        (*thir_ptr).interner.len = 17;
        *opt_typeid_at((*obody).local_tys, 7) = TypeId { v: 17u32 };
    }
    let st_cap = passmgr_inject_fault_and_verify(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*obody) }, PASS_INST_COMBINE, FAULT_PROMOTE_VIEW_TO_MUT, mut_view(*arena), mut_view(*sink));
    let restored_vk = unsafe { (*inst6_p).place.view_kind };
    unsafe {
        *opt_typeid_at((*obody).local_tys, 7) = saved_ty7;
        (*thir_ptr).interner.len = saved_len;
    }
    if st_cap != CONTRACT_ERR_CAPABILITY_PROMOTION || restored_vk == MIR_VIEW_MUT {
        opt_free_minimal_thir(thir_ptr);
        return 43;
    }

    // Pipeline execution across OPT_PROFILE_DEBUG_O0, OPT_PROFILE_BALANCED_O1, OPT_PROFILE_SPEED_O2
    let facts = passmgr_collect_body_facts(unsafe { view(*obody) });
    if passmgr_should_schedule_pass(PASS_SCCP, view(budget_o0), view(facts)) ||
       !passmgr_should_schedule_pass(PASS_SCCP, view(budget_o1), view(facts)) ||
       !passmgr_should_schedule_pass(PASS_SCCP, view(budget_o2), view(facts)) {
        opt_free_minimal_thir(thir_ptr);
        return 44;
    }
    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget_o0, mut_view(*arena));
    if !passmgr_run_pipeline(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*obody) }, mut_view(*arena), mut_view(*sink)) ||
       (unsafe { (*pm_ptr).fixedpoint_rounds_executed }) != 0u32 {
        opt_free_minimal_thir(thir_ptr);
        return 45;
    }
    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget_o1, mut_view(*arena));
    if !passmgr_run_pipeline(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*obody) }, mut_view(*arena), mut_view(*sink)) ||
       (unsafe { (*pm_ptr).fixedpoint_rounds_executed }) == 0u32 ||
       (unsafe { (*pm_ptr).verify_fail_count }) != 0u32 {
        opt_free_minimal_thir(thir_ptr);
        return 46;
    }
    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget_o2, mut_view(*arena));
    if !passmgr_run_pipeline(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*obody) }, mut_view(*arena), mut_view(*sink)) ||
       (unsafe { (*pm_ptr).verify_fail_count }) != 0u32 {
        opt_free_minimal_thir(thir_ptr);
        return 47;
    }

    // Blob 1 (GVN/CSE local clobber safety), Blob 2 & 3 (BRANCH & SWITCH_INT loop backedges), Blob 4 (SCCP bool + DCE), Blob 5 (stale RangeInfo)
    let in1 = probe_mir_blob(mut_view(*arena), 1);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m1 = verify_parse_mir(in1, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m1 as usize) == 0 {
        opt_free_minimal_thir(thir_ptr);
        return 61;
    }
    let o1 = optir_build_from_mir(unsafe { view(*m1) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o1 as usize) == 0 || sink.errors != 0 {
        opt_free_minimal_thir(thir_ptr);
        return 62;
    }
    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget_o2, mut_view(*arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*o1) }, mut_view(*arena));
    let gvn_ch = passmgr_run_pass(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*o1) }, PASS_GVN_CSE, mut_view(*arena), mut_view(*sink));
    let bb3_1 = unsafe { opt_block_at((*o1).blocks, 3) };
    let i2_1 = unsafe { opt_inst_at((*bb3_1).insts, 2) };
    let i4_1 = unsafe { opt_inst_at((*bb3_1).insts, 4) };
    if !gvn_ch ||
       (unsafe { (*i2_1).opcode }) != OPT_INST_BINOP ||
       (unsafe { (*i2_1).orig_stmt.rvalue.kind }) != MIR_RVALUE_BINARY_OP ||
       (unsafe { (*i4_1).opcode }) != OPT_INST_COPY {
        opt_free_minimal_thir(thir_ptr);
        return 48;
    }

    let in2 = probe_mir_blob(mut_view(*arena), 2);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m2 = verify_parse_mir(in2, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m2 as usize) == 0 {
        opt_free_minimal_thir(thir_ptr);
        return 63;
    }
    let o2 = optir_build_from_mir(unsafe { view(*m2) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o2 as usize) == 0 || sink.errors != 0 {
        opt_free_minimal_thir(thir_ptr);
        return 64;
    }
    let eff2 = effect_infer_body(unsafe { mut_view(*o2) }, mut_view(*arena), 64u32);
    let in3 = probe_mir_blob(mut_view(*arena), 3);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m3 = verify_parse_mir(in3, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m3 as usize) == 0 {
        opt_free_minimal_thir(thir_ptr);
        return 65;
    }
    let o3 = optir_build_from_mir(unsafe { view(*m3) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o3 as usize) == 0 || sink.errors != 0 {
        opt_free_minimal_thir(thir_ptr);
        return 66;
    }
    let eff3 = effect_infer_body(unsafe { mut_view(*o3) }, mut_view(*arena), 64u32);
    if (unsafe { (*opt_block_at((*o2).blocks, 1)).term.kind }) != OPT_TERM_BRANCH ||
       (eff2.flags & EFFECT_NONTERM) == 0u16 ||
       (unsafe { (*opt_block_at((*o3).blocks, 1)).term.kind }) != OPT_TERM_SWITCH_INT ||
       (eff3.flags & EFFECT_NONTERM) == 0u16 {
        opt_free_minimal_thir(thir_ptr);
        return 49;
    }

    let in4 = probe_mir_blob(mut_view(*arena), 4);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m4 = verify_parse_mir(in4, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m4 as usize) == 0 {
        opt_free_minimal_thir(thir_ptr);
        return 67;
    }
    let o4 = optir_build_from_mir(unsafe { view(*m4) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o4 as usize) == 0 || sink.errors != 0 {
        opt_free_minimal_thir(thir_ptr);
        return 68;
    }
    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget_o2, mut_view(*arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*o4) }, mut_view(*arena));
    let bb0_4 = unsafe { opt_block_at((*o4).blocks, 0) };
    let i0_4 = unsafe { opt_inst_at((*bb0_4).insts, 0) };
    let i2_4 = unsafe { opt_inst_at((*bb0_4).insts, 2) };
    let i4_4 = unsafe { opt_inst_at((*bb0_4).insts, 4) };
    let v0_4 = OptValueId { v: unsafe { (*i0_4).result.v } };
    if !passmgr_run_pass(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*o4) }, PASS_SCCP, mut_view(*arena), mut_view(*sink)) ||
       (unsafe { (*i2_4).opcode }) != OPT_INST_CONST ||
       (unsafe { (*i2_4).lhs.v }) != OPT_VALUE_NONE ||
       (unsafe { (*i2_4).orig_stmt.rvalue.use_op.constant.kind }) != MIR_CONST_BOOL ||
       pm_count_value_uses(unsafe { view(*o4) }, v0_4) != 0u32 {
        opt_free_minimal_thir(thir_ptr);
        return 50;
    }
    if !passmgr_run_pass(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*o4) }, PASS_DCE, mut_view(*arena), mut_view(*sink)) ||
       (unsafe { (*i4_4).opcode }) != OPT_INST_NOP ||
       (unsafe { (*i4_4).orig_stmt.kind }) == MIR_STMT_STORAGE_LIVE ||
       (unsafe { (*i0_4).opcode }) != OPT_INST_NOP {
        opt_free_minimal_thir(thir_ptr);
        return 51;
    }
    let rec4 = arena_alloc_raw(mut_view(*arena), size_of<MirBody>(), align_of<MirBody>()) as *mut MirBody;
    if !optir_reconstruct_mir(unsafe { view(*o4) }, unsafe { mut_view(*rec4) }, mut_view(*arena)) {
        opt_free_minimal_thir(thir_ptr);
        return 52;
    }
    verify_mir(unsafe { view(*rec4) }, thir_ptr as *const Thir, mut_view(*sink), 0 as *const HirItem);
    if (unsafe { (*mir_bb_at((*rec4).bbs, 0)).stmt_count }) != 2 || sink.errors != 0 {
        opt_free_minimal_thir(thir_ptr);
        return 53;
    }

    let in5 = probe_mir_blob(mut_view(*arena), 5);
    diag_sink_free(mut_view(*sink));
    diag_sink_init(mut_view(*sink));
    let m5 = verify_parse_mir(in5, unsafe { mut_view((*thir_ptr).interner) }, mut_view(*arena));
    if (m5 as usize) == 0 {
        opt_free_minimal_thir(thir_ptr);
        return 69;
    }
    let o5 = optir_build_from_mir(unsafe { view(*m5) }, thir_ptr as *const Thir, mut_view(*arena), mut_view(*sink), 0 as *const HirItem);
    if (o5 as usize) == 0 || sink.errors != 0 {
        opt_free_minimal_thir(thir_ptr);
        return 70;
    }
    passmgr_init(unsafe { mut_view(*pm_ptr) }, budget_o2, mut_view(*arena));
    passmgr_mark_all_valid_from_lowering(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*o5) }, mut_view(*arena));
    let bb0_5 = unsafe { opt_block_at((*o5).blocks, 0) };
    let v0_5 = OptValueId { v: unsafe { (*opt_inst_at((*bb0_5).insts, 0)).result.v } };
    let mut cv5: u64 = 0u64;
    if !pm_value_is_const_int(unsafe { view(*pm_ptr) }, unsafe { view(*o5) }, v0_5, mut_view(cv5)) || cv5 != 1u64 {
        opt_free_minimal_thir(thir_ptr);
        return 54;
    }
    passmgr_invalidate_analyses(unsafe { mut_view(*pm_ptr) }, ANALYSIS_MASK_RANGE_INFO);
    if pm_value_is_const_int(unsafe { view(*pm_ptr) }, unsafe { view(*o5) }, v0_5, mut_view(cv5)) ||
       passmgr_run_pass(unsafe { mut_view(*pm_ptr) }, unsafe { mut_view(*o5) }, PASS_CFG_SIMPLIFY, mut_view(*arena), mut_view(*sink)) {
        opt_free_minimal_thir(thir_ptr);
        return 55;
    }

    opt_free_minimal_thir(thir_ptr);
    arena_reset(mut_view(*arena));
    0
}

pub fn main() -> i32 {
    let mut perm_arena = arena_new();
    let mut arena = arena_new();
    let _ = arena_alloc_raw(mut_view(arena), 16, 8);
    let sink_ptr = arena_alloc_raw(mut_view(perm_arena), size_of<DiagSink>(), align_of<DiagSink>()) as *mut DiagSink;
    unsafe { diag_sink_init(mut_view(*sink_ptr)); }

    let r1 = verify_effects_and_call_graph(mut_view(arena));
    if r1 != 0 {
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(arena));
        arena_destroy(mut_view(perm_arena));
        return r1;
    }
    print("PROBE_EFFECTS_CG=OK\n");

    let r2 = verify_passmgr_caching_contracts_and_passes(mut_view(arena), unsafe { mut_view(*sink_ptr) });
    if r2 != 0 {
        unsafe { diag_sink_free(mut_view(*sink_ptr)); }
        arena_destroy(mut_view(arena));
        arena_destroy(mut_view(perm_arena));
        return r2;
    }
    print("PROBE_PASSMGR_CONTRACTS=OK\n");

    unsafe { diag_sink_free(mut_view(*sink_ptr)); }
    arena_destroy(mut_view(arena));
    arena_destroy(mut_view(perm_arena));
    print("PROBE_ALL=OK\n");
    0
}
