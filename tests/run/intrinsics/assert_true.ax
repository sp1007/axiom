// test: run
// modes: interp native
// exit: 7
// stdout: one\ntwo\n
// T134: a true assert falls through; the condition may be any bool expression (also a computed one).

@intrinsic fn assert(c: bool) {}

fn main() -> i32 {
    let a: i32 = 3;
    assert(true);
    print("one\n");
    assert(a + 4 == 7);
    print("two\n");
    a + 4
}
