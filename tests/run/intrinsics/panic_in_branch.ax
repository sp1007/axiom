// test: run
// modes: interp native
// exit: 101
// stdout: ok\n
// T134: panic(msg) with the std signature, reached through a branch of a function that returns a value.

@intrinsic fn panic(msg: Str) {}

fn pick(n: i32) -> i32 {
    if n == 1 {
        return 10;
    }
    panic("bad pick");
    0
}

fn main() -> i32 {
    if pick(1) != 10 { return 1; }
    print("ok\n");
    pick(2)
}
