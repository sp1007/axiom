// test: run
// modes: interp native
// stdout: 783\n
// T134 repro: the wrapping/bit intrinsics must give the same result natively as in the interpreter.
// 3 + 4 = 7, rotate_left_u32(1, 3) = 8, count_ones_u32(7) = 3, so 7 * 100 + 8 * 10 + 3 = 783.
// (print_int is not used: the native print_int prints NUL digits, an unrelated defect.)

@intrinsic fn wrapping_add_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn rotate_left_u32(a: u32, b: u32) -> u32 { 0 }
@intrinsic fn count_ones_u32(a: u32) -> u32 { 0 }

fn main() -> i32 {
    let x = wrapping_add_u64(3, 4);
    let y = rotate_left_u32(1, 3);
    let z = count_ones_u32(7);
    let v = x * 100 + (y as u64) * 10 + (z as u64);
    if v == 783 {
        print("783\n");
        return 0;
    }
    1
}
