// test: run
// modes: interp native
// exit: 101
// stdout: start\n
// T134: panic() is the abort path of checked arithmetic (exit code 101); it never falls through the
// function body and the statements after it are never executed.

@intrinsic fn panic() {}

fn main() -> i32 {
    print("start\n");
    panic();
    print("unreachable\n");
    0
}
