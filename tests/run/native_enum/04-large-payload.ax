// test: run
// exit: 0

struct Large {
    a: i64,
    b: i64,
    c: i64,
    d: i64,
}

enum Result {
    Ok(Large),
    Err(i32),
}

fn make_ok(v: i64) -> Result {
    let l = Large { a: v, b: v+1, c: v+2, d: v+3 };
    return Result.Ok(l);
}

fn make_err(code: i32) -> Result {
    return Result.Err(code);
}

fn check(r: Result) -> i32 {
    match r {
        Result.Ok(l) => {
            if l.a != 10 { return 1; }
            if l.b != 11 { return 2; }
            if l.c != 12 { return 3; }
            if l.d != 13 { return 4; }
            return 0;
        },
        Result.Err(code) => {
            return code;
        },
    }
}

fn main() -> i32 {
    let r1 = make_ok(10);
    let st1 = check(r1);
    if st1 != 0 { return st1; }
    
    let r2 = make_err(42);
    let st2 = check(r2);
    if st2 != 42 { return 5; }
    
    return 0;
}
