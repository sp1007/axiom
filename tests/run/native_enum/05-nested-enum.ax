// test: run
// exit: 33

enum Inner {
    V1(i32),
    V2(i32),
}

enum Outer {
    None,
    Some(Inner),
}

fn process(o: Outer) -> i32 {
    match o {
        Outer.None => { return 0; },
        Outer.Some(i) => {
            match i {
                Inner.V1(v) => { return v + 1; },
                Inner.V2(v) => { return v + 2; },
            }
        }
    }
}

fn main() -> i32 {
    let o1 = Outer.None;
    let o2 = Outer.Some(Inner.V1(10));
    let o3 = Outer.Some(Inner.V2(20));
    
    let p1 = process(o1);
    let p2 = process(o2);
    let p3 = process(o3);
    if p1 != 0 { return 1; }
    if p2 != 11 { return 2; }
    if p3 != 22 { return 3; }
    
    return p2 + p3;
}
