// test: run
// exit: 0

enum Status {
    Ok,
    Error,
    Pending,
}

fn get_status(x: i32) -> Status {
    if x == 0 {
        return Status.Ok;
    }
    if x < 0 {
        return Status.Error;
    }
    return Status.Pending;
}

fn main() -> i32 {
    let s1 = get_status(0);
    let s2 = get_status(-5);
    let s3 = get_status(42);
    
    let mut val = 0;
    
    match s1 {
        Status.Ok => { val = val + 1; },
        Status.Error => { return 1; },
        Status.Pending => { return 2; },
    }
    
    match s2 {
        Status.Ok => { return 3; },
        Status.Error => { val = val + 10; },
        Status.Pending => { return 4; },
    }
    
    match s3 {
        Status.Ok => { return 5; },
        Status.Error => { return 6; },
        Status.Pending => { val = val + 100; },
    }
    
    if val != 111 {
        return val;
    }
    
    return 0;
}
