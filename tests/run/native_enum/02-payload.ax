// test: run
// exit: 0

enum OptionI32 {
    None,
    Some(i32),
}

fn map_option(opt: OptionI32) -> OptionI32 {
    match opt {
        OptionI32.None => { return OptionI32.None; },
        OptionI32.Some(v) => { return OptionI32.Some(v * 2); },
    }
}

fn unwrap_or(opt: OptionI32, def: i32) -> i32 {
    match opt {
        OptionI32.None => { return def; },
        OptionI32.Some(v) => { return v; },
    }
}

fn main() -> i32 {
    let a = OptionI32.None;
    let b = OptionI32.Some(21);
    
    let a2 = map_option(a);
    let b2 = map_option(b);
    
    let v1 = unwrap_or(a2, 42);
    
    // Testing if let
    if let OptionI32.Some(val) = b2 {
        if val != 42 {
            return 3;
        }
    } else {
        return 4;
    }
    
    return 0;
}
