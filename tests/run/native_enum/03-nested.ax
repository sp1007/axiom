// test: run
// exit: 0

struct Point {
    x: i32,
    y: i32,
}

enum Event {
    Click(Point),
    KeyPress(i8),
    Quit,
}

struct State {
    active: i64,
    last_event: Event,
}

fn process_event(state: State, ev: Event) -> State {
    let mut next_active = state.active;
    let mut last = Event.Quit;
    
    match ev {
        Event.Quit => {
            next_active = 0;
            last = Event.Quit;
        },
        Event.KeyPress(k) => {
            if k == 27 { // ESC
                next_active = 0;
            }
            last = Event.KeyPress(k);
        },
        Event.Click(pt) => {
            last = Event.Click(Point { x: 10, y: 20 });
        },
    }
    
    return State {
        active: next_active,
        last_event: last,
    };
}

fn main() -> i32 {
    let mut state = State {
        active: 1,
        last_event: Event.Quit,
    };
    
    state = process_event(state, Event.Click(Point { x: 10, y: 20 }));
    if state.active == 0 { return 101; }
    
    let e1 = state.last_event;
    if let Event.Click(pt) = e1 {
        if pt.x != 10 { return 102; }
        if pt.y != 20 { return 103; }
    } else {
        return 104;
    }
    
    state = process_event(State { active: 1, last_event: Event.Quit }, Event.KeyPress(32));
    if state.active == 0 { return 105; }
    
    state = process_event(State { active: 1, last_event: Event.Quit }, Event.KeyPress(27));
    if state.active == 1 { return 106; }
    
    state = process_event(State { active: 1, last_event: Event.Quit }, Event.Quit);
    if state.active == 1 { return 107; }
    
    let e2 = state.last_event;
    if let Event.Quit = e2 {
        // Ok
    } else {
        return 108;
    }
    
    return 0;
}
