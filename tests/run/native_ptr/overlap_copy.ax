// test: run
// exit: 18

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy<T>(src: *const T, dst: *mut T, count: usize) {}

fn main() -> i32 {
    let mut arr: [5]i32 = [1, 2, 3, 4, 5];
    unsafe {
        let p0: *mut i32 = address_of_mut(arr[0]);
        // Right shift (src < dst): copy arr[0..3] -> arr[1..4]
        let p1: *mut i32 = p0 + 1;
        ptr_copy<i32>(p0 as *const i32, p1, 3);
        if arr[0] != 1 || arr[1] != 1 || arr[2] != 2 || arr[3] != 3 || arr[4] != 5 {
            return 1;
        }

        // Left shift (src > dst): copy arr[2..5] -> arr[0..3]
        let p2: *mut i32 = p0 + 2;
        ptr_copy<i32>(p2 as *const i32, p0, 3);
        if arr[0] != 2 || arr[1] != 3 || arr[2] != 5 || arr[3] != 3 || arr[4] != 5 {
            return 2;
        }
    }
    return arr[0] + arr[1] + arr[2] + arr[3] + arr[4];
}
