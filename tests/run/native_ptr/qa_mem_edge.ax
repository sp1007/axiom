// test: run
// exit: 100

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_copy<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic unsafe fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {}
@intrinsic unsafe fn ptr_write_bytes<T>(dst: *mut T, val: u8, count: usize) {}
@intrinsic fn needs_drop<T>() -> bool { false }

struct Simple {
    a: i32,
}

struct HasDrop {
    x: i32,
}

impl Drop for HasDrop {
    fn drop(self: mut_view<HasDrop>) {
    }
}

struct Wrapper {
    inner: HasDrop,
}

fn main() -> i32 {
    let mut arr: [4]i32 = [10, 20, 30, 40];
    unsafe {
        let p: *mut i32 = address_of_mut(arr[0]);

        // Zero count ptr_copy should do nothing
        ptr_copy<i32>(p as *const i32, p + 1, 0);
        if arr[0] != 10 || arr[1] != 20 || arr[2] != 30 || arr[3] != 40 {
            return 1;
        }

        // ptr_copy when src == dst
        ptr_copy<i32>(p as *const i32, p, 4);
        if arr[0] != 10 || arr[1] != 20 || arr[2] != 30 || arr[3] != 40 {
            return 2;
        }

        // Zero count ptr_copy_nonoverlapping should do nothing
        let mut arr2: [4]i32 = [1, 2, 3, 4];
        let p2: *mut i32 = address_of_mut(arr2[0]);
        ptr_copy_nonoverlapping<i32>(p as *const i32, p2, 0);
        if arr2[0] != 1 || arr2[1] != 2 || arr2[2] != 3 || arr2[3] != 4 {
            return 3;
        }

        // Zero count ptr_write_bytes should do nothing
        ptr_write_bytes<i32>(p2, 0xFF, 0);
        if arr2[0] != 1 || arr2[1] != 2 || arr2[2] != 3 || arr2[3] != 4 {
            return 4;
        }

        // Multi-byte ptr_write_bytes: count=2 on i32 writes 2 * 4 = 8 bytes
        ptr_write_bytes<i32>(p2, 0x12, 2);
        if arr2[0] != 0x12121212 || arr2[1] != 0x12121212 || arr2[2] != 3 || arr2[3] != 4 {
            return 5;
        }
    }

    if needs_drop<Simple>() {
        return 6;
    }
    if !needs_drop<Wrapper>() {
        return 7;
    }
    if needs_drop<i32>() {
        return 8;
    }

    return arr[0] + arr[1] + arr[2] + arr[3];
}
