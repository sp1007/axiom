// test: run
// modes: native
// flags: --stack-reserve 4194304
// exit: 170

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_write_bytes<T>(dst: *mut T, val: u8, count: usize) {}

fn main() -> i32 {
    let mut buf: [1048576]u8 = [0; 1048576];
    unsafe {
        let p: *mut u8 = address_of_mut(buf[0]);
        ptr_write_bytes<u8>(p, 0xAA, 1048576);
        if buf[0] != 0xAA || buf[524288] != 0xAA || buf[1048575] != 0xAA {
            return 1;
        }
    }
    return buf[524288] as i32;
}
