    x64_ret(mut_view(*sec));
    chk1(mut_view(*sec), mut_view(*count), mut_view(*fail), 0xc3u8);
    // int3
    x64_int3(mut_view(*sec));
    chk1(mut_view(*sec), mut_view(*count), mut_view(*fail), 0xccu8);
}

