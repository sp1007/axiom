fn chk1(sec: mut_view<Section>, c: mut_view<i64>, fail: mut_view<i64>, b0: u8) {
    if sec.bytes_len != 1 || sec.buf[0] != b0 {
        *fail = *fail + 1;
    }
    sec.bytes_len = 0;
    *c = *c + 1;
}
fn xfail_chk1(sec: mut_view<Section>, c: mut_view<i64>, fail: mut_view<i64>, b0: u8) {
    if sec.bytes_len != 1 || sec.buf[0] != b0 {
        *fail = *fail + 1;
    }
    sec.bytes_len = 0;
    *c = *c + 1;
}
fn chk2(sec: mut_view<Section>, c: mut_view<i64>, fail: mut_view<i64>, b0: u8, b1: u8) {
    if sec.bytes_len != 2 || sec.buf[0] != b0 || sec.buf[1] != b1 {
        *fail = *fail + 1;
    }
    sec.bytes_len = 0;
    *c = *c + 1;
}
fn xfail_chk2(sec: mut_view<Section>, c: mut_view<i64>, fail: mut_view<i64>, b0: u8, b1: u8) {
    if sec.bytes_len != 2 || sec.buf[0] != b0 || sec.buf[1] != b1 {
        *fail = *fail + 1;
    }
    sec.bytes_len = 0;
    *c = *c + 1;
}
