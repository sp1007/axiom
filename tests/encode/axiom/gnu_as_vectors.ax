    chk6(mut_view(*sec), mut_view(*count), mut_view(*fail), 0x8fu8, 0x05u8, 0x7fu8, 0xffu8, 0xffu8, 0xffu8);
    // pushq 2147483647(%rip)
    x64_push_m(mut_view(*sec), x64_mem_rip(2147483647));
    chk6(mut_view(*sec), mut_view(*count), mut_view(*fail), 0xffu8, 0x35u8, 0xffu8, 0xffu8, 0xffu8, 0x7fu8);
    // popq 2147483647(%rip)
    x64_pop_m(mut_view(*sec), x64_mem_rip(2147483647));
    chk6(mut_view(*sec), mut_view(*count), mut_view(*fail), 0x8fu8, 0x05u8, 0xffu8, 0xffu8, 0xffu8, 0x7fu8);
    // pushq -2147483648(%rip)
    x64_push_m(mut_view(*sec), x64_mem_rip((-2147483647 - 1)));
    chk6(mut_view(*sec), mut_view(*count), mut_view(*fail), 0xffu8, 0x35u8, 0x00u8, 0x00u8, 0x00u8, 0x80u8);
    // popq -2147483648(%rip)
