    // pushq -129(%rip)
    x64_push_m(mut_view(*sec), x64_mem_rip(-129));
    chk6(mut_view(*sec), mut_view(*count), mut_view(*fail), 0xffu8, 0x35u8, 0x7fu8, 0xffu8, 0xffu8, 0xffu8);
