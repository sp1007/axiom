// test: helper
// Self-contained non-trivial program (no std, no host calls, .rdata const table + calls + arithmetic)
// cross-linked with `gcc -nostdlib -Wl,--entry=ax_main` by tests/driver/cross_link_oracle.py (T142).

@derive(Copy)
struct Table {
    a: i32,
    b: i32,
    c: i32,
    d: i32,
}

const TABLE: Table = Table { a: 10, b: 20, c: 6, d: 24 };

@intrinsic fn wrapping_add_i32(a: i32, b: i32) -> i32 { 0 }
@intrinsic fn wrapping_sub_i32(a: i32, b: i32) -> i32 { 0 }
@intrinsic fn wrapping_mul_i32(a: i32, b: i32) -> i32 { 0 }

fn step_mul(x: i32, y: i32) -> i32 {
    let sum = wrapping_add_i32(x, y);
    wrapping_mul_i32(sum, 2)
}

fn combine(x: i32, y: i32, z: i32) -> i32 {
    let m = step_mul(x, y);
    let diff = wrapping_sub_i32(m, TABLE.d);
    wrapping_add_i32(diff, z)
}

fn main() -> i32 {
    let t = TABLE;
    combine(t.a, t.b, t.c)
}
