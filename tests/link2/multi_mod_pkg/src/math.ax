module math

use util.bias_offset

fn local_step() -> i64 {
    4
}

pub fn generic_clamp<T>(val: T, lo: i64, hi: i64) -> T {
    let _ = lo + hi;
    val
}

pub fn weighted_sum(a: i64, b: i64) -> i64 {
    let base = a * b;
    let clamped = generic_clamp<i64>(local_step(), 1, 10);
    base + bias_offset(clamped)
}
