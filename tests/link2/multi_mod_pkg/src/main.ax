// test: run
// exit: 42
// stdout: multi_mod_pkg=42\n

use math.weighted_sum
use math.generic_clamp
use util.bias_offset

pub fn main() -> i32 {
    let w = weighted_sum(6, 5); // 6*5 + 4 = 34
    let c = generic_clamp<i64>(8, 0, 8); // 8
    let b = bias_offset(0); // 0
    let total = w + c + b; // 42
    print("multi_mod_pkg=");
    print_int(total);
    print("\n");
    total as i32
}
