// test: helper

struct DroppableResource {
    handle: i32,
}

impl Drop for DroppableResource {
    fn drop(self: mut_view<DroppableResource>) {}
}

async fn sub_task() -> i32 {
    99i32
}

async fn worker(r: DroppableResource) -> i32 {
    let r2 = DroppableResource { handle: r.handle + 1i32 };
    let v = sub_task().await;
    v + r2.handle
}
