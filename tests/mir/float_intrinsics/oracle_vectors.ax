fn t_copysign_f32() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 484 {
        f = f + chk(230000 + (i as i32), to_bits_f32(copysign_f32(from_bits_f32(COPYSIGN_F32[i * 3] as u32), from_bits_f32(COPYSIGN_F32[i * 3 + 1] as u32))) as u64, COPYSIGN_F32[i * 3 + 2]);
        i = i + 1;
    }
    f
}

fn t_bits_f32() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 82 {
        let v = ABS_F32[i * 2] as u32;
        f = f + chk(270000 + (i as i32), to_bits_f32(from_bits_f32(v)) as u64, v as u64);
        i = i + 1;
    }
    f
}

fn main() -> i32 {
    let mut f: i32 = 0;
    f = f + t_sqrt_f64();
    f = f + t_abs_f64();
    f = f + t_copysign_f64();
    f = f + t_bits_f64();
    f = f + t_sqrt_f32();
    f = f + t_abs_f32();
    f = f + t_copysign_f32();
    f = f + t_bits_f32();
    if f == 0 {
        let checked: i64 = 82 + 82 + 484 + 82 + 82 + 82 + 484 + 82;
        print_int(checked);
        print(" ok\n");
    }
    f
}
