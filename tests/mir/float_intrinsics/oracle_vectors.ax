fn t_sqrt_f64() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 82 {
        f = f + chkf64(0 + (i as i32), to_bits_f64(sqrt_f64(from_bits_f64(SQRT_F64[i * 2]))), SQRT_F64[i * 2 + 1]);
        i = i + 1;
    }
    f
}

