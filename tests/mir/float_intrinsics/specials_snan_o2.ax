// test: run
// flags: -O2
// exit: 0
// stdout: 2139095106 9218868437532825208 4286578754 -9223372036854775808 4609047870845172685 1068827891\n

// T458a (SPEC-41 AXS-FLT-013..014, ADR-0049): strict non-folding and bit-preservation at `-O2`
// (no sqrt constant folding, no FloatBits sNaN-quieting round-trip folding, unused pure ops removable).

@intrinsic fn to_bits_f64(x: f64) -> u64 { 0u64 }
@intrinsic fn from_bits_f64(v: u64) -> f64 { 0.0 }
@intrinsic fn sqrt_f64(x: f64) -> f64 { 0.0 }
@intrinsic fn abs_f64(x: f64) -> f64 { 0.0 }
@intrinsic fn copysign_f64(x: f64, y: f64) -> f64 { 0.0 }
@intrinsic fn to_bits_f32(x: f32) -> u32 { 0u32 }
@intrinsic fn from_bits_f32(v: u32) -> f32 { 0.0 }
@intrinsic fn sqrt_f32(x: f32) -> f32 { 0.0 }
@intrinsic fn abs_f32(x: f32) -> f32 { 0.0 }
@intrinsic fn copysign_f32(x: f32, y: f32) -> f32 { 0.0 }

fn snan_chain_f64(seed: u64) -> u64 {
    // Unused pure intrinsics can be DCE'd without trapping even on negative/sNaN inputs.
    let _dead1 = sqrt_f64(-4.0);
    let _dead2 = abs_f64(from_bits_f64(0xFFF0000000000001u64));
    let _dead3 = to_bits_f64(from_bits_f64(0x7FF0000000000009u64));

    let f0 = from_bits_f64(seed);
    let b0 = to_bits_f64(f0);
    let f1 = abs_f64(from_bits_f64(b0));
    let f2 = copysign_f64(f1, from_bits_f64(0x0000000000000000u64));
    to_bits_f64(f2)
}

fn snan_chain_f32(seed: u32) -> u32 {
    let _dead1 = sqrt_f32(-9.0 as f32);
    let _dead2 = abs_f32(from_bits_f32(0xFF800007u32));
    let f0 = from_bits_f32(seed);
    let b0 = to_bits_f32(f0);
    let f1 = abs_f32(from_bits_f32(b0));
    to_bits_f32(f1)
}

fn main() -> i32 {
    let r0 = snan_chain_f32(0xFF800042u32) as i64;
    let r1 = snan_chain_f64(0xFFF0000012345678u64) as i64;
    let r2 = to_bits_f32(copysign_f32(from_bits_f32(0x7F800042u32), from_bits_f32(0x80000000u32))) as i64;
    let r3 = to_bits_f64(sqrt_f64(from_bits_f64(0x8000000000000000u64))) as i64;
    let r4 = to_bits_f64(sqrt_f64(2.0)) as i64;
    let r5 = to_bits_f32(sqrt_f32(2.0 as f32)) as i64;

    if (r0 as u32) != 0x7F800042u32 { return 1; }
    if (r1 as u64) != 0x7FF0000012345678u64 { return 2; }
    if (r2 as u32) != 0xFF800042u32 { return 3; }

    print_int(r0);
    print(" ");
    print_int(r1);
    print(" ");
    print_int(r2);
    print(" ");
    print_int(r3);
    print(" ");
    print_int(r4);
    print(" ");
    print_int(r5);
    print("\n");
    0
}
