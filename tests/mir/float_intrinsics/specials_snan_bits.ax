// test: run
// exit: 0
// stdout: 2139095106 9218868437532825208 4286578754 -9223372036854775808 4609047870845172685 1068827891\n

// T458a (SPEC-41 AXS-FLT-012, AXS-FLT-025..026, ADR-0049): bit-exact IEEE-754 verification for
// `to_bits`, `from_bits`, `sqrt`, `abs`, `copysign` on f32 and f64 across +-0.0, subnormals,
// +-inf, qNaN with sign/payload, and sNaN patterns (bit t-1 == 0 never quieted by bit/sign ops).

@intrinsic fn to_bits_f64(x: f64) -> u64 { 0u64 }
@intrinsic fn from_bits_f64(v: u64) -> f64 { 0.0 }
@intrinsic fn sqrt_f64(x: f64) -> f64 { 0.0 }
@intrinsic fn abs_f64(x: f64) -> f64 { 0.0 }
@intrinsic fn copysign_f64(x: f64, y: f64) -> f64 { 0.0 }
@intrinsic fn to_bits_f32(x: f32) -> u32 { 0u32 }
@intrinsic fn from_bits_f32(v: u32) -> f32 { 0.0 }
@intrinsic fn sqrt_f32(x: f32) -> f32 { 0.0 }
@intrinsic fn abs_f32(x: f32) -> f32 { 0.0 }
@intrinsic fn copysign_f32(x: f32, y: f32) -> f32 { 0.0 }

fn eq64(id: i32, got: u64, want: u64) -> i32 {
    if got == want { return 0; }
    print("FAIL64 ");
    print_int(id as i64);
    print(" got=");
    print_int(got as i64);
    print(" want=");
    print_int(want as i64);
    print("\n");
    1
}

fn eq32(id: i32, got: u32, want: u32) -> i32 {
    if got == want { return 0; }
    print("FAIL32 ");
    print_int(id as i64);
    print(" got=");
    print_int(got as i64);
    print(" want=");
    print_int(want as i64);
    print("\n");
    1
}

fn is_nan64(bits: u64) -> bool {
    (bits & 0x7FFFFFFFFFFFFFFFu64) > 0x7FF0000000000000u64
}

fn is_nan32(bits: u32) -> bool {
    (bits & 0x7FFFFFFFu32) > 0x7F800000u32
}

fn roundtrip_f64(v: u64) -> u64 {
    let x = from_bits_f64(v);
    let b = to_bits_f64(x);
    let y = from_bits_f64(b);
    to_bits_f64(y)
}

fn roundtrip_f32(v: u32) -> u32 {
    let x = from_bits_f32(v);
    let b = to_bits_f32(x);
    let y = from_bits_f32(b);
    to_bits_f32(y)
}

fn test_f32_specials() -> i32 {
    let mut f: i32 = 0;
    // +-0.0, subnormals, normals, +-inf, qNaN with payload/sign, sNaN with payload/sign
    let cases: [12]u32 = [
        0x00000000u32,
        0x80000000u32,
        0x00000001u32,
        0x80000001u32,
        0x007FFFFFu32,
        0x807FFFFFu32,
        0x7F800000u32,
        0xFF800000u32,
        0x7FC01234u32,
        0xFFC56789u32,
        0x7F800001u32,
        0xFF800042u32,
    ];
    let mut i: usize = 0;
    while i < 12 {
        let v = cases[i];
        f = f + eq32(100 + (i as i32), roundtrip_f32(v), v);
        f = f + eq32(200 + (i as i32), to_bits_f32(abs_f32(from_bits_f32(v))), v & 0x7FFFFFFFu32);
        f = f + eq32(300 + (i as i32), to_bits_f32(copysign_f32(from_bits_f32(v), from_bits_f32(0x80000000u32))), v | 0x80000000u32);
        f = f + eq32(400 + (i as i32), to_bits_f32(copysign_f32(from_bits_f32(v), from_bits_f32(0x7F800001u32))), v & 0x7FFFFFFFu32);
        f = f + eq32(500 + (i as i32), to_bits_f32(copysign_f32(from_bits_f32(v), from_bits_f32(0xFF800042u32))), v | 0x80000000u32);
        i = i + 1;
    }
    // sqrt_f32 exact cases: +0.0, -0.0, subnormals, 4.0, 2.0, +inf
    f = f + eq32(600, to_bits_f32(sqrt_f32(from_bits_f32(0x00000000u32))), 0x00000000u32);
    f = f + eq32(601, to_bits_f32(sqrt_f32(from_bits_f32(0x80000000u32))), 0x80000000u32);
    f = f + eq32(602, to_bits_f32(sqrt_f32(from_bits_f32(0x00000001u32))), 0x1A3504F3u32);
    f = f + eq32(603, to_bits_f32(sqrt_f32(from_bits_f32(0x00800000u32))), 0x20000000u32);
    f = f + eq32(604, to_bits_f32(sqrt_f32(4.0 as f32)), 0x40000000u32);
    f = f + eq32(605, to_bits_f32(sqrt_f32(2.0 as f32)), 0x3FB504F3u32);
    f = f + eq32(606, to_bits_f32(sqrt_f32(from_bits_f32(0x7F800000u32))), 0x7F800000u32);
    // sqrt_f32 NaN-producing cases: negative normal, negative subnormal, -inf, qNaN, sNaN
    if !is_nan32(to_bits_f32(sqrt_f32(-1.0 as f32))) { f = f + 1; }
    if !is_nan32(to_bits_f32(sqrt_f32(from_bits_f32(0x80000001u32)))) { f = f + 1; }
    if !is_nan32(to_bits_f32(sqrt_f32(from_bits_f32(0xFF800000u32)))) { f = f + 1; }
    if !is_nan32(to_bits_f32(sqrt_f32(from_bits_f32(0x7FC01234u32)))) { f = f + 1; }
    if !is_nan32(to_bits_f32(sqrt_f32(from_bits_f32(0x7F800001u32)))) { f = f + 1; }
    if !is_nan32(to_bits_f32(sqrt_f32(from_bits_f32(0xFF800042u32)))) { f = f + 1; }
    f
}

fn test_f64_specials() -> i32 {
    let mut f: i32 = 0;
    let cases: [12]u64 = [
        0x0000000000000000u64,
        0x8000000000000000u64,
        0x0000000000000001u64,
        0x8000000000000001u64,
        0x000FFFFFFFFFFFFFu64,
        0x800FFFFFFFFFFFFFu64,
        0x7FF0000000000000u64,
        0xFFF0000000000000u64,
        0x7FF8123456789ABCu64,
        0xFFF9FEDCBA987654u64,
        0x7FF0000000000001u64,
        0xFFF0000012345678u64,
    ];
    let mut i: usize = 0;
    while i < 12 {
        let v = cases[i];
        f = f + eq64(1100 + (i as i32), roundtrip_f64(v), v);
        f = f + eq64(1200 + (i as i32), to_bits_f64(abs_f64(from_bits_f64(v))), v & 0x7FFFFFFFFFFFFFFFu64);
        f = f + eq64(1300 + (i as i32), to_bits_f64(copysign_f64(from_bits_f64(v), from_bits_f64(0x8000000000000000u64))), v | 0x8000000000000000u64);
        f = f + eq64(1400 + (i as i32), to_bits_f64(copysign_f64(from_bits_f64(v), from_bits_f64(0x7FF0000000000001u64))), v & 0x7FFFFFFFFFFFFFFFu64);
        f = f + eq64(1500 + (i as i32), to_bits_f64(copysign_f64(from_bits_f64(v), from_bits_f64(0xFFF0000012345678u64))), v | 0x8000000000000000u64);
        i = i + 1;
    }
    // sqrt_f64 exact cases: +0.0, -0.0, subnormals, 9.0, 2.0, +inf
    f = f + eq64(1600, to_bits_f64(sqrt_f64(from_bits_f64(0x0000000000000000u64))), 0x0000000000000000u64);
    f = f + eq64(1601, to_bits_f64(sqrt_f64(from_bits_f64(0x8000000000000000u64))), 0x8000000000000000u64);
    f = f + eq64(1602, to_bits_f64(sqrt_f64(from_bits_f64(0x0000000000000001u64))), 0x1E60000000000000u64);
    f = f + eq64(1603, to_bits_f64(sqrt_f64(from_bits_f64(0x0010000000000000u64))), 0x2000000000000000u64);
    f = f + eq64(1604, to_bits_f64(sqrt_f64(9.0)), 0x4008000000000000u64);
    f = f + eq64(1605, to_bits_f64(sqrt_f64(2.0)), 0x3FF6A09E667F3BCDu64);
    f = f + eq64(1606, to_bits_f64(sqrt_f64(from_bits_f64(0x7FF0000000000000u64))), 0x7FF0000000000000u64);
    // sqrt_f64 NaN-producing cases: negative normal, negative subnormal, -inf, qNaN, sNaN
    if !is_nan64(to_bits_f64(sqrt_f64(-1.0))) { f = f + 1; }
    if !is_nan64(to_bits_f64(sqrt_f64(from_bits_f64(0x8000000000000001u64)))) { f = f + 1; }
    if !is_nan64(to_bits_f64(sqrt_f64(from_bits_f64(0xFFF0000000000000u64)))) { f = f + 1; }
    if !is_nan64(to_bits_f64(sqrt_f64(from_bits_f64(0x7FF8123456789ABCu64)))) { f = f + 1; }
    if !is_nan64(to_bits_f64(sqrt_f64(from_bits_f64(0x7FF0000000000001u64)))) { f = f + 1; }
    if !is_nan64(to_bits_f64(sqrt_f64(from_bits_f64(0xFFF0000012345678u64)))) { f = f + 1; }
    f
}

fn main() -> i32 {
    let mut f: i32 = 0;
    // Discarded statement calls (has_dest == false) are pure no-trap ops.
    sqrt_f64(4.0);
    abs_f32(-3.0 as f32);
    copysign_f64(1.0, -2.0);
    to_bits_f64(1.0);
    from_bits_f32(0x3F800000u32);

    f = f + test_f32_specials();
    f = f + test_f64_specials();
    if f != 0 {
        return f;
    }

    let r0 = to_bits_f32(abs_f32(from_bits_f32(0xFF800042u32))) as i64;
    let r1 = to_bits_f64(abs_f64(from_bits_f64(0xFFF0000012345678u64))) as i64;
    let r2 = to_bits_f32(copysign_f32(from_bits_f32(0x7F800042u32), from_bits_f32(0x80000000u32))) as i64;
    let r3 = to_bits_f64(sqrt_f64(from_bits_f64(0x8000000000000000u64))) as i64;
    let r4 = to_bits_f64(sqrt_f64(2.0)) as i64;
    let r5 = to_bits_f32(sqrt_f32(2.0 as f32)) as i64;

    print_int(r0);
    print(" ");
    print_int(r1);
    print(" ");
    print_int(r2);
    print(" ");
    print_int(r3);
    print(" ");
    print_int(r4);
    print(" ");
    print_int(r5);
    print("\n");
    0
}
