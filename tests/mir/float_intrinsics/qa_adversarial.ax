// test: run
// exit: 0
// stdout: 10 2139095041 9218868437227405313 4286578689 2147483648 536870911 2305843009213693951 1602224127 6913025428013711359\n

// T458a QA adversarial test (SPEC-41 AXS-FLT-012..014, AXS-FLT-025..026, ADR-0049):
// Probes:
// 1. Constant-operand & chained FloatBits round-trips on sNaN/subnormal/-0.0 (no folding/quieting).
// 2. f32 to_bits_f32 -> u64 upper-32-bit zero extension (MOVD must not sign-extend bit 31).
// 3. Identity FloatConvert (`x as f32`, `x as f64`) preserving sNaN and -0.0 bit patterns.
// 4. copysign with dual-sNaN operands (keeps x payload & sNaN quiet-bit=0, takes y sign).
// 5. sqrt(-0.0) == -0.0 bit-exact and 1.0 / sqrt(-0.0) == -inf; largest subnormal & max finite sqrt.
// 6. Discarded-result intrinsic calls with side-effecting arguments (DCE must preserve arg side effects).
// 7. Loop-carried alternating from_bits/abs/copysign/sqrt/to_bits across backedges.

@intrinsic fn to_bits_f64(x: f64) -> u64 { 0u64 }
@intrinsic fn from_bits_f64(v: u64) -> f64 { 0.0 }
@intrinsic fn sqrt_f64(x: f64) -> f64 { 0.0 }
@intrinsic fn abs_f64(x: f64) -> f64 { 0.0 }
@intrinsic fn copysign_f64(x: f64, y: f64) -> f64 { 0.0 }
@intrinsic fn to_bits_f32(x: f32) -> u32 { 0u32 }
@intrinsic fn from_bits_f32(v: u32) -> f32 { 0.0 }
@intrinsic fn sqrt_f32(x: f32) -> f32 { 0.0 }
@intrinsic fn abs_f32(x: f32) -> f32 { 0.0 }
@intrinsic fn copysign_f32(x: f32, y: f32) -> f32 { 0.0 }

fn bump_f64(cnt: mut_view<i32>, v: f64) -> f64 {
    *cnt = *cnt + 1;
    v
}

fn bump_f32(cnt: mut_view<i32>, v: f32) -> f32 {
    *cnt = *cnt + 1;
    v
}

fn bump_u64(cnt: mut_view<i32>, v: u64) -> u64 {
    *cnt = *cnt + 1;
    v
}

fn bump_u32(cnt: mut_view<i32>, v: u32) -> u32 {
    *cnt = *cnt + 1;
    v
}

fn check_u64(id: i32, got: u64, want: u64) -> i32 {
    if got == want { return 0; }
    print("FAIL64 ");
    print_int(id as i64);
    print("\n");
    1
}

fn check_u32(id: i32, got: u32, want: u32) -> i32 {
    if got == want { return 0; }
    print("FAIL32 ");
    print_int(id as i64);
    print("\n");
    1
}

fn main() -> i32 {
    let mut fails: i32 = 0;

    // 1. Constant-operand calls & chained sNaN round-trips (must not fold or quiet sNaN).
    let snan32_pos = from_bits_f32(0x7F800001u32);
    let snan32_neg = from_bits_f32(0xFF800001u32);
    let snan64_pos = from_bits_f64(0x7FF0000000000001u64);
    let snan64_neg = from_bits_f64(0xFFF0000000000001u64);

    let rt32 = to_bits_f32(from_bits_f32(to_bits_f32(snan32_pos)));
    let rt64 = to_bits_f64(from_bits_f64(to_bits_f64(snan64_pos)));
    fails = fails + check_u32(1, rt32, 0x7F800001u32);
    fails = fails + check_u64(2, rt64, 0x7FF0000000000001u64);

    // 2. f32 -> u32 -> u64 zero-extension check (bit 31 set must NOT sign-extend into bits 63..32).
    let neg0_f32_u64 = to_bits_f32(from_bits_f32(0x80000000u32)) as u64;
    let snan32_neg_u64 = to_bits_f32(snan32_neg) as u64;
    fails = fails + check_u64(3, neg0_f32_u64, 0x0000000080000000u64);
    fails = fails + check_u64(4, snan32_neg_u64, 0x00000000FF800001u64);

    // 3. Identity FloatConvert (`as f32` / `as f64`) must preserve sNaN & -0.0 bit patterns.
    let id_snan32 = snan32_neg as f32;
    let id_snan64 = snan64_neg as f64;
    let id_neg0_64 = (-0.0) as f64;
    fails = fails + check_u32(5, to_bits_f32(id_snan32), 0xFF800001u32);
    fails = fails + check_u64(6, to_bits_f64(id_snan64), 0xFFF0000000000001u64);
    fails = fails + check_u64(7, to_bits_f64(id_neg0_64), 0x8000000000000000u64);

    // 4. Dual-sNaN copysign & abs(abs(x)) preserving sNaN payloads.
    let cs32 = copysign_f32(from_bits_f32(0x7F800001u32), from_bits_f32(0xFF9ABCDEu32));
    let cs64 = copysign_f64(from_bits_f64(0xFFF0000000000001u64), from_bits_f64(0x7FF00000FEDCBA98u64));
    fails = fails + check_u32(8, to_bits_f32(cs32), 0xFF800001u32);
    fails = fails + check_u64(9, to_bits_f64(cs64), 0x7FF0000000000001u64);
    fails = fails + check_u32(10, to_bits_f32(abs_f32(abs_f32(snan32_neg))), 0x7F800001u32);
    fails = fails + check_u64(11, to_bits_f64(abs_f64(abs_f64(snan64_neg))), 0x7FF0000000000001u64);

    // 5. sqrt(-0.0) == -0.0, 1.0 / sqrt(-0.0) == -inf, largest subnormal & max finite sqrt.
    let sq_neg0_32 = sqrt_f32(from_bits_f32(0x80000000u32));
    let sq_neg0_64 = sqrt_f64(-0.0);
    fails = fails + check_u32(12, to_bits_f32(sq_neg0_32), 0x80000000u32);
    fails = fails + check_u64(13, to_bits_f64(sq_neg0_64), 0x8000000000000000u64);
    fails = fails + check_u32(14, to_bits_f32((1.0 as f32) / sq_neg0_32), 0xFF800000u32);
    fails = fails + check_u64(15, to_bits_f64(1.0 / sq_neg0_64), 0xFFF0000000000000u64);

    let sq_sub_max_32 = to_bits_f32(sqrt_f32(from_bits_f32(0x007FFFFFu32)));
    let sq_sub_max_64 = to_bits_f64(sqrt_f64(from_bits_f64(0x000FFFFFFFFFFFFFu64)));
    let sq_fin_max_32 = to_bits_f32(sqrt_f32(from_bits_f32(0x7F7FFFFFu32)));
    let sq_fin_max_64 = to_bits_f64(sqrt_f64(from_bits_f64(0x7FEFFFFFFFFFFFFFu64)));
    fails = fails + check_u32(16, sq_sub_max_32, 0x1FFFFFFFu32);
    fails = fails + check_u64(17, sq_sub_max_64, 0x1FFFFFFFFFFFFFFFu64);
    fails = fails + check_u32(18, sq_fin_max_32, 0x5F7FFFFFu32);
    fails = fails + check_u64(19, sq_fin_max_64, 0x5FEFFFFFFFFFFFFFu64);

    // 6. Discarded-result intrinsic calls with side-effecting args: side effects must execute.
    let mut side_cnt: i32 = 0;
    to_bits_f64(bump_f64(mut_view(side_cnt), 1.0));
    from_bits_f64(bump_u64(mut_view(side_cnt), 0x3FF0000000000000u64));
    sqrt_f64(bump_f64(mut_view(side_cnt), 4.0));
    abs_f64(bump_f64(mut_view(side_cnt), -2.0));
    copysign_f64(bump_f64(mut_view(side_cnt), 1.0), bump_f64(mut_view(side_cnt), -1.0));
    to_bits_f32(bump_f32(mut_view(side_cnt), 1.0 as f32));
    from_bits_f32(bump_u32(mut_view(side_cnt), 0x3F800000u32));
    sqrt_f32(bump_f32(mut_view(side_cnt), 4.0 as f32));
    abs_f32(bump_f32(mut_view(side_cnt), -2.0 as f32));
    if side_cnt != 10 {
        fails = fails + 1;
    }

    // 7. Loop-carried alternating bitcasts + sign/abs ops on sNaN across backedges.
    let mut cur32: f32 = snan32_pos;
    let mut cur64: f64 = snan64_pos;
    let mut k: i32 = 0;
    while k < 6 {
        let s32 = if (k & 1) == 0 { from_bits_f32(0x80000000u32) } else { from_bits_f32(0x00000000u32) };
        let s64 = if (k & 1) == 0 { from_bits_f64(0x8000000000000000u64) } else { from_bits_f64(0x0000000000000000u64) };
        cur32 = from_bits_f32(to_bits_f32(copysign_f32(abs_f32(cur32), s32)));
        cur64 = from_bits_f64(to_bits_f64(copysign_f64(abs_f64(cur64), s64)));
        k = k + 1;
    }
    // After 6 iterations (k=5 is odd -> positive sign), both must match original positive sNaNs.
    fails = fails + check_u32(20, to_bits_f32(cur32), 0x7F800001u32);
    fails = fails + check_u64(21, to_bits_f64(cur64), 0x7FF0000000000001u64);

    if fails != 0 {
        return fails;
    }

    print_int(side_cnt as i64);
    print(" ");
    print_int(rt32 as i64);
    print(" ");
    print_int(rt64 as i64);
    print(" ");
    print_int(snan32_neg_u64 as i64);
    print(" ");
    print_int(neg0_f32_u64 as i64);
    print(" ");
    print_int(sq_sub_max_32 as i64);
    print(" ");
    print_int(sq_sub_max_64 as i64);
    print(" ");
    print_int(sq_fin_max_32 as i64);
    print(" ");
    print_int(sq_fin_max_64 as i64);
    print("\n");
    0
}
