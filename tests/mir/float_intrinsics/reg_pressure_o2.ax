// test: run
// flags: -O2
// exit: 0
// stdout: 4617315517961601024 9218868437227405319 1077936128 2139095045\n

// T458a: `-O2` register-pressure + loop verification for float & integer vregs across calls.

@intrinsic fn to_bits_f64(x: f64) -> u64 { 0u64 }
@intrinsic fn from_bits_f64(v: u64) -> f64 { 0.0 }
@intrinsic fn sqrt_f64(x: f64) -> f64 { 0.0 }
@intrinsic fn abs_f64(x: f64) -> f64 { 0.0 }
@intrinsic fn copysign_f64(x: f64, y: f64) -> f64 { 0.0 }
@intrinsic fn to_bits_f32(x: f32) -> u32 { 0u32 }
@intrinsic fn from_bits_f32(v: u32) -> f32 { 0.0 }
@intrinsic fn sqrt_f32(x: f32) -> f32 { 0.0 }
@intrinsic fn abs_f32(x: f32) -> f32 { 0.0 }
@intrinsic fn copysign_f32(x: f32, y: f32) -> f32 { 0.0 }

fn clobber_regs(step: u64, x: f64, y: f32) -> u64 {
    if step == 999999u64 {
        return clobber_regs(step - 1u64, x, y);
    }
    let a = sqrt_f64(abs_f64(x));
    let b = sqrt_f32(abs_f32(y));
    to_bits_f64(a) ^ (to_bits_f32(b) as u64) ^ step
}

fn main() -> i32 {
    let d0: f64 = -25.0;
    let d1: f64 = from_bits_f64(0xFFF0000000000007u64);
    let d2: f64 = from_bits_f64(0x8000000000000000u64);
    let d3: f64 = 16.0;
    let d4: f64 = -49.0;
    let d5: f64 = 64.0;
    let d6: f64 = -81.0;
    let d7: f64 = 100.0;
    let d8: f64 = -121.0;
    let d9: f64 = 144.0;
    let d10: f64 = from_bits_f64(0x7FF80000000000AAu64);
    let d11: f64 = -169.0;

    let s0: f32 = -9.0 as f32;
    let s1: f32 = from_bits_f32(0xFF800005u32);
    let s2: f32 = from_bits_f32(0x80000000u32);
    let s3: f32 = 36.0 as f32;
    let s4: f32 = -64.0 as f32;
    let s5: f32 = 100.0 as f32;

    let g0: u64 = to_bits_f64(d1);
    let g1: u64 = to_bits_f64(d10);
    let g2: u32 = to_bits_f32(s1);
    let g3: u64 = 0x1122334455667788u64;
    let g4: u64 = 0x99AABBCCDDEEFF00u64;
    let g5: u32 = 0xCAFEBABEu32;

    let mut noise: u64 = 0u64;
    let mut k: u64 = 0u64;
    while k < 4u64 {
        noise = noise ^ clobber_regs(k, d5, s3);
        k = k + 1u64;
    }
    if noise == 0xFFFFFFFFFFFFFFFFu64 { return 99; }

    let out_d0 = sqrt_f64(abs_f64(d0));
    let out_d1 = abs_f64(d1);
    let out_d2 = sqrt_f64(d2);
    let sum_roots = sqrt_f64(d3) + sqrt_f64(abs_f64(d4)) + sqrt_f64(d5) + sqrt_f64(abs_f64(d6)) +
                    sqrt_f64(d7) + sqrt_f64(abs_f64(d8)) + sqrt_f64(d9) + sqrt_f64(abs_f64(d11));
    if to_bits_f64(sum_roots) != 0x4052800000000000u64 { return 1; }
    if to_bits_f64(out_d2) != 0x8000000000000000u64 { return 2; }
    if to_bits_f64(copysign_f64(d10, d2)) != 0xFFF80000000000AAu64 { return 3; }

    let out_s0 = sqrt_f32(abs_f32(s0));
    let out_s1 = abs_f32(s1);
    let out_s2 = sqrt_f32(s2);
    let sum_s = sqrt_f32(s3) + sqrt_f32(abs_f32(s4)) + sqrt_f32(s5);
    if to_bits_f32(sum_s) != 0x41C00000u32 { return 4; }
    if to_bits_f32(out_s2) != 0x80000000u32 { return 5; }

    if g0 != 0xFFF0000000000007u64 || g1 != 0x7FF80000000000AAu64 || g2 != 0xFF800005u32 { return 6; }
    if g3 != 0x1122334455667788u64 || g4 != 0x99AABBCCDDEEFF00u64 || g5 != 0xCAFEBABEu32 { return 7; }
    if to_bits_f64(from_bits_f64(g0)) != 0xFFF0000000000007u64 { return 8; }
    if to_bits_f32(from_bits_f32(g2)) != 0xFF800005u32 { return 9; }

    print_int(to_bits_f64(out_d0) as i64);
    print(" ");
    print_int(to_bits_f64(out_d1) as i64);
    print(" ");
    print_int(to_bits_f32(out_s0) as i64);
    print(" ");
    print_int(to_bits_f32(out_s1) as i64);
    print("\n");
    0
}
