// test: helper
// Baseline -O0 MIR inspection for synchronization barriers (SPEC-30 §8, ACONC-27, ACONCUR-195).

fn publish_and_observe_o0(flag: view<AtomicI32>, slot: mut_view<i32>) -> i32 {
    let local_unfolded = 40i32 + 2i32;
    *slot = 100i32;
    flag.store(1i32, Ordering.Release);
    let _pre_barrier_read = *slot;
    fence(Ordering.AcqRel);
    let observed = flag.load(Ordering.Acquire);
    compiler_fence(Ordering.SeqCst);
    let post_barrier_read = *slot;
    local_unfolded + observed + post_barrier_read
}

fn main() {
    let flag = AtomicI32.new(0i32);
    let mut payload: i32 = 0i32;
    let _ = publish_and_observe_o0(view(flag), mut_view(payload));
}
