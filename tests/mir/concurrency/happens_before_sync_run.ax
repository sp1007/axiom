// test: run
// stdout: 142

struct Packet {
    header: i32,
    body: i32,
}

fn forward_send_share<T: Send + Share>(x: T) -> T {
    x
}

fn run_release_acquire_protocol(flag: view<AtomicI32>, data_ptr: mut_view<i32>) -> i32 {
    let local_const = 20i32 + 22i32;
    *data_ptr = 100i32;
    flag.store(1i32, Ordering.Release);
    fence(Ordering.AcqRel);
    let st = flag.load(Ordering.Acquire);
    compiler_fence(Ordering.SeqCst);
    let loaded = *data_ptr;
    if st >= 0i32 {
        loaded + local_const
    } else {
        0i32
    }
}

fn main() {
    let pkt = forward_send_share<Packet>(Packet { header: 40i32, body: 2i32 });
    let flag = AtomicI32.new(0i32);
    let mut shared_slot: i32 = pkt.header + pkt.body;
    let res = run_release_acquire_protocol(view(flag), mut_view(shared_slot));
    print_int(res as i64);
}
