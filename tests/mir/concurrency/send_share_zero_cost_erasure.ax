// test: helper
// Verifies Send/Share marker bounds are completely erased at compile time with zero runtime
// witness parameters or descriptor locals in MIR (SPEC-30 AXS-CONC-019, ACONCUR-190..191).

struct Message {
    tag: i32,
    payload: i32,
}

fn require_send<T: Send>(val: T) -> T {
    val
}

fn require_share<T: Share>(v: view<T>) -> i32 {
    1i32
}

fn require_send_and_share<T: Send + Share>(val: T) -> T {
    val
}

fn main() {
    let m = Message { tag: 7i32, payload: 35i32 };
    let m2 = require_send<Message>(m);
    let m3 = require_send_and_share<Message>(m2);
    let ok = require_share<Message>(view(m3));
    let _ = m3.tag + m3.payload + ok;
}
