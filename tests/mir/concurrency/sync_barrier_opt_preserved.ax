// test: helper
// Synchronization barrier preservation under -O1 MIR optimization (SPEC-30 §8, ACONC-27, ACONC-76, ACONCUR-195).

fn publish_and_observe(flag: view<AtomicI32>, slot: mut_view<i32>) -> i32 {
    // Purely local non-escaping constant expression folds to 42_i32 at -O1:
    let local_folded = 40i32 + 2i32;

    // Ordinary memory store followed by release synchronization barrier:
    *slot = 100i32;
    flag.store(1i32, Ordering.Release);

    // Ordinary memory load before acquire fence must not be eliminated or folded across the barrier:
    let _pre_barrier_read = *slot;
    fence(Ordering.Acquire);

    // Acquire atomic load and compiler fence preserve subsequent memory reload:
    let observed_flag = flag.load(Ordering.Acquire);
    compiler_fence(Ordering.SeqCst);
    let post_barrier_read = *slot;

    local_folded + observed_flag + post_barrier_read
}

fn main() {
    let flag = AtomicI32.new(0i32);
    let mut payload: i32 = 0i32;
    let _ = publish_and_observe(view(flag), mut_view(payload));
}
