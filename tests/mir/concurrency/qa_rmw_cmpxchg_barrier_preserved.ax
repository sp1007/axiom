// test: helper
// QA boundary test: RMW, cmpxchg, cmpxchg_weak, and spin_loop_hint barrier preservation under -O1
// (SPEC-30 AXS-CONC-041, AXS-CONC-045, ACONC-27, ACONCUR-195).

fn rmw_and_cas_protocol(counter: view<AtomicI32>, slot: mut_view<i32>) -> i32 {
    let _dead_local = 10i32 + 20i32;
    let live_folded = 50i32 + 25i32;

    *slot = 7i32;
    let prev = counter.fetch_add(1i32, Ordering.AcqRel);
    let _mid_read = *slot;

    let cas = counter.compare_exchange(prev + 1i32, 99i32, Ordering.AcqRel, Ordering.Acquire);
    let _weak = counter.compare_exchange_weak(99i32, 100i32, Ordering.Release, Ordering.Relaxed);
    spin_loop_hint();

    let post_read = *slot;
    if cas.ok {
        live_folded + post_read
    } else {
        post_read
    }
}

fn main() {
    let c = AtomicI32.new(0i32);
    let mut s: i32 = 0i32;
    let _ = rmw_and_cas_protocol(view(c), mut_view(s));
}
