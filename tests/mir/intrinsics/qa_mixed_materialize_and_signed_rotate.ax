// test: golden
// emit: mir
// T490 QA: cross-check mb_intr_materialize boundary between MIR_OP_CONST (kept inline) and non-const
// local operands (materialized into typed temporaries) for wrapping ops and signed rotate_right_i16.
@intrinsic fn wrapping_add_u8(a: u8, b: u8) -> u8 { 0 }
@intrinsic fn wrapping_neg_i8(a: i8) -> i8 { 0 }
@intrinsic fn rotate_right_i16(a: i16, n: u32) -> i16 { 0 }

fn main() {
    let x: u8 = 200u8;
    let a = wrapping_add_u8(x, 10u8);
    let y: i8 = -5i8;
    let b = wrapping_neg_i8(y);
    let v: i16 = -0x1234i16;
    let c = rotate_right_i16(v, 3u32);
}
