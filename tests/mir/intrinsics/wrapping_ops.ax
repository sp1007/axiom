// test: golden
// emit: mir
// T134: wrapping_<op>_<w> calls become one MIR wrapping operation (no overflow assert); wrapping_neg is
// 0 - x modulo 2^bits. Operands go through typed temporaries.
@intrinsic fn wrapping_add_u8(a: u8, b: u8) -> u8 { 0 }
@intrinsic fn wrapping_sub_i32(a: i32, b: i32) -> i32 { 0 }
@intrinsic fn wrapping_mul_u64(a: u64, b: u64) -> u64 { 0 }
@intrinsic fn wrapping_neg_i8(a: i8) -> i8 { 0 }

fn main() {
    let a = wrapping_add_u8(250u8, 10u8);
    let b = wrapping_sub_i32(5i32, 7i32);
    let c = wrapping_mul_u64(3u64, 4u64);
    let d = wrapping_neg_i8(1i8);
}
