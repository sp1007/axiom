// test: helper
// T457 (SPEC-41 AXS-FLT-003 rule 3): exact roundTiesToEven decimal-to-binary conversion of float literals,
// rounded directly to the target width (no double rounding), plus IntToFloat fixing of integer literals.
fn lits(x: f64) -> f64 {
    let a: f32 = 16777217.0
    let b: f32 = 1.0000000596046448
    let c: f64 = 4.9e-324
    let d: f64 = 2.4e-324
    let e: f64 = 0.1
    let f: f32 = 0.1
    let g: f64 = 1.7976931348623157e308
    let h: f64 = 1e23
    let i: f32 = 3.4028235e38
    let j: f64 = 2.2250738585072011e-308
    let k: f64 = x * 9007199254740993
    let _ = a
    let _ = b
    let _ = c
    let _ = d
    let _ = f
    let _ = g
    let _ = h
    let _ = i
    let _ = j
    return e + k
}

fn main() -> i32 {
    let _ = lits(1.0)
    return 0
}
