cmd: {compiler} inspect --emit=mir {test_dir}/patterns_abcd.ax
exit: 0
# T457 / REQ-OWNER-007 (SPEC-41 AXS-FLT-034): every implicit promotion is an explicit MIR cast.
# Pattern A: i32 * i16 -> IntToInt, then IntToFloat into f64; literal 1 fixed to 1.0f64; w + 0.5 in f32 then FloatConvert.
stdout-contains: as type#1073680228 (IntToFloat);
stdout-contains: - const f64#3ff0000000000000;
stdout-contains: + const f32#3f000000;
stdout-contains: as type#1073680228 (FloatConvert);
stdout-contains: / const f64#4018000000000000;
# Pattern C: f32 element array literal, f32 * 4 (literal fixed to 4.0f32), index promoted to usize.
stdout-contains: const f32#3f800000, const f32#40200000, const f32#40800000, const f32#3f000000
stdout-contains: * const f32#40800000;
stdout-contains: as type#15;
stdout-contains: * const f64#3fe0000000000000;
stdout-contains: + const f64#3ff4000000000000;
# float arithmetic carries no overflow/divide-by-zero check (AXS-FLT-010)
