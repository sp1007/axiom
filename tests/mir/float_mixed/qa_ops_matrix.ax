// test: helper
// T457 QA: REQ-OWNER-007 operator matrix beyond Patterns A-D: int literal beside float, f32 context widening,
// comparisons int/float, u64/i128 operands cast to float, call arguments, 0x literals, unary minus, mod.
fn takes_f64(p: f64) -> f64 { return p }
fn takes_f32(p: f32) -> f32 { return p }
fn t(x: f64, w: f32, i: i32, u: u32, k: i16, b: u8, big: u64, h: i128, arr: [4]f32) {
    let a1 = 1 + 2.5
    let a2 = x + i * k - 1
    let a3 = (w + 0.5) + x
    let a4: f64 = w + 0.5
    let a5 = i < x
    let a6 = x == 1
    let a7 = -x
    let a8 = x * 3000000000
    let a9 = w * 16777217
    let a10 = big + x
    let a11 = h + x
    let a12 = i % x
    let a13 = w < x
    let a14 = x / 0
    let a15 = -3 * x
    let a16 = x - -3
    let a17: bool = (x + 1) > (w * 2)
    let a18 = takes_f64((x + i) * 0.5)
    let a19 = takes_f32(w + 1)
    let a20 = takes_f64(w + 0.5)
    let a21 = arr[b] * x
    let a22 = u + w
    let a23 = b * 2.5
    let a24: f32 = k * 0.5
    let a25 = 0x10 + x
    let a26 = 1 - w
    let a27 = i as f64 + w
    let a28 = (x as f32) + w
    let a29 = (x + w) as i32
    let a30 = !(x > w)
}

fn main() -> i32 { return 0 }
