cmd: {compiler} inspect --emit=mir {test_dir}/qa_ops_matrix.ax
exit: 0
# `w * 16777217` with w: f32 fixes the literal to f32 (2^24+1 ties to even 2^24 = 0x4b800000), not an i32 cast
stdout-contains: * const f32#4b800000;
# `x * 3000000000` keeps the whole literal (exactly representable in f64), no i32 truncation
stdout-contains: * const f64#41e65a0bc0000000;
# u64 / i128 / i32 operands are cast with an explicit IntToFloat, f32 operand with FloatConvert
stdout-contains: (IntToFloat);
stdout-contains: (FloatConvert);
