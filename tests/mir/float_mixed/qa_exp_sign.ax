// test: helper
// T457 QA (SPEC-41 AXS-FLT-003 rule 1, SPEC-01 AXS-LEX-055/056): an exponent with a sign and no fraction
// (`1e-5`, `2E+10`) is ONE float literal. Bit patterns were computed with Python struct.pack.
fn exps() -> f64 {
    let a: f64 = 1e-5
    let b: f64 = 2E+10
    let c: f32 = 1e-3
    let d: f32 = 1e-45
    let e: f64 = 1_0e-3
    let _ = a
    let _ = b
    let _ = c
    let _ = d
    return e
}

fn main() -> i32 {
    let _ = exps()
    return 0
}
