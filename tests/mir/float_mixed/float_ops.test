cmd: {compiler} inspect --emit=mir {test_dir}/float_ops.ax
exit: 0
# T457: unary minus of a float is a plain Neg (no overflow assert); `-lit` flips the sign bit.
stdout-contains: = -copy _1;
stdout-contains: const f64#c004000000000000
stdout-contains: as type#8 (FloatToInt);
stdout-contains: as type#1073680178 (IntToFloat);
stdout-contains: as type#1073680178 (FloatConvert);
stdout-contains: as type#1073680228 (IntToFloat);
stdout-contains: == const f32#3fc00000;
stdout-contains: == const f32#be800000;
