cmd: {compiler} inspect --emit=mir {test_dir}/literal_rounding.ax
exit: 0
# 16777217 is a tie between 2^24 and 2^24+2 in f32 -> even (2^24)
stdout-contains: = const f32#4b800000;
# just above the f32 midpoint 1+2^-24: direct rounding gives 1+2^-23 (double rounding via f64 would give 1.0)
stdout-contains: = const f32#3f800001;
# smallest subnormal; 2.4e-324 is below half of it and underflows to +0.0
stdout-contains: = const f64#0000000000000001;
stdout-contains: = const f64#0000000000000000;
stdout-contains: const f64#3fb999999999999a
stdout-contains: = const f32#3dcccccd;
stdout-contains: = const f64#7fefffffffffffff;
stdout-contains: = const f64#44b52d02c7e14af6;
stdout-contains: = const f32#7f7fffff;
# largest subnormal 2.2250738585072009e-308 vs this literal (rounds to the subnormal 0x000fffffffffffff)
stdout-contains: = const f64#000fffffffffffff;
# integer literal fixed to f64: 2^53 + 1 ties to even 2^53
stdout-contains: * const f64#4340000000000000;
