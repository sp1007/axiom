// test: helper
// T457: float unary minus, casts in every direction, mixed comparisons and float literal patterns.
fn ops(a: f64, w: f32, n: i64) -> i32 {
    let neg: f64 = -a
    let lit_neg = -2.5
    let f2i: i32 = a as i32
    let i2f: f32 = n as f32
    let narrow: f32 = a as f32
    let cmp: bool = n < a
    let cmp32: bool = w == 1.5
    let m = match w {
        1.5 => 1,
        -0.25 => 2,
        _ => 3,
    }
    let _ = neg
    let _ = lit_neg
    let _ = i2f
    let _ = narrow
    let _ = cmp
    let _ = cmp32
    return f2i + m
}

fn main() -> i32 {
    return ops(2.0, 1.5f32, 7i64)
}
