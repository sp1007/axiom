// test: helper
// T457 QA round 1: suffixed signed exponents without a fraction and zero-mantissa extreme exponents.
fn exp_edges() -> f64 {
    let a = 1e+0f32
    let b = 1e-0f64
    let c = 1_0e-3f64
    let d = 1e-5f32
    let e = 0e+999f32
    let f = 0e-999f64
    let _ = a
    let _ = b
    let _ = c
    let _ = d
    let _ = e
    return f
}

fn main() -> i32 {
    let _ = exp_edges()
    return 0
}
