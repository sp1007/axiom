// test: helper
// T457 / REQ-OWNER-007 Patterns A-D (SPEC-41 AXS-FLT-036, AXS-FLT-037): mixed literal/variable numeric
// expressions with no suffixes or manual casts, lowered to homogeneous MIR with explicit casts.

fn pattern_a(a: f64, w: f32, i: i32, k: i16, u: u16, n: usize, base: i64) -> f64 {
    let y: f64 = ((a + i * k - 1) / (2 * n + u - 3)) * (w + 0.5) + (base - u * 4 + i) / (a * a / 6.0 - k + 2)
    return y
}

fn pattern_b(mask: u32, sh: u8, delta: i8, step: isize, scale: f64) -> f64 {
    let z: f64 = (((mask >> sh) & 0x3F) + delta * step - 5) * scale / ((1 << sh) + 3)
    return z
}

fn pattern_c(idx: u8, off: isize, x: f64, i: i32, base: i64, u: u16) -> bool {
    let coeff: [4]f32 = [1.0f32, 2.5f32, 4.0f32, 0.5f32]
    let p: f64 = coeff[idx + off] * (x - 3) / (idx * 2 + 1) + coeff[idx - 1] * 4
    let ok: bool = (p + i * 0.5) > (base / 10 - u + 1.25)
    return ok
}

fn pattern_d(s64: i64, s32: i32, u16v: u16, b8: u8, s8: i8) -> i64 {
    let total: i64 = (s64 + s32 * 3) - (u16v + b8 * 2 + s8 - 7) / (4 - s8)
    return total
}

fn main() -> i32 {
    let ya = pattern_a(6.0, 1.5f32, 4, 3i16, 5u16, 3usize, 36i64)
    let zb = pattern_b(0xABu32, 2u8, -3i8, 5isize, 3.5)
    let okc = pattern_c(1u8, 1isize, 6.0, 2, 100i64, 3u16)
    let td = pattern_d(100000i64, -2000, 500u16, 200u8, -50i8)
    let _ = ya
    let _ = zb
    let _ = okc
    let _ = td
    return 0
}
