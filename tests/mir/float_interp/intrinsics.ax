fn t_floor_f64() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 82 {
        f = f + chkf64(20000 + (i as i32), to_bits_f64(floor_f64(from_bits_f64(FLOOR_F64[i * 2]))), FLOOR_F64[i * 2 + 1]);
        i = i + 1;
    }
    f
}

