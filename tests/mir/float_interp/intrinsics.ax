// test: helper
// HELPER, not run by the suite (ADR-0049). Retains the ten derived operations
// (`floor`, `ceil`, `trunc`, `round`, `round_ties_even`, `fma`, `min`, `max`, `next_up`, `next_down`)
// for T460 (`std.core.float` in pure Axiom). The five minimal compiler intrinsics (`to_bits`,
// `from_bits`, `sqrt`, `abs`, `copysign`) now run in `tests/mir/float_intrinsics/oracle_vectors.ax`.

@intrinsic fn to_bits_f64(x: f64) -> u64 { 0u64 }
@intrinsic fn from_bits_f64(v: u64) -> f64 { 0.0 }
@intrinsic fn to_bits_f32(x: f32) -> u32 { 0u32 }
@intrinsic fn from_bits_f32(v: u32) -> f32 { 0.0 }

fn floor_f64(x: f64) -> f64 { x }
fn ceil_f64(x: f64) -> f64 { x }
fn trunc_f64(x: f64) -> f64 { x }
fn round_f64(x: f64) -> f64 { x }
fn round_ties_even_f64(x: f64) -> f64 { x }
fn next_up_f64(x: f64) -> f64 { x }
fn next_down_f64(x: f64) -> f64 { x }
fn min_f64(x: f64, y: f64) -> f64 { let _ = y; x }
fn max_f64(x: f64, y: f64) -> f64 { let _ = y; x }
fn fma_f64(x: f64, y: f64, z: f64) -> f64 { let _ = y; let _ = z; x }
fn floor_f32(x: f32) -> f32 { x }
fn ceil_f32(x: f32) -> f32 { x }
fn trunc_f32(x: f32) -> f32 { x }
fn round_f32(x: f32) -> f32 { x }
fn round_ties_even_f32(x: f32) -> f32 { x }
fn next_up_f32(x: f32) -> f32 { x }
fn next_down_f32(x: f32) -> f32 { x }
fn min_f32(x: f32, y: f32) -> f32 { let _ = y; x }
fn max_f32(x: f32, y: f32) -> f32 { let _ = y; x }
fn fma_f32(x: f32, y: f32, z: f32) -> f32 { let _ = y; let _ = z; x }

fn chk(id: i32, got: u64, want: u64) -> i32 {
    if got == want {
        return 0;
    }
    print("FAIL ");
    print_int(id as i64);
    print(" got ");
    print_int(got as i64);
    print(" want ");
    print_int(want as i64);
    print("\n");
    1
}

// A fresh NaN is equal to any NaN: the sign and payload of an arithmetic NaN are not observable (SPEC-41 AXS-FLT-002).
fn chkf64(id: i32, got: u64, want: u64) -> i32 {
    if (got & 0x7FFFFFFFFFFFFFFFu64) > 0x7FF0000000000000u64 && (want & 0x7FFFFFFFFFFFFFFFu64) > 0x7FF0000000000000u64 {
        return 0;
    }
    chk(id, got, want)
}

fn chkf32(id: i32, got: u64, want: u64) -> i32 {
    if (got & 0x7FFFFFFFu64) > 0x7F800000u64 && (want & 0x7FFFFFFFu64) > 0x7F800000u64 {
        return 0;
    }
    chk(id, got, want)
}


