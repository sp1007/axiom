fn t_max_f32() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 484 {
        f = f + chkf32(250000 + (i as i32), to_bits_f32(max_f32(from_bits_f32(MAX_F32[i * 3] as u32), from_bits_f32(MAX_F32[i * 3 + 1] as u32))) as u64, MAX_F32[i * 3 + 2]);
        i = i + 1;
    }
    f
}

