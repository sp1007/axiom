fn t_fma_f32() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 1576 {
        f = f + chkf32(260000 + (i as i32), to_bits_f32(fma_f32(from_bits_f32(FMA_F32[i * 4] as u32), from_bits_f32(FMA_F32[i * 4 + 1] as u32), from_bits_f32(FMA_F32[i * 4 + 2] as u32))) as u64, FMA_F32[i * 4 + 3]);
        i = i + 1;
    }
    f
}

fn main() -> i32 {
    let mut f: i32 = 0;
    f = f + t_floor_f64();
    f = f + t_ceil_f64();
    f = f + t_trunc_f64();
    f = f + t_round_f64();
    f = f + t_round_ties_even_f64();
    f = f + t_next_up_f64();
    f = f + t_next_down_f64();
    f = f + t_min_f64();
    f = f + t_max_f64();
    f = f + t_fma_f64();
    f = f + t_floor_f32();
    f = f + t_ceil_f32();
    f = f + t_trunc_f32();
    f = f + t_round_f32();
    f = f + t_round_ties_even_f32();
    f = f + t_next_up_f32();
    f = f + t_next_down_f32();
    f = f + t_min_f32();
    f = f + t_max_f32();
    f = f + t_fma_f32();
    if f == 0 {
        print("ok\n");
    }
    f
}
