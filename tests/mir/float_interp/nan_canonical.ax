// test: run
// exit: 0
// stdout: ok\n
// modes: interp
// T458 (SPEC-41 AXS-FLT-002, AXS-FLT-010..012): the oracle produces the canonical positive quiet NaN for every freshly created
// NaN (0x7FC00000 / 0x7FF8000000000000), keeps the sign and payload on negation and widening, and never panics on the
// indeterminate forms. Oracle-only: an x86-64 SSE2 instruction yields the architectural default NaN (sign bit set), whose bits
// are not part of the observable numeric semantics, so the native catch-up checks "is NaN" instead (the other float tests do).

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

fn to_bits(x: f64) -> u64 {
    let v = x;
    unsafe { *(address_of(v) as *const u64) }
}

fn from_bits(b: u64) -> f64 {
    let v = b;
    unsafe { *(address_of(v) as *const f64) }
}

fn to_bits32(x: f32) -> u32 {
    let v = x;
    unsafe { *(address_of(v) as *const u32) }
}

fn from_bits32(b: u32) -> f32 {
    let v = b;
    unsafe { *(address_of(v) as *const f32) }
}

fn chk(id: i32, got: u64, want: u64) -> i32 {
    if got == want {
        return 0;
    }
    print("FAIL ");
    print_int(id as i64);
    print(" got ");
    print_int(got as i64);
    print(" want ");
    print_int(want as i64);
    print("\n");
    1
}

fn main() -> i32 {
    let zero = from_bits(0x0u64);
    let inf = from_bits(0x7FF0000000000000u64);
    let ninf = from_bits(0xFFF0000000000000u64);
    let one = from_bits(0x3FF0000000000000u64);
    let snan = from_bits(0x7FF0000000000001u64);
    let neg_qnan = from_bits(0xFFF8000000000123u64);
    let q: u64 = 0x7FF8000000000000u64;
    let mut f: i32 = 0;
    f = f + chk(1, to_bits(zero / zero), q);
    f = f + chk(2, to_bits(inf - inf), q);
    f = f + chk(3, to_bits(inf + ninf), q);
    f = f + chk(4, to_bits(zero * inf), q);
    f = f + chk(5, to_bits(inf / inf), q);
    f = f + chk(6, to_bits(one % zero), q);
    f = f + chk(7, to_bits(inf % one), q);
    f = f + chk(8, to_bits(snan + one), q);
    f = f + chk(9, to_bits(neg_qnan * one), q);
    f = f + chk(10, to_bits(one - snan), q);
    // Negation flips only the sign bit and keeps the payload (also for NaNs).
    f = f + chk(11, to_bits(-neg_qnan), 0x7FF8000000000123u64);
    f = f + chk(12, to_bits(-snan), 0xFFF0000000000001u64);
    f = f + chk(13, to_bits(-from_bits(q)), 0xFFF8000000000000u64);
    // Widening keeps sign and payload and quiets a signalling NaN; narrowing keeps the top payload bits.
    let n32 = from_bits32(0xFFC00123u32);
    f = f + chk(14, to_bits(n32 as f64), 0xFFF8002460000000u64);
    let s32 = from_bits32(0x7F800001u32);
    f = f + chk(15, to_bits(s32 as f64), 0x7FF8000020000000u64);
    f = f + chk(16, to_bits32(from_bits(0x7FF0000040000000u64) as f32) as u64, 0x7FC00002u64);
    f = f + chk(17, to_bits32(neg_qnan as f32) as u64, 0xFFC00000u64);
    // float -> int and comparisons on NaN do not panic.
    f = f + chk(18, (snan as i32) as u64, 0u64);
    f = f + chk(19, (neg_qnan as u64), 0u64);
    f = f + chk(20, if snan == snan { 1u64 } else { 0u64 }, 0u64);
    // 32-bit forms.
    let z32 = from_bits32(0x0u32);
    let i32inf = from_bits32(0x7F800000u32);
    f = f + chk(21, to_bits32(z32 / z32) as u64, 0x7FC00000u64);
    f = f + chk(22, to_bits32(i32inf - i32inf) as u64, 0x7FC00000u64);
    f = f + chk(23, to_bits32(-from_bits32(0x7FC00000u32)) as u64, 0xFFC00000u64);
    if f == 0 {
        print("ok\n");
    }
    f
}
