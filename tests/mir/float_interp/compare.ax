    0x337FFFFFu64, 0xFF7FFFFFu64, 0x32u64, 0x337FFFFFu64, 0x1u64, 0x32u64,
    0x337FFFFFu64, 0x80000001u64, 0x32u64, 0x337FFFFFu64, 0x7FFFFFu64, 0x32u64,
    0x337FFFFFu64, 0x800000u64, 0x32u64, 0x337FFFFFu64, 0x7F800000u64, 0xEu64,
    0x337FFFFFu64, 0xFF800000u64, 0x32u64, 0x337FFFFFu64, 0x7FC00000u64, 0x2u64,
    0x337FFFFFu64, 0x7F800001u64, 0x2u64, 0x337FFFFFu64, 0xFFC00000u64, 0x2u64,
    0x337FFFFFu64, 0x3EAAAAABu64, 0xEu64, 0x337FFFFFu64, 0x3DCCCCCDu64, 0xEu64,
    0x337FFFFFu64, 0x40490FDBu64, 0xEu64, 0x337FFFFFu64, 0x4B800000u64, 0xEu64,
    0x337FFFFFu64, 0x4B800001u64, 0xEu64, 0x337FFFFFu64, 0x3F800001u64, 0xEu64,
    0x337FFFFFu64, 0x33800000u64, 0xEu64, 0x337FFFFFu64, 0x337FFFFFu64, 0x29u64,
];

fn t_cmp32() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 676 {
        let x: f32 = from_bits_f32(CMP32[i * 3] as u32);
        let y: f32 = from_bits_f32(CMP32[i * 3 + 1] as u32);
        let mut m: u64 = 0u64;
        if x == y { m = m + 1u64; }
        if x != y { m = m + 2u64; }
        if x < y { m = m + 4u64; }
        if x <= y { m = m + 8u64; }
        if x > y { m = m + 16u64; }
        if x >= y { m = m + 32u64; }
        f = f + chk(5000 + (i as i32), m, CMP32[i * 3 + 2]);
        i = i + 1;
    }
    f
}

fn nan_select(a: f64, b: f64) -> i32 {
    if a < b { return 1; }
    if a >= b { return 2; }
    3
}

// `!(a < b)` is not `a >= b` for NaN operands, and a match on a float literal uses `==`.
fn t_nan_logic() -> i32 {
    let nan = from_bits_f64(0x7FF8000000000000u64);
    let one = from_bits_f64(0x3FF0000000000000u64);
    let mut f: i32 = 0;
    f = f + chk(9000, nan_select(nan, one) as u64, 3u64);
    f = f + chk(9001, nan_select(one, nan) as u64, 3u64);
    f = f + chk(9002, nan_select(one, one) as u64, 2u64);
    let not_lt = !(nan < one);
    let ge = nan >= one;
    f = f + chk(9003, if not_lt { 1u64 } else { 0u64 }, 1u64);
    f = f + chk(9004, if ge { 1u64 } else { 0u64 }, 0u64);
    let m = match nan {
        1.5 => 1,
        _ => 2,
    };
    f = f + chk(9005, m as u64, 2u64);
    let m2 = match from_bits_f64(0x3FF8000000000000u64) {
        1.5 => 1,
        _ => 2,
    };
    f = f + chk(9006, m2 as u64, 1u64);
    let nz = match from_bits_f64(0x8000000000000000u64) {
        0.0 => 1,
        _ => 2,
    };
    f = f + chk(9007, nz as u64, 1u64);
    f
}

fn main() -> i32 {
    let mut f: i32 = 0;
    f = f + t_cmp64();
    f = f + t_cmp32();
    f = f + t_nan_logic();
    if f == 0 {
        print("ok\n");
    }
    f
}
