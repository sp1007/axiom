fn t_cmp64() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 676 {
        let x: f64 = from_bits_f64(CMP64[i * 3]);
        let y: f64 = from_bits_f64(CMP64[i * 3 + 1]);
        let mut m: u64 = 0u64;
        if x == y { m = m + 1u64; }
        if x != y { m = m + 2u64; }
        if x < y { m = m + 4u64; }
        if x <= y { m = m + 8u64; }
        if x > y { m = m + 16u64; }
        if x >= y { m = m + 32u64; }
        f = f + chk(1000 + (i as i32), m, CMP64[i * 3 + 2]);
        i = i + 1;
    }
    f
}

