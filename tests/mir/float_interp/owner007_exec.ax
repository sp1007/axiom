// test: run
// exit: 0
// stdout: ok\n

// T458 / REQ-OWNER-007: Patterns A, B, C and D executed on the oracle. The first call of each pattern uses the normative
// inputs of SPEC-41 AXS-FLT-036/037 (y == 8.25, z == 11.0, p == 8.0, ok == true, total == 93985); the others use inputs where
// the f32 sub-expression rounds (`w + 0.5` is an f32 addition widened afterwards) and where signs and widths differ.

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

// Bit-pattern access without intrinsics: the oracle and native read the same bytes through a punned pointer.
fn to_bits_f64(x: f64) -> u64 {
    let v = x;
    unsafe { *(address_of(v) as *const u64) }
}

fn from_bits_f64(b: u64) -> f64 {
    let v = b;
    unsafe { *(address_of(v) as *const f64) }
}

fn to_bits_f32(x: f32) -> u32 {
    let v = x;
    unsafe { *(address_of(v) as *const u32) }
}

fn from_bits_f32(b: u32) -> f32 {
    let v = b;
    unsafe { *(address_of(v) as *const f32) }
}

fn chk(id: i32, got: u64, want: u64) -> i32 {
    if got == want {
        return 0;
    }
    print("FAIL ");
    print_int(id as i64);
    print(" got ");
    print_int(got as i64);
    print(" want ");
    print_int(want as i64);
    print("\n");
    1
}

fn pattern_a(a: f64, w: f32, i: i32, k: i16, u: u16, n: usize, base: i64) -> f64 {
    let y: f64 = ((a + i * k - 1) / (2 * n + u - 3)) * (w + 0.5) + (base - u * 4 + i) / (a * a / 6.0 - k + 2)
    return y
}

fn pattern_b(mask: u32, sh: u8, delta: i8, step: isize, scale: f64) -> f64 {
    let z: f64 = (((mask >> sh) & 0x3F) + delta * step - 5) * scale / ((1 << sh) + 3)
    return z
}

fn pattern_c_p(idx: u8, off: isize, x: f64) -> f64 {
    let coeff: [4]f32 = [1.0f32, 2.5f32, 4.0f32, 0.5f32]
    let p: f64 = coeff[idx + off] * (x - 3) / (idx * 2 + 1) + coeff[idx - 1] * 4
    return p
}

fn pattern_c_ok(p: f64, i: i32, base: i64, u: u16) -> bool {
    let ok: bool = (p + i * 0.5) > (base / 10 - u + 1.25)
    return ok
}

fn pattern_d(s64: i64, s32: i32, u16v: u16, b8: u8, s8: i8) -> i64 {
    let total: i64 = (s64 + s32 * 3) - (u16v + b8 * 2 + s8 - 7) / (4 - s8)
    return total
}

fn main() -> i32 {
    let mut f: i32 = 0;
    f = f + chk(101, to_bits_f64(pattern_a(from_bits_f64(0x4018000000000000u64), from_bits_f32(0x3FC00000u32), 4, 3i16, 5u16, 3usize, 36i64)), 0x4020800000000000u64);
    f = f + chk(102, to_bits_f64(pattern_a(from_bits_f64(0x3FF199999999999Au64), from_bits_f32(0x3F8CCCCDu32), 7, -5i16, 300u16, 11usize, -12345i64)), 0xC09D601219AB574Du64);
    f = f + chk(103, to_bits_f64(pattern_a(from_bits_f64(0xBFD3333333333333u64), from_bits_f32(0x4B800000u32), -3, 2i16, 9u16, 5usize, 99999i64)), 0xC12E3B1999999820u64);
    f = f + chk(104, to_bits_f64(pattern_a(from_bits_f64(0x7E37E43C8800759Cu64), from_bits_f32(0x7F7FC99Eu32), 1000, -32768i16, 65535u16, 1usize, -9000000000i64)), 0x7FF0000000000000u64);
    f = f + chk(201, to_bits_f64(pattern_b(171u32, 2u8, -3i8, 5isize, from_bits_f64(0x400C000000000000u64))), 0x4026000000000000u64);
    f = f + chk(202, to_bits_f64(pattern_b(4294905615u32, 3u8, -7i8, 11isize, from_bits_f64(0x3FB999999999999Au64))), 0xBFDC8253C8253C83u64);
    f = f + chk(203, to_bits_f64(pattern_b(305419896u32, 0u8, 100i8, -1000isize, from_bits_f64(0xC004000000000000u64))), 0x40EE808400000000u64);
    f = f + chk(204, to_bits_f64(pattern_b(2147483648u32, 30u8, -128i8, 9isize, from_bits_f64(0x12688B70E62Bu64))), 0x80000000014C36B4u64);
    f = f + chk(301, to_bits_f64(pattern_c_p(1u8, 1isize, from_bits_f64(0x4018000000000000u64))), 0x4020000000000000u64);
    f = f + chk(351, if pattern_c_ok(from_bits_f64(0x4020000000000000u64), 2, 100i64, 3u16) { 1u64 } else { 0u64 }, 1u64);
    f = f + chk(302, to_bits_f64(pattern_c_p(2u8, -1isize, from_bits_f64(0xC011000000000000u64))), 0x4019800000000000u64);
    f = f + chk(352, if pattern_c_ok(from_bits_f64(0x4019800000000000u64), -7, 12345i64, 9u16) { 1u64 } else { 0u64 }, 0u64);
    f = f + chk(303, to_bits_f64(pattern_c_p(2u8, -2isize, from_bits_f64(0x4202A05F20000000u64))), 0x41DDCD650259999Au64);
    f = f + chk(353, if pattern_c_ok(from_bits_f64(0x41DDCD650259999Au64), 5, -4000i64, 200u16) { 1u64 } else { 0u64 }, 1u64);
    f = f + chk(304, to_bits_f64(pattern_c_p(3u8, 0isize, from_bits_f64(0x3FB999999999999Au64))), 0x402F95F15F15F15Fu64);
    f = f + chk(354, if pattern_c_ok(from_bits_f64(0x402F95F15F15F15Fu64), 1, 7i64, 0u16) { 1u64 } else { 0u64 }, 1u64);
    f = f + chk(401, pattern_d(100000i64, -2000i32, 500u16, 200u8, -50i8) as u64, 0x16F21u64);
    f = f + chk(402, pattern_d(-5i64, 7i32, 65535u16, 255u8, 127i8) as u64, 0x229u64);
    f = f + chk(403, pattern_d(9000000000i64, -2147483648i32, 0u16, 0u8, -128i8) as u64, 0x98711A01u64);
    if f == 0 {
        print("ok\n");
    }
    f
}
