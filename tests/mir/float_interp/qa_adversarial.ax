fn t_add64() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 571 {
        let a: f64 = from_bits_f64(ADD64[i * 3]);
        let b: f64 = from_bits_f64(ADD64[i * 3 + 1]);
        f = f + chkf64(10000 + (i as i32), to_bits_f64(a + b), ADD64[i * 3 + 2]);
        i = i + 1;
    }
    f
}

fn t_sub64() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 571 {
        let a: f64 = from_bits_f64(SUB64[i * 3]);
        let b: f64 = from_bits_f64(SUB64[i * 3 + 1]);
        f = f + chkf64(20000 + (i as i32), to_bits_f64(a - b), SUB64[i * 3 + 2]);
        i = i + 1;
    }
    f
}

fn t_mul64() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 571 {
        let a: f64 = from_bits_f64(MUL64[i * 3]);
        let b: f64 = from_bits_f64(MUL64[i * 3 + 1]);
        f = f + chkf64(30000 + (i as i32), to_bits_f64(a * b), MUL64[i * 3 + 2]);
        i = i + 1;
    }
    f
}

