// T458 QA (adversarial, round 0): independent IEEE-754 vectors for the oracle, a different seed and different pools than the
// engineer's tables. add/sub/mul/div/rem for f32 and f64 (specials x specials, exponent-window randoms, a vs a-with-flipped-low-bits
// cancellation pairs, huge-exponent-gap rem), comparison masks, int -> float for i64/u64/i128/u128 (powers of two +-3, exact halfway
// patterns, random), saturating float -> int for 8 target types (NaN -> 0, 2^k boundaries +-1 ulp), f64 -> f32 narrowing around
// exact halfways, the subnormal f32 range and the overflow boundary, f32 -> f64 widening.
// References: numpy hardware floats (add/sub/mul/div/fmod), exact Fractions (float -> int), exact integer rounding (int -> float).

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

fn to_bits_f64(x: f64) -> u64 {
    let v = x;
    unsafe { *(address_of(v) as *const u64) }
}

fn from_bits_f64(b: u64) -> f64 {
    let v = b;
    unsafe { *(address_of(v) as *const f64) }
}

fn to_bits_f32(x: f32) -> u32 {
    let v = x;
    unsafe { *(address_of(v) as *const u32) }
}

fn from_bits_f32(b: u32) -> f32 {
    let v = b;
    unsafe { *(address_of(v) as *const f32) }
}

fn chk(id: i32, got: u64, want: u64) -> i32 {
    if got == want {
        return 0;
    }
    print("FAIL ");
    print_int(id as i64);
    print(" got ");
    print_int(got as i64);
    print(" want ");
    print_int(want as i64);
    print("\n");
    1
}

// Any NaN equals any NaN (sign/payload of a fresh NaN are not observable, SPEC-41 AXS-FLT-002).
fn chkf64(id: i32, got: u64, want: u64) -> i32 {
    if (got & 0x7FFFFFFFFFFFFFFFu64) > 0x7FF0000000000000u64 && (want & 0x7FFFFFFFFFFFFFFFu64) > 0x7FF0000000000000u64 {
        return 0;
    }
    chk(id, got, want)
}

fn chkf32(id: i32, got: u64, want: u64) -> i32 {
    if (got & 0x7FFFFFFFu64) > 0x7F800000u64 && (want & 0x7FFFFFFFu64) > 0x7F800000u64 {
        return 0;
    }
    chk(id, got, want)
}

