fn t_cmp64() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 561 {
        let a: f64 = from_bits_f64(CMP64[i * 3]);
        let b: f64 = from_bits_f64(CMP64[i * 3 + 1]);
        let mut m: u64 = 0u64;
        if a == b { m = m | 1u64; }
        if a != b { m = m | 2u64; }
        if a < b { m = m | 4u64; }
        if a <= b { m = m | 8u64; }
        if a > b { m = m | 16u64; }
        if a >= b { m = m | 32u64; }
        f = f + chk(110000 + (i as i32), m, CMP64[i * 3 + 2]);
        i = i + 1;
    }
    f
}

fn t_cmp32() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 561 {
        let a: f32 = from_bits_f32(CMP32[i * 3] as u32);
        let b: f32 = from_bits_f32(CMP32[i * 3 + 1] as u32);
        let mut m: u64 = 0u64;
        if a == b { m = m | 1u64; }
        if a != b { m = m | 2u64; }
        if a < b { m = m | 4u64; }
        if a <= b { m = m | 8u64; }
        if a > b { m = m | 16u64; }
        if a >= b { m = m | 32u64; }
        f = f + chk(120000 + (i as i32), m, CMP32[i * 3 + 2]);
        i = i + 1;
    }
    f
}

fn t_i2f_i64() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 1502 {
        let v: i64 = I2F_I64[i * 4] as i64;
        f = f + chk(130000 + (i as i32), to_bits_f64(v as f64), I2F_I64[i * 4 + 2]);
        f = f + chk(140000 + (i as i32), to_bits_f32(v as f32) as u64, I2F_I64[i * 4 + 3]);
        i = i + 1;
    }
    f
}

