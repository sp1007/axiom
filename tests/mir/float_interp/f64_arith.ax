fn t_add() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 384 {
        let a = ADD[i * 3];
        let b = ADD[i * 3 + 1];
        f = f + chkf64(1000 + (i as i32), to_bits_f64(from_bits_f64(a) + from_bits_f64(b)), ADD[i * 3 + 2]);
        i = i + 1;
    }
    f
}

fn t_sub() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 384 {
        let a = SUB[i * 3];
        let b = SUB[i * 3 + 1];
        f = f + chkf64(2000 + (i as i32), to_bits_f64(from_bits_f64(a) - from_bits_f64(b)), SUB[i * 3 + 2]);
        i = i + 1;
    }
    f
}

fn t_mul() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 384 {
        let a = MUL[i * 3];
        let b = MUL[i * 3 + 1];
        f = f + chkf64(3000 + (i as i32), to_bits_f64(from_bits_f64(a) * from_bits_f64(b)), MUL[i * 3 + 2]);
        i = i + 1;
    }
    f
}

fn t_div() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 384 {
        let a = DIV[i * 3];
        let b = DIV[i * 3 + 1];
        f = f + chkf64(4000 + (i as i32), to_bits_f64(from_bits_f64(a) / from_bits_f64(b)), DIV[i * 3 + 2]);
        i = i + 1;
    }
    f
}

fn t_rem() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 384 {
        let a = REM[i * 3];
        let b = REM[i * 3 + 1];
        f = f + chkf64(5000 + (i as i32), to_bits_f64(from_bits_f64(a) % from_bits_f64(b)), REM[i * 3 + 2]);
        i = i + 1;
    }
    f
}

const NEG: [52]u64 = [
    0x0u64, 0x8000000000000000u64, 0x8000000000000000u64, 0x0u64, 0x3FF0000000000000u64, 0xBFF0000000000000u64,
    0xBFF0000000000000u64, 0x3FF0000000000000u64, 0x3FE0000000000000u64, 0xBFE0000000000000u64, 0x4000000000000000u64, 0xC000000000000000u64,
    0x4008000000000000u64, 0xC008000000000000u64, 0x7FEFFFFFFFFFFFFFu64, 0xFFEFFFFFFFFFFFFFu64, 0xFFEFFFFFFFFFFFFFu64, 0x7FEFFFFFFFFFFFFFu64,
    0x1u64, 0x8000000000000001u64, 0x8000000000000001u64, 0x1u64, 0xFFFFFFFFFFFFFu64, 0x800FFFFFFFFFFFFFu64,
    0x10000000000000u64, 0x8010000000000000u64, 0x7FF0000000000000u64, 0xFFF0000000000000u64, 0xFFF0000000000000u64, 0x7FF0000000000000u64,
    0x7FF8000000000000u64, 0xFFF8000000000000u64, 0x7FF0000000000001u64, 0xFFF0000000000001u64, 0xFFF8000000000000u64, 0x7FF8000000000000u64,
    0x3FD5555555555555u64, 0xBFD5555555555555u64, 0x3FB999999999999Au64, 0xBFB999999999999Au64, 0x400921FB54442D18u64, 0xC00921FB54442D18u64,
    0x4340000000000000u64, 0xC340000000000000u64, 0x4340000000000001u64, 0xC340000000000001u64, 0x3FF0000000000001u64, 0xBFF0000000000001u64,
    0x3CA0000000000000u64, 0xBCA0000000000000u64, 0x3C9FFFFFFFFFFFFFu64, 0xBC9FFFFFFFFFFFFFu64,
];

fn t_neg() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 26 {
        let a = NEG[i * 2];
        f = f + chkf64(9000 + (i as i32), to_bits_f64(-from_bits_f64(a)), NEG[i * 2 + 1]);
        i = i + 1;
    }
    f
}

fn t_compound() -> i32 {
    let a: f64 = from_bits_f64(0xBFB0000000000000u64);
    let b: f64 = from_bits_f64(0x40331701205738D1u64);
    let mut x = a;
    let mut f: i32 = 0;
    x += b;
    f = f + chkf64(9100, to_bits_f64(x), 0x40330701205738D1u64);
    x = a;
    x -= b;
    f = f + chkf64(9101, to_bits_f64(x), 0xC0332701205738D1u64);
    x = a;
    x *= b;
    f = f + chkf64(9102, to_bits_f64(x), 0xBFF31701205738D1u64);
    x = a;
    x /= b;
    f = f + chkf64(9103, to_bits_f64(x), 0xBF6AD20D9BDEF6D8u64);
    x = a;
    x %= b;
    f = f + chkf64(9104, to_bits_f64(x), 0xBFB0000000000000u64);
    f
}

fn main() -> i32 {
    let mut f: i32 = 0;
    f = f + t_add();
    f = f + t_sub();
    f = f + t_mul();
    f = f + t_div();
    f = f + t_rem();
    f = f + t_neg();
    f = f + t_compound();
    if f == 0 {
        print("ok\n");
    }
    f
}
