// T458: IEEE-754 f64 arithmetic on the oracle: add, sub, mul, div, rem, neg over specials and random patterns.
// Expected bit patterns come from an independent reference (numpy hardware floats / exact rationals).

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }

// Bit-pattern access without intrinsics: the oracle and native read the same bytes through a punned pointer.
fn to_bits_f64(x: f64) -> u64 {
    let v = x;
    unsafe { *(address_of(v) as *const u64) }
}

fn from_bits_f64(b: u64) -> f64 {
    let v = b;
    unsafe { *(address_of(v) as *const f64) }
}

fn to_bits_f32(x: f32) -> u32 {
    let v = x;
    unsafe { *(address_of(v) as *const u32) }
}

fn from_bits_f32(b: u32) -> f32 {
    let v = b;
    unsafe { *(address_of(v) as *const f32) }
}

fn chk(id: i32, got: u64, want: u64) -> i32 {
    if got == want {
        return 0;
    }
    print("FAIL ");
    print_int(id as i64);
    print(" got ");
    print_int(got as i64);
    print(" want ");
    print_int(want as i64);
    print("\n");
    1
}

// A fresh NaN is equal to any NaN: the sign and payload of an arithmetic NaN are not observable (SPEC-41 AXS-FLT-002).
fn chkf64(id: i32, got: u64, want: u64) -> i32 {
    if (got & 0x7FFFFFFFFFFFFFFFu64) > 0x7FF0000000000000u64 && (want & 0x7FFFFFFFFFFFFFFFu64) > 0x7FF0000000000000u64 {
        return 0;
    }
    chk(id, got, want)
}

fn chkf32(id: i32, got: u64, want: u64) -> i32 {
    if (got & 0x7FFFFFFFu64) > 0x7F800000u64 && (want & 0x7FFFFFFFu64) > 0x7F800000u64 {
        return 0;
    }
    chk(id, got, want)
}

