    0x3CF77D71u64, 0xBD38FAD2u64, 0x3CF77D71u64, 0x433499C7u64, 0x408C86D4u64, 0x3F0D0760u64,
    0x6E695440u64, 0x7A6DBFC6u64, 0x6E695440u64, 0x3C941A12u64, 0x18E9373u64, 0x18B54F3u64,
    0x0u64, 0xBF12EC89u64, 0x0u64, 0xE5B51FAEu64, 0x418DC622u64, 0xC1822EA4u64,
    0xC37A7870u64, 0x300123BAu64, 0xAFA53314u64, 0x3CF72D6Eu64, 0x40000000u64, 0x3CF72D6Eu64,
    0x806B7BACu64, 0x4172E8DEu64, 0x806B7BACu64, 0xC9A6498Du64, 0xF862EE0Bu64, 0xC9A6498Du64,
    0xC369AEB1u64, 0x8167379Eu64, 0x81190926u64, 0xC32800A4u64, 0x7B244637u64, 0xC32800A4u64,
    0x80147ACAu64, 0x3B924656u64, 0x80147ACAu64, 0xB6E44400u64, 0xB1FD1410u64, 0xB198AA50u64,
    0x80E8EA4Du64, 0xBE6DF155u64, 0x80E8EA4Du64, 0xBC26F86Cu64, 0x3F188360u64, 0xBC26F86Cu64,
];

fn t_add() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 384 {
        let a = ADD[i * 3] as u32;
        let b = ADD[i * 3 + 1] as u32;
        f = f + chkf32(1000 + (i as i32), to_bits_f32(from_bits_f32(a) + from_bits_f32(b)) as u64, ADD[i * 3 + 2]);
        i = i + 1;
    }
    f
}

fn t_sub() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 384 {
        let a = SUB[i * 3] as u32;
        let b = SUB[i * 3 + 1] as u32;
        f = f + chkf32(2000 + (i as i32), to_bits_f32(from_bits_f32(a) - from_bits_f32(b)) as u64, SUB[i * 3 + 2]);
        i = i + 1;
    }
    f
}

fn t_mul() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 384 {
        let a = MUL[i * 3] as u32;
        let b = MUL[i * 3 + 1] as u32;
        f = f + chkf32(3000 + (i as i32), to_bits_f32(from_bits_f32(a) * from_bits_f32(b)) as u64, MUL[i * 3 + 2]);
        i = i + 1;
    }
    f
}

fn t_div() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 384 {
        let a = DIV[i * 3] as u32;
        let b = DIV[i * 3 + 1] as u32;
        f = f + chkf32(4000 + (i as i32), to_bits_f32(from_bits_f32(a) / from_bits_f32(b)) as u64, DIV[i * 3 + 2]);
        i = i + 1;
    }
    f
}

fn t_rem() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 384 {
        let a = REM[i * 3] as u32;
        let b = REM[i * 3 + 1] as u32;
        f = f + chkf32(5000 + (i as i32), to_bits_f32(from_bits_f32(a) % from_bits_f32(b)) as u64, REM[i * 3 + 2]);
        i = i + 1;
    }
    f
}

const NEG: [52]u64 = [
    0x0u64, 0x80000000u64, 0x80000000u64, 0x0u64, 0x3F800000u64, 0xBF800000u64,
    0xBF800000u64, 0x3F800000u64, 0x3F000000u64, 0xBF000000u64, 0x40000000u64, 0xC0000000u64,
    0x40400000u64, 0xC0400000u64, 0x7F7FFFFFu64, 0xFF7FFFFFu64, 0xFF7FFFFFu64, 0x7F7FFFFFu64,
    0x1u64, 0x80000001u64, 0x80000001u64, 0x1u64, 0x7FFFFFu64, 0x807FFFFFu64,
    0x800000u64, 0x80800000u64, 0x7F800000u64, 0xFF800000u64, 0xFF800000u64, 0x7F800000u64,
    0x7FC00000u64, 0xFFC00000u64, 0x7F800001u64, 0xFF800001u64, 0xFFC00000u64, 0x7FC00000u64,
    0x3EAAAAABu64, 0xBEAAAAABu64, 0x3DCCCCCDu64, 0xBDCCCCCDu64, 0x40490FDBu64, 0xC0490FDBu64,
    0x4B800000u64, 0xCB800000u64, 0x4B800001u64, 0xCB800001u64, 0x3F800001u64, 0xBF800001u64,
    0x33800000u64, 0xB3800000u64, 0x337FFFFFu64, 0xB37FFFFFu64,
];

fn t_neg() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 26 {
        let a = NEG[i * 2] as u32;
        f = f + chkf32(9000 + (i as i32), to_bits_f32(-from_bits_f32(a)) as u64, NEG[i * 2 + 1]);
        i = i + 1;
    }
    f
}

fn t_compound() -> i32 {
    let a: f32 = from_bits_f32(0x3DB28993u32);
    let b: f32 = from_bits_f32(0x41902B9Cu32);
    let mut x = a;
    let mut f: i32 = 0;
    x += b;
    f = f + chkf32(9100, to_bits_f32(x) as u64, 0x4190DE26u64);
    x = a;
    x -= b;
    f = f + chkf32(9101, to_bits_f32(x) as u64, 0xC18F7912u64);
    x = a;
    x *= b;
    f = f + chkf32(9102, to_bits_f32(x) as u64, 0x3FC91799u64);
    x = a;
    x /= b;
    f = f + chkf32(9103, to_bits_f32(x) as u64, 0x3B9E832Cu64);
    x = a;
    x %= b;
    f = f + chkf32(9104, to_bits_f32(x) as u64, 0x3DB28993u64);
    f
}

fn main() -> i32 {
    let mut f: i32 = 0;
    f = f + t_add();
    f = f + t_sub();
    f = f + t_mul();
    f = f + t_div();
    f = f + t_rem();
    f = f + t_neg();
    f = f + t_compound();
    if f == 0 {
        print("ok\n");
    }
    f
}
