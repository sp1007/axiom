fn t_i2f_i8() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 16 {
        let v: i8 = (I2F_I8[i * 3] as i8);
        f = f + chk(0 + (i as i32), to_bits_f64(v as f64), I2F_I8[i * 3 + 3 - 2]);
        f = f + chk(500 + (i as i32), to_bits_f32(v as f32) as u64, I2F_I8[i * 3 + 3 - 1]);
        i = i + 1;
    }
    f
}

