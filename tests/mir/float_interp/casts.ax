    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 106 {
        let v: i64 = (I2F_I64[i * 3] as i64);
        f = f + chk(3000 + (i as i32), to_bits_f64(v as f64), I2F_I64[i * 3 + 3 - 2]);
        f = f + chk(3500 + (i as i32), to_bits_f32(v as f32) as u64, I2F_I64[i * 3 + 3 - 1]);
        i = i + 1;
    }
    f
}

