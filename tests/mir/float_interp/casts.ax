fn t_convert() -> i32 {
    let mut f: i32 = 0;
    let mut i: usize = 0;
    while i < 87 {
        f = f + chk(36000 + (i as i32), to_bits_f32(from_bits_f64(CONV_NARROW[i * 2]) as f32) as u64, CONV_NARROW[i * 2 + 1]);
        i = i + 1;
    }
    i = 0;
    while i < 65 {
        f = f + chk(36500 + (i as i32), to_bits_f64(from_bits_f32(CONV_WIDEN[i * 2] as u32) as f64), CONV_WIDEN[i * 2 + 1]);
        i = i + 1;
    }
    f
}

