// test: helper

fn pattern_d(b8: u8, s8: i8, u16v: u16, s32: i32, s64: i64) -> i64 {
    // REQ-OWNER-007 Pattern D: compound multi-width integer expression lowered via explicit MIR_RVALUE_CAST
    let total: i64 = (s64 + s32 * 3) - (u16v + b8 * 2 + s8 - 7) / (4 - s8);
    return total;
}

fn pattern_shift_and_index(mask: u32, sh: u8, delta: i16, step: i8, scale: i64) -> i64 {
    let arr: [4]i16 = [10i16, 20i16, 30i16, 40i16];
    let elem: i16 = arr[sh];
    let res: i64 = (((mask >> sh) & 0x3F) + delta * step + elem - 5) * scale / ((1 << sh) + 3);
    return res;
}

fn test_sat_and_promote(a: i32, b: i8, u: u8, x: i128, y: u128) -> i128 {
    let s1: i32 = a.saturating_add(10i32);
    let s2: i32 = s1.saturating_sub(3i32);
    let s3: i32 = s2.saturating_mul(2i32);
    let w1: i32 = a + b;
    let w2: i32 = u + b;
    let arr: [4]i32 = [1, 2, 3, 4];
    let idx_val: i32 = arr[u];
    let z: u128 = y.saturating_add(1u128);
    let _ = z;
    let pd: i64 = pattern_d(200u8, -50i8, 500u16, -2000i32, 100000i64);
    let ps: i64 = pattern_shift_and_index(0xFFu32, 1u8, 10i16, 2i8, 3i64);
    return x + (w1 as i128) + (w2 as i128) + (s3 as i128) + (idx_val as i128) + pd + ps;
}

fn main() -> i32 {
    let _ = test_sat_and_promote(1i32, 2i8, 0u8, 100i128, 200u128);
    return 0;
}
