// test: helper

fn shift_u128_i8(x: u128, s: i8) -> u128 {
    x << s
}

fn shift_i128_i8(x: i128, s: i8) -> i128 {
    x >> s
}

fn shift_u128_u8(x: u128, s: u8) -> u128 {
    x << s
}

fn main() -> i32 {
    let a: u128 = shift_u128_i8(1u128, 100i8);
    let b: i128 = shift_i128_i8(-256i128, 4i8);
    let c: u128 = shift_u128_u8(1u128, 100u8);
    if a == c && b == -16i128 { 0i32 } else { 1i32 }
}
