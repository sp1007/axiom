cmd: {compiler} inspect --emit=mir tests/mir/int128/saturating_roundtrip.mir
# T451: SatAdd / SatSub / SatMul print and parse back in the same function-like form.
stdout: mir_body {\n    let _0: type#8;\n    let _1: type#8;\n    let _2: type#8;\n    bb0: {\n        _0 = SatAdd(copy _1, copy _2);\n        _0 = SatSub(copy _0, const 1);\n        _0 = SatMul(copy _0, copy _2);\n        return;\n    }\n}\n
