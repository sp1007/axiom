// test: helper

struct Packet {
    b8: u8,
    s8: i8,
}

impl Packet {
    const HI: u128 = (1u128 << 80) + 7u128;
}

const C_I128: i128 = 42i128;
const C_I128_NEG_WIDE: i128 = -18446744073709551617i128;
const C_U128_WIDE: u128 = (u64.MAX as u128) + 777u128;
const C_U128_B: u128 = 99u128;

fn match_high_128(x: u128) -> i32 {
    match x {
        0u128 => 1i32,
        18446744073709551616u128 => 2i32,
        18446744073709551617..=340282366920938463463374607431768211455 => 3i32,
        _ => 4i32,
    }
}

fn promote_leaves_and_unary(p: Packet, s64: i64) -> i64 {
    let a: i64 = s64 + p.b8 * 2 + (-p.s8 * 3);
    return a;
}

fn const_recv_mir() -> u128 {
    let a: i128 = C_I128.saturating_add(C_I128_NEG_WIDE);
    let b: u128 = C_U128_B.saturating_mul(2u128);
    let c: u128 = Packet.HI;
    return C_U128_WIDE + (a as u128) + b + c;
}

fn main() -> i32 {
    let p = Packet { b8: 200u8, s8: -128i8 };
    let v1: i32 = match_high_128(const_recv_mir());
    let v2: i64 = promote_leaves_and_unary(p, 1000i64);
    return v1 + (v2 as i32);
}
