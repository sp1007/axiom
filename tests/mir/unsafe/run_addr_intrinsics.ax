// test: run
// modes: interp native
// stdout: 7 8 1 1 1 1 1 1\n
// T501 (REQ-OWNER-008, SPEC-55 AXS-ADR-010, AXS-ADR-012): fn_addr / static_addr / addr_of / `f as usize` return consistent
// addresses; distinct functions and statics have distinct addresses; the address of a field or element is inside its owner.

module main

@intrinsic fn fn_addr<F>(f: F) -> usize { 0 }
@intrinsic fn static_addr<S>(s: S) -> usize { 0 }
@intrinsic fn addr_of<T>(x: T) -> usize { 0 }

static mut BUF: [4]u32 = [10u32, 20u32, 30u32, 40u32];
static OTHER: u32 = 3u32;

fn foo() -> i32 {
    7
}

fn bar() -> i32 {
    8
}

fn flag(b: bool) -> i32 {
    if b { 1 } else { 0 }
}

pub fn main() -> i32 {
    let a: usize = fn_addr(foo);
    let b: usize = foo as usize;
    let c: usize = fn_addr(bar);
    let f: fn() -> i32 = bar;
    let d: usize = f as usize;
    let s: usize = static_addr(BUF);
    let o: usize = static_addr(OTHER);
    let e2: usize = unsafe { addr_of(BUF[2]) };
    let local: u32 = 9u32;
    let l: usize = addr_of(local);

    print_int(foo() as i64);
    print(" ");
    print_int(bar() as i64);
    print(" ");
    print_int(flag(a == b && a != c) as i64);
    print(" ");
    print_int(flag(c == d) as i64);
    print(" ");
    print_int(flag(s != o && s != 0) as i64);
    print(" ");
    print_int(flag(e2 == s + 8) as i64);
    print(" ");
    print_int(flag(l != 0 && l != s) as i64);
    print(" ");
    print_int(flag(addr_of(BUF) == s) as i64);
    print("\n");
    0
}
