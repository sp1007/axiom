// test: helper
// T501 (SPEC-55 AXS-ADR-010): MIR of the address intrinsics. A function address is a pointer-to-integer cast of the function
// constant; a place address is a shared borrow into a raw-pointer temporary followed by the same cast.

@intrinsic fn fn_addr<F>(f: F) -> usize { 0 }
@intrinsic fn static_addr<S>(s: S) -> usize { 0 }
@intrinsic fn addr_of<T>(x: T) -> usize { 0 }

static mut TABLE: [4]u32 = [1u32, 2u32, 3u32, 4u32];

fn target() -> i32 {
    5
}

fn function_addresses() -> usize {
    let a: usize = fn_addr(target);
    let b: usize = target as usize;
    a + b
}

fn static_address() -> usize {
    static_addr(TABLE)
}

fn place_address() -> usize {
    let arr: [4]u32 = [0u32, 0u32, 0u32, 0u32];
    addr_of(arr[2])
}

pub fn main() -> i32 {
    0
}
