// test: run
// modes: interp native
// stdout: 20 77 78 1 1\n
// T501 (REQ-OWNER-008, SPEC-55 AXS-ADR-011/012): block-scope `@addr(base + offset)` bindings whose address is computed at run time
// from `static_addr` / `fn_addr`; reads and writes through the binding act on the object at that address, and
// `static_addr` / `addr_of` of the binding return the bound address (round-trip identity).

module main

@intrinsic fn fn_addr<F>(f: F) -> usize { 0 }
@intrinsic fn static_addr<S>(s: S) -> usize { 0 }
@intrinsic fn addr_of<T>(x: T) -> usize { 0 }

static mut BUF: [4]u32 = [10u32, 20u32, 30u32, 40u32];

fn flag(b: bool) -> i32 {
    if b { 1 } else { 0 }
}

pub fn main() -> i32 {
    let base: usize = static_addr(BUF);
    // the second element of BUF, bound as an ordinary variable at base + 4
    @addr(base + 4) unsafe static mut ELEM1: u32;
    // a binding with an initialiser: stores 77 at base + 8 (the third element)
    @addr(base + 8) unsafe static mut ELEM2: u32 = 77u32;
    unsafe {
        print_int(ELEM1 as i64);
        print(" ");
        print_int(BUF[2] as i64);
        print(" ");
        ELEM1 = 78u32;
        print_int(BUF[1] as i64);
        print(" ");
    }
    print_int(flag(static_addr(ELEM1) == base + 4) as i64);
    print(" ");
    print_int(flag(addr_of(ELEM2) == base + 8) as i64);
    print("\n");
    0
}
