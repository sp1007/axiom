// test: helper
// T501 (SPEC-55 AXS-ADR-011/020): MIR of fixed-address declarations. Every use of an overlay is a place rooted at the dereference
// of an integer-to-pointer cast of the address; a block-scope declaration evaluates its address once into a hidden slot.

const BASE: usize = 0x4000_0000;

@repr(C)
struct Regs {
    pub ctrl: u32,
    pub data: u32,
}

@addr(0x4000_1000) unsafe static mut UART0: Regs;
@at(BASE + 0x2000) unsafe static mut SCRATCH: u32;

fn item_overlays() -> u32 {
    unsafe {
        UART0.ctrl = 1u32;
        SCRATCH = UART0.ctrl + 2u32;
        SCRATCH
    }
}

fn local_overlay(base: usize) -> u32 {
    unsafe {
        @addr(base + 0x100) let mut reg: u32;
        reg = 7u32;
        reg + 1u32
    }
}

pub fn main() -> i32 {
    0
}
