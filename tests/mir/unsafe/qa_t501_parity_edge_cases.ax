// test: run
// modes: interp native
// stdout: 1 1 1 99 142 1 1 1\n
// T501 QA adversarial parity test: exercises address_of(v) as usize, address_of_mut(v),
// raw-pointer-to-view/mut_view across unsafe boundaries, @at(dynamic_expr) struct overlay,
// and fn-pointer fn_addr/as-usize parity across interp, native -O0, and native -O1.

module main

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic fn fn_addr<F>(f: F) -> usize { 0 }
@intrinsic fn static_addr<S>(s: S) -> usize { 0 }
@intrinsic fn addr_of<T>(x: T) -> usize { 0 }

@repr(C)
struct Pair {
    pub a: u32,
    pub b: u32,
}

static mut PAIR_STORAGE: Pair = Pair { a: 40u32, b: 2u32 };

fn inc(x: i32) -> i32 {
    x + 1
}

fn flag(b: bool) -> i32 {
    if b { 1 } else { 0 }
}

pub fn main() -> i32 {
    // 1. address_of(v) as usize == addr_of(v) on local and static
    let mut local_val: u32 = 12u32;
    let p_local_const: *const u32 = unsafe { address_of(local_val) };
    let p_local_mut: *mut u32 = unsafe { address_of_mut(local_val) };
    let eq_local: bool = (p_local_const as usize) == addr_of(local_val) &&
                         (p_local_mut as usize) == addr_of(local_val);

    // 2. Mutate via raw-pointer-derived mut_view<u32>, then read via view<u32> after leaving unsafe
    let mv: mut_view<u32> = unsafe { mut_view(*p_local_mut) };
    *mv = 99u32;
    let rv: view<u32> = unsafe { view(*p_local_const) };
    let read_back: u32 = *rv;

    // 3. Dynamic @at(base) struct overlay over PAIR_STORAGE inside unsafe block
    let base: usize = static_addr(PAIR_STORAGE);
    let mut sum_pair: u32 = 0u32;
    let mut eq_overlay_addr: bool = false;
    let mut eq_field_offset: bool = false;
    unsafe {
        @at(base) let mut reg: Pair;
        reg.b = 102u32;
        sum_pair = reg.a + reg.b;
        eq_overlay_addr = static_addr(reg) == base && addr_of(reg) == base;
        eq_field_offset = addr_of(reg.b) == base + 4;
    }

    // 4. Function item & fn-pointer address parity
    let fp: fn(i32) -> i32 = inc;
    let fn_parity: bool = fn_addr(inc) == (inc as usize) &&
                          fn_addr(fp) == (fp as usize) &&
                          fn_addr(fp) == fn_addr(inc) &&
                          fn_addr(inc) != 0;

    let static_pair_eq: bool = unsafe { (address_of(PAIR_STORAGE) as usize) == base };
    let field_eq: bool = unsafe { addr_of(PAIR_STORAGE.b) == base + 4 };

    print_int(flag(eq_local) as i64);
    print(" ");
    print_int(flag(static_pair_eq) as i64);
    print(" ");
    print_int(flag(field_eq) as i64);
    print(" ");
    print_int(read_back as i64);
    print(" ");
    print_int(sum_pair as i64);
    print(" ");
    print_int(flag(eq_overlay_addr) as i64);
    print(" ");
    print_int(flag(eq_field_offset) as i64);
    print(" ");
    print_int(flag(fn_parity) as i64);
    print("\n");
    0
}
