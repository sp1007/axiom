cmd: {compiler} inspect --emit=mir-opt -O1 --std-root {std_root} {test_dir}/atomic_opt_preserved.ax
stdout-contains: atomic_load SeqCst
stdout-contains: atomic_store SeqCst
stdout-contains: atomic_rmw add Relaxed
stdout-contains: atomic_fence Acquire
stdout-contains: compiler_fence Release
stdout-contains: spin_loop_hint
