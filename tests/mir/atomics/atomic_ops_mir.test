cmd: {compiler} inspect --emit=mir --std-root {std_root} {test_dir}/atomic_ops_mir.ax
stdout-contains: atomic_load Acquire
stdout-contains: atomic_store Release
stdout-contains: atomic_rmw xchg AcqRel
stdout-contains: atomic_rmw add SeqCst
stdout-contains: atomic_rmw sub Relaxed
stdout-contains: atomic_rmw and Relaxed
stdout-contains: atomic_rmw or Relaxed
stdout-contains: atomic_rmw xor Relaxed
stdout-contains: atomic_cmpxchg AcqRel Acquire
stdout-contains: atomic_cmpxchg_weak Release Relaxed
stdout-contains: atomic_fence SeqCst
stdout-contains: compiler_fence Acquire
stdout-contains: spin_loop_hint
