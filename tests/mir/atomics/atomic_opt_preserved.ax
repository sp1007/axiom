// test: helper

fn keep_side_effects(a: view<AtomicI32>) {
    let _unused_load = a.load(Ordering.SeqCst);
    a.store(7i32, Ordering.SeqCst);
    let _unused_rmw = a.fetch_add(1i32, Ordering.Relaxed);
    fence(Ordering.Acquire);
    compiler_fence(Ordering.Release);
    spin_loop_hint();
}

fn main() {
    let a = AtomicI32.new(0i32);
    keep_side_effects(view(a));
}
