// test: helper

fn exercise_atomics(a: view<AtomicU64>) -> u64 {
    let v0 = a.load(Ordering.Acquire);
    a.store(v0, Ordering.Release);
    let v1 = a.swap(10u64, Ordering.AcqRel);
    let v2 = a.fetch_add(1u64, Ordering.SeqCst);
    let v3 = a.fetch_sub(1u64, Ordering.Relaxed);
    let v4 = a.fetch_and(0xffu64, Ordering.Relaxed);
    let v5 = a.fetch_or(0x10u64, Ordering.Relaxed);
    let v6 = a.fetch_xor(0x01u64, Ordering.Relaxed);
    let r1 = a.compare_exchange(v1, v2, Ordering.AcqRel, Ordering.Acquire);
    let r2 = a.compare_exchange_weak(v3, v4, Ordering.Release, Ordering.Relaxed);
    fence(Ordering.SeqCst);
    compiler_fence(Ordering.Acquire);
    spin_loop_hint();
    if r1.ok && r2.ok {
        v5
    } else {
        v6
    }
}

fn main() {
    let a = AtomicU64.new(42u64);
    let _ = exercise_atomics(view(a));
    let _ = a.into_inner();
}
