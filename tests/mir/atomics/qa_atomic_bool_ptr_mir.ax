// test: helper

fn owned_bool_and_ptr_ops(raw: *mut i32) -> bool {
    let b = AtomicBool.new(false);
    let _ = b.fetch_xor(true, Ordering.AcqRel);
    let _ = b.compare_exchange(true, false, Ordering.SeqCst, Ordering.Acquire);

    let p: Atomic<*mut i32> = Atomic.new(raw);
    let cur = p.load(Ordering.Acquire);
    p.store(cur, Ordering.Release);
    let _ = p.swap(raw, Ordering.SeqCst);
    let _ = p.compare_exchange_weak(cur, raw, Ordering.AcqRel, Ordering.Relaxed);

    is_lock_free<u64>() && b.load(Ordering.Relaxed)
}

fn main() {
    let p: *mut i32 = 0 as *mut i32;
    let _ = owned_bool_and_ptr_ops(p);
}
