cmd: {compiler} inspect --emit=mir {test_dir}/atomic_roundtrip.mir
stdout: mir_body {\n    let _0: type#2;\n    let _1: type#14;\n    let _2: type#14;\n    bb0: {\n        _1 = const 42;\n        _2 = atomic_load Acquire copy _1;\n        atomic_store Release copy _1, copy _2;\n        _2 = atomic_rmw add SeqCst copy _1, const 1;\n        atomic_fence SeqCst;\n        compiler_fence Acquire;\n        spin_loop_hint;\n        return;\n    }\n}\n
