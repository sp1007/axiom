# T423f (QA): --force disables seeded mode, so the seeded-A fallback never applies.
cmd: python {test_dir}/driver.py force_never_seeds_or_falls_back
cache-inputs: tools/build_axiomc.py tools/bootstrap.py tests/tools/build_axiomc_fallback/driver.py
timeout: 60
exit: 0
stdout: OK force_never_seeds_or_falls_back\n
