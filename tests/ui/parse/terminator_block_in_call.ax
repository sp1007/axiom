// test: ui
// T146 QA: `{` pushes newline mode ON also inside `(` (AXS-GRM-010), so the terminator rule (AXS-GRM-011)
// applies to statements of a block passed as a call argument; before T146 `let b = 2` was dropped silently.
fn id(x: i32) -> i32 { x }

fn main() -> i32 {
    id({ let a = 1 let b = 2    //~ ERROR AX_PARSE_EXPECTED_TERMINATOR
        a + b })
}
