// test: ui
// AXS-GRM-011: every member of an impl, trait or extern block is followed by a terminator.
struct S { x: i32 }

impl S { fn a(self: view<S>) -> i32 { 1 } fn b(self: view<S>) -> i32 { 2 } }    //~ ERROR AX_PARSE_EXPECTED_TERMINATOR

trait Tr { fn a(self: view<Self>) -> i32 fn b(self: view<Self>) -> i32 }    //~ ERROR AX_PARSE_EXPECTED_TERMINATOR

extern "C" { fn f() fn g() }    //~ ERROR AX_PARSE_EXPECTED_TERMINATOR

fn main() -> i32 { return 0 }
