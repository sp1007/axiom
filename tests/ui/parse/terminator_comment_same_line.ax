// test: ui
// T146 QA: a block comment without a line feed is not a line break (AXS-LEX-013), so two statements
// separated only by `/* ... */` on one line still need `;` (AXS-GRM-011).
fn main() -> i32 {
    let a = 3 /* same line */ let b = 4    //~ ERROR AX_PARSE_EXPECTED_TERMINATOR
    a + b
}
