// test: ui
// AXS-GRM-011: a block-like statement (`if { }`) is followed by a terminator too; there is no exemption.
// The `return 6` after it used to be dropped without a diagnostic.
fn f(c: bool) -> i32 { if c { return 5; } return 6; }    //~ ERROR AX_PARSE_EXPECTED_TERMINATOR

fn main() -> i32 {
    return f(false)
}
