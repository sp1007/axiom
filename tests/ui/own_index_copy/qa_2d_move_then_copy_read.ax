// test: ui
// stderr-contains: qa_2d_move_then_copy_read.ax:26:5
// QA (T498b gate): array of arrays: moving `g[0][1]` then reading the Copy field `g[1][0].n` is a use after move.

struct H {
    n: i32,
    name: str,
    f: fn(i32) -> i32,
}

fn inc(x: i32) -> i32 {
    x + 1
}

fn mk() -> H {
    H { n: 1, name: "a", f: inc }
}

fn take(h: H) -> i32 {
    h.n
}

fn main() -> i32 {
    let g: [2][2]H = [[mk(), mk()], [mk(), mk()]];
    let x = g[0][1];
    g[1][0].n + x.n //~ ERROR AX_MOVE_USE_AFTER_MOVE
}
