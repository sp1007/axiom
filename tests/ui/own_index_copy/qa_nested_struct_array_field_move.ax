// test: ui
// stderr-contains: qa_nested_struct_array_field_move.ax:31:5
// QA (T498b gate): the array is a field (`w.hs`): a non-Copy move through `w.hs[0].name` then a Copy read `w.hs[1].n` is rejected.

struct H {
    n: i32,
    name: str,
    f: fn(i32) -> i32,
}

fn inc(x: i32) -> i32 {
    x + 1
}

fn mk() -> H {
    H { n: 1, name: "a", f: inc }
}

fn take(h: H) -> i32 {
    h.n
}

struct W {
    hs: [2]H,
    k: i32,
}

fn main() -> i32 {
    let w = W { hs: [mk(), mk()], k: 1 };
    let s = w.hs[0].name;
    w.hs[1].n //~ ERROR AX_MOVE_USE_AFTER_MOVE
}
