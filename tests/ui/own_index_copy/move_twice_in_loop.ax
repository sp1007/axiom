// test: ui
// stderr-contains: move_twice_in_loop.ax:19:13
// T498b (SPEC-10 AXS-OWN-003): a non-Copy element moved out through an index inside a loop is a use after
// move: on the second iteration the Copy read `hs[i].n` already sees the array moved by `take(hs[i])`.

struct H {
    n: i32,
    name: str,
}

fn take(h: H) -> i32 {
    h.n
}

fn main() -> i32 {
    let hs: [2]H = [H { n: 1, name: "a" }, H { n: 2, name: "b" }];
    let mut i: usize = 0;
    let mut s = 0;
    while i < 2 {
        s = s + hs[i].n; //~ ERROR AX_MOVE_USE_AFTER_MOVE
        s = s + take(hs[i]);
        i = i + 1;
    }
    s
}
