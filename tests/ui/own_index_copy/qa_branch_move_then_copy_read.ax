// test: ui
// stderr-contains: qa_branch_move_then_copy_read.ax:29:5
// QA (T498b gate): a move out of an indexed element in one branch makes a Copy read after the join a use after move.

struct H {
    n: i32,
    name: str,
    f: fn(i32) -> i32,
}

fn inc(x: i32) -> i32 {
    x + 1
}

fn mk() -> H {
    H { n: 1, name: "a", f: inc }
}

fn take(h: H) -> i32 {
    h.n
}

fn main() -> i32 {
    let hs: [2]H = [mk(), mk()];
    let c = true;
    if c {
        let x = hs[0];
    }
    hs[1].n //~ ERROR AX_MOVE_USE_AFTER_MOVE
}
