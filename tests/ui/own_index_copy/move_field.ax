// test: ui
// stderr-contains: move_field.ax:14:17
// T498b (SPEC-10 AXS-OWN-003, REQ-OWN-049): moving a non-Copy field (`str`) out through an index still
// moves the whole array; a Copy field read before the move is fine.

struct H {
    n: i32,
    name: str,
}

fn main() -> i32 {
    let hs: [2]H = [H { n: 1, name: "a" }, H { n: 2, name: "b" }];
    let k = hs[0].n + hs[1].n;
    let g = hs[0].name;
    let again = hs; //~ ERROR AX_MOVE_USE_AFTER_MOVE
    k
}
