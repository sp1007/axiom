// test: ui
// stderr-contains: qa_partial_name_then_copy_read.ax:26:5
// QA (T498b gate): a non-Copy field moved out through `hs[0].name` moves the array; a Copy read `hs[1].n` afterwards is rejected.

struct H {
    n: i32,
    name: str,
    f: fn(i32) -> i32,
}

fn inc(x: i32) -> i32 {
    x + 1
}

fn mk() -> H {
    H { n: 1, name: "a", f: inc }
}

fn take(h: H) -> i32 {
    h.n
}

fn main() -> i32 {
    let hs: [2]H = [mk(), mk()];
    let s = hs[0].name;
    hs[1].n //~ ERROR AX_MOVE_USE_AFTER_MOVE
}
