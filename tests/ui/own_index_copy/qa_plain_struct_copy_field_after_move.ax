// test: ui
// stderr-contains: qa_plain_struct_copy_field_after_move.ax:26:13
// QA (T498b gate): COPY-vs-MOVE decision guard: a non-Copy struct (no index) moved by value (the MIR operand is COPY) still makes a later Copy-field read a use after move.

struct H {
    n: i32,
    name: str,
    f: fn(i32) -> i32,
}

fn inc(x: i32) -> i32 {
    x + 1
}

fn mk() -> H {
    H { n: 1, name: "a", f: inc }
}

fn take(h: H) -> i32 {
    h.n
}

fn main() -> i32 {
    let h = mk();
    let a = h;
    let g = h.f; //~ ERROR AX_MOVE_USE_AFTER_MOVE
    a.n
}
