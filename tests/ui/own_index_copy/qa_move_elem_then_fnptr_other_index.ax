// test: ui
// stderr-contains: qa_move_elem_then_fnptr_other_index.ax:27:13
// QA (T498b gate): after `hs[0]` is moved out, a fn-pointer read through another index `hs[j].f` is still a use after move.

struct H {
    n: i32,
    name: str,
    f: fn(i32) -> i32,
}

fn inc(x: i32) -> i32 {
    x + 1
}

fn mk() -> H {
    H { n: 1, name: "a", f: inc }
}

fn take(h: H) -> i32 {
    h.n
}

fn main() -> i32 {
    let hs: [2]H = [mk(), mk()];
    let x = hs[0];
    let j: usize = 1;
    let g = hs[j].f; //~ ERROR AX_MOVE_USE_AFTER_MOVE
    g(1) + x.n
}
