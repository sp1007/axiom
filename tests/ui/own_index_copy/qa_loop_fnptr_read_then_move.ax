// test: ui
// stderr-contains: qa_loop_fnptr_read_then_move.ax:27:17
// QA (T498b gate): in a loop, a fn-pointer read `hs[i].f` followed by a move `take(hs[i])` fails on the next iteration.

struct H {
    n: i32,
    name: str,
    f: fn(i32) -> i32,
}

fn inc(x: i32) -> i32 {
    x + 1
}

fn mk() -> H {
    H { n: 1, name: "a", f: inc }
}

fn take(h: H) -> i32 {
    h.n
}

fn main() -> i32 {
    let hs: [2]H = [mk(), mk()];
    let mut i: usize = 0;
    while i < 2 {
        let a = hs[i].f; //~ ERROR AX_MOVE_USE_AFTER_MOVE
        let t = take(hs[i]);
        i = i + 1;
    }
    0
}
