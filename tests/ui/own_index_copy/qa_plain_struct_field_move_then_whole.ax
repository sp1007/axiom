// QA (T498b gate): no index: moving a non-Copy field then the whole struct is a use after move.

struct H {
    n: i32,
    name: str,
    f: fn(i32) -> i32,
}

fn inc(x: i32) -> i32 {
    x + 1
}

fn mk() -> H {
    H { n: 1, name: "a", f: inc }
}

fn take(h: H) -> i32 {
    h.n
}

fn main() -> i32 {
    let h = mk();
    let s = h.name;
    let a = h; //~ ERROR AX_MOVE_USE_AFTER_MOVE
    0
}
