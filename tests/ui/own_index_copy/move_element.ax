// test: ui
// stderr-contains: move_element.ax:13:13
// T498b (SPEC-10 AXS-OWN-003, REQ-OWN-049): moving a non-Copy element out through an index still moves
// the whole array (no element-level tracking before v1), so a later use of the array is rejected.

struct H {
    n: i32,
    name: str,
}

fn main() -> i32 {
    let hs: [2]H = [H { n: 1, name: "a" }, H { n: 2, name: "b" }];
    let x = hs[0];
    let y = hs[1].n; //~ ERROR AX_MOVE_USE_AFTER_MOVE
    x.n + y
}
