cmd: {compiler} inspect --emit=mi tests/ui/backend_ice/sat_u128_lowered.mir
exit: 0
# T453 (formerly the T481a ICE check): 128-bit SatAdd selects ADD/ADC and clamps to u128.MAX with CMOVB.
stdout-contains: adc rdx, [frame#
stdout-contains: mov r8, -1
stdout-contains: cmovcc 2, rax, r8
stdout-contains: cmovcc 2, rdx, r8
