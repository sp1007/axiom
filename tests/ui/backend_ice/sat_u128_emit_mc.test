cmd: {compiler} inspect --emit=mc tests/ui/backend_ice/sat_u128_lowered.mir
exit: 0
# T453 / T498j: post-T498h frame layout uses sub rsp, 0x90 with 8B sret slot _0 at [rbp-0x10],
# copy _1 at [rbp-0x60]/[rbp-0x58], and copy _2 at [rbp-0x70]/[rbp-0x68].
# Pin prologue (sub rsp, 0x90) and full 128-bit SatAdd (add rax,[rbp-0x70]; adc rdx,[rbp-0x68]; mov r8,-1; cmovb rax,r8; cmovb rdx,r8).
stdout-contains: 48 81 ec 90 00 00 00
