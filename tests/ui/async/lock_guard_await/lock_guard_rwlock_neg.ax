// test: ui
// REQ-CONC-010, 017, 048, REQ-ASY-053: Reject RwLock*Guard held across .await.

struct RwLockReadGuard {
    dummy: i32,
}

async fn tick() -> i32 {
    1i32
}

async fn test_rwlock_read_guard_across_await() -> i32 {
    let g = RwLockReadGuard { dummy: 2 };
    let _ = tick().await; //~ ERROR AX_ASYNC_GUARD_ACROSS_AWAIT
    let _ = g.dummy;
    0i32
}

pub fn main() {}
