// test: ui
// REQ-CONC-010, 017, 048, REQ-ASY-053: Reject @no_suspend_hold struct held across .await.

@no_suspend_hold
struct UserCriticalSection {
    token: i32,
}

async fn tick() -> i32 {
    1i32
}

async fn test_no_suspend_hold_across_await() -> i32 {
    let cs = UserCriticalSection { token: 42 };
    let _ = tick().await; //~ ERROR AX_ASYNC_GUARD_ACROSS_AWAIT
    let _ = cs.token;
    0i32
}

pub fn main() {}
