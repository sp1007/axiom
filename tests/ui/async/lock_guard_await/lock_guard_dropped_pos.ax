// test: ui
// REQ-CONC-010, 017, 048, REQ-ASY-053: Synchronous lock guards dropped or scoped before .await are permitted.

struct MutexGuard {
    dummy: i32,
}

struct RwLockReadGuard {
    dummy: i32,
}

@no_suspend_hold
struct UserCriticalSection {
    token: i32,
}

fn release_mutex(_g: MutexGuard) {}
fn release_rwlock(_g: RwLockReadGuard) {}
fn release_cs(_cs: UserCriticalSection) {}

async fn tick() -> i32 {
    1i32
}

async fn test_guard_scoped() -> i32 {
    {
        let g = MutexGuard { dummy: 1 };
        let _ = g.dummy;
    }
    let r = tick().await;
    r + 10
}

async fn test_rwlock_scoped() -> i32 {
    {
        let g = RwLockReadGuard { dummy: 2 };
        let _ = g.dummy;
    }
    let r = tick().await;
    r + 20
}

async fn test_guard_moved_before_await() -> i32 {
    let g = MutexGuard { dummy: 100 };
    release_mutex(g);
    let r = tick().await;
    r
}

async fn test_cs_moved_before_await() -> i32 {
    let cs = UserCriticalSection { token: 55 };
    release_cs(cs);
    let r = tick().await;
    r
}

pub fn main() {}
