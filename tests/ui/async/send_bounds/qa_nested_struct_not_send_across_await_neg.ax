// test: ui
// REQ-ASY-042: Nested struct containing !Send field live across .await prevents Future from being Send.

struct InnerNotSend {
    ptr: *const u8,
}

struct OuterHolder {
    inner: InnerNotSend,
}

fn spawn<Fut: Future + Send>(_fut: Fut) -> i32 {
    0i32
}

async fn tick() -> i32 {
    1i32
}

async fn bad_nested_not_send_across_await() -> i32 {
    let holder = OuterHolder {
        inner: InnerNotSend {
            ptr: 0 as *const u8,
        },
    };
    let _ = tick().await;
    let _ = holder.inner.ptr;
    0i32
}

pub fn main() {
    let _ = spawn(bad_nested_not_send_across_await()); //~ ERROR AX_ASYNC_FUTURE_NOT_SEND
}
