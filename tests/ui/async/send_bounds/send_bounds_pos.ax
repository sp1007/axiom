// test: ui
// REQ-ASY-042: !Send local confined before .await does NOT disqualify Future from being Send.

fn spawn<Fut: Future + Send>(_fut: Fut) -> i32 {
    0i32
}

fn discard_ptr(_p: *const u8) {}

async fn tick() -> i32 {
    1i32
}

async fn good_scoped_ptr() -> i32 {
    {
        let p: *const u8 = 0 as *const u8;
        let _ = p;
    }
    let r = tick().await;
    r + 5
}

async fn good_moved_ptr() -> i32 {
    let p: *const u8 = 0 as *const u8;
    discard_ptr(p);
    let r = tick().await;
    r + 10
}

pub fn main() {
    let _ = spawn(good_scoped_ptr());
    let _ = spawn(good_moved_ptr());
}
