// test: ui
// REQ-ASY-028..031: view<T> and mut_view<T> permitted if confined before .await or borrowed after .await.

async fn tick() -> i32 {
    1i32
}

async fn view_confined_in_block() -> i32 {
    let mut data = 42i32;
    {
        let v: view<i32> = view(data);
        let _ = *v;
    }
    let r = tick().await;
    r + data
}

async fn mut_view_confined_in_block() -> i32 {
    let mut data = 42i32;
    {
        let mv: mut_view<i32> = mut_view(data);
        *mv = 100i32;
    }
    let r = tick().await;
    r + data
}

async fn view_reborrowed_after_await() -> i32 {
    let mut data = 10i32;
    let r = tick().await;
    let v: view<i32> = view(data);
    r + *v
}

pub fn main() {}
