// test: ui
// REQ-ASY-028..031: Re-borrowing views after .await across multiple suspension points is accepted.

async fn tick() -> i32 {
    1i32
}

async fn multi_await_reborrow() -> i32 {
    let data = 100i32;
    {
        let v1: view<i32> = view(data);
        let _ = *v1;
    }
    let r1 = tick().await;
    {
        let v2: view<i32> = view(data);
        let _ = *v2;
    }
    let r2 = tick().await;
    let v3: view<i32> = view(data);
    *v3 + r1 + r2
}

async fn mut_view_after_await() -> i32 {
    let mut data = 200i32;
    let r = tick().await;
    let mv: mut_view<i32> = mut_view(data);
    *mv = *mv + r;
    data
}

pub fn main() {}
