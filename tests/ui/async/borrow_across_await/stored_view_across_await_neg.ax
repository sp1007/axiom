// test: ui
// REQ-ASY-028..031, AXS-ASY-034: Reject struct containing view held across .await.

struct StoredView {
    v: view<i32>,
}

async fn tick() -> i32 {
    1i32
}

async fn bad_stored_view_across_await() -> i32 {
    let data = 42i32;
    let sv = StoredView { v: view(data) };
    let _ = tick().await; //~ ERROR AX_ASYNC_VIEW_ACROSS_AWAIT
    *(sv.v)
}

pub fn main() {}
