// test: ui
// REQ-ASY-028..031, AXS-ASY-034: Reject mut_view<T> held across .await.

async fn tick() -> i32 {
    1i32
}

async fn bad_mut_view_across_await() -> i32 {
    let mut data = 42i32;
    let mv: mut_view<i32> = mut_view(data);
    let _ = tick().await; //~ ERROR AX_ASYNC_VIEW_ACROSS_AWAIT
    *mv = 100i32;
    0i32
}

pub fn main() {}
