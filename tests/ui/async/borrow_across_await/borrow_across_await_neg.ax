// REQ-ASY-028..031, AXS-ASY-034: Reject view<T> held across .await.

async fn tick() -> i32 {
    1i32
}

async fn bad_view_across_await() -> i32 {
    let mut data = 42i32;
    let v: view<i32> = view(data);
    let _ = tick().await; //~ ERROR AX_ASYNC_VIEW_ACROSS_AWAIT
    *v
}

