// test: run
// modes: interp native
// exit: 101
// stderr-contains: polling a completed Future state machine

use std.future.Context;
use std.future.Future;
use std.future.Poll;
use std.future.RawWaker;
use std.future.RawWakerVTable;
use std.future.Waker;

struct StepYield {
    step: i32,
    val: i32,
}

impl Future for StepYield {
    type Output = i32;

    fn poll(self: mut_view<StepYield>, cx: mut_view<Context>) -> Poll<i32> {
        let cur = self.step;
        if cur == 0i32 {
            self.step = 1i32;
            Poll.Pending
        } else {
            Poll.Ready(self.val)
        }
    }
}

async fn multi_step_task(x: i32) -> i32 {
    let mut y1 = StepYield { step: 0i32, val: 10i32 };
    let a = y1.await;
    let mut y2 = StepYield { step: 0i32, val: 20i32 };
    let b = y2.await;
    x + a + b
}

fn main() -> i32 {
    let mut fut = multi_step_task(5i32);
    let mut cx = Context {
        waker_val: Waker {
            raw: RawWaker {
                data: 0 as *const u8,
                vtable: 0 as *const RawWakerVTable,
            },
        },
    };

    // Poll 1: suspends at SP 0 (state 1)
    let p1 = fut.poll(mut_view(cx));
    match p1 {
        Poll.Pending => {},
        Poll.Ready(_) => return 1i32,
    }

    // Poll 2: suspends at SP 1 (state 2)
    let p2 = fut.poll(mut_view(cx));
    match p2 {
        Poll.Pending => {},
        Poll.Ready(_) => return 2i32,
    }

    // Poll 3: completes (state transitions to 0xFFFFFFFFu32)
    let p3 = fut.poll(mut_view(cx));
    match p3 {
        Poll.Pending => return 3i32,
        Poll.Ready(v) => {
            if v != 35i32 {
                return 4i32;
            }
        },
    }

    // Adversarial: Poll 4 after completed state machine must panic deterministically:
    let _ = fut.poll(mut_view(cx));
    0i32
}
