// test: ui
// E13.1 negative UI: moving a `!Copy` value out of a `static mut` item inside
// `unsafe` is rejected with `AX_MOVE_USE_AFTER_MOVE`.

module test_move_out_of_static_mut_err

struct OwnedResource {
    pub handle: i32,
}

static mut MUT_RES: OwnedResource = OwnedResource { handle: 2 };

pub fn bad_move_mut() {
    let _b: OwnedResource = unsafe { MUT_RES }; //~ ERROR AX_MOVE_USE_AFTER_MOVE
}

pub fn main() -> i32 {
    0
}
