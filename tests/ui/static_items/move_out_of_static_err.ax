// test: ui
// E13.1 negative UI: moving a `!Copy` value directly out of an immutable `static`
// item is rejected with `AX_MOVE_USE_AFTER_MOVE`.

module test_move_out_of_static_err

struct OwnedResource {
    pub handle: i32,
}

static IMM_RES: OwnedResource = OwnedResource { handle: 1 };

pub fn bad_move_imm() {
    let _a: OwnedResource = IMM_RES; //~ ERROR AX_MOVE_USE_AFTER_MOVE
}

pub fn main() -> i32 {
    0
}
