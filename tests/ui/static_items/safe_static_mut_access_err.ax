// test: ui
// E13.1 negative UI: reading, writing, projecting, or borrowing a non-`@thread_local`
// `static mut` item outside `unsafe` is rejected with `AX_CONC_UNSYNC_STATIC`
// (`SPEC-30 AXS-CONC-034`, `SPEC-50 AXS-UNS-002`).

module test_safe_static_mut_access_err

@derive(Copy)
struct Pair {
    pub a: i32,
    pub b: i32,
}

static mut S_CNT: i32 = 0;
static mut S_PAIR: Pair = Pair { a: 1, b: 2 };

pub fn bad_safe_accesses() -> i32 {
    let x: i32 = S_CNT; //~ ERROR AX_CONC_UNSYNC_STATIC
    S_CNT = 5; //~ ERROR AX_CONC_UNSYNC_STATIC
    S_PAIR.a = 9; //~ ERROR AX_CONC_UNSYNC_STATIC
    let _v = view(S_CNT); //~ ERROR AX_CONC_UNSYNC_STATIC
    let _mv = mut_view(S_CNT); //~ ERROR AX_CONC_UNSYNC_STATIC
    x
}

pub fn main() -> i32 {
    0
}
