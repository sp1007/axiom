// test: ui
// QA adversarial negative UI (unsafe stage):
// Calling `address_of(S_MUT)` or `address_of_mut(S_MUT)` outside `unsafe` reports both
// `AX_UNSAFE_REQUIRED` (on the intrinsic call) and `AX_CONC_UNSYNC_STATIC` (on `S_MUT`).

module test_qa_static_safe_ptr_err

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

static mut S_MUT: i32 = 9;

pub fn bad_safe_ptrs() {
    let _p1 = address_of(S_MUT); //~ ERROR AX_UNSAFE_REQUIRED
    //~^ ERROR AX_CONC_UNSYNC_STATIC
    let _p2 = address_of_mut(S_MUT); //~ ERROR AX_UNSAFE_REQUIRED
    //~^ ERROR AX_CONC_UNSYNC_STATIC
}

pub fn main() -> i32 {
    0
}
