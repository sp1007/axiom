// test: ui
// QA adversarial negative UI (ownership stage):
// Moving a `!Copy` value out of an immutable `static` via a by-value function argument
// is rejected with `AX_MOVE_USE_AFTER_MOVE`.

module test_qa_static_move_by_arg_err

struct NonCopyToken {
    pub id: i32,
}

static IMM_TOK: NonCopyToken = NonCopyToken { id: 1 };

fn consume_tok(t: NonCopyToken) {
    let _ = t.id;
}

pub fn bad_move_by_call_arg() {
    consume_tok(IMM_TOK); //~ ERROR AX_MOVE_USE_AFTER_MOVE
}

pub fn main() -> i32 {
    0
}
