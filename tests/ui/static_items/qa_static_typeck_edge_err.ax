// test: ui
// QA adversarial negative UI (typeck stage):
// 1. An immutable `static` item is NOT a compile-time constant for `[v; N]` or `[N]T` array lengths.
// 2. Indexed and tuple-projected `mut_view` and `address_of_mut` on immutable `static` aggregates report `AX_TYPE_ASSIGN_IMMUTABLE`.

module test_qa_static_typeck_edge_err

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

static S_LEN: usize = 4usize;
static IMM_ARR: [2]i32 = [10, 20];
static IMM_TUP: (i32, i32) = (30, 40);

pub fn bad_array_lengths_and_immut_projections() {
    let _a = [0i32; S_LEN]; //~ ERROR AX_TYPE_ARRAY_SIZE
    let _b: [S_LEN]i32 = [1, 2, 3, 4]; //~ ERROR AX_TYPE_ARRAY_SIZE
    let _mv_idx = mut_view(IMM_ARR[0]); //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    let _mv_tup = mut_view(IMM_TUP.0); //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    let _p_idx = unsafe { address_of_mut(IMM_ARR[1]) }; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    let _p_tup = unsafe { address_of_mut(IMM_TUP.1) }; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
}

pub fn main() -> i32 {
    0
}
