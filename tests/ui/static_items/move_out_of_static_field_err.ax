// test: ui
// E13.1 negative UI: moving a `!Copy` field out of a `static` aggregate place
// is rejected with `AX_MOVE_USE_AFTER_MOVE`.

module test_move_out_of_static_field_err

struct OwnedResource {
    pub handle: i32,
}

struct Holder {
    pub res: OwnedResource,
}

static IMM_HOLDER: Holder = Holder { res: OwnedResource { handle: 3 } };

pub fn bad_move_field() {
    let _c: OwnedResource = IMM_HOLDER.res; //~ ERROR AX_MOVE_USE_AFTER_MOVE
}

pub fn main() -> i32 {
    0
}
