// test: ui
// E13.1 negative UI: non-constant `static` and `static mut` initializers (runtime
// function calls or reading another `static` item) are rejected at compile time.

module test_non_const_init_err

fn runtime_seed() -> i32 {
    42
}

static BASE_STATIC: i32 = 10;

static BAD_IMM_CALL: i32 = runtime_seed(); //~ ERROR AX_CONST_OVERFLOW
static mut BAD_MUT_CALL: i32 = runtime_seed(); //~ ERROR AX_CONST_OVERFLOW
static BAD_FROM_STATIC: i32 = BASE_STATIC + 1; //~ ERROR AX_CONST_OVERFLOW

pub fn main() -> i32 {
    0
}
