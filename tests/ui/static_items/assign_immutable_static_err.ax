// test: ui
// E13.1 negative UI: direct or projected assignment, `mut_view`, or `address_of_mut`
// on an immutable `static` item is rejected with `AX_TYPE_ASSIGN_IMMUTABLE`.

module test_assign_immutable_static_err

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

@derive(Copy)
struct Config {
    pub limit: i32,
}

static IMM_VAL: i32 = 10;
static IMM_CFG: Config = Config { limit: 64 };
static IMM_ARR: [2]i32 = [1, 2];

pub fn bad_mutations() {
    IMM_VAL = 20; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    IMM_VAL += 1; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    IMM_CFG.limit = 32; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    IMM_ARR[0] = 9; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    let _mv1 = mut_view(IMM_VAL); //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    let _mv2 = mut_view(IMM_CFG.limit); //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    let _p1 = unsafe { address_of_mut(IMM_VAL) }; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    let _p2 = unsafe { address_of_mut(IMM_CFG.limit) }; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
}

pub fn main() -> i32 {
    0
}
