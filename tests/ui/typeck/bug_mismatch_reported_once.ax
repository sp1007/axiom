// test: ui
// T115 / T022 bug T1: one type error is reported exactly once, at the coercion site
// (AXS-SEM-022). The runner fails on duplicate diagnostics.
fn takes_i64(a: i64) -> i64 {
    return a
}

fn ret_i32(x: i64) -> i32 {
    return x    //~ ERROR AX_TYPE_MISMATCH
}

fn main() -> i32 {
    let a: i32 = 1
    let b: i64 = a    //~ ERROR AX_TYPE_MISMATCH
    let c = takes_i64(a)    //~ ERROR AX_TYPE_MISMATCH
    let d: u32 = 2
    let e = a + d    //~ ERROR AX_TYPE_MISMATCH
    if (a) {    //~ ERROR AX_TYPE_MISMATCH
        return 1
    }
    let mut f: i64 = 0
    f = a    //~ ERROR AX_TYPE_MISMATCH
    let g: i64 = { a }    //~ ERROR AX_TYPE_MISMATCH
    let h: bool = !a    //~ ERROR AX_TYPE_MISMATCH
    let k = a == true    //~ ERROR AX_TYPE_MISMATCH
    return 0
}
