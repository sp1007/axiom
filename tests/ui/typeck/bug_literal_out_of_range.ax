// test: ui
// T115 / T022 bug T2: AXS-SEM-021 range check after typing; `-<literal>` is folded first;
// a negated unsigned literal is AX_TYPE_NEG_UNSIGNED (except -0).
fn main() -> i32 {
    let a: u8 = 300    //~ ERROR AX_TYPE_LITERAL_OUT_OF_RANGE
    let b = -129i8    //~ ERROR AX_TYPE_LITERAL_OUT_OF_RANGE
    let c = 128i8    //~ ERROR AX_TYPE_LITERAL_OUT_OF_RANGE
    let d: u16 = 65536    //~ ERROR AX_TYPE_LITERAL_OUT_OF_RANGE
    let e = 2147483648    //~ ERROR AX_TYPE_LITERAL_OUT_OF_RANGE
    let f: i64 = -9223372036854775809    //~ ERROR AX_TYPE_LITERAL_OUT_OF_RANGE
    let g: u32 = -1    //~ ERROR AX_TYPE_NEG_UNSIGNED
    let h = -5u8    //~ ERROR AX_TYPE_NEG_UNSIGNED
    let x: u64 = 7
    let y = -x    //~ ERROR AX_TYPE_NEG_UNSIGNED
    let z = 3
    let w: u16 = -z    //~ ERROR AX_TYPE_NEG_UNSIGNED
    let late = 256
    let fixed: u8 = late    //~^ ERROR AX_TYPE_LITERAL_OUT_OF_RANGE
    return 0
}
