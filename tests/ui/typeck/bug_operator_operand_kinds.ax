// test: ui
// T115 seam: operators on operand types they are not defined for give AX_TYPE_OPERATOR
// (never a silently typed expression); `~` is typed for integers (AXS-SEM-033).
fn main() -> i32 {
    let t = true
    let a = ~t    //~ ERROR AX_TYPE_OPERATOR
    let b = -t    //~ ERROR AX_TYPE_OPERATOR
    let c = t + t    //~ ERROR AX_TYPE_OPERATOR
    let d = t << 1    //~ ERROR AX_TYPE_OPERATOR
    let x: u8 = 5
    let e: u8 = ~x
    let f: i32 = ~x    //~ ERROR AX_TYPE_MISMATCH
    return 0
}
