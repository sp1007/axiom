// test: ui
// T134: an `@intrinsic fn` must be a row of the intrinsic table with a matching signature; otherwise the
// placeholder body would be compiled and executed in its place.

@intrinsic fn frobnicate(a: u32) -> u32 { 0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn wrapping_add_u32(a: u32, b: u64) -> u32 { 0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn rotate_left_i16(a: i16, n: i16) -> i16 { 0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn count_ones_u8(a: u8, b: u8) -> u32 { 0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn leading_zeros_u16(a: u32) -> u32 { 0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn wrapping_neg_u128(a: u32) -> u32 { 0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn assert(c: u32) {} //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn size_of() -> usize { 0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC

// Known names with a matching signature are accepted.
@intrinsic fn wrapping_mul_i32(a: i32, b: i32) -> i32 { 0 }
@intrinsic fn trailing_zeros_usize(a: usize) -> u32 { 0 }
@intrinsic fn panic(msg: Str) {}

// A plain function with a table name is not an intrinsic and is not checked.
fn count_ones_u64(a: u64, b: u64) -> u64 { a + b }

fn main() -> i32 { 0 }
