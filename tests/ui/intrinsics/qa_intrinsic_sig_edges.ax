// test: ui
// QA boundary cross-check (T134): edge-case `@intrinsic` signature validation
// covering generic params on non-generic rows, return type mismatches on unary
// bit ops, pointer mutability mismatches on host/generic intrinsics, and
// parameter type/arity mismatches on diverging terminators.

@intrinsic fn wrapping_add_u32<T>(a: u32, b: u32) -> u32 { 0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn trailing_zeros_u64(a: u64) -> u64 { 0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn heap_alloc(size: usize, align: usize) -> *const u8 { 0 as *const u8 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn ptr_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: u32) {} //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn unreachable(code: i32) {} //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn panic(a: Str, b: Str) {} //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC

// Valid generic and host intrinsic signatures are accepted.
@intrinsic fn size_of<T>() -> usize { 0 }
@intrinsic fn align_of<T>() -> usize { 0 }
@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }
@intrinsic fn monotonic_ns() -> u64 { 0 }

fn main() -> i32 { 0 }
