// test: ui
// QA (T498e gate): moving one row of a 2-D array moves the whole array (REQ-OWN-049); a write to a
// different row is then a use after move and does not bring the array back.

struct H {
    n: u32,
}

fn mk() -> H {
    H { n: 1u32 }
}

fn main() -> i32 {
    let mut g: [2][2]H = [[mk(), mk()], [mk(), mk()]];
    let r = g[0];
    g[1][0] = mk(); //~ ERROR AX_MOVE_USE_AFTER_MOVE
    0
}
