// test: ui
// stderr-contains: drop_elem_write_after_move.ax:20:
// T498e (SPEC-10 AXS-OWN-006, SPEC-03 AXS-SEM-043): for an element type that needs drop, `hs[0] = v`
// drops the old element in place first; after the whole array was moved that drop and the store are
// a use after move, never a reinitialisation.

struct D {
    id: i32,
}

impl Drop for D {
    fn drop(self: mut_view<D>) {
        print_int(self.id as i64);
        print("\n");
    }
}

fn main() -> i32 {
    let mut ds: [2]D = [D { id: 1 }, D { id: 2 }];
    let t = ds;
    ds[0] = D { id: 3 }; //~ ERROR AX_MOVE_USE_AFTER_MOVE
    let u = ds[1].id;
    u
}
