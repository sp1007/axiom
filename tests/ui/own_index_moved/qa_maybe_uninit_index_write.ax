// test: ui
// QA (T498e gate): the array is initialised on one branch only; after the join a write through an index
// is a use of a (maybe-)uninitialised place.

struct H {
    n: u32,
}

fn mk() -> H {
    H { n: 1u32 }
}

fn main() -> i32 {
    let mut hs: [2]H;
    let c: i32 = 3;
    if c > 2 {
        hs = [mk(), mk()];
    }
    hs[0].n = 9u32; //~ ERROR AX_INIT_USE_UNINIT
    0
}
