// test: ui
// stderr-contains: struct_whole_moved.ax:21:
// T498e (SPEC-10 AXS-OWN-006): after the whole struct `w` was moved, `w.hs[0] = mk()` is a use after
// move.

struct H {
    n: u32,
}

struct W {
    k: u32,
    hs: [2]H,
}

fn mk() -> H {
    H { n: 1u32 }
}

fn main() -> i32 {
    let mut w = W { k: 7u32, hs: [mk(), mk()] };
    let t = w;
    w.hs[0] = mk(); //~ ERROR AX_MOVE_USE_AFTER_MOVE
    0
}
