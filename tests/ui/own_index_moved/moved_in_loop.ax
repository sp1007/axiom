// test: ui
// stderr-contains: moved_in_loop.ax:22:
// T498e (SPEC-10 AXS-OWN-006): the array is moved later in the loop body; on the next iteration the
// write through an index sees it (maybe-)moved and is rejected.

struct H {
    n: u32,
}

fn mk() -> H {
    H { n: 1u32 }
}

fn eat(hs: [2]H) -> u32 {
    hs[1].n
}

fn main() -> i32 {
    let mut hs: [2]H = [mk(), mk()];
    let mut i: usize = 0;
    let mut s: u32 = 0u32;
    while i < 2 {
        hs[i] = mk(); //~ ERROR AX_MOVE_USE_AFTER_MOVE
        s = s + eat(hs);
        i = i + 1;
    }
    s as i32
}
