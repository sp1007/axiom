// test: ui
// QA (T498e gate): the right-hand side is evaluated before the store; when it moves the whole array
// (`hs[1].n = eat(hs)`), the store through the index is a use after move.

struct H {
    n: u32,
}

fn mk() -> H {
    H { n: 1u32 }
}

fn eat(hs: [2]H) -> u32 {
    hs[0].n
}

fn main() -> i32 {
    let mut hs: [2]H = [mk(), mk()];
    hs[1].n = eat(hs); //~ ERROR AX_MOVE_USE_AFTER_MOVE
    0
}
