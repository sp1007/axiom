// test: ui
// stderr-contains: maybe_moved_branch.ax:23:
// T498e (SPEC-10 AXS-OWN-006, AXS-OWN-007): the array is moved on one branch only; at the join it is
// maybe-moved, so a write through an index is rejected.

struct H {
    n: u32,
}

fn mk() -> H {
    H { n: 1u32 }
}

fn eat(hs: [2]H) -> u32 {
    hs[0].n
}

fn main() -> i32 {
    let mut hs: [2]H = [mk(), mk()];
    let c: i32 = 3;
    if c > 2 {
        let x = eat(hs);
    }
    hs[0].n = 9u32; //~ ERROR AX_MOVE_USE_AFTER_MOVE
    0
}
