// test: ui
// QA (T498e gate): the array is moved only in a conditional arm later in the loop body; on the next
// iteration the indexed write at the top of the body sees it maybe-moved (fast 1-bit solver must fall back to the exact one).

struct H {
    n: u32,
}

fn mk() -> H {
    H { n: 1u32 }
}

fn eat(hs: [2]H) -> u32 {
    hs[0].n
}

fn main() -> i32 {
    let mut hs: [2]H = [mk(), mk()];
    let mut i: i32 = 0;
    let mut s: u32 = 0u32;
    while i < 4 {
        hs[0].n = 4u32; //~ ERROR AX_MOVE_USE_AFTER_MOVE
        if i < 3 {
            s = s + eat(hs);
        }
        i = i + 1;
    }
    s as i32
}
