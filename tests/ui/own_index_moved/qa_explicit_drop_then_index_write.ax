// test: ui
// QA (T498e gate): an explicit `drop(ds[0])` still moves the element (and with it the whole array); the
// following replacement `ds[1] = D { .. }` is therefore a use after move, not an in-place replace.

struct D {
    id: i32,
}

impl Drop for D {
    fn drop(self: mut_view<D>) {
        print_int(self.id as i64);
    }
}

fn main() -> i32 {
    let mut ds: [2]D = [D { id: 1 }, D { id: 2 }];
    drop(ds[0]);
    ds[1] = D { id: 3 }; //~ ERROR AX_MOVE_USE_AFTER_MOVE
    0
}
