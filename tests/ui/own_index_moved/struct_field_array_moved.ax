// test: ui
// stderr-contains: struct_field_array_moved.ax:21:
// T498e (SPEC-10 AXS-OWN-006): an array held in a struct field: after `w.hs` was moved out,
// `w.hs[0].n = 5u32` is a use after move (it does not reinitialise `w.hs`).

struct H {
    n: u32,
}

struct W {
    k: u32,
    hs: [2]H,
}

fn mk() -> H {
    H { n: 1u32 }
}

fn main() -> i32 {
    let mut w = W { k: 7u32, hs: [mk(), mk()] };
    let t = w.hs;
    w.hs[0].n = 5u32; //~ ERROR AX_MOVE_USE_AFTER_MOVE
    let u = w.hs[1].n;
    u as i32
}
