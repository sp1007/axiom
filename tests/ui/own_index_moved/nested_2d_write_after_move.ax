// test: ui
// stderr-contains: nested_2d_write_after_move.ax:15:
// T498e (SPEC-10 AXS-OWN-006): `g[i][j] = v` after the outer array was moved is a use after move.

struct H {
    n: u32,
}

fn mk() -> H {
    H { n: 1u32 }
}

fn main() -> i32 {
    let mut g: [2][2]H = [[mk(), mk()], [mk(), mk()]];
    let t = g;
    g[1][0] = mk(); //~ ERROR AX_MOVE_USE_AFTER_MOVE
    let u = g[0][1].n;
    u as i32
}
