// test: ui
// QA (T498e gate): an array two struct levels deep; after `o.w` was moved out, `o.w.hs[0].n = 5u32`
// is a use after move (the write does not reinitialise `o.w` or its array).

struct H {
    n: u32,
}

struct W {
    k: u32,
    hs: [2]H,
}

struct O {
    w: W,
}

fn mk() -> H {
    H { n: 1u32 }
}

fn main() -> i32 {
    let mut o = O { w: W { k: 7u32, hs: [mk(), mk()] } };
    let t = o.w;
    o.w.hs[0].n = 5u32; //~ ERROR AX_MOVE_USE_AFTER_MOVE
    0
}
