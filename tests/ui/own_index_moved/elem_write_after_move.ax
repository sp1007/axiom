// test: ui
// stderr-contains: elem_write_after_move.ax:16:
// T498e (SPEC-10 AXS-OWN-006): `hs[0] = mk()` after the whole array was moved is rejected at the
// indexed place (the call writes its result straight into `hs[0]`); only `hs = [...]` reinitialises.

struct H {
    n: u32,
}

fn mk() -> H {
    H { n: 1u32 }
}

fn main() -> i32 {
    let mut hs: [2]H = [mk(), mk()];
    let t = hs;
    hs[0] = mk(); //~ ERROR AX_MOVE_USE_AFTER_MOVE
    let u = hs[1].n;
    print_int(u as i64);
    0
}
