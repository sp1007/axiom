// test: ui
// stderr-contains: element_moved_then_other_write.ax:20:
// T498e (SPEC-10 AXS-OWN-006, REQ-OWN-049): moving one element out (`take(hs[0])`) moves the whole
// array (no element-level tracking before v1); a write to another element does not bring it back.

struct H {
    n: u32,
}

fn mk() -> H {
    H { n: 1u32 }
}

fn take(h: H) -> u32 {
    h.n
}

fn main() -> i32 {
    let mut hs: [2]H = [mk(), mk()];
    let a = take(hs[0]);
    hs[1].n = 4u32; //~ ERROR AX_MOVE_USE_AFTER_MOVE
    a as i32
}
