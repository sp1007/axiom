// test: ui
// stderr-contains: compound_write_after_move.ax:17:
// T498e (SPEC-10 AXS-OWN-006): a compound write `hs[i].n += v` after the whole array was moved is a
// use after move.

struct H {
    n: u32,
}

fn mk() -> H {
    H { n: 1u32 }
}

fn main() -> i32 {
    let mut hs: [2]H = [mk(), mk()];
    let t = hs;
    let i: usize = 1;
    hs[i].n += 2u32; //~ ERROR AX_MOVE_USE_AFTER_MOVE
    0
}
