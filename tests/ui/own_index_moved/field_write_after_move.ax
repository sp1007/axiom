// test: ui
// stderr-contains: field_write_after_move.ax:17:
// T498e (SPEC-10 AXS-OWN-006): the triage-1122 repro. After the whole array is moved, a write through
// an index (`hs[0].n = 5u32`) does not reinitialise the array; it is a use after move, so the later
// read of the moved element `hs[1].n` is never reached.

struct H {
    n: u32,
}

fn mk() -> H {
    H { n: 1u32 }
}

fn main() -> i32 {
    let mut hs: [2]H = [mk(), mk()];
    let t = hs;
    hs[0].n = 5u32; //~ ERROR AX_MOVE_USE_AFTER_MOVE
    let u = hs[1].n;
    print_int(u as i64);
    0
}
