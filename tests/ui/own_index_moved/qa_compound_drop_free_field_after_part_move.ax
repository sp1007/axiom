// test: ui
// QA (T498e gate): a partly moved struct (`w.hs` moved out, `w.name` intact) — a write through an
// index of the moved field is rejected even with an op-assign on a field of the element.

struct H {
    n: u32,
}

struct W {
    name: H,
    hs: [2]H,
}

fn mk() -> H {
    H { n: 1u32 }
}

fn main() -> i32 {
    let mut w = W { name: mk(), hs: [mk(), mk()] };
    let t = w.hs;
    w.hs[1].n += 3u32; //~ ERROR AX_MOVE_USE_AFTER_MOVE
    0
}
