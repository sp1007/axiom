// test: ui
// QA (T498e gate): `hs[0] = f(hs)`: the call moves `hs` into its argument and then writes the result
// straight into `hs[0]`; the call destination is a write through an index of a moved array.

struct H {
    n: u32,
}

fn mk() -> H {
    H { n: 1u32 }
}

fn pick(hs: [2]H) -> H {
    hs[1]
}

fn main() -> i32 {
    let mut hs: [2]H = [mk(), mk()];
    hs[0] = pick(hs); //~ ERROR AX_MOVE_USE_AFTER_MOVE
    0
}
