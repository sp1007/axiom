// test: ui
// stderr-contains: uninit_index_write.ax:15:
// T498e (SPEC-10 AXS-OWN-006): a write through an index never initialises the array; into a declared
// but uninitialised array it is a use of an uninitialised place.

struct H {
    n: u32,
}

fn mk() -> H {
    H { n: 1u32 }
}

fn main() -> i32 {
    let mut hs: [2]H;
    hs[0] = mk(); //~ ERROR AX_INIT_USE_UNINIT
    0
}
