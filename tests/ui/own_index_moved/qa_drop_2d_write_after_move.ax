// test: ui
// QA (T498e gate): 2-D array of a drop-needing element: the in-place replace `g[1][0] = D {..}` after
// the whole array was moved is a use after move (drop of the old element + store).

struct D {
    id: i32,
}

impl Drop for D {
    fn drop(self: mut_view<D>) {
        print_int(self.id as i64);
    }
}

fn main() -> i32 {
    let mut g: [2][2]D = [[D { id: 1 }, D { id: 2 }], [D { id: 3 }, D { id: 4 }]];
    let t = g;
    g[1][0] = D { id: 5 }; //~ ERROR AX_MOVE_USE_AFTER_MOVE
    0
}
