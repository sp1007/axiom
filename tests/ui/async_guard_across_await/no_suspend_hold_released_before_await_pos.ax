// test: ui
// T422e: a `@no_suspend_hold` guard (arbitrary name) released (dropped by its scope) before the `.await` is accepted,
// and an `AsyncMutexGuard`-named async guard without the marker may be held across `.await`.

@no_suspend_hold
struct SpinToken<T> {
    pub v: T,
}

impl<T> Drop for SpinToken<T> {
    fn drop(self: mut_view<SpinToken<T>>) {}
}

struct AsyncMutexGuard<T> {
    pub v: T,
}

impl<T> Drop for AsyncMutexGuard<T> {
    fn drop(self: mut_view<AsyncMutexGuard<T>>) {}
}

async fn tick() -> i64 {
    1i64
}

async fn release_then_await() -> i64 {
    let a = 2i64;
    {
        let g = SpinToken { v: 2i64 };
        let _ = g.v;
    }
    let h = AsyncMutexGuard { v: 3i64 };
    let t = tick().await;
    a + h.v + t
}

pub fn main() {}
