// test: ui
// stderr-contains: synchronous lock guard or @no_suspend_hold value is held across an .await suspension point
// QA adversarial boundary cross-check for T422e (MIR verifier suspend-point seam):
// 1. @no_suspend_hold enum held across .await -> AX_ASYNC_GUARD_ACROSS_AWAIT
// 2. Nested generic struct Outer<Token> (wrapping Inner<T>) held across .await -> AX_ASYNC_GUARD_ACROSS_AWAIT
// 3. Unmarked structs named MutexGuard / RwLockWriteGuard held across .await -> ALLOWED

@no_suspend_hold
struct Token {
    pub v: i64,
}

@no_suspend_hold
enum TokenEnum {
    Active(i64),
    Idle,
}

struct Inner<T> {
    pub x: T,
}

struct Outer<T> {
    pub inner: Inner<T>,
}

struct MutexGuard {
    pub v: i64,
}

struct RwLockWriteGuard {
    pub v: i64,
}

async fn tick() -> i64 {
    1i64
}

async fn reject_enum_and_nested_generic_across_await() -> i64 {
    let mut sum = 0i64;
    {
        let e = TokenEnum.Active(10i64);
        let t = tick().await; //~ ERROR AX_ASYNC_GUARD_ACROSS_AWAIT
        sum = sum + match e {
            TokenEnum.Active(v) => v + t,
            TokenEnum.Idle => t,
        };
    }
    {
        let nested = Outer { inner: Inner { x: Token { v: 20i64 } } };
        let t = tick().await; //~ ERROR AX_ASYNC_GUARD_ACROSS_AWAIT
        sum = sum + nested.inner.x.v + t;
    }
    sum
}

async fn allow_unmarked_guards_across_await() -> i64 {
    let g1 = MutexGuard { v: 7i64 };
    let g2 = RwLockWriteGuard { v: 8i64 };
    let t = tick().await;
    g1.v + g2.v + t
}

pub fn main() {}
