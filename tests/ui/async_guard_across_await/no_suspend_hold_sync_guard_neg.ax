// test: ui
// stderr-contains: synchronous lock guard or @no_suspend_hold value is held across an .await suspension point
// T422e (SPEC-33 AXS-ASY-035, SPEC-34 AXS-EXEC-031): a synchronous lock guard is marked
// `@no_suspend_hold` (as std.sync.MutexGuard is); holding it across `.await` is rejected with a
// message that names the real problem (not a drop-flag invariant). The type name is irrelevant.

@no_suspend_hold
struct SpinLockToken<T> {
    pub v: T,
}

impl<T> Drop for SpinLockToken<T> {
    fn drop(self: mut_view<SpinLockToken<T>>) {}
}

async fn tick() -> i32 {
    1i32
}

async fn hold_sync_guard() -> i64 {
    let g = SpinLockToken { v: 5i64 };
    let _ = tick().await; //~ ERROR AX_ASYNC_GUARD_ACROSS_AWAIT
    g.v
}

pub fn main() {}
