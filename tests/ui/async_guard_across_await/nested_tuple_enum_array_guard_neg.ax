// test: ui
// stderr-contains: synchronous lock guard or @no_suspend_hold value is held across an .await suspension point
// T422e: `@no_suspend_hold` is enforced structurally across tuples, generic structs, enums (`Option`),
// and arrays across `.await` (`AX_ASYNC_GUARD_ACROSS_AWAIT`), regardless of type name.

use std.core.option.Option;

@no_suspend_hold
struct CustomTicket {
    pub v: i64,
}

struct BoxWrap<T> {
    pub inner: T,
}

async fn tick() -> i64 {
    1i64
}

async fn composites_with_guard_across_await() -> i64 {
    let mut sum = 0i64;
    {
        let pair = (10i64, CustomTicket { v: 2i64 });
        let t = tick().await; //~ ERROR AX_ASYNC_GUARD_ACROSS_AWAIT
        sum = sum + pair.0 + pair.1.v + t;
    }
    {
        let w = BoxWrap { inner: CustomTicket { v: 3i64 } };
        let t = tick().await; //~ ERROR AX_ASYNC_GUARD_ACROSS_AWAIT
        sum = sum + w.inner.v + t;
    }
    {
        let opt: Option<CustomTicket> = Option.Some(CustomTicket { v: 4i64 });
        let t = tick().await; //~ ERROR AX_ASYNC_GUARD_ACROSS_AWAIT
        sum = sum + match opt {
            Option.Some(tk) => tk.v + t,
            Option.None => t,
        };
    }
    {
        let arr: [1]CustomTicket = [CustomTicket { v: 5i64 }];
        let t = tick().await; //~ ERROR AX_ASYNC_GUARD_ACROSS_AWAIT
        sum = sum + arr[0].v + t;
    }
    sum
}

pub fn main() {}
