// test: ui
// QA adversarial boundary cross-check for T422e (ownership guard-escape seam):
// 1. Returning @no_suspend_hold enum, tuple, Option, array, and nested generic struct -> AX_CONC_GUARD_ESCAPE
// 2. Derived mut_view<i64> from a @no_suspend_hold guard escaping a block -> AX_CONC_GUARD_ESCAPE
// 3. Scalar method return (g.val() -> i64) from a @no_suspend_hold guard -> ALLOWED
// 4. Returning unmarked structs named MutexGuard / RwLockWriteGuard -> ALLOWED

use std.core.option.Option;

@no_suspend_hold
struct Token {
    pub v: i64,
}

impl Token {
    pub fn val(self: view<Token>) -> i64 {
        self.v
    }
}

@no_suspend_hold
enum TokenEnum {
    Active(i64),
    Idle,
}

struct Inner<T> {
    pub x: T,
}

struct Outer<T> {
    pub inner: Inner<T>,
}

struct MutexGuard {
    pub v: i64,
}

struct RwLockWriteGuard {
    pub v: i64,
}

pub fn reject_return_token_enum() -> TokenEnum {
    let e = TokenEnum.Active(1i64);
    return e; //~ ERROR AX_CONC_GUARD_ESCAPE
}

pub fn reject_return_token_tuple() -> (i64, Token) {
    let p = (1i64, Token { v: 2i64 });
    return p; //~ ERROR AX_CONC_GUARD_ESCAPE
}

pub fn reject_return_token_option() -> Option<Token> {
    let o: Option<Token> = Option.Some(Token { v: 3i64 });
    return o; //~ ERROR AX_CONC_GUARD_ESCAPE
}

pub fn reject_return_token_array() -> [1]Token {
    let a: [1]Token = [Token { v: 4i64 }];
    return a; //~ ERROR AX_CONC_GUARD_ESCAPE
}

pub fn reject_return_nested_generic_token() -> Outer<Token> {
    let o = Outer { inner: Inner { x: Token { v: 5i64 } } };
    return o; //~ ERROR AX_CONC_GUARD_ESCAPE
}

pub fn reject_mut_view_escape_from_token() {
    let mut base: i64 = 0i64;
    let mut escaped: mut_view<i64> = mut_view(base);
    {
        let mut tk = Token { v: 99i64 };
        escaped = mut_view(tk.v); //~ ERROR AX_CONC_GUARD_ESCAPE
    }
    let _ = *escaped;
}

pub fn allow_scalar_method_from_token() -> i64 {
    let tk = Token { v: 42i64 };
    let x: i64 = tk.val();
    return x;
}

pub fn allow_unmarked_mutex_guard_return() -> MutexGuard {
    let g = MutexGuard { v: 7i64 };
    return g;
}

pub fn allow_unmarked_rwlock_write_guard_return() -> RwLockWriteGuard {
    let g = RwLockWriteGuard { v: 8i64 };
    return g;
}

pub fn main() {}
