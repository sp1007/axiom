// test: ui
// T422e: `@no_suspend_hold` drives `AX_CONC_GUARD_ESCAPE` on arbitrary user guard types (return,
// inner-block view escape, concurrency boundary), while copying a plain scalar field out of a
// guard and returning it is permitted.

@no_suspend_hold
struct CustomTicket {
    pub v: i64,
}

fn spawn_scoped<F: FnOnce>(f: F) -> i64 {
    f()
}

pub fn reject_return_custom_ticket() -> CustomTicket {
    let tk = CustomTicket { v: 9i64 };
    return tk; //~ ERROR AX_CONC_GUARD_ESCAPE
}

pub fn reject_custom_ticket_view_escape() {
    let base: i64 = 0i64;
    let mut escaped: view<i64> = view(base);
    {
        let tk = CustomTicket { v: 77i64 };
        escaped = view(tk.v); //~ ERROR AX_CONC_GUARD_ESCAPE
    }
    let _ = *escaped;

    let tk2 = CustomTicket { v: 88i64 };
    let vtk = view(tk2.v);
    let _ = spawn_scoped(|| -> i64 {
        *vtk //~ ERROR AX_CONC_GUARD_ESCAPE
    });
}

pub fn allow_copy_scalar_from_custom_ticket() -> i64 {
    let tk = CustomTicket { v: 42i64 };
    let copied: i64 = tk.v;
    return copied;
}

pub fn main() {}
