// test: ui
struct Iter {
    s: view<[u8]>,
    i: usize,
}
fn consume(arr: [3]u8) {}
fn main() {
    let mut arr: [3]u8 = [10, 20, 30];
    let mut it = Iter { s: view(arr), i: 0 };
    
    consume(arr); //~ ERROR AX_CAP_OUTLIVES_OWNER
    
    let mut i = it.i;
    while i < len(it.s) {
        let x = it.s[i];
        i = i + 1;
        it.i = i;
    }
}
