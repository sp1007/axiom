// test: ui
// SPEC-11 AXS-CAP-004: moving the owner while a view into it is live is AX_CAP_OUTLIVES_OWNER.
// Since T498 (SPEC-10 AXS-OWN-003, ADR-0044 section 3) `[N]u8` is Copy and `consume(arr)` would only copy it, so the
// owner here is an array of a non-Copy element (`Tok`), which really moves.
struct Tok {
    v: u8,
}
struct Iter {
    s: view<[Tok]>,
    i: usize,
}
fn consume(arr: [3]Tok) {}
fn main() {
    let mut arr: [3]Tok = [Tok { v: 10 }, Tok { v: 20 }, Tok { v: 30 }];
    let mut it = Iter { s: view(arr), i: 0 };

    consume(arr); //~ ERROR AX_CAP_OUTLIVES_OWNER

    let mut i = it.i;
    while i < len(it.s) {
        let x = it.s[i].v;
        i = i + 1;
        it.i = i;
    }
}
