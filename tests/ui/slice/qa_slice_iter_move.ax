// test: ui
struct SliceIter {
    s: view<[u8]>,
    i: usize,
}
fn consume(arr: [4]u8) {}
fn main() {
    let arr: [4]u8 = [1, 2, 3, 4];
    let mut it: SliceIter = SliceIter { s: view(arr), i: 0 };
    consume(arr); //~ ERROR AX_CAP_OUTLIVES_OWNER
    let mut sum: u8 = 0;
    while len(it.s) > it.i {
        sum = sum + it.s[it.i];
        it.i = it.i + 1;
    }
}
