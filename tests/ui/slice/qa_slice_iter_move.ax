// test: ui
// SPEC-11 AXS-CAP-004 with a non-Copy owner: `[4]Tok` is not Copy (SPEC-10 AXS-OWN-003), so `consume(arr)` moves it
// while the view held by `it` is still used afterwards.
struct Tok {
    v: u8,
}
struct SliceIter {
    s: view<[Tok]>,
    i: usize,
}
fn consume(arr: [4]Tok) {}
fn main() {
    let arr: [4]Tok = [Tok { v: 1 }, Tok { v: 2 }, Tok { v: 3 }, Tok { v: 4 }];
    let mut it: SliceIter = SliceIter { s: view(arr), i: 0 };
    consume(arr); //~ ERROR AX_CAP_OUTLIVES_OWNER
    let mut sum: u8 = 0;
    while len(it.s) > it.i {
        sum = sum + it.s[it.i].v;
        it.i = it.i + 1;
    }
}
