// test: ui

// T444b: binding both non-Copy (drop-free) payload fields by value is accepted (the second binding
// is not a use after move); the matched scrutinee is consumed, so using it as a whole afterwards is
// still rejected.

struct Token {
    v: i32,
}

enum Pair {
    Two(Token, Token),
    None,
}

fn main() {
    let p = Pair.Two(Token { v: 1 }, Token { v: 2 });
    match p {
        Pair.Two(a, b) => {
            let s = a.v + b.v;
        },
        Pair.None => {},
    }
    let again = p; //~ ERROR AX_MOVE_USE_AFTER_MOVE
}
