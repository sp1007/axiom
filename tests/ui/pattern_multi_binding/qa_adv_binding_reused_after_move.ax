// test: ui

// T444b QA (adversarial, round 0): a payload binding is an ordinary owned local; moving it twice
// is an error on the second move, and the sibling binding stays usable (exactly one diagnostic).

struct Res {
    id: i32,
}

impl Drop for Res {
    fn drop(self: mut_view<Res>) {}
}

enum Owning {
    Two(Res, Res),
    Empty,
}

fn eat(r: Res) {}

fn main() {
    let o = Owning.Two(Res { id: 1 }, Res { id: 2 });
    match o {
        Owning.Two(a, b) => {
            eat(a);
            eat(b);
            eat(a); //~ ERROR AX_MOVE_USE_AFTER_MOVE
        },
        _ => {},
    }
}
