// test: ui

// T444b: moving only one payload field (the other is `_`) still leaves the scrutinee partially
// moved, so moving it again as a whole is rejected.

struct Res {
    id: i32,
}

impl Drop for Res {
    fn drop(self: mut_view<Res>) {}
}

enum Owning {
    Two(Res, Res),
    Empty,
}

fn main() {
    let o = Owning.Two(Res { id: 1 }, Res { id: 2 });
    if let Owning.Two(_, y) = o {
        let k = y.id;
    }
    let again = o; //~ ERROR AX_MOVE_USE_AFTER_MOVE
}
