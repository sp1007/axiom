// test: ui

// T444b: binding a non-Copy payload field by value partially moves the scrutinee; using the
// whole scrutinee afterwards is still a use after move (the second binding itself is not).

struct Res {
    id: i32,
}

impl Drop for Res {
    fn drop(self: mut_view<Res>) {}
}

enum Owning {
    Two(Res, Res),
    Empty,
}

fn take(o: Owning) {}

fn main() {
    let o = Owning.Two(Res { id: 1 }, Res { id: 2 });
    match o {
        Owning.Two(x, y) => {},
        _ => {},
    }
    take(o); //~ ERROR AX_MOVE_USE_AFTER_MOVE
}
