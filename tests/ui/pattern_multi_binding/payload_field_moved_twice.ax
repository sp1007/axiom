// test: ui

// T444b: a second match on a scrutinee whose payload field was already moved by value is a use
// after move (reported at the scrutinee, whose discriminant read is a use of the moved value).

struct Res {
    id: i32,
}

impl Drop for Res {
    fn drop(self: mut_view<Res>) {}
}

enum Owning {
    Two(Res, Res),
    Empty,
}

fn main() {
    let o = Owning.Two(Res { id: 1 }, Res { id: 2 });
    match o {
        Owning.Two(x, _) => {},
        _ => {},
    }
    match o { //~ ERROR AX_MOVE_USE_AFTER_MOVE
        Owning.Two(x2, y) => {},
        _ => {},
    }
}
