// test: ui

// T444b QA (adversarial, round 0): a by-value multi-binding match on a scrutinee declared outside
// a loop moves its payload on the first iteration; the next iteration's match is a use after move.
// The fix must not hide this by treating the per-field moves as independent of the loop back edge.

struct Res {
    id: i32,
}

impl Drop for Res {
    fn drop(self: mut_view<Res>) {}
}

enum Owning {
    Two(Res, Res),
    Empty,
}

fn main() {
    let o = Owning.Two(Res { id: 1 }, Res { id: 2 });
    let mut n = 0;
    while n < 2 {
        match o { //~ ERROR AX_MOVE_USE_AFTER_MOVE
            Owning.Two(a, b) => {},
            _ => {},
        }
        n = n + 1;
    }
}
