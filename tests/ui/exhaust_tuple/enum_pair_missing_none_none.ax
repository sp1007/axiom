// test: ui
// exit: 1
// T499b: a tuple of enums where `(None, None)` is not covered.
enum Opt { None, Some(i32) }

fn pick(a: Opt, b: Opt) -> i32 {
    match (a, b) { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        (Opt.Some(x), _) => x,
        (Opt.None, Opt.Some(y)) => y,
    }
}

fn main() -> i32 {
    pick(Opt.None, Opt.Some(3))
}
