// test: ui
// exit: 1
// T499b: integer ranges inside a tuple — `10u8` is missing in the first column; `-1i8` in the second match.
fn gap(x: u8, b: bool) -> i32 {
    match (x, b) { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        (0u8..=9u8, _) => 1,
        (11u8..=255u8, true) => 2,
        (11u8..=255u8, false) => 3,
    }
}

fn signed_gap(x: i8, y: i8) -> i32 {
    match (x, y) { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        (_, -128i8..=-2i8) => 1,
        (_, 0i8..=127i8) => 2,
    }
}

fn main() -> i32 {
    gap(3u8, true) + signed_gap(1i8, 1i8)
}
