// test: ui
// exit: 1
// T499b QA boundary cross-check: signed i8 min/max, exclusive u8 range, struct-in-tuple,
// enum-with-bool-payload and struct-variant payload in tuple, guards, and opaque i128 in tuple.
struct Flag {
    a: bool,
    b: bool,
}

enum OptBool {
    None,
    Some(bool),
}

enum Ev {
    Empty,
    Pair { x: bool, y: bool },
}

fn i8_missing_max(t: (i8, bool)) -> i32 {
    match t { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        (-128i8..=126i8, _) => 1,
    }
}

fn i8_missing_min(t: (i8, bool)) -> i32 {
    match t { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        (-127i8..=127i8, _) => 1,
    }
}

fn u8_exclusive_missing_max(t: (u8, bool)) -> i32 {
    match t { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        (0u8..255u8, _) => 1,
    }
}

fn struct_in_tuple_missing(t: (Flag, bool)) -> i32 {
    match t { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        (Flag { a: true, b: _ }, _) => 1,
        (Flag { a: false, b: true }, _) => 2,
    }
}

fn enum_bool_payload_missing(t: (OptBool, bool)) -> i32 {
    match t { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        (OptBool.Some(true), _) => 1,
        (OptBool.None, _) => 2,
    }
}

fn enum_struct_variant_missing(t: (Ev, bool)) -> i32 {
    match t { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        (Ev.Empty, _) => 1,
        (Ev.Pair { x: true, y: _ }, _) => 2,
        (Ev.Pair { x: false, y: true }, _) => 3,
    }
}

fn opaque_i128_missing(t: (i128, bool)) -> i32 {
    match t { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        (0i128, true) => 1,
        (0i128, false) => 2,
    }
}

fn guarded_does_not_cover(t: (bool, bool)) -> i32 {
    match t { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        (true, x) if x => 1,
        (false, _) => 2,
    }
}

fn main() -> i32 {
    i8_missing_max((0i8, true)) +
        i8_missing_min((0i8, true)) +
        u8_exclusive_missing_max((0u8, true)) +
        struct_in_tuple_missing((Flag { a: true, b: true }, true)) +
        enum_bool_payload_missing((OptBool.None, true)) +
        enum_struct_variant_missing((Ev.Empty, true)) +
        opaque_i128_missing((0i128, true)) +
        guarded_does_not_cover((false, true))
}
