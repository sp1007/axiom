// test: ui
// exit: 1
// T499b: refutable payloads and nested tuples are not complete; a guarded arm does not count as covering.
enum Opt { None, Some(i32) }

fn payload(a: Opt, b: bool) -> i32 {
    match (a, b) { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        (Opt.Some(1), _) => 1,
        (Opt.None, _) => 2,
    }
}

fn nested(t: ((bool, bool), i32)) -> i32 {
    match t { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        ((true, _), n) => n,
        ((false, true), n) => n + 1,
    }
}

fn guarded(t: (bool, bool)) -> i32 {
    match t { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        (true, q) if q => 1,
        (false, _) => 2,
    }
}

fn main() -> i32 {
    payload(Opt.None, true) + nested(((true, true), 1)) + guarded((false, true))
}
