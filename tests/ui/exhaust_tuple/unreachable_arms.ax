// test: ui
// T499b: arms that earlier tuple arms already cover are reported unreachable (warning only).
fn after_bindings(t: (bool, bool)) -> i32 {
    match t {
        (p, q) => 3,
        _ => 4,                 //~ WARN AX_PAT_UNREACHABLE
    }
}

fn after_complete(t: (bool, i32)) -> i32 {
    match t {
        (true, _) => 1,
        (false, _) => 2,
        (_, 7) => 3,            //~ WARN AX_PAT_UNREACHABLE
    }
}

fn or_alternative(t: (bool, bool)) -> i32 {
    match t {
        (true, _) => 1,
        (false, true) | (true, false) => 2,     //~ WARN AX_PAT_UNREACHABLE
        (false, false) => 3,
    }
}

fn main() -> i32 {
    after_bindings((true, false)) + after_complete((false, 7)) + or_alternative((false, false))
}
