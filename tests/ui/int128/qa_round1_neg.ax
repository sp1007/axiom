// test: ui

const NEG_I128: i128 = -1i128;
const MIN_I128: i128 = -170141183460469231731687303715884105728i128;
const HUGE_U128: u128 = 1u128 << 64;
const Y_POW64: u128 = 18446744073709551615u128 + 1u128;

fn main() {
    // Finding 1: Negative literal pattern on unsigned scrutinee rejected; duplicate 128-bit arm warns
    let x_u128: u128 = 5u128;
    let _ = match x_u128 {
        -1 => 1i32, //~ ERROR AX_TYPE_NEG_UNSIGNED
        18446744073709551616u128 => 2i32,
        18446744073709551616u128 => 3i32, //~ WARN AX_PAT_UNREACHABLE
        _ => 4i32,
    };

    // Round 2 Finding 1: Exclusive signed ..0, 0..0 empty range, and covered ..-1 subranges
    let x_i32: i32 = 0i32;
    let _ = match x_i32 {
        0i32..0i32 => 1i32, //~ WARN AX_PAT_UNREACHABLE
        -10i32..0i32 => 2i32,
        -5i32..-1i32 => 3i32, //~ WARN AX_PAT_UNREACHABLE
        _ => 4i32,
    };
    let x_i128: i128 = 0i128;
    let _ = match x_i128 {
        0i128..0i128 => 1i32, //~ WARN AX_PAT_UNREACHABLE
        -10i128..0i128 => 2i32,
        -5i128..-1i128 => 3i32, //~ WARN AX_PAT_UNREACHABLE
        _ => 4i32,
    };

    // Finding 3: Standalone unary ~ and - do not implicitly widen outside binary arithmetic trees (AXS-INT-050)
    let b8: u8 = 1u8;
    let s8: i8 = -1i8;
    let bad_not: i32 = ~b8; //~ ERROR AX_TYPE_MISMATCH
    let bad_neg: i64 = -s8; //~ ERROR AX_TYPE_MISMATCH

    // Finding 4: Unsuffixed > i32.MAX without wide context defaults to i32 -> AX_TYPE_LITERAL_OUT_OF_RANGE
    let bad_default = 18446744073709551616; //~ ERROR AX_TYPE_LITERAL_OUT_OF_RANGE
    let bad_u64: u64 = 18446744073709551616; //~ ERROR AX_TYPE_LITERAL_OUT_OF_RANGE

    // Finding 6: Array lengths >= 2^64 or negative i128 rejected with AX_TYPE_ARRAY_SIZE
    let arr1: [18446744073709551616u128]u8 = []; //~ ERROR AX_TYPE_ARRAY_SIZE
    let arr2: [NEG_I128]u8 = []; //~ ERROR AX_TYPE_ARRAY_SIZE
    let arr3: [MIN_I128]u8 = []; //~ ERROR AX_TYPE_ARRAY_SIZE
    let arr4: [HUGE_U128]u8 = []; //~ ERROR AX_TYPE_ARRAY_SIZE
    let arr5: [Y_POW64]u8 = []; //~ ERROR AX_TYPE_ARRAY_SIZE
}
