// test: ui
// flags: --profile freestanding
module profile_forbidden_caps

use std.alloc.box.box_new
use std.core.host.thread_spawn

fn dummy_thread_entry(ctx: *mut u8) -> i64 {
    let _ = ctx;
    0i64
}

@blocking
fn park_cpu() {}

@thread_local
static LOCAL_COUNTER: i32 = 7

@used //~ ERROR AX_DRIVER_PROFILE_FORBIDDEN_CAP
@thread_local
static ROOT_TLS_SLOT: i32 = 99

fn alloc_indirect_leaf() -> i32 {
    let b = box_new(5i32);
    let _ = b.ptr;
    1
}

fn alloc_indirect_mid() -> i32 {
    alloc_indirect_leaf()
}

fn blocking_helper() {
    park_cpu()
}

fn tls_reader_helper() -> i32 {
    LOCAL_COUNTER
}

fn spawn_helper() -> i64 {
    unsafe { thread_spawn(dummy_thread_entry, 0 as *mut u8, 0usize) }
}

// Dead helper must NOT report AX_DRIVER_PROFILE_FORBIDDEN_CAP.
fn unreachable_io_helper() {
    print("dead")
}

@entry
pub fn _start() -> i32 {
    print("direct os io"); //~ ERROR AX_DRIVER_PROFILE_FORBIDDEN_CAP
    let _a = alloc_indirect_mid(); //~ ERROR AX_DRIVER_PROFILE_FORBIDDEN_CAP
    blocking_helper(); //~ ERROR AX_DRIVER_PROFILE_FORBIDDEN_CAP
    let _t = tls_reader_helper(); //~ ERROR AX_DRIVER_PROFILE_FORBIDDEN_CAP
    let _s = spawn_helper(); //~ ERROR AX_DRIVER_PROFILE_FORBIDDEN_CAP
    0
}
