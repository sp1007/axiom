// test: ui
// flags: --profile freestanding --kind lib
module valid_freestanding_lib

use std.core.option.Option

@section(".text.fast")
@used
pub fn checksum(a: u32, b: u32) -> u32 {
    let opt = Option.Some(a + b);
    match opt {
        Option.Some(v) => v,
        Option.None => 0u32,
    }
}
