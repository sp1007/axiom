// test: ui
// flags: --profile freestanding
module spec52_bad_freestanding

use std.alloc.box.box_new
use std.fs.File //~ ERROR AX_NAME_FREESTANDING_FORBIDDEN_IMPORT

pub struct InterruptFrame {
    pub rip: u64,
}

@entry //~ ERROR AX_TYPE_ENTRY_SIGNATURE
pub fn bad_entry<T>() -> () {
    let _ = 0i32;
}

pub extern "interrupt" fn bad_irq_handler(frame: view<InterruptFrame>) {
    let _ = frame;
    let _b = box_new(42i32); //~ ERROR AX_UNSAFE_INTERRUPT_FORBIDDEN_OP
}

@naked //~ ERROR AX_TYPE_INVALID_NAKED_FN
pub fn bad_naked() -> i32 {
    let local_arr: [16]i32 = [0; 16];
    local_arr[0]
}
