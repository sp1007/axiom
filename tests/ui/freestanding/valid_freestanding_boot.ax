// test: ui
// flags: --profile freestanding
module valid_freestanding_boot

use std.core.option.Option
use std.sync.atomic.Atomic
use std.sync.atomic.Ordering

pub struct InterruptFrame {
    pub rip: u64,
    pub cs: u64,
    pub rflags: u64,
    pub rsp: u64,
    pub ss: u64,
    pub ticks: Atomic<u64>,
}

pub struct PanicInfo {
    pub line: u32,
}

@section(".rodata.boot")
@used
pub static BOOT_MAGIC: u64 = 0x4158_494F_4D30_3031u64

pub extern "interrupt" fn irq_spurious() {
    let cnt = Atomic { v: BOOT_MAGIC };
    let _ = cnt.fetch_add(1u64, Ordering.Relaxed);
}

pub extern "interrupt" fn timer_isr(frame: view<InterruptFrame>) {
    let _ = frame.rip;
    let _ = frame.ticks.fetch_add(1u64, Ordering.Relaxed);
}

pub unsafe extern "interrupt" fn page_fault_isr(frame: *const InterruptFrame, err_code: u64) {
    let _ = frame;
    let cnt = Atomic { v: 0u64 };
    let _ = cnt.fetch_add(err_code, Ordering.Relaxed);
}

@naked
@section(".text.boot")
pub unsafe fn arch_halt() -> never {
    loop {}
}

@no_mangle
pub fn boot_abi_version() -> u32 {
    1u32
}

// Dead unreferenced helper calling hosted `print` must NOT fail capability verification (AXS-FRE-021.1).
fn dead_hosted_debug_helper() {
    print("unreachable in freestanding build")
}

@entry
@section(".text.entry")
pub fn _start() -> never {
    let opt: Option<u64> = Option.Some(BOOT_MAGIC);
    match opt {
        Option.Some(v) => {
            let _ = v + boot_abi_version() as u64;
        },
        Option.None => {},
    }
    unsafe { arch_halt() }
}

@panic_handler
pub fn on_panic(info: view<PanicInfo>) -> never {
    let _ = info.line;
    unsafe { arch_halt() }
}
