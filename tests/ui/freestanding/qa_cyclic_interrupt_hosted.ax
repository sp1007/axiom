// test: ui
// flags: --profile hosted
module qa_cyclic_interrupt_hosted

use std.alloc.box.box_new

pub struct InterruptFrame {
    pub rip: u64,
}

@blocking
fn hosted_blocking_op() {}

fn alloc_cycle_a(n: i32) {
    if n > 0 {
        alloc_cycle_b(n - 1);
    }
}

fn alloc_cycle_b(n: i32) {
    let _b = box_new(n);
    if n > 0 {
        alloc_cycle_a(n - 1);
    }
}

fn block_cycle_a(n: i32) {
    if n > 0 {
        block_cycle_b(n - 1);
    }
}

fn block_cycle_b(n: i32) {
    hosted_blocking_op();
    if n > 0 {
        block_cycle_a(n - 1);
    }
}

fn clean_cycle_a(n: i32) -> i32 {
    if n > 0 {
        return clean_cycle_b(n - 1);
    }
    0
}

fn clean_cycle_b(n: i32) -> i32 {
    if n > 0 {
        return clean_cycle_a(n - 1);
    }
    1
}

// Even under --profile hosted, extern "interrupt" MUST reject cyclic transitive alloc/blocking/IO (REQ-ABI-102).
pub extern "interrupt" fn isr_hosted_cycles(frame: view<InterruptFrame>) {
    let _ = frame;
    alloc_cycle_a(2); //~ ERROR AX_UNSAFE_INTERRUPT_FORBIDDEN_OP
    block_cycle_a(2); //~ ERROR AX_UNSAFE_INTERRUPT_FORBIDDEN_OP
    print("hosted isr io"); //~ ERROR AX_UNSAFE_INTERRUPT_FORBIDDEN_OP
    let _ok = clean_cycle_a(2);
}

pub fn main() -> i32 {
    let _ok_main = box_new(42i32);
    hosted_blocking_op();
    0
}
