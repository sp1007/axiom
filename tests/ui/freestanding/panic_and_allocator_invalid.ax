// test: ui
// flags: --profile freestanding
module panic_and_allocator_invalid

pub struct PanicInfo {
    pub code: u32,
}

pub trait GlobalAlloc {
    unsafe fn alloc(self: view<Self>, size: usize, align: usize) -> *mut u8
    unsafe fn dealloc(self: view<Self>, ptr: *mut u8, size: usize, align: usize)
}

pub struct ValidAlloc {
    pub x: usize,
}

impl GlobalAlloc for ValidAlloc {
    unsafe fn alloc(self: view<ValidAlloc>, size: usize, align: usize) -> *mut u8 {
        let _ = size;
        let _ = align;
        self.x as *mut u8
    }
    unsafe fn dealloc(self: view<ValidAlloc>, ptr: *mut u8, size: usize, align: usize) {
        let _ = self;
        let _ = ptr;
        let _ = size;
        let _ = align;
    }
}

pub struct NotAnAlloc {
    pub x: usize,
}

@panic_handler
pub fn first_panic(info: view<PanicInfo>) -> never {
    let _ = info.code;
    loop {}
}

@panic_handler //~ ERROR AX_TYPE_DUPLICATE_PANIC_HANDLER
pub fn second_panic() -> never {
    loop {}
}

@panic_handler //~ ERROR AX_TYPE_DUPLICATE_PANIC_HANDLER
//~^ ERROR AX_TYPE_INVALID_PANIC_HANDLER
pub fn bad_panic_ret() -> i32 {
    0
}

@panic_handler //~ ERROR AX_TYPE_DUPLICATE_PANIC_HANDLER
//~^ ERROR AX_TYPE_INVALID_PANIC_HANDLER
pub fn bad_panic_param(x: i32) -> never {
    let _ = x;
    loop {}
}

@panic_handler //~ ERROR AX_TYPE_INVALID_PANIC_HANDLER
pub static PANIC_ON_STATIC: i32 = 0

@global_allocator
static FIRST_ALLOC: ValidAlloc = ValidAlloc { x: 1usize }

@global_allocator //~ ERROR AX_TYPE_DUPLICATE_GLOBAL_ALLOCATOR
static SECOND_ALLOC: ValidAlloc = ValidAlloc { x: 2usize }

@global_allocator //~ ERROR AX_TYPE_DUPLICATE_GLOBAL_ALLOCATOR
//~^ ERROR AX_TYPE_INVALID_GLOBAL_ALLOCATOR
static UNIMPL_ALLOC: NotAnAlloc = NotAnAlloc { x: 3usize }

@global_allocator //~ ERROR AX_TYPE_INVALID_GLOBAL_ALLOCATOR
pub fn alloc_on_fn() -> i32 {
    0
}

@entry
pub fn _start() -> i32 {
    0
}
