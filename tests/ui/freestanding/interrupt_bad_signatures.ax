// test: ui
// flags: --profile freestanding
module interrupt_bad_signatures

pub struct InterruptFrame {
    pub rip: u64,
}

pub struct WrongFrame {
    pub rip: u64,
}

pub extern "interrupt" fn bad_ret() -> i32 { //~ ERROR AX_FFI_BAD_TYPE
    0
}

pub extern "interrupt" fn bad_param_scalar(x: u64) { //~ ERROR AX_FFI_BAD_TYPE
    let _ = x;
}

pub extern "interrupt" fn bad_param_mut_view(frame: mut_view<InterruptFrame>) { //~ ERROR AX_FFI_BAD_TYPE
    let _ = frame.rip;
}

pub extern "interrupt" fn bad_param_mut_ptr(frame: *mut InterruptFrame) { //~ ERROR AX_FFI_BAD_TYPE
    let _ = frame;
}

pub extern "interrupt" fn bad_param_wrong_struct(frame: view<WrongFrame>) { //~ ERROR AX_FFI_BAD_TYPE
    let _ = frame.rip;
}

pub extern "interrupt" fn bad_err_code_ty(frame: view<InterruptFrame>, code: u32) { //~ ERROR AX_FFI_BAD_TYPE
    let _ = frame;
    let _ = code;
}

pub extern "interrupt" fn bad_three_params(frame: view<InterruptFrame>, code: u64, extra: u64) { //~ ERROR AX_FFI_BAD_TYPE
    let _ = frame;
    let _ = code;
    let _ = extra;
}

pub extern "interrupt" fn bad_generic<T>() { //~ ERROR AX_FFI_BAD_TYPE
}

pub async extern "interrupt" fn bad_async_isr() { //~ ERROR AX_ASYNC_EXTERN_ABI
}

@entry
pub fn _start() -> i32 {
    0
}
