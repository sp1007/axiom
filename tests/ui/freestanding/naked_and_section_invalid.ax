// test: ui
// flags: --profile freestanding
module naked_and_section_invalid

pub struct BigAgg {
    pub a: u64,
    pub b: u64,
}

@naked //~ ERROR AX_TYPE_INVALID_NAKED_FN
pub fn naked_not_unsafe() {}

@naked //~ ERROR AX_TYPE_INVALID_NAKED_FN
pub unsafe async fn naked_async() {}

@naked
pub unsafe fn naked_with_local_spill() -> i32 {
    let arr: [8]i32 = [0; 8]; //~ ERROR AX_TYPE_INVALID_NAKED_FN
    arr[0]
}

@naked //~ ERROR AX_TYPE_INVALID_NAKED_FN
pub unsafe fn naked_stack_agg_param(big: BigAgg) -> u64 {
    big.a + big.b
}

@naked //~ ERROR AX_TYPE_INVALID_NAKED_FN
pub static NAKED_STATIC: i32 = 0

@section("") //~ ERROR AX_TYPE_INVALID_SECTION
pub static EMPTY_SEC: i32 = 1

@section(".abcdefghijklmnopqrstuvwxyz0123456789_abcdefghijklmnopqrstuvwxyz012345") //~ ERROR AX_TYPE_INVALID_SECTION
pub static TOO_LONG_SEC: i32 = 2

@section(".bad\nsec") //~ ERROR AX_TYPE_INVALID_SECTION
pub static CTRL_CHAR_SEC: i32 = 3

@section(123) //~ ERROR AX_TYPE_INVALID_SECTION
pub static INT_ARG_SEC: i32 = 4

@section() //~ ERROR AX_TYPE_INVALID_SECTION
pub static NO_ARG_SEC: i32 = 5

@section(".rodata") //~ ERROR AX_TYPE_INVALID_SECTION
pub struct SecOnStruct {
    pub v: i32,
}

@used //~ ERROR AX_TYPE_INVALID_SECTION
pub struct UsedOnStruct {
    pub v: i32,
}

@used("unexpected") //~ ERROR AX_TYPE_INVALID_SECTION
pub static USED_WITH_ARG: i32 = 6

pub fn sec_and_used_on_locals_and_params(
    @section(".param") a: i32, //~ ERROR AX_TYPE_INVALID_SECTION
    @used b: i32 //~ ERROR AX_TYPE_INVALID_SECTION
) -> i32 {
    @section(".local") let x: i32 = a; //~ ERROR AX_TYPE_INVALID_SECTION
    @used let y: i32 = b; //~ ERROR AX_TYPE_INVALID_SECTION
    x + y
}

@no_mangle //~ ERROR AX_FFI_GENERIC_EXPORT
pub fn generic_no_mangle<T>(v: T) -> T {
    v
}

@entry
pub fn _start() -> i32 {
    0
}
