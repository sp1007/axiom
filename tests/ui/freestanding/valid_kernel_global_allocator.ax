// test: ui
// flags: --profile kernel
module valid_kernel_global_allocator

use std.text.string.string_with_capacity

pub trait GlobalAlloc {
    unsafe fn alloc(self: view<Self>, size: usize, align: usize) -> *mut u8
    unsafe fn dealloc(self: view<Self>, ptr: *mut u8, size: usize, align: usize)
}

pub struct BumpAlloc {
    pub base: usize,
}

impl GlobalAlloc for BumpAlloc {
    unsafe fn alloc(self: view<BumpAlloc>, size: usize, align: usize) -> *mut u8 {
        let _ = size;
        let _ = align;
        self.base as *mut u8
    }
    unsafe fn dealloc(self: view<BumpAlloc>, ptr: *mut u8, size: usize, align: usize) {
        let _ = self;
        let _ = ptr;
        let _ = size;
        let _ = align;
    }
}

@global_allocator
static KERNEL_ALLOC: BumpAlloc = BumpAlloc { base: 0x100000usize }

// Pure bare-metal async fn state machine construction without OS reactor (AXS-FRE-021.1).
async fn bare_metal_step(x: u64) -> u64 {
    x + 1u64
}

fn kernel_init_heap() -> u64 {
    let s = string_with_capacity(16usize);
    let _fut = bare_metal_step(41u64);
    s.cap as u64
}

@entry
pub fn kmain(hart_id: usize) -> never {
    let _ = hart_id + (kernel_init_heap() as usize);
    loop {}
}

@panic_handler
pub fn kpanic() -> never {
    loop {}
}
