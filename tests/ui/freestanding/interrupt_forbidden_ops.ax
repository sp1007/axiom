// test: ui
// flags: --profile freestanding
module interrupt_forbidden_ops

use std.alloc.box.box_new
use std.core.host.heap_free
use std.core.host.thread_spawn

pub struct InterruptFrame {
    pub rip: u64,
}

pub trait GlobalAlloc {
    unsafe fn alloc(self: view<Self>, size: usize, align: usize) -> *mut u8
    unsafe fn dealloc(self: view<Self>, ptr: *mut u8, size: usize, align: usize)
}

pub struct DummyGlobalAlloc {
    pub tag: usize,
}

impl GlobalAlloc for DummyGlobalAlloc {
    unsafe fn alloc(self: view<DummyGlobalAlloc>, size: usize, align: usize) -> *mut u8 {
        let _ = size;
        let _ = align;
        self.tag as *mut u8
    }
    unsafe fn dealloc(self: view<DummyGlobalAlloc>, ptr: *mut u8, size: usize, align: usize) {
        let _ = self;
        let _ = ptr;
        let _ = size;
        let _ = align;
    }
}

// Even when @global_allocator is present, extern "interrupt" handlers MUST still reject heap allocation (REQ-ABI-102).
@global_allocator
static IRQ_TEST_ALLOC: DummyGlobalAlloc = DummyGlobalAlloc { tag: 1usize }

fn dummy_irq_thread_entry(ctx: *mut u8) -> i64 {
    let _ = ctx;
    0i64
}

@blocking
fn spin_park() {}

fn irq_hop2_alloc() {
    let _b = box_new(7i32);
}

fn irq_hop1_alloc() {
    irq_hop2_alloc()
}

fn irq_hop1_block() {
    spin_park()
}

fn irq_hop1_spawn() {
    let _ = unsafe { thread_spawn(dummy_irq_thread_entry, 0 as *mut u8, 0usize) };
}

async fn async_step() -> i32 {
    1
}

pub struct HeapDropGuard {
    pub ptr: *mut u8,
}

impl Drop for HeapDropGuard {
    fn drop(self: mut_view<HeapDropGuard>) {
        if (self.ptr as usize) != 0 {
            unsafe { heap_free(self.ptr, 8usize, 8usize); }
        }
    }
}

pub extern "interrupt" fn isr_direct_and_transitive(frame: view<InterruptFrame>) {
    let _ = frame;
    let _b1 = box_new(1i32); //~ ERROR AX_UNSAFE_INTERRUPT_FORBIDDEN_OP
    irq_hop1_alloc(); //~ ERROR AX_UNSAFE_INTERRUPT_FORBIDDEN_OP
    spin_park(); //~ ERROR AX_UNSAFE_INTERRUPT_FORBIDDEN_OP
    irq_hop1_block(); //~ ERROR AX_UNSAFE_INTERRUPT_FORBIDDEN_OP
    irq_hop1_spawn(); //~ ERROR AX_UNSAFE_INTERRUPT_FORBIDDEN_OP
    print("isr io"); //~ ERROR AX_UNSAFE_INTERRUPT_FORBIDDEN_OP
    let _v = async_step().await; //~ ERROR AX_UNSAFE_INTERRUPT_FORBIDDEN_OP
    //~^ ERROR AX_UNSAFE_INTERRUPT_FORBIDDEN_OP
    let _g = HeapDropGuard { ptr: 0 as *mut u8 }; //~ ERROR AX_UNSAFE_INTERRUPT_FORBIDDEN_OP
}

@entry
pub fn _start() -> i32 {
    let _ok_in_task = box_new(99i32);
    0
}
