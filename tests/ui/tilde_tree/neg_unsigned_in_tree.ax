// test: ui
// T499 (ADR-0044 section 2): unary `-` of an unsigned leaf stays an error inside a widening tree, while `~` of the
// same leaf is accepted and evaluated in the tree context.
fn f(b8: u8, s64: i64) -> i64 {
    let ok: i64 = ~b8 + s64;
    let t: i64 = -b8 + s64; //~ ERROR AX_TYPE_NEG_UNSIGNED
    ok + t
}

fn main() {
    let _ = f(1u8, 2i64);
}
