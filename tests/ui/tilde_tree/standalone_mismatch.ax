// test: ui
// T499 (SPEC-40 AXS-INT-050.2, ADR-0044 section 2): a `~x` that is not part of a widening tree keeps x's type and is
// not widened implicitly at a binding, return or argument.
fn take_i64(v: i64) -> i64 { v }

fn g(x: u8) -> i64 {
    ~x //~ ERROR AX_TYPE_MISMATCH
}

fn main() {
    let x: u8 = 7u8;
    let f: i32 = ~x; //~ ERROR AX_TYPE_MISMATCH
    let h = take_i64(~x); //~ ERROR AX_TYPE_MISMATCH
    let ok: u8 = ~x;
    let _ = g(x);
}
