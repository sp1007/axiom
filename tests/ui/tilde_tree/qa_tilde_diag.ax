// test: ui
// QA (T499 gate): the synthetic promotion cast is only inserted for a valid widening `~` operand; every erroneous tree
// keeps the diagnostic code it had before T499, reported on the line of the offending tree.
fn e1(s64: i64, s32: i32) -> i32 {
    let r: i32 = ~s64 + s32; //~ ERROR AX_TYPE_MISMATCH
    r
}

fn e2(flag: bool, s64: i64) -> i64 {
    let r: i64 = ~flag + s64; //~ ERROR AX_TYPE_OPERATOR
    r
}

fn e3(b8: u8, s8: i8) -> i8 {
    let r: i8 = ~b8 + s8; //~ ERROR AX_TYPE_MISMATCH
    r
}

fn e4(b8: u8, s64: i64) -> i32 {
    let r: i32 = ~b8 + s64; //~ ERROR AX_TYPE_MISMATCH
    r
}

fn e5(b8: u8, s64: i64) -> i64 {
    let r: i64 = ~-b8 + s64; //~ ERROR AX_TYPE_NEG_UNSIGNED
    r
}

fn e6(b8: u8, t: bool, s64: i64) -> i64 {
    let r: i64 = ~(b8 + t) + s64; //~ ERROR AX_TYPE_MISMATCH
    r
}

fn main() {
    let _ = e1(1i64, 2i32);
}
