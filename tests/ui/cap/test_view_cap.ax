// test: ui
struct S {
    v: view<i32>,
}

fn test_outlives_owner() {
    let mut v: view<i32>;
    {
        let a = 1;
        v = view(a); //~ ERROR AX_CAP_OUTLIVES_OWNER
    }
}

fn test_conflict() {
    let mut a = 1;
    let v1 = mut_view(a);
    let v2 = view(a); //~ ERROR AX_CAP_CONFLICT_READ
}

fn test_conflict_mut() {
    let mut a = 1;
    let v1 = view(a);
    let v2 = mut_view(a); //~ ERROR AX_CAP_CONFLICT_MUT
}

struct Cursor {
    v: view<[4]i32>,
    idx: usize,
}

fn test_cursor_loop() {
    let mut c: Cursor;
    {
        let arr = [1, 2, 3, 4];
        c = Cursor { v: view(arr), idx: 0 }; //~ ERROR AX_CAP_OUTLIVES_OWNER
        while 4 > c.idx {
            c.idx = c.idx + 1;
        }
    }
}
