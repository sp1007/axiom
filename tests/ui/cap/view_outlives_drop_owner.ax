// test: ui
// T157 / SPEC-11 AXS-CAP-004, AXS-CAP-009 (ADR-0036 section 3): a view bound in an inner block to
// an owner of that block and stored in an outer `view<T>` local that is used after the block still
// outlives its owner, with a droppable owner type and with `i32`. Exactly one diagnostic per
// violation, at the binding `keep = view(a)`, in both axiom0 and axiomc (the scope-end drop of `a`
// is not reported a second time).

struct D {
    pub x: i32,
}

impl Drop for D {
    fn drop(self: mut_view<Self>) {
        print("d\n");
    }
}

fn use_d(v: view<D>) -> i32 {
    v.x
}

fn use_i(v: view<i32>) -> i32 {
    *v
}

fn drop_owner() -> i32 {
    let x0 = D { x: 0 };
    let mut keep: view<D> = view(x0);
    {
        let a = D { x: 1 };
        keep = view(a); //~ ERROR AX_CAP_OUTLIVES_OWNER
    }
    use_d(keep)
}

fn int_owner() -> i32 {
    let x0 = 0;
    let mut keep: view<i32> = view(x0);
    {
        let a = 1;
        keep = view(a); //~ ERROR AX_CAP_OUTLIVES_OWNER
    }
    use_i(keep)
}

fn moved_owner_still_viewed() -> i32 {
    let a = D { x: 2 };
    let va: view<D> = view(a);
    let b = a; //~ ERROR AX_CAP_OUTLIVES_OWNER
    use_d(va)
}

fn moved_owner_view_dead() -> i32 {
    let a = D { x: 3 };
    let va: view<D> = view(a);
    let r = use_d(va);
    let b = a;
    r
}
