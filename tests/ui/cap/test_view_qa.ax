// test: ui

struct SingleView {
    v: view<i32>,
}

fn test_conflict_mut_mut() {
    let mut a = 1;
    let v1 = mut_view(a);
    let v2 = mut_view(a); //~ ERROR AX_CAP_CONFLICT_MUT
}

fn test_shared_shared_ok() {
    let a = 1;
    let v1 = view(a);
    let v2 = view(a);
}

fn test_stored_view_outlives() {
    let mut sv: SingleView;
    {
        let a = 10;
        sv = SingleView { v: view(a) }; //~ ERROR AX_CAP_OUTLIVES_OWNER
    }
}
