// test: ui
// T157 QA (SPEC-11 AXS-CAP-004 / AXS-CAP-009): the last-use extent of a view local must not hide a
// real violation. Each function moves or drops a droppable owner while a view of it (or a copy of
// that view, or a struct holding it) is still used on some later path: loops (the use is on the next
// iteration), branches, a copied view, a stored view, a field view, a move into a call argument and
// a mut_view. Exactly one AX_CAP_OUTLIVES_OWNER per function, at the move.

struct D {
    pub x: i32,
}

impl Drop for D {
    fn drop(self: mut_view<Self>) {
        print("d\n");
    }
}

struct W {
    v: view<D>,
}

fn use_d(v: view<D>) -> i32 {
    v.x
}

fn use_i(v: view<i32>) -> i32 {
    *v
}

fn consume(d: D) -> i32 {
    d.x
}

fn loop_move_then_use(c: bool) -> i32 {
    let a = D { x: 1 };
    let v = view(a);
    let mut s = 0;
    while c {
        s = s + use_d(v);
        let b = a; //~ ERROR AX_CAP_OUTLIVES_OWNER
    }
    s
}

fn loop_back_edge_use() -> i32 {
    let mut i = 0;
    let mut s = 0;
    let a = D { x: 1 };
    let v = view(a);
    while i < 2 {
        if i == 1 {
            let b = a; //~ ERROR AX_CAP_OUTLIVES_OWNER
        }
        s = s + use_d(v);
        i = i + 1;
    }
    s
}

fn branch_move_then_use(c: bool) -> i32 {
    let a = D { x: 1 };
    let v = view(a);
    if c {
        let b = a; //~ ERROR AX_CAP_OUTLIVES_OWNER
    }
    use_d(v)
}

fn copied_view(c: bool) -> i32 {
    let a = D { x: 1 };
    let v = view(a);
    let v2 = v;
    let b = a; //~ ERROR AX_CAP_OUTLIVES_OWNER
    use_d(v2)
}

fn stored_view() -> i32 {
    let a = D { x: 1 };
    let w = W { v: view(a) };
    let b = a; //~ ERROR AX_CAP_OUTLIVES_OWNER
    use_d(w.v)
}

fn field_view() -> i32 {
    let a = D { x: 1 };
    let v = view(a.x);
    let b = a; //~ ERROR AX_CAP_OUTLIVES_OWNER
    use_i(v)
}

fn moved_into_call() -> i32 {
    let a = D { x: 1 };
    let v = view(a);
    let n = consume(a); //~ ERROR AX_CAP_OUTLIVES_OWNER
    n + use_d(v)
}

fn mut_view_then_move() -> i32 {
    let mut a = D { x: 1 };
    let mv = mut_view(a);
    let b = a; //~ ERROR AX_CAP_OUTLIVES_OWNER
    mv.x = 2;
    0
}

fn param_owner_moved(a: D) -> i32 {
    let v = view(a);
    let b = a; //~ ERROR AX_CAP_OUTLIVES_OWNER
    use_d(v)
}
