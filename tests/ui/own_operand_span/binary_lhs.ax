// test: ui
// stderr-contains: binary_lhs.ax:20:13
// T498f (SPEC-10 AXS-OWN-006): a use after move in the left operand of `+` is reported at that
// operand (`hs[1].n`, column 13).

struct H {
    n: u32,
}

fn mk() -> H {
    H { n: 1u32 }
}

fn take(h: [2]H) {}

fn main() -> i32 {
    let hs: [2]H = [mk(), mk()];
    let k: u32 = 3u32;
    take(hs);
    let u = hs[1].n + k; //~ ERROR AX_MOVE_USE_AFTER_MOVE
    print_int(u as i64);
    0
}
