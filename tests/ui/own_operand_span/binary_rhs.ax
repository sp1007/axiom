// test: ui
// stderr-contains: binary_rhs.ax:20:20
// T498f (SPEC-10 AXS-OWN-006): a use after move in the right operand of `+` is reported at that
// operand (`hs[i].n`, column 20), not at the start of the binary expression.

struct H {
    n: u32,
}

fn mk() -> H {
    H { n: 1u32 }
}

fn take(h: [2]H) {}

fn main() -> i32 {
    let hs: [2]H = [mk(), mk()];
    let i: usize = 0;
    take(hs);
    let u = 1u32 + hs[i].n; //~ ERROR AX_MOVE_USE_AFTER_MOVE
    print_int(u as i64);
    0
}
