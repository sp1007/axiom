// test: ui
// stderr-contains: call_arg.ax:24:20
// T498f (SPEC-10 AXS-OWN-006): a use after move in a call argument is reported at that argument
// (`hs[0].n`, column 20), not at the call.

struct H {
    n: u32,
}

fn mk() -> H {
    H { n: 1u32 }
}

fn take(h: [2]H) {}

fn add(a: u32, b: u32) -> u32 {
    a + b
}

fn main() -> i32 {
    let hs: [2]H = [mk(), mk()];
    let k: u32 = 3u32;
    take(hs);
    let u = add(k, hs[0].n); //~ ERROR AX_MOVE_USE_AFTER_MOVE
    print_int(u as i64);
    0
}
