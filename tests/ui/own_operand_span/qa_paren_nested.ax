// test: ui
// stderr-contains: qa_paren_nested.ax:14:14
// QA (T498f): a use after move inside a nested operand is reported at the moved operand itself.

struct H {
    n: u32,
}

fn mk() -> H { H { n: 1u32 } }
fn take(h: [2]H) {}
fn main() -> i32 {
    let hs: [2]H = [mk(), mk()];
    take(hs);
    let e = (hs[0].n + 1u32) * 3u32; //~ ERROR AX_MOVE_USE_AFTER_MOVE
    0
}
