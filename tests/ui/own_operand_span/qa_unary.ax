// test: ui
// stderr-contains: qa_unary.ax:14:15
// QA (T498f): a use after move inside a nested operand is reported at the moved operand itself.

struct H {
    n: u32,
}

fn mk() -> H { H { n: 1u32 } }
fn take(h: [2]H) {}
fn main() -> i32 {
    let hs: [2]H = [mk(), mk()];
    take(hs);
    let b = -(hs[0].n as i32); //~ ERROR AX_MOVE_USE_AFTER_MOVE
    0
}
