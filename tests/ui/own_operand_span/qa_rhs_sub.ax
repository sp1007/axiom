// test: ui
// stderr-contains: qa_rhs_sub.ax:14:20
// QA (T498f): a use after move inside a nested operand is reported at the moved operand itself.

struct H {
    n: u32,
}

fn mk() -> H { H { n: 1u32 } }
fn take(h: [2]H) {}
fn main() -> i32 {
    let hs: [2]H = [mk(), mk()];
    take(hs);
    let f = 7u32 - hs[1].n; //~ ERROR AX_MOVE_USE_AFTER_MOVE
    0
}
