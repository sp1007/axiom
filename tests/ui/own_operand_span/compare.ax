// test: ui
// stderr-contains: compare.ax:20:12
// T498f (SPEC-10 AXS-OWN-006): a use after move in the right operand of a comparison is reported at
// that operand (`hs[0].n`, column 12).

struct H {
    n: u32,
}

fn mk() -> H {
    H { n: 1u32 }
}

fn take(h: [2]H) {}

fn main() -> i32 {
    let hs: [2]H = [mk(), mk()];
    let k: u32 = 3u32;
    take(hs);
    if k < hs[0].n { //~ ERROR AX_MOVE_USE_AFTER_MOVE
        return 1;
    }
    0
}
