// test: ui
// T498f: index writes that stay valid — into a `let mut` array (element, field of element, nested,
// compound, range sub-slice), through an immutable binding of a `mut_view<[T]>` (the binding itself
// is not written, AXS-SEM-047), and into the pointee of a `mut_view` element held by an immutable
// array.

struct H {
    n: u32,
}

fn mk() -> H {
    H { n: 1u32 }
}

fn bump(v: mut_view<[u32]>) {
    v[0] = 7u32;
    v[1] += 1u32;
    let sub = v[0..1];
    sub[0] = 8u32;
}

fn set_n(h: mut_view<H>) {
    let hs: [1]mut_view<H> = [h];
    hs[0].n = 9u32;
}

fn main() -> i32 {
    let mut a: [2]u32 = [1u32, 2u32];
    a[0] = 9u32;
    a[1] += 1u32;
    let mut hs: [2]H = [mk(), mk()];
    hs[0].n = 5u32;
    hs[1].n <<= 1u32;
    let mut m: [2][2]u32 = [[1u32, 2u32], [3u32, 4u32]];
    m[1][0] = 6u32;
    let mut d: [2]u32;
    d = [0u32, 0u32];
    d[1] = 3u32;
    bump(mut_view(a));
    let mut h = mk();
    set_n(mut_view(h));
    print_int((a[0] + a[1] + hs[0].n + hs[1].n + m[1][0] + d[1] + h.n) as i64);
    0
}
