// test: ui
// stderr-contains: qa_params_tuples_ranges.ax:20:5
// QA (T498f): the walk reaches the base binding through a by-value parameter, a struct field that
// is an array, a tuple field that is an array, and a range sub-slice used as a place.

struct H {
    n: u32,
}

struct W {
    hs: [2]H,
    t: (u32, [2]u32),
}

fn param(p: [2]u32) {
    p[0] = 1u32; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
}

fn field_array(w: W) {
    w.hs[0].n = 1u32; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
}

fn tuple_array(w: W) {
    w.t.1[0] = 1u32; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
}

fn through_view(w: view<W>) {
    w.hs[0].n = 1u32; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
}

fn main() -> i32 {
    let b: [2]u32 = [1u32, 2u32];
    b[0..1][0] = 5u32; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    let t: ([2]u32, u32) = ([1u32, 2u32], 3u32);
    t.0[1] = 5u32; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    print_int(b[0] as i64);
    print_int(t.0[1] as i64);
    0
}
