// test: ui
// stderr-contains: mut_view_of_elem.ax:28:18
// T498f (SPEC-02 AXS-GRM-041, SPEC-03 AXS-SEM-047): taking `mut_view` of an element (or a field of an
// element, or a field) of an immutable binding is a write capability into it and is rejected with
// AX_TYPE_ASSIGN_IMMUTABLE; taking it through a read-only `view` is AX_CAP_CONFLICT_MUT.

struct H {
    n: u32,
}

fn mk() -> H {
    H { n: 1u32 }
}

fn set(p: mut_view<u32>) {
    *p = 3u32;
}

fn through_view(v: view<[u32]>, h: view<H>) {
    set(mut_view(v[0])); //~ ERROR AX_CAP_CONFLICT_MUT
    set(mut_view(h.n)); //~ ERROR AX_CAP_CONFLICT_MUT
}

fn main() -> i32 {
    let a: [2]u32 = [1u32, 2u32];
    let hs: [2]H = [mk(), mk()];
    let s = mk();
    set(mut_view(a[0])); //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    set(mut_view(hs[1].n)); //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    set(mut_view(s.n)); //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    let mut b: [2]u32 = [1u32, 2u32];
    set(mut_view(b[1]));
    through_view(view(b), view(s));
    print_int((a[0] + hs[1].n + s.n + b[1]) as i64);
    0
}
