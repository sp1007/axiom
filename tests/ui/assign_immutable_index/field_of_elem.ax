// test: ui
// stderr-contains: field_of_elem.ax:16:5
// T498f (SPEC-02 AXS-GRM-041): a write to a field of an element `hs[0].n = v` into an immutable
// `let` binding is rejected.

struct H {
    n: u32,
}

fn mk() -> H {
    H { n: 1u32 }
}

fn main() -> i32 {
    let hs: [2]H = [mk(), mk()];
    hs[0].n = 5u32; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    print_int(hs[0].n as i64);
    0
}
