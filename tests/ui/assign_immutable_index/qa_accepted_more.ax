// test: ui
// QA (T498f): no false positives — shadowing (the write goes to the innermost binding, which is
// `mut`), `mut` parameters and receivers, pattern bindings with `mut`, writes through a `mut_view`
// receiver, `mut_view(a[i])` of a `mut` array of arrays, and a raw `*mut` array pointer.

struct S {
    arr: [3]u32,
    k: u32,
}

fn bump(p: mut_view<u32>) {
    *p = *p + 1u32;
}

impl S {
    fn setm(self: mut_view<S>) {
        self.arr[0] = 1u32;
        self.k += 1u32;
        bump(mut_view(self.arr[1]));
    }
    fn seto(mut self: S) -> S {
        self.arr[2] = 4u32;
        self
    }
}

fn pair() -> ([2]u32, [2]u32) {
    ([1u32, 2u32], [3u32, 4u32])
}

fn raw(p: *mut [2]u32) {
    unsafe {
        (*p)[0] = 1u32;
    }
}

fn byval(mut p: [2]u32) -> u32 {
    p[0] = 1u32;
    p[0] + p[1]
}

fn main() -> i32 {
    let (mut p, q) = pair();
    p[0] = 1u32;
    let a2 = p;
    let mut a = a2;
    a[1] = 3u32;
    let a = a;
    let mut arrs: [2][2]u32 = [[0u32, 0u32], [0u32, 0u32]];
    arrs[1][1] = 4u32;
    bump(mut_view(arrs[0][1]));
    let mut s = S { arr: [0u32, 0u32, 0u32], k: 0u32 };
    s.setm();
    let s2 = s.seto();
    let mut r: [2]u32 = [0u32, 0u32];
    r[1] = 2u32;
    print_int((a[1] + q[0] + arrs[1][1] + s2.arr[2] + r[0] + byval(r)) as i64);
    0
}
