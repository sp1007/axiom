// test: ui
// stderr-contains: deferred_let.ax:8:5
// T498f (SPEC-02 AXS-GRM-041): a deferred binding `let a: [2]u32` is initialised only by a whole
// assignment; writing one element of it is a write into an immutable binding.

fn main() -> i32 {
    let a: [2]u32;
    a[0] = 1u32; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    0
}
