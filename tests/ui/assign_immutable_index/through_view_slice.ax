// test: ui
// stderr-contains: through_view_slice.ax:9:5
// T498f (SPEC-03 AXS-SEM-047): an element write through a `view<[T]>` is rejected even when the
// base binding is `mut`; a range sub-slice of an immutable array used as a place walks back to the
// array binding.

fn set(v: view<[u32]>) {
    let mut w = v;
    w[0] = 1u32; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
}

fn main() -> i32 {
    let a: [3]u32 = [1u32, 2u32, 3u32];
    a[0..2][1] = 5u32; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    set(view(a));
    0
}
