// test: ui
// stderr-contains: elem_write.ax:9:5
// T498f (SPEC-02 AXS-GRM-041): an element write `a[0] = v` into an immutable `let` binding is
// rejected exactly like a field write `s.n = v`; the error points at the assigned place.

fn main() -> i32 {
    let a: [2]u32 = [1u32, 2u32];
    let i: usize = 1;
    a[0] = 9u32; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    print_int(a[i] as i64);
    0
}
