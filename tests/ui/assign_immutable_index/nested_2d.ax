// test: ui
// stderr-contains: nested_2d.ax:10:5
// T498f (SPEC-02 AXS-GRM-041, SPEC-03 AXS-SEM-042): a nested element write `m[i][j] = v` walks every
// index step back to the immutable binding `m`.

fn main() -> i32 {
    let m: [2][3]u32 = [[1u32, 2u32, 3u32], [4u32, 5u32, 6u32]];
    let i: usize = 1;
    let j: usize = 2;
    m[i][j] = 7u32; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    print_int(m[i][j] as i64);
    0
}
