// test: ui
// stderr-contains: compound.ax:18:5
// T498f (SPEC-03 AXS-SEM-044): every compound assignment through an index into an immutable binding
// is rejected (`+=` on an element, `<<=` on a field of an element).

struct H {
    n: u32,
}

fn mk() -> H {
    H { n: 1u32 }
}

fn main() -> i32 {
    let a: [2]u32 = [1u32, 2u32];
    let hs: [2]H = [mk(), mk()];
    let i: usize = 0;
    a[i] += 1u32; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    hs[1].n <<= 2u32; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    print_int(a[i] as i64);
    print_int(hs[1].n as i64);
    0
}
