// test: ui
// stderr-contains: qa_all_compound_ops.ax:11:5
// stderr-contains: qa_all_compound_ops.ax:18:5
// QA (T498f): every compound-assignment operator through an index into an immutable binding is
// rejected, and the same operators into a `let mut` array are accepted.

fn main() -> i32 {
    let b: [2]u32 = [1u32, 2u32];
    b[0] += 1u32; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    b[0] -= 1u32; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    b[0] *= 2u32; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    b[0] /= 1u32; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    b[0] %= 3u32; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    b[0] &= 1u32; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    b[0] |= 1u32; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    b[0] ^= 1u32; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    b[0] <<= 1u32; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    b[0] >>= 1u32; //~ ERROR AX_TYPE_ASSIGN_IMMUTABLE
    let mut a: [2]u32 = [1u32, 2u32];
    a[0] += 1u32;
    a[0] -= 1u32;
    a[0] *= 2u32;
    a[0] /= 1u32;
    a[0] %= 3u32;
    a[0] &= 1u32;
    a[0] |= 1u32;
    a[0] ^= 1u32;
    a[0] <<= 1u32;
    a[0] >>= 1u32;
    print_int((a[0] + b[0]) as i64);
    0
}
