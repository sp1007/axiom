// test: ui
// T499a: one element of a tuple expression built from variables has the wrong type for the annotation:
// AX_TYPE_MISMATCH, no crash.
fn f(s64: i64, flag: bool) -> i64 {
    let t: (i64, i32) = (s64, flag) //~ ERROR AX_TYPE_MISMATCH
    t.0
}

fn main() -> i32 {
    let _ = f(5i64, true)
    0
}
