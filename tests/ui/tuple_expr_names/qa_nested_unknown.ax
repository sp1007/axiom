// test: ui
// stderr-contains: qa_nested_unknown.ax:8:22
// QA (T499a gate): an unknown name nested two levels deep in a tuple expression, between known names, is exactly one
// AX_NAME_UNRESOLVED at the unknown name (the annotated line must carry exactly one diagnostic).
fn main() -> i32 {
    let a = 1i64
    let b = 2i64
    let t = (a, (b, (nope_name, a)), b) //~ ERROR AX_NAME_UNRESOLVED
    0
}
