// test: ui
// T496a / SPEC-02 AXS-GRM-070, ADR-0045: `a..=` without an end bound is a syntax error (it must never be
// lowered as the open range `a..`); `a..=b` and `..=b` are accepted.

fn main() {
    let a: [8]i32 = [10, 20, 30, 40, 50, 60, 70, 80];
    let s: view<[i32]> = view(a);
    let ok1 = s[1..=2];
    let ok2 = s[..=2];
    let ok3 = s[1..];
    let bad = s[1..=]; //~ ERROR AX_PARSE_EXPECTED_EXPR
}
