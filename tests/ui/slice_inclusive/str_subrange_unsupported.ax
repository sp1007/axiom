// test: ui
// T496b: `str` sub-range slicing (`s[a..=b]`, `s[..=b]`, `s[a..b]`) is currently rejected by the MIR
// verifier (`compiler/verify/verifier.ax`: `MIR_PROJ_SUB_SLICE` allows only `TY_ARRAY` / `TY_SLICE`).
// Tested on ASCII and multi-byte UTF-8 ("Xin chào thế giới").

fn main() {
    let ascii: str = "abcdefgh";
    let utf8: str = "Xin chào thế giới";
    let _a1: str = ascii[0..=2];  //~ ERROR AX_VERIFY_TYPE_MISMATCH
    let _a2: str = ascii[..=2];   //~ ERROR AX_VERIFY_TYPE_MISMATCH
    let _u1: str = utf8[0..=2];   //~ ERROR AX_VERIFY_TYPE_MISMATCH
    let _u2: str = utf8[..=2];    //~ ERROR AX_VERIFY_TYPE_MISMATCH
    let _u3: str = utf8[0..2];    //~ ERROR AX_VERIFY_TYPE_MISMATCH
}
