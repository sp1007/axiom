// test: ui
// QA boundary cross-check (T496b): `a..=` and `..=` without an end bound must be rejected once
// by the parser across array literals, prefix call arg, `no_struct` if/while headers, match arms,
// and block-trailing return without cascading or duplicate lowering diagnostics.

fn take(x: i32) {
    let _ = x;
}

fn main() {
    let a: i32 = 1;
    let _arr1 = [a..=];    //~ ERROR AX_PARSE_EXPECTED_EXPR
    let _arr2 = [..=];     //~ ERROR AX_PARSE_EXPECTED_EXPR
    take(..=);             //~ ERROR AX_PARSE_EXPECTED_EXPR
    if a..= {              //~ ERROR AX_PARSE_EXPECTED_EXPR
    }
    while ..= {            //~ ERROR AX_PARSE_EXPECTED_EXPR
    }
    match a {
        _ => a..=,         //~ ERROR AX_PARSE_EXPECTED_EXPR
    }
    {
        return a..=        //~ ERROR AX_PARSE_EXPECTED_EXPR
    }
}
