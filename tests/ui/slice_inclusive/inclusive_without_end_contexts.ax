// test: ui
// T496b / SPEC-02 AXS-GRM-070, ADR-0045: `a..=` and `..=` without an end bound are reported once
// by the parser (not duplicated by HIR lowering) across index, let, for, call, and paren contexts.

fn consume_range(x: i32) {
    let _ = x;
}

fn main() {
    let a: [4]i32 = [1, 2, 3, 4];
    let s: view<[i32]> = view(a);
    let _p = s[..=];       //~ ERROR AX_PARSE_EXPECTED_EXPR
    let _r1 = 0..=;        //~ ERROR AX_PARSE_EXPECTED_EXPR
    let _r2 = ..=;         //~ ERROR AX_PARSE_EXPECTED_EXPR
    for _i in 0..= {       //~ ERROR AX_PARSE_EXPECTED_EXPR
    }
    for _j in ..= {        //~ ERROR AX_PARSE_EXPECTED_EXPR
    }
    let _r3 = (0..=);      //~ ERROR AX_PARSE_EXPECTED_EXPR
    let _ = consume_range;
}
