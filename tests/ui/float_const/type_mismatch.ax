// test: ui
// T458b (SPEC-41 AXS-FLT-003 rule 2, AXS-FLT-001): a float constant's initializer must have its declared type; no
// implicit conversion between integer and float constants or between f32 and f64 (the existing AX_TYPE_MISMATCH).

const X: f32 = 1; //~ ERROR AX_TYPE_MISMATCH
const Y: f64 = 2.5f32; //~ ERROR AX_TYPE_MISMATCH
const Z: i32 = 1.5; //~ ERROR AX_TYPE_MISMATCH
const OK: f64 = 1.5;
static S: f32 = OK; //~ ERROR AX_TYPE_MISMATCH

fn main() -> i32 {
    0
}
