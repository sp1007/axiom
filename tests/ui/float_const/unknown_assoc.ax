// test: ui
// T458b (SPEC-41 AXS-FLT-004): `f64.NAME` resolves like `i32.NAME`; a name no impl declares is the existing
// AX_TYPE_UNKNOWN_FIELD (formerly AX_NAME_UNRESOLVED for the f32 / f64 heads). `f32.MAX` is a std constant (T460),
// not a built-in like the integer MIN / MAX / BITS.

impl f64 {
    pub const RADIX: u32 = 2u32;
}

fn main() -> i32 {
    let a = f64.NOPE; //~ ERROR AX_TYPE_UNKNOWN_FIELD
    let b = f32.MAX; //~ ERROR AX_TYPE_UNKNOWN_FIELD
    let c = f32.RADIX; //~ ERROR AX_TYPE_UNKNOWN_FIELD
    let d = i32.NOPE; //~ ERROR AX_TYPE_UNKNOWN_FIELD
    let e = f64.RADIX;
    0
}
