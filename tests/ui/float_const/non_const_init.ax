// test: ui
// T458b: float constant initializers the oracle cannot evaluate at compile time report the same codes as integer
// ones: a call that never returns, a read of a `static mut` and an unbounded loop.

fn spin() -> f64 {
    loop {}
}

static mut SM: f64 = 1.0;

const L: f64 = spin(); //~ ERROR AX_CONST_OVERFLOW
const R: f64 = unsafe { SM }; //~ ERROR AX_CONST_OVERFLOW
const INF_LOOP: f64 = loop {}; //~ ERROR AX_CONST_EVAL_LIMIT

fn main() -> i32 {
    0
}
