// test: ui
// QA (T483 round 0): a constant initialiser that is not a bare scalar expression (block, array, tuple) is evaluated
// by the MIR interpreter const path; its out-of-range shift must be AX_CONST_SHIFT_RANGE too (the MIR builder guards
// every shift with `assert(.. , "shift amount out of range")`), not AX_CONST_OVERFLOW.

const BLK: u32 = { 1u32 << 32u32 }; //~ ERROR AX_CONST_SHIFT_RANGE
const ARR: [2]u8 = [1u8 << 8u8, 0u8]; //~ ERROR AX_CONST_SHIFT_RANGE
const TUP: (u32, u32) = (1u32 >> 40u32, 0u32); //~ ERROR AX_CONST_SHIFT_RANGE
const NEG: [1]i64 = [1i64 << -1i32]; //~ ERROR AX_CONST_SHIFT_RANGE
const OVF: [1]u8 = [250u8 + 10u8]; //~ ERROR AX_CONST_OVERFLOW
const OK_ARR: [2]u8 = [1u8 << 7u8, 1u8 >> 0u8];

fn main() {
}
