// test: ui
// QA (T483 round 0): boundary counts at every width: BITS - 1 accepted, BITS rejected, and a count whose 64-bit
// truncation would look in range (2^64 + 1 on a u128 count) is still rejected; count types differ from the value type.

const OK_I16: i16 = 1i16 << 15u8;
const OK_U16: u16 = 0x8000u16 >> 15i64;
const OK_I8_SHR: i8 = -128i8 >> 7u128;
const OK_U128_BY_I8: u128 = 1u128 << 127i8;

const BAD_I16: i16 = 1i16 << 16u8; //~ ERROR AX_CONST_SHIFT_RANGE
const BAD_U16_SHR: u16 = 1u16 >> 16i64; //~ ERROR AX_CONST_SHIFT_RANGE
const BAD_I8_SHR_NEG: i8 = -128i8 >> -7i8; //~ ERROR AX_CONST_SHIFT_RANGE
const BAD_HI_BITS: u128 = 1u128 << 18446744073709551617u128; //~ ERROR AX_CONST_SHIFT_RANGE
const BAD_U128_BY_I8: u128 = 1u128 << 127i8 << 200u8; //~ ERROR AX_CONST_SHIFT_RANGE
const BAD_ISIZE: isize = 1isize << 64u8; //~ ERROR AX_CONST_SHIFT_RANGE
const BAD_USIZE: usize = 1usize >> 64u8; //~ ERROR AX_CONST_SHIFT_RANGE

fn main() {
}
