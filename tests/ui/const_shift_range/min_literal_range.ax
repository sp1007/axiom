// test: ui
// T483 (SPEC-40 AXS-INT-004): every MIN literal is valid, but a literal one past MAX without `-` is still
// AX_TYPE_LITERAL_OUT_OF_RANGE, and so is a negated literal one below MIN.

const OK_I8: i8 = -128i8;
const OK_I16: i16 = -32768i16;
const OK_I32: i32 = -2147483648i32;
const OK_I64: i64 = -9223372036854775808i64;
const OK_ISIZE: isize = -9223372036854775808isize;
const OK_I128: i128 = -170141183460469231731687303715884105728i128;

const BAD_I8: i8 = 128i8; //~ ERROR AX_TYPE_LITERAL_OUT_OF_RANGE
const BAD_I64: i64 = 9223372036854775808i64; //~ ERROR AX_TYPE_LITERAL_OUT_OF_RANGE
const BAD_I128: i128 = 170141183460469231731687303715884105728i128; //~ ERROR AX_TYPE_LITERAL_OUT_OF_RANGE
const BAD_NEG_I8: i8 = -129i8; //~ ERROR AX_TYPE_LITERAL_OUT_OF_RANGE
const BAD_NEG_I64: i64 = -9223372036854775809i64; //~ ERROR AX_TYPE_LITERAL_OUT_OF_RANGE

fn main() {
    let a: i64 = 9223372036854775808i64; //~ ERROR AX_TYPE_LITERAL_OUT_OF_RANGE
    let b: i64 = -9223372036854775809i64; //~ ERROR AX_TYPE_LITERAL_OUT_OF_RANGE
    let c: i64 = -9223372036854775808i64;
}
