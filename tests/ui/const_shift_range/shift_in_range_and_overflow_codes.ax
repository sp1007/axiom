// test: ui
// T483: in-range constant shifts are accepted, and overflow (not shift range) cases keep AX_CONST_OVERFLOW /
// AX_CONST_DIV_ZERO; the shift diagnostic must not leak onto them.

const OK_U128_SHL_127: u128 = 1u128 << 127u128;
const OK_I128_SHR_127: i128 = 1i128 >> 127u32;
const OK_U64_SHL_63: u64 = 1u64 << 63u32;
const OK_U8_SHL_7: u8 = 1u8 << 7u8;
const OK_I8_SHR_0: i8 = -128i8 >> 0u8;

const OVF_U8_ADD: u8 = 250u8 + 10u8; //~ ERROR AX_CONST_OVERFLOW
const OVF_U128_ADD: u128 = u128.MAX + 1u128; //~ ERROR AX_CONST_OVERFLOW
const OVF_I128_NEG: i128 = -i128.MIN; //~ ERROR AX_CONST_OVERFLOW
const OVF_I64_MUL: i64 = 4611686018427387904i64 * 4i64; //~ ERROR AX_CONST_OVERFLOW
const DIV0: i64 = 1i64 / 0i64; //~ ERROR AX_CONST_DIV_ZERO

fn main() {
}
