// test: ui
// QA (T483 round 1): the interp-const-path classification in nested blocks, `let` bindings, `if` expressions and
// aggregates; division by zero and arithmetic overflow in the same shapes keep their own codes, and valid shifts
// (including a run-time-looking count held in a `let`) and a MIN literal in an aggregate are accepted.

const NEST: u32 = { { 1u32 << 32u32 } }; //~ ERROR AX_CONST_SHIFT_RANGE
const NEST_AGG: [1]u32 = [{ 1u32 << 40u32 }]; //~ ERROR AX_CONST_SHIFT_RANGE
const LET_CNT: u32 = { let n = 33u32; 1u32 << n }; //~ ERROR AX_CONST_SHIFT_RANGE
const IF_SHL: u32 = if true { 1u32 << 32u32 } else { 0u32 }; //~ ERROR AX_CONST_SHIFT_RANGE
const AGG_SHR_NEG: [1]i64 = [{ let n = 0i32 - 1i32; 1i64 >> n }]; //~ ERROR AX_CONST_SHIFT_RANGE
const AGG_128: [1]u128 = [{ 1u128 << 128u32 }]; //~ ERROR AX_CONST_SHIFT_RANGE

const AGG_DIV0: [1]u32 = [1u32 / 0u32]; //~ ERROR AX_CONST_DIV_ZERO
const BLK_DIV0: u32 = { let z = 0u32; 5u32 % z }; //~ ERROR AX_CONST_DIV_ZERO
const AGG_OVF: [1]u8 = [{ 255u8 + 1u8 }]; //~ ERROR AX_CONST_OVERFLOW
const TUP_MUL: (u8, u8) = (200u8 * 2u8, 0u8); //~ ERROR AX_CONST_OVERFLOW

const OK_LET: [1]u32 = [{ let n = 31u32; 1u32 << n }];
const OK_NEST: u32 = { { 1u32 << 31u32 } };
const OK_MIN_AGG: [2]i64 = [-9223372036854775808i64, 9223372036854775807i64];

fn main() {
}
