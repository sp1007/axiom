// test: ui
// T483 (SPEC-40 AXS-INT-005, SPEC-03 AXS-SEM-037 as amended by ADR-0042 §4): a constant shift count that is
// negative or not below T.BITS is AX_CONST_SHIFT_RANGE, for every width including 128 bits.

const U128_SHL_128: u128 = 1u128 << 128u128; //~ ERROR AX_CONST_SHIFT_RANGE
const U128_SHR_200: u128 = 1u128 >> 200u128; //~ ERROR AX_CONST_SHIFT_RANGE
const I128_SHL_128: i128 = 1i128 << 128i32; //~ ERROR AX_CONST_SHIFT_RANGE
const I128_SHR_NEG: i128 = 1i128 >> -1i32; //~ ERROR AX_CONST_SHIFT_RANGE
const U64_SHL_64: u64 = 1u64 << 64u32; //~ ERROR AX_CONST_SHIFT_RANGE
const I64_SHR_64: i64 = 1i64 >> 64u32; //~ ERROR AX_CONST_SHIFT_RANGE
const U32_SHL_32: u32 = 1u32 << 32u32; //~ ERROR AX_CONST_SHIFT_RANGE
const U16_SHL_16: u16 = 1u16 << 16u16; //~ ERROR AX_CONST_SHIFT_RANGE
const U8_SHL_8: u8 = 1u8 << 8u8; //~ ERROR AX_CONST_SHIFT_RANGE
const I8_SHR_8: i8 = 1i8 >> 8u8; //~ ERROR AX_CONST_SHIFT_RANGE
const U8_SHL_NEG: u8 = 1u8 << -1i8; //~ ERROR AX_CONST_SHIFT_RANGE
const I32_SHL_NEG: i32 = 1i32 << -1i32; //~ ERROR AX_CONST_SHIFT_RANGE

struct Holder {
    x: i32,
}

impl Holder {
    const IMPL_SHL: u128 = 1u128 << 128u128; //~ ERROR AX_CONST_SHIFT_RANGE
}

fn main() {
    let a: [1u128 << 128u128]u8; //~ ERROR AX_CONST_SHIFT_RANGE
    let b: [1u8 << 8u8]u8; //~ ERROR AX_CONST_SHIFT_RANGE
}
