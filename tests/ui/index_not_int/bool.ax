// test: ui
// T497 (SPEC-40 AXS-INT-053 rule 1, AXS-INT-060 row 2014): a non-integer array index is exactly
// AX_TYPE_INDEX_NOT_INT, with the primary span on the index expression; never AX_TYPE_MISMATCH.
fn main() -> i32 {
    let a: [4]i32 = [1, 2, 3, 4];
    let i: bool = true;
    let x: i32 = a[i]; //~ ERROR AX_TYPE_INDEX_NOT_INT
    return x;
}
