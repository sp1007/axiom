// test: ui
// T497: a struct or a tuple used as an index is AX_TYPE_INDEX_NOT_INT.
struct Idx {
    v: usize,
}

fn main() {
    let a: [4]i32 = [1, 2, 3, 4];
    let s: Idx = Idx { v: 1 };
    let x: i32 = a[s]; //~ ERROR AX_TYPE_INDEX_NOT_INT
    let t: (usize, usize) = (1, 2);
    let y: i32 = a[t]; //~ ERROR AX_TYPE_INDEX_NOT_INT
}
