// test: ui
// T497: each bound of a range index `a[lo..hi]` gets the same check (reported on the bound's span).
fn main() {
    let a: [4]i32 = [1, 2, 3, 4];
    let b: bool = true;
    let s1: view<[i32]> = a[b..2]; //~ ERROR AX_TYPE_INDEX_NOT_INT
    let s2: view<[i32]> = a[0..b]; //~ ERROR AX_TYPE_INDEX_NOT_INT
    let s3: view<[i32]> = a[true..2]; //~ ERROR AX_TYPE_INDEX_NOT_INT
    let s4: view<[i32]> = a[1..false]; //~ ERROR AX_TYPE_INDEX_NOT_INT
}
