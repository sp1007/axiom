// test: ui
// T497: integer indices of every width and literal indices (IntVar -> usize) are unchanged: no diagnostic at all.
fn main() {
    let a: [4]i32 = [1, 2, 3, 4];
    let i8v: i8 = 1;
    let u8v: u8 = 1;
    let i32v: i32 = 1;
    let u64v: u64 = 1;
    let i128v: i128 = 1;
    let usv: usize = 1;
    let r0: i32 = a[0];
    let r1: i32 = a[i8v];
    let r2: i32 = a[u8v];
    let r3: i32 = a[i32v];
    let r4: i32 = a[u64v];
    let r5: i32 = a[i128v];
    let r6: i32 = a[usv];
    let r7: i32 = a[1 + 1];
    let s: view<[i32]> = a[1..3];
    let s2: view<[i32]> = a[u8v..usv + 2];
}
