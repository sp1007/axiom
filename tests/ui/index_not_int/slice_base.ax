// test: ui
// T497: the same check applies to slice bases (view<[T]> and mut_view<[T]>), and the base's element type is irrelevant.
fn read(s: view<[i32]>, i: bool) -> i32 {
    return s[i]; //~ ERROR AX_TYPE_INDEX_NOT_INT
}

fn write(s: mut_view<[u8]>, c: char) {
    s[c] = 1; //~ ERROR AX_TYPE_INDEX_NOT_INT
}

fn main() {
    let a: [2]i32 = [1, 2];
    let n: i32 = read(view(a), true);
}
