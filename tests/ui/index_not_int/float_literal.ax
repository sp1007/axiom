// test: ui
// T497: floating-point indices (f32 / f64 values). Float types are not implemented in this stage (E12.2), so the
// observable forms are float literals, which report AX_TYPE_INDEX_NOT_INT instead of
// AX_TYPE_UNSUPPORTED_IN_BOOTSTRAP.
fn main() {
    let a: [4]i32 = [1, 2, 3, 4];
    let x: i32 = a[1.0f32]; //~ ERROR AX_TYPE_INDEX_NOT_INT
    let y: i32 = a[2.5f64]; //~ ERROR AX_TYPE_INDEX_NOT_INT
    let z: i32 = a[1.5]; //~ ERROR AX_TYPE_INDEX_NOT_INT
}
