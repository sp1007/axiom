// test: ui
// QA (T497 gate): seams the engineer tests do not cover. Every non-integer operand yields exactly one
// AX_TYPE_INDEX_NOT_INT on the operand itself, whatever the operand type kind (unit, enum, fn, array, generic T),
// whatever the base (1-D, 2-D, Str, assignment target), and nested bad indices do not cascade.
enum E {
    A,
    B,
}

fn id(x: usize) -> usize {
    return x;
}

fn generic_index<T>(a: [4]i32, t: T) -> i32 {
    return a[t]; //~ ERROR AX_TYPE_INDEX_NOT_INT
}

fn main() {
    let mut a: [4]i32 = [1, 2, 3, 4];
    let m: [2][2]i32 = [[1, 2], [3, 4]];
    let s: Str = "hello";
    let e: E = E.A;
    let n1 = a[()]; //~ ERROR AX_TYPE_INDEX_NOT_INT
    let n2 = a[e]; //~ ERROR AX_TYPE_INDEX_NOT_INT
    let n3 = a[id]; //~ ERROR AX_TYPE_INDEX_NOT_INT
    let n4 = a[a]; //~ ERROR AX_TYPE_INDEX_NOT_INT
    let n6 = a[a[true]]; //~ ERROR AX_TYPE_INDEX_NOT_INT
    let n7 = m[true][0]; //~ ERROR AX_TYPE_INDEX_NOT_INT
    let n8 = m[0][true]; //~ ERROR AX_TYPE_INDEX_NOT_INT
    let n9 = s[true]; //~ ERROR AX_TYPE_INDEX_NOT_INT
    let n10 = s[true..2]; //~ ERROR AX_TYPE_INDEX_NOT_INT
    a[true] = 1; //~ ERROR AX_TYPE_INDEX_NOT_INT
    let ok1 = a[true as usize];
    let ok2 = m[1][0];
    let ok3 = a[id(1)];
}
