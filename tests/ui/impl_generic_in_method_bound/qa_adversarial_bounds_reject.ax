// test: ui
// covers: REQ-TST-072
// QA T423d adversarial negative:
// 1. Reordered impl generics `impl<A, B> Flipped<B, A>` rejects swapped closure param types.
// 2. Generic `Future<Output = R>` bound on `impl<R>` rejects mismatched `Future::Output`.
// 3. Trait impl method `impl<T> Sink<T> for Bucket<T> { fn accept<U: IntoVal<T>> }` rejects mismatched `IntoVal` arg.
// 4. Unknown name in a method bound called twice reports `AX_NAME_UNRESOLVED` once at the declaration span.

struct Flipped<P, Q> {
    pub left: P,
    pub right: Q,
}

impl<A, B> Flipped<B, A> {
    pub fn combine<F: FnOnce<A, B, i64>>(self: Flipped<B, A>, f: F) -> i64 {
        f(self.right, self.left)
    }
}

struct ReadyI64 {
    pub x: i64,
}

impl Future for ReadyI64 {
    type Output = i64;
    fn poll(self: mut_view<ReadyI64>, cx: mut_view<Context>) -> Poll<i64> {
        let _ = cx;
        Poll.Ready(self.x)
    }
}

struct Runner<R> {
    pub dflt: R,
}

impl<R> Runner<R> {
    pub fn drive<F: Future<Output = R>>(self: Runner<R>, mut fut: F) -> R {
        let rw = RawWaker { data: 0 as *const u8, vtable: 0 as *const RawWakerVTable };
        let w = Waker { raw: rw };
        let mut cx = Context { waker_val: w };
        match fut.poll(mut_view(cx)) {
            Poll.Ready(v) => v,
            Poll.Pending => self.dflt,
        }
    }
}

trait IntoVal<T> {
    fn into_val(self: Self) -> T;
}

struct FromBool {
    pub b: bool,
}

impl IntoVal<bool> for FromBool {
    fn into_val(self: FromBool) -> bool {
        self.b
    }
}

trait Sink<T> {
    fn accept<U: IntoVal<T>>(self: view<Self>, u: U) -> T;
}

struct Bucket<T> {
    pub bias: T,
}

impl<T> Sink<T> for Bucket<T> {
    fn accept<U: IntoVal<T>>(self: view<Bucket<T>>, u: U) -> T {
        let _ = self;
        u.into_val()
    }
}

struct Bad<R> {
    pub v: R,
}

impl<R> Bad<R> {
    pub fn bad<F: FnOnce<MissingBoundTy>>(f: F) -> i64 { //~ ERROR AX_NAME_UNRESOLVED
        let _ = f();
        0i64
    }
}

pub fn main() -> i32 {
    let fl: Flipped<bool, i64> = Flipped<bool, i64> { left: true, right: 10i64 };
    let _ = fl.combine(|a: bool, b: i64| -> i64 { if a { b } else { 0i64 } }); //~ ERROR AX_TYPE_MISMATCH
    //~^ ERROR AX_TYPE_MISMATCH

    let rn: Runner<bool> = Runner<bool> { dflt: false };
    let _ = rn.drive(ReadyI64 { x: 5i64 }); //~ ERROR AX_TYPE_MISMATCH

    let b: Bucket<i64> = Bucket<i64> { bias: 0i64 };
    let _ = view(b).accept(FromBool { b: true }); //~ ERROR AX_TRAIT_UNSATISFIED_BOUND

    let _ = Bad<i64>.bad(|| -> i64 { 1i64 });
    let _ = Bad<i64>.bad(|| -> i64 { 2i64 });
    0
}
