// test: ui
// covers: REQ-TST-072
// QA T423d Round 1 adversarial negative (probing `tc_subst_ty_and_self`):
// 1. Inside `impl<X, Y> Caller<X, Y>`, `W<Y>.mk(|| -> X { self.x })` rejects a closure whose
//    result type is caller `TY_PARAM` `X` instead of `Y`.
// 2. Inside `impl<X, Y> Caller<X, Y>`, calling a generic method on a trait impl whose bound
//    uses BOTH `Self` and an impl generic (`CombineSelf<R>.combine_self<F: FnOnce<view<Self>, R, R>>`)
//    with swapped type params (`Pair<Y, X>` implementing `CombineSelf<X>`) rejects a closure
//    expecting `Y` instead of `X`.
// 3. Inside `impl<X, Y> Caller<X, Y>`, calling `u.combine_self(...)` on `u: U` (`U: CombineSelf<Y>`)
//    rejects a closure whose `view<Self>` parameter is `view<Pair<X, Y>>` instead of `view<U>`.

struct W<R> {
    pub val: R,
}

impl<R> W<R> {
    pub fn mk<F: FnOnce<R>>(f: F) -> W<R> {
        W<R> { val: f() }
    }
}

struct Pair<A, B> {
    pub a: A,
    pub b: B,
}

trait CombineSelf<R> {
    fn combine_self<F: FnOnce<view<Self>, R, R>>(self: Self, r: R, f: F) -> R;
}

impl<P, Q> CombineSelf<Q> for Pair<P, Q> {
    fn combine_self<F: FnOnce<view<Self>, Q, Q>>(self: Self, r: Q, f: F) -> Q {
        f(view(self), r)
    }
}

struct Caller<X, Y> {
    pub x: X,
    pub y: Y,
}

impl<X, Y> Caller<X, Y> {
    pub fn bad_w_mk(self: Caller<X, Y>) -> W<Y> {
        let xv: X = self.x;
        W<Y>.mk(|| -> X { xv }) //~ ERROR AX_TYPE_MISMATCH
    }

    pub fn bad_swapped_trait_self(self: Caller<X, Y>) -> X {
        let p: Pair<Y, X> = Pair<Y, X> { a: self.y, b: self.x };
        p.combine_self(self.x, |_pv: view<Pair<Y, X>>, yv: Y| -> X { let _ = yv; p.b }) //~ ERROR AX_TYPE_MISMATCH
    }

    pub fn bad_param_trait_self<U: CombineSelf<Y>>(self: Caller<X, Y>, u: U) -> Y {
        let yv: Y = self.y;
        u.combine_self(yv, |_pv: view<Pair<X, Y>>, r: Y| -> Y { r }) //~ ERROR AX_TYPE_MISMATCH
    }
}

pub fn main() -> i32 {
    0
}
