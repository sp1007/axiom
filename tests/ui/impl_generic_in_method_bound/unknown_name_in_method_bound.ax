// test: ui
// covers: REQ-TST-072
// T423d negative: an unknown type name inside a method's generic bound (inline, nested generic argument,
// or `where` clause) still reports `AX_NAME_UNRESOLVED` at the exact span of the unknown type, both when
// uncalled and without duplicating the diagnostic when called.

struct W<R> {
    pub v: R,
}

impl<R> W<R> {
    pub fn bad_inline<F: FnOnce<NoSuchType>>(f: F) -> i64 { //~ ERROR AX_NAME_UNRESOLVED
        let _ = f;
        0i64
    }

    pub fn bad_nested<F: FnOnce<Option<NoSuchInner>>>(f: F) -> i64 { //~ ERROR AX_NAME_UNRESOLVED
        let _ = f;
        0i64
    }

    pub fn bad_where<F>(f: F) -> i64
    where
        F: FnOnce<NoSuchWhereType> //~ ERROR AX_NAME_UNRESOLVED
    {
        let _ = f();
        0i64
    }
}

pub fn main() -> i32 {
    let _ = W<i64>.bad_where(|| -> i64 { 1i64 });
    0
}
