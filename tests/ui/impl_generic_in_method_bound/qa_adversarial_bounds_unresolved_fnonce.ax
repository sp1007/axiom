// test: ui
// covers: REQ-TST-072
// QA T423d adversarial negative (case 4, split out of `qa_adversarial_bounds_reject.ax` by T428m):
// an unknown name in a method bound's generic argument, with the method called twice, reports
// `AX_NAME_UNRESOLVED` once at the declaration span (since T428m the resolver reports it).

struct Bad<R> {
    pub v: R,
}

impl<R> Bad<R> {
    pub fn bad<F: FnOnce<MissingBoundTy>>(f: F) -> i64 { //~ ERROR AX_NAME_UNRESOLVED
        let _ = f();
        0i64
    }
}

pub fn main() -> i32 {
    let _ = Bad<i64>.bad(|| -> i64 { 1i64 });
    let _ = Bad<i64>.bad(|| -> i64 { 2i64 });
    0
}
