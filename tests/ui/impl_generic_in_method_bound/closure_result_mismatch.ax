// test: ui
// covers: REQ-TST-072
// T423d negative: when a closure's result type, parameter count, or parameter type does not match the
// impl-level generic `R`/`A` in `F: FnOnce<...>`, or when a non-callable / mismatched `IntoVal<T>` argument
// is passed, type checking reports a clean bound/type error rather than crashing or failing MIR verification.

trait IntoVal<T> {
    fn into_val(self: Self) -> T;
}

struct FromBool {
    pub b: bool,
}

impl IntoVal<bool> for FromBool {
    fn into_val(self: FromBool) -> bool {
        self.b
    }
}

struct W<R> {
    pub v: R,
}

impl<R> W<R> {
    pub fn mk<F: FnOnce<R>>(f: F) -> W<R> {
        W<R> { v: f() }
    }

    pub fn mk_where<F>(f: F) -> W<R> where F: FnOnce<R> {
        W<R> { v: f() }
    }

    pub fn from_into<U: IntoVal<R>>(u: U) -> W<R> {
        W<R> { v: u.into_val() }
    }
}

struct Mapper<A, R> {
    pub a: A,
}

impl<A, R> Mapper<A, R> {
    pub fn apply<F: FnOnce<A, R>>(self: Mapper<A, R>, f: F) -> R {
        f(self.a)
    }
}

pub fn main() -> i32 {
    let _ = W<i64>.mk(|| -> bool { true }); //~ ERROR AX_TYPE_MISMATCH
    let _ = W<i64>.mk(|| { false }); //~ ERROR AX_TYPE_MISMATCH
    let _ = W<i64>.mk_where(|| -> bool { true }); //~ ERROR AX_TYPE_MISMATCH

    let m1 = Mapper<i64, i64> { a: 1i64 };
    let _ = m1.apply(|| -> i64 { 2i64 }); //~ ERROR AX_TYPE_MISMATCH

    let m2 = Mapper<i64, i64> { a: 1i64 };
    let _ = m2.apply(|flag: bool| -> i64 { if flag { 1i64 } else { 0i64 } }); //~ ERROR AX_TYPE_MISMATCH

    let _ = W<i64>.mk(123i64); //~ ERROR AX_TRAIT_UNSATISFIED_BOUND
    let _ = W<i64>.from_into(FromBool { b: true }); //~ ERROR AX_TRAIT_UNSATISFIED_BOUND
    0
}
