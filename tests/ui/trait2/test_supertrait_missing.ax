// test: ui
trait Base {
    fn base_val(self: view<Self>) -> i32;
}

trait Derived : Base {
    fn derived_val(self: view<Self>) -> i32;
}

struct Item {
    x: i32,
}

impl Derived for Item { //~ ERROR AX_TRAIT_UNSATISFIED_BOUND
    fn derived_val(self: view<Self>) -> i32 {
        self.x * 2
    }
}

fn main() -> i32 {
    0
}
