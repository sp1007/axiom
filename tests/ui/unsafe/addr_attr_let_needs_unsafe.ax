// test: ui
// T501 (SPEC-50 AXS-UNS-002 row 7): a block-scope `@addr(E)` binding needs an unsafe context (an `unsafe` block or function, or the
// `unsafe static` form of the declaration).

const BASE: usize = 0x4000_1000;

pub fn plain_let() -> u32 {
    @addr(BASE + 0x100) let mut r: u32; //~ ERROR AX_UNSAFE_REQUIRED
    0
}

pub fn plain_static() -> u32 {
    @addr(BASE + 0x200) static mut r: u32; //~ ERROR AX_UNSAFE_REQUIRED
    0
}

pub fn main() -> i32 {
    0
}
