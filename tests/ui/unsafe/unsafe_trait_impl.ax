// test: ui
// T501 (SPEC-50 AXS-UNS-005): `unsafe impl` of an `unsafe trait` is accepted, a plain `impl` of a safe trait is accepted, and the
// methods of an `unsafe trait` stay safe to call.

unsafe trait Pod {
    fn size_hint(self: view<Self>) -> usize;
}

trait Plain {
    fn id(self: view<Self>) -> i32;
}

struct A { pub x: i32 }

unsafe impl Pod for A {
    fn size_hint(self: view<Self>) -> usize { 4 }
}

impl Plain for A {
    fn id(self: view<Self>) -> i32 { self.x }
}

fn call_it(a: view<A>) -> usize {
    a.size_hint()
}

pub fn main() -> i32 {
    let a = A { x: 1 };
    let _ = call_it(view(a));
    0
}
