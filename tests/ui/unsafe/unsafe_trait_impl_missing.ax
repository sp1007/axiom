// test: ui
// T501 (SPEC-50 AXS-UNS-005): a plain `impl` of an `unsafe trait` is rejected. The trait-solver pass (compiler/traits) reports
// it as AX_CONC_SAFE_SEND_SHARE_IMPL; AX_UNSAFE_TRAIT_IMPL (own/unsafe.ax) takes over once that pass is limited to Send / Share.

unsafe trait Pod {
    fn size_hint(self: view<Self>) -> usize;
}

struct B { pub x: i32 }

impl Pod for B { //~ ERROR AX_CONC_SAFE_SEND_SHARE_IMPL
    fn size_hint(self: view<Self>) -> usize { 4 }
}

pub fn main() -> i32 {
    0
}
