// test: ui
// T501 (SPEC-55 AXS-ADR-011): an item-scope `@addr(E)` address must be a compile-time constant; a run-time value is only
// accepted on a block-scope binding. (The constant evaluator reports a non-const call in a constant initialiser as
// AX_CONST_OVERFLOW, the same as for a plain `const`.)

fn runtime_value() -> usize {
    0x2000
}

@at(runtime_value()) //~ ERROR AX_CONST_OVERFLOW
unsafe static mut NOT_CONST: u32;

pub fn main() -> i32 {
    0
}
