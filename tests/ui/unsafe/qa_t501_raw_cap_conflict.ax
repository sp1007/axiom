// test: ui
// T501 QA adversarial negative test (capability provenance across unsafe boundary):
// - raw-pointer-derived read view vs mut_view conflict after leaving unsafe

fn raw_read_vs_mut_conflict(p: *mut i32) -> i32 {
    let r: view<i32> = unsafe { view(*p) };
    let w: mut_view<i32> = unsafe { mut_view(*p) }; //~ ERROR AX_CAP_CONFLICT_MUT
    *w = 7;
    *r
}

fn raw_mut_vs_read_conflict(p: *mut i32) -> i32 {
    let w: mut_view<i32> = unsafe { mut_view(*p) };
    let r: view<i32> = unsafe { view(*p) }; //~ ERROR AX_CAP_CONFLICT_READ
    *w = 7;
    *r
}

pub fn main() -> i32 {
    0
}
