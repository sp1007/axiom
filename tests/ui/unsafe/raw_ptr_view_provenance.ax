// test: ui
// T501 (SPEC-50 AXS-UNS-006): a `view<T>` / `mut_view<T>` built inside `unsafe` is an ordinary capability afterwards: the
// capability rules (exclusive `mut_view`, read/write conflicts) keep applying to the resulting binding.

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

// accepted: read through a view made from a raw pointer, then use it after the unsafe block
fn read_via_view(p: *const i32) -> i32 {
    let v: view<i32> = unsafe { view(*p) };
    *v + *v
}

// accepted: write through a mut_view made from a raw pointer
fn write_via_mut_view(p: *mut i32) {
    let w: mut_view<i32> = unsafe { mut_view(*p) };
    *w = 5;
}

// rejected: `unsafe` does not relax exclusivity of a mut_view of a safe owner
fn conflict_in_unsafe() -> i32 {
    let mut x: i32 = 1;
    let a: mut_view<i32> = unsafe { mut_view(x) };
    let b: mut_view<i32> = unsafe { mut_view(x) }; //~ ERROR AX_CAP_CONFLICT_MUT
    *a = 1;
    *b = 2;
    x
}

// rejected: a read view made inside unsafe still conflicts with a live mut_view of the same place
fn read_vs_write() -> i32 {
    let mut x: i32 = 1;
    let w: mut_view<i32> = mut_view(x);
    let r: view<i32> = unsafe { view(x) }; //~ ERROR AX_CAP_CONFLICT_READ
    *w = 4;
    *r
}

// rejected: two mut_views built from the same raw pointer are exclusive capabilities too
fn raw_two_mut_views(p: *mut i32) -> i32 {
    let a: mut_view<i32> = unsafe { mut_view(*p) };
    let b: mut_view<i32> = unsafe { mut_view(*p) }; //~ ERROR AX_CAP_CONFLICT_MUT
    *a = 1;
    *b = 2;
    *a
}

pub fn main() -> i32 {
    let mut x: i32 = 1;
    let p: *mut i32 = unsafe { address_of_mut(x) };
    write_via_mut_view(p);
    read_via_view(unsafe { address_of(x) })
}
