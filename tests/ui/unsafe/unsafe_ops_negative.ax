// test: ui
// T501 (SPEC-50 AXS-UNS-002): every operation that needs an `unsafe` context is rejected outside one.

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic fn null<T>() -> *const T { 0 as *const T }
@intrinsic fn null_mut<T>() -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_add<T>(p: *const T, n: usize) -> *const T { p }

@link("kernel32")
extern "system" {
    unsafe fn GetCurrentProcessId() -> u32;
}

unsafe fn dangerous(x: i32) -> i32 {
    x + 1
}

static mut COUNTER: i32 = 0;

fn raw_deref_read() -> i32 {
    let p: *const i32 = null<i32>();
    let v: i32 = *p; //~ ERROR AX_UNSAFE_REQUIRED
    v
}

fn raw_deref_write() {
    let p: *mut i32 = null_mut<i32>();
    *p = 2; //~ ERROR AX_UNSAFE_REQUIRED
}

fn raw_arith() {
    let p: *const i32 = null<i32>();
    let q: *const i32 = p + 1; //~ ERROR AX_UNSAFE_REQUIRED
}

fn address_taking() {
    let x: i32 = 7;
    let p = address_of(x); //~ ERROR AX_UNSAFE_REQUIRED
}

fn calls_unsafe_fn() -> i32 {
    dangerous(1) //~ ERROR AX_UNSAFE_REQUIRED
}

fn calls_extern() -> u32 {
    GetCurrentProcessId() //~ ERROR AX_UNSAFE_REQUIRED
}

fn touches_static_mut() -> i32 {
    COUNTER = 1; //~ ERROR AX_CONC_UNSYNC_STATIC
    COUNTER //~ ERROR AX_CONC_UNSYNC_STATIC
}

pub fn main() -> i32 {
    0
}
