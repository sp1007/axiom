// test: ui
// T501 (SPEC-50 AXS-UNS-002 row 7, ADR-0001 section 2): the declaration of a fixed-address `static` or `fn` is the trust point and
// must be written `unsafe`.

const BASE: usize = 0x4000_1000;

@addr(BASE + 0x10) //~ ERROR AX_UNSAFE_REQUIRED
static mut NO_UNSAFE: u32;

@addr(BASE + 0x20) //~ ERROR AX_UNSAFE_REQUIRED
fn not_unsafe_fn() -> i32 { 1 }

@addr(BASE + 0x30) unsafe static mut OK_STATIC: u32;
@addr(BASE + 0x40) unsafe fn ok_fn() -> i32 { 2 }

pub fn main() -> i32 {
    0
}
