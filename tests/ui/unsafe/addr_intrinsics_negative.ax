// test: ui
// T501 (SPEC-55 AXS-ADR-010): operand and arity rules of fn_addr / static_addr / addr_of and of `fn as usize`.

@intrinsic fn fn_addr<F>(f: F) -> usize { 0 }
@intrinsic fn static_addr<S>(s: S) -> usize { 0 }
@intrinsic fn addr_of<T>(x: T) -> usize { 0 }

static G: i32 = 4;

fn helper() -> i32 {
    1
}

fn not_a_function() -> usize {
    let n: i32 = 5;
    fn_addr(n) //~ ERROR AX_TYPE_MISMATCH
}

fn not_a_static() -> usize {
    let n: i32 = 5;
    static_addr(n) //~ ERROR AX_TYPE_MISMATCH
}

fn static_addr_of_fn() -> usize {
    static_addr(helper) //~ ERROR AX_TYPE_MISMATCH
}

fn temporary_has_no_address() -> usize {
    addr_of(1 + 2) //~ ERROR AX_TYPE_NOT_A_PLACE
}

fn arity() -> usize {
    fn_addr(helper, helper) //~ ERROR AX_TYPE_ARG_COUNT
}

fn result_is_usize() -> i32 {
    fn_addr(helper) //~ ERROR AX_TYPE_MISMATCH
}

fn cast_to_narrow_int() -> u32 {
    helper as u32 //~ ERROR AX_TYPE_INVALID_CAST
}

fn closure_has_no_code_address() -> usize {
    let f = |x: i32| -> i32 { x + 1 };
    fn_addr(f) //~ ERROR AX_TYPE_MISMATCH
}

pub fn main() -> i32 {
    0
}
