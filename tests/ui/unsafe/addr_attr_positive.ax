// test: ui
// T501 (SPEC-55 AXS-ADR-001/011, REQ-OWNER-008): accepted `@addr(E)` / `@at(E)` declarations on `static`, `let` and `fn`,
// with constant and dynamic address expressions, used like ordinary variables afterwards.

@intrinsic fn fn_addr<F>(f: F) -> usize { 0 }
@intrinsic fn static_addr<S>(s: S) -> usize { 0 }
@intrinsic fn addr_of<T>(x: T) -> usize { 0 }

const PERIPH_BASE: usize = 0x4000_0000;

@repr(C)
struct Uart {
    pub ctrl: u32,
    pub data: u32,
}

// item scope: overlay statics with a constant address (a literal, or a constant expression)
@addr(0x4000_1000) unsafe static mut UART0: Uart;
@at(PERIPH_BASE + 0x2000) unsafe static mut UART1: Uart;
@addr(PERIPH_BASE + 0x3000) unsafe static ROM_TABLE: [4]u32;

// item scope: a function placed at a fixed address
@addr(0x2000_0000) unsafe fn isr() -> i32 {
    7
}

fn foo() -> i32 {
    1
}

fn use_overlays() -> u32 {
    unsafe {
        UART0.ctrl = 1u32;
        UART1.data = UART0.ctrl + 2u32;
        UART1.data + ROM_TABLE[1]
    }
}

fn round_trip() -> bool {
    let a: usize = static_addr(UART0);
    let b: usize = addr_of(UART1);
    let c: usize = fn_addr(isr);
    let d: usize = isr as usize;
    a != b && c == d
}

// block scope: the address may be computed from runtime values, e.g. a function address plus an offset
fn dynamic_addresses() -> u32 {
    let base: usize = fn_addr(foo);
    @addr(base + 0x100) unsafe static mut REG: u32;
    @addr(base + 0x200) unsafe static mut SLOT: u32;
    unsafe {
        REG = 5u32;
        SLOT = REG + 1u32;
    }
    let ok: bool = static_addr(REG) == base + 0x100 && addr_of(SLOT) == base + 0x200;
    if ok { 1u32 } else { 0u32 }
}

// block scope inside an unsafe block, with an initialiser stored at the address
fn unsafe_scope() -> u32 {
    unsafe {
        let base: usize = 0x6000_0000;
        @addr(base) let mut word: u32 = 9u32;
        word = word + 1u32;
        word
    }
}

pub fn main() -> i32 {
    let _ = use_overlays();
    let _ = round_trip();
    let _ = dynamic_addresses();
    let _ = unsafe_scope();
    0
}
