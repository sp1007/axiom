// test: ui
// T501 (SPEC-50 AXS-UNS-002/003/004): the same operations are accepted inside `unsafe { }` blocks and `unsafe fn` bodies, and
// address introspection that does not dereference (`fn_addr`, `static_addr`, `addr_of`, pointer-to-integer casts) is safe.

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }
@intrinsic unsafe fn ptr_add<T>(p: *const T, n: usize) -> *const T { p }
@intrinsic fn fn_addr<F>(f: F) -> usize { 0 }
@intrinsic fn static_addr<S>(s: S) -> usize { 0 }
@intrinsic fn addr_of<T>(x: T) -> usize { 0 }

@link("kernel32")
extern "system" {
    unsafe fn GetCurrentProcessId() -> u32;
}

unsafe fn dangerous(x: i32) -> i32 {
    x + 1
}

// An `unsafe fn` body may perform unsafe operations without an inner block (v1.0 core).
unsafe fn inside_unsafe_fn() -> i32 {
    let x: i32 = 5;
    let p: *const i32 = address_of(x);
    let q: *const i32 = ptr_add(p, 0);
    dangerous(*q)
}

static mut COUNTER: i32 = 0;

fn safe_wrapper() -> i32 {
    let mut x: i32 = 41;
    let p: *const i32 = unsafe { address_of(x) };
    let v: i32 = unsafe { *p };
    let w: i32 = unsafe { dangerous(v) };
    unsafe { COUNTER = w; }
    let pid: u32 = unsafe { GetCurrentProcessId() };
    x = unsafe { COUNTER } + (pid as i32) * 0;
    x
}

fn helper() -> i32 {
    1
}

fn address_queries_are_safe() -> usize {
    let local: i32 = 3;
    let a: usize = fn_addr(helper);
    let b: usize = helper as usize;
    let c: usize = static_addr(COUNTER);
    let d: usize = addr_of(local);
    let e: usize = addr_of(helper);
    a + b + c + d + e
}

pub fn main() -> i32 {
    let _ = safe_wrapper();
    let _ = address_queries_are_safe();
    0
}
