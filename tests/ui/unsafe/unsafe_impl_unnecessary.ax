// test: ui
// T501 (SPEC-50 AXS-UNS-005): `unsafe impl` of a trait that is not an `unsafe trait` is rejected.

trait Plain {
    fn id(self: view<Self>) -> i32;
}

struct C { pub x: i32 }

unsafe impl Plain for C { //~ ERROR AX_UNSAFE_UNNECESSARY_IMPL
    fn id(self: view<Self>) -> i32 { self.x }
}

pub fn main() -> i32 {
    0
}
