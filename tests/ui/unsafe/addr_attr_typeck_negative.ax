// test: ui
// T501 (SPEC-55 AXS-ADR-001/011, AXS-UNS-002 row 7): static and fn rules of `@addr(E)` / `@at(E)` found by typeck.
// Diagnostics of a declaration are reported at its attribute line (the address expression for a type error).

const BASE: usize = 0x4000_1000;

// the address expression must be a `usize`
@addr(1u32) //~ ERROR AX_TYPE_MISMATCH
unsafe static mut BAD_TYPE: u32;

// exactly one argument
@addr() //~ ERROR AX_ADDR_BAD_ARGS
unsafe static mut NO_ARG: u32;

@addr(BASE, 4usize) //~ ERROR AX_ADDR_BAD_ARGS
unsafe static mut TWO_ARGS: u32;

// only static / fn / let
@addr(BASE + 0x40) //~ ERROR AX_ADDR_BAD_TARGET
struct NotPlaceable { pub x: u32 }

// a pinned placement (initialiser) needs the object model of T526 / T528
@addr(BASE + 0x80) //~ ERROR AX_TYPE_UNSUPPORTED_IN_BOOTSTRAP
unsafe static mut PLACED: u32 = 5u32;

pub fn local_forms() -> u32 {
    // an attribute on anything but a binding is not a placement
    @addr(0x10usize) //~ ERROR AX_ADDR_BAD_TARGET
    1u32 + 1u32;
    0
}

pub fn main() -> i32 {
    0
}
