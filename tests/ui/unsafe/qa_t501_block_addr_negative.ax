    @at() unsafe static mut ZERO_ARGS: u32; //~ ERROR AX_ADDR_BAD_ARGS
    @at(0x100usize, 0x200usize) unsafe static mut TWO_ARGS: u32; //~ ERROR AX_ADDR_BAD_ARGS
    0u32
}

pub fn main() -> i32 {
    0
}
