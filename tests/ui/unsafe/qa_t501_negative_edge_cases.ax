// test: ui
// T501 QA adversarial negative test (own/unsafe):
// - mut_view(*p) and address_of_mut(x) outside unsafe

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

fn forge_mut_view_outside_unsafe(p: *mut i32) {
    let w: mut_view<i32> = mut_view(*p); //~ ERROR AX_UNSAFE_REQUIRED
    *w = 1;
}

fn addr_of_mut_outside_unsafe() {
    let mut x: i32 = 3;
    let _p: *mut i32 = address_of_mut(x); //~ ERROR AX_UNSAFE_REQUIRED
}

pub fn main() -> i32 {
    0
}
