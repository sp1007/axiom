// test: ui
// T498 / SPEC-10 AXS-OWN-003: `[N]T` is Copy only when `T` is Copy. An array of a non-Copy struct still
// moves, so passing or binding it a second time is a use after move.

struct S { x: i32 }

fn take(a: [2]S) -> i32 {
    a[0].x
}

fn main() {
    let a: [2]S = [S { x: 1 }, S { x: 2 }];
    let n = take(a);
    let m = take(a); //~ ERROR AX_MOVE_USE_AFTER_MOVE
}
