// test: ui
// QA (T498 gate): inside a generic body `[N]T` is Copy only if `T` is known to be Copy; an unconstrained `T`
// is not, so using the array twice in the body is a use after move even if every call site uses `u8`.

fn two<T>(a: [2]T) -> usize {
    let b = a;
    let c = a; //~ ERROR AX_MOVE_USE_AFTER_MOVE
    2
}

fn main() -> i32 {
    let a: [2]u8 = [3u8, 4u8];
    two(a) as i32
}
