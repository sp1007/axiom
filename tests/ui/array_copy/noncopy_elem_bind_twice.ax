// test: ui
// T498 / SPEC-10 AXS-OWN-003: a nested array whose innermost element is not Copy (`[2][1]S`) moves on
// binding; the second binding is a use after move.

struct S { x: i32 }

fn main() {
    let a: [2][1]S = [[S { x: 1 }], [S { x: 2 }]];
    let b = a;
    let c = a; //~ ERROR AX_MOVE_USE_AFTER_MOVE
}
