// test: ui
// QA (T498 gate): an array whose element type has a Drop impl is never Copy; the second by-value use is a use
// after move (and the elements must not be dropped twice).

struct D {
    id: i32,
}

impl Drop for D {
    fn drop(self: mut_view<D>) {
    }
}

fn eat(a: [2]D) {
}

fn main() {
    let a: [2]D = [D { id: 1 }, D { id: 2 }];
    eat(a);
    eat(a); //~ ERROR AX_MOVE_USE_AFTER_MOVE
}
