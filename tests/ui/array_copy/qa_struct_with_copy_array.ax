// test: ui
// QA (T498 gate): a struct that only holds a Copy array is NOT Copy unless it derives Copy; an array of such
// structs therefore still moves.

struct Holder {
    n: [2]u8,
}

fn take(a: [2]Holder) -> u8 {
    a[0].n[0]
}

fn main() {
    let a: [2]Holder = [Holder { n: [1u8, 2u8] }, Holder { n: [3u8, 4u8] }];
    let x = take(a);
    let y = take(a); //~ ERROR AX_MOVE_USE_AFTER_MOVE
}
