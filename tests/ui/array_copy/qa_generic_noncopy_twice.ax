// test: ui
// QA (T498 gate): a generic `[N]T` instantiated with a non-Copy T moves on the second use.

struct NC {
    v: i32,
}

fn pass<T>(a: [2]T) -> [2]T {
    a
}

fn main() {
    let n: [2]NC = [NC { v: 4 }, NC { v: 7 }];
    let m = pass(n);
    let k = pass(n); //~ ERROR AX_MOVE_USE_AFTER_MOVE
}
