// test: ui
// T445 QA adversarial (SPEC-11 AXS-CAP-001/002): the FU-6 reborrow of a view receiver must
// never upgrade a shared `view<T>` to a `mut_view<T>`; calling a `self: mut_view<Self>` method
// on a `view<T>` parameter stays an error (same code as passing a view<T> to a mut_view<T>
// parameter of a free function; HEAD rejected it only in the MIR verifier).

module main

struct Ctx {
    pub count: u8,
}

impl Ctx {
    fn bump(self: mut_view<Self>) -> u8 {
        self.count = self.count + 1u8;
        self.count
    }
}

fn shared_only(cx: view<Ctx>) -> u8 {
    cx.bump() //~ ERROR AX_TYPE_MISMATCH
}

pub fn main() -> i32 {
    0
}
