// test: ui
// T445 FU-6 negative counterpart (SPEC-10 AXS-OWN-002):
// Explicitly moving a `mut_view` parameter by value into another binding and then
// calling a method on the moved `mut_view` MUST still emit AX_MOVE_USE_AFTER_MOVE.

module main

struct NonCopy {
    pub x: i32,
}

impl NonCopy {
    fn touch(self: mut_view<Self>) -> i32 {
        self.x
    }
}

fn use_after_explicit_mut_view_move(mv: mut_view<NonCopy>) -> i32 {
    let moved = mv;
    let a = moved.touch();
    let b = mv.touch(); //~ ERROR AX_MOVE_USE_AFTER_MOVE
    a + b
}

pub fn main() -> i32 {
    0
}
