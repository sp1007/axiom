// test: ui
// T445 FU-6 (SPEC-11 AXS-CAP-001, AXS-CAP-002, AXS-CAP-005):
// Positive compile test: calling methods with `self: mut_view<T>` or `self: view<T>` on
// a `mut_view<T>` or `view<T>` parameter (or local) reborrows it and never moves it.

module main

struct WakerToken {
    pub id: i32,
}

struct FakeContext {
    pub seq: i32,
}

impl FakeContext {
    fn waker(self: mut_view<Self>) -> WakerToken {
        self.seq = self.seq + 1;
        WakerToken { id: self.seq }
    }

    fn inspect(self: view<Self>) -> i32 {
        self.seq
    }

    fn call_self_repeatedly(self: mut_view<Self>) -> i32 {
        let a = self.waker();
        let b = self.waker();
        let c = self.inspect();
        a.id + b.id + c
    }
}

fn poll_like(cx: mut_view<FakeContext>) -> i32 {
    let w1 = cx.waker();
    let w2 = cx.waker();
    let s1 = cx.inspect();
    let s2 = cx.inspect();
    let r = cx.call_self_repeatedly();
    w1.id + w2.id + s1 + s2 + r
}

// A temporary view receiver (`mut_view(*cx)`) is passed by value, not reborrowed: no
// second mut_view of `*cx` is created (regression: AX_CAP_CONFLICT_MUT in std/async).
fn temp_view_receiver_like(cx: mut_view<FakeContext>) -> i32 {
    let w = mut_view(*cx).waker();
    let s = view(*cx).inspect();
    let w2 = cx.waker();
    w.id + s + w2.id
}

fn read_only_like(cx: view<FakeContext>) -> i32 {
    let a = cx.inspect();
    let b = cx.inspect();
    a + b
}

fn local_mut_view_like() -> i32 {
    let mut ctx2 = FakeContext { seq: 0 };
    let mv = mut_view(ctx2);
    let w1 = mv.waker();
    let w2 = mv.waker();
    let s1 = mv.inspect();
    w1.id + w2.id + s1
}

pub fn main() -> i32 {
    let mut ctx = FakeContext { seq: 0 };
    let x = poll_like(mut_view(ctx));
    let y = read_only_like(view(ctx));
    let z = local_mut_view_like();
    let t = temp_view_receiver_like(mut_view(ctx));
    x + y + z + t
}
