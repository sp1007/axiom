// test: ui
// T445 FU-6 negative counterpart (SPEC-10 AXS-OWN-002):
// Calling a by-value `self` method twice on a non-Copy parameter MUST still emit
// AX_MOVE_USE_AFTER_MOVE.

module main

struct NonCopy {
    pub x: i32,
}

impl NonCopy {
    fn consume(self: NonCopy) -> i32 {
        self.x
    }
}

fn use_after_by_value_method(p: NonCopy) -> i32 {
    let a = p.consume();
    let b = p.consume(); //~ ERROR AX_MOVE_USE_AFTER_MOVE
    a + b
}

pub fn main() -> i32 {
    0
}
