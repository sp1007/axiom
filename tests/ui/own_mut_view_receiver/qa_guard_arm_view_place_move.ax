// test: ui
// T445 QA adversarial (SPEC-10 AXS-OWN-002, SPEC-12 AXS-DROP-003): a guarded arm binds a
// droppable payload by move before its guard runs; when the guard fails, the next arm binds
// the same payload again. For a local scrutinee this is AX_MOVE_USE_AFTER_MOVE; matching a
// place reached through a mut_view in place (T445 FU-4) must not lose that diagnostic (it ran
// Drop twice on the payload: interp and native printed the guard id twice).

module main

struct Guard {
    pub id: u8,
}

impl Drop for Guard {
    fn drop(self: mut_view<Self>) {}
}

struct Holder {
    pub guard: Option<Guard>,
}

fn guard_arm(h: mut_view<Holder>, gn: Guard) {
    match h.guard {
        Option.Some(g) if g.id == 9u8 => {},
        Option.Some(g) => { //~ ERROR AX_MOVE_USE_AFTER_MOVE
            h.guard = Option.Some(gn);
        },
        Option.None => {},
    }
}

pub fn main() -> i32 {
    0
}
