// test: ui
// T445 QA adversarial + T445a (ADR-0047 §2, SPEC-10 AXS-OWN-002, SPEC-12 AXS-DROP-003/009):
// Under ADR-0047 §2 a non-moving guard (`if g.id == 9u8`) binds by view and does not move the
// payload; however, when a guard itself consumes the pattern binding by move (`take_guard(g)`),
// matching a place reached through `mut_view` must still report AX_MOVE_USE_AFTER_MOVE rather
// than dropping the payload twice.

module main

struct Guard {
    pub id: u8,
}

impl Drop for Guard {
    fn drop(self: mut_view<Self>) {}
}

struct Holder {
    pub guard: Option<Guard>,
}

fn take_guard(g: Guard) -> bool {
    g.id == 9u8
}

fn guard_arm(h: mut_view<Holder>, gn: Guard) {
    match h.guard {
        Option.Some(g) if take_guard(g) => {},
        Option.Some(g) => { //~ ERROR AX_MOVE_USE_AFTER_MOVE
            h.guard = Option.Some(gn);
        },
        Option.None => {},
    }
}

pub fn main() -> i32 {
    0
}
