// test: ui
// QA adversarial boundary test (T517 / SPEC-53):
// Under default `--safety-profile system`:
// 1. Item-level `@forbid_unsafe` on impl/trait blocks cannot be escalated by member `@allow_unsafe`.
// 2. Raw pointer indexing `(*p)[0]`, `address_of_mut`, `ptr_add`, and `const` `unsafe {}` are rejected.
// 3. `@at(...)` on a field inside an `@forbid_unsafe` struct is rejected.
module qa_forbid_unsafe_escalation_and_rawptr_neg

use std.core.mem.address_of_mut

@forbid_unsafe
pub struct MmioBlock {
    @at(0x2000usize) //~ ERROR AX_SEC_UNSAFE_FORBIDDEN
    pub ctrl: u32,
}

pub struct BoxedArr {
    pub ptr: *mut [4]i32,
}

@forbid_unsafe
impl BoxedArr {
    @allow_unsafe //~ ERROR AX_SEC_CONFLICTING_SAFETY_POLICY
    fn bad_index(self: view<BoxedArr>) -> i32 {
        let p = self.ptr;
        (*p)[0] //~ ERROR AX_SEC_UNSAFE_FORBIDDEN
    }

    fn bad_addr_mut(self: view<BoxedArr>) {
        let mut local: i32 = 1i32;
        let _q = address_of_mut(local); //~ ERROR AX_SEC_UNSAFE_FORBIDDEN
    }
}

@forbid_unsafe
trait LockedTrait {
    @allow_unsafe //~ ERROR AX_SEC_CONFLICTING_SAFETY_POLICY
    fn probe(self: view<Self>) -> i32;
}

@forbid_unsafe
const BAD_CONST_UNSAFE: i32 = unsafe { 7i32 }; //~ ERROR AX_SEC_UNSAFE_FORBIDDEN

pub fn main() -> i32 {
    0i32
}
