// test: ui
// flags: --safety-profile safe
// SPEC-53 §1.2 (AXS-SEC-002, ASEC-08..11):
// Monotonic non-escalation: `@allow_unsafe` cannot override `--safety-profile safe|sandbox`
// or an enclosing `@forbid_unsafe` scope, and invalid safety attribute arguments/placements
// are rejected with `AX_SEC_CONFLICTING_SAFETY_POLICY`.
module conflicting_safety_policy_neg

@allow_unsafe //~ ERROR AX_SEC_CONFLICTING_SAFETY_POLICY
fn escalated_under_safe_profile() -> i32 {
    1i32
}

@forbid_unsafe
@allow_unsafe //~ ERROR AX_SEC_CONFLICTING_SAFETY_POLICY
fn both_on_same_fn() -> i32 {
    2i32
}

@forbid_unsafe(true) //~ ERROR AX_SEC_CONFLICTING_SAFETY_POLICY
fn bad_attr_args() -> i32 {
    3i32
}

pub struct Holder {
    pub x: i32,
}

impl Holder {
    @allow_unsafe //~ ERROR AX_SEC_CONFLICTING_SAFETY_POLICY
    fn bad_method(self: view<Holder>) -> i32 {
        self.x
    }
}

fn bad_local_and_param_attrs(
    @forbid_unsafe x: i32 //~ ERROR AX_SEC_CONFLICTING_SAFETY_POLICY
) -> i32 {
    @allow_unsafe //~ ERROR AX_SEC_CONFLICTING_SAFETY_POLICY
    let y: i32 = x + 1i32;
    y
}

pub fn main() -> i32 {
    0i32
}
