// test: ui
// QA adversarial boundary test for T539 (SPEC-53 §1.4 AXS-SEC-004 (2), REQ-CAP-123):
// Probes remaining source/target combinations across Str, slice views (view<[u8]>, mut_view<[u8]>),
// i8/i16/i64/i128/u16/u32/u128, all authority token types (EnvCap, ProcessCap, ClockCap,
// SandboxCaps, RootCaps), and unsafe {} blocks.
module qa_t539_boundary_coercion_neg

pub struct EnvCap {
    pub id: u32,
}

pub struct ProcessCap {
    pub pid: u32,
}

pub struct ClockCap {
    pub cid: u32,
}

pub struct SandboxCaps {
    pub mask: u32,
}

pub struct RootCaps {
    pub mask: u32,
}

pub struct PhysAddr {
    pub addr: u64,
}

pub struct VirtAddr {
    pub addr: usize,
}

pub struct WasmAddr {
    pub off: u32,
}

fn take_slice_view(_v: view<[u8]>) -> usize {
    0usize
}

fn take_slice_mut_view(_v: mut_view<[u8]>) -> usize {
    0usize
}

fn take_str(_s: Str) -> usize {
    0usize
}

fn take_env_cap(c: EnvCap) -> u32 { c.id }
fn take_proc_cap(c: ProcessCap) -> u32 { c.pid }
fn take_clock_cap(c: ClockCap) -> u32 { c.cid }
fn take_sandbox_caps(c: SandboxCaps) -> u32 { c.mask }
fn take_root_caps(c: RootCaps) -> u32 { c.mask }

// 1. Implicit coercions of non-address integer primitives (i8/i16/i64/i128/u16/u32/u128)
//    to slice views, Str, and authority caps -> AX_TYPE_MISMATCH.
pub fn non_addr_ints_to_slice_str_and_all_caps() {
    let _sv1: view<[u8]> = 1i8; //~ ERROR AX_TYPE_MISMATCH
    let _sv2: view<[u8]> = 2i16; //~ ERROR AX_TYPE_MISMATCH
    let _sv3: view<[u8]> = 3i64; //~ ERROR AX_TYPE_MISMATCH
    let _sv4: view<[u8]> = 4i128; //~ ERROR AX_TYPE_MISMATCH
    let _sm1: mut_view<[u8]> = 5u16; //~ ERROR AX_TYPE_MISMATCH
    let _sm2: mut_view<[u8]> = 6u32; //~ ERROR AX_TYPE_MISMATCH
    let _sm3: mut_view<[u8]> = 7u128; //~ ERROR AX_TYPE_MISMATCH

    let _ = take_slice_view(1i8); //~ ERROR AX_TYPE_MISMATCH
    let _ = take_slice_mut_view(7u128); //~ ERROR AX_TYPE_MISMATCH

    let _s1: Str = 10; //~ ERROR AX_TYPE_MISMATCH
    let _s2: Str = 1i8; //~ ERROR AX_TYPE_MISMATCH
    let _s3: Str = 4i128; //~ ERROR AX_TYPE_MISMATCH
    let _s4: Str = 7u128; //~ ERROR AX_TYPE_MISMATCH
    let _ = take_str(4i128); //~ ERROR AX_TYPE_MISMATCH

    let _c1: EnvCap = 1i8; //~ ERROR AX_TYPE_MISMATCH
    let _c2: ProcessCap = 4i128; //~ ERROR AX_TYPE_MISMATCH
    let _c3: ClockCap = 7u128; //~ ERROR AX_TYPE_MISMATCH
    let _c4: SandboxCaps = 2i16; //~ ERROR AX_TYPE_MISMATCH
    let _c5: RootCaps = 6u32; //~ ERROR AX_TYPE_MISMATCH

    let _ = take_env_cap(1i8); //~ ERROR AX_TYPE_MISMATCH
    let _ = take_proc_cap(4i128); //~ ERROR AX_TYPE_MISMATCH
    let _ = take_clock_cap(7u128); //~ ERROR AX_TYPE_MISMATCH
    let _ = take_sandbox_caps(3i64); //~ ERROR AX_TYPE_MISMATCH
    let _ = take_root_caps(5u16); //~ ERROR AX_TYPE_MISMATCH
}

// 2. Explicit casts of non-address ints to slice views, Str, and all authority caps -> AX_SEC_CAPABILITY_FORGERY.
pub fn explicit_casts_boundary(uaddr: usize, iaddr: isize, cp: *const u8, mp: *mut u8) {
    let _e1 = 1i8 as view<[u8]>; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _e2 = 4i128 as mut_view<[u8]>; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _e3 = 7u128 as Str; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _e4 = 10 as Str; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _e5 = 1i8 as EnvCap; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _e6 = 4i128 as ProcessCap; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _e7 = 7u128 as ClockCap; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _e8 = 2i16 as SandboxCaps; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _e9 = 6u32 as RootCaps; //~ ERROR AX_SEC_CAPABILITY_FORGERY

    let _ea1 = uaddr as Str; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _ea2 = iaddr as view<[u8]>; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _ea3 = cp as Str; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _ea4 = mp as mut_view<[u8]>; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _ea5 = (PhysAddr { addr: 0x1000u64 }) as Str; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _ea6 = (VirtAddr { addr: 0x2000usize }) as SandboxCaps; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _ea7 = (WasmAddr { off: 16u32 }) as RootCaps; //~ ERROR AX_SEC_CAPABILITY_FORGERY
}

// 3. Implicit coercions of raw pointers, usize/isize, and address wrappers to slice views, Str, and all caps.
pub fn addr_and_rawptr_implicit_boundary(uaddr: usize, iaddr: isize, cp: *const u8, mp: *mut u8) {
    let _v1: view<[u8]> = uaddr; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _v2: mut_view<[u8]> = iaddr; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _v3: view<[u8]> = cp; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _v4: mut_view<[u8]> = mp; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _v5: view<[u8]> = PhysAddr { addr: 0x1000u64 }; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _v6: mut_view<[u8]> = VirtAddr { addr: 0x2000usize }; //~ ERROR AX_SEC_CAPABILITY_FORGERY

    // Str: raw pointers trigger AX_SEC_CAPABILITY_FORGERY on implicit coercion;
    // integer addresses only trigger on explicit cast (AX_TYPE_MISMATCH on implicit coercion).
    let _s1: Str = cp; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _s2: Str = mp; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _s3: Str = uaddr; //~ ERROR AX_TYPE_MISMATCH

    let _c1: EnvCap = uaddr; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _c2: ProcessCap = iaddr; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _c3: ClockCap = cp; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _c4: SandboxCaps = mp; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _c5: RootCaps = WasmAddr { off: 64u32 }; //~ ERROR AX_SEC_CAPABILITY_FORGERY
}

// 4. Inside unsafe {} blocks: unsafe does NOT suppress capability forgery or alter AX_TYPE_MISMATCH.
pub fn inside_unsafe_blocks(uaddr: usize, cp: *const u8, mp: *mut u8) {
    unsafe {
        let _u1: view<[u8]> = 4i128; //~ ERROR AX_TYPE_MISMATCH
        let _u2: EnvCap = 7u128; //~ ERROR AX_TYPE_MISMATCH
        let _u3: RootCaps = 10; //~ ERROR AX_TYPE_MISMATCH
        let _u4: view<[u8]> = cp; //~ ERROR AX_SEC_CAPABILITY_FORGERY
        let _u5: mut_view<[u8]> = uaddr; //~ ERROR AX_SEC_CAPABILITY_FORGERY
        let _u6: RootCaps = VirtAddr { addr: 0x3000usize }; //~ ERROR AX_SEC_CAPABILITY_FORGERY
        let _u7 = 1i8 as SandboxCaps; //~ ERROR AX_SEC_CAPABILITY_FORGERY
        let _u8 = mp as Str; //~ ERROR AX_SEC_CAPABILITY_FORGERY
        let _u9: Str = mp; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    }
}

pub fn main() -> i32 {
    0i32
}
