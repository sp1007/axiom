// test: ui
// flags: --safety-profile sandbox
// QA adversarial boundary test (T517 / SPEC-53):
// 1. Transitive ambient-authority calls via closures, impl methods, and generic functions.
// 2. Capability forgery via isize/VirtAddr/WasmAddr casts, call-argument coercion, and explicit return.
module qa_sandbox_transitive_and_forgery_neg

use std.core.host.args_count
use std.io.File

pub struct ClockCap {
    pub tick: u64,
}

pub struct ProcessCap {
    pub pid: u32,
}

pub struct VirtAddr {
    pub addr: usize,
}

pub struct WasmAddr {
    pub off: u32,
}

pub struct Helper {
    pub id: i32,
}

impl Helper {
    fn sneak_io(self: view<Helper>) {
        let _ = File.open("sneaky.txt"); //~ ERROR AX_SEC_AMBIENT_AUTHORITY_FORBIDDEN
    }
}

fn generic_env<T>(x: T) -> T {
    let _ = args_count(); //~ ERROR AX_SEC_AMBIENT_AUTHORITY_FORBIDDEN
    x
}

fn call_through_closure() {
    let f = || {
        let _ = File.open("closure.txt"); //~ ERROR AX_SEC_AMBIENT_AUTHORITY_FORBIDDEN
    };
    f();
}

pub fn call_transitive_seams(h: view<Helper>) -> i32 {
    h.sneak_io(); //~ ERROR AX_SEC_AMBIENT_AUTHORITY_FORBIDDEN
    call_through_closure(); //~ ERROR AX_SEC_AMBIENT_AUTHORITY_FORBIDDEN
    generic_env(42i32) //~ ERROR AX_SEC_AMBIENT_AUTHORITY_FORBIDDEN
}

fn take_view(v: view<u32>) -> u32 {
    *v
}

fn take_cap(c: ProcessCap) -> u32 {
    c.pid
}

pub fn forge_extra_seams(neg_addr: isize, va: VirtAddr, wa: WasmAddr, cp: *const u32, addr: usize) {
    let _m = neg_addr as mut_view<u64>; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _v = va as view<u8>; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _c = wa as ClockCap; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _a1 = take_view(cp); //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _a2 = take_cap(addr); //~ ERROR AX_SEC_CAPABILITY_FORGERY
}

pub fn forge_explicit_return_view(cp: *const u32) -> view<u32> {
    return cp; //~ ERROR AX_SEC_CAPABILITY_FORGERY
}

pub fn forge_explicit_return_cap(addr: usize) -> ProcessCap {
    return addr; //~ ERROR AX_SEC_CAPABILITY_FORGERY
}

pub fn main() -> i32 {
    0i32
}
