// test: ui
// flags: --safety-profile sandbox
// SPEC-53 §§1.3 & 2.2 (AXS-SEC-003..004, AXS-SEC-010..011, REQ-CAP-131):
// `--safety-profile sandbox` rejects ambient OS/IO/env/process/clock/stdio calls
// and ambient root capability constructors unless an explicit `*Cap` token is passed.
module sandbox_ambient_authority_neg

use std.core.host.args_count
use std.core.host.exit
use std.io.File
use std.io.file_open
use std.time.Instant

pub struct FsCap {
    pub fd: i32,
}

pub fn root_fs_cap() -> FsCap {
    FsCap { fd: 1i32 }
}

fn indirect_leaf() {
    let _ = file_open("secret.txt"); //~ ERROR AX_SEC_AMBIENT_AUTHORITY_FORBIDDEN
}

fn indirect_caller() {
    indirect_leaf(); //~ ERROR AX_SEC_AMBIENT_AUTHORITY_FORBIDDEN
}

pub fn bad_ambient_calls() {
    let _f1 = File.open("secret.txt"); //~ ERROR AX_SEC_AMBIENT_AUTHORITY_FORBIDDEN
    let _f2 = file_open("secret.txt"); //~ ERROR AX_SEC_AMBIENT_AUTHORITY_FORBIDDEN
    print("ambient stdout"); //~ ERROR AX_SEC_AMBIENT_AUTHORITY_FORBIDDEN
    let _e = args_count(); //~ ERROR AX_SEC_AMBIENT_AUTHORITY_FORBIDDEN
    let _t = Instant.now(); //~ ERROR AX_SEC_AMBIENT_AUTHORITY_FORBIDDEN
    let _root = root_fs_cap(); //~ ERROR AX_SEC_AMBIENT_AUTHORITY_FORBIDDEN
    indirect_caller(); //~ ERROR AX_SEC_AMBIENT_AUTHORITY_FORBIDDEN
    exit(0i32); //~ ERROR AX_SEC_AMBIENT_AUTHORITY_FORBIDDEN
}

pub fn main() -> i32 {
    0i32
}
