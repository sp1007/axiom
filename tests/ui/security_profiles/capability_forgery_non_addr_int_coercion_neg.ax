// test: ui
// T539 / SPEC-53 §1.4 (AXS-SEC-004 (2), REQ-CAP-123):
// 1. Implicit coercions of untyped integer literals (`10`) and non-address integer primitives
//    (`10i32`, `0u64`, `1u8`) to `view<T>`, `mut_view<T>`, and `*Cap` across method calls,
//    function calls, `let` bindings, block tails, and `return` emit `AX_TYPE_MISMATCH`.
// 2. Explicit casts (`10 as view<T>`, `10i32 as mut_view<T>`, `0u64 as FsCap`) and both explicit
//    casts and implicit coercions of raw pointers (`*const T`, `*mut T`), pointer-sized integer
//    addresses (`usize`, `isize`), and address wrappers (`PhysAddr`, `VirtAddr`, `WasmAddr`)
//    to `view<T>`, `mut_view<T>`, and `*Cap` emit `AX_SEC_CAPABILITY_FORGERY`.
module capability_forgery_non_addr_int_coercion_neg

pub struct Point {
    pub x: u32,
    pub y: u32,
}

pub struct FsCap {
    pub fd: i32,
}

pub struct NetCap {
    pub port: u16,
}

pub struct PhysAddr {
    pub addr: u64,
}

pub struct VirtAddr {
    pub addr: usize,
}

pub struct WasmAddr {
    pub off: u32,
}

impl Point {
    pub fn sum(self: view<Point>) -> u32 {
        self.x + self.y
    }

    pub fn bump(self: mut_view<Point>, delta: u32) {
        self.x = self.x + delta;
    }

    pub fn use_cap(self: view<Point>, cap: FsCap) -> i32 {
        cap.fd + (self.x as i32)
    }
}

fn take_view(v: view<Point>) -> u32 {
    v.x
}

fn take_mut_view(v: mut_view<Point>) {
    v.x = v.x + 1u32;
}

fn take_fs_cap(c: FsCap) -> i32 {
    c.fd
}

fn take_net_cap(c: NetCap) -> u16 {
    c.port
}

// --- Implicit coercions of non-address integers -> AX_TYPE_MISMATCH ---

pub fn non_addr_method_and_fn_calls(p: view<Point>) {
    let _ = Point.sum(10); //~ ERROR AX_TYPE_MISMATCH
    let _ = Point.sum(10i32); //~ ERROR AX_TYPE_MISMATCH
    let _ = Point.sum(0u64); //~ ERROR AX_TYPE_MISMATCH
    let _ = Point.sum(1u8); //~ ERROR AX_TYPE_MISMATCH

    Point.bump(10, 1u32); //~ ERROR AX_TYPE_MISMATCH
    Point.bump(10i32, 1u32); //~ ERROR AX_TYPE_MISMATCH
    Point.bump(0u64, 1u32); //~ ERROR AX_TYPE_MISMATCH
    Point.bump(1u8, 1u32); //~ ERROR AX_TYPE_MISMATCH

    let _ = p.use_cap(10); //~ ERROR AX_TYPE_MISMATCH
    let _ = p.use_cap(10i32); //~ ERROR AX_TYPE_MISMATCH
    let _ = p.use_cap(0u64); //~ ERROR AX_TYPE_MISMATCH
    let _ = p.use_cap(1u8); //~ ERROR AX_TYPE_MISMATCH

    let _ = take_view(10); //~ ERROR AX_TYPE_MISMATCH
    let _ = take_view(10i32); //~ ERROR AX_TYPE_MISMATCH
    let _ = take_view(0u64); //~ ERROR AX_TYPE_MISMATCH
    let _ = take_view(1u8); //~ ERROR AX_TYPE_MISMATCH

    take_mut_view(10); //~ ERROR AX_TYPE_MISMATCH
    take_mut_view(10i32); //~ ERROR AX_TYPE_MISMATCH
    take_mut_view(0u64); //~ ERROR AX_TYPE_MISMATCH
    take_mut_view(1u8); //~ ERROR AX_TYPE_MISMATCH

    let _ = take_fs_cap(10); //~ ERROR AX_TYPE_MISMATCH
    let _ = take_fs_cap(10i32); //~ ERROR AX_TYPE_MISMATCH
    let _ = take_fs_cap(0u64); //~ ERROR AX_TYPE_MISMATCH
    let _ = take_fs_cap(1u8); //~ ERROR AX_TYPE_MISMATCH
}

pub fn non_addr_let_and_inner_block_tails() {
    let _v1: view<Point> = 10; //~ ERROR AX_TYPE_MISMATCH
    let _v2: view<Point> = 10i32; //~ ERROR AX_TYPE_MISMATCH
    let _v3: view<Point> = 0u64; //~ ERROR AX_TYPE_MISMATCH
    let _v4: view<Point> = 1u8; //~ ERROR AX_TYPE_MISMATCH

    let _m1: mut_view<Point> = 10; //~ ERROR AX_TYPE_MISMATCH
    let _m2: mut_view<Point> = 10i32; //~ ERROR AX_TYPE_MISMATCH
    let _m3: mut_view<Point> = 0u64; //~ ERROR AX_TYPE_MISMATCH
    let _m4: mut_view<Point> = 1u8; //~ ERROR AX_TYPE_MISMATCH

    let _c1: FsCap = 10; //~ ERROR AX_TYPE_MISMATCH
    let _c2: FsCap = 10i32; //~ ERROR AX_TYPE_MISMATCH
    let _c3: FsCap = 0u64; //~ ERROR AX_TYPE_MISMATCH
    let _c4: FsCap = 1u8; //~ ERROR AX_TYPE_MISMATCH

    let _bv: view<Point> = {
        10 //~ ERROR AX_TYPE_MISMATCH
    };
    let _bm: mut_view<Point> = {
        10i32 //~ ERROR AX_TYPE_MISMATCH
    };
    let _bc1: FsCap = {
        0u64 //~ ERROR AX_TYPE_MISMATCH
    };
    let _bc2: FsCap = {
        1u8 //~ ERROR AX_TYPE_MISMATCH
    };
}

pub fn non_addr_tail_view_lit() -> view<Point> {
    10 //~ ERROR AX_TYPE_MISMATCH
}

pub fn non_addr_tail_view_i32() -> view<Point> {
    10i32 //~ ERROR AX_TYPE_MISMATCH
}

pub fn non_addr_tail_mut_view_u64() -> mut_view<Point> {
    0u64 //~ ERROR AX_TYPE_MISMATCH
}

pub fn non_addr_tail_cap_u8() -> FsCap {
    1u8 //~ ERROR AX_TYPE_MISMATCH
}

pub fn non_addr_ret_view_lit() -> view<Point> {
    return 10; //~ ERROR AX_TYPE_MISMATCH
}

pub fn non_addr_ret_view_i32() -> view<Point> {
    return 10i32; //~ ERROR AX_TYPE_MISMATCH
}

pub fn non_addr_ret_mut_view_u64() -> mut_view<Point> {
    return 0u64; //~ ERROR AX_TYPE_MISMATCH
}

pub fn non_addr_ret_cap_u8() -> FsCap {
    return 1u8; //~ ERROR AX_TYPE_MISMATCH
}

// --- Explicit casts & raw-pointer / address implicit coercions -> AX_SEC_CAPABILITY_FORGERY ---

pub fn explicit_casts_still_forgeries(
    uaddr: usize,
    iaddr: isize,
    cp: *const Point,
    mp: *mut Point
) {
    let _ec1 = 10 as view<Point>; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _ec2 = 10i32 as mut_view<Point>; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _ec3 = 0u64 as FsCap; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _ec4 = 1u8 as view<Point>; //~ ERROR AX_SEC_CAPABILITY_FORGERY

    let _ea1 = uaddr as view<Point>; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _ea2 = iaddr as mut_view<Point>; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _ea3 = cp as view<Point>; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _ea4 = mp as mut_view<Point>; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _ea5 = (PhysAddr { addr: 0x1000u64 }) as view<Point>; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _ea6 = (VirtAddr { addr: 0x2000usize }) as mut_view<Point>; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _ea7 = (WasmAddr { off: 64u32 }) as NetCap; //~ ERROR AX_SEC_CAPABILITY_FORGERY
}

pub fn addr_and_rawptr_implicit_coercions(
    uaddr: usize,
    iaddr: isize,
    cp: *const Point,
    mp: *mut Point,
    p: view<Point>
) {
    let _ = Point.sum(uaddr); //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _ = Point.sum(iaddr); //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _ = Point.sum(cp); //~ ERROR AX_SEC_CAPABILITY_FORGERY
    Point.bump(mp, 1u32); //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _ = p.use_cap(uaddr); //~ ERROR AX_SEC_CAPABILITY_FORGERY

    let _v_u: view<Point> = uaddr; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _m_i: mut_view<Point> = iaddr; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _v_cp: view<Point> = cp; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _m_mp: mut_view<Point> = mp; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _c_u: FsCap = uaddr; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _c_i: NetCap = iaddr; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _c_cp: FsCap = cp; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _c_mp: NetCap = mp; //~ ERROR AX_SEC_CAPABILITY_FORGERY

    let _v_pa: view<Point> = PhysAddr { addr: 0x1000u64 }; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _m_va: mut_view<Point> = VirtAddr { addr: 0x2000usize }; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _c_wa: FsCap = WasmAddr { off: 64u32 }; //~ ERROR AX_SEC_CAPABILITY_FORGERY

    let _ = take_view(PhysAddr { addr: 0x1000u64 }); //~ ERROR AX_SEC_CAPABILITY_FORGERY
    take_mut_view(VirtAddr { addr: 0x2000usize }); //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _ = take_net_cap(WasmAddr { off: 64u32 }); //~ ERROR AX_SEC_CAPABILITY_FORGERY

    let _bt: view<Point> = {
        uaddr //~ ERROR AX_SEC_CAPABILITY_FORGERY
    };
}

pub fn addr_tail_forgery(iaddr: isize) -> mut_view<Point> {
    iaddr //~ ERROR AX_SEC_CAPABILITY_FORGERY
}

pub fn addr_ret_forgery() -> FsCap {
    return WasmAddr { off: 128u32 }; //~ ERROR AX_SEC_CAPABILITY_FORGERY
}

pub fn main() -> i32 {
    0i32
}
