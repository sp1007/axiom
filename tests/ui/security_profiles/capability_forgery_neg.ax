// test: ui
// SPEC-53 §§1.4 & 2.1 (AXS-SEC-004, AXS-SEC-010, REQ-CAP-010, REQ-CAP-123):
// Reject forging safe views (`view<T>`, `mut_view<T>`, `Str`) or authority capability tokens
// (`FsCap`, `NetCap`, `EnvCap`, `ProcessCap`, `ClockCap`, `SandboxCaps`, `RootCaps`)
// from integers, raw pointers, or `PhysAddr`/`VirtAddr` — both outside and inside `unsafe`.
module capability_forgery_neg

pub struct FsCap {
    fd: i32,
}

pub struct NetCap {
    port: u16,
}

pub struct PhysAddr {
    addr: u64,
}

pub fn bad_cast_forgeries(addr: usize, cp: *const u32, mp: *mut u32, raw_bytes: *const u8, pa: PhysAddr) {
    let _v1 = addr as view<u32>; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _v2 = cp as view<u32>; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _v3 = mp as mut_view<u32>; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _s1 = addr as Str; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _c1 = addr as FsCap; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _c2 = raw_bytes as NetCap; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _p1 = pa as view<u8>; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    unsafe {
        let _u1 = mp as mut_view<u32>; //~ ERROR AX_SEC_CAPABILITY_FORGERY
        let _u2 = addr as FsCap; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    }
}

pub fn bad_coercion_forgeries(cp: *const u32, addr: usize) -> view<u32> {
    let _v: view<u32> = cp; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    let _c: FsCap = addr; //~ ERROR AX_SEC_CAPABILITY_FORGERY
    cp //~ ERROR AX_SEC_CAPABILITY_FORGERY
}

pub fn main() -> i32 {
    0i32
}
