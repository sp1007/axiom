// test: ui
// SPEC-53 §§1.1-1.3 (AXS-SEC-001..003):
// Under default `--safety-profile system`:
// - `@forbid_unsafe` on an item/impl rejects unsafe constructs with `AX_SEC_UNSAFE_FORBIDDEN`
// - unannotated items without `unsafe {}` report `AX_UNSAFE_REQUIRED` (no duplicate diagnostics)
// - unannotated items WITH `unsafe {}` are permitted cleanly.
module mixed_forbid_and_system_neg

pub struct BoxedPtr {
    pub p: *const i32,
}

@forbid_unsafe
fn locked_fn(p: *const i32) -> i32 {
    unsafe { *p } //~ ERROR AX_SEC_UNSAFE_FORBIDDEN
}

@forbid_unsafe
impl BoxedPtr {
    fn bad_read(self: view<BoxedPtr>) -> i32 {
        let raw = self.p;
        *raw //~ ERROR AX_SEC_UNSAFE_FORBIDDEN
    }
}

fn system_missing_unsafe(p: *const i32) -> i32 {
    *p //~ ERROR AX_UNSAFE_REQUIRED
}

fn system_valid_unsafe(p: *const i32) -> i32 {
    unsafe { *p }
}

pub fn main() -> i32 {
    let x: i32 = 9i32;
    let _ = x;
    0i32
}
