// test: ui
// SPEC-53 §2.2 (AXS-SEC-011 (3), ASEC-23..25, REQ-CAP-131):
// Comptime isolation:
// 1. `const`, `comptime fn`, and `comptime { ... }` reject direct or transitive OS authority calls.
// 2. `const` / `static` items cannot hold runtime authority capability values (`ASEC-24`).
// 3. `comptime fn` / `comptime { ... }` cannot declare or capture runtime `*Cap` tokens (`ASEC-25`).
module comptime_ambient_isolation_neg

use std.core.host.args_count
use std.io.file_open
use std.time.Instant
use std.time.instant_as_nanos

pub struct FsCap {
    pub fd: i32,
}

fn check_secret_exists() -> bool {
    let _ = file_open("secret.txt");
    false
}

fn read_wall_clock_ns() -> u64 {
    let t = Instant.now();
    instant_as_nanos(view(t))
}

const BAD_CONST_FS: bool = check_secret_exists(); //~ ERROR AX_SEC_AMBIENT_AUTHORITY_FORBIDDEN

const LEAKED_CAP_CONST: FsCap = FsCap { fd: 3i32 }; //~ ERROR AX_SEC_AMBIENT_AUTHORITY_FORBIDDEN

static LEAKED_CAP_STATIC: FsCap = FsCap { fd: 4i32 }; //~ ERROR AX_SEC_AMBIENT_AUTHORITY_FORBIDDEN

comptime fn bad_comptime_transitive() -> u64 {
    read_wall_clock_ns() //~ ERROR AX_SEC_AMBIENT_AUTHORITY_FORBIDDEN
}

comptime fn bad_comptime_takes_cap(
    cap: view<FsCap> //~ ERROR AX_SEC_AMBIENT_AUTHORITY_FORBIDDEN
) -> i32 {
    let _ = cap;
    0i32
}

pub fn bad_comptime_blocks(cap: view<FsCap>) -> i32 {
    let a = comptime {
        let _ = args_count(); //~ ERROR AX_SEC_AMBIENT_AUTHORITY_FORBIDDEN
        1i32
    };
    let b = comptime {
        let _ = cap; //~ ERROR AX_SEC_AMBIENT_AUTHORITY_FORBIDDEN
        2i32
    };
    a + b
}

pub fn main() -> i32 {
    0i32
}
