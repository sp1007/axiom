// test: ui
// flags: --safety-profile sandbox
// SPEC-53 §4 (AXS-SEC-052):
// Canonical negative example: reports `AX_SEC_UNSAFE_FORBIDDEN`,
// `AX_SEC_AMBIENT_AUTHORITY_FORBIDDEN`, and `AX_SEC_CAPABILITY_FORGERY` together in one pass.
@forbid_unsafe
module demo

use std.io.File

fn raw_poke(p: *mut u32) {
    unsafe { *p = 1u32; } //~ ERROR AX_SEC_UNSAFE_FORBIDDEN
}

fn open_ambient() {
    let _ = File.open("secret"); //~ ERROR AX_SEC_AMBIENT_AUTHORITY_FORBIDDEN
}

fn forge_view(addr: usize) -> view<u32> {
    addr as view<u32> //~ ERROR AX_SEC_CAPABILITY_FORGERY
}

pub fn main() -> i32 {
    0i32
}
