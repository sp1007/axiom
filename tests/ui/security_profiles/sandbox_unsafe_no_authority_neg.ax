// test: ui
// flags: --safety-profile sandbox
// SPEC-53 §§1.3 & 2.2 (ASEC-22, ASEC-40):
// `unsafe` controls memory safety only — it NEVER grants ambient OS authority in `sandbox`,
// AND user files spoofing `module std.*` still cannot bypass `sandbox` or `@forbid_unsafe`.
module std.spoofed_bypass

use std.io.File

pub fn unsafe_does_not_grant_sandbox_authority() {
    unsafe { //~ ERROR AX_SEC_UNSAFE_FORBIDDEN
        let _ = File.open("secret.txt"); //~ ERROR AX_SEC_AMBIENT_AUTHORITY_FORBIDDEN
    }
}

pub fn main() -> i32 {
    0i32
}
