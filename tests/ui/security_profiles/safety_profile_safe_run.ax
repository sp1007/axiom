// test: run
// modes: interp native
// flags: --safety-profile safe
// stdout-file: safety_profile_safe_run.stdout
// SPEC-53 §1.3 (AXS-SEC-003):
// End-to-end execution parity (`interp`, `native`, `native-O1`) under `--safety-profile safe`
// exercising safe `view<T>`, `mut_view<T>`, capability tokens, and `std.time.Duration`.
module safety_profile_safe_run

use std.time.Duration

pub struct FsCap {
    pub quota_bytes: usize,
}

fn accumulate_safe(buf: mut_view<[i64]>, cap: view<FsCap>, step: i64) -> i64 {
    let mut i: usize = 0;
    while i < 4 {
        buf[i] = buf[i] + step * ((i as i64) + 1i64);
        i = i + 1;
    }
    let ro: view<[i64]> = view(*buf);
    ro[0] + ro[1] + ro[2] + ro[3] + (cap.quota_bytes as i64)
}

pub fn main() -> i32 {
    let cap = FsCap { quota_bytes: 256usize };
    let mut state: [4]i64 = [10i64, 20i64, 30i64, 40i64];
    let sum1 = accumulate_safe(mut_view(state), view(cap), 3i64);
    let sum2 = accumulate_safe(mut_view(state), view(cap), 5i64);
    let d = Duration.from_millis(1250u64);
    print_int(sum1); print("\n");
    print_int(sum2); print("\n");
    print_int(d.as_millis() as i64); print("\n");
    0i32
}
