// test: ui
// flags: --safety-profile safe
// QA T540 boundary cross-check (SPEC-53 AXS-SEC-003, ADR-0001 sections 1-2): every overlay form of a fixed-address
// declaration (`@at` array static, `@addr` scalar static, `@addr` fn) under `--safety-profile safe` yields exactly one
// AX_SEC_UNSAFE_FORBIDDEN each, anchored on the attribute line, with no extra diagnostic; ordinary safe items stay clean.
module qa_t540_addr_overlay_forms_neg

@at(0x3000usize) //~ ERROR AX_SEC_UNSAFE_FORBIDDEN
unsafe static REG_ARRAY: [4]u32;

@addr(0x4000usize) //~ ERROR AX_SEC_UNSAFE_FORBIDDEN
unsafe static REG_SCALAR: u32;

@addr(0x5000usize) //~ ERROR AX_SEC_UNSAFE_FORBIDDEN
unsafe fn placed_handler() -> i32 {
    3i32
}

static SAFE_TABLE: u32 = 9u32;

pub fn plain(x: i32) -> i32 {
    x + 1i32
}

pub fn main() -> i32 {
    plain(1i32)
}
