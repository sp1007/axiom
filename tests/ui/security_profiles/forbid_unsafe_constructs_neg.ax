// test: ui
// SPEC-53 §1.1 (AXS-SEC-001, ASEC-01..07):
// @forbid_unsafe module rejects all 7 unsafe construct classes with AX_SEC_UNSAFE_FORBIDDEN.
@forbid_unsafe
module forbid_unsafe_constructs_neg

use std.core.mem.address_of

pub struct Node {
    pub val: i32,
}

static mut GLOBAL_COUNTER: i32 = 0i32; //~ ERROR AX_SEC_UNSAFE_FORBIDDEN

extern "C" { //~ ERROR AX_SEC_UNSAFE_FORBIDDEN
    fn c_puts(s: *const u8) -> i32;
}

unsafe trait TrustedMarker { //~ ERROR AX_SEC_UNSAFE_FORBIDDEN
    fn check(self: view<Self>) -> bool;
}

trait NormalTrait {
    fn tag(self: view<Self>) -> i32;
}

unsafe impl NormalTrait for Node { //~ ERROR AX_SEC_UNSAFE_FORBIDDEN
    fn tag(self: view<Node>) -> i32 { self.val }
}

unsafe fn raw_helper(p: *const i32) -> i32 { //~ ERROR AX_SEC_UNSAFE_FORBIDDEN
    *p
}

@export //~ ERROR AX_SEC_UNSAFE_FORBIDDEN
pub fn exported_api(x: i32) -> i32 {
    x + 1i32
}

@no_mangle //~ ERROR AX_SEC_UNSAFE_FORBIDDEN
pub fn unmangled_api(x: i32) -> i32 {
    x + 2i32
}

@at(0x1000usize) //~ ERROR AX_SEC_UNSAFE_FORBIDDEN
static MMIO_REG: u32 = 0u32;

@naked //~ ERROR AX_SEC_UNSAFE_FORBIDDEN
unsafe fn naked_stub() {}

pub fn exercise_body_constructs(p: *mut i32, np: *const Node) -> i32 {
    unsafe { //~ ERROR AX_SEC_UNSAFE_FORBIDDEN
        *p = 10i32;
    }
    let a = *p; //~ ERROR AX_SEC_UNSAFE_FORBIDDEN
    let b = np.val; //~ ERROR AX_SEC_UNSAFE_FORBIDDEN
    let q = p + 1usize; //~ ERROR AX_SEC_UNSAFE_FORBIDDEN
    let local_v: i32 = 5i32;
    let _addr = address_of(local_v); //~ ERROR AX_SEC_UNSAFE_FORBIDDEN
    let c = GLOBAL_COUNTER; //~ ERROR AX_SEC_UNSAFE_FORBIDDEN
    let _ = q;
    a + b + c
}

pub fn main() -> i32 {
    0i32
}
