// test: ui
// flags: --safety-profile sandbox
// SPEC-53 §§1.3 & 2.1-2.2 (AXS-SEC-003..004, AXS-SEC-010..011, AXS-SEC-053):
// Positive check: capability-explicit functions (`FsCap`, `NetCap`, `EnvCap`, `ProcessCap`,
// `ClockCap`, `SandboxCaps`), pure `Duration`, and safe `view<T>`/`mut_view<T>` operations
// compile cleanly with 0 errors under `--safety-profile sandbox`.
module sandbox_capability_ok

use std.time.Duration

pub struct FsCap {
    pub root_fd: i32,
}

pub struct NetCap {
    pub port_limit: u16,
}

pub struct EnvCap {
    pub prefix_len: usize,
}

pub struct ProcessCap {
    pub allow_children: bool,
}

pub struct ClockCap {
    pub epoch_offset_ns: u64,
}

pub struct SandboxCaps {
    pub fs: FsCap,
    pub net: NetCap,
    pub clock: ClockCap,
}

pub fn read_scoped(cap: view<FsCap>, rel_path: Str) -> usize {
    let _ = cap.root_fd;
    len(rel_path)
}

pub fn connect_scoped(net: view<NetCap>, port: u16) -> bool {
    port <= net.port_limit
}

pub fn now_scoped(clk: view<ClockCap>) -> Duration {
    Duration.from_nanos(clk.epoch_offset_ns + 5000u64)
}

pub fn run_sandbox_plugin(caps: view<SandboxCaps>, buf: mut_view<[i32]>) -> i32 {
    let n = read_scoped(view(caps.fs), "config.json");
    let ok = connect_scoped(view(caps.net), 443u16);
    let dur = now_scoped(view(caps.clock));
    buf[0] = (n as i32) + (if ok { 10i32 } else { 0i32 });
    buf[1] = dur.as_nanos() as i32;
    let v: view<[i32]> = view(*buf);
    v[0] + v[1]
}

pub fn main() -> i32 {
    let caps = SandboxCaps {
        fs: FsCap { root_fd: 3i32 },
        net: NetCap { port_limit: 1024u16 },
        clock: ClockCap { epoch_offset_ns: 1000u64 },
    };
    let mut arr: [4]i32 = [0i32, 0i32, 0i32, 0i32];
    let total = run_sandbox_plugin(view(caps), mut_view(arr));
    if total == 6021i32 { 0i32 } else { 1i32 }
}
