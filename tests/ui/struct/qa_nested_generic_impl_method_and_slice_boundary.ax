// test: run
// stdout: qa_struct_slice_ok 132 0 0 30\n

// QA adversarial boundary test for T433:
// 1. Generic `impl<U> Holder<U>`, generic method `Mapper.map_one<U>`, and multi-parameter
//    generic function `make_pair<T, U>` coexisting with top-level nominal one-line `;`-separated
//    `struct T`, `struct U`, and `struct F`.
// 2. Empty equal-bound slices `v[2..2]` and `mv[3..3]` succeeding with length 0 at runtime
//    alongside non-empty sub-slice `v[2..3]`.

struct T { a: i32 } ; struct U { b: i32 } ; struct F { c: i32 }

struct Holder<U> {
    val: U,
}

impl<U> Holder<U> {
    fn into_val(self: Holder<U>) -> U {
        self.val
    }
}

struct Pair<T, U> {
    first: T,
    second: U,
}

struct Mapper {
    bonus: i32,
}

impl Mapper {
    fn map_one<U>(self: Mapper, val: U) -> U {
        let _ = self.bonus;
        val
    }
}

fn make_pair<T, U>(left: T, right: U) -> Pair<T, U> {
    Pair { first: left, second: right }
}

pub fn main() -> i32 {
    let h1 = Holder { val: T { a: 40 } };
    let h2 = Holder { val: U { b: 60 } };
    let m = Mapper { bonus: 2 };
    let bonus = m.bonus;
    let f2 = m.map_one(F { c: 30 });
    let mp = make_pair(h1.into_val().a + h2.into_val().b, f2.c + bonus);
    let sum_nom = mp.first + mp.second;

    let arr1: [5]i32 = [10, 20, 30, 40, 50];
    let v: view<[i32]> = view(arr1);
    let empty_v = v[2..2];
    let len_empty_v = len(empty_v) as i64;
    let mid_v = v[2..3];
    let mid_elem = mid_v[0] as i64;

    let mut arr2: [5]i32 = [10, 20, 30, 40, 50];
    let mv: mut_view<[i32]> = mut_view(arr2);
    let empty_mv = mv[3..3];
    let len_empty_mv = len(empty_mv) as i64;

    print("qa_struct_slice_ok ");
    print_int(sum_nom as i64);
    print(" ");
    print_int(len_empty_v);
    print(" ");
    print_int(len_empty_mv);
    print(" ");
    print_int(mid_elem);
    print("\n");
    0
}
