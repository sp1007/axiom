// test: run
// exit: 101

// Regression for T433: inverted slice range on a mutable slice view compiles cleanly
// through MIR capability verification and panics at runtime with exit code 101 (SPEC-03 AXS-SEM-037).
fn main() -> i32 {
    let mut arr: [5]i32 = [10, 20, 30, 40, 50];
    let mv: mut_view<[i32]> = mut_view(arr);
    let sub = mv[4..1];
    let _ = len(sub);
    0
}
