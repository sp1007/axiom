// test: run
// stdout: struct_t_shadow_ok 42\n

// Regression for T433: top-level nominal types named `T` and `F` (including one-line `;`-separated items)
// must not shadow generic type parameters `<F, T>` in implicitly loaded `<std>/future/block_on.ax`
// or in user generic functions/impls.
struct S { x: i32 } ; struct T { y: i32 } ; struct F { z: i32 }

struct Boxed<T> {
    val: T,
}

impl<T> Boxed<T> {
    fn into_val(self: Boxed<T>) -> T {
        self.val
    }
}

fn passthrough<T>(v: T) -> T { v } ; fn base_bonus() -> i32 { 2 }

pub fn main() -> i32 {
    let s = S { x: 10 }; let t = T { y: 20 }; let f = F { z: 10 };
    let b = Boxed { val: passthrough(t) };
    let total = s.x + b.into_val().y + passthrough(f).z + base_bonus();
    print("struct_t_shadow_ok ");
    print_int(total as i64);
    print("\n");
    0
}
