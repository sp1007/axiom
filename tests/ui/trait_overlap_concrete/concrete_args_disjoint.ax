// test: ui
// Regression for T447 (FU-C, ADR-0042 §2): impls of one trait whose headers differ only in a concrete
// type argument do not overlap — the coherence check unifies the headers (fresh variables for the
// impl generics, concrete types must match) before reporting AX_TRAIT_OVERLAP.

trait Tag {
    fn tag(self: view<Self>) -> i64;
}

struct W<F, T> {
    fut: F,
    tag: T,
}

impl<F> Tag for W<F, i64> {
    fn tag(self: view<W<F, i64>>) -> i64 { 1i64 }
}

impl<F> Tag for W<F, ()> {
    fn tag(self: view<W<F, ()>>) -> i64 { 2i64 }
}

impl<F> Tag for W<F, *const i64> {
    fn tag(self: view<W<F, *const i64> >) -> i64 { 3i64 }
}

impl<F> Tag for W<F, *mut i64> {
    fn tag(self: view<W<F, *mut i64> >) -> i64 { 7i64 }
}

impl<F> Tag for W<F, (i64, bool)> {
    fn tag(self: view<W<F, (i64, bool)> >) -> i64 { 8i64 }
}

impl<F> Tag for W<F, (i64, i32)> {
    fn tag(self: view<W<F, (i64, i32)> >) -> i64 { 9i64 }
}

impl<F> Tag for W<F, W<i64, bool> > {
    fn tag(self: view<W<F, W<i64, bool> > >) -> i64 { 4i64 }
}

impl<F> Tag for W<F, W<i64, i32> > {
    fn tag(self: view<W<F, W<i64, i32> > >) -> i64 { 5i64 }
}

trait Pair {
    fn pair(self: view<Self>) -> i64;
}

// Repeated impl generic: `W<X, X>` and `W<bool, i64>` cannot unify (X would be both bool and i64).
impl<X> Pair for W<X, X> {
    fn pair(self: view<W<X, X> >) -> i64 { 6i64 }
}

impl Pair for W<bool, i64> {
    fn pair(self: view<W<bool, i64> >) -> i64 { 10i64 }
}

impl<F> Pair for W<*const F, F> {
    fn pair(self: view<W<*const F, F> >) -> i64 { 11i64 }
}

impl<F> Future for W<F, i64> {
    type Output = i64;
    fn poll(self: mut_view<W<F, i64>>, cx: mut_view<Context>) -> Poll<i64> {
        let _ = cx;
        Poll.Ready(self.tag)
    }
}

impl<F> Future for W<F, ()> {
    type Output = ();
    fn poll(self: mut_view<W<F, ()>>, cx: mut_view<Context>) -> Poll<()> {
        let _ = cx;
        Poll.Ready(())
    }
}

fn main() {}
