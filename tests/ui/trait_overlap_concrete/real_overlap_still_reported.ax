// test: ui
// Regression for T447 (FU-C, ADR-0042 §2): a real overlap is still reported after header unification.
// `impl<F, T> Tag for W<F, T>` (T free) overlaps every `impl<F> Tag for W<F, C>`; the diagnostic sits
// on the later impl. Repeated impl generics must bind consistently (`W<X, X>` vs `W<i64, bool>` is
// disjoint, `W<X, X>` vs `W<i64, i64>` overlaps).

trait Tag {
    fn tag(self: view<Self>) -> i64;
}

struct W<F, T> {
    fut: F,
    tag: T,
}

impl<F, T> Tag for W<F, T> {
    fn tag(self: view<W<F, T>>) -> i64 { 1i64 }
}

impl<F> Tag for W<F, i64> { //~ ERROR AX_TRAIT_OVERLAP
    fn tag(self: view<W<F, i64>>) -> i64 { 2i64 }
}

trait Same {
    fn same(self: view<Self>) -> i64;
}

impl<X> Same for W<X, X> {
    fn same(self: view<W<X, X>>) -> i64 { 1i64 }
}

impl Same for W<i64, bool> {
    fn same(self: view<W<i64, bool>>) -> i64 { 2i64 }
}

impl Same for W<i64, i64> { //~ ERROR AX_TRAIT_OVERLAP
    fn same(self: view<W<i64, i64>>) -> i64 { 3i64 }
}

impl<F> Future for W<F, i64> {
    type Output = i64;
    fn poll(self: mut_view<W<F, i64>>, cx: mut_view<Context>) -> Poll<i64> {
        let _ = cx;
        Poll.Ready(self.tag)
    }
}

impl<F, T> Future for W<F, T> { //~ ERROR AX_TRAIT_OVERLAP
    type Output = T;
    fn poll(self: mut_view<W<F, T>>, cx: mut_view<Context>) -> Poll<T> {
        let _ = cx;
        Poll.Pending
    }
}

fn main() {}
