@intrinsic fn mul_add_f64(x: f64, y: f64, z: f64) -> f64 { 0.0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn min_f64(x: f64, y: f64) -> f64 { 0.0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn max_f64(x: f64, y: f64) -> f64 { 0.0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn next_up_f64(x: f64) -> f64 { 0.0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn next_down_f64(x: f64) -> f64 { 0.0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC

@intrinsic fn floor_f32(x: f32) -> f32 { 0.0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
