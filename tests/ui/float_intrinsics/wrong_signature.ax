// test: ui
// T458a (SPEC-41 AXS-FLT-026, ADR-0049): float intrinsics require exact unsigned-int-of-float-width
// signatures (`to_bits_f64: fn(f64) -> u64`, `to_bits_f32: fn(f32) -> u32`, etc.) and zero generics.

@intrinsic fn to_bits_f64(x: f64) -> i64 { 0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn from_bits_f64(v: i64) -> f64 { 0.0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn to_bits_f32(x: f32) -> u64 { 0u64 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn from_bits_f32(v: u64) -> f32 { 0.0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn sqrt_f64(x: f64, y: f64) -> f64 { 0.0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn abs_f32(x: f32) -> f64 { 0.0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn copysign_f32(x: f32) -> f32 { 0.0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn copysign_f64(x: f64, y: f32) -> f64 { 0.0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn sqrt_f32<T>(x: f32) -> f32 { 0.0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC

fn check_usize() {
    // Also reject `usize` even on 64-bit targets where `usize` has the same width as `u64`.
}
@intrinsic fn abs_f64(x: usize) -> f64 { 0.0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC

fn main() -> i32 {
    check_usize();
    0
}
