// test: ui
// T458a (SPEC-41 AXS-FLT-026, ADR-0049): float intrinsics require `_f32` or `_f64` suffixes;
// integer width suffixes, unsuffixed names, and integer intrinsics given float suffixes are rejected.

@intrinsic fn sqrt_i32(x: i32) -> i32 { 0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn abs_u64(x: u64) -> u64 { 0u64 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn to_bits_i64(x: i64) -> u64 { 0u64 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn from_bits_u32(v: u32) -> u32 { 0u32 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn copysign_isize(x: isize, y: isize) -> isize { 0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC

@intrinsic fn sqrt(x: f64) -> f64 { 0.0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn abs(x: f32) -> f32 { 0.0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn to_bits(x: f64) -> u64 { 0u64 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn from_bits(v: u64) -> f64 { 0.0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn copysign(x: f64, y: f64) -> f64 { 0.0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC

@intrinsic fn rotate_left_f64(x: f64, n: u32) -> f64 { 0.0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn wrapping_add_f32(x: f32, y: f32) -> f32 { 0.0 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC
@intrinsic fn count_ones_f64(x: f64) -> u32 { 0u32 } //~ ERROR AX_TYPE_UNKNOWN_INTRINSIC

// Valid `_f32` / `_f64` declarations are accepted.
@intrinsic fn to_bits_f64(x: f64) -> u64 { 0u64 }
@intrinsic fn from_bits_f64(v: u64) -> f64 { 0.0 }
@intrinsic fn sqrt_f64(x: f64) -> f64 { 0.0 }
@intrinsic fn abs_f64(x: f64) -> f64 { 0.0 }
@intrinsic fn copysign_f64(x: f64, y: f64) -> f64 { 0.0 }

fn main() -> i32 { 0 }
