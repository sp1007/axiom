// test: ui

module test_escaping_view_rejected

fn spawn<F: FnOnce + Send>(f: F) -> i32 {
    f()
}

fn spawn_local<F: FnOnce>(f: F) -> i32 {
    f()
}

fn read_view(v: view<i32>) -> i32 {
    *v
}

pub fn main() {
    let x: i32 = 42;
    let vx: view<i32> = view(x);
    let _ = spawn(|| -> i32 { //~ ERROR AX_CONC_ESCAPING_VIEW
        read_view(vx)
    });

    let mut counter: i32 = 0;
    let _ = spawn(|| -> i32 { //~ ERROR AX_CONC_ESCAPING_VIEW
        counter = counter + 1;
        counter
    });

    let y: i32 = 99;
    let vy: view<i32> = view(y);
    let _ = spawn_local(|| -> i32 { //~ ERROR AX_CONC_ESCAPING_VIEW
        read_view(vy)
    });
}
