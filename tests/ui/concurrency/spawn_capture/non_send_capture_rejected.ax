// test: ui

module test_non_send_capture_rejected

struct NonSendToken {
    pub id: i32,
}

impl !Send for NonSendToken {}

struct RawHolder {
    pub ptr: *mut u8,
}

fn spawn<F: FnOnce + Send>(f: F) -> i32 {
    f()
}

pub fn main() {
    let tok = NonSendToken { id: 7 };
    let _ = spawn(|| -> i32 { //~ ERROR AX_CONC_CAPTURE_NOT_SEND
        tok.id
    });

    let holder = RawHolder { ptr: 0 as *mut u8 };
    let _ = spawn(|| -> i32 { //~ ERROR AX_CONC_CAPTURE_NOT_SEND
        let _ = holder.ptr;
        1
    });

    let raw_p: *const i32 = 0 as *const i32;
    let _ = spawn(|| -> i32 { //~ ERROR AX_CONC_CAPTURE_NOT_SEND
        let _ = raw_p;
        2
    });
}
