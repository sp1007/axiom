// test: ui

module test_qa_spawn_return_and_escape_edges

struct NonSendResult {
    pub code: i32,
}

impl !Send for NonSendResult {}

struct SendOnlyPayload {
    pub v: i32,
}

impl !Share for SendOnlyPayload {}

struct LocalOwnedTicket {
    pub raw: *mut u8,
    pub seq: i32,
}

impl !Send for LocalOwnedTicket {}

struct OwnedToken {
    pub id: i32,
}

fn spawn<F: FnOnce + Send>(f: F) -> i32 {
    f()
}

fn spawn_local<F: FnOnce>(f: F) -> i32 {
    f()
}

fn require_share<F: FnOnce + Share>(f: F) -> i32 {
    f()
}

pub fn main() {
    // 1. Spawned closure returning a non-static view<i32> must be rejected:
    let _ = spawn(|| -> view<i32> { //~ ERROR AX_CONC_ESCAPING_VIEW
        let local_x: i32 = 10;
        view(local_x)
    });

    // 2. Spawned closure returning a !Send type must be rejected:
    let _ = spawn(|| -> NonSendResult { //~ ERROR AX_CONC_NOT_SEND
        NonSendResult { code: 5 }
    });

    // 3. !Copy !Send binding moved into `spawn_local` cannot be used afterwards in parent scope:
    let ticket = LocalOwnedTicket { raw: 0 as *mut u8, seq: 11 };
    let _ = spawn_local(|| -> i32 {
        ticket.seq
    });
    let _ = ticket.seq; //~ ERROR AX_MOVE_USE_AFTER_MOVE

    // 4. Second closure capturing a !Copy variable already moved into a prior `spawn`:
    let tok = OwnedToken { id: 77 };
    let _ = spawn(|| -> i32 {
        tok.id
    });
    let _ = spawn(|| -> i32 { //~ ERROR AX_MOVE_USE_AFTER_MOVE
        tok.id
    });

    // 5. Closure capturing a `Send + !Share` struct implements `Send` but NOT `Share`:
    let p = SendOnlyPayload { v: 3 };
    let _ = require_share(|| -> i32 { //~ ERROR AX_CONC_NOT_SHARE
        p.v
    });
}
