// test: ui

module test_use_after_move_after_spawn

struct OwnedBuf {
    pub len: i32,
}

struct OwnedJob {
    pub tag: i32,
}

fn spawn<F: FnOnce + Send>(f: F) -> i32 {
    f()
}

pub fn main() {
    let buf = OwnedBuf { len: 16 };
    let _ = spawn(|| -> i32 {
        buf.len
    });
    let _ = buf.len; //~ ERROR AX_MOVE_USE_AFTER_MOVE

    let job = OwnedJob { tag: 9 };
    let cl = || -> i32 {
        job.tag
    };
    let _ = spawn(cl);
    let _ = job.tag; //~ ERROR AX_MOVE_USE_AFTER_MOVE
}
