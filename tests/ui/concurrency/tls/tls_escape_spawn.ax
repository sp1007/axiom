// test: ui

struct LocalKey<T> {
    pub init_fn: fn() -> T,
    pub drop_fn: fn(*mut u8) -> (),
    pub slot_id: u32,
}

impl<T> !Send for LocalKey<T> {}
impl<T> !Share for LocalKey<T> {}

fn spawn<F: FnOnce<()>>(f: F) {}

@thread_local static mut TLS_VAL: i32 = 10;

fn init_i32() -> i32 { 0 }
fn default_local_drop(p: *mut u8) -> () {}

fn escape_tls_spawn() {
    let v = view(TLS_VAL);
    spawn(|| { //~ ERROR AX_CONC_ESCAPING_VIEW
        let _ = *v;
    });
}

fn escape_local_key_spawn() {
    let k = LocalKey { init_fn: init_i32, drop_fn: default_local_drop, slot_id: 0u32 };
    spawn(|| { //~ ERROR AX_CONC_CAPTURE_NOT_SEND
        let _ = k.slot_id;
    });
}

fn main() {}
