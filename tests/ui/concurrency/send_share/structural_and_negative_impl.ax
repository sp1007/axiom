// test: ui

module test_structural_and_negative_impl

struct RcSim {
    pub count: usize,
}

impl !Send for RcSim {}
impl !Share for RcSim {}

struct Outer {
    pub id: i32,
    pub rc: RcSim,
}

enum Message {
    Ping(i32),
    Raw(*mut u8),
}

struct ArcSim<T> {
    pub ptr: *mut T,
}

unsafe impl<T: Send + Share> Send for ArcSim<T> {}
unsafe impl<T: Send + Share> Share for ArcSim<T> {}

struct UnsyncedCell {
    pub v: i32,
}

impl !Share for UnsyncedCell {}

fn require_send<T: Send>(_x: T) {}
fn require_share<T: Share>(_x: T) {}

fn forward_unconstrained<T>(x: T) {
    require_send(x); //~ ERROR AX_CONC_NOT_SEND
}

fn forward_view_only_send<T: Send>(v: view<T>) {
    require_send(v); //~ ERROR AX_CONC_NOT_SEND
}

pub fn main() {
    let o = Outer { id: 1, rc: RcSim { count: 1 } };
    require_send(o); //~ ERROR AX_CONC_NOT_SEND

    let m = Message.Ping(10);
    require_send(m); //~ ERROR AX_CONC_NOT_SEND

    // ArcSim<UnsyncedCell> fails T: Send + Share because UnsyncedCell is !Share:
    let bad_arc = ArcSim<UnsyncedCell> { ptr: 0 as *mut UnsyncedCell };
    require_send(bad_arc); //~ ERROR AX_CONC_NOT_SEND

    let raw_p: *mut i32 = 0 as *mut i32;
    let bad_closure = || -> i32 {
        let _ = raw_p;
        0
    };
    require_send(bad_closure); //~ ERROR AX_CONC_NOT_SEND
}
