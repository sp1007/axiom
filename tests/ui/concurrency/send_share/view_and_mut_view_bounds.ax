// test: ui

module test_view_and_mut_view_bounds

struct CellBox<T> {
    pub value: T,
}

impl<T> !Share for CellBox<T> {}

fn require_send<T: Send>(_x: T) {}
fn require_share<T: Share>(_x: T) {}

pub fn main() {
    let mut x: i32 = 42;
    // mut_view<i32> is Send (because i32: Send), so this succeeds:
    require_send(mut_view(x));
    // mut_view<T> is never Share:
    require_share(mut_view(x)); //~ ERROR AX_CONC_NOT_SHARE

    let c = CellBox<i32> { value: 7 };
    // CellBox<i32> is Send (value: i32 is Send), even though it is !Share:
    require_send(CellBox<i32> { value: 1 });
    // CellBox<i32> opted out of Share:
    require_share(CellBox<i32> { value: 2 }); //~ ERROR AX_CONC_NOT_SHARE
    // view<CellBox<i32>> is NOT Send and NOT Share because CellBox<i32> is !Share:
    require_send(view(c)); //~ ERROR AX_CONC_NOT_SEND
    require_share(view(c)); //~ ERROR AX_CONC_NOT_SHARE
}
