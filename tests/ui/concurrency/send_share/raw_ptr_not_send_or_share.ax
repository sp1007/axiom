// test: ui

module test_raw_ptr_not_send_or_share

fn require_send<T: Send>(_x: T) {}
fn require_share<T: Share>(_x: T) {}

pub fn main() {
    let p_const: *const i32 = 0 as *const i32;
    let p_mut: *mut i32 = 0 as *mut i32;
    require_send(p_const); //~ ERROR AX_CONC_NOT_SEND
    require_share(p_const); //~ ERROR AX_CONC_NOT_SHARE
    require_send(p_mut); //~ ERROR AX_CONC_NOT_SEND
    require_share(p_mut); //~ ERROR AX_CONC_NOT_SHARE
}
