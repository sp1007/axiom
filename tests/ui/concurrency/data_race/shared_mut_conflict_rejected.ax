// test: ui

module test_shared_mut_conflict_rejected

struct Pair {
    pub a: i32,
    pub b: i32,
}

fn par_join<A: FnOnce, B: FnOnce>(left: A, right: B) -> i32 {
    let l = left();
    let r = right();
    l + r
}

fn spawn_scoped<F: FnOnce>(f: F) -> i32 {
    f()
}

pub fn test_rw_and_ww_scalar_and_field() {
    let mut x: i32 = 10;
    let vx = view(x);
    let mvx = mut_view(x);
    // 1. Concurrent READ/WRITE on the same scalar place `x`:
    let _ = par_join(
        || -> i32 { *vx },
        || -> i32 { *mvx = 20; *mvx } //~ ERROR AX_CONC_SHARED_MUT
    );

    let mut p = Pair { a: 1, b: 2 };
    let mva1 = mut_view(p.a);
    let mva2 = mut_view(p.a);
    // 2. Concurrent WRITE/WRITE on the same struct field `p.a`:
    let _ = par_join(
        || -> i32 { *mva1 = 11; *mva1 },
        || -> i32 { *mva2 = 22; *mva2 } //~ ERROR AX_CONC_SHARED_MUT
    );

    let vp = view(p);
    let mvb = mut_view(p.b);
    // 3. Concurrent READ of whole struct `p` vs WRITE of field `p.b` (overlapping prefix):
    let _ = par_join(
        || -> i32 { let whole = *vp; whole.a },
        || -> i32 { *mvb = 33; *mvb } //~ ERROR AX_CONC_SHARED_MUT
    );
}

pub fn test_slice_overlap_and_unknown(i: usize, j: usize) {
    let mut arr: [4]i32 = [1, 2, 3, 4];
    let s1 = mut_view(arr[0..3]);
    let s2 = mut_view(arr[2..4]);
    // 4. Overlapping constant slice sub-ranges `[0..3]` and `[2..4]`:
    let _ = par_join(
        || -> i32 { let _ = s1; 1 },
        || -> i32 { let _ = s2; 2 } //~ ERROR AX_CONC_SHARED_MUT
    );

    let d1 = mut_view(arr[0..i]);
    let d2 = mut_view(arr[j..4]);
    // 5. Dynamic slice sub-ranges with UNKNOWN overlap must not be treated as DISJOINT:
    let _ = par_join(
        || -> i32 { let _ = d1; 1 },
        || -> i32 { let _ = d2; 2 } //~ ERROR AX_CONC_SHARED_MUT
    );
}

pub fn test_scoped_spawn_sibling_conflict() {
    let mut counter: i32 = 0;
    let r = view(counter);
    let w = mut_view(counter);
    let _ = spawn_scoped(|| -> i32 { *r });
    let _ = spawn_scoped(|| -> i32 { *w = 5; *w }); //~ ERROR AX_CONC_SHARED_MUT
}

pub fn main() {}
