// test: ui

module test_guard_escape_and_atomic_mut_view

struct MutexGuard {
    pub data: i32,
}

struct AtomicI32 {
    pub v: i32,
}

fn par_join<A: FnOnce, B: FnOnce>(left: A, right: B) -> i32 {
    left() + right()
}

fn spawn_scoped<F: FnOnce>(f: F) -> i32 {
    f()
}

pub fn leak_guard_from_fn() -> MutexGuard {
    let g = MutexGuard { data: 11 };
    return g; //~ ERROR AX_CONC_GUARD_ESCAPE
}

pub fn test_guard_block_and_spawn_escape() {
    let mut escaped: i32 = 0;
    let mut escaped_view: view<i32> = view(escaped);
    {
        let guard = MutexGuard { data: 55 };
        escaped_view = view(guard.data); //~ ERROR AX_CONC_GUARD_ESCAPE
    }

    let g2 = MutexGuard { data: 88 };
    let vg2 = view(g2.data);
    let _ = spawn_scoped(|| -> i32 {
        *vg2 //~ ERROR AX_CONC_GUARD_ESCAPE
    });
}

pub fn test_atomic_unsync_mut_view() {
    let mut atom = AtomicI32 { v: 1 };
    // 1. Taking an unsynchronized `mut_view` into an `AtomicI32` interior field:
    let m_inner = mut_view(atom.v); //~ ERROR AX_CONC_ATOMIC_MUT_VIEW
    *m_inner = 2;

    // 2. Mixing `mut_view<AtomicI32>` with concurrent shared access:
    let mut atom2 = AtomicI32 { v: 10 };
    let ma = mut_view(atom2);
    let va = view(atom2);
    let _ = par_join(
        || -> i32 { (*ma).v = 20; 0 }, //~ ERROR AX_CONC_ATOMIC_MUT_VIEW
        || -> i32 { (*va).v }
    );
}

pub fn main() {}
