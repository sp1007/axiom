// test: ui

module qa_arc_and_boundary_races

struct Arc<T> {
    pub inner: T,
}

struct Cell {
    pub val: i32,
}

struct RwLockWriteGuard {
    pub val: i32,
}

fn par_join<A: FnOnce, B: FnOnce>(left: A, right: B) -> i32 {
    let l = left();
    let r = right();
    l + r
}

fn spawn_scoped<F: FnOnce>(f: F) -> i32 {
    f()
}

pub fn test_arc_mut_without_lock() {
    let mut a = Arc { inner: 10 };
    let ma1 = mut_view(a);
    let ma2 = mut_view(a);
    // 1. Arc<T> does not synchronize concurrent mutation without a lock (Mutex/RwLock):
    let _ = par_join(
        || -> i32 { (*ma1).inner = 1; 1 },
        || -> i32 { (*ma2).inner = 2; 2 } //~ ERROR AX_CONC_SHARED_MUT
    );
}

pub fn test_arc_cell_view_not_share() {
    let a = Arc { inner: Cell { val: 5 } };
    let va = view(a);
    // 2. Arc<Cell> is !Share because Cell is !Share:
    let _ = spawn_scoped(|| -> i32 {
        let _ = (*va).inner; //~ ERROR AX_CONC_VIEW_NOT_SHARE
        1
    });
}

pub fn test_dynamic_array_indices(i: usize, j: usize) {
    let mut arr: [4]i32 = [1, 2, 3, 4];
    let e1 = mut_view(arr[i]);
    let e2 = mut_view(arr[j]);
    // 3. Dynamic array indices cannot be proven disjoint at compile time:
    let _ = par_join(
        || -> i32 { *e1 = 10; *e1 },
        || -> i32 { *e2 = 20; *e2 } //~ ERROR AX_CONC_SHARED_MUT
    );
}

pub fn test_same_tuple_field() {
    let mut tup = (10, 20);
    let f0a = mut_view(tup.0);
    let f0b = mut_view(tup.0);
    // 4. Overlapping tuple field .0 mutated in both concurrent closures:
    let _ = par_join(
        || -> i32 { *f0a = 1; *f0a },
        || -> i32 { *f0b = 2; *f0b } //~ ERROR AX_CONC_SHARED_MUT
    );
}

pub fn test_rwlock_write_guard_escape() {
    let g = RwLockWriteGuard { val: 99 };
    let vg = view(g.val);
    // 5. RwLockWriteGuard cannot escape across spawn_scoped boundary:
    let _ = spawn_scoped(|| -> i32 {
        *vg //~ ERROR AX_CONC_GUARD_ESCAPE
    });
}

pub fn main() {}
