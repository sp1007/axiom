// test: ui

module test_unsync_static_and_unsafe_reentry

struct UnsyncGlobal {
    pub val: i32,
}

impl !Share for UnsyncGlobal {}

static BAD_STATIC: UnsyncGlobal = UnsyncGlobal { val: 7 }; //~ ERROR AX_CONC_UNSYNC_STATIC

static mut GLOBAL_COUNTER: i32 = 0;

fn par_join<A: FnOnce, B: FnOnce>(left: A, right: B) -> i32 {
    left() + right()
}

fn spawn_scoped<F: FnOnce>(f: F) -> i32 {
    f()
}

pub fn test_static_mut_outside_unsafe() -> i32 {
    let cur = GLOBAL_COUNTER; //~ ERROR AX_CONC_UNSYNC_STATIC
    GLOBAL_COUNTER = 1; //~ ERROR AX_CONC_UNSYNC_STATIC
    cur
}

pub fn test_unsafe_reentry_still_verifies_concurrency() {
    let mut raw_target: i32 = 100;
    let raw_ptr: *mut i32 = unsafe { address_of_mut(raw_target) };

    // Re-establishing safe `mut_view` capabilities inside `unsafe` does NOT disable concurrency verification:
    let mv1: mut_view<i32> = unsafe { mut_view(*raw_ptr) };
    let mv2: mut_view<i32> = unsafe { mut_view(*raw_ptr) };
    let _ = par_join(
        || -> i32 { *mv1 = 10; *mv1 },
        || -> i32 { *mv2 = 20; *mv2 } //~ ERROR AX_CONC_SHARED_MUT
    );
}

pub fn test_unsafe_reentry_view_not_share() {
    // Re-establishing safe `view<UnsyncGlobal>` inside `unsafe` still rejects cross-thread sharing:
    let local_unsync = UnsyncGlobal { val: 9 };
    let raw_unsync: *const UnsyncGlobal = unsafe { address_of(local_unsync) };
    let vu: view<UnsyncGlobal> = unsafe { view(*raw_unsync) };
    let _ = spawn_scoped(|| -> i32 {
        let _ = *vu; //~ ERROR AX_CONC_VIEW_NOT_SHARE
        1
    });
}

@intrinsic unsafe fn address_of<T>(val: T) -> *const T { 0 as *const T }
@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

pub fn main() {}
