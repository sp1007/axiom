// test: ui

module test_view_not_share_rejected

struct CellBox {
    pub value: i32,
}

impl !Share for CellBox {}

struct RawPtrHolder {
    pub ptr: *mut i32,
}

fn par_join<A: FnOnce, B: FnOnce>(left: A, right: B) -> i32 {
    left() + right()
}

fn spawn_scoped<F: FnOnce>(f: F) -> i32 {
    f()
}

fn share_view<T>(v: view<T>) -> i32 {
    0
}

pub fn test_par_join_cell() {
    let cell = CellBox { value: 42 };
    let vc = view(cell);

    // 1. Concurrent READ/READ sharing of `view<CellBox>` across `par_join` where `CellBox: !Share`:
    let _ = par_join(
        || -> i32 { let _ = *vc; 1 }, //~ ERROR AX_CONC_VIEW_NOT_SHARE
        || -> i32 { 2 }
    );
}

pub fn test_spawn_scoped_raw_ptr() {
    // 2. Sharing `view<RawPtrHolder>` (`!Share` due to `*mut i32` field) across `spawn_scoped`:
    let holder = RawPtrHolder { ptr: 0 as *mut i32 };
    let vh = view(holder);
    let _ = spawn_scoped(|| -> i32 {
        let _ = (*vh).ptr; //~ ERROR AX_CONC_VIEW_NOT_SHARE
        1
    });
}

pub fn test_share_view_direct() {
    let cell = CellBox { value: 42 };
    // 3. Passing `view<CellBox>` directly to a concurrent sharing boundary:
    let _ = share_view(view(cell)); //~ ERROR AX_CONC_VIEW_NOT_SHARE
}

pub fn main() {}
