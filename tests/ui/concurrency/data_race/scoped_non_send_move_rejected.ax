// test: ui
// Covers: REQ-CONC-004, REQ-CONC-010
// Regression for T433: non-view `!Send` captures in `spawn_scoped` and `Scope.spawn`
// must still be rejected with `AX_CONC_CAPTURE_NOT_SEND` in STAGE_TYPECK even when
// shared `view<T>` (`TY_VIEW`) checks are deferred to STAGE_OWN (`AX_CONC_VIEW_NOT_SHARE`).

module test_scoped_non_send_move_rejected

struct NonSendMoved {
    pub id: i32,
}

impl !Send for NonSendMoved {}

struct Scope {
    pub marker: i32,
}

impl Scope {
    pub fn spawn<F: FnOnce>(self: view<Scope>, f: F) -> i32 {
        f()
    }
}

fn spawn_scoped<F: FnOnce>(f: F) -> i32 {
    f()
}

pub fn check_scoped_non_send_move_rejected() {
    let moved_tok = NonSendMoved { id: 5 };
    let _ = spawn_scoped(|| -> i32 { //~ ERROR AX_CONC_CAPTURE_NOT_SEND
        moved_tok.id
    });

    let sc = Scope { marker: 0 };
    let vsc = view(sc);
    let raw_p: *mut i32 = 0 as *mut i32;
    let _ = vsc.spawn(|| -> i32 { //~ ERROR AX_CONC_CAPTURE_NOT_SEND
        let _ = raw_p;
        0
    });
}

pub fn main() {}
