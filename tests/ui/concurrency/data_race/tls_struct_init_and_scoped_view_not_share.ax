// test: ui
// Covers: REQ-CONC-004, REQ-CONC-065
// Regression for T433:
// 1. `@thread_local static` initialized with constant struct/tuple/array aggregates
//    does not emit a spurious `AX_TYPE_INVALID_TLS_DECL` that masks STAGE_OWN checks.
// 2. Scoped thread boundaries (`spawn_scoped`, `Scope.spawn`) sharing `view<T>` where
//    `T: !Share` emit `AX_CONC_VIEW_NOT_SHARE` (including projections onto `Share`
//    scalar fields of a `!Share` struct).

module test_tls_struct_init_and_scoped_view_not_share

struct Cell {
    pub val: i32,
}

struct UnsyncState {
    pub code: i32,
}

impl !Share for UnsyncState {}

struct RawHolder {
    pub ptr: *mut i32,
}

struct Scope {
    pub marker: i32,
}

impl Scope {
    pub fn spawn<F: FnOnce>(self: view<Scope>, f: F) -> i32 {
        f()
    }
}

@thread_local
static OK_TLS_CELL: Cell = Cell { val: 99 };

@thread_local
static OK_TLS_TUPLE: (i32, i32) = (7, 8);

@thread_local
static OK_TLS_ARR: [2]i32 = [10, 20];

static BAD_GLOBAL_CELL: Cell = Cell { val: 1 }; //~ ERROR AX_CONC_UNSYNC_STATIC
static BAD_GLOBAL_UNSYNC: UnsyncState = UnsyncState { code: 2 }; //~ ERROR AX_CONC_UNSYNC_STATIC

static mut GLOBAL_SEQ: i32 = 0;

fn spawn_scoped<F: FnOnce>(f: F) -> i32 {
    f()
}

pub fn check_safe_static_mut_rejected() -> i32 {
    let v = GLOBAL_SEQ; //~ ERROR AX_CONC_UNSYNC_STATIC
    GLOBAL_SEQ = v + 1; //~ ERROR AX_CONC_UNSYNC_STATIC
    OK_TLS_CELL.val + OK_TLS_TUPLE.0 + OK_TLS_ARR[1]
}

pub fn check_scoped_view_not_share() {
    let st = UnsyncState { code: 42 };
    let vst = view(st);
    let _ = spawn_scoped(|| -> i32 {
        (*vst).code //~ ERROR AX_CONC_VIEW_NOT_SHARE
    });

    let sc = Scope { marker: 0 };
    let vsc = view(sc);
    let holder = RawHolder { ptr: 0 as *mut i32 };
    let vh = view(holder);
    let _ = vsc.spawn(|| -> i32 {
        let _ = (*vh).ptr; //~ ERROR AX_CONC_VIEW_NOT_SHARE
        0
    });
}

pub fn main() {}
