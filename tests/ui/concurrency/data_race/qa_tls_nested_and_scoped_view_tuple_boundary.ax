// test: ui
// Covers: REQ-CONC-004, REQ-CONC-065
// QA adversarial boundary test for T433:
// 1. `@thread_local static` with nested struct/tuple/array constant aggregate initializers
//    (including block expression and repeated array `[val; N]`) compiles without spurious
//    `AX_TYPE_INVALID_TLS_DECL`, allowing STAGE_OWN to run.
// 2. `Scope.spawn` and `spawn_scoped` capturing `view<ShareData>` (`Send + Share`) is permitted,
//    whereas capturing `view<NestedUnsync>` (containing `!Share` field or `*mut i32`) and
//    projecting a `Share` scalar subfield still emits `AX_CONC_VIEW_NOT_SHARE` exactly once.

module qa_tls_nested_and_scoped_view_tuple_boundary

struct Cell {
    pub val: i32,
}

struct ShareData {
    pub x: i32,
    pub y: i32,
}

struct UnsyncLeaf {
    pub secret: i32,
}

impl !Share for UnsyncLeaf {}

struct NestedUnsync {
    pub leaf: UnsyncLeaf,
    pub public_tag: i32,
}

struct NestedTlsConfig {
    pub cell: Cell,
    pub pair: (i32, i32),
    pub weights: [3]i32,
}

struct Scope {
    pub id: i32,
}

impl Scope {
    pub fn spawn<F: FnOnce>(self: view<Scope>, f: F) -> i32 {
        f()
    }
}

fn spawn_scoped<F: FnOnce>(f: F) -> i32 {
    f()
}

@thread_local
static OK_NESTED_TLS: NestedTlsConfig = NestedTlsConfig {
    cell: Cell { val: { 42 } },
    pair: (10, 20),
    weights: [7; 3],
};

static BAD_GLOBAL_NESTED: NestedUnsync = NestedUnsync { //~ ERROR AX_CONC_UNSYNC_STATIC
    leaf: UnsyncLeaf { secret: 1 },
    public_tag: 2,
};

pub fn test_scoped_share_ok_vs_nested_unsync_rejected() -> i32 {
    let sc = Scope { id: 1 };
    let vsc = view(sc);

    // Valid: `ShareData` is `Send + Share`, so `view<ShareData>` is allowed across `spawn_scoped` and `Scope.spawn`.
    let shared_ok = ShareData { x: 10, y: 20 };
    let v_ok = view(shared_ok);
    let r1 = spawn_scoped(|| -> i32 {
        (*v_ok).x + (*v_ok).y
    });
    let r2 = vsc.spawn(|| -> i32 {
        (*v_ok).x
    });

    // Invalid: `NestedUnsync` is `!Share` because of `leaf: UnsyncLeaf`, even when projecting `.public_tag` (`i32: Share`).
    let bad = NestedUnsync {
        leaf: UnsyncLeaf { secret: 9 },
        public_tag: 55,
    };
    let v_bad = view(bad);
    let r3 = spawn_scoped(|| -> i32 {
        (*v_bad).public_tag //~ ERROR AX_CONC_VIEW_NOT_SHARE
    });
    let r4 = vsc.spawn(|| -> i32 {
        (*v_bad).leaf.secret //~ ERROR AX_CONC_VIEW_NOT_SHARE
    });

    r1 + r2 + r3 + r4 + OK_NESTED_TLS.cell.val + OK_NESTED_TLS.pair.1 + OK_NESTED_TLS.weights[2]
}

pub fn main() {}
