// test: run
// stdout: tls_agg_ok 99 15 30\n

module test_tls_const_struct_init_run

struct Cell {
    pub val: i32,
}

@thread_local
static TLS_CELL: Cell = Cell { val: 99 };

@thread_local
static TLS_PAIR: (i32, i32) = (7, 8);

@thread_local
static TLS_ARR: [2]i32 = [10, 20];

pub fn main() -> i32 {
    print("tls_agg_ok ");
    print_int(TLS_CELL.val as i64);
    print(" ");
    print_int((TLS_PAIR.0 + TLS_PAIR.1) as i64);
    print(" ");
    print_int((TLS_ARR[0] + TLS_ARR[1]) as i64);
    print("\n");
    0
}
