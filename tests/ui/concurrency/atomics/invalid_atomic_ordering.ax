// test: ui
fn test_orderings(a: view<AtomicU64>, dyn_ord: Ordering) {
    let _ = a.load(Ordering.Release); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
    let _ = a.load(Ordering.AcqRel); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
    a.store(1u64, Ordering.Acquire); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
    a.store(1u64, Ordering.AcqRel); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
    let _ = a.compare_exchange(0u64, 1u64, Ordering.Release, Ordering.Acquire); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
    let _ = a.compare_exchange(0u64, 1u64, Ordering.Acquire, Ordering.SeqCst); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
    let _ = a.compare_exchange_weak(0u64, 1u64, Ordering.Relaxed, Ordering.Release); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
    fence(Ordering.Relaxed); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
    compiler_fence(Ordering.Relaxed); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
    let _ = a.load(dyn_ord); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
}

fn main() {}
