// test: ui

@repr(packed)
struct PackedNestedArray {
    tag: u8,
    arr: [2]AtomicU64, //~ ERROR AX_CONC_INVALID_ATOMIC_ALIGNMENT
}

@align(2)
struct UnderAlignedAtomic {
    slot: AtomicU64, //~ ERROR AX_CONC_INVALID_ATOMIC_ALIGNMENT
}

fn test_rmw_type_restrictions(b: view<AtomicBool>, p: view<Atomic<*mut i32>>, raw: *mut i32) {
    let _ = b.fetch_add(true, Ordering.SeqCst); //~ ERROR AX_CONC_INVALID_ATOMIC_TYPE
    let _ = b.fetch_sub(false, Ordering.Relaxed); //~ ERROR AX_CONC_INVALID_ATOMIC_TYPE
    let _ = p.fetch_add(raw, Ordering.SeqCst); //~ ERROR AX_CONC_INVALID_ATOMIC_TYPE
    let _ = p.fetch_and(raw, Ordering.Relaxed); //~ ERROR AX_CONC_INVALID_ATOMIC_TYPE
    let _ = is_lock_free<u128>(); //~ ERROR AX_CONC_INVALID_ATOMIC_TYPE
}

fn test_private_backing_field_and_cas_orderings(a: view<AtomicI32>) {
    let _ = a.v; //~ ERROR AX_CONC_ATOMIC_MUT_VIEW
    let _ = a.compare_exchange(0i32, 1i32, Ordering.Relaxed, Ordering.Acquire); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
    let _ = a.compare_exchange(0i32, 1i32, Ordering.SeqCst, Ordering.AcqRel); //~ ERROR AX_CONC_INVALID_ATOMIC_ORDERING
}

fn main() {}
