// test: ui
// QA T449 adversarial regression test for spawn-contract boundaries:
// 1. `@lang("spawn_blocking")` on a free function or method MUST enforce spawn
//    boundary checks (reject escaping stack `view` and `!Send` captures).
// 2. A user-defined `struct Executor` in a non-`std` module with a `spawn`
//    method is NOT a std spawn boundary and must compile without errors.
// 3. A user-defined 1-arg generic free function `fn spawn<T: MyTag>(x: T)` in
//    a non-`std` module is NOT `std.thread.spawn` and must accept `!Send` values.

module main

trait MyTag {}

struct NonSend {
    pub raw: *mut u8,
}
impl MyTag for NonSend {}

// 1. `@lang("spawn_blocking")` free function and method:
@lang("spawn_blocking")
fn my_blocking<F: FnOnce + Send>(f: F) -> i32 {
    f()
}

struct MyPool {
    pub n: i32,
}

impl MyPool {
    @lang("spawn_blocking")
    fn run_blocking<F: FnOnce + Send>(self: view<MyPool>, f: F) -> i32 {
        let _ = self.n;
        f()
    }
}

// 2. User-defined `struct Executor` in `module main` (not `std.*`, no `@lang`):
struct Executor {
    pub tag: i32,
}

impl Executor {
    fn spawn(self: mut_view<Executor>, label: view<i32>, raw: *mut u8) -> i32 {
        self.tag + *label + (raw as usize as i32)
    }
}

fn id_ptr(p: *mut u8) -> *mut u8 {
    p
}

// 3. User-defined 1-arg generic free function `spawn` (not `std.thread.spawn`, no `@lang`):
fn spawn<T: MyTag>(x: T) -> i32 {
    let _ = x;
    1
}

pub fn main() {
    let raw: *mut u8 = 0 as *mut u8;
    let x: i32 = 7;

    // 1a. `@lang("spawn_blocking")` free fn must reject !Send and escaping view:
    let ns1 = NonSend { raw: raw };
    let _ = my_blocking(|| -> i32 { //~ ERROR AX_CONC_CAPTURE_NOT_SEND
        ns1.raw as usize as i32
    });
    let vx1 = view(x);
    let _ = my_blocking(|| -> i32 { //~ ERROR AX_CONC_ESCAPING_VIEW
        *vx1
    });

    // 1b. `@lang("spawn_blocking")` method must reject !Send and escaping view:
    let pool = MyPool { n: 1 };
    let ns2 = NonSend { raw: raw };
    let _ = pool.run_blocking(|| -> i32 { //~ ERROR AX_CONC_CAPTURE_NOT_SEND
        ns2.raw as usize as i32
    });
    let vx2 = view(x);
    let _ = pool.run_blocking(|| -> i32 { //~ ERROR AX_CONC_ESCAPING_VIEW
        *vx2
    });

    // 2. User `struct Executor` in `module main` must NOT be checked as std spawn:
    let mut ex = Executor { tag: 1 };
    let _ = ex.spawn(view(x), id_ptr(raw));

    // 3. User free fn `spawn<T: MyTag>` in `module main` must NOT be checked as std spawn:
    let ns3 = NonSend { raw: raw };
    let _ = spawn(ns3);
}
