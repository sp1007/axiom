// test: ui
// QA T449 adversarial boundary test:
// 1. Aliased import `use std.thread.spawn as launch` still enforces Send and
//    escaping-view checks while accepting Send + !Share payloads.
// 2. Real `std.thread.spawn` rejects raw-pointer locals passed through a nested
//    call (`id_ptr(raw)`) and generic wrappers over `!Send` (`Wrap<NonSend>`).
// 3. `std.thread.Builder.spawn` rejects `!Send` captures;
//    `std.asyn.executor.LocalExecutor.spawn_local` allows `!Send` but rejects
//    escaping stack views.
// 4. T422 FU-E shape: `TaskGroup.spawn(exec: view<Executor>, fut: F)` with
//    `F: Send` (`!Share`) and nested raw-pointer-to-usize helper compiles cleanly.

module std.thread

pub fn spawn<F: FnOnce + Send>(f: F) -> i32 {
    f()
}

pub struct Builder {
    pub stack: usize,
}

impl Builder {
    pub fn spawn<F: FnOnce + Send>(self: Builder, f: F) -> i32 {
        let _ = self.stack;
        f()
    }
}

module std.asyn.executor

pub struct Executor {
    pub count: usize,
}

impl Executor {
    pub fn spawn<F: Send>(self: view<Executor>, fut: F, tag: usize) -> usize {
        let _ = fut;
        self.count + tag
    }
}

pub struct LocalExecutor {
    pub count: usize,
}

impl LocalExecutor {
    pub fn spawn_local<F>(self: mut_view<LocalExecutor>, fut: F) -> usize {
        let _ = fut;
        self.count
    }
}

module main

use std.thread.spawn as launch
use std.thread.Builder
use std.asyn.executor.Executor
use std.asyn.executor.LocalExecutor

struct NonSend {
    pub raw: *mut u8,
}

struct SendOnly {
    pub v: i32,
}
impl !Share for SendOnly {}

struct Wrap<T> {
    pub inner: T,
}

struct TaskGroup {
    pub count: usize,
}

fn id_ptr(p: *mut u8) -> *mut u8 {
    p
}

fn ptr_to_usize(p: *mut u8) -> usize {
    p as usize
}

impl TaskGroup {
    pub fn spawn<F: Send>(self: mut_view<TaskGroup>, exec: view<Executor>, fut: F) -> usize {
        let raw: *mut u8 = 0 as *mut u8;
        let _ = exec.spawn(fut, ptr_to_usize(raw));
        self.count = self.count + 1;
        self.count
    }
}

pub fn main() {
    let raw: *mut u8 = 0 as *mut u8;

    // 1. Aliased `std.thread.spawn as launch` rejects !Send and escaping view:
    let ns1 = NonSend { raw: raw };
    let _ = launch(|| -> i32 { //~ ERROR AX_CONC_CAPTURE_NOT_SEND
        ns1.raw as usize as i32
    });

    let stack_v: i32 = 10;
    let sv: view<i32> = view(stack_v);
    let _ = launch(|| -> i32 { //~ ERROR AX_CONC_ESCAPING_VIEW
        *sv
    });

    // Aliased `launch` accepts Send + !Share and raw pointer converted to usize before closure:
    let so = SendOnly { v: 42 };
    let addr = ptr_to_usize(raw);
    let _ = launch(|| -> i32 {
        so.v + (addr as i32)
    });

    // 2. Nested raw-pointer call inside real spawn closure still captures raw ptr (!Send):
    let _ = launch(|| -> i32 { //~ ERROR AX_CONC_CAPTURE_NOT_SEND
        id_ptr(raw) as usize as i32
    });

    // Generic struct wrapping !Send is rejected:
    let w_bad = Wrap<NonSend> { inner: NonSend { raw: raw } };
    let _ = launch(|| -> i32 { //~ ERROR AX_CONC_CAPTURE_NOT_SEND
        w_bad.inner.raw as usize as i32
    });

    // 3. std.thread.Builder.spawn rejects !Send capture:
    let b = Builder { stack: 1024 };
    let ns2 = NonSend { raw: raw };
    let _ = b.spawn(|| -> i32 { //~ ERROR AX_CONC_CAPTURE_NOT_SEND
        ns2.raw as usize as i32
    });

    // 4. std.asyn.executor.LocalExecutor.spawn_local allows !Send, rejects escaping view:
    let mut lex = LocalExecutor { count: 0 };
    let ns3 = NonSend { raw: raw };
    let _ = lex.spawn_local(ns3);
    let local: i32 = 9;
    let v = view(local);
    let _ = lex.spawn_local(v); //~ ERROR AX_CONC_ESCAPING_VIEW

    // 5. T422 FU-E: TaskGroup.spawn(view<Executor>, Send + !Share) compiles cleanly:
    let exec = Executor { count: 0 };
    let mut grp = TaskGroup { count: 0 };
    let _ = grp.spawn(view(exec), SendOnly { v: 7 });
}
