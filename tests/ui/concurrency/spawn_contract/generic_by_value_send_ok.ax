// test: ui
// T449 (FU-E): Generic by-value `Send` arguments (even when `!Share`) and
// raw-pointer locals transformed into `Send` values via nested calls are
// accepted by real spawn entry points (`std.thread.spawn`, `Executor.spawn`,
// `Scope.spawn`, and `@lang("spawn")`).

module std.thread

pub fn spawn<F: FnOnce + Send>(f: F) -> i32 {
    f()
}

pub struct Scope {
    pub active: usize,
}

impl Scope {
    pub fn spawn<F: FnOnce + Send>(self: view<Scope>, f: F) -> i32 {
        let _ = self.active;
        f()
    }
}

module std.asyn.executor

pub struct Executor {
    pub count: usize,
}

impl Executor {
    pub fn spawn<F: Send>(self: mut_view<Executor>, fut: F, tag: usize) -> usize {
        let _ = fut;
        self.count = self.count + tag;
        self.count
    }
}

module main

use std.thread.Scope
use std.thread.spawn
use std.asyn.executor.Executor

struct SendOnlyPayload {
    pub code: i32,
}
impl !Share for SendOnlyPayload {}

struct CustomRuntime {
    pub workers: usize,
}

impl CustomRuntime {
    @lang("spawn")
    fn custom_launch<T: Send>(self: view<CustomRuntime>, payload: T) -> usize {
        let _ = payload;
        self.workers
    }
}

@lang("spawn")
fn custom_spawn_fn<F: FnOnce + Send>(f: F) -> i32 {
    f()
}

fn ptr_to_addr(p: *mut u8) -> usize {
    p as usize
}

fn spawn_generic_send<T: Send>(rt: view<CustomRuntime>, exec: mut_view<Executor>, val: T, val2: T) {
    let _ = rt.custom_launch(val);
    let raw: *mut u8 = 0 as *mut u8;
    let _ = exec.spawn(val2, ptr_to_addr(raw));
}

fn spawn_generic_where<T>(exec: mut_view<Executor>, val: T) where T: Send {
    let _ = exec.spawn(val, 1);
}

fn spawn_closure_generic_where<T>(val: T) where T: Send {
    let _ = std.thread.spawn(|| -> i32 {
        let _moved = val;
        0
    });
}

fn spawn_send_not_share(p1: SendOnlyPayload, p2: SendOnlyPayload) {
    let _ = spawn(|| -> i32 {
        p1.code
    });
    let sc = Scope { active: 1 };
    let _ = view(sc).spawn(|| -> i32 {
        p2.code
    });
}

pub fn main() {
    let rt = CustomRuntime { workers: 4 };
    let mut exec = Executor { count: 0 };
    spawn_generic_send(
        view(rt),
        mut_view(exec),
        SendOnlyPayload { code: 10 },
        SendOnlyPayload { code: 11 }
    );
    spawn_generic_where(mut_view(exec), SendOnlyPayload { code: 20 });
    spawn_send_not_share(SendOnlyPayload { code: 30 }, SendOnlyPayload { code: 31 });

    let raw: *mut u8 = 0 as *mut u8;
    let _ = exec.spawn(SendOnlyPayload { code: 40 }, ptr_to_addr(raw));
    let addr = ptr_to_addr(raw);
    let _ = custom_spawn_fn(|| -> i32 {
        addr as i32
    });
}
