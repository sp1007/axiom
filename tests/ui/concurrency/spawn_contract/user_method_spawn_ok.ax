// test: ui
// T449 (FU-E): A user method or function merely named `spawn` is not a
// concurrency spawn boundary and must not trigger Send/Share/escaping-view checks.

trait Share {}
trait Send {}
trait FnOnce {}

struct NonSend {
    raw: *mut u8,
}

struct NotShare {
    val: i32,
}
impl !Share for NotShare {}

struct UserSpawner {
    count: i32,
}

impl UserSpawner {
    fn spawn(self: mut_view<UserSpawner>, label: view<i32>, ptr: *mut u8) -> i32 {
        self.count = self.count + *label + (ptr as usize as i32);
        self.count
    }
}

struct GenericHolder<T> {
    tag: i32,
}

impl<T> GenericHolder<T> {
    fn spawn(self: view<GenericHolder<T>>, item: T, ref_val: view<i32>) -> i32 {
        let _ = item;
        self.tag + *ref_val
    }
}

struct ClosureRunner {
    base: i32,
}

impl ClosureRunner {
    fn spawn<F: FnOnce>(self: view<ClosureRunner>, f: F) -> i32 {
        let _ = f;
        self.base
    }
}

fn id_ptr(p: *mut u8) -> *mut u8 {
    p
}

// A user free function named `spawn` that does not have the 1-arg generic spawn signature.
fn spawn(label: view<i32>, ptr: *mut u8) -> i32 {
    *label + (ptr as usize as i32)
}

fn forward_generic_unconstrained<T>(h: view<GenericHolder<T>>, val: T, v: view<i32>) -> i32 {
    h.spawn(val, v)
}

fn forward_generic_send<T: Send>(h: view<GenericHolder<T>>, val: T, v: view<i32>) -> i32 {
    h.spawn(val, v)
}

fn main() {
    let mut spawner = UserSpawner { count: 1 };
    let local: i32 = 41;
    let raw: *mut u8 = 0 as *mut u8;

    // 1. User method `spawn` taking a `view` argument and a raw-pointer local
    // directly and through a nested call:
    let _ = spawner.spawn(view(local), raw);
    let _ = spawner.spawn(view(local), id_ptr(raw));

    // 2. User free function `spawn` taking `view` and raw pointer:
    let _ = spawn(view(local), id_ptr(raw));

    // 3. User method `spawn` taking by-value generic arguments (unconstrained T,
    // non-Share struct, and non-Send struct) alongside a `view` argument:
    let h_ns = GenericHolder<NotShare> { tag: 10 };
    let _ = forward_generic_unconstrained(view(h_ns), NotShare { val: 7 }, view(local));
    let _ = forward_generic_send(view(h_ns), NotShare { val: 8 }, view(local));

    let h_ptr = GenericHolder<NonSend> { tag: 20 };
    let _ = h_ptr.spawn(NonSend { raw: id_ptr(raw) }, view(local));

    // 4. User method `spawn` taking a closure that borrows local state and
    // captures a non-Send value:
    let runner = ClosureRunner { base: 3 };
    let borrowed = view(local);
    let non_send = NonSend { raw: raw };
    let _ = runner.spawn(|| -> i32 {
        let _ = non_send;
        *borrowed
    });
}
