// test: ui
// T449 (FU-E): Real `std.thread.spawn`, `Executor.spawn`, and `@lang("spawn")`
// entry points enforce `Send` on captured/passed values and reject escaping
// stack `view`s.

module std.thread

pub fn spawn<F: FnOnce + Send>(f: F) -> i32 {
    f()
}

module std.asyn.executor

pub struct Executor {
    pub count: usize,
}

impl Executor {
    pub fn spawn<F: Send>(self: mut_view<Executor>, fut: F) -> usize {
        let _ = fut;
        self.count
    }
}

module main

use std.thread.spawn
use std.asyn.executor.Executor

struct NonSendToken {
    pub id: i32,
}
impl !Send for NonSendToken {}

@lang("spawn")
fn contract_spawn<F: FnOnce + Send>(f: F) -> i32 {
    f()
}

fn reject_unconstrained_generic<T>(val: T) {
    let _ = std.thread.spawn(|| -> i32 { //~ ERROR AX_CONC_CAPTURE_NOT_SEND
        let _moved = val;
        0
    });
}

pub fn main() {
    let tok = NonSendToken { id: 1 };
    let _ = std.thread.spawn(|| -> i32 { //~ ERROR AX_CONC_CAPTURE_NOT_SEND
        tok.id
    });

    let tok2 = NonSendToken { id: 2 };
    let _ = spawn(|| -> i32 { //~ ERROR AX_CONC_CAPTURE_NOT_SEND
        tok2.id
    });

    let raw: *mut u8 = 0 as *mut u8;
    let _ = contract_spawn(|| -> i32 { //~ ERROR AX_CONC_CAPTURE_NOT_SEND
        raw as usize as i32
    });

    let mut exec = Executor { count: 0 };
    let bad_fut = NonSendToken { id: 3 };
    let _ = exec.spawn(bad_fut); //~ ERROR AX_CONC_CAPTURE_NOT_SEND

    let stack_val: i32 = 99;
    let v: view<i32> = view(stack_val);
    let _ = std.thread.spawn(|| -> i32 { //~ ERROR AX_CONC_ESCAPING_VIEW
        *v
    });
}
