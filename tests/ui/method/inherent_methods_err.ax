// test: ui
struct Point {
    x: u32,
    y: u32,
}

impl Point {
    fn sum(self: view<Point>) -> u32 {
        self.x + self.y
    }
}

fn main() {
    let p = Point { x: 10, y: 20 };
    p.missing_method(); //~ ERROR AX_TYPE_UNKNOWN_FIELD
    Point.sum(10); //~ ERROR AX_TYPE_MISMATCH
    Point.sum(view(p), 10); //~ ERROR AX_TYPE_ARG_COUNT
}
