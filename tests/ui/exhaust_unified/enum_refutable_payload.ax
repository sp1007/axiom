// test: ui
// exit: 1
// T499c: bare enum matches with refutable payloads must report AX_PAT_NON_EXHAUSTIVE.

enum Opt {
    None,
    Some(i32),
}

enum Msg {
    Quit,
    Pair(bool, i32),
}

fn some_one_and_none(o: Opt) -> i32 {
    match o { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        Opt.Some(1) => 10,
        Opt.None => 0,
    }
}

fn prelude_option_refutable(o: Option<i32>) -> i32 {
    match o { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        Option.Some(1) => 10,
        Option.None => 0,
    }
}

fn multi_field_variant_gap(m: Msg) -> i32 {
    match m { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        Msg.Pair(true, 1) => 1,
        Msg.Pair(false, _) => 2,
        Msg.Quit => 0,
    }
}

fn guarded_payload_does_not_cover(o: Opt) -> i32 {
    match o { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        Opt.Some(x) if x > 0 => x,
        Opt.None => 0,
    }
}

fn main() -> i32 {
    some_one_and_none(Opt.None) +
        prelude_option_refutable(Option.None) +
        multi_field_variant_gap(Msg.Quit) +
        guarded_payload_does_not_cover(Opt.None)
}
