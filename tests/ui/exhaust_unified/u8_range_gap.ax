// test: ui
// exit: 1
// T499c: integer range gaps on bare u8, i8, and u128 scrutinees.

fn u8_middle_gap(x: u8) -> i32 {
    match x { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        0u8..=126u8 => 1,
        128u8..=255u8 => 2,
    }
}

fn u8_exclusive_end_gap(x: u8) -> i32 {
    match x { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        0u8..255u8 => 1,
    }
}

fn i8_signed_gap(x: i8) -> i32 {
    match x { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        -128i8..=0i8 => 1,
        2i8..=127i8 => 2,
    }
}

fn u128_incomplete(x: u128) -> i32 {
    match x { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        0u128..=18446744073709551616u128 => 1,
    }
}

fn main() -> i32 {
    u8_middle_gap(0u8) + u8_exclusive_end_gap(0u8) + i8_signed_gap(0i8) + u128_incomplete(0u128)
}
