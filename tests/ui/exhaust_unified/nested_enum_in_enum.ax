// test: ui
// exit: 1
// T499c: nested enum-in-enum patterns must cover all inner variants and inner payloads.

enum Inner {
    A,
    B,
}

enum Outer {
    Empty,
    Wrap(Inner),
}

enum LeafOrNode {
    Node,
    Leaf(bool),
}

enum Tree {
    Nil,
    Branch(LeafOrNode),
}

enum OptBool {
    None,
    Some(bool),
}

fn missing_inner_variant(x: Outer) -> i32 {
    match x { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        Outer.Wrap(Inner.A) => 1,
        Outer.Empty => 0,
    }
}

fn missing_three_level_payload(t: Tree) -> i32 {
    match t { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        Tree.Branch(LeafOrNode.Leaf(true)) => 1,
        Tree.Branch(LeafOrNode.Node) => 2,
        Tree.Nil => 0,
    }
}

fn generic_option_nested_missing(o: Option<OptBool>) -> i32 {
    match o { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        Option.Some(OptBool.Some(true)) => 1,
        Option.Some(OptBool.None) => 2,
        Option.None => 0,
    }
}

fn main() -> i32 {
    missing_inner_variant(Outer.Empty) +
        missing_three_level_payload(Tree.Nil) +
        generic_option_nested_missing(Option.None)
}
