// test: ui
// exit: 1
// T499c: struct patterns on bare struct scrutinees with refutable field sub-patterns.

enum Opt {
    None,
    Some(i32),
}

struct Packet {
    ok: bool,
    tag: u8,
}

struct Holder {
    item: Opt,
    count: i32,
}

struct Boxed {
    inner: Packet,
    extra: bool,
}

fn struct_u8_field_gap(p: Packet) -> i32 {
    match p { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        Packet { ok: true, tag: _ } => 1,
        Packet { ok: false, tag: 0u8..=127u8 } => 2,
    }
}

fn struct_rest_with_refutable_enum_field(h: Holder) -> i32 {
    match h { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        Holder { item: Opt.Some(0), .. } => 1,
        Holder { item: Opt.None, .. } => 0,
    }
}

fn nested_struct_missing_combination(b: Boxed) -> i32 {
    match b { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        Boxed { inner: Packet { ok: true, tag: _ }, extra: _ } => 1,
        Boxed { inner: Packet { ok: false, tag: _ }, extra: true } => 2,
    }
}

fn main() -> i32 {
    let p = Packet { ok: true, tag: 0u8 }
    struct_u8_field_gap(p) +
        struct_rest_with_refutable_enum_field(Holder { item: Opt.None, count: 0 }) +
        nested_struct_missing_combination(Boxed { inner: Packet { ok: true, tag: 1u8 }, extra: false })
}
