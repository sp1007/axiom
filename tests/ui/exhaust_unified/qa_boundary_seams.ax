// test: ui
// exit: 1
// T499c QA boundary cross-check: char surrogate-adjacent gaps, u128/i128 64-bit carry/borrow & min/max gaps,
// empty/inverted ranges (EXH_EMPTY -> AX_PAT_UNREACHABLE and non-covering), TY_UNIT duplicate arm,
// and inferred generic Option.None with refutable payload.

fn char_missing_d7ff(c: char) -> i32 {
    match c { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        '\0'..='\u{D7FE}' => 1,
        '\u{E000}'..='\u{10FFFF}' => 2,
    }
}

fn char_missing_e000(c: char) -> i32 {
    match c { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        '\0'..='\u{D7FF}' => 1,
        '\u{E001}'..='\u{10FFFF}' => 2,
    }
}

fn u128_missing_carry_boundary(x: u128) -> i32 {
    match x { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        0u128..=18446744073709551615u128 => 1,
        18446744073709551617u128..=340282366920938463463374607431768211455u128 => 2,
    }
}

fn i128_missing_neg_one(x: i128) -> i32 {
    match x { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        -170141183460469231731687303715884105728i128..=-2i128 => 1,
        0i128..=170141183460469231731687303715884105727i128 => 2,
    }
}

fn i128_missing_zero(x: i128) -> i32 {
    match x { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        -170141183460469231731687303715884105728i128..=-1i128 => 1,
        1i128..=170141183460469231731687303715884105727i128 => 2,
    }
}

fn i128_missing_min(x: i128) -> i32 {
    match x { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        -170141183460469231731687303715884105727i128..=170141183460469231731687303715884105727i128 => 1,
    }
}

fn i128_missing_max(x: i128) -> i32 {
    match x { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        -170141183460469231731687303715884105728i128..=170141183460469231731687303715884105726i128 => 1,
    }
}

fn empty_and_inverted_ranges(x: u8) -> i32 {
    match x { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        5u8..=3u8 => 1, //~ WARN AX_PAT_UNREACHABLE
        5u8..5u8 => 2, //~ WARN AX_PAT_UNREACHABLE
        0u8..0u8 => 3, //~ WARN AX_PAT_UNREACHABLE
    }
}

fn unit_duplicate_arm(u: ()) -> i32 {
    match u {
        _ => 1,
        _ => 2, //~ WARN AX_PAT_UNREACHABLE
    }
}

fn inferred_none_missing_bool() -> i32 {
    let n = Option.None
    match n { //~ ERROR AX_PAT_NON_EXHAUSTIVE
        Option.Some(true) => 1,
        Option.None => 0,
    }
}

fn main() -> i32 {
    char_missing_d7ff('a') +
        char_missing_e000('a') +
        u128_missing_carry_boundary(0u128) +
        i128_missing_neg_one(0i128) +
        i128_missing_zero(0i128) +
        i128_missing_min(0i128) +
        i128_missing_max(0i128) +
        empty_and_inverted_ranges(0u8) +
        unit_duplicate_arm(()) +
        inferred_none_missing_bool()
}
