// test: ui
// T499c: unreachable arms after full cover on bare enums with payloads, structs, and u8 ranges.

enum OptBool {
    None,
    Some(bool),
}

struct Flag {
    a: bool,
    b: bool,
}

fn enum_after_payload_cover(o: OptBool) -> i32 {
    match o {
        OptBool.Some(true) => 1,
        OptBool.Some(false) => 2,
        OptBool.None => 3,
        OptBool.Some(_) => 4, //~ WARN AX_PAT_UNREACHABLE
    }
}

fn u8_after_full_range_cover(x: u8) -> i32 {
    match x {
        0u8..=127u8 => 1,
        128u8..=255u8 => 2,
        42u8 => 3, //~ WARN AX_PAT_UNREACHABLE
    }
}

fn struct_after_field_cover(f: Flag) -> i32 {
    match f {
        Flag { a: true, b: _ } => 1,
        Flag { a: false, b: true } => 2,
        Flag { a: false, b: false } => 3,
        Flag { a: true, b: false } => 4, //~ WARN AX_PAT_UNREACHABLE
    }
}

fn enum_or_alternative_covered(o: OptBool) -> i32 {
    match o {
        OptBool.Some(true) => 1,
        OptBool.None | OptBool.Some(true) => 2, //~ WARN AX_PAT_UNREACHABLE
        OptBool.Some(false) => 3,
    }
}

fn main() -> i32 {
    enum_after_payload_cover(OptBool.None) +
        u8_after_full_range_cover(10u8) +
        struct_after_field_cover(Flag { a: true, b: true }) +
        enum_or_alternative_covered(OptBool.Some(false))
}
