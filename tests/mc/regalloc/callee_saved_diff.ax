// test: diff
// exit: 42

fn leaf_compute(x: i64, y: i64) -> i64 {
    let a: i64 = x + 3;
    let b: i64 = y + 5;
    let c: i64 = a * b;
    c - (x * y)
}

fn level3(v: i64) -> i64 {
    let s0: i64 = v + 1;
    let s1: i64 = v + 2;
    let s2: i64 = v + 3;
    let s3: i64 = v + 4;
    let s4: i64 = v + 5;
    let s5: i64 = v + 6;
    let s6: i64 = v + 7;
    let r: i64 = leaf_compute(s0, s6);
    r + s0 + s1 + s2 + s3 + s4 + s5 + s6
}

fn level2(v: i64) -> i64 {
    let c0: i64 = v * 2 + 1;
    let c1: i64 = v * 2 + 2;
    let c2: i64 = v * 2 + 3;
    let c3: i64 = v * 2 + 4;
    let c4: i64 = v * 2 + 5;
    let c5: i64 = v * 2 + 6;
    let sub1: i64 = level3(c0);
    let sub2: i64 = level3(c5);
    (sub2 - sub1) + c0 + c1 + c2 + c3 + c4 + c5
}

fn level1(v: i64) -> i64 {
    let mut local_arr: [4]i64 = [v, v + 10, v + 20, v + 30];
    let p0: i64 = v + 100;
    let p1: i64 = v + 200;
    let p2: i64 = v + 300;
    let p3: i64 = v + 400;
    let sub: i64 = level2(v);
    local_arr[1] = local_arr[1] + sub;
    let check_p: i64 = (p3 - p2) + (p1 - p0);
    local_arr[0] + local_arr[1] + local_arr[2] + local_arr[3] - check_p
}

fn main() -> i32 {
    let res: i64 = level1(4);
    if res != 20 {
        return 30;
    }
    42
}
