// test: diff
// exit: 42

fn mix6(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> i64 {
    (a * 3 + b * 5 - c * 2) + (d * 7 - e * 11 + f * 13)
}

fn fib_clobber(n: i64, bias: i64) -> i64 {
    if n <= 1 {
        return n + bias;
    }
    let keep0: i64 = n + 10;
    let keep1: i64 = bias + 20;
    let keep2: i64 = (n ^ bias) + 30;
    let left: i64 = fib_clobber(n - 1, bias);
    let mid: i64 = mix6(keep0, keep1, keep2, left, n, bias);
    let right: i64 = fib_clobber(n - 2, bias);
    (left + right) + ((mid - mid) + (keep0 - n - 10) + (keep1 - bias - 20) + (keep2 - (n ^ bias) - 30))
}

fn across_calls_stress(seed: i64) -> i64 {
    let x0: i64 = seed + 1;
    let x1: i64 = seed + 2;
    let x2: i64 = seed + 3;
    let x3: i64 = seed + 4;
    let x4: i64 = seed + 5;
    let x5: i64 = seed + 6;
    let x6: i64 = seed + 7;
    let x7: i64 = seed + 8;
    let x8: i64 = seed + 9;
    let x9: i64 = seed + 10;
    let x10: i64 = seed + 11;
    let x11: i64 = seed + 12;

    let c1: i64 = mix6(x0, x1, x2, x3, x4, x5);
    let c2: i64 = mix6(x6, x7, x8, x9, x10, x11);
    let c3: i64 = mix6(x11, x9, x7, x5, x3, x1);
    let live_sum: i64 = x0 + x1 + x2 + x3 + x4 + x5 + x6 + x7 + x8 + x9 + x10 + x11;
    (c1 - c1) + (c2 - c2) + (c3 - c3) + live_sum
}

fn main() -> i32 {
    let s: i64 = across_calls_stress(0);
    if s != 78 {
        return 10;
    }
    let f: i64 = fib_clobber(6, 2);
    if f != 34 {
        return 11;
    }
    42
}
