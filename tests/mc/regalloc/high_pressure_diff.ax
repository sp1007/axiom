// test: diff
// exit: 42

fn pressure_kernel(seed: i64, iters: i64) -> i64 {
    let mut v0: i64 = seed + 1;
    let mut v1: i64 = seed + 2;
    let mut v2: i64 = seed + 3;
    let mut v3: i64 = seed + 4;
    let mut v4: i64 = seed + 5;
    let mut v5: i64 = seed + 6;
    let mut v6: i64 = seed + 7;
    let mut v7: i64 = seed + 8;
    let mut v8: i64 = seed + 9;
    let mut v9: i64 = seed + 10;
    let mut v10: i64 = seed + 11;
    let mut v11: i64 = seed + 12;
    let mut v12: i64 = seed + 13;
    let mut v13: i64 = seed + 14;
    let mut v14: i64 = seed + 15;
    let mut v15: i64 = seed + 16;
    let mut v16: i64 = seed + 17;
    let mut v17: i64 = seed + 18;
    let mut v18: i64 = seed + 19;
    let mut v19: i64 = seed + 20;

    let mut outer: i64 = 0;
    while outer < iters {
        let mut inner: i64 = 0;
        while inner < 3 {
            let t0: i64 = (v0 + v19) ^ inner;
            let t1: i64 = (v1 + v18) - outer;
            let t2: i64 = (v2 + v17) + inner;
            let t3: i64 = (v3 + v16) ^ outer;
            v0 = v4 + (t0 & 7);
            v1 = v5 + (t1 & 7);
            v2 = v6 + (t2 & 7);
            v3 = v7 + (t3 & 7);
            v4 = v8 - (t0 & 3);
            v5 = v9 - (t1 & 3);
            v6 = v10 - (t2 & 3);
            v7 = v11 - (t3 & 3);
            v8 = v12 + 1;
            v9 = v13 + 1;
            v10 = v14 + 1;
            v11 = v15 + 1;
            v12 = v16 - 1;
            v13 = v17 - 1;
            v14 = v18 - 1;
            v15 = v19 - 1;
            v16 = t0 & 31;
            v17 = t1 & 31;
            v18 = t2 & 31;
            v19 = t3 & 31;
            inner = inner + 1;
        }
        if (outer & 1) == 0 {
            v0 = v0 + v10;
            v5 = v5 + v15;
        } else {
            v1 = v1 + v11;
            v6 = v6 + v16;
        }
        outer = outer + 1;
    }

    let sum_a: i64 = v0 + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9;
    let sum_b: i64 = v10 + v11 + v12 + v13 + v14 + v15 + v16 + v17 + v18 + v19;
    sum_a + sum_b
}

fn disjoint_lifetimes(x: i64) -> i64 {
    let a0: i64 = x + 10;
    let a1: i64 = x + 20;
    let a2: i64 = x + 30;
    let a3: i64 = x + 40;
    let a4: i64 = x + 50;
    let a5: i64 = x + 60;
    let a6: i64 = x + 70;
    let a7: i64 = x + 80;
    let a8: i64 = x + 90;
    let a9: i64 = x + 100;
    let phase1: i64 = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9;

    let b0: i64 = phase1 - 5;
    let b1: i64 = phase1 - 15;
    let b2: i64 = phase1 - 25;
    let b3: i64 = phase1 - 35;
    let b4: i64 = phase1 - 45;
    let b5: i64 = phase1 - 55;
    let b6: i64 = phase1 - 65;
    let b7: i64 = phase1 - 75;
    let b8: i64 = phase1 - 85;
    let b9: i64 = phase1 - 95;
    let phase2: i64 = (b0 + b9) - (b1 + b8) + (b2 + b7) - (b3 + b6) + (b4 + b5);
    phase2 - phase1
}

fn main() -> i32 {
    let k1: i64 = pressure_kernel(3, 4);
    let k2: i64 = pressure_kernel(3, 4);
    if k1 != k2 {
        return 1;
    }
    let d1: i64 = disjoint_lifetimes(7);
    if d1 != 520 {
        return 2;
    }
    42
}
