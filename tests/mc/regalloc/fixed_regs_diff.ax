// test: diff
// exit: 42

fn fixed_reg_stress(a: i64, b: i64, sh: i64) -> i64 {
    let p0: i64 = a + 11;
    let p1: i64 = a + 22;
    let p2: i64 = a + 33;
    let p3: i64 = a + 44;
    let p4: i64 = a + 55;
    let p5: i64 = a + 66;
    let p6: i64 = b + 7;
    let p7: i64 = b + 14;
    let p8: i64 = b + 21;
    let p9: i64 = b + 28;
    let p10: i64 = sh + 1;
    let p11: i64 = sh + 2;

    let sh_l: i64 = p0 << sh;
    let sh_r: i64 = p5 >> p10;
    let q_s: i64 = (p4 + p3) / p6;
    let r_s: i64 = (p4 + p3) % p6;

    let ua: u64 = (p2 as u64) + 100u64;
    let ub: u64 = (p1 as u64) + 3u64;
    let ush: u64 = (p11 as u64) & 7u64;
    let u_shr: u64 = (ua << ush) >> ush;
    let u_div: u64 = ua / ub;
    let u_rem: u64 = ua % ub;

    let check_u: i64 = ((u_div * ub + u_rem) - u_shr) as i64;
    let check_s: i64 = (q_s * p6 + r_s) - (p4 + p3);
    let pres: i64 = p0 + p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9 + p10 + p11;
    let shift_diff: i64 = (sh_l >> sh) - p0 + (sh_r - (p5 >> (sh + 1)));
    pres + check_u + check_s + shift_diff
}

fn loop_div_shift(n: i64) -> i64 {
    let mut i: i64 = 1;
    let mut acc: i64 = 0;
    let k0: i64 = 17;
    let k1: i64 = 29;
    let k2: i64 = 43;
    let k3: i64 = 59;
    let k4: i64 = 71;
    let k5: i64 = 83;
    while i <= n {
        let s: i64 = i & 3;
        let v: i64 = ((i * k0 + k1) << s) >> s;
        let q: i64 = (v + k2 + k3) / (i + 2);
        let r: i64 = (v + k4 + k5) % (i + 3);
        acc = acc + q + r;
        i = i + 1;
    }
    acc
}

fn main() -> i32 {
    let v: i64 = fixed_reg_stress(10, 5, 2);
    if v != 388 {
        return 20;
    }
    let l1: i64 = loop_div_shift(8);
    let l2: i64 = loop_div_shift(8);
    if l1 != l2 || l1 <= 0 {
        return 21;
    }
    42
}
