// test: diff
// exit: 42

fn select_zero_with_var_shift(a: i64, b: i64, v: i64, sh: u32) -> i64 {
    let shifted: i64 = v << sh;
    let pick: i64 = if a < b { 0i64 } else { shifted };
    pick
}

fn select_zero_fallthrough_chain(a: i64, b: i64, c: i64, sh: u32) -> i64 {
    let mut res: i64 = 0i64;
    if a < b {
        res = c >> sh;
    } else {
        res = 0i64;
    }
    if res == 0i64 {
        7i64
    } else {
        res
    }
}

fn main() -> i32 {
    if select_zero_with_var_shift(3i64, 10i64, 99i64, 0u32) != 0i64 { return 1; }
    if select_zero_with_var_shift(10i64, 3i64, 99i64, 0u32) != 99i64 { return 2; }
    if select_zero_with_var_shift(10i64, 3i64, 5i64, 2u32) != 20i64 { return 3; }

    if select_zero_fallthrough_chain(2i64, 8i64, 15i64, 0u32) != 15i64 { return 4; }
    if select_zero_fallthrough_chain(8i64, 2i64, 15i64, 0u32) != 7i64 { return 5; }
    if select_zero_fallthrough_chain(2i64, 8i64, 16i64, 2u32) != 4i64 { return 6; }

    42
}
