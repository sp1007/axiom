// test: diff
// exit: 42

@intrinsic unsafe fn address_of_mut<T>(val: T) -> *mut T { 0 as *mut T }

fn subword_cmov_i8_widen(sel: bool, a: i8, b: i8) -> i64 {
    let v: i8 = if !sel { a } else { b };
    v as i64
}

fn subword_cmov_u8_widen(x: i64, a: u8, b: u8) -> u64 {
    let v: u8 = if x < 0i64 { a } else { b };
    v as u64
}

fn subword_cmov_i16_u16(cond: i64) -> i64 {
    let s: i16 = if cond <= 0i64 { -32768i16 } else { -7i16 };
    let u: u16 = if cond <= 0i64 { 65535u16 } else { 40000u16 };
    (s as i64) + (u as i64)
}

fn subword_cmov_i32_u32(cond: i64) -> i64 {
    let s: i32 = if cond == 0i64 { -2147483647i32 - 1i32 } else { -99i32 };
    let u: u32 = if cond == 0i64 { 4294967295u32 } else { 3000000000u32 };
    (s as i64) + (u as i64)
}

fn ptr_alias_invalidates_slot_forward(flag: bool) -> i64 {
    let mut slot: i64 = 10i64;
    unsafe {
        let p: *mut i64 = address_of_mut(slot);
        *p = 77i64;
    }
    let after_ptr: i64 = slot;
    let mut arr: [4]i64 = [1i64, 2i64, 3i64, 4i64];
    let idx: usize = if flag { 2usize } else { 1usize };
    arr[idx] = after_ptr + 5i64;
    arr[1] + arr[2]
}

fn neg_const_div_rem_cmov(x: i64, choose_pow2: bool) -> i64 {
    let q7: i64 = x / -7i64;
    let q8: i64 = x / -8i64;
    let r7: i64 = x % -7i64;
    let r8: i64 = x % -8i64;
    let q: i64 = if !choose_pow2 { q7 } else { q8 };
    let r: i64 = if !choose_pow2 { r7 } else { r8 };
    q * 100i64 + r
}

fn high_u64_div_rem_lea(x: u64, off: u64) -> u64 {
    let q3: u64 = x / 3u64;
    let r3: u64 = x % 3u64;
    let recomposed: u64 = q3 * 3u64 + r3;
    let scaled: u64 = off * 8u64 + 24u64;
    if recomposed == x {
        r3 + scaled
    } else {
        999u64
    }
}

fn main() -> i32 {
    if subword_cmov_i8_widen(false, -128i8, 127i8) != -128i64 { return 1; }
    if subword_cmov_i8_widen(true, -128i8, -1i8) != -1i64 { return 2; }

    if subword_cmov_u8_widen(-5i64, 255u8, 128u8) != 255u64 { return 3; }
    if subword_cmov_u8_widen(5i64, 255u8, 128u8) != 128u64 { return 4; }

    if subword_cmov_i16_u16(0i64) != 32767i64 { return 5; }
    if subword_cmov_i16_u16(1i64) != 39993i64 { return 6; }

    if subword_cmov_i32_u32(0i64) != 2147483647i64 { return 7; }
    if subword_cmov_i32_u32(2i64) != 2999999901i64 { return 8; }

    if ptr_alias_invalidates_slot_forward(true) != 84i64 { return 9; }
    if ptr_alias_invalidates_slot_forward(false) != 85i64 { return 10; }

    if neg_const_div_rem_cmov(-100i64, false) != 1398i64 { return 11; }
    if neg_const_div_rem_cmov(-100i64, true) != 1196i64 { return 12; }
    if neg_const_div_rem_cmov(-8i64, true) != 100i64 { return 13; }

    if high_u64_div_rem_lea(0xFFFF_FFFF_FFFF_FFF2u64, 5u64) != 66u64 { return 14; }

    42
}
