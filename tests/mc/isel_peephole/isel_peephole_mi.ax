// test: golden
// emit: mi
// flags: -O2

fn isel_peephole_showcase(x: i64, y: i64) -> i64 {
    let scaled: i64 = x * 5;
    let div3: i64 = y / 3;
    let picked: i64 = if x > 0 { scaled } else { div3 };
    picked
}

fn main() -> i32 {
    let v: i64 = isel_peephole_showcase(6, 21);
    (v - 30) as i32
}
