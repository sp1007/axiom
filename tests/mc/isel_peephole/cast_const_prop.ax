// test: diff
// exit: 42

fn cast_neg_to_u8() -> i64 {
    let x: i64 = -300i64;
    let y: u8 = x as u8;
    y as i64
}

fn cast_u8_to_i8() -> i64 {
    let x: u8 = 200u8;
    let y: i8 = x as i8;
    y as i64
}

fn cast_neg_u32_mod7() -> u32 {
    let x: i64 = -1i64;
    let y: u32 = x as u32;
    y % 7u32
}

fn cast_neg_u32_shr1() -> u32 {
    let x: i64 = -1i64;
    let y: u32 = x as u32;
    y >> 1u32
}

fn cast_neg_i8_to_u64() -> u64 {
    let x: i8 = -1i8;
    x as u64
}

fn cast_neg_i8_to_u16() -> u64 {
    let x: i8 = -1i8;
    let y: u16 = x as u16;
    y as u64
}

fn cast_i32_257_to_u8() -> i64 {
    let x: i32 = 257i32;
    let y: u8 = x as u8;
    y as i64
}

fn cast_u32_msb_to_i64() -> i64 {
    let x: u32 = 0x80000000u32;
    x as i64
}

fn cast_u32_msb_to_i32_to_i64() -> i64 {
    let x: u32 = 0x80000000u32;
    let y: i32 = x as i32;
    y as i64
}

fn cast_i8_min_ror1() -> i64 {
    let x: i8 = -128i8;
    let ux: u8 = x as u8;
    let r: u8 = (ux >> 1u32) | (ux << 7u32);
    let sr: i8 = r as i8;
    sr as i64
}

fn cast_i16_i32_min() -> i64 {
    let a: i16 = -32768i16;
    let ua: u16 = a as u16;
    let b: i32 = -2147483648i32;
    let ub: u32 = b as u32;
    (ua as i64) + ((ub >> 16u32) as i64)
}

fn cast_u16_to_i16_neg() -> i64 {
    let x: u16 = 65500u16;
    let y: i16 = x as i16;
    y as i64
}

fn cast_bool_char_usize_isize() -> i64 {
    let b: bool = true;
    let c: char = 'A';
    let u: usize = (b as usize) + ((c as u32) as usize);
    let n: i16 = -5i16;
    let s: isize = n as isize;
    (u as i64) + (s as i64)
}

fn cast_runtime_mix(a: i64, b: u32) -> i64 {
    let au8: u8 = a as u8;
    let ai8: i8 = au8 as i8;
    let bi32: i32 = b as i32;
    (au8 as i64) + (ai8 as i64) + (bi32 as i64)
}

fn main() -> i32 {
    if cast_neg_to_u8() != 212i64 { return 1; }
    if cast_u8_to_i8() != -56i64 { return 2; }
    if cast_neg_u32_mod7() != 3u32 { return 3; }
    if cast_neg_u32_shr1() != 2147483647u32 { return 4; }
    if cast_neg_i8_to_u64() != 0xFFFFFFFFFFFFFFFFu64 { return 5; }
    if cast_neg_i8_to_u16() != 65535u64 { return 6; }
    if cast_i32_257_to_u8() != 1i64 { return 7; }
    if cast_u32_msb_to_i64() != 2147483648i64 { return 8; }
    if cast_u32_msb_to_i32_to_i64() != -2147483648i64 { return 9; }
    if cast_i8_min_ror1() != 64i64 { return 10; }
    if cast_u16_to_i16_neg() != -36i64 { return 11; }
    if cast_bool_char_usize_isize() != 61i64 { return 12; }
    if cast_runtime_mix(-300i64, 0x80000000u32) != (212i64 - 44i64 - 2147483648i64) { return 13; }
    if cast_i16_i32_min() != 65536i64 { return 14; }
    42
}
