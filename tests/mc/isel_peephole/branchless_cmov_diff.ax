// test: diff
// exit: 42

fn select_max(a: i64, b: i64) -> i64 {
    if a > b {
        a
    } else {
        b
    }
}

fn select_abs_scaled(x: i64) -> i64 {
    if x < 0 {
        (0 - x) * 3 + 1
    } else {
        x * 3 + 1
    }
}

// Guarded division MUST NOT be if-converted into speculative `idiv` + `cmovcc` (`REQ-OPT-208`).
fn guarded_div(x: i64, d: i64) -> i64 {
    if d == 0 {
        99
    } else {
        x / d
    }
}

fn bool_setcc_mix(a: i64, b: i64) -> i64 {
    let eq: bool = a == b;
    let lt: bool = a < b;
    let mut acc: i64 = 0;
    if eq {
        acc = acc + 10;
    }
    if lt {
        acc = acc + 20;
    }
    acc
}

fn main() -> i32 {
    if select_max(15, 27) != 27 {
        return 10;
    }
    if select_max(40, -5) != 40 {
        return 11;
    }
    if select_abs_scaled(-6) != 19 {
        return 12;
    }
    if select_abs_scaled(6) != 19 {
        return 13;
    }
    if guarded_div(100, 0) != 99 {
        return 14;
    }
    if guarded_div(100, 5) != 20 {
        return 15;
    }
    if bool_setcc_mix(5, 9) != 20 {
        return 16;
    }
    if bool_setcc_mix(7, 7) != 10 {
        return 17;
    }
    42
}
