// test: diff
// exit: 42

fn test_signed_div_rem(x: i64, y: i64) -> i64 {
    let q2: i64 = x / 2;
    let r2: i64 = x % 2;
    let q8: i64 = x / 8;
    let r8: i64 = x % 8;
    let q3: i64 = x / 3;
    let r3: i64 = x % 3;
    let q5: i64 = x / 5;
    let r5: i64 = x % 5;
    let q7: i64 = x / 7;
    let r7: i64 = x % 7;
    let q10: i64 = y / 10;
    let r10: i64 = y % 10;
    let qn3: i64 = y / -3;
    let rn3: i64 = y % -3;
    let qn7: i64 = y / -7;
    let rn7: i64 = y % -7;

    if q2 * 2 + r2 != x { return -1; }
    if q8 * 8 + r8 != x { return -2; }
    if q3 * 3 + r3 != x { return -3; }
    if q5 * 5 + r5 != x { return -4; }
    if q7 * 7 + r7 != x { return -5; }
    if q10 * 10 + r10 != y { return -6; }
    if qn3 * -3 + rn3 != y { return -7; }
    if qn7 * -7 + rn7 != y { return -8; }

    q2 + r2 + q8 + r8 + q3 + r3 + q5 + r5 + q7 + r7 + q10 + r10 + qn3 + rn3 + qn7 + rn7
}

fn test_unsigned_div_rem(u: u64, v: u64) -> u64 {
    let q4: u64 = u / 4u64;
    let r4: u64 = u % 4u64;
    let q16: u64 = u / 16u64;
    let r16: u64 = u % 16u64;
    let q3: u64 = u / 3u64;
    let r3: u64 = u % 3u64;
    let q5: u64 = u / 5u64;
    let r5: u64 = u % 5u64;
    let q7: u64 = v / 7u64;
    let r7: u64 = v % 7u64;
    let q10: u64 = v / 10u64;
    let r10: u64 = v % 10u64;

    if q4 * 4u64 + r4 != u { return 999999u64; }
    if q16 * 16u64 + r16 != u { return 999998u64; }
    if q3 * 3u64 + r3 != u { return 999997u64; }
    if q5 * 5u64 + r5 != u { return 999996u64; }
    if q7 * 7u64 + r7 != v { return 999995u64; }
    if q10 * 10u64 + r10 != v { return 999994u64; }

    q4 + r4 + q16 + r16 + q3 + r3 + q5 + r5 + q7 + r7 + q10 + r10
}

fn main() -> i32 {
    let s_pos: i64 = test_signed_div_rem(103, 97);
    if s_pos != 126 {
        return 11;
    }

    let s_neg: i64 = test_signed_div_rem(-103, -97);
    if s_neg != -126 {
        return 12;
    }

    let u_res: u64 = test_unsigned_div_rem(253u64, 1009u64);
    if u_res != 484u64 {
        return 13;
    }

    42
}
