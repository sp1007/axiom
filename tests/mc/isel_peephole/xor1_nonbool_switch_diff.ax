// test: diff
// exit: 42

fn xor1_diamond_i64(x: i64) -> i64 {
    let y: i64 = x ^ 1i64;
    if y == 0i64 {
        11i64
    } else {
        22i64
    }
}

fn xor1_match_i64(x: i64) -> i64 {
    let y: i64 = x ^ 1i64;
    match y {
        0i64 => 30i64,
        _ => 40i64,
    }
}

fn xor1_match_u32(x: u32) -> u32 {
    let y: u32 = x ^ 1u32;
    match y {
        0u32 => 7u32,
        _ => 9u32,
    }
}

fn bitnot_match_i64(x: i64) -> i64 {
    let y: i64 = ~x;
    match y {
        0i64 => 50i64,
        _ => 60i64,
    }
}

fn bool_not_diamond(b: bool) -> i64 {
    if !b {
        100i64
    } else {
        200i64
    }
}

fn main() -> i32 {
    if xor1_diamond_i64(0i64) != 22i64 { return 1; }
    if xor1_diamond_i64(1i64) != 11i64 { return 2; }
    if xor1_diamond_i64(2i64) != 22i64 { return 3; }
    if xor1_diamond_i64(3i64) != 22i64 { return 4; }
    if xor1_diamond_i64(-1i64) != 22i64 { return 5; }

    if xor1_match_i64(0i64) != 40i64 { return 6; }
    if xor1_match_i64(1i64) != 30i64 { return 7; }
    if xor1_match_i64(2i64) != 40i64 { return 8; }
    if xor1_match_i64(3i64) != 40i64 { return 9; }
    if xor1_match_i64(-1i64) != 40i64 { return 10; }

    if xor1_match_u32(0u32) != 9u32 { return 11; }
    if xor1_match_u32(1u32) != 7u32 { return 12; }
    if xor1_match_u32(2u32) != 9u32 { return 13; }
    if xor1_match_u32(3u32) != 9u32 { return 14; }
    if xor1_match_u32(0xFFFFFFFFu32) != 9u32 { return 15; }

    if bitnot_match_i64(-1i64) != 50i64 { return 16; }
    if bitnot_match_i64(0i64) != 60i64 { return 17; }
    if bitnot_match_i64(1i64) != 60i64 { return 18; }
    if bitnot_match_i64(2i64) != 60i64 { return 19; }

    if bool_not_diamond(false) != 100i64 { return 20; }
    if bool_not_diamond(true) != 200i64 { return 21; }

    42
}
