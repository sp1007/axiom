// test: diff
// exit: 42

fn side_effect_bump(x: i64) -> i64 {
    x + 11
}

fn stack_forwarding_with_call_barrier(a: i64, b: i64) -> i64 {
    let mut slot: i64 = a + 5;
    slot = a + 9;
    let before_call: i64 = slot;
    let called: i64 = side_effect_bump(before_call);
    slot = called + b;
    slot + before_call
}

fn zero_and_cmp_idioms(x: i64, y: i64) -> i64 {
    let mut z: i64 = 0;
    if x == 0 {
        z = y + 0;
    } else if x > 0 {
        z = (x - 0) + y;
    } else {
        z = y - x;
    }
    z
}

fn main() -> i32 {
    let r1: i64 = stack_forwarding_with_call_barrier(10, 4);
    // slot = 19, before_call = 19, called = 30, slot = 34 -> 34 + 19 = 53
    if r1 != 53 {
        return 10;
    }

    if zero_and_cmp_idioms(0, 15) != 15 {
        return 20;
    }
    if zero_and_cmp_idioms(8, 12) != 20 {
        return 21;
    }
    if zero_and_cmp_idioms(-5, 12) != 17 {
        return 22;
    }

    42
}
