// test: diff
// exit: 42

fn scale_arith(x: i64, y: i64) -> i64 {
    let a: i64 = x * 3 + 12;
    let b: i64 = y * 5 - 8;
    let c: i64 = x * 9 + y;
    let d: i64 = (x + y * 4) + 24;
    let e: i64 = (y + x * 8) - 16;
    a + b + c + d + e
}

fn array_indexed_sum(idx0: usize, idx1: usize, base_val: i64) -> i64 {
    let mut arr: [6]i64 = [
        base_val + 10,
        base_val + 20,
        base_val + 30,
        base_val + 40,
        base_val + 50,
        base_val + 60,
    ];
    arr[idx0] = arr[idx0] + 7;
    arr[idx1] = arr[idx1] + arr[idx0];
    arr[0] + arr[idx0] + arr[idx1] + arr[5]
}

fn main() -> i32 {
    let s1: i64 = scale_arith(4, 3);
    // a = 24, b = 7, c = 39, d = 40, e = 19 => sum = 129
    if s1 != 129 {
        return 10;
    }

    let s2: i64 = array_indexed_sum(1, 3, 5);
    // initial: [15, 25, 35, 45, 55, 65]
    // arr[1] = 32; arr[3] = 45 + 32 = 77
    // sum = 15 + 32 + 77 + 65 = 189
    if s2 != 189 {
        return 20;
    }

    42
}
