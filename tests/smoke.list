# Smoke set of the per-task QA gate (T437a; .claude/agents/axiom-qa.md "Per-task gate scope").
#
# `python tools/axtest.py --smoke [--seed N]` runs every `always:` id plus ONE id per top-level test group,
# drawn from that group's pool with the printed seed (default: a hash of the change set, so each gate
# picks differently). `python tools/axtest.py --smoke --check` validates this file: every top-level group of
# tests/ has a pool, every id exists, the always: cases below are present, and the worst-case draw fits 20
# minutes at -j 2 by the durations recorded in the cache directory (durations.json).
#
# Format: `always: <test id>` or `pool <group>: <test id>` (ids as printed by `axtest.py --list`, without the
# mode). Pools hold light ids only; heavy selfhost bundles are excluded (the selfhost pool uses its lightest
# ids). Groups whose every id is in _workspaces/baseline-failures.txt (hir, parse, resolve) pool baseline
# ids: they still run and are judged by the baseline rule; replace them once their fix task lands.
# This file is read by no compiled test (`--affected` treats a change of it as no-op).

# The Xin chào thế giới run test (UTF-8 bytes through the pipe, interp + native), one compile-fail ui test,
# one native-vs-interp diff test (its input lies outside its directory: ../run/basic/002-arithmetic.ax).
always: run/str/hello.ax
always: ui/typeck/type_unknown.ax
always: diff/002-arithmetic.ax

pool conformance: conformance/p5/0114_prog_a_hello.ax
pool conformance: conformance/p7/0017_generic_001_identity.ax
pool conformance: conformance/p7/p7_const_table.ax

pool diff: diff/001-return.ax
pool diff: diff/004-arith-neg.ax
pool diff: diff/opt/const_fold.ax

pool driver: driver/version.test
pool driver: driver/help.test
pool driver: driver/no_args.test

pool encode: encode/axiom/qa_encode_reloc_and_sym.ax
pool encode: encode/atomics/encode_atomics.ax

pool fuzz: fuzz/qa_seed_test.ax

pool hir: hir/basic.ax
pool hir: hir/types.ax

pool inspect: inspect/async_layout.test

pool lex: lex/L08_byte_literal.ax
pool lex: lex/L13_underscore.ax
pool lex: lex/L02_tuple_index.ax

pool link: link/objdump_validate.test
pool link: link/lib/coff_lib.test

pool link2: link2/multi_mod_pkg

pool lir: lir/add.test
pool lir: lir/div.test
pool lir: lir/neg.test

pool mc: mc/frame/main_42.ax
pool mc: mc/isel/vs1_return.ax
pool mc: mc/regalloc/fixed_regs_o2.ax

pool mir: mir/build/first_mir.ax
pool mir: mir/build/bitnot.ax
pool mir: mir/int128/shift_i8_rhs_check.test

pool modules: modules/hello
pool modules: modules/nested
pool modules: modules/std_root.test

pool obj: obj/determinism/string_symbols.test

pool opt: opt/const_fold_run.ax
pool opt: opt/qa_dce_run.ax

pool opt2: opt2/qa_boundary_sroa_inline_seam.ax
pool opt2: opt2/inline_scc_and_attributes.ax

pool parse: parse/async/async_fn_and_await.ax

pool perf: perf/loop.ax
pool perf: perf/bench/loop.ax

pool programs: programs/word_count.ax
pool programs: programs/expr_interp.ax

pool resolve: resolve/simple.ax
pool resolve: resolve/R01_basic.ax

pool run: run/basic/001-return.ax
pool run: run/native/003-large-return.ax
pool run: run/numeric/qa_div_zero.ax

pool selfhost: selfhost/intrinsics/qa_unreachable_abort.ax
