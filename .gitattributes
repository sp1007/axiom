# Golden tests and reproducible-build checks compare exact bytes: never let git rewrite line endings.
* text=auto eol=lf

# Axiom sources and golden outputs: LF always
*.ax      text eol=lf
*.tokens  text eol=lf
*.ast     text eol=lf
*.hir     text eol=lf
*.thir    text eol=lf
*.mir     text eol=lf
*.lir     text eol=lf
*.mc      text eol=lf

# Windows-only scripts keep CRLF
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Binary fixtures and artifacts
*.obj     binary
*.o       binary
*.exe     binary
*.dll     binary
*.lib     binary
*.a       binary
*.so      binary
*.bin     binary
*.wasm    binary
tests/**/fixtures/** binary

# Tests about CRLF handling must keep their bytes exactly
tests/**/crlf/** -text
